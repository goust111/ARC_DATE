+def _infer_floor_color(grid: np.ndarray, dest_set: set[tuple[int, int]]) -> int:
+    counts: dict[int, int] = {}
+    for r, c in _ring_cells(dest_set, *grid.shape):
+        value = int(grid[r, c])
+        if value not in (DEST_COLOR, RED_CENTER, MAROON):
