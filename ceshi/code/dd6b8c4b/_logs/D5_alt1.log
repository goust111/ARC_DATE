+def _dest_cells(cr: int, cc: int, h: int, w: int) -> list[tuple[int, int]]:
+    cells = []
+    for r in range(cr - 1, cr + 2):
+        for c in range(cc - 1, cc + 2):
+            if 0 <= r < h and 0 <= c < w:
+                cells.append((r, c))
