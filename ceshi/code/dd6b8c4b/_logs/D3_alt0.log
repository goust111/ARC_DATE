+        "chosen_far": farthest,
+        "cutoff": cutoff,
+        "leftover": leftover,
+    }
+
+
+def _expected_output(base_grid, dest_cells, source_cells, chosen_far, distractor_cells):
+    out = base_grid.copy()
+    survivors = set(source_cells) - set(chosen_far)
+    for r, c in survivors:
+        out[r, c] = MAROON
+    for r, c in distractor_cells:
+        out[r, c] = MAROON
