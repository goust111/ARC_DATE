+    ordered = sorted((int(dist[r, c]), r, c) for r, c in source_cells)
+    nearest = {(r, c) for _, r, c in ordered[:moved_count]}
+    farthest = {(r, c) for _, r, c in sorted(ordered, key=lambda t: (-t[0], t[1], t[2]))[:moved_count]}
+    if nearest == farthest:
+        return None
