+
+
+def _reachable_maroons(grid: np.ndarray) -> tuple[list[tuple[int, int]], int, list[tuple[int, int, int]]]:
+    grid = np.asarray(grid, dtype=int)
+    h, w = grid.shape
+
+    centers = np.argwhere(grid == 2)
