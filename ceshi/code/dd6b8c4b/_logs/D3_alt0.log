+FILL_K_RANGE = (2, 9)
+DISTRACTOR_MAX = 10
+TOTAL_MAROON_RANGE = (4, 16)
+MIN_REACHABLE = 10
+GEN_RETRIES = 400
+VISIBLE_FILL_COUNT = FILL_K_RANGE[1]
