+
+def _outward_dirs(r, c):
+    """Return directions pointing away from center for a ring cell."""
+    dirs = []
+    if r < CENTER_R:
+        dirs.append((-1, 0))
+    if r > CENTER_R:
+        dirs.append((1, 0))
+    if c < CENTER_C:
+        dirs.append((0, -1))
+    if c > CENTER_C:
+        dirs.append((0, 1))
+    return dirs
+
+
+def _extend_arm(wall_cells, dest_set, r, c, max_len):
