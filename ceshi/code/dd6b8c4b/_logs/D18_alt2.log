+def _wall_bfs_dist(wall_cells: set[tuple[int, int]], starts: list[tuple[int, int]]) -> dict[tuple[int, int], int]:
+    dist: dict[tuple[int, int], int] = {}
+    q = deque()
+    for cell in starts:
+        if cell not in wall_cells or cell in dist:
