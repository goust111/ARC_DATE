+    "left": {
+        "inner_gap": (0, -2),
+        "outer_gap": (0, -4),
+        "pocket": (0, -3),
+        "inner_flanks": [(-1, -2), (1, -2)],
+        "outer_flanks": [(-1, -4), (1, -4)],
+        "connectors": [(-1, -3), (1, -3)],
