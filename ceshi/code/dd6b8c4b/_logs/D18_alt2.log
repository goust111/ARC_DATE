+
+def _reachable_dist(grid: np.ndarray, dest_cells: list[tuple[int, int]], floor: int) -> np.ndarray:
+    h, w = grid.shape
+    passable = {floor, MAROON}
+    inf = 10**9
+    dist = np.full((h, w), inf, dtype=int)
+    queue: list[tuple[int, int]] = []
+    seen: set[tuple[int, int]] = set()
