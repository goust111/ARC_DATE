+        "moved_to_inner": sum(1 for rec in moved if rec["kind"] == "inner"),
+        "moved_to_outer": sum(1 for rec in moved if rec["kind"] == "outer"),
+        "moved_then_filled": sum(1 for rec in moved if rec["to"] in chosen),
