+                dist[nr, nc] = 0
+                queue.append((nr, nc))
+    assert queue, "destination must have at least one passable adjacent cell"
+
+    qi = 0
+    while qi < len(queue):
+        r, c = queue[qi]
+        qi += 1
+        for nr, nc in neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and int(grid[nr, nc]) in passable and dist[nr, nc] == inf:
+                dist[nr, nc] = dist[r, c] + 1
+                queue.append((nr, nc))
+    return dist
