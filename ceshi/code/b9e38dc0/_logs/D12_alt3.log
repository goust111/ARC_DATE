+def _sgn(x: int) -> int:
+    return (x > 0) - (x < 0)
+
+
+def _wall_components(mask: np.ndarray) -> list[set[tuple[int, int]]]:
+    return [set((int(r), int(c)) for r, c in pts) for pts in components_mask(mask, connectivity=8)]
+
+
+def _pick_fill_color(g: np.ndarray, bg: int, wall: int, comps: list[set[tuple[int, int]]]) -> int:
+    other_colors = [int(v) for v in np.unique(g) if int(v) not in (bg, wall)]
+    assert other_colors, "expected at least one non-wall color"
+    wall_points = [p for comp in comps for p in comp]
+
+    def min_dist_to_wall(color: int) -> tuple[int, int]:
+        pts = [(int(r), int(c)) for r, c in zip(*np.where(g == color))]
+        best_d = 10**9
+        for r, c in pts:
+            for wr, wc in wall_points:
+                d = abs(r - wr) + abs(c - wc)
+                if d < best_d:
+                    best_d = d
+                    if best_d == 0:
+                        return 0, len(pts)
+        return best_d, len(pts)
+
+    return min(other_colors, key=min_dist_to_wall)
