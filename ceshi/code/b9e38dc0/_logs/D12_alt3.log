+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Fill a chain of nested wall sprites from the innermost cavity outward.
+
+    Input structure:
+    - bg is the most common color. One wall color forms 2-3 separate half-enclosure components, each fully inside the next larger one.
+    - Only the smallest enclosed region contains the fill-color seed; other non-bg non-wall pixels are obstacles.
+    Rule:
+    - Repeatedly choose the nearest unprocessed wall component to the current fill region, flood its reachable cavity, and radiate through that component's opening.
+    - After an inner wall is solved, the newly expanded fill becomes the seed for the next outer wall; obstacles still cast shadows along each component's radiate direction.
+
+    Key insight: The task is no longer solved by one wall selection; the fill must climb the nesting hierarchy, so the current fill region determines which wall becomes active next.
+    """
+    return _solve_nested(np.array(grid, copy=True), record=False)
