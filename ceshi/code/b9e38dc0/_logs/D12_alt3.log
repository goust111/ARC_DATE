+# Variant of b9e38dc0
+# Dimension: D12 — 精灵数量与空间排列 (meta)
+# Change: 多个半包围精灵分布在网格中，各自独立，开口方向可能不同... → 嵌套精灵（精灵内含精灵）
+
+import random
+
+import numpy as np
+from scipy.ndimage import distance_transform_cdt
+
+from arc_utils import components_mask, get_bg, neighbors4, neighbors8
+
+
+# Design analysis for the D12 nested-wall variant
+# a) Concrete behavior:
+#    - Input now contains 2-3 wall components of the same color. They are not siblings spread around
+#      the canvas; they form a strict containment chain: the largest half-enclosure contains a smaller
+#      half-enclosure, which may itself contain an even smaller one.
+#    - Only the innermost cavity contains the fill-color seed. After that wall is solved, the resulting
+#      fill reaches the next cavity, making that newly reached area the seed for the next larger wall.
+#      This repeats from inner to outer until the outermost wall radiates to the grid edge.
+#    - Small example trace:
+#         original single-wall logic: seed -> fill one cavity -> radiate to border.
+#         new nested logic: seed inside wall C -> solve C, fill reaches wall B's cavity ->
+#         solve B, fill reaches wall A's cavity -> solve A, fill exits the whole nest.
+#      The difference is that choosing only the wall nearest to the original seed is no longer enough.
+#
+# b) Complexity calibration:
+#    - The variant always has at least 2 nested levels, optionally 3. This keeps the hierarchy obvious
+#      without exploding the number of cases.
+#    - All nested walls share the same fill color and wall color, so the new complexity is purely the
+#      spatial hierarchy and processing order, not extra color bookkeeping.
+#
+# c) Original-solver assumptions that break here:
+#    - `wall_comp = min(comps, ...)` assumed exactly one relevant wall. In the variant this would stop
+#      after the innermost wall and miss all outer levels.
+#    - `barrier = comp_mask.copy()` was safe only because there were no other same-color walls. Here the
+#      other wall components must remain non-passable background obstacles while the current component is
+#      being processed.
+#    - The fill seed was previously enough to identify the whole task. Now the current fill region after
+#      each stage becomes the seed for the next stage, so the solver must update and reuse it.
+#
+# d) Placement legality:
+#    - Generator keeps every child wall fully inside the parent interior and enforces one empty-cell moat
+#      in 8-neighborhood terms, so nested walls do not merge into a single component.
+#    - The deepest seed is placed only in the deepest wall interior. Obstacles are still placed on bg
+#      cells away from walls so they do not get mistaken for the fill color.
+#
+# e) Visual observability:
+#    - The hierarchy is visible directly: a small U-like wall appears inside a larger one.
+#    - The output shows stagewise expansion: inner cavity fills first, then the parent cavity, then the
+#      outer radiation. This is visible even when all levels share the same opening direction.
+#
+# f) Visual cleanliness:
+#    - The generator uses a strict nested chain rather than siblings, keeps 8-separation between levels,
+#      and uses only a few obstacle pixels, so the wall hierarchy stays readable.
+#
+# g) Color inference:
+#    - No ordering depends on color ids. Fill color is still inferred structurally as the non-wall color
+#      closest to the wall system, because the seed is the only non-wall color touching the deepest wall.
+#
+# Main new assumptions and how generation guarantees them:
+#    - Assumption: wall components form a reachable inner-to-outer chain. Guarantee: generation builds a
+#      recursive containment chain only, and rejects samples where any stage adds zero fill.
+#    - Assumption: each wall component still has exactly two degree-1 endpoints. Guarantee: wall builder
+#      preserves the original endpoint constraint at every nesting level.
+#    - Assumption: the nearest unprocessed wall to the current fill region is the next nesting level.
+#      Guarantee: no sibling walls are generated, only a single containment chain.
+
+
+def _sgn(x: int) -> int:
+    return (x > 0) - (x < 0)
+
+
+def _wall_components(mask: np.ndarray) -> list[set[tuple[int, int]]]:
+    return [set((int(r), int(c)) for r, c in pts) for pts in components_mask(mask, connectivity=8)]
+
+
+def _pick_fill_color(g: np.ndarray, bg: int, wall: int, comps: list[set[tuple[int, int]]]) -> int:
+    other_colors = [int(v) for v in np.unique(g) if int(v) not in (bg, wall)]
+    assert other_colors, "expected at least one non-wall color"
+    wall_points = [p for comp in comps for p in comp]
+
+    def min_dist_to_wall(color: int) -> tuple[int, int]:
+        pts = [(int(r), int(c)) for r, c in zip(*np.where(g == color))]
+        best_d = 10**9
+        for r, c in pts:
+            for wr, wc in wall_points:
+                d = abs(r - wr) + abs(c - wc)
+                if d < best_d:
+                    best_d = d
+                    if best_d == 0:
+                        return 0, len(pts)
+        return best_d, len(pts)
+
+    return min(other_colors, key=min_dist_to_wall)
+
+
+def _component_barrier(
+    wall_comp: set[tuple[int, int]],
+    shape: tuple[int, int],
+) -> tuple[np.ndarray, tuple[int, int], list[tuple[int, int]]]:
+    h, w = shape
+    comp_mask = np.zeros(shape, dtype=bool)
+    for r, c in wall_comp:
+        comp_mask[r, c] = True
+
+    def comp_neighbors(r: int, c: int) -> list[tuple[int, int]]:
+        out = []
+        for rr, cc in neighbors8(r, c):
+            if 0 <= rr < h and 0 <= cc < w and comp_mask[rr, cc]:
+                out.append((rr, cc))
+        return out
+
+    endpoints = [(r, c) for r, c in wall_comp if len(comp_neighbors(r, c)) == 1]
+    assert len(endpoints) >= 2, "expected wall component to have endpoints"
+
+    def outward_dir(ep: tuple[int, int]) -> tuple[tuple[int, int], bool]:
+        n1 = comp_neighbors(*ep)[0]
+        d1 = (_sgn(n1[0] - ep[0]), _sgn(n1[1] - ep[1]))
+        d_use = d1
+        is_12 = False
+        n2s = [p for p in comp_neighbors(*n1) if p != ep]
+        if n2s:
+            n2 = n2s[0]
+            d2 = (_sgn(n2[0] - n1[0]), _sgn(n2[1] - n1[1]))
+            if (d1[0] == 0) ^ (d1[1] == 0) and d2[0] != 0 and d2[1] != 0:
+                d_use = d2
+                is_12 = True
+        return (-d_use[0], -d_use[1]), is_12
+
+    out_info = [outward_dir(ep) for ep in endpoints[:2]]
+    out_dirs = [d for d, _ in out_info]
+    tip_12 = [f for _, f in out_info]
+    rad = (_sgn(sum(d[0] for d in out_dirs)), _sgn(sum(d[1] for d in out_dirs)))
+
+    barrier = comp_mask.copy()
+
+    def add_ray(start: tuple[int, int], d: tuple[int, int]) -> None:
+        rr, cc = start
+        while True:
+            rr += d[0]
+            cc += d[1]
+            if not (0 <= rr < h and 0 <= cc < w):
+                break
+            barrier[rr, cc] = True
+
+    def add_ray_12(start: tuple[int, int], d: tuple[int, int]) -> None:
+        rr, cc = start
+        step = 0
+        while True:
+            step += 1
+            if step % 2 == 1:
+                rr += d[0]
+                cc += d[1]
+            else:
+                if rad[0] != 0:
+                    rr += d[0]
+                else:
+                    cc += d[1]
+            if not (0 <= rr < h and 0 <= cc < w):
+                break
+            barrier[rr, cc] = True
+
+    for ep, d, is_12 in zip(endpoints[:2], out_dirs, tip_12):
+        if is_12:
+            add_ray_12(ep, d)
+        else:
+            add_ray(ep, d)
+
+    return barrier, rad, endpoints[:2]
+
+
+def _apply_shadow(
+    out: np.ndarray,
+    filled_mask: np.ndarray,
+    obstacles: np.ndarray,
+    rad: tuple[int, int],
+) -> None:
+    h, w = out.shape
+
+    def shadow_process(coords: list[tuple[int, int]]) -> None:
+        started = False
+        blocked = False
+        for r, c in coords:
+            if filled_mask[r, c]:
+                started = True
+            if started and obstacles[r, c]:
+                blocked = True
+                continue
+            if blocked and filled_mask[r, c]:
+                out[r, c] = 0  # overwritten below with the true bg value by caller
+
+    if rad == (0, 0):
+        return
+
+    dr, dc = rad
+    if dr != 0 and dc == 0:
+        for c in range(w):
+            rows = range(h) if dr > 0 else range(h - 1, -1, -1)
+            shadow_process([(r, c) for r in rows])
+    elif dc != 0 and dr == 0:
+        for r in range(h):
+            cols = range(w) if dc > 0 else range(w - 1, -1, -1)
+            shadow_process([(r, c) for c in cols])
+    elif dr == dc:
+        for k in range(-(w - 1), h):
+            coords = [(r, r - k) for r in range(h) if 0 <= r - k < w]
+            coords.sort(key=lambda rc: rc[0], reverse=(dr < 0))
+            shadow_process(coords)
+    else:
+        for k in range(h + w - 1):
+            coords = [(r, k - r) for r in range(h) if 0 <= k - r < w]
+            coords.sort(key=lambda rc: rc[0], reverse=(dr < 0))
+            shadow_process(coords)
+
+
+def _process_component(
+    g: np.ndarray,
+    bg: int,
+    wall: int,
+    fill: int,
+    wall_comp: set[tuple[int, int]],
+) -> tuple[np.ndarray, int, tuple[int, int]]:
+    h, w = g.shape
+    barrier, rad, _ = _component_barrier(wall_comp, (h, w))
+    passable = (~barrier) & ((g == bg) | (g == fill))
+    fill_pos = [(int(r), int(c)) for r, c in zip(*np.where(g == fill))]
+    q = fill_pos[:]
+    seen = np.zeros_like(passable, dtype=bool)
+    for r, c in q:
+        if passable[r, c]:
+            seen[r, c] = True
+
+    while q:
+        r, c = q.pop()
+        for rr, cc in neighbors4(r, c):
+            if 0 <= rr < h and 0 <= cc < w and passable[rr, cc] and not seen[rr, cc]:
+                seen[rr, cc] = True
+                q.append((rr, cc))
+
+    filled_mask = seen & (g == bg)
+    out = np.array(g, copy=True)
+    out[filled_mask] = fill
+
+    obstacles = (g != bg) & (g != fill) & (g != wall)
+    shadow_buffer = np.array(out, copy=True)
+    _apply_shadow(shadow_buffer, filled_mask.copy(), obstacles, rad)
+    out[shadow_buffer == 0] = bg
+
+    added = int(((out == fill) & (g != fill)).sum())
+    return out, added, rad
+
+
+def _solve_nested(grid: np.ndarray, record: bool = False):
+    g = np.array(grid, copy=True)
+    bg = get_bg(g)
+    vals = np.unique(g)
+    non_bg = [int(v) for v in vals if int(v) != bg]
+    assert non_bg, "expected at least one non-background color"
+
+    wall = max(non_bg, key=lambda c: int((g == c).sum()))
+    comps = _wall_components(g == wall)
+    assert comps, "expected at least one wall component"
+    fill = _pick_fill_color(g, bg, wall, comps)
+
+    stage_info = []
+    remaining = comps[:]
+    current = g
+
+    while remaining:
+        fill_pos = [(int(r), int(c)) for r, c in zip(*np.where(current == fill))]
+        if not fill_pos:
+            break
+
+        def comp_min_dist(comp: set[tuple[int, int]]) -> int:
+            best_d = 10**9
+            for r, c in fill_pos:
+                for wr, wc in comp:
+                    d = abs(r - wr) + abs(c - wc)
+                    if d < best_d:
+                        best_d = d
+                        if best_d == 0:
+                            return 0
+            return best_d
+
+        wall_comp = min(remaining, key=lambda comp: (comp_min_dist(comp), -len(comp)))
+        dist = comp_min_dist(wall_comp)
+        current, added, rad = _process_component(current, bg, wall, fill, wall_comp)
+        remaining.remove(wall_comp)
+        if record:
+            stage_info.append(
+                {
+                    "component_size": len(wall_comp),
+                    "distance": dist,
+                    "added": added,
+                    "rad": rad,
+                }
+            )
+
+    if record:
+        return current, stage_info
+    return current
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Fill a chain of nested wall sprites from the innermost cavity outward.
+
+    Input structure:
+    - bg is the most common color. One wall color forms 2-3 separate half-enclosure components, each fully inside the next larger one.
+    - Only the smallest enclosed region contains the fill-color seed; other non-bg non-wall pixels are obstacles.
+    Rule:
+    - Repeatedly choose the nearest unprocessed wall component to the current fill region, flood its reachable cavity, and radiate through that component's opening.
+    - After an inner wall is solved, the newly expanded fill becomes the seed for the next outer wall; obstacles still cast shadows along each component's radiate direction.
+
+    Key insight: The task is no longer solved by one wall selection; the fill must climb the nesting hierarchy, so the current fill region determines which wall becomes active next.
+    """
+    return _solve_nested(np.array(grid, copy=True), record=False)
+
+
+# --------------- generator (nested D12) ---------------
+
+# Canvas size bounds
+GRID_H_VERT = (14, 18)
+GRID_H_HORIZ = (10, 18)
+GRID_W = (16, 19)
+
+# Wall geometry
+OUTER_DEPTH_VERT = (7, 10)
+OUTER_DEPTH_HORIZ = (6, 8)
+OUTER_GAP = (6, 7)
+TIP_12_PROB = 0.5
+OUTER_PIXELS = (17, 25)
+INNER_PIXELS = (9, 17)
+DEEPEST_PIXELS = (7, 13)
+
+# Nesting
+NEST_LEVELS = [2, 2, 2, 3]
+
+# Placement margins
+OPEN_END_MARGIN = 3
+
+# Fill seed
+SEED_SIZE_WEIGHTS = [1, 1, 1, 2, 2, 3, 4]
+SEED_DEPTH_LOOKBACK = 2
+
+# Obstacles
+MAX_OBSTACLES = 4
+OBSTACLE_IN_FILL_PROB = 0.6
+OBSTACLE_MIN_SEP = 2
+
+# Validation
+MIN_NEW_FILL = 20
+PALETTE_SIZE = (3, 5)
+GEN_RETRIES = 400
+
+
+def _degree1_pixels(points: set[tuple[int, int]]) -> list[tuple[int, int]]:
+    pts = set(points)
+    return [
+        (r, c)
+        for r, c in pts
+        if sum((rr, cc) in pts for rr, cc in neighbors8(r, c)) == 1
+    ]
+
+
+def _make_arm(depth: int, start_v: int, target_v: int, extra_steps: int, tip_12: bool = False):
+    sign = 1 if target_v > start_v else -1
+    n_side_steps = abs(target_v - start_v)
+    chosen_rows = []
+    if n_side_steps:
+        if tip_12:
+            chosen_rows = [2 * (i + 1) for i in range(n_side_steps)]
+            extra_steps = 0
+        else:
+            chosen_rows = [1]
+            if n_side_steps > 1:
+                chosen_rows += random.sample(range(2, depth + 1), n_side_steps - 1)
+            chosen_rows.sort()
+
+    first_row = chosen_rows[0] if chosen_rows else 1
+    extra_rows = [r for r in chosen_rows if r != first_row]
+    random.shuffle(extra_rows)
+    orthogonal_rows = set(extra_rows[:extra_steps])
+
+    pts = [(0, start_v)]
+    u, v = 0, start_v
+    for row in range(1, depth + 1):
+        u += 1
+        if row in orthogonal_rows:
+            pts.append((u, v))
+            v += sign
+        elif row in chosen_rows:
+            v += sign
+        pts.append((u, v))
+    return pts
+
+
+def _build_local_wall(
+    depth_range: tuple[int, int],
+    gap_range: tuple[int, int],
+    pixel_range: tuple[int, int],
+):
+    for _ in range(100):
+        depth = random.randint(*depth_range)
+        gap = random.randint(*gap_range)
+        choices = []
+        for left_bottom in range(1, min(3, gap - 1)):
+            for right_bottom in range(max(left_bottom + 1, gap - 2), gap):
+                if 1 <= gap - right_bottom <= 2:
+                    choices.append((left_bottom, right_bottom))
+        if not choices:
+            continue
+        left_bottom, right_bottom = random.choice(choices)
+
+        base_count = 2 * (depth + 1) + max(0, right_bottom - left_bottom - 1)
+        max_extra_l = max(0, left_bottom - 1)
+        max_extra_r = max(0, gap - right_bottom - 1)
+        pixel_min, pixel_max = pixel_range
+        min_extra = max(0, pixel_min - base_count)
+        max_extra = min(max_extra_l + max_extra_r, pixel_max - base_count)
+        if min_extra > max_extra:
+            continue
+
+        extra = random.randint(min_extra, max_extra)
+        extra_l = random.randint(max(0, extra - max_extra_r), min(max_extra_l, extra))
+        extra_r = extra - extra_l
+
+        max_n_side = max(left_bottom, gap - right_bottom)
+        tip_12 = depth >= 2 * max_n_side and random.random() < TIP_12_PROB
+        left = _make_arm(depth, 0, left_bottom, extra_l, tip_12=tip_12)
+        right = _make_arm(depth, gap, right_bottom, extra_r, tip_12=tip_12)
+        pts = set(left) | set(right)
+        for v in range(left_bottom, right_bottom + 1):
+            pts.add((depth, v))
+
+        while len(pts) < pixel_min:
+            candidates = [
+                (u, v)
+                for u in range(max(0, depth - 3), depth + 1)
+                for v in range(gap + 1)
+                if (u, v) not in pts
+                and sum(
+                    (uu, vv) in pts
+                    for uu in range(u - 1, u + 2)
+                    for vv in range(v - 1, v + 2)
+                    if (uu, vv) != (u, v)
+                )
+                >= 2
+            ]
+            random.shuffle(candidates)
+            added = False
+            for p in candidates:
+                trial = pts | {p}
+                if len(trial) <= pixel_max and len(_degree1_pixels(trial)) == 2:
+                    pts = trial
+                    added = True
+                    break
+            if not added:
+                break
+
+        if pixel_min <= len(pts) <= pixel_max and len(_degree1_pixels(pts)) == 2:
+            return pts, depth, gap
+    return None
+
+
+def _local_interior(wall: set[tuple[int, int]], depth: int, gap: int) -> list[tuple[int, int]]:
+    by_row = {}
+    for u, v in wall:
+        by_row.setdefault(u, []).append(v)
+    interior = []
+    for u in range(1, depth):
+        if u not in by_row or len(by_row[u]) < 2:
+            continue
+        lo, hi = min(by_row[u]), max(by_row[u])
+        for v in range(lo + 1, hi):
+            if (u, v) not in wall:
+                interior.append((u, v))
+    return interior
+
+
+def _shift_points(points: set[tuple[int, int]] | list[tuple[int, int]], off: tuple[int, int]) -> set[tuple[int, int]]:
+    du, dv = off
+    return {(u + du, v + dv) for u, v in points}
+
+
+def _find_nested_offset(
+    parent_wall: set[tuple[int, int]],
+    parent_interior: set[tuple[int, int]],
+    child_wall: set[tuple[int, int]],
+    child_interior: set[tuple[int, int]],
+):
+    if not parent_interior or not child_interior:
+        return None
+
+    parent_rows = [u for u, _ in parent_interior]
+    parent_cols = [v for _, v in parent_interior]
+    child_gap = max(v for _, v in child_wall)
+    child_depth = max(u for u, _ in child_wall)
+    parent_center = (min(parent_cols) + max(parent_cols)) / 2.0
+
+    moat = set()
+    for u, v in parent_wall:
+        for uu in range(u - 1, u + 2):
+            for vv in range(v - 1, v + 2):
+                moat.add((uu, vv))
+
+    du_vals = list(range(max(parent_rows) - child_depth, min(parent_rows) - 1, -1))
+    dv_vals = list(range(min(parent_cols), max(parent_cols) - child_gap + 1))
+    dv_vals.sort(key=lambda dv: abs((dv + child_gap / 2.0) - parent_center))
+    if random.random() < 0.5:
+        dv_vals[: min(3, len(dv_vals))] = random.sample(dv_vals[: min(3, len(dv_vals))], min(3, len(dv_vals)))
+
+    candidates = []
+    for du in du_vals:
+        for dv in dv_vals:
+            shifted_wall = _shift_points(child_wall, (du, dv))
+            shifted_interior = _shift_points(child_interior, (du, dv))
+            if not shifted_wall <= parent_interior:
+                continue
+            if not shifted_interior <= parent_interior:
+                continue
+            if any(p in moat for p in shifted_wall):
+                continue
+            candidates.append((du, dv))
+
+    if not candidates:
+        return None
+    return random.choice(candidates[: min(8, len(candidates))])
+
+
+def _build_nested_chain(rad: tuple[int, int], levels: int):
+    outer_depth = OUTER_DEPTH_VERT if rad[0] else OUTER_DEPTH_HORIZ
+    outer = _build_local_wall(outer_depth, OUTER_GAP, OUTER_PIXELS)
+    if outer is None:
+        return None
+
+    wall, depth, gap = outer
+    interior = set(_local_interior(wall, depth, gap))
+    if not interior:
+        return None
+
+    chain = [{"wall": set(wall), "depth": depth, "gap": gap, "interior": interior}]
+    parent_wall = set(wall)
+    parent_interior = interior
+    parent_depth = depth
+    parent_gap = gap
+
+    for level in range(1, levels):
+        placed = False
+        for _ in range(120):
+            depth_hi = min(parent_depth - 3, 6 if level == 1 else 4)
+            depth_lo = max(3, depth_hi - 2)
+            gap_hi = min(parent_gap - 2, 5 if level == 1 else 4)
+            gap_lo = max(3, gap_hi - 1)
+            if depth_lo > depth_hi or gap_lo > gap_hi:
+                continue
+            pixel_range = INNER_PIXELS if level == 1 else DEEPEST_PIXELS
+            built = _build_local_wall((depth_lo, depth_hi), (gap_lo, gap_hi), pixel_range)
+            if built is None:
+                continue
+            child_wall, child_depth, child_gap = built
+            child_interior = set(_local_interior(child_wall, child_depth, child_gap))
+            if not child_interior:
+                continue
+            off = _find_nested_offset(parent_wall, parent_interior, child_wall, child_interior)
+            if off is None:
+                continue
+
+            abs_wall = _shift_points(child_wall, off)
+            abs_interior = _shift_points(child_interior, off)
+            chain.append({"wall": abs_wall, "depth": child_depth, "gap": child_gap, "interior": abs_interior})
+            parent_wall = abs_wall
+            parent_interior = abs_interior
+            parent_depth = child_depth
+            parent_gap = child_gap
+            placed = True
+            break
+        if not placed:
+            return None
+
+    return chain
+
+
+def _map_local(u: int, v: int, rad: tuple[int, int], anchor: tuple[int, int]) -> tuple[int, int]:
+    r0, c0 = anchor
+    if rad == (-1, 0):
+        return r0 + u, c0 + v
+    if rad == (1, 0):
+        return r0 - u, c0 + v
+    if rad == (0, -1):
+        return r0 + v, c0 + u
+    return r0 + v, c0 - u
+
+
+def _place_anchor(rad: tuple[int, int], h: int, w: int, depth: int, gap: int) -> tuple[int, int]:
+    if rad == (-1, 0):
+        return random.randint(OPEN_END_MARGIN, h - depth - 3), random.randint(0, w - gap - 1)
+    if rad == (1, 0):
+        return random.randint(depth + 2, h - 4), random.randint(0, w - gap - 1)
+    if rad == (0, -1):
+        return random.randint(0, h - gap - 1), random.randint(OPEN_END_MARGIN, w - depth - 3)
+    return random.randint(0, h - gap - 1), random.randint(depth + 2, w - 4)
+
+
+def _grow_seed_blob(seed: tuple[int, int], interior_set: set[tuple[int, int]]) -> set[tuple[int, int]]:
+    blob = {seed}
+    frontier = [seed]
+    target_size = random.choice(SEED_SIZE_WEIGHTS)
+    while len(blob) < target_size and frontier:
+        u, v = frontier.pop(random.randrange(len(frontier)))
+        for q in random.sample([(u - 1, v), (u + 1, v), (u, v - 1), (u, v + 1)], 4):
+            if q in interior_set and q not in blob:
+                blob.add(q)
+                frontier.append(q)
+                if len(blob) >= target_size:
+                    break
+    return blob
+
+
+def _obstacle_fits(pos: tuple[int, int], placed: list[tuple[int, int]]) -> bool:
+    r, c = pos
+    return all(max(abs(r - rr), abs(c - cc)) >= OBSTACLE_MIN_SEP for rr, cc in placed)
+
+
+def _find_obstacle_candidates(grid: np.ndarray, bg: int, wall_color: int, nominal_fill_zone: np.ndarray):
+    wall_mask = grid == wall_color
+    dist = distance_transform_cdt(~wall_mask, metric="taxicab")
+    eligible = (grid == bg) & (dist > 1)
+    all_coords = [(int(r), int(c)) for r, c in zip(*np.where(eligible))]
+    fill_coords = [p for p in all_coords if nominal_fill_zone[p[0], p[1]]]
+    random.shuffle(all_coords)
+    random.shuffle(fill_coords)
+    return all_coords, fill_coords
+
+
+def _place_obstacles(
+    n_obstacles: int,
+    candidates: list[tuple[int, int]],
+    fill_candidates: list[tuple[int, int]],
+    obstacle_colors: list[int],
+    grid: np.ndarray,
+) -> None:
+    placed = []
+    n_fill = random.randint(0, min(n_obstacles, len(fill_candidates)))
+    if fill_candidates and random.random() < OBSTACLE_IN_FILL_PROB:
+        n_fill = max(1, n_fill)
+    for p in fill_candidates:
+        if len(placed) >= n_fill:
+            break
+        if _obstacle_fits(p, placed):
+            placed.append(p)
+    placed_set = set(placed)
+    for p in candidates:
+        if len(placed) >= n_obstacles:
+            break
+        if p not in placed_set and _obstacle_fits(p, placed):
+            placed.append(p)
+            placed_set.add(p)
+    for i, (r, c) in enumerate(placed):
+        grid[r, c] = obstacle_colors[i % len(obstacle_colors)]
+
+
+def _touches_border(mask: np.ndarray) -> bool:
+    return bool(mask[0, :].any() or mask[-1, :].any() or mask[:, 0].any() or mask[:, -1].any())
+
+
+def analyze_nested_structure(grid: np.ndarray) -> dict:
+    g = np.array(grid, copy=True)
+    bg = get_bg(g)
+    vals = np.unique(g)
+    non_bg = [int(v) for v in vals if int(v) != bg]
+    if not non_bg:
+        return {"levels": 0, "stage_adds": [], "new_fill": 0, "rads": []}
+    wall = max(non_bg, key=lambda c: int((g == c).sum()))
+    comps = _wall_components(g == wall)
+    out, stage_info = _solve_nested(g, record=True)
+    fill = _pick_fill_color(g, bg, wall, comps)
+    return {
+        "levels": len(comps),
+        "stage_adds": [info["added"] for info in stage_info],
+        "new_fill": int(((out == fill) & (g == bg)).sum()),
+        "rads": [info["rad"] for info in stage_info],
+    }
+
+
+def _gen_attempt():
+    rad = random.choice([(-1, 0), (1, 0), (0, -1), (0, 1)])
+    h = random.randint(*GRID_H_VERT) if rad[0] else random.randint(*GRID_H_HORIZ)
+    w = random.randint(*GRID_W)
+    levels = random.choice(NEST_LEVELS)
+
+    chain = _build_nested_chain(rad, levels)
+    if chain is None:
+        return None
+
+    outer = chain[0]
+    anchor = _place_anchor(rad, h, w, outer["depth"], outer["gap"])
+
+    palette = random.sample(range(10), random.randint(*PALETTE_SIZE))
+    bg, wall_color, fill_color = palette[:3]
+    obstacle_colors = palette[3:]
+
+    grid = np.full((h, w), bg, dtype=int)
+    for item in chain:
