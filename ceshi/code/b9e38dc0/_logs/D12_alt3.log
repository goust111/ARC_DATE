+# --------------- generator (nested D12) ---------------
+
+# Canvas size bounds
+GRID_H_VERT = (14, 18)
+GRID_H_HORIZ = (10, 18)
+GRID_W = (16, 19)
+
+# Wall geometry
+OUTER_DEPTH_VERT = (7, 10)
+OUTER_DEPTH_HORIZ = (6, 8)
+OUTER_GAP = (6, 7)
+TIP_12_PROB = 0.5
+OUTER_PIXELS = (17, 25)
+INNER_PIXELS = (9, 17)
+DEEPEST_PIXELS = (7, 13)
+
+# Nesting
+NEST_LEVELS = [2, 2, 2, 3]
+
+# Placement margins
+OPEN_END_MARGIN = 3
+
+# Fill seed
+SEED_SIZE_WEIGHTS = [1, 1, 1, 2, 2, 3, 4]
+SEED_DEPTH_LOOKBACK = 2
+
+# Obstacles
