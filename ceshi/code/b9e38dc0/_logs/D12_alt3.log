+    stage_info = []
+    remaining = comps[:]
+    current = g
+
+    while remaining:
+        fill_pos = [(int(r), int(c)) for r, c in zip(*np.where(current == fill))]
+        if not fill_pos:
+            break
+
+        def comp_min_dist(comp: set[tuple[int, int]]) -> int:
+            best_d = 10**9
+            for r, c in fill_pos:
+                for wr, wc in comp:
