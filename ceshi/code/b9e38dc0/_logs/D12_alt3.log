+def _apply_shadow(
+    out: np.ndarray,
+    filled_mask: np.ndarray,
+    obstacles: np.ndarray,
+    rad: tuple[int, int],
+    bg: int,
+) -> None:
+    h, w = out.shape
+
+    def shadow_process(coords: list[tuple[int, int]]) -> None:
+        started = False
+        blocked = False
+        for r, c in coords:
+            if filled_mask[r, c]:
+                started = True
+            if started and obstacles[r, c]:
+                blocked = True
+                continue
+            if blocked and filled_mask[r, c]:
+                out[r, c] = bg
+                filled_mask[r, c] = False
