+    bg = scene["bg"]
+    fill = scene["fill"]
+    wall = scene["wall"]
+    h, w = g.shape
+
+    passable = (~barrier) & ((g == bg) | (g == fill))
+    q = scene["fill_pos"][:]
+    seen = np.zeros_like(passable, dtype=bool)
+    for r, c in q:
+        if passable[r, c]:
+            seen[r, c] = True
