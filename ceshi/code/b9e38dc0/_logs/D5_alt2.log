+                        collided_rays.add(oid)
+                    append_cell(rays[rid], cell)
+                    rays[rid]["pos"] = cell
+                    rays[rid]["active"] = False
+                    collided_rays.add(rid)
+                    continue
+                rays[rid]["active"] = False
