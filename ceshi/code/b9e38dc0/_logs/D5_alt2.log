+def _build_barrier_with_collisions(scene, shape):
+    h, w = shape
+    barrier = scene["wall_mask"].copy()
+    rad = scene["rad"]
+    cell_rays = {}
+    collision_cells = set()
+    collided_rays = set()
+
+    rays = {}
+    for rid, spec in enumerate(scene["ray_specs"]):
+        rays[rid] = {
+            "rid": rid,
+            "comp_id": spec["comp_id"],
+            "pos": spec["start"],
+            "dir": spec["dir"],
+            "is_12": spec["is_12"],
+            "phase": 0,
+            "path": [],
+            "index": {},
+            "active": True,
+        }
