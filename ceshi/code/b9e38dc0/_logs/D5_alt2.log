+    def next_step(ray):
+        if not ray["is_12"]:
+            return ray["dir"]
+        if ray["phase"] % 2 == 0:
+            return ray["dir"]
+        if rad[0] != 0:
+            return (ray["dir"][0], 0)
+        return (0, ray["dir"][1])
+
+    def advance_phase(ray):
+        if ray["is_12"]:
+            ray["phase"] = (ray["phase"] + 1) % 2
+
+    def append_cell(ray, cell):
+        if cell in ray["index"]:
+            return
+        ray["index"][cell] = len(ray["path"])
+        ray["path"].append(cell)
