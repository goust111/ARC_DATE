+    assert ray_specs, "expected at least one ray"
+    assert len(set(rads)) == 1, "expected all selected wall components to share one radiate direction"
+
+    return {
+        "bg": bg,
+        "wall": wall,
+        "fill": fill,
+        "fill_pos": fill_pos,
+        "wall_mask": wall_mask,
