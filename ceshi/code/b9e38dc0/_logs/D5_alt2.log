+GAP_VERT = (6, 7)
+TIP_12_PROB = 0.5
+
+OPEN_END_MARGIN = 3
+SPRITE_COUNT = 2
+SPRITE_BBOX_GAP = (1, 3)
+ALIGN_JITTER = 0
+
+SEED_SIZE_WEIGHTS = [1, 1, 1, 1, 2, 2, 3, 4, 5, 6]
+SEED_DEPTH_LOOKBACK = 3
+
+MAX_OBSTACLES = 4
+OBSTACLE_IN_FILL_PROB = 0.55
+OBSTACLE_MIN_SEP = 2
+
+MIN_NEW_FILL = 18
+MIN_COLLISION_DIFF = 6
+PALETTE_SIZE = (3, 5)
+GEN_RETRIES = 400
