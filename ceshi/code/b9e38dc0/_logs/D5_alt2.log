+def _build_barrier_to_edge(scene, shape):
+    h, w = shape
+    barrier = scene["wall_mask"].copy()
+    rad = scene["rad"]
+
+    def add_ray(start, d):
+        rr, cc = start
+        while True:
+            rr += d[0]
+            cc += d[1]
+            if not (0 <= rr < h and 0 <= cc < w):
+                break
+            barrier[rr, cc] = True
+
+    def add_ray_12(start, d):
+        rr, cc = start
+        step = 0
+        while True:
+            step += 1
+            if step % 2 == 1:
+                rr += d[0]
+                cc += d[1]
+            else:
+                if rad[0] != 0:
+                    rr += d[0]
+                else:
+                    cc += d[1]
+            if not (0 <= rr < h and 0 <= cc < w):
+                break
+            barrier[rr, cc] = True
+
+    for spec in scene["ray_specs"]:
+        if spec["is_12"]:
+            add_ray_12(spec["start"], spec["dir"])
+        else:
+            add_ray(spec["start"], spec["dir"])
+    return barrier
+
