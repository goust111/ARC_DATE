+                d = abs(r - wr) + abs(c - wc)
+                if d < best_d:
+                    best_d = d
+                    if best_d == 0:
+                        return 0
+        return best_d
+
+    wall_comp = min(comps, key=lambda comp: (comp_min_dist(comp), -len(comp)))
