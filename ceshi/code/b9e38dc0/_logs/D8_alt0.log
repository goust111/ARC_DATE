+OBSTACLE_IN_FILL_PROB = 0.65
+OBSTACLE_MIN_SEP = 2
+
+# Validation
+MIN_NEW_FILL = 20
+PALETTE_SIZE = (3, 5)
+GEN_RETRIES = 300
