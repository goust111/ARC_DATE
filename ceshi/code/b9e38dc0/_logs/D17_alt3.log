+GRID_H_HORIZ = (8, 18)
+GRID_W = (15, 19)
+
+# Wall geometry
+WALL_PIXELS_MIN = 17
+WALL_PIXELS_MAX = 25
+DEPTH_VERT = (5, 10)
+DEPTH_HORIZ = (6, 8)
+GAP_VERT = (6, 7)
+GAP_HORIZ = (5, 7)
+TIP_12_PROB = 0.5
+
+# Placement margins
+OPEN_END_MARGIN = 3
+
+# Fill seed
