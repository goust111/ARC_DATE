+    for q in neighbors8(u, v):
+        if q in labels:
+            lab = labels[q]
+            counts[lab] = counts.get(lab, 0) + 1
+    if counts:
+        best = max(counts.values())
+        opts = [lab for lab, cnt in counts.items() if cnt == best]
+        if len(opts) == 1:
+            return opts[0]
+        if "bridge" in opts and u >= depth - 1:
+            return "bridge"
