   334	            placed.append(p)
   335	            placed_set.add(p)
   336	    for i, (r, c) in enumerate(placed):
   337	        grid[r, c] = obstacle_colors[i % len(obstacle_colors)]
   338	
   339	
   340	def _touches_border(mask):
   341	    """Check if any True cell in mask lies on the grid border."""
   342	    return bool(mask[0, :].any() or mask[-1, :].any() or mask[:, 0].any() or mask[:, -1].any())
   343	
