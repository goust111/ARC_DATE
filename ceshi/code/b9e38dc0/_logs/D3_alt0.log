   350	    bg = get_bg(g)
   351	
   352	    non_bg = [int(v) for v in vals if int(v) != bg]
   353	    assert non_bg, "expected at least one non-background color"
   354	
   355	    wall = max(non_bg, key=lambda c: int((g == c).sum()))
   356	    wall_mask = g == wall
   357	
   358	    comps = [set((int(r), int(c)) for r, c in pts) for pts in components_mask(wall_mask, connectivity=8)]
   359	    assert comps, "expected at least one wall connected component"
   360	
   361	    other_colors = [c for c in non_bg if c != wall]
   362	    assert other_colors, "expected at least one non-wall color (fill color)"
   363	
   364	    wall_points = [p for comp in comps for p in comp]
   365	
   366	    def min_dist_to_wall(color: int) -> tuple[int, int]:
   367	        pts = [(int(r), int(c)) for r, c in zip(*np.where(g == color))]
   368	        best_d = 10**9
