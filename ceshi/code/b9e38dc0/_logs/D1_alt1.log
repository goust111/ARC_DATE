+def _border_touch_count(mask: np.ndarray) -> int:
+    hits = 0
+    if mask[0, :].any():
+        hits += 1
+    if mask[-1, :].any():
+        hits += 1
+    if mask[:, 0].any():
+        hits += 1
+    if mask[:, -1].any():
+        hits += 1
+    return hits
+
+
+def _gen_attempt() -> np.ndarray | None:
+    h = random.randint(*GRID_H)
+    w = random.randint(*GRID_W)
