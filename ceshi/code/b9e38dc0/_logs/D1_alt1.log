+def _choose_openings(frame_h: int, frame_w: int) -> list[tuple[str, int, int]]:
+    n_openings = random.choice(OPENING_COUNT_WEIGHTS)
+    vertical_side = random.choice(["top", "bottom"])
+    horizontal_side = random.choice(["left", "right"])
+    sides = [vertical_side, horizontal_side]
+    if n_openings == 3:
+        remaining = [s for s in ["top", "bottom", "left", "right"] if s not in sides]
+        sides.append(random.choice(remaining))
+    random.shuffle(sides)
