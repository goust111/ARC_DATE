+    openings = []
+    for side in sides:
+        length = random.randint(*OPENING_LEN)
+        if side in ("top", "bottom"):
+            lo = 2
+            hi = frame_w - length - 2
+        else:
+            lo = 2
+            hi = frame_h - length - 2
+        if lo > hi:
+            return []
+        start = random.randint(lo, hi)
