+    openings = []
+    for side in sides:
+        length = random.randint(*OPENING_LEN)
+        if side in ("top", "bottom"):
+            start = random.randint(1, frame_w - length - 1)
+        else:
+            start = random.randint(1, frame_h - length - 1)
+        openings.append((side, start, length))
