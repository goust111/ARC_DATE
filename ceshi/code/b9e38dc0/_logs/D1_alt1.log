    for r, c in local_wall:
        grid[anchor_r + r, anchor_c + c] = wall_color
    interior = [(anchor_r + r, anchor_c + c) for r in range(1, frame_h - 1) for c in range(1, frame_w - 1)]
    interior_set = set(interior)
    adjacent = [(r, c) for r, c in interior if r in (anchor_r + 1, anchor_r + frame_h - 2) or c in (anchor_c + 1, anchor_c + frame_w - 2)]
    if not adjacent:
        reasons['adjacent'] += 1; continue
    blob = mod._grow_seed_blob(random.choice(adjacent), interior_set)
    for r, c in blob:
        grid[r, c] = fill_color
    try:
        nominal_out = mod.main(grid)
    except Exception:
        reasons['nominal_out'] += 1; continue
    nominal_fill_zone = (nominal_out == fill_color) & (grid == bg)
    n_obstacles = random.randint(0, mod.MAX_OBSTACLES)
    if n_obstacles and not obstacle_colors:
        available = [c for c in range(10) if c not in (bg, wall_color, fill_color)]
        obstacle_colors = random.sample(available, random.randint(1, 2))
    if n_obstacles:
        candidates, fill_candidates = mod._find_obstacle_candidates(grid, bg, wall_color, nominal_fill_zone)
        mod._place_obstacles(n_obstacles, candidates, fill_candidates, obstacle_colors, grid)
    try:
        out = mod.main(grid)
        base = mod._single_opening_baseline(grid)
    except Exception:
        reasons['final_solve'] += 1; continue
    new_fill = (out == fill_color) & (grid == bg)
    multi_bonus = (out == fill_color) & (base "'!= fill_color)
    if int(new_fill.sum()) < mod.MIN_NEW_FILL:
        reasons['"'new_fill'] += 1; continue
    if mod._border_touch_count(new_fill) < 2:
        reasons['border_touch'] += 1; continue
    if int(multi_bonus.sum()) < mod.MIN_MULTI_BONUS:
        reasons['multi_bonus'] += 1; continue
    reasons['success'] += 1

print(reasons)
