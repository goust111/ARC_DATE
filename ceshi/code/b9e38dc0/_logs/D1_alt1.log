+def _place_frame(h: int, w: int, frame_h: int, frame_w: int) -> tuple[int, int]:
+    r0 = random.randint(FRAME_MARGIN, h - frame_h - FRAME_MARGIN)
+    c0 = random.randint(FRAME_MARGIN, w - frame_w - FRAME_MARGIN)
