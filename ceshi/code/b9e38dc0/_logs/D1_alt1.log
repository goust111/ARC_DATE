+# Variant of b9e38dc0
+# Dimension: D1 — 主路径机制——填充与辐射 (path)
+# Change: flood_fill + ray_casting——先洪水填充半包围区域的内部，再沿包围边框的开口方向向外辐射延伸... → 填充后向所有开口方向辐射
+
+import random
+
+import numpy as np
+from scipy.ndimage import distance_transform_cdt
