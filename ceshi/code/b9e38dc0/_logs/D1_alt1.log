+            placed.append(p)
+            placed_set.add(p)
+    for i, (r, c) in enumerate(placed):
+        grid[r, c] = obstacle_colors[i % len(obstacle_colors)]
+
+
+def _border_touch_count(mask: np.ndarray) -> int:
+    hits = 0
+    if mask[0, :].any():
+        hits += 1
+    if mask[-1, :].any():
+        hits += 1
+    if mask[:, 0].any():
+        hits += 1
+    if mask[:, -1].any():
+        hits += 1
+    return hits
+
+
+def _gen_attempt() -> np.ndarray | None:
