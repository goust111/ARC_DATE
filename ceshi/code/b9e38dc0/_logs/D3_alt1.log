+    return {
+        "bg": bg,
+        "fill": fill,
+        "rad": rad,
+        "open_proj": int(open_proj),
+        "opening_span": int(opening_span),
+    }
+
+
+def _fill_metrics(grid: np.ndarray):
+    dashed_out = _solve(grid, dashed=True)
+    continuous_out = _solve(grid, dashed=False)
