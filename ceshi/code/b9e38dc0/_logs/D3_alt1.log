+    fill_cells = int(np.count_nonzero((dashed_out != grid) & (dashed_out == continuous_out)))
+    del new_fill, exterior_fill, fill_cells  # kept for clarity during design; metric uses values below.
+
+    variant_new_fill = (dashed_out == dashed_out) & (dashed_out != grid)
+    baseline_new_fill = (continuous_out != grid)
+    return {
+        "changed": changed,
+        "variant_new_fill": int(np.count_nonzero(variant_new_fill)),
+        "baseline_new_fill": int(np.count_nonzero(baseline_new_fill)),
+        "border_touch": int(_touches_border(dashed_out != grid)),
