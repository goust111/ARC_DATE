+                rows = {r for r, _ in pts}
+                cols = {c for _, c in pts}
+                if len(rows) == 1:
+                    row = next(iter(rows))
+                    c0 = min(c for _, c in pts)
+                    c1 = max(c for _, c in pts)
+                    expected = {(row, cc) for cc in range(c0, c1 + 1)}
+                elif len(cols) == 1:
