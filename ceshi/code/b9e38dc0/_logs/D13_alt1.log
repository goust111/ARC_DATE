+    passable = (~barrier) & ((g == bg) | (g == fill) | (g == open_color))
+    q = fill_pos[:]
+    seen = np.zeros_like(passable, dtype=bool)
+    for r, c in q:
+        if passable[r, c]:
+            seen[r, c] = True
+    while q:
+        r, c = q.pop()
+        for rr, cc in neighbors4(r, c):
+            if 0 <= rr < h and 0 <= cc < w and passable[rr, cc] and not seen[rr, cc]:
+                seen[rr, cc] = True
+                q.append((rr, cc))
+
+    filled_mask = seen & (g == bg)
+
+    out = g.copy()
+    out[filled_mask] = fill
+
+    obstacles = (g != bg) & (g != fill) & (g != closed_color) & (g != open_color)
+
+    def shadow_process(coords: list[tuple[int, int]]) -> None:
+        started = False
+        blocked = False
+        for r, c in coords:
+            if filled_mask[r, c]:
+                started = True
+            if started and obstacles[r, c]:
+                blocked = True
+                continue
+            if blocked and filled_mask[r, c]:
+                out[r, c] = bg
+                filled_mask[r, c] = False
+
+    dr, dc = rad
+    if dr != 0:
+        for c in range(w):
+            rows = range(h) if dr > 0 else range(h - 1, -1, -1)
+            shadow_process([(r, c) for r in rows])
+    else:
+        for r in range(h):
+            cols = range(w) if dc > 0 else range(w - 1, -1, -1)
+            shadow_process([(r, c) for c in cols])
+
+    return out
+
+
+# --------------- generator (o5x) ---------------
+
+# -- Configuration constants --------------------------------------------------
+# Canvas size bounds
+GRID_H_VERT = (11, 18)
+GRID_H_HORIZ = (8, 18)
+GRID_W = (15, 19)
+
+# Wall geometry
+WALL_PIXELS_MIN = 17
+WALL_PIXELS_MAX = 25
+DEPTH_VERT = (5, 10)
+DEPTH_HORIZ = (6, 8)
+GAP_VERT = (6, 7)
+GAP_HORIZ = (5, 7)
+TIP_12_PROB = 0.5
+
+# Placement margins
+OPEN_END_MARGIN = 3
+
+# Fill seed
+SEED_SIZE_WEIGHTS = [1, 1, 1, 2, 2, 3, 3, 4]
+SEED_DEPTH_LOOKBACK = 3
+
+# Obstacles
+MAX_OBSTACLES = 5
+OBSTACLE_IN_FILL_PROB = 0.65
+OBSTACLE_MIN_SEP = 2
+
+# Validation
+MIN_NEW_FILL = 20
+PALETTE_SIZE = (4, 6)
+GEN_RETRIES = 300
