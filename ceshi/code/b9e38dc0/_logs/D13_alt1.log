+                elif len(cols) == 1:
+                    col = next(iter(cols))
+                    r0 = min(r for r, _ in pts)
+                    r1 = max(r for r, _ in pts)
+                    expected = {(rr, col) for rr in range(r0, r1 + 1)}
+                else:
