    36	#     - 只引入两种墙语义色：open_color 与 closed_color，避免颜色自由度过多。
    37	#     - open_color 固定表现为一条长直线段；fill blob 刻意限制到 1-4 格，障碍只做单点，
    38	#       这样“哪种颜色代表门面”在少量样例里能重复出现且不和别的对象混淆。
    39	#     - 仍保留原题的 ray slope、阴影与障碍机制，因此视觉上还是同一家族任务。
    40	#   implicit_assumptions_review:
    41	#     - 原代码 `wall = most frequent non-bg color` 依赖墙体单色；现在只对 closed_color 成立，
    42	#       因此 solver 需要额外从长直线段里识别 open_color。
    43	#     - 原代码 `endpoints = degree-1 pixels` 依赖墙体有真实缺口；现在边框闭合，
    44	#       所以要改为从 open_color 线段的两个端点恢复“门角”。
    45	#     - 原代码 `passable = bg or fill` 默认墙全不可穿过；现在必须把 open_color 也放进可通行集合，
    46	#       否则内部颜色永远出不去。
    47	#     - 原代码阴影判断里 `wall` 只有一种颜色；现在要同时排除 closed_color 和 open_color。
    48	#   placement_legality:
    49	#     - 仍用原本的局部坐标和 anchor 约束，确保闭合端离边界至少 2 格、门面朝向的外侧至少 3 格。
    50	#     - 门面只补在原开口连线处，因此不会越界，也不会与内部 seed 重叠。
    51	#     - 障碍只放在背景格，并基于 solver 的名义填充区筛选，保证不覆盖墙、门面或种子。
    52	#   visual_observability:
    53	#     - 人类看到训练样例时，会稳定看到“同一种颜色的整面”总是对应外放射的出口。
    54	#     - 因为门面被补上了，规则差异是肉眼可见的：不是从缺口漏出，而是穿过特定颜色的面漏出。
    55	#   visual_cleanliness:
    56	#     - 门面是一整条直线，障碍仍是点状，层次清晰；输出中门面保留原色，不会被填色覆盖。
    57	#   color_inference:
    58	#     - 颜色只编码二值语义：open vs closed。
    59	#     - 不使用颜色 id 排序、数值大小规律或依赖“某个固定数字是特殊色”的不可见规则。
    60	
    61	import random
    62	
    63	import numpy as np
    64	from scipy.ndimage import distance_transform_cdt
    65	
    66	from arc_utils import components_mask, get_bg, neighbors4, neighbors8
    67	
    68	
    69	def main(grid: np.ndarray) -> np.ndarray:
    70	    """
    71	    Flood-fill a closed funnel and let the color pass through its coded wall face.
    72	
    73	    Input structure:
    74	    - bg is the dominant color. The wall is now two-toned: a large closed-color shell plus one straight open-color face that seals the former gap.
    75	    - A small fill-color blob sits inside the shell near the closed end. Other non-bg colors are sparse obstacles.
    76	
    77	    Rule:
    78	    - Treat the open-color face as the only permeable side of the wall: interior flood-fill may cross that face while the face itself keeps its own color.
    79	    - After the fill exits, continue the same outward radiation and obstacle-shadow behavior as in the original task.
    80	
    81	    Key insight: The opening is no longer read from missing geometry; the coded wall face identifies which side behaves like the outlet, and its two endpoints recover the radiating boundary rays.
    82	    """
    83	    g = np.array(grid, copy=True)
    84	    h, w = g.shape
    85	
    86	    vals = np.unique(g)
    87	    bg = get_bg(g)
    88	    non_bg = [int(v) for v in vals if int(v) != bg]
    89	    assert non_bg, "expected at least one non-background color"
    90	
    91	    def sgn(x: int) -> int:
    92	        return (x > 0) - (x < 0)
    93	
    94	    closed_color = max(non_bg, key=lambda c: int((g == c).sum()))
    95	
    96	    def pick_open_face() -> tuple[int, set[tuple[int, int]]]:
    97	        best: tuple[int, int, set[tuple[int, int]]] | None = None
    98	        for color in non_bg:
    99	            if color == closed_color:
   100	                continue
   101	            for cells in components_mask(g == color, connectivity=4):
   102	                pts = {(int(r), int(c)) for r, c in cells}
   103	                if len(pts) < 6:
   104	                    continue
   105	                rows = {r for r, _ in pts}
   106	                cols = {c for _, c in pts}
   107	                if len(rows) == 1:
   108	                    row = next(iter(rows))
   109	                    c0 = min(c for _, c in pts)
   110	                    c1 = max(c for _, c in pts)
   111	                    expected = {(row, cc) for cc in range(c0, c1 + 1)}
   112	                elif len(cols) == 1:
   113	                    col = next(iter(cols))
   114	                    r0 = min(r for r, _ in pts)
   115	                    r1 = max(r for r, _ in pts)
   116	                    expected = {(rr, col) for rr in range(r0, r1 + 1)}
   117	                else:
   118	                    continue
   119	                if pts != expected:
   120	                    continue
   121	                score = (len(pts), int(color))
   122	                if best is None or score > best[:2]:
   123	                    best = (score[0], score[1], pts)
   124	        assert best is not None, "expected a straight open-face segment"
   125	        length, color, pts = best
   126	        assert length >= 6
   127	        return color, pts
   128	
   129	    open_color, open_face = pick_open_face()
   130	
   131	    wall_mask = (g == closed_color) | (g == open_color)
   132	    comps = [set((int(r), int(c)) for r, c in pts) for pts in components_mask(wall_mask, connectivity=8)]
   133	    assert comps, "expected at least one wall component"
   134	
   135	    other_colors = [c for c in non_bg if c not in (closed_color, open_color)]
   136	    assert other_colors, "expected at least one non-wall color (fill color)"
   137	
   138	    wall_points = [p for comp in comps for p in comp]
   139	
   140	    def min_dist_to_wall(color: int) -> tuple[int, int]:
   141	        pts = [(int(r), int(c)) for r, c in zip(*np.where(g == color), strict=False)]
   142	        best_d = 10**9
   143	        for r, c in pts:
   144	            for wr, wc in wall_points:
   145	                d = abs(r - wr) + abs(c - wc)
   146	                if d < best_d:
   147	                    best_d = d
   148	                    if best_d == 0:
   149	                        return 0, len(pts)
   150	        return best_d, len(pts)
   151	
   152	    fill = min(other_colors, key=lambda c: (min_dist_to_wall(c)[0], min_dist_to_wall(c)[1]))
   153	    fill_pos = [(int(r), int(c)) for r, c in zip(*np.where(g == fill), strict=False)]
   154	    if not fill_pos:
   155	        return g
   156	
   157	    fill_center = (
   158	        sum(r for r, _ in fill_pos) / len(fill_pos),
   159	        sum(c for _, c in fill_pos) / len(fill_pos),
   160	    )
   161	
   162	    def comp_min_dist(comp: set[tuple[int, int]]) -> int:
   163	        best_d = 10**9
   164	        for r, c in fill_pos:
   165	            for wr, wc in comp:
   166	                d = abs(r - wr) + abs(c - wc)
   167	                if d < best_d:
   168	                    best_d = d
   169	                    if best_d == 0:
   170	                        return 0
   171	        return best_d
   172	
   173	    wall_comp = min(comps, key=lambda comp: (comp_min_dist(comp), -len(comp)))
   174	    open_face = open_face & wall_comp
   175	    assert len(open_face) >= 6, "chosen wall component must contain the open face"
   176	
   177	    comp_mask = np.zeros_like(wall_mask, dtype=bool)
   178	    closed_mask = np.zeros_like(wall_mask, dtype=bool)
   179	    for r, c in wall_comp:
   180	        comp_mask[r, c] = True
   181	        if g[r, c] == closed_color:
   182	            closed_mask[r, c] = True
   183	
   184	    def comp_neighbors(r: int, c: int) -> list[tuple[int, int]]:
   185	        out = []
   186	        for rr, cc in neighbors8(r, c):
   187	            if 0 <= rr < h and 0 <= cc < w and comp_mask[rr, cc]:
   188	                out.append((rr, cc))
   189	        return out
   190	
   191	    open_rows = {r for r, _ in open_face}
   192	    open_cols = {c for _, c in open_face}
   193	    if len(open_rows) == 1:
   194	        face_r = next(iter(open_rows))
   195	        endpoints = sorted(open_face, key=lambda p: p[1])
   196	        interior_dr = 1 if fill_center[0] > face_r else -1
   197	        rad = (-interior_dr, 0)
   198	    else:
   199	        face_c = next(iter(open_cols))
   200	        endpoints = sorted(open_face, key=lambda p: p[0])
   201	        interior_dc = 1 if fill_center[1] > face_c else -1
   202	        rad = (0, -interior_dc)
   203	    endpoints = [endpoints[0], endpoints[-1]]
   204	
   205	    def dist_to_fill(pt: tuple[int, int]) -> float:
   206	        return abs(pt[0] - fill_center[0]) + abs(pt[1] - fill_center[1])
   207	
   208	    def outward_dir(ep: tuple[int, int]) -> tuple[tuple[int, int], bool]:
   209	        arm_neighbors = [p for p in comp_neighbors(*ep) if p not in open_face]
   210	        assert arm_neighbors, "open-face endpoint must attach to a wall arm"
   211	        n1 = min(arm_neighbors, key=dist_to_fill)
   212	        d1 = (sgn(n1[0] - ep[0]), sgn(n1[1] - ep[1]))  # inward along arm
   213	        d_use = d1
   214	        is_12 = False
   215	        n2s = [p for p in comp_neighbors(*n1) if p != ep and p not in open_face]
   216	        if n2s:
   217	            n2 = min(n2s, key=dist_to_fill)
   218	            d2 = (sgn(n2[0] - n1[0]), sgn(n2[1] - n1[1]))
   219	            if (d1[0] == 0) ^ (d1[1] == 0):
   220	                if d2[0] != 0 and d2[1] != 0:
   221	                    d_use = d2
   222	                    is_12 = True
   223	        return (-d_use[0], -d_use[1]), is_12
   224	
   225	    out_info = [outward_dir(ep) for ep in endpoints]
   226	    out_dirs = [d for d, _ in out_info]
   227	    tip_12 = [f for _, f in out_info]
   228	
   229	    dr_sum = sum(d[0] for d in out_dirs)
   230	    dc_sum = sum(d[1] for d in out_dirs)
   231	    inferred_rad = (sgn(dr_sum), sgn(dc_sum))
   232	    assert inferred_rad == rad, "wall color and arm geometry must agree on outward side"
   233	
   234	    barrier = closed_mask.copy()
   235	
   236	    def add_ray(start: tuple[int, int], d: tuple[int, int]) -> None:
   237	        rr, cc = start
   238	        while True:
   239	            rr += d[0]
   240	            cc += d[1]
   241	            if not (0 <= rr < h and 0 <= cc < w):
   242	                break
   243	            barrier[rr, cc] = True
   244	
   245	    def add_ray_12(start: tuple[int, int], d: tuple[int, int]) -> None:
   246	        rr, cc = start
   247	        step = 0
   248	        while True:
   249	            step += 1
   250	            if step % 2 == 1:
   251	                rr += d[0]
   252	                cc += d[1]
   253	            else:
   254	                if rad[0] != 0:
   255	                    rr += d[0]
   256	                else:
   257	                    cc += d[1]
   258	            if not (0 <= rr < h and 0 <= cc < w):
   259	                break
   260	            barrier[rr, cc] = True

