+        is_12 = False
+        n2s = [p for p in _component_neighbors(comp, *n1) if p != ep]
+        if n2s:
+            n2 = n2s[0]
+            d2 = (_sgn(n2[0] - n1[0]), _sgn(n2[1] - n1[1]))
