+    active.sort(
+        key=lambda m: (
+            m["edge_dist"],
+            round(m["center"][0], 3),
+            round(m["center"][1], 3),
+        )
+    )
+    return active
+
+
+def _fill_for_sprite(
+    occupancy: np.ndarray,
+    bg: int,
+    sprite: dict,
+) -> np.ndarray:
+    passable = (~sprite["barrier"]) & ((occupancy == bg) | sprite["seed_mask"])
+    q = list(sprite["seed_points"])
+    seen = np.zeros_like(passable, dtype=bool)
+    for r, c in q:
