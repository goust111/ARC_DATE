+
+def _component_neighbors(comp: set[tuple[int, int]], r: int, c: int) -> list[tuple[int, int]]:
+    out = []
+    for rr, cc in neighbors8(r, c):
+        if (rr, cc) in comp:
+            out.append((rr, cc))
+    return out
