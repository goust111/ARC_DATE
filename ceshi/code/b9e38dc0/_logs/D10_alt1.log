+SEED_DEPTH_LOOKBACK = 3
+
+# Obstacles.
+MAX_OBSTACLES = 2
+OBSTACLE_IN_FILL_PROB = 0.5
+OBSTACLE_MIN_SEP = 2
+
+# Validation.
+MIN_NEW_FILL = 20
+MIN_SERIAL_BLOCKED = 8
+PALETTE_SIZE = (4, 5)
+GEN_RETRIES = 400
