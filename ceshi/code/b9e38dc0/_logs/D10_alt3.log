+
+# ----------------------------- shared geometry ------------------------------
+
+GRID_H = (18, 24)
+GRID_W = (18, 24)
+
+WALL_PIXELS_MIN = 17
+WALL_PIXELS_MAX = 25
+DEPTH_VERT = (5, 9)
+DEPTH_HORIZ = (5, 9)
+GAP_VERT = (6, 7)
+GAP_HORIZ = (5, 7)
+TIP_12_PROB = 0.5
+
+OPEN_END_MARGIN = 4
+CHAIN_LEN_CHOICES = (2, 3)
+GEN_RETRIES = 400
+COMPONENT_PLACE_RETRIES = 90
+MIN_TOTAL_NEW_FILL = 28
+MIN_CHILD_NEW_FILL = 10
+
+SEED_SIZE_WEIGHTS = [1, 1, 1, 2, 2, 3, 4, 5]
+SEED_DEPTH_LOOKBACK = 3
