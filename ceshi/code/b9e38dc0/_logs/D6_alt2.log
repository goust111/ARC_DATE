+DEPTH_VERT = (6, 8)
+DEPTH_HORIZ = (6, 8)
+BASE_SPAN = (5, 7)              # distance between the two bottom side pixels
+CORRIDOR_WIDTHS = (1, 2)        # passable width inside the neck
