   173	                        (p[0] - ep[0]) * inward_axis[0] + (p[1] - ep[1]) * inward_axis[1],
   174	                        abs(p[0] - ep[0]) + abs(p[1] - ep[1]),
   175	                    ),
   176	                    reverse=True,
   177	                )
   178	                nxt = nbs[0]
   179	            path.append(nxt)
