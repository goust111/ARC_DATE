   181	        return path
   182	
   183	    def infer_tip_12(ep: tuple[int, int]) -> bool:
   184	        path = trace_side(ep)
   185	        steps = [
   186	            (_sgn(path[i + 1][0] - path[i][0]), _sgn(path[i + 1][1] - path[i][1]))
   187	            for i in range(len(path) - 1)
   188	        ]
   189	        assert len(steps) > CORRIDOR_LEN, "wall too short to decode corridor variant"
   190	        return steps[CORRIDOR_LEN] == inward_axis
   191	
   192	    tip_12 = sum(1 for ep in endpoints if infer_tip_12(ep)) >= 1
   193	
   194	    barrier = comp_mask.copy()
   195	
   196	    def add_ray(start: tuple[int, int], d: tuple[int, int]) -> None:
