+def _local_interior(wall, depth):
+    by_row = {}
+    for u, v in wall:
+        by_row.setdefault(u, []).append(v)
+    interior = []
+    for u in range(1, depth):
+        vals = by_row.get(u)
+        if vals is None or len(vals) < 2:
+            continue
+        lo, hi = min(vals), max(vals)
+        for v in range(lo + 1, hi):
+            if (u, v) not in wall:
+                interior.append((u, v))
+    return interior
+
