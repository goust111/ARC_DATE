+def _try_add_blocker(grid, wall_color, active_pts, rad):
+    offsets = list(range(BLOCKER_OFFSET_MIN, BLOCKER_OFFSET_MAX + 1))
+    random.shuffle(offsets)
+    h, w = grid.shape
+    for offset in offsets:
+        blocker_pts = _translate_points(active_pts, rad, offset)
+        if any(not (0 <= r < h and 0 <= c < w) for r, c in blocker_pts):
+            continue
+        if blocker_pts & active_pts:
+            continue
+        trial = grid.copy()
+        for r, c in blocker_pts:
+            if trial[r, c] != get_bg(trial):
+                break
+        else:
+            for r, c in blocker_pts:
+                trial[r, c] = wall_color
+            if _blocker_ok(trial, wall_color):
+                out, meta = _solve(trial, stop_at_other_wall=True, return_meta=True)
+                edge_out = _solve(trial, stop_at_other_wall=False)
+                hits = [rm["hit"] is not None for rm in meta["ray_meta"]]
+                new_fill = (out == meta["scene"]["fill"]) & (trial == meta["scene"]["bg"])
+                if all(hits) and int(new_fill.sum()) >= MIN_NEW_FILL and not _touches_border(new_fill):
+                    if not np.array_equal(out, edge_out):
+                        return trial, blocker_pts
+    return None, None
