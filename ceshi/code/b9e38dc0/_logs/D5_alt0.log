import importlib.util, random, numpy as np, collections
spec = importlib.util.spec_from_file_location('variant', '/home/lixinyu/snap/new/ceshi/code/b9e38dc0/D5/0/code.py')
mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)

counts=collections.Counter()
for _ in range(500):
    rad = random.choice([(-1,0),(1,0),(0,-1),(0,1)])
    h = random.randint(*mod.GRID_H_VERT) if rad[0] else random.randint(*mod.GRID_H_HORIZ)
    w = random.randint(*mod.GRID_W)
    built = mod._build_local_wall(rad,h,w)
    if built is None:
        counts['build_none']+=1; continue
    local_wall, depth, gap = built
    anchor = mod._place_anchor(rad,h,w,depth,gap)
    if anchor is None:
        counts['anchor_none']+=1; continue
    palette = random.sample(range(10), random.randint(*mod.PALETTE_SIZE))
    bg, wall_color, fill_color = palette[:3]
    grid=np.full((h,w),bg,dtype=int)
    active_pts=set()
    ok=True
    for u,v in local_wall:
        r,c=mod._map_local(u,v,rad,anchor)
        if not (0<=r<h and 0<=c<w): ok=False
        active_pts.add((r,c)); grid[r,c]=wall_color
    if not ok:
        counts['active_oob']+=1; continue
    trial, blocker = mod._try_add_blocker(grid, wall_color, active_pts, rad)
    if trial is None:
        counts['blocker_fail']+=1; continue
    counts['blocker_ok']+=1
    interior = mod._local_interior(local_wall, depth, gap)
    wall_set = set(local_wall)
    adjacent = [p for p in interior if any((p[0]+dr,p[1]+dc) in wall_set for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)])]
    seed_pool=[p for p in adjacent if p[0] >= max(1, depth-mod.SEED_DEPTH_LOOKBACK)]
    if not seed_pool:
        counts['seed_pool_none']+=1; continue
    blob = mod._grow_seed_blob(random.choice(seed_pool), set(interior))
    grid=trial.copy()
    for u,v in blob:
        r,c=mod._map_local(u,v,rad,anchor)
        if grid[r,c]"'!=bg:
            counts['"'seed_overlap']+=1
            ok=False
            break
        grid[r,c]=fill_color
    if not ok: continue
    try:
        nominal_out = mod.main(grid)
        edge_out = mod._solve(grid, stop_at_other_wall=False)
    except Exception as e:
        counts[f'solve_err_{type(e).__name__}']+=1; continue
    if np.array_equal(nominal_out, edge_out):
        counts['same_as_old_before_obs']+=1; continue
    nominal_fill_zone = (nominal_out==fill_color) & (grid==bg)
    counts['diff_before_obs']+=1
    out, meta = mod._solve(grid, stop_at_other_wall=True, return_meta=True)
    hits=[rm['hit'] is not None for rm in meta['ray_meta']]
    new_fill=(out==fill_color) & (grid==bg)
    if not hits or not all(hits):
        counts['hits_fail_final']+=1; continue
    if int(new_fill.sum()) < mod.MIN_NEW_FILL:
        counts['too_small_before_obs']+=1; continue
    if mod._touches_border(new_fill):
        counts['touches_border_before_obs']+=1; continue
    counts['core_ok_before_obs']+=1
print(counts)
