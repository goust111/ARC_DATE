+        return None
+
+    metrics = _variant_metrics(grid)
+    if metrics["rerouted"] < MIN_MOVERS:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
