+    out = g.copy()
+    out[filled_mask] = fill
+    sprite_mask = info["comp_mask"] | (out == fill)
+
+    info["out"] = out
+    info["filled_mask"] = filled_mask
+    info["sprite_mask"] = sprite_mask
