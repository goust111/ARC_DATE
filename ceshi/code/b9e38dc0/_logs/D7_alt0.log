+
+def _goal_reached(r: int, c: int, rad: tuple[int, int], h: int, w: int) -> bool:
+    if rad == (-1, 0):
+        return r == 0
+    if rad == (1, 0):
+        return r == h - 1
+    if rad == (0, -1):
+        return c == 0
+    return c == w - 1
