+    if goal_state is None:
+        return None
+
+    path = []
+    cur = goal_state
+    while True:
+        r, c, _ = cur
+        path.append((r, c))
+        if (r, c) == (sr, sc):
+            break
+        cur = prev[cur]
+    path.reverse()
+    return path
