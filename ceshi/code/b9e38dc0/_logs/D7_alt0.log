+def _straight_stop(start: tuple[int, int], sprite_mask: np.ndarray, rad: tuple[int, int]) -> tuple[int, int]:
+    h, w = sprite_mask.shape
+    r, c = start
+    last = (r, c)
+    while True:
+        rr, cc = r + rad[0], c + rad[1]
+        if not (0 <= rr < h and 0 <= cc < w):
+            return last
+        if sprite_mask[rr, cc]:
+            return last
+        r, c = rr, cc
+        last = (r, c)
