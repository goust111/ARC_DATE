+def _crop_mask(mask: np.ndarray) -> np.ndarray:
+    pts = np.argwhere(mask)
+    if len(pts) == 0:
+        return mask.copy()
+    r0, c0 = pts.min(axis=0)
+    r1, c1 = pts.max(axis=0)
+    return mask[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1]
+
+
+def _exterior_false_mask(mask: np.ndarray) -> np.ndarray:
+    empty = ~mask
+    lab, _ = label_mask(empty, connectivity=4)
+    exterior = np.zeros_like(mask, dtype=bool)
+    labels = set(map(int, lab[0, :])) | set(map(int, lab[-1, :])) | set(map(int, lab[:, 0])) | set(map(int, lab[:, -1]))
+    for lid in labels:
+        if lid > 0:
+            exterior |= lab == lid
+    return exterior
+
+
+def _hole_adjacent_mask(mask: np.ndarray, holes: list[np.ndarray] | None = None) -> np.ndarray:
+    if holes is None:
+        holes = _get_enclosed_holes(mask)
+    h, w = mask.shape
+    adj = np.zeros((h, w), dtype=bool)
+    for pts in holes:
+        for r, c in pts:
+            for rr, cc in neighbors4(int(r), int(c)):
+                if 0 <= rr < h and 0 <= cc < w and mask[rr, cc]:
+                    adj[rr, cc] = True
+    return adj
+
+
+def _protrusion_candidates(mask: np.ndarray, exterior: np.ndarray) -> list[tuple[int, int, int, int, int]]:
+    h, w = mask.shape
+    cands: list[tuple[int, int, int, int, int]] = []
+    for r, c in np.argwhere(mask):
+        r = int(r)
+        c = int(c)
+        for dr, dc in _DIRS4:
+            rr = r + dr
+            cc = c + dc
+            if not (0 <= rr < h and 0 <= cc < w):
+                continue
+            if not exterior[rr, cc]:
+                continue
+            max_len = 0
+            nr, nc = rr, cc
+            while 0 <= nr < h and 0 <= nc < w and exterior[nr, nc] and not mask[nr, nc]:
+                max_len += 1
+                nr += dr
+                nc += dc
+            if max_len > 0:
+                cands.append((r, c, dr, dc, max_len))
+    return cands
+
+
+def _make_hollow_sprite(h: int, w: int, rng: random.Random) -> np.ndarray | None:
+    """Create a one-hole irregular hollow sprite with outward protrusions."""
+    for _ in range(_SHAPE_RETRIES):
+        canvas = np.zeros((h, w), dtype=bool)
+        core_h = rng.randint(3, h - 1)
+        core_w = rng.randint(3, w - 1)
+        spare_h = h - core_h
+        spare_w = w - core_w
+        if spare_h + spare_w == 0:
+            continue
+        r0 = rng.randint(0, spare_h)
+        c0 = rng.randint(0, spare_w)
+
+        canvas[r0 : r0 + core_h, c0 : c0 + core_w] = True
+        canvas[r0 + 1 : r0 + core_h - 1, c0 + 1 : c0 + core_w - 1] = False
+
+        need = rng.randint(_PROTRUSION_MIN, _PROTRUSION_MAX)
+        added = 0
+        for _ in range(10):
+            exterior = _exterior_false_mask(canvas)
+            cands = _protrusion_candidates(canvas, exterior)
+            if not cands:
+                break
+            rng.shuffle(cands)
+            placed = False
+            for ar, ac, dr, dc, max_len in cands:
+                length = rng.randint(1, min(_PROTRUSION_LEN_MAX, max_len))
+                coords = []
+                nr, nc = ar + dr, ac + dc
+                ok = True
+                for _ in range(length):
+                    if not (0 <= nr < h and 0 <= nc < w) or canvas[nr, nc]:
+                        ok = False
+                        break
+                    coords.append((nr, nc))
+                    nr += dr
+                    nc += dc
+                if not ok:
+                    continue
+                for rr, cc in coords:
+                    canvas[rr, cc] = True
+                added += 1
+                placed = True
+                break
+            if not placed or added >= need:
+                break
+
+        sprite = _crop_mask(canvas)
+        holes = _get_enclosed_holes(sprite)
+        if len(holes) != 1:
+            continue
+        hole_adj = _hole_adjacent_mask(sprite, holes)
+        support = sprite & (~hole_adj)
+        if int(support.sum()) < 3:
+            continue
+        if int(sprite.sum()) > _SPRITE_CELL_MAX:
+            continue
+        return sprite
+    return None
 
 
