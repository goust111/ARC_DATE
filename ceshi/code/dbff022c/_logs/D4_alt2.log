   286	
   287	def _object_labels_and_majorities(g: np.ndarray, bg: int, pal_mask: np.ndarray) -> tuple[np.ndarray, dict[int, int]]:
   288	    obj_mask = (g != bg) & (~pal_mask)
   289	    obj_lab, obj_n = label_mask(obj_mask, connectivity=4)
   290	    majorities: dict[int, int] = {}
   291	    for oid in range(1, obj_n + 1):
   292	        pts = np.argwhere(obj_lab == oid)
   293	        vals = [int(g[int(r), int(c)]) for r, c in pts]
   294	        majorities[int(oid)] = _majority_color(vals)
   295	    return obj_lab, majorities
