    76	def _best_palette(g: np.ndarray, bg: int) -> tuple[str, int, int]:
    77	    """
    78	    Find the 2xN or Nx2 palette block on a grid edge.
    79	
    80	    Returns (side, start, end) where:
    81	      - side in {"top","bottom","left","right"}
    82	      - for top/bottom: start/end are column indices [start,end)
    83	      - for left/right: start/end are row indices [start,end)
