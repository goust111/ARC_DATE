   339	def main(grid: np.ndarray) -> np.ndarray:
   340	    """
   341	    Fill hollow sprites' interiors using an edge palette and each sprite's majority border color.
   342	
   343	    Input structure:
   344	    - bg is the dominant boundary color.
   345	    - A 2xN or Nx2 palette legend sits on one grid edge; its outer line gives lookup keys and its inner line gives fill colors.
   346	    - Hollow sprites are irregular connected border objects whose cells may alternate between 2 or more colors around the same hole.
   347	
   348	    Rule:
   349	    - Detect the edge palette and read it as a border-key to fill-color mapping.
   350	    - Find enclosed background regions that do not touch the outer grid boundary.
   351	    - For each enclosed region, identify the surrounding multicolor sprite, compute that sprite's most frequent border color, and fill the region only if that majority color appears in the palette mapping.
   352	
   353	    Key insight: the correct lookup key is no longer the locally adjacent color near the hole; it is the majority color over the entire enclosing sprite component.
   354	    """
   355	    g = np.asarray(grid, dtype=int)
   356	    bg = _bg_boundary(g)
   357	
   358	    mapping, pal_mask = _palette_mapping(g, bg)
   359	    assert mapping, "main: palette mapping must be non-empty"
   360	
   361	    out = g.copy()
   362	    _fill_enclosed_bg_regions(g, out, bg, mapping, pal_mask)
   363	    return out
   364	
   365	
   366	# --------------- generator (D4 majority-border variant) ---------------
   367	
   368	# -- Configuration constants -------------------------------------------------
   369	_GRID_H_MIN, _GRID_H_MAX = 7, 13
   370	_GRID_W_MIN, _GRID_W_MAX = 10, 15
   371	_SMALL_H_THRESHOLD = 8
   372	_SMALL_H_PALETTE_FLIP = 0.7
   373	
   374	_PALETTE_N_MIN, _PALETTE_N_MAX = 2, 5
   375	
   376	_SPRITE_H_MIN, _SPRITE_H_MAX = 4, 7
   377	_SPRITE_W_MIN, _SPRITE_W_MAX = 4, 6
   378	_SPRITE_DIM_SUM_CAP = 11
   379	_SPRITE_CELL_MAX = 22
   380	_FILLED_SPRITE_MAX = 2
   381	
   382	_PROTRUSION_MIN = 2
   383	_PROTRUSION_MAX = 4
   384	_PROTRUSION_LEN_MAX = 2
   385	
   386	_MAX_RETRIES = 500
   387	_SHAPE_RETRIES = 80
   388	_PAINT_RETRIES = 40
   389	# -- End configuration -------------------------------------------------------
   390	
   391	_DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
   392	
   393	
   394	def _get_enclosed_holes(sprite: np.ndarray) -> list[np.ndarray]:
   395	    """Return bg components inside the sprite that do not touch sprite bbox boundary."""
   396	    h, w = sprite.shape
   397	    return [
   398	        pts
   399	        for pts in components_mask(~sprite, connectivity=4)
   400	        if not any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)
   401	    ]
   402	
   403	
   404	def _crop_mask(mask: np.ndarray) -> np.ndarray:
   405	    pts = np.argwhere(mask)
   406	    if len(pts) == 0:
   407	        return mask.copy()
   408	    r0, c0 = pts.min(axis=0)
   409	    r1, c1 = pts.max(axis=0)
   410	    return mask[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1]
   411	
   412	
   413	def _exterior_false_mask(mask: np.ndarray) -> np.ndarray:
   414	    empty = ~mask
   415	    lab, _ = label_mask(empty, connectivity=4)
   416	    exterior = np.zeros_like(mask, dtype=bool)
   417	    labels = set(map(int, lab[0, :])) | set(map(int, lab[-1, :])) | set(map(int, lab[:, 0])) | set(map(int, lab[:, -1]))
   418	    for lid in labels:
   419	        if lid > 0:
   420	            exterior |= lab == lid
   421	    return exterior
