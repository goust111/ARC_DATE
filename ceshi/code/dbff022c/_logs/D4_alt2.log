   164	                if len(d) < 3:
   165	                    continue
   166	                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]
   167	                if len(border_keys) == 0 or len(border_keys) != len(set(border_keys)):
   168	                    continue
   169	                if not isolated("bottom", c0, c1):
   170	                    continue
   171	                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))
   172	                score = (len(set(border_keys)), len(d), -(c1 - c0), nonbg)
   173	                cand = (score, "bottom", c0, c1)
   174	                if best is None or cand[0] > best[0]:
