import importlib.util
import numpy as np
from collections import Counter
from pathlib import Path
import sys

repo = Path('/home/lixinyu/snap/new')
sys.path.insert(0, str(repo / 'solvers'))
from arc_utils import components_mask, neighbors4

spec = importlib.util.spec_from_file_location('variant', str(repo / 'ceshi/code/dbff022c/D4/2/code.py'))
mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)


def old_like(grid):
    g = np.asarray(grid, dtype=int)
    bg = mod._bg_boundary(g)
    mapping, pal_mask = mod._palette_mapping(g, bg)
    out = g.copy()
    h, w = out.shape
    bg_mask = (out == bg) & (~pal_mask)
    for pts in components_mask(bg_mask, connectivity=4):
        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):
            continue
        adj_counts = {}
        for r, c in pts:
            for rr, cc in neighbors4(int(r), int(c)):
                if 0 <= rr < h and 0 <= cc < w:
                    if pal_mask[rr, cc]:
                        continue
                    v = int(out[rr, cc])
                    if v == bg:
                        continue
                    adj_counts[v] = adj_counts.get(v, 0) + 1
        border = None
        best = -1
        for col, cnt in adj_counts.items():
            if col not in mapping:
                continue
            if cnt > best:
                best = cnt
                border = col
        if border is None:
            continue
        out[tuple(pts.T)] = int(mapping[border])
    return out

samples = 50
mismatch_holes = []
diff_outputs = 0
filled_holes = 0
for _ in range(samples):
    inp = mod.generate_input()
    bg = mod._bg_boundary(inp)
    mapping, pal_mask = mod._palette_mapping(inp, bg)
    obj_lab, obj_major = mod._object_labels_and_majorities(inp, bg, pal_mask)
    bg_mask = (inp == bg) & (~pal_mask)
    local_mismatch = 0
    for pts in components_mask(bg_mask, connectivity=4):
        h, w = inp.shape
        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):
            continue
        obj_touch = Counter()
        color_touch = Counter()
        for r, c in pts:
            for rr, cc in neighbors4(int(r), int(c)):
                if 0 <= rr < h and 0 <= cc < w and not pal_mask[rr, cc]:
                    oid = int(obj_lab[rr, cc])
                    if oid:
                        obj_touch[oid] += 1
                        color_touch[int(inp[rr, cc])] += 1
        if not obj_touch:
            continue
        oid = obj_touch.most_common(1)[0][0]
        maj = obj_major[oid]
        local = color_touch.most_common(1)[0][0]
        if maj in mapping:
            filled_holes += 1
            if local "'!= maj:
                local_mismatch += 1
    mismatch_holes.append(local_mismatch)
    if not np.array_equal(mod.main(inp), old_like(inp)):
        diff_outputs += 1

print('"'samples', samples)
print('holes_with_majority-vs-local mismatch total', sum(mismatch_holes))
print('samples_with_mismatch', sum(x > 0 for x in mismatch_holes))
print('filled_holes', filled_holes)
print('samples_where_old_and_new_outputs_differ', diff_outputs)
print('mismatch_distribution', {k: mismatch_holes.count(k) for k in sorted(set(mismatch_holes))})
