   297	
   298	def _fill_enclosed_bg_regions(
   299	    src: np.ndarray,
   300	    out: np.ndarray,
   301	    bg: int,
   302	    mapping: dict[int, int],
   303	    pal_mask: np.ndarray,
   304	) -> None:
   305	    """
   306	    Fill enclosed bg regions by the majority color of the enclosing multicolor sprite.
   307	    """
   308	    h, w = src.shape
   309	    obj_lab, obj_majorities = _object_labels_and_majorities(src, bg, pal_mask)
   310	    bg_mask = (src == bg) & (~pal_mask)
   311	    comps = components_mask(bg_mask, connectivity=4)
   312	    for pts in comps:
   313	        touches_boundary = any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)
   314	        if touches_boundary:
   315	            continue
   316	
   317	        touch_counts: Counter[int] = Counter()
   318	        for r, c in pts:
   319	            for rr, cc in neighbors4(int(r), int(c)):
   320	                if 0 <= rr < h and 0 <= cc < w:
   321	                    if pal_mask[rr, cc]:
   322	                        continue
   323	                    oid = int(obj_lab[rr, cc])
   324	                    if oid != 0:
   325	                        touch_counts[oid] += 1
   326	        if not touch_counts:
   327	            continue
   328	
   329	        oid = int(touch_counts.most_common(1)[0][0])
   330	        border = int(obj_majorities[oid])
   331	        if border not in mapping:
   332	            continue
   333	
   334	        fill = int(mapping[border])
   335	        for r, c in pts:
   336	            out[int(r), int(c)] = fill
