   246	
   247	def _palette_mapping(g: np.ndarray, bg: int) -> tuple[dict[int, int], np.ndarray]:
   248	    """
   249	    Returns (mapping border->fill, palette_mask).
   250	    """
   251	    h, w = g.shape
   252	    side, start, end = _best_palette(g, bg)
   253	    pal_mask = np.zeros((h, w), dtype=bool)
   254	    mapping: dict[int, int] = {}
   255	
   256	    if side == "top":
   257	        pal_mask[0:2, start:end] = True
   258	        border_line = g[0, start:end]
   259	        fill_line = g[1, start:end]
   260	    elif side == "bottom":
   261	        pal_mask[h - 2 : h, start:end] = True
   262	        border_line = g[h - 1, start:end]
   263	        fill_line = g[h - 2, start:end]
   264	    elif side == "left":
   265	        pal_mask[start:end, 0:2] = True
   266	        border_line = g[start:end, 0]
   267	        fill_line = g[start:end, 1]
   268	    else:
   269	        pal_mask[start:end, w - 2 : w] = True
   270	        border_line = g[start:end, w - 1]
   271	        fill_line = g[start:end, w - 2]
   272	
   273	    for b, f in zip(border_line.tolist(), fill_line.tolist(), strict=False):
   274	        b = int(b)
   275	        f = int(f)
   276	        if b == bg:
   277	            continue
   278	        mapping[b] = f
   279	
   280	    return mapping, pal_mask
