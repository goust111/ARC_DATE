   142	                score = (len(set(border_keys)), len(d), -(c1 - c0), nonbg)
   143	                cand = (score, "top", c0, c1)
   144	                if best is None or cand[0] > best[0]:
   145	                    best = cand
   146	
   147	    def consider_bottom() -> None:
   148	        nonlocal best
   149	        if h < 2:
   150	            return
   151	        a = g[h - 1, :]
   152	        b = g[h - 2, :]
   153	        for c0 in range(w):
   154	            for c1 in range(c0 + 2, w + 1):
   155	                seg_a = a[c0:c1]
   156	                seg_b = b[c0:c1]
   157	                da = set(map(int, np.unique(seg_a)))
   158	                db = set(map(int, np.unique(seg_b)))
