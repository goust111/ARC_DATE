   461	def _make_hollow_sprite(h: int, w: int, rng: random.Random) -> np.ndarray | None:
   462	    """Create a one-hole irregular hollow sprite with outward protrusions."""
   463	    for _ in range(_SHAPE_RETRIES):
   464	        canvas = np.zeros((h, w), dtype=bool)
   465	        core_h = rng.randint(3, h - 1)
   466	        core_w = rng.randint(3, w - 1)
   467	        spare_h = h - core_h
   468	        spare_w = w - core_w
   469	        if spare_h + spare_w == 0:
   470	            continue
   471	        r0 = rng.randint(0, spare_h)
   472	        c0 = rng.randint(0, spare_w)
   473	
   474	        canvas[r0 : r0 + core_h, c0 : c0 + core_w] = True
   475	        canvas[r0 + 1 : r0 + core_h - 1, c0 + 1 : c0 + core_w - 1] = False
   476	
   477	        need = rng.randint(_PROTRUSION_MIN, _PROTRUSION_MAX)
   478	        added = 0
   479	        for _ in range(10):
   480	            exterior = _exterior_false_mask(canvas)
   481	            cands = _protrusion_candidates(canvas, exterior)
   482	            if not cands:
   483	                break
   484	            rng.shuffle(cands)
   485	            placed = False
   486	            for ar, ac, dr, dc, max_len in cands:
   487	                length = rng.randint(1, min(_PROTRUSION_LEN_MAX, max_len))
   488	                coords = []
   489	                nr, nc = ar + dr, ac + dc
   490	                ok = True
   491	                for _ in range(length):
   492	                    if not (0 <= nr < h and 0 <= nc < w) or canvas[nr, nc]:
   493	                        ok = False
   494	                        break
   495	                    coords.append((nr, nc))
   496	                    nr += dr
   497	                    nc += dc
   498	                if not ok:
   499	                    continue
   500	                for rr, cc in coords:
   501	                    canvas[rr, cc] = True
   502	                added += 1
   503	                placed = True
   504	                break
   505	            if not placed or added >= need:
   506	                break
   507	
   508	        sprite = _crop_mask(canvas)
   509	        holes = _get_enclosed_holes(sprite)
   510	        if len(holes) != 1:
   511	            continue
   512	        hole_adj = _hole_adjacent_mask(sprite, holes)
   513	        support = sprite & (~hole_adj)
   514	        if int(support.sum()) < 3:
   515	            continue
   516	        if int(sprite.sum()) > _SPRITE_CELL_MAX:
   517	            continue
   518	        return sprite
   519	    return None
