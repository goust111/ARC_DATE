    85	    h, w = g.shape
    86	    best = None  # (score_tuple, side, start, end)
    87	
    88	    def isolated(side: str, start: int, end: int) -> bool:
    89	        """
    90	        Palette cells (excluding bg) should not be 4-neigh adjacent to same-colored cells
    91	        outside the palette region; this prevents accidentally absorbing parts of large sprites
    92	        that touch the grid edge.
    93	        """
    94	        h2, w2 = g.shape
    95	        pal = np.zeros((h2, w2), dtype=bool)
    96	        if side == "top":
    97	            pal[0:2, start:end] = True
    98	        elif side == "bottom":
    99	            pal[h2 - 2 : h2, start:end] = True
   100	        elif side == "left":
   101	            pal[start:end, 0:2] = True
   102	        else:
   103	            pal[start:end, w2 - 2 : w2] = True
   104	
   105	        for r, c in zip(*np.where(pal), strict=False):
   106	            r = int(r)
   107	            c = int(c)
   108	            v = int(g[r, c])
   109	            if v == bg:
   110	                continue
   111	            for rr, cc in neighbors4(r, c):
   112	                if 0 <= rr < h2 and 0 <= cc < w2 and not pal[rr, cc]:
   113	                    if int(g[rr, cc]) == v:
   114	                        return False
   115	        return True
   116	
   117	    def consider_top() -> None:
   118	        nonlocal best
   119	        if h < 2:
   120	            return
   121	        a = g[0, :]
   122	        b = g[1, :]
   123	        for c0 in range(w):
   124	            for c1 in range(c0 + 2, w + 1):
   125	                seg_a = a[c0:c1]
   126	                seg_b = b[c0:c1]
   127	                da = set(map(int, np.unique(seg_a)))
   128	                db = set(map(int, np.unique(seg_b)))
   129	                da.discard(bg)
   130	                db.discard(bg)
   131	                if len(da) < 2 or len(db) < 2:
   132	                    continue
