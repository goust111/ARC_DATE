   424	def _hole_adjacent_mask(mask: np.ndarray, holes: list[np.ndarray] | None = None) -> np.ndarray:
   425	    if holes is None:
   426	        holes = _get_enclosed_holes(mask)
   427	    h, w = mask.shape
   428	    adj = np.zeros((h, w), dtype=bool)
   429	    for pts in holes:
   430	        for r, c in pts:
   431	            for rr, cc in neighbors4(int(r), int(c)):
   432	                if 0 <= rr < h and 0 <= cc < w and mask[rr, cc]:
   433	                    adj[rr, cc] = True
   434	    return adj
