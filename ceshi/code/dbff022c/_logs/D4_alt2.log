   436	
   437	def _protrusion_candidates(mask: np.ndarray, exterior: np.ndarray) -> list[tuple[int, int, int, int, int]]:
   438	    h, w = mask.shape
   439	    cands: list[tuple[int, int, int, int, int]] = []
   440	    for r, c in np.argwhere(mask):
   441	        r = int(r)
   442	        c = int(c)
   443	        for dr, dc in _DIRS4:
   444	            rr = r + dr
   445	            cc = c + dc
   446	            if not (0 <= rr < h and 0 <= cc < w):
   447	                continue
   448	            if not exterior[rr, cc]:
   449	                continue
   450	            max_len = 0
   451	            nr, nc = rr, cc
   452	            while 0 <= nr < h and 0 <= nc < w and exterior[nr, nc] and not mask[nr, nc]:
   453	                max_len += 1
   454	                nr += dr
   455	                nc += dc
   456	            if max_len > 0:
   457	                cands.append((r, c, dr, dc, max_len))
   458	    return cands
