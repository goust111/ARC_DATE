   446	) -> tuple[list[int], list[int], int, int, dict[int, int], list[int]]:
   447	    """
   448	    Pick palette keys, palette fills, one placeholder interior color, one distractor border,
   449	    and the subset of palette keys that actually appear on recolorable sprites.
   450	    """
   451	    all_c = list(range(1, 10))
   452	    rng.shuffle(all_c)
   453	    border_keys = all_c[:n]
   454	
   455	    remaining = [c for c in all_c if c not in border_keys]
   456	    rng.shuffle(remaining)
   457	    interior_placeholder = remaining[0]
   458	    distractor_border = remaining[1]
