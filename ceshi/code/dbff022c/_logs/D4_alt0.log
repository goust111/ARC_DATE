   485	def _place_palette(grid: np.ndarray, occ: np.ndarray, pal: np.ndarray, side: str, rng: random.Random) -> None:
   486	    """Place palette on the chosen edge and mark its occupancy with one-cell padding."""
   487	    h, w = grid.shape
   488	    pal_h, pal_w = pal.shape
   489	    if side == "top":
   490	        pr0, pc0 = 0, rng.randint(0, w - pal_w)
   491	    elif side == "bottom":
   492	        pr0, pc0 = h - pal_h, rng.randint(0, w - pal_w)
   493	    elif side == "left":
   494	        pr0, pc0 = rng.randint(0, h - pal_h), 0
   495	    else:
   496	        pr0, pc0 = rng.randint(0, h - pal_h), w - pal_w
   497	    grid[pr0 : pr0 + pal_h, pc0 : pc0 + pal_w] = pal
   498	    occ[max(0, pr0 - 1) : min(h, pr0 + pal_h + 1), max(0, pc0 - 1) : min(w, pc0 + pal_w + 1)] = True
