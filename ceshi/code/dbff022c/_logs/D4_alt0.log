   501	def _find_valid_positions(
   502	    h: int, w: int, occ: np.ndarray, mask: np.ndarray, holes: list[np.ndarray]
   503	) -> list[tuple[int, int]]:
   504	    """Find placements where the border mask fits and all interior cells stay off the outer border."""
   505	    sh, sw = mask.shape
   506	    positions = []
   507	    for r0 in range(h - sh + 1):
   508	        for c0 in range(w - sw + 1):
   509	            if occ[max(0, r0 - 1) : min(h, r0 + sh + 1), max(0, c0 - 1) : min(w, c0 + sw + 1)].any():
   510	                continue
   511	            if any(
   512	                r0 + hr == 0 or c0 + hc == 0 or r0 + hr == h - 1 or c0 + hc == w - 1
   513	                for hpts in holes
   514	                for hr, hc in hpts
   515	            ):
   516	                continue
   517	            positions.append((r0, c0))
   518	    return positions
