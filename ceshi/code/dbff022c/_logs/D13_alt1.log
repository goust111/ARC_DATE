+def _component_to_mask(pts: np.ndarray) -> np.ndarray:
+    """Crop a component's coordinates to its own bbox and return a boolean mask."""
+    rs = pts[:, 0]
+    cs = pts[:, 1]
+    r0 = int(rs.min())
+    c0 = int(cs.min())
+    mask = np.zeros((int(rs.max()) - r0 + 1, int(cs.max()) - c0 + 1), dtype=bool)
+    mask[rs - r0, cs - c0] = True
