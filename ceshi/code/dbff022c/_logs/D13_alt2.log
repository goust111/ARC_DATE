+
+# Sprite geometry
+_SPRITE_H_MAX = 7
+_SPRITE_W_MAX = 6
+_SPRITE_DIM_SUM_CAP = 10
+_SPRITE_CELL_MAX = 16
+_SPRITE_COUNT_MAX = 4
+
