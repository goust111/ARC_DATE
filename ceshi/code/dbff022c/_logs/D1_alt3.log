import importlib.util
import numpy as np
from collections import Counter

spec = importlib.util.spec_from_file_location('variant', '/home/lixinyu/snap/new/ceshi/code/dbff022c/D1/3/code.py')
mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)


def one_map_output(inp, mapping):
    g = np.asarray(inp, dtype=int)
    bg = mod._bg_boundary(g)
    out = g.copy()
    large_map, small_map, pal_mask = mod._palette_mappings(g, bg)
    mod._fill_enclosed_bg_regions(out, bg, mapping, mapping, pal_mask)
    return out


def inspect_groups(inp):
    g = np.asarray(inp, dtype=int)
    bg = mod._bg_boundary(g)
    large_map, small_map, pal_mask = mod._palette_mappings(g, bg)
    keyset = set(large_map) & set(small_map)
    comps = mod.components_mask((g == bg) & (~pal_mask), connectivity=4)
    hole_infos = []
    h, w = g.shape
    for pts in comps:
        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):
            continue
        adj_counts = {}
        adj_seed = {}
        for r, c in pts:
            for rr, cc in mod.neighbors4(int(r), int(c)):
                if 0 <= rr < h and 0 <= cc < w and not pal_mask[rr, cc]:
                    v = int(g[rr, cc])
                    if v == bg:
                        continue
                    adj_counts[v] = adj_counts.get(v, 0) + 1
                    adj_seed.setdefault(v, (int(rr), int(cc)))
        border = None
        best = -1
        for col, cnt in adj_counts.items():
            if col not in keyset:
                continue
            if cnt > best:
                best = cnt
                border = col
        if border is None:
            continue
        area = mod._component_area_from_seed(g, pal_mask, adj_seed[border])
        hole_infos.append((border, area, len(pts)))
    areas = [area for _, area, _ in hole_infos]
    small_area = min(areas)
    large_area = max(areas)
    pivot = (small_area + large_area) / 2.0
    counts = Counter('large' if area > pivot else 'small' for _, area, _ in hole_infos)
    return {
        'counts': counts,
        'areas': tuple(sorted(set(areas))),
        'palette_width': len(large_map),
        'same_columns': sum(int(large_map[k] == small_map[k]) for k in large_map),
        'large_map': large_map,
        'small_map': small_map,
    }

samples = 80
both_groups = 0
large_only_same = 0
small_only_same = 0
area_patterns = Counter()
palette_sizes = Counter()
large_holes = 0
small_holes = 0
same_column_violations = 0

for _ in range(samples):
    inp = mod.generate_input()
    out = mod.main(inp)
    info = inspect_groups(inp)
    palette_sizes[info['palette_width']] += 1
    area_patterns[info['areas']] += 1
    large_holes += info['counts']['large']
    small_holes += info['counts']['small']
    if info['counts']['large'] > 0 and info['counts']['small'] > 0:
        both_groups += 1
    if info['same_columns']:
        same_column_violations += 1
    if np.array_equal(out, one_map_output(inp, info['large_map'])):
        large_only_same += 1
    if np.array_equal(out, one_map_output(inp, info['small_map'])):
        small_only_same += 1

print('samples', samples)
print('both_groups_used', both_groups)
print('large_only_collapse_matches', large_only_same)
print('small_only_collapse_matches', small_only_same)
print('total_large_holes', large_holes)
print('total_small_holes', small_holes)
print('palette_sizes', dict(palette_sizes))
print('area_patterns', dict(area_patterns))
print('same_column_violations', same_column_violations)
