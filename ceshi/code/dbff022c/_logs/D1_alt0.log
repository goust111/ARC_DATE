    border = np.concatenate([inp[0], inp[-1], inp[1:-1, 0], inp[1:-1, -1]])
    vals, cnts = np.unique(border, return_counts=True)
    if int(vals[cnts.argmax()]) "'!= bg:
        reasons['"'bg_not_dominant'] += 1
        continue
    try:
        out2 = mod.main(inp)
    except Exception as e:
        reasons[f'main_exc:{type(e).__name__}'] += 1
        continue
    if not np.array_equal(out2, output):
        reasons['oracle_mismatch'] += 1
        if reasons['oracle_mismatch'] <= 2:
            print('mismatch example shape', inp.shape, 'side', side, 'n', n)
            print(inp)
            print('expected')
            print(output)
            print('got')
            print(out2)
        continue
    reasons['success'] += 1
print(reasons)
