reasons = collections.Counter()
for trial in range(200):
    rng = random.Random()
    bg = 0
    h = rng.randint(mod._GRID_H_MIN, mod._GRID_H_MAX)
    w = rng.randint(mod._GRID_W_MIN, mod._GRID_W_MAX)
    side = rng.choice(['top','bottom','left','right'])
    if h <= mod._SMALL_H_THRESHOLD and side in ('top','bottom') and rng.random() < mod._SMALL_H_PALETTE_FLIP:
        side = rng.choice(['left','right'])
    max_n = h if side in ('left','right') else w
    n = rng.randint(mod._PALETTE_N_MIN, min(mod._PALETTE_N_MAX, max_n))
    num_mapped = rng.randint(1, min(mod._FILLED_SPRITE_MAX, n))
    total_sprites = num_mapped + 1
    color_info = mod._choose_colors(rng, n, num_mapped)
    if color_info is None:
        reasons['choose_colors'] += 1
        continue
    fill_keys, border_values, mapping, mapped_fill_keys, distractor_seed, distractor_border = color_info
    pal = mod._build_palette(side, fill_keys, border_values)
    output = np.full((h, w), bg, dtype=int)
    occ = np.zeros((h, w), dtype=bool)
    mod._place_palette(output, occ, pal, side, rng)
    sprite_specs = []
    bad = False
    for i in range(total_sprites):
        sh = rng.randint(mod._RECT_H_MIN, min(mod._RECT_H_MAX, h))
        sw = rng.randint(mod._RECT_W_MIN, min(mod._RECT_W_MAX, w))
        if sh + sw > mod._RECT_DIM_SUM_CAP:
            sw = max(mod._RECT_W_MIN, mod._RECT_DIM_SUM_CAP - sh)
        if sh >= h or sw >= w:
            reasons['shape_ge_grid'] += 1
            bad = True
            break
        full_mask = mod._make_rect_frame(sh, sw)
        broken_mask = mod._remove_gap(full_mask, rng)
        interior = mod._interior_cells(full_mask)
        if not interior:
            reasons['no_interior'] += 1
            bad = True
            break
        seed_count = rng.randint(1, min(mod._SEED_MAX, len(interior)))
        seed_cells = rng.sample(interior, seed_count)
        if i < num_mapped:
            seed_color = mapped_fill_keys[i]
            border_color = mapping[seed_color]
        else:
            seed_color = distractor_seed
            border_color = distractor_border
        sprite_specs.append((full_mask, broken_mask, border_color, seed_cells, seed_color))
    if bad:
        continue
    placed = []
    for full_mask, broken_mask, border_color, seed_cells, seed_color in sprite_specs:
        positions = mod._find_valid_positions(h, w, occ, full_mask)
        if not positions:
            reasons['no_positions'] += 1
            bad = True
            break
        r0, c0 = rng.choice(positions)
        mod._paint_sprite(output, r0, c0, full_mask, border_color, seed_cells, seed_color)
        placed.append((r0, c0, full_mask, broken_mask, border_color, seed_cells, seed_color))
        sh, sw = full_mask.shape
        occ[max(0, r0 - 1):min(h, r0 + sh + 1), max(0, c0 - 1):min(w, c0 + sw + 1)] = True
    if bad:
        continue
    inp = output.copy()
    for r0, c0, full_mask, broken_mask, border_color, seed_cells, seed_color in placed:
        sh, sw = full_mask.shape
        for rr in range(sh):
            for cc in range(sw):
                if full_mask[rr, cc] and not broken_mask[rr, cc]:
                    inp[r0 + rr, c0 + cc] = bg
    border = np.concatenate([inp[0], inp[-1], inp[1:-1, 0], inp[1:-1, -1]])
    vals, cnts = np.unique(border, return_counts=True)
    if int(vals[cnts.argmax()]) "'!= bg:
        reasons['"'bg_not_dominant'] += 1
        continue
    try:
        out2 = mod.main(inp)
    except Exception as e:
        reasons[f'main_exc:{type(e).__name__}'] += 1
        continue
    if not np.array_equal(out2, output):
        reasons['oracle_mismatch'] += 1
        if reasons['oracle_mismatch'] <= 2:
            print('mismatch example shape', inp.shape, 'side', side, 'n', n)
            print(inp)
            print('expected')
            print(output)
            print('got')
            print(out2)
        continue
    reasons['success'] += 1
print(reasons)
