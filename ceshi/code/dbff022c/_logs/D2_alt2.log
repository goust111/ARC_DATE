+# Variant of dbff022c
+# Dimension: D2 — 调色板图例的位置与朝向 (symbol_instructions)
+# Change: 调色板为2xN或Nx2色块，位于网格边缘（上/下/左），根据所在边缘确定阅读方向：上边缘从上到下读，下边缘从下到上读，左... → 调色板使用嵌套方框编码——外框色为边框色，内部色为填充色
+
+"""
+design_analysis:
+  variant_goal:
+    keep:
+      - 仍然是“根据边框颜色查找填充颜色，再填充空心精灵内部洞区”
+      - 仍然只填不接触整张网格边界的背景连通域
+      - 仍然保留 1 个不在图例中的干扰精灵
+    change:
+      - 原题图例是 2xN / Nx2 色条，需要依赖图例所在边缘决定读取方向
+      - 本变体把每个映射项改成一个独立的 3x3 嵌套方框：
+        外圈 8 格颜色 = 精灵边框颜色；中心 1 格颜色 = 目标填充颜色
+
+  concrete_form_and_trace:
+    legend_geometry:
+      - 顶边/底边图例: 整体厚度 3，水平连续排布若干个 3x3 方框
+      - 左边/右边图例: 整体厚度 3，竖直连续排布若干个 3x3 方框
+      - 每个图例项是自解释的，不再需要“上边读上行、下边读下行”这种方向规则
+    small_example:
+      old_logic:
+        - 顶边 2x3 色条 [[4,7,8],[6,2,3]] 表示 4->6, 7->2, 8->3
+      new_logic:
+        - 顶边放三个 3x3 小方框:
+          1) 外框 4, 中心 6
+          2) 外框 7, 中心 2
+          3) 外框 8, 中心 3
+        - solver 不再按“条带的某一行/列”解码，而是按 3x3 图块逐个读取 (外框色, 中心色)
+      difference:
+        - 原题依赖位置决定读向；新题依赖图例项内部结构决定映射
+        - 因此 main() 中原先寻找 2-cell 厚条带并拆两行/两列的代码必须整体替换
+
+  complexity_calibration:
+    choices:
+      - 图例项固定为 3x3，而不是允许多种尺寸；这样既可见，又不会让检测逻辑过度自由
+      - 图例项数量保持 2-4 个；足够支持“有用项 + 未使用项”，也能在 10-15 宽网格中稳定摆放
+      - 所有 border key、fill value、distractor color 两两不同，避免视觉和逻辑歧义
+    why_not_simpler:
+      - 如果只是把原 2xN 色条改成“2xN 里画点装饰”，视觉上很难看出 D2 已变化
+      - 如果允许图例项尺寸/间隔变化太大，solver 会引入额外自由度，样例更难归纳
+
+  implicit_assumption_audit:
+    old_code_dependencies_broken_by_variant:
+      - _best_palette 假设图例是整块 2 行或 2 列的连续条带；新图例不满足
+      - _palette_mapping 直接把某一整行/整列当 border，另一行/列当 fill；新图例必须逐块读取
+      - 原评分逻辑依赖“边框 key 出现在同一行/列且唯一”；新题唯一性要改为“每个 3x3 图例项的外框色唯一”
+    unchanged_safe_parts:
+      - _fill_enclosed_bg_regions 只依赖最终 border->fill 映射和 palette_mask，因此可以保留
+      - output-first 生成器依然能先构造已填充输出，再把洞区清空得到输入
+
+  placement_legality:
+    legend_constraints:
+      - 图例仅放在一条外边上
+      - 图例总长度为 3*N，N in [2,4]
+      - 通过 occupancy padding 与精灵保持至少 1 格背景隔离
+    sprite_constraints:
+      - 精灵仍使用原题的空心单色轮廓生成方式
+      - 洞区在整张网格中不能碰边，否则 solver 会故意跳过
+      - 干扰精灵颜色不出现在图例外框色中
+    solver_compatibility:
+      - 图例外框和中心色不会与 palette 外同色单元 4 邻接，避免把贴边精灵误判成图例
+
+  observability_and_cleanliness:
+    observability:
+      - 人类可直接看到“边缘上一串小方框，每个方框像一个颜色词典项”
+      - 输出只改变精灵内部洞区，和原题一致，因此可把变化归因到图例编码方式而非对象本体变化
+    cleanliness:
+      - 图例限制为单条边、单层编码，不与精灵叠加
+      - 颜色集合受控，避免太多无提示颜色变化
+
+  main_assumptions_and_generator_guarantees:
+    - 输入恰有一组位于单条边上的 3x3 嵌套方框图例，且至少 2 项
+    - 每项外框色非背景、中心色非背景且与外框色不同
+    - 外框 key 唯一；generator 也让 fill 值唯一以增强可读性
+    - 精灵与图例之间至少隔 1 格背景，因此 palette 隔离检测成立
+"""
+
+import random
+
+import numpy as np
+
+from arc_utils import components_mask, neighbors4
+
+
+def _bg_boundary(g: np.ndarray) -> int:
+    """Most common color along the 1-cell outer border."""
+    border = np.concatenate([g[0, :], g[-1, :], g[1:-1, 0], g[1:-1, -1]])
+    vals, cnts = np.unique(border, return_counts=True)
+    return int(vals[cnts.argmax()])
+
+
+def _nested_box_colors(block: np.ndarray, bg: int) -> tuple[int, int] | None:
+    """Return (border_color, fill_color) for a valid 3x3 nested-box legend cell."""
+    if block.shape != (3, 3):
+        return None
+    border = np.array(
+        [
+            block[0, 0],
+            block[0, 1],
+            block[0, 2],
+            block[1, 0],
+            block[1, 2],
+            block[2, 0],
+            block[2, 1],
+            block[2, 2],
+        ],
+        dtype=int,
+    )
+    b = int(border[0])
+    if b == bg or np.any(border != b):
+        return None
+    f = int(block[1, 1])
+    if f == bg or f == b:
+        return None
+    return b, f
+
+
+def _edge_mask(shape: tuple[int, int], side: str, start: int, count: int) -> np.ndarray:
+    """Mask for a legend made of `count` adjacent 3x3 nested boxes on one edge."""
+    h, w = shape
+    mask = np.zeros((h, w), dtype=bool)
+    span = 3 * count
+    if side == "top":
+        mask[0:3, start : start + span] = True
+    elif side == "bottom":
+        mask[h - 3 : h, start : start + span] = True
+    elif side == "left":
+        mask[start : start + span, 0:3] = True
+    else:
+        mask[start : start + span, w - 3 : w] = True
+    return mask
+
+
+def _is_isolated(g: np.ndarray, bg: int, mask: np.ndarray) -> bool:
+    """
+    Legend cells should not 4-touch same-colored cells outside the legend mask.
+    This keeps edge sprites from being mistaken for legend entries.
+    """
+    h, w = g.shape
+    for r, c in zip(*np.where(mask), strict=False):
+        r = int(r)
+        c = int(c)
+        v = int(g[r, c])
+        if v == bg:
+            continue
+        for rr, cc in neighbors4(r, c):
+            if 0 <= rr < h and 0 <= cc < w and not mask[rr, cc] and int(g[rr, cc]) == v:
+                return False
+    return True
+
+
+def _scan_side(g: np.ndarray, bg: int, side: str):
+    """Find the best nested-box legend sequence on a given side."""
+    h, w = g.shape
+    if side in ("top", "bottom"):
+        if h < 3:
+            return None
+        axis_len = w
+    else:
+        if w < 3:
+            return None
+        axis_len = h
+
+    best = None
+    for start in range(axis_len - 6 + 1):
+        max_count = (axis_len - start) // 3
+        border_keys: list[int] = []
+        fill_values: list[int] = []
+        for i in range(max_count):
+            offset = start + 3 * i
+            if side == "top":
+                block = g[0:3, offset : offset + 3]
+            elif side == "bottom":
+                block = g[h - 3 : h, offset : offset + 3]
+            elif side == "left":
+                block = g[offset : offset + 3, 0:3]
+            else:
+                block = g[offset : offset + 3, w - 3 : w]
+
+            colors = _nested_box_colors(block, bg)
+            if colors is None:
+                break
+            border, fill = colors
+            if border in border_keys or fill in fill_values:
+                break
+
+            border_keys.append(border)
+            fill_values.append(fill)
+            count = i + 1
+            if count < 2:
+                continue
+
+            mask = _edge_mask(g.shape, side, start, count)
+            if not _is_isolated(g, bg, mask):
+                continue
+
+            score = (count, len(set(border_keys) | set(fill_values)), -start)
+            cand = (score, side, start, count, dict(zip(border_keys, fill_values, strict=False)), mask)
+            if best is None or cand[0] > best[0]:
+                best = cand
+    return best
+
+
+def _palette_mapping(g: np.ndarray, bg: int) -> tuple[dict[int, int], np.ndarray]:
+    """Returns (mapping border->fill, palette_mask)."""
+    best = None
+    for side in ("top", "bottom", "left", "right"):
+        cand = _scan_side(g, bg, side)
+        if cand is not None and (best is None or cand[0] > best[0]):
+            best = cand
+
+    assert best is not None, "nested-box edge palette must be present"
+    _, _side, _start, _count, mapping, mask = best
+    return mapping, mask
+
+
+def _fill_enclosed_bg_regions(
+    out: np.ndarray, bg: int, mapping: dict[int, int], pal_mask: np.ndarray
+) -> None:
+    """
+    Find background regions (excluding the palette area) that do NOT touch the grid boundary,
+    and fill each region based on the most common adjacent border color (mapped via palette).
+    """
+    h, w = out.shape
+    bg_mask = (out == bg) & (~pal_mask)
+    comps = components_mask(bg_mask, connectivity=4)
+    for pts in comps:
+        touches_boundary = any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)
+        if touches_boundary:
+            continue
+
+        adj_counts: dict[int, int] = {}
+        for r, c in pts:
+            for rr, cc in neighbors4(int(r), int(c)):
+                if 0 <= rr < h and 0 <= cc < w:
+                    if pal_mask[rr, cc]:
+                        continue
+                    v = int(out[rr, cc])
+                    if v == bg:
+                        continue
+                    adj_counts[v] = adj_counts.get(v, 0) + 1
+        if not adj_counts:
+            continue
+
+        border = None
+        best = -1
+        for col, cnt in adj_counts.items():
+            if col not in mapping:
+                continue
+            if cnt > best:
+                best = cnt
+                border = col
+        if border is None:
+            continue
+
+        fill = int(mapping[border])
+        for r, c in pts:
+            out[r, c] = fill
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Fill hollow sprites' interiors using an edge legend made of nested-box symbols.
+
+    Input structure:
+    - bg is the dominant outer-border color; several hollow sprites sit away from the boundary.
+    - One grid edge contains a 3-cell-thick legend strip composed of adjacent 3x3 nested boxes:
+      each box has a uniform outer ring color and a different center color.
+
+    Rule:
+    - Locate the edge legend, read each 3x3 box as border-color -> fill-color.
+    - Find enclosed bg regions outside the legend that do not touch the whole-grid boundary.
+    - For each such region, identify its dominant adjacent sprite border color and fill it with the mapped color when available.
+
+    Key insight: Unlike the original strip legend, each legend entry is self-contained; the outer ring encodes the sprite border color and the center cell encodes the target fill color.
+    """
+    g = np.asarray(grid, dtype=int)
+    bg = _bg_boundary(g)
+
+    mapping, pal_mask = _palette_mapping(g, bg)
+    assert mapping, "main: palette mapping must be non-empty"
+
+    out = g.copy()
+    _fill_enclosed_bg_regions(out, bg, mapping, pal_mask)
+    return out
+
+
+# --------------- generator (nested-box edge legend) ---------------
+
+# -- Configuration constants --------------------------------------------------
+_GRID_H_MIN, _GRID_H_MAX = 6, 13
+_GRID_W_MIN, _GRID_W_MAX = 10, 15
+
+_PALETTE_N_MIN, _PALETTE_N_MAX = 2, 4
+
+_SPRITE_H_MAX = 7
+_SPRITE_W_MAX = 6
+_SPRITE_DIM_SUM_CAP = 10
+_SPRITE_CELL_MAX = 16
+_FILLED_SPRITE_MAX = 3
+
+_P_HORIZ_WALL = 0.3
+_P_VERT_WALL = 0.3
+_P_BORDER_REMOVAL = 0.4
+_P_DIAMOND = 0.2
+
+_MAX_RETRIES = 300
+# -- End configuration --------------------------------------------------------
+
+
+def _get_enclosed_holes(sprite: np.ndarray):
+    """Return list of point-arrays for bg components not touching sprite boundary."""
+    h, w = sprite.shape
+    return [
+        pts
+        for pts in components_mask(~sprite, connectivity=4)
+        if not any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)
+    ]
+
+
+def _make_diamond() -> np.ndarray:
+    """Return a 3x3 diamond-shaped boolean mask."""
+    s = np.zeros((3, 3), dtype=bool)
+    s[0, 1] = s[1, 0] = s[1, 2] = s[2, 1] = True
+    return s
+
+
+def _make_hollow_sprite(h: int, w: int, rng: random.Random):
+    """Create a hollow sprite with at least one enclosed bg hole."""
+    sprite = np.ones((h, w), dtype=bool)
+    if h >= 3 and w >= 3:
+        sprite[1:-1, 1:-1] = False
+
+    if h >= 5 and w >= 4 and rng.random() < _P_HORIZ_WALL:
+        br = rng.randint(2, h - 2)
+        n = rng.randint(1, w - 2)
+        s = rng.randint(1, w - n - 1)
+        sprite[br, s : s + n] = True
+
+    if h >= 4 and w >= 5 and rng.random() < _P_VERT_WALL:
+        bc = rng.randint(2, w - 2)
+        n = rng.randint(1, h - 2)
+        s = rng.randint(1, h - n - 1)
+        sprite[s : s + n, bc] = True
+
+    if rng.random() < _P_BORDER_REMOVAL:
+        bcells = [
+            (r, c)
+            for r in range(h)
+            for c in range(w)
+            if sprite[r, c] and (r in (0, h - 1) or c in (0, w - 1))
+        ]
+        rng.shuffle(bcells)
+        for cr, cc in bcells[: rng.randint(1, min(4, len(bcells)))]:
+            test = sprite.copy()
+            test[cr, cc] = False
+            if _get_enclosed_holes(test):
+                sprite = test
+
+    if not _get_enclosed_holes(sprite) or int(sprite.sum()) > _SPRITE_CELL_MAX:
+        return None
+    return sprite
+
+
+def _choose_colors(rng: random.Random, n: int, num_filled: int):
+    """Pick disjoint palette border/fill colors, distractor color, and filled-sprite keys."""
+    all_c = list(range(1, 10))
+    rng.shuffle(all_c)
+    needed = 2 * n + 1
+    chosen = all_c[:needed]
+    border_keys = chosen[:n]
+    fill_values = chosen[n : 2 * n]
+    distractor_color = chosen[2 * n]
+    mapping = dict(zip(border_keys, fill_values, strict=False))
+    filled_keys = rng.sample(border_keys, num_filled)
+    return border_keys, fill_values, distractor_color, mapping, filled_keys
+
+
+def _nested_box_patch(border: int, fill: int) -> np.ndarray:
+    """Return a 3x3 nested-box legend patch."""
+    patch = np.full((3, 3), int(border), dtype=int)
+    patch[1, 1] = int(fill)
+    return patch
+
+
+def _build_palette(side: str, border_keys: list[int], fill_values: list[int]) -> np.ndarray:
+    """Construct a contiguous strip of 3x3 nested-box legend entries."""
+    n = len(border_keys)
+    if side in ("top", "bottom"):
+        pal = np.zeros((3, 3 * n), dtype=int)
+        for i, (border, fill) in enumerate(zip(border_keys, fill_values, strict=False)):
+            pal[:, 3 * i : 3 * (i + 1)] = _nested_box_patch(border, fill)
+    else:
+        pal = np.zeros((3 * n, 3), dtype=int)
+        for i, (border, fill) in enumerate(zip(border_keys, fill_values, strict=False)):
+            pal[3 * i : 3 * (i + 1), :] = _nested_box_patch(border, fill)
+    return pal
+
+
+def _place_palette(grid: np.ndarray, occ: np.ndarray, pal: np.ndarray, side: str, rng: random.Random) -> None:
+    """Place palette on the chosen edge and mark its occupancy with 1-cell inward padding."""
+    h, w = grid.shape
+    pal_h, pal_w = pal.shape
+    if side == "top":
+        pr0, pc0 = 0, rng.randint(0, w - pal_w)
+    elif side == "bottom":
+        pr0, pc0 = h - pal_h, rng.randint(0, w - pal_w)
+    elif side == "left":
+        pr0, pc0 = rng.randint(0, h - pal_h), 0
+    else:
+        pr0, pc0 = rng.randint(0, h - pal_h), w - pal_w
+
+    grid[pr0 : pr0 + pal_h, pc0 : pc0 + pal_w] = pal
+    occ[
+        max(0, pr0 - 1) : min(h, pr0 + pal_h + 1),
+        max(0, pc0 - 1) : min(w, pc0 + pal_w + 1),
+    ] = True
+
+
+def _find_valid_positions(
+    h: int, w: int, occ: np.ndarray, mask: np.ndarray, holes: list[np.ndarray]
+) -> list[tuple[int, int]]:
+    """Find all placements where the sprite fits, stays isolated, and its holes avoid grid boundary."""
+    sh, sw = mask.shape
+    positions = []
+    for r0 in range(h - sh + 1):
+        for c0 in range(w - sw + 1):
+            if occ[max(0, r0 - 1) : min(h, r0 + sh + 1), max(0, c0 - 1) : min(w, c0 + sw + 1)].any():
+                continue
+            if any(
+                r0 + hr == 0 or c0 + hc == 0 or r0 + hr == h - 1 or c0 + hc == w - 1
+                for hpts in holes
+                for hr, hc in hpts
+            ):
+                continue
+            positions.append((r0, c0))
+    return positions
+
+
+def _paint_sprite(
+    grid: np.ndarray, r0: int, c0: int, mask: np.ndarray, color: int, fill: int | None, holes
+) -> None:
+    """Render a sprite onto the grid."""
+    grid[r0 : r0 + mask.shape[0], c0 : c0 + mask.shape[1]][mask] = color
+    if fill is not None:
+        for hpts in holes:
+            for hr, hc in hpts:
+                grid[r0 + hr, c0 + hc] = fill
+
+
+def _feasible_sides(h: int, w: int) -> list[str]:
+    """Legend side choices that can support at least two 3x3 entries and one sprite lane."""
+    sides = []
+    if h >= 7 and w >= 6:
+        sides.extend(["top", "bottom"])
+    if h >= 6 and w >= 7:
+        sides.extend(["left", "right"])
+    return sides
+
+
+def _gen_attempt():
+    rng = random.Random()
+    bg = 0
+
+    h = rng.randint(_GRID_H_MIN, _GRID_H_MAX)
+    w = rng.randint(_GRID_W_MIN, _GRID_W_MAX)
+    sides = _feasible_sides(h, w)
+    if not sides:
+        return None
+    side = rng.choice(sides)
+
+    max_n = min(_PALETTE_N_MAX, (w // 3) if side in ("top", "bottom") else (h // 3))
+    if max_n < _PALETTE_N_MIN:
+        return None
+    n = rng.randint(_PALETTE_N_MIN, max_n)
+
+    max_sh = min(_SPRITE_H_MAX, h)
+    max_sw = min(_SPRITE_W_MAX, w)
+
+    num_filled = rng.randint(1, min(_FILLED_SPRITE_MAX, n))
+    total_sprites = num_filled + 1
+
+    shapes = []
+    for _ in range(total_sprites):
+        sh = rng.randint(3, max_sh)
+        sw = rng.randint(3, max_sw)
+        if sh + sw > _SPRITE_DIM_SUM_CAP:
+            sw = max(3, _SPRITE_DIM_SUM_CAP - sh)
+        if sh == 3 and sw == 3 and rng.random() < _P_DIAMOND:
+            mask = _make_diamond()
+        else:
+            mask = _make_hollow_sprite(sh, sw, rng)
+        if mask is None:
+            return None
+        shapes.append(mask)
+
+    border_keys, fill_values, distractor_color, mapping, filled_keys = _choose_colors(rng, n, num_filled)
+    pal = _build_palette(side, border_keys, fill_values)
+
+    grid = np.full((h, w), bg, dtype=int)
+    occ = np.zeros((h, w), dtype=bool)
+    _place_palette(grid, occ, pal, side, rng)
+
+    infos = []
+    for i, mask in enumerate(shapes):
+        if i < num_filled:
+            c = filled_keys[i]
+            f = mapping[c]
+        else:
+            c, f = distractor_color, None
+        infos.append((mask, c, f))
+
+    placed = []
+    for mask, color, fill in infos:
+        holes = _get_enclosed_holes(mask)
+        positions = _find_valid_positions(h, w, occ, mask, holes)
+        if not positions:
+            return None
+        r0, c0 = rng.choice(positions)
+        _paint_sprite(grid, r0, c0, mask, color, fill, holes)
+        placed.append((r0, c0, mask, fill))
+        sh, sw = mask.shape
+        occ[max(0, r0 - 1) : min(h, r0 + sh + 1), max(0, c0 - 1) : min(w, c0 + sw + 1)] = True
+
+    output = grid.copy()
+    inp = grid.copy()
+    for r0, c0, mask, fill in placed:
+        if fill is None:
+            continue
+        for hpts in _get_enclosed_holes(mask):
+            for hr, hc in hpts:
+                inp[r0 + hr, c0 + hc] = bg
+
+    border = np.concatenate([inp[0], inp[-1], inp[1:-1, 0], inp[1:-1, -1]])
+    vals, cnts = np.unique(border, return_counts=True)
+    if int(vals[cnts.argmax()]) != bg:
+        return None
+
+    try:
+        if np.array_equal(main(inp), output):
+            return inp
+    except Exception:
+        pass
+    return None
+
+
+def generate_input():
+    for _ in range(_MAX_RETRIES):
+        r = _gen_attempt()
+        if r is not None:
+            return r
+    raise RuntimeError(f"Failed to generate input after {_MAX_RETRIES} attempts")

