+
+
+def _find_valid_positions(h: int, w: int, occ: np.ndarray, mask: np.ndarray, holes) -> list[tuple[int, int]]:
+    """Find positions that preserve a bg moat and keep sprites off the outer boundary."""
+    sh, sw = mask.shape
+    positions = []
+    for r0 in range(1, h - sh):
+        for c0 in range(1, w - sw):
+            if occ[max(0, r0 - 1) : min(h, r0 + sh + 1), max(0, c0 - 1) : min(w, c0 + sw + 1)].any():
