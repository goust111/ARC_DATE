+# Variant of dbff022c
+# Dimension: D5 — 变换操作——内部区域的填充方式 (transform)
+# Change: 使用 flood_fill 将精灵内部所有背景色像素填充为调色板查找到的单一颜色... → 仅填充内部边缘——留出中心空白
+
+import random
+
+import numpy as np
+
+from arc_utils import components_mask, neighbors4, neighbors8
+
+
+# Design analysis (YAML-ish, condensed for implementation use)
+# design:
+#   original_mechanism:
+#   - Solver first detects the edge palette, then finds enclosed background components,
+#     then fills every pixel of each mapped hole with one solid color.
+#   D5_variant:
+#   - Keep palette detection and border->fill lookup unchanged.
+#   - Change only the transformation applied to each enclosed hole:
+#     fill the hole's inner rim, not its whole area.
+#   concrete_pixel_behavior:
+#   - For a 5x5 hole inside a sprite, the old task colored all 25 hole pixels.
+#   - The variant colors only the Chebyshev-1 layer adjacent to the sprite border,
+#     leaving the 3x3 center as background.
+#   - On a 3x3 hole, the ring is still visible: 8 rim pixels change, the center stays bg.
+#   complexity_calibration:
+#   - If the generator kept 1-cell holes or 3x3 diamond sprites, the new rule would
+#     visually collapse to the original "fill everything" behavior.
+#   - Therefore generated mapped sprites must have at least one enclosed hole whose
+#     rim is a strict subset of the hole, i.e. the hole has a non-empty core.
+#   implicit_assumption_audit:
+#   - `_best_palette` and `_palette_mapping` rely only on the edge legend and remain valid.
+#   - The old `_fill_enclosed_bg_regions` assumed `for r,c in pts: out[r,c] = fill`;
+#     that exact assumption is no longer valid and is replaced by selective rim painting.
+#   - Dominant-border detection still works because each hole is adjacent to one sprite
+#     border color; the generator keeps sprites separated by background.
+#   placement_legality:
+#   - Sprites and palette keep a 1-cell background moat, and sprites stay off the outer
+#     boundary so the border background color remains dominant and palette detection is stable.
+#   observability:
+#   - Each mapped sprite is a hollow frame with a >=3x3 hole, so input shows a blank hole
+#     while output shows a colored ring around a retained background core.
+#   cleanliness:
+#   - Shapes are simple single-color frames with optional corner cuts only; this avoids
+#     leaking holes to the exterior while still giving some silhouette variety.
+
+
+def _bg_boundary(g: np.ndarray) -> int:
+    """Most common color along the 1-cell outer border."""
+    border = np.concatenate([g[0, :], g[-1, :], g[1:-1, 0], g[1:-1, -1]])
+    vals, cnts = np.unique(border, return_counts=True)
+    return int(vals[cnts.argmax()])
+
+
+def _best_palette(g: np.ndarray, bg: int) -> tuple[str, int, int]:
+    """
+    Find the 2xN or Nx2 palette block on a grid edge.
+
+    Returns (side, start, end) where:
+      - side in {"top","bottom","left","right"}
+      - for top/bottom: start/end are column indices [start,end)
+      - for left/right: start/end are row indices [start,end)
+    """
+    h, w = g.shape
+    best = None
+
+    def isolated(side: str, start: int, end: int) -> bool:
+        """Reject edge regions that blend into same-colored non-palette cells."""
+        pal = np.zeros((h, w), dtype=bool)
+        if side == "top":
+            pal[0:2, start:end] = True
+        elif side == "bottom":
+            pal[h - 2 : h, start:end] = True
+        elif side == "left":
+            pal[start:end, 0:2] = True
+        else:
+            pal[start:end, w - 2 : w] = True
+
+        for r, c in zip(*np.where(pal), strict=False):
+            r = int(r)
+            c = int(c)
+            v = int(g[r, c])
+            if v == bg:
+                continue
+            for rr, cc in neighbors4(r, c):
+                if 0 <= rr < h and 0 <= cc < w and not pal[rr, cc] and int(g[rr, cc]) == v:
+                    return False
+        return True
+
+    def consider_top() -> None:
+        nonlocal best
+        if h < 2:
+            return
+        a = g[0, :]
+        b = g[1, :]
+        for c0 in range(w):
+            for c1 in range(c0 + 2, w + 1):
+                seg_a = a[c0:c1]
+                seg_b = b[c0:c1]
+                da = set(map(int, np.unique(seg_a)))
+                db = set(map(int, np.unique(seg_b)))
+                da.discard(bg)
+                db.discard(bg)
+                if len(da) < 2 or len(db) < 2:
+                    continue
+                d = da | db
+                if len(d) < 3:
+                    continue
+                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]
+                if not border_keys or len(border_keys) != len(set(border_keys)):
+                    continue
+                if not isolated("top", c0, c1):
+                    continue
+                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))
+                cand = ((len(set(border_keys)), len(d), -(c1 - c0), nonbg), "top", c0, c1)
+                if best is None or cand[0] > best[0]:
+                    best = cand
+
+    def consider_bottom() -> None:
+        nonlocal best
+        if h < 2:
+            return
+        a = g[h - 1, :]
+        b = g[h - 2, :]
+        for c0 in range(w):
+            for c1 in range(c0 + 2, w + 1):
+                seg_a = a[c0:c1]
+                seg_b = b[c0:c1]
+                da = set(map(int, np.unique(seg_a)))
+                db = set(map(int, np.unique(seg_b)))
+                da.discard(bg)
+                db.discard(bg)
+                if len(da) < 2 or len(db) < 2:
+                    continue
+                d = da | db
+                if len(d) < 3:
+                    continue
+                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]
+                if not border_keys or len(border_keys) != len(set(border_keys)):
+                    continue
+                if not isolated("bottom", c0, c1):
+                    continue
+                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))
+                cand = ((len(set(border_keys)), len(d), -(c1 - c0), nonbg), "bottom", c0, c1)
+                if best is None or cand[0] > best[0]:
+                    best = cand
+
+    def consider_left() -> None:
+        nonlocal best
+        if w < 2:
+            return
+        a = g[:, 0]
+        b = g[:, 1]
+        for r0 in range(h):
+            for r1 in range(r0 + 2, h + 1):
+                seg_a = a[r0:r1]
+                seg_b = b[r0:r1]
+                da = set(map(int, np.unique(seg_a)))
+                db = set(map(int, np.unique(seg_b)))
+                da.discard(bg)
+                db.discard(bg)
+                if len(da) < 2 or len(db) < 2:
+                    continue
+                d = da | db
+                if len(d) < 3:
+                    continue
+                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]
+                if not border_keys or len(border_keys) != len(set(border_keys)):
+                    continue
+                if not isolated("left", r0, r1):
+                    continue
+                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))
+                cand = ((len(set(border_keys)), len(d), -(r1 - r0), nonbg), "left", r0, r1)
+                if best is None or cand[0] > best[0]:
+                    best = cand
+
+    def consider_right() -> None:
+        nonlocal best
+        if w < 2:
+            return
+        a = g[:, w - 1]
+        b = g[:, w - 2]
+        for r0 in range(h):
+            for r1 in range(r0 + 2, h + 1):
+                seg_a = a[r0:r1]
+                seg_b = b[r0:r1]
+                da = set(map(int, np.unique(seg_a)))
+                db = set(map(int, np.unique(seg_b)))
+                da.discard(bg)
+                db.discard(bg)
+                if len(da) < 2 or len(db) < 2:
+                    continue
+                d = da | db
+                if len(d) < 3:
+                    continue
+                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]
+                if not border_keys or len(border_keys) != len(set(border_keys)):
+                    continue
+                if not isolated("right", r0, r1):
+                    continue
+                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))
+                cand = ((len(set(border_keys)), len(d), -(r1 - r0), nonbg), "right", r0, r1)
+                if best is None or cand[0] > best[0]:
+                    best = cand
+
+    consider_top()
+    consider_bottom()
+    consider_left()
+    consider_right()
+
+    assert best is not None, "_best_palette must find a valid palette region"
+    _, side, start, end = best
+    return side, int(start), int(end)
+
+
+def _palette_mapping(g: np.ndarray, bg: int) -> tuple[dict[int, int], np.ndarray]:
+    """Returns (mapping border->fill, palette_mask)."""
+    h, w = g.shape
+    side, start, end = _best_palette(g, bg)
+    pal_mask = np.zeros((h, w), dtype=bool)
+    mapping: dict[int, int] = {}
+
+    if side == "top":
+        pal_mask[0:2, start:end] = True
+        border_line = g[0, start:end]
+        fill_line = g[1, start:end]
+    elif side == "bottom":
+        pal_mask[h - 2 : h, start:end] = True
+        border_line = g[h - 1, start:end]
+        fill_line = g[h - 2, start:end]
+    elif side == "left":
+        pal_mask[start:end, 0:2] = True
+        border_line = g[start:end, 0]
+        fill_line = g[start:end, 1]
+    else:
+        pal_mask[start:end, w - 2 : w] = True
+        border_line = g[start:end, w - 1]
+        fill_line = g[start:end, w - 2]
+
+    for b, f in zip(border_line.tolist(), fill_line.tolist(), strict=False):
+        b = int(b)
+        f = int(f)
+        if b != bg:
+            mapping[b] = f
+
+    return mapping, pal_mask
+
+
+def _hole_rim(points, source: np.ndarray, bg: int, pal_mask: np.ndarray) -> list[tuple[int, int]]:
+    """Return hole pixels that are Chebyshev-1 adjacent to the enclosing border."""
+    h, w = source.shape
+    hole = {(int(r), int(c)) for r, c in points}
+    rim: list[tuple[int, int]] = []
+    for r, c in hole:
+        for rr, cc in neighbors8(r, c):
+            if not (0 <= rr < h and 0 <= cc < w):
+                continue
+            if (rr, cc) in hole or pal_mask[rr, cc]:
+                continue
+            if int(source[rr, cc]) != bg:
+                rim.append((r, c))
+                break
+    return rim
+
+
+def _dominant_adjacent_border(
+    points, source: np.ndarray, bg: int, mapping: dict[int, int], pal_mask: np.ndarray
+) -> int | None:
+    """Most common 4-neighbor border color around a hole, restricted to palette keys."""
+    h, w = source.shape
+    adj_counts: dict[int, int] = {}
+    for r, c in points:
+        r = int(r)
+        c = int(c)
+        for rr, cc in neighbors4(r, c):
+            if 0 <= rr < h and 0 <= cc < w and not pal_mask[rr, cc]:
+                v = int(source[rr, cc])
+                if v != bg and v in mapping:
+                    adj_counts[v] = adj_counts.get(v, 0) + 1
+    if not adj_counts:
+        return None
+    return max(adj_counts.items(), key=lambda kv: kv[1])[0]
+
+
+def _fill_enclosed_bg_regions(out: np.ndarray, bg: int, mapping: dict[int, int], pal_mask: np.ndarray) -> None:
+    """
+    Find enclosed background holes and color only their inner rim pixels.
+
+    Pixels deeper inside the hole stay as background.
+    """
+    source = out.copy()
+    h, w = source.shape
+    bg_mask = (source == bg) & (~pal_mask)
+    for pts in components_mask(bg_mask, connectivity=4):
+        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):
+            continue
+        border = _dominant_adjacent_border(pts, source, bg, mapping, pal_mask)
+        if border is None:
+            continue
+        fill = int(mapping[border])
+        for r, c in _hole_rim(pts, source, bg, pal_mask):
+            out[int(r), int(c)] = fill
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Paint only the inner edge of hollow sprites using an edge palette legend.
+
+    Input structure:
+    - Background is the dominant border color. Several hollow single-color sprites sit away from the grid edge.
+    - A compact 2×N or N×2 legend lies on one outer edge; its outer line lists sprite border colors and its inner line lists the corresponding paint colors.
+
+    Rule:
+    - Read the edge legend as a border-color to fill-color mapping.
+    - Detect enclosed background holes inside sprites that do not connect to the grid boundary.
+    - For each mapped hole, color only the hole pixels that are immediately inside the border, leaving any deeper central hole pixels as background.
+
+    Key insight: The puzzle is no longer "fill the cavity"; it is "mark the cavity's inner rim," so the solver must separate the hole's boundary layer from its untouched core.
+    """
+    g = np.asarray(grid, dtype=int)
+    bg = _bg_boundary(g)
+
+    mapping, pal_mask = _palette_mapping(g, bg)
+    assert mapping, "main: palette mapping must be non-empty"
+
+    out = g.copy()
+    _fill_enclosed_bg_regions(out, bg, mapping, pal_mask)
+    return out
+
+
+# --------------- generator (variant) ---------------
+
+# Grid dimensions
+_GRID_H_MIN, _GRID_H_MAX = 8, 13
+_GRID_W_MIN, _GRID_W_MAX = 11, 15
+_SMALL_H_THRESHOLD = 9
+_SMALL_H_PALETTE_FLIP = 0.8
+
+# Palette
+_PALETTE_N_MIN, _PALETTE_N_MAX = 2, 4
+
+# Sprite geometry
+_SPRITE_H_MIN, _SPRITE_H_MAX = 5, 7
+_SPRITE_W_MIN, _SPRITE_W_MAX = 5, 6
+_CORNER_CUT_MAX = 2
+_FILLED_SPRITE_MAX = 2
+
+# Generation
+_MAX_RETRIES = 300
+
+
+def _get_enclosed_holes(sprite: np.ndarray):
+    """Return point-arrays for local background components that do not touch the bbox boundary."""
+    h, w = sprite.shape
+    return [
+        pts
+        for pts in components_mask(~sprite, connectivity=4)
+        if not any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)
+    ]
+
+
+def _local_hole_rim(sprite: np.ndarray, points) -> list[tuple[int, int]]:
+    """Chebyshev-1 inner rim for one local hole component."""
+    h, w = sprite.shape
+    hole = {(int(r), int(c)) for r, c in points}
+    rim: list[tuple[int, int]] = []
+    for r, c in hole:
+        for rr, cc in neighbors8(r, c):
+            if 0 <= rr < h and 0 <= cc < w and (rr, cc) not in hole and sprite[rr, cc]:
+                rim.append((r, c))
+                break
+    return rim
+
+
+def _analyze_holes(sprite: np.ndarray) -> list[dict[str, list[tuple[int, int]]]]:
+    """Return local hole pixels together with rim/core splits."""
+    infos = []
+    for pts in _get_enclosed_holes(sprite):
+        cells = [(int(r), int(c)) for r, c in pts]
+        rim = _local_hole_rim(sprite, cells)
+        rim_set = set(rim)
+        core = [p for p in cells if p not in rim_set]
+        infos.append({"cells": cells, "rim": rim, "core": core})
+    return infos
+
+
+def _make_hollow_sprite(h: int, w: int, rng: random.Random) -> np.ndarray | None:
+    """Create a hollow frame whose hole keeps a non-empty core after rim filling."""
+    if h < 5 or w < 5:
+        return None
+
+    sprite = np.ones((h, w), dtype=bool)
+    sprite[1:-1, 1:-1] = False
+
+    corners = [(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)]
+    rng.shuffle(corners)
+    for r, c in corners[: rng.randint(0, _CORNER_CUT_MAX)]:
+        test = sprite.copy()
+        test[r, c] = False
+        infos = _analyze_holes(test)
+        if len(infos) == 1 and infos[0]["core"]:
+            sprite = test
+
+    infos = _analyze_holes(sprite)
+    if len(infos) != 1 or not infos[0]["core"]:
+        return None
+    return sprite
+
+
+def _choose_colors(rng: random.Random, n_pairs: int, num_filled: int):
+    """Pick disjoint border/fill colors plus one distractor border color."""
