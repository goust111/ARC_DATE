def load(path, name):
    spec = importlib.util.spec_from_file_location(name, path)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod

variant = load(variant_path, 'variant')
orig = load(orig_path, 'orig')

deleted_pixels = []
diff_vs_orig = 0
samples = 50
for i in range(samples):
    inp = variant.generate_input()
    out_new = variant.main(inp)
    out_old = orig.main(inp)
    bg = variant._bg_boundary(inp)
    _, pal_mask = variant._palette_mapping(inp, bg)
    deleted = int(np.sum((inp "'!= bg) & (out_new == bg) & (~pal_mask)))
    deleted_pixels.append(deleted)
    if not np.array_equal(out_new, out_old):
        diff_vs_orig += 1

print('"'Samples:', samples)
print('Deleted pixel count min/avg/max:', min(deleted_pixels), round(sum(deleted_pixels)/samples, 2), max(deleted_pixels))
print('Samples with deletion > 0:', sum(d > 0 for d in deleted_pixels))
print('Variant output differs from original solver:', diff_vs_orig)
