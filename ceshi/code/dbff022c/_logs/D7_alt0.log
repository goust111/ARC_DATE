   123	            return
   124	        a = g[:, 0]
   125	        b = g[:, 1]
   126	        for r0 in range(h):
   127	            for r1 in range(r0 + 2, h + 1):
   128	                seg_a = a[r0:r1]
   129	                seg_b = b[r0:r1]
   130	                da = set(map(int, np.unique(seg_a)))
   131	                db = set(map(int, np.unique(seg_b)))
   132	                da.discard(bg)
   133	                db.discard(bg)
   134	                if len(da) < 2 or len(db) < 2:
   135	                    continue
   136	                d = da | db
   137	                if len(d) < 3:
   138	                    continue
   139	                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]
   140	                if len(border_keys) == 0:
   141	                    continue
   142	                if len(border_keys) != len(set(border_keys)):
   143	                    continue
   144	                if not isolated("left", r0, r1):
   145	                    continue
   146	                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))
   147	                score = (len(set(border_keys)), len(d), -(r1 - r0), nonbg)
   148	                cand = (score, "left", r0, r1)
   149	                if best is None or cand[0] > best[0]:
   150	                    best = cand
   151	
   152	    def consider_right():
   153	        nonlocal best
   154	        if w < 2:
   155	            return
   156	        a = g[:, w - 1]
   157	        b = g[:, w - 2]
   158	        for r0 in range(h):
   159	            for r1 in range(r0 + 2, h + 1):
   160	                seg_a = a[r0:r1]
   161	                seg_b = b[r0:r1]
   162	                da = set(map(int, np.unique(seg_a)))
   163	                db = set(map(int, np.unique(seg_b)))
   164	                da.discard(bg)
   165	                db.discard(bg)
   166	                if len(da) < 2 or len(db) < 2:
   167	                    continue
   168	                d = da | db
   169	                if len(d) < 3:
   170	                    continue
   171	                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]
   172	                if len(border_keys) == 0:
   173	                    continue
   174	                if len(border_keys) != len(set(border_keys)):
   175	                    continue
   176	                if not isolated("right", r0, r1):
   177	                    continue
   178	                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))
   179	                score = (len(set(border_keys)), len(d), -(r1 - r0), nonbg)
   180	                cand = (score, "right", r0, r1)
   181	                if best is None or cand[0] > best[0]:
   182	                    best = cand
   183	
   184	    consider_top()
   185	    consider_bottom()
   186	    consider_left()
   187	    consider_right()
   188	
   189	    assert best is not None, "_best_palette must find a valid palette region"
   190	    _, side, start, end = best
   191	    return side, int(start), int(end)
   192	
   193	
   194	def _palette_mapping(g: np.ndarray, bg: int) -> tuple[dict[int, int], np.ndarray]:
   195	    """
   196	    Returns (mapping border->fill, palette_mask).
   197	    """
   198	    h, w = g.shape
   199	    info = _best_palette(g, bg)
   200	    side, start, end = info
   201	    pal_mask = np.zeros((h, w), dtype=bool)
   202	    mapping: dict[int, int] = {}
   203	
   204	    if side == "top":
   205	        pal_mask[0:2, start:end] = True
   206	        border_line = g[0, start:end]
   207	        fill_line = g[1, start:end]
   208	    elif side == "bottom":
   209	        pal_mask[h - 2 : h, start:end] = True
   210	        border_line = g[h - 1, start:end]
   211	        fill_line = g[h - 2, start:end]
   212	    elif side == "left":
   213	        pal_mask[start:end, 0:2] = True
   214	        border_line = g[start:end, 0]
   215	        fill_line = g[start:end, 1]
   216	    else:  # right
   217	        pal_mask[start:end, w - 2 : w] = True
   218	        border_line = g[start:end, w - 1]
   219	        fill_line = g[start:end, w - 2]
   220	
   221	    for b, f in zip(border_line.tolist(), fill_line.tolist(), strict=False):
   222	        b = int(b)
   223	        f = int(f)
   224	        if b == bg:
   225	            continue
   226	        mapping[b] = f
   227	
   228	    return mapping, pal_mask
   229	
   230	
   231	def _fill_enclosed_bg_regions(out: np.ndarray, bg: int, mapping: dict[int, int], pal_mask: np.ndarray) -> None:
   232	    """
   233	    Find background regions (excluding the palette area) that do NOT touch the grid boundary,
   234	    and fill each region based on the most common adjacent border color (mapped via palette).
   235	    """
   236	    h, w = out.shape
   237	    bg_mask = (out == bg) & (~pal_mask)
   238	    comps = components_mask(bg_mask, connectivity=4)
   239	    for pts in comps:
   240	        touches_boundary = any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)
   241	        if touches_boundary:
   242	            continue
   243	
   244	        adj_counts: dict[int, int] = {}
   245	        for r, c in pts:
   246	            for rr, cc in neighbors4(int(r), int(c)):
   247	                if 0 <= rr < h and 0 <= cc < w:
   248	                    if pal_mask[rr, cc]:
   249	                        continue
   250	                    v = int(out[rr, cc])
   251	                    if v == bg:
   252	                        continue
   253	                    adj_counts[v] = adj_counts.get(v, 0) + 1
   254	        if not adj_counts:
   255	            continue
   256	
   257	        # Prefer an adjacent color that exists in the mapping; pick the most frequent border.
   258	        border = None
   259	        best = -1
   260	        for col, cnt in adj_counts.items():
   261	            if col not in mapping:
   262	                continue
   263	            if cnt > best:
   264	                best = cnt
   265	                border = col
   266	        if border is None:
   267	            continue
   268	
   269	        fill = int(mapping[border])
   270	        for r, c in pts:
   271	            out[r, c] = fill
   272	
   273	
   274	def main(grid: np.ndarray) -> np.ndarray:
   275	    """
   276	    Fill hollow sprites' interiors using a color-palette legend on the grid edge.
   277	
   278	    Input structure:
   279	    - bg = most common color. Several hollow sprites with distinct border colors.
   280	    - A small 2×N or N×2 palette block sits on one grid edge; one row/column lists border colors, the other lists corresponding fill colors.
   281	
   282	    Rule:
   283	    - Locate the palette legend on a grid edge and read it as a border→fill color mapping.
   284	    - Find enclosed bg regions (holes) inside sprites that don't touch the grid boundary.
   285	    - For each hole, identify the most common adjacent border color, look it up in the palette, and fill the hole with the mapped fill color.
   286	
   287	    Key insight: The palette's edge position and orientation determine reading direction; border colors in the palette uniquely key into fill colors.
   288	    """
   289	    g = np.asarray(grid, dtype=int)
   290	    bg = _bg_boundary(g)
   291	
   292	    mapping, pal_mask = _palette_mapping(g, bg)
   293	    assert mapping, "main: palette mapping must be non-empty"
   294	
   295	    out = g.copy()
   296	    _fill_enclosed_bg_regions(out, bg, mapping, pal_mask)
   297	
   298	    return out
   299	
   300	# --------------- generator (c) ---------------
   301	
   302	# -- Configuration constants --------------------------------------------------
   303	# Grid dimensions
   304	_GRID_H_MIN, _GRID_H_MAX = 4, 13
   305	_GRID_W_MIN, _GRID_W_MAX = 10, 15
   306	_SMALL_H_THRESHOLD = 6        # below this, prefer left/right palette
   307	_SMALL_H_PALETTE_FLIP = 0.7   # probability of flipping top/bottom -> left/right
   308	_TINY_H_THRESHOLD = 5         # below this, cap sprite height at 3
   309	
   310	# Palette
   311	_PALETTE_N_MIN, _PALETTE_N_MAX = 2, 5
   312	
   313	# Sprite geometry
   314	_SPRITE_H_MAX = 7
   315	_SPRITE_W_MAX = 6
   316	_SPRITE_DIM_SUM_CAP = 10      # if sh + sw exceeds this, clamp sw
   317	_SPRITE_CELL_MAX = 16
   318	_FILLED_SPRITE_MAX = 3
   319	
   320	# Sprite mutation probabilities

