   269	
   270	def _fill_enclosed_bg_regions(out: np.ndarray, bg: int, mapping: dict[int, int], pal_mask: np.ndarray) -> None:
   271	    """
   272	    Find background regions (excluding the palette area) that do NOT touch the grid boundary,
   273	    and fill each region based on the most common adjacent border color (mapped via palette).
   274	    """
   275	    h, w = out.shape
   276	    bg_mask = (out == bg) & (~pal_mask)
   277	    comps = components_mask(bg_mask, connectivity=4)
   278	    for pts in comps:
   279	        touches_boundary = any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)
   280	        if touches_boundary:
   281	            continue
   282	
   283	        adj_counts: dict[int, int] = {}
   284	        for r, c in pts:
   285	            for rr, cc in neighbors4(int(r), int(c)):
   286	                if 0 <= rr < h and 0 <= cc < w:
   287	                    if pal_mask[rr, cc]:
   288	                        continue
   289	                    v = int(out[rr, cc])
   290	                    if v == bg:
   291	                        continue
   292	                    adj_counts[v] = adj_counts.get(v, 0) + 1
   293	        if not adj_counts:
   294	            continue
   295	
   296	        border_col = None
   297	        best = -1
   298	        for col, cnt in adj_counts.items():
   299	            if col not in mapping:
   300	                continue
   301	            if cnt > best:
   302	                best = cnt
   303	                border_col = col
   304	        if border_col is None:
   305	            continue
   306	
   307	        fill = int(mapping[border_col])
   308	        for r, c in pts:
   309	            out[r, c] = fill
   310	
   311	
   312	def _tight_crop_sprites(grid: np.ndarray, pal_mask: np.ndarray, bg: int) -> np.ndarray:
   313	    """Crop to the bbox of all non-bg sprite cells, explicitly excluding the palette."""
   314	    sprite_mask = (grid != bg) & (~pal_mask)
   315	    bb = bbox(sprite_mask)
   316	    assert bb is not None, "_tight_crop_sprites: expected at least one sprite pixel"
   317	    return crop_bbox(grid, bb)
   318	
   319	
   320	def main(grid: np.ndarray) -> np.ndarray:
   321	    """
   322	    Fill hollow sprites using an edge legend, then return only the sprite field.
   323	
   324	    Input structure:
   325	    - bg is the dominant border color of the full canvas.
   326	    - One isolated 2×N or N×2 palette sits on a grid edge; its outer stripe lists sprite-border colors and its inner stripe lists the matching fill colors.
   327	    - Away from that palette sit several hollow sprites, including at least one palette-matching sprite and one distractor whose border color is absent from the palette.
   328	
   329	    Rule:
   330	    - Read the edge palette as a border→fill lookup table.
   331	    - Fill each enclosed bg hole whose surrounding border color appears in that lookup; leave unmapped holes unchanged.
   332	    - After filling, discard the palette and all surrounding empty frame area by tightly cropping to the minimal rectangle containing every sprite.
   333	
   334	    Key insight: The palette still determines which hollow regions get colored, but the final answer is no longer the solved full canvas — it is the tight sprite-only crop inferred from the non-palette foreground extent.
   335	    """
   336	    g = np.asarray(grid, dtype=int)
   337	    bg = _bg_boundary(g)
   338	
   339	    mapping, pal_mask = _palette_mapping(g, bg)
   340	    assert mapping, "main: palette mapping must be non-empty"
   341	
   342	    out = g.copy()
   343	    _fill_enclosed_bg_regions(out, bg, mapping, pal_mask)
   344	    return _tight_crop_sprites(out, pal_mask, bg)
   345	
   346	
   347	# --------------- generator ---------------
   348	
   349	# Grid dimensions
   350	_GRID_H_MIN, _GRID_H_MAX = 7, 13
   351	_GRID_W_MIN, _GRID_W_MAX = 11, 15
   352	_SMALL_H_THRESHOLD = 7
   353	_SMALL_H_PALETTE_FLIP = 0.7
   354	_TINY_H_THRESHOLD = 5
   355	
   356	# Palette
   357	_PALETTE_N_MIN, _PALETTE_N_MAX = 2, 5
   358	
   359	# Sprite geometry
   360	_SPRITE_H_MAX = 7
   361	_SPRITE_W_MAX = 6
   362	_SPRITE_DIM_SUM_CAP = 10
   363	_SPRITE_CELL_MAX = 16
   364	_FILLED_SPRITE_MAX = 3
   365	
   366	# Sprite mutation probabilities
   367	_P_HORIZ_WALL = 0.3
   368	_P_VERT_WALL = 0.3
   369	_P_BORDER_REMOVAL = 0.4
   370	_P_DIAMOND = 0.2
   371	
   372	# Generation
   373	_MAX_RETRIES = 300
   374	
   375	
   376	def _get_enclosed_holes(sprite: np.ndarray) -> list[np.ndarray]:
   377	    """Return point-arrays for bg components not touching the sprite bbox boundary."""
   378	    h, w = sprite.shape
   379	    return [
   380	        pts
   381	        for pts in components_mask(~sprite, connectivity=4)
   382	        if not any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)
   383	    ]
   384	
   385	
   386	def _make_diamond() -> np.ndarray:
   387	    """Return a 3x3 diamond-shaped boolean mask."""
   388	    s = np.zeros((3, 3), dtype=bool)
   389	    s[0, 1] = s[1, 0] = s[1, 2] = s[2, 1] = True
   390	    return s
   391	
   392	
   393	def _make_hollow_sprite(h: int, w: int, rng: random.Random) -> np.ndarray | None:
   394	    """Create a hollow sprite with at least one enclosed hole and bounded cell count."""
   395	    sprite = np.ones((h, w), dtype=bool)
   396	    if h >= 3 and w >= 3:
   397	        sprite[1:-1, 1:-1] = False
   398	
   399	    if h >= 5 and w >= 4 and rng.random() < _P_HORIZ_WALL:
   400	        br = rng.randint(2, h - 2)
   401	        n = rng.randint(1, w - 2)
   402	        s = rng.randint(1, w - n - 1)
   403	        sprite[br, s : s + n] = True
   404	    if h >= 4 and w >= 5 and rng.random() < _P_VERT_WALL:
   405	        bc = rng.randint(2, w - 2)
   406	        n = rng.randint(1, h - 2)
   407	        s = rng.randint(1, h - n - 1)
   408	        sprite[s : s + n, bc] = True
   409	
   410	    if rng.random() < _P_BORDER_REMOVAL:
   411	        bcells = [
   412	            (r, c)
   413	            for r in range(h)
   414	            for c in range(w)
   415	            if sprite[r, c] and (r in (0, h - 1) or c in (0, w - 1))
   416	        ]
   417	        rng.shuffle(bcells)
   418	        for cr, cc in bcells[: rng.randint(1, min(4, len(bcells)))]:
   419	            test = sprite.copy()
   420	            test[cr, cc] = False

