   437	    fill_values = all_c[:n_entries]
   438	    distractor_color = rng.choice([c for c in range(1, 10) if c not in border_keys])
   439	    mapping = dict(zip(border_keys, fill_values))
   440	    filled_keys = rng.sample(border_keys, num_filled)
   441	    return border_keys, fill_values, distractor_color, mapping, filled_keys
   442	
   443	
   444	def _build_palette(side: str, border_keys: list[int], fill_values: list[int]) -> np.ndarray:
   445	    """Construct the 2xN or Nx2 palette for the chosen edge side."""
   446	    n_entries = len(border_keys)
   447	    if side in ("top", "bottom"):
   448	        pal = np.zeros((2, n_entries), dtype=int)
   449	        outer, inner = (0, 1) if side == "top" else (1, 0)
   450	        pal[outer] = border_keys
   451	        pal[inner] = fill_values
   452	    else:
   453	        pal = np.zeros((n_entries, 2), dtype=int)
   454	        outer, inner = (0, 1) if side == "left" else (1, 0)
   455	        pal[:, outer] = border_keys
   456	        pal[:, inner] = fill_values
   457	    return pal
   458	
   459	
   460	def _place_palette(grid: np.ndarray, occ: np.ndarray, pal: np.ndarray, side: str, rng: random.Random) -> np.ndarray:
   461	    """Place the palette on the requested edge and return its exact mask."""
   462	    h, w = grid.shape
   463	    pal_h, pal_w = pal.shape
   464	    if side == "top":
   465	        pr0, pc0 = 0, rng.randint(0, w - pal_w)
   466	    elif side == "bottom":
   467	        pr0, pc0 = h - pal_h, rng.randint(0, w - pal_w)
   468	    elif side == "left":
   469	        pr0, pc0 = rng.randint(0, h - pal_h), 0
   470	    else:
   471	        pr0, pc0 = rng.randint(0, h - pal_h), w - pal_w
   472	
   473	    grid[pr0 : pr0 + pal_h, pc0 : pc0 + pal_w] = pal
   474	    occ[max(0, pr0 - 1) : min(h, pr0 + pal_h + 1), max(0, pc0 - 1) : min(w, pc0 + pal_w + 1)] = True
   475	
   476	    pal_mask = np.zeros((h, w), dtype=bool)
   477	    pal_mask[pr0 : pr0 + pal_h, pc0 : pc0 + pal_w] = True
   478	    return pal_mask
   479	
   480	
   481	def _find_valid_positions(
   482	    h: int, w: int, occ: np.ndarray, mask: np.ndarray, holes: list[np.ndarray]
   483	) -> list[tuple[int, int]]:
   484	    """
   485	    Find all placements where the sprite stays 1 cell inside the full-grid border,
   486	    does not overlap occupied space, and keeps its holes away from the full-grid edge.
   487	    """
   488	    sh, sw = mask.shape
   489	    positions = []
   490	    for r0 in range(h - sh + 1):
   491	        for c0 in range(w - sw + 1):
   492	            if r0 == 0 or c0 == 0 or r0 + sh == h or c0 + sw == w:
   493	                continue
   494	            if occ[max(0, r0 - 1) : min(h, r0 + sh + 1), max(0, c0 - 1) : min(w, c0 + sw + 1)].any():
   495	                continue
   496	            if any(
   497	                r0 + hr == 0 or c0 + hc == 0 or r0 + hr == h - 1 or c0 + hc == w - 1
   498	                for hpts in holes
   499	                for hr, hc in hpts
   500	            ):
   501	                continue
   502	            positions.append((r0, c0))
   503	    return positions
   504	
   505	
   506	def _paint_sprite(
   507	    grid: np.ndarray, r0: int, c0: int, mask: np.ndarray, color: int, fill: int | None, holes: list[np.ndarray]
   508	) -> None:
   509	    """Render a sprite onto the grid: border cells in color, hole cells in fill if provided."""
   510	    grid[r0 : r0 + mask.shape[0], c0 : c0 + mask.shape[1]][mask] = color
   511	    if fill is not None:
   512	        for hpts in holes:
   513	            for hr, hc in hpts:
   514	                grid[r0 + hr, c0 + hc] = fill
   515	
   516	
   517	def _gen_attempt() -> np.ndarray | None:
   518	    rng = random.Random()
   519	    bg = 0
   520	
   521	    h = rng.randint(_GRID_H_MIN, _GRID_H_MAX)
   522	    w = rng.randint(_GRID_W_MIN, _GRID_W_MAX)
   523	    side = rng.choice(["top", "bottom", "left", "right"])
   524	    if h <= _SMALL_H_THRESHOLD and side in ("top", "bottom") and rng.random() < _SMALL_H_PALETTE_FLIP:
   525	        side = rng.choice(["left", "right"])
   526	
   527	    max_n = h if side in ("left", "right") else w
   528	    n_entries = rng.randint(_PALETTE_N_MIN, min(_PALETTE_N_MAX, max_n))
   529	
   530	    max_sh = min(_SPRITE_H_MAX, h - 2)
   531	    max_sw = min(_SPRITE_W_MAX, w - 2)
   532	    if h <= _TINY_H_THRESHOLD:
   533	        max_sh = min(max_sh, 3)
   534	    if max_sh < 3 or max_sw < 3:
   535	        return None
   536	
   537	    num_filled = rng.randint(1, min(_FILLED_SPRITE_MAX, n_entries))
   538	    total_sprites = num_filled + 1
   539	
   540	    shapes = []
   541	    for _ in range(total_sprites):
   542	        sh = rng.randint(3, max_sh)
   543	        sw = rng.randint(3, max_sw)
   544	        if sh + sw > _SPRITE_DIM_SUM_CAP:
   545	            sw = max(3, _SPRITE_DIM_SUM_CAP - sh)
   546	        if sw > max_sw:
   547	            return None
   548	        if sh == 3 and sw == 3 and rng.random() < _P_DIAMOND:
   549	            mask = _make_diamond()
   550	        else:
   551	            mask = _make_hollow_sprite(sh, sw, rng)
   552	        if mask is None:
   553	            return None
   554	        shapes.append(mask)
   555	
   556	    border_keys, fill_values, distractor_color, mapping, filled_keys = _choose_colors(rng, n_entries, num_filled)
   557	    pal = _build_palette(side, border_keys, fill_values)
   558	
   559	    grid = np.full((h, w), bg, dtype=int)
   560	    occ = np.zeros((h, w), dtype=bool)
   561	    pal_mask = _place_palette(grid, occ, pal, side, rng)
   562	
   563	    infos = []
   564	    for i, mask in enumerate(shapes):
   565	        if i < num_filled:
   566	            color = filled_keys[i]
   567	            fill = mapping[color]
   568	        else:
   569	            color = distractor_color
   570	            fill = None
   571	        infos.append((mask, color, fill))
   572	
   573	    placed = []
   574	    for mask, color, fill in infos:
   575	        holes = _get_enclosed_holes(mask)
   576	        positions = _find_valid_positions(h, w, occ, mask, holes)
   577	        if not positions:
   578	            return None
   579	        r0, c0 = rng.choice(positions)
   580	        _paint_sprite(grid, r0, c0, mask, color, fill, holes)
   581	        placed.append((r0, c0, mask, fill))
   582	        sh, sw = mask.shape
   583	        occ[max(0, r0 - 1) : min(h, r0 + sh + 1), max(0, c0 - 1) : min(w, c0 + sw + 1)] = True
   584	
   585	    solved_full = grid.copy()
   586	    inp = grid.copy()
   587	    for r0, c0, mask, fill in placed:
   588	        if fill is None:
   589	            continue
   590	        for hpts in _get_enclosed_holes(mask):
   591	            for hr, hc in hpts:
   592	                inp[r0 + hr, c0 + hc] = bg
   593	
   594	    border = np.concatenate([inp[0], inp[-1], inp[1:-1, 0], inp[1:-1, -1]])
   595	    vals, cnts = np.unique(border, return_counts=True)
   596	    if int(vals[cnts.argmax()]) != bg:
   597	        return None
   598	
   599	    expected = _tight_crop_sprites(solved_full, pal_mask, bg)
   600	    if not (expected.shape[0] < inp.shape[0] and expected.shape[1] < inp.shape[1]):
   601	        return None
   602	
   603	    try:
   604	        if np.array_equal(main(inp), expected):
   605	            return inp
   606	    except Exception:
   607	        pass
   608	    return None
   609	
   610	
   611	def generate_input() -> np.ndarray:
   612	    for _ in range(_MAX_RETRIES):
   613	        inp = _gen_attempt()
   614	        if inp is not None:
   615	            return inp
   616	    raise RuntimeError(f"Failed to generate input after {_MAX_RETRIES} attempts")

