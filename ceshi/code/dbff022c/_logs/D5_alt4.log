   272	def _collect_component_from_seeds(
   273	    g: np.ndarray,
   274	    pal_mask: np.ndarray,
   275	    color: int,
   276	    seeds: list[tuple[int, int]],
   277	) -> set[tuple[int, int]]:
   278	    """Collect the full same-colored 4-connected component reached from the seeds."""
   279	    h, w = g.shape
   280	    stack = [(int(r), int(c)) for r, c in seeds]
   281	    seen: set[tuple[int, int]] = set()
   282	    while stack:
   283	        r, c = stack.pop()
   284	        if (r, c) in seen:
   285	            continue
   286	        if not (0 <= r < h and 0 <= c < w):
   287	            continue
   288	        if pal_mask[r, c] or int(g[r, c]) != int(color):
   289	            continue
   290	        seen.add((r, c))
   291	        for rr, cc in neighbors4(r, c):
   292	            stack.append((int(rr), int(cc)))
   293	    return seen
