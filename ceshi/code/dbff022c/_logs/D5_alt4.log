   352	def main(grid: np.ndarray) -> np.ndarray:
   353	    """
   354	    Swap each hollow sprite's outline color with the palette-selected interior color.
   355	
   356	    Input structure:
   357	    - The boundary-most color is the background, with several hollow single-color sprites placed away from the edge.
   358	    - One 2×N or N×2 legend lies on a grid edge; its outer line lists candidate sprite-border colors and its inner line lists the replacement border colors.
   359	
   360	    Rule:
   361	    - Read the edge legend as original-border -> replacement-border.
   362	    - Find enclosed background holes that do not touch the grid boundary, and infer the surrounding sprite color from the dominant adjacent non-background pixels.
   363	    - If that surrounding color is listed in the legend, recolor the whole enclosing sprite border to the mapped color and fill the hole with the sprite's original border color.
   364	
   365	    Key insight: The legend does not merely say how to paint the cavity; it supplies the color that trades places with the sprite's own outline.
   366	    """
   367	    g = np.asarray(grid, dtype=int)
   368	    bg = _bg_boundary(g)
   369	
   370	    mapping, pal_mask = _palette_mapping(g, bg)
   371	    assert mapping, "main: palette mapping must be non-empty"
   372	
   373	    out = g.copy()
   374	    _swap_enclosed_bg_regions(g, out, bg, mapping, pal_mask)
   375	    return out
