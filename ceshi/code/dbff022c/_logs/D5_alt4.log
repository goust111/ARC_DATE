   238	def _palette_mapping(g: np.ndarray, bg: int) -> tuple[dict[int, int], np.ndarray]:
   239	    """Return (mapping original_border->new_border, palette_mask)."""
   240	    h, w = g.shape
   241	    side, start, end = _best_palette(g, bg)
   242	    pal_mask = np.zeros((h, w), dtype=bool)
   243	    mapping: dict[int, int] = {}
   244	
   245	    if side == "top":
   246	        pal_mask[0:2, start:end] = True
   247	        border_line = g[0, start:end]
   248	        fill_line = g[1, start:end]
   249	    elif side == "bottom":
   250	        pal_mask[h - 2 : h, start:end] = True
   251	        border_line = g[h - 1, start:end]
   252	        fill_line = g[h - 2, start:end]
   253	    elif side == "left":
   254	        pal_mask[start:end, 0:2] = True
   255	        border_line = g[start:end, 0]
   256	        fill_line = g[start:end, 1]
   257	    else:
   258	        pal_mask[start:end, w - 2 : w] = True
   259	        border_line = g[start:end, w - 1]
   260	        fill_line = g[start:end, w - 2]
   261	
   262	    for b, f in zip(border_line.tolist(), fill_line.tolist(), strict=False):
   263	        b = int(b)
   264	        f = int(f)
   265	        if b == bg:
   266	            continue
   267	        mapping[b] = f
   268	
   269	    return mapping, pal_mask
