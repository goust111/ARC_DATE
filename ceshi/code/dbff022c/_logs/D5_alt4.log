   469	def _build_palette(side: str, border_keys: list[int], fill_values: list[int]) -> np.ndarray:
   470	    """Construct the 2xN or Nx2 palette array for the given edge side."""
   471	    n = len(border_keys)
   472	    if side in ("top", "bottom"):
   473	        pal = np.zeros((2, n), dtype=int)
   474	        outer, inner = (0, 1) if side == "top" else (1, 0)
   475	        pal[outer] = border_keys
   476	        pal[inner] = fill_values
   477	    else:
   478	        pal = np.zeros((n, 2), dtype=int)
   479	        outer, inner = (0, 1) if side == "left" else (1, 0)
   480	        pal[:, outer] = border_keys
   481	        pal[:, inner] = fill_values
   482	    return pal
