   309	    for pts in comps:
   310	        touches_boundary = any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)
   311	        if touches_boundary:
   312	            continue
   313	
   314	        adj_counts: dict[int, int] = {}
   315	        seeds_by_color: dict[int, set[tuple[int, int]]] = {}
   316	        for r, c in pts:
   317	            for rr, cc in neighbors4(int(r), int(c)):
   318	                if not (0 <= rr < h and 0 <= cc < w):
   319	                    continue
   320	                if pal_mask[rr, cc]:
   321	                    continue
   322	                v = int(inp[rr, cc])
   323	                if v == bg:
   324	                    continue
   325	                adj_counts[v] = adj_counts.get(v, 0) + 1
   326	                seeds_by_color.setdefault(v, set()).add((int(rr), int(cc)))
   327	
   328	        border = None
   329	        best = -1
   330	        for col, cnt in adj_counts.items():
   331	            if col not in mapping:
   332	                continue
   333	            if cnt > best:
   334	                best = cnt
   335	                border = int(col)
   336	        if border is None:
