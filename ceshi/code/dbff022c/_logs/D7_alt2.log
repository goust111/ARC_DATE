    47	def _bg_boundary(g: np.ndarray) -> int:
    48	    """Most common color along the 1-cell outer border."""
    49	    border = np.concatenate([g[0, :], g[-1, :], g[1:-1, 0], g[1:-1, -1]])
    50	    vals, cnts = np.unique(border, return_counts=True)
    51	    return int(vals[cnts.argmax()])
    52	
