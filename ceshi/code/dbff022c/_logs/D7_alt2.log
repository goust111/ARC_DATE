    54	def _best_palette(g: np.ndarray, bg: int) -> tuple[str, int, int]:
    55	    """
    56	    Find the 2xN or Nx2 palette block on a grid edge.
    57	
    58	    Returns (side, start, end) where:
    59	      - side in {"top","bottom","left","right"}
    60	      - for top/bottom: start/end are column indices [start,end)
    61	      - for left/right: start/end are row indices [start,end)
    62	    """
    63	    h, w = g.shape
    64	    best = None  # (score_tuple, side, start, end)
    65	
    66	    def isolated(side: str, start: int, end: int) -> bool:
    67	        """
    68	        Palette cells (excluding bg) should not be 4-neigh adjacent to same-colored cells
    69	        outside the palette region; this prevents accidentally absorbing parts of large sprites
    70	        that touch the grid edge.
    71	        """
    72	        h2, w2 = g.shape
    73	        pal = np.zeros((h2, w2), dtype=bool)
    74	        if side == "top":
    75	            pal[0:2, start:end] = True
    76	        elif side == "bottom":
    77	            pal[h2 - 2 : h2, start:end] = True
    78	        elif side == "left":
    79	            pal[start:end, 0:2] = True
    80	        else:
    81	            pal[start:end, w2 - 2 : w2] = True
    82	
    83	        for r, c in zip(*np.where(pal), strict=False):
    84	            r = int(r)
    85	            c = int(c)
    86	            v = int(g[r, c])
    87	            if v == bg:
    88	                continue
    89	            for rr, cc in neighbors4(r, c):
    90	                if 0 <= rr < h2 and 0 <= cc < w2 and not pal[rr, cc]:
    91	                    if int(g[rr, cc]) == v:
    92	                        return False
    93	        return True
    94	
    95	    def consider_top():
    96	        nonlocal best
    97	        if h < 2:
    98	            return
    99	        a = g[0, :]
   100	        b = g[1, :]
   101	        for c0 in range(w):
   102	            for c1 in range(c0 + 2, w + 1):
   103	                seg_a = a[c0:c1]
   104	                seg_b = b[c0:c1]
   105	                da = set(map(int, np.unique(seg_a)))
   106	                db = set(map(int, np.unique(seg_b)))
   107	                da.discard(bg)
   108	                db.discard(bg)
   109	                if len(da) < 2 or len(db) < 2:
   110	                    continue
   111	                d = da | db
   112	                if len(d) < 3:
   113	                    continue
   114	                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]
   115	                if len(border_keys) == 0:
   116	                    continue
   117	                if len(border_keys) != len(set(border_keys)):
   118	                    continue
   119	                if not isolated("top", c0, c1):
   120	                    continue
   121	                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))
   122	                score = (len(set(border_keys)), len(d), -(c1 - c0), nonbg)
   123	                cand = (score, "top", c0, c1)
   124	                if best is None or cand[0] > best[0]:
   125	                    best = cand
   126	
   127	    def consider_bottom():
   128	        nonlocal best
   129	        if h < 2:
   130	            return
   131	        a = g[h - 1, :]
   132	        b = g[h - 2, :]
   133	        for c0 in range(w):
   134	            for c1 in range(c0 + 2, w + 1):
   135	                seg_a = a[c0:c1]
   136	                seg_b = b[c0:c1]
   137	                da = set(map(int, np.unique(seg_a)))
   138	                db = set(map(int, np.unique(seg_b)))
   139	                da.discard(bg)
   140	                db.discard(bg)
   141	                if len(da) < 2 or len(db) < 2:
   142	                    continue
   143	                d = da | db
   144	                if len(d) < 3:
   145	                    continue
   146	                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]
   147	                if len(border_keys) == 0:
   148	                    continue
   149	                if len(border_keys) != len(set(border_keys)):
   150	                    continue
   151	                if not isolated("bottom", c0, c1):
   152	                    continue
   153	                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))
   154	                score = (len(set(border_keys)), len(d), -(c1 - c0), nonbg)
   155	                cand = (score, "bottom", c0, c1)
   156	                if best is None or cand[0] > best[0]:
   157	                    best = cand
   158	
   159	    def consider_left():
   160	        nonlocal best
   161	        if w < 2:
   162	            return
   163	        a = g[:, 0]
   164	        b = g[:, 1]
   165	        for r0 in range(h):
   166	            for r1 in range(r0 + 2, h + 1):
   167	                seg_a = a[r0:r1]
   168	                seg_b = b[r0:r1]
   169	                da = set(map(int, np.unique(seg_a)))
   170	                db = set(map(int, np.unique(seg_b)))
   171	                da.discard(bg)
   172	                db.discard(bg)
   173	                if len(da) < 2 or len(db) < 2:
   174	                    continue
   175	                d = da | db
   176	                if len(d) < 3:
   177	                    continue
   178	                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]
   179	                if len(border_keys) == 0:
   180	                    continue
   181	                if len(border_keys) != len(set(border_keys)):
   182	                    continue
   183	                if not isolated("left", r0, r1):
   184	                    continue
   185	                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))
   186	                score = (len(set(border_keys)), len(d), -(r1 - r0), nonbg)
   187	                cand = (score, "left", r0, r1)
   188	                if best is None or cand[0] > best[0]:
   189	                    best = cand
   190	
   191	    def consider_right():
   192	        nonlocal best
   193	        if w < 2:
   194	            return
   195	        a = g[:, w - 1]
   196	        b = g[:, w - 2]
   197	        for r0 in range(h):
   198	            for r1 in range(r0 + 2, h + 1):
   199	                seg_a = a[r0:r1]
   200	                seg_b = b[r0:r1]
   201	                da = set(map(int, np.unique(seg_a)))
   202	                db = set(map(int, np.unique(seg_b)))
   203	                da.discard(bg)
   204	                db.discard(bg)
   205	                if len(da) < 2 or len(db) < 2:
   206	                    continue
   207	                d = da | db
   208	                if len(d) < 3:
   209	                    continue
   210	                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]
   211	                if len(border_keys) == 0:
   212	                    continue
   213	                if len(border_keys) != len(set(border_keys)):
   214	                    continue
   215	                if not isolated("right", r0, r1):
   216	                    continue
   217	                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))
   218	                score = (len(set(border_keys)), len(d), -(r1 - r0), nonbg)
   219	                cand = (score, "right", r0, r1)
   220	                if best is None or cand[0] > best[0]:
   221	                    best = cand
   222	
   223	    consider_top()
   224	    consider_bottom()
   225	    consider_left()
   226	    consider_right()
   227	
   228	    assert best is not None, "_best_palette must find a valid palette region"
   229	    _, side, start, end = best
   230	    return side, int(start), int(end)
   231	
   232	
   233	def _palette_mapping(g: np.ndarray, bg: int) -> tuple[dict[int, int], np.ndarray]:
   234	    """
   235	    Returns (mapping border->fill, palette_mask).
   236	    """
   237	    h, w = g.shape
   238	    side, start, end = _best_palette(g, bg)
   239	    pal_mask = np.zeros((h, w), dtype=bool)
   240	    mapping: dict[int, int] = {}
   241	
   242	    if side == "top":
   243	        pal_mask[0:2, start:end] = True
   244	        border_line = g[0, start:end]
   245	        fill_line = g[1, start:end]
   246	    elif side == "bottom":
   247	        pal_mask[h - 2 : h, start:end] = True
   248	        border_line = g[h - 1, start:end]
   249	        fill_line = g[h - 2, start:end]
   250	    elif side == "left":
   251	        pal_mask[start:end, 0:2] = True
   252	        border_line = g[start:end, 0]
   253	        fill_line = g[start:end, 1]
   254	    else:
   255	        pal_mask[start:end, w - 2 : w] = True
   256	        border_line = g[start:end, w - 1]
   257	        fill_line = g[start:end, w - 2]
   258	
   259	    for b, f in zip(border_line.tolist(), fill_line.tolist(), strict=False):
   260	        b = int(b)

