   380	def _make_hollow_sprite(h: int, w: int, rng: random.Random) -> np.ndarray | None:
   381	    """Create a hollow sprite with at least one enclosed hole and bounded size."""
   382	    sprite = np.ones((h, w), dtype=bool)
