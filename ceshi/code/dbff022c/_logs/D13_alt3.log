+            pal[h2 - 2 : h2, start:end] = True
+        elif side == "left":
+            pal[start:end, 0:2] = True
+        else:
+            pal[start:end, w2 - 2 : w2] = True
+
+        for r, c in zip(*np.where(pal), strict=False):
+            r = int(r)
+            c = int(c)
+            v = int(g[r, c])
+            if v == bg:
+                continue
+            for rr, cc in neighbors4(r, c):
+                if 0 <= rr < h2 and 0 <= cc < w2 and not pal[rr, cc]:
+                    if int(g[rr, cc]) == v:
+                        return False
+        return True
+
+    def consider_top():
+        nonlocal best
+        if h < 2:
+            return
+        a = g[0, :]
+        b = g[1, :]
+        for c0 in range(w):
+            for c1 in range(c0 + 2, w + 1):
+                seg_a = a[c0:c1]
+                seg_b = b[c0:c1]
+                da = set(map(int, np.unique(seg_a)))
+                db = set(map(int, np.unique(seg_b)))
+                da.discard(bg)
+                db.discard(bg)
+                if len(da) < 2 or len(db) < 2:
+                    continue
+                d = da | db
+                if len(d) < 3:
+                    continue
+                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]
+                if not border_keys or len(border_keys) != len(set(border_keys)):
+                    continue
+                if not isolated("top", c0, c1):
+                    continue
+                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))
+                score = (len(set(border_keys)), len(d), -(c1 - c0), nonbg)
+                cand = (score, "top", c0, c1)
+                if best is None or cand[0] > best[0]:
+                    best = cand
+
+    def consider_bottom():
+        nonlocal best
+        if h < 2:
+            return
+        a = g[h - 1, :]
+        b = g[h - 2, :]
+        for c0 in range(w):
+            for c1 in range(c0 + 2, w + 1):
+                seg_a = a[c0:c1]
+                seg_b = b[c0:c1]
+                da = set(map(int, np.unique(seg_a)))
+                db = set(map(int, np.unique(seg_b)))
+                da.discard(bg)
+                db.discard(bg)
+                if len(da) < 2 or len(db) < 2:
+                    continue
+                d = da | db
+                if len(d) < 3:
+                    continue
+                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]
+                if not border_keys or len(border_keys) != len(set(border_keys)):
+                    continue
+                if not isolated("bottom", c0, c1):
+                    continue
+                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))
+                score = (len(set(border_keys)), len(d), -(c1 - c0), nonbg)
+                cand = (score, "bottom", c0, c1)
+                if best is None or cand[0] > best[0]:
+                    best = cand
+
+    def consider_left():
+        nonlocal best
+        if w < 2:
+            return
+        a = g[:, 0]
+        b = g[:, 1]
+        for r0 in range(h):
+            for r1 in range(r0 + 2, h + 1):
+                seg_a = a[r0:r1]
+                seg_b = b[r0:r1]
+                da = set(map(int, np.unique(seg_a)))
+                db = set(map(int, np.unique(seg_b)))
+                da.discard(bg)
+                db.discard(bg)
+                if len(da) < 2 or len(db) < 2:
+                    continue
+                d = da | db
+                if len(d) < 3:
+                    continue
+                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]
+                if not border_keys or len(border_keys) != len(set(border_keys)):
+                    continue
+                if not isolated("left", r0, r1):
+                    continue
+                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))
+                score = (len(set(border_keys)), len(d), -(r1 - r0), nonbg)
+                cand = (score, "left", r0, r1)
+                if best is None or cand[0] > best[0]:
+                    best = cand
+
+    def consider_right():
+        nonlocal best
+        if w < 2:
+            return
+        a = g[:, w - 1]
+        b = g[:, w - 2]
+        for r0 in range(h):
+            for r1 in range(r0 + 2, h + 1):
+                seg_a = a[r0:r1]
+                seg_b = b[r0:r1]
+                da = set(map(int, np.unique(seg_a)))
+                db = set(map(int, np.unique(seg_b)))
+                da.discard(bg)
+                db.discard(bg)
+                if len(da) < 2 or len(db) < 2:
+                    continue
+                d = da | db
+                if len(d) < 3:
+                    continue
+                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]
+                if not border_keys or len(border_keys) != len(set(border_keys)):
+                    continue
+                if not isolated("right", r0, r1):
+                    continue
+                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))
+                score = (len(set(border_keys)), len(d), -(r1 - r0), nonbg)
+                cand = (score, "right", r0, r1)
+                if best is None or cand[0] > best[0]:
+                    best = cand
+
+    consider_top()
+    consider_bottom()
+    consider_left()
+    consider_right()
+
+    assert best is not None, "_best_palette must find a valid palette region"
+    _, side, start, end = best
+    return side, int(start), int(end)
+
+
+def _palette_data(g: np.ndarray, bg: int) -> tuple[dict[int, int], dict[int, int], np.ndarray, str]:
+    """
+    Returns (forward_mapping outer->inner, reverse_mapping inner->outer, palette_mask, side).
+    """
+    h, w = g.shape
+    side, start, end = _best_palette(g, bg)
+    pal_mask = np.zeros((h, w), dtype=bool)
+
+    if side == "top":
+        pal_mask[0:2, start:end] = True
+        border_line = g[0, start:end]
+        fill_line = g[1, start:end]
+    elif side == "bottom":
+        pal_mask[h - 2 : h, start:end] = True
+        border_line = g[h - 1, start:end]
+        fill_line = g[h - 2, start:end]
+    elif side == "left":
+        pal_mask[start:end, 0:2] = True
+        border_line = g[start:end, 0]
+        fill_line = g[start:end, 1]
+    else:  # right
+        pal_mask[start:end, w - 2 : w] = True
+        border_line = g[start:end, w - 1]
+        fill_line = g[start:end, w - 2]
+
+    forward: dict[int, int] = {}
+    reverse: dict[int, int] = {}
+    for b, f in zip(border_line.tolist(), fill_line.tolist(), strict=False):
+        b = int(b)
+        f = int(f)
+        if b == bg or f == bg:
+            continue
+        forward[b] = f
+        reverse[f] = b
+
+    return forward, reverse, pal_mask, side
+
+
+def _region_is_same_side(pts: np.ndarray, side: str, h: int, w: int) -> bool:
+    """Classify a hole by the side of the grid midpoint that contains its centroid."""
+    r_mean = float(np.mean(pts[:, 0]))
+    c_mean = float(np.mean(pts[:, 1]))
+    if side == "top":
+        return r_mean < (h - 1) / 2.0
+    if side == "bottom":
+        return r_mean > (h - 1) / 2.0
+    if side == "left":
+        return c_mean < (w - 1) / 2.0
+    return c_mean > (w - 1) / 2.0
+
+
+def _fill_enclosed_bg_regions(
+    out: np.ndarray,
+    bg: int,
+    forward: dict[int, int],
+    reverse: dict[int, int],
+    pal_mask: np.ndarray,
+    pal_side: str,
+) -> None:
+    """
+    Fill enclosed bg holes using forward lookup on the palette side and reverse lookup on
+    the opposite side.
+    """
+    h, w = out.shape
+    bg_mask = (out == bg) & (~pal_mask)
+    comps = components_mask(bg_mask, connectivity=4)
+    for pts in comps:
+        touches_boundary = any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)
+        if touches_boundary:
+            continue
+
+        mapping = forward if _region_is_same_side(pts, pal_side, h, w) else reverse
+        adj_counts: dict[int, int] = {}
+        for r, c in pts:
+            for rr, cc in neighbors4(int(r), int(c)):
+                if 0 <= rr < h and 0 <= cc < w:
+                    if pal_mask[rr, cc]:
+                        continue
+                    v = int(out[rr, cc])
+                    if v == bg:
+                        continue
+                    adj_counts[v] = adj_counts.get(v, 0) + 1
+        if not adj_counts:
+            continue
+
+        border = None
+        best = -1
+        for col, cnt in adj_counts.items():
+            if col not in mapping:
+                continue
+            if cnt > best:
+                best = cnt
+                border = col
+        if border is None:
+            continue
+
+        fill = int(mapping[border])
+        for r, c in pts:
+            out[r, c] = fill
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Fill hollow sprites using an edge palette, with lookup direction controlled by position.
+
+    Input structure:
+    - The background is the dominant border color, and several hollow sprites sit away from
+      the palette and from each other.
+    - A 2xN or Nx2 palette lies on one grid edge; its outer line and inner line form paired
+      color correspondences.
+    - Some sprites lie on the same half of the grid as the palette edge, while others lie on
+      the opposite half.
+
+    Rule:
+    - Detect the palette and read both directions of the pairing: outer->inner and inner->outer.
+    - Find enclosed background holes that do not touch the outer grid boundary.
+    - For each hole, determine whether it is on the palette side of the grid midpoint or on
+      the far side.
+    - Use the forward palette direction for same-side holes and the reverse direction for
+      opposite-side holes, then fill using the dominant adjacent border color.
+
+    Key insight: The correct fill color is determined jointly by the palette pairings and the
+    hole's spatial relation to the palette edge, because opposite-side sprites read the same
+    palette backwards.
+    """
+    g = np.asarray(grid, dtype=int)
+    bg = _bg_boundary(g)
+
+    forward, reverse, pal_mask, pal_side = _palette_data(g, bg)
+    assert forward and reverse, "main: palette mappings must be non-empty"
+
+    out = g.copy()
+    _fill_enclosed_bg_regions(out, bg, forward, reverse, pal_mask, pal_side)
+    return out
+
+
+# --------------- generator (c) ---------------
+
+# Grid dimensions
+_GRID_H_MIN, _GRID_H_MAX = 6, 13
+_GRID_W_MIN, _GRID_W_MAX = 11, 15
+_TOP_BOTTOM_MIN_H = 11
+
+# Palette
+_PALETTE_N_MIN, _PALETTE_N_MAX = 2, 4
+
+# Sprite geometry
+_SPRITE_H_MAX = 7
+_SPRITE_W_MAX = 6
+_SPRITE_DIM_SUM_CAP = 10
+_SPRITE_CELL_MAX = 16
+
+# Sprite mutation probabilities
+_P_HORIZ_WALL = 0.3
+_P_VERT_WALL = 0.3
+_P_BORDER_REMOVAL = 0.4
+_P_DIAMOND = 0.2
+
+# Generation
+_MAX_RETRIES = 300
+
+
+def _get_enclosed_holes(sprite: np.ndarray) -> list[np.ndarray]:
+    """Return list of point-arrays for bg components not touching sprite boundary."""
+    h, w = sprite.shape
+    return [
+        pts
+        for pts in components_mask(~sprite, connectivity=4)
+        if not any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)
+    ]
+
+
+def _make_diamond() -> np.ndarray:
+    """Return a 3x3 diamond-shaped boolean mask."""
+    s = np.zeros((3, 3), dtype=bool)
+    s[0, 1] = s[1, 0] = s[1, 2] = s[2, 1] = True
+    return s
+
+
+def _make_hollow_sprite(h: int, w: int, rng: random.Random) -> np.ndarray | None:
+    """Create hollow sprite with at least one enclosed bg hole and limited cell count."""
+    sprite = np.ones((h, w), dtype=bool)
+    if h >= 3 and w >= 3:
+        sprite[1:-1, 1:-1] = False
+    if h >= 5 and w >= 4 and rng.random() < _P_HORIZ_WALL:
+        br = rng.randint(2, h - 2)
+        n = rng.randint(1, w - 2)
+        s = rng.randint(1, w - n - 1)
+        sprite[br, s : s + n] = True
+    if h >= 4 and w >= 5 and rng.random() < _P_VERT_WALL:
+        bc = rng.randint(2, w - 2)
+        n = rng.randint(1, h - 2)
+        s = rng.randint(1, h - n - 1)
+        sprite[s : s + n, bc] = True
+    if rng.random() < _P_BORDER_REMOVAL:
+        bcells = [
+            (r, c)
+            for r in range(h)
+            for c in range(w)
+            if sprite[r, c] and (r in (0, h - 1) or c in (0, w - 1))
+        ]
+        rng.shuffle(bcells)
+        for cr, cc in bcells[: rng.randint(1, min(4, len(bcells)))]:
+            test = sprite.copy()
+            test[cr, cc] = False
+            if _get_enclosed_holes(test):
+                sprite = test
+    if not _get_enclosed_holes(sprite) or int(sprite.sum()) > _SPRITE_CELL_MAX:
+        return None
+    return sprite
+
+
+def _choose_colors(
+    rng: random.Random,
+    n_pairs: int,
+) -> tuple[list[int], list[int], int, dict[int, int], dict[int, int], int, int]:
+    """Pick disjoint palette domains plus one forward key and one reverse key."""
+    all_c = list(range(1, 10))
+    rng.shuffle(all_c)
+    border_keys = all_c[:n_pairs]
+    fill_values = all_c[n_pairs : 2 * n_pairs]
+    distractor_color = all_c[2 * n_pairs]
+    forward = dict(zip(border_keys, fill_values))
+    reverse = dict(zip(fill_values, border_keys))
+    same_key = rng.choice(border_keys)
+    opposite_key = rng.choice(fill_values)
+    return border_keys, fill_values, distractor_color, forward, reverse, same_key, opposite_key
+
+
+def _build_palette(side: str, border_keys: list[int], fill_values: list[int]) -> np.ndarray:
+    """Construct the 2xN or Nx2 palette array for the given edge side."""
+    n = len(border_keys)
+    if side in ("top", "bottom"):
+        pal = np.zeros((2, n), dtype=int)
+        outer, inner = (0, 1) if side == "top" else (1, 0)
+        pal[outer] = border_keys
+        pal[inner] = fill_values
+    else:
+        pal = np.zeros((n, 2), dtype=int)
+        outer, inner = (0, 1) if side == "left" else (1, 0)
+        pal[:, outer] = border_keys
+        pal[:, inner] = fill_values
+    return pal
+
+
+def _place_palette(
+    grid: np.ndarray,
+    occ: np.ndarray,
+    pal: np.ndarray,
+    side: str,
+    rng: random.Random,
+) -> None:
+    """Place palette on the chosen edge and mark its occupancy (with 1-cell padding)."""
+    h, w = grid.shape
+    pal_h, pal_w = pal.shape
+    if side == "top":
+        pr0, pc0 = 0, rng.randint(0, w - pal_w)
+    elif side == "bottom":
+        pr0, pc0 = h - pal_h, rng.randint(0, w - pal_w)
+    elif side == "left":
+        pr0, pc0 = rng.randint(0, h - pal_h), 0
+    else:
+        pr0, pc0 = rng.randint(0, h - pal_h), w - pal_w
+    grid[pr0 : pr0 + pal_h, pc0 : pc0 + pal_w] = pal
+    occ[max(0, pr0 - 1) : min(h, pr0 + pal_h + 1), max(0, pc0 - 1) : min(w, pc0 + pal_w + 1)] = True
+
+
+def _matches_relation(pts: np.ndarray, side: str, relation: str, h: int, w: int) -> bool:
+    same_side = _region_is_same_side(pts, side, h, w)
+    if relation == "same":
+        return same_side
+    if relation == "opposite":
+        return not same_side
+    return True
+
+
+def _find_valid_positions(
+    h: int,
+    w: int,
+    occ: np.ndarray,
+    mask: np.ndarray,
+    holes: list[np.ndarray],
+    side: str | None = None,
+    relation: str | None = None,
+) -> list[tuple[int, int]]:
+    """Find placements that fit, stay isolated, and optionally satisfy the side rule."""
+    sh, sw = mask.shape
+    positions = []
+    for r0 in range(h - sh + 1):
+        for c0 in range(w - sw + 1):
+            if occ[max(0, r0 - 1) : min(h, r0 + sh + 1), max(0, c0 - 1) : min(w, c0 + sw + 1)].any():
+                continue
+            if any(
+                r0 + hr == 0 or c0 + hc == 0 or r0 + hr == h - 1 or c0 + hc == w - 1
+                for hpts in holes
+                for hr, hc in hpts
+            ):
+                continue
+            if relation is not None:
+                ok = True
+                for hpts in holes:
+                    shifted = hpts + np.array([r0, c0])
+                    if not _matches_relation(shifted, side, relation, h, w):
+                        ok = False
+                        break
+                if not ok:
+                    continue
+            positions.append((r0, c0))
+    return positions
+
+
+def _paint_sprite(
+    grid: np.ndarray,
+    r0: int,
+    c0: int,
+    mask: np.ndarray,
+    color: int,
+    fill: int | None,
+    holes: list[np.ndarray],
+) -> None:
+    """Render a sprite onto the grid."""
+    grid[r0 : r0 + mask.shape[0], c0 : c0 + mask.shape[1]][mask] = color
+    if fill is not None:
+        for hpts in holes:
+            for hr, hc in hpts:
+                grid[r0 + hr, c0 + hc] = fill
+
+
+def _choose_side(h: int, rng: random.Random) -> str:
+    """Top/bottom are only used when the grid is tall enough to show both halves clearly."""
+    sides = ["left", "right"]
+    if h >= _TOP_BOTTOM_MIN_H:
+        sides.extend(["top", "bottom"])
+    return rng.choice(sides)
+
+
+def _gen_attempt() -> np.ndarray | None:
+    rng = random.Random()
+    bg = 0
+
+    h = rng.randint(_GRID_H_MIN, _GRID_H_MAX)
+    w = rng.randint(_GRID_W_MIN, _GRID_W_MAX)
+    side = _choose_side(h, rng)
+    n_pairs = rng.randint(_PALETTE_N_MIN, _PALETTE_N_MAX)
+
+    max_sh = min(_SPRITE_H_MAX, h)
+    max_sw = min(_SPRITE_W_MAX, w)
+    if side in ("top", "bottom"):
+        max_sh = min(max_sh, 4)
+    else:
+        max_sw = min(max_sw, 4)
+
+    shapes = []
+    for _ in range(3):
+        sh = rng.randint(3, max_sh)
+        sw = rng.randint(3, max_sw)
+        if sh + sw > _SPRITE_DIM_SUM_CAP:
+            sw = max(3, _SPRITE_DIM_SUM_CAP - sh)
+        if sh == 3 and sw == 3 and rng.random() < _P_DIAMOND:
+            mask = _make_diamond()
+        else:
+            mask = _make_hollow_sprite(sh, sw, rng)
+        if mask is None:
+            return None
+        shapes.append(mask)
+
+    border_keys, fill_values, distractor_color, forward, reverse, same_key, opposite_key = _choose_colors(rng, n_pairs)
+    pal = _build_palette(side, border_keys, fill_values)
+
+    grid = np.full((h, w), bg, dtype=int)
+    occ = np.zeros((h, w), dtype=bool)
+    _place_palette(grid, occ, pal, side, rng)
+
+    sprite_specs = [
+        ("same", shapes[0], same_key, forward[same_key]),
+        ("opposite", shapes[1], opposite_key, reverse[opposite_key]),
+        (None, shapes[2], distractor_color, None),
+    ]
+    sprite_specs[:2] = sorted(sprite_specs[:2], key=lambda x: int(x[1].sum()), reverse=True)
+    if rng.random() < 0.5:
+        sprite_specs[2:] = sprite_specs[2:]
+
+    placed = []
+    for relation, mask, color, fill in sprite_specs:
+        holes = _get_enclosed_holes(mask)
+        positions = _find_valid_positions(h, w, occ, mask, holes, side=side, relation=relation)
+        if not positions:
+            return None
+        r0, c0 = rng.choice(positions)
+        _paint_sprite(grid, r0, c0, mask, color, fill, holes)
+        placed.append((r0, c0, mask, fill))
+        sh, sw = mask.shape
+        occ[max(0, r0 - 1) : min(h, r0 + sh + 1), max(0, c0 - 1) : min(w, c0 + sw + 1)] = True
+
+    output = grid.copy()
+    inp = grid.copy()
+    for r0, c0, mask, fill in placed:
+        if fill is None:
+            continue
+        for hpts in _get_enclosed_holes(mask):
+            for hr, hc in hpts:
+                inp[r0 + hr, c0 + hc] = bg
+
+    border = np.concatenate([inp[0], inp[-1], inp[1:-1, 0], inp[1:-1, -1]])
+    vals, cnts = np.unique(border, return_counts=True)
+    if int(vals[cnts.argmax()]) != bg:
+        return None
+
+    try:
+        if np.array_equal(main(inp), output):
+            return inp
+    except Exception:
+        pass
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(_MAX_RETRIES):
+        r = _gen_attempt()
+        if r is not None:
+            return r
+    raise RuntimeError(f"Failed to generate input after {_MAX_RETRIES} attempts")

diff --git a/ceshi/code/dbff022c/D13/3/code.py b/ceshi/code/dbff022c/D13/3/code.py
new file mode 100644
index 0000000000000000000000000000000000000000..1aab9f8433bf2b8d80f352ed7852a480313e26cb
--- /dev/null
+++ b/ceshi/code/dbff022c/D13/3/code.py
@@ -0,0 +1,663 @@
+# Variant of dbff022c
+# Dimension: D13 — 填充颜色的确定来源 (transform)
+# Change: 填充颜色完全由调色板图例显式给出... → 调色板和空间规则共同决定——位于调色板同侧的精灵使用正向映射，对侧使用反向映射
+
+import random
+
+import numpy as np
+
+from arc_utils import components_mask, neighbors4
+
+
+# Design analysis for the D13 variant
+# a) Concrete behavior:
+#    The edge palette still has two aligned color lines, but the pair must now be read in
+#    different directions depending on where a hollow sprite sits relative to that edge.
+#    Example with a top palette:
+#      top row    : [2, 4, 6]
+#      second row : [7, 8, 3]
+#    A sprite in the upper half with border 2 gets fill 7 (forward lookup 2->7).
+#    A sprite in the lower half with border 8 gets fill 4 (reverse lookup 8->4).
+#    The original task always used 2->7 and would leave the lower-half border-8 sprite
+#    unchanged because 8 was not a key. The variant therefore changes the fill decision
+#    exactly at the "choose mapped fill color" step; palette detection and hole detection
+#    remain the same.
+# b) Complexity calibration:
+#    To keep the reverse rule visible, palette border colors and palette fill colors are
+#    forced to be disjoint. Each generated sample contains at least one forward-using sprite
+#    and one reverse-using sprite, plus one distractor. This avoids degeneration into the
+#    original single-direction behavior and keeps the number of moving parts small.
+# c) Old implicit assumptions that break:
+#    - The old _palette_mapping assumed only outer-line colors would ever key a fill.
+#      That fails once opposite-side sprites use inner-line colors as border colors.
+#    - The old fill loop only tested "adjacent color in mapping". That silently skips valid
+#      reverse cases, so the new solver must choose forward or reverse first, then test keys.
+#    - The old generator allowed overlap between border-key and fill-value sets. That would
+#      make forward and reverse lookups visually ambiguous, so the variant forbids overlap.
+# d) Placement legality:
+#    Sprites and the palette still keep a one-cell moat via the occupancy mask. In addition,
+#    forward sprites are placed wholly in the palette-side half of the grid and reverse
+#    sprites wholly in the far half, judged by their hole centroids. This guarantees that the
+#    solver's midpoint-based side test matches the intended role.
+# e) Visual observability:
+#    Human solvers can now see two supporting cases in each sample: a near-edge sprite whose
+#    border color appears on the palette's outer line, and a far-side sprite whose border
+#    color appears on the inner line. The side split is spatial and visible; it does not rely
+#    on color ids or hidden ordering.
+# f) Visual cleanliness:
+#    The grid keeps only three sprites per sample (forward, reverse, distractor). Slightly
+#    larger minimum grids and side-aware placement leave clear empty space between objects, so
+#    the palette and each sprite remain legible.
+# g) Color-rule inferability:
+#    Palette pairs are few (2-4), disjoint, and explicitly shown. The same sample shows both
+#    lookup directions, so the observer can infer that the palette is read outer->inner on
+#    the palette side and inner->outer on the opposite side.
+# Post-change solver assumptions checked against the generator:
+#    - Palette fill colors are unique enough to build a reverse mapping: guaranteed by the
+#      generator choosing distinct disjoint color sets.
+#    - Each fillable hole lies clearly on one side of the midpoint: guaranteed by constrained
+#      placement using the same centroid test as the solver.
+#    - Adjacent non-bg color around a hole is dominated by the owning sprite border color:
+#      guaranteed because sprites are isolated by at least one bg cell.
+
+
+def _bg_boundary(g: np.ndarray) -> int:
+    """Most common color along the 1-cell outer border."""
+    border = np.concatenate([g[0, :], g[-1, :], g[1:-1, 0], g[1:-1, -1]])
+    vals, cnts = np.unique(border, return_counts=True)
+    return int(vals[cnts.argmax()])
+
+
+def _best_palette(g: np.ndarray, bg: int) -> tuple[str, int, int]:
+    """
+    Find the 2xN or Nx2 palette block on a grid edge.
+
+    Returns (side, start, end) where:
+      - side in {"top","bottom","left","right"}
+      - for top/bottom: start/end are column indices [start,end)
+      - for left/right: start/end are row indices [start,end)
+    """
+    h, w = g.shape
+    best = None  # (score_tuple, side, start, end)
+
+    def isolated(side: str, start: int, end: int) -> bool:
+        """
+        Palette cells (excluding bg) should not be 4-neigh adjacent to same-colored cells
+        outside the palette region; this prevents accidentally absorbing parts of large sprites
+        that touch the grid edge.
+        """
+        h2, w2 = g.shape
+        pal = np.zeros((h2, w2), dtype=bool)
+        if side == "top":
+            pal[0:2, start:end] = True
+        elif side == "bottom":
+            pal[h2 - 2 : h2, start:end] = True
+        elif side == "left":
+            pal[start:end, 0:2] = True
+        else:
+            pal[start:end, w2 - 2 : w2] = True
+
+        for r, c in zip(*np.where(pal), strict=False):
+            r = int(r)
+            c = int(c)
+            v = int(g[r, c])
+            if v == bg:
+                continue
+            for rr, cc in neighbors4(r, c):
+                if 0 <= rr < h2 and 0 <= cc < w2 and not pal[rr, cc]:
+                    if int(g[rr, cc]) == v:
+                        return False
+        return True
+
+    def consider_top():
+        nonlocal best
+        if h < 2:
+            return
+        a = g[0, :]
+        b = g[1, :]
+        for c0 in range(w):
+            for c1 in range(c0 + 2, w + 1):
+                seg_a = a[c0:c1]
+                seg_b = b[c0:c1]
+                da = set(map(int, np.unique(seg_a)))
+                db = set(map(int, np.unique(seg_b)))
+                da.discard(bg)
+                db.discard(bg)
+                if len(da) < 2 or len(db) < 2:
+                    continue
+                d = da | db
+                if len(d) < 3:
+                    continue
+                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]
+                if not border_keys or len(border_keys) != len(set(border_keys)):
+                    continue
+                if not isolated("top", c0, c1):
+                    continue
+                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))
+                score = (len(set(border_keys)), len(d), -(c1 - c0), nonbg)
+                cand = (score, "top", c0, c1)
+                if best is None or cand[0] > best[0]:
+                    best = cand
+
+    def consider_bottom():
+        nonlocal best
+        if h < 2:
+            return
+        a = g[h - 1, :]
+        b = g[h - 2, :]
+        for c0 in range(w):
+            for c1 in range(c0 + 2, w + 1):
+                seg_a = a[c0:c1]
+                seg_b = b[c0:c1]
+                da = set(map(int, np.unique(seg_a)))
+                db = set(map(int, np.unique(seg_b)))
+                da.discard(bg)
+                db.discard(bg)
+                if len(da) < 2 or len(db) < 2:
+                    continue
+                d = da | db
+                if len(d) < 3:
+                    continue
+                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]
+                if not border_keys or len(border_keys) != len(set(border_keys)):
+                    continue
+                if not isolated("bottom", c0, c1):
+                    continue
+                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))
+                score = (len(set(border_keys)), len(d), -(c1 - c0), nonbg)
+                cand = (score, "bottom", c0, c1)
+                if best is None or cand[0] > best[0]:
+                    best = cand
+
+    def consider_left():
+        nonlocal best
+        if w < 2:
+            return
+        a = g[:, 0]
+        b = g[:, 1]
+        for r0 in range(h):
+            for r1 in range(r0 + 2, h + 1):
+                seg_a = a[r0:r1]
+                seg_b = b[r0:r1]
+                da = set(map(int, np.unique(seg_a)))
+                db = set(map(int, np.unique(seg_b)))
+                da.discard(bg)
+                db.discard(bg)
+                if len(da) < 2 or len(db) < 2:
+                    continue
+                d = da | db
+                if len(d) < 3:
+                    continue
+                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]
+                if not border_keys or len(border_keys) != len(set(border_keys)):
+                    continue
+                if not isolated("left", r0, r1):
+                    continue
+                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))
+                score = (len(set(border_keys)), len(d), -(r1 - r0), nonbg)
+                cand = (score, "left", r0, r1)
+                if best is None or cand[0] > best[0]:
+                    best = cand
+
+    def consider_right():
+        nonlocal best
+        if w < 2:
+            return
+        a = g[:, w - 1]
+        b = g[:, w - 2]
+        for r0 in range(h):
+            for r1 in range(r0 + 2, h + 1):
+                seg_a = a[r0:r1]
+                seg_b = b[r0:r1]
+                da = set(map(int, np.unique(seg_a)))
+                db = set(map(int, np.unique(seg_b)))
+                da.discard(bg)
+                db.discard(bg)
+                if len(da) < 2 or len(db) < 2:
+                    continue
+                d = da | db
+                if len(d) < 3:
+                    continue
+                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]
+                if not border_keys or len(border_keys) != len(set(border_keys)):
+                    continue
+                if not isolated("right", r0, r1):
+                    continue
+                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))
+                score = (len(set(border_keys)), len(d), -(r1 - r0), nonbg)
+                cand = (score, "right", r0, r1)
+                if best is None or cand[0] > best[0]:
+                    best = cand
+
+    consider_top()
+    consider_bottom()
+    consider_left()
+    consider_right()
+
+    assert best is not None, "_best_palette must find a valid palette region"
+    _, side, start, end = best
+    return side, int(start), int(end)
+
+
+def _palette_data(g: np.ndarray, bg: int) -> tuple[dict[int, int], dict[int, int], np.ndarray, str]:
+    """
+    Returns (forward_mapping outer->inner, reverse_mapping inner->outer, palette_mask, side).
+    """
+    h, w = g.shape
+    side, start, end = _best_palette(g, bg)
+    pal_mask = np.zeros((h, w), dtype=bool)
+
+    if side == "top":
+        pal_mask[0:2, start:end] = True
+        border_line = g[0, start:end]
+        fill_line = g[1, start:end]
+    elif side == "bottom":
+        pal_mask[h - 2 : h, start:end] = True
+        border_line = g[h - 1, start:end]
+        fill_line = g[h - 2, start:end]
+    elif side == "left":
+        pal_mask[start:end, 0:2] = True
+        border_line = g[start:end, 0]
+        fill_line = g[start:end, 1]
+    else:  # right
+        pal_mask[start:end, w - 2 : w] = True
+        border_line = g[start:end, w - 1]
+        fill_line = g[start:end, w - 2]
+
+    forward: dict[int, int] = {}
+    reverse: dict[int, int] = {}
+    for b, f in zip(border_line.tolist(), fill_line.tolist(), strict=False):
+        b = int(b)
+        f = int(f)
+        if b == bg or f == bg:
+            continue
+        forward[b] = f
+        reverse[f] = b
+
+    return forward, reverse, pal_mask, side
+
+
+def _region_is_same_side(pts: np.ndarray, side: str, h: int, w: int) -> bool:
+    """Classify a hole by the side of the grid midpoint that contains its centroid."""
+    r_mean = float(np.mean(pts[:, 0]))
+    c_mean = float(np.mean(pts[:, 1]))
+    if side == "top":
+        return r_mean < (h - 1) / 2.0
+    if side == "bottom":
+        return r_mean > (h - 1) / 2.0
+    if side == "left":
+        return c_mean < (w - 1) / 2.0
+    return c_mean > (w - 1) / 2.0
+
+
+def _fill_enclosed_bg_regions(
+    out: np.ndarray,
+    bg: int,
+    forward: dict[int, int],
+    reverse: dict[int, int],
+    pal_mask: np.ndarray,
+    pal_side: str,
+) -> None:
+    """
+    Fill enclosed bg holes using forward lookup on the palette side and reverse lookup on
+    the opposite side.
+    """
+    h, w = out.shape
+    bg_mask = (out == bg) & (~pal_mask)
+    comps = components_mask(bg_mask, connectivity=4)
+    for pts in comps:
+        touches_boundary = any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)
+        if touches_boundary:
+            continue
+
+        mapping = forward if _region_is_same_side(pts, pal_side, h, w) else reverse
+        adj_counts: dict[int, int] = {}
+        for r, c in pts:
+            for rr, cc in neighbors4(int(r), int(c)):
+                if 0 <= rr < h and 0 <= cc < w:
+                    if pal_mask[rr, cc]:
+                        continue
+                    v = int(out[rr, cc])
+                    if v == bg:
+                        continue
+                    adj_counts[v] = adj_counts.get(v, 0) + 1
+        if not adj_counts:
+            continue
+
+        border = None
+        best = -1
+        for col, cnt in adj_counts.items():
+            if col not in mapping:
+                continue
+            if cnt > best:
+                best = cnt
+                border = col
+        if border is None:
+            continue
+
+        fill = int(mapping[border])
+        for r, c in pts:
+            out[r, c] = fill
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Fill hollow sprites using an edge palette, with lookup direction controlled by position.
+
+    Input structure:
+    - The background is the dominant border color, and several hollow sprites sit away from
+      the palette and from each other.
+    - A 2xN or Nx2 palette lies on one grid edge; its outer line and inner line form paired
+      color correspondences.
+    - Some sprites lie on the same half of the grid as the palette edge, while others lie on
+      the opposite half.
+
+    Rule:
+    - Detect the palette and read both directions of the pairing: outer->inner and inner->outer.
+    - Find enclosed background holes that do not touch the outer grid boundary.
+    - For each hole, determine whether it is on the palette side of the grid midpoint or on
+      the far side.
+    - Use the forward palette direction for same-side holes and the reverse direction for
+      opposite-side holes, then fill using the dominant adjacent border color.
+
+    Key insight: The correct fill color is determined jointly by the palette pairings and the
+    hole's spatial relation to the palette edge, because opposite-side sprites read the same
+    palette backwards.
+    """
+    g = np.asarray(grid, dtype=int)
+    bg = _bg_boundary(g)
+
+    forward, reverse, pal_mask, pal_side = _palette_data(g, bg)
+    assert forward and reverse, "main: palette mappings must be non-empty"
+
+    out = g.copy()
+    _fill_enclosed_bg_regions(out, bg, forward, reverse, pal_mask, pal_side)
+    return out
+
+
+# --------------- generator (c) ---------------
+
+# Grid dimensions
+_GRID_H_MIN, _GRID_H_MAX = 6, 13
+_GRID_W_MIN, _GRID_W_MAX = 11, 15
+_TOP_BOTTOM_MIN_H = 11
+
+# Palette
+_PALETTE_N_MIN, _PALETTE_N_MAX = 2, 4
+
+# Sprite geometry
+_SPRITE_H_MAX = 7
+_SPRITE_W_MAX = 6
+_SPRITE_DIM_SUM_CAP = 10
+_SPRITE_CELL_MAX = 16
+
+# Sprite mutation probabilities
+_P_HORIZ_WALL = 0.3
+_P_VERT_WALL = 0.3
+_P_BORDER_REMOVAL = 0.4
+_P_DIAMOND = 0.2
+
+# Generation
+_MAX_RETRIES = 300
+
+
+def _get_enclosed_holes(sprite: np.ndarray) -> list[np.ndarray]:
+    """Return list of point-arrays for bg components not touching sprite boundary."""
+    h, w = sprite.shape
+    return [
+        pts
+        for pts in components_mask(~sprite, connectivity=4)
+        if not any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)
+    ]
+
+
+def _make_diamond() -> np.ndarray:
+    """Return a 3x3 diamond-shaped boolean mask."""
+    s = np.zeros((3, 3), dtype=bool)
+    s[0, 1] = s[1, 0] = s[1, 2] = s[2, 1] = True
+    return s
+
+
+def _make_hollow_sprite(h: int, w: int, rng: random.Random) -> np.ndarray | None:
+    """Create hollow sprite with at least one enclosed bg hole and limited cell count."""
+    sprite = np.ones((h, w), dtype=bool)
+    if h >= 3 and w >= 3:
+        sprite[1:-1, 1:-1] = False
+    if h >= 5 and w >= 4 and rng.random() < _P_HORIZ_WALL:
+        br = rng.randint(2, h - 2)
+        n = rng.randint(1, w - 2)
+        s = rng.randint(1, w - n - 1)
+        sprite[br, s : s + n] = True
+    if h >= 4 and w >= 5 and rng.random() < _P_VERT_WALL:
+        bc = rng.randint(2, w - 2)
+        n = rng.randint(1, h - 2)
+        s = rng.randint(1, h - n - 1)
+        sprite[s : s + n, bc] = True
+    if rng.random() < _P_BORDER_REMOVAL:
+        bcells = [
+            (r, c)
+            for r in range(h)
+            for c in range(w)
+            if sprite[r, c] and (r in (0, h - 1) or c in (0, w - 1))
+        ]
+        rng.shuffle(bcells)
+        for cr, cc in bcells[: rng.randint(1, min(4, len(bcells)))]:
+            test = sprite.copy()
+            test[cr, cc] = False
+            if _get_enclosed_holes(test):
+                sprite = test
+    if not _get_enclosed_holes(sprite) or int(sprite.sum()) > _SPRITE_CELL_MAX:
+        return None
+    return sprite
+
+
+def _choose_colors(
+    rng: random.Random,
+    n_pairs: int,
+) -> tuple[list[int], list[int], int, dict[int, int], dict[int, int], int, int]:
+    """Pick disjoint palette domains plus one forward key and one reverse key."""
+    all_c = list(range(1, 10))
+    rng.shuffle(all_c)
+    border_keys = all_c[:n_pairs]
+    fill_values = all_c[n_pairs : 2 * n_pairs]
+    distractor_color = all_c[2 * n_pairs]
+    forward = dict(zip(border_keys, fill_values))
+    reverse = dict(zip(fill_values, border_keys))
+    same_key = rng.choice(border_keys)
+    opposite_key = rng.choice(fill_values)
+    return border_keys, fill_values, distractor_color, forward, reverse, same_key, opposite_key
+
+
+def _build_palette(side: str, border_keys: list[int], fill_values: list[int]) -> np.ndarray:
+    """Construct the 2xN or Nx2 palette array for the given edge side."""
+    n = len(border_keys)
+    if side in ("top", "bottom"):
+        pal = np.zeros((2, n), dtype=int)
+        outer, inner = (0, 1) if side == "top" else (1, 0)
+        pal[outer] = border_keys
+        pal[inner] = fill_values
+    else:
+        pal = np.zeros((n, 2), dtype=int)
+        outer, inner = (0, 1) if side == "left" else (1, 0)
+        pal[:, outer] = border_keys
+        pal[:, inner] = fill_values
+    return pal
+
+
+def _place_palette(
+    grid: np.ndarray,
+    occ: np.ndarray,
+    pal: np.ndarray,
+    side: str,
+    rng: random.Random,
+) -> None:
+    """Place palette on the chosen edge and mark its occupancy (with 1-cell padding)."""
+    h, w = grid.shape
+    pal_h, pal_w = pal.shape
+    if side == "top":
+        pr0, pc0 = 0, rng.randint(0, w - pal_w)
+    elif side == "bottom":
+        pr0, pc0 = h - pal_h, rng.randint(0, w - pal_w)
+    elif side == "left":
+        pr0, pc0 = rng.randint(0, h - pal_h), 0
+    else:
+        pr0, pc0 = rng.randint(0, h - pal_h), w - pal_w
+    grid[pr0 : pr0 + pal_h, pc0 : pc0 + pal_w] = pal
+    occ[max(0, pr0 - 1) : min(h, pr0 + pal_h + 1), max(0, pc0 - 1) : min(w, pc0 + pal_w + 1)] = True
+
+
+def _matches_relation(pts: np.ndarray, side: str, relation: str, h: int, w: int) -> bool:
+    same_side = _region_is_same_side(pts, side, h, w)
+    if relation == "same":
+        return same_side
+    if relation == "opposite":
+        return not same_side
+    return True
+
+
+def _find_valid_positions(
+    h: int,
+    w: int,
+    occ: np.ndarray,
+    mask: np.ndarray,
+    holes: list[np.ndarray],
+    side: str | None = None,
+    relation: str | None = None,
+) -> list[tuple[int, int]]:
+    """Find placements that fit, stay isolated, and optionally satisfy the side rule."""
+    sh, sw = mask.shape
+    positions = []
+    for r0 in range(h - sh + 1):
+        for c0 in range(w - sw + 1):
+            if occ[max(0, r0 - 1) : min(h, r0 + sh + 1), max(0, c0 - 1) : min(w, c0 + sw + 1)].any():
+                continue
+            if any(
+                r0 + hr == 0 or c0 + hc == 0 or r0 + hr == h - 1 or c0 + hc == w - 1
+                for hpts in holes
+                for hr, hc in hpts
+            ):
+                continue
+            if relation is not None:
+                ok = True
+                for hpts in holes:
+                    shifted = hpts + np.array([r0, c0])
+                    if not _matches_relation(shifted, side, relation, h, w):
+                        ok = False
+                        break
+                if not ok:
+                    continue
+            positions.append((r0, c0))
+    return positions
+
+
+def _paint_sprite(
+    grid: np.ndarray,
+    r0: int,
+    c0: int,
+    mask: np.ndarray,
+    color: int,
+    fill: int | None,
+    holes: list[np.ndarray],
+) -> None:
+    """Render a sprite onto the grid."""
+    grid[r0 : r0 + mask.shape[0], c0 : c0 + mask.shape[1]][mask] = color
+    if fill is not None:
+        for hpts in holes:
+            for hr, hc in hpts:
+                grid[r0 + hr, c0 + hc] = fill
+
+
+def _choose_side(h: int, rng: random.Random) -> str:
+    """Top/bottom are only used when the grid is tall enough to show both halves clearly."""
+    sides = ["left", "right"]
+    if h >= _TOP_BOTTOM_MIN_H:
+        sides.extend(["top", "bottom"])
+    return rng.choice(sides)
+
+
+def _gen_attempt() -> np.ndarray | None:
+    rng = random.Random()
+    bg = 0
+
+    h = rng.randint(_GRID_H_MIN, _GRID_H_MAX)
+    w = rng.randint(_GRID_W_MIN, _GRID_W_MAX)
+    side = _choose_side(h, rng)
+    n_pairs = rng.randint(_PALETTE_N_MIN, _PALETTE_N_MAX)
+
+    max_sh = min(_SPRITE_H_MAX, h)
+    max_sw = min(_SPRITE_W_MAX, w)
+    if side in ("top", "bottom"):
+        max_sh = min(max_sh, 4)
+    else:
+        max_sw = min(max_sw, 4)
+
+    shapes = []
+    for _ in range(3):
+        sh = rng.randint(3, max_sh)
+        sw = rng.randint(3, max_sw)
+        if sh + sw > _SPRITE_DIM_SUM_CAP:
+            sw = max(3, _SPRITE_DIM_SUM_CAP - sh)
+        if sh == 3 and sw == 3 and rng.random() < _P_DIAMOND:
+            mask = _make_diamond()
+        else:
