+
+def _region_is_same_side(pts: np.ndarray, side: str, h: int, w: int) -> bool:
+    """Classify a hole by the side of the grid midpoint that contains its centroid."""
+    r_mean = float(np.mean(pts[:, 0]))
+    c_mean = float(np.mean(pts[:, 1]))
+    if side == "top":
+        return r_mean < (h - 1) / 2.0
+    if side == "bottom":
+        return r_mean > (h - 1) / 2.0
+    if side == "left":
+        return c_mean < (w - 1) / 2.0
+    return c_mean > (w - 1) / 2.0
+
+
+def _fill_enclosed_bg_regions(
+    out: np.ndarray,
+    bg: int,
+    forward: dict[int, int],
+    reverse: dict[int, int],
+    pal_mask: np.ndarray,
+    pal_side: str,
+) -> None:
+    """
+    Fill enclosed bg holes using forward lookup on the palette side and reverse lookup on
+    the opposite side.
+    """
+    h, w = out.shape
+    bg_mask = (out == bg) & (~pal_mask)
+    comps = components_mask(bg_mask, connectivity=4)
+    for pts in comps:
+        touches_boundary = any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)
+        if touches_boundary:
+            continue
+
+        mapping = forward if _region_is_same_side(pts, pal_side, h, w) else reverse
+        adj_counts: dict[int, int] = {}
+        for r, c in pts:
+            for rr, cc in neighbors4(int(r), int(c)):
+                if 0 <= rr < h and 0 <= cc < w:
+                    if pal_mask[rr, cc]:
+                        continue
+                    v = int(out[rr, cc])
+                    if v == bg:
+                        continue
+                    adj_counts[v] = adj_counts.get(v, 0) + 1
+        if not adj_counts:
+            continue
+
+        border = None
+        best = -1
+        for col, cnt in adj_counts.items():
+            if col not in mapping:
+                continue
+            if cnt > best:
+                best = cnt
+                border = col
+        if border is None:
+            continue
+
+        fill = int(mapping[border])
+        for r, c in pts:
+            out[r, c] = fill
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Fill hollow sprites using an edge palette, with lookup direction controlled by position.
+
+    Input structure:
+    - The background is the dominant border color, and several hollow sprites sit away from
+      the palette and from each other.
+    - A 2xN or Nx2 palette lies on one grid edge; its outer line and inner line form paired
+      color correspondences.
+    - Some sprites lie on the same half of the grid as the palette edge, while others lie on
+      the opposite half.
+
+    Rule:
+    - Detect the palette and read both directions of the pairing: outer->inner and inner->outer.
+    - Find enclosed background holes that do not touch the outer grid boundary.
+    - For each hole, determine whether it is on the palette side of the grid midpoint or on
+      the far side.
+    - Use the forward palette direction for same-side holes and the reverse direction for
+      opposite-side holes, then fill using the dominant adjacent border color.
+
+    Key insight: The correct fill color is determined jointly by the palette pairings and the
+    hole's spatial relation to the palette edge, because opposite-side sprites read the same
+    palette backwards.
+    """
+    g = np.asarray(grid, dtype=int)
+    bg = _bg_boundary(g)
+
+    forward, reverse, pal_mask, pal_side = _palette_data(g, bg)
+    assert forward and reverse, "main: palette mappings must be non-empty"
+
+    out = g.copy()
+    _fill_enclosed_bg_regions(out, bg, forward, reverse, pal_mask, pal_side)
+    return out
+
+
+# --------------- generator (c) ---------------
+
+# Grid dimensions
+_GRID_H_MIN, _GRID_H_MAX = 6, 13
+_GRID_W_MIN, _GRID_W_MAX = 11, 15
+_TOP_BOTTOM_MIN_H = 11
+
+# Palette
+_PALETTE_N_MIN, _PALETTE_N_MAX = 2, 4
+
+# Sprite geometry
+_SPRITE_H_MAX = 7
+_SPRITE_W_MAX = 6
+_SPRITE_DIM_SUM_CAP = 10
+_SPRITE_CELL_MAX = 16
+
+# Sprite mutation probabilities
+_P_HORIZ_WALL = 0.3
+_P_VERT_WALL = 0.3
+_P_BORDER_REMOVAL = 0.4
+_P_DIAMOND = 0.2
+
+# Generation
+_MAX_RETRIES = 300
+
+
+def _get_enclosed_holes(sprite: np.ndarray) -> list[np.ndarray]:
+    """Return list of point-arrays for bg components not touching sprite boundary."""
+    h, w = sprite.shape
+    return [
+        pts
+        for pts in components_mask(~sprite, connectivity=4)
+        if not any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)
+    ]
+
+
+def _make_diamond() -> np.ndarray:
+    """Return a 3x3 diamond-shaped boolean mask."""
+    s = np.zeros((3, 3), dtype=bool)
+    s[0, 1] = s[1, 0] = s[1, 2] = s[2, 1] = True
+    return s
+
+
+def _make_hollow_sprite(h: int, w: int, rng: random.Random) -> np.ndarray | None:
+    """Create hollow sprite with at least one enclosed bg hole and limited cell count."""
+    sprite = np.ones((h, w), dtype=bool)
+    if h >= 3 and w >= 3:
+        sprite[1:-1, 1:-1] = False
+    if h >= 5 and w >= 4 and rng.random() < _P_HORIZ_WALL:
+        br = rng.randint(2, h - 2)
+        n = rng.randint(1, w - 2)
+        s = rng.randint(1, w - n - 1)
+        sprite[br, s : s + n] = True
+    if h >= 4 and w >= 5 and rng.random() < _P_VERT_WALL:
+        bc = rng.randint(2, w - 2)
+        n = rng.randint(1, h - 2)
+        s = rng.randint(1, h - n - 1)
+        sprite[s : s + n, bc] = True
+    if rng.random() < _P_BORDER_REMOVAL:
+        bcells = [
+            (r, c)
+            for r in range(h)
+            for c in range(w)
+            if sprite[r, c] and (r in (0, h - 1) or c in (0, w - 1))
+        ]
+        rng.shuffle(bcells)
+        for cr, cc in bcells[: rng.randint(1, min(4, len(bcells)))]:
+            test = sprite.copy()
+            test[cr, cc] = False
+            if _get_enclosed_holes(test):
+                sprite = test
+    if not _get_enclosed_holes(sprite) or int(sprite.sum()) > _SPRITE_CELL_MAX:
+        return None
+    return sprite
+
+
+def _choose_colors(
+    rng: random.Random,
+    n_pairs: int,
+) -> tuple[list[int], list[int], int, dict[int, int], dict[int, int], int, int]:
+    """Pick disjoint palette domains plus one forward key and one reverse key."""
+    all_c = list(range(1, 10))
+    rng.shuffle(all_c)
+    border_keys = all_c[:n_pairs]
+    fill_values = all_c[n_pairs : 2 * n_pairs]
+    distractor_color = all_c[2 * n_pairs]
+    forward = dict(zip(border_keys, fill_values))
+    reverse = dict(zip(fill_values, border_keys))
+    same_key = rng.choice(border_keys)
+    opposite_key = rng.choice(fill_values)
+    return border_keys, fill_values, distractor_color, forward, reverse, same_key, opposite_key
+
+
+def _build_palette(side: str, border_keys: list[int], fill_values: list[int]) -> np.ndarray:
+    """Construct the 2xN or Nx2 palette array for the given edge side."""
+    n = len(border_keys)
+    if side in ("top", "bottom"):
+        pal = np.zeros((2, n), dtype=int)
+        outer, inner = (0, 1) if side == "top" else (1, 0)
+        pal[outer] = border_keys
+        pal[inner] = fill_values
+    else:
+        pal = np.zeros((n, 2), dtype=int)
+        outer, inner = (0, 1) if side == "left" else (1, 0)
+        pal[:, outer] = border_keys
+        pal[:, inner] = fill_values
+    return pal
+
+
+def _place_palette(
+    grid: np.ndarray,
+    occ: np.ndarray,
+    pal: np.ndarray,
+    side: str,
+    rng: random.Random,
+) -> None:
+    """Place palette on the chosen edge and mark its occupancy (with 1-cell padding)."""
+    h, w = grid.shape
+    pal_h, pal_w = pal.shape
+    if side == "top":
+        pr0, pc0 = 0, rng.randint(0, w - pal_w)
+    elif side == "bottom":
+        pr0, pc0 = h - pal_h, rng.randint(0, w - pal_w)
+    elif side == "left":
+        pr0, pc0 = rng.randint(0, h - pal_h), 0
+    else:
+        pr0, pc0 = rng.randint(0, h - pal_h), w - pal_w
+    grid[pr0 : pr0 + pal_h, pc0 : pc0 + pal_w] = pal
+    occ[max(0, pr0 - 1) : min(h, pr0 + pal_h + 1), max(0, pc0 - 1) : min(w, pc0 + pal_w + 1)] = True
+
+
+def _matches_relation(pts: np.ndarray, side: str, relation: str, h: int, w: int) -> bool:
+    same_side = _region_is_same_side(pts, side, h, w)
+    if relation == "same":
+        return same_side
+    if relation == "opposite":
+        return not same_side
+    return True
+
+
+def _find_valid_positions(
+    h: int,
+    w: int,
+    occ: np.ndarray,
+    mask: np.ndarray,
+    holes: list[np.ndarray],
+    side: str | None = None,
+    relation: str | None = None,
+) -> list[tuple[int, int]]:
+    """Find placements that fit, stay isolated, and optionally satisfy the side rule."""
+    sh, sw = mask.shape
+    positions = []
+    for r0 in range(h - sh + 1):
+        for c0 in range(w - sw + 1):
+            if occ[max(0, r0 - 1) : min(h, r0 + sh + 1), max(0, c0 - 1) : min(w, c0 + sw + 1)].any():
+                continue
+            if any(
+                r0 + hr == 0 or c0 + hc == 0 or r0 + hr == h - 1 or c0 + hc == w - 1
+                for hpts in holes
+                for hr, hc in hpts
+            ):
+                continue
+            if relation is not None:
+                ok = True
+                for hpts in holes:
+                    shifted = hpts + np.array([r0, c0])
+                    if not _matches_relation(shifted, side, relation, h, w):
+                        ok = False
+                        break
+                if not ok:
+                    continue
+            positions.append((r0, c0))
+    return positions
+
+
+def _paint_sprite(
+    grid: np.ndarray,
+    r0: int,
+    c0: int,
+    mask: np.ndarray,
+    color: int,
+    fill: int | None,
+    holes: list[np.ndarray],
+) -> None:
+    """Render a sprite onto the grid."""
+    grid[r0 : r0 + mask.shape[0], c0 : c0 + mask.shape[1]][mask] = color
+    if fill is not None:
+        for hpts in holes:
+            for hr, hc in hpts:
+                grid[r0 + hr, c0 + hc] = fill
+
+
+def _choose_side(h: int, rng: random.Random) -> str:
+    """Top/bottom are only used when the grid is tall enough to show both halves clearly."""
+    sides = ["left", "right"]
+    if h >= _TOP_BOTTOM_MIN_H:
+        sides.extend(["top", "bottom"])
+    return rng.choice(sides)
+
+
+def _gen_attempt() -> np.ndarray | None:
+    rng = random.Random()
+    bg = 0
+
+    h = rng.randint(_GRID_H_MIN, _GRID_H_MAX)
+    w = rng.randint(_GRID_W_MIN, _GRID_W_MAX)
+    side = _choose_side(h, rng)
+    n_pairs = rng.randint(_PALETTE_N_MIN, _PALETTE_N_MAX)
+
+    max_sh = min(_SPRITE_H_MAX, h)
+    max_sw = min(_SPRITE_W_MAX, w)
+    if side in ("top", "bottom"):
+        max_sh = min(max_sh, 4)
+    else:
+        max_sw = min(max_sw, 4)
+
+    shapes = []
+    for _ in range(3):
+        sh = rng.randint(3, max_sh)
+        sw = rng.randint(3, max_sw)
+        if sh + sw > _SPRITE_DIM_SUM_CAP:
+            sw = max(3, _SPRITE_DIM_SUM_CAP - sh)
+        if sh == 3 and sw == 3 and rng.random() < _P_DIAMOND:
+            mask = _make_diamond()
+        else:
+            mask = _make_hollow_sprite(sh, sw, rng)
+        if mask is None:
+            return None
+        shapes.append(mask)
+
+    border_keys, fill_values, distractor_color, forward, reverse, same_key, opposite_key = _choose_colors(rng, n_pairs)
+    pal = _build_palette(side, border_keys, fill_values)
+
+    grid = np.full((h, w), bg, dtype=int)
+    occ = np.zeros((h, w), dtype=bool)
+    _place_palette(grid, occ, pal, side, rng)
+
+    sprite_specs = [
+        ("same", shapes[0], same_key, forward[same_key]),
+        ("opposite", shapes[1], opposite_key, reverse[opposite_key]),
+        (None, shapes[2], distractor_color, None),
+    ]
+    sprite_specs[:2] = sorted(sprite_specs[:2], key=lambda x: int(x[1].sum()), reverse=True)
+    if rng.random() < 0.5:
+        sprite_specs[2:] = sprite_specs[2:]
+
+    placed = []
+    for relation, mask, color, fill in sprite_specs:
+        holes = _get_enclosed_holes(mask)
+        positions = _find_valid_positions(h, w, occ, mask, holes, side=side, relation=relation)
+        if not positions:
+            return None
+        r0, c0 = rng.choice(positions)
+        _paint_sprite(grid, r0, c0, mask, color, fill, holes)
+        placed.append((r0, c0, mask, fill))
+        sh, sw = mask.shape
+        occ[max(0, r0 - 1) : min(h, r0 + sh + 1), max(0, c0 - 1) : min(w, c0 + sw + 1)] = True
+
+    output = grid.copy()
+    inp = grid.copy()
+    for r0, c0, mask, fill in placed:
+        if fill is None:
+            continue
+        for hpts in _get_enclosed_holes(mask):
+            for hr, hc in hpts:
+                inp[r0 + hr, c0 + hc] = bg
+
+    border = np.concatenate([inp[0], inp[-1], inp[1:-1, 0], inp[1:-1, -1]])
+    vals, cnts = np.unique(border, return_counts=True)
+    if int(vals[cnts.argmax()]) != bg:
+        return None
+
+    try:
+        if np.array_equal(main(inp), output):
+            return inp
+    except Exception:
+        pass
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(_MAX_RETRIES):
+        r = _gen_attempt()
+        if r is not None:
+            return r
+    raise RuntimeError(f"Failed to generate input after {_MAX_RETRIES} attempts")

