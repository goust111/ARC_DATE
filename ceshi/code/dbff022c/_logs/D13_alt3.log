+    fill_values = all_c[n_pairs : 2 * n_pairs]
+    distractor_color = all_c[2 * n_pairs]
+    forward = dict(zip(border_keys, fill_values))
+    reverse = dict(zip(fill_values, border_keys))
+    same_key = rng.choice(border_keys)
+    opposite_key = rng.choice(fill_values)
