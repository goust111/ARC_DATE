import numpy as np
from collections import deque

def outer_adj(mask):
    h,w=mask.shape
    # annulus-like exterior within bbox padding 1 around mask
    pad=np.pad(mask,1)
    H,W=pad.shape
    seen=np.zeros_like(pad,bool)
    q=deque([(0,0)]); seen[0,0]=True
    while q:
        r,c=q.popleft()
        for rr,cc in ((r-1,c),(r+1,c),(r,c-1),(r,c+1)):
            if 0<=rr<H and 0<=cc<W and not seen[rr,cc] and not pad[rr,cc]:
                seen[rr,cc]=True; q.append((rr,cc))
    exterior=seen
    cnt=0
    for r in range(H):
        for c in range(W):
            if not pad[r,c]:
                continue
            for rr,cc in ((r-1,c),(r+1,c),(r,c-1),(r,c+1)):
                if 0<=rr<H and 0<=cc<W and exterior[rr,cc]:
                    cnt += 1
    return cnt

def ring(h,w):
    m=np.zeros((h,w),bool)
    m[0,:]=m[-1,:]=m[:,0]=m[:,-1]=True
    return m

def tabbed(base_h, base_w, pad_h, pad_w, tab=3):
    m=np.zeros((pad_h,pad_w),bool)
    r=(pad_h-base_h)//2; c=(pad_w-base_w)//2
    m[r:r+base_h,c:c+base_w]=ring(base_h,base_w)
    midc=c+base_w//2; midr=r+base_h//2
    t=(tab-1)//2
    m[r-1, midc-t:midc+t+1]=True
    m[r+base_h, midc-t:midc+t+1]=True
    m[midr-t:midr+t+1, c-1]=True
    m[midr-t:midr+t+1, c+base_w]=True
    return m

cands=[]
for base_h,base_w,pad_h,pad_w in [(5,5,7,7),(3,5,5,7),(5,3,7,5),(5,7,7,9),(7,5,9,7),(3,7,5,9),(7,3,9,5)]:
    if pad_h<base_h+2 or pad_w<base_w+2: continue
    m=tabbed(base_h,base_w,pad_h,pad_w,tab=3)
    # hole count rough via flood from boundary on inverse
    print((base_h,base_w,pad_h,pad_w), 'adj', outer_adj(m), 'cells', int(m.sum()))
    print(m.astype(int))
    print()
