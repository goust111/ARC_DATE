   351	        if r == 0 or c == 0 or r == h - 1 or c == w - 1:
   352	            return True
   353	        for rr, cc in neighbors4(r, c):
   354	            if 0 <= rr < h and 0 <= cc < w and not blocked[rr, cc] and not seen[rr, cc]:
