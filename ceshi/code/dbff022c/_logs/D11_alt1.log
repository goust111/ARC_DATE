   434	def main(grid: np.ndarray) -> np.ndarray:
   435	    """
   436	    Fill nested hollow sprites using a color legend placed on the grid edge.
   437	
   438	    Input structure:
   439	    - bg is the dominant border color, and a 2×N or N×2 palette sits on one grid edge.
   440	    - The play area contains a large hollow shell with a smaller hollow shell inside it, so one enclosed outer cavity is split into layered interior regions.
   441	
   442	    Rule:
   443	    - Read the edge palette as a border-color to fill-color mapping.
   444	    - Find each bg region that is enclosed away from the grid boundary.
   445	    - For nested interiors, assign each enclosed region to the nearest shell that truly contains it, then fill that region with the shell's mapped color if its border color appears in the palette.
   446	
   447	    Key insight:
   448	    - Adjacency alone is no longer enough because an outer cavity can touch both the large shell and the inner shell; the correct fill comes from containment depth, not just from the most frequent neighboring color.
   449	    """
   450	    g = np.asarray(grid, dtype=int)
   451	    bg = _bg_boundary(g)
   452	
   453	    mapping, pal_mask = _palette_mapping(g, bg)
   454	    assert mapping, "main: palette mapping must be non-empty"
   455	
   456	    out = g.copy()
   457	    _fill_enclosed_bg_regions(out, bg, mapping, pal_mask)
   458	    return out
