/bin/bash -lc "python - <<'PY'
import numpy as np
from collections import deque

def outer_adj(mask):
    pad=np.pad(mask,1)
    H,W=pad.shape
    seen=np.zeros_like(pad,bool)
    q=deque([(0,0)]); seen[0,0]=True
    while q:
        r,c=q.popleft()
        for rr,cc in ((r-1,c),(r+1,c),(r,c-1),(r,c+1)):
            if 0<=rr<H and 0<=cc<W and not seen[rr,cc] and not pad[rr,cc]:
                seen[rr,cc]=True; q.append((rr,cc))
    ext=seen
    cnt=0
    for r in range(H):
      for c in range(W):
        if pad[r,c]:
          for rr,cc in ((r-1,c),(r+1,c),(r,c-1),(r,c+1)):
            if 0<=rr<H and 0<=cc<W and ext[rr,cc]: cnt += 1
    return cnt

def diamond_ring(h,w):
    cr,cc=h//2,w//2
    rad=min(cr,cc)
    m=np.zeros((h,w),bool)
    for r in range(h):
      for c in range(w):
        d=abs(r-cr)+abs(c-cc)
        if d==rad:
          m[r,c]=True
    return m

for h,w in [(11,11),(11,13),(9,11)]:
  m=diamond_ring(h,w)
  print((h,w), 'adj', outer_adj(m), 'cells', int(m.sum()))
  print(m.astype(int))
  print()
