   489	def _build_palette(side: str, border_keys: list[int], fill_values: list[int]) -> np.ndarray:
   490	    """Construct the 2xN or Nx2 palette array for the given edge side."""
   491	    n = len(border_keys)
   492	    if side in ("top", "bottom"):
   493	        pal = np.zeros((2, n), dtype=int)
   494	        outer, inner = (0, 1) if side == "top" else (1, 0)
   495	        pal[outer] = border_keys
   496	        pal[inner] = fill_values
   497	    else:
   498	        pal = np.zeros((n, 2), dtype=int)
   499	        outer, inner = (0, 1) if side == "left" else (1, 0)
   500	        pal[:, outer] = border_keys
   501	        pal[:, inner] = fill_values
   502	    return pal
   503	
   504	
   505	def _place_palette(grid: np.ndarray, occ: np.ndarray, pal: np.ndarray, side: str, rng: random.Random) -> None:
   506	    """Place the palette and mark a 1-cell moat around it as occupied."""
   507	    h, w = grid.shape
   508	    ph, pw = pal.shape
   509	    if side == "top":
   510	        r0, c0 = 0, rng.randint(0, w - pw)
   511	    elif side == "bottom":
   512	        r0, c0 = h - ph, rng.randint(0, w - pw)
   513	    elif side == "left":
   514	        r0, c0 = rng.randint(0, h - ph), 0
   515	    else:
   516	        r0, c0 = rng.randint(0, h - ph), w - pw
   517	
   518	    grid[r0 : r0 + ph, c0 : c0 + pw] = pal
   519	    occ[max(0, r0 - 1) : min(h, r0 + ph + 1), max(0, c0 - 1) : min(w, c0 + pw + 1)] = True
