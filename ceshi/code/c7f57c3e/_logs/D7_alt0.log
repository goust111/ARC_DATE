    52	
    53	import random
    54	
    55	import numpy as np
    56	
    57	from arc_utils import bbox_coords, components_mask, get_bg, paste
    58	
    59	
    60	def _pick_anchor_bbox(arr: np.ndarray, bg: int) -> tuple[int, int, int, int]:
    61	    """Return the bbox of color-1 anchor pixels."""
    62	    ys, xs = np.where(arr == 1)
    63	    assert ys.size > 0, "every sprite must contain color 1 anchor pixels"
    64	    return int(ys.min()), int(xs.min()), int(ys.max()), int(xs.max())
    65	
    66	
    67	def _scale_nn(arr: np.ndarray, scale: int) -> np.ndarray:
    68	    """Nearest-neighbor upscale by an integer factor."""
    69	    scale = int(scale)
    70	    if scale <= 1:
    71	        return arr.copy()
    72	    return np.repeat(np.repeat(arr, scale, axis=0), scale, axis=1)
    73	
    74	
    75	def _descale_nn(arr: np.ndarray, scale: int) -> np.ndarray:
    76	    """Recover the logical prototype from an exact NN-scaled sprite."""
    77	    scale = int(scale)
    78	    if scale <= 1:
    79	        return arr.copy()
    80	    h, w = arr.shape
    81	    assert h % scale == 0 and w % scale == 0, "sprite shape must be divisible by scale"
    82	    return arr[::scale, ::scale].copy()
    83	
    84	
    85	def _aligned_union_bbox(
    86	    output_patch: np.ndarray, input_patch: np.ndarray, bg: int
    87	) -> tuple[int, int, int, int]:
    88	    """Union box for anchor-aligned output/input placement at one logical slot."""
    89	    oa = _pick_anchor_bbox(output_patch, bg)
    90	    ia = _pick_anchor_bbox(input_patch, bg)
    91	    dr = oa[0] - ia[0]
    92	    dc = oa[1] - ia[1]
    93	
    94	    oh, ow = output_patch.shape
    95	    ih, iw = input_patch.shape
    96	    union_h = max(oh - min(0, dr), ih + max(0, dr))
    97	    union_w = max(ow - min(0, dc), iw + max(0, dc))
    98	    return int(dr), int(dc), int(union_h), int(union_w)
    99	
   100	
   101	def _place_from_union_origin(
   102	    union_r: int, union_c: int, dr: int, dc: int
   103	) -> tuple[int, int, int, int]:
   104	    """Convert union origin + relative anchor offset into output/input top-lefts."""
   105	    out_r = union_r - min(0, dr)
   106	    out_c = union_c - min(0, dc)
   107	    in_r = out_r + dr
   108	    in_c = out_c + dc
   109	    return int(out_r), int(out_c), int(in_r), int(in_c)
   110	
   111	
   112	def main(grid: np.ndarray) -> np.ndarray:
   113	    """
   114	    Swap paired sprites to the opposite prototype while also exchanging their scales.
   115	
   116	    Input structure:
   117	    - The background is the most common color. Exactly two multicolor sprite prototypes appear as connected components.
   118	    - Each prototype occurs twice, once at scale 1 and once at scale 2, and every sprite contains a color-1 anchor region.
   119	
   120	    Rule:
   121	    - Recover the two base prototypes from the smallest sprites, then classify every sprite by prototype and scale.
   122	    - Sort the sprites within each prototype by anchor position, pair the k-th sprite of one group with the k-th sprite of the other group, and swap them across the pair.
   123	    - When a sprite moves to its partner's location it keeps its own scale, so each location receives the opposite prototype at the partner sprite's scale, aligned by the target location's anchor.
   124	
   125	    Key insight: Prototype identity and scale now travel together with the paired source sprite; the visible slot is fixed by the target anchor, but the size comes from the other group.
   126	    """
   127	    g = np.asarray(grid, dtype=int)
   128	    bg = get_bg(g)
   129	
   130	    comps = components_mask(g != bg, connectivity=8)
   131	    assert len(comps) >= 2, "grid must contain at least two sprites"
   132	
   133	    sprites = []
   134	    for pts in comps:
   135	        r0, c0, r1, c1 = bbox_coords(pts)
   136	        arr = g[r0 : r1 + 1, c0 : c1 + 1].copy()
   137	        anc = _pick_anchor_bbox(arr, bg)
   138	        sprites.append(
   139	            {
   140	                "pts": pts,
   141	                "bbox": (r0, c0, r1, c1),
   142	                "arr": arr,
   143	                "anchor_bbox": anc,
   144	                "anchor_global": (int(r0 + anc[0]), int(c0 + anc[1])),
   145	            }
   146	        )
   147	
   148	    areas = [int((s["bbox"][2] - s["bbox"][0] + 1) * (s["bbox"][3] - s["bbox"][1] + 1)) for s in sprites]
   149	    min_area = min(areas)
   150	    base = [s for s, a in zip(sprites, areas, strict=False) if a == min_area]
   151	    uniq: dict[tuple[int, ...], np.ndarray] = {}
   152	    for s in base:
   153	        key = tuple(s["arr"].ravel().tolist())
   154	        if key not in uniq:
   155	            uniq[key] = s["arr"]
   156	    assert len(uniq) == 2, "the smallest sprites must give the two base prototypes"
   157	
   158	    protos = list(uniq.values())[:2]
   159	    anc0 = _pick_anchor_bbox(protos[0], bg)
   160	    anc1 = _pick_anchor_bbox(protos[1], bg)
   161	    base_anchor_h0 = anc0[2] - anc0[0] + 1
   162	    base_anchor_w0 = anc0[3] - anc0[1] + 1
   163	    base_anchor_h1 = anc1[2] - anc1[0] + 1
   164	    base_anchor_w1 = anc1[3] - anc1[1] + 1
   165	    assert (base_anchor_h0, base_anchor_w0) == (base_anchor_h1, base_anchor_w1)
   166	
   167	    for s in sprites:
   168	        ar0, ac0, ar1, ac1 = s["anchor_bbox"]
   169	        inst_anchor_h = ar1 - ar0 + 1
   170	        inst_anchor_w = ac1 - ac0 + 1
   171	        assert inst_anchor_h % base_anchor_h0 == 0 and inst_anchor_w % base_anchor_w0 == 0
   172	        scale_h = inst_anchor_h // base_anchor_h0
   173	        scale_w = inst_anchor_w // base_anchor_w0
   174	        assert scale_h == scale_w and scale_h >= 1
   175	        scale = int(scale_h)
   176	
   177	        logical = _descale_nn(s["arr"], scale)
   178	        match_idx = None
   179	        for idx, proto in enumerate(protos):
   180	            if np.array_equal(logical, proto):
   181	                match_idx = idx
   182	                break
   183	        assert match_idx is not None, "every sprite must descale to one of the two prototypes"
   184	        s["type"] = int(match_idx)
   185	        s["scale"] = scale
   186	
   187	    groups = {0: [], 1: []}
   188	    for s in sprites:
   189	        groups[s["type"]].append(s)
   190	    assert len(groups[0]) == len(groups[1]) >= 1, "the two prototype groups must have the same size"
   191	
   192	    for idx in (0, 1):
   193	        groups[idx].sort(key=lambda s: (s["anchor_global"][0], s["anchor_global"][1]))
   194	
   195	    out = np.full_like(g, bg)
   196	
   197	    for sa, sb in zip(groups[0], groups[1], strict=True):
   198	        patch_for_a = _scale_nn(protos[sb["type"]], sb["scale"])
   199	        patch_for_b = _scale_nn(protos[sa["type"]], sa["scale"])
   200	
   201	        anc_patch_a = _pick_anchor_bbox(patch_for_a, bg)
   202	        anc_patch_b = _pick_anchor_bbox(patch_for_b, bg)
   203	
   204	        top_a = sa["anchor_global"][0] - anc_patch_a[0]
   205	        left_a = sa["anchor_global"][1] - anc_patch_a[1]
   206	        top_b = sb["anchor_global"][0] - anc_patch_b[0]
   207	        left_b = sb["anchor_global"][1] - anc_patch_b[1]
   208	
   209	        paste(out, patch_for_a, top_a, left_a, transparent=bg)
   210	        paste(out, patch_for_b, top_b, left_b, transparent=bg)
   211	
   212	    return out
   213	
   214	
   215	# --------------- generator (o5x) ---------------
   216	
   217	# --- CFG: canvas ---
   218	GRID_SIZE_MIN = 18
   219	GRID_SIZE_MAX = 28
   220	GRID_BORDER = 1
   221	ROW_GAP = 2
   222	COL_GAP = 2
   223	
   224	# --- CFG: prototypes ---
   225	PROTO_SHAPES = [(4, 3), (3, 4), (4, 4)]
   226	BG_CHOICES = [0, 2, 3, 4, 5, 6, 7, 8, 9]
   227	COLOR_SHARE_PROB = 0.65
   228	
   229	# --- CFG: row-mask weights ---
   230	ANCHOR_ROW_WEIGHTS = [("center", 0.45), ("outer", 0.35), ("full", 0.20)]
   231	VARIABLE_ROW_WEIGHTS = [("center", 0.68), ("full", 0.32)]
   232	OUTER_FIXUP_PROB = 0.7
   233	
   234	# --- CFG: variant scales ---
   235	SMALL_SCALE = 1
   236	BIG_SCALE = 2
   237	
   238	# --- CFG: generation retries ---
   239	MAX_RETRIES = 300
   240	
   241	_ROW_MASKS = {
   242	    "center": {3: [0, 1, 0], 4: [0, 1, 1, 0]},
   243	    "outer": {3: [1, 0, 1], 4: [1, 0, 0, 1]},
   244	    "full": {3: [1, 1, 1], 4: [1, 1, 1, 1]},
   245	}
   246	
   247	
   248	def _row_mask(kind: str, w: int) -> list[int]:
   249	    return list(_ROW_MASKS[kind][w])
   250	
   251	
   252	def _make_labels() -> np.ndarray:
   253	    """Build a connected label grid with anchor role 1 and two variable roles."""
   254	    h, w = random.choice(PROTO_SHAPES)
   255	
   256	    counts = {1: 1, 2: 1, 3: 1}
   257	    if h > 3:
   258	        counts[random.choice([1, 2, 3])] += h - 3
   259	
   260	    roles = []
   261	    for role in random.sample([1, 2, 3], 3):
   262	        roles.extend([role] * counts[role])
   263	
   264	    weights_by_role = {
   265	        1: ANCHOR_ROW_WEIGHTS,
   266	        2: VARIABLE_ROW_WEIGHTS,
   267	        3: VARIABLE_ROW_WEIGHTS,
   268	    }
   269	    masks = []
   270	    for role in roles:
   271	        kinds, wts = zip(*weights_by_role[role])
   272	        masks.append(_row_mask(random.choices(kinds, weights=wts)[0], w))
   273	
   274	    if not any(mask[0] or mask[-1] for mask in masks):
   275	        idx = random.randrange(h)
   276	        if roles[idx] == 1 and random.random() < OUTER_FIXUP_PROB:
   277	            masks[idx] = _row_mask("outer", w)
   278	        else:
   279	            masks[idx] = _row_mask("full", w)
   280	
   281	    if all(all(mask) for mask in masks):
   282	        masks[random.randrange(h)] = _row_mask("center", w)
   283	
   284	    labels = np.zeros((h, w), dtype=int)
   285	    for r, (role, mask) in enumerate(zip(roles, masks, strict=False)):
   286	        for c, bit in enumerate(mask):
   287	            if bit:
   288	                labels[r, c] = role
   289	
   290	    comps = components_mask(labels != 0, connectivity=8)
   291	    if len(comps) != 1:
   292	        return _make_labels()
   293	    return labels
   294	
   295	
   296	def _make_prototypes(bg: int) -> tuple[np.ndarray, np.ndarray]:
   297	    """Create proto_A and proto_B from one shared structural label grid."""
   298	    labels = _make_labels()
   299	    pool = [c for c in range(10) if c not in (bg, 1)]
   300	    a_cols = random.sample(pool, 2)
   301	    remaining = [c for c in pool if c not in a_cols]
   302	    if random.random() < COLOR_SHARE_PROB:
   303	        b_cols = [random.choice(a_cols), random.choice(remaining)]
   304	        random.shuffle(b_cols)
   305	    else:
   306	        b_cols = random.sample(remaining, 2)
   307	
   308	    def _colorize(lab: np.ndarray, cols: list[int]) -> np.ndarray:
   309	        proto = np.full(lab.shape, bg, dtype=int)
   310	        proto[lab == 1] = 1
   311	        proto[lab == 2] = cols[0]
   312	        proto[lab == 3] = cols[1]
   313	        return proto
   314	
   315	    return _colorize(labels, a_cols), _colorize(np.flipud(labels), b_cols)
