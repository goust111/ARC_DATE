    old = orig.main(inp)
    if not np.array_equal(out, old):
        diff_from_orig += 1
    s_in = slot_scales(inp)
    s_out = slot_scales(out)
    assert [p for p, _, _ in s_in] == [p for p, _, _ in s_out]
    changed = sum(1 for (_, sh0, sw0), (_, sh1, sw1) in zip(s_in, s_out) if (sh0, sw0) != (sh1, sw1))
    changed_slots.append(changed)

print('"'samples', samples)
print('diff_from_original', diff_from_orig)
print('changed_slot_counts', {k: changed_slots.count(k) for k in sorted(set(changed_slots))})
