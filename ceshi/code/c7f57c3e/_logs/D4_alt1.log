        print('  place union', (ur,uc), 'out', (out_r,out_c), 'in', (in_r,in_c))
        try:
            mod.paste(reserve, marker, ur, uc)
            mod.paste(out, output_patch, out_r, out_c, transparent=bg)
            mod.paste(inp, input_patch, in_r, in_c, transparent=bg)
        except Exception as e:
            print(' paste failed', e)
            ok = False
            break
    if not ok:
        continue
    try:
        got = mod.main(inp)
        eq = np.array_equal(got, out)
        print(' match', eq)
        if not eq:
            print(' bg', bg)
            print(' proto_a\\n', proto_a)
            print(' proto_b\\n', proto_b)
            print(' inp colors', sorted(set(inp.ravel().tolist())))
            print(' out colors', sorted(set(out.ravel().tolist())))
            break
    except Exception as e:
        print(' main exception', type(e).__name__, e)
        traceback.print_exc()
        break
