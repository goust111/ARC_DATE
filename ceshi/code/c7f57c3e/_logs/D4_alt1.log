+            pr0 *= scale
+            pc0 *= scale
+            top = (r0 + ar0) - pr0
+            left = (c0 + ac0) - pc0
+
+            ph, pw = sp.shape
+            rr0 = max(0, top)
+            cc0 = max(0, left)
+            rr1 = min(h, top + ph)
+            cc1 = min(w, left + pw)
+            if rr0 >= rr1 or cc0 >= cc1:
+                continue
+            sub_g = g[rr0:rr1, cc0:cc1]
+            sub_p = sp[(rr0 - top) : (rr1 - top), (cc0 - left) : (cc1 - left)]
+            m = sub_p != bg
+            score = int(np.sum(sub_g[m] == sub_p[m])) if np.any(m) else 0
+            if score > best_score:
+                best_score = score
