+def _colorize_frame(labels: np.ndarray, bg: int, frame_col: int, fill_col: int) -> np.ndarray:
+    proto = np.full(labels.shape, bg, dtype=int)
+    proto[labels == 1] = 1
+    proto[labels == 2] = frame_col
+    proto[labels == 3] = fill_col
+    return proto
