+# --------------- generator (output-first hollow-frame swap) ---------------
+
+# --- CFG: canvas ---
+GRID_SIZE_MIN = 21
+GRID_SIZE_MAX = 28
+GRID_MARGIN_FOR_SPRITES = 6
+
+# --- CFG: prototypes ---
+BG_CHOICES = [0, 2, 3, 4, 5, 6, 7, 8, 9]
+COLOR_SHARE_PROB = 0.45
+
+# --- CFG: sprite instances ---
+SPRITE_COUNTS = [3, 4]
+BIG_SCALES = [2, 3]
+
+# --- CFG: placement ---
+PLACEMENT_BORDER = 1
+PLACEMENT_PADDING = 2
+PLACEMENT_CONNECTIVITY = 8
+
+# --- CFG: generation retries ---
+MAX_RETRIES = 300
+
+# Role templates:
+#   0 = bg cavity
+#   1 = anchor spine
+#   2 = frame color
+#   3 = interior fill color
+FRAME_TEMPLATES = (
+    np.array(
+        [
+            [2, 1, 1, 1, 2],
+            [2, 0, 1, 0, 2],
+            [2, 0, 3, 0, 2],
+            [2, 0, 0, 0, 2],
+            [2, 2, 2, 2, 2],
+        ],
+        dtype=int,
+    ),
+    np.array(
+        [
+            [2, 1, 1, 1, 1, 2],
+            [2, 0, 0, 1, 0, 2],
+            [2, 0, 3, 3, 0, 2],
+            [2, 0, 0, 0, 0, 2],
+            [2, 2, 2, 2, 2, 2],
+        ],
+        dtype=int,
+    ),
+    np.array(
+        [
+            [2, 1, 1, 1, 2],
+            [2, 0, 1, 0, 2],
+            [2, 0, 3, 0, 2],
+            [2, 0, 3, 0, 2],
+            [2, 0, 0, 0, 2],
+            [2, 2, 2, 2, 2],
+        ],
+        dtype=int,
+    ),
+)
