+
+        p = protos[repl_idx]
+        sp = _scale_nn(p, scale)
+        panc = _pick_anchor_bbox(p, bg)
+        pr0, pc0, _pr1, _pc1 = panc
+        pr0 *= scale
+        pc0 *= scale
+        top = (r0 + ar0) - pr0
+        left = (c0 + ac0) - pc0
+
+        ph, pw = sp.shape
+        rr0 = max(0, top)
+        cc0 = max(0, left)
+        rr1 = min(h, top + ph)
+        cc1 = min(w, left + pw)
