# Change: 精灵数量不定，分为恰好两组，组间1:1或多:多配对... → 三组颜色模式三向交换

import random

import numpy as np

from arc_utils import bbox_coords, components_mask, get_bg, paste, random_free_location


# Design analysis
# ===============
# design_analysis:
#   source_task: none
#   concretization:
#     objects: |
#       画面里仍然只有若干互不接触的多色精灵，每个精灵都是某个小 prototype 的整数倍放大版。
