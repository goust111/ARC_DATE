+        for rr, cc in s["pts"]:
+            out[rr, cc] = bg
+
+        proto = protos[repl_idx]
+        sp = _scale_nn(proto, scale)
+        panc = _pick_anchor_bbox(proto, bg)
+        pr0, pc0, _pr1, _pc1 = panc
+        pr0 *= scale
+        pc0 *= scale
+        top = (r0 + ar0) - pr0
+        left = (c0 + ac0) - pc0
+
+        ph, pw = sp.shape
+        rr0 = max(0, top)
+        cc0 = max(0, left)
+        rr1 = min(h, top + ph)
+        cc1 = min(w, left + pw)
+        sub_p = sp[(rr0 - top) : (rr1 - top), (cc0 - left) : (cc1 - left)]
+        m = sub_p != bg
+        out_slice = out[rr0:rr1, cc0:cc1]
+        out_slice[m] = sub_p[m]
