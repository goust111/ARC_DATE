+        paste(inp, input_patch, ur + in_r0, uc + in_c0, transparent=bg)
+
+    try:
+        if np.array_equal(main(inp), out):
+            return inp
+    except Exception:
+        return None
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid c7f57c3e input")

