+    min_r = min(0, rel_r)
+    min_c = min(0, rel_c)
+    max_r = max(output_patch.shape[0], rel_r + input_patch.shape[0])
+    max_c = max(output_patch.shape[1], rel_c + input_patch.shape[1])
