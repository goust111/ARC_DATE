   177	            score = int(np.sum(sub_g[mask] == sub_p[mask])) if np.any(mask) else 0
   178	            if score > best_score:
   179	                best_score = score
   180	                best_idx = idx
   181	
   182	        records.append(
   183	            {
   184	                "pts": s["pts"],
   185	                "bbox": s["bbox"],
   186	                "anchor": anc,
   187	                "scale": scale,
   188	                "type_idx": best_idx,
   189	            }
   190	        )
   191	
   192	    target_scale = max(int(rec["scale"]) for rec in records)
   193	    out = g.copy()
   194	
   195	    for rec in records:
   196	        for rr, cc in rec["pts"]:
   197	            out[rr, cc] = bg
   198	
   199	    for rec in records:
   200	        r0, c0, _r1, _c1 = rec["bbox"]
   201	        ar0, ac0, _ar1, _ac1 = rec["anchor"]
   202	        repl = protos[1 - int(rec["type_idx"])]
   203	        sp = _scale_nn(repl, target_scale)
   204	        panc = _pick_anchor_bbox(repl, bg)
   205	        pr0 = panc[0] * target_scale
   206	        pc0 = panc[1] * target_scale
   207	        top = (r0 + ar0) - pr0
   208	        left = (c0 + ac0) - pc0
   209	
   210	        rr0 = max(0, top)
   211	        cc0 = max(0, left)
   212	        rr1 = min(h, top + sp.shape[0])
   213	        cc1 = min(w, left + sp.shape[1])
   214	        sub_p = sp[(rr0 - top) : (rr1 - top), (cc0 - left) : (cc1 - left)]
   215	        mask = sub_p != bg
   216	        out_slice = out[rr0:rr1, cc0:cc1]
   217	        out_slice[mask] = sub_p[mask]
   218	        out[rr0:rr1, cc0:cc1] = out_slice
   219	
   220	    return out
   221	
   222	
   223	# --------------- generator (o5x) ---------------
   224	
   225	# --- CFG: canvas ---
   226	GRID_SIZE_MIN = 18
   227	GRID_SIZE_MAX = 28
   228	GRID_MARGIN_FOR_SPRITES = 6
   229	
   230	# --- CFG: prototypes ---
   231	PROTO_SHAPES = [(4, 3), (3, 4), (4, 4)]
   232	BG_CHOICES = [0, 2, 3, 4, 5, 6, 7, 8, 9]
   233	COLOR_SHARE_PROB = 0.65
   234	
   235	# --- CFG: row-mask weights ---
   236	ANCHOR_ROW_WEIGHTS = [("center", 0.45), ("outer", 0.35), ("full", 0.20)]
   237	VARIABLE_ROW_WEIGHTS = [("center", 0.68), ("full", 0.32)]
