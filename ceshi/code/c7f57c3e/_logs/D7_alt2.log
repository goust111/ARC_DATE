+        proto = np.full(lab.shape, bg, dtype=int)
+        proto[lab == 1] = 1
+        proto[lab == 2] = cols[0]
+        proto[lab == 3] = cols[1]
+        return proto
+
+    return _colorize(labels, a_cols), _colorize(np.flipud(labels), b_cols)
+
+
+def _gen_attempt() -> np.ndarray | None:
+    bg = random.choice(BG_CHOICES)
+    proto_a, proto_b = _make_prototypes(bg)
