+            ur, uc = random_free_location(
+                reserve,
+                marker,
+                transparent=bg,
+                border=PLACEMENT_BORDER,
+                padding=PLACEMENT_PADDING,
+                padding_connectivity=PLACEMENT_CONNECTIVITY,
+            )
+        except ValueError:
