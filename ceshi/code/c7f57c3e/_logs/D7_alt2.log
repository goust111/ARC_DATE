+    ar0, ac0, ar1, ac1 = _pick_anchor_bbox(arr, bg)
+    inst_anc_h = ar1 - ar0 + 1
+    inst_anc_w = ac1 - ac0 + 1
+    scale_h = max(1, inst_anc_h // max(1, base_anchor_h))
+    scale_w = max(1, inst_anc_w // max(1, base_anchor_w))
+    scale = int(max(scale_h, scale_w))
