+        ar0, ac0, ar1, ac1 = anc
+        del r1, c1, ar1, ac1
+
+        best_idx = 0
+        best_score = -1
+        for idx, p in enumerate(protos):
+            sp = _scale_nn(p, scale)
+            panc = _pick_anchor_bbox(p, bg)
+            pr0 = panc[0] * scale
+            pc0 = panc[1] * scale
+            top = (r0 + ar0) - pr0
+            left = (c0 + ac0) - pc0
+
+            rr0 = max(0, top)
+            cc0 = max(0, left)
+            rr1 = min(h, top + sp.shape[0])
+            cc1 = min(w, left + sp.shape[1])
