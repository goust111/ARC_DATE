+    """Pick the bbox of the color-1 anchor region inside a sprite array."""
+    del bg
+    ys, xs = np.where(arr == 1)
+    assert ys.size > 0, "sprite array must contain color-1 anchor pixels"
+    return int(ys.min()), int(xs.min()), int(ys.max()), int(xs.max())
