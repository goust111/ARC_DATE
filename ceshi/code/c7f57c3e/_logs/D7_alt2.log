+    out_anchor = _pick_anchor_bbox(output_patch, bg=0)
+    in_anchor = _pick_anchor_bbox(input_patch, bg=0)
+    rel_r = out_anchor[0] - in_anchor[0]
+    rel_c = out_anchor[1] - in_anchor[1]
