+    out = np.zeros(arr.shape, dtype=int)
+    out[arr == 1] = 1
+    ordered = _ordered_variable_colors(arr, bg)
+    out[arr == ordered[0]] = 2
+    out[arr == ordered[1]] = 3
+    return out
