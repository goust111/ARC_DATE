print('shared_color_count_dist', dict(shared_color))
print('distinct_shape_pairs', len(shape_pair_keys))
print('shape_preserve_rate', f'{preserve_same}/{preserve_total} = {preserve_same/preserve_total:.3f}')
print('old_style_output_diff_grids', f'{old_style_diff}/{samples}')
if pixel_diffs:
    print('old_style_pixel_diff_range', min(pixel_diffs), max(pixel_diffs))
