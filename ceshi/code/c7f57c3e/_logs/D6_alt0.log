   104	def main(grid: np.ndarray) -> np.ndarray:
   105	    """
   106	    Repaint every sprite to the lower-anchor prototype while preserving scale and position.
   107	
   108	    Input structure:
   109	    - The background is the most common color. Two distinct sprite prototypes appear as
   110	      small scale-1 examples and as larger nearest-neighbor scaled copies.
   111	    - The prototypes share an internal color-1 anchor region, but one family places that
   112	      anchor higher in its bbox while the other places it lower.
   113	
   114	    Rule:
   115	    - Recover the two base prototypes from the smallest sprites and order them by anchor
   116	      height: upper-anchor family first, lower-anchor family second.
   117	    - For each sprite, infer its scale and align the lower-anchor prototype by the color-1
   118	      anchor box, then write that prototype at the same scale. Sprites already matching the
   119	      lower-anchor family therefore remain unchanged.
   120	
   121	    Key insight:
   122	    - The transform is no longer a symmetric toggle. All sprites converge to the same
   123	      destination family, and the visible anchor height inside the prototype tells which
   124	      family is the receiver and which family is the persistent donor.
   125	    """
   126	    g = np.asarray(grid, dtype=int)
   127	    h, w = g.shape
   128	    bg = get_bg(g)
   129	
   130	    comps = components_mask(g != bg, connectivity=8)
   131	    assert len(comps) >= 2, "grid must contain at least 2 sprite components"
   132	
   133	    sprites = []
   134	    for pts in comps:
   135	        r0, c0, r1, c1 = bbox_coords(pts)
   136	        arr = g[r0 : r1 + 1, c0 : c1 + 1].copy()
   137	        sprites.append({"pts": pts, "bbox": (r0, c0, r1, c1), "arr": arr})
   138	
   139	    areas = [int((s["bbox"][2] - s["bbox"][0] + 1) * (s["bbox"][3] - s["bbox"][1] + 1)) for s in sprites]
   140	    min_area = min(areas)
   141	    base = [s for s, a in zip(sprites, areas, strict=False) if a == min_area]
   142	    uniq: dict[tuple[int, ...], np.ndarray] = {}
   143	    for s in base:
   144	        key = tuple(s["arr"].ravel().tolist())
   145	        if key not in uniq:
   146	            uniq[key] = s["arr"]
   147	    assert len(uniq) == 2, "smallest-area sprites must yield exactly 2 distinct prototype patterns"
   148	
   149	    raw_protos = [uniq[key] for key in list(uniq.keys())[:2]]
   150	    protos, _ = _order_prototypes(raw_protos, bg)
   151	    receiver_proto, sender_proto = protos
   152	
   153	    rec_anc = _pick_anchor_bbox(receiver_proto, bg)
   154	    snd_anc = _pick_anchor_bbox(sender_proto, bg)
   155	    rec_anc_h = rec_anc[2] - rec_anc[0] + 1
   156	    rec_anc_w = rec_anc[3] - rec_anc[1] + 1
   157	    snd_anc_h = snd_anc[2] - snd_anc[0] + 1
   158	    snd_anc_w = snd_anc[3] - snd_anc[1] + 1
   159	    assert (rec_anc_h, rec_anc_w) == (snd_anc_h, snd_anc_w), "prototype anchors must share the same size"
   160	
   161	    out = g.copy()
   162	
   163	    for s in sprites:
   164	        r0, c0, r1, c1 = s["bbox"]
   165	        arr = s["arr"]
   166	        ar0, ac0, ar1, ac1 = _pick_anchor_bbox(arr, bg)
   167	        inst_anc_h = ar1 - ar0 + 1
   168	        inst_anc_w = ac1 - ac0 + 1
   169	        scale_h = max(1, inst_anc_h // max(1, rec_anc_h))
   170	        scale_w = max(1, inst_anc_w // max(1, rec_anc_w))
   171	        scale = int(max(scale_h, scale_w))
   172	
   173	        best_idx = 0
   174	        best_score = -1
