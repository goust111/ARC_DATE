   183	            score = 0
   184	            ph, pw = sp.shape
   185	            rr0 = max(0, top)
   186	            cc0 = max(0, left)
   187	            rr1 = min(h, top + ph)
   188	            cc1 = min(w, left + pw)
   189	            if rr0 >= rr1 or cc0 >= cc1:
   190	                continue
