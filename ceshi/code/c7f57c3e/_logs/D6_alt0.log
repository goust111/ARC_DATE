   209	        pr0 *= scale
   210	        pc0 *= scale
   211	        top = (r0 + ar0) - pr0
   212	        left = (c0 + ac0) - pc0
   213	
   214	        ph, pw = sp.shape
   215	        rr0 = max(0, top)
   216	        cc0 = max(0, left)
   217	        rr1 = min(h, top + ph)
