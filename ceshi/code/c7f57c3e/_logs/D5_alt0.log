   109	def _extract_sprites(g: np.ndarray, bg: int, guide_color: int) -> list[dict[str, object]]:
   110	    mask = (g != bg) & (g != guide_color)
   111	    comps = components_mask(mask, connectivity=8)
   112	    assert len(comps) >= 2, "grid must contain at least 2 sprite components"
   113	
   114	    sprites: list[dict[str, object]] = []
   115	    for pts in comps:
   116	        r0, c0, r1, c1 = bbox_coords(pts)
   117	        arr = g[r0 : r1 + 1, c0 : c1 + 1].copy()
   118	        arr[arr == guide_color] = bg
   119	        sprites.append({"pts": pts, "bbox": (r0, c0, r1, c1), "arr": arr})
   120	    return sprites
