+    for _ in range(200):
+        h, w = random.choice(PROTO_SHAPES)
+
+        counts = {1: 1, 2: 1, 3: 1}
+        if h > 3:
+            counts[random.choice([2, 3])] += h - 3
+
+        roles = []
+        for role in random.sample([1, 2, 3], 3):
+            roles.extend([role] * counts[role])
+
+        masks = []
+        for role in roles:
