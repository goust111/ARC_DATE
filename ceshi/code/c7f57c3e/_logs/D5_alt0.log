+            left = int(ac - pc0 * scale)
+            if top < 0 or left < 0 or top + h > n or left + w > n:
+                continue
+            box = _bbox_with_padding(top, left, patch, PLACEMENT_PADDING)
+            if any(_bbox_overlap(box, prev) for prev in used_boxes):
