        rr1, cc1 = r0 + h, c0 + w
        pr0, pc0 = 0, 0
    else:
        rr0 = max(0, r0)
        cc0 = max(0, c0)
        rr1 = min(H, r0 + h)
        cc1 = min(W, c0 + w)
