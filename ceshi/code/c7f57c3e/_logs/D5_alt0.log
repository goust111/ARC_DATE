+
+def _bbox_with_padding(r0: int, c0: int, patch: np.ndarray, pad: int) -> tuple[int, int, int, int]:
+    h, w = patch.shape
+    return int(r0 - pad), int(c0 - pad), int(r0 + h - 1 + pad), int(c0 + w - 1 + pad)
