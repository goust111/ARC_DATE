   160	def main(grid: np.ndarray) -> np.ndarray:
   161	    """
   162	    Swap every sprite to the opposite prototype and snap it onto the nearest guide anchor.
   163	
   164	    Input structure:
   165	    - bg = most common color. A separate guide color forms a sparse 3×3 lattice of single-pixel anchors.
   166	    - Two distinct small sprite patterns appear at integer scales, and each sprite contains color-1 anchor cells.
   167	    - Sprites sit near the guide lattice rather than exactly on it.
   168	
   169	    Rule:
   170	    - Recover the two scale-1 prototypes from the smallest sprites.
   171	    - For each sprite, identify its prototype class and scale from its local pattern.
   172	    - Replace it with the other prototype at the same scale, then move it so the sprite's color-1 anchor bbox top-left snaps to the nearest guide-lattice point.
   173	
   174	    Key insight: The swap rule is unchanged, but position is no longer inherited from the input sprite; the visible guide lattice supplies the destination geometry, so each replacement is relocated by nearest-anchor snapping.
   175	    """
   176	    g = np.asarray(grid, dtype=int)
   177	    h, w = g.shape
   178	    bg = get_bg(g)
   179	
   180	    guide_color, guide_rows, guide_cols = _detect_guide_lattice(g, bg)
   181	    sprites = _extract_sprites(g, bg, guide_color)
   182	    protos = _prototype_pair(sprites)
   183	
   184	    out = g.copy()
   185	
   186	    for s in sprites:
   187	        bbox = s["bbox"]
   188	        arr = s["arr"]
   189	        assert isinstance(bbox, tuple)
   190	        assert isinstance(arr, np.ndarray)
   191	        r0, c0, _r1, _c1 = bbox
   192	
   193	        proto_idx, scale = _classify_sprite(arr, protos, bg)
   194	        repl_idx = 1 - proto_idx
   195	
   196	        anc = _pick_anchor_bbox(arr, bg)
   197	        ar0, ac0, _ar1, _ac1 = anc
   198	        src_anchor_r = int(r0 + ar0)
   199	        src_anchor_c = int(c0 + ac0)
   200	        dst_anchor_r = _nearest_value(guide_rows, src_anchor_r)
   201	        dst_anchor_c = _nearest_value(guide_cols, src_anchor_c)
   202	
   203	        for rr, cc in s["pts"]:
   204	            out[int(rr), int(cc)] = bg
   205	
   206	        repl = _scale_nn(protos[repl_idx], scale)
   207	        pr0, pc0, _pr1, _pc1 = _pick_anchor_bbox(protos[repl_idx], bg)
   208	        top = int(dst_anchor_r - pr0 * scale)
   209	        left = int(dst_anchor_c - pc0 * scale)
   210	        assert 0 <= top and 0 <= left and top + repl.shape[0] <= h and left + repl.shape[1] <= w
   211	        paste(out, repl, top, left, transparent=bg)
   212	
   213	    return out
