   123	def _prototype_pair(sprites: list[dict[str, object]]) -> list[np.ndarray]:
   124	    areas = [
   125	        int((s["bbox"][2] - s["bbox"][0] + 1) * (s["bbox"][3] - s["bbox"][1] + 1))
   126	        for s in sprites
   127	    ]
   128	    min_area = min(areas)
   129	    base = [s for s, a in zip(sprites, areas, strict=False) if a == min_area]
   130	    uniq: dict[tuple[int, ...], np.ndarray] = {}
   131	    for s in base:
   132	        arr = s["arr"]
   133	        assert isinstance(arr, np.ndarray)
   134	        key = tuple(arr.ravel().tolist())
   135	        if key not in uniq:
   136	            uniq[key] = arr
   137	    assert len(uniq) == 2, "smallest-area sprites must yield exactly 2 distinct prototypes"
   138	    proto_keys = list(uniq.keys())[:2]
   139	    return [uniq[proto_keys[0]], uniq[proto_keys[1]]]
