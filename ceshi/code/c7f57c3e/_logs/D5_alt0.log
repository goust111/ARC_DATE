            slots = mod._candidate_anchor_slots(guide_rows, guide_cols, output_patch, scale, n, output_boxes)
            if not slots:
                stage = 'no_output_slots'; raise RuntimeError
            ar, ac, out_r, out_c = slots[0]
            output_boxes.append(mod._bbox_with_padding(out_r, out_c, output_patch, mod.PLACEMENT_PADDING))
            chosen.append({'out_type': int(out_type), 'scale': int(scale), 'anchor': (int(ar), int(ac))})
        stage = 'input_slots'
        input_boxes = []
        covered = set()
        guide_points = [(r, c) for r in guide_rows for c in guide_cols]
        for rec in chosen:
            out_type = int(rec['out_type'])
            scale = int(rec['scale'])
            ar, ac = rec['anchor']
            input_patch = mod._scale(protos[1 - out_type], scale)
            ir0, ic0, *_ = mod._anchor_bbox(input_patch)
            placed = False
            for dr, dc in mod.INPUT_ANCHOR_OFFSETS:
                in_anchor_r = ar + dr
                in_anchor_c = ac + dc
                if mod._nearest_value(guide_rows, in_anchor_r) "'!= ar or mod._nearest_value(guide_cols, in_anchor_c) != ac:
                    continue
                top = in_anchor_r - ir0 * scale
                left = in_anchor_c - ic0 * scale
                if top < 0 or left < 0 or top + input_patch.shape[0] > n or left + input_patch.shape[1] > n:
                    continue
                box = mod._bbox_with_padding(top, left, input_patch, mod.PLACEMENT_PADDING)
                if any(mod._bbox_overlap(box, prev) for prev in input_boxes):
                    continue
                tentative = covered | mod._covered_guides(input_patch, top, left, guide_points)
                if not mod._visible_guide_ok(tentative, guide_rows, guide_cols):
                    continue
                input_boxes.append(box)
                covered = tentative
                placed = True
                break
            if not placed:
                stage = '"'no_input_slot'; raise RuntimeError
        stage = 'success'
    except Exception:
        pass
    stats[stage] = stats.get(stage, 0) + 1
print(stats)
