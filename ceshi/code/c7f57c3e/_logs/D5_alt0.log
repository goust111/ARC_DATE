   142	def _classify_sprite(arr: np.ndarray, protos: list[np.ndarray], bg: int) -> tuple[int, int]:
   143	    base_h, base_w = protos[0].shape
   144	    h, w = arr.shape
   145	    assert h % base_h == 0 and w % base_w == 0, "sprite must be an integer scale of prototype bbox"
   146	    scale_h = h // base_h
   147	    scale_w = w // base_w
   148	    assert scale_h == scale_w and scale_h >= 1, "non-uniform scale is unsupported"
   149	    scale = int(scale_h)
