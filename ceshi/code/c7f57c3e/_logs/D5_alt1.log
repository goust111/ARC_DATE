    10	
    11	
    12	# ---------------------------------------------------------------------------
    13	# Design analysis for the D5 variant
    14	#
    15	# variant_spec:
    16	#   core_change:
    17	#     old_dst: each swapped sprite stays near its original location via anchor alignment
    18	#     new_dst: all swapped sprites are moved into one shared vertical strip and stacked
    19	#              from top to bottom, in input reading order (top-to-bottom, then left-to-right)
    20	#   preserved_parts:
