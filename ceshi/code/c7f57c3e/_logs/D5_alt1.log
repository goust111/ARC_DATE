+OUTER_FIXUP_PROB = 0.7
+
+# --- CFG: sprite instances ---
+SPRITE_COUNTS = [3, 4]
+BIG_SCALES = [2, 3]
+
+# --- CFG: placement ---
+PLACEMENT_BORDER = 1
+PLACEMENT_PADDING = 2
+PLACEMENT_CONNECTIVITY = 8
+INPUT_STACK_STRIP_BUFFER = 1
+
+# --- CFG: generation retries ---
