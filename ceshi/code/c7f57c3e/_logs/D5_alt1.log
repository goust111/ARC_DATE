+
+def _build_stacked_output(
+    shape: tuple[int, int],
+    bg: int,
+    ordered_patches: list[np.ndarray],
+) -> np.ndarray:
+    out = np.full(shape, bg, dtype=int)
+    r = 0
+    for i, patch in enumerate(ordered_patches):
+        paste(out, patch, r, STACK_COL, transparent=bg)
