    94	
    95	
    96	STACK_GAP = 1
    97	STACK_COL = 1
    98	
    99	# --------------- shared helpers ---------------
   100	
   101	
   102	def _pick_anchor_bbox(arr: np.ndarray, bg: int) -> tuple[int, int, int, int]:
   103	    """Pick a stable anchor bbox inside the sprite array (color-1 pixels; always present)."""
   104	    if np.any(arr == 1):
   105	        ys, xs = np.where(arr == 1)
   106	        return int(ys.min()), int(xs.min()), int(ys.max()), int(xs.max())
   107	    assert False, "sprite array has no color-1 pixels and should always have them"
   108	
   109	
   110	def _scale_nn(arr: np.ndarray, scale: int) -> np.ndarray:
   111	    if scale <= 1:
   112	        return arr.copy()
   113	    return np.repeat(np.repeat(arr, scale, axis=0), scale, axis=1)
   114	
   115	
   116	def _stack_required_height(patches: list[np.ndarray]) -> int:
   117	    total = sum(int(p.shape[0]) for p in patches)
   118	    if len(patches) >= 2:
   119	        total += STACK_GAP * (len(patches) - 1)
   120	    return total
   121	
   122	
   123	def _build_stacked_output(
   124	    shape: tuple[int, int],
   125	    bg: int,
   126	    ordered_patches: list[np.ndarray],
   127	) -> np.ndarray:
   128	    out = np.full(shape, bg, dtype=int)
   129	    r = 0
   130	    for i, patch in enumerate(ordered_patches):
   131	        paste(out, patch, r, STACK_COL, transparent=bg)
   132	        r += int(patch.shape[0])
   133	        if i + 1 < len(ordered_patches):
   134	            r += STACK_GAP
   135	    return out
   136	
   137	
   138	def main(grid: np.ndarray) -> np.ndarray:
   139	    """
   140	    Swap every sprite to the opposite prototype, then stack all swapped sprites into one shared strip.
   141	
   142	    Input structure:
   143	    - bg = most common color. Two distinct small sprite patterns (prototypes) appear at various scales.
   144	    - Each sprite instance is a scaled copy of one of the two prototypes, scattered on the grid.
   145	
   146	    Rule:
   147	    - Identify the two prototype patterns from the smallest-area sprites.
   148	    - For each sprite, determine which prototype it matches and its integer scale factor.
   149	    - Replace it with the other prototype at the same scale, then discard the old layout and stack
   150	      all replacements from top to bottom in reading order inside a common left-side area.
   151	
   152	    Key insight: Prototype recognition is the same as the original task; the variant only changes
   153	    the destination policy, turning a local swap into a global re-layout in one shared stack zone.
   154	    """
   155	    g = np.asarray(grid, dtype=int)
   156	    h, w = g.shape
   157	    bg = get_bg(g)
   158	
   159	    comps = components_mask(g != bg, connectivity=8)
   160	    assert len(comps) >= 2, "grid must contain at least 2 sprite components"
   161	
   162	    sprites = []
   163	    for pts in comps:
   164	        r0, c0, r1, c1 = bbox_coords(pts)
   165	        arr = g[r0 : r1 + 1, c0 : c1 + 1].copy()
   166	        sprites.append({"pts": pts, "bbox": (r0, c0, r1, c1), "arr": arr})
   167	
   168	    areas = [int((s["bbox"][2] - s["bbox"][0] + 1) * (s["bbox"][3] - s["bbox"][1] + 1)) for s in sprites]
   169	    min_area = min(areas)
   170	    base = [s for s, a in zip(sprites, areas, strict=False) if a == min_area]
   171	    uniq: dict[tuple[int, ...], np.ndarray] = {}
   172	    for s in base:
   173	        key = tuple(s["arr"].ravel().tolist())
   174	        if key not in uniq:
   175	            uniq[key] = s["arr"]
   176	    assert len(uniq) == 2, "smallest-area sprites must yield exactly 2 distinct prototype patterns"
   177	
   178	    proto_keys = list(uniq.keys())[:2]
   179	    protos = [uniq[proto_keys[0]], uniq[proto_keys[1]]]
   180	
   181	    anc0 = _pick_anchor_bbox(protos[0], bg)
   182	    a0r0, a0c0, a0r1, a0c1 = anc0
   183	    base_anc_h = a0r1 - a0r0 + 1
   184	    base_anc_w = a0c1 - a0c0 + 1
   185	
   186	    ordered = []
   187	    swapped_patches = []
   188	
   189	    for s in sprites:
   190	        r0, c0, _r1, _c1 = s["bbox"]
   191	        arr = s["arr"]
   192	        anc = _pick_anchor_bbox(arr, bg)
   193	        ar0, ac0, ar1, ac1 = anc
   194	        inst_anc_h = ar1 - ar0 + 1
   195	        inst_anc_w = ac1 - ac0 + 1
   196	        scale_h = max(1, inst_anc_h // max(1, base_anc_h))
   197	        scale_w = max(1, inst_anc_w // max(1, base_anc_w))
   198	        scale = int(max(scale_h, scale_w))
   199	
   200	        best_idx = 0
   201	        best_score = -1
   202	        for idx, p in enumerate(protos):
   203	            sp = _scale_nn(p, scale)
   204	            panc = _pick_anchor_bbox(p, bg)
   205	            pr0, pc0, _pr1, _pc1 = panc
   206	            pr0 *= scale
   207	            pc0 *= scale
   208	            top = (r0 + ar0) - pr0
   209	            left = (c0 + ac0) - pc0
   210	
   211	            score = 0
   212	            ph, pw = sp.shape
   213	            rr0 = max(0, top)
   214	            cc0 = max(0, left)
   215	            rr1 = min(h, top + ph)
   216	            cc1 = min(w, left + pw)
   217	            if rr0 >= rr1 or cc0 >= cc1:
   218	                continue
   219	            sub_g = g[rr0:rr1, cc0:cc1]
   220	            sub_p = sp[(rr0 - top) : (rr1 - top), (cc0 - left) : (cc1 - left)]
   221	            m = sub_p != bg
   222	            if np.any(m):
   223	                score = int(np.sum(sub_g[m] == sub_p[m]))
   224	            if score > best_score:
   225	                best_score = score
   226	                best_idx = idx
   227	
   228	        repl_idx = 1 - best_idx
   229	        swapped = _scale_nn(protos[repl_idx], scale)
   230	        ordered.append((int(r0), int(c0), swapped))
   231	        swapped_patches.append(swapped)
   232	
   233	    ordered.sort(key=lambda item: (item[0], item[1]))
   234	    stack_h = _stack_required_height([patch for _, _, patch in ordered])
   235	    max_w = max(int(p.shape[1]) for p in swapped_patches)
   236	    assert stack_h <= h, "stacked output must fit vertically"
   237	    assert STACK_COL + max_w <= w, "stacked output must fit horizontally"
   238	
   239	    return _build_stacked_output((h, w), bg, [patch for _, _, patch in ordered])
