+# --- CFG: placement ---
+PLACEMENT_BORDER = 1
+PLACEMENT_PADDING = 2
+PLACEMENT_CONNECTIVITY = 8
+INPUT_STACK_STRIP_BUFFER = 1
+
+# --- CFG: generation retries ---
+MAX_RETRIES = 400
