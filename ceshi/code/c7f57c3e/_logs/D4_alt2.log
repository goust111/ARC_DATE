   205	
   206	def _build_base_swap_catalog(sprites: list[dict], bg: int) -> tuple[list[np.ndarray], list[np.ndarray], list[int]]:
   207	    areas = [int(s["arr"].shape[0] * s["arr"].shape[1]) for s in sprites]
   208	    min_area = min(areas)
   209	    base = [s for s, area in zip(sprites, areas, strict=False) if area == min_area]
   210	    uniq: dict[tuple[int, ...], np.ndarray] = {}
   211	    for s in base:
