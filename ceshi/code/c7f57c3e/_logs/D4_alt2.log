    73	#     anchor-based offset placement assumed replacement and source might have different
    74	#     occupied extents; in this variant the outer shell is preserved, so bbox alignment
    75	#     is exact and offsets should stay zero
    76	#   original_main_dependency_4:
    77	#     smallest-area sprites are still useful, but now they serve as exemplars for
    78	#     "outer border color + owned inner prototype", not as complete replacement targets
    79	#
    80	# placement_legality:
    81	#   generator uses output-first construction with same-bbox input/output patches
    82	#   because swapping only the interior never changes sprite extents
    83	#   each scaled 5x5 sprite is placed with:
    84	#     border >= 1 from canvas edge
    85	#     bbox gap >= 2 between objects
