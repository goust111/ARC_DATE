   121	
   122	# --- CFG: canvas ---
   123	GRID_SIZE_MIN = 18
   124	GRID_SIZE_MAX = 28
   125	GRID_MARGIN_FOR_SPRITES = 8
   126	
   127	# --- CFG: colors ---
