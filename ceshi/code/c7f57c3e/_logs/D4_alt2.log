    87	#
    88	# observability_and_cleanliness:
    89	#   visible cue:
    90	#     outer border colors stay fixed while the contained mini-patterns trade places
    91	#   readability:
    92	#     the solid ring separates each object from the background and frames the change
    93	#   anti-degeneration:
