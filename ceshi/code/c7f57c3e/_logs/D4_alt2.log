   144	        [
   145	            [1, 2, 0],
   146	            [1, 2, 3],
   147	            [0, 0, 3],
   148	        ],
   149	        dtype=int,
   150	    ),
   151	    np.array(
   152	        [
   153	            [0, 1, 2],
   154	            [3, 1, 2],
   155	            [3, 0, 0],
   156	        ],
   157	        dtype=int,
   158	    ),
   159	    np.array(
   160	        [
   161	            [2, 1, 0],
   162	            [0, 1, 3],
   163	            [0, 3, 3],
   164	        ],
   165	        dtype=int,
   166	    ),
   167	]
   168	
   169	
   170	def _scale_nn(arr: np.ndarray, scale: int) -> np.ndarray:
   171	    if scale <= 1:
   172	        return arr.copy()
   173	    return np.repeat(np.repeat(arr, scale, axis=0), scale, axis=1)
   174	
   175	
   176	def _make_nested_sprite(bg: int, outer_color: int, inner_arr: np.ndarray) -> np.ndarray:
   177	    arr = np.full(BASE_SHAPE, bg, dtype=int)
   178	    arr[0, :] = outer_color
   179	    arr[-1, :] = outer_color
   180	    arr[:, 0] = outer_color
   181	    arr[:, -1] = outer_color
   182	    arr[INNER_SLICE] = inner_arr
   183	    return arr
