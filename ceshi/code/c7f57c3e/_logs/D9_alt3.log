        ok += 1
    except Exception as e:
        fail += 1
        if fail <= 3: print(f'Trial {i}: {e}')
elapsed = time.time() - t0
print(f'Success: {ok}/50, Time: {elapsed:.1f}s ({elapsed/50*1000:.0f}ms/call)')
if ok < 40: sys.exit(1)
