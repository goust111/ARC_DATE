+        return arr.copy()
+    h, w = arr.shape
+    assert h % scale == 0 and w % scale == 0, "sprite size is not divisible by scale"
+    base = arr[::scale, ::scale].copy()
+    assert np.array_equal(_scale_nn(base, scale), arr), "sprite is not an exact NN-scaled copy"
+    return base
+
