+# --------------- generator (D10 variant) ---------------
+
+# --- CFG: canvas ---
+GRID_SIZE_MIN = 18
+GRID_SIZE_MAX = 28
+GRID_MARGIN_FOR_SPRITES = 6
+
+# --- CFG: prototypes / palette ---
