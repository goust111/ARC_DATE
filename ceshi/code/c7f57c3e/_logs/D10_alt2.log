+    base_anc_h = ba_r1 - ba_r0 + 1
+    base_anc_w = ba_c1 - ba_c0 + 1
+
+    for sprite in sprites:
+        arr = sprite["arr"]
+        sh, sw = arr.shape
+        assert sh % base_h == 0 and sw % base_w == 0, "sprite bbox is not a scaled copy of base shape"
