+    """Recover the unscaled sprite and verify the instance is an exact NN enlargement."""
+    if scale <= 1:
+        return arr.copy()
+    h, w = arr.shape
+    assert h % scale == 0 and w % scale == 0, "sprite size is not divisible by scale"
