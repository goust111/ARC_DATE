+
+# --- CFG: canvas ---
+GRID_SIZE_MIN = 18
+GRID_SIZE_MAX = 28
+GRID_MARGIN_FOR_SPRITES = 6
+
+# --- CFG: prototypes ---
+BG_CHOICES = [0, 4, 5, 6, 7, 8, 9]
