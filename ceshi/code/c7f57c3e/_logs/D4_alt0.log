+    """Return the bbox of the monochrome sprite body (color 1), which is the placement anchor."""
+    if np.any(arr == BODY_COLOR):
+        ys, xs = np.where(arr == BODY_COLOR)
+        return int(ys.min()), int(xs.min()), int(ys.max()), int(xs.max())
