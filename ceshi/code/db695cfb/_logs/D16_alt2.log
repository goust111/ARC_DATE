+                    expected[r, c] = _TRIGGER_COLOR
+                r += ddr
+                c += ddc
+    return expected
+
+
+def _try_place_segment(slope_type, seg_len, H, W, occupied, drawn, line_positions):
+    for _ in range(_SEGMENT_PLACE_RETRIES):
