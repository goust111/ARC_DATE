+_DISTRACTOR_RETRIES = 50
+_GEN_RETRIES = 300
+
+
+def _assign_trigger_dirs(
+    trigger_positions: list[tuple[int, int]], path: list[tuple[int, int]], dc: int
+) -> list[tuple[tuple[int, int], tuple[int, int]]]:
