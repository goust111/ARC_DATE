+# === CFG: canvas and structural bounds ===
+_H_RANGE = (8, 25)
+_W_RANGE = (9, 21)
+_LINE_COLOR = 1
+_TRIGGER_COLOR = 6
+_SELECTOR_COLOR = 2
+_SEGMENT_COUNT = (1, 4)
+_SQUARE_DIAG_RANGE = (4, 16)   # even corner-to-corner diagonal length
+_TRIGGERS_PER_SEG = (0, 2)
