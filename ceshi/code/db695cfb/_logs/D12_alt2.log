+# === CFG: distractor counts ===
+_UNPAIRED_LINE_PIXELS = (0, 2)
+_OFF_DIAG_TRIGGERS = (0, 3)
+
+# === CFG: retry limits ===
+_SEGMENT_PLACE_RETRIES = 120
+_DISTRACTOR_RETRIES = 60
+_GEN_RETRIES = 400
