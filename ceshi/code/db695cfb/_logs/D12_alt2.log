+            continue
+
+        path = diag_path_from_square(tl, br, slope)
+        segments.append((tl, br, slope, path))
+        used_endpoints.add(tl)
+        used_endpoints.add(br)
+
+    triggers: dict[tuple[int, int, int], set[tuple[int, int]]] = {}
+
