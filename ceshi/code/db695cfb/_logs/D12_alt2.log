+        cr, cc = center
+        out_neighbors = []
+        for pos in ((cr - 1, cc), (cr + 1, cc)):
+            if 0 <= pos[0] < h and 0 <= pos[1] < w:
+                out_neighbors.append((pos, "backslash"))
+        for pos in ((cr, cc - 1), (cr, cc + 1)):
+            if 0 <= pos[0] < h and 0 <= pos[1] < w:
+                out_neighbors.append((pos, "slash"))
+        return out_neighbors
