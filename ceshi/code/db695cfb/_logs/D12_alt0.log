   187	_OFF_DIAG_TRIGGERS = (0, 4)         # magenta distractors off every active diagonal
   188	
   189	# === CFG: retry limits ===
   190	_SEGMENT_PLACE_RETRIES = 80
   191	_DISTRACTOR_RETRIES = 50
   192	_GEN_RETRIES = 300
   193	
   194	
