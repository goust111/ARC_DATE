+_W_RANGE = (9, 21)
+_LINE_COLOR = 1
+_TRIGGER_COLOR = 6
+_SEGMENT_COUNT = (1, 4)
+_SEG_LEN_RANGE = (3, 16)
+_TRIGGERS_PER_SEG = (0, 2)
+
+# === CFG: distractor counts ===
