+        path = diag_path(p, q)
+        dr = 1 if q[0] > p[0] else -1
+        dc = 1 if q[1] > p[1] else -1
+        perp_dirs = [(dr, -dc), (-dr, dc)]
+        for r, c in path:
+            v = int(out[r, c])
+            if v == bg:
+                out[r, c] = line_color
+            elif v != line_color:
