+        inp[ep0] = _LINE_COLOR
+        inp[ep1] = _LINE_COLOR
+        for tr, tc, emit_up, emit_down in trigger_specs:
+            inp[tr, tc] = _TRIGGER_COLOR
+            if emit_up:
+                inp[tr - 1, tc] = _UP_MARKER_COLOR
+            if emit_down:
