+
+def _compute_ray_cells_for_dirs(
+    start: tuple[int, int],
+    dirs: list[tuple[int, int]],
+    H: int,
+    W: int,
+) -> set[tuple[int, int]]:
+    cells = set()
+    tr, tc = start
+    for ddr, ddc in dirs:
+        r, c = tr + ddr, tc + ddc
+        while 0 <= r < H and 0 <= c < W:
+            cells.add((r, c))
+            r += ddr
+            c += ddc
