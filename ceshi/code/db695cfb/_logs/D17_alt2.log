            marker_specs = _marker_specs(tr, tc, emit_up, emit_down)
            marker_cells = {(mr, mc) for mr, mc, _ in marker_specs}
            if any(not (0 <= mr < H and 0 <= mc < W) for mr, mc, _ in marker_specs):
