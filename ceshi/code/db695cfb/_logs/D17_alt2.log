+# --------------- generator (c) ---------------
+
+# === CFG: canvas and structural bounds ===
+_H_RANGE = (8, 25)
+_W_RANGE = (9, 21)
+_SEGMENT_COUNT = (1, 4)
+_SEG_LEN_RANGE = (3, 16)
+_TRIGGERS_PER_SEG = (0, 2)
+
+# === CFG: distractor counts ===
+_UNPAIRED_LINE_PIXELS = (0, 2)
+_OFF_DIAG_TRIGGERS = (0, 3)
+
+# === CFG: retry limits ===
+_SEGMENT_PLACE_RETRIES = 80
+_DISTRACTOR_RETRIES = 50
+_GEN_RETRIES = 300
