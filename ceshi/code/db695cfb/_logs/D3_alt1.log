+            draw_segment(g[0], g[-1])
+
+    for g in groups_b.values():
+        if len(g) >= 2:
+            g = sorted(g)
+            draw_segment(g[0], g[-1])
+
+    for (r0, c0, tcol), dir_lengths in triggers.items():
+        for (ddr, ddc), ray_len in dir_lengths.items():
+            for step in range(1, ray_len + 1):
+                r = r0 + step * ddr
+                c = c0 + step * ddc
+                if not (0 <= r < h and 0 <= c < w):
+                    break
+                if int(out[r, c]) == bg:
