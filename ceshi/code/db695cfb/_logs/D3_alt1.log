+def _trace_fixed_ray(
+    start: tuple[int, int], direction: tuple[int, int], ray_len: int, H: int, W: int
+) -> tuple[list[tuple[int, int]], tuple[int, int]] | None:
+    r0, c0 = start
+    ddr, ddc = direction
+    cells = []
