+            r += ddr
+            c += ddc
+    return cells, trigger_dirs, trigger_sides
+
+
+def _build_expected(inp, bg, segments):
+    """Build the expected output grid by filling diagonals and emitting one-sided rays."""
+    H, W = inp.shape
+    expected = inp.copy()
