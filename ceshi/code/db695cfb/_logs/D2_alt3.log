+
+def _single_perp_dir_from_dc(dc: int, r: int, c: int) -> tuple[int, int] | None:
+    """Generator helper: dc is the segment's column step while row step is +1."""
+    side = _side_of_main_diagonal(r, c)
+    if side == 0:
+        return None
+    if side > 0:
+        return -1, dc
+    return 1, -dc
