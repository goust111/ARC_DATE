+def _side_of_main_diagonal(r: int, c: int) -> int:
+    """Return +1 for c>r (above r=c), -1 for c<r (below), 0 on the diagonal."""
+    if c > r:
+        return 1
+    if c < r:
+        return -1
+    return 0
+
+
+def _single_perp_dir_from_segment(dr: int, dc: int, r: int, c: int) -> tuple[int, int] | None:
+    """
