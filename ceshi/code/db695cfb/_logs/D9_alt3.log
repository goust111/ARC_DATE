+_H_RANGE = (8, 25)
+_W_RANGE = (9, 21)
+_SEG_LEN_RANGE = (3, 16)
+_TRIGGERS_PER_CORE_SEG = (1, 2)
+
+# === CFG: distractor counts ===
+_UNPAIRED_LINE_PIXELS = (0, 2)
+_OFF_DIAG_TRIGGERS = (0, 3)
+
+# === CFG: retry limits ===
+_LAYOUT_RETRIES = 120
+_DISTRACTOR_RETRIES = 60
