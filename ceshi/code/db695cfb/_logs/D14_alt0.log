+    except Exception:
+        return None
+
+    expected = _render_from_segments(inp, bg, segments)
+    if np.array_equal(result, expected) and np.any(expected == _CROSS_COLOR):
+        return inp
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(_GEN_RETRIES):
+        result = _gen_attempt()
+        if result is not None:
+            return result
