+def _shares_diagonal(cell: tuple[int, int], positions: list[tuple[int, int]] | set[tuple[int, int]]) -> bool:
+    r, c = cell
+    for rr, cc in positions:
+        if r != rr and abs(r - rr) == abs(c - cc):
+            return True
+    return False
