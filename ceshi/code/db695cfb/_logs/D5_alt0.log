+def _build_expected(
+    inp: np.ndarray,
+    bg: int,
+    segments: list[tuple[tuple[int, int], tuple[int, int], list[tuple[int, int]], list[tuple[int, int]], tuple[tuple[int, int], tuple[int, int]]]],
