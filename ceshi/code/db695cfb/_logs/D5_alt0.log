+_W_RANGE = (9, 21)
+_SEGMENT_COUNT = (1, 3)
+_SEG_LEN_RANGE = (3, 16)
+_TRIGGERS_PER_SEG = (1, 3)
+
+# === CFG: distractor counts ===
+_UNPAIRED_LINE_PIXELS = (0, 2)
+_OFF_DIAG_TRIGGERS = (0, 3)
+
