+    """Return all cells touched by the rays, excluding the trigger cells."""
+    cells: set[tuple[int, int]] = set()
+    for tr, tc in trigger_positions:
+        for ddr, ddc in perp_dirs:
+            r, c = tr + ddr, tc + ddc
+            while 0 <= r < height and 0 <= c < width:
