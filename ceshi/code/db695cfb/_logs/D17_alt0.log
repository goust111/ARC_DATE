+def _diag_path(p: tuple[int, int], q: tuple[int, int]) -> list[tuple[int, int]]:
+    r0, c0 = p
+    r1, c1 = q
+    dr = 1 if r1 > r0 else -1
+    dc = 1 if c1 > c0 else -1
+    steps = abs(r1 - r0)
+    return [(r0 + k * dr, c0 + k * dc) for k in range(steps + 1)]
