+                        expected[r, c] = tcol
+                    r += ddr
+                    c += ddc
+    return expected
+
+
+def _try_place_segment(
+    slope_type: str,
+    seg_len: int,
+    H: int,
+    W: int,
+    occupied: set[tuple[int, int]],
+    drawn: set[tuple[int, int]],
+) -> tuple[list[tuple[int, int]], int] | None:
+    for _ in range(_SEGMENT_PLACE_RETRIES):
