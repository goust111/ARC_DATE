+# --------------- generator (c) ---------------
+
+_H_RANGE = (10, 25)
+_W_RANGE = (12, 21)
+_SEGMENT_COUNT = (1, 4)
+_SEG_LEN_RANGE = (3, 16)
+_TRIGGERS_PER_SEG = (1, 3)
+_RULE_COUNT = (2, 3)
+
+_UNPAIRED_LINE_PIXELS = (0, 2)
+_OFF_DIAG_TRIGGERS = (0, 4)
