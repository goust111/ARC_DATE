+
+
+def _build_expected(inp: np.ndarray, active_bg: int, stripe_colors: tuple[int, int], stripe_phase: int, segments) -> np.ndarray:
+    H, W = inp.shape
+    expected = inp.copy()
+    for _, _, trigger_positions, path, perp_dirs in segments:
