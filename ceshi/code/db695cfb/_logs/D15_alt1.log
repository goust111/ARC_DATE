import importlib.util
import numpy as np
from collections import Counter

path='/home/lixinyu/snap/new/ceshi/code/db695cfb/D15/1/code.py'
spec=importlib.util.spec_from_file_location('variant', path)
mod=importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)


def top_two_colors(grid):
    counts=Counter(map(int, grid.flatten()))
    top=counts.most_common(2)
    return int(top[0][0]), int(top[1][0])


def column_bg_colors(grid, bg_colors):
    h,w=grid.shape
    out=[]
    for c in range(w):
        counts={bg:0 for bg in bg_colors}
        for r in range(h):
            v=int(grid[r,c])
            if v in bg_colors:
                counts[v]+=1
        out.append(max(counts, key=counts.get))
    return out


def baseline_without_stripe_constraint(grid):
    grid=np.asarray(grid, dtype=int)
    h,w=grid.shape
    out=grid.copy()
    bg0,bg1=top_two_colors(grid)
