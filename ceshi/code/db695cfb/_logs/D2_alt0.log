+
+def _build_expected(inp: np.ndarray, bg: int, segments) -> np.ndarray:
+    """Build the expected output grid using same-slope trigger extensions."""
+    H, W = inp.shape
+    expected = inp.copy()
+    for _, _, trigger_positions, path, ray_dirs in segments:
