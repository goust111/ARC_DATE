+    grid = np.zeros((size, size), dtype=int)
+    offsets = np.arange(1, arm + 1)
+    grid[cr - offsets, cc] = CROSS_COLOR
+    grid[cr + offsets, cc] = CROSS_COLOR
+    grid[cr, cc - offsets] = CROSS_COLOR
+    grid[cr, cc + offsets] = CROSS_COLOR
+    return grid
