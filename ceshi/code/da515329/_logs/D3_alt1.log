+    if not even_center:
+        rp = 1 - (cr % 2)
+        cp = 1 - (cc % 2)
+        rr, ccg = np.indices((h, w))
+        occ[(rr % 2 == rp) & (ccg % 2 == cp)] = False
+    elif arm_len % 2 == 1:
+        to_clear = []
+        for r in range(h):
+            for c in range(w):
