+
+def _colorize_by_ring(occ: np.ndarray, cr: int, cc: int) -> np.ndarray:
+    out = np.zeros_like(occ, dtype=int)
+    for r, c in zip(*np.where(occ)):
+        radius = max(abs(r - cr), abs(c - cc))
+        layer = 1 + (radius - 1) // 2
+        out[r, c] = layer
+    return out
+
