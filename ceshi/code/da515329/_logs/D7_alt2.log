+            aid, cell_a = prop_items[i]
+            for j in range(i + 1, len(prop_items)):
+                bid, cell_b = prop_items[j]
+                if abs(cell_a[0] - cell_b[0]) + abs(cell_a[1] - cell_b[1]) == 1:
