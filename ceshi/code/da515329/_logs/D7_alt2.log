+            for aid in ids:
+                to_stop.add(aid)
+            for i in range(len(ids)):
+                for j in range(i + 1, len(ids)):
+                    proposal_pairs.add(frozenset((ids[i], ids[j])))
+
+        prop_items = list(proposals.items())
+        for i in range(len(prop_items)):
+            aid, cell_a = prop_items[i]
+            for j in range(i + 1, len(prop_items)):
+                bid, cell_b = prop_items[j]
+                if abs(cell_a[0] - cell_b[0]) + abs(cell_a[1] - cell_b[1]) == 1:
+                    to_stop.add(aid)
+                    to_stop.add(bid)
+                    proposal_pairs.add(frozenset((aid, bid)))
+
+        if to_stop:
+            stats["collision_rounds"] += 1
+            stats["collision_agents"] += len(to_stop)
+            stats["front_collision_pairs"] += len(front_pairs)
+            stats["proposal_collision_pairs"] += len(proposal_pairs)
+            progressed = True
+            for aid in to_stop:
+                agent = agents[aid]
+                agent["done"] = True
+                clear_plan(agent)
+
+        for agent in agents:
+            aid = int(agent["id"])
+            if aid in to_stop or aid not in proposals or bool(agent["done"]):
+                continue
+            rr, cc2 = proposals[aid]
+            out[rr, cc2] = 8
+            owner[rr, cc2] = aid
+            agent["cur"] = (rr, cc2)
+            agent["plan_remaining"] = int(agent["plan_remaining"]) - 1
+            if int(agent["plan_remaining"]) == 0:
+                agent["dir"] = agent["plan_after_dir"]
+                agent["p"] = int(agent["plan_after_p"])
+                agent["phase"] = agent["plan_after_phase"]
+                clear_plan(agent)
+            progressed = True
+
+        if not progressed:
+            break
+
+    if return_stats:
+        return out, stats
+    return out
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
