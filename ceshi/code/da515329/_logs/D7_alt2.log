+        agent["plan_remaining"] = 0
+        agent["plan_after_dir"] = None
+        agent["plan_after_p"] = 0
+        agent["plan_after_phase"] = None
+
+    def set_plan(
+        agent: dict[str, object],
+        d: tuple[int, int],
+        remaining: int,
+        after_dir: tuple[int, int],
+        after_p: int,
+        after_phase,
