+                "id": aid,
+                "cur": cells[-1],
+                "dir": _right(outward),
+                "out_dir": outward,
+                "phase": "out_first" if len(cells) == 1 else None,
+                "p": 0,
+                "done": False,
+                "plan_dir": None,
+                "plan_remaining": 0,
