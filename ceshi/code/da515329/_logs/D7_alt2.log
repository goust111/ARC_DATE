+            stats["collision_agents"] += len(to_stop)
+            stats["front_collision_pairs"] += len(front_pairs)
+            stats["proposal_collision_pairs"] += len(proposal_pairs)
+            progressed = True
+            for aid in to_stop:
+                agent = agents[aid]
+                agent["done"] = True
+                clear_plan(agent)
+
+        for agent in agents:
+            aid = int(agent["id"])
+            if aid in to_stop or aid not in proposals or bool(agent["done"]):
+                continue
