+        return 0 <= r < h and 0 <= c < w
+
+    row_counts = np.sum(grid == 8, axis=1)
+    col_counts = np.sum(grid == 8, axis=0)
+    cr = int(np.argmax(row_counts))
+    cc = int(np.argmax(col_counts))
+
+    arms: list[tuple[tuple[int, int], list[tuple[int, int]]]] = []
+    for d in _DIRS_URDL:
+        dr, dc = d
+        r, c = cr, cc
