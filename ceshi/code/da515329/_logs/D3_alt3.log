+    stats["primary_cells"] = int(np.sum(out == PRIMARY_COLOR))
+    stats["alt_cells"] = int(np.sum(out == ALT_COLOR))
+    stats["painted_cells"] = int(np.sum(out != 0))
+    return out, stats
+
+
+def main(grid: np.ndarray) -> np.ndarray:
