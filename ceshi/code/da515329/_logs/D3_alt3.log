+            pending = still_pending
+
+    arms = []
+    for d in _DIRS_URDL:
+        dr, dc = d
+        r, c = cr, cc
+        cells = []
+        while inb(r + dr, c + dc) and grid[r + dr, c + dc] == PRIMARY_COLOR:
