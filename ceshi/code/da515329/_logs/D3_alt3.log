+def _solve_with_stats(grid: np.ndarray) -> tuple[np.ndarray, dict[str, int]]:
+    grid = np.asarray(grid, dtype=int)
+    h, w = grid.shape
+    out = grid.copy()
+    stats = {"turns": 0}
