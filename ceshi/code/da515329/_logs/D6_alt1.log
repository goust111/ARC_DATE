        rects.append((top, left, bottom, right))
        pad += 2
    return rects


def _count_components(mask: np.ndarray) -> int:
    """4-connected component count on a boolean mask."""
    h, w = mask.shape
    seen = np.zeros((h, w), dtype=bool)
    count = 0
    for r in range(h):
        for c in range(w):
            if not mask[r, c] or seen[r, c]:
