import numpy as np, math
from importlib.machinery import SourceFileLoader
orig=SourceFileLoader('orig','/home/lixinyu/snap/new/arc2_solver_select/da515329.py').load_module()
def ccw(grid): return np.fliplr(orig.main(np.fliplr(grid)))
def build_input(arm,size,cr,cc):
    g=np.zeros((size,size),dtype=int)
    offs=np.arange(1,arm+1)
    g[cr-offs,cc]=8; g[cr+offs,cc]=8; g[cr,cc-offs]=8; g[cr,cc+offs]=8
    return g

def combo(inp):
    h,w=inp.shape
    row_counts=np.sum(inp==8,axis=1); col_counts=np.sum(inp==8,axis=0)
    cr=int(np.argmax(row_counts)); cc=int(np.argmax(col_counts))
    arm=max(len(np.where(inp[cr]==8)[0])//2, len(np.where(inp[:,cc]==8)[0])//2)
    cw=orig.main(inp); vw=ccw(inp)
    rr,ccg=np.indices((h,w))
    layer=np.maximum((np.abs(rr-cr)+np.abs(ccg-cc)-arm)//2,0)
    out=np.where(layer%2==0,cw,vw)
    out[inp==8]=8
    metric=np.sum((layer%2==1)&(cw"'!=vw))
    dist_cw=np.sum(out!=cw)
    dist_vw=np.sum(out!=vw)
    fill=np.mean(out==8)
    return fill, metric, dist_cw, dist_vw
for arm in [1,2,4]:
    size=4*arm+2*math.ceil(arm/2)+6
    lo=2*arm+2; hi=size-2*arm-2-1
    vals=[]
    for cr in range(lo,hi+1):
        for cc in range(lo,hi+1):
            inp=build_input(arm,size,cr,cc)
            fill, metric, dist_cw, dist_vw = combo(inp)
            if 0.48<=fill<=0.52:
                vals.append((metric, dist_cw, dist_vw, fill, cr, cc))
    print('"'arm',arm,'count',len(vals),'metric range',min(v[0] for v in vals),max(v[0] for v in vals),'distcw range',min(v[1] for v in vals),max(v[1] for v in vals))
