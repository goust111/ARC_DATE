import numpy as np, math
from importlib.machinery import SourceFileLoader
orig = SourceFileLoader('orig','/home/lixinyu/snap/new/arc2_solver_select/da515329.py').load_module()

def ccw(grid):
    mg = np.fliplr(grid)
    mo = orig.main(mg)
    return np.fliplr(mo)

def build_input(arm,size,cr,cc):
    g=np.zeros((size,size),dtype=int)
    offs=np.arange(1,arm+1)
    g[cr-offs,cc]=8; g[cr+offs,cc]=8; g[cr,cc-offs]=8; g[cr,cc+offs]=8
    return g

def combo(grid, mode=0):
    cw = orig.main(grid)
    vw = ccw(grid)
    h,w=grid.shape
    row_counts=np.sum(grid==8,axis=1); col_counts=np.sum(grid==8,axis=0)
    cr=int(np.argmax(row_counts)); cc=int(np.argmax(col_counts))
    arm=max(row_counts[cr]//2, col_counts[cc]//2)
    rr,ccg=np.indices((h,w))
    shell = np.maximum(np.abs(rr-cr), np.abs(ccg-cc)) - arm
    if mode==0:
        layer = np.maximum(shell,0)//2
    elif mode==1:
        layer = np.maximum(shell+1,0)//2
    elif mode==2:
        layer = (np.abs(rr-cr)+np.abs(ccg-cc)-arm)//2
        layer = np.maximum(layer,0)
    out=np.where(layer%2==0, cw, vw)
    out[grid==8]=8
    return out

for mode in [0,1,2]:
  print('MODE',mode)
  total_ok=0
  total_diff=0
  branch=0
  for arm in range(1,5):
    size=4*arm + 2*math.ceil(arm/2)+6
    lo=2*arm+2; hi=size-2*arm-2-1
    ok=0; total=0; diff=0; vis=0
    for cr in range(lo,hi+1):
      for cc in range(lo,hi+1):
        total+=1
        inp=build_input(arm,size,cr,cc)
        out=combo(inp, mode)
        fill=np.mean(out==8)
        if 0.48<=fill<=0.52: ok+=1
        if not np.array_equal(out, orig.main(inp)): diff+=1
        # visibility metric: odd-layer cells where cw and ccw differ and chosen output takes ccw
        cw=orig.main(inp); vw=ccw(inp)
        h,w=inp.shape; rr,ccg=np.indices((h,w)); shell=np.maximum(np.abs(rr-cr),np.abs(ccg-cc))-arm
        layer=np.maximum(shell,0)//2 if mode==0 else (np.maximum(shell+1,0)//2 if mode==1 else np.maximum((np.abs(rr-cr)+np.abs(ccg-cc)-arm)//2,0))
        metric=np.sum((layer%2==1)&(cw"'!=vw)&(out==vw))
        if metric>0: vis+=1
    print('"'arm',arm,'ok',ok,'/',total,'diff',diff,'visible',vis)
    total_ok += ok; total_diff += diff
  print('total ok',total_ok,'total diff', total_diff)
  inp=build_input(2,16,6,6)
  out=combo(inp,mode)
  print('sample fill',np.mean(out==8))
  for row in out: print(''.join(str(x) for x in row))
