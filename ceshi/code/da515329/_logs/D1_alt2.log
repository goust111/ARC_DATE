from importlib.machinery import SourceFileLoader
orig = SourceFileLoader('orig','/home/lixinyu/snap/new/arc2_solver_select/da515329.py').load_module()
from arc_utils import neighbors4
_DIRS=[(-1,0),(0,1),(1,0),(0,-1)]
def right(d): return _DIRS[(_DIRS.index(d)+1)%4]
def left(d): return _DIRS[(_DIRS.index(d)+3)%4]

def build_input(arm,size,cr,cc):
    g=np.zeros((size,size),dtype=int)
    offs=np.arange(1,arm+1)
    g[cr-offs,cc]=8; g[cr+offs,cc]=8; g[cr,cc-offs]=8; g[cr,cc+offs]=8
    return g

def run(mode):
  def main(grid):
    grid=np.asarray(grid,dtype=int); h,w=grid.shape; out=grid.copy()
    row_counts=np.sum(grid==8,axis=1); col_counts=np.sum(grid==8,axis=0)
    cr=int(np.argmax(row_counts)); cc=int(np.argmax(col_counts))
    def inb(r,c): return 0<=r<h and 0<=c<w
    def is_border(r,c): return r==0 or r==h-1 or c==0 or c==w-1
    def add(pos,d,k=1): return pos[0]+d[0]*k, pos[1]+d[1]*k
    def spacing_ok(cell, prev, start):
      r,c=cell
      for nr,nc in neighbors4(r,c):
        if inb(nr,nc) and out[nr,nc]"'!=0 and (nr,nc)!=prev and (nr,nc)!=start:
          return False
      return True
    def can_move(cur,d,length):
      prev=cur
      for t in range(1,length+1):
        rr,cc2=add(cur,d,t)
        if not inb(rr,cc2) or out[rr,cc2]!=0: return False
        if not spacing_ok((rr,cc2), prev, cur): return False
        prev=(rr,cc2)
      return True
    def do_move(agent,d,length):
      r0,c0=agent['"'cur']
      for t in range(1,length+1):
        out[r0+d[0]*t,c0+d[1]*t]=8
      agent['cur']=(r0+d[0]*length,c0+d[1]*length)
    arms=[]
    for d in _DIRS:
      dr,dc=d; r,c=cr,cc; cells=[]
      while inb(r+dr,c+dc) and grid[r+dr,c+dc]==8:
        r+=dr;c+=dc; cells.append((r,c))
      if cells: arms.append((d,cells))
    agents=[]
    for outward,cells in arms:
      agents.append({'cur':cells[-1],'dir':right(outward),'out_dir':outward,'phase':'out_first' if len(cells)==1 else None,'done':False,'p':0,'turns':0})
    def shell(agent):
      r,c=agent['cur']
      if mode==1:
        return max(abs(r-cr), abs(c-cc)) - len([1])
      if mode==2:
        return max(abs(r-cr), abs(c-cc))
      if mode==3:
        return (max(abs(r-cr), abs(c-cc)) - 1)//2
      if mode==4:
        return (max(abs(r-cr), abs(c-cc)) - max(1, min(abs(r-cr), abs(c-cc))))//2
      if mode==5:
        return min(r,c,h-1-r,w-1-c)//2
    arm_len=max(len(cells) for _,cells in arms)
    def pref(agent):
      s=shell(agent)
      if mode in [1,2]: idx=(s-arm_len)//2
      elif mode==3: idx=s-(arm_len//2)
      elif mode==4: idx=s
      elif mode==5: idx=s
      if idx%2==0: return right,left
      return left,right
    def step(agent):
      if agent['done']: return False
      if agent['phase']=='out_first':
        if can_move(agent['cur'], agent['out_dir'], 1): do_move(agent, agent['out_dir'],1)
        agent['phase']=None; agent['dir']=right(agent['out_dir']); agent['p']=0
        return True
      pr,op=pref(agent)
      cur=agent['cur']; dirs=[pr(agent['dir']), agent['dir']]
      if not is_border(*cur): dirs.append(op(agent['dir']))
      for nd in dirs:
        turned=nd"'!=agent['"'dir']; length=1 if turned else (2 if agent['p']==0 else 1)
        if can_move(agent['cur'], nd, length):
          do_move(agent, nd, length); agent['p']=1 if (agent['p']==0 and turned) else 0; agent['dir']=nd
          return True
        if not turned and length==2 and can_move(agent['cur'], nd, 1):
          do_move(agent, nd, 1); agent['p']=0; return True
      agent['done']=True; return False
    ch=True; guard=0
    while ch and guard<200000:
      ch=False; guard+=1
      for ag in agents:
        if step(ag): ch=True
      if all(ag['done'] for ag in agents): break
    return out
  # score all arms/centers
  print('MODE',mode)
  total_ok=0
  for arm in range(1,5):
    size=4*arm+2*math.ceil(arm/2)+6
    lo=2*arm+2; hi=size-2*arm-2-1
    total=0; ok=0; diff=0
    for cr in range(lo,hi+1):
      for cc in range(lo,hi+1):
        total+=1
        inp=build_input(arm,size,cr,cc)
        out=main(inp)
        fill=np.mean(out==8)
        if 0.48<=fill<=0.52: ok+=1
        if not np.array_equal(out, orig.main(inp)): diff +=1
    print('arm',arm,'ok',ok,'/',total,'diff',diff)
    total_ok += ok
  print('total ok', total_ok)
for mode in [1,2,3,4,5]:
  run(mode)
