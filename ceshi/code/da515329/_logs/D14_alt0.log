        if arm_len >= 1:
            out[0, max(0, w - arm_len) : w] = DRAW_PATH
        if h >= 2:
            for c in range(w):
                if out[h - 1, c] == DRAW_PATH and out[h - 2, c] == DRAW_BG:
                    out[h - 1, c] = DRAW_BG

    return out


