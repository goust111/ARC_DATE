+    if not even_center:
+        rp = 1 - (cr % 2)
+        cp = 1 - (cc % 2)
+        rr, ccg = np.indices((h, w))
+        out[(rr % 2 == rp) & (ccg % 2 == cp)] = DRAW_BG
+    elif arm_len % 2 == 1:
+        to_clear = []
+        for r in range(h):
+            for c in range(w):
+                if out[r, c] != DRAW_PATH:
+                    continue
+                if not is_border(r, c):
+                    continue
+                deg = 0
+                nbr = None
+                for nr, nc in neighbors4(r, c):
+                    if inb(nr, nc) and out[nr, nc] == DRAW_PATH:
