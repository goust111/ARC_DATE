+                "dir": right(outward),
+                "out_dir": outward,
+                "phase": "out_first" if len(cells) == 1 else None,
+                "done": False,
+                "p": 0,
+            }
+        )
+
+    def step_agent(agent) -> bool:
+        if agent["done"]:
+            return False
+
+        if agent["phase"] == "out_first":
+            if can_move(agent["cur"], agent["out_dir"], 1):
+                do_move(agent, agent["out_dir"], 1)
+            agent["phase"] = None
+            agent["dir"] = right(agent["out_dir"])
+            agent["p"] = 0
