+            if abs(r - cr) + abs(c - cc) < arm + 3:
+                continue
+            cells.append((r, c))
+    random.shuffle(cells)
+    return cells
+
+
+def _select_obstacles(candidates: list[tuple[int, int]], count: int) -> list[tuple[int, int]] | None:
+    candidates = list(candidates)
+    random.shuffle(candidates)
+    chosen = []
+    for r, c in candidates:
+        if all(abs(r - rr) + abs(c - cc) >= 4 for rr, cc in chosen):
+            chosen.append((r, c))
+            if len(chosen) == count:
+                return chosen
+    return None
+
+
+def _variant_metrics(inp: np.ndarray) -> tuple[int, int, float]:
+    base_inp = inp.copy()
+    base_inp[base_inp == OBSTACLE_COLOR] = 0
+    base_out = main(base_inp)
+    out = main(inp)
+    obstacle_mask = inp == OBSTACLE_COLOR
+    extra_delta = int(
+        np.count_nonzero(((out == CROSS_COLOR) != (base_out == CROSS_COLOR)) & (~obstacle_mask))
+    )
+    obstacle_hits = int(np.count_nonzero(obstacle_mask & (base_out == CROSS_COLOR)))
+    teal_fill = float(np.mean(out == CROSS_COLOR))
+    return obstacle_hits, extra_delta, teal_fill
+
+
+def _gen_attempt() -> np.ndarray | None:
+    arm = random.randint(ARM_LEN_MIN, ARM_LEN_MAX)
+    size = 4 * arm + 2 * math.ceil(arm / 2) + GRID_SIZE_BASE
+
+    lo = 2 * arm + TIP_GAP_MIN
+    hi = size - 2 * arm - TIP_GAP_MIN - 1
+    if lo > hi:
+        return None
+
+    candidates = [(r, c) for r in range(lo, hi + 1) for c in range(lo, hi + 1)]
+    random.shuffle(candidates)
+
+    for cr, cc in candidates:
+        base_inp = _build_input(arm, size, cr, cc)
+        try:
+            base_out = main(base_inp)
+        except Exception:
+            continue
+
+        obstacle_candidates = _candidate_obstacles(base_inp, base_out, cr, cc, arm)
+        if len(obstacle_candidates) < _obstacle_count_for_arm(arm):
+            continue
+
+        for _ in range(OBSTACLE_TRIES_PER_CENTER):
+            chosen = _select_obstacles(obstacle_candidates, _obstacle_count_for_arm(arm))
+            if chosen is None:
+                break
+
+            inp = base_inp.copy()
+            for r, c in chosen:
+                inp[r, c] = OBSTACLE_COLOR
+
+            try:
+                out = main(inp)
+            except Exception:
+                continue
+
+            obstacle_hits, extra_delta, teal_fill = _variant_metrics(inp)
+            if obstacle_hits != len(chosen):
+                continue
+            if extra_delta < len(chosen):
+                continue
+            if not (TEAL_FILL_LO <= teal_fill <= TEAL_FILL_HI):
+                continue
+            if np.array_equal(main(inp), out):
+                return inp
+
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_OUTER_RETRIES):
+        g = _gen_attempt()
+        if g is not None:
+            return g
+    raise RuntimeError("generate_input: failed after retries")

