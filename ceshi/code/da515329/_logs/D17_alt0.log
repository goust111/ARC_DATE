+            if can_move(agent["cur"], nd, length):
+                do_move(agent, nd, length)
+                agent["p"] = 1 if (agent["p"] == 0 and turned) else 0
+                agent["dir"] = nd
+                return True
+            if not turned and length == 2 and can_move(agent["cur"], nd, 1):
+                do_move(agent, nd, 1)
+                agent["p"] = 0
+                return True
+
+        agent["done"] = True
+        return False
+
+    changed = True
+    guard = 0
+    while changed and guard < 200000:
+        guard += 1
+        changed = False
+        for ag in agents:
