def _select_obstacles(candidates: list[tuple[int, int]], count: int) -> list[tuple[int, int]] | None:
    chosen = []
    for r, c in candidates:
        if all(abs(r - rr) + abs(c - cc) >= 4 for rr, cc in chosen):
