+# Variant of da515329
+# Dimension: D17 — 网格中的障碍物 (obstacle)
+# Change: 网格中无障碍物，螺旋路径仅受网格边界和间距约束限制... → 固定颜色障碍物阻挡螺旋
+
+# Design analysis for the D17 variant
+# ----------------------------------
+# a) Concrete behavior / trace
+#    - Input still contains one teal(8) plus-sign cross with a center hole on a black background.
+#    - New element: several isolated red(2) single-pixel obstacles are added away from the cross.
+#    - Output keeps those red pixels unchanged. The four teal spirals are generated by the same
+#      right-turn-first turtle logic as the base task, but red cells count as solid blockers.
+#    - Small trace: if a turtle wants to continue straight for length 2 and the next cell is a red
+#      obstacle, the original task would have painted through that cell because it was black. In the
+#      variant, `can_move` rejects that straight option, so the turtle tries right-turn first,
+#      otherwise straight partial-1, otherwise left (if not on border), otherwise stops. The visual
+#      difference is not just a preserved red dot: the nearby teal corridor bends or truncates.
+# b) Complexity calibration
+#    - Obstacles are limited to one fixed visible color and to isolated single pixels. This keeps the
+#      new rule readable from 2-4 examples while still producing nontrivial rerouting.
+#    - We require 2-4 obstacles per generated instance and force them onto cells that belong to the
+#      obstacle-free spiral, so the variant does not collapse back to the base task.
+# c) Hidden assumptions in the original solver
+#    - Center detection via counts of teal cells still holds because only the cross uses color 8.
+#    - Original `out != 0` occupancy checks are acceptable for movement because red obstacles should
+#      block. However, the original post-processing clears/paints cells without distinguishing teal
+#      from obstacle colors; that would erase or overwrite obstacles. This variant fixes those sites
+#      so post-processing only edits teal cells or empty black cells.
+# d) Placement legality
+#    - Generator keeps the original grid-size formula and center-placement range, then places
+#      obstacles only on cells that are teal in the obstacle-free output, black in the input, and
+#      sufficiently far from the cross and from one another. This avoids overlaps and keeps the
+#      instance solvable by the modified `main()`.
+# e) Visual observability
+#    - The human sees the same cross seed plus a few red blockers. In the output the red blockers
+#      stay fixed while nearby teal spiral paths divert around them. Because the obstacle color is
+#      constant and repeated within each sample, the rule is inferable without hidden metadata.
+# f) Visual cleanliness
+#    - Obstacles are isolated and kept away from the cross center, so the grid remains legible. The
+#      output contains only three semantic layers: black background, teal path, red blockers.
+# g) Color-change inferability
+#    - No color mapping is introduced. Teal remains the generated spiral color, red remains a fixed
+#      non-changing obstacle color, and black remains background.
+
+import math
+import random
+
+import numpy as np
+
+from arc_utils import neighbors4
+
+_DIRS_URDL = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+
+CROSS_COLOR = 8
+OBSTACLE_COLOR = 2
+ARM_LEN_MIN, ARM_LEN_MAX = 1, 4
+GRID_SIZE_BASE = 6
+TIP_GAP_MIN = 2
+TEAL_FILL_LO, TEAL_FILL_HI = 0.38, 0.52
+MAX_OUTER_RETRIES = 400
+OBSTACLE_TRIES_PER_CENTER = 20
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Grow four clockwise spiral paths from a teal cross while red blockers stay fixed.
+
+    Input structure:
+    - bg = 0 (black). One teal (8) plus-sign cross with a center hole, plus several red (2)
+      single-pixel obstacles scattered elsewhere in the grid.
+
+    Rule:
+    - Each arm tip launches a turtle heading 90° clockwise from the arm's outward direction.
+    - Movement priority stays right turn > straight > left turn (left still disallowed on border).
+    - Straight steps normally use length 2; a step immediately after a turn uses length 1.
+    - A turtle may paint only empty black cells; teal path cells and red obstacle cells both block
+      movement, so obstacles can force earlier turns, partial straights, or termination.
+
+    Key insight: The base task's spiral generator is unchanged except that fixed red pixels act as
+    miniature walls. The solver therefore identifies the cross exactly as before, runs the same
+    turtle schedule, and preserves obstacle cells during the parity/border cleanup stage.
+    """
+
+    grid = np.asarray(grid, dtype=int)
+    h, w = grid.shape
+    out = grid.copy()
+
+    row_counts = np.sum(grid == CROSS_COLOR, axis=1)
+    col_counts = np.sum(grid == CROSS_COLOR, axis=0)
+    cr = int(np.argmax(row_counts))
+    cc = int(np.argmax(col_counts))
+
+    def inb(r: int, c: int) -> bool:
+        return 0 <= r < h and 0 <= c < w
+
+    def is_border(r: int, c: int) -> bool:
+        return r == 0 or r == h - 1 or c == 0 or c == w - 1
+
+    def add(pos, d, k=1):
+        return (pos[0] + d[0] * k, pos[1] + d[1] * k)
+
+    def right(d):
+        return _DIRS_URDL[(_DIRS_URDL.index(d) + 1) % 4]
+
+    def left(d):
+        return _DIRS_URDL[(_DIRS_URDL.index(d) + 3) % 4]
+
+    def is_teal(r: int, c: int) -> bool:
+        return out[r, c] == CROSS_COLOR
+
+    def is_blocked(r: int, c: int) -> bool:
+        return out[r, c] != 0
+
+    def spacing_ok(cell, prev, start) -> bool:
+        r, c = cell
+        for nr, nc in neighbors4(r, c):
+            if inb(nr, nc) and is_teal(nr, nc) and (nr, nc) != prev and (nr, nc) != start:
+                return False
+        return True
+
+    def can_move(cur, d, length: int) -> bool:
+        prev = cur
+        for t in range(1, length + 1):
+            rr, cc2 = add(cur, d, t)
+            if not inb(rr, cc2) or is_blocked(rr, cc2):
+                return False
+            if not spacing_ok((rr, cc2), prev, cur):
+                return False
+            prev = (rr, cc2)
+        return True
+
+    def do_move(agent, d, length: int) -> None:
+        r0, c0 = agent["cur"]
+        for t in range(1, length + 1):
+            rr, cc2 = r0 + d[0] * t, c0 + d[1] * t
+            out[rr, cc2] = CROSS_COLOR
+        agent["cur"] = (r0 + d[0] * length, c0 + d[1] * length)
+
+    arms = []
+    for d in _DIRS_URDL:
+        dr, dc = d
+        r, c = cr, cc
+        cells = []
+        while inb(r + dr, c + dc) and grid[r + dr, c + dc] == CROSS_COLOR:
+            r += dr
+            c += dc
+            cells.append((r, c))
+        if cells:
+            arms.append((d, cells))
+
+    even_center = (cr + cc) % 2 == 0
+    arm_len = max((len(cells) for _, cells in arms), default=0)
+
+    agents = []
+    for outward, cells in arms:
+        agents.append(
+            {
+                "cur": cells[-1],
+                "dir": right(outward),
+                "out_dir": outward,
+                "phase": "out_first" if len(cells) == 1 else None,
+                "done": False,
+                "p": 0,
+            }
+        )
+
+    def step_agent(agent) -> bool:
+        if agent["done"]:
+            return False
+
+        if agent["phase"] == "out_first":
+            if can_move(agent["cur"], agent["out_dir"], 1):
+                do_move(agent, agent["out_dir"], 1)
+            agent["phase"] = None
+            agent["dir"] = right(agent["out_dir"])
+            agent["p"] = 0
+            return True
+
+        cur = agent["cur"]
+        dirs = [right(agent["dir"]), agent["dir"]]
+        if not is_border(*cur):
+            dirs.append(left(agent["dir"]))
+
+        for nd in dirs:
+            turned = nd != agent["dir"]
+            length = 1 if turned else (2 if agent["p"] == 0 else 1)
+            if can_move(agent["cur"], nd, length):
+                do_move(agent, nd, length)
+                agent["p"] = 1 if (agent["p"] == 0 and turned) else 0
+                agent["dir"] = nd
+                return True
+            if not turned and length == 2 and can_move(agent["cur"], nd, 1):
+                do_move(agent, nd, 1)
+                agent["p"] = 0
+                return True
+
+        agent["done"] = True
+        return False
+
+    changed = True
+    guard = 0
+    while changed and guard < 200000:
+        guard += 1
+        changed = False
+        for ag in agents:
+            if step_agent(ag):
+                changed = True
+        if all(ag["done"] for ag in agents):
+            break
+
+    if not even_center:
+        rp = 1 - (cr % 2)
+        cp = 1 - (cc % 2)
+        rr, ccg = np.indices((h, w))
+        clear_mask = (rr % 2 == rp) & (ccg % 2 == cp) & (out == CROSS_COLOR)
+        out[clear_mask] = 0
+    elif arm_len % 2 == 1:
+        to_clear = []
+        for r in range(h):
+            for c in range(w):
+                if out[r, c] != CROSS_COLOR or not is_border(r, c):
+                    continue
+                deg = 0
+                nbr = None
+                for nr, nc in neighbors4(r, c):
+                    if inb(nr, nc) and out[nr, nc] == CROSS_COLOR:
+                        deg += 1
+                        nbr = (nr, nc)
+                if deg == 1 and nbr is not None and is_border(*nbr):
+                    to_clear.append((r, c))
+        for r, c in to_clear:
+            out[r, c] = 0
+
+        br = (h - 1, w - 1)
+        if out[br] == 0 and all(
+            not (inb(nr, nc) and out[nr, nc] == CROSS_COLOR)
+            for nr, nc in neighbors4(br[0], br[1])
+        ):
+            out[br] = CROSS_COLOR
+    else:
+        if arm_len >= 2:
+            for r in range(min(h, arm_len - 1)):
+                if out[r, 0] == 0:
+                    out[r, 0] = CROSS_COLOR
+        if arm_len >= 1:
+            for c in range(max(0, w - arm_len), w):
+                if out[0, c] == 0:
+                    out[0, c] = CROSS_COLOR
+        if h >= 2:
+            for c in range(w):
+                if out[h - 1, c] == CROSS_COLOR and out[h - 2, c] == 0:
+                    out[h - 1, c] = 0
+
+    return out
+
+
+def _build_input(arm: int, size: int, cr: int, cc: int) -> np.ndarray:
+    grid = np.zeros((size, size), dtype=int)
+    offsets = np.arange(1, arm + 1)
+    grid[cr - offsets, cc] = CROSS_COLOR
+    grid[cr + offsets, cc] = CROSS_COLOR
+    grid[cr, cc - offsets] = CROSS_COLOR
+    grid[cr, cc + offsets] = CROSS_COLOR
+    return grid
+
+
+def _teal_degree(grid: np.ndarray, r: int, c: int) -> int:
+    deg = 0
+    h, w = grid.shape
+    for nr, nc in neighbors4(r, c):
+        if 0 <= nr < h and 0 <= nc < w and grid[nr, nc] == CROSS_COLOR:
+            deg += 1
+    return deg
+
+
+def _obstacle_count_for_arm(arm: int) -> int:
+    return 2 if arm <= 2 else 3
+
+
+def _candidate_obstacles(
+    base_inp: np.ndarray, base_out: np.ndarray, cr: int, cc: int, arm: int
+) -> list[tuple[int, int]]:
+    h, w = base_out.shape
+    cells = []
+    for r in range(1, h - 1):
+        for c in range(1, w - 1):
+            if base_out[r, c] != CROSS_COLOR or base_inp[r, c] != 0:
+                continue
+            if _teal_degree(base_out, r, c) != 2:
+                continue
+            if abs(r - cr) + abs(c - cc) < arm + 3:
+                continue
+            cells.append((r, c))
+    random.shuffle(cells)
+    return cells
+
+
+def _select_obstacles(candidates: list[tuple[int, int]], count: int) -> list[tuple[int, int]] | None:
+    candidates = list(candidates)
+    random.shuffle(candidates)
+    chosen = []
+    for r, c in candidates:
+        if all(abs(r - rr) + abs(c - cc) >= 4 for rr, cc in chosen):
+            chosen.append((r, c))
+            if len(chosen) == count:
+                return chosen
+    return None
+
+
+def _variant_metrics(inp: np.ndarray) -> tuple[int, int, float]:
+    base_inp = inp.copy()
+    base_inp[base_inp == OBSTACLE_COLOR] = 0
+    base_out = main(base_inp)
+    out = main(inp)
+    obstacle_mask = inp == OBSTACLE_COLOR
+    extra_delta = int(
+        np.count_nonzero(((out == CROSS_COLOR) != (base_out == CROSS_COLOR)) & (~obstacle_mask))
+    )
+    obstacle_hits = int(np.count_nonzero(obstacle_mask & (base_out == CROSS_COLOR)))
+    teal_fill = float(np.mean(out == CROSS_COLOR))
+    return obstacle_hits, extra_delta, teal_fill
+
+
+def _gen_attempt() -> np.ndarray | None:
+    arm = random.randint(ARM_LEN_MIN, ARM_LEN_MAX)
+    size = 4 * arm + 2 * math.ceil(arm / 2) + GRID_SIZE_BASE
+
+    lo = 2 * arm + TIP_GAP_MIN
+    hi = size - 2 * arm - TIP_GAP_MIN - 1
+    if lo > hi:
+        return None
+
+    candidates = [(r, c) for r in range(lo, hi + 1) for c in range(lo, hi + 1)]
+    random.shuffle(candidates)
+
+    for cr, cc in candidates:
+        base_inp = _build_input(arm, size, cr, cc)
+        try:
+            base_out = main(base_inp)
+        except Exception:
+            continue
+
+        obstacle_candidates = _candidate_obstacles(base_inp, base_out, cr, cc, arm)
+        if len(obstacle_candidates) < _obstacle_count_for_arm(arm):
+            continue
+
+        for _ in range(OBSTACLE_TRIES_PER_CENTER):
+            chosen = _select_obstacles(obstacle_candidates, _obstacle_count_for_arm(arm))
+            if chosen is None:
+                break
+
+            inp = base_inp.copy()
+            for r, c in chosen:
+                inp[r, c] = OBSTACLE_COLOR
+
+            try:
+                out = main(inp)
+            except Exception:
+                continue
+
+            obstacle_hits, extra_delta, teal_fill = _variant_metrics(inp)
+            if obstacle_hits != len(chosen):
+                continue
+            if extra_delta < len(chosen):
+                continue
+            if not (TEAL_FILL_LO <= teal_fill <= TEAL_FILL_HI):
+                continue
+            if np.array_equal(main(inp), out):
+                return inp
+
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_OUTER_RETRIES):
+        g = _gen_attempt()
+        if g is not None:
+            return g
+    raise RuntimeError("generate_input: failed after retries")

