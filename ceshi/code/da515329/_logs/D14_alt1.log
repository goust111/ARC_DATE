/bin/bash -lc "python - <<'PY'
import numpy as np, math, random
from arc2_solver_select.da515329 import main, _build_input

# Re-implement enough to inspect cases.
_DIRS_URDL=[(-1,0),(0,1),(1,0),(0,-1)]

def analyze(arm,size,cr,cc):
    grid=_build_input(arm,size,cr,cc)
    out=main(grid)
    h,w=grid.shape
    even_center=(cr+cc)%2==0
    return even_center, arm%2, out[h-1,w-1], out[0,0], out[0,w-1]

for arm in range(1,5):
    size = 4 * arm + 2 * math.ceil(arm / 2) + 6
    lo = 2 * arm + 2
    hi = size - 2 * arm - 2 - 1
    print('arm',arm,'size',size)
    found=0
    for cr in range(lo,hi+1):
      for cc in range(lo,hi+1):
        even, apar, br, tl, tr = analyze(arm,size,cr,cc)
        if even and apar==1 and br"'!=0:
          print('"' even+odd center',cr,cc,'br',br,'tl',tl,'tr',tr)
          found+=1
          if found>=5: break
      if found>=5: break
