+def _visible_crop_ok(crop_box: tuple[int, int, int, int], h: int, w: int) -> bool:
+    """Keep only samples where the new bbox crop is visually different in both dimensions."""
+    r0, c0, r1, c1 = crop_box
+    vertical_crop = r0 > 0 or r1 < h - 1
+    horizontal_crop = c0 > 0 or c1 < w - 1
+    return vertical_crop and horizontal_crop
