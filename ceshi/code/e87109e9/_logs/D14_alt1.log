   277	def _choose_span(
   278	    axis_len: int,
   279	    required: list[tuple[int, int]],
   280	    excluded: list[tuple[int, int]],
   281	    min_len: int,
   282	    max_len: int,
   283	) -> tuple[int, int] | None:
   284	    """Pick a span that covers all required intervals while missing all excluded ones."""
   285	    req0 = min(a for a, _ in required)
   286	    req1 = max(b for _, b in required)
   287	    lo = max(min_len, req1 - req0 + 1)
   288	    hi = min(max_len, axis_len)
   289	    choices: list[tuple[int, int, int]] = []
   290	    for length in range(lo, hi + 1):
   291	        start0 = max(0, req1 - length + 1)
   292	        start1 = min(req0, axis_len - length)
   293	        for start in range(start0, start1 + 1):
   294	            end = start + length - 1
   295	            if all(end < a or start > b for a, b in excluded):
   296	                choices.append((length, start, end))
   297	    if not choices:
   298	        return None
   299	
   300	    lengths = sorted({length for length, _, _ in choices})
   301	    if random.random() < SPAN_COMPACT_PROB:
   302	        cutoff = lengths[min(len(lengths) - 1, max(0, len(lengths) // 2))]
   303	        pool = [(start, end) for length, start, end in choices if length <= cutoff]
   304	    else:
   305	        pool = [(start, end) for _, start, end in choices]
   306	    return random.choice(pool)
   307	
   308	
   309	def _make_legend(legend_colors: list[int], turns: dict[int, str]) -> np.ndarray:
   310	    legend = np.full((LEGEND_H, GRID_W), LEGEND_BG, dtype=int)
   311	    for start, color in zip(LEGEND_CELL_STARTS, legend_colors):
   312	        legend[1:5, start : start + 4] = 0
   313	        bar_col = start if turns[color] == "L" else start + 3
   314	        legend[1:5, bar_col] = color
   315	    return legend
   316	
   317	
   318	def _rand_thickness(lo: int, hi: int) -> int | None:
   319	    return random.randint(lo, hi) if hi >= lo else None
   320	
   321	
   322	def _thickness_pair(
   323	    axis: int, sz: int, a_present: bool, b_present: bool
   324	) -> tuple[int | None, int | None] | None:
   325	    lo, hi_cap = OBS_THICKNESS_RANGE
   326	    if a_present and b_present:
   327	        room = axis - sz - OBS_BOTH_GAP
   328	        if room < 2 * lo:
   329	            return None
   330	        a = random.randint(lo, min(hi_cap, room - lo))
   331	        b = _rand_thickness(lo, min(hi_cap, room - a))
   332	        return (a, b) if b is not None else None
   333	    if a_present:
   334	        t = _rand_thickness(lo, min(hi_cap, axis - sz - OBS_SINGLE_MARGIN))
   335	        return (t, None) if t is not None else None
   336	    if b_present:
   337	        t = _rand_thickness(lo, min(hi_cap, axis - sz - OBS_SINGLE_MARGIN))
   338	        return (None, t) if t is not None else None
   339	    return None, None
   340	
   341	
   342	def _obstacle_rect(
   343	    side: int, thickness: int, span: tuple[int, int], h: int, w: int
   344	) -> tuple[int, int, int, int]:
   345	    s0, s1 = span
   346	    if side == _N:
   347	        return 0, thickness - 1, s0, s1
   348	    if side == _S:
   349	        return h - thickness, h - 1, s0, s1
   350	    if side == _W:
   351	        return s0, s1, 0, thickness - 1
   352	    return s0, s1, w - thickness, w - 1
   353	
   354	
   355	def _lane_top(side: int, thickness: int, h: int, w: int, sz: int) -> int:
   356	    if side == _N:
   357	        return int(thickness)
   358	    if side == _S:
   359	        return int(h - thickness - sz)
   360	    if side == _W:
   361	        return int(thickness)
   362	    return int(w - thickness - sz)
   363	
   364	
   365	def _source_interval(side: int, sr: int, sc: int, sz: int) -> tuple[int, int]:
   366	    base = sc if side in (_N, _S) else sr
   367	    return int(base), int(base + sz - 1)
   368	
   369	
   370	def _lane_interval(side: int, lane: dict[int, int], sz: int) -> tuple[int, int]:
   371	    start = int(lane[side])
   372	    return start, int(start + sz - 1)
   373	
   374	
   375	def _add_corner_exclusions(
   376	    present: set[int],
   377	    thickness: dict[int, int],
   378	    excluded: dict[int, list[tuple[int, int]]],
   379	    h: int,
   380	    w: int,
   381	) -> None:
   382	    if _N in present:
   383	        if _W in present:
   384	            excluded[_N].append((0, thickness[_W] - 1))
   385	        if _E in present:
   386	            excluded[_N].append((w - thickness[_E], w - 1))
   387	    if _S in present:
   388	        if _W in present:
   389	            excluded[_S].append((0, thickness[_W] - 1))
   390	        if _E in present:
   391	            excluded[_S].append((w - thickness[_E], w - 1))
   392	    if _W in present:
   393	        if _N in present:
   394	            excluded[_W].append((0, thickness[_N] - 1))
   395	        if _S in present:
   396	            excluded[_W].append((h - thickness[_S], h - 1))
   397	    if _E in present:
   398	        if _N in present:
   399	            excluded[_E].append((0, thickness[_N] - 1))
   400	        if _S in present:
   401	            excluded[_E].append((h - thickness[_S], h - 1))
   402	
   403	
   404	def _build_constraints(
   405	    seq: list[int],
   406	    side_turn: dict[int, str],
   407	    sr: int,
   408	    sc: int,
   409	    sz: int,
   410	    lane: dict[int, int],
   411	    thickness: dict[int, int],
   412	    h: int,
   413	    w: int,
   414	) -> tuple[dict[int, list[tuple[int, int]]], dict[int, list[tuple[int, int]]]]:
   415	    present = set(seq)
   416	    required: dict[int, list[tuple[int, int]]] = {s: [] for s in present}
   417	    excluded: dict[int, list[tuple[int, int]]] = {s: [] for s in present}
   418	
   419	    for side in present:
   420	        iv = _source_interval(side, sr, sc, sz)
   421	        if side == seq[0]:
   422	            required[side].append(iv)
   423	        else:
   424	            excluded[side].append(iv)
   425	
   426	    for side, nxt in zip(seq, seq[1:], strict=False):
   427	        required[nxt].append(_lane_interval(side, lane, sz))
   428	
   429	    exit_side = _rot(seq[-1], side_turn[seq[-1]])
   430	    if exit_side in present:
   431	        excluded[exit_side].append(_lane_interval(seq[-1], lane, sz))
   432	
   433	    _add_corner_exclusions(present, thickness, excluded, h, w)
   434	    return required, excluded
   435	
   436	
   437	def _gen_attempt() -> np.ndarray | None:
   438	    h, w = random.randint(*GRID_H_RANGE), GRID_W
   439	    sz = 2 if random.random() < TEAL_SZ2_PROB else 3
   440	    path_len = 4 if random.random() < PATH_LEN_4_PROB else 3
   441	    step_turn = random.choice(["L", "R"])
   442	    start_side = random.randint(0, 3)
   443	
   444	    seq = [start_side]
   445	    for _ in range(path_len - 1):
   446	        seq.append(_rot(seq[-1], step_turn))
   447	    present = set(seq)
   448	
   449	    ns = _thickness_pair(h, sz, _N in present, _S in present)
   450	    ew = _thickness_pair(w, sz, _W in present, _E in present)
   451	    if ns is None or ew is None:
   452	        return None
   453	    thickness = {
   454	        side: t
   455	        for side, t in zip((_N, _S, _W, _E), (*ns, *ew))
   456	        if t is not None
   457	    }
   458	
   459	    min_r, max_r = SQUARE_EDGE_GAP, h - sz - SQUARE_EDGE_GAP
   460	    min_c, max_c = SQUARE_EDGE_GAP, w - sz - SQUARE_EDGE_GAP
   461	    if _N in present:
   462	        min_r = max(min_r, thickness[_N] + 1)
   463	    if _S in present:
   464	        max_r = min(max_r, h - thickness[_S] - sz - 1)
   465	    if _W in present:
   466	        min_c = max(min_c, thickness[_W] + 1)
   467	    if _E in present:
   468	        max_c = min(max_c, w - thickness[_E] - sz - 1)
   469	    if min_r > max_r or min_c > max_c:
   470	        return None
   471	    sr, sc = random.randint(min_r, max_r), random.randint(min_c, max_c)
   472	
   473	    lane = {
   474	        side: _lane_top(side, thickness[side], h, w, sz)
   475	        for side in present
   476	    }
   477	
   478	    side_turn = {side: step_turn for side in seq[:-1]}
   479	    side_turn[seq[-1]] = step_turn if path_len == 3 else _opp_turn(step_turn)
   480	    required, excluded = _build_constraints(
   481	        seq, side_turn, sr, sc, sz, lane, thickness, h, w
   482	    )
   483	
   484	    spans: dict[int, tuple[int, int]] = {}
   485	    for side in present:
   486	        axis_len = w if side in (_N, _S) else h
   487	        span = _choose_span(
   488	            axis_len,
   489	            required[side],
   490	            excluded[side],
   491	            SPAN_MIN_MULT * sz,
   492	            min(SPAN_MAX_MULT * sz, axis_len),
   493	        )
   494	        if span is None:
   495	            return None
   496	        spans[side] = span
   497	
   498	    legend_colors = random.sample(LEGEND_COLOR_POOL, 4)
   499	    chosen_colors = random.sample(legend_colors, len(present))
   500	    side_color = {side: color for side, color in zip(seq, chosen_colors)}
   501	    bg = random.choice([c for c in BG_COLOR_POOL if c not in legend_colors])
   502	
   503	    base = np.full((h, w), bg, dtype=int)
   504	    base[sr : sr + sz, sc : sc + sz] = TEAL
   505	    occupied = np.zeros((h, w), dtype=bool)
   506	
   507	    for side in present:
   508	        r0, r1, c0, c1 = _obstacle_rect(side, thickness[side], spans[side], h, w)
   509	        region = occupied[r0 : r1 + 1, c0 : c1 + 1]
   510	        if region.any():
   511	            return None
   512	        if not (r1 < sr - 1 or r0 > sr + sz or c1 < sc - 1 or c0 > sc + sz):
   513	            return None
   514	        occupied[r0 : r1 + 1, c0 : c1 + 1] = True
   515	        base[r0 : r1 + 1, c0 : c1 + 1] = side_color[side]
   516	
   517	    vals, cnts = np.unique(base, return_counts=True)
   518	    if int(vals[cnts.argmax()]) != bg:
   519	        return None
   520	

diff --git a/ceshi/code/e87109e9/D14/1/code.py b/ceshi/code/e87109e9/D14/1/code.py
new file mode 100644
index 0000000000000000000000000000000000000000..2be26c4e859b4138305c52f01249d04200f66f54
--- /dev/null
+++ b/ceshi/code/e87109e9/D14/1/code.py
@@ -0,0 +1,553 @@
+# Variant of e87109e9
+# Dimension: D14 — 多步处理与射线顺序 (multi_step)
+# Change: 所有射线从源方块同时向4个方向发射，各自独立追踪路径直到离开网格，无射线间顺序依赖... → 链式反应传播
+
+import random
+
+import numpy as np
+
+from arc_utils import bbox_coords, components_mask
+
+_DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+_N, _E, _S, _W = range(4)
+
+
+# Design analysis for the D14 variant
+# -----------------------------------
+# a) Concrete behavior
+#    - The legend stays visually identical: a 6x24 top band with 4 colored bars,
+#      where left/right placement still means CCW/CW.
+#    - The main grid still has one solid teal square and 3-4 edge-touching obstacle
+#      rectangles whose colors are drawn from the legend.
+#    - The variant change is not a new marker but a new spatial condition:
+#      exactly one cardinal corridor from the teal square lines up with an obstacle.
+#      That unique aligned side is the only legal launch direction.
+#    - After the first hit, the ray keeps going as one continuous sz-wide polyline.
+#      Example: source launches north, hits the north obstacle, turns east, hits the
+#      east obstacle, turns south, hits the south obstacle, then exits. The original
+#      task would also paint west/south/east spokes from the source in parallel;
+#      this variant paints only that chained path.
+# b) Complexity calibration
+#    - To keep the change obvious, every generated case has a chain length of 3 or 4
+#      obstacle hits. That is longer than a trivial one-bounce simplification.
+#    - The start rule is supported by repeated visual evidence: only one obstacle
+#      initially covers the source lane, while the other present sides visibly do not.
+# c) Implicit assumptions from the old main()
+#    - The old `for d0 in range(4)` hard-coded four independent launches; this must
+#      be replaced by discovering a unique hittable initial direction.
+#    - The old logic tolerated multiple directly hittable sides because every side
+#      was launched anyway. In the variant that would be ambiguous, so the generator
+#      guarantees uniqueness and the solver asserts it.
+#    - The turning rule itself remains valid: obstacle colors still map to L/R in
+#      the legend, and collision still happens before entering the obstacle cell.
+# d) Placement legality
+#    - Obstacles remain non-overlapping rectangles touching grid edges.
+#    - Adjacent-side corner overlap is prevented by excluding corner intervals when
+#      choosing spans.
+#    - The teal square keeps at least one cell of separation from every obstacle.
+# e) Visual observability
+#    - No hidden ordering by color id is used. The only new control variable is the
+#      visibly unique corridor from the source to the first obstacle.
+#    - Outputs differ clearly from the original: they show a single bent trail rather
+#      than a four-armed cross.
+# f) Visual cleanliness
+#    - Chains are restricted to simple perimeter walks of length 3 or 4, which keeps
+#      the polyline readable and avoids clutter from self-intersections.
+# g) Color inference
+#    - Colors still only encode turn direction through the legend; the variant does
+#      not introduce any extra color semantics.
+# 9) New solver assumptions and generator support
+#    - `_find_start_direction()` assumes exactly one direction hits an obstacle before
+#      exiting. `_build_constraints()` enforces that by requiring source alignment for
+#      only the first side and excluding it for the others.
+#    - `_trace_chain()` assumes the path does not cycle. The generator uses a simple
+#      non-repeating side sequence and an exit turn on the last obstacle.
+#    - `_obstacle_color_at()` assumes each beam footprint sees at most one obstacle
+#      color at once. The generator keeps obstacle rectangles disjoint.
+
+
+def _parse_legend(grid: np.ndarray, legend_h: int) -> dict[int, str]:
+    """
+    Legend is a top region with a background color (typically 5) and 4 vertical bars.
+    Each bar's horizontal position inside its cell encodes turn direction:
+      - bar on left  -> 'L' (turn counterclockwise)
+      - bar on right -> 'R' (turn clockwise)
+    """
+    legend = grid[:legend_h, :]
+    assert legend.size, "legend must be non-empty"
+    vals, cnts = np.unique(legend, return_counts=True)
+    bg = int(vals[cnts.argmax()])
+
+    sep_cols = [c for c in range(legend.shape[1]) if np.all(legend[:, c] == bg)]
+    assert len(sep_cols) >= 2, "legend separator columns must exist"
+
+    turn: dict[int, str] = {}
+    for a, b in zip(sep_cols, sep_cols[1:], strict=False):
+        if b - a <= 2:
+            continue
+        interior = legend[1 : legend_h - 1, a + 1 : b]
+        colors = set(map(int, np.unique(interior)))
+        colors.discard(bg)
+        colors.discard(0)
+        assert len(colors) == 1, "each legend cell must encode exactly one color"
+        col = int(next(iter(colors)))
+        xs = np.where(interior == col)[1]
+        x = int(xs[0])
+        turn[col] = "L" if x <= (interior.shape[1] - 1) // 2 else "R"
+    assert len(turn) == 4, "legend must encode four turn colors"
+    return turn
+
+
+def _find_teal_square(g: np.ndarray, teal: int = 8) -> tuple[int, int, int]:
+    """Return (r0, c0, size) for the single solid teal square."""
+    candidates: list[tuple[int, int, int]] = []
+    for cells in components_mask(g == teal, connectivity=4):
+        r0, c0, r1, c1 = bbox_coords(cells)
+        hh = r1 - r0 + 1
+        ww = c1 - c0 + 1
+        if hh != ww:
+            continue
+        size = hh
+        if int(np.sum(g[r0 : r1 + 1, c0 : c1 + 1] == teal)) != size * size:
+            continue
+        candidates.append((int(r0), int(c0), int(size)))
+    assert len(candidates) == 1, "main grid must contain exactly one solid teal square"
+    return candidates[0]
+
+
+def _rot(d: int, turn: str) -> int:
+    return (d - 1) % 4 if turn == "L" else (d + 1) % 4
+
+
+def _opp_turn(turn: str) -> str:
+    return "R" if turn == "L" else "L"
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int, sz: int) -> bool:
+    h, w = map(int, shape)
+    return 0 <= r and 0 <= c and r + sz - 1 < h and c + sz - 1 < w
+
+
+def _obstacle_color_at(arr: np.ndarray, r: int, c: int, sz: int, bg: int, teal: int) -> int | None:
+    blk = arr[r : r + sz, c : c + sz]
+    cols = set(map(int, np.unique(blk)))
+    cols.discard(bg)
+    cols.discard(teal)
+    if not cols:
+        return None
+    assert len(cols) == 1, "beam footprint must not hit mixed obstacle colors"
+    return int(next(iter(cols)))
+
+
+def _first_obstacle_in_direction(
+    base: np.ndarray, bg: int, teal: int, sr: int, sc: int, sz: int, d: int
+) -> tuple[int, int, int] | None:
+    """Trace straight from the source until the first obstacle or boundary."""
+    r, c = int(sr), int(sc)
+    while True:
+        dr, dc = _DIRS[d]
+        nr, nc = r + dr, c + dc
+        if not _in_bounds(base.shape, nr, nc, sz):
+            return None
+        oc = _obstacle_color_at(base, nr, nc, sz, bg, teal)
+        if oc is None:
+            r, c = nr, nc
+            continue
+        return oc, nr, nc
+
+
+def _find_start_direction(base: np.ndarray, bg: int, teal: int, sr: int, sc: int, sz: int) -> int:
+    """The variant launches only in the unique direction that can reach an obstacle."""
+    candidates = [
+        d for d in range(4)
+        if _first_obstacle_in_direction(base, bg, teal, sr, sc, sz, d) is not None
+    ]
+    assert len(candidates) == 1, "exactly one initial ray direction must be viable"
+    return int(candidates[0])
+
+
+def _trace_chain(
+    base: np.ndarray, turns: dict[int, str], bg: int
+) -> tuple[np.ndarray, list[tuple[int, int, int, int]], int]:
+    """Simulate the single chained beam and return painted output, hits, and start dir."""
+    teal = 8
+    sr, sc, sz = _find_teal_square(base, teal=teal)
+    start_d = _find_start_direction(base, bg, teal, sr, sc, sz)
+
+    out = base.copy()
+    r, c, d = int(sr), int(sc), int(start_d)
+    hits: list[tuple[int, int, int, int]] = []
+    seen: set[tuple[int, int, int]] = set()
+
+    def paint_block(rr: int, cc: int) -> None:
+        blk = out[rr : rr + sz, cc : cc + sz]
+        blk[blk == bg] = teal
+        out[rr : rr + sz, cc : cc + sz] = blk
+
+    while True:
+        state = (r, c, d)
+        assert state not in seen, "chain path must not cycle"
+        seen.add(state)
+
+        dr, dc = _DIRS[d]
+        nr, nc = r + dr, c + dc
+        if not _in_bounds(out.shape, nr, nc, sz):
+            break
+
+        oc = _obstacle_color_at(out, nr, nc, sz, bg, teal)
+        if oc is None:
+            r, c = nr, nc
+            paint_block(r, c)
+            continue
+
+        assert oc in turns, "obstacle color must be encoded by legend"
+        hits.append((d, oc, nr, nc))
+        d = _rot(d, turns[oc])
+
+    return out, hits, start_d
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Trace one teal ray from the square, letting it bend through a turn chain.
+
+    Input structure:
+    - Top band: a grey legend whose colored vertical bars still encode left-turn vs right-turn.
+    - Below: one solid teal square on a plain background, plus colored obstacle rectangles touching grid edges.
+
+    Rule:
+    - Remove the legend from the output.
+    - Determine the single cardinal direction from the teal square whose corridor can actually reach an obstacle.
+    - Move an sz-by-sz teal beam along that direction, painting background cells; whenever the next step would hit an obstacle, consult the legend and rotate the beam, then continue as the same ray.
+    - Stop only when the chained ray would leave the grid.
+
+    Key insight: The legend still maps colors to turns, but now only one source direction is initially aligned; that unique launch creates one continuous bent path instead of four independent beams.
+    """
+    g = np.asarray(grid, dtype=int)
+
+    legend_bg = 5
+    rows_with_legend = np.where(np.any(g == legend_bg, axis=1))[0]
+    assert rows_with_legend.size, "legend rows must be present"
+    legend_h = int(rows_with_legend.max() + 1)
+    assert np.array_equal(rows_with_legend, np.arange(legend_h)), "legend color must be confined to the top band"
+
+    legend_turn = _parse_legend(g, legend_h)
+    base = g[legend_h:, :].copy()
+    assert base.size, "main grid must remain after legend crop"
+
+    vals, cnts = np.unique(base, return_counts=True)
+    bg = int(vals[cnts.argmax()])
+    out, _hits, _start_d = _trace_chain(base, legend_turn, bg)
+    return out
+
+
+# --------------- generator (chain reaction variant) ---------------
+
+# Color palettes
+LEGEND_COLOR_POOL = [1, 2, 3, 4, 6]
+BG_COLOR_POOL = [1, 2, 3, 4, 6, 7, 9]
+LEGEND_BG = 5
+TEAL = 8
+
+# Canvas dimensions
+GRID_H_RANGE = (19, 24)
+GRID_W = 24
+LEGEND_H = 6
+LEGEND_CELL_STARTS = [1, 7, 13, 19]
+
+# Teal square
+TEAL_SZ2_PROB = 0.75
+SQUARE_EDGE_GAP = 5
+
+# Obstacles
+PATH_LEN_4_PROB = 0.55
+OBS_THICKNESS_RANGE = (2, 4)
+OBS_SINGLE_MARGIN = 6
+OBS_BOTH_GAP = 2
+
+# Span selection
+SPAN_MIN_MULT = 3
+SPAN_MAX_MULT = 14
+SPAN_COMPACT_PROB = 0.4
+
+# Retry budget
+MAX_RETRIES = 400
+
+
+def _choose_span(
+    axis_len: int,
+    required: list[tuple[int, int]],
+    excluded: list[tuple[int, int]],
+    min_len: int,
+    max_len: int,
+) -> tuple[int, int] | None:
+    """Pick a span that covers all required intervals while missing all excluded ones."""
+    req0 = min(a for a, _ in required)
+    req1 = max(b for _, b in required)
+    lo = max(min_len, req1 - req0 + 1)
+    hi = min(max_len, axis_len)
+    choices: list[tuple[int, int, int]] = []
+    for length in range(lo, hi + 1):
+        start0 = max(0, req1 - length + 1)
+        start1 = min(req0, axis_len - length)
+        for start in range(start0, start1 + 1):
+            end = start + length - 1
+            if all(end < a or start > b for a, b in excluded):
+                choices.append((length, start, end))
+    if not choices:
+        return None
+
+    lengths = sorted({length for length, _, _ in choices})
+    if random.random() < SPAN_COMPACT_PROB:
+        cutoff = lengths[min(len(lengths) - 1, max(0, len(lengths) // 2))]
+        pool = [(start, end) for length, start, end in choices if length <= cutoff]
+    else:
+        pool = [(start, end) for _, start, end in choices]
+    return random.choice(pool)
+
+
+def _make_legend(legend_colors: list[int], turns: dict[int, str]) -> np.ndarray:
+    legend = np.full((LEGEND_H, GRID_W), LEGEND_BG, dtype=int)
+    for start, color in zip(LEGEND_CELL_STARTS, legend_colors):
+        legend[1:5, start : start + 4] = 0
+        bar_col = start if turns[color] == "L" else start + 3
+        legend[1:5, bar_col] = color
+    return legend
+
+
+def _rand_thickness(lo: int, hi: int) -> int | None:
+    return random.randint(lo, hi) if hi >= lo else None
+
+
+def _thickness_pair(
+    axis: int, sz: int, a_present: bool, b_present: bool
+) -> tuple[int | None, int | None] | None:
+    lo, hi_cap = OBS_THICKNESS_RANGE
+    if a_present and b_present:
+        room = axis - sz - OBS_BOTH_GAP
+        if room < 2 * lo:
+            return None
+        a = random.randint(lo, min(hi_cap, room - lo))
+        b = _rand_thickness(lo, min(hi_cap, room - a))
+        return (a, b) if b is not None else None
+    if a_present:
+        t = _rand_thickness(lo, min(hi_cap, axis - sz - OBS_SINGLE_MARGIN))
+        return (t, None) if t is not None else None
+    if b_present:
+        t = _rand_thickness(lo, min(hi_cap, axis - sz - OBS_SINGLE_MARGIN))
+        return (None, t) if t is not None else None
+    return None, None
+
+
+def _obstacle_rect(
+    side: int, thickness: int, span: tuple[int, int], h: int, w: int
+) -> tuple[int, int, int, int]:
+    s0, s1 = span
+    if side == _N:
+        return 0, thickness - 1, s0, s1
+    if side == _S:
+        return h - thickness, h - 1, s0, s1
+    if side == _W:
+        return s0, s1, 0, thickness - 1
+    return s0, s1, w - thickness, w - 1
+
+
+def _lane_top(side: int, thickness: int, h: int, w: int, sz: int) -> int:
+    if side == _N:
+        return int(thickness)
+    if side == _S:
+        return int(h - thickness - sz)
+    if side == _W:
+        return int(thickness)
+    return int(w - thickness - sz)
+
+
+def _source_interval(side: int, sr: int, sc: int, sz: int) -> tuple[int, int]:
+    base = sc if side in (_N, _S) else sr
+    return int(base), int(base + sz - 1)
+
+
+def _lane_interval(side: int, lane: dict[int, int], sz: int) -> tuple[int, int]:
+    start = int(lane[side])
+    return start, int(start + sz - 1)
+
+
+def _add_corner_exclusions(
+    present: set[int],
+    thickness: dict[int, int],
+    excluded: dict[int, list[tuple[int, int]]],
+    h: int,
+    w: int,
+) -> None:
+    if _N in present:
+        if _W in present:
+            excluded[_N].append((0, thickness[_W] - 1))
+        if _E in present:
+            excluded[_N].append((w - thickness[_E], w - 1))
+    if _S in present:
+        if _W in present:
+            excluded[_S].append((0, thickness[_W] - 1))
+        if _E in present:
+            excluded[_S].append((w - thickness[_E], w - 1))
+    if _W in present:
+        if _N in present:
+            excluded[_W].append((0, thickness[_N] - 1))
+        if _S in present:
+            excluded[_W].append((h - thickness[_S], h - 1))
+    if _E in present:
+        if _N in present:
+            excluded[_E].append((0, thickness[_N] - 1))
+        if _S in present:
+            excluded[_E].append((h - thickness[_S], h - 1))
+
+
+def _build_constraints(
+    seq: list[int],
+    side_turn: dict[int, str],
+    sr: int,
+    sc: int,
+    sz: int,
+    lane: dict[int, int],
+    thickness: dict[int, int],
+    h: int,
+    w: int,
+) -> tuple[dict[int, list[tuple[int, int]]], dict[int, list[tuple[int, int]]]]:
+    present = set(seq)
+    required: dict[int, list[tuple[int, int]]] = {s: [] for s in present}
+    excluded: dict[int, list[tuple[int, int]]] = {s: [] for s in present}
+
+    for side in present:
+        iv = _source_interval(side, sr, sc, sz)
+        if side == seq[0]:
+            required[side].append(iv)
+        else:
+            excluded[side].append(iv)
+
+    for side, nxt in zip(seq, seq[1:], strict=False):
+        required[nxt].append(_lane_interval(side, lane, sz))
+
+    exit_side = _rot(seq[-1], side_turn[seq[-1]])
+    if exit_side in present:
+        excluded[exit_side].append(_lane_interval(seq[-1], lane, sz))
+
+    _add_corner_exclusions(present, thickness, excluded, h, w)
+    return required, excluded
+
+
+def _gen_attempt() -> np.ndarray | None:
+    h, w = random.randint(*GRID_H_RANGE), GRID_W
+    sz = 2 if random.random() < TEAL_SZ2_PROB else 3
+    path_len = 4 if random.random() < PATH_LEN_4_PROB else 3
+    step_turn = random.choice(["L", "R"])
+    start_side = random.randint(0, 3)
+
+    seq = [start_side]
+    for _ in range(path_len - 1):
+        seq.append(_rot(seq[-1], step_turn))
+    present = set(seq)
+
+    ns = _thickness_pair(h, sz, _N in present, _S in present)
+    ew = _thickness_pair(w, sz, _W in present, _E in present)
+    if ns is None or ew is None:
+        return None
+    thickness = {
+        side: t
+        for side, t in zip((_N, _S, _W, _E), (*ns, *ew))
+        if t is not None
+    }
+
+    min_r, max_r = SQUARE_EDGE_GAP, h - sz - SQUARE_EDGE_GAP
+    min_c, max_c = SQUARE_EDGE_GAP, w - sz - SQUARE_EDGE_GAP
+    if _N in present:
+        min_r = max(min_r, thickness[_N] + 1)
+    if _S in present:
+        max_r = min(max_r, h - thickness[_S] - sz - 1)
+    if _W in present:
+        min_c = max(min_c, thickness[_W] + 1)
+    if _E in present:
+        max_c = min(max_c, w - thickness[_E] - sz - 1)
+    if min_r > max_r or min_c > max_c:
+        return None
+    sr, sc = random.randint(min_r, max_r), random.randint(min_c, max_c)
+
+    lane = {
+        side: _lane_top(side, thickness[side], h, w, sz)
+        for side in present
+    }
+
+    side_turn = {side: step_turn for side in seq[:-1]}
+    side_turn[seq[-1]] = step_turn if path_len == 3 else _opp_turn(step_turn)
+    required, excluded = _build_constraints(
+        seq, side_turn, sr, sc, sz, lane, thickness, h, w
+    )
+
+    spans: dict[int, tuple[int, int]] = {}
+    for side in present:
+        axis_len = w if side in (_N, _S) else h
+        span = _choose_span(
+            axis_len,
+            required[side],
+            excluded[side],
+            SPAN_MIN_MULT * sz,
+            min(SPAN_MAX_MULT * sz, axis_len),
+        )
+        if span is None:
+            return None
+        spans[side] = span
+
+    legend_colors = random.sample(LEGEND_COLOR_POOL, 4)
+    chosen_colors = random.sample(legend_colors, len(present))
+    side_color = {side: color for side, color in zip(seq, chosen_colors)}
+    bg = random.choice([c for c in BG_COLOR_POOL if c not in legend_colors])
+
+    base = np.full((h, w), bg, dtype=int)
+    base[sr : sr + sz, sc : sc + sz] = TEAL
+    occupied = np.zeros((h, w), dtype=bool)
+
+    for side in present:
+        r0, r1, c0, c1 = _obstacle_rect(side, thickness[side], spans[side], h, w)
+        region = occupied[r0 : r1 + 1, c0 : c1 + 1]
+        if region.any():
+            return None
+        if not (r1 < sr - 1 or r0 > sr + sz or c1 < sc - 1 or c0 > sc + sz):
+            return None
+        occupied[r0 : r1 + 1, c0 : c1 + 1] = True
+        base[r0 : r1 + 1, c0 : c1 + 1] = side_color[side]
+
+    vals, cnts = np.unique(base, return_counts=True)
+    if int(vals[cnts.argmax()]) != bg:
+        return None
+
+    turns = {side_color[side]: side_turn[side] for side in present}
+    for color in legend_colors:
+        turns.setdefault(color, random.choice(["L", "R"]))
+
+    try:
+        expected, hits, start_d = _trace_chain(base, turns, bg)
+    except AssertionError:
+        return None
+
+    if start_d != seq[0]:
+        return None
+    if len(hits) != path_len:
+        return None
+    if {color for _d, color, _r, _c in hits} != set(side_color.values()):
+        return None
+
+    legend = _make_legend(legend_colors, turns)
+    inp = np.vstack([legend, base])
+    try:
+        actual = main(inp)
+    except AssertionError:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate e87109e9 D14 input")

