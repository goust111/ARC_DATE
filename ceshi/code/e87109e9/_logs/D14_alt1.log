    69	def _parse_legend(grid: np.ndarray, legend_h: int) -> dict[int, str]:
    70	    """
    71	    Legend is a top region with a background color (typically 5) and 4 vertical bars.
    72	    Each bar's horizontal position inside its cell encodes turn direction:
    73	      - bar on left  -> 'L' (turn counterclockwise)
    74	      - bar on right -> 'R' (turn clockwise)
    75	    """
    76	    legend = grid[:legend_h, :]
    77	    assert legend.size, "legend must be non-empty"
    78	    vals, cnts = np.unique(legend, return_counts=True)
    79	    bg = int(vals[cnts.argmax()])
    80	
    81	    sep_cols = [c for c in range(legend.shape[1]) if np.all(legend[:, c] == bg)]
    82	    assert len(sep_cols) >= 2, "legend separator columns must exist"
    83	
    84	    turn: dict[int, str] = {}
    85	    for a, b in zip(sep_cols, sep_cols[1:], strict=False):
    86	        if b - a <= 2:
    87	            continue
    88	        interior = legend[1 : legend_h - 1, a + 1 : b]
    89	        colors = set(map(int, np.unique(interior)))
    90	        colors.discard(bg)
    91	        colors.discard(0)
    92	        assert len(colors) == 1, "each legend cell must encode exactly one color"
    93	        col = int(next(iter(colors)))
    94	        xs = np.where(interior == col)[1]
    95	        x = int(xs[0])
    96	        turn[col] = "L" if x <= (interior.shape[1] - 1) // 2 else "R"
    97	    assert len(turn) == 4, "legend must encode four turn colors"
    98	    return turn
