+        present: list[int] = []
+        for (mr, mc), out_dir in _marker_candidates(side, bbox).items():
+            assert 0 <= mr < h and 0 <= mc < w, "marker slots must be in-bounds"
+            if int(grid[mr, mc]) == marker:
+                present.append(out_dir)
+        assert len(present) == 1, "each obstacle must have exactly one adjacent marker"
+
+        out_dir = present[0]
+        turn[col] = "L" if out_dir == _rot(side, "L") else "R"
+    assert 3 <= len(turn) <= 4, "expected 3-4 encoded obstacles"
+    return turn
