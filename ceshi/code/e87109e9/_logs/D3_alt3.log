+# Color palettes
+OBS_COLOR_POOL = [1, 2, 3, 4, 6]
+BG_COLOR_POOL = [1, 2, 3, 4, 6, 7, 9]
+MARKER = 5
+TEAL = 8
+
+# Canvas dimensions
+GRID_H_RANGE = (19, 24)
