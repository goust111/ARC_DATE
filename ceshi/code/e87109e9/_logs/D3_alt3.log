+    assert len(candidates) == 1, "grid must contain exactly one solid teal square"
+    return candidates[0]
+
+
+def _rot_ccw(d: int) -> int:
+    return (d - 1) % 4
+
+
+def _rot_cw(d: int) -> int:
+    return (d + 1) % 4
+
+
+def _rot(d: int, turn: str) -> int:
+    """Rotate direction d by turn ('L' = CCW, 'R' = CW)."""
+    return (d - 1) % 4 if turn == "L" else (d + 1) % 4
+
+
+def _obstacle_side(bbox: tuple[int, int, int, int], h: int, w: int) -> int:
+    """Identify which border an obstacle rectangle touches."""
+    r0, c0, r1, c1 = bbox
+    sides = []
+    if r0 == 0:
+        sides.append(_N)
+    if c1 == w - 1:
+        sides.append(_E)
+    if r1 == h - 1:
+        sides.append(_S)
+    if c0 == 0:
+        sides.append(_W)
+    assert len(sides) == 1, "each obstacle must touch exactly one grid edge"
+    return sides[0]
+
+
+def _marker_candidates(
+    side: int, bbox: tuple[int, int, int, int]
+) -> dict[tuple[int, int], int]:
+    """
+    Return the two legal marker cells for an obstacle and the outgoing direction they encode.
+
+    Horizontal bars use left/right side pixels.
+    Vertical bars use top/bottom side pixels.
+    """
+    r0, c0, r1, c1 = bbox
