+# Variant of e87109e9
+# Dimension: D3 — 图例编码方式 (symbol_instructions)
+# Change: 顶部灰色区域包含4个图例条目，每个为4行高的单色竖条在4格宽空间的左侧或右侧——左侧=逆时针，右侧=顺时针... → 无集中图例——规则由障碍物邻近像素编码
+
+import random
+
+import numpy as np
+
+from arc_utils import bbox_coords, components_mask
+
+# Design analysis for the D3 variant
+# ----------------------------------
+# spec_variant:
+#   input:
+#     canvas: single main grid only; the original 6x24 grey legend band is removed
+#     bg: one dominant background color from {1,2,3,4,6,7,9}, never 5 or 8
+#     source: exactly one solid teal square (8), size 2 or 3
+#     obstacles:
+#       count: 3-4 solid rectangles, each a distinct color from {1,2,3,4,6}
+#       placement: same edge-touching side bars as the source task
+#     local_instruction:
+#       marker_color: fixed grey 5
+#       one marker per obstacle, stored inside the main grid
+#       horizontal obstacle (top or bottom edge): marker is immediately left or right of the bar
+#       vertical obstacle (left or right edge): marker is immediately above or below the bar
+#       semantic: the marker indicates the global direction the beam will leave the obstacle toward
+#         left marker -> west, right marker -> east, top marker -> north, bottom marker -> south
+#   output:
+#     same canvas size as input; no cropping
+#     obstacles and markers stay in place
+#     four teal square-beams expand exactly as before, only over background cells
+#
+# behavior trace on the key changed step:
+#   original:
+#     beam hits obstacle color C -> read centralized top legend entry for C -> obtain L/R -> rotate
+#   variant:
+#     beam hits obstacle color C -> find that obstacle's own nearby grey pixel -> convert marker side
+#     to an outgoing global direction -> compare it with incoming direction to infer L/R -> rotate
+#   difference:
+#     color no longer indexes a global table; each obstacle is self-describing, and the instruction
+#     remains embedded beside the object instead of living in a removable header band
+#
+# complexity calibration:
+#   - The variant keeps 3-4 obstacles and 4-5 total hits, so the routing complexity stays comparable.
+#   - Marker color is unique and reused across obstacles, which gives repeated visual evidence without
+#     requiring a large palette or hidden color-order conventions.
+#   - The marker has only two slots per obstacle orientation, preventing unnecessary branching.
+#
+# main() assumption audit:
+#   - Old code assumed color 5 exists only in a top legend band and that rows containing 5 form a
+#     prefix. That is invalid now because grey is a sparse local marker inside the main grid.
+#   - Old code cropped away everything above the last grey row; in this variant that would destroy the
+#     puzzle. The solver must operate on the full input grid.
+#   - Old obstacle detection treated every non-bg/non-teal cell in the beam footprint as an obstacle.
+#     That would misclassify the new marker pixels unless grey 5 is explicitly ignored.
+#   - Old turn lookup was keyed only by obstacle color; now the turn depends on obstacle geometry plus
+#     the marker's adjacent slot, so the solver must reconstruct a local map per obstacle component.
+#
+# placement legality:
+#   - Each obstacle span is forced to leave a 1-cell margin at both ends along its long axis so that
+#     both possible marker slots stay in-bounds.
+#   - Marker cells are validated after obstacle placement; if another object already occupies a slot,
+#     the attempt is discarded and regenerated.
+#   - Marker slots are chosen on obstacle flanks that the beams do not travel through, keeping output
+#     traces visually clean.
+#
+# visual observability:
+#   - Humans can compare input and output and see that the beam always exits an obstacle toward the
+#     side carrying the grey pixel. This is visible from 2-3 examples without any hidden ordering.
+#   - The removed top band makes the D3 change immediately obvious even before tracing the beams.
+
+_DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+_N, _E, _S, _W = range(4)
+
+# Color palettes
+OBS_COLOR_POOL = [1, 2, 3, 4, 6]
+BG_COLOR_POOL = [1, 2, 3, 4, 6, 7, 9]
+MARKER = 5
+TEAL = 8
+
+# Canvas dimensions
+GRID_H_RANGE = (19, 24)
+GRID_W = 24
+
+# Teal square
+TEAL_SZ2_PROB = 0.75
+SQUARE_EDGE_GAP = 5
+
+# Obstacles
+OBS_COUNT_4_PROB = 0.65
+OBS_THICKNESS_RANGE = (2, 4)
+OBS_SINGLE_MARGIN = 6
+OBS_BOTH_GAP = 2
+
+# Span selection
+SPAN_MIN_MULT = 3
+SPAN_MAX_MULT = 14
+SPAN_COMPACT_PROB = 0.4
