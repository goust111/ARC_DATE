+# Variant of e87109e9
+# Dimension: D3 — 图例编码方式 (symbol_instructions)
+# Change: 顶部灰色区域包含4个图例条目，每个为4行高的单色竖条在4格宽空间的左侧或右侧——左侧=逆时针，右侧=顺时针... → 无集中图例——规则由障碍物邻近像素编码
+
+import random
+
+import numpy as np
+
+from arc_utils import bbox_coords, components_mask
+
+# Design analysis for the D3 variant
+# ----------------------------------
+# spec_variant:
+#   input:
+#     canvas: single main grid only; the original 6x24 grey legend band is removed
+#     bg: one dominant background color from {1,2,3,4,6,7,9}, never 5 or 8
+#     source: exactly one solid teal square (8), size 2 or 3
+#     obstacles:
+#       count: 3-4 solid rectangles, each a distinct color from {1,2,3,4,6}
+#       placement: same edge-touching side bars as the source task
+#     local_instruction:
+#       marker_color: fixed grey 5
+#       one marker per obstacle, stored inside the main grid
+#       horizontal obstacle (top or bottom edge): marker is immediately left or right of the bar
+#       vertical obstacle (left or right edge): marker is immediately above or below the bar
+#       semantic: the marker indicates the global direction the beam will leave the obstacle toward
+#         left marker -> west, right marker -> east, top marker -> north, bottom marker -> south
+#   output:
+#     same canvas size as input; no cropping
+#     obstacles and markers stay in place
+#     four teal square-beams expand exactly as before, only over background cells
+#
+# behavior trace on the key changed step:
+#   original:
+#     beam hits obstacle color C -> read centralized top legend entry for C -> obtain L/R -> rotate
+#   variant:
+#     beam hits obstacle color C -> find that obstacle's own nearby grey pixel -> convert marker side
+#     to an outgoing global direction -> compare it with incoming direction to infer L/R -> rotate
+#   difference:
+#     color no longer indexes a global table; each obstacle is self-describing, and the instruction
+#     remains embedded beside the object instead of living in a removable header band
+#
+# complexity calibration:
+#   - The variant keeps 3-4 obstacles and 4-5 total hits, so the routing complexity stays comparable.
+#   - Marker color is unique and reused across obstacles, which gives repeated visual evidence without
+#     requiring a large palette or hidden color-order conventions.
+#   - The marker has only two slots per obstacle orientation, preventing unnecessary branching.
+#
+# main() assumption audit:
+#   - Old code assumed color 5 exists only in a top legend band and that rows containing 5 form a
+#     prefix. That is invalid now because grey is a sparse local marker inside the main grid.
+#   - Old code cropped away everything above the last grey row; in this variant that would destroy the
+#     puzzle. The solver must operate on the full input grid.
+#   - Old obstacle detection treated every non-bg/non-teal cell in the beam footprint as an obstacle.
+#     That would misclassify the new marker pixels unless grey 5 is explicitly ignored.
+#   - Old turn lookup was keyed only by obstacle color; now the turn depends on obstacle geometry plus
+#     the marker's adjacent slot, so the solver must reconstruct a local map per obstacle component.
+#
+# placement legality:
+#   - Each obstacle span is forced to leave a 1-cell margin at both ends along its long axis so that
+#     both possible marker slots stay in-bounds.
+#   - Marker cells are validated after obstacle placement; if another object already occupies a slot,
+#     the attempt is discarded and regenerated.
+#   - Marker slots are chosen on obstacle flanks that the beams do not travel through, keeping output
+#     traces visually clean.
+#
+# visual observability:
+#   - Humans can compare input and output and see that the beam always exits an obstacle toward the
+#     side carrying the grey pixel. This is visible from 2-3 examples without any hidden ordering.
+#   - The removed top band makes the D3 change immediately obvious even before tracing the beams.
+
+_DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+_N, _E, _S, _W = range(4)
+
+# Color palettes
+OBS_COLOR_POOL = [1, 2, 3, 4, 6]
+BG_COLOR_POOL = [1, 2, 3, 4, 6, 7, 9]
+MARKER = 5
+TEAL = 8
+
+# Canvas dimensions
+GRID_H_RANGE = (19, 24)
+GRID_W = 24
+
+# Teal square
+TEAL_SZ2_PROB = 0.75
+SQUARE_EDGE_GAP = 5
+
+# Obstacles
+OBS_COUNT_4_PROB = 0.65
+OBS_THICKNESS_RANGE = (2, 4)
+OBS_SINGLE_MARGIN = 6
+OBS_BOTH_GAP = 2
+
+# Span selection
+SPAN_MIN_MULT = 3
+SPAN_MAX_MULT = 14
+SPAN_COMPACT_PROB = 0.4
+
+# Retry budget
+MAX_RETRIES = 300
+
+
+def _find_teal_square(g: np.ndarray, teal: int = TEAL) -> tuple[int, int, int]:
+    """Return (r0,c0,size) for a solid square teal component."""
+    candidates: list[tuple[int, int, int]] = []
+    for cells in components_mask(g == teal, connectivity=4):
+        r0, c0, r1, c1 = bbox_coords(cells)
+        hh = r1 - r0 + 1
+        ww = c1 - c0 + 1
+        if hh != ww:
+            continue
+        size = hh
+        if int(np.sum(g[r0 : r1 + 1, c0 : c1 + 1] == teal)) != size * size:
+            continue
+        candidates.append((int(r0), int(c0), int(size)))
+    assert len(candidates) == 1, "grid must contain exactly one solid teal square"
+    return candidates[0]
+
+
+def _rot_ccw(d: int) -> int:
+    return (d - 1) % 4
+
+
+def _rot_cw(d: int) -> int:
+    return (d + 1) % 4
+
+
+def _rot(d: int, turn: str) -> int:
+    """Rotate direction d by turn ('L' = CCW, 'R' = CW)."""
+    return (d - 1) % 4 if turn == "L" else (d + 1) % 4
+
+
+def _obstacle_side(bbox: tuple[int, int, int, int], h: int, w: int) -> int:
+    """Identify which border an obstacle rectangle touches."""
+    r0, c0, r1, c1 = bbox
+    sides = []
+    if r0 == 0:
+        sides.append(_N)
+    if c1 == w - 1:
+        sides.append(_E)
+    if r1 == h - 1:
+        sides.append(_S)
+    if c0 == 0:
+        sides.append(_W)
+    assert len(sides) == 1, "each obstacle must touch exactly one grid edge"
+    return sides[0]
+
+
+def _marker_candidates(
+    side: int, bbox: tuple[int, int, int, int]
+) -> dict[tuple[int, int], int]:
+    """
+    Return the two legal marker cells for an obstacle and the outgoing direction they encode.
+
+    Horizontal bars use left/right side pixels.
+    Vertical bars use top/bottom side pixels.
+    """
+    r0, c0, r1, c1 = bbox
+    mid_r = (r0 + r1) // 2
+    mid_c = (c0 + c1) // 2
+    if side in (_N, _S):
+        return {
+            (mid_r, c0 - 1): _W,
+            (mid_r, c1 + 1): _E,
+        }
+    return {
+        (r0 - 1, mid_c): _N,
+        (r1 + 1, mid_c): _S,
+    }
+
+
+def _parse_local_turns(
+    grid: np.ndarray, bg: int, teal: int = TEAL, marker: int = MARKER
+) -> dict[int, str]:
+    """Recover obstacle turn directions from their adjacent marker pixels."""
+    h, w = map(int, grid.shape)
+    turn: dict[int, str] = {}
+    obstacle_colors = sorted(set(map(int, np.unique(grid))) - {bg, teal, marker})
+    for col in obstacle_colors:
+        comps = components_mask(grid == col, connectivity=4)
+        assert len(comps) == 1, "each obstacle color must form exactly one component"
+        coords = comps[0]
+        bbox = bbox_coords(coords)
+        r0, c0, r1, c1 = bbox
+        assert int(coords.shape[0]) == (r1 - r0 + 1) * (c1 - c0 + 1), "obstacle must be rectangular"
+        side = _obstacle_side(bbox, h, w)
+
+        present: list[int] = []
+        for (mr, mc), out_dir in _marker_candidates(side, bbox).items():
+            assert 0 <= mr < h and 0 <= mc < w, "marker slots must be in-bounds"
+            if int(grid[mr, mc]) == marker:
+                present.append(out_dir)
+        assert len(present) == 1, "each obstacle must have exactly one adjacent marker"
+
+        out_dir = present[0]
+        turn[col] = "L" if out_dir == _rot(side, "L") else "R"
+    assert 3 <= len(turn) <= 4, "expected 3-4 encoded obstacles"
+    return turn
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Trace four teal beams through a field of locally annotated obstacles.
+
+    Input structure:
+    - A single main grid: background, one solid teal (8) square, 3-4 colored edge-touching obstacle bars,
+      and one grey (5) marker pixel beside each obstacle.
+    - There is no separate legend band to crop; the marker pixel is the instruction.
+
+    Rule:
+    - Keep the full canvas in the output.
+    - Launch one sz-by-sz teal beam in each cardinal direction from the source square.
+    - Each beam paints teal only onto background cells.
+    - When the next step would hit an obstacle, inspect that obstacle's adjacent grey marker:
+      left/right marker on a horizontal bar means the beam exits west/east, and top/bottom marker
+      on a vertical bar means the beam exits north/south. Convert that local cue into a CCW/CW turn
+      relative to the incoming beam and continue.
+    - Beams stop at the grid edges.
+
+    Key insight: Turn information is no longer centralized by obstacle color; every obstacle carries
+    its own instruction in the position of a nearby grey marker.
+    """
+    g = np.asarray(grid, dtype=int)
+
+    vals, counts = np.unique(g, return_counts=True)
+    bg = int(vals[counts.argmax()])
+    src = _find_teal_square(g, teal=TEAL)
+    sr, sc, sz = src
+    obstacle_turn = _parse_local_turns(g, bg, teal=TEAL, marker=MARKER)
+
+    out = g.copy()
+
+    def in_bounds(r: int, c: int) -> bool:
+        return 0 <= r and 0 <= c and r + sz - 1 < out.shape[0] and c + sz - 1 < out.shape[1]
+
+    def paint_block(r: int, c: int) -> None:
+        blk = out[r : r + sz, c : c + sz]
+        blk[blk == bg] = TEAL
+        out[r : r + sz, c : c + sz] = blk
+
+    def obstacle_color_at_next(nr: int, nc: int) -> int | None:
+        blk = out[nr : nr + sz, nc : nc + sz]
+        cols = set(map(int, np.unique(blk)))
+        cols.discard(bg)
+        cols.discard(TEAL)
+        cols.discard(MARKER)
+        if not cols:
+            return None
+        assert len(cols) == 1, "beam footprint must not hit mixed obstacle colors"
+        return int(next(iter(cols)))
+
+    for d0 in range(4):
+        r, c, d = sr, sc, d0
+        seen: set[tuple[int, int, int]] = set()
+        while True:
+            state = (r, c, d)
+            assert state not in seen, "beam path must not cycle"
+            seen.add(state)
+
+            dr, dc = _DIRS[d]
+            nr, nc = r + dr, c + dc
+            if not in_bounds(nr, nc):
+                break
+
+            oc = obstacle_color_at_next(nr, nc)
+            if oc is None:
+                r, c = nr, nc
+                paint_block(r, c)
+                continue
+
+            assert oc in obstacle_turn, "every obstacle color must carry a local instruction"
+            d = _rot_ccw(d) if obstacle_turn[oc] == "L" else _rot_cw(d)
+
+    return out
+
+
+def _choose_span(
+    axis_len: int,
+    required: list[tuple[int, int]],
+    excluded: list[tuple[int, int]],
+    min_len: int,
+    max_len: int,
+) -> tuple[int, int] | None:
+    """Pick a (start, end) span covering all required intervals, avoiding excluded ones."""
+    req0 = min(a for a, _ in required)
+    req1 = max(b for _, b in required)
+    lo = max(min_len, req1 - req0 + 1)
+    hi = min(max_len, axis_len - 2)
+    choices: list[tuple[int, int, int]] = []
+    for length in range(lo, hi + 1):
+        start0 = max(1, req1 - length + 1)
+        start1 = min(req0, axis_len - length - 1)
+        for start in range(start0, start1 + 1):
+            end = start + length - 1
+            if all(end < a or start > b for a, b in excluded):
+                choices.append((length, start, end))
+    if not choices:
+        return None
+
+    lengths = sorted({length for length, _, _ in choices})
+    if random.random() < SPAN_COMPACT_PROB:
+        cutoff = lengths[min(len(lengths) - 1, max(0, len(lengths) // 2))]
+        pool = [(start, end) for length, start, end in choices if length <= cutoff]
+    else:
+        pool = [(start, end) for _, start, end in choices]
+    return random.choice(pool)
+
+
+def _simulate_paths(
+    base: np.ndarray, turns: dict[int, str], bg: int
+) -> tuple[np.ndarray, list[list[tuple[int, int, int, int]]]]:
+    """Simulate 4 beams from the teal square, returning painted grid and per-beam hit lists."""
+    vals, counts = np.unique(base, return_counts=True)
+    assert int(vals[counts.argmax()]) == bg
+
+    teal_locs = np.argwhere(base == TEAL)
+    assert teal_locs.size
+    sr, sc = teal_locs.min(axis=0)
+    r1, c1 = teal_locs.max(axis=0)
+    sz = int(r1 - sr + 1)
+    assert sz == int(c1 - sc + 1)
+
+    out = base.copy()
+    h, w = out.shape
+    hits: list[list[tuple[int, int, int, int]]] = []
+
+    def in_bounds(r: int, c: int) -> bool:
+        return 0 <= r and 0 <= c and r + sz - 1 < h and c + sz - 1 < w
+
+    def paint(r: int, c: int) -> None:
+        blk = out[r : r + sz, c : c + sz]
+        blk[blk == bg] = TEAL
+
+    def obstacle_at(r: int, c: int) -> int | None:
+        colors = set(map(int, np.unique(out[r : r + sz, c : c + sz])))
+        colors.discard(bg)
+        colors.discard(TEAL)
+        colors.discard(MARKER)
+        if not colors:
+            return None
+        assert len(colors) == 1
+        return int(next(iter(colors)))
+
+    for d0 in range(4):
+        r, c, d = int(sr), int(sc), d0
+        beam_hits: list[tuple[int, int, int, int]] = []
+        seen: set[tuple[int, int, int]] = set()
+        while True:
+            state = (r, c, d)
+            assert state not in seen
+            seen.add(state)
+            dr, dc = _DIRS[d]
+            nr, nc = r + dr, c + dc
+            if not in_bounds(nr, nc):
+                break
+            obs = obstacle_at(nr, nc)
+            if obs is None:
+                r, c = nr, nc
+                paint(r, c)
+                continue
+            assert obs in turns
+            beam_hits.append((d, obs, nr, nc))
+            d = _rot(d, turns[obs])
+            assert len(beam_hits) <= 2
+        hits.append(beam_hits)
+
+    return out, hits
+
+
+def _rand_thickness(lo: int, hi: int) -> int | None:
+    """Return random thickness in [lo, hi], or None if infeasible."""
+    return random.randint(lo, hi) if hi >= lo else None
+
+
+def _thickness_pair(
+    axis: int, sz: int, a_present: bool, b_present: bool
+) -> tuple[int | None, int | None] | None:
+    """Compute obstacle thicknesses for the two ends of an axis (N/S or W/E)."""
+    lo, hi_cap = OBS_THICKNESS_RANGE
+    if a_present and b_present:
+        room = axis - sz - OBS_BOTH_GAP
+        if room < 2 * lo:
+            return None
+        a = random.randint(lo, min(hi_cap, room - lo))
+        b = _rand_thickness(lo, min(hi_cap, room - a))
+        return (a, b) if b is not None else None
+    if a_present:
+        t = _rand_thickness(lo, min(hi_cap, axis - sz - OBS_SINGLE_MARGIN))
+        return (t, None) if t is not None else None
+    if b_present:
+        t = _rand_thickness(lo, min(hi_cap, axis - sz - OBS_SINGLE_MARGIN))
+        return (None, t) if t is not None else None
+    return None, None
+
+
+def _obstacle_rect(
+    side: int, thickness: int, span: tuple[int, int], h: int, w: int
+) -> tuple[int, int, int, int]:
+    """Return (r0, r1, c0, c1) for an edge-touching obstacle rectangle."""
+    s0, s1 = span
+    if side == _N:
+        return 0, thickness - 1, s0, s1
+    if side == _S:
+        return h - thickness, h - 1, s0, s1
+    if side == _W:
+        return s0, s1, 0, thickness - 1
+    return s0, s1, w - thickness, w - 1
+
+
+def _select_chains(
+    present: set[int], second_hits: int
+) -> dict[int, int] | None:
+    """Pick non-overlapping (source -> adjacent target) pairs for multi-bounce beams."""
+    candidates = [
+        (side, nxt)
+        for side in present
+        for nxt in ((side - 1) % 4, (side + 1) % 4)
+        if nxt in present
+    ]
+    random.shuffle(candidates)
+    selected: list[tuple[int, int]] = []
+    used: set[int] = set()
+    for side, nxt in candidates:
+        if len(selected) == second_hits:
+            break
+        if side in used or nxt in used:
+            continue
+        selected.append((side, nxt))
+        used.update((side, nxt))
+    return dict(selected) if len(selected) == second_hits else None
+
+
+def _assign_turns(
+    present: set[int], chains: dict[int, int]
+) -> dict[int, str]:
+    """Assign L/R turn direction for each obstacle side."""
+    side_turn: dict[int, str] = {}
+    for side in present:
+        if side in chains:
+            nxt = chains[side]
+            side_turn[side] = "L" if nxt == (side - 1) % 4 else "R"
+        else:
+            outward = [t for t in ("L", "R") if _rot(side, t) not in present]
+            side_turn[side] = random.choice(outward if outward else ["L", "R"])
+    return side_turn
+
+
+def _compute_span_constraints(
+    present: set[int],
+    side_turn: dict[int, str],
+    chains: dict[int, int],
+    sr: int,
+    sc: int,
+    sz: int,
+    lane: dict[int, int],
+) -> tuple[dict[int, list[tuple[int, int]]], dict[int, list[tuple[int, int]]]]:
+    """Build required/excluded intervals for each obstacle's span selection."""
+    required: dict[int, list[tuple[int, int]]] = {s: [] for s in present}
+    excluded: dict[int, list[tuple[int, int]]] = {s: [] for s in present}
+
+    for side in present:
+        base_coord = sc if side in (_N, _S) else sr
+        required[side].append((base_coord, base_coord + sz - 1))
+
+    def lane_interval(s: int) -> tuple[int, int]:
+        return lane[s], lane[s] + sz - 1
+
+    for side in present:
+        nxt = _rot(side, side_turn[side])
+        if nxt not in present:
+            continue
+        if chains.get(side) == nxt:
+            required[nxt].append(lane_interval(side))
+            after = _rot(nxt, side_turn[nxt])
+            if after in present:
+                excluded[after].append(lane_interval(nxt))
+        else:
+            excluded[nxt].append(lane_interval(side))
+
+    return required, excluded
+
+
+def _marker_pos_for_rect(
+    side: int, rect: tuple[int, int, int, int], turn: str
+) -> tuple[int, int]:
+    """Place the marker on the side that matches the beam's outgoing global direction."""
+    r0, r1, c0, c1 = rect
+    bbox = (r0, c0, r1, c1)
+    out_dir = _rot(side, turn)
+    slots = _marker_candidates(side, bbox)
+    matching = [pos for pos, encoded_out in slots.items() if encoded_out == out_dir]
+    assert len(matching) == 1
+    return matching[0]
+
+
+def _gen_attempt() -> np.ndarray | None:
+    h, w = random.randint(*GRID_H_RANGE), GRID_W
+    sz = 2 if random.random() < TEAL_SZ2_PROB else 3
+    obstacle_count = 4 if random.random() < OBS_COUNT_4_PROB else 3
+    present = set(random.sample([_N, _E, _S, _W], obstacle_count))
+    target_hits = random.choice([4, 5])
+    second_hits = target_hits - obstacle_count
+    if second_hits < 0 or second_hits > 2:
+        return None
+
+    ns = _thickness_pair(h, sz, _N in present, _S in present)
+    ew = _thickness_pair(w, sz, _W in present, _E in present)
+    if ns is None or ew is None:
+        return None
+    thickness = {s: t for s, t in zip((_N, _S, _W, _E), (*ns, *ew)) if t is not None}
+
+    min_r, max_r = SQUARE_EDGE_GAP, h - sz - SQUARE_EDGE_GAP
+    min_c, max_c = SQUARE_EDGE_GAP, w - sz - SQUARE_EDGE_GAP
+    if _N in present:
+        min_r = max(min_r, thickness[_N] + 1)
+    if _S in present:
+        max_r = min(max_r, h - thickness[_S] - sz - 1)
+    if _W in present:
+        min_c = max(min_c, thickness[_W] + 1)
+    if _E in present:
+        max_c = min(max_c, w - thickness[_E] - sz - 1)
+    if min_r > max_r or min_c > max_c:
+        return None
+    sr, sc = random.randint(min_r, max_r), random.randint(min_c, max_c)
+
+    lane = {}
+    if _N in present:
+        lane[_N] = thickness[_N] + 1
+    if _S in present:
+        lane[_S] = h - thickness[_S] - sz
+    if _W in present:
+        lane[_W] = thickness[_W] + 1
+    if _E in present:
+        lane[_E] = w - thickness[_E] - sz
+
+    chains = _select_chains(present, second_hits)
+    if chains is None:
+        return None
+
+    side_turn = _assign_turns(present, chains)
+    required, excluded = _compute_span_constraints(
+        present, side_turn, chains, sr, sc, sz, lane
+    )
+
+    spans: dict[int, tuple[int, int]] = {}
+    for side in present:
+        axis_len = w if side in (_N, _S) else h
+        span = _choose_span(
+            axis_len,
+            required[side],
+            excluded[side],
+            SPAN_MIN_MULT * sz,
+            min(SPAN_MAX_MULT * sz, axis_len),
+        )
+        if span is None:
+            return None
+        spans[side] = span
+
+    obstacle_colors = random.sample(OBS_COLOR_POOL, obstacle_count)
+    side_color = dict(zip(sorted(present), obstacle_colors))
+    bg = random.choice([c for c in BG_COLOR_POOL if c not in obstacle_colors])
+
+    base = np.full((h, w), bg, dtype=int)
+    base[sr : sr + sz, sc : sc + sz] = TEAL
+    occupied = np.zeros((h, w), dtype=bool)
+    rects: dict[int, tuple[int, int, int, int]] = {}
+    for side in present:
+        rect = _obstacle_rect(side, thickness[side], spans[side], h, w)
