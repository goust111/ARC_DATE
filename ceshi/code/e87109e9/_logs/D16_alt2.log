+def _parse_legend(grid: np.ndarray, legend_h: int) -> dict[int, str]:
+    legend = grid[:legend_h, :]
+    assert legend.size, "legend must be non-empty"
+    vals, cnts = np.unique(legend, return_counts=True)
+    bg = int(vals[cnts.argmax()])
+
+    sep_cols = [c for c in range(legend.shape[1]) if np.all(legend[:, c] == bg)]
+    assert len(sep_cols) >= 2, "legend separator columns must exist"
+
+    turn: dict[int, str] = {}
+    for a, b in zip(sep_cols, sep_cols[1:], strict=False):
+        if b - a <= 2:
+            continue
+        interior = legend[1 : legend_h - 1, a + 1 : b]
+        colors = set(map(int, np.unique(interior)))
+        colors.discard(bg)
+        colors.discard(0)
+        assert len(colors) == 1, "each legend cell must encode exactly one color"
+        color = int(next(iter(colors)))
+        xs = np.where(interior == color)[1]
+        x = int(xs[0])
+        turn[color] = "L" if x <= (interior.shape[1] - 1) // 2 else "R"
+    assert len(turn) == 4, "legend must encode four turn colors"
+    return turn
+
+
+def _find_teal_square(g: np.ndarray, teal: int = 8) -> tuple[int, int, int]:
+    candidates: list[tuple[int, int, int]] = []
+    for cells in components_mask(g == teal, connectivity=4):
+        r0, c0, r1, c1 = bbox_coords(cells)
+        hh = r1 - r0 + 1
+        ww = c1 - c0 + 1
+        if hh != ww:
+            continue
+        size = hh
+        if int(np.sum(g[r0 : r1 + 1, c0 : c1 + 1] == teal)) != size * size:
+            continue
+        candidates.append((int(r0), int(c0), int(size)))
+    assert len(candidates) == 1, "main grid must contain exactly one solid teal square"
+    return candidates[0]
+
+
+def _rot_ccw(d: int) -> int:
+    return (d - 1) % 4
+
+
+def _rot_cw(d: int) -> int:
+    return (d + 1) % 4
+
+
+def _touches_boundary(r: int, c: int, h: int, w: int, sz: int) -> bool:
+    return r == 0 or c == 0 or r + sz == h or c + sz == w
+
+
+def _at_corner(r: int, c: int, d: int, h: int, w: int, sz: int) -> bool:
+    if d == _N:
+        return r == 0 and (c == 0 or c + sz == w)
+    if d == _E:
+        return c + sz == w and (r == 0 or r + sz == h)
+    if d == _S:
+        return r + sz == h and (c == 0 or c + sz == w)
+    return c == 0 and (r == 0 or r + sz == h)
+
+
+def _simulate_beams(
+    base: np.ndarray,
+    turns: dict[int, str],
+    bg: int,
+    *,
+    slide_at_edge: bool,
+) -> tuple[np.ndarray, list[list[tuple[int, int, int, int, bool]]], dict[str, object]]:
+    teal = 8
+    vals, counts = np.unique(base, return_counts=True)
+    assert int(vals[counts.argmax()]) == bg
+
+    sr, sc, sz = _find_teal_square(base, teal=teal)
+    out = base.copy()
+    h, w = out.shape
+    hits: list[list[tuple[int, int, int, int, bool]]] = []
+    metrics: dict[str, object] = {
+        "edge_turns_total": 0,
+        "edge_turns_per_beam": [0, 0, 0, 0],
+        "boundary_hit_count": 0,
+    }
+
+    def in_bounds(r: int, c: int) -> bool:
+        return 0 <= r and 0 <= c and r + sz - 1 < h and c + sz - 1 < w
+
+    def paint_block(r: int, c: int) -> None:
+        blk = out[r : r + sz, c : c + sz]
+        blk[blk == bg] = teal
+        out[r : r + sz, c : c + sz] = blk
+
+    def obstacle_color_at_next(nr: int, nc: int) -> int | None:
+        blk = out[nr : nr + sz, nc : nc + sz]
+        cols = set(map(int, np.unique(blk)))
+        cols.discard(bg)
+        cols.discard(teal)
+        if not cols:
+            return None
+        assert len(cols) == 1, "beam footprint must not hit mixed obstacle colors"
+        return int(next(iter(cols)))
+
+    for d0 in range(4):
+        r, c, d = sr, sc, d0
+        beam_hits: list[tuple[int, int, int, int, bool]] = []
+        seen: set[tuple[int, int, int]] = set()
+        while True:
+            state = (r, c, d)
+            assert state not in seen, "beam path must not cycle"
+            seen.add(state)
+
+            dr, dc = _DIRS[d]
+            nr, nc = r + dr, c + dc
+            if not in_bounds(nr, nc):
+                if not slide_at_edge or _at_corner(r, c, d, h, w, sz):
+                    break
+                d = _rot_cw(d)
+                metrics["edge_turns_total"] = int(metrics["edge_turns_total"]) + 1
+                edge_turns_per_beam = metrics["edge_turns_per_beam"]
+                assert isinstance(edge_turns_per_beam, list)
+                edge_turns_per_beam[d0] += 1
+                continue
+
+            obs = obstacle_color_at_next(nr, nc)
+            if obs is None:
+                r, c = nr, nc
+                paint_block(r, c)
+                continue
+
+            assert obs in turns, "obstacle color must be encoded by legend"
+            from_edge = _touches_boundary(r, c, h, w, sz)
+            if from_edge:
+                metrics["boundary_hit_count"] = int(metrics["boundary_hit_count"]) + 1
+            beam_hits.append((d, obs, nr, nc, from_edge))
+            d = _rot_ccw(d) if turns[obs] == "L" else _rot_cw(d)
+        hits.append(beam_hits)
+
+    return out, hits, metrics
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Launch four teal square-beams, and let border contact create clockwise wall-following traces.
+
+    Input structure:
+    - A 6-row legend band sits on top, with four colored vertical bars on grey background; the bar's left/right
+      placement inside its cell tells whether that color causes a left or right turn.
+    - Below the legend is the main field: one solid teal square, a single background color, and several
+      solid obstacle rectangles touching outer grid edges.
+
+    Rule:
+    - Drop the legend band in the output.
+    - From the teal square, emit one sz x sz beam footprint in each cardinal direction, painting only background
+      cells teal as it advances.
+    - If the next footprint would overlap an obstacle color, turn according to the legend and continue from the
+      same position.
+    - If the next footprint would leave the grid, do not stop immediately: turn clockwise and slide along the
+      border instead. Stop only when that border trace reaches a corner or a cycle would otherwise occur.
+
+    Key insight: The legend still controls obstacle turns, but the grid border now acts like an extra clockwise
+    turning guide, so missing edge obstacles produce visible L-shaped boundary traces instead of dead ends.
+    """
+    g = np.asarray(grid, dtype=int)
+
+    legend_bg = 5
+    rows_with_legend = np.where(np.any(g == legend_bg, axis=1))[0]
+    assert rows_with_legend.size, "legend rows must be present"
+    legend_h = int(rows_with_legend.max() + 1)
+    assert np.array_equal(rows_with_legend, np.arange(legend_h)), "legend color must be confined to the top band"
+
+    legend_turn = _parse_legend(g, legend_h)
+    base = g[legend_h:, :].copy()
+    assert base.size, "main grid must remain after legend crop"
+
+    vals, cnts = np.unique(base, return_counts=True)
+    bg = int(vals[cnts.argmax()])
+    out, _hits, _metrics = _simulate_beams(base, legend_turn, bg, slide_at_edge=True)
+    return out
+
+
+# --------------- generator (D16 variant) ---------------
+
+LEGEND_COLOR_POOL = [1, 2, 3, 4, 6]
+BG_COLOR_POOL = [1, 2, 3, 4, 6, 7, 9]
+LEGEND_BG = 5
+TEAL = 8
+
+GRID_H_RANGE = (19, 24)
+GRID_W = 24
+LEGEND_H = 6
+LEGEND_CELL_STARTS = [1, 7, 13, 19]
+
+TEAL_SZ2_PROB = 0.75
+SQUARE_EDGE_GAP = 5
+OBS_THICKNESS_RANGE = (2, 4)
+OBS_SINGLE_MARGIN = 6
+OBS_BOTH_GAP = 2
+SPAN_MIN_MULT = 3
+SPAN_MAX_MULT = 14
+SPAN_COMPACT_PROB = 0.45
+MAX_RETRIES = 400
+
+
+def _rot(d: int, turn: str) -> int:
+    return (d - 1) % 4 if turn == "L" else (d + 1) % 4
+
+
+def _make_legend(legend_colors: list[int], turns: dict[int, str]) -> np.ndarray:
+    legend = np.full((LEGEND_H, GRID_W), LEGEND_BG, dtype=int)
+    for start, color in zip(LEGEND_CELL_STARTS, legend_colors):
+        legend[1:5, start : start + 4] = 0
+        bar_col = start if turns[color] == "L" else start + 3
+        legend[1:5, bar_col] = color
+    return legend
+
+
+def _rand_thickness(lo: int, hi: int) -> int | None:
+    return random.randint(lo, hi) if hi >= lo else None
+
+
+def _thickness_pair(
+    axis: int,
+    sz: int,
+    a_present: bool,
+    b_present: bool,
+) -> tuple[int | None, int | None] | None:
+    lo, hi_cap = OBS_THICKNESS_RANGE
+    if a_present and b_present:
+        room = axis - sz - OBS_BOTH_GAP
+        if room < 2 * lo:
+            return None
+        a = random.randint(lo, min(hi_cap, room - lo))
+        b = _rand_thickness(lo, min(hi_cap, room - a))
+        return (a, b) if b is not None else None
+    if a_present:
+        t = _rand_thickness(lo, min(hi_cap, axis - sz - OBS_SINGLE_MARGIN))
+        return (t, None) if t is not None else None
+    if b_present:
+        t = _rand_thickness(lo, min(hi_cap, axis - sz - OBS_SINGLE_MARGIN))
+        return (None, t) if t is not None else None
+    return None, None
+
+
+def _obstacle_rect(
+    side: int,
+    thickness: int,
+    span: tuple[int, int],
+    h: int,
+    w: int,
+) -> tuple[int, int, int, int]:
+    s0, s1 = span
+    if side == _N:
+        return 0, thickness - 1, s0, s1
+    if side == _S:
+        return h - thickness, h - 1, s0, s1
+    if side == _W:
+        return s0, s1, 0, thickness - 1
+    return s0, s1, w - thickness, w - 1
+
+
+def _pick_span(
+    lo_bound: int,
+    hi_bound: int,
+    required: list[tuple[int, int]],
+    min_len: int,
+    max_len: int,
+) -> tuple[int, int] | None:
+    req0 = min(a for a, _ in required)
+    req1 = max(b for _, b in required)
+    axis_len = hi_bound - lo_bound + 1
+    lo = max(min_len, req1 - req0 + 1)
+    hi = min(max_len, axis_len)
+    if lo > hi:
+        return None
+
+    choices: list[tuple[int, int, int]] = []
+    for length in range(lo, hi + 1):
+        start0 = max(lo_bound, req1 - length + 1)
+        start1 = min(req0, hi_bound - length + 1)
+        for start in range(start0, start1 + 1):
+            end = start + length - 1
+            choices.append((length, start, end))
+    if not choices:
+        return None
+
+    lengths = sorted({length for length, _, _ in choices})
+    if random.random() < SPAN_COMPACT_PROB:
+        cutoff = lengths[min(len(lengths) - 1, len(lengths) // 2)]
+        pool = [(start, end) for length, start, end in choices if length <= cutoff]
+    else:
+        pool = [(start, end) for _, start, end in choices]
+    return random.choice(pool)
+
+
+def _direct_interval(side: int, sr: int, sc: int, sz: int) -> tuple[int, int]:
+    if side in (_N, _S):
+        return sc, sc + sz - 1
+    return sr, sr + sz - 1
+
+
+def _boundary_interval(
+    missing_side: int,
+    catch_side: int,
+    h: int,
+    w: int,
+    sz: int,
+) -> tuple[int, int]:
+    if catch_side in (_W, _E):
+        if missing_side == _N:
+            return 0, sz - 1
+        assert missing_side == _S
+        return h - sz, h - 1
+    if missing_side == _E:
+        return w - sz, w - 1
+    assert missing_side == _W
+    return 0, sz - 1
+
+
+def _allowed_axis_window(
+    side: int,
+    present: set[int],
+    thickness: dict[int, int],
+    h: int,
+    w: int,
+) -> tuple[int, int]:
+    if side in (_W, _E):
+        lo = thickness[_N] if _N in present else 0
+        hi = h - thickness[_S] - 1 if _S in present else h - 1
+        return lo, hi
+    lo = thickness[_W] if _W in present else 0
+    hi = w - thickness[_E] - 1 if _E in present else w - 1
+    return lo, hi
+
+
+def _assign_side_turns(present: set[int], missing_side: int) -> dict[int, str]:
+    catch_side = _rot_cw(missing_side)
+    others = sorted(present - {catch_side})
+    assert len(others) == 2
+
+    side_turn = {catch_side: "R"}
+    forced_left = random.choice(others)
+    for side in others:
+        if side == forced_left:
+            side_turn[side] = "L"
+        else:
+            side_turn[side] = random.choice(["L", "R"])
+    return side_turn
+
+
+def _gen_attempt() -> np.ndarray | None:
+    h, w = random.randint(*GRID_H_RANGE), GRID_W
+    sz = 2 if random.random() < TEAL_SZ2_PROB else 3
+
+    missing_side = random.choice([_N, _E, _S, _W])
+    present = {_N, _E, _S, _W} - {missing_side}
+    catch_side = _rot_cw(missing_side)
+
+    ns = _thickness_pair(h, sz, _N in present, _S in present)
+    ew = _thickness_pair(w, sz, _W in present, _E in present)
+    if ns is None or ew is None:
+        return None
+    thickness = {s: t for s, t in zip((_N, _S, _W, _E), (*ns, *ew)) if t is not None}
+
+    min_r, max_r = SQUARE_EDGE_GAP, h - sz - SQUARE_EDGE_GAP
+    min_c, max_c = SQUARE_EDGE_GAP, w - sz - SQUARE_EDGE_GAP
+    if _N in present:
+        min_r = max(min_r, thickness[_N] + 1)
+    if _S in present:
+        max_r = min(max_r, h - thickness[_S] - sz - 1)
+    if _W in present:
+        min_c = max(min_c, thickness[_W] + 1)
+    if _E in present:
+        max_c = min(max_c, w - thickness[_E] - sz - 1)
+    if min_r > max_r or min_c > max_c:
+        return None
+
+    sr = random.randint(min_r, max_r)
+    sc = random.randint(min_c, max_c)
+
+    side_turn = _assign_side_turns(present, missing_side)
+    required: dict[int, list[tuple[int, int]]] = {}
+    spans: dict[int, tuple[int, int]] = {}
