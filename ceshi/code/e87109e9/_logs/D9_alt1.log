   294	def _rand_thickness(lo: int, hi: int) -> int | None:
   295	    return random.randint(lo, hi) if hi >= lo else None
   296	
   297	
   298	def _thickness_pair(
   299	    axis: int, source_w: int, a_present: bool, b_present: bool
   300	) -> tuple[int | None, int | None] | None:
   301	    lo, hi_cap = OBS_THICKNESS_RANGE
   302	    if a_present and b_present:
   303	        room = axis - source_w - OBS_BOTH_GAP
   304	        if room < 2 * lo:
   305	            return None
   306	        a = random.randint(lo, min(hi_cap, room - lo))
   307	        b = _rand_thickness(lo, min(hi_cap, room - a))
   308	        return (a, b) if b is not None else None
   309	    if a_present:
   310	        t = _rand_thickness(lo, min(hi_cap, axis - source_w - OBS_SINGLE_MARGIN))
   311	        return (t, None) if t is not None else None
   312	    if b_present:
   313	        t = _rand_thickness(lo, min(hi_cap, axis - source_w - OBS_SINGLE_MARGIN))
   314	        return (None, t) if t is not None else None
   315	    return None, None
