   129	def _rot_ccw(d: int) -> int:
   130	    return (d - 1) % 4
   131	
   132	
   133	def _rot_cw(d: int) -> int:
   134	    return (d + 1) % 4
   135	
   136	
   137	def _rot(d: int, turn: str) -> int:
   138	    return _rot_ccw(d) if turn == "L" else _rot_cw(d)
