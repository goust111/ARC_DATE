+        return None
+    thickness = {s: t for s, t in zip((_N, _S, _W, _E), (*ns, *ew)) if t is not None}
+
+    min_r, max_r = SQUARE_EDGE_GAP, h - INITIAL_WIDTH - SQUARE_EDGE_GAP
+    min_c, max_c = SQUARE_EDGE_GAP, w - INITIAL_WIDTH - SQUARE_EDGE_GAP
+    if _N in present:
+        min_r = max(min_r, thickness[_N] + 2)
+    if _S in present:
+        max_r = min(max_r, h - thickness[_S] - INITIAL_WIDTH - 2)
+    if _W in present:
+        min_c = max(min_c, thickness[_W] + 2)
+    if _E in present:
+        max_c = min(max_c, w - thickness[_E] - INITIAL_WIDTH - 2)
+    if min_r > max_r or min_c > max_c:
+        return None
+
+    src_choices = [
+        (r, c)
+        for r in range(min_r, max_r + 1)
+        for c in range(min_c, max_c + 1)
+    ]
+    random.shuffle(src_choices)
+
+    for sr, sc in src_choices[:80]:
+        first_stop = {
+            side: _stop_before_side(sr, sc, side, INITIAL_WIDTH, thickness, h, w)
+            for side in present
+        }
+        first_lengths = {side: seg_len for side, (_r, _c, seg_len) in first_stop.items()}
+        if any(seg_len <= 0 for seg_len in first_lengths.values()):
+            continue
+        if not any(seg_len <= 4 for seg_len in first_lengths.values()):
