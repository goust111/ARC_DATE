   141	def _next_width(width: int, segment_len: int) -> int:
   142	    """Long segments widen; short segments narrow, but width stays positive."""
   143	    if segment_len >= GROW_THRESHOLD:
   144	        return width + 1
   145	    return max(1, width - 1)
