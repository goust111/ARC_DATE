   285	def _make_legend(legend_colors: list[int], turns: dict[int, str]) -> np.ndarray:
   286	    legend = np.full((LEGEND_H, GRID_W), LEGEND_BG, dtype=int)
   287	    for start, color in zip(LEGEND_CELL_STARTS, legend_colors):
   288	        legend[1:5, start : start + 4] = 0
   289	        bar_col = start if turns[color] == "L" else start + 3
   290	        legend[1:5, bar_col] = color
   291	    return legend
