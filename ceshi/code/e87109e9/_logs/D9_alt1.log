   253	def _choose_span(
   254	    axis_len: int,
   255	    required: list[tuple[int, int]],
   256	    excluded: list[tuple[int, int]],
   257	    min_len: int,
   258	    max_len: int,
   259	) -> tuple[int, int] | None:
   260	    """Pick a span covering all required intervals and avoiding all excluded ones."""
   261	    req0 = min(a for a, _ in required)
   262	    req1 = max(b for _, b in required)
   263	    lo = max(min_len, req1 - req0 + 1)
   264	    hi = min(max_len, axis_len)
   265	    choices: list[tuple[int, int, int]] = []
   266	    for length in range(lo, hi + 1):
   267	        start0 = max(0, req1 - length + 1)
   268	        start1 = min(req0, axis_len - length)
   269	        for start in range(start0, start1 + 1):
   270	            end = start + length - 1
   271	            if all(end < a or start > b for a, b in excluded):
   272	                choices.append((length, start, end))
   273	    if not choices:
   274	        return None
   275	
   276	    lengths = sorted({length for length, _, _ in choices})
   277	    if random.random() < SPAN_COMPACT_PROB:
   278	        cutoff = lengths[min(len(lengths) - 1, max(0, len(lengths) // 2))]
   279	        pool = [(start, end) for length, start, end in choices if length <= cutoff]
   280	    else:
   281	        pool = [(start, end) for _, start, end in choices]
   282	    return random.choice(pool)
   283	
