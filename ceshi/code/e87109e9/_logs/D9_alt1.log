   148	def _trace_beams(
   149	    base: np.ndarray, legend_turn: dict[int, str], bg: int
   150	) -> tuple[np.ndarray, list[list[tuple[int, int, int, int, int, int, int]]]]:
   151	    """
   152	    Simulate the variant beams.
   153	
   154	    Hit tuples are:
   155	      (incoming_dir, obstacle_color, anchor_r, anchor_c, width_before, segment_len, width_after)
   156	    """
   157	    src_r, src_c, src_sz = _find_teal_square(base, teal=TEAL)
   158	    assert src_sz == INITIAL_WIDTH, "variant source square must be 2x2"
   159	
   160	    out = base.copy()
   161	    h, w = out.shape
   162	    all_hits: list[list[tuple[int, int, int, int, int, int, int]]] = []
   163	
   164	    def in_bounds(r: int, c: int, width: int) -> bool:
   165	        return 0 <= r and 0 <= c and r + width - 1 < h and c + width - 1 < w
   166	
   167	    def paint_block(r: int, c: int, width: int) -> None:
   168	        blk = out[r : r + width, c : c + width]
   169	        blk[blk == bg] = TEAL
   170	        out[r : r + width, c : c + width] = blk
   171	
   172	    def obstacle_color_at_next(r: int, c: int, width: int) -> int | None:
   173	        blk = out[r : r + width, c : c + width]
   174	        cols = set(map(int, np.unique(blk)))
   175	        cols.discard(bg)
   176	        cols.discard(TEAL)
   177	        if not cols:
   178	            return None
   179	        assert len(cols) == 1, "beam footprint must not hit mixed obstacle colors"
   180	        return int(next(iter(cols)))
   181	
   182	    for d0 in range(4):
   183	        r, c, d = src_r, src_c, d0
   184	        width = INITIAL_WIDTH
   185	        seg_len = 0
   186	        hits: list[tuple[int, int, int, int, int, int, int]] = []
   187	        seen: set[tuple[int, int, int, int]] = set()
   188	        while True:
   189	            state = (r, c, d, width)
   190	            assert state not in seen, "beam path must not cycle"
   191	            seen.add(state)
   192	
   193	            dr, dc = _DIRS[d]
   194	            nr, nc = r + dr, c + dc
   195	            if not in_bounds(nr, nc, width):
   196	                break
   197	
   198	            oc = obstacle_color_at_next(nr, nc, width)
   199	            if oc is None:
   200	                r, c = nr, nc
   201	                paint_block(r, c, width)
   202	                seg_len += 1
   203	                continue
   204	
   205	            assert oc in legend_turn, "obstacle color must be encoded by the legend"
   206	            new_width = _next_width(width, seg_len)
   207	            hits.append((d, oc, r, c, width, seg_len, new_width))
   208	            d = _rot(d, legend_turn[oc])
   209	            width = new_width
   210	            seg_len = 0
   211	            assert len(hits) <= 2, "generator only supports up to two turns per beam"
   212	        all_hits.append(hits)
   213	
   214	    return out, all_hits
   215	
