   354	
   355	def _select_chain_candidate(
   356	    present: set[int],
   357	    first_stop: dict[int, tuple[int, int, int]],
   358	    thickness: dict[int, int],
   359	    h: int,
   360	    w: int,
   361	) -> tuple[int, int, str] | None:
   362	    """Choose one beam that will hit a second obstacle after its width change."""
   363	    candidates: list[tuple[int, int, str]] = []
   364	    for side in present:
   365	        r1, c1, len1 = first_stop[side]
   366	        if len1 <= 0:
   367	            continue
   368	        w1 = _next_width(INITIAL_WIDTH, len1)
   369	        for turn in ("L", "R"):
   370	            nxt = _rot(side, turn)
   371	            if nxt not in present:
   372	                continue
   373	            _r2, _c2, len2 = _stop_before_side(r1, c1, nxt, w1, thickness, h, w)
   374	            if len2 >= 2:
   375	                candidates.append((side, nxt, turn))
   376	    return random.choice(candidates) if candidates else None
   377	
