   391	def _compute_span_constraints(
   392	    present: set[int],
   393	    side_turn: dict[int, str],
   394	    chain: tuple[int, int, str],
   395	    sr: int,
   396	    sc: int,
   397	    h: int,
   398	    w: int,
   399	    thickness: dict[int, int],
   400	    first_stop: dict[int, tuple[int, int, int]],
   401	) -> tuple[dict[int, list[tuple[int, int]]], dict[int, list[tuple[int, int]]]] | None:
   402	    required: dict[int, list[tuple[int, int]]] = {s: [] for s in present}
   403	    excluded: dict[int, list[tuple[int, int]]] = {s: [] for s in present}
   404	
   405	    for side in present:
   406	        required[side].append(_interval_for_side(side, sr, sc, INITIAL_WIDTH))
   407	
   408	    chain_side, chain_target, _chain_turn = chain
   409	    for side in present:
   410	        nxt = _rot(side, side_turn[side])
   411	        if nxt not in present:
   412	            continue
   413	        r1, c1, len1 = first_stop[side]
   414	        assert len1 > 0
   415	        w1 = _next_width(INITIAL_WIDTH, len1)
   416	        interval1 = _interval_for_side(nxt, r1, c1, w1)
   417	        if side == chain_side and nxt == chain_target:
   418	            required[nxt].append(interval1)
   419	            r2, c2, len2 = _stop_before_side(r1, c1, nxt, w1, thickness, h, w)
   420	            if len2 <= 0:
   421	                return None
   422	            w2 = _next_width(w1, len2)
   423	            after = _rot(nxt, side_turn[nxt])
   424	            if after in present:
   425	                excluded[after].append(_interval_for_side(after, r2, c2, w2))
   426	        else:
   427	            excluded[nxt].append(interval1)
   428	
   429	    return required, excluded
