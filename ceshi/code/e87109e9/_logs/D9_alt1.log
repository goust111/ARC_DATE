    85	def _parse_legend(grid: np.ndarray, legend_h: int) -> dict[int, str]:
    86	    """Read left/right turn codes from the top legend band."""
    87	    legend = grid[:legend_h, :]
    88	    assert legend.size, "legend must be non-empty"
    89	    vals, cnts = np.unique(legend, return_counts=True)
    90	    bg = int(vals[cnts.argmax()])
    91	
    92	    sep_cols = [c for c in range(legend.shape[1]) if np.all(legend[:, c] == bg)]
    93	    assert len(sep_cols) >= 2, "legend separator columns must exist"
    94	
    95	    turn: dict[int, str] = {}
    96	    for a, b in zip(sep_cols, sep_cols[1:], strict=False):
    97	        if b - a <= 2:
    98	            continue
    99	        interior = legend[1 : legend_h - 1, a + 1 : b]
   100	        colors = set(map(int, np.unique(interior)))
   101	        colors.discard(bg)
   102	        colors.discard(0)
   103	        assert len(colors) == 1, "each legend cell must encode exactly one color"
   104	        col = int(next(iter(colors)))
   105	        xs = np.where(interior == col)[1]
   106	        x = int(xs[0])
   107	        turn[col] = "L" if x <= (interior.shape[1] - 1) // 2 else "R"
   108	    assert len(turn) == 4, "legend must encode four turn colors"
   109	    return turn
