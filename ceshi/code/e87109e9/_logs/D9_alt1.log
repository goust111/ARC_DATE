   112	def _find_teal_square(g: np.ndarray, teal: int = TEAL) -> tuple[int, int, int]:
   113	    """Return (r0, c0, size) for the unique solid teal square."""
   114	    candidates: list[tuple[int, int, int]] = []
   115	    for cells in components_mask(g == teal, connectivity=4):
   116	        r0, c0, r1, c1 = bbox_coords(cells)
   117	        hh = r1 - r0 + 1
   118	        ww = c1 - c0 + 1
   119	        if hh != ww:
   120	            continue
   121	        size = hh
   122	        if int(np.sum(g[r0 : r1 + 1, c0 : c1 + 1] == teal)) != size * size:
   123	            continue
   124	        candidates.append((int(r0), int(c0), int(size)))
   125	    assert len(candidates) == 1, "main grid must contain exactly one solid teal square"
   126	    return candidates[0]
