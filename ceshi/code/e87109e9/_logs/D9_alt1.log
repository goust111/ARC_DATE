+# Variant of e87109e9
+# Dimension: D9 — 射线宽度 (trajectory)
+# Change: 射线宽度为2像素（与源方块2x2的边长一致），射线占据2行或2列... → 射线宽度可变（由段长决定）
+
+import random
+
+import numpy as np
+
+from arc_utils import bbox_coords, components_mask
+
+
+# Design analysis for the D9 variant
+# ----------------------------------
+# spec:
+#   concretization:
+#     - The legend stays unchanged: four colored bars in a grey top band still encode only left/right turns.
+#     - The source is fixed to a solid teal 2x2 square so the initial ribbon width is always 2.
+#     - A beam is still modeled as a moving square footprint, but the footprint size is now dynamic.
+#       Straight segments therefore appear as 1/2/3/4-cell-wide ribbons depending on prior turns.
+#     - Width update rule: after a turn, inspect the straight segment that just ended.
+#       If that segment moved at least 7 cells, the next segment widens by 1; otherwise it narrows by 1.
+#       Width never drops below 1.
+#   behavior_trace:
+#     - Original behavior near a north obstacle:
+#         source width = 2, beam moves up, turns, and continues sideways with width still 2.
+#     - Variant behavior:
+#         source width = 2, beam moves up for len=8, hits obstacle, turns, and the sideways continuation
+#         is width 3; if len=4 instead, that continuation is width 1.
+#     - The changed width matters twice: visually in the painted ribbon and logically when a turned beam
+#       reaches a second obstacle, because the obstacle span it can hit now depends on the new width.
+#   complexity_calibration:
+#     - Only two width outcomes appear after the first turn (1 or 3), and with at most two turns per beam
+#       the maximum width is 4. This keeps the rule visible without making tracing combinatorially messy.
+#     - Generator samples are forced to contain at least one short first segment (<=4) and one long first
+#       segment (>=7), so shrinking and widening are both demonstrated repeatedly.
+#   implicit_assumptions_review:
+#     - The original solver assumes one immutable square size `sz` for bounds, obstacle tests, painting,
+#       cycle detection, and second-hit geometry. Those assumptions are invalid once width changes.
+#     - The new solver therefore tracks `(r, c, direction, width)` and resets `segment_len` after every turn.
+#     - Keeping the top-left anchor fixed at a bend is a new geometric convention; generator constraints are
+#       computed with exactly the same convention so solver and generator agree on every corner.
+#   placement_legality:
+#     - Obstacles remain edge-touching solid rectangles and never overlap each other or the source.
+#     - The generator first decides which side can chain into a second hit, then selects obstacle spans that
+#       must cover required incoming lanes and must avoid excluded lanes for all other turned beams.
+#     - Every accepted sample is re-solved by `main()` to confirm the constructed input is legal.
+#   observability_and_cleanliness:
+#     - No invisible property such as color id controls width; only visible straight-segment length does.
+#     - Width changes are visible as noticeably thinner/thicker post-turn ribbons rather than tiny markers.
+#     - Legend, source, and obstacles keep the original visual vocabulary, so the only new thing to infer is
+#       "long segment widens next ribbon, short segment narrows it."
+#   color_change_reasoning:
+#     - No color remapping is introduced. Colors still serve only as obstacle identities tied to legend turns.
+
+
+_DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+_N, _E, _S, _W = range(4)
+
+LEGEND_COLOR_POOL = [1, 2, 3, 4, 6]
+BG_COLOR_POOL = [1, 2, 3, 4, 6, 7, 9]
+LEGEND_BG = 5
+TEAL = 8
+
+GRID_H_RANGE = (19, 24)
+GRID_W = 24
+LEGEND_H = 6
+LEGEND_CELL_STARTS = [1, 7, 13, 19]
+
+INITIAL_WIDTH = 2
+GROW_THRESHOLD = 7
+SQUARE_EDGE_GAP = 5
+
+OBS_COUNT_4_PROB = 0.65
+OBS_THICKNESS_RANGE = (2, 4)
+OBS_SINGLE_MARGIN = 6
+OBS_BOTH_GAP = 2
