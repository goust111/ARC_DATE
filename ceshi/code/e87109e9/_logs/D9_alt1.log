   318	def _obstacle_rect(
   319	    side: int, thickness: int, span: tuple[int, int], h: int, w: int
   320	) -> tuple[int, int, int, int]:
   321	    s0, s1 = span
   322	    if side == _N:
   323	        return 0, thickness - 1, s0, s1
   324	    if side == _S:
   325	        return h - thickness, h - 1, s0, s1
   326	    if side == _W:
   327	        return s0, s1, 0, thickness - 1
   328	    return s0, s1, w - thickness, w - 1
   329	
   330	
   331	def _stop_before_side(
   332	    r: int, c: int, side: int, width: int, thickness: dict[int, int], h: int, w: int
   333	) -> tuple[int, int, int]:
   334	    """Return the last free anchor before hitting a given side obstacle and the segment length."""
   335	    if side == _N:
   336	        end_r = thickness[side]
   337	        return end_r, c, r - end_r
   338	    if side == _S:
   339	        end_r = h - thickness[side] - width
   340	        return end_r, c, end_r - r
   341	    if side == _W:
   342	        end_c = thickness[side]
   343	        return r, end_c, c - end_c
   344	    end_c = w - thickness[side] - width
   345	    return r, end_c, end_c - c
   346	
   347	
   348	def _interval_for_side(side: int, r: int, c: int, width: int) -> tuple[int, int]:
   349	    """Project the current beam cross-section onto the obstacle span axis of `side`."""
   350	    if side in (_N, _S):
   351	        return c, c + width - 1
   352	    return r, r + width - 1
