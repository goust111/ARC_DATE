   379	def _assign_turns(
   380	    present: set[int], chain_side: int, chain_turn: str
   381	) -> dict[int, str]:
   382	    side_turn: dict[int, str] = {}
   383	    for side in present:
   384	        if side == chain_side:
   385	            side_turn[side] = chain_turn
   386	        else:
   387	            side_turn[side] = random.choice(["L", "R"])
   388	    return side_turn
