    72	
    73	OBS_COUNT_4_PROB = 0.65
    74	OBS_THICKNESS_RANGE = (2, 4)
    75	OBS_SINGLE_MARGIN = 6
    76	OBS_BOTH_GAP = 2
    77	
    78	SPAN_MIN_MULT = 3
    79	SPAN_MAX_MULT = 14
