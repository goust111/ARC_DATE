   244	    base = g[legend_h:, :].copy()
   245	    assert base.size, "main grid must remain after legend crop"
   246	
   247	    vals, cnts = np.unique(base, return_counts=True)
   248	    bg = int(vals[cnts.argmax()])
   249	    out, _ = _trace_beams(base, legend_turn, bg)
   250	    return out
