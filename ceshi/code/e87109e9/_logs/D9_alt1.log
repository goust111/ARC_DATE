   217	def main(grid: np.ndarray) -> np.ndarray:
   218	    """
   219	    Project four teal ribbons from a 2x2 seed, turning by the legend and changing width after every turn.
   220	
   221	    Input structure:
   222	    - The top band is a grey legend split into four cells; each colored vertical bar still tells whether that obstacle color means left turn or right turn.
   223	    - The area below contains one solid teal 2x2 source square, a single background color, and several solid obstacle rectangles whose colors all appear in the legend.
   224	
   225	    Rule:
   226	    - Remove the legend from the output.
   227	    - Launch one beam in each cardinal direction from the teal square.
   228	    - Treat each beam as a sliding square footprint: while it goes straight it paints a ribbon of its current width over background cells only.
   229	    - When the next step would enter an obstacle, turn left or right according to the obstacle color.
   230	    - Let the just-finished straight segment length be the number of successful forward steps since the previous turn or start. Length >= 7 makes the next segment wider by 1; shorter segments make it narrower by 1, but never below width 1.
   231	    - The bend keeps the same top-left anchor, then the beam continues until it would leave the grid.
   232	
   233	    Key insight:
   234	    - The legend still explains only the turn direction, so solving the variant requires tracking two coupled states at once: direction comes from obstacle color, while the width of the next ribbon comes from the visible length of the segment that just ended.
   235	    """
   236	    g = np.asarray(grid, dtype=int)
   237	
   238	    rows_with_legend = np.where(np.any(g == LEGEND_BG, axis=1))[0]
   239	    assert rows_with_legend.size, "legend rows must be present"
   240	    legend_h = int(rows_with_legend.max() + 1)

