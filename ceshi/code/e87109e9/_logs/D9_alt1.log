+# Variant of e87109e9
+# Dimension: D9 — 射线宽度 (trajectory)
+# Change: 射线宽度为2像素（与源方块2x2的边长一致），射线占据2行或2列... → 射线宽度可变（由段长决定）
+
+import random
+
+import numpy as np
+
+from arc_utils import bbox_coords, components_mask
+
+
+# Design analysis for the D9 variant
+# ----------------------------------
+# spec:
+#   concretization:
+#     - The legend stays unchanged: four colored bars in a grey top band still encode only left/right turns.
+#     - The source is fixed to a solid teal 2x2 square so the initial ribbon width is always 2.
+#     - A beam is still modeled as a moving square footprint, but the footprint size is now dynamic.
+#       Straight segments therefore appear as 1/2/3/4-cell-wide ribbons depending on prior turns.
+#     - Width update rule: after a turn, inspect the straight segment that just ended.
+#       If that segment moved at least 7 cells, the next segment widens by 1; otherwise it narrows by 1.
+#       Width never drops below 1.
+#   behavior_trace:
+#     - Original behavior near a north obstacle:
+#         source width = 2, beam moves up, turns, and continues sideways with width still 2.
+#     - Variant behavior:
+#         source width = 2, beam moves up for len=8, hits obstacle, turns, and the sideways continuation
+#         is width 3; if len=4 instead, that continuation is width 1.
+#     - The changed width matters twice: visually in the painted ribbon and logically when a turned beam
+#       reaches a second obstacle, because the obstacle span it can hit now depends on the new width.
+#   complexity_calibration:
+#     - Only two width outcomes appear after the first turn (1 or 3), and with at most two turns per beam
+#       the maximum width is 4. This keeps the rule visible without making tracing combinatorially messy.
+#     - Generator samples are forced to contain at least one short first segment (<=4) and one long first
+#       segment (>=7), so shrinking and widening are both demonstrated repeatedly.
+#   implicit_assumptions_review:
+#     - The original solver assumes one immutable square size `sz` for bounds, obstacle tests, painting,
+#       cycle detection, and second-hit geometry. Those assumptions are invalid once width changes.
+#     - The new solver therefore tracks `(r, c, direction, width)` and resets `segment_len` after every turn.
+#     - Keeping the top-left anchor fixed at a bend is a new geometric convention; generator constraints are
+#       computed with exactly the same convention so solver and generator agree on every corner.
+#   placement_legality:
+#     - Obstacles remain edge-touching solid rectangles and never overlap each other or the source.
+#     - The generator first decides which side can chain into a second hit, then selects obstacle spans that
+#       must cover required incoming lanes and must avoid excluded lanes for all other turned beams.
+#     - Every accepted sample is re-solved by `main()` to confirm the constructed input is legal.
+#   observability_and_cleanliness:
+#     - No invisible property such as color id controls width; only visible straight-segment length does.
+#     - Width changes are visible as noticeably thinner/thicker post-turn ribbons rather than tiny markers.
+#     - Legend, source, and obstacles keep the original visual vocabulary, so the only new thing to infer is
+#       "long segment widens next ribbon, short segment narrows it."
+#   color_change_reasoning:
+#     - No color remapping is introduced. Colors still serve only as obstacle identities tied to legend turns.
+
+
+_DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+_N, _E, _S, _W = range(4)
+
+LEGEND_COLOR_POOL = [1, 2, 3, 4, 6]
+BG_COLOR_POOL = [1, 2, 3, 4, 6, 7, 9]
+LEGEND_BG = 5
+TEAL = 8
+
+GRID_H_RANGE = (19, 24)
+GRID_W = 24
+LEGEND_H = 6
+LEGEND_CELL_STARTS = [1, 7, 13, 19]
+
+INITIAL_WIDTH = 2
+GROW_THRESHOLD = 7
+SQUARE_EDGE_GAP = 5
+
+OBS_COUNT_4_PROB = 0.65
+OBS_THICKNESS_RANGE = (2, 4)
+OBS_SINGLE_MARGIN = 6
+OBS_BOTH_GAP = 2
+
+SPAN_MIN_MULT = 3
+SPAN_MAX_MULT = 14
+SPAN_COMPACT_PROB = 0.4
+
+MAX_RETRIES = 400
+
+
+def _parse_legend(grid: np.ndarray, legend_h: int) -> dict[int, str]:
+    """Read left/right turn codes from the top legend band."""
+    legend = grid[:legend_h, :]
+    assert legend.size, "legend must be non-empty"
+    vals, cnts = np.unique(legend, return_counts=True)
+    bg = int(vals[cnts.argmax()])
+
+    sep_cols = [c for c in range(legend.shape[1]) if np.all(legend[:, c] == bg)]
+    assert len(sep_cols) >= 2, "legend separator columns must exist"
+
+    turn: dict[int, str] = {}
+    for a, b in zip(sep_cols, sep_cols[1:], strict=False):
+        if b - a <= 2:
+            continue
+        interior = legend[1 : legend_h - 1, a + 1 : b]
+        colors = set(map(int, np.unique(interior)))
+        colors.discard(bg)
+        colors.discard(0)
+        assert len(colors) == 1, "each legend cell must encode exactly one color"
+        col = int(next(iter(colors)))
+        xs = np.where(interior == col)[1]
+        x = int(xs[0])
+        turn[col] = "L" if x <= (interior.shape[1] - 1) // 2 else "R"
+    assert len(turn) == 4, "legend must encode four turn colors"
+    return turn
+
+
+def _find_teal_square(g: np.ndarray, teal: int = TEAL) -> tuple[int, int, int]:
+    """Return (r0, c0, size) for the unique solid teal square."""
+    candidates: list[tuple[int, int, int]] = []
+    for cells in components_mask(g == teal, connectivity=4):
+        r0, c0, r1, c1 = bbox_coords(cells)
+        hh = r1 - r0 + 1
+        ww = c1 - c0 + 1
+        if hh != ww:
+            continue
+        size = hh
+        if int(np.sum(g[r0 : r1 + 1, c0 : c1 + 1] == teal)) != size * size:
+            continue
+        candidates.append((int(r0), int(c0), int(size)))
+    assert len(candidates) == 1, "main grid must contain exactly one solid teal square"
+    return candidates[0]
+
+
+def _rot_ccw(d: int) -> int:
+    return (d - 1) % 4
+
+
+def _rot_cw(d: int) -> int:
+    return (d + 1) % 4
+
+
+def _rot(d: int, turn: str) -> int:
+    return _rot_ccw(d) if turn == "L" else _rot_cw(d)
+
+
+def _next_width(width: int, segment_len: int) -> int:
+    """Long segments widen; short segments narrow, but width stays positive."""
+    if segment_len >= GROW_THRESHOLD:
+        return width + 1
+    return max(1, width - 1)
+
+
+def _trace_beams(
+    base: np.ndarray, legend_turn: dict[int, str], bg: int
+) -> tuple[np.ndarray, list[list[tuple[int, int, int, int, int, int, int]]]]:
+    """
+    Simulate the variant beams.
+
+    Hit tuples are:
+      (incoming_dir, obstacle_color, anchor_r, anchor_c, width_before, segment_len, width_after)
+    """
+    src_r, src_c, src_sz = _find_teal_square(base, teal=TEAL)
+    assert src_sz == INITIAL_WIDTH, "variant source square must be 2x2"
+
+    out = base.copy()
+    h, w = out.shape
+    all_hits: list[list[tuple[int, int, int, int, int, int, int]]] = []
+
+    def in_bounds(r: int, c: int, width: int) -> bool:
+        return 0 <= r and 0 <= c and r + width - 1 < h and c + width - 1 < w
+
+    def paint_block(r: int, c: int, width: int) -> None:
+        blk = out[r : r + width, c : c + width]
+        blk[blk == bg] = TEAL
+        out[r : r + width, c : c + width] = blk
+
+    def obstacle_color_at_next(r: int, c: int, width: int) -> int | None:
+        blk = out[r : r + width, c : c + width]
+        cols = set(map(int, np.unique(blk)))
+        cols.discard(bg)
+        cols.discard(TEAL)
+        if not cols:
+            return None
+        assert len(cols) == 1, "beam footprint must not hit mixed obstacle colors"
+        return int(next(iter(cols)))
+
+    for d0 in range(4):
+        r, c, d = src_r, src_c, d0
+        width = INITIAL_WIDTH
+        seg_len = 0
+        hits: list[tuple[int, int, int, int, int, int, int]] = []
+        seen: set[tuple[int, int, int, int]] = set()
+        while True:
+            state = (r, c, d, width)
+            assert state not in seen, "beam path must not cycle"
+            seen.add(state)
+
+            dr, dc = _DIRS[d]
+            nr, nc = r + dr, c + dc
+            if not in_bounds(nr, nc, width):
+                break
+
+            oc = obstacle_color_at_next(nr, nc, width)
+            if oc is None:
+                r, c = nr, nc
+                paint_block(r, c, width)
+                seg_len += 1
+                continue
+
+            assert oc in legend_turn, "obstacle color must be encoded by the legend"
+            new_width = _next_width(width, seg_len)
+            hits.append((d, oc, r, c, width, seg_len, new_width))
+            d = _rot(d, legend_turn[oc])
+            width = new_width
+            seg_len = 0
+            assert len(hits) <= 2, "generator only supports up to two turns per beam"
+        all_hits.append(hits)
+
+    return out, all_hits
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Project four teal ribbons from a 2x2 seed, turning by the legend and changing width after every turn.
+
+    Input structure:
+    - The top band is a grey legend split into four cells; each colored vertical bar still tells whether that obstacle color means left turn or right turn.
+    - The area below contains one solid teal 2x2 source square, a single background color, and several solid obstacle rectangles whose colors all appear in the legend.
+
+    Rule:
+    - Remove the legend from the output.
+    - Launch one beam in each cardinal direction from the teal square.
+    - Treat each beam as a sliding square footprint: while it goes straight it paints a ribbon of its current width over background cells only.
+    - When the next step would enter an obstacle, turn left or right according to the obstacle color.
+    - Let the just-finished straight segment length be the number of successful forward steps since the previous turn or start. Length >= 7 makes the next segment wider by 1; shorter segments make it narrower by 1, but never below width 1.
+    - The bend keeps the same top-left anchor, then the beam continues until it would leave the grid.
+
+    Key insight:
+    - The legend still explains only the turn direction, so solving the variant requires tracking two coupled states at once: direction comes from obstacle color, while the width of the next ribbon comes from the visible length of the segment that just ended.
+    """
+    g = np.asarray(grid, dtype=int)
+
+    rows_with_legend = np.where(np.any(g == LEGEND_BG, axis=1))[0]
+    assert rows_with_legend.size, "legend rows must be present"
+    legend_h = int(rows_with_legend.max() + 1)
+    assert np.array_equal(rows_with_legend, np.arange(legend_h)), "legend color must stay in the top band"
+
+    legend_turn = _parse_legend(g, legend_h)
+    base = g[legend_h:, :].copy()
+    assert base.size, "main grid must remain after legend crop"
+
+    vals, cnts = np.unique(base, return_counts=True)
+    bg = int(vals[cnts.argmax()])
+    out, _ = _trace_beams(base, legend_turn, bg)
+    return out
+
+
+def _choose_span(
+    axis_len: int,
+    required: list[tuple[int, int]],
+    excluded: list[tuple[int, int]],
+    min_len: int,
+    max_len: int,
+) -> tuple[int, int] | None:
+    """Pick a span covering all required intervals and avoiding all excluded ones."""
+    req0 = min(a for a, _ in required)
+    req1 = max(b for _, b in required)
+    lo = max(min_len, req1 - req0 + 1)
+    hi = min(max_len, axis_len)
+    choices: list[tuple[int, int, int]] = []
+    for length in range(lo, hi + 1):
+        start0 = max(0, req1 - length + 1)
+        start1 = min(req0, axis_len - length)
+        for start in range(start0, start1 + 1):
+            end = start + length - 1
+            if all(end < a or start > b for a, b in excluded):
+                choices.append((length, start, end))
+    if not choices:
+        return None
+
+    lengths = sorted({length for length, _, _ in choices})
+    if random.random() < SPAN_COMPACT_PROB:
+        cutoff = lengths[min(len(lengths) - 1, max(0, len(lengths) // 2))]
+        pool = [(start, end) for length, start, end in choices if length <= cutoff]
+    else:
+        pool = [(start, end) for _, start, end in choices]
+    return random.choice(pool)
+
+
+def _make_legend(legend_colors: list[int], turns: dict[int, str]) -> np.ndarray:
+    legend = np.full((LEGEND_H, GRID_W), LEGEND_BG, dtype=int)
+    for start, color in zip(LEGEND_CELL_STARTS, legend_colors):
+        legend[1:5, start : start + 4] = 0
+        bar_col = start if turns[color] == "L" else start + 3
+        legend[1:5, bar_col] = color
+    return legend
+
+
+def _rand_thickness(lo: int, hi: int) -> int | None:
+    return random.randint(lo, hi) if hi >= lo else None
+
+
+def _thickness_pair(
+    axis: int, source_w: int, a_present: bool, b_present: bool
+) -> tuple[int | None, int | None] | None:
+    lo, hi_cap = OBS_THICKNESS_RANGE
+    if a_present and b_present:
+        room = axis - source_w - OBS_BOTH_GAP
+        if room < 2 * lo:
+            return None
+        a = random.randint(lo, min(hi_cap, room - lo))
+        b = _rand_thickness(lo, min(hi_cap, room - a))
+        return (a, b) if b is not None else None
+    if a_present:
+        t = _rand_thickness(lo, min(hi_cap, axis - source_w - OBS_SINGLE_MARGIN))
+        return (t, None) if t is not None else None
+    if b_present:
+        t = _rand_thickness(lo, min(hi_cap, axis - source_w - OBS_SINGLE_MARGIN))
+        return (None, t) if t is not None else None
+    return None, None
+
+
+def _obstacle_rect(
+    side: int, thickness: int, span: tuple[int, int], h: int, w: int
+) -> tuple[int, int, int, int]:
+    s0, s1 = span
+    if side == _N:
+        return 0, thickness - 1, s0, s1
+    if side == _S:
+        return h - thickness, h - 1, s0, s1
+    if side == _W:
+        return s0, s1, 0, thickness - 1
+    return s0, s1, w - thickness, w - 1
+
+
+def _stop_before_side(
+    r: int, c: int, side: int, width: int, thickness: dict[int, int], h: int, w: int
+) -> tuple[int, int, int]:
+    """Return the last free anchor before hitting a given side obstacle and the segment length."""
+    if side == _N:
+        end_r = thickness[side]
+        return end_r, c, r - end_r
+    if side == _S:
+        end_r = h - thickness[side] - width
+        return end_r, c, end_r - r
+    if side == _W:
+        end_c = thickness[side]
+        return r, end_c, c - end_c
+    end_c = w - thickness[side] - width
+    return r, end_c, end_c - c
+
+
+def _interval_for_side(side: int, r: int, c: int, width: int) -> tuple[int, int]:
+    """Project the current beam cross-section onto the obstacle span axis of `side`."""
+    if side in (_N, _S):
+        return c, c + width - 1
+    return r, r + width - 1
+
+
+def _select_chain_candidate(
+    present: set[int],
+    first_stop: dict[int, tuple[int, int, int]],
+    thickness: dict[int, int],
+    h: int,
+    w: int,
+) -> tuple[int, int, str] | None:
+    """Choose one beam that will hit a second obstacle after its width change."""
+    candidates: list[tuple[int, int, str]] = []
+    for side in present:
+        r1, c1, len1 = first_stop[side]
+        if len1 <= 0:
+            continue
+        w1 = _next_width(INITIAL_WIDTH, len1)
+        for turn in ("L", "R"):
+            nxt = _rot(side, turn)
+            if nxt not in present:
+                continue
+            _r2, _c2, len2 = _stop_before_side(r1, c1, nxt, w1, thickness, h, w)
+            if len2 >= 2:
+                candidates.append((side, nxt, turn))
+    return random.choice(candidates) if candidates else None
+
+
+def _assign_turns(
+    present: set[int], chain_side: int, chain_turn: str
+) -> dict[int, str]:
+    side_turn: dict[int, str] = {}
+    for side in present:
+        if side == chain_side:
+            side_turn[side] = chain_turn
+        else:
+            side_turn[side] = random.choice(["L", "R"])
+    return side_turn
+
+
+def _compute_span_constraints(
+    present: set[int],
+    side_turn: dict[int, str],
+    chain: tuple[int, int, str],
+    sr: int,
+    sc: int,
+    h: int,
+    w: int,
+    thickness: dict[int, int],
+    first_stop: dict[int, tuple[int, int, int]],
+) -> tuple[dict[int, list[tuple[int, int]]], dict[int, list[tuple[int, int]]]] | None:
+    required: dict[int, list[tuple[int, int]]] = {s: [] for s in present}
+    excluded: dict[int, list[tuple[int, int]]] = {s: [] for s in present}
+
+    for side in present:
+        required[side].append(_interval_for_side(side, sr, sc, INITIAL_WIDTH))
+
+    chain_side, chain_target, _chain_turn = chain
+    for side in present:
+        nxt = _rot(side, side_turn[side])
+        if nxt not in present:
+            continue
+        r1, c1, len1 = first_stop[side]
+        assert len1 > 0
+        w1 = _next_width(INITIAL_WIDTH, len1)
+        interval1 = _interval_for_side(nxt, r1, c1, w1)
+        if side == chain_side and nxt == chain_target:
+            required[nxt].append(interval1)
+            r2, c2, len2 = _stop_before_side(r1, c1, nxt, w1, thickness, h, w)
+            if len2 <= 0:
+                return None
+            w2 = _next_width(w1, len2)
+            after = _rot(nxt, side_turn[nxt])
+            if after in present:
+                excluded[after].append(_interval_for_side(after, r2, c2, w2))
+        else:
+            excluded[nxt].append(interval1)
+
+    return required, excluded
+
+
+def _gen_attempt() -> np.ndarray | None:
+    h, w = random.randint(*GRID_H_RANGE), GRID_W
+    obstacle_count = 4 if random.random() < OBS_COUNT_4_PROB else 3
+    present = set(random.sample([_N, _E, _S, _W], obstacle_count))
+
+    ns = _thickness_pair(h, INITIAL_WIDTH, _N in present, _S in present)
+    ew = _thickness_pair(w, INITIAL_WIDTH, _W in present, _E in present)
+    if ns is None or ew is None:
+        return None
+    thickness = {s: t for s, t in zip((_N, _S, _W, _E), (*ns, *ew)) if t is not None}
+
+    min_r, max_r = SQUARE_EDGE_GAP, h - INITIAL_WIDTH - SQUARE_EDGE_GAP
+    min_c, max_c = SQUARE_EDGE_GAP, w - INITIAL_WIDTH - SQUARE_EDGE_GAP
+    if _N in present:
+        min_r = max(min_r, thickness[_N] + 2)
+    if _S in present:
+        max_r = min(max_r, h - thickness[_S] - INITIAL_WIDTH - 2)
+    if _W in present:
+        min_c = max(min_c, thickness[_W] + 2)
+    if _E in present:
+        max_c = min(max_c, w - thickness[_E] - INITIAL_WIDTH - 2)
+    if min_r > max_r or min_c > max_c:
+        return None
+
+    src_choices = [
+        (r, c)
+        for r in range(min_r, max_r + 1)
+        for c in range(min_c, max_c + 1)
+    ]
+    random.shuffle(src_choices)
+
+    for sr, sc in src_choices[:80]:
+        first_stop = {
+            side: _stop_before_side(sr, sc, side, INITIAL_WIDTH, thickness, h, w)
+            for side in present
+        }
+        first_lengths = {side: seg_len for side, (_r, _c, seg_len) in first_stop.items()}
+        if any(seg_len <= 0 for seg_len in first_lengths.values()):
+            continue
+        if not any(seg_len <= 4 for seg_len in first_lengths.values()):
+            continue
+        if not any(seg_len >= GROW_THRESHOLD for seg_len in first_lengths.values()):
+            continue
+
+        chain = _select_chain_candidate(present, first_stop, thickness, h, w)
+        if chain is None:
+            continue
+
+        chain_side, chain_target, chain_turn = chain
+        side_turn = _assign_turns(present, chain_side, chain_turn)
+        rc = _compute_span_constraints(
+            present, side_turn, chain, sr, sc, h, w, thickness, first_stop
+        )
+        if rc is None:
+            continue
+        required, excluded = rc
+
+        spans: dict[int, tuple[int, int]] = {}
+        for side in present:
+            axis_len = w if side in (_N, _S) else h
+            span = _choose_span(
+                axis_len,
+                required[side],
+                excluded[side],
+                SPAN_MIN_MULT * INITIAL_WIDTH,
+                min(SPAN_MAX_MULT * INITIAL_WIDTH, axis_len),
+            )
+            if span is None:
+                break
+            spans[side] = span
+        if len(spans) != len(present):
+            continue
+
+        legend_colors = random.sample(LEGEND_COLOR_POOL, 4)
+        obstacle_colors = random.sample(legend_colors, obstacle_count)
+        side_color = dict(zip(sorted(present), obstacle_colors))
+        bg = random.choice([c for c in BG_COLOR_POOL if c not in legend_colors])
+
+        base = np.full((h, w), bg, dtype=int)
+        base[sr : sr + INITIAL_WIDTH, sc : sc + INITIAL_WIDTH] = TEAL
+        occupied = np.zeros((h, w), dtype=bool)
+        for side in present:
+            r0, r1, c0, c1 = _obstacle_rect(side, thickness[side], spans[side], h, w)
+            region = occupied[r0 : r1 + 1, c0 : c1 + 1]
+            if region.any():
+                break
+            if not (r1 < sr - 1 or r0 > sr + INITIAL_WIDTH or c1 < sc - 1 or c0 > sc + INITIAL_WIDTH):
+                break
+            occupied[r0 : r1 + 1, c0 : c1 + 1] = True
+            base[r0 : r1 + 1, c0 : c1 + 1] = side_color[side]
+        else:
+            vals, cnts = np.unique(base, return_counts=True)
+            if int(vals[cnts.argmax()]) != bg:
+                continue
+
+            turns = {side_color[s]: side_turn[s] for s in present}
+            for color in legend_colors:
+                turns.setdefault(color, random.choice(["L", "R"]))
+
+            try:
+                expected, hits = _trace_beams(base, turns, bg)
+            except AssertionError:
+                continue
+
+            hit_counts = [len(beam) for beam in hits]
+            total_hits = sum(hit_counts)
+            if total_hits != obstacle_count + 1:
+                continue
+            if hit_counts.count(2) != 1 or any(c > 2 for c in hit_counts):
+                continue
+            hit_colors = {color for beam in hits for _, color, _, _, _, _, _ in beam}
+            if set(side_color.values()) - hit_colors:
+                continue
+
+            width_pairs = [(before, after) for beam in hits for _, _, _, _, before, _, after in beam]
+            if not any(after > before for before, after in width_pairs):
+                continue
+            if not any(after < before for before, after in width_pairs):
+                continue
+
+            first_hit_by_side = {side: hits[side][0] for side in range(4) if hits[side]}
+            if chain_side not in first_hit_by_side:
+                continue
+            if len(hits[chain_side]) != 2:
+                continue
+            if first_hit_by_side[chain_side][6] == INITIAL_WIDTH:
+                continue
+
+            legend = _make_legend(legend_colors, turns)
+            inp = np.vstack([legend, base])
+            try:
+                actual = main(inp)
+            except AssertionError:
+                continue
+            if not np.array_equal(actual, expected):
+                continue
+            return inp
+
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate e87109e9 D9 input")

