+# Design analysis for the D2 variant
+# a) Concrete behavior:
+#    The picture still has the same two regions: a 6x24 legend band on top and
+#    the main puzzle below. The output still drops the legend and paints teal
+#    square-width rays. The change is only in turning: each beam now keeps its
+#    own local hit counter. Hit 1 turns clockwise, hit 2 counterclockwise, hit 3
+#    clockwise again, etc. Example: a beam launched north that first touches the
+#    north obstacle turns east; if it then reaches the east obstacle it turns
+#    back north. In the original task, those two turns were controlled by two
+#    obstacle colors through the legend. Here they are controlled only by hit
+#    order along that beam.
+# b) Complexity calibration:
+#    If every beam turned at most once, the alternation rule would be visually
+#    weak because only the "first hit = clockwise" part would appear. The
+#    generator therefore enforces exactly one two-hit beam per sample. This
+#    exposes both phases of the alternation while keeping the scene as clean as
+#    the source task: 3-4 edge obstacles, 4-5 total hits, no interior clutter.
+# c) Old assumptions that break:
+#    - Original main() parsed legend_turn and required each obstacle color to be
+#      present in that mapping. That assumption is now invalid because obstacle
+#      color is irrelevant to turning.
+#    - Original path state used (r,c,d). With alternation, revisiting the same
+#      position+direction with opposite parity is a different state, so cycle
+#      detection must include hit-count parity.
+#    - Original generator chose side turns independently per obstacle. That no
+#      longer matches the semantics because turn direction depends on encounter
+#      index, not obstacle identity, so path planning must be parity-driven.
+# d) Placement legality:
+#    Obstacles remain edge-touching rectangles. Each present side must cover the
+#    source beam's cross-section so the first hit is well-defined. For the unique
+#    two-hit chain side -> clockwise(side), the target side is forced to cover
+#    the incoming lane, and the source side is forced not to cover the return
+#    lane after the second turn. This prevents accidental third hits and cycles.
+# e) Visual observability:
+#    The legend is still drawn in the old style, but the solver ignores it. To
+#    prevent degeneration into the original task, the generator explicitly checks
+#    that the same input produces a different output under the old legend-based
+#    solver logic. This guarantees that the visible example really requires the
+#    new alternating rule.
+# f) Visual neatness:
+#    The canvas dimensions, obstacle thicknesses, and edge gaps are kept from
+#    the source task. Obstacles stay on the border, the teal source stays away
+#    from them, and the output remains readable as a few orthogonal corridors.
+# g) Color inferability:
+#    No new color mapping is introduced. Colors remain ordinary obstacle labels
+#    and legend decorations. Because turning is no longer color-dependent, the
+#    generator does not rely on any invisible ordering over color ids.
+# h) New solver assumptions and generator guarantees:
+#    - main() assumes the legend color 5 is confined to a contiguous top band;
+#      the generator keeps that invariant.
+#    - main() assumes the next beam footprint never overlaps mixed obstacle
+#      colors; the generator still uses non-overlapping solid rectangles.
+#    - main() assumes the teal source is one solid square; the generator keeps
+#      exactly one such square.
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Emit four teal beams from a square, turning in an alternating sequence.
+
+    Input structure:
+    - Top band: a grey (5) legend region with colored vertical bars, visually matching the source task.
+    - Below: the main grid containing one solid teal (8) square on a uniform background plus colored obstacle blocks.
+
+    Rule:
+    - Remove the legend from the output.
+    - Launch one square-width teal beam in each cardinal direction from the teal square.
+    - A beam paints teal over background cells as it advances.
+    - When a beam hits any obstacle, ignore that obstacle's color and turn by encounter order along that same beam:
+      first hit clockwise, second hit counterclockwise, third clockwise, and so on.
+    - Beams stop once their next square step would leave the main grid.
+
+    Key insight: The legend is now only a leftover visual motif; the real control signal is the per-beam hit count parity, which alternates the turn direction.
+    """
+    g = np.asarray(grid, dtype=int)
+
+    legend_bg = 5
+    rows_with_legend = np.where(np.any(g == legend_bg, axis=1))[0]
+    assert rows_with_legend.size, "legend rows must be present"
+    legend_h = int(rows_with_legend.max() + 1)
+    assert np.array_equal(rows_with_legend, np.arange(legend_h)), "legend color must be confined to the top band"
+
+    base = g[legend_h:, :].copy()
+    assert base.size, "main grid must remain after legend crop"
+
+    vals, cnts = np.unique(base, return_counts=True)
+    bg = int(vals[cnts.argmax()])
+    teal = 8
+    sr, sc, sz = _find_teal_square(base, teal=teal)
+
+    out = base.copy()
+
+    def in_bounds(r: int, c: int) -> bool:
+        return 0 <= r and 0 <= c and r + sz - 1 < out.shape[0] and c + sz - 1 < out.shape[1]
+
+    def paint_block(r: int, c: int) -> None:
+        blk = out[r : r + sz, c : c + sz]
+        blk[blk == bg] = teal
+        out[r : r + sz, c : c + sz] = blk
+
+    def obstacle_color_at_next(nr: int, nc: int) -> int | None:
+        blk = out[nr : nr + sz, nc : nc + sz]
+        cols = set(map(int, np.unique(blk)))
+        cols.discard(bg)
+        cols.discard(teal)
+        if not cols:
+            return None
+        assert len(cols) == 1, "beam footprint must not hit mixed obstacle colors"
+        return int(next(iter(cols)))
+
+    for d0 in range(4):
+        r, c, d = sr, sc, d0
+        hit_count = 0
+        seen: set[tuple[int, int, int, int]] = set()
+        while True:
+            state = (r, c, d, hit_count % 2)
+            assert state not in seen, "beam path must not cycle"
+            seen.add(state)
+
+            dr, dc = _DIRS[d]
+            nr, nc = r + dr, c + dc
+            if not in_bounds(nr, nc):
+                break
+
+            oc = obstacle_color_at_next(nr, nc)
+            if oc is None:
+                r, c = nr, nc
+                paint_block(r, c)
+                continue
+
+            hit_count += 1
+            d = _rot_cw(d) if hit_count % 2 == 1 else _rot_ccw(d)
+
+    return out
+
+
+# --------------- generator (o5x) ---------------
+
+# ── Configuration ──────────────────────────────────────────────────────
+LEGEND_COLOR_POOL = [1, 2, 3, 4, 6]
+BG_COLOR_POOL = [1, 2, 3, 4, 6, 7, 9]
+LEGEND_BG = 5
+TEAL = 8
+
+GRID_H_RANGE = (19, 24)
+GRID_W = 24
+LEGEND_H = 6
+LEGEND_CELL_STARTS = [1, 7, 13, 19]
+
+TEAL_SZ2_PROB = 0.75
+SQUARE_EDGE_GAP = 5
+
+OBS_COUNT_4_PROB = 0.65
+OBS_THICKNESS_RANGE = (2, 4)
+OBS_SINGLE_MARGIN = 6
+OBS_BOTH_GAP = 2
+
+SPAN_MIN_MULT = 3
+SPAN_MAX_MULT = 14
+SPAN_COMPACT_PROB = 0.4
+
+MAX_RETRIES = 300
+
+
+def _rot(d: int, turn: str) -> int:
+    return (d - 1) % 4 if turn == "L" else (d + 1) % 4
+
+
+def _choose_span(
+    axis_len: int,
+    required: list[tuple[int, int]],
+    excluded: list[tuple[int, int]],
+    min_len: int,
+    max_len: int,
+) -> tuple[int, int] | None:
+    """Pick a (start, end) span covering all required intervals and avoiding excluded ones."""
+    req0 = min(a for a, _ in required)
+    req1 = max(b for _, b in required)
+    lo = max(min_len, req1 - req0 + 1)
+    hi = min(max_len, axis_len)
+    choices: list[tuple[int, int, int]] = []
+    for length in range(lo, hi + 1):
+        start0 = max(0, req1 - length + 1)
+        start1 = min(req0, axis_len - length)
+        for start in range(start0, start1 + 1):
+            end = start + length - 1
+            if all(end < a or start > b for a, b in excluded):
+                choices.append((length, start, end))
+    if not choices:
+        return None
+
+    lengths = sorted({length for length, _, _ in choices})
+    if random.random() < SPAN_COMPACT_PROB:
+        cutoff = lengths[min(len(lengths) - 1, max(0, len(lengths) // 2))]
+        pool = [(start, end) for length, start, end in choices if length <= cutoff]
+    else:
+        pool = [(start, end) for _, start, end in choices]
+    return random.choice(pool)
+
+
+def _simulate_alternating(
+    base: np.ndarray, bg: int
+) -> tuple[np.ndarray, list[list[tuple[int, int, int, int]]]]:
+    """Simulate the variant rule, returning the painted grid and per-beam hit traces."""
+    vals, counts = np.unique(base, return_counts=True)
+    assert int(vals[counts.argmax()]) == bg
+
+    sr, sc, sz = _find_teal_square(base, teal=TEAL)
+    out = base.copy()
+    h, w = out.shape
+    hits: list[list[tuple[int, int, int, int]]] = []
+
+    def in_bounds(r: int, c: int) -> bool:
+        return 0 <= r and 0 <= c and r + sz - 1 < h and c + sz - 1 < w
+
+    def paint(r: int, c: int) -> None:
+        blk = out[r : r + sz, c : c + sz]
+        blk[blk == bg] = TEAL
+        out[r : r + sz, c : c + sz] = blk
+
+    def obstacle_at(r: int, c: int) -> int | None:
+        colors = set(map(int, np.unique(out[r : r + sz, c : c + sz])))
+        colors.discard(bg)
+        colors.discard(TEAL)
+        if not colors:
+            return None
+        assert len(colors) == 1
+        return int(next(iter(colors)))
+
+    for d0 in range(4):
+        r, c, d = int(sr), int(sc), d0
+        hit_count = 0
+        beam_hits: list[tuple[int, int, int, int]] = []
+        seen: set[tuple[int, int, int, int]] = set()
+        while True:
+            state = (r, c, d, hit_count % 2)
+            assert state not in seen
+            seen.add(state)
+            dr, dc = _DIRS[d]
+            nr, nc = r + dr, c + dc
+            if not in_bounds(nr, nc):
+                break
+            obs = obstacle_at(nr, nc)
+            if obs is None:
+                r, c = nr, nc
+                paint(r, c)
+                continue
+            beam_hits.append((d, obs, nr, nc))
+            hit_count += 1
+            d = _rot_cw(d) if hit_count % 2 == 1 else _rot_ccw(d)
+            assert len(beam_hits) <= 2
+        hits.append(beam_hits)
+
+    return out, hits
+
+
+def _simulate_legend(
+    base: np.ndarray, turns: dict[int, str], bg: int
+) -> tuple[np.ndarray, list[list[tuple[int, int, int, int]]]]:
+    """Simulate the original color-to-turn rule for non-degeneracy checks."""
+    vals, counts = np.unique(base, return_counts=True)
+    assert int(vals[counts.argmax()]) == bg
+
+    sr, sc, sz = _find_teal_square(base, teal=TEAL)
+    out = base.copy()
+    h, w = out.shape
+    hits: list[list[tuple[int, int, int, int]]] = []
+
+    def in_bounds(r: int, c: int) -> bool:
+        return 0 <= r and 0 <= c and r + sz - 1 < h and c + sz - 1 < w
+
+    def paint(r: int, c: int) -> None:
+        blk = out[r : r + sz, c : c + sz]
+        blk[blk == bg] = TEAL
+        out[r : r + sz, c : c + sz] = blk
+
+    def obstacle_at(r: int, c: int) -> int | None:
+        colors = set(map(int, np.unique(out[r : r + sz, c : c + sz])))
+        colors.discard(bg)
+        colors.discard(TEAL)
+        if not colors:
+            return None
+        assert len(colors) == 1
+        return int(next(iter(colors)))
+
+    for d0 in range(4):
+        r, c, d = int(sr), int(sc), d0
+        beam_hits: list[tuple[int, int, int, int]] = []
+        seen: set[tuple[int, int, int]] = set()
+        while True:
+            state = (r, c, d)
+            assert state not in seen
+            seen.add(state)
+            dr, dc = _DIRS[d]
+            nr, nc = r + dr, c + dc
+            if not in_bounds(nr, nc):
+                break
+            obs = obstacle_at(nr, nc)
+            if obs is None:
+                r, c = nr, nc
+                paint(r, c)
+                continue
+            assert obs in turns
+            beam_hits.append((d, obs, nr, nc))
+            d = _rot(d, turns[obs])
+            assert len(beam_hits) <= 2
+        hits.append(beam_hits)
+
+    return out, hits
+
+
+def _make_legend(legend_colors: list[int], turns: dict[int, str]) -> np.ndarray:
+    """Build the 6x24 legend band from 4 colors and arbitrary bar placements."""
+    legend = np.full((LEGEND_H, GRID_W), LEGEND_BG, dtype=int)
+    for start, color in zip(LEGEND_CELL_STARTS, legend_colors):
+        legend[1:5, start : start + 4] = 0
+        bar_col = start if turns[color] == "L" else start + 3
+        legend[1:5, bar_col] = color
+    return legend
+
+
+def _rand_thickness(lo: int, hi: int) -> int | None:
+    return random.randint(lo, hi) if hi >= lo else None
+
+
+def _thickness_pair(
+    axis: int, sz: int, a_present: bool, b_present: bool
+) -> tuple[int | None, int | None] | None:
+    """Compute obstacle thicknesses for the two ends of an axis (N/S or W/E)."""
+    lo, hi_cap = OBS_THICKNESS_RANGE
+    if a_present and b_present:
+        room = axis - sz - OBS_BOTH_GAP
+        if room < 2 * lo:
+            return None
+        a = random.randint(lo, min(hi_cap, room - lo))
+        b = _rand_thickness(lo, min(hi_cap, room - a))
+        return (a, b) if b is not None else None
+    if a_present:
+        t = _rand_thickness(lo, min(hi_cap, axis - sz - OBS_SINGLE_MARGIN))
+        return (t, None) if t is not None else None
+    if b_present:
+        t = _rand_thickness(lo, min(hi_cap, axis - sz - OBS_SINGLE_MARGIN))
+        return (None, t) if t is not None else None
+    return None, None
+
+
+def _obstacle_rect(
+    side: int, thickness: int, span: tuple[int, int], h: int, w: int
+) -> tuple[int, int, int, int]:
+    """Return (r0, r1, c0, c1) for an edge-touching obstacle rectangle."""
+    s0, s1 = span
+    if side == _N:
+        return 0, thickness - 1, s0, s1
+    if side == _S:
+        return h - thickness, h - 1, s0, s1
+    if side == _W:
+        return s0, s1, 0, thickness - 1
+    return s0, s1, w - thickness, w - 1
+
+
+def _select_chains(
+    present: set[int], second_hits: int
+) -> dict[int, int] | None:
+    """Pick non-overlapping side -> clockwise(side) chains for the unique second hit."""
+    candidates = [(side, _rot_cw(side)) for side in present if _rot_cw(side) in present]
+    random.shuffle(candidates)
+    selected: list[tuple[int, int]] = []
+    used: set[int] = set()
+    for side, nxt in candidates:
+        if len(selected) == second_hits:
+            break
+        if side in used or nxt in used:
+            continue
+        selected.append((side, nxt))
+        used.update((side, nxt))
+    return dict(selected) if len(selected) == second_hits else None
+
+
+def _compute_span_constraints(
+    present: set[int],
+    chains: dict[int, int],
+    sr: int,
+    sc: int,
+    sz: int,
+    lane: dict[int, int],
+) -> tuple[dict[int, list[tuple[int, int]]], dict[int, list[tuple[int, int]]]]:
+    """Build required/excluded intervals implied by the fixed CW then CCW path."""
+    required: dict[int, list[tuple[int, int]]] = {s: [] for s in present}
+    excluded: dict[int, list[tuple[int, int]]] = {s: [] for s in present}
+
+    for side in present:
+        base_coord = sc if side in (_N, _S) else sr
+        required[side].append((base_coord, base_coord + sz - 1))
+
+    def lane_interval(side: int) -> tuple[int, int]:
+        return lane[side], lane[side] + sz - 1
+
+    for side in present:
+        nxt = _rot_cw(side)
+        if nxt not in present:
+            continue
+        if chains.get(side) == nxt:
+            required[nxt].append(lane_interval(side))
+            excluded[side].append(lane_interval(nxt))
+        else:
+            excluded[nxt].append(lane_interval(side))
+
+    return required, excluded
+
+
+def _gen_attempt() -> np.ndarray | None:
+    h, w = random.randint(*GRID_H_RANGE), GRID_W
+    sz = 2 if random.random() < TEAL_SZ2_PROB else 3
+    obstacle_count = 4 if random.random() < OBS_COUNT_4_PROB else 3
+    present = set(random.sample([_N, _E, _S, _W], obstacle_count))
+    second_hits = 1
+
+    ns = _thickness_pair(h, sz, _N in present, _S in present)
+    ew = _thickness_pair(w, sz, _W in present, _E in present)
+    if ns is None or ew is None:
+        return None
+    thickness = {s: t for s, t in zip((_N, _S, _W, _E), (*ns, *ew)) if t is not None}
+
+    min_r, max_r = SQUARE_EDGE_GAP, h - sz - SQUARE_EDGE_GAP
+    min_c, max_c = SQUARE_EDGE_GAP, w - sz - SQUARE_EDGE_GAP
+    if _N in present:
+        min_r = max(min_r, thickness[_N] + 1)
+    if _S in present:
+        max_r = min(max_r, h - thickness[_S] - sz - 1)
+    if _W in present:
+        min_c = max(min_c, thickness[_W] + 1)
+    if _E in present:
+        max_c = min(max_c, w - thickness[_E] - sz - 1)
+    if min_r > max_r or min_c > max_c:
+        return None
+    sr, sc = random.randint(min_r, max_r), random.randint(min_c, max_c)
+
+    lane: dict[int, int] = {}
+    if _N in present:
+        lane[_N] = thickness[_N] + 1
+    if _S in present:
+        lane[_S] = h - thickness[_S] - sz
+    if _W in present:
+        lane[_W] = thickness[_W] + 1
+    if _E in present:
+        lane[_E] = w - thickness[_E] - sz
+
+    chains = _select_chains(present, second_hits)
+    if chains is None:
+        return None
+
+    required, excluded = _compute_span_constraints(present, chains, sr, sc, sz, lane)
+
+    spans: dict[int, tuple[int, int]] = {}
+    for side in present:
+        axis_len = w if side in (_N, _S) else h
+        span = _choose_span(
+            axis_len,
+            required[side],
+            excluded[side],
+            SPAN_MIN_MULT * sz,
+            min(SPAN_MAX_MULT * sz, axis_len),
+        )
+        if span is None:
+            return None
+        spans[side] = span
+
+    legend_colors = random.sample(LEGEND_COLOR_POOL, 4)
+    obstacle_colors = random.sample(legend_colors, obstacle_count)
+    side_color = dict(zip(sorted(present), obstacle_colors))
+    bg = random.choice([c for c in BG_COLOR_POOL if c not in legend_colors])
+
+    base = np.full((h, w), bg, dtype=int)
+    base[sr : sr + sz, sc : sc + sz] = TEAL
+    occupied = np.zeros((h, w), dtype=bool)
+    for side in present:
+        r0, r1, c0, c1 = _obstacle_rect(side, thickness[side], spans[side], h, w)
+        region = occupied[r0 : r1 + 1, c0 : c1 + 1]
+        if region.any():
