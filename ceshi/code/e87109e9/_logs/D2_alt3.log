+SQUARE_EDGE_GAP = 5
+
+OBS_COUNT_4_PROB = 0.65
+OBS_THICKNESS_RANGE = (2, 4)
+OBS_SINGLE_MARGIN = 6
+OBS_BOTH_GAP = 2
