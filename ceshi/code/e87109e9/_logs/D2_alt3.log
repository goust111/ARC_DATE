+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Emit four teal beams from a square, turning in an alternating sequence.
+
+    Input structure:
+    - Top band: a grey (5) legend region with colored vertical bars, visually matching the source task.
+    - Below: the main grid containing one solid teal (8) square on a uniform background plus colored obstacle blocks.
+
+    Rule:
+    - Remove the legend from the output.
+    - Launch one square-width teal beam in each cardinal direction from the teal square.
+    - A beam paints teal over background cells as it advances.
+    - When a beam hits any obstacle, ignore that obstacle's color and turn by encounter order along that same beam:
+      first hit clockwise, second hit counterclockwise, third clockwise, and so on.
+    - Beams stop once their next square step would leave the main grid.
+
+    Key insight: The legend is now only a leftover visual motif; the real control signal is the per-beam hit count parity, which alternates the turn direction.
+    """
+    g = np.asarray(grid, dtype=int)
+
+    legend_bg = 5
+    rows_with_legend = np.where(np.any(g == legend_bg, axis=1))[0]
+    assert rows_with_legend.size, "legend rows must be present"
+    legend_h = int(rows_with_legend.max() + 1)
+    assert np.array_equal(rows_with_legend, np.arange(legend_h)), "legend color must be confined to the top band"
+
+    base = g[legend_h:, :].copy()
+    assert base.size, "main grid must remain after legend crop"
+
+    vals, cnts = np.unique(base, return_counts=True)
+    bg = int(vals[cnts.argmax()])
+    teal = 8
+    sr, sc, sz = _find_teal_square(base, teal=teal)
+
+    out = base.copy()
+
+    def in_bounds(r: int, c: int) -> bool:
+        return 0 <= r and 0 <= c and r + sz - 1 < out.shape[0] and c + sz - 1 < out.shape[1]
+
+    def paint_block(r: int, c: int) -> None:
+        blk = out[r : r + sz, c : c + sz]
+        blk[blk == bg] = teal
+        out[r : r + sz, c : c + sz] = blk
+
+    def obstacle_color_at_next(nr: int, nc: int) -> int | None:
+        blk = out[nr : nr + sz, nc : nc + sz]
+        cols = set(map(int, np.unique(blk)))
+        cols.discard(bg)
+        cols.discard(teal)
+        if not cols:
+            return None
+        assert len(cols) == 1, "beam footprint must not hit mixed obstacle colors"
+        return int(next(iter(cols)))
+
+    for d0 in range(4):
+        r, c, d = sr, sc, d0
+        hit_count = 0
+        seen: set[tuple[int, int, int, int]] = set()
+        while True:
+            state = (r, c, d, hit_count % 2)
+            assert state not in seen, "beam path must not cycle"
+            seen.add(state)
+
+            dr, dc = _DIRS[d]
+            nr, nc = r + dr, c + dc
+            if not in_bounds(nr, nc):
+                break
+
+            oc = obstacle_color_at_next(nr, nc)
+            if oc is None:
+                r, c = nr, nc
+                paint_block(r, c)
+                continue
+
+            hit_count += 1
+            d = _rot_cw(d) if hit_count % 2 == 1 else _rot_ccw(d)
+
+    return out
