   114	def _trace_beams(
   115	    base: np.ndarray,
   116	    turns: dict[int, str],
   117	    bg: int,
   118	    *,
   119	    sequential: bool,
   120	) -> tuple[np.ndarray, list[dict[str, object]]]:
   121	    teal = 8
   122	    sr, sc, sz = _find_teal_square(base, teal=teal)
   123	    out = base.copy()
   124	    h, w = out.shape
   125	    prior_trail = np.zeros((h, w), dtype=bool)
   126	    beam_infos: list[dict[str, object]] = []
   127	
   128	    def in_bounds(r: int, c: int) -> bool:
   129	        return 0 <= r and 0 <= c and r + sz - 1 < h and c + sz - 1 < w
   130	
   131	    def paint_block(r: int, c: int, trail_mask: np.ndarray) -> None:
   132	        blk = out[r : r + sz, c : c + sz]
   133	        newly = blk == bg
   134	        blk[newly] = teal
   135	        out[r : r + sz, c : c + sz] = blk
   136	        trail_mask[r : r + sz, c : c + sz] |= newly
   137	
   138	    def obstacle_color_at_next(nr: int, nc: int) -> int | None:
   139	        blk = base[nr : nr + sz, nc : nc + sz]
   140	        cols = set(map(int, np.unique(blk)))
   141	        cols.discard(bg)
   142	        cols.discard(teal)
   143	        if not cols:
   144	            return None
   145	        assert len(cols) == 1, "beam footprint must not hit mixed obstacle colors"
   146	        return int(next(iter(cols)))
   147	
   148	    for d0 in range(4):
   149	        r, c, d = sr, sc, d0
   150	        seen: set[tuple[int, int, int]] = set()
   151	        beam_trail = np.zeros((h, w), dtype=bool)
   152	        hit_colors: list[int] = []
   153	        blocked_by_prior = 0
   154	        steps = 0
   155	        while True:
   156	            state = (r, c, d)
   157	            assert state not in seen, "beam path must not cycle"
   158	            seen.add(state)
   159	
   160	            dr, dc = _DIRS[d]
   161	            nr, nc = r + dr, c + dc
   162	            if not in_bounds(nr, nc):
   163	                break
   164	
   165	            if sequential and prior_trail[nr : nr + sz, nc : nc + sz].any():
   166	                blocked_by_prior += 1
   167	                break
   168	
   169	            oc = obstacle_color_at_next(nr, nc)
   170	            if oc is None:
   171	                r, c = nr, nc
   172	                paint_block(r, c, beam_trail)
   173	                steps += 1
   174	                continue
   175	
   176	            assert oc in turns, "obstacle color must be encoded by legend"
   177	            hit_colors.append(oc)
   178	            d = _rot(d, turns[oc])
   179	
   180	        if sequential:
   181	            prior_trail |= beam_trail
   182	        beam_infos.append(
   183	            {
   184	                "dir": d0,
   185	                "hit_colors": hit_colors,
   186	                "blocked_by_prior": blocked_by_prior,
   187	                "steps": steps,
   188	                "trail_cells": int(beam_trail.sum()),
   189	            }
   190	        )
   191	
   192	    return out, beam_infos
   193	
   194	
   195	def main(grid: np.ndarray) -> np.ndarray:
   196	    """
   197	    Paint teal rays from a square, but resolve them in a fixed firing order.
   198	
   199	    Input structure:
   200	    - The top band is a grey legend whose four colored bars encode left-vs-right turns.
   201	    - Beneath it is the main field with one solid teal square, a dominant background color, and solid edge-touching obstacle blocks.
   202	
   203	    Rule:
   204	    - Remove the legend from the output.
   205	    - Fire the square-shaped beams in the order up, then right, then down, then left.
   206	    - A beam slides one cell at a time, painting teal only onto background cells.
   207	    - When a beam meets a colored obstacle, it turns according to that color's legend bar.
   208	    - When a later beam would step onto teal painted by an earlier beam, it stops there; finished trails persist as blockers for the remaining directions.
   209	
   210	    Key insight:
   211	    - The four directions can no longer be traced independently. Earlier teal trails become permanent geometry, so solving requires simulating the directions in sequence.
   212	    """
   213	    g = np.asarray(grid, dtype=int)
   214	
   215	    legend_bg = 5
   216	    rows_with_legend = np.where(np.any(g == legend_bg, axis=1))[0]
   217	    assert rows_with_legend.size, "legend rows must be present"
   218	    legend_h = int(rows_with_legend.max() + 1)
   219	    assert np.array_equal(rows_with_legend, np.arange(legend_h)), "legend color must be confined to the top band"
   220	
   221	    legend_turn = _parse_legend(g, legend_h)
   222	
   223	    base = g[legend_h:, :].copy()
   224	    assert base.size, "main grid must remain after legend crop"
   225	
   226	    vals, cnts = np.unique(base, return_counts=True)
   227	    bg = int(vals[cnts.argmax()])
   228	    out, _beam_infos = _trace_beams(base, legend_turn, bg, sequential=True)
   229	    return out
   230	
