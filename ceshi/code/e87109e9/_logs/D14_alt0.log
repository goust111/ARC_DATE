+
+import numpy as np
+
+from arc_utils import bbox_coords, components_mask
+
+# Design analysis
+# analysis:
+#   concretization:
+#     - 视觉元素仍保持原题样式: 顶部是 6x24 的图例带, 下方是主画布, 主画布里有一个实心青色方块和若干贴边彩色矩形障碍.
+#     - 变体只改 beam 的时序. 输出里仍然只看到裁掉图例后的主画布, 以及青色轨迹.
+#     - 新行为的关键可见现象是“旧轨迹挡住新轨迹”.
+#       本实现固定生成一个稳定可见的模式:
+#         1. 上向 beam 先撞顶边障碍并右转, 再撞右边障碍并下转, 因而在右侧留下纵向青色轨迹.
+#         2. 右向 beam 第二个发射, 会在撞到右边彩色障碍之前先撞到这条旧青色轨迹并提前停止.
+#       这样同一输入在原题并行逻辑下会让右向 beam 继续撞右边障碍, 在本变体里则不会, 差异是肉眼可见的.
+#   behavior_trace:
+#     - 原逻辑:
+#       上、右、下、左四条 beam 都只看原始彩色障碍, 把 teal 当作“自己人”, 所以彼此互不影响.
+#       右向 beam 会一路前进到右边障碍, 再按图例转弯.
+#     - 新逻辑:
+#       先完整走完上向 beam, 把它新涂出的 teal 轨迹登记为永久障碍.
+#       右向 beam 再出发时, 只要下一步 footprint 与这条旧 teal 轨迹重叠, 就立刻停止, 不再继续撞右边彩色障碍.
+#     - 差异:
+#       变化发生在“下一步是否可走”的判定阶段. 原题只检查彩色障碍; 变体还要检查是否碰到旧 teal 轨迹.
+#   complexity_calibration:
+#     - 仍保留 4 个图例颜色、4 个贴边矩形障碍、2x2/3x3 的青色方块和多次转弯, 所以视觉密度与原题接近.
+#     - 为了让顺序效应稳定可见, generator 固定保留 4 个障碍, 并强制上向 beam 形成一次两段转弯链.
+#       其余障碍仍会被命中, 但不会把规则复杂度放大到难以归纳.
+#   implicit_assumption_audit:
+#     - 原 main() 里的 obstacle_color_at_next 会丢弃 teal, 这依赖“teal 永远不构成障碍”.
+#       变体下这个前提失效, 所以需要把“彩色障碍检测”与“旧 teal 轨迹阻挡检测”拆开.
+#     - 原 for d0 in range(4) 每条 beam 共享 out, 但 teal 只用于着色, 不影响后续路径; 这是旧规则才成立的“无害共享”.
+#       变体下必须额外维护 prior_trail 掩码, 且只能在一条 beam 完成后再并入, 否则当前 beam 会被自己的新轨迹立刻卡住.
+#     - 仍保留 state 去重, 但它现在只针对单条 beam 的位置/方向循环; prior_trail 的变化只发生在 beam 之间.
+#   placement_legality:
+#     - 障碍仍全部贴边放置, 但 span 会被限制在避开四角重叠的区间内.
+#     - 右边障碍必须同时覆盖:
+#       1. 源方块的行带, 保证原题并行逻辑下右向 beam 本来会撞上它;
+#       2. 上向 beam 在顶边转弯后的行带, 保证上向 beam 能继续撞到右边障碍.
+#     - 下边障碍明确避开右侧纵向轨迹所在列带, 避免上向 beam 的第二段继续撞到底边障碍, 从而把模板复杂度控制在稳定范围.
+#   visual_observability:
+#     - 顺序不是通过颜色 id、排序编号之类不可见属性编码, 而是直接体现在输出中的几何截停:
+#       同样的右侧障碍摆在那里, 但右向 beam 在本变体里就是更短.
+#     - 2~3 个样例足以让人看到“先画出的 teal 会挡住后画的 teal”.
+#   cleanliness:
+#     - 交互只发生在几条清晰的宽带状轨迹之间, 不在同一区域堆叠多层不同标记.
+#     - generator 会拒绝彩色障碍与旧 teal 同时出现在同一步 footprint 的样例, 避免歧义.
+#   color_inference:
+#     - 颜色的职责没有新增: 彩色障碍只表示转向方向, teal 只表示源方块与轨迹.
+#     - 图例仍使用 4 个独立颜色, 至少包含左右两种条位中的一种可变因素, 不依赖隐藏数值关系.
+
+_DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+_N, _E, _S, _W = range(4)
+
+
+def _parse_legend(grid: np.ndarray, legend_h: int) -> dict[int, str]:
+    legend = grid[:legend_h, :]
+    assert legend.size, "legend must be non-empty"
+    vals, cnts = np.unique(legend, return_counts=True)
+    bg = int(vals[cnts.argmax()])
+
+    sep_cols = [c for c in range(legend.shape[1]) if np.all(legend[:, c] == bg)]
+    assert len(sep_cols) >= 2, "legend separator columns must exist"
+
+    turn: dict[int, str] = {}
+    for a, b in zip(sep_cols, sep_cols[1:], strict=False):
+        if b - a <= 2:
+            continue
+        interior = legend[1 : legend_h - 1, a + 1 : b]
+        colors = set(map(int, np.unique(interior)))
+        colors.discard(bg)
+        colors.discard(0)
+        assert len(colors) == 1, "each legend cell must encode exactly one color"
+        col = int(next(iter(colors)))
+        xs = np.where(interior == col)[1]
+        turn[col] = "L" if int(xs[0]) <= (interior.shape[1] - 1) // 2 else "R"
+    assert len(turn) == 4, "legend must encode four turn colors"
+    return turn
+
+
+def _find_teal_square(g: np.ndarray, teal: int = 8) -> tuple[int, int, int]:
+    candidates: list[tuple[int, int, int]] = []
+    for cells in components_mask(g == teal, connectivity=4):
+        r0, c0, r1, c1 = bbox_coords(cells)
+        hh = r1 - r0 + 1
+        ww = c1 - c0 + 1
+        if hh != ww:
+            continue
+        if int(np.sum(g[r0 : r1 + 1, c0 : c1 + 1] == teal)) != hh * ww:
+            continue
+        candidates.append((int(r0), int(c0), int(hh)))
+    assert len(candidates) == 1, "main grid must contain exactly one solid teal square"
+    return candidates[0]
+
+
+def _rot_ccw(d: int) -> int:
+    return (d - 1) % 4
+
+
+def _rot_cw(d: int) -> int:
+    return (d + 1) % 4
+
+
+def _rot(d: int, turn: str) -> int:
+    return _rot_ccw(d) if turn == "L" else _rot_cw(d)
+
+
+def _trace_beams(
+    base: np.ndarray,
+    turns: dict[int, str],
+    bg: int,
+    *,
+    sequential: bool,
+) -> tuple[np.ndarray, list[dict[str, object]]]:
+    teal = 8
+    sr, sc, sz = _find_teal_square(base, teal=teal)
+    out = base.copy()
+    h, w = out.shape
+    prior_trail = np.zeros((h, w), dtype=bool)
+    beam_infos: list[dict[str, object]] = []
+
+    def in_bounds(r: int, c: int) -> bool:
+        return 0 <= r and 0 <= c and r + sz - 1 < h and c + sz - 1 < w
+
+    def paint_block(r: int, c: int, trail_mask: np.ndarray) -> None:
+        blk = out[r : r + sz, c : c + sz]
+        newly = blk == bg
+        blk[newly] = teal
+        out[r : r + sz, c : c + sz] = blk
+        trail_mask[r : r + sz, c : c + sz] |= newly
+
+    def obstacle_color_at_next(nr: int, nc: int) -> int | None:
+        blk = base[nr : nr + sz, nc : nc + sz]
+        cols = set(map(int, np.unique(blk)))
+        cols.discard(bg)
+        cols.discard(teal)
+        if not cols:
+            return None
+        assert len(cols) == 1, "beam footprint must not hit mixed obstacle colors"
+        return int(next(iter(cols)))
+
+    for d0 in range(4):
+        r, c, d = sr, sc, d0
+        seen: set[tuple[int, int, int]] = set()
+        beam_trail = np.zeros((h, w), dtype=bool)
+        hit_colors: list[int] = []
+        blocked_by_prior = 0
+        steps = 0
+        while True:
+            state = (r, c, d)
+            assert state not in seen, "beam path must not cycle"
+            seen.add(state)
+
+            dr, dc = _DIRS[d]
+            nr, nc = r + dr, c + dc
+            if not in_bounds(nr, nc):
+                break
+
+            if sequential and prior_trail[nr : nr + sz, nc : nc + sz].any():
+                blocked_by_prior += 1
+                break
+
+            oc = obstacle_color_at_next(nr, nc)
+            if oc is None:
+                r, c = nr, nc
+                paint_block(r, c, beam_trail)
+                steps += 1
+                continue
+
+            assert oc in turns, "obstacle color must be encoded by legend"
+            hit_colors.append(oc)
+            d = _rot(d, turns[oc])
+
+        if sequential:
+            prior_trail |= beam_trail
+        beam_infos.append(
+            {
+                "dir": d0,
+                "hit_colors": hit_colors,
+                "blocked_by_prior": blocked_by_prior,
+                "steps": steps,
+                "trail_cells": int(beam_trail.sum()),
+            }
+        )
