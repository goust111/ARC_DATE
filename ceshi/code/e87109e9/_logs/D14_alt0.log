+        return None
+
+    req_cols = (sc, sc + sz - 1)
+    req_rows = (sr, sr + sz - 1)
+    lane_n_iv = (lane_n, lane_n + sz - 1)
+    lane_s_iv = (lane_s, lane_s + sz - 1)
+    lane_w_iv = (lane_w, lane_w + sz - 1)
+    lane_e_iv = (lane_e, lane_e + sz - 1)
+
+    spans: dict[int, tuple[int, int]] = {}
+    spans[_N] = _choose_span(
+        w,
+        col_lo,
+        col_hi,
+        [req_cols],
+        [lane_w_iv] if side_turn[_W] == "R" else [],
+        SPAN_MIN_MULT * sz,
+        min(SPAN_MAX_MULT * sz, col_hi - col_lo + 1),
+    )
+    if spans[_N] is None:
+        return None
+
+    spans[_E] = _choose_span(
+        h,
+        row_lo,
+        row_hi,
+        [req_rows, lane_n_iv],
+        [lane_s_iv],
+        SPAN_MIN_MULT * sz,
+        min(SPAN_MAX_MULT * sz, row_hi - row_lo + 1),
+    )
+    if spans[_E] is None:
+        return None
+
+    s_excluded = [lane_e_iv]
+    if side_turn[_W] == "L":
+        s_excluded.append(lane_w_iv)
+    spans[_S] = _choose_span(
+        w,
+        col_lo,
+        col_hi,
+        [req_cols],
+        s_excluded,
+        SPAN_MIN_MULT * sz,
+        min(SPAN_MAX_MULT * sz, col_hi - col_lo + 1),
+    )
+    if spans[_S] is None:
+        return None
+
+    spans[_W] = _choose_span(
+        h,
+        row_lo,
+        row_hi,
+        [req_rows],
+        [],
+        SPAN_MIN_MULT * sz,
+        min(SPAN_MAX_MULT * sz, row_hi - row_lo + 1),
+    )
+    if spans[_W] is None:
+        return None
+
+    legend_colors = random.sample(LEGEND_COLOR_POOL, 4)
+    side_color = {
+        _N: legend_colors[0],
+        _E: legend_colors[1],
+        _S: legend_colors[2],
+        _W: legend_colors[3],
+    }
+    bg = random.choice([c for c in BG_COLOR_POOL if c not in legend_colors])
+
+    base = np.full((h, w), bg, dtype=int)
+    base[sr : sr + sz, sc : sc + sz] = TEAL
+    for side in (_N, _E, _S, _W):
+        r0, r1, c0, c1 = _obstacle_rect(side, thickness[side], spans[side], h, w)
+        if np.any(base[r0 : r1 + 1, c0 : c1 + 1] != bg):
+            return None
+        if not (r1 < sr - 1 or r0 > sr + sz or c1 < sc - 1 or c0 > sc + sz):
+            return None
+        base[r0 : r1 + 1, c0 : c1 + 1] = side_color[side]
+
+    vals, cnts = np.unique(base, return_counts=True)
+    if int(vals[cnts.argmax()]) != bg:
+        return None
+
+    turns = {side_color[side]: side_turn[side] for side in (_N, _E, _S, _W)}
+
+    try:
+        expected, seq_info = _trace_beams(base, turns, bg, sequential=True)
+        parallel_out, par_info = _trace_beams(base, turns, bg, sequential=False)
+    except AssertionError:
+        return None
+
+    hit_lists = [info["hit_colors"] for info in seq_info]
+    if hit_lists[0] != [side_color[_N], side_color[_E]]:
+        return None
+    if hit_lists[1] != [] or int(seq_info[1]["blocked_by_prior"]) != 1:
+        return None
+    if hit_lists[2] != [side_color[_S]]:
+        return None
+    if hit_lists[3] != [side_color[_W]]:
+        return None
+    if sum(len(hits) for hits in hit_lists) != 4:
+        return None
+    if {color for hits in hit_lists for color in hits} != set(side_color.values()):
+        return None
+
+    if par_info[1]["hit_colors"] != [side_color[_E]]:
+        return None
+    if np.array_equal(expected, parallel_out):
+        return None
+
+    legend = _make_legend(legend_colors, turns)
+    inp = np.vstack([legend, base])
+    try:
+        actual = main(inp)
+    except AssertionError:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate e87109e9 D14 input")

diff --git a/ceshi/code/e87109e9/D14/0/code.py b/ceshi/code/e87109e9/D14/0/code.py
new file mode 100644
index 0000000000000000000000000000000000000000..cdf6132267a42465e7de0b1b3a921751ec350e69
--- /dev/null
+++ b/ceshi/code/e87109e9/D14/0/code.py
@@ -0,0 +1,496 @@
+# Variant of e87109e9
+# Dimension: D14 — 多步处理与射线顺序 (multi_step)
+# Change: 所有射线从源方块同时向4个方向发射，各自独立追踪路径直到离开网格，无射线间顺序依赖
+#   → 按上→右→下→左顺序依次发射，先前射线留下的青色轨迹会阻挡后续射线
+
+import random
+
+import numpy as np
+
+from arc_utils import bbox_coords, components_mask
+
+# Design analysis
+# analysis:
+#   concretization:
+#     - 视觉元素仍保持原题样式: 顶部是 6x24 的图例带, 下方是主画布, 主画布里有一个实心青色方块和若干贴边彩色矩形障碍.
+#     - 变体只改 beam 的时序. 输出里仍然只看到裁掉图例后的主画布, 以及青色轨迹.
+#     - 新行为的关键可见现象是“旧轨迹挡住新轨迹”.
+#       本实现固定生成一个稳定可见的模式:
+#         1. 上向 beam 先撞顶边障碍并右转, 再撞右边障碍并下转, 因而在右侧留下纵向青色轨迹.
+#         2. 右向 beam 第二个发射, 会在撞到右边彩色障碍之前先撞到这条旧青色轨迹并提前停止.
+#       这样同一输入在原题并行逻辑下会让右向 beam 继续撞右边障碍, 在本变体里则不会, 差异是肉眼可见的.
+#   behavior_trace:
+#     - 原逻辑:
+#       上、右、下、左四条 beam 都只看原始彩色障碍, 把 teal 当作“自己人”, 所以彼此互不影响.
+#       右向 beam 会一路前进到右边障碍, 再按图例转弯.
+#     - 新逻辑:
+#       先完整走完上向 beam, 把它新涂出的 teal 轨迹登记为永久障碍.
+#       右向 beam 再出发时, 只要下一步 footprint 与这条旧 teal 轨迹重叠, 就立刻停止, 不再继续撞右边彩色障碍.
+#     - 差异:
+#       变化发生在“下一步是否可走”的判定阶段. 原题只检查彩色障碍; 变体还要检查是否碰到旧 teal 轨迹.
+#   complexity_calibration:
+#     - 仍保留 4 个图例颜色、4 个贴边矩形障碍、2x2/3x3 的青色方块和多次转弯, 所以视觉密度与原题接近.
+#     - 为了让顺序效应稳定可见, generator 固定保留 4 个障碍, 并强制上向 beam 形成一次两段转弯链.
+#       其余障碍仍会被命中, 但不会把规则复杂度放大到难以归纳.
+#   implicit_assumption_audit:
+#     - 原 main() 里的 obstacle_color_at_next 会丢弃 teal, 这依赖“teal 永远不构成障碍”.
+#       变体下这个前提失效, 所以需要把“彩色障碍检测”与“旧 teal 轨迹阻挡检测”拆开.
+#     - 原 for d0 in range(4) 每条 beam 共享 out, 但 teal 只用于着色, 不影响后续路径; 这是旧规则才成立的“无害共享”.
+#       变体下必须额外维护 prior_trail 掩码, 且只能在一条 beam 完成后再并入, 否则当前 beam 会被自己的新轨迹立刻卡住.
+#     - 仍保留 state 去重, 但它现在只针对单条 beam 的位置/方向循环; prior_trail 的变化只发生在 beam 之间.
+#   placement_legality:
+#     - 障碍仍全部贴边放置, 但 span 会被限制在避开四角重叠的区间内.
+#     - 右边障碍必须同时覆盖:
+#       1. 源方块的行带, 保证原题并行逻辑下右向 beam 本来会撞上它;
+#       2. 上向 beam 在顶边转弯后的行带, 保证上向 beam 能继续撞到右边障碍.
+#     - 下边障碍明确避开右侧纵向轨迹所在列带, 避免上向 beam 的第二段继续撞到底边障碍, 从而把模板复杂度控制在稳定范围.
+#   visual_observability:
+#     - 顺序不是通过颜色 id、排序编号之类不可见属性编码, 而是直接体现在输出中的几何截停:
+#       同样的右侧障碍摆在那里, 但右向 beam 在本变体里就是更短.
+#     - 2~3 个样例足以让人看到“先画出的 teal 会挡住后画的 teal”.
+#   cleanliness:
+#     - 交互只发生在几条清晰的宽带状轨迹之间, 不在同一区域堆叠多层不同标记.
+#     - generator 会拒绝彩色障碍与旧 teal 同时出现在同一步 footprint 的样例, 避免歧义.
+#   color_inference:
+#     - 颜色的职责没有新增: 彩色障碍只表示转向方向, teal 只表示源方块与轨迹.
+#     - 图例仍使用 4 个独立颜色, 至少包含左右两种条位中的一种可变因素, 不依赖隐藏数值关系.
+
+_DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+_N, _E, _S, _W = range(4)
+
+
+def _parse_legend(grid: np.ndarray, legend_h: int) -> dict[int, str]:
+    legend = grid[:legend_h, :]
+    assert legend.size, "legend must be non-empty"
+    vals, cnts = np.unique(legend, return_counts=True)
+    bg = int(vals[cnts.argmax()])
+
+    sep_cols = [c for c in range(legend.shape[1]) if np.all(legend[:, c] == bg)]
+    assert len(sep_cols) >= 2, "legend separator columns must exist"
+
+    turn: dict[int, str] = {}
+    for a, b in zip(sep_cols, sep_cols[1:], strict=False):
+        if b - a <= 2:
+            continue
+        interior = legend[1 : legend_h - 1, a + 1 : b]
+        colors = set(map(int, np.unique(interior)))
+        colors.discard(bg)
+        colors.discard(0)
+        assert len(colors) == 1, "each legend cell must encode exactly one color"
+        col = int(next(iter(colors)))
+        xs = np.where(interior == col)[1]
+        turn[col] = "L" if int(xs[0]) <= (interior.shape[1] - 1) // 2 else "R"
+    assert len(turn) == 4, "legend must encode four turn colors"
+    return turn
+
+
+def _find_teal_square(g: np.ndarray, teal: int = 8) -> tuple[int, int, int]:
+    candidates: list[tuple[int, int, int]] = []
+    for cells in components_mask(g == teal, connectivity=4):
+        r0, c0, r1, c1 = bbox_coords(cells)
+        hh = r1 - r0 + 1
+        ww = c1 - c0 + 1
+        if hh != ww:
+            continue
+        if int(np.sum(g[r0 : r1 + 1, c0 : c1 + 1] == teal)) != hh * ww:
+            continue
+        candidates.append((int(r0), int(c0), int(hh)))
+    assert len(candidates) == 1, "main grid must contain exactly one solid teal square"
+    return candidates[0]
+
+
+def _rot_ccw(d: int) -> int:
+    return (d - 1) % 4
+
+
+def _rot_cw(d: int) -> int:
+    return (d + 1) % 4
+
+
+def _rot(d: int, turn: str) -> int:
+    return _rot_ccw(d) if turn == "L" else _rot_cw(d)
+
+
+def _trace_beams(
+    base: np.ndarray,
+    turns: dict[int, str],
+    bg: int,
+    *,
+    sequential: bool,
+) -> tuple[np.ndarray, list[dict[str, object]]]:
+    teal = 8
+    sr, sc, sz = _find_teal_square(base, teal=teal)
+    out = base.copy()
+    h, w = out.shape
+    prior_trail = np.zeros((h, w), dtype=bool)
+    beam_infos: list[dict[str, object]] = []
+
+    def in_bounds(r: int, c: int) -> bool:
+        return 0 <= r and 0 <= c and r + sz - 1 < h and c + sz - 1 < w
+
+    def paint_block(r: int, c: int, trail_mask: np.ndarray) -> None:
+        blk = out[r : r + sz, c : c + sz]
+        newly = blk == bg
+        blk[newly] = teal
+        out[r : r + sz, c : c + sz] = blk
+        trail_mask[r : r + sz, c : c + sz] |= newly
+
+    def obstacle_color_at_next(nr: int, nc: int) -> int | None:
+        blk = base[nr : nr + sz, nc : nc + sz]
+        cols = set(map(int, np.unique(blk)))
+        cols.discard(bg)
+        cols.discard(teal)
+        if not cols:
+            return None
+        assert len(cols) == 1, "beam footprint must not hit mixed obstacle colors"
+        return int(next(iter(cols)))
+
+    for d0 in range(4):
+        r, c, d = sr, sc, d0
+        seen: set[tuple[int, int, int]] = set()
+        beam_trail = np.zeros((h, w), dtype=bool)
+        hit_colors: list[int] = []
+        blocked_by_prior = 0
+        steps = 0
+        while True:
+            state = (r, c, d)
+            assert state not in seen, "beam path must not cycle"
+            seen.add(state)
+
+            dr, dc = _DIRS[d]
+            nr, nc = r + dr, c + dc
+            if not in_bounds(nr, nc):
+                break
+
+            if sequential and prior_trail[nr : nr + sz, nc : nc + sz].any():
+                blocked_by_prior += 1
+                break
+
+            oc = obstacle_color_at_next(nr, nc)
+            if oc is None:
+                r, c = nr, nc
+                paint_block(r, c, beam_trail)
+                steps += 1
+                continue
+
+            assert oc in turns, "obstacle color must be encoded by legend"
+            hit_colors.append(oc)
+            d = _rot(d, turns[oc])
+
+        if sequential:
+            prior_trail |= beam_trail
+        beam_infos.append(
+            {
+                "dir": d0,
+                "hit_colors": hit_colors,
+                "blocked_by_prior": blocked_by_prior,
+                "steps": steps,
+                "trail_cells": int(beam_trail.sum()),
+            }
+        )
+
+    return out, beam_infos
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Paint teal rays from a square, but resolve them in a fixed firing order.
+
+    Input structure:
+    - The top band is a grey legend whose four colored bars encode left-vs-right turns.
+    - Beneath it is the main field with one solid teal square, a dominant background color, and solid edge-touching obstacle blocks.
+
+    Rule:
+    - Remove the legend from the output.
+    - Fire the square-shaped beams in the order up, then right, then down, then left.
+    - A beam slides one cell at a time, painting teal only onto background cells.
+    - When a beam meets a colored obstacle, it turns according to that color's legend bar.
+    - When a later beam would step onto teal painted by an earlier beam, it stops there; finished trails persist as blockers for the remaining directions.
+
+    Key insight:
+    - The four directions can no longer be traced independently. Earlier teal trails become permanent geometry, so solving requires simulating the directions in sequence.
+    """
+    g = np.asarray(grid, dtype=int)
+
+    legend_bg = 5
+    rows_with_legend = np.where(np.any(g == legend_bg, axis=1))[0]
+    assert rows_with_legend.size, "legend rows must be present"
+    legend_h = int(rows_with_legend.max() + 1)
+    assert np.array_equal(rows_with_legend, np.arange(legend_h)), "legend color must be confined to the top band"
+
+    legend_turn = _parse_legend(g, legend_h)
+
+    base = g[legend_h:, :].copy()
+    assert base.size, "main grid must remain after legend crop"
+
+    vals, cnts = np.unique(base, return_counts=True)
+    bg = int(vals[cnts.argmax()])
+    out, _beam_infos = _trace_beams(base, legend_turn, bg, sequential=True)
+    return out
+
+
+# --------------- generator ---------------
+
+LEGEND_COLOR_POOL = [1, 2, 3, 4, 6]
+BG_COLOR_POOL = [1, 2, 3, 4, 6, 7, 9]
+LEGEND_BG = 5
+TEAL = 8
+
+GRID_H_RANGE = (19, 24)
+GRID_W = 24
+LEGEND_H = 6
+LEGEND_CELL_STARTS = [1, 7, 13, 19]
+
+TEAL_SZ2_PROB = 0.75
+SQUARE_EDGE_GAP = 5
+
+OBS_THICKNESS_RANGE = (2, 4)
+OBS_BOTH_GAP = 2
+
+SPAN_MIN_MULT = 3
+SPAN_MAX_MULT = 14
+SPAN_COMPACT_PROB = 0.4
+
+MAX_RETRIES = 400
+
+
+def _choose_span(
+    axis_len: int,
+    allowed_lo: int,
+    allowed_hi: int,
+    required: list[tuple[int, int]],
+    excluded: list[tuple[int, int]],
+    min_len: int,
+    max_len: int,
+) -> tuple[int, int] | None:
+    req0 = min(a for a, _ in required)
+    req1 = max(b for _, b in required)
+    lo = max(min_len, req1 - req0 + 1)
+    hi = min(max_len, allowed_hi - allowed_lo + 1)
+    if lo > hi:
+        return None
+
+    choices: list[tuple[int, int, int]] = []
+    for length in range(lo, hi + 1):
+        start0 = max(allowed_lo, req1 - length + 1)
+        start1 = min(req0, allowed_hi - length + 1)
+        for start in range(start0, start1 + 1):
+            end = start + length - 1
+            if all(end < a or start > b for a, b in excluded):
+                choices.append((length, start, end))
+    if not choices:
+        return None
+
+    lengths = sorted({length for length, _, _ in choices})
+    if random.random() < SPAN_COMPACT_PROB:
+        cutoff = lengths[min(len(lengths) - 1, max(0, len(lengths) // 2))]
+        pool = [(start, end) for length, start, end in choices if length <= cutoff]
+    else:
+        pool = [(start, end) for _, start, end in choices]
+    return random.choice(pool)
+
+
+def _make_legend(legend_colors: list[int], turns: dict[int, str]) -> np.ndarray:
+    legend = np.full((LEGEND_H, GRID_W), LEGEND_BG, dtype=int)
+    for start, color in zip(LEGEND_CELL_STARTS, legend_colors):
+        legend[1:5, start : start + 4] = 0
+        bar_col = start if turns[color] == "L" else start + 3
+        legend[1:5, bar_col] = color
+    return legend
+
+
+def _rand_thickness(lo: int, hi: int) -> int | None:
+    return random.randint(lo, hi) if hi >= lo else None
+
+
+def _thickness_pair(axis: int, sz: int) -> tuple[int, int] | None:
+    lo, hi_cap = OBS_THICKNESS_RANGE
+    room = axis - sz - OBS_BOTH_GAP
+    if room < 2 * lo:
+        return None
+    a = random.randint(lo, min(hi_cap, room - lo))
+    b = _rand_thickness(lo, min(hi_cap, room - a))
+    return (a, b) if b is not None else None
+
+
+def _obstacle_rect(
+    side: int,
+    thickness: int,
+    span: tuple[int, int],
+    h: int,
+    w: int,
+) -> tuple[int, int, int, int]:
+    s0, s1 = span
+    if side == _N:
+        return 0, thickness - 1, s0, s1
+    if side == _S:
+        return h - thickness, h - 1, s0, s1
+    if side == _W:
+        return s0, s1, 0, thickness - 1
+    return s0, s1, w - thickness, w - 1
+
+
+def _gen_attempt() -> np.ndarray | None:
+    h, w = random.randint(*GRID_H_RANGE), GRID_W
+    sz = 2 if random.random() < TEAL_SZ2_PROB else 3
+
+    ns = _thickness_pair(h, sz)
+    ew = _thickness_pair(w, sz)
+    if ns is None or ew is None:
+        return None
+    thickness = {_N: ns[0], _S: ns[1], _W: ew[0], _E: ew[1]}
+
+    min_r = max(SQUARE_EDGE_GAP, thickness[_N] + 2)
+    max_r = min(h - sz - SQUARE_EDGE_GAP, h - thickness[_S] - sz - 2)
+    min_c = max(SQUARE_EDGE_GAP, thickness[_W] + 2)
+    max_c = min(w - sz - SQUARE_EDGE_GAP, w - thickness[_E] - sz - 2)
+    if min_r > max_r or min_c > max_c:
+        return None
+    sr = random.randint(min_r, max_r)
+    sc = random.randint(min_c, max_c)
+
+    lane_n = thickness[_N]
+    lane_s = h - thickness[_S] - sz
+    lane_w = thickness[_W]
+    lane_e = w - thickness[_E] - sz
+
+    if not (sr >= lane_n + 2 and sr <= lane_s - 1):
+        return None
+    if not (sc >= lane_w + 2 and sc <= lane_e - 2):
+        return None
+
+    side_turn = {_N: "R", _E: "R", _S: "L", _W: random.choice(["L", "R"])}
+
+    col_lo = thickness[_W]
+    col_hi = w - thickness[_E] - 1
+    row_lo = thickness[_N]
+    row_hi = h - thickness[_S] - 1
