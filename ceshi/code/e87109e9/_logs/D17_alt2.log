+++ b/ceshi/code/e87109e9/D17/2/code.py
@@ -0,0 +1,408 @@
+# Variant of e87109e9
+# Dimension: D17 — 障碍物功能分化 (obstacle)
+# Change: 所有障碍物功能相同——都触发转弯，只是转弯方向不同（由图例决定）... → 传送门障碍物
+
+import random
+
+import numpy as np
+
+from arc_utils import bbox_coords, components_mask
+
+_DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+_N, _E, _S, _W = range(4)
+
+
+# Design analysis for the D17 portal variant
+# ------------------------------------------
+# concretization:
+# - The teal source square and the cropped-away legend remain from the original task.
+# - The four obstacle rectangles are still edge-touching bars, but they now appear as
+#   two same-color pairs rather than 3-4 distinct turn blocks.
+# - One color is used by the top/bottom pair, one color by the left/right pair.
+# - When a sz x sz beam would enter one portal rectangle, it does not turn. Instead it
+#   reappears just beyond the mate rectangle on the far side, keeps its direction, and
+#   then continues painting from there.
+# - Example: a northbound beam that reaches the top portal of color A reappears above
+#   the bottom portal of color A and keeps moving north. Because the paired spans are
+#   laterally shifted, the post-teleport lane misses the original top portal, so the
+#   path does not degenerate into an immediate loop.
+#
+# complexity calibration:
+# - Using exactly two portal colors keeps the pairing rule visible while avoiding the
+#   clutter of 6-8 repeated rectangles.
+# - Each sample always contains four actual teleports, one from each cardinal beam, so
+#   the D17 behavior is always observable rather than being a rare branch.
+# - The legend now repeats the two active colors twice. That duplication is a visible
+#   cue that colors should be paired instead of interpreted independently.
+#
+# hidden assumptions review against the original main():
+# - `_parse_legend(...)` originally assumed four distinct colors because each color
+#   mapped to one turn. That is invalid now: duplicate legend colors are required.
+# - `legend_turn[color]` and `_rot_*` encoded the old obstacle effect. They must be
+#   removed because same-color rectangles would otherwise collapse into one turn rule.
+# - `obstacle_color_at_next(...)` was harmless before because all obstacle hits were
+#   local. With portals, the solver must identify not just the color but also which of
+#   the two same-color rectangles was hit and where its partner is.
+# - The old cycle check still matters, but now generator geometry must guarantee that
+#   post-teleport lanes miss the entry portal and the central square; otherwise a portal
+#   pair could create an infinite shuttle.
+#
+# placement legality:
+# - The generator keeps portals on the four outer borders to preserve the original look.
+# - Source placement is constrained so the top/bottom pair and left/right pair do not
+#   overlap each other at the corners.
+# - Portal spans are chosen by a fixed offset pattern: each pair overlaps the source
+#   lane exactly on the source square, which guarantees the initial hit, and shifts the
+#   exit lane by 2*sz cells, which guarantees a visible jump.
+# - The generator validates all rectangles, simulates the full output, and then checks
+#   `main(input)` against that oracle before accepting a sample.
+#
+# visual observability / neatness / color inference:
+# - The output shows disconnected teal trails that resume on a different lane after a
+#   same-color hit, which is visually unlike the original 90-degree turns.
+# - Only two obstacle colors are active, each repeated in a symmetric pair, so the
+#   matching relation is easy to see across 2-4 examples.
+# - No rule depends on color id ordering or on hidden metadata; only repeated visible
+#   colors and geometry matter.
+
+
+# Color palettes
+LEGEND_COLOR_POOL = [1, 2, 3, 4, 6]
+BG_COLOR_POOL = [1, 2, 3, 4, 6, 7, 9]
+LEGEND_BG = 5
+TEAL = 8
+
+# Canvas dimensions
+GRID_H_RANGE = (19, 24)
+GRID_W = 24
+LEGEND_H = 6
+LEGEND_CELL_STARTS = [1, 7, 13, 19]
+
+# Teal square
+TEAL_SZ2_PROB = 0.75
+
+# Portal geometry
+PORTAL_THICKNESS_RANGE = (2, 3)
+MAX_RETRIES = 400
+
+
+def _parse_legend_colors(grid: np.ndarray, legend_h: int) -> list[int]:
+    """Read the 4 legend cells; colors may repeat because portals come in pairs."""
+    legend = grid[:legend_h, :]
+    assert legend.size, "legend must be non-empty"
+    vals, counts = np.unique(legend, return_counts=True)
+    bg = int(vals[counts.argmax()])
+
+    sep_cols = [c for c in range(legend.shape[1]) if np.all(legend[:, c] == bg)]
+    assert len(sep_cols) >= 2, "legend separator columns must exist"
+
+    colors: list[int] = []
+    for a, b in zip(sep_cols, sep_cols[1:], strict=False):
+        if b - a <= 2:
+            continue
+        interior = legend[1 : legend_h - 1, a + 1 : b]
+        cell_colors = set(map(int, np.unique(interior)))
+        cell_colors.discard(bg)
+        cell_colors.discard(0)
+        assert len(cell_colors) == 1, "each legend cell must contain exactly one color"
+        colors.append(int(next(iter(cell_colors))))
+    assert len(colors) == 4, "legend must contain four cells"
+    return colors
+
+
+def _find_teal_square(g: np.ndarray, teal: int = TEAL) -> tuple[int, int, int]:
+    """Return (r0,c0,size) for the unique solid teal square."""
+    candidates: list[tuple[int, int, int]] = []
+    for cells in components_mask(g == teal, connectivity=4):
+        r0, c0, r1, c1 = bbox_coords(cells)
+        hh = r1 - r0 + 1
+        ww = c1 - c0 + 1
+        if hh != ww:
+            continue
+        size = hh
+        if int(np.sum(g[r0 : r1 + 1, c0 : c1 + 1] == teal)) != size * size:
+            continue
+        candidates.append((int(r0), int(c0), int(size)))
+    assert len(candidates) == 1, "main grid must contain exactly one solid teal square"
+    return candidates[0]
+
+
+def _rect_area(rect: tuple[int, int, int, int]) -> int:
+    r0, c0, r1, c1 = rect
+    return (r1 - r0 + 1) * (c1 - c0 + 1)
+
+
+def _rectangles_overlap(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:
+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
+    return not (ar1 < br0 or br1 < ar0 or ac1 < bc0 or bc1 < ac0)
+
+
+def _footprint_overlaps(rect: tuple[int, int, int, int], r: int, c: int, sz: int) -> bool:
+    rr0, cc0, rr1, cc1 = rect
+    return not (rr1 < r or rr0 > r + sz - 1 or cc1 < c or cc0 > c + sz - 1)
+
+
+def _extract_portals(
+    base: np.ndarray, legend_colors: list[int], bg: int, teal: int = TEAL
+) -> dict[int, tuple[tuple[int, int, int, int], tuple[int, int, int, int]]]:
+    """Collect same-color portal rectangles from the main grid."""
+    active_colors = set(map(int, np.unique(base)))
+    active_colors.discard(bg)
+    active_colors.discard(teal)
+    assert active_colors, "main grid must contain portal rectangles"
+    assert active_colors <= set(legend_colors), "all portal colors must be shown in the legend"
+
+    portals: dict[int, tuple[tuple[int, int, int, int], tuple[int, int, int, int]]] = {}
+    for color in active_colors:
+        rects: list[tuple[int, int, int, int]] = []
+        for cells in components_mask(base == color, connectivity=4):
+            rect = bbox_coords(cells)
+            assert len(cells) == _rect_area(rect), "portal components must be solid rectangles"
+            rects.append(rect)
+        assert len(rects) == 2, "each active portal color must appear in exactly two rectangles"
+        portals[int(color)] = (rects[0], rects[1])
+    return portals
+
+
+def _locate_portal_hit(
+    portals: dict[int, tuple[tuple[int, int, int, int], tuple[int, int, int, int]]],
+    r: int,
+    c: int,
+    sz: int,
+) -> tuple[int, tuple[int, int, int, int], tuple[int, int, int, int]] | None:
+    matches: list[tuple[int, tuple[int, int, int, int], tuple[int, int, int, int]]] = []
+    for color, pair in portals.items():
+        a, b = pair
+        if _footprint_overlaps(a, r, c, sz):
+            matches.append((color, a, b))
+        if _footprint_overlaps(b, r, c, sz):
+            matches.append((color, b, a))
+    if not matches:
+        return None
+    assert len(matches) == 1, "beam footprint must not touch multiple portal rectangles at once"
+    return matches[0]
+
+
+def _portal_exit(
+    entry: tuple[int, int, int, int],
+    exit_rect: tuple[int, int, int, int],
+    nr: int,
+    nc: int,
+    sz: int,
+    d: int,
+) -> tuple[int, int]:
+    er0, ec0, er1, ec1 = entry
+    xr0, xc0, xr1, xc1 = exit_rect
+
+    if d in (_N, _S):
+        entry_len = ec1 - ec0 + 1
+        exit_len = xc1 - xc0 + 1
+        assert entry_len == exit_len and entry_len >= sz, "paired portals must align horizontally"
+        offset = nc - ec0
+        assert 0 <= offset <= entry_len - sz
+        new_c = xc0 + offset
+        new_r = xr0 - sz if d == _N else xr1 + 1
+        return int(new_r), int(new_c)
+
+    entry_len = er1 - er0 + 1
+    exit_len = xr1 - xr0 + 1
+    assert entry_len == exit_len and entry_len >= sz, "paired portals must align vertically"
+    offset = nr - er0
+    assert 0 <= offset <= entry_len - sz
+    new_r = xr0 + offset
+    new_c = xc0 - sz if d == _W else xc1 + 1
+    return int(new_r), int(new_c)
+
+
+def _trace_beams(
+    base: np.ndarray,
+    portals: dict[int, tuple[tuple[int, int, int, int], tuple[int, int, int, int]]],
+    bg: int,
+    teal: int = TEAL,
+) -> tuple[np.ndarray, list[list[tuple[int, int, int, int]]]]:
+    """Simulate the four portal beams and return the painted grid plus per-beam portal hits."""
+    out = base.copy()
+    sr, sc, sz = _find_teal_square(base, teal=teal)
+    h, w = out.shape
+
+    def in_bounds(r: int, c: int) -> bool:
+        return 0 <= r and 0 <= c and r + sz - 1 < h and c + sz - 1 < w
+
+    def paint_block(r: int, c: int) -> None:
+        blk = out[r : r + sz, c : c + sz]
+        blk[blk == bg] = teal
+        out[r : r + sz, c : c + sz] = blk
+
+    all_hits: list[list[tuple[int, int, int, int]]] = []
+    for d0 in range(4):
+        r, c, d = sr, sc, d0
+        hits: list[tuple[int, int, int, int]] = []
+        seen: set[tuple[int, int, int]] = set()
+        while True:
+            state = (r, c, d)
+            assert state not in seen, "beam path must not cycle"
+            seen.add(state)
+
+            dr, dc = _DIRS[d]
+            nr, nc = r + dr, c + dc
+            if not in_bounds(nr, nc):
+                break
+
+            hit = _locate_portal_hit(portals, nr, nc, sz)
+            if hit is None:
+                r, c = nr, nc
+                paint_block(r, c)
+                continue
+
+            color, entry, mate = hit
+            hits.append((d, color, nr, nc))
+            r, c = _portal_exit(entry, mate, nr, nc, sz, d)
+            assert in_bounds(r, c), "portal exit must stay inside the grid"
+            assert _locate_portal_hit(portals, r, c, sz) is None, "portal exit cell must be clear"
+            paint_block(r, c)
+        all_hits.append(hits)
+
+    return out, all_hits
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Emit four teal beams from a square, teleporting across same-color portal pairs.
+
+    Input structure:
+    - Top band: a grey legend with 4 cells; colors may repeat because repeated colors indicate portal pairing.
+    - Below: a main grid with one solid teal square, a uniform background, and colored rectangular portal blocks.
+
+    Rule:
+    - Remove the legend from the output.
+    - Launch a sz x sz teal beam from the square in each cardinal direction, painting only background cells it occupies.
+    - When the next beam step would enter a portal of color C, find the other portal of the same color. The beam reappears just beyond that mate portal on the far side, keeps the same direction, and continues.
+    - Beams stop when their next step would leave the grid.
+
+    Key insight: equal-colored obstacle rectangles are not independent blockers anymore; they form paired portals, so the correct path is obtained by matching the duplicate colors and transporting the beam to the mate location before continuing straight.
+    """
+    g = np.asarray(grid, dtype=int)
+
+    legend_bg = LEGEND_BG
+    rows_with_legend = np.where(np.any(g == legend_bg, axis=1))[0]
+    assert rows_with_legend.size, "legend rows must be present"
+    legend_h = int(rows_with_legend.max() + 1)
+    assert np.array_equal(rows_with_legend, np.arange(legend_h)), "legend color must be confined to the top band"
+
+    legend_colors = _parse_legend_colors(g, legend_h)
+    base = g[legend_h:, :].copy()
+    assert base.size, "main grid must remain after legend crop"
+
+    vals, counts = np.unique(base, return_counts=True)
+    bg = int(vals[counts.argmax()])
+    portals = _extract_portals(base, legend_colors, bg, teal=TEAL)
+    out, _ = _trace_beams(base, portals, bg, teal=TEAL)
+    return out
+
+
+def _make_legend(legend_colors: list[int]) -> np.ndarray:
+    """Build the legend with duplicated colors to advertise portal pairing."""
+    legend = np.full((LEGEND_H, GRID_W), LEGEND_BG, dtype=int)
+    for start, color in zip(LEGEND_CELL_STARTS, legend_colors):
+        legend[1:5, start : start + 4] = 0
+        legend[1:5, start + 1 : start + 3] = color
+    return legend
+
+
+def _portal_rectangles(
+    h: int,
+    w: int,
+    sr: int,
+    sc: int,
+    sz: int,
+    th: int,
+    tv: int,
+) -> dict[int, tuple[int, int, int, int]]:
+    """Construct the fixed two-pair portal geometry around the source square."""
+    return {
+        _N: (0, sc - 2 * sz, th - 1, sc + sz - 1),
+        _S: (h - th, sc, h - 1, sc + 3 * sz - 1),
+        _W: (sr - 2 * sz, 0, sr + sz - 1, tv - 1),
+        _E: (sr, w - tv, sr + 3 * sz - 1, w - 1),
+    }
+
+
+def _valid_source_bounds(h: int, w: int, sz: int, th: int, tv: int) -> tuple[int, int, int, int]:
+    min_r = 2 * sz + th
+    max_r = h - th - 3 * sz
+    min_c = 2 * sz + tv
+    max_c = w - tv - 3 * sz
+    return min_r, max_r, min_c, max_c
+
+
+def _gen_attempt() -> np.ndarray | None:
+    sz = 2 if random.random() < TEAL_SZ2_PROB else 3
+    h = random.randint(max(GRID_H_RANGE[0], 20 if sz == 3 else GRID_H_RANGE[0]), GRID_H_RANGE[1])
+    w = GRID_W
+    th = random.randint(*PORTAL_THICKNESS_RANGE)
+    tv = random.randint(*PORTAL_THICKNESS_RANGE)
+
+    min_r, max_r, min_c, max_c = _valid_source_bounds(h, w, sz, th, tv)
+    if min_r > max_r or min_c > max_c:
+        return None
+    sr = random.randint(min_r, max_r)
+    sc = random.randint(min_c, max_c)
+
+    side_rect = _portal_rectangles(h, w, sr, sc, sz, th, tv)
+    rects = list(side_rect.values())
+    for i, rect in enumerate(rects):
+        r0, c0, r1, c1 = rect
+        if r0 < 0 or c0 < 0 or r1 >= h or c1 >= w:
+            return None
+        for other in rects[i + 1 :]:
+            if _rectangles_overlap(rect, other):
+                return None
+
+    active_colors = random.sample(LEGEND_COLOR_POOL, 2)
+    color_h, color_v = active_colors
+    legend_colors = [color_h, color_h, color_v, color_v]
+    random.shuffle(legend_colors)
+    bg_choices = [c for c in BG_COLOR_POOL if c not in active_colors]
+    bg = random.choice(bg_choices)
+
+    base = np.full((h, w), bg, dtype=int)
+    base[sr : sr + sz, sc : sc + sz] = TEAL
+    for side, rect in side_rect.items():
+        r0, c0, r1, c1 = rect
+        color = color_h if side in (_N, _S) else color_v
+        base[r0 : r1 + 1, c0 : c1 + 1] = color
+
+    vals, counts = np.unique(base, return_counts=True)
+    if int(vals[counts.argmax()]) != bg:
+        return None
+
+    try:
+        portals = _extract_portals(base, legend_colors, bg, teal=TEAL)
+        expected, hits = _trace_beams(base, portals, bg, teal=TEAL)
+    except AssertionError:
+        return None
+
+    hit_counts = [len(beam) for beam in hits]
+    if hit_counts != [1, 1, 1, 1]:
+        return None
+    if {color for beam in hits for _, color, _, _ in beam} != set(active_colors):
+        return None
+
+    legend = _make_legend(legend_colors)
+    inp = np.vstack([legend, base])
+    try:
+        actual = main(inp)
+    except AssertionError:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate e87109e9 D17 portal input")

