+    for d0 in range(4):
+        r, c, d = sr, sc, d0
+        hits: list[tuple[int, int, int, int]] = []
+        seen: set[tuple[int, int, int]] = set()
+        while True:
+            state = (r, c, d)
+            assert state not in seen, "beam path must not cycle"
+            seen.add(state)
