import importlib.util, numpy as np

new_path = '/home/lixinyu/snap/new/ceshi/code/e87109e9/D17/2/code.py'
old_path = '/home/lixinyu/snap/new/arc2_solver_select/e87109e9.py'

def load(path, name):
    spec = importlib.util.spec_from_file_location(name, path)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod

new = load(new_path, 'new_variant')
old = load(old_path, 'old_task')

teleports = []
sizes = {2: 0, 3: 0}
old_same = 0
old_fail = 0
for _ in range(100):
    inp = new.generate_input()
    legend_h = new.LEGEND_H
    base = inp[legend_h:]
    vals, counts = np.unique(base, return_counts=True)
    bg = int(vals[counts.argmax()])
    portals = new._extract_portals(base, new._parse_legend_colors(inp, legend_h), bg, teal=new.TEAL)
    _, hits = new._trace_beams(base, portals, bg, teal=new.TEAL)
    teleports.append(sum(len(b) for b in hits))
    sizes[new._find_teal_square(base)[2]] += 1
    new_out = new.main(inp)
    try:
        old_out = old.main(inp)
    except Exception:
        old_fail += 1
    else:
        old_same += int(np.array_equal(old_out, new_out))

print('teleport_totals_unique', sorted(set(teleports)))
print('teleport_total_mean', sum(teleports) / len(teleports))
print('size_counts', sizes)
print('old_solver_failures', old_fail)
print('old_solver_same_outputs', old_same)
