+        lo = sr + DIRECT_MIN_STEPS
+        hi = h - sz - thickness[_S] - OUTER_MARGIN
+        if lo > hi:
+            return None
+        lanes[_S] = random.randint(lo, hi)
+    if _W in present:
+        lo = thickness[_W] + OUTER_MARGIN
+        hi = sc - DIRECT_MIN_STEPS
+        if lo > hi:
+            return None
+        lanes[_W] = random.randint(lo, hi)
+    if _E in present:
+        lo = sc + DIRECT_MIN_STEPS
+        hi = w - sz - thickness[_E] - OUTER_MARGIN
+        if lo > hi:
+            return None
+        lanes[_E] = random.randint(lo, hi)
