@@ -0,0 +1,654 @@
+# Variant of e87109e9
+# Dimension: D11 — 障碍物对射线的阻挡行为 (path)
+# Change: 射线碰到障碍物边缘时立即转弯，障碍物完全阻挡射线不让穿过... → 障碍物颜色决定阻挡vs通过
+
+import random
+
+import numpy as np
+
+from arc_utils import bbox_coords, components_mask
+
+
+# Design analysis for the D11 variant
+# -----------------------------------
+# a) Concretization and behavior trace
+#    - The original task has a 6x24 legend on top and the actual puzzle below.
+#    - The teal square still emits four sz x sz beams in the four cardinal directions.
+#    - The main change is that legend colors now encode three obstacle behaviors:
+#      left bar   -> 'L' = turn counterclockwise
+#      right bar  -> 'R' = turn clockwise
+#      center bar -> 'P' = pass straight through
+#    - To make 'P' visible, obstacles can no longer all sit on the outer border:
+#      if a solid border obstacle were passable, the beam would disappear inside it
+#      and exit immediately off-grid, producing no visible difference. Therefore the
+#      generator moves the obstacle rectangles to internal "north/east/south/west"
+#      lanes around the square while keeping the rest of the puzzle format intact.
+#    - Concrete trace:
+#      old logic: beam at (r,c) looks at the next footprint, sees color X, and must
+#      rotate left/right without entering X.
+#      new logic: beam at (r,c) looks at the next footprint, sees color X, consults
+#      the legend:
+#        * X -> 'L'/'R': rotate in place, do not enter X
+#        * X -> 'P': move into X, keep heading, and continue until the obstacle is
+#          behind the beam; only background cells are repainted teal.
+#      This difference is visible because pass-through obstacles have free space on
+#      both sides, so the teal trail reappears after the rectangle.
+# b) Complexity calibration
+#    - The legend still has exactly four color cells. This keeps the color-language
+#      small enough for ARC inference while adding one new central position.
+#    - Each sample uses 3-4 obstacle colors, with at least one pass-through color
+#      and at least one turn color. This avoids degenerate "all pass" or "all turn"
+#      samples.
+#    - Obstacles remain large axis-aligned rectangles so the visual vocabulary stays
+#      close to the source task.
+# c) Hidden-assumption audit of the original main()
+#    - _parse_legend originally assumed each cell meant only left/right. That fails
+#      under D11, so parsing must recognize a centered bar as a third state.
+#    - obstacle_color_at_next() is still valid only if a footprint never contains
+#      multiple obstacle colors. The generator now validates this by simulating the
+#      same rules and rejecting mixed-color collisions.
+#    - The original hit branch assumed "obstacle seen => rotate, no movement". Under
+#      D11 that is false, so the solver must distinguish turn vs pass before deciding
+#      whether to move.
+#    - Painting background-only cells remains safe: passing through an obstacle does
+#      not erase the obstacle, which is exactly what makes the straight continuation
+#      observable beyond it.
+# d) Placement legality
+#    - The generator chooses one internal lane per present side (N/E/S/W), then
+#      places an obstacle rectangle so the beam first touches it from that lane.
+#    - Required/excluded span constraints are used so that intended second hits are
+#      reachable while unwanted extra collisions are avoided.
+#    - Rectangles may not overlap each other or the teal square, and the solver
+#      oracle is run on every generated input before accepting it.
+# e) Visual observability
+#    - Centered legend bars are a visible third category distinct from left/right.
+#    - A pass-through obstacle is hit by a beam that later continues in the same
+#      direction on the far side; this is directly visible in the output.
+#    - Turning obstacles still create the original 90-degree bend cue, so a human
+#      can compare the two behaviors across a few examples.
+# f) Visual cleanliness
+#    - Obstacles are kept as single-color rectangles, and only 3-4 are used.
+#    - The square has generous margins and obstacle spans are constrained to avoid
+#      crowded multi-color tangles near the same beam footprint.
+# g) Color-change inferability
+#    - No rule depends on numeric color ordering. Colors only act as legend-linked
+#      categories, and the same legend structure visibly explains the category-to-
+#      behavior mapping in every sample.
+# h) New solver assumptions checked against the generator
+#    - main() assumes exactly one solid teal square component: guaranteed.
+#    - main() assumes each legend cell contains exactly one nonzero color: guaranteed.
+#    - main() assumes a pass-through obstacle can be traversed without ever entering
+#      a mixed-color footprint: enforced by rectangle non-overlap plus simulation.
+#    - main() assumes beam paths do not cycle: the generator rejects any simulated
+#      cycle before emitting a sample.
+
+_DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+_N, _E, _S, _W = range(4)
+
+
+def _parse_legend(grid: np.ndarray, legend_h: int) -> dict[int, str]:
+    """
+    Legend is a top band with 4 cells separated by solid background gutters.
+    In each 4-column cell, the colored bar position encodes obstacle behavior:
+      - left edge    -> 'L' (turn counterclockwise)
+      - right edge   -> 'R' (turn clockwise)
+      - two centered -> 'P' (pass straight through)
+    """
+    legend = grid[:legend_h, :]
+    assert legend.size, "legend must be non-empty"
+    vals, cnts = np.unique(legend, return_counts=True)
+    bg = int(vals[cnts.argmax()])
+
+    sep_cols = [c for c in range(legend.shape[1]) if np.all(legend[:, c] == bg)]
+    assert len(sep_cols) >= 2, "legend separator columns must exist"
+
+    behavior: dict[int, str] = {}
+    for a, b in zip(sep_cols, sep_cols[1:], strict=False):
+        if b - a <= 2:
+            continue
+        interior = legend[1 : legend_h - 1, a + 1 : b]
+        colors = set(map(int, np.unique(interior)))
+        colors.discard(bg)
+        colors.discard(0)
+        assert len(colors) == 1, "each legend cell must encode exactly one color"
+        col = int(next(iter(colors)))
+        ys, xs = np.where(interior == col)
+        assert ys.size, "legend bar must be present"
+        x0, x1 = int(xs.min()), int(xs.max())
+        if x0 == 0 and x1 == 0:
+            behavior[col] = "L"
+        elif x0 == interior.shape[1] - 1 and x1 == interior.shape[1] - 1:
+            behavior[col] = "R"
+        else:
+            mid_l = (interior.shape[1] // 2) - 1
+            mid_r = interior.shape[1] // 2
+            assert x0 == mid_l and x1 == mid_r, "center legend bar must be centered"
+            behavior[col] = "P"
+    assert len(behavior) == 4, "legend must encode four colors"
+    return behavior
+
+
+def _find_teal_square(g: np.ndarray, teal: int = 8) -> tuple[int, int, int]:
+    """Return (r0,c0,size) for the unique solid teal square component."""
+    candidates: list[tuple[int, int, int]] = []
+    for cells in components_mask(g == teal, connectivity=4):
+        r0, c0, r1, c1 = bbox_coords(cells)
+        hh = r1 - r0 + 1
+        ww = c1 - c0 + 1
+        if hh != ww:
+            continue
+        size = hh
+        if int(np.sum(g[r0 : r1 + 1, c0 : c1 + 1] == teal)) != size * size:
+            continue
+        candidates.append((int(r0), int(c0), int(size)))
+    assert len(candidates) == 1, "main grid must contain exactly one solid teal square"
+    return candidates[0]
+
+
+def _rot_ccw(d: int) -> int:
+    return (d - 1) % 4
+
+
+def _rot_cw(d: int) -> int:
+    return (d + 1) % 4
+
+
+def _rotate(d: int, action: str) -> int:
+    assert action in ("L", "R")
+    return _rot_ccw(d) if action == "L" else _rot_cw(d)
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Emit four teal beams from a square while colored rectangles either turn or transmit them.
+
+    Input structure:
+    - The top band is a grey legend with four color cells; the bar position in each cell encodes a behavior.
+    - Left-bar colors mean counterclockwise turns, right-bar colors mean clockwise turns, and centered bars mean the beam goes straight through that obstacle color.
+    - Below the legend sits the main puzzle area with a background color, one solid teal square, and several colored obstacle rectangles.
+
+    Rule:
+    - Remove the legend from the output.
+    - Launch a sz-by-sz beam copy from the teal square in each cardinal direction, painting teal only onto background cells.
+    - When the next beam footprint reaches an obstacle color, consult the legend for that color.
+    - Turn colors rotate the beam in place before it enters the obstacle; pass-through colors let the beam advance through the obstacle without changing direction.
+    - Every beam stops once its next step would leave the grid.
+
+    Key insight: The same top legend now carries a three-way state code by bar placement, so the solver must distinguish two turning behaviors from one straight-through behavior before updating the beam state.
+    """
+    g = np.asarray(grid, dtype=int)
+
+    legend_bg = 5
+    rows_with_legend = np.where(np.any(g == legend_bg, axis=1))[0]
+    assert rows_with_legend.size, "legend rows must be present"
+    legend_h = int(rows_with_legend.max() + 1)
+    assert np.array_equal(rows_with_legend, np.arange(legend_h)), "legend color must stay in the top band"
+
+    legend_behavior = _parse_legend(g, legend_h)
+
+    base = g[legend_h:, :].copy()
+    assert base.size, "main grid must remain after legend crop"
+
+    vals, cnts = np.unique(base, return_counts=True)
+    bg = int(vals[cnts.argmax()])
+    teal = 8
+    sr, sc, sz = _find_teal_square(base, teal=teal)
+
+    out = base.copy()
+
+    def in_bounds(r: int, c: int) -> bool:
+        return 0 <= r and 0 <= c and r + sz - 1 < out.shape[0] and c + sz - 1 < out.shape[1]
+
+    def paint_block(r: int, c: int) -> None:
+        blk = out[r : r + sz, c : c + sz]
+        blk[blk == bg] = teal
+        out[r : r + sz, c : c + sz] = blk
+
+    def obstacle_color_at_next(nr: int, nc: int) -> int | None:
+        blk = out[nr : nr + sz, nc : nc + sz]
+        cols = set(map(int, np.unique(blk)))
+        cols.discard(bg)
+        cols.discard(teal)
+        if not cols:
+            return None
+        assert len(cols) == 1, "beam footprint must not hit mixed obstacle colors"
+        return int(next(iter(cols)))
+
+    for d0 in range(4):
+        r, c, d = sr, sc, d0
+        seen: set[tuple[int, int, int]] = set()
+        while True:
+            state = (r, c, d)
+            assert state not in seen, "beam path must not cycle"
+            seen.add(state)
+
