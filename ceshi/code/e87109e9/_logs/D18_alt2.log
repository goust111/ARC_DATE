+    if _S in present:
+        max_r = min(max_r, h - thickness[_S] - SOURCE_SZ - 2)
+    if _W in present:
+        min_c = max(min_c, thickness[_W] + 2)
+    if _E in present:
+        max_c = min(max_c, w - thickness[_E] - SOURCE_SZ - 2)
