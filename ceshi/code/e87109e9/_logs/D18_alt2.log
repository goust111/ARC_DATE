    65	def _parse_legend(grid: np.ndarray, legend_h: int) -> dict[int, str]:
    66	    """Return obstacle-color -> turn direction from the top legend band."""
    67	    legend = grid[:legend_h, :]
    68	    assert legend.size, "legend must be non-empty"
    69	    vals, counts = np.unique(legend, return_counts=True)
    70	    bg = int(vals[counts.argmax()])
    71	
    72	    sep_cols = [c for c in range(legend.shape[1]) if np.all(legend[:, c] == bg)]
    73	    assert len(sep_cols) >= 2, "legend separator columns must exist"
    74	
    75	    turn: dict[int, str] = {}
    76	    for a, b in zip(sep_cols, sep_cols[1:], strict=False):
    77	        if b - a <= 2:
    78	            continue
    79	        interior = legend[1 : legend_h - 1, a + 1 : b]
    80	        colors = set(map(int, np.unique(interior)))
    81	        colors.discard(bg)
    82	        colors.discard(0)
    83	        assert len(colors) == 1, "each legend cell must encode exactly one color"
    84	        color = int(next(iter(colors)))
    85	        xs = np.where(interior == color)[1]
    86	        x = int(xs[0])
    87	        turn[color] = "L" if x <= (interior.shape[1] - 1) // 2 else "R"
    88	    assert len(turn) == 4, "legend must encode four turn colors"
    89	    return turn
