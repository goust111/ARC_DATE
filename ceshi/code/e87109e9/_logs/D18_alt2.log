+
+def _simulate_paths(
+    base: np.ndarray,
+    turns: dict[int, str],
+    bg: int,
+    sr: int,
+    sc: int,
+) -> tuple[np.ndarray, list[list[tuple[int, int, int, int]]]]:
+    out = base.copy()
