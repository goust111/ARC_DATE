+
+def _find_source_block(base: np.ndarray, bg: int) -> tuple[int, int, list[int]]:
+    """
+    Find the unique isolated 2x2 source block.
+
+    Direction order in the returned color list is [N, E, S, W], sourced from
+    [UL, UR, LR, LL] respectively.
+    """
+    H, W = base.shape
+    candidates: list[tuple[int, int, list[int]]] = []
+    for r in range(H - 1):
+        for c in range(W - 1):
+            block = base[r : r + 2, c : c + 2]
+            vals = list(map(int, block.flatten()))
+            if bg in vals or len(set(vals)) != 4:
+                continue
+            rr0, rr1 = max(0, r - 1), min(H, r + 3)
+            cc0, cc1 = max(0, c - 1), min(W, c + 3)
+            ring = base[rr0:rr1, cc0:cc1].copy()
+            ring[r - rr0 : r - rr0 + 2, c - cc0 : c - cc0 + 2] = bg
+            if not np.all(ring == bg):
+                continue
+            candidates.append((int(r), int(c), [vals[0], vals[1], vals[3], vals[2]]))
