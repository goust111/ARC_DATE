+# Variant of e87109e9
+# Dimension: D18 — 源方块颜色的语义 (src)
+# Change: 源方块固定为青色(8)，颜色仅作为标识不编码额外信息，射线也涂青色... → 多色源方块（内部图案）
+
+import random
+
+import numpy as np
+
+_DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+_N, _E, _S, _W = range(4)
+
+
+# Design analysis for the D18 variant
+# -----------------------------------
+# a) Concrete behavior
+#    - The source is now always a 2x2 block with four distinct colors.
+#    - Direction/color binding is fixed by visible position:
+#        UL -> north beam, UR -> east beam, LR -> south beam, LL -> west beam.
+#    - Each beam is a 1-cell-wide ray emitted from its own source pixel, keeps its
+#      own color after turns, and still uses the legend to decide CW vs CCW turns
+#      when the next cell is an obstacle color.
+#    - Example trace: originally a 2x2 solid-8 square moving north would paint a
+#      2-cell-wide teal strip. Here the UL pixel alone emits north and paints a
+#      1-cell-wide strip in that UL color. When it sees obstacle color C, the same
+#      legend lookup applies, but only that 1-pixel ray turns.
+# b) Complexity calibration
+#    - Four distinct source colors are mandatory in every sample so the new rule is
+#      always visually present.
+#    - The direction mapping is fixed across samples; otherwise 2-4 examples would
+#      not be enough to infer it.
+#    - Obstacles and legend keep the original structure so only the source/ray
+#      semantics change.
+# c) Hidden assumptions from the old solver
+#    - Old source detection assumed one solid teal square. That fails immediately on
+#      a mixed-color 2x2, so source detection is replaced by a scan for the unique
+#      isolated 2x2 window whose four cells are pairwise distinct.
+#    - Old obstacle detection ignored teal in the live output because source cells
+#      and beam trails shared the same color. That is unsafe now: another beam's
+#      trail could look like an obstacle. The new solver checks obstacles against
+#      the immutable base grid instead of the painted output.
+#    - Old paint logic could harmlessly re-touch teal cells. Now recoloring a cell
+#      would destroy information, so painting asserts that beam paths stay disjoint.
+# d) Placement legality
+#    - Generator keeps a 1-cell moat between the 2x2 source and every obstacle.
+#    - Edge obstacles remain non-overlapping rectangles.
+#    - Span constraints still guarantee the chosen turn chains are physically
+#      realizable, now using 1-cell lanes instead of a sz-wide moving square.
+# e) Visual observability
+#    - Input visibly differs from the original in every instance because the source
+#      is never monochrome.
+#    - Output visibly differs because rays are no longer all the same color; all
+#      four source colors reappear as four beam colors.
+# f) Visual cleanliness
+#    - Beams are constrained to be non-overlapping. This avoids mixed-color knots
+#      that would obscure the direction/color rule.
+# g) Color-rule inferability
+#    - The only color transformation is positional copying from the four source
+#      pixels to the four rays. No hidden ordering by color id is used.
+# h) New solver assumptions guaranteed by the generator
+#    - Exactly one isolated 2x2 all-distinct source exists in the main grid.
+#    - Source cells are surrounded by background in the 1-cell ring.
+#    - Beam paths do not overlap and do not require passing through obstacles.
+
+
+def _parse_legend(grid: np.ndarray, legend_h: int) -> dict[int, str]:
+    """Return obstacle-color -> turn direction from the top legend band."""
+    legend = grid[:legend_h, :]
+    assert legend.size, "legend must be non-empty"
+    vals, counts = np.unique(legend, return_counts=True)
+    bg = int(vals[counts.argmax()])
+
+    sep_cols = [c for c in range(legend.shape[1]) if np.all(legend[:, c] == bg)]
+    assert len(sep_cols) >= 2, "legend separator columns must exist"
+
+    turn: dict[int, str] = {}
+    for a, b in zip(sep_cols, sep_cols[1:], strict=False):
+        if b - a <= 2:
+            continue
+        interior = legend[1 : legend_h - 1, a + 1 : b]
+        colors = set(map(int, np.unique(interior)))
+        colors.discard(bg)
+        colors.discard(0)
+        assert len(colors) == 1, "each legend cell must encode exactly one color"
+        color = int(next(iter(colors)))
+        xs = np.where(interior == color)[1]
+        x = int(xs[0])
+        turn[color] = "L" if x <= (interior.shape[1] - 1) // 2 else "R"
+    assert len(turn) == 4, "legend must encode four turn colors"
+    return turn
+
+
+def _find_source_block(base: np.ndarray, bg: int) -> tuple[int, int, list[int]]:
+    """
+    Find the unique isolated 2x2 source block.
+
+    Direction order in the returned color list is [N, E, S, W], sourced from
+    [UL, UR, LR, LL] respectively.
+    """
+    H, W = base.shape
+    candidates: list[tuple[int, int, list[int]]] = []
+    for r in range(H - 1):
+        for c in range(W - 1):
+            block = base[r : r + 2, c : c + 2]
+            vals = list(map(int, block.flatten()))
+            if bg in vals or len(set(vals)) != 4:
+                continue
+            rr0, rr1 = max(0, r - 1), min(H, r + 3)
+            cc0, cc1 = max(0, c - 1), min(W, c + 3)
+            ring = base[rr0:rr1, cc0:cc1].copy()
+            ring[r - rr0 : r - rr0 + 2, c - cc0 : c - cc0 + 2] = bg
+            if not np.all(ring == bg):
+                continue
+            candidates.append((int(r), int(c), [vals[0], vals[1], vals[3], vals[2]]))
+    assert len(candidates) == 1, "main grid must contain exactly one isolated 2x2 multi-color source"
+    return candidates[0]
+
+
+def _rot_ccw(d: int) -> int:
+    return (d - 1) % 4
+
+
+def _rot_cw(d: int) -> int:
+    return (d + 1) % 4
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Emit four colored rays from a 2x2 source, turning at obstacles per a legend.
+
+    Input structure:
+    - Top band: grey (5) legend with colored vertical bars in four cells; the bar's left/right position encodes counterclockwise vs clockwise turns.
+    - Below: main grid with a uniform background, one isolated 2x2 source whose four pixels all differ, and several colored obstacle rectangles.
+
+    Rule:
+    - Remove the legend from the output.
+    - Launch one 1-cell-wide ray from each source pixel: UL goes up, UR goes right, LR goes down, LL goes left.
+    - A ray paints background cells using its own source-pixel color and keeps that color even after turning.
+    - If the next cell is an obstacle color C, use the legend entry for C to rotate the ray 90 degrees in place, then continue. Rays stop at the grid edge.
+
+    Key insight: The 2x2 source is no longer just a marker; its four visible corner colors are the codebook for the four beam colors.
+    """
+    g = np.asarray(grid, dtype=int)
+
+    legend_bg = 5
+    rows_with_legend = np.where(np.any(g == legend_bg, axis=1))[0]
+    assert rows_with_legend.size, "legend rows must be present"
+    legend_h = int(rows_with_legend.max() + 1)
+    assert np.array_equal(rows_with_legend, np.arange(legend_h)), "legend color must be confined to the top band"
+
+    legend_turn = _parse_legend(g, legend_h)
+    base = g[legend_h:, :].copy()
+    assert base.size, "main grid must remain after legend crop"
+
+    vals, counts = np.unique(base, return_counts=True)
+    bg = int(vals[counts.argmax()])
+    sr, sc, beam_colors = _find_source_block(base, bg)
+
+    out = base.copy()
+    H, W = out.shape
+    starts = {
+        _N: (sr, sc),
+        _E: (sr, sc + 1),
+        _S: (sr + 1, sc + 1),
+        _W: (sr + 1, sc),
+    }
+    source_cells = set(starts.values())
+
+    def obstacle_color_at_next(nr: int, nc: int) -> int | None:
+        if (nr, nc) in source_cells:
+            return None
+        cell = int(base[nr, nc])
+        if cell == bg:
+            return None
+        return cell
+
+    for d0 in range(4):
+        r, c = starts[d0]
+        d = d0
+        color = int(beam_colors[d0])
+        seen: set[tuple[int, int, int]] = set()
+        while True:
+            state = (int(r), int(c), int(d))
+            assert state not in seen, "beam path must not cycle"
+            seen.add(state)
+
+            dr, dc = _DIRS[d]
+            nr, nc = int(r + dr), int(c + dc)
+            if not (0 <= nr < H and 0 <= nc < W):
+                break
+
+            oc = obstacle_color_at_next(nr, nc)
+            if oc is None:
+                r, c = nr, nc
+                if (r, c) not in source_cells:
+                    assert int(out[r, c]) == bg, "colored beams must remain disjoint"
+                    out[r, c] = color
+                continue
+
+            assert oc in legend_turn, "obstacle color must be encoded by legend"
+            turn = legend_turn[oc]
+            d = _rot_ccw(d) if turn == "L" else _rot_cw(d)
+
+    return out
+
+
+# --------------- generator ---------------
+
+LEGEND_COLOR_POOL = [1, 2, 3, 4, 6]
+BG_COLOR_POOL = [1, 2, 3, 4, 6, 7, 9]
+SOURCE_COLOR_POOL = [1, 2, 3, 4, 6, 7, 8, 9]
+LEGEND_BG = 5
+
+GRID_H_RANGE = (19, 24)
+GRID_W = 24
+LEGEND_H = 6
+LEGEND_CELL_STARTS = [1, 7, 13, 19]
+
+SOURCE_SZ = 2
+SOURCE_EDGE_GAP = 5
+
+OBS_COUNT_4_PROB = 0.65
+OBS_THICKNESS_RANGE = (2, 4)
+OBS_SINGLE_MARGIN = 6
+OBS_BOTH_GAP = 2
+
+SPAN_MIN = 6
+SPAN_MAX = 18
+SPAN_COMPACT_PROB = 0.4
+
+MAX_RETRIES = 300
+
+
+def _rot(d: int, turn: str) -> int:
+    return (d - 1) % 4 if turn == "L" else (d + 1) % 4
+
+
+def _choose_span(
+    axis_len: int,
+    required: list[tuple[int, int]],
+    excluded: list[tuple[int, int]],
+    min_len: int,
+    max_len: int,
+) -> tuple[int, int] | None:
+    req0 = min(a for a, _ in required)
+    req1 = max(b for _, b in required)
+    lo = max(min_len, req1 - req0 + 1)
+    hi = min(max_len, axis_len)
+    choices: list[tuple[int, int, int]] = []
+    for length in range(lo, hi + 1):
+        start0 = max(0, req1 - length + 1)
+        start1 = min(req0, axis_len - length)
+        for start in range(start0, start1 + 1):
+            end = start + length - 1
+            if all(end < a or start > b for a, b in excluded):
+                choices.append((length, start, end))
+    if not choices:
+        return None
+
+    lengths = sorted({length for length, _, _ in choices})
+    if random.random() < SPAN_COMPACT_PROB:
+        cutoff = lengths[min(len(lengths) - 1, len(lengths) // 2)]
+        pool = [(start, end) for length, start, end in choices if length <= cutoff]
+    else:
+        pool = [(start, end) for _, start, end in choices]
+    return random.choice(pool)
+
+
+def _make_legend(legend_colors: list[int], turns: dict[int, str]) -> np.ndarray:
+    legend = np.full((LEGEND_H, GRID_W), LEGEND_BG, dtype=int)
+    for start, color in zip(LEGEND_CELL_STARTS, legend_colors):
+        legend[1:5, start : start + 4] = 0
+        bar_col = start if turns[color] == "L" else start + 3
+        legend[1:5, bar_col] = color
+    return legend
+
+
+def _rand_thickness(lo: int, hi: int) -> int | None:
+    return random.randint(lo, hi) if hi >= lo else None
+
+
+def _thickness_pair(
+    axis: int, source_sz: int, a_present: bool, b_present: bool
+) -> tuple[int | None, int | None] | None:
+    lo, hi_cap = OBS_THICKNESS_RANGE
+    if a_present and b_present:
+        room = axis - source_sz - OBS_BOTH_GAP
+        if room < 2 * lo:
+            return None
+        a = random.randint(lo, min(hi_cap, room - lo))
+        b = _rand_thickness(lo, min(hi_cap, room - a))
+        return (a, b) if b is not None else None
+    if a_present:
+        t = _rand_thickness(lo, min(hi_cap, axis - source_sz - OBS_SINGLE_MARGIN))
+        return (t, None) if t is not None else None
+    if b_present:
+        t = _rand_thickness(lo, min(hi_cap, axis - source_sz - OBS_SINGLE_MARGIN))
+        return (None, t) if t is not None else None
+    return None, None
+
+
+def _obstacle_rect(
+    side: int, thickness: int, span: tuple[int, int], h: int, w: int
+) -> tuple[int, int, int, int]:
+    s0, s1 = span
+    if side == _N:
+        return 0, thickness - 1, s0, s1
+    if side == _S:
+        return h - thickness, h - 1, s0, s1
+    if side == _W:
+        return s0, s1, 0, thickness - 1
+    return s0, s1, w - thickness, w - 1
+
+
+def _select_chains(present: set[int], second_hits: int) -> dict[int, int] | None:
+    candidates = [
+        (side, nxt)
+        for side in present
+        for nxt in ((side - 1) % 4, (side + 1) % 4)
+        if nxt in present
+    ]
+    random.shuffle(candidates)
+    selected: list[tuple[int, int]] = []
+    used: set[int] = set()
+    for side, nxt in candidates:
+        if len(selected) == second_hits:
+            break
+        if side in used or nxt in used:
+            continue
+        selected.append((side, nxt))
+        used.update((side, nxt))
+    return dict(selected) if len(selected) == second_hits else None
