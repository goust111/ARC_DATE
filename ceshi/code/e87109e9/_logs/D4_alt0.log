+++ b/ceshi/code/e87109e9/D4/0/code.py
@@ -0,0 +1,594 @@
+# Variant of e87109e9
+# Dimension: D4 — 轨迹涂色模式 (trajectory)
+# Change: 沿路径连续涂青色(8)，从源到障碍物或网格边缘形成连续实线轨迹... → 颜色随转弯段变化
+
+import random
+
+import numpy as np
+
+from arc_utils import bbox_coords, components_mask
+
+
+# Design analysis for the D4 trajectory-color variant.
+#
+# design_analysis:
+#   concrete_behavior:
+#     input:
+#       - 输入仍由顶部 6x24 图例和下方主网格组成；图例只编码“某个障碍色触发左转还是右转”。
+#       - 主网格仍只有一个青色(8)实心方块源，以及 3-4 个贴边的纯色矩形障碍物。
+#     output:
+#       - 仍然裁掉图例，只保留主网格。
+#       - 射线仍以与源方块同尺寸的滑动方块形式沿四个基方向传播。
+#       - 关键变化在“段颜色”而不是“路径几何”：
+#         第 1 段始终画青色(8)；
+#         每次撞到某个颜色 C 的障碍并转向后，后续整段改画颜色 C；
+#         若再次撞到颜色 D，则下一段再改成 D。
+#     traced_example:
+#       - 原题：源向右走，直到撞到红障碍；转弯后继续画青色；再撞到蓝障碍后仍继续画青色。
+#       - 变体：同一路径几何下，第一段画青色；撞红后，转后的整段画红色；再撞蓝后，下一段画蓝色。
+#       - 差异不在“往哪走”，而在“走过的每一段用什么颜色显示”。
+#   complexity_calibration:
+#     - 不增加新的控制符号，仍只使用原有图例和障碍物颜色，避免任务结构膨胀。
+#     - 颜色变化只取离散的“继承最近一次触发转弯的障碍物颜色”，规则单一，但样例中会重复出现多个转弯段以支撑归纳。
+#     - 为避免变体退化成原题，生成器要求输出里必须出现可见的非青色轨迹段，并且至少有两个可见的换色段。
+#   implicit_assumptions_review:
+#     - 原题 `obstacle_color_at_next()` 读取的是动态输出 `out`，因为轨迹永远是 8，所以把 8 丢掉后不会把旧轨迹误判成障碍。
+#     - 变体下轨迹会变成红/蓝/黄等障碍色；若继续读 `out`，后来的 beam 会把先前画出的轨迹当成新障碍，路径会错误。
+#     - 因此新实现把“障碍判定”固定在静态底图 `base` 上，把“着色结果”写入动态图 `out`，语义必须拆开。
+#     - 原题 `paint_block()` 只会写 8，覆盖规则天然无歧义；变体下不同颜色轨迹若相互压到会引入隐含的执行顺序依赖。
+#     - 为了不把“按哪个 beam 先处理”变成隐藏规则，生成器会拒绝不同颜色轨迹在同一背景像素上的冲突覆盖。
+#   placement_legality:
+#     - 障碍物的尺寸、贴边方式、与源方块的间距、转向链的构造沿用原题；这些足以保证路径几何合法。
+#     - 额外新增的合法性条件只有一条：
+#       不允许两段不同颜色的轨迹竞争同一背景像素；否则输出颜色会依赖 beam 处理顺序。
+#     - 生成器通过严格仿真检出这种冲突，并重试生成。
+#   visual_observability:
+#     - 观察者仍可先从图例读出“某色遇到后左转/右转”，再从输出看到“转弯后的段颜色刚好等于刚撞到的障碍颜色”。
+#     - 障碍色数量仍控制在 3-4 个，颜色种类不爆炸；颜色变化由空间事件（撞到哪个障碍）触发，而不是由不可见的 ID 排序触发。
+#     - 生成器要求输出与“全程青色”的原题输出确实不同，避免表面变体、实际退化。
+#   cleanliness:
+#     - 图例仍被裁掉，输出只包含背景、障碍、源方块和若干分段彩色轨迹，层级与原题一致。
+#     - 轨迹冲突被禁止后，彩色段之间不会形成难以解释的覆盖杂讯，视觉上仍是整洁的分段折线。
+#   new_solver_assumptions:
+#     - `main()` 现在假设：beam 判障碍时只看输入底图，不看已经画出的轨迹。
+#     - `main()` 还假设：若多个 beam 访问同一背景区域，要么颜色相同，要么生成器已经避免该情况。
+#     - `generate_input()` 通过静态判障碍 + 严格冲突检查来保证这两条前提成立。
+
+_DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+_N, _E, _S, _W = range(4)
+
+# Color palettes
+LEGEND_COLOR_POOL = [1, 2, 3, 4, 6]
+BG_COLOR_POOL = [1, 2, 3, 4, 6, 7, 9]
+LEGEND_BG = 5
+TEAL = 8
+
+# Canvas dimensions
+GRID_H_RANGE = (19, 24)
+GRID_W = 24
+LEGEND_H = 6
+LEGEND_CELL_STARTS = [1, 7, 13, 19]
+
+# Teal square
+TEAL_SZ2_PROB = 0.75
+SQUARE_EDGE_GAP = 5
+
+# Obstacles
+OBS_COUNT_4_PROB = 0.65
+OBS_THICKNESS_RANGE = (2, 4)
+OBS_SINGLE_MARGIN = 6
+OBS_BOTH_GAP = 2
+
+# Span selection
+SPAN_MIN_MULT = 3
+SPAN_MAX_MULT = 14
+SPAN_COMPACT_PROB = 0.4
+
+# Variant visibility / retry budget
+MIN_VISIBLE_RECOLOR_SEGMENTS = 2
+MIN_VISIBLE_RECOLOR_COLORS = 2
+MAX_RETRIES = 800
+
+
+def _parse_legend(grid: np.ndarray, legend_h: int) -> dict[int, str]:
+    """
+    Legend is a top region with a background color (typically 5) and 4 vertical bars.
+    Each bar's horizontal position inside its cell encodes turn direction:
+      - bar on left  -> 'L' (turn counterclockwise)
+      - bar on right -> 'R' (turn clockwise)
+    """
+    legend = grid[:legend_h, :]
+    assert legend.size, "legend must be non-empty"
+    vals, counts = np.unique(legend, return_counts=True)
+    bg = int(vals[counts.argmax()])
+
+    sep_cols = [c for c in range(legend.shape[1]) if np.all(legend[:, c] == bg)]
+    assert len(sep_cols) >= 2, "legend separator columns must exist"
+
+    turn: dict[int, str] = {}
+    for a, b in zip(sep_cols, sep_cols[1:], strict=False):
+        if b - a <= 2:
+            continue
+        interior = legend[1 : legend_h - 1, a + 1 : b]
+        colors = set(map(int, np.unique(interior)))
+        colors.discard(bg)
+        colors.discard(0)
+        assert len(colors) == 1, "each legend cell must encode exactly one color"
+        col = int(next(iter(colors)))
+        xs = np.where(interior == col)[1]
+        x = int(xs[0])
+        turn[col] = "L" if x <= (interior.shape[1] - 1) // 2 else "R"
+    assert len(turn) == 4, "legend must encode four turn colors"
+    return turn
+
+
+def _find_teal_square(g: np.ndarray, teal: int = TEAL) -> tuple[int, int, int]:
+    """Return (r0, c0, size) for the unique solid teal square."""
+    candidates: list[tuple[int, int, int]] = []
+    for cells in components_mask(g == teal, connectivity=4):
+        r0, c0, r1, c1 = bbox_coords(cells)
+        hh = r1 - r0 + 1
+        ww = c1 - c0 + 1
+        if hh != ww:
+            continue
+        size = hh
+        if int(np.sum(g[r0 : r1 + 1, c0 : c1 + 1] == teal)) != size * size:
+            continue
+        candidates.append((int(r0), int(c0), int(size)))
+    assert len(candidates) == 1, "main grid must contain exactly one solid teal square"
+    return candidates[0]
+
+
+def _rot(d: int, turn: str) -> int:
+    return (d - 1) % 4 if turn == "L" else (d + 1) % 4
+
+
+def _simulate_paths(
+    base: np.ndarray,
+    turns: dict[int, str],
+    bg: int,
+    *,
+    inherit_colors: bool,
+    strict_trail_conflicts: bool,
+) -> tuple[np.ndarray, list[list[tuple[int, int, int, int]]], list[dict[str, list[int]]]]:
+    """
+    Shared oracle for both solver and generator.
+
+    Obstacles are detected from the immutable base grid.
+    Trails are drawn onto the mutable out grid.
+    """
+    vals, counts = np.unique(base, return_counts=True)
+    assert int(vals[counts.argmax()]) == bg
+
+    sr, sc, sz = _find_teal_square(base, teal=TEAL)
+    out = base.copy()
+    H, W = out.shape
+    hits: list[list[tuple[int, int, int, int]]] = []
+    beam_stats: list[dict[str, list[int]]] = []
+
+    def in_bounds(r: int, c: int) -> bool:
+        return 0 <= r and 0 <= c and r + sz - 1 < H and c + sz - 1 < W
+
+    def paint_block(r: int, c: int, color: int) -> int:
+        out_blk = out[r : r + sz, c : c + sz].copy()
+        base_blk = base[r : r + sz, c : c + sz]
+        trail_mask = base_blk == bg
+        if strict_trail_conflicts:
+            conflict = trail_mask & (out_blk != bg) & (out_blk != color)
+            assert not np.any(conflict), "trail colors must not overlap ambiguously"
+        new_mask = trail_mask & (out_blk == bg)
+        out_blk[new_mask] = color
+        out[r : r + sz, c : c + sz] = out_blk
+        return int(np.count_nonzero(new_mask))
+
+    def obstacle_color_at_next(nr: int, nc: int) -> int | None:
+        blk = base[nr : nr + sz, nc : nc + sz]
+        cols = set(map(int, np.unique(blk)))
+        cols.discard(bg)
+        cols.discard(TEAL)
+        if not cols:
+            return None
+        assert len(cols) == 1, "beam footprint must not hit mixed obstacle colors"
+        return int(next(iter(cols)))
+
+    for d0 in range(4):
+        r, c, d = sr, sc, d0
+        cur_color = TEAL
+        beam_hits: list[tuple[int, int, int, int]] = []
+        seg_colors = [TEAL]
+        seg_new_cells = [0]
+        seen: set[tuple[int, int, int]] = set()
+
+        while True:
+            state = (r, c, d)
+            assert state not in seen, "beam path must not cycle"
+            seen.add(state)
+
+            dr, dc = _DIRS[d]
+            nr, nc = r + dr, c + dc
+            if not in_bounds(nr, nc):
+                break
+
+            obs = obstacle_color_at_next(nr, nc)
+            if obs is None:
+                r, c = nr, nc
+                seg_new_cells[-1] += paint_block(r, c, cur_color)
+                continue
+
+            assert obs in turns, "obstacle color must be encoded by legend"
+            beam_hits.append((d, obs, nr, nc))
+            d = _rot(d, turns[obs])
+            if inherit_colors:
+                cur_color = obs
+                seg_colors.append(cur_color)
+                seg_new_cells.append(0)
+
+        hits.append(beam_hits)
+        beam_stats.append(
+            {
+                "segment_colors": seg_colors,
+                "segment_new_cells": seg_new_cells,
+            }
+        )
+
+    return out, hits, beam_stats
+
+
+def _variant_metrics(
+    base: np.ndarray,
+    out: np.ndarray,
+    beam_stats: list[dict[str, list[int]]],
+    bg: int,
+) -> dict[str, int]:
+    painted_bg = (base == bg) & (out != bg)
+    visible_recolor_segments = 0
+    visible_recolor_colors: set[int] = set()
+    for stats in beam_stats:
+        for color, new_cells in zip(
+            stats["segment_colors"][1:],
+            stats["segment_new_cells"][1:],
+            strict=False,
+        ):
+            if new_cells > 0:
+                visible_recolor_segments += 1
+                visible_recolor_colors.add(int(color))
+    return {
+        "visible_recolor_segments": visible_recolor_segments,
+        "visible_recolor_colors": len(visible_recolor_colors),
+        "non_teal_trail_cells": int(np.count_nonzero(painted_bg & (out != TEAL))),
+    }
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Launch four square-width rays from the teal source, with segment colors inherited from bounces.
+
+    Input structure:
+    - Top band: a grey legend whose four colored bars encode left/right turn behavior by bar position inside each cell.
+    - Below: the main field with one solid teal square, a uniform background, and several solid colored obstacle rectangles.
+
+    Rule:
+    - Remove the legend in the output.
+    - From the teal square, propagate one square-width ray in each cardinal direction.
+    - The first segment is teal; whenever the next move would hit an obstacle of color C, turn according to the legend and make all later painted cells use color C until another obstacle is hit.
+    - Obstacles are never overwritten, and rays stop when their next square step would leave the grid.
+
+    Key insight: The legend still controls only the turning direction, while the obstacle color itself becomes the paint color for the next trajectory segment after each bounce.
+    """
+    g = np.asarray(grid, dtype=int)
+
+    legend_bg = LEGEND_BG
+    rows_with_legend = np.where(np.any(g == legend_bg, axis=1))[0]
+    assert rows_with_legend.size, "legend rows must be present"
+    legend_h = int(rows_with_legend.max() + 1)
+    assert np.array_equal(
+        rows_with_legend, np.arange(legend_h)
+    ), "legend color must be confined to the top band"
+
+    legend_turn = _parse_legend(g, legend_h)
+    base = g[legend_h:, :].copy()
+    assert base.size, "main grid must remain after legend crop"
+
+    vals, counts = np.unique(base, return_counts=True)
+    bg = int(vals[counts.argmax()])
+    out, _hits, _stats = _simulate_paths(
+        base,
+        legend_turn,
+        bg,
+        inherit_colors=True,
+        strict_trail_conflicts=False,
+    )
+    return out
+
+
+def _choose_span(
+    axis_len: int,
+    required: list[tuple[int, int]],
+    excluded: list[tuple[int, int]],
+    min_len: int,
+    max_len: int,
+) -> tuple[int, int] | None:
+    """Pick a span covering all required intervals while missing all excluded intervals."""
+    req0 = min(a for a, _ in required)
+    req1 = max(b for _, b in required)
+    lo = max(min_len, req1 - req0 + 1)
+    hi = min(max_len, axis_len)
+    choices: list[tuple[int, int, int]] = []
+    for length in range(lo, hi + 1):
+        start0 = max(0, req1 - length + 1)
+        start1 = min(req0, axis_len - length)
+        for start in range(start0, start1 + 1):
+            end = start + length - 1
+            if all(end < a or start > b for a, b in excluded):
+                choices.append((length, start, end))
+    if not choices:
+        return None
+
+    lengths = sorted({length for length, _, _ in choices})
+    if random.random() < SPAN_COMPACT_PROB:
+        cutoff = lengths[min(len(lengths) - 1, max(0, len(lengths) // 2))]
+        pool = [(start, end) for length, start, end in choices if length <= cutoff]
+    else:
+        pool = [(start, end) for _, start, end in choices]
+    return random.choice(pool)
+
+
+def _make_legend(legend_colors: list[int], turns: dict[int, str]) -> np.ndarray:
+    """Build the 6x24 legend band from four colors and their turn assignments."""
+    legend = np.full((LEGEND_H, GRID_W), LEGEND_BG, dtype=int)
+    for start, color in zip(LEGEND_CELL_STARTS, legend_colors, strict=False):
+        legend[1:5, start : start + 4] = 0
+        bar_col = start if turns[color] == "L" else start + 3
+        legend[1:5, bar_col] = color
+    return legend
+
+
+def _rand_thickness(lo: int, hi: int) -> int | None:
+    return random.randint(lo, hi) if hi >= lo else None
+
+
+def _thickness_pair(
+    axis: int, sz: int, a_present: bool, b_present: bool
+) -> tuple[int | None, int | None] | None:
+    """Compute obstacle thicknesses for the two ends of one axis."""
+    lo, hi_cap = OBS_THICKNESS_RANGE
+    if a_present and b_present:
+        room = axis - sz - OBS_BOTH_GAP
+        if room < 2 * lo:
+            return None
+        a = random.randint(lo, min(hi_cap, room - lo))
+        b = _rand_thickness(lo, min(hi_cap, room - a))
+        return (a, b) if b is not None else None
+    if a_present:
+        t = _rand_thickness(lo, min(hi_cap, axis - sz - OBS_SINGLE_MARGIN))
+        return (t, None) if t is not None else None
+    if b_present:
+        t = _rand_thickness(lo, min(hi_cap, axis - sz - OBS_SINGLE_MARGIN))
+        return (None, t) if t is not None else None
+    return None, None
+
+
+def _obstacle_rect(
+    side: int, thickness: int, span: tuple[int, int], h: int, w: int
+) -> tuple[int, int, int, int]:
+    """Return (r0, r1, c0, c1) for an edge-touching obstacle rectangle."""
+    s0, s1 = span
+    if side == _N:
+        return 0, thickness - 1, s0, s1
+    if side == _S:
+        return h - thickness, h - 1, s0, s1
+    if side == _W:
+        return s0, s1, 0, thickness - 1
+    return s0, s1, w - thickness, w - 1
+
+
+def _select_chains(present: set[int], second_hits: int) -> dict[int, int] | None:
+    """Pick non-overlapping (source -> adjacent target) pairs for two-bounce beams."""
+    candidates = [
+        (side, nxt)
+        for side in present
+        for nxt in ((side - 1) % 4, (side + 1) % 4)
+        if nxt in present
+    ]
+    random.shuffle(candidates)
+    selected: list[tuple[int, int]] = []
+    used: set[int] = set()
+    for side, nxt in candidates:
+        if len(selected) == second_hits:
+            break
+        if side in used or nxt in used:
+            continue
+        selected.append((side, nxt))
+        used.update((side, nxt))
+    return dict(selected) if len(selected) == second_hits else None
+
+
+def _assign_turns(present: set[int], chains: dict[int, int]) -> dict[int, str]:
+    """Assign L/R turn direction for each obstacle side."""
+    side_turn: dict[int, str] = {}
+    for side in present:
+        if side in chains:
+            nxt = chains[side]
+            side_turn[side] = "L" if nxt == (side - 1) % 4 else "R"
+        else:
+            outward = [t for t in ("L", "R") if _rot(side, t) not in present]
+            side_turn[side] = random.choice(outward if outward else ["L", "R"])
+    return side_turn
+
+
+def _compute_span_constraints(
+    present: set[int],
+    side_turn: dict[int, str],
+    chains: dict[int, int],
+    sr: int,
+    sc: int,
+    sz: int,
+    lane: dict[int, int],
+) -> tuple[dict[int, list[tuple[int, int]]], dict[int, list[tuple[int, int]]]]:
+    """Build required/excluded intervals for each obstacle span."""
+    required: dict[int, list[tuple[int, int]]] = {s: [] for s in present}
+    excluded: dict[int, list[tuple[int, int]]] = {s: [] for s in present}
+
+    for side in present:
+        base_coord = sc if side in (_N, _S) else sr
+        required[side].append((base_coord, base_coord + sz - 1))
+
+    def lane_interval(s: int) -> tuple[int, int]:
+        return lane[s], lane[s] + sz - 1
+
+    for side in present:
+        nxt = _rot(side, side_turn[side])
+        if nxt not in present:
+            continue
+        if chains.get(side) == nxt:
+            required[nxt].append(lane_interval(side))
+            after = _rot(nxt, side_turn[nxt])
+            if after in present:
+                excluded[after].append(lane_interval(nxt))
+        else:
+            excluded[nxt].append(lane_interval(side))
+
+    return required, excluded
+
+
+def _gen_attempt() -> np.ndarray | None:
+    h, w = random.randint(*GRID_H_RANGE), GRID_W
+    sz = 2 if random.random() < TEAL_SZ2_PROB else 3
+    obstacle_count = 4 if random.random() < OBS_COUNT_4_PROB else 3
+    present = set(random.sample([_N, _E, _S, _W], obstacle_count))
+    target_hits = random.choice([4, 5])
+    second_hits = target_hits - obstacle_count
+    if second_hits < 0 or second_hits > 2:
+        return None
+
+    ns = _thickness_pair(h, sz, _N in present, _S in present)
+    ew = _thickness_pair(w, sz, _W in present, _E in present)
+    if ns is None or ew is None:
+        return None
+    thickness = {s: t for s, t in zip((_N, _S, _W, _E), (*ns, *ew), strict=False) if t is not None}
+
+    min_r, max_r = SQUARE_EDGE_GAP, h - sz - SQUARE_EDGE_GAP
+    min_c, max_c = SQUARE_EDGE_GAP, w - sz - SQUARE_EDGE_GAP
+    if _N in present:
+        min_r = max(min_r, thickness[_N] + 1)
+    if _S in present:
+        max_r = min(max_r, h - thickness[_S] - sz - 1)
+    if _W in present:
+        min_c = max(min_c, thickness[_W] + 1)
+    if _E in present:
+        max_c = min(max_c, w - thickness[_E] - sz - 1)
+    if min_r > max_r or min_c > max_c:
+        return None
+    sr, sc = random.randint(min_r, max_r), random.randint(min_c, max_c)
+
+    lane: dict[int, int] = {}
+    if _N in present:
+        lane[_N] = thickness[_N] + 1
+    if _S in present:
+        lane[_S] = h - thickness[_S] - sz
+    if _W in present:
+        lane[_W] = thickness[_W] + 1
+    if _E in present:
+        lane[_E] = w - thickness[_E] - sz
+
+    chains = _select_chains(present, second_hits)
+    if chains is None:
+        return None
+
+    side_turn = _assign_turns(present, chains)
+    required, excluded = _compute_span_constraints(
+        present, side_turn, chains, sr, sc, sz, lane
+    )
+
+    spans: dict[int, tuple[int, int]] = {}
+    for side in present:
+        axis_len = w if side in (_N, _S) else h
+        span = _choose_span(
+            axis_len,
+            required[side],
+            excluded[side],
+            SPAN_MIN_MULT * sz,
+            min(SPAN_MAX_MULT * sz, axis_len),
+        )
+        if span is None:
+            return None
+        spans[side] = span
+
+    legend_colors = random.sample(LEGEND_COLOR_POOL, 4)
+    obstacle_colors = random.sample(legend_colors, obstacle_count)
+    side_color = dict(zip(sorted(present), obstacle_colors, strict=False))
+    bg = random.choice([c for c in BG_COLOR_POOL if c not in legend_colors])
+
+    base = np.full((h, w), bg, dtype=int)
+    base[sr : sr + sz, sc : sc + sz] = TEAL
+    occupied = np.zeros((h, w), dtype=bool)
+    for side in present:
+        r0, r1, c0, c1 = _obstacle_rect(side, thickness[side], spans[side], h, w)
+        region = occupied[r0 : r1 + 1, c0 : c1 + 1]
+        if region.any():
+            return None
+        if not (r1 < sr - 1 or r0 > sr + sz or c1 < sc - 1 or c0 > sc + sz):
+            return None
+        occupied[r0 : r1 + 1, c0 : c1 + 1] = True
+        base[r0 : r1 + 1, c0 : c1 + 1] = side_color[side]
+
+    vals, counts = np.unique(base, return_counts=True)
+    if int(vals[counts.argmax()]) != bg:
+        return None
+
+    turns = {side_color[s]: side_turn[s] for s in present}
+    for color in legend_colors:
+        turns.setdefault(color, random.choice(["L", "R"]))
+
+    try:
+        expected, hits, beam_stats = _simulate_paths(
+            base,
+            turns,
+            bg,
+            inherit_colors=True,
+            strict_trail_conflicts=True,
+        )
+        old_expected, _old_hits, _old_stats = _simulate_paths(
+            base,
+            turns,
+            bg,
+            inherit_colors=False,
+            strict_trail_conflicts=False,
+        )
+    except AssertionError:
+        return None
+
+    hit_counts = [len(beam) for beam in hits]
+    hit_colors = {color for beam in hits for _, color, _, _ in beam}
+    if sum(hit_counts) != target_hits or any(c > 2 for c in hit_counts):
+        return None
+    if set(side_color.values()) - hit_colors:
+        return None
+
+    metrics = _variant_metrics(base, expected, beam_stats, bg)
+    if metrics["visible_recolor_segments"] < MIN_VISIBLE_RECOLOR_SEGMENTS:
+        return None
+    if metrics["visible_recolor_colors"] < MIN_VISIBLE_RECOLOR_COLORS:
+        return None
+    if metrics["non_teal_trail_cells"] <= 0:
+        return None
+    if np.array_equal(expected, old_expected):
+        return None
+
+    legend = _make_legend(legend_colors, turns)
+    inp = np.vstack([legend, base])
+    try:
+        actual = main(inp)
+    except AssertionError:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate e87109e9 D4 input")

diff --git a/ceshi/code/e87109e9/D4/0/code.py b/ceshi/code/e87109e9/D4/0/code.py
new file mode 100644
index 0000000000000000000000000000000000000000..8ffd4a8908033c2075e04ea87828ae5774233475
--- /dev/null
+++ b/ceshi/code/e87109e9/D4/0/code.py
@@ -0,0 +1,594 @@
+# Variant of e87109e9
+# Dimension: D4 — 轨迹涂色模式 (trajectory)
+# Change: 沿路径连续涂青色(8)，从源到障碍物或网格边缘形成连续实线轨迹... → 颜色随转弯段变化
+
+import random
+
+import numpy as np
+
+from arc_utils import bbox_coords, components_mask
+
+
+# Design analysis for the D4 trajectory-color variant.
+#
+# design_analysis:
+#   concrete_behavior:
+#     input:
+#       - 输入仍由顶部 6x24 图例和下方主网格组成；图例只编码“某个障碍色触发左转还是右转”。
+#       - 主网格仍只有一个青色(8)实心方块源，以及 3-4 个贴边的纯色矩形障碍物。
+#     output:
+#       - 仍然裁掉图例，只保留主网格。
+#       - 射线仍以与源方块同尺寸的滑动方块形式沿四个基方向传播。
+#       - 关键变化在“段颜色”而不是“路径几何”：
+#         第 1 段始终画青色(8)；
+#         每次撞到某个颜色 C 的障碍并转向后，后续整段改画颜色 C；
+#         若再次撞到颜色 D，则下一段再改成 D。
+#     traced_example:
+#       - 原题：源向右走，直到撞到红障碍；转弯后继续画青色；再撞到蓝障碍后仍继续画青色。
+#       - 变体：同一路径几何下，第一段画青色；撞红后，转后的整段画红色；再撞蓝后，下一段画蓝色。
+#       - 差异不在“往哪走”，而在“走过的每一段用什么颜色显示”。
+#   complexity_calibration:
+#     - 不增加新的控制符号，仍只使用原有图例和障碍物颜色，避免任务结构膨胀。
+#     - 颜色变化只取离散的“继承最近一次触发转弯的障碍物颜色”，规则单一，但样例中会重复出现多个转弯段以支撑归纳。
+#     - 为避免变体退化成原题，生成器要求输出里必须出现可见的非青色轨迹段，并且至少有两个可见的换色段。
+#   implicit_assumptions_review:
+#     - 原题 `obstacle_color_at_next()` 读取的是动态输出 `out`，因为轨迹永远是 8，所以把 8 丢掉后不会把旧轨迹误判成障碍。
+#     - 变体下轨迹会变成红/蓝/黄等障碍色；若继续读 `out`，后来的 beam 会把先前画出的轨迹当成新障碍，路径会错误。
+#     - 因此新实现把“障碍判定”固定在静态底图 `base` 上，把“着色结果”写入动态图 `out`，语义必须拆开。
+#     - 原题 `paint_block()` 只会写 8，覆盖规则天然无歧义；变体下不同颜色轨迹若相互压到会引入隐含的执行顺序依赖。
+#     - 为了不把“按哪个 beam 先处理”变成隐藏规则，生成器会拒绝不同颜色轨迹在同一背景像素上的冲突覆盖。
+#   placement_legality:
+#     - 障碍物的尺寸、贴边方式、与源方块的间距、转向链的构造沿用原题；这些足以保证路径几何合法。
+#     - 额外新增的合法性条件只有一条：
+#       不允许两段不同颜色的轨迹竞争同一背景像素；否则输出颜色会依赖 beam 处理顺序。
+#     - 生成器通过严格仿真检出这种冲突，并重试生成。
+#   visual_observability:
+#     - 观察者仍可先从图例读出“某色遇到后左转/右转”，再从输出看到“转弯后的段颜色刚好等于刚撞到的障碍颜色”。
+#     - 障碍色数量仍控制在 3-4 个，颜色种类不爆炸；颜色变化由空间事件（撞到哪个障碍）触发，而不是由不可见的 ID 排序触发。
+#     - 生成器要求输出与“全程青色”的原题输出确实不同，避免表面变体、实际退化。
+#   cleanliness:
+#     - 图例仍被裁掉，输出只包含背景、障碍、源方块和若干分段彩色轨迹，层级与原题一致。
+#     - 轨迹冲突被禁止后，彩色段之间不会形成难以解释的覆盖杂讯，视觉上仍是整洁的分段折线。
+#   new_solver_assumptions:
+#     - `main()` 现在假设：beam 判障碍时只看输入底图，不看已经画出的轨迹。
+#     - `main()` 还假设：若多个 beam 访问同一背景区域，要么颜色相同，要么生成器已经避免该情况。
+#     - `generate_input()` 通过静态判障碍 + 严格冲突检查来保证这两条前提成立。
+
+_DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+_N, _E, _S, _W = range(4)
+
+# Color palettes
+LEGEND_COLOR_POOL = [1, 2, 3, 4, 6]
+BG_COLOR_POOL = [1, 2, 3, 4, 6, 7, 9]
+LEGEND_BG = 5
+TEAL = 8
+
+# Canvas dimensions
+GRID_H_RANGE = (19, 24)
+GRID_W = 24
+LEGEND_H = 6
+LEGEND_CELL_STARTS = [1, 7, 13, 19]
+
+# Teal square
+TEAL_SZ2_PROB = 0.75
+SQUARE_EDGE_GAP = 5
+
+# Obstacles
+OBS_COUNT_4_PROB = 0.65
+OBS_THICKNESS_RANGE = (2, 4)
+OBS_SINGLE_MARGIN = 6
+OBS_BOTH_GAP = 2
+
+# Span selection
+SPAN_MIN_MULT = 3
+SPAN_MAX_MULT = 14
+SPAN_COMPACT_PROB = 0.4
+
+# Variant visibility / retry budget
+MIN_VISIBLE_RECOLOR_SEGMENTS = 2
+MIN_VISIBLE_RECOLOR_COLORS = 2
+MAX_RETRIES = 800
+
+
+def _parse_legend(grid: np.ndarray, legend_h: int) -> dict[int, str]:
+    """
+    Legend is a top region with a background color (typically 5) and 4 vertical bars.
+    Each bar's horizontal position inside its cell encodes turn direction:
+      - bar on left  -> 'L' (turn counterclockwise)
+      - bar on right -> 'R' (turn clockwise)
+    """
+    legend = grid[:legend_h, :]
+    assert legend.size, "legend must be non-empty"
+    vals, counts = np.unique(legend, return_counts=True)
+    bg = int(vals[counts.argmax()])
+
+    sep_cols = [c for c in range(legend.shape[1]) if np.all(legend[:, c] == bg)]
+    assert len(sep_cols) >= 2, "legend separator columns must exist"
+
+    turn: dict[int, str] = {}
+    for a, b in zip(sep_cols, sep_cols[1:], strict=False):
+        if b - a <= 2:
+            continue
+        interior = legend[1 : legend_h - 1, a + 1 : b]
+        colors = set(map(int, np.unique(interior)))
+        colors.discard(bg)
+        colors.discard(0)
+        assert len(colors) == 1, "each legend cell must encode exactly one color"
+        col = int(next(iter(colors)))
+        xs = np.where(interior == col)[1]
+        x = int(xs[0])
+        turn[col] = "L" if x <= (interior.shape[1] - 1) // 2 else "R"
+    assert len(turn) == 4, "legend must encode four turn colors"
+    return turn
+
+
+def _find_teal_square(g: np.ndarray, teal: int = TEAL) -> tuple[int, int, int]:
+    """Return (r0, c0, size) for the unique solid teal square."""
+    candidates: list[tuple[int, int, int]] = []
+    for cells in components_mask(g == teal, connectivity=4):
+        r0, c0, r1, c1 = bbox_coords(cells)
+        hh = r1 - r0 + 1
+        ww = c1 - c0 + 1
+        if hh != ww:
+            continue
+        size = hh
+        if int(np.sum(g[r0 : r1 + 1, c0 : c1 + 1] == teal)) != size * size:
+            continue
+        candidates.append((int(r0), int(c0), int(size)))
+    assert len(candidates) == 1, "main grid must contain exactly one solid teal square"
+    return candidates[0]
+
+
+def _rot(d: int, turn: str) -> int:
+    return (d - 1) % 4 if turn == "L" else (d + 1) % 4
+
+
+def _simulate_paths(
+    base: np.ndarray,
+    turns: dict[int, str],
+    bg: int,
+    *,
+    inherit_colors: bool,
+    strict_trail_conflicts: bool,
+) -> tuple[np.ndarray, list[list[tuple[int, int, int, int]]], list[dict[str, list[int]]]]:
+    """
+    Shared oracle for both solver and generator.
+
+    Obstacles are detected from the immutable base grid.
+    Trails are drawn onto the mutable out grid.
+    """
+    vals, counts = np.unique(base, return_counts=True)
+    assert int(vals[counts.argmax()]) == bg
+
+    sr, sc, sz = _find_teal_square(base, teal=TEAL)
+    out = base.copy()
+    H, W = out.shape
+    hits: list[list[tuple[int, int, int, int]]] = []
+    beam_stats: list[dict[str, list[int]]] = []
+
+    def in_bounds(r: int, c: int) -> bool:
+        return 0 <= r and 0 <= c and r + sz - 1 < H and c + sz - 1 < W
+
+    def paint_block(r: int, c: int, color: int) -> int:
+        out_blk = out[r : r + sz, c : c + sz].copy()
+        base_blk = base[r : r + sz, c : c + sz]
+        trail_mask = base_blk == bg
+        if strict_trail_conflicts:
+            conflict = trail_mask & (out_blk != bg) & (out_blk != color)
+            assert not np.any(conflict), "trail colors must not overlap ambiguously"
+        new_mask = trail_mask & (out_blk == bg)
+        out_blk[new_mask] = color
+        out[r : r + sz, c : c + sz] = out_blk
+        return int(np.count_nonzero(new_mask))
+
+    def obstacle_color_at_next(nr: int, nc: int) -> int | None:
+        blk = base[nr : nr + sz, nc : nc + sz]
+        cols = set(map(int, np.unique(blk)))
+        cols.discard(bg)
+        cols.discard(TEAL)
+        if not cols:
+            return None
+        assert len(cols) == 1, "beam footprint must not hit mixed obstacle colors"
+        return int(next(iter(cols)))
+
+    for d0 in range(4):
+        r, c, d = sr, sc, d0
+        cur_color = TEAL
+        beam_hits: list[tuple[int, int, int, int]] = []
+        seg_colors = [TEAL]
+        seg_new_cells = [0]
+        seen: set[tuple[int, int, int]] = set()
+
+        while True:
+            state = (r, c, d)
+            assert state not in seen, "beam path must not cycle"
+            seen.add(state)
+
+            dr, dc = _DIRS[d]
+            nr, nc = r + dr, c + dc
+            if not in_bounds(nr, nc):
+                break
+
+            obs = obstacle_color_at_next(nr, nc)
+            if obs is None:
+                r, c = nr, nc
+                seg_new_cells[-1] += paint_block(r, c, cur_color)
+                continue
+
+            assert obs in turns, "obstacle color must be encoded by legend"
+            beam_hits.append((d, obs, nr, nc))
+            d = _rot(d, turns[obs])
+            if inherit_colors:
+                cur_color = obs
+                seg_colors.append(cur_color)
+                seg_new_cells.append(0)
+
+        hits.append(beam_hits)
+        beam_stats.append(
+            {
+                "segment_colors": seg_colors,
+                "segment_new_cells": seg_new_cells,
+            }
+        )
+
+    return out, hits, beam_stats
+
+
+def _variant_metrics(
+    base: np.ndarray,
+    out: np.ndarray,
+    beam_stats: list[dict[str, list[int]]],
+    bg: int,
+) -> dict[str, int]:
+    painted_bg = (base == bg) & (out != bg)
+    visible_recolor_segments = 0
+    visible_recolor_colors: set[int] = set()
+    for stats in beam_stats:
+        for color, new_cells in zip(
+            stats["segment_colors"][1:],
+            stats["segment_new_cells"][1:],
+            strict=False,
+        ):
+            if new_cells > 0:
+                visible_recolor_segments += 1
+                visible_recolor_colors.add(int(color))
+    return {
+        "visible_recolor_segments": visible_recolor_segments,
+        "visible_recolor_colors": len(visible_recolor_colors),
+        "non_teal_trail_cells": int(np.count_nonzero(painted_bg & (out != TEAL))),
+    }
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Launch four square-width rays from the teal source, with segment colors inherited from bounces.
+
+    Input structure:
+    - Top band: a grey legend whose four colored bars encode left/right turn behavior by bar position inside each cell.
+    - Below: the main field with one solid teal square, a uniform background, and several solid colored obstacle rectangles.
+
+    Rule:
+    - Remove the legend in the output.
+    - From the teal square, propagate one square-width ray in each cardinal direction.
+    - The first segment is teal; whenever the next move would hit an obstacle of color C, turn according to the legend and make all later painted cells use color C until another obstacle is hit.
+    - Obstacles are never overwritten, and rays stop when their next square step would leave the grid.
+
+    Key insight: The legend still controls only the turning direction, while the obstacle color itself becomes the paint color for the next trajectory segment after each bounce.
+    """
+    g = np.asarray(grid, dtype=int)
+
+    legend_bg = LEGEND_BG
+    rows_with_legend = np.where(np.any(g == legend_bg, axis=1))[0]
+    assert rows_with_legend.size, "legend rows must be present"
+    legend_h = int(rows_with_legend.max() + 1)
+    assert np.array_equal(
+        rows_with_legend, np.arange(legend_h)
+    ), "legend color must be confined to the top band"
+
+    legend_turn = _parse_legend(g, legend_h)
+    base = g[legend_h:, :].copy()
+    assert base.size, "main grid must remain after legend crop"
+
+    vals, counts = np.unique(base, return_counts=True)
+    bg = int(vals[counts.argmax()])
+    out, _hits, _stats = _simulate_paths(
+        base,
+        legend_turn,
+        bg,
+        inherit_colors=True,
+        strict_trail_conflicts=False,
+    )
+    return out
+
+
+def _choose_span(
+    axis_len: int,
+    required: list[tuple[int, int]],
+    excluded: list[tuple[int, int]],
+    min_len: int,
+    max_len: int,
+) -> tuple[int, int] | None:
+    """Pick a span covering all required intervals while missing all excluded intervals."""
+    req0 = min(a for a, _ in required)
+    req1 = max(b for _, b in required)
+    lo = max(min_len, req1 - req0 + 1)
+    hi = min(max_len, axis_len)
+    choices: list[tuple[int, int, int]] = []
+    for length in range(lo, hi + 1):
+        start0 = max(0, req1 - length + 1)
+        start1 = min(req0, axis_len - length)
+        for start in range(start0, start1 + 1):
+            end = start + length - 1
+            if all(end < a or start > b for a, b in excluded):
+                choices.append((length, start, end))
+    if not choices:
+        return None
+
+    lengths = sorted({length for length, _, _ in choices})
+    if random.random() < SPAN_COMPACT_PROB:
+        cutoff = lengths[min(len(lengths) - 1, max(0, len(lengths) // 2))]
+        pool = [(start, end) for length, start, end in choices if length <= cutoff]
+    else:
+        pool = [(start, end) for _, start, end in choices]
+    return random.choice(pool)
+
+
+def _make_legend(legend_colors: list[int], turns: dict[int, str]) -> np.ndarray:
+    """Build the 6x24 legend band from four colors and their turn assignments."""
+    legend = np.full((LEGEND_H, GRID_W), LEGEND_BG, dtype=int)
+    for start, color in zip(LEGEND_CELL_STARTS, legend_colors, strict=False):
+        legend[1:5, start : start + 4] = 0
+        bar_col = start if turns[color] == "L" else start + 3
+        legend[1:5, bar_col] = color
+    return legend
+
+
+def _rand_thickness(lo: int, hi: int) -> int | None:
+    return random.randint(lo, hi) if hi >= lo else None
+
+
+def _thickness_pair(
+    axis: int, sz: int, a_present: bool, b_present: bool
+) -> tuple[int | None, int | None] | None:
+    """Compute obstacle thicknesses for the two ends of one axis."""
+    lo, hi_cap = OBS_THICKNESS_RANGE
+    if a_present and b_present:
+        room = axis - sz - OBS_BOTH_GAP
+        if room < 2 * lo:
+            return None
+        a = random.randint(lo, min(hi_cap, room - lo))
+        b = _rand_thickness(lo, min(hi_cap, room - a))
+        return (a, b) if b is not None else None
+    if a_present:
+        t = _rand_thickness(lo, min(hi_cap, axis - sz - OBS_SINGLE_MARGIN))
+        return (t, None) if t is not None else None
+    if b_present:
+        t = _rand_thickness(lo, min(hi_cap, axis - sz - OBS_SINGLE_MARGIN))
+        return (None, t) if t is not None else None
+    return None, None
+
+
+def _obstacle_rect(
+    side: int, thickness: int, span: tuple[int, int], h: int, w: int
+) -> tuple[int, int, int, int]:
+    """Return (r0, r1, c0, c1) for an edge-touching obstacle rectangle."""
+    s0, s1 = span
+    if side == _N:
+        return 0, thickness - 1, s0, s1
+    if side == _S:
+        return h - thickness, h - 1, s0, s1
+    if side == _W:
+        return s0, s1, 0, thickness - 1
+    return s0, s1, w - thickness, w - 1
