+ASYMMETRIC_CLASSES = _asymmetric_shape_classes()
+ROT_OPS = ((1, False), (2, False), (3, False))
+FLIP_OPS = ((0, True), (1, True), (2, True), (3, True))
+NON_IDENTITY_OPS = ROT_OPS + FLIP_OPS
