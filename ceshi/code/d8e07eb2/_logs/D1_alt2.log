+    complete_query = len(query_keys) == len(col_starts)
+    same_row = len({r for r, _c in selected}) == 1
+    same_col = len({c for _r, c in selected}) == 1
+    success = complete_query and len(selected) == len(query_keys) and (same_row or same_col)
+
+    if success:
