+# --------------- generator (o5x) ---------------
+
+# -- Grid layout --
+GRID_H, GRID_W = 30, 22
+TOP_SEP_ROW = 5
+BOTTOM_SEP_ROW = 27
+QUERY_BAND_H = 5
+VERDICT_ROW = 28
