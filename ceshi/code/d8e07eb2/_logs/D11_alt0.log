+# spec_variant:
+#   input:
+#     same_as_original: true
+#     grid: 30 x 22
+#     layout:
+#       - rows 0..4: query band, up to 4 copied glyph cells
+#       - row 5: separator
+#       - row 6: empty bg spacer
+#       - rows 7..26, cols 1..20: 4x4 table of 5x5 cells
+#       - row 27: separator
