+def _forms_2x2_block(cells: list[tuple[int, int]] | set[tuple[int, int]]) -> bool:
+    cells = {(int(r), int(c)) for r, c in cells}
+    if len(cells) != 4:
+        return False
+    rows = sorted({r for r, _c in cells})
+    cols = sorted({c for _r, c in cells})
+    return (
+        len(rows) == 2
+        and len(cols) == 2
+        and rows[1] == rows[0] + 1
+        and cols[1] == cols[0] + 1
+    )
+
