+# --------------- generator (o5x) ---------------
+
+# -- Grid layout --
+GRID_H, GRID_W = 30, 22
+TOP_SEP_ROW = 5
+BOTTOM_SEP_ROW = 27
+QUERY_BAND_H = 5
+VERDICT_ROW = 28
+
+# -- Colors --
+BG = 8
+GREEN = 3
+RED = 2
+SEP = 6
+GLYPH_COLORS = (0, 1, 2, 4, 5, 6, 7, 9)
