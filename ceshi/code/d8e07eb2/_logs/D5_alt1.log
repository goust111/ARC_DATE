+    bits = np.array([(mask >> i) & 1 for i in range(9)], dtype=bool).reshape(3, 3)
+    cell[1:4, 1:4][bits] = color
+    return cell
+
+
+def _block_cells() -> list[tuple[int, int]]:
+    top = random.randrange(TABLE_DIM - 1)
+    left = random.randrange(TABLE_DIM - 1)
