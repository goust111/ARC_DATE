+# --------------- generator (o5x) ---------------
+
+# -- Grid layout --
+GRID_H, GRID_W = 30, 22
+TOP_SEP_ROW = 5
+BOTTOM_SEP_ROW = 27
+QUERY_BAND_H = 5
+VERDICT_ROW = 28
+
+# -- Colors --
+BG = 8
+GREEN = 3
+RED = 2
+SEP = 6
+GLYPH_COLORS = (0, 1, 2, 4, 5, 6, 7, 9)
+
+# -- Table geometry --
+TABLE_DIM = 4
+CELL = 5
+ROWS = (7, 12, 17, 22)
+COLS = (1, 6, 11, 16)
+
+# -- Glyph shape --
+FILL_MIN, FILL_MAX = 5, 9
+SHAPE_BASE_COUNTS = {5: 2, 6: 2, 7: 2, 8: 2, 9: 1}
+MAX_SHAPES_PER_FILL = 5
+
+# -- Color distribution --
+COLOR_MIN, COLOR_MAX = 1, 3
+
+# -- Outcome probabilities --
+P_SUCCESS = 0.5
+P_QUERY_3 = 0.35
+FAIL_MODES = ("row", "row", "col", "col", "off_main", "off_anti", "rect", "perm")
+
