+SHAPE_BASE_COUNTS = {5: 2, 6: 2, 7: 2, 8: 2, 9: 1}
+MAX_SHAPES_PER_FILL = 5
+
+# -- Color distribution --
+COLOR_MIN, COLOR_MAX = 1, 3
+
+# -- Outcome probabilities --
+P_SUCCESS = 0.4
+P_QUERY_3 = 0.35
