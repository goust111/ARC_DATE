+    lengths = []
+    for row, blue_count, base_color, side in zip(
+        rows,
+        blues,
+        base_colors,
+        ((first_side + i) % 2 for i in range(count)),
+    ):
+        bounds = _length_bounds(cross_size, blue_count)
+        if bounds is None:
+            return None
+        length = random.randint(*bounds)
+        lengths.append(length)
