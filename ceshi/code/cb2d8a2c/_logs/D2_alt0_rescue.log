+    slack = main_size - _min_main_len(blues)
+    if slack < 0:
+        return None
+
+    path_lo = max(max(blues) + 3, cross_size // 2)
+    path_hi = min(cross_size - 3, cross_size // 2 + 3)
+    if path_lo > path_hi:
+        return None
+    path_col = random.randint(path_lo, path_hi)
+
+    extras = _random_composition(slack, count + 1)
