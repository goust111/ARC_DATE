+    if sr == 0:
+        return sr, sc, 2, "row", g.shape[0] - 1
+    if sr == g.shape[0] - 1:
+        return sr, sc, 0, "row", 0
+    if sc == 0:
+        return sr, sc, 1, "col", g.shape[1] - 1
+    if sc == g.shape[1] - 1:
