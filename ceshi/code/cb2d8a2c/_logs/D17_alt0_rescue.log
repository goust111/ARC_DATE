+        out = main(inp)
+        if not _reaches_opposite_edge(out, edge):
+            return None
+        if _variant_score(inp, out) == 0:
+            return None
+        if not np.array_equal(main(inp), out):
+            return None
+    except Exception:
+        return None
+    return inp
+
