+        across = (top_row, safe_col)
+        below = (bottom_row, safe_col)
+
+        path_cells.extend(_iter_line(current, above)[1:])
+        path_cells.extend(_iter_line(above, across)[1:])
+        path_cells.extend(_iter_line(across, below)[1:])
