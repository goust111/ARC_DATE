+        if side == 0:
+            _paint_rect_on_bg(out, top_row, bottom_row, safe_col, safe_col + blue - 1)
+        else:
+            _paint_rect_on_bg(out, top_row, bottom_row, safe_col - blue + 1, safe_col)
