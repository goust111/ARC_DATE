+    for r, c in path_cells:
+        if out[r, c] == BG:
+            out[r, c] = GREEN
+
+    out[out == BLUE] = RED
+    return _from_canonical(out, edge)
+
+
+def _min_main_len(blues: tuple[int, ...]) -> int:
+    """Minimum canonical main-axis size that supports the thicker bypass strips."""
