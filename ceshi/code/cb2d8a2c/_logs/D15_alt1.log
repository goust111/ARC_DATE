+# Variant of cb2d8a2c
+# Dimension: D15 — 路径与障碍条的交互效果 (transform)
+# Change: 路径不接触障碍条，只在距离约束范围外通过；蓝色像素事后统一变为红色... → 路径在距离边界处涂上不同颜色标记
+
+import heapq
+import itertools
+import random
+from collections import deque
+
+import numpy as np
+
+from arc_utils import components_mask, neighbors4
+
+
+# ---------------------------------------------------------------------------
+# Design analysis for the D15 variant
+# ---------------------------------------------------------------------------
+# variant_spec:
+#   core_change:
+#     original: output only shows the safe path in green; the keep-out boundary
+#       is implicit.
+#     variant: output must also expose where the distance constraint becomes
+#       active. We paint the path's detour segments on the exact safe boundary
+#       in yellow.
+#   concrete_behavior:
+#     - Input stays the same as the base task: azure background, red/blue bars,
+#       one green border start.
+#     - Output still contains the routed path and converts all blue pixels to
+#       red.
+#     - New visible effect: whenever the path must leave the main travel axis
+#       to skirt a bar, that whole turn row/column is painted yellow instead of
+#       green. Vertical-travel instances therefore get horizontal yellow bands;
+#       horizontal-travel instances get vertical yellow bands.
+#   behavior_trace:
+#     - Base task, top-start example: the path descends until the first bar's
+#       forbidden halo blocks the next step, moves sideways along the unique
+#       closest safe row, then continues downward.
+#     - Variant: the same row is now colored yellow because every cell on that
+#       sideways run lies exactly one cell beyond the forbidden radius. The
+#       downward segments remain green.
+#     - Difference: the solver must not merely find a route; it must classify
+#       which routed cells belong to boundary-following detours.
+#   complexity_calibration:
+#     - We use one extra color only: yellow(4).
+#     - The mark repeats once per obstacle bar, so 2-4 examples are enough for
+#       a human to notice the consistent correspondence "one obstacle => one
+#       yellow detour segment".
+#     - We avoid more complicated per-bar color mappings or mixed marker types.
+#   implicit_assumptions_checked:
+#     - The original `blocked` logic still holds: the path itself must not enter
+#       the forbidden halo.
+#     - The original shortest-path search is kept unchanged, because the variant
+#       changes only the rendering of the chosen route.
+#     - The old unconditional `out[out == BLUE] = RED` remains safe because the
+#       new yellow marks are only painted onto former background cells.
+#     - New assumption: each bar forces one distinct cross-axis detour segment.
+#       The generator already alternates wall attachments and spaces bars so the
+#       shortest route has one visible detour per bar; validation below enforces
+#       that by checking the yellow component count.
+#   placement_legality:
+#     - Bars still obey the original length and spacing constraints.
+#     - Start placement remains inside the first bar's covered span so the path
+#       cannot go straight; this guarantees the new marker is exercised.
+#     - The solver paints yellow only on path cells that were background in the
+#       input, so no overlaps with bars or the start marker occur.
+#   visual_observability:
+#     - Yellow appears as clean straight segments separated by green axial runs.
+#     - The number of yellow segments matches the number of obstacle bars,
+#       making the new interaction readable from examples without hidden state.
+#   visual_cleanliness:
+#     - There is no multi-layer clutter: bars stay red in the output, the route
+#       uses green/yellow, and the background stays azure.
+#   color_inference:
+#     - The only new color is yellow, always attached to the path's sideways
+#       boundary-following motion. The consistent location cue makes the color
+#       change inferable from few examples.
+
+
+_DIRS_URDL = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+
+BG = 8
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+
+
+def _path_and_dirs(
+    prev: dict[tuple[int, int, int], tuple[int, int, int]],
+    goal_state: tuple[int, int, int],
+    start: tuple[int, int],
+) -> tuple[list[tuple[int, int]], list[tuple[int, int]]]:
+    """Reconstruct the cell path and per-step direction vectors."""
+    path: list[tuple[int, int]] = []
+    st = goal_state
+    while True:
+        r, c, _ = st
+        path.append((r, c))
+        if (r, c) == start:
+            break
+        st = prev[st]
+    path.reverse()
+
+    step_dirs: list[tuple[int, int]] = []
+    for (r0, c0), (r1, c1) in zip(path, path[1:]):
+        step_dirs.append((r1 - r0, c1 - c0))
+    return path, step_dirs
+
+
+def _boundary_mark_cells(
+    path: list[tuple[int, int]],
+    step_dirs: list[tuple[int, int]],
+    main_axis: str,
+) -> set[tuple[int, int]]:
+    """
+    Cells that lie on the detour segments.
+
+    In this task family, the path's cross-axis runs are exactly the rows/columns
+    where it follows the outer edge of a bar's keep-out halo.
+    """
+    marked: set[tuple[int, int]] = set()
+    for i, (dr, dc) in enumerate(step_dirs):
+        is_cross_axis = (dc != 0) if main_axis == "vertical" else (dr != 0)
+        if is_cross_axis:
+            marked.add(path[i])
+            marked.add(path[i + 1])
+    return marked
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Route a green path across the grid and highlight the exact detour boundary in yellow.
+
+    Input structure:
+    - bg = azure (8). Red/blue bars (2/1) are 1-cell-thick obstacles attached to alternating side walls.
+    - A single green (3) pixel lies on one border edge and serves as the path start.
+
+    Rule:
+    - Each obstacle bar has a keep-out radius equal to its blue-pixel count; the route must stay strictly outside that Manhattan-distance halo.
+    - The start extends to the opposite edge using the shortest valid orthogonal path, with right-angle detours around the bars.
+    - Cells on the detour row/column where the route rides the exact safe boundary are painted yellow (4), the remaining routed bg cells are green, and all blue bar pixels become red.
+
+    Key insight: The bars still encode how far the route must stay away, but the output now makes that encoded distance visible by coloring the boundary-following detours differently from the axial path segments.
+    """
+    g = np.array(grid, copy=True)
+    h, w = g.shape
+    dirs = _DIRS_URDL  # U, R, D, L
+
+    start_pts = np.argwhere(g == GREEN)
+    assert start_pts.shape[0] == 1, "grid must contain exactly one green start pixel"
+    sr, sc = map(int, start_pts[0])
+
+    if sr == 0:
+        init_dir = 2
+        goal_kind, goal_val = "row", h - 1
+        main_axis = "vertical"
+    elif sr == h - 1:
+        init_dir = 0
+        goal_kind, goal_val = "row", 0
+        main_axis = "vertical"
+    elif sc == 0:
+        init_dir = 1
+        goal_kind, goal_val = "col", w - 1
+        main_axis = "horizontal"
+    elif sc == w - 1:
+        init_dir = 3
+        goal_kind, goal_val = "col", 0
+        main_axis = "horizontal"
+    else:
+        raise AssertionError("green start must be on a border edge")
+
+    def is_goal(r: int, c: int) -> bool:
+        return (r == goal_val) if goal_kind == "row" else (c == goal_val)
+
+    bar_mask = (g == BLUE) | (g == RED)
+    bar_comps = components_mask(bar_mask, connectivity=4)
+
+    forbidden = np.zeros((h, w), dtype=bool)
+    for comp in bar_comps:
+        blue_count = sum(1 for r, c in comp if g[r, c] == BLUE)
+        radius = int(blue_count)
+
+        dist = np.full((h, w), -1, dtype=np.int16)
+        q = deque()
+        for r, c in comp:
+            dist[r, c] = 0
+            q.append((r, c))
+
+        while q:
+            r, c = q.popleft()
+            d = int(dist[r, c])
+            forbidden[r, c] = True
+            if d == radius:
+                continue
+            for rr, cc in neighbors4(r, c):
+                if 0 <= rr < h and 0 <= cc < w and dist[rr, cc] == -1:
+                    dist[rr, cc] = d + 1
+                    q.append((rr, cc))
+
+    blocked = bar_mask | forbidden
+    blocked[sr, sc] = False
+
+    INF = (10**9, 10**9)
+    best_cost: dict[tuple[int, int, int], tuple[int, int]] = {(sr, sc, init_dir): (0, 0)}
+    prev: dict[tuple[int, int, int], tuple[int, int, int]] = {}
+    heap: list[tuple[tuple[int, int], int, int, int]] = [((0, 0), sr, sc, init_dir)]
+
+    goal_state: tuple[int, int, int] | None = None
+    while heap:
+        (steps, turns), r, c, dprev = heapq.heappop(heap)
+        if (steps, turns) != best_cost.get((r, c, dprev), INF):
+            continue
+        if is_goal(r, c) and (r, c) != (sr, sc):
+            goal_state = (r, c, dprev)
+            break
+        for nd, (dr, dc) in enumerate(dirs):
+            rr, cc = r + dr, c + dc
+            if not (0 <= rr < h and 0 <= cc < w):
+                continue
+            if blocked[rr, cc]:
+                continue
+            ncost = (steps + 1, turns + (0 if nd == dprev else 1))
+            key = (rr, cc, nd)
+            if ncost < best_cost.get(key, INF):
+                best_cost[key] = ncost
+                prev[key] = (r, c, dprev)
+                heapq.heappush(heap, (ncost, rr, cc, nd))
+
+    out = g.copy()
+    assert goal_state is not None, "a valid path to the opposite edge must exist"
+    path, step_dirs = _path_and_dirs(prev, goal_state, (sr, sc))
+    mark_cells = _boundary_mark_cells(path, step_dirs, main_axis)
+
+    for r, c in path:
+        if out[r, c] == BG:
+            out[r, c] = GREEN
+    for r, c in mark_cells:
+        if g[r, c] == BG:
+            out[r, c] = YELLOW
+
+    out[out == BLUE] = RED
+    return out
+
+
+# --------------- generator ---------------
+
+# --- Tunable parameters (same spatial envelope as base task) ---
+ROWS_LO, ROWS_HI = 12, 29
+COLS_LO, COLS_HI = 13, 26
+BAR_COUNT_LO, BAR_COUNT_HI = 1, 4
+BLUE_PER_BAR_LO, BLUE_PER_BAR_HI = 1, 4
+BAR_LEN_MIN, BAR_LEN_MAX = 6, 15
+BAR_CROSS_PCT_LO, BAR_CROSS_PCT_HI = 32, 79
+MAX_GEN_RETRIES = 300
+
+
+def _min_main_len(blues: tuple[int, ...]) -> int:
+    """Minimum main-axis size to fit all bars with the required gaps."""
+    last_bar = blues[0] + 2
+    for a, b in zip(blues, blues[1:]):
+        last_bar += a + b + 2
+    return last_bar + 2
+
+
+def _random_composition(total: int, parts: int) -> list[int]:
+    """Distribute `total` into `parts` non-negative integers uniformly."""
+    if parts == 1:
+        return [total]
+    cuts = sorted(random.sample(range(total + parts - 1), parts - 1))
+    out = []
+    prev = -1
+    for cut in cuts + [total + parts - 1]:
+        out.append(cut - prev - 1)
+        prev = cut
+    return out
+
+
+def _choose_blues(count: int, main_hi: int) -> tuple[int, ...]:
+    """Pick blue counts per bar such that the full layout can fit."""
+    choices = [
+        combo
+        for combo in itertools.product(range(BLUE_PER_BAR_LO, BLUE_PER_BAR_HI + 1), repeat=count)
+        if _min_main_len(combo) <= main_hi
+    ]
+    return random.choice(choices)
+
+
+def _length_bounds(cross_size: int, blue_count: int) -> tuple[int, int] | None:
+    """Valid bar length range given cross-axis size and blue count."""
+    lo = max(BAR_LEN_MIN, 2 * blue_count - 1, (BAR_CROSS_PCT_LO * cross_size + 99) // 100)
+    hi = min(BAR_LEN_MAX, cross_size - blue_count - 1, (BAR_CROSS_PCT_HI * cross_size) // 100)
+    if lo > hi:
+        return None
+    return lo, hi
+
+
+def _paint_bar(grid: np.ndarray, row: int, side: int, length: int, blue_count: int) -> None:
+    """Paint a single canonical horizontal bar on `row` from the chosen wall side."""
+    w = grid.shape[1]
+    colors = np.full(length, RED, dtype=int)
+    colors[: 2 * blue_count - 1 : 2] = BLUE
+    if side == 0:
+        grid[row, :length] = colors
+    else:
+        grid[row, w - length :] = colors[::-1]
+
+
+def _canonical_grid(
+    main_size: int,
+    cross_size: int,
+    blues: tuple[int, ...],
+    first_side: int,
+) -> np.ndarray | None:
+    """Build the grid in canonical orientation (start edge = top, path goes down)."""
+    count = len(blues)
+    slack = main_size - _min_main_len(blues)
+    if slack < 0:
+        return None
+
+    extras = _random_composition(slack, count + 1)
+    row = blues[0] + 2 + extras[0]
+    rows = [row]
+    for i in range(1, count):
+        row += blues[i - 1] + blues[i] + 2 + extras[i]
+        rows.append(row)
+
+    grid = np.full((main_size, cross_size), BG, dtype=int)
+    lengths = []
+    for row, blue_count, side in zip(rows, blues, ((first_side + i) % 2 for i in range(count))):
+        bounds = _length_bounds(cross_size, blue_count)
+        if bounds is None:
+            return None
+        length = random.randint(*bounds)
+        lengths.append(length)
+        _paint_bar(grid, row, side, length, blue_count)
+
+    first_len = lengths[0]
+    if first_side == 0:
+        start_col = random.randint(1, first_len - 1)
+    else:
+        start_col = random.randint(cross_size - first_len, cross_size - 2)
+    grid[0, start_col] = GREEN
+    return grid
+
+
+def _orient_grid(grid: np.ndarray, edge: str) -> np.ndarray:
+    """Rotate the canonical top-start grid so the real start edge matches `edge`."""
+    if edge == "top":
+        return grid.copy()
+    if edge == "bottom":
+        return np.flipud(grid).copy()
+    if edge == "left":
+        return grid.T.copy()
+    return np.fliplr(grid.T).copy()
+
+
+def _reaches_opposite_edge(out: np.ndarray, edge: str) -> bool:
+    """Check whether the solved output reaches the opposite edge with path colors."""
+    path_cols = (GREEN, YELLOW)
+    if edge == "top":
+        return bool(np.any(np.isin(out[-1, :], path_cols)))
+    if edge == "bottom":
+        return bool(np.any(np.isin(out[0, :], path_cols)))
+    if edge == "left":
+        return bool(np.any(np.isin(out[:, -1], path_cols)))
+    return bool(np.any(np.isin(out[:, 0], path_cols)))
+
+
+def _yellow_component_count(out: np.ndarray) -> int:
+    return len(components_mask(out == YELLOW, connectivity=4))
+
+
+def _gen_attempt() -> np.ndarray | None:
+    """Single generation attempt: build, solve, and validate the D15 marker behavior."""
+    edge = random.choice(("top", "bottom", "left", "right"))
+    if edge in ("top", "bottom"):
+        main_lo, main_hi = ROWS_LO, ROWS_HI
+        cross_lo, cross_hi = COLS_LO, COLS_HI
+    else:
+        main_lo, main_hi = COLS_LO, COLS_HI
+        cross_lo, cross_hi = ROWS_LO, ROWS_HI
+
+    count = random.randint(BAR_COUNT_LO, BAR_COUNT_HI)
+    blues = _choose_blues(count, main_hi)
+    main_size = random.randint(max(main_lo, _min_main_len(blues)), main_hi)
+    cross_size = random.randint(cross_lo, cross_hi)
+    first_side = random.randrange(2)
+
+    canonical = _canonical_grid(main_size, cross_size, blues, first_side)
+    if canonical is None:
+        return None
+    inp = _orient_grid(canonical, edge)
+
+    try:
+        out = main(inp)
+        if not _reaches_opposite_edge(out, edge):
+            return None
+        if not np.any(out == YELLOW):
+            return None
+        if _yellow_component_count(out) != count:
+            return None
+        if not np.array_equal(main(inp), out):
+            return None
+    except Exception:
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid cb2d8a2c D15 input")

