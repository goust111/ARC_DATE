+        MARKER_PREFIX_LEN,
+        (BAR_CROSS_PCT_LO * cross_size + 99) // 100,
+    )
+    hi = min(
+        BAR_LEN_MAX,
+        cross_size - radius - 1,
+        (BAR_CROSS_PCT_HI * cross_size) // 100,
+    )
