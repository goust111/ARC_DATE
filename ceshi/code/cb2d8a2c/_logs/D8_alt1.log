+_DIRS_URDL = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+
+BG = 8
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+PINK = 6
+ORANGE = 7
+
+MARKER_TO_RADIUS = {
+    YELLOW: 1,
+    BLUE: 2,
+    PINK: 3,
+    ORANGE: 4,
+}
+RADIUS_TO_MARKER = {radius: color for color, radius in MARKER_TO_RADIUS.items()}
