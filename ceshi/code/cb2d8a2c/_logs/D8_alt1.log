+ROWS_LO, ROWS_HI = 12, 29
+COLS_LO, COLS_HI = 13, 26
+BAR_COUNT_LO, BAR_COUNT_HI = 1, 4
+RADIUS_LO, RADIUS_HI = 1, 4
+BAR_LEN_MIN, BAR_LEN_MAX = 6, 15
