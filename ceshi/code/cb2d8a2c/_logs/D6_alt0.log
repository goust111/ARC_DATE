+def _target_orders(w: int, last_side: int) -> list[list[int]]:
+    mid = w // 2
+    if last_side == 0:
+        preferred = list(range(mid, 0, -1))
+        alternate = list(range(mid + 1, w - 1))
+    else:
+        preferred = list(range(mid, w - 1))
+        alternate = list(range(mid - 1, 0, -1))
+    return [preferred, alternate]
