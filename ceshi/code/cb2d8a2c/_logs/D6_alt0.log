def start_edge(grid):
    sr, sc = map(int, np.argwhere(grid == variant.GREEN)[0])
    h, w = grid.shape
    if sr == 0:
        return 'top'
    if sr == h - 1:
        return 'bottom'
    if sc == 0:
        return 'left'
    return 'right'


def last_bar_info(grid, edge):
    comps = components_mask((grid == variant.BLUE) | (grid == variant.RED), connectivity=4)
    scored = []
    for comp in comps:
        blue = sum(1 for r, c in comp if grid[r, c] == variant.BLUE)
        rs = [int(r) for r, _ in comp]
        cs = [int(c) for _, c in comp]
        scored.append((comp, blue, min(rs), max(rs), min(cs), max(cs)))
    if edge == 'top':
        comp, blue, r0, r1, c0, c1 = max(scored, key=lambda x: x[3])
        return ('vertical', r1 + blue + 1)
    if edge == 'bottom':
        comp, blue, r0, r1, c0, c1 = min(scored, key=lambda x: x[2])
        return ('vertical', r0 - blue - 1)
    if edge == 'left':
        comp, blue, r0, r1, c0, c1 = max(scored, key=lambda x: x[5])
        return ('horizontal', c1 + blue + 1)
    comp, blue, r0, r1, c0, c1 = min(scored, key=lambda x: x[4])
    return ('horizontal', c0 - blue - 1)


def guided_suffix(path, edge, clear):
    for (r1, c1), (r2, c2) in zip(path, path[1:]):
        if edge == 'top' and min(r1, r2) >= clear and c1 "'!= c2:
            return True
        if edge == '"'bottom' and max(r1, r2) <= clear and c1 "'!= c2:
            return True
        if edge == '"'left' and min(c1, c2) >= clear and r1 "'!= r2:
            return True
        if edge == '"'right' and max(c1, c2) <= clear and r1 "'!= r2:
            return True
    return False

n = 100
edge_counts = {'"'top':0,'bottom':0,'left':0,'right':0}
interior_targets = 0
diff_from_original = 0
orig_fail = 0
guided = 0
edge_distance_sum = 0
for _ in range(n):
    inp = variant.generate_input()
    out = variant.main(inp)
    path = variant._solve_path(inp)
    edge = start_edge(inp)
    edge_counts[edge] += 1
    tr, tc = map(int, np.argwhere(inp == variant.TARGET)[0])
    h, w = inp.shape
    if 0 < tr < h-1 and 0 < tc < w-1:
        interior_targets += 1
    axis, clear = last_bar_info(inp, edge)
    if guided_suffix(path, edge, clear):
        guided += 1
    if edge == 'top':
        edge_distance_sum += (h - 1 - tr)
    elif edge == 'bottom':
        edge_distance_sum += tr
    elif edge == 'left':
        edge_distance_sum += (w - 1 - tc)
    else:
        edge_distance_sum += tc
    try:
        old = orig.main(inp)
        if not np.array_equal(old, out):
            diff_from_original += 1
    except Exception:
        orig_fail += 1

print('edge_counts', edge_counts)
print('interior_targets', interior_targets, '/', n)
print('guided_suffix', guided, '/', n)
print('diff_from_original', diff_from_original, '/', n)
print('orig_fail', orig_fail, '/', n)
print('avg_distance_to_old_edge_goal', round(edge_distance_sum / n, 2))
