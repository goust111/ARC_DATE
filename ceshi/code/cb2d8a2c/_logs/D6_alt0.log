+def _has_horizontal_suffix(path: list[tuple[int, int]], clear_row: int) -> bool:
+    for (r1, c1), (r2, c2) in zip(path, path[1:]):
+        if min(r1, r2) >= clear_row and c1 != c2:
+            return True
+    return False
