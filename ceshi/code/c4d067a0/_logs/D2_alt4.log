   164	    win_c = min(w, 12)
   165	    legend = [(r, c, col) for (r, c, col) in singles if r < win_r and c < win_c]
   166	    assert legend, "top-left legend must contain singleton markers"
   167	
   168	    rects = _legend_rectangles(legend)
   169	    legend_cells = _expand_rectangles(rects)
   170	
   171	    sizes = [s for _, _, s, _ in blocks]
   172	    vals, cnts = np.unique(np.array(sizes, dtype=int), return_counts=True)
   173	    block_size = int(vals[cnts.argmax()])
