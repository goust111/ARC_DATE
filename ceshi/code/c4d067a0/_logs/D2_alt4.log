   195	                bases[base] = bases.get(base, 0) + 1
   196	    assert bases, "visible blocks must determine a base offset"
   197	    max_votes = max(bases.values())
   198	    best_bases = [base for base, votes in bases.items() if votes == max_votes]
   199	    assert len(best_bases) == 1, "legend-to-grid offset must be unique"
