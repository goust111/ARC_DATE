+        arr[r0 : r0 + size, c0 : c0 + size] = col
+        return
+    arr[r0 : r0 + size, c0 : c0 + size] = bg
+    arr[r0, c0 : c0 + size] = col
+    arr[r0 + size - 1, c0 : c0 + size] = col
+    arr[r0 : r0 + size, c0] = col
+    arr[r0 : r0 + size, c0 + size - 1] = col
+
