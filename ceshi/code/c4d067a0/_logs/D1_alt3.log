+    lr0, lc0 = LEGEND_ORIGIN
+    out = np.full((size, size), bg, dtype=int)
+    for (rr, cc), col in legend_colors.items():
+        out[lr0 + rr * LEGEND_STEP, lc0 + cc * LEGEND_STEP] = col
+    for (rr, cc), col in rotated_colors.items():
