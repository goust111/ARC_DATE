   164	        by_color.setdefault(int(col), []).append((int(r0), int(c0)))
   165	
   166	    votes: dict[tuple[int, int, int], int] = {}
   167	    rotated_by_k: dict[int, list[tuple[int, int, int]]] = {}
   168	    for k in (1, 2, 3):
   169	        rotated_pts = _rotate_legend_points(legend_pts, k)
   170	        rotated_by_k[k] = rotated_pts
