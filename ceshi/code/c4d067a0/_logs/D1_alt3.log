   176	                votes[key] = votes.get(key, 0) + 1
   177	
   178	    assert votes, "existing blocks must determine the rotated legend projection"
   179	    max_votes = max(votes.values())
   180	    best = [key for key, count in votes.items() if count == max_votes]
   181	    assert len(best) == 1, "rotation and base offset must be uniquely determined"
   182	    rot_k, base_r, base_c = best[0]
   183	
