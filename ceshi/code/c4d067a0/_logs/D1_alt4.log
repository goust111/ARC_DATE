+# === CFG: block area ===
+BLOCK_SIZE_RANGE = range(2, 5)
+GAP_RANGE = range(1, 4)
+STEP_MIN, STEP_MAX = 3, 5
+BASE_C_MIN = 8
+BASE_R_MIN = 1
