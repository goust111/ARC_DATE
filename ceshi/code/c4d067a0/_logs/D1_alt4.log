+NUM_COLORS = 10
+
+# === CFG: legend lattice ===
+LEGEND_ORIGIN = (1, 1)
+LEGEND_STEP = 2
+LEGEND_ROWS = (3, 4)
+LEGEND_COLS = (2, 3)
+LEGEND_EMPTIES = (0, 1, 2)
+LEGEND_FILLED_MIN, LEGEND_FILLED_MAX = 6, 10
+PALETTE_SIZE_MIN, PALETTE_SIZE_MAX = 2, 4
+MAX_COUNT_PER_COLOR = 6
+
+# === CFG: block area ===
+BLOCK_SIZE_RANGE = range(2, 5)
+GAP_RANGE = range(1, 4)
+STEP_MIN, STEP_MAX = 3, 5
+BASE_C_MIN = 8
+BASE_R_MIN = 1
+
+# === CFG: generation ===
+MAX_RETRIES = 300
+MIRROR_MODES = ("h", "v")
