+def _random_color_counts(total: int, k: int) -> list[int]:
+    """Distribute `total` cells among `k` colors, each count in [1, MAX_COUNT_PER_COLOR]."""
+    counts = [1] * k
+    remaining = total - k
+    while remaining:
