+    sub = g[r0 : r1 + 1, c0 : c1 + 1]
+    col = int(sub[0, 0])
+    if col == bg:
+        return None
+    if np.all(sub == col) and sub.size == len(pts):
+        return int(r0), int(c0), int(hh), col
+    return None
+
+
+def _find_scale_bar(g: np.ndarray, comps: list[np.ndarray], bg: int):
