+def _random_color_counts(total, k):
+    counts = [1] * k
+    remaining = total - k
+    while remaining:
+        open_idxs = [i for i, v in enumerate(counts) if v < MAX_COUNT_PER_COLOR]
+        i = random.choice(open_idxs)
+        add = random.randint(1, min(remaining, MAX_COUNT_PER_COLOR - counts[i]))
+        counts[i] += add
+        remaining -= add
