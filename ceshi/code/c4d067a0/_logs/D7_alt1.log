+def _solid_square_info(g: np.ndarray, pts: np.ndarray, bg: int):
+    if len(pts) < 4:
+        return None
+    r0, c0, r1, c1 = bbox_coords(pts)
+    hh, ww = r1 - r0 + 1, c1 - c0 + 1
+    if hh != ww:
