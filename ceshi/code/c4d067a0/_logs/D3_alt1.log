    57	def main(grid: np.ndarray) -> np.ndarray:
    58	    """
    59	    Repeat a legend-defined block template across a periodic macro-tile grid.
    60	
    61	    Input structure:
    62	    - bg = most common color.
    63	    - Top-left corner: a sparse legend of singleton colored pixels on a regular lattice; these pixels describe one macro-tile's local block layout.
    64	    - Main area: a few uniformly colored square blocks (NxN) already placed on the same block lattice; they reveal block size, block step, and macro-tile phase.
    65	
    66	    Rule:
    67	    - Normalize the legend into lattice coordinates, and treat its bounding box as the row/column span of one repeating macro-tile.
    68	    - Infer the block lattice step from the existing blocks, then infer the macro-tile phase by matching block colors against legend colors modulo the macro-tile period.
    69	    - For every macro-tile that fully fits in the canvas, place an NxN block for every legend pixel at the corresponding local position inside that tile.
    70	
    71	    Key insight: The legend is no longer a one-off minimap of a single block cluster; it is a local template that repeats at a fixed 2D period across the destination lattice.
    72	    """
    73	    g = np.asarray(grid, dtype=int)
    74	    h, w = g.shape
    75	    out = g.copy()
    76	    bg = get_bg(g)
    77	
    78	    comps = components_mask(g != bg, connectivity=4)
    79	    singles: list[tuple[int, int, int]] = []
    80	    blocks: list[tuple[int, int, int, int]] = []  # (r0,c0,size,color)
    81	    for pts in comps:
    82	        if len(pts) == 1:
    83	            r, c = pts[0]
    84	            singles.append((int(r), int(c), int(g[r, c])))
    85	            continue
    86	        r0, c0, r1, c1 = bbox_coords(pts)
    87	        hh, ww = r1 - r0 + 1, c1 - c0 + 1
    88	        if hh != ww or hh < 2:
    89	            continue
    90	        sub = g[r0:r1 + 1, c0:c1 + 1]
    91	        col = int(sub[0, 0])
    92	        if col == bg:
    93	            continue
    94	        if np.all(sub == col) and sub.size == len(pts):
    95	            blocks.append((int(r0), int(c0), int(hh), col))
    96	
    97	    assert singles and blocks, "grid must contain legend pixels and main blocks"
    98	
    99	    win_r = min(h, 12)
   100	    win_c = min(w, 12)
   101	    legend = [(r, c, v) for (r, c, v) in singles if r < win_r and c < win_c]
   102	    assert legend, "top-left legend must contain singleton pixels"
   103	
   104	    rs = sorted({r for r, _, _ in legend})
   105	    cs = sorted({c for _, c, _ in legend})
   106	    drs = [rs[i + 1] - rs[i] for i in range(len(rs) - 1)]
   107	    dcs = [cs[i + 1] - cs[i] for i in range(len(cs) - 1)]
   108	    stepL = reduce(gcd, drs + dcs)
   109	    assert stepL > 0, "legend lattice step must be positive"
   110	    rmin = min(r for r, _, _ in legend)
   111	    cmin = min(c for _, c, _ in legend)
   112	
   113	    legend_pts: list[tuple[int, int, int]] = []
   114	    for r, c, v in legend:
   115	        rr = (r - rmin) // stepL
   116	        cc = (c - cmin) // stepL
   117	        legend_pts.append((int(rr), int(cc), int(v)))
   118	
   119	    tile_rows = max(rr for rr, _, _ in legend_pts) + 1
   120	    tile_cols = max(cc for _, cc, _ in legend_pts) + 1
   121	    max_rr = tile_rows - 1
   122	    max_cc = tile_cols - 1
   123	
   124	    sizes = [s for _, _, s, _ in blocks]
   125	    vals, cnts = np.unique(np.array(sizes, dtype=int), return_counts=True)
   126	    block_size = int(vals[cnts.argmax()])
   127	    blocks = [b for b in blocks if b[2] == block_size]
   128	    assert blocks, "must contain at least one block of the dominant block size"
   129	
   130	    tops = sorted({r0 for r0, _, _, _ in blocks})
   131	    lefts = sorted({c0 for _, c0, _, _ in blocks})
   132	    step_candidates = [tops[i + 1] - tops[i] for i in range(len(tops) - 1)]
   133	    step_candidates += [lefts[i + 1] - lefts[i] for i in range(len(lefts) - 1)]
   134	    assert step_candidates, "existing blocks must reveal the block step"
   135	    step = reduce(gcd, step_candidates)
   136	    assert step > 0, "block step must be positive"
   137	
   138	    period_r = tile_rows * step
   139	    period_c = tile_cols * step
   140	    tile_span_r = max_rr * step + block_size
   141	    tile_span_c = max_cc * step + block_size
   142	
   143	    by_color: dict[int, list[tuple[int, int]]] = {}
   144	    for r0, c0, _, col in blocks:
   145	        by_color.setdefault(int(col), []).append((int(r0), int(c0)))
   146	
   147	    phases: dict[tuple[int, int], int] = {}
   148	    for rr, cc, col in legend_pts:
   149	        if col not in by_color:
   150	            continue
   151	        for br0, bc0 in by_color[col]:
   152	            phase_r = (br0 - rr * step) % period_r
   153	            phase_c = (bc0 - cc * step) % period_c
   154	            phases[(phase_r, phase_c)] = phases.get((phase_r, phase_c), 0) + 1
   155	    assert phases, "existing blocks must determine the macro-tile phase"
   156	    max_votes = max(phases.values())
   157	    best_phases = [phase for phase, votes in phases.items() if votes == max_votes]
   158	    assert len(best_phases) == 1, "macro-tile phase must be unique"
   159	    phase_r, phase_c = best_phases[0]
   160	
   161	    row_starts = range(phase_r, h - tile_span_r + 1, period_r)
   162	    col_starts = range(phase_c, w - tile_span_c + 1, period_c)
   163	    for tile_r in row_starts:
   164	        for tile_c in col_starts:
