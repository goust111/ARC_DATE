+    widths = random.choice(_STAIRCASE_SHAPES)
+    pts = [(r, c) for r, width in enumerate(widths) for c in range(width)]
+    pairs = [(r, c) for r, width in enumerate(widths) for c in range(width - 1)]
+    return pts, pairs
