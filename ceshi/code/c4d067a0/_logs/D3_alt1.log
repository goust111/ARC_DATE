   166	                tr0 = tile_r + rr * step
   167	                tc0 = tile_c + cc * step
   168	                assert 0 <= tr0 <= h - block_size and 0 <= tc0 <= w - block_size, \
   169	                    "tiled legend block projection must fit in canvas"
   170	                out[tr0:tr0 + block_size, tc0:tc0 + block_size] = col
   171	    return out
