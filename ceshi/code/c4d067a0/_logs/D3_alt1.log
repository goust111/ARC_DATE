   237	    """Pick a staircase legend shape; return filled points and horizontal adjacent pairs."""
   238	    widths = random.choice(_STAIRCASE_SHAPES)
   239	    pts = [(r, c) for r, width in enumerate(widths) for c in range(width)]
   240	    pairs = [(r, c) for r, width in enumerate(widths) for c in range(width - 1)]
   241	    return pts, pairs
