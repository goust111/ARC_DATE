+    tile_cols = max(cc for _, cc, _ in legend_pts) + 1
+    max_rr = tile_rows - 1
+    max_cc = tile_cols - 1
+
+    sizes = [s for _, _, s, _ in blocks]
+    vals, cnts = np.unique(np.array(sizes, dtype=int), return_counts=True)
+    block_size = int(vals[cnts.argmax()])
