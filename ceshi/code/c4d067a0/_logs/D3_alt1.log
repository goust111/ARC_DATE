   203	def _enumerate_staircase_shapes():
   204	    """Enumerate valid staircase width tuples."""
   205	    shapes = []
   206	    for rows in LEGEND_ROWS:
   207	        for cols in LEGEND_COLS:
   208	            total = rows * cols
   209	            for empties in LEGEND_EMPTIES:
   210	                count = total - empties
   211	                if not (LEGEND_FILLED_MIN <= count <= LEGEND_FILLED_MAX):
   212	                    continue
   213	
   214	                def rec(prefix, remaining, r):
   215	                    if r == rows:
   216	                        if remaining == 0 and max(prefix) == cols:
   217	                            shapes.append(tuple(prefix))
   218	                        return
   219	                    left = rows - r - 1
   220	                    lo = max(1, remaining - left * cols)
   221	                    hi = min(cols, remaining - left)
   222	                    for width in range(lo, hi + 1):
   223	                        rec(prefix + [width], remaining - width, r + 1)
   224	
   225	                rec([], count, 0)
   226	    return shapes
