   244	def _random_color_counts(total, k):
   245	    """Distribute `total` items among `k` colors with positive counts."""
   246	    counts = [1] * k
   247	    remaining = total - k
   248	    while remaining:
   249	        open_idxs = [i for i, v in enumerate(counts) if v < MAX_COUNT_PER_COLOR]
   250	        i = random.choice(open_idxs)
   251	        add = random.randint(1, min(remaining, MAX_COUNT_PER_COLOR - counts[i]))
   252	        counts[i] += add
   253	        remaining -= add
   254	    random.shuffle(counts)
   255	    return counts
