+# --------------- generator (o5x) ---------------
+
+# === CFG: canvas ===
+GRID_SIZE_MIN, GRID_SIZE_MAX = 23, 27
+NUM_COLORS = 10
+
+# === CFG: legend lattice ===
+LEGEND_ORIGIN = (1, 1)
+LEGEND_STEP = 4
+LEGEND_BOX = 3
+LEGEND_ROWS = (3, 4)
+LEGEND_COLS = (2, 3)
+LEGEND_EMPTIES = (0, 1, 2)
+LEGEND_FILLED_MIN, LEGEND_FILLED_MAX = 6, 10
+PALETTE_SIZE_MIN, PALETTE_SIZE_MAX = 2, 4
+
+# === CFG: panel area ===
+PANEL_SIZE = 4
+PANEL_STEP = 5
+BASE_R_MIN = 1
+MAX_RETRIES = 500
+
+
+def _enumerate_staircase_shapes():
