+                    continue
+
+                def rec(prefix, remaining, r):
+                    if r == rows:
+                        if remaining == 0 and max(prefix) == cols:
+                            shapes.append(tuple(prefix))
+                        return
+                    left = rows - r - 1
+                    lo = max(1, remaining - left * cols)
+                    hi = min(cols, remaining - left)
+                    for width in range(lo, hi + 1):
