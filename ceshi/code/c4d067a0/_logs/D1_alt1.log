+def _norm_coords(coords) -> tuple[tuple[int, int], ...]:
+    pts = np.array(list(coords), dtype=int)
+    assert pts.size > 0
+    r0, c0 = pts.min(axis=0)
+    return tuple(sorted((int(r - r0), int(c - c0)) for r, c in pts))
