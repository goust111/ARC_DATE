+
+    if not any(perm[j] != j for j in range(n)):
+        return None
+    if not any(rotations):
+        return None
+
+    try:
+        solved = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(solved, out):
+        return None
+    return inp
+
+
+def generate_input():
+    for _ in range(MAX_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate valid c4d067a0 D1 input")

