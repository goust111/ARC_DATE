+
+    target_pool = [c for c in range(NUM_COLORS) if c != bg and c not in legend_palette]
+    target_palette = random.sample(target_pool, LEGEND_PALETTE_SIZE)
+    color_map = dict(zip(legend_palette, target_palette))
