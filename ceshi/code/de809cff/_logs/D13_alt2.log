import importlib.util, numpy as np, statistics as st
spec = importlib.util.spec_from_file_location('variant', '/home/lixinyu/snap/new/ceshi/code/de809cff/D13/2/code.py')
mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)

samples = 30
passive_counts = []
active_counts = []
area_gaps = []
diff_from_symmetric = 0
all_preserved = 0

for _ in range(samples):
    inp = mod.generate_input()
    out = mod.main(inp)
    colors = mod._main_colors(inp, mod.Color.BLACK)
    clean = mod._clean_foreground(inp, colors, mod.Color.BLACK)
    active = mod._active_host_color(clean, colors)
    passive = colors[1] if int(active) == int(colors[0]) else colors[0]
    centers = mod._dent_centers(inp, clean, colors, mod.Color.BLACK)
    active_centers = [(r,c,h) for r,c,h in centers if h == active]
    passive_centers = [(r,c,h) for r,c,h in centers if h == passive]
    active_counts.append(len(active_centers))
    passive_counts.append(len(passive_centers))
    area_gaps.append(abs(int(np.sum(clean == active)) - int(np.sum(clean == passive))))
    if passive_centers and all(out[r, c] == mod.Color.BLACK for r, c, _ in passive_centers):
        all_preserved += 1

    sym = clean.copy()
    h, w = inp.shape
    for r, c, host in centers:
        other = colors[1] if int(host) == int(colors[0]) else colors[0]
        sym[max(0, r - 1):min(h, r + 2), max(0, c - 1):min(w, c + 2)] = int(other)
    for r, c, _ in centers:
        sym[r, c] = mod.Color.TEAL
    if not np.array_equal(sym, out):
        diff_from_symmetric += 1

print('samples', samples)
print('passive dents min/avg/max', min(passive_counts), round(st.mean(passive_counts), 2), max(passive_counts))
print('active dents min/avg/max', min(active_counts), round(st.mean(active_counts), 2), max(active_counts))
print('area gap min/avg/max', min(area_gaps), round(st.mean(area_gaps), 2), max(area_gaps))
print('passive preserved in all passive centers', all_preserved, '/', samples)
print('variant output differs from symmetric baseline', diff_from_symmetric, '/', samples)
