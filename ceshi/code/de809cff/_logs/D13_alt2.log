+# Variant of de809cff
+# Dimension: D13 — 两种前景色之间的对调映射关系 (meta)
+# Change: 固定双色对调：区域A的凹痕用色B填充补丁，区域B的凹痕用色A填充补丁（简单二元交换）... → 单向映射：只有一种区域的凹痕触发变换
+
+from __future__ import annotations
+
+import random
+from collections import Counter as _Counter
+
+import numpy as np
+
+from arc_utils import Color
+
+
+# Design analysis for D13
+# a) Concrete behavior:
+#    The old task converted dents in both colored regions. In this variant, both
+#    regions still contain black dents, but only the dents hosted by the larger
+#    cleaned foreground region become 3x3 opposite-color patches with teal
+#    centers. Dents hosted by the smaller region remain plain black holes in the
+#    output. Example: if yellow owns 240 cleaned cells and red owns 165 cleaned
+#    cells, then a black hole inside yellow becomes a red 3x3 patch with a teal
+#    center, while a black hole inside red stays black. The flow change happens
+#    after dent detection: original logic stamped every detected dent; the
+#    variant must stamp only dents whose host is the larger region.
+# b) Complexity calibration:
+#    The active/passive split is based on a visible property (region area), not a
+#    hidden color id. The generator enforces a clear area gap and places several
+#    dents in both regions, so the asymmetry repeats enough times to be readable
+#    from a few examples without reducing the puzzle to a trivial single-dent
+#    exception.
+# c) Implicit-assumption audit:
+#    - _clean_foreground can stay unchanged because noise semantics do not change.
+#    - _dent_centers still classifies dents by local 3x3 majority; that premise
+#      remains valid.
+#    - The old unconditional patch loop relied on bilateral symmetry; that is no
+#      longer safe because it would erase passive-region dents. The new solver
+#      must filter by host color before stamping, then explicitly restore passive
+#      dent cells to black.
+#    - Choosing the active region cannot depend on palette ids. The solver uses
+#      cleaned visible area, and the generator guarantees a non-tied ordering.
+# d) Placement legality:
+#    Dent centers are selected with global separation across both regions so an
+#    active 3x3 patch does not cover a passive dent. Pair dents only expand when
+#    the extra cell remains a valid dent and stays away from all other centers.
+# e) Visual observability:
+#    Across samples, the larger region repeatedly shows teal-centered opposite-
+#    color patches, while the smaller region keeps black holes. Because colors
+#    vary per sample, a human must infer "larger region is active" rather than a
+#    fixed palette mapping.
+# f) Visual cleanliness:
+#    The generator keeps the original low-complexity rectangle layout and noise
+#    model, but prevents dense cross-color dent overlap. This keeps the passive
+#    black holes visually distinct from active stamped patches.
+# g) Color-change inference:
+#    There are still only two foreground colors plus teal. The active region uses
+#    the other visible foreground color for the patch, so the recoloring rule is
+#    structurally supported by surrounding region membership rather than by
+#    arbitrary per-color remapping.
+
+
+def _main_colors(g: np.ndarray, bg: int) -> tuple[int, int]:
+    colors = [int(c) for c in np.unique(g) if int(c) != int(bg)]
+    colors.sort(key=lambda c: int(np.sum(g == c)), reverse=True)
+    assert len(colors) >= 2, "expected two foreground colors"
+    return int(colors[0]), int(colors[1])
+
+
+def _has_same_2x2(g: np.ndarray, r: int, c: int, color: int) -> bool:
+    h, w = g.shape
+    for dr in (-1, 0):
+        for dc in (-1, 0):
+            rr = int(r) + dr
+            cc = int(c) + dc
+            if 0 <= rr < h - 1 and 0 <= cc < w - 1:
+                if bool(np.all(g[rr : rr + 2, cc : cc + 2] == int(color))):
+                    return True
+    return False
+
+
+def _clean_foreground(g: np.ndarray, colors: tuple[int, int], bg: int) -> np.ndarray:
+    """
+    Remove one-cell specks/protrusions before detecting black dents.
+
+    Two sweeps are enough for the observed corruption pattern: the first removes
+    protruding wrong-color cells, the second lets their neighboring true cells
+    keep the corrected local majority.
+    """
+    h, w = g.shape
+    a, b = map(int, colors)
+    cur = g.copy()
+
+    for _ in range(2):
+        nxt = cur.copy()
+        for r in range(h):
+            for c in range(w):
+                v = int(cur[r, c])
+                if v not in colors:
+                    nxt[r, c] = bg
+                    continue
+
+                sub = cur[max(0, r - 1) : min(h, r + 2), max(0, c - 1) : min(w, c + 2)]
+                own = int(np.sum(sub == v))
+                other = b if v == a else a
+                other_count = int(np.sum(sub == other))
+                bg_count = int(np.sum(sub == bg))
+
+                if _has_same_2x2(cur, r, c, v):
+                    nxt[r, c] = v
+                elif other_count > own and other_count >= 5:
+                    nxt[r, c] = other
+                elif bg_count >= 5 and own <= 4:
+                    nxt[r, c] = bg
+                elif own <= 2:
+                    nxt[r, c] = bg
+                else:
+                    nxt[r, c] = v
+        cur = nxt
+
+    return cur
+
+
+def _dent_centers(
+    original: np.ndarray, clean: np.ndarray, colors: tuple[int, int], bg: int
+) -> list[tuple[int, int, int]]:
+    h, w = original.shape
+    centers: list[tuple[int, int, int]] = []
+    for r, c in zip(*np.where(original == int(bg)), strict=False):
+        rr = int(r)
+        cc = int(c)
+        sub = clean[max(0, rr - 1) : min(h, rr + 2), max(0, cc - 1) : min(w, cc + 2)]
+        counts = {int(color): int(np.sum(sub == int(color))) for color in colors}
+        host = max(colors, key=lambda color: counts[int(color)])
+        other = colors[1] if int(host) == int(colors[0]) else colors[0]
+        if counts[int(host)] >= 5 and counts[int(host)] > counts[int(other)]:
+            centers.append((rr, cc, int(host)))
+    return centers
+
+
+def _active_and_passive_colors(clean: np.ndarray, colors: tuple[int, int]) -> tuple[int, int]:
+    order = {int(color): idx for idx, color in enumerate(colors)}
+    ranked = sorted(
+        (int(color) for color in colors),
+        key=lambda color: (int(np.sum(clean == int(color))), -order[int(color)]),
+        reverse=True,
+    )
+    return ranked[0], ranked[1]
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Upgrade dents only in the larger cleaned foreground region.
+
+    Input structure:
+    - A black canvas contains two broad non-black regions built from the same two
+      foreground colors throughout the task.
+    - Both regions may contain black dents, plus a small amount of one-cell
+      background speck noise and one-cell cross-boundary contamination.
+
+    Rule:
+    - First repair the two foreground regions locally, removing isolated specks
+      and reverting one-cell boundary contamination to the surrounding region.
+    - Determine which foreground color owns the larger visible area after that
+      cleanup; only that region is active.
+    - For each original black dent whose cleaned 3x3 neighborhood is dominated
+      by the active region, paint a 3x3 patch in the other foreground color and
+      recolor the dent center teal (8).
+    - Dents assigned to the smaller region do not get upgraded; those cells stay
+      black in the output.
+
+    Key insight:
+    The asymmetry is structural rather than palette-based: the larger cleaned
+    region is the only one whose dents turn into opposite-color teal-centered
+    patches, while the smaller region keeps its black holes.
+    """
+    g = np.asarray(grid, dtype=int)
+    bg = Color.BLACK
+    colors = _main_colors(g, bg)
+    clean = _clean_foreground(g, colors, bg)
+    active_color, passive_color = _active_and_passive_colors(clean, colors)
+
+    out = clean.copy()
+    centers = _dent_centers(g, clean, colors, bg)
+    h, w = g.shape
+    for r, c, host in centers:
+        if int(host) != int(active_color):
+            continue
+        out[max(0, r - 1) : min(h, r + 2), max(0, c - 1) : min(w, c + 2)] = int(passive_color)
+
+    for r, c, host in centers:
+        if int(host) == int(active_color):
+            out[r, c] = Color.TEAL
+        else:
+            out[r, c] = bg
+
+    return out
+
+
+# --------------- generator (cx) ---------------
+
+# --- CFG: canvas & region layout ---
+GRID_SIZE_MIN, GRID_SIZE_MAX = 20, 30
+RECT_SIZE_FRAC_MIN, RECT_SIZE_FRAC_MAX = 0.45, 0.75
+RECT_MARGIN_MAX = 3
+MIN_REGION_CELLS = 100
+COVERAGE_MIN, COVERAGE_MAX = 0.55, 0.85
+ACTIVE_AREA_DIFF_MIN = 35
+ACTIVE_AREA_RATIO_MIN = 1.16
+
+# --- CFG: dent placement ---
+DENT_COUNT_MIN, DENT_COUNT_MAX = 12, 22
+DENT_MIN_HOST_3x3 = 5
+DENT_PATCH_SEPARATION = 3
+DENT_PAIR_PROB = 0.13
+PASSIVE_DENT_MIN, PASSIVE_DENT_MAX = 4, 7
+ACTIVE_DENT_MIN = 6
+
+# --- CFG: noise ---
+NOISE_COUNT_MIN, NOISE_COUNT_MAX = 7, 22
+BG_NOISE_FRAC_MIN, BG_NOISE_FRAC_MAX = 0.65, 0.85
+BG_SPECK_MIN_BG_3x3 = 6
+BOUNDARY_MIN_HOST_3x3 = 6
+
+# --- CFG: generation control ---
+MAX_GENERATION_ATTEMPTS = 300
+
+
+def _sub3x3(grid: np.ndarray, r: int, c: int) -> np.ndarray:
+    """Return the 3x3 neighborhood of (r,c), clipped to grid bounds."""
+    h, w = grid.shape
+    return grid[max(0, r - 1) : min(h, r + 2), max(0, c - 1) : min(w, c + 2)]
+
+
+def _build_regions(N: int, color_a: int, color_b: int, rng: random.Random) -> np.ndarray | None:
+    """Paint 2-3 overlapping rectangles (simple occlusion, painter's algorithm)."""
+    n_rects = rng.choice([2, 3])
+    corners = ["TL", "TR", "BL", "BR"]
+    rng.shuffle(corners)
+    chosen_corners = corners[:n_rects]
+
+    if n_rects == 2:
+        rect_colors = [color_a, color_b]
+        rng.shuffle(rect_colors)
+    else:
+        first = rng.choice([color_a, color_b])
+        mid = color_b if first == color_a else color_a
+        rect_colors = [first, mid, first]
+
+    def _make_rect(corner: str) -> tuple[int, int, int, int]:
+        h = rng.randint(int(N * RECT_SIZE_FRAC_MIN), int(N * RECT_SIZE_FRAC_MAX))
+        w = rng.randint(int(N * RECT_SIZE_FRAC_MIN), int(N * RECT_SIZE_FRAC_MAX))
+        m = rng.randint(0, RECT_MARGIN_MAX)
+        r0 = m if corner[0] == "T" else max(0, N - h - m)
+        c0 = m if corner[1] == "L" else max(0, N - w - m)
+        return r0, c0, min(N, r0 + h), min(N, c0 + w)
+
+    grid = np.zeros((N, N), dtype=int)
+    for corner, color in zip(chosen_corners, rect_colors):
+        r0, c0, r1, c1 = _make_rect(corner)
+        grid[r0:r1, c0:c1] = color
+
+    cnt_a = int(np.sum(grid == color_a))
+    cnt_b = int(np.sum(grid == color_b))
+    if cnt_a < MIN_REGION_CELLS or cnt_b < MIN_REGION_CELLS:
+        return None
+    coverage = (cnt_a + cnt_b) / (N * N)
+    if not (COVERAGE_MIN <= coverage <= COVERAGE_MAX):
+        return None
+    hi, lo = max(cnt_a, cnt_b), min(cnt_a, cnt_b)
+    if hi - lo < ACTIVE_AREA_DIFF_MIN:
+        return None
+    if lo == 0 or hi / lo < ACTIVE_AREA_RATIO_MIN:
+        return None
+    if n_rects == 3:
+        from scipy.ndimage import label
+
+        _, n_components = label(grid == rect_colors[0])
+        if n_components < 2:
+            return None
+    return grid
+
+
+def _is_safe_dent_center(grid: np.ndarray, r: int, c: int, host: int, other: int) -> bool:
+    """After setting (r,c) to black, the solver must detect it as a dent in host region."""
+    if grid[r, c] != host:
+        return False
+    sub = _sub3x3(grid, r, c)
+    host_count = int(np.sum(sub == host)) - 1
+    return host_count >= DENT_MIN_HOST_3x3 and host_count > int(np.sum(sub == other))
+
+
+def _would_form_2x2(grid: np.ndarray, r: int, c: int, color: int) -> bool:
+    """Check whether placing `color` at (r,c) would complete a 2x2 block of that color."""
+    h, w = grid.shape
+    for dr in (-1, 0):
+        for dc in (-1, 0):
+            rr, cc = r + dr, c + dc
+            if 0 <= rr < h - 1 and 0 <= cc < w - 1:
+                block = grid[rr : rr + 2, cc : cc + 2].copy()
+                block[r - rr, c - cc] = color
+                if int(np.sum(block == color)) == 4:
+                    return True
+    return False
+
+
+def _far_from_all(r: int, c: int, others: list[tuple[int, int]]) -> bool:
+    return all(max(abs(r - rr), abs(c - cc)) >= DENT_PATCH_SEPARATION for rr, cc in others)
+
+
+def _pick_dent_centers(
+    candidates: list[tuple[int, int]],
+    n: int,
+    rng: random.Random,
+    blocked: list[tuple[int, int]] | None = None,
+) -> list[tuple[int, int]] | None:
+    """Select n dent centers with global Chebyshev separation."""
+    blocked = [] if blocked is None else list(blocked)
+    shuffled = list(candidates)
+    rng.shuffle(shuffled)
+    chosen: list[tuple[int, int]] = []
+    for r, c in shuffled:
+        if not _far_from_all(r, c, blocked + chosen):
+            continue
+        chosen.append((r, c))
+        if len(chosen) >= n:
+            return chosen
+    return None
+
+
+def _expand_to_pairs(
+    dents: list[tuple[int, int]],
+    host: int,
+    other: int,
+    clean: np.ndarray,
+    all_centers: list[tuple[int, int]],
+    rng: random.Random,
+) -> list[list[tuple[int, int]]]:
+    """Optionally expand single-cell dents into 2-cell adjacent pairs (~13% chance each)."""
+    h, w = clean.shape
+    result: list[list[tuple[int, int]]] = []
+    for r, c in dents:
+        cells = [(r, c)]
+        if rng.random() < DENT_PAIR_PROB:
+            neighbors = [(r + 1, c), (r - 1, c), (r, c + 1), (r, c - 1)]
+            rng.shuffle(neighbors)
+            for nr, nc in neighbors:
+                if not (0 <= nr < h and 0 <= nc < w):
+                    continue
+                if clean[nr, nc] != host or not _is_safe_dent_center(clean, nr, nc, host, other):
+                    continue
+                if not all(
+                    (r2, c2) == (r, c)
+                    or max(abs(nr - r2), abs(nc - c2)) >= DENT_PATCH_SEPARATION
+                    for r2, c2 in all_centers
+                ):
+                    continue
+                cells.append((nr, nc))
+                break
+        result.append(cells)
+    return result
+
+
+def _stamp_dents(
+    clean: np.ndarray,
+    active_groups: list[list[tuple[int, int]]],
+    passive_groups: list[list[tuple[int, int]]],
+    stamp_color: int,
+) -> np.ndarray:
+    """Build output for one-way mapping: active dents stamp, passive dents stay black."""
+    h, w = clean.shape
+    output = clean.copy()
+    for cells in active_groups:
+        for r, c in cells:
+            output[max(0, r - 1) : min(h, r + 2), max(0, c - 1) : min(w, c + 2)] = stamp_color
+    for cells in active_groups:
+        for r, c in cells:
+            output[r, c] = Color.TEAL
+    for cells in passive_groups:
+        for r, c in cells:
+            output[r, c] = Color.BLACK
+    return output
+
+
+def _add_bg_noise(inp: np.ndarray, clean: np.ndarray, n_in_bg: int, color_a: int, color_b: int, rng: random.Random) -> None:
+    """Place isolated fg-color specks in background area."""
+    bg_candidates = list(zip(*np.where(clean == 0), strict=False))
+    rng.shuffle(bg_candidates)
+
+    placed = 0
+    for r_, c_ in bg_candidates:
+        if placed >= n_in_bg:
+            break
+        r, c = int(r_), int(c_)
+        sub = _sub3x3(inp, r, c)
+        if int(np.sum(sub == 0)) < BG_SPECK_MIN_BG_3x3:
+            continue
+        nearby = _sub3x3(clean, r, c)
+        nearby_fg = [int(x) for x in nearby.flat if int(x) != 0]
+        speck_color = _Counter(nearby_fg).most_common(1)[0][0] if nearby_fg else rng.choice([color_a, color_b])
+        inp[r, c] = speck_color
+        placed += 1
+
+
+def _neighbor_cleanup_safe(inp: np.ndarray, r: int, c: int, host: int, other: int) -> bool:
+    """Check that changing (r,c) to `other` won't cause the solver to misclassify any neighbor."""
+    h, w = inp.shape
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            nr, nc = r + dr, c + dc
+            if not (0 <= nr < h and 0 <= nc < w) or inp[nr, nc] != host:
+                continue
+            nsub = _sub3x3(inp, nr, nc).copy()
+            nr0, nc0 = max(0, nr - 1), max(0, nc - 1)
+            nsub[r - nr0, c - nc0] = other
+            own_n = int(np.sum(nsub == host))
+            other_n = int(np.sum(nsub == other))
+            bg_n = int(np.sum(nsub == 0))
+            if (other_n > own_n and other_n >= 5) or own_n <= 2 or (bg_n >= 5 and own_n <= 4):
+                return False
+    return True
+
+
+def _add_boundary_noise(inp: np.ndarray, clean: np.ndarray, n_at_boundary: int, color_a: int, color_b: int, rng: random.Random) -> None:
+    """Place cross-color contamination at region-region boundaries."""
+    h, w = clean.shape
+    boundary_candidates = []
+    for r in range(h):
+        for c in range(w):
+            v = int(clean[r, c])
+            if v not in (color_a, color_b):
+                continue
+            other = color_b if v == color_a else color_a
+            if int(np.sum(_sub3x3(clean, r, c) == other)) >= 1:
+                boundary_candidates.append((r, c, v, other))
+    rng.shuffle(boundary_candidates)
+
+    placed = 0
+    for r, c, host, other in boundary_candidates:
+        if placed >= n_at_boundary:
+            break
+        if inp[r, c] != host:
+            continue
+        sub_now = _sub3x3(inp, r, c)
+        host_count = int(np.sum(sub_now == host))
+        other_count = int(np.sum(sub_now == other))
+        if host_count < BOUNDARY_MIN_HOST_3x3 or host_count - 1 <= other_count + 1:
+            continue
+        if _would_form_2x2(inp, r, c, other):
+            continue
+        if not _neighbor_cleanup_safe(inp, r, c, host, other):
+            continue
+        inp[r, c] = other
+        placed += 1
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    N = rng.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)
+    fg_pool = [c for c in Color.NOT_BLACK if c != Color.TEAL]
+    color_a, color_b = rng.sample(fg_pool, 2)
+
+    clean = _build_regions(N, color_a, color_b, rng)
+    if clean is None:
+        return None
+
+    active_color, passive_color = _active_and_passive_colors(clean, (color_a, color_b))
+
+    h, w = clean.shape
+    valid = {color_a: [], color_b: []}
+    for r in range(h):
+        for c in range(w):
+            v = int(clean[r, c])
+            if v == color_a and _is_safe_dent_center(clean, r, c, color_a, color_b):
+                valid[color_a].append((r, c))
+            elif v == color_b and _is_safe_dent_center(clean, r, c, color_b, color_a):
+                valid[color_b].append((r, c))
+
+    n_total = rng.randint(DENT_COUNT_MIN, DENT_COUNT_MAX)
+    max_passive = min(PASSIVE_DENT_MAX, n_total - ACTIVE_DENT_MIN, len(valid[passive_color]) - 2)
+    if max_passive < PASSIVE_DENT_MIN:
+        return None
+    n_passive = rng.randint(PASSIVE_DENT_MIN, max_passive)
+    n_active = n_total - n_passive
+    if len(valid[active_color]) < n_active + 2:
+        return None
+
+    dents_passive = _pick_dent_centers(valid[passive_color], n_passive, rng)
+    if dents_passive is None:
+        return None
+    dents_active = _pick_dent_centers(valid[active_color], n_active, rng, blocked=dents_passive)
+    if dents_active is None:
+        return None
+
+    all_centers = dents_active + dents_passive
+    groups_active = _expand_to_pairs(dents_active, active_color, passive_color, clean, all_centers, rng)
+    groups_passive = _expand_to_pairs(dents_passive, passive_color, active_color, clean, all_centers, rng)
+
+    output = _stamp_dents(clean, groups_active, groups_passive, passive_color)
+
+    inp = clean.copy()
+    for cells in groups_active + groups_passive:
+        for r, c in cells:
+            inp[r, c] = 0
+
+    n_noise = rng.randint(NOISE_COUNT_MIN, NOISE_COUNT_MAX)
+    n_in_bg = int(round(n_noise * rng.uniform(BG_NOISE_FRAC_MIN, BG_NOISE_FRAC_MAX)))
+    _add_bg_noise(inp, clean, n_in_bg, color_a, color_b, rng)
+    _add_boundary_noise(inp, clean, n_noise - n_in_bg, color_a, color_b, rng)
+
+    try:
+        produced = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(produced, output):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        try:
+            grid = _gen_attempt(rng)
+        except Exception:
+            grid = None
+        if grid is not None:
+            return grid
+    raise RuntimeError("generate_input: failed after %d attempts" % MAX_GENERATION_ATTEMPTS)

