/bin/bash -lc "python - <<'PY'
import importlib.util, collections, numpy as np

new_spec = importlib.util.spec_from_file_location('variant', '/home/lixinyu/snap/new/ceshi/code/de809cff/D13/0/code.py')
new = importlib.util.module_from_spec(new_spec)
new_spec.loader.exec_module(new)
old_spec = importlib.util.spec_from_file_location('orig', '/home/lixinyu/snap/new/arc2_solver_select/de809cff.py')
old = importlib.util.module_from_spec(old_spec)
old_spec.loader.exec_module(old)

n = 120
stats = collections.Counter()
for _ in range(n):
    inp = new.generate_input()
    new_out = new.main(inp)
    old_out = old.main(inp)
    colors = new._main_colors(inp, new.Color.BLACK)
    mapping, legend_mask = new._palette_mapping(inp, colors, new.Color.BLACK)
    a, b = colors
    vals = {mapping[a], mapping[b]}
    if mapping[a] "'!= b or mapping[b] != a:
        stats['"'non_swap_mapping'] += 1
    else:
        stats['pure_swap_mapping'] += 1
    if mapping[a] == a or mapping[b] == b:
        stats['has_self_mapping'] += 1
    if any(v not in colors for v in vals):
        stats['uses_third_color'] += 1
    if not np.array_equal(new_out, old_out):
        stats['new_vs_old_diff'] += 1
