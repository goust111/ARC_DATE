/bin/bash -lc "python - <<'PY'
import importlib.util, random, numpy as np
spec = importlib.util.spec_from_file_location('variant','/home/lixinyu/snap/new/ceshi/code/de809cff/D13/0/code.py')
mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)

rng = random.Random(0)
counts = {}
for _ in range(100):
    N = rng.randint(mod.GRID_SIZE_MIN, mod.GRID_SIZE_MAX)
    fg_pool = [c for c in mod.Color.NOT_BLACK if c "'!= mod.Color.TEAL]
    color_a, color_b = rng.sample(fg_pool, 2)
    side = rng.choice(mod.LEGEND_SIDES)
    start = rng.randint(0, N - 2)
    legend_mask, reserved_mask = mod._legend_masks((N, N), side, start)
    mapping, _third = mod._choose_mapping(color_a, color_b, rng)
    key_order = [color_a, color_b]
    rng.shuffle(key_order)
    fill_order = [mapping[key_order[0]], mapping[key_order[1]]]
    legend_block = np.zeros((N, N), dtype=int)
    mod._paint_legend(legend_block, side, start, mod._legend_array(side, (key_order[0], key_order[1]), (fill_order[0], fill_order[1])))
    clean = mod._build_regions(N, color_a, color_b, reserved_mask, rng)
    if clean is None:
        counts['"'build_none'] = counts.get('build_none',0)+1
        continue
    n_total = rng.randint(mod.DENT_COUNT_MIN, mod.DENT_COUNT_MAX)
    n_a, n_b = n_total // 2, n_total - n_total // 2
    if rng.random() < 0.5:
        n_a, n_b = n_b, n_a
    valid = {color_a: [], color_b: []}
    for r in range(N):
        for c in range(N):
            if reserved_mask[r,c] or not mod._patch_clear_of_reserved(reserved_mask, r, c):
                continue
            v = int(clean[r,c])
            if v == color_a and mod._is_safe_dent_center(clean, r, c, color_a, color_b):
                valid[color_a].append((r,c))
            elif v == color_b and mod._is_safe_dent_center(clean, r, c, color_b, color_a):
                valid[color_b].append((r,c))
    if len(valid[color_a]) < n_a + 2 or len(valid[color_b]) < n_b + 2:
        counts['valid_too_few'] = counts.get('valid_too_few',0)+1
        continue
    dents_a = mod._pick_dent_centers(valid[color_a], n_a, rng)
    dents_b = mod._pick_dent_centers(valid[color_b], n_b, rng)
    if dents_a is None or dents_b is None:
        counts['pick_none'] = counts.get('pick_none',0)+1
        continue
    groups_a = [[x] for x in dents_a]
    groups_b = [[x] for x in dents_b]
    noise_blocked = reserved_mask | mod._dent_guard_mask(clean.shape, groups_a + groups_b)
    output = mod._stamp_dents(clean, legend_mask, legend_block, groups_a, groups_b, color_a, color_b, mapping)
    inp = clean.copy(); inp[legend_mask] = legend_block[legend_mask]
    for cells in groups_a + groups_b:
        for r,c in cells:
            inp[r,c]=0
    n_noise = rng.randint(mod.NOISE_COUNT_MIN, mod.NOISE_COUNT_MAX)
    n_in_bg = int(round(n_noise * rng.uniform(mod.BG_NOISE_FRAC_MIN, mod.BG_NOISE_FRAC_MAX)))
    mod._add_bg_noise(inp, clean, n_in_bg, color_a, color_b, noise_blocked, rng)
    mod._add_boundary_noise(inp, clean, n_noise - n_in_bg, color_a, color_b, noise_blocked, rng)
    try:
        produced = mod.main(inp)
    except Exception:
        counts['main_exc'] = counts.get('main_exc',0)+1
        continue
    if not np.array_equal(produced, output):
        counts['oracle_mismatch'] = counts.get('oracle_mismatch',0)+1
        continue
    counts['success'] = counts.get('success',0)+1
print(counts)
