+            nsub[r - nr0, c - nc0] = source
+            own_n = int(np.sum(nsub == source))
+            other_n = int(np.sum(nsub == host))
+            bg_n = int(np.sum(nsub == bg))
+            if (other_n > own_n and other_n >= 5) or (bg_n >= 5 and own_n <= 4) or own_n <= 2:
