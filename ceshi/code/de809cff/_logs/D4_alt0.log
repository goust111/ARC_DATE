   423	def _boundary_noise_safe(
   424	    inp: np.ndarray,
   425	    r: int,
   426	    c: int,
   427	    host: int,
   428	    other: int,
   429	    colors: tuple[int, int, int],
   430	    bg: int,
   431	) -> bool:
   432	    if int(inp[r, c]) != int(host):
   433	        return False
   434	
   435	    sub_now = _sub3x3(inp, r, c)
   436	    host_count = int(np.sum(sub_now == int(host)))
   437	    other_count = int(np.sum(sub_now == int(other)))
   438	    if host_count < BOUNDARY_MIN_HOST_3x3 or host_count - 1 <= other_count + 1:
   439	        return False
   440	    if _would_form_2x2(inp, r, c, other):
   441	        return False
   442	
   443	    test = inp.copy()
   444	    test[r, c] = int(other)
   445	    if _clean_cell(test, r, c, colors, bg) != int(host):
   446	        return False
   447	
   448	    r0 = max(0, r - 1)
   449	    r1 = min(inp.shape[0], r + 2)
   450	    c0 = max(0, c - 1)
   451	    c1 = min(inp.shape[1], c + 2)
   452	    for rr in range(r0, r1):
   453	        for cc in range(c0, c1):
   454	            before = _clean_cell(inp, rr, cc, colors, bg)
   455	            after = _clean_cell(test, rr, cc, colors, bg)
   456	            if (rr, cc) == (r, c):
   457	                if after != int(host):
