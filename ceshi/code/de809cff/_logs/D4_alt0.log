   117	def _clean_foreground(g: np.ndarray, colors: tuple[int, int, int], bg: int) -> np.ndarray:
   118	    """
   119	    Remove one-cell specks/protrusions before detecting black dents.
   120	
   121	    The same two-sweep local majority cleanup still works in the three-color
   122	    setting as long as rival recoloring requires a unique dominant foreground
   123	    color in the 3x3 neighborhood.
   124	    """
   125	    h, w = g.shape
   126	    cur = g.copy()
   127	
   128	    for _ in range(2):
   129	        nxt = cur.copy()
   130	        for r in range(h):
   131	            for c in range(w):
   132	                nxt[r, c] = _clean_cell(cur, r, c, colors, bg)
   133	        cur = nxt
   134	
   135	    return cur
   136	
