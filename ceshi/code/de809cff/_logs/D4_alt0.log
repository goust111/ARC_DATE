   384	def _nearby_speck_color(clean: np.ndarray, r: int, c: int, colors: tuple[int, int, int], rng: random.Random) -> int:
   385	    nearby = [int(x) for x in _sub3x3(clean, r, c).flat if int(x) in colors]
   386	    if nearby:
   387	        return int(_Counter(nearby).most_common(1)[0][0])
   388	    return int(rng.choice(list(colors)))
