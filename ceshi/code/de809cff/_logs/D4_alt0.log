    94	def _clean_cell(cur: np.ndarray, r: int, c: int, colors: tuple[int, int, int], bg: int) -> int:
    95	    v = int(cur[r, c])
    96	    if v not in colors:
    97	        return int(bg)
    98	
    99	    if _has_same_2x2(cur, r, c, v):
   100	        return v
   101	
   102	    sub = _sub3x3(cur, r, c)
   103	    counts = {int(color): int(np.sum(sub == int(color))) for color in colors}
   104	    own = counts[v]
   105	    bg_count = int(np.sum(sub == int(bg)))
   106	    dominant = _dominant_color(sub, colors, threshold=5)
   107	
   108	    if dominant is not None and int(dominant) != v and counts[int(dominant)] > own:
   109	        return int(dominant)
   110	    if bg_count >= 5 and own <= 4:
   111	        return int(bg)
   112	    if own <= 2:
   113	        return int(bg)
   114	    return v
