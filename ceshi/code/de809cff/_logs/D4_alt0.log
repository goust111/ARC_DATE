   174	def main(grid: np.ndarray) -> np.ndarray:
   175	    """
   176	    Turn black dents in three colored regions into marked cyclic-color patches.
   177	
   178	    Input structure:
   179	    - Black background with three large foreground regions, visually arranged as
   180	      left, right, and bottom masses.
   181	    - The regions contain small black dents plus one-cell foreground specks in
   182	      the background or along region boundaries.
   183	
   184	    Rule:
   185	    - First clean local one-cell corruption: isolated stray foreground cells
   186	      revert to black, while a lone boundary intrusion flips back to the unique
   187	      neighboring foreground majority.
   188	    - For each original black dent whose cleaned 3x3 neighborhood is dominated
   189	      by one region color, place a 3x3 patch in the cyclic target color:
   190	      left dents use right, right dents use bottom, bottom dents use left.
   191	    - Recolor every dent center teal (8) after stamping the surrounding patch.
   192	
   193	    Key insight: The puzzle is no longer "use the only other color"; instead,
   194	    the three large regions define spatial roles, and the dent patch color is
   195	    determined by the role cycle left -> right -> bottom -> left.
   196	    """
   197	    g = np.asarray(grid, dtype=int)
   198	    bg = Color.BLACK
   199	    colors = _main_colors(g, bg)
   200	    clean = _clean_foreground(g, colors, bg)
   201	    stamp_map = _stamp_map(clean, colors)
   202	
   203	    out = clean.copy()
   204	    h, w = g.shape
   205	    centers = _dent_centers(g, clean, colors, bg)
   206	    for r, c, host in centers:
   207	        out[max(0, r - 1) : min(h, r + 2), max(0, c - 1) : min(w, c + 2)] = int(stamp_map[int(host)])
   208	
   209	    for r, c, _host in centers:
   210	        out[r, c] = Color.TEAL
   211	
   212	    return out
   213	
