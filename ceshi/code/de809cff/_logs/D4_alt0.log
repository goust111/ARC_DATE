   410	def _would_form_2x2(grid: np.ndarray, r: int, c: int, color: int) -> bool:
   411	    h, w = grid.shape
   412	    for dr in (-1, 0):
   413	        for dc in (-1, 0):
   414	            rr, cc = r + dr, c + dc
   415	            if 0 <= rr < h - 1 and 0 <= cc < w - 1:
   416	                block = grid[rr : rr + 2, cc : cc + 2].copy()
   417	                block[r - rr, c - cc] = int(color)
   418	                if bool(np.all(block == int(color))):
   419	                    return True
   420	    return False
