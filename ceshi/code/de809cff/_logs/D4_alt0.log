    66	def _main_colors(g: np.ndarray, bg: int) -> tuple[int, int, int]:
    67	    colors = [int(c) for c in np.unique(g) if int(c) != int(bg)]
    68	    colors.sort(key=lambda c: int(np.sum(g == c)), reverse=True)
    69	    assert len(colors) >= 3, "expected three foreground colors"
    70	    return int(colors[0]), int(colors[1]), int(colors[2])
