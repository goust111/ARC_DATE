   369	def _stamp_dents(clean: np.ndarray, dent_groups: dict[int, list[list[tuple[int, int]]]], stamp_map: dict[int, int]) -> np.ndarray:
   370	    h, w = clean.shape
   371	    output = clean.copy()
   372	    for host, groups in dent_groups.items():
   373	        stamp_color = int(stamp_map[int(host)])
   374	        for cells in groups:
   375	            for r, c in cells:
   376	                output[max(0, r - 1) : min(h, r + 2), max(0, c - 1) : min(w, c + 2)] = stamp_color
   377	    for groups in dent_groups.values():
   378	        for cells in groups:
   379	            for r, c in cells:
   380	                output[r, c] = Color.TEAL
   381	    return output
