   264	        l_r0 = rng.randint(0, RECT_MARGIN_MAX)
   265	        l_c0 = rng.randint(0, RECT_MARGIN_MAX)
   266	        r_r0 = rng.randint(0, RECT_MARGIN_MAX)
   267	        r_c0 = max(0, N - r_w - rng.randint(0, RECT_MARGIN_MAX))
   268	        b_r0 = max(0, N - b_h - rng.randint(0, RECT_MARGIN_MAX))
   269	        b_center_jitter = rng.randint(-max(1, N // 10), max(1, N // 10))
   270	        b_c0 = (N - b_w) // 2 + b_center_jitter
   271	        b_c0 = min(max(0, b_c0), max(0, N - b_w))
   272	
   273	        l_r1, l_c1 = min(N, l_r0 + l_h), min(N, l_c0 + l_w)
   274	        r_r1, r_c1 = min(N, r_r0 + r_h), min(N, r_c0 + r_w)
   275	        b_r1, b_c1 = min(N, b_r0 + b_h), min(N, b_c0 + b_w)
   276	
   277	        lr_overlap_h = max(0, min(l_r1, r_r1) - max(l_r0, r_r0))
   278	        lr_overlap_w = max(0, min(l_c1, r_c1) - max(l_c0, r_c0))
   279	        left_bottom_overlap = max(0, min(l_r1, b_r1) - max(l_r0, b_r0)) * max(0, min(l_c1, b_c1) - max(l_c0, b_c0))
   280	        right_bottom_overlap = max(0, min(r_r1, b_r1) - max(r_r0, b_r0)) * max(0, min(r_c1, b_c1) - max(r_c0, b_c0))
   281	        if lr_overlap_h <= 0 or lr_overlap_w < LEFT_RIGHT_OVERLAP_MIN:
   282	            continue
