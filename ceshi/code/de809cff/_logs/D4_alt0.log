   335	def _expand_to_pairs(
   336	    dents: dict[int, list[tuple[int, int]]],
   337	    clean: np.ndarray,
   338	    colors: tuple[int, int, int],
   339	    rng: random.Random,
   340	) -> dict[int, list[list[tuple[int, int]]]]:
   341	    h, w = clean.shape
   342	    occupied = {(r, c) for centers in dents.values() for r, c in centers}
   343	    groups: dict[int, list[list[tuple[int, int]]]] = {int(color): [] for color in dents}
   344	
   345	    for color, centers in dents.items():
   346	        for r, c in centers:
   347	            cells = [(int(r), int(c))]
   348	            if rng.random() < DENT_PAIR_PROB:
   349	                neighbors = [(r + 1, c), (r - 1, c), (r, c + 1), (r, c - 1)]
   350	                rng.shuffle(neighbors)
   351	                for nr, nc in neighbors:
   352	                    if not (0 <= nr < h and 0 <= nc < w):
   353	                        continue
   354	                    if (nr, nc) in occupied:
   355	                        continue
   356	                    if int(clean[nr, nc]) != int(color):
   357	                        continue
   358	                    if not _is_safe_dent_center(clean, nr, nc, int(color), colors):
   359	                        continue
   360	                    if any(max(abs(nr - rr), abs(nc - cc)) < DENT_PATCH_SEPARATION for rr, cc in occupied if (rr, cc) != (r, c)):
   361	                        continue
   362	                    cells.append((int(nr), int(nc)))
   363	                    occupied.add((int(nr), int(nc)))
   364	                    break
   365	            groups[int(color)].append(cells)
   366	    return groups
