   161	def _dent_centers(
   162	    original: np.ndarray, clean: np.ndarray, colors: tuple[int, int, int], bg: int
   163	) -> list[tuple[int, int, int]]:
   164	    centers: list[tuple[int, int, int]] = []
   165	    for r, c in np.argwhere(original == int(bg)):
   166	        rr = int(r)
   167	        cc = int(c)
   168	        dominant = _dominant_color(_sub3x3(clean, rr, cc), colors, threshold=5)
   169	        if dominant is not None:
   170	            centers.append((rr, cc, int(dominant)))
   171	    return centers
