    85	def _dominant_color(sub: np.ndarray, colors: tuple[int, int, int], threshold: int = 5) -> int | None:
    86	    counts = {int(color): int(np.sum(sub == int(color))) for color in colors}
    87	    best = max(counts.values())
    88	    winners = [color for color, count in counts.items() if count == best]
    89	    if best < threshold or len(winners) != 1:
    90	        return None
    91	    return int(winners[0])
