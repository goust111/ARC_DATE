   314	def _pick_dent_centers(
   315	    valid: dict[int, list[tuple[int, int]]], wanted: dict[int, int], rng: random.Random
   316	) -> dict[int, list[tuple[int, int]]] | None:
   317	    chosen: dict[int, list[tuple[int, int]]] = {int(color): [] for color in valid}
   318	    occupied: list[tuple[int, int]] = []
   319	    order = sorted(valid, key=lambda color: len(valid[int(color)]))
   320	
   321	    for color in order:
   322	        candidates = valid[int(color)].copy()
   323	        rng.shuffle(candidates)
   324	        for r, c in candidates:
   325	            if all(max(abs(r - rr), abs(c - cc)) >= DENT_PATCH_SEPARATION for rr, cc in occupied):
   326	                chosen[int(color)].append((int(r), int(c)))
   327	                occupied.append((int(r), int(c)))
   328	                if len(chosen[int(color)]) >= int(wanted[int(color)]):
   329	                    break
   330	        if len(chosen[int(color)]) < int(wanted[int(color)]):
   331	            return None
   332	    return chosen
