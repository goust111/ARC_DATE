    73	def _has_same_2x2(g: np.ndarray, r: int, c: int, color: int) -> bool:
    74	    h, w = g.shape
    75	    for dr in (-1, 0):
    76	        for dc in (-1, 0):
    77	            rr = int(r) + dr
    78	            cc = int(c) + dc
    79	            if 0 <= rr < h - 1 and 0 <= cc < w - 1:
    80	                if bool(np.all(g[rr : rr + 2, cc : cc + 2] == int(color))):
    81	                    return True
    82	    return False
