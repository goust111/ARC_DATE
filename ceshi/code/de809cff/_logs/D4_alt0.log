   251	def _build_regions(N: int, role_colors: dict[str, int], rng: random.Random) -> np.ndarray | None:
   252	    left = int(role_colors["left"])
   253	    right = int(role_colors["right"])
   254	    bottom = int(role_colors["bottom"])
   255	
   256	    for _ in range(60):
