   391	def _add_bg_noise(inp: np.ndarray, clean: np.ndarray, n_in_bg: int, colors: tuple[int, int, int], rng: random.Random) -> int:
   392	    bg_candidates = list(np.argwhere(clean == Color.BLACK))
   393	    rng.shuffle(bg_candidates)
   394	
   395	    placed = 0
   396	    for r, c in bg_candidates:
   397	        if placed >= n_in_bg:
   398	            break
   399	        rr = int(r)
   400	        cc = int(c)
   401	        if int(inp[rr, cc]) != int(Color.BLACK):
   402	            continue
   403	        if int(np.sum(_sub3x3(inp, rr, cc) == Color.BLACK)) < BG_SPECK_MIN_BG_3x3:
   404	            continue
   405	        inp[rr, cc] = _nearby_speck_color(clean, rr, cc, colors, rng)
   406	        placed += 1
   407	    return placed
