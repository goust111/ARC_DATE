   138	def _role_colors(clean: np.ndarray, colors: tuple[int, int, int]) -> dict[str, int]:
   139	    stats: dict[int, tuple[float, float]] = {}
   140	    for color in colors:
   141	        coords = np.argwhere(clean == int(color))
   142	        assert len(coords) > 0, "missing region color"
   143	        stats[int(color)] = (float(coords[:, 0].mean()), float(coords[:, 1].mean()))
   144	
   145	    bottom = max(colors, key=lambda color: stats[int(color)][0])
   146	    top_two = [int(color) for color in colors if int(color) != int(bottom)]
   147	    left = min(top_two, key=lambda color: stats[int(color)][1])
   148	    right = max(top_two, key=lambda color: stats[int(color)][1])
   149	    return {"left": int(left), "right": int(right), "bottom": int(bottom)}
   150	
   151	
   152	def _stamp_map(clean: np.ndarray, colors: tuple[int, int, int]) -> dict[int, int]:
   153	    roles = _role_colors(clean, colors)
   154	    return {
   155	        int(roles["left"]): int(roles["right"]),
   156	        int(roles["right"]): int(roles["bottom"]),
   157	        int(roles["bottom"]): int(roles["left"]),
   158	    }
