    61	def _sub3x3(grid: np.ndarray, r: int, c: int) -> np.ndarray:
    62	    h, w = grid.shape
    63	    return grid[max(0, r - 1) : min(h, r + 2), max(0, c - 1) : min(w, c + 2)]
