   303	def _is_safe_dent_center(grid: np.ndarray, r: int, c: int, host: int, colors: tuple[int, int, int]) -> bool:
   304	    if int(grid[r, c]) != int(host):
   305	        return False
   306	    sub = _sub3x3(grid, r, c)
   307	    counts = {int(color): int(np.sum(sub == int(color))) for color in colors}
   308	    counts[int(host)] -= 1
   309	    host_count = counts[int(host)]
   310	    other_max = max(counts[int(color)] for color in colors if int(color) != int(host))
   311	    return host_count >= DENT_MIN_HOST_3x3 and host_count > other_max
