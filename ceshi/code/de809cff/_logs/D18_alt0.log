def _variant_metrics(
    clean: np.ndarray,
    groups_a: list[list[tuple[int, int]]],
    groups_b: list[list[tuple[int, int]]],
    color_a: int,
    color_b: int,
) -> dict[str, int]:
    centers = _flatten_groups(groups_a, color_a) + _flatten_groups(groups_b, color_b)
    cover, _ = _patch_coverages(clean.shape, centers, (color_a, color_b))
    center_mask = np.zeros(clean.shape, dtype=bool)
    for r, c, _host in centers:
        center_mask[r, c] = True
    conflict = cover >= 2
    return {
        "dent_cells": len(centers),
        "conflict_pixels": int(np.sum(conflict)),
        "extra_conflict_teal": int(np.sum(conflict & ~center_mask)),
        "overlap_groups": sum(1 for cells in groups_a + groups_b if len(cells) >= 2),
    }


