def _is_safe_dent_center(grid: np.ndarray, r: int, c: int, host: int, other: int) -> bool:
    if grid[r, c] != host:
        return False
    sub = _sub3x3(grid, r, c)
    host_count = int(np.sum(sub == host)) - 1
    return host_count >= DENT_MIN_HOST_3x3 and host_count > int(np.sum(sub == other))


def _would_form_2x2(grid: np.ndarray, r: int, c: int, color: int) -> bool:
    h, w = grid.shape
    for dr in (-1, 0):
        for dc in (-1, 0):
            rr, cc = r + dr, c + dc
            if 0 <= rr < h - 1 and 0 <= cc < w - 1:
                block = grid[rr : rr + 2, cc : cc + 2].copy()
                block[r - rr, c - cc] = color
                if int(np.sum(block == color)) == 4:
                    return True
    return False


def _cheb(a: tuple[int, int], b: tuple[int, int]) -> int:
    return max(abs(int(a[0]) - int(b[0])), abs(int(a[1]) - int(b[1])))


def _far_from_others(
    cell: tuple[int, int], chosen_cells: set[tuple[int, int]], min_gap: int
) -> bool:
    return all(_cheb(cell, other) >= min_gap for other in chosen_cells)


def _pick_overlap_group(
    candidates: list[tuple[int, int]],
    chosen_cells: set[tuple[int, int]],
    rng: random.Random,
) -> list[tuple[int, int]] | None:
    candidate_set = set(candidates)
    anchors = candidates[:]
    rng.shuffle(anchors)
    for r, c in anchors:
        anchor = (int(r), int(c))
        if not _far_from_others(anchor, chosen_cells, DENT_GROUP_SPACING):
            continue
        dirs = [(1, 0), (-1, 0), (0, 1), (0, -1)]
        rng.shuffle(dirs)
        for dr, dc in dirs:
            second = (anchor[0] + dr, anchor[1] + dc)
            if second not in candidate_set or not _far_from_others(second, chosen_cells, DENT_GROUP_SPACING):
                continue
            if rng.random() < OVERLAP_GROUP_TRIPLE_PROB:
                third = (anchor[0] + 2 * dr, anchor[1] + 2 * dc)
                if third in candidate_set and _far_from_others(third, chosen_cells, DENT_GROUP_SPACING):
                    return [anchor, second, third]
            return [anchor, second]
    return None


def _pick_isolated_cells(
    candidates: list[tuple[int, int]],
    chosen_cells: set[tuple[int, int]],
    count: int,
    rng: random.Random,
) -> list[tuple[int, int]] | None:
    pool = candidates[:]
    rng.shuffle(pool)
    picked: list[tuple[int, int]] = []
    blocked = set(chosen_cells)
    for r, c in pool:
        cell = (int(r), int(c))
        if _far_from_others(cell, blocked, DENT_GROUP_SPACING):
            picked.append(cell)
            blocked.add(cell)
            if len(picked) == count:
                return picked
    return None


def _plan_overlap_sizes(target_cells: int, rng: random.Random) -> list[int] | None:
    low, high = OVERLAP_GROUPS_PER_COLOR
    options: list[list[int]] = []
    for n_groups in range(low, high + 1):
        if 2 * n_groups > target_cells:
            continue
        max_extra = target_cells - 2 * n_groups
        for mask in range(1 << n_groups):
            triples = int(mask.bit_count())
            if triples <= max_extra:
                sizes = [3 if (mask >> i) & 1 else 2 for i in range(n_groups)]
                if sum(sizes) < target_cells:
                    options.append(sizes)
    if not options:
        return None
    rng.shuffle(options)
    options.sort(key=lambda sizes: (len(sizes), -sum(sizes)), reverse=True)
    return options[0]


def _choose_groups_for_color(
    candidates: list[tuple[int, int]],
    target_count: int,
    chosen_cells: set[tuple[int, int]],
    rng: random.Random,
) -> list[list[tuple[int, int]]] | None:
    overlap_sizes = _plan_overlap_sizes(target_count, rng)
    if overlap_sizes is None:
        return None

    groups: list[list[tuple[int, int]]] = []
    occupied = set(chosen_cells)
    for size in overlap_sizes:
        group = _pick_overlap_group(candidates, occupied, rng)
        if group is None:
            return None
        if len(group) > size:
            group = group[:size]
        while len(group) < size:
            return None
        groups.append(group)
        occupied.update(group)

    singles_needed = target_count - sum(len(group) for group in groups)
    if singles_needed > 0:
        singles = _pick_isolated_cells(candidates, occupied, singles_needed, rng)
        if singles is None:
            return None
        for cell in singles:
            groups.append([cell])
        occupied.update(singles)

    chosen_cells.update(occupied - set(chosen_cells))
    return groups


def _flatten_groups(groups: list[list[tuple[int, int]]], host: int) -> list[tuple[int, int, int]]:
    return [(r, c, host) for cells in groups for r, c in cells]


def _stamp_dents(
    clean: np.ndarray,
    dent_groups_a: list[list[tuple[int, int]]],
    dent_groups_b: list[list[tuple[int, int]]],
    color_a: int,
    color_b: int,
) -> np.ndarray:
    centers = _flatten_groups(dent_groups_a, color_a) + _flatten_groups(dent_groups_b, color_b)
    return _compose_output(clean, centers, (color_a, color_b))


def _add_bg_noise(inp: np.ndarray, clean: np.ndarray, n_in_bg: int, color_a: int, color_b: int, rng: random.Random) -> None:
    bg_candidates = list(zip(*np.where(clean == 0), strict=False))
    rng.shuffle(bg_candidates)

    placed = 0
    for r_, c_ in bg_candidates:
        if placed >= n_in_bg:
            break
        r, c = int(r_), int(c_)
        sub = _sub3x3(inp, r, c)
        if int(np.sum(sub == 0)) < BG_SPECK_MIN_BG_3x3:
            continue
        nearby = _sub3x3(clean, r, c)
        nearby_fg = [int(x) for x in nearby.flat if int(x) != 0]
        speck_color = _Counter(nearby_fg).most_common(1)[0][0] if nearby_fg else rng.choice([color_a, color_b])
        inp[r, c] = speck_color
        placed += 1


def _neighbor_cleanup_safe(inp: np.ndarray, r: int, c: int, host: int, other: int) -> bool:
    h, w = inp.shape
    for dr in (-1, 0, 1):
        for dc in (-1, 0, 1):
            if dr == 0 and dc == 0:
                continue
            nr, nc = r + dr, c + dc
            if not (0 <= nr < h and 0 <= nc < w) or inp[nr, nc] != host:
                continue
            nsub = _sub3x3(inp, nr, nc).copy()
            nr0, nc0 = max(0, nr - 1), max(0, nc - 1)
            nsub[r - nr0, c - nc0] = other
            own_n = int(np.sum(nsub == host))
            other_n = int(np.sum(nsub == other))
            bg_n = int(np.sum(nsub == 0))
            if (other_n > own_n and other_n >= 5) or own_n <= 2 or (bg_n >= 5 and own_n <= 4):
                return False
    return True


def _add_boundary_noise(inp: np.ndarray, clean: np.ndarray, n_at_boundary: int, color_a: int, color_b: int, rng: random.Random) -> None:
    h, w = clean.shape
    boundary_candidates = []
    for r in range(h):
        for c in range(w):
