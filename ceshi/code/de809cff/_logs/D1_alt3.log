   229	def _sub3x3(grid: np.ndarray, r: int, c: int) -> np.ndarray:
   230	    """Return the 3x3 neighborhood of (r,c), clipped to grid bounds."""
   231	    h, w = grid.shape
   232	    return grid[max(0, r - 1) : min(h, r + 2), max(0, c - 1) : min(w, c + 2)]
   233	
   234	
   235	def _build_regions(N: int, color_a: int, color_b: int, rng: random.Random) -> np.ndarray | None:
   236	    """Paint 2-3 overlapping rectangles (simple occlusion, painter's algorithm)."""
   237	    n_rects = rng.choice([2, 3])
   238	    corners = ["TL", "TR", "BL", "BR"]
   239	    rng.shuffle(corners)
   240	    chosen_corners = corners[:n_rects]
   241	
   242	    if n_rects == 2:
   243	        rect_colors = [color_a, color_b]
   244	        rng.shuffle(rect_colors)
   245	    else:
   246	        first = rng.choice([color_a, color_b])
   247	        mid = color_b if first == color_a else color_a
   248	        rect_colors = [first, mid, first]
   249	
   250	    def _make_rect(corner: str) -> tuple[int, int, int, int]:
   251	        h = rng.randint(int(N * RECT_SIZE_FRAC_MIN), int(N * RECT_SIZE_FRAC_MAX))
   252	        w = rng.randint(int(N * RECT_SIZE_FRAC_MIN), int(N * RECT_SIZE_FRAC_MAX))
   253	        m = rng.randint(0, RECT_MARGIN_MAX)
   254	        r0 = m if corner[0] == "T" else max(0, N - h - m)
   255	        c0 = m if corner[1] == "L" else max(0, N - w - m)
   256	        return r0, c0, min(N, r0 + h), min(N, c0 + w)
   257	
   258	    grid = np.zeros((N, N), dtype=int)
   259	    for corner, color in zip(chosen_corners, rect_colors):
   260	        r0, c0, r1, c1 = _make_rect(corner)
   261	        grid[r0:r1, c0:c1] = color
   262	
   263	    cnt_a = int(np.sum(grid == color_a))
   264	    cnt_b = int(np.sum(grid == color_b))
   265	    if cnt_a < MIN_REGION_CELLS or cnt_b < MIN_REGION_CELLS:
   266	        return None
   267	    coverage = (cnt_a + cnt_b) / (N * N)
   268	    if not (COVERAGE_MIN <= coverage <= COVERAGE_MAX):
   269	        return None
   270	    if n_rects == 3:
   271	        from scipy.ndimage import label
   272	
   273	        _, n_components = label(grid == rect_colors[0])
   274	        if n_components < 2:
   275	            return None
   276	    return grid
   277	
