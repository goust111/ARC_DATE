   311	
   312	def _pick_dent_centers(
   313	    candidates: list[tuple[int, int]],
   314	    n: int,
   315	    rng: random.Random,
   316	    blocked: list[tuple[int, int]] | None = None,
   317	) -> list[tuple[int, int]] | None:
   318	    """Select n dent centers with Chebyshev spacing against both chosen and blocked cells."""
   319	    blocked = [] if blocked is None else list(blocked)
   320	    pool = candidates.copy()
   321	    rng.shuffle(pool)
   322	    chosen: list[tuple[int, int]] = []
   323	    for r, c in pool:
   324	        if _far_from(r, c, blocked, DENT_PATCH_SEPARATION) and _far_from(r, c, chosen, DENT_PATCH_SEPARATION):
   325	            chosen.append((r, c))
   326	            if len(chosen) >= n:
   327	                return chosen
   328	    return None
   329	
   330	
   331	def _pick_visible_dents(
   332	    all_candidates: list[tuple[int, int]],
   333	    mixed_candidates: list[tuple[int, int]],
   334	    n: int,
   335	    blocked: list[tuple[int, int]],
   336	    rng: random.Random,
   337	) -> list[tuple[int, int]] | None:
   338	    min_mixed = min(len(mixed_candidates), max(1, int(np.ceil(n * MIXED_DENT_RATIO_MIN))))
   339	    max_mixed = min(n, len(mixed_candidates))
   340	    for want_mixed in range(max_mixed, min_mixed - 1, -1):
   341	        chosen_mixed = _pick_dent_centers(mixed_candidates, want_mixed, rng, blocked)
   342	        if chosen_mixed is None:
   343	            continue
   344	        remaining_pool = [p for p in all_candidates if p not in set(chosen_mixed)]
   345	        chosen_rest = _pick_dent_centers(remaining_pool, n - want_mixed, rng, blocked + chosen_mixed)
   346	        if chosen_rest is not None:
   347	            return chosen_mixed + chosen_rest
   348	    return None
   349	
   350	
   351	def _expand_to_pairs(
   352	    dents: list[tuple[int, int]],
   353	    host: int,
   354	    other: int,
   355	    clean: np.ndarray,
   356	    blocked: list[tuple[int, int]],
   357	    rng: random.Random,
   358	) -> list[list[tuple[int, int]]]:
   359	    """Optionally expand single-cell dents into 2-cell adjacent pairs (~13% chance each)."""
   360	    h, w = clean.shape
   361	    result: list[list[tuple[int, int]]] = []
   362	    for r, c in dents:
   363	        cells = [(r, c)]
   364	        if rng.random() < DENT_PAIR_PROB:
   365	            neighbors = [(r + 1, c), (r - 1, c), (r, c + 1), (r, c - 1)]
   366	            rng.shuffle(neighbors)
   367	            for nr, nc in neighbors:
   368	                if not (0 <= nr < h and 0 <= nc < w):
   369	                    continue
   370	                if int(clean[nr, nc]) != int(host) or not _is_safe_dent_center(clean, nr, nc, host, other):
   371	                    continue
   372	                blocked_others = [pt for pt in blocked if pt != (r, c)]
   373	                if not _far_from(nr, nc, blocked_others, DENT_PATCH_SEPARATION):
   374	                    continue
   375	                same_color_others = [pt for pt in dents if pt != (r, c)]
   376	                if not _far_from(nr, nc, same_color_others, DENT_PATCH_SEPARATION):
   377	                    continue
   378	                cells.append((nr, nc))
   379	                break
   380	        result.append(cells)
   381	    return result
   382	
   383	
   384	def _all_dent_centers(
   385	    dent_groups_a: list[list[tuple[int, int]]], dent_groups_b: list[list[tuple[int, int]]], color_a: int, color_b: int
   386	) -> list[tuple[int, int, int]]:
   387	    centers: list[tuple[int, int, int]] = []
   388	    for cells in dent_groups_a:
   389	        for r, c in cells:
   390	            centers.append((r, c, int(color_a)))
   391	    for cells in dent_groups_b:
   392	        for r, c in cells:
   393	            centers.append((r, c, int(color_b)))
   394	    return centers
