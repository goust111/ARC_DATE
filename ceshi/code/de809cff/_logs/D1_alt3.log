   505	def _gen_attempt(rng: random.Random) -> np.ndarray | None:
   506	    N = rng.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)
   507	    fg_pool = [c for c in Color.NOT_BLACK if c != Color.TEAL]
   508	    color_a, color_b = rng.sample(fg_pool, 2)
   509	
   510	    clean = _build_regions(N, color_a, color_b, rng)
   511	    if clean is None:
   512	        return None
   513	
   514	    n_total = rng.randint(DENT_COUNT_MIN, DENT_COUNT_MAX)
   515	    n_a, n_b = n_total // 2, n_total - n_total // 2
   516	    if rng.random() < 0.5:
   517	        n_a, n_b = n_b, n_a
   518	
   519	    h, w = clean.shape
   520	    valid = {color_a: [], color_b: []}
   521	    mixed = {color_a: [], color_b: []}
   522	    for r in range(h):
   523	        for c in range(w):
   524	            v = int(clean[r, c])
   525	            if v == color_a and _is_safe_dent_center(clean, r, c, color_a, color_b):
   526	                valid[color_a].append((r, c))
   527	                if _dent_neighbor_counts(clean, r, c, color_a, color_b)[1] >= MIXED_DENT_OTHER_MIN:
   528	                    mixed[color_a].append((r, c))
   529	            elif v == color_b and _is_safe_dent_center(clean, r, c, color_b, color_a):
   530	                valid[color_b].append((r, c))
   531	                if _dent_neighbor_counts(clean, r, c, color_b, color_a)[1] >= MIXED_DENT_OTHER_MIN:
   532	                    mixed[color_b].append((r, c))
   533	
   534	    if len(valid[color_a]) < n_a + 2 or len(valid[color_b]) < n_b + 2:
   535	        return None
   536	
   537	    dents_a = _pick_visible_dents(valid[color_a], mixed[color_a], n_a, [], rng)
   538	    dents_b = _pick_visible_dents(valid[color_b], mixed[color_b], n_b, dents_a or [], rng)
   539	    if dents_a is None or dents_b is None:
   540	        return None
   541	
   542	    base_centers = dents_a + dents_b
   543	    groups_a = _expand_to_pairs(dents_a, color_a, color_b, clean, base_centers, rng)
   544	    groups_b = _expand_to_pairs(dents_b, color_b, color_a, clean, base_centers, rng)
   545	
   546	    output = _stamp_dents(clean, groups_a, groups_b, color_a, color_b)
   547	    legacy_output = _legacy_stamp_dents(clean, groups_a, groups_b, color_a, color_b)
   548	    if int(np.count_nonzero(output != legacy_output)) < LEGACY_DIFF_PIXELS_MIN:
   549	        return None
   550	
   551	    inp = _dented_clean(clean, groups_a, groups_b)
   552	
   553	    n_noise = rng.randint(NOISE_COUNT_MIN, NOISE_COUNT_MAX)
   554	    n_in_bg = int(round(n_noise * rng.uniform(BG_NOISE_FRAC_MIN, BG_NOISE_FRAC_MAX)))
   555	    _add_bg_noise(inp, clean, n_in_bg, color_a, color_b, rng)
   556	    _add_boundary_noise(inp, clean, n_noise - n_in_bg, color_a, color_b, rng)
   557	
   558	    try:
   559	        produced = main(inp)
   560	    except Exception:
   561	        return None
   562	    if not np.array_equal(produced, output):
   563	        return None
   564	    return inp
