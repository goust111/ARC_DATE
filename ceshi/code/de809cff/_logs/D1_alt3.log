   472	def _add_boundary_noise(inp: np.ndarray, clean: np.ndarray, n_at_boundary: int, color_a: int, color_b: int, rng: random.Random) -> None:
   473	    """Place cross-color contamination at region-region boundaries."""
   474	    h, w = clean.shape
   475	    boundary_candidates = []
   476	    for r in range(h):
   477	        for c in range(w):
   478	            v = int(clean[r, c])
   479	            if v not in (color_a, color_b):
   480	                continue
   481	            other = color_b if v == color_a else color_a
   482	            if int(np.sum(_sub3x3(clean, r, c) == other)) >= 1:
   483	                boundary_candidates.append((r, c, v, other))
   484	    rng.shuffle(boundary_candidates)
   485	
   486	    placed = 0
   487	    for r, c, host, other in boundary_candidates:
   488	        if placed >= n_at_boundary:
   489	            break
   490	        if int(inp[r, c]) != int(host):
   491	            continue
   492	        sub_now = _sub3x3(inp, r, c)
   493	        host_count = int(np.sum(sub_now == host))
   494	        other_count = int(np.sum(sub_now == other))
   495	        if host_count < BOUNDARY_MIN_HOST_3x3 or host_count - 1 <= other_count + 1:
   496	            continue
   497	        if _would_form_2x2(inp, r, c, other):
   498	            continue
   499	        if not _neighbor_cleanup_safe(inp, r, c, host, other):
   500	            continue
   501	        inp[r, c] = other
   502	        placed += 1
