   451	def _neighbor_cleanup_safe(inp: np.ndarray, r: int, c: int, host: int, other: int) -> bool:
   452	    """Check that changing (r,c) to `other` won't cause the solver to misclassify any neighbor."""
   453	    h, w = inp.shape
   454	    for dr in (-1, 0, 1):
   455	        for dc in (-1, 0, 1):
   456	            if dr == 0 and dc == 0:
   457	                continue
   458	            nr, nc = r + dr, c + dc
   459	            if not (0 <= nr < h and 0 <= nc < w) or int(inp[nr, nc]) != int(host):
   460	                continue
   461	            nsub = _sub3x3(inp, nr, nc).copy()
   462	            nr0, nc0 = max(0, nr - 1), max(0, nc - 1)
   463	            nsub[r - nr0, c - nc0] = other
   464	            own_n = int(np.sum(nsub == host))
   465	            other_n = int(np.sum(nsub == other))
   466	            bg_n = int(np.sum(nsub == 0))
   467	            if (other_n > own_n and other_n >= 5) or own_n <= 2 or (bg_n >= 5 and own_n <= 4):
   468	                return False
   469	    return True
   470	
