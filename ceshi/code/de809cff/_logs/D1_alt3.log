   279	def _dent_neighbor_counts(grid: np.ndarray, r: int, c: int, host: int, other: int) -> tuple[int, int]:
   280	    sub = _sub3x3(grid, r, c)
   281	    host_count = int(np.sum(sub == host)) - 1
   282	    other_count = int(np.sum(sub == other))
   283	    return host_count, other_count
   284	
   285	
   286	def _is_safe_dent_center(grid: np.ndarray, r: int, c: int, host: int, other: int) -> bool:
   287	    """After setting (r,c) to black, the solver must detect it as a dent in host region."""
   288	    if int(grid[r, c]) != int(host):
   289	        return False
   290	    host_count, other_count = _dent_neighbor_counts(grid, r, c, host, other)
   291	    return host_count >= DENT_MIN_HOST_3x3 and host_count > other_count
