   407	def _stamp_dents(
   408	    clean: np.ndarray, dent_groups_a: list[list[tuple[int, int]]], dent_groups_b: list[list[tuple[int, int]]], color_a: int, color_b: int
   409	) -> np.ndarray:
   410	    """Build output by toggling foreground colors inside dent 3x3s and marking teal centers."""
   411	    centers = _all_dent_centers(dent_groups_a, dent_groups_b, color_a, color_b)
   412	    return _apply_dent_swaps(clean, centers, (color_a, color_b))
   413	
   414	
   415	def _legacy_stamp_dents(
   416	    clean: np.ndarray, dent_groups_a: list[list[tuple[int, int]]], dent_groups_b: list[list[tuple[int, int]]], color_a: int, color_b: int
   417	) -> np.ndarray:
   418	    """Old task behavior, kept only to reject degenerate samples."""
   419	    h, w = clean.shape
   420	    out = clean.copy()
   421	    for dent_groups, stamp_color in ((dent_groups_a, color_b), (dent_groups_b, color_a)):
   422	        for cells in dent_groups:
   423	            for r, c in cells:
   424	                out[max(0, r - 1) : min(h, r + 2), max(0, c - 1) : min(w, c + 2)] = int(stamp_color)
   425	    for cells in dent_groups_a + dent_groups_b:
   426	        for r, c in cells:
   427	            out[r, c] = Color.TEAL
   428	    return out
