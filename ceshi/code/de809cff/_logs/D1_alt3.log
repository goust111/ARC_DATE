   397	def _dented_clean(
   398	    clean: np.ndarray, dent_groups_a: list[list[tuple[int, int]]], dent_groups_b: list[list[tuple[int, int]]]
   399	) -> np.ndarray:
   400	    base = clean.copy()
   401	    for cells in dent_groups_a + dent_groups_b:
   402	        for r, c in cells:
   403	            base[r, c] = Color.BLACK
   404	    return base
