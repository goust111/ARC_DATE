   567	def generate_input() -> np.ndarray:
   568	    rng = random.Random()
   569	    for _ in range(MAX_GENERATION_ATTEMPTS):
   570	        try:
   571	            grid = _gen_attempt(rng)
   572	        except Exception:
   573	            grid = None
