   431	def _add_bg_noise(inp: np.ndarray, clean: np.ndarray, n_in_bg: int, color_a: int, color_b: int, rng: random.Random) -> None:
   432	    """Place isolated fg-color specks in background area."""
   433	    bg_candidates = list(zip(*np.where(clean == 0), strict=False))
   434	    rng.shuffle(bg_candidates)
   435	
   436	    placed = 0
   437	    for r_, c_ in bg_candidates:
   438	        if placed >= n_in_bg:
   439	            break
   440	        r, c = int(r_), int(c_)
   441	        sub = _sub3x3(inp, r, c)
   442	        if int(np.sum(sub == 0)) < BG_SPECK_MIN_BG_3x3:
   443	            continue
   444	        nearby = _sub3x3(clean, r, c)
   445	        nearby_fg = [int(x) for x in nearby.flat if int(x) != 0]
   446	        speck_color = _Counter(nearby_fg).most_common(1)[0][0] if nearby_fg else rng.choice([color_a, color_b])
   447	        inp[r, c] = speck_color
   448	        placed += 1
