   171	def main(grid: np.ndarray) -> np.ndarray:
   172	    """
   173	    Turn black dents in two colored regions into local color-swap mosaics.
   174	
   175	    Input structure:
   176	    - Black background with two large foreground colors.
   177	    - The large regions contain small black dents and a few one-cell color specks
   178	      or protrusions near the region boundaries.
   179	
   180	    Rule:
   181	    - First clean the two foreground regions: isolated specks become black, and
   182	      one-cell cross-boundary contamination is restored to its surrounding region.
   183	    - Each original black dent whose cleaned 3x3 neighborhood is mostly one
   184	      foreground color toggles the two foreground colors inside that 3x3 window.
   185	    - Only already-foreground cells swap colors; black cells stay black, and the
   186	      dent center itself is finally recolored teal (8).
   187	
   188	    Key insight: The black cells that survive cleanup are the true dents; each of
   189	    them acts like a 3x3 local A<->B color toggle rather than a solid repaint.
   190	    """
   191	    g = np.asarray(grid, dtype=int)
   192	    bg = Color.BLACK
   193	    colors = _main_colors(g, bg)
   194	    clean = _clean_foreground(g, colors, bg)
   195	    centers = _dent_centers(g, clean, colors, bg)
   196	    return _apply_dent_swaps(clean, centers, colors)
