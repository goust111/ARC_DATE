+# Variant of de809cff
+# Dimension: D1 — 核心变换规则：凹痕到3x3补丁 (transform)
+# Change: 每个黑色凹痕的3x3邻域多数前景色为A时，凹痕变为3x3的前景色B补丁，中心为teal(8)
+#   → 颜色交换：凹痕附近的同侧色像素变为对侧色，对侧色像素变为同侧色
+
+from __future__ import annotations
+
+from collections import Counter as _Counter
+import random
+
+import numpy as np
+from scipy.ndimage import label
+
+from arc_utils import Color
+
+# Design analysis for the D1 variant
+# a) Concrete behavior:
+#    - The original task cleans two large foreground regions, finds black dents, then overwrites each dent's 3x3
+#      neighborhood with the opposite color and marks the center teal.
+#    - This variant keeps the cleanup and dent detection stages unchanged, but changes the local effect:
+#      inside the dent's clipped 3x3 window, every foreground A pixel becomes B and every foreground B pixel
+#      becomes A. Black background cells stay black. The dent center is part of the cleaned host region, so it
+#      participates in the swap and is then recolored teal.
+#    - Small example on the cleaned grid (A=3, B=4, X=black dent in input, center at row 2 col 2):
+#          A A B      B B A
+#          A X B  ->  B 8 A
+#          A A A      B B B
+#      Old rule: the whole 3x3 would become B except the teal center. New rule: the pre-existing B cells flip
+#      back to A, so the output is a local mosaic instead of a solid patch.
+# b) Complexity calibration:
+#    - If every dent were placed deep inside a monochrome region, the new rule would look too similar to the
+#      original one. The generator therefore forces a substantial fraction of dents to sit in 3x3 windows that
+#      already contain both foreground colors, while still keeping host-color majority so the dent is detectable.
+#    - We keep only two foreground colors, so the swap rule is visually inferable from a few examples.
+# c) Implicit-assumption audit:
+#    - In the original main(), `out[window] = other` relied on patch stamping being idempotent. That assumption
+#      breaks for this variant because overlapping dents, especially 2-cell pairs, would depend on update order.
+#    - The new implementation accumulates a parity mask over all dent windows and swaps colors on the cleaned
+#      base grid only where the number of covering dents is odd. This matches "each dent triggers a local swap"
+#      while remaining order-independent.
+#    - The cleanup logic still assumes foreground noise is one-cell contamination and that true dents are black
+#      in the original grid but supported by >=5 host cells in the cleaned 3x3 neighborhood; the generator still
+#      constructs inputs to satisfy those assumptions.
+# d) Placement legality:
+#    - Distinct dent centers from different regions now also obey a global Chebyshev separation, so unrelated
+#      swap windows do not overlap. The only intentional overlap comes from 2-cell dent pairs, where the parity
+#      interpretation is well-defined.
+#    - Pair expansion checks the same dent-detectability predicate as single dents and avoids collisions with all
+#      other centers, so blackened inputs stay solvable.
+# e) Visual observability:
+#    - The generator rejects layouts with too few mixed-color dent candidates and then samples many dents from
+#      those mixed candidates. This makes the swap visible on non-center pixels, not only at the teal marks.
+# f) Visual cleanliness:
+#    - Most dent windows remain separated; only occasional 2-cell pairs overlap. This preserves readable local
+#      motifs instead of turning large areas into noisy interference patterns.
+# g) Color inference:
+#    - The only color operation is a direct swap between the two visible region colors inside a geometric 3x3
+#      neighborhood around each teal-marked defect. No rule depends on numeric color ids or hidden ordering.
+
+
+def _main_colors(g: np.ndarray, bg: int) -> tuple[int, int]:
+    colors = [int(c) for c in np.unique(g) if int(c) != int(bg)]
+    colors.sort(key=lambda c: int(np.sum(g == c)), reverse=True)
+    assert len(colors) >= 2, "expected two foreground colors"
+    return int(colors[0]), int(colors[1])
+
+
+def _has_same_2x2(g: np.ndarray, r: int, c: int, color: int) -> bool:
+    h, w = g.shape
+    for dr in (-1, 0):
+        for dc in (-1, 0):
+            rr = int(r) + dr
+            cc = int(c) + dc
+            if 0 <= rr < h - 1 and 0 <= cc < w - 1:
+                if bool(np.all(g[rr : rr + 2, cc : cc + 2] == int(color))):
+                    return True
+    return False
+
+
+def _clean_foreground(g: np.ndarray, colors: tuple[int, int], bg: int) -> np.ndarray:
+    """
+    Remove one-cell specks/protrusions before detecting black dents.
+
+    Two sweeps are enough for the observed corruption pattern: the first removes
+    protruding wrong-color cells, the second lets their neighboring true cells
+    keep the corrected local majority.
+    """
+    h, w = g.shape
+    a, b = map(int, colors)
+    cur = g.copy()
+
+    for _ in range(2):
+        nxt = cur.copy()
+        for r in range(h):
+            for c in range(w):
+                v = int(cur[r, c])
+                if v not in colors:
+                    nxt[r, c] = bg
+                    continue
+
+                sub = cur[max(0, r - 1) : min(h, r + 2), max(0, c - 1) : min(w, c + 2)]
+                own = int(np.sum(sub == v))
+                other = b if v == a else a
+                other_count = int(np.sum(sub == other))
+                bg_count = int(np.sum(sub == bg))
+
+                if _has_same_2x2(cur, r, c, v):
+                    nxt[r, c] = v
+                elif other_count > own and other_count >= 5:
+                    nxt[r, c] = other
+                elif bg_count >= 5 and own <= 4:
+                    nxt[r, c] = bg
+                elif own <= 2:
+                    nxt[r, c] = bg
+                else:
+                    nxt[r, c] = v
+        cur = nxt
+
+    return cur
+
+
+def _dent_centers(
+    original: np.ndarray, clean: np.ndarray, colors: tuple[int, int], bg: int
+) -> list[tuple[int, int, int]]:
+    h, w = original.shape
+    centers: list[tuple[int, int, int]] = []
+    for r, c in zip(*np.where(original == int(bg)), strict=False):
+        rr = int(r)
+        cc = int(c)
+        sub = clean[max(0, rr - 1) : min(h, rr + 2), max(0, cc - 1) : min(w, cc + 2)]
+        counts = {int(color): int(np.sum(sub == int(color))) for color in colors}
+        host = max(colors, key=lambda color: counts[int(color)])
+        other = colors[1] if int(host) == int(colors[0]) else colors[0]
+        if counts[int(host)] >= 5 and counts[int(host)] > counts[int(other)]:
+            centers.append((rr, cc, int(host)))
+    return centers
+
+
+def _swap_dent_windows(
+    clean: np.ndarray, centers: list[tuple[int, int, int]], colors: tuple[int, int]
+) -> np.ndarray:
+    h, w = clean.shape
+    a, b = map(int, colors)
+    toggle = np.zeros((h, w), dtype=np.uint8)
+
+    for r, c, _host in centers:
+        toggle[max(0, r - 1) : min(h, r + 2), max(0, c - 1) : min(w, c + 2)] ^= 1
+
+    out = clean.copy()
+    odd = toggle.astype(bool)
+    out[(clean == a) & odd] = b
+    out[(clean == b) & odd] = a
+
+    for r, c, _host in centers:
+        out[r, c] = Color.TEAL
+    return out
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Turn black dents in two colored regions into teal-centered local color swaps.
+
+    Input structure:
+    - Black background with two large foreground colors.
+    - The foreground regions contain black dents plus a few one-cell specks or
+      boundary protrusions that must be cleaned first.
+
+    Rule:
+    - Clean the two foreground regions locally: isolated stray cells become
+      black, and one-cell boundary contamination is reassigned to the region
+      that dominates its neighborhood.
+    - For each original black dent whose cleaned 3x3 neighborhood is mostly one
+      foreground color, flip the two foreground colors inside that clipped 3x3
+      window; background cells stay black.
+    - Recolor every dent center teal (8) after the local swaps are applied.
+
+    Key insight: The teal cells still identify the original black defects, but
+    their 3x3 neighborhoods are no longer solid opposite-color stamps; they are
+    foreground-only A<->B swaps performed on the cleaned regions.
+    """
+    g = np.asarray(grid, dtype=int)
+    bg = Color.BLACK
+    colors = _main_colors(g, bg)
+    clean = _clean_foreground(g, colors, bg)
+    centers = _dent_centers(g, clean, colors, bg)
+    return _swap_dent_windows(clean, centers, colors)
+
+
+# --------------- generator (cx) ---------------
+
+# --- CFG: canvas & region layout ---
+GRID_SIZE_MIN, GRID_SIZE_MAX = 20, 30
+RECT_SIZE_FRAC_MIN, RECT_SIZE_FRAC_MAX = 0.45, 0.75
+RECT_MARGIN_MAX = 3
+MIN_REGION_CELLS = 100
+COVERAGE_MIN, COVERAGE_MAX = 0.55, 0.85
+
+# --- CFG: dent placement ---
+DENT_COUNT_MIN, DENT_COUNT_MAX = 12, 22
+DENT_MIN_HOST_3x3 = 5
+DENT_PATCH_SEPARATION = 3
+DENT_PAIR_PROB = 0.13
+DENT_MIXED_FRAC_MIN, DENT_MIXED_FRAC_MAX = 0.35, 0.65
+MIN_VISIBLE_DENTS = 4
+
+# --- CFG: noise ---
+NOISE_COUNT_MIN, NOISE_COUNT_MAX = 7, 22
+BG_NOISE_FRAC_MIN, BG_NOISE_FRAC_MAX = 0.65, 0.85
+BG_SPECK_MIN_BG_3x3 = 6
+BOUNDARY_MIN_HOST_3x3 = 6
+
+# --- CFG: generation control ---
+MAX_GENERATION_ATTEMPTS = 400
+
+
+def _sub3x3(grid: np.ndarray, r: int, c: int) -> np.ndarray:
+    h, w = grid.shape
+    return grid[max(0, r - 1) : min(h, r + 2), max(0, c - 1) : min(w, c + 2)]
+
+
+def _build_regions(N: int, color_a: int, color_b: int, rng: random.Random) -> np.ndarray | None:
+    n_rects = rng.choice([2, 3])
+    corners = ["TL", "TR", "BL", "BR"]
+    rng.shuffle(corners)
+    chosen_corners = corners[:n_rects]
+
+    if n_rects == 2:
+        rect_colors = [color_a, color_b]
+        rng.shuffle(rect_colors)
+    else:
+        first = rng.choice([color_a, color_b])
+        mid = color_b if first == color_a else color_a
+        rect_colors = [first, mid, first]
+
+    def _make_rect(corner: str) -> tuple[int, int, int, int]:
+        h = rng.randint(int(N * RECT_SIZE_FRAC_MIN), int(N * RECT_SIZE_FRAC_MAX))
+        w = rng.randint(int(N * RECT_SIZE_FRAC_MIN), int(N * RECT_SIZE_FRAC_MAX))
+        m = rng.randint(0, RECT_MARGIN_MAX)
+        r0 = m if corner[0] == "T" else max(0, N - h - m)
+        c0 = m if corner[1] == "L" else max(0, N - w - m)
+        return r0, c0, min(N, r0 + h), min(N, c0 + w)
+
+    grid = np.zeros((N, N), dtype=int)
+    for corner, color in zip(chosen_corners, rect_colors):
+        r0, c0, r1, c1 = _make_rect(corner)
+        grid[r0:r1, c0:c1] = color
+
+    cnt_a = int(np.sum(grid == color_a))
+    cnt_b = int(np.sum(grid == color_b))
+    if cnt_a < MIN_REGION_CELLS or cnt_b < MIN_REGION_CELLS:
+        return None
+    coverage = (cnt_a + cnt_b) / (N * N)
+    if not (COVERAGE_MIN <= coverage <= COVERAGE_MAX):
+        return None
+    if n_rects == 3:
+        _, n_components = label(grid == rect_colors[0])
+        if n_components < 2:
+            return None
+    return grid
+
+
+def _dent_counts(grid: np.ndarray, r: int, c: int, host: int, other: int) -> tuple[int, int]:
+    sub = _sub3x3(grid, r, c)
+    host_count = int(np.sum(sub == host)) - 1
+    other_count = int(np.sum(sub == other))
+    return host_count, other_count
+
+
+def _is_safe_dent_center(grid: np.ndarray, r: int, c: int, host: int, other: int) -> bool:
+    if int(grid[r, c]) != int(host):
+        return False
+    host_count, other_count = _dent_counts(grid, r, c, host, other)
+    return host_count >= DENT_MIN_HOST_3x3 and host_count > other_count
+
+
+def _is_mixed_dent_center(grid: np.ndarray, r: int, c: int, host: int, other: int) -> bool:
+    if not _is_safe_dent_center(grid, r, c, host, other):
+        return False
+    _host_count, other_count = _dent_counts(grid, r, c, host, other)
+    return other_count >= 1
+
+
+def _would_form_2x2(grid: np.ndarray, r: int, c: int, color: int) -> bool:
+    h, w = grid.shape
+    for dr in (-1, 0):
+        for dc in (-1, 0):
+            rr, cc = r + dr, c + dc
+            if 0 <= rr < h - 1 and 0 <= cc < w - 1:
+                block = grid[rr : rr + 2, cc : cc + 2].copy()
+                block[r - rr, c - cc] = color
+                if int(np.sum(block == color)) == 4:
+                    return True
+    return False
+
+
+def _far_enough(r: int, c: int, chosen: list[tuple[int, int]]) -> bool:
+    return all(max(abs(r - rr), abs(c - cc)) >= DENT_PATCH_SEPARATION for rr, cc in chosen)
+
+
+def _pick_dent_centers(
+    candidates: list[tuple[int, int]],
+    mixed_candidates: list[tuple[int, int]],
+    n: int,
+    min_mixed: int,
+    blocked: list[tuple[int, int]],
+    rng: random.Random,
+) -> list[tuple[int, int]] | None:
+    chosen: list[tuple[int, int]] = []
+    occupied = list(blocked)
+
+    rng.shuffle(mixed_candidates)
+    for r, c in mixed_candidates:
+        if len(chosen) >= min_mixed:
+            break
+        if _far_enough(r, c, occupied):
+            chosen.append((r, c))
+            occupied.append((r, c))
+    if len(chosen) < min_mixed:
+        return None
+
+    rng.shuffle(candidates)
+    chosen_set = set(chosen)
+    for r, c in candidates:
+        if (r, c) in chosen_set:
+            continue
+        if _far_enough(r, c, occupied):
+            chosen.append((r, c))
+            occupied.append((r, c))
+            chosen_set.add((r, c))
+            if len(chosen) >= n:
+                return chosen
+    return None
+
+
+def _expand_to_pairs(
+    dents: list[tuple[int, int]],
+    host: int,
+    other: int,
+    clean: np.ndarray,
+    blocked: list[tuple[int, int]],
+    rng: random.Random,
+) -> list[list[tuple[int, int]]]:
+    h, w = clean.shape
+    extras: list[tuple[int, int]] = []
+    result: list[list[tuple[int, int]]] = []
+
+    for r, c in dents:
+        cells = [(r, c)]
+        if rng.random() < DENT_PAIR_PROB:
+            neighbors = [(r + 1, c), (r - 1, c), (r, c + 1), (r, c - 1)]
+            rng.shuffle(neighbors)
+            for nr, nc in neighbors:
+                if not (0 <= nr < h and 0 <= nc < w):
+                    continue
+                if int(clean[nr, nc]) != int(host):
+                    continue
+                if not _is_safe_dent_center(clean, nr, nc, host, other):
+                    continue
+                conflict = False
+                for rr, cc in blocked + extras:
+                    if (rr, cc) == (r, c):
+                        continue
+                    if max(abs(nr - rr), abs(nc - cc)) < DENT_PATCH_SEPARATION:
+                        conflict = True
+                        break
+                if conflict:
+                    continue
+                cells.append((nr, nc))
+                extras.append((nr, nc))
+                break
+        result.append(cells)
+    return result
+
+
+def _swap_output_from_groups(
+    clean: np.ndarray,
+    dent_groups_a: list[list[tuple[int, int]]],
+    dent_groups_b: list[list[tuple[int, int]]],
+    color_a: int,
+    color_b: int,
+) -> np.ndarray:
+    centers: list[tuple[int, int, int]] = []
+    for cells in dent_groups_a:
+        centers.extend((r, c, int(color_a)) for r, c in cells)
+    for cells in dent_groups_b:
+        centers.extend((r, c, int(color_b)) for r, c in cells)
+    return _swap_dent_windows(clean, centers, (color_a, color_b))
+
+
+def _add_bg_noise(inp: np.ndarray, clean: np.ndarray, n_in_bg: int, color_a: int, color_b: int, rng: random.Random) -> None:
+    bg_candidates = list(zip(*np.where(clean == 0), strict=False))
+    rng.shuffle(bg_candidates)
+
+    placed = 0
+    for r_, c_ in bg_candidates:
+        if placed >= n_in_bg:
+            break
+        r, c = int(r_), int(c_)
+        sub = _sub3x3(inp, r, c)
+        if int(np.sum(sub == 0)) < BG_SPECK_MIN_BG_3x3:
+            continue
+        nearby = _sub3x3(clean, r, c)
+        nearby_fg = [int(x) for x in nearby.flat if int(x) != 0]
+        speck_color = _Counter(nearby_fg).most_common(1)[0][0] if nearby_fg else rng.choice([color_a, color_b])
+        inp[r, c] = speck_color
+        placed += 1
+
+
+def _neighbor_cleanup_safe(inp: np.ndarray, r: int, c: int, host: int, other: int) -> bool:
+    h, w = inp.shape
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            nr, nc = r + dr, c + dc
+            if not (0 <= nr < h and 0 <= nc < w) or int(inp[nr, nc]) != int(host):
+                continue
+            nsub = _sub3x3(inp, nr, nc).copy()
+            nr0, nc0 = max(0, nr - 1), max(0, nc - 1)
+            nsub[r - nr0, c - nc0] = other
+            own_n = int(np.sum(nsub == host))
+            other_n = int(np.sum(nsub == other))
+            bg_n = int(np.sum(nsub == 0))
+            if (other_n > own_n and other_n >= 5) or own_n <= 2 or (bg_n >= 5 and own_n <= 4):
+                return False
+    return True
+
+
+def _add_boundary_noise(
+    inp: np.ndarray, clean: np.ndarray, n_at_boundary: int, color_a: int, color_b: int, rng: random.Random
+) -> None:
+    h, w = clean.shape
+    boundary_candidates: list[tuple[int, int, int, int]] = []
+    for r in range(h):
+        for c in range(w):
+            v = int(clean[r, c])
+            if v not in (color_a, color_b):
+                continue
+            other = color_b if v == color_a else color_a
+            if int(np.sum(_sub3x3(clean, r, c) == other)) >= 1:
+                boundary_candidates.append((r, c, v, other))
+    rng.shuffle(boundary_candidates)
+
+    placed = 0
+    for r, c, host, other in boundary_candidates:
+        if placed >= n_at_boundary:
+            break
+        if int(inp[r, c]) != int(host):
+            continue
+        sub_now = _sub3x3(inp, r, c)
+        host_count = int(np.sum(sub_now == host))
+        other_count = int(np.sum(sub_now == other))
+        if host_count < BOUNDARY_MIN_HOST_3x3 or host_count - 1 <= other_count + 1:
+            continue
+        if _would_form_2x2(inp, r, c, other):
+            continue
+        if not _neighbor_cleanup_safe(inp, r, c, host, other):
+            continue
+        inp[r, c] = other
+        placed += 1
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    N = rng.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)
+    fg_pool = [c for c in Color.NOT_BLACK if c != Color.TEAL]
+    color_a, color_b = rng.sample(fg_pool, 2)
+
+    clean = _build_regions(N, color_a, color_b, rng)
+    if clean is None:
+        return None
+
+    n_total = rng.randint(DENT_COUNT_MIN, DENT_COUNT_MAX)
+    n_a, n_b = n_total // 2, n_total - n_total // 2
+    if rng.random() < 0.5:
+        n_a, n_b = n_b, n_a
+
+    mixed_frac = rng.uniform(DENT_MIXED_FRAC_MIN, DENT_MIXED_FRAC_MAX)
+
+    h, w = clean.shape
+    valid = {color_a: [], color_b: []}
+    mixed_valid = {color_a: [], color_b: []}
+    for r in range(h):
+        for c in range(w):
+            v = int(clean[r, c])
+            if v == color_a and _is_safe_dent_center(clean, r, c, color_a, color_b):
+                valid[color_a].append((r, c))
+                if _is_mixed_dent_center(clean, r, c, color_a, color_b):
+                    mixed_valid[color_a].append((r, c))
+            elif v == color_b and _is_safe_dent_center(clean, r, c, color_b, color_a):
+                valid[color_b].append((r, c))
+                if _is_mixed_dent_center(clean, r, c, color_b, color_a):
+                    mixed_valid[color_b].append((r, c))
+
+    if len(valid[color_a]) < n_a + 2 or len(valid[color_b]) < n_b + 2:
+        return None
+
+    desired_mixed_a = min(len(mixed_valid[color_a]), max(1, int(round(n_a * mixed_frac))))
+    desired_mixed_b = min(len(mixed_valid[color_b]), max(1, int(round(n_b * mixed_frac))))
+    if desired_mixed_a + desired_mixed_b < MIN_VISIBLE_DENTS:
+        return None
+
+    dents_a = _pick_dent_centers(valid[color_a][:], mixed_valid[color_a][:], n_a, desired_mixed_a, [], rng)
+    if dents_a is None:
+        return None
+    dents_b = _pick_dent_centers(valid[color_b][:], mixed_valid[color_b][:], n_b, desired_mixed_b, dents_a[:], rng)
+    if dents_b is None:
+        return None
+
+    base_centers = dents_a + dents_b
+    groups_a = _expand_to_pairs(dents_a, color_a, color_b, clean, base_centers, rng)
+    groups_b = _expand_to_pairs(dents_b, color_b, color_a, clean, base_centers, rng)
+
+    output = _swap_output_from_groups(clean, groups_a, groups_b, color_a, color_b)
+
+    inp = clean.copy()
+    for cells in groups_a + groups_b:
+        for r, c in cells:
+            inp[r, c] = 0
+
+    n_noise = rng.randint(NOISE_COUNT_MIN, NOISE_COUNT_MAX)
+    n_in_bg = int(round(n_noise * rng.uniform(BG_NOISE_FRAC_MIN, BG_NOISE_FRAC_MAX)))
+    _add_bg_noise(inp, clean, n_in_bg, color_a, color_b, rng)
+    _add_boundary_noise(inp, clean, n_noise - n_in_bg, color_a, color_b, rng)
+
+    try:
+        produced = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(produced, output):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        try:
+            grid = _gen_attempt(rng)
+        except Exception:
+            grid = None
+        if grid is not None:
+            return grid
+    raise RuntimeError("generate_input: failed after %d attempts" % MAX_GENERATION_ATTEMPTS)

diff --git a/ceshi/code/de809cff/D1/3/code.py b/ceshi/code/de809cff/D1/3/code.py
new file mode 100644
index 0000000000000000000000000000000000000000..0e2e6632dcc254b9793da330e3d9250ec514ceb0
--- /dev/null
+++ b/ceshi/code/de809cff/D1/3/code.py
@@ -0,0 +1,543 @@
+# Variant of de809cff
+# Dimension: D1 — 核心变换规则：凹痕到3x3补丁 (transform)
+# Change: 每个黑色凹痕的3x3邻域多数前景色为A时，凹痕变为3x3的前景色B补丁，中心为teal(8)
+#   → 颜色交换：凹痕附近的同侧色像素变为对侧色，对侧色像素变为同侧色
+
+from __future__ import annotations
+
+from collections import Counter as _Counter
+import random
+
+import numpy as np
+from scipy.ndimage import label
+
+from arc_utils import Color
+
+# Design analysis for the D1 variant
+# a) Concrete behavior:
+#    - The original task cleans two large foreground regions, finds black dents, then overwrites each dent's 3x3
+#      neighborhood with the opposite color and marks the center teal.
+#    - This variant keeps the cleanup and dent detection stages unchanged, but changes the local effect:
+#      inside the dent's clipped 3x3 window, every foreground A pixel becomes B and every foreground B pixel
+#      becomes A. Black background cells stay black. The dent center is part of the cleaned host region, so it
+#      participates in the swap and is then recolored teal.
+#    - Small example on the cleaned grid (A=3, B=4, X=black dent in input, center at row 2 col 2):
+#          A A B      B B A
+#          A X B  ->  B 8 A
+#          A A A      B B B
+#      Old rule: the whole 3x3 would become B except the teal center. New rule: the pre-existing B cells flip
+#      back to A, so the output is a local mosaic instead of a solid patch.
+# b) Complexity calibration:
+#    - If every dent were placed deep inside a monochrome region, the new rule would look too similar to the
+#      original one. The generator therefore forces a substantial fraction of dents to sit in 3x3 windows that
+#      already contain both foreground colors, while still keeping host-color majority so the dent is detectable.
+#    - We keep only two foreground colors, so the swap rule is visually inferable from a few examples.
+# c) Implicit-assumption audit:
+#    - In the original main(), `out[window] = other` relied on patch stamping being idempotent. That assumption
+#      breaks for this variant because overlapping dents, especially 2-cell pairs, would depend on update order.
+#    - The new implementation accumulates a parity mask over all dent windows and swaps colors on the cleaned
+#      base grid only where the number of covering dents is odd. This matches "each dent triggers a local swap"
+#      while remaining order-independent.
+#    - The cleanup logic still assumes foreground noise is one-cell contamination and that true dents are black
+#      in the original grid but supported by >=5 host cells in the cleaned 3x3 neighborhood; the generator still
+#      constructs inputs to satisfy those assumptions.
+# d) Placement legality:
+#    - Distinct dent centers from different regions now also obey a global Chebyshev separation, so unrelated
+#      swap windows do not overlap. The only intentional overlap comes from 2-cell dent pairs, where the parity
+#      interpretation is well-defined.
+#    - Pair expansion checks the same dent-detectability predicate as single dents and avoids collisions with all
+#      other centers, so blackened inputs stay solvable.
+# e) Visual observability:
+#    - The generator rejects layouts with too few mixed-color dent candidates and then samples many dents from
+#      those mixed candidates. This makes the swap visible on non-center pixels, not only at the teal marks.
+# f) Visual cleanliness:
+#    - Most dent windows remain separated; only occasional 2-cell pairs overlap. This preserves readable local
+#      motifs instead of turning large areas into noisy interference patterns.
+# g) Color inference:
+#    - The only color operation is a direct swap between the two visible region colors inside a geometric 3x3
+#      neighborhood around each teal-marked defect. No rule depends on numeric color ids or hidden ordering.
+
+
+def _main_colors(g: np.ndarray, bg: int) -> tuple[int, int]:
+    colors = [int(c) for c in np.unique(g) if int(c) != int(bg)]
+    colors.sort(key=lambda c: int(np.sum(g == c)), reverse=True)
+    assert len(colors) >= 2, "expected two foreground colors"
+    return int(colors[0]), int(colors[1])
+
+
+def _has_same_2x2(g: np.ndarray, r: int, c: int, color: int) -> bool:
+    h, w = g.shape
+    for dr in (-1, 0):
+        for dc in (-1, 0):
+            rr = int(r) + dr
+            cc = int(c) + dc
+            if 0 <= rr < h - 1 and 0 <= cc < w - 1:
+                if bool(np.all(g[rr : rr + 2, cc : cc + 2] == int(color))):
+                    return True
+    return False
+
+
+def _clean_foreground(g: np.ndarray, colors: tuple[int, int], bg: int) -> np.ndarray:
+    """
+    Remove one-cell specks/protrusions before detecting black dents.
+
+    Two sweeps are enough for the observed corruption pattern: the first removes
+    protruding wrong-color cells, the second lets their neighboring true cells
+    keep the corrected local majority.
+    """
+    h, w = g.shape
+    a, b = map(int, colors)
+    cur = g.copy()
+
+    for _ in range(2):
+        nxt = cur.copy()
+        for r in range(h):
+            for c in range(w):
+                v = int(cur[r, c])
+                if v not in colors:
+                    nxt[r, c] = bg
+                    continue
+
+                sub = cur[max(0, r - 1) : min(h, r + 2), max(0, c - 1) : min(w, c + 2)]
+                own = int(np.sum(sub == v))
+                other = b if v == a else a
+                other_count = int(np.sum(sub == other))
+                bg_count = int(np.sum(sub == bg))
+
+                if _has_same_2x2(cur, r, c, v):
+                    nxt[r, c] = v
+                elif other_count > own and other_count >= 5:
+                    nxt[r, c] = other
+                elif bg_count >= 5 and own <= 4:
+                    nxt[r, c] = bg
+                elif own <= 2:
+                    nxt[r, c] = bg
+                else:
+                    nxt[r, c] = v
+        cur = nxt
+
+    return cur
+
+
+def _dent_centers(
+    original: np.ndarray, clean: np.ndarray, colors: tuple[int, int], bg: int
+) -> list[tuple[int, int, int]]:
+    h, w = original.shape
+    centers: list[tuple[int, int, int]] = []
+    for r, c in zip(*np.where(original == int(bg)), strict=False):
+        rr = int(r)
+        cc = int(c)
+        sub = clean[max(0, rr - 1) : min(h, rr + 2), max(0, cc - 1) : min(w, cc + 2)]
+        counts = {int(color): int(np.sum(sub == int(color))) for color in colors}
+        host = max(colors, key=lambda color: counts[int(color)])
+        other = colors[1] if int(host) == int(colors[0]) else colors[0]
+        if counts[int(host)] >= 5 and counts[int(host)] > counts[int(other)]:
+            centers.append((rr, cc, int(host)))
+    return centers
+
+
+def _swap_dent_windows(
+    clean: np.ndarray, centers: list[tuple[int, int, int]], colors: tuple[int, int]
+) -> np.ndarray:
+    h, w = clean.shape
+    a, b = map(int, colors)
+    toggle = np.zeros((h, w), dtype=np.uint8)
+
+    for r, c, _host in centers:
+        toggle[max(0, r - 1) : min(h, r + 2), max(0, c - 1) : min(w, c + 2)] ^= 1
+
+    out = clean.copy()
+    odd = toggle.astype(bool)
+    out[(clean == a) & odd] = b
+    out[(clean == b) & odd] = a
+
+    for r, c, _host in centers:
+        out[r, c] = Color.TEAL
+    return out
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Turn black dents in two colored regions into teal-centered local color swaps.
+
+    Input structure:
+    - Black background with two large foreground colors.
+    - The foreground regions contain black dents plus a few one-cell specks or
+      boundary protrusions that must be cleaned first.
+
+    Rule:
+    - Clean the two foreground regions locally: isolated stray cells become
+      black, and one-cell boundary contamination is reassigned to the region
+      that dominates its neighborhood.
+    - For each original black dent whose cleaned 3x3 neighborhood is mostly one
+      foreground color, flip the two foreground colors inside that clipped 3x3
+      window; background cells stay black.
+    - Recolor every dent center teal (8) after the local swaps are applied.
+
+    Key insight: The teal cells still identify the original black defects, but
+    their 3x3 neighborhoods are no longer solid opposite-color stamps; they are
+    foreground-only A<->B swaps performed on the cleaned regions.
+    """
+    g = np.asarray(grid, dtype=int)
+    bg = Color.BLACK
+    colors = _main_colors(g, bg)
+    clean = _clean_foreground(g, colors, bg)
+    centers = _dent_centers(g, clean, colors, bg)
+    return _swap_dent_windows(clean, centers, colors)
+
+
+# --------------- generator (cx) ---------------
+
+# --- CFG: canvas & region layout ---
+GRID_SIZE_MIN, GRID_SIZE_MAX = 20, 30
+RECT_SIZE_FRAC_MIN, RECT_SIZE_FRAC_MAX = 0.45, 0.75
+RECT_MARGIN_MAX = 3
+MIN_REGION_CELLS = 100
+COVERAGE_MIN, COVERAGE_MAX = 0.55, 0.85
+
+# --- CFG: dent placement ---
+DENT_COUNT_MIN, DENT_COUNT_MAX = 12, 22
+DENT_MIN_HOST_3x3 = 5
+DENT_PATCH_SEPARATION = 3
+DENT_PAIR_PROB = 0.13
+DENT_MIXED_FRAC_MIN, DENT_MIXED_FRAC_MAX = 0.35, 0.65
+MIN_VISIBLE_DENTS = 4
+
+# --- CFG: noise ---
+NOISE_COUNT_MIN, NOISE_COUNT_MAX = 7, 22
+BG_NOISE_FRAC_MIN, BG_NOISE_FRAC_MAX = 0.65, 0.85
+BG_SPECK_MIN_BG_3x3 = 6
+BOUNDARY_MIN_HOST_3x3 = 6
+
+# --- CFG: generation control ---
+MAX_GENERATION_ATTEMPTS = 400
+
+
+def _sub3x3(grid: np.ndarray, r: int, c: int) -> np.ndarray:
+    h, w = grid.shape
+    return grid[max(0, r - 1) : min(h, r + 2), max(0, c - 1) : min(w, c + 2)]
+
+
+def _build_regions(N: int, color_a: int, color_b: int, rng: random.Random) -> np.ndarray | None:
+    n_rects = rng.choice([2, 3])
+    corners = ["TL", "TR", "BL", "BR"]
+    rng.shuffle(corners)
+    chosen_corners = corners[:n_rects]
+
+    if n_rects == 2:
+        rect_colors = [color_a, color_b]
+        rng.shuffle(rect_colors)
+    else:
+        first = rng.choice([color_a, color_b])
+        mid = color_b if first == color_a else color_a
+        rect_colors = [first, mid, first]
+
+    def _make_rect(corner: str) -> tuple[int, int, int, int]:
+        h = rng.randint(int(N * RECT_SIZE_FRAC_MIN), int(N * RECT_SIZE_FRAC_MAX))
+        w = rng.randint(int(N * RECT_SIZE_FRAC_MIN), int(N * RECT_SIZE_FRAC_MAX))
+        m = rng.randint(0, RECT_MARGIN_MAX)
+        r0 = m if corner[0] == "T" else max(0, N - h - m)
+        c0 = m if corner[1] == "L" else max(0, N - w - m)
+        return r0, c0, min(N, r0 + h), min(N, c0 + w)
+
+    grid = np.zeros((N, N), dtype=int)
+    for corner, color in zip(chosen_corners, rect_colors):
+        r0, c0, r1, c1 = _make_rect(corner)
+        grid[r0:r1, c0:c1] = color
+
+    cnt_a = int(np.sum(grid == color_a))
+    cnt_b = int(np.sum(grid == color_b))
+    if cnt_a < MIN_REGION_CELLS or cnt_b < MIN_REGION_CELLS:
+        return None
+    coverage = (cnt_a + cnt_b) / (N * N)
+    if not (COVERAGE_MIN <= coverage <= COVERAGE_MAX):
+        return None
+    if n_rects == 3:
+        _, n_components = label(grid == rect_colors[0])
+        if n_components < 2:
+            return None
+    return grid
+
+
+def _dent_counts(grid: np.ndarray, r: int, c: int, host: int, other: int) -> tuple[int, int]:
+    sub = _sub3x3(grid, r, c)
+    host_count = int(np.sum(sub == host)) - 1
+    other_count = int(np.sum(sub == other))
+    return host_count, other_count
+
+
+def _is_safe_dent_center(grid: np.ndarray, r: int, c: int, host: int, other: int) -> bool:
+    if int(grid[r, c]) != int(host):
+        return False
+    host_count, other_count = _dent_counts(grid, r, c, host, other)
+    return host_count >= DENT_MIN_HOST_3x3 and host_count > other_count
+
+
+def _is_mixed_dent_center(grid: np.ndarray, r: int, c: int, host: int, other: int) -> bool:
+    if not _is_safe_dent_center(grid, r, c, host, other):
+        return False
+    _host_count, other_count = _dent_counts(grid, r, c, host, other)
+    return other_count >= 1
+
+
+def _would_form_2x2(grid: np.ndarray, r: int, c: int, color: int) -> bool:
+    h, w = grid.shape
+    for dr in (-1, 0):
+        for dc in (-1, 0):
+            rr, cc = r + dr, c + dc
+            if 0 <= rr < h - 1 and 0 <= cc < w - 1:
+                block = grid[rr : rr + 2, cc : cc + 2].copy()
+                block[r - rr, c - cc] = color
+                if int(np.sum(block == color)) == 4:
+                    return True
+    return False
+
+
+def _far_enough(r: int, c: int, chosen: list[tuple[int, int]]) -> bool:
+    return all(max(abs(r - rr), abs(c - cc)) >= DENT_PATCH_SEPARATION for rr, cc in chosen)
+
+
+def _pick_dent_centers(
+    candidates: list[tuple[int, int]],
+    mixed_candidates: list[tuple[int, int]],
+    n: int,
+    min_mixed: int,
+    blocked: list[tuple[int, int]],
+    rng: random.Random,
+) -> list[tuple[int, int]] | None:
+    chosen: list[tuple[int, int]] = []
+    occupied = list(blocked)
+
+    rng.shuffle(mixed_candidates)
+    for r, c in mixed_candidates:
+        if len(chosen) >= min_mixed:
+            break
+        if _far_enough(r, c, occupied):
+            chosen.append((r, c))
+            occupied.append((r, c))
+    if len(chosen) < min_mixed:
+        return None
+
+    rng.shuffle(candidates)
+    chosen_set = set(chosen)
+    for r, c in candidates:
+        if (r, c) in chosen_set:
+            continue
+        if _far_enough(r, c, occupied):
+            chosen.append((r, c))
+            occupied.append((r, c))
+            chosen_set.add((r, c))
+            if len(chosen) >= n:
+                return chosen
+    return None
+
+
+def _expand_to_pairs(
+    dents: list[tuple[int, int]],
+    host: int,
+    other: int,
+    clean: np.ndarray,
+    blocked: list[tuple[int, int]],
+    rng: random.Random,
+) -> list[list[tuple[int, int]]]:
+    h, w = clean.shape
+    extras: list[tuple[int, int]] = []
+    result: list[list[tuple[int, int]]] = []
+
+    for r, c in dents:
+        cells = [(r, c)]
+        if rng.random() < DENT_PAIR_PROB:
+            neighbors = [(r + 1, c), (r - 1, c), (r, c + 1), (r, c - 1)]
+            rng.shuffle(neighbors)
+            for nr, nc in neighbors:
+                if not (0 <= nr < h and 0 <= nc < w):
+                    continue
+                if int(clean[nr, nc]) != int(host):
+                    continue
+                if not _is_safe_dent_center(clean, nr, nc, host, other):
+                    continue
+                conflict = False
+                for rr, cc in blocked + extras:
+                    if (rr, cc) == (r, c):
+                        continue
+                    if max(abs(nr - rr), abs(nc - cc)) < DENT_PATCH_SEPARATION:
+                        conflict = True
+                        break
+                if conflict:
+                    continue
+                cells.append((nr, nc))
+                extras.append((nr, nc))
+                break
+        result.append(cells)
+    return result
+
+
+def _swap_output_from_groups(
+    clean: np.ndarray,
+    dent_groups_a: list[list[tuple[int, int]]],
+    dent_groups_b: list[list[tuple[int, int]]],
+    color_a: int,
+    color_b: int,
+) -> np.ndarray:
+    centers: list[tuple[int, int, int]] = []
+    for cells in dent_groups_a:
+        centers.extend((r, c, int(color_a)) for r, c in cells)
+    for cells in dent_groups_b:
+        centers.extend((r, c, int(color_b)) for r, c in cells)
+    return _swap_dent_windows(clean, centers, (color_a, color_b))
+
+
+def _add_bg_noise(inp: np.ndarray, clean: np.ndarray, n_in_bg: int, color_a: int, color_b: int, rng: random.Random) -> None:
+    bg_candidates = list(zip(*np.where(clean == 0), strict=False))
+    rng.shuffle(bg_candidates)
+
+    placed = 0
+    for r_, c_ in bg_candidates:
+        if placed >= n_in_bg:
+            break
+        r, c = int(r_), int(c_)
+        sub = _sub3x3(inp, r, c)
+        if int(np.sum(sub == 0)) < BG_SPECK_MIN_BG_3x3:
+            continue
+        nearby = _sub3x3(clean, r, c)
+        nearby_fg = [int(x) for x in nearby.flat if int(x) != 0]
+        speck_color = _Counter(nearby_fg).most_common(1)[0][0] if nearby_fg else rng.choice([color_a, color_b])
+        inp[r, c] = speck_color
+        placed += 1
+
+
+def _neighbor_cleanup_safe(inp: np.ndarray, r: int, c: int, host: int, other: int) -> bool:
+    h, w = inp.shape
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            nr, nc = r + dr, c + dc
+            if not (0 <= nr < h and 0 <= nc < w) or int(inp[nr, nc]) != int(host):
+                continue
+            nsub = _sub3x3(inp, nr, nc).copy()
+            nr0, nc0 = max(0, nr - 1), max(0, nc - 1)
+            nsub[r - nr0, c - nc0] = other
+            own_n = int(np.sum(nsub == host))
+            other_n = int(np.sum(nsub == other))
+            bg_n = int(np.sum(nsub == 0))
+            if (other_n > own_n and other_n >= 5) or own_n <= 2 or (bg_n >= 5 and own_n <= 4):
+                return False
+    return True
+
+
+def _add_boundary_noise(
+    inp: np.ndarray, clean: np.ndarray, n_at_boundary: int, color_a: int, color_b: int, rng: random.Random
+) -> None:
+    h, w = clean.shape
+    boundary_candidates: list[tuple[int, int, int, int]] = []
+    for r in range(h):
+        for c in range(w):
+            v = int(clean[r, c])
+            if v not in (color_a, color_b):
+                continue
+            other = color_b if v == color_a else color_a
+            if int(np.sum(_sub3x3(clean, r, c) == other)) >= 1:
+                boundary_candidates.append((r, c, v, other))
+    rng.shuffle(boundary_candidates)
+
+    placed = 0
+    for r, c, host, other in boundary_candidates:
+        if placed >= n_at_boundary:
+            break
+        if int(inp[r, c]) != int(host):
+            continue
+        sub_now = _sub3x3(inp, r, c)
+        host_count = int(np.sum(sub_now == host))
+        other_count = int(np.sum(sub_now == other))
+        if host_count < BOUNDARY_MIN_HOST_3x3 or host_count - 1 <= other_count + 1:
+            continue
+        if _would_form_2x2(inp, r, c, other):
+            continue
+        if not _neighbor_cleanup_safe(inp, r, c, host, other):
+            continue
+        inp[r, c] = other
+        placed += 1
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    N = rng.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)
+    fg_pool = [c for c in Color.NOT_BLACK if c != Color.TEAL]
+    color_a, color_b = rng.sample(fg_pool, 2)
+
+    clean = _build_regions(N, color_a, color_b, rng)
+    if clean is None:
+        return None
+
+    n_total = rng.randint(DENT_COUNT_MIN, DENT_COUNT_MAX)
+    n_a, n_b = n_total // 2, n_total - n_total // 2
+    if rng.random() < 0.5:
+        n_a, n_b = n_b, n_a
+
+    mixed_frac = rng.uniform(DENT_MIXED_FRAC_MIN, DENT_MIXED_FRAC_MAX)
+
+    h, w = clean.shape
+    valid = {color_a: [], color_b: []}
+    mixed_valid = {color_a: [], color_b: []}
+    for r in range(h):
+        for c in range(w):
+            v = int(clean[r, c])
+            if v == color_a and _is_safe_dent_center(clean, r, c, color_a, color_b):
+                valid[color_a].append((r, c))
+                if _is_mixed_dent_center(clean, r, c, color_a, color_b):
+                    mixed_valid[color_a].append((r, c))
+            elif v == color_b and _is_safe_dent_center(clean, r, c, color_b, color_a):
+                valid[color_b].append((r, c))
+                if _is_mixed_dent_center(clean, r, c, color_b, color_a):
+                    mixed_valid[color_b].append((r, c))
+
+    if len(valid[color_a]) < n_a + 2 or len(valid[color_b]) < n_b + 2:
+        return None
+
+    desired_mixed_a = min(len(mixed_valid[color_a]), max(1, int(round(n_a * mixed_frac))))
+    desired_mixed_b = min(len(mixed_valid[color_b]), max(1, int(round(n_b * mixed_frac))))
+    if desired_mixed_a + desired_mixed_b < MIN_VISIBLE_DENTS:
+        return None
+
+    dents_a = _pick_dent_centers(valid[color_a][:], mixed_valid[color_a][:], n_a, desired_mixed_a, [], rng)
+    if dents_a is None:
+        return None
+    dents_b = _pick_dent_centers(valid[color_b][:], mixed_valid[color_b][:], n_b, desired_mixed_b, dents_a[:], rng)
+    if dents_b is None:
+        return None
+
+    base_centers = dents_a + dents_b
+    groups_a = _expand_to_pairs(dents_a, color_a, color_b, clean, base_centers, rng)
+    groups_b = _expand_to_pairs(dents_b, color_b, color_a, clean, base_centers, rng)
+
+    output = _swap_output_from_groups(clean, groups_a, groups_b, color_a, color_b)
+
+    inp = clean.copy()
+    for cells in groups_a + groups_b:
+        for r, c in cells:
+            inp[r, c] = 0
+
+    n_noise = rng.randint(NOISE_COUNT_MIN, NOISE_COUNT_MAX)
+    n_in_bg = int(round(n_noise * rng.uniform(BG_NOISE_FRAC_MIN, BG_NOISE_FRAC_MAX)))
+    _add_bg_noise(inp, clean, n_in_bg, color_a, color_b, rng)
+    _add_boundary_noise(inp, clean, n_noise - n_in_bg, color_a, color_b, rng)
+
+    try:
+        produced = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(produced, output):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        try:
+            grid = _gen_attempt(rng)
+        except Exception:
+            grid = None
+        if grid is not None:
+            return grid
+    raise RuntimeError("generate_input: failed after %d attempts" % MAX_GENERATION_ATTEMPTS)

