   294	def _would_form_2x2(grid: np.ndarray, r: int, c: int, color: int) -> bool:
   295	    """Check whether placing `color` at (r,c) would complete a 2x2 block of that color."""
   296	    h, w = grid.shape
   297	    for dr in (-1, 0):
   298	        for dc in (-1, 0):
   299	            rr, cc = r + dr, c + dc
   300	            if 0 <= rr < h - 1 and 0 <= cc < w - 1:
   301	                block = grid[rr : rr + 2, cc : cc + 2].copy()
   302	                block[r - rr, c - cc] = color
   303	                if int(np.sum(block == color)) == 4:
   304	                    return True
   305	    return False
