   149	def _apply_dent_swaps(
   150	    clean: np.ndarray, centers: list[tuple[int, int, int]], colors: tuple[int, int]
   151	) -> np.ndarray:
   152	    """Toggle the two foreground colors inside every dent's 3x3 neighborhood."""
   153	    h, w = clean.shape
   154	    a, b = map(int, colors)
   155	    cover = np.zeros((h, w), dtype=np.uint8)
   156	    for r, c, _host in centers:
   157	        cover[max(0, r - 1) : min(h, r + 2), max(0, c - 1) : min(w, c + 2)] ^= 1
   158	
   159	    out = clean.copy()
   160	    odd = cover.astype(bool)
   161	    mask_a = odd & (clean == a)
   162	    mask_b = odd & (clean == b)
   163	    out[mask_a] = b
   164	    out[mask_b] = a
