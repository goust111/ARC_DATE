   286	def _is_visible_patch_center(grid: np.ndarray, r: int, c: int, host: int) -> bool:
   287	    """True when same-color 3x3 stamping changes more than the center cell."""
   288	    sub = _sub3x3(grid, r, c)
   289	    host_count = int(np.sum(sub == int(host)))
   290	    non_host = sub.size - host_count
   291	    return 1 <= non_host <= 2 and host_count >= 6 and _has_same_2x2(grid, r, c, host)
