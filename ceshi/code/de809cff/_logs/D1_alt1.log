   294	def _would_form_2x2(grid: np.ndarray, r: int, c: int, color: int) -> bool:
   295	    h, w = grid.shape
   296	    for dr in (-1, 0):
   297	        for dc in (-1, 0):
   298	            rr, cc = r + dr, c + dc
   299	            if 0 <= rr < h - 1 and 0 <= cc < w - 1:
   300	                block = grid[rr : rr + 2, cc : cc + 2].copy()
   301	                block[r - rr, c - cc] = color
   302	                if int(np.sum(block == color)) == 4:
   303	                    return True
   304	    return False
