   417	def _add_bg_noise(inp, clean, n_in_bg, color_a, color_b, rng):
   418	    """Place isolated fg-color specks in background area."""
   419	    bg_candidates = list(zip(*np.where(clean == 0), strict=False))
   420	    rng.shuffle(bg_candidates)
   421	
   422	    placed = 0
   423	    for r_, c_ in bg_candidates:
   424	        if placed >= n_in_bg:
   425	            break
   426	        r, c = int(r_), int(c_)
   427	        sub = _sub3x3(inp, r, c)
   428	        if int(np.sum(sub == 0)) < BG_SPECK_MIN_BG_3x3:
   429	            continue
   430	        nearby = _sub3x3(clean, r, c)
   431	        nearby_fg = [int(x) for x in nearby.flat if int(x) != 0]
   432	        speck_color = _Counter(nearby_fg).most_common(1)[0][0] if nearby_fg else rng.choice([color_a, color_b])
   433	        inp[r, c] = speck_color
   434	        placed += 1
