   388	def _stamp_dents(clean, dent_groups_a, dent_groups_b, color_a, color_b):
   389	    """Build output by stamping 3x3 host-color patches and marking teal centers."""
   390	    dent_cells = []
   391	    for dent_groups, stamp_color in ((dent_groups_a, color_a), (dent_groups_b, color_b)):
   392	        for cells in dent_groups:
   393	            for r, c in cells:
   394	                dent_cells.append((r, c, stamp_color))
   395	    return _render_centers(clean, sorted(dent_cells))
