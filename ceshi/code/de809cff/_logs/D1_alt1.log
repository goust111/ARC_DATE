   307	def _pick_dent_centers(candidates, n, rng):
   308	    rng.shuffle(candidates)
   309	    chosen = []
   310	    for r, c in candidates:
   311	        if all(max(abs(r - rr), abs(c - cc)) >= DENT_PATCH_SEPARATION for rr, cc in chosen):
   312	            chosen.append((r, c))
   313	            if len(chosen) >= n:
   314	                return chosen
   315	    return None
