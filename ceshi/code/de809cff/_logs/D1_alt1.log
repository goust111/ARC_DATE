count=0
for trial in range(2000):
    N = rng.randint(mod.GRID_SIZE_MIN, mod.GRID_SIZE_MAX)
    fg_pool = [c for c in mod.Color.NOT_BLACK if c "'!= mod.Color.TEAL]
    color_a, color_b = rng.sample(fg_pool, 2)
    clean = mod._build_regions(N, color_a, color_b, rng)
    if clean is None:
        continue
    n_total = rng.randint(mod.DENT_COUNT_MIN, mod.DENT_COUNT_MAX)
    n_a, n_b = n_total // 2, n_total - n_total // 2
    if rng.random() < 0.5:
        n_a, n_b = n_b, n_a
    valid_visible = {color_a: [], color_b: []}
    valid_hidden = {color_a: [], color_b: []}
    h, w = clean.shape
    for r in range(h):
        for c in range(w):
            v = int(clean[r, c])
            if v == color_a and mod._is_safe_dent_center(clean, r, c, color_a, color_b):
                target = valid_visible if mod._is_visible_patch_center(clean, r, c, color_a) else valid_hidden
                target[color_a].append((r, c))
            elif v == color_b and mod._is_safe_dent_center(clean, r, c, color_b, color_a):
                target = valid_visible if mod._is_visible_patch_center(clean, r, c, color_b) else valid_hidden
                target[color_b].append((r, c))
    min_visible_a = mod.VISIBLE_DENTS_PER_COLOR_MIN
    min_visible_b = mod.VISIBLE_DENTS_PER_COLOR_MIN
    if len(valid_visible[color_a]) < min_visible_a or len(valid_visible[color_b]) < min_visible_b:
        continue
    if len(valid_visible[color_a]) + len(valid_hidden[color_a]) < n_a:
        continue
    if len(valid_visible[color_b]) + len(valid_hidden[color_b]) < n_b:
        continue
    dents_a = mod._pick_dent_centers_with_visible(valid_visible[color_a], valid_hidden[color_a], n_a, min(min_visible_a, n_a), rng)
    dents_b = mod._pick_dent_centers_with_visible(valid_visible[color_b], valid_hidden[color_b], n_b, min(min_visible_b, n_b), rng)
    if dents_a is None or dents_b is None:
        continue
    groups_a = mod._expand_to_pairs(dents_a, color_a, color_b, clean, dents_a, rng)
    groups_b = mod._expand_to_pairs(dents_b, color_b, color_a, clean, dents_b, rng)
    output = mod._stamp_dents(clean, groups_a, groups_b, color_a, color_b)
    inp = clean.copy()
    for cells in groups_a + groups_b:
        for r, c in cells:
            inp[r, c] = 0
    n_noise = rng.randint(mod.NOISE_COUNT_MIN, mod.NOISE_COUNT_MAX)
    n_in_bg = int(round(n_noise * rng.uniform(mod.BG_NOISE_FRAC_MIN, mod.BG_NOISE_FRAC_MAX)))
    mod._add_bg_noise(inp, clean, n_in_bg, color_a, color_b, rng)
    mod._add_boundary_noise(inp, clean, n_noise - n_in_bg, color_a, color_b, rng)
    produced = mod.main(inp)
    count += 1
    if not np.array_equal(produced, output):
        diff = np.argwhere(produced != output)
        print('"'mismatch after', count, 'candidates trial', trial, 'diffs', len(diff), 'colors', color_a, color_b, 'n', n_a, n_b)
        rr,cc = diff[0]
        print('first diff', (int(rr),int(cc)))
        print('inp local\\n', inp[max(0,rr-3):rr+4,max(0,cc-3):cc+4])
        print('expected local\\n', output[max(0,rr-3):rr+4,max(0,cc-3):cc+4])
        print('produced local\\n', produced[max(0,rr-3):rr+4,max(0,cc-3):cc+4])
        print('centers', mod._dent_centers(inp, mod._clean_foreground(inp, (color_a, color_b), mod.Color.BLACK), (color_a, color_b), mod.Color.BLACK)[:20])
        break
else:
    print('no mismatch in', count, 'candidates')
