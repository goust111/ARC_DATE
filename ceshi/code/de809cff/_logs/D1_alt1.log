   112	def _clean_foreground(g: np.ndarray, colors: tuple[int, int], bg: int) -> np.ndarray:
   113	    """
   114	    Remove one-cell specks/protrusions before detecting black dents.
   115	
   116	    Two sweeps are enough for the observed corruption pattern: the first removes
   117	    protruding wrong-color cells, the second lets their neighboring true cells
   118	    keep the corrected local majority.
   119	    """
   120	    h, w = g.shape
   121	    a, b = map(int, colors)
   122	    cur = g.copy()
   123	
   124	    for _ in range(2):
   125	        nxt = cur.copy()
   126	        for r in range(h):
   127	            for c in range(w):
   128	                v = int(cur[r, c])
   129	                if v not in colors:
   130	                    nxt[r, c] = bg
   131	                    continue
   132	
   133	                sub = cur[max(0, r - 1) : min(h, r + 2), max(0, c - 1) : min(w, c + 2)]
   134	                own = int(np.sum(sub == v))
   135	                other = b if v == a else a
   136	                other_count = int(np.sum(sub == other))
   137	                bg_count = int(np.sum(sub == bg))
   138	
   139	                if _has_same_2x2(cur, r, c, v):
   140	                    nxt[r, c] = v
   141	                elif other_count > own and other_count >= 5:
   142	                    nxt[r, c] = other
   143	                elif bg_count >= 5 and own <= 4:
   144	                    nxt[r, c] = bg
   145	                elif own <= 2:
   146	                    nxt[r, c] = bg
   147	                else:
   148	                    nxt[r, c] = v
   149	        cur = nxt
   150	
   151	    return cur
