    93	def _main_colors(g: np.ndarray, bg: int) -> tuple[int, int]:
    94	    colors = [int(c) for c in np.unique(g) if int(c) != int(bg)]
    95	    colors.sort(key=lambda c: int(np.sum(g == c)), reverse=True)
    96	    assert len(colors) >= 2, "expected two foreground colors"
    97	    return int(colors[0]), int(colors[1])
