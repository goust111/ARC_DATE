   277	def _is_safe_dent_center(grid: np.ndarray, r: int, c: int, host: int, other: int) -> bool:
   278	    """After setting (r,c) to black, the solver must detect it as a dent in host region."""
   279	    if int(grid[r, c]) != int(host):
   280	        return False
   281	    sub = _sub3x3(grid, r, c)
   282	    host_count = int(np.sum(sub == int(host))) - 1
   283	    return host_count >= DENT_MIN_HOST_3x3 and host_count > int(np.sum(sub == int(other)))
