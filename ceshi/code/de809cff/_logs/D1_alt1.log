   410	    sub = _sub3x3(clean, r, c).copy()
   411	    r0 = max(0, r - 1)
   412	    c0 = max(0, c - 1)
   413	    sub[r - r0, c - c0] = host
   414	    return bool(np.any(sub != int(host)))
