   437	def _neighbor_cleanup_safe(inp, r, c, host, other):
   438	    """Check that changing (r,c) to `other` won't cause the solver to misclassify any neighbor."""
   439	    h, w = inp.shape
   440	    for dr in (-1, 0, 1):
   441	        for dc in (-1, 0, 1):
   442	            if dr == 0 and dc == 0:
   443	                continue
   444	            nr, nc = r + dr, c + dc
   445	            if not (0 <= nr < h and 0 <= nc < w) or inp[nr, nc] != host:
   446	                continue
   447	            nsub = _sub3x3(inp, nr, nc).copy()
   448	            nr0, nc0 = max(0, nr - 1), max(0, nc - 1)
   449	            nsub[r - nr0, c - nc0] = other
   450	            own_n = int(np.sum(nsub == host))
   451	            other_n = int(np.sum(nsub == other))
   452	            bg_n = int(np.sum(nsub == 0))
   453	            if (other_n > own_n and other_n >= 5) or own_n <= 2 or (bg_n >= 5 and own_n <= 4):
   454	                return False
   455	    return True
