   100	def _has_same_2x2(g: np.ndarray, r: int, c: int, color: int) -> bool:
   101	    h, w = g.shape
   102	    for dr in (-1, 0):
   103	        for dc in (-1, 0):
   104	            rr = int(r) + dr
   105	            cc = int(c) + dc
   106	            if 0 <= rr < h - 1 and 0 <= cc < w - 1:
   107	                if bool(np.all(g[rr : rr + 2, cc : cc + 2] == int(color))):
