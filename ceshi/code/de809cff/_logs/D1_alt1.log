   346	def _dent_remains_detectable(grid: np.ndarray, r: int, c: int, host: int, other: int) -> bool:
   347	    """Check the main() dent predicate on an already-blackened working grid."""
   348	    if int(grid[r, c]) != Color.BLACK:
   349	        return False
   350	    sub = _sub3x3(grid, r, c)
   351	    host_count = int(np.sum(sub == int(host)))
   352	    other_count = int(np.sum(sub == int(other)))
   353	    return host_count >= DENT_MIN_HOST_3x3 and host_count > other_count
