   233	def _build_regions(N: int, color_a: int, color_b: int, rng: random.Random) -> np.ndarray | None:
   234	    """Paint 2-3 overlapping rectangles (simple occlusion, painter's algorithm)."""
   235	    n_rects = rng.choice([2, 3])
   236	    corners = ["TL", "TR", "BL", "BR"]
   237	    rng.shuffle(corners)
   238	    chosen_corners = corners[:n_rects]
   239	
   240	    if n_rects == 2:
   241	        rect_colors = [color_a, color_b]
   242	        rng.shuffle(rect_colors)
   243	    else:
   244	        first = rng.choice([color_a, color_b])
   245	        mid = color_b if first == color_a else color_a
   246	        rect_colors = [first, mid, first]
   247	
   248	    def _make_rect(corner: str) -> tuple[int, int, int, int]:
   249	        h = rng.randint(int(N * RECT_SIZE_FRAC_MIN), int(N * RECT_SIZE_FRAC_MAX))
   250	        w = rng.randint(int(N * RECT_SIZE_FRAC_MIN), int(N * RECT_SIZE_FRAC_MAX))
   251	        m = rng.randint(0, RECT_MARGIN_MAX)
   252	        r0 = m if corner[0] == "T" else max(0, N - h - m)
   253	        c0 = m if corner[1] == "L" else max(0, N - w - m)
   254	        return r0, c0, min(N, r0 + h), min(N, c0 + w)
   255	
   256	    grid = np.zeros((N, N), dtype=int)
   257	    for corner, color in zip(chosen_corners, rect_colors):
   258	        r0, c0, r1, c1 = _make_rect(corner)
   259	        grid[r0:r1, c0:c1] = color
   260	
   261	    cnt_a = int(np.sum(grid == color_a))
   262	    cnt_b = int(np.sum(grid == color_b))
   263	    if cnt_a < MIN_REGION_CELLS or cnt_b < MIN_REGION_CELLS:
   264	        return None
   265	    coverage = (cnt_a + cnt_b) / (N * N)
   266	    if not (COVERAGE_MIN <= coverage <= COVERAGE_MAX):
   267	        return None
   268	    if n_rects == 3:
   269	        from scipy.ndimage import label
   270	
   271	        _, n_components = label(grid == rect_colors[0])
   272	        if n_components < 2:
   273	            return None
   274	    return grid
