   398	def _render_centers(clean: np.ndarray, centers: list[tuple[int, int, int]]) -> np.ndarray:
   399	    h, w = clean.shape
   400	    output = clean.copy()
   401	    for r, c, host in centers:
   402	        output[max(0, r - 1) : min(h, r + 2), max(0, c - 1) : min(w, c + 2)] = int(host)
   403	    for r, c, _host in centers:
   404	        output[r, c] = Color.TEAL
   405	    return output
