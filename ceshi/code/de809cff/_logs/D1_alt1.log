   318	def _pick_dent_centers_with_visible(visible, hidden, n: int, min_visible: int, rng: random.Random):
   319	    """Pick n same-color dent centers while reserving enough visually revealing ones."""
   320	    visible = list(visible)
   321	    hidden = list(hidden)
   322	    rng.shuffle(visible)
   323	    rng.shuffle(hidden)
   324	
   325	    chosen: list[tuple[int, int]] = []
   326	
   327	    def _try_add(pool) -> None:
   328	        for r, c in pool:
   329	            if len(chosen) >= n:
   330	                return
   331	            if all(max(abs(r - rr), abs(c - cc)) >= DENT_PATCH_SEPARATION for rr, cc in chosen):
   332	                chosen.append((r, c))
   333	
   334	    _try_add(visible)
   335	    if len(chosen) < min_visible:
   336	        return None
   337	
   338	    remaining = [pos for pos in visible if pos not in chosen] + hidden
   339	    rng.shuffle(remaining)
   340	    _try_add(remaining)
   341	    if len(chosen) != n:
   342	        return None
   343	    return chosen
