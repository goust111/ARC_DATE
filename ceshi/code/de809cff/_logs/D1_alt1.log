   154	def _dent_centers(
   155	    original: np.ndarray, clean: np.ndarray, colors: tuple[int, int], bg: int
   156	) -> list[tuple[int, int, int]]:
   157	    h, w = original.shape
   158	    centers: list[tuple[int, int, int]] = []
   159	    for r, c in zip(*np.where(original == int(bg)), strict=False):
   160	        rr = int(r)
   161	        cc = int(c)
   162	        sub = clean[max(0, rr - 1) : min(h, rr + 2), max(0, cc - 1) : min(w, cc + 2)]
   163	        counts = {int(color): int(np.sum(sub == int(color))) for color in colors}
   164	        host = max(colors, key=lambda color: counts[int(color)])
   165	        other = colors[1] if int(host) == int(colors[0]) else colors[0]
   166	        if counts[int(host)] >= 5 and counts[int(host)] > counts[int(other)]:
   167	            centers.append((rr, cc, int(host)))
