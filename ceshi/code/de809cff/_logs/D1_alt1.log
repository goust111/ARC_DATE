   356	def _expand_to_pairs(dents, host, other, clean, all_dents, rng):
   357	    h, w = clean.shape
   358	    result = []
   359	    for r, c in dents:
   360	        cells = [(r, c)]
   361	        if rng.random() < DENT_PAIR_PROB:
   362	            neighbors = [(r + 1, c), (r - 1, c), (r, c + 1), (r, c - 1)]
   363	            rng.shuffle(neighbors)
   364	            for nr, nc in neighbors:
   365	                if not (0 <= nr < h and 0 <= nc < w):
   366	                    continue
   367	                if clean[nr, nc] != host or not _is_safe_dent_center(clean, nr, nc, host, other):
   368	                    continue
   369	                if all(
   370	                    max(abs(nr - r2), abs(nc - c2)) >= DENT_PATCH_SEPARATION
   371	                    for r2, c2 in all_dents
   372	                    if (r2, c2) != (r, c)
   373	                ):
   374	                    temp = clean.copy()
   375	                    temp[r, c] = Color.BLACK
   376	                    temp[nr, nc] = Color.BLACK
   377	                    if not (
   378	                        _dent_remains_detectable(temp, r, c, host, other)
   379	                        and _dent_remains_detectable(temp, nr, nc, host, other)
   380	                    ):
   381	                        continue
   382	                    cells.append((nr, nc))
   383	                    break
   384	        result.append(cells)
   385	    return result
