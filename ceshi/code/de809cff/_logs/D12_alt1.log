@@ -0,0 +1,653 @@
+# Variant of de809cff
+# Dimension: D12 — 凹痕形状：单像素 vs 多像素 (src)
+# Change: 凹痕主要为单个黑像素（1x1），偶尔出现相邻的2个黑像素... → 凹痕形状编码补丁方向
+
+from __future__ import annotations
+
+import random
+from collections import Counter as _Counter
+
+import numpy as np
+
+from arc_utils import Color
+
+# -----------------------------------------------------------------------------
+# Design analysis for the D12 variant
+#
+# spec_variant:
+#   preserved_structure:
+#     grid: square 20-30
+#     palette: black background + exactly 2 large non-black/non-teal regions
+#     cleanup: unchanged 2-pass local cleanup removes isolated fg specks and
+#       one-cell boundary protrusions before any dent reasoning
+#   changed_core:
+#     dent_detection_unit: black dent connected components in the candidate-dent
+#       mask, not independent black pixels
+#     legal_dent_shapes:
+#       - 1 cell
+#       - 2 horizontally adjacent cells
+#       - 2 vertically adjacent cells
+#     output_mapping:
+#       - 1-cell dent -> standard opposite-color 3x3 patch, center teal
+#       - horizontal 2-cell dent -> opposite-color horizontal bar of length 3;
+#         the bar contains the two teal cells and extends one extra cell toward
+#         the side with stronger host support in the cleaned grid
+#       - vertical 2-cell dent -> analogous vertical length-3 bar
+#   behavior_trace:
+#     original_local_case: |
+#       If two adjacent black dent cells appear inside one region, the original
+#       solver treats them as two separate centers and stamps two overlapping
+#       3x3 patches, producing a 3x4 or 4x3 blob.
+#     new_local_case: |
+#       The same adjacent pair is first grouped as one dent component. Its shape
+#       is classified by the component bbox: 1x2 means horizontal, 2x1 means
+#       vertical. The solver then stamps one thin opposite-color stripe aligned
+#       with that axis, and all original dent cells become teal.
+#     visible_difference: |
+#       The output is no longer only "3x3 around each teal cell". Some teal
+#       pairs now sit inside thin 3-long bars, so shape-to-shape mapping is
+#       visible directly in the output.
+#   implicit_assumption_audit:
+#     - _clean_foreground still assumes noise is one-cell corruption only; this
+#       remains valid because the variant changes only dent geometry.
+#     - old _dent_centers assumed every black candidate cell should be processed
+#       independently. This is invalid once 2-cell dents are meaningful units.
+#     - old main overwrote a 3x3 patch for every detected cell. In the variant,
+#       unconditional per-cell 3x3 stamping would destroy the required thin-bar
+#       outputs for 2-cell dents.
+#     - the new bar-placement rule assumes a 2-cell dent has a meaningful
+#       stronger-support side. The generator therefore prefers pair dents whose
+#       left/right or up/down bar candidates receive different support scores.
+#   placement_legality:
+#     - dent groups are selected with Chebyshev distance >= 3 between every pair
+#       of black dent cells across groups, so local neighborhoods do not
+#       interfere and 3x3 patches stay visually separable.
+#     - pair dents are generated only when both cells remain candidate dents
+#       after blackening the whole pair, and when the induced bar is supported
+#       by the host region.
+#   observability:
+#     - each generated puzzle targets at least one horizontal pair and one
+#       vertical pair when candidate supply permits, so the D12 branch is
+#       represented in the training distribution instead of degenerating to the
+#       original all-3x3 behavior.
+#     - only geometric cues drive the branch choice; color ids are never used.
+#   cleanliness:
+#     - output marks remain limited to opposite-color patches plus teal dent
+#       cells, with no extra symbols. Strong spacing reduces visual clutter.
+# -----------------------------------------------------------------------------
+
+
+def _main_colors(g: np.ndarray, bg: int) -> tuple[int, int]:
+    colors = [int(c) for c in np.unique(g) if int(c) != int(bg)]
+    colors.sort(key=lambda c: int(np.sum(g == c)), reverse=True)
+    assert len(colors) >= 2, "expected two foreground colors"
+    return int(colors[0]), int(colors[1])
+
+
+def _has_same_2x2(g: np.ndarray, r: int, c: int, color: int) -> bool:
+    h, w = g.shape
+    for dr in (-1, 0):
+        for dc in (-1, 0):
+            rr = int(r) + dr
+            cc = int(c) + dc
+            if 0 <= rr < h - 1 and 0 <= cc < w - 1:
+                if bool(np.all(g[rr : rr + 2, cc : cc + 2] == int(color))):
+                    return True
+    return False
+
+
+def _sub3x3(grid: np.ndarray, r: int, c: int) -> np.ndarray:
+    h, w = grid.shape
+    return grid[max(0, r - 1) : min(h, r + 2), max(0, c - 1) : min(w, c + 2)]
+
+
+def _clean_foreground(g: np.ndarray, colors: tuple[int, int], bg: int) -> np.ndarray:
+    """
+    Remove one-cell specks/protrusions before detecting black dents.
+
+    Two sweeps are enough for the observed corruption pattern: the first removes
+    protruding wrong-color cells, the second lets their neighboring true cells
+    keep the corrected local majority.
+    """
+    h, w = g.shape
+    a, b = map(int, colors)
+    cur = g.copy()
+
+    for _ in range(2):
+        nxt = cur.copy()
+        for r in range(h):
+            for c in range(w):
+                v = int(cur[r, c])
+                if v not in colors:
+                    nxt[r, c] = bg
+                    continue
+
+                sub = cur[max(0, r - 1) : min(h, r + 2), max(0, c - 1) : min(w, c + 2)]
+                own = int(np.sum(sub == v))
+                other = b if v == a else a
+                other_count = int(np.sum(sub == other))
+                bg_count = int(np.sum(sub == bg))
+
+                if _has_same_2x2(cur, r, c, v):
+                    nxt[r, c] = v
+                elif other_count > own and other_count >= 5:
+                    nxt[r, c] = other
+                elif bg_count >= 5 and own <= 4:
+                    nxt[r, c] = bg
+                elif own <= 2:
+                    nxt[r, c] = bg
+                else:
+                    nxt[r, c] = v
+        cur = nxt
+
+    return cur
+
+
+def _dent_host(clean: np.ndarray, colors: tuple[int, int], bg: int, r: int, c: int) -> int | None:
+    sub = clean[max(0, r - 1) : min(clean.shape[0], r + 2), max(0, c - 1) : min(clean.shape[1], c + 2)]
+    counts = {int(color): int(np.sum(sub == int(color))) for color in colors}
+    host = max(colors, key=lambda color: counts[int(color)])
+    other = colors[1] if int(host) == int(colors[0]) else colors[0]
+    if counts[int(host)] >= 5 and counts[int(host)] > counts[int(other)]:
+        return int(host)
+    return None
+
+
+def _candidate_host_grid(original: np.ndarray, clean: np.ndarray, colors: tuple[int, int], bg: int) -> np.ndarray:
+    hosts = np.full(original.shape, -1, dtype=int)
+    for r, c in zip(*np.where(original == int(bg)), strict=False):
+        rr = int(r)
+        cc = int(c)
+        host = _dent_host(clean, colors, bg, rr, cc)
+        if host is not None:
+            hosts[rr, cc] = int(host)
+    return hosts
+
+
+def _dent_groups(original: np.ndarray, clean: np.ndarray, colors: tuple[int, int], bg: int) -> list[tuple[list[tuple[int, int]], int]]:
+    hosts = _candidate_host_grid(original, clean, colors, bg)
+    h, w = original.shape
+    seen = np.zeros((h, w), dtype=bool)
+    groups: list[tuple[list[tuple[int, int]], int]] = []
+
+    for r in range(h):
+        for c in range(w):
+            host = int(hosts[r, c])
+            if host < 0 or seen[r, c]:
+                continue
+
+            stack = [(r, c)]
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                cells.append((int(rr), int(cc)))
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(hosts[nr, nc]) == host:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+
+            if len(cells) == 1:
+                groups.append((sorted(cells), host))
+                continue
+            if len(cells) == 2:
+                rows = {cell[0] for cell in cells}
+                cols = {cell[1] for cell in cells}
+                if len(rows) == 1 or len(cols) == 1:
+                    groups.append((sorted(cells), host))
+    return groups
+
+
+def _segment_score(clean: np.ndarray, cells: list[tuple[int, int]], host: int) -> int:
+    rs = [r for r, _ in cells]
+    cs = [c for _, c in cells]
+    r0 = max(0, min(rs) - 1)
+    r1 = min(clean.shape[0], max(rs) + 2)
+    c0 = max(0, min(cs) - 1)
+    c1 = min(clean.shape[1], max(cs) + 2)
+    return int(np.sum(clean[r0:r1, c0:c1] == int(host)))
+
+
+def _bar_cells(clean: np.ndarray, dent_cells: list[tuple[int, int]], host: int) -> list[tuple[int, int]]:
+    if len(dent_cells) == 1:
+        return dent_cells
+
+    cells = sorted(dent_cells)
+    if cells[0][0] == cells[1][0]:
+        r = cells[0][0]
+        c0 = min(cells[0][1], cells[1][1])
+        c1 = max(cells[0][1], cells[1][1])
+        left = [(r, cc) for cc in range(c0 - 1, c1 + 1)]
+        right = [(r, cc) for cc in range(c0, c1 + 2)]
+        candidates = [left, right]
+    else:
+        c = cells[0][1]
+        r0 = min(cells[0][0], cells[1][0])
+        r1 = max(cells[0][0], cells[1][0])
+        up = [(rr, c) for rr in range(r0 - 1, r1 + 1)]
+        down = [(rr, c) for rr in range(r0, r1 + 2)]
+        candidates = [up, down]
+
+    best = candidates[0]
+    best_score = _segment_score(clean, [cell for cell in best if 0 <= cell[0] < clean.shape[0] and 0 <= cell[1] < clean.shape[1]], host)
+    for candidate in candidates[1:]:
+        clipped = [cell for cell in candidate if 0 <= cell[0] < clean.shape[0] and 0 <= cell[1] < clean.shape[1]]
+        score = _segment_score(clean, clipped, host)
+        if score > best_score:
+            best = candidate
+            best_score = score
+    return [cell for cell in best if 0 <= cell[0] < clean.shape[0] and 0 <= cell[1] < clean.shape[1]]
+
+
+def _patch_cells(clean: np.ndarray, dent_cells: list[tuple[int, int]], host: int) -> list[tuple[int, int]]:
+    if len(dent_cells) == 1:
+        r, c = dent_cells[0]
+        cells = []
+        for rr in range(max(0, r - 1), min(clean.shape[0], r + 2)):
+            for cc in range(max(0, c - 1), min(clean.shape[1], c + 2)):
+                cells.append((rr, cc))
+        return cells
+    return _bar_cells(clean, dent_cells, host)
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Turn black dents in two colored regions into marked opposite-color patches.
+
+    Input structure:
+    - Black background with two large foreground colors.
+    - The foreground regions contain black dents that are either single cells or
+      2-cell orthogonal pairs, plus a few one-cell color specks/protrusions.
+
+    Rule:
+    - First clean the two foreground regions locally: isolated foreground specks
+      become black, and one-cell boundary contamination is restored to its host.
+    - Then find black dent components whose cleaned local neighborhood is mostly
+      one foreground color. A 1-cell dent becomes a 3x3 opposite-color patch,
+      while a 2-cell dent becomes a length-3 opposite-color stripe aligned with
+      the dent's horizontal or vertical shape.
+    - Finally recolor every original dent cell in those components to teal (8).
+
+    Key insight: Black defects are no longer processed cell-by-cell. Their
+    connected shape decides whether the opposite-color repair mark is a square or
+    a thin directional bar, after the local foreground cleanup removes noise.
+    """
+    g = np.asarray(grid, dtype=int)
+    bg = Color.BLACK
+    colors = _main_colors(g, bg)
+    clean = _clean_foreground(g, colors, bg)
+
+    out = clean.copy()
+    groups = _dent_groups(g, clean, colors, bg)
+    for dent_cells, host in groups:
+        other = colors[1] if int(host) == int(colors[0]) else colors[0]
+        for r, c in _patch_cells(clean, dent_cells, host):
+            out[r, c] = int(other)
+
+    for dent_cells, _host in groups:
+        for r, c in dent_cells:
+            out[r, c] = Color.TEAL
+
+    return out
+
+
+# --------------- generator (cx) ---------------
+
+# --- CFG: canvas & region layout ---
+GRID_SIZE_MIN, GRID_SIZE_MAX = 20, 30
+RECT_SIZE_FRAC_MIN, RECT_SIZE_FRAC_MAX = 0.45, 0.75
+RECT_MARGIN_MAX = 3
+MIN_REGION_CELLS = 100
+COVERAGE_MIN, COVERAGE_MAX = 0.55, 0.85
+
+# --- CFG: dent placement ---
+DENT_COUNT_MIN, DENT_COUNT_MAX = 12, 22
+DENT_MIN_HOST_3x3 = 5
+DENT_PATCH_SEPARATION = 3
+PAIR_FRACTION_MIN, PAIR_FRACTION_MAX = 0.18, 0.32
+PAIR_COUNT_MIN = 2
+PAIR_DIRECTION_MARGIN = 1
+
+# --- CFG: noise ---
+NOISE_COUNT_MIN, NOISE_COUNT_MAX = 7, 22
+BG_NOISE_FRAC_MIN, BG_NOISE_FRAC_MAX = 0.65, 0.85
+BG_SPECK_MIN_BG_3x3 = 6
+BOUNDARY_MIN_HOST_3x3 = 6
+
+# --- CFG: generation control ---
+MAX_GENERATION_ATTEMPTS = 400
+
+
+def _build_regions(N: int, color_a: int, color_b: int, rng: random.Random) -> np.ndarray | None:
+    n_rects = rng.choice([2, 3])
+    corners = ["TL", "TR", "BL", "BR"]
+    rng.shuffle(corners)
+    chosen_corners = corners[:n_rects]
+
+    if n_rects == 2:
+        rect_colors = [color_a, color_b]
+        rng.shuffle(rect_colors)
+    else:
+        first = rng.choice([color_a, color_b])
+        mid = color_b if first == color_a else color_a
+        rect_colors = [first, mid, first]
+
+    def _make_rect(corner: str) -> tuple[int, int, int, int]:
+        h = rng.randint(int(N * RECT_SIZE_FRAC_MIN), int(N * RECT_SIZE_FRAC_MAX))
+        w = rng.randint(int(N * RECT_SIZE_FRAC_MIN), int(N * RECT_SIZE_FRAC_MAX))
+        m = rng.randint(0, RECT_MARGIN_MAX)
+        r0 = m if corner[0] == "T" else max(0, N - h - m)
+        c0 = m if corner[1] == "L" else max(0, N - w - m)
+        return r0, c0, min(N, r0 + h), min(N, c0 + w)
+
+    grid = np.zeros((N, N), dtype=int)
+    for corner, color in zip(chosen_corners, rect_colors):
+        r0, c0, r1, c1 = _make_rect(corner)
+        grid[r0:r1, c0:c1] = color
+
+    cnt_a = int(np.sum(grid == color_a))
+    cnt_b = int(np.sum(grid == color_b))
+    if cnt_a < MIN_REGION_CELLS or cnt_b < MIN_REGION_CELLS:
+        return None
+    coverage = (cnt_a + cnt_b) / (N * N)
+    if not (COVERAGE_MIN <= coverage <= COVERAGE_MAX):
+        return None
+    if n_rects == 3:
+        from scipy.ndimage import label
+
+        _, n_components = label(grid == rect_colors[0])
+        if n_components < 2:
+            return None
+    return grid
+
+
+def _is_safe_single(clean: np.ndarray, colors: tuple[int, int], host: int, cells: list[tuple[int, int]]) -> bool:
+    trial = clean.copy()
+    for r, c in cells:
+        if trial[r, c] != host:
+            return False
+        trial[r, c] = Color.BLACK
+    for r, c in cells:
+        if _dent_host(trial, colors, Color.BLACK, r, c) != host:
+            return False
+    return True
+
+
+def _group_kind(cells: list[tuple[int, int]]) -> str:
+    if len(cells) == 1:
+        return "single"
+    rows = {r for r, _ in cells}
+    return "hpair" if len(rows) == 1 else "vpair"
+
+
+def _cells_far_enough(cells: list[tuple[int, int]], used: list[list[tuple[int, int]]]) -> bool:
+    for other in used:
+        for r0, c0 in cells:
+            for r1, c1 in other:
+                if max(abs(r0 - r1), abs(c0 - c1)) < DENT_PATCH_SEPARATION:
+                    return False
+    return True
+
+
+def _pair_margin_ok(clean: np.ndarray, cells: list[tuple[int, int]], host: int) -> bool:
+    options = []
+    if cells[0][0] == cells[1][0]:
+        r = cells[0][0]
+        c0 = min(cells[0][1], cells[1][1])
+        c1 = max(cells[0][1], cells[1][1])
+        options = [
+            [(r, cc) for cc in range(c0 - 1, c1 + 1)],
+            [(r, cc) for cc in range(c0, c1 + 2)],
+        ]
+    else:
+        c = cells[0][1]
+        r0 = min(cells[0][0], cells[1][0])
+        r1 = max(cells[0][0], cells[1][0])
+        options = [
+            [(rr, c) for rr in range(r0 - 1, r1 + 1)],
+            [(rr, c) for rr in range(r0, r1 + 2)],
+        ]
+
+    scores = []
+    for option in options:
+        clipped = [cell for cell in option if 0 <= cell[0] < clean.shape[0] and 0 <= cell[1] < clean.shape[1]]
+        scores.append(_segment_score(clean, clipped, host))
+    return abs(scores[0] - scores[1]) >= PAIR_DIRECTION_MARGIN
+
+
+def _enumerate_candidates(clean: np.ndarray, colors: tuple[int, int]) -> dict[int, dict[str, list[list[tuple[int, int]]]]]:
+    h, w = clean.shape
+    candidates: dict[int, dict[str, list[list[tuple[int, int]]]]] = {
+        int(colors[0]): {"single": [], "hpair": [], "vpair": []},
+        int(colors[1]): {"single": [], "hpair": [], "vpair": []},
+    }
+
+    for host in colors:
+        other = colors[1] if int(host) == int(colors[0]) else colors[0]
+        for r in range(h):
+            for c in range(w):
+                if clean[r, c] != host:
+                    continue
+                single = [(r, c)]
+                if _is_safe_single(clean, colors, int(host), single):
+                    candidates[int(host)]["single"].append(single)
+
+                if c + 1 < w and clean[r, c + 1] == host:
+                    pair = [(r, c), (r, c + 1)]
+                    if _is_safe_single(clean, colors, int(host), pair) and _pair_margin_ok(clean, pair, int(host)):
+                        candidates[int(host)]["hpair"].append(pair)
+
+                if r + 1 < h and clean[r + 1, c] == host:
+                    pair = [(r, c), (r + 1, c)]
+                    if _is_safe_single(clean, colors, int(host), pair) and _pair_margin_ok(clean, pair, int(host)):
+                        candidates[int(host)]["vpair"].append(pair)
+    return candidates
+
+
+def _choose_group(
+    selected: list[tuple[list[tuple[int, int]], int]],
+    candidates: dict[int, dict[str, list[list[tuple[int, int]]]]],
+    color_targets: dict[int, int],
+    color_counts: dict[int, int],
+    kinds: tuple[str, ...],
+    rng: random.Random,
+) -> bool:
+    used_cells = [cells for cells, _host in selected]
+    pool: list[tuple[list[tuple[int, int]], int]] = []
+    for host, kind_map in candidates.items():
+        if color_counts[host] >= color_targets[host]:
+            continue
+        for kind in kinds:
+            for cells in kind_map[kind]:
+                if _cells_far_enough(cells, used_cells):
+                    pool.append((cells, host))
+
+    if not pool:
+        return False
+
+    rng.shuffle(pool)
+    pool.sort(key=lambda item: color_counts[item[1]] - color_targets[item[1]])
+    cells, host = pool[0]
+    selected.append((cells, host))
+    color_counts[host] += 1
+    return True
+
+
+def _stamp_groups(clean: np.ndarray, groups_a: list[list[tuple[int, int]]], groups_b: list[list[tuple[int, int]]], color_a: int, color_b: int) -> np.ndarray:
+    output = clean.copy()
+    for dent_groups, host, stamp_color in (
+        (groups_a, color_a, color_b),
+        (groups_b, color_b, color_a),
+    ):
+        for cells in dent_groups:
+            for r, c in _patch_cells(clean, cells, host):
+                output[r, c] = stamp_color
+    for dent_groups in (groups_a, groups_b):
+        for cells in dent_groups:
+            for r, c in cells:
+                output[r, c] = Color.TEAL
+    return output
+
+
+def _add_bg_noise(inp: np.ndarray, clean: np.ndarray, n_in_bg: int, color_a: int, color_b: int, rng: random.Random) -> None:
+    bg_candidates = list(zip(*np.where(clean == 0), strict=False))
+    rng.shuffle(bg_candidates)
+
+    placed = 0
+    for r_, c_ in bg_candidates:
+        if placed >= n_in_bg:
+            break
+        r, c = int(r_), int(c_)
+        sub = _sub3x3(inp, r, c)
+        if int(np.sum(sub == 0)) < BG_SPECK_MIN_BG_3x3:
+            continue
+        nearby = _sub3x3(clean, r, c)
+        nearby_fg = [int(x) for x in nearby.flat if int(x) != 0]
+        speck_color = _Counter(nearby_fg).most_common(1)[0][0] if nearby_fg else rng.choice([color_a, color_b])
+        inp[r, c] = speck_color
+        placed += 1
+
+
+def _would_form_2x2(grid: np.ndarray, r: int, c: int, color: int) -> bool:
+    h, w = grid.shape
+    for dr in (-1, 0):
+        for dc in (-1, 0):
+            rr, cc = r + dr, c + dc
+            if 0 <= rr < h - 1 and 0 <= cc < w - 1:
+                block = grid[rr : rr + 2, cc : cc + 2].copy()
+                block[r - rr, c - cc] = color
+                if int(np.sum(block == color)) == 4:
+                    return True
+    return False
+
+
+def _neighbor_cleanup_safe(inp: np.ndarray, r: int, c: int, host: int, other: int) -> bool:
+    h, w = inp.shape
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            nr, nc = r + dr, c + dc
+            if not (0 <= nr < h and 0 <= nc < w) or inp[nr, nc] != host:
+                continue
+            nsub = _sub3x3(inp, nr, nc).copy()
+            nr0, nc0 = max(0, nr - 1), max(0, nc - 1)
+            nsub[r - nr0, c - nc0] = other
+            own_n = int(np.sum(nsub == host))
+            other_n = int(np.sum(nsub == other))
+            bg_n = int(np.sum(nsub == 0))
+            if (other_n > own_n and other_n >= 5) or own_n <= 2 or (bg_n >= 5 and own_n <= 4):
+                return False
+    return True
+
+
+def _add_boundary_noise(inp: np.ndarray, clean: np.ndarray, n_at_boundary: int, color_a: int, color_b: int, rng: random.Random) -> None:
+    h, w = clean.shape
+    boundary_candidates = []
+    for r in range(h):
+        for c in range(w):
+            v = int(clean[r, c])
+            if v not in (color_a, color_b):
+                continue
+            other = color_b if v == color_a else color_a
+            if int(np.sum(_sub3x3(clean, r, c) == other)) >= 1:
+                boundary_candidates.append((r, c, v, other))
+    rng.shuffle(boundary_candidates)
+
+    placed = 0
+    for r, c, host, other in boundary_candidates:
+        if placed >= n_at_boundary:
+            break
+        if inp[r, c] != host:
+            continue
+        sub_now = _sub3x3(inp, r, c)
+        host_count = int(np.sum(sub_now == host))
+        other_count = int(np.sum(sub_now == other))
+        if host_count < BOUNDARY_MIN_HOST_3x3 or host_count - 1 <= other_count + 1:
+            continue
+        if _would_form_2x2(inp, r, c, other):
+            continue
+        if not _neighbor_cleanup_safe(inp, r, c, host, other):
+            continue
+        inp[r, c] = other
+        placed += 1
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    N = rng.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)
+    fg_pool = [c for c in Color.NOT_BLACK if c != Color.TEAL]
+    color_a, color_b = rng.sample(fg_pool, 2)
+    colors = (color_a, color_b)
+
+    clean = _build_regions(N, color_a, color_b, rng)
+    if clean is None:
+        return None
+
+    n_total = rng.randint(DENT_COUNT_MIN, DENT_COUNT_MAX)
+    n_a, n_b = n_total // 2, n_total - n_total // 2
+    if rng.random() < 0.5:
+        n_a, n_b = n_b, n_a
+    color_targets = {color_a: n_a, color_b: n_b}
+    color_counts = {color_a: 0, color_b: 0}
+
+    candidates = _enumerate_candidates(clean, colors)
+    if any(sum(len(v) for v in candidates[color].values()) < color_targets[color] for color in colors):
+        return None
+
+    pair_target = int(round(n_total * rng.uniform(PAIR_FRACTION_MIN, PAIR_FRACTION_MAX)))
+    pair_target = min(max(PAIR_COUNT_MIN, pair_target), n_total - 2)
+
+    selected: list[tuple[list[tuple[int, int]], int]] = []
+    pair_count = 0
+
+    for required_kind in ("hpair", "vpair"):
+        available = sum(len(candidates[color][required_kind]) for color in colors)
+        if available == 0:
+            return None
+        if not _choose_group(selected, candidates, color_targets, color_counts, (required_kind,), rng):
+            return None
+        pair_count += 1
+
+    while pair_count < pair_target:
+        if not _choose_group(selected, candidates, color_targets, color_counts, ("hpair", "vpair"), rng):
+            break
+        pair_count += 1
+
+    while color_counts[color_a] < color_targets[color_a] or color_counts[color_b] < color_targets[color_b]:
+        if not _choose_group(selected, candidates, color_targets, color_counts, ("single", "hpair", "vpair"), rng):
+            return None
+
+    groups_a = [cells for cells, host in selected if host == color_a]
+    groups_b = [cells for cells, host in selected if host == color_b]
+
+    output = _stamp_groups(clean, groups_a, groups_b, color_a, color_b)
+
+    inp = clean.copy()
+    for cells in groups_a + groups_b:
+        for r, c in cells:
+            inp[r, c] = 0
+
+    n_noise = rng.randint(NOISE_COUNT_MIN, NOISE_COUNT_MAX)
+    n_in_bg = int(round(n_noise * rng.uniform(BG_NOISE_FRAC_MIN, BG_NOISE_FRAC_MAX)))
+    _add_bg_noise(inp, clean, n_in_bg, color_a, color_b, rng)
+    _add_boundary_noise(inp, clean, n_noise - n_in_bg, color_a, color_b, rng)
+
+    try:
+        produced = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(produced, output):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        try:
+            grid = _gen_attempt(rng)
+        except Exception:
+            grid = None
+        if grid is not None:
+            return grid
+    raise RuntimeError(f"generate_input: failed after {MAX_GENERATION_ATTEMPTS} attempts")

