+BG = 7
+BORDER = 3
+LEGEND_SIZE = 4
+PALETTE = [1, 2, 4, 5, 6, 8, 9]
+NUM_TARGETS = 3
+COUNT_PATTERNS = [(2, 1, 1), (2, 2, 1), (3, 1, 1)]
+
+# -- Component shape weights: (mode, weight) --
+SHAPE_WEIGHTS = [5, 3, 2]
+TALL_H = (8, 16)
+TALL_W = (2, 4)
+WIDE_H = (3, 5)
+WIDE_W = (5, 9)
+MED_H = (3, 7)
+MED_W = (2, 9)
+
+# -- Component fill density (fraction of non-zero pixels) --
+DENSITY_LO = 0.10
+DENSITY_HI = 0.55
+
+# -- Component count & kept/deleted split --
+COMP_COUNTS = [4, 5, 6]
+COMP_WEIGHTS = [1, 4, 25]
+NUM_KEPT = 3
+
