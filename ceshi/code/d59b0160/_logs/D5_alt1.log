+def _place_legend(inp: np.ndarray, out: np.ndarray, requirements: dict[int, int]) -> None:
+    """Draw the 4x4 legend box and place repeated target colors according to the quota map."""
+    s = LEGEND_SIZE
+    for g in (inp, out):
