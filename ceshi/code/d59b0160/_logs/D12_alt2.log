    33	#       component pixels in scan order carry colors [0,1,4,8,1,4,5]
    34	#       original_logic:
    35	#         present colors = {0,1,4,5,8} -> legend subset satisfied -> delete
    36	#       new_logic:
    37	#         first 0 ignored, first 1 ignored, first 4 ignored, first 8 ignored,
    38	#         second 1 adds 1, second 4 adds 4, 5 seen only once
    39	#         effective matching set = {1,4}
