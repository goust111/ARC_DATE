+    seq: list[int] = []
+    seen: set[int] = set()
+    for rr in range(h):
+        for cc in range(w):
+            if not mask[rr, cc]:
+                continue
+            color = int(local[rr, cc])
+            if color in targets and color not in seen:
+                seen.add(color)
+                seq.append(color)
