+
+# -- Grid & legend constants --
+GRID_H, GRID_W = 16, 16
+BG = 7
+BORDER = 3
+LEGEND_SIZE = 4
+PALETTE = [1, 2, 4, 5, 6, 8, 9]
+NUM_TARGETS = 3
+
+LEGEND_TEMPLATES = [
+    [(0, 0), (1, 2), (2, 1)],
+    [(0, 1), (1, 0), (2, 2)],
+    [(0, 2), (1, 0), (2, 1)],
+]
+
