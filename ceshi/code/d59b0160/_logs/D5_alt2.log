+        if not target_set.issubset(cols):
+            continue
+        if _component_sequence(g, pts, target_set) == legend_seq:
+            for r, c in pts:
+                out[r, c] = bg
+    return out
+
+
+# --------------- generator (o5x) ---------------
+
+# -- Grid & legend constants --
+GRID_H, GRID_W = 16, 16
+BG = 7
+BORDER = 3
+LEGEND_SIZE = 4
+PALETTE = [1, 2, 4, 5, 6, 8, 9]
+NUM_TARGETS = 3
