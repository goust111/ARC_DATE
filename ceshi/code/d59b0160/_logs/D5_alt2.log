+    """Row-major first-occurrence sequence of target colors inside the component bbox."""
+    r0, c0 = pts.min(axis=0)
+    r1, c1 = pts.max(axis=0)
+    h = int(r1 - r0 + 1)
+    w = int(c1 - c0 + 1)
+
+    local = np.zeros((h, w), dtype=int)
+    mask = np.zeros((h, w), dtype=bool)
+    for r, c in pts:
+        rr = int(r - r0)
+        cc = int(c - c0)
+        local[rr, cc] = int(g[r, c])
+        mask[rr, cc] = True
+
+    seq: list[int] = []
+    seen: set[int] = set()
+    for rr in range(h):
+        for cc in range(w):
+            if not mask[rr, cc]:
