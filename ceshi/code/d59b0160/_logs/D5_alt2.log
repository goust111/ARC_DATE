+    """Choose a proper ordered subsequence of the targets."""
+    k = random.randint(0, NUM_TARGETS - 1)
+    if k == 0:
+        return []
+    indices = sorted(random.sample(range(NUM_TARGETS), k))
+    return [targets[i] for i in indices]
