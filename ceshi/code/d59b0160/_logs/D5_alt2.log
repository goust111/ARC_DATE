+    h, w = g.shape
+    sizes = [LEGEND_SIZE] + [sz for sz in range(2, min(h, w) + 1) if sz != LEGEND_SIZE]
+    for sz in sizes:
+        x = int(g[sz - 1, sz - 1])
+        if x == bg:
+            continue
+        if np.all(g[sz - 1, 0:sz] == x) and np.all(g[0:sz, sz - 1] == x):
+            inside = g[0 : sz - 1, 0 : sz - 1]
+            seq: list[int] = []
+            for r in range(inside.shape[0]):
+                for c in range(inside.shape[1]):
