+    mask = np.zeros((h, w), dtype=bool)
+    for r, c in pts:
+        rr = int(r - r0)
+        cc = int(c - c0)
+        local[rr, cc] = int(g[r, c])
+        mask[rr, cc] = True
+
+    seq: list[int] = []
+    seen: set[int] = set()
+    for rr in range(h):
+        for cc in range(w):
+            if not mask[rr, cc]:
