+        [(0, 0), (mid_r, w - 1), (h - 1, mid_c)],
+        [(0, mid_c), (mid_r, 0), (h - 1, w - 1)],
+        [(0, w - 1), (mid_r, mid_c), (h - 1, 0)],
+    ]
+
+
+def _wrong_permutation(targets: list[int]) -> list[int]:
+    """Random non-identity permutation of the target sequence."""
