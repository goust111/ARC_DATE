def _legend_positions_bottom_right() -> list[tuple[int, int]]:
    isolated = random.choice([(1, 1), (1, 2), (2, 1), (2, 2)])
    border_side = [(0, 0), (0, 1), (0, 2), (1, 0), (2, 0)]
    side_choices = [
