        if abs(p[0] - isolated[0]) + abs(p[1] - isolated[1]) != 1
    ]
    positions = [isolated] + random.sample(side_choices, 2)
    random.shuffle(positions)
    return positions


def _place_legends(inp: np.ndarray, out: np.ndarray, first: list[int], second: list[int]) -> None:
    s = LEGEND_SIZE
    br_r0 = GRID_H - s
    br_c0 = GRID_W - s
    for g in (inp, out):
