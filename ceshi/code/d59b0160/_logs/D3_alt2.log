+WIDE_H = (3, 5)
+WIDE_W = (4, 8)
+MED_H = (3, 7)
+MED_W = (2, 9)
+
+DENSITY_LO = 0.10
+DENSITY_HI = 0.55
+
+COMP_COUNTS = [4, 5, 6]
+COMP_WEIGHTS = [8, 4, 1]
+NUM_KEPT = 3
+
+MAX_RETRIES = 1200
