+    assert legend_colors, "legend contains no target colors"
+
+    out = g.copy()
+    for pts in components_mask(g != bg, connectivity=4):
+        cols = {int(g[r, c]) for r, c in pts}
+        if legend_colors.issubset(cols):
+            for r, c in pts:
+                out[r, c] = bg
+    return out
