+DENSITY_HI = 0.55
+
+COMP_COUNTS = [4, 5, 6]
+COMP_WEIGHTS = [8, 4, 1]
+NUM_KEPT = 3
+
+MAX_RETRIES = 1200
+EDGE_ORDER = ("top", "bottom", "left", "right")
+
+
