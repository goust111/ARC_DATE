+
+GRID_H, GRID_W = 16, 16
+BG = 7
+BORDER = 3
+PALETTE = [1, 2, 4, 5, 6, 8, 9]
+NUM_TARGETS = 3
+
+SHAPE_WEIGHTS = [5, 3, 2]
+TALL_H = (8, 16)
+TALL_W = (2, 4)
+WIDE_H = (3, 5)
+WIDE_W = (5, 9)
+MED_H = (3, 7)
+MED_W = (2, 9)
+
+DENSITY_LO = 0.10
+DENSITY_HI = 0.55
+
+COMP_COUNTS = [4, 5, 6]
