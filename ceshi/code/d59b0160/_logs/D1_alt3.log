+
+GRID_H, GRID_W = 16, 16
+BG = 7
+BORDER = 3
+LEGEND_SIZE = 4
+PALETTE = [1, 2, 4, 5, 6, 8, 9]
+NUM_TARGETS = 4
+DELETE_THRESHOLD = _delete_threshold(NUM_TARGETS)
+
+SHAPE_WEIGHTS = [5, 3, 2]
+TALL_H = (8, 16)
+TALL_W = (2, 4)
+WIDE_H = (3, 5)
+WIDE_W = (5, 9)
+MED_H = (3, 7)
+MED_W = (2, 9)
+
+DENSITY_LO = 0.10
+DENSITY_HI = 0.55
+
+COMP_COUNTS = [4, 5, 6]
+COMP_WEIGHTS = [1, 4, 25]
+NUM_KEPT = 3
+
+MAX_RETRIES = 400
+
+SAFE_LEGEND_LAYOUTS = [
+    [(0, 0), (1, 1), (0, 2), (2, 0)],
+    [(0, 0), (1, 1), (0, 2), (2, 2)],
+    [(0, 0), (1, 1), (2, 0), (2, 2)],
+]
+
+
