+    positions = random.choice(SAFE_LEGEND_LAYOUTS)
+    colors = targets[:]
+    random.shuffle(colors)
+    for color, (r, c) in zip(colors, positions):
+        inp[r, c] = color
+        out[r, c] = color
+
