+    threshold = _delete_threshold(len(legend_colors))
+    out = g.copy()
+    comps = components_mask(g != bg, connectivity=4)
+    for pts in comps:
+        cols = {int(g[r, c]) for r, c in pts}
+        matched = len(cols & legend_colors)
+        if matched > threshold:
+            for r, c in pts:
+                out[r, c] = bg
+    return out
