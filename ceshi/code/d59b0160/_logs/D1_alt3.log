+import numpy as np
+
+
+_THIS_FILE = Path(__file__).resolve()
+for _parent in _THIS_FILE.parents:
+    _candidate = _parent / "solvers" / "arc_utils.py"
+    if _candidate.exists():
+        sys.path.insert(0, str(_candidate.parent))
+        break
