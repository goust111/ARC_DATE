+DENSITY_LO = 0.10
+DENSITY_HI = 0.55
+
+COMP_COUNTS = [4, 5, 6]
+COMP_WEIGHTS = [1, 4, 25]
+NUM_KEPT = 3
+
+MAX_RETRIES = 300
+
+
+def _place_legend(inp: np.ndarray, out: np.ndarray, targets: list[int]) -> None:
+    """Draw the legend while keeping one target isolated from the border-connected cells."""
