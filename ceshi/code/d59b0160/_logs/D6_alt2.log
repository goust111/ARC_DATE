+    target_colors = list(targets) + [random.choice(targets) for _ in range(n_target_cells - NUM_TARGETS)]
+    random.shuffle(target_colors)
+    for (r, c), color in zip(target_coords, target_colors):
+        inp_patch[r, c] = color
