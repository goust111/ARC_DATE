+    residual_coords = [p for p in all_coords if p not in target_coord_set]
+    residual_count = len(residual_coords)
+    if residual_count >= 8:
+        min_mutate = 2
+    elif residual_count >= 5:
+        min_mutate = 1
+    else:
+        min_mutate = 0
+    max_mutate = min(MATCH_MUTATE_MAX, max(0, residual_count // 2 - 1))
