+
+    if n_mutate > 0:
+        mutate_coords = random.sample(residual_coords, n_mutate)
+        mutate_palette = [0] + [c for c in non_targets if c != dominant]
+        for r, c in mutate_coords:
+            if 0 in mutate_palette and random.random() < 0.45:
+                inp_patch[r, c] = 0
+            else:
