+TALL_W = (2, 4)
+WIDE_H = (3, 5)
+WIDE_W = (5, 9)
+MED_H = (3, 7)
+MED_W = (2, 9)
+
+# -- Component fill density --
+DENSITY_LO = 0.10
+DENSITY_HI = 0.55
+
+# -- Component count & kept/deleted split --
+COMP_COUNTS = [4, 5, 6]
+COMP_WEIGHTS = [1, 4, 25]
+NUM_KEPT = 3
+KEPT_TARGET_COUNTS = [0, 1, 2]
+
+# -- Generation retry budget --
+MAX_RETRIES = 300
+
