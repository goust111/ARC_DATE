+            )
+        except ValueError:
+            return None
+
+        paste(inp, patch, r, c)
+        if not deleted:
+            paste(out, np.full_like(patch, dominant), r, c)
+
+    if np.array_equal(main(inp), out):
+        return inp
+    return None
+
+
+def generate_input() -> np.ndarray:
