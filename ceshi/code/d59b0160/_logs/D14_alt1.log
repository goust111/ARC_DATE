   155	def _place_legend(inp: np.ndarray, out: np.ndarray, targets: list[int]) -> None:
   156	    """Draw the 4x4 legend box at top-left and place target colors."""
   157	    s = LEGEND_SIZE
   158	    for g in (inp, out):
   159	        g[:s, :s] = BG
   160	        g[s - 1, :s] = BORDER
   161	        g[:s, s - 1] = BORDER
   162	
   163	    # Keep one target disconnected from the border so the legend itself never matches all 3 colors.
   164	    isolated = random.choice([(0, 0), (0, 1), (1, 0), (1, 1)])
   165	    border_side = [(0, 2), (1, 2), (2, 0), (2, 1), (2, 2)]
   166	    side_choices = [
   167	        p for p in border_side if abs(p[0] - isolated[0]) + abs(p[1] - isolated[1]) != 1
   168	    ]
   169	    positions = [isolated] + random.sample(side_choices, 2)
   170	    random.shuffle(positions)
   171	    for color, (r, c) in zip(targets, positions):
   172	        inp[r, c] = color
   173	        out[r, c] = color
   174	
   175	
   176	def _component_dims() -> tuple[int, int]:
   177	    """Sample component dimensions according to shape-mode weights."""
   178	    mode = random.choices(["medium", "tall", "wide"], weights=SHAPE_WEIGHTS)[0]
   179	    if mode == "tall":
   180	        return random.randint(*TALL_H), random.randint(*TALL_W)
   181	    if mode == "wide":
   182	        return random.randint(*WIDE_H), random.randint(*WIDE_W)
   183	    return random.randint(*MED_H), random.randint(*MED_W)
