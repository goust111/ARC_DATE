+NUM_TARGETS = 3
+
+# -- Component shape weights: (mode, weight) --
+SHAPE_WEIGHTS = [5, 3, 2]  # medium, tall, wide
+TALL_H = (8, 12)
+TALL_W = (2, 4)
+WIDE_H = (3, 5)
+WIDE_W = (5, 9)
+MED_H = (3, 7)
+MED_W = (2, 9)
+
+# -- Component fill density --
+DENSITY_LO = 0.10
+DENSITY_HI = 0.55
+
+# -- Component count --
+COMP_COUNTS = [4, 5, 6]
+COMP_WEIGHTS = [1, 4, 8]
+NUM_DELETED = 1  # unique extracted target for visual clarity
+
