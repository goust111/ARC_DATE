   186	def _component_patch(h: int, w: int, targets: list[int], deleted: bool) -> np.ndarray:
   187	    """Build an h x w solid non-bg component with color-0 body and sprinkled colors."""
   188	    area = h * w
   189	    lo = max(1, math.ceil(area * DENSITY_LO))
   190	    hi = max(lo, math.floor(area * DENSITY_HI))
   191	    if deleted:
   192	        lo = max(lo, NUM_TARGETS + 1)
   193	        hi = max(hi, lo)
   194	
   195	    n_colored = random.randint(lo, hi)
   196	    coords = random.sample([(r, c) for r in range(h) for c in range(w)], n_colored)
   197	    non_targets = [v for v in PALETTE if v not in targets]
   198	
   199	    if deleted:
   200	        colors = list(targets) + [random.choice(PALETTE) for _ in range(n_colored - NUM_TARGETS)]
   201	    else:
   202	        used_target_count = random.randint(0, NUM_TARGETS - 1)
   203	        allowed = non_targets + random.sample(targets, used_target_count)
   204	        colors = [random.choice(allowed) for _ in range(n_colored)]
   205	
   206	    random.shuffle(colors)
   207	    patch = np.zeros((h, w), dtype=int)
   208	    rs, cs = zip(*coords)
   209	    patch[rs, cs] = colors
   210	    return patch
   211	
   212	
   213	def _gen_attempt() -> np.ndarray | None:
   214	    """Try once to build a valid input whose output is the unique deleted component crop."""
   215	    inp = np.full((GRID_H, GRID_W), BG, dtype=int)
   216	    out = inp.copy()
   217	
   218	    targets = random.sample(PALETTE, NUM_TARGETS)
   219	    _place_legend(inp, out, targets)
