+WIDE_H = (3, 5)
+WIDE_W = (5, 9)
+MED_H = (3, 7)
+MED_W = (2, 9)
+
+# -- Component fill density --
+DENSITY_LO = 0.10
+DENSITY_HI = 0.55
+
