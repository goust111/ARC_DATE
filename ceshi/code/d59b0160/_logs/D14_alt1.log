+COMP_COUNTS = [4, 5, 6]
+COMP_WEIGHTS = [1, 4, 8]
+NUM_DELETED = 1  # unique extracted target for visual clarity
+
+# -- Generation retry budget --
+MAX_RETRIES = 400
+
