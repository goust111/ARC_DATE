+# -- Component fill density --
+DENSITY_LO = 0.10
+DENSITY_HI = 0.55
+
+# -- Component count --
+COMP_COUNTS = [4, 5, 6]
+COMP_WEIGHTS = [1, 4, 8]
+NUM_DELETED = 1  # unique extracted target for visual clarity
