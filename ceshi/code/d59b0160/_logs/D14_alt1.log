   136	TALL_W = (2, 4)
   137	WIDE_H = (3, 5)
   138	WIDE_W = (5, 9)
   139	MED_H = (3, 7)
   140	MED_W = (2, 9)
   141	
   142	# -- Component fill density --
   143	DENSITY_LO = 0.10
   144	DENSITY_HI = 0.55
   145	
   146	# -- Component count --
   147	COMP_COUNTS = [4, 5, 6]
   148	COMP_WEIGHTS = [1, 4, 8]
   149	NUM_DELETED = 1  # unique extracted target for visual clarity
   150	
   151	# -- Generation retry budget --
   152	MAX_RETRIES = 400
