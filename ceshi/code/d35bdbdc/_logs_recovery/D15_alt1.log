   239	    path_cells, _hint_cells = _find_path_cells(g, bg, grey)
   240	    ordered_path = _trace_trail(g, path_cells, sprites)
   241	    te1, te2 = ordered_path[0], ordered_path[-1]
   242	    trail_eps = {te1, te2}
   243	
   244	    eps_pair = [te1, te2]
   245	    opts = {ep: [sp for sp in sprites if ep in _ports_for_sprite(sp, g, trail_eps)] for ep in eps_pair}
   246	
   247	    # Bipartite match: fewer-options-first; tiebreak by sprite farthest from OTHER endpoint
   248	    dest: list[dict] = [None, None]  # type: ignore[list-item]
   249	    order = [0, 1] if len(opts[te1]) <= len(opts[te2]) else [1, 0]
   250	    used: set[int] = set()
   251	    for i in order:
   252	        ep = eps_pair[i]
   253	        other = eps_pair[1 - i]
   254	        cands = [sp for sp in opts[ep] if id(sp) not in used]
   255	        best = max(
   256	            cands,
   257	            key=lambda sp: abs(sp["center_pos"][0] - other[0]) + abs(sp["center_pos"][1] - other[1]),
   258	        )
   259	        dest[i] = best
   260	        used.add(id(best))

