   217	def main(grid: np.ndarray) -> np.ndarray:
   218	    """
   219	    Transfer source center colors into the two path-connected targets using color hints embedded in the trail.
   220	
   221	    Input structure:
   222	    - Background, a thin trail whose main body is grey (5), and several small bordered sprites with one distinct center pixel.
   223	    - The trail still connects exactly two destination sprites by endpoint ports, but now the trail also contains a few colored hint pixels inside it.
   224	
   225	    Rule:
   226	    - Find the two destination sprites touched by the trail endpoints, same as in the base task.
   227	    - For each endpoint, walk inward along the trail and read the first colored hint pixel; that hint color names the border color of the source sprite to consult.
   228	    - Copy that source sprite's center color into the connected destination's center, then delete all non-destination sprites while preserving the trail and its hints.
   229	
   230	    Key insight: The lookup key is no longer hidden in the destination center; it is explicitly written on the path, so the path serves as both connector and legend.
   231	    """
   232	    g = np.asarray(grid, dtype=int)
   233	    bg = _bg_boundary(g)
   234	    grey = 5
   235	
   236	    sprites = _detect_bordered_sprites(g, bg, grey)
   237	    assert sprites, "expected at least one bordered sprite in the grid"
