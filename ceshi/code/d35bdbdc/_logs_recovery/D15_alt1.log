   192	      - it's exactly 2 steps away from the sprite center (Manhattan distance 2),
   193	      - the intermediate cell (1 step away from center toward endpoint) is the sprite border color.
   194	    """
   195	    cr, cc = sprite["center_pos"]
   196	    b = int(sprite["border"])
   197	    ports: list[tuple[int, int]] = []
   198	    for ir, ic in neighbors4(cr, cc):
   199	        dr, dc = ir - cr, ic - cc
   200	        er, ec = cr + 2 * dr, cc + 2 * dc
   201	        if (er, ec) not in eps:
   202	            continue
