+        input_grid,
+        shape_type,
+        border_colors,
+        colors["distractor_center_colors"],
+    ):
+        return None
+    if not _place_sources(input_grid, colors["source_colors"]):
+        return None
+
+    try:
+        out = main(input_grid)
+        if np.array_equal(out, output_grid):
+            return input_grid
+    except Exception:
+        pass
+    return None
+
