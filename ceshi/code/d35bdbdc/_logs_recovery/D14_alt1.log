DISTRACTOR_SHAPES = ((1, 1), (1, 2), (2, 1), (2, 2), (3, 1), (3, 2))
TOTAL_RED_MIN = 5                # min total red components (matched + distractors)
TOTAL_RED_MAX = 11               # max total red components
