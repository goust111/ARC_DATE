+# Variant of d35bdbdc
+# Dimension: D13 — 属性转移的范围 (transform)
+# Change: 仅转移中心色（单像素或小区域的颜色替换）... → 转移源精灵的完整图案
+
+import numpy as np
+
+from arc_utils import neighbors4, neighbors8, components_mask, paste
+import random
+from collections import deque
