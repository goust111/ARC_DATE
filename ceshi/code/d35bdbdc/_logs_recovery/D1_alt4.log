   143	def _detect_bordered_sprites(g: np.ndarray, bg: int, grey: int) -> list[dict]:
   144	    """
   145	    Bordered sprite = a 4-connected component (excluding bg/grey) with exactly 2 colors:
   146	      - border color appears multiple times
   147	      - center color appears exactly once (its location is the 'center')
   148	    This also handles clipped/partial borders (e.g., near the grid edge).
   149	    """
   150	    mask = (g != bg) & (g != grey)
   151	    comps = components_mask(mask, connectivity=4)
   152	    sprites: list[dict] = []
   153	    for pts in comps:
   154	        cols = [int(g[r, c]) for r, c in pts]
   155	        uniq = sorted(set(cols))
   156	        if len(uniq) != 2:
   157	            continue
   158	        counts = {c: cols.count(c) for c in uniq}
   159	        center_color = min(counts, key=lambda c: counts[c])
   160	        if counts[center_color] != 1:
   161	            continue
   162	        border_color = [c for c in uniq if c != center_color][0]
   163	        if border_color == bg or border_color == grey or center_color == grey:
