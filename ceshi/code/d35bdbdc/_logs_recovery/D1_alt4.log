   212	def main(grid: np.ndarray) -> np.ndarray:
   213	    """
   214	    Transfer center colors between bordered sprites matched by visible-area rank, keeping only path-connected ones.
   215	
   216	    Input structure:
   217	    - A background, a grey (5) winding trail, and four bordered sprites from one shape family (box or plus).
   218	    - Two sprites are touched by the grey trail endpoints through ports; these are the destinations.
   219	    - The other two bordered sprites are detached sources, and visible sprite size may differ because edge clipping removes cells.
   220	
   221	    Rule:
   222	    - Use the two grey trail endpoints to identify the two destination sprites exactly as in the base task.
   223	    - Delete every bordered sprite that is not a destination.
   224	    - Rank the two destinations by visible area and rank the two detached sources by visible area, both from largest to smallest.
   225	    - Replace each destination center with the center color of the source at the same size rank.
   226	
   227	    Key insight: Destination selection still comes from the grey trail, but the recoloring key is no longer a color chain; it is the relative size order among the detached sources and among the trail-connected destinations.
   228	    """
   229	    g = np.asarray(grid, dtype=int)
   230	    bg = _bg_boundary(g)
   231	    grey = 5
   232	
   233	    sprites = _detect_bordered_sprites(g, bg, grey)
   234	    assert len(sprites) >= 4, "expected at least four bordered sprites in the grid"
   235	
   236	    te1, te2 = _find_trail_endpoints(g, grey, sprites)
   237	    trail_eps = {te1, te2}
   238	
   239	    eps_pair = [te1, te2]
   240	    opts = {ep: [sp for sp in sprites if ep in _ports_for_sprite(sp, g, trail_eps)] for ep in eps_pair}
   241	
   242	    dest: list[dict] = [None, None]  # type: ignore[list-item]
   243	    order = [0, 1] if len(opts[te1]) <= len(opts[te2]) else [1, 0]
   244	    used: set[int] = set()
   245	    for i in order:
   246	        ep = eps_pair[i]
   247	        other = eps_pair[1 - i]
   248	        cands = [sp for sp in opts[ep] if id(sp) not in used]
   249	        best = max(
   250	            cands,
   251	            key=lambda sp: abs(sp["center_pos"][0] - other[0]) + abs(sp["center_pos"][1] - other[1]),
   252	        )
   253	        dest[i] = best
   254	        used.add(id(best))
   255	    assert all(d is not None for d in dest), "expected exactly 2 dest sprites from trail endpoints"
   256	    dest_ids = {id(sp) for sp in dest}
   257	
   258	    sources = [sp for sp in sprites if id(sp) not in dest_ids]
   259	    assert len(sources) == len(dest) == 2, "variant expects exactly two detached source sprites"
   260	
   261	    out = g.copy()
   262	
   263	    for sp in sprites:
   264	        if id(sp) in dest_ids:
   265	            continue
   266	        for r, c in sp["pts"]:
   267	            out[r, c] = bg
   268	
   269	    keep = np.zeros(out.shape, dtype=bool)
   270	    q: list[tuple[int, int]] = []
   271	    for d in dest:
   272	        for r, c in d["pts"]:
   273	            if out[r, c] != bg and out[r, c] != grey and not keep[r, c]:
   274	                keep[r, c] = True
   275	                q.append((r, c))
   276	    while q:
   277	        r, c = q.pop()
   278	        for nr, nc in neighbors4(r, c):
   279	            if 0 <= nr < out.shape[0] and 0 <= nc < out.shape[1]:
   280	                if keep[nr, nc]:
   281	                    continue
   282	                if out[nr, nc] == bg or out[nr, nc] == grey:
   283	                    continue
   284	                keep[nr, nc] = True
   285	                q.append((nr, nc))
   286	    drop = (out != bg) & (out != grey) & (~keep)
   287	    out[drop] = bg
   288	
   289	    ranked_dest = _rank_by_area_desc(dest)
   290	    ranked_sources = _rank_by_area_desc(sources)
   291	    for d, src in zip(ranked_dest, ranked_sources, strict=True):
   292	        dr, dc = d["center_pos"]
   293	        out[dr, dc] = int(src["center"])
   294	
   295	    return out
   296	
   297	
