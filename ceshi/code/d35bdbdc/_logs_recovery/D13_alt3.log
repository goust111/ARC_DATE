+def _frame_patch(border_color: int, inner_color: int) -> np.ndarray:
+    """5x5 frame with a uniform 3x3 interior."""
+    patch = np.full((FRAME_SIZE, FRAME_SIZE), border_color, dtype=int)
+    patch[1:-1, 1:-1] = inner_color
+    return patch
