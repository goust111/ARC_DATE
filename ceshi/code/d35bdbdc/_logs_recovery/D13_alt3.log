+        if not placed_source:
+            return None
+
+    output_grid = _build_output(dest_specs, dest_positions, path_cells)
+
+    try:
+        out = main(input_grid)
+        if np.array_equal(out, output_grid):
+            return input_grid
+    except Exception:
+        pass
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
