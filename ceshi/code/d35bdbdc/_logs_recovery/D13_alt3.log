    input_grid = layout_grid.copy()
    all_pos = mod._sprite_positions()
    for border_color, inner_color in source_specs:
        patch = mod._frame_patch(border_color, inner_color)
        pool = list(all_pos)
        random.shuffle(pool)
        placed_source = False
        for r0, c0 in pool:
            if not mod._overlaps(input_grid, patch, r0, c0):
                mod._place_patch(input_grid, patch, r0, c0)
                placed_source = True
                break
        if not placed_source:
            stats['source_place'] = stats.get('source_place', 0) + 1
            bad = True
            break
    if bad:
        continue
    output_grid = mod._build_output(dest_specs, dest_positions, path_cells)
    try:
        out = mod.main(input_grid)
    except Exception as e:
        stats[f'main_exc:{type(e).__name__}:{e}'] = stats.get(f'main_exc:{type(e).__name__}:{e}', 0) + 1
        continue
    if not np.array_equal(out, output_grid):
        stats['oracle_mismatch'] = stats.get('oracle_mismatch', 0) + 1
        continue
    stats['success'] = stats.get('success', 0) + 1

print(stats)
