+    random.shuffle(palette)
+    dest_border_colors = palette[:2]
+    lookup_colors = palette[2 : 2 + n_groups]
+    fill_colors = palette[2 + n_groups : 2 + 2 * n_groups]
+
+    dest_specs = []
+    for i in range(2):
+        gi = dest_to_group[i]
+        dest_specs.append(
+            {
