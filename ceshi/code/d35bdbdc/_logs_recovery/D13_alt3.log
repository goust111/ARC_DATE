+                ports = [p for p in ports if abs(p[0] - port_cells[0][0]) + abs(p[1] - port_cells[0][1]) >= MIN_PORT_DIST]
+            if not ports:
+                continue
+            chosen_port = ports[0]
+            _place_patch(layout_grid, patch, r0, c0)
+            positions.append((r0, c0))
+            port_cells.append(chosen_port)
+            placed = True
+            break
