   310	def _make_sprite_patch(shape_type, border_color, center_color):
   311	    """Return 3x3 patch for a box or plus. Center is at (1,1)."""
   312	    if shape_type == "box":
   313	        p = np.full((3, 3), border_color, dtype=int)
   314	    else:
   315	        p = np.zeros((3, 3), dtype=int)
   316	        for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
   317	            p[1 + dr, 1 + dc] = border_color
   318	    p[1, 1] = center_color
   319	    return p
