   344	                rr, cc = r0 + dr, c0 + dc
   345	                if 0 <= rr < h and 0 <= cc < w:
   346	                    if grid[rr, cc] != 0:
   347	                        return True
   348	                    patch_cells.add((rr, cc))
   349	    for rr, cc in patch_cells:
   350	        for nr, nc in [(rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)]:
   351	            if (nr, nc) not in patch_cells and 0 <= nr < h and 0 <= nc < w:
   352	                if int(grid[nr, nc]) not in (BG, GREY):
   353	                    return True
   354	    return False
