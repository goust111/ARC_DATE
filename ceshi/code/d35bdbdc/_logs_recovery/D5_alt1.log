   447	            chosen = random.choice(dtop) if dtop else best[0]
   448	
   449	        cr, cc = chosen[0], chosen[1]
   450	        path.append((cr, cc))
   451	        visited.add((cr, cc))
   452	
   453	    if end not in visited:
   454	        if not _too_thick(end[0], end[1], visited):
   455	            path.append(end)
   456	        else:
   457	            return None
   458	
   459	    return path
   460	
   461	
   462	def _is_8_connected(cells):
   463	    """Check 8-connectivity of a set of cells via BFS."""
   464	    if len(cells) <= 1:
   465	        return True
   466	    cell_set = set(cells)
   467	    start = next(iter(cell_set))
   468	    visited = {start}
   469	    queue = deque([start])
   470	    while queue:
   471	        r, c = queue.popleft()
   472	        for dr in (-1, 0, 1):
   473	            for dc in (-1, 0, 1):
   474	                if dr == 0 and dc == 0:
   475	                    continue
   476	                nb = (r + dr, c + dc)
   477	                if nb in cell_set and nb not in visited:
   478	                    visited.add(nb)
   479	                    queue.append(nb)
   480	    return len(visited) == len(cell_set)
   481	
   482	
   483	def _find_port_dir(grid, cr, cc, bc):
   484	    """Find a valid port direction for a sprite centered at (cr,cc) with border color bc."""
   485	    dirs = [(-1, 0), (1, 0), (0, -1), (0, 1)]
   486	    random.shuffle(dirs)
   487	    for dr, dc in dirs:
   488	        ir, ic = cr + dr, cc + dc
   489	        er, ec = cr + 2 * dr, cc + 2 * dc
   490	        if not (0 <= ir < GRID_H and 0 <= ic < GRID_W and 0 <= er < GRID_H and 0 <= ec < GRID_W):
   491	            continue
   492	        if grid[ir, ic] == bc and grid[er, ec] == 0:
   493	            return (er, ec)
   494	    return None
   495	
   496	
   497	def _assign_colors(border_colors, num_sprites):
   498	    """Assign destination/source/distractor roles and all pre/post-swap center colors."""
   499	    if num_sprites < 2 + SOURCE_COUNT:
   500	        return None
   501	
   502	    source_indices = list(range(2, 2 + SOURCE_COUNT))
   503	    distractor_indices = list(range(2 + SOURCE_COUNT, num_sprites))
   504	    pair_source_indices = list(source_indices)
   505	    random.shuffle(pair_source_indices)
   506	
   507	    dest_center_colors = [border_colors[si] for si in pair_source_indices]
   508	
   509	    source_center_pool = [c for c in range(1, 10) if c not in {BG, GREY} and c not in border_colors]
   510	    if len(source_center_pool) < SOURCE_COUNT:
   511	        return None
   512	    random.shuffle(source_center_pool)
   513	
   514	    source_center_by_index: dict[int, int] = {}
   515	    for j, si in enumerate(source_indices):
   516	        source_center_by_index[si] = source_center_pool[j]
   517	
   518	    distractor_center_colors = []
   519	    for di in distractor_indices:
   520	        candidates = [c for c in range(1, 10) if c not in {BG, GREY, border_colors[di]}]
   521	        distractor_center_colors.append(random.choice(candidates))
   522	
   523	    output_dest_centers = [source_center_by_index[si] for si in pair_source_indices]
   524	    output_source_centers = {si: border_colors[si] for si in source_indices}
   525	
   526	    return dict(
   527	        source_indices=source_indices,
   528	        distractor_indices=distractor_indices,
   529	        pair_source_indices=pair_source_indices,
   530	        dest_center_colors=dest_center_colors,
   531	        source_center_by_index=source_center_by_index,
   532	        distractor_center_colors=distractor_center_colors,
   533	        output_dest_centers=output_dest_centers,
   534	        output_source_centers=output_source_centers,
   535	    )
   536	
   537	
   538	def _place_dests(output_grid, shape_type, border_colors, output_dest_centers, min_port_dist):
   539	    """Place 2 destination sprites on the grid. Returns destination center positions or None."""
   540	    all_pos = _sprite_positions()
   541	    edge_pos = [p for p in all_pos if _is_edge(p[0], p[1])]
   542	    int_pos = [p for p in all_pos if not _is_edge(p[0], p[1])]
   543	    num_interior_dest = random.choices([0, 1], weights=INTERIOR_DEST_WEIGHTS)[0]
   544	
   545	    dest_center_positions = []
   546	    first_port = None
   547	
   548	    for i in range(2):
   549	        bc = border_colors[i]
   550	        patch = _make_sprite_patch(shape_type, bc, output_dest_centers[i])
   551	        pool = list(int_pos if i < num_interior_dest else edge_pos)
   552	        random.shuffle(pool)
   553	
   554	        placed = False
   555	        for r0, c0 in pool:
