   322	def _place_sprite(grid, patch, r0, c0):
   323	    """Place patch cells on grid, skipping transparent (0) and out-of-bounds."""
   324	    paste(grid, patch, r0, c0, transparent=BG, clip=True)
   325	
   326	
   327	def _erase_sprite(grid, patch, r0, c0):
   328	    """Undo a _place_sprite by zeroing non-transparent patch cells."""
   329	    h, w = grid.shape
   330	    for dr in range(3):
   331	        for dc in range(3):
   332	            rr, cc = r0 + dr, c0 + dc
   333	            if 0 <= rr < h and 0 <= cc < w and patch[dr, dc] != 0:
   334	                grid[rr, cc] = BG
   335	
   336	
   337	def _overlaps(grid, patch, r0, c0):
   338	    """Check if placing patch at (r0,c0) would overlap or 4-touch non-bg, non-grey cells."""
   339	    h, w = grid.shape
   340	    patch_cells = set()
   341	    for dr in range(3):
