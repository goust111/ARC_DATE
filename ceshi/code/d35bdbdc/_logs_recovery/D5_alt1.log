    79	        adj[(r, c)] = [(nr, nc) for nr, nc in neighbors8(r, c) if (nr, nc) in cells]
    80	
    81	    deg1 = [c for c, nbs in adj.items() if len(nbs) == 1]
    82	    if len(deg1) >= 2:
    83	        return deg1[0], deg1[1]
    84	
    85	    port_cells: set[tuple[int, int]] = set()
    86	    for sp in sprites:
    87	        cr, cc = sp["center_pos"]
    88	        b = int(sp["border"])
    89	        for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
    90	            ir, ic = cr + dr, cc + dc
    91	            er, ec = cr + 2 * dr, cc + 2 * dc
    92	            if (er, ec) in cells and 0 <= ir < h and 0 <= ic < w and int(g[ir, ic]) == b:
    93	                port_cells.add((er, ec))
    94	
    95	    start = deg1[0] if deg1 else next(iter(cells))
    96	    n = len(cells)
    97	
    98	    def dfs(cur: tuple[int, int], visited: frozenset) -> list | None:
    99	        if len(visited) == n:
   100	            return [cur] if cur in port_cells else None
   101	        for nb in adj[cur]:
   102	            if nb not in visited:
   103	                result = dfs(nb, visited | {nb})
   104	                if result is not None:
   105	                    return [cur] + result
   106	        return None
   107	
   108	    path = dfs(start, frozenset({start}))
   109	    assert path, "could not trace grey cells as one-stroke trail"
   110	    return path[0], path[-1]
   111	
   112	
   113	def _detect_bordered_sprites(g: np.ndarray, bg: int, grey: int) -> list[dict]:
   114	    """
   115	    Bordered sprite = a 4-connected component (excluding bg/grey) with exactly 2 colors:
   116	      - border color appears multiple times
   117	      - center color appears exactly once (its location is the 'center')
   118	    This also handles clipped/partial borders (e.g., near the grid edge).
   119	    """
   120	    mask = (g != bg) & (g != grey)
   121	    comps = components_mask(mask, connectivity=4)
   122	    sprites: list[dict] = []
   123	    for pts in comps:
   124	        cols = [int(g[r, c]) for r, c in pts]
   125	        uniq = sorted(set(cols))
   126	        if len(uniq) != 2:
   127	            continue
   128	        counts = {c: cols.count(c) for c in uniq}
   129	        center_color = min(counts, key=lambda c: counts[c])
   130	        if counts[center_color] != 1:
   131	            continue
   132	        border_color = [c for c in uniq if c != center_color][0]
   133	        if border_color == bg or border_color == grey or center_color == grey:
   134	            continue
   135	
   136	        center_pos = None
   137	        for r, c in pts:
   138	            if int(g[r, c]) == center_color:
   139	                center_pos = (int(r), int(c))
   140	                break
   141	        if center_pos is None:
   142	            continue
   143	        sprites.append(
   144	            {
   145	                "pts": pts,
   146	                "border": int(border_color),
   147	                "center": int(center_color),
   148	                "center_pos": center_pos,
   149	            }
   150	        )
   151	    return sprites
   152	
   153	
   154	def _ports_for_sprite(sprite: dict, g: np.ndarray, eps: set[tuple[int, int]]) -> list[tuple[int, int]]:
   155	    """
   156	    A grey endpoint (er,ec) is a port for this sprite if:
   157	      - it's exactly 2 steps away from the sprite center (Manhattan distance 2),
   158	      - the intermediate cell (1 step away from center toward endpoint) is the sprite border color.
   159	    """
   160	    cr, cc = sprite["center_pos"]
   161	    b = int(sprite["border"])
   162	    ports: list[tuple[int, int]] = []
   163	    for ir, ic in neighbors4(cr, cc):
   164	        dr, dc = ir - cr, ic - cc
   165	        er, ec = cr + 2 * dr, cc + 2 * dc
   166	        if (er, ec) not in eps:
   167	            continue
   168	        if 0 <= ir < g.shape[0] and 0 <= ic < g.shape[1] and int(g[ir, ic]) == b:
   169	            ports.append((er, ec))
   170	    return ports
   171	
   172	
   173	def _select_destinations(
   174	    sprites: list[dict], g: np.ndarray, trail_eps: set[tuple[int, int]], eps_pair: list[tuple[int, int]],
   175	) -> list[dict]:
   176	    opts = {ep: [sp for sp in sprites if ep in _ports_for_sprite(sp, g, trail_eps)] for ep in eps_pair}
   177	
   178	    dest: list[dict] = [None, None]  # type: ignore[list-item]
   179	    order = [0, 1] if len(opts[eps_pair[0]]) <= len(opts[eps_pair[1]]) else [1, 0]
   180	    used: set[int] = set()
   181	    for i in order:
   182	        ep = eps_pair[i]
   183	        other = eps_pair[1 - i]
   184	        cands = [sp for sp in opts[ep] if id(sp) not in used]
   185	        best = max(
   186	            cands,
   187	            key=lambda sp: abs(sp["center_pos"][0] - other[0]) + abs(sp["center_pos"][1] - other[1]),
   188	        )
   189	        dest[i] = best
   190	        used.add(id(best))
   191	    assert all(d is not None for d in dest), "expected exactly 2 dest sprites from trail endpoints"
   192	    return dest
   193	
   194	
   195	def _match_swap_pairs(sprites: list[dict], dest: list[dict]) -> list[tuple[dict, dict]]:
   196	    """Pair each destination with the unique non-destination source named by its center color."""
   197	    dest_ids = {id(sp) for sp in dest}
   198	    by_border: dict[int, list[dict]] = {}
   199	    for sp in sprites:
   200	        if id(sp) in dest_ids:
   201	            continue
   202	        by_border.setdefault(int(sp["border"]), []).append(sp)
   203	
   204	    pairs: list[tuple[dict, dict]] = []
   205	    used_sources: set[int] = set()
   206	    for d in dest:
   207	        want_border = int(d["center"])
   208	        srcs = by_border.get(want_border, [])
   209	        if not srcs:
   210	            continue
   211	        assert len(srcs) == 1, "each destination color should match exactly one non-destination source border"
   212	        src = srcs[0]
   213	        sid = id(src)
   214	        assert sid not in used_sources, "swap variant requires one-to-one destination/source matches"
   215	        used_sources.add(sid)
   216	        pairs.append((d, src))
   217	    return pairs
   218	
   219	
   220	def main(grid: np.ndarray) -> np.ndarray:
   221	    """
   222	    Swap center colors between trail-selected destinations and their matched lookup sources.
   223	
   224	    Input structure:
   225	    - The grid contains background, one grey (5) one-stroke trail, and several small bordered sprites with a unique center pixel.
   226	    - The trail endpoints identify exactly two destination sprites through 2-step ports; other sprites are detached lookup sources or distractors.
   227	
   228	    Rule:
   229	    - Read each destination's original center color as a key for a non-destination source whose border color matches it.
   230	    - Keep the two destinations, keep the matched sources, and simultaneously exchange each paired destination/source center color.
   231	    - Delete every other sprite and any leftover non-sprite foreground component; preserve the grey trail.
   232	
   233	    Key insight:
   234	    - A destination center is still a pointer into border colors elsewhere, but the action is no longer one-way filling.
   235	    - Because the matched source also survives, its contrasting center disappears into its own border color after the swap.
   236	    """
   237	    g = np.asarray(grid, dtype=int)
   238	    bg = _bg_boundary(g)
   239	    grey = 5
   240	
   241	    sprites = _detect_bordered_sprites(g, bg, grey)
   242	    assert sprites, "expected at least one bordered sprite in the grid"
   243	
   244	    te1, te2 = _find_trail_endpoints(g, grey, sprites)
   245	    trail_eps = {te1, te2}
   246	    eps_pair = [te1, te2]
   247	    dest = _select_destinations(sprites, g, trail_eps, eps_pair)
   248	    pairs = _match_swap_pairs(sprites, dest)
   249	
   250	    keep_ids = {id(sp) for sp in dest}
   251	    for _d, src in pairs:
   252	        keep_ids.add(id(src))
   253	
   254	    out = g.copy()
   255	
   256	    for sp in sprites:
   257	        if id(sp) in keep_ids:
   258	            continue
   259	        for r, c in sp["pts"]:
   260	            out[r, c] = bg
   261	
   262	    keep = np.zeros(out.shape, dtype=bool)
   263	    q: list[tuple[int, int]] = []
   264	    for sp in sprites:
   265	        if id(sp) not in keep_ids:
   266	            continue
   267	        for r, c in sp["pts"]:
   268	            if out[r, c] != bg and out[r, c] != grey and not keep[r, c]:
   269	                keep[r, c] = True
   270	                q.append((r, c))
   271	    while q:
   272	        r, c = q.pop()
   273	        for nr, nc in neighbors4(r, c):
   274	            if 0 <= nr < out.shape[0] and 0 <= nc < out.shape[1]:
   275	                if keep[nr, nc]:
   276	                    continue
   277	                if out[nr, nc] == bg or out[nr, nc] == grey:
   278	                    continue
   279	                keep[nr, nc] = True
   280	                q.append((nr, nc))
   281	    drop = (out != bg) & (out != grey) & (~keep)
   282	    out[drop] = bg
   283	
   284	    updates: dict[tuple[int, int], int] = {}
   285	    for d, src in pairs:
   286	        dr, dc = d["center_pos"]
   287	        sr, sc = src["center_pos"]
   288	        updates[(dr, dc)] = int(src["center"])
   289	        updates[(sr, sc)] = int(d["center"])
   290	    for (r, c), color in updates.items():
   291	        out[r, c] = color
   292	
   293	    return out
   294	
