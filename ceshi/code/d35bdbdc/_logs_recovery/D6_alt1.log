import importlib.util
import numpy as np
from statistics import mean

new_path = '/home/lixinyu/snap/new/ceshi/code/d35bdbdc/D6/1/code.py'
old_path = '/home/lixinyu/snap/new/arc2_solver_select/d35bdbdc.py'

def load(path, name):
    spec = importlib.util.spec_from_file_location(name, path)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod

new = load(new_path, 'new_variant')
old = load(old_path, 'old_orig')

ghost_sprite_counts = []
ghost_pixel_counts = []
delta_pixels = []
shape_counts = {'box_like': 0, 'plus_like': 0}

for _ in range(200):
    inp = new.generate_input()
    out = new.main(inp)
    old_out = old.main(inp)

    bg = new._bg_boundary(inp)
    sprites = new._detect_bordered_sprites(inp, bg, 5)
    te1, te2 = new._find_trail_endpoints(inp, 5, sprites)
    trail_eps = {te1, te2}
    eps_pair = [te1, te2]
    opts = {ep: [sp for sp in sprites if ep in new._ports_for_sprite(sp, inp, trail_eps)] for ep in eps_pair}
    dest = [None, None]
    order = [0, 1] if len(opts[te1]) <= len(opts[te2]) else [1, 0]
    used = set()
    for i in order:
        ep = eps_pair[i]
        other = eps_pair[1 - i]
        cands = [sp for sp in opts[ep] if id(sp) not in used]
        best = max(cands, key=lambda sp: abs(sp['center_pos'][0] - other[0]) + abs(sp['center_pos'][1] - other[1]))
        dest[i] = best
        used.add(id(best))
    dest_ids = {id(sp) for sp in dest}

    ghost_count = 0
    ghost_pixels = 0
    for sp in sprites:
        if id(sp) in dest_ids:
            pts = set(map(tuple, sp['pts']))
            if len(pts) >= 5:
                shape_counts['box_like'] += 1
            else:
                shape_counts['plus_like'] += 1
            continue
        cr, cc = sp['center_pos']
        border_pts = [(r, c) for r, c in sp['pts'] if (r, c) "'!= (cr, cc)]
        border_kept = sum(1 for r, c in border_pts if out[r, c] == inp[r, c])
        if out[cr, cc] == bg and border_kept >= 1:
            ghost_count += 1
            ghost_pixels += border_kept

    ghost_sprite_counts.append(ghost_count)
    ghost_pixel_counts.append(ghost_pixels)
    delta_pixels.append(int(np.sum(out != old_out)))

print('"'samples=200')
print('ghost_sprites_per_sample min/avg/max =', min(ghost_sprite_counts), f'{mean(ghost_sprite_counts):.2f}', max(ghost_sprite_counts))
print('ghost_border_pixels_per_sample min/avg/max =', min(ghost_pixel_counts), f'{mean(ghost_pixel_counts):.2f}', max(ghost_pixel_counts))
print('variant_vs_original_delta_pixels min/avg/max =', min(delta_pixels), f'{mean(delta_pixels):.2f}', max(delta_pixels))
print('samples differing from original =', sum(1 for d in delta_pixels if d > 0), '/200')
print('dest_shape_counts =', shape_counts)
