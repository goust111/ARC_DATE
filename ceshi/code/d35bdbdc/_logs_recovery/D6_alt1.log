   371	                    moves.append((nr, nc, dr != 0 and dc != 0))
   372	
   373	        if not moves:
   374	            return None
   375	
   376	        dist = abs(cr - end[0]) + abs(cc - end[1])
   377	        budget = target_len - len(path)
   378	        diag = [m for m in moves if m[2]]
