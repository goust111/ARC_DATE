   118	    comps = components_mask(mask, connectivity=4)
   119	    sprites: list[dict] = []
   120	    for pts in comps:
   121	        cols = [int(g[r, c]) for r, c in pts]
   122	        uniq = sorted(set(cols))
   123	        if len(uniq) != 2:
   124	            continue
   125	        counts = {c: cols.count(c) for c in uniq}
   126	        center_color = min(counts, key=lambda c: counts[c])
   127	        if counts[center_color] != 1:
   128	            continue
   129	        border_color = [c for c in uniq if c != center_color][0]
   130	        if border_color == bg or border_color == grey or center_color == grey:
   131	            continue
   132	
   133	        center_pos = None
   134	        for r, c in pts:
   135	            if int(g[r, c]) == center_color:
   136	                center_pos = (int(r), int(c))
   137	                break
   138	        if center_pos is None:
   139	            continue
   140	        sprites.append(
   141	            {
   142	                "pts": pts,
   143	                "border": int(border_color),
   144	                "center": int(center_color),
   145	                "center_pos": center_pos,
   146	            }
   147	        )
   148	    return sprites
