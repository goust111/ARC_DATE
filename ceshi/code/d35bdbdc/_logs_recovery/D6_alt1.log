   400	            top = [m for m in best if score(m) <= score(best[0]) + 1]
   401	            dtop = [m for m in top if m[2]]
   402	            chosen = random.choice(dtop) if dtop else best[0]
   403	
   404	        cr, cc = chosen[0], chosen[1]
