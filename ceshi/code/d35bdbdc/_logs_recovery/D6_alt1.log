   356	    def score(m):
   357	        return abs(m[0] - end[0]) + abs(m[1] - end[1])
   358	
   359	    for _ in range(target_len + 20):
   360	        if max(abs(cr - end[0]), abs(cc - end[1])) <= 1:
   361	            break
   362	
   363	        moves = []
