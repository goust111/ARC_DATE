   110	def _detect_bordered_sprites(g: np.ndarray, bg: int, grey: int) -> list[dict]:
   111	    """
   112	    Bordered sprite = a 4-connected component (excluding bg/grey) with exactly 2 colors:
   113	      - border color appears multiple times
   114	      - center color appears exactly once (its location is the 'center')
   115	    This also handles clipped/partial borders (e.g., near the grid edge).
   116	    """
