   170	def main(grid: np.ndarray) -> np.ndarray:
   171	    """
   172	    Transfer center colors into the two path-linked sprites and hollow out every other sprite.
   173	
   174	    Input structure:
   175	    - The grid contains background, a grey (5) one-stroke trail, and several small bordered
   176	      sprites whose border color surrounds a single differently colored center cell.
   177	    - The two trail endpoints act as ports: each endpoint sits two steps from the center of one
   178	      destination sprite with that sprite's border cell in between.
   179	
   180	    Rule:
   181	    - Use the grey trail endpoints to identify the two destination sprites.
   182	    - For each destination, use its original center color as a key: find the unique source sprite
   183	      whose border color matches that key, then copy the source center color into the destination
   184	      center.
   185	    - Every non-destination sprite stays in place but becomes a ghost: keep its border pixels and
   186	      repaint only its center pixel to the background color.
   187	    - Any leftover non-sprite colored components are still cleared; the grey trail remains.
   188	
   189	    Key insight: The path still selects which sprites participate in the color transfer, but the
   190	    unselected sprites are not removed wholesale anymore; they are recognized by their preserved
   191	    border and hollowed out by erasing just the center.
   192	    """
   193	    g = np.asarray(grid, dtype=int)
   194	    bg = _bg_boundary(g)
   195	    grey = 5
   196	
   197	    sprites = _detect_bordered_sprites(g, bg, grey)
   198	    assert sprites, "expected at least one bordered sprite in the grid"
   199	
   200	    # Trail endpoints determine the 2 destination sprites (no color tiebreaking).
   201	    te1, te2 = _find_trail_endpoints(g, grey, sprites)
   202	    trail_eps = {te1, te2}
   203	
   204	    eps_pair = [te1, te2]
   205	    opts = {ep: [sp for sp in sprites if ep in _ports_for_sprite(sp, g, trail_eps)]
   206	            for ep in eps_pair}
   207	
   208	    # Bipartite match: fewer-options-first; tiebreak by sprite farthest from OTHER endpoint
   209	    dest: list[dict] = [None, None]  # type: ignore[list-item]
   210	    order = [0, 1] if len(opts[te1]) <= len(opts[te2]) else [1, 0]
   211	    used: set[int] = set()
   212	    for i in order:
   213	        ep = eps_pair[i]
   214	        other = eps_pair[1 - i]
   215	        cands = [sp for sp in opts[ep] if id(sp) not in used]
   216	        best = max(cands, key=lambda sp: abs(sp["center_pos"][0] - other[0])
   217	                   + abs(sp["center_pos"][1] - other[1]))
   218	        dest[i] = best
   219	        used.add(id(best))
