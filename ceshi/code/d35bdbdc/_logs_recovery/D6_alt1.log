   151	def _ports_for_sprite(sprite: dict, g: np.ndarray, eps: set[tuple[int, int]]) -> list[tuple[int, int]]:
   152	    """
   153	    A grey endpoint (er,ec) is a port for this sprite if:
   154	      - it's exactly 2 steps away from the sprite center (Manhattan distance 2),
   155	      - the intermediate cell (1 step away from center toward endpoint) is the sprite border color.
   156	    """
   157	    cr, cc = sprite["center_pos"]
   158	    b = int(sprite["border"])
   159	    ports: list[tuple[int, int]] = []
   160	    for ir, ic in neighbors4(cr, cc):
   161	        dr, dc = ir - cr, ic - cc
   162	        er, ec = cr + 2 * dr, cc + 2 * dc
   163	        if (er, ec) not in eps:
   164	            continue
   165	        if 0 <= ir < g.shape[0] and 0 <= ic < g.shape[1] and int(g[ir, ic]) == b:
   166	            ports.append((er, ec))
   167	    return ports
