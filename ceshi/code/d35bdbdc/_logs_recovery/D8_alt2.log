@@ -0,0 +1,690 @@
+# Variant of d35bdbdc
+# Dimension: D8 — 路径在输出中的处理 (trajectory)
+# Change: 灰色路径在输出中保留（未被删除或修改）... → 路径填充为目标精灵的边框色
+
+"""
+Design analysis for the D8 variant.
+
+variant_spec:
+  unchanged_core:
+    grid: 10x10, bg inferred from boundary, input path color fixed at grey=5
+    sprites: 4-5 clipped-or-not bordered 3x3 sprites, all same shape per example
+    roles: 2 destinations chosen by the two path endpoints; 1-2 sources matched by border color;
+      remaining sprites are distractors and are deleted
+    lookup_rule: destination.center -> source.border, then source.center replaces destination.center
+  changed_core:
+    output_path:
+      old: the whole winding trail stayed grey
+      new: the ordered trail is split into two contiguous halves; the half nearer endpoint A is recolored
+        to destination A's border, and the half nearer endpoint B is recolored to destination B's border
+    visibility_guard:
+      generator only keeps even-length trails, so every path cell belongs unambiguously to one endpoint
+      without needing an invisible tie-break at the midpoint
+  behavior_trace:
+    small_example:
+      input: endpoint-left touches a blue-bordered destination, endpoint-right touches an orange-bordered
+        destination, and the full trail is grey
+      original_output: both destinations survive, centers are updated, and the full trail remains grey
+      variant_output: the same two destinations survive and get the same center transfer, but the ordered
+        left half of the trail becomes blue while the ordered right half becomes orange
+    difference_point:
+      the only semantic change happens after destination detection and center transfer; object matching stays
+      the same, but the output now depends on the trail order rather than only on its endpoint set
+  complexity_check:
+    why_not_single_color_path: one whole-path color would hide which endpoint owns which portion and would
+      collapse the two-destination structure into a weaker cue
+    why_not_more_than_two_bands: extra bands would add freedom not supported by the original task and would
+      be hard to infer from 2-4 examples
+    support_in_examples: each output path repeats each destination border color across several cells, so the
+      recoloring rule is visible instead of looking like isolated endpoint noise
+  implicit_assumptions_audit:
+    sprite_detection: unchanged, because the solver still reads the input where the trail is grey; recolored
+      path cells only appear in outputs generated by this variant
+    endpoint_logic: old code only needed the two endpoint cells; the variant needs the full ordered trail, so
+      the endpoint finder is upgraded into a short Hamiltonian-path tracer over the grey component
+    cleanup_order: old code could leave the trail grey throughout; now recoloring must happen after the
+      non-destination cleanup, otherwise the recolored trail would be mistaken for extra foreground and deleted
+    destination_assignment: still must be endpoint-based rather than color-based, because color ids are not a
+      visible ordering signal
+  placement_legality:
+    output_first: place the two destination sprites first, reserve a valid port for each, build one 8-connected
+      thin trail between the ports, recolor the trail in the output, then derive the input by turning that
+      trail back to grey and restoring the original destination center colors
+    collision_control: sources and distractors are added only after the input trail is grey again, using the
+      same no-overlap and no-4-touch checks as the original task
+  observability:
+    visual_clues:
+      - only two path colors appear in the output, and both are already present as the border colors of the
+        two surviving destination sprites
+      - each path color occupies one contiguous segment, so the path looks absorbed into the nearer target
+      - no hidden ordering by color id or size is used
+"""
+
+import random
+from collections import deque
+
+import numpy as np
+
+from arc_utils import components_mask, neighbors4, neighbors8, paste
+
+
+def _bg_boundary(g: np.ndarray) -> int:
+    """Most common color along the 1-cell outer border."""
+    border = np.concatenate([g[0, :], g[-1, :], g[1:-1, 0], g[1:-1, -1]])
+    vals, cnts = np.unique(border, return_counts=True)
+    return int(vals[cnts.argmax()])
+
+
+def _trail_port_cells(
+    g: np.ndarray, grey: int, sprites: list[dict], cells: set[tuple[int, int]],
+) -> set[tuple[int, int]]:
+    """Grey cells that sit exactly two steps outside a sprite center across a border cell."""
+    h, w = g.shape
+    port_cells: set[tuple[int, int]] = set()
+    for sp in sprites:
+        cr, cc = sp["center_pos"]
+        b = int(sp["border"])
+        for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
+            ir, ic = cr + dr, cc + dc
+            er, ec = cr + 2 * dr, cc + 2 * dc
+            if (er, ec) in cells and 0 <= ir < h and 0 <= ic < w and int(g[ir, ic]) == b:
+                port_cells.add((er, ec))
+    return port_cells
+
+
+def _trace_trail_path(g: np.ndarray, grey: int, sprites: list[dict]) -> list[tuple[int, int]]:
+    """Trace the grey one-stroke trail in order from one endpoint port to the other."""
+    cells = set((int(r), int(c)) for r, c in zip(*np.where(g == grey), strict=False))
+    assert cells, "expected a grey trail"
+
+    adj: dict[tuple[int, int], list[tuple[int, int]]] = {}
+    for r, c in cells:
+        adj[(r, c)] = [(nr, nc) for nr, nc in neighbors8(r, c) if (nr, nc) in cells]
+
+    port_cells = _trail_port_cells(g, grey, sprites, cells)
+    deg1 = sorted(cell for cell, nbs in adj.items() if len(nbs) == 1)
+
+    starts = sorted((set(deg1) & port_cells) or set(deg1) or port_cells or cells)
+    valid_ends = set(port_cells) or set(deg1) or set(cells)
+    n = len(cells)
+
+    for start in starts:
+        visited = {start}
+        path = [start]
+
+        def dfs(cur: tuple[int, int]) -> bool:
+            if len(path) == n:
+                return cur in valid_ends and (n == 1 or cur != start)
+
+            nexts = [nb for nb in adj[cur] if nb not in visited]
+            nexts.sort(
+                key=lambda nb: (
+                    sum(1 for nxt in adj[nb] if nxt not in visited),
+                    abs(nb[0] - start[0]) + abs(nb[1] - start[1]),
+                    nb,
+                )
+            )
+            for nb in nexts:
+                visited.add(nb)
+                path.append(nb)
+                if dfs(nb):
+                    return True
+                path.pop()
+                visited.remove(nb)
+            return False
+
+        if dfs(start):
+            return path.copy()
+
+    raise AssertionError("could not trace grey cells as one-stroke trail")
+
+
+def _detect_bordered_sprites(g: np.ndarray, bg: int, grey: int) -> list[dict]:
+    """
+    Bordered sprite = a 4-connected component (excluding bg/grey) with exactly 2 colors:
+      - border color appears multiple times
+      - center color appears exactly once (its location is the 'center')
+    This also handles clipped/partial borders (e.g., near the grid edge).
+    """
+    mask = (g != bg) & (g != grey)
+    comps = components_mask(mask, connectivity=4)
+    sprites: list[dict] = []
+    for pts in comps:
+        cols = [int(g[r, c]) for r, c in pts]
+        uniq = sorted(set(cols))
+        if len(uniq) != 2:
+            continue
+        counts = {c: cols.count(c) for c in uniq}
+        center_color = min(counts, key=lambda c: counts[c])
+        if counts[center_color] != 1:
+            continue
+        border_color = [c for c in uniq if c != center_color][0]
+        if border_color == bg or border_color == grey or center_color == grey:
+            continue
+
+        center_pos = None
+        for r, c in pts:
+            if int(g[r, c]) == center_color:
+                center_pos = (int(r), int(c))
+                break
+        if center_pos is None:
+            continue
+        sprites.append(
+            {
+                "pts": pts,
+                "border": int(border_color),
+                "center": int(center_color),
+                "center_pos": center_pos,
+            }
+        )
+    return sprites
+
+
+def _ports_for_sprite(sprite: dict, g: np.ndarray, eps: set[tuple[int, int]]) -> list[tuple[int, int]]:
+    """
+    A grey endpoint (er,ec) is a port for this sprite if:
+      - it's exactly 2 steps away from the sprite center (Manhattan distance 2),
+      - the intermediate cell (1 step away from center toward endpoint) is the sprite border color.
+    """
+    cr, cc = sprite["center_pos"]
+    b = int(sprite["border"])
+    ports: list[tuple[int, int]] = []
+    for ir, ic in neighbors4(cr, cc):
+        dr, dc = ir - cr, ic - cc
+        er, ec = cr + 2 * dr, cc + 2 * dc
+        if (er, ec) not in eps:
+            continue
+        if 0 <= ir < g.shape[0] and 0 <= ic < g.shape[1] and int(g[ir, ic]) == b:
+            ports.append((er, ec))
+    return ports
+
+
+def _paint_trail(out: np.ndarray, trail: list[tuple[int, int]], endpoint_colors: list[int]) -> None:
+    """Color the ordered trail by the nearer endpoint's destination border color."""
+    split = len(trail) // 2
+    for i, (r, c) in enumerate(trail):
+        out[r, c] = int(endpoint_colors[0] if i < split else endpoint_colors[1])
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Transfer center colors between bordered sprites, then absorb the trail into the two kept targets.
+
+    Input structure:
+    - The grid contains background, a grey (5) one-stroke trail, and several small bordered sprites whose
+      single center pixel differs from the border color.
+    - The two trail endpoints are port cells that sit exactly two steps away from two destination sprites.
+
+    Rule:
+    - Use the ordered grey trail endpoints to identify the two destination sprites.
+    - For each destination, find the source sprite whose border color matches that destination's original
+      center color, and copy the source center color into the destination center.
+    - Delete every non-destination sprite and any extra foreground not attached to the destinations.
+    - Finally recolor the ordered trail: the half nearer the first endpoint takes that destination border
+      color, and the half nearer the second endpoint takes the other destination border color.
+
+    Key insight:
+    - The endpoint ports still decide which sprites survive, but the output now depends on the trail order:
+      once the two destinations are known, each path segment is absorbed into the nearer destination's border.
+    """
+    g = np.asarray(grid, dtype=int)
+    bg = _bg_boundary(g)
+    grey = 5
+
+    sprites = _detect_bordered_sprites(g, bg, grey)
+    assert sprites, "expected at least one bordered sprite in the grid"
+
+    trail = _trace_trail_path(g, grey, sprites)
+    te1, te2 = trail[0], trail[-1]
+    trail_eps = {te1, te2}
+
+    eps_pair = [te1, te2]
+    opts = {ep: [sp for sp in sprites if ep in _ports_for_sprite(sp, g, trail_eps)] for ep in eps_pair}
+
+    # Bipartite match: fewer-options-first; tiebreak by sprite farthest from OTHER endpoint.
+    dest: list[dict] = [None, None]  # type: ignore[list-item]
+    order = [0, 1] if len(opts[te1]) <= len(opts[te2]) else [1, 0]
+    used: set[int] = set()
+    for i in order:
+        ep = eps_pair[i]
+        other = eps_pair[1 - i]
+        cands = [sp for sp in opts[ep] if id(sp) not in used]
+        assert cands, "expected each trail endpoint to map to a destination sprite"
+        best = max(
+            cands,
+            key=lambda sp: abs(sp["center_pos"][0] - other[0]) + abs(sp["center_pos"][1] - other[1]),
+        )
+        dest[i] = best
+        used.add(id(best))
+    assert all(d is not None for d in dest), "expected exactly 2 dest sprites from trail endpoints"
+    dest_ids = {id(sp) for sp in dest}
+
+    by_border: dict[int, list[dict]] = {}
+    for sp in sprites:
+        by_border.setdefault(int(sp["border"]), []).append(sp)
+
+    out = g.copy()
+
+    for sp in sprites:
+        if id(sp) in dest_ids:
+            continue
+        for r, c in sp["pts"]:
+            out[r, c] = bg
+
+    # Keep only destination-connected non-grey foreground before recoloring the trail.
+    keep = np.zeros(out.shape, dtype=bool)
+    q: list[tuple[int, int]] = []
+    for d in dest:
+        for r, c in d["pts"]:
+            if out[r, c] != bg and out[r, c] != grey and not keep[r, c]:
+                keep[r, c] = True
+                q.append((r, c))
+    while q:
+        r, c = q.pop()
+        for nr, nc in neighbors4(r, c):
+            if 0 <= nr < out.shape[0] and 0 <= nc < out.shape[1]:
+                if keep[nr, nc]:
+                    continue
+                if out[nr, nc] == bg or out[nr, nc] == grey:
+                    continue
+                keep[nr, nc] = True
+                q.append((nr, nc))
+    drop = (out != bg) & (out != grey) & (~keep)
+    out[drop] = bg
+
+    for d in dest:
+        want_border = int(d["center"])
+        srcs = by_border.get(want_border, [])
+        if not srcs:
+            continue
+        assert len(srcs) == 1, "each destination color should match at most one source border"
+        src = srcs[0]
+        dr, dc = d["center_pos"]
+        out[dr, dc] = int(src["center"])
+
+    _paint_trail(out, trail, [int(dest[0]["border"]), int(dest[1]["border"])])
+    return out
+
+
+# --------------- generator ---------------
+
+# -- CFG: tunable generation parameters ---------------------------------------
+GRID_H, GRID_W = 10, 10
+BG, GREY = 0, 5
+SPRITE_COUNTS = [4, 5]
+SOURCE_COUNTS = [1, 2]
+INTERIOR_DEST_WEIGHTS = [3, 1]
+PATH_LEN_MIN, PATH_LEN_MAX = 10, 24
+PATH_LEN_CHOICES = [n for n in range(PATH_LEN_MIN, PATH_LEN_MAX + 1) if n % 2 == 0]
+MIN_PORT_DIST_FRAC = 3
+MAX_THICKNESS = 3
+PATH_WANDER_AWAY_P = 0.5
+PATH_WANDER_DIAG_P = 0.6
+PATH_MODERATE_RANDOM_P = 0.3
+GEN_RETRIES = 300
+
+
+def _make_sprite_patch(shape_type, border_color, center_color):
+    """Return 3x3 patch for a box or plus. Center is at (1,1)."""
+    if shape_type == "box":
+        p = np.full((3, 3), border_color, dtype=int)
+    else:
+        p = np.zeros((3, 3), dtype=int)
+        for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
+            p[1 + dr, 1 + dc] = border_color
+    p[1, 1] = center_color
+    return p
+
+
+def _place_sprite(grid, patch, r0, c0):
+    """Place patch cells on grid, skipping transparent background and clipping to bounds."""
+    paste(grid, patch, r0, c0, transparent=BG, clip=True)
+
+
+def _erase_sprite(grid, patch, r0, c0):
+    """Undo a _place_sprite by zeroing non-transparent patch cells."""
+    h, w = grid.shape
+    for dr in range(3):
+        for dc in range(3):
+            rr, cc = r0 + dr, c0 + dc
+            if 0 <= rr < h and 0 <= cc < w and patch[dr, dc] != BG:
+                grid[rr, cc] = BG
+
+
+def _overlaps(grid, patch, r0, c0):
+    """Check if placing patch at (r0,c0) would overlap or 4-touch non-bg, non-grey cells."""
+    h, w = grid.shape
+    patch_cells = set()
+    for dr in range(3):
+        for dc in range(3):
+            if patch[dr, dc] != BG:
+                rr, cc = r0 + dr, c0 + dc
+                if 0 <= rr < h and 0 <= cc < w:
+                    if grid[rr, cc] != BG:
+                        return True
+                    patch_cells.add((rr, cc))
+    for rr, cc in patch_cells:
+        for nr, nc in [(rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)]:
+            if (nr, nc) not in patch_cells and 0 <= nr < h and 0 <= nc < w:
+                if int(grid[nr, nc]) not in (BG, GREY):
+                    return True
+    return False
+
+
+def _sprite_positions():
+    """All valid (r0,c0) for a 3x3 patch where center stays on grid."""
+    return [
+        (r0, c0)
+        for r0 in range(-1, GRID_H)
+        for c0 in range(-1, GRID_W)
+        if 0 <= r0 + 1 < GRID_H and 0 <= c0 + 1 < GRID_W
+    ]
+
+
+def _is_edge(r0, c0):
+    return r0 <= 0 or r0 + 3 >= GRID_H or c0 <= 0 or c0 + 3 >= GRID_W
+
+
+def _too_thick(r, c, occupied):
+    """Check if adding (r,c) would push any cell's 8-degree above MAX_THICKNESS."""
+    nbs = [
+        (r + dr, c + dc)
+        for dr in (-1, 0, 1)
+        for dc in (-1, 0, 1)
+        if (dr or dc) and (r + dr, c + dc) in occupied
+    ]
+    if len(nbs) > MAX_THICKNESS:
+        return True
+    for nr, nc in nbs:
+        deg = sum(
+            1
+            for dr in (-1, 0, 1)
+            for dc in (-1, 0, 1)
+            if (dr or dc) and (nr + dr, nc + dc) in occupied
+        )
+        if deg + 1 > MAX_THICKNESS:
+            return True
+    return False
+
+
+def _gen_winding_path(grid, start, end, target_len):
+    """Generate a winding 8-connected path with no revisits."""
+    path = [start]
+    visited = {start}
+    cr, cc = start
+
+    def score(m):
+        return abs(m[0] - end[0]) + abs(m[1] - end[1])
+
+    for _ in range(target_len + 20):
+        if max(abs(cr - end[0]), abs(cc - end[1])) <= 1:
+            break
+
+        moves = []
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                if dr == 0 and dc == 0:
+                    continue
+                nr, nc = cr + dr, cc + dc
+                if (
+                    0 <= nr < GRID_H
+                    and 0 <= nc < GRID_W
+                    and (nr, nc) not in visited
+                    and grid[nr, nc] == BG
+                    and not _too_thick(nr, nc, visited)
+                ):
+                    moves.append((nr, nc, dr != 0 and dc != 0))
+
+        if not moves:
+            return None
+
+        dist = abs(cr - end[0]) + abs(cc - end[1])
+        budget = target_len - len(path)
+        diag = [m for m in moves if m[2]]
+        away = [m for m in moves if score(m) > dist]
+
+        if budget > dist + 4:
+            if away and random.random() < PATH_WANDER_AWAY_P:
+                pool = away
+            elif diag and random.random() < PATH_WANDER_DIAG_P:
+                pool = diag
+            else:
+                pool = moves
+            chosen = random.choice(pool)
+        elif budget > dist + 1:
+            pool = diag if diag and random.random() < PATH_WANDER_DIAG_P else moves
+            if random.random() < PATH_MODERATE_RANDOM_P:
+                chosen = random.choice(pool)
+            else:
+                chosen = min(pool, key=score)
+        else:
+            best = sorted(moves, key=score)
+            top = [m for m in best if score(m) <= score(best[0]) + 1]
+            dtop = [m for m in top if m[2]]
+            chosen = random.choice(dtop) if dtop else best[0]
+
+        cr, cc = chosen[0], chosen[1]
+        path.append((cr, cc))
+        visited.add((cr, cc))
+
+    if end not in visited:
+        if not _too_thick(end[0], end[1], visited):
+            path.append(end)
+        else:
+            return None
+
+    return path
+
+
+def _is_8_connected(cells):
+    """Check 8-connectivity of a set of cells via BFS."""
+    if len(cells) <= 1:
+        return True
+    cell_set = set(cells)
+    start = next(iter(cell_set))
+    visited = {start}
+    queue = deque([start])
+    while queue:
+        r, c = queue.popleft()
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                if dr == 0 and dc == 0:
+                    continue
+                nb = (r + dr, c + dc)
+                if nb in cell_set and nb not in visited:
+                    visited.add(nb)
+                    queue.append(nb)
+    return len(visited) == len(cell_set)
+
+
+def _find_port_dir(grid, cr, cc, bc):
+    """Find a valid port direction for a sprite centered at (cr,cc) with border color bc."""
+    dirs = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+    random.shuffle(dirs)
+    for dr, dc in dirs:
+        ir, ic = cr + dr, cc + dc
+        er, ec = cr + 2 * dr, cc + 2 * dc
+        if not (0 <= ir < GRID_H and 0 <= ic < GRID_W and 0 <= er < GRID_H and 0 <= ec < GRID_W):
+            continue
+        if grid[ir, ic] == bc and grid[er, ec] == BG:
+            return (er, ec)
+    return None
+
+
+def _assign_colors(border_colors, num_sprites):
+    """Assign roles (dest/source/distractor) and pick center colors for all sprites."""
+    remaining = list(range(2, num_sprites))
+    num_sources = random.choice(SOURCE_COUNTS) if len(remaining) >= 2 else max(1, len(remaining))
+    if num_sources == 0:
+        return None
+    source_indices = remaining[:num_sources]
+    distractor_indices = remaining[num_sources:]
+
+    if num_sources == 1:
+        dest_center_colors = [border_colors[source_indices[0]]] * 2
+    else:
+        dest_center_colors = [border_colors[si] for si in source_indices]
+
+    source_center_colors = []
+    for j, si in enumerate(source_indices):
+        forbidden = {BG, GREY, border_colors[si]}
+        if num_sources == 1:
+            forbidden.update([border_colors[0], border_colors[1]])
+        else:
+            forbidden.add(border_colors[j])
+        candidates = [c for c in range(1, 10) if c not in forbidden]
+        if not candidates:
+            return None
+        source_center_colors.append(random.choice(candidates))
+
+    distractor_center_colors = [
+        random.choice([c for c in range(1, 10) if c != GREY and c != border_colors[di]])
+        for di in distractor_indices
+    ]
+
+    output_dest_centers = (source_center_colors * 2)[:2] if num_sources == 1 else source_center_colors
+
+    return dict(
+        source_indices=source_indices,
+        distractor_indices=distractor_indices,
+        dest_center_colors=dest_center_colors,
+        source_center_colors=source_center_colors,
+        distractor_center_colors=distractor_center_colors,
+        output_dest_centers=output_dest_centers,
+    )
+
+
+def _place_dests(output_grid, shape_type, border_colors, output_dest_centers, min_port_dist):
+    """Place 2 destination sprites on the grid. Returns their center positions or None."""
+    all_pos = _sprite_positions()
+    edge_pos = [p for p in all_pos if _is_edge(p[0], p[1])]
+    int_pos = [p for p in all_pos if not _is_edge(p[0], p[1])]
+    num_interior_dest = random.choices([0, 1], weights=INTERIOR_DEST_WEIGHTS)[0]
+
+    dest_center_positions = []
+    first_port = None
+
+    for i in range(2):
+        bc = border_colors[i]
+        patch = _make_sprite_patch(shape_type, bc, output_dest_centers[i])
+        pool = list(int_pos if i < num_interior_dest else edge_pos)
+        random.shuffle(pool)
+
+        placed = False
+        for r0, c0 in pool:
+            if _overlaps(output_grid, patch, r0, c0):
+                continue
+            cr, cc_pos = r0 + 1, c0 + 1
+
+            _place_sprite(output_grid, patch, r0, c0)
+            port = _find_port_dir(output_grid, cr, cc_pos, bc)
+            if port is None:
+                _erase_sprite(output_grid, patch, r0, c0)
+                continue
+
+            if i == 1:
+                dist = abs(port[0] - first_port[0]) + abs(port[1] - first_port[1])
+                if dist < min_port_dist:
+                    _erase_sprite(output_grid, patch, r0, c0)
+                    continue
+
+            dest_center_positions.append((cr, cc_pos))
+            if i == 0:
+                first_port = port
+            placed = True
+            break
+
+        if not placed:
+            return None
+
+    return dest_center_positions
+
+
+def _gen_attempt():
+    shape_type = random.choice(["box", "plus"])
+    palette = [c for c in range(1, 10) if c != GREY]
+    num_sprites = random.choice(SPRITE_COUNTS)
+    border_colors = random.sample(palette, num_sprites)
+
+    colors = _assign_colors(border_colors, num_sprites)
+    if colors is None:
+        return None
+
+    target_len = random.choice(PATH_LEN_CHOICES)
+    min_port_dist = max(3, target_len // MIN_PORT_DIST_FRAC)
+
+    output_grid = np.zeros((GRID_H, GRID_W), dtype=int)
+    result = _place_dests(output_grid, shape_type, border_colors, colors["output_dest_centers"], min_port_dist)
+    if result is None:
+        return None
+    dest_center_positions = result
+
+    port_cells = []
+    for i in range(2):
+        cr, cc_pos = dest_center_positions[i]
+        port = _find_port_dir(output_grid, cr, cc_pos, border_colors[i])
+        if port is None:
+            return None
+        port_cells.append(port)
+
+    path_cells = _gen_winding_path(output_grid, port_cells[0], port_cells[1], target_len)
+    if path_cells is None:
+        return None
+    if not (PATH_LEN_MIN <= len(path_cells) <= PATH_LEN_MAX):
+        return None
+    if len(path_cells) % 2 != 0:
+        return None
+    if not _is_8_connected(path_cells):
+        return None
+
+    path_set = set(path_cells)
+    for pr, pc in port_cells:
+        deg = sum((nr, nc) in path_set for nr, nc in [(pr - 1, pc), (pr + 1, pc), (pr, pc - 1), (pr, pc + 1)])
+        if deg > 1:
+            return None
+
+    _paint_trail(output_grid, path_cells, [border_colors[0], border_colors[1]])
+
+    input_grid = output_grid.copy()
+    for r, c in path_cells:
+        input_grid[r, c] = GREY
+    for i in range(2):
+        cr, cc_pos = dest_center_positions[i]
+        input_grid[cr, cc_pos] = colors["dest_center_colors"][i]
+
+    sprites_to_place = (
+        [(border_colors[si], colors["source_center_colors"][j]) for j, si in enumerate(colors["source_indices"])]
+        + [
+            (border_colors[di], colors["distractor_center_colors"][j])
+            for j, di in enumerate(colors["distractor_indices"])
+        ]
+    )
+    all_pos = _sprite_positions()
+    for bc, cc_color in sprites_to_place:
+        patch = _make_sprite_patch(shape_type, bc, cc_color)
+        pool = list(all_pos)
+        random.shuffle(pool)
+        placed = False
+        for r0, c0 in pool:
+            if not _overlaps(input_grid, patch, r0, c0):
+                _place_sprite(input_grid, patch, r0, c0)
+                placed = True
+                break
+        if not placed:
+            return None
+
+    try:
+        out = main(input_grid)
+        if np.array_equal(out, output_grid):
+            return input_grid
+    except Exception:
+        pass
+    return None
+
+
+def generate_input():
+    for _ in range(GEN_RETRIES):
+        result = _gen_attempt()
+        if result is not None:
+            return result
+    raise RuntimeError(f"Failed to generate input after {GEN_RETRIES} attempts")

