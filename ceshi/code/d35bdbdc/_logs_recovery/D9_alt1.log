   121	    sprites: list[dict] = []
   122	    for pts in comps:
   123	        cols = [int(g[r, c]) for r, c in pts]
   124	        uniq = sorted(set(cols))
   125	        if len(uniq) != 2:
   126	            continue
   127	        counts = {c: cols.count(c) for c in uniq}
   128	        center_color = min(counts, key=lambda c: counts[c])
   129	        if counts[center_color] != 1:
   130	            continue
   131	        border_color = [c for c in uniq if c != center_color][0]
   132	        if border_color == bg or border_color == grey or center_color == grey:
   133	            continue
   134	
