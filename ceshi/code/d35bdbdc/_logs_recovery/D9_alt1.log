+
+def _is_8_connected(cells):
+    """Check 8-connectivity of a set of cells via BFS."""
+    if len(cells) <= 1:
+        return True
+    cell_set = set(cells)
+    start = next(iter(cell_set))
+    visited = {start}
+    queue = deque([start])
+    while queue:
+        r, c = queue.popleft()
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                if dr == 0 and dc == 0:
+                    continue
+                nb = (r + dr, c + dc)
+                if nb in cell_set and nb not in visited:
+                    visited.add(nb)
+                    queue.append(nb)
+    return len(visited) == len(cell_set)
+
