   112	def _detect_bordered_sprites(g: np.ndarray, bg: int, grey: int) -> list[dict]:
   113	    """
   114	    Bordered sprite = a 4-connected component (excluding bg/grey) with exactly 2 colors:
   115	      - border color appears multiple times
   116	      - center color appears exactly once (its location is the 'center')
   117	    This also handles clipped/partial borders (e.g., near the grid edge).
   118	    """
