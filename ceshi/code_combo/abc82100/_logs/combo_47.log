   104	def _chebyshev(a: tuple[int, int], b: tuple[int, int]) -> int:
   105	    return max(abs(int(a[0]) - int(b[0])), abs(int(a[1]) - int(b[1])))
   106	
   107	
   108	def _anchor_distance(pattern: np.ndarray, anchor: tuple[int, int]) -> int:
   109	    return min(_chebyshev((int(r), int(c)), anchor) for r, c in pattern)
   110	
   111	
   112	def _is_edge_cell(r: int, c: int, H: int, W: int) -> bool:
   113	    return int(r) in (0, H - 1) or int(c) in (0, W - 1)
   114	
   115	
   116	def _reserve_4neighbors(reserved: set[tuple[int, int]], cells) -> None:
   117	    for r, c in cells:
   118	        for dr, dc in _DIRS4:
   119	            reserved.add((int(r) + dr, int(c) + dc))
