   136	def _fit_sides(rel: list[tuple[int, int]]) -> list[str]:
   137	    rows = [int(rr) for rr, _ in rel]
   138	    cols = [int(cc) for _, cc in rel]
   139	    sides: list[str] = []
   140	    if min(rows) >= 0:
   141	        sides.append("top")
   142	    if max(rows) <= 0:
   143	        sides.append("bottom")
   144	    if min(cols) >= 0:
   145	        sides.append("left")
   146	    if max(cols) <= 0:
   147	        sides.append("right")
   148	    return sides
