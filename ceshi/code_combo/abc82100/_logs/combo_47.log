   122	def _make_stencil(min_pixels: int, max_pixels: int) -> list[tuple[int, int]]:
   123	    n = random.randint(min_pixels, max_pixels)
   124	    coords = {(0, 0)}
   125	    for _ in range(n - 1):
   126	        frontier = set()
   127	        for r, c in coords:
   128	            for dr, dc in _DIRS8:
   129	                p = (r + dr, c + dc)
   130	                if p not in coords:
   131	                    frontier.add(p)
   132	        coords.add(random.choice(list(frontier)))
   133	    return sorted(coords)
