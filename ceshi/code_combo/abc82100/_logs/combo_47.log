   201	def _discover_rules(grid: np.ndarray, bg: int, pattern_color: int = 8) -> list[dict]:
   202	    h, w = grid.shape
   203	    patterns = components_mask(grid == pattern_color, connectivity=8)
   204	    rules: list[dict] = []
   205	    seen: set[tuple[tuple[int, int], tuple[int, int], int]] = set()
   206	
   207	    for r in range(h):
   208	        for c in range(w):
   209	            source_color = int(grid[r, c])
   210	            if source_color in (int(bg), int(pattern_color)):
   211	                continue
   212	
   213	            for dr, dc in _DIRS4:
   214	                tr = r + dr
   215	                tc = c + dc
   216	                if not (0 <= tr < h and 0 <= tc < w):
   217	                    continue
   218	
   219	                target_color = int(grid[tr, tc])
   220	                if target_color in (int(bg), int(pattern_color)) or target_color == source_color:
   221	                    continue
   222	
   223	                anchor = (tr + dr, tc + dc)
   224	                candidates: list[tuple[int, int, np.ndarray]] = []
   225	                for i, pattern in enumerate(patterns):
   226	                    dist = _anchor_distance(pattern, anchor)
   227	                    if dist <= 1:
   228	                        candidates.append((int(dist), int(i), pattern))
   229	
   230	                if not candidates:
   231	                    continue
   232	
   233	                candidates.sort(key=lambda item: (item[0], len(item[2])))
   234	                _dist, pattern_index, pattern = candidates[0]
   235	                key = ((int(r), int(c)), (int(tr), int(tc)), int(pattern_index))
   236	                if key in seen:
   237	                    continue
   238	                seen.add(key)
   239	                rules.append(
   240	                    {
   241	                        "source_color": int(source_color),
   242	                        "target_color": int(target_color),
   243	                        "source_pos": (int(r), int(c)),
   244	                        "target_pos": (int(tr), int(tc)),
   245	                        "anchor": (int(anchor[0]), int(anchor[1])),
   246	                        "pattern": np.asarray(pattern, dtype=int),
   247	                    }
   248	                )
   249	
   250	    return rules
   251	
