   319	def _build_rules(num_rules: int, area: int):
   320	    colors = NON_BG_NON_TEAL_COLORS[:]
   321	    random.shuffle(colors)
   322	
   323	    max_s = min(STENCIL_MAX_CAP, max(2, area // STENCIL_MAX_AREA_DIV))
   324	    min_s = min(max(2, area // STENCIL_MIN_AREA_DIV), max_s)
   325	
   326	    rules: list[dict] = []
   327	    used: set[int] = set()
   328	    for i in range(num_rules):
   329	        src_c, tgt_c = colors[2 * i], colors[2 * i + 1]
   330	        used.update((src_c, tgt_c))
   331	        chosen = None
   332	        for _ in range(RULE_BUILD_RETRIES):
   333	            stencil = _make_stencil(min_s, max_s)
   334	            candidates = []
   335	            for anchor in stencil:
   336	                rel = [(r - anchor[0], c - anchor[1]) for r, c in stencil]
   337	                sides = _fit_sides(rel)
   338	                if sides:
   339	                    candidates.append((len(sides), rel, sides))
   340	            if candidates:
   341	                best = max(count for count, _rel, _sides in candidates)
   342	                _count, rel, sides = random.choice([item for item in candidates if item[0] == best])
   343	                chosen = {"src": src_c, "tgt": tgt_c, "rel": rel, "valid_sides": sides}
   344	                break
   345	        if chosen is None:
   346	            return None, None
   347	        rules.append(chosen)
   348	
   349	    return rules, used
