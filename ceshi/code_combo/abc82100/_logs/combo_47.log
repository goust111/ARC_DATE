   253	def main(grid: np.ndarray) -> np.ndarray:
   254	    """
   255	    Learn interior source-target-stencil examples and apply them only from the border.
   256	
   257	    Input structure:
   258	    - The board has a black background, interior rule legends, teal (8) stencil
   259	      components, and scattered source-colored pixels that appear only on the outer edge.
   260	    - Each legend is a 4-neighbor source->target pair, with the anchor one more step in

