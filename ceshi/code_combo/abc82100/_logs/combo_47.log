   352	def _place_legends(rules, inp, occupied, reserved):
   353	    H, W = inp.shape
   354	    legend_cells: set[tuple[int, int]] = set()
   355	
   356	    for rule in rules:
   357	        rel = rule["rel"]
   358	        placed = False
   359	        for _ in range(LEGEND_RETRIES):
   360	            dr, dc = random.choice(_DIRS4)
   361	            sr, sc = random.randint(1, H - 2), random.randint(1, W - 2)
   362	            tr, tc = sr + dr, sc + dc
   363	            ar, ac = sr + 2 * dr, sc + 2 * dc
   364	            if not (0 <= tr < H and 0 <= tc < W and 0 <= ar < H and 0 <= ac < W):
   365	                continue
   366	            teal_cells = set()
   367	            ok = True
   368	            for rr, cc in rel:
   369	                nr, nc = ar + rr, ac + cc
   370	                if not (0 <= nr < H and 0 <= nc < W):
   371	                    ok = False
   372	                    break
   373	                teal_cells.add((nr, nc))
   374	            if not ok:
   375	                continue
   376	            all_cells = {(sr, sc), (tr, tc), (ar, ac)} | teal_cells
   377	            if any(_is_edge_cell(r, c, H, W) for r, c in all_cells):
   378	                continue
   379	            if all_cells & (occupied | reserved):
   380	                continue
   381	            inp[sr, sc] = rule["src"]
   382	            inp[tr, tc] = rule["tgt"]
   383	            for nr, nc in teal_cells:
   384	                inp[nr, nc] = 8
   385	            occupied.update(all_cells)
   386	            _reserve_4neighbors(reserved, all_cells)
   387	            legend_cells.update(all_cells)
   388	            placed = True
   389	            break
   390	        if not placed:
   391	            return None
   392	
   393	    return legend_cells
