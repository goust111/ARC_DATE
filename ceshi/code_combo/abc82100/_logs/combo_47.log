   151	def _fits_rel(rel: list[tuple[int, int]], sr: int, sc: int, H: int, W: int) -> bool:
   152	    for rr, cc in rel:
   153	        nr = int(sr) + int(rr)
   154	        nc = int(sc) + int(cc)
   155	        if not (0 <= nr < H and 0 <= nc < W):
   156	            return False
   157	    return True
