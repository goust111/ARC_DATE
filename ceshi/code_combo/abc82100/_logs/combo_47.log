   160	def _stamp_cells(rel: list[tuple[int, int]], sr: int, sc: int) -> set[tuple[int, int]]:
   161	    return {(int(sr) + int(rr), int(sc) + int(cc)) for rr, cc in rel}
   162	
   163	
   164	def _side_positions(side: str, H: int, W: int) -> list[tuple[int, int]]:
   165	    if side == "top":
   166	        return [(0, c) for c in range(W)]
   167	    if side == "bottom":
   168	        return [(H - 1, c) for c in range(W)]
   169	    if side == "left":
   170	        return [(r, 0) for r in range(H)]
   171	    return [(r, W - 1) for r in range(H)]
   172	
   173	
   174	def _edge_positions(H: int, W: int) -> list[tuple[int, int]]:
   175	    cells: list[tuple[int, int]] = []
   176	    cells.extend((0, c) for c in range(W))
   177	    cells.extend((H - 1, c) for c in range(W) if H > 1)
   178	    cells.extend((r, 0) for r in range(1, H - 1))
   179	    cells.extend((r, W - 1) for r in range(1, H - 1) if W > 1)
   180	    return cells
   181	
   182	
   183	def _edge_margin(r: int, c: int, H: int, W: int) -> int:
   184	    if int(r) in (0, H - 1):
   185	        return min(int(c), W - 1 - int(c))
   186	    return min(int(r), H - 1 - int(r))
   187	
   188	
   189	def _pick_ranked(candidates: list[tuple[int, int]], H: int, W: int, prefer_large_margin: bool):
   190	    if not candidates:
   191	        return None
   192	    ranked = sorted(
   193	        candidates,
   194	        key=lambda pos: (_edge_margin(pos[0], pos[1], H, W), pos[0], pos[1]),
   195	        reverse=prefer_large_margin,
   196	    )
   197	    window = min(len(ranked), 6)
   198	    return random.choice(ranked[:window])
