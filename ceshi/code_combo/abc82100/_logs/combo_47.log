   396	def _valid_side_candidates(rule, H, W, occupied, reserved, blocked_output, source_cells, valid_output_cells):
   397	    rel = rule["rel"]
   398	    side_to_candidates: dict[str, list[tuple[int, int]]] = {}
   399	    for side in rule["valid_sides"]:
   400	        side_candidates: list[tuple[int, int]] = []
   401	        for r, c in _side_positions(side, H, W):
   402	            if (r, c) in occupied or (r, c) in reserved:
   403	                continue
   404	            stamp = _stamp_cells(rel, r, c)
   405	            if stamp & blocked_output or stamp & valid_output_cells or stamp & source_cells:
   406	                continue
   407	            if _fits_rel(rel, r, c, H, W):
   408	                side_candidates.append((r, c))
   409	        if side_candidates:
   410	            side_to_candidates[side] = side_candidates
   411	    return side_to_candidates
