+
+    conflict = 0
+    total = 0
+    for color, rules_for_color in rules_by_source.items():
+        for sr, sc in map(tuple, np.argwhere(inp == color)):
+            pos = (int(sr), int(sc))
+            if pos in legend_pixels:
