+            total += 1
+            nearest = _choose_nearest_rule_for_source(rules_for_color, pos)
+            if nearest["target_color"] != chosen[color]["target_color"] or len(nearest["pattern"]) != len(chosen[color]["pattern"]):
+                conflict += 1
