+    return out
+
+
+def _combo_metrics(inp: np.ndarray):
+    rules = _discover_rules(inp, bg=get_bg(inp), pattern_color=8)
+    rules_by_source: dict[int, list[dict]] = defaultdict(list)
+    for rule in rules:
