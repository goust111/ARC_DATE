    if groups is None or used_colors is None:
        return None

    inp = np.zeros((h, w), dtype=int)
    occupied: set[tuple[int, int]] = set()
    reserved: set[tuple[int, int]] = set()

    for group in groups:
        for branch in group["branches"]:
