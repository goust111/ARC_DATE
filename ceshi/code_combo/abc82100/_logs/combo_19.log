+        if np.array_equal(combo_out, out) and not np.array_equal(nearest_out, out):
+            return inp
+    except Exception:
+        pass
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(OUTER_RETRIES):
