+    h, w = inp.shape
+    n = random.randint(0, min(BYSTANDER_MAX, len(bystander_colors)))
+    placed = []
+    for _ in range(n):
+        for _ in range(BYSTANDER_RETRIES):
+            r, c = random.randint(0, h - 1), random.randint(0, w - 1)
+            pos = (int(r), int(c))
