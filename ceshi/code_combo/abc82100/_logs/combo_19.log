        combo_out = main(inp)
        nearest_out = _nearest_legend_output(inp)
        if np.array_equal(combo_out, out) and not np.array_equal(nearest_out, out):
            return inp
    except Exception:
        pass
    return None


def generate_input() -> np.ndarray:
    for _ in range(OUTER_RETRIES):
        result = _gen_attempt()
        if result is not None:
            return result

