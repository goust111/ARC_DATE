   286	def _make_stencil(min_pixels: int, max_pixels: int):
   287	    n = random.randint(min_pixels, max_pixels)
   288	    coords = {(0, 0)}
   289	    for _ in range(n - 1):
   290	        frontier = set()
   291	        for r, c in coords:
   292	            for dr, dc in _DIRS8:
   293	                p = (r + dr, c + dc)
   294	                if p not in coords:
   295	                    frontier.add(p)
   296	        coords.add(random.choice(list(frontier)))
   297	    coords_list = sorted(coords)
   298	    return coords_list, random.choice(coords_list)
