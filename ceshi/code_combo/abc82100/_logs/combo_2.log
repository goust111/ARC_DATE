   301	def _discover_rules(
   302	    grid: np.ndarray,
   303	    bg: int,
   304	    pattern_color: int = PATTERN_COLOR,
   305	    marker_color: int = MARKER_COLOR,
   306	) -> list[dict]:
   307	    h, w = grid.shape
   308	    patterns = components_mask(grid == pattern_color, connectivity=8)
   309	    rules: list[dict] = []
   310	    seen: set[tuple[tuple[int, int], tuple[int, int], int]] = set()
   311	
   312	    for r in range(h):
   313	        for c in range(w):
   314	            source_color = int(grid[r, c])
   315	            if source_color in (int(bg), int(pattern_color), int(marker_color)):
   316	                continue
   317	
   318	            for dr, dc in _DIRS4:
   319	                tr = r + dr
   320	                tc = c + dc
   321	                if not (0 <= tr < h and 0 <= tc < w):
   322	                    continue
   323	
   324	                target_color = int(grid[tr, tc])
   325	                if target_color in (int(bg), int(pattern_color), int(marker_color)):
   326	                    continue
   327	                if target_color == source_color:
   328	                    continue
   329	
   330	                anchor = (tr + dr, tc + dc)
   331	                candidates: list[tuple[int, int, np.ndarray]] = []
   332	                for i, pattern in enumerate(patterns):
   333	                    dist = _anchor_distance(pattern, anchor)
   334	                    if dist <= 1:
   335	                        candidates.append((int(dist), int(i), pattern))
   336	
   337	                if not candidates:
   338	                    continue
   339	
   340	                candidates.sort(key=lambda item: (item[0], len(item[2])))
   341	                _dist, pattern_index, pattern = candidates[0]
   342	                key = ((int(r), int(c)), (int(tr), int(tc)), int(pattern_index))
   343	                if key in seen:
   344	                    continue
   345	                seen.add(key)
   346	                rules.append(
   347	                    {
   348	                        "source_color": int(source_color),
   349	                        "target_color": int(target_color),
   350	                        "neighbor_count": _count_non_bg4(grid, int(r), int(c), int(bg)),
   351	                        "source_pos": (int(r), int(c)),
   352	                        "target_pos": (int(tr), int(tc)),
   353	                        "anchor": (int(anchor[0]), int(anchor[1])),
   354	                        "pattern": np.asarray(pattern, dtype=int),
   355	                    }
   356	                )
   357	
   358	    return rules
