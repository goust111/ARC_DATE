   380	        r = int(r)
   381	        c = int(c)
   382	        color = int(g[r, c])
   383	        if (r, c) in legend_cells or color in source_colors or color == MARKER_COLOR:
   384	            continue
   385	        out[r, c] = color
   386	
   387	    for source_color, rule in first_rule_by_color.items():
   388	        ar, ac = rule["anchor"]
   389	        pattern = rule["pattern"]
   390	        for component in _source_components(g, int(source_color), legend_cells):
   391	            sr, sc = _component_anchor(component)
   392	            dr = sr - ar
   393	            dc = sc - ac
   394	            rows = pattern[:, 0] + dr
   395	            cols = pattern[:, 1] + dc
   396	            ok = (0 <= rows) & (rows < h) & (0 <= cols) & (cols < w)
   397	            out[rows[ok], cols[ok]] = int(rule["target_color"])
   398	    return out
