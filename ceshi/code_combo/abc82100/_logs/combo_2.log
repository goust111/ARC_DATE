+        reserved.add((int(r), int(c)))
+        for dr, dc in _DIRS4:
+            reserved.add((int(r + dr), int(c + dc)))
+
+
+def _make_stencil(min_pixels: int, max_pixels: int):
+    n = random.randint(min_pixels, max_pixels)
