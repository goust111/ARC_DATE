+
+def _translated_cells(anchor: tuple[int, int], rel_cells) -> set[tuple[int, int]]:
+    ar, ac = anchor
+    return {(int(ar + rr), int(ac + cc)) for rr, cc in rel_cells}
+
+
+def _eligible_target_dirs(shape: list[tuple[int, int]]) -> list[tuple[int, int]]:
+    pts = set(shape)
+    out = []
+    for dr, dc in _DIRS4:
+        if (dr, dc) in pts:
+            continue
