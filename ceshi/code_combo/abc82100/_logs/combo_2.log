+
+def _component_anchor(component: np.ndarray) -> tuple[int, int]:
+    cells = sorted((int(r), int(c)) for r, c in component)
+    return cells[0]
+
+
+def _component_set(component: np.ndarray) -> set[tuple[int, int]]:
+    return {(int(r), int(c)) for r, c in component}
