   401	def main(grid: np.ndarray) -> np.ndarray:
   402	    """
   403	    Learn local block-to-stencil rules, then apply them to matching source blobs.
   404	
   405	    Input structure:
   406	    - Black background with teal (8) stencil components, gray (5) support
   407	      markers, multi-pixel same-color source blocks, and local legend blocks.
   408	    - A rule example is a source block whose top-left cell touches a target
   409	      pixel, with the same direction continuing to an anchor that touches the
   410	      teal stencil. The source block anchor's non-background 4-neighbor count is
   411	      part of the rule.
   412	
   413	    Rule:
   414	    - For each learned legend, find every non-legend 4-connected component of
   415	      the same source color whose top-left cell has the same non-background
   416	      4-neighbor count as the legend source cell.
   417	    - Copy that legend's teal stencil once per matching block, aligning the
   418	      legend anchor with the block's top-left cell, and recolor the copied
   419	      stencil to the legend target color.
   420	    - Remove the legend blocks, legend/support markers, teal stencils, and all
   421	      source blocks after stamping.
   422	
   423	    Key insight: The decisive object is not an isolated pixel anymore but a
   424	    whole colored blob. Its top-left cell simultaneously provides the geometric
   425	    placement anchor and the local context count that disambiguates same-color
   426	    rules.
   427	    """
   428	    g = np.asarray(grid, dtype=int)
   429	    bg = get_bg(g)
   430	    h, w = g.shape
   431	
   432	    rules = _discover_rules(g, bg=bg)
   433	    legend_cells: set[tuple[int, int]] = set()
   434	    consumed_support: set[tuple[int, int]] = set()
   435	    source_colors: set[int] = set()
   436	    rule_by_key: dict[tuple[int, int], dict] = {}
   437	
   438	    for rule in rules:
   439	        source_color = int(rule["source_color"])
   440	        source_pos = rule["source_pos"]
   441	        target_pos = rule["target_pos"]
   442	        source_colors.add(source_color)
   443	        rule_by_key[(source_color, int(rule["neighbor_count"]))] = rule
   444	
   445	        component = _component_containing(g, source_color, source_pos)
   446	        if component is not None:
   447	            component_cells = _component_set(component)
   448	            legend_cells.update(component_cells)
   449	        else:
   450	            component_cells = {source_pos}
   451	            legend_cells.add(source_pos)
   452	        legend_cells.add(target_pos)
   453	
   454	        for nr, nc in _non_bg_neighbors4(g, source_pos[0], source_pos[1], int(bg)):
   455	            if (nr, nc) == target_pos or (nr, nc) in component_cells:
   456	                continue
   457	            consumed_support.add((int(nr), int(nc)))
   458	
   459	    matched_blocks: list[tuple[dict, tuple[int, int]]] = []
   460	    for source_color in source_colors:
   461	        for component in _source_components(g, int(source_color), legend_cells):
   462	            component_cells = _component_set(component)
   463	            sr, sc = _component_anchor(component)
   464	            count = _count_non_bg4(g, sr, sc, int(bg))
   465	            rule = rule_by_key.get((int(source_color), int(count)))
   466	            if rule is None:
   467	                continue
   468	            matched_blocks.append((rule, (int(sr), int(sc))))
   469	            for nr, nc in _non_bg_neighbors4(g, sr, sc, int(bg)):
   470	                if (nr, nc) in component_cells:
   471	                    continue
   472	                consumed_support.add((int(nr), int(nc)))
   473	
   474	    out = np.full_like(g, int(bg))
   475	    for r, c in map(tuple, np.argwhere((g != int(bg)) & (g != PATTERN_COLOR))):
   476	        r = int(r)
   477	        c = int(c)
   478	        color = int(g[r, c])
   479	        if (r, c) in legend_cells or (r, c) in consumed_support:
   480	            continue
   481	        if color in source_colors or color == MARKER_COLOR:
   482	            continue
   483	        out[r, c] = color
   484	
   485	    for rule, (sr, sc) in matched_blocks:
   486	        ar, ac = rule["anchor"]
   487	        pattern = rule["pattern"]
   488	        dr = sr - ar
   489	        dc = sc - ac
   490	        rows = pattern[:, 0] + dr
   491	        cols = pattern[:, 1] + dc
   492	        ok = (0 <= rows) & (rows < h) & (0 <= cols) & (cols < w)
   493	        out[rows[ok], cols[ok]] = int(rule["target_color"])
   494	
   495	    return out
