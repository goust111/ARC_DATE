   370	    for rule in rules:
   371	        component = _component_containing(g, int(rule["source_color"]), rule["source_pos"])
   372	        if component is not None:
   373	            legend_cells.update(_component_set(component))
   374	        legend_cells.add(rule["target_pos"])
   375	        source_colors.add(int(rule["source_color"]))
