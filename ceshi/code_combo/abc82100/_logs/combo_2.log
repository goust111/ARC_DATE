   180	def _normalize_shape(cells) -> list[tuple[int, int]]:
   181	    pts = [(int(r), int(c)) for r, c in cells]
   182	    r0 = min(r for r, _ in pts)
   183	    c0 = min(c for _, c in pts)
   184	    return sorted((r - r0, c - c0) for r, c in pts)
