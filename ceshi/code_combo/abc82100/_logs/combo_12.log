+    occupied: set[tuple[int, int]] = set()
+    reserved: set[tuple[int, int]] = set()
+    output_occupied: set[tuple[int, int]] = set()
+    inp = np.zeros((height, width), dtype=int)
+
+    bounds = _place_scattered(rules, inp, occupied, reserved, output_occupied)
