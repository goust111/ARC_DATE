+            break
+    return placed
+
+
+def _place_legends(rules, inp, occupied, reserved, output_occupied):
+    height, width = inp.shape
+    for rule in rules:
+        rel = rule["rel"]
+        placed = False
+        for _ in range(LEGEND_RETRIES):
+            dr, dc = random.choice(_DIRS4)
