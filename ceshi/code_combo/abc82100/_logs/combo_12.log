            scale = _diagonal_scale_head(g, sr, sc, rule["source_color"])
            if scale <= 0:
                continue
            for rr, cc in _scaled_pattern_cells(rel_pattern, (sr, sc), scale):
                if 0 <= rr < h and 0 <= cc < w:
                    out[rr, cc] = rule["target_color"]

