GRID_DIM_MAX = 20
MIN_DIM_BY_RULES = {1: 8, 2: 12, 3: 15, 4: 18}

RULE_COUNT_WEIGHTS = [1, 1, 2, 2, 3, 3, 4]
NON_BG_NON_TEAL_COLORS = [1, 2, 3, 4, 5, 6, 7, 9]

PROTOTYPE_MIN_CELLS = 2
PROTOTYPE_MAX_CELLS = 5
PROTOTYPE_MAX_SPAN = 3

SCALE_CHOICES = [1, 2, 3]
SCATTERED_MIN = 3
