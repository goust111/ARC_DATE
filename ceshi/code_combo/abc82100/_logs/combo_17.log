+def _stamp_cells(base_r: int, base_c: int, rel, H: int, W: int) -> set[tuple[int, int]]:
+    cells = set()
+    for rr, cc in rel:
+        nr = int(base_r + rr)
+        nc = int(base_c + cc)
+        if 0 <= nr < H and 0 <= nc < W:
+            cells.add((nr, nc))
+    return cells
