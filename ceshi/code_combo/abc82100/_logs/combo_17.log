+def _gen_attempt():
+    num_rules = random.choice(RULE_COUNT_WEIGHTS)
+    H = random.randint(MIN_DIM_BY_RULES[num_rules], GRID_DIM_MAX)
+    W = random.randint(MIN_DIM_BY_RULES[num_rules], GRID_DIM_MAX)
