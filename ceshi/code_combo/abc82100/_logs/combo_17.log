   179	    source_colors: set[int] = set()
   180	    for rule in rules:
   181	        legend_pixels.add(tuple(map(int, rule["source_pos"])))
   182	        legend_pixels.add(tuple(map(int, rule["target_pos"])))
   183	        source_colors.add(int(rule["source_color"]))
   184	
   185	    out = np.full_like(g, int(bg))
   186	
   187	    for r, c in map(tuple, np.argwhere((g != int(bg)) & (g != pattern_color))):
   188	        cell = (int(r), int(c))
   189	        color = int(g[cell])
   190	        if cell in legend_pixels or color in source_colors:
   191	            continue
   192	        out[cell] = color
   193	
