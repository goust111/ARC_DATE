+            for r, c in template_list:
+                inp[int(r), int(c)] = 8
+            for rule in rules:
+                sr, sc = rule["source_pos"]
+                tr, tc = rule["target_pos"]
+                inp[int(sr), int(sc)] = int(rule["src"])
+                inp[int(tr), int(tc)] = int(rule["tgt"])
