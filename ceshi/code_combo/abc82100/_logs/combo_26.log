+SOURCE_BLOCK_MIN = 3
+SOURCE_BLOCK_MAX_CAP = 6
+SOURCE_BLOCK_AREA_DIV = 45
+BYSTANDER_MAX = 4
+
+SCATTERED_RETRIES_PER_OBJECT = 100
+BYSTANDER_RETRIES = 100
+OUTER_RETRIES = 500
