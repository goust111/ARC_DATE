            (r, right["c0"] - 1) for r in range(fr["r0"], fr["r1"] + 1)
        }
        rules.append(
            {
                "source_color": source_color,
                "target_color": target_color,
                "rel": rel,
                "legend_cells": legend_cells,
            }
        )

    return rules


