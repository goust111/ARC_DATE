+            out[int(r), int(c)] = int(group["tgt"])
+    return out
+
+
+def _has_reused_source(groups: list[dict]) -> bool:
+    counts: dict[int, int] = {}
+    for group in groups:
+        counts[int(group["src"])] = counts.get(int(group["src"]), 0) + 1
+    return max(counts.values(), default=0) >= 2
