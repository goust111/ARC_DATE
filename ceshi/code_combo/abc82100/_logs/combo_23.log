                continue
            for third in rules:
                if third is first or third is second:
                    continue
                if third["source_color"] != second["target_color"]:
                    continue
                if third["target_color"] != first["source_color"]:
                    continue
                colors = {
                    int(first["source_color"]),
                    int(second["source_color"]),
                    int(third["source_color"]),
