+def _gen_attempt():
+    num_rules = random.choice(RULE_COUNT_WEIGHTS)
+    min_dim = MIN_DIM_BY_RULES[num_rules]
+    H = random.randint(min_dim, GRID_DIM_MAX)
+    W = random.randint(min_dim, GRID_DIM_MAX)
