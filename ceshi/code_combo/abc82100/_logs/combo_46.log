+    marks the stencil's own top-left teal pixel, and copied shapes use that same corner pixel as
+    the placement reference on every scattered source.
+    """
+    g = np.asarray(grid, dtype=int)
+    bg = get_bg(g)
+    pattern_color = 8
+    h, w = g.shape
