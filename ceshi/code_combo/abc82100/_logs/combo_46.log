+# --------------- generator (c) ---------------
+
+# Grid dimensions
+GRID_DIM_MAX = 20
+MIN_DIM_BY_RULES = {1: 5, 2: 10, 3: 14, 4: 18}
+
+# Rule sampling
+RULE_COUNT_WEIGHTS = [1, 1, 2, 2, 3, 3, 4]
+NON_BG_NON_TEAL_COLORS = [1, 2, 3, 4, 5, 6, 7, 9]
