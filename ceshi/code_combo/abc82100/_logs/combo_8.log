            dr = cr - ar
            dc = cc - ac
            rows = pattern[:, 0] + dr
            cols = pattern[:, 1] + dc
            ok = (
                (0 <= rows)
                & (rows < h)
                & (0 <= cols)
                & (cols < w)
                & (r0 <= rows)
                & (rows <= r1)
                & (c0 <= cols)
                & (cols <= c1)
