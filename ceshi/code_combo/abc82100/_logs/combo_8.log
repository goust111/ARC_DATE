+                scratch,
+                rule["src"],
+                bg=0,
+                legend_pixels=set(),
+                height=rule["height"],
+                width=rule["width"],
+            )
+            expected = {tuple(rec["bbox"]) for rec in temp_records}
+            actual = {tuple(rec["bbox"]) for rec in recovered}
+            if actual != expected:
+                continue
+
+            placed_records = temp_records
+            occupied.update(temp_occupied)
+            reserved.update(temp_reserved)
+            success = True
