   234	                        "target_color": int(target_color),
   235	                        "source_pos": (int(r), int(c)),
   236	                        "target_pos": (int(tr), int(tc)),
   237	                        "anchor": (int(anchor[0]), int(anchor[1])),
   238	                        "pattern": np.asarray(pattern, dtype=int),
   239	                        "height": int(meta["height"]),
   240	                        "width": int(meta["width"]),
   241	                    }
