    return (abs(int(a[0]) - int(b[0])) + 1) * (abs(int(a[1]) - int(b[1])) + 1)


def _bbox_of_pair(a: tuple[int, int], b: tuple[int, int]) -> tuple[int, int, int, int]:
    return (
        min(int(a[0]), int(b[0])),
        min(int(a[1]), int(b[1])),
        max(int(a[0]), int(b[0])),
        max(int(a[1]), int(b[1])),
    )


