   168	def _box_cells(r0: int, c0: int, r1: int, c1: int, h: int, w: int, pad: int = 0) -> set[tuple[int, int]]:
   169	    rr0 = max(0, int(r0) - int(pad))
   170	    cc0 = max(0, int(c0) - int(pad))
   171	    rr1 = min(int(h) - 1, int(r1) + int(pad))
