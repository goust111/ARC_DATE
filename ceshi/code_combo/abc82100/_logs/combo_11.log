+                sc = random.randint(0, w - 1)
+                center = (int(sr), int(sc))
+                src_arm = (int(sr + forward[0]), int(sc + forward[1]))
+                tgt_arm = (int(sr + side[0]), int(sc + side[1]))
+                cells = {center, src_arm, tgt_arm}
