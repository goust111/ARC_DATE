+    for src_c in source_colors:
+        tgt_choices = [c for c in PAIR_COLORS if c != src_c]
+        tgt_c = random.choice(tgt_choices)
+        used.update((int(src_c), int(tgt_c)))
+        local_pattern, touch_rel = _make_stencil(min_s, max_s)
+        rules.append(
