+def _place_legends(
+    rules: list[dict],
+    inp: np.ndarray,
+    occupied: set[tuple[int, int]],
+    reserved: set[tuple[int, int]],
+) -> bool:
+    h, w = inp.shape
+    for rule in rules:
+        placed = False
+        for _ in range(LEGEND_RETRIES):
+            dr, dc = random.choice(_DIRS4)
+            sr = random.randint(0, h - 1)
+            sc = random.randint(0, w - 1)
+            tr = sr + dr
+            tc = sc + dc
+            pr = tr + dr
+            pc = tc + dc
+            if not (0 <= tr < h and 0 <= tc < w and 0 <= pr < h and 0 <= pc < w):
