+                    continue
+                if stamp & future_output:
+                    continue
+                if stamp & occupied:
+                    continue
+
+                inp[center] = int(rule["src"])
+                inp[src_arm] = int(rule["src"])
+                inp[tgt_arm] = int(rule["tgt"])
+                occupied.update(cells)
+                _reserve_neighbors(reserved, cells)
+                future_output.update(stamp)
