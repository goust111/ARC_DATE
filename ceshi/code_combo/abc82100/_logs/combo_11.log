+
+
+def _seed_variants(n_sc: int) -> list[tuple[tuple[int, int], bool]]:
+    dirs = _DIRS4[:]
+    random.shuffle(dirs)
+    variants = [(dirs[0], False), (dirs[1], True)]
+    pool = [(d, f) for d in _DIRS4 for f in (False, True)]
+    random.shuffle(pool)
+    for item in pool:
+        if item not in variants:
+            variants.append(item)
+        if len(variants) >= n_sc:
