+
+
+def _build_output(rules: list[dict], bystanders: list[tuple[int, int, int]], h: int, w: int) -> np.ndarray:
+    out = np.zeros((h, w), dtype=int)
+    for r, c, color in bystanders:
+        out[int(r), int(c)] = int(color)
