+            forward = (-int(dr), -int(dc))
+            probe_offset = _local_offset(rule["touch_rel"], forward, False)
+            marker = (int(pr) - int(probe_offset[0]), int(pc) - int(probe_offset[1]))
+            mr = int(marker[0])
+            mc = int(marker[1])
