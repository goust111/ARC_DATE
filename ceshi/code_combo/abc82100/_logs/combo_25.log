   526	            occupied.update(all_cells)
   527	            _reserve_4neighbors(reserved, all_cells)
   528	            placed = True
   529	            break
   530	        if not placed:
   531	            return False
   532	    return True
   533	
   534	
   535	def _place_scattered(
   536	    rules: list[dict],
   537	    inp: np.ndarray,
   538	    occupied: set[tuple[int, int]],
   539	    reserved: set[tuple[int, int]],
   540	    future_output: set[tuple[int, int]],
   541	    legend_teal: set[tuple[int, int]],
   542	) -> bool:
   543	    h, w = inp.shape
   544	    for rule in rules:
   545	        seeds: list[dict] = []
   546	        for forward, flip in _seed_variants(int(rule["n_sc"])):
   547	            side = _right(forward) if flip else _left(forward)
   548	            placed = False
   549	            for _ in range(SCATTERED_RETRIES_PER_SEED):
   550	                sr = random.randint(0, h - 1)
   551	                sc = random.randint(0, w - 1)
   552	                center = (int(sr), int(sc))
   553	                src_arm = (int(sr + forward[0]), int(sc + forward[1]))
   554	                tgt_arm = (int(sr + side[0]), int(sc + side[1]))
   555	                cells = {center, src_arm, tgt_arm}
   556	                if any(not (0 <= r < h and 0 <= c < w) for r, c in cells):
   557	                    continue
   558	                if cells & (occupied | reserved):
   559	                    continue
   560	                false_anchor = (int(sr + 2 * side[0]), int(sc + 2 * side[1]))
   561	                if min(_chebyshev(cell, false_anchor) for cell in legend_teal) <= 1:
   562	                    continue
   563	
   564	                stamp = {
   565	                    tuple(cell)
   566	                    for cell in _stamp_pattern(
   567	                        rule["local_pattern"],
   568	                        anchor=center,
   569	                        forward=forward,
   570	                        flip=flip,
   571	                        extra_rot=int(rule["extra_rot"]),
   572	                    )
   573	                }
   574	                if any(not (0 <= r < h and 0 <= c < w) for r, c in stamp):
   575	                    continue
