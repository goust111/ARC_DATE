spec.loader.exec_module(mod)

for trial in range(500):
    inp = mod.generate_input()
    bg = mod.get_bg(inp)
    rules = mod._discover_rules(inp, bg=bg, pattern_color=8)
    legend_pixels = set()
    for rule in rules:
        legend_pixels.add(rule['source_pos'])
        legend_pixels.add(rule['target_pos'])
    bad = []
    for idx, rule in enumerate(rules):
        seeds = mod._find_rule_seeds(inp, rule=rule, legend_pixels=legend_pixels, bg=bg)
        if not seeds:
            bad.append((idx, rule))
    if bad:
        print('trial', trial, 'shape', inp.shape, 'rules', len(rules), 'bad', len(bad))
        print(inp)
        for idx, rule in bad:
            print('bad_rule', idx, {k: v for k, v in rule.items() if k "'!= '"'local_pattern'})
        break
else:
    print('no bad sample found')
