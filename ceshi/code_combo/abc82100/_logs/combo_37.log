+            if not ok:
+                continue
+
+            for rule in concrete_rules:
+                sr, sc = rule["source_pos"]
+                tr, tc = rule["target_pos"]
+                inp[sr, sc] = int(rule["src"])
+                inp[tr, tc] = int(rule["tgt"])
+                for r, c in rule["pattern_cells"]:
+                    inp[r, c] = 8
