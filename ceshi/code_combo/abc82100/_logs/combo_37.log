+SCATTER_PAIR_RETRIES = 120
+BYSTANDER_RETRIES = 80
+OUTER_RETRIES = 400
+
+# Output cleanliness
+MAX_LOCAL_FOOTPRINT_OVERLAP = 2
+BYSTANDER_MAX = 2
