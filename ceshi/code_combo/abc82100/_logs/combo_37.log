   512	        inner_rule["target_pos"],
   513	    }
   514	
   515	    def valid_empty_cell(cell: tuple[int, int]) -> bool:
   516	        r, c = cell
   517	        if inp[r, c] != 0:
   518	            return False
   519	        return not any(nbr in colored_legend_cells for nbr in _neighbors4(cell))
