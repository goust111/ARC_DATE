+    for r in range(size):
+        for c in range(size):
+            if r in (0, size - 1) or c in (0, size - 1):
+                cells.add((r, c))
+    return cells
+
+
+def _legend_triplet(size: int, side: str) -> tuple[tuple[int, int], tuple[int, int], tuple[int, int]]:
