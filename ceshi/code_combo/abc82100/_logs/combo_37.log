+        rules_for_color,
+        key=lambda rule: (
+            -int(rule["depth"]),
+            _bbox_area(rule["bbox"]),
+            int(rule["bbox"][0]),
+            int(rule["bbox"][1]),
+            int(rule["target_color"]),
