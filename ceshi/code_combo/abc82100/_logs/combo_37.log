+    if side == "top":
+        return (0, k), (0, k + 1), (0, k + 2)
+    if side == "bottom":
+        return (size - 1, k), (size - 1, k + 1), (size - 1, k + 2)
+    if side == "left":
+        return (k, 0), (k + 1, 0), (k + 2, 0)
+    if side == "right":
+        return (k, size - 1), (k + 1, size - 1), (k + 2, size - 1)
