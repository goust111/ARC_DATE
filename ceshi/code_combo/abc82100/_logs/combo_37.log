+        key=lambda rule: (
+            _chebyshev((sr, sc), rule["source_pos"]),
+            _chebyshev((sr, sc), rule["anchor"]),
+            int(rule["source_pos"][0]),
+            int(rule["source_pos"][1]),
+            int(rule["target_color"]),
+            len(rule["pattern"]),
+        ),
+    )
