+        pool,
+        key=lambda rule: (
+            -int(rule["depth"]),
+            _bbox_area(rule["bbox"]),
+            int(rule["bbox"][0]),
+            int(rule["bbox"][1]),
+            int(rule["target_color"]),
+        ),
+    )
+
+
+def _choose_deepest_rule(rules_for_color: list[dict], _source_pos: tuple[int, int]) -> dict:
