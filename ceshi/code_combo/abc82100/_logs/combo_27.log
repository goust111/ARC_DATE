            (sr, sc),
            (sr + forward[0], sc + forward[1]),
            (sr + side[0], sc + side[1]),
        }
        if cells & legend_pixels or cells & consumed:
            continue

        seeds.append(
            {
                "center": (sr, sc),
                "forward": forward,
                "flip": bool(flip),
                "cells": cells,
            }
        )
