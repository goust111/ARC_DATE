+        if num_rules > 1 and stats["mirrored_objects"] <= 0:
+            return None
+
+        if np.array_equal(main(inp), output):
+            return inp
+    except Exception:
+        return None
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(OUTER_RETRIES):
+        result = _gen_attempt()
+        if result is not None:
+            return result
