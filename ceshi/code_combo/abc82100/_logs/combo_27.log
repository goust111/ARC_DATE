   741	        for obj in rule["objects"]:
   742	            stamp = _placed_cells_for_object(rule, marker=obj["marker"], marker_dir=obj["marker_dir"])
   743	            out[stamp[:, 0], stamp[:, 1]] = int(rule["tgt"])
