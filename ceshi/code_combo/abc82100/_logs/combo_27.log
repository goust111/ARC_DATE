   706	def _place_bystanders(
   707	    used_colors: set[int],
   708	    inp: np.ndarray,
   709	    occupied: set[tuple[int, int]],
   710	    reserved: set[tuple[int, int]],
   711	    future_output: set[tuple[int, int]],
   712	) -> list[tuple[int, int, int]]:
   713	    bystander_colors = [c for c in NON_BG_NON_TEAL_COLORS if c not in used_colors]
   714	    if not bystander_colors:
   715	        return []
   716	
   717	    h, w = inp.shape
   718	    placed: list[tuple[int, int, int]] = []
   719	    n = random.randint(0, min(BYSTANDER_MAX, len(bystander_colors) * 2))
   720	    for _ in range(n):
   721	        for _ in range(BYSTANDER_RETRIES):
   722	            r = random.randint(0, h - 1)
   723	            c = random.randint(0, w - 1)
   724	            if (r, c) in occupied or (r, c) in reserved or (r, c) in future_output:
   725	                continue
   726	            color = random.choice(bystander_colors)
   727	            inp[r, c] = int(color)
   728	            placed.append((int(r), int(c), int(color)))
   729	            occupied.add((int(r), int(c)))
   730	            _reserve_4neighbors(reserved, {(int(r), int(c))})
   731	            break
   732	    return placed
