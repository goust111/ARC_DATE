   401	def main(grid: np.ndarray) -> np.ndarray:
   402	    """
   403	    Learn legend stencils, then stamp transformed copies using both marker direction and legend direction.
   404	
   405	    Input structure:
   406	    - Black background with teal (8) legend stencils, local source->target examples,
   407	      and scattered 2-cell source objects made of a source-colored pixel plus one
   408	      adjacent fixed marker pixel.
   409	    - Each legend is a 4-neighbor source/target pair whose continued direction
   410	      reaches an anchor touching a teal stencil component.
   411	    - The marker side on each scattered source gives a base orientation, while the
   412	      legend pair direction supplies an additional transform code.
   413	
   414	    Rule:
   415	    - For each legend, learn the source color, target color, and the nearby teal
   416	      stencil in a local coordinate frame tied to the legend line.
   417	    - For every non-legend source object of that color, place the stencil with its
   418	      anchor on the marker cell. Start from the marker direction as the base axis,
   419	      rotate that axis according to the legend pair direction, and mirror the
   420	      stencil for the two legend directions that encode the reflected cases.
   421	    - Recolor the placed stencil to the legend target color, and erase legends,
   422	      teal pixels, source pixels, and marker pixels.
   423	
   424	    Key insight: Solving the puzzle now needs a three-way fusion: the legend still
   425	    teaches the color mapping and canonical stencil, the side marker tells you the
   426	    base facing of each scattered source, and the legend pair orientation modifies
   427	    that facing into the final rotated or mirrored stencil copy.
   428	    """
   429	    g = np.asarray(grid, dtype=int)
   430	    bg = get_bg(g)
   431	    h, w = g.shape
   432	
   433	    rules = _discover_rules(g, bg=bg, pattern_color=PATTERN_COLOR, marker_color=MARKER_COLOR)
   434	    legend_pixels: set[tuple[int, int]] = set()
   435	    source_colors: set[int] = set()
   436	    for rule in rules:
   437	        legend_pixels.add(tuple(rule["source_pos"]))
   438	        legend_pixels.add(tuple(rule["target_pos"]))
   439	        source_colors.add(int(rule["source_color"]))
   440	
   441	    objects_by_rule: list[list[dict]] = []
   442	    object_pixels: set[tuple[int, int]] = set()
   443	    for rule in rules:
   444	        objects = _find_scattered_objects(
   445	            g,
   446	            source_color=int(rule["source_color"]),
   447	            legend_pixels=legend_pixels,
   448	            bg=bg,
   449	            marker_color=MARKER_COLOR,
   450	        )
   451	        objects_by_rule.append(objects)
   452	        for obj in objects:
   453	            object_pixels.update(obj["cells"])
   454	
   455	    out = np.full_like(g, int(bg))
   456	
   457	    for r, c in map(tuple, np.argwhere((g != int(bg)) & (g != PATTERN_COLOR))):
   458	        r = int(r)
   459	        c = int(c)
   460	        color = int(g[r, c])
   461	        if color == int(MARKER_COLOR):
   462	            continue
   463	        if (r, c) in legend_pixels or (r, c) in object_pixels or color in source_colors:
   464	            continue
   465	        out[r, c] = color
   466	
   467	    for rule, objects in zip(rules, objects_by_rule):
   468	        for obj in objects:
   469	            placed = _placed_cells_for_object(rule, marker=obj["marker"], marker_dir=obj["marker_dir"])
   470	            rows = placed[:, 0]
   471	            cols = placed[:, 1]
   472	            ok = (0 <= rows) & (rows < h) & (0 <= cols) & (cols < w)
   473	            out[rows[ok], cols[ok]] = int(rule["target_color"])
   474	
   475	    return out
   476	
