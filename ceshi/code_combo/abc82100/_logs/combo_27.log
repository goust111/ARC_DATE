   653	def _place_scattered(
   654	    rules: list[dict],
   655	    inp: np.ndarray,
   656	    occupied: set[tuple[int, int]],
   657	    reserved: set[tuple[int, int]],
   658	    future_output: set[tuple[int, int]],
   659	) -> bool:
   660	    h, w = inp.shape
   661	    for rule in rules:
   662	        objects: list[dict] = []
   663	        for marker_dir in _marker_plan(int(rule["n_sc"])):
   664	            placed = False
   665	            for _ in range(SCATTERED_RETRIES_PER_OBJECT):
   666	                sr = random.randint(0, h - 1)
   667	                sc = random.randint(0, w - 1)
   668	                source = (int(sr), int(sc))
   669	                marker = (int(sr + marker_dir[0]), int(sc + marker_dir[1]))
   670	                cells = {source, marker}
   671	                if any(not (0 <= r < h and 0 <= c < w) for r, c in cells):
   672	                    continue
   673	                if cells & (occupied | reserved):
   674	                    continue
   675	
   676	                stamp = _object_stamp_cells(rule, source=source, marker_dir=marker_dir)
   677	                if any(not (0 <= r < h and 0 <= c < w) for r, c in stamp):
   678	                    continue
   679	                if stamp & future_output:
   680	                    continue
   681	                if stamp & occupied:
   682	                    continue
   683	
   684	                inp[source] = int(rule["src"])
   685	                inp[marker] = MARKER_COLOR
   686	                occupied.update(cells)
   687	                _reserve_4neighbors(reserved, cells)
   688	                future_output.update(stamp)
   689	                objects.append(
   690	                    {
   691	                        "source": source,
   692	                        "marker": marker,
   693	                        "marker_dir": marker_dir,
   694	                    }
   695	                )
   696	                placed = True
   697	                break
   698	            if not placed:
   699	                return False
   700	        if len(objects) < SCATTERED_MIN:
   701	            return False
   702	        rule["objects"] = objects
