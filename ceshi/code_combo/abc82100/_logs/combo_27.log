   615	def _place_legends(
   616	    rules: list[dict],
   617	    inp: np.ndarray,
   618	    occupied: set[tuple[int, int]],
   619	    reserved: set[tuple[int, int]],
   620	) -> bool:
   621	    h, w = inp.shape
   622	    for rule in rules:
   623	        dr, dc = int(rule["pair_step"][0]), int(rule["pair_step"][1])
   624	        placed = False
   625	        for _ in range(LEGEND_RETRIES):
   626	            sr = random.randint(0, h - 1)
   627	            sc = random.randint(0, w - 1)
   628	            tr, tc = sr + dr, sc + dc
   629	            ar, ac = sr + 2 * dr, sc + 2 * dc
   630	            if not (0 <= tr < h and 0 <= tc < w and 0 <= ar < h and 0 <= ac < w):
   631	                continue
   632	
   633	            teal_cells = _legend_teal_cells(rule, anchor=(ar, ac))
   634	            all_cells = {(int(sr), int(sc)), (int(tr), int(tc))} | teal_cells
   635	            if any(not (0 <= r < h and 0 <= c < w) for r, c in all_cells):
   636	                continue
   637	            if all_cells & (occupied | reserved):
   638	                continue
   639	
   640	            inp[sr, sc] = int(rule["src"])
   641	            inp[tr, tc] = int(rule["tgt"])
   642	            for r, c in teal_cells:
   643	                inp[r, c] = PATTERN_COLOR
   644	            occupied.update(all_cells)
   645	            _reserve_4neighbors(reserved, all_cells)
   646	            placed = True
   647	            break
   648	        if not placed:
   649	            return False
   650	    return True
