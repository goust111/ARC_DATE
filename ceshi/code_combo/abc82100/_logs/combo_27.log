+    pool = [0, 1, 2, 3]
+    random.shuffle(pool)
+    chosen = [random.choice([0, 1]), random.choice([2, 3])]
+    for rot in pool:
+        if rot not in chosen:
+            chosen.append(rot)
+        if len(chosen) >= num_rules:
