   563	def _build_rules(num_rules: int, area: int) -> tuple[list[dict], set[int]]:
   564	    colors = NON_BG_NON_TEAL_COLORS[:]
   565	    random.shuffle(colors)
   566	
   567	    src_colors = colors[:num_rules]
   568	    tgt_pool = [c for c in colors if c not in src_colors]
   569	    max_s = min(STENCIL_MAX_CAP, max(4, area // STENCIL_MAX_AREA_DIV))
   570	    min_s = min(max(4, area // STENCIL_MIN_AREA_DIV), max_s)
   571	    sc_max = min(SCATTERED_MAX_CAP, max(SCATTERED_MIN, area // SCATTERED_AREA_DIV))
   572	    rotations = _choose_rotations(num_rules)
   573	
   574	    rules: list[dict] = []
   575	    used_colors: set[int] = {MARKER_COLOR}
   576	    for src_c, rot in zip(src_colors, rotations):
   577	        tgt_c = random.choice(tgt_pool)
   578	        local_pattern = _make_local_pattern(min_s, max_s)
   579	        rules.append(
   580	            {
   581	                "src": int(src_c),
   582	                "tgt": int(tgt_c),
   583	                "local_pattern": local_pattern,
   584	                "extra_turns": int(rot),
   585	                "flip": bool(rot >= 2),
   586	                "pair_step": _STEP_BY_ROT[int(rot)],
   587	                "n_sc": random.randint(SCATTERED_MIN, sc_max),
   588	            }
   589	        )
   590	        used_colors.update((int(src_c), int(tgt_c)))
   591	    return rules, used_colors
