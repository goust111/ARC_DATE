+                        "target_color": int(target_color),
+                        "source_pos": (int(r), int(c)),
+                        "target_pos": (int(tr), int(tc)),
+                        "anchor": (int(anchor[0]), int(anchor[1])),
+                        "center": center,
+                        "pattern": pattern_arr,
+                        "rel_center": [
+                            (int(pr - center[0]), int(pc - center[1])) for pr, pc in pattern_arr.tolist()
