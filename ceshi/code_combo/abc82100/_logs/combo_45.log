+                continue
+            near_stamp = _scaled_cells_from_rel(rule_near["rel_center"], (nr, nc), 1, h, w)
+
+            for fr, fc in far_cells:
+                if (fr, fc) in occupied or (fr, fc) in reserved:
+                    continue
+                if abs(int(fr) - int(nr)) + abs(int(fc) - int(nc)) <= 1:
+                    continue
+                if _band_name(h, w, fr, fc) != "far":
