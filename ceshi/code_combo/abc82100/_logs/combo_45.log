+    sr, sc = int(source[0]), int(source[1])
+    k = int(scale)
+    half = k // 2
+    cells: set[tuple[int, int]] = set()
+    for rr, cc in rel_coords:
+        base_r = sr + int(rr) * k
+        base_c = sc + int(cc) * k
+        for dr in range(-half, half + 1):
+            for dc in range(-half, half + 1):
