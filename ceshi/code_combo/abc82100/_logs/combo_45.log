+def _span_for_rel(rel_coords: list[tuple[int, int]], scale: int) -> tuple[int, int, int, int]:
+    k = int(scale)
+    half = k // 2
+    rows: list[int] = []
+    cols: list[int] = []
+    for rr, cc in rel_coords:
+        base_r = int(rr) * k
+        base_c = int(cc) * k
+        for dr in range(-half, half + 1):
+            for dc in range(-half, half + 1):
+                rows.append(base_r + dr)
+                cols.append(base_c + dc)
