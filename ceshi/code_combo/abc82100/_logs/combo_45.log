+                inp,
+                occupied,
+                reserved,
+                output_footprint,
+                used_distances,
+                required_band="near",
+                prefer_full=True,
+            ):
+                return False
+        if "far" not in rule["bands"]:
+            if not _place_source_instance(
+                rule,
+                inp,
+                occupied,
+                reserved,
+                output_footprint,
+                used_distances,
+                required_band="far",
+                prefer_full=False,
+            ):
+                return False
+
+    for idx, rule in enumerate(rules):
+        while len(rule["scattered"]) < SCATTERED_PER_RULE:
+            preferred_band = "far" if idx % 2 == 0 else "near"
+            if not _place_source_instance(
+                rule,
+                inp,
+                occupied,
+                reserved,
+                output_footprint,
+                used_distances,
+                required_band=preferred_band,
+                prefer_full=(preferred_band == "near"),
+            ):
+                other_band = "near" if preferred_band == "far" else "far"
+                if not _place_source_instance(
