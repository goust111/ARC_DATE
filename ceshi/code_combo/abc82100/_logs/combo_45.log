+def _build_output(
+    rules: list[dict],
+    bystander_pos: list[tuple[int, int, int]],
+    h: int,
+    w: int,
+    *,
+    rel_key: str,
+    scaled: bool,
+    reverse_order: bool,
+) -> np.ndarray:
