+def _normalize_coords(coords: set[tuple[int, int]]) -> list[tuple[int, int]]:
+    min_r = min(r for r, _ in coords)
+    min_c = min(c for _, c in coords)
+    return sorted((int(r - min_r), int(c - min_c)) for r, c in coords)
