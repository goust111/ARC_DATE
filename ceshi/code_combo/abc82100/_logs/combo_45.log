+
+def _discover_rules(grid: np.ndarray, bg: int, pattern_color: int = 8) -> list[dict]:
+    h, w = grid.shape
+    patterns = components_mask(grid == pattern_color, connectivity=8)
+    rules: list[dict] = []
+    seen: set[tuple[tuple[int, int], tuple[int, int], int]] = set()
+
+    for r in range(h):
