        rel = [(int(r - anchor[0]), int(c - anchor[1])) for r, c in stencil]
        rules.append(
            {
                "src": int(src_c),
                "tgt": int(tgt_c),
                "rel": rel,
                "bounds": _rel_bounds(rel),
                "n_sc": random.randint(SCATTERED_MIN, sc_max),
            }
        )
    return rules, used


