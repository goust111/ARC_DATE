    78	#      and all discovered legends should use the same span in {3,4}. Under those
    79	#      conditions, the original adjacent/global solver should usually disagree.
    80	
    81	PAIR_SPAN_OPTIONS = (3, 4)
    82	LOCAL_SOURCE_DISTS = {2, 3}
    83	
    84	# Grid dimensions
    85	GRID_DIM_MAX = 20
    86	MIN_DIM_BY_GROUPS = {2: 9, 3: 12, 4: 15, 5: 18}
    87	
