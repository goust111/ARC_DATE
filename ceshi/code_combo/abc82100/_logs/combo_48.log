+            group["legend_source"] = (sr, sc)
+            group["legend_target"] = (tr, tc)
+            group["anchor"] = (ar, ac)
+            group["exec"] = (er, ec)
+            group["stamp"] = stamp_cells
+            group["footprint"] = cluster_cells
+            if not _same_color_pairing_ok(group, placed_groups):
+                continue
+
+            inp[sr, sc] = group["src"]
+            inp[tr, tc] = group["tgt"]
+            inp[er, ec] = group["src"]
