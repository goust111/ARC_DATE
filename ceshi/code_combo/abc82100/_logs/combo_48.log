    94	STENCIL_MIN_AREA_DIV = 120
    95	STENCIL_MAX_AREA_DIV = 40
    96	
    97	# Bystanders
    98	BYSTANDER_MAX = 4
    99	
   100	# Retry budgets
   101	CLUSTER_RETRIES = 900
   102	BYSTANDER_RETRIES = 100
   103	OUTER_RETRIES = 500
   104	
   105	_DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
   106	_DIRS8 = [
   107	    (-1, -1),
   108	    (-1, 0),
   109	    (-1, 1),
   110	    (0, -1),
   111	    (0, 1),
   112	    (1, -1),
