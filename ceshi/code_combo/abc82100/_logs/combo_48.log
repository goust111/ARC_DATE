+
+    out = np.full_like(g, int(bg))
+
+    for r, c in map(tuple, np.argwhere((g != int(bg)) & (g != pattern_color))):
+        pos = (int(r), int(c))
+        if pos in legend_pixels or pos in execution_pixels:
+            continue
