+
+    for i, legend in enumerate(legends):
+        if i not in assignments:
+            continue
+        sr, sc = assignments[i]
+        ar, ac = legend["anchor"]
+        pattern = legend["pattern"]
+        dr = sr - ar
+        dc = sc - ac
+        rows = pattern[:, 0] + dr
+        cols = pattern[:, 1] + dc
+        ok = (0 <= rows) & (rows < h) & (0 <= cols) & (cols < w)
+        out[rows[ok], cols[ok]] = int(legend["target_color"])
+
