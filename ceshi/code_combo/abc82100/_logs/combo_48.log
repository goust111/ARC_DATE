   206	    candidates_by_span: dict[int, list[dict]] = {span: [] for span in PAIR_SPAN_OPTIONS}
   207	    seen_by_span: dict[int, set[tuple[tuple[int, int], tuple[int, int], int]]] = {
   208	        span: set() for span in PAIR_SPAN_OPTIONS
