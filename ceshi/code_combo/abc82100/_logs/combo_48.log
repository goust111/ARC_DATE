   140	
   141	
   142	def _chebyshev(a: tuple[int, int], b: tuple[int, int]) -> int:
   143	    return max(abs(int(a[0]) - int(b[0])), abs(int(a[1]) - int(b[1])))
   144	
   145	
   146	def _anchor_distance(pattern: np.ndarray, anchor: tuple[int, int]) -> int:
   147	    return min(_chebyshev((int(r), int(c)), anchor) for r, c in pattern)
   148	
   149	
