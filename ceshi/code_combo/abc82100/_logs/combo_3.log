+    rules, used_colors = _build_rules(num_rules, h * w)
+    slots = []
+    for row in rows:
+        slots.append({"axis": "row", "line": int(row)})
+    for col in cols:
+        slots.append({"axis": "col", "line": int(col)})
+    random.shuffle(slots)
