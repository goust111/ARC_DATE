   121	    r0 = max(0, int(rows.min()) - 1)
   122	    r1 = min(grid.shape[0] - 1, int(rows.max()) + 1)
   123	    c0 = max(0, int(cols.min()) - 1)
   124	    c1 = min(grid.shape[1] - 1, int(cols.max()) + 1)
   125	
   126	    ar, ac = anchor
   127	    template: list[tuple[int, int, int]] = []
   128	    template_cells: list[tuple[int, int]] = []
   129	    for r in range(r0, r1 + 1):
   130	        for c in range(c0, c1 + 1):
   131	            if (r, c) in excluded:
   132	                continue
   133	            color = int(grid[r, c])
   134	            if color == int(bg):
   135	                continue
   136	            if _anchor_distance(pattern, (r, c)) > 1:
   137	                continue
   138	            template.append((int(r - ar), int(c - ac), color))
   139	            template_cells.append((int(r), int(c)))
   140	
   141	    template.sort()
   142	    template_cells.sort()
   143	    return template, template_cells
