   115	    excluded: set[tuple[int, int]],
   116	    bg: int,
   117	) -> tuple[list[tuple[int, int, int]], list[tuple[int, int]]]:
   118	    """Collect all legend template cells inside the teal component halo."""
   119	    rows = pattern[:, 0]
