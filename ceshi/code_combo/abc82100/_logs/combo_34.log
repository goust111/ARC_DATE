+            inp[sr, sc] = rule["src"]
+            inp[tr, tc] = rule["tgt"]
+            for nr, nc in teal_cells:
+                inp[nr, nc] = PATTERN_COLOR
+            for nr, nc, color in accent_cells:
+                inp[nr, nc] = color
