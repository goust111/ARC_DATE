+    output = _build_output(rules, bystander_pos, h, w)
+    try:
+        if np.array_equal(main(inp), output):
+            return inp
+    except Exception:
+        pass
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(OUTER_RETRIES):
+        result = _gen_attempt()
+        if result is not None:
+            return result
