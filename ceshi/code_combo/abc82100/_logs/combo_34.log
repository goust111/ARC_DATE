   581	                continue
   582	
   583	            local: dict[tuple[int, int], dict[str, set[int]]] = defaultdict(
   584	                lambda: {"fixed": set(), "target": set()}
   585	            )
   586	            for row, col, kind, color in combined:
   587	                local[(int(row), int(col))][kind].add(int(color))
   588	            bucket = local[(int(overlap_r), int(overlap_c))]
   589	            if bucket["fixed"] and bucket["target"]:
