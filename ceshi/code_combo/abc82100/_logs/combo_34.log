   205	
   206	def _resolve_color_counter(counter: Counter[int]) -> int:
   207	    best = max(counter.values())
   208	    winners = [color for color, count in counter.items() if count == best]
   209	    return int(min(winners))
   210	
   211	
   212	def _resolve_bucket(bucket: dict[str, Counter[int]], bg: int) -> int:
   213	    fixed_counter = bucket["fixed"]
   214	    if fixed_counter:
   215	        return _resolve_color_counter(fixed_counter)
   216	    target_counter = bucket["target"]
   217	    if target_counter:
   218	        return _resolve_color_counter(target_counter)
   219	    return int(bg)
   220	
   221	
   222	def _record_claim(
   223	    claims: dict[tuple[int, int], dict[str, Counter[int]]],
   224	    row: int,
   225	    col: int,
   226	    kind: str,
   227	    color: int,
   228	) -> None:
   229	    claims[(int(row), int(col))][kind][int(color)] += 1
