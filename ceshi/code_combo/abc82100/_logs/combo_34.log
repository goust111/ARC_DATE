+    for _ in range(n - 1):
+        frontier = set()
+        for r, c in coords:
+            for dr, dc in _DIRS8:
+                p = (r + dr, c + dc)
+                if p not in coords:
+                    frontier.add(p)
+        coords.add(random.choice(list(frontier)))
