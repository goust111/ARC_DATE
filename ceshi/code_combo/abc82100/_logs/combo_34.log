   145	
   146	def _discover_rules(grid: np.ndarray, bg: int, pattern_color: int = PATTERN_COLOR) -> list[dict]:
   147	    h, w = grid.shape
   148	    patterns = components_mask(grid == pattern_color, connectivity=8)
   149	    rules: list[dict] = []
   150	    seen: set[tuple[tuple[int, int], tuple[int, int], int]] = set()
   151	
   152	    for r in range(h):
   153	        for c in range(w):
   154	            source_color = int(grid[r, c])
   155	            if source_color in (int(bg), int(pattern_color)):
   156	                continue
   157	
   158	            for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
   159	                tr = r + dr
   160	                tc = c + dc
   161	                if not (0 <= tr < h and 0 <= tc < w):
   162	                    continue
   163	
   164	                target_color = int(grid[tr, tc])
   165	                if target_color in (int(bg), int(pattern_color)) or target_color == source_color:
   166	                    continue
   167	
   168	                anchor = (tr + dr, tc + dc)
   169	                candidates: list[tuple[int, int, np.ndarray]] = []
   170	                for i, pattern in enumerate(patterns):
   171	                    dist = _anchor_distance(pattern, anchor)
   172	                    if dist <= 1:
   173	                        candidates.append((int(dist), int(i), pattern))
   174	
   175	                if not candidates:
   176	                    continue
   177	
   178	                candidates.sort(key=lambda item: (item[0], len(item[2])))
   179	                _dist, pattern_index, pattern = candidates[0]
   180	                key = ((int(r), int(c)), (int(tr), int(tc)), int(pattern_index))
   181	                if key in seen:
   182	                    continue
   183	                seen.add(key)
   184	                template, template_cells = _extract_template(
   185	                    grid,
   186	                    pattern=pattern,
   187	                    anchor=anchor,
   188	                    excluded={(int(r), int(c)), (int(tr), int(tc))},
   189	                    bg=bg,
   190	                )
   191	                rules.append(
   192	                    {
   193	                        "source_color": int(source_color),
   194	                        "target_color": int(target_color),
   195	                        "source_pos": (int(r), int(c)),
   196	                        "target_pos": (int(tr), int(tc)),
   197	                        "anchor": (int(anchor[0]), int(anchor[1])),
   198	                        "template": template,
   199	                        "template_cells": template_cells,
   200	                    }
   201	                )
   202	
   203	    return rules
