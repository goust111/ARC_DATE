   507	                claims.append((nr, nc, "target", int(rule["tgt"])))
   508	            else:
   509	                claims.append((nr, nc, "fixed", int(color)))
   510	    return claims
   511	
   512	
   513	def _can_use_source(
   514	    pos: tuple[int, int],
   515	    occupied: set[tuple[int, int]],
   516	    reserved: set[tuple[int, int]],
   517	    pending: list[tuple[int, int]],
   518	) -> bool:
   519	    if pos in occupied or pos in reserved:
   520	        return False
   521	    if pos in pending:
   522	        return False
   523	    return all(_manhattan(pos, other) > 1 for other in pending)
   524	
   525	
   526	def _claims_compatible(claim_map, new_claims) -> bool:
   527	    scratch: dict[tuple[int, int], dict[str, set[int]]] = {}
   528	    for row, col, kind, color in new_claims:
   529	        cell = (int(row), int(col))
   530	        if cell not in scratch:
   531	            existing = claim_map.get(cell)
   532	            scratch[cell] = {
   533	                "fixed": set() if existing is None else set(existing["fixed"]),
   534	                "target": set() if existing is None else set(existing["target"]),
   535	            }
   536	        scratch[cell][kind].add(int(color))
   537	        if len(scratch[cell]["fixed"]) > 1 or len(scratch[cell]["target"]) > 1:
   538	            return False
   539	    return True
   540	
   541	
   542	def _commit_claims(claim_map, claims) -> None:
   543	    for row, col, kind, color in claims:
   544	        claim_map[(int(row), int(col))][kind].add(int(color))
   545	
   546	
   547	def _force_overlap_pair(rules, h, w, occupied, reserved, claim_map):
   548	    rule_order = list(range(len(rules)))
   549	    random.shuffle(rule_order)
   550	
   551	    # Prefer a same-rule overlap whose row-major source order makes overwrite
   552	    # semantics diverge from the fixed-over-target OR rule.
   553	    for i in rule_order:
   554	        rule = rules[i]
   555	        if not rule["accent_entries"] or not rule["teal_offsets"]:
   556	            continue
   557	        for _ in range(FORCED_OVERLAP_RETRIES):
   558	            arr, acc, accent_color = random.choice(rule["accent_entries"])
   559	            trr, tcc = random.choice(rule["teal_offsets"])
   560	            if int(accent_color) == int(rule["tgt"]):
   561	                continue
   562	            overlap_r = random.randint(0, h - 1)
   563	            overlap_c = random.randint(0, w - 1)
   564	            src_fixed = (int(overlap_r - arr), int(overlap_c - acc))
   565	            src_target = (int(overlap_r - trr), int(overlap_c - tcc))
   566	            if not (0 <= src_fixed[0] < h and 0 <= src_fixed[1] < w):
   567	                continue
   568	            if not (0 <= src_target[0] < h and 0 <= src_target[1] < w):
   569	                continue
   570	            if not (src_fixed < src_target):
   571	                continue
   572	            if not _can_use_source(src_fixed, occupied, reserved, []):
   573	                continue
   574	            if not _can_use_source(src_target, occupied, reserved, [src_fixed]):
   575	                continue
   576	
   577	            claims_fixed = _stamp_claims(rule, src_fixed, h, w)
   578	            claims_target = _stamp_claims(rule, src_target, h, w)
