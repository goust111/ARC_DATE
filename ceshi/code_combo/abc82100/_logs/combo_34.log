    99	def _chebyshev(a: tuple[int, int], b: tuple[int, int]) -> int:
   100	    return max(abs(int(a[0]) - int(b[0])), abs(int(a[1]) - int(b[1])))
   101	
   102	
   103	def _manhattan(a: tuple[int, int], b: tuple[int, int]) -> int:
   104	    return abs(int(a[0]) - int(b[0])) + abs(int(a[1]) - int(b[1]))
   105	
