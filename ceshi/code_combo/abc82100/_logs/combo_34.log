+                break
+        if not accents:
+            continue
+
+        ar, ac = anchor
+        template = [(int(r - ar), int(c - ac), PATTERN_COLOR) for r, c in teal_coords]
+        template.extend((int(r - ar), int(c - ac), int(color)) for r, c, color in accents)
