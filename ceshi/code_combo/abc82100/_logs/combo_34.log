   591	                    cell
   592	                    for cell, cell_bucket in local.items()
   593	                    if cell_bucket["fixed"] and cell_bucket["target"]
   594	                }
   595	                return [(i, src_fixed, claims_fixed), (i, src_target, claims_target)], protected
   596	
   597	    return None
   598	
   599	
   600	def _place_scattered(rules, inp, occupied, reserved):
   601	    h, w = inp.shape
   602	    claim_map: dict[tuple[int, int], dict[str, set[int]]] = defaultdict(
   603	        lambda: {"fixed": set(), "target": set()}
   604	    )
   605	
   606	    for rule in rules:
   607	        rule["scattered"] = []
