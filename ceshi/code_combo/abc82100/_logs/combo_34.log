+def _can_use_source(
+    pos: tuple[int, int],
+    occupied: set[tuple[int, int]],
+    reserved: set[tuple[int, int]],
+    pending: list[tuple[int, int]],
+) -> bool:
+    if pos in occupied or pos in reserved:
+        return False
+    if pos in pending:
+        return False
+    return all(_manhattan(pos, other) > 1 for other in pending)
