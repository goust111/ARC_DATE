            if any(not (0 <= r < H and 0 <= c < W) for r, c in all_template_cells):
                continue
            if any(_manhattan((r, c), (sr, sc)) == 1 or _manhattan((r, c), (tr, tc)) == 1 for r, c, _ in accent_cells):
