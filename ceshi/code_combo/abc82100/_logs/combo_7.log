+SCATTERED_MIN = 3
+SCATTERED_MAX_CAP = 8
+SCATTERED_AREA_DIV = 30
+
+BYSTANDER_MAX = 5
+
+LEGEND_RETRIES = 500
+SCATTERED_RETRIES_PER_PIXEL = 50
+BYSTANDER_RETRIES = 50
+OUTER_RETRIES = 400
