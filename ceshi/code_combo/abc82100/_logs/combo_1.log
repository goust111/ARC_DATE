+    try:
+        if np.array_equal(main(inp), expected):
+            return inp
+    except Exception:
+        pass
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(OUTER_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
