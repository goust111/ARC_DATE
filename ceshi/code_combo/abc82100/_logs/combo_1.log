            for r, c in _stamp_cells(rule, obj, h, w):
                out[int(r), int(c)] = int(rule["target"])

    return out


def _gen_attempt():
    num_rules = random.choice(RULE_COUNT_WEIGHTS)
    min_dim = MIN_DIM_BY_RULES[num_rules]
