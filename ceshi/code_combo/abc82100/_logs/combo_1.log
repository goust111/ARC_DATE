+    r1 = int(coords[:, 0].max())
+    c1 = int(coords[:, 1].max())
+    return {
+        "bbox": (r0, c0, r1, c1),
+        "rel": tuple(sorted((int(r - r0), int(c - c0)) for r, c in coords)),
+        "coord_set": {(int(r), int(c)) for r, c in coords},
+        "area": int(coords.shape[0]),
+    }
