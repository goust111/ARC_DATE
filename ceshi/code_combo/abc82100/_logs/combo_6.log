+def _expanded(cells: set[tuple[int, int]], radius: int = 1) -> set[tuple[int, int]]:
+    out = set(cells)
+    for r, c in list(cells):
+        for dr in range(-radius, radius + 1):
+            for dc in range(-radius, radius + 1):
