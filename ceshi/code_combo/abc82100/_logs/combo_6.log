+SCATTERED_MAX_CAP = 5
+SCATTERED_AREA_DIV = 55
+BYSTANDER_MAX = 4
+
+SCATTERED_RETRIES_PER_PIXEL = 80
+BYSTANDER_RETRIES = 80
+OUTER_RETRIES = 400
