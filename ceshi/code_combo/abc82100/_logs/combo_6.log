+_PATTERN_LIBRARY = _build_pattern_library()
+_NONTRIVIAL_PATTERNS = [rel for rel in _PATTERN_LIBRARY if len(rel) >= 2]
+_SINGLETON_PATTERN = ((0, 0),)
