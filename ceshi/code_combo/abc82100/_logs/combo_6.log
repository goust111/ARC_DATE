+def _is_connected_8(cells: set[tuple[int, int]]) -> bool:
+    todo = [next(iter(cells))]
+    seen: set[tuple[int, int]] = set()
+    while todo:
+        cur = todo.pop()
+        if cur in seen:
+            continue
+        seen.add(cur)
+        r, c = cur
+        for dr, dc in _DIRS8:
+            nxt = (r + dr, c + dc)
+            if nxt in cells and nxt not in seen:
+                todo.append(nxt)
+    return seen == cells
