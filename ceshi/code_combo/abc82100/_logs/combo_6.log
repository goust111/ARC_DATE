+INNER_SIZE = 3
+FRAME_SIZE = INNER_SIZE + 2
+PAIR_GAP = 1
+CLUSTER_H = FRAME_SIZE
+CLUSTER_W = FRAME_SIZE * 2 + PAIR_GAP
