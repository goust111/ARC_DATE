+    reserved: set[tuple[int, int]] = set()
+    for rule, top in zip(rules, starts):
+        cluster = _draw_legend(rule, inp, top, left)
+        occupied.update(cluster)
+        reserved.update(_expanded(cluster, radius=1))
+    return True, occupied, reserved
