+    if not any(len(rule["rel"]) >= 2 and rule["scattered"] for rule in identity_rules):
+        return None
+    if not np.any(output == int(MARKER_COLOR)):
+        return None
+
+    try:
+        if np.array_equal(main(inp), output):
+            return inp
+    except Exception:
+        return None
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(OUTER_RETRIES):
