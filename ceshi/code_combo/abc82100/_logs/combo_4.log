   132	def _discover_rules(grid: np.ndarray, bg: int, pattern_color: int = 8) -> list[dict]:
   133	    h, w = grid.shape
   134	    patterns = components_mask(grid == pattern_color, connectivity=8)
   135	    rules: list[dict] = []
   136	    seen: set[tuple[tuple[int, int], tuple[int, int], int]] = set()
   137	
   138	    for r in range(h):
   139	        for c in range(w):
   140	            source_color = int(grid[r, c])
   141	            if source_color in (int(bg), int(pattern_color)):
   142	                continue
   143	
   144	            for dr, dc in DIRS4:
   145	                tr = r + dr
   146	                tc = c + dc
   147	                if not (0 <= tr < h and 0 <= tc < w):
   148	                    continue
   149	
   150	                target_color = int(grid[tr, tc])
   151	                if target_color in (int(bg), int(pattern_color)) or target_color == source_color:
   152	                    continue
   153	
   154	                anchor = (tr + dr, tc + dc)
   155	                candidates: list[tuple[int, int, np.ndarray]] = []
   156	                for i, pattern in enumerate(patterns):
   157	                    dist = _anchor_distance(pattern, anchor)
   158	                    if dist <= 1:
   159	                        candidates.append((int(dist), int(i), pattern))
   160	
   161	                if not candidates:
   162	                    continue
   163	
   164	                candidates.sort(key=lambda item: (item[0], len(item[2])))
   165	                _dist, pattern_index, pattern = candidates[0]
   166	                key = ((int(r), int(c)), (int(tr), int(tc)), int(pattern_index))
   167	                if key in seen:
   168	                    continue
   169	                seen.add(key)
   170	                rules.append(
   171	                    {
   172	                        "source_color": int(source_color),
   173	                        "target_color": int(target_color),
   174	                        "source_pos": (int(r), int(c)),
   175	                        "target_pos": (int(tr), int(tc)),
   176	                        "anchor": (int(anchor[0]), int(anchor[1])),
   177	                        "dir": (int(dr), int(dc)),
   178	                        "rotation": int(ROT_BY_STEP[(int(dr), int(dc))]),
   179	                        "pattern": np.asarray(pattern, dtype=int),
   180	                    }
   181	                )
   182	
   183	    return rules
