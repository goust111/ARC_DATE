   343	def _is_asymmetric(rel: list[tuple[int, int]]) -> bool:
   344	    if len({int(r) for r, _ in rel}) < 2 or len({int(c) for _, c in rel}) < 2:
   345	        return False
   346	    base = tuple(sorted((int(r), int(c)) for r, c in rel))
   347	    for turns in (1, 2, 3):
   348	        rotated = tuple(sorted(_rotate_offset((int(r), int(c)), turns) for r, c in rel))
   349	        if rotated == base:
   350	            return False
   351	    return True
