   379	def _build_rules(num_rules: int, area: int) -> tuple[list[dict], set[int]]:
   380	    colors = NON_BG_NON_TEAL_COLORS[:]
   381	    random.shuffle(colors)
   382	    common_src = int(colors[0])
   383	    targets = [int(c) for c in colors[1 : 1 + num_rules]]
   384	    dirs = random.sample(list(ROT_BY_STEP.keys()), num_rules)
   385	
   386	    max_s = min(STENCIL_MAX_CAP, max(3, area // STENCIL_MAX_AREA_DIV))
   387	    min_s = min(max(2, area // STENCIL_MIN_AREA_DIV), max_s)
   388	    sc_max = min(SCATTERED_MAX_CAP, max(SCATTERED_MIN, area // SCATTERED_AREA_DIV))
   389	
   390	    rules: list[dict] = []
   391	    for tgt, direction in zip(targets, dirs):
   392	        stencil, anchor = _make_stencil(min_s, max_s)
   393	        rel = [(int(r) - int(anchor[0]), int(c) - int(anchor[1])) for r, c in stencil]
   394	        rot = int(ROT_BY_STEP[direction])
   395	        rules.append(
   396	            {
   397	                "src": int(common_src),
   398	                "tgt": int(tgt),
   399	                "dir": (int(direction[0]), int(direction[1])),
   400	                "rot": rot,
   401	                "rel": rel,
   402	                "rot_rel": _rotate_offsets(rel, rot),
   403	                "n_sc": random.randint(SCATTERED_MIN, sc_max),
   404	            }
   405	        )
   406	    return rules, {common_src, *targets}
