   409	def _place_legends(
   410	    rules: list[dict],
   411	    inp: np.ndarray,
   412	    blocked: set[tuple[int, int]],
   413	    color_reserved: set[tuple[int, int]],
   414	    legend_guard: set[tuple[int, int]],
   415	    teal_cells: set[tuple[int, int]],
   416	) -> bool:
   417	    h, w = inp.shape
   418	    for rule in rules:
   419	        rel = rule["rel"]
   420	        dr, dc = rule["dir"]
   421	        placed = False
   422	        for _ in range(LEGEND_RETRIES):
   423	            sr, sc = random.randint(0, h - 1), random.randint(0, w - 1)
   424	            tr, tc = sr + dr, sc + dc
   425	            ar, ac = sr + 2 * dr, sc + 2 * dc
   426	            if not (0 <= tr < h and 0 <= tc < w and 0 <= ar < h and 0 <= ac < w):
   427	                continue
   428	
   429	            teal = set()
   430	            ok = True
   431	            for rr, cc in rel:
   432	                nr = int(ar) + int(rr)
   433	                nc = int(ac) + int(cc)
   434	                if not (0 <= nr < h and 0 <= nc < w):
   435	                    ok = False
   436	                    break
   437	                teal.add((nr, nc))
   438	            if not ok:
   439	                continue
   440	
   441	            footprint = {(int(sr), int(sc)), (int(tr), int(tc)), (int(ar), int(ac))} | teal
   442	            if footprint & blocked:
   443	                continue
   444	            if footprint & legend_guard:
   445	                continue
   446	            if {(int(sr), int(sc)), (int(tr), int(tc))} & color_reserved:
   447	                continue
   448	            reverse_anchor = (int(sr) - int(dr), int(sc) - int(dc))
   449	            if any(_chebyshev(cell, reverse_anchor) <= 1 for cell in teal):
   450	                continue
   451	
   452	            inp[sr, sc] = int(rule["src"])
   453	            inp[tr, tc] = int(rule["tgt"])
   454	            for nr, nc in teal:
   455	                inp[nr, nc] = 8
   456	
   457	            rule["source_pos"] = (int(sr), int(sc))
   458	            rule["target_pos"] = (int(tr), int(tc))
   459	            rule["anchor"] = (int(ar), int(ac))
   460	
   461	            blocked.update(footprint)
   462	            color_reserved.update({(int(sr), int(sc)), (int(tr), int(tc))})
   463	            _reserve_4neighbors(color_reserved, [(int(sr), int(sc)), (int(tr), int(tc))])
   464	            teal_cells.update(teal)
   465	            legend_guard.update(_cheb_expand(list(footprint), 2))
   466	            placed = True
   467	            break
   468	        if not placed:
   469	            return False
   470	    return True
