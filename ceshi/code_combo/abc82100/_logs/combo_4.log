   214	def _nearest_teal_direction(grid: np.ndarray, pos: tuple[int, int], pattern_color: int = 8) -> tuple[int, int] | None:
   215	    teal_cells = {(int(r), int(c)) for r, c in map(tuple, np.argwhere(grid == pattern_color))}
   216	    return _nearest_teal_direction_from_set(teal_cells, pos, grid.shape)
