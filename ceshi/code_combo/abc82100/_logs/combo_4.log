   334	def _cheb_expand(cells: set[tuple[int, int]] | list[tuple[int, int]], radius: int) -> set[tuple[int, int]]:
   335	    out: set[tuple[int, int]] = set()
   336	    for r, c in cells:
   337	        for dr in range(-radius, radius + 1):
   338	            for dc in range(-radius, radius + 1):
   339	                out.add((int(r) + int(dr), int(c) + int(dc)))
   340	    return out
