   186	def _nearest_teal_direction_from_set(
   187	    teal_cells: set[tuple[int, int]], pos: tuple[int, int], shape: tuple[int, int]
   188	) -> tuple[int, int] | None:
   189	    h, w = shape
   190	    r, c = pos
   191	    best_dist: int | None = None
   192	    best_dirs: list[tuple[int, int]] = []
   193	
   194	    for dr, dc in DIRS4:
   195	        rr, cc = r + dr, c + dc
   196	        dist = 1
   197	        while 0 <= rr < h and 0 <= cc < w:
   198	            if (rr, cc) in teal_cells:
   199	                if best_dist is None or dist < best_dist:
   200	                    best_dist = dist
   201	                    best_dirs = [(dr, dc)]
   202	                elif dist == best_dist:
   203	                    best_dirs.append((dr, dc))
   204	                break
   205	            rr += dr
   206	            cc += dc
   207	            dist += 1
   208	
   209	    if best_dist is None or len(best_dirs) != 1:
   210	        return None
   211	    return best_dirs[0]
