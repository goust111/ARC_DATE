   231	def main(grid: np.ndarray) -> np.ndarray:
   232	    """
   233	    Use legend directions both to choose a rule and to rotate its teal stencil.
   234	
   235	    Input structure:
   236	    - Black background with colored pixels, multi-pixel teal stencil components, and isolated teal cue pixels.
   237	    - Each legend is still a 3-cell line source->target->anchor, and the anchor touches a teal stencil component.
   238	    - Different legends may share the same source color, so scattered source pixels cannot be matched by color alone;
   239	      each scattered source instead has a nearest teal cue on one cardinal ray.
   240	
   241	    Rule:
   242	    - Discover every legend, recording its source->target direction, target color, and canonical teal stencil.
   243	    - For each non-legend source-colored pixel, find the unique nearest teal direction; that direction selects the legend.
   244	    - Rotate that legend's stencil according to the same direction code, translate the rotated stencil so its anchor lands
   245	      on the scattered source, recolor it to the legend's target color, and erase all legend/cue teal from the output.
   246	
   247	    Key insight: The same visible direction signal is overloaded twice: it identifies which legend a scattered source should
   248	    follow, and it also tells how the legend's teal template must be quarter-turned before stamping.
   249	    """
   250	    g = np.asarray(grid, dtype=int)
   251	    bg = get_bg(g)
   252	    pattern_color = 8
   253	    h, w = g.shape
   254	
   255	    rules = _discover_rules(g, bg=bg, pattern_color=pattern_color)
   256	    legend_pixels: set[tuple[int, int]] = set()
   257	    source_colors: set[int] = set()
   258	    rules_by_dir: dict[tuple[int, int], dict] = {}
   259	    for rule in rules:
   260	        legend_pixels.add(rule["source_pos"])

