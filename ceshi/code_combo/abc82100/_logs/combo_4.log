   484	def _place_scattered(
   485	    rules: list[dict],
   486	    inp: np.ndarray,
   487	    blocked: set[tuple[int, int]],
   488	    color_reserved: set[tuple[int, int]],
   489	    legend_guard: set[tuple[int, int]],
   490	    teal_cells: set[tuple[int, int]],
   491	) -> tuple[bool, set[tuple[int, int]]]:
   492	    h, w = inp.shape
   493	    output_used: set[tuple[int, int]] = set()
   494	    scattered_refs: list[tuple[tuple[int, int], tuple[int, int]]] = []
   495	
   496	    for rule in rules:
   497	        positions: list[tuple[int, int]] = []
   498	        cues: list[tuple[int, int]] = []
   499	        for _ in range(rule["n_sc"] * SCATTERED_RETRIES_PER_PIXEL):
   500	            if len(positions) >= rule["n_sc"]:
   501	                break
   502	            sr, sc = random.randint(0, h - 1), random.randint(0, w - 1)
   503	            if (sr, sc) in blocked or (sr, sc) in color_reserved or (sr, sc) in legend_guard:
   504	                continue
   505	
   506	            stamp_cells = _stamp_rel_cells(rule["rot_rel"], (int(sr), int(sc)), (h, w))
