    21	# Design analysis
    22	# yaml:
    23	#   variant_goal:
    24	#     core_change: >
    25	#       legend 里的 source->target 方向不再只是找到 anchor 的几何辅助信息，
    26	#       而是同一时间承担两项语义：
    27	#       1) 该方向就是 scattered source 旁 teal cue 需要指向的“规则编号”；
    28	#       2) 该方向还决定 teal stencil 在输出里要旋转多少个 90 度。
    29	#       因此方向线索必须被解码两次，而且两次结果必须一致地落到同一条规则上。
    30	#     small_example: >
    31	#       设有两条 legend，二者 source 颜色都为红色。
    32	#       向右 legend 表示“右侧 cue 选中我”，target 为黄色，旋转 0 度；
    33	#       向下 legend 表示“下侧 cue 选中我”，target 为绿色，旋转 90 度。
    34	#       输入里两个红色 scattered source 即便颜色相同，只要一个最近 teal 在右边、
    35	#       一个最近 teal 在下边，它们就会分别生成黄色原向模板和绿色旋转模板。
    36	#   behavior_trace:
    37	#     original:
    38	#       - 发现 legend 后，任一 scattered source 只靠 source 色匹配规则。
    39	#       - 复制模板时不旋转。
    40	#     combo:
    41	#       - 先发现每条 legend，并记录 source->target 方向。
    42	#       - 对每个 scattered source，沿四个 cardinal 射线找唯一最近 teal，
    43	#         其方向决定选哪条 legend。
    44	#       - 选中的同一方向再被映射成 quarter-turn 数，先旋转该 legend 的 canonical stencil，
    45	#         再平移到 scattered source 上并改成该 legend 的 target 色。
    46	#     difference:
    47	#       - 同色 scattered source 会因 cue 方向不同而走向不同 target 色和不同朝向的模板。
    48	#       - 如果忽略方向，只按颜色或只按不旋转复制，都会得到错误结果。
    49	#   complexity_calibration:
    50	#     controls:
    51	#       - 每个样例固定 2-4 条规则，避免单规则时方向匹配退化不可见。
    52	#       - 所有规则共享同一种 source 色，强制求解者不能用颜色直接选规则。
    53	#       - 每个方向至多一条规则，避免 “同一 cue 方向对应多条 legend” 的歧义。
    54	#       - stencil 必须对 90/180/270 旋转都不对称，保证旋转编码肉眼可见。
    55	#     restraint:
    56	#       - cue 方向只取四个 cardinal 档位，信息量有限且可重复观察。
    57	#       - 输出中的 stamp 禁止互相重叠，避免多重覆盖掩盖旋转差异。
    58	#   implicit_assumptions_review:
    59	#     solver:
    60	#       - `_discover_rules` 不能只记颜色，必须记 `(dr, dc)` 并转成 rotation code。
    61	#       - 原版 `for sr, sc in argwhere(g == source_color)` 默认“同色对应唯一规则”，
    62	#         融合后改为“同色给出候选，再按 cue 方向唯一选 rule”。
    63	#       - 原版直接平移 `pattern` 坐标；融合后必须先转成 anchor-relative offsets，
    64	#         再按 rule 方向旋转后平移。
    65	#       - 保留 bystander 时不能简单把所有 source 色删掉；若某个 source 色像素没有合法 cue，
    66	#         solver 应保守地把它当普通像素保留。
    67	#     generator:
    68	#       - 必须保证每个 scattered source 的最近 teal 方向唯一，且正好等于它所属规则方向。
    69	#       - 必须避免 cue 靠近 legend 背面，否则 `_discover_rules` 可能学出反向假规则。
    70	#       - 必须避免 bystander 落在能看到有效 cue 的位置，否则会被误当可变换 source。
    71	#   placement_legality:
    72	#     legend_spacing: >
    73	#       legend footprint 及其 Chebyshev 半径 2 区域都会被保护，
    74	#       防止 cue 像素或其他 legend teal 进入 anchor 周边，造成误发现。
    75	#     source_spacing: >
    76	#       scattered source 仍保持 4-隔离，避免与其他颜色组成新的 source-target 对。
    77	#     cue_validation: >
    78	#       每放一个新 cue，都会重新检查所有已放置 scattered source 的最近 teal 方向，
    79	#       从而防止后放的 cue 破坏先放 source 的匹配。
    80	#   visual_observability:
    81	#     inference_story: >
    82	#       观察多个样例时，人类会看到：legend 箭头方向与 scattered source 旁 cue 的方向一一对应，
    83	#       同时该 legend 展示的 teal 模板在输出中会以不同朝向出现。
    84	#     non_degenerate_signal: >
    85	#       因为所有 legend 共用同一 source 色，若回退到原题逻辑，
    86	#       每个 scattered source 会被全部规则同时处理；和融合输出通常显著不同。
    87	#   visual_cleanliness:
    88	#     choices:
    89	#       - 输出 stamp 全部完整落在网格内，不使用边界裁剪，便于比较旋转后形状。
    90	#       - 输入中的 cue 只是一粒独立 teal 像素，和大 teal stencil 在尺度上可区分。
    91	#       - bystander 使用未参与规则的颜色，并避开任何输出 stamp 区域。
