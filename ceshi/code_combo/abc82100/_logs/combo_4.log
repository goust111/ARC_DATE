   219	def _stamp_rel_cells(rel: list[tuple[int, int]] | np.ndarray, src: tuple[int, int], shape: tuple[int, int]) -> set[tuple[int, int]]:
   220	    h, w = shape
   221	    sr, sc = src
   222	    cells: set[tuple[int, int]] = set()
   223	    for rr, cc in rel:
   224	        nr = int(sr) + int(rr)
   225	        nc = int(sc) + int(cc)
   226	        if 0 <= nr < h and 0 <= nc < w:
   227	            cells.add((nr, nc))
   228	    return cells
