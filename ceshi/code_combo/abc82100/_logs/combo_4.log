   121	def _rotate_offset(offset: tuple[int, int], turns: int) -> tuple[int, int]:
   122	    r, c = map(int, offset)
   123	    for _ in range(int(turns) % 4):
   124	        r, c = c, -r
   125	    return int(r), int(c)
   126	
   127	
   128	def _rotate_offsets(offsets: list[tuple[int, int]] | np.ndarray, turns: int) -> np.ndarray:
   129	    return np.asarray([_rotate_offset((int(r), int(c)), turns) for r, c in offsets], dtype=int)
