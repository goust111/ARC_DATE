   327	def _reserve_4neighbors(reserved: set[tuple[int, int]], cells: set[tuple[int, int]] | list[tuple[int, int]]) -> None:
   328	    for r, c in cells:
   329	        reserved.add((int(r), int(c)))
   330	        for dr, dc in DIRS4:
   331	            reserved.add((int(r) + int(dr), int(c) + int(dc)))
