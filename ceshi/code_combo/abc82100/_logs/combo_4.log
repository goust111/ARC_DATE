   354	def _make_stencil(min_pixels: int, max_pixels: int) -> tuple[list[tuple[int, int]], tuple[int, int]]:
   355	    lo = max(3, int(min_pixels))
   356	    hi = max(lo, int(max_pixels))
   357	    for _ in range(ASYMMETRIC_STENCIL_RETRIES):
   358	        n = random.randint(lo, hi)
   359	        coords = {(0, 0)}
   360	        for _ in range(n - 1):
   361	            frontier = set()
   362	            for r, c in coords:
   363	                for dr, dc in DIRS8:
   364	                    pos = (int(r) + int(dr), int(c) + int(dc))
   365	                    if pos not in coords:
   366	                        frontier.add(pos)
   367	            coords.add(random.choice(list(frontier)))
   368	        coords_list = sorted(coords)
   369	        anchor = random.choice(coords_list)
   370	        rel = [(int(r) - int(anchor[0]), int(c) - int(anchor[1])) for r, c in coords_list]
   371	        if _is_asymmetric(rel):
   372	            return coords_list, anchor
   373	
   374	    coords_list = [(0, 0), (1, 0), (1, 1)]
   375	    anchor = (1, 0)
   376	    return coords_list, anchor
