   480	def _gen_attempt():
   481	    num_rules = random.choice(RULE_COUNT_WEIGHTS)
   482	    min_dim = MIN_DIM_BY_RULES[num_rules]
   483	    h = random.randint(min_dim, GRID_DIM_MAX)
   484	    w = random.randint(min_dim, GRID_DIM_MAX)
   485	
   486	    rules, used_colors = _build_rules(num_rules, h * w)
   487	    occupied: set[tuple[int, int]] = set()
   488	    reserved: set[tuple[int, int]] = set()
   489	    inp = np.zeros((h, w), dtype=int)
   490	
   491	    if not _place_legends(rules, inp, occupied, reserved):
   492	        return None
   493	    if not _place_scattered(rules, inp, occupied, reserved):
   494	        return None
   495	    bystander_pos = _place_bystanders(used_colors, inp, occupied, reserved)
   496	
   497	    output = _build_output(rules, bystander_pos, h, w)
   498	    try:
   499	        if np.array_equal(main(inp), output):
   500	            return inp
   501	    except Exception:
   502	        pass
   503	    return None
   504	
   505	
   506	def generate_input() -> np.ndarray:
   507	    for _ in range(OUTER_RETRIES):
   508	        result = _gen_attempt()
   509	        if result is not None:
   510	            return result
   511	    raise RuntimeError(f"Failed to generate valid input after {OUTER_RETRIES} attempts")

