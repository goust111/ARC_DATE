+    if not np.array_equal(solved, out):
+        return None
+
+    if with_meta:
+        return inp, meta
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRY_LIMIT):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
