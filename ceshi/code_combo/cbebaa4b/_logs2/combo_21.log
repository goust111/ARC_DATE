+    out = _assemble(nodes, h, w)
+    if out is None:
+        return None
+    inp = _scatter(nodes, h, w)
+    if inp is None:
+        return None
+    try:
+        solved = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(solved, out):
+        return None
+
+    if with_meta:
+        return inp, meta
+    return inp
+
+
+def generate_input() -> np.ndarray:
