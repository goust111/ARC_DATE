+    meta = {
+        "layer_counts": (blue_count, green_count, orange_count),
+        "anchor_degree": blue_count,
+        "blue_nonleaf": green_count,
+        "green_nonleaf": orange_count,
+        "orange_count": orange_count,
+    }
