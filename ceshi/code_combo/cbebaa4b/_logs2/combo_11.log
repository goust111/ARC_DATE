+        for top, left in sorted(candidates):
+            nxt, next_rc = candidates[(top, left)]
+            placements.append((piece, top, left, piece["step"]))
+            dfs(idx + 1, nxt, next_rc, placements)
+            placements.pop()
+            if len(solutions) >= 2:
+                return
