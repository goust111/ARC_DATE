+    def _parse(axis_vals: list[tuple[int, int]], side: str, want_first: bool):
+        if not axis_vals:
+            return True
+        if len(axis_vals) != 2:
+            return False
+        vals = sorted(v for _u, v in axis_vals)
+        fixeds = {u for u, _v in axis_vals}
+        if len(fixeds) != 1 or vals[1] != vals[0] + 1:
+            return False
+        sides.add(side)
+        ports[side] = int(vals[0])
+        return True
