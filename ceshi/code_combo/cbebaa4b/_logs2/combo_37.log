+        top_sub = top_arr[r0 - top : r1 - top, c0 - left : c1 - left]
+        top_red_sub = top_red[r0 - top : r1 - top, c0 - left : c1 - left]
+        overlapable_sub = overlapable[r0 - br : r1 - br, c0 - bc : c1 - bc]
+        hole_sub = hole_mask[r0 - br : r1 - br, c0 - bc : c1 - bc]
