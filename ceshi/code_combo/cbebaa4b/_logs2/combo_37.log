+def _union_occupied(placed: list[dict], h: int, w: int) -> np.ndarray:
+    out = np.zeros((h, w), dtype=bool)
+    for item in placed:
+        out |= _abs_mask(item["arr"], item["top"], item["left"], h, w)
+    return out
