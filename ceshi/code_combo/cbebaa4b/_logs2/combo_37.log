+    terminals: list[tuple[int, int]] = []
+    for side in SIDES:
+        if side in node["sides"]:
+            _reds, ts, holes = _add_side_feature(arr, protect, side, node["ports"][side], node["features"][side], color)
+            terminals.extend(ts)
+            blocked.update(holes)
+        else:
+            ep = _bar_terminal((h, w), side)
+            arr[ep] = color
+            protect[ep] = True
+            terminals.append(ep)
