+def _bar_terminal(shape: tuple[int, int], side: str) -> tuple[int, int]:
+    h, w = shape
+    if side == "top":
+        return (1, w // 2)
+    if side == "bottom":
+        return (h - 2, w // 2)
+    if side == "left":
+        return (h // 2, 1)
+    return (h // 2, w - 2)
