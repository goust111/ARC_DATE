+
+def _find_path(
+    arr: np.ndarray,
+    start: tuple[int, int],
+    goals: set[tuple[int, int]],
+    blocked: set[tuple[int, int]],
+) -> list[tuple[int, int]] | None:
+    q = deque([start])
+    prev = {start: None}
+    while q:
+        cur = q.popleft()
+        if cur in goals:
+            out = []
+            while cur is not None:
