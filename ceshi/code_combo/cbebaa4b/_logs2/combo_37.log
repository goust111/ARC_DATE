+PIECE_COUNT_RANGE = (4, 5)
+PIECE_H_RANGE = (6, 8)
+PIECE_W_RANGE = (6, 8)
+PIECE_DIM_CANDIDATES = 16
+PIECE_COLORS = [1, 3, 5, 6, 7, 8, 9]
