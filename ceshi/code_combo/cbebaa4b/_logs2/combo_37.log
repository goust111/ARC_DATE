+def _grow_chain():
+    bh, bw = random.choice(ANCHOR_BLOCK_CHOICES)
+    anchor = _new_node("anchor", bh + 2, bw + 2, 4, cap=random.choice((1, 2)))
+    anchor["block"] = (bh, bw)
+    anchor["holes"] = []
+    anchor["top"] = 0
+    anchor["left"] = 0
+
+    n_pieces = random.randint(*PIECE_COUNT_RANGE)
