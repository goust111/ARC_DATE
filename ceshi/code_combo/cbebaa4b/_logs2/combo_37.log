+
+def _bar_terminal(shape: tuple[int, int], side: str) -> tuple[int, int]:
+    h, w = shape
+    if side == "top":
+        return (1, w // 2)
+    if side == "bottom":
+        return (h - 2, w // 2)
+    if side == "left":
+        return (h // 2, 1)
+    return (h // 2, w - 2)
+
+
+def _add_side_feature(
+    arr: np.ndarray,
+    protect: np.ndarray,
+    side: str,
+    k: int,
+    mode: str,
+    color: int,
+) -> tuple[list[tuple[int, int]], list[tuple[int, int]], list[tuple[int, int]]]:
+    h, w = arr.shape
+    red: list[tuple[int, int]] = []
+    solids: list[tuple[int, int]] = []
+    terminals: list[tuple[int, int]] = []
+    holes: list[tuple[int, int]] = []
+
+    if side == "left":
+        red = [(k, 1), (k + 1, 1)]
+        if mode == "plain":
+            solids = [(k, 2), (k + 1, 2)]
+            terminals = solids[:]
+        elif mode == "tab":
+            solids = [(k, 0), (k + 1, 0), (k, 2), (k + 1, 2)]
+            terminals = [(k, 2), (k + 1, 2)]
+        else:
+            holes = [(k, 2), (k + 1, 2)]
+            solids = [(k - 1, 1), (k + 2, 1), (k - 1, 2), (k + 2, 2)]
+            terminals = [(k - 1, 2), (k + 2, 2)]
+    elif side == "right":
+        red = [(k, w - 2), (k + 1, w - 2)]
+        if mode == "plain":
+            solids = [(k, w - 3), (k + 1, w - 3)]
+            terminals = solids[:]
+        elif mode == "tab":
+            solids = [(k, w - 1), (k + 1, w - 1), (k, w - 3), (k + 1, w - 3)]
+            terminals = [(k, w - 3), (k + 1, w - 3)]
+        else:
+            holes = [(k, w - 3), (k + 1, w - 3)]
+            solids = [(k - 1, w - 2), (k + 2, w - 2), (k - 1, w - 3), (k + 2, w - 3)]
+            terminals = [(k - 1, w - 3), (k + 2, w - 3)]
+    elif side == "top":
+        red = [(1, k), (1, k + 1)]
+        if mode == "plain":
+            solids = [(2, k), (2, k + 1)]
+            terminals = solids[:]
+        elif mode == "tab":
+            solids = [(0, k), (0, k + 1), (2, k), (2, k + 1)]
+            terminals = [(2, k), (2, k + 1)]
+        else:
+            holes = [(2, k), (2, k + 1)]
+            solids = [(1, k - 1), (1, k + 2), (2, k - 1), (2, k + 2)]
+            terminals = [(2, k - 1), (2, k + 2)]
+    else:
+        red = [(h - 2, k), (h - 2, k + 1)]
+        if mode == "plain":
+            solids = [(h - 3, k), (h - 3, k + 1)]
+            terminals = solids[:]
+        elif mode == "tab":
+            solids = [(h - 1, k), (h - 1, k + 1), (h - 3, k), (h - 3, k + 1)]
+            terminals = [(h - 3, k), (h - 3, k + 1)]
+        else:
+            holes = [(h - 3, k), (h - 3, k + 1)]
+            solids = [(h - 2, k - 1), (h - 2, k + 2), (h - 3, k - 1), (h - 3, k + 2)]
+            terminals = [(h - 3, k - 1), (h - 3, k + 2)]
+
+    for rr, cc in solids:
+        arr[rr, cc] = color
+        protect[rr, cc] = True
+    for rr, cc in red:
+        arr[rr, cc] = 2
+        protect[rr, cc] = True
