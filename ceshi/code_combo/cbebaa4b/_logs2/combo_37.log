+def _make_piece(node: dict) -> tuple[np.ndarray | None, np.ndarray]:
+    h, w = node["shape"]
+    color = node["color"]
+    arr = np.zeros((h, w), dtype=int)
+    protect = np.zeros((h, w), dtype=bool)
+
+    hr0 = h // 2 - 1
+    hc0 = w // 2 - 1
+    hub_cells = {
+        (hr0, hc0),
+        (hr0 + 1, hc0),
+        (hr0, hc0 + 1),
+        (hr0 + 1, hc0 + 1),
+    }
+    for rr, cc in hub_cells:
+        arr[rr, cc] = color
