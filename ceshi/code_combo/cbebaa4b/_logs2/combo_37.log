+    hr0 = h // 2 - 1
+    hc0 = w // 2 - 1
+    hub_cells = {
+        (hr0, hc0),
+        (hr0 + 1, hc0),
+        (hr0, hc0 + 1),
+        (hr0 + 1, hc0 + 1),
+    }
+    for rr, cc in hub_cells:
