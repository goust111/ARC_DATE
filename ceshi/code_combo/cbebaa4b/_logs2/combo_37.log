+    r0, c0, r1, c1 = bbox
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    local = [(rr - r0, cc - c0) for rr, cc in reds_abs if r0 <= rr <= r1 and c0 <= cc <= c1]
+    if not local:
+        return None
+
+    sides: set[str] = set()
