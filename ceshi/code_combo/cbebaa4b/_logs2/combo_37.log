+        paste(out, item["arr"], item["top"], item["left"], transparent=0)
+    return out
+
+
+def _scatter(nodes, h: int, w: int):
+    anchor = {"arr": nodes[0]["arr"], "top": nodes[0]["pos"][0], "left": nodes[0]["pos"][1]}
+    rest_nodes = nodes[1:]
