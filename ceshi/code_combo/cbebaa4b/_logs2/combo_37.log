+def _abs_mask(arr: np.ndarray, top: int, left: int, h: int, w: int) -> np.ndarray:
+    out = np.zeros((h, w), dtype=bool)
+    ph, pw = arr.shape
+    out[top : top + ph, left : left + pw] = arr != 0
+    return out
