+ANCHOR_BLOCK_CHOICES = [(3, 3), (4, 5)]
+
+SCATTER_PADDING = 0
+OVERLAP_MIN_CELLS = 2
+OVERLAP_MAX_CELLS = 8
+GEN_RETRY_LIMIT = 700
