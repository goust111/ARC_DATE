+                    overlap = 0
+                    for rr, cc in p["reds"]:
+                        gr, gc = top + rr, left + cc
+                        prev = rc.get((gr, gc), 0)
+                        if prev >= 2:
+                            bad = True
+                            break
+                        if (gr, gc) in rc1:
+                            overlap += 1
+                    if bad:
+                        continue
+                    moves.append((idx, top, left, overlap))
+            if not moves:
