+
+
+def _find_overlap_location(
+    placed: list[dict],
+    bottom: dict,
+    top_node: dict,
+    h: int,
+    w: int,
+) -> tuple[int, int, int, int] | None:
+    top_arr = top_node["arr"]
+    ph, pw = top_arr.shape
