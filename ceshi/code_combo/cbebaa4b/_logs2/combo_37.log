+# --------------- generator ---------------
+
+GRID_H_RANGE = (25, 26)
+GRID_W_RANGE = (25, 26)
+MAX_ASSEMBLY_DIM = 24
+
+PIECE_COUNT_RANGE = (4, 4)
+PIECE_H_RANGE = (6, 7)
+PIECE_W_RANGE = (6, 7)
+PIECE_DIM_CANDIDATES = 16
+PIECE_COLORS = [1, 3, 5, 6, 7, 8, 9]
