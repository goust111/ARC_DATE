+
+def _paint_bar(arr: np.ndarray, protect: np.ndarray, side: str, color: int):
+    h, w = arr.shape
+    if side == "top":
+        arr[0, :] = color
+        protect[0, :] = True
+    elif side == "bottom":
+        arr[h - 1, :] = color
+        protect[h - 1, :] = True
+    elif side == "left":
+        arr[:, 0] = color
+        protect[:, 0] = True
+    else:
+        arr[:, w - 1] = color
+        protect[:, w - 1] = True
