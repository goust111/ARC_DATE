+def _extract_anchor_piece(g: np.ndarray, bg: int) -> dict:
+    anchors = []
+    for idx, pts in enumerate(components_mask(g != bg, connectivity=4)):
+        r0, c0, r1, c1 = bbox_coords(pts)
+        arr = g[r0 : r1 + 1, c0 : c1 + 1].copy()
+        if np.any(arr == 4):
