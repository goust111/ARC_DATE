+                {"arr": top_node["arr"], "top": tr, "left": tc},
+            ]
+            occ_others = _union_occupied([anchor], h, w)
+            top_mask = _abs_mask(top_node["arr"], tr, tc, h, w)
+            if np.any(occ_others & top_mask):
