+def _candidate_fits(nodes: list[dict], parent_i: int, child: dict) -> bool:
+    cb = _bbox_of(child)
+    if not _rects_overlap(cb, _bbox_of(nodes[parent_i])):
+        return False
+    for i, other in enumerate(nodes):
+        if i == parent_i:
