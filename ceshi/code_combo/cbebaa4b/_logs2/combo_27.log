+    if piece_colors.count(1) != 2 or piece_colors.count(8) != 2:
+        return None
+    if piece_colors.count(3) != 1 or piece_colors.count(7) != 1:
+        return None
+
+    try:
+        solved = main(inp)
+    except Exception:
+        return None
+    if np.array_equal(solved, out):
+        return inp
+    return None
+
+
+def generate_input() -> np.ndarray:
