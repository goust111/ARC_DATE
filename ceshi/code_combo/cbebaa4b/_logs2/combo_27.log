+    if len(components_mask(arr != BG, connectivity=4)) != 1:
+        return None
+    if int(np.sum(arr == RED)) != 2 * len(used):
+        return None
+    return arr
+
+
+def _make_anchor(node: dict) -> np.ndarray:
+    bh, bw = node["block"]
+    h, w = node["shape"]
+    arr = np.zeros((h, w), dtype=int)
