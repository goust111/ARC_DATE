+# Combo variant of cbebaa4b (index 38)
+# combo_spec: D3/2+D7/3
+# Name: 线段锚点 + 双向同步组装
+
+from __future__ import annotations
+
+from pathlib import Path
+import sys
+import random
+
+import numpy as np
+
+ROOT = Path(__file__).resolve().parents[5]
+if str(ROOT) not in sys.path:
+    sys.path.append(str(ROOT))
