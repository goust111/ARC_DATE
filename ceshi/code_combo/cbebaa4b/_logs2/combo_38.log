+    end_usage = _anchor_end_extensions(out, anchor_piece)
+    if not all(end_usage):
+        return None
+
+    _LAST_GENERATION_META = {
+        **meta,
+        "end_usage": end_usage,
+        "grid_shape": (h, w),
+    }
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRY_LIMIT):
+        grid = _gen_attempt()
+        if grid is not None:
