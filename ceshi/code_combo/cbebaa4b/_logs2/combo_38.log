+def _piece_axis_info(arr: np.ndarray, expected_axis: str) -> dict | None:
+    reds = np.argwhere(arr == 2)
+    if len(reds) not in (2, 4):
+        return None
+
+    h, w = arr.shape
+    groups: dict[str, list[tuple[int, int]]] = {}
+    for rr, cc in reds:
