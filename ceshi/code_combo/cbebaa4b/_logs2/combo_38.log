+        for _ in range(PIECE_DIM_CANDIDATES)
+    ]
+    random.shuffle(dims)
+    incoming = INCOMING_SIDE[label]
+
+    for ph, pw in dims:
+        child = _new_node("piece", ph, pw, color, axis)
+        child["sides"].add(incoming)
