+    used_sides = []
+    for side, cells in groups.items():
+        if len(cells) != 2:
+            return None
+        rows = sorted(r for r, _ in cells)
+        cols = sorted(c for _, c in cells)
+        if side in ("top", "bottom"):
+            if rows[0] != rows[1] or cols[1] != cols[0] + 1:
+                return None
+        else:
