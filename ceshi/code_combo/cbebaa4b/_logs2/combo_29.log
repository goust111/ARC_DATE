+        return None
+    interior = cropped[1:-1, 1:-1] if cropped.shape[0] > 2 and cropped.shape[1] > 2 else cropped[:0, :0]
+    if interior.size == 0 or int(np.sum(interior == 0)) < 9:
+        return None
