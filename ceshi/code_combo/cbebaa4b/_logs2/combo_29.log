+
+
+def _scatter(nodes, h, w):
+    inp = np.zeros((h, w), dtype=int)
+    anchor = nodes[0]
+    paste(inp, anchor["arr"], *anchor["pos"], transparent=0)
+    rest = nodes[1:]
+    random.shuffle(rest)
+    for node in rest:
+        try:
+            r, c = random_free_location(
+                inp,
+                node["arr"],
+                transparent=0,
+                padding=SCATTER_PADDING,
+                padding_connectivity=8,
+            )
+        except ValueError:
+            return None
+        paste(inp, node["arr"], r, c, transparent=0)
+    return inp
+
+
+def _gen_attempt():
+    h = random.randint(*GRID_H_RANGE)
+    w = random.randint(*GRID_W_RANGE)
+    nodes = _build_ring_nodes()
+    if nodes is None:
+        return None
+    assembled = _assemble(nodes, h, w)
+    if assembled is None:
+        return None
+    _full, out = assembled
+    inp = _scatter(nodes, h, w)
+    if inp is None:
+        return None
+    try:
+        solved = main(inp)
+    except Exception:
+        return None
+    if np.array_equal(solved, out):
+        return inp
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRY_LIMIT):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid cbebaa4b combo input")

