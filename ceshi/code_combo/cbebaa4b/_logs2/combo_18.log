+# --------------- generator (o5x) ---------------
+
+# Canvas
+GRID_H_RANGE = (22, 26)
+GRID_W_RANGE = (22, 26)
+MAX_ASSEMBLY_DIM = 24
+
+# Pieces
+PIECE_COUNT_RANGE = (4, 6)
+PIECE_H_RANGE = (4, 7)
+PIECE_W_RANGE = (4, 8)
+PIECE_DIM_CANDIDATES = 12
