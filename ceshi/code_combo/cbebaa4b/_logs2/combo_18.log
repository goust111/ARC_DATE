+def _cross_mask() -> np.ndarray:
+    mask = np.zeros((6, 6), dtype=bool)
+    mask[2:4, :] = True
+    mask[:, 2:4] = True
+    mask[2, 2] = False
+    mask[3, 3] = False
+    return mask
