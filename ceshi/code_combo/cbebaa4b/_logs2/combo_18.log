+    assert pieces, "input must have at least one colored piece"
+
+    anchors = [p for p in pieces if _is_anchor_piece(p["arr"])]
+    assert len(anchors) == 1, "input must have exactly one hollow cross/L yellow anchor piece"
+    anchor = anchors[0]
