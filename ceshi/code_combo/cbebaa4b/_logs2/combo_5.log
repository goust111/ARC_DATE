   493	def _build_piece_layout():
   494	    bh, bw = random.choice(ANCHOR_BLOCK_CHOICES)
   495	    anchor_h, anchor_w = bh + 2, bw + 2
   496	    top_h = random.randint(*STRIP_THICKNESS_RANGE)
   497	    bottom_h = random.randint(*STRIP_THICKNESS_RANGE)
