+def _enumerate_assemblies(
+    grid: np.ndarray,
+    *,
+    require_rectangle: bool | None,
+    require_filled_holes: bool | None,
+    max_solutions: int,
+) -> list[np.ndarray]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
