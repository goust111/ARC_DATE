+def _scatter(pieces: list[dict], anchor_pos: tuple[int, int], grid_h: int, grid_w: int) -> np.ndarray | None:
+    inp = np.zeros((grid_h, grid_w), dtype=int)
+    anchor = next(piece for piece in pieces if piece["name"] == "anchor")
