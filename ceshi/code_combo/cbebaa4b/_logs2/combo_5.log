   355	ANCHOR_BLOCK_CHOICES = [(3, 3), (4, 5)]
   356	SIDE_THICKNESS_RANGE = (4, 6)
   357	STRIP_THICKNESS_RANGE = (4, 6)
   358	PIECE_COLORS = [1, 3, 5, 6, 7, 8, 9]
   359	SCATTER_PADDING = 2
   360	GEN_RETRY_LIMIT = 1200
   361	
   362	A, T, L, R, B = 0, 1, 2, 3, 4
   363	REGION_NAMES = {A: "anchor", T: "top", L: "left", R: "right", B: "bottom"}
   364	GRAPH_EDGES = [
   365	    (A, T),
   366	    (A, L),
   367	    (A, R),
   368	    (A, B),
   369	    (T, L),
   370	    (T, R),
   371	    (L, B),
   372	    (R, B),
   373	]
