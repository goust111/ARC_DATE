   462	def _choose_segment(
   463	    pairs: list[tuple[tuple[int, int], tuple[int, int]]],
   464	    parent: int,
   465	    own: np.ndarray,
   466	) -> tuple[list[tuple[int, int]], list[tuple[int, int]]]:
   467	    oriented = []
   468	    for p0, p1 in pairs:
   469	        if int(own[p0]) == parent:
   470	            oriented.append((p0, p1))
   471	        else:
   472	            oriented.append((p1, p0))
   473	    assert len(oriented) >= 4
   474	    starts = list(range(len(oriented) - 1))
   475	    if len(starts) >= 3:
   476	        starts = starts[1:-1]
   477	    start = random.choice(starts)
   478	    seg = oriented[start : start + 2]
   479	    parent_cells = [pc for pc, _ in seg]
   480	    child_cells = [cc for _, cc in seg]
   481	    return parent_cells, child_cells
