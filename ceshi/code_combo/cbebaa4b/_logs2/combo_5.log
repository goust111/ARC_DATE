   323	def main(grid: np.ndarray) -> np.ndarray:
   324	    """
   325	    Reassemble scattered sprites into a filled rectangle around the fixed yellow anchor, while using tongues to plug visible cavities.
   326	
   327	    Input structure:
   328	    - The background is black (0), with one yellow anchor piece and four non-anchor colored sprites scattered apart.
   329	    - Red (2) cells mark connector overlaps, and some non-anchor sprites contain enclosed black holes inside their own bounding boxes.
   330	    - The anchor is already at its final location and stays fixed; every other sprite must be translated onto it.
   331	
   332	    Rule:
   333	    - Build the assembly by overlapping a piece's red connector cells with currently unpaired red cells in the growing structure.
   334	    - Non-red cells may never overlap; the only legal overlaps are red-on-red connector matches.
   335	    - A completed assembly is valid only if every red cell is paired exactly once, every enclosed hole from the input pieces is filled by a neighboring tongue, and the final non-black silhouette is one solid rectangle.
   336	
   337	    Key insight:
   338	    - The red markers propose candidate translations, but they do not finish the job on their own.
   339	    - The correct move must also respect the slot/tab geometry of the pieces, and the full set of locally compatible joins must still close into one globally solid rectangle.
   340	    """
   341	    sols = _enumerate_assemblies(
   342	        np.asarray(grid, dtype=int),
   343	        require_rectangle=True,
   344	        require_filled_holes=True,
   345	        max_solutions=2,
   346	    )
   347	    assert len(sols) == 1, "assembly must have exactly one fused-valid solution"
   348	    return sols[0]
