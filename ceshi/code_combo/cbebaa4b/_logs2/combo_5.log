   411	def _tree_ok(edges: list[tuple[int, int]]) -> bool:
   412	    if len(edges) != 4:
   413	        return False
   414	    adj = {k: set() for k in REGION_NAMES}
   415	    for u, v in edges:
   416	        adj[u].add(v)
   417	        adj[v].add(u)
   418	    seen = set()
   419	    stack = [A]
   420	    while stack:
   421	        cur = stack.pop()
   422	        if cur in seen:
   423	            continue
   424	        seen.add(cur)
   425	        stack.extend(adj[cur] - seen)
   426	    return len(seen) == 5
