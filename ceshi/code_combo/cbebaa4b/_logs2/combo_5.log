   445	def _orient_from_anchor(tree_edges: list[tuple[int, int]]) -> dict[int, int | None]:
   446	    adj = {k: [] for k in REGION_NAMES}
   447	    for u, v in tree_edges:
   448	        adj[u].append(v)
   449	        adj[v].append(u)
   450	    parent: dict[int, int | None] = {A: None}
   451	    stack = [A]
   452	    while stack:
   453	        cur = stack.pop()
   454	        for nxt in adj[cur]:
   455	            if nxt in parent:
   456	                continue
   457	            parent[nxt] = cur
   458	            stack.append(nxt)
   459	    return parent
