   429	def _all_spanning_trees() -> list[list[tuple[int, int]]]:
   430	    trees = []
   431	    for edges in itertools.combinations(GRAPH_EDGES, 4):
   432	        edge_list = list(edges)
   433	        if not _tree_ok(edge_list):
   434	            continue
   435	        deg_anchor = sum(1 for u, v in edge_list if A in (u, v))
   436	        if deg_anchor != 2:
   437	            continue
   438	        trees.append(edge_list)
   439	    return trees
