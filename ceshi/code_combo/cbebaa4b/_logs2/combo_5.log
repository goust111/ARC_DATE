   500	
   501	    own = _ownership_grid(top_h, left_w, anchor_h, anchor_w, right_w, bottom_h)
   502	    interfaces = _adjacency_pairs(own)
   503	    tree_edges = random.choice(SPANNING_TREES)
   504	    parent = _orient_from_anchor(tree_edges)
   505	
   506	    colors = random.sample(PIECE_COLORS, 4)
   507	    region_color = {A: 4, T: colors[0], L: colors[1], R: colors[2], B: colors[3]}
   508	    pieces_abs: dict[int, dict[tuple[int, int], int]] = {
   509	        region: {cell: region_color[region] for cell in _region_cells(own, region)} for region in REGION_NAMES
   510	    }
   511	
   512	    slot_edges = 0
