+A, T, L, R, B = 0, 1, 2, 3, 4
+REGION_NAMES = {A: "anchor", T: "top", L: "left", R: "right", B: "bottom"}
+GRAPH_EDGES = [
+    (A, T),
+    (A, L),
+    (A, R),
+    (A, B),
+    (T, L),
