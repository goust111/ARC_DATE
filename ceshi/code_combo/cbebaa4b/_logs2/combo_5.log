   123	def _try_place(
   124	    canvas: np.ndarray, arr: np.ndarray, top: int, left: int, bg: int
   125	) -> np.ndarray | None:
   126	    h, w = canvas.shape
   127	    ph, pw = arr.shape
   128	    if top < 0 or left < 0 or top + ph > h or left + pw > w:
   129	        return None
   130	
   131	    sub = canvas[top : top + ph, left : left + pw]
   132	    mask = arr != bg
   133	    if not np.any(mask):
   134	        return None
   135	
   136	    conflict = mask & (sub != bg) & ~((arr == 2) & (sub == 2))
   137	    if np.any(conflict):
   138	        return None
   139	
   140	    out = canvas.copy()
   141	    out_sub = out[top : top + ph, left : left + pw]
   142	    out_sub[mask] = arr[mask]
   143	    out[top : top + ph, left : left + pw] = out_sub
   144	    return out
