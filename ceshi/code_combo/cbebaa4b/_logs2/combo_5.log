   484	def _cells_to_arr(cells: dict[tuple[int, int], int]) -> tuple[np.ndarray, tuple[int, int]]:
   485	    pts = np.array(list(cells), dtype=int)
   486	    r0, c0, r1, c1 = bbox_coords(pts)
   487	    arr = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=int)
   488	    for (r, c), col in cells.items():
   489	        arr[r - r0, c - c0] = int(col)
   490	    return arr, (int(r0), int(c0))
