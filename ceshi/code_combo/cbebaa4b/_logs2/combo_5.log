   394	def _adjacency_pairs(own: np.ndarray) -> dict[tuple[int, int], list[tuple[tuple[int, int], tuple[int, int]]]]:
   395	    h, w = own.shape
   396	    out: dict[tuple[int, int], list[tuple[tuple[int, int], tuple[int, int]]]] = {}
   397	    for r in range(h):
   398	        for c in range(w):
   399	            u = int(own[r, c])
   400	            if r + 1 < h:
   401	                v = int(own[r + 1, c])
   402	                if u != v:
   403	                    out.setdefault((min(u, v), max(u, v)), []).append(((r, c), (r + 1, c)))
   404	            if c + 1 < w:
   405	                v = int(own[r, c + 1])
   406	                if u != v:
   407	                    out.setdefault((min(u, v), max(u, v)), []).append(((r, c), (r, c + 1)))
   408	    return out
