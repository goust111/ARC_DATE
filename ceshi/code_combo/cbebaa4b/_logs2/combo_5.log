   114	                "reds": [(int(r), int(c)) for r, c in reds],
   115	                "holes": _interior_holes(arr, bg),
   116	                "shape": (int(arr.shape[0]), int(arr.shape[1])),
   117	                "area": int(np.sum(arr != bg)),
   118	            }
