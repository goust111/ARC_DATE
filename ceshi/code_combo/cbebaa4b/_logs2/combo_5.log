+    out, anchor_pos = rendered
+
+    inp = _scatter(pieces, anchor_pos, grid_h, grid_w)
+    if inp is None:
+        return None
+
+    try:
+        solved = main(inp)
+    except Exception:
+        return None
+    if np.array_equal(solved, out):
+        return inp
+    return None
+
+
+def generate_input() -> np.ndarray:
