+            )
+        except ValueError:
+            return None
+        paste(inp, piece["arr"], r, c, transparent=0)
+    return inp
+
+
+def _gen_attempt() -> np.ndarray | None:
+    grid_h = random.randint(*GRID_H_RANGE)
+    grid_w = random.randint(*GRID_W_RANGE)
