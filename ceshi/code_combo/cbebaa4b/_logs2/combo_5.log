   376	def _ownership_grid(
   377	    top_h: int, left_w: int, anchor_h: int, anchor_w: int, right_w: int, bottom_h: int
   378	) -> np.ndarray:
   379	    h = top_h + anchor_h + bottom_h
   380	    w = left_w + anchor_w + right_w
   381	    own = np.full((h, w), -1, dtype=int)
   382	    own[:top_h, :] = T
   383	    own[top_h : top_h + anchor_h, :left_w] = L
   384	    own[top_h : top_h + anchor_h, left_w : left_w + anchor_w] = A
   385	    own[top_h : top_h + anchor_h, left_w + anchor_w :] = R
   386	    own[top_h + anchor_h :, :] = B
   387	    return own
