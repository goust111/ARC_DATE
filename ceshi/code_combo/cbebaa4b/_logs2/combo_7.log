    ```python
    import numpy as np

from arc_utils import bbox_coords, components_mask, paste, random_free_location
import random


def _extract_pieces(g: np.ndarray, bg: int) -> list[dict]:
    comps = components_mask(g != bg, connectivity=4)
    pieces = []
    for pts in comps:
        r0, c0, r1, c1 = bbox_coords(pts)
        arr = g[r0 : r1 + 1, c0 : c1 + 1].copy()
        reds = np.argwhere(arr == 2)
        pieces.append(
            {
                "bbox": (int(r0), int(c0), int(r1), int(c1)),
                "arr": arr,
                "reds": [(int(r), int(c)) for r, c in reds],
                "shape": (int(arr.shape[0]), int(arr.shape[1])),
                "area": int(np.sum(arr != bg)),
            }
        )
    return pieces


def _try_place(
    canvas: np.ndarray, arr: np.ndarray, top: int, left: int, bg: int
) -> np.ndarray | None:
    h, w = canvas.shape
    ph, pw = arr.shape
    if top < 0 or left < 0 or top + ph > h or left + pw > w:
        return None

    sub = canvas[top : top + ph, left : left + pw]
    mask = arr != bg
    if not np.any(mask):
        return None

    conflict = mask & (sub != bg) & ~(((arr == 2) & (sub == 2)) | (arr == sub))
    if np.any(conflict):
        return None

    out = canvas.copy()
    out_sub = out[top : top + ph, left : left + pw]
    out_sub[mask] = arr[mask]
    out[top : top + ph, left : left + pw] = out_sub
    return out


def main(grid: np.ndarray) -> np.ndarray:
    """
    Assemble scattered jigsaw sprites around a central yellow anchor by pairing red connector pixels.

    Input structure:
    - bg = black (0). Several colored sprites scattered on the grid.
    - One anchor sprite contains a 3×3 yellow (4) block.
    - Each sprite has red (2) connector pixels along its edges.

    Rule:
    - The anchor stays in place; remaining sprites attach one at a time.
    - Each sprite is translated so that one of its red pixels overlaps an unpaired red pixel on the growing assembly.
    - Every red connector must pair with exactly one other, forming a complete joined structure.

    Key insight: Red pixels act as jigsaw pegs — each must match exactly one counterpart, and the assembly order is determined by which unpaired connectors remain.
    """
    g = np.asarray(grid, dtype=int)
    h, w = g.shape
    bg = 0

    pieces = _extract_pieces(g, bg)
    assert pieces, "input must have at least one colored piece"

    # Anchor is the unique piece containing the 3x3 yellow (color 4) block.
    anchors = [p for p in pieces if np.any(p["arr"] == 4)]
    assert len(anchors) == 1, "input must have exactly one yellow (4) anchor piece"
    anchor = anchors[0]
    rest = [p for p in pieces if p is not anchor]

    canvas = np.full((h, w), bg, dtype=int)
    ar0, ac0, _, _ = anchor["bbox"]
    placed = _try_place(canvas, anchor["arr"], ar0, ac0, bg)
    assert placed is not None, "anchor piece must fit on canvas at its original position"

    total_ports = int(sum(len(p["reds"]) for p in pieces))
    assert total_ports % 2 == 0, "total red connector ports must be even for complete pairing"
    target_unique_red = total_ports // 2

    # Track how many original red pixels map to each assembled red coordinate.
    red_counts: dict[tuple[int, int], int] = {}
    for rr, cc in anchor["reds"]:
        red_counts[(ar0 + rr, ac0 + cc)] = red_counts.get((ar0 + rr, ac0 + cc), 0) + 1

    # Backtracking assembly by pairing up red connector pixels.
    solutions: list[np.ndarray] = []

    def dfs(cur: np.ndarray, remaining: list[dict], rc: dict[tuple[int, int], int]) -> None:
        if len(solutions) >= 2:
            return

        if not remaining:
            if len(rc) == target_unique_red and all(v == 2 for v in rc.values()):
                solutions.append(cur)
            return

        if len(rc) > target_unique_red:
            return

        # Unpaired reds are exactly those with count==1; always pair one of them next.
        unpaired = [k for k, v in rc.items() if v == 1]
        if not unpaired:
            return

        rc1 = {k for k, v in rc.items() if v == 1}

        # Pick the most constrained unpaired red coordinate: fewest ways to cover it.
        best_moves = None
        for t in unpaired:
            moves = []
            tr, tc = t
            for idx, p in enumerate(remaining):
                ph, pw = p["shape"]
                for pr, pc in p["reds"]:
                    top = tr - pr
                    left = tc - pc
                    if top < 0 or left < 0 or top + ph > h or left + pw > w:
                        continue
                    # quick red-count feasibility
                    bad = False
                    overlap = 0
                    for rr, cc in p["reds"]:
                        gr, gc = top + rr, left + cc
                        prev = rc.get((gr, gc), 0)
                        if prev >= 2:
                            bad = True
                            break
                        if (gr, gc) in rc1:
                            overlap += 1
                    if bad:
                        continue
                    # must overlap at least the target (guaranteed), but keep for scoring
                    moves.append((idx, top, left, overlap))
            if not moves:
                return
            if best_moves is None or len(moves) < len(best_moves):
                best_moves = moves
                if len(best_moves) == 1:
                    break

        assert best_moves is not None, "there must be at least one feasible connector move"

        # Deduplicate moves by (piece, top, left) keeping max overlap score.
        dedup: dict[tuple[int, int, int], int] = {}
        for idx, top, left, ov in best_moves:
            k = (idx, top, left)
            dedup[k] = max(dedup.get(k, 0), ov)
        moves2 = [(idx, top, left, ov) for (idx, top, left), ov in dedup.items()]
        moves2.sort(key=lambda x: (-x[3], -remaining[x[0]]["area"], x[1], x[2], x[0]))

        for idx, top, left, _ov in moves2:
            p = remaining[idx]
            next_remaining = remaining[:idx] + remaining[idx + 1 :]

            next_rc = dict(rc)
            for rr, cc in p["reds"]:
                gr, gc = top + rr, left + cc
                next_rc[(gr, gc)] = next_rc.get((gr, gc), 0) + 1

            nxt = _try_place(cur, p["arr"], top, left, bg)
            if nxt is None:
                continue
            dfs(nxt, next_remaining, next_rc)
            if len(solutions) >= 2:
                return

    dfs(placed, rest, red_counts)
    assert len(solutions) == 1, "jigsaw assembly must have exactly one valid solution"
    return solutions[0]

# --------------- generator (o5x) ---------------

# ── Tunable configuration ──────────────────────────────────────────────
# Canvas
GRID_H_RANGE = (22, 26)               # output grid height bounds
GRID_W_RANGE = (22, 26)               # output grid width bounds
MAX_ASSEMBLY_DIM = 24                  # assembled jigsaw must fit inside this

# Pieces
PIECE_COUNT_RANGE = (4, 6)            # non-anchor sprite count
PIECE_H_RANGE = (4, 7)               # piece bbox height bounds
PIECE_W_RANGE = (4, 8)               # piece bbox width bounds
PIECE_DIM_CANDIDATES = 12            # random (h,w) trials per piece placement
PIECE_COLORS = [1, 3, 5, 6, 7, 8, 9] # available non-red, non-yellow colors
PIECE_CAP = 2                         # max connections per piece node
BAR_SKIP_PROB = 0.35                  # probability of dropping one decorative bar

# Anchor
ANCHOR_BLOCK_CHOICES = [(3, 3), (4, 5)]  # yellow block (h, w) options
ANCHOR_CAP_CHOICES = [1, 2]              # max connections for anchor node

# Scatter
SCATTER_PADDING = 2                   # Chebyshev gap between scattered sprites

# Generation
GEN_RETRY_LIMIT = 300                 # max attempts before raising RuntimeError

# ── Side geometry lookups ──────────────────────────────────────────────
SIDES = ("top", "right", "bottom", "left")
OPPOSITE = {"top": "bottom", "bottom": "top", "left": "right", "right": "left"}
INWARD = {"top": (1, 0), "bottom": (-1, 0), "left": (0, 1), "right": (0, -1)}


def _new_node(kind, h, w, color, top=0, left=0, cap=PIECE_CAP):
    return {
        "kind": kind, "shape": (int(h), int(w)), "color": int(color),
        "top": int(top), "left": int(left), "cap": int(cap),
        "sides": set(), "ports": {},
    }


def _ensure_port(node, side):
    """Lazily assign a random port offset for *side* if not already set."""
    if side in node["ports"]:
        return
    h, w = node["shape"]
    span = h if side in ("left", "right") else w
    node["ports"][side] = random.randint(1, span - 3)


def _port_cells(node, side):
    """Return the two local (r, c) cells that form the red connector on *side*."""
    h, w = node["shape"]
    k = node["ports"][side]
    if side == "top":
        return [(0, k), (0, k + 1)]
    if side == "bottom":
        return [(h - 1, k), (h - 1, k + 1)]
    if side == "left":
        return [(k, 0), (k + 1, 0)]
    return [(k, w - 1), (k + 1, w - 1)]


def _global_port(node, side):
    tr, tc = node["top"], node["left"]
    return [(tr + r, tc + c) for r, c in _port_cells(node, side)]


def _bbox_of(node):
    h, w = node["shape"]
    return (node["top"], node["left"], node["top"] + h - 1, node["left"] + w - 1)


def _rects_overlap(a, b):
    return not (a[2] < b[0] or b[2] < a[0] or a[3] < b[1] or b[3] < a[1])


def _union_bbox(nodes):
    boxes = [_bbox_of(n) for n in nodes]
    return (
        min(b[0] for b in boxes), min(b[1] for b in boxes),
        max(b[2] for b in boxes), max(b[3] for b in boxes),
    )


def _draw_path(arr, start, end, color, order):
    """Draw an L-shaped path from *start* to *end*, preserving red (2) pixels."""
    r, c = start
    er, ec = end
    # order 0: row-first then col; order 1: col-first then row
    axes = [(r, er, c, True), (c, ec, er, False)] if order == 0 else \
           [(c, ec, r, False), (r, er, ec, True)]
    for a_start, a_end, fixed, is_row in axes:
        step = 1 if a_end >= a_start else -1
        for v in range(a_start, a_end + step, step):
            rr, cc = (v, fixed) if is_row else (fixed, v)
            if arr[rr, cc] != 2:
                arr[rr, cc] = color


def _paint_bar(arr, side, color, used):
    """Paint a decorative bar along *side*, skipping corners claimed by *used* sides."""
    h, w = arr.shape
    is_horizontal = side in ("top", "bottom")
    fixed = 0 if side in ("top", "left") else (h - 1 if side == "bottom" else w - 1)
    span = w if is_horizontal else h
    # corner neighbors: (index, conflicting side) pairs
    lo_conflict = "left" if is_horizontal else "top"
    hi_conflict = "right" if is_horizontal else "bottom"
    for i in range(span):
        if (i == 0 and lo_conflict in used) or (i == span - 1 and hi_conflict in used):
            continue
        if is_horizontal:
            arr[fixed, i] = color
        else:
            arr[i, fixed] = color


def _bar_endpoint(shape, side, hub):
    h, w = shape
    hr, hc = hub
    if side in ("top", "bottom"):
        row = 0 if side == "top" else h - 1
        return (row, min(max(hc, 1), w - 2))
    col = 0 if side == "left" else w - 1
    return (min(max(hr, 1), h - 2), col)


def _make_piece(node):
    """Render a piece sprite array with red connectors and decorative bars."""
    h, w = node["shape"]
    color = node["color"]
    used = set(node["sides"])
    arr = np.zeros((h, w), dtype=int)
    hub = (random.randint(1, h - 2), random.randint(1, w - 2))

    bar_sides = [s for s in SIDES if s not in used]
    if len(bar_sides) > 1 and random.random() < BAR_SKIP_PROB:
        bar_sides.remove(random.choice(bar_sides))
    for side in bar_sides:
        _paint_bar(arr, side, color, used)

    terminals = []
    for side in used:
        dr, dc = INWARD[side]
        for r, c in _port_cells(node, side):
            arr[r, c] = 2
            rr, cc = r + dr, c + dc
            arr[rr, cc] = color
            terminals.append((rr, cc))

    arr[hub] = color
    order = random.randint(0, 1)
    for t in terminals:
        _draw_path(arr, t, hub, color, order)
    for side in bar_sides:
        _draw_path(arr, hub, _bar_endpoint((h, w), side, hub), color, 1 - order)

    if len(components_mask(arr != 0, connectivity=4)) != 1:
        return None
    if int(np.sum(arr == 2)) != 2 * len(used):
        return None
    return arr


def _make_anchor(node):
    bh, bw = node["block"]
    h, w = node["shape"]
    arr = np.zeros((h, w), dtype=int)
    arr[1 : 1 + bh, 1 : 1 + bw] = 4
    for side in node["sides"]:
        for r, c in _port_cells(node, side):
            arr[r, c] = 2
    return arr


def _candidate_fits(nodes, parent_i, child):
    """Check child overlaps only its parent and total assembly stays within bounds."""
    cb = _bbox_of(child)
    if not _rects_overlap(cb, _bbox_of(nodes[parent_i])):
        return False
    for i, other in enumerate(nodes):
        if i == parent_i:
            continue
        if _rects_overlap(cb, _bbox_of(other)):
            return False
    r0, c0, r1, c1 = _union_bbox(nodes + [child])
    return (r1 - r0 + 1) <= MAX_ASSEMBLY_DIM and (c1 - c0 + 1) <= MAX_ASSEMBLY_DIM


def _grow_tree():
    """Build a tree of connected nodes (1 anchor + N pieces) in local coordinates."""
    bh, bw = random.choice(ANCHOR_BLOCK_CHOICES)
    anchor = _new_node("anchor", bh + 2, bw + 2, 4, cap=random.choice(ANCHOR_CAP_CHOICES))
    anchor["block"] = (bh, bw)
    nodes = [anchor]
    n_pieces = random.randint(*PIECE_COUNT_RANGE)
    colors = random.sample(PIECE_COLORS, n_pieces)

    for i in range(n_pieces):
        placed = False
        dims = [(random.randint(*PIECE_H_RANGE), random.randint(*PIECE_W_RANGE))
                for _ in range(PIECE_DIM_CANDIDATES)]
        random.shuffle(dims)
        for ph, pw in dims:
            parents = [j for j, n in enumerate(nodes) if len(n["sides"]) < n["cap"]]
            random.shuffle(parents)
            for parent_i in parents:
                parent = nodes[parent_i]
                sides = [s for s in SIDES if s not in parent["sides"]]
                random.shuffle(sides)
                for side in sides:
                    child = _new_node("piece", ph, pw, colors[i])
                    incoming = OPPOSITE[side]
                    _ensure_port(parent, side)
                    _ensure_port(child, incoming)
                    pr, pc = _global_port(parent, side)[0]
                    cr, cc = _port_cells(child, incoming)[0]
                    child["top"] = pr - cr
                    child["left"] = pc - cc
                    child["sides"].add(incoming)
                    if not _candidate_fits(nodes, parent_i, child):
                        continue
                    parent["sides"].add(side)
                    nodes.append(child)
                    placed = True
                    break
                if placed:
                    break
            if placed:
                break
        if not placed:
            return None
    return nodes


def _place_node_on_canvas(out, node, sr, sc):
    """Stamp a single node's sprite onto *out*, tracking red overlaps.

    Returns red_counts dict on success, or None on conflict.
    """
    arr = node["arr"]
    top, left = node["top"] + sr, node["left"] + sc
    node["pos"] = (top, left)
    red_counts = {}
    mask = arr != 0
    rows, cols = np.nonzero(mask)
    g_rows, g_cols = rows + top, cols + left
    vals = arr[rows, cols]
    cur_vals = out[g_rows, g_cols]
    # Conflict: non-bg destination that isn't a red-on-red overlap
    conflicts = (cur_vals != 0) & ~((cur_vals == 2) & (vals == 2))
    if np.any(conflicts):
        return None
    # Track red overlap counts
    red_mask = vals == 2
    for gr, gc in zip(g_rows[red_mask], g_cols[red_mask]):
        key = (int(gr), int(gc))
        red_counts[key] = red_counts.get(key, 0) + 1
    # Paint non-overlapping pixels
    paint_mask = cur_vals == 0
    out[g_rows[paint_mask], g_cols[paint_mask]] = vals[paint_mask]
    return red_counts


def _assemble(nodes, h, w):
    """Render all nodes, shift into grid, and validate the assembled output."""
    for node in nodes:
        node["arr"] = _make_anchor(node) if node["kind"] == "anchor" else _make_piece(node)
        if node["arr"] is None:
            return None

    r0, c0, r1, c1 = _union_bbox(nodes)
    if (r1 - r0 + 1) > h or (c1 - c0 + 1) > w:
        return None
    sr = random.randint(-r0, h - 1 - r1)
    sc = random.randint(-c0, w - 1 - c1)

    out = np.zeros((h, w), dtype=int)
    all_red_counts = {}
    for node in nodes:
        rc = _place_node_on_canvas(out, node, sr, sc)
        if rc is None:
            return None
        for k, v in rc.items():
            all_red_counts[k] = all_red_counts.get(k, 0) + v

    total_ports = sum(int(np.sum(n["arr"] == 2)) for n in nodes)
    if len(all_red_counts) * 2 != total_ports:
        return None
    if any(v != 2 for v in all_red_counts.values()):
        return None
    if len(components_mask(out != 0, connectivity=4)) != 1:
        return None
    return out


def _scatter(nodes, h, w):
    """Place anchor at its assembled position, then scatter remaining pieces."""
    inp = np.zeros((h, w), dtype=int)
    anchor = nodes[0]
    paste(inp, anchor["arr"], *anchor["pos"], transparent=0)
    rest = nodes[1:]
    random.shuffle(rest)
    for node in rest:
        try:
            r, c = random_free_location(
                inp, node["arr"], transparent=0,
                padding=SCATTER_PADDING, padding_connectivity=8)
        except ValueError:
            return None
        paste(inp, node["arr"], r, c, transparent=0)
    return inp


def _gen_attempt():
    h = random.randint(*GRID_H_RANGE)
    w = random.randint(*GRID_W_RANGE)
    nodes = _grow_tree()
    if nodes is None:
        return None
    out = _assemble(nodes, h, w)
    if out is None:
        return None
    inp = _scatter(nodes, h, w)
    if inp is None:
        return None
    try:
        solved = main(inp)
    except Exception:
        return None
    if np.array_equal(solved, out):
        return inp
    return None


def generate_input() -> np.ndarray:
    for _ in range(GEN_RETRY_LIMIT):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid cbebaa4b input")

    ```

    ## 原始任务规格（Spec）

    以下是从原始 solver 代码和示例中提炼的完整任务规格，包含精确的数值约束和生成策略。
    Spec 本身就是原题代码生成时的参考文件，因此：
    - 在**设计分析**阶段，参考 spec 理解原始任务的完整设计细节（对象结构、空间关系、生成策略等），以此为基础思考融合变体的改动如何落实
    - 在**实现**阶段，参考 spec 中的数值约束（网格尺寸、对象数量/尺寸、颜色数等），确保融合变体在物理上可实现

    ```yaml
    spec:
  grid: 22-26 rows x 22-26 cols, bg=black(0), same for input and output
  anchor:
    solid_yellow_block: 3x3 or 4x5 rectangle of color 4
    red_connectors: 2-4 red(2) pixels protruding from block edges, each exposed to bg
    stays_in_place: anchor position is unchanged between input and output
  pieces:
    count: 4-6 non-anchor sprites, each a single 4-connected component
    main_color: each piece uses one non-red color from {1,3,5,6,7,8,9}; colors may repeat across pieces
    shape: open frame / U / C / L / bar / bracket; bbox 2-7 rows x 1-8 cols
    red_connectors: 1-5 red(2) pixels on sprite boundary (exposed to bg on >= 1 side)
    reds_per_piece: equals 2 * degree in connection tree (leaf=2 reds, internal=4 reds, hub=5-6)
  connection_tree:
    topology: all sprites (anchor + pieces) form a tree with N-1 edges for N nodes
    edge_weight: each edge joins 2 sprites by overlapping exactly 2 red pixels (rarely 1)
    pairing: every red pixel pairs with exactly one red from another sprite; total_reds is even
    uniqueness: the complete assembly (piece-to-piece connection mapping) must be the unique valid solution — no alternative pairing of red connectors can produce a different valid assembly
  assembly:
    rule: translate each piece (no rotation) so its red connectors overlap matching reds on the growing assembly
    overlap: only red pixels may overlap between sprites; non-red pixels never conflict
    output: single 4-connected assembled structure on otherwise empty grid
  input_layout:
    sprites_scattered: all sprites placed non-overlapping with >= 2 Chebyshev gap between any pair
    grid_large_enough: grid must fit both scattered input and assembled output

generation_strategy:
  approach: output-first (build assembled jigsaw, then scatter to get input)
  steps:
    1. Choose grid size 22-26.
    2. Design anchor (3x3 yellow block + 2-4 red connectors on distinct edges).
    3. Build connection tree with 4-6 piece nodes; assign each node a degree (leaves=1, internal=2+).
    4. For each piece, design a frame/bracket sprite with reds = 2 * degree, placed on appropriate edges to match its tree neighbors.
    5. Assemble all pieces onto the anchor by aligning red connector pairs; verify no non-red overlap and assembly fits in grid.
    6. Record each piece's assembled position; this is the output.
    7. Scatter pieces to random non-overlapping positions (>= 2 gap) on the grid to produce the input. Anchor keeps its assembled position.
    ```

额外要求：原始代码的 `main()` 已包含四段式说明注释/文档字符串（开头概述 + `Input structure:` + `Rule:` + `Key insight:`）。
生成的新代码里也必须在 `main()` 上方保留这一结构，并根据**融合后的新规则**与**原注释提供的信息**重新编写；可以借鉴原注释的组织方式，但**不要照抄原文**，要让内容准确反映融合后的输入结构、规则和关键洞察。


## 已有单变体参考代码

以下组成项已有单变体实现，可作为融合时的参考：

            ### 参考代码: D3/1

            文件: `/home/lixinyu/snap/new/ceshi/code/cbebaa4b/D3/1/code.py`

            ```python
            # Variant of cbebaa4b
# Dimension: D3 — 目标锚点的结构 (dst)
# Change: 中央黄色方块作为初始锚点，已连接的精灵作为后续连接的扩展锚点... → 无固定锚点——从精灵中推断起始点

from __future__ import annotations

import random

import numpy as np

from arc_utils import bbox_coords, components_mask, paste, random_free_location


# Design analysis for the D3 variant
# ==================================
# a) Concrete behavior and trace
#    - Original task: exactly one component contains a yellow block. That component is
#      visibly special and is copied into the output without moving. Other components
#      are translated so that red connector pixels overlap red connector pixels from
#      the growing assembly.
#    - Variant: remove the yellow block entirely. Every component is now a normal
#      colored sprite. The stationary starting sprite is inferred from a visible
#      property: it is the unique largest sprite by filled-cell area.
#    - Concrete example:
#      input has five scattered sprites, all without yellow. One large teal bracket
#      occupies 31 non-black cells at rows 11-19 / cols 8-16. Four smaller sprites
#      occupy 9-18 cells each. In the original logic the solver would look for color 4
#      and fail immediately. In the variant, the solver first identifies the 31-cell
#      bracket as the only legal seed, keeps it at its input coordinates, and then
#      attaches the smaller sprites by overlapping red connector pairs until all reds
#      are paired exactly twice.
#    - The pipeline impact is localized:
#      input construction: generator must no longer build a yellow anchor; instead it
#      must guarantee one ordinary sprite is visibly largest.
#      solver seed selection: replace "find yellow piece" with "find unique max-area
#      piece".
#      output generation: unchanged assembly rule after the seed is chosen.
#
# b) Complexity calibration
#    - If "largest" were only larger by one cell, humans could miss it and the solver
#      could face ambiguous seeds on accidental ties. The generator therefore makes the
#      seed substantially larger than the others: larger bbox ranges, no dropped
#      decorative bars, and a required positive area margin over every other sprite.
#    - The red-connector tree and no-rotation assembly are preserved, so the puzzle is
#      still the same jigsaw-style reasoning task rather than a new matching problem.
#
# c) Hidden assumptions in the original main()
#    - pieces = _extract_pieces(...): still valid; components are still separated by
#      black background in the input.
#    - anchors = [p for p in pieces if np.any(p["arr"] == 4)]: invalid, because the
#      variant removes the yellow anchor entirely.
#    - anchor position is used as the fixed seed placement. This remains necessary,
#      but the seed is now selected by visible area rather than by color membership.
#    - red-count DFS only assumes one stationary seed plus pairwise red overlaps. That
#      assumption still holds, so the backtracking body can stay almost unchanged.
#    - The old solver relied on the anchor being unique by color. The new solver relies
#      on the generator guaranteeing a unique largest area. The generator therefore
#      validates that property after rendering, not just from bbox sizes.
#
# d) Placement legality
#    - As in the original task, the generator builds the final connected assembly first
#      and only then scatters sprites. This guarantees that the intended output is
#      geometrically valid.
#    - Only red-over-red overlaps are allowed in the assembled output. Non-red pixels
#      must never conflict. The same checks are kept in _try_place() and _assemble().
#    - The seed sprite remains at its assembled coordinates in the input, while all
#      other sprites are scattered with Chebyshev padding >= 2, so _extract_pieces()
#      still recovers the original components cleanly.
#
# e) Visual observability
#    - The rule must be inferable from 2-4 examples. A unique largest sprite is a
#      visible cue; color id is not used.
#    - Yellow is removed completely so the difference from the source task is obvious.
#    - The seed is not chosen by invisible metadata such as node index or random order.
#
# f) Visual cleanliness
#    - Sprites remain single 4-connected components with the same frame/path style as
#      the source task, so the output still reads as a clean assembled structure.
#    - Because only one sprite stays in place and the others are scattered with padding,
#      the input is not visually cluttered.
#
# g) Color-change inference
#    - No color remapping is introduced. Colors are only used to paint sprites, not to
#      rank them. This keeps the D3 change focused on anchor inference rather than on a
#      new color rule.
#
# h) Variant behavior metric used after implementation
#    - Metric 1: fraction of generated samples with zero yellow cells in the input.
#      This should be 100%.
#    - Metric 2: root area margin = largest component area - second-largest component
#      area. This should stay comfortably positive in generated samples.
#    - Metric 3: the original solver should reject these samples because it expects a
#      yellow anchor, while the new solver should succeed.
#
# i) New assumptions introduced by the variant and how the generator guarantees them
#    - main() assumes exactly one component has strictly maximal filled area.
#      _assemble() enforces that after rendering every node.
#    - main() assumes the maximal-area component is the stationary seed in the input.
#      _scatter() preserves nodes[0] at its assembled coordinates.
#    - main() assumes the rest of the puzzle still has a unique red-pairing assembly.
#      _gen_attempt() verifies this by requiring main(input) == assembled_output.


def _extract_pieces(g: np.ndarray, bg: int) -> list[dict]:
    comps = components_mask(g != bg, connectivity=4)
    pieces = []
    for pts in comps:
        r0, c0, r1, c1 = bbox_coords(pts)
        arr = g[r0 : r1 + 1, c0 : c1 + 1].copy()
        reds = np.argwhere(arr == 2)
        pieces.append(
            {
                "bbox": (int(r0), int(c0), int(r1), int(c1)),
                "arr": arr,
                "reds": [(int(r), int(c)) for r, c in reds],
                "shape": (int(arr.shape[0]), int(arr.shape[1])),
                "area": int(np.sum(arr != bg)),
            }
        )
    return pieces


def _try_place(
    canvas: np.ndarray, arr: np.ndarray, top: int, left: int, bg: int
) -> np.ndarray | None:
    h, w = canvas.shape
    ph, pw = arr.shape
    if top < 0 or left < 0 or top + ph > h or left + pw > w:
        return None

    sub = canvas[top : top + ph, left : left + pw]
    mask = arr != bg
    if not np.any(mask):
        return None

    conflict = mask & (sub != bg) & ~(((arr == 2) & (sub == 2)) | (arr == sub))
    if np.any(conflict):
        return None

    out = canvas.copy()
    out_sub = out[top : top + ph, left : left + pw]
    out_sub[mask] = arr[mask]
    out[top : top + ph, left : left + pw] = out_sub
    return out


def _select_seed_piece(pieces: list[dict]) -> tuple[dict, list[dict]]:
    max_area = max(p["area"] for p in pieces)
    seeds = [p for p in pieces if p["area"] == max_area]
    assert len(seeds) == 1, "input must have exactly one largest piece"
    seed = seeds[0]
    rest = [p for p in pieces if p is not seed]
    return seed, rest


def main(grid: np.ndarray) -> np.ndarray:
    """
    Assemble scattered jigsaw sprites by inferring which ordinary sprite is the stationary seed.

    Input structure:
    - bg = black (0). Several colored sprites are scattered on the grid.
    - There is no dedicated yellow anchor block; every sprite is an ordinary colored component.
    - Each sprite carries red (2) connector pixels on its boundary, and exactly one sprite has the largest filled area.

    Rule:
    - The unique largest sprite is the starting sprite and stays at its input position.
    - Every other sprite is translated, without rotation, so that one or more of its red pixels overlap currently unpaired red pixels in the growing assembly.
    - Every red connector must end up paired exactly once with another red connector, producing one complete connected structure.

    Key insight: First infer the seed from visible size rather than color, then solve the rest exactly like a red-connector jigsaw where every red pixel must be matched in pairs.
    """
    g = np.asarray(grid, dtype=int)
    h, w = g.shape
    bg = 0

    pieces = _extract_pieces(g, bg)
    assert pieces, "input must have at least one colored piece"

    seed, rest = _select_seed_piece(pieces)

    canvas = np.full((h, w), bg, dtype=int)
    sr0, sc0, _, _ = seed["bbox"]
    placed = _try_place(canvas, seed["arr"], sr0, sc0, bg)
    assert placed is not None, "seed piece must fit on canvas at its original position"

    total_ports = int(sum(len(p["reds"]) for p in pieces))
    assert total_ports % 2 == 0, "total red connector ports must be even for complete pairing"
    target_unique_red = total_ports // 2

    red_counts: dict[tuple[int, int], int] = {}
    for rr, cc in seed["reds"]:
        red_counts[(sr0 + rr, sc0 + cc)] = red_counts.get((sr0 + rr, sc0 + cc), 0) + 1

    solutions: list[np.ndarray] = []

    def dfs(cur: np.ndarray, remaining: list[dict], rc: dict[tuple[int, int], int]) -> None:
        if len(solutions) >= 2:
            return

        if not remaining:
            if len(rc) == target_unique_red and all(v == 2 for v in rc.values()):
                solutions.append(cur)
            return

        if len(rc) > target_unique_red:
            return

        unpaired = [k for k, v in rc.items() if v == 1]
        if not unpaired:
            return

        rc1 = {k for k, v in rc.items() if v == 1}

        best_moves = None
        for t in unpaired:
            moves = []
            tr, tc = t
            for idx, p in enumerate(remaining):
                ph, pw = p["shape"]
                for pr, pc in p["reds"]:
                    top = tr - pr
                    left = tc - pc
                    if top < 0 or left < 0 or top + ph > h or left + pw > w:
                        continue
                    bad = False
                    overlap = 0
                    for rr, cc in p["reds"]:
                        gr, gc = top + rr, left + cc
                        prev = rc.get((gr, gc), 0)
                        if prev >= 2:
                            bad = True
                            break
                        if (gr, gc) in rc1:
                            overlap += 1
                    if bad:
                        continue
                    moves.append((idx, top, left, overlap))
            if not moves:
                return
            if best_moves is None or len(moves) < len(best_moves):
                best_moves = moves
                if len(best_moves) == 1:
                    break

        assert best_moves is not None, "there must be at least one feasible connector move"

        dedup: dict[tuple[int, int, int], int] = {}
        for idx, top, left, ov in best_moves:
            key = (idx, top, left)
            dedup[key] = max(dedup.get(key, 0), ov)
        moves2 = [(idx, top, left, ov) for (idx, top, left), ov in dedup.items()]
        moves2.sort(key=lambda x: (-x[3], -remaining[x[0]]["area"], x[1], x[2], x[0]))

        for idx, top, left, _ov in moves2:
            p = remaining[idx]
            next_remaining = remaining[:idx] + remaining[idx + 1 :]

            next_rc = dict(rc)
            for rr, cc in p["reds"]:
                gr, gc = top + rr, left + cc
                next_rc[(gr, gc)] = next_rc.get((gr, gc), 0) + 1

            nxt = _try_place(cur, p["arr"], top, left, bg)
            if nxt is None:
                continue
            dfs(nxt, next_remaining, next_rc)
            if len(solutions) >= 2:
                return

    dfs(placed, rest, red_counts)
    assert len(solutions) == 1, "jigsaw assembly must have exactly one valid solution"
    return solutions[0]


# --------------- generator (o5x) ---------------

# ── Tunable configuration ──────────────────────────────────────────────
# Canvas
GRID_H_RANGE = (22, 26)
GRID_W_RANGE = (22, 26)
MAX_ASSEMBLY_DIM = 24

# Pieces
PIECE_COUNT_RANGE = (4, 6)             # number of non-seed sprites
PIECE_H_RANGE = (4, 7)
PIECE_W_RANGE = (4, 8)
PIECE_DIM_CANDIDATES = 12
PIECE_COLORS = [1, 3, 5, 6, 7, 8, 9]
PIECE_CAP = 2
BAR_SKIP_PROB = 0.35

# Seed piece
ROOT_H_RANGE = (8, 10)
ROOT_W_RANGE = (8, 10)
ROOT_CAP_CHOICES = [1, 2]
ROOT_BAR_SKIP_PROB = 0.0
ROOT_AREA_MARGIN = 8

# Scatter
SCATTER_PADDING = 2

# Generation
GEN_RETRY_LIMIT = 300

# ── Side geometry lookups ──────────────────────────────────────────────
SIDES = ("top", "right", "bottom", "left")
OPPOSITE = {"top": "bottom", "bottom": "top", "left": "right", "right": "left"}
INWARD = {"top": (1, 0), "bottom": (-1, 0), "left": (0, 1), "right": (0, -1)}


def _new_node(kind, h, w, color, top=0, left=0, cap=PIECE_CAP, bar_skip_prob=BAR_SKIP_PROB):
    return {
        "kind": kind,
        "shape": (int(h), int(w)),
        "color": int(color),
        "top": int(top),
        "left": int(left),
        "cap": int(cap),
        "bar_skip_prob": float(bar_skip_prob),
        "sides": set(),
        "ports": {},
    }


def _ensure_port(node, side):
    if side in node["ports"]:
        return
    h, w = node["shape"]
    span = h if side in ("left", "right") else w
    node["ports"][side] = random.randint(1, span - 3)


def _port_cells(node, side):
    h, w = node["shape"]
    k = node["ports"][side]
    if side == "top":
        return [(0, k), (0, k + 1)]
    if side == "bottom":
        return [(h - 1, k), (h - 1, k + 1)]
    if side == "left":
        return [(k, 0), (k + 1, 0)]
    return [(k, w - 1), (k + 1, w - 1)]


def _global_port(node, side):
    tr, tc = node["top"], node["left"]
    return [(tr + r, tc + c) for r, c in _port_cells(node, side)]


def _bbox_of(node):
    h, w = node["shape"]
    return (node["top"], node["left"], node["top"] + h - 1, node["left"] + w - 1)


def _rects_overlap(a, b):
    return not (a[2] < b[0] or b[2] < a[0] or a[3] < b[1] or b[3] < a[1])


def _union_bbox(nodes):
    boxes = [_bbox_of(n) for n in nodes]
    return (
        min(b[0] for b in boxes),
        min(b[1] for b in boxes),
        max(b[2] for b in boxes),
        max(b[3] for b in boxes),
    )


def _draw_path(arr, start, end, color, order):
    r, c = start
    er, ec = end
    axes = (
        [(r, er, c, True), (c, ec, er, False)]
        if order == 0
        else [(c, ec, r, False), (r, er, ec, True)]
    )
    for a_start, a_end, fixed, is_row in axes:
        step = 1 if a_end >= a_start else -1
        for v in range(a_start, a_end + step, step):
            rr, cc = (v, fixed) if is_row else (fixed, v)
            if arr[rr, cc] != 2:
                arr[rr, cc] = color


def _paint_bar(arr, side, color, used):
    h, w = arr.shape
    is_horizontal = side in ("top", "bottom")
    fixed = 0 if side in ("top", "left") else (h - 1 if side == "bottom" else w - 1)
    span = w if is_horizontal else h
    lo_conflict = "left" if is_horizontal else "top"
    hi_conflict = "right" if is_horizontal else "bottom"
    for i in range(span):
        if (i == 0 and lo_conflict in used) or (i == span - 1 and hi_conflict in used):
            continue
        if is_horizontal:
            arr[fixed, i] = color
        else:
            arr[i, fixed] = color


def _bar_endpoint(shape, side, hub):
    h, w = shape
    hr, hc = hub
    if side in ("top", "bottom"):
        row = 0 if side == "top" else h - 1
        return (row, min(max(hc, 1), w - 2))
    col = 0 if side == "left" else w - 1
    return (min(max(hr, 1), h - 2), col)


def _make_piece(node):
    h, w = node["shape"]
    color = node["color"]
    used = set(node["sides"])
    arr = np.zeros((h, w), dtype=int)
    hub = (random.randint(1, h - 2), random.randint(1, w - 2))

    bar_sides = [s for s in SIDES if s not in used]
    if len(bar_sides) > 1 and random.random() < node["bar_skip_prob"]:
        bar_sides.remove(random.choice(bar_sides))
    for side in bar_sides:
        _paint_bar(arr, side, color, used)

    terminals = []
    for side in used:
        dr, dc = INWARD[side]
        for r, c in _port_cells(node, side):
            arr[r, c] = 2
            rr, cc = r + dr, c + dc
            arr[rr, cc] = color
            terminals.append((rr, cc))

    arr[hub] = color
    order = random.randint(0, 1)
    for t in terminals:
        _draw_path(arr, t, hub, color, order)
    for side in bar_sides:
        _draw_path(arr, hub, _bar_endpoint((h, w), side, hub), color, 1 - order)

    if len(components_mask(arr != 0, connectivity=4)) != 1:
        return None
    if int(np.sum(arr == 2)) != 2 * len(used):
        return None
    return arr


def _candidate_fits(nodes, parent_i, child):
    cb = _bbox_of(child)
    if not _rects_overlap(cb, _bbox_of(nodes[parent_i])):
        return False
    for i, other in enumerate(nodes):
        if i == parent_i:
            continue
        if _rects_overlap(cb, _bbox_of(other)):
            return False
    r0, c0, r1, c1 = _union_bbox(nodes + [child])
    return (r1 - r0 + 1) <= MAX_ASSEMBLY_DIM and (c1 - c0 + 1) <= MAX_ASSEMBLY_DIM


def _grow_tree():
    n_pieces = random.randint(*PIECE_COUNT_RANGE)
    colors = random.sample(PIECE_COLORS, n_pieces + 1)
    root = _new_node(
        "root",
        random.randint(*ROOT_H_RANGE),
        random.randint(*ROOT_W_RANGE),
        colors[0],
        cap=random.choice(ROOT_CAP_CHOICES),
        bar_skip_prob=ROOT_BAR_SKIP_PROB,
    )
    nodes = [root]

    for i in range(n_pieces):
        placed = False
        dims = [
            (random.randint(*PIECE_H_RANGE), random.randint(*PIECE_W_RANGE))
            for _ in range(PIECE_DIM_CANDIDATES)
        ]
        random.shuffle(dims)
        for ph, pw in dims:
            parents = [j for j, n in enumerate(nodes) if len(n["sides"]) < n["cap"]]
            random.shuffle(parents)
            for parent_i in parents:
                parent = nodes[parent_i]
                sides = [s for s in SIDES if s not in parent["sides"]]
                random.shuffle(sides)
                for side in sides:
                    child = _new_node("piece", ph, pw, colors[i + 1])
                    incoming = OPPOSITE[side]
                    _ensure_port(parent, side)
                    _ensure_port(child, incoming)
                    pr, pc = _global_port(parent, side)[0]
                    cr, cc = _port_cells(child, incoming)[0]
                    child["top"] = pr - cr
                    child["left"] = pc - cc
                    child["sides"].add(incoming)
                    if not _candidate_fits(nodes, parent_i, child):
                        continue
                    parent["sides"].add(side)
                    nodes.append(child)
                    placed = True
                    break
                if placed:
                    break
            if placed:
                break
        if not placed:
            return None
    return nodes


def _place_node_on_canvas(out, node, sr, sc):
    arr = node["arr"]
    top, left = node["top"] + sr, node["left"] + sc
    node["pos"] = (top, left)
    red_counts = {}
    mask = arr != 0
    rows, cols = np.nonzero(mask)
    g_rows, g_cols = rows + top, cols + left
    vals = arr[rows, cols]
    cur_vals = out[g_rows, g_cols]
    conflicts = (cur_vals != 0) & ~((cur_vals == 2) & (vals == 2))
    if np.any(conflicts):
        return None
    red_mask = vals == 2
    for gr, gc in zip(g_rows[red_mask], g_cols[red_mask]):
        key = (int(gr), int(gc))
        red_counts[key] = red_counts.get(key, 0) + 1
    paint_mask = cur_vals == 0
    out[g_rows[paint_mask], g_cols[paint_mask]] = vals[paint_mask]
    return red_counts


def _assembled_areas(nodes):
    return [int(np.sum(node["arr"] != 0)) for node in nodes]


def _assemble(nodes, h, w):
    for node in nodes:
        node["arr"] = _make_piece(node)
        if node["arr"] is None:
            return None

    areas = _assembled_areas(nodes)
    if len(areas) < 2:
        return None
    root_area = areas[0]
    max_other = max(areas[1:])
    if root_area != max(areas) or areas.count(root_area) != 1:
        return None
    if root_area - max_other < ROOT_AREA_MARGIN:
        return None

    r0, c0, r1, c1 = _union_bbox(nodes)
    if (r1 - r0 + 1) > h or (c1 - c0 + 1) > w:
        return None
    sr = random.randint(-r0, h - 1 - r1)
    sc = random.randint(-c0, w - 1 - c1)

    out = np.zeros((h, w), dtype=int)
    all_red_counts = {}
    for node in nodes:
        rc = _place_node_on_canvas(out, node, sr, sc)
        if rc is None:
            return None
        for key, value in rc.items():
            all_red_counts[key] = all_red_counts.get(key, 0) + value

    total_ports = sum(int(np.sum(n["arr"] == 2)) for n in nodes)
    if len(all_red_counts) * 2 != total_ports:
        return None
    if any(v != 2 for v in all_red_counts.values()):
        return None
    if len(components_mask(out != 0, connectivity=4)) != 1:
        return None
    if np.any(out == 4):
        return None
    return out


def _scatter(nodes, h, w):
    inp = np.zeros((h, w), dtype=int)
    root = nodes[0]
    paste(inp, root["arr"], *root["pos"], transparent=0)
    rest = nodes[1:]
    random.shuffle(rest)
    for node in rest:
        try:
            r, c = random_free_location(
                inp,
                node["arr"],
                transparent=0,
                padding=SCATTER_PADDING,
                padding_connectivity=8,
            )
        except ValueError:
            return None
        paste(inp, node["arr"], r, c, transparent=0)
    return inp


def _gen_attempt():
    h = random.randint(*GRID_H_RANGE)
    w = random.randint(*GRID_W_RANGE)
    nodes = _grow_tree()
    if nodes is None:
        return None
    out = _assemble(nodes, h, w)
    if out is None:
        return None
    inp = _scatter(nodes, h, w)
    if inp is None:
        return None
    try:
        solved = main(inp)
    except Exception:
        return None
    if np.array_equal(solved, out):
        return inp
    return None


def generate_input() -> np.ndarray:
    for _ in range(GEN_RETRY_LIMIT):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid cbebaa4b D3 input")

            ```

            ### 参考代码: D12/0

            文件: `/home/lixinyu/snap/new/ceshi/code/cbebaa4b/D12/0/code.py`

            ```python
            # Variant of cbebaa4b
# Dimension: D12 — 精灵主体颜色的多样性 (meta)
# Change: 每个精灵有自己的主体颜色，不同精灵颜色可能不同... → 所有精灵同色
#
# Design analysis for the D12 variant
# ==================================
# a) Concrete behavior and trace
# - Visual form: the yellow anchor stays unique, red pixels still mark the only legal
#   overlaps, and every non-anchor sprite now uses the same body color. I fix that body
#   color to blue(1) so the variant is visible in every sample instead of only within a
#   single sample.
# - Input/output effect: compared with the source task, the scattered input no longer
#   uses color diversity to separate pieces. The output still assembles the same tree by
#   translation only, but the human solver must distinguish pieces by bbox geometry and
#   red-port placement alone.
# - Local trace at the critical step:
#   original: when `_try_place` tests a candidate translation, two non-red pixels of the
#   same color may overlap because `arr == sub` is accepted; with mostly distinct piece
#   colors this is usually harmless.
#   variant: if every piece is blue, that same rule would let unrelated blue bars merge
#   and create false placements. The correct behavior is stricter: only red-on-red
#   overlap may survive; every other occupied/occupied collision is illegal.
#   difference: the solver's geometric legality check, not the search strategy, must be
#   updated.
# b) Complexity calibration
# - The search problem stays nontrivial because all pieces share one color, yet the
#   generator keeps varied bbox sizes, connector sides, and internal path layouts.
# - I do not add new transformation freedom such as rotation or reflection; otherwise the
#   removal of color cues plus extra motion freedom would over-expand ambiguity.
# - Uniqueness is still enforced by the existing backtracking assertion, so degenerate
#   same-shape/same-port sets are rejected during generation.
# c) Hidden-assumption audit
# - `_extract_pieces` only depends on non-black connected components: still valid.
# - Anchor detection relies on yellow(4): still valid because only non-anchor body colors
#   changed.
# - `total_ports`, red-count bookkeeping, and DFS branching depend only on red pixels and
#   translation: still valid.
# - `_try_place` previously depended on the soft assumption that equal non-red colors from
#   different pieces would almost never meet. That assumption is false in this variant, so
#   the conflict predicate must reject every non-red overlap.
# d) Placement legality
# - The generator still constructs the assembled target first and only scatters after the
#   assembled grid has passed a strict non-red-overlap check.
# - Tree growth and scatter padding remain unchanged, so pieces stay in-bounds, pairwise
#   separated in the input, and solver-compatible.
# e) Visual observability
# - The intended visual signature of the variant is immediate: every movable sprite is
#   blue in both input and output, while only the anchor is yellow and connectors are red.
# - No invisible ordering rule uses color ids; the solver logic depends only on geometry
#   and connector coordinates.
# f) Visual cleanliness
# - The assembled output still contains only one overlap type: paired red ports. Because
#   non-red overlap is now forbidden in the solver too, no muddy blue-on-blue fusion can
#   appear.
# g) Color-change inferability
# - The color change rule is minimal and global: "all non-anchor sprites share one body
#   color." There is no per-piece or per-position recoloring to infer.
# h) New solver assumptions introduced here
# - The revised solver assumes every valid assembled grid has no non-red overlaps at all.
#   `_assemble` in the generator already guarantees that via `_place_node_on_canvas`.
# - It also assumes the yellow anchor remains the unique component containing color 4; the
#   generator preserves that exactly.

import numpy as np

from arc_utils import bbox_coords, components_mask, paste, random_free_location
import random


def _extract_pieces(g: np.ndarray, bg: int) -> list[dict]:
    comps = components_mask(g != bg, connectivity=4)
    pieces = []
    for pts in comps:
        r0, c0, r1, c1 = bbox_coords(pts)
        arr = g[r0 : r1 + 1, c0 : c1 + 1].copy()
        reds = np.argwhere(arr == 2)
        pieces.append(
            {
                "bbox": (int(r0), int(c0), int(r1), int(c1)),
                "arr": arr,
                "reds": [(int(r), int(c)) for r, c in reds],
                "shape": (int(arr.shape[0]), int(arr.shape[1])),
                "area": int(np.sum(arr != bg)),
            }
        )
    return pieces


def _try_place(
    canvas: np.ndarray, arr: np.ndarray, top: int, left: int, bg: int
) -> np.ndarray | None:
    h, w = canvas.shape
    ph, pw = arr.shape
    if top < 0 or left < 0 or top + ph > h or left + pw > w:
        return None

    sub = canvas[top : top + ph, left : left + pw]
    mask = arr != bg
    if not np.any(mask):
        return None

    # In the single-body-color variant, equal non-red colors from different pieces must
    # still be treated as a collision. Only red connector pixels may overlap.
    conflict = mask & (sub != bg) & ~((arr == 2) & (sub == 2))
    if np.any(conflict):
        return None

    out = canvas.copy()
    out_sub = out[top : top + ph, left : left + pw]
    out_sub[mask] = arr[mask]
    out[top : top + ph, left : left + pw] = out_sub
    return out


def main(grid: np.ndarray) -> np.ndarray:
    """
    Rebuild a monochrome set of scattered sprites around the fixed yellow anchor by pairing red connector pixels.

    Input structure:
    - bg = black (0). Several disconnected sprites are scattered on the grid.
    - Exactly one sprite is the anchor: it contains the yellow (4) core block and stays fixed.
    - Every non-anchor sprite uses the same body color, while red (2) edge pixels mark connector ports.

    Rule:
    - Keep the anchor at its input position and translate the other sprites only.
    - Attach sprites by making red ports coincide with currently unpaired red ports in the growing assembly.
    - Red-on-red overlap is the only allowed overlap; body-colored pixels may never cover any occupied cell.

    Key insight: Once body color stops distinguishing pieces, the puzzle is solved entirely by geometry: bbox shape, port placement, and the invariant that every red connector must be paired exactly once.
    """
    g = np.asarray(grid, dtype=int)
    h, w = g.shape
    bg = 0

    pieces = _extract_pieces(g, bg)
    assert pieces, "input must have at least one colored piece"

    # Anchor is the unique piece containing the yellow (color 4) core block.
    anchors = [p for p in pieces if np.any(p["arr"] == 4)]
    assert len(anchors) == 1, "input must have exactly one yellow (4) anchor piece"
    anchor = anchors[0]
    rest = [p for p in pieces if p is not anchor]

    canvas = np.full((h, w), bg, dtype=int)
    ar0, ac0, _, _ = anchor["bbox"]
    placed = _try_place(canvas, anchor["arr"], ar0, ac0, bg)
    assert placed is not None, "anchor piece must fit on canvas at its original position"

    total_ports = int(sum(len(p["reds"]) for p in pieces))
    assert total_ports % 2 == 0, "total red connector ports must be even for complete pairing"
    target_unique_red = total_ports // 2

    # Track how many original red pixels map to each assembled red coordinate.
    red_counts: dict[tuple[int, int], int] = {}
    for rr, cc in anchor["reds"]:
        red_counts[(ar0 + rr, ac0 + cc)] = red_counts.get((ar0 + rr, ac0 + cc), 0) + 1

    # Backtracking assembly by pairing up red connector pixels.
    solutions: list[np.ndarray] = []

    def dfs(cur: np.ndarray, remaining: list[dict], rc: dict[tuple[int, int], int]) -> None:
        if len(solutions) >= 2:
            return

        if not remaining:
            if len(rc) == target_unique_red and all(v == 2 for v in rc.values()):
                solutions.append(cur)
            return

        if len(rc) > target_unique_red:
            return

        # Unpaired reds are exactly those with count==1; always pair one of them next.
        unpaired = [k for k, v in rc.items() if v == 1]
        if not unpaired:
            return

        rc1 = {k for k, v in rc.items() if v == 1}

        # Pick the most constrained unpaired red coordinate: fewest ways to cover it.
        best_moves = None
        for t in unpaired:
            moves = []
            tr, tc = t
            for idx, p in enumerate(remaining):
                ph, pw = p["shape"]
                for pr, pc in p["reds"]:
                    top = tr - pr
                    left = tc - pc
                    if top < 0 or left < 0 or top + ph > h or left + pw > w:
                        continue
                    # quick red-count feasibility
                    bad = False
                    overlap = 0
                    for rr, cc in p["reds"]:
                        gr, gc = top + rr, left + cc
                        prev = rc.get((gr, gc), 0)
                        if prev >= 2:
                            bad = True
                            break
                        if (gr, gc) in rc1:
                            overlap += 1
                    if bad:
                        continue
                    # must overlap at least the target (guaranteed), but keep for scoring
                    moves.append((idx, top, left, overlap))
            if not moves:
                return
            if best_moves is None or len(moves) < len(best_moves):
                best_moves = moves
                if len(best_moves) == 1:
                    break

        assert best_moves is not None, "there must be at least one feasible connector move"

        # Deduplicate moves by (piece, top, left) keeping max overlap score.
        dedup: dict[tuple[int, int, int], int] = {}
        for idx, top, left, ov in best_moves:
            k = (idx, top, left)
            dedup[k] = max(dedup.get(k, 0), ov)
        moves2 = [(idx, top, left, ov) for (idx, top, left), ov in dedup.items()]
        moves2.sort(key=lambda x: (-x[3], -remaining[x[0]]["area"], x[1], x[2], x[0]))

        for idx, top, left, _ov in moves2:
            p = remaining[idx]
            next_remaining = remaining[:idx] + remaining[idx + 1 :]

            next_rc = dict(rc)
            for rr, cc in p["reds"]:
                gr, gc = top + rr, left + cc
                next_rc[(gr, gc)] = next_rc.get((gr, gc), 0) + 1

            nxt = _try_place(cur, p["arr"], top, left, bg)
            if nxt is None:
                continue
            dfs(nxt, next_remaining, next_rc)
            if len(solutions) >= 2:
                return

    dfs(placed, rest, red_counts)
    assert len(solutions) == 1, "jigsaw assembly must have exactly one valid solution"
    return solutions[0]

# --------------- generator (o5x) ---------------

# ── Tunable configuration ──────────────────────────────────────────────
# Canvas
GRID_H_RANGE = (22, 26)               # output grid height bounds
GRID_W_RANGE = (22, 26)               # output grid width bounds
MAX_ASSEMBLY_DIM = 24                  # assembled jigsaw must fit inside this

# Pieces
PIECE_COUNT_RANGE = (4, 6)            # non-anchor sprite count
PIECE_H_RANGE = (4, 7)               # piece bbox height bounds
PIECE_W_RANGE = (4, 8)               # piece bbox width bounds
PIECE_DIM_CANDIDATES = 12            # random (h,w) trials per piece placement
COMMON_PIECE_COLOR = 1               # all non-anchor sprites are blue in this variant
PIECE_CAP = 2                         # max connections per piece node
BAR_SKIP_PROB = 0.35                  # probability of dropping one decorative bar

# Anchor
ANCHOR_BLOCK_CHOICES = [(3, 3), (4, 5)]  # yellow block (h, w) options
ANCHOR_CAP_CHOICES = [1, 2]              # max connections for anchor node

# Scatter
SCATTER_PADDING = 2                   # Chebyshev gap between scattered sprites

# Generation
GEN_RETRY_LIMIT = 300                 # max attempts before raising RuntimeError

# ── Side geometry lookups ──────────────────────────────────────────────
SIDES = ("top", "right", "bottom", "left")
OPPOSITE = {"top": "bottom", "bottom": "top", "left": "right", "right": "left"}
INWARD = {"top": (1, 0), "bottom": (-1, 0), "left": (0, 1), "right": (0, -1)}


def _new_node(kind, h, w, color, top=0, left=0, cap=PIECE_CAP):
    return {
        "kind": kind, "shape": (int(h), int(w)), "color": int(color),
        "top": int(top), "left": int(left), "cap": int(cap),
        "sides": set(), "ports": {},
    }


def _ensure_port(node, side):
    """Lazily assign a random port offset for *side* if not already set."""
    if side in node["ports"]:
        return
    h, w = node["shape"]
    span = h if side in ("left", "right") else w
    node["ports"][side] = random.randint(1, span - 3)


def _port_cells(node, side):
    """Return the two local (r, c) cells that form the red connector on *side*."""
    h, w = node["shape"]
    k = node["ports"][side]
    if side == "top":
        return [(0, k), (0, k + 1)]
    if side == "bottom":
        return [(h - 1, k), (h - 1, k + 1)]
    if side == "left":
        return [(k, 0), (k + 1, 0)]
    return [(k, w - 1), (k + 1, w - 1)]


def _global_port(node, side):
    tr, tc = node["top"], node["left"]
    return [(tr + r, tc + c) for r, c in _port_cells(node, side)]


def _bbox_of(node):
    h, w = node["shape"]
    return (node["top"], node["left"], node["top"] + h - 1, node["left"] + w - 1)


def _rects_overlap(a, b):
    return not (a[2] < b[0] or b[2] < a[0] or a[3] < b[1] or b[3] < a[1])


def _union_bbox(nodes):
    boxes = [_bbox_of(n) for n in nodes]
    return (
        min(b[0] for b in boxes), min(b[1] for b in boxes),
        max(b[2] for b in boxes), max(b[3] for b in boxes),
    )


def _draw_path(arr, start, end, color, order):
    """Draw an L-shaped path from *start* to *end*, preserving red (2) pixels."""
    r, c = start
    er, ec = end
    # order 0: row-first then col; order 1: col-first then row
    axes = [(r, er, c, True), (c, ec, er, False)] if order == 0 else \
           [(c, ec, r, False), (r, er, ec, True)]
    for a_start, a_end, fixed, is_row in axes:
        step = 1 if a_end >= a_start else -1
        for v in range(a_start, a_end + step, step):
            rr, cc = (v, fixed) if is_row else (fixed, v)
            if arr[rr, cc] != 2:
                arr[rr, cc] = color


def _paint_bar(arr, side, color, used):
    """Paint a decorative bar along *side*, skipping corners claimed by *used* sides."""
    h, w = arr.shape
    is_horizontal = side in ("top", "bottom")
    fixed = 0 if side in ("top", "left") else (h - 1 if side == "bottom" else w - 1)
    span = w if is_horizontal else h
    # corner neighbors: (index, conflicting side) pairs
    lo_conflict = "left" if is_horizontal else "top"
    hi_conflict = "right" if is_horizontal else "bottom"
    for i in range(span):
        if (i == 0 and lo_conflict in used) or (i == span - 1 and hi_conflict in used):
            continue
        if is_horizontal:
            arr[fixed, i] = color
        else:
            arr[i, fixed] = color


def _bar_endpoint(shape, side, hub):
    h, w = shape
    hr, hc = hub
    if side in ("top", "bottom"):
        row = 0 if side == "top" else h - 1
        return (row, min(max(hc, 1), w - 2))
    col = 0 if side == "left" else w - 1
    return (min(max(hr, 1), h - 2), col)


def _make_piece(node):
    """Render a piece sprite array with red connectors and decorative bars."""
    h, w = node["shape"]
    color = node["color"]
    used = set(node["sides"])
    arr = np.zeros((h, w), dtype=int)
    hub = (random.randint(1, h - 2), random.randint(1, w - 2))

    bar_sides = [s for s in SIDES if s not in used]
    if len(bar_sides) > 1 and random.random() < BAR_SKIP_PROB:
        bar_sides.remove(random.choice(bar_sides))
    for side in bar_sides:
        _paint_bar(arr, side, color, used)

    terminals = []
    for side in used:
        dr, dc = INWARD[side]
        for r, c in _port_cells(node, side):
            arr[r, c] = 2
            rr, cc = r + dr, c + dc
            arr[rr, cc] = color
            terminals.append((rr, cc))

    arr[hub] = color
    order = random.randint(0, 1)
    for t in terminals:
        _draw_path(arr, t, hub, color, order)
    for side in bar_sides:
        _draw_path(arr, hub, _bar_endpoint((h, w), side, hub), color, 1 - order)

    if len(components_mask(arr != 0, connectivity=4)) != 1:
        return None
    if int(np.sum(arr == 2)) != 2 * len(used):
        return None
    return arr


def _make_anchor(node):
    bh, bw = node["block"]
    h, w = node["shape"]
    arr = np.zeros((h, w), dtype=int)
    arr[1 : 1 + bh, 1 : 1 + bw] = 4
    for side in node["sides"]:
        for r, c in _port_cells(node, side):
            arr[r, c] = 2
    return arr


def _candidate_fits(nodes, parent_i, child):
    """Check child overlaps only its parent and total assembly stays within bounds."""
    cb = _bbox_of(child)
    if not _rects_overlap(cb, _bbox_of(nodes[parent_i])):
        return False
    for i, other in enumerate(nodes):
        if i == parent_i:
            continue
        if _rects_overlap(cb, _bbox_of(other)):
            return False
    r0, c0, r1, c1 = _union_bbox(nodes + [child])
    return (r1 - r0 + 1) <= MAX_ASSEMBLY_DIM and (c1 - c0 + 1) <= MAX_ASSEMBLY_DIM


def _grow_tree():
    """Build a tree of connected nodes (1 anchor + N pieces) in local coordinates."""
    bh, bw = random.choice(ANCHOR_BLOCK_CHOICES)
    anchor = _new_node("anchor", bh + 2, bw + 2, 4, cap=random.choice(ANCHOR_CAP_CHOICES))
    anchor["block"] = (bh, bw)
    nodes = [anchor]
    n_pieces = random.randint(*PIECE_COUNT_RANGE)

    for i in range(n_pieces):
        placed = False
        dims = [(random.randint(*PIECE_H_RANGE), random.randint(*PIECE_W_RANGE))
                for _ in range(PIECE_DIM_CANDIDATES)]
        random.shuffle(dims)
        for ph, pw in dims:
            parents = [j for j, n in enumerate(nodes) if len(n["sides"]) < n["cap"]]
            random.shuffle(parents)
            for parent_i in parents:
                parent = nodes[parent_i]
                sides = [s for s in SIDES if s not in parent["sides"]]
                random.shuffle(sides)
                for side in sides:
                    child = _new_node("piece", ph, pw, COMMON_PIECE_COLOR)
                    incoming = OPPOSITE[side]
                    _ensure_port(parent, side)
                    _ensure_port(child, incoming)
                    pr, pc = _global_port(parent, side)[0]
                    cr, cc = _port_cells(child, incoming)[0]
                    child["top"] = pr - cr
                    child["left"] = pc - cc
                    child["sides"].add(incoming)
                    if not _candidate_fits(nodes, parent_i, child):
                        continue
                    parent["sides"].add(side)
                    nodes.append(child)
                    placed = True
                    break
                if placed:
                    break
            if placed:
                break
        if not placed:
            return None
    return nodes


def _place_node_on_canvas(out, node, sr, sc):
    """Stamp a single node's sprite onto *out*, tracking red overlaps.

    Returns red_counts dict on success, or None on conflict.
    """
    arr = node["arr"]
    top, left = node["top"] + sr, node["left"] + sc
    node["pos"] = (top, left)
    red_counts = {}
    mask = arr != 0
    rows, cols = np.nonzero(mask)
    g_rows, g_cols = rows + top, cols + left
    vals = arr[rows, cols]
    cur_vals = out[g_rows, g_cols]
    # Conflict: non-bg destination that isn't a red-on-red overlap
    conflicts = (cur_vals != 0) & ~((cur_vals == 2) & (vals == 2))
    if np.any(conflicts):
        return None
    # Track red overlap counts
    red_mask = vals == 2
    for gr, gc in zip(g_rows[red_mask], g_cols[red_mask]):
        key = (int(gr), int(gc))
        red_counts[key] = red_counts.get(key, 0) + 1
    # Paint non-overlapping pixels
    paint_mask = cur_vals == 0
    out[g_rows[paint_mask], g_cols[paint_mask]] = vals[paint_mask]
    return red_counts


def _assemble(nodes, h, w):
    """Render all nodes, shift into grid, and validate the assembled output."""
    for node in nodes:
        node["arr"] = _make_anchor(node) if node["kind"] == "anchor" else _make_piece(node)
        if node["arr"] is None:
            return None

    r0, c0, r1, c1 = _union_bbox(nodes)
    if (r1 - r0 + 1) > h or (c1 - c0 + 1) > w:
        return None
    sr = random.randint(-r0, h - 1 - r1)
    sc = random.randint(-c0, w - 1 - c1)

    out = np.zeros((h, w), dtype=int)
    all_red_counts = {}
    for node in nodes:
        rc = _place_node_on_canvas(out, node, sr, sc)
        if rc is None:
            return None
        for k, v in rc.items():
            all_red_counts[k] = all_red_counts.get(k, 0) + v

    total_ports = sum(int(np.sum(n["arr"] == 2)) for n in nodes)
    if len(all_red_counts) * 2 != total_ports:
        return None
    if any(v != 2 for v in all_red_counts.values()):
        return None
    if len(components_mask(out != 0, connectivity=4)) != 1:
        return None
    return out


def _scatter(nodes, h, w):
    """Place anchor at its assembled position, then scatter remaining pieces."""
    inp = np.zeros((h, w), dtype=int)
    anchor = nodes[0]
    paste(inp, anchor["arr"], *anchor["pos"], transparent=0)
    rest = nodes[1:]
    random.shuffle(rest)
    for node in rest:
        try:
            r, c = random_free_location(
                inp, node["arr"], transparent=0,
                padding=SCATTER_PADDING, padding_connectivity=8)
        except ValueError:
            return None
        paste(inp, node["arr"], r, c, transparent=0)
    return inp


def _gen_attempt():
    h = random.randint(*GRID_H_RANGE)
    w = random.randint(*GRID_W_RANGE)
    nodes = _grow_tree()
    if nodes is None:
        return None
    out = _assemble(nodes, h, w)
    if out is None:
        return None
    inp = _scatter(nodes, h, w)
    if inp is None:
        return None
    try:
        solved = main(inp)
    except Exception:
        return None
    if np.array_equal(solved, out):
        return inp
    return None


def generate_input() -> np.ndarray:
    for _ in range(GEN_RETRY_LIMIT):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid cbebaa4b input")

            ```

    ## 你的任务

    1. **理解原代码**: 弄清 `main()` 和 `generate_input()` 的逻辑。

    2. **阅读参考代码**（如有）: 上面列出的已有单变体代码是各组成项单独实现的版本，帮助你理解每项变更的实现方式。融合版本应综合参考但不能简单拼接。

    3. **设计分析（写代码前必须完成）**:

       综合「融合描述」和「各组成项详情」，将融合规则落实到代码层面。融合描述给出了整体的 input→output 规则，各组成项详情给出了每项改动的具体含义——两者结合才是完整的实现规格。如果上面提供了原始任务规格（Spec），请将其作为设计分析的重要参考——spec 详细描述了原始任务中各对象的结构、空间关系、生成策略等，理解这些细节有助于你准确判断融合改动的影响范围和实现方式。

       a) **具体化与行为追踪**: 融合后的变体在 ARC 的像素网格中具体长什么样？用一个具体小例子追踪：原始逻辑在每个被改动的环节是怎么执行的 → 融合后应该怎么执行的 → 二者的差异是什么。

