+# --------------- generator (o5x) ---------------
+
+# Canvas
+GRID_H_RANGE = (22, 26)
+GRID_W_RANGE = (22, 26)
+MAX_ASSEMBLY_DIM = 24
+
+# Pieces
+PIECE_COUNT_RANGE = (4, 6)
+PIECE_H_RANGE = (4, 7)
+PIECE_W_RANGE = (4, 8)
+PIECE_DIM_CANDIDATES = 12
+COMMON_PIECE_COLOR = 1
+PIECE_CAP = 2
+BAR_SKIP_PROB = 0.35
+
+# Root piece
+ROOT_H_RANGE = (8, 10)
+ROOT_W_RANGE = (8, 10)
+ROOT_CAP_CHOICES = [1, 2]
+ROOT_BAR_SKIP_PROB = 0.0
+ROOT_AREA_MARGIN = 8
+
+# Scatter
+SCATTER_PADDING = 2
+
+# Generation
