+    terminals = []
+    for side in used:
+        dr, dc = INWARD[side]
+        for r, c in _port_cells(node, side):
+            arr[r, c] = 2
+            rr, cc = r + dr, c + dc
+            arr[rr, cc] = color
+            terminals.append((rr, cc))
