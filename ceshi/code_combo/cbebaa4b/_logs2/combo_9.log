+        solved = main(inp)
+    except Exception:
+        return None
+    if np.array_equal(solved, out_cropped):
+        return inp
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRY_LIMIT):
