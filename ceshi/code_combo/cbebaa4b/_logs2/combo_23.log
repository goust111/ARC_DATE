                            if (gr, gc) in rc1:
                                overlap += 1
                        if bad:
                            continue
                        moves.append((idx, vidx, top, left, overlap))
            if not moves:
                return
            if best_moves is None or len(moves) < len(best_moves):
                best_moves = moves
                if len(best_moves) == 1:
