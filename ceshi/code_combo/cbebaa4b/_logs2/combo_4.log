+            )
+        except ValueError:
+            return None
+        paste(inp, node["arr"], r, c, transparent=0)
+    return inp
+
+
+def _gen_attempt() -> np.ndarray | None:
+    h = random.randint(*GRID_H_RANGE)
+    w = random.randint(*GRID_W_RANGE)
+    nodes = _grow_alternating_chain()
+    if nodes is None:
