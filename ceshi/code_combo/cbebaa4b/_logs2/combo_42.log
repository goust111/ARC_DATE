+                "arr": arr,
+                "reds": red_coords,
+                "red_sides": red_sides,
+                "shape": (int(arr.shape[0]), int(arr.shape[1])),
+                "area": int(np.sum(arr != bg)),
+                "anchor_info": anchor_info,
+            }
