+    h, w = canvas.shape
+    ph, pw = arr.shape
+    if top < 0 or left < 0 or top + ph > h or left + pw > w:
+        return None
+
+    sub = canvas[top : top + ph, left : left + pw]
+    mask = arr != bg
+    if not np.any(mask):
+        return None
+
