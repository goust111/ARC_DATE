+ANCHOR_SHAPES = _anchor_catalog()
+
+
+def _analyze_anchor_piece(arr: np.ndarray) -> dict | None:
+    if not np.any(arr == 4):
+        return None
+    if not np.all(np.isin(arr, [0, 2, 4])):
+        return None
