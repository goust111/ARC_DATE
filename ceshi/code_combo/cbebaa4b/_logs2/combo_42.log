+# Combo variant of cbebaa4b (index 42)
+# combo_spec: D3/3+D13/2
+# Name: 十字形锚点 + 连接方向由锚点决定
+
+import random
+import sys
+from pathlib import Path
+
+import numpy as np
+
+ROOT = Path("/home/lixinyu/snap/new/solvers")
+if str(ROOT) not in sys.path:
