+def _anchor_mask(kind: str, turns: int = 0) -> np.ndarray:
+    if kind == "cross":
+        mask = np.zeros((6, 6), dtype=bool)
+        mask[2:4, :] = True
+        mask[:, 2:4] = True
+        return mask
+    if kind == "el":
+        mask = np.zeros((6, 6), dtype=bool)
+        mask[:, :2] = True
+        mask[-2:, :] = True
+        return np.rot90(mask, k=turns)
+    raise ValueError(f"unknown anchor kind: {kind}")
+
