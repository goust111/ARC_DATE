+
+def _side_coords(shape: tuple[int, int], side: str, idxs: list[int]) -> list[tuple[int, int]]:
+    h, w = shape
+    if side == "top":
+        return [(0, i) for i in idxs]
+    if side == "bottom":
+        return [(h - 1, i) for i in idxs]
+    if side == "left":
