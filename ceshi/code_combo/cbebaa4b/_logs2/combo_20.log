+        dedup: dict[tuple[int, int, int], tuple[int, int]] = {}
+        for idx, top, left, matched_count, new_count in best_moves:
+            key = (idx, top, left)
+            score = (matched_count, -new_count)
+            if key not in dedup or score > dedup[key]:
