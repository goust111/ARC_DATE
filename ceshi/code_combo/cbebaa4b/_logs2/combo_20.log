    73	def _extract_side_port(arr: np.ndarray, side: str, bg: int) -> dict | None:
    74	    h, w = arr.shape
    75	    if side == "top":
    76	        idxs = np.flatnonzero(arr[0] != bg).tolist()
    77	        if not idxs:
    78	            return None
    79	        if len(idxs) != 2 or idxs[1] != idxs[0] + 1 or idxs[0] == 0 or idxs[1] == w - 1:
    80	            return None
    81	        if np.any(arr[1, idxs] == bg):
    82	            return None
    83	    elif side == "bottom":
