   110	def _extract_ports(arr: np.ndarray, bg: int) -> list[dict]:
   111	    ports = []
   112	    for side in SIDES:
   113	        port = _extract_side_port(arr, side, bg)
   114	        if port is not None:
   115	            ports.append(port)
   116	    return ports
