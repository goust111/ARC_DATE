+        if len(idxs) != 2 or idxs[1] != idxs[0] + 1 or idxs[0] == 0 or idxs[1] == w - 1:
+            return None
+        if np.any(arr[h - 2, idxs] == bg):
+            return None
+    elif side == "left":
+        idxs = np.flatnonzero(arr[:, 0] != bg).tolist()
+        if not idxs:
+            return None
+        if len(idxs) != 2 or idxs[1] != idxs[0] + 1 or idxs[0] == 0 or idxs[1] == h - 1:
+            return None
+        if np.any(arr[idxs, 1] == bg):
