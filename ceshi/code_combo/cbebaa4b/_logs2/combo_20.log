   140	def _try_place(
   141	    canvas: np.ndarray, arr: np.ndarray, top: int, left: int, bg: int
   142	) -> np.ndarray | None:
   143	    h, w = canvas.shape
   144	    ph, pw = arr.shape
   145	    if top < 0 or left < 0 or top + ph > h or left + pw > w:
   146	        return None
   147	
   148	    sub = canvas[top : top + ph, left : left + pw]
   149	    mask = arr != bg
   150	    if not np.any(mask):
   151	        return None
   152	    if np.any(sub[mask] != bg):
   153	        return None
   154	
   155	    out = canvas.copy()
   156	    out_sub = out[top : top + ph, left : left + pw]
   157	    out_sub[mask] = arr[mask]
   158	    out[top : top + ph, left : left + pw] = out_sub
   159	    return out
   160	
   161	
   162	def _port_key(side: str, cells: list[tuple[int, int]]) -> tuple[int, int, int, int, str]:
   163	    (r0, c0), (r1, c1) = cells
   164	    return (int(r0), int(c0), int(r1), int(c1), side)
   165	
   166	
   167	def _global_port_cells(port: dict, top: int, left: int) -> list[tuple[int, int]]:
   168	    return [(top + r, left + c) for r, c in port["cells"]]
   169	
   170	
   171	def _analyze_placement(
   172	    canvas: np.ndarray,
   173	    piece: dict,
   174	    top: int,
   175	    left: int,
   176	    open_ports: dict[tuple[int, int, int, int, str], dict],
   177	    bg: int,
   178	) -> tuple[list[tuple[int, int, int, int, str]], dict[tuple[int, int, int, int, str], dict]] | None:
   179	    placed = _try_place(canvas, piece["arr"], top, left, bg)
   180	    if placed is None:
   181	        return None
   182	
   183	    h, w = canvas.shape
   184	    piece_globals = {(top + r, left + c) for r, c in piece["cells"]}
   185	    matched_keys: list[tuple[int, int, int, int, str]] = []
   186	    new_ports: dict[tuple[int, int, int, int, str], dict] = {}
   187	    allowed_contacts: set[tuple[int, int, int, int]] = set()
   188	
   189	    for port in piece["ports"]:
   190	        cells = _global_port_cells(port, top, left)
   191	        dr, dc = OUTWARD[port["side"]]
   192	        nbrs = [(r + dr, c + dc) for r, c in cells]
   193	
   194	        if any(not (0 <= nr < h and 0 <= nc < w) for nr, nc in nbrs):
   195	            return None
   196	        occupied = [canvas[nr, nc] != bg for nr, nc in nbrs]
   197	        if any(occupied):
   198	            if not all(occupied):
   199	                return None
   200	            key = _port_key(OPPOSITE[port["side"]], nbrs)
   201	            if key not in open_ports:
   202	                return None
   203	            matched_keys.append(key)
   204	            for (r, c), (nr, nc) in zip(cells, nbrs):
   205	                allowed_contacts.add((r, c, nr, nc))
   206	        else:
   207	            key = _port_key(port["side"], cells)
   208	            new_ports[key] = {"side": port["side"], "cells": cells}
   209	
   210	    for r, c in piece_globals:
   211	        for nr, nc in neighbors4(r, c):
   212	            if (nr, nc) in piece_globals:
   213	                continue
   214	            if not (0 <= nr < h and 0 <= nc < w):
   215	                continue
   216	            if canvas[nr, nc] == bg:
   217	                continue
   218	            if (r, c, nr, nc) in allowed_contacts:
   219	                continue
   220	            return None

