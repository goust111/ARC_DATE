    62	def _side_coords(shape: tuple[int, int], side: str, idxs: list[int]) -> list[tuple[int, int]]:
    63	    h, w = shape
    64	    if side == "top":
    65	        return [(0, i) for i in idxs]
    66	    if side == "bottom":
    67	        return [(h - 1, i) for i in idxs]
    68	    if side == "left":
    69	        return [(i, 0) for i in idxs]
    70	    return [(i, w - 1) for i in idxs]
