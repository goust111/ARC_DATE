   119	def _extract_pieces(g: np.ndarray, bg: int) -> list[dict]:
   120	    comps = components_mask(g != bg, connectivity=4)
   121	    pieces = []
   122	    for pts in comps:
   123	        r0, c0, r1, c1 = bbox_coords(pts)
   124	        arr = g[r0 : r1 + 1, c0 : c1 + 1].copy()
   125	        ports = _extract_ports(arr, bg)
   126	        cells = [(int(r), int(c)) for r, c in np.argwhere(arr != bg)]
   127	        pieces.append(
   128	            {
   129	                "bbox": (int(r0), int(c0), int(r1), int(c1)),
   130	                "arr": arr,
   131	                "ports": ports,
   132	                "shape": (int(arr.shape[0]), int(arr.shape[1])),
   133	                "area": int(np.sum(arr != bg)),
   134	                "cells": cells,
   135	            }
   136	        )
   137	    return pieces
