    94	            return None
    95	        if len(idxs) != 2 or idxs[1] != idxs[0] + 1 or idxs[0] == 0 or idxs[1] == h - 1:
    96	            return None
    97	        if np.any(arr[idxs, 1] == bg):
    98	            return None
    99	    else:
   100	        idxs = np.flatnonzero(arr[:, w - 1] != bg).tolist()
   101	        if not idxs:
   102	            return None
   103	        if len(idxs) != 2 or idxs[1] != idxs[0] + 1 or idxs[0] == 0 or idxs[1] == h - 1:
   104	            return None
   105	        if np.any(arr[idxs, w - 2] == bg):
   106	            return None
   107	    return {"side": side, "cells": _side_coords((h, w), side, idxs)}
