    51	import numpy as np
    52	
    53	from arc_utils import bbox_coords, components_mask, neighbors4, paste, random_free_location
    54	
    55	
    56	SIDES = ("top", "right", "bottom", "left")
    57	OPPOSITE = {"top": "bottom", "bottom": "top", "left": "right", "right": "left"}
    58	INWARD = {"top": (1, 0), "bottom": (-1, 0), "left": (0, 1), "right": (0, -1)}
    59	OUTWARD = {"top": (-1, 0), "bottom": (1, 0), "left": (0, -1), "right": (0, 1)}
