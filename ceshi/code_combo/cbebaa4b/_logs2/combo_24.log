+PAIR_COUNT_CHOICES = (2, 3)
+BODY_H_RANGE = (2, 5)
+BODY_W_RANGE = (2, 6)
+PIECE_DIM_CANDIDATES = 16
+PIECE_COLORS = [1, 3, 5, 6, 7, 8, 9]
+PIECE_CAP = 2
+
+ANCHOR_BLOCK_CHOICES = [(3, 3), (4, 5)]
+SCATTER_PADDING = 2
+
+GEN_RETRY_LIMIT = 500
+HALF_GROW_RETRY = 80
