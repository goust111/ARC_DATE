+def _port_cells(node, side):
+    h, w = node["shape"]
+    body_h, body_w = node["body_shape"]
+    k = node["ports"][side]
+    if side == "top":
+        return [(0, 1 + k), (0, 2 + k)]
+    if side == "bottom":
+        return [(h - 1, 1 + k), (h - 1, 2 + k)]
+    if side == "left":
+        return [(1 + k, 0), (2 + k, 0)]
+    return [(1 + k, w - 1), (2 + k, w - 1)]
+
+
+def _global_port(node, side):
+    tr, tc = node["top"], node["left"]
+    return [(tr + r, tc + c) for r, c in _port_cells(node, side)]
