+# Combo variant of cbebaa4b (index 24)
+# combo_spec: D2/0+D14/1
+# Name: 规则矩形精灵 + 对称性目标
+
+import random
+import sys
+from pathlib import Path
+
+import numpy as np
+
+ROOT = Path(__file__).resolve().parents[4]
+SOLVER_DIR = ROOT / "solvers"
