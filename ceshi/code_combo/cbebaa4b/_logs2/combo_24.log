+def _new_node(kind, body_h, body_w, color, top=0, left=0, cap=PIECE_CAP):
+    return {
+        "kind": kind,
+        "body_shape": (int(body_h), int(body_w)),
+        "shape": (int(body_h) + 2, int(body_w) + 2),
+        "color": int(color),
+        "top": int(top),
+        "left": int(left),
+        "cap": int(cap),
+        "sides": set(),
+        "ports": {},
