+    full = trial_boxes + [(mr0, mc0, mr1, mc1)]
+    r0 = min(b[0] for b in full)
+    c0 = min(b[1] for b in full)
+    r1 = max(b[2] for b in full)
+    c1 = max(b[3] for b in full)
