   613	def _build_layout() -> list[dict] | None:
   614	    piece_count = random.choice(PIECE_COUNT_CHOICES)
   615	    bh, bw = random.choice(ANCHOR_BLOCK_CHOICES)
   616	    anchor = _new_node("anchor", bh + 2, bw + 2, 4, top=0, left=0)
   617	    anchor["block"] = (bh, bw)
   618	    axis_col = anchor["shape"][1] // 2
   619	
   620	    side_color = random.choice(PIECE_COLORS)
   621	    center_color_choices = [c for c in PIECE_COLORS if c != side_color]
   622	    center_color = random.choice(center_color_choices) if center_color_choices else side_color
   623	
   624	    k_lr = random.randint(1, anchor["shape"][0] - 3)
   625	    anchor["sides"] = {"left", "right"}
   626	    anchor["ports"]["left"] = k_lr
   627	    anchor["ports"]["right"] = k_lr
   628	
   629	    side_h = random.randint(*SIDE_PIECE_H_RANGE)
   630	    side_w = random.randint(*SIDE_PIECE_W_RANGE)
   631	    left = _new_node("side", side_h, side_w, side_color)
   632	    left["sides"] = {"right"}
   633	    _ensure_port(left, "right")
   634	    pr, pc = _global_port(anchor, "left")[0]
   635	    cr, cc = _port_cells(left, "right")[0]
   636	    left["top"] = pr - cr
   637	    left["left"] = pc - cc
   638	
   639	    nodes = [anchor, left]
   640	
   641	    if piece_count == 3:
   642	        attach_side = random.choice(("top", "bottom"))
   643	        piece_side = OPPOSITE[attach_side]
   644	        center_h = random.randint(*CENTER_PIECE_H_RANGE)
   645	        center_w = random.choice(CENTER_PIECE_W_CHOICES)
   646	        center = _new_node("center", center_h, center_w, center_color)
   647	        center["sides"] = {piece_side}
   648	        anchor["sides"].add(attach_side)
   649	        anchor["ports"][attach_side] = anchor["shape"][1] // 2 - 1
   650	        center["ports"][piece_side] = center_w // 2 - 1
   651	        pr2, pc2 = _global_port(anchor, attach_side)[0]
   652	        cr2, cc2 = _port_cells(center, piece_side)[0]
   653	        center["top"] = pr2 - cr2
   654	        center["left"] = pc2 - cc2
   655	        nodes.append(center)
   656	
   657	    for node in nodes:
   658	        if node["kind"] == "anchor":
   659	            node["arr"] = _make_anchor(node)
   660	        elif node["kind"] == "side":
   661	            node["arr"] = _make_side_piece(node)
   662	        else:
   663	            node["arr"] = _make_center_piece(node)
   664	        if node["arr"] is None:
   665	            return None
   666	
   667	    right = _new_node("side", side_h, side_w, side_color, top=left["top"], left=0)
   668	    right["sides"] = {MIRROR_SIDE[s] for s in left["sides"]}
   669	    right["ports"]["left"] = left["ports"]["right"]
   670	    right["left"] = _mirror_left_coord(left["left"], side_w, axis_col)
   671	    right["arr"] = np.fliplr(left["arr"]).copy()
   672	    nodes.append(right)
   673	
   674	    if piece_count == 2:
   675	        return [anchor, left, right]
   676	    return [anchor, left, nodes[2], right]
