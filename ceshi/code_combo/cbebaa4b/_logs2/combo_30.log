   764	def _scatter(nodes: list[dict], h: int, w: int) -> np.ndarray | None:
   765	    inp = np.zeros((h, w), dtype=int)
   766	    anchor = nodes[0]
   767	    paste(inp, anchor["arr"], *anchor["pos"], transparent=0)
   768	
   769	    rest = [n for n in nodes if n["kind"] != "anchor"]
   770	    random.shuffle(rest)
   771	    for node in rest:
   772	        try:
   773	            r, c = random_free_location(
   774	                inp,
   775	                node["scatter_arr"],
   776	                transparent=0,
   777	                padding=SCATTER_PADDING,
   778	                padding_connectivity=8,
   779	            )
   780	        except ValueError:
   781	            return None
   782	        paste(inp, node["scatter_arr"], r, c, transparent=0)
   783	    return inp
