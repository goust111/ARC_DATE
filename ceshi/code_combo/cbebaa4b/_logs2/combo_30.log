   466	def _make_side_piece(node: dict) -> np.ndarray | None:
   467	    h, w = node["shape"]
   468	    color = node["color"]
   469	    used = set(node["sides"])
   470	
   471	    for _ in range(RENDER_RETRY):
   472	        arr = np.zeros((h, w), dtype=int)
   473	        core_h = 2 if h <= 6 else 3
   474	        core_w = 2 if w <= 7 else 3
   475	        core_r0 = random.randint(1, h - core_h - 1)
   476	        core_c0 = random.randint(1, w - core_w - 1)
   477	        arr[core_r0 : core_r0 + core_h, core_c0 : core_c0 + core_w] = color
   478	        hub = (core_r0 + core_h // 2, core_c0 + core_w // 2)
   479	
   480	        bar_sides = [s for s in SIDES if s not in used]
   481	        if len(bar_sides) > 1 and random.random() < BAR_SKIP_PROB:
   482	            bar_sides.remove(random.choice(bar_sides))
   483	        for side in bar_sides:
   484	            _paint_bar(arr, side, color, used)
   485	
   486	        terminals = []
   487	        for side in used:
   488	            dr, dc = INWARD[side]
   489	            for r, c in _port_cells(node, side):
   490	                arr[r, c] = 2
   491	                rr, cc = r + dr, c + dc
   492	                arr[rr, cc] = color
   493	                terminals.append((rr, cc))
   494	
   495	        order = random.randint(0, 1)
   496	        for t in terminals:
   497	            _draw_path(arr, t, hub, color, order)
   498	        for side in bar_sides:
   499	            _draw_path(arr, hub, _bar_endpoint((h, w), side, hub), color, 1 - order)
   500	
   501	        trial_ok = False
   502	        for name, loc_fn in random.sample(list(TAG_CORNERS.items()), len(TAG_CORNERS)):
   503	            trial = arr.copy()
   504	            tag = loc_fn(h, w)
   505	            trial[tag] = color
   506	            _draw_path(trial, hub, tag, color, random.randint(0, 1))
   507	            if len(components_mask(trial != 0, connectivity=4)) != 1:
   508	                continue
   509	            if int(np.sum(trial == 2)) != 2 * len(used):
   510	                continue
   511	            if len(_variant_records(trial, 0)) < MIN_SIDE_UNIQUE_VARIANTS:
   512	                continue
   513	            node["tag_corner"] = name
   514	            arr = trial
   515	            trial_ok = True
   516	            break
   517	
   518	        if not trial_ok:
   519	            continue
   520	        return arr

