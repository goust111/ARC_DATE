   424	def _draw_path(arr: np.ndarray, start: tuple[int, int], end: tuple[int, int], color: int, order: int) -> None:
   425	    r, c = start
   426	    er, ec = end
   427	    axes = (
   428	        [(r, er, c, True), (c, ec, er, False)]
   429	        if order == 0
   430	        else [(c, ec, r, False), (r, er, ec, True)]
   431	    )
   432	    for a_start, a_end, fixed, is_row in axes:
   433	        step = 1 if a_end >= a_start else -1
   434	        for v in range(a_start, a_end + step, step):
   435	            rr, cc = (v, fixed) if is_row else (fixed, v)
   436	            if arr[rr, cc] != 2:
   437	                arr[rr, cc] = color
