   385	def _ensure_port(node: dict, side: str) -> None:
   386	    if side in node["ports"]:
   387	        return
   388	    h, w = node["shape"]
   389	    span = h if side in ("left", "right") else w
   390	    node["ports"][side] = random.randint(1, span - 3)
