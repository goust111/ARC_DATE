   679	def _place_node_on_canvas(out: np.ndarray, node: dict, sr: int, sc: int) -> dict | None:
   680	    arr = node["arr"]
   681	    top = node["top"] + sr
   682	    left = node["left"] + sc
   683	    node["pos"] = (top, left)
   684	    red_counts: dict[tuple[int, int], int] = {}
   685	
   686	    mask = arr != 0
   687	    rows, cols = np.nonzero(mask)
   688	    g_rows = rows + top
   689	    g_cols = cols + left
   690	    vals = arr[rows, cols]
   691	    cur_vals = out[g_rows, g_cols]
   692	    conflicts = (cur_vals != 0) & ~((cur_vals == 2) & (vals == 2))
   693	    if np.any(conflicts):
   694	        return None
   695	
   696	    red_mask = vals == 2
   697	    for gr, gc in zip(g_rows[red_mask], g_cols[red_mask]):
   698	        key = (int(gr), int(gc))
   699	        red_counts[key] = red_counts.get(key, 0) + 1
   700	
   701	    paint_mask = cur_vals == 0
   702	    out[g_rows[paint_mask], g_cols[paint_mask]] = vals[paint_mask]
   703	    return red_counts
