   414	def _union_bbox(nodes: list[dict]) -> tuple[int, int, int, int]:
   415	    boxes = [_bbox_of(n) for n in nodes]
   416	    return (
   417	        min(b[0] for b in boxes),
   418	        min(b[1] for b in boxes),
   419	        max(b[2] for b in boxes),
   420	        max(b[3] for b in boxes),
   421	    )
