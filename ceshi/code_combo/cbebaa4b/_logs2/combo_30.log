   440	def _paint_bar(arr: np.ndarray, side: str, color: int, used: set[str]) -> None:
   441	    h, w = arr.shape
   442	    is_horizontal = side in ("top", "bottom")
   443	    fixed = 0 if side in ("top", "left") else (h - 1 if side == "bottom" else w - 1)
   444	    span = w if is_horizontal else h
   445	    lo_conflict = "left" if is_horizontal else "top"
   446	    hi_conflict = "right" if is_horizontal else "bottom"
   447	    for i in range(span):
   448	        if (i == 0 and lo_conflict in used) or (i == span - 1 and hi_conflict in used):
   449	            continue
   450	        if is_horizontal:
   451	            arr[fixed, i] = color
   452	        else:
   453	            arr[i, fixed] = color
