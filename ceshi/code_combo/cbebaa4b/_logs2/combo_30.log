   456	def _bar_endpoint(shape: tuple[int, int], side: str, hub: tuple[int, int]) -> tuple[int, int]:
   457	    h, w = shape
   458	    hr, hc = hub
   459	    if side in ("top", "bottom"):
   460	        row = 0 if side == "top" else h - 1
   461	        return (row, min(max(hc, 1), w - 2))
   462	    col = 0 if side == "left" else w - 1
   463	    return (min(max(hr, 1), h - 2), col)
