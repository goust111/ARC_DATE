   740	def _choose_scatter_variants(nodes: list[dict]) -> bool:
   741	    movable = [n for n in nodes if n["kind"] != "anchor"]
   742	    flip_candidates = []
   743	    for node in movable:
   744	        variants = _variant_records(node["arr"], 0)
   745	        non_identity = [v for v in variants if not np.array_equal(v["arr"], node["arr"])]
   746	        flips = [v for v in non_identity if v["is_flip"]]
   747	        if not non_identity:
   748	            return False
   749	        node["all_variants"] = variants
   750	        node["scatter_info"] = random.choice(non_identity)
   751	        node["scatter_arr"] = node["scatter_info"]["arr"]
   752	        if flips:
   753	            flip_candidates.append((node, flips))
   754	
   755	    if not any(node["scatter_info"]["is_flip"] for node in movable):
   756	        if not flip_candidates:
   757	            return False
   758	        node, flips = random.choice(flip_candidates)
   759	        node["scatter_info"] = random.choice(flips)
   760	        node["scatter_arr"] = node["scatter_info"]["arr"]
   761	    return True
