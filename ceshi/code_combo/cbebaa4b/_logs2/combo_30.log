+        arr = g[r0 : r1 + 1, c0 : c1 + 1].copy()
+        piece = _piece_record(arr, bg)
+        piece["bbox"] = (int(r0), int(c0), int(r1), int(c1))
+        pieces.append(piece)
+    return pieces
