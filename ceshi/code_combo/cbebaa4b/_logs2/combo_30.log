   706	def _assemble(nodes: list[dict], h: int, w: int) -> np.ndarray | None:
   707	    r0, c0, r1, c1 = _union_bbox(nodes)
   708	    if (r1 - r0 + 1) > MAX_ASSEMBLY_DIM or (c1 - c0 + 1) > MAX_ASSEMBLY_DIM:
   709	        return None
   710	    if (r1 - r0 + 1) > h or (c1 - c0 + 1) > w:
   711	        return None
   712	
   713	    sr = random.randint(-r0, h - 1 - r1)
   714	    sc = random.randint(-c0, w - 1 - c1)
   715	
   716	    out = np.zeros((h, w), dtype=int)
   717	    all_red_counts: dict[tuple[int, int], int] = {}
   718	    for node in nodes:
   719	        rc = _place_node_on_canvas(out, node, sr, sc)
   720	        if rc is None:
   721	            return None
   722	        for key, val in rc.items():
   723	            all_red_counts[key] = all_red_counts.get(key, 0) + val
   724	
   725	    total_ports = sum(int(np.sum(node["arr"] == 2)) for node in nodes)
   726	    if len(all_red_counts) * 2 != total_ports:
   727	        return None
   728	    if any(v != 2 for v in all_red_counts.values()):
   729	        return None
   730	    if len(components_mask(out != 0, connectivity=4)) != 1:
   731	        return None
   732	
   733	    anchor = nodes[0]
   734	    axis2 = 2 * (anchor["pos"][1] + anchor["shape"][1] // 2)
   735	    if not _is_vertically_symmetric(out, axis2, 0):
   736	        return None
   737	    return out
