   393	def _port_cells(node: dict, side: str) -> list[tuple[int, int]]:
   394	    h, w = node["shape"]
   395	    k = node["ports"][side]
   396	    if side == "top":
   397	        return [(0, k), (0, k + 1)]
   398	    if side == "bottom":
   399	        return [(h - 1, k), (h - 1, k + 1)]
   400	    if side == "left":
   401	        return [(k, 0), (k + 1, 0)]
   402	    return [(k, w - 1), (k + 1, w - 1)]
