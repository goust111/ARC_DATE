+        "flip_count": int(sum(1 for n in movable if n["scatter_info"]["is_flip"])),
+        "changed_piece_count": int(sum(1 for n in movable if n["scatter_info"]["code"] != "id")),
+        "unique_variant_counts": [len(n["all_variants"]) for n in movable],
