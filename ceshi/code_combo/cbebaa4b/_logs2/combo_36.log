   455	def _bbox_of(node: dict) -> tuple[int, int, int, int]:
   456	    h, w = node["shape"]
   457	    return (node["top"], node["left"], node["top"] + h - 1, node["left"] + w - 1)
   458	
   459	
   460	def _rects_overlap(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:
   461	    return not (a[2] < b[0] or b[2] < a[0] or a[3] < b[1] or b[3] < a[1])
   462	
   463	
   464	def _union_bbox(nodes: list[dict]) -> tuple[int, int, int, int]:
   465	    boxes = [_bbox_of(n) for n in nodes]
   466	    return (
   467	        min(b[0] for b in boxes),
   468	        min(b[1] for b in boxes),
   469	        max(b[2] for b in boxes),
   470	        max(b[3] for b in boxes),
   471	    )
   472	
   473	
   474	def _sample_side_runs(span: int, count: int) -> list[tuple[int, int]] | None:
   475	    intervals = [(start, length) for length in CONNECTOR_LEN_CHOICES for start in range(span - length + 1)]
   476	    combos = []
   477	    for combo in itertools.combinations(intervals, count):
   478	        ordered = sorted(combo)
   479	        ok = True
   480	        for (s0, l0), (s1, _l1) in zip(ordered, ordered[1:]):
   481	            if s0 + l0 >= s1:
   482	                ok = False
   483	                break
   484	        if ok:
   485	            combos.append(ordered)
   486	    if not combos:
   487	        return None
   488	    return random.choice(combos)
   489	
