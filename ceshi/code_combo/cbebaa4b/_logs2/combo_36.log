   339	
   340	def main(grid: np.ndarray) -> np.ndarray:
   341	    """
   342	    Reassemble scattered sprites by choosing the only candidate edge whose red-count matches an anchor slot.
   343	
   344	    Input structure:
   345	    - The background is black (0). One fixed anchor contains a yellow block and several red runs on its outer edges.
   346	    - Each non-anchor sprite is a separate colored component with 2-4 candidate red edge runs on different sides.
   347	    - A candidate connector is the full red run on one side, and most of those runs are decoys.
   348	
   349	    Rule:
   350	    - Keep the anchor where it is.
   351	    - For each anchor slot, choose one unused piece whose opposite-side red run has the same number of red pixels.
   352	    - Translate that piece so the matching run docks flush against the slot; pieces never overlap, and unused connectors stay visible.
   353	
   354	    Key insight:
   355	    - The puzzle no longer asks you to pair every red pixel. Red now encodes edge counts: first count the red cells on each candidate side, then use the only equal-count side to decide how that sprite attaches to the anchor.
   356	    """
   357	    g = np.asarray(grid, dtype=int)
   358	    h, w = g.shape
   359	    bg = 0
   360	
   361	    pieces = _extract_pieces(g, bg)
   362	    assert pieces, "input must have at least one piece"
   363	
   364	    anchors = [p for p in pieces if np.any(p["arr"] == 4)]
   365	    assert len(anchors) == 1, "input must have exactly one anchor"
   366	    anchor = anchors[0]
   367	    rest = [p for p in pieces if p is not anchor]
   368	
   369	    for p in rest:
   370	        _annotate_connectors(p)
   371	        assert 2 <= len(p["connectors"]) <= 4, "each piece must expose 2-4 candidate connectors"
   372	        assert len({c["side"] for c in p["connectors"]}) == len(p["connectors"]), "candidate connectors must live on distinct sides"
   373	
   374	    slots = _anchor_slots(anchor["arr"])
   375	    assert len(rest) == len(slots), "piece count must match anchor slot count"
   376	
   377	    canvas = np.full((h, w), bg, dtype=int)
   378	    ar0, ac0, _, _ = anchor["bbox"]
   379	    placed = _try_place(canvas, anchor["arr"], ar0, ac0, bg)
   380	    assert placed is not None, "anchor must fit"
   381	
   382	    anchor_bbox = anchor["bbox"]
   383	    solutions: list[np.ndarray] = []
   384	
   385	    def moves_for_slot(cur: np.ndarray, remaining: list[dict], slot: dict) -> list[tuple[int, int, int, int, int]]:
   386	        moves = []
   387	        for idx, piece in enumerate(remaining):
   388	            match_count = 0
   389	            for conn in piece["connectors"]:
   390	                if conn["side"] != OPPOSITE[slot["side"]] or conn["length"] != slot["length"]:
   391	                    continue
   392	                match_count += 1
   393	                top, left = _placement_for_slot(anchor_bbox, slot, piece, conn)
   394	                if not _is_legal_slot_move(cur, anchor_bbox, slot, piece, conn, top, left, bg):
   395	                    continue
   396	                moves.append((idx, top, left, len(piece["connectors"]), piece["area"]))
   397	            assert match_count <= 1, "generator guarantees at most one matching connector per piece"
   398	        moves.sort(key=lambda x: (x[3], -x[4], x[1], x[2], x[0]))
   399	        return moves
   400	
   401	    def dfs(cur: np.ndarray, remaining: list[dict], unused_slots: list[dict]) -> None:
   402	        if len(solutions) >= 2:
   403	            return
   404	        if not remaining:
   405	            if not unused_slots:
   406	                solutions.append(cur)
   407	            return
   408	        if len(remaining) != len(unused_slots):
   409	            return
   410	
   411	        best_slot = None
   412	        best_moves = None
   413	        for slot in unused_slots:
   414	            cur_moves = moves_for_slot(cur, remaining, slot)
   415	            if not cur_moves:
   416	                return
   417	            if best_moves is None or len(cur_moves) < len(best_moves):
   418	                best_slot = slot
   419	                best_moves = cur_moves
   420	                if len(best_moves) == 1:
   421	                    break
   422	
   423	        assert best_slot is not None and best_moves is not None
   424	
   425	        seen: set[tuple[int, int, int]] = set()
   426	        next_slots = [s for s in unused_slots if s is not best_slot]
   427	        for idx, top, left, _nconn, _area in best_moves:
   428	            key = (idx, top, left)
   429	            if key in seen:
   430	                continue
   431	            seen.add(key)
   432	            piece = remaining[idx]
   433	            nxt = _try_place(cur, piece["arr"], top, left, bg)
   434	            if nxt is None:
   435	                continue
   436	            dfs(nxt, remaining[:idx] + remaining[idx + 1 :], next_slots)
   437	            if len(solutions) >= 2:
   438	                return
   439	
   440	    dfs(placed, rest, slots)
   441	    assert len(solutions) == 1, "assembly must have exactly one valid solution"
   442	    return solutions[0]
   443	
   444	
   445	def _new_node(kind: str, h: int, w: int, color: int, top: int = 0, left: int = 0) -> dict:
   446	    return {
   447	        "kind": kind,
   448	        "shape": (int(h), int(w)),
   449	        "color": int(color),
   450	        "top": int(top),
   451	        "left": int(left),
   452	    }
