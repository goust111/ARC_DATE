+
+def _scatter(nodes: list[dict], h: int, w: int) -> np.ndarray | None:
+    inp = np.zeros((h, w), dtype=int)
+    anchor = nodes[0]
+    paste(inp, anchor["arr"], *anchor["pos"], transparent=0)
+    rest = nodes[1:]
+    random.shuffle(rest)
+    for node in rest:
+        try:
+            r, c = random_free_location(
+                inp,
+                node["arr"],
+                transparent=0,
+                padding=SCATTER_PADDING,
+                padding_connectivity=8,
