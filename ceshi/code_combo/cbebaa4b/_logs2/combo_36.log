+PIECE_COUNT_RANGE = (4, 6)
+PIECE_H_RANGE = (4, 7)
+PIECE_W_RANGE = (4, 8)
+PIECE_SHAPE_TRIES = 80
+PIECE_COLORS = [1, 3, 5, 6, 7, 8, 9]
+CONNECTOR_COUNT_RANGE = (2, 4)
+CONNECTOR_LEN_CHOICES = (1, 2, 3)
