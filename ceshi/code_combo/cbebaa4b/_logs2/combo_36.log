   530	
   531	def _make_piece(node: dict) -> np.ndarray | None:
   532	    h, w = node["shape"]
   533	    color = node["color"]
   534	    connector_sides = set(node["connectors"])
   535	    arr = np.zeros((h, w), dtype=int)
   536	    hub = (random.randint(1, h - 2), random.randint(1, w - 2))
   537	
   538	    bar_sides = [s for s in SIDES if s not in connector_sides]
   539	    if len(bar_sides) > 1 and random.random() < BAR_SKIP_PROB:
   540	        bar_sides.remove(random.choice(bar_sides))
   541	    for side in bar_sides:
   542	        _paint_bar(arr, side, color, connector_sides)
   543	
   544	    terminals = []
   545	    for side, spec in node["connectors"].items():
   546	        cells = _connector_cells((h, w), side, spec["start"], spec["length"])
   547	        inwards = _connector_inward_cells((h, w), side, spec["start"], spec["length"])
   548	        for r, c in cells:
   549	            arr[r, c] = 2
   550	        for r, c in inwards:
   551	            arr[r, c] = color
   552	        terminals.append(inwards[len(inwards) // 2])
   553	
   554	    arr[hub] = color
   555	    order = random.randint(0, 1)
   556	    for t in terminals:
   557	        _draw_path(arr, t, hub, color, order)
   558	    for side in bar_sides:
   559	        _draw_path(arr, hub, _bar_endpoint((h, w), side, hub), color, 1 - order)
   560	
   561	    if len(components_mask(arr != 0, connectivity=4)) != 1:
   562	        return None
   563	    expected_reds = sum(spec["length"] for spec in node["connectors"].values())
   564	    if int(np.sum(arr == 2)) != expected_reds:
   565	        return None
   566	    return arr
