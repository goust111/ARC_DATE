   524	def _sample_run_start(span: int, length: int) -> int:
   525	    interior = [s for s in range(span - length + 1) if s > 0 and s + length < span]
   526	    if interior:
   527	        return random.choice(interior)
   528	    return random.randint(0, span - length)
