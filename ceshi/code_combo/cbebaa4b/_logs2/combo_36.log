   569	def _adjacency_pairs(a: dict, b: dict) -> set[tuple[tuple[int, int], tuple[int, int]]]:
   570	    pairs: set[tuple[tuple[int, int], tuple[int, int]]] = set()
   571	    arr = a["arr"]
   572	    for r, c in np.argwhere(arr != 0):
   573	        gr, gc = int(a["top"] + r), int(a["left"] + c)
   574	        for nr, nc in ((gr - 1, gc), (gr + 1, gc), (gr, gc - 1), (gr, gc + 1)):
   575	            br, bc = nr - b["top"], nc - b["left"]
   576	            if 0 <= br < b["shape"][0] and 0 <= bc < b["shape"][1] and int(b["arr"][br, bc]) != 0:
   577	                pairs.add(((gr, gc), (nr, nc)))
   578	    return pairs
