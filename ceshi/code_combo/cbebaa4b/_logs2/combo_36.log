   717	def _scatter(nodes: list[dict], h: int, w: int) -> np.ndarray | None:
   718	    inp = np.zeros((h, w), dtype=int)
   719	    anchor = nodes[0]
   720	    paste(inp, anchor["arr"], *anchor["pos"], transparent=0)
   721	    rest = nodes[1:]
   722	    random.shuffle(rest)
   723	    for node in rest:
   724	        try:
   725	            r, c = random_free_location(
   726	                inp,
   727	                node["arr"],
   728	                transparent=0,
   729	                padding=SCATTER_PADDING,
   730	                padding_connectivity=8,
   731	            )
   732	        except ValueError:
   733	            return None
   734	        paste(inp, node["arr"], r, c, transparent=0)
   735	    return inp
