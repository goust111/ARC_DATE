   696	def _assemble(nodes: list[dict], h: int, w: int) -> np.ndarray | None:
   697	    r0, c0, r1, c1 = _union_bbox(nodes)
   698	    if (r1 - r0 + 1) > h or (c1 - c0 + 1) > w:
   699	        return None
   700	    sr = random.randint(-r0, h - 1 - r1)
   701	    sc = random.randint(-c0, w - 1 - c1)
   702	
   703	    out = np.zeros((h, w), dtype=int)
   704	    for node in nodes:
   705	        top = node["top"] + sr
   706	        left = node["left"] + sc
   707	        node["pos"] = (top, left)
   708	        out = _try_place(out, node["arr"], top, left, 0)
   709	        if out is None:
   710	            return None
   711	
   712	    if len(components_mask(out != 0, connectivity=4)) != 1:
   713	        return None
   714	    return out
