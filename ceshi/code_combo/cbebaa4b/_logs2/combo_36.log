   738	def _gen_attempt() -> np.ndarray | None:
   739	    h = random.randint(*GRID_H_RANGE)
   740	    w = random.randint(*GRID_W_RANGE)
   741	    nodes = _grow_star()
   742	    if nodes is None:
   743	        return None
   744	    out = _assemble(nodes, h, w)
   745	    if out is None:
   746	        return None
   747	    inp = _scatter(nodes, h, w)
   748	    if inp is None:
   749	        return None
   750	    try:
   751	        solved = main(inp)
   752	    except Exception:
   753	        return None
   754	    if np.array_equal(solved, out):
   755	        return inp
   756	    return None
