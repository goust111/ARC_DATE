   513	def _make_anchor(node: dict) -> np.ndarray:
   514	    bh, bw = node["block"]
   515	    h, w = node["shape"]
   516	    arr = np.zeros((h, w), dtype=int)
   517	    arr[1 : 1 + bh, 1 : 1 + bw] = 4
   518	    for slot in node["slots"]:
   519	        for r, c in _connector_cells((h, w), slot["side"], slot["start"], slot["length"]):
   520	            arr[r, c] = 2
   521	    return arr
