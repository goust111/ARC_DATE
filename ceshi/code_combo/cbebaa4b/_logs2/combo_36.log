   320	    expected_pairs = _expected_contact_pairs(anchor_bbox, slot, top, left, conn)
   321	    if actual_pairs != expected_pairs:
   322	        return False
   323	    for (pr, pc), (ar, ac) in actual_pairs:
   324	        if int(piece["arr"][pr - top, pc - left]) != 2 or int(canvas[ar, ac]) != 2:
   325	            return False
   326	    return True
   327	
   328	
   329	def _annotate_connectors(piece: dict) -> None:
   330	    enriched = []
   331	    h, w = piece["shape"]
   332	    for conn in _piece_connectors(piece["arr"]):
   333	        conn = dict(conn)
   334	        conn["side_row"] = 0 if conn["side"] == "top" else h - 1 if conn["side"] == "bottom" else None
   335	        conn["side_col"] = 0 if conn["side"] == "left" else w - 1 if conn["side"] == "right" else None
   336	        enriched.append(conn)
   337	    piece["connectors"] = enriched
