   581	def _expected_anchor_pairs(anchor: dict, piece: dict) -> set[tuple[tuple[int, int], tuple[int, int]]]:
   582	    slot = piece["slot"]
   583	    conn = piece["connectors"][piece["active_side"]]
   584	    ar0, ac0, ar1, ac1 = _bbox_of(anchor)
   585	    pairs: set[tuple[tuple[int, int], tuple[int, int]]] = set()
   586	    for offset in range(slot["length"]):
   587	        if slot["side"] == "top":
   588	            piece_cell = (piece["top"] + piece["shape"][0] - 1, piece["left"] + conn["start"] + offset)
   589	            anchor_cell = (ar0, ac0 + slot["start"] + offset)
   590	        elif slot["side"] == "bottom":
   591	            piece_cell = (piece["top"], piece["left"] + conn["start"] + offset)
   592	            anchor_cell = (ar1, ac0 + slot["start"] + offset)
   593	        elif slot["side"] == "left":
   594	            piece_cell = (piece["top"] + conn["start"] + offset, piece["left"] + piece["shape"][1] - 1)
   595	            anchor_cell = (ar0 + slot["start"] + offset, ac0)
   596	        else:
   597	            piece_cell = (piece["top"] + conn["start"] + offset, piece["left"])
   598	            anchor_cell = (ar0 + slot["start"] + offset, ac1)
   599	        pairs.add((piece_cell, anchor_cell))
   600	    return pairs
   601	
   602	
   603	def _can_add_piece(nodes: list[dict], child: dict) -> bool:
   604	    r0, c0, r1, c1 = _union_bbox(nodes + [child])
   605	    if (r1 - r0 + 1) > MAX_ASSEMBLY_DIM or (c1 - c0 + 1) > MAX_ASSEMBLY_DIM:
   606	        return False
   607	
   608	    child_box = _bbox_of(child)
   609	    anchor = nodes[0]
   610	    if _rects_overlap(child_box, _bbox_of(anchor)):
   611	        return False
   612	
   613	    anchor_pairs = _adjacency_pairs(child, anchor)
   614	    if anchor_pairs != _expected_anchor_pairs(anchor, child):
   615	        return False
   616	    for (pr, pc), (ar, ac) in anchor_pairs:
   617	        if int(child["arr"][pr - child["top"], pc - child["left"]]) != 2:
   618	            return False
   619	        if int(anchor["arr"][ar - anchor["top"], ac - anchor["left"]]) != 2:
   620	            return False

