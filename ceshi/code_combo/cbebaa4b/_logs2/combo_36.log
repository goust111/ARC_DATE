   491	def _choose_anchor_slots(n_pieces: int) -> list[dict] | None:
   492	    counts = {"top": 1, "right": 1, "bottom": 1, "left": 1}
   493	    if n_pieces == 5:
   494	        counts[random.choice(("top", "bottom"))] += 1
   495	    if n_pieces == 6:
   496	        counts["top"] += 1
   497	        counts["bottom"] += 1
   498	    bh, bw = ANCHOR_BLOCK
   499	    side_spans = {"top": bw + 2, "bottom": bw + 2, "left": bh + 2, "right": bh + 2}
   500	    slots = []
   501	    for side in SIDES:
   502	        run_count = counts[side]
   503	        assert run_count <= ANCHOR_SIDE_CAP[side]
   504	        chosen = _sample_side_runs(side_spans[side], run_count)
   505	        if chosen is None:
   506	            return None
   507	        for start, length in chosen:
   508	            slots.append({"side": side, "start": int(start), "length": int(length)})
   509	    random.shuffle(slots)
   510	    return slots
