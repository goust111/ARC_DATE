+    total_ports = sum(int(np.sum(node["arr"] == 2)) for node in nodes)
+    if len(red_counts) * 2 != total_ports:
+        return None
+    if any(v != 2 for v in red_counts.values()):
+        return None
+    if len(components_mask(out != 0, connectivity=4)) != 1:
+        return None
+    if np.any(out == 4):
