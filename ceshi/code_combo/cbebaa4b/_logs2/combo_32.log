+    target = set(target_group)
+    out: set[tuple[int, int]] = set()
+    for lr, lc in local_group:
+        for tr, tc in target_group:
+            top = int(tr - lr)
+            left = int(tc - lc)
+            shifted = {(int(r + top), int(c + left)) for r, c in local_group}
+            if shifted == target:
