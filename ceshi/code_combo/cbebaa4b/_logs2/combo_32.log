+def _node_bbox(node: dict, pos_key: str = "top") -> tuple[int, int, int, int]:
+    top = node[pos_key]
+    left = node["left" if pos_key == "top" else "left"]
+    h, w = node["arr"].shape
+    return (top, left, top + h - 1, left + w - 1)
