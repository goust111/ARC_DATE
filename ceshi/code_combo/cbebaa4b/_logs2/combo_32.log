+GRID_H_RANGE = (22, 26)
+GRID_W_RANGE = (22, 26)
+
+PIECE_COUNT_RANGE = (4, 6)  # non-seed pieces
+THICKNESS_CHOICES = [4, 5]
+ROOT_LEN_CHOICES = [7]
+SEG_LEN_CHOICES = [4]
+PIECE_COLORS = [1, 3, 5, 6, 7, 8, 9]
+ROOT_AREA_MARGIN = 3
+
+SCATTER_PADDING = 2
+SCATTER_ATTEMPTS = 300
+GEN_RETRY_LIMIT = 500
