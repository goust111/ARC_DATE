+            node["left"] = prev["left"] - nw + 1
+        elif direction == "down":
+            node["top"] = prev["top"] + ph - 1
+            node["left"] = prev["left"]
+        else:
+            node["top"] = prev["top"] - nh + 1
+            node["left"] = prev["left"]
+        prev = node
