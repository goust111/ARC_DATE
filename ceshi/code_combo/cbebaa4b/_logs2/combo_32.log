+def _sorted_group(coords: list[tuple[int, int]] | tuple[tuple[int, int], ...]) -> tuple[tuple[int, int], ...]:
+    return tuple(sorted((int(r), int(c)) for r, c in coords))
+
+
+def _find_red_groups(arr: np.ndarray) -> list[tuple[tuple[int, int], ...]]:
+    groups = []
