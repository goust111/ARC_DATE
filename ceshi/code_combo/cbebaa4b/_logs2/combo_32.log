+    shift_r = union_top - r0
+    shift_c = union_left - c0
+    out = np.zeros((h, w), dtype=int)
+    red_counts: dict[tuple[int, int], int] = {}
+
+    for node in nodes:
+        node["top"] += shift_r
+        node["left"] += shift_c
+        nxt = _try_place(out, node["arr"], node["top"], node["left"], 0)
+        if nxt is None:
