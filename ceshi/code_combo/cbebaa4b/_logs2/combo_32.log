+        nxt = _try_place(inp, node["arr"], top, left, 0)
+        if nxt is None:
+            return None
+        inp = nxt
+        ph, pw = node["arr"].shape
+        occ[top : top + ph, left : left + pw] |= node["arr"] != 0
+        node["scatter_top"] = top
+        node["scatter_left"] = left
+
