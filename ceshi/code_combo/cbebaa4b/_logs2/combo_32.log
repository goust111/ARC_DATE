+    if not all(projs[i] > projs[i + 1] for i in range(len(projs) - 1)):
+        return None
+
+    try:
+        solved = main(inp)
+    except Exception:
+        return None
+    if np.array_equal(solved, out):
+        return inp
+    return None
+
+
+def generate_input() -> np.ndarray:
