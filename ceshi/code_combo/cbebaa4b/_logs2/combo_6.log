   379	def _bar_endpoint(shape, side, hub):
   380	    h, w = shape
   381	    hr, hc = hub
   382	    if side in ("top", "bottom"):
   383	        row = 0 if side == "top" else h - 1
   384	        return (row, min(max(hc, 1), w - 2))
