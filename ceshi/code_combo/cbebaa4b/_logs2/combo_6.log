   351	        [(r, er, c, True), (c, ec, er, False)]
   352	        if order == 0
   353	        else [(c, ec, r, False), (r, er, ec, True)]
   354	    )
   355	    for a_start, a_end, fixed, is_row in axes:
   356	        step = 1 if a_end >= a_start else -1
   357	        for value in range(a_start, a_end + step, step):
   358	            rr, cc = (value, fixed) if is_row else (fixed, value)
   359	            if arr[rr, cc] != 2:
   360	                arr[rr, cc] = color
   361	
   362	
   363	def _paint_bar(arr, side, color, used):
   364	    h, w = arr.shape
   365	    is_horizontal = side in ("top", "bottom")
   366	    fixed = 0 if side in ("top", "left") else (h - 1 if side == "bottom" else w - 1)
   367	    span = w if is_horizontal else h
   368	    lo_conflict = "left" if is_horizontal else "top"
   369	    hi_conflict = "right" if is_horizontal else "bottom"
