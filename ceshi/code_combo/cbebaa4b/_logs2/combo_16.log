+    if side == "bottom":
+        return int(np.sum(arr[-1, :] == 2))
+    if side == "left":
+        return int(np.sum(arr[:, 0] == 2))
+    return int(np.sum(arr[:, -1] == 2))
+
+
+def _try_stamp(canvas: np.ndarray, arr: np.ndarray, top: int, left: int, bg: int = 0) -> np.ndarray | None:
+    h, w = canvas.shape
+    ph, pw = arr.shape
