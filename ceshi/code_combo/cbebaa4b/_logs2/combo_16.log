+
+def _bar_endpoint(shape: tuple[int, int], side: str, hub: tuple[int, int]) -> tuple[int, int]:
+    h, w = shape
+    hr, hc = hub
+    if side == "top":
+        return 0, min(max(hc, 1), w - 2)
+    if side == "bottom":
+        return h - 1, min(max(hc, 1), w - 2)
+    if side == "left":
+        return min(max(hr, 1), h - 2), 0
+    return min(max(hr, 1), h - 2), w - 1
