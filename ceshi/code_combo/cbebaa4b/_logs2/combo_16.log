+    if np.any(mask & (sub != bg)):
+        return None
+    out = canvas.copy()
+    out[top : top + ph, left : left + pw][mask] = arr[mask]
+    return out
+
+
+def _adjacent_top_left(
+    piece: dict, target_red: tuple[int, int], target_side: str
