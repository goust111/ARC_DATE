+    arr[1 : 1 + bh, 1 : 1 + bw] = 4
+    for side in SIDES:
+        r, c = _port_cell(node["shape"], side, node["ports"][side])
+        arr[r, c] = 2
+    return arr
+
+
+def _make_piece(node: dict) -> np.ndarray | None:
+    h, w = node["shape"]
+    color = node["color"]
+    side = node["side"]
+    arr = np.zeros((h, w), dtype=int)
