+        len(set(node["roles"].values())) == 2 for node in nodes[1:] if node["roles"]
+    )
+    used_output_colors = {
+        color
+        for node in nodes
+        for color in node["port_colors"].values()
+        if color in OUTPUT_COLORS
+    }
