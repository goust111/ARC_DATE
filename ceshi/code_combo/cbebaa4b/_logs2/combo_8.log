   281	    bg = 0
   282	
   283	    pieces = _extract_pieces(g, bg)
   284	    assert pieces, "input must have at least one colored piece"
   285	
   286	    anchors = []
   287	    for piece in pieces:
   288	        info = _line_anchor_info(piece["arr"])
   289	        if info is not None:
   290	            piece["anchor_info"] = info
   291	            anchors.append(piece)
   292	    assert len(anchors) == 1, "input must have exactly one yellow line-anchor piece"
   293	    anchor = anchors[0]
   294	    axis = anchor["anchor_info"]["axis"]
   295	    rest = [p for p in pieces if p is not anchor]
   296	
   297	    for piece in rest:
   298	        info = _piece_axis_info(piece["arr"], axis)
   299	        assert info is not None, "all non-anchor pieces must use only the anchor axis for red ports"
   300	        piece["axis_info"] = info
   301	
   302	    canvas = np.full((h, w), bg, dtype=int)
   303	    ar0, ac0, _, _ = anchor["bbox"]
   304	    placed = _try_place(canvas, anchor["arr"], ar0, ac0, bg)
   305	    assert placed is not None, "anchor piece must fit on canvas at its original position"
   306	
   307	    total_ports = int(sum(len(p["reds"]) for p in pieces))
   308	    assert total_ports % 2 == 0, "total red connector ports must be even for complete pairing"
   309	    target_unique_red = total_ports // 2
   310	
   311	    red_counts: dict[tuple[int, int], int] = {}
   312	    for rr, cc in anchor["reds"]:
   313	        key = (ar0 + rr, ac0 + cc)
   314	        red_counts[key] = red_counts.get(key, 0) + 1
   315	
   316	    solutions: list[np.ndarray] = []
   317	
   318	    def dfs(cur: np.ndarray, remaining: list[dict], rc: dict[tuple[int, int], int]) -> None:
   319	        if len(solutions) >= 2:
   320	            return
   321	
   322	        if not remaining:
   323	            if len(rc) == target_unique_red and all(v == 2 for v in rc.values()):
   324	                solutions.append(cur)
   325	            return
   326	
   327	        if len(rc) > target_unique_red:
   328	            return
   329	
   330	        unpaired = [k for k, v in rc.items() if v == 1]
   331	        if not unpaired:
   332	            return
   333	
   334	        rc1 = {k for k, v in rc.items() if v == 1}
   335	
   336	        best_moves = None
   337	        for tr, tc in unpaired:
   338	            moves = []
   339	            for idx, piece in enumerate(remaining):
   340	                ph, pw = piece["shape"]
   341	                for pr, pc in piece["reds"]:
   342	                    top = tr - pr
   343	                    left = tc - pc
   344	                    if top < 0 or left < 0 or top + ph > h or left + pw > w:
   345	                        continue
   346	                    bad = False
   347	                    overlap = 0
   348	                    for rr, cc in piece["reds"]:
   349	                        gr, gc = top + rr, left + cc
   350	                        prev = rc.get((gr, gc), 0)
   351	                        if prev >= 2:
   352	                            bad = True
   353	                            break
   354	                        if (gr, gc) in rc1:
   355	                            overlap += 1
   356	                    if not bad:
   357	                        moves.append((idx, top, left, overlap))
   358	            if not moves:
   359	                return
   360	            if best_moves is None or len(moves) < len(best_moves):
   361	                best_moves = moves
   362	                if len(best_moves) == 1:
   363	                    break
   364	
   365	        assert best_moves is not None, "there must be at least one feasible connector move"
   366	
   367	        dedup: dict[tuple[int, int, int], int] = {}
   368	        for idx, top, left, ov in best_moves:
   369	            key = (idx, top, left)
   370	            dedup[key] = max(dedup.get(key, 0), ov)
   371	        moves2 = [(idx, top, left, ov) for (idx, top, left), ov in dedup.items()]
   372	        moves2.sort(key=lambda x: (-x[3], -remaining[x[0]]["area"], x[1], x[2], x[0]))
   373	
   374	        for idx, top, left, _ov in moves2:
   375	            piece = remaining[idx]
   376	            next_remaining = remaining[:idx] + remaining[idx + 1 :]
   377	            next_rc = dict(rc)
   378	            for rr, cc in piece["reds"]:
   379	                gr, gc = top + rr, left + cc
   380	                next_rc[(gr, gc)] = next_rc.get((gr, gc), 0) + 1
   381	
   382	            nxt = _try_place(cur, piece["arr"], top, left, bg)
   383	            if nxt is None:
   384	                continue
   385	            dfs(nxt, next_remaining, next_rc)
   386	            if len(solutions) >= 2:
   387	                return
   388	
   389	    dfs(placed, rest, red_counts)
   390	    assert len(solutions) == 1, "jigsaw assembly must have exactly one valid solution"
   391	    return solutions[0]
   392	
   393	
   394	# --------------- generator ---------------
   395	
   396	# Canvas
   397	GRID_H_RANGE = (22, 26)
   398	GRID_W_RANGE = (22, 26)
   399	MAX_ASSEMBLY_DIM = 24
   400	
   401	# Pieces
   402	PIECE_COUNT_RANGE = (4, 6)
   403	PIECE_H_RANGE = (4, 7)
   404	PIECE_W_RANGE = (4, 8)
   405	PIECE_DIM_CANDIDATES = 12
   406	PIECE_COLORS = [1, 3, 5, 6, 7, 8, 9]
   407	BAR_SKIP_PROB = 0.35
   408	
   409	# Anchor
   410	ANCHOR_ORIENTATIONS = ("horizontal", "vertical")
   411	ANCHOR_LINE_LENGTHS = (5, 6, 7)
   412	
   413	# Scatter
   414	SCATTER_PADDING = 2
   415	
   416	# Generation
   417	GEN_RETRY_LIMIT = 400
   418	
   419	
   420	def _new_node(kind, h, w, color, axis, top=0, left=0):
   421	    return {
   422	        "kind": kind,
   423	        "shape": (int(h), int(w)),
   424	        "color": int(color),
   425	        "axis": axis,
   426	        "top": int(top),
   427	        "left": int(left),
   428	        "sides": set(),
   429	        "ports": {},
   430	    }
   431	
   432	
   433	def _ensure_port(node, side):
   434	    if node["kind"] == "anchor" or side in node["ports"]:
   435	        return
   436	    h, w = node["shape"]
   437	    if side in ("left", "right"):
   438	        lo, hi = 1, h - 3
   439	    else:
   440	        lo, hi = 1, w - 3
   441	    node["ports"][side] = (lo + hi) // 2
   442	
   443	
   444	def _port_cells(node, side):
   445	    if node["kind"] == "anchor":
   446	        h, w = node["shape"]
   447	        if node["axis"] == "horizontal":
   448	            if side == "left":
   449	                return [(1, 0), (2, 0)]
   450	            return [(1, w - 1), (2, w - 1)]
   451	        if side == "top":
   452	            return [(0, 1), (0, 2)]
   453	        return [(h - 1, 1), (h - 1, 2)]
   454	
   455	    h, w = node["shape"]
   456	    k = node["ports"][side]
   457	    if side == "top":
   458	        return [(0, k), (0, k + 1)]
   459	    if side == "bottom":
   460	        return [(h - 1, k), (h - 1, k + 1)]
   461	    if side == "left":
   462	        return [(k, 0), (k + 1, 0)]
   463	    return [(k, w - 1), (k + 1, w - 1)]
   464	
   465	
   466	def _global_port(node, side):
   467	    tr, tc = node["top"], node["left"]
   468	    return [(tr + r, tc + c) for r, c in _port_cells(node, side)]
   469	
   470	
   471	def _bbox_of(node):
   472	    h, w = node["shape"]
   473	    return (node["top"], node["left"], node["top"] + h - 1, node["left"] + w - 1)
   474	
   475	
   476	def _rects_overlap(a, b):
   477	    return not (a[2] < b[0] or b[2] < a[0] or a[3] < b[1] or b[3] < a[1])
   478	
   479	
   480	def _union_bbox(nodes):
   481	    boxes = [_bbox_of(node) for node in nodes]
   482	    return (
   483	        min(b[0] for b in boxes),
   484	        min(b[1] for b in boxes),
   485	        max(b[2] for b in boxes),
   486	        max(b[3] for b in boxes),
   487	    )
   488	
   489	
   490	def _draw_path(arr, start, end, color, order):
   491	    r, c = start
   492	    er, ec = end
   493	    axes = (
   494	        [(r, er, c, True), (c, ec, er, False)]
   495	        if order == 0
   496	        else [(c, ec, r, False), (r, er, ec, True)]
   497	    )
   498	    for a_start, a_end, fixed, is_row in axes:
   499	        step = 1 if a_end >= a_start else -1
   500	        for v in range(a_start, a_end + step, step):
   501	            rr, cc = (v, fixed) if is_row else (fixed, v)
   502	            if arr[rr, cc] != 2:
   503	                arr[rr, cc] = color
   504	
   505	
   506	def _paint_bar(arr, side, color, used):
   507	    h, w = arr.shape
   508	    is_horizontal = side in ("top", "bottom")
   509	    fixed = 0 if side in ("top", "left") else (h - 1 if side == "bottom" else w - 1)
   510	    span = w if is_horizontal else h
   511	    lo_conflict = "left" if is_horizontal else "top"
   512	    hi_conflict = "right" if is_horizontal else "bottom"
   513	    for i in range(span):
   514	        if (i == 0 and lo_conflict in used) or (i == span - 1 and hi_conflict in used):
   515	            continue
   516	        if is_horizontal:
   517	            arr[fixed, i] = color
   518	        else:
   519	            arr[i, fixed] = color
   520	
   521	
   522	def _bar_endpoint(shape, side, hub):
   523	    h, w = shape
   524	    hr, hc = hub
   525	    if side in ("top", "bottom"):
   526	        row = 0 if side == "top" else h - 1
   527	        return (row, min(max(hc, 1), w - 2))
   528	    col = 0 if side == "left" else w - 1
   529	    return (min(max(hr, 1), h - 2), col)
   530	
   531	
   532	def _decorative_sides(node) -> list[str]:
   533	    axis_sides = set(AXIS_SIDES[node["axis"]])
   534	    used = set(node["sides"])
   535	    bars = [side for side in SIDES if side not in axis_sides and side not in used]
   536	    free_axis = [side for side in AXIS_SIDES[node["axis"]] if side not in used]
   537	    if len(used) == 1 and free_axis:
   538	        bars.append(free_axis[0])
   539	    return bars
   540	
   541	
   542	def _make_piece(node):
   543	    h, w = node["shape"]
   544	    color = node["color"]
   545	    used = set(node["sides"])
   546	    arr = np.zeros((h, w), dtype=int)
   547	    hub = (min(max(h // 2, 1), h - 2), min(max(w // 2, 1), w - 2))
   548	
   549	    bar_sides = _decorative_sides(node)
   550	    if len(bar_sides) > 1 and random.random() < BAR_SKIP_PROB:
   551	        bar_sides.remove(random.choice(bar_sides))
   552	    for side in bar_sides:
   553	        _paint_bar(arr, side, color, used)
   554	
   555	    terminals = []
   556	    for side in used:
   557	        _ensure_port(node, side)
   558	        dr, dc = INWARD[side]
   559	        for r, c in _port_cells(node, side):
   560	            arr[r, c] = 2
   561	            rr, cc = r + dr, c + dc
   562	            arr[rr, cc] = color
   563	            terminals.append((rr, cc))
   564	
   565	    arr[hub] = color
   566	    order = random.randint(0, 1)
   567	    for terminal in terminals:
   568	        _draw_path(arr, terminal, hub, color, order)
   569	    for side in bar_sides:
   570	        _draw_path(arr, hub, _bar_endpoint((h, w), side, hub), color, 1 - order)
   571	
   572	    if len(components_mask(arr != 0, connectivity=4)) != 1:
   573	        return None
   574	    if _piece_axis_info(arr, node["axis"]) is None:
   575	        return None
   576	    return arr
   577	
   578	
   579	def _make_anchor(node):
   580	    h, w = node["shape"]
   581	    arr = np.zeros((h, w), dtype=int)
   582	    line_len = node["line_len"]
   583	    if node["axis"] == "horizontal":
   584	        arr[1, 1 : 1 + line_len] = 4
   585	    else:
   586	        arr[1 : 1 + line_len, 1] = 4
   587	    for side in AXIS_SIDES[node["axis"]]:
   588	        for r, c in _port_cells(node, side):
   589	            arr[r, c] = 2
   590	    if len(components_mask(arr != 0, connectivity=4)) != 1:
   591	        return None
   592	    if _line_anchor_info(arr) is None:
   593	        return None
   594	    return arr
   595	
   596	
   597	def _candidate_fits(nodes, parent_i, child):
   598	    child_box = _bbox_of(child)
   599	    if not _rects_overlap(child_box, _bbox_of(nodes[parent_i])):
   600	        return False
   601	    for idx, other in enumerate(nodes):
   602	        if idx == parent_i:
   603	            continue
   604	        if _rects_overlap(child_box, _bbox_of(other)):
   605	            return False
   606	    r0, c0, r1, c1 = _union_bbox(nodes + [child])
   607	    return (r1 - r0 + 1) <= MAX_ASSEMBLY_DIM and (c1 - c0 + 1) <= MAX_ASSEMBLY_DIM
   608	
   609	
   610	def _attach_child(nodes, parent_i, color, parent_side, child_side_set):
   611	    dims = [
   612	        (random.randint(*PIECE_H_RANGE), random.randint(*PIECE_W_RANGE))
   613	        for _ in range(PIECE_DIM_CANDIDATES)
   614	    ]
   615	    random.shuffle(dims)
   616	    axis = nodes[0]["axis"]
   617	    for ph, pw in dims:
   618	        child = _new_node("piece", ph, pw, color, axis)
   619	        child["sides"].update(child_side_set)
   620	        incoming = OPPOSITE[parent_side]
   621	        assert incoming in child["sides"], "child must expose the incoming axis side"
   622	        parent = nodes[parent_i]
   623	        parent["sides"].add(parent_side)
   624	        _ensure_port(parent, parent_side)
   625	        _ensure_port(child, incoming)
   626	        pr, pc = _global_port(parent, parent_side)[0]
   627	        cr, cc = _port_cells(child, incoming)[0]
   628	        child["top"] = pr - cr
   629	        child["left"] = pc - cc
   630	        if not _candidate_fits(nodes, parent_i, child):
   631	            continue
   632	        nodes.append(child)
   633	        return len(nodes) - 1
   634	    return None
   635	
   636	
   637	def _grow_tree():
   638	    axis = random.choice(ANCHOR_ORIENTATIONS)
   639	    line_len = random.choice(ANCHOR_LINE_LENGTHS)
   640	    ah, aw = (4, line_len + 2) if axis == "horizontal" else (line_len + 2, 4)
   641	    anchor = _new_node("anchor", ah, aw, 4, axis)
   642	    anchor["line_len"] = line_len
   643	    nodes = [anchor]
   644	
   645	    n_pieces = random.randint(*PIECE_COUNT_RANGE)
   646	    colors = random.sample(PIECE_COLORS, n_pieces)
   647	    left_branch_len = n_pieces // 2
   648	    right_branch_len = n_pieces - left_branch_len
   649	    branch_sides = AXIS_SIDES[axis]
   650	    branch_lengths = [left_branch_len, right_branch_len]
   651	    if random.random() < 0.5:
   652	        branch_lengths.reverse()
   653	
   654	    color_idx = 0
   655	    for branch_side, branch_len in zip(branch_sides, branch_lengths):
   656	        parent_i = 0
   657	        outgoing_side = branch_side
   658	        incoming_side = OPPOSITE[branch_side]
   659	        for step in range(branch_len):
   660	            child_sides = {incoming_side}
   661	            if step < branch_len - 1:
   662	                child_sides.add(outgoing_side)
   663	            idx = _attach_child(nodes, parent_i, colors[color_idx], branch_side, child_sides)
   664	            if idx is None:
   665	                return None
   666	            parent_i = idx
   667	            color_idx += 1
   668	    return nodes
   669	
   670	
   671	def _place_node_on_canvas(out, node, sr, sc):
   672	    arr = node["arr"]
   673	    top, left = node["top"] + sr, node["left"] + sc
   674	    node["pos"] = (top, left)
   675	    red_counts = {}
   676	    mask = arr != 0
   677	    rows, cols = np.nonzero(mask)
   678	    g_rows, g_cols = rows + top, cols + left
   679	    vals = arr[rows, cols]
   680	    cur_vals = out[g_rows, g_cols]
   681	    conflicts = (cur_vals != 0) & ~((cur_vals == 2) & (vals == 2))
   682	    if np.any(conflicts):
   683	        return None
   684	    red_mask = vals == 2
   685	    for gr, gc in zip(g_rows[red_mask], g_cols[red_mask]):
   686	        key = (int(gr), int(gc))
   687	        red_counts[key] = red_counts.get(key, 0) + 1
   688	    paint_mask = cur_vals == 0
   689	    out[g_rows[paint_mask], g_cols[paint_mask]] = vals[paint_mask]
   690	    return red_counts
   691	
   692	
   693	def _assemble(nodes, h, w):
   694	    for node in nodes:
   695	        node["arr"] = _make_anchor(node) if node["kind"] == "anchor" else _make_piece(node)
   696	        if node["arr"] is None:
   697	            return None
   698	
   699	    r0, c0, r1, c1 = _union_bbox(nodes)
   700	    if (r1 - r0 + 1) > h or (c1 - c0 + 1) > w:
   701	        return None
   702	    sr = random.randint(-r0, h - 1 - r1)
   703	    sc = random.randint(-c0, w - 1 - c1)
   704	
   705	    out = np.zeros((h, w), dtype=int)
   706	    all_red_counts = {}
   707	    for node in nodes:
   708	        rc = _place_node_on_canvas(out, node, sr, sc)
   709	        if rc is None:
   710	            return None
   711	        for key, value in rc.items():
   712	            all_red_counts[key] = all_red_counts.get(key, 0) + value
   713	
   714	    total_ports = sum(int(np.sum(node["arr"] == 2)) for node in nodes)
   715	    if len(all_red_counts) * 2 != total_ports:
   716	        return None
   717	    if any(value != 2 for value in all_red_counts.values()):
   718	        return None
   719	    if len(components_mask(out != 0, connectivity=4)) != 1:
   720	        return None
   721	    return out
   722	
   723	
   724	def _scatter(nodes, h, w):
   725	    inp = np.zeros((h, w), dtype=int)
   726	    anchor = nodes[0]
   727	    paste(inp, anchor["arr"], *anchor["pos"], transparent=0)
   728	    rest = nodes[1:]
   729	    random.shuffle(rest)
   730	    for node in rest:
   731	        try:
   732	            r, c = random_free_location(
   733	                inp,
   734	                node["arr"],
   735	                transparent=0,
   736	                padding=SCATTER_PADDING,
   737	                padding_connectivity=8,
   738	            )
   739	        except ValueError:
   740	            return None
   741	        paste(inp, node["arr"], r, c, transparent=0)
   742	    return inp
   743	
   744	
   745	def _fusion_metrics(inp: np.ndarray) -> dict:
   746	    pieces = _extract_pieces(inp, 0)
   747	    anchors = []
   748	    for piece in pieces:
   749	        info = _line_anchor_info(piece["arr"])
   750	        if info is not None:
   751	            piece["anchor_info"] = info
   752	            anchors.append(piece)
   753	    if len(anchors) != 1:
   754	        raise ValueError("metric computation requires exactly one anchor")
   755	    anchor = anchors[0]
   756	    axis = anchor["anchor_info"]["axis"]
   757	    rest = [p for p in pieces if p is not anchor]
   758	    axis_pure = sum(_piece_axis_info(p["arr"], axis) is not None for p in rest) / max(len(rest), 1)
   759	
   760	    solved = main(inp)
   761	    yr0, yc0, yr1, yc1 = _anchor_global_yellow_bbox(anchor)
   762	    if axis == "horizontal":
   763	        extends_neg = bool(np.any(solved[:, : max(yc0 - 1, 0)] != 0))
   764	        extends_pos = bool(np.any(solved[:, yc1 + 2 :] != 0))
   765	    else:
   766	        extends_neg = bool(np.any(solved[: max(yr0 - 1, 0), :] != 0))
   767	        extends_pos = bool(np.any(solved[yr1 + 2 :, :] != 0))
   768	    return {
   769	        "axis": axis,
   770	        "axis_pure": float(axis_pure),
   771	        "extends_both_ends": bool(extends_neg and extends_pos),
   772	    }
   773	
   774	
   775	def _gen_attempt():
   776	    h = random.randint(*GRID_H_RANGE)
   777	    w = random.randint(*GRID_W_RANGE)
   778	    nodes = _grow_tree()
   779	    if nodes is None:
   780	        return None
   781	    out = _assemble(nodes, h, w)
   782	    if out is None:
   783	        return None
   784	    inp = _scatter(nodes, h, w)
   785	    if inp is None:
   786	        return None
   787	    try:
   788	        solved = main(inp)
   789	        metrics = _fusion_metrics(inp)
   790	    except Exception:
   791	        return None
   792	    if not np.array_equal(solved, out):
   793	        return None
   794	    if metrics["axis_pure"] != 1.0 or not metrics["extends_both_ends"]:
   795	        return None
   796	    return inp
   797	
   798	
   799	def generate_input() -> np.ndarray:
   800	    for _ in range(GEN_RETRY_LIMIT):
   801	        grid = _gen_attempt()
   802	        if grid is not None:
   803	            return grid
   804	    raise RuntimeError("failed to generate a valid cbebaa4b combo input")

