PIECE_H_RANGE = (4, 7)
PIECE_W_RANGE = (4, 8)
PIECE_DIM_CANDIDATES = 12
PIECE_COLORS = [1, 3, 5, 6, 7, 8, 9]
PIECE_CAP = 2
BAR_SKIP_PROB = 0.35

# Anchor
ANCHOR_ORIENTATIONS = ("horizontal", "vertical")
ANCHOR_LINE_LENGTHS = (5, 6, 7)
ANCHOR_CAP = 2

# Scatter
SCATTER_PADDING = 2

