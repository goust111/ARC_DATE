+    tm["sides"] = {"bottom", "left", "right"}
+    tl["sides"] = {"right", "bottom"}
+    bl["sides"] = {"top", "right"}
+    br["sides"] = {"left", "top"}
+    tr["sides"] = {"left", "bottom"}
+
+    tm["trace_sides"] = {"bottom"}
+    tl["trace_sides"] = {"right"}
+    bl["trace_sides"] = {"top"}
+    br["trace_sides"] = {"top"}
+    tr["trace_sides"] = {"left"}
