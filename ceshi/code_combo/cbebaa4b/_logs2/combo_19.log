        solved = mod.main(inp)
    except Exception as e:
        counts[f'main_fail:{type(e).__name__}'] += 1
        continue
    if (solved == expected).all():
        counts['ok'] += 1
    else:
        counts['mismatch'] += 1
print(counts)
