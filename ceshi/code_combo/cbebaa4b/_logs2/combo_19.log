+
+    expected = _expected_output_from_nodes(erased, nodes)
+    if not _combo_visible(inp, expected):
+        return None
+
+    try:
+        solved = main(inp)
+    except Exception:
+        return None
+    if np.array_equal(solved, expected):
+        return inp
+    return None
+
