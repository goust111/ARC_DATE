+
+    try:
+        solved = main(inp)
+    except Exception:
+        return None
+    if np.array_equal(solved, expected):
+        return inp
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRY_LIMIT):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid cbebaa4b combo input")

