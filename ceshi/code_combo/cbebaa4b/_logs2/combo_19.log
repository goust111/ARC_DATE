+def _build_ring_nodes() -> list[dict] | None:
+    bh, bw = ANCHOR_BLOCK_CHOICES[0]
+    anchor = _new_node("anchor", bh + 2, bw + 2, 4, top=0, left=0)
+    anchor["block"] = (bh, bw)
