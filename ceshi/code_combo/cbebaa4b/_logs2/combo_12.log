+def _trail_cells(start: tuple[int, int], end: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = map(int, start)
+    er, ec = map(int, end)
+    cells = [(r, c)]
+    row_first = abs(er - r) >= abs(ec - c)
+
+    while (r, c) != (er, ec):
+        axes = ("row", "col") if row_first else ("col", "row")
+        for axis in axes:
+            if axis == "row" and r != er:
+                r += 1 if er > r else -1
+            elif axis == "col" and c != ec:
+                c += 1 if ec > c else -1
+            else:
