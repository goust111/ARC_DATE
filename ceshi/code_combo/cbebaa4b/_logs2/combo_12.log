+    prev_target = 0.0
+    for i, depth in enumerate(depth_levels):
+        need = float(depth_floor[depth] + MIN_RADIAL_EXTENSION)
+        if i == 0:
+            target = need
+        else:
+            target = max(need, prev_target + 0.25)
+        targets[depth] = float(target)
+        prev_target = float(target)
