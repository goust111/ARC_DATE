+    at, al = anchor["top"], anchor["left"]
+    ah, aw = anchor["shape"]
+    anchor_center_r = at + (ah - 1) / 2.0
+    anchor_center_c = al + (aw - 1) / 2.0
+    target_r = (h - 1) / 2.0
+    target_c = (w - 1) / 2.0
+    base_sr = int(round(target_r - anchor_center_r))
+    base_sc = int(round(target_c - anchor_center_c))
