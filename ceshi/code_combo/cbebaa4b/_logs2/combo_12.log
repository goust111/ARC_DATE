+def _ordered_scatter_ok(nodes):
+    depths = [float(node["depth"]) for node in nodes[1:]]
+    radii = [float(node["scatter_radius"]) for node in nodes[1:]]
+    trails = [float(node["trail_len"]) for node in nodes[1:]]
