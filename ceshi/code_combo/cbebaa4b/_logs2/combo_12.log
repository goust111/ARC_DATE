+
+def _new_node(kind, h, w, color, top=0, left=0, cap=PIECE_CAP, uid=-1):
+    return {
+        "uid": int(uid),
+        "kind": kind,
+        "shape": (int(h), int(w)),
+        "color": int(color),
+        "top": int(top),
+        "left": int(left),
+        "cap": int(cap),
+        "sides": set(),
+        "ports": {},
+        "depth": 0,
+        "parent_uid": -1,
+    }
