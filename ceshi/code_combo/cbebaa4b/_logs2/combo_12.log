+
+def _trail_local_cell(arr: np.ndarray, bg: int) -> tuple[int, int]:
+    color = _piece_color(arr, bg)
+    coords = np.argwhere(arr == color)
+    center = coords.mean(axis=0)
+    best = min(
+        (
+            (
+                float((r - center[0]) ** 2 + (c - center[1]) ** 2),
+                int(r),
+                int(c),
+            )
+            for r, c in coords
+        )
+    )
+    return int(best[1]), int(best[2])
