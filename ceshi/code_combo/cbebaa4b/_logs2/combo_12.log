+
+def _ring_plan(nodes, h, w):
+    pieces = nodes[1:]
+    depth_levels = sorted({int(node["depth"]) for node in pieces})
+    if len(depth_levels) < MIN_DISTINCT_DEPTHS:
+        return None
+
+    anchor_center = nodes[0]["assembled_center"]
+    depth_floor = {
