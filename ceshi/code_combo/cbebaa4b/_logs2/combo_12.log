+        if len(solutions) >= 2:
+            return
+
+        if not remaining:
+            if len(rc) == target_unique_red and all(v == 2 for v in rc.values()):
+                solutions.append((cur, dict(placements)))
+            return
+
+        if len(rc) > target_unique_red:
+            return
+
+        unpaired = [k for k, v in rc.items() if v == 1]
+        if not unpaired:
+            return
+
+        rc1 = {k for k, v in rc.items() if v == 1}
+
+        best_moves = None
+        for t in unpaired:
+            moves = []
+            tr, tc = t
+            for idx, p in enumerate(remaining):
+                ph, pw = p["shape"]
+                for pr, pc in p["reds"]:
+                    top = tr - pr
+                    left = tc - pc
+                    if top < 0 or left < 0 or top + ph > h or left + pw > w:
+                        continue
+                    bad = False
+                    overlap = 0
+                    for rr, cc in p["reds"]:
+                        gr, gc = top + rr, left + cc
+                        prev = rc.get((gr, gc), 0)
+                        if prev >= 2:
+                            bad = True
+                            break
+                        if (gr, gc) in rc1:
+                            overlap += 1
+                    if bad:
