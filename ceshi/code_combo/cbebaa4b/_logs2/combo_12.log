+# --------------- generator (D5 trail + D15 ordered scatter) ---------------
+
+# Canvas
+GRID_H_RANGE = (22, 26)
+GRID_W_RANGE = (22, 26)
+MAX_ASSEMBLY_DIM = 18
+ASSEMBLY_JITTER = 1
+
+# Pieces
+PIECE_COUNT_RANGE = (4, 6)
+PIECE_H_RANGE = (4, 7)
+PIECE_W_RANGE = (4, 8)
+PIECE_DIM_CANDIDATES = 12
+PIECE_COLORS = [1, 3, 5, 6, 7, 8, 9]
+PIECE_CAP = 2
+BAR_SKIP_PROB = 0.35
+
+# Anchor
+ANCHOR_BLOCK_CHOICES = [(3, 3), (4, 5)]
+ANCHOR_CAP_CHOICES = [1, 2]
+
+# Scatter / behavior
+SCATTER_PADDING = 2
+MIN_TRAIL_CELLS = 5
+SCATTER_CANDIDATE_KEEP = 28
+MIN_DISTINCT_DEPTHS = 3
+MIN_MAX_DEPTH = 3
+MIN_RADIAL_EXTENSION = 2.5
+MIN_ALIGNMENT = 0.15
+MIN_RADIUS_CORR = 0.88
+MIN_TRAIL_CORR = 0.72
+
+# Generation
+GEN_RETRY_LIMIT = 400
+FAST_POOL_SIZE = 3
+
+SIDES = ("top", "right", "bottom", "left")
+OPPOSITE = {"top": "bottom", "bottom": "top", "left": "right", "right": "left"}
+INWARD = {"top": (1, 0), "bottom": (-1, 0), "left": (0, 1), "right": (0, -1)}
+
+
+def _new_node(kind, h, w, color, top=0, left=0, cap=PIECE_CAP, uid=-1):
+    return {
+        "uid": int(uid),
+        "kind": kind,
+        "shape": (int(h), int(w)),
+        "color": int(color),
+        "top": int(top),
+        "left": int(left),
+        "cap": int(cap),
+        "sides": set(),
+        "ports": {},
+        "depth": 0,
+        "parent_uid": -1,
+    }
+
+
+def _ensure_port(node, side):
+    if side in node["ports"]:
+        return
+    h, w = node["shape"]
+    span = h if side in ("left", "right") else w
+    node["ports"][side] = random.randint(1, span - 3)
+
+
+def _port_cells(node, side):
+    h, w = node["shape"]
+    k = node["ports"][side]
+    if side == "top":
+        return [(0, k), (0, k + 1)]
+    if side == "bottom":
+        return [(h - 1, k), (h - 1, k + 1)]
+    if side == "left":
