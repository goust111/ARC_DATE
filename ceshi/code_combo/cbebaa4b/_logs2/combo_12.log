+        if not placed:
+            return None
+
+    depths = [int(n["depth"]) for n in nodes[1:]]
+    if not depths:
+        return None
+    if len(set(depths)) < MIN_DISTINCT_DEPTHS or max(depths) < MIN_MAX_DEPTH or max(depths) > MAX_TREE_DEPTH:
+        return None
+    return nodes
