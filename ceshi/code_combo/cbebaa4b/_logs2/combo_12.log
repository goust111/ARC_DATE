+    if len(depth_levels) < MIN_DISTINCT_DEPTHS:
+        return None
+
+    anchor_center = nodes[0]["assembled_center"]
+    edge_room = min(
+        anchor_center[0],
+        h - 1 - anchor_center[0],
+        anchor_center[1],
+        w - 1 - anchor_center[1],
+    )
+    max_radius = float(edge_room - 1.2)
+    min_radius = 4.6
+    if max_radius <= min_radius + 1.5:
+        return None
+
+    if len(depth_levels) == 1:
+        step = 0.0
+    else:
+        step = (max_radius - min_radius) / (len(depth_levels) - 1)
+    if len(depth_levels) > 1 and step < 1.15:
+        return None
+
+    band = max(0.95, min(1.45, step * 0.48 if step > 0 else 1.2))
+    targets = {
+        depth: float(min_radius + i * step)
+        for i, depth in enumerate(depth_levels)
