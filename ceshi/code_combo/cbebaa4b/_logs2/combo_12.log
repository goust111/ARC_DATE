+def _piece_trail(
+    piece: dict, src_top: int, src_left: int, dst_top: int, dst_left: int
+) -> list[tuple[int, int]]:
+    rr, cc = piece["trail_local"]
+    start = (int(src_top + rr), int(src_left + cc))
+    end = (int(dst_top + rr), int(dst_left + cc))
+    return _trail_cells(start, end)
