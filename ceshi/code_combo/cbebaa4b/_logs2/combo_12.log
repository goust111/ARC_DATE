+        for _err, _neg_align, _neg_trail, _noise, top, left, trail, radius in cands:
+            nxt_inp = cur_inp.copy()
+            paste(nxt_inp, node["arr"], top, left, transparent=0)
+            nxt_owner = cur_owner.copy()
