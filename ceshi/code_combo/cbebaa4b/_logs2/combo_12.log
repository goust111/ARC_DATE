+            node["scatter_pos"] = (int(top), int(left))
+            node["scatter_radius"] = float(radius)
+            node["trail_len"] = int(len(trail))
+            nxt_remaining = remaining[:pick_idx] + remaining[pick_idx + 1 :]
+            res = search(nxt_remaining, nxt_inp, nxt_owner)
+            if res is not None:
