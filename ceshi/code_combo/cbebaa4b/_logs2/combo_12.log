+    if len(depth_levels) < MIN_DISTINCT_DEPTHS:
+        return None
+
+    anchor_center = nodes[0]["assembled_center"]
+    depth_floor = {
+        depth: max(float(node["assembled_radius"]) for node in pieces if node["depth"] == depth)
