+    try:
+        solved = main(inp)
+    except Exception:
+        return None
+    if np.array_equal(solved, out):
+        return inp
+    return None
+
+
+def _slow_generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRY_LIMIT):
