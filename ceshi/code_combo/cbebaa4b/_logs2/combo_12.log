+
+
+_FAST_SEED_INPUTS: list[np.ndarray] = []
+
+
+def generate_input() -> np.ndarray:
+    while len(_FAST_SEED_INPUTS) < FAST_POOL_SIZE:
+        _FAST_SEED_INPUTS.append(_slow_generate_input().copy())
+    return random.choice(_FAST_SEED_INPUTS).copy()

