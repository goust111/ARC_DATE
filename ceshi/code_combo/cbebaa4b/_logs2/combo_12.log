+# Combo variant of cbebaa4b (index 12)
+# combo_spec: D5/1+D15/0
+# Name: 移动轨迹线 + 精灵按距离排列
+
+from __future__ import annotations
+
+from pathlib import Path
+import sys
+import random
+
+import numpy as np
