+def _assemble(nodes, h, w):
+    for node in nodes:
+        node["arr"] = _make_anchor(node) if node["kind"] == "anchor" else _make_piece(node)
+        if node["arr"] is None:
+            return None
+        node["trail_local"] = _trail_local_cell(node["arr"], 0)
