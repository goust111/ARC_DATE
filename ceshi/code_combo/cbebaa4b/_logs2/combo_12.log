+
+from pathlib import Path
+import sys
+import random
+
+import numpy as np
+
+_ROOT = Path(__file__).resolve().parents[4]
+sys.path.append(str(_ROOT / "solvers"))
+
+from arc_utils import bbox_coords, components_mask, paste
+
