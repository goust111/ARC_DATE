+def _ordered_scatter_ok(nodes):
+    depth_levels = sorted({int(node["depth"]) for node in nodes[1:]})
+    radius_means = {}
+    trail_means = {}
+    for prev_depth, cur_depth in zip(depth_levels, depth_levels[1:]):
