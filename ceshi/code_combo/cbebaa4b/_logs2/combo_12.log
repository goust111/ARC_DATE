+    anchor_center = _center_of(nodes[0]["pos"][0], nodes[0]["pos"][1], nodes[0]["shape"])
+    for node in nodes:
+        node["assembled_center"] = _center_of(node["pos"][0], node["pos"][1], node["shape"])
+        node["assembled_radius"] = _euclid(node["assembled_center"], anchor_center)
+    return out
