+def _bbox_free(inp, top, left, ph, pw, padding):
+    h, w = inp.shape
+    if top < 0 or left < 0 or top + ph > h or left + pw > w:
+        return False
+    r0 = max(0, top - padding)
+    c0 = max(0, left - padding)
+    r1 = min(h, top + ph + padding)
