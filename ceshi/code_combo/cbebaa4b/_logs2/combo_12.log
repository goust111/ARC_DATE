+        if np.any(piece["arr"] == 4):
+            continue
+        src_top, src_left, _, _ = piece["bbox"]
+        dst_top, dst_left = placements[piece["uid"]]
+        for r, c in _piece_trail(piece, src_top, src_left, dst_top, dst_left):
+            if out[r, c] in (bg, piece["color"]):
+                out[r, c] = piece["color"]
