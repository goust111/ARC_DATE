+def _pearson_corr(xs: list[float], ys: list[float]) -> float:
+    if len(xs) < 2 or len(ys) < 2:
+        return 0.0
+    x = np.asarray(xs, dtype=float)
+    y = np.asarray(ys, dtype=float)
+    if float(np.std(x)) < 1e-9 or float(np.std(y)) < 1e-9:
