+
+def _grow_tree():
+    bh, bw = random.choice(ANCHOR_BLOCK_CHOICES)
+    anchor = _new_node(
+        "anchor", bh + 2, bw + 2, 4, cap=random.choice(ANCHOR_CAP_CHOICES), uid=0
