+
+def _port_cells(node, side):
+    h, w = node["shape"]
+    k = node["ports"][side]
+    if side == "top":
+        return [(0, k), (0, k + 1)]
+    if side == "bottom":
+        return [(h - 1, k), (h - 1, k + 1)]
+    if side == "left":
