+
+def _new_node(kind, h, w, color, top=0, left=0, cap=PIECE_CAP, uid=-1):
+    return {
+        "uid": int(uid),
+        "kind": kind,
+        "shape": (int(h), int(w)),
+        "color": int(color),
+        "top": int(top),
+        "left": int(left),
+        "cap": int(cap),
+        "sides": set(),
+        "ports": {},
+        "depth": 0,
+        "parent_uid": -1,
+    }
+
+
+def _ensure_port(node, side):
+    if side in node["ports"]:
+        return
+    h, w = node["shape"]
+    span = h if side in ("left", "right") else w
+    node["ports"][side] = random.randint(1, span - 3)
+
+
+def _port_cells(node, side):
+    h, w = node["shape"]
+    k = node["ports"][side]
+    if side == "top":
+        return [(0, k), (0, k + 1)]
+    if side == "bottom":
+        return [(h - 1, k), (h - 1, k + 1)]
+    if side == "left":
+        return [(k, 0), (k + 1, 0)]
