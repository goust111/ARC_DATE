+def _piece_color(arr: np.ndarray, bg: int) -> int:
+    colors = [int(v) for v in np.unique(arr) if int(v) not in (bg, 2)]
+    assert colors, "piece must contain at least one non-red, non-background color"
+    return colors[0]
