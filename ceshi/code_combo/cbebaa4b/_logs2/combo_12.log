+        cur_r = [node["scatter_radius"] for node in nodes[1:] if node["depth"] == cur_depth]
+        prev_t = [node["trail_len"] for node in nodes[1:] if node["depth"] == prev_depth]
+        cur_t = [node["trail_len"] for node in nodes[1:] if node["depth"] == cur_depth]
