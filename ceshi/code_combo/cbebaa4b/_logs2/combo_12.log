+        choices = []
+        for idx, node in enumerate(remaining):
+            cands = _candidate_scatter_positions(cur_inp, assembled, cur_owner, node, ring_plan)
+            if not cands:
+                return None
+            choices.append((len(cands), -node["depth"], -node["area"], idx, cands))
