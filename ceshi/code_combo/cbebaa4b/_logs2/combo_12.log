+# --------------- generator (D5 trail + D15 ordered scatter) ---------------
+
+# Canvas
+GRID_H_RANGE = (22, 26)
+GRID_W_RANGE = (22, 26)
+MAX_ASSEMBLY_DIM = 14
+ASSEMBLY_JITTER = 1
