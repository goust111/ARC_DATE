+    inp = _scatter(nodes, h, w)
+    if inp is None:
+        return None
+
+    try:
+        solved = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(solved, out):
+        return None
+    if _mixed_piece_count(inp) < 2:
+        return None
+    if _wrong_entry_move_count(inp) == 0:
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRY_LIMIT):
+        grid = _gen_attempt()
+        if grid is not None:
