+    a = _new_node(
+        "piece",
+        random.randint(*PIECE_H_RANGE),
+        random.randint(*PIECE_W_RANGE),
+        random.choice(BODY_COLORS),
+        stage=1,
+        cap=PIECE_CAP,
+    )
+    ia = add_child(0, "right", a, 2)
