+    return (r1 - r0 + 1) <= MAX_ASSEMBLY_DIM and (c1 - c0 + 1) <= MAX_ASSEMBLY_DIM
+
+
+def _grow_tree():
+    n_pieces = random.randint(5, 6)
+    bh, bw = random.choice(ANCHOR_BLOCK_CHOICES)
+    anchor = _new_node("anchor", bh + 2, bw + 2, 4, stage=0, cap=4)
+    anchor["block"] = (bh, bw)
