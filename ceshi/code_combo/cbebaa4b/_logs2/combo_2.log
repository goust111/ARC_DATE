+
+def _grow_tree():
+    n_pieces = random.randint(*PIECE_COUNT_RANGE)
+    seq = _stage_sequence(n_pieces)
+
+    bh, bw = random.choice(ANCHOR_BLOCK_CHOICES)
+    anchor = _new_node("anchor", bh + 2, bw + 2, 4, stage=0, cap=seq.count(1))
+    anchor["block"] = (bh, bw)
+
+    nodes = [anchor]
+    stage_nodes = {0: [0], 1: [], 2: [], 3: []}
+
+    for stage in seq:
+        placed = False
+        dims = [
+            (random.randint(*PIECE_H_RANGE), random.randint(*PIECE_W_RANGE))
+            for _ in range(PIECE_DIM_CANDIDATES)
+        ]
+        random.shuffle(dims)
+        parent_pool = [idx for idx in stage_nodes[stage - 1] if len(nodes[idx]["sides"]) < nodes[idx]["cap"]]
+        random.shuffle(parent_pool)
+        for ph, pw in dims:
