+                    if prev_col != col or prev_count >= 2:
+                        bad = True
+                        break
+                if bad:
+                    continue
+                if _try_place(placed, p["arr"], top, left, bg) is None:
+                    continue
+                illegal_moves.add((idx, top, left, pcol))
+    return len(illegal_moves)
