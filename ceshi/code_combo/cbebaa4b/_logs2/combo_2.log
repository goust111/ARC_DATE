+def _new_node(kind, h, w, color, stage, top=0, left=0, cap=PIECE_CAP):
+    return {
+        "kind": kind,
+        "shape": (int(h), int(w)),
+        "color": int(color),
+        "stage": int(stage),
+        "top": int(top),
+        "left": int(left),
+        "cap": int(cap),
+        "sides": set(),
+        "ports": {},
+        "conn_colors": {},
+    }
