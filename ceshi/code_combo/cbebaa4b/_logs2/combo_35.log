    shared_used = sum(1 for i, p in enumerate(rest) if i in used and piece_body_color(p) == anchor_color)
    distractors = len(rest) - len(used)
    shared_counts[shared_used] += 1
    distractor_counts[distractors] += 1
    combo_pairs[(shared_used, distractors)] += 1

