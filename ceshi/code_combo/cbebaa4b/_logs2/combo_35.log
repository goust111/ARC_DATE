+        rc1 = {k for k, v in rc.items() if v == 1}
+        best_moves = None
+
+        for target in unpaired:
+            moves = []
+            tr, tc = target
+            for idx, p in enumerate(remaining):
+                ph, pw = p["shape"]
+                for pr, pc in p["reds"]:
+                    top = tr - pr
+                    left = tc - pc
+                    if top < 0 or left < 0 or top + ph > h or left + pw > w:
+                        continue
+                    overlap = 0
+                    bad = False
+                    for rr, cc in p["reds"]:
+                        gr, gc = top + rr, left + cc
