+    sr_hi2 = min(sr_hi, sr_target + ANCHOR_CENTER_JITTER)
+    sc_lo2 = max(sc_lo, sc_target - ANCHOR_CENTER_JITTER)
+    sc_hi2 = min(sc_hi, sc_target + ANCHOR_CENTER_JITTER)
