   487	def _paint_bar(arr: np.ndarray, side: str, color: int, used: set[str]) -> None:
   488	    h, w = arr.shape
   489	    is_horizontal = side in ("top", "bottom")
   490	    fixed = 0 if side in ("top", "left") else (h - 1 if side == "bottom" else w - 1)
   491	    span = w if is_horizontal else h
   492	    lo_conflict = "left" if is_horizontal else "top"
   493	    hi_conflict = "right" if is_horizontal else "bottom"
