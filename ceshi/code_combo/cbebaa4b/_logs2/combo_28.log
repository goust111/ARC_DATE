+
+
+GROUP_SPECS = (
+    {"name": "square", "block": (3, 3), "main": 1, "aux": 6},
+    {"name": "wide", "block": (4, 5), "main": 8, "aux": 7},
+    {"name": "tall", "block": (5, 4), "main": 9, "aux": 3},
+)
+BLOCK_TO_GROUP = {spec["block"]: idx for idx, spec in enumerate(GROUP_SPECS)}
