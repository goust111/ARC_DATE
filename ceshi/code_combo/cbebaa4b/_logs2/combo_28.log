+def _assemble_groups(groups: list[dict], h: int, w: int) -> np.ndarray | None:
+    out = np.zeros((h, w), dtype=int)
+    ordered = sorted(groups, key=lambda g: g["patch"].shape[0] * g["patch"].shape[1], reverse=True)
+    for group in ordered:
