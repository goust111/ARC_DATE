+def _relaxed_reproduces(inp: np.ndarray, out: np.ndarray, *, enforce_role: bool, enforce_group: bool) -> bool:
+    sols = _search_solution(inp, enforce_role=enforce_role, enforce_group=enforce_group, max_solutions=2)
