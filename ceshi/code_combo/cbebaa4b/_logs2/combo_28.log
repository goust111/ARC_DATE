+                pos = _align_port(target["cells"], port["cells"])
+                if pos is None:
+                    continue
+                top, left = pos
+                used = 0
+                bad = False
+                for other_port in piece["ports"]:
+                    moved = _translated_port(other_port, top, left)
+                    if moved == target["cells"]:
+                        used += 1
+                        continue
+                    if any(cell in occupied_reds for cell in moved):
