   439	def _port_cells(node: dict, side: str) -> list[tuple[int, int]]:
   440	    h, w = node["shape"]
   441	    k = node["ports"][side]
   442	    if side == "top":
   443	        return [(0, k), (0, k + 1)]
   444	    if side == "bottom":
   445	        return [(h - 1, k), (h - 1, k + 1)]
   446	    if side == "left":
   447	        return [(k, 0), (k + 1, 0)]
   448	    return [(k, w - 1), (k + 1, w - 1)]
