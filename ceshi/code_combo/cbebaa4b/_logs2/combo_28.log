+            return None
+        moves.sort(
+            key=lambda x: (
+                -len(remaining[x[0]]["ports"]),
+                -remaining[x[0]]["area"],
+                x[2],
+                x[3],
+                x[1],
+                x[0],
+            )
+        )
+        if best_moves is None or len(moves) < len(best_moves):
+            best_target = target_id
+            best_moves = moves
+            if len(best_moves) == 1:
