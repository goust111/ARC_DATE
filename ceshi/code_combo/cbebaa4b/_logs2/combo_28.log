   352	def main(grid: np.ndarray) -> np.ndarray:
   353	    """
   354	    Assemble several two-tier connector clusters around fixed yellow anchors while discarding red-bearing decoys.
   355	
   356	    Input structure:
   357	    - bg = black (0). The grid contains 2-3 yellow anchor sprites, several scattered colored sprites, and 1-2 distractor sprites.
   358	    - Each anchor has a distinct yellow block shape, and each shape is paired with one main color and one auxiliary color.
   359	    - Genuine pieces use red (2) two-pixel boundary ports; distractors also contain red but their red layout is not a legal attachment port.
   360	
   361	    Rule:
   362	    - Keep every yellow anchor fixed in place.
   363	    - A main sprite may attach only to a red port on the anchor shape matched to its color; an auxiliary sprite may attach only to leftover ports from a same-group main sprite.
   364	    - Only red-on-red overlap is allowed, and when all open ports are exhausted the leftover scattered components are treated as distractors and omitted from the output.
   365	
   366	    Key insight:
   367	    - Solving requires three visible inferences at once: reject the broken red decoys, classify the remaining sprites into main versus auxiliary by color, and then route each color pair to the correct anchor shape before closing all connector ports.
   368	    """
   369	    sols = _search_solution(
   370	        np.asarray(grid, dtype=int),
   371	        enforce_role=True,
   372	        enforce_group=True,
   373	        max_solutions=2,
   374	    )
   375	    assert len(sols) == 1, "fused multi-anchor hierarchical assembly must have exactly one valid solution"
   376	    return sols[0]
