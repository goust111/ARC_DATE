+
+def _make_distractors(real_nodes: list[dict]) -> list[dict] | None:
+    host_arrays = [node["arr"] for node in real_nodes]
+    distractors = []
+    for _ in range(random.randint(*DISTRACTOR_COUNT_RANGE)):
+        made = None
+        for _attempt in range(DISTRACTOR_ATTEMPTS):
