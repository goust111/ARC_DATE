   265	def _search_solution(
   266	    g: np.ndarray,
   267	    *,
   268	    enforce_role: bool,
   269	    enforce_group: bool,
   270	    max_solutions: int = 2,
   271	) -> list[np.ndarray]:
   272	    g = np.asarray(g, dtype=int)
   273	    h, w = g.shape
   274	    bg = 0
   275	
   276	    pieces = _extract_pieces(g, bg)
   277	    anchors = [p for p in pieces if p["role"] == "anchor"]
   278	    assert 2 <= len(anchors) <= 3, "input must have 2 or 3 valid yellow anchors"
   279	
   280	    real_pieces = [p for p in pieces if p["role"] in {"main", "aux"}]
   281	    mains = [p for p in real_pieces if p["role"] == "main"]
   282	    auxes = [p for p in real_pieces if p["role"] == "aux"]
   283	    if enforce_role:
   284	        assert mains and auxes, "variant inputs must contain both main and auxiliary sprites"
   285	    assert real_pieces, "input must contain valid non-anchor pieces"
   286	
   287	    canvas = np.full((h, w), bg, dtype=int)
   288	    placed = canvas
   289	    open_ports: dict[tuple[tuple[int, int], ...], dict] = {}
   290	    occupied_reds: set[tuple[int, int]] = set()
   291	    for anchor in anchors:
   292	        ar0, ac0, _, _ = anchor["bbox"]
   293	        placed2 = _try_place(placed, anchor["arr"], ar0, ac0, bg)
   294	        assert placed2 is not None, "anchor must fit at its original position"
   295	        placed = placed2
   296	        for port in anchor["ports"]:
   297	            cells = _translated_port(port, ar0, ac0)
   298	            pid = _port_id(cells)
   299	            occupied_reds |= set(cells)
   300	            open_ports[pid] = {
   301	                "cells": cells,
   302	                "accept": "main" if enforce_role else None,
   303	                "group": anchor["group"] if enforce_group else None,
   304	            }
   305	
   306	    solutions: dict[bytes, np.ndarray] = {}
   307	
   308	    def dfs(cur: np.ndarray, rem: list[dict], ports: dict, reds: set[tuple[int, int]]) -> None:
   309	        if len(solutions) >= max_solutions:
   310	            return
   311	        if not ports:
   312	            key = cur.tobytes()
   313	            if key not in solutions:
   314	                solutions[key] = cur.copy()
   315	            return
   316	        if not rem:
   317	            return
   318	
   319	        step = _candidate_moves(cur, rem, ports, reds, bg, enforce_role, enforce_group)
   320	        if step is None:
   321	            return
   322	        target_id, moves = step
   323	        for idx, port_idx, top, left in moves:
   324	            piece = rem[idx]
   325	            nxt = _try_place(cur, piece["arr"], top, left, bg)
   326	            if nxt is None:
   327	                continue
   328	
   329	            next_ports = dict(ports)
   330	            del next_ports[target_id]
   331	            next_reds = set(reds)
   332	            for j, port in enumerate(piece["ports"]):
   333	                moved = _translated_port(port, top, left)
   334	                next_reds |= set(moved)
   335	                if j == port_idx:
   336	                    continue
   337	                next_ports[_port_id(moved)] = {
   338	                    "cells": moved,
   339	                    "accept": "aux" if (enforce_role and piece["role"] == "main") else None,
   340	                    "group": piece["group"] if enforce_group else None,
   341	                }
   342	
   343	            next_rem = rem[:idx] + rem[idx + 1 :]
   344	            dfs(nxt, next_rem, next_ports, next_reds)
   345	            if len(solutions) >= max_solutions:
   346	                return
   347	
   348	    dfs(placed, real_pieces, open_ports, occupied_reds)
   349	    return list(solutions.values())
