   475	def _draw_path(arr: np.ndarray, start: tuple[int, int], end: tuple[int, int], color: int, order: int) -> None:
   476	    r, c = start
   477	    er, ec = end
   478	    axes = [(r, er, c, True), (c, ec, er, False)] if order == 0 else [(c, ec, r, False), (r, er, ec, True)]
