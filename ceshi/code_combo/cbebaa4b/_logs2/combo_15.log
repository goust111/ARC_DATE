+    inp = _scatter_to_edges(nodes, h, w)
+    if inp is None:
+        return None
+    try:
+        solved = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(solved, out):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
