+
+def _ensure_port(node, side):
+    if side in node["ports"]:
+        return
+    h, w = node["shape"]
+    span = h if side in ("left", "right") else w
+    node["ports"][side] = max(1, min(span - 3, span // 2 - 1))
+
+
+def _port_cells(node, side):
+    h, w = node["shape"]
+    k = node["ports"][side]
+    if side == "top":
+        return [(0, k), (0, k + 1)]
+    if side == "bottom":
+        return [(h - 1, k), (h - 1, k + 1)]
+    if side == "left":
