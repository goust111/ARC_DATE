+
+def _new_node(kind, h, w, color, top=0, left=0):
+    return {
+        "kind": kind,
+        "shape": (int(h), int(w)),
+        "color": int(color),
+        "top": int(top),
+        "left": int(left),
+        "sides": set(),
+        "ports": {},
+    }
