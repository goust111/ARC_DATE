+                paste(inp, node["arr"], top, left, transparent=0)
+                node["input_pos"] = (top, left)
+                placed = True
+                break
+            if not placed:
+                return None
+    return inp
+
+
+def _gen_attempt():
+    h = random.randint(*GRID_H_RANGE)
+    w = random.randint(*GRID_W_RANGE)
