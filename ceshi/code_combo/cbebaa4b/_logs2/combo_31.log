+
+def _variant_metrics(nodes) -> dict[str, int]:
+    horizontal_ports = 0
+    vertical_ports = 0
+    orthogonal_nodes = 0
+    slipped_edges = 0
+    slipped_horizontal = 0
+    slipped_vertical = 0
