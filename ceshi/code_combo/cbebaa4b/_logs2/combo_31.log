+        )
+        matchings = [m for m in matchings if m["matched_port_count"] > 0]
+        if not matchings:
+            return None
+        best_quality = max((m["score"], m["matched_port_count"]) for m in matchings)
+        matchings = [
+            m for m in matchings if (m["score"], m["matched_port_count"]) == best_quality
