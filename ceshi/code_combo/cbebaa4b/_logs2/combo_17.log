            solids = [(k - 1, 1), (k + 2, 1), (k - 1, 2), (k + 2, 2)]
            terminals = [(k - 1, 2), (k + 2, 2)]
    elif side == "right":
        red = [(k, w - 2), (k + 1, w - 2)]
        if mode == "plain":
