+def _anchor_notches(anchor_arr: np.ndarray, bg: int) -> list[dict]:
+    notches = []
+    for info in _border_bg_components(anchor_arr, bg):
+        if len(info["sides"]) != 1:
+            continue
+        notches.append(info)
+    notches.sort(key=lambda d: (SIDES.index(d["sides"][0]), min(d["cells"])))
+    return notches
