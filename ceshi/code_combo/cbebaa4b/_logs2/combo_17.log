+    notch_order = sorted(range(len(root_cands_by_notch)), key=lambda i: len(root_cands_by_notch[i]))
+    solutions: list[np.ndarray] = []
+
+    def extend_search(
+        cur_board: np.ndarray,
+        occ: set[tuple[int, int]],
+        chains: list[dict],
+        remaining_ids: set[int],
+        placed_now: list[dict],
