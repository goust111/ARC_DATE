+
+
+def _border_bg_components(arr: np.ndarray, bg: int) -> list[dict]:
+    h, w = map(int, arr.shape)
+    out = []
+    for comp in components_mask(arr == bg, connectivity=4):
+        cells = {(int(r), int(c)) for r, c in comp}
+        sides = []
+        if any(r == 0 for r, _ in cells):
+            sides.append("top")
