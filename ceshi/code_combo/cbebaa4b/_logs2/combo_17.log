+    metrics = _fusion_metrics(inp, out)
+    if metrics["anchor_notch_cells"] <= 0 or metrics["open_cavity_cells"] <= 0:
+        return None
+    if metrics["pieces_with_outward_hole"] < 2:
+        return None
+    return inp
