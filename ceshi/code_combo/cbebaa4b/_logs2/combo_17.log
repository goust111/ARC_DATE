        elif mode == "tab":
            solids = [(k, w - 1), (k + 1, w - 1), (k, w - 3), (k + 1, w - 3)]
            terminals = [(k, w - 3), (k + 1, w - 3)]
        else:
            holes = [(k, w - 3), (k + 1, w - 3)]
