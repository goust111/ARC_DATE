+def _shift_nodes(nodes: list[dict], dr: int, dc: int) -> list[dict]:
+    out = []
+    for node in nodes:
+        copied = dict(node)
+        copied["top"] = int(node["top"] + dr)
+        copied["left"] = int(node["left"] + dc)
