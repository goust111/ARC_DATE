+def _shape_from_arr(arr: np.ndarray) -> dict:
+    coords = np.argwhere(arr != 0)
+    rel = [(int(r), int(c)) for r, c in coords]
+    return {
+        "rel": rel,
+        "rel_set": set(rel),
