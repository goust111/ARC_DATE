+        return None
+    return out
+
+
+def _scatter(nodes: list[dict], H: int, W: int) -> np.ndarray | None:
+    inp = np.zeros((H, W), dtype=int)
+    anchor = nodes[0]
+    paste(inp, anchor["arr"], anchor["top"], anchor["left"], transparent=0)
