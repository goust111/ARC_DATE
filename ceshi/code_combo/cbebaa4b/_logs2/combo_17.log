+        elif side == "bottom":
+            arr[outer_h - spec["depth"] : outer_h, start + spec["offset"] : start + spec["offset"] + spec["width"]] = 0
+        elif side == "left":
+            arr[start + spec["offset"] : start + spec["offset"] + spec["width"], 0 : spec["depth"]] = 0
