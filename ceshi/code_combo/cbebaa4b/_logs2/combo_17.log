+    bboxes = [_bbox_of_node(n) for n in nodes]
+    r0 = min(b[0] for b in bboxes)
+    c0 = min(b[1] for b in bboxes)
+    r1 = max(b[2] for b in bboxes)
+    c1 = max(b[3] for b in bboxes)
+    ah = r1 - r0 + 1
+    aw = c1 - c0 + 1
+    if ah > H or aw > W:
+        return None
