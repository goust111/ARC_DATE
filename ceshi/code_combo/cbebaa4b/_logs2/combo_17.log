+
+def _outward_cavity(board: np.ndarray, placed_piece: dict, outward_side: str, bg: int) -> set[tuple[int, int]] | None:
+    piece = placed_piece["piece"]
+    top, left = int(placed_piece["top"]), int(placed_piece["left"])
