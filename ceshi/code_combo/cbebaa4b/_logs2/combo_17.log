+def _anchor_notches_filled(board: np.ndarray, anchor: dict, bg: int) -> bool:
+    r0, c0, _, _ = anchor["bbox"]
+    h, w = anchor["arr"].shape
+    sub = board[r0 : r0 + h, c0 : c0 + w]
+    return not _anchor_notches(sub, bg)
