+
+        chain_moves = []
+        for chain_idx, chain in enumerate(chains):
+            cavity = _outward_cavity(cur_board, chain["head"], chain["side"], bg)
+            if cavity is None:
+                continue
+            head = chain["head"]
+            head_pts = _pixels(head["piece"]["shape"], head["top"], head["left"])
+            parent_bbox = (
+                int(head["top"]),
+                int(head["left"]),
+                int(head["top"] + head["piece"]["shape"]["h"] - 1),
