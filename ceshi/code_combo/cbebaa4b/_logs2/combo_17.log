+    rel = [(int(r), int(c)) for r, c in coords]
+    return {
+        "rel": rel,
+        "rel_set": set(rel),
+        "h": int(arr.shape[0]),
+        "w": int(arr.shape[1]),
+        "area": int(coords.shape[0]),
