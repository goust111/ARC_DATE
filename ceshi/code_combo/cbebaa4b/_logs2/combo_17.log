+    # Quick local overlap rejection before global shifting.
+    for i in range(len(nodes)):
+        for j in range(i):
+            bi = _bbox_of_node(nodes[i])
+            bj = _bbox_of_node(nodes[j])
+            if not _rects_overlap(bi, bj):
