+        "local_bbox": (int(r0), int(c0), int(r1), int(c1)),
+        "reds": [(int(r - r0), int(c - c0)) for r, c in uniq if (r, c) in reds],
+    }
+
+
+def _build_local_entities() -> tuple[np.ndarray, list[dict]]:
+    bh, bw = ANCHOR_BLOCK
+    oh, ow = bh + 2, bw + 2
+
+    top_join = {(0, 3), (0, 4)}
+    right_join = {(3, ow - 1), (4, ow - 1)}
+    bottom_join = {(oh - 1, 2), (oh - 1, 3)}
+    left_join = {(2, 0), (3, 0)}
+
