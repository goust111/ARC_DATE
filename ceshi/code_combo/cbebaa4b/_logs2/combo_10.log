+    bl_cells = _line_cells(2, 0, oh - 1, 0) + _line_cells(oh - 1, 0, oh - 1, 3)
+    bl_reds = left_join | bottom_join | left_anchor
+    pieces.append(_cells_to_piece(bl_cells, bl_reds, -1))
