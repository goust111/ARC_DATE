+        if len(rc) > target_unique_red:
+            return
+
+        unpaired = [k for k, v in rc.items() if v == 1]
+        if not unpaired:
+            return
+
+        rc1 = {k for k, v in rc.items() if v == 1}
+
+        best_moves = None
+        for target in unpaired:
+            moves = []
+            tr, tc = target
+            for idx, piece in enumerate(remaining):
+                ph, pw = piece["shape"]
