   258	                best_moves = moves
   259	                if len(best_moves) == 1:
   260	                    break
   261	
   262	        assert best_moves is not None, "there must be at least one feasible move"
   263	
   264	        dedup: dict[tuple[int, int, int, int], int] = {}
   265	        for idx, vidx, top, left, overlap in best_moves:
   266	            key = (idx, vidx, top, left)
   267	            dedup[key] = max(dedup.get(key, 0), overlap)
   268	        moves2 = [(idx, vidx, top, left, ov) for (idx, vidx, top, left), ov in dedup.items()]
   269	        moves2.sort(key=lambda x: (-x[4], -remaining[x[0]]["area"], x[2], x[3], x[0], x[1]))
   270	
   271	        for idx, vidx, top, left, _ov in moves2:
   272	            piece = remaining[idx]
   273	            variant = piece["variants"][vidx]
   274	            next_remaining = remaining[:idx] + remaining[idx + 1 :]
   275	
   276	            next_rc = dict(rc)
   277	            for rr, cc in variant["reds"]:
   278	                gr, gc = top + rr, left + cc
   279	                next_rc[(gr, gc)] = next_rc.get((gr, gc), 0) + 1
   280	
   281	            nxt = _try_place(cur, variant["arr"], top, left, bg)
   282	            if nxt is None:
   283	                continue
   284	            dfs(nxt, next_remaining, next_rc)
