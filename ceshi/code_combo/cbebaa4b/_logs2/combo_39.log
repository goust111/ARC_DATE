   292	def main(grid: np.ndarray) -> np.ndarray:
   293	    """
   294	    Repack scattered rectangular tabbed sprites into one filled rectangle around the yellow anchor.
   295	
   296	    Input structure:
   297	    - bg = black (0). Several isolated sprites lie on the grid.
   298	    - One fixed anchor sprite contains the yellow (4) rectangle and stays at its final location.
   299	    - Every non-anchor sprite is a solid colored rectangle with red (2) edge tabs; in the input those
   300	      rectangles may already be rotated by 90/180/270 degrees or mirrored.
   301	
   302	    Rule:
   303	    - Keep the anchor where it is.
   304	    - For each remaining sprite, choose a translated position and, if needed, a rotated/flipped pose so
   305	      that red tabs overlap existing unpaired red tabs.
   306	    - Only red-red overlaps are legal, every red must end up paired exactly once, and the completed
   307	      non-black union must be one solid rectangle.
   308	
   309	    Key insight: This is no longer a free-form connector puzzle. The red tabs still define local matches,
   310	    but the decisive reasoning is geometric packing: infer the correct orientation of each rectangular slab
   311	    and keep only the assembly whose full silhouette becomes a rectangle.
   312	    """
   313	    sols = _enumerate_assemblies(
   314	        np.asarray(grid, dtype=int),
   315	        rectangle_only=True,
   316	        allow_rotate=True,
   317	        max_solutions=2,
   318	    )
   319	    assert len(sols) == 1, "assembly must have exactly one rectangle-valid rotated solution"
   320	    return sols[0]
