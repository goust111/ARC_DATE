   154	
   155	
   156	def _enumerate_assemblies(
   157	    grid: np.ndarray,
   158	    *,
   159	    rectangle_only: bool | None,
   160	    allow_rotate: bool,
   161	    max_solutions: int,
   162	) -> list[np.ndarray]:
   163	    g = np.asarray(grid, dtype=int)
   164	    h, w = g.shape
   165	    bg = 0
   166	
   167	    pieces = _extract_pieces(g, bg)
   168	    assert pieces, "input must contain at least one non-background piece"
   169	
   170	    anchors = [p for p in pieces if np.any(p["arr"] == 4)]
   171	    assert len(anchors) == 1, "input must contain exactly one yellow anchor piece"
   172	    anchor = anchors[0]
   173	    rest = [p for p in pieces if p is not anchor]
   174	    for piece in rest:
   175	        piece["variants"] = _variant_records(piece["arr"], bg) if allow_rotate else [_piece_record(piece["arr"], bg)]
   176	
   177	    canvas = np.full((h, w), bg, dtype=int)
   178	    ar0, ac0, _, _ = anchor["bbox"]
   179	    placed = _try_place(canvas, anchor["arr"], ar0, ac0, bg)
   180	    assert placed is not None, "anchor must fit at its original location"
   181	
   182	    total_ports = int(sum(len(p["reds"]) for p in pieces))
   183	    assert total_ports % 2 == 0, "total red connector count must be even"
   184	    target_unique_red = total_ports // 2
   185	    target_area = int(sum(p["area"] for p in pieces) - target_unique_red)
   186	
   187	    red_counts: dict[tuple[int, int], int] = {}
   188	    for rr, cc in anchor["reds"]:
