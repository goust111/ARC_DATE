   190	        red_counts[key] = red_counts.get(key, 0) + 1
   191	
   192	    solutions: list[np.ndarray] = []
   193	    seen: set[bytes] = set()
   194	
   195	    def dfs(cur: np.ndarray, remaining: list[dict], rc: dict[tuple[int, int], int]) -> None:
   196	        if len(solutions) >= max_solutions:
   197	            return
   198	
   199	        cur_mask = cur != bg
   200	        cur_area = int(np.sum(cur_mask))
   201	        if cur_area > target_area:
   202	            return
   203	        if rectangle_only is True:
   204	            pts = np.argwhere(cur_mask)
   205	            r0, c0, r1, c1 = bbox_coords(pts)
   206	            if (r1 - r0 + 1) * (c1 - c0 + 1) > target_area:
   207	                return
   208	
   209	        if not remaining:
   210	            if len(rc) != target_unique_red or any(v != 2 for v in rc.values()):
   211	                return
   212	            is_rect = _is_solid_rectangle(cur, bg)
   213	            if rectangle_only is True and not is_rect:
   214	                return
   215	            if rectangle_only is False and is_rect:
   216	                return
   217	            key = cur.tobytes()
   218	            if key not in seen:
   219	                seen.add(key)
   220	                solutions.append(cur.copy())
   221	            return
   222	
   223	        if len(rc) > target_unique_red:
   224	            return
   225	
   226	        unpaired = [k for k, v in rc.items() if v == 1]
   227	        if not unpaired:
   228	            return
   229	
   230	        rc1 = {k for k, v in rc.items() if v == 1}
   231	        best_moves = None
   232	        for tr, tc in unpaired:
   233	            moves = []
   234	            for idx, piece in enumerate(remaining):
   235	                for vidx, variant in enumerate(piece["variants"]):
   236	                    ph, pw = variant["shape"]
   237	                    for pr, pc in variant["reds"]:
   238	                        top = tr - pr
   239	                        left = tc - pc
   240	                        if top < 0 or left < 0 or top + ph > h or left + pw > w:
   241	                            continue
   242	                        bad = False
   243	                        overlap = 0
   244	                        for rr, cc in variant["reds"]:
   245	                            gr, gc = top + rr, left + cc
   246	                            prev = rc.get((gr, gc), 0)
   247	                            if prev >= 2:
