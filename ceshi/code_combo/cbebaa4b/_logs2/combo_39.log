+
+    anchor = next(piece for piece in pieces if piece["name"] == "anchor")
+    anchor_pos = (sr + anchor["offset"][0], sc + anchor["offset"][1])
+    inp = _scatter(pieces, anchor_pos, grid_h, grid_w)
