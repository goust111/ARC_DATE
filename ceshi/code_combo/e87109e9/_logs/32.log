+
+    required[target_side].append(lane_interval(start_side))
+    excluded[start_side].append(lane_interval(target_side))
+    return required, excluded
+
+
+def _gen_attempt() -> np.ndarray | None:
+    h, w = random.randint(*GRID_H_RANGE), GRID_W
