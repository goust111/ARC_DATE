+        [(lane_w, lane_w + sz - 1), (sc, sc + sz - 1)],
+        [],
+        min_len,
+        max_len_w,
+        low=thickness[_W],
+        high=w - thickness[_E] - 1,
+    )
+    spans[_E] = _pick_span(
+        h,
+        [(sr, sr + sz - 1)],
+        [(lane_n, lane_n + sz - 1)],
+        min_len,
+        max_len_h,
+        low=thickness[_N],
+        high=h - thickness[_S] - 1,
+    )
+    spans[_S] = _pick_span(
+        w,
+        [(sc, sc + sz - 1)],
+        [(lane_e, lane_e + sz - 1)],
+        min_len,
+        max_len_w,
+        low=thickness[_W],
+        high=w - thickness[_E] - 1,
+    )
+    spans[_W] = _pick_span(
+        h,
+        [(sr, sr + sz - 1)],
+        [],
+        min_len,
+        max_len_h,
+        low=thickness[_N],
+        high=h - thickness[_S] - 1,
+    )
+    if any(span is None for span in spans.values()):
+        return None
+    return spans
+
+
+def _gen_attempt() -> np.ndarray | None:
+    h, w = random.randint(*GRID_H_RANGE), GRID_W
+    sz = 2 if random.random() < TEAL_SZ2_PROB else 3
+
+    ns = _thickness_pair(h, sz)
+    ew = _thickness_pair(w, sz)
