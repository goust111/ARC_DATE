   338	def main(grid: np.ndarray) -> np.ndarray:
   339	    """
   340	    Emit four hidden teal beams, but reveal only local skeleton marks at turns.
   341	
   342	    Input structure:
   343	    - Top band: a grey legend whose four colored vertical bars encode left-turn vs right-turn by side placement.
   344	    - Below: one main grid containing a solid teal square, a single dominant background color, and 3-4 colored obstacle rectangles.
   345	
   346	    Rule:
   347	    - Remove the legend from consideration and simulate the same four cardinal beams as in the base task.
   348	    - A beam advances as a sliding copy of the teal square through background cells; if the next footprint would hit obstacle color C, use the legend to rotate 90 degrees and continue.
   349	    - The output is not the painted scene. Start from an all-black canvas of the cropped main-grid size, and for each turn keep only the footprint at the turn anchor plus the footprint one step before and one step after that turn. Leave straight runs, obstacles, background, and the source square black.
   350	
   351	    Key insight:
   352	    - The ray paths are still determined entirely by the obstacle colors and the legend's left/right encoding, but most of each path is invisible. The teal output pixels are only turn-local evidence of a larger hidden trajectory.
   353	    """
   354	    g = np.asarray(grid, dtype=int)
   355	
   356	    legend_bg = 5
   357	    rows_with_legend = np.where(np.any(g == legend_bg, axis=1))[0]
   358	    assert rows_with_legend.size, "legend rows must be present"
   359	    legend_h = int(rows_with_legend.max() + 1)
   360	    assert np.array_equal(rows_with_legend, np.arange(legend_h)), "legend must occupy the top band"
   361	
   362	    turns = _parse_legend(g, legend_h)
   363	    base = g[legend_h:, :].copy()
   364	    assert base.size, "main grid must remain after legend crop"
   365	
   366	    vals, counts = np.unique(base, return_counts=True)
   367	    bg = int(vals[counts.argmax()])
   368	    src, _steps_by_beam, hits_by_beam = _simulate_beams(base, turns, bg)
   369	    return _render_turn_skeleton(base.shape, hits_by_beam, src)
