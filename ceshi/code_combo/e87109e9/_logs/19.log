   399	def _choose_span(
   400	    axis_len: int,
   401	    required: list[tuple[int, int]],
   402	    excluded: list[tuple[int, int]],
   403	    min_len: int,
   404	    max_len: int,
   405	) -> tuple[int, int] | None:
   406	    """Pick a span covering all required intervals while avoiding all excluded ones."""
   407	    req0 = min(a for a, _ in required)
   408	    req1 = max(b for _, b in required)
   409	    lo = max(min_len, req1 - req0 + 1)
   410	    hi = min(max_len, axis_len)
   411	    choices: list[tuple[int, int, int]] = []
   412	    for length in range(lo, hi + 1):
   413	        start0 = max(0, req1 - length + 1)
   414	        start1 = min(req0, axis_len - length)
   415	        for start in range(start0, start1 + 1):
   416	            end = start + length - 1
   417	            if all(end < a or start > b for a, b in excluded):
   418	                choices.append((length, start, end))
   419	    if not choices:
   420	        return None
   421	
   422	    lengths = sorted({length for length, _, _ in choices})
   423	    if random.random() < SPAN_COMPACT_PROB:
   424	        cutoff = lengths[min(len(lengths) - 1, max(0, len(lengths) // 2))]
   425	        pool = [(start, end) for length, start, end in choices if length <= cutoff]
   426	    else:
   427	        pool = [(start, end) for _, start, end in choices]
   428	    return random.choice(pool)
