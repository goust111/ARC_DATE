    if corner == "TL":
        return {"top", "left"}, {"bottom", "right"}
    if corner == "TR":
        return {"top", "right"}, {"bottom", "left"}
    if corner == "BL":
        return {"bottom", "left"}, {"top", "right"}
    return {"bottom", "right"}, {"top", "left"}


def _edge_values(arr: np.ndarray, side: str) -> np.ndarray:
    if side == "top":
        return arr[0, :]
    if side == "bottom":
        return arr[-1, :]
    if side == "left":
        return arr[:, 0]
    return arr[:, -1]


