   222	    def in_bounds(r: int, c: int) -> bool:
   223	        return 0 <= r and 0 <= c and r + sz - 1 < out.shape[0] and c + sz - 1 < out.shape[1]
   224	
   225	    def paint_block(r: int, c: int) -> None:
   226	        blk = out[r : r + sz, c : c + sz]
   227	        blk[blk == bg] = teal
   228	        out[r : r + sz, c : c + sz] = blk
   229	
   230	    def obstacle_color_at_next(nr: int, nc: int) -> int | None:
   231	        blk = out[nr : nr + sz, nc : nc + sz]
   232	        cols = set(map(int, np.unique(blk)))
   233	        cols.discard(bg)
   234	        cols.discard(teal)
   235	        if not cols:
   236	            return None
   237	        assert len(cols) == 1, "beam footprint must not hit mixed obstacle colors"
