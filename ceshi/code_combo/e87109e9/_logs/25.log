   305	def _random_derangement(items: list[int]) -> list[int]:
   306	    """Return a shuffled copy where no item stays in its original slot."""
   307	    perm = items[:]
   308	    for _ in range(100):
   309	        random.shuffle(perm)
   310	        if all(a != b for a, b in zip(items, perm, strict=False)):
   311	            return perm
   312	    raise AssertionError("failed to build color derangement")
