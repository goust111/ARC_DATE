   315	def _choose_span(
   316	    axis_len: int,
   317	    required: list[tuple[int, int]],
   318	    excluded: list[tuple[int, int]],
   319	    min_len: int,
   320	    max_len: int,
   321	) -> tuple[int, int] | None:
   322	    """Pick a (start, end) span covering all required intervals and avoiding all excluded intervals."""
   323	    req0 = min(a for a, _ in required)
   324	    req1 = max(b for _, b in required)
   325	    lo = max(min_len, req1 - req0 + 1)
   326	    hi = min(max_len, axis_len)
   327	    choices: list[tuple[int, int, int]] = []
   328	    for length in range(lo, hi + 1):
   329	        start0 = max(0, req1 - length + 1)
   330	        start1 = min(req0, axis_len - length)
   331	        for start in range(start0, start1 + 1):
   332	            end = start + length - 1
   333	            if all(end < a or start > b for a, b in excluded):
   334	                choices.append((length, start, end))
   335	    if not choices:
   336	        return None
   337	
   338	    lengths = sorted({length for length, _, _ in choices})
   339	    if random.random() < SPAN_COMPACT_PROB:
   340	        cutoff = lengths[min(len(lengths) - 1, max(0, len(lengths) // 2))]
   341	        pool = [(start, end) for length, start, end in choices if length <= cutoff]
   342	    else:
   343	        pool = [(start, end) for _, start, end in choices]
   344	    return random.choice(pool)
