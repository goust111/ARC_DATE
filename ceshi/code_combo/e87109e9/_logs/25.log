   184	def main(grid: np.ndarray) -> np.ndarray:
   185	    """
   186	    Emit four teal beams whose turns come from paired colors and incoming direction.
   187	
   188	    Input structure:
   189	    - Top band: a grey legend split into 4 cells; each cell contains a centered 2x2 obstacle-color sample and a full-height bar of a different symbol color on the left or right edge.
   190	    - The centered sample gives the obstacle color found in the main area, while the edge bar is only a paired identifier.
   191	    - Below: the main grid with one solid teal square, a uniform background, and 3-4 colored edge-touching obstacle rectangles.
   192	
   193	    Rule:
   194	    - Remove the legend from the output.
   195	    - Launch one sz-by-sz teal beam from the square in each cardinal direction, painting teal only onto background cells.
   196	    - When a beam footprint reaches obstacle color C, first find the legend cell whose central sample is C.
   197	    - Then use that cell's bar side to choose between two direction-sensitive turn tables: left bar means vertical arrivals turn clockwise and horizontal arrivals turn counterclockwise; right bar means the reverse.
   198	    - Continue until the beam would leave the cropped main grid.
   199	
   200	    Key insight: the obstacle color no longer names the turn directly. It must be mapped through a paired legend cell, and the same obstacle color can bend differently depending on whether the beam arrives vertically or horizontally.
   201	    """
   202	    g = np.asarray(grid, dtype=int)
   203	
   204	    legend_bg = 5
   205	    rows_with_legend = np.where(np.any(g == legend_bg, axis=1))[0]
   206	    assert rows_with_legend.size, "legend rows must be present"
   207	    legend_h = int(rows_with_legend.max() + 1)
   208	    assert np.array_equal(rows_with_legend, np.arange(legend_h)), "legend color must be confined to the top band"
