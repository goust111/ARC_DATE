   141	def _find_teal_square(g: np.ndarray, teal: int = 8) -> tuple[int, int, int]:
   142	    """Return (r0,c0,size) for a solid square teal component."""
   143	    candidates: list[tuple[int, int, int]] = []
   144	    for cells in components_mask(g == teal, connectivity=4):
   145	        r0, c0, r1, c1 = bbox_coords(cells)
   146	        hh = r1 - r0 + 1
   147	        ww = c1 - c0 + 1
   148	        if hh != ww:
   149	            continue
   150	        size = hh
   151	        if int(np.sum(g[r0 : r1 + 1, c0 : c1 + 1] == teal)) != size * size:
   152	            continue
   153	        candidates.append((int(r0), int(c0), int(size)))
   154	    assert len(candidates) == 1, "main grid must contain exactly one solid teal square"
   155	    return candidates[0]
