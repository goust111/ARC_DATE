    82	def _parse_legend(grid: np.ndarray, legend_h: int) -> tuple[dict[int, int], dict[int, str]]:
    83	    """
    84	    Parse the paired legend.
    85	
    86	    Returns:
    87	      obstacle_to_symbol: obstacle sample color -> symbol bar color
    88	      symbol_combo: symbol bar color -> 'L' or 'R'
    89	
    90	    Here 'L'/'R' mean the bar is drawn on the left/right edge of the cell.
    91	    The bar side selects one of two direction-sensitive turn tables.
    92	    """
    93	    legend = grid[:legend_h, :]
    94	    assert legend.size, "legend must be non-empty"
    95	    vals, cnts = np.unique(legend, return_counts=True)
    96	    bg = int(vals[cnts.argmax()])
    97	
    98	    sep_cols = [c for c in range(legend.shape[1]) if np.all(legend[:, c] == bg)]
    99	    assert len(sep_cols) >= 2, "legend separator columns must exist"
   100	
   101	    obstacle_to_symbol: dict[int, int] = {}
   102	    symbol_combo: dict[int, str] = {}
   103	    for a, b in zip(sep_cols, sep_cols[1:], strict=False):
   104	        if b - a <= 2:
   105	            continue
   106	        interior = legend[1 : legend_h - 1, a + 1 : b]
   107	        assert interior.shape == (4, 4), "legend cell interior must stay 4x4"
   108	
   109	        left_col = set(map(int, interior[:, 0]))
   110	        right_col = set(map(int, interior[:, -1]))
   111	        left_col.discard(bg)
   112	        left_col.discard(0)
   113	        right_col.discard(bg)
   114	        right_col.discard(0)
   115	
   116	        if len(left_col) == 1 and not right_col:
   117	            symbol = int(next(iter(left_col)))
   118	            combo = "L"
   119	        elif len(right_col) == 1 and not left_col:
   120	            symbol = int(next(iter(right_col)))
   121	            combo = "R"
   122	        else:
   123	            raise AssertionError("each legend cell must have one edge-aligned symbol bar")
   124	
   125	        sample = interior[1:3, 1:3]
   126	        sample_colors = set(map(int, np.unique(sample)))
   127	        sample_colors.discard(bg)
   128	        sample_colors.discard(0)
   129	        assert len(sample_colors) == 1, "legend sample block must encode exactly one obstacle color"
   130	        obstacle = int(next(iter(sample_colors)))
   131	        assert obstacle != symbol, "paired legend colors must differ in this variant"
   132	
   133	        obstacle_to_symbol[obstacle] = symbol
   134	        symbol_combo[symbol] = combo
   135	
   136	    assert len(obstacle_to_symbol) == 4, "legend must encode four obstacle samples"
   137	    assert len(symbol_combo) == 4, "legend must encode four symbol bars"
   138	    return obstacle_to_symbol, symbol_combo
