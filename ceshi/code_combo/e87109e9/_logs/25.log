   166	def _turn_from_combo(combo: str, d: int) -> str:
   167	    """
   168	    Convert a legend combo and incoming beam direction into the actual turn.
   169	
   170	    combo == 'L' (bar on left):
   171	      - vertical arrival (N/S) -> 'R' (clockwise)
   172	      - horizontal arrival (E/W) -> 'L' (counterclockwise)
   173	    combo == 'R' (bar on right):
   174	      - vertical arrival (N/S) -> 'L'
   175	      - horizontal arrival (E/W) -> 'R'
