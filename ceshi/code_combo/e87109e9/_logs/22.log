   163	        blk[blk == bg] = teal
   164	
   165	    def obstacle_color_at_next(nr: int, nc: int) -> int | None:
   166	        blk = out[nr : nr + sz, nc : nc + sz]
   167	        cols = set(map(int, np.unique(blk)))
   168	        cols.discard(bg)
   169	        cols.discard(teal)
