    def obstacle_at(r, c):
        colors = set(map(int, np.unique(out[r:r+sz, c:c+sz])))
        colors.discard(bg)
        colors.discard(mod.TEAL)
        if not colors:
            return None
        if len(colors) "'!= 1:
            raise AssertionError('"'mixed obstacle colors in one footprint')
        return int(next(iter(colors)))
    for d0 in range(4):
        r, c, d = sr, sc, d0
        seen = set()
