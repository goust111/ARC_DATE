   278	    near: bool,
   279	) -> list[tuple[int, int]]:
   280	    """Candidate pixel coordinates that the initial beam from `side` would hit first."""
   281	    coords: list[tuple[int, int]] = []
   282	
   283	    if side == _N:
   284	        row_lo = max(0, sr - sz) if near else 0
   285	        row_hi = sr - 1
   286	        rows = range(row_lo, row_hi + 1)
   287	        cols = range(sc, sc + sz)
   288	    elif side == _S:
   289	        row_lo = sr + sz
   290	        row_hi = min(h - 1, sr + 2 * sz - 1) if near else h - 1
   291	        rows = range(row_lo, row_hi + 1)
   292	        cols = range(sc, sc + sz)
   293	    elif side == _W:
   294	        col_lo = max(0, sc - sz) if near else 0
   295	        col_hi = sc - 1
   296	        rows = range(sr, sr + sz)
   297	        cols = range(col_lo, col_hi + 1)
   298	    else:  # _E
   299	        col_lo = sc + sz
   300	        col_hi = min(w - 1, sc + 2 * sz - 1) if near else w - 1
   301	        rows = range(sr, sr + sz)
   302	        cols = range(col_lo, col_hi + 1)
   303	
   304	    for r in rows:
   305	        for c in cols:
   306	            if abs(r - c) < DIAG_MARGIN:
   307	                continue
   308	            if _turn_from_position(r, c) != turn:
   309	                continue
   310	            coords.append((r, c))
