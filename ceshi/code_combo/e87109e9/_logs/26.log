+            comp_id = _obstacle_component_at(comp_grid, nr, nc, sz)
+            if comp_id is None:
+                r, c = nr, nc
+                paint(r, c)
+                continue
+            color = int(obstacle_info[comp_id]["color"])
+            exited = False
+            while True:
