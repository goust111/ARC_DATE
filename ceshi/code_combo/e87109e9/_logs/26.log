+    legend_colors = random.sample(LEGEND_COLOR_POOL, 4)
+    turns = {color: random.choice(["L", "R"]) for color in legend_colors}
+
+    bg_choices = [color for color in BG_COLOR_POOL if color not in legend_colors]
