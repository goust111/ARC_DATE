+    rects = {
+        _N: (north_top, north_top + tn - 1, n_c0, n_c1),
+        _S: (south_top, south_top + ts - 1, s_c0, s_c1),
+        _W: (w_r0, w_r1, west_col, west_col + tw - 1),
