+        sr + sz - 1,
+        1,
+        h - 2,
+        SPAN_MIN_LEN,
+        min(h - 2, sz + SPAN_MAX_EXTRA),
+    )
+    east_span = _choose_covering_span(
+        sr,
+        sr + sz - 1,
+        1,
+        h - 2,
+        SPAN_MIN_LEN,
+        min(h - 2, sz + SPAN_MAX_EXTRA),
+    )
