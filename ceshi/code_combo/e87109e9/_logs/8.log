   222	            beam_mask[r : r + sz, c : c + sz] = True
   223	            beam_mask[source_mask] = False
   224	
   225	        earlier_trail_mask |= beam_mask
   226	        beam_stats.append(
   227	            {
   228	                "dir": d0,
   229	                "trail_block": trail_block,
   230	                "trail_cells": int(beam_mask.sum()),
   231	                "hits": hits,
   232	                "erased": erased,
   233	            }
   234	        )
   235	
   236	    return out, beam_stats
   237	
   238	
   239	def _simulate_combo(
   240	    base: np.ndarray, turns: dict[int, str], bg: int
   241	) -> tuple[np.ndarray, list[dict[str, object]]]:
   242	    return _simulate_variant(
   243	        base, turns, bg, use_trails=True, erase_obstacles=True
   244	    )
