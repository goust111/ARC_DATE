   113	        x = int(xs[0])
   114	        turn[color] = "L" if x <= (interior.shape[1] - 1) // 2 else "R"
   115	    assert len(turn) == 4, "legend must encode four turn colors"
   116	    return turn
   117	
   118	
   119	def _find_teal_square(g: np.ndarray, teal: int = TEAL) -> tuple[int, int, int]:
   120	    """Return (r0, c0, size) for the unique solid teal square."""
   121	    candidates: list[tuple[int, int, int]] = []
   122	    for cells in components_mask(g == teal, connectivity=4):
   123	        r0, c0, r1, c1 = bbox_coords(cells)
   124	        hh = r1 - r0 + 1
   125	        ww = c1 - c0 + 1
   126	        if hh != ww:
   127	            continue
   128	        size = hh
   129	        if int(np.sum(g[r0 : r1 + 1, c0 : c1 + 1] == teal)) != size * size:
   130	            continue
   131	        candidates.append((int(r0), int(c0), int(size)))
   132	    assert len(candidates) == 1, "main grid must contain exactly one solid teal square"
   133	    return candidates[0]
   134	
   135	
   136	def _rot_ccw(d: int) -> int:
   137	    return (d - 1) % 4
   138	
   139	
   140	def _rot_cw(d: int) -> int:
   141	    return (d + 1) % 4
   142	
   143	
   144	def _rot(d: int, turn: str) -> int:
   145	    return _rot_ccw(d) if turn == "L" else _rot_cw(d)
   146	
   147	
   148	def _obstacle_color_at(
   149	    obstacles: np.ndarray, bg: int, nr: int, nc: int, sz: int
   150	) -> int | None:
   151	    blk = obstacles[nr : nr + sz, nc : nc + sz]
   152	    colors = set(map(int, np.unique(blk)))
   153	    colors.discard(bg)
   154	    colors.discard(TEAL)
   155	    if not colors:
   156	        return None
   157	    assert len(colors) == 1, "beam footprint must not hit mixed obstacle colors"
   158	    return int(next(iter(colors)))
   159	
   160	
   161	def _simulate_variant(
   162	    base: np.ndarray,
   163	    turns: dict[int, str],
   164	    bg: int,
   165	    *,
   166	    use_trails: bool,
   167	    erase_obstacles: bool,
   168	) -> tuple[np.ndarray, list[dict[str, object]]]:
   169	    """Simulate the combo or an ablation of it."""
   170	    out = base.copy()
   171	    sr, sc, sz = _find_teal_square(base, teal=TEAL)
   172	    h, w = out.shape
   173	
   174	    source_mask = np.zeros_like(base, dtype=bool)
   175	    source_mask[sr : sr + sz, sc : sc + sz] = True
   176	    earlier_trail_mask = np.zeros_like(base, dtype=bool)
   177	    obstacles = base.copy()
   178	    obstacles[source_mask] = bg
   179	
   180	    def in_bounds(r: int, c: int) -> bool:
   181	        return 0 <= r and 0 <= c and r + sz - 1 < h and c + sz - 1 < w
   182	
   183	    beam_stats: list[dict[str, object]] = []
   184	    for d0 in (_N, _E, _S, _W):
   185	        r, c, d = sr, sc, d0
   186	        seen: set[tuple[int, int, int]] = set()
   187	        beam_mask = np.zeros_like(base, dtype=bool)
   188	        trail_block = False
   189	        hits: list[tuple[int, int, int, int]] = []
   190	        erased: list[int] = []
   191	
   192	        while True:
   193	            state = (r, c, d)
   194	            assert state not in seen, "beam path must not cycle"
   195	            seen.add(state)
   196	
   197	            dr, dc = _DIRS[d]
   198	            nr, nc = r + dr, c + dc
   199	            if not in_bounds(nr, nc):
   200	                break
   201	
   202	            if use_trails and earlier_trail_mask[nr : nr + sz, nc : nc + sz].any():
   203	                trail_block = True
   204	                break
   205	
   206	            oc = _obstacle_color_at(obstacles, bg, nr, nc, sz)
   207	            if oc is not None:
   208	                assert oc in turns, "obstacle color must be encoded by legend"
   209	                hits.append((d, oc, nr, nc))
   210	                if erase_obstacles:
   211	                    obstacles[obstacles == oc] = bg
   212	                    erased.append(oc)
   213	                d = _rot(d, turns[oc])
   214	                continue
   215	
   216	            r, c = nr, nc
   217	            blk = out[r : r + sz, c : c + sz]
   218	            bg_mask = blk == bg
