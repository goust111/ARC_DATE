+
+    legend_colors = random.sample(LEGEND_COLOR_POOL, 4)
+    side_palette = random.sample(legend_colors, 4)
+    side_colors = {
+        _N: side_palette[0],
+        _E: side_palette[1],
+        _S: side_palette[2],
+        _W: side_palette[3],
