+    candidates: list[tuple[int, int, dict[int, int], set[int]]] = []
+    h, w = grid.shape
+    for r in range(h - 1):
+        for c in range(w - 1):
+            blk = grid[r : r + 2, c : c + 2]
+            flat = [int(x) for x in blk.flatten()]
