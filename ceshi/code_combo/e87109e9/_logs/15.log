+
+def _select_chains(
+    present: set[int], second_hits: int
+) -> dict[int, int] | None:
+    """Pick non-overlapping adjacent source->target pairs for the beams that bounce twice."""
+    candidates = [
+        (side, nxt)
+        for side in present
+        for nxt in ((side - 1) % 4, (side + 1) % 4)
+        if nxt in present
