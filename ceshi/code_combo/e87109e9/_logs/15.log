+        _E: int(source_colors[1]),
+        _S: int(source_colors[2]),
+        _W: int(source_colors[3]),
+    }
+    source_block = np.array(
+        [
+            [beam_colors[_N], beam_colors[_E]],
+            [beam_colors[_W], beam_colors[_S]],
