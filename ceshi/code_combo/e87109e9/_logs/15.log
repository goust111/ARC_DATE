+
+    hit_counts = [len(beam) for beam in hits]
+    hit_colors = {color for beam in hits for _, color, _, _ in beam}
+    inherited_visible_colors = {
+        color
+        for paints in beam_visible
+        for color in paints.values()
+        if color not in source_palette
+    }
