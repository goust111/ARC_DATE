    49	def _parse_legend(grid: np.ndarray, legend_h: int) -> dict[int, str]:
    50	    """Decode obstacle-color -> turn direction from the top legend band."""
    51	    legend = grid[:legend_h, :]
    52	    assert legend.size, "legend must be non-empty"
    53	    vals, cnts = np.unique(legend, return_counts=True)
    54	    bg = int(vals[cnts.argmax()])
    55	
    56	    sep_cols = [c for c in range(legend.shape[1]) if np.all(legend[:, c] == bg)]
    57	    assert len(sep_cols) >= 2, "legend separator columns must exist"
    58	
    59	    turn: dict[int, str] = {}
    60	    for a, b in zip(sep_cols, sep_cols[1:], strict=False):
    61	        if b - a <= 2:
    62	            continue
    63	        interior = legend[1 : legend_h - 1, a + 1 : b]
    64	        colors = set(map(int, np.unique(interior)))
    65	        colors.discard(bg)
    66	        colors.discard(0)
    67	        assert len(colors) == 1, "each legend cell must encode exactly one color"
    68	        color = int(next(iter(colors)))
    69	        xs = np.where(interior == color)[1]
    70	        x = int(xs[0])
    71	        turn[color] = "L" if x <= (interior.shape[1] - 1) // 2 else "R"
    72	    assert len(turn) == 4, "legend must encode four turn colors"
    73	    return turn
