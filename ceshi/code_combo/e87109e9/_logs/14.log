   269	def _choose_span(
   270	    axis_len: int,
   271	    required: list[tuple[int, int]],
   272	    excluded: list[tuple[int, int]],
   273	    min_len: int,
   274	    max_len: int,
   275	) -> tuple[int, int] | None:
   276	    req0 = min(a for a, _ in required)
   277	    req1 = max(b for _, b in required)
   278	    lo = max(min_len, req1 - req0 + 1)
   279	    hi = min(max_len, axis_len)
   280	    choices: list[tuple[int, int, int]] = []
   281	    for length in range(lo, hi + 1):
   282	        start0 = max(0, req1 - length + 1)
   283	        start1 = min(req0, axis_len - length)
   284	        for start in range(start0, start1 + 1):
   285	            end = start + length - 1
   286	            if all(end < a or start > b for a, b in excluded):
   287	                choices.append((length, start, end))
   288	    if not choices:
   289	        return None
   290	
   291	    lengths = sorted({length for length, _, _ in choices})
   292	    if random.random() < SPAN_COMPACT_PROB:
   293	        cutoff = lengths[min(len(lengths) - 1, max(0, len(lengths) // 2))]
   294	        pool = [(start, end) for length, start, end in choices if length <= cutoff]
   295	    else:
   296	        pool = [(start, end) for _, start, end in choices]
   297	    return random.choice(pool)
