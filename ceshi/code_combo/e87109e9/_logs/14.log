   198	def main(grid: np.ndarray) -> np.ndarray:
   199	    """
   200	    Emit four teal beams from a square, but paint them as background-controlled dashed paths.
   201	
   202	    Input structure:
   203	    - The top band is still a 4-cell legend on color 5; each colored vertical bar says whether that obstacle color causes a left or right turn.
   204	    - The cropped main area contains one solid teal source square, several colored obstacle blocks, and one uniform non-black background color.
   205	
   206	    Rule:
   207	    - Remove the legend from the output.
   208	    - Launch one beam in each cardinal direction, using the same moving square footprint as the original task and the same turn-on-obstacle logic.
   209	    - The difference is the trail style: if the main background color is k, then along each beam path you paint k moved square-positions, leave the next moved square-position as background, and repeat this dash cycle even across turns.
   210	    - Beams still stop only at the grid boundary.
   211	
   212	    Key insight: the legend explains *where* beams turn, but the background color explains *how densely* the trajectory is painted; the background is no longer decorative metadata.
   213	    """
   214	    g = np.asarray(grid, dtype=int)
   215	
   216	    legend_bg = 5
   217	    rows_with_legend = np.where(np.any(g == legend_bg, axis=1))[0]
   218	    assert rows_with_legend.size, "legend rows must be present"
   219	    legend_h = int(rows_with_legend.max() + 1)
   220	    assert np.array_equal(rows_with_legend, np.arange(legend_h)), "legend color must stay in a top band"
   221	
   222	    legend_turn = _parse_legend(g, legend_h)
   223	    base = g[legend_h:, :].copy()
   224	    assert base.size, "main grid must remain after legend crop"
   225	
   226	    vals, cnts = np.unique(base, return_counts=True)
   227	    bg = int(vals[cnts.argmax()])
   228	    dash_period = _dash_period_from_bg(bg)
   229	    out, _stats = _simulate_beams(base, legend_turn, bg, dash_period=dash_period)
   230	    return out
