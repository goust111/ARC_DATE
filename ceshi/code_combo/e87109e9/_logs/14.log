+        r, c, d = sr, sc, d0
+        seen: set[tuple[int, int, int]] = set()
+        steps = 0
+        hits = 0
+        painted = 0
+        skipped = 0
+        hit_colors: list[int] = []
+
+        while True:
+            state = (r, c, d)
+            assert state not in seen, "beam path must not cycle"
+            seen.add(state)
