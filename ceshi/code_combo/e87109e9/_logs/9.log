+def _simulate_paths(
+    base: np.ndarray,
+    turns: dict[int, str],
+    stop_color: int,
+    start_dirs: tuple[int, ...],
+    bg: int,
+) -> tuple[np.ndarray, list[list[tuple[int, int, int, int, bool]]]]:
+    """Simulate the active beams, recording obstacle hits and terminal hits."""
+    sr, sc, sz, _axis = _find_source_block(base)
+    out = base.copy()
+    h, w = out.shape
