+        last = sequence[-1]
+        excluded[first].append((lane[last], lane[last] + sz - 1))
+
+    spans: dict[int, tuple[int, int]] = {}
+    for side in present:
+        axis_len = w if side in (_N, _S) else h
+        span = _choose_span(
