+    if chain_src == _W:
+        return (sr - thickness[_N]) if chain_tgt == _N else (h - thickness[_S] - 3 - sr)
+    return (sr - thickness[_N]) if chain_tgt == _N else (h - thickness[_S] - 3 - sr)
