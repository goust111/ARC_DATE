+SOURCE_SIZE = 2
+INITIAL_WIDTH = 2
+DASH_PERIOD = 3
+DASH_ON_STEPS = 2
+
+OBS_THICKNESS_RANGE = (2, 4)
+SPAN_MIN = 7
+SPAN_MAX = 16
+
+FIRST_SEG_MIN = 4
+CHAIN_SEG_MIN = 4
+FINAL_SEG_MIN = 4
+MAX_RETRIES = 500
