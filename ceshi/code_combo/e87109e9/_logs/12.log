+    r_hi = h - thickness[_S] - SOURCE_SIZE - FIRST_SEG_MIN
+    c_lo = thickness[_W] + FIRST_SEG_MIN
+    c_hi = w - thickness[_E] - SOURCE_SIZE - FIRST_SEG_MIN
