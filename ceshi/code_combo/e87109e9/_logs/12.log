+        sl[sl == bg] = TEAL
+        return
+    if d == _W:
+        sl = out[r : r + width, c]
+        sl[sl == bg] = TEAL
+        return
+    sl = out[r : r + width, c + width - 1]
+    sl[sl == bg] = TEAL
+
