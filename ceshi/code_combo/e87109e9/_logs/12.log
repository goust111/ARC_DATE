+
+def _paint_anchor(out: np.ndarray, bg: int, r: int, c: int, width: int) -> None:
+    blk = out[r : r + width, c : c + width]
+    blk[blk == bg] = TEAL
+
+
+def _paint_leading_slice(out: np.ndarray, bg: int, r: int, c: int, width: int, d: int) -> None:
+    if d == _N:
