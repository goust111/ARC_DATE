   113	def _find_source(g: np.ndarray, teal: int = TEAL) -> tuple[int, int, int, int]:
   114	    """
   115	    Return (r0, c0, size, start_dir) for the teal square plus detached starter strip.
   116	    The starter strip is separated by exactly one bg cell and points to the only launch direction.
   117	    """
   118	    comps = list(components_mask(g == teal, connectivity=4))
   119	    assert len(comps) == 2, "main grid must contain one teal square and one teal starter strip"
   120	
