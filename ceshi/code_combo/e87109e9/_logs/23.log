+            )
+        else:
+            required = [(hr, hr + sz - 1)]
+            excluded = []
+            for j, d_other in enumerate(dirs):
+                if j == i or d_other not in (_E, _W):
+                    continue
+                lane = starts[j][0]
+                excluded.append((lane, lane + sz - 1))
+            span = _choose_span(
+                h,
+                required,
+                excluded,
+                max(OBSTACLE_LEN_RANGE[0], sz + 3),
+                min(OBSTACLE_LEN_RANGE[1], h),
