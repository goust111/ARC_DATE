   173	def _wrapped_step(r: int, c: int, d: int, shape: tuple[int, int], sz: int) -> tuple[int, int, bool]:
   174	    rows, cols = _state_dims(shape, sz)
   175	    dr, dc = _DIRS[d]
   176	    nr = (r + dr) % rows
