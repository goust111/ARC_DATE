    87	def _parse_legend(grid: np.ndarray, legend_h: int) -> dict[int, str]:
    88	    """Read the top legend and map obstacle color -> turn direction."""
    89	    legend = grid[:legend_h, :]
    90	    assert legend.size, "legend must be non-empty"
    91	    vals, cnts = np.unique(legend, return_counts=True)
    92	    bg = int(vals[cnts.argmax()])
    93	
    94	    sep_cols = [c for c in range(legend.shape[1]) if np.all(legend[:, c] == bg)]
    95	    assert len(sep_cols) >= 2, "legend separator columns must exist"
    96	
    97	    turn: dict[int, str] = {}
    98	    for a, b in zip(sep_cols, sep_cols[1:], strict=False):
    99	        if b - a <= 2:
   100	            continue
   101	        interior = legend[1 : legend_h - 1, a + 1 : b]
   102	        colors = set(map(int, np.unique(interior)))
   103	        colors.discard(bg)
   104	        colors.discard(0)
   105	        assert len(colors) == 1, "each legend cell must encode exactly one color"
   106	        col = int(next(iter(colors)))
   107	        x = int(np.where(interior == col)[1][0])
   108	        turn[col] = "L" if x <= (interior.shape[1] - 1) // 2 else "R"
   109	    assert len(turn) == 4, "legend must encode four turn colors"
   110	    return turn
