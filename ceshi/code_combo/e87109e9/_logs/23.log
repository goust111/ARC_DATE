   197	def _choose_span(
   198	    axis_len: int,
   199	    required: list[tuple[int, int]],
   200	    excluded: list[tuple[int, int]],
   201	    min_len: int,
   202	    max_len: int,
   203	) -> tuple[int, int] | None:
   204	    req0 = min(a for a, _ in required)
   205	    req1 = max(b for _, b in required)
   206	    lo = max(min_len, req1 - req0 + 1)
   207	    hi = min(max_len, axis_len)
   208	    choices: list[tuple[int, int, int]] = []
   209	    for length in range(lo, hi + 1):
   210	        start0 = max(0, req1 - length + 1)
   211	        start1 = min(req0, axis_len - length)
   212	        for start in range(start0, start1 + 1):
   213	            end = start + length - 1
   214	            if all(end < a or start > b for a, b in excluded):
   215	                choices.append((length, start, end))
   216	    if not choices:
   217	        return None
   218	
   219	    lengths = sorted({length for length, _, _ in choices})
   220	    cutoff = lengths[min(len(lengths) - 1, max(0, len(lengths) // 2))]
   221	    if random.random() < 0.5:
   222	        pool = [(start, end) for length, start, end in choices if length <= cutoff]
   223	    else:
   224	        pool = [(start, end) for _, start, end in choices]
   225	    return random.choice(pool)
