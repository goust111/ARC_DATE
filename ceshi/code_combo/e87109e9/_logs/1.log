     3	# Name: 交替转弯加颜色继承
     4	
     5	import random
     6	
     7	import numpy as np
     8	
     9	from arc_utils import bbox_coords, components_mask
    10	
    11	# Design analysis for the combo variant
    12	#
    13	# a) Concrete behavior / trace
    14	#    - The input still has the original two-zone layout: a 6x24 legend strip on
    15	#      top and a 19-24 x 24 main board below.
    16	#    - The main board still contains one solid teal square plus 3-4 large
    17	#      edge-touching obstacle rectangles.
    18	#    - The output still deletes the legend and traces four sz-wide beams from
    19	#      the square, but now each beam carries two pieces of state:
    20	#      collision parity and current paint color.
    21	#    - Example: the north beam starts teal, hits the north obstacle first, turns
    22	#      clockwise because this is collision #1, and every later step on that
    23	#      segment is painted in the north obstacle's color. If it then hits the
    24	#      east obstacle, that second collision turns counterclockwise and the next
    25	#      segment switches again to the east obstacle's color.
    26	#    - Compared with the original task, both the turn rule and the visible trail
    27	#      now depend on collision history rather than a fixed color->turn legend.
    28	#
    29	# b) Complexity calibration
    30	#    - If every beam had at most one hit, the turn rule would look like "always
    31	#      turn clockwise once" and the color rule would reduce to a single recolor.
    32	#      That is too weak.
    33	#    - Generation therefore forces at least one two-hit beam. This makes the
    34	#      alternation visible (first hit CW, second hit CCW) and also yields a
    35	#      teal -> color A -> color B inheritance chain on the output.
    36	#    - A chained target obstacle is hit once as another beam's second collision
    37	#      and once as its own beam's first collision, so no fixed color-specific
    38	#      turn explanation can fit the examples.
    39	#
    40	# c) Hidden-assumption audit
    41	#    - The original solver assumed the legend encoded color->turn. That is now
    42	#      false; the legend remains only as removable decoration and structure.
    43	#    - The original solver also checked the next footprint against the mutable
    44	#      output grid. That breaks once trails can recolor to non-teal obstacle
    45	#      colors, because old trail cells could masquerade as fresh blockers.
    46	#      Obstacle lookup must therefore read from the immutable cropped input.
    47	#    - Cycle detection can no longer use only (r, c, d). Under alternating
    48	#      turns, the same pose with different collision parity has a different
    49	#      future; under color inheritance, the same pose and parity with a
    50	#      different current paint color also produces a different output.
    51	#
    52	# d) Placement legality
    53	#    - Obstacles stay axis-aligned, edge-touching, mutually disjoint, and at
    54	#      least one cell away from the source square.
    55	#    - For a forced two-hit chain src -> cw(src), the target side must cover the
    56	#      redirected lane from src, while non-chain clockwise-adjacent sides must
    57	#      exclude that lane so accidental second hits do not appear.
    58	#    - After the second hit, the beam turns back outward, so the source side
    59	#      excludes the target lane to avoid an unintended third hit.
    60	#
    61	# e) Visual observability
    62	#    - Decorative legend bars still exist, but their left/right positions are
    63	#      randomized independently of the real behavior.
    64	#    - Each generated sample contains at least one obstacle color that appears
    65	#      in the output as an inherited trail color, and at least one two-hit beam
    66	#      so a solver can see both alternation and recoloring from examples alone.
    67	#    - The same obstacle color is observed in both first-hit and second-hit
    68	#      contexts, forcing the conclusion that turn direction depends on hit order
    69	#      rather than obstacle identity.
    70	#
    71	# f) Visual cleanliness
    72	#    - The generator rejects layouts where different beams would paint the same
    73	#      cell in different colors. This prevents order-dependent artifacts.
    74	#    - Large edge-touching obstacle bars and generous square margins preserve
    75	#      the original clean composition, while allowing only small benign overlaps
    76	#      when beams agree on color.
    77	#
    78	# g) Color-rule audit
    79	#    - Colors are not used for numeric ordering or parity.
    80	#    - Obstacle colors only serve two visible roles: obstacle identity in the
    81	#      input and inherited trail color after a collision in the output.
