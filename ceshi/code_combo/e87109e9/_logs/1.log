   340	def _choose_span(
   341	    axis_len: int,
   342	    required: list[tuple[int, int]],
   343	    excluded: list[tuple[int, int]],
   344	    min_len: int,
   345	    max_len: int,
   346	) -> tuple[int, int] | None:
   347	    """Pick a span covering all required intervals while missing all excluded intervals."""
   348	    req0 = min(a for a, _ in required)
   349	    req1 = max(b for _, b in required)
   350	    lo = max(min_len, req1 - req0 + 1)
   351	    hi = min(max_len, axis_len)
   352	    choices: list[tuple[int, int, int]] = []
   353	    for length in range(lo, hi + 1):
   354	        start0 = max(0, req1 - length + 1)
   355	        start1 = min(req0, axis_len - length)
   356	        for start in range(start0, start1 + 1):
   357	            end = start + length - 1
   358	            if all(end < a or start > b for a, b in excluded):
   359	                choices.append((length, start, end))
   360	    if not choices:

