   270	def _conflict_stats(beam_paints: list[dict[tuple[int, int], int]]) -> tuple[int, int]:
   271	    """Return (#cells painted by multiple beams, #cells painted in multiple colors)."""
   272	    owners: dict[tuple[int, int], list[int]] = {}
   273	    for paints in beam_paints:
   274	        for cell, color in paints.items():
   275	            owners.setdefault(cell, []).append(int(color))
   276	    overlap_cells = sum(1 for colors in owners.values() if len(colors) > 1)
   277	    conflict_cells = sum(1 for colors in owners.values() if len(set(colors)) > 1)
   278	    return overlap_cells, conflict_cells
