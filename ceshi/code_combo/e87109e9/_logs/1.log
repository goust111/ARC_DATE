   117	def _legend_colors(grid: np.ndarray, legend_h: int) -> list[int]:
   118	    """Read the four legend colors for structure validation; bar direction is decorative."""
   119	    legend = grid[:legend_h, :]
   120	    assert legend.size, "legend must be non-empty"
   121	    vals, cnts = np.unique(legend, return_counts=True)
   122	    bg = int(vals[cnts.argmax()])
   123	    sep_cols = [c for c in range(legend.shape[1]) if np.all(legend[:, c] == bg)]
   124	    assert len(sep_cols) >= 2, "legend separator columns must exist"
   125	
   126	    colors: list[int] = []
   127	    for a, b in zip(sep_cols, sep_cols[1:], strict=False):
   128	        if b - a <= 2:
   129	            continue
   130	        interior = legend[1 : legend_h - 1, a + 1 : b]
   131	        cell_colors = set(map(int, np.unique(interior)))
   132	        cell_colors.discard(bg)
   133	        cell_colors.discard(0)
   134	        assert len(cell_colors) == 1, "each legend cell must contain exactly one colored bar"
   135	        colors.append(int(next(iter(cell_colors))))
   136	    assert len(colors) == 4, "legend must encode four colors"
   137	    return colors
   138	
   139	
   140	def _find_teal_square(g: np.ndarray, teal: int = TEAL) -> tuple[int, int, int]:
   141	    """Return (r0, c0, size) for the unique solid teal square."""
   142	    candidates: list[tuple[int, int, int]] = []
   143	    for cells in components_mask(g == teal, connectivity=4):
   144	        r0, c0, r1, c1 = bbox_coords(cells)
   145	        hh = r1 - r0 + 1
   146	        ww = c1 - c0 + 1
   147	        if hh != ww:
   148	            continue
   149	        size = hh
   150	        if int(np.sum(g[r0 : r1 + 1, c0 : c1 + 1] == teal)) != size * size:
   151	            continue
   152	        candidates.append((int(r0), int(c0), int(size)))
   153	    assert len(candidates) == 1, "main grid must contain exactly one solid teal square"
   154	    return candidates[0]
   155	
   156	
   157	def _rot_ccw(d: int) -> int:
   158	    return (d - 1) % 4
   159	
   160	
   161	def _rot_cw(d: int) -> int:
   162	    return (d + 1) % 4
   163	
   164	
   165	def _rot(d: int, turn: str) -> int:
   166	    return _rot_ccw(d) if turn == "L" else _rot_cw(d)
