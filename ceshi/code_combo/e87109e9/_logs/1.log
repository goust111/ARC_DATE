   281	def main(grid: np.ndarray) -> np.ndarray:
   282	    """
   283	    Trace four square beams that alternate turn direction and inherit obstacle colors.
   284	
   285	    Input structure:
   286	    - The top band is still a grey legend strip with four colored bars, but here it is only a removable decorative region rather than an operational lookup table.
   287	    - The rows below form one main board with a single solid teal square, a uniform background, and several colored edge-touching obstacle rectangles.
   288	
   289	    Rule:
   290	    - Remove the entire legend band from the output.
   291	    - Launch one sz-wide beam from the teal square in each cardinal direction.
   292	    - Each beam paints only background cells: the initial segment is teal, then after every collision the following segment changes to the collided obstacle's color.
   293	    - Turning ignores legend colors: the 1st, 3rd, 5th, ... collisions of a beam turn clockwise, while the 2nd, 4th, 6th, ... collisions turn counterclockwise.
   294	    - Obstacles themselves are never overwritten, and a beam stops once its next sz-wide step would leave the main board.
   295	
   296	    Key insight: Both visible trail color and future direction now depend on per-beam collision history, so the solver must track two evolving states at once: hit parity and inherited paint color.
   297	    """
   298	    g = np.asarray(grid, dtype=int)
   299	
   300	    rows_with_legend = np.where(np.any(g == LEGEND_BG, axis=1))[0]
   301	    assert rows_with_legend.size, "legend rows must be present"
   302	    legend_h = int(rows_with_legend.max() + 1)
   303	    assert np.array_equal(rows_with_legend, np.arange(legend_h)), "legend color must be confined to the top band"
   304	    _legend_colors(g, legend_h)
   305	
   306	    base = g[legend_h:, :].copy()
   307	    assert base.size, "main grid must remain after legend crop"
   308	
   309	    vals, cnts = np.unique(base, return_counts=True)
   310	    bg = int(vals[cnts.argmax()])
   311	    out, _hits, _beam_paints = _simulate_paths(
   312	        base,
   313	        bg,
   314	        turn_mode="alternate",
   315	        inherit_color=True,
   316	        enforce_clean=False,
   317	        max_hits_per_beam=None,
   318	    )
   319	    return out
   320	
