   169	def _simulate_paths(
   170	    base: np.ndarray,
   171	    bg: int,
   172	    *,
   173	    turn_mode: str,
   174	    inherit_color: bool,
   175	    legend_turn: dict[int, str] | None = None,
   176	    enforce_clean: bool,
   177	    max_hits_per_beam: int | None = None,
   178	) -> tuple[np.ndarray, list[list[tuple[int, int, int, int, int]]], list[dict[tuple[int, int], int]]]:
   179	    """
   180	    Simulate the four square beams on the cropped main grid.
   181	
   182	    `turn_mode` is either "alternate" or "legend".
   183	    `inherit_color` toggles the D4 behavior.
   184	    `enforce_clean=True` rejects cross-beam color conflicts.
   185	    """
   186	    sr, sc, sz = _find_teal_square(base, teal=TEAL)
   187	    out = base.copy()
   188	    h, w = out.shape
   189	    hits: list[list[tuple[int, int, int, int, int]]] = []
   190	    beam_paints: list[dict[tuple[int, int], int]] = []
   191	    global_paints: dict[tuple[int, int], int] = {}
   192	
   193	    def in_bounds(r: int, c: int) -> bool:
   194	        return 0 <= r and 0 <= c and r + sz - 1 < h and c + sz - 1 < w
   195	
   196	    def obstacle_at(r: int, c: int) -> int | None:
   197	        blk = base[r : r + sz, c : c + sz]
   198	        colors = set(map(int, np.unique(blk)))
   199	        colors.discard(bg)
   200	        colors.discard(TEAL)
   201	        if not colors:
   202	            return None
   203	        assert len(colors) == 1, "beam footprint must not hit mixed obstacle colors"
   204	        return int(next(iter(colors)))
   205	
   206	    for d0 in range(4):
   207	        r, c, d = int(sr), int(sc), d0
   208	        hit_parity = 0
   209	        paint_color = TEAL
   210	        beam_hits: list[tuple[int, int, int, int, int]] = []
   211	        beam_cells: dict[tuple[int, int], int] = {}
   212	        seen: set[tuple[int, int, int, int, int]] = set()
   213	
   214	        def paint_block(rr: int, cc: int) -> None:
   215	            blk_base = base[rr : rr + sz, cc : cc + sz]
   216	            bg_rows, bg_cols = np.where(blk_base == bg)
   217	            for roff, coff in zip(bg_rows, bg_cols):
   218	                cell = (int(rr + roff), int(cc + coff))
   219	                beam_cells[cell] = int(paint_color if inherit_color else TEAL)
   220	                out[cell] = beam_cells[cell]
   221	
   222	        while True:
   223	            state = (
   224	                r,
   225	                c,
   226	                d,
   227	                hit_parity if turn_mode == "alternate" else 0,
   228	                paint_color if inherit_color else TEAL,
   229	            )
   230	            assert state not in seen, "beam path must not cycle"
   231	            seen.add(state)
   232	
   233	            dr, dc = _DIRS[d]
   234	            nr, nc = r + dr, c + dc
   235	            if not in_bounds(nr, nc):
   236	                break
   237	
   238	            obs = obstacle_at(nr, nc)
   239	            if obs is None:
   240	                r, c = nr, nc
   241	                paint_block(r, c)
   242	                continue
   243	
   244	            beam_hits.append((hit_parity + 1, d, obs, nr, nc))
   245	            if turn_mode == "alternate":
   246	                d = _rot_cw(d) if hit_parity == 0 else _rot_ccw(d)
   247	                hit_parity ^= 1
   248	            else:
   249	                assert legend_turn is not None and obs in legend_turn, "legend turn must exist"
   250	                d = _rot(d, legend_turn[obs])
   251	            if inherit_color:
   252	                paint_color = int(obs)
   253	            if max_hits_per_beam is not None:
   254	                assert len(beam_hits) <= max_hits_per_beam, "too many hits for generated sample"
   255	
   256	        if enforce_clean:
   257	            for cell, color in beam_cells.items():
   258	                prev = global_paints.get(cell)
   259	                if prev is not None:
   260	                    assert prev == color, "overlapping beams must agree on color"
   261	                global_paints[cell] = color
   262	        else:
   263	            global_paints.update(beam_cells)
   264	        hits.append(beam_hits)
   265	        beam_paints.append(beam_cells)
   266	
   267	    return out, hits, beam_paints
