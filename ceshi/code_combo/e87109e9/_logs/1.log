+    bg = int(vals[cnts.argmax()])
+    out, _hits, _beam_paints = _simulate_paths(
+        base,
+        bg,
+        turn_mode="alternate",
+        inherit_color=True,
+        enforce_clean=False,
+        max_hits_per_beam=None,
+    )
+    return out
