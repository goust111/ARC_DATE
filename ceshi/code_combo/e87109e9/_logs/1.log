   330	def _make_legend(legend_colors: list[int], legend_dirs: dict[int, str]) -> np.ndarray:
   331	    """Build the unchanged-looking 6x24 legend band."""
   332	    legend = np.full((LEGEND_H, GRID_W), LEGEND_BG, dtype=int)
   333	    for start, color in zip(LEGEND_CELL_STARTS, legend_colors):
   334	        legend[1:5, start : start + 4] = 0
   335	        bar_col = start if legend_dirs[color] == "L" else start + 3
   336	        legend[1:5, bar_col] = color
   337	    return legend
