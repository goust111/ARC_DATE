   322	def _random_legend_dirs(colors: list[int]) -> dict[int, str]:
   323	    """Assign decorative legend bars without encoding the real rule."""
   324	    while True:
   325	        dirs = {color: random.choice(["L", "R"]) for color in colors}
   326	        if len(set(dirs.values())) == 2:
   327	            return dirs
