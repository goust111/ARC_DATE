+        while True:
+            state = (
+                r,
+                c,
+                d,
+                hit_parity if turn_mode == "alternate" else 0,
+                paint_color if inherit_color else TEAL,
+            )
+            assert state not in seen, "beam path must not cycle"
+            seen.add(state)
+
+            dr, dc = _DIRS[d]
+            nr, nc = r + dr, c + dc
+            if not in_bounds(nr, nc):
+                break
+
+            obs = obstacle_at(nr, nc)
+            if obs is None:
+                r, c = nr, nc
+                paint_block(r, c)
+                continue
