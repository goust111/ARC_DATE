   115	def _find_obstacles(
   116	    base: np.ndarray, bg: int, teal: int = TEAL
   117	) -> tuple[np.ndarray, list[tuple[int, int, int, int]], list[int]]:
   118	    """Extract static obstacle geometry as rectangle ids, boxes, and original colors."""
   119	    obstacle_mask = (base != bg) & (base != teal)
   120	    obstacle_ids = np.full(base.shape, -1, dtype=int)
   121	    boxes: list[tuple[int, int, int, int]] = []
   122	    colors: list[int] = []
   123	    for obs_id, cells in enumerate(components_mask(obstacle_mask, connectivity=4)):
   124	        r0, c0, r1, c1 = bbox_coords(cells)
   125	        color_vals = set(map(int, np.unique(base[r0 : r1 + 1, c0 : c1 + 1])))
   126	        color_vals.discard(bg)
   127	        color_vals.discard(teal)
   128	        assert len(color_vals) == 1, "each obstacle must be single-colored"
   129	        color = int(next(iter(color_vals)))
   130	        rect = base[r0 : r1 + 1, c0 : c1 + 1]
   131	        assert np.all(rect == color), "each obstacle must be a solid rectangle"
   132	        obstacle_ids[r0 : r1 + 1, c0 : c1 + 1] = obs_id
   133	        boxes.append((int(r0), int(c0), int(r1), int(c1)))
   134	        colors.append(color)
   135	    assert boxes, "main grid must contain at least one obstacle"
   136	    return obstacle_ids, boxes, colors
   137	
   138	
   139	def _rot_ccw(d: int) -> int:
   140	    return (d - 1) % 4
   141	
   142	
   143	def _rot_cw(d: int) -> int:
   144	    return (d + 1) % 4
   145	
   146	
   147	def _rot(d: int, turn: str) -> int:
   148	    return _rot_ccw(d) if turn == "L" else _rot_cw(d)
   149	
   150	
   151	def _simulate_combo(
   152	    base: np.ndarray, turns: dict[int, str], bg: int
   153	) -> tuple[np.ndarray, list[dict[str, object]]]:
   154	    """Sequential combo oracle: pass through, recolor whole obstacles, then reuse teal state."""
   155	    sr, sc, sz = _find_teal_square(base, teal=TEAL)
   156	    obstacle_ids, boxes, original_colors = _find_obstacles(base, bg, teal=TEAL)
   157	    out = base.copy()
   158	    h, w = out.shape
   159	    recolored_mask = 0
   160	    beam_stats: list[dict[str, object]] = []
   161	
   162	    def in_bounds(r: int, c: int) -> bool:
   163	        return 0 <= r and 0 <= c and r + sz - 1 < h and c + sz - 1 < w
   164	
   165	    def paint_block(r: int, c: int) -> None:
   166	        out[r : r + sz, c : c + sz] = TEAL
   167	
   168	    def obstacle_at(r: int, c: int) -> int | None:
   169	        ids = set(map(int, np.unique(obstacle_ids[r : r + sz, c : c + sz])))
   170	        ids.discard(-1)
   171	        if not ids:
   172	            return None
   173	        assert len(ids) == 1, "beam footprint must not hit mixed obstacles"
   174	        return int(next(iter(ids)))
   175	
   176	    def recolor_obstacle(obs_id: int) -> None:
   177	        r0, c0, r1, c1 = boxes[obs_id]
   178	        out[r0 : r1 + 1, c0 : c1 + 1] = TEAL
   179	
   180	    for d0 in range(4):
   181	        r, c, d = sr, sc, d0
   182	        hits: list[tuple[int, int, int, int, int, int, int, str]] = []
   183	        seen: set[tuple[int, int, int, int]] = set()
   184	        while True:
   185	            state = (r, c, d, recolored_mask)
   186	            assert state not in seen, "beam path must not cycle"
   187	            seen.add(state)
   188	
   189	            dr, dc = _DIRS[d]
   190	            nr, nc = r + dr, c + dc
   191	            if not in_bounds(nr, nc):
   192	                break
   193	
   194	            obs_id = obstacle_at(nr, nc)
   195	            if obs_id is None:
   196	                r, c = nr, nc
   197	                paint_block(r, c)
   198	                continue
   199	
   200	            was_teal = bool(recolored_mask & (1 << obs_id))
   201	            color_before = TEAL if was_teal else original_colors[obs_id]
   202	            turn = "R" if was_teal else turns[color_before]
   203	            assert was_teal or color_before in turns, "obstacle color must be encoded by legend"
   204	
   205	            recolored_mask |= 1 << obs_id
   206	            recolor_obstacle(obs_id)
   207	
   208	            entry_r, entry_c = nr, nc
   209	            exited = False
   210	            while True:
   211	                r, c = nr, nc
   212	                paint_block(r, c)
   213	                nnr, nnc = r + dr, c + dc
   214	                if not in_bounds(nnr, nnc):
   215	                    break
   216	                obs2 = obstacle_at(nnr, nnc)
   217	                if obs2 == obs_id:
   218	                    nr, nc = nnr, nnc
   219	                    continue
   220	                assert obs2 is None, "different obstacles must not touch along a traversed lane"
   221	                r, c = nnr, nnc
   222	                paint_block(r, c)
   223	                exited = True
   224	                break
   225	            if not exited:
   226	                break
   227	
   228	            hits.append((obs_id, color_before, entry_r, entry_c, r, c, d, turn))
   229	            d = _rot(d, turn)
