+    def recolor_obstacle(obs_id: int) -> None:
+        r0, c0, r1, c1 = boxes[obs_id]
+        out[r0 : r1 + 1, c0 : c1 + 1] = TEAL
+
+    for d0 in range(4):
+        r, c, d = sr, sc, d0
+        seen: set[tuple[int, int, int]] = set()
+        while True:
+            state = (r, c, d)
+            assert state not in seen
+            seen.add(state)
+
+            dr, dc = _DIRS[d]
+            nr, nc = r + dr, c + dc
+            if not in_bounds(nr, nc):
+                break
+
+            obs_id = obstacle_at(nr, nc)
+            if obs_id is None:
+                r, c = nr, nc
+                paint_block(r, c)
+                continue
+
+            recolor_obstacle(obs_id)
+            turn = turns[original_colors[obs_id]]
+            exited = False
+            while True:
+                r, c = nr, nc
+                paint_block(r, c)
+                nnr, nnc = r + dr, c + dc
+                if not in_bounds(nnr, nnc):
+                    break
+                obs2 = obstacle_at(nnr, nnc)
+                if obs2 == obs_id:
+                    nr, nc = nnr, nnc
+                    continue
+                assert obs2 is None
+                r, c = nnr, nnc
+                paint_block(r, c)
+                exited = True
+                break
+            if not exited:
+                break
+            d = _rot(d, turn)
