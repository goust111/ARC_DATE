   378	    for start, color in zip(LEGEND_CELL_STARTS, legend_colors):
   379	        legend[1:5, start : start + 4] = 0
   380	        bar_col = start if turns[color] == "L" else start + 3
   381	        legend[1:5, bar_col] = color
   382	    return legend
