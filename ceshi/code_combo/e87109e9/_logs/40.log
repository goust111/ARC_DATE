   339	def _pick_cover_span(
   340	    axis_len: int,
   341	    required: list[tuple[int, int]],
   342	    low: int,
   343	    high: int,
   344	    min_len: int,
   345	    max_len: int,
   346	) -> tuple[int, int] | None:
   347	    """Pick a 1D span covering all required intervals and staying inside [low, high]."""
   348	    if low > high:
   349	        return None
   350	    req0 = min(a for a, _ in required)
   351	    req1 = max(b for _, b in required)
   352	    if req0 < low or req1 > high:
   353	        return None
   354	
   355	    lo = max(min_len, req1 - req0 + 1)
   356	    hi = min(max_len, high - low + 1, axis_len)
   357	    choices: list[tuple[int, int, int]] = []
   358	    for length in range(lo, hi + 1):
   359	        start0 = max(low, req1 - length + 1)
   360	        start1 = min(req0, high - length + 1)
   361	        for start in range(start0, start1 + 1):
   362	            end = start + length - 1
   363	            choices.append((length, start, end))
   364	    if not choices:
   365	        return None
   366	
   367	    lengths = sorted({length for length, _, _ in choices})
   368	    if random.random() < SPAN_COMPACT_PROB:
   369	        cutoff = lengths[min(len(lengths) - 1, len(lengths) // 2)]
   370	        pool = [(start, end) for length, start, end in choices if length <= cutoff]
   371	    else:
   372	        pool = [(start, end) for _, start, end in choices]
   373	    return random.choice(pool)
