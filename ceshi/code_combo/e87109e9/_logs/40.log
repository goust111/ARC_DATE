    72	def _parse_legend(grid: np.ndarray, legend_h: int) -> dict[int, str]:
    73	    """Decode obstacle-turn direction from the legend strip."""
    74	    legend = grid[:legend_h, :]
    75	    assert legend.size, "legend must be non-empty"
    76	    vals, counts = np.unique(legend, return_counts=True)
    77	    bg = int(vals[counts.argmax()])
    78	
    79	    sep_cols = [c for c in range(legend.shape[1]) if np.all(legend[:, c] == bg)]
    80	    assert len(sep_cols) >= 2, "legend separator columns must exist"
    81	
    82	    turn: dict[int, str] = {}
    83	    for a, b in zip(sep_cols, sep_cols[1:], strict=False):
    84	        if b - a <= 2:
    85	            continue
    86	        interior = legend[1 : legend_h - 1, a + 1 : b]
    87	        colors = set(map(int, np.unique(interior)))
    88	        colors.discard(bg)
    89	        colors.discard(0)
    90	        assert len(colors) == 1, "each legend cell must encode exactly one color"
    91	        color = int(next(iter(colors)))
    92	        xs = np.where(interior == color)[1]
    93	        x = int(xs[0])
    94	        turn[color] = "L" if x <= (interior.shape[1] - 1) // 2 else "R"
    95	    assert len(turn) == 4, "legend must encode four turn colors"
    96	    return turn
