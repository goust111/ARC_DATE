+                if obs2 == obs_id:
+                    nr, nc = nnr, nnc
+                    continue
+                assert obs2 is None, "different obstacles must not touch along a traversed lane"
+                r, c = nnr, nnc
+                paint_block(r, c)
+                exited = True
+                break
+            if not exited:
+                break
+
+            hits.append((obs_id, color_before, entry_r, entry_c, r, c, d, turn))
+            d = _rot(d, turn)
