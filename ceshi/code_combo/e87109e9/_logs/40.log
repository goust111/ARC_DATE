   305	def main(grid: np.ndarray) -> np.ndarray:
   306	    """
   307	    Fire teal square-beams in sequence; obstacles are traversed, recolored, and later reinterpreted.
   308	
   309	    Input structure:
   310	    - The top strip is a 6x24 legend: each of the four cells contains one colored vertical bar, and the bar's left/right placement encodes counterclockwise vs clockwise turning for that color.
   311	    - The lower board contains one solid teal source square on a uniform background plus several solid colored rectangular obstacles.
   312	
   313	    Rule:
   314	    - Remove the legend strip in the output.
   315	    - Emit four sz x sz beams from the source in the fixed order up, right, down, left.
   316	    - When a beam moves through background, it paints teal normally. When it first meets a colored obstacle, it immediately repaints that whole obstacle teal, keeps moving straight through the obstacle, steps out on the far side, and only then turns.
   317	    - If the obstacle was still in its original color, use the legend to decide left vs right. If an earlier beam had already turned that obstacle teal, then this later beam treats teal as a special case: after exiting, it always turns clockwise.
   318	    - Beams stop only when their next sz x sz step would leave the board.
   319	
   320	    Key insight: The legend is no longer the whole story. You must combine three cues at once: turns happen after crossing an obstacle, collisions recolor the whole obstacle to teal, and the firing order matters because later beams may hit an already-teal obstacle that now obeys a different fixed turn rule.
   321	    """
   322	    g = np.asarray(grid, dtype=int)
   323	
   324	    rows_with_legend = np.where(np.any(g == LEGEND_BG, axis=1))[0]
   325	    assert rows_with_legend.size, "legend rows must be present"
   326	    legend_h = int(rows_with_legend.max() + 1)
   327	    assert np.array_equal(rows_with_legend, np.arange(legend_h)), "legend color must be confined to the top band"
   328	
   329	    legend_turn = _parse_legend(g, legend_h)
   330	    base = g[legend_h:, :].copy()
   331	    assert base.size, "main grid must remain after legend crop"
   332	
   333	    vals, counts = np.unique(base, return_counts=True)
   334	    bg = int(vals[counts.argmax()])
   335	    out, _stats = _simulate_combo(base, legend_turn, bg)
   336	    return out
