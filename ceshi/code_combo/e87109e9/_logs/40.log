    99	def _find_teal_square(g: np.ndarray, teal: int = TEAL) -> tuple[int, int, int]:
   100	    """Return (r0, c0, size) for the unique solid teal square."""
   101	    candidates: list[tuple[int, int, int]] = []
   102	    for cells in components_mask(g == teal, connectivity=4):
   103	        r0, c0, r1, c1 = bbox_coords(cells)
   104	        hh = r1 - r0 + 1
   105	        ww = c1 - c0 + 1
   106	        if hh != ww:
   107	            continue
   108	        if int(np.sum(g[r0 : r1 + 1, c0 : c1 + 1] == teal)) != hh * ww:
   109	            continue
   110	        candidates.append((int(r0), int(c0), int(hh)))
   111	    assert len(candidates) == 1, "main grid must contain exactly one solid teal square"
   112	    return candidates[0]
