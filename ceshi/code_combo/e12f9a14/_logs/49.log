+        cells.update((fr0, fc0 + dc) for dc in range(4))
+    if lr == 3:
+        cells.update((fr0 + 3, fc0 + dc) for dc in range(4))
+    if lc == 0:
+        cells.update((fr0 + dr, fc0) for dr in range(4))
+    if lc == 3:
+        cells.update((fr0 + dr, fc0 + 3) for dr in range(4))
+    cells.discard(gap)
+    return cells
