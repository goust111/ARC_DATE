+# --------------- generator ---------------
+
+BLOCK_COUNT_RANGE = (1, 2)
+GRID_SIZE_MAX = 31
+GRID_SIZE_MIN_BY_BLOCKS = {1: 10, 2: 16, 4: 22}
+BG_CHOICES = [0, 8]
+BG_WEIGHTS = [0.25, 0.75]
+FRAME_COLOR_FOR_BG = {8: 3, 0: 8}
+PALETTE_FOR_BG = {
+    8: [1, 2, 4, 6, 7, 9],
+    0: [1, 2, 3, 4, 6, 7, 9],
