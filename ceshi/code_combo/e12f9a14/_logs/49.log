+
+        if diff == 2:
+            is_diag_a = abs(da[0]) + abs(da[1]) == 2
+            is_diag_b = abs(db[0]) + abs(db[1]) == 2
+            assert not (is_diag_a and is_diag_b), "two diagonal beams must cross geometrically, not collide at one cell"
