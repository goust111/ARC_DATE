+            pa = find_partner(a)
+            pb = find_partner(b)
+            if pa is not None:
+                group.add(pa)
+            if pb is not None:
+                group.add(pb)
+            for gid in group:
+                beams[gid].pattern = (nd,)
+                beams[gid].phase = 0
+                beams[gid].active = True
+            return
