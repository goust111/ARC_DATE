+FRAME_BBOX_GAP = 3
+PLACEMENT_MARGIN = 2
+MIN_RAY_STEPS = 6
+MIN_RAY_BOUNCES = 1
+MIN_TOTAL_REFLECTIONS = 2
+MIN_MAX_REFLECTIONS_ON_BEAM = 2
+MIN_BEAM_PIXELS_PER_GAP = 5
+MIN_RECOLORED_FRAME_PIXELS = 6
