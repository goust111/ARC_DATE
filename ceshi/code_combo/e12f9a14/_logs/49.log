    except Exception as e:
        reasons[type(e).__name__ + ':' + str(e)] = reasons.get(type(e).__name__ + ':' + str(e), 0) + 1
        continue
    if np.count_nonzero(out "'!= grid) < gap_total * mod.MIN_BEAM_PIXELS_PER_GAP:
        reasons['"'beam_pixels'] = reasons.get('beam_pixels', 0) + 1
        continue
    if stats['total_reflections'] < mod.MIN_TOTAL_REFLECTIONS:
