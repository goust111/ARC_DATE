+                recolor_frame(other_frame, int(frames[frame_id]["color"]))
+                stats["collision_count"] += 1
+                stats["last_event"] = "collision"
+                out[nxt[0], nxt[1]] = bg
+                cell_owner.pop(nxt, None)
+                cell_enter.pop(nxt, None)
+                blocked.add(nxt)
+                return "collision", None
