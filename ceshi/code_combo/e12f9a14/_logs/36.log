+GRID_SIZE_MIN = 22
+GRID_SIZE_MAX = 31
+PLACEMENT_MARGIN = 2
+FRAME_BBOX_GAP = 2
+H1_RANGE = (6, 11)
+H2_MIN = 4
+V_RANGE = (4, 9)
+GEN_RETRIES = 400
