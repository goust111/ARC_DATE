+    c = (r0 - v - 3, c0 + 3 + h1)
+    d = (r0 - v - 3, c0 + h1 - h2)
+    return [
+        {"pos": a, "gaps": (_A_GAP,)},
+        {"pos": b, "gaps": _B_GAPS},
+        {"pos": c, "gaps": _C_GAPS},
+        {"pos": d, "gaps": _D_GAPS},
