+    grid = np.full((n, n), bg, dtype=int)
+    for spec, color in zip(specs, block_colors):
+        pr, pc = spec["pos"]
+        _draw_framed_block(grid, pr, pc, bg, frame_color, int(color), tuple(spec["gaps"]))
