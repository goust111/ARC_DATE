+def _frame_gaps_for_block(g: np.ndarray, bg: int, wall: int, br: int, bc: int) -> list[tuple[int, int]]:
+    h, w = g.shape
+    fr0, fc0 = br - 1, bc - 1
+    fr1, fc1 = br + 2, bc + 2
+    gaps: list[tuple[int, int]] = []
+    for r in range(fr0, fr1 + 1):
