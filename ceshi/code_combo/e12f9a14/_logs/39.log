+    td = _opp(d)
+    tgap_local = _DIR_TO_GAP[td]
+    target_gap = (target_pos[0] + tgap_local[0], target_pos[1] + tgap_local[1])
+    if marker != (target_gap[0] + td[0], target_gap[1] + td[1]):
+        return None
