+        "target_pos": target_pos,
+        "dir": d,
+        "target_dir": td,
+        "marker": marker,
+        "points": tuple(points),
+        "diag_sigs": diag_sigs,
+        "cells": frozenset(source_cells | target_cells | {marker} | set(points)),
