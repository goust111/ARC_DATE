+        target = targets[color]
+        gap = source["gap"]
+        d = source["dir"]
+        marker = target["marker"]
+        out[gap[0], gap[1]] = color
+        pos = gap
+        for _ in range(h * w):
+            nxt = (pos[0] + d[0], pos[1] + d[1])
+            assert in_bounds(nxt), "ray left the grid before reaching its paired target"
+            if nxt == marker:
