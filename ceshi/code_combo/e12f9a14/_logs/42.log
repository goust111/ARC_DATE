+        active = [bid for bid, beam in beams.items() if beam.active]
+        if not active:
+            break
+
+        prop: dict[int, tuple[tuple[int, int], tuple[int, int]]] = {}
+        for bid in active:
+            beam = beams[bid]
+            d = beam.direction
+            nxt = (beam.pos[0] + d[0], beam.pos[1] + d[1])
+            if not in_bounds(nxt) or int(g[nxt[0], nxt[1]]) != bg:
+                beam.active = False
