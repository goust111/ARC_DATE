+            ok = (
+                0 <= r - 1 < h
+                and 0 <= r + 1 < h
+                and int(g[r - 1, c]) == wall
+                and int(g[r + 1, c]) == wall
+            )
+        elif dc == 0:
+            ok = (
+                0 <= c - 1 < w
+                and 0 <= c + 1 < w
+                and int(g[r, c - 1]) == wall
+                and int(g[r, c + 1]) == wall
+            )
+        else:
+            ok = (
+                0 <= r - dr < h
+                and 0 <= c - dc < w
+                and int(g[r - dr, c]) == wall
+                and int(g[r, c - dc]) == wall
+            )
