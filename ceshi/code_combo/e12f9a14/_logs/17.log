+    out = g.copy()
+    beams: dict[int, _Beam] = {}
+    next_bid = 0
+
+    cell_owner: dict[tuple[int, int], int] = {}
+    cell_enter: dict[tuple[int, int], tuple[int, int]] = {}
+    cell_index: dict[tuple[int, int], int] = {}
+
+    stats = {
+        "priority_collision_count": 0,
+        "turn45_count": 0,
+        "turn90_count": 0,
+        "reroute_count": 0,
