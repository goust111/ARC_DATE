+
+_CORE_PALETTE = [1, 2, 4, 6]
+_BG_CHOICES = [0, 8]
+_FRAME_COLOR_FOR_BG = {0: 8, 8: 3}
+_GRID_SIZE_RANGE = (16, 27)
+_FRAME_BBOX_GAP = 2
+_GEN_RETRIES = 400
+_MIN_CHANGED_PIXELS = 8
+
+_TEMPLATES = (
+    {
+        "name": "90",
+        "low_gap": (1, 3),   # east
+        "high_gap": (3, 1),  # south
+    },
+    {
+        "name": "45",
+        "low_gap": (1, 3),   # east
+        "high_gap": (0, 3),  # north-east diagonal
+    },
