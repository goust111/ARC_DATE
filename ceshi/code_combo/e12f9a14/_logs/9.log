+class _Beam:
+    __slots__ = ("color", "pos", "direction", "active")
+
+    def __init__(self, color: int, pos: tuple[int, int], direction: tuple[int, int]):
+        self.color = int(color)
+        self.pos = pos
+        self.direction = direction
