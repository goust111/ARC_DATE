+def _simulate(grid: np.ndarray, collect_stats: bool = False):
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    bg = get_bg(g)
+
+    out = g.copy()
+    blocks = _find_blocks_2x2(g, bg)
+    assert blocks, "expected at least one 2x2 block in input"
