+BLOCK_COUNT_RANGE = (3, 6)  # uniform [lo, hi)
+GRID_SIZE_MAX = 31
+GRID_SIZE_MIN_BY_BLOCKS = {3: 16, 4: 20, 5: 23}
+BG_CHOICES = [0, 8]
+BG_WEIGHTS = [0.25, 0.75]
+PALETTE_FOR_BG = {
+    8: [1, 2, 4, 6, 7, 9],
+    0: [1, 2, 4, 6, 7, 8, 9],
