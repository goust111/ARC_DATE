+                return None
+        path.append(nxt)
+        visited.add(nxt)
+        segments.append(seg)
+        pos = nxt
+
+    nr, nc = pos[0] + cur_d[0], pos[1] + cur_d[1]
+    next_d = cur_d
+    if not (0 <= nr < h and 0 <= nc < w):
