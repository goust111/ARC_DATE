+            return None
+        nxt = (nr, nc)
+        if int(grid[nr, nc]) != bg or nxt in visited:
+            return None
+        seg = (pos, nxt)
+        for old_seg in segments:
+            if _segment_crosses(seg, old_seg):
+                return None
+        path.append(nxt)
+        visited.add(nxt)
+        segments.append(seg)
