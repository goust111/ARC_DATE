+        flip_c = not (0 <= nc < w)
+        next_d = _reflect_dir(cur_d, flip_r, flip_c)
+        nr, nc = pos[0] + next_d[0], pos[1] + next_d[1]
+    open_after_budget = (
+        0 <= nr < h
+        and 0 <= nc < w
+        and int(grid[nr, nc]) == bg
+        and (nr, nc) not in visited
+        and not any(_segment_crosses((pos, (nr, nc)), old_seg) for old_seg in segments)
+    )
+    return {
