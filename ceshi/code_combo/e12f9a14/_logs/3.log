+def _reflect_dir(d: tuple[int, int], flip_r: bool, flip_c: bool) -> tuple[int, int]:
+    dr, dc = d
+    if flip_r:
+        dr = -dr
+    if flip_c:
+        dc = -dc
+    return int(dr), int(dc)
+
+
+def _reflect_pattern(
+    pattern: tuple[tuple[int, int], ...], flip_r: bool, flip_c: bool
