+            return None
+        d = b.next_dir()
+        partner: int | None = None
+        for oid, ob in beams.items():
+            if oid == bid or not ob.active:
+                continue
+            if ob.pattern != b.pattern or ob.phase != b.phase:
+                continue
+            if ob.next_dir() != d:
