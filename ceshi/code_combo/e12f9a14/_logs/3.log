+        bv = beams[bid_v]
+        adj = (bv.pos[0] + u[0], bv.pos[1] + u[1])
+        assert in_bounds(adj) and is_free(adj) and cell_owner.get(adj) is None, "expected free adjacent zigzag step"
+        bv.path.append(adj)
+        bv.enter_dirs.append(u)
+        bv.pos = adj
+        paint_cell(bid_v, adj, u)
