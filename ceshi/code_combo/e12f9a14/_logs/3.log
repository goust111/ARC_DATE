+                truncate_beam(bid_v, cell_index[cell])
+                unpaint_cell(cell)
+            if cell_owner.get(cell) == bid_u:
+                truncate_beam(bid_u, cell_index[cell] + 1)
+            else:
+                bu = beams[bid_u]
+                bu.path.append(cell)
+                bu.enter_dirs.append(u)
+                bu.pos = cell
+                paint_cell(bid_u, cell, u)
