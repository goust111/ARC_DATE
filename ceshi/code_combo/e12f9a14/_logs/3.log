+                continue
+            if int(g[r, c]) == bg:
+                gaps.append((r, c))
+
+    out: list[tuple[int, int]] = []
+    for r, c in gaps:
+        dr = -1 if r == fr0 else (1 if r == fr1 else 0)
+        dc = -1 if c == fc0 else (1 if c == fc1 else 0)
+        assert dr != 0 or dc != 0, "expected candidate gap on frame border"
+        ok = True
+        if dr == 0:
+            ok = (
+                0 <= r - 1 < h
+                and 0 <= r + 1 < h
+                and int(g[r - 1, c]) == wall
+                and int(g[r + 1, c]) == wall
