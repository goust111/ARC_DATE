   266	def _frame_seeds(frame: dict[str, object]) -> list[tuple[int, tuple[int, int], tuple[tuple[int, int], ...]]]:
   267	    br = int(frame["br"])
   268	    bc = int(frame["bc"])
   269	    color = int(frame["color"])
   270	    seeds: list[tuple[int, tuple[int, int], tuple[tuple[int, int], ...]]] = []
   271	    for gr, gc in frame["gaps"]:
   272	        dr = -1 if gr == br - 1 else (1 if gr == br + 2 else 0)
   273	        dc = -1 if gc == bc - 1 else (1 if gc == bc + 2 else 0)
   274	        d = _normalize_dir(dr, dc)
   275	        assert d != (0, 0), "expected each frame gap to face outward"
   276	        seeds.append((color, (gr, gc), (d,)))
   277	    return seeds
