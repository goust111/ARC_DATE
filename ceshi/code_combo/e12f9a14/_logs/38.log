   103	def _find_blocks_2x2(g: np.ndarray, bg: int) -> list[tuple[int, int, int]]:
   104	    h, w = g.shape
   105	    blocks: list[tuple[int, int, int]] = []
   106	    for r in range(h - 1):
   107	        for c in range(w - 1):
   108	            v = int(g[r, c])
   109	            if v == bg:
   110	                continue
   111	            if int(g[r, c + 1]) == v and int(g[r + 1, c]) == v and int(g[r + 1, c + 1]) == v:
   112	                blocks.append((v, r, c))
   113	    return blocks
   114	
   115	
   116	def _infer_frame_color(g: np.ndarray, bg: int, br: int, bc: int, block_col: int) -> int:
   117	    h, w = g.shape
   118	    fr0, fc0 = br - 1, bc - 1
   119	    fr1, fc1 = br + 2, bc + 2
   120	    vals: list[int] = []
   121	    for r in range(fr0, fr1 + 1):
   122	        for c in range(fc0, fc1 + 1):
   123	            if not (0 <= r < h and 0 <= c < w):
   124	                continue
   125	            if not (r in (fr0, fr1) or c in (fc0, fc1)):
   126	                continue
   127	            v = int(g[r, c])
   128	            if v != bg and v != block_col:
   129	                vals.append(v)
   130	    frame_colors = sorted(set(vals))
   131	    assert len(frame_colors) == 1, "expected a unique frame color around each 2x2 block"
   132	    return frame_colors[0]
