   135	def _frame_gaps_for_block(g: np.ndarray, bg: int, wall: int, br: int, bc: int) -> list[tuple[int, int]]:
   136	    h, w = g.shape
   137	    fr0, fc0 = br - 1, bc - 1
   138	    fr1, fc1 = br + 2, bc + 2
   139	    gaps: list[tuple[int, int]] = []
   140	    for r in range(fr0, fr1 + 1):
   141	        for c in range(fc0, fc1 + 1):
   142	            if not (0 <= r < h and 0 <= c < w):
   143	                continue
   144	            if not (r in (fr0, fr1) or c in (fc0, fc1)):
   145	                continue
   146	            if int(g[r, c]) == bg:
   147	                gaps.append((r, c))
   148	    out: list[tuple[int, int]] = []
   149	    for r, c in gaps:
   150	        dr = -1 if r == fr0 else (1 if r == fr1 else 0)
   151	        dc = -1 if c == fc0 else (1 if c == fc1 else 0)
   152	        assert dr != 0 or dc != 0, "expected candidate gap on frame border"
   153	        ok = True
   154	        if dr == 0:
   155	            ok = (
   156	                0 <= r - 1 < h
   157	                and 0 <= r + 1 < h
   158	                and int(g[r - 1, c]) == wall
   159	                and int(g[r + 1, c]) == wall
   160	            )
   161	        elif dc == 0:
   162	            ok = (
   163	                0 <= c - 1 < w
   164	                and 0 <= c + 1 < w
   165	                and int(g[r, c - 1]) == wall
   166	                and int(g[r, c + 1]) == wall
   167	            )
   168	        else:
   169	            ok = (
   170	                0 <= r - dr < h
   171	                and 0 <= c < w
   172	                and 0 <= r < h
   173	                and 0 <= c - dc < w
   174	                and int(g[r - dr, c]) == wall
   175	                and int(g[r, c - dc]) == wall
   176	            )
   177	        if ok:
   178	            out.append((r, c))
   179	    out_set = set(out)
   180	    if len(out_set) >= 3 and (fr1, fc1) in out_set and (fr0, bc + 1) in out_set:
   181	        out = [p for p in out if p != (fr1, fc1)]
   182	    return out
   183	
   184	
   185	def _normalize_dir(dr: int, dc: int) -> tuple[int, int]:
   186	    if dr == 0 and dc == 0:
   187	        return (0, 0)
   188	    if dr != 0 and dc != 0:
   189	        return (int(np.sign(dr)), int(np.sign(dc)))
   190	    if dr != 0:
   191	        return (int(np.sign(dr)), 0)
   192	    return (0, int(np.sign(dc)))
   193	
   194	
   195	def _dir_diff(a: tuple[int, int], b: tuple[int, int]) -> int:
   196	    ia = _DIR_TO_I[a]
   197	    ib = _DIR_TO_I[b]
   198	    d = (ia - ib) % 8
   199	    return min(d, 8 - d)
   200	
   201	
   202	def _frame_center_dist2(br: int, bc: int, h: int, w: int) -> int:
   203	    dr2 = 2 * br + 1 - (h - 1)
   204	    dc2 = 2 * bc + 1 - (w - 1)
   205	    return int(dr2 * dr2 + dc2 * dc2)
   206	
