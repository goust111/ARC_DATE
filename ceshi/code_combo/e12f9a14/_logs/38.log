   245	def _build_frames(g: np.ndarray, bg: int) -> list[dict[str, object]]:
   246	    h, w = g.shape
   247	    frames: list[dict[str, object]] = []
   248	    blocks = _find_blocks_2x2(g, bg)
   249	    assert blocks, "expected at least one 2x2 block in input"
   250	    for col, br, bc in blocks:
   251	        frame_col = _infer_frame_color(g, bg, br, bc, col)
   252	        gaps = _frame_gaps_for_block(g, bg, frame_col, br, bc)
   253	        assert gaps, "expected each frame to expose at least one structural gap"
   254	        frames.append(
   255	            {
   256	                "color": int(col),
   257	                "br": int(br),
   258	                "bc": int(bc),
   259	                "gaps": list(gaps),
   260	                "dist2": _frame_center_dist2(br, bc, h, w),
   261	            }
   262	        )
   263	    return frames
