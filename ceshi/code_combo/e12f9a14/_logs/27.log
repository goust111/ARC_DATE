+# Combo variant of e12f9a14 (index 27)
+# combo_spec: D12/0+D13/1
+# Name: 裁剪到射线区域+框架消失
+
+import itertools
+
+import numpy as np
+
+from arc_utils import bbox, crop_bbox, get_bg, paste
