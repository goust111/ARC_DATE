+        _draw_framed_block(obstacles, r0, c0, bg, frame_color, int(color), ())
+
+    chosen_gaps = []
+    for r0, c0 in positions:
+        available = _clear_gap_combos(obstacles, bg, r0, c0)
+        if not available:
+            return None
+        chosen_gaps.append(_choose_gap_pattern(available, rng))
