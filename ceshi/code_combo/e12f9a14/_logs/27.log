+    fr1, fc1 = br + 2, bc + 2
+    gaps: list[tuple[int, int]] = []
+    for r in range(fr0, fr1 + 1):
+        for c in range(fc0, fc1 + 1):
+            if not (0 <= r < h and 0 <= c < w):
+                continue
+            if not (r in (fr0, fr1) or c in (fc0, fc1)):
+                continue
