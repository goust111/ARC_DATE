+    grid = np.full((n, n), bg, dtype=int)
+    gap_total = 0
+    seeds: list[tuple[tuple[int, int], tuple[int, int]]] = []
+    for (r0, c0), color, gaps in zip(positions, block_colors, chosen_gaps):
+        gap_total += len(gaps)
+        _draw_framed_block(grid, r0, c0, bg, frame_color, int(color), gaps)
