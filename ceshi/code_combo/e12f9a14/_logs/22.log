+def _launch_dirs_for_corner(local_gap: tuple[int, int], dual_corner: bool) -> tuple[tuple[int, int], ...]:
+    if dual_corner:
+        return _CORNER_TO_FAN_DIRS[local_gap]
+    return (_CORNER_TO_SINGLE_DIR[local_gap],)
