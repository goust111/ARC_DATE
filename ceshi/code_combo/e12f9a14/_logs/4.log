   155	def _normalize_dir(dr: int, dc: int) -> tuple[int, int]:
   156	    if dr == 0 and dc == 0:
   157	        return (0, 0)
   158	    if dr != 0 and dc != 0:
   159	        return (int(np.sign(dr)), int(np.sign(dc)))
   160	    if dr != 0:
   161	        return (int(np.sign(dr)), 0)
   162	    return (0, int(np.sign(dc)))
   163	
   164	
   165	def _gap_dir(gap: tuple[int, int]) -> tuple[int, int]:
   166	    gr, gc = gap
   167	    dr = -1 if gr == 0 else (1 if gr == 3 else 0)
   168	    dc = -1 if gc == 0 else (1 if gc == 3 else 0)
   169	    return dr, dc
