   105	def _frame_gaps_for_block(g: np.ndarray, bg: int, wall: int, br: int, bc: int) -> list[tuple[int, int]]:
   106	    h, w = g.shape
   107	    fr0, fc0 = br - 1, bc - 1
   108	    fr1, fc1 = br + 2, bc + 2
   109	    gaps: list[tuple[int, int]] = []
   110	    for r in range(fr0, fr1 + 1):
   111	        for c in range(fc0, fc1 + 1):
   112	            if not (0 <= r < h and 0 <= c < w):
   113	                continue
   114	            if not (r in (fr0, fr1) or c in (fc0, fc1)):
   115	                continue
   116	            if int(g[r, c]) == bg:
   117	                gaps.append((r, c))
   118	    out: list[tuple[int, int]] = []
   119	    for r, c in gaps:
   120	        dr = -1 if r == fr0 else (1 if r == fr1 else 0)
   121	        dc = -1 if c == fc0 else (1 if c == fc1 else 0)
   122	        assert dr != 0 or dc != 0, "expected candidate gap on frame border"
   123	        ok = True
   124	        if dr == 0:
   125	            ok = (
   126	                0 <= r - 1 < h
   127	                and 0 <= r + 1 < h
   128	                and int(g[r - 1, c]) == wall
   129	                and int(g[r + 1, c]) == wall
   130	            )
   131	        elif dc == 0:
   132	            ok = (
   133	                0 <= c - 1 < w
   134	                and 0 <= c + 1 < w
   135	                and int(g[r, c - 1]) == wall
   136	                and int(g[r, c + 1]) == wall
   137	            )
   138	        else:
   139	            ok = (
   140	                0 <= r - dr < h
   141	                and 0 <= c < w
   142	                and 0 <= r < h
   143	                and 0 <= c - dc < w
   144	                and int(g[r - dr, c]) == wall
   145	                and int(g[r, c - dc]) == wall
   146	            )
   147	        if ok:
   148	            out.append((r, c))
   149	    out_set = set(out)
   150	    if len(out_set) >= 3 and (fr1, fc1) in out_set and (fr0, bc + 1) in out_set:
   151	        out = [p for p in out if p != (fr1, fc1)]
   152	    return out
