   469	def _choose_positions(n: int, count: int, rng: np.random.Generator) -> list[tuple[int, int]] | None:
   470	    margin = PLACEMENT_MARGIN
   471	    all_positions = [(r, c) for r in range(margin, n - 5) for c in range(margin, n - 5)]
   472	    selected: list[tuple[int, int]] = []
   473	    for _ in range(count):
   474	        viable = [p for p in all_positions if all(_frames_separated(p, q) for q in selected)]
   475	        if not viable:
   476	            return None
   477	        selected.append(viable[int(rng.integers(len(viable)))])
   478	    return selected
