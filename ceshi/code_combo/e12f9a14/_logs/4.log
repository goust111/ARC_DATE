   183	        self.active = True
   184	        self.swap_count = 0
   185	
   186	
   187	def _simulate(
   188	    grid: np.ndarray,
   189	    *,
   190	    strict_same_cell: bool,
   191	    collect_stats: bool,
   192	) -> tuple[np.ndarray | None, dict[str, int]]:
   193	    g = np.asarray(grid, dtype=int)
   194	    h, w = g.shape
   195	    bg = get_bg(g)
   196	
   197	    out = g.copy()
   198	    blocks = _find_blocks_2x2(g, bg)
   199	    assert blocks, "expected at least one 2x2 block in input"
   200	
   201	    beams: dict[int, _Beam] = {}
   202	    next_bid = 0
   203	
   204	    cell_owner: dict[tuple[int, int], int] = {}
   205	    cell_enter: dict[tuple[int, int], tuple[int, int]] = {}
   206	    cell_index: dict[tuple[int, int], int] = {}
   207	    ever_changed: set[int] = set()
   208	
   209	    stats = {
   210	        "beam_count": 0,
   211	        "swap_events": 0,
   212	        "visible_swap_events": 0,
   213	        "cross_swaps": 0,
   214	        "segment_swaps": 0,
   215	        "same_cell_collisions": 0,
   216	        "foreign_color_cells": 0,
