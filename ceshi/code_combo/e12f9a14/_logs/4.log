+        return 0 <= r < h and 0 <= c < w
+
+    def segment_owner_after_cross(p: tuple[int, int], q: tuple[int, int]) -> tuple[int, int] | None:
+        dr, dc = q[0] - p[0], q[1] - p[1]
+        if abs(dr) != 1 or abs(dc) != 1:
+            return None
