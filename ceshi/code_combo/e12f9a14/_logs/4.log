    73	def _find_blocks_2x2(g: np.ndarray, bg: int) -> list[tuple[int, int, int]]:
    74	    h, w = g.shape
    75	    blocks: list[tuple[int, int, int]] = []
    76	    for r in range(h - 1):
    77	        for c in range(w - 1):
    78	            v = int(g[r, c])
    79	            if v == bg:
    80	                continue
    81	            if int(g[r, c + 1]) == v and int(g[r + 1, c]) == v and int(g[r + 1, c + 1]) == v:
    82	                blocks.append((v, r, c))
    83	    return blocks
