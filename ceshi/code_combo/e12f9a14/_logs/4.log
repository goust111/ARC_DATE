+        patch[gr, gc] = bg
+    paste(grid, patch, r0, c0)
+
+
+def _rays_clear(
+    grid: np.ndarray,
+    bg: int,
+    seeds: list[tuple[tuple[int, int], tuple[int, int]]],
+) -> bool:
+    h, w = grid.shape
+    for (r, c), (dr, dc) in seeds:
+        steps = 0
+        nr, nc = r + dr, c + dc
+        while 0 <= nr < h and 0 <= nc < w:
+            steps += 1
+            if int(grid[nr, nc]) != bg:
+                return False
+            nr += dr
+            nc += dc
+        if steps < MIN_RAY_STEPS:
