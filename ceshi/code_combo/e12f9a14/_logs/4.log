   418	def main(grid: np.ndarray) -> np.ndarray:
   419	    """
   420	    Emit diagonal beams from framed 2x2 blocks; crossings preserve geometry and only transfer color.
   421	
   422	    Input structure:
   423	    - The most common color is the background, and each monochrome 2x2 block sits inside the same 4x4 frame color.
   424	    - Each legal frame has exactly one structural corner gap, so every emitted beam starts on a frame corner and moves diagonally outward.
   425	
   426	    Rule:
   427	    - Every corner gap launches one diagonal beam using its block's color, and the beam keeps that diagonal direction until it leaves the grid.
   428	    - When two moving beams cross, they pass through the crossing square without turning and exchange colors; each continuation paints with the newly inherited color.
   429	    - When a moving beam later crosses an already-painted diagonal segment, the moving beam inherits that segment's current color and the older segment is recolored from the crossing onward with the moving beam's previous color.
   430	
   431	    Key insight: Collision geometry is completely inert in this combo; solving the task means following a chain of color hand-offs across successive diagonal crossings, including recoloring of older suffixes.
   432	    """
   433	    out, _stats = _simulate(np.asarray(grid, dtype=int), strict_same_cell=True, collect_stats=False)
   434	    assert out is not None, "expected a concrete output grid"
   435	    return out
