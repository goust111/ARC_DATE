    86	def _infer_frame_color(g: np.ndarray, bg: int, br: int, bc: int, block_col: int) -> int:
    87	    h, w = g.shape
    88	    fr0, fc0 = br - 1, bc - 1
    89	    fr1, fc1 = br + 2, bc + 2
    90	    vals: list[int] = []
    91	    for r in range(fr0, fr1 + 1):
    92	        for c in range(fc0, fc1 + 1):
    93	            if not (0 <= r < h and 0 <= c < w):
    94	                continue
    95	            if not (r in (fr0, fr1) or c in (fc0, fc1)):
    96	                continue
    97	            v = int(g[r, c])
    98	            if v != bg and v != block_col:
    99	                vals.append(v)
   100	    frame_colors = sorted(set(vals))
   101	    assert len(frame_colors) == 1, "expected a unique frame color around each 2x2 block"
   102	    return frame_colors[0]
