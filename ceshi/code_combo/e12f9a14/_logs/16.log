+
+    max_iters = h * w * 200
+    for _ in range(max_iters):
+        active = [bid for bid, b in beams.items() if b.active]
+        if not active:
+            break
+
+        prop: dict[int, tuple[tuple[int, int], tuple[int, int]]] = {}
+        for bid in active:
+            b = beams[bid]
+            d = b.next_dir()
