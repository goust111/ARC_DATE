+# --------------- generator (o5x) ---------------
+
+GRID_SIZE_RANGE = (33, 35)
+BG = 0
+FRAME_COLOR = 8
+BLOCK_COLORS = [1, 2, 3, 7, 9]
+GEN_RETRIES = 200
+
+BASE_LAYOUT = [
+    ((13, 10), ((1, 3),)),
+    ((8, 20), ((3, 1),)),
+    ((22, 16), ((1, 3), (2, 0))),
+    ((16, 16), ((3, 3),)),
+    ((22, 9), ((2, 3),)),
