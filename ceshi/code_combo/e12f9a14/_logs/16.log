+            cb = prop[b][0]
+            events.append((1, min(ca[0], cb[0]), min(ca[1], cb[1]), a, b, "cross"))
+        for a, b in seg_cross:
+            pr, pc = beams[a].pos
+            dr, dc = prop[a][1]
+            events.append((1, min(pr, pr + dr), min(pc, pc + dc), a, b, "segcross"))
+
+        if events:
