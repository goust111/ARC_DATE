+                bu.path.append(cell)
+                bu.enter_dirs.append(u)
+                bu.pos = cell
+                paint_cell(bid_u, cell, u)
+        else:
+            idx = cell_index[cell]
+            if idx + 1 < len(beams[bid_u].path):
