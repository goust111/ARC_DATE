+_SLOT_90_IN = (1, 1)
+_SLOT_90_OUT = (1, 5)
+_SLOT_45_IN = (5, 1)
+_SLOT_45_OUT = (5, 5)
+_SLOT_180_IN = (9, 1)
+_SLOT_180_OUT = (9, 5)
