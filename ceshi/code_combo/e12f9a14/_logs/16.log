+        stats["cell_45"] += 1
+        is_card_a = abs(da[0]) + abs(da[1]) == 1
+        is_card_b = abs(db[0]) + abs(db[1]) == 1
+        assert is_card_a != is_card_b, "45-degree collision must involve exactly one cardinal and one diagonal beam"
