+
+def _draw_framed_block(
+    grid: np.ndarray,
+    r0: int,
+    c0: int,
+    bg: int,
+    frame_color: int,
+    block_color: int,
+    gaps: tuple[tuple[int, int], ...],
+) -> None:
+    patch = np.full((4, 4), frame_color, dtype=int)
+    patch[1:3, 1:3] = block_color
+    for gr, gc in gaps:
+        patch[gr, gc] = bg
+    paste(grid, patch, r0, c0)
+
