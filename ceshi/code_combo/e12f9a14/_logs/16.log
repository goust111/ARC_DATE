+        swap_pairs: set[tuple[int, int]] = set()
+        for a, (nxt_a, da) in prop.items():
+            oa = cell_owner.get(nxt_a)
+            if oa is None or oa == a or oa not in prop:
+                continue
+            nxt_b, db = prop[oa]
+            if nxt_b != beams[a].pos:
