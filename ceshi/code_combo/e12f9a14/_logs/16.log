+
+    if stats["cell_45"] != 1 or stats["cell_90"] != 1 or stats["head_on_180"] != 1:
+        return None
+    if stats["cross"] != 0 or stats["segcross"] != 0:
+        return None
+    if np.count_nonzero(out != grid) < 25:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
