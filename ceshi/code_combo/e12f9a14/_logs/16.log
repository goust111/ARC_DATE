+            dr, dc = prop[a][1]
+            events.append((1, min(pr, pr + dr), min(pc, pc + dc), a, b, "segcross"))
+
+        if events:
+            events.sort()
+            _, r, c, a, b, kind = events[0]
+            if kind == "swap":
+                resolve_swap_head_on(a, b)
+            elif kind == "cell":
+                resolve_cell_collision((r, c), a, b, prop)
+            elif kind == "segcross":
