                    cond = stats['collision_events']>=2 and stats['cell_collisions']>=1 and (stats['cross_collisions']+stats['segment_cross_collisions'])>=1 and len(stats['colliding_beams'])==4
                    ok += int(cond)
    print(left,right,ok,'/',total)
