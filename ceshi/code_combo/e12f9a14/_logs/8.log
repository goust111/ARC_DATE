    (((0,3),(3,3)), ((0,0),(3,2))),
    (((0,3),(3,3)), ((0,1),(3,0))),
    (((0,2),(3,3)), ((0,0),(3,1))),
    (((0,2),(3,3)), ((0,0),(3,2))),
    (((0,3),(3,2)), ((0,0),(3,0))),
]
