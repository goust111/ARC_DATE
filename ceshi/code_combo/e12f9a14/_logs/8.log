/bin/bash -lc "python - <<'PY'
import importlib.util, numpy as np, itertools
spec=importlib.util.spec_from_file_location('variant','/home/lixinyu/snap/new/ceshi/code_combo/e12f9a14/8/code.py')
mod=importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)

BORDER=((0,0),(0,1),(0,2),(0,3),(1,3),(2,3),(3,3),(3,2),(3,1),(3,0),(2,0),(1,0))
IDX={p:i for i,p in enumerate(BORDER)}

def valid_combos():
    out=[]
    for a,b in itertools.combinations(BORDER,2):
        ia,ib=IDX[a],IDX[b]
        d=(ib-ia)%12
        if d in (1,11):
            continue
        out.append((a,b))
    return out

combos=valid_combos()
print('valid combos', len(combos))

def draw(n, left, right, r=6, c=2, sep=8, bg=8, frame=3):
    g=np.full((n,n), bg, dtype=int)
    mod._draw_framed_block(g,r,c,bg,frame,4,left)
    mod._draw_framed_block(g,r,c+sep,bg,frame,6,right)
    return g

best=[]
for left,right in itertools.product(combos, repeat=2):
    g=draw(20,left,right)
    try:
        out, stats = mod._simulate(g, collect_stats=True)
    except Exception:
        continue
    score=(int(stats['collision_events']), int(stats['cell_collisions']) + int(stats['cross_collisions']) + int(stats['segment_cross_collisions']), int(stats['painted_pixels']))
    if stats['collision_events']>=2 and len(stats['colliding_beams'])==4:
        best.append((score,left,right,stats))
best.sort(reverse=True)
print('candidates', len(best))
for item in best[:40]:
    print(item)
