GRID_SIZE_RANGE = (18, 27)
GEN_RETRIES = 400
BG_CHOICES = [0, 8]
BG_WEIGHTS = [0.25, 0.75]
FRAME_COLOR_FOR_BG = {8: 3, 0: 8}
PALETTE_FOR_BG = {
    8: [1, 2, 4, 6, 7, 9],
    0: [1, 2, 3, 4, 6, 7, 9],
}
FRAME_SEPARATIONS = (8, 10, 12)
MIN_PAINTED_PIXELS = 14
MIN_COLLISION_EVENTS = 2
MIN_DISTINCT_COLLISION_SITES = 2

_BASE_LAYOUTS = (
    {
        "name": "downward",
        "row_mode": "upper",
        "left_gaps": ((1, 3), (3, 3)),
        "right_gaps": ((3, 0), (3, 2)),
    },
    {
        "name": "upward",
        "row_mode": "lower",
        "left_gaps": ((0, 3), (2, 3)),
        "right_gaps": ((0, 0), (0, 2)),
    },
)


def _pick_colors(rng: np.random.Generator) -> tuple[int, int, list[int]]:
    bg = int(rng.choice(BG_CHOICES, p=BG_WEIGHTS))
    frame_color = FRAME_COLOR_FOR_BG[bg]
    palette = [c for c in PALETTE_FOR_BG[bg] if c != frame_color]
    block_colors = list(rng.choice(palette, size=2, replace=False))
    return bg, frame_color, block_colors


def _draw_framed_block(
    grid: np.ndarray,
    r0: int,
    c0: int,
    bg: int,
    frame_color: int,
    block_color: int,
    gaps: tuple[tuple[int, int], tuple[int, int]],
) -> None:
    patch = np.full((4, 4), frame_color, dtype=int)
    patch[1:3, 1:3] = block_color
    for gr, gc in gaps:
        patch[gr, gc] = bg
    paste(grid, patch, r0, c0)


def _row_choices(n: int, row_mode: str) -> list[int]:
    if row_mode == "upper":
        lo, hi = 2, max(2, n // 2 - 2)
    elif row_mode == "lower":
        lo, hi = max(2, n // 2), n - 5
    else:
        lo, hi = 3, n - 6
    if lo > hi:
        return []
    return list(range(lo, hi + 1))


def _gen_attempt() -> np.ndarray | None:
    rng = np.random.default_rng()
    n = int(rng.integers(*GRID_SIZE_RANGE))
    bg, frame_color, block_colors = _pick_colors(rng)
    layout = _BASE_LAYOUTS[int(rng.integers(len(_BASE_LAYOUTS)))]

    valid_seps = [sep for sep in FRAME_SEPARATIONS if sep <= n - 8]
    if not valid_seps:
        return None
    sep = int(rng.choice(valid_seps))

    rows = _row_choices(n, layout["row_mode"])
    if not rows:
        return None
    r0 = int(rng.choice(rows))

    c_min = 2
    c_max = n - sep - 6
    if c_max < c_min:
        return None
    c0 = int(rng.integers(c_min, c_max + 1))

    grid = np.full((n, n), bg, dtype=int)
    _draw_framed_block(grid, r0, c0, bg, frame_color, int(block_colors[0]), layout["left_gaps"])
    _draw_framed_block(grid, r0, c0 + sep, bg, frame_color, int(block_colors[1]), layout["right_gaps"])

    rot_k = int(rng.integers(4))
    if rot_k:
        grid = np.rot90(grid, rot_k).copy()

