+    used_prefix: set[tuple[int, int]] = set()
+    used_obstacles: list[tuple[int, int]] = []
+
+    def dfs(k: int) -> bool:
+        if k == len(order):
+            return True
+        idx = order[k]
+        for opt in shuffled[idx]:
