+    if not dfs(0):
+        return None
+    return [opt for opt in chosen if opt is not None]
+
+
+def _gen_attempt() -> np.ndarray | None:
+    rng = np.random.default_rng()
+
+    block_count = int(rng.integers(*BLOCK_COUNT_RANGE))
