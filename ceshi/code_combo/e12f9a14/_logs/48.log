        local_gaps = [(gr - r0, gc - c0) for gr, gc in gaps]
        dirs = [_gap_dir(local_gap) for local_gap in local_gaps]
        frames.append(
            {
                "color": int(color),
                "pos": (r0, c0),
                "gaps": gaps,
                "dirs": dirs,
