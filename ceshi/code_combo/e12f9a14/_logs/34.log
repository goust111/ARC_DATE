+        is_card_a = abs(da[0]) + abs(da[1]) == 1
+        is_card_b = abs(db[0]) + abs(db[1]) == 1
+        assert is_card_a != is_card_b, "45-degree collision must involve one cardinal and one diagonal beam"
+
+        if is_card_a:
+            u, v = da, db
+            bid_u, bid_v = a, b
+        else:
+            u, v = db, da
+            bid_u, bid_v = b, a
+
+        if cell_owner.get(cell) != bid_u:
