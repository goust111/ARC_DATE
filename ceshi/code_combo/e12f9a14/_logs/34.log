+
+BLOCK_COUNT_RANGE = (1, 6)
+GRID_SIZE_MAX = 31
+GRID_SIZE_MIN_BY_BLOCKS = {1: 8, 2: 14, 5: 20}
+BG_CHOICES = [0, 8]
+BG_WEIGHTS = [0.25, 0.75]
+FRAME_COLOR_FOR_BG = {8: 3, 0: 8}
