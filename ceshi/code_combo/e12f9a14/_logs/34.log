+        zig = (v, u)
+        beams[bid_u].pattern = zig
+        beams[bid_u].phase = 0
+        beams[bid_v].pattern = zig
+        beams[bid_v].phase = 0
+        beams[bid_u].active = True
+        beams[bid_v].active = True
+        reset_segment(bid_u)
+        reset_segment(bid_v)
+
+    def diag_segment_owner(p: tuple[int, int], q: tuple[int, int]) -> int | None:
+        dr, dc = q[0] - p[0], q[1] - p[1]
+        if abs(dr) != 1 or abs(dc) != 1:
