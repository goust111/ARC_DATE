+
+def _grid_size_min(block_count: int) -> int:
+    result = 8
+    for threshold, min_n in sorted(GRID_SIZE_MIN_BY_BLOCKS.items()):
+        if block_count >= threshold:
+            result = min_n
+    return result
+
