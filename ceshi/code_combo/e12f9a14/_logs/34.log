+def _gen_attempt() -> np.ndarray | None:
+    rng = np.random.default_rng()
+
+    block_count = int(rng.integers(*BLOCK_COUNT_RANGE))
+    n = int(rng.integers(_grid_size_min(block_count), GRID_SIZE_MAX))
+
