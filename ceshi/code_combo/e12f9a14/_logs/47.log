-# ----------------------------------
+# Design analysis for the combo variant
+# -------------------------------------
 # variant:
 #   core_change:
-#     from: each beam paints a solid trail in its source block color
-#     to: each beam follows a visible 4-step color cycle A A B B, where
-#       A = the inner 2x2 block color and B = the surrounding frame color.
+#     from:
+#       - the input had one uniform background color
+#       - each beam painted a single global AABB-style cycle in the D3 variant
+#     to:
+#       - the input is split into two large rectangular background regions
+#       - the beam keeps the original geometry, but its color cycle depends on
+#         the region it is currently traversing
 #   concrete_appearance:
 #     input:
-#       - Same 4x4 framed 2x2 sources as the original task.
-#       - The frame color is already visible next to the block color, so the two
-#         colors needed by the trail are present in the source object itself.
+#       - one straight full-grid partition line divides the board into two
