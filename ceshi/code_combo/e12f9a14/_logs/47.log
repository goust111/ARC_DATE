+    h, w = g.shape
+    sources: list[tuple[int, int, int, int, int, tuple[tuple[int, int], ...]]] = []
+    seen_centers: set[tuple[int, int]] = set()
 
+    for r0 in range(h - 3):
+        for c0 in range(w - 3):
+            window = g[r0:r0 + 4, c0:c0 + 4]
+            center = window[1:3, 1:3]
