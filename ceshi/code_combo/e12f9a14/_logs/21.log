+            card_dir, diag_dir = da, db
+        else:
+            winner, loser = b, a
+            card_dir, diag_dir = db, da
+        ensure_head_at_cell(winner, cell, card_dir)
+        beams[winner].reset_pattern((diag_dir, card_dir))
+        beams[loser].active = False
