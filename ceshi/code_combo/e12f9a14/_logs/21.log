+
+    def spawn_beam(color: int, pos: tuple[int, int], direction: tuple[int, int]) -> None:
+        nonlocal next_bid
+        assert int(out[pos[0], pos[1]]) == bg, "expected a frame-gap seed"
+        bid = next_bid
+        next_bid += 1
