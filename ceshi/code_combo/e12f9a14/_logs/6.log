+            blocked.add(cell)
+            unpaint_cell(cell)
+            nd = _normalize_dir(da[0] + db[0], da[1] + db[1])
+            for gid in lockstep_group(a, b):
+                beams[gid].pattern = (nd,)
+                beams[gid].phase = 0
+                beams[gid].active = True
