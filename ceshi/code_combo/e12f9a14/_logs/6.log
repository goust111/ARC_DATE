+    def lockstep_group(*bids: int) -> set[int]:
+        group = set(bids)
+        queue = list(bids)
+        while queue:
+            cur = queue.pop()
+            partner = find_partner(cur)
+            if partner is not None and partner not in group:
+                group.add(partner)
+                queue.append(partner)
+        return group
