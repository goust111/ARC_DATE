   409	def _launch_from_local_gap(r0: int, c0: int, gap: tuple[int, int]) -> tuple[tuple[int, int], tuple[int, int]]:
   410	    gr, gc = gap
   411	    direction = _gap_dir(gap)
   412	    if gr == 0:
   413	        start = (r0 - 1, c0 + gc)
   414	    elif gr == 3:
   415	        start = (r0 + 4, c0 + gc)
   416	    elif gc == 0:
   417	        start = (r0 + gr, c0 - 1)
   418	    else:
   419	        start = (r0 + gr, c0 + 4)
   420	    return start, direction
