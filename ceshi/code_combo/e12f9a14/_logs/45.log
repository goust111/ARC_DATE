   504	
   505	def _pick_colors(rng: np.random.Generator, block_count: int) -> tuple[int, int, list[int]]:
   506	    bg = int(rng.choice(BG_CHOICES, p=BG_WEIGHTS))
   507	    frame_color = FRAME_COLOR_FOR_BG[bg]
   508	    palette = [c for c in PALETTE_FOR_BG[bg] if c != frame_color]
   509	    block_colors = list(rng.choice(palette, size=block_count, replace=False))
   510	    return bg, frame_color, block_colors
   511	
   512	
   513	def _grid_size_min(block_count: int) -> int:
   514	    result = 12
   515	    for threshold, min_n in sorted(GRID_SIZE_MIN_BY_BLOCKS.items()):
   516	        if block_count >= threshold:
   517	            result = min_n
   518	    return result
