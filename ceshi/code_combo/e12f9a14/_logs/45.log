+
+    return {
+        "ray_count": len(rays),
+        "crossings": crossings,
+        "left_count": dir_counts["left"],
+        "right_count": dir_counts["right"],
+        "up_count": dir_counts["up"],
+        "down_count": dir_counts["down"],
+    }
+
+
+def _gen_attempt() -> np.ndarray | None:
+    rng = np.random.default_rng()
