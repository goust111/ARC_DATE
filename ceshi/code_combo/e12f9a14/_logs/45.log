    93	def _find_blocks_2x2(g: np.ndarray, bg: int) -> list[tuple[int, int, int]]:
    94	    h, w = g.shape
    95	    blocks: list[tuple[int, int, int]] = []
    96	    for r in range(h - 1):
    97	        for c in range(w - 1):
    98	            v = int(g[r, c])
    99	            if v == bg:
   100	                continue
   101	            if int(g[r, c + 1]) == v and int(g[r + 1, c]) == v and int(g[r + 1, c + 1]) == v:
   102	                blocks.append((v, r, c))
   103	    return blocks
   104	
   105	
   106	def _infer_frame_color(g: np.ndarray, bg: int, br: int, bc: int, block_col: int) -> int:
   107	    h, w = g.shape
   108	    fr0, fc0 = br - 1, bc - 1
   109	    fr1, fc1 = br + 2, bc + 2
   110	    vals: list[int] = []
   111	    for r in range(fr0, fr1 + 1):
   112	        for c in range(fc0, fc1 + 1):
   113	            if not (0 <= r < h and 0 <= c < w):
   114	                continue
   115	            if not (r in (fr0, fr1) or c in (fc0, fc1)):
   116	                continue
   117	            v = int(g[r, c])
   118	            if v != bg and v != block_col:
   119	                vals.append(v)
   120	    frame_colors = sorted(set(vals))
   121	    assert len(frame_colors) == 1, "expected a unique frame color around each 2x2 block"
   122	    return frame_colors[0]
   123	
   124	
   125	def _frame_gaps_for_block(g: np.ndarray, bg: int, wall: int, br: int, bc: int) -> list[tuple[int, int]]:
   126	    h, w = g.shape
   127	    fr0, fc0 = br - 1, bc - 1
   128	    fr1, fc1 = br + 2, bc + 2
   129	    gaps: list[tuple[int, int]] = []
   130	    for r in range(fr0, fr1 + 1):
   131	        for c in range(fc0, fc1 + 1):
   132	            if not (0 <= r < h and 0 <= c < w):
   133	                continue
   134	            if not (r in (fr0, fr1) or c in (fc0, fc1)):
   135	                continue
   136	            if int(g[r, c]) == bg:
   137	                gaps.append((r, c))
   138	
   139	    out: list[tuple[int, int]] = []
   140	    for r, c in gaps:
   141	        dr = -1 if r == fr0 else (1 if r == fr1 else 0)
   142	        dc = -1 if c == fc0 else (1 if c == fc1 else 0)
   143	        if dr == 0 and dc == 0:
   144	            continue
   145	        if dr != 0 and dc != 0:
   146	            continue
   147	        if dr == 0:
   148	            ok = (
   149	                0 <= r - 1 < h
   150	                and 0 <= r + 1 < h
   151	                and int(g[r - 1, c]) == wall
   152	                and int(g[r + 1, c]) == wall
   153	            )
   154	        else:
   155	            ok = (
   156	                0 <= c - 1 < w
   157	                and 0 <= c + 1 < w
   158	                and int(g[r, c - 1]) == wall
   159	                and int(g[r, c + 1]) == wall
   160	            )
   161	        if ok:
   162	            out.append((r, c))
   163	    return out
   164	
   165	
   166	def _orth_gap_dir_local(gap: tuple[int, int]) -> tuple[int, int]:
   167	    gr, gc = gap
   168	    if gr in (0, 3):
   169	        assert gc in (1, 2), "expected top/bottom side gap"
   170	        return (0, -1 if gc == 1 else 1)
   171	    assert gc in (0, 3) and gr in (1, 2), "expected left/right side gap"
   172	    return (-1 if gr == 1 else 1, 0)
   173	
   174	
   175	def _orth_gap_dir_for_block(br: int, bc: int, gr: int, gc: int) -> tuple[int, int] | None:
   176	    local = (gr - (br - 1), gc - (bc - 1))
   177	    if local not in _SIDE_GAPS:
   178	        return None
   179	    return _orth_gap_dir_local(local)
   180	
   181	
   182	def _launch_from_gap(br: int, bc: int, gr: int, gc: int) -> tuple[tuple[int, int], tuple[int, int]] | None:
   183	    local = (gr - (br - 1), gc - (bc - 1))
   184	    if local not in _SIDE_GAPS:
   185	        return None
   186	    direction = _orth_gap_dir_local(local)
   187	    if local[0] == 0:
   188	        start = (gr - 1, gc)
   189	    elif local[0] == 3:
   190	        start = (gr + 1, gc)
   191	    elif local[1] == 0:
   192	        start = (gr, gc - 1)
   193	    else:
   194	        start = (gr, gc + 1)
   195	    return start, direction
