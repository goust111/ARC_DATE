+# --------------- generator (o5x) ---------------
+
+BLOCK_COUNT_RANGE = (3, 6)
+GRID_SIZE_MAX = 31
+GRID_SIZE_MIN_BY_BLOCKS = {3: 14, 5: 20}
+BG_CHOICES = [0, 8]
+BG_WEIGHTS = [0.25, 0.75]
+FRAME_COLOR_FOR_BG = {8: 3, 0: 8}
+PALETTE_FOR_BG = {
+    8: [1, 2, 4, 6, 7, 9],
+    0: [1, 2, 3, 4, 6, 7, 9],
+}
+FRAME_BBOX_GAP = 2
+PLACEMENT_MARGIN = 2
+MIN_RAY_STEPS = 3
+MIN_BEAM_PIXELS_PER_GAP = 4
+MIN_REQUIRED_CROSSINGS = 1
+GEN_RETRIES = 600
+GAP_PICK_RETRIES = 320
