   392	def _gap_combos(size: int) -> list[tuple[tuple[int, int], ...]]:
   393	    combos = []
   394	    for combo in itertools.combinations(_SIDE_GAPS, size):
   395	        idxs = sorted(_BORDER_INDEX[p] for p in combo)
   396	        if any((idxs[(i + 1) % size] - idxs[i]) % 12 == 1 for i in range(size)):
   397	            continue
   398	        combos.append(combo)
   399	    return combos
   400	
   401	
   402	_GAP_COMBOS = {n: _gap_combos(n) for n in range(1, 5)}
