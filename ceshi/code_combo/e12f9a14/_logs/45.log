+                if seed[0] in rows_h:
+                    return None
+                rows_h.add(seed[0])
+            elif direction == (0, 1):
+                dir_counts["right"] += 1
+                if seed[0] in rows_h:
+                    return None
+                rows_h.add(seed[0])
+            elif direction == (-1, 0):
+                dir_counts["up"] += 1
+                if seed[1] in cols_v:
+                    return None
+                cols_v.add(seed[1])
+            else:
+                dir_counts["down"] += 1
+                if seed[1] in cols_v:
+                    return None
+                cols_v.add(seed[1])
+            rays.append(
+                {
+                    "seed": seed,
+                    "dir": direction,
+                    "cells": cells,
+                    "set": set(cells),
