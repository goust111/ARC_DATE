   373	BLOCK_COUNT_RANGE = (3, 6)
   374	GRID_SIZE_MAX = 31
   375	GRID_SIZE_MIN_BY_BLOCKS = {3: 14, 5: 20}
   376	BG_CHOICES = [0, 8]
   377	BG_WEIGHTS = [0.25, 0.75]
   378	FRAME_COLOR_FOR_BG = {8: 3, 0: 8}
   379	PALETTE_FOR_BG = {
   380	    8: [1, 2, 4, 6, 7, 9],
   381	    0: [1, 2, 3, 4, 6, 7, 9],
   382	}
   383	FRAME_BBOX_GAP = 2
   384	PLACEMENT_MARGIN = 2
   385	MIN_RAY_STEPS = 3
   386	MIN_BEAM_PIXELS_PER_GAP = 4
   387	MIN_REQUIRED_CROSSINGS = 1
   388	GEN_RETRIES = 600
   389	GAP_PICK_RETRIES = 320
