   496	                ray = _ray_cells(obstacles, bg, start, direction)
   497	                if ray is None or len(ray) - 1 < MIN_RAY_STEPS:
   498	                    ok = False
   499	                    break
   500	            if ok:
   501	                clear.setdefault(gap_count, []).append(combo)
   502	    return clear
