   481	def _clear_gap_combos(
   482	    obstacles: np.ndarray,
   483	    bg: int,
   484	    r0: int,
   485	    c0: int,
   486	) -> dict[int, list[tuple[tuple[int, int], ...]]]:
   487	    clear: dict[int, list[tuple[tuple[int, int], ...]]] = {}
   488	    for gap_count, combos in _GAP_COMBOS.items():
