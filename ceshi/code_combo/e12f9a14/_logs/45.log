   432	def _choose_positions(n: int, count: int, rng: np.random.Generator) -> list[tuple[int, int]] | None:
   433	    margin = PLACEMENT_MARGIN
   434	    all_positions = [(r, c) for r in range(margin, n - 5) for c in range(margin, n - 5)]
   435	    selected: list[tuple[int, int]] = []
   436	    for _ in range(count):
   437	        viable = [p for p in all_positions if all(_frames_separated(p, q) for q in selected)]
   438	        if not viable:
   439	            return None
   440	        selected.append(viable[int(rng.integers(len(viable)))])
   441	    return selected
