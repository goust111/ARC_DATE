   213	def _collect_beam_specs(g: np.ndarray) -> tuple[int, list[tuple[int, tuple[int, int], tuple[int, int]]]]:
   214	    bg = get_bg(g)
   215	    specs: list[tuple[int, tuple[int, int], tuple[int, int]]] = []
