   423	def _frames_separated(a: tuple[int, int], b: tuple[int, int]) -> bool:
   424	    ar0, ac0 = a
   425	    br0, bc0 = b
   426	    ar1, ac1 = ar0 + 3, ac0 + 3
   427	    br1, bc1 = br0 + 3, bc0 + 3
   428	    gap = FRAME_BBOX_GAP
   429	    return ar1 + gap < br0 or br1 + gap < ar0 or ac1 + gap < bc0 or bc1 + gap < ac0
