+            return None
+
+    bg, frame_color, block_colors = _pick_colors(rng)
+    grid = np.full((n, n), bg, dtype=int)
+    for (r0, c0), color, gap in zip(top_lefts, block_colors, (g1, g2)):
+        _draw_framed_block(grid, r0, c0, bg, frame_color, int(color), gap)
