+            a, b = sorted((bid, obid))
+            cross_pairs.add((a, b))
+
+        seg_cross: set[tuple[int, int]] = set()
+        for bid, (_nxt, d) in prop.items():
+            if abs(d[0]) + abs(d[1]) != 2:
+                continue
+            pr, pc = beams[bid].pos
+            dr, dc = d
+            p2 = (pr, pc + dc)
+            n2 = (pr + dr, pc)
+            obid = diag_segment_owner(p2, n2)
