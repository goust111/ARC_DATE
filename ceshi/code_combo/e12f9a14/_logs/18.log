+        dc = -1 if c == fc0 else (1 if c == fc1 else 0)
+        assert dr != 0 or dc != 0, "gap must lie on the border"
+        if dr == 0:
+            ok = (
+                0 <= r - 1 < h
+                and 0 <= r + 1 < h
+                and int(g[r - 1, c]) == wall
+                and int(g[r + 1, c]) == wall
+            )
+        elif dc == 0:
