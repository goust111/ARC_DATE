+    g2 = _gap_for_dir(rng, d2)
+    t1 = int(rng.integers(MIN_TO_COLLISION, MAX_TO_COLLISION + 1))
+    t2 = int(rng.integers(MIN_TO_COLLISION, MAX_TO_COLLISION + 1))
+    collision = (
+        int(rng.integers(4, n - 4)),
+        int(rng.integers(4, n - 4)),
