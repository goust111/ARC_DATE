+    r0, c0 = top_left
+    return PLACEMENT_MARGIN <= r0 and PLACEMENT_MARGIN <= c0 and r0 + 3 < n - PLACEMENT_MARGIN and c0 + 3 < n - PLACEMENT_MARGIN
+
