+_SIDE_GAPS = {
+    (-1, 0): [(0, 1), (0, 2)],
+    (0, 1): [(1, 3), (2, 3)],
+    (1, 0): [(3, 1), (3, 2)],
+    (0, -1): [(1, 0), (2, 0)],
