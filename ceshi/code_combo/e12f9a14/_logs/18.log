+PLACEMENT_MARGIN = 2
+FRAME_GAP_CLEARANCE = 1
+MIN_TO_COLLISION = 3
+MAX_TO_COLLISION = 8
+MIN_CHANGED_PIXELS = 12
+MIN_COLLISION_EFFECT = 4
+GEN_RETRIES = 400
