   100	def _find_blocks_2x2(g: np.ndarray, bg: int) -> list[tuple[int, int, int]]:
   101	    h, w = g.shape
   102	    blocks: list[tuple[int, int, int]] = []
   103	    for r in range(h - 1):
   104	        for c in range(w - 1):
   105	            v = int(g[r, c])
   106	            if v == bg:
   107	                continue
   108	            if int(g[r, c + 1]) == v and int(g[r + 1, c]) == v and int(g[r + 1, c + 1]) == v:
   109	                blocks.append((v, r, c))
   110	    return blocks
