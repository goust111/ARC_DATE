+    if np.count_nonzero(out != grid) < MIN_CHANGED_PIXELS:
+        return None
+    straight = _straight_output(grid)
+    if np.count_nonzero(out != straight) < MIN_COLLISION_EFFECT:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
