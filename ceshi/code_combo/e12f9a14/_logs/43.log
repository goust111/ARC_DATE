+def _find_blocks(g: np.ndarray, bg: int, frame_color: int) -> list[tuple[int, int, int, int]]:
+    h, w = g.shape
+    seen: set[tuple[int, int]] = set()
+    blocks: list[tuple[int, int, int, int]] = []
+    for r in range(h):
+        for c in range(w):
+            if (r, c) in seen:
+                continue
+            v = int(g[r, c])
