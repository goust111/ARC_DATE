+            assert size in BLOCK_SIZE_VALUES, "expected allowed block size"
+            assert len(cells) == size * size, "expected filled square block"
+            assert np.all(g[r0 : r1 + 1, c0 : c1 + 1] == v), "expected solid block"
+            blocks.append((v, r0, c0, size))
