+# Combo variant of e12f9a14 (index 43)
+# combo_spec: D4/2+D7/2
+# Name: 可变大小色块+可变大小框架
+
+import itertools
+from collections import Counter
+from functools import lru_cache
+
+import numpy as np
+
+from arc_utils import get_bg, paste
