+    n = int(rng.integers(_grid_size_min(block_count), GRID_SIZE_MAX))
+
+    bg, frame_color, block_colors = _pick_colors(rng, block_count)
+    positions = _choose_positions(n, specs, rng)
+    if positions is None:
