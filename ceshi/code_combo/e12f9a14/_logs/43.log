+
+
+def _gen_attempt() -> np.ndarray | None:
+    rng = np.random.default_rng()
+
+    block_count = int(rng.integers(*BLOCK_COUNT_RANGE))
+    specs = _pick_object_specs(block_count, rng)
+    if not _combo_evidence(specs):
