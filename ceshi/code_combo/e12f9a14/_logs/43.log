+    if int(np.bincount(grid.ravel(), minlength=10).argmax()) != bg:
+        return None
+
+    try:
+        out = main(grid)
+    except Exception:
+        return None
+
+    if np.count_nonzero(out != grid) < gap_total * MIN_BEAM_PIXELS_PER_GAP:
+        return None
+    if not _render_overlap_free(grid, out, bg):
+        return None
+    return grid
