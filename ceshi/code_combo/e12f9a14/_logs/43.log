+# --------------- generator ---------------
+
+BLOCK_COUNT_RANGE = (3, 6)
+GRID_SIZE_MAX = 31
+GRID_SIZE_MIN_BY_BLOCKS = {3: 18, 4: 22, 5: 25}
+BG_CHOICES = [0, 8]
+BG_WEIGHTS = [0.25, 0.75]
+FRAME_COLOR_FOR_BG = {8: 3, 0: 8}
+PALETTE_FOR_BG = {
+    8: [1, 2, 4, 6, 7, 9],
+    0: [1, 2, 3, 4, 6, 7, 9],
+}
+FRAME_BBOX_GAP = 3
+PLACEMENT_MARGIN = 3
+MIN_RAY_STEPS = 3
+RAY_HEADROOM = 1
+MIN_BEAM_PIXELS_PER_GAP = 3
+GEN_RETRIES = 500
