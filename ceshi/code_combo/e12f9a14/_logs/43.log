+            continue
+        exp_br = fr0 + 1 + offset
+        exp_bc = fc0 + 1 + offset
+        if (exp_br, exp_bc) != (br, bc):
+            continue
+        ok = True
+        for r in range(fr0, fr1 + 1):
+            for c in range(fc0, fc1 + 1):
+                v = int(g[r, c])
+                on_border = r in (fr0, fr1) or c in (fc0, fc1)
+                in_block = exp_br <= r < exp_br + block_size and exp_bc <= c < exp_bc + block_size
+                if in_block:
+                    if v != color:
