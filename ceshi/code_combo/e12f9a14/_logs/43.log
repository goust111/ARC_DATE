+                cells.append((cr, cc))
+                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if (nr, nc) in seen or int(g[nr, nc]) != v:
+                        continue
+                    seen.add((nr, nc))
+                    stack.append((nr, nc))
