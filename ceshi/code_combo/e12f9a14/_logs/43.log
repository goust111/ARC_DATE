+
+    chosen_gaps: list[tuple[tuple[int, int], ...]] = []
+    for (r0, c0), (_block_size, frame_size) in zip(positions, specs):
+        valid = _valid_single_gap_positions(obstacles, bg, r0, c0, frame_size)
