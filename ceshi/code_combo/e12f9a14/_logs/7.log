+                0 <= c - 1 < w
+                and 0 <= c + 1 < w
+                and int(g[r, c - 1]) == wall
+                and int(g[r, c + 1]) == wall
+            )
+        else:
+            ok = (
+                0 <= r - 1 < h
+                and 0 <= r + 1 < h
+                and int(g[r - 1, c]) == wall
+                and int(g[r + 1, c]) == wall
