+    if lr == 0:
+        return color, (-1, -1 if ic == 0 else 1)
+    if lr == 3:
+        return color, (1, -1 if ic == 0 else 1)
+    if lc == 0:
+        return color, (-1 if ir == 0 else 1, -1)
+    return color, (-1 if ir == 0 else 1, 1)
