+    ordered_pairs = [(a, b) for a in palette for b in palette if a != b]
+    idxs = rng.choice(len(ordered_pairs), size=block_count, replace=False)
+    inners = [_checker_inner(*ordered_pairs[int(i)]) for i in np.atleast_1d(idxs)]
