+    fr0, fc0 = br - 1, bc - 1
+    lr = gap[0] - fr0
+    lc = gap[1] - fc0
+    assert (lr, lc) in _SIDE_GAPS, "expected a side gap on the 4x4 frame"
+    ir = 0 if lr <= 1 else 1
+    ic = 0 if lc <= 1 else 1
