+
+    last_start = _add(tuple(placed[-1]["pos"]), last_tail)
+    last_tail_cells = _trace_to_edge(last_start, _gap_dir(last_tail), n)
+    if len(last_tail_cells) - 1 < MIN_TAIL_CELLS:
+        return None
