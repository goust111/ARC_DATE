+    start: tuple[int, int],
+    direction: tuple[int, int],
+    target: tuple[int, int],
+) -> bool:
+    h, w = g.shape
+    cur = start
+    while True:
+        nxt = (cur[0] + direction[0], cur[1] + direction[1])
+        if not (0 <= nxt[0] < h and 0 <= nxt[1] < w):
+            return False
+        owner = gap_lookup.get(nxt)
+        if owner is not None:
+            return nxt == target
+        if int(g[nxt[0], nxt[1]]) != bg:
