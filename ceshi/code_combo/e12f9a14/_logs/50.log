+
+    def insert_gap_after_turn(bids: tuple[int, int], out_dir: tuple[int, int], gap_len: int) -> int:
+        inserted = 0
+        for bid in bids:
+            b = beams[bid]
+            last = b.pos
+            for step in range(1, gap_len + 1):
+                cell = (b.pos[0] + out_dir[0] * step, b.pos[1] + out_dir[1] * step)
+                block_cell(cell)
+                last = cell
+                inserted += 1
+            b.pos = last
+            b.direction = out_dir
+            b.active = True
