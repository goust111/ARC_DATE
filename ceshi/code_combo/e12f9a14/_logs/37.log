+
+def _gap_dir(gap: tuple[int, int]) -> tuple[int, int]:
+    gr, gc = gap
+    dr = -1 if gr == 0 else (1 if gr == 3 else 0)
+    dc = -1 if gc == 0 else (1 if gc == 3 else 0)
+    return dr, dc
