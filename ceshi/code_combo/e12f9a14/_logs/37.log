+            dc = -1 if gc == bc - 1 else (1 if gc == bc + 2 else 0)
+            d = _normalize_dir(dr, dc)
+            assert d != (0, 0), "expected each frame gap to face outward"
+            spawn_beam(col, priority, (gr, gc), (d,))
