+        beams[a].phase = 0
+        beams[b].pattern = (u,)
+        beams[b].phase = 0
+        beams[a].active = True
+        beams[b].active = True
+
+    def resolve_cross_collision_priority(a: int, b: int, prop) -> None:
+        order = priority_order(a, b)
+        if order is None:
+            metrics["tie_collision_count"] += 1
