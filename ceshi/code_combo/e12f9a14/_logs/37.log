+    for col, br, bc in blocks:
+        frame_col, markers = _infer_frame_features(g, bg, br, bc, col)
+        del frame_col
+        priority = len(markers)
+        metrics["frame_priorities"].append(priority)
+        for gr, gc in _frame_gaps_for_block(g, bg, br, bc, col):
