+_BORDER_ORDER = (
+    (0, 0), (0, 1), (0, 2), (0, 3),
+    (1, 3), (2, 3), (3, 3), (3, 2),
+    (3, 1), (3, 0), (2, 0), (1, 0),
+)
+_BORDER_INDEX = {p: i for i, p in enumerate(_BORDER_ORDER)}
