+
+def _frames_separated(a: tuple[int, int], b: tuple[int, int]) -> bool:
+    ar0, ac0 = a
+    br0, bc0 = b
+    ar1, ac1 = ar0 + 3, ac0 + 3
+    br1, bc1 = br0 + 3, bc0 + 3
