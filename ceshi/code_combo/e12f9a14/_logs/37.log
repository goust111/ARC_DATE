   666	
   667	def main(grid: np.ndarray) -> np.ndarray:
   668	    """
   669	    Emit beams from framed color blocks, with border markers encoding which beam wins collisions.
   670	
   671	    Input structure:
   672	    - The background is the most common color. Each object is still a 2x2 monochrome block wrapped
   673	      by a 4x4 border frame.
   674	    - A frame border now uses two wall-like colors: one dominant frame color plus a smaller number
   675	      of marker pixels. Background-valued border cells are emission gaps.
   676	
   677	    Rule:
   678	    - Every gap emits a beam of the inner block's color in the outward direction implied by the gap.
   679	    - Count the marker pixels on that frame border to get the beam priority. When two beams collide,
   680	      the higher-priority beam keeps its current trajectory while the lower-priority beam alone
   681	      changes course. For 90-degree encounters the loser turns onto the bisector ray; for 45-degree
   682	      encounters the loser becomes a solo zigzag. If priorities tie, fall back to the original
   683	      symmetric behavior where both beams react together.
   684	
   685	    Key insight:
   686	    - The output is not determined by color ranking anymore. The crucial hidden variable is a visible
   687	      local count on each frame: more border markers means the ray has precedence, so only the
   688	      lower-count frame's ray bends at the meeting point.
   689	    """
   690	    return _simulate(grid, collect_metrics=False)
   691	
   692	
   693	# --------------- generator ---------------
   694	
   695	BLOCK_COUNT_RANGE = (2, 4)  # uniform draw [lo, hi): 2 or 3 blocks
   696	GRID_SIZE_MAX = 31
   697	GRID_SIZE_MIN = 18
   698	BG_CHOICES = [0, 8]
   699	BG_WEIGHTS = [0.25, 0.75]
   700	FRAME_COLOR_FOR_BG = {8: 3, 0: 8}
   701	PALETTE_FOR_BG = {
   702	    8: [1, 2, 4, 5, 6, 7, 9],
   703	    0: [1, 2, 3, 4, 5, 6, 7, 9],
   704	}
   705	FRAME_BBOX_GAP = 2
   706	MIN_BEAM_PIXELS_PER_GAP = 4
   707	GEN_RETRIES = 400
   708	PRIORITY_LEVELS = (1, 2, 3)
   709	
   710	
   711	def _gap_dir(gap: tuple[int, int]) -> tuple[int, int]:
   712	    gr, gc = gap
   713	    dr = -1 if gr == 0 else (1 if gr == 3 else 0)
   714	    dc = -1 if gc == 0 else (1 if gc == 3 else 0)
   715	    return dr, dc
   716	
   717	
   718	def _frames_separated(a: tuple[int, int], b: tuple[int, int]) -> bool:
   719	    ar0, ac0 = a
   720	    br0, bc0 = b
   721	    ar1, ac1 = ar0 + 3, ac0 + 3
   722	    br1, bc1 = br0 + 3, bc0 + 3
   723	    gap = FRAME_BBOX_GAP
   724	    return ar1 + gap < br0 or br1 + gap < ar0 or ac1 + gap < bc0 or bc1 + gap < ac0
   725	
   726	
   727	def _pick_colors(rng: np.random.Generator, block_count: int) -> tuple[int, int, int, list[int]]:
   728	    bg = int(rng.choice(BG_CHOICES, p=BG_WEIGHTS))
   729	    frame_color = FRAME_COLOR_FOR_BG[bg]
   730	    palette = [c for c in PALETTE_FOR_BG[bg] if c != frame_color]
   731	    block_colors = list(rng.choice(palette, size=block_count, replace=False))
   732	    remaining = [c for c in palette if c not in block_colors]
   733	    marker_color = int(rng.choice(remaining))
   734	    return bg, frame_color, marker_color, block_colors
   735	
   736	
   737	def _sample_markers(
   738	    gaps: tuple[tuple[int, int], ...],
   739	    count: int,
   740	    rng: np.random.Generator,
   741	) -> tuple[tuple[int, int], ...]:
   742	    candidates = [p for p in _BORDER_ORDER if p not in gaps]
   743	    picks = rng.choice(len(candidates), size=count, replace=False)
   744	    chosen = tuple(candidates[int(i)] for i in np.atleast_1d(picks))
   745	    return chosen
   746	
   747	
   748	def _draw_framed_block(
   749	    grid: np.ndarray,
   750	    r0: int,
   751	    c0: int,
   752	    bg: int,
   753	    frame_color: int,
   754	    marker_color: int,
   755	    block_color: int,
   756	    gaps: tuple[tuple[int, int], ...],
   757	    markers: tuple[tuple[int, int], ...],
   758	) -> None:
   759	    patch = np.full((4, 4), frame_color, dtype=int)
   760	    patch[1:3, 1:3] = block_color
   761	    for mr, mc in markers:
   762	        patch[mr, mc] = marker_color
   763	    for gr, gc in gaps:
   764	        patch[gr, gc] = bg
   765	    paste(grid, patch, r0, c0)
   766	
   767	
   768	def _rays_clear(grid: np.ndarray, bg: int, seeds: list[tuple[tuple[int, int], tuple[int, int]]]) -> bool:
   769	    h, w = grid.shape
   770	    for (r, c), (dr, dc) in seeds:
   771	        nr, nc = r + dr, c + dc
   772	        if not (0 <= nr < h and 0 <= nc < w):
   773	            return False
   774	        while 0 <= nr < h and 0 <= nc < w:
   775	            if int(grid[nr, nc]) != bg:
   776	                return False
   777	            nr += dr
   778	            nc += dc
   779	    return True
