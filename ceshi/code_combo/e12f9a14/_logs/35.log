-    def lockstep_group(seed_ids: set[int]) -> set[int]:
-        group = {bid for bid in seed_ids if bid in beams}
-        changed = True
-        while changed:
-            changed = False
-            for oid, ob in beams.items():
-                if oid in group or not ob.active:
-                    continue
-                if any(is_lockstep_adjacent(oid, gid) for gid in group):
-                    group.add(oid)
-                    changed = True
