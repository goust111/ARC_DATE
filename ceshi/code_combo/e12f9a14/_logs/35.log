-    blocks: list[tuple[int, int, int]] = []
-    for r in range(h - 1):
-        for c in range(w - 1):
-            v = int(g[r, c])
-            if v == bg:
-                continue
-            if int(g[r, c + 1]) == v and int(g[r + 1, c]) == v and int(g[r + 1, c + 1]) == v:
-                blocks.append((v, r, c))
-    return blocks
