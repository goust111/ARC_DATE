+def _transform_cell(cell: tuple[int, int], n: int, transform: str) -> tuple[int, int]:
+    r, c = cell
+    if transform == "id":
+        return cell
+    if transform == "flip_h":
+        return (r, n - 1 - c)
+    if transform == "flip_v":
+        return (n - 1 - r, c)
+    if transform == "flip_both":
+        return (n - 1 - r, n - 1 - c)
+    raise AssertionError(f"unknown transform {transform}")
