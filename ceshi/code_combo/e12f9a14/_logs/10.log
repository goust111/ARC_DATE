+def _transform_grid(grid: np.ndarray, transform: str) -> np.ndarray:
+    if transform == "id":
+        return grid
+    if transform == "flip_h":
+        return grid[:, ::-1]
+    if transform == "flip_v":
+        return grid[::-1, :]
+    if transform == "flip_both":
+        return grid[::-1, ::-1]
+    raise AssertionError(f"unknown transform {transform}")
