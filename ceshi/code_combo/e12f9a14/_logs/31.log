   456	def _choose_gap_combo(
   457	    blocks: list[tuple[int, int, int]],
   458	    candidate_lists: list[list[dict[str, object]]],
   459	    rng: np.random.Generator,
   460	) -> list[dict[str, object]] | None:
   461	    all_combos: list[tuple[int, list[dict[str, object]]]] = []
   462	    for combo in itertools.product(*candidate_lists):
   463	        paths = [entry["path"] for entry in combo]
   464	        ok = True
   465	        for i in range(len(paths)):
   466	            for j in range(i + 1, len(paths)):
   467	                if not _path_compatible(paths[i], paths[j]):
   468	                    ok = False
