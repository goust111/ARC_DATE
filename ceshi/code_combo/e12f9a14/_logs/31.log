   333	FRAME_COLOR_FOR_BG = {8: 3, 0: 8}
   334	PALETTE_FOR_BG = {
   335	    8: [1, 2, 4, 6, 7, 9],
   336	    0: [1, 2, 3, 4, 6, 7, 9],
   337	}
   338	FRAME_BBOX_GAP = 7
   339	PLACEMENT_MARGIN = 2
