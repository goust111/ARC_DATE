   372	def _choose_positions(n: int, count: int, rng: np.random.Generator) -> list[tuple[int, int]] | None:
   373	    all_positions = [
   374	        (r, c)
   375	        for r in range(PLACEMENT_MARGIN, n - 5)
   376	        for c in range(PLACEMENT_MARGIN, n - 5)
   377	    ]
   378	    rng.shuffle(all_positions)
   379	    selected: list[tuple[int, int]] = []
   380	    for p in all_positions:
   381	        if all(_frames_separated(p, q) for q in selected):
   382	            selected.append(p)
   383	            if len(selected) == count:
   384	                return sorted(selected)
   385	    return None
