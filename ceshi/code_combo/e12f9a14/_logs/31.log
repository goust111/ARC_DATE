   363	def _frames_separated(a: tuple[int, int], b: tuple[int, int]) -> bool:
   364	    ar0, ac0 = a
   365	    br0, bc0 = b
   366	    ar1, ac1 = ar0 + 3, ac0 + 3
   367	    br1, bc1 = br0 + 3, bc0 + 3
