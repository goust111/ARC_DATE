   355	def _pick_colors(rng: np.random.Generator, block_count: int) -> tuple[int, int, list[int]]:
   356	    bg = int(rng.choice(BG_CHOICES, p=BG_WEIGHTS))
   357	    frame_color = FRAME_COLOR_FOR_BG[bg]
   358	    palette = [c for c in PALETTE_FOR_BG[bg] if c != frame_color]
   359	    block_colors = list(rng.choice(palette, size=block_count, replace=False))
   360	    return bg, frame_color, block_colors
