   291	def main(grid: np.ndarray) -> np.ndarray:
   292	    """
   293	    Launch sparse colored spirals from framed 2x2 blocks through their side gaps.
   294	
   295	    Input structure:
   296	    - The background is the most common color.
   297	    - Each object is a monochrome 2x2 block inside a shared-color 4x4 frame.
   298	    - Generated instances use side gaps on the frame border as the spiral exits.
   299	
   300	    Rule:
   301	    - Each side gap paints its own cell, takes one step outward, then follows a clockwise
   302	      self-avoiding spiral in the surrounding background.
   303	    - The hidden spiral path is continuous, but the visible trail decays with distance:
   304	      an inner band paints every step, the next band every other step, then every third step,
   305	      and so on.
   306	    - Spirals stop when the next move would leave the grid, enter a non-background cell,
   307	      or touch an earlier cell of the same hidden path.
   308	
   309	    Key insight:
   310	    - The frame gap still determines where color escapes, but the output is no longer a straight
   311	      beam. The solver must infer a full square spiral first, then sparsify outer rings according
   312	      to distance from the source.
   313	    """
   314	    g = np.asarray(grid, dtype=int)
   315	    bg = get_bg(g)
   316	    out = g.copy()
   317	
   318	    for color, seed, out_dir in _collect_launches(g, bg):
   319	        path = _trace_spiral_path(g, bg, seed, out_dir)
   320	        for r, c in _painted_cells_from_path(path):
   321	            out[r, c] = color
   322	
   323	    return out
