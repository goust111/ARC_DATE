+            {
+                "gap": gap,
+                "seed": seed,
+                "out_dir": out_dir,
+                "path": path,
+                "painted": painted,
+                "path_len": len(path),
+                "painted_len": len(painted),
+                "turns": turns,
+            }
+        )
