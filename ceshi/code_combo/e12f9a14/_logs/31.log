   508	
   509	    grid = np.full((n, n), bg, dtype=int)
   510	    for (r0, c0), color, choice in zip(positions, block_colors, chosen):
   511	        _draw_framed_block(grid, r0, c0, bg, frame_color, int(color), (choice["gap"],))
   512	
   513	    try:
   514	        out = main(grid)
   515	    except Exception:
   516	        return None
   517	
   518	    info = _analyze_input(grid)
   519	    if len(info) != block_count:
   520	        return None

