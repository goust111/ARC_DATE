   435	        if len(painted) < MIN_PAINTED:
   436	            continue
   437	        if turns < MIN_TURNS:
   438	            continue
   439	        if len(painted) >= len(path) - 1:
   440	            continue
   441	        candidates.append(
   442	            {
   443	                "gap": gap,
   444	                "seed": seed,
   445	                "out_dir": out_dir,
   446	                "path": path,
   447	                "painted": painted,
   448	                "path_len": len(path),
   449	                "painted_len": len(painted),
   450	                "turns": turns,
   451	            }
   452	        )
