+
+def _path_compatible(
+    a: list[tuple[int, int]],
+    b: list[tuple[int, int]],
+) -> bool:
+    aset = set(a)
+    bset = set(b)
+    if not aset.isdisjoint(bset):
+        return False
+    for cell in aset:
+        for nbr in _neighbors4(cell):
+            if nbr in bset:
