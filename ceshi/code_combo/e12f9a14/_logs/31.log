   470	            if not ok:
   471	                break
   472	        if not ok:
   473	            continue
   474	        dirs = {entry["out_dir"] for entry in combo}
   475	        if len(dirs) < 2:
   476	            continue
   477	        score = sum(int(entry["path_len"]) + 2 * int(entry["turns"]) for entry in combo)
   478	        all_combos.append((score, list(combo)))
   479	    if not all_combos:
   480	        return None
   481	    all_combos.sort(key=lambda x: x[0], reverse=True)
   482	    top = all_combos[: min(12, len(all_combos))]
   483	    return top[int(rng.integers(len(top)))][1]
