   419	def _candidate_launches(
   420	    obstacles: np.ndarray,
   421	    bg: int,
   422	    block: tuple[int, int, int],
   423	) -> list[dict[str, object]]:
   424	    color, br, bc = block
   425	    r0, c0 = br - 1, bc - 1
   426	    candidates: list[dict[str, object]] = []
   427	    for gap in _SIDE_GAPS:
