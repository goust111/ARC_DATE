+_MIN_SURVIVING_BASE_COLORS = 3
+_GEN_MAX_RETRIES = 240
+_D6_SOURCE_MOD = None
+_D6_SOURCE_PATH = "/home/lixinyu/snap/new/ceshi/code/e8686506/D6/2/code.py"
