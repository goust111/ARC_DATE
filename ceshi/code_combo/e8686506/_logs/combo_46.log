+# --------------- generator (o5x) ---------------
+
+# === CFG: Output dimensions ===
+_AREA_MIN = 25
+_AREA_MAX = 50
+_WIDTH_REQUIRED = 5
+_HEIGHT_MAX = 10
+
+# === CFG: Base palette / frame variety ===
+_N_BASE_COLORS = 4
+_TWO_FRAME_MIN_H = 6
+_TWO_FRAME_PROB = 0.35
+_CENTER_CAP_PROB = 0.5
+
+# === CFG: Piece constraints ===
+_MAX_PIECE_AREA = 6
+_MAX_CHUNK_SIZE = 6
+_PIECE_COUNT_MIN = 9
+_PIECE_COUNT_MAX = 17
+
+# === CFG: Fused visibility constraints ===
+_MIN_SEAM_CELLS = 6
+
+# === CFG: Canvas / scatter ===
+_CANVAS_MIN = 13
+_CANVAS_MAX = 15
+_SCATTER_PADDING = 1
+
+# === CFG: Retry ===
+_GEN_MAX_RETRIES = 900
+
+
+def _valid_dims() -> list[tuple[int, int]]:
+    results = []
+    for area in range(_AREA_MIN, _AREA_MAX + 1):
+        dims = [(area // w, w) for w in range(1, area + 1) if area % w == 0 and area // w >= w]
+        best_gap = min(abs(h - w) for h, w in dims)
+        best = [(h, w) for h, w in dims if abs(h - w) == best_gap]
+        if len(best) == 1:
+            h, w = best[0]
+            if w == _WIDTH_REQUIRED and h <= _HEIGHT_MAX:
+                results.append((h, w))
+    return results
+
+
+_VALID_DIMS = _valid_dims()
+_DIM_WEIGHTS = [h * w for h, w in _VALID_DIMS]
+
+
+def _zigzag_frame(H: int) -> tuple[set[tuple[int, int]], int, int]:
+    cells = set()
+    start_c = random.randint(0, 1)
+    c = start_c
+    for r in range(H):
+        cells.add((r, c))
+        if r == H - 1:
+            break
+        move = random.choice(["down", "horiz", "diag"])
+        if move == "horiz":
+            cells.add((r, 1 - c))
+            c = 1 - c
+        elif move == "diag":
+            c = 1 - c
