        continue
    if not np.array_equal(base_out, base_out[:, ::-1]):
        counts['not_sym'] = counts.get('not_sym',0)+1
        continue
    if set(map(int, np.unique(base_out))) "'!= set(mod._BASE_COLORS):
        counts['"'not_all_base_colors'] = counts.get('not_all_base_colors',0)+1
        continue
    pc = mod._piece_count(base_out)
    if not (mod._PIECE_COUNT_MIN <= pc <= mod._PIECE_COUNT_MAX):
        counts['piece_count'] = counts.get('piece_count',0)+1
        continue
    too_big = any(len(pts) > mod._MAX_PIECE_AREA for col in np.unique(base_out) for pts in mod.components_mask(base_out == col, connectivity=4))
    if too_big:
        counts['too_big'] = counts.get('too_big',0)+1
        continue
    seam_out = mod._apply_seam_transform(base_out)
    final_out = mod._apply_global_color_cycle(seam_out)
    if not np.any(seam_out == mod._SEAM_COLOR):
        counts['no_seam'] = counts.get('no_seam',0)+1
        continue
    if np.count_nonzero(seam_out == mod._SEAM_COLOR) < mod._MIN_SEAM_CELLS:
        counts['few_seam'] = counts.get('few_seam',0)+1
        continue
    if set(map(int, np.unique(seam_out))) "'!= mod._FINAL_COLORS:
        counts['"'seam_colors'] = counts.get('seam_colors',0)+1
        continue
    if set(map(int, np.unique(final_out))) "'!= mod._FINAL_COLORS:
        counts['"'final_colors'] = counts.get('final_colors',0)+1
        continue
    if np.array_equal(base_out, seam_out):
        counts['base_eq_seam'] = counts.get('base_eq_seam',0)+1
        continue
    if np.array_equal(seam_out, final_out):
        counts['seam_eq_final'] = counts.get('seam_eq_final',0)+1
        continue
    if np.array_equal(base_out, final_out):
        counts['base_eq_final'] = counts.get('base_eq_final',0)+1
        continue
    bad=False
    for col in mod._BASE_COLORS:
        if not np.any(seam_out == col):
            bad=True
            break
    if bad:
        counts['survivor_colors'] = counts.get('survivor_colors',0)+1
        continue
    counts['pre_scatter_ok'] = counts.get('pre_scatter_ok',0)+1
print(counts)
