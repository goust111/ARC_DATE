+        got = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(base_check, base_out):
+        return None
+    if np.array_equal(got, final_out):
+        return inp
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(_GEN_MAX_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
