+        len(pts) > _MAX_PIECE_AREA
+        for col in np.unique(base_out)
+        for pts in components_mask(base_out == col, connectivity=4)
+    ):
+        return None
+
+    seam_out = _apply_seam_transform(base_out)
+    final_out = _apply_global_color_cycle(seam_out)
+    if not _transformed_output_ok(base_out, seam_out, final_out):
+        return None
+
+    bg = random.choice(_BG_CHOICES)
+    try:
+        inp = _scatter(base_out, bg, fcs)
+        got = main(inp)
+    except Exception:
+        return None
+    if np.array_equal(got, final_out):
+        return inp
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(_GEN_MAX_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid e8686506 combo input")

