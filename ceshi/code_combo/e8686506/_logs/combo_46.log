+
+    total_area = sum(int(t["cnt"]) * len(t["coords"]) for t in types)
+    assert total_area > 0, "total_area must be positive: grid must contain non-background pieces"
+
+    dims = [(h, w) for (h, w) in _factors(total_area) if h >= w]
+    assert dims, "at least one portrait factor pair must exist for the total piece area"
+    best_gap = min(abs(h - w) for h, w in dims)
+    best_dims = [(h, w) for h, w in dims if abs(h - w) == best_gap]
+    assert len(best_dims) == 1, "closest-to-square portrait output shape must be unique"
+    H, W = best_dims[0]
+
+    comps8_all = []
+    for col in sorted(set(map(int, np.unique(g))) - {bg}):
+        for pts in components_mask(g == col, connectivity=8):
+            comps8_all.append((int(col), pts))
+
+    def _is_lr_symmetric(parts: list[tuple[int, np.ndarray]], h: int, w: int) -> bool:
+        all_pts = np.concatenate([p for _, p in parts])
+        r0, c0 = int(all_pts[:, 0].min()), int(all_pts[:, 1].min())
+        bmp = np.zeros((h, w), dtype=bool)
+        for _, pts in parts:
+            for r, c in pts:
+                bmp[int(r) - r0, int(c) - c0] = True
+        return np.array_equal(bmp, bmp[:, ::-1])
+
+    frame_parts: list[tuple[int, np.ndarray]] = []
+    for i, (c1, p1) in enumerate(comps8_all):
+        r0, c0, r1, c1b = bbox_coords(p1)
+        if r1 - r0 + 1 == H and c1b - c0 + 1 == W and _is_lr_symmetric([(c1, p1)], H, W):
+            frame_parts = [(c1, p1)]
+            break
+        for j in range(i + 1, len(comps8_all)):
+            c2, p2 = comps8_all[j]
+            union = np.concatenate([p1, p2])
+            ur0, uc0, ur1, uc1 = bbox_coords(union)
+            if ur1 - ur0 + 1 == H and uc1 - uc0 + 1 == W and _is_lr_symmetric([(c1, p1), (c2, p2)], H, W):
+                frame_parts = [(c1, p1), (c2, p2)]
+                break
+        if frame_parts:
+            break
+    assert frame_parts, "input must contain 1-2 LR-symmetric pieces (8-conn) whose union bbox equals output dims"
+
+    req = _build_requirements(H, W, comps_by_color)
+
+    all_frame_pts = np.concatenate([p for _, p in frame_parts])
+    fr0, fc0 = int(all_frame_pts[:, 0].min()), int(all_frame_pts[:, 1].min())
+    for col, pts in frame_parts:
+        for r, c in pts:
+            or_, oc = int(r) - fr0, int(c) - fc0
+            if 0 <= or_ < H and 0 <= oc < W:
+                req[or_, oc] = col
+
+    disallow_touch = {col for col, n in color_piece_count.items() if n > 1}
+    return _assemble(types, H, W, req, disallow_touch)
+
+
+def _contact_seam_mask(board: np.ndarray) -> np.ndarray:
+    mask = np.zeros(board.shape, dtype=bool)
+    diff_ud = board[1:, :] != board[:-1, :]
+    diff_lr = board[:, 1:] != board[:, :-1]
+    mask[1:, :] |= diff_ud
+    mask[:-1, :] |= diff_ud
+    mask[:, 1:] |= diff_lr
+    mask[:, :-1] |= diff_lr
+    return mask
+
+
+def _apply_seam_transform(board: np.ndarray, seam_color: int = _SEAM_COLOR) -> np.ndarray:
+    out = np.array(board, copy=True)
+    out[_contact_seam_mask(board)] = seam_color
+    return out
+
+
+def _apply_global_color_cycle(board: np.ndarray) -> np.ndarray:
+    present = set(map(int, np.unique(board)))
+    assert present <= _FINAL_COLORS, "global recolor expects only seam-stage colors 1..5"
+    return _GLOBAL_LOOKUP[board]
+
+
+def _apply_combo_postprocess(board: np.ndarray) -> np.ndarray:
+    seam = _apply_seam_transform(board)
+    return _apply_global_color_cycle(seam)
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Reassemble the scattered fragments into the hidden rectangle, then apply two ordered color postprocesses.
+
+    Input structure:
+    - The background is the most frequent color; every other connected component is a native fragment of the pre-transform rectangle.
+    - One or two frame fragments still remain in output-relative alignment, while the remaining interior fragments are scattered away from that frame box.
+    - Only the source colors 1..4 appear on fragments; seam grey and the final recolor effect exist only after assembly.
+
+    Rule:
+    - First reconstruct the same dense left-right symmetric portrait rectangle as in the original task by packing all non-background pieces under the mirror and anchor constraints.
+    - Next recolor every cell on a 4-neighbor contact between different assembled colors to grey.
+    - Finally apply the fixed global color cycle 1->2, 2->3, 3->4, 4->5, 5->1 to the whole rectangle, including those grey seam cells.
+
+    Key insight:
+    - The geometric solve is unchanged from the source task; the novelty is that the visible output comes from a strictly ordered two-step postprocess, so the seam layer must be inferred before the final whole-board color substitution.
+    """
+    base = _assemble_base_rectangle(grid)
+    return _apply_combo_postprocess(base).astype(int)
+
+
+# --------------- generator (o5x) ---------------
+
+# === CFG: Output dimensions ===
+_AREA_MIN = 25
+_AREA_MAX = 50
+_WIDTH_REQUIRED = 5
+_HEIGHT_MAX = 10
+
+# === CFG: Base palette / frame variety ===
+_N_BASE_COLORS = 4
+_TWO_FRAME_MIN_H = 6
+_TWO_FRAME_PROB = 0.35
+_CENTER_CAP_PROB = 0.5
+
+# === CFG: Piece constraints ===
+_MAX_PIECE_AREA = 6
+_MAX_CHUNK_SIZE = 6
+_PIECE_COUNT_MIN = 9
+_PIECE_COUNT_MAX = 17
+
+# === CFG: Fused visibility constraints ===
+_MIN_SEAM_CELLS = 6
+
+# === CFG: Canvas / scatter ===
+_CANVAS_MIN = 13
+_CANVAS_MAX = 15
+_SCATTER_PADDING = 1
+
+# === CFG: Retry ===
+_GEN_MAX_RETRIES = 900
+
+
+def _valid_dims() -> list[tuple[int, int]]:
+    results = []
+    for area in range(_AREA_MIN, _AREA_MAX + 1):
+        dims = [(area // w, w) for w in range(1, area + 1) if area % w == 0 and area // w >= w]
+        best_gap = min(abs(h - w) for h, w in dims)
+        best = [(h, w) for h, w in dims if abs(h - w) == best_gap]
+        if len(best) == 1:
+            h, w = best[0]
+            if w == _WIDTH_REQUIRED and h <= _HEIGHT_MAX:
+                results.append((h, w))
+    return results
+
+
+_VALID_DIMS = _valid_dims()
+_DIM_WEIGHTS = [h * w for h, w in _VALID_DIMS]
+
+
+def _zigzag_frame(H: int) -> tuple[set[tuple[int, int]], int, int]:
+    cells = set()
+    start_c = random.randint(0, 1)
+    c = start_c
+    for r in range(H):
+        cells.add((r, c))
+        if r == H - 1:
+            break
+        move = random.choice(["down", "horiz", "diag"])
+        if move == "horiz":
+            cells.add((r, 1 - c))
+            c = 1 - c
+        elif move == "diag":
+            c = 1 - c
+    return cells, start_c, c
+
+
+def _fill_holes(grid: np.ndarray, W: int, frame1: int, frame2: int, split: int, fill_pool: list[int]) -> None:
+    holes = components_mask(grid == -1, connectivity=4)
+    prev_col = None
+    chunk_index = 0
+    for hole in holes:
+        cells = sorted((int(r), int(c)) for r, c in hole)
+        chunks = [cells[i : i + _MAX_CHUNK_SIZE] for i in range(0, len(cells), _MAX_CHUNK_SIZE)]
+        for chunk in chunks:
+            fc_set = {frame1 if r < split else frame2 for r, _ in chunk}
+            if chunk_index < len(fill_pool):
+                preferred = fill_pool[chunk_index]
+                opts = [preferred] if preferred not in fc_set else []
+            else:
+                avoid = fc_set | ({prev_col} if prev_col is not None else set())
+                opts = [f for f in fill_pool if f not in avoid]
+                if not opts:
+                    opts = [f for f in fill_pool if f not in fc_set] or fill_pool
+            col = random.choice(opts)
+            for r, c in chunk:
+                grid[r, c] = col
+                grid[r, W - 1 - c] = col
+            prev_col = col
+            chunk_index += 1
+
+
+def _build_base_output(H: int, W: int) -> tuple[np.ndarray | None, set[int]]:
+    palette = list(_BASE_COLORS)
+    random.shuffle(palette)
+
+    use_two_frames = H >= _TWO_FRAME_MIN_H and random.random() < _TWO_FRAME_PROB
+    frame1 = palette[0]
+    frame2 = frame1
+    fill_start = 1
+    if use_two_frames:
+        frame2 = palette[1]
+        fill_start = 2
+    fill_pool = palette[fill_start:]
+    if not fill_pool:
+        return None, set()
+
+    frame_half, start_c, end_c = _zigzag_frame(H)
+    split = H // 2 if frame1 != frame2 else H
+    half = W // 2
+    grid = np.full((H, W), -1, dtype=int)
+
+    for r, c in frame_half:
+        fc = frame1 if r < split else frame2
+        grid[r, c] = fc
+        grid[r, W - 1 - c] = fc
+
+    if start_c == 1 and random.random() < _CENTER_CAP_PROB:
+        grid[0, half] = frame1
+    if end_c == 1 and random.random() < _CENTER_CAP_PROB:
+        grid[H - 1, half] = frame2
+
+    _fill_holes(grid, W, frame1, frame2, split, fill_pool)
+    if np.any(grid < 0):
+        return None, set()
+    if set(map(int, np.unique(grid))) != set(_BASE_COLORS):
+        return None, set()
+
+    frame_set = {frame1}
+    if frame2 != frame1:
+        frame_set.add(frame2)
+    return grid, frame_set
+
+
+def _extract_non_frame_patches(base_out: np.ndarray, bg: int, fcs: set[int]) -> list[np.ndarray]:
+    patches = []
+    for col in sorted(map(int, np.unique(base_out))):
+        if col in fcs:
+            continue
+        for pts in components_mask(base_out == col, connectivity=4):
+            r0, c0, r1, c1 = bbox_coords(pts)
+            patch = np.full((r1 - r0 + 1, c1 - c0 + 1), bg, dtype=int)
+            for r, c in pts:
+                patch[int(r) - r0, int(c) - c0] = col
+            patches.append(patch)
+    random.shuffle(patches)
+    patches.sort(key=lambda p: (-(p != bg).sum(), random.random()))
+    return patches
+
+
+def _scatter(base_out: np.ndarray, bg: int, fcs: set[int]) -> np.ndarray:
+    rows = random.randint(_CANVAS_MIN, _CANVAS_MAX)
+    cols = random.randint(_CANVAS_MIN, _CANVAS_MAX)
+    canvas = np.full((rows, cols), bg, dtype=int)
+    oh, ow = base_out.shape
+
+    max_r = rows - oh - 2
+    max_c = cols - ow - 2
+    if max_r < 1 or max_c < 1:
+        raise ValueError("canvas too small for reserved frame box")
+    off_r = random.randint(1, max_r)
+    off_c = random.randint(1, max_c)
+
+    canvas[off_r : off_r + oh, off_c : off_c + ow] = -1
+
+    for patch in _extract_non_frame_patches(base_out, bg, fcs):
+        r, c = random_free_location(
+            canvas,
+            patch,
+            transparent=bg,
+            padding=_SCATTER_PADDING,
+            padding_connectivity=8,
+        )
+        paste(canvas, patch, r, c, transparent=bg)
+
+    frame_mask = np.zeros((oh, ow), dtype=bool)
+    for col in fcs:
+        frame_mask |= base_out == col
+    bbox_region = canvas[off_r : off_r + oh, off_c : off_c + ow]
+    bbox_region[:] = bg
+    bbox_region[frame_mask] = base_out[frame_mask]
+    return canvas
+
+
+def _piece_count(out: np.ndarray) -> int:
+    return sum(len(components_mask(out == col, connectivity=4)) for col in np.unique(out))
+
+
+def _transformed_output_ok(base_out: np.ndarray, seam_out: np.ndarray, final_out: np.ndarray) -> bool:
+    if not np.any(seam_out == _SEAM_COLOR):
+        return False
+    if np.count_nonzero(seam_out == _SEAM_COLOR) < _MIN_SEAM_CELLS:
+        return False
+    if set(map(int, np.unique(seam_out))) != _FINAL_COLORS:
+        return False
+    if set(map(int, np.unique(final_out))) != _FINAL_COLORS:
+        return False
+    if np.array_equal(base_out, seam_out):
+        return False
+    if np.array_equal(seam_out, final_out):
+        return False
+    if np.array_equal(base_out, final_out):
+        return False
+    for col in _BASE_COLORS:
+        if not np.any(seam_out == col):
+            return False
+    return True
+
+
+def _gen_attempt() -> np.ndarray | None:
+    H, W = random.choices(_VALID_DIMS, weights=_DIM_WEIGHTS, k=1)[0]
+    base_out, fcs = _build_base_output(H, W)
+    if base_out is None:
+        return None
+    if not np.array_equal(base_out, base_out[:, ::-1]):
+        return None
+    if set(map(int, np.unique(base_out))) != set(_BASE_COLORS):
+        return None
+    pc = _piece_count(base_out)
+    if not (_PIECE_COUNT_MIN <= pc <= _PIECE_COUNT_MAX):
+        return None
+    if any(
+        len(pts) > _MAX_PIECE_AREA
+        for col in np.unique(base_out)
+        for pts in components_mask(base_out == col, connectivity=4)
+    ):
+        return None
+
+    seam_out = _apply_seam_transform(base_out)
+    final_out = _apply_global_color_cycle(seam_out)
+    if not _transformed_output_ok(base_out, seam_out, final_out):
+        return None
+
+    bg = random.choice(_BG_CHOICES)
+    try:
+        inp = _scatter(base_out, bg, fcs)
+        got = main(inp)
+    except Exception:
+        return None
+    if np.array_equal(got, final_out):
+        return inp
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(_GEN_MAX_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid e8686506 combo input")

