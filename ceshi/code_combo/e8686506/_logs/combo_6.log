+        def dfs() -> bool:
+            sig = choose_unassigned()
+            if sig is None:
+                return True
+            for col in domain(sig):
+                assignment[sig] = int(col)
+                if dfs():
+                    return True
+                assignment.pop(sig)
+            return False
+
+        if not dfs():
