+
+# === CFG: Output dimensions ===
+_AREA_MIN = 50
+_AREA_MAX = 50
+_WIDTH_REQUIRED = 5
+_HEIGHT_REQUIRED = 10
+
+# === CFG: Color and palette ===
+_N_COLORS_MIN = 4
+_N_COLORS_MAX = 6
+_MIN_SWAP_FAMILIES = 2
+_MIN_FILL_COLORS_USED = 3
+
+# === CFG: Piece constraints ===
+_MAX_PIECE_AREA = 6
+_PIECE_COUNT_MIN = 9
+_PIECE_COUNT_MAX = 17
+_MAX_FRAME_PARTS = 5
+
+# === CFG: Canvas / scatter ===
+_CANVAS_MIN = 13
+_CANVAS_MAX = 15
+_SCATTER_PADDING = 1
+
+# === CFG: Retry ===
+_GEN_MAX_RETRIES = 400
