+    if meta.get("changed_cells", 0) == 0 or meta.get("frame_lr_symmetric", True):
+        return None, {}
+    try:
+        inp = _scatter(pre, bg, frame_colors)
+        got = main(inp)
+    except Exception:
+        return None, {}
+    if np.array_equal(got, out):
+        return inp, meta
+    return None, {}
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(_GEN_MAX_RETRIES):
