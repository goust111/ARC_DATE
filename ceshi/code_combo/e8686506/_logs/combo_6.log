+        "changed_cells": changed_cells,
+        "frame_lr_symmetric": bool(np.array_equal(frame_mask, frame_mask[:, ::-1])),
+        "used_fill_colors": len({int(colors_by_sig[sig]) for sig in colors_by_sig}),
+    }
