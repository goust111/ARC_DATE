+                            ok = True
+                            break
+                if not ok:
+                    return False
+        return True
+
+    for pi, r0, c0 in frame_group:
+        frame_variants = pieces[pi]["variants"]
+        assert len(frame_variants) == 1, "frame piece must not be rotatable"
+        place(pi, 0, r0, c0)
+
+    def search() -> bool:
+        remaining = [pi for pi in range(len(pieces)) if pi not in placed]
+        if not remaining:
+            return final_ok()
+
+        while True:
+            forced = None
+            best_pi = None
+            best_places = None
+            for pi in remaining:
+                places = placements_for(pi)
+                if not places:
+                    return False
+                if len(places) == 1:
+                    forced = (pi, places[0])
+                    break
+                if best_places is None or len(places) < len(best_places):
+                    best_pi = int(pi)
+                    best_places = places
+            if forced is None:
+                break
+            pi, (vi, r0, c0) = forced
+            place(pi, vi, r0, c0)
