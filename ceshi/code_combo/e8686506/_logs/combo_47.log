+    entries = []
+    for pid in sorted(set(map(int, pid_grid.flatten()))):
+        if pid < 0 or pid in frame_pids:
+            continue
+        entries.append({"pid": int(pid), "patch": _patch_from_pid(out, pid_grid, pid, bg)})
+    return frame_patch, entries
