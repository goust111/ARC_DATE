+            r, c = int(r0 + dr), int(c0 + dc)
+            board[r, c] = int(col)
+            owner[r, c] = int(pi)
+            is_connector[r, c] = (int(dr), int(dc)) in variant["connectors"]
+            changed.append((r, c))
