+def _patch_to_cells(patch: np.ndarray, fill: int = -1) -> tuple[tuple[int, int, int], ...]:
+    cells = []
+    for r, c in np.argwhere(patch != int(fill)):
+        cells.append((int(r), int(c), int(patch[int(r), int(c)])))
