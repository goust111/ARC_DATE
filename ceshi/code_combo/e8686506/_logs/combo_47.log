+    h = max(int(r) for r, _c, _col in cells) + 1
+    w = max(int(c) for _r, c, _col in cells) + 1
+    return {
+        "cells": tuple(sorted((int(r), int(c), int(col)) for r, c, col in cells)),
+        "coords": coords,
+        "connectors": connectors,
