+    def placements_for(pi: int) -> list[tuple[int, int, int]]:
+        require_touch = bool(placed)
+        out = []
+        for vi, variant in enumerate(pieces[pi]["variants"]):
+            for r0 in range(H - int(variant["h"]) + 1):
