+        "rotatable_count": int(len(rot_ids)),
+        "rotated_count": int(rotated_count),
+    }
+    return canvas.astype(int), meta
+
+
+def _behavior_metrics(inp: np.ndarray, out: np.ndarray) -> dict:
+    bg = get_bg(inp)
