+    metrics = _behavior_metrics(inp, out)
+    if metrics["rotatable_count"] < ROTATABLE_MIN:
+        return None
+    if metrics["turned_count"] != metrics["rotatable_count"]:
+        return None
+    return inp.astype(int)
+
