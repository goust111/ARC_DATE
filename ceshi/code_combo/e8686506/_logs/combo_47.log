+def _scatter(out: np.ndarray, pid_grid: np.ndarray, bg: int, frame_pids: set[int]) -> tuple[np.ndarray, dict]:
+    rows = random.randint(CANVAS_MIN, CANVAS_MAX)
+    cols = random.randint(CANVAS_MIN, CANVAS_MAX)
