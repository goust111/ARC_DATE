+    rotated_count = 0
+    for entry in entries:
+        patch = entry["patch"]
+        rotatable = int(entry["pid"]) in rot_ids
+        if rotatable:
+            k = random.choice((1, 3))
+            patch = _marked_patch(patch, bg, k)
