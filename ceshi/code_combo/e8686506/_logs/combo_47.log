+    canvas[off_r : off_r + oh, off_c : off_c + ow] = -1
+
+    n_rot = random.randint(ROTATABLE_MIN, min(ROTATABLE_MAX, len(entries) - 2))
+    rot_ids = set(random.sample([int(e["pid"]) for e in entries], n_rot))
