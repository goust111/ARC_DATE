+            turned += 1
+    return {
+        "rotatable_count": int(len(rotatable)),
+        "turned_count": int(turned),
+        "marker_count": int(np.sum(inp == int(MARKER_COLOR))),
+    }
+
+
+def _gen_attempt() -> np.ndarray | None:
+    out, bg, pid_grid, frame_pids = _build_structured_output()
