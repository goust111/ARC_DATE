+        "bottom_order_match": int(bot_order_in == out_order["bottom"]),
+        "top_same_shape_pair": int(len(top_shapes) == 2 and top_shapes[0] == top_shapes[1]),
+        "bottom_same_shape_pair": int(len(bot_shapes) == 2 and bot_shapes[0] == bot_shapes[1]),
