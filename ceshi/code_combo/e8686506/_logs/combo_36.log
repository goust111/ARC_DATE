+        if col == frame_color:
+            continue
+        pts = components_mask(out == col, connectivity=4)[0]
+        norm = _norm_coords_from_iter(pts)
+        mean_r = float(sum(int(r) for r, _ in pts)) / float(len(pts))
+        band = "top" if mean_r < (_HEIGHT / 2.0) else "bottom"
