+        "bottom": [col for _, col in bot_colors],
+    }
+
+
+def _arrange_rows(groups: list[tuple[int, list[tuple[tuple[int, int], ...]]]], out: np.ndarray, bg: int) -> np.ndarray:
+    canvas = np.full((_CANVAS_H, _CANVAS_W), int(bg), dtype=int)
