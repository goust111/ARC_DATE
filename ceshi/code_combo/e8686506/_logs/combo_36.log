+    if not all(metrics.values()):
+        return None
+    if _piece_count(inp, bg) != 10:
+        return None
+    return inp, out, metrics
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(_GEN_MAX_RETRIES):
+        result = _gen_attempt()
+        if result is not None:
+            grid, _out, _metrics = result
+            return grid
