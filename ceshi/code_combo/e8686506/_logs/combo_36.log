        print('attempt', t, 'ok?', eq, 'metrics', mod._fusion_metrics(inp, out) if eq else None)
        if eq:
            break
        else:
            print('out\\n', out)
            print('got\\n', got)
    except Exception:
        traceback.print_exc()
