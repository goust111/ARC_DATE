+_WIDTH = 5
+_HEIGHT = 11
+_CANVAS_H = 17
+_CANVAS_W = 20
+_GEN_MAX_RETRIES = 400
+_CANDIDATE_LIMIT = 500
+
+_WARM_COLORS = (2, 4, 7)
+_COOL_COLORS = (1, 5, 8)
+_FRAME_COLORS = (3, 6, 9)
+_BG_COLORS = (0,)
