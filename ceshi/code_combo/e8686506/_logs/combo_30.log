+        if len(comps) != 2 or not all(len(pts) == 1 for pts in comps):
+            continue
+        pts = sorted((int(pts[0, 0]), int(pts[0, 1])) for pts in comps)
+        (r0, c0), (r1, c1) = pts
+        if c0 == c1 and r0 != r1:
