+        inp = _scatter(out, bg, frame_colors, marker_colors)
+        got = main(inp)
+    except Exception:
+        return None
+    if np.array_equal(got, out):
+        return inp
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(_GEN_MAX_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid e8686506 combo input")

