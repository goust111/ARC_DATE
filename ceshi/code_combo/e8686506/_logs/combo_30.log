+def _make_output() -> tuple[np.ndarray, int, set[int], tuple[int, int]]:
+    roles = {"corner": 0, "frame": 1, "plus": 2, "side": 3, "cap": 4}
+    out = _render_output(_OUT_H, _OUT_W, roles)
