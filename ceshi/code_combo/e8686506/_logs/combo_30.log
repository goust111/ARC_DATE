+
+def _validate_frame(g: np.ndarray, frame_color: int, marker_info: dict) -> None:
+    H = int(marker_info["H"])
+    W = int(marker_info["W"])
+    fr0, fc0, fr1, fc1 = marker_info["bbox"]
