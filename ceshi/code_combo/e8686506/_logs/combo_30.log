+
+def _collect_components(g: np.ndarray, bg: int) -> dict[int, list[np.ndarray]]:
+    out: dict[int, list[np.ndarray]] = {}
+    for col in sorted(set(map(int, np.unique(g))) - {bg}):
+        out[col] = components_mask(g == col, connectivity=4)
+    return out
