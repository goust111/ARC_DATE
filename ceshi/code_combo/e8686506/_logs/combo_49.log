   429	def _zigzag_frame(H: int) -> tuple[set[tuple[int, int]], int, int]:
   430	    cells = set()
   431	    start_c = random.randint(0, 1)
   432	    c = start_c
   433	    for r in range(H):
   434	        cells.add((r, c))
   435	        if r == H - 1:
   436	            break
   437	        move = random.choice(["down", "horiz", "diag"])
   438	        if move == "horiz":
   439	            cells.add((r, 1 - c))
   440	            c = 1 - c
   441	        elif move == "diag":
   442	            c = 1 - c
   443	    return cells, start_c, c
   444	
   445	
   446	def _fill_holes(
   447	    grid: np.ndarray,
   448	    H: int,
   449	    W: int,
   450	    frame1: int,
   451	    frame2: int,
   452	    split: int,
   453	    fill_pool: list[int],
   454	) -> None:
   455	    holes = components_mask(grid == -1, connectivity=4)
   456	    prev_col = None
   457	    for hole in holes:
   458	        cells = sorted((int(r), int(c)) for r, c in hole)
   459	        chunks = [cells[i : i + _MAX_CHUNK_SIZE] for i in range(0, len(cells), _MAX_CHUNK_SIZE)]
   460	        for chunk in chunks:
   461	            fc_set = {frame1 if r < split else frame2 for r, _ in chunk}
   462	            avoid = fc_set | ({prev_col} if prev_col is not None else set())
   463	            opts = [f for f in fill_pool if f not in avoid]
   464	            if not opts:
   465	                opts = [f for f in fill_pool if f not in fc_set] or fill_pool
   466	            col = random.choice(opts)
   467	            for r, c in chunk:
   468	                grid[r, c] = col
   469	                grid[r, W - 1 - c] = col
   470	            prev_col = col
   471	
   472	
   473	def _build_output(H: int, W: int) -> tuple[np.ndarray | None, set[int]]:
   474	    n_colors = random.randint(_N_COLORS_MIN, _N_COLORS_MAX)
   475	    palette = list(range(n_colors))
   476	    random.shuffle(palette)
   477	
   478	    use_two_frames = (
   479	        H >= _TWO_FRAME_MIN_H
   480	        and n_colors >= _TWO_FRAME_MIN_COLORS
   481	        and random.random() < _TWO_FRAME_PROB
   482	    )
   483	    ci = 0
   484	    frame1 = palette[ci]
   485	    ci += 1
   486	    frame2 = frame1
   487	    if use_two_frames:
   488	        frame2 = palette[ci]
   489	        ci += 1
   490	    fill_pool = palette[ci:]
   491	    if not fill_pool:
   492	        return None, set()
   493	
   494	    half = W // 2
   495	    frame_half, start_c, end_c = _zigzag_frame(H)
   496	    split = H // 2 if frame1 != frame2 else H
   497	    grid = np.full((H, W), -1, dtype=int)
   498	
   499	    for r, c in frame_half:
   500	        fc = frame1 if r < split else frame2
   501	        grid[r, c] = fc
   502	        grid[r, W - 1 - c] = fc
   503	
   504	    if start_c == 1 and random.random() < _CENTER_CAP_PROB:
   505	        grid[0, half] = frame1
   506	    if end_c == 1 and random.random() < _CENTER_CAP_PROB:
   507	        grid[H - 1, half] = frame2
   508	
   509	    _fill_holes(grid, H, W, frame1, frame2, split, fill_pool)
   510	    if np.any(grid < 0):
   511	        return None, set()
   512	
   513	    frame_set = {frame1}
   514	    if frame2 != frame1:
   515	        frame_set.add(frame2)
   516	    return grid, frame_set
   517	
   518	
   519	def _make_output() -> tuple[np.ndarray | None, int, set[int]]:
   520	    H, W = random.choices(_VALID_DIMS, weights=_DIM_WEIGHTS, k=1)[0]

