   298	def _solve_from_frame_candidate(
   299	    comps4_all: list[tuple[int, np.ndarray]],
   300	    candidate: dict,
   301	) -> np.ndarray | None:
   302	    H, W = int(candidate["H"]), int(candidate["W"])
   303	    total_area = sum(len(pts) for _, pts in comps4_all)
   304	    excess_area = total_area - H * W
   305	    if excess_area < 0:
   306	        return None
   307	
   308	    frame_cells = {
   309	        (int(r), int(c))
   310	        for _, pts in candidate["parts"]
   311	        for r, c in pts
   312	    }
   313	    singleton_indices = []
   314	    priority_indices = []
   315	    r0, c0, r1, c1 = candidate["bbox"]
   316	    for idx, (_col, pts) in enumerate(comps4_all):
   317	        if len(pts) != 1:
   318	            continue
   319	        rr, cc = map(int, pts[0])
   320	        if (rr, cc) in frame_cells:
   321	            continue
   322	        singleton_indices.append(idx)
   323	        if r0 < rr < r1 and c0 < cc < c1:
   324	            priority_indices.append(idx)
   325	
   326	    if excess_area > len(singleton_indices):
   327	        return None
   328	    if excess_area == 0:
   329	        return _try_kept_components(comps4_all, candidate)
   330	
   331	    base_order = priority_indices + [idx for idx in singleton_indices if idx not in set(priority_indices)]
   332	    for subset in combinations(base_order, excess_area):
   333	        removed = set(subset)
   334	        kept = [comp for i, comp in enumerate(comps4_all) if i not in removed]
   335	        sol = _try_kept_components(kept, candidate)
   336	        if sol is not None:
   337	            return sol
   338	    return None
