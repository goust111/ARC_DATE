   341	def main(grid: np.ndarray) -> np.ndarray:
   342	    """
   343	    Rebuild the real fragments into a dense LR-symmetric rectangle while ignoring gap clutter.
   344	
   345	    Input structure:
   346	    - The dominant color is background; non-background cells contain the true monochrome fragments plus a few isolated junk pixels.
   347	    - One or two 8-connected frame fragments still sit in their output-relative arrangement and reveal the rectangle size.
   348	    - The remaining real fragments are packed tightly elsewhere with only 1-pixel gaps, and some of those gaps contain singleton interference pixels.
   349	
   350	    Rule:
   351	    - Find the frame candidate first and use its bounding box as the output HxW anchor.
   352	    - Treat only singleton components as removable noise candidates, and remove exactly as many as needed to make the remaining total area match that anchored rectangle.
   353	    - Among those candidate removals, keep the one whose surviving pieces satisfy the anchor constraints and assemble into a perfectly left-right symmetric rectangle where distinct same-color pieces never 4-touch.
   354	
   355	    Key insight:
   356	    - Tight packing makes local boundaries visually noisy, so raw area and singleton counts cannot be trusted upfront.
   357	    - The frame outline is still globally reliable; once it fixes HxW, the correct noise subset is exactly the one that restores a legal propagation-only assembly.
   358	    """
   359	    g = np.asarray(grid, dtype=int)
   360	    bg = get_bg(g)
   361	
   362	    comps4_all: list[tuple[int, np.ndarray]] = []
   363	    comps8_all: list[tuple[int, np.ndarray]] = []
   364	    for col in sorted(set(map(int, np.unique(g))) - {bg}):
   365	        for pts in components_mask(g == col, connectivity=4):
   366	            comps4_all.append((int(col), pts))
   367	        for pts in components_mask(g == col, connectivity=8):
   368	            comps8_all.append((int(col), pts))
   369	
   370	    for candidate in _enumerate_frame_candidates(comps8_all):
   371	        sol = _solve_from_frame_candidate(comps4_all, candidate)
   372	        if sol is not None:
   373	            return sol.astype(int)
   374	
   375	    raise AssertionError("no frame candidate yields a valid tight-pack assembly")
   376	
