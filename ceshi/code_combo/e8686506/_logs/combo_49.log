   412	def _valid_dims() -> list[tuple[int, int]]:
   413	    results = []
   414	    for area in range(_AREA_MIN, _AREA_MAX + 1):
   415	        dims = [(area // w, w) for w in range(1, area + 1) if area % w == 0 and area // w >= w]
   416	        best_gap = min(abs(h - w) for h, w in dims)
   417	        best = [(h, w) for h, w in dims if abs(h - w) == best_gap]
   418	        if len(best) == 1:
   419	            h, w = best[0]
   420	            if w == _WIDTH_REQUIRED and h <= _HEIGHT_MAX:
   421	                results.append((h, w))
   422	    return results
   423	
