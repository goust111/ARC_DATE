   166	            if not mirror_ok(r, c, col):
   167	                return False
   168	            if is_singleton and not (r == 0 or r == H - 1 or c == 0 or c == W - 1):
   169	                return False
   170	            if disallow_touch and col in disallow_touch:
   171	                for rr, cc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
   172	                    if 0 <= rr < H and 0 <= cc < W and board[rr, cc] == col:
   173	                        return False
   174	        return True
   175	
   176	    def place(ti: int, r0: int, c0: int) -> None:
   177	        t = types[ti]
   178	        col = int(t["col"])
   179	        for dr, dc in t["coords"]:
   180	            board[r0 + dr, c0 + dc] = col
   181	
   182	    def placements_for(ti: int) -> list[tuple[int, int]]:
   183	        t = types[ti]
   184	        return [
   185	            (r0, c0)
   186	            for r0 in range(H - int(t["h"]) + 1)
   187	            for c0 in range(W - int(t["w"]) + 1)
   188	            if can_place(ti, r0, c0)
   189	        ]
   190	
   191	    changed = True
   192	    while changed:
   193	        changed = False
   194	        for ti in range(len(types)):
   195	            if counts[ti] <= 0:
   196	                continue
   197	            places = placements_for(ti)
   198	            assert places, "assembly dead end: a piece has no valid placement"
   199	            if len(places) == 1:
   200	                counts[ti] -= 1
   201	                place(ti, places[0][0], places[0][1])
   202	                changed = True
   203	            elif len(places) == counts[ti]:
   204	                for r0, c0 in places:
   205	                    counts[ti] -= 1
   206	                    place(ti, r0, c0)
   207	                changed = True
   208	    assert all(c == 0 for c in counts), "assembly not purely propagation-solvable"
   209	    assert np.array_equal(board, board[:, ::-1]), "assembled board must be LR-symmetric"
   210	    return board
