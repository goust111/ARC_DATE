   213	def _is_lr_symmetric(parts: list[tuple[int, np.ndarray]], h: int, w: int) -> bool:
   214	    all_pts = np.concatenate([p for _, p in parts])
   215	    r0, c0 = int(all_pts[:, 0].min()), int(all_pts[:, 1].min())
   216	    bmp = np.zeros((h, w), dtype=bool)
   217	    for _, pts in parts:
   218	        for r, c in pts:
   219	            bmp[int(r) - r0, int(c) - c0] = True
   220	    return np.array_equal(bmp, bmp[:, ::-1])
