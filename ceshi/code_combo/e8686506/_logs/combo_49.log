   379	
   380	# === CFG: Output dimensions ===
   381	_AREA_MIN = 25
   382	_AREA_MAX = 50
   383	_WIDTH_REQUIRED = 5
   384	_HEIGHT_MAX = 10
   385	
   386	# === CFG: Color and palette ===
   387	_N_COLORS_MIN = 4
   388	_N_COLORS_MAX = 6
   389	_TWO_FRAME_MIN_H = 6
   390	_TWO_FRAME_MIN_COLORS = 5
   391	_TWO_FRAME_PROB = 0.35
   392	_CENTER_CAP_PROB = 0.5
   393	
   394	# === CFG: Piece constraints ===
   395	_MAX_PIECE_AREA = 6
   396	_MAX_CHUNK_SIZE = 6
   397	_PIECE_COUNT_MIN = 9
   398	_PIECE_COUNT_MAX = 17
   399	
   400	# === CFG: Canvas / tight tray ===
   401	_CANVAS_MIN = 14
   402	_CANVAS_MAX = 16
   403	_NOISE_MIN = 1
   404	_NOISE_MAX = 3
   405	_TRAY_MAX_W = 8
   406	_TIGHT_PAIR_MIN = 3
   407	
   408	# === CFG: Retry ===
   409	_GEN_MAX_RETRIES = 900
