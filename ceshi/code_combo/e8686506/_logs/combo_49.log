   223	def _enumerate_frame_candidates(comps8_all: list[tuple[int, np.ndarray]]) -> list[dict]:
   224	    candidates = []
   225	    for i, (c1, p1) in enumerate(comps8_all):
   226	        r0, c0, r1, c1b = bbox_coords(p1)
   227	        h1, w1 = r1 - r0 + 1, c1b - c0 + 1
   228	        if h1 >= w1 and _is_lr_symmetric([(c1, p1)], h1, w1):
   229	            candidates.append({"parts": [(c1, p1)], "bbox": (r0, c0, r1, c1b), "H": h1, "W": w1})
   230	        for j in range(i + 1, len(comps8_all)):
   231	            c2, p2 = comps8_all[j]
   232	            union = np.concatenate([p1, p2])
   233	            ur0, uc0, ur1, uc1 = bbox_coords(union)
   234	            h, w = ur1 - ur0 + 1, uc1 - uc0 + 1
   235	            if h < w:
   236	                continue
   237	            parts = [(c1, p1), (c2, p2)]
   238	            if _is_lr_symmetric(parts, h, w):
   239	                candidates.append({"parts": parts, "bbox": (ur0, uc0, ur1, uc1), "H": h, "W": w})
   240	    candidates.sort(key=lambda cand: (-(cand["H"] * cand["W"]), len(cand["parts"])))
   241	    return candidates
