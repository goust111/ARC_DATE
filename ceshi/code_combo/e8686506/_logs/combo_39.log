    ```python
    import numpy as np

from arc_utils import bbox_coords, components_mask, get_bg, paste, random_free_location
import random


def _piece_sig(pts: np.ndarray) -> tuple[int, int, tuple[tuple[int, int], ...]]:
    r0, c0, r1, c1 = bbox_coords(pts)
    coords = tuple(sorted((int(r) - r0, int(c) - c0) for r, c in pts))
    return (r1 - r0 + 1), (c1 - c0 + 1), coords


def _factors(n: int) -> list[tuple[int, int]]:
    out = []
    for w in range(1, n + 1):
        if n % w == 0:
            h = n // w
            out.append((h, w))
    return out


def _build_requirements(
    H: int,
    W: int,
    comps_by_color: dict[int, list[list[tuple[int, int]]]],
) -> np.ndarray:
    """
    Build per-cell required color constraints (req[r,c] == -1 means unconstrained).

    Heuristics supported by training examples:
      - If there is a color with exactly 4 singleton components, those are the four corners.
      - If there are full horizontal bars of length W-2 in the input, use them as the top/bottom edges
        between the corners (ordered by their vertical position in the input).
      - If there is a color with exactly two full vertical line components (width=1) in the input,
        place them on the left/right edges centered vertically.
    """
    req = np.full((H, W), -1, dtype=int)

    # 4 singleton components -> corners
    corner_colors = [
        col
        for col, comps in comps_by_color.items()
        if len(comps) == 4 and all(len(p) == 1 for p in comps)
    ]
    assert len(corner_colors) <= 1, "corner singleton color must be unique when present"
    corner_color = corner_colors[0] if corner_colors else None
    if corner_color is not None:
        req[0, 0] = corner_color
        req[0, W - 1] = corner_color
        req[H - 1, 0] = corner_color
        req[H - 1, W - 1] = corner_color

    # Horizontal bar(s) of length W-2 (filled, height 1)
    bar_colors: list[tuple[int, int]] = []  # (min_input_row, color)
    if W >= 3 and corner_color is not None:
        for col, comps in comps_by_color.items():
            for pts in comps:
                r0, c0, r1, c1 = bbox_coords(pts)
                hh, ww = r1 - r0 + 1, c1 - c0 + 1
                if hh == 1 and ww == (W - 2) and len(pts) == ww:
                    bar_colors.append((r0, col))
                    break
        if bar_colors:
            assert len(bar_colors) <= 2, "horizontal edge bar colors must be top/bottom only"
            bar_colors.sort()
            top_col = bar_colors[0][1]
            bot_col = bar_colors[-1][1]
            req[0, 1 : W - 1] = top_col
            req[H - 1, 1 : W - 1] = bot_col

    # Two full vertical line components -> left/right edges, centered vertically
    vertical_line_candidates = []
    for col, comps in comps_by_color.items():
        if len(comps) != 2:
            continue
        sigs = [_piece_sig(pts) for pts in comps]
        (h0, w0, coords0), (h1, w1, coords1) = sigs[0], sigs[1]
        if w0 == 1 and w1 == 1 and h0 == h1 and coords0 == coords1 and h0 > 1:
            vertical_line_candidates.append((col, h0))
    assert len(vertical_line_candidates) <= 1, "paired vertical edge-line color must be unique when present"
    if vertical_line_candidates:
        col, L = vertical_line_candidates[0]
        top = (H - L) // 2
        assert 0 <= top and top + L <= H, "paired vertical edge lines must fit in the output height"
        req[top : top + L, 0] = col
        req[top : top + L, W - 1] = col

    return req


def _assemble(
    types: list[dict],
    H: int,
    W: int,
    req: np.ndarray,
    disallow_touch: set[int] | None = None,
) -> np.ndarray:
    board = np.full((H, W), -1, dtype=int)
    counts = [int(t["cnt"]) for t in types]

    def mirror_ok(r: int, c: int, col: int) -> bool:
        mc = W - 1 - c
        v = board[r, mc]
        return (v == -1) or (v == col)

    def can_place(ti: int, r0: int, c0: int) -> bool:
        t = types[ti]
        col = int(t["col"])
        is_singleton = len(t["coords"]) == 1
        for dr, dc in t["coords"]:
            r, c = r0 + dr, c0 + dc
            if board[r, c] != -1:
                return False
            if req[r, c] != -1 and int(req[r, c]) != col:
                return False
            if not mirror_ok(r, c, col):
                return False
            if is_singleton and not (r == 0 or r == H - 1 or c == 0 or c == W - 1):
                return False
            if disallow_touch and col in disallow_touch:
                for rr, cc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
                    if 0 <= rr < H and 0 <= cc < W and board[rr, cc] == col:
                        return False
        return True

    def place(ti: int, r0: int, c0: int) -> list[tuple[int, int]]:
        t = types[ti]
        col = int(t["col"])
        changed = []
        for dr, dc in t["coords"]:
            r, c = r0 + dr, c0 + dc
            board[r, c] = col
            changed.append((r, c))
        return changed

    def unplace(changed: list[tuple[int, int]]) -> None:
        for r, c in changed:
            board[r, c] = -1

    def placements_for(ti: int) -> list[tuple[int, int]]:
        t = types[ti]
        return [(r0, c0)
                for r0 in range(H - int(t["h"]) + 1)
                for c0 in range(W - int(t["w"]) + 1)
                if can_place(ti, r0, c0)]

    # Pure constraint propagation: each step, every type must be forced (1 position)
    # or batch-forced (positions == cnt). No backtracking. Asserts if stuck.
    changed = True
    while changed:
        changed = False
        for ti in range(len(types)):
            if counts[ti] <= 0:
                continue
            places = placements_for(ti)
            assert len(places) > 0, "assembly dead end: a piece has no valid placement"
            if len(places) == 1:
                counts[ti] -= 1
                place(ti, places[0][0], places[0][1])
                changed = True
            elif len(places) == counts[ti]:
                for r0, c0 in places:
                    counts[ti] -= 1
                    place(ti, r0, c0)
                changed = True
    assert all(c == 0 for c in counts), "assembly not purely propagation-solvable"
    assert np.array_equal(board, board[:, ::-1]), "assembled board must be LR-symmetric"
    return board


def main(grid: np.ndarray) -> np.ndarray:
    """
    Assemble scattered colored fragments into a left-right symmetric rectangle, jigsaw-style.

    Input structure:
    - bg = most common color; remaining colors form small sprite fragments.
    - Optional roles: 4 singleton pixels of one color mark corners; horizontal bars mark top/bottom edges; paired vertical lines mark left/right edges.

    Rule:
    - Collect all non-bg connected components as jigsaw pieces.
    - Determine output rectangle dimensions from total piece area.
    - Pack pieces into the rectangle so it is exactly mirror-symmetric (left-right) and same-color pieces never 4-touch.

    Key insight: Left-right symmetry plus the no-same-color-touching constraint make the assembly unique; corner/edge markers anchor it when present.
    """
    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)

    # Extract pieces (connected components per color)
    comps_by_color: dict[int, list[list[tuple[int, int]]]] = {}
    pieces = []
    color_piece_count: dict[int, int] = {}

    for col in sorted(set(map(int, np.unique(g)))):
        if col == bg:
            continue
        comps = components_mask(g == col, connectivity=4)
        comps_by_color[col] = comps
        color_piece_count[col] = len(comps)
        for pts in comps:
            _, _, coords = _piece_sig(pts)
            pieces.append((col, coords))

    # Group identical pieces into types
    from collections import Counter

    ctr = Counter(pieces)
    types = []
    for (col, coords), cnt in sorted(ctr.items(), key=lambda kv: (-len(kv[0][1]), kv[0][0], kv[0][1])):
        arr = np.array(coords, dtype=int)
        h = int(arr[:, 0].max() + 1)
        w = int(arr[:, 1].max() + 1)
        types.append({"col": int(col), "coords": coords, "h": h, "w": w, "cnt": int(cnt)})

    total_area = sum(int(t["cnt"]) * len(t["coords"]) for t in types)
    assert total_area > 0, "total_area must be positive: grid must contain non-background pieces"

    # Disallow 4-neigh touching between different pieces of same color (preserve component counts)
    # Eval inputs use the unique closest-to-square portrait factor pair as the output shape.
    dims = [(h, w) for (h, w) in _factors(total_area) if h >= w]
    assert dims, "at least one portrait factor pair must exist for the total piece area"
    best_gap = min(abs(h - w) for h, w in dims)
    best_dims = [(h, w) for h, w in dims if abs(h - w) == best_gap]
    assert len(best_dims) == 1, "closest-to-square portrait output shape must be unique"
    H, W = best_dims[0]

    # Frame constraint: under 8-connectivity, 1-2 pieces must exist whose union bbox
    # equals the output rectangle (H x W). Their relative positions are fixed in output.
    comps8_all = []
    for col in sorted(set(map(int, np.unique(g))) - {bg}):
        for pts in components_mask(g == col, connectivity=8):
            comps8_all.append((int(col), pts))
    def _is_lr_symmetric(parts, h, w):
        """Check if the union of frame parts forms an LR-symmetric bitmap."""
        all_pts = np.concatenate([p for _, p in parts])
        r0, c0 = int(all_pts[:, 0].min()), int(all_pts[:, 1].min())
        bmp = np.zeros((h, w), dtype=bool)
        for _, pts in parts:
            for r, c in pts:
                bmp[int(r) - r0, int(c) - c0] = True
        return np.array_equal(bmp, bmp[:, ::-1])

    frame_parts: list[tuple[int, np.ndarray]] = []
    for i, (c1, p1) in enumerate(comps8_all):
        r0, c0, r1, c1b = bbox_coords(p1)
        if r1 - r0 + 1 == H and c1b - c0 + 1 == W:
            if _is_lr_symmetric([(c1, p1)], H, W):
                frame_parts = [(c1, p1)]
                break
        for j in range(i + 1, len(comps8_all)):
            c2, p2 = comps8_all[j]
            union = np.concatenate([p1, p2])
            ur0, uc0, ur1, uc1 = bbox_coords(union)
            if ur1 - ur0 + 1 == H and uc1 - uc0 + 1 == W:
                if _is_lr_symmetric([(c1, p1), (c2, p2)], H, W):
                    frame_parts = [(c1, p1), (c2, p2)]
                    break
        if frame_parts:
            break
    assert frame_parts, "input must contain 1-2 LR-symmetric pieces (8-conn) whose union bbox equals output dims"

    req = _build_requirements(H, W, comps_by_color)

    # Lock frame cells into req: their output positions are determined by input-relative positions.
    all_frame_pts = np.concatenate([p for _, p in frame_parts])
    fr0, fc0 = int(all_frame_pts[:, 0].min()), int(all_frame_pts[:, 1].min())
    for col, pts in frame_parts:
        for r, c in pts:
            or_, oc = int(r) - fr0, int(c) - fc0
            if 0 <= or_ < H and 0 <= oc < W:
                req[or_, oc] = col

    disallow_touch = {col for col, n in color_piece_count.items() if n > 1}
    sol = _assemble(types, H, W, req, disallow_touch)
    return sol.astype(int)

# --------------- generator (o5x) ---------------

# === CFG: Output dimensions ===
_AREA_MIN = 25               # minimum total piece area
_AREA_MAX = 50               # maximum total piece area (exclusive upper in range)
_WIDTH_REQUIRED = 5           # all valid outputs have width 5
_HEIGHT_MAX = 10              # maximum output height

# === CFG: Color and palette ===
_N_COLORS_MIN = 4             # min distinct colors in abstract output
_N_COLORS_MAX = 6             # max distinct colors in abstract output
_TWO_FRAME_MIN_H = 6          # min height to allow 2-color frame
_TWO_FRAME_MIN_COLORS = 5     # min palette size to allow 2-color frame
_TWO_FRAME_PROB = 0.35         # probability of splitting frame into 2 colors
_CENTER_CAP_PROB = 0.5         # probability of capping center col at top/bottom

# === CFG: Piece constraints ===
_MAX_PIECE_AREA = 6           # maximum area of any single 4-conn piece
_MAX_CHUNK_SIZE = 6           # max cells per hole chunk when splitting large holes
_PIECE_COUNT_MIN = 9          # min total 4-conn components in output
_PIECE_COUNT_MAX = 17         # max total 4-conn components in output

# === CFG: Canvas / scatter ===
_CANVAS_MIN = 13              # min canvas dimension (rows and cols)
_CANVAS_MAX = 15              # max canvas dimension (rows and cols)
_SCATTER_PADDING = 1          # Chebyshev padding between scattered pieces

# === CFG: Retry ===
_GEN_MAX_RETRIES = 300        # max attempts in generate_input()


def _valid_dims():
    """Precompute valid (H, W) pairs: unique closest-to-square portrait factorization with W=5."""
    results = []
    for area in range(_AREA_MIN, _AREA_MAX + 1):
        dims = [(area // w, w) for w in range(1, area + 1) if area % w == 0 and area // w >= w]
        best_gap = min(abs(h - w) for h, w in dims)
        best = [(h, w) for h, w in dims if abs(h - w) == best_gap]
        if len(best) == 1:
            h, w = best[0]
            if w == _WIDTH_REQUIRED and h <= _HEIGHT_MAX:
                results.append((h, w))
    return results


_VALID_DIMS = _valid_dims()
_DIM_WEIGHTS = [h * w for h, w in _VALID_DIMS]


def _zigzag_frame(H):
    """Generate frame bitmap (Hx2 left-half) via zigzag path from top to bottom.
    Returns (cells, start_c, end_c) where start_c/end_c are the column at top/bottom."""
    cells = set()
    start_c = random.randint(0, 1)
    c = start_c
    for r in range(H):
        cells.add((r, c))
        if r == H - 1:
            break
        move = random.choice(['down', 'horiz', 'diag'])
        if move == 'down':
            pass
        elif move == 'horiz':
            cells.add((r, 1 - c))
            c = 1 - c
        else:
            c = 1 - c
    return cells, start_c, c


def _fill_holes(grid, H, W, half, frame1, frame2, split, fill_pool):
    """Fill non-frame cells by assigning colors to 4-conn hole regions.
    Large holes are split into chunks of <= _MAX_CHUNK_SIZE cells."""
    holes = components_mask(grid == -1, connectivity=4)
    prev_col = None
    for hole in holes:
        cells = sorted((int(r), int(c)) for r, c in hole)
        # Split into chunks of bounded size
        chunks = [cells[i:i + _MAX_CHUNK_SIZE] for i in range(0, len(cells), _MAX_CHUNK_SIZE)]
        for chunk in chunks:
            # Determine which frame colors are adjacent to this chunk
            fc_set = {frame1 if r < split else frame2 for r, _ in chunk}
            # Pick a fill color avoiding frame and previous neighbor
            avoid = fc_set | ({prev_col} if prev_col else set())
            opts = [f for f in fill_pool if f not in avoid]
            if not opts:
                opts = [f for f in fill_pool if f not in fc_set] or fill_pool
            col = random.choice(opts)
            for r, c in chunk:
                grid[r, c] = col
                grid[r, W - 1 - c] = col
            prev_col = col


def _build_output(H, W):
    """Build an abstract LR-symmetric output grid with zigzag frame and filled holes.
    Returns (grid, frame_colors_set) or (None, set()) on failure."""
    half = W // 2
    n_colors = random.randint(_N_COLORS_MIN, _N_COLORS_MAX)
    palette = list(range(n_colors))
    random.shuffle(palette)

    use_two_frames = (H >= _TWO_FRAME_MIN_H and n_colors >= _TWO_FRAME_MIN_COLORS
                      and random.random() < _TWO_FRAME_PROB)
    ci = 0
    frame1 = palette[ci]; ci += 1
    frame2 = frame1
    if use_two_frames:
        frame2 = palette[ci]; ci += 1
    fill_pool = palette[ci:]
    if not fill_pool:
        return None, set()

    frame_half, start_c, end_c = _zigzag_frame(H)
    split = H // 2 if frame1 != frame2 else H

    grid = np.full((H, W), -1, dtype=int)

    # Paint frame cells (mirror left half to right)
    for r, c in frame_half:
        fc = frame1 if r < split else frame2
        grid[r, c] = fc
        grid[r, W - 1 - c] = fc

    # Cap center column at top/bottom when zigzag endpoint is adjacent
    if start_c == 1 and random.random() < _CENTER_CAP_PROB:
        grid[0, half] = frame1
    if end_c == 1 and random.random() < _CENTER_CAP_PROB:
        grid[H - 1, half] = frame2

    _fill_holes(grid, H, W, half, frame1, frame2, split, fill_pool)

    if np.any(grid < 0):
        return None, set()
    frame_set = {frame1}
    if frame2 != frame1:
        frame_set.add(frame2)
    return grid, frame_set


def _make_output() -> tuple[np.ndarray | None, int, set[int]]:
    """Select dims, build abstract output, then remap to real ARC colors."""
    H, W = random.choices(_VALID_DIMS, weights=_DIM_WEIGHTS, k=1)[0]
    out, abstract_fcs = _build_output(H, W)
    if out is None:
        return None, 0, set()
    bg = random.randint(0, 9)
    abstract = sorted(np.unique(out))
    available = [c for c in range(10) if c != bg]
    random.shuffle(available)
    if len(available) < len(abstract):
        return None, 0, set()
    cmap = {int(a): available[i] for i, a in enumerate(abstract)}
    real_fcs = {cmap[a] for a in abstract_fcs}
    return np.vectorize(lambda x: cmap[int(x)])(out), bg, real_fcs


def _extract_non_frame_patches(out, bg, fcs):
    """Extract non-frame piece patches from the output grid, sorted largest-first."""
    patches = []
    for col in sorted(map(int, np.unique(out))):
        if col in fcs:
            continue
        for pts in components_mask(out == col, connectivity=4):
            r0, c0, r1, c1 = bbox_coords(pts)
            patch = np.full((r1 - r0 + 1, c1 - c0 + 1), bg, dtype=int)
            for r, c in pts:
                patch[int(r) - r0, int(c) - c0] = col
            patches.append(patch)
    random.shuffle(patches)
    patches.sort(key=lambda p: (-(p != bg).sum(), random.random()))
    return patches


def _scatter(out: np.ndarray, bg: int, fcs: set[int]) -> np.ndarray:
    """Place pieces onto a canvas: frame as a group, non-frame scattered with padding."""
    rows = random.randint(_CANVAS_MIN, _CANVAS_MAX)
    cols = random.randint(_CANVAS_MIN, _CANVAS_MAX)
    canvas = np.full((rows, cols), bg, dtype=int)
    oh, ow = out.shape

    max_r = rows - oh - 2
    max_c = cols - ow - 2
    if max_r < 1 or max_c < 1:
        raise ValueError
    off_r = random.randint(1, max_r)
    off_c = random.randint(1, max_c)

    # Block the entire frame bbox so fill pieces stay outside the outline
    canvas[off_r:off_r + oh, off_c:off_c + ow] = -1

    # Scatter non-frame pieces into the area OUTSIDE the blocked bbox
    for patch in _extract_non_frame_patches(out, bg, fcs):
        r, c = random_free_location(canvas, patch, transparent=bg,
                                    padding=_SCATTER_PADDING, padding_connectivity=8)
        paste(canvas, patch, r, c, transparent=bg)

    # Replace blocked bbox with frame cells (non-frame positions revert to bg)
    frame_mask = np.zeros((oh, ow), dtype=bool)
    for col in fcs:
        frame_mask |= (out == col)
    bbox_region = canvas[off_r:off_r + oh, off_c:off_c + ow]
    bbox_region[:] = bg
    bbox_region[frame_mask] = out[frame_mask]
    return canvas


def _piece_count(out: np.ndarray) -> int:
    return sum(len(components_mask(out == col, connectivity=4)) for col in np.unique(out))


def _gen_attempt() -> np.ndarray | None:
    """Single generation attempt: build output, validate constraints, scatter, oracle check."""
    out, bg, fcs = _make_output()
    if out is None:
        return None
    if not np.array_equal(out, out[:, ::-1]):
        return None
    if not (_N_COLORS_MIN <= len(np.unique(out)) <= _N_COLORS_MAX):
        return None
    pc = _piece_count(out)
    if not (_PIECE_COUNT_MIN <= pc <= _PIECE_COUNT_MAX):
        return None
    if any(len(pts) > _MAX_PIECE_AREA for col in np.unique(out)
           for pts in components_mask(out == col, connectivity=4)):
        return None
    try:
        inp = _scatter(out, bg, fcs)
        got = main(inp)
    except Exception:
        return None
    if np.array_equal(got, out):
        return inp
    return None


def generate_input() -> np.ndarray:
    for _ in range(_GEN_MAX_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid e8686506 input")

    ```

    ## 原始任务规格（Spec）

    以下是从原始 solver 代码和示例中提炼的完整任务规格，包含精确的数值约束和生成策略。
    Spec 本身就是原题代码生成时的参考文件，因此：
    - 在**设计分析**阶段，参考 spec 理解原始任务的完整设计细节（对象结构、空间关系、生成策略等），以此为基础思考融合变体的改动如何落实
    - 在**实现**阶段，参考 spec 中的数值约束（网格尺寸、对象数量/尺寸、颜色数等），确保融合变体在物理上可实现

    ```yaml
    spec:
  task: assemble scattered jigsaw pieces into a LR-symmetric dense rectangle
  input_grid: 13-15 rows x 13-15 cols, single bg color fills most cells
  output_grid: H x W dense rectangle, H >= W (portrait), dims = closest-to-square factor pair of total piece area
  output_dims_observed: 5x5 (area=25) or 8x5 (area=40)
  output_symmetry: exact left-right mirror; UD symmetry NOT required
  pieces:
    connectivity: each piece is a single-color 8-connected component (NOT 4-connected)
    total_count: 9-17
    distinct_colors: 4-6
    area_per_piece: 1-6
    total_area: 25-40 [observed]; must have unique closest-to-square portrait factor pair
    shapes: rectangles, L/C/zigzag fragments; no rotation applied
    mirror_pairing: asymmetric pieces come in LR-mirror pairs (same color); self-symmetric pieces may appear alone or in matched counts
  frame_constraint: |
    REQUIRED: 1-2 pieces (8-connected) whose union bounding box = output rectangle dims (H x W)
    and whose union bitmap is LR-symmetric. These "frame" pieces outline the assembled
    rectangle via a zigzag contour. In the input, frame pieces are placed as a group
    preserving their relative positions from the output, so the rectangular outline is
    visually recognizable. Non-frame pieces are scattered freely.
  uniqueness: REQUIRED — the assembly must be solvable by pure constraint propagation
    (each step, every remaining piece has exactly one valid placement, or a batch
    where positions = copies). No backtracking needed. Frame locks most cells;
    irregular hole shapes force remaining pieces into unique positions.
  singletons_on_border: 1x1 pieces only appear on the output rectangle border [observed 100%]
  optional_anchors:
    corner_markers: 0-1 colors with exactly 4 singleton pixels -> placed at 4 output corners [observed in 2/3]
    h_bar_edges: 0-2 horizontal bars of width W-2 -> top/bottom edges between corners, ordered by input row [observed in 2/3]
    v_line_pairs: 0-1 colors with 2 identical vertical lines -> left/right edges centered vertically [observed in 2/3]
  input_scatter: pieces placed on bg grid with min Chebyshev distance 1 between any two pieces; no overlaps

generation_strategy:
  approach: output-first
  steps:
    1. Choose output dims H x W (H >= W, W odd so center column exists, area has unique closest-to-square portrait factorization).
    2. Generate frame via zigzag path on the Hx2 left-half grid (top-to-bottom,
       3 moves: down/horiz+down/diag). Mirror to right half. Optionally cap
       top/bottom center col if endpoint is at col 1. Optionally split frame
       into 2 colors (top/bottom halves) for visual variety.
    3. Frame divides the rectangle into hole regions (4-conn components of
       non-frame cells). Fill each hole with one color (split if >6 cells).
       This produces irregular pieces whose shapes match the hole contours.
    4. Mirror left half to right half for LR symmetry.
    5. Extract each 4-conn component as a piece. Validate: 9-17 pieces,
       area 1-6 each, 4-6 distinct colors, 1x1 pieces on border only.
    6. Scatter pieces onto 13-15 x 13-15 input grid. Frame pieces placed as
       a group at output-relative positions (bbox blocked to keep interior clean).
       Non-frame pieces scattered in remaining space.
    7. Validate: solver recovers output via pure constraint propagation.
    ```

额外要求：原始代码的 `main()` 已包含四段式说明注释/文档字符串（开头概述 + `Input structure:` + `Rule:` + `Key insight:`）。
生成的新代码里也必须在 `main()` 上方保留这一结构，并根据**融合后的新规则**与**原注释提供的信息**重新编写；可以借鉴原注释的组织方式，但**不要照抄原文**，要让内容准确反映融合后的输入结构、规则和关键洞察。


## 已有单变体参考代码

以下组成项已有单变体实现，可作为融合时的参考：

            ### 参考代码: D3/1

            文件: `/home/lixinyu/snap/new/ceshi/code/e8686506/D3/1/code.py`

            ```python
            # Variant of e8686506
# Dimension: D3 — 目标结构：拼合后的形状要求 (dst)
# Change: 拼合后形成一个紧凑的矩形复合体，所有碎片无间隙无重叠地拼成完整矩形... → 拼合后填入已有框架的洞中

from collections import Counter
import random

import numpy as np

from arc_utils import bbox_coords, components_mask, crop_bbox, get_bg, paste, random_free_location


# Design analysis
# a) 具体化与行为追踪:
#    - 原题: 输入只有散落碎片，solver 先从总面积推出一个密实矩形，再把全部碎片塞进去。
#    - 变体: 输入里额外出现一个已经摆正的大框架。它是唯一最大的单色 8 连通对象、左右对称，
#      并且 bbox 内保留若干背景色洞位；框架外散落着若干单色碎片。
#    - 具体执行差异: 原逻辑会对碎片总面积做因子分解得到 HxW 矩形；新逻辑不会再猜矩形尺寸，
#      而是先定位框架 bbox，把 bbox 内的背景色 4 连通分量直接当作目标洞槽，再去框架外找同形状碎片。
# b) 复杂度校准:
#    - 如果只是给旧矩形外面加一圈边框，洞是简单矩形，变化不明显；因此生成器使用“外边框 +
#      内部左右对称折线路径”把内部切分成多个不规则小洞，肉眼可见这是在填洞。
#    - 参考任务 67e490f4 的基线是“先识别洞，再做形状匹配”。这里采用同级别机制，但不允许旋转/翻转，
#      保持与原题一致的朝向约束。
# c) 隐式假设审查:
#    - 原 main() 依赖 `total_area -> 唯一矩形因子对`，在本变体中已失效，必须删除。
#    - 原 main() 的 corner/bar/vertical-line 约束都服务于矩形边界；洞填充时这些锚点没有稳定语义，
#      若保留会把内部洞位误判成边界位置，因此移除。
#    - 原 main() 默认 1x1 只能落在外边界；现在洞可以在框架内部，singleton 允许出现在内部小洞中。
# d) 放置合法性:
#    - 生成器先整块阻塞框架 bbox，再把碎片散落到外部，最后只把框架色画回 bbox，因此输入中洞里不会
#      预先混入碎片。
#    - 每个洞组件面积都限制在 1-8；每个碎片正是从某个洞组件裁下来的，因此不会越界、重叠，也不会匹配到
#      错误尺寸。
# e) 视觉可观察性:
#    - 输入明显包含一个大框架和其内部空洞，输出则是同一框架内部被外部碎片补满。
#    - 新规则不依赖颜色 id 的不可见排序；颜色只是随机重映射后的可见外观。
# f) 可视化整洁度:
#    - 框架始终保持单色大对象，碎片全部散落在框架外，结构层次清楚。
#    - 输出中框架色与填充色不重叠，洞组件之间由框架分隔，不会出现视觉混线。
# g) 颜色变化可推断性:
#    - 颜色不编码隐藏规则；人类只需要看“哪个外部形状填哪个内部洞”。
#    - 总颜色数控制在 4-6（含框架色），既有重复支撑，又不会太杂。
# h) 新的 solver 假设与 generator 对应保证:
#    - 假设存在唯一最大单色 8 连通框架组件；生成器用大单色框架且面积远大于任一碎片保证。
#    - 假设框架 bbox 内只有框架色与背景色；生成器通过 bbox 阻塞保证。
#    - 假设每个洞槽都有同形状外部碎片；生成器直接从洞槽裁出碎片，保证精确对应。
# i) 量化的变体判据:
#    - 对输入取最大单色 8 连通组件 bbox，统计其内部背景色数量 `hole_area`。本变体要求 `hole_area > 0`
#      且这些背景色不接触 bbox 边界；原题不存在这种“框架内留洞”的结构。测试阶段会统计这一指标。


def _piece_sig(pts: np.ndarray) -> tuple[int, int, tuple[tuple[int, int], ...]]:
    r0, c0, r1, c1 = bbox_coords(pts)
    coords = tuple(sorted((int(r) - r0, int(c) - c0) for r, c in pts))
    return (r1 - r0 + 1), (c1 - c0 + 1), coords


def _mirror_sig(sig: tuple[int, int, tuple[tuple[int, int], ...]]) -> tuple[int, int, tuple[tuple[int, int], ...]]:
    h, w, coords = sig
    mirrored = tuple(sorted((int(r), int(w) - 1 - int(c)) for r, c in coords))
    return int(h), int(w), mirrored


def main(grid: np.ndarray) -> np.ndarray:
    """
    Fill the holes of a symmetric frame using shape-matched scattered fragments.

    Input structure:
    - bg = most common color.
    - One large monochrome frame already sits in final position; it is LR-symmetric and encloses bg holes.
    - Outside the frame bbox are scattered monochrome fragments; each fragment matches one hole component exactly.

    Rule:
    - Detect the unique largest non-bg 8-connected component as the frame and crop to its bbox.
    - Split the bg cells inside that bbox into 4-connected hole components, and extract the outside fragments as 4-connected sprites.
    - For each hole component, find the outside sprite with the same shape and fill the hole with that sprite's color.

    Key insight: the frame removes the old “find the rectangle” step; now the task is to read the hole geometry from the fixed scaffold, then use the outside fragments as shape-coded color labels for those hole slots.
    """
    g = np.asarray(grid, dtype=int)
    bg = int(get_bg(g))

    frame_candidates: list[tuple[int, int, np.ndarray]] = []
    for col in sorted(set(map(int, np.unique(g))) - {bg}):
        for pts in components_mask(g == col, connectivity=8):
            frame_candidates.append((len(pts), int(col), np.array(pts, dtype=int)))

    assert frame_candidates, "input must contain a non-background frame"
    max_area = max(area for area, _, _ in frame_candidates)
    frame_choices = [(col, pts) for area, col, pts in frame_candidates if area == max_area]
    assert len(frame_choices) == 1, "frame must be the unique largest monochrome component"
    frame_col, frame_pts = frame_choices[0]

    r0, c0, r1, c1 = bbox_coords(frame_pts)
    sub = crop_bbox(g, (r0, c0, r1, c1))
    frame_mask = sub == int(frame_col)
    hole_mask = sub == int(bg)

    assert np.all(frame_mask | hole_mask), "frame bbox may only contain frame color and background"
    assert hole_mask.any(), "frame must contain at least one hole cell"
    assert not hole_mask[0].any() and not hole_mask[-1].any()
    assert not hole_mask[:, 0].any() and not hole_mask[:, -1].any()
    assert np.array_equal(frame_mask, frame_mask[:, ::-1]), "frame mask must be LR-symmetric"
    assert np.array_equal(hole_mask, hole_mask[:, ::-1]), "hole mask must be LR-symmetric"

    holes: list[tuple[tuple[int, int, tuple[tuple[int, int], ...]], np.ndarray]] = []
    for pts in components_mask(hole_mask, connectivity=4):
        arr = np.array(pts, dtype=int)
        holes.append((_piece_sig(arr), arr))

    outside = g.copy()
    outside[r0 : r1 + 1, c0 : c1 + 1] = int(bg)

    pieces_by_key: dict[tuple[int, int, tuple[tuple[int, int], ...]], Counter] = {}
    for col in sorted(set(map(int, np.unique(outside))) - {bg}):
        for pts in components_mask(outside == col, connectivity=4):
            key = _piece_sig(np.array(pts, dtype=int))
            bucket = pieces_by_key.setdefault(key, Counter())
            bucket[int(col)] += 1

    assert pieces_by_key, "input must contain scattered fill pieces outside the frame"

    out = np.full(sub.shape, int(frame_col), dtype=int)
    filled_area = 0
    for key, pts in holes:
        cmap = pieces_by_key.get(key)
        assert cmap is not None, "every hole shape must have a matching outside piece"
        fill_col = cmap.most_common(1)[0][0]
        out[pts[:, 0], pts[:, 1]] = int(fill_col)
        filled_area += len(pts)

    assert filled_area == int(hole_mask.sum())
    assert np.array_equal(out, out[:, ::-1]), "filled result must remain LR-symmetric"
    return out.astype(int)


# --------------- generator (D3 hole-fill) ---------------

_OUT_H_CHOICES = [8]
_OUT_W = 7

_N_COLORS_MIN = 4
_N_COLORS_MAX = 6
_FILL_COLOR_MIN = 3
_FILL_COLOR_MAX = 5

_MAX_PIECE_AREA = 8
_PIECE_COUNT_MIN = 4
_PIECE_COUNT_MAX = 9

_CANVAS_MIN = 13
_CANVAS_MAX = 15
_SCATTER_PADDING = 1

_FRAME_RETRIES = 120
_GEN_MAX_RETRIES = 400


def _zigzag_wall(H: int) -> tuple[set[tuple[int, int]], set[int]]:
    cells: set[tuple[int, int]] = set()
    visited_cols: set[int] = set()
    c = random.randint(1, 2)
    for r in range(1, H - 1):
        cells.add((r, c))
        visited_cols.add(c)
        if r == H - 2:
            break
        move = random.choice(["down", "horiz", "diag"])
        if move == "horiz":
            nc = 3 - c
            cells.add((r, nc))
            visited_cols.add(nc)
            c = nc
        elif move == "diag":
            c = 3 - c
    return cells, visited_cols


def _make_frame_mask(H: int, W: int) -> np.ndarray | None:
    for _ in range(_FRAME_RETRIES):
        frame = np.zeros((H, W), dtype=bool)
        frame[0, :] = True
        frame[H - 1, :] = True
        frame[:, 0] = True
        frame[:, W - 1] = True

        wall_left, used_cols = _zigzag_wall(H)
        if len(used_cols) < 2:
            continue

        for r, c in wall_left:
            frame[r, c] = True
            frame[r, W - 1 - c] = True

        hole_mask = ~frame
        if hole_mask[0].any() or hole_mask[-1].any() or hole_mask[:, 0].any() or hole_mask[:, -1].any():
            continue
        if not np.array_equal(frame, frame[:, ::-1]):
            continue

        holes = components_mask(hole_mask, connectivity=4)
        if not (_PIECE_COUNT_MIN <= len(holes) <= _PIECE_COUNT_MAX):
            continue
        if any(len(hole) > _MAX_PIECE_AREA for hole in holes):
            continue
        if len(holes) < _FILL_COLOR_MIN:
            continue
        return frame
    return None


def _build_output(H: int, W: int) -> tuple[np.ndarray | None, int]:
    frame_mask = _make_frame_mask(H, W)
    if frame_mask is None:
        return None, 0

    hole_mask = ~frame_mask
    holes = [np.array(h, dtype=int) for h in components_mask(hole_mask, connectivity=4)]
    if not (_PIECE_COUNT_MIN <= len(holes) <= _PIECE_COUNT_MAX):
        return None, 0
    if any(len(hole) > _MAX_PIECE_AREA for hole in holes):
        return None, 0

    shape_classes: dict[tuple[int, int, tuple[tuple[int, int], ...]], list[np.ndarray]] = {}
    for hole in holes:
        sig = _piece_sig(hole)
        canon = min(sig, _mirror_sig(sig))
        shape_classes.setdefault(canon, []).append(hole)

    if len(shape_classes) < _FILL_COLOR_MIN:
        return None, 0

    n_fill_colors = random.randint(_FILL_COLOR_MIN, min(_FILL_COLOR_MAX, len(shape_classes)))
    palette = list(range(1, n_fill_colors + 1))
    class_keys = list(shape_classes.keys())
    random.shuffle(class_keys)

    class_colors: dict[tuple[int, int, tuple[tuple[int, int], ...]], int] = {}
    for i, key in enumerate(class_keys):
        class_colors[key] = palette[i % len(palette)]

    out = np.zeros((H, W), dtype=int)
    frame_color = 0
    out[frame_mask] = frame_color
    for key, comps in shape_classes.items():
        col = int(class_colors[key])
        for pts in comps:
            out[pts[:, 0], pts[:, 1]] = col

    if np.any(hole_mask & (out == frame_color)):
        return None, 0
    if not np.array_equal(out, out[:, ::-1]):
        return None, 0
    if not (_N_COLORS_MIN <= len(np.unique(out)) <= _N_COLORS_MAX):
        return None, 0

    return out, frame_color


def _remap_colors(out: np.ndarray, frame_color: int) -> tuple[np.ndarray | None, int, int]:
    bg = random.randint(0, 9)
    abstract = sorted(map(int, np.unique(out)))
    available = [c for c in range(10) if c != bg]
    random.shuffle(available)
    if len(available) < len(abstract):
        return None, 0, 0
    cmap = {a: available[i] for i, a in enumerate(abstract)}
    return np.vectorize(lambda x: cmap[int(x)])(out), int(bg), int(cmap[frame_color])


def _extract_piece_patches(out: np.ndarray, bg: int, frame_col: int) -> list[np.ndarray]:
    patches = []
    for col in sorted(map(int, np.unique(out))):
        if col == frame_col:
            continue
        for pts in components_mask(out == col, connectivity=4):
            r0, c0, r1, c1 = bbox_coords(pts)
            patch = np.full((r1 - r0 + 1, c1 - c0 + 1), bg, dtype=int)
            for r, c in pts:
                patch[int(r) - r0, int(c) - c0] = int(col)
            patches.append(patch)
    random.shuffle(patches)
    patches.sort(key=lambda p: (-(p != bg).sum(), random.random()))
    return patches


def _scatter_input(out: np.ndarray, bg: int, frame_col: int) -> np.ndarray:
    rows = random.randint(_CANVAS_MIN, _CANVAS_MAX)
    cols = random.randint(_CANVAS_MIN, _CANVAS_MAX)
    canvas = np.full((rows, cols), bg, dtype=int)
    oh, ow = out.shape

    max_r = rows - oh - 2
    max_c = cols - ow - 2
    if max_r < 1 or max_c < 1:
        raise ValueError("canvas too small for frame")
    off_r = random.randint(1, max_r)
    off_c = random.randint(1, max_c)

    canvas[off_r : off_r + oh, off_c : off_c + ow] = -1

    for patch in _extract_piece_patches(out, bg, frame_col):
        r, c = random_free_location(
            canvas,
            patch,
            transparent=bg,
            padding=_SCATTER_PADDING,
            padding_connectivity=8,
        )
        paste(canvas, patch, r, c, transparent=bg)

    region = canvas[off_r : off_r + oh, off_c : off_c + ow]
    region[:] = bg
    frame_mask = out == int(frame_col)
    region[frame_mask] = out[frame_mask]
    return canvas


def _non_frame_piece_count(out: np.ndarray, frame_col: int) -> int:
    return sum(
        len(components_mask(out == int(col), connectivity=4))
        for col in np.unique(out)
        if int(col) != int(frame_col)
    )


def _gen_attempt() -> np.ndarray | None:
    H = random.choice(_OUT_H_CHOICES)
    W = _OUT_W

    abstract_out, frame_abstract = _build_output(H, W)
    if abstract_out is None:
        return None

    out, bg, frame_col = _remap_colors(abstract_out, frame_abstract)
    if out is None:
        return None

    pc = _non_frame_piece_count(out, frame_col)
    if not (_PIECE_COUNT_MIN <= pc <= _PIECE_COUNT_MAX):
        return None

    try:
        inp = _scatter_input(out, bg, frame_col)
        got = main(inp)
    except Exception:
        return None

    if np.array_equal(got, out):
        return inp
    return None


def generate_input() -> np.ndarray:
    for _ in range(_GEN_MAX_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid e8686506 D3 input")

            ```

            ### 参考代码: D13/0

            文件: `/home/lixinyu/snap/new/ceshi/code/e8686506/D13/0/code.py`

            ```python
            # Variant of e8686506
# Dimension: D13 — 背景与前景的关系 (meta)
# Change: 输入使用单一背景色，所有非背景像素都是有效碎片的一部分... → 双色背景（分区背景）
#
# Design analysis
# ----------------
# spec:
#   invariant_output:
#     - 输出仍然是一个严格左右镜像的 HxW 稠密矩形。
#     - HxW 仍由总碎片面积的“最接近正方形且唯一的竖向因子对”确定。
#     - 原题的框架碎片、角点/边条锚点、同色碎片不可 4 邻接等约束继续保留。
#   d13_change:
#     - 输入不再只有一个背景色，而是整张画布按竖直分界线切成左右两个背景区域。
#     - 左区和右区分别用两种不同背景色填充；碎片覆盖在各自区域之上。
#     - 非框架碎片按其在输出中的左右归属散布：左半来源的碎片进左背景区，右半来源的碎片进右背景区；
#       跨中心列的自对称碎片在两区之间分配。这样人眼能看到“背景分区”和“碎片归属”。
#   concrete_behavior_trace:
#     - 原题流程：`get_bg()` 取全局最多颜色，剩余颜色全部当碎片。
#     - 本变体里，如果仍这么做，那么较少的那种背景色会被误识别成一大块“碎片”，后续面积、框架检测都会崩。
#     - 新流程：先从保持纯背景的顶行/底行读出左右背景色与分界列，再只把“位于左区且不等于左背景色”、
#       “位于右区且不等于右背景色”的像素当作前景碎片。
#   complexity_calibration:
#     - 只引入一种稳定、可见的背景分区模式：竖直二分。避免出现多种分区几何导致 2-3 个样例无法归纳。
#     - 两种背景色都必须大面积可见，且两区都要放到碎片，防止退化成“只是换了一个角落颜色”。
#     - 输出规则不改，避免把 D13 和形状变换、颜色映射等别的维度混在一起。
#   implicit_assumptions_audit:
#     - 原 `bg = get_bg(g)` 依赖“背景唯一且最多”；在本变体中失效，必须改成分区背景检测。
#     - 原 `for col in unique(g) if col != bg` 依赖“除 bg 外全是碎片色”；现在要改成“排除两个区域背景色”。
#     - 原 8 连通框架搜索默认所有非 bg 颜色都是真碎片；现在若不先过滤右侧背景色，会把整块背景并入候选。
#     - 原 generator 默认整张 canvas 统一填一个 bg；现在必须改成先铺双色背景，再分别在左右子画布中找空位。
#   placement_legality:
#     - 外边框保留 1 像素纯背景带，因此顶行/底行一定完整暴露分区背景，solver 可稳定检测分界。
#     - 非框架碎片只在所属区域内散布，且仍使用 `random_free_location(..., padding=1)` 保证不重叠且保持间隔。
#     - 框架碎片组仍作为整体放置，bbox 位置合法且不越界；非框架碎片仍被禁止放进框架 bbox。
#   visual_observability:
#     - 人类会直接看到输入被两种背景色竖向切成两半，而且两边都各自散落了拼图块。
#     - 输出没有背景，只保留拼装后的矩形，因此规则可理解为“忽略两块背景，把两边碎片共同拼回去”。
#   cleanliness_and_color_inference:
#     - 背景色绝不复用为碎片色，避免“这个颜色到底是背景还是碎片”。
#     - 只有两种背景色，且它们形成连续大区域，视觉上整洁，不会与碎片层混杂成噪声。

from __future__ import annotations

import sys
import random
from collections import Counter

import numpy as np

_SOLVER_DIR = "/home/lixinyu/snap/new/solvers"
if _SOLVER_DIR not in sys.path:
    sys.path.append(_SOLVER_DIR)

from arc_utils import bbox_coords, components_mask, paste, random_free_location


def _piece_sig(pts: np.ndarray) -> tuple[int, int, tuple[tuple[int, int], ...]]:
    r0, c0, r1, c1 = bbox_coords(pts)
    coords = tuple(sorted((int(r) - r0, int(c) - c0) for r, c in pts))
    return (r1 - r0 + 1), (c1 - c0 + 1), coords


def _factors(n: int) -> list[tuple[int, int]]:
    out = []
    for w in range(1, n + 1):
        if n % w == 0:
            h = n // w
            out.append((h, w))
    return out


def _detect_partition_background(g: np.ndarray) -> tuple[int, int, int, np.ndarray]:
    H, W = g.shape
    assert H >= 3 and W >= 3, "grid must be large enough for a visible 2-zone background"

    top = list(map(int, g[0]))
    bottom = list(map(int, g[H - 1]))
    left_bg = int(top[0])
    right_bg = int(top[W - 1])
    assert left_bg != right_bg, "dual-background variant requires two distinct background colors"

    changes = [c for c in range(1, W) if int(top[c - 1]) != int(top[c])]
    assert len(changes) == 1, "top border must reveal a single vertical background split"
    split = int(changes[0])
    assert 1 <= split <= W - 1, "background split must separate the canvas into two non-empty zones"
    assert all(int(v) == left_bg for v in top[:split]), "top-left zone must be uniformly background-colored"
    assert all(int(v) == right_bg for v in top[split:]), "top-right zone must be uniformly background-colored"
    assert all(int(v) == left_bg for v in bottom[:split]), "bottom-left zone must preserve the left background color"
    assert all(int(v) == right_bg for v in bottom[split:]), "bottom-right zone must preserve the right background color"

    bg_mask = np.zeros_like(g, dtype=bool)
    bg_mask[:, :split] = (g[:, :split] == left_bg)
    bg_mask[:, split:] = (g[:, split:] == right_bg)
    return split, left_bg, right_bg, bg_mask


def _build_requirements(
    H: int,
    W: int,
    comps_by_color: dict[int, list[list[tuple[int, int]]]],
) -> np.ndarray:
    req = np.full((H, W), -1, dtype=int)

    corner_colors = [
        col
        for col, comps in comps_by_color.items()
        if len(comps) == 4 and all(len(p) == 1 for p in comps)
    ]
    assert len(corner_colors) <= 1, "corner singleton color must be unique when present"
    corner_color = corner_colors[0] if corner_colors else None
    if corner_color is not None:
        req[0, 0] = corner_color
        req[0, W - 1] = corner_color
        req[H - 1, 0] = corner_color
        req[H - 1, W - 1] = corner_color

    bar_colors: list[tuple[int, int]] = []
    if W >= 3 and corner_color is not None:
        for col, comps in comps_by_color.items():
            for pts in comps:
                r0, c0, r1, c1 = bbox_coords(pts)
                hh, ww = r1 - r0 + 1, c1 - c0 + 1
                if hh == 1 and ww == (W - 2) and len(pts) == ww:
                    bar_colors.append((r0, col))
                    break
        if bar_colors:
            assert len(bar_colors) <= 2, "horizontal edge bar colors must be top/bottom only"
            bar_colors.sort()
            top_col = bar_colors[0][1]
            bot_col = bar_colors[-1][1]
            req[0, 1 : W - 1] = top_col
            req[H - 1, 1 : W - 1] = bot_col

    vertical_line_candidates = []
    for col, comps in comps_by_color.items():
        if len(comps) != 2:
            continue
        sigs = [_piece_sig(pts) for pts in comps]
        (h0, w0, coords0), (h1, w1, coords1) = sigs[0], sigs[1]
        if w0 == 1 and w1 == 1 and h0 == h1 and coords0 == coords1 and h0 > 1:
            vertical_line_candidates.append((col, h0))
    assert len(vertical_line_candidates) <= 1, "paired vertical edge-line color must be unique when present"
    if vertical_line_candidates:
        col, L = vertical_line_candidates[0]
        top = (H - L) // 2
        assert 0 <= top and top + L <= H, "paired vertical edge lines must fit in the output height"
        req[top : top + L, 0] = col
        req[top : top + L, W - 1] = col

    return req


def _assemble(
    types: list[dict],
    H: int,
    W: int,
    req: np.ndarray,
    disallow_touch: set[int] | None = None,
) -> np.ndarray:
    board = np.full((H, W), -1, dtype=int)
    counts = [int(t["cnt"]) for t in types]

    def mirror_ok(r: int, c: int, col: int) -> bool:
        mc = W - 1 - c
        v = board[r, mc]
        return (v == -1) or (v == col)

    def can_place(ti: int, r0: int, c0: int) -> bool:
        t = types[ti]
        col = int(t["col"])
        is_singleton = len(t["coords"]) == 1
        for dr, dc in t["coords"]:
            r, c = r0 + dr, c0 + dc
            if board[r, c] != -1:
                return False
            if req[r, c] != -1 and int(req[r, c]) != col:
                return False
            if not mirror_ok(r, c, col):
                return False
            if is_singleton and not (r == 0 or r == H - 1 or c == 0 or c == W - 1):
                return False
            if disallow_touch and col in disallow_touch:
                for rr, cc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
                    if 0 <= rr < H and 0 <= cc < W and board[rr, cc] == col:
                        return False
        return True

    def place(ti: int, r0: int, c0: int) -> None:
        t = types[ti]
        col = int(t["col"])
        for dr, dc in t["coords"]:
            r, c = r0 + dr, c0 + dc
            board[r, c] = col

    def placements_for(ti: int) -> list[tuple[int, int]]:
        t = types[ti]
        return [
            (r0, c0)
            for r0 in range(H - int(t["h"]) + 1)
            for c0 in range(W - int(t["w"]) + 1)
            if can_place(ti, r0, c0)
        ]

    changed = True
    while changed:
        changed = False
        for ti in range(len(types)):
            if counts[ti] <= 0:
                continue
            places = placements_for(ti)
            assert len(places) > 0, "assembly dead end: a piece has no valid placement"
            if len(places) == 1:
                counts[ti] -= 1
                place(ti, places[0][0], places[0][1])
                changed = True
            elif len(places) == counts[ti]:
                for r0, c0 in places:
                    counts[ti] -= 1
                    place(ti, r0, c0)
                changed = True
    assert all(c == 0 for c in counts), "assembly not purely propagation-solvable"
    assert np.array_equal(board, board[:, ::-1]), "assembled board must be LR-symmetric"
    return board


def main(grid: np.ndarray) -> np.ndarray:
    """
    Reassemble scattered fragments into one dense rectangle with exact left-right symmetry.

    Input structure:
    - The canvas background is split into two vertical regions, each with its own background color.
    - Colored fragments are scattered across both regions; 1-2 8-connected frame pieces still preserve the output bbox.
    - Optional anchors keep their old semantics: four singletons can mark corners, long bars can mark top/bottom edges, and a paired vertical line color can mark left/right edges.

    Rule:
    - Detect the two background zones first, then ignore only the pixels that match the proper background color of their zone.
    - Treat every remaining monochromatic 4-connected component as a puzzle piece and infer the output size from total foreground area.
    - Assemble all pieces into a portrait rectangle whose bitmap is exactly LR-mirrored and whose same-color pieces do not become 4-neighbors.

    Key insight:
    - The variant changes foreground extraction, not the assembly rule: the solver must separate two large background slabs from true fragments before running the original symmetry-and-frame logic.
    """
    g = np.asarray(grid, dtype=int)
    _split, _left_bg, _right_bg, bg_mask = _detect_partition_background(g)

    comps_by_color: dict[int, list[list[tuple[int, int]]]] = {}
    pieces = []
    color_piece_count: dict[int, int] = {}

    piece_colors = sorted(set(map(int, np.unique(g[~bg_mask]))))
    for col in piece_colors:
        comps = components_mask((g == col) & (~bg_mask), connectivity=4)
        comps_by_color[col] = comps
        color_piece_count[col] = len(comps)
        for pts in comps:
            _, _, coords = _piece_sig(pts)
            pieces.append((col, coords))

    ctr = Counter(pieces)
    types = []
    for (col, coords), cnt in sorted(ctr.items(), key=lambda kv: (-len(kv[0][1]), kv[0][0], kv[0][1])):
        arr = np.array(coords, dtype=int)
        h = int(arr[:, 0].max() + 1)
        w = int(arr[:, 1].max() + 1)
        types.append({"col": int(col), "coords": coords, "h": h, "w": w, "cnt": int(cnt)})

    total_area = sum(int(t["cnt"]) * len(t["coords"]) for t in types)
    assert total_area > 0, "total_area must be positive: grid must contain non-background pieces"

    dims = [(h, w) for (h, w) in _factors(total_area) if h >= w]
    assert dims, "at least one portrait factor pair must exist for the total piece area"
    best_gap = min(abs(h - w) for h, w in dims)
    best_dims = [(h, w) for h, w in dims if abs(h - w) == best_gap]
    assert len(best_dims) == 1, "closest-to-square portrait output shape must be unique"
    H, W = best_dims[0]

    comps8_all = []
    for col in piece_colors:
        for pts in components_mask((g == col) & (~bg_mask), connectivity=8):
            comps8_all.append((int(col), pts))

    def _is_lr_symmetric(parts: list[tuple[int, np.ndarray]], h: int, w: int) -> bool:
        all_pts = np.concatenate([p for _, p in parts])
        r0, c0 = int(all_pts[:, 0].min()), int(all_pts[:, 1].min())
        bmp = np.zeros((h, w), dtype=bool)
        for _, pts in parts:
            for r, c in pts:
                bmp[int(r) - r0, int(c) - c0] = True
        return np.array_equal(bmp, bmp[:, ::-1])

    frame_parts: list[tuple[int, np.ndarray]] = []
    for i, (c1, p1) in enumerate(comps8_all):
        r0, c0, r1, c1b = bbox_coords(p1)
        if r1 - r0 + 1 == H and c1b - c0 + 1 == W and _is_lr_symmetric([(c1, p1)], H, W):
            frame_parts = [(c1, p1)]
            break
        for j in range(i + 1, len(comps8_all)):
            c2, p2 = comps8_all[j]
            union = np.concatenate([p1, p2])
            ur0, uc0, ur1, uc1 = bbox_coords(union)
            if ur1 - ur0 + 1 == H and uc1 - uc0 + 1 == W and _is_lr_symmetric([(c1, p1), (c2, p2)], H, W):
                frame_parts = [(c1, p1), (c2, p2)]
                break
        if frame_parts:
            break
    assert frame_parts, "input must contain 1-2 LR-symmetric pieces (8-conn) whose union bbox equals output dims"

    req = _build_requirements(H, W, comps_by_color)

    all_frame_pts = np.concatenate([p for _, p in frame_parts])
    fr0, fc0 = int(all_frame_pts[:, 0].min()), int(all_frame_pts[:, 1].min())
    for col, pts in frame_parts:
        for r, c in pts:
            or_, oc = int(r) - fr0, int(c) - fc0
            if 0 <= or_ < H and 0 <= oc < W:
                req[or_, oc] = col

    disallow_touch = {col for col, n in color_piece_count.items() if n > 1}
    sol = _assemble(types, H, W, req, disallow_touch)
    return sol.astype(int)


# --------------- generator (o5x, D13 variant) ---------------

_AREA_MIN = 25
_AREA_MAX = 50
_WIDTH_REQUIRED = 5
_HEIGHT_MAX = 10

_N_COLORS_MIN = 4
_N_COLORS_MAX = 6
_TWO_FRAME_MIN_H = 6
_TWO_FRAME_MIN_COLORS = 5
_TWO_FRAME_PROB = 0.35
_CENTER_CAP_PROB = 0.5

_MAX_PIECE_AREA = 6
_MAX_CHUNK_SIZE = 6
_PIECE_COUNT_MIN = 9
_PIECE_COUNT_MAX = 17

_CANVAS_MIN = 13
_CANVAS_MAX = 15
_SCATTER_PADDING = 1
_OUTER_BORDER = 1

_GEN_MAX_RETRIES = 1000


def _valid_dims():
    results = []
    for area in range(_AREA_MIN, _AREA_MAX + 1):
        dims = [(area // w, w) for w in range(1, area + 1) if area % w == 0 and area // w >= w]
        best_gap = min(abs(h - w) for h, w in dims)
        best = [(h, w) for h, w in dims if abs(h - w) == best_gap]
        if len(best) == 1:
            h, w = best[0]
            if w == _WIDTH_REQUIRED and h <= _HEIGHT_MAX:
                results.append((h, w))
    return results


_VALID_DIMS = _valid_dims()
_DIM_WEIGHTS = [h * w for h, w in _VALID_DIMS]


def _zigzag_frame(H: int) -> tuple[set[tuple[int, int]], int, int]:
    cells = set()
    start_c = random.randint(0, 1)
    c = start_c
    for r in range(H):
        cells.add((r, c))
        if r == H - 1:
            break
        move = random.choice(["down", "horiz", "diag"])
        if move == "down":
            pass
        elif move == "horiz":
            cells.add((r, 1 - c))
            c = 1 - c
        else:
            c = 1 - c
    return cells, start_c, c


def _fill_holes(grid: np.ndarray, H: int, W: int, frame1: int, frame2: int, split: int, fill_pool: list[int]) -> None:
    holes = components_mask(grid == -1, connectivity=4)
    prev_col = None
    for hole in holes:
        cells = sorted((int(r), int(c)) for r, c in hole)
        chunks = [cells[i : i + _MAX_CHUNK_SIZE] for i in range(0, len(cells), _MAX_CHUNK_SIZE)]
        for chunk in chunks:
            fc_set = {frame1 if r < split else frame2 for r, _ in chunk}
            avoid = fc_set | ({prev_col} if prev_col is not None else set())
            opts = [f for f in fill_pool if f not in avoid]
            if not opts:
                opts = [f for f in fill_pool if f not in fc_set] or fill_pool
            col = random.choice(opts)
            for r, c in chunk:
                grid[r, c] = col
                grid[r, W - 1 - c] = col
            prev_col = col


def _build_output(H: int, W: int) -> tuple[np.ndarray | None, set[int]]:
    half = W // 2
    n_colors = random.randint(_N_COLORS_MIN, _N_COLORS_MAX)
    palette = list(range(n_colors))
    random.shuffle(palette)

    use_two_frames = (
        H >= _TWO_FRAME_MIN_H
        and n_colors >= _TWO_FRAME_MIN_COLORS
        and random.random() < _TWO_FRAME_PROB
    )
    ci = 0
    frame1 = palette[ci]
    ci += 1
    frame2 = frame1
    if use_two_frames:
        frame2 = palette[ci]
        ci += 1
    fill_pool = palette[ci:]
    if not fill_pool:
        return None, set()

    frame_half, start_c, end_c = _zigzag_frame(H)
    split = H // 2 if frame1 != frame2 else H

    grid = np.full((H, W), -1, dtype=int)
    for r, c in frame_half:
        fc = frame1 if r < split else frame2
        grid[r, c] = fc
        grid[r, W - 1 - c] = fc

    if start_c == 1 and random.random() < _CENTER_CAP_PROB:
        grid[0, half] = frame1
    if end_c == 1 and random.random() < _CENTER_CAP_PROB:
        grid[H - 1, half] = frame2

    _fill_holes(grid, H, W, frame1, frame2, split, fill_pool)

    if np.any(grid < 0):
        return None, set()
    frame_set = {frame1}
    if frame2 != frame1:
        frame_set.add(frame2)
    return grid, frame_set


def _make_output() -> tuple[np.ndarray | None, int, int, set[int]]:
    H, W = random.choices(_VALID_DIMS, weights=_DIM_WEIGHTS, k=1)[0]
    out, abstract_fcs = _build_output(H, W)
    if out is None:
        return None, 0, 0, set()

    bg_left, bg_right = random.sample(list(range(10)), 2)
    abstract = sorted(np.unique(out))
    available = [c for c in range(10) if c not in {bg_left, bg_right}]
    random.shuffle(available)
    if len(available) < len(abstract):
        return None, 0, 0, set()
    cmap = {int(a): available[i] for i, a in enumerate(abstract)}
    real_fcs = {cmap[a] for a in abstract_fcs}
    remapped = np.vectorize(lambda x: cmap[int(x)])(out).astype(int)
    return remapped, int(bg_left), int(bg_right), real_fcs


def _classify_patch_side(pts: np.ndarray, W: int) -> str:
    center = W // 2
    cols = [int(c) for _, c in pts]
    if max(cols) < center:
        return "left"
    if min(cols) > center:
        return "right"
    return "center"


def _extract_non_frame_patches(out: np.ndarray, bg: int, fcs: set[int]) -> list[dict]:
    patches = []
    W = out.shape[1]
    for col in sorted(map(int, np.unique(out))):
        if col in fcs:
            continue
        for pts in components_mask(out == col, connectivity=4):
            r0, c0, r1, c1 = bbox_coords(pts)
            patch = np.full((r1 - r0 + 1, c1 - c0 + 1), bg, dtype=int)
            for r, c in pts:
                patch[int(r) - r0, int(c) - c0] = col
            patches.append(
                {
                    "patch": patch,
                    "side": _classify_patch_side(pts, W),
                    "area": int((patch != bg).sum()),
                }
            )
    random.shuffle(patches)
    patches.sort(key=lambda item: (-item["area"], random.random()))
    return patches


def _place_patch_in_zone(canvas: np.ndarray, patch: np.ndarray, bg: int, c_start: int, c_end: int) -> None:
    sub = canvas[:, c_start:c_end]
    r, c = random_free_location(
        sub,
        patch,
        transparent=bg,
        border=_OUTER_BORDER,
        padding=_SCATTER_PADDING,
        padding_connectivity=8,
    )
    paste(canvas, patch, r, c_start + c, transparent=bg)


def _scatter(out: np.ndarray, bg_left: int, bg_right: int, fcs: set[int]) -> np.ndarray:
    rows = random.randint(_CANVAS_MIN, _CANVAS_MAX)
    cols = random.randint(_CANVAS_MIN, _CANVAS_MAX)
    split = cols // 2
    assert 2 <= split <= cols - 2, "canvas must have room for both background zones"

    canvas = np.full((rows, cols), bg_right, dtype=int)
    canvas[:, :split] = bg_left
    oh, ow = out.shape

    min_r = _OUTER_BORDER
    max_r = rows - oh - _OUTER_BORDER
    off_r = random.randint(min_r, max_r)

    # Keep the frame group centered around the zone split so both background slabs remain visible.
    off_c = split - (ow // 2) - 1
    if off_c < _OUTER_BORDER or off_c + ow > cols - _OUTER_BORDER:
        raise ValueError("frame bbox cannot straddle the background split on this canvas")

    canvas[off_r : off_r + oh, off_c : off_c + ow] = -1

    center_toggle = False
    for item in _extract_non_frame_patches(out, bg_left, fcs):
        patch = item["patch"]
        side = item["side"]
        if side == "left":
            _place_patch_in_zone(canvas, patch, bg_left, 0, split)
        elif side == "right":
            patch = np.where(patch == bg_left, bg_right, patch)
            _place_patch_in_zone(canvas, patch, bg_right, split, cols)
        else:
            if center_toggle:
                patch = np.where(patch == bg_left, bg_right, patch)
                _place_patch_in_zone(canvas, patch, bg_right, split, cols)
            else:
                _place_patch_in_zone(canvas, patch, bg_left, 0, split)
            center_toggle = not center_toggle

    frame_mask = np.zeros((oh, ow), dtype=bool)
    for col in fcs:
        frame_mask |= (out == col)
    bbox_region = canvas[off_r : off_r + oh, off_c : off_c + ow]
    left_cols = max(0, min(split - off_c, ow))
    if left_cols > 0:
        bbox_region[:, :left_cols] = bg_left
    if left_cols < ow:
        bbox_region[:, left_cols:] = bg_right
    bbox_region[frame_mask] = out[frame_mask]
    return canvas


def _piece_count(out: np.ndarray) -> int:
    return sum(len(components_mask(out == col, connectivity=4)) for col in np.unique(out))


def _gen_attempt() -> np.ndarray | None:
    out, bg_left, bg_right, fcs = _make_output()
    if out is None:
        return None
    if not np.array_equal(out, out[:, ::-1]):
        return None
    if not (_N_COLORS_MIN <= len(np.unique(out)) <= _N_COLORS_MAX):
        return None
    pc = _piece_count(out)
    if not (_PIECE_COUNT_MIN <= pc <= _PIECE_COUNT_MAX):
        return None
    if any(len(pts) > _MAX_PIECE_AREA for col in np.unique(out) for pts in components_mask(out == col, connectivity=4)):
        return None
    try:
        inp = _scatter(out, bg_left, bg_right, fcs)
        got = main(inp)
    except Exception:
        return None
    if np.array_equal(got, out):
        return inp
    return None


def generate_input() -> np.ndarray:
    for _ in range(_GEN_MAX_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid e8686506 D13 input")

