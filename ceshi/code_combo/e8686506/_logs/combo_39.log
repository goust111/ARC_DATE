_OUT_H_CHOICES = [8, 9, 10]
_OUT_W = 9
_CHAMBER_W = 3

_N_COLORS_MIN = 4
_N_COLORS_MAX = 6
_FILL_COLOR_MIN = 3
_FILL_COLOR_MAX = 5

_HOLE_PAIR_MIN = 3
_HOLE_PAIR_MAX = 5
