+    r0, c0, _, _ = bbox_coords(pts)
+    return {(int(r) - r0, int(c) - c0) for r, c in pts}
+
+
+def _find_diagonal_anchor(
+    comps8_all: list[tuple[int, np.ndarray]],
+    n: int,
+) -> tuple[int, np.ndarray]:
+    target = {(i, i) for i in range(n)}
+    matches = []
+    for col, pts in comps8_all:
