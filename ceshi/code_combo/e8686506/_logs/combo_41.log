+    if _piece_count(inp, bg) != 36:
+        return None
+    if _bbox_half_hint_score(inp) != 1.0:
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(_GEN_MAX_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
