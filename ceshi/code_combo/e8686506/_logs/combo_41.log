+
+
+def _piece_count(grid: np.ndarray, bg: int) -> int:
+    return sum(
+        len(components_mask(grid == col, connectivity=4))
+        for col in np.unique(grid)
+        if int(col) != bg
+    )
+
+
+def _bbox_half_hint_score(inp: np.ndarray) -> float:
