+        for c in range(_N):
+            if r == c or (r + c) % 2 != _ANCHOR_PARITY:
+                continue
+            if side == "upper" and r < c:
+                mask[r, c] = True
+            if side == "lower" and r > c:
+                mask[r, c] = True
