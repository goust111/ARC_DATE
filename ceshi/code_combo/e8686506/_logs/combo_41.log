+            if (r < c and int(bbox[c, r]) == bg) or (r > c and int(bbox[c, r]) == bg):
+                same_side += 1
+            else:
+                mirror_side += 1
+    total = same_side + mirror_side
+    return 0.0 if total == 0 else same_side / total
