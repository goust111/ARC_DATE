+        return None
+    try:
+        base_inp, noise_count = _scatter_base(out, bg, fcs)
+        if noise_count < _NOISE_MIN:
+            return None
+        inp, _grid_col = _overlay_grid(base_inp)
+        got = main(inp)
+    except Exception:
+        return None
+    if np.array_equal(got, out):
+        return inp
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(_GEN_MAX_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
