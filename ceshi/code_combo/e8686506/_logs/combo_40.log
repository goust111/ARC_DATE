   306	def _best_assignment(srcs: list[dict], dsts: list[dict]) -> list[tuple[dict, dict]]:
   307	    assert len(srcs) == len(dsts)
   308	    if len(srcs) <= 1:
   309	        return list(zip(srcs, dsts))
   310	
   311	    srcs = sorted(srcs, key=lambda rec: rec["anchor"])
   312	    dsts = sorted(dsts, key=lambda rec: rec["anchor"])
   313	    best_perm = None
   314	    best_score = None
   315	    for perm in itertools.permutations(range(len(dsts))):
   316	        score = 0
   317	        for i, j in enumerate(perm):
   318	            sr, sc = srcs[i]["anchor"]
   319	            tr, tc = dsts[j]["anchor"]
   320	            score += (sr - tr) ** 2 + (sc - tc) ** 2
   321	        tie = tuple(dsts[j]["anchor"] for j in perm)
   322	        full_score = (score, tie)
   323	        if best_score is None or full_score < best_score:
   324	            best_score = full_score
   325	            best_perm = perm
   326	    assert best_perm is not None
   327	    return [(srcs[i], dsts[j]) for i, j in enumerate(best_perm)]
