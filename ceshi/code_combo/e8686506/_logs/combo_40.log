   348	def _line_cells(a: tuple[int, int], b: tuple[int, int]) -> list[tuple[int, int]]:
   349	    """Integer Bresenham raster line including both endpoints."""
   350	    r0, c0 = a
   351	    r1, c1 = b
   352	    dr = abs(r1 - r0)
   353	    dc = abs(c1 - c0)
   354	    sr = 1 if r0 < r1 else -1
   355	    sc = 1 if c0 < c1 else -1
   356	    err = dr - dc
   357	    out = []
   358	    r, c = r0, c0
   359	    while True:
   360	        out.append((r, c))
   361	        if r == r1 and c == c1:
   362	            break
   363	        e2 = 2 * err
   364	        if e2 > -dc:
   365	            err -= dc
   366	            r += sr
   367	        if e2 < dr:
   368	            err += dr
   369	            c += sc
   370	    return out
