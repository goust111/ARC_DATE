   402	def main(grid: np.ndarray) -> np.ndarray:
   403	    """
   404	    Assemble the scattered fragments into the hidden symmetric rectangle, but keep the full canvas and show each fragment's movement path.
   405	
   406	    Input structure:
   407	    - The background is the most frequent color.
   408	    - Non-background 4-connected fragments are the movable pieces; one 8-connected LR-symmetric frame group already sits at the rectangle's final canvas location.
   409	    - Optional anchors from the base task still appear: 4 singleton corners, horizontal edge bars, and paired vertical side lines.
   410	
   411	    Rule:
   412	    - Recover the compact left-right symmetric rectangle exactly as in the base assembly task.
   413	    - Place that solved rectangle back onto the input-sized canvas at the frame group's original bounding box.
   414	    - For every fragment, connect its discrete center anchor at the source location to the matching anchor in the assembled rectangle using a straight line in the fragment's color.
   415	
   416	    Key insight: the puzzle still solves in compact rectangle coordinates first; the new work is to lift that compact solution back into the original canvas frame and pair equal-shaped fragments with their assembled copies so their motion can be drawn.
   417	    """
   418	    compact, bg, fr0, fc0 = _solve_compact(grid)
   419	    out, _ = _render_variant(grid, compact, bg, fr0, fc0)
   420	    return out.astype(int)
