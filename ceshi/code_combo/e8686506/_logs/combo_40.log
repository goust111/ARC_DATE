   391	            sr, sc = src["anchor"]
   392	            tr, tc = dst["anchor"]
   393	            total_dist2 += (sr - tr) ** 2 + (sc - tc) ** 2
   394	        for r, c in _line_cells(src["anchor"], dst["anchor"]):
   395	            out[r, c] = src["col"]
   396	            path_cells.add((r, c))
