   393	    bg = get_bg(g)
   394	
   395	    total_area = int((g != bg).sum())
   396	    assert total_area > 0, "grid must contain non-background pieces"
   397	
   398	    dims = [(h, w) for h, w in _factors(total_area) if h >= w]
   399	    assert dims, "at least one portrait factor pair must exist"
   400	    best_gap = min(abs(h - w) for h, w in dims)
   401	    best_dims = [(h, w) for h, w in dims if abs(h - w) == best_gap]
   402	    assert len(best_dims) == 1, "closest-to-square portrait output shape must be unique"
