   408	    color_piece_count: dict[int, int] = {}
   409	    for col in sorted(set(map(int, np.unique(g))) - {bg}):
   410	        comps = components_mask(g == col, connectivity=4)
   411	        comps_by_color[int(col)] = comps
   412	        color_piece_count[int(col)] = len(comps)
