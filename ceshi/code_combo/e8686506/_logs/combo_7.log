   331	def _assign_family_colors(families: list, adjacency: dict, frame_adj: dict) -> dict | None:
   332	    assignment: dict = {}
   333	
   334	    def domain(family) -> list[int]:
   335	        used = {assignment[n] for n in adjacency.get(family, set()) if n in assignment}
   336	        out = []
   337	        for col in _NONFRAME_COLORS:
   338	            if col in frame_adj.get(family, set()):
   339	                continue
   340	            if col in used:
   341	                continue
   342	            out.append(int(col))
   343	        random.shuffle(out)
   344	        return out
   345	
   346	    def choose_unassigned():
   347	        pending = [family for family in families if family not in assignment]
   348	        pending.sort(key=lambda family: (len(domain(family)), -len(adjacency.get(family, set()))))
   349	        return pending[0] if pending else None
   350	
   351	    def dfs() -> bool:
   352	        family = choose_unassigned()
   353	        if family is None:
   354	            return len(set(assignment.values())) == len(_NONFRAME_COLORS)
   355	        for col in domain(family):
   356	            assignment[family] = col
   357	            if dfs():
   358	                return True
   359	            assignment.pop(family)
   360	        return False
   361	
   362	    return assignment if dfs() else None
