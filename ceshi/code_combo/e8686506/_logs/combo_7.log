+            sig = _piece_sig(arr)
+            slots.append({"cells": chunk, "sig": sig, "family": _canon_sig(sig)})
+            mirror = sorted((int(r), W - 1 - int(c)) for r, c in chunk)
+            marr = np.array(mirror, dtype=int)
+            msig = _piece_sig(marr)
