   365	def _build_pre_and_out() -> tuple[np.ndarray | None, np.ndarray | None, int, set[int], dict]:
   366	    frame_mask = _build_frame_mask()
   367	    slots = _slotize(frame_mask)
   368	    families = _family_groups(slots)
   369	    if len(families) != _MIN_FAMILIES:
   370	        return None, None, 0, set(), {}
   371	    graph = _family_adjacency(slots, frame_mask)
   372	    family_keys = sorted(families)
   373	    colors_by_family = _assign_family_colors(family_keys, graph["adjacency"], graph["frame_adj"])
   374	    if colors_by_family is None:
   375	        return None, None, 0, set(), {}
   376	
   377	    pre = np.full((_OUTPUT_H, _OUTPUT_W), _FRAME_COLOR, dtype=int)
   378	    for family, groups in families.items():
   379	        col = int(colors_by_family[family])
   380	        for cells in groups:
   381	            for r, c in cells:
   382	                pre[r, c] = col
