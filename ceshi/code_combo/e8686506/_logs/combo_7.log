+_OUTPUT_H = 10
+_OUTPUT_W = 5
+_NONFRAME_COLORS = (2, 3, 8)
+_FRAME_COLOR = 1
+_SWAP_MAP = {2: 3, 3: 8, 8: 2}
+_MAX_PIECE_AREA = 6
+_CANVAS_MIN = 13
+_CANVAS_MAX = 15
+_SCATTER_PADDING = 1
+_GEN_MAX_RETRIES = 300
+_MIN_FAMILIES = 4
+
+_LEFT_BLOCKS = [
