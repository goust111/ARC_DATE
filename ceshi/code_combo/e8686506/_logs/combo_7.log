   390	        "changed_families": sum(1 for family in families if _SWAP_MAP[colors_by_family[family]] != colors_by_family[family]),
   391	        "frame_mask": pre == _FRAME_COLOR,
   392	        "families": families,
   393	        "colors_by_family": colors_by_family,
   394	        "pre": pre,
   395	        "out": out,
   396	    }
