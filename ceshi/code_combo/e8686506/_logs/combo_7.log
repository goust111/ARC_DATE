+    bbox_region[:] = bg
+    bbox_region[frame_mask] = pre[frame_mask]
+    return canvas
+
+
+def _piece_count(grid: np.ndarray) -> int:
+    return sum(len(components_mask(grid == col, connectivity=4)) for col in np.unique(grid))
+
+
