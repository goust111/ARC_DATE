+
+def _build_frame_mask() -> np.ndarray:
+    open_mask = np.zeros((_OUTPUT_H, _OUTPUT_W), dtype=bool)
+    for row0, options in _LEFT_BLOCKS:
+        shape = random.choice(options)
+        for dr, dc in shape:
+            r, c = row0 + dr, dc
+            open_mask[r, c] = True
+            open_mask[r, _OUTPUT_W - 1 - c] = True
