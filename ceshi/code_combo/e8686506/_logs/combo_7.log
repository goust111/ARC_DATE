   264	def main(grid: np.ndarray) -> np.ndarray:
   265	    """
   266	    Rebuild a mirror-paired rectangle from scattered fragments, then recolor each paired family.
   267	
   268	    Input structure:
   269	    - The background is the dominant color.
   270	    - One grouped 8-connected frame fragment still occupies its output-relative rectangle.
   271	    - Every other fragment is a single-color piece, and left-right mirror mates use the same input color.
   272	
   273	    Rule:
   274	    - Infer the output rectangle from total foreground area and recover the grouped frame.
   275	    - Use the frame holes to recover all mirrored piece slots, then refill each mirror-family with the shared color of its scattered matching pieces.
   276	    - After the paired same-color rectangle is reconstructed, apply the fixed non-frame color swap to obtain the final output.
   277	
   278	    Key insight:
   279	    - Color now serves two roles in sequence: first it identifies which scattered pieces are mirror partners, then that recovered family color is transformed by a consistent swap rule.
   280	    """
   281	    g = np.asarray(grid, dtype=int)
   282	    bg = get_bg(g)
   283	    pre, meta = _build_pre_from_input(g, bg)
   284	    out = _apply_swap(pre, meta["frame_mask"])
   285	    return out.astype(int)
