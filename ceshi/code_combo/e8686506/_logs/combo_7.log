   108	def _chunk_component(cells: list[tuple[int, int]]) -> list[list[tuple[int, int]]]:
   109	    remaining = set(cells)
   110	    chunks: list[list[tuple[int, int]]] = []
   111	    while remaining:
   112	        start = min(remaining)
   113	        queue = [start]
   114	        seen = {start}
   115	        chunk: list[tuple[int, int]] = []
   116	        while queue and len(chunk) < _MAX_PIECE_AREA:
   117	            r, c = queue.pop(0)
   118	            if (r, c) not in remaining:
   119	                continue
   120	            remaining.remove((r, c))
   121	            chunk.append((r, c))
   122	            nbrs = []
   123	            for rr, cc in ((r - 1, c), (r, c - 1), (r, c + 1), (r + 1, c)):
   124	                if (rr, cc) in remaining and (rr, cc) not in seen:
   125	                    nbrs.append((rr, cc))
   126	                    seen.add((rr, cc))
   127	            queue.extend(sorted(nbrs))
   128	        chunks.append(sorted(chunk))
   129	    return chunks
