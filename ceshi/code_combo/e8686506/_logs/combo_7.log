   299	def _family_adjacency(slots: list[dict], frame_mask: np.ndarray) -> dict[str, dict]:
   300	    H, W = frame_mask.shape
   301	    cell_to_slot: dict[tuple[int, int], int] = {}
   302	    for i, slot in enumerate(slots):
   303	        for cell in slot["cells"]:
   304	            cell_to_slot[cell] = i
   305	
   306	    adjacency: dict[tuple[int, int, tuple[tuple[int, int], ...]], set] = {}
   307	    frame_adj: dict[tuple[int, int, tuple[tuple[int, int], ...]], set[int]] = {}
   308	    for slot in slots:
   309	        family = slot["family"]
   310	        adjacency.setdefault(family, set())
   311	        frame_adj.setdefault(family, set())
   312	
   313	    for i, slot in enumerate(slots):
   314	        family = slot["family"]
   315	        for r, c in slot["cells"]:
   316	            for rr, cc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
   317	                if not (0 <= rr < H and 0 <= cc < W):
   318	                    continue
   319	                if frame_mask[rr, cc]:
   320	                    frame_adj[family].add(_FRAME_COLOR)
   321	                    continue
   322	                j = cell_to_slot.get((rr, cc))
   323	                if j is None or j == i:
   324	                    continue
   325	                other = slots[j]["family"]
   326	                if other != family:
   327	                    adjacency[family].add(other)
   328	    return {"adjacency": adjacency, "frame_adj": frame_adj}
