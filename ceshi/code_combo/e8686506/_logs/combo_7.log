   288	def _build_frame_mask() -> np.ndarray:
   289	    open_mask = np.zeros((_OUTPUT_H, _OUTPUT_W), dtype=bool)
   290	    for row0, options in _LEFT_BLOCKS:
   291	        shape = random.choice(options)
   292	        for dr, dc in shape:
   293	            r, c = row0 + dr, dc
   294	            open_mask[r, c] = True
   295	            open_mask[r, _OUTPUT_W - 1 - c] = True
   296	    return ~open_mask
