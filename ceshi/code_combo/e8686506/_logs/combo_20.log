   138	    ]
   139	    if len(warm_singletons) == 1:
   140	        col = int(warm_singletons[0])
   141	        req[0, 0] = col
   142	        req[0, W - 1] = col
   143	    if len(cool_singletons) == 1:
   144	        col = int(cool_singletons[0])
   145	        req[H - 1, 0] = col
   146	        req[H - 1, W - 1] = col
   147	
   148	    top_bars: list[tuple[int, int]] = []
   149	    bot_bars: list[tuple[int, int]] = []
   150	    if W >= 3:
   151	        for col, comps in comps_by_color.items():
   152	            for pts in comps:
   153	                r0, c0, r1, c1 = bbox_coords(pts)
   154	                hh, ww = r1 - r0 + 1, c1 - c0 + 1
   155	                if hh == 1 and ww == (W - 2) and len(pts) == ww:
   156	                    band = _color_band(col)
   157	                    if band == "top":
   158	                        top_bars.append((int(r0), int(col)))
   159	                    elif band == "bottom":
   160	                        bot_bars.append((int(r0), int(col)))
   161	                    break
   162	        if top_bars:
   163	            top_bars.sort()
   164	            req[0, 1 : W - 1] = top_bars[0][1]
   165	        if bot_bars:
   166	            bot_bars.sort()
   167	            req[H - 1, 1 : W - 1] = bot_bars[-1][1]
   168	
   169	    return req
   170	
   171	
   172	def _assemble(
   173	    types: list[dict],
   174	    H: int,
   175	    W: int,
   176	    req: np.ndarray,
   177	    disallow_touch: set[int] | None = None,
   178	) -> np.ndarray:
   179	    board = np.full((H, W), -1, dtype=int)
   180	    counts = [int(t["cnt"]) for t in types]
   181	
   182	    def mirror_ok(r: int, c: int, col: int) -> bool:
   183	        mc = W - 1 - c
   184	        v = board[r, mc]
   185	        return (v == -1) or (v == col)
   186	
   187	    def semantic_ok(ti: int, r0: int) -> bool:
   188	        t = types[ti]
   189	        band = _color_band(int(t["col"]))
   190	        if band is None:
   191	            return False
   192	        return _placement_band(t["coords"], r0, H) == band
   193	
   194	    def can_place(ti: int, r0: int, c0: int) -> bool:
   195	        t = types[ti]
   196	        col = int(t["col"])
   197	        is_singleton = len(t["coords"]) == 1
   198	        if not semantic_ok(ti, r0):
   199	            return False
   200	        for dr, dc in t["coords"]:
   201	            r, c = r0 + dr, c0 + dc
   202	            if board[r, c] != -1:
   203	                return False
   204	            if req[r, c] != -1 and int(req[r, c]) != col:
   205	                return False
   206	            if not mirror_ok(r, c, col):
   207	                return False
   208	            if is_singleton and not (r == 0 or r == H - 1 or c == 0 or c == W - 1):
   209	                return False
   210	            if disallow_touch and col in disallow_touch:
   211	                for rr, cc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
   212	                    if 0 <= rr < H and 0 <= cc < W and board[rr, cc] == col:
   213	                        return False
   214	        return True
   215	
