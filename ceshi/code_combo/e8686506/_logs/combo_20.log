    87	def _piece_sig(pts: np.ndarray) -> tuple[int, int, tuple[tuple[int, int], ...]]:
    88	    r0, c0, r1, c1 = bbox_coords(pts)
    89	    coords = tuple(sorted((int(r) - r0, int(c) - c0) for r, c in pts))
    90	    return (r1 - r0 + 1), (c1 - c0 + 1), coords
