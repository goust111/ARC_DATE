+def _placement_band(coords: tuple[tuple[int, int], ...], r0: int, H: int) -> str:
+    mean_r = float(sum(r0 + dr for dr, _ in coords)) / float(len(coords))
+    return "top" if mean_r < (H / 2.0) else "bottom"
