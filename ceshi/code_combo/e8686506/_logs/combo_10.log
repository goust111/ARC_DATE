def _random_partition(total: int) -> list[int]:
    parts = []
    rem = total
    while rem > 0:
        if rem == 1:
            parts.append(1)
            rem = 0
        else:
            step = random.choice([1, 2])
            if step > rem:
                step = 1
            parts.append(step)
            rem -= step
    random.shuffle(parts)
    return parts



