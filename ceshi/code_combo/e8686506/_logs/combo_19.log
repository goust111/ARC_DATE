+_MAX_PIECE_AREA = 6
+_MAX_CHUNK_SIZE = 6
+_PIECE_COUNT_MIN = 9
+_PIECE_COUNT_MAX = 20
+
+# === CFG: Damage / combo observability ===
+_DAMAGE_SEARCH_TRIES = 90
+_DAMAGE_OPS_MIN = 1
+_DAMAGE_OPS_MAX = 3
+_PAIR_GAP = 1
+_ORDER_DIFF_MIN = 1
