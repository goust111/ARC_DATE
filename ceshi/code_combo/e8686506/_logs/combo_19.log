+        got = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(got, expected):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(_GEN_MAX_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
