+    return req
+
+
+def _assemble(
+    types: list[dict],
+    H: int,
+    W: int,
+    req: np.ndarray,
+    disallow_touch: set[int] | None = None,
+) -> np.ndarray:
+    board = np.full((H, W), -1, dtype=int)
+    pieces: list[dict] = []
+    for t in types:
