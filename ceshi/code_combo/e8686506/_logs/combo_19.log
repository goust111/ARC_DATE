+def _repair_symmetry(board: np.ndarray, seam_color: int = _SEAM_COLOR) -> np.ndarray:
+    H, W = board.shape
+    out = board.copy()
+    for r in range(H):
+        for c in range(W // 2):
+            winner, _ = _pair_winner(board, r, c, seam_color=seam_color)
+            mc = W - 1 - c
+            out[r, c] = winner
+            out[r, mc] = winner
+    return out
