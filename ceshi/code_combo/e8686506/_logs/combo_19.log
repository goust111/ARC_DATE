+def _far_enough(chosen: list[tuple[int, int]], cand: tuple[int, int], W: int) -> bool:
+    r, c = cand
+    pts = [(r, c), (r, W - 1 - c)]
+    for rr, cc in chosen:
+        cur = [(rr, cc), (rr, W - 1 - cc)]
+        for a in pts:
+            for b in cur:
+                if max(abs(a[0] - b[0]), abs(a[1] - b[1])) <= _PAIR_GAP:
