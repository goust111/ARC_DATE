+
+
+def _candidate_pairs(board: np.ndarray, frame_colors: set[int]) -> list[tuple[int, int]]:
+    H, W = board.shape
+    seam_mask = _contact_seam_mask(board)
+    seam_first = []
+    other = []
+    for r in range(H):
+        for c in range(W // 2):
+            mc = W - 1 - c
+            col = int(board[r, c])
+            if col != int(board[r, mc]):
