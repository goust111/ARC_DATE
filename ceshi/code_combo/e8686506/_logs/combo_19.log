+_AREA_MAX = 50
+_WIDTH_REQUIRED = 5
+_HEIGHT_MAX = 10
+
+# === CFG: Color and palette ===
+_N_COLORS_MIN = 4
+_N_COLORS_MAX = 6
+_TWO_FRAME_MIN_H = 6
+_TWO_FRAME_MIN_COLORS = 5
+_TWO_FRAME_PROB = 0.35
+_CENTER_CAP_PROB = 0.5
+
