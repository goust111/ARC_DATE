+def _local_colors(board: np.ndarray, r: int, c: int) -> set[int]:
+    H, W = board.shape
+    colors = {int(board[r, c])}
+    for rr, cc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+        if 0 <= rr < H and 0 <= cc < W:
+            colors.add(int(board[rr, cc]))
