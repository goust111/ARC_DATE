+            r, c = cand
+            mc = board.shape[1] - 1 - c
+            target = (r, c) if random.random() < 0.5 else (r, mc)
+            bad = _pick_damage_color(board, bg, frame_colors, target[0], target[1], preferred, used_bad_colors)
