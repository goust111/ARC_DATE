+            avoid = frame_touch | ({prev_col} if prev_col is not None else set())
+            opts = [f for f in fill_pool if f not in avoid]
+            if not opts:
+                opts = [f for f in fill_pool if f not in frame_touch] or fill_pool
+            col = random.choice(opts)
+            for r, c in chunk:
