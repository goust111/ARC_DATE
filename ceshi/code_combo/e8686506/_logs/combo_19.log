+    board = np.full((H, W), -1, dtype=int)
+    pieces: list[dict] = []
+    for t in types:
+        for _ in range(int(t["cnt"])):
+            pieces.append(
+                {
+                    "col": int(t["col"]),
+                    "coords": tuple(t["coords"]),
+                    "h": int(t["h"]),
+                    "w": int(t["w"]),
+                    "area": len(t["coords"]),
+                }
+            )
+    pieces.sort(key=lambda p: (-p["area"], p["col"], p["coords"]))
