+    def placements_for(piece: dict) -> list[tuple[int, int]]:
+        return [
+            (r0, c0)
+            for r0 in range(H - int(piece["h"]) + 1)
+            for c0 in range(W - int(piece["w"]) + 1)
+            if can_place(piece, r0, c0)
