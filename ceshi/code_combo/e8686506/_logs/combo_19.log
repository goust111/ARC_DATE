+_GEN_MAX_RETRIES = 700
+
+_TEMPLATE_CLEAN = np.array(
+    [
+        [1, 2, 2, 2, 1],
+        [2, 1, 2, 1, 2],
+        [1, 1, 2, 1, 1],
+        [0, 1, 2, 1, 0],
+        [0, 1, 3, 1, 0],
+    ],
+    dtype=int,
+)
+_TEMPLATE_FRAME_COLORS = {0}
+_TEMPLATE_RECIPES = [
+    ((0, 0, 2), (0, 2, 4)),
+    ((0, 0, 2), (1, 2, 4)),
+    ((0, 0, 2), (2, 2, 4)),
+    ((0, 4, 2), (1, 2, 4)),
+    ((0, 4, 2), (2, 2, 4)),
