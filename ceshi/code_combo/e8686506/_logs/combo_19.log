+            if col in frame_colors:
+                continue
+            if _support_score(board, r, c) <= 0:
+                continue
+            target = seam_first if seam_mask[r, c] or seam_mask[r, mc] else other
+            target.append((r, c))
+    random.shuffle(seam_first)
+    random.shuffle(other)
