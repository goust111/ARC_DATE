        H >= _TWO_FRAME_MIN_H
        and n_colors >= _TWO_FRAME_MIN_COLORS
        and random.random() < _TWO_FRAME_PROB
    )
    idx = 0
    frame1 = palette[idx]
    idx += 1
    frame2 = frame1
    if use_two_frames:
        frame2 = palette[idx]
        idx += 1
    fill_pool = palette[idx:]
    if not fill_pool:
