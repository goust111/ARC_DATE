+def _contact_seam_mask(board: np.ndarray) -> np.ndarray:
+    mask = np.zeros(board.shape, dtype=bool)
+    diff_ud = board[1:, :] != board[:-1, :]
+    diff_lr = board[:, 1:] != board[:, :-1]
+    mask[1:, :] |= diff_ud
+    mask[:-1, :] |= diff_ud
+    mask[:, 1:] |= diff_lr
+    mask[:, :-1] |= diff_lr
+    return mask
