+    def place(piece: dict, r0: int, c0: int) -> list[tuple[int, int]]:
+        changed = []
+        col = int(piece["col"])
+        for dr, dc in piece["coords"]:
+            r, c = r0 + dr, c0 + dc
+            board[r, c] = col
+            changed.append((r, c))
+        return changed
