+
+
+def _pair_winner(board: np.ndarray, r: int, c: int, seam_color: int = _SEAM_COLOR) -> tuple[int, str]:
+    mc = board.shape[1] - 1 - c
+    a = int(board[r, c])
+    b = int(board[r, mc])
