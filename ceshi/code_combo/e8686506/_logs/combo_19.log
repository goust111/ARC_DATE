+
+    def _mask_from_parts(parts: list[tuple[int, np.ndarray]]) -> np.ndarray:
+        all_pts = np.concatenate([p for _, p in parts])
+        r0, c0, r1, c1 = bbox_coords(all_pts)
+        if r1 - r0 + 1 != H or c1 - c0 + 1 != W:
