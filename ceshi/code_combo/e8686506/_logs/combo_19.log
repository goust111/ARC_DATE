+def _apply_template_recipe(board: np.ndarray, recipe: tuple[tuple[int, int, int], tuple[int, int, int]]) -> np.ndarray:
+    out = np.array(board, copy=True)
+    for r, c, v in recipe:
+        out[r, c] = v
+    return out
