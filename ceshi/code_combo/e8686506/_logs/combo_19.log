+        "mismatch_pairs": 0,
+        "support_pairs": 0,
+        "prefer_non_seam_pairs": 0,
+        "fallback_pairs": 0,
+        "seam_overwrite_pairs": 0,
+        "seam_copy_pairs": 0,
+    }
+    for r in range(H):
