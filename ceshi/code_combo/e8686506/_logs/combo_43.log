+        want = _outline_only(H, W, bg, frame_color)
+    except Exception:
+        return None
+    if np.array_equal(got, want):
+        return inp
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(_GEN_MAX_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
