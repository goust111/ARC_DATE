+    bbox_region[:] = bg
+    frame_mask = out == frame_color
+    bbox_region[frame_mask] = out[frame_mask]
+    return canvas
+
+
+def _expected_output(inp: np.ndarray) -> np.ndarray:
+    board, H, W, bg, frame_color = _solve_colored_rectangle(inp)
