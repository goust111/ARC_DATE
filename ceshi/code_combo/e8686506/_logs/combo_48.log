+def _place_legend(canvas: np.ndarray, bg: int, forbidden_pair: tuple[int, int]) -> None:
+    canvas[:_LEGEND_BLOCK, :_LEGEND_BLOCK] = bg
+    a, b = forbidden_pair
+    canvas[0:2, 0] = a
+    canvas[0:2, 1] = b
