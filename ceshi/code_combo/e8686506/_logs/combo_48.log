+            c2, p2 = comps8_all[j]
+            union = np.concatenate([p1, p2])
+            ur0, uc0, ur1, uc1 = bbox_coords(union)
+            if ur1 - ur0 + 1 == H and uc1 - uc0 + 1 == W and is_lr_symmetric([(c1, p1), (c2, p2)], H, W):
