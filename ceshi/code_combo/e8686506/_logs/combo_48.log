+
+    remaining = palette[ci:]
+    if len(remaining) < 3:
+        return None, set(), None
+    forbid_a, forbid_b = remaining[0], remaining[1]
+    extra_fill = remaining[2:]
+    if not extra_fill:
+        return None, set(), None
+    fill_colors = [forbid_a, forbid_b, extra_fill[0]]
