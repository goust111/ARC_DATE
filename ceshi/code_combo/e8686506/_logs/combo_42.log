+    W = _WIDTH
+
+    bg = random.randint(0, 9)
+    roles = _choose_roles(bg)
+    anchors = [roles["anchor_a"], roles["anchor_b"], roles["anchor_c"]]
+    random.shuffle(anchors)
+
+    out = np.full((H, W), bg, dtype=int)
+    out[0, :] = roles["frame"]
+    out[H - 1, :] = roles["frame"]
+    out[:, 0] = roles["frame"]
+    out[:, W - 1] = roles["frame"]
