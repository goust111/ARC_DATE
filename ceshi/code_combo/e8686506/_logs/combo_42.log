+            patch[1, 1] = int(anchor_color)
+            patch[1, 2] = roles["body"]
+            if local_idx == 0:
+                patch[0, 1] = roles["top"]
+            elif local_idx == 1:
+                patch[0, 1] = roles["mid1"]
+            else:
