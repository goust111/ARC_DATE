FRAME_GAP = 4                 # min bg gap between two frames
FRAME_SIZE_RANGE = (5, 8)     # per-side length of a hollow 0-frame (inclusive)
SOURCE_MIN_SIZE = 6           # only frames strictly larger than the minimum may host sources

