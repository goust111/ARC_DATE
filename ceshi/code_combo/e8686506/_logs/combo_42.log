+_WIDTH = 5
+_HEIGHT_PATTERNS = [(2, 2, 3), (2, 3, 3)]
+_CANVAS_MIN = 18
+_CANVAS_MAX = 21
+_SCATTER_PADDING = 1
+_GEN_MAX_RETRIES = 400
