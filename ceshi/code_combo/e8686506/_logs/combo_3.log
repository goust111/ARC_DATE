+}
+
+# --------------- generator config ---------------
+_N_COLORS = 4
+_MAX_PIECE_AREA = 11
+_PIECE_COUNT_ALLOWED = {13, 17}
+_CANVAS_MIN = 13
+_CANVAS_MAX = 15
+_SCATTER_PADDING = 1
+_GEN_MAX_RETRIES = 200
