+        [AUX_ABS, AUX_ABS, FRAME_ABS, AUX_ABS, AUX_ABS],
+        [AUX_ABS, MID_ABS, FRAME_ABS, MID_ABS, AUX_ABS],
+        [CORNER_ABS, MID_ABS, FRAME_ABS, MID_ABS, CORNER_ABS],
