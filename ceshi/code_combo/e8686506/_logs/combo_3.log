   211	
   212	def _piece_sig(pts: np.ndarray) -> tuple[int, int, tuple[tuple[int, int], ...]]:
   213	    r0, c0, r1, c1 = bbox_coords(pts)
   214	    coords = tuple(sorted((int(r) - r0, int(c) - c0) for r, c in pts))
   215	    return (r1 - r0 + 1), (c1 - c0 + 1), coords
   216	
   217	
   218	def _factors(n: int) -> list[tuple[int, int]]:
   219	    out = []
   220	    for w in range(1, n + 1):
   221	        if n % w == 0:
   222	            out.append((n // w, w))
   223	    return out
   224	
   225	
   226	def _cross_cells() -> set[tuple[int, int]]:
   227	    cells = {(r, 2) for r in range(H_OUT)}
   228	    cells |= {(3, c) for c in range(W_OUT)}
   229	    return cells
   230	
   231	
   232	def _corner_cells() -> set[tuple[int, int]]:
   233	    return {(0, 0), (0, W_OUT - 1), (H_OUT - 1, 0), (H_OUT - 1, W_OUT - 1)}
   234	
   235	
   236	def _build_output(mode: str) -> np.ndarray:
   237	    if mode == MODE_TOP:
   238	        out = TOP_TEMPLATE.copy()
   239	    elif mode == MODE_BOTTOM:
   240	        out = BOTTOM_TEMPLATE.copy()
   241	    else:
   242	        raise AssertionError(f"unknown mode: {mode}")
   243	    return out
   244	
   245	
   246	def _strict_dual_symmetry(grid: np.ndarray) -> bool:
   247	    return np.array_equal(grid, grid[:, ::-1]) and np.array_equal(grid, grid[::-1, :])
   248	
   249	
   250	def _same_color_component_gap_summary(grid: np.ndarray) -> dict[int, int]:
   251	    out: dict[int, int] = {}
   252	    for col in sorted(map(int, np.unique(grid))):
   253	        comps = components_mask(grid == col, connectivity=4)
   254	        if len(comps) <= 1:
   255	            continue
   256	        best = 10**9
   257	        comp_pts = [[(int(r), int(c)) for r, c in pts] for pts in comps]
   258	        for i, a in enumerate(comp_pts):
   259	            for b in comp_pts[i + 1 :]:
   260	                gap = min(max(abs(r1 - r2), abs(c1 - c2)) for r1, c1 in a for r2, c2 in b)
   261	                best = min(best, gap)
   262	        out[col] = best
   263	    return out
   264	
   265	
   266	def _assert_output_valid(out: np.ndarray) -> None:
   267	    assert out.shape == (H_OUT, W_OUT)
   268	    assert _strict_dual_symmetry(out), "output must be dual-symmetric"
   269	    gaps = _same_color_component_gap_summary(out)
   270	    assert all(gap >= 2 for gap in gaps.values()), "same-color components must be 8-separated"
   271	    pc = sum(len(components_mask(out == col, connectivity=4)) for col in np.unique(out))
   272	    assert pc in _PIECE_COUNT_ALLOWED, "piece count must match one of the library modes"
   273	    assert all(
   274	        len(pts) <= _MAX_PIECE_AREA
   275	        for col in np.unique(out)
   276	        for pts in components_mask(out == col, connectivity=4)
   277	    ), "piece area exceeds generator budget"
   278	
   279	
   280	def _classify_output(out: np.ndarray) -> str:
   281	    sig_counter = Counter()
   282	    for col in sorted(map(int, np.unique(out))):
   283	        for pts in components_mask(out == col, connectivity=4):
   284	            sig_counter[_piece_sig(pts)] += 1
   285	    if sig_counter[CROSS_SIG] != 1:
   286	        raise AssertionError("expected one cross frame component")
   287	    if sig_counter[VERT_DOMINO_SIG] == 4:
   288	        return MODE_TOP
   289	    if sig_counter[SINGLETON_SIG] == 12:
   290	        return MODE_BOTTOM
   291	    raise AssertionError("output does not match either fused mode")
   292	
   293	
   294	def _make_output() -> tuple[np.ndarray, int, int]:
   295	    mode = random.choice([MODE_TOP, MODE_BOTTOM])
   296	    out = _build_output(mode)
   297	    _assert_output_valid(out)
   298	    bg = random.randint(0, 9)
   299	    available = [c for c in range(10) if c != bg]
   300	    random.shuffle(available)
   301	    cmap = {
   302	        CORNER_ABS: available[0],
   303	        MID_ABS: available[1],
   304	        AUX_ABS: available[2],
   305	        FRAME_ABS: available[3],
   306	    }
   307	    real = np.vectorize(lambda x: cmap[int(x)])(out)
   308	    return real.astype(int), bg, int(cmap[FRAME_ABS])
   309	
   310	
   311	def _extract_non_frame_patches(out: np.ndarray, bg: int, frame_color: int) -> list[np.ndarray]:
   312	    patches = []
   313	    for col in sorted(map(int, np.unique(out))):
   314	        if col == frame_color:
   315	            continue
   316	        for pts in components_mask(out == col, connectivity=4):
   317	            r0, c0, r1, c1 = bbox_coords(pts)
   318	            patch = np.full((r1 - r0 + 1, c1 - c0 + 1), bg, dtype=int)
   319	            for r, c in pts:
   320	                patch[int(r) - r0, int(c) - c0] = col

