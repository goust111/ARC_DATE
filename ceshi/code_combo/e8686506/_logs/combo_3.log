import itertools
from collections import defaultdict, deque
H,W=7,5
seen_orbits=[]
used=set()
for r in range(H):
  for c in range(W):
    orb=tuple(sorted({(r,c),(H-1-r,c),(r,W-1-c),(H-1-r,W-1-c)}))
    if orb not in used:
      used.add(orb)
      seen_orbits.append(orb)
print('orbits',len(seen_orbits),[len(o) for o in seen_orbits])

def connected(cells):
  cells=set(cells)
  if not cells: return False
  q=deque([next(iter(cells))]); vis={q[0]}
  while q:
    r,c=q.popleft()
    for rr,cc in ((r-1,c),(r+1,c),(r,c-1),(r,c+1)):
      if (rr,cc) in cells and (rr,cc) not in vis:
        vis.add((rr,cc)); q.append((rr,cc))
  return vis==cells

cand=[]
for mask in range(1,1<<len(seen_orbits)):
  cells=[]
  area=0
  for i,orb in enumerate(seen_orbits):
    if mask>>i &1:
      cells.extend(orb); area+=len(orb)
  if area>6: continue
  if connected(cells):
    rs=[r for r,c in cells]; cs=[c for r,c in cells]
    bbox=(min(rs),min(cs),max(rs),max(cs))
    cand.append((area,bbox,tuple(sorted(cells))))
print('candidates',len(cand))
# print unique interesting by bbox
bybbox=defaultdict(list)
for area,bbox,cells in cand:
  bybbox[bbox].append(cells)
for bbox in sorted(bybbox):
  if bbox[0]==0 and bbox[2]==H-1 or bbox[1]==0 and bbox[3]==W-1:
    print('bbox',bbox,'count',len(bybbox[bbox]),'areas',sorted({len(c) for c in bybbox[bbox]}))
# find pairs union bbox full
full=[]
for i,(a1,b1,c1) in enumerate(cand):
  s1=set(c1)
  for a2,b2,c2 in cand[i:]:
    s=s1|set(c2)
    rs=[r for r,c in s]; cs=[c for r,c in s]
    if min(rs)==0 and max(rs)==H-1 and min(cs)==0 and max(cs)==W-1:
      full.append((len(s1),len(set(c2)),len(s),c1,c2))
print('pair unions full',len(full))
# show small examples with total cells <=12 and at least one cell on every side maybe all frame-like
shown=0
for a1,a2,u,c1,c2 in full:
  s=set(c1)|set(c2)
  sides=(any(r==0 for r,c in s),any(r==H-1 for r,c in s),any(c==0 for r,c in s),any(c==W-1 for r,c in s))
  if not all(sides):
    continue
  # prefer disjoint
  if set(c1)&set(c2):
    continue
  print('---',a1,a2,'union',u)
  grid=[['.' for _ in range(W)] for _ in range(H)]
  for r,c in c1: grid[r][c]='A'
  for r,c in c2: grid[r][c]='B' if grid[r][c]=='.' else 'X'
  for row in grid: print(''.join(row))
