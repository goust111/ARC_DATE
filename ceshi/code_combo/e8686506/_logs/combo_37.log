+def _requirements_match_board(board: np.ndarray, bg: int) -> bool:
+    H, W = board.shape
+    comps_by_color: dict[int, list[list[tuple[int, int]]]] = {}
+    for col in sorted(set(map(int, np.unique(board))) - {bg}):
