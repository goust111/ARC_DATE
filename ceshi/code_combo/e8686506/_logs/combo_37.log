def _zigzag_frame(H: int) -> tuple[set[tuple[int, int]], int, int]:
    cells = set()
    start_c = random.randint(0, 1)
    c = start_c
    vertical_run = 1
    for r in range(H):
        cells.add((r, c))
        if r == H - 1:
            break
        if vertical_run >= 3:
            move = random.choice(["horiz", "diag"])
        else:
            move = random.choices(["down", "horiz", "diag"], weights=[1, 2, 2], k=1)[0]
        if move == "horiz":
            cells.add((r, 1 - c))
            c = 1 - c
        elif move == "diag":
            c = 1 - c
        else:
            vertical_run += 1
    return cells, start_c, c
