start=time.time()
for i in range(120):
    clean, bg, frame_colors = mod._make_clean_output()
    if clean is None:
        reasons['clean_none'] += 1
        continue
    damaged, _ = mod._damage_clean_board(clean, bg, frame_colors)
    if damaged is None:
        reasons['damage_none'] += 1
        continue
    repaired = mod._repair_symmetry(damaged, bg)
    if not np.array_equal(repaired, repaired[:, ::-1]):
        reasons['repair_not_sym'] += 1
        continue
    pc = mod._piece_count(damaged)
    if pc < mod._PIECE_COUNT_MIN or pc > mod._PIECE_COUNT_MAX:
        reasons['piece_count'] += 1
        continue
    if any(len(pts) > mod._MAX_PIECE_AREA for col in np.unique(damaged) for pts in mod.components_mask(damaged == col, connectivity=4)):
        reasons['piece_area'] += 1
