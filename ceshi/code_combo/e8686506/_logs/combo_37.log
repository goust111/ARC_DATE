+    return {
+        "panel_count": len(placements),
+        "panel_output_area": int(panel_out.shape[0] * panel_out.shape[1]),
+        "rect_output_area": int(repaired.shape[0] * repaired.shape[1]),
+        "mismatch_pairs_before_repair": mismatch_pairs,
+    }
