+def _extract_piece_records(board: np.ndarray, bg: int) -> list[dict]:
+    records = []
+    for col in sorted(set(map(int, np.unique(board))) - {bg}):
+        for pts in components_mask(board == col, connectivity=4):
+            r0, c0, r1, c1 = bbox_coords(pts)
