        got = mod.main(inp)
    except Exception as e:
        reasons[f'oracle_exc:{type(e).__name__}:{e}'] += 1
        continue
    expected = mod._expected_output_from_board(damaged, bg)
    if not np.array_equal(got, expected):
        reasons['oracle_mismatch'] += 1
        continue
    reasons['ok'] += 1
print(reasons)
print('elapsed', round(time.time()-start,2))
