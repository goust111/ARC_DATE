+                    "col": int(col),
+                    "coords": coords,
+                    "r0": int(r0),
+                    "c0": int(c0),
+                    "h": int(r1 - r0 + 1),
+                    "w": int(c1 - c0 + 1),
+                    "cells": tuple(sorted((int(r), int(c)) for r, c in pts)),
