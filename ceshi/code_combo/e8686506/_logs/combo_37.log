+
+
+def combo_metrics_from_board(damaged_board: np.ndarray, bg: int) -> dict[str, int]:
+    placements = _extract_piece_records(damaged_board, bg)
+    repaired = _repair_symmetry(damaged_board, bg)
+    mismatch_pairs = 0
