+        r0, c0, r1, c1 = bbox_coords(pts1)
+        if r1 - r0 + 1 == H and c1 - c0 + 1 == W and is_lr_symmetric([(col1, pts1)]):
+            frame_parts = [(col1, pts1)]
+            break
+        for j in range(i + 1, len(comps8_all)):
+            col2, pts2 = comps8_all[j]
