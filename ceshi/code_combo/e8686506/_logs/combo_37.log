+    rows, cols = _choose_panel_layout(len(ordered), H, W)
+    gap = 1
+    border = 1
+    out_h = 2 * border + rows * H + (rows - 1) * gap
+    out_w = 2 * border + cols * W + (cols - 1) * gap
+    out = np.full((out_h, out_w), bg, dtype=int)
+
+    for idx, rec in enumerate(ordered):
