/bin/bash -lc "python - <<'PY'
import importlib.util, numpy as np
from collections import Counter
spec = importlib.util.spec_from_file_location('combo', '/home/lixinyu/snap/new/ceshi/code_combo/e8686506/37/code.py')
mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)

def assembled_metrics(grid):
    g = np.asarray(grid, dtype=int)
    bg = int(mod.get_bg(g))
    comps_by_color = {}
    pieces = []
    color_piece_count = {}
    for col in sorted(set(map(int, np.unique(g)))):
        if col == bg:
            continue
        comps = mod.components_mask(g == col, connectivity=4)
        comps_by_color[col] = comps
        color_piece_count[col] = len(comps)
        for pts in comps:
            _, _, coords = mod._piece_sig(pts)
            pieces.append((col, coords))
    ctr = Counter(pieces)
    types = []
    for (col, coords), cnt in sorted(ctr.items(), key=lambda kv: (-len(kv[0][1]), kv[0][0], kv[0][1])):
        arr = np.array(coords, dtype=int)
        types.append({\"col\": int(col), \"coords\": coords, \"h\": int(arr[:,0].max()+1), \"w\": int(arr[:,1].max()+1), \"cnt\": int(cnt)})
    total_area = sum(int(t['cnt']) * len(t['coords']) for t in types)
    dims = [(h, w) for h, w in mod._factors(total_area) if h >= w]
    best_gap = min(abs(h - w) for h, w in dims)
    H, W = [d for d in dims if abs(d[0]-d[1]) == best_gap][0]
    frame_parts = mod._find_frame_parts(g, bg, H, W)
    req = mod._build_requirements(H, W, comps_by_color)
    all_frame_pts = np.concatenate([p for _, p in frame_parts])
    fr0, fc0 = int(all_frame_pts[:,0].min()), int(all_frame_pts[:,1].min())
    for col, pts in frame_parts:
        for r, c in pts:
            or_, oc = int(r) - fr0, int(c) - fc0
            if 0 <= or_ < H and 0 <= oc < W:
                req[or_, oc] = int(col)
    disallow_touch = {col for col, n in color_piece_count.items() if n > 1}
    assembled, placements = mod._assemble(types, H, W, req, disallow_touch)
    metrics = mod.combo_metrics_from_board(assembled, bg)
    out = mod.main(g)
    return {
        'assembled_shape': assembled.shape,
        'panel_count': metrics['panel_count'],
        'mismatch_pairs_before_repair': metrics['mismatch_pairs_before_repair'],
        'panel_area_ratio': round(metrics['panel_output_area'] / metrics['rect_output_area'], 2),
        'output_shape': out.shape,
    }

for i, grid in enumerate(mod._PRECOMPUTED_INPUTS):
    print(i, assembled_metrics(grid))
