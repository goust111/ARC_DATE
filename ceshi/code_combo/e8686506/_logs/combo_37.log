+        rows = (count + cols - 1) // cols
+        out_h = 2 * border + rows * panel_h + (rows - 1) * gap
+        out_w = 2 * border + cols * panel_w + (cols - 1) * gap
+        key = (abs(out_h - out_w), rows * cols - count, out_h * out_w, rows, cols)
