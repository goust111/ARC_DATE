    metrics = mod.combo_metrics_from_board(damaged, bg)
    if metrics['panel_count'] < mod._PIECE_COUNT_MIN:
        reasons['panel_count'] += 1
        continue
    if metrics['mismatch_pairs_before_repair'] < (mod._FILL_REPAIRS_REQUIRED + mod._CLEAR_REPAIRS_REQUIRED):
        reasons['mismatch_pairs'] += 1
        continue
    if metrics['panel_output_area'] <= metrics['rect_output_area']:
        reasons['panel_area'] += 1
        continue
    try:
