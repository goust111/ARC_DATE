   375	def main(grid: np.ndarray) -> np.ndarray:
   376	    """
   377	    Reassemble scattered fragments into a dense left-right symmetric rectangle, then decorate it with two boundary layers.
   378	
   379	    Input structure:
   380	    - The background is the most frequent color; every other color belongs to an original fragment from the unmodified assembly.
   381	    - Neither output-only boundary color appears in the input: grey is reserved for internal joins, and 7 is reserved for the final outer frame.
   382	    - Optional corner markers, horizontal edge bars, and paired vertical edge lines are still encoded with the fragments' native colors.
   383	
   384	    Rule:
   385	    - First recover the same tight left-right symmetric rectangle as the source task by packing all non-background components.
   386	    - Then repaint each assembled cell that 4-touches a differently colored assembled neighbor to grey, exposing inter-piece seams.
   387	    - Finally surround that transformed rectangle with a new 1-cell border of color 7, increasing the output by 2 rows and 2 columns.
   388	
   389	    Key insight:
   390	    - The scattered pieces still determine only the inner assembly. Both visible boundary layers are deterministic postprocesses:
   391	      grey comes from local piece contacts inside the assembly, while 7 marks the brand-new exterior perimeter.
   392	    """
   393	    base = _solve_base_assembly(grid)
   394	    return _apply_combo_transform(base).astype(int)
