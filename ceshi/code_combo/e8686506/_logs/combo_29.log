   364	def _add_outer_border(inner: np.ndarray, border_color: int = _OUTER_BORDER_COLOR) -> np.ndarray:
   365	    h, w = inner.shape
   366	    out = np.full((h + 2, w + 2), int(border_color), dtype=int)
   367	    out[1:-1, 1:-1] = inner
   368	    return out
   369	
   370	
   371	def _apply_combo_transform(board: np.ndarray) -> np.ndarray:
   372	    return _add_outer_border(_apply_seam_transform(board))
