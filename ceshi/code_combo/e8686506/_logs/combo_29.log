   254	def _solve_base_assembly(grid: np.ndarray) -> np.ndarray:
   255	    g = np.asarray(grid, dtype=int)
   256	    bg = get_bg(g)
   257	
   258	    comps_by_color: dict[int, list[list[tuple[int, int]]]] = {}
   259	    pieces = []
   260	    color_piece_count: dict[int, int] = {}
   261	
   262	    for col in sorted(set(map(int, np.unique(g)))):
   263	        if col == bg:
   264	            continue
   265	        comps = components_mask(g == col, connectivity=4)
   266	        comps_by_color[col] = comps
   267	        color_piece_count[col] = len(comps)
   268	        for pts in comps:
   269	            _, _, coords = _piece_sig(pts)
   270	            pieces.append((col, coords))
   271	
   272	    from collections import Counter
   273	
   274	    ctr = Counter(pieces)
   275	    types = []
   276	    for (col, coords), cnt in sorted(ctr.items(), key=lambda kv: (-len(kv[0][1]), kv[0][0], kv[0][1])):
   277	        arr = np.array(coords, dtype=int)
   278	        h = int(arr[:, 0].max() + 1)
   279	        w = int(arr[:, 1].max() + 1)
   280	        types.append({"col": int(col), "coords": coords, "h": h, "w": w, "cnt": int(cnt)})
   281	
   282	    total_area = sum(int(t["cnt"]) * len(t["coords"]) for t in types)
   283	    assert total_area > 0, "total_area must be positive: grid must contain non-background pieces"
   284	
   285	    dims = [(h, w) for (h, w) in _factors(total_area) if h >= w]
   286	    assert dims, "at least one portrait factor pair must exist for the total piece area"
   287	    best_gap = min(abs(h - w) for h, w in dims)
   288	    best_dims = [(h, w) for h, w in dims if abs(h - w) == best_gap]
   289	    assert len(best_dims) == 1, "closest-to-square portrait output shape must be unique"
   290	    H, W = best_dims[0]
   291	
   292	    comps8_all = []
   293	    for col in sorted(set(map(int, np.unique(g))) - {bg}):
   294	        for pts in components_mask(g == col, connectivity=8):
   295	            comps8_all.append((int(col), pts))
   296	
   297	    def _is_lr_symmetric(parts, h, w):
   298	        all_pts = np.concatenate([p for _, p in parts])
   299	        r0, c0 = int(all_pts[:, 0].min()), int(all_pts[:, 1].min())
   300	        bmp = np.zeros((h, w), dtype=bool)
   301	        for _, pts in parts:
   302	            for r, c in pts:
   303	                bmp[int(r) - r0, int(c) - c0] = True
   304	        return np.array_equal(bmp, bmp[:, ::-1])
   305	
   306	    frame_parts: list[tuple[int, np.ndarray]] = []
   307	    for i, (c1, p1) in enumerate(comps8_all):
   308	        r0, c0, r1, c1b = bbox_coords(p1)
   309	        if r1 - r0 + 1 == H and c1b - c0 + 1 == W:
   310	            if _is_lr_symmetric([(c1, p1)], H, W):
   311	                frame_parts = [(c1, p1)]
   312	                break
   313	        for j in range(i + 1, len(comps8_all)):
   314	            c2, p2 = comps8_all[j]
   315	            union = np.concatenate([p1, p2])
   316	            ur0, uc0, ur1, uc1 = bbox_coords(union)
   317	            if ur1 - ur0 + 1 == H and uc1 - uc0 + 1 == W:
   318	                if _is_lr_symmetric([(c1, p1), (c2, p2)], H, W):
   319	                    frame_parts = [(c1, p1), (c2, p2)]
   320	                    break
   321	        if frame_parts:
   322	            break
   323	    assert frame_parts, "input must contain 1-2 LR-symmetric pieces (8-conn) whose union bbox equals output dims"
   324	
   325	    req = _build_requirements(H, W, comps_by_color)
   326	
   327	    all_frame_pts = np.concatenate([p for _, p in frame_parts])
   328	    fr0, fc0 = int(all_frame_pts[:, 0].min()), int(all_frame_pts[:, 1].min())
   329	    for col, pts in frame_parts:
   330	        for r, c in pts:
   331	            or_, oc = int(r) - fr0, int(c) - fc0
   332	            if 0 <= or_ < H and 0 <= oc < W:
   333	                req[or_, oc] = col
   334	
   335	    disallow_touch = {col for col, n in color_piece_count.items() if n > 1}
   336	    return _assemble(types, H, W, req, disallow_touch)
