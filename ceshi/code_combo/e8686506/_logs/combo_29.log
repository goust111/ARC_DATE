spec = importlib.util.spec_from_file_location('variant', '/home/lixinyu/snap/new/ceshi/code_combo/e8686506/29/code.py')
mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)
N = 100
seam_counts = []
changed_inner_counts = []
survivor_counts = []
shape_deltas = []
border_ok = 0
same_as_base = 0
for _ in range(N):
    inp = mod.generate_input()
    base = mod._solve_base_assembly(inp)
    out = mod.main(inp)
    inner = out[1:-1, 1:-1]
    seam_counts.append(int(np.count_nonzero(inner == mod._SEAM_COLOR)))
    changed_inner_counts.append(int(np.count_nonzero(inner "'!= base)))
    survivor_counts.append(int(np.count_nonzero(inner != mod._SEAM_COLOR)))
    shape_deltas.append((int(out.shape[0] - base.shape[0]), int(out.shape[1] - base.shape[1])))
    if np.all(out[0, :] == mod._OUTER_BORDER_COLOR) and np.all(out[-1, :] == mod._OUTER_BORDER_COLOR) and np.all(out[:, 0] == mod._OUTER_BORDER_COLOR) and np.all(out[:, -1] == mod._OUTER_BORDER_COLOR):
        border_ok += 1
    if np.array_equal(inner, base):
        same_as_base += 1
print({
    '"'samples': N,
    'border_ok': border_ok,
    'shape_deltas': {str(k): shape_deltas.count(k) for k in sorted(set(shape_deltas))},
    'seam_count_min': min(seam_counts),
    'seam_count_max': max(seam_counts),
    'seam_count_mean': round(stats.mean(seam_counts), 2),
    'changed_inner_min': min(changed_inner_counts),
    'changed_inner_max': max(changed_inner_counts),
    'survivor_min': min(survivor_counts),
    'survivor_mean': round(stats.mean(survivor_counts), 2),
    'same_as_base_inner': same_as_base,
})
