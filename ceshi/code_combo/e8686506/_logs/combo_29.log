   464	def _fill_holes(grid, H, W, half, frame1, frame2, split, fill_pool):
   465	    holes = components_mask(grid == -1, connectivity=4)
   466	    prev_col = None
   467	    for hole in holes:
   468	        cells = sorted((int(r), int(c)) for r, c in hole)
   469	        chunks = [cells[i : i + _MAX_CHUNK_SIZE] for i in range(0, len(cells), _MAX_CHUNK_SIZE)]
   470	        for chunk in chunks:
   471	            fc_set = {frame1 if r < split else frame2 for r, _ in chunk}
   472	            avoid = fc_set | ({prev_col} if prev_col is not None else set())
   473	            opts = [f for f in fill_pool if f not in avoid]
   474	            if not opts:
   475	                opts = [f for f in fill_pool if f not in fc_set] or fill_pool
   476	            col = random.choice(opts)
   477	            for r, c in chunk:
   478	                grid[r, c] = col
   479	                grid[r, W - 1 - c] = col
   480	            prev_col = col
