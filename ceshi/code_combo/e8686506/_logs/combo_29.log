   445	def _zigzag_frame(H):
   446	    cells = set()
   447	    start_c = random.randint(0, 1)
   448	    c = start_c
   449	    for r in range(H):
   450	        cells.add((r, c))
   451	        if r == H - 1:
   452	            break
   453	        move = random.choice(["down", "horiz", "diag"])
   454	        if move == "down":
   455	            pass
   456	        elif move == "horiz":
   457	            cells.add((r, 1 - c))
   458	            c = 1 - c
   459	        else:
   460	            c = 1 - c
   461	    return cells, start_c, c
