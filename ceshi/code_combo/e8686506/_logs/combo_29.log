   554	            patch = np.full((r1 - r0 + 1, c1 - c0 + 1), bg, dtype=int)
   555	            for r, c in pts:
   556	                patch[int(r) - r0, int(c) - c0] = col
   557	            patches.append(patch)
   558	    random.shuffle(patches)
   559	    patches.sort(key=lambda p: (-(p != bg).sum(), random.random()))
