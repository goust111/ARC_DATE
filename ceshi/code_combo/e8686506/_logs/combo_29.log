   563	def _scatter(base_out: np.ndarray, bg: int, fcs: set[int]) -> np.ndarray:
   564	    rows = random.randint(_CANVAS_MIN, _CANVAS_MAX)
   565	    cols = random.randint(_CANVAS_MIN, _CANVAS_MAX)
   566	    canvas = np.full((rows, cols), bg, dtype=int)
   567	    oh, ow = base_out.shape
   568	
   569	    max_r = rows - oh - 2
   570	    max_c = cols - ow - 2
   571	    if max_r < 1 or max_c < 1:
   572	        raise ValueError
   573	    off_r = random.randint(1, max_r)
   574	    off_c = random.randint(1, max_c)
   575	
   576	    canvas[off_r : off_r + oh, off_c : off_c + ow] = -1
   577	
   578	    for patch in _extract_non_frame_patches(base_out, bg, fcs):
   579	        r, c = random_free_location(
   580	            canvas,
   581	            patch,
   582	            transparent=bg,
   583	            padding=_SCATTER_PADDING,
   584	            padding_connectivity=8,
   585	        )
   586	        paste(canvas, patch, r, c, transparent=bg)
