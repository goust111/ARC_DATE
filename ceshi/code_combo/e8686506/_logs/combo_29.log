   483	def _build_base_output(H, W):
   484	    half = W // 2
   485	    n_colors = random.randint(_N_COLORS_MIN, _N_COLORS_MAX)
   486	    palette = list(range(n_colors))
   487	    random.shuffle(palette)
   488	
   489	    use_two_frames = (
   490	        H >= _TWO_FRAME_MIN_H
   491	        and n_colors >= _TWO_FRAME_MIN_COLORS
   492	        and random.random() < _TWO_FRAME_PROB
   493	    )
   494	    ci = 0
   495	    frame1 = palette[ci]
   496	    ci += 1
   497	    frame2 = frame1
   498	    if use_two_frames:
   499	        frame2 = palette[ci]
   500	        ci += 1
   501	    fill_pool = palette[ci:]
   502	    if not fill_pool:
   503	        return None, set()
   504	
   505	    frame_half, start_c, end_c = _zigzag_frame(H)
   506	    split = H // 2 if frame1 != frame2 else H
   507	
   508	    grid = np.full((H, W), -1, dtype=int)
   509	
   510	    for r, c in frame_half:
   511	        fc = frame1 if r < split else frame2
   512	        grid[r, c] = fc
   513	        grid[r, W - 1 - c] = fc
   514	
   515	    if start_c == 1 and random.random() < _CENTER_CAP_PROB:
   516	        grid[0, half] = frame1
   517	    if end_c == 1 and random.random() < _CENTER_CAP_PROB:
   518	        grid[H - 1, half] = frame2
   519	
   520	    _fill_holes(grid, H, W, half, frame1, frame2, split, fill_pool)
   521	
   522	    if np.any(grid < 0):
   523	        return None, set()
   524	    frame_set = {frame1}
   525	    if frame2 != frame1:
   526	        frame_set.add(frame2)
   527	    return grid, frame_set
