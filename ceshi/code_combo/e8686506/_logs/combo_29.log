   588	    frame_mask = np.zeros((oh, ow), dtype=bool)
   589	    for col in fcs:
   590	        frame_mask |= base_out == col
   591	    bbox_region = canvas[off_r : off_r + oh, off_c : off_c + ow]
   592	    bbox_region[:] = bg
   593	    bbox_region[frame_mask] = base_out[frame_mask]
   594	    return canvas
