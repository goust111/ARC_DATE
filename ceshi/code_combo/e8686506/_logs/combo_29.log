   339	def _contact_seam_mask(board: np.ndarray) -> np.ndarray:
   340	    """
   341	    Cells that participate in a 4-neighbor contact with a differently colored cell.
   342	
   343	    Because the base puzzle forbids distinct same-color pieces from 4-touching, color inequality is a
   344	    sufficient proxy for "this edge is a seam between two fragments".
   345	    """
   346	    H, W = board.shape
   347	    mask = np.zeros((H, W), dtype=bool)
   348	    diff_ud = board[1:, :] != board[:-1, :]
   349	    diff_lr = board[:, 1:] != board[:, :-1]
   350	    mask[1:, :] |= diff_ud
   351	    mask[:-1, :] |= diff_ud
   352	    mask[:, 1:] |= diff_lr
   353	    mask[:, :-1] |= diff_lr
   354	    return mask
   355	
   356	
   357	def _apply_seam_transform(board: np.ndarray, seam_color: int = _SEAM_COLOR) -> np.ndarray:
   358	    out = np.array(board, copy=True)
   359	    seam_mask = _contact_seam_mask(board)
   360	    out[seam_mask] = seam_color
   361	    return out
   362	
