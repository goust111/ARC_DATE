   618	    if combo_out.shape != expected_shape:
   619	        return False
   620	    if not bool((combo_out[0, :] == _OUTER_BORDER_COLOR).all()):
   621	        return False
   622	    if not bool((combo_out[-1, :] == _OUTER_BORDER_COLOR).all()):
   623	        return False
