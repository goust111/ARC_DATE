   601	def _transformed_output_ok(base_out: np.ndarray, transformed: np.ndarray) -> bool:
   602	    seam_mask = transformed == _SEAM_COLOR
   603	    if not np.any(seam_mask):
   604	        return False
   605	    surviving = ~seam_mask
   606	    if np.count_nonzero(surviving) < _MIN_SURVIVING_COLOR_CELLS:
   607	        return False
   608	    surviving_colors = set(map(int, np.unique(transformed[surviving])))
   609	    if len(surviving_colors) < _MIN_SURVIVING_COLORS:
   610	        return False
   611	    if np.array_equal(base_out, transformed):
   612	        return False
   613	    return True
