    fs=len(lengths)
    if hs and max(hs)<=6 and len(holes)>=5 and nonrect>=2:
      good += 1
      if good<=3:
        print('"' cols',cols,'lens',lengths,'holes',hs,'nonrect',nonrect,'frameparts',fs)
        print(g)
  print('good',good)
