import random, numpy as np
from arc_utils import components_mask

FRAME_PARTS_MIN=3
FRAME_PARTS_MAX=4

def row_partitions(total, k):
    out=[]
    def rec(rem, slots, cur):
        if slots==0:
            if rem==0: out.append(tuple(cur))
            return
        lo=max(2, rem-4*(slots-1))
        hi=min(4, rem-2*(slots-1))
        for v in range(lo, hi+1):
            cur.append(v); rec(rem-v, slots-1, cur); cur.pop()
    rec(total,k,[])
    return out

def zigzag_cols(H):
    for _ in range(200):
        cols=[0]
        c=random.choice([0,1])
        for r in range(1,H-1):
            if r>=2 and cols[-1]==cols[-2]:
                if random.random()<0.8: c=1-c
            else:
                if random.random()<0.5: c=1-c
            cols.append(c)
        cols.append(0)
        if sum(v==1 for v in cols)>=3:
            return cols

def choose_segments(H, cols):
    feasible=[]
    for k in range(FRAME_PARTS_MIN, FRAME_PARTS_MAX+1):
        if 2*k<=H<=4*k: feasible.append(k)
    random.shuffle(feasible)
    for k in feasible:
        parts=row_partitions(H,k)
        random.shuffle(parts)
        for lengths in parts:
            row0=0; ok=True
            for L in lengths:
                if 1 not in cols[row0:row0+L]: ok=False; break
                row0 += L
            if ok: return list(lengths)

def paint_segment(grid,row0,cols):
    bridge_rows=[i for i,v in enumerate(cols) if v==1]
    bridge=random.choice(bridge_rows)
    for dr,c in enumerate(cols):
        r=row0+dr
        grid[r,c]=1
        grid[r,grid.shape[1]-1-c]=1
        if dr==bridge:
            grid[r,grid.shape[1]//2]=1

for H in range(6,11):
  W=5
  print('H',H)
