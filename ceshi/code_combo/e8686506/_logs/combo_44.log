+                ring_owner = int(col)
+    assert ring_owner is not None, "input must contain one full rectangular ring"
+    assert len(comps_by_color[ring_owner]) == 1, "outer ring color must appear only in the ring"
+    role_to_color["outer"] = int(ring_owner)
