+    return (r1 - r0 + 1), (c1 - c0 + 1), coords
+
+
+def _ring_coords(H: int, W: int) -> tuple[tuple[int, int], ...]:
+    cells = []
+    for r in range(H):
+        for c in range(W):
+            if r == 0 or r == H - 1 or c == 0 or c == W - 1:
+                cells.append((r, c))
+    return tuple(cells)
+
