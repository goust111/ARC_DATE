+def _template_key(parts: list[list[tuple[int, int]]]) -> tuple[tuple[int, int, tuple[tuple[int, int], ...]], ...]:
+    sigs = []
+    for coords in parts:
+        arr = np.array(coords, dtype=int)
+        sigs.append(_piece_sig(arr))
+    return tuple(sorted(sigs))
