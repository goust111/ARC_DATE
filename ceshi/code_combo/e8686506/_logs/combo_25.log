+def _scaffold_mask() -> np.ndarray:
+    mask = np.zeros((_OUT_H, _OUT_W), dtype=bool)
+    mask[0, :] = True
+    mask[-1, :] = True
+    mask[:, 0] = True
+    mask[:, -1] = True
+    mask[3, :] = True
+    mask[:, 3] = True
+    return mask
