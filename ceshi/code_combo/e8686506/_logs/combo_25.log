+_ROOM_TEMPLATE_COORDS = {
+    "tl": [[(0, 0), (0, 1)], [(1, 0), (1, 1)]],
+    "tr": [[(0, 0), (1, 0)], [(0, 1), (1, 1)]],
+    "bl": [[(0, 0), (0, 1), (1, 0)], [(1, 1)]],
+    "br": [[(0, 1), (1, 0), (1, 1)], [(0, 0)]],
+}
