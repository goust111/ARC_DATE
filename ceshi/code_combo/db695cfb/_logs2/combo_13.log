    h, w = grid.shape
    pts = [(r, c) for r in range(h) for c in range(w) if int(grid[r, c]) == line_color]

    groups_a: dict[int, list[tuple[int, int]]] = {}
    groups_b: dict[int, list[tuple[int, int]]] = {}
    for r, c in pts:
