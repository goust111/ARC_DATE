+def _best_diagonal_pair(by_color: dict[int, list[tuple[int, int]]]) -> tuple[int, int] | None:
+    best = None  # (dist, color)
+    for col, pts in by_color.items():
+        if len(pts) < 2:
+            continue
+        for i in range(len(pts)):
