    same_fixed_dual += int(np.array_equal(out, alt_fixed_dual))
    diff_boundary.append(int(np.count_nonzero(out "'!= alt_boundary)))
    diff_fixed_dual.append(int(np.count_nonzero(out != alt_fixed_dual)))
    _bg, _line, segs = collect_segments(inp)
    trigger_hist[sum(len(seg['"'trigger_specs']) for seg in segs)] += 1
    segment_hist[len(segs)] += 1

print('samples', n)
print('same_as_boundary_single', same_boundary)
print('same_as_fixed_dual', same_fixed_dual)
