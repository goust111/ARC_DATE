                    triggers.append({'"'pos': (r, c), 'ray_len': ray_len, 'direction': direction})
        segments.append({'path': path, 'dc': dc, 'trigger_specs': triggers})

    for g in groups_a.values():
        if len(g) >= 2:
            scan(g)
    for g in groups_b.values():
        if len(g) >= 2:
            scan(g)
    return bg, line_color, segments


def boundary_single(grid):
    grid = np.asarray(grid, dtype=int)
    h, w = grid.shape
    out = grid.copy()
    bg, line_color, segments = collect_segments(grid)
    for seg in segments:
        for r, c in seg['path']:
            if int(out[r, c]) == bg:
                out[r, c] = line_color
        for spec in seg['trigger_specs']:
            (r0, c0), (ddr, ddc) = spec['pos'], spec['direction']
            r, c = r0 + ddr, c0 + ddc
            while 0 <= r < h and 0 <= c < w:
                if int(out[r, c]) == bg:
                    out[r, c] = mod._TRIGGER_COLOR
                r += ddr
                c += ddc
    return out


def fixed_dual(grid):
    grid = np.asarray(grid, dtype=int)
    out = grid.copy()
    bg, line_color, segments = collect_segments(grid)
    for seg in segments:
        up, down = mod._perp_dirs_for_dc(seg['dc'])
        for r, c in seg['path']:
            if int(out[r, c]) == bg:
                out[r, c] = line_color
        for spec in seg['trigger_specs']:
            r0, c0 = spec['pos']
            for ddr, ddc in (up, down):
                for step in range(1, spec['ray_len'] + 1):
                    r = r0 + step * ddr
                    c = c0 + step * ddc
                    if 0 <= r < out.shape[0] and 0 <= c < out.shape[1] and int(out[r, c]) == bg:
                        out[r, c] = mod._TRIGGER_COLOR
    return out

