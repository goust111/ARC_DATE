    for (r0, c0, tcol), dirs in triggers.items():
        for ddr, ddc in dirs:
            record = {
                "trigger": (r0, c0),
                "color": tcol,
                "dir": (ddr, ddc),
                "painted": 0,
                "blocked": False,
