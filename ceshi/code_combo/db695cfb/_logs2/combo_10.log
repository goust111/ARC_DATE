+    drawn: set[tuple[int, int]],
+    bbox: tuple[int, int, int, int],
+    color: int,
+    prefer_outside: bool,
+) -> tuple[int, int] | None:
+    H, W = inp.shape
+    for _ in range(_DISTRACTOR_RETRIES):
+        r, c = random.randint(0, H - 1), random.randint(0, W - 1)
+        if (r, c) in occupied or (r, c) in drawn:
+            continue
