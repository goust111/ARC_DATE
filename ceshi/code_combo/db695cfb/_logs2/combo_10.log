        r, c = random.randint(0, H - 1), random.randint(0, W - 1)
        if (r, c) in occupied or (r, c) in drawn:
            continue
        if prefer_outside and _in_bbox((r, c), bbox):
            continue
        inp[r, c] = color
        occupied.add((r, c))
        return (r, c)
    return None


