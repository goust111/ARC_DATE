+
+
+def _bbox_is_full(bbox: tuple[int, int, int, int], H: int, W: int) -> bool:
+    return bbox == (0, 0, H - 1, W - 1)
+
+
+def _in_bbox(cell: tuple[int, int], bbox: tuple[int, int, int, int]) -> bool:
+    r, c = cell
+    r0, c0, r1, c1 = bbox
+    return r0 <= r <= r1 and c0 <= c <= c1
+
+
+def _place_distractor(
