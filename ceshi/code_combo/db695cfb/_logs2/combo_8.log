    81	def _diag_path(p: Coord, q: Coord) -> list[Coord]:
    82	    r0, c0 = p
    83	    r1, c1 = q
    84	    dr = 1 if r1 > r0 else -1
    85	    dc = 1 if c1 > c0 else -1
    86	    steps = abs(r1 - r0)
    87	    return [(r0 + k * dr, c0 + k * dc) for k in range(steps + 1)]
    88	
    89	
    90	def _orientation_dirs(orientation: int) -> tuple[Coord, Coord]:
    91	    if orientation == 1:
    92	        return ((1, 1), (-1, -1))
    93	    return ((1, -1), (-1, 1))
    94	
    95	
    96	def _full_diagonal_cells(origin: Coord, orientation: int, H: int, W: int) -> list[Coord]:
    97	    cells = [origin]
    98	    for dr, dc in _orientation_dirs(orientation):
    99	        r, c = origin
   100	        while True:
   101	            r += dr
   102	            c += dc
   103	            if not (0 <= r < H and 0 <= c < W):
   104	                break
   105	            cells.append((r, c))
   106	    return cells
   107	
   108	
   109	def _line_constants(cell: Coord) -> tuple[int, int]:
   110	    r, c = cell
   111	    return r - c, r + c
   112	
   113	
   114	def _intersect(backslash_const: int, slash_const: int, H: int, W: int) -> Coord | None:
   115	    total = backslash_const + slash_const
   116	    diff = slash_const - backslash_const
   117	    if total % 2 != 0 or diff % 2 != 0:
   118	        return None
   119	    r = total // 2
   120	    c = diff // 2
   121	    if 0 <= r < H and 0 <= c < W:
   122	        return (r, c)
   123	    return None
   124	
   125	
   126	def _find_line_color(non_bg: list[tuple[int, int, int]]) -> int:
   127	    by_color: dict[int, list[Coord]] = {}
   128	    for r, c, col in non_bg:
   129	        by_color.setdefault(col, []).append((r, c))
   130	
   131	    best: tuple[int, int] | None = None
   132	    for col, pts in by_color.items():
   133	        if len(pts) < 2:
   134	            continue
   135	        for i in range(len(pts)):
   136	            r0, c0 = pts[i]
   137	            for j in range(i + 1, len(pts)):
   138	                r1, c1 = pts[j]
   139	                dr = r1 - r0
   140	                dc = c1 - c0
   141	                if dr == 0 or abs(dr) != abs(dc):
   142	                    continue
   143	                cand = (abs(dr), col)
   144	                if best is None or cand > best:
   145	                    best = cand
   146	
   147	    assert best is not None, "at least one diagonal-aligned same-color pair must exist"
