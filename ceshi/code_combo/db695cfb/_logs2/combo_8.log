   275	                if iterative and (r, c) in input_trigger_cells:
   276	                    enqueue((r, c, emit_orientation, int(g[r, c])), "relay")
   277	
   278	                if iterative and (r, c) in seen_by_orientation[-emit_orientation]:
   279	                    enqueue((r, c, emit_orientation, tcol), "cross")
   280	                    enqueue((r, c, -emit_orientation, tcol), "cross")

