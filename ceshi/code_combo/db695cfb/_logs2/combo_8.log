+
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        inp = _gen_attempt()
+        if inp is not None:
+            return inp
+    raise RuntimeError(f"Failed to generate valid fused input after {GEN_RETRIES} attempts")

