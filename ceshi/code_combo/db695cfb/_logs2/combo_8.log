   312	def _try_place_segment(slope_type: str, seg_len: int, H: int, W: int, blocked: set[Coord]) -> list[Coord] | None:
   313	    for _ in range(SEGMENT_PLACE_RETRIES):
   314	        if slope_type == "backslash":
   315	            if seg_len >= H or seg_len >= W:
   316	                return None
   317	            r0 = random.randint(0, H - 1 - seg_len)
   318	            c0 = random.randint(0, W - 1 - seg_len)
   319	            dc = 1
   320	        else:
   321	            if seg_len >= H or seg_len >= W:
   322	                return None
   323	            r0 = random.randint(0, H - 1 - seg_len)
   324	            c0 = random.randint(seg_len, W - 1)
   325	            dc = -1
   326	
   327	        path = [(r0 + k, c0 + k * dc) for k in range(seg_len + 1)]
   328	        if any(cell in blocked for cell in path):
   329	            continue
   330	        return path
   331	    return None
   332	
   333	
   334	def _build_candidate_input(
   335	    H: int,
   336	    W: int,
   337	    bg: int,
   338	    path_a: list[Coord],
   339	    path_b: list[Coord],
   340	    seed_a: Coord,
   341	    seed_b: Coord,
   342	    relay_a: Coord,
   343	    relay_b: Coord,
   344	) -> np.ndarray:
   345	    grid = np.full((H, W), bg, dtype=int)
   346	    for cell in (path_a[0], path_a[-1], path_b[0], path_b[-1]):
   347	        grid[cell] = LINE_COLOR
   348	    for cell in (seed_a, seed_b, relay_a, relay_b):
   349	        grid[cell] = TRIGGER_COLOR
   350	    return grid
   351	
   352	
   353	def _one_step_magenta_count(grid: np.ndarray) -> int:
   354	    out, _metrics = _simulate(grid, iterative=False)
   355	    return int(np.sum(out == TRIGGER_COLOR))
   356	
