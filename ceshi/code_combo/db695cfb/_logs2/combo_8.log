   193	def _simulate(grid: np.ndarray, *, iterative: bool) -> tuple[np.ndarray, dict[str, object]]:
   194	    g = np.asarray(grid, dtype=int)
   195	    H, W = g.shape
   196	    bg = int(get_bg(g))
   197	    out = g.copy()
   198	
   199	    line_color, segments = _collect_segments(g, bg)
   200	    input_trigger_cells = {
   201	        (r, c)
   202	        for r in range(H)
   203	        for c in range(W)
   204	        if int(g[r, c]) != bg and int(g[r, c]) != line_color
   205	    }
