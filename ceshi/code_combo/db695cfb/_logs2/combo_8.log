   207	    seed_trigger_cells: set[Coord] = set()
   208	    queue: deque[Event] = deque()
   209	    queued: set[Event] = set()
   210	    processed: set[Event] = set()
   211	    seen_by_orientation: dict[int, set[Coord]] = {1: set(), -1: set()}
   212	
   213	    metrics = {
   214	        "seed_event_count": 0,
   215	        "relay_activation_cells": set(),
   216	        "cross_activation_cells": set(),
   217	        "input_trigger_cells": set(input_trigger_cells),
   218	        "segment_trigger_cells": seed_trigger_cells,
   219	    }
   220	
   221	    def enqueue(event: Event, cause: str) -> None:
   222	        if event in processed or event in queued:
   223	            return
   224	        queued.add(event)
   225	        queue.append(event)
   226	        r, c, _incoming_orientation, _col = event
