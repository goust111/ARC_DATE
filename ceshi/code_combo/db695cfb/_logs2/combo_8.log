   358	def _gen_attempt() -> np.ndarray | None:
   359	    H = random.randint(*H_RANGE)
   360	    W = random.randint(*W_RANGE)
   361	    bg = random.choice([c for c in range(10) if c not in (LINE_COLOR, TRIGGER_COLOR)])
   362	
   363	    len_a = random.randint(*SEG_LEN_RANGE)
   364	    len_b = random.randint(*SEG_LEN_RANGE)
   365	    max_len = min(H - 1, W - 1)
   366	    if min(len_a, len_b) > max_len:
   367	        return None
   368	    len_a = min(len_a, max_len)
   369	    len_b = min(len_b, max_len)
   370	
   371	    path_a = _try_place_segment("backslash", len_a, H, W, set())
   372	    if path_a is None:
   373	        return None
   374	    blocked = set(path_a)
   375	    path_b = _try_place_segment("slash", len_b, H, W, blocked)
   376	    if path_b is None:
   377	        return None
   378	
   379	    interior_a = path_a[1:-1]
   380	    interior_b = path_b[1:-1]
   381	    if len(interior_a) < 2 or len(interior_b) < 2:
   382	        return None
   383	
   384	    random.shuffle(interior_a)
   385	    random.shuffle(interior_b)
   386	
   387	    occupied = set(path_a) | set(path_b)
   388	
   389	    for seed_a in interior_a:
   390	        s_a = seed_a[0] + seed_a[1]
   391	        for seed_b in interior_b:
   392	            k_b = seed_b[0] - seed_b[1]
