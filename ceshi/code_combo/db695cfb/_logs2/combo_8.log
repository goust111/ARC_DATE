   401	            ]
   402	            line_b = [
   403	                cell
   404	                for cell in _full_diagonal_cells(seed_b, 1, H, W)
   405	                if cell not in occupied and cell != cross0 and cell != seed_a
   406	            ]
   407	            random.shuffle(line_a)
   408	            random.shuffle(line_b)
