   151	def _collect_segments(grid: np.ndarray, bg: int) -> tuple[int, list[dict[str, object]]]:
   152	    H, W = grid.shape
   153	    non_bg = [(r, c, int(grid[r, c])) for r in range(H) for c in range(W) if int(grid[r, c]) != bg]
   154	    assert non_bg, "grid must contain at least one non-background pixel"
   155	
   156	    line_color = _find_line_color(non_bg)
   157	    pts = [(r, c) for r, c, col in non_bg if col == line_color]
   158	
   159	    groups_a: dict[int, list[Coord]] = {}
   160	    groups_b: dict[int, list[Coord]] = {}
   161	    for r, c in pts:
   162	        groups_a.setdefault(r - c, []).append((r, c))
   163	        groups_b.setdefault(r + c, []).append((r, c))
   164	
   165	    segments: list[dict[str, object]] = []
   166	    seen_pairs: set[tuple[Coord, Coord]] = set()
   167	
   168	    def add_segment(group: list[Coord], orientation: int) -> None:
   169	        if len(group) < 2:
   170	            return
   171	        ordered = sorted(group)
   172	        p, q = ordered[0], ordered[-1]
   173	        key = (p, q)
   174	        if key in seen_pairs:
   175	            return
   176	        seen_pairs.add(key)
   177	        segments.append(
   178	            {
   179	                "endpoints": (p, q),
   180	                "path": _diag_path(p, q),
   181	                "orientation": orientation,
   182	            }
   183	        )
   184	
   185	    for group in groups_a.values():
   186	        add_segment(group, 1)
   187	    for group in groups_b.values():
   188	        add_segment(group, -1)
   189	
   190	    return line_color, segments
