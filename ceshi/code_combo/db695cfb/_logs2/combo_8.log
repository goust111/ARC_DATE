   421	                    _, s_2 = _line_constants(relay_b)
   422	                    if s_2 == s_a:
   423	                        continue
   424	                    cross2 = _intersect(k_1, s_2, H, W)
   425	                    if cross2 is None:
   426	                        continue
   427	                    if cross2 in occupied or cross2 in {seed_a, seed_b, relay_a, relay_b, cross0}:
   428	                        continue
   429	                    if cross2 in _full_diagonal_cells(seed_a, -1, H, W) or cross2 in _full_diagonal_cells(seed_b, 1, H, W):
   430	                        continue
   431	
   432	                    inp = _build_candidate_input(H, W, bg, path_a, path_b, seed_a, seed_b, relay_a, relay_b)
   433	                    out, metrics = _simulate(inp, iterative=True)
   434	                    base_magenta = _one_step_magenta_count(inp)
   435	                    cascade_gain = int(np.sum(out == TRIGGER_COLOR)) - base_magenta
   436	
   437	                    if cascade_gain <= 0:
   438	                        continue
   439	                    if len(metrics["relay_activation_cells"]) < 2:
   440	                        continue
   441	                    if len(metrics["cross_activation_cells"]) < 2:
   442	                        continue
   443	                    if cross0 not in metrics["cross_activation_cells"] and cross2 not in metrics["cross_activation_cells"]:
   444	                        continue
   445	                    return inp
   446	
   447	    return None
   448	
   449	
   450	def generate_input() -> np.ndarray:
   451	    for _ in range(GEN_RETRIES):
   452	        inp = _gen_attempt()
   453	        if inp is not None:
   454	            return inp
   455	    raise RuntimeError(f"Failed to generate valid fused input after {GEN_RETRIES} attempts")

