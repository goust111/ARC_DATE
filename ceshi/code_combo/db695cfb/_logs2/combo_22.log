   228	            if int(out[r, c]) == bg:
   229	                out[r, c] = line_color
   230	
   231	            original = int(grid[r, c])
   232	            if original in (bg, line_color):
   233	                continue
   234	            comp_idx = cell_to_component.get((r, c))
   235	            if comp_idx is None:
   236	                continue
   237	            entry = touched_by_component.setdefault(
   238	                comp_idx,
   239	                {"indices": [], "cells": set(), "color": int(original)},
   240	            )
   241	            entry["indices"].append(idx)
   242	            entry["cells"].add((r, c))
   243	
   244	        ordered_blocks: list[dict[str, object]] = []
   245	        for comp_idx, info in touched_by_component.items():
   246	            indices = sorted(set(int(v) for v in info["indices"]))
   247	            if not indices:
   248	                continue
   249	            ordered_blocks.append(
   250	                {
   251	                    "component": comp_idx,
   252	                    "start": indices[0],
   253	                    "end": indices[-1],
   254	                    "cells": sorted(info["cells"]),
   255	                    "color": int(info["color"]),
   256	                    "component_cells": components[comp_idx]["cells"],
   257	                }
   258	            )
   259	
   260	        ordered_blocks.sort(key=lambda item: int(item["start"]))
   261	        for left, right, gap in _greedy_adjacent_block_pairs(ordered_blocks):
   262	            if gap <= 0:
   263	                continue
   264	            for block in (left, right):
   265	                for r0, c0 in block["cells"]:
   266	                    emissions.append((r0, c0, int(block["color"]), perp_dirs, gap))
   267	
   268	    for g in groups_a.values():
   269	        if len(g) >= 2:
   270	            g = sorted(g)
   271	            draw_segment(g[0], g[-1])
   272	
   273	    for g in groups_b.values():
   274	        if len(g) >= 2:
   275	            g = sorted(g)
   276	            draw_segment(g[0], g[-1])
   277	
   278	    for r0, c0, tcol, dirs, ray_len in emissions:
   279	        for ddr, ddc in dirs:
   280	            for step in range(1, ray_len + 1):
   281	                r = r0 + ddr * step
   282	                c = c0 + ddc * step
   283	                if not (0 <= r < h and 0 <= c < w):
   284	                    break
   285	                if int(out[r, c]) == bg:
   286	                    out[r, c] = tcol
   287	
   288	    return out
   289	
   290	
   291	# --------------- generator ---------------
   292	
   293	# === CFG: canvas and structural bounds ===
   294	_H_RANGE = (10, 25)
   295	_W_RANGE = (10, 21)
   296	_LINE_COLOR = 1
   297	_TRIGGER_COLOR = 6
   298	_SEGMENT_COUNT = (1, 3)
   299	_SEG_LEN_RANGE = (9, 16)
   300	_PAIR_GAP_RANGE = (2, 4)
   301	
