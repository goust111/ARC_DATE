    total = 0
    for kind in pattern:
        total += 1 if kind == "lone" else (_PAIR_GAP_RANGE[0] + 1)
    if len(pattern) >= 2:
        total += _GROUP_SEP_MIN * (len(pattern) - 1)
    return total


def _plan_trigger_layout(interior_len, require_pair):
    patterns = [()]
    for pattern in [
        ("pair",),
        ("pair", "lone"),
        ("lone", "pair"),
        ("pair", "pair"),
    ]:
        if _pattern_min_cells(pattern) <= interior_len:
            patterns.append(pattern)


