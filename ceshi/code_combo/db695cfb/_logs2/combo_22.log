+
+    occupied: set[tuple[int, int]] = set()
+    drawn: set[tuple[int, int]] = set()
+    magenta_cells: set[tuple[int, int]] = set()
+    path_cells: set[tuple[int, int]] = set()
+    segments: list[dict[str, object]] = []
+
+    used_a: set[int] = set()
+    used_b: set[int] = set()
