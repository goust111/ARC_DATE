def live_modes(inp):
    bg = get_bg(inp)
    legend = mod._read_legend(inp, bg)
    h, w = inp.shape
    pts = [(r, c) for r in range(h) for c in range(mod._LEGEND_W, w) if int(inp[r, c]) == mod._LINE_COLOR]
    groups_a = {}
    groups_b = {}
    modes = []
    colors = []
    for r, c in pts:
        groups_a.setdefault(r - c, []).append((r, c))
        groups_b.setdefault(r + c, []).append((r, c))
    for groups in (groups_a, groups_b):
        for group in groups.values():
            if len(group) < 2:
