   111	    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
   112	
   113	
   114	def _diag_path(p: tuple[int, int], q: tuple[int, int]) -> list[tuple[int, int]]:
   115	    r0, c0 = p
   116	    r1, c1 = q
