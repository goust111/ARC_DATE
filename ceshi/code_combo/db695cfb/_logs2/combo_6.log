    95	_SEG_LEN_RANGE = (3, 16)
    96	_TRIGGERS_PER_SEG = (0, 2)
    97	_DECOY_ARROW_COUNT = (1, 1)
    98	
    99	# === CFG: distractors ===
   100	_OFF_DIAG_TRIGGERS = (0, 3)
   101	
   102	# === CFG: retry limits ===
   103	_SEGMENT_PLACE_RETRIES = 140
   104	_MARKER_PLACE_RETRIES = 12
   105	_DECOY_PLACE_RETRIES = 80
   106	_DISTRACTOR_RETRIES = 80
