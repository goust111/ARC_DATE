+def _shares_axis_or_diagonal(cell: tuple[int, int], others: list[tuple[int, int]] | set[tuple[int, int]]) -> bool:
+    r, c = cell
+    return any(r == rr or c == cc or abs(r - rr) == abs(c - cc) for rr, cc in others)
