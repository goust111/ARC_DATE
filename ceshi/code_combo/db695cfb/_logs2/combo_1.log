+def _straight_path(p: tuple[int, int], q: tuple[int, int]) -> list[tuple[int, int]]:
+    if p[0] == q[0]:
+        lo, hi = sorted((p[1], q[1]))
+        return [(p[0], c) for c in range(lo, hi + 1)]
+    lo, hi = sorted((p[0], q[0]))
