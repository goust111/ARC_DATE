+
+# --------------- generator (c) ---------------
+
+# === CFG: canvas and structural bounds ===
+_H_RANGE = (8, 25)
+_W_RANGE = (9, 21)
+_LINE_COLOR = 1
+_TRIGGER_COLOR = 6
+_SEGMENT_COUNT = (1, 3)
+_SEG_LEN_RANGE = (3, 16)
+_TRIGGERS_PER_SEG = (0, 1)
+
+# === CFG: distractor counts ===
+_UNPAIRED_LINE_PIXELS = (0, 2)
+_OFF_SEG_TRIGGERS = (0, 3)
+
+# === CFG: retry limits ===
+_SEGMENT_PLACE_RETRIES = 120
+_DISTRACTOR_RETRIES = 80
+_GEN_RETRIES = 500
