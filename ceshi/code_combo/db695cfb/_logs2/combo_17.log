+    for g in groups_a.values():
+        if len(g) >= 2:
+            g = sorted(g)
+            draw_segment(g[0], g[-1])
+
+    for g in groups_b.values():
+        if len(g) >= 2:
+            g = sorted(g)
+            draw_segment(g[0], g[-1])
+
+    for (r0, c0, tcol), reach_by_dir in triggers.items():
+        for (ddr, ddc), reach in reach_by_dir.items():
+            for step in range(1, reach + 1):
+                r = r0 + ddr * step
+                c = c0 + ddc * step
