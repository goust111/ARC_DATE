+        for step in range(1, reach + 1):
+            cells.add((tr + ddr * step, tc + ddc * step))
+    return cells
+
+
+def _segment_metrics(
+    trigger_specs: list[tuple[int, int, int, tuple[int, int]]], h: int, w: int
+) -> tuple[int, int, int]:
+    truncated_total = 0
