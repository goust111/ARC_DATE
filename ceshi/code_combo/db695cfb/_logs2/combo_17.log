+
+        path = [(r0 + k, c0 + k * dc) for k in range(seg_len + 1)]
+        if any(rc in occupied or rc in drawn for rc in path):
+            continue
+        endpoints = (path[0], path[-1])
+        if any(abs(r - lr) == abs(c - lc) for r, c in endpoints for lr, lc in line_positions):
