+# === CFG: canvas and structural bounds ===
+_H_RANGE = (8, 25)
+_W_RANGE = (9, 21)
+_LINE_COLOR = 1
+_TRIGGER_COLOR = 6
+_SEGMENT_COUNT = (1, 3)
+_SEG_LEN_RANGE = (6, 16)
+_TRIGGERS_PER_SEG = (2, 4)
