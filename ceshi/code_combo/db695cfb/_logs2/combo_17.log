+    groups_a: dict[int, list[tuple[int, int]]] = {}
+    groups_b: dict[int, list[tuple[int, int]]] = {}
+    for r, c in pts:
+        groups_a.setdefault(r - c, []).append((r, c))
+        groups_b.setdefault(r + c, []).append((r, c))
