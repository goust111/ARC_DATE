        selected.append((tr, tc))
        used_cross.update(cross)
        used_ray.update(ray)
        extra_cross.update(cross_extra)

    if len(selected) < min_needed:
        return None

    selected_set = set(selected)
    return selected, extra_cross, used_ray, set(path[1:-1]) - selected_set


