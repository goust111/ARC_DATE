   360	) -> np.ndarray:
   361	    inp = np.full((H, W), bg, dtype=int)
   362	    for ep0, ep1, trigger_positions, _path in segments:
   363	        inp[ep0] = _LINE_COLOR
   364	        inp[ep1] = _LINE_COLOR
   365	        for tp in trigger_positions:
   366	            inp[tp] = _TRIGGER_COLOR
