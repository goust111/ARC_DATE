   129	def _extract_segments(pts: list[tuple[int, int]]):
   130	    groups_a: dict[int, list[tuple[int, int]]] = {}
   131	    groups_b: dict[int, list[tuple[int, int]]] = {}
   132	    for r, c in pts:
   133	        groups_a.setdefault(r - c, []).append((r, c))
   134	        groups_b.setdefault(r + c, []).append((r, c))
   135	
   136	    segments = []
   137	    for groups in (groups_a, groups_b):
   138	        for group_pts in groups.values():
   139	            if len(group_pts) < 2:
   140	                continue
   141	            group_pts = sorted(group_pts)
   142	            p = group_pts[0]
   143	            q = group_pts[-1]
   144	            path = _diag_path(p, q)
   145	            dr = 1 if q[0] > p[0] else -1
   146	            dc = 1 if q[1] > p[1] else -1
   147	            segments.append(
   148	                {
   149	                    "path": path,
   150	                    "path_set": frozenset(path),
   151	                    "main_dirs": ((dr, dc), (-dr, -dc)),
   152	                    "reflect_dirs": ((dr, -dc), (-dr, dc)),
   153	                }
   154	            )
   155	    return segments
