    97	def _diag_path(p: tuple[int, int], q: tuple[int, int]) -> list[tuple[int, int]]:
    98	    r0, c0 = p
    99	    r1, c1 = q
   100	    dr = 1 if r1 > r0 else -1
   101	    dc = 1 if c1 > c0 else -1
   102	    steps = abs(r1 - r0)
   103	    return [(r0 + k * dr, c0 + k * dc) for k in range(steps + 1)]
   104	
   105	
   106	def _find_line_color(
   107	    by_color: dict[int, list[tuple[int, int]]],
   108	) -> tuple[int, list[tuple[int, int]]]:
   109	    best = None
   110	    for col, pts in by_color.items():
   111	        if len(pts) < 2:
   112	            continue
   113	        for i in range(len(pts)):
   114	            r0, c0 = pts[i]
   115	            for j in range(i + 1, len(pts)):
   116	                r1, c1 = pts[j]
   117	                dr = r1 - r0
   118	                dc = c1 - c0
   119	                if dr == 0 or abs(dr) != abs(dc):
   120	                    continue
   121	                cand = (abs(dr), int(col))
   122	                if best is None or cand > best:
   123	                    best = cand
   124	    assert best is not None, "at least one diagonal-aligned same-color pair must exist"
   125	    line_color = int(best[1])
   126	    return line_color, by_color[line_color]
