   158	def _prepare_scene(grid: np.ndarray):
   159	    g = np.asarray(grid, dtype=int)
   160	    h, w = g.shape
   161	    bg = int(get_bg(g))
   162	    non_bg = [(r, c, int(g[r, c])) for r in range(h) for c in range(w) if int(g[r, c]) != bg]
   163	    assert non_bg, "grid must contain at least one non-background pixel"
   164	
   165	    by_color: dict[int, list[tuple[int, int]]] = {}
   166	    for r, c, col in non_bg:
   167	        by_color.setdefault(int(col), []).append((r, c))
   168	
   169	    line_color, pts = _find_line_color(by_color)
   170	    segments = _extract_segments(pts)
   171	    assert segments, "expected at least one segment after grouping line-color pixels"
   172	    return g, bg, line_color, segments
