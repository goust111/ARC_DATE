   318	def _try_place_segment(
   319	    slope_type: str,
   320	    seg_len: int,
   321	    H: int,
   322	    W: int,
   323	    used_a_keys: set[int],
   324	    used_b_keys: set[int],
   325	    occupied_paths: set[tuple[int, int]],
   326	):
   327	    for _ in range(_SEGMENT_PLACE_RETRIES):
   328	        if slope_type == "backslash":
   329	            if H - 2 - seg_len < 1 or W - 2 - seg_len < 1:
   330	                return None
   331	            r0 = random.randint(1, H - 2 - seg_len)
   332	            c0 = random.randint(1, W - 2 - seg_len)
   333	            dc = 1
   334	        else:
   335	            if H - 2 - seg_len < 1 or seg_len + 1 > W - 2:
   336	                return None
   337	            r0 = random.randint(1, H - 2 - seg_len)
   338	            c0 = random.randint(seg_len + 1, W - 2)
   339	            dc = -1
   340	
   341	        path = [(r0 + k, c0 + k * dc) for k in range(seg_len + 1)]
   342	        if any(cell in occupied_paths for cell in path):
   343	            continue
   344	
   345	        ep0 = path[0]
   346	        ep1 = path[-1]
   347	        a0, a1 = ep0[0] - ep0[1], ep1[0] - ep1[1]
   348	        b0, b1 = ep0[0] + ep0[1], ep1[0] + ep1[1]
   349	        if a0 in used_a_keys or a1 in used_a_keys or b0 in used_b_keys or b1 in used_b_keys:
   350	            continue
   351	        return path, dc
   352	    return None
