        ep0, ep1 = path[0], path[-1]
        segments.append((ep0, ep1, trigger_positions, path, branch_dirs))
        occupied.update([ep0, ep1])
        occupied.update(trigger_positions)
        drawn.update(path_set - {ep0, ep1} - set(trigger_positions))
