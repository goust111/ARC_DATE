    trigger: tuple[int, int],
    perp_dirs: list[tuple[int, int]],
    reach: int,
    h: int,
    w: int,
) -> bool:
    tr, tc = trigger
    for ddr, ddc in perp_dirs:
        for step in range(1, reach + 1):
            r = tr + step * ddr
            c = tc + step * ddc
            if not (0 <= r < h and 0 <= c < w):
                return True
    return False


