+# --------------- generator (combo) ---------------
+
+# === CFG: canvas and structural bounds ===
+_H_RANGE = (10, 20)
+_W_RANGE = (10, 20)
+_LINE_COLOR = 1
+_TRIGGER_COLOR = 6
+_SEGMENT_COUNT = 2
+_SEG_LEN_RANGE = (6, 14)
+
+# === CFG: distractor counts ===
+_UNPAIRED_LINE_PIXELS = (0, 1)
+_OFF_DIAG_TRIGGERS = (0, 1)
