+def _ray_exits_input(
+    trigger_pos: tuple[int, int],
+    perp_dirs: list[tuple[int, int]],
+    ray_limit: int,
+    h: int,
+    w: int,
+) -> bool:
+    tr, tc = trigger_pos
+    for ddr, ddc in perp_dirs:
