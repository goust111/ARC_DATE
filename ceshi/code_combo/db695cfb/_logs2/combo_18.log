+        seg_len = random.randint(_SEG_LEN_RANGE[0], min(max_seg_len, _SEG_LEN_RANGE[1]))
+        result = _try_place_segment(
+            slope_type,
+            seg_len,
+            H,
+            W,
+            occupied,
+            reserved,
+            used_backslash,
+            used_slash,
+            line_positions,
+            trigger_positions_all,
