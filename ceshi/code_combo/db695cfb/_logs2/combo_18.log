    45	def _ordered_endpoints(p: tuple[int, int], q: tuple[int, int]) -> tuple[tuple[int, int], tuple[int, int]]:
    46	    """Order endpoints by row, then by column."""
    47	    return (p, q) if p < q else (q, p)
    48	
    49	
    50	def _l_path(p: tuple[int, int], q: tuple[int, int]) -> list[tuple[int, int]]:
    51	    """Top-row-first shortest L path between diagonal endpoints."""
    52	    (r0, c0), (r1, c1) = _ordered_endpoints(p, q)
    53	    assert r0 != r1 and c0 != c1
    54	
    55	    hstep = 1 if c1 > c0 else -1
    56	    path = [(r0, c) for c in range(c0, c1 + hstep, hstep)]
    57	    path.extend((r, c1) for r in range(r0 + 1, r1 + 1))
    58	    return path
    59	
    60	
    61	def _perp_dirs(p: tuple[int, int], q: tuple[int, int]) -> list[tuple[int, int]]:
    62	    """Perpendicular diagonal ray directions implied by the original endpoint diagonal."""
    63	    (r0, c0), (r1, c1) = _ordered_endpoints(p, q)
    64	    dc = 1 if c1 > c0 else -1
    65	    return [(1, -dc), (-1, dc)]
