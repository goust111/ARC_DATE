   226	
   227	def _try_place_segment(
   228	    slope_type: str,
   229	    seg_len: int,
   230	    H: int,
   231	    W: int,
   232	    occupied: set[tuple[int, int]],
   233	    reserved: set[tuple[int, int]],
   234	    used_backslash: set[int],
   235	    used_slash: set[int],
   236	    line_positions: list[tuple[int, int]],
   237	    trigger_positions_all: list[tuple[int, int]],
   238	):
   239	    for _ in range(_SEGMENT_PLACE_RETRIES):
   240	        if slope_type == "backslash":
   241	            if H - 1 - seg_len < 0 or W - 1 - seg_len < 0:
   242	                return None
   243	            r0 = random.randint(0, H - 1 - seg_len)
   244	            c0 = random.randint(0, W - 1 - seg_len)
   245	            ep0 = (r0, c0)
   246	            ep1 = (r0 + seg_len, c0 + seg_len)
   247	            diag_id = r0 - c0
   248	            if diag_id in used_backslash:
   249	                continue
   250	        else:
   251	            if H - 1 - seg_len < 0 or seg_len > W - 1:
   252	                return None
   253	            r0 = random.randint(0, H - 1 - seg_len)
   254	            c0 = random.randint(seg_len, W - 1)
   255	            ep0 = (r0, c0)
   256	            ep1 = (r0 + seg_len, c0 - seg_len)
   257	            diag_id = r0 + c0
   258	            if diag_id in used_slash:
   259	                continue
