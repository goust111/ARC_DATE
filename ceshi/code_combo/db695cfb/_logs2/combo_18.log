+    reserved: set[tuple[int, int]] = set()
+    used_backslash: set[int] = set()
+    used_slash: set[int] = set()
+    line_positions: list[tuple[int, int]] = []
+    trigger_positions_all: list[tuple[int, int]] = []
+    segments = []
