    68	def _ray_cells_from_trigger(
    69	    trigger: tuple[int, int], dirs: list[tuple[int, int]], H: int, W: int
    70	) -> set[tuple[int, int]]:
    71	    cells: set[tuple[int, int]] = set()
    72	    tr, tc = trigger
    73	    for ddr, ddc in dirs:
    74	        r, c = tr + ddr, tc + ddc
    75	        while 0 <= r < H and 0 <= c < W:
    76	            cells.add((r, c))
    77	            r += ddr
    78	            c += ddc
    79	    return cells
    80	
    81	
    82	def _shares_diagonal(cell: tuple[int, int], positions: list[tuple[int, int]] | set[tuple[int, int]]) -> bool:
    83	    r, c = cell
    84	    for rr, cc in positions:
    85	        if r != rr and abs(r - rr) == abs(c - cc):
    86	            return True
    87	    return False
