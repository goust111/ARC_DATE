    90	def main(grid: np.ndarray) -> np.ndarray:
    91	    """
    92	    Complete each blue diagonal pair with a fixed L route, but let the first touched obstacle cut that route short and branch rays.
    93	
    94	    Input structure:
    95	    - The background is the most frequent color. One non-background color forms endpoint pairs that still lie on shared 45-degree diagonals, and magenta-like obstacle pixels may sit on the L route implied by those endpoints.
    96	
    97	    Rule:
    98	    - For every detected endpoint pair, sort the endpoints from top to bottom and draw the shortest L path that goes horizontally across the upper row first, then vertically down the destination column.
    99	    - While tracing that ordered L path, stop at the first non-line-color pixel instead of crossing it; keep that obstacle in place and emit the two perpendicular diagonal rays associated with the pair's original diagonal family, filling only background cells.
   100	
   101	    Key insight:
   102	    - The diagonal pair still tells you which two blue points belong together, but completion now uses a fixed bent route, and magenta is no longer transparent on that route: it marks both the split point for rays and the cut point of the blue path.
   103	    """
   104	
   105	    grid = np.asarray(grid, dtype=int)
   106	    h, w = grid.shape
   107	    out = grid.copy()
   108	
   109	    bg = get_bg(grid)
   110	    non_bg = [(r, c, int(grid[r, c])) for r in range(h) for c in range(w) if int(grid[r, c]) != bg]
   111	    assert non_bg, "grid must contain at least one non-background pixel"
   112	
   113	    by_color: dict[int, list[tuple[int, int]]] = {}
   114	    for r, c, col in non_bg:
   115	        by_color.setdefault(col, []).append((r, c))
   116	
   117	    best = None  # (dist, color)
   118	    for col, pts in by_color.items():
   119	        if len(pts) < 2:
   120	            continue
   121	        for i in range(len(pts)):
   122	            r0, c0 = pts[i]
   123	            for j in range(i + 1, len(pts)):
   124	                r1, c1 = pts[j]
   125	                dr = r1 - r0
   126	                dc = c1 - c0
   127	                if dr == 0 or abs(dr) != abs(dc):
   128	                    continue
   129	                cand = (abs(dr), col)
   130	                if best is None or cand > best:
   131	                    best = cand
   132	
   133	    assert best is not None, "at least one diagonal-aligned same-color pair must exist"
   134	
   135	    _, line_color = best
   136	    pts = by_color[line_color]
   137	    triggers: dict[tuple[int, int, int], set[tuple[int, int]]] = {}
   138	
   139	    groups_a: dict[int, list[tuple[int, int]]] = {}  # r - c constant
   140	    groups_b: dict[int, list[tuple[int, int]]] = {}  # r + c constant
   141	    for r, c in pts:
   142	        groups_a.setdefault(r - c, []).append((r, c))
   143	        groups_b.setdefault(r + c, []).append((r, c))
   144	
   145	    def draw_segment(p: tuple[int, int], q: tuple[int, int]) -> None:
   146	        path = _l_path(p, q)
   147	        perp_dirs = _perp_dirs(p, q)
   148	        for r, c in path:
   149	            v = int(out[r, c])
   150	            if v == bg:
   151	                out[r, c] = line_color
   152	            elif v != line_color:
   153	                triggers.setdefault((r, c, v), set()).update(perp_dirs)
   154	                break
   155	
   156	    for g in groups_a.values():
   157	        if len(g) >= 2:
   158	            g = sorted(g)
   159	            draw_segment(g[0], g[-1])
   160	
   161	    for g in groups_b.values():
   162	        if len(g) >= 2:
   163	            g = sorted(g)
   164	            draw_segment(g[0], g[-1])
   165	
   166	    for (r0, c0, tcol), dirs in triggers.items():
   167	        for ddr, ddc in dirs:
   168	            r, c = r0 + ddr, c0 + ddc
   169	            while 0 <= r < h and 0 <= c < w:
   170	                if int(out[r, c]) == bg:
   171	                    out[r, c] = tcol
   172	                r += ddr
   173	                c += ddc
   174	
   175	    return out
   176	
   177	
   178	# --------------- generator (combo) ---------------
   179	
   180	# === CFG: canvas and structural bounds ===
   181	_H_RANGE = (8, 25)
   182	_W_RANGE = (9, 21)
   183	_LINE_COLOR = 1
   184	_TRIGGER_COLOR = 6
   185	_SEGMENT_COUNT = (1, 4)
   186	_SEG_LEN_RANGE = (3, 16)
   187	_TRIGGERS_PER_SEG = (0, 1)
   188	
   189	# === CFG: distractor counts ===
   190	_UNPAIRED_LINE_PIXELS = (0, 2)
   191	_OFF_PATH_TRIGGERS = (0, 4)
   192	
   193	# === CFG: retry limits ===
   194	_SEGMENT_PLACE_RETRIES = 120
   195	_DISTRACTOR_RETRIES = 80
   196	_GEN_RETRIES = 500
   197	
   198	
   199	def _compute_line_cells(path: list[tuple[int, int]], trigger_positions: list[tuple[int, int]]) -> set[tuple[int, int]]:
   200	    trigger_set = set(trigger_positions)
   201	    cells: set[tuple[int, int]] = set()
   202	    for r, c in path:
   203	        if (r, c) in trigger_set:
   204	            break
   205	        cells.add((r, c))
   206	    return cells
   207	
   208	
   209	def _build_expected(inp: np.ndarray, bg: int, segments) -> np.ndarray:
   210	    H, W = inp.shape
   211	    expected = inp.copy()
   212	    for _, _, trigger_positions, path, perp_dirs in segments:
   213	        for r, c in _compute_line_cells(path, trigger_positions):
   214	            if expected[r, c] == bg:
   215	                expected[r, c] = _LINE_COLOR
   216	        for tr, tc in trigger_positions:
   217	            for ddr, ddc in perp_dirs:
   218	                r, c = tr + ddr, tc + ddc
   219	                while 0 <= r < H and 0 <= c < W:
   220	                    if expected[r, c] == bg:
   221	                        expected[r, c] = _TRIGGER_COLOR
   222	                    r += ddr
   223	                    c += ddc
   224	    return expected
