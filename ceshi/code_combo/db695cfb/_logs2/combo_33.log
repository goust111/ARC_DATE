   154	    r0, c0 = p
   155	    r1, c1 = q
   156	    dr = 1 if r1 > r0 else -1
   157	    dc = 1 if c1 > c0 else -1
   158	    steps = abs(r1 - r0)
   159	    return [(r0 + k * dr, c0 + k * dc) for k in range(steps + 1)]
   160	
   161	
   162	def _best_diagonal_pair(by_color: dict[int, list[tuple[int, int]]]) -> tuple[int, int] | None:
   163	    best = None  # (distance, color)
   164	    for col, pts in by_color.items():
   165	        if len(pts) < 2:
   166	            continue
   167	        for i in range(len(pts)):
   168	            r0, c0 = pts[i]
   169	            for j in range(i + 1, len(pts)):
   170	                r1, c1 = pts[j]
   171	                dr = r1 - r0
   172	                dc = c1 - c0
   173	                if dr == 0 or abs(dr) != abs(dc):
   174	                    continue
   175	                cand = (abs(dr), col)
   176	                if best is None or cand > best:
   177	                    best = cand
   178	    return best
