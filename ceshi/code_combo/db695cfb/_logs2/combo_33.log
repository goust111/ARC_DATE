   184	    groups_a: dict[int, list[tuple[int, int]]] = {}
   185	    groups_b: dict[int, list[tuple[int, int]]] = {}
   186	    for r, c in points:
   187	        groups_a.setdefault(r - c, []).append((r, c))
   188	        groups_b.setdefault(r + c, []).append((r, c))
   189	    return groups_a, groups_b
