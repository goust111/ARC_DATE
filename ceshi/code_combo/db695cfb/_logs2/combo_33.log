    Returns:
        (value, used_name) or (None, None) if not found.
    """
    used = None
    if primary in kwargs:
        used = primary
    else:
        for a in aliases:
            if a in kwargs:
                used = a
                break
    if used is None:
        return None, None
    val = kwargs.pop(used)
    names = [primary, *aliases]
    for n in names:
        if n != used and n in kwargs:
            raise TypeError(f"got multiple values for {primary}: {used} and {n}")
