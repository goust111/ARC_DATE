+            if any(_diag_aligned((r, c), pos) for pos in all_magenta_positions):
+                continue
+            inp[r, c] = _TRIGGER_COLOR
+            occupied.add((r, c))
+            all_magenta_positions.append((r, c))
+            break
+
+    try:
+        result = main(inp)
+    except Exception:
+        return None
+
+    expected = _build_expected(inp, bg, segments)
+    if np.array_equal(result, expected):
+        return inp
+    return None
