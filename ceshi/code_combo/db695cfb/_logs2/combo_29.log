+
+import numpy as np
+
+from arc_utils import get_bg
+
+
+_LINE_COLOR = 1
+_UP_MARKER_COLOR = 2
+_DOWN_MARKER_COLOR = 3
+_TRIGGER_COLOR = 6
+
+
