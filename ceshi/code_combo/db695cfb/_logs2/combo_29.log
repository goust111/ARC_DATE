+
+    if not segments or total_active_triggers < _MIN_ACTIVE_TRIGGERS:
+        return None
+    if _REQUIRE_BOTH_DIRECTIONS and set(direction_flags) != {False, True}:
+        return None
+
+    inp = np.full((h, w), bg, dtype=int)
