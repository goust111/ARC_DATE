    cross_only = 0
    trigger_dir_map = {}
    for seg in segments:
        cross_only_cells = set(combo._exclusive_interior(seg['cross_path'], seg['direct_path']))
        direct_only_cells = set(combo._exclusive_interior(seg['direct_path'], seg['cross_path']))
        for pos in trigger_positions & cross_only_cells:
            cross_only += 1
            direct_dirs, _ = combo._segment_dirs(*seg['endpoints'])
            trigger_dir_map.setdefault(pos, set()).update(direct_dirs)
        for pos in trigger_positions & direct_only_cells:
            _, cross_dirs = combo._segment_dirs(*seg['endpoints'])
            trigger_dir_map.setdefault(pos, set()).update(cross_dirs)

    segs_with_triggers = []
    for seg in segments:
        direct_only_cells = set(combo._exclusive_interior(seg['direct_path'], seg['cross_path']))
        cross_only_cells = set(combo._exclusive_interior(seg['cross_path'], seg['direct_path']))
        seg_direct = [pos for pos in trigger_positions if pos in direct_only_cells]
        seg_cross = [pos for pos in trigger_positions if pos in cross_only_cells]
        segs_with_triggers.append(combo._make_segment(seg['endpoints'][0], seg['endpoints'][1], seg_direct, seg_cross))

    blue_counts, triggers = combo._build_structure_from_segments(segs_with_triggers)
    blue_blue = combo._count_blue_blue_specials(segs_with_triggers, out)
    blue_ray = combo._count_blue_ray_specials(segs_with_triggers, inp.shape[0], inp.shape[1], out)
    return {
        'cross_only': cross_only,
        'blue_blue': blue_blue,
        'blue_ray': blue_ray,
        'special_total': int(np.sum(out == combo._CROSS_COLOR)),
        'diff_orig': not np.array_equal(out, mods['orig'].main(inp)),
        'diff_d12': not np.array_equal(out, mods['d12'].main(inp)),
        'diff_d14': not np.array_equal(out, mods['d14'].main(inp)),
    }

rows = [metrics(combo.generate_input()) for _ in range(100)]
for key in ['cross_only', 'blue_blue', 'blue_ray', 'special_total']:
    vals = [row[key] for row in rows]
    print(f\"{key}: min={min(vals)}, max={max(vals)}, mean={mean(vals):.2f}\")
for key in ['diff_orig', 'diff_d12', 'diff_d14']:
    vals = [row[key] for row in rows]
