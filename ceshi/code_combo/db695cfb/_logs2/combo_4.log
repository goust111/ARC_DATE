+# Combo variant of db695cfb (index 4)
+# combo_spec: D2/3+D5/0
+# Name: 单侧延伸+颜色循环
+
+from __future__ import annotations
+
+import random
+import sys
+from pathlib import Path
+
+import numpy as np
+
