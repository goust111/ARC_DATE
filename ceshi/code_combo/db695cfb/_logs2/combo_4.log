            single_dir = _single_perp_dir_from_segment(dr, dc, r, c)
            if single_dir is None:
                continue
            ordered_triggers.append((r, c, single_dir))
        segments.append((path, dc, ordered_triggers))

    for g in groups_a.values():
        if len(g) >= 2:
            g = sorted(g)
            add_segment(g[0], g[-1])

    for g in groups_b.values():
        if len(g) >= 2:
            g = sorted(g)
