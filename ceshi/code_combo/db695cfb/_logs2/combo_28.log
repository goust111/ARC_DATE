+        max_pos = _max_steps_from(shared_trigger, 1, cross_dc, H, W)
+        if min(max_neg, max_pos) < 1:
+            continue
+
+        cross_choices = []
+        for neg in range(_CROSS_ARM_RANGE[0], min(_CROSS_ARM_RANGE[1], max_neg) + 1):
