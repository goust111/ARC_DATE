   147	        for r, c in path:
   148	            value = int(out[r, c])
   149	            if value == bg:
   150	                out[r, c] = line_color
   151	            elif value != line_color:
   152	                key = (r, c, value)
   153	                triggers.setdefault(key, set()).update(perp_dirs)
   154	
   155	    for p, q in pairs:
   156	        draw_segment(p, q)
   157	
   158	    for (r0, c0, tcol), dirs in triggers.items():
   159	        for ddr, ddc in dirs:
   160	            r, c = r0 + ddr, c0 + ddc
   161	            while 0 <= r < h and 0 <= c < w:
   162	                if int(out[r, c]) == bg:
   163	                    out[r, c] = tcol
   164	                r += ddr
   165	                c += ddc
   166	
