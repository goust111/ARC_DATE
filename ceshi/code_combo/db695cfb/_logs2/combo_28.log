   116	def main(grid: np.ndarray) -> np.ndarray:
   117	    """
   118	    Match multiple blue endpoints by nearest diagonal pairing, then let every magenta point on those matched segments emit all perpendicular rays implied by the segments that pass through it.
   119	
   120	    Input structure:
   121	    - The dominant color is background. Blue pixels form an even-sized endpoint set, typically with two short pairs on one diagonal plus another pair on the perpendicular diagonal. Magenta pixels may sit on one matched segment or at an intersection shared by multiple matched segments.
   122	
   123	    Rule:
   124	    - Compute the perfect matching of blue pixels using only diagonal-aligned candidate pairs; choose the one with minimum total diagonal length, breaking ties by coordinate order. Draw every matched pair as its own blue diagonal segment.
   125	    - Whenever a non-blue pixel lies on a drawn segment, treat it as a trigger for that segment's perpendicular diagonal directions. If the same magenta pixel lies on several matched segments, union all contributed directions and extend magenta rays to the border, filling only background cells.
   126	
   127	    Key insight:
   128	    - The decisive reasoning step is global pairing, not extreme-to-extreme connection. Once the correct short segments are chosen, a shared trigger can inherit perpendicular directions from more than one segment, so the final magenta pattern reflects both the pairing choice and the segment interaction.
   129	    """
   130	
   131	    grid = np.asarray(grid, dtype=int)
   132	    h, w = grid.shape
   133	    out = grid.copy()
   134	
   135	    bg = get_bg(grid)
   136	    line_color = 1
   137	
   138	    blue_points = [(r, c) for r in range(h) for c in range(w) if int(grid[r, c]) == line_color]
   139	    pairs = _best_blue_matching(blue_points)
   140	
