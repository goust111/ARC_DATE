    if len(comp) not in (2, 3):
        return False
    rows = sorted(r for r, _ in comp)
    cols = sorted(c for _, c in comp)
    if len(set(rows)) == 1:
        return cols == list(range(cols[0], cols[0] + len(comp)))
    if len(set(cols)) == 1:
