   170	def main(grid: np.ndarray) -> np.ndarray:
   171	    """
   172	    Recover a hidden diagonal connection between matching endpoints, then emit checkerboard-filtered perpendicular rays from trigger pixels without ever painting the main path itself.
   173	
   174	    Input structure:
   175	    - The canvas is a two-color 2x2-block checkerboard. One non-background color appears as paired diagonal endpoints, and differently colored trigger pixels may lie on the same hidden diagonal. All functional pixels sit on one of the two checkerboard colors.
   176	
   177	    Rule:
   178	    - Find the same-color diagonal pair with the longest span and connect the extremes of every diagonal group of that color geometrically, but keep that connecting path invisible.
   179	    - Whenever that hidden path passes through a differently colored pixel, emit the usual perpendicular diagonal rays in the trigger color, painting only those ray cells whose checkerboard background belongs to the active background color class.
   180	
   181	    Key insight:
   182	    - The blue segment is no longer a visible object; it is only an inferred scaffold defined by endpoint alignment. The visible transformation is therefore the magenta ray pattern, whose dashed rhythm is determined jointly by the hidden diagonal and by which checkerboard color is allowed to receive paint.
   183	    """
   184	
   185	    grid = np.asarray(grid, dtype=int)
   186	    h, w = grid.shape
   187	    out = grid.copy()
   188	
   189	    bg0, bg1 = _top_two_colors(grid)
   190	    bg_colors = {bg0, bg1}
   191	    bg_pair, row_phase, col_phase = _infer_checker_layout(grid, bg0, bg1)
   192	
   193	    non_bg = [(r, c, int(grid[r, c])) for r in range(h) for c in range(w) if int(grid[r, c]) not in bg_colors]
   194	    assert non_bg, "grid must contain at least one non-background pixel"
   195	
   196	    line_color, _ = _best_diagonal_color(non_bg)
   197	    line_pts = [(r, c) for r, c, col in non_bg if col == line_color]
   198	    active_bg = Counter(
   199	        _checker_color(r, c, bg_pair, row_phase, col_phase) for r, c, _ in non_bg
   200	    ).most_common(1)[0][0]
   201	
   202	    triggers: dict[tuple[int, int, int], set[tuple[int, int]]] = {}
   203	
   204	    groups_a: dict[int, list[tuple[int, int]]] = {}
   205	    groups_b: dict[int, list[tuple[int, int]]] = {}
   206	    for r, c in line_pts:
   207	        groups_a.setdefault(r - c, []).append((r, c))
   208	        groups_b.setdefault(r + c, []).append((r, c))
   209	
   210	    def trace_hidden_segment(p: tuple[int, int], q: tuple[int, int]) -> None:
   211	        path = _diag_path(p, q)
   212	        dr = 1 if q[0] > p[0] else -1
   213	        dc = 1 if q[1] > p[1] else -1
   214	        perp_dirs = [(dr, -dc), (-dr, dc)]
   215	        for r, c in path:
   216	            v = int(grid[r, c])
   217	            if v not in bg_colors and v != line_color:
   218	                key = (r, c, v)
   219	                triggers.setdefault(key, set()).update(perp_dirs)
   220	
   221	    for g in groups_a.values():
   222	        if len(g) >= 2:
   223	            g = sorted(g)
   224	            trace_hidden_segment(g[0], g[-1])
   225	
   226	    for g in groups_b.values():
   227	        if len(g) >= 2:
   228	            g = sorted(g)
   229	            trace_hidden_segment(g[0], g[-1])
   230	
   231	    for (r0, c0, tcol), dirs in triggers.items():
   232	        for ddr, ddc in dirs:
   233	            r, c = r0 + ddr, c0 + ddc
   234	            while 0 <= r < h and 0 <= c < w:
   235	                if (
   236	                    int(out[r, c]) in bg_colors
   237	                    and _checker_color(r, c, bg_pair, row_phase, col_phase) == active_bg
   238	                ):
   239	                    out[r, c] = tcol
   240	                r += ddr
   241	                c += ddc
   242	
   243	    return out
   244	
   245	
   246	# --------------- generator (c) ---------------
   247	
   248	# === CFG: canvas and structural bounds ===
   249	_H_RANGE = (10, 24)
   250	_W_RANGE = (10, 22)
   251	_LINE_COLOR = 1
   252	_TRIGGER_COLOR = 6
   253	_SEGMENT_COUNT = (1, 3)
   254	_SEG_LEN_RANGE = (4, 14)
   255	_TRIGGERS_PER_SEG = (1, 1)
   256	
   257	# === CFG: distractor counts ===
   258	_UNPAIRED_LINE_PIXELS = (0, 1)
   259	_OFF_DIAG_TRIGGERS = (0, 1)
