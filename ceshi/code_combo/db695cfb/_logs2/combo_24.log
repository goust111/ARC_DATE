   110	def _checker_color(
   111	    r: int,
   112	    c: int,
   113	    bg_pair: tuple[int, int],
   114	    row_phase: int,
   115	    col_phase: int,
   116	) -> int:
   117	    idx = (((r + row_phase) // 2) + ((c + col_phase) // 2)) % 2
   118	    return bg_pair[idx]
   119	
   120	
   121	def _infer_checker_layout(
   122	    grid: np.ndarray,
   123	    bg0: int,
   124	    bg1: int,
   125	) -> tuple[tuple[int, int], int, int]:
   126	    bg_set = {bg0, bg1}
   127	    best = None  # (score, bg_pair, row_phase, col_phase)
   128	    for bg_pair in ((bg0, bg1), (bg1, bg0)):
   129	        for row_phase in (0, 1):
   130	            for col_phase in (0, 1):
   131	                score = 0
   132	                for r in range(grid.shape[0]):
   133	                    for c in range(grid.shape[1]):
   134	                        v = int(grid[r, c])
   135	                        if v in bg_set and v == _checker_color(r, c, bg_pair, row_phase, col_phase):
   136	                            score += 1
   137	                cand = (score, bg_pair, row_phase, col_phase)
   138	                if best is None or cand > best:
   139	                    best = cand
   140	    assert best is not None
   141	    _, bg_pair, row_phase, col_phase = best
   142	    return bg_pair, row_phase, col_phase
   143	
   144	
   145	def _best_diagonal_color(non_bg: list[tuple[int, int, int]]) -> tuple[int, int]:
   146	    by_color: dict[int, list[tuple[int, int]]] = {}
   147	    for r, c, col in non_bg:
   148	        by_color.setdefault(col, []).append((r, c))
   149	
   150	    best = None  # (dist, color)
   151	    for col, pts in by_color.items():
   152	        if len(pts) < 2:
   153	            continue
   154	        for i in range(len(pts)):
   155	            r0, c0 = pts[i]
   156	            for j in range(i + 1, len(pts)):
   157	                r1, c1 = pts[j]
   158	                dr = r1 - r0
   159	                dc = c1 - c0
   160	                if dr == 0 or abs(dr) != abs(dc):
   161	                    continue
   162	                cand = (abs(dr), col)
   163	                if best is None or cand > best:
   164	                    best = cand
   165	
   166	    assert best is not None, "at least one diagonal-aligned same-color pair must exist"
   167	    return best[1], best[0]
   168	
