   405	def _best_color_is_line(inp: np.ndarray, bg_pair: tuple[int, int]) -> bool:
   406	    bg_set = set(bg_pair)
   407	    non_bg = [(r, c, int(inp[r, c])) for r in range(inp.shape[0]) for c in range(inp.shape[1]) if int(inp[r, c]) not in bg_set]
   408	    try:
   409	        color, _ = _best_diagonal_color(non_bg)
   410	    except AssertionError:
   411	        return False
   412	    return color == _LINE_COLOR
