   365	def _try_place_segment(
   366	    seg_len: int,
   367	    h: int,
   368	    w: int,
   369	    active_bg: int,
   370	    bg_pair: tuple[int, int],
   371	    row_phase: int,
   372	    col_phase: int,
   373	    line_positions: set[tuple[int, int]],
   374	    path_cells: set[tuple[int, int]],
   375	    drawn: set[tuple[int, int]],
   376	    used_backslash_keys: set[int],
   377	):
   378	    for _ in range(_SEGMENT_PLACE_RETRIES):
   379	        if h - 1 - seg_len < 0 or w - 1 - seg_len < 0:
   380	            return None
   381	        r0 = random.randint(0, h - 1 - seg_len)
   382	        c0 = random.randint(0, w - 1 - seg_len)
   383	        ep0 = (r0, c0)
   384	        ep1 = (r0 + seg_len, c0 + seg_len)
   385	        diag_key = ep0[0] - ep0[1]
   386	        if diag_key in used_backslash_keys:
   387	            continue
   388	        if not _same_backslash_phase(r0, c0, row_phase, col_phase):
   389	            continue
   390	        if not _is_active_cell(r0, c0, active_bg, bg_pair, row_phase, col_phase):
   391	            continue
   392	        path = _diag_path(ep0, ep1)
   393	        if any(not _is_active_cell(r, c, active_bg, bg_pair, row_phase, col_phase) for r, c in path):
   394	            continue
   395	        if any(rc in path_cells or rc in drawn for rc in path):
   396	            continue
   397	        if any(abs(ep0[0] - lr) == abs(ep0[1] - lc) for lr, lc in line_positions):
   398	            continue
   399	        if any(abs(ep1[0] - lr) == abs(ep1[1] - lc) for lr, lc in line_positions):
   400	            continue
   401	        return path
   402	    return None
