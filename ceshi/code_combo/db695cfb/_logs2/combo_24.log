   296	def _compute_visible_ray_cells(
   297	    trigger_positions: list[tuple[int, int]],
   298	    perp_dirs: list[tuple[int, int]],
   299	    h: int,
   300	    w: int,
   301	    active_bg: int,
   302	    bg_pair: tuple[int, int],
   303	    row_phase: int,
   304	    col_phase: int,
   305	) -> set[tuple[int, int]]:
   306	    cells = set()
   307	    for tr, tc in trigger_positions:
   308	        for ddr, ddc in perp_dirs:
   309	            r, c = tr + ddr, tc + ddc
   310	            while 0 <= r < h and 0 <= c < w:
   311	                if _is_active_cell(r, c, active_bg, bg_pair, row_phase, col_phase):
   312	                    cells.add((r, c))
   313	                r += ddr
   314	                c += ddc
   315	    return cells
