   340	def _build_expected(
   341	    inp: np.ndarray,
   342	    active_bg: int,
   343	    bg_pair: tuple[int, int],
   344	    row_phase: int,
   345	    col_phase: int,
   346	    segments,
   347	) -> np.ndarray:
   348	    h, w = inp.shape
   349	    expected = inp.copy()
   350	    for _, _, trigger_positions, _, perp_dirs in segments:
   351	        for tr, tc in trigger_positions:
   352	            for ddr, ddc in perp_dirs:
   353	                r, c = tr + ddr, tc + ddc
   354	                while 0 <= r < h and 0 <= c < w:
   355	                    if (
   356	                        expected[r, c] in bg_pair
   357	                        and _is_active_cell(r, c, active_bg, bg_pair, row_phase, col_phase)
   358	                    ):
   359	                        expected[r, c] = _TRIGGER_COLOR
   360	                    r += ddr
   361	                    c += ddc
   362	    return expected
