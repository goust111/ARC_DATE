    94	def _diag_path(p: tuple[int, int], q: tuple[int, int]) -> list[tuple[int, int]]:
    95	    r0, c0 = p
    96	    r1, c1 = q
    97	    dr = 1 if r1 > r0 else -1
    98	    dc = 1 if c1 > c0 else -1
    99	    steps = abs(r1 - r0)
   100	    return [(r0 + k * dr, c0 + k * dc) for k in range(steps + 1)]
   101	
   102	
   103	def _top_two_colors(grid: np.ndarray) -> tuple[int, int]:
   104	    counts = Counter(map(int, grid.flatten()))
   105	    top = counts.most_common(2)
   106	    assert len(top) == 2, "grid must contain two dominant background colors"
   107	    return int(top[0][0]), int(top[1][0])
