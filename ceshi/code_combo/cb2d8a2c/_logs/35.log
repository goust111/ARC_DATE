+        if any(markers != blues_i for markers, blues_i in zip(metrics["per_bar_markers"], blues)):
+            return None
+    except Exception:
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
