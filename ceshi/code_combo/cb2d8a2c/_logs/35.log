+def _reaches_opposite_edge(out: np.ndarray, edge: str) -> bool:
+    if edge == "top":
+        band = out[-1, :]
+    elif edge == "bottom":
+        band = out[0, :]
+    elif edge == "left":
+        band = out[:, -1]
+    else:
+        band = out[:, 0]
+    return bool(np.any((band == GREEN) | (band == BLUE)))
