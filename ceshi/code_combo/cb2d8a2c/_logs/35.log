+    state = goal_state
+    while True:
+        r, c, _ = state
+        path.append((r, c))
+        if (r, c) == (sr, sc):
+            break
+        state = prev[state]
+    path.reverse()
+
+    turn_indices = _path_turn_indices(path)
+    turn_cells = {path[idx] for idx in turn_indices}
+
+    for bar in bars:
+        shell = bar["shell"]
+        shell_indices = [idx for idx, (r, c) in enumerate(path) if shell[r, c]]
+        own_turn_indices = [idx for idx in turn_indices if shell[path[idx][0], path[idx][1]]]
+        candidates: list[int] = []
+        seen: set[int] = set()
+        for idx in own_turn_indices + shell_indices:
+            if idx not in seen:
+                seen.add(idx)
+                candidates.append(idx)
+        bar["turn_indices"] = own_turn_indices
+        bar["marker_indices"] = candidates[: int(bar["blue_count"])]
