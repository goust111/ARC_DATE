+    for bar in details["bars"]:
+        for r, c in bar["cells"]:
+            out[r, c] = GRAY
+
+    for r, c in details["path"]:
+        if out[r, c] == BG:
+            out[r, c] = GREEN
+
+    for r, c in _expected_marker_cells(details):
+        out[r, c] = BLUE
