+        out = [0] * (count + 1)
+        out[-1] = slack
+        return out
+    if count == 1:
+        return [slack, 0]
+    extras = [0] * (count + 1)
+    focus = _random_composition(slack, count)
+    for i, val in enumerate(focus):
