+    if metrics["processed_count"] < 1:
+        return None
+    if mode == "tight" and metrics["processed_count"] >= metrics["bar_count"]:
+        return None
+    if mode == "generous" and metrics["processed_count"] != metrics["bar_count"]:
+        return None
