+def _min_main_len(blues: tuple[int, ...]) -> int:
+    """Minimum main-axis size with room below every bar's keep-out zone."""
+    last_bar_row = blues[0] + 2
+    for a, b in zip(blues, blues[1:]):
+        last_bar_row += a + b + 2
+    return last_bar_row + blues[-1] + 2
