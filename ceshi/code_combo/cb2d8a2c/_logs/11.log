+    inp = _orient_grid(canonical, edge)
+    out = _orient_grid(solved_canonical, edge)
+    try:
+        got = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(got, out):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
