   228	    assert goal_state is not None, "a valid path to the opposite edge must exist"
   229	    path: list[tuple[int, int]] = []
   230	    st = goal_state
   231	    while True:
   232	        r, c, _ = st
   233	        path.append((r, c))
   234	        if (r, c) == (sr, sc):
   235	            break
   236	        st = prev[st]
   237	    path.reverse()
   238	    return path
