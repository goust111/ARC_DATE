+    return (r == goal_val) if goal_kind == "row" else (c == goal_val)
+
+
+def _classify_component(
+    cells: list[tuple[int, int]],
+    blue_count: int,
+    main_vertical: bool,
+) -> str:
+    if blue_count > 0:
+        return "detour"
