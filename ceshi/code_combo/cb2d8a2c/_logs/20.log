   218	                continue
   219	            if blocked[rr, cc]:
   220	                continue
   221	            ncost = (steps + 1, turns + (0 if nd == dprev else 1))
   222	            key = (rr, cc, nd)
   223	            if ncost < best_cost.get(key, inf):
   224	                best_cost[key] = ncost
   225	                prev[key] = (r, c, dprev)
   226	                heapq.heappush(heap, (ncost, rr, cc, nd))
