+    h, w = g.shape
+    assert h == w and h % 2 == 1, "diagonal variant uses an odd square canvas"
+    if sr == 0:
+        return 0
+    if sc == w - 1:
+        return 1
+    if sr == h - 1:
+        return 2
+    if sc == 0:
+        return 3
+    raise AssertionError("green start must lie on a border edge")
+
+
+def _to_virtual_from_canonical(actual: np.ndarray) -> np.ndarray:
+    h, w = actual.shape
