+def _paint_virtual_path(virt: np.ndarray) -> list[tuple[int, int]]:
+    n = virt.shape[0]
+    start = (0, 0)
+    goal = (n - 1, n - 1)
+
+    bar_mask = (virt == BLUE) | (virt == RED)
+    bar_comps = components_mask(bar_mask, connectivity=4)
