+from __future__ import annotations
+
+import heapq
+import itertools
+import random
+
+import numpy as np
+
+from solvers.arc_utils import components_mask
+
+
+BG = 8
+BLUE = 1
+RED = 2
+GREEN = 3
+
+_VIRTUAL_DIRS_URDL = [(-1, 0), (0, 1), (1, 0), (0, -1)]
