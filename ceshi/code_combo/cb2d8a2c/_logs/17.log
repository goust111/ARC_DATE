+# Combo variant of cb2d8a2c (index 17)
+# combo_spec: D10/2+D13/1
+# Name: 嵌套式障碍+大量障碍条
+
+# Design analysis for the combo variant
+# -------------------------------------
+# a) Concrete behavior:
+#    - Original canonical layout: 1-4 horizontal bars are spread down the grid
+#      and alternate which outer wall they touch. The path snakes across the
+#      full width from one loose detour to the next.
+#    - Combo layout: 5-7 bars are placed in row order, but each new bar is
+#      attached to the boundary of the chamber left by the previous bar rather
+#      than to the global wall. The available chamber therefore shrinks layer by
+#      layer. Example with width 29, blues (1,2,1,1,1,1), and side pattern
+#      L,R,L,R,L,R:
+#      chamber [0,28] -> left bar len 10 leaves [11,28]
+#      -> right bar len 8 leaves [11,18]
+#      -> left bar len 4 leaves [16,18]
+#      ... so the route must penetrate inward, then unwind outward, producing a
+#      deep zigzag/spiral-looking trace instead of the original wide snake.
+#    - The solver rule itself is unchanged at the local level: each disconnected
+#      red/blue bar still defines a Manhattan keep-out halo whose radius equals
+#      its blue-pixel count. The difference is that the same local rule now
+#      compounds across many nested layers.
+# b) Complexity calibration:
+#    - D13 requires 5+ obstacles, so the generator uses 5-7 bars only.
+#    - To make 5-7 nested layers physically fit in <=30x30 while still leaving a
+#      traversable corridor, blue counts are limited to 1-2 and bar lengths to
+#      a small set starting at 3 cells. This keeps the visual pattern legible
+#      and leaves repeated evidence of the radius rule across examples.
+#    - Counts are weighted toward 6 bars, with 5 and 7 still appearing, so the
+#      "many barriers" cue is obvious without making every sample maximally
+#      cramped.
+# c) Implicit-assumption audit of main():
+#    - Start detection only assumes exactly one green border cell. Still valid.
+#    - Opposite-edge targeting only assumes the route should cross the full main
+#      axis. Still valid.
+#    - Component extraction only assumes each obstacle is a disconnected 4-neigh
+#      red/blue object; it does not require wall attachment. Floating nested
+#      bars therefore remain valid.
+#    - The forbidden-zone BFS depends only on each component's blue count. This
+#      stays correct for nested bars, but it means the generator must guarantee
+#      row gaps and chamber widths large enough that the keep-out diamonds do not
+#      seal the corridor.
+#    - Dijkstra is geometry-agnostic. It does not assume monotone progress or a
+#      fixed number of turns, so it naturally handles the deeper multi-layer
+#      route as long as a path exists.
+# d) Placement legality:
+#    - The generator tracks the current chamber [left,right]. A left-attached bar
+#      occupies [left,end], after which the next chamber starts at
+#      end + blue + 1. A right-attached bar is symmetric.
+#    - Bar lengths are chosen with a suffix-capacity bound:
+#      current_length <= chamber_width - blue - min_space_needed_for_remaining.
+#      This ensures every later bar still fits.
+#    - Rows are separated by at least blue_i + blue_{i+1} + 2, preserving a free
+#      horizontal band between successive Manhattan halos.
+# e) Visual observability:
+#    - Human solvers can see both fused dimensions directly: there are many bars
+#      (not 1-3), and most inner bars float inside the cavity opened by earlier
+#      bars. The output path shows repeated inward/outward turns, making the
+#      nested structure visually explicit.
+# f) Visual cleanliness:
+#    - Bars remain 1-cell thick, never overlap, and appear on distinct rows in a
+#      single canonical stack. Only the original four colors are used, avoiding
+#      ambiguous overlays.
+# g) Color-change inference:
+#    - Blue pixels remain part of obstacle bars and always turn red after the
+#      path is drawn, so the color change stays easy to infer from structure.
+# h) Generator guarantee vs. solver assumptions:
+#    - main() intentionally stays general and does not hard-code "nested" or
+#      "5+ bars". The generator is responsible for constructing such inputs and
+#      validating them via the same solver.
+# i) Post-change audit target:
+#    - After implementation, the behavior should be quantifiable by metrics such
+#      as obstacle count >= 5, floating inner-bar count >= 4 in most samples,
+#      and path turn counts well above the original 1-4-bar regime.
+
+import heapq
+import itertools
+import random
+from collections import deque
+
+import numpy as np
+
+from arc_utils import components_mask, neighbors4
+
+_DIRS_URDL = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Extend a green route from one border to the opposite while threading through a deep nest of many obstacle bars whose blue pixels encode their exclusion radii.
+
+    Input structure:
+    - bg = azure (8). Red/blue bars (2/1) form 5 or more thin obstacles, with later bars nested inside the chamber opened by earlier ones so several bars float away from the outer wall.
+    - A single green (3) pixel sits on one border and marks the route entrance.
+
+    Rule:
+    - For each disconnected red/blue bar, forbid every cell whose Manhattan distance to that bar is at most the number of blue pixels on the bar.
+    - Grow the green path to the opposite edge using orthogonal turns; in nested examples this forces the path to dive through successive chambers and then unwind through them.
+    - After drawing the path, recolor every blue pixel to red.
+
+    Key insight: Blue counts still determine each obstacle's keep-out radius, but because many bars are nested inside one another, the same radius rule compounds across layers and produces a long multi-turn route.
+    """
+    g = np.array(grid, copy=True)
+    h, w = g.shape
+
+    BG = 8
+    GREEN = 3
+    BLUE = 1
+
+    start_pts = np.argwhere(g == GREEN)
+    assert start_pts.shape[0] == 1, "grid must contain exactly one green start pixel"
+    sr, sc = map(int, start_pts[0])
+
+    if sr == 0:
+        init_dir = 2
+        goal_kind, goal_val = "row", h - 1
+    elif sr == h - 1:
+        init_dir = 0
+        goal_kind, goal_val = "row", 0
+    elif sc == 0:
+        init_dir = 1
+        goal_kind, goal_val = "col", w - 1
+    elif sc == w - 1:
+        init_dir = 3
+        goal_kind, goal_val = "col", 0
+    else:
+        raise AssertionError("green start must be on a border edge")
+
+    def is_goal(r: int, c: int) -> bool:
+        return (r == goal_val) if goal_kind == "row" else (c == goal_val)
+
+    bar_mask = (g == BLUE) | (g == 2)
+    bar_comps = components_mask(bar_mask, connectivity=4)
+
+    forbidden = np.zeros((h, w), dtype=bool)
+    for comp in bar_comps:
+        radius = sum(1 for r, c in comp if g[r, c] == BLUE)
+        dist = np.full((h, w), -1, dtype=np.int16)
+        q = deque()
+        for r, c in comp:
+            dist[r, c] = 0
+            q.append((r, c))
+
+        while q:
+            r, c = q.popleft()
+            d = int(dist[r, c])
+            forbidden[r, c] = True
+            if d == radius:
+                continue
+            for rr, cc in neighbors4(r, c):
+                if 0 <= rr < h and 0 <= cc < w and dist[rr, cc] == -1:
+                    dist[rr, cc] = d + 1
+                    q.append((rr, cc))
+
+    blocked = bar_mask | forbidden
+    blocked[sr, sc] = False
+
+    inf_cost = (10**9, 10**9)
+    best_cost: dict[tuple[int, int, int], tuple[int, int]] = {(sr, sc, init_dir): (0, 0)}
+    prev: dict[tuple[int, int, int], tuple[int, int, int]] = {}
+    heap: list[tuple[tuple[int, int], int, int, int]] = [((0, 0), sr, sc, init_dir)]
+
+    goal_state: tuple[int, int, int] | None = None
+    while heap:
+        (steps, turns), r, c, dprev = heapq.heappop(heap)
+        if (steps, turns) != best_cost.get((r, c, dprev), inf_cost):
+            continue
+        if is_goal(r, c) and (r, c) != (sr, sc):
+            goal_state = (r, c, dprev)
+            break
+        for nd, (dr, dc) in enumerate(_DIRS_URDL):
+            rr, cc = r + dr, c + dc
+            if not (0 <= rr < h and 0 <= cc < w):
+                continue
+            if blocked[rr, cc]:
+                continue
+            ncost = (steps + 1, turns + (0 if nd == dprev else 1))
+            key = (rr, cc, nd)
+            if ncost < best_cost.get(key, inf_cost):
+                best_cost[key] = ncost
+                prev[key] = (r, c, dprev)
+                heapq.heappush(heap, (ncost, rr, cc, nd))
+
+    assert goal_state is not None, "a valid path to the opposite edge must exist"
+
+    out = g.copy()
+    path: list[tuple[int, int]] = []
+    st = goal_state
+    while True:
+        r, c, _ = st
+        path.append((r, c))
+        if (r, c) == (sr, sc):
+            break
+        st = prev[st]
+    path.reverse()
+    for r, c in path:
+        if out[r, c] == BG:
+            out[r, c] = GREEN
+
+    out[out == BLUE] = 2
+    return out
+
+
+BG = 8
+BLUE = 1
+RED = 2
+GREEN = 3
+
