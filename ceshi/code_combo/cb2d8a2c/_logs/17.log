+#      ambiguous overlays.
+# g) Color-change inference:
+#    - Blue pixels remain part of obstacle bars and always turn red after the
+#      path is drawn, so the color change stays easy to infer from structure.
+# h) Generator guarantee vs. solver assumptions:
+#    - main() intentionally stays general and does not hard-code "nested" or
+#      "5+ bars". The generator is responsible for constructing such inputs and
+#      validating them via the same solver.
+# i) Post-change audit target:
+#    - After implementation, the behavior should be quantifiable by metrics such
+#      as obstacle count >= 5, floating inner-bar count >= 4 in most samples,
+#      and path turn counts well above the original 1-4-bar regime.
+
+import heapq
+import itertools
+import random
+from collections import deque
+
+import numpy as np
+
+from arc_utils import components_mask, neighbors4
+
+_DIRS_URDL = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Extend a green route from one border to the opposite while threading through a deep nest of many obstacle bars whose blue pixels encode their exclusion radii.
+
+    Input structure:
+    - bg = azure (8). Red/blue bars (2/1) form 5 or more thin obstacles, with later bars nested inside the chamber opened by earlier ones so several bars float away from the outer wall.
+    - A single green (3) pixel sits on one border and marks the route entrance.
+
+    Rule:
+    - For each disconnected red/blue bar, forbid every cell whose Manhattan distance to that bar is at most the number of blue pixels on the bar.
+    - Grow the green path to the opposite edge using orthogonal turns; in nested examples this forces the path to dive through successive chambers and then unwind through them.
+    - After drawing the path, recolor every blue pixel to red.
+
+    Key insight: Blue counts still determine each obstacle's keep-out radius, but because many bars are nested inside one another, the same radius rule compounds across layers and produces a long multi-turn route.
+    """
+    g = np.array(grid, copy=True)
+    h, w = g.shape
+
+    BG = 8
+    GREEN = 3
+    BLUE = 1
+
+    start_pts = np.argwhere(g == GREEN)
+    assert start_pts.shape[0] == 1, "grid must contain exactly one green start pixel"
+    sr, sc = map(int, start_pts[0])
+
+    if sr == 0:
+        init_dir = 2
+        goal_kind, goal_val = "row", h - 1
+    elif sr == h - 1:
+        init_dir = 0
+        goal_kind, goal_val = "row", 0
+    elif sc == 0:
+        init_dir = 1
+        goal_kind, goal_val = "col", w - 1
+    elif sc == w - 1:
+        init_dir = 3
+        goal_kind, goal_val = "col", 0
+    else:
+        raise AssertionError("green start must be on a border edge")
+
+    def is_goal(r: int, c: int) -> bool:
+        return (r == goal_val) if goal_kind == "row" else (c == goal_val)
+
+    bar_mask = (g == BLUE) | (g == 2)
+    bar_comps = components_mask(bar_mask, connectivity=4)
+
+    forbidden = np.zeros((h, w), dtype=bool)
+    for comp in bar_comps:
+        radius = sum(1 for r, c in comp if g[r, c] == BLUE)
+        dist = np.full((h, w), -1, dtype=np.int16)
+        q = deque()
+        for r, c in comp:
+            dist[r, c] = 0
+            q.append((r, c))
+
+        while q:
+            r, c = q.popleft()
+            d = int(dist[r, c])
+            forbidden[r, c] = True
+            if d == radius:
+                continue
+            for rr, cc in neighbors4(r, c):
+                if 0 <= rr < h and 0 <= cc < w and dist[rr, cc] == -1:
+                    dist[rr, cc] = d + 1
+                    q.append((rr, cc))
+
+    blocked = bar_mask | forbidden
+    blocked[sr, sc] = False
+
+    inf_cost = (10**9, 10**9)
+    best_cost: dict[tuple[int, int, int], tuple[int, int]] = {(sr, sc, init_dir): (0, 0)}
+    prev: dict[tuple[int, int, int], tuple[int, int, int]] = {}
+    heap: list[tuple[tuple[int, int], int, int, int]] = [((0, 0), sr, sc, init_dir)]
+
+    goal_state: tuple[int, int, int] | None = None
+    while heap:
+        (steps, turns), r, c, dprev = heapq.heappop(heap)
+        if (steps, turns) != best_cost.get((r, c, dprev), inf_cost):
+            continue
+        if is_goal(r, c) and (r, c) != (sr, sc):
+            goal_state = (r, c, dprev)
+            break
+        for nd, (dr, dc) in enumerate(_DIRS_URDL):
+            rr, cc = r + dr, c + dc
+            if not (0 <= rr < h and 0 <= cc < w):
+                continue
+            if blocked[rr, cc]:
+                continue
+            ncost = (steps + 1, turns + (0 if nd == dprev else 1))
+            key = (rr, cc, nd)
+            if ncost < best_cost.get(key, inf_cost):
+                best_cost[key] = ncost
+                prev[key] = (r, c, dprev)
+                heapq.heappush(heap, (ncost, rr, cc, nd))
+
+    assert goal_state is not None, "a valid path to the opposite edge must exist"
+
+    out = g.copy()
+    path: list[tuple[int, int]] = []
+    st = goal_state
+    while True:
+        r, c, _ = st
+        path.append((r, c))
+        if (r, c) == (sr, sc):
+            break
+        st = prev[st]
+    path.reverse()
+    for r, c in path:
+        if out[r, c] == BG:
+            out[r, c] = GREEN
+
+    out[out == BLUE] = 2
+    return out
+
+
+BG = 8
+BLUE = 1
+RED = 2
+GREEN = 3
+
+ROWS_LO, ROWS_HI = 24, 30
+COLS_LO, COLS_HI = 24, 30
+BAR_COUNT_LO, BAR_COUNT_HI = 5, 7
+BLUE_PER_BAR_LO, BLUE_PER_BAR_HI = 1, 2
+BAR_LEN_MIN, BAR_LEN_MAX = 3, 15
+MAX_GEN_RETRIES = 600
+
+
+def _min_bar_len(blue_count: int) -> int:
+    return max(BAR_LEN_MIN, 2 * blue_count - 1)
+
+
+def _min_chamber_needed(blues: tuple[int, ...]) -> int:
+    need = 1
+    for blue_count in reversed(blues):
+        need += int(blue_count) + _min_bar_len(int(blue_count))
+    return need
+
+
+def _min_main_len(blues: tuple[int, ...]) -> int:
+    total = int(blues[0]) + 2
+    for a, b in zip(blues, blues[1:]):
+        total += int(a) + int(b) + 2
+    return total + 2
+
+
+def _random_composition(total: int, parts: int) -> list[int]:
+    if parts == 1:
+        return [total]
+    cuts = sorted(random.sample(range(total + parts - 1), parts - 1))
+    out = []
+    prev = -1
+    for cut in cuts + [total + parts - 1]:
+        out.append(cut - prev - 1)
+        prev = cut
+    return out
+
+
+def _choose_blues(main_hi: int, cross_hi: int) -> tuple[int, ...] | None:
+    choices: list[tuple[int, ...]] = []
+    weights: list[int] = []
+    for count in range(BAR_COUNT_LO, BAR_COUNT_HI + 1):
+        for combo in itertools.product(range(BLUE_PER_BAR_LO, BLUE_PER_BAR_HI + 1), repeat=count):
+            if _min_main_len(combo) > main_hi or _min_chamber_needed(combo) > cross_hi:
+                continue
+            two_count = sum(v == 2 for v in combo)
+            count_weight = {5: 3, 6: 6, 7: 2}[count]
+            radius_weight = 1 + min(two_count, 2)
+            choices.append(combo)
+            weights.append(count_weight * radius_weight)
+    if not choices:
+        return None
+    return random.choices(choices, weights=weights, k=1)[0]
+
+
+def _paint_bar(
+    grid: np.ndarray,
+    row: int,
+    start: int,
+    end: int,
+    side: int,
+    blue_count: int,
+) -> None:
+    length = end - start + 1
+    colors = np.full(length, RED, dtype=int)
+    colors[: 2 * blue_count - 1 : 2] = BLUE
+    if side == 0:
+        grid[row, start : end + 1] = colors
+    else:
+        grid[row, start : end + 1] = colors[::-1]
+
+
+def _choose_nested_spans(
+    cross_size: int,
+    blues: tuple[int, ...],
+    first_side: int,
+) -> list[tuple[int, int, int]] | None:
+    left = 0
+    right = cross_size - 1
+    spans: list[tuple[int, int, int]] = []
+
+    for i, blue_count in enumerate(blues):
+        side = (first_side + i) % 2
+        chamber = right - left + 1
+        min_next = _min_chamber_needed(blues[i + 1 :])
+        lo = _min_bar_len(int(blue_count))
+        hi = min(BAR_LEN_MAX, chamber - int(blue_count) - min_next)
+        if lo > hi:
+            return None
+
+        prefer_lo = max(lo, hi - 3)
+        length = random.randint(prefer_lo, hi)
+        if side == 0:
+            start = left
+            end = left + length - 1
+            left = end + int(blue_count) + 1
+        else:
+            end = right
+            start = right - length + 1
+            right = start - int(blue_count) - 1
+        spans.append((start, end, side))
+
+    return spans
+
+
+def _canonical_grid(
+    main_size: int,
+    cross_size: int,
+    blues: tuple[int, ...],
+    first_side: int,
+) -> np.ndarray | None:
+    slack = main_size - _min_main_len(blues)
+    if slack < 0:
+        return None
+
+    spans = _choose_nested_spans(cross_size, blues, first_side)
+    if spans is None:
+        return None
+
+    extras = _random_composition(slack, len(blues) + 1)
+    row = int(blues[0]) + 2 + extras[0]
+    rows = [row]
+    for i in range(1, len(blues)):
+        row += int(blues[i - 1]) + int(blues[i]) + 2 + extras[i]
+        rows.append(row)
+
+    grid = np.full((main_size, cross_size), BG, dtype=int)
+    for row, blue_count, (start, end, side) in zip(rows, blues, spans):
+        _paint_bar(grid, row, start, end, side, int(blue_count))
+
+    start0, end0, side0 = spans[0]
+    if side0 == 0:
+        lo = start0 + 1
+        hi = end0
+    else:
+        lo = start0
+        hi = end0 - 1
+    if lo > hi:
+        return None
+    grid[0, random.randint(lo, hi)] = GREEN
+    return grid
+
+
+def _orient_grid(grid: np.ndarray, edge: str) -> np.ndarray:
+    if edge == "top":
+        return grid.copy()
+    if edge == "bottom":
+        return np.flipud(grid).copy()
+    if edge == "left":
+        return grid.T.copy()
+    return np.fliplr(grid.T).copy()
+
+
+def _to_canonical(grid: np.ndarray) -> np.ndarray:
+    pts = np.argwhere(grid == GREEN)
+    assert pts.shape[0] == 1
+    r, c = map(int, pts[0])
+    if r == 0:
+        return np.array(grid, copy=True)
+    if r == grid.shape[0] - 1:
+        return np.flipud(grid).copy()
+    if c == 0:
+        return grid.T.copy()
+    if c == grid.shape[1] - 1:
+        return np.fliplr(grid).T.copy()
+    raise AssertionError("green start must be on a border edge")
+
+
+def _bar_descriptors(canonical: np.ndarray) -> list[tuple[int, int, int, int]]:
+    bar_mask = (canonical == BLUE) | (canonical == RED)
+    desc: list[tuple[int, int, int, int]] = []
+    for comp in components_mask(bar_mask, connectivity=4):
+        rows = {r for r, _ in comp}
+        assert len(rows) == 1
+        row = next(iter(rows))
+        cols = sorted(c for _, c in comp)
+        blue_count = sum(1 for r, c in comp if canonical[r, c] == BLUE)
+        desc.append((row, cols[0], cols[-1], blue_count))
+    desc.sort()
+    return desc
+
+
+def _nested_signature(grid: np.ndarray) -> tuple[int, int, bool]:
+    canonical = _to_canonical(grid)
+    desc = _bar_descriptors(canonical)
+    left = 0
+    right = canonical.shape[1] - 1
+    floating = 0
+    ok = True
+    for i, (_row, start, end, blue_count) in enumerate(desc):
+        side = None
+        if start == left:
+            side = 0
+            left = end + blue_count + 1
+        elif end == right:
+            side = 1
+            right = start - blue_count - 1
+        else:
+            ok = False
+            break
+        if i > 0 and start > 0 and end < canonical.shape[1] - 1:
+            floating += 1
+        if left > right + 1:
+            ok = False
+            break
+        if side is None:
+            ok = False
+            break
+    return len(desc), floating, ok
+
+
+def _reaches_opposite_edge(out: np.ndarray, edge: str) -> bool:
+    if edge == "top":
+        return bool(np.any(out[-1, :] == GREEN))
+    if edge == "bottom":
+        return bool(np.any(out[0, :] == GREEN))
+    if edge == "left":
+        return bool(np.any(out[:, -1] == GREEN))
+    return bool(np.any(out[:, 0] == GREEN))
+
+
+def _gen_attempt() -> np.ndarray | None:
+    edge = random.choice(("top", "bottom", "left", "right"))
+    if edge in ("top", "bottom"):
+        main_lo, main_hi = ROWS_LO, ROWS_HI
+        cross_lo, cross_hi = COLS_LO, COLS_HI
+    else:
+        main_lo, main_hi = COLS_LO, COLS_HI
+        cross_lo, cross_hi = ROWS_LO, ROWS_HI
+
+    blues = _choose_blues(main_hi, cross_hi)
+    if blues is None:
+        return None
+
+    main_size = random.randint(max(main_lo, _min_main_len(blues)), main_hi)
+    cross_size = random.randint(max(cross_lo, _min_chamber_needed(blues)), cross_hi)
+    first_side = random.randrange(2)
+
+    canonical = _canonical_grid(main_size, cross_size, blues, first_side)
+    if canonical is None:
+        return None
+
+    inp = _orient_grid(canonical, edge)
+    count, floating, nested_ok = _nested_signature(inp)
+    if count < 5 or floating < 3 or not nested_ok:
+        return None
+
+    try:
+        out = main(inp)
+        if not _reaches_opposite_edge(out, edge):
+            return None
+        if not np.array_equal(main(inp), out):
+            return None
+    except Exception:
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid nested-many-bar cb2d8a2c input")

