+
+def _blue_offsets(length: int, radius: int, side: str) -> tuple[int, int, int]:
+    if side == "left":
+        offsets = (0, 2, radius + 3)
+    else:
+        offsets = (length - radius - 4, length - 3, length - 1)
+    assert 0 <= offsets[0] < offsets[1] < offsets[2] < length
+    return offsets
