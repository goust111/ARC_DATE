+                c0_hi = min(cross_size - length - radius - 1, current_col + radius)
+                if c0_lo > c0_hi:
+                    continue
+
+                candidates = list(range(c0_lo, c0_hi + 1))
+                random.shuffle(candidates)
+                for c0 in candidates:
