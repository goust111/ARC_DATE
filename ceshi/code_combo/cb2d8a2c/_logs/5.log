+            bounds = _length_bounds(cross_size, radius)
+            if bounds is None:
+                placed = False
+                break
+
+            lengths = list(range(bounds[0], bounds[1] + 1))
+            random.shuffle(lengths)
+            found = False
+
+            for length in lengths:
