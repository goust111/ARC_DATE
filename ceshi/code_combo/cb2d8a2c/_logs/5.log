+    choices = [combo for combo in itertools.product(("left", "right"), repeat=count) if len(set(combo)) == 2]
+    return random.choice(choices)
+
+
+def _canonical_grid(
+    main_size: int,
+    cross_size: int,
+    radii: tuple[int, ...],
+    sides: tuple[str, ...],
