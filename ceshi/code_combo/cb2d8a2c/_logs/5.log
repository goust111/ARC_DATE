+
+def _paint_bar(grid: np.ndarray, row: int, c0: int, length: int, radius: int, side: str) -> None:
+    colors = np.full(length, RED, dtype=int)
+    for off in _blue_offsets(length, radius, side):
+        colors[off] = BLUE
