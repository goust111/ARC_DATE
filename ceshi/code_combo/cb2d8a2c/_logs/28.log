+                "cells": cells,
+                "blue_count": int(blue_count),
+                "main": int(main),
+                "slab_lo": int(max(0, main - blue_count - 1)),
+                "slab_hi": int(min(axis_limit - 1, main + blue_count + 1)),
+                "journey_color": int(PATH_COLOR_BY_BLUE[blue_count]),
