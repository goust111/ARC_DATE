+        r, c, _ = st
+        path.append((r, c))
+        if (r, c) == (sr, sc):
+            break
+        st = prev[st]
+    path.reverse()
+    return path
+
+
+def _main_value(path_is_vertical: bool, r: int, c: int) -> int:
+    return int(r if path_is_vertical else c)
+
+
+def _enters_slab(bar: dict[str, object], main_value: int, init_dir: int) -> bool:
