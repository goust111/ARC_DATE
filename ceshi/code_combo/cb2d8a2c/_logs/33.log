# Design analysis for the fused variant:
# - Concrete behavior:
#   In the source task, the seed fills the chamber, then continues through the opening into
#   an exterior wedge, and finally detached obstacle pixels may erase shadowed parts.
#   Here D11/2 removes those detached pixels entirely, so there is only one transformation
#   step left: chamber fill + exterior radiation. D9/1 then discards the chamber and crops
#   the answer to the bounding box of the exterior radiation strip only.
#   Example mental trace: if a funnel opens upward, the original output is "full grid with
#   chamber + upward wedge". The fused output is just the cropped top wedge, containing only
#   background and fill color, with the wall sprite absent.
# - Complexity calibration:
#   The generator keeps the original wall family, both 1:1 and 1:2 ray modes, variable gap,
#   and four cardinal radiate directions. This preserves enough variation for humans to infer
#   the rule while still making the fused difference visually obvious: inputs contain only
#   wall + seed, but outputs are much smaller and show only the outside strip.
# - Assumptions audited from the original solver:
#   1. "Wall = largest non-bg color" still holds because inputs now use exactly 3 colors.
#   2. "Fill = nearest non-wall color to the wall" still holds because there are no other
#      detached colors competing with the seed blob.
#   3. "Exactly one useful wall component with 2 endpoints" is preserved by generator checks.
#   4. The original obstacle-shadow pass assumed extra colors could exist in the radiate zone;
#      that assumption is intentionally removed. Extra colors are never generated.
#   5. Cropping to the exterior region assumes the opening lies on one row or one column.
#      The generator's local wall construction guarantees that endpoint line.
# - Placement legality:
#   The generator builds the wall in local coordinates, maps it to the canvas with edge
#   margins, places the fill blob only on interior background cells, and validates every
#   sample by running the solver helper before accepting it.
# - Visual observability:
#   Each example shows a three-color input but a two-color cropped output. The key visible
#   clue is that the output keeps only the strip beyond the opening, not the chamber.
#   We reject samples with tiny strips so the fused behavior remains easy to spot.


def _sgn(x: int) -> int:
    return (x > 0) - (x < 0)


def _mask_bbox(mask: np.ndarray):
    pts = np.argwhere(mask)
    if pts.size == 0:
        return None
    r0, c0 = pts.min(axis=0)
    r1, c1 = pts.max(axis=0)
    return int(r0), int(c0), int(r1), int(c1)


def _solve_state(grid: np.ndarray) -> dict:
    g = np.array(grid, dtype=int, copy=True)
    h, w = g.shape
    bg = int(get_bg(g))

    vals = np.unique(g)
    non_bg = [int(v) for v in vals if int(v) != bg]
    assert non_bg, "expected at least one non-background color"

    wall = max(non_bg, key=lambda c: int((g == c).sum()))
    wall_mask = g == wall
    comps = [set((int(r), int(c)) for r, c in pts) for pts in components_mask(wall_mask, connectivity=8)]
    assert comps, "expected at least one wall connected component"

    other_colors = [c for c in non_bg if c != wall]
    assert other_colors, "expected a fill color distinct from the wall"

    wall_points = [p for comp in comps for p in comp]

    def min_dist_to_wall(color: int):
        pts = [(int(r), int(c)) for r, c in zip(*np.where(g == color))]
        best_d = 10**9
        for r, c in pts:
            for wr, wc in wall_points:
                d = abs(r - wr) + abs(c - wc)
                if d < best_d:
                    best_d = d
                    if best_d == 0:
                        return 0, len(pts)
        return best_d, len(pts)

    fill = min(other_colors, key=lambda c: (min_dist_to_wall(c)[0], min_dist_to_wall(c)[1]))
    fill_pos = [(int(r), int(c)) for r, c in zip(*np.where(g == fill))]
    assert fill_pos, "expected at least one fill seed pixel"

    def comp_min_dist(comp):
        best_d = 10**9
        for r, c in fill_pos:
            for wr, wc in comp:
                d = abs(r - wr) + abs(c - wc)
                if d < best_d:
                    best_d = d
                    if best_d == 0:
                        return 0
        return best_d

    wall_comp = min(comps, key=lambda comp: (comp_min_dist(comp), -len(comp)))
    comp_mask = np.zeros_like(wall_mask, dtype=bool)
    for r, c in wall_comp:
        comp_mask[r, c] = True

    def comp_neighbors(r: int, c: int):
        out = []
        for rr, cc in neighbors8(r, c):
            if 0 <= rr < h and 0 <= cc < w and comp_mask[rr, cc]:
                out.append((rr, cc))
        return out

    endpoints = [(r, c) for r, c in wall_comp if len(comp_neighbors(r, c)) == 1]
    assert len(endpoints) == 2, "expected exactly two wall endpoints"

    def outward_dir(ep):
        n1 = comp_neighbors(*ep)[0]
        d1 = (_sgn(n1[0] - ep[0]), _sgn(n1[1] - ep[1]))
        d_use = d1
        is_12 = False
        n2s = [p for p in comp_neighbors(*n1) if p != ep]
        if n2s:
            n2 = n2s[0]
            d2 = (_sgn(n2[0] - n1[0]), _sgn(n2[1] - n1[1]))
            if (d1[0] == 0) ^ (d1[1] == 0):
                if d2[0] != 0 and d2[1] != 0:
                    d_use = d2
                    is_12 = True
        return (-d_use[0], -d_use[1]), is_12

    out_info = [outward_dir(ep) for ep in endpoints]
    out_dirs = [d for d, _ in out_info]
    tip_12 = [flag for _, flag in out_info]
    rad = (_sgn(sum(d[0] for d in out_dirs)), _sgn(sum(d[1] for d in out_dirs)))
    assert rad != (0, 0), "failed to infer radiate direction"

    barrier = comp_mask.copy()

    def add_ray(start, d):
        rr, cc = start
        while True:
            rr += d[0]
            cc += d[1]
            if not (0 <= rr < h and 0 <= cc < w):
                break
            barrier[rr, cc] = True

    def add_ray_12(start, d):
        rr, cc = start
        step = 0
        while True:
            step += 1
            if step % 2 == 1:
                rr += d[0]
                cc += d[1]
            else:
                if rad[0] != 0:
                    rr += d[0]
                else:
                    cc += d[1]
            if not (0 <= rr < h and 0 <= cc < w):
                break
            barrier[rr, cc] = True

    for ep, d, is_12 in zip(endpoints, out_dirs, tip_12):
        if is_12:
            add_ray_12(ep, d)
        else:
            add_ray(ep, d)

    passable = (~barrier) & ((g == bg) | (g == fill))
    seen = np.zeros_like(passable, dtype=bool)
    q = []
    for r, c in fill_pos:
        if passable[r, c]:
            seen[r, c] = True
            q.append((r, c))

