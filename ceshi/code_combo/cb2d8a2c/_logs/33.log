+    return grid
+
+
+def _orient_grid(grid: np.ndarray, edge: str) -> np.ndarray:
+    return _from_canonical(grid, edge)
+
+
+def _reaches_opposite_edge(mask: np.ndarray, edge: str) -> bool:
+    if edge == "top":
+        return bool(np.any(mask[-1, :]))
+    if edge == "bottom":
+        return bool(np.any(mask[0, :]))
+    if edge == "left":
+        return bool(np.any(mask[:, -1]))
