bars=[(2,6,7),(8,12,16),(14,18,8)] # u,v,near
# Actually (u,v,near)
def path_for(cols):
    a0,a1,a2,ar=cols
    pts=[(0,a0)]
    cur=pts[-1]
    def add(b):
        nonlocal cur,pts
        r0,c0=cur; r1,c1=b
        if r0==r1:
            step=1 if c1>=c0 else -1
            seg=[(r0,c) for c in range(c0,c1+step,step)]
        else:
            step=1 if r1>=r0 else -1
            seg=[(r,c0) for r in range(r0,r1+step,step)]
        pts.extend(seg[1:]); cur=b
    lanes=[a0,a1,a2]
    for i,(u,v,n) in enumerate(bars):
        add((u,lanes[i]))
        add((u,n))
        add((v,n))
        add((v, ar if i==len(bars)-1 else lanes[i+1]))
    add((0,ar)); add((0,a0))
    return pts

def simple(pts):
    s=set(pts)
    if len(s)"'!=len(pts)-1: # allow closure? not closed repeated since no final same as start
        pass
    green=set(pts)
    for r,c in green:
        deg=sum((nr,nc) in green for nr,nc in ((r-1,c),(r+1,c),(r,c-1),(r,c+1)))
        if deg!=2: return False
    return True
for cols in itertools.product(safe, repeat=4):
    pts=path_for(cols)
    if simple(pts):
        print('"'found', cols)
        break
else:
    print('none')
