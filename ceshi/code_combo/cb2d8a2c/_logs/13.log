+from arc_utils import components_mask
+
+BG = 8
+BLUE = 1
+RED = 2
+GREEN = 3
+
+DIRS_URDL = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+
+# --- Tunable parameters ---
+ROWS_LO, ROWS_HI = 16, 29
+COLS_LO, COLS_HI = 15, 26
+BAR_COUNT_LO, BAR_COUNT_HI = 2, 4
+BLUE_PER_BAR_LO, BLUE_PER_BAR_HI = 2, 4
+BAR_LEN_MIN, BAR_LEN_MAX = 6, 14
+BAR_CROSS_PCT_LO, BAR_CROSS_PCT_HI = 35, 70
+ROW_GAP_LO, ROW_GAP_HI = 2, 5
+MAX_GEN_RETRIES = 900
