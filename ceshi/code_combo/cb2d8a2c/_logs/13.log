+BLUE_PER_BAR_LO, BLUE_PER_BAR_HI = 2, 3
+BAR_LEN_MIN, BAR_LEN_MAX = 6, 11
+BAR_CROSS_PCT_LO, BAR_CROSS_PCT_HI = 34, 58
+ROW_GAP_LO, ROW_GAP_HI = 1, 4
+MAX_GEN_RETRIES = 900
