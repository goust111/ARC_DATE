+def _manhattan_halo(
+    shape: tuple[int, int],
+    centers: list[tuple[int, int]],
+    radius: int,
+) -> np.ndarray:
+    h, w = shape
+    mask = np.zeros((h, w), dtype=bool)
+    for cr, cc in centers:
+        for dr in range(-radius, radius + 1):
+            rem = radius - abs(dr)
+            r = cr + dr
+            if not (0 <= r < h):
+                continue
+            c0 = max(0, cc - rem)
+            c1 = min(w - 1, cc + rem)
+            mask[r, c0 : c1 + 1] = True
