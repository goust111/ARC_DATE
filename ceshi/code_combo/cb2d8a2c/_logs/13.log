+def _paint_output(grid: np.ndarray, path: list[tuple[int, int]]) -> np.ndarray:
+    out = np.array(grid, copy=True)
+    for r, c in path:
+        if out[r, c] == BG:
+            out[r, c] = GREEN
+    out[out == BLUE] = RED
+    return out
+
