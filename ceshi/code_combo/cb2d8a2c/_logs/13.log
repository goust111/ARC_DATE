+import heapq
+import random
+import sys
+from pathlib import Path
+
+import numpy as np
+
+_CODE_PATH = Path(__file__).resolve()
+for _candidate in (_CODE_PATH.parent, *_CODE_PATH.parents):
+    _arc_utils = _candidate / "solvers" / "arc_utils.py"
+    if _arc_utils.exists():
