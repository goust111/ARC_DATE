+
+def _gen_attempt() -> np.ndarray | None:
+    main_size = random.randint(ROWS_LO, ROWS_HI)
+    cross_size = random.randint(COLS_LO, COLS_HI)
+    count = random.randint(BAR_COUNT_LO, BAR_COUNT_HI)
+    handedness = random.randrange(2)
