+def _stage_choice_gap_count(grid: np.ndarray, seq_path: list[tuple[int, int]], static_path: list[tuple[int, int]] | None) -> int:
+    if static_path is None:
+        return len(_build_bar_infos(grid))
+    bar_infos = _build_bar_infos(grid)
