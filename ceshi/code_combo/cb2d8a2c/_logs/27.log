+
+def _init_dir_for_edge(edge: str) -> int:
+    return {"top": 2, "bottom": 0, "left": 1, "right": 3}[edge]
+
+
+def _axis_sign_for_edge(edge: str) -> tuple[str, int]:
+    if edge == "top":
+        return "row", 1
+    if edge == "bottom":
+        return "row", -1
+    if edge == "left":
+        return "col", 1
+    if edge == "right":
