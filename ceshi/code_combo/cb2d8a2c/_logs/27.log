+                "blue_count": len(blue_coords),
+                "min_row": min(rows),
+                "max_row": max(rows),
+                "min_col": min(cols),
+                "max_col": max(cols),
+                "array": np.array(coords, dtype=int),
+            }
+        )
+    return infos
