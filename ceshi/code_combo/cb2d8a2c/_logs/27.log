+        return None
+
+    path: list[tuple[int, int]] = []
+    st = goal_state
+    while True:
+        r, c, _ = st
+        path.append((r, c))
+        if st not in prev:
+            break
+        st = prev[st]
+    path.reverse()
+    return path
