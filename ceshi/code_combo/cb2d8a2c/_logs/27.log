+
+def _sorted_bars(bar_infos: list[dict], axis: str, sign: int) -> list[dict]:
+    key_name = "min_row" if axis == "row" else "min_col"
+    return sorted(bar_infos, key=lambda info: sign * int(info[key_name]))
