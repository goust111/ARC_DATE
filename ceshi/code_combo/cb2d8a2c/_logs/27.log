+        if _path_diff_size(seq_path, _solve_static_path(inp)) <= 0:
+            return None
+        if not np.array_equal(main(inp), out):
+            return None
+    except Exception:
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
