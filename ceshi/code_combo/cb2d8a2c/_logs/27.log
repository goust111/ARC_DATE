+
+def _frontier_cells(
+    blocked: np.ndarray,
+    bar: dict,
+    axis: str,
+    sign: int,
+) -> list[tuple[int, int]]:
+    h, w = blocked.shape
+    if axis == "row":
+        coord = int(bar["max_row"]) + int(bar["blue_count"]) + 1 if sign == 1 else int(bar["min_row"]) - int(bar["blue_count"]) - 1
+        if not (0 <= coord < h):
+            return []
+        return [(coord, c) for c in range(w) if not bool(blocked[coord, c])]
