+
+def _search_path(
+    blocked: np.ndarray,
+    start: tuple[int, int],
+    init_dir: int,
+    goal: tuple[int, int],
+) -> list[tuple[int, int]] | None:
+    h, w = blocked.shape
+    sr, sc = start
+    gr, gc = goal
+    blocked = np.array(blocked, copy=True)
+    blocked[sr, sc] = False
+    blocked[gr, gc] = False
+
+    inf = (10**9, 10**9)
+    best_cost: dict[tuple[int, int, int], tuple[int, int]] = {(sr, sc, init_dir): (0, 0)}
+    prev: dict[tuple[int, int, int], tuple[int, int, int]] = {}
+    heap: list[tuple[tuple[int, int], int, int, int]] = [((0, 0), sr, sc, init_dir)]
+    goal_state: tuple[int, int, int] | None = None
+
+    while heap:
+        (steps, turns), r, c, dprev = heapq.heappop(heap)
+        if (steps, turns) != best_cost.get((r, c, dprev), inf):
+            continue
+        if (r, c) == (gr, gc):
+            goal_state = (r, c, dprev)
+            break
+        for nd, (dr, dc) in enumerate(_DIRS_URDL):
+            rr, cc = r + dr, c + dc
+            if not (0 <= rr < h and 0 <= cc < w):
+                continue
+            if blocked[rr, cc]:
+                continue
+            ncost = (steps + 1, turns + (0 if nd == dprev else 1))
+            key = (rr, cc, nd)
+            if ncost < best_cost.get(key, inf):
+                best_cost[key] = ncost
+                prev[key] = (r, c, dprev)
+                heapq.heappush(heap, (ncost, rr, cc, nd))
+
+    if goal_state is None:
+        return None
+
+    path: list[tuple[int, int]] = []
+    st = goal_state
+    while True:
+        r, c, _ = st
+        path.append((r, c))
+        if st not in prev:
+            break
+        st = prev[st]
+    path.reverse()
+    return path
+
+
+def _search_to_opposite_edge(
+    blocked: np.ndarray,
+    start: tuple[int, int],
+    init_dir: int,
+    edge: str,
+) -> list[tuple[int, int]] | None:
+    h, w = blocked.shape
+    sr, sc = start
+    blocked = np.array(blocked, copy=True)
+    blocked[sr, sc] = False
+
+    def is_goal(r: int, c: int) -> bool:
+        if edge == "top":
+            return r == h - 1
+        if edge == "bottom":
+            return r == 0
+        if edge == "left":
+            return c == w - 1
+        return c == 0
+
+    inf = (10**9, 10**9)
+    best_cost: dict[tuple[int, int, int], tuple[int, int]] = {(sr, sc, init_dir): (0, 0)}
+    prev: dict[tuple[int, int, int], tuple[int, int, int]] = {}
+    heap: list[tuple[tuple[int, int], int, int, int]] = [((0, 0), sr, sc, init_dir)]
+    goal_state: tuple[int, int, int] | None = None
+
+    while heap:
+        (steps, turns), r, c, dprev = heapq.heappop(heap)
+        if (steps, turns) != best_cost.get((r, c, dprev), inf):
+            continue
+        if is_goal(r, c) and (r, c) != (sr, sc):
+            goal_state = (r, c, dprev)
+            break
+        for nd, (dr, dc) in enumerate(_DIRS_URDL):
+            rr, cc = r + dr, c + dc
+            if not (0 <= rr < h and 0 <= cc < w):
+                continue
+            if blocked[rr, cc]:
+                continue
+            ncost = (steps + 1, turns + (0 if nd == dprev else 1))
+            key = (rr, cc, nd)
+            if ncost < best_cost.get(key, inf):
+                best_cost[key] = ncost
+                prev[key] = (r, c, dprev)
+                heapq.heappush(heap, (ncost, rr, cc, nd))
+
+    if goal_state is None:
+        return None
+
+    path: list[tuple[int, int]] = []
+    st = goal_state
+    while True:
+        r, c, _ = st
+        path.append((r, c))
+        if st not in prev:
+            break
+        st = prev[st]
+    path.reverse()
+    return path
+
+
+def _first_clear_index(path: list[tuple[int, int]], bar: dict, axis: str, sign: int) -> int | None:
+    if axis == "row":
+        lo = int(bar["min_row"]) - int(bar["blue_count"])
+        hi = int(bar["max_row"]) + int(bar["blue_count"])
+    else:
+        lo = int(bar["min_col"]) - int(bar["blue_count"])
+        hi = int(bar["max_col"]) + int(bar["blue_count"])
+
+    for idx, cell in enumerate(path):
+        coord = _main_coord(cell, axis)
+        if sign == 1 and coord > hi:
+            return idx
+        if sign == -1 and coord < lo:
+            return idx
+    return None
+
+
+def _frontier_cells(
+    blocked: np.ndarray,
+    bar: dict,
+    axis: str,
+    sign: int,
+) -> list[tuple[int, int]]:
+    h, w = blocked.shape
+    if axis == "row":
+        coord = int(bar["max_row"]) + int(bar["blue_count"]) + 1 if sign == 1 else int(bar["min_row"]) - int(bar["blue_count"]) - 1
