+        endpoint_shift = abs(col - legacy_exit_col)
+        score = (stage_gap, 1 if endpoint_shift >= 2 else 0, diff, endpoint_shift)
+        metrics = {
+            "stage_choice_gap_count": stage_gap,
+            "path_diff_size": diff,
+            "endpoint_shift": endpoint_shift,
+            "legacy_exit_col": legacy_exit_col,
+            "goal_col": col,
+            "bar_count": len(rows),
+        }
+        if best is None or score > best[0]:
+            best = (score, col, metrics)
+
+    if best is None:
+        return None
+    return best[1], best[2]
+
+
+def _gen_attempt() -> np.ndarray | None:
+    edge = random.choice(("top", "bottom", "left", "right"))
+    if edge in ("top", "bottom"):
