+
+def _solve_static_path(grid: np.ndarray) -> list[tuple[int, int]] | None:
+    g = np.array(grid, copy=True)
+    bar_infos = _build_bar_infos(g)
+    start, goal, init_dir, _axis, _sign = _infer_terminals(g, bar_infos)
