+        overflow_pixels += int(np.sum(patch_before == int(other)))
+        out[r0:r1, c0:c1] = int(other)
+    return out, overflow_pixels
+
+
+def _simulate(grid: np.ndarray, *, collect_trace: bool = False) -> tuple[np.ndarray, dict[str, object]] | np.ndarray:
