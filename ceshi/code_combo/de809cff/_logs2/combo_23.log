+    centers_all: list[tuple[int, int]] = []
+    seen = set()
+    trace: dict[str, object] = {
+        "rounds": 0,
+        "centers_per_round": [],
+        "cleanup_to_bg": [],
+        "cleanup_to_other": [],
+        "cleanup_sweeps": [],
+        "overflow_pixels": 0,
