   160	    h, w = clean.shape
   161	    out = clean.copy()
   162	    coverage = _patch_coverage(clean.shape, centers)
   163	    for r, c, host in centers:
   164	        other = colors[1] if int(host) == int(colors[0]) else colors[0]
   165	        r0, r1 = max(0, r - 1), min(h, r + 2)
   166	        c0, c1 = max(0, c - 1), min(w, c + 2)
   167	        if preserve_overlap:
   168	            mask = coverage[r0:r1, c0:c1] == 1
   169	            out_patch = out[r0:r1, c0:c1]
   170	            out_patch[mask] = int(other)
   171	        else:
   172	            out[r0:r1, c0:c1] = int(other)
   173	
   174	    for r, c, _host in centers:
   175	        out[r, c] = Color.TEAL
   176	    return out
   177	
   178	
   179	def main(grid: np.ndarray) -> np.ndarray:
   180	    """
   181	    Turn clustered black dents into opposite-color patches whose overlaps cancel out.
   182	
   183	    Input structure:
   184	    - Black background with two large foreground-color regions built from overlapping rectangles.
   185	    - The regions contain single-pixel black dents, but many dents now appear in tight 2-4 cell
   186	      clusters instead of being evenly scattered.
   187	    - A few isolated one-cell foreground specks and one-cell boundary contaminations are still present
   188	      and must be ignored before reading the dents.
   189	
   190	    Rule:
   191	    - First clean the foreground locally: remove isolated specks back to black, and revert one-cell
   192	      cross-boundary contamination to the surrounding region color.
   193	    - Detect every original black dent whose cleaned 3x3 neighborhood is mostly one foreground color.
   194	    - Each dent proposes a 3x3 patch in the opposite foreground color, but pixels claimed by two or
   195	      more dent patches are not recolored at all and stay at their cleaned original color.
   196	    - After resolving overlap this way, recolor every dent center itself to teal (8).
   197	
   198	    Key insight: The transformation is no longer "stamp every 3x3 patch"; it is "stamp only the
   199	    non-overlapping fringe of each 3x3 patch". Dense dent clusters therefore leave their shared center
   200	    area unchanged while still marking each dent center in teal.
   201	    """
   202	    g = np.asarray(grid, dtype=int)
   203	    bg = Color.BLACK
   204	    colors = _main_colors(g, bg)
   205	    clean = _clean_foreground(g, colors, bg)
   206	    centers = _dent_centers(g, clean, colors, bg)
   207	    return _render_output(clean, centers, colors, preserve_overlap=True)
   208	
   209	
   210	# --------------- generator (combo) ---------------
   211	
   212	# --- CFG: canvas & region layout ---
   213	GRID_SIZE_MIN, GRID_SIZE_MAX = 20, 30
   214	RECT_SIZE_FRAC_MIN, RECT_SIZE_FRAC_MAX = 0.48, 0.78
   215	RECT_MARGIN_MAX = 3
   216	MIN_REGION_CELLS = 110
   217	COVERAGE_MIN, COVERAGE_MAX = 0.58, 0.86
   218	
   219	# --- CFG: clustered dent placement ---
   220	CLUSTERS_PER_COLOR_MIN, CLUSTERS_PER_COLOR_MAX = 2, 3
   221	TOTAL_DENTS_MIN, TOTAL_DENTS_MAX = 12, 22
   222	MIN_LARGE_CLUSTERS = 2
   223	INTER_CLUSTER_PATCH_SEPARATION = 3  # distinct clusters must not have overlapping 3x3 patches
   224	
   225	# --- CFG: noise ---
   226	NOISE_COUNT_MIN, NOISE_COUNT_MAX = 6, 14
   227	BG_NOISE_FRAC_MIN, BG_NOISE_FRAC_MAX = 0.60, 0.82
   228	BG_SPECK_MIN_BG_3x3 = 6
   229	BOUNDARY_MIN_HOST_3x3 = 6
   230	
   231	# --- CFG: generation control ---
   232	MAX_GENERATION_ATTEMPTS = 400
   233	PLACEMENT_ATTEMPTS = 80
   234	MIN_OVERLAP_PRESERVE_CELLS = 6
   235	MIN_NEW_OLD_DIFF_CELLS = 6
   236	
   237	
   238	def _build_regions(N: int, color_a: int, color_b: int, rng: random.Random) -> np.ndarray | None:
   239	    n_rects = rng.choice([2, 3])
   240	    corners = ["TL", "TR", "BL", "BR"]
   241	    rng.shuffle(corners)
   242	    chosen_corners = corners[:n_rects]
   243	
   244	    if n_rects == 2:
   245	        rect_colors = [color_a, color_b]
   246	        rng.shuffle(rect_colors)
   247	    else:
   248	        first = rng.choice([color_a, color_b])
   249	        mid = color_b if first == color_a else color_a
   250	        rect_colors = [first, mid, first]
   251	
   252	    def _make_rect(corner: str) -> tuple[int, int, int, int]:
   253	        h = rng.randint(int(N * RECT_SIZE_FRAC_MIN), int(N * RECT_SIZE_FRAC_MAX))
   254	        w = rng.randint(int(N * RECT_SIZE_FRAC_MIN), int(N * RECT_SIZE_FRAC_MAX))
   255	        m = rng.randint(0, RECT_MARGIN_MAX)
   256	        r0 = m if corner[0] == "T" else max(0, N - h - m)
   257	        c0 = m if corner[1] == "L" else max(0, N - w - m)
   258	        return r0, c0, min(N, r0 + h), min(N, c0 + w)
   259	
   260	    grid = np.zeros((N, N), dtype=int)
   261	    for corner, color in zip(chosen_corners, rect_colors):
   262	        r0, c0, r1, c1 = _make_rect(corner)
   263	        grid[r0:r1, c0:c1] = color
   264	
   265	    cnt_a = int(np.sum(grid == color_a))
   266	    cnt_b = int(np.sum(grid == color_b))
   267	    if cnt_a < MIN_REGION_CELLS or cnt_b < MIN_REGION_CELLS:
   268	        return None
   269	
   270	    coverage = (cnt_a + cnt_b) / (N * N)
   271	    if not (COVERAGE_MIN <= coverage <= COVERAGE_MAX):
   272	        return None
   273	
   274	    if n_rects == 3:
   275	        _, n_components = label(grid == rect_colors[0])
   276	        if n_components < 2:
   277	            return None
   278	    return grid
   279	
   280	
   281	def _is_deep_host(clean: np.ndarray, r: int, c: int, host: int) -> bool:
   282	    h, w = clean.shape
   283	    if not (1 <= r < h - 1 and 1 <= c < w - 1):
   284	        return False
   285	    return bool(np.all(clean[r - 1 : r + 2, c - 1 : c + 2] == int(host)))
   286	
   287	
   288	def _cluster_safe(clean: np.ndarray, cells: tuple[tuple[int, int], ...], host: int, other: int) -> bool:
   289	    temp = clean.copy()
   290	    for r, c in cells:
   291	        temp[r, c] = Color.BLACK
   292	    for r, c in cells:
   293	        sub = _sub3x3(temp, r, c)
   294	        host_count = int(np.sum(sub == int(host)))
   295	        other_count = int(np.sum(sub == int(other)))
   296	        if host_count < 5 or host_count <= other_count:
   297	            return False
   298	    return True
   299	
   300	
   301	def _normalize_shape(offsets: tuple[tuple[int, int], ...]) -> tuple[tuple[int, int], ...]:
   302	    min_r = min(r for r, _c in offsets)
   303	    min_c = min(c for _r, c in offsets)
   304	    return tuple(sorted((r - min_r, c - min_c) for r, c in offsets))
   305	
   306	
   307	def _all_shape_variants(base: tuple[tuple[int, int], ...]) -> list[tuple[tuple[int, int], ...]]:
   308	    variants = set()
   309	    cur = list(base)
   310	    for _ in range(4):
   311	        pts = tuple(cur)
   312	        variants.add(_normalize_shape(pts))
   313	        variants.add(_normalize_shape(tuple((r, -c) for r, c in pts)))
   314	        cur = [(-c, r) for r, c in cur]
   315	    return sorted(variants)
   316	
   317	
   318	_BASE_CLUSTER_SHAPES = [
   319	    ((0, 0), (0, 1)),
   320	    ((0, 0), (0, 1), (0, 2)),
   321	    ((0, 0), (0, 1), (1, 0)),
   322	    ((0, 0), (0, 1), (0, 2), (1, 1)),
   323	    ((0, 0), (0, 1), (1, 0), (1, 1)),
   324	    ((0, 0), (0, 1), (0, 2), (0, 3)),
   325	]
   326	_CLUSTER_SHAPES: dict[int, list[tuple[tuple[int, int], ...]]] = {2: [], 3: [], 4: []}
   327	for _base in _BASE_CLUSTER_SHAPES:
   328	    for _variant in _all_shape_variants(_base):
   329	        _CLUSTER_SHAPES[len(_variant)].append(_variant)
   330	for _size in _CLUSTER_SHAPES:
   331	    _CLUSTER_SHAPES[_size] = sorted(set(_CLUSTER_SHAPES[_size]))
   332	
   333	
   334	def _enumerate_cluster_candidates(
   335	    clean: np.ndarray, host: int, other: int
   336	) -> dict[int, list[tuple[tuple[int, int], ...]]]:
   337	    h, w = clean.shape
   338	    out: dict[int, list[tuple[tuple[int, int], ...]]] = {2: [], 3: [], 4: []}
   339	    seen: set[tuple[tuple[int, int], ...]] = set()
   340	    for size, shapes in _CLUSTER_SHAPES.items():
   341	        for shape in shapes:
   342	            max_r = max(r for r, _c in shape)
   343	            max_c = max(c for _r, c in shape)
   344	            for r0 in range(h - max_r):
   345	                for c0 in range(w - max_c):
   346	                    cells = tuple(sorted((r0 + dr, c0 + dc) for dr, dc in shape))
   347	                    if cells in seen:
   348	                        continue
   349	                    if any(clean[r, c] != int(host) or not _is_deep_host(clean, r, c, host) for r, c in cells):
   350	                        continue
   351	                    if not _cluster_safe(clean, cells, host, other):
   352	                        continue
   353	                    seen.add(cells)
   354	                    out[size].append(cells)
   355	    return out
