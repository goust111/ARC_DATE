+        orbits.append(
+            {
+                "cells": orbit,
+                "center_color": int(center_color),
+                "host": int(info["host"]),
+                "axis_kind": axis_kind,
+                "axis_k": int(axis_k),
+                "component_key": (int(info["host"]), int(info["comp_id"])),
+            }
+        )
