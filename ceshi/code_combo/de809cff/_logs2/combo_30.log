+    stamp_map = _stamp_map(role_colors)
+    output = _stamp_dents(clean, dent_groups, stamp_map, clipped=True)
+    legacy = _stamp_dents(clean, dent_groups, stamp_map, clipped=False)
+    if np.array_equal(output, legacy):
