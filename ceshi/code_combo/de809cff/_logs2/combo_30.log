+        for c in range(clean.shape[1]):
+            host = int(clean[r, c])
+            if host not in colors:
+                continue
+            nearby = sorted({int(x) for x in _sub3x3(clean, int(r), int(c)).flat if int(x) in colors and int(x) != int(host)})
+            for other in nearby:
+                candidates.append((int(r), int(c), int(host), int(other)))
