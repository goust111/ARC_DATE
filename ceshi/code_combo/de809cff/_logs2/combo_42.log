+    if diag["mixed_clusters"] < 1:
+        return None
+    if diag["merge_delta_cells"] < MIN_MERGE_DELTA:
+        return None
+    if diag["crop_ratio"] > MAX_CROP_RATIO:
+        return None
+    if len(diag["components"]) != 1:
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(MAX_GENERATION_ATTEMPTS):
