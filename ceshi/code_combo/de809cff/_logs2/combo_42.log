   126	def _cluster_patch_regions(
   127	    shape: tuple[int, int], centers: list[tuple[int, int, int]], colors: tuple[int, int]
   128	) -> list[dict]:
   129	    n = len(centers)
   130	    parents = list(range(n))
   131	    footprints = [_patch_cells(shape, r, c) for r, c, _host in centers]
   132	
   133	    def find(x: int) -> int:
   134	        while parents[x] != x:
   135	            parents[x] = parents[parents[x]]
   136	            x = parents[x]
   137	        return x
   138	
   139	    def union(x: int, y: int) -> None:
   140	        rx = find(x)
   141	        ry = find(y)
   142	        if rx != ry:
   143	            parents[ry] = rx
   144	
   145	    for i in range(n):
   146	        for j in range(i + 1, n):
   147	            if footprints[i].intersection(footprints[j]):
   148	                union(i, j)
   149	
   150	    groups: dict[int, list[int]] = {}
   151	    for idx in range(n):
   152	        groups.setdefault(find(idx), []).append(idx)
   153	
   154	    components: list[dict] = []
   155	    for indices in groups.values():
   156	        union_cells: set[tuple[int, int]] = set()
   157	        for idx in indices:
   158	            union_cells |= footprints[idx]
   159	        rows = [rr for rr, _cc in union_cells]
   160	        cols = [cc for _rr, cc in union_cells]
   161	        center_r = float(sum(rows)) / float(len(rows))
   162	        center_c = float(sum(cols)) / float(len(cols))
   163	
   164	        scored: list[tuple[float, int, int, int]] = []
