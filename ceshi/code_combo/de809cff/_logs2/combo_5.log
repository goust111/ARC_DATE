            ### 参考代码: D4/0

            文件: `/home/lixinyu/snap/new/ceshi/code/de809cff/D4/0/code.py`

            ```python
            # Variant of de809cff
# Dimension: D4 — 前景色区域的数量与类型 (src)
# Change: 恰好两个大面积前景色区域（如绿色3和黄色4），形成不规则形状占据网格大部分面积... → 三个前景色区域

from __future__ import annotations

import random
from collections import Counter as _Counter

import numpy as np

from arc_utils import Color

# Design analysis for the D4 variant
# ----------------------------------
# concrete_behavior:
#   clean scene:
#     - black background plus exactly three large connected foreground regions
#     - the three regions play stable spatial roles: left, right, bottom
#     - each region has black dents and a few one-cell wrong-color specks
#   output scene:
#     - after cleanup, every dent becomes a 3x3 patch whose color follows a
#       visible role cycle: left -> right, right -> bottom, bottom -> left
#     - the dent center itself is teal
#   small execution trace:
#     - original task: a dent inside the green region always stamps the only
#       other foreground color, say yellow
#     - new task: a dent inside the left region does not use "the only other"
#       color because there are two alternatives; instead it uses the color of
#       the right region, while right dents use bottom and bottom dents use left
#     - difference: the solver must infer three roles first, then map host role
#       through a 3-cycle before stamping the 3x3 patch
# complexity_calibration:
#   - using three large regions keeps the main visual motif from the source task
#   - role-based color mapping has only one branch pattern (a fixed cycle), so
#     samples can repeat it enough for humans to infer it
#   - the generator guarantees dents in all three regions, preventing collapse
#     back to an effectively two-region training signal
# implicit_assumption_audit:
#   - old _main_colors assumed two colors; now the solver asserts three
#   - old cleanup compared a cell only against one "other" color; now it checks
#     for any unique dominant rival among three colors
#   - old dent stamping used host -> unique other-color; now it uses host-role
#     -> mapped role color, so role inference must happen before stamping
# placement_legality:
#   - generator paints three large rectangles in fixed spatial roles so the
#     centroid-based role inference is stable
#   - dent centers are chosen only where the host color is the unique 3x3
#     majority even after the center is removed
#   - noise is added with local legality checks and every sample is still
#     validated once by the full solver at the end
# visual_observability:
#   - the rule never depends on color ids or area ranking
#   - role identity is visible from position, and each sample contains all three
#     host colors producing dents, so the cycle is observable from examples
# neatness:
#   - only one overlay layer is added per dent (3x3 patch + teal center)
#   - patches are separated by Chebyshev distance >= 3, limiting clutter


def _sub3x3(grid: np.ndarray, r: int, c: int) -> np.ndarray:
    h, w = grid.shape
    return grid[max(0, r - 1) : min(h, r + 2), max(0, c - 1) : min(w, c + 2)]


def _main_colors(g: np.ndarray, bg: int) -> tuple[int, int, int]:
    colors = [int(c) for c in np.unique(g) if int(c) != int(bg)]
    colors.sort(key=lambda c: int(np.sum(g == c)), reverse=True)
    assert len(colors) >= 3, "expected three foreground colors"
    return int(colors[0]), int(colors[1]), int(colors[2])


def _has_same_2x2(g: np.ndarray, r: int, c: int, color: int) -> bool:
    h, w = g.shape
    for dr in (-1, 0):
        for dc in (-1, 0):
            rr = int(r) + dr
            cc = int(c) + dc
            if 0 <= rr < h - 1 and 0 <= cc < w - 1:
                if bool(np.all(g[rr : rr + 2, cc : cc + 2] == int(color))):
                    return True
    return False


def _dominant_color(sub: np.ndarray, colors: tuple[int, int, int], threshold: int = 5) -> int | None:
    counts = {int(color): int(np.sum(sub == int(color))) for color in colors}
    best = max(counts.values())
    winners = [color for color, count in counts.items() if count == best]
    if best < threshold or len(winners) != 1:
        return None
    return int(winners[0])


def _clean_cell(cur: np.ndarray, r: int, c: int, colors: tuple[int, int, int], bg: int) -> int:
    v = int(cur[r, c])
    if v not in colors:
        return int(bg)

    if _has_same_2x2(cur, r, c, v):
        return v

    sub = _sub3x3(cur, r, c)
    counts = {int(color): int(np.sum(sub == int(color))) for color in colors}
    own = counts[v]
    bg_count = int(np.sum(sub == int(bg)))
    dominant = _dominant_color(sub, colors, threshold=5)

    if dominant is not None and int(dominant) != v and counts[int(dominant)] > own:
        return int(dominant)
    if bg_count >= 5 and own <= 4:
        return int(bg)
    if own <= 2:
        return int(bg)
    return v


def _clean_foreground(g: np.ndarray, colors: tuple[int, int, int], bg: int) -> np.ndarray:
    """
    Remove one-cell specks/protrusions before detecting black dents.

    The same two-sweep local majority cleanup still works in the three-color
    setting as long as rival recoloring requires a unique dominant foreground
    color in the 3x3 neighborhood.
    """
    h, w = g.shape
    cur = g.copy()

    for _ in range(2):
        nxt = cur.copy()
        for r in range(h):
            for c in range(w):
                nxt[r, c] = _clean_cell(cur, r, c, colors, bg)
        cur = nxt

    return cur


def _role_colors(clean: np.ndarray, colors: tuple[int, int, int]) -> dict[str, int]:
    stats: dict[int, tuple[float, float]] = {}
    for color in colors:
        coords = np.argwhere(clean == int(color))
        assert len(coords) > 0, "missing region color"
        stats[int(color)] = (float(coords[:, 0].mean()), float(coords[:, 1].mean()))

    bottom = max(colors, key=lambda color: stats[int(color)][0])
    top_two = [int(color) for color in colors if int(color) != int(bottom)]
    left = min(top_two, key=lambda color: stats[int(color)][1])
    right = max(top_two, key=lambda color: stats[int(color)][1])
    return {"left": int(left), "right": int(right), "bottom": int(bottom)}


def _stamp_map(clean: np.ndarray, colors: tuple[int, int, int]) -> dict[int, int]:
    roles = _role_colors(clean, colors)
    return {
        int(roles["left"]): int(roles["right"]),
        int(roles["right"]): int(roles["bottom"]),
        int(roles["bottom"]): int(roles["left"]),
    }


def _dent_centers(
    original: np.ndarray, clean: np.ndarray, colors: tuple[int, int, int], bg: int
) -> list[tuple[int, int, int]]:
    centers: list[tuple[int, int, int]] = []
    for r, c in np.argwhere(original == int(bg)):
        rr = int(r)
        cc = int(c)
        dominant = _dominant_color(_sub3x3(clean, rr, cc), colors, threshold=5)
        if dominant is not None:
            centers.append((rr, cc, int(dominant)))
    return centers


def main(grid: np.ndarray) -> np.ndarray:
    """
    Turn black dents in three colored regions into marked cyclic-color patches.

    Input structure:
    - Black background with three large foreground regions, visually arranged as
      left, right, and bottom masses.
    - The regions contain small black dents plus one-cell foreground specks in
      the background or along region boundaries.

    Rule:
    - First clean local one-cell corruption: isolated stray foreground cells
      revert to black, while a lone boundary intrusion flips back to the unique
      neighboring foreground majority.
    - For each original black dent whose cleaned 3x3 neighborhood is dominated
      by one region color, place a 3x3 patch in the cyclic target color:
      left dents use right, right dents use bottom, bottom dents use left.
    - Recolor every dent center teal (8) after stamping the surrounding patch.

    Key insight: The puzzle is no longer "use the only other color"; instead,
    the three large regions define spatial roles, and the dent patch color is
    determined by the role cycle left -> right -> bottom -> left.
    """
    g = np.asarray(grid, dtype=int)
    bg = Color.BLACK
    colors = _main_colors(g, bg)
    clean = _clean_foreground(g, colors, bg)
    stamp_map = _stamp_map(clean, colors)

    out = clean.copy()
    h, w = g.shape
    centers = _dent_centers(g, clean, colors, bg)
    for r, c, host in centers:
        out[max(0, r - 1) : min(h, r + 2), max(0, c - 1) : min(w, c + 2)] = int(stamp_map[int(host)])

    for r, c, _host in centers:
        out[r, c] = Color.TEAL

    return out


# --------------- generator (cx) ---------------

# --- CFG: canvas & region layout ---
GRID_SIZE_MIN, GRID_SIZE_MAX = 22, 30
TOP_RECT_H_FRAC = (0.58, 0.80)
TOP_RECT_W_FRAC = (0.46, 0.62)
BOTTOM_RECT_H_FRAC = (0.36, 0.52)
BOTTOM_RECT_W_FRAC = (0.58, 0.82)
RECT_MARGIN_MAX = 3
MIN_REGION_CELLS = 85
COVERAGE_MIN, COVERAGE_MAX = 0.60, 0.84
LEFT_RIGHT_OVERLAP_MIN = 2
BOTTOM_OVERLAP_MIN = 10

# --- CFG: dent placement ---
DENTS_PER_ROLE_MIN, DENTS_PER_ROLE_MAX = 4, 6
DENT_MIN_HOST_3x3 = 5
DENT_PATCH_SEPARATION = 3
DENT_PAIR_PROB = 0.14

# --- CFG: noise ---
NOISE_COUNT_MIN, NOISE_COUNT_MAX = 8, 18
BG_NOISE_FRAC_MIN, BG_NOISE_FRAC_MAX = 0.60, 0.80
BG_SPECK_MIN_BG_3x3 = 6
BOUNDARY_MIN_HOST_3x3 = 6

# --- CFG: generation control ---
MAX_GENERATION_ATTEMPTS = 400


def _rand_span(N: int, frac_range: tuple[float, float], rng: random.Random) -> int:
    lo = max(1, int(round(N * frac_range[0])))
    hi = max(lo, int(round(N * frac_range[1])))
    return rng.randint(lo, hi)


def _build_regions(N: int, role_colors: dict[str, int], rng: random.Random) -> np.ndarray | None:
    left = int(role_colors["left"])
    right = int(role_colors["right"])
    bottom = int(role_colors["bottom"])

    for _ in range(60):
        l_h = _rand_span(N, TOP_RECT_H_FRAC, rng)
        l_w = _rand_span(N, TOP_RECT_W_FRAC, rng)
        r_h = _rand_span(N, TOP_RECT_H_FRAC, rng)
        r_w = _rand_span(N, TOP_RECT_W_FRAC, rng)
        b_h = _rand_span(N, BOTTOM_RECT_H_FRAC, rng)
        b_w = _rand_span(N, BOTTOM_RECT_W_FRAC, rng)

        l_r0 = rng.randint(0, RECT_MARGIN_MAX)
        l_c0 = rng.randint(0, RECT_MARGIN_MAX)
        r_r0 = rng.randint(0, RECT_MARGIN_MAX)
        r_c0 = max(0, N - r_w - rng.randint(0, RECT_MARGIN_MAX))
        b_r0 = max(0, N - b_h - rng.randint(0, RECT_MARGIN_MAX))
        b_center_jitter = rng.randint(-max(1, N // 10), max(1, N // 10))
        b_c0 = (N - b_w) // 2 + b_center_jitter
        b_c0 = min(max(0, b_c0), max(0, N - b_w))

        l_r1, l_c1 = min(N, l_r0 + l_h), min(N, l_c0 + l_w)
        r_r1, r_c1 = min(N, r_r0 + r_h), min(N, r_c0 + r_w)
        b_r1, b_c1 = min(N, b_r0 + b_h), min(N, b_c0 + b_w)

        lr_overlap_h = max(0, min(l_r1, r_r1) - max(l_r0, r_r0))
        lr_overlap_w = max(0, min(l_c1, r_c1) - max(l_c0, r_c0))
        left_bottom_overlap = max(0, min(l_r1, b_r1) - max(l_r0, b_r0)) * max(0, min(l_c1, b_c1) - max(l_c0, b_c0))
        right_bottom_overlap = max(0, min(r_r1, b_r1) - max(r_r0, b_r0)) * max(0, min(r_c1, b_c1) - max(r_c0, b_c0))
        if lr_overlap_h <= 0 or lr_overlap_w < LEFT_RIGHT_OVERLAP_MIN:
            continue
        if left_bottom_overlap < BOTTOM_OVERLAP_MIN or right_bottom_overlap < BOTTOM_OVERLAP_MIN:
            continue

        grid = np.zeros((N, N), dtype=int)
        grid[l_r0:l_r1, l_c0:l_c1] = left
        grid[r_r0:r_r1, r_c0:r_c1] = right
        grid[b_r0:b_r1, b_c0:b_c1] = bottom

        counts = {color: int(np.sum(grid == color)) for color in role_colors.values()}
        if min(counts.values()) < MIN_REGION_CELLS:
            continue
        coverage = sum(counts.values()) / float(N * N)
        if not (COVERAGE_MIN <= coverage <= COVERAGE_MAX):
            continue
        if _role_colors(grid, _main_colors(grid, Color.BLACK)) != role_colors:
            continue
        return grid
    return None


def _is_safe_dent_center(grid: np.ndarray, r: int, c: int, host: int, colors: tuple[int, int, int]) -> bool:
    if int(grid[r, c]) != int(host):
        return False
    sub = _sub3x3(grid, r, c)
    counts = {int(color): int(np.sum(sub == int(color))) for color in colors}
    counts[int(host)] -= 1
    host_count = counts[int(host)]
    other_max = max(counts[int(color)] for color in colors if int(color) != int(host))
    return host_count >= DENT_MIN_HOST_3x3 and host_count > other_max


def _pick_dent_centers(
    valid: dict[int, list[tuple[int, int]]], wanted: dict[int, int], rng: random.Random
) -> dict[int, list[tuple[int, int]]] | None:
    chosen: dict[int, list[tuple[int, int]]] = {int(color): [] for color in valid}
    occupied: list[tuple[int, int]] = []
    order = sorted(valid, key=lambda color: len(valid[int(color)]))

    for color in order:
        candidates = valid[int(color)].copy()
        rng.shuffle(candidates)
        for r, c in candidates:
            if all(max(abs(r - rr), abs(c - cc)) >= DENT_PATCH_SEPARATION for rr, cc in occupied):
                chosen[int(color)].append((int(r), int(c)))
                occupied.append((int(r), int(c)))
                if len(chosen[int(color)]) >= int(wanted[int(color)]):
                    break
        if len(chosen[int(color)]) < int(wanted[int(color)]):
            return None
    return chosen


def _expand_to_pairs(
    dents: dict[int, list[tuple[int, int]]],
    clean: np.ndarray,
    colors: tuple[int, int, int],
    rng: random.Random,
) -> dict[int, list[list[tuple[int, int]]]]:
    h, w = clean.shape
    occupied = {(r, c) for centers in dents.values() for r, c in centers}
    groups: dict[int, list[list[tuple[int, int]]]] = {int(color): [] for color in dents}

    for color, centers in dents.items():
        for r, c in centers:
            cells = [(int(r), int(c))]
            if rng.random() < DENT_PAIR_PROB:
                neighbors = [(r + 1, c), (r - 1, c), (r, c + 1), (r, c - 1)]
                rng.shuffle(neighbors)
                for nr, nc in neighbors:
                    if not (0 <= nr < h and 0 <= nc < w):
                        continue
                    if (nr, nc) in occupied:
                        continue
                    if int(clean[nr, nc]) != int(color):
                        continue
                    if not _is_safe_dent_center(clean, nr, nc, int(color), colors):
                        continue
                    if any(max(abs(nr - rr), abs(nc - cc)) < DENT_PATCH_SEPARATION for rr, cc in occupied if (rr, cc) != (r, c)):
                        continue
                    cells.append((int(nr), int(nc)))
                    occupied.add((int(nr), int(nc)))
                    break
            groups[int(color)].append(cells)
    return groups


def _stamp_dents(clean: np.ndarray, dent_groups: dict[int, list[list[tuple[int, int]]]], stamp_map: dict[int, int]) -> np.ndarray:
    h, w = clean.shape
    output = clean.copy()
    for host, groups in dent_groups.items():
        stamp_color = int(stamp_map[int(host)])
        for cells in groups:
            for r, c in cells:
                output[max(0, r - 1) : min(h, r + 2), max(0, c - 1) : min(w, c + 2)] = stamp_color
    for groups in dent_groups.values():
        for cells in groups:
            for r, c in cells:
                output[r, c] = Color.TEAL
    return output


def _nearby_speck_color(clean: np.ndarray, r: int, c: int, colors: tuple[int, int, int], rng: random.Random) -> int:
    nearby = [int(x) for x in _sub3x3(clean, r, c).flat if int(x) in colors]
    if nearby:
        return int(_Counter(nearby).most_common(1)[0][0])
    return int(rng.choice(list(colors)))


def _add_bg_noise(inp: np.ndarray, clean: np.ndarray, n_in_bg: int, colors: tuple[int, int, int], rng: random.Random) -> int:
    bg_candidates = list(np.argwhere(clean == Color.BLACK))
    rng.shuffle(bg_candidates)

    placed = 0
    for r, c in bg_candidates:
        if placed >= n_in_bg:
            break
        rr = int(r)
        cc = int(c)
        if int(inp[rr, cc]) != int(Color.BLACK):
            continue
        if int(np.sum(_sub3x3(inp, rr, cc) == Color.BLACK)) < BG_SPECK_MIN_BG_3x3:
            continue
        inp[rr, cc] = _nearby_speck_color(clean, rr, cc, colors, rng)
        placed += 1
    return placed


def _would_form_2x2(grid: np.ndarray, r: int, c: int, color: int) -> bool:
    h, w = grid.shape
    for dr in (-1, 0):
        for dc in (-1, 0):
            rr, cc = r + dr, c + dc
            if 0 <= rr < h - 1 and 0 <= cc < w - 1:
                block = grid[rr : rr + 2, cc : cc + 2].copy()
                block[r - rr, c - cc] = int(color)
                if bool(np.all(block == int(color))):
                    return True
    return False


def _boundary_noise_safe(
    inp: np.ndarray,
    r: int,
    c: int,
    host: int,
    other: int,
    colors: tuple[int, int, int],
    bg: int,
) -> bool:
    if int(inp[r, c]) != int(host):
        return False

    sub_now = _sub3x3(inp, r, c)
    host_count = int(np.sum(sub_now == int(host)))
    other_count = int(np.sum(sub_now == int(other)))
    if host_count < BOUNDARY_MIN_HOST_3x3 or host_count - 1 <= other_count + 1:
        return False
    if _would_form_2x2(inp, r, c, other):
        return False

    test = inp.copy()
    test[r, c] = int(other)
    if _clean_cell(test, r, c, colors, bg) != int(host):
        return False

    r0 = max(0, r - 1)
    r1 = min(inp.shape[0], r + 2)
    c0 = max(0, c - 1)
    c1 = min(inp.shape[1], c + 2)
    for rr in range(r0, r1):
        for cc in range(c0, c1):
            before = _clean_cell(inp, rr, cc, colors, bg)
            after = _clean_cell(test, rr, cc, colors, bg)
            if (rr, cc) == (r, c):
                if after != int(host):
                    return False
            elif after != before:
                return False
    return True


def _add_boundary_noise(
    inp: np.ndarray,
    clean: np.ndarray,
    n_at_boundary: int,
    colors: tuple[int, int, int],
    rng: random.Random,
) -> int:
    candidates: list[tuple[int, int, int, int]] = []
    for r in range(clean.shape[0]):
        for c in range(clean.shape[1]):
            host = int(clean[r, c])
            if host not in colors:
                continue
            nearby = sorted({int(x) for x in _sub3x3(clean, r, c).flat if int(x) in colors and int(x) != host})
            for other in nearby:
                candidates.append((int(r), int(c), int(host), int(other)))
    rng.shuffle(candidates)

    placed = 0
    for r, c, host, other in candidates:
        if placed >= n_at_boundary:
            break
        if _boundary_noise_safe(inp, r, c, host, other, colors, Color.BLACK):
            inp[r, c] = int(other)
            placed += 1
    return placed


def _gen_attempt(rng: random.Random) -> np.ndarray | None:
    N = rng.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)
    fg_pool = [int(c) for c in Color.NOT_BLACK if int(c) != int(Color.TEAL)]
    left_color, right_color, bottom_color = rng.sample(fg_pool, 3)
    role_colors = {"left": left_color, "right": right_color, "bottom": bottom_color}

    clean = _build_regions(N, role_colors, rng)
    if clean is None:
        return None

    colors = _main_colors(clean, Color.BLACK)
    stamp_map = _stamp_map(clean, colors)

    valid: dict[int, list[tuple[int, int]]] = {int(color): [] for color in colors}
    for r in range(N):
        for c in range(N):
            host = int(clean[r, c])
            if host in valid and _is_safe_dent_center(clean, r, c, host, colors):
                valid[host].append((int(r), int(c)))

    wanted: dict[int, int] = {}
    for color in colors:
        extras = rng.randint(0, DENTS_PER_ROLE_MAX - DENTS_PER_ROLE_MIN)
        wanted[int(color)] = DENTS_PER_ROLE_MIN + extras
        if len(valid[int(color)]) < wanted[int(color)] + 2:
            return None

    dents = _pick_dent_centers(valid, wanted, rng)
    if dents is None:
        return None

    groups = _expand_to_pairs(dents, clean, colors, rng)
    output = _stamp_dents(clean, groups, stamp_map)

    inp = clean.copy()
    for host_groups in groups.values():
        for cells in host_groups:
            for r, c in cells:
                inp[r, c] = Color.BLACK

    n_noise = rng.randint(NOISE_COUNT_MIN, NOISE_COUNT_MAX)
    n_bg = int(round(n_noise * rng.uniform(BG_NOISE_FRAC_MIN, BG_NOISE_FRAC_MAX)))
    placed_bg = _add_bg_noise(inp, clean, n_bg, colors, rng)
    placed_bd = _add_boundary_noise(inp, clean, n_noise - placed_bg, colors, rng)
    if placed_bg + placed_bd < max(6, n_noise - 3):
        return None

    produced = main(inp)
    if not np.array_equal(produced, output):
        return None
    return inp


def generate_input() -> np.ndarray:
    rng = random.Random()
    for _ in range(MAX_GENERATION_ATTEMPTS):
        try:
            grid = _gen_attempt(rng)
        except Exception:
            grid = None
        if grid is not None:
            return grid
    raise RuntimeError(f"generate_input: failed after {MAX_GENERATION_ATTEMPTS} attempts")

            ```

            ### 参考代码: D13/0

            文件: `/home/lixinyu/snap/new/ceshi/code/de809cff/D13/0/code.py`

            ```python
            # Variant of de809cff
# Dimension: D13 — 两种前景色之间的对调映射关系 (meta)
# Change: 固定双色对调：区域A的凹痕用色B填充补丁，区域B的凹痕用色A填充补丁（简单二元交换）... → 颜色映射由图例区域定义

from __future__ import annotations

# Design analysis
# - Concrete appearance:
#   The original scene stays intact: two large foreground regions sit on black,
#   black dents are punched into them, and a few single-cell noise pixels are
#   scattered in background or on the region boundary. The D13 change adds one
#   isolated 2x2 legend block on a grid edge. The outer edge row/column lists
#   the two host colors; the adjacent inner row/column lists the colors to use
#   for that host's dent patch. Because there are only two hosts, a fixed 2x2
#   legend is enough and keeps the symbolic step visually obvious.
# - Behavior trace:
#   Original logic: if a dent belongs to region A, stamp color B; if it belongs
#   to region B, stamp color A. New logic: read the legend first. Example:
#   top-edge legend outer row [A, B], inner row [C, A] means A→C and B→A. A's
#   dents now get C patches, B's dents now get A patches. The teal center mark
#   still identifies the original black dent location.
# - Complexity calibration:
#   The legend is small and repeated only once, so it does not overwhelm the
#   scene, but it is also not hidden: it sits on an edge and is surrounded by a
#   one-cell black moat. Mapping values are chosen from {A, B, C}, where C is a
#   third non-black, non-teal color. This keeps the rule space small enough for
#   ARC while making the meta-rule visible in 2-4 examples.
# - Old assumptions that break under D13:
#   `_clean_foreground` used to erase every non-main color to black. That would
#   destroy legend cells when a third color is used, so legend cells must be
#   preserved and excluded from cleanup.
#   `main()` used to hard-code "other foreground color" as the patch color. That
#   must become a lookup from host color into the decoded legend mapping.
#   Patch stamping used to be free to overwrite any cell in the 3x3 window. With
#   a legend now present, generator keeps dents away from the reserved legend
#   zone, and solver also avoids overwriting legend cells as a safety guard.
# - Placement legality:
#   Generator reserves the legend block plus its one-cell moat before painting
#   the large rectangles. Dent centers, background specks, and boundary-noise
#   cells are all forbidden from that reserved zone; dent centers are also
#   filtered so their 3x3 patch cannot touch it.
# - Visual observability / cleanliness:
#   The legend side and key order vary, but the structure is stable: edge-facing
#   keys, inward-facing mapped colors, black moat around the block. This makes
#   the symbol-decoding step easy to spot and keeps the output uncluttered.
# - New solver assumptions and generator guarantees:
#   Solver assumes there is exactly one isolated 2x2 edge legend whose outer
#   edge cells are the two dominant region colors. Generator guarantees that by
#   placing exactly one such block, keeping it isolated by black, and ensuring
#   the two large regions remain far larger than the legend colors by count.

import random
from collections import Counter as _Counter

import numpy as np

from arc_utils import Color


def _main_colors(g: np.ndarray, bg: int) -> tuple[int, int]:
    colors = [int(c) for c in np.unique(g) if int(c) != int(bg)]
    colors.sort(key=lambda c: int(np.sum(g == c)), reverse=True)
    assert len(colors) >= 2, "expected two foreground colors"
    return int(colors[0]), int(colors[1])


def _sub3x3(grid: np.ndarray, r: int, c: int) -> np.ndarray:
    h, w = grid.shape
    return grid[max(0, r - 1) : min(h, r + 2), max(0, c - 1) : min(w, c + 2)]


def _legend_masks(shape: tuple[int, int], side: str, start: int) -> tuple[np.ndarray, np.ndarray]:
    h, w = shape
    legend = np.zeros((h, w), dtype=bool)
    if side == "top":
        r0, r1, c0, c1 = 0, 2, start, start + 2
    elif side == "bottom":
        r0, r1, c0, c1 = h - 2, h, start, start + 2
    elif side == "left":
        r0, r1, c0, c1 = start, start + 2, 0, 2
    else:
        r0, r1, c0, c1 = start, start + 2, w - 2, w

    legend[r0:r1, c0:c1] = True
    reserved = np.zeros((h, w), dtype=bool)
    reserved[max(0, r0 - 1) : min(h, r1 + 1), max(0, c0 - 1) : min(w, c1 + 1)] = True
    return legend, reserved


def _legend_array(side: str, keys: tuple[int, int], fills: tuple[int, int]) -> np.ndarray:
    a, b = map(int, keys)
    x, y = map(int, fills)
    if side == "top":
        return np.array([[a, b], [x, y]], dtype=int)
    if side == "bottom":
        return np.array([[x, y], [a, b]], dtype=int)
    if side == "left":
        return np.array([[a, x], [b, y]], dtype=int)
    return np.array([[x, a], [y, b]], dtype=int)


def _paint_legend(canvas: np.ndarray, side: str, start: int, legend_block_2x2: np.ndarray) -> None:
    if side == "top":
        canvas[0:2, start : start + 2] = legend_block_2x2
    elif side == "bottom":
        canvas[-2:, start : start + 2] = legend_block_2x2
    elif side == "left":
        canvas[start : start + 2, 0:2] = legend_block_2x2
    else:
        canvas[start : start + 2, -2:] = legend_block_2x2


def _surrounding_ring_is_bg(g: np.ndarray, legend_mask: np.ndarray, bg: int) -> bool:
    rows, cols = np.where(legend_mask)
    r0, r1 = int(rows.min()), int(rows.max()) + 1
    c0, c1 = int(cols.min()), int(cols.max()) + 1
    rr0, rr1 = max(0, r0 - 1), min(g.shape[0], r1 + 1)
    cc0, cc1 = max(0, c0 - 1), min(g.shape[1], c1 + 1)
    for r in range(rr0, rr1):
        for c in range(cc0, cc1):
            if legend_mask[r, c]:
                continue
            if int(g[r, c]) != int(bg):
                return False
    return True


def _palette_mapping(g: np.ndarray, colors: tuple[int, int], bg: int) -> tuple[dict[int, int], np.ndarray]:
    h, w = g.shape
    a, b = map(int, colors)
    color_set = {a, b}
    candidates: list[tuple[dict[int, int], np.ndarray]] = []

    if w >= 2:
        for c0 in range(w - 1):
            legend_mask, _reserved = _legend_masks((h, w), "top", c0)
            block = g[0:2, c0 : c0 + 2]
            outer = [int(x) for x in block[0].tolist()]
            inner = [int(x) for x in block[1].tolist()]
            if set(outer) == color_set and len(set(outer)) == 2 and all(v != bg for v in inner):
                if np.all(block != int(bg)) and _surrounding_ring_is_bg(g, legend_mask, bg):
                    candidates.append(({outer[0]: inner[0], outer[1]: inner[1]}, legend_mask))

        for c0 in range(w - 1):
            legend_mask, _reserved = _legend_masks((h, w), "bottom", c0)
            block = g[h - 2 : h, c0 : c0 + 2]
            outer = [int(x) for x in block[1].tolist()]
            inner = [int(x) for x in block[0].tolist()]
            if set(outer) == color_set and len(set(outer)) == 2 and all(v != bg for v in inner):
                if np.all(block != int(bg)) and _surrounding_ring_is_bg(g, legend_mask, bg):
                    candidates.append(({outer[0]: inner[0], outer[1]: inner[1]}, legend_mask))

    if h >= 2:
        for r0 in range(h - 1):
            legend_mask, _reserved = _legend_masks((h, w), "left", r0)
            block = g[r0 : r0 + 2, 0:2]
            outer = [int(x) for x in block[:, 0].tolist()]
            inner = [int(x) for x in block[:, 1].tolist()]
            if set(outer) == color_set and len(set(outer)) == 2 and all(v != bg for v in inner):
                if np.all(block != int(bg)) and _surrounding_ring_is_bg(g, legend_mask, bg):
                    candidates.append(({outer[0]: inner[0], outer[1]: inner[1]}, legend_mask))

        for r0 in range(h - 1):
            legend_mask, _reserved = _legend_masks((h, w), "right", r0)
            block = g[r0 : r0 + 2, w - 2 : w]
            outer = [int(x) for x in block[:, 1].tolist()]
            inner = [int(x) for x in block[:, 0].tolist()]
            if set(outer) == color_set and len(set(outer)) == 2 and all(v != bg for v in inner):
                if np.all(block != int(bg)) and _surrounding_ring_is_bg(g, legend_mask, bg):
                    candidates.append(({outer[0]: inner[0], outer[1]: inner[1]}, legend_mask))

    assert len(candidates) == 1, "expected exactly one edge legend"
    mapping, legend_mask = candidates[0]
    assert set(mapping) == color_set, "legend keys must match the two main colors"
    return mapping, legend_mask


def _has_same_2x2(g: np.ndarray, r: int, c: int, color: int) -> bool:
    h, w = g.shape
    for dr in (-1, 0):
        for dc in (-1, 0):
            rr = int(r) + dr
            cc = int(c) + dc
            if 0 <= rr < h - 1 and 0 <= cc < w - 1:
                if bool(np.all(g[rr : rr + 2, cc : cc + 2] == int(color))):
                    return True
    return False


def _clean_foreground(g: np.ndarray, colors: tuple[int, int], bg: int, legend_mask: np.ndarray) -> np.ndarray:
    """
    Remove one-cell specks/protrusions before detecting black dents.

    Legend cells are preserved verbatim; the cleanup only applies to the two
    large regions and treats the legend as off-limits structure.
    """
    h, w = g.shape
    a, b = map(int, colors)
    cur = g.copy()

    for _ in range(2):
        nxt = cur.copy()
        for r in range(h):
            for c in range(w):
                if legend_mask[r, c]:
                    nxt[r, c] = cur[r, c]
                    continue

                v = int(cur[r, c])
                if v not in colors:
                    nxt[r, c] = bg
                    continue

                rs = slice(max(0, r - 1), min(h, r + 2))
                cs = slice(max(0, c - 1), min(w, c + 2))
                sub = cur[rs, cs]
                sub_legend = legend_mask[rs, cs]
                own = int(np.sum((sub == v) & (~sub_legend)))
                other = b if v == a else a
                other_count = int(np.sum((sub == other) & (~sub_legend)))
                bg_count = int(np.sum((sub == bg) & (~sub_legend)))

                if _has_same_2x2(cur, r, c, v):
                    nxt[r, c] = v
                elif other_count > own and other_count >= 5:
                    nxt[r, c] = other
                elif bg_count >= 5 and own <= 4:
                    nxt[r, c] = bg
                elif own <= 2:
                    nxt[r, c] = bg
                else:
                    nxt[r, c] = v
        cur = nxt

    return cur


def _dent_centers(
    original: np.ndarray,
    clean: np.ndarray,
    colors: tuple[int, int],
    bg: int,
    legend_mask: np.ndarray,
) -> list[tuple[int, int, int]]:
    h, w = original.shape
    centers: list[tuple[int, int, int]] = []
    for r, c in zip(*np.where((original == int(bg)) & (~legend_mask)), strict=False):
        rr = int(r)
        cc = int(c)
        rs = slice(max(0, rr - 1), min(h, rr + 2))
        cs = slice(max(0, cc - 1), min(w, cc + 2))
        sub = clean[rs, cs]
        sub_legend = legend_mask[rs, cs]
        counts = {
            int(color): int(np.sum((sub == int(color)) & (~sub_legend)))
            for color in colors
        }
        host = max(colors, key=lambda color: counts[int(color)])
        other = colors[1] if int(host) == int(colors[0]) else colors[0]
        if counts[int(host)] >= 5 and counts[int(host)] > counts[int(other)]:
            centers.append((rr, cc, int(host)))
    return centers


def _paint_patch(out: np.ndarray, legend_mask: np.ndarray, r: int, c: int, color: int) -> None:
    h, w = out.shape
    rs = slice(max(0, r - 1), min(h, r + 2))
    cs = slice(max(0, c - 1), min(w, c + 2))
    patch = out[rs, cs].copy()
    writable = ~legend_mask[rs, cs]
    patch[writable] = int(color)
    out[rs, cs] = patch


def main(grid: np.ndarray) -> np.ndarray:
    """
    Turn black dents in two colored regions into mapped patches directed by an edge legend.

    Input structure:
    - Black background with two large foreground colors and a small isolated 2x2 legend on one grid edge.
    - The legend's outer edge cells show the two host-region colors; the adjacent inner cells show the patch color assigned to each host.
    - The large regions still contain black dents plus a few one-cell color specks or protrusions near boundaries.

    Rule:
    - Read the edge legend as a host-color → patch-color mapping, then keep that legend unchanged.
    - Locally clean the two large regions: isolated specks become black, and one-cell cross-color protrusions revert to the surrounding region color.
    - Each original black dent whose cleaned 3x3 neighborhood is mostly one foreground color becomes the center of a 3x3 patch colored by that host's legend mapping, with the center recolored teal (8).

    Key insight: The dent detection step is the same local-majority repair as before, but the patch color is no longer "the other region"; it must be decoded from the edge legend first.
    """
    g = np.asarray(grid, dtype=int)
    bg = Color.BLACK
    colors = _main_colors(g, bg)
    mapping, legend_mask = _palette_mapping(g, colors, bg)
    clean = _clean_foreground(g, colors, bg, legend_mask)

    out = clean.copy()
    centers = _dent_centers(g, clean, colors, bg, legend_mask)
    for r, c, host in centers:
        _paint_patch(out, legend_mask, r, c, mapping[int(host)])

    for r, c, _host in centers:
        out[r, c] = Color.TEAL

    return out


# --------------- generator (cx) ---------------

# --- CFG: canvas & region layout ---
GRID_SIZE_MIN, GRID_SIZE_MAX = 20, 30
RECT_SIZE_FRAC_MIN, RECT_SIZE_FRAC_MAX = 0.45, 0.75
RECT_MARGIN_MAX = 3
MIN_REGION_CELLS = 100
COVERAGE_MIN, COVERAGE_MAX = 0.55, 0.85

# --- CFG: dent placement ---
DENT_COUNT_MIN, DENT_COUNT_MAX = 12, 22
DENT_MIN_HOST_3x3 = 5
DENT_PATCH_SEPARATION = 3
DENT_PAIR_PROB = 0.13

# --- CFG: noise ---
NOISE_COUNT_MIN, NOISE_COUNT_MAX = 7, 22
BG_NOISE_FRAC_MIN, BG_NOISE_FRAC_MAX = 0.65, 0.85
BG_SPECK_MIN_BG_3x3 = 6
BOUNDARY_MIN_HOST_3x3 = 6

# --- CFG: legend ---
LEGEND_SIDES = ("top", "bottom", "left", "right")
LEGEND_USE_THIRD_PROB = 0.72

# --- CFG: generation control ---
MAX_GENERATION_ATTEMPTS = 300


def _build_regions(
    N: int,
    color_a: int,
    color_b: int,
    reserved_mask: np.ndarray,
    rng: random.Random,
) -> np.ndarray | None:
    """Paint 2-3 overlapping rectangles (simple occlusion, painter's algorithm)."""
    n_rects = rng.choice([2, 3])
    corners = ["TL", "TR", "BL", "BR"]
    rng.shuffle(corners)
    chosen_corners = corners[:n_rects]

    if n_rects == 2:
        rect_colors = [color_a, color_b]
        rng.shuffle(rect_colors)
    else:
        first = rng.choice([color_a, color_b])
        mid = color_b if first == color_a else color_a
        rect_colors = [first, mid, first]

    def _make_rect(corner: str) -> tuple[int, int, int, int]:
        h = rng.randint(int(N * RECT_SIZE_FRAC_MIN), int(N * RECT_SIZE_FRAC_MAX))
        w = rng.randint(int(N * RECT_SIZE_FRAC_MIN), int(N * RECT_SIZE_FRAC_MAX))
        m = rng.randint(0, RECT_MARGIN_MAX)
        r0 = m if corner[0] == "T" else max(0, N - h - m)
        c0 = m if corner[1] == "L" else max(0, N - w - m)
        return r0, c0, min(N, r0 + h), min(N, c0 + w)

    grid = np.zeros((N, N), dtype=int)
    for corner, color in zip(chosen_corners, rect_colors):
        r0, c0, r1, c1 = _make_rect(corner)
        grid[r0:r1, c0:c1] = color

    grid[reserved_mask] = 0

    cnt_a = int(np.sum(grid == color_a))
    cnt_b = int(np.sum(grid == color_b))
    if cnt_a < MIN_REGION_CELLS or cnt_b < MIN_REGION_CELLS:
        return None
    coverage = (cnt_a + cnt_b) / (N * N)
    if not (COVERAGE_MIN <= coverage <= COVERAGE_MAX):
        return None
    if n_rects == 3:
        from scipy.ndimage import label

        _, n_components = label(grid == rect_colors[0])
        if n_components < 2:
            return None
    return grid


def _is_safe_dent_center(grid: np.ndarray, r: int, c: int, host: int, other: int) -> bool:
    """After setting (r,c) to black, the solver must detect it as a dent in host region."""
    if grid[r, c] != host:
        return False
    sub = _sub3x3(grid, r, c)
    host_count = int(np.sum(sub == host)) - 1
    return host_count >= DENT_MIN_HOST_3x3 and host_count > int(np.sum(sub == other))


def _would_form_2x2(grid: np.ndarray, r: int, c: int, color: int) -> bool:
    """Check whether placing `color` at (r,c) would complete a 2x2 block of that color."""
    h, w = grid.shape
    for dr in (-1, 0):
        for dc in (-1, 0):
            rr, cc = r + dr, c + dc
            if 0 <= rr < h - 1 and 0 <= cc < w - 1:
                block = grid[rr : rr + 2, cc : cc + 2].copy()
                block[r - rr, c - cc] = color
                if int(np.sum(block == color)) == 4:
                    return True
    return False


def _pick_dent_centers(candidates, n, rng):
    """Select n dent centers from candidates with Chebyshev distance >= DENT_PATCH_SEPARATION."""
    rng.shuffle(candidates)
    chosen = []
    for r, c in candidates:
        if all(max(abs(r - rr), abs(c - cc)) >= DENT_PATCH_SEPARATION for rr, cc in chosen):
            chosen.append((r, c))
            if len(chosen) >= n:
                return chosen
    return None


def _expand_to_pairs(dents, host, other, clean, all_dents, reserved_mask, rng):
    """Optionally expand single-cell dents into 2-cell adjacent pairs (~13% chance each)."""
    h, w = clean.shape
    result = []
    for r, c in dents:
        cells = [(r, c)]
        if rng.random() < DENT_PAIR_PROB:
            neighbors = [(r + 1, c), (r - 1, c), (r, c + 1), (r, c - 1)]
            rng.shuffle(neighbors)
            for nr, nc in neighbors:
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                if reserved_mask[nr, nc] or not _patch_clear_of_reserved(reserved_mask, nr, nc):
                    continue
                if clean[nr, nc] != host or not _is_safe_dent_center(clean, nr, nc, host, other):
                    continue
                if all(
                    max(abs(nr - r2), abs(nc - c2)) >= DENT_PATCH_SEPARATION
                    for r2, c2 in all_dents
                    if (r2, c2) != (r, c)
                ):
                    cells.append((nr, nc))
                    break
        result.append(cells)
    return result


def _stamp_dents(
    region_clean: np.ndarray,
    legend_mask: np.ndarray,
    legend_block: np.ndarray,
    dent_groups_a,
    dent_groups_b,
    color_a: int,
    color_b: int,
    mapping: dict[int, int],
) -> np.ndarray:
    """Build output by stamping mapped 3x3 patches and marking teal at dent centers."""
    h, w = region_clean.shape
    output = region_clean.copy()
    output[legend_mask] = legend_block[legend_mask]
    for dent_groups, host in [(dent_groups_a, color_a), (dent_groups_b, color_b)]:
        stamp_color = int(mapping[int(host)])
        for cells in dent_groups:
            for r, c in cells:
                _paint_patch(output, legend_mask, r, c, stamp_color)
    for dent_groups in (dent_groups_a, dent_groups_b):
        for cells in dent_groups:
            for r, c in cells:
                output[r, c] = Color.TEAL
    return output


def _add_bg_noise(inp, clean, n_in_bg, color_a, color_b, reserved_mask, rng):
    """Place isolated fg-color specks in background area."""
    bg_candidates = list(zip(*np.where((clean == 0) & (~reserved_mask)), strict=False))
    rng.shuffle(bg_candidates)

    placed = 0
    for r_, c_ in bg_candidates:
        if placed >= n_in_bg:
            break
        r, c = int(r_), int(c_)
        sub = _sub3x3(inp, r, c)
        if int(np.sum(sub == 0)) < BG_SPECK_MIN_BG_3x3:
            continue
        nearby = _sub3x3(clean, r, c)
        nearby_fg = [int(x) for x in nearby.flat if int(x) != 0]
        speck_color = _Counter(nearby_fg).most_common(1)[0][0] if nearby_fg else rng.choice([color_a, color_b])
        inp[r, c] = speck_color
        placed += 1


def _neighbor_cleanup_safe(inp, r, c, host, other):
    """Check that changing (r,c) to `other` won't cause the solver to misclassify any neighbor."""
    h, w = inp.shape
    for dr in (-1, 0, 1):
        for dc in (-1, 0, 1):
            if dr == 0 and dc == 0:
                continue
            nr, nc = r + dr, c + dc
            if not (0 <= nr < h and 0 <= nc < w) or inp[nr, nc] != host:
                continue
            nsub = _sub3x3(inp, nr, nc).copy()
            nr0, nc0 = max(0, nr - 1), max(0, nc - 1)
            nsub[r - nr0, c - nc0] = other
            own_n = int(np.sum(nsub == host))
            other_n = int(np.sum(nsub == other))
            bg_n = int(np.sum(nsub == 0))
            if (other_n > own_n and other_n >= 5) or own_n <= 2 or (bg_n >= 5 and own_n <= 4):
                return False
    return True


def _add_boundary_noise(inp, clean, n_at_boundary, color_a, color_b, reserved_mask, rng):
    """Place cross-color contamination at region-region boundaries."""
    h, w = clean.shape
    boundary_candidates = []
    for r in range(h):
        for c in range(w):
            if reserved_mask[r, c]:
                continue
            v = int(clean[r, c])
            if v not in (color_a, color_b):
                continue
            other = color_b if v == color_a else color_a
            if int(np.sum(_sub3x3(clean, r, c) == other)) >= 1:
                boundary_candidates.append((r, c, v, other))
    rng.shuffle(boundary_candidates)

    placed = 0
    for r, c, host, other in boundary_candidates:
        if placed >= n_at_boundary:
            break
        if inp[r, c] != host:
            continue
        sub_now = _sub3x3(inp, r, c)
        host_count = int(np.sum(sub_now == host))
        other_count = int(np.sum(sub_now == other))
        if host_count < BOUNDARY_MIN_HOST_3x3 or host_count - 1 <= other_count + 1:
            continue
        if _would_form_2x2(inp, r, c, other):
            continue
        if not _neighbor_cleanup_safe(inp, r, c, host, other):
            continue
        inp[r, c] = other
        placed += 1


def _patch_clear_of_reserved(reserved_mask: np.ndarray, r: int, c: int) -> bool:
    return not bool(np.any(reserved_mask[max(0, r - 1) : r + 2, max(0, c - 1) : c + 2]))


def _dent_guard_mask(shape: tuple[int, int], dent_groups) -> np.ndarray:
    h, w = shape
    guard = np.zeros((h, w), dtype=bool)
    for cells in dent_groups:
        for r, c in cells:
            guard[max(0, r - 1) : min(h, r + 2), max(0, c - 1) : min(w, c + 2)] = True
    return guard


def _choose_mapping(color_a: int, color_b: int, rng: random.Random) -> tuple[dict[int, int], int]:
    third_pool = [c for c in Color.NOT_BLACK if c not in (Color.TEAL, color_a, color_b)]
    third = int(rng.choice(third_pool))
    fill_choices = [color_a, color_b, third]

    while True:
        if rng.random() < LEGEND_USE_THIRD_PROB:
            use_a_third = rng.random() < 0.5
            if use_a_third:
                fill_a = third
                fill_b = int(rng.choice([color_a, color_b, third]))
            else:
                fill_b = third
                fill_a = int(rng.choice([color_a, color_b, third]))
        else:
            fill_a = int(rng.choice(fill_choices))
            fill_b = int(rng.choice(fill_choices))

        if (fill_a, fill_b) == (color_a, color_b):
            continue
        if (fill_a, fill_b) == (color_b, color_a) and rng.random() < 0.7:
            continue
        return {int(color_a): fill_a, int(color_b): fill_b}, third


def _gen_attempt(rng: random.Random) -> np.ndarray | None:
    N = rng.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)
    fg_pool = [c for c in Color.NOT_BLACK if c != Color.TEAL]
    color_a, color_b = rng.sample(fg_pool, 2)

    side = rng.choice(LEGEND_SIDES)
    start = rng.randint(0, N - 2)
    legend_mask, reserved_mask = _legend_masks((N, N), side, start)
    mapping, _third = _choose_mapping(color_a, color_b, rng)

    key_order = [color_a, color_b]
    rng.shuffle(key_order)
    fill_order = [mapping[key_order[0]], mapping[key_order[1]]]
    legend_block = np.zeros((N, N), dtype=int)
    _paint_legend(
        legend_block,
        side,
        start,
        _legend_array(side, (key_order[0], key_order[1]), (fill_order[0], fill_order[1])),
    )

    clean = _build_regions(N, color_a, color_b, reserved_mask, rng)
    if clean is None:
        return None

    n_total = rng.randint(DENT_COUNT_MIN, DENT_COUNT_MAX)
    n_a, n_b = n_total // 2, n_total - n_total // 2
    if rng.random() < 0.5:
        n_a, n_b = n_b, n_a

    h, w = clean.shape
    valid = {color_a: [], color_b: []}
    for r in range(h):
        for c in range(w):
            if reserved_mask[r, c] or not _patch_clear_of_reserved(reserved_mask, r, c):
                continue
            v = int(clean[r, c])
            if v == color_a and _is_safe_dent_center(clean, r, c, color_a, color_b):
                valid[color_a].append((r, c))
            elif v == color_b and _is_safe_dent_center(clean, r, c, color_b, color_a):
                valid[color_b].append((r, c))

    if len(valid[color_a]) < n_a + 2 or len(valid[color_b]) < n_b + 2:
        return None

    dents_a = _pick_dent_centers(valid[color_a], n_a, rng)
    dents_b = _pick_dent_centers(valid[color_b], n_b, rng)
    if dents_a is None or dents_b is None:
        return None

    groups_a = _expand_to_pairs(dents_a, color_a, color_b, clean, dents_a, reserved_mask, rng)
    groups_b = _expand_to_pairs(dents_b, color_b, color_a, clean, dents_b, reserved_mask, rng)
    noise_blocked = reserved_mask | _dent_guard_mask(clean.shape, groups_a + groups_b)

    output = _stamp_dents(
        clean,
        legend_mask,
        legend_block,
        groups_a,
        groups_b,
        color_a,
        color_b,
        mapping,
    )

    inp = clean.copy()
    inp[legend_mask] = legend_block[legend_mask]
    for cells in groups_a + groups_b:
        for r, c in cells:
            inp[r, c] = 0

    n_noise = rng.randint(NOISE_COUNT_MIN, NOISE_COUNT_MAX)
    n_in_bg = int(round(n_noise * rng.uniform(BG_NOISE_FRAC_MIN, BG_NOISE_FRAC_MAX)))
    _add_bg_noise(inp, clean, n_in_bg, color_a, color_b, noise_blocked, rng)
    _add_boundary_noise(inp, clean, n_noise - n_in_bg, color_a, color_b, noise_blocked, rng)

    try:
        produced = main(inp)
    except Exception:
        return None
    if not np.array_equal(produced, output):
        return None
    return inp


def generate_input() -> np.ndarray:
    rng = random.Random()
    for _ in range(MAX_GENERATION_ATTEMPTS):
        try:
            grid = _gen_attempt(rng)
        except Exception:
            grid = None
        if grid is not None:
            return grid
    raise RuntimeError("generate_input: failed after %d attempts" % MAX_GENERATION_ATTEMPTS)

            ```

    ## 你的任务

    1. **理解原代码**: 弄清 `main()` 和 `generate_input()` 的逻辑。

    2. **阅读参考代码**（如有）: 上面列出的已有单变体代码是各组成项单独实现的版本，帮助你理解每项变更的实现方式。融合版本应综合参考但不能简单拼接。

    3. **设计分析（写代码前必须完成）**:

       综合「融合描述」和「各组成项详情」，将融合规则落实到代码层面。融合描述给出了整体的 input→output 规则，各组成项详情给出了每项改动的具体含义——两者结合才是完整的实现规格。如果上面提供了原始任务规格（Spec），请将其作为设计分析的重要参考——spec 详细描述了原始任务中各对象的结构、空间关系、生成策略等，理解这些细节有助于你准确判断融合改动的影响范围和实现方式。

       a) **具体化与行为追踪**: 融合后的变体在 ARC 的像素网格中具体长什么样？用一个具体小例子追踪：原始逻辑在每个被改动的环节是怎么执行的 → 融合后应该怎么执行的 → 二者的差异是什么。

       b) **复杂度校准**: 检查你的设计是否过于简化。过于简化会导致两个问题：一是容易产生冲突或重复（例如不同对象变得难以区分，匹配出现歧义），二是变体的视觉效果不明显，肉眼看不出和原任务的区别。同时不要让关键自由度过多；如果规则依赖少数档位、类别或对应关系，应控制在少量取值，并让它们在每个样例中有重复支撑。

       c) **隐式假设审查**: 各组成项的改动可能破坏原代码中的哪些隐式假设？多项改动叠加后是否引入新的冲突？逐行检查 main() 中与变体相关的代码段：每行代码依赖了什么前提？这个前提在融合后是否仍然成立？

       d) **放置合法性**: 生成器在放置对象时，必须保证各个体之间不重叠、不越界，且放置结果符合题意。

       e) **视觉可观察性**: ARC 要求人类从 2-4 个 input→output 样例中肉眼推断规则。禁止使用任何人类不可视因素参与排序等操作（例如黑色=0，禁用）。做一次思想实验：假设你是解题者，看到几组变体生成的 input→output，能否看出融合后的规则？注意不要使用颜色值等人类不可视因素。如果变体的变化规律在2-3组像素网格上无法推出（例如对大量纯色对称对象做不同变换、无法从少量例子归纳颜色对应关系、不同情况的变换涉及正逆向旋转镜像等多种不同变化等，即全部的变化逻辑或者说是变化规律无法在3个输入输出示例对中体现），就需要调整设计使差异可观察。

       f) **可视化整洁度**: 即使逻辑合理，如果可视化后的输出网格看上去乱七八糟也不行。检查：同一网格区域是否存在多种元素覆盖叠加导致无法分辨哪个是哪个？不同对象、区域、标记之间在视觉上是否能清晰区分？如果融合后的网格在视觉上杂乱不堪，需要调整设计（如减少同一区域的叠加层次、增大对象间距、简化标记方式等）。

       g) **变化的可推断性**: 如果融合涉及颜色映射或颜色变化，务必确保颜色种类不宜过多，且颜色变化必须有足够的结构性线索（如位置、形状、分区等伴随特征）让人类能从少量样例中推断出颜色变化规则。避免出现大量颜色变化却无任何提示的情况——如果解题者无法从样例归纳出"什么条件导致什么颜色"，这个融合设计就

       将以上分析写在代码注释中或输出中，然后再开始写代码。

