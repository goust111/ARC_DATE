+def _surrounding_ring_is_bg(g: np.ndarray, legend_mask: np.ndarray, bg: int) -> bool:
+    rows, cols = np.where(legend_mask)
+    r0, r1 = int(rows.min()), int(rows.max()) + 1
+    c0, c1 = int(cols.min()), int(cols.max()) + 1
