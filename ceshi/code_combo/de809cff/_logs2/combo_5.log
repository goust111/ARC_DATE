+    if w >= 3:
+        for c0 in range(w - 2):
+            _try_candidate("top", c0)
+            _try_candidate("bottom", c0)
+    if h >= 3:
+        for r0 in range(h - 2):
+            _try_candidate("left", r0)
+            _try_candidate("right", r0)
