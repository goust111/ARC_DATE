+            return
+        if any(inner[i] == outer[i] for i in range(3)):
+            return
+        if not np.all(block != int(bg)):
+            return
+        if not _surrounding_ring_is_bg(g, legend_mask, bg):
+            return
+        candidates.append(({outer[i]: inner[i] for i in range(3)}, legend_mask))
