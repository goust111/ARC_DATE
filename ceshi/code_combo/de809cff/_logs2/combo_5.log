+    if side == "bottom":
+        return np.array([fills, keys], dtype=int)
+    if side == "left":
+        return np.array([[keys[0], fills[0]], [keys[1], fills[1]], [keys[2], fills[2]]], dtype=int)
+    return np.array([[fills[0], keys[0]], [fills[1], keys[1]], [fills[2], keys[2]]], dtype=int)
