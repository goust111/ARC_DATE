+    for r_, c_ in bg_candidates:
+        if placed >= n_noise:
+            break
+        r, c = int(r_), int(c_)
+        if any(
+            not (0 <= nr < h and 0 <= nc < w) or int(clean[nr, nc]) != 0
+            for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+        ):
