+    try:
+        clean_after = _clean_regions(inp, colors, Color.BLACK)
+        events = _dent_events(inp, clean_after, colors, Color.BLACK)
+        produced = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(produced, output):
+        return None
+
+    boundary_events = 0
+    bg_events = 0
+    for r, c, host, _stamp in events:
+        if host == Color.BLACK:
+            bg_events += 1
+        elif host == int(color_a):
