+    n_a, n_b = n_fg // 2, n_fg - n_fg // 2
+    if rng.random() < 0.5:
+        n_a, n_b = n_b, n_a
+
+    h, w = clean.shape
+    valid_fg: dict[int, list[tuple[int, int]]] = {int(color_a): [], int(color_b): []}
+    strong_fg: dict[int, list[tuple[int, int]]] = {int(color_a): [], int(color_b): []}
+    bg_options: dict[tuple[int, int], list[int]] = {}
+    for r in range(h):
+        for c in range(w):
+            v = int(clean[r, c])
+            if v == int(color_a):
