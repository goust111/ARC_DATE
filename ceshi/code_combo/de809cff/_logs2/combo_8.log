+    dent_cells = _flatten_groups(groups_a) + _flatten_groups(groups_b) + dents_bg
+    n_noise = rng.randint(NOISE_COUNT_MIN, NOISE_COUNT_MAX)
+    _add_boundary_noise(inp, clean, n_noise, int(color_a), int(color_b), dent_cells, rng)
