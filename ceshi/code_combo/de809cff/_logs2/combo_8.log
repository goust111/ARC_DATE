+        )
+        if chosen is None:
+            return None
+        chosen_fg[int(spec["color"])] = chosen
+        blocked_fg += chosen
+
+    dents_a = chosen_fg[int(color_a)]
+    dents_b = chosen_fg[int(color_b)]
+    dents_bg = _pick_dent_centers(list(bg_options), n_bg, rng, blocked=dents_a + dents_b)
