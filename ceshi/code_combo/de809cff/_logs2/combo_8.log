+
+    if boundary_events < len(_flatten_groups(groups_a)) + len(_flatten_groups(groups_b)):
+        return None
+    if bg_events < n_bg:
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        try:
+            grid = _gen_attempt(rng)
+        except Exception:
