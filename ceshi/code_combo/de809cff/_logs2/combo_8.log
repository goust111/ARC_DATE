    dents_b = mod._pick_dent_centers(valid_fg[int(color_b)], n_b, rng, blocked=dents_a, preferred_groups=[(strong_fg[int(color_b)], min(mod.MIN_STRONG_BOUNDARY_DENTS_PER_COLOR, n_b))])
    if dents_b is None:
        return 'pick_b'
    dents_bg = mod._pick_dent_centers(list(bg_options), n_bg, rng, blocked=dents_a + dents_b)
    if dents_bg is None:
        return 'pick_bg'
    base_centers = dents_a + dents_b + dents_bg
    groups_a = mod._expand_to_boundary_pairs(dents_a, int(color_a), int(color_b), clean, base_centers, rng)
    extra_a = [cell for cells in groups_a for cell in cells[1:]]
    groups_b = mod._expand_to_boundary_pairs(dents_b, int(color_b), int(color_a), clean, base_centers + extra_a, rng)
    output = mod._stamp_dents(clean, groups_a, groups_b, dents_bg, int(color_a), int(color_b))
    inp = clean.copy()
    for cells in groups_a + groups_b:
        for r, c in cells:
            inp[r, c] = mod.Color.BLACK
    for r, c in dents_bg:
        inp[r, c] = mod._choose_bg_dent_color(clean, r, c, colors, rng)
    dent_cells = mod._flatten_groups(groups_a) + mod._flatten_groups(groups_b) + dents_bg
    n_noise = rng.randint(mod.NOISE_COUNT_MIN, mod.NOISE_COUNT_MAX)
    mod._add_boundary_noise(inp, clean, n_noise, int(color_a), int(color_b), dent_cells, rng)
    clean_after = mod._clean_regions(inp, colors, mod.Color.BLACK)
    events = mod._dent_events(inp, clean_after, colors, mod.Color.BLACK)
    produced = mod.main(inp)
    if not np.array_equal(produced, output):
        return 'oracle'
    boundary_events = sum(1 for _r,_c,host,_ in events if host in (int(color_a), int(color_b)))
    bg_events = sum(1 for _r,_c,host,_ in events if host == mod.Color.BLACK)
    if boundary_events < len(mod._flatten_groups(groups_a)) + len(mod._flatten_groups(groups_b)):
        return 'boundary_events'
    if bg_events < n_bg:
        return 'bg_events'
    return 'ok'

rng=random.Random(0)
counts=collections.Counter(stage_attempt(rng) for _ in range(500))
for k,v in counts.most_common(20):
    print(v,k)
