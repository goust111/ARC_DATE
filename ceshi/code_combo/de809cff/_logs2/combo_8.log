+        return None
+    if len(strong_fg[int(color_a)]) < min(MIN_STRONG_BOUNDARY_DENTS_PER_COLOR, n_a):
+        return None
+    if len(strong_fg[int(color_b)]) < min(MIN_STRONG_BOUNDARY_DENTS_PER_COLOR, n_b):
+        return None
+    if len(bg_options) < n_bg:
+        return None
+
+    dents_a = _pick_dent_centers(
+        valid_fg[int(color_a)],
+        n_a,
+        rng,
+        preferred_groups=[(strong_fg[int(color_a)], min(MIN_STRONG_BOUNDARY_DENTS_PER_COLOR, n_a))],
+    )
+    if dents_a is None:
+        return None
+    dents_b = _pick_dent_centers(
+        valid_fg[int(color_b)],
+        n_b,
+        rng,
+        blocked=dents_a,
+        preferred_groups=[(strong_fg[int(color_b)], min(MIN_STRONG_BOUNDARY_DENTS_PER_COLOR, n_b))],
+    )
+    if dents_b is None:
+        return None
+    dents_bg = _pick_dent_centers(list(bg_options), n_bg, rng, blocked=dents_a + dents_b)
+    if dents_bg is None:
