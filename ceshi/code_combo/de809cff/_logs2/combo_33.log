+    if (r0, r1, c0, c1) == (clean_r0, clean_r1, clean_c0, clean_c1):
+        return None
+    if np.any(produced == int(Color.BLACK)):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(MAX_GENERATION_ATTEMPTS):
