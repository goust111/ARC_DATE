+                    cells.append((nr, nc))
+                    break
+        result.append(cells)
+    return result
+
+
+def _stamp_dents(
+    clean: np.ndarray,
+    dent_groups_a: list[list[tuple[int, int]]],
+    dent_groups_b: list[list[tuple[int, int]]],
+    color_a: int,
+    color_b: int,
