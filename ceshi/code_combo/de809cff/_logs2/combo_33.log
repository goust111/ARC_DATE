+
+def _finalize_variant_output(full_output: np.ndarray) -> np.ndarray:
+    out = full_output.copy()
+    out[out == int(Color.BLACK)] = int(OUTPUT_BG)
+    return _crop_to_foreground_bbox(out, OUTPUT_BG)
