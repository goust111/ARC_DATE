   139	    grid: np.ndarray, component: list[tuple[int, int]], color: int, colors: tuple[int, int], bg: int
   140	) -> int:
   141	    counts: _Counter[int] = _Counter()
   142	    comp_set = set(component)
   143	    h, w = grid.shape
   144	    valid_colors = {int(bg), int(colors[0]), int(colors[1])}
   145	    for r, c in component:
   146	        for dr in (-1, 0, 1):
   147	            for dc in (-1, 0, 1):
   148	                if dr == 0 and dc == 0:
