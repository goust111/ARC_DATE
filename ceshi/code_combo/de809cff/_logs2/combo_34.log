+    occupied = mixed_a + mixed_b + strict_a + strict_b
+    strict_groups_a = _expand_strict_pairs(strict_a, color_a, clean, occupied, rng)
+    strict_groups_b = _expand_strict_pairs(strict_b, color_b, clean, occupied, rng)
