   116	def _components_of_color(grid: np.ndarray, color: int) -> list[list[tuple[int, int]]]:
   117	    h, w = grid.shape
   118	    seen = np.zeros((h, w), dtype=bool)
   119	    comps: list[list[tuple[int, int]]] = []
   120	    for r in range(h):
   121	        for c in range(w):
   122	            if seen[r, c] or int(grid[r, c]) != int(color):
   123	                continue
   124	            stack = [(r, c)]
   125	            seen[r, c] = True
   126	            comp: list[tuple[int, int]] = []
   127	            while stack:
   128	                rr, cc = stack.pop()
   129	                comp.append((rr, cc))
   130	                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
   131	                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == int(color):
   132	                        seen[nr, nc] = True
   133	                        stack.append((nr, nc))
   134	            comps.append(comp)
