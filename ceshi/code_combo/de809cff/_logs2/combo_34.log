   259	def _build_regions(N: int, color_a: int, color_b: int, rng: random.Random) -> np.ndarray | None:
   260	    """Paint 2-3 overlapping rectangles to produce two large dominant regions."""
   261	    n_rects = rng.choice([2, 3])
   262	    corners = ["TL", "TR", "BL", "BR"]
   263	    rng.shuffle(corners)
