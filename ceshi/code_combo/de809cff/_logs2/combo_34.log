   109	def _main_colors(g: np.ndarray, bg: int) -> tuple[int, int]:
   110	    colors = [int(c) for c in np.unique(g) if int(c) != int(bg)]
   111	    colors.sort(key=lambda c: int(np.sum(g == c)), reverse=True)
   112	    assert len(colors) >= 2, "expected two foreground colors"
