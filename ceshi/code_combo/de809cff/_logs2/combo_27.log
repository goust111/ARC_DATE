def _full_square_radius(clean: np.ndarray, r: int, c: int, host: int) -> int:
    return _square_support_radius(clean, int(r), int(c), int(host))


def _extract_radius_buckets(
    clean: np.ndarray, color_a: int, color_b: int
) -> dict[int, dict[int, list[tuple[int, int]]]]:
    buckets: dict[int, dict[int, list[tuple[int, int]]]] = {
        int(color_a): {radius: [] for radius in TARGET_RADII},
        int(color_b): {radius: [] for radius in TARGET_RADII},
    }
    h, w = clean.shape
    for r in range(h):
        for c in range(w):
            v = int(clean[r, c])
            if v not in buckets:
                continue
            radius = _full_square_radius(clean, int(r), int(c), v)
            if radius in TARGET_RADII:
                buckets[v][int(radius)].append((int(r), int(c)))
    return buckets


def _far_enough(
    selected: list[tuple[int, int, int, int]],
    r: int,
    c: int,
    radius: int,
    gap: int = EXTRA_SPACING_GAP,
) -> bool:
    for rr, cc, _host, old_radius in selected:
        if max(abs(int(r) - int(rr)), abs(int(c) - int(cc))) <= int(radius) + int(old_radius) + int(gap):
            return False
    return True


def _pick_from_bucket(
    bucket: list[tuple[int, int]],
    radius: int,
    host: int,
    selected: list[tuple[int, int, int, int]],
    used: set[tuple[int, int]],
    rng: random.Random,
) -> tuple[int, int, int, int] | None:
    choices = bucket[:]
    rng.shuffle(choices)
    for r, c in choices:
        if (int(r), int(c)) in used:
            continue
        if _far_enough(selected, int(r), int(c), int(radius)):
            used.add((int(r), int(c)))
            return int(r), int(c), int(host), int(radius)
    return None


def _select_scaling_singles(
    buckets: dict[int, dict[int, list[tuple[int, int]]]],
    color_a: int,
    color_b: int,
    rng: random.Random,
) -> list[tuple[int, int, int, int]] | None:
    selected: list[tuple[int, int, int, int]] = []
    used: set[tuple[int, int]] = set()

    required = [
        (int(color_a), 1),
        (int(color_a), 2),
        (int(color_b), 1),
        (int(color_b), 2),
    ]
    for host, radius in required:
        spec = _pick_from_bucket(buckets[host][radius], radius, host, selected, used, rng)
        if spec is None:
            return None
        selected.append(spec)

    radius3_pool = [
        (int(host), int(r), int(c))
        for host in (int(color_a), int(color_b))
        for r, c in buckets[host][3]
        if (int(r), int(c)) not in used
    ]
    rng.shuffle(radius3_pool)
    radius3_added = 0
    for host, r, c in radius3_pool:
        if radius3_added >= REQUIRED_RADIUS3_COUNT:
            break
        if not _far_enough(selected, int(r), int(c), 3):
            continue
        used.add((int(r), int(c)))
        selected.append((int(r), int(c), int(host), 3))
        radius3_added += 1
    if radius3_added < REQUIRED_RADIUS3_COUNT:
        return None

    target_total = rng.randint(SINGLE_COUNT_MIN, SINGLE_COUNT_MAX)
    extras = [
        (int(radius), int(host), int(r), int(c))
        for host in (int(color_a), int(color_b))
        for radius in TARGET_RADII
        for r, c in buckets[host][radius]
        if (int(r), int(c)) not in used
    ]
    rng.shuffle(extras)
    for radius, host, r, c in extras:
        if len(selected) >= target_total:
            break
        if not _far_enough(selected, int(r), int(c), int(radius)):
            continue
        used.add((int(r), int(c)))
        selected.append((int(r), int(c), int(host), int(radius)))

    return selected


def _is_boundary_cell(clean: np.ndarray, r: int, c: int, host: int) -> bool:
    h, w = clean.shape
    for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
        if not (0 <= nr < h and 0 <= nc < w):
            return True
        if int(clean[nr, nc]) != int(host):
            return True
    return False


def _pair_only5_score(
    clean: np.ndarray,
    colors: tuple[int, int],
    cell_a: tuple[int, int],
    cell_b: tuple[int, int],
) -> int:
    tmp = clean.copy()
    tmp[int(cell_a[0]), int(cell_a[1])] = int(Color.BLACK)
    tmp[int(cell_b[0]), int(cell_b[1])] = int(Color.BLACK)
    dent5 = {(int(r), int(c)) for r, c, _host, _radius in _dent_specs_from_window(tmp, tmp, colors, Color.BLACK, 5)}
    dent3 = {(int(r), int(c)) for r, c, _host, _radius in _dent_specs_from_window(tmp, tmp, colors, Color.BLACK, 3)}
    cells = {tuple(map(int, cell_a)), tuple(map(int, cell_b))}
    if not cells.issubset(dent5):
        return -1
    return int(len(cells - dent3))


def _collect_pair_candidates(
    clean: np.ndarray, colors: tuple[int, int]
) -> list[tuple[int, tuple[int, int], tuple[int, int]]]:
    candidates: list[tuple[int, tuple[int, int], tuple[int, int]]] = []
    h, w = clean.shape
    for r in range(h):
        for c in range(w):
            host = int(clean[r, c])
            if host not in colors:
                continue
            if _full_square_radius(clean, r, c, host) != 1:
                continue
            if not _is_boundary_cell(clean, r, c, host):
                continue
            for nr, nc in ((r + 1, c), (r, c + 1)):
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                if int(clean[nr, nc]) != int(host):
                    continue
                if _full_square_radius(clean, nr, nc, host) != 1:
                    continue
                score = _pair_only5_score(clean, colors, (r, c), (nr, nc))
                if score >= 1:
                    candidates.append((int(score), (int(r), int(c)), (int(nr), int(nc))))
    candidates.sort(key=lambda item: item[0], reverse=True)
    return candidates


def _select_special_pairs(
    clean: np.ndarray,
    colors: tuple[int, int],
    selected: list[tuple[int, int, int, int]],
    used: set[tuple[int, int]],
    rng: random.Random,
) -> list[tuple[int, int, int, int]]:
    candidates = _collect_pair_candidates(clean, colors)
    if not candidates:
        return []

    grouped = candidates[:]
    rng.shuffle(grouped)
    grouped.sort(key=lambda item: item[0], reverse=True)

    chosen: list[tuple[int, int, int, int]] = []
    target_pairs = rng.randint(PAIR_GROUP_MIN, PAIR_GROUP_MAX)
    for _score, cell_a, cell_b in grouped:
        if len(chosen) >= target_pairs * 2:
            break
        if cell_a in used or cell_b in used:
            continue
        host = int(clean[cell_a[0], cell_a[1]])
        if not all(_far_enough(selected + chosen, int(r), int(c), 1) for r, c in (cell_a, cell_b)):
            continue
        used.add(cell_a)
        used.add(cell_b)

