+
+def _add_boundary_noise(
+    inp: np.ndarray,
+    clean: np.ndarray,
+    protected: np.ndarray,
+    n_at_boundary: int,
+    color_a: int,
+    color_b: int,
+    rng: random.Random,
+) -> None:
+    h, w = clean.shape
+    boundary_candidates = []
+    for r in range(h):
+        for c in range(w):
+            if protected[r, c]:
+                continue
+            v = int(clean[r, c])
