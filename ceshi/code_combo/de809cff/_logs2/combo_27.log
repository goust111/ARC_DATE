+        if not all(_far_enough(selected + chosen, int(r), int(c), 1) for r, c in (cell_a, cell_b)):
+            continue
+        used.add(cell_a)
+        used.add(cell_b)
+        chosen.append((int(cell_a[0]), int(cell_a[1]), int(host), 1))
+        chosen.append((int(cell_b[0]), int(cell_b[1]), int(host), 1))
