+
+def _is_boundary_cell(clean: np.ndarray, r: int, c: int, host: int) -> bool:
+    h, w = clean.shape
+    for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+        if not (0 <= nr < h and 0 <= nc < w):
+            return True
+        if int(clean[nr, nc]) != int(host):
