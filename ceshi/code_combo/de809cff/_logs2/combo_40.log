+    return result
+
+
+def _safe_protrusion_candidate(clean: np.ndarray, r: int, c: int, source: int, host: int) -> bool:
+    if int(clean[r, c]) != int(host):
+        return False
+    if _would_form_2x2(clean, r, c, source):
