+
+
+def _add_boundary_noise(
+    inp: np.ndarray,
+    clean: np.ndarray,
+    major: int,
+    minor: int,
+    dent_cells: set[tuple[int, int]],
+    output: np.ndarray,
+    rng: random.Random,
