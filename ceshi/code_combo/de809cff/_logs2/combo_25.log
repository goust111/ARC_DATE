+
+
+def _boundary_noise_candidates(clean: np.ndarray, host: int, other: int, dent_cells: set[tuple[int, int]]) -> list[tuple[int, int]]:
+    h, w = clean.shape
+    out: list[tuple[int, int]] = []
+    for r in range(h):
+        for c in range(w):
+            if int(clean[r, c]) != int(host):
