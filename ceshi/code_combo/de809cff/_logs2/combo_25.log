    fg_pool = [c for c in mod.Color.NOT_BLACK if c "'!= mod.Color.TEAL]
    major, minor = rng.sample(fg_pool, 2)
    clean = mod._build_regions(n, major, minor, rng)
    if clean is None:
        reasons['"'build_regions'] = reasons.get('build_regions', 0) + 1
        continue
    dents = mod._sample_dents(clean, major, minor, rng)
    if dents is None:
        reasons['sample_dents'] = reasons.get('sample_dents', 0) + 1
        continue
    output = mod._stamp_output(clean, dents, (major, minor))
    inp = clean.copy()
    dent_cells = {(r,c) for r,c,_ in dents}
    for r,c in dent_cells:
        inp[r,c] = mod.Color.BLACK
    if not np.array_equal(mod.main(inp), output):
        reasons['pre_noise_oracle'] = reasons.get('pre_noise_oracle', 0) + 1
        continue
    mod._add_bg_noise(inp, clean, (major, minor), dent_cells, output, rng)
    mod._add_boundary_noise(inp, clean, major, minor, dent_cells, output, rng)
    if not np.array_equal(mod.main(inp), output):
        reasons['post_noise_oracle'] = reasons.get('post_noise_oracle', 0) + 1
        continue
    reasons['ok'] = reasons.get('ok', 0) + 1
print(reasons, 'time', time.time()-t0)
