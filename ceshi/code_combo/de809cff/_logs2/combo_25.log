+TOTAL_COVERAGE_MIN, TOTAL_COVERAGE_MAX = 0.88, 0.94
+MAJOR_VISIBLE_MIN = 0.78
+MINOR_VISIBLE_MIN, MINOR_VISIBLE_MAX = 0.07, 0.14
+INNER_GAP_MIN, INNER_GAP_MAX = 2, 4
+
+# Dent placement
+MAJOR_DENTS_RANGE = (9, 15)
+MINOR_DENTS_RANGE = (2, 4)
