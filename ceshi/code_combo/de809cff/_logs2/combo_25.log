+def _classify_candidate(clean: np.ndarray, r: int, c: int, host: int, other: int, bg: int) -> str:
+    seen_other = False
+    seen_bg = False
+    h, w = clean.shape
+    for dr in range(-2, 3):
+        for dc in range(-2, 3):
+            if dr == 0 and dc == 0:
+                continue
+            rr = r + dr
+            cc = c + dc
+            if not _in_bounds((h, w), rr, cc):
