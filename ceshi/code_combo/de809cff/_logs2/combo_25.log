+def _add_boundary_noise(inp: np.ndarray, clean: np.ndarray, major: int, minor: int, dent_cells: set[tuple[int, int]], rng: random.Random) -> None:
+    target = rng.randint(*BOUNDARY_NOISE_RANGE)
