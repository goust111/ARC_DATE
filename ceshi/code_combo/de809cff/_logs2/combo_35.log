+
+    active_centers = None
+    inactive_centers = None
+    bg_centers = None
+    for _ in range(CENTER_PICK_ATTEMPTS):
+        active_centers = _pick_dent_centers(valid_fg[active_color], n_active, rng)
+        if active_centers is None:
