GRID_SIZE_MIN, GRID_SIZE_MAX = 20, 30
RECT_SIZE_FRAC_MIN, RECT_SIZE_FRAC_MAX = 0.55, 0.82
RECT_MARGIN_MAX = 3
MIN_REGION_CELLS = 110
COVERAGE_MIN, COVERAGE_MAX = 0.58, 0.84
OVERLAP_FRAC_MIN, OVERLAP_FRAC_MAX = 0.08, 0.30

