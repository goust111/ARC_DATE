+
+def _stamp_patch(out: np.ndarray, center: tuple[int, int], color: int) -> None:
+    h, w = out.shape
+    r, c = center
+    out[max(0, r - 1) : min(h, r + 2), max(0, c - 1) : min(w, c + 2)] = int(color)
