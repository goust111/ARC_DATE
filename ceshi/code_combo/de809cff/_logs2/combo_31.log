+
+def _ring_coords(cells: tuple[tuple[int, int], ...], shape: tuple[int, int]) -> set[tuple[int, int]]:
+    h, w = shape
+    cell_set = set(cells)
+    ring: set[tuple[int, int]] = set()
+    for r, c in cells:
+        for rr in range(r - 1, r + 2):
+            for cc in range(c - 1, c + 2):
+                if 0 <= rr < h and 0 <= cc < w and (rr, cc) not in cell_set:
+                    ring.add((rr, cc))
+    return ring
