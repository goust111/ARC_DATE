+    host_id = max(host_counts, key=host_counts.get)
+    host_count = host_counts[host_id]
+    other_count = sum(v for rid, v in host_counts.items() if rid != host_id)
+    if bg_count > 0:
+        return None
+    if host_count < len(cells) + 4:
