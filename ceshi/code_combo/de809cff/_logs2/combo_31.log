+                if _has_same_2x2(cur, r, c, v):
+                    nxt[r, c] = v
+                elif other_count > own and other_count >= 5:
+                    nxt[r, c] = other
+                elif bg_count >= 6 and own <= 3:
+                    nxt[r, c] = bg
+                elif own <= 1:
+                    nxt[r, c] = bg
