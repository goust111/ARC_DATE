+    candidates: dict[tuple[tuple[int, int], ...], tuple[int, int]] = {}
+    h, w = original.shape
+    for k in range(1, int(n) + 1):
+        rows, cols = np.where(labels == k)
+        cells = tuple(sorted((int(r), int(c)) for r, c in zip(rows, cols, strict=False)))
