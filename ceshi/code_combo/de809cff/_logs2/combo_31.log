+    color_a: int,
+    color_b: int,
+    rng: random.Random,
+) -> None:
+    h, w = clean.shape
+    colors = (int(color_a), int(color_b))
+    boundary_candidates = []
+    for r in range(h):
+        for c in range(w):
+            v = int(clean[r, c])
+            if v not in (color_a, color_b):
