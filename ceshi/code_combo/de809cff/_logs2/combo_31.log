+                if not _within_patch_margin(anchors[0], region_bbox):
+                    continue
+                if not _within_patch_margin(anchors[1], region_bbox):
+                    continue
+                candidates.append((cells_a, cells_b, anchors))
+    return candidates
+
+
+def _select_pairs_for_region(
+    clean: np.ndarray,
+    region_id: int,
+    region_ids: np.ndarray,
