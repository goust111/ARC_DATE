+DENT_PAIRS_PER_REGION_MIN = 2
+DENT_PAIRS_PER_REGION_MAX = 4
+DENT_COMPONENT_MIN_SIZE = 2
+DENT_COMPONENT_MAX_SIZE = 4
+DENT_CELL_SEPARATION = 3
