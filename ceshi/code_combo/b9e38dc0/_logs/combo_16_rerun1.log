+    }
+
+
+def _trace_ray(
+    start: tuple[int, int],
+    d: tuple[int, int],
+    rad: tuple[int, int],
+    is_12: bool,
+    shape: tuple[int, int],
+) -> list[tuple[int, int]]:
+    h, w = shape
+    rr, cc = start
+    step = 0
+    path: list[tuple[int, int]] = []
+    while True:
+        step += 1
+        if not is_12 or step % 2 == 1:
+            nr = rr + d[0]
+            nc = cc + d[1]
+        else:
+            if rad[0] != 0:
+                nr = rr + d[0]
+                nc = cc
+            else:
+                nr = rr
+                nc = cc + d[1]
+        if not (0 <= nr < h and 0 <= nc < w):
+            return path
+        path.append((nr, nc))
+        rr, cc = nr, nc
+
+
+def _trace_mover(
+    start: tuple[int, int],
+    rad: tuple[int, int],
+    shape: tuple[int, int],
+    stop_mask: np.ndarray | None,
+) -> dict:
+    h, w = shape
+    rr, cc = start
+    path: list[tuple[int, int]] = []
+    while True:
+        nr = rr + rad[0]
+        nc = cc + rad[1]
+        if not (0 <= nr < h and 0 <= nc < w):
+            return {"end": (rr, cc), "path": path, "hit": None}
+        if stop_mask is not None and stop_mask[nr, nc]:
+            return {"end": (rr, cc), "path": path, "hit": (nr, nc)}
+        rr, cc = nr, nc
+        path.append((rr, cc))
+
+
+def _parse_scene(grid: np.ndarray) -> dict:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    bg = int(get_bg(g))
+
+    vals = [int(v) for v in np.unique(g) if int(v) != bg]
+    assert vals, "expected non-background colors"
+
+    wall = max(vals, key=lambda c: int((g == c).sum()))
+    wall_mask = g == wall
+    comps = _component_sets(wall_mask)
+    assert comps, "expected a wall component"
+
+    other_colors = [c for c in vals if c != wall]
+    assert other_colors, "expected a seed color"
+
+    wall_points = [p for comp in comps for p in comp]
+
+    def _min_dist_to_wall(color: int) -> tuple[int, int]:
+        pts = [(int(r), int(c)) for r, c in zip(*np.where(g == color))]
+        best = 10**9
+        for r, c in pts:
+            for wr, wc in wall_points:
+                dist = abs(r - wr) + abs(c - wc)
+                if dist < best:
+                    best = dist
+                    if best == 0:
+                        return 0, len(pts)
+        return best, len(pts)
+
+    fill = min(other_colors, key=lambda c: (_min_dist_to_wall(c)[0], _min_dist_to_wall(c)[1]))
+    fill_pos = [(int(r), int(c)) for r, c in zip(*np.where(g == fill))]
+    assert fill_pos, "expected fill seed pixels"
+
+    def _comp_min_dist(comp: set[tuple[int, int]]) -> int:
+        best = 10**9
+        for r, c in fill_pos:
+            for wr, wc in comp:
+                dist = abs(r - wr) + abs(c - wc)
+                if dist < best:
+                    best = dist
+                    if best == 0:
+                        return 0
+        return best
+
+    wall_comp = min(comps, key=lambda comp: (_comp_min_dist(comp), -len(comp)))
+    ray_info = _component_ray_info(wall_comp, (h, w))
+
+    extra_mask = (g != bg) & (g != wall) & (g != fill)
+    extra_comps = components_mask(extra_mask, connectivity=8)
+    assert all(len(pts) == 1 for pts in extra_comps), "expected singleton mover components"
+    mover_cells = [(int(pts[0][0]), int(pts[0][1]), int(g[pts[0][0], pts[0][1]])) for pts in extra_comps]
+    mover_mask = np.zeros_like(g, dtype=bool)
+    for r, c, _col in mover_cells:
+        mover_mask[r, c] = True
+
+    return {
+        "grid": g,
+        "shape": (h, w),
+        "bg": bg,
+        "wall": wall,
+        "fill": fill,
+        "fill_pos": fill_pos,
+        "wall_points": wall_points,
+        "wall_comp": wall_comp,
+        "comp_mask": ray_info["comp_mask"],
+        "endpoints": ray_info["endpoints"],
+        "out_dirs": ray_info["out_dirs"],
+        "tip_12": ray_info["tip_12"],
+        "rad": ray_info["rad"],
+        "mover_cells": mover_cells,
+        "mover_mask": mover_mask,
+    }
+
+
+def _compute_stage1(scene: dict) -> dict:
+    g = scene["grid"]
+    barrier = scene["comp_mask"].copy()
+    for ep, d, is_12 in zip(scene["endpoints"], scene["out_dirs"], scene["tip_12"]):
+        for r, c in _trace_ray(ep, d, scene["rad"], is_12, scene["shape"]):
+            barrier[r, c] = True
+
+    passable = (~barrier) & ((g == scene["bg"]) | (g == scene["fill"]) | scene["mover_mask"])
+    q = scene["fill_pos"][:]
+    seen = np.zeros_like(passable, dtype=bool)
+    for r, c in q:
+        if passable[r, c]:
+            seen[r, c] = True
+    while q:
+        r, c = q.pop()
+        for rr, cc in neighbors4(r, c):
+            if 0 <= rr < g.shape[0] and 0 <= cc < g.shape[1] and passable[rr, cc] and not seen[rr, cc]:
+                seen[rr, cc] = True
+                q.append((rr, cc))
+
+    fill_mask = seen & (~scene["comp_mask"])
+    sprite_mask = scene["comp_mask"] | fill_mask
+
+    out = g.copy()
+    out[scene["mover_mask"]] = scene["bg"]
+    out[fill_mask] = scene["fill"]
+    out[scene["comp_mask"]] = scene["wall"]
+
+    return {
+        "barrier": barrier,
+        "fill_mask": fill_mask,
+        "sprite_mask": sprite_mask,
+        "base_out": out,
+    }
+
+
+def _solve(grid: np.ndarray, return_meta: bool = False):
+    scene = _parse_scene(grid)
+    stage1 = _compute_stage1(scene)
+    out = stage1["base_out"].copy()
+
+    traces = []
+    for r, c, color in scene["mover_cells"]:
+        traced = _trace_mover((r, c), scene["rad"], scene["shape"], stage1["sprite_mask"])
+        traces.append(
+            {
+                "start": (r, c),
+                "end": traced["end"],
+                "path": list(traced["path"]),
+                "hit": traced["hit"],
+                "color": color,
+                "arrival": len(traced["path"]) + 1 if traced["hit"] is not None else len(traced["path"]),
+            }
+        )
+
+    for item in traces:
+        if item["hit"] is None:
+            end_r, end_c = item["end"]
+            out[end_r, end_c] = item["color"]
+
+    absorbed = [item for item in traces if item["hit"] is not None]
+    absorbed.sort(key=lambda item: (item["arrival"], item["start"][0], item["start"][1]))
+    for item in absorbed:
+        out[stage1["fill_mask"]] = item["color"]
+
+    if return_meta:
+        return out, {"scene": scene, "stage1": stage1, "traces": traces, "absorbed": absorbed}
+    return out
+
+
+def _edge_baseline_output(grid: np.ndarray) -> np.ndarray:
+    scene = _parse_scene(grid)
+    stage1 = _compute_stage1(scene)
+    out = stage1["base_out"].copy()
+    for r, c, color in scene["mover_cells"]:
+        traced = _trace_mover((r, c), scene["rad"], scene["shape"], None)
+        trail = [(r, c), *traced["path"]]
+        for rr, cc in trail:
+            out[rr, cc] = scene["bg"]
+        end_r, end_c = traced["end"]
+        out[end_r, end_c] = color
+    return out
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Flood a funnel interior, radiate through its opening, then absorb several straight-line movers into that filled sprite.
+
+    Input structure:
+    - The background is the most common color. The most common non-background color forms one funnel-like wall component.
+    - The non-wall color closest to that wall is a seed blob inside the enclosure. Any remaining non-background singleton pixels are movers placed on parallel lanes behind the funnel.
+
+    Rule:
+    - First reconstruct the same wall-defined filled sprite as in the base task: flood the reachable interior and outward corridor using the wall endpoints to infer the opening direction.
+    - Then move every singleton straight in that same radiate direction. If a mover would reach the grid edge first, it simply ends there and leaves background behind.
+    - If a mover's next step would enter the stage-1 sprite, the mover is absorbed instead of landing. The mover disappears, its trail becomes background, and the entire filled region recolors to that mover's color. Multiple absorbed movers recolor the fill repeatedly; the last arrival wins.
+
+    Key insight: The wall still determines one shared motion direction, but the extra singletons are no longer passive blockers. Their travel depth relative to the same wall tells you which color transfer happens last.
+    """
+    return _solve(grid, return_meta=False)
+
