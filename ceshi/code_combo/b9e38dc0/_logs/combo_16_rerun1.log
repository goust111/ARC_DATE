+def _solve(grid: np.ndarray, return_meta: bool = False):
+    scene = _parse_scene(grid)
+    stage1 = _compute_stage1(scene)
+    out = stage1["base_out"].copy()
+
+    traces = []
+    for r, c, color in scene["mover_cells"]:
+        traced = _trace_mover((r, c), scene["rad"], scene["shape"], stage1["sprite_mask"])
+        traces.append(
+            {
+                "start": (r, c),
+                "end": traced["end"],
+                "path": list(traced["path"]),
+                "hit": traced["hit"],
+                "color": color,
+                "arrival": len(traced["path"]) + 1 if traced["hit"] is not None else len(traced["path"]),
+            }
+        )
+
+    for item in traces:
+        if item["hit"] is None:
+            end_r, end_c = item["end"]
+            out[end_r, end_c] = item["color"]
+
+    absorbed = [item for item in traces if item["hit"] is not None]
+    absorbed.sort(key=lambda item: (item["arrival"], item["start"][0], item["start"][1]))
+    for item in absorbed:
+        out[stage1["fill_mask"]] = item["color"]
+
+    if return_meta:
+        return out, {"scene": scene, "stage1": stage1, "traces": traces, "absorbed": absorbed}
+    return out
+
