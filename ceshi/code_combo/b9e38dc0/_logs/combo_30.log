OPEN_END_MARGIN = 3

SEED_SIZE_WEIGHTS = [1, 1, 1, 1, 2, 2, 3, 4, 5, 6]
SEED_DEPTH_LOOKBACK = 3

MIN_MOVERS = 2
MAX_MOVERS = 5
MOVER_MIN_SEP = 2
MOVER_WALL_DIST = 3
MOVER_END_SEP = 1

