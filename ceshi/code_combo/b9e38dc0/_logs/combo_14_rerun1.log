+def _bbox_of(points: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rs = [r for r, _ in points]
+    cs = [c for _, c in points]
+    return min(rs), min(cs), max(rs), max(cs)
+
+
+def _trace_to_edge(start: tuple[int, int], direction: tuple[int, int], h: int, w: int) -> list[tuple[int, int]]:
+    rr, cc = start
+    dr, dc = direction
+    path = [(rr, cc)]
+    while True:
+        nr = rr + dr
+        nc = cc + dc
+        if not (0 <= nr < h and 0 <= nc < w):
+            break
+        path.append((nr, nc))
+        rr, cc = nr, nc
+    return path
+
+
+def _is_outside_open_side(
+    pos: tuple[int, int],
+    bbox: tuple[int, int, int, int],
+    direction: tuple[int, int],
+) -> bool:
+    r, c = pos
+    r0, c0, r1, c1 = bbox
+    dr, dc = direction
+    if dr == 1:
+        return r > r1 and c0 <= c <= c1
+    if dr == -1:
+        return r < r0 and c0 <= c <= c1
+    if dc == 1:
+        return c > c1 and r0 <= r <= r1
+    return c < c0 and r0 <= r <= r1
