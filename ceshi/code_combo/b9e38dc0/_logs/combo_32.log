def _manhattan_min(a_pts: list[tuple[int, int]], b_pts: list[tuple[int, int]]) -> int:
    best = 10**9
    for ar, ac in a_pts:
        for br, bc in b_pts:
            d = abs(ar - br) + abs(ac - bc)
            if d < best:
