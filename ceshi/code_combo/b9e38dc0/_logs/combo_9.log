    ```python
    import numpy as np

from arc_utils import neighbors4, neighbors8, components_mask, get_bg
import random

def main(grid: np.ndarray) -> np.ndarray:
    """
    Fill the region enclosed by a wall sprite and radiate color outward through its opening.

    Input structure:
    - bg = most common color. Wall = most frequent non-bg color, forming a partial enclosure (e.g. U-shape).
    - A fill-color pixel sits inside the enclosed area. Other non-bg pixels may act as obstacles.
    Rule:
    - Flood-fill the enclosed area with the fill color, radiating outward through the wall's open end.
    - Obstacles cast "shadows" along the radiate direction, blocking fill behind them.

    Key insight: The wall endpoints define the opening direction; fill radiates outward through it, and obstacles block propagation along that same axis.
    """
    g = np.array(grid, copy=True)
    h, w = g.shape

    vals = np.unique(g)
    bg = get_bg(g)

    non_bg = [int(v) for v in vals if int(v) != bg]
    assert non_bg, "expected at least one non-background color"

    # Wall: most frequent non-background color.
    wall = max(non_bg, key=lambda c: int((g == c).sum()))

    wall_mask = g == wall

    # Wall connected components (8-neigh).
    comps = [set((int(r), int(c)) for r, c in pts) for pts in components_mask(wall_mask, connectivity=8)]
    assert comps, "expected at least one wall connected component"

    def sgn(x: int) -> int:
        return (x > 0) - (x < 0)

    other_colors = [c for c in non_bg if c != wall]
    assert other_colors, "expected at least one non-wall color (fill color)"

    # Pick fill color as the non-wall color closest (Manhattan distance) to the wall pixels.
    wall_points = [p for comp in comps for p in comp]

    def min_dist_to_wall(color: int) -> tuple[int, int]:
        pts = list(zip(*np.where(g == color)))
        pts = [(int(r), int(c)) for r, c in pts]
        best_d = 10**9
        for r, c in pts:
            for wr, wc in wall_points:
                d = abs(r - wr) + abs(c - wc)
                if d < best_d:
                    best_d = d
                    if best_d == 0:
                        return 0, len(pts)
        return best_d, len(pts)

    fill = min(other_colors, key=lambda c: (min_dist_to_wall(c)[0], min_dist_to_wall(c)[1]))

    fill_pos = list(zip(*np.where(g == fill)))
    fill_pos = [(int(r), int(c)) for r, c in fill_pos]
    if not fill_pos:
        return g

    # Choose the closest wall component to the fill seed (ties: larger component).
    def comp_min_dist(comp: set[tuple[int, int]]) -> int:
        best_d = 10**9
        for r, c in fill_pos:
            for wr, wc in comp:
                d = abs(r - wr) + abs(c - wc)
                if d < best_d:
                    best_d = d
                    if best_d == 0:
                        return 0
        return best_d

    wall_comp = min(comps, key=lambda comp: (comp_min_dist(comp), -len(comp)))

    comp_mask = np.zeros_like(wall_mask, dtype=bool)
    for r, c in wall_comp:
        comp_mask[r, c] = True

    def comp_neighbors(r: int, c: int) -> list[tuple[int, int]]:
        out = []
        for rr, cc in neighbors8(r, c):
            if 0 <= rr < h and 0 <= cc < w and comp_mask[rr, cc]:
                out.append((rr, cc))
        return out

    endpoints: list[tuple[int, int]] = []
    for r, c in wall_comp:
        if len(comp_neighbors(r, c)) == 1:
            endpoints.append((r, c))

    assert endpoints, "expected wall component to have endpoints (degree-1 pixels)"

    def outward_dir(ep: tuple[int, int]) -> tuple[tuple[int, int], bool]:
        n1 = comp_neighbors(*ep)[0]
        d1 = (sgn(n1[0] - ep[0]), sgn(n1[1] - ep[1]))  # inward
        d_use = d1
        is_12 = False
        n2s = [p for p in comp_neighbors(*n1) if p != ep]
        if n2s:
            n2 = n2s[0]
            d2 = (sgn(n2[0] - n1[0]), sgn(n2[1] - n1[1]))
            if (d1[0] == 0) ^ (d1[1] == 0):
                if d2[0] != 0 and d2[1] != 0:
                    d_use = d2
                    is_12 = True
        return (-d_use[0], -d_use[1]), is_12

    out_info = [outward_dir(ep) for ep in endpoints]
    out_dirs = [d for d, _ in out_info]
    tip_12 = [f for _, f in out_info]

    dr_sum = sum(d[0] for d in out_dirs)
    dc_sum = sum(d[1] for d in out_dirs)
    rad = (sgn(dr_sum), sgn(dc_sum))

    barrier = comp_mask.copy()

    def add_ray(start: tuple[int, int], d: tuple[int, int], skip: int = 0) -> None:
        rr, cc = start
        for _ in range(skip):
            rr += d[0]
            cc += d[1]
        while True:
            rr += d[0]
            cc += d[1]
            if not (0 <= rr < h and 0 <= cc < w):
                break
            barrier[rr, cc] = True

    def add_ray_12(start: tuple[int, int], d: tuple[int, int]) -> None:
        rr, cc = start
        step = 0
        while True:
            step += 1
            if step % 2 == 1:
                rr += d[0]; cc += d[1]
            else:
                if rad[0] != 0:
                    rr += d[0]
                else:
                    cc += d[1]
            if not (0 <= rr < h and 0 <= cc < w):
                break
            barrier[rr, cc] = True

    for ep, d, is_12 in zip(endpoints, out_dirs, tip_12):
        if is_12:
            add_ray_12(ep, d)
        else:
            add_ray(ep, d, skip=0)

    passable = (~barrier) & ((g == bg) | (g == fill))
    q = fill_pos[:]
    seen = np.zeros_like(passable, dtype=bool)
    for r, c in q:
        if passable[r, c]:
            seen[r, c] = True
    while q:
        r, c = q.pop()
        for rr, cc in neighbors4(r, c):
            if 0 <= rr < h and 0 <= cc < w and passable[rr, cc] and not seen[rr, cc]:
                seen[rr, cc] = True
                q.append((rr, cc))

    filled_mask = (seen & (g == bg))

    out = g.copy()
    out[filled_mask] = fill

    # Shadow behind obstacles (non-bg, non-fill, non-wall) along radiate direction.
    obstacles = (g != bg) & (g != fill) & (g != wall)

    def shadow_process(coords: list[tuple[int, int]]) -> None:
        started = False
        blocked = False
        for r, c in coords:
            if filled_mask[r, c]:
                started = True
            if started and obstacles[r, c]:
                blocked = True
                continue
            if blocked and filled_mask[r, c]:
                out[r, c] = bg
                filled_mask[r, c] = False

    if rad != (0, 0):
        dr, dc = rad
        if dr != 0 and dc == 0:
            for c in range(w):
                rows = range(h) if dr > 0 else range(h - 1, -1, -1)
                shadow_process([(r, c) for r in rows])
        elif dc != 0 and dr == 0:
            for r in range(h):
                cols = range(w) if dc > 0 else range(w - 1, -1, -1)
                shadow_process([(r, c) for c in cols])
        else:
            # Diagonal scanlines
            if dr == dc:
                # r - c = const
                for k in range(-(w - 1), h):
                    coords = [(r, r - k) for r in range(h) if 0 <= r - k < w]
                    coords.sort(key=lambda rc: rc[0], reverse=(dr < 0))
                    shadow_process(coords)
            else:
                # r + c = const
                for k in range(h + w - 1):
                    coords = [(r, k - r) for r in range(h) if 0 <= k - r < w]
                    coords.sort(key=lambda rc: rc[0], reverse=(dr < 0))
                    shadow_process(coords)

    return out

# --------------- generator (o5x) ---------------

from scipy.ndimage import distance_transform_cdt

# -- Configuration constants --------------------------------------------------
# Canvas size bounds
GRID_H_VERT = (11, 18)       # height range when radiate_dir is vertical
GRID_H_HORIZ = (8, 18)       # height range when radiate_dir is horizontal
GRID_W = (15, 19)             # width range (all directions)

# Wall geometry
WALL_PIXELS_MIN = 17          # minimum wall pixel count
WALL_PIXELS_MAX = 25          # maximum wall pixel count
DEPTH_VERT = (5, 10)          # arm depth range for vertical radiate
DEPTH_HORIZ = (6, 8)          # arm depth range for horizontal radiate
GAP_VERT = (6, 7)             # endpoint gap for vertical radiate
GAP_HORIZ = (5, 7)            # endpoint gap for horizontal radiate
TIP_12_PROB = 0.5             # probability of 1:2 arm-angle mode (when eligible)

# Placement margins
OPEN_END_MARGIN = 3           # min cells from open end to radiate grid edge

# Fill seed
SEED_SIZE_WEIGHTS = [1, 1, 1, 1, 2, 2, 3, 4, 5, 6]  # weighted choices for blob size
SEED_DEPTH_LOOKBACK = 3       # seed must be within this many rows of closed end

# Obstacles
MAX_OBSTACLES = 5             # maximum obstacle pixel count
OBSTACLE_IN_FILL_PROB = 0.65  # probability of forcing at least one obstacle in fill zone
OBSTACLE_MIN_SEP = 2          # Chebyshev distance between obstacles (> this value)

# Validation
MIN_NEW_FILL = 20             # minimum newly-filled pixels for a valid output
PALETTE_SIZE = (3, 5)         # number of distinct colors (bg + wall + fill + obstacle(s))
GEN_RETRIES = 300             # max attempts in generate_input


def _degree1_pixels(points):
    """Return degree-1 pixels (exactly one 8-neighbor in the set)."""
    pts = set(points)
    return [(r, c) for r, c in pts
            if sum((rr, cc) in pts for rr, cc in neighbors8(r, c)) == 1]


def _make_arm(depth, start_v, target_v, extra_steps, tip_12=False):
    """Build one zigzag arm from (0, start_v) toward (depth, target_v)."""
    sign = 1 if target_v > start_v else -1
    n_side_steps = abs(target_v - start_v)
    chosen_rows = []
    if n_side_steps:
        if tip_12:
            chosen_rows = [2 * (i + 1) for i in range(n_side_steps)]
            extra_steps = 0
        else:
            chosen_rows = [1]
            if n_side_steps > 1:
                chosen_rows += random.sample(range(2, depth + 1), n_side_steps - 1)
            chosen_rows.sort()

    first_row = chosen_rows[0] if chosen_rows else 1
    extra_rows = [r for r in chosen_rows if r != first_row]
    random.shuffle(extra_rows)
    orthogonal_rows = set(extra_rows[:extra_steps])

    pts = [(0, start_v)]
    u, v = 0, start_v
    for row in range(1, depth + 1):
        u += 1
        if row in orthogonal_rows:
            pts.append((u, v))
            v += sign
        elif row in chosen_rows:
            v += sign
        pts.append((u, v))
    return pts


def _build_local_wall(rad, h, w):
    """Construct wall shape in local (u, v) coordinates. Returns (pts, depth, gap) or None."""
    if rad[0]:
        max_depth = min(DEPTH_VERT[1], h - 6)
        if max_depth < DEPTH_VERT[0]:
            return None
        depth = random.randint(DEPTH_VERT[0], max_depth)
        gap = random.randint(*GAP_VERT)
    else:
        depth = random.randint(DEPTH_HORIZ[0], min(DEPTH_HORIZ[1], w - 6))
        gap = random.randint(GAP_HORIZ[0], min(GAP_HORIZ[1], h - 1))

    if gap == 5:
        left_bottom, right_bottom = 2, 3
    elif gap == 6:
        left_bottom, right_bottom = 2, 4
    else:
        left_bottom, right_bottom = random.choice([(2, 5), (3, 4)])

    bridge_extra = max(0, right_bottom - left_bottom - 1)
    base_count = 2 * (depth + 1) + bridge_extra
    max_extra_l = max(0, left_bottom - 1)
    max_extra_r = max(0, gap - right_bottom - 1)
    min_extra = max(0, WALL_PIXELS_MIN - base_count)
    max_extra = min(max_extra_l + max_extra_r, WALL_PIXELS_MAX - base_count)
    if min_extra > max_extra:
        return None

    extra = random.randint(min_extra, max_extra)
    extra_l = random.randint(max(0, extra - max_extra_r), min(max_extra_l, extra))
    extra_r = extra - extra_l

    max_n_side = max(left_bottom, gap - right_bottom)
    tip_12 = depth >= 2 * max_n_side and random.random() < TIP_12_PROB
    left = _make_arm(depth, 0, left_bottom, extra_l, tip_12=tip_12)
    right = _make_arm(depth, gap, right_bottom, extra_r, tip_12=tip_12)
    pts = set(left) | set(right)
    for v in range(left_bottom, right_bottom + 1):
        pts.add((depth, v))

    # Pad wall to minimum size by adding 8-connected pixels that preserve 2 endpoints
    while len(pts) < WALL_PIXELS_MIN:
        candidates = [
            (u, v) for u in range(max(0, depth - 3), depth + 1)
            for v in range(gap + 1) if (u, v) not in pts
            and sum((uu, vv) in pts
                    for uu in range(u - 1, u + 2)
                    for vv in range(v - 1, v + 2)
                    if (uu, vv) != (u, v)) >= 2
        ]
        random.shuffle(candidates)
        added = False
        for p in candidates:
            trial = pts | {p}
            if len(trial) <= WALL_PIXELS_MAX and len(_degree1_pixels(trial)) == 2:
                pts = trial
                added = True
                break
        if not added:
            return None

    if not (WALL_PIXELS_MIN <= len(pts) <= WALL_PIXELS_MAX) or len(_degree1_pixels(pts)) != 2:
        return None
    return pts, depth, gap


def _map_local(u, v, rad, anchor):
    """Map local (u, v) to grid (r, c) given radiate direction and anchor."""
    r0, c0 = anchor
    if rad == (-1, 0):
        return r0 + u, c0 + v
    if rad == (1, 0):
        return r0 - u, c0 + v
    if rad == (0, -1):
        return r0 + v, c0 + u
    return r0 + v, c0 - u


def _place_anchor(rad, h, w, depth, gap):
    """Choose anchor so the wall fits within margins."""
    if rad == (-1, 0):
        return random.randint(OPEN_END_MARGIN, h - depth - 3), random.randint(0, w - gap - 1)
    if rad == (1, 0):
        return random.randint(depth + 2, h - 4), random.randint(0, w - gap - 1)
    if rad == (0, -1):
        return random.randint(0, h - gap - 1), random.randint(OPEN_END_MARGIN, w - depth - 3)
    return random.randint(0, h - gap - 1), random.randint(depth + 2, w - 4)


def _local_interior(wall, depth, gap):
    """Return bg cells strictly between the two wall arms in local coords."""
    by_row = {}
    for u, v in wall:
        by_row.setdefault(u, []).append(v)
    interior = []
    for u in range(1, depth):
        if u not in by_row or len(by_row[u]) < 2:
            continue
        lo, hi = min(by_row[u]), max(by_row[u])
        for v in range(lo + 1, hi):
            if (u, v) not in wall:
                interior.append((u, v))
    return interior


def _grow_seed_blob(seed, interior_set):
    """Grow a small 4-connected blob from seed within interior cells."""
    blob = {seed}
    target_size = random.choice(SEED_SIZE_WEIGHTS)
    frontier = [seed]
    while len(blob) < target_size and frontier:
        p = frontier.pop(random.randrange(len(frontier)))
        u, v = p
        for q in random.sample([(u - 1, v), (u + 1, v), (u, v - 1), (u, v + 1)], 4):
            if q in interior_set and q not in blob:
                blob.add(q)
                frontier.append(q)
                if len(blob) >= target_size:
                    break
    return blob


def _obstacle_fits(pos, placed):
    """Check that pos is at least Chebyshev OBSTACLE_MIN_SEP from all placed obstacles."""
    r, c = pos
    return all(max(abs(r - rr), abs(c - cc)) >= OBSTACLE_MIN_SEP for rr, cc in placed)


def _find_obstacle_candidates(grid, bg, wall_color, nominal_fill_zone):
    """Find bg cells far enough from wall for obstacle placement, using distance transform."""
    wall_mask = grid == wall_color
    # distance_transform_cdt with chessboard metric gives Chebyshev distance to wall
    dist = distance_transform_cdt(~wall_mask, metric='taxicab')
    far_from_wall = dist > 1
    eligible = (grid == bg) & far_from_wall
    all_coords = list(zip(*np.where(eligible)))
    fill_coords = [p for p in all_coords if nominal_fill_zone[p[0], p[1]]]
    random.shuffle(all_coords)
    random.shuffle(fill_coords)
    return [(int(r), int(c)) for r, c in all_coords], [(int(r), int(c)) for r, c in fill_coords]


def _place_obstacles(n_obstacles, candidates, fill_candidates, obstacle_colors, grid):
    """Place up to n_obstacles on the grid, preferring some in the fill zone."""
    placed = []
    n_fill = random.randint(0, min(n_obstacles, len(fill_candidates)))
    if fill_candidates and random.random() < OBSTACLE_IN_FILL_PROB:
        n_fill = max(1, n_fill)
    for p in fill_candidates:
        if len(placed) >= n_fill:
            break
        if _obstacle_fits(p, placed):
            placed.append(p)
    placed_set = set(placed)
    for p in candidates:
        if len(placed) >= n_obstacles:
            break
        if p not in placed_set and _obstacle_fits(p, placed):
            placed.append(p)
            placed_set.add(p)
    for i, (r, c) in enumerate(placed):
        grid[r, c] = obstacle_colors[i % len(obstacle_colors)]


def _touches_border(mask):
    """Check if any True cell in mask lies on the grid border."""
    return bool(mask[0, :].any() or mask[-1, :].any() or mask[:, 0].any() or mask[:, -1].any())


def _gen_attempt():
    """Single attempt to generate a valid input grid."""
    rad = random.choice([(-1, 0), (1, 0), (0, -1), (0, 1)])
    h = random.randint(*GRID_H_VERT) if rad[0] else random.randint(*GRID_H_HORIZ)
    w = random.randint(*GRID_W)

    built = _build_local_wall(rad, h, w)
    if built is None:
        return None
    local_wall, depth, gap = built
    anchor = _place_anchor(rad, h, w, depth, gap)

    # Choose palette
    palette = random.sample(range(10), random.randint(*PALETTE_SIZE))
    bg, wall_color, fill_color = palette[:3]
    obstacle_colors = palette[3:]

    # Render wall onto grid
    grid = np.full((h, w), bg, dtype=int)
    for u, v in local_wall:
        r, c = _map_local(u, v, rad, anchor)
        grid[r, c] = wall_color

    # Place fill seed near the closed end
    interior = _local_interior(local_wall, depth, gap)
    wall_set = set(local_wall)
    adjacent = [
        p for p in interior
        if any((p[0] + dr, p[1] + dc) in wall_set for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)])
    ]
    seed_pool = [p for p in adjacent if p[0] >= max(1, depth - SEED_DEPTH_LOOKBACK)]
    if not seed_pool:
        return None

    blob = _grow_seed_blob(random.choice(seed_pool), set(interior))
    for u, v in blob:
        r, c = _map_local(u, v, rad, anchor)
        if grid[r, c] != bg:
            return None
        grid[r, c] = fill_color

    # Run solver to find nominal fill zone (used for obstacle placement)
    try:
        nominal_out = main(grid)
    except Exception:
        return None
    nominal_fill_zone = (nominal_out == fill_color) & (grid == bg)

    # Place obstacles
    n_obstacles = random.randint(0, MAX_OBSTACLES)
    if n_obstacles and not obstacle_colors:
        available = [c for c in range(10) if c not in (bg, wall_color, fill_color)]
        obstacle_colors = random.sample(available, random.randint(1, 2))
    if n_obstacles:
        candidates, fill_candidates = _find_obstacle_candidates(grid, bg, wall_color, nominal_fill_zone)
        _place_obstacles(n_obstacles, candidates, fill_candidates, obstacle_colors, grid)

    # Validate: solver must produce enough fill that reaches a border
    try:
        out = main(grid)
    except Exception:
        return None
    new_fill = (out == fill_color) & (grid == bg)
    if int(new_fill.sum()) < MIN_NEW_FILL or not _touches_border(new_fill):
        return None
    return grid


def generate_input() -> np.ndarray:
    for _ in range(GEN_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid b9e38dc0 input")

    ```

    ## 原始任务规格（Spec）

    以下是从原始 solver 代码和示例中提炼的完整任务规格，包含精确的数值约束和生成策略。
    Spec 本身就是原题代码生成时的参考文件，因此：
    - 在**设计分析**阶段，参考 spec 理解原始任务的完整设计细节（对象结构、空间关系、生成策略等），以此为基础思考融合变体的改动如何落实
    - 在**实现**阶段，参考 spec 中的数值约束（网格尺寸、对象数量/尺寸、颜色数等），确保融合变体在物理上可实现

    ```yaml
    spec:
  grid: 8-18 rows x 15-19 cols; bg = most common color
  wall:
    color: most frequent non-bg color; single 8-connected component of 17-25 pixels
    shape: |
      V/U/funnel partial enclosure with two arms diverging from a closed end toward an open end.
      Arms are zigzag staircases mixing diagonal and orthogonal steps; may have horizontal/vertical
      bars at turns creating branch points (degree-3/4 nodes allowed). Exactly 2 degree-1 endpoints.
      Two arm-angle modes (both arms always same mode within one example):
        - 1:1 (45°): arm steps are diagonal (1 lateral per 1 depth)
        - 1:2 (<45°): arm steps strictly alternate depth-only and diagonal (1 lateral per 2 depth)
    bbox: spans 6-11 rows x 7-9 cols
    endpoints: both on same row, same col, or diagonally close; Chebyshev gap 5-7
    opening: endpoints define the open end; radiate_dir is the cardinal direction (up/down/left/right) pointing outward from the opening, derived from the vector sum of endpoint outward directions
    placement: closed end >=2 cells from its grid edge; open end >=3 cells from the radiate-edge
  fill_seed:
    color: non-bg non-wall color closest (Manhattan) to the wall
    shape: 1-6 pixels, single 4-connected component (usually 1 pixel) [observed]
    location: inside the enclosure near the closed end; Manhattan distance 1-2 from wall; always 8-adjacent to wall
  obstacles:
    count: 0-2 distinct colors, 0-5 singleton pixels total (one 2-pixel pair allowed)
    location: scattered on bg cells; some in the radiate zone (between opening and grid edge), some elsewhere
    effect: preserved unchanged; those in the fill zone cast bg shadows behind them along radiate_dir
  output:
    fill_interior: flood-fill (4-conn) all bg cells reachable from seed inside enclosure with fill color
    radiate: fill continues outward through the opening, bounded by rays from endpoints
      until grid edge. Ray slope matches arm-angle mode: 1:1 arms → 45° diagonal rays,
      1:2 arms → 1:2 slope rays (alternating diagonal and depth-only steps)
    shadows: obstacles in the fill zone block fill propagation along radiate_dir behind them
    preserved: wall, fill seed, all obstacle pixels remain unchanged

generation_strategy: |
  Output-first: build the wall + fill output, then strip the fill to get the input.
  1. Pick grid size, 3-5 colors {bg, wall, fill, obstacle(s)}, and radiate_dir.
  2. Build the wall: place it so the closed end has >=2 margin from its edge and the
     opening has >=3 cells toward the radiate edge. Pick arm-angle mode (1:1 or 1:2,
     same for both arms). Draw two arms as zigzag chains from the closed end outward:
     1:1 mode uses diagonal steps; 1:2 mode strictly alternates depth-only and diagonal
     steps (evenly spaced at rows 2,4,6,...). Optionally add short bars at turns. Verify single 8-connected component, exactly 2 endpoints,
     17-25 pixels, Chebyshev endpoint gap 5-7.
  3. Place fill seed: pick a bg cell inside the enclosure near the closed end,
     8-adjacent to a wall pixel. Optionally grow to a small blob (size 1-6).
  4. Place 0-5 obstacle pixels on bg cells (0-2 distinct colors, singletons).
  5. Run the solver to produce the output; reject if <20 newly-filled cells or
     fill does not reach at least one grid border.
  6. The constructed grid (before running solver) is the input; solver output is the output.
    ```

额外要求：原始代码的 `main()` 已包含四段式说明注释/文档字符串（开头概述 + `Input structure:` + `Rule:` + `Key insight:`）。
生成的新代码里也必须在 `main()` 上方保留这一结构，并根据**融合后的新规则**与**原注释提供的信息**重新编写；可以借鉴原注释的组织方式，但**不要照抄原文**，要让内容准确反映融合后的输入结构、规则和关键洞察。


## 已有单变体参考代码

以下组成项已有单变体实现，可作为融合时的参考：

            ### 参考代码: D6/3

            文件: `/home/lixinyu/snap/new/ceshi/code/b9e38dc0/D6/3/code.py`

            ```python
            # Variant of b9e38dc0
# Dimension: D6 — 半包围精灵的形状结构 (obstacle)
# Change: 半包围区域由U形或C形边框围成，有一个明确的开口方向（上/下/左/右）... → 完全包围但有可破坏的薄壁

import random

import numpy as np
from scipy.ndimage import distance_transform_cdt

from arc_utils import components_mask, get_bg, neighbors4

# ---------------------------------------------------------------------------
# Design analysis for the D6 variant
#
# a) Concrete behavior:
#    - The old task used a partial enclosure whose endpoints visibly exposed the
#      radiate direction. This variant replaces that with a fully closed wall.
#    - The wall is now a rectangular shell around a cavity. Exactly one side of
#      the shell is 1 cell thick; the other three sides are 2 or 3 cells thick.
#    - A fill-colored seed sits inside the cavity, near the side opposite the
#      thin wall. In the output, fill first floods the cavity, then breaks
#      through the thin side and continues as a straight rectangular beam toward
#      the corresponding grid edge. Obstacles in that beam cast background
#      shadows behind themselves along the beam direction.
#    - Small trace example:
#      original: seed inside U-shape -> endpoints reveal "up" -> fill exits the
#      open top and spreads upward between the two arms.
#      variant: seed inside closed box -> no endpoints exist -> solver must
#      flood only the sealed cavity, measure wall thickness on all four sides,
#      find the unique thickness-1 side, replace that side's wall strip with
#      fill, then extend the beam from that side.
#
# b) Complexity calibration:
#    - The shape is not reduced to an arbitrary blob; it is still a single wall
#      object with clear inside/outside structure and a visible directional cue.
#    - Only four directional cases exist, matching the original cardinal
#      radiate choices. The new discriminating signal is a unique minimum wall
#      thickness, which appears as repeated evidence across the whole thin side.
#
# c) Hidden assumptions from the original solver that break here:
#    - Degree-1 endpoint detection no longer works because the wall is a loop.
#    - Endpoint-derived rays no longer define the exit direction.
#    - Assuming the wall is only a barrier is no longer enough; one side must be
#      converted from wall to fill in the output.
#    - The fill region cannot be inferred from a partially open shape anymore;
#      the solver must first recover the sealed interior via flood-fill from the
#      seed before thickness can be measured.
#
# d) Placement legality guaranteed by the generator:
#    - The shell is an axis-aligned rectangle ring, so it never self-overlaps.
#    - The thin side always has at least 3 cells of outside margin before the
#      relevant grid border, so external radiation is visible.
#    - Obstacles are placed only on background cells outside the shell and at
#      Manhattan distance > 1 from the wall, so they never steal the "closest
#      non-wall color" role from the fill seed.
#
# e) Visual observability:
#    - Humans can infer the direction by comparing visible wall thicknesses.
#      The only 1-cell-thick side is the side that gets breached.
#    - Across samples, the thin side varies over the four cardinal directions so
#      the rule is not overfit to one placement.
#
# f) Visual cleanliness:
#    - The output has only three active layers in the interesting region:
#      preserved wall, fill region, and sparse obstacle pixels with shadows.
#    - Obstacles are kept outside the cavity to avoid mixing "what fills the
#      room" with "what blocks the beam".
#
# g) Color inferability:
#    - No color-id ordering is used. The fill color is still selected by spatial
#      proximity to the wall, and obstacle colors remain arbitrary preserved
#      singleton colors.
# ---------------------------------------------------------------------------

# -- Configuration constants -------------------------------------------------
GRID_H_VERT = (11, 18)
GRID_H_HORIZ = (8, 18)
GRID_W = (15, 19)

INNER_H_VERT = (3, 6)
INNER_W_VERT = (5, 8)
INNER_H_HORIZ = (4, 7)
INNER_W_HORIZ = (3, 6)

OPEN_END_MARGIN = 3
FAR_SIDE_MARGIN = 2
SIDE_MARGIN = 1

THICK_OTHER = (2, 3)

SEED_SIZE_WEIGHTS = [1, 1, 1, 1, 2, 2, 3, 4, 5, 6]
SEED_DEPTH_LOOKBACK = 2

MAX_OBSTACLES = 5
OBSTACLE_IN_FILL_PROB = 0.65
OBSTACLE_MIN_SEP = 2

MIN_NEW_FILL = 20
PALETTE_SIZE = (3, 5)
GEN_RETRIES = 300


def _touches_border(mask: np.ndarray) -> bool:
    return bool(mask[0, :].any() or mask[-1, :].any() or mask[:, 0].any() or mask[:, -1].any())


def _seed_fill(mask: np.ndarray, starts: list[tuple[int, int]]) -> np.ndarray:
    h, w = mask.shape
    seen = np.zeros_like(mask, dtype=bool)
    q = []
    for r, c in starts:
        if 0 <= r < h and 0 <= c < w and mask[r, c] and not seen[r, c]:
            seen[r, c] = True
            q.append((r, c))
    while q:
        r, c = q.pop()
        for rr, cc in neighbors4(r, c):
            if 0 <= rr < h and 0 <= cc < w and mask[rr, cc] and not seen[rr, cc]:
                seen[rr, cc] = True
                q.append((rr, cc))
    return seen


def _trim_dead_ends(points: set[tuple[int, int]]) -> set[tuple[int, int]]:
    pts = set(points)
    changed = True
    while changed:
        changed = False
        drop = {
            (r, c)
            for r, c in pts
            if sum((rr, cc) in pts for rr, cc in neighbors4(r, c)) <= 1
        }
        if drop and len(drop) < len(pts):
            pts -= drop
            changed = True
    return pts


def _min_dist_to_wall(grid: np.ndarray, color: int, wall_points: list[tuple[int, int]]) -> tuple[int, int]:
    pts = [(int(r), int(c)) for r, c in zip(*np.where(grid == color))]
    best_d = 10**9
    for r, c in pts:
        for wr, wc in wall_points:
            d = abs(r - wr) + abs(c - wc)
            if d < best_d:
                best_d = d
                if best_d == 0:
                    return 0, len(pts)
    return best_d, len(pts)


def _side_samples(interior: np.ndarray) -> dict[tuple[int, int], list[tuple[int, int]]]:
    rows, cols = np.where(interior)
    top = int(rows.min())
    bottom = int(rows.max())
    left = int(cols.min())
    right = int(cols.max())
    return {
        (-1, 0): [(top, c) for c in range(left, right + 1) if interior[top, c]],
        (1, 0): [(bottom, c) for c in range(left, right + 1) if interior[bottom, c]],
        (0, -1): [(r, left) for r in range(top, bottom + 1) if interior[r, left]],
        (0, 1): [(r, right) for r in range(top, bottom + 1) if interior[r, right]],
    }


def _count_wall_run(comp_mask: np.ndarray, start: tuple[int, int], d: tuple[int, int]) -> int:
    h, w = comp_mask.shape
    r, c = start
    rr, cc = r + d[0], c + d[1]
    count = 0
    while 0 <= rr < h and 0 <= cc < w and comp_mask[rr, cc]:
        count += 1
        rr += d[0]
        cc += d[1]
    return count


def _measure_side_thicknesses(comp_mask: np.ndarray, interior: np.ndarray) -> dict[tuple[int, int], int]:
    samples = _side_samples(interior)
    thicknesses = {}
    for d, pts in samples.items():
        runs = [_count_wall_run(comp_mask, p, d) for p in pts]
        assert runs and min(runs) > 0, "expected interior side to face wall"
        thicknesses[d] = min(runs)
    return thicknesses


def _choose_radiate_dir(thicknesses: dict[tuple[int, int], int]) -> tuple[int, int]:
    items = sorted(thicknesses.items(), key=lambda kv: kv[1])
    assert len(items) == 4, "expected four side thicknesses"
    assert items[0][1] < items[1][1], "expected a unique thinnest wall side"
    return items[0][0]


def _build_breach_and_beam(
    comp_mask: np.ndarray,
    interior: np.ndarray,
    rad: tuple[int, int],
) -> tuple[np.ndarray, np.ndarray]:
    h, w = comp_mask.shape
    breach = np.zeros_like(comp_mask, dtype=bool)
    beam = np.zeros_like(comp_mask, dtype=bool)
    rows, cols = np.where(interior)
    top = int(rows.min())
    bottom = int(rows.max())
    left = int(cols.min())
    right = int(cols.max())

    if rad == (-1, 0):
        for c in range(left, right + 1):
            if not interior[top, c]:
                continue
            rr = top - 1
            while rr >= 0 and comp_mask[rr, c]:
                breach[rr, c] = True
                rr -= 1
        beam[:top, left : right + 1] = True
    elif rad == (1, 0):
        for c in range(left, right + 1):
            if not interior[bottom, c]:
                continue
            rr = bottom + 1
            while rr < h and comp_mask[rr, c]:
                breach[rr, c] = True
                rr += 1
        beam[bottom + 1 :, left : right + 1] = True
    elif rad == (0, -1):
        for r in range(top, bottom + 1):
            if not interior[r, left]:
                continue
            cc = left - 1
            while cc >= 0 and comp_mask[r, cc]:
                breach[r, cc] = True
                cc -= 1
        beam[top : bottom + 1, :left] = True
    else:
        for r in range(top, bottom + 1):
            if not interior[r, right]:
                continue
            cc = right + 1
            while cc < w and comp_mask[r, cc]:
                breach[r, cc] = True
                cc += 1
        beam[top : bottom + 1, right + 1 :] = True

    return breach, beam


def _analyze_scene(grid: np.ndarray) -> dict:
    g = np.array(grid, copy=False)
    h, w = g.shape
    bg = get_bg(g)
    vals = [int(v) for v in np.unique(g) if int(v) != bg]
    assert vals, "expected at least one non-background color"

    wall = max(vals, key=lambda c: int((g == c).sum()))
    wall_mask = g == wall
    comps = [set((int(r), int(c)) for r, c in pts) for pts in components_mask(wall_mask, connectivity=8)]
    assert comps, "expected at least one wall connected component"

    other_colors = [c for c in vals if c != wall]
    assert other_colors, "expected at least one non-wall color"
    wall_points = [p for comp in comps for p in comp]
    fill = min(other_colors, key=lambda c: _min_dist_to_wall(g, c, wall_points))
    fill_pos = [(int(r), int(c)) for r, c in zip(*np.where(g == fill))]
    assert fill_pos, "expected at least one fill seed pixel"

    def comp_min_dist(comp: set[tuple[int, int]]) -> int:
        best = 10**9
        for r, c in fill_pos:
            for wr, wc in comp:
                d = abs(r - wr) + abs(c - wc)
                if d < best:
                    best = d
                    if best == 0:
                        return 0
        return best

    wall_comp = min(comps, key=lambda comp: (comp_min_dist(comp), -len(comp)))
    wall_comp = _trim_dead_ends(wall_comp)
    assert wall_comp, "expected a closed core wall after trimming auxiliaries"
    comp_mask = np.zeros_like(wall_mask, dtype=bool)
    for r, c in wall_comp:
        comp_mask[r, c] = True

    interior_passable = (~comp_mask) & ((g == bg) | (g == fill))
    interior = _seed_fill(interior_passable, fill_pos)
    assert interior.any(), "expected fill seed to reach an enclosed interior"
    assert not _touches_border(interior), "seed region leaked to the border; wall must stay sealed in input"

    thicknesses = _measure_side_thicknesses(comp_mask, interior)
    rad = _choose_radiate_dir(thicknesses)
    breach, beam = _build_breach_and_beam(comp_mask, interior, rad)
    assert breach.any(), "expected a thin wall segment to breach"

    rows, cols = np.where(interior)
    bbox = (int(rows.min()), int(cols.min()), int(rows.max()), int(cols.max()))
    return {
        "bg": bg,
        "wall": wall,
        "fill": fill,
        "fill_pos": fill_pos,
        "comp_mask": comp_mask,
        "interior": interior,
        "thicknesses": thicknesses,
        "rad": rad,
        "breach": breach,
        "beam": beam,
        "interior_bbox": bbox,
        "shape": (h, w),
    }


def main(grid: np.ndarray) -> np.ndarray:
    """
    Fill the sealed chamber and burst outward through its uniquely thinnest wall.

    Input structure:
    - bg is the most common color. The wall is the most frequent non-bg color and forms one closed shell around a cavity.
    - A fill-color seed lies inside that cavity. One wall side is exactly 1 pixel thick; the other three sides are thicker. Other non-bg pixels are obstacles.
    Rule:
    - Flood-fill the chamber interior with the fill color, then break the thin wall and continue filling straight outward from that side to the grid edge.
    - Obstacles stay fixed and cast background shadows behind themselves along the same outward direction.

    Key insight: Because the wall is fully closed, the exit direction is no longer visible as an opening; it must be inferred by comparing the four wall-side thicknesses around the enclosed fill region.
    """
    g = np.array(grid, copy=True)
    info = _analyze_scene(g)
    bg = info["bg"]
    wall = info["wall"]
    fill = info["fill"]
    fill_pos = info["fill_pos"]
    interior = info["interior"]
    rad = info["rad"]
    breach = info["breach"]
    beam = info["beam"]

    domain = interior | beam | breach
    passable = domain & ((g == bg) | (g == fill) | breach)
    seen = _seed_fill(passable, fill_pos)

    write_mask = seen & ((g == bg) | breach)
    out = g.copy()
    out[write_mask] = fill

    filled_mask = write_mask.copy()
    obstacles = (g != bg) & (g != fill) & (g != wall)

    def shadow_process(coords: list[tuple[int, int]]) -> None:
        started = False
        blocked = False
        for r, c in coords:
            if filled_mask[r, c]:
                started = True
            if started and obstacles[r, c]:
                blocked = True
                continue
            if blocked and filled_mask[r, c]:
                out[r, c] = bg
                filled_mask[r, c] = False

    dr, dc = rad
    if dr != 0:
        for c in range(g.shape[1]):
            rows = range(g.shape[0]) if dr > 0 else range(g.shape[0] - 1, -1, -1)
            shadow_process([(r, c) for r in rows])
    else:
        for r in range(g.shape[0]):
            cols = range(g.shape[1]) if dc > 0 else range(g.shape[1] - 1, -1, -1)
            shadow_process([(r, c) for c in cols])

    return out


def _grow_seed_blob(seed: tuple[int, int], interior_cells: set[tuple[int, int]]) -> set[tuple[int, int]]:
    blob = {seed}
    frontier = [seed]
    target_size = random.choice(SEED_SIZE_WEIGHTS)
    while len(blob) < target_size and frontier:
        r, c = frontier.pop(random.randrange(len(frontier)))
        nbrs = [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
        for q in random.sample(nbrs, len(nbrs)):
            if q in interior_cells and q not in blob:
                blob.add(q)
                frontier.append(q)
                if len(blob) >= target_size:
                    break
    return blob


def _obstacle_fits(pos: tuple[int, int], placed: list[tuple[int, int]]) -> bool:
    r, c = pos
    return all(max(abs(r - rr), abs(c - cc)) >= OBSTACLE_MIN_SEP for rr, cc in placed)


def _choose_thicknesses(rad: tuple[int, int]) -> dict[str, int]:
    top = random.randint(*THICK_OTHER)
    bottom = random.randint(*THICK_OTHER)
    left = random.randint(*THICK_OTHER)
    right = random.randint(*THICK_OTHER)
    if rad == (-1, 0):
        top = 1
    elif rad == (1, 0):
        bottom = 1
    elif rad == (0, -1):
        left = 1
    else:
        right = 1
    return {"top": top, "bottom": bottom, "left": left, "right": right}


def _choose_inner_dims(rad: tuple[int, int], h: int, w: int, t: dict[str, int]) -> tuple[int, int] | None:
    if rad[0]:
        hs = list(range(INNER_H_VERT[0], INNER_H_VERT[1] + 1))
        ws = list(range(INNER_W_VERT[0], INNER_W_VERT[1] + 1))
    else:
        hs = list(range(INNER_H_HORIZ[0], INNER_H_HORIZ[1] + 1))
        ws = list(range(INNER_W_HORIZ[0], INNER_W_HORIZ[1] + 1))
    random.shuffle(hs)
    random.shuffle(ws)
    for inner_h in hs:
        for inner_w in ws:
            outer_h = t["top"] + inner_h + t["bottom"]
            outer_w = t["left"] + inner_w + t["right"]
            if outer_h + FAR_SIDE_MARGIN <= h and outer_w + SIDE_MARGIN * 2 <= w:
                if rad[0]:
                    if outer_h + OPEN_END_MARGIN + FAR_SIDE_MARGIN <= h:
                        return inner_h, inner_w
                else:
                    if outer_w + OPEN_END_MARGIN + FAR_SIDE_MARGIN <= w:
                        return inner_h, inner_w
    return None


def _place_outer_box(
    rad: tuple[int, int],
    h: int,
    w: int,
    outer_h: int,
    outer_w: int,
) -> tuple[int, int]:
    if rad == (-1, 0):
        r0 = random.randint(OPEN_END_MARGIN, h - outer_h - FAR_SIDE_MARGIN)
        c0 = random.randint(SIDE_MARGIN, w - outer_w - SIDE_MARGIN)
    elif rad == (1, 0):
        r0 = random.randint(FAR_SIDE_MARGIN, h - outer_h - OPEN_END_MARGIN)
        c0 = random.randint(SIDE_MARGIN, w - outer_w - SIDE_MARGIN)
    elif rad == (0, -1):
        r0 = random.randint(SIDE_MARGIN, h - outer_h - SIDE_MARGIN)
        c0 = random.randint(OPEN_END_MARGIN, w - outer_w - FAR_SIDE_MARGIN)
    else:
        r0 = random.randint(SIDE_MARGIN, h - outer_h - SIDE_MARGIN)
        c0 = random.randint(FAR_SIDE_MARGIN, w - outer_w - OPEN_END_MARGIN)
    return r0, c0


def _render_shell(
    grid: np.ndarray,
    rad: tuple[int, int],
    r0: int,
    c0: int,
    inner_h: int,
    inner_w: int,
    t: dict[str, int],
    wall_color: int,
) -> tuple[np.ndarray, np.ndarray]:
    outer_h = t["top"] + inner_h + t["bottom"]
    outer_w = t["left"] + inner_w + t["right"]
    grid[r0 : r0 + outer_h, c0 : c0 + outer_w] = wall_color

    ir0 = r0 + t["top"]
    ic0 = c0 + t["left"]
    interior = np.zeros_like(grid, dtype=bool)
    interior[ir0 : ir0 + inner_h, ic0 : ic0 + inner_w] = True
    grid[interior] = get_bg(grid)

    wall_mask = np.zeros_like(grid, dtype=bool)
    wall_mask[r0 : r0 + outer_h, c0 : c0 + outer_w] = True
    wall_mask[interior] = False

    mid_r = ir0 + inner_h // 2
    mid_c = ic0 + inner_w // 2
    if rad == (-1, 0):
        spur_cells = [(r0 - 1, mid_c), (r0 - 2, mid_c)]
    elif rad == (1, 0):
        spur_cells = [(r0 + outer_h, mid_c), (r0 + outer_h + 1, mid_c)]
    elif rad == (0, -1):
        spur_cells = [(mid_r, c0 - 1), (mid_r, c0 - 2)]
    else:
        spur_cells = [(mid_r, c0 + outer_w), (mid_r, c0 + outer_w + 1)]
    for sr, sc in spur_cells:
        grid[sr, sc] = wall_color
        wall_mask[sr, sc] = True
    return wall_mask, interior


def _seed_pool(interior: np.ndarray, rad: tuple[int, int]) -> list[tuple[int, int]]:
    rows, cols = np.where(interior)
    top = int(rows.min())
    bottom = int(rows.max())
    left = int(cols.min())
    right = int(cols.max())
    pool = []
    for r, c in zip(rows, cols):
        r = int(r)
        c = int(c)
        if rad == (-1, 0):
            if r >= bottom - SEED_DEPTH_LOOKBACK:
                pool.append((r, c))
        elif rad == (1, 0):
            if r <= top + SEED_DEPTH_LOOKBACK:
                pool.append((r, c))
        elif rad == (0, -1):
            if c >= right - SEED_DEPTH_LOOKBACK:
                pool.append((r, c))
        else:
            if c <= left + SEED_DEPTH_LOOKBACK:
                pool.append((r, c))
    return pool


def _find_obstacle_candidates(
    grid: np.ndarray,
    bg: int,
    wall_color: int,
    nominal_fill_zone: np.ndarray,
    exterior_bg: np.ndarray,
) -> tuple[list[tuple[int, int]], list[tuple[int, int]]]:
    wall_mask = grid == wall_color
    dist = distance_transform_cdt(~wall_mask, metric="taxicab")
    eligible = exterior_bg & (grid == bg) & (dist > 1)
    all_coords = [(int(r), int(c)) for r, c in zip(*np.where(eligible))]
    fill_coords = [p for p in all_coords if nominal_fill_zone[p[0], p[1]]]
    random.shuffle(all_coords)
    random.shuffle(fill_coords)
    return all_coords, fill_coords


def _place_obstacles(
    n_obstacles: int,
    candidates: list[tuple[int, int]],
    fill_candidates: list[tuple[int, int]],
    obstacle_colors: list[int],
    grid: np.ndarray,
) -> None:
    placed: list[tuple[int, int]] = []
    n_fill = random.randint(0, min(n_obstacles, len(fill_candidates)))
    if fill_candidates and random.random() < OBSTACLE_IN_FILL_PROB:
        n_fill = max(1, n_fill)
    for p in fill_candidates:
        if len(placed) >= n_fill:
            break
        if _obstacle_fits(p, placed):
            placed.append(p)
    placed_set = set(placed)
    for p in candidates:
        if len(placed) >= n_obstacles:
            break
        if p not in placed_set and _obstacle_fits(p, placed):
            placed.append(p)
            placed_set.add(p)
    for i, (r, c) in enumerate(placed):
        grid[r, c] = obstacle_colors[i % len(obstacle_colors)]


def _gen_attempt() -> np.ndarray | None:
    rad = random.choice([(-1, 0), (1, 0), (0, -1), (0, 1)])
    h = random.randint(*GRID_H_VERT) if rad[0] else random.randint(*GRID_H_HORIZ)
    w = random.randint(*GRID_W)

    t = _choose_thicknesses(rad)
    dims = _choose_inner_dims(rad, h, w, t)
    if dims is None:
        return None
    inner_h, inner_w = dims
    outer_h = t["top"] + inner_h + t["bottom"]
    outer_w = t["left"] + inner_w + t["right"]
    r0, c0 = _place_outer_box(rad, h, w, outer_h, outer_w)

    palette = random.sample(range(10), random.randint(*PALETTE_SIZE))
    bg, wall_color, fill_color = palette[:3]
    obstacle_colors = palette[3:]

    grid = np.full((h, w), bg, dtype=int)
    wall_mask, interior = _render_shell(grid, rad, r0, c0, inner_h, inner_w, t, wall_color)

    pool = _seed_pool(interior, rad)
    if not pool:
        return None
    interior_cells = {tuple(map(int, p)) for p in zip(*np.where(interior))}
    blob = _grow_seed_blob(random.choice(pool), interior_cells)
    for r, c in blob:
        if grid[r, c] != bg:
            return None
        grid[r, c] = fill_color

    try:
        nominal_out = main(grid)
    except Exception:
        return None

    nominal_fill_zone = (nominal_out == fill_color) & (grid == bg)
    exterior_bg = (~interior) & (~wall_mask) & (grid == bg)

    n_obstacles = random.randint(0, MAX_OBSTACLES)
    if n_obstacles and not obstacle_colors:
        available = [c for c in range(10) if c not in (bg, wall_color, fill_color)]
        obstacle_colors = random.sample(available, random.randint(1, 2))
    if n_obstacles:
        candidates, fill_candidates = _find_obstacle_candidates(
            grid, bg, wall_color, nominal_fill_zone, exterior_bg
        )
        _place_obstacles(n_obstacles, candidates, fill_candidates, obstacle_colors, grid)

    try:
        out = main(grid)
    except Exception:
        return None
    new_fill = (out == fill_color) & (grid == bg)
    if int(new_fill.sum()) < MIN_NEW_FILL or not _touches_border(new_fill):
        return None

    info = _analyze_scene(grid)
    if info["thicknesses"][info["rad"]] != 1:
        return None
    other = [v for d, v in info["thicknesses"].items() if d != info["rad"]]
    if not all(v >= 2 for v in other):
        return None
    if int((new_fill & info["beam"]).sum()) < 8:
        return None
    return grid


def generate_input() -> np.ndarray:
    for _ in range(GEN_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid b9e38dc0 D6 variant input")

