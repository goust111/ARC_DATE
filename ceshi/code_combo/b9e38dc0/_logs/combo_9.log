+#      non-wall color nearest to the wall in Manhattan distance.
+#    - The generator validates that every sample creates both a filled breach
+#      path and a nonzero set of new wall-colored pipe cells, so the combo does
+#      not collapse back to the D6-only behavior.
+# ---------------------------------------------------------------------------
+
+# Canvas size bounds
+GRID_H_VERT = (11, 18)
+GRID_H_HORIZ = (8, 18)
+GRID_W = (15, 19)
+
+# Shell geometry
+INNER_H_VERT = (3, 6)
+INNER_W_VERT = (5, 8)
+INNER_H_HORIZ = (4, 7)
+INNER_W_HORIZ = (3, 6)
+THICK_OTHER = (2, 3)
+
+# Placement margins
+OPEN_END_MARGIN = 3
+FAR_SIDE_MARGIN = 2
+SIDE_MARGIN = 1
+
+# Fill seed
+SEED_SIZE_WEIGHTS = [1, 1, 1, 1, 2, 2, 3, 4, 5, 6]
+SEED_DEPTH_LOOKBACK = 2
+
+# Obstacles
+MAX_OBSTACLES = 5
+OBSTACLE_IN_FILL_PROB = 0.65
+OBSTACLE_MIN_SEP = 2
+
+# Validation
+MIN_NEW_FILL = 20
+MIN_PIPE_LEN = 3
+MIN_PIPE_CELLS = 6
+MIN_BEAM_FILL = 8
+PALETTE_SIZE = (3, 5)
+GEN_RETRIES = 500
+
+
+def _touches_border(mask: np.ndarray) -> bool:
+    return bool(mask[0, :].any() or mask[-1, :].any() or mask[:, 0].any() or mask[:, -1].any())
+
+
+def _seed_fill(mask: np.ndarray, starts: list[tuple[int, int]]) -> np.ndarray:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    q: list[tuple[int, int]] = []
+    for r, c in starts:
+        if 0 <= r < h and 0 <= c < w and mask[r, c] and not seen[r, c]:
+            seen[r, c] = True
+            q.append((r, c))
+    while q:
+        r, c = q.pop()
+        for rr, cc in neighbors4(r, c):
+            if 0 <= rr < h and 0 <= cc < w and mask[rr, cc] and not seen[rr, cc]:
+                seen[rr, cc] = True
+                q.append((rr, cc))
+    return seen
+
+
+def _trim_dead_ends(points: set[tuple[int, int]]) -> set[tuple[int, int]]:
+    pts = set(points)
+    changed = True
+    while changed:
+        changed = False
+        drop = {
+            (r, c)
+            for r, c in pts
+            if sum((rr, cc) in pts for rr, cc in neighbors4(r, c)) <= 1
+        }
+        if drop and len(drop) < len(pts):
+            pts -= drop
+            changed = True
+    return pts
+
+
+def _min_dist_to_wall(grid: np.ndarray, color: int, wall_points: list[tuple[int, int]]) -> tuple[int, int]:
+    pts = [(int(r), int(c)) for r, c in zip(*np.where(grid == color))]
+    best_d = 10**9
+    for r, c in pts:
+        for wr, wc in wall_points:
+            d = abs(r - wr) + abs(c - wc)
+            if d < best_d:
+                best_d = d
+                if best_d == 0:
+                    return 0, len(pts)
+    return best_d, len(pts)
+
+
+def _side_samples(interior: np.ndarray) -> dict[tuple[int, int], list[tuple[int, int]]]:
+    rows, cols = np.where(interior)
+    top = int(rows.min())
+    bottom = int(rows.max())
+    left = int(cols.min())
+    right = int(cols.max())
+    return {
+        (-1, 0): [(top, c) for c in range(left, right + 1) if interior[top, c]],
+        (1, 0): [(bottom, c) for c in range(left, right + 1) if interior[bottom, c]],
+        (0, -1): [(r, left) for r in range(top, bottom + 1) if interior[r, left]],
+        (0, 1): [(r, right) for r in range(top, bottom + 1) if interior[r, right]],
+    }
+
+
+def _count_wall_run(comp_mask: np.ndarray, start: tuple[int, int], d: tuple[int, int]) -> int:
+    h, w = comp_mask.shape
+    rr = start[0] + d[0]
+    cc = start[1] + d[1]
+    count = 0
+    while 0 <= rr < h and 0 <= cc < w and comp_mask[rr, cc]:
+        count += 1
+        rr += d[0]
+        cc += d[1]
+    return count
+
+
+def _measure_side_thicknesses(comp_mask: np.ndarray, interior: np.ndarray) -> dict[tuple[int, int], int]:
+    samples = _side_samples(interior)
+    thicknesses: dict[tuple[int, int], int] = {}
+    for d, pts in samples.items():
+        runs = [_count_wall_run(comp_mask, p, d) for p in pts]
+        assert runs and min(runs) > 0, "expected each interior side to face wall"
+        thicknesses[d] = min(runs)
+    return thicknesses
+
+
+def _choose_radiate_dir(thicknesses: dict[tuple[int, int], int]) -> tuple[int, int]:
+    items = sorted(thicknesses.items(), key=lambda kv: kv[1])
+    assert len(items) == 4, "expected four side thicknesses"
+    assert items[0][1] < items[1][1], "expected a unique thinnest wall side"
+    return items[0][0]
+
+
+def _build_breach_beam_and_pipe(
+    comp_mask: np.ndarray,
+    interior: np.ndarray,
+    rad: tuple[int, int],
+) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
+    h, w = comp_mask.shape
+    breach = np.zeros_like(comp_mask, dtype=bool)
+    beam = np.zeros_like(comp_mask, dtype=bool)
+    pipe = np.zeros_like(comp_mask, dtype=bool)
+
+    rows, cols = np.where(interior)
+    top = int(rows.min())
+    bottom = int(rows.max())
+    left = int(cols.min())
+    right = int(cols.max())
+
+    if rad == (-1, 0):
+        assert top >= 2 and left >= 1 and right + 1 < w
+        breach[top - 1, left : right + 1] = True
+        beam[: top - 1, left : right + 1] = True
+        pipe[: top - 1, left - 1] = True
+        pipe[: top - 1, right + 1] = True
+    elif rad == (1, 0):
+        assert bottom + 2 < h and left >= 1 and right + 1 < w
+        breach[bottom + 1, left : right + 1] = True
+        beam[bottom + 2 :, left : right + 1] = True
+        pipe[bottom + 2 :, left - 1] = True
+        pipe[bottom + 2 :, right + 1] = True
+    elif rad == (0, -1):
+        assert left >= 2 and top >= 1 and bottom + 1 < h
+        breach[top : bottom + 1, left - 1] = True
+        beam[top : bottom + 1, : left - 1] = True
+        pipe[top - 1, : left - 1] = True
+        pipe[bottom + 1, : left - 1] = True
+    else:
+        assert right + 2 < w and top >= 1 and bottom + 1 < h
+        breach[top : bottom + 1, right + 1] = True
+        beam[top : bottom + 1, right + 2 :] = True
+        pipe[top - 1, right + 2 :] = True
+        pipe[bottom + 1, right + 2 :] = True
+
+    assert not np.any(pipe & (interior | breach | beam)), "pipe border must stay outside the fill corridor"
+    return breach, beam, pipe
+
+
+def _analyze_scene(grid: np.ndarray) -> dict:
+    g = np.array(grid, copy=False)
+    bg = get_bg(g)
+    vals = [int(v) for v in np.unique(g) if int(v) != bg]
+    assert vals, "expected at least one non-background color"
+
+    wall = max(vals, key=lambda c: int((g == c).sum()))
+    wall_mask = g == wall
+    comps = [set((int(r), int(c)) for r, c in pts) for pts in components_mask(wall_mask, connectivity=8)]
+    assert comps, "expected at least one wall connected component"
+
+    other_colors = [c for c in vals if c != wall]
+    assert other_colors, "expected at least one non-wall color"
+    wall_points = [p for comp in comps for p in comp]
+    fill = min(other_colors, key=lambda c: _min_dist_to_wall(g, c, wall_points))
+    fill_pos = [(int(r), int(c)) for r, c in zip(*np.where(g == fill))]
+    assert fill_pos, "expected at least one fill seed pixel"
+
+    def comp_min_dist(comp: set[tuple[int, int]]) -> int:
+        best = 10**9
+        for r, c in fill_pos:
+            for wr, wc in comp:
+                d = abs(r - wr) + abs(c - wc)
+                if d < best:
+                    best = d
+                    if best == 0:
+                        return 0
+        return best
+
+    wall_comp = min(comps, key=lambda comp: (comp_min_dist(comp), -len(comp)))
+    wall_comp = _trim_dead_ends(wall_comp)
+    assert wall_comp, "expected a closed core wall after trimming auxiliaries"
+
+    comp_mask = np.zeros_like(wall_mask, dtype=bool)
+    for r, c in wall_comp:
+        comp_mask[r, c] = True
+
+    interior_passable = (~comp_mask) & ((g == bg) | (g == fill))
+    interior = _seed_fill(interior_passable, fill_pos)
+    assert interior.any(), "expected seed to reach an enclosed interior"
+    assert not _touches_border(interior), "interior leaked to the border; input must stay sealed"
+
+    thicknesses = _measure_side_thicknesses(comp_mask, interior)
+    rad = _choose_radiate_dir(thicknesses)
+    breach, beam, pipe = _build_breach_beam_and_pipe(comp_mask, interior, rad)
+    assert breach.any() and pipe.any(), "expected both a breach and pipe extension"
+
+    return {
+        "grid": g,
+        "bg": int(bg),
+        "wall": int(wall),
+        "fill": int(fill),
+        "fill_pos": fill_pos,
+        "comp_mask": comp_mask,
+        "interior": interior,
+        "thicknesses": thicknesses,
+        "rad": rad,
+        "breach": breach,
+        "beam_mask": beam,
+        "pipe_mask": pipe,
+    }
+
+
+def _apply_obstacle_shadows(
+    out: np.ndarray,
+    filled_mask: np.ndarray,
+    obstacles: np.ndarray,
+    rad: tuple[int, int],
+) -> None:
+    def shadow_process(coords: list[tuple[int, int]]) -> None:
+        started = False
+        blocked = False
+        for r, c in coords:
+            if filled_mask[r, c]:
+                started = True
+            if started and obstacles[r, c]:
+                blocked = True
+                continue
+            if blocked and filled_mask[r, c]:
+                out[r, c] = 0
+                filled_mask[r, c] = False
+
+    h, w = out.shape
+    dr, dc = rad
+    if dr != 0:
+        for c in range(w):
+            rows = range(h) if dr > 0 else range(h - 1, -1, -1)
+            shadow_process([(r, c) for r in rows])
+    else:
+        for r in range(h):
+            cols = range(w) if dc > 0 else range(w - 1, -1, -1)
+            shadow_process([(r, c) for c in cols])
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Fill a sealed chamber, break through its uniquely thin wall, and extend the wall into a pipe around the outgoing beam.
+
+    Input structure:
+    - The background is the dominant color. The most common non-background color is a closed shell surrounding one cavity.
+    - A smaller non-wall color blob lies inside that cavity near the side opposite the eventual exit. One wall side is exactly 1 pixel thick while the other three sides are thicker; remaining non-background pixels are sparse obstacles.
+
+    Rule:
+    - Flood-fill the sealed cavity from the seed, identify the unique thinnest wall side, breach that strip, and continue the fill straight outward to the grid edge.
+    - Apply the usual obstacle-shadow rule to the outgoing fill, then recolor the two border lines flanking that outward beam as wall-color pipe extensions.
+
+    Key insight:
+    - The output direction is not revealed by an opening anymore. You must first infer the exit from comparative wall thickness, then reuse the shell shoulders next to that thin side to know where the new pipe borders appear.
+    """
+    info = _analyze_scene(np.array(grid, copy=True))
+    g = info["grid"]
+    bg = info["bg"]
+    wall = info["wall"]
+    fill = info["fill"]
+    fill_pos = info["fill_pos"]
+
+    domain = info["interior"] | info["breach"] | info["beam_mask"]
+    passable = domain & ((g == bg) | (g == fill) | info["breach"])
+    seen = _seed_fill(passable, fill_pos)
+
+    write_mask = seen & ((g == bg) | info["breach"])
+    out = g.copy()
+    out[write_mask] = fill
+
+    filled_mask = write_mask.copy()
+    obstacles = (g != bg) & (g != fill) & (g != wall)
+    _apply_obstacle_shadows(out, filled_mask, obstacles, info["rad"])
+
+    out[info["pipe_mask"]] = wall
+    return out
+
+
+def _combo_metrics(grid: np.ndarray) -> dict:
+    info = _analyze_scene(grid)
+    pipe_lengths = []
+    rad = info["rad"]
+    if rad == (-1, 0):
+        pipe_lengths = [int(np.count_nonzero(info["pipe_mask"][:, c])) for c in np.where(info["pipe_mask"].any(axis=0))[0]]
+    elif rad == (1, 0):
+        pipe_lengths = [int(np.count_nonzero(info["pipe_mask"][:, c])) for c in np.where(info["pipe_mask"].any(axis=0))[0]]
+    else:
+        pipe_lengths = [int(np.count_nonzero(info["pipe_mask"][r, :])) for r in np.where(info["pipe_mask"].any(axis=1))[0]]
+    return {
+        "rad": rad,
+        "thin_thickness": int(info["thicknesses"][rad]),
+        "other_thicknesses": tuple(int(v) for d, v in info["thicknesses"].items() if d != rad),
+        "breach_cells": int(info["breach"].sum()),
+        "beam_cells": int(info["beam_mask"].sum()),
+        "pipe_cells": int(info["pipe_mask"].sum()),
+        "pipe_lengths": tuple(pipe_lengths),
+    }
+
+
+def _grow_seed_blob(seed: tuple[int, int], interior_cells: set[tuple[int, int]]) -> set[tuple[int, int]]:
+    blob = {seed}
+    frontier = [seed]
+    target_size = random.choice(SEED_SIZE_WEIGHTS)
+    while len(blob) < target_size and frontier:
+        r, c = frontier.pop(random.randrange(len(frontier)))
+        nbrs = [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+        for q in random.sample(nbrs, len(nbrs)):
+            if q in interior_cells and q not in blob:
+                blob.add(q)
+                frontier.append(q)
+                if len(blob) >= target_size:
+                    break
+    return blob
+
+
+def _obstacle_fits(pos: tuple[int, int], placed: list[tuple[int, int]]) -> bool:
+    r, c = pos
+    return all(max(abs(r - rr), abs(c - cc)) >= OBSTACLE_MIN_SEP for rr, cc in placed)
+
+
+def _choose_thicknesses(rad: tuple[int, int]) -> dict[str, int]:
+    top = random.randint(*THICK_OTHER)
+    bottom = random.randint(*THICK_OTHER)
+    left = random.randint(*THICK_OTHER)
+    right = random.randint(*THICK_OTHER)
+    if rad == (-1, 0):
+        top = 1
+    elif rad == (1, 0):
+        bottom = 1
+    elif rad == (0, -1):
+        left = 1
+    else:
+        right = 1
+    return {"top": top, "bottom": bottom, "left": left, "right": right}
+
+
+def _choose_inner_dims(rad: tuple[int, int], h: int, w: int, t: dict[str, int]) -> tuple[int, int] | None:
+    if rad[0]:
+        hs = list(range(INNER_H_VERT[0], INNER_H_VERT[1] + 1))
+        ws = list(range(INNER_W_VERT[0], INNER_W_VERT[1] + 1))
+    else:
+        hs = list(range(INNER_H_HORIZ[0], INNER_H_HORIZ[1] + 1))
+        ws = list(range(INNER_W_HORIZ[0], INNER_W_HORIZ[1] + 1))
+    random.shuffle(hs)
+    random.shuffle(ws)
+    for inner_h in hs:
+        for inner_w in ws:
+            outer_h = t["top"] + inner_h + t["bottom"]
+            outer_w = t["left"] + inner_w + t["right"]
+            if outer_h + FAR_SIDE_MARGIN <= h and outer_w + SIDE_MARGIN * 2 <= w:
+                if rad[0]:
+                    if outer_h + OPEN_END_MARGIN + FAR_SIDE_MARGIN <= h:
+                        return inner_h, inner_w
+                else:
+                    if outer_w + OPEN_END_MARGIN + FAR_SIDE_MARGIN <= w:
+                        return inner_h, inner_w
+    return None
+
+
+def _place_outer_box(
+    rad: tuple[int, int],
+    h: int,
+    w: int,
+    outer_h: int,
+    outer_w: int,
+) -> tuple[int, int]:
+    if rad == (-1, 0):
+        r0 = random.randint(OPEN_END_MARGIN, h - outer_h - FAR_SIDE_MARGIN)
+        c0 = random.randint(SIDE_MARGIN, w - outer_w - SIDE_MARGIN)
+    elif rad == (1, 0):
+        r0 = random.randint(FAR_SIDE_MARGIN, h - outer_h - OPEN_END_MARGIN)
+        c0 = random.randint(SIDE_MARGIN, w - outer_w - SIDE_MARGIN)
+    elif rad == (0, -1):
+        r0 = random.randint(SIDE_MARGIN, h - outer_h - SIDE_MARGIN)
+        c0 = random.randint(OPEN_END_MARGIN, w - outer_w - FAR_SIDE_MARGIN)
+    else:
+        r0 = random.randint(SIDE_MARGIN, h - outer_h - SIDE_MARGIN)
+        c0 = random.randint(FAR_SIDE_MARGIN, w - outer_w - OPEN_END_MARGIN)
+    return r0, c0
+
+
+def _render_shell(
+    grid: np.ndarray,
+    r0: int,
+    c0: int,
+    inner_h: int,
+    inner_w: int,
+    t: dict[str, int],
+    wall_color: int,
+) -> tuple[np.ndarray, np.ndarray]:
+    outer_h = t["top"] + inner_h + t["bottom"]
+    outer_w = t["left"] + inner_w + t["right"]
+    grid[r0 : r0 + outer_h, c0 : c0 + outer_w] = wall_color
+
+    ir0 = r0 + t["top"]
+    ic0 = c0 + t["left"]
+    interior = np.zeros_like(grid, dtype=bool)
+    interior[ir0 : ir0 + inner_h, ic0 : ic0 + inner_w] = True
+    grid[interior] = get_bg(grid)
+
+    wall_mask = np.zeros_like(grid, dtype=bool)
+    wall_mask[r0 : r0 + outer_h, c0 : c0 + outer_w] = True
+    wall_mask[interior] = False
+    return wall_mask, interior
+
+
+def _seed_pool(interior: np.ndarray, rad: tuple[int, int]) -> list[tuple[int, int]]:
+    rows, cols = np.where(interior)
+    top = int(rows.min())
+    bottom = int(rows.max())
+    left = int(cols.min())
+    right = int(cols.max())
+    pool = []
+    for r, c in zip(rows, cols):
+        rr = int(r)
+        cc = int(c)
+        if rad == (-1, 0):
+            if rr >= bottom - SEED_DEPTH_LOOKBACK:
+                pool.append((rr, cc))
+        elif rad == (1, 0):
+            if rr <= top + SEED_DEPTH_LOOKBACK:
+                pool.append((rr, cc))
+        elif rad == (0, -1):
+            if cc >= right - SEED_DEPTH_LOOKBACK:
+                pool.append((rr, cc))
+        else:
+            if cc <= left + SEED_DEPTH_LOOKBACK:
+                pool.append((rr, cc))
+    return pool
+
+
+def _find_obstacle_candidates(
+    grid: np.ndarray,
+    bg: int,
+    wall_color: int,
+    nominal_fill_zone: np.ndarray,
+    exterior_bg: np.ndarray,
+    forbidden_mask: np.ndarray,
+) -> tuple[list[tuple[int, int]], list[tuple[int, int]]]:
+    wall_mask = grid == wall_color
+    dist = distance_transform_cdt(~wall_mask, metric="taxicab")
+    eligible = exterior_bg & (grid == bg) & (dist > 1) & (~forbidden_mask)
+    all_coords = [(int(r), int(c)) for r, c in zip(*np.where(eligible))]
+    fill_coords = [p for p in all_coords if nominal_fill_zone[p[0], p[1]]]
+    random.shuffle(all_coords)
+    random.shuffle(fill_coords)
+    return all_coords, fill_coords
+
+
+def _place_obstacles(
+    n_obstacles: int,
+    candidates: list[tuple[int, int]],
+    fill_candidates: list[tuple[int, int]],
+    obstacle_colors: list[int],
+    grid: np.ndarray,
+) -> None:
+    placed: list[tuple[int, int]] = []
+    n_fill = random.randint(0, min(n_obstacles, len(fill_candidates)))
+    if fill_candidates and random.random() < OBSTACLE_IN_FILL_PROB:
+        n_fill = max(1, n_fill)
+    for p in fill_candidates:
+        if len(placed) >= n_fill:
+            break
+        if _obstacle_fits(p, placed):
+            placed.append(p)
+    placed_set = set(placed)
+    for p in candidates:
+        if len(placed) >= n_obstacles:
+            break
+        if p not in placed_set and _obstacle_fits(p, placed):
+            placed.append(p)
+            placed_set.add(p)
+    for i, (r, c) in enumerate(placed):
+        grid[r, c] = obstacle_colors[i % len(obstacle_colors)]
+
+
+def _gen_attempt() -> np.ndarray | None:
+    rad = random.choice([(-1, 0), (1, 0), (0, -1), (0, 1)])
+    h = random.randint(*GRID_H_VERT) if rad[0] else random.randint(*GRID_H_HORIZ)
+    w = random.randint(*GRID_W)
+
+    t = _choose_thicknesses(rad)
+    dims = _choose_inner_dims(rad, h, w, t)
+    if dims is None:
+        return None
+    inner_h, inner_w = dims
+    outer_h = t["top"] + inner_h + t["bottom"]
+    outer_w = t["left"] + inner_w + t["right"]
+    r0, c0 = _place_outer_box(rad, h, w, outer_h, outer_w)
+
+    palette = random.sample(range(10), random.randint(*PALETTE_SIZE))
+    bg, wall_color, fill_color = palette[:3]
+    obstacle_colors = palette[3:]
+
+    grid = np.full((h, w), bg, dtype=int)
+    wall_mask, interior = _render_shell(grid, r0, c0, inner_h, inner_w, t, wall_color)
+
+    pool = _seed_pool(interior, rad)
+    if not pool:
+        return None
+    interior_cells = {tuple(map(int, p)) for p in zip(*np.where(interior))}
+    blob = _grow_seed_blob(random.choice(pool), interior_cells)
+    for r, c in blob:
+        if grid[r, c] != bg:
+            return None
+        grid[r, c] = fill_color
+
+    try:
+        info = _analyze_scene(grid)
+        nominal_out = main(grid)
+    except Exception:
+        return None
+
+    nominal_fill_zone = (nominal_out == fill_color) & (grid == bg)
+    exterior_bg = (~interior) & (~wall_mask) & (grid == bg)
+
+    n_obstacles = random.randint(0, MAX_OBSTACLES)
+    if n_obstacles and not obstacle_colors:
+        available = [c for c in range(10) if c not in (bg, wall_color, fill_color)]
+        obstacle_colors = random.sample(available, random.randint(1, 2))
+    if n_obstacles:
+        candidates, fill_candidates = _find_obstacle_candidates(
+            grid,
+            bg,
+            wall_color,
+            nominal_fill_zone,
+            exterior_bg,
+            info["pipe_mask"],
+        )
+        _place_obstacles(n_obstacles, candidates, fill_candidates, obstacle_colors, grid)
+
+    try:
+        info = _analyze_scene(grid)
+        metrics = _combo_metrics(grid)
+        out = main(grid)
+    except Exception:
+        return None
+
+    new_fill = (out == fill_color) & (grid == bg)
+    new_wall = (out == wall_color) & (grid == bg)
+
+    if int(new_fill.sum()) < MIN_NEW_FILL or not _touches_border(new_fill):
+        return None
+    if metrics["thin_thickness"] != 1 or not all(v >= 2 for v in metrics["other_thicknesses"]):
+        return None
+    if int(new_wall.sum()) < MIN_PIPE_CELLS or metrics["pipe_cells"] < MIN_PIPE_CELLS:
+        return None
+    if not metrics["pipe_lengths"] or min(metrics["pipe_lengths"]) < MIN_PIPE_LEN:
+        return None
+    if int((new_fill & info["beam_mask"]).sum()) < MIN_BEAM_FILL:
+        return None
+    if np.any((grid != bg) & info["pipe_mask"]):
+        return None
+    if not np.all(out[info["pipe_mask"]] == wall_color):
+        return None
+    if not np.all(out[info["breach"]] == fill_color):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate valid b9e38dc0 combo input")

diff --git a/ceshi/code_combo/b9e38dc0/9/code.py b/ceshi/code_combo/b9e38dc0/9/code.py
new file mode 100644
index 0000000000000000000000000000000000000000..a333601290313a8b723cac984e9233e8863bc36d
--- /dev/null
+++ b/ceshi/code_combo/b9e38dc0/9/code.py
@@ -0,0 +1,677 @@
+# Combo variant of b9e38dc0 (index 9)
+# combo_spec: D6/3+D8/2
+# Name: 薄壁突破+边框延伸管道
+
+import random
+
+import numpy as np
+from scipy.ndimage import distance_transform_cdt
+
+from arc_utils import components_mask, get_bg, neighbors4
+
+# ---------------------------------------------------------------------------
+# Design analysis for the combo variant
+#
+# a) Concrete behavior and trace:
+#    - The base task used an open funnel: the opening itself revealed the
+#      outward direction, and the outward corridor was only implicit.
+#    - This combo removes the visible opening. The wall becomes a sealed
+#      rectangular shell around one cavity. Exactly one of the four sides is
+#      1-pixel thick; the other three sides are 2-3 pixels thick.
+#    - The fill seed still sits inside the cavity near the side opposite the
+#      future exit. The solver must first recover the whole cavity by flood-fill
+#      from the seed, then compare the four side thicknesses, then choose the
+#      unique thinnest side as the break direction.
+#    - After the break, the fill travels outward as a straight rectangular beam.
+#      The D8 part changes what becomes visible there: two wall-colored border
+#      lines are extended alongside the beam so the beam is wrapped inside a
+#      pipe instead of floating in open background.
+#    - Small trace:
+#      original: open U facing up -> endpoints say "up" -> fill climbs out.
+#      combo: closed shell with top thickness 1 and other sides thickness 2-3
+#      -> fill floods cavity -> top wall strip is breached -> fill rises in a
+#      rectangle -> two vertical wall lines appear on the left/right edges of
+#      that rectangle, so the outgoing ray becomes a pipe.
+#
+# b) Complexity calibration:
+#    - The combo keeps only four directional cases, one per cardinal side.
+#    - The thin-wall signal is repeated across an entire side, not a single
+#      pixel cue, which makes the comparison visually robust.
+#    - The pipe extension is also repeated twice per sample as a matched pair of
+#      parallel border lines; this is strong enough for human inference without
+#      introducing many categories or special cases.
+#
+# c) Hidden assumptions that changed:
+#    - Endpoint detection from the original solver no longer applies because the
+#      main wall is a loop, not an open chain.
+#    - Reachability cannot start from an already open corridor; the cavity must
+#      stay sealed in the input and be reconstructed from the seed.
+#    - The outward geometry is no longer just fill. Some output cells that were
+#      background in the input must become wall-color pipe borders.
+#    - Obstacle placement must avoid those future pipe-border cells, otherwise
+#      preserved obstacles would clash with newly painted wall extensions.
+#
+# d) Placement legality enforced by the generator:
+#    - The shell is an axis-aligned ring, so it is always in-bounds and
+#      non-self-intersecting.
+#    - The thin side always faces at least 3 cells of outside margin, ensuring a
+#      visible beam and a visible pipe extension.
+#    - The perpendicular sides are always thickness >= 2, which guarantees that
+#      there are shoulder cells from which the pipe borders can extend.
+#    - Obstacles are placed only on exterior background cells and are forbidden
+#      from future pipe-border cells.
+#
+# e) Visual observability:
+#    - A human can compare the four side thicknesses directly in the input and
+#      identify the only breakable side without using color ids.
+#    - The output visibly differs from the plain thin-wall variant because the
+#      radiating fill is flanked by new wall-colored lines, not just by empty
+#      background.
+#
+# f) Visual cleanliness:
+#    - There are only four active visual roles: shell wall, fill, sparse
+#      obstacles, and the pipe-border continuation of the same wall color.
+#    - Obstacles stay out of the cavity and off the pipe walls, so the output
+#      does not stack multiple semantics on the same cells.
+#
+# g) Inferability of changes:
+#    - No hidden ordering over palette ids is used. The fill color is still the
+#      non-wall color nearest to the wall in Manhattan distance.
+#    - The generator validates that every sample creates both a filled breach
+#      path and a nonzero set of new wall-colored pipe cells, so the combo does
+#      not collapse back to the D6-only behavior.
+# ---------------------------------------------------------------------------
+
+# Canvas size bounds
+GRID_H_VERT = (11, 18)
+GRID_H_HORIZ = (8, 18)
+GRID_W = (15, 19)
+
+# Shell geometry
+INNER_H_VERT = (3, 6)
+INNER_W_VERT = (5, 8)
+INNER_H_HORIZ = (4, 7)
+INNER_W_HORIZ = (3, 6)
+THICK_OTHER = (2, 3)
+
+# Placement margins
+OPEN_END_MARGIN = 3
+FAR_SIDE_MARGIN = 2
+SIDE_MARGIN = 1
+
+# Fill seed
+SEED_SIZE_WEIGHTS = [1, 1, 1, 1, 2, 2, 3, 4, 5, 6]
+SEED_DEPTH_LOOKBACK = 2
+
+# Obstacles
+MAX_OBSTACLES = 5
+OBSTACLE_IN_FILL_PROB = 0.65
+OBSTACLE_MIN_SEP = 2
+
+# Validation
+MIN_NEW_FILL = 20
+MIN_PIPE_LEN = 3
+MIN_PIPE_CELLS = 6
+MIN_BEAM_FILL = 8
+PALETTE_SIZE = (3, 5)
+GEN_RETRIES = 500
+
+
+def _touches_border(mask: np.ndarray) -> bool:
+    return bool(mask[0, :].any() or mask[-1, :].any() or mask[:, 0].any() or mask[:, -1].any())
+
+
+def _seed_fill(mask: np.ndarray, starts: list[tuple[int, int]]) -> np.ndarray:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    q: list[tuple[int, int]] = []
+    for r, c in starts:
+        if 0 <= r < h and 0 <= c < w and mask[r, c] and not seen[r, c]:
+            seen[r, c] = True
+            q.append((r, c))
+    while q:
+        r, c = q.pop()
+        for rr, cc in neighbors4(r, c):
+            if 0 <= rr < h and 0 <= cc < w and mask[rr, cc] and not seen[rr, cc]:
+                seen[rr, cc] = True
+                q.append((rr, cc))
+    return seen
+
+
+def _trim_dead_ends(points: set[tuple[int, int]]) -> set[tuple[int, int]]:
+    pts = set(points)
+    changed = True
+    while changed:
+        changed = False
+        drop = {
+            (r, c)
+            for r, c in pts
+            if sum((rr, cc) in pts for rr, cc in neighbors4(r, c)) <= 1
+        }
+        if drop and len(drop) < len(pts):
+            pts -= drop
+            changed = True
+    return pts
+
+
+def _min_dist_to_wall(grid: np.ndarray, color: int, wall_points: list[tuple[int, int]]) -> tuple[int, int]:
+    pts = [(int(r), int(c)) for r, c in zip(*np.where(grid == color))]
+    best_d = 10**9
+    for r, c in pts:
+        for wr, wc in wall_points:
+            d = abs(r - wr) + abs(c - wc)
+            if d < best_d:
+                best_d = d
+                if best_d == 0:
+                    return 0, len(pts)
+    return best_d, len(pts)
+
+
+def _side_samples(interior: np.ndarray) -> dict[tuple[int, int], list[tuple[int, int]]]:
+    rows, cols = np.where(interior)
+    top = int(rows.min())
+    bottom = int(rows.max())
+    left = int(cols.min())
+    right = int(cols.max())
+    return {
+        (-1, 0): [(top, c) for c in range(left, right + 1) if interior[top, c]],
+        (1, 0): [(bottom, c) for c in range(left, right + 1) if interior[bottom, c]],
+        (0, -1): [(r, left) for r in range(top, bottom + 1) if interior[r, left]],
+        (0, 1): [(r, right) for r in range(top, bottom + 1) if interior[r, right]],
+    }
+
+
+def _count_wall_run(comp_mask: np.ndarray, start: tuple[int, int], d: tuple[int, int]) -> int:
+    h, w = comp_mask.shape
+    rr = start[0] + d[0]
+    cc = start[1] + d[1]
+    count = 0
+    while 0 <= rr < h and 0 <= cc < w and comp_mask[rr, cc]:
+        count += 1
+        rr += d[0]
+        cc += d[1]
+    return count
+
+
+def _measure_side_thicknesses(comp_mask: np.ndarray, interior: np.ndarray) -> dict[tuple[int, int], int]:
+    samples = _side_samples(interior)
+    thicknesses: dict[tuple[int, int], int] = {}
+    for d, pts in samples.items():
+        runs = [_count_wall_run(comp_mask, p, d) for p in pts]
+        assert runs and min(runs) > 0, "expected each interior side to face wall"
+        thicknesses[d] = min(runs)
+    return thicknesses
+
+
+def _choose_radiate_dir(thicknesses: dict[tuple[int, int], int]) -> tuple[int, int]:
+    items = sorted(thicknesses.items(), key=lambda kv: kv[1])
+    assert len(items) == 4, "expected four side thicknesses"
+    assert items[0][1] < items[1][1], "expected a unique thinnest wall side"
+    return items[0][0]
+
+
+def _build_breach_beam_and_pipe(
+    comp_mask: np.ndarray,
+    interior: np.ndarray,
+    rad: tuple[int, int],
+) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
+    h, w = comp_mask.shape
+    breach = np.zeros_like(comp_mask, dtype=bool)
+    beam = np.zeros_like(comp_mask, dtype=bool)
+    pipe = np.zeros_like(comp_mask, dtype=bool)
+
+    rows, cols = np.where(interior)
+    top = int(rows.min())
+    bottom = int(rows.max())
+    left = int(cols.min())
+    right = int(cols.max())
+
+    if rad == (-1, 0):
+        assert top >= 2 and left >= 1 and right + 1 < w
+        breach[top - 1, left : right + 1] = True
+        beam[: top - 1, left : right + 1] = True
+        pipe[: top - 1, left - 1] = True
+        pipe[: top - 1, right + 1] = True
+    elif rad == (1, 0):
+        assert bottom + 2 < h and left >= 1 and right + 1 < w
+        breach[bottom + 1, left : right + 1] = True
+        beam[bottom + 2 :, left : right + 1] = True
+        pipe[bottom + 2 :, left - 1] = True
+        pipe[bottom + 2 :, right + 1] = True
+    elif rad == (0, -1):
+        assert left >= 2 and top >= 1 and bottom + 1 < h
+        breach[top : bottom + 1, left - 1] = True
+        beam[top : bottom + 1, : left - 1] = True
+        pipe[top - 1, : left - 1] = True
+        pipe[bottom + 1, : left - 1] = True
+    else:
+        assert right + 2 < w and top >= 1 and bottom + 1 < h
+        breach[top : bottom + 1, right + 1] = True
+        beam[top : bottom + 1, right + 2 :] = True
+        pipe[top - 1, right + 2 :] = True
+        pipe[bottom + 1, right + 2 :] = True
+
+    assert not np.any(pipe & (interior | breach | beam)), "pipe border must stay outside the fill corridor"
+    return breach, beam, pipe
+
+
+def _analyze_scene(grid: np.ndarray) -> dict:
+    g = np.array(grid, copy=False)
+    bg = get_bg(g)
+    vals = [int(v) for v in np.unique(g) if int(v) != bg]
+    assert vals, "expected at least one non-background color"
+
+    wall = max(vals, key=lambda c: int((g == c).sum()))
+    wall_mask = g == wall
+    comps = [set((int(r), int(c)) for r, c in pts) for pts in components_mask(wall_mask, connectivity=8)]
+    assert comps, "expected at least one wall connected component"
+
+    other_colors = [c for c in vals if c != wall]
+    assert other_colors, "expected at least one non-wall color"
+    wall_points = [p for comp in comps for p in comp]
+    fill = min(other_colors, key=lambda c: _min_dist_to_wall(g, c, wall_points))
+    fill_pos = [(int(r), int(c)) for r, c in zip(*np.where(g == fill))]
+    assert fill_pos, "expected at least one fill seed pixel"
+
+    def comp_min_dist(comp: set[tuple[int, int]]) -> int:
+        best = 10**9
+        for r, c in fill_pos:
+            for wr, wc in comp:
+                d = abs(r - wr) + abs(c - wc)
+                if d < best:
+                    best = d
+                    if best == 0:
+                        return 0
+        return best
+
+    wall_comp = min(comps, key=lambda comp: (comp_min_dist(comp), -len(comp)))
+    wall_comp = _trim_dead_ends(wall_comp)
+    assert wall_comp, "expected a closed core wall after trimming auxiliaries"
+
+    comp_mask = np.zeros_like(wall_mask, dtype=bool)
+    for r, c in wall_comp:
+        comp_mask[r, c] = True
+
+    interior_passable = (~comp_mask) & ((g == bg) | (g == fill))
+    interior = _seed_fill(interior_passable, fill_pos)
+    assert interior.any(), "expected seed to reach an enclosed interior"
+    assert not _touches_border(interior), "interior leaked to the border; input must stay sealed"
+
+    thicknesses = _measure_side_thicknesses(comp_mask, interior)
+    rad = _choose_radiate_dir(thicknesses)
+    breach, beam, pipe = _build_breach_beam_and_pipe(comp_mask, interior, rad)
+    assert breach.any() and pipe.any(), "expected both a breach and pipe extension"
+
+    return {
+        "grid": g,
+        "bg": int(bg),
+        "wall": int(wall),
+        "fill": int(fill),
+        "fill_pos": fill_pos,
+        "comp_mask": comp_mask,
+        "interior": interior,
+        "thicknesses": thicknesses,
+        "rad": rad,
+        "breach": breach,
+        "beam_mask": beam,
+        "pipe_mask": pipe,
+    }
+
+
+def _apply_obstacle_shadows(
+    out: np.ndarray,
+    filled_mask: np.ndarray,
+    obstacles: np.ndarray,
+    rad: tuple[int, int],
+) -> None:
+    def shadow_process(coords: list[tuple[int, int]]) -> None:
+        started = False
+        blocked = False
+        for r, c in coords:
+            if filled_mask[r, c]:
+                started = True
+            if started and obstacles[r, c]:
+                blocked = True
+                continue
+            if blocked and filled_mask[r, c]:
+                out[r, c] = 0
+                filled_mask[r, c] = False
+
+    h, w = out.shape
+    dr, dc = rad
+    if dr != 0:
+        for c in range(w):
+            rows = range(h) if dr > 0 else range(h - 1, -1, -1)
+            shadow_process([(r, c) for r in rows])
+    else:
+        for r in range(h):
+            cols = range(w) if dc > 0 else range(w - 1, -1, -1)
+            shadow_process([(r, c) for c in cols])
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Fill a sealed chamber, break through its uniquely thin wall, and extend the wall into a pipe around the outgoing beam.
+
+    Input structure:
+    - The background is the dominant color. The most common non-background color is a closed shell surrounding one cavity.
+    - A smaller non-wall color blob lies inside that cavity near the side opposite the eventual exit. One wall side is exactly 1 pixel thick while the other three sides are thicker; remaining non-background pixels are sparse obstacles.
+
+    Rule:
+    - Flood-fill the sealed cavity from the seed, identify the unique thinnest wall side, breach that strip, and continue the fill straight outward to the grid edge.
+    - Apply the usual obstacle-shadow rule to the outgoing fill, then recolor the two border lines flanking that outward beam as wall-color pipe extensions.
+
+    Key insight:
+    - The output direction is not revealed by an opening anymore. You must first infer the exit from comparative wall thickness, then reuse the shell shoulders next to that thin side to know where the new pipe borders appear.
+    """
+    info = _analyze_scene(np.array(grid, copy=True))
+    g = info["grid"]
+    bg = info["bg"]
+    wall = info["wall"]
+    fill = info["fill"]
+    fill_pos = info["fill_pos"]
+
+    domain = info["interior"] | info["breach"] | info["beam_mask"]
+    passable = domain & ((g == bg) | (g == fill) | info["breach"])
+    seen = _seed_fill(passable, fill_pos)
+
+    write_mask = seen & ((g == bg) | info["breach"])
+    out = g.copy()
+    out[write_mask] = fill
+
+    filled_mask = write_mask.copy()
+    obstacles = (g != bg) & (g != fill) & (g != wall)
+    _apply_obstacle_shadows(out, filled_mask, obstacles, info["rad"])
+
+    out[info["pipe_mask"]] = wall
+    return out
+
+
+def _combo_metrics(grid: np.ndarray) -> dict:
+    info = _analyze_scene(grid)
+    pipe_lengths = []
+    rad = info["rad"]
+    if rad == (-1, 0):
+        pipe_lengths = [int(np.count_nonzero(info["pipe_mask"][:, c])) for c in np.where(info["pipe_mask"].any(axis=0))[0]]
+    elif rad == (1, 0):
+        pipe_lengths = [int(np.count_nonzero(info["pipe_mask"][:, c])) for c in np.where(info["pipe_mask"].any(axis=0))[0]]
+    else:
+        pipe_lengths = [int(np.count_nonzero(info["pipe_mask"][r, :])) for r in np.where(info["pipe_mask"].any(axis=1))[0]]
+    return {
+        "rad": rad,
+        "thin_thickness": int(info["thicknesses"][rad]),
+        "other_thicknesses": tuple(int(v) for d, v in info["thicknesses"].items() if d != rad),
+        "breach_cells": int(info["breach"].sum()),
+        "beam_cells": int(info["beam_mask"].sum()),
+        "pipe_cells": int(info["pipe_mask"].sum()),
+        "pipe_lengths": tuple(pipe_lengths),
+    }
+
+
+def _grow_seed_blob(seed: tuple[int, int], interior_cells: set[tuple[int, int]]) -> set[tuple[int, int]]:
+    blob = {seed}
+    frontier = [seed]
+    target_size = random.choice(SEED_SIZE_WEIGHTS)
+    while len(blob) < target_size and frontier:
+        r, c = frontier.pop(random.randrange(len(frontier)))
+        nbrs = [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+        for q in random.sample(nbrs, len(nbrs)):
+            if q in interior_cells and q not in blob:
+                blob.add(q)
+                frontier.append(q)
+                if len(blob) >= target_size:
+                    break
+    return blob
+
+
+def _obstacle_fits(pos: tuple[int, int], placed: list[tuple[int, int]]) -> bool:
+    r, c = pos
+    return all(max(abs(r - rr), abs(c - cc)) >= OBSTACLE_MIN_SEP for rr, cc in placed)
+
+
+def _choose_thicknesses(rad: tuple[int, int]) -> dict[str, int]:
+    top = random.randint(*THICK_OTHER)
+    bottom = random.randint(*THICK_OTHER)
+    left = random.randint(*THICK_OTHER)
+    right = random.randint(*THICK_OTHER)
+    if rad == (-1, 0):
+        top = 1
+    elif rad == (1, 0):
+        bottom = 1
+    elif rad == (0, -1):
+        left = 1
+    else:
+        right = 1
+    return {"top": top, "bottom": bottom, "left": left, "right": right}
+
+
+def _choose_inner_dims(rad: tuple[int, int], h: int, w: int, t: dict[str, int]) -> tuple[int, int] | None:
+    if rad[0]:
+        hs = list(range(INNER_H_VERT[0], INNER_H_VERT[1] + 1))
+        ws = list(range(INNER_W_VERT[0], INNER_W_VERT[1] + 1))
+    else:
+        hs = list(range(INNER_H_HORIZ[0], INNER_H_HORIZ[1] + 1))
+        ws = list(range(INNER_W_HORIZ[0], INNER_W_HORIZ[1] + 1))
+    random.shuffle(hs)
+    random.shuffle(ws)
+    for inner_h in hs:
+        for inner_w in ws:
+            outer_h = t["top"] + inner_h + t["bottom"]
+            outer_w = t["left"] + inner_w + t["right"]
+            if outer_h + FAR_SIDE_MARGIN <= h and outer_w + SIDE_MARGIN * 2 <= w:
+                if rad[0]:
+                    if outer_h + OPEN_END_MARGIN + FAR_SIDE_MARGIN <= h:
+                        return inner_h, inner_w
+                else:
+                    if outer_w + OPEN_END_MARGIN + FAR_SIDE_MARGIN <= w:
+                        return inner_h, inner_w
+    return None
+
+
+def _place_outer_box(
+    rad: tuple[int, int],
+    h: int,
+    w: int,
+    outer_h: int,
+    outer_w: int,
+) -> tuple[int, int]:
+    if rad == (-1, 0):
+        r0 = random.randint(OPEN_END_MARGIN, h - outer_h - FAR_SIDE_MARGIN)
+        c0 = random.randint(SIDE_MARGIN, w - outer_w - SIDE_MARGIN)
+    elif rad == (1, 0):
+        r0 = random.randint(FAR_SIDE_MARGIN, h - outer_h - OPEN_END_MARGIN)
+        c0 = random.randint(SIDE_MARGIN, w - outer_w - SIDE_MARGIN)
+    elif rad == (0, -1):
+        r0 = random.randint(SIDE_MARGIN, h - outer_h - SIDE_MARGIN)
+        c0 = random.randint(OPEN_END_MARGIN, w - outer_w - FAR_SIDE_MARGIN)
+    else:
+        r0 = random.randint(SIDE_MARGIN, h - outer_h - SIDE_MARGIN)
+        c0 = random.randint(FAR_SIDE_MARGIN, w - outer_w - OPEN_END_MARGIN)
+    return r0, c0
+
+
+def _render_shell(
+    grid: np.ndarray,
+    r0: int,
+    c0: int,
+    inner_h: int,
+    inner_w: int,
+    t: dict[str, int],
+    wall_color: int,
+) -> tuple[np.ndarray, np.ndarray]:
+    outer_h = t["top"] + inner_h + t["bottom"]
+    outer_w = t["left"] + inner_w + t["right"]
+    grid[r0 : r0 + outer_h, c0 : c0 + outer_w] = wall_color
+
+    ir0 = r0 + t["top"]
+    ic0 = c0 + t["left"]
+    interior = np.zeros_like(grid, dtype=bool)
