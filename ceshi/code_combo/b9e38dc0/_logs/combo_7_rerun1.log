+# Combo variant of b9e38dc0 (index 7)
+# combo_spec: D2/1+D5/0
+# Name: 碰撞停止+辐射碰精灵停止
+
+from __future__ import annotations
+
+from pathlib import Path
+import random
+import sys
+
+import numpy as np
+from scipy.ndimage import distance_transform_cdt
+
+_SOLVER_DIR = Path("/home/lixinyu/snap/new/solvers")
+if str(_SOLVER_DIR) not in sys.path:
+    sys.path.append(str(_SOLVER_DIR))
+
+from arc_utils import components_mask, get_bg, neighbors4, neighbors8
+
+
+# Design analysis for the combo variant (D2/1 + D5/0).
+# a) Concrete behavior:
+#    The fused scene shows two separate wall sprites of the same color. The seed-bearing wall is
+#    the active funnel; a translated copy sits farther along the opening direction and acts as the
+#    visible collision target. Small isolated non-wall pixels are movers placed inside the corridor
+#    that the fill would normally occupy.
+#    - Original code path:
+#      1. Choose the wall component nearest the seed.
+#      2. Flood-fill its interior and extend the wedge to the grid edge.
+#      3. Keep extra non-wall pixels static (or treat them like obstacles in the old generator).
+#    - Fused path:
+#      1. Still choose the wall component nearest the seed as the active funnel.
+#      2. Trace each endpoint ray step by step; if the next ray cell belongs to another wall
+#         sprite, stop immediately before that wall instead of running to the border.
+#      3. Treat every remaining singleton color as a mover. It travels straight in the same
+#         radiate direction and stops at the last free cell before the first wall sprite on that
+#         line, clearing its entire traversed trail back to background.
+#    Example: with `rad = up`, the original wedge and mover both continue toward row 0. In the
+#    fused task, if a second wall sprite sits four rows above the opening, both endpoint rays stop
+#    against that sprite and a mover in the corridor also stops four steps earlier, leaving a
+#    background tunnel inside the otherwise filled wedge. The same object-to-object gap controls
+#    both effects.
+# b) Complexity calibration:
+#    The change is deliberately narrow: only one extra wall sprite and 2-4 singleton movers are
+#    added. There are no color remaps, no multiple stop types, and no reflection/detour behavior.
+#    To keep the fusion visible, the generator rejects samples where the blocker does not shorten
+#    the wedge, where movers would still end at the border, or where the fused output matches the
+#    D5-only / D2-only baselines.
+# c) Implicit assumptions audited:
+#    - Old assumption: endpoint rays stop only on out-of-bounds. Broken by D5/0; ray tracing must
+#      check another wall sprite before stepping.
+#    - Old assumption: extra non-wall colors are impassable obstacles. Broken by the mover branch:
+#      stage-1 fill must treat mover cells as transparent so the later trail-clearing is visible.
+#    - Old assumption: output depends only on one wall component. Broken by the combo; the active
+#      component is still the one nearest the seed, but another same-colored component now changes
+#      both the wedge extent and mover displacement.
+#    - New assumption: mover starts are not the fill seed color and stay farther from the wall than
+#      the seed blob. The generator enforces that so `fill = non-wall color closest to wall` stays
+#      correct.
+# d) Placement legality:
+#    The blocker is a translated copy of the active wall placed along the radiate direction with a
+#    bounded offset. The generator verifies that the copied sprite remains in-bounds, forms exactly
+#    two wall components with the active sprite, and that both endpoint rays collide with it.
+#    Movers are chosen only from cells inside the fused nominal fill zone, with disjoint trails and
+#    distinct stopping sites.
+# e) Visual observability:
+#    Humans can read both clues directly from geometry: the second wall visibly truncates the wedge,
+#    and the movers stop at that same wall rather than at the border. At least two movers per sample
+#    exhibit a shorter collision-stop path than the edge-run baseline.
+# f) Visual cleanliness:
+#    The scene has one large active funnel, one large blocker funnel, and a few singleton movers.
+#    Movers all lie in the radiating corridor and their trails are disjoint, so the carved holes are
+#    easy to attribute to motion rather than noise.
+# g) Color inferability:
+#    Colors keep their original structural roles. Wall color still identifies the funnels; the fill
+#    color still comes from the seed nearest the wall; mover colors are preserved and merely relocate.
+#    No ordering by color id is used anywhere.
+# h) New solver assumptions audited against the generator:
+#    main() now assumes that any same-colored wall component other than the seed-bearing one is a
+#    collision target and that mover cells should be transparent to stage-1 fill. generate_input()
+#    guarantees this by building exactly two wall components and by placing movers strictly in the
+#    corridor where transparent-under-fill behavior is visible.
+
+
+GRID_H_VERT = (15, 18)
+GRID_H_HORIZ = (10, 18)
+GRID_W = (17, 19)
+
+WALL_PIXELS_MIN = 17
+WALL_PIXELS_MAX = 25
+DEPTH_VERT = (5, 7)
+DEPTH_HORIZ = (5, 7)
+GAP_VERT = (6, 7)
+GAP_HORIZ = (5, 7)
+TIP_12_PROB = 0.5
+
+BLOCKER_OFFSET_MIN = 4
+BLOCKER_OFFSET_MAX = 6
+EDGE_MARGIN = BLOCKER_OFFSET_MAX + 2
+
+SEED_SIZE_WEIGHTS = [1, 1, 1, 1, 2, 2, 3, 4, 5, 6]
+SEED_DEPTH_LOOKBACK = 3
+
+MIN_MOVERS = 2
+MAX_MOVERS = 4
+MOVER_MIN_TRAVEL = 3
+MOVER_MIN_WALL_DIST = 3
+MOVER_PATH_DELTA_MIN = 2
+MOVER_MIN_SEP = 2
+
+MIN_NEW_FILL = 10
+MIN_RAY_FILL_DELTA = 6
+PALETTE_SIZE = (4, 6)
+GEN_RETRIES = 700
