+
+def _trace_ray(
+    start: tuple[int, int],
+    d: tuple[int, int],
+    rad: tuple[int, int],
+    is_12: bool,
+    shape: tuple[int, int],
+    stop_mask: np.ndarray | None,
+) -> tuple[list[tuple[int, int]], tuple[int, int] | None]:
+    h, w = shape
+    rr, cc = start
+    step = 0
+    path: list[tuple[int, int]] = []
+    while True:
+        step += 1
+        if not is_12 or step % 2 == 1:
+            nr = rr + d[0]
+            nc = cc + d[1]
+        else:
+            if rad[0] != 0:
+                nr = rr + d[0]
+                nc = cc
+            else:
+                nr = rr
+                nc = cc + d[1]
+        if not (0 <= nr < h and 0 <= nc < w):
+            return path, None
+        if stop_mask is not None and stop_mask[nr, nc]:
+            return path, (nr, nc)
+        path.append((nr, nc))
+        rr, cc = nr, nc
+
+
+def _trace_mover(
+    start: tuple[int, int],
+    rad: tuple[int, int],
+    shape: tuple[int, int],
+    stop_mask: np.ndarray | None,
+) -> dict:
+    h, w = shape
+    rr, cc = start
+    path: list[tuple[int, int]] = []
+    while True:
+        nr = rr + rad[0]
+        nc = cc + rad[1]
+        if not (0 <= nr < h and 0 <= nc < w):
+            return {"end": (rr, cc), "path": path, "hit": None}
+        if stop_mask is not None and stop_mask[nr, nc]:
+            return {"end": (rr, cc), "path": path, "hit": (nr, nc)}
+        rr, cc = nr, nc
+        path.append((rr, cc))
