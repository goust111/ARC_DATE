+        return None
+    local_wall, depth, gap = built
+    anchor = _place_anchor(rad, h, w, depth, gap)
+    if anchor is None:
+        return None
+
+    palette = random.sample(range(10), random.randint(*PALETTE_SIZE))
+    bg, wall_color, fill_color = palette[:3]
+    mover_colors = palette[3:]
+    if len(mover_colors) < 1:
+        mover_colors = random.sample([c for c in range(10) if c not in (bg, wall_color, fill_color)], 2)
+
+    active_pts = set()
+    for u, v in local_wall:
+        active_pts.add(_map_local(u, v, rad, anchor))
+
+    offset = random.randint(BLOCKER_OFFSET_MIN, BLOCKER_OFFSET_MAX)
