+# Combo variant of b9e38dc0 (index 7)
+# combo_spec: D2/1+D5/0
+# Name: 碰撞停止+辐射碰精灵停止
+
+from __future__ import annotations
+
+from pathlib import Path
+import random
+import sys
+
+import numpy as np
+from scipy.ndimage import distance_transform_cdt
+
+_SOLVER_DIR = Path("/home/lixinyu/snap/new/solvers")
+if str(_SOLVER_DIR) not in sys.path:
+    sys.path.append(str(_SOLVER_DIR))
+
+from arc_utils import components_mask, get_bg, neighbors4, neighbors8
+
+
+# Design analysis for the combo variant (D2/1 + D5/0).
+# a) Concrete behavior:
+#    The fused scene shows two separate wall sprites of the same color. The seed-bearing wall is
+#    the active funnel; a translated copy sits farther along the opening direction and acts as the
+#    visible collision target. Small isolated non-wall pixels are movers placed inside the corridor
+#    that the fill would normally occupy.
+#    - Original code path:
+#      1. Choose the wall component nearest the seed.
+#      2. Flood-fill its interior and extend the wedge to the grid edge.
+#      3. Keep extra non-wall pixels static (or treat them like obstacles in the old generator).
+#    - Fused path:
+#      1. Still choose the wall component nearest the seed as the active funnel.
+#      2. Trace each endpoint ray step by step; if the next ray cell belongs to another wall
+#         sprite, stop immediately before that wall instead of running to the border.
+#      3. Treat every remaining singleton color as a mover. It travels straight in the same
+#         radiate direction and stops at the last free cell before the first wall sprite on that
+#         line, clearing its entire traversed trail back to background.
+#    Example: with `rad = up`, the original wedge and mover both continue toward row 0. In the
+#    fused task, if a second wall sprite sits four rows above the opening, both endpoint rays stop
+#    against that sprite and a mover in the corridor also stops four steps earlier, leaving a
+#    background tunnel inside the otherwise filled wedge. The same object-to-object gap controls
+#    both effects.
+# b) Complexity calibration:
+#    The change is deliberately narrow: only one extra wall sprite and 2-4 singleton movers are
+#    added. There are no color remaps, no multiple stop types, and no reflection/detour behavior.
+#    To keep the fusion visible, the generator rejects samples where the blocker does not shorten
+#    the wedge, where movers would still end at the border, or where the fused output matches the
+#    D5-only / D2-only baselines.
+# c) Implicit assumptions audited:
+#    - Old assumption: endpoint rays stop only on out-of-bounds. Broken by D5/0; ray tracing must
+#      check another wall sprite before stepping.
+#    - Old assumption: extra non-wall colors are impassable obstacles. Broken by the mover branch:
+#      stage-1 fill must treat mover cells as transparent so the later trail-clearing is visible.
+#    - Old assumption: output depends only on one wall component. Broken by the combo; the active
+#      component is still the one nearest the seed, but another same-colored component now changes
+#      both the wedge extent and mover displacement.
+#    - New assumption: mover starts are not the fill seed color and stay farther from the wall than
+#      the seed blob. The generator enforces that so `fill = non-wall color closest to wall` stays
+#      correct.
+# d) Placement legality:
+#    The blocker is a translated copy of the active wall placed along the radiate direction with a
+#    bounded offset. The generator verifies that the copied sprite remains in-bounds, forms exactly
+#    two wall components with the active sprite, and that both endpoint rays collide with it.
+#    Movers are chosen only from cells inside the fused nominal fill zone, with disjoint trails and
+#    distinct stopping sites.
+# e) Visual observability:
+#    Humans can read both clues directly from geometry: the second wall visibly truncates the wedge,
+#    and the movers stop at that same wall rather than at the border. At least two movers per sample
+#    exhibit a shorter collision-stop path than the edge-run baseline.
+# f) Visual cleanliness:
+#    The scene has one large active funnel, one large blocker funnel, and a few singleton movers.
+#    Movers all lie in the radiating corridor and their trails are disjoint, so the carved holes are
+#    easy to attribute to motion rather than noise.
+# g) Color inferability:
+#    Colors keep their original structural roles. Wall color still identifies the funnels; the fill
+#    color still comes from the seed nearest the wall; mover colors are preserved and merely relocate.
+#    No ordering by color id is used anywhere.
+# h) New solver assumptions audited against the generator:
+#    main() now assumes that any same-colored wall component other than the seed-bearing one is a
+#    collision target and that mover cells should be transparent to stage-1 fill. generate_input()
+#    guarantees this by building exactly two wall components and by placing movers strictly in the
+#    corridor where transparent-under-fill behavior is visible.
+
+
+GRID_H_VERT = (15, 18)
+GRID_H_HORIZ = (11, 18)
+GRID_W = (17, 19)
+
+WALL_PIXELS_MIN = 17
+WALL_PIXELS_MAX = 25
+DEPTH_VERT = (5, 6)
+DEPTH_HORIZ = (5, 6)
+GAP_VERT = (6, 7)
+GAP_HORIZ = (5, 7)
+TIP_12_PROB = 0.5
+
+BLOCKER_OFFSET_MIN = 5
+BLOCKER_OFFSET_MAX = 6
+EDGE_MARGIN = BLOCKER_OFFSET_MAX
+
+SEED_SIZE_WEIGHTS = [1, 1, 1, 1, 2, 2, 3, 4, 5, 6]
+SEED_DEPTH_LOOKBACK = 3
+
+MIN_MOVERS = 2
+MAX_MOVERS = 4
+MOVER_MIN_TRAVEL = 3
+MOVER_MIN_WALL_DIST = 3
+MOVER_PATH_DELTA_MIN = 2
+MOVER_MIN_SEP = 2
+
+MIN_NEW_FILL = 10
+MIN_RAY_FILL_DELTA = 6
+PALETTE_SIZE = (4, 6)
+GEN_RETRIES = 700
+
+
+def _sgn(x: int) -> int:
+    return (x > 0) - (x < 0)
+
+
+def _component_sets(mask: np.ndarray) -> list[set[tuple[int, int]]]:
+    return [set((int(r), int(c)) for r, c in pts) for pts in components_mask(mask, connectivity=8)]
+
+
+def _component_mask(shape: tuple[int, int], comp: set[tuple[int, int]]) -> np.ndarray:
+    mask = np.zeros(shape, dtype=bool)
+    for r, c in comp:
+        mask[r, c] = True
+    return mask
+
+
+def _comp_neighbors(comp_mask: np.ndarray, r: int, c: int) -> list[tuple[int, int]]:
+    h, w = comp_mask.shape
+    out = []
+    for rr, cc in neighbors8(r, c):
+        if 0 <= rr < h and 0 <= cc < w and comp_mask[rr, cc]:
+            out.append((rr, cc))
+    return out
+
+
+def _outward_dir(comp_mask: np.ndarray, ep: tuple[int, int]) -> tuple[tuple[int, int], bool]:
+    n1 = _comp_neighbors(comp_mask, *ep)[0]
+    d1 = (_sgn(n1[0] - ep[0]), _sgn(n1[1] - ep[1]))
+    d_use = d1
+    is_12 = False
+    n2s = [p for p in _comp_neighbors(comp_mask, *n1) if p != ep]
+    if n2s:
+        n2 = n2s[0]
+        d2 = (_sgn(n2[0] - n1[0]), _sgn(n2[1] - n1[1]))
+        if (d1[0] == 0) ^ (d1[1] == 0):
+            if d2[0] != 0 and d2[1] != 0:
+                d_use = d2
+                is_12 = True
+    return (-d_use[0], -d_use[1]), is_12
+
+
+def _component_ray_info(comp: set[tuple[int, int]], shape: tuple[int, int]) -> dict:
+    comp_mask = _component_mask(shape, comp)
+    endpoints = sorted([(r, c) for r, c in comp if len(_comp_neighbors(comp_mask, r, c)) == 1])
+    assert len(endpoints) >= 2, "expected wall component to have endpoints"
+    out_info = [_outward_dir(comp_mask, ep) for ep in endpoints]
+    out_dirs = [d for d, _ in out_info]
+    tip_12 = [flag for _, flag in out_info]
+    rad = (_sgn(sum(d[0] for d in out_dirs)), _sgn(sum(d[1] for d in out_dirs)))
+    return {
+        "comp_mask": comp_mask,
+        "endpoints": endpoints,
+        "out_dirs": out_dirs,
+        "tip_12": tip_12,
+        "rad": rad,
+    }
+
+
+def _trace_ray(
+    start: tuple[int, int],
+    d: tuple[int, int],
+    rad: tuple[int, int],
+    is_12: bool,
+    shape: tuple[int, int],
+    stop_mask: np.ndarray | None,
+) -> tuple[list[tuple[int, int]], tuple[int, int] | None]:
+    h, w = shape
+    rr, cc = start
+    step = 0
+    path: list[tuple[int, int]] = []
+    while True:
+        step += 1
+        if not is_12 or step % 2 == 1:
+            nr = rr + d[0]
+            nc = cc + d[1]
+        else:
+            if rad[0] != 0:
+                nr = rr + d[0]
+                nc = cc
+            else:
+                nr = rr
+                nc = cc + d[1]
+        if not (0 <= nr < h and 0 <= nc < w):
+            return path, None
+        if stop_mask is not None and stop_mask[nr, nc]:
+            return path, (nr, nc)
+        path.append((nr, nc))
+        rr, cc = nr, nc
+
+
+def _trace_mover(
+    start: tuple[int, int],
+    rad: tuple[int, int],
+    shape: tuple[int, int],
+    stop_mask: np.ndarray | None,
+) -> dict:
+    h, w = shape
+    rr, cc = start
+    path: list[tuple[int, int]] = []
+    while True:
+        nr = rr + rad[0]
+        nc = cc + rad[1]
+        if not (0 <= nr < h and 0 <= nc < w):
+            return {"end": (rr, cc), "path": path, "hit": None}
+        if stop_mask is not None and stop_mask[nr, nc]:
+            return {"end": (rr, cc), "path": path, "hit": (nr, nc)}
+        rr, cc = nr, nc
+        path.append((rr, cc))
+
+
+def _parse_scene(grid: np.ndarray) -> dict:
+    g = np.array(grid, copy=True)
+    h, w = g.shape
+
+    vals = np.unique(g)
+    bg = get_bg(g)
+    non_bg = [int(v) for v in vals if int(v) != bg]
+    assert non_bg, "expected at least one non-background color"
+
+    wall = max(non_bg, key=lambda c: int((g == c).sum()))
+    wall_mask = g == wall
+    comps = _component_sets(wall_mask)
+    assert comps, "expected wall connected component(s)"
+
+    other_colors = [c for c in non_bg if c != wall]
+    assert other_colors, "expected at least one non-wall color"
+
+    wall_points = [p for comp in comps for p in comp]
+
+    def min_dist_to_wall(color: int) -> tuple[int, int]:
+        pts = [(int(r), int(c)) for r, c in zip(*np.where(g == color))]
+        best_d = 10**9
+        for r, c in pts:
+            for wr, wc in wall_points:
+                d = abs(r - wr) + abs(c - wc)
+                if d < best_d:
+                    best_d = d
+                    if best_d == 0:
+                        return 0, len(pts)
+        return best_d, len(pts)
+
+    fill = min(other_colors, key=lambda c: (min_dist_to_wall(c)[0], min_dist_to_wall(c)[1]))
+    fill_pos = [(int(r), int(c)) for r, c in zip(*np.where(g == fill))]
+    assert fill_pos, "expected a fill seed"
+
+    def comp_min_dist(comp: set[tuple[int, int]]) -> int:
+        best_d = 10**9
+        for r, c in fill_pos:
+            for wr, wc in comp:
+                d = abs(r - wr) + abs(c - wc)
+                if d < best_d:
+                    best_d = d
+                    if best_d == 0:
+                        return 0
+        return best_d
+
+    wall_comp = min(comps, key=lambda comp: (comp_min_dist(comp), -len(comp)))
+    ray_info = _component_ray_info(wall_comp, (h, w))
+    comp_mask = ray_info["comp_mask"]
+    other_wall_mask = wall_mask & (~comp_mask)
+    mover_mask = (g != bg) & (g != wall) & (g != fill)
+    mover_cells = [(int(r), int(c), int(g[r, c])) for r, c in zip(*np.where(mover_mask))]
+
+    return {
+        "grid": g,
+        "shape": (h, w),
+        "bg": bg,
+        "wall": wall,
+        "fill": fill,
+        "fill_pos": fill_pos,
+        "wall_mask": wall_mask,
+        "wall_comp": wall_comp,
+        "comp_mask": comp_mask,
+        "other_wall_mask": other_wall_mask,
+        "endpoints": ray_info["endpoints"],
+        "out_dirs": ray_info["out_dirs"],
+        "tip_12": ray_info["tip_12"],
+        "rad": ray_info["rad"],
+        "mover_mask": mover_mask,
+        "mover_cells": mover_cells,
+    }
+
+
+def _compute_stage1(scene: dict, *, stop_at_other_wall: bool) -> dict:
+    g = scene["grid"]
+    barrier = scene["comp_mask"].copy()
+    stop_mask = scene["other_wall_mask"] if stop_at_other_wall else None
+    ray_meta = []
+    for ep, d, is_12 in zip(scene["endpoints"], scene["out_dirs"], scene["tip_12"]):
+        path, hit = _trace_ray(ep, d, scene["rad"], is_12, scene["shape"], stop_mask)
+        for r, c in path:
+            barrier[r, c] = True
+        ray_meta.append(
+            {
+                "start": ep,
+                "dir": d,
+                "is_12": is_12,
+                "cells": path,
+                "hit": hit,
+            }
+        )
+
+    passable = (~barrier) & ((g == scene["bg"]) | (g == scene["fill"]) | scene["mover_mask"])
+    q = scene["fill_pos"][:]
+    seen = np.zeros_like(passable, dtype=bool)
+    for r, c in q:
+        if passable[r, c]:
+            seen[r, c] = True
+    while q:
+        r, c = q.pop()
+        for rr, cc in neighbors4(r, c):
+            if 0 <= rr < g.shape[0] and 0 <= cc < g.shape[1] and passable[rr, cc] and not seen[rr, cc]:
+                seen[rr, cc] = True
+                q.append((rr, cc))
+
+    fill_cover_mask = seen & ((g == scene["bg"]) | scene["mover_mask"])
+    out = g.copy()
+    out[fill_cover_mask] = scene["fill"]
+    return {
+        "out": out,
+        "fill_cover_mask": fill_cover_mask,
+        "seen": seen,
+        "barrier": barrier,
+        "ray_meta": ray_meta,
+    }
+
+
+def _solve(
+    grid: np.ndarray,
+    *,
+    stop_at_other_wall: bool,
+    movers_stop_at_wall: bool,
+    return_meta: bool = False,
+):
+    scene = _parse_scene(grid)
+    stage1 = _compute_stage1(scene, stop_at_other_wall=stop_at_other_wall)
+    out = stage1["out"].copy()
+    mover_meta = []
+
+    if scene["rad"] != (0, 0):
+        stop_mask = scene["wall_mask"] if movers_stop_at_wall else None
+        for r, c, color in sorted(scene["mover_cells"]):
+            traced = _trace_mover((r, c), scene["rad"], scene["shape"], stop_mask)
+            trail = [(r, c), *traced["path"]]
+            for rr, cc in trail:
+                out[rr, cc] = scene["bg"]
+            end_r, end_c = traced["end"]
+            out[end_r, end_c] = color
+            mover_meta.append(
+                {
+                    "start": (r, c),
+                    "end": (int(end_r), int(end_c)),
+                    "path": list(traced["path"]),
+                    "hit": traced["hit"],
+                    "color": color,
+                }
+            )
+
+    if return_meta:
+        return out, {"scene": scene, "stage1": stage1, "mover_meta": mover_meta}
+    return out
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Fill the seed-bearing funnel, then stop both the wedge rays and the straight movers when they meet another sprite.
+
+    Input structure:
+    - Background is the most common color. The wall color is the most common non-background color and forms multiple separated funnel-like wall sprites of that same color.
+    - One non-wall color nearest the wall is the fill seed inside one funnel. Any remaining non-background singleton pixels are movers placed in the outward corridor.
+
+    Rule:
+    - Select the wall component nearest the seed as the active funnel, flood-fill its interior, and radiate outward through its opening.
+    - Each boundary ray of that radiating wedge advances step by step but halts immediately before another wall sprite instead of extending to the grid edge.
+    - Then move each isolated mover straight in the same radiate direction, clearing its traversed cells to background and stopping at the last free cell before the first wall sprite on its line.
+
+    Key insight: The second wall sprite is the shared geometric stop signal. Its spacing from the active funnel simultaneously determines the wedge length and the mover travel distance.
+    """
+    return _solve(grid, stop_at_other_wall=True, movers_stop_at_wall=True)
+
+
+def _degree1_pixels(points: set[tuple[int, int]]) -> list[tuple[int, int]]:
+    pts = set(points)
+    return [(r, c) for r, c in pts if sum((rr, cc) in pts for rr, cc in neighbors8(r, c)) == 1]
+
+
+def _make_arm(depth: int, start_v: int, target_v: int, extra_steps: int, tip_12: bool = False) -> list[tuple[int, int]]:
+    sign = 1 if target_v > start_v else -1
+    n_side_steps = abs(target_v - start_v)
+    chosen_rows: list[int] = []
+    if n_side_steps:
+        if tip_12:
+            chosen_rows = [2 * (i + 1) for i in range(n_side_steps)]
+            extra_steps = 0
+        else:
+            chosen_rows = [1]
+            if n_side_steps > 1:
+                chosen_rows += random.sample(range(2, depth + 1), n_side_steps - 1)
+            chosen_rows.sort()
+
+    first_row = chosen_rows[0] if chosen_rows else 1
+    extra_rows = [r for r in chosen_rows if r != first_row]
+    random.shuffle(extra_rows)
+    orthogonal_rows = set(extra_rows[:extra_steps])
+
+    pts = [(0, start_v)]
+    u, v = 0, start_v
+    for row in range(1, depth + 1):
+        u += 1
+        if row in orthogonal_rows:
+            pts.append((u, v))
+            v += sign
+        elif row in chosen_rows:
+            v += sign
+        pts.append((u, v))
+    return pts
+
+
+def _build_local_wall(rad: tuple[int, int], h: int, w: int):
+    if rad[0]:
+        max_depth = min(DEPTH_VERT[1], h - EDGE_MARGIN - 3)
+        if max_depth < DEPTH_VERT[0]:
+            return None
+        depth = random.randint(DEPTH_VERT[0], max_depth)
+        gap = random.randint(*GAP_VERT)
+    else:
+        max_depth = min(DEPTH_HORIZ[1], w - EDGE_MARGIN - 3)
+        if max_depth < DEPTH_HORIZ[0]:
+            return None
+        depth = random.randint(DEPTH_HORIZ[0], max_depth)
+        gap = random.randint(GAP_HORIZ[0], min(GAP_HORIZ[1], h - 1))
+
+    if gap == 5:
+        left_bottom, right_bottom = 2, 3
+    elif gap == 6:
+        left_bottom, right_bottom = 2, 4
+    else:
+        left_bottom, right_bottom = random.choice([(2, 5), (3, 4)])
+
+    bridge_extra = max(0, right_bottom - left_bottom - 1)
+    base_count = 2 * (depth + 1) + bridge_extra
+    max_extra_l = max(0, left_bottom - 1)
+    max_extra_r = max(0, gap - right_bottom - 1)
+    min_extra = max(0, WALL_PIXELS_MIN - base_count)
+    max_extra = min(max_extra_l + max_extra_r, WALL_PIXELS_MAX - base_count)
+    if min_extra > max_extra:
+        return None
+
+    extra = random.randint(min_extra, max_extra)
+    extra_l = random.randint(max(0, extra - max_extra_r), min(max_extra_l, extra))
+    extra_r = extra - extra_l
+
+    max_n_side = max(left_bottom, gap - right_bottom)
+    tip_12 = depth >= 2 * max_n_side and random.random() < TIP_12_PROB
+    left = _make_arm(depth, 0, left_bottom, extra_l, tip_12=tip_12)
+    right = _make_arm(depth, gap, right_bottom, extra_r, tip_12=tip_12)
+    pts = set(left) | set(right)
+    for v in range(left_bottom, right_bottom + 1):
+        pts.add((depth, v))
+
+    while len(pts) < WALL_PIXELS_MIN:
+        candidates = [
+            (u, v)
+            for u in range(max(0, depth - 3), depth + 1)
+            for v in range(gap + 1)
+            if (u, v) not in pts
+            and sum(
+                (uu, vv) in pts
+                for uu in range(u - 1, u + 2)
+                for vv in range(v - 1, v + 2)
+                if (uu, vv) != (u, v)
+            ) >= 2
+        ]
+        random.shuffle(candidates)
+        added = False
+        for p in candidates:
+            trial = pts | {p}
+            if len(trial) <= WALL_PIXELS_MAX and len(_degree1_pixels(trial)) == 2:
+                pts = trial
+                added = True
+                break
+        if not added:
+            return None
+
+    if not (WALL_PIXELS_MIN <= len(pts) <= WALL_PIXELS_MAX) or len(_degree1_pixels(pts)) != 2:
+        return None
+    return pts, depth, gap
+
+
+def _map_local(u: int, v: int, rad: tuple[int, int], anchor: tuple[int, int]) -> tuple[int, int]:
+    r0, c0 = anchor
+    if rad == (-1, 0):
+        return r0 + u, c0 + v
+    if rad == (1, 0):
+        return r0 - u, c0 + v
+    if rad == (0, -1):
+        return r0 + v, c0 + u
+    return r0 + v, c0 - u
+
+
+def _place_anchor(rad: tuple[int, int], h: int, w: int, depth: int, gap: int):
+    if rad == (-1, 0):
+        lo, hi = EDGE_MARGIN, h - depth - 3
+        if lo > hi:
+            return None
+        return random.randint(lo, hi), random.randint(0, w - gap - 1)
+    if rad == (1, 0):
+        lo, hi = depth + 2, h - EDGE_MARGIN - 1
+        if lo > hi:
+            return None
+        return random.randint(lo, hi), random.randint(0, w - gap - 1)
+    if rad == (0, -1):
+        lo, hi = EDGE_MARGIN, w - depth - 3
+        if lo > hi:
+            return None
+        return random.randint(0, h - gap - 1), random.randint(lo, hi)
+    lo, hi = depth + 2, w - EDGE_MARGIN - 1
+    if lo > hi:
+        return None
+    return random.randint(0, h - gap - 1), random.randint(lo, hi)
+
+
+def _local_interior(wall: set[tuple[int, int]], depth: int, gap: int) -> list[tuple[int, int]]:
+    by_row: dict[int, list[int]] = {}
+    for u, v in wall:
+        by_row.setdefault(u, []).append(v)
+    interior = []
+    for u in range(1, depth):
+        if u not in by_row or len(by_row[u]) < 2:
+            continue
+        lo, hi = min(by_row[u]), max(by_row[u])
+        for v in range(lo + 1, hi):
+            if (u, v) not in wall:
+                interior.append((u, v))
+    return interior
+
+
+def _grow_seed_blob(seed: tuple[int, int], interior_set: set[tuple[int, int]]) -> set[tuple[int, int]]:
+    blob = {seed}
+    target_size = random.choice(SEED_SIZE_WEIGHTS)
+    frontier = [seed]
+    while len(blob) < target_size and frontier:
+        p = frontier.pop(random.randrange(len(frontier)))
+        u, v = p
+        for q in random.sample([(u - 1, v), (u + 1, v), (u, v - 1), (u, v + 1)], 4):
+            if q in interior_set and q not in blob:
+                blob.add(q)
+                frontier.append(q)
+                if len(blob) >= target_size:
+                    break
+    return blob
+
+
+def _translate_points(points: set[tuple[int, int]], rad: tuple[int, int], offset: int) -> set[tuple[int, int]]:
+    dr = rad[0] * offset
+    dc = rad[1] * offset
+    return {(r + dr, c + dc) for r, c in points}
+
+
+def _touches_border(mask: np.ndarray) -> bool:
+    return bool(mask[0, :].any() or mask[-1, :].any() or mask[:, 0].any() or mask[:, -1].any())
+
+
+def _chebyshev_far_enough(pos: tuple[int, int], placed: list[tuple[int, int]], min_sep: int) -> bool:
+    r, c = pos
+    return all(max(abs(r - rr), abs(c - cc)) >= min_sep for rr, cc in placed)
+
+
+def _variant_metrics(grid: np.ndarray) -> dict:
+    scene = _parse_scene(grid)
+    stage_stop = _compute_stage1(scene, stop_at_other_wall=True)
+    stage_edge = _compute_stage1(scene, stop_at_other_wall=False)
+
+    stop_mask = scene["wall_mask"]
+    mover_stop_steps = []
+    mover_edge_steps = []
+    mover_hits = 0
+    mover_delta_total = 0
+    for r, c, _color in scene["mover_cells"]:
+        stop_trace = _trace_mover((r, c), scene["rad"], scene["shape"], stop_mask)
+        edge_trace = _trace_mover((r, c), scene["rad"], scene["shape"], None)
+        mover_stop_steps.append(len(stop_trace["path"]))
+        mover_edge_steps.append(len(edge_trace["path"]))
+        if stop_trace["hit"] is not None:
+            mover_hits += 1
+            mover_delta_total += len(edge_trace["path"]) - len(stop_trace["path"])
+
+    stage_stop_fill = int(((stage_stop["out"] == scene["fill"]) & (scene["grid"] == scene["bg"])).sum())
+    stage_edge_fill = int(((stage_edge["out"] == scene["fill"]) & (scene["grid"] == scene["bg"])).sum())
+    ray_hits = sum(1 for item in stage_stop["ray_meta"] if item["hit"] is not None)
+
+    return {
+        "ray_hit_count": ray_hits,
+        "ray_fill_delta": stage_edge_fill - stage_stop_fill,
+        "mover_count": len(scene["mover_cells"]),
+        "mover_hit_count": mover_hits,
+        "mover_delta_total": mover_delta_total,
+        "avg_stop_steps": float(np.mean(mover_stop_steps)) if mover_stop_steps else 0.0,
+        "avg_edge_steps": float(np.mean(mover_edge_steps)) if mover_edge_steps else 0.0,
+    }
+
+
+def _candidate_movers(base_grid: np.ndarray, stage1_meta: dict) -> list[dict]:
+    scene = stage1_meta["scene"]
+    fill_color = scene["fill"]
+    wall_mask = scene["wall_mask"]
+    stop_mask = wall_mask
+    rad = scene["rad"]
+    h, w = base_grid.shape
+
+    wall_dist = distance_transform_cdt(~wall_mask, metric="taxicab")
+    nominal_fill = stage1_meta["stage1"]["out"] == fill_color
+    eligible = (base_grid == scene["bg"]) & nominal_fill & (wall_dist >= MOVER_MIN_WALL_DIST)
+
+    records = []
+    for r, c in zip(*np.where(eligible)):
+        start = (int(r), int(c))
+        stop_trace = _trace_mover(start, rad, (h, w), stop_mask)
+        edge_trace = _trace_mover(start, rad, (h, w), None)
+        if stop_trace["hit"] is None:
+            continue
+        if len(stop_trace["path"]) < MOVER_MIN_TRAVEL:
+            continue
+        if len(edge_trace["path"]) - len(stop_trace["path"]) < MOVER_PATH_DELTA_MIN:
+            continue
+        cells = [start, *stop_trace["path"]]
+        if not all(nominal_fill[rr, cc] for rr, cc in cells):
+            continue
+        footprint = set(cells)
+        records.append(
+            {
+                "start": start,
+                "end": tuple(map(int, stop_trace["end"])),
+                "hit": tuple(map(int, stop_trace["hit"])) if stop_trace["hit"] is not None else None,
+                "path": list(stop_trace["path"]),
+                "footprint": footprint,
+                "delta": len(edge_trace["path"]) - len(stop_trace["path"]),
+            }
+        )
+
+    random.shuffle(records)
+    records.sort(key=lambda rec: (rec["delta"], len(rec["path"])), reverse=True)
+    return records
+
+
+def _pick_movers(records: list[dict]) -> list[dict]:
+    if len(records) < MIN_MOVERS:
+        return []
+    target_n = random.randint(MIN_MOVERS, min(MAX_MOVERS, len(records)))
+    chosen = []
+    used_starts: list[tuple[int, int]] = []
+    used_ends: list[tuple[int, int]] = []
+    occupied: set[tuple[int, int]] = set()
+    for rec in records:
+        if rec["footprint"] & occupied:
+            continue
+        if rec["start"] in used_ends or rec["end"] in used_starts:
+            continue
+        if not _chebyshev_far_enough(rec["start"], used_starts, MOVER_MIN_SEP):
+            continue
+        if not _chebyshev_far_enough(rec["end"], used_ends, 1):
+            continue
+        chosen.append(rec)
+        used_starts.append(rec["start"])
+        used_ends.append(rec["end"])
+        occupied |= rec["footprint"]
+        if len(chosen) >= target_n:
+            break
+    if len(chosen) < MIN_MOVERS:
+        return []
+    return chosen
+
+
+def _gen_attempt():
+    rad = random.choice([(-1, 0), (1, 0), (0, -1), (0, 1)])
+    h = random.randint(*GRID_H_VERT) if rad[0] else random.randint(*GRID_H_HORIZ)
+    w = random.randint(*GRID_W)
+
+    built = _build_local_wall(rad, h, w)
+    if built is None:
+        return None
+    local_wall, depth, gap = built
+    anchor = _place_anchor(rad, h, w, depth, gap)
+    if anchor is None:
+        return None
+
+    palette = random.sample(range(10), random.randint(*PALETTE_SIZE))
+    bg, wall_color, fill_color = palette[:3]
+    mover_colors = palette[3:]
+    if len(mover_colors) < 1:
+        mover_colors = random.sample([c for c in range(10) if c not in (bg, wall_color, fill_color)], 2)
+
+    active_pts = set()
+    for u, v in local_wall:
+        active_pts.add(_map_local(u, v, rad, anchor))
+
+    offset = random.randint(BLOCKER_OFFSET_MIN, BLOCKER_OFFSET_MAX)
+    blocker_pts = _translate_points(active_pts, rad, offset)
+    if any(not (0 <= r < h and 0 <= c < w) for r, c in blocker_pts):
+        return None
+    if active_pts & blocker_pts:
+        return None
+
+    grid = np.full((h, w), bg, dtype=int)
+    for r, c in active_pts | blocker_pts:
+        grid[r, c] = wall_color
+    if len(_component_sets(grid == wall_color)) != 2:
+        return None
+
+    interior = _local_interior(local_wall, depth, gap)
+    wall_set = set(local_wall)
+    adjacent = [
+        p
+        for p in interior
+        if any((p[0] + dr, p[1] + dc) in wall_set for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)])
+    ]
+    seed_pool = [p for p in adjacent if p[0] >= max(1, depth - SEED_DEPTH_LOOKBACK)]
+    if not seed_pool:
+        return None
+
+    blob = _grow_seed_blob(random.choice(seed_pool), set(interior))
+    for u, v in blob:
+        r, c = _map_local(u, v, rad, anchor)
+        if grid[r, c] != bg:
+            return None
+        grid[r, c] = fill_color
+
+    try:
+        base_stage_stop_out, base_stage_stop_meta = _solve(
+            grid, stop_at_other_wall=True, movers_stop_at_wall=True, return_meta=True
+        )
+        base_stage_edge_out, base_stage_edge_meta = _solve(
+            grid, stop_at_other_wall=False, movers_stop_at_wall=False, return_meta=True
+        )
+    except Exception:
+        return None
+
+    if base_stage_stop_meta["mover_meta"]:
+        return None
+
+    ray_hits = [item["hit"] is not None for item in base_stage_stop_meta["stage1"]["ray_meta"]]
+    if sum(ray_hits) < 2:
+        return None
+
+    fused_fill = (base_stage_stop_meta["stage1"]["out"] == fill_color) & (grid == bg)
+    edge_fill = (base_stage_edge_meta["stage1"]["out"] == fill_color) & (grid == bg)
+    if int(fused_fill.sum()) < MIN_NEW_FILL:
+        return None
+    if int(edge_fill.sum()) - int(fused_fill.sum()) < MIN_RAY_FILL_DELTA:
+        return None
+
+    candidates = _candidate_movers(grid, base_stage_stop_meta)
+    chosen = _pick_movers(candidates)
+    if len(chosen) < MIN_MOVERS:
+        return None
+
+    for i, rec in enumerate(chosen):
+        r, c = rec["start"]
+        grid[r, c] = mover_colors[i % len(mover_colors)]
+
+    try:
+        fused_out, fused_meta = _solve(
+            grid, stop_at_other_wall=True, movers_stop_at_wall=True, return_meta=True
+        )
+        ray_only_out = _solve(grid, stop_at_other_wall=True, movers_stop_at_wall=False)
+        mover_only_out = _solve(grid, stop_at_other_wall=False, movers_stop_at_wall=True)
+        original_out = _solve(grid, stop_at_other_wall=False, movers_stop_at_wall=False)
+    except Exception:
+        return None
+
+    if np.array_equal(fused_out, ray_only_out):
+        return None
+    if np.array_equal(fused_out, mover_only_out):
+        return None
+    if np.array_equal(fused_out, original_out):
+        return None
+
+    metrics = _variant_metrics(grid)
+    if metrics["ray_hit_count"] < 2:
+        return None
+    if metrics["mover_hit_count"] < MIN_MOVERS:
+        return None
+    if metrics["mover_delta_total"] < MIN_MOVERS * MOVER_PATH_DELTA_MIN:
+        return None
+    if metrics["ray_fill_delta"] < MIN_RAY_FILL_DELTA:
+        return None
+
+    new_fill = (fused_out == fill_color) & (grid == bg)
+    if int(new_fill.sum()) < MIN_NEW_FILL:
+        return None
+
+    mover_by_start = {item["start"]: item for item in fused_meta["mover_meta"]}
+    for rec in chosen:
+        if rec["start"] not in mover_by_start:
+            return None
+        meta_item = mover_by_start[rec["start"]]
+        if tuple(meta_item["end"]) != rec["end"]:
+            return None
+        if meta_item["hit"] is None:
+            return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate valid b9e38dc0 combo D2/1+D5/0 input")

diff --git a/ceshi/code_combo/b9e38dc0/7/code.py b/ceshi/code_combo/b9e38dc0/7/code.py
new file mode 100644
index 0000000000000000000000000000000000000000..46b7a08c5656d4dc311ef142507b3479b0d7535e
--- /dev/null
+++ b/ceshi/code_combo/b9e38dc0/7/code.py
@@ -0,0 +1,825 @@
+# Combo variant of b9e38dc0 (index 7)
+# combo_spec: D2/1+D5/0
+# Name: 碰撞停止+辐射碰精灵停止
+
+from __future__ import annotations
+
+from pathlib import Path
+import random
+import sys
+
+import numpy as np
+from scipy.ndimage import distance_transform_cdt
+
+_SOLVER_DIR = Path("/home/lixinyu/snap/new/solvers")
+if str(_SOLVER_DIR) not in sys.path:
+    sys.path.append(str(_SOLVER_DIR))
+
+from arc_utils import components_mask, get_bg, neighbors4, neighbors8
+
+
+# Design analysis for the combo variant (D2/1 + D5/0).
+# a) Concrete behavior:
+#    The fused scene shows two separate wall sprites of the same color. The seed-bearing wall is
+#    the active funnel; a translated copy sits farther along the opening direction and acts as the
+#    visible collision target. Small isolated non-wall pixels are movers placed inside the corridor
+#    that the fill would normally occupy.
+#    - Original code path:
+#      1. Choose the wall component nearest the seed.
+#      2. Flood-fill its interior and extend the wedge to the grid edge.
+#      3. Keep extra non-wall pixels static (or treat them like obstacles in the old generator).
+#    - Fused path:
+#      1. Still choose the wall component nearest the seed as the active funnel.
+#      2. Trace each endpoint ray step by step; if the next ray cell belongs to another wall
+#         sprite, stop immediately before that wall instead of running to the border.
+#      3. Treat every remaining singleton color as a mover. It travels straight in the same
+#         radiate direction and stops at the last free cell before the first wall sprite on that
+#         line, clearing its entire traversed trail back to background.
+#    Example: with `rad = up`, the original wedge and mover both continue toward row 0. In the
+#    fused task, if a second wall sprite sits four rows above the opening, both endpoint rays stop
+#    against that sprite and a mover in the corridor also stops four steps earlier, leaving a
+#    background tunnel inside the otherwise filled wedge. The same object-to-object gap controls
+#    both effects.
+# b) Complexity calibration:
+#    The change is deliberately narrow: only one extra wall sprite and 2-4 singleton movers are
+#    added. There are no color remaps, no multiple stop types, and no reflection/detour behavior.
+#    To keep the fusion visible, the generator rejects samples where the blocker does not shorten
+#    the wedge, where movers would still end at the border, or where the fused output matches the
+#    D5-only / D2-only baselines.
+# c) Implicit assumptions audited:
+#    - Old assumption: endpoint rays stop only on out-of-bounds. Broken by D5/0; ray tracing must
+#      check another wall sprite before stepping.
+#    - Old assumption: extra non-wall colors are impassable obstacles. Broken by the mover branch:
+#      stage-1 fill must treat mover cells as transparent so the later trail-clearing is visible.
+#    - Old assumption: output depends only on one wall component. Broken by the combo; the active
+#      component is still the one nearest the seed, but another same-colored component now changes
+#      both the wedge extent and mover displacement.
+#    - New assumption: mover starts are not the fill seed color and stay farther from the wall than
+#      the seed blob. The generator enforces that so `fill = non-wall color closest to wall` stays
+#      correct.
+# d) Placement legality:
+#    The blocker is a translated copy of the active wall placed along the radiate direction with a
+#    bounded offset. The generator verifies that the copied sprite remains in-bounds, forms exactly
+#    two wall components with the active sprite, and that both endpoint rays collide with it.
+#    Movers are chosen only from cells inside the fused nominal fill zone, with disjoint trails and
+#    distinct stopping sites.
+# e) Visual observability:
+#    Humans can read both clues directly from geometry: the second wall visibly truncates the wedge,
+#    and the movers stop at that same wall rather than at the border. At least two movers per sample
+#    exhibit a shorter collision-stop path than the edge-run baseline.
+# f) Visual cleanliness:
+#    The scene has one large active funnel, one large blocker funnel, and a few singleton movers.
+#    Movers all lie in the radiating corridor and their trails are disjoint, so the carved holes are
+#    easy to attribute to motion rather than noise.
+# g) Color inferability:
+#    Colors keep their original structural roles. Wall color still identifies the funnels; the fill
+#    color still comes from the seed nearest the wall; mover colors are preserved and merely relocate.
+#    No ordering by color id is used anywhere.
+# h) New solver assumptions audited against the generator:
+#    main() now assumes that any same-colored wall component other than the seed-bearing one is a
+#    collision target and that mover cells should be transparent to stage-1 fill. generate_input()
+#    guarantees this by building exactly two wall components and by placing movers strictly in the
+#    corridor where transparent-under-fill behavior is visible.
+
+
+GRID_H_VERT = (15, 18)
+GRID_H_HORIZ = (11, 18)
+GRID_W = (17, 19)
+
+WALL_PIXELS_MIN = 17
+WALL_PIXELS_MAX = 25
+DEPTH_VERT = (5, 6)
+DEPTH_HORIZ = (5, 6)
+GAP_VERT = (6, 7)
+GAP_HORIZ = (5, 7)
+TIP_12_PROB = 0.5
+
+BLOCKER_OFFSET_MIN = 5
+BLOCKER_OFFSET_MAX = 6
+EDGE_MARGIN = BLOCKER_OFFSET_MAX
+
+SEED_SIZE_WEIGHTS = [1, 1, 1, 1, 2, 2, 3, 4, 5, 6]
+SEED_DEPTH_LOOKBACK = 3
+
+MIN_MOVERS = 2
+MAX_MOVERS = 4
+MOVER_MIN_TRAVEL = 3
+MOVER_MIN_WALL_DIST = 3
+MOVER_PATH_DELTA_MIN = 2
+MOVER_MIN_SEP = 2
+
+MIN_NEW_FILL = 10
+MIN_RAY_FILL_DELTA = 6
+PALETTE_SIZE = (4, 6)
+GEN_RETRIES = 700
+
+
+def _sgn(x: int) -> int:
+    return (x > 0) - (x < 0)
+
+
+def _component_sets(mask: np.ndarray) -> list[set[tuple[int, int]]]:
+    return [set((int(r), int(c)) for r, c in pts) for pts in components_mask(mask, connectivity=8)]
+
+
+def _component_mask(shape: tuple[int, int], comp: set[tuple[int, int]]) -> np.ndarray:
+    mask = np.zeros(shape, dtype=bool)
+    for r, c in comp:
+        mask[r, c] = True
+    return mask
+
+
+def _comp_neighbors(comp_mask: np.ndarray, r: int, c: int) -> list[tuple[int, int]]:
+    h, w = comp_mask.shape
+    out = []
+    for rr, cc in neighbors8(r, c):
+        if 0 <= rr < h and 0 <= cc < w and comp_mask[rr, cc]:
+            out.append((rr, cc))
+    return out
+
+
+def _outward_dir(comp_mask: np.ndarray, ep: tuple[int, int]) -> tuple[tuple[int, int], bool]:
+    n1 = _comp_neighbors(comp_mask, *ep)[0]
+    d1 = (_sgn(n1[0] - ep[0]), _sgn(n1[1] - ep[1]))
+    d_use = d1
+    is_12 = False
+    n2s = [p for p in _comp_neighbors(comp_mask, *n1) if p != ep]
+    if n2s:
+        n2 = n2s[0]
+        d2 = (_sgn(n2[0] - n1[0]), _sgn(n2[1] - n1[1]))
+        if (d1[0] == 0) ^ (d1[1] == 0):
+            if d2[0] != 0 and d2[1] != 0:
+                d_use = d2
+                is_12 = True
+    return (-d_use[0], -d_use[1]), is_12
+
+
+def _component_ray_info(comp: set[tuple[int, int]], shape: tuple[int, int]) -> dict:
+    comp_mask = _component_mask(shape, comp)
+    endpoints = sorted([(r, c) for r, c in comp if len(_comp_neighbors(comp_mask, r, c)) == 1])
+    assert len(endpoints) >= 2, "expected wall component to have endpoints"
+    out_info = [_outward_dir(comp_mask, ep) for ep in endpoints]
+    out_dirs = [d for d, _ in out_info]
+    tip_12 = [flag for _, flag in out_info]
+    rad = (_sgn(sum(d[0] for d in out_dirs)), _sgn(sum(d[1] for d in out_dirs)))
+    return {
+        "comp_mask": comp_mask,
+        "endpoints": endpoints,
+        "out_dirs": out_dirs,
+        "tip_12": tip_12,
+        "rad": rad,
+    }
+
+
+def _trace_ray(
+    start: tuple[int, int],
+    d: tuple[int, int],
+    rad: tuple[int, int],
+    is_12: bool,
+    shape: tuple[int, int],
+    stop_mask: np.ndarray | None,
+) -> tuple[list[tuple[int, int]], tuple[int, int] | None]:
+    h, w = shape
+    rr, cc = start
+    step = 0
+    path: list[tuple[int, int]] = []
+    while True:
+        step += 1
+        if not is_12 or step % 2 == 1:
+            nr = rr + d[0]
+            nc = cc + d[1]
+        else:
+            if rad[0] != 0:
+                nr = rr + d[0]
+                nc = cc
+            else:
+                nr = rr
+                nc = cc + d[1]
+        if not (0 <= nr < h and 0 <= nc < w):
+            return path, None
+        if stop_mask is not None and stop_mask[nr, nc]:
+            return path, (nr, nc)
+        path.append((nr, nc))
+        rr, cc = nr, nc
+
+
+def _trace_mover(
+    start: tuple[int, int],
+    rad: tuple[int, int],
+    shape: tuple[int, int],
+    stop_mask: np.ndarray | None,
+) -> dict:
+    h, w = shape
+    rr, cc = start
+    path: list[tuple[int, int]] = []
+    while True:
+        nr = rr + rad[0]
+        nc = cc + rad[1]
+        if not (0 <= nr < h and 0 <= nc < w):
+            return {"end": (rr, cc), "path": path, "hit": None}
+        if stop_mask is not None and stop_mask[nr, nc]:
+            return {"end": (rr, cc), "path": path, "hit": (nr, nc)}
+        rr, cc = nr, nc
+        path.append((rr, cc))
+
+
+def _parse_scene(grid: np.ndarray) -> dict:
+    g = np.array(grid, copy=True)
+    h, w = g.shape
+
+    vals = np.unique(g)
+    bg = get_bg(g)
+    non_bg = [int(v) for v in vals if int(v) != bg]
+    assert non_bg, "expected at least one non-background color"
+
+    wall = max(non_bg, key=lambda c: int((g == c).sum()))
+    wall_mask = g == wall
+    comps = _component_sets(wall_mask)
+    assert comps, "expected wall connected component(s)"
+
+    other_colors = [c for c in non_bg if c != wall]
+    assert other_colors, "expected at least one non-wall color"
+
+    wall_points = [p for comp in comps for p in comp]
+
+    def min_dist_to_wall(color: int) -> tuple[int, int]:
+        pts = [(int(r), int(c)) for r, c in zip(*np.where(g == color))]
+        best_d = 10**9
+        for r, c in pts:
+            for wr, wc in wall_points:
+                d = abs(r - wr) + abs(c - wc)
+                if d < best_d:
+                    best_d = d
+                    if best_d == 0:
+                        return 0, len(pts)
+        return best_d, len(pts)
+
+    fill = min(other_colors, key=lambda c: (min_dist_to_wall(c)[0], min_dist_to_wall(c)[1]))
+    fill_pos = [(int(r), int(c)) for r, c in zip(*np.where(g == fill))]
+    assert fill_pos, "expected a fill seed"
+
+    def comp_min_dist(comp: set[tuple[int, int]]) -> int:
+        best_d = 10**9
+        for r, c in fill_pos:
+            for wr, wc in comp:
+                d = abs(r - wr) + abs(c - wc)
+                if d < best_d:
+                    best_d = d
+                    if best_d == 0:
+                        return 0
+        return best_d
+
+    wall_comp = min(comps, key=lambda comp: (comp_min_dist(comp), -len(comp)))
+    ray_info = _component_ray_info(wall_comp, (h, w))
+    comp_mask = ray_info["comp_mask"]
+    other_wall_mask = wall_mask & (~comp_mask)
+    mover_mask = (g != bg) & (g != wall) & (g != fill)
+    mover_cells = [(int(r), int(c), int(g[r, c])) for r, c in zip(*np.where(mover_mask))]
+
+    return {
+        "grid": g,
+        "shape": (h, w),
+        "bg": bg,
+        "wall": wall,
+        "fill": fill,
+        "fill_pos": fill_pos,
+        "wall_mask": wall_mask,
+        "wall_comp": wall_comp,
+        "comp_mask": comp_mask,
+        "other_wall_mask": other_wall_mask,
+        "endpoints": ray_info["endpoints"],
+        "out_dirs": ray_info["out_dirs"],
+        "tip_12": ray_info["tip_12"],
+        "rad": ray_info["rad"],
+        "mover_mask": mover_mask,
+        "mover_cells": mover_cells,
+    }
+
+
+def _compute_stage1(scene: dict, *, stop_at_other_wall: bool) -> dict:
+    g = scene["grid"]
+    barrier = scene["comp_mask"].copy()
+    stop_mask = scene["other_wall_mask"] if stop_at_other_wall else None
+    ray_meta = []
+    for ep, d, is_12 in zip(scene["endpoints"], scene["out_dirs"], scene["tip_12"]):
+        path, hit = _trace_ray(ep, d, scene["rad"], is_12, scene["shape"], stop_mask)
+        for r, c in path:
+            barrier[r, c] = True
+        ray_meta.append(
+            {
+                "start": ep,
+                "dir": d,
+                "is_12": is_12,
+                "cells": path,
+                "hit": hit,
+            }
+        )
+
+    passable = (~barrier) & ((g == scene["bg"]) | (g == scene["fill"]) | scene["mover_mask"])
+    q = scene["fill_pos"][:]
+    seen = np.zeros_like(passable, dtype=bool)
+    for r, c in q:
+        if passable[r, c]:
+            seen[r, c] = True
+    while q:
+        r, c = q.pop()
+        for rr, cc in neighbors4(r, c):
+            if 0 <= rr < g.shape[0] and 0 <= cc < g.shape[1] and passable[rr, cc] and not seen[rr, cc]:
+                seen[rr, cc] = True
+                q.append((rr, cc))
+
+    fill_cover_mask = seen & ((g == scene["bg"]) | scene["mover_mask"])
+    out = g.copy()
+    out[fill_cover_mask] = scene["fill"]
+    return {
+        "out": out,
+        "fill_cover_mask": fill_cover_mask,
+        "seen": seen,
+        "barrier": barrier,
+        "ray_meta": ray_meta,
+    }
+
+
+def _solve(
+    grid: np.ndarray,
+    *,
+    stop_at_other_wall: bool,
+    movers_stop_at_wall: bool,
+    return_meta: bool = False,
+):
+    scene = _parse_scene(grid)
+    stage1 = _compute_stage1(scene, stop_at_other_wall=stop_at_other_wall)
+    out = stage1["out"].copy()
+    mover_meta = []
+
+    if scene["rad"] != (0, 0):
+        stop_mask = scene["wall_mask"] if movers_stop_at_wall else None
+        for r, c, color in sorted(scene["mover_cells"]):
+            traced = _trace_mover((r, c), scene["rad"], scene["shape"], stop_mask)
+            trail = [(r, c), *traced["path"]]
+            for rr, cc in trail:
+                out[rr, cc] = scene["bg"]
+            end_r, end_c = traced["end"]
+            out[end_r, end_c] = color
+            mover_meta.append(
+                {
+                    "start": (r, c),
+                    "end": (int(end_r), int(end_c)),
+                    "path": list(traced["path"]),
+                    "hit": traced["hit"],
+                    "color": color,
+                }
+            )
+
+    if return_meta:
+        return out, {"scene": scene, "stage1": stage1, "mover_meta": mover_meta}
+    return out
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Fill the seed-bearing funnel, then stop both the wedge rays and the straight movers when they meet another sprite.
+
+    Input structure:
+    - Background is the most common color. The wall color is the most common non-background color and forms multiple separated funnel-like wall sprites of that same color.
+    - One non-wall color nearest the wall is the fill seed inside one funnel. Any remaining non-background singleton pixels are movers placed in the outward corridor.
+
+    Rule:
+    - Select the wall component nearest the seed as the active funnel, flood-fill its interior, and radiate outward through its opening.
+    - Each boundary ray of that radiating wedge advances step by step but halts immediately before another wall sprite instead of extending to the grid edge.
+    - Then move each isolated mover straight in the same radiate direction, clearing its traversed cells to background and stopping at the last free cell before the first wall sprite on its line.
+
+    Key insight: The second wall sprite is the shared geometric stop signal. Its spacing from the active funnel simultaneously determines the wedge length and the mover travel distance.
+    """
+    return _solve(grid, stop_at_other_wall=True, movers_stop_at_wall=True)
+
+
+def _degree1_pixels(points: set[tuple[int, int]]) -> list[tuple[int, int]]:
+    pts = set(points)
+    return [(r, c) for r, c in pts if sum((rr, cc) in pts for rr, cc in neighbors8(r, c)) == 1]
+
+
+def _make_arm(depth: int, start_v: int, target_v: int, extra_steps: int, tip_12: bool = False) -> list[tuple[int, int]]:
+    sign = 1 if target_v > start_v else -1
+    n_side_steps = abs(target_v - start_v)
+    chosen_rows: list[int] = []
+    if n_side_steps:
+        if tip_12:
+            chosen_rows = [2 * (i + 1) for i in range(n_side_steps)]
+            extra_steps = 0
+        else:
+            chosen_rows = [1]
+            if n_side_steps > 1:
+                chosen_rows += random.sample(range(2, depth + 1), n_side_steps - 1)
+            chosen_rows.sort()
+
+    first_row = chosen_rows[0] if chosen_rows else 1
+    extra_rows = [r for r in chosen_rows if r != first_row]
+    random.shuffle(extra_rows)
+    orthogonal_rows = set(extra_rows[:extra_steps])
+
+    pts = [(0, start_v)]
+    u, v = 0, start_v
+    for row in range(1, depth + 1):
+        u += 1
+        if row in orthogonal_rows:
+            pts.append((u, v))
+            v += sign
+        elif row in chosen_rows:
+            v += sign
+        pts.append((u, v))
+    return pts
+
+
+def _build_local_wall(rad: tuple[int, int], h: int, w: int):
+    if rad[0]:
+        max_depth = min(DEPTH_VERT[1], h - EDGE_MARGIN - 3)
+        if max_depth < DEPTH_VERT[0]:
+            return None
+        depth = random.randint(DEPTH_VERT[0], max_depth)
+        gap = random.randint(*GAP_VERT)
+    else:
+        max_depth = min(DEPTH_HORIZ[1], w - EDGE_MARGIN - 3)
+        if max_depth < DEPTH_HORIZ[0]:
+            return None
+        depth = random.randint(DEPTH_HORIZ[0], max_depth)
+        gap = random.randint(GAP_HORIZ[0], min(GAP_HORIZ[1], h - 1))
+
+    if gap == 5:
+        left_bottom, right_bottom = 2, 3
+    elif gap == 6:
+        left_bottom, right_bottom = 2, 4
+    else:
+        left_bottom, right_bottom = random.choice([(2, 5), (3, 4)])
+
+    bridge_extra = max(0, right_bottom - left_bottom - 1)
+    base_count = 2 * (depth + 1) + bridge_extra
+    max_extra_l = max(0, left_bottom - 1)
+    max_extra_r = max(0, gap - right_bottom - 1)
+    min_extra = max(0, WALL_PIXELS_MIN - base_count)
+    max_extra = min(max_extra_l + max_extra_r, WALL_PIXELS_MAX - base_count)
+    if min_extra > max_extra:
+        return None
+
+    extra = random.randint(min_extra, max_extra)
+    extra_l = random.randint(max(0, extra - max_extra_r), min(max_extra_l, extra))
+    extra_r = extra - extra_l
+
+    max_n_side = max(left_bottom, gap - right_bottom)
+    tip_12 = depth >= 2 * max_n_side and random.random() < TIP_12_PROB
+    left = _make_arm(depth, 0, left_bottom, extra_l, tip_12=tip_12)
+    right = _make_arm(depth, gap, right_bottom, extra_r, tip_12=tip_12)
+    pts = set(left) | set(right)
+    for v in range(left_bottom, right_bottom + 1):
+        pts.add((depth, v))
+
+    while len(pts) < WALL_PIXELS_MIN:
+        candidates = [
+            (u, v)
+            for u in range(max(0, depth - 3), depth + 1)
+            for v in range(gap + 1)
+            if (u, v) not in pts
+            and sum(
+                (uu, vv) in pts
+                for uu in range(u - 1, u + 2)
+                for vv in range(v - 1, v + 2)
+                if (uu, vv) != (u, v)
+            ) >= 2
+        ]
+        random.shuffle(candidates)
+        added = False
+        for p in candidates:
+            trial = pts | {p}
+            if len(trial) <= WALL_PIXELS_MAX and len(_degree1_pixels(trial)) == 2:
+                pts = trial
+                added = True
+                break
+        if not added:
+            return None
+
+    if not (WALL_PIXELS_MIN <= len(pts) <= WALL_PIXELS_MAX) or len(_degree1_pixels(pts)) != 2:
+        return None
+    return pts, depth, gap
+
+
+def _map_local(u: int, v: int, rad: tuple[int, int], anchor: tuple[int, int]) -> tuple[int, int]:
+    r0, c0 = anchor
+    if rad == (-1, 0):
+        return r0 + u, c0 + v
+    if rad == (1, 0):
+        return r0 - u, c0 + v
+    if rad == (0, -1):
+        return r0 + v, c0 + u
+    return r0 + v, c0 - u
+
+
+def _place_anchor(rad: tuple[int, int], h: int, w: int, depth: int, gap: int):
+    if rad == (-1, 0):
+        lo, hi = EDGE_MARGIN, h - depth - 3
+        if lo > hi:
+            return None
+        return random.randint(lo, hi), random.randint(0, w - gap - 1)
+    if rad == (1, 0):
+        lo, hi = depth + 2, h - EDGE_MARGIN - 1
+        if lo > hi:
+            return None
+        return random.randint(lo, hi), random.randint(0, w - gap - 1)
+    if rad == (0, -1):
+        lo, hi = EDGE_MARGIN, w - depth - 3
+        if lo > hi:
+            return None
+        return random.randint(0, h - gap - 1), random.randint(lo, hi)
+    lo, hi = depth + 2, w - EDGE_MARGIN - 1
+    if lo > hi:
+        return None
+    return random.randint(0, h - gap - 1), random.randint(lo, hi)
+
+
+def _local_interior(wall: set[tuple[int, int]], depth: int, gap: int) -> list[tuple[int, int]]:
+    by_row: dict[int, list[int]] = {}
+    for u, v in wall:
+        by_row.setdefault(u, []).append(v)
+    interior = []
+    for u in range(1, depth):
+        if u not in by_row or len(by_row[u]) < 2:
+            continue
+        lo, hi = min(by_row[u]), max(by_row[u])
+        for v in range(lo + 1, hi):
+            if (u, v) not in wall:
+                interior.append((u, v))
+    return interior
+
+
+def _grow_seed_blob(seed: tuple[int, int], interior_set: set[tuple[int, int]]) -> set[tuple[int, int]]:
+    blob = {seed}
+    target_size = random.choice(SEED_SIZE_WEIGHTS)
+    frontier = [seed]
+    while len(blob) < target_size and frontier:
+        p = frontier.pop(random.randrange(len(frontier)))
+        u, v = p
+        for q in random.sample([(u - 1, v), (u + 1, v), (u, v - 1), (u, v + 1)], 4):
+            if q in interior_set and q not in blob:
+                blob.add(q)
+                frontier.append(q)
+                if len(blob) >= target_size:
+                    break
+    return blob
+
+
+def _translate_points(points: set[tuple[int, int]], rad: tuple[int, int], offset: int) -> set[tuple[int, int]]:
+    dr = rad[0] * offset
+    dc = rad[1] * offset
+    return {(r + dr, c + dc) for r, c in points}
+
+
+def _touches_border(mask: np.ndarray) -> bool:
+    return bool(mask[0, :].any() or mask[-1, :].any() or mask[:, 0].any() or mask[:, -1].any())
+
+
+def _chebyshev_far_enough(pos: tuple[int, int], placed: list[tuple[int, int]], min_sep: int) -> bool:
+    r, c = pos
+    return all(max(abs(r - rr), abs(c - cc)) >= min_sep for rr, cc in placed)
+
+
+def _variant_metrics(grid: np.ndarray) -> dict:
+    scene = _parse_scene(grid)
+    stage_stop = _compute_stage1(scene, stop_at_other_wall=True)
+    stage_edge = _compute_stage1(scene, stop_at_other_wall=False)
+
+    stop_mask = scene["wall_mask"]
+    mover_stop_steps = []
+    mover_edge_steps = []
+    mover_hits = 0
+    mover_delta_total = 0
+    for r, c, _color in scene["mover_cells"]:
+        stop_trace = _trace_mover((r, c), scene["rad"], scene["shape"], stop_mask)
+        edge_trace = _trace_mover((r, c), scene["rad"], scene["shape"], None)
+        mover_stop_steps.append(len(stop_trace["path"]))
+        mover_edge_steps.append(len(edge_trace["path"]))
+        if stop_trace["hit"] is not None:
+            mover_hits += 1
+            mover_delta_total += len(edge_trace["path"]) - len(stop_trace["path"])
+
+    stage_stop_fill = int(((stage_stop["out"] == scene["fill"]) & (scene["grid"] == scene["bg"])).sum())
+    stage_edge_fill = int(((stage_edge["out"] == scene["fill"]) & (scene["grid"] == scene["bg"])).sum())
+    ray_hits = sum(1 for item in stage_stop["ray_meta"] if item["hit"] is not None)
+
+    return {
+        "ray_hit_count": ray_hits,
+        "ray_fill_delta": stage_edge_fill - stage_stop_fill,
+        "mover_count": len(scene["mover_cells"]),
+        "mover_hit_count": mover_hits,
+        "mover_delta_total": mover_delta_total,
+        "avg_stop_steps": float(np.mean(mover_stop_steps)) if mover_stop_steps else 0.0,
+        "avg_edge_steps": float(np.mean(mover_edge_steps)) if mover_edge_steps else 0.0,
+    }
+
+
+def _candidate_movers(base_grid: np.ndarray, stage1_meta: dict) -> list[dict]:
+    scene = stage1_meta["scene"]
+    fill_color = scene["fill"]
+    wall_mask = scene["wall_mask"]
+    stop_mask = wall_mask
+    rad = scene["rad"]
+    h, w = base_grid.shape
+
+    wall_dist = distance_transform_cdt(~wall_mask, metric="taxicab")
+    nominal_fill = stage1_meta["stage1"]["out"] == fill_color
+    eligible = (base_grid == scene["bg"]) & nominal_fill & (wall_dist >= MOVER_MIN_WALL_DIST)
+
+    records = []
+    for r, c in zip(*np.where(eligible)):
+        start = (int(r), int(c))
+        stop_trace = _trace_mover(start, rad, (h, w), stop_mask)
+        edge_trace = _trace_mover(start, rad, (h, w), None)
+        if stop_trace["hit"] is None:
+            continue
+        if len(stop_trace["path"]) < MOVER_MIN_TRAVEL:
+            continue
+        if len(edge_trace["path"]) - len(stop_trace["path"]) < MOVER_PATH_DELTA_MIN:
+            continue
+        cells = [start, *stop_trace["path"]]
+        if not all(nominal_fill[rr, cc] for rr, cc in cells):
+            continue
+        footprint = set(cells)
+        records.append(
+            {
+                "start": start,
+                "end": tuple(map(int, stop_trace["end"])),
+                "hit": tuple(map(int, stop_trace["hit"])) if stop_trace["hit"] is not None else None,
+                "path": list(stop_trace["path"]),
+                "footprint": footprint,
+                "delta": len(edge_trace["path"]) - len(stop_trace["path"]),
+            }
+        )
+
+    random.shuffle(records)
+    records.sort(key=lambda rec: (rec["delta"], len(rec["path"])), reverse=True)
+    return records
+
+
+def _pick_movers(records: list[dict]) -> list[dict]:
+    if len(records) < MIN_MOVERS:
+        return []
+    target_n = random.randint(MIN_MOVERS, min(MAX_MOVERS, len(records)))
+    chosen = []
+    used_starts: list[tuple[int, int]] = []
+    used_ends: list[tuple[int, int]] = []
+    occupied: set[tuple[int, int]] = set()
+    for rec in records:
+        if rec["footprint"] & occupied:
+            continue
+        if rec["start"] in used_ends or rec["end"] in used_starts:
+            continue
+        if not _chebyshev_far_enough(rec["start"], used_starts, MOVER_MIN_SEP):
+            continue
+        if not _chebyshev_far_enough(rec["end"], used_ends, 1):
+            continue
+        chosen.append(rec)
+        used_starts.append(rec["start"])
+        used_ends.append(rec["end"])
+        occupied |= rec["footprint"]
+        if len(chosen) >= target_n:
+            break
+    if len(chosen) < MIN_MOVERS:
+        return []
+    return chosen
+
+
+def _gen_attempt():
+    rad = random.choice([(-1, 0), (1, 0), (0, -1), (0, 1)])
+    h = random.randint(*GRID_H_VERT) if rad[0] else random.randint(*GRID_H_HORIZ)
+    w = random.randint(*GRID_W)
+
+    built = _build_local_wall(rad, h, w)
+    if built is None:
+        return None
+    local_wall, depth, gap = built
+    anchor = _place_anchor(rad, h, w, depth, gap)
+    if anchor is None:
+        return None
+
+    palette = random.sample(range(10), random.randint(*PALETTE_SIZE))
+    bg, wall_color, fill_color = palette[:3]
+    mover_colors = palette[3:]
+    if len(mover_colors) < 1:
+        mover_colors = random.sample([c for c in range(10) if c not in (bg, wall_color, fill_color)], 2)
+
+    active_pts = set()
+    for u, v in local_wall:
+        active_pts.add(_map_local(u, v, rad, anchor))
+
+    offset = random.randint(BLOCKER_OFFSET_MIN, BLOCKER_OFFSET_MAX)
+    blocker_pts = _translate_points(active_pts, rad, offset)
+    if any(not (0 <= r < h and 0 <= c < w) for r, c in blocker_pts):
+        return None
+    if active_pts & blocker_pts:
+        return None
+
+    grid = np.full((h, w), bg, dtype=int)
+    for r, c in active_pts | blocker_pts:
+        grid[r, c] = wall_color
+    if len(_component_sets(grid == wall_color)) != 2:
+        return None
+
+    interior = _local_interior(local_wall, depth, gap)
+    wall_set = set(local_wall)
+    adjacent = [
+        p
+        for p in interior
+        if any((p[0] + dr, p[1] + dc) in wall_set for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)])
+    ]
+    seed_pool = [p for p in adjacent if p[0] >= max(1, depth - SEED_DEPTH_LOOKBACK)]
+    if not seed_pool:
+        return None
+
+    blob = _grow_seed_blob(random.choice(seed_pool), set(interior))
+    for u, v in blob:
+        r, c = _map_local(u, v, rad, anchor)
+        if grid[r, c] != bg:
+            return None
+        grid[r, c] = fill_color
+
+    try:
+        base_stage_stop_out, base_stage_stop_meta = _solve(
+            grid, stop_at_other_wall=True, movers_stop_at_wall=True, return_meta=True
+        )
+        base_stage_edge_out, base_stage_edge_meta = _solve(
+            grid, stop_at_other_wall=False, movers_stop_at_wall=False, return_meta=True
+        )
+    except Exception:
+        return None
+
+    if base_stage_stop_meta["mover_meta"]:
+        return None
+
+    ray_hits = [item["hit"] is not None for item in base_stage_stop_meta["stage1"]["ray_meta"]]
+    if sum(ray_hits) < 2:
+        return None
+
+    fused_fill = (base_stage_stop_meta["stage1"]["out"] == fill_color) & (grid == bg)
+    edge_fill = (base_stage_edge_meta["stage1"]["out"] == fill_color) & (grid == bg)
+    if int(fused_fill.sum()) < MIN_NEW_FILL:
+        return None
+    if int(edge_fill.sum()) - int(fused_fill.sum()) < MIN_RAY_FILL_DELTA:
+        return None
+
+    candidates = _candidate_movers(grid, base_stage_stop_meta)
+    chosen = _pick_movers(candidates)
+    if len(chosen) < MIN_MOVERS:
+        return None
+
+    for i, rec in enumerate(chosen):
+        r, c = rec["start"]
+        grid[r, c] = mover_colors[i % len(mover_colors)]
+
+    try:
+        fused_out, fused_meta = _solve(
+            grid, stop_at_other_wall=True, movers_stop_at_wall=True, return_meta=True
+        )
+        ray_only_out = _solve(grid, stop_at_other_wall=True, movers_stop_at_wall=False)
+        mover_only_out = _solve(grid, stop_at_other_wall=False, movers_stop_at_wall=True)
+        original_out = _solve(grid, stop_at_other_wall=False, movers_stop_at_wall=False)
+    except Exception:
+        return None
+
+    if np.array_equal(fused_out, ray_only_out):
+        return None
+    if np.array_equal(fused_out, mover_only_out):
+        return None
+    if np.array_equal(fused_out, original_out):
+        return None
+
+    metrics = _variant_metrics(grid)
+    if metrics["ray_hit_count"] < 2:
+        return None
+    if metrics["mover_hit_count"] < MIN_MOVERS:
+        return None
+    if metrics["mover_delta_total"] < MIN_MOVERS * MOVER_PATH_DELTA_MIN:
+        return None
+    if metrics["ray_fill_delta"] < MIN_RAY_FILL_DELTA:
+        return None
+
+    new_fill = (fused_out == fill_color) & (grid == bg)
+    if int(new_fill.sum()) < MIN_NEW_FILL:
+        return None
+
+    mover_by_start = {item["start"]: item for item in fused_meta["mover_meta"]}
+    for rec in chosen:
+        if rec["start"] not in mover_by_start:
+            return None
+        meta_item = mover_by_start[rec["start"]]
+        if tuple(meta_item["end"]) != rec["end"]:
+            return None
+        if meta_item["hit"] is None:
+            return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate valid b9e38dc0 combo D2/1+D5/0 input")

