+def _compute_stage1(scene: dict, *, stop_at_other_wall: bool) -> dict:
+    g = scene["grid"]
+    barrier = scene["comp_mask"].copy()
+    stop_mask = scene["other_wall_mask"] if stop_at_other_wall else None
+    ray_meta = []
+    for ep, d, is_12 in zip(scene["endpoints"], scene["out_dirs"], scene["tip_12"]):
+        path, hit = _trace_ray(ep, d, scene["rad"], is_12, scene["shape"], stop_mask)
+        for r, c in path:
+            barrier[r, c] = True
+        ray_meta.append(
+            {
+                "start": ep,
+                "dir": d,
+                "is_12": is_12,
+                "cells": path,
+                "hit": hit,
+            }
+        )
+
+    passable = (~barrier) & ((g == scene["bg"]) | (g == scene["fill"]) | scene["mover_mask"])
+    q = scene["fill_pos"][:]
+    seen = np.zeros_like(passable, dtype=bool)
+    for r, c in q:
+        if passable[r, c]:
+            seen[r, c] = True
+    while q:
+        r, c = q.pop()
+        for rr, cc in neighbors4(r, c):
+            if 0 <= rr < g.shape[0] and 0 <= cc < g.shape[1] and passable[rr, cc] and not seen[rr, cc]:
+                seen[rr, cc] = True
+                q.append((rr, cc))
+
+    fill_cover_mask = seen & ((g == scene["bg"]) | scene["mover_mask"])
+    out = g.copy()
+    out[fill_cover_mask] = scene["fill"]
+    return {
+        "out": out,
+        "fill_cover_mask": fill_cover_mask,
+        "seen": seen,
+        "barrier": barrier,
+        "ray_meta": ray_meta,
+    }
+
+
+def _solve(
+    grid: np.ndarray,
+    *,
+    stop_at_other_wall: bool,
+    movers_stop_at_wall: bool,
+    return_meta: bool = False,
+):
