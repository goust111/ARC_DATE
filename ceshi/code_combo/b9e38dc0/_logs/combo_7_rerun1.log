+
+    fused_fill = (base_stage_stop_meta["stage1"]["out"] == fill_color) & (grid == bg)
+    edge_fill = (base_stage_edge_meta["stage1"]["out"] == fill_color) & (grid == bg)
+    if int(fused_fill.sum()) < MIN_NEW_FILL:
