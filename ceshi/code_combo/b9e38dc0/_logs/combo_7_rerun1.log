+        base_stage_stop_out, base_stage_stop_meta = _solve(
+            grid, stop_at_other_wall=True, movers_stop_at_wall=True, return_meta=True
+        )
+        base_stage_edge_out, base_stage_edge_meta = _solve(
+            grid, stop_at_other_wall=False, movers_stop_at_wall=False, return_meta=True
+        )
+    except Exception:
+        return None
+
+    if base_stage_stop_meta["mover_meta"]:
+        return None
+
+    ray_hits = [item["hit"] is not None for item in base_stage_stop_meta["stage1"]["ray_meta"]]
+    if sum(ray_hits) < 2:
