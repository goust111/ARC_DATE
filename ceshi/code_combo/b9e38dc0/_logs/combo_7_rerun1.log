+    if any(not (0 <= r < h and 0 <= c < w) for r, c in blocker_pts):
+        return None
+    if active_pts & blocker_pts:
+        return None
+
+    grid = np.full((h, w), bg, dtype=int)
+    for r, c in active_pts | blocker_pts:
