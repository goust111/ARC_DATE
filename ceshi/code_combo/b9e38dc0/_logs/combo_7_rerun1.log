    out = g.copy()
    out[filled_mask] = scene["fill"]

    obstacles = (g != scene["bg"]) & (g != scene["fill"]) & (g != scene["wall"])

    def shadow_process(coords: list[tuple[int, int]]) -> None:
        started = False
        blocked = False
        for r, c in coords:
            if filled_mask[r, c]:
                started = True
            if started and obstacles[r, c]:
                blocked = True
