+GRID_H_VERT = (15, 18)
+GRID_H_HORIZ = (10, 18)
+GRID_W = (17, 19)
+
+WALL_PIXELS_MIN = 17
+WALL_PIXELS_MAX = 25
+DEPTH_VERT = (5, 7)
+DEPTH_HORIZ = (5, 7)
+GAP_VERT = (6, 7)
+GAP_HORIZ = (5, 7)
+TIP_12_PROB = 0.5
+
+BLOCKER_OFFSET_MIN = 4
+BLOCKER_OFFSET_MAX = 6
+EDGE_MARGIN = BLOCKER_OFFSET_MAX + 2
+
+SEED_SIZE_WEIGHTS = [1, 1, 1, 1, 2, 2, 3, 4, 5, 6]
+SEED_DEPTH_LOOKBACK = 3
+
+MIN_MOVERS = 2
+MAX_MOVERS = 4
+MOVER_MIN_TRAVEL = 3
+MOVER_MIN_WALL_DIST = 3
+MOVER_PATH_DELTA_MIN = 2
+MOVER_MIN_SEP = 2
