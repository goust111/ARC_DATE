+# --------------- generator ---------------
+
+# Canvas size bounds
+GRID_H_VERT = (11, 18)
+GRID_H_HORIZ = (8, 18)
+GRID_W = (15, 19)
+
+# Wall geometry
+WALL_PIXELS_MIN = 17
+WALL_PIXELS_MAX = 25
+DEPTH_VERT = (5, 10)
+DEPTH_HORIZ = (6, 8)
+GAP_VERT = (6, 7)
+GAP_HORIZ = (5, 7)
+TIP_12_PROB = 0.5
+
+# Placement
+OPEN_END_MARGIN = 5
+
+# Source blob and interior count control
+SEED_DEPTH_LOOKBACK = 3
+INTERIOR_TOTAL_RANGE = (4, 12)
+AREA_RANGE = (2, 6)
+SOURCE_RANGE = (2, 6)
+
+# Obstacles
+MAX_OBSTACLES = 3
+OBSTACLE_IN_RADIATE_PROB = 0.55
+OBSTACLE_MIN_SEP = 2
+
+# Validation
+MIN_NEW_FILL = 8
+PALETTE_SIZE = (3, 5)
