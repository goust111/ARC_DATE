+
+def _find_obstacle_candidates(
+    grid: np.ndarray, bg: int, wall_color: int, preferred_zone: np.ndarray
+) -> tuple[list[tuple[int, int]], list[tuple[int, int]]]:
+    wall_mask = grid == wall_color
+    dist = distance_transform_cdt(~wall_mask, metric="taxicab")
+    far_from_wall = dist > 1
+    eligible = (grid == bg) & far_from_wall
+    all_coords = [(int(r), int(c)) for r, c in zip(*np.where(eligible))]
+    preferred = [p for p in all_coords if preferred_zone[p[0], p[1]]]
+    random.shuffle(all_coords)
+    random.shuffle(preferred)
+    return all_coords, preferred
+
+
+def _place_obstacles(
+    n_obstacles: int,
+    candidates: list[tuple[int, int]],
+    preferred: list[tuple[int, int]],
+    obstacle_colors: list[int],
+    grid: np.ndarray,
+) -> None:
+    placed: list[tuple[int, int]] = []
+    want_preferred = 0
+    if preferred and random.random() < OBSTACLE_IN_RADIATE_PROB:
+        want_preferred = random.randint(1, min(n_obstacles, len(preferred)))
+    for p in preferred:
+        if len(placed) >= want_preferred:
+            break
+        if _obstacle_fits(p, placed):
+            placed.append(p)
+    placed_set = set(placed)
+    for p in candidates:
+        if len(placed) >= n_obstacles:
+            break
+        if p not in placed_set and _obstacle_fits(p, placed):
+            placed.append(p)
+            placed_set.add(p)
+    for i, (r, c) in enumerate(placed):
+        grid[r, c] = obstacle_colors[i % len(obstacle_colors)]
+
+
+def _gen_attempt() -> np.ndarray | None:
+    rad = random.choice([(-1, 0), (1, 0), (0, -1), (0, 1)])
+    h = random.randint(*GRID_H_VERT) if rad[0] else random.randint(*GRID_H_HORIZ)
+    w = random.randint(*GRID_W)
+
+    built = _build_local_wall(rad, h, w)
+    if built is None:
+        return None
+    local_wall, depth, gap = built
+    anchor = _place_anchor(rad, h, w, depth, gap)
+
+    palette = random.sample(range(10), random.randint(*PALETTE_SIZE))
+    bg, wall_color, fill_color = palette[:3]
+    obstacle_colors = palette[3:]
+
+    grid = np.full((h, w), bg, dtype=int)
+    for u, v in local_wall:
+        r, c = _map_local(u, v, rad, anchor)
+        grid[r, c] = wall_color
+
+    interior = _local_interior(local_wall, depth, gap)
+    interior_total = len(interior)
+    if not (INTERIOR_TOTAL_RANGE[0] <= interior_total <= INTERIOR_TOTAL_RANGE[1]):
+        return None
+
+    desired_relation = random.choices(
+        ["area_smaller", "source_smaller", "tie"],
+        weights=[4, 4, 1],
+        k=1,
+    )[0]
+    counts = _choose_seed_and_area(interior_total, desired_relation)
+    if counts is None:
+        return None
+    source_target, _area_target = counts
+
+    wall_set = set(local_wall)
+    adjacent = [
+        p
+        for p in interior
+        if any((p[0] + dr, p[1] + dc) in wall_set for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)])
+    ]
+    seed_pool = [p for p in adjacent if p[0] >= max(1, depth - SEED_DEPTH_LOOKBACK)]
+    if not seed_pool:
+        return None
+
+    blob = _grow_seed_blob(random.choice(seed_pool), set(interior), source_target)
+    if len(blob) != source_target:
+        return None
+    for u, v in blob:
+        r, c = _map_local(u, v, rad, anchor)
+        if grid[r, c] != bg:
+            return None
+        grid[r, c] = fill_color
+
+    base_info = _detect_scene(grid)
+    if base_info["source_count"] < SOURCE_RANGE[0]:
+        return None
+    if not (AREA_RANGE[0] <= base_info["interior_new_area"] <= AREA_RANGE[1]):
+        return None
+    if desired_relation == "area_smaller" and not (base_info["interior_new_area"] < base_info["source_count"]):
+        return None
+    if desired_relation == "source_smaller" and not (base_info["source_count"] < base_info["interior_new_area"]):
+        return None
+    if desired_relation == "tie" and base_info["source_count"] != base_info["interior_new_area"]:
+        return None
+    if base_info["max_depth"] <= base_info["ray_limit"]:
+        return None
+    if int(base_info["limited_exterior_mask"].sum()) < 2 or int(base_info["beyond_limit_mask"].sum()) < 2:
+        return None
+
+    n_obstacles = random.randint(0, MAX_OBSTACLES)
+    if n_obstacles and not obstacle_colors:
+        available = [c for c in range(10) if c not in (bg, wall_color, fill_color)]
+        obstacle_colors = random.sample(available, random.randint(1, 2))
+    if n_obstacles:
+        candidates, preferred = _find_obstacle_candidates(grid, bg, wall_color, base_info["limited_exterior_mask"])
+        _place_obstacles(n_obstacles, candidates, preferred, obstacle_colors, grid)
+
+    try:
+        limited = main(grid)
+        full = _solve(grid, use_full_radiation=True)
+    except Exception:
+        return None
+    if np.array_equal(limited, full):
+        return None
+
+    new_fill = (limited == fill_color) & (grid == bg)
+    final_info = _detect_scene(grid)
+    outside_fill = new_fill & final_info["exterior_bg_mask"]
+    if int(new_fill.sum()) < MIN_NEW_FILL or int(outside_fill.sum()) < 2:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate valid fused b9e38dc0 input")

diff --git a/ceshi/code_combo/b9e38dc0/5/code.py b/ceshi/code_combo/b9e38dc0/5/code.py
new file mode 100644
index 0000000000000000000000000000000000000000..aa932e7a0a788611cf442a9bef335b28984cf1bf
--- /dev/null
+++ b/ceshi/code_combo/b9e38dc0/5/code.py
@@ -0,0 +1,673 @@
+# Combo variant of b9e38dc0 (index 5)
+# combo_spec: D3/2+D5/1
+# Name: 射线长度等于填充面积+像素计数终止
+
+from __future__ import annotations
+
+import random
+
+import numpy as np
+from scipy.ndimage import distance_transform_cdt
+
+from arc_utils import components_mask, get_bg, neighbors4, neighbors8
+
+
+# Design analysis for the fused variant.
+#
+# a) Concrete behavior:
+#    Keep the original wall detection and the same wedge-shaped reachability zone bounded by
+#    endpoint rays. The changed part is only how far the outward radiation is allowed to travel.
+#    Example: if the half-enclosed interior gains A=3 new cells when flood-filled and the input
+#    contains S=5 source-color seed cells, then the exterior radiation paints only the first
+#    L=min(A, S)=3 layers beyond the opening. Under the original rule it would keep going to the
+#    edge; under the fused rule the geometry is the same but the visible depth is clipped.
+#
+# b) Complexity calibration:
+#    A pure edge-reaching version would make the D3/2 area signal invisible. To avoid that, the
+#    generator rejects cases where the limited solver matches the full-edge solver. It also keeps
+#    seed size and interior area in a small repeated range so humans can count them from a few
+#    examples and notice that the smaller value wins.
+#
+# c) Hidden-assumption audit:
+#    - Original code assumed outward fill should touch the border; that is no longer true.
+#    - Original code relied on one wall component nearest the seed and exactly two degree-1 tips;
+#      the generator still enforces that geometry.
+#    - Original code used full-length endpoint rays only as barriers. That remains valid here:
+#      they still define the maximal wedge, while the new numeric rule clips paint depth inside
+#      that wedge.
+#    - Shadow logic still scans along radiate_dir. The generator avoids placing obstacles inside
+#      the counted interior so that "fill area" remains legible.
+#
+# d) Placement legality:
+#    The wall is placed by local coordinates and checked before painting. Seed pixels are grown
+#    only inside the enclosure. Obstacles are sampled from background cells that are far enough
+#    from the wall and from each other, so no overlap or out-of-bounds placement occurs.
+#
+# e/f/g) Observability and cleanliness:
+#    Inputs expose S directly as the size of the source blob. Outputs expose A as the number of
+#    newly filled interior cells. With 2-4 examples a human can compare the visible outward depth
+#    against both counts and infer the min-rule. Colors are not used as hidden ordering keys; the
+#    task is carried by wall geometry, seed size, interior area, and clipped radiation length.
+
+
+def _sgn(x: int) -> int:
+    return (x > 0) - (x < 0)
+
+
+def _trace_ray(start: tuple[int, int], d: tuple[int, int], is_12: bool, rad: tuple[int, int], h: int, w: int) -> list[tuple[int, int]]:
+    rr, cc = start
+    out: list[tuple[int, int]] = []
+    step = 0
+    while True:
+        step += 1
+        if is_12:
+            if step % 2 == 1:
+                rr += d[0]
+                cc += d[1]
+            else:
+                if rad[0] != 0:
+                    rr += d[0]
+                else:
+                    cc += d[1]
+        else:
+            rr += d[0]
+            cc += d[1]
+        if not (0 <= rr < h and 0 <= cc < w):
+            break
+        out.append((rr, cc))
+    return out
+
+
+def _detect_scene(grid: np.ndarray) -> dict:
+    g = np.array(grid, copy=True)
+    h, w = g.shape
+    bg = get_bg(g)
+    vals = [int(v) for v in np.unique(g)]
+    non_bg = [v for v in vals if v != bg]
+    assert non_bg, "expected non-background colors"
+
+    wall = max(non_bg, key=lambda c: int((g == c).sum()))
+    wall_mask = g == wall
+    comps = [set((int(r), int(c)) for r, c in pts) for pts in components_mask(wall_mask, connectivity=8)]
+    assert comps, "expected wall components"
+
+    other_colors = [c for c in non_bg if c != wall]
+    assert other_colors, "expected a source color"
+
+    wall_points = [p for comp in comps for p in comp]
+
+    def min_dist_to_wall(color: int) -> tuple[int, int]:
+        pts = [(int(r), int(c)) for r, c in zip(*np.where(g == color))]
+        best_d = 10**9
+        for r, c in pts:
+            for wr, wc in wall_points:
+                d = abs(r - wr) + abs(c - wc)
+                if d < best_d:
+                    best_d = d
+                    if best_d == 0:
+                        return 0, len(pts)
+        return best_d, len(pts)
+
+    fill = min(other_colors, key=lambda c: (min_dist_to_wall(c)[0], min_dist_to_wall(c)[1]))
+    fill_pos = [(int(r), int(c)) for r, c in zip(*np.where(g == fill))]
+    assert fill_pos, "expected source pixels"
+
+    def comp_min_dist(comp: set[tuple[int, int]]) -> int:
+        best_d = 10**9
+        for r, c in fill_pos:
+            for wr, wc in comp:
+                d = abs(r - wr) + abs(c - wc)
+                if d < best_d:
+                    best_d = d
+                    if best_d == 0:
+                        return 0
+        return best_d
+
+    wall_comp = min(comps, key=lambda comp: (comp_min_dist(comp), -len(comp)))
+    comp_mask = np.zeros_like(wall_mask, dtype=bool)
+    for r, c in wall_comp:
+        comp_mask[r, c] = True
+
+    def comp_neighbors(r: int, c: int) -> list[tuple[int, int]]:
+        out = []
+        for rr, cc in neighbors8(r, c):
+            if 0 <= rr < h and 0 <= cc < w and comp_mask[rr, cc]:
+                out.append((rr, cc))
+        return out
+
+    endpoints = [(r, c) for r, c in wall_comp if len(comp_neighbors(r, c)) == 1]
+    assert len(endpoints) >= 2, "expected wall endpoints"
+
+    def outward_dir(ep: tuple[int, int]) -> tuple[tuple[int, int], bool]:
+        n1 = comp_neighbors(*ep)[0]
+        d1 = (_sgn(n1[0] - ep[0]), _sgn(n1[1] - ep[1]))
+        d_use = d1
+        is_12 = False
+        n2s = [p for p in comp_neighbors(*n1) if p != ep]
+        if n2s:
+            n2 = n2s[0]
+            d2 = (_sgn(n2[0] - n1[0]), _sgn(n2[1] - n1[1]))
+            if (d1[0] == 0) ^ (d1[1] == 0) and d2[0] != 0 and d2[1] != 0:
+                d_use = d2
+                is_12 = True
+        return (-d_use[0], -d_use[1]), is_12
+
+    out_info = [outward_dir(ep) for ep in endpoints]
+    out_dirs = [d for d, _ in out_info]
+    tip_12 = [flag for _, flag in out_info]
+    rad = (_sgn(sum(d[0] for d in out_dirs)), _sgn(sum(d[1] for d in out_dirs)))
+    assert rad != (0, 0), "expected a radiate direction"
+
+    barrier = comp_mask.copy()
+    for ep, d, is_12 in zip(endpoints, out_dirs, tip_12):
+        for rr, cc in _trace_ray(ep, d, is_12, rad, h, w):
+            barrier[rr, cc] = True
+
+    passable = (~barrier) & ((g == bg) | (g == fill))
+    seen = np.zeros_like(passable, dtype=bool)
+    stack = fill_pos[:]
+    for r, c in fill_pos:
+        if passable[r, c]:
+            seen[r, c] = True
+    while stack:
+        r, c = stack.pop()
+        for rr, cc in neighbors4(r, c):
+            if 0 <= rr < h and 0 <= cc < w and passable[rr, cc] and not seen[rr, cc]:
+                seen[rr, cc] = True
+                stack.append((rr, cc))
+
+    rows = np.arange(h)[:, None]
+    cols = np.arange(w)[None, :]
+    if rad == (-1, 0):
+        mouth = min(r for r, _ in endpoints)
+        depth = mouth - rows
+    elif rad == (1, 0):
+        mouth = max(r for r, _ in endpoints)
+        depth = rows - mouth
+    elif rad == (0, -1):
+        mouth = min(c for _, c in endpoints)
+        depth = mouth - cols
+    else:
+        mouth = max(c for _, c in endpoints)
+        depth = cols - mouth
+
+    depth = np.broadcast_to(depth.astype(int), g.shape)
+    outward_geom = depth > 0
+    reachable_bg = seen & (g == bg)
+    interior_bg_mask = reachable_bg & (~outward_geom)
+    exterior_bg_mask = reachable_bg & outward_geom
+    interior_new_area = int(interior_bg_mask.sum())
+    source_count = int(len(fill_pos))
+    ray_limit = min(interior_new_area, source_count)
+    limited_exterior_mask = exterior_bg_mask & (depth <= ray_limit)
+    beyond_limit_mask = exterior_bg_mask & (depth > ray_limit)
+    max_depth = int(depth[exterior_bg_mask].max()) if np.any(exterior_bg_mask) else 0
+
+    return {
+        "grid": g,
+        "bg": bg,
+        "wall": wall,
+        "fill": fill,
+        "fill_pos": fill_pos,
+        "rad": rad,
+        "depth": depth,
+        "reachable_bg": reachable_bg,
+        "interior_bg_mask": interior_bg_mask,
+        "exterior_bg_mask": exterior_bg_mask,
+        "limited_exterior_mask": limited_exterior_mask,
+        "beyond_limit_mask": beyond_limit_mask,
+        "interior_new_area": interior_new_area,
+        "source_count": source_count,
+        "ray_limit": ray_limit,
+        "max_depth": max_depth,
+    }
+
+
+def _apply_shadows(out: np.ndarray, filled_mask: np.ndarray, obstacles: np.ndarray, rad: tuple[int, int]) -> None:
+    h, w = out.shape
+
+    bg = get_bg(out)
+
+    def clear_cell(r: int, c: int) -> None:
+        out[r, c] = bg
+        filled_mask[r, c] = False
+
+    def shadow_process(coords: list[tuple[int, int]]) -> None:
+        started = False
+        blocked = False
+        for r, c in coords:
+            if filled_mask[r, c]:
+                started = True
+            if started and obstacles[r, c]:
+                blocked = True
+                continue
+            if blocked and filled_mask[r, c]:
+                clear_cell(r, c)
+
+    dr, dc = rad
+    if dr != 0 and dc == 0:
+        for c in range(w):
+            rows = range(h) if dr > 0 else range(h - 1, -1, -1)
+            shadow_process([(r, c) for r in rows])
+    elif dc != 0 and dr == 0:
+        for r in range(h):
+            cols = range(w) if dc > 0 else range(w - 1, -1, -1)
+            shadow_process([(r, c) for c in cols])
+    elif dr == dc:
+        for k in range(-(w - 1), h):
+            coords = [(r, r - k) for r in range(h) if 0 <= r - k < w]
+            coords.sort(key=lambda rc: rc[0], reverse=(dr < 0))
+            shadow_process(coords)
+    else:
+        for k in range(h + w - 1):
+            coords = [(r, k - r) for r in range(h) if 0 <= k - r < w]
+            coords.sort(key=lambda rc: rc[0], reverse=(dr < 0))
+            shadow_process(coords)
+
+
+def _solve(grid: np.ndarray, use_full_radiation: bool) -> np.ndarray:
+    info = _detect_scene(grid)
+    g = info["grid"]
+    out = g.copy()
+    filled_mask = info["interior_bg_mask"].copy()
+    if use_full_radiation:
+        filled_mask |= info["exterior_bg_mask"]
+    else:
+        filled_mask |= info["limited_exterior_mask"]
+    out[filled_mask] = info["fill"]
+
+    obstacles = (g != info["bg"]) & (g != info["fill"]) & (g != info["wall"])
+    _apply_shadows(out, filled_mask, obstacles, info["rad"])
+    return out
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Fill the semi-enclosed chamber and emit a numerically clipped radiation plume through its opening.
+
+    Input structure:
+    - The background is the dominant color. The most common non-background color is a single wall sprite
+      shaped like an open funnel or U, and a nearby non-wall color blob sits inside that chamber.
+    - Optional extra non-background pixels are obstacles; they stay fixed and can cast shadows along the
+      outward radiation axis.
+
+    Rule:
+    - First flood-fill all reachable background cells inside the chamber with the source color.
+    - Then continue outward through the opening, but only for L layers in the radiate direction, where
+      L = min(internal newly filled area, number of source pixels in the input blob).
+    - Any obstacle encountered in the fill zone blocks later fill on the same radiate scanline, turning
+      those blocked cells back to background.
+
+    Key insight:
+    - The wall endpoints still define the opening direction and the maximal wedge. The fused variant changes
+      only the stopping rule: compute two counts from the chamber, take the smaller one, and use that as the
+      radiation depth instead of extending all the way to the grid edge.
+    """
+    return _solve(np.asarray(grid, dtype=int), use_full_radiation=False)
+
+
+# --------------- generator ---------------
+
+# Canvas size bounds
+GRID_H_VERT = (11, 18)
+GRID_H_HORIZ = (8, 18)
+GRID_W = (15, 19)
+
+# Wall geometry
+WALL_PIXELS_MIN = 17
+WALL_PIXELS_MAX = 25
+DEPTH_VERT = (5, 10)
+DEPTH_HORIZ = (6, 8)
+GAP_VERT = (6, 7)
+GAP_HORIZ = (5, 7)
+TIP_12_PROB = 0.5
+
+# Placement
+OPEN_END_MARGIN = 5
+
+# Source blob and interior count control
+SEED_DEPTH_LOOKBACK = 3
+INTERIOR_TOTAL_RANGE = (4, 12)
+AREA_RANGE = (2, 6)
+SOURCE_RANGE = (2, 6)
+
+# Obstacles
+MAX_OBSTACLES = 3
+OBSTACLE_IN_RADIATE_PROB = 0.55
+OBSTACLE_MIN_SEP = 2
+
+# Validation
+MIN_NEW_FILL = 8
+PALETTE_SIZE = (3, 5)
+GEN_RETRIES = 1500
+
+
+def _degree1_pixels(points: set[tuple[int, int]]) -> list[tuple[int, int]]:
+    pts = set(points)
+    return [
+        (r, c)
+        for r, c in pts
+        if sum((rr, cc) in pts for rr, cc in neighbors8(r, c)) == 1
+    ]
+
+
+def _make_arm(depth: int, start_v: int, target_v: int, extra_steps: int, tip_12: bool = False) -> list[tuple[int, int]]:
+    sign = 1 if target_v > start_v else -1
+    n_side_steps = abs(target_v - start_v)
+    chosen_rows: list[int] = []
+    if n_side_steps:
+        if tip_12:
+            chosen_rows = [2 * (i + 1) for i in range(n_side_steps)]
+            extra_steps = 0
+        else:
+            chosen_rows = [1]
+            if n_side_steps > 1:
+                chosen_rows += random.sample(range(2, depth + 1), n_side_steps - 1)
+            chosen_rows.sort()
+
+    first_row = chosen_rows[0] if chosen_rows else 1
+    extra_rows = [r for r in chosen_rows if r != first_row]
+    random.shuffle(extra_rows)
+    orthogonal_rows = set(extra_rows[:extra_steps])
+
+    pts = [(0, start_v)]
+    u, v = 0, start_v
+    for row in range(1, depth + 1):
+        u += 1
+        if row in orthogonal_rows:
+            pts.append((u, v))
+            v += sign
+        elif row in chosen_rows:
+            v += sign
+        pts.append((u, v))
+    return pts
+
+
+def _build_local_wall(rad: tuple[int, int], h: int, w: int) -> tuple[set[tuple[int, int]], int, int] | None:
+    if rad[0]:
+        max_depth = min(DEPTH_VERT[1], h - (OPEN_END_MARGIN + 3))
+        if max_depth < DEPTH_VERT[0]:
+            return None
+        depth = random.randint(DEPTH_VERT[0], max_depth)
+        gap = random.randint(*GAP_VERT)
+    else:
+        max_depth = min(DEPTH_HORIZ[1], w - (OPEN_END_MARGIN + 3))
+        if max_depth < DEPTH_HORIZ[0]:
+            return None
+        depth = random.randint(DEPTH_HORIZ[0], max_depth)
+        gap = random.randint(GAP_HORIZ[0], min(GAP_HORIZ[1], h - 1))
+
+    if gap == 5:
+        left_bottom, right_bottom = 2, 3
+    elif gap == 6:
+        left_bottom, right_bottom = 2, 4
+    else:
+        left_bottom, right_bottom = random.choice([(2, 5), (3, 4)])
+
+    bridge_extra = max(0, right_bottom - left_bottom - 1)
+    base_count = 2 * (depth + 1) + bridge_extra
+    max_extra_l = max(0, left_bottom - 1)
+    max_extra_r = max(0, gap - right_bottom - 1)
+    min_extra = max(0, WALL_PIXELS_MIN - base_count)
+    max_extra = min(max_extra_l + max_extra_r, WALL_PIXELS_MAX - base_count)
+    if min_extra > max_extra:
+        return None
+
+    extra = random.randint(min_extra, max_extra)
+    extra_l = random.randint(max(0, extra - max_extra_r), min(max_extra_l, extra))
+    extra_r = extra - extra_l
+
+    max_n_side = max(left_bottom, gap - right_bottom)
+    tip_12 = depth >= 2 * max_n_side and random.random() < TIP_12_PROB
+    left = _make_arm(depth, 0, left_bottom, extra_l, tip_12=tip_12)
+    right = _make_arm(depth, gap, right_bottom, extra_r, tip_12=tip_12)
+    pts = set(left) | set(right)
+    for v in range(left_bottom, right_bottom + 1):
+        pts.add((depth, v))
+
+    while len(pts) < WALL_PIXELS_MIN:
+        candidates = [
+            (u, v)
+            for u in range(max(0, depth - 3), depth + 1)
+            for v in range(gap + 1)
+            if (u, v) not in pts
+            and sum(
+                (uu, vv) in pts
+                for uu in range(u - 1, u + 2)
+                for vv in range(v - 1, v + 2)
+                if (uu, vv) != (u, v)
+            ) >= 2
+        ]
+        random.shuffle(candidates)
+        added = False
+        for p in candidates:
+            trial = pts | {p}
+            if len(trial) <= WALL_PIXELS_MAX and len(_degree1_pixels(trial)) == 2:
+                pts = trial
+                added = True
+                break
+        if not added:
+            return None
+
+    if not (WALL_PIXELS_MIN <= len(pts) <= WALL_PIXELS_MAX) or len(_degree1_pixels(pts)) != 2:
+        return None
+    return pts, depth, gap
+
+
+def _map_local(u: int, v: int, rad: tuple[int, int], anchor: tuple[int, int]) -> tuple[int, int]:
+    r0, c0 = anchor
+    if rad == (-1, 0):
+        return r0 + u, c0 + v
+    if rad == (1, 0):
+        return r0 - u, c0 + v
+    if rad == (0, -1):
+        return r0 + v, c0 + u
+    return r0 + v, c0 - u
+
+
+def _place_anchor(rad: tuple[int, int], h: int, w: int, depth: int, gap: int) -> tuple[int, int]:
+    if rad == (-1, 0):
+        return random.randint(OPEN_END_MARGIN, h - depth - 3), random.randint(0, w - gap - 1)
+    if rad == (1, 0):
+        return random.randint(depth + 2, h - OPEN_END_MARGIN - 1), random.randint(0, w - gap - 1)
+    if rad == (0, -1):
+        return random.randint(0, h - gap - 1), random.randint(OPEN_END_MARGIN, w - depth - 3)
+    return random.randint(0, h - gap - 1), random.randint(depth + 2, w - OPEN_END_MARGIN - 1)
+
+
+def _local_interior(wall: set[tuple[int, int]], depth: int, gap: int) -> list[tuple[int, int]]:
+    by_row: dict[int, list[int]] = {}
+    for u, v in wall:
+        by_row.setdefault(u, []).append(v)
+    interior = []
+    for u in range(1, depth):
+        if u not in by_row or len(by_row[u]) < 2:
+            continue
+        lo, hi = min(by_row[u]), max(by_row[u])
+        for v in range(lo + 1, hi):
+            if (u, v) not in wall:
+                interior.append((u, v))
+    return interior
+
+
+def _grow_seed_blob(seed: tuple[int, int], interior_set: set[tuple[int, int]], target_size: int) -> set[tuple[int, int]]:
+    blob = {seed}
+    frontier = [seed]
+    while len(blob) < target_size and frontier:
+        u, v = frontier.pop(random.randrange(len(frontier)))
+        nbrs = [(u - 1, v), (u + 1, v), (u, v - 1), (u, v + 1)]
+        random.shuffle(nbrs)
+        for q in nbrs:
+            if q in interior_set and q not in blob:
+                blob.add(q)
+                frontier.append(q)
+                if len(blob) >= target_size:
+                    break
+    return blob
+
+
+def _choose_seed_and_area(interior_total: int, desired_relation: str) -> tuple[int, int] | None:
+    pairs = []
+    for source_count in range(SOURCE_RANGE[0], min(SOURCE_RANGE[1], interior_total - AREA_RANGE[0]) + 1):
+        area = interior_total - source_count
+        if AREA_RANGE[0] <= area <= AREA_RANGE[1]:
+            pairs.append((source_count, area))
+    if not pairs:
+        return None
+
+    smaller_area = [p for p in pairs if p[1] < p[0]]
+    smaller_source = [p for p in pairs if p[0] < p[1]]
+    ties = [p for p in pairs if p[0] == p[1]]
+    if desired_relation == "area_smaller":
+        return random.choice(smaller_area) if smaller_area else None
+    if desired_relation == "source_smaller":
+        return random.choice(smaller_source) if smaller_source else None
+    return random.choice(ties) if ties else None
+
+
+def _obstacle_fits(pos: tuple[int, int], placed: list[tuple[int, int]]) -> bool:
+    r, c = pos
+    return all(max(abs(r - rr), abs(c - cc)) >= OBSTACLE_MIN_SEP for rr, cc in placed)
+
+
+def _find_obstacle_candidates(
+    grid: np.ndarray, bg: int, wall_color: int, preferred_zone: np.ndarray
+) -> tuple[list[tuple[int, int]], list[tuple[int, int]]]:
+    wall_mask = grid == wall_color
+    dist = distance_transform_cdt(~wall_mask, metric="taxicab")
+    far_from_wall = dist > 1
+    eligible = (grid == bg) & far_from_wall
+    all_coords = [(int(r), int(c)) for r, c in zip(*np.where(eligible))]
+    preferred = [p for p in all_coords if preferred_zone[p[0], p[1]]]
+    random.shuffle(all_coords)
+    random.shuffle(preferred)
+    return all_coords, preferred
+
+
+def _place_obstacles(
+    n_obstacles: int,
+    candidates: list[tuple[int, int]],
+    preferred: list[tuple[int, int]],
+    obstacle_colors: list[int],
+    grid: np.ndarray,
+) -> None:
+    placed: list[tuple[int, int]] = []
+    want_preferred = 0
+    if preferred and random.random() < OBSTACLE_IN_RADIATE_PROB:
+        want_preferred = random.randint(1, min(n_obstacles, len(preferred)))
+    for p in preferred:
+        if len(placed) >= want_preferred:
+            break
+        if _obstacle_fits(p, placed):
+            placed.append(p)
+    placed_set = set(placed)
+    for p in candidates:
+        if len(placed) >= n_obstacles:
+            break
+        if p not in placed_set and _obstacle_fits(p, placed):
+            placed.append(p)
+            placed_set.add(p)
+    for i, (r, c) in enumerate(placed):
+        grid[r, c] = obstacle_colors[i % len(obstacle_colors)]
+
+
+def _gen_attempt() -> np.ndarray | None:
+    rad = random.choice([(-1, 0), (1, 0), (0, -1), (0, 1)])
+    h = random.randint(*GRID_H_VERT) if rad[0] else random.randint(*GRID_H_HORIZ)
+    w = random.randint(*GRID_W)
+
+    built = _build_local_wall(rad, h, w)
+    if built is None:
+        return None
+    local_wall, depth, gap = built
+    anchor = _place_anchor(rad, h, w, depth, gap)
+
+    palette = random.sample(range(10), random.randint(*PALETTE_SIZE))
+    bg, wall_color, fill_color = palette[:3]
+    obstacle_colors = palette[3:]
+
+    grid = np.full((h, w), bg, dtype=int)
+    for u, v in local_wall:
+        r, c = _map_local(u, v, rad, anchor)
+        grid[r, c] = wall_color
+
+    interior = _local_interior(local_wall, depth, gap)
+    interior_total = len(interior)
+    if not (INTERIOR_TOTAL_RANGE[0] <= interior_total <= INTERIOR_TOTAL_RANGE[1]):
+        return None
+
+    desired_relation = random.choices(
+        ["area_smaller", "source_smaller", "tie"],
+        weights=[4, 4, 1],
+        k=1,
+    )[0]
+    counts = _choose_seed_and_area(interior_total, desired_relation)
+    if counts is None:
+        return None
+    source_target, _area_target = counts
+
+    wall_set = set(local_wall)
+    adjacent = [
+        p
+        for p in interior
+        if any((p[0] + dr, p[1] + dc) in wall_set for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)])
+    ]
+    seed_pool = [p for p in adjacent if p[0] >= max(1, depth - SEED_DEPTH_LOOKBACK)]
+    if not seed_pool:
+        return None
+
+    blob = _grow_seed_blob(random.choice(seed_pool), set(interior), source_target)
+    if len(blob) != source_target:
+        return None
+    for u, v in blob:
+        r, c = _map_local(u, v, rad, anchor)
+        if grid[r, c] != bg:
+            return None
+        grid[r, c] = fill_color
+
+    base_info = _detect_scene(grid)
+    if base_info["source_count"] < SOURCE_RANGE[0]:
+        return None
+    if not (AREA_RANGE[0] <= base_info["interior_new_area"] <= AREA_RANGE[1]):
+        return None
+    if desired_relation == "area_smaller" and not (base_info["interior_new_area"] < base_info["source_count"]):
+        return None
+    if desired_relation == "source_smaller" and not (base_info["source_count"] < base_info["interior_new_area"]):
+        return None
+    if desired_relation == "tie" and base_info["source_count"] != base_info["interior_new_area"]:
