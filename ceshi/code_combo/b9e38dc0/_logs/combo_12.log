+import numpy as np
+from scipy.ndimage import distance_transform_cdt
+
+from arc_utils import components_mask, get_bg, neighbors4, neighbors8
+
+
+# ---------------------------------------------------------------------------
+# Design analysis for the combo variant
+#
+# a) Concrete behavior and traced example:
+#    The original task has two stages: first recover one reachable region
+#    bounded by the wall and by the two endpoint rays, then remove obstacle
+#    shadows along the radiate direction, and finally paint every newly reached
+#    background cell solid with the seed color.
+#    This combo keeps the same geometry but replaces the solid writeback with a
+#    layered texture on the final post-shadow region. Let d be each region
+#    cell's 8-neighbor distance to the region boundary:
+#      - even d layers are solid fill-colored rings;
+#      - odd d layers are checkerboard rings using {fill, bg}, with phase
+#        anchored to the seed parity.
+#    Example: if one slice of the final region has layer numbers
+#    0,1,2,2,1,0, the original output would be F,F,F,F,F,F. The combo becomes
+#    F,(checker),(solid F),(solid F),(checker),F, where each checker position is
+#    either F or bg by the seed-anchored parity rule. This means the region
+#    still reads as concentric shrinkage, but every odd ring now carries local
+#    alternation instead of staying flat.
+#
+# b) Complexity calibration:
+#    The design uses one geometric control variable (boundary-depth parity) and
+#    one texturing control variable (global checker parity anchored by the
+#    singleton seed). That is enough to make the fusion visually distinct from
+#    both the original solid fill and the single D1 concentric variant, while
+#    still repeating the same small set of cues many times inside each example.
+#    Generator validation enforces visible counts for:
+#      - even solid-fill layers,
+#      - odd-layer fill cells,
+#      - odd-layer bg cells.
+#
+# c) Hidden-assumption audit against the original solver:
+#    - `filled_mask = seen & (g == bg)` no longer captures "all cells that
+#      should become fill", because some odd-layer cells must remain bg.
+#    - The original shadow code used the painted-fill mask itself to decide
+#      where the filled corridor starts. That would break once some valid
+#      region cells intentionally stay bg. The combo therefore computes the
+#      final geometric region first and only textures it after shadow removal.
+#    - Fill-color identification still relies on "closest non-wall color to the
+#      wall". Generator keeps obstacles away from the wall so that assumption
+#      remains valid.
+#    - Checkerboarding needs an unambiguous parity anchor. The generator forces
+#      a singleton seed instead of the original 1-6 cell blob.
+#
+# d) Placement legality:
+#    Wall geometry, margins, endpoint structure, and obstacle spacing stay
+#    compatible with the base task. Obstacles are still placed only on empty bg
+#    cells and never overlap wall or seed pixels. The region is validated after
+#    obstacle placement, so any sample whose shadows destroy the layered cue is
+#    rejected.
+#
+# e) Visual observability:
+#    A solver can infer the rule from 2-4 examples because the same region shows
+#    two simultaneous regularities:
+#      - large-scale rings from the boundary inward,
+#      - small-scale checker alternation only on every other ring.
+#    This is visible without relying on color ids or object ordering.
+#
+# f) Visual cleanliness:
+#    Only the would-be filled corridor is textured. Walls keep one color,
+#    obstacles keep theirs, and the seed remains a visible source pixel. The
+#    generator rejects cramped cases with too little odd-layer contrast, so the
+#    output does not collapse into noise.
+#
+# g) Color inference:
+#    No new colors are introduced. The entire transform uses only the existing
+#    fill color and the visible background color, with structure supplied by
+#    distance-to-boundary and seed parity rather than by hidden numeric color
+#    semantics.
+#
+# h) Fusion metric used after implementation:
+#    For generated samples we measure the counts of bg-origin cells in
+#    `odd_fill`, `odd_bg`, and `even_fill`. A non-degenerate combo sample must
+#    have all three counts positive; otherwise the result collapses toward the
+#    D1-only striped fill or toward the original solid fill.
+#
+# i) New solver assumptions and generator guarantees:
+#    - There is exactly one clear parity anchor: guaranteed by singleton seeds.
+#    - The final reachable region has depth at least 2: enforced in validation.
+#    - Odd rings contain both parities in visible quantity: enforced by minimum
+#      odd-layer fill/bg thresholds on the final output.
+# ---------------------------------------------------------------------------
+
+
+def _sgn(x: int) -> int:
+    return (x > 0) - (x < 0)
+
+
+def _touches_border(mask: np.ndarray) -> bool:
+    return bool(mask[0, :].any() or mask[-1, :].any() or mask[:, 0].any() or mask[:, -1].any())
+
+
+def _flood_mask(passable: np.ndarray, starts: list[tuple[int, int]]) -> np.ndarray:
+    """4-neighbor flood from start cells over a boolean passable mask."""
+    h, w = passable.shape
+    q = starts[:]
+    seen = np.zeros_like(passable, dtype=bool)
+    for r, c in q:
+        if passable[r, c]:
+            seen[r, c] = True
+    while q:
+        r, c = q.pop()
+        for rr, cc in neighbors4(r, c):
+            if 0 <= rr < h and 0 <= cc < w and passable[rr, cc] and not seen[rr, cc]:
+                seen[rr, cc] = True
+                q.append((rr, cc))
+    return seen
+
+
+def _boundary_distance(mask: np.ndarray) -> np.ndarray:
+    """8-neighbor distance from each True cell to the boundary of its region."""
+    h, w = mask.shape
+    dist = np.full((h, w), -1, dtype=int)
+    q: list[tuple[int, int]] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c]:
+                continue
+            boundary = False
+            for rr, cc in neighbors8(r, c):
+                if rr < 0 or rr >= h or cc < 0 or cc >= w or not mask[rr, cc]:
+                    boundary = True
+                    break
