+# Combo variant of b9e38dc0 (index 12)
+# combo_spec: D1/3+D15/1
+# Name: 同心收缩填充+棋盘格填充
+
+import random
+
+import numpy as np
+from scipy.ndimage import distance_transform_cdt
+
+from arc_utils import components_mask, get_bg, neighbors4, neighbors8
+
+
+# ---------------------------------------------------------------------------
+# Design analysis for the combo variant
+#
+# a) Concrete behavior and traced example:
+#    The original task has two stages: first recover one reachable region
+#    bounded by the wall and by the two endpoint rays, then remove obstacle
+#    shadows along the radiate direction, and finally paint every newly reached
+#    background cell solid with the seed color.
+#    This combo keeps the same geometry but replaces the solid writeback with a
+#    layered texture on the final post-shadow region. Let d be each region
+#    cell's 8-neighbor distance to the region boundary:
+#      - even d layers are solid fill-colored rings;
+#      - odd d layers are checkerboard rings using {fill, bg}, with phase
+#        anchored to the seed parity.
+#    Example: if one slice of the final region has layer numbers
+#    0,1,2,2,1,0, the original output would be F,F,F,F,F,F. The combo becomes
+#    F,(checker),(solid F),(solid F),(checker),F, where each checker position is
+#    either F or bg by the seed-anchored parity rule. This means the region
+#    still reads as concentric shrinkage, but every odd ring now carries local
+#    alternation instead of staying flat.
+#
+# b) Complexity calibration:
+#    The design uses one geometric control variable (boundary-depth parity) and
+#    one texturing control variable (global checker parity anchored by the
+#    singleton seed). That is enough to make the fusion visually distinct from
+#    both the original solid fill and the single D1 concentric variant, while
+#    still repeating the same small set of cues many times inside each example.
+#    Generator validation enforces visible counts for:
+#      - even solid-fill layers,
+#      - odd-layer fill cells,
+#      - odd-layer bg cells.
+#
+# c) Hidden-assumption audit against the original solver:
+#    - `filled_mask = seen & (g == bg)` no longer captures "all cells that
+#      should become fill", because some odd-layer cells must remain bg.
+#    - The original shadow code used the painted-fill mask itself to decide
+#      where the filled corridor starts. That would break once some valid
+#      region cells intentionally stay bg. The combo therefore computes the
+#      final geometric region first and only textures it after shadow removal.
+#    - Fill-color identification still relies on "closest non-wall color to the
+#      wall". Generator keeps obstacles away from the wall so that assumption
+#      remains valid.
+#    - Checkerboarding needs an unambiguous parity anchor. The generator forces
+#      a singleton seed instead of the original 1-6 cell blob.
+#
+# d) Placement legality:
+#    Wall geometry, margins, endpoint structure, and obstacle spacing stay
+#    compatible with the base task. Obstacles are still placed only on empty bg
+#    cells and never overlap wall or seed pixels. The region is validated after
+#    obstacle placement, so any sample whose shadows destroy the layered cue is
+#    rejected.
+#
+# e) Visual observability:
+#    A solver can infer the rule from 2-4 examples because the same region shows
+#    two simultaneous regularities:
+#      - large-scale rings from the boundary inward,
+#      - small-scale checker alternation only on every other ring.
+#    This is visible without relying on color ids or object ordering.
+#
+# f) Visual cleanliness:
+#    Only the would-be filled corridor is textured. Walls keep one color,
+#    obstacles keep theirs, and the seed remains a visible source pixel. The
+#    generator rejects cramped cases with too little odd-layer contrast, so the
+#    output does not collapse into noise.
+#
+# g) Color inference:
+#    No new colors are introduced. The entire transform uses only the existing
+#    fill color and the visible background color, with structure supplied by
+#    distance-to-boundary and seed parity rather than by hidden numeric color
+#    semantics.
+#
+# h) Fusion metric used after implementation:
+#    For generated samples we measure the counts of bg-origin cells in
+#    `odd_fill`, `odd_bg`, and `even_fill`. A non-degenerate combo sample must
+#    have all three counts positive; otherwise the result collapses toward the
+#    D1-only striped fill or toward the original solid fill.
+#
+# i) New solver assumptions and generator guarantees:
+#    - There is exactly one clear parity anchor: guaranteed by singleton seeds.
+#    - The final reachable region has depth at least 2: enforced in validation.
+#    - Odd rings contain both parities in visible quantity: enforced by minimum
+#      odd-layer fill/bg thresholds on the final output.
+# ---------------------------------------------------------------------------
+
+
+def _sgn(x: int) -> int:
+    return (x > 0) - (x < 0)
+
+
+def _touches_border(mask: np.ndarray) -> bool:
+    return bool(mask[0, :].any() or mask[-1, :].any() or mask[:, 0].any() or mask[:, -1].any())
+
+
+def _flood_mask(passable: np.ndarray, starts: list[tuple[int, int]]) -> np.ndarray:
+    """4-neighbor flood from start cells over a boolean passable mask."""
+    h, w = passable.shape
+    q = starts[:]
+    seen = np.zeros_like(passable, dtype=bool)
+    for r, c in q:
+        if passable[r, c]:
+            seen[r, c] = True
+    while q:
+        r, c = q.pop()
+        for rr, cc in neighbors4(r, c):
+            if 0 <= rr < h and 0 <= cc < w and passable[rr, cc] and not seen[rr, cc]:
+                seen[rr, cc] = True
+                q.append((rr, cc))
+    return seen
+
+
+def _boundary_distance(mask: np.ndarray) -> np.ndarray:
+    """8-neighbor distance from each True cell to the boundary of its region."""
+    h, w = mask.shape
+    dist = np.full((h, w), -1, dtype=int)
+    q: list[tuple[int, int]] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c]:
+                continue
+            boundary = False
+            for rr, cc in neighbors8(r, c):
+                if rr < 0 or rr >= h or cc < 0 or cc >= w or not mask[rr, cc]:
+                    boundary = True
+                    break
+            if boundary:
+                dist[r, c] = 0
+                q.append((r, c))
+
+    qi = 0
+    while qi < len(q):
+        r, c = q[qi]
+        qi += 1
+        d = dist[r, c]
+        for rr, cc in neighbors8(r, c):
+            if 0 <= rr < h and 0 <= cc < w and mask[rr, cc] and dist[rr, cc] == -1:
+                dist[rr, cc] = d + 1
+                q.append((rr, cc))
+    return dist
+
+
+def _analyze_scene(grid: np.ndarray) -> dict:
+    """Recover the base-task geometry, then trim obstacle shadows before texturing."""
+    g = np.array(grid, copy=True)
+    h, w = g.shape
+
+    vals = np.unique(g)
+    bg = get_bg(g)
+    non_bg = [int(v) for v in vals if int(v) != bg]
+    assert non_bg, "expected at least one non-background color"
+
+    wall = max(non_bg, key=lambda c: int((g == c).sum()))
+    wall_mask = g == wall
+    comps = [set((int(r), int(c)) for r, c in pts) for pts in components_mask(wall_mask, connectivity=8)]
+    assert comps, "expected at least one wall connected component"
+
+    other_colors = [c for c in non_bg if c != wall]
+    assert other_colors, "expected at least one non-wall color"
+
+    wall_points = [p for comp in comps for p in comp]
+
+    def min_dist_to_wall(color: int) -> tuple[int, int]:
+        pts = [(int(r), int(c)) for r, c in zip(*np.where(g == color))]
+        best_d = 10**9
+        for r, c in pts:
+            for wr, wc in wall_points:
+                d = abs(r - wr) + abs(c - wc)
+                if d < best_d:
+                    best_d = d
+                    if best_d == 0:
+                        return 0, len(pts)
+        return best_d, len(pts)
+
+    fill = min(other_colors, key=lambda c: (min_dist_to_wall(c)[0], min_dist_to_wall(c)[1]))
+    fill_pos = [(int(r), int(c)) for r, c in zip(*np.where(g == fill))]
+    assert fill_pos, "expected at least one fill seed pixel"
+
+    def comp_min_dist(comp: set[tuple[int, int]]) -> int:
+        best_d = 10**9
+        for r, c in fill_pos:
+            for wr, wc in comp:
+                d = abs(r - wr) + abs(c - wc)
+                if d < best_d:
+                    best_d = d
+                    if best_d == 0:
+                        return 0
+        return best_d
+
+    wall_comp = min(comps, key=lambda comp: (comp_min_dist(comp), -len(comp)))
+
+    comp_mask = np.zeros_like(wall_mask, dtype=bool)
+    for r, c in wall_comp:
+        comp_mask[r, c] = True
+
+    def comp_neighbors(r: int, c: int) -> list[tuple[int, int]]:
+        out = []
+        for rr, cc in neighbors8(r, c):
+            if 0 <= rr < h and 0 <= cc < w and comp_mask[rr, cc]:
+                out.append((rr, cc))
+        return out
+
+    endpoints = [(r, c) for r, c in wall_comp if len(comp_neighbors(r, c)) == 1]
+    assert endpoints, "expected wall component to have endpoints"
+
+    def outward_dir(ep: tuple[int, int]) -> tuple[tuple[int, int], bool]:
+        n1 = comp_neighbors(*ep)[0]
+        d1 = (_sgn(n1[0] - ep[0]), _sgn(n1[1] - ep[1]))
+        d_use = d1
+        is_12 = False
+        n2s = [p for p in comp_neighbors(*n1) if p != ep]
+        if n2s:
+            n2 = n2s[0]
+            d2 = (_sgn(n2[0] - n1[0]), _sgn(n2[1] - n1[1]))
+            if (d1[0] == 0) ^ (d1[1] == 0):
+                if d2[0] != 0 and d2[1] != 0:
+                    d_use = d2
+                    is_12 = True
+        return (-d_use[0], -d_use[1]), is_12
+
+    out_info = [outward_dir(ep) for ep in endpoints]
+    out_dirs = [d for d, _ in out_info]
+    tip_12 = [flag for _, flag in out_info]
+    rad = (_sgn(sum(d[0] for d in out_dirs)), _sgn(sum(d[1] for d in out_dirs)))
+
+    barrier = comp_mask.copy()
+
+    def add_ray(start: tuple[int, int], d: tuple[int, int]) -> None:
+        rr, cc = start
+        while True:
+            rr += d[0]
+            cc += d[1]
+            if not (0 <= rr < h and 0 <= cc < w):
+                break
+            barrier[rr, cc] = True
+
+    def add_ray_12(start: tuple[int, int], d: tuple[int, int]) -> None:
+        rr, cc = start
+        step = 0
+        while True:
+            step += 1
+            if step % 2 == 1:
+                rr += d[0]
+                cc += d[1]
+            else:
+                if rad[0] != 0:
+                    rr += d[0]
+                else:
+                    cc += d[1]
+            if not (0 <= rr < h and 0 <= cc < w):
+                break
+            barrier[rr, cc] = True
+
+    for ep, d, is_12 in zip(endpoints, out_dirs, tip_12):
+        if is_12:
+            add_ray_12(ep, d)
+        else:
+            add_ray(ep, d)
+
+    passable = (~barrier) & ((g == bg) | (g == fill))
+    seen = _flood_mask(passable, fill_pos)
+    obstacles = (g != bg) & (g != fill) & (g != wall)
+    region_mask = seen.copy()
+
+    def shadow_process(coords: list[tuple[int, int]]) -> None:
+        started = False
+        blocked = False
+        for r, c in coords:
+            if seen[r, c]:
+                started = True
+            if started and obstacles[r, c]:
+                blocked = True
+                continue
+            if blocked and seen[r, c]:
+                region_mask[r, c] = False
+
+    if rad != (0, 0):
+        dr, dc = rad
+        if dr != 0 and dc == 0:
+            for c in range(w):
+                rows = range(h) if dr > 0 else range(h - 1, -1, -1)
+                shadow_process([(r, c) for r in rows])
+        elif dc != 0 and dr == 0:
+            for r in range(h):
+                cols = range(w) if dc > 0 else range(w - 1, -1, -1)
+                shadow_process([(r, c) for c in cols])
+        else:
+            if dr == dc:
+                for k in range(-(w - 1), h):
+                    coords = [(r, r - k) for r in range(h) if 0 <= r - k < w]
+                    coords.sort(key=lambda rc: rc[0], reverse=(dr < 0))
+                    shadow_process(coords)
+            else:
+                for k in range(h + w - 1):
+                    coords = [(r, k - r) for r in range(h) if 0 <= k - r < w]
+                    coords.sort(key=lambda rc: rc[0], reverse=(dr < 0))
+                    shadow_process(coords)
+
+    return {
+        "grid": g,
+        "bg": bg,
+        "wall": wall,
+        "fill": fill,
+        "fill_pos": fill_pos,
+        "fill_seed_mask": g == fill,
+        "region_mask": region_mask,
+        "rad": rad,
+        "tip_12_mode": any(tip_12),
+        "obstacles": obstacles,
+    }
+
+
+def _combo_masks(grid: np.ndarray) -> dict:
+    """Split the final region into solid even rings and checker odd rings."""
+    info = _analyze_scene(grid)
+    region_mask = info["region_mask"]
+    dist = _boundary_distance(region_mask)
+    bg_region = region_mask & (info["grid"] == info["bg"])
+
+    rows, cols = np.indices(info["grid"].shape)
+    anchor = min(info["fill_pos"])
+    anchor_parity = (anchor[0] + anchor[1]) & 1
+    same_parity = ((rows + cols) & 1) == anchor_parity
+
+    even_layers = bg_region & ((dist % 2) == 0)
+    odd_layers = bg_region & ((dist % 2) == 1)
+    odd_fill = odd_layers & same_parity
+    odd_bg = odd_layers & ~same_parity
+
+    return {
+        **info,
+        "dist": dist,
+        "bg_region": bg_region,
+        "even_layers": even_layers,
+        "odd_layers": odd_layers,
+        "odd_fill": odd_fill,
+        "odd_bg": odd_bg,
+    }
+
+
+def _combo_metrics(grid: np.ndarray) -> dict:
+    state = _combo_masks(grid)
+    visible_fill = state["even_layers"] | state["odd_fill"]
+    max_depth = int(state["dist"][state["region_mask"]].max()) if state["region_mask"].any() else -1
+    return {
+        "region_bg_cells": int(state["bg_region"].sum()),
+        "even_fill": int(state["even_layers"].sum()),
+        "odd_fill": int(state["odd_fill"].sum()),
+        "odd_bg": int(state["odd_bg"].sum()),
+        "visible_fill": int(visible_fill.sum()),
+        "max_depth": max_depth,
+        "touches_border": _touches_border(visible_fill),
+        "tip_12_mode": state["tip_12_mode"],
+        "obstacle_count": int(state["obstacles"].sum()),
+    }
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Texture the wall-bounded fill region as concentric shrinking bands whose alternate layers become checkerboards.
+
+    Input structure:
+    - The most common color is the background, and the most frequent non-background color is a partial enclosure with one open mouth.
+    - A singleton seed of another color sits inside that enclosure; any remaining non-background pixels are obstacles that stay fixed.
+
+    Rule:
+    - Recover the same reachable post-shadow region as the base task: the wall and the two endpoint rays define the corridor, and obstacles cut straight shadows behind them along the radiate direction.
+    - Recolor only the background cells of that final region by boundary depth: even-numbered layers are solid seed color, while odd-numbered layers use a seed-anchored checkerboard of seed color and background color.
+
+    Key insight: The geometry is still solved exactly like the original problem, but the final appearance depends on two visible structures at once: concentric depth layers and checker parity on every other layer.
+    """
+    state = _combo_masks(grid)
+    g = state["grid"]
+
+    out = g.copy()
+    out[state["bg_region"]] = state["bg"]
+    out[state["even_layers"]] = state["fill"]
+    out[state["odd_fill"]] = state["fill"]
+    out[state["fill_seed_mask"]] = state["fill"]
+    return out
+
+
+# --------------- generator ---------------
+
+# Canvas size bounds
+GRID_H_VERT = (11, 18)
+GRID_H_HORIZ = (8, 18)
+GRID_W = (15, 19)
+
+# Wall geometry
+WALL_PIXELS_MIN = 17
+WALL_PIXELS_MAX = 25
+DEPTH_VERT = (5, 10)
+DEPTH_HORIZ = (6, 8)
+GAP_VERT = (6, 7)
+GAP_HORIZ = (5, 7)
+TIP_12_PROB = 0.5
+
+# Placement margins
+OPEN_END_MARGIN = 3
+
+# Fill seed
+SEED_DEPTH_LOOKBACK = 3
+
+# Obstacles
+MAX_OBSTACLES = 5
+OBSTACLE_IN_FILL_PROB = 0.65
+OBSTACLE_MIN_SEP = 2
+
+# Validation
+MIN_REGION_BG_CELLS = 24
+MIN_EVEN_FILL = 10
+MIN_ODD_FILL = 5
+MIN_ODD_BG = 5
+MIN_PATTERN_DEPTH = 2
+PALETTE_SIZE = (3, 5)
+GEN_RETRIES = 300
+
+
+def _degree1_pixels(points):
+    """Return degree-1 pixels (exactly one 8-neighbor in the set)."""
+    pts = set(points)
+    return [(r, c) for r, c in pts if sum((rr, cc) in pts for rr, cc in neighbors8(r, c)) == 1]
+
+
+def _make_arm(depth, start_v, target_v, extra_steps, tip_12=False):
+    """Build one zigzag arm from (0, start_v) toward (depth, target_v)."""
+    sign = 1 if target_v > start_v else -1
+    n_side_steps = abs(target_v - start_v)
+    chosen_rows = []
+    if n_side_steps:
+        if tip_12:
+            chosen_rows = [2 * (i + 1) for i in range(n_side_steps)]
+            extra_steps = 0
+        else:
+            chosen_rows = [1]
+            if n_side_steps > 1:
+                chosen_rows += random.sample(range(2, depth + 1), n_side_steps - 1)
+            chosen_rows.sort()
+
+    first_row = chosen_rows[0] if chosen_rows else 1
+    extra_rows = [r for r in chosen_rows if r != first_row]
+    random.shuffle(extra_rows)
+    orthogonal_rows = set(extra_rows[:extra_steps])
+
+    pts = [(0, start_v)]
+    u, v = 0, start_v
+    for row in range(1, depth + 1):
+        u += 1
+        if row in orthogonal_rows:
+            pts.append((u, v))
+            v += sign
+        elif row in chosen_rows:
+            v += sign
+        pts.append((u, v))
+    return pts
+
+
+def _build_local_wall(rad, h, w):
+    """Construct wall shape in local coordinates. Returns (pts, depth, gap) or None."""
+    if rad[0]:
+        max_depth = min(DEPTH_VERT[1], h - 6)
+        if max_depth < DEPTH_VERT[0]:
+            return None
+        depth = random.randint(DEPTH_VERT[0], max_depth)
+        gap = random.randint(*GAP_VERT)
+    else:
+        depth = random.randint(DEPTH_HORIZ[0], min(DEPTH_HORIZ[1], w - 6))
+        gap = random.randint(GAP_HORIZ[0], min(GAP_HORIZ[1], h - 1))
+
+    if gap == 5:
+        left_bottom, right_bottom = 2, 3
+    elif gap == 6:
+        left_bottom, right_bottom = 2, 4
+    else:
+        left_bottom, right_bottom = random.choice([(2, 5), (3, 4)])
+
+    bridge_extra = max(0, right_bottom - left_bottom - 1)
+    base_count = 2 * (depth + 1) + bridge_extra
+    max_extra_l = max(0, left_bottom - 1)
+    max_extra_r = max(0, gap - right_bottom - 1)
+    min_extra = max(0, WALL_PIXELS_MIN - base_count)
+    max_extra = min(max_extra_l + max_extra_r, WALL_PIXELS_MAX - base_count)
+    if min_extra > max_extra:
+        return None
+
+    extra = random.randint(min_extra, max_extra)
+    extra_l = random.randint(max(0, extra - max_extra_r), min(max_extra_l, extra))
+    extra_r = extra - extra_l
+
+    max_n_side = max(left_bottom, gap - right_bottom)
+    tip_12 = depth >= 2 * max_n_side and random.random() < TIP_12_PROB
+    left = _make_arm(depth, 0, left_bottom, extra_l, tip_12=tip_12)
+    right = _make_arm(depth, gap, right_bottom, extra_r, tip_12=tip_12)
+    pts = set(left) | set(right)
+    for v in range(left_bottom, right_bottom + 1):
+        pts.add((depth, v))
+
+    while len(pts) < WALL_PIXELS_MIN:
+        candidates = [
+            (u, v)
+            for u in range(max(0, depth - 3), depth + 1)
+            for v in range(gap + 1)
+            if (u, v) not in pts
+            and sum(
+                (uu, vv) in pts
+                for uu in range(u - 1, u + 2)
+                for vv in range(v - 1, v + 2)
+                if (uu, vv) != (u, v)
+            ) >= 2
+        ]
+        random.shuffle(candidates)
+        added = False
+        for p in candidates:
+            trial = pts | {p}
+            if len(trial) <= WALL_PIXELS_MAX and len(_degree1_pixels(trial)) == 2:
+                pts = trial
+                added = True
+                break
+        if not added:
+            return None
+
+    if not (WALL_PIXELS_MIN <= len(pts) <= WALL_PIXELS_MAX) or len(_degree1_pixels(pts)) != 2:
+        return None
+    return pts, depth, gap
+
+
+def _map_local(u, v, rad, anchor):
+    """Map local (u, v) to grid (r, c) given radiate direction and anchor."""
+    r0, c0 = anchor
+    if rad == (-1, 0):
+        return r0 + u, c0 + v
+    if rad == (1, 0):
+        return r0 - u, c0 + v
+    if rad == (0, -1):
+        return r0 + v, c0 + u
+    return r0 + v, c0 - u
+
+
+def _place_anchor(rad, h, w, depth, gap):
+    """Choose anchor so the wall fits within margins."""
+    if rad == (-1, 0):
+        return random.randint(OPEN_END_MARGIN, h - depth - 3), random.randint(0, w - gap - 1)
+    if rad == (1, 0):
+        return random.randint(depth + 2, h - 4), random.randint(0, w - gap - 1)
+    if rad == (0, -1):
+        return random.randint(0, h - gap - 1), random.randint(OPEN_END_MARGIN, w - depth - 3)
+    return random.randint(0, h - gap - 1), random.randint(depth + 2, w - 4)
+
+
+def _local_interior(wall, depth, gap):
+    """Return cells strictly between the two wall arms in local coordinates."""
+    by_row = {}
+    for u, v in wall:
+        by_row.setdefault(u, []).append(v)
+    interior = []
+    for u in range(1, depth):
+        if u not in by_row or len(by_row[u]) < 2:
+            continue
+        lo, hi = min(by_row[u]), max(by_row[u])
+        for v in range(lo + 1, hi):
+            if (u, v) not in wall:
+                interior.append((u, v))
+    return interior
+
+
+def _obstacle_fits(pos, placed):
+    """Check that pos is at least Chebyshev OBSTACLE_MIN_SEP from all placed obstacles."""
+    r, c = pos
+    return all(max(abs(r - rr), abs(c - cc)) >= OBSTACLE_MIN_SEP for rr, cc in placed)
+
+
+def _find_obstacle_candidates(grid, bg, wall_color, nominal_region):
+    """Find obstacle candidates, preferring cells that participate in the textured region."""
+    wall_mask = grid == wall_color
+    dist = distance_transform_cdt(~wall_mask, metric="taxicab")
+    far_from_wall = dist > 1
+    eligible = (grid == bg) & far_from_wall
+    all_coords = list(zip(*np.where(eligible)))
+    fill_coords = [p for p in all_coords if nominal_region[p[0], p[1]]]
+    random.shuffle(all_coords)
+    random.shuffle(fill_coords)
+    return [(int(r), int(c)) for r, c in all_coords], [(int(r), int(c)) for r, c in fill_coords]
+
+
+def _place_obstacles(n_obstacles, candidates, fill_candidates, obstacle_colors, grid):
+    """Place up to n_obstacles on the grid, preferring some in the nominal region."""
+    placed = []
+    n_fill = random.randint(0, min(n_obstacles, len(fill_candidates)))
+    if fill_candidates and random.random() < OBSTACLE_IN_FILL_PROB:
+        n_fill = max(1, n_fill)
+    for p in fill_candidates:
+        if len(placed) >= n_fill:
+            break
+        if _obstacle_fits(p, placed):
+            placed.append(p)
+    placed_set = set(placed)
+    for p in candidates:
+        if len(placed) >= n_obstacles:
+            break
+        if p not in placed_set and _obstacle_fits(p, placed):
+            placed.append(p)
+            placed_set.add(p)
+    for i, (r, c) in enumerate(placed):
+        grid[r, c] = obstacle_colors[i % len(obstacle_colors)]
+
+
+def _gen_attempt():
+    """Single attempt to generate a valid combo sample."""
+    rad = random.choice([(-1, 0), (1, 0), (0, -1), (0, 1)])
+    h = random.randint(*GRID_H_VERT) if rad[0] else random.randint(*GRID_H_HORIZ)
+    w = random.randint(*GRID_W)
+
+    built = _build_local_wall(rad, h, w)
+    if built is None:
+        return None
+    local_wall, depth, gap = built
+    anchor = _place_anchor(rad, h, w, depth, gap)
+
+    palette = random.sample(range(10), random.randint(*PALETTE_SIZE))
+    bg, wall_color, fill_color = palette[:3]
+    obstacle_colors = palette[3:]
+
+    grid = np.full((h, w), bg, dtype=int)
+    for u, v in local_wall:
+        r, c = _map_local(u, v, rad, anchor)
+        grid[r, c] = wall_color
+
+    interior = _local_interior(local_wall, depth, gap)
+    wall_set = set(local_wall)
+    adjacent = [
+        p
+        for p in interior
+        if any((p[0] + dr, p[1] + dc) in wall_set for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)])
+    ]
+    seed_pool = [p for p in adjacent if p[0] >= max(1, depth - SEED_DEPTH_LOOKBACK)]
+    if not seed_pool:
+        return None
+
+    seed = random.choice(seed_pool)
+    r, c = _map_local(seed[0], seed[1], rad, anchor)
+    if grid[r, c] != bg:
+        return None
+    grid[r, c] = fill_color
+
+    try:
+        nominal_region = _analyze_scene(grid)["region_mask"] & (grid == bg)
+    except Exception:
+        return None
+
+    n_obstacles = random.randint(0, MAX_OBSTACLES)
+    if n_obstacles and not obstacle_colors:
+        available = [c for c in range(10) if c not in (bg, wall_color, fill_color)]
+        obstacle_colors = random.sample(available, random.randint(1, 2))
+    if n_obstacles:
+        candidates, fill_candidates = _find_obstacle_candidates(grid, bg, wall_color, nominal_region)
+        _place_obstacles(n_obstacles, candidates, fill_candidates, obstacle_colors, grid)
+
+    try:
+        out = main(grid)
+        metrics = _combo_metrics(grid)
+    except Exception:
+        return None
+
+    visible_fill = (out == fill_color) & (grid == bg)
+    odd_bg_visible = (out == bg) & _combo_masks(grid)["odd_bg"]
+
+    if np.array_equal(grid, out):
+        return None
+    if metrics["region_bg_cells"] < MIN_REGION_BG_CELLS:
+        return None
+    if metrics["even_fill"] < MIN_EVEN_FILL:
+        return None
+    if metrics["odd_fill"] < MIN_ODD_FILL:
+        return None
+    if metrics["odd_bg"] < MIN_ODD_BG:
+        return None
+    if metrics["max_depth"] < MIN_PATTERN_DEPTH:
+        return None
+    if not _touches_border(visible_fill):
+        return None
+    if int(odd_bg_visible.sum()) < MIN_ODD_BG:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate valid b9e38dc0 combo input")

diff --git a/ceshi/code_combo/b9e38dc0/12/code.py b/ceshi/code_combo/b9e38dc0/12/code.py
new file mode 100644
index 0000000000000000000000000000000000000000..bbac8589972a0ae442d68b5038d7fc480ddcb393
--- /dev/null
+++ b/ceshi/code_combo/b9e38dc0/12/code.py
@@ -0,0 +1,703 @@
+# Combo variant of b9e38dc0 (index 12)
+# combo_spec: D1/3+D15/1
+# Name: 同心收缩填充+棋盘格填充
+
+import random
+
+import numpy as np
+from scipy.ndimage import distance_transform_cdt
+
+from arc_utils import components_mask, get_bg, neighbors4, neighbors8
+
+
+# ---------------------------------------------------------------------------
+# Design analysis for the combo variant
+#
+# a) Concrete behavior and traced example:
+#    The original task has two stages: first recover one reachable region
+#    bounded by the wall and by the two endpoint rays, then remove obstacle
+#    shadows along the radiate direction, and finally paint every newly reached
+#    background cell solid with the seed color.
+#    This combo keeps the same geometry but replaces the solid writeback with a
+#    layered texture on the final post-shadow region. Let d be each region
+#    cell's 8-neighbor distance to the region boundary:
+#      - even d layers are solid fill-colored rings;
+#      - odd d layers are checkerboard rings using {fill, bg}, with phase
+#        anchored to the seed parity.
+#    Example: if one slice of the final region has layer numbers
+#    0,1,2,2,1,0, the original output would be F,F,F,F,F,F. The combo becomes
+#    F,(checker),(solid F),(solid F),(checker),F, where each checker position is
+#    either F or bg by the seed-anchored parity rule. This means the region
+#    still reads as concentric shrinkage, but every odd ring now carries local
+#    alternation instead of staying flat.
+#
+# b) Complexity calibration:
+#    The design uses one geometric control variable (boundary-depth parity) and
+#    one texturing control variable (global checker parity anchored by the
+#    singleton seed). That is enough to make the fusion visually distinct from
+#    both the original solid fill and the single D1 concentric variant, while
+#    still repeating the same small set of cues many times inside each example.
+#    Generator validation enforces visible counts for:
+#      - even solid-fill layers,
+#      - odd-layer fill cells,
+#      - odd-layer bg cells.
+#
+# c) Hidden-assumption audit against the original solver:
+#    - `filled_mask = seen & (g == bg)` no longer captures "all cells that
+#      should become fill", because some odd-layer cells must remain bg.
+#    - The original shadow code used the painted-fill mask itself to decide
+#      where the filled corridor starts. That would break once some valid
+#      region cells intentionally stay bg. The combo therefore computes the
+#      final geometric region first and only textures it after shadow removal.
+#    - Fill-color identification still relies on "closest non-wall color to the
+#      wall". Generator keeps obstacles away from the wall so that assumption
+#      remains valid.
+#    - Checkerboarding needs an unambiguous parity anchor. The generator forces
+#      a singleton seed instead of the original 1-6 cell blob.
+#
+# d) Placement legality:
+#    Wall geometry, margins, endpoint structure, and obstacle spacing stay
+#    compatible with the base task. Obstacles are still placed only on empty bg
+#    cells and never overlap wall or seed pixels. The region is validated after
+#    obstacle placement, so any sample whose shadows destroy the layered cue is
+#    rejected.
+#
+# e) Visual observability:
+#    A solver can infer the rule from 2-4 examples because the same region shows
+#    two simultaneous regularities:
+#      - large-scale rings from the boundary inward,
+#      - small-scale checker alternation only on every other ring.
+#    This is visible without relying on color ids or object ordering.
+#
+# f) Visual cleanliness:
+#    Only the would-be filled corridor is textured. Walls keep one color,
+#    obstacles keep theirs, and the seed remains a visible source pixel. The
+#    generator rejects cramped cases with too little odd-layer contrast, so the
+#    output does not collapse into noise.
+#
+# g) Color inference:
+#    No new colors are introduced. The entire transform uses only the existing
+#    fill color and the visible background color, with structure supplied by
+#    distance-to-boundary and seed parity rather than by hidden numeric color
+#    semantics.
+#
+# h) Fusion metric used after implementation:
+#    For generated samples we measure the counts of bg-origin cells in
+#    `odd_fill`, `odd_bg`, and `even_fill`. A non-degenerate combo sample must
+#    have all three counts positive; otherwise the result collapses toward the
+#    D1-only striped fill or toward the original solid fill.
+#
+# i) New solver assumptions and generator guarantees:
+#    - There is exactly one clear parity anchor: guaranteed by singleton seeds.
+#    - The final reachable region has depth at least 2: enforced in validation.
+#    - Odd rings contain both parities in visible quantity: enforced by minimum
+#      odd-layer fill/bg thresholds on the final output.
+# ---------------------------------------------------------------------------
+
+
+def _sgn(x: int) -> int:
+    return (x > 0) - (x < 0)
+
+
+def _touches_border(mask: np.ndarray) -> bool:
+    return bool(mask[0, :].any() or mask[-1, :].any() or mask[:, 0].any() or mask[:, -1].any())
+
+
+def _flood_mask(passable: np.ndarray, starts: list[tuple[int, int]]) -> np.ndarray:
+    """4-neighbor flood from start cells over a boolean passable mask."""
+    h, w = passable.shape
+    q = starts[:]
+    seen = np.zeros_like(passable, dtype=bool)
+    for r, c in q:
+        if passable[r, c]:
+            seen[r, c] = True
+    while q:
+        r, c = q.pop()
+        for rr, cc in neighbors4(r, c):
+            if 0 <= rr < h and 0 <= cc < w and passable[rr, cc] and not seen[rr, cc]:
+                seen[rr, cc] = True
+                q.append((rr, cc))
+    return seen
+
+
+def _boundary_distance(mask: np.ndarray) -> np.ndarray:
+    """8-neighbor distance from each True cell to the boundary of its region."""
+    h, w = mask.shape
+    dist = np.full((h, w), -1, dtype=int)
+    q: list[tuple[int, int]] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c]:
+                continue
+            boundary = False
+            for rr, cc in neighbors8(r, c):
+                if rr < 0 or rr >= h or cc < 0 or cc >= w or not mask[rr, cc]:
+                    boundary = True
+                    break
+            if boundary:
+                dist[r, c] = 0
+                q.append((r, c))
+
+    qi = 0
+    while qi < len(q):
+        r, c = q[qi]
+        qi += 1
+        d = dist[r, c]
+        for rr, cc in neighbors8(r, c):
+            if 0 <= rr < h and 0 <= cc < w and mask[rr, cc] and dist[rr, cc] == -1:
+                dist[rr, cc] = d + 1
+                q.append((rr, cc))
+    return dist
+
+
+def _analyze_scene(grid: np.ndarray) -> dict:
+    """Recover the base-task geometry, then trim obstacle shadows before texturing."""
+    g = np.array(grid, copy=True)
+    h, w = g.shape
+
+    vals = np.unique(g)
+    bg = get_bg(g)
+    non_bg = [int(v) for v in vals if int(v) != bg]
+    assert non_bg, "expected at least one non-background color"
+
+    wall = max(non_bg, key=lambda c: int((g == c).sum()))
+    wall_mask = g == wall
+    comps = [set((int(r), int(c)) for r, c in pts) for pts in components_mask(wall_mask, connectivity=8)]
+    assert comps, "expected at least one wall connected component"
+
+    other_colors = [c for c in non_bg if c != wall]
+    assert other_colors, "expected at least one non-wall color"
+
+    wall_points = [p for comp in comps for p in comp]
+
+    def min_dist_to_wall(color: int) -> tuple[int, int]:
+        pts = [(int(r), int(c)) for r, c in zip(*np.where(g == color))]
+        best_d = 10**9
+        for r, c in pts:
+            for wr, wc in wall_points:
+                d = abs(r - wr) + abs(c - wc)
+                if d < best_d:
+                    best_d = d
+                    if best_d == 0:
+                        return 0, len(pts)
+        return best_d, len(pts)
+
+    fill = min(other_colors, key=lambda c: (min_dist_to_wall(c)[0], min_dist_to_wall(c)[1]))
+    fill_pos = [(int(r), int(c)) for r, c in zip(*np.where(g == fill))]
+    assert fill_pos, "expected at least one fill seed pixel"
+
+    def comp_min_dist(comp: set[tuple[int, int]]) -> int:
+        best_d = 10**9
+        for r, c in fill_pos:
+            for wr, wc in comp:
+                d = abs(r - wr) + abs(c - wc)
+                if d < best_d:
+                    best_d = d
+                    if best_d == 0:
+                        return 0
+        return best_d
+
+    wall_comp = min(comps, key=lambda comp: (comp_min_dist(comp), -len(comp)))
+
+    comp_mask = np.zeros_like(wall_mask, dtype=bool)
+    for r, c in wall_comp:
+        comp_mask[r, c] = True
+
+    def comp_neighbors(r: int, c: int) -> list[tuple[int, int]]:
+        out = []
+        for rr, cc in neighbors8(r, c):
+            if 0 <= rr < h and 0 <= cc < w and comp_mask[rr, cc]:
+                out.append((rr, cc))
+        return out
+
+    endpoints = [(r, c) for r, c in wall_comp if len(comp_neighbors(r, c)) == 1]
+    assert endpoints, "expected wall component to have endpoints"
+
+    def outward_dir(ep: tuple[int, int]) -> tuple[tuple[int, int], bool]:
+        n1 = comp_neighbors(*ep)[0]
+        d1 = (_sgn(n1[0] - ep[0]), _sgn(n1[1] - ep[1]))
+        d_use = d1
+        is_12 = False
+        n2s = [p for p in comp_neighbors(*n1) if p != ep]
+        if n2s:
+            n2 = n2s[0]
+            d2 = (_sgn(n2[0] - n1[0]), _sgn(n2[1] - n1[1]))
+            if (d1[0] == 0) ^ (d1[1] == 0):
+                if d2[0] != 0 and d2[1] != 0:
+                    d_use = d2
+                    is_12 = True
+        return (-d_use[0], -d_use[1]), is_12
+
+    out_info = [outward_dir(ep) for ep in endpoints]
+    out_dirs = [d for d, _ in out_info]
+    tip_12 = [flag for _, flag in out_info]
+    rad = (_sgn(sum(d[0] for d in out_dirs)), _sgn(sum(d[1] for d in out_dirs)))
+
+    barrier = comp_mask.copy()
+
+    def add_ray(start: tuple[int, int], d: tuple[int, int]) -> None:
+        rr, cc = start
+        while True:
+            rr += d[0]
+            cc += d[1]
+            if not (0 <= rr < h and 0 <= cc < w):
+                break
+            barrier[rr, cc] = True
+
+    def add_ray_12(start: tuple[int, int], d: tuple[int, int]) -> None:
+        rr, cc = start
+        step = 0
+        while True:
+            step += 1
+            if step % 2 == 1:
+                rr += d[0]
+                cc += d[1]
+            else:
+                if rad[0] != 0:
+                    rr += d[0]
+                else:
+                    cc += d[1]
+            if not (0 <= rr < h and 0 <= cc < w):
+                break
+            barrier[rr, cc] = True
+
+    for ep, d, is_12 in zip(endpoints, out_dirs, tip_12):
+        if is_12:
+            add_ray_12(ep, d)
+        else:
+            add_ray(ep, d)
+
+    passable = (~barrier) & ((g == bg) | (g == fill))
+    seen = _flood_mask(passable, fill_pos)
+    obstacles = (g != bg) & (g != fill) & (g != wall)
+    region_mask = seen.copy()
+
+    def shadow_process(coords: list[tuple[int, int]]) -> None:
+        started = False
+        blocked = False
+        for r, c in coords:
+            if seen[r, c]:
+                started = True
+            if started and obstacles[r, c]:
+                blocked = True
+                continue
+            if blocked and seen[r, c]:
+                region_mask[r, c] = False
+
+    if rad != (0, 0):
+        dr, dc = rad
+        if dr != 0 and dc == 0:
+            for c in range(w):
+                rows = range(h) if dr > 0 else range(h - 1, -1, -1)
+                shadow_process([(r, c) for r in rows])
+        elif dc != 0 and dr == 0:
+            for r in range(h):
+                cols = range(w) if dc > 0 else range(w - 1, -1, -1)
+                shadow_process([(r, c) for c in cols])
+        else:
+            if dr == dc:
+                for k in range(-(w - 1), h):
+                    coords = [(r, r - k) for r in range(h) if 0 <= r - k < w]
+                    coords.sort(key=lambda rc: rc[0], reverse=(dr < 0))
+                    shadow_process(coords)
+            else:
+                for k in range(h + w - 1):
+                    coords = [(r, k - r) for r in range(h) if 0 <= k - r < w]
+                    coords.sort(key=lambda rc: rc[0], reverse=(dr < 0))
+                    shadow_process(coords)
+
+    return {
+        "grid": g,
+        "bg": bg,
+        "wall": wall,
+        "fill": fill,
+        "fill_pos": fill_pos,
+        "fill_seed_mask": g == fill,
+        "region_mask": region_mask,
+        "rad": rad,
+        "tip_12_mode": any(tip_12),
+        "obstacles": obstacles,
+    }
+
+
+def _combo_masks(grid: np.ndarray) -> dict:
+    """Split the final region into solid even rings and checker odd rings."""
+    info = _analyze_scene(grid)
+    region_mask = info["region_mask"]
+    dist = _boundary_distance(region_mask)
+    bg_region = region_mask & (info["grid"] == info["bg"])
+
+    rows, cols = np.indices(info["grid"].shape)
+    anchor = min(info["fill_pos"])
+    anchor_parity = (anchor[0] + anchor[1]) & 1
+    same_parity = ((rows + cols) & 1) == anchor_parity
+
+    even_layers = bg_region & ((dist % 2) == 0)
+    odd_layers = bg_region & ((dist % 2) == 1)
+    odd_fill = odd_layers & same_parity
+    odd_bg = odd_layers & ~same_parity
+
+    return {
+        **info,
+        "dist": dist,
+        "bg_region": bg_region,
+        "even_layers": even_layers,
+        "odd_layers": odd_layers,
+        "odd_fill": odd_fill,
+        "odd_bg": odd_bg,
+    }
+
+
+def _combo_metrics(grid: np.ndarray) -> dict:
+    state = _combo_masks(grid)
+    visible_fill = state["even_layers"] | state["odd_fill"]
+    max_depth = int(state["dist"][state["region_mask"]].max()) if state["region_mask"].any() else -1
+    return {
+        "region_bg_cells": int(state["bg_region"].sum()),
+        "even_fill": int(state["even_layers"].sum()),
+        "odd_fill": int(state["odd_fill"].sum()),
+        "odd_bg": int(state["odd_bg"].sum()),
+        "visible_fill": int(visible_fill.sum()),
+        "max_depth": max_depth,
+        "touches_border": _touches_border(visible_fill),
+        "tip_12_mode": state["tip_12_mode"],
+        "obstacle_count": int(state["obstacles"].sum()),
+    }
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Texture the wall-bounded fill region as concentric shrinking bands whose alternate layers become checkerboards.
+
+    Input structure:
+    - The most common color is the background, and the most frequent non-background color is a partial enclosure with one open mouth.
+    - A singleton seed of another color sits inside that enclosure; any remaining non-background pixels are obstacles that stay fixed.
+
+    Rule:
+    - Recover the same reachable post-shadow region as the base task: the wall and the two endpoint rays define the corridor, and obstacles cut straight shadows behind them along the radiate direction.
+    - Recolor only the background cells of that final region by boundary depth: even-numbered layers are solid seed color, while odd-numbered layers use a seed-anchored checkerboard of seed color and background color.
+
+    Key insight: The geometry is still solved exactly like the original problem, but the final appearance depends on two visible structures at once: concentric depth layers and checker parity on every other layer.
+    """
+    state = _combo_masks(grid)
+    g = state["grid"]
+
+    out = g.copy()
+    out[state["bg_region"]] = state["bg"]
+    out[state["even_layers"]] = state["fill"]
+    out[state["odd_fill"]] = state["fill"]
+    out[state["fill_seed_mask"]] = state["fill"]
+    return out
+
+
+# --------------- generator ---------------
+
+# Canvas size bounds
+GRID_H_VERT = (11, 18)
+GRID_H_HORIZ = (8, 18)
+GRID_W = (15, 19)
+
+# Wall geometry
+WALL_PIXELS_MIN = 17
+WALL_PIXELS_MAX = 25
+DEPTH_VERT = (5, 10)
+DEPTH_HORIZ = (6, 8)
+GAP_VERT = (6, 7)
+GAP_HORIZ = (5, 7)
+TIP_12_PROB = 0.5
+
+# Placement margins
+OPEN_END_MARGIN = 3
+
+# Fill seed
+SEED_DEPTH_LOOKBACK = 3
+
+# Obstacles
+MAX_OBSTACLES = 5
+OBSTACLE_IN_FILL_PROB = 0.65
+OBSTACLE_MIN_SEP = 2
+
+# Validation
+MIN_REGION_BG_CELLS = 24
+MIN_EVEN_FILL = 10
+MIN_ODD_FILL = 5
+MIN_ODD_BG = 5
+MIN_PATTERN_DEPTH = 2
+PALETTE_SIZE = (3, 5)
+GEN_RETRIES = 300
+
+
+def _degree1_pixels(points):
+    """Return degree-1 pixels (exactly one 8-neighbor in the set)."""
+    pts = set(points)
+    return [(r, c) for r, c in pts if sum((rr, cc) in pts for rr, cc in neighbors8(r, c)) == 1]
+
+
+def _make_arm(depth, start_v, target_v, extra_steps, tip_12=False):
+    """Build one zigzag arm from (0, start_v) toward (depth, target_v)."""
+    sign = 1 if target_v > start_v else -1
+    n_side_steps = abs(target_v - start_v)
+    chosen_rows = []
+    if n_side_steps:
+        if tip_12:
+            chosen_rows = [2 * (i + 1) for i in range(n_side_steps)]
+            extra_steps = 0
+        else:
+            chosen_rows = [1]
+            if n_side_steps > 1:
+                chosen_rows += random.sample(range(2, depth + 1), n_side_steps - 1)
+            chosen_rows.sort()
+
+    first_row = chosen_rows[0] if chosen_rows else 1
+    extra_rows = [r for r in chosen_rows if r != first_row]
+    random.shuffle(extra_rows)
+    orthogonal_rows = set(extra_rows[:extra_steps])
+
+    pts = [(0, start_v)]
+    u, v = 0, start_v
+    for row in range(1, depth + 1):
+        u += 1
+        if row in orthogonal_rows:
+            pts.append((u, v))
+            v += sign
+        elif row in chosen_rows:
+            v += sign
+        pts.append((u, v))
+    return pts
+
+
+def _build_local_wall(rad, h, w):
+    """Construct wall shape in local coordinates. Returns (pts, depth, gap) or None."""
+    if rad[0]:
+        max_depth = min(DEPTH_VERT[1], h - 6)
+        if max_depth < DEPTH_VERT[0]:
+            return None
+        depth = random.randint(DEPTH_VERT[0], max_depth)
+        gap = random.randint(*GAP_VERT)
+    else:
+        depth = random.randint(DEPTH_HORIZ[0], min(DEPTH_HORIZ[1], w - 6))
+        gap = random.randint(GAP_HORIZ[0], min(GAP_HORIZ[1], h - 1))
+
+    if gap == 5:
+        left_bottom, right_bottom = 2, 3
+    elif gap == 6:
+        left_bottom, right_bottom = 2, 4
+    else:
+        left_bottom, right_bottom = random.choice([(2, 5), (3, 4)])
+
+    bridge_extra = max(0, right_bottom - left_bottom - 1)
+    base_count = 2 * (depth + 1) + bridge_extra
+    max_extra_l = max(0, left_bottom - 1)
+    max_extra_r = max(0, gap - right_bottom - 1)
+    min_extra = max(0, WALL_PIXELS_MIN - base_count)
+    max_extra = min(max_extra_l + max_extra_r, WALL_PIXELS_MAX - base_count)
+    if min_extra > max_extra:
+        return None
+
+    extra = random.randint(min_extra, max_extra)
+    extra_l = random.randint(max(0, extra - max_extra_r), min(max_extra_l, extra))
+    extra_r = extra - extra_l
+
+    max_n_side = max(left_bottom, gap - right_bottom)
+    tip_12 = depth >= 2 * max_n_side and random.random() < TIP_12_PROB
+    left = _make_arm(depth, 0, left_bottom, extra_l, tip_12=tip_12)
+    right = _make_arm(depth, gap, right_bottom, extra_r, tip_12=tip_12)
+    pts = set(left) | set(right)
+    for v in range(left_bottom, right_bottom + 1):
+        pts.add((depth, v))
+
+    while len(pts) < WALL_PIXELS_MIN:
+        candidates = [
+            (u, v)
+            for u in range(max(0, depth - 3), depth + 1)
+            for v in range(gap + 1)
+            if (u, v) not in pts
+            and sum(
+                (uu, vv) in pts
+                for uu in range(u - 1, u + 2)
+                for vv in range(v - 1, v + 2)
+                if (uu, vv) != (u, v)
+            ) >= 2
+        ]
+        random.shuffle(candidates)
+        added = False
+        for p in candidates:
+            trial = pts | {p}
+            if len(trial) <= WALL_PIXELS_MAX and len(_degree1_pixels(trial)) == 2:
+                pts = trial
+                added = True
+                break
+        if not added:
+            return None
+
+    if not (WALL_PIXELS_MIN <= len(pts) <= WALL_PIXELS_MAX) or len(_degree1_pixels(pts)) != 2:
+        return None
+    return pts, depth, gap
+
+
+def _map_local(u, v, rad, anchor):
+    """Map local (u, v) to grid (r, c) given radiate direction and anchor."""
+    r0, c0 = anchor
+    if rad == (-1, 0):
+        return r0 + u, c0 + v
+    if rad == (1, 0):
+        return r0 - u, c0 + v
+    if rad == (0, -1):
+        return r0 + v, c0 + u
+    return r0 + v, c0 - u
+
+
+def _place_anchor(rad, h, w, depth, gap):
+    """Choose anchor so the wall fits within margins."""
+    if rad == (-1, 0):
+        return random.randint(OPEN_END_MARGIN, h - depth - 3), random.randint(0, w - gap - 1)
+    if rad == (1, 0):
+        return random.randint(depth + 2, h - 4), random.randint(0, w - gap - 1)
+    if rad == (0, -1):
+        return random.randint(0, h - gap - 1), random.randint(OPEN_END_MARGIN, w - depth - 3)
+    return random.randint(0, h - gap - 1), random.randint(depth + 2, w - 4)
+
+
+def _local_interior(wall, depth, gap):
+    """Return cells strictly between the two wall arms in local coordinates."""
+    by_row = {}
+    for u, v in wall:
+        by_row.setdefault(u, []).append(v)
+    interior = []
+    for u in range(1, depth):
+        if u not in by_row or len(by_row[u]) < 2:
+            continue
+        lo, hi = min(by_row[u]), max(by_row[u])
+        for v in range(lo + 1, hi):
+            if (u, v) not in wall:
+                interior.append((u, v))
+    return interior
+
+
+def _obstacle_fits(pos, placed):
+    """Check that pos is at least Chebyshev OBSTACLE_MIN_SEP from all placed obstacles."""
+    r, c = pos
+    return all(max(abs(r - rr), abs(c - cc)) >= OBSTACLE_MIN_SEP for rr, cc in placed)
+
+
+def _find_obstacle_candidates(grid, bg, wall_color, nominal_region):
