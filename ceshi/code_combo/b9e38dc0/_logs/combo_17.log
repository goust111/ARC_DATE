+# Combo variant of b9e38dc0 (index 17)
+# combo_spec: D6/2+D14/1
+# Name: 锥形辐射+瓶颈通道
+
+# Design analysis
+# ---
+# combo_variant_spec:
+#   focus_change:
+#     from: "原题/瓶颈单变体都把外部辐射理解成由两条细边界线立即张开的扇区"
+#     to: "内部填充先被 1-2 格宽的瓶颈强制压缩，出了瓶颈后不再按原始斜边界立刻张开，而是以固定节奏逐段增宽，形成明显的锥形波束"
+#   concrete_geometry:
+#     wall:
+#       - 仍是最常见的非背景色、单个 8 连通组件、恰有 2 个 degree-1 端点。
+#       - 端点对应瓶颈出口，两端点位于同一条与 radiate_dir 垂直的轴线上。
+#       - 端点之间的可通行宽度固定为 1 或 2；这就是辐射在瓶颈中的束宽上限。
+#     radiate_zone:
+#       - 先在腔室+通道内部做常规 4 连通洪水填充。
+#       - 通道口之外，允许区域由 forward distance 控制：
+#         第 1-3 格保持瓶颈宽度，第 4-6 格每侧各多放 1 格，再往外重复。
+#       - 因此外部截面宽度序列是平台式增长，而不是原始 1:1 或 1:2 射线那种由墙臂斜率直接决定的增长。
+#   behavior_trace:
+#     - 原始 solver: 找到端点后直接从端点发细射线，把射线之间的整块背景都视为可达区。
+#     - D6/2 单变体: 先识别固定长度瓶颈，再从瓶颈口按旧射线规则外扩。
+#     - 本融合版:
+#       1. 用 wall 只封住腔室与通道，先限制 fill 只能到达瓶颈口。
+#       2. 再以瓶颈口作为二阶段源点，仅允许进入一个“宽度按 3 格一档扩张”的锥形区域。
+#       3. 障碍阴影仍沿 radiate_dir 扫描，因此瓶颈约束和锥形扩散会共同影响最终阴影轮廓。
+#   complexity_calibration:
+#     - 通道宽度只保留 {1,2} 两档，保持 D6 可见但不引入额外组合爆炸。
+#     - 锥形扩张周期固定为 3，不再让人类解题者猜多个速率；同时它与原题已有的 1:1 / 1:2 增宽节奏都不同，视觉上不会退化。
+#     - 墙体内部仍可出现 1:1 / 1:2 两种臂形，但 solver 不再把这个局部斜率当作外部扩张规则，从而真正体现融合后的“瓶颈主导 + 外部新规律”。
+#   implicit_assumption_audit:
+#     - 原 solver 假设: 端点邻域的墙方向就是外部边界方向。这里失效，因为端点只标记瓶颈口，不再直接定义最终边界。
+#     - 原 solver 假设: 一次全局 BFS + barrier 即可得到填充区。这里改为两段 BFS，否则填充会从瓶颈口外侧绕回锥形之外。
+#     - 原 solver 假设: 墙臂斜率决定外扩速度。这里被 D14/1 明确替换成固定周期的宽度增长。
+#     - 新 solver 假设:
+#       * 两个端点必须在同一出口线，且端点间空隙就是瓶颈宽度。
+#       * 通道口外至少有 6 格空间，这样 3 格一档的锥形增长在样例中可见。
+#       * 障碍不放进通道内部，否则会把“瓶颈约束”与“障碍阴影”混在一起，难以肉眼分辨。
+#   placement_legality:
+#     - 生成器沿用瓶颈局部坐标构造，保证墙不自交、恰有 2 个端点、通道直且宽度为 1-2。
+#     - anchor 选择强制开放侧至少保留 6 格空间，以展示至少两段锥形平台。
+#     - obstacle 候选要求离墙至少 2 格，因此不会堵住通道或贴在瓶颈边上造成歧义。
+#   visual_observability:
+#     - 输入里能直接看出“腔室明显宽于脖子”；输出里则能看出填充穿过窄颈后，外部宽度不是每步都涨，而是三格一档地变宽。
+#     - 生成器额外比较融合输出与 D6/2 基线输出，若二者太接近则丢弃，确保 D14/1 真正生效。
+#   cleanliness:
+#     - 颜色仍限制为 bg / wall / fill / 少量 obstacle。
+#     - 障碍优先撒在名义辐射区，但与墙保持距离，避免与通道壁或出口锥形边缘视觉重叠。
+#   generator_checks:
+#     - 主验证: 新 fill 至少 20 格，且触边。
+#     - 融合验证:
+#       * 外部截面宽度必须大于瓶颈宽度。
+#       * 至少有 2 次“相邻前进层宽度不变”的平台行，体现 3 格一档锥形。
+#       * 与瓶颈单变体基线输出的差异像素数达到阈值，防止退化成旧规则。
+
+from collections import deque
+import random
+
+import numpy as np
+from scipy.ndimage import distance_transform_cdt
+
+from arc_utils import neighbors4, neighbors8, components_mask, get_bg
+
+
+CORRIDOR_LEN = 3
+CONE_EXPAND_PERIOD = 3
+
+
+def _sgn(x: int) -> int:
+    return (x > 0) - (x < 0)
+
+
+def _bfs(starts: list[tuple[int, int]], passable: np.ndarray) -> np.ndarray:
+    seen = np.zeros_like(passable, dtype=bool)
+    q: deque[tuple[int, int]] = deque()
+    for r, c in starts:
+        if passable[r, c] and not seen[r, c]:
+            seen[r, c] = True
+            q.append((r, c))
+    h, w = passable.shape
+    while q:
+        r, c = q.popleft()
+        for rr, cc in neighbors4(r, c):
+            if 0 <= rr < h and 0 <= cc < w and passable[rr, cc] and not seen[rr, cc]:
+                seen[rr, cc] = True
+                q.append((rr, cc))
+    return seen
+
+
+def _analyze_scene(grid: np.ndarray) -> dict:
+    g = np.array(grid, copy=True)
+    h, w = g.shape
+    bg = get_bg(g)
+
+    vals = np.unique(g)
+    non_bg = [int(v) for v in vals if int(v) != bg]
+    assert non_bg, "expected at least one non-background color"
+
+    wall = max(non_bg, key=lambda c: int((g == c).sum()))
+    wall_mask = g == wall
+    comps = [set((int(r), int(c)) for r, c in pts) for pts in components_mask(wall_mask, connectivity=8)]
+    assert comps, "expected at least one wall connected component"
+
+    other_colors = [c for c in non_bg if c != wall]
+    assert other_colors, "expected at least one non-wall color"
+
+    wall_points = [p for comp in comps for p in comp]
+
+    def min_dist_to_wall(color: int) -> tuple[int, int]:
+        pts = [(int(r), int(c)) for r, c in zip(*np.where(g == color))]
+        best_d = 10**9
+        for r, c in pts:
+            for wr, wc in wall_points:
+                d = abs(r - wr) + abs(c - wc)
+                if d < best_d:
+                    best_d = d
+                    if best_d == 0:
+                        return 0, len(pts)
+        return best_d, len(pts)
+
+    fill = min(other_colors, key=lambda c: (min_dist_to_wall(c)[0], min_dist_to_wall(c)[1]))
+    fill_pos = [(int(r), int(c)) for r, c in zip(*np.where(g == fill))]
+    if not fill_pos:
+        raise AssertionError("expected at least one fill seed pixel")
+
+    def comp_min_dist(comp: set[tuple[int, int]]) -> int:
+        best_d = 10**9
+        for r, c in fill_pos:
+            for wr, wc in comp:
+                d = abs(r - wr) + abs(c - wc)
+                if d < best_d:
+                    best_d = d
+                    if best_d == 0:
+                        return 0
+        return best_d
+
+    wall_comp = min(comps, key=lambda comp: (comp_min_dist(comp), -len(comp)))
+    comp_mask = np.zeros_like(wall_mask, dtype=bool)
+    for r, c in wall_comp:
+        comp_mask[r, c] = True
+
+    def comp_neighbors(r: int, c: int) -> list[tuple[int, int]]:
+        out = []
+        for rr, cc in neighbors8(r, c):
+            if 0 <= rr < h and 0 <= cc < w and comp_mask[rr, cc]:
+                out.append((rr, cc))
+        return out
+
+    endpoints = [(r, c) for r, c in wall_comp if len(comp_neighbors(r, c)) == 1]
+    assert len(endpoints) == 2, "expected exactly two wall endpoints"
+
+    inward_dirs = []
+    for ep in endpoints:
+        nb = comp_neighbors(*ep)[0]
+        inward_dirs.append((_sgn(nb[0] - ep[0]), _sgn(nb[1] - ep[1])))
+
+    dr_sum = sum(d[0] for d in inward_dirs)
+    dc_sum = sum(d[1] for d in inward_dirs)
+    rad = (-_sgn(dr_sum), -_sgn(dc_sum))
+    assert rad in {(-1, 0), (1, 0), (0, -1), (0, 1)}, "expected cardinal radiate direction"
+
+    if rad[0] != 0:
+        endpoints.sort(key=lambda p: (p[1], p[0]))
+        exit_line = endpoints[0][0]
+        assert endpoints[1][0] == exit_line, "expected bottleneck endpoints on one row"
+        mouth_lo, mouth_hi = endpoints[0][1], endpoints[1][1]
+        lateral_axis = 1
+        rr, cc = np.indices(g.shape)
+        forward = (rr - exit_line) * rad[0]
+        lateral = cc
+        mouth_mask = np.zeros_like(comp_mask, dtype=bool)
+        mouth_mask[exit_line, mouth_lo + 1 : mouth_hi] = True
+    else:
+        endpoints.sort(key=lambda p: (p[0], p[1]))
+        exit_line = endpoints[0][1]
+        assert endpoints[1][1] == exit_line, "expected bottleneck endpoints on one column"
+        mouth_lo, mouth_hi = endpoints[0][0], endpoints[1][0]
+        lateral_axis = 0
+        rr, cc = np.indices(g.shape)
+        forward = (cc - exit_line) * rad[1]
+        lateral = rr
+        mouth_mask = np.zeros_like(comp_mask, dtype=bool)
+        mouth_mask[mouth_lo + 1 : mouth_hi, exit_line] = True
+
+    corridor_width = int(mouth_hi - mouth_lo - 1)
+    assert corridor_width in (1, 2), "expected 1-2 cell bottleneck width"
+
+    return {
+        "grid": g,
+        "h": h,
+        "w": w,
+        "bg": bg,
+        "wall": wall,
+        "fill": fill,
+        "fill_pos": fill_pos,
+        "wall_comp": wall_comp,
+        "comp_mask": comp_mask,
+        "comp_neighbors": comp_neighbors,
+        "endpoints": endpoints,
+        "rad": rad,
+        "exit_line": exit_line,
+        "mouth_lo": mouth_lo,
+        "mouth_hi": mouth_hi,
+        "corridor_width": corridor_width,
+        "lateral_axis": lateral_axis,
+        "forward": forward,
+        "lateral": lateral,
+        "mouth_mask": mouth_mask,
+        "base_passable": (~comp_mask) & ((g == bg) | (g == fill)),
+    }
+
+
+def _apply_shadows(geo: dict, filled_mask: np.ndarray) -> np.ndarray:
+    g = geo["grid"]
+    bg = geo["bg"]
+    fill = geo["fill"]
+    wall = geo["wall"]
+    rad = geo["rad"]
+
+    out = g.copy()
+    out[filled_mask] = fill
+
+    obstacles = (g != bg) & (g != fill) & (g != wall)
+
+    def shadow_process(coords: list[tuple[int, int]]) -> None:
+        started = False
+        blocked = False
+        for r, c in coords:
+            if filled_mask[r, c]:
+                started = True
+            if started and obstacles[r, c]:
+                blocked = True
+                continue
+            if blocked and filled_mask[r, c]:
+                out[r, c] = bg
+                filled_mask[r, c] = False
+
+    dr, dc = rad
+    h, w = g.shape
+    if dr != 0:
+        for c in range(w):
+            rows = range(h) if dr > 0 else range(h - 1, -1, -1)
+            shadow_process([(r, c) for r in rows])
+    else:
+        for r in range(h):
+            cols = range(w) if dc > 0 else range(w - 1, -1, -1)
+            shadow_process([(r, c) for c in cols])
+    return out
+
+
+def _solve_combo(grid: np.ndarray) -> np.ndarray:
+    geo = _analyze_scene(grid)
+    forward = geo["forward"]
+    lateral = geo["lateral"]
+    mouth_lo = geo["mouth_lo"]
+    mouth_hi = geo["mouth_hi"]
+    base_passable = geo["base_passable"]
+    mouth_mask = geo["mouth_mask"]
+
+    interior_passable = base_passable & ((forward < 0) | mouth_mask)
+    inside_seen = _bfs(geo["fill_pos"], interior_passable)
+
+    mouth_sources = [(int(r), int(c)) for r, c in zip(*np.where(inside_seen & mouth_mask))]
+    if mouth_sources:
+        grow = np.maximum(0, forward // CONE_EXPAND_PERIOD)
+        cone_mask = (
+            (forward > 0)
+            & (lateral >= (mouth_lo + 1 - grow))
+            & (lateral <= (mouth_hi - 1 + grow))
+        )
+        exterior_passable = base_passable & (mouth_mask | cone_mask)
+        outside_seen = _bfs(mouth_sources, exterior_passable)
+        seen = inside_seen | outside_seen
+    else:
+        seen = inside_seen
+
+    filled_mask = seen & (geo["grid"] == geo["bg"])
+    return _apply_shadows(geo, filled_mask)
+
+
+def _infer_tip12(geo: dict, limit: int = CORRIDOR_LEN + 6) -> bool:
+    comp_neighbors = geo["comp_neighbors"]
+    endpoints = list(geo["endpoints"])
+    rad = geo["rad"]
+    inward_axis = (-rad[0], -rad[1])
+
+    def trace_side(ep: tuple[int, int]) -> list[tuple[int, int]]:
+        path = [ep]
+        prev = None
+        cur = ep
+        while len(path) < limit:
+            nbs = [p for p in comp_neighbors(*cur) if p != prev]
+            if not nbs:
+                break
+            if len(nbs) == 1:
+                nxt = nbs[0]
+            else:
+                nbs.sort(
+                    key=lambda p: (
+                        (p[0] - ep[0]) * inward_axis[0] + (p[1] - ep[1]) * inward_axis[1],
+                        abs(p[0] - ep[0]) + abs(p[1] - ep[1]),
+                    ),
+                    reverse=True,
+                )
+                nxt = nbs[0]
+            path.append(nxt)
+            prev, cur = cur, nxt
+        return path
+
+    for ep in endpoints:
+        path = trace_side(ep)
+        steps = [
+            (_sgn(path[i + 1][0] - path[i][0]), _sgn(path[i + 1][1] - path[i][1]))
+            for i in range(len(path) - 1)
+        ]
+        if len(steps) > CORRIDOR_LEN and steps[CORRIDOR_LEN] == inward_axis:
+            return True
+    return False
+
+
+def _solve_bottleneck_reference(grid: np.ndarray) -> np.ndarray:
+    geo = _analyze_scene(grid)
+    g = geo["grid"]
+    h, w = g.shape
+    comp_mask = geo["comp_mask"]
+    endpoints = list(geo["endpoints"])
+    rad = geo["rad"]
+    fill_pos = geo["fill_pos"]
+    bg = geo["bg"]
+
+    lateral = (0, 1) if rad[0] != 0 else (1, 0)
+    tip_12 = _infer_tip12(geo)
+
+    barrier = comp_mask.copy()
+
+    def add_ray(start: tuple[int, int], d: tuple[int, int]) -> None:
+        rr, cc = start
+        while True:
+            rr += d[0]
+            cc += d[1]
+            if not (0 <= rr < h and 0 <= cc < w):
+                break
+            barrier[rr, cc] = True
+
+    def add_ray_12(start: tuple[int, int], diag_d: tuple[int, int]) -> None:
+        rr, cc = start
+        step = 0
+        while True:
+            step += 1
+            if step % 2 == 1:
+                rr += diag_d[0]
+                cc += diag_d[1]
+            else:
+                rr += rad[0]
+                cc += rad[1]
+            if not (0 <= rr < h and 0 <= cc < w):
+                break
+            barrier[rr, cc] = True
+
+    for side_sign, ep in [(-1, endpoints[0]), (1, endpoints[1])]:
+        diag_d = (rad[0] + side_sign * lateral[0], rad[1] + side_sign * lateral[1])
+        if tip_12:
+            add_ray_12(ep, diag_d)
+        else:
+            add_ray(ep, diag_d)
+
+    passable = (~barrier) & ((g == bg) | (g == geo["fill"]))
+    seen = _bfs(fill_pos, passable)
+    filled_mask = seen & (g == bg)
+    return _apply_shadows(geo, filled_mask)
+
+
+def _outside_widths(fill_mask: np.ndarray, geo: dict) -> list[int]:
+    forward = geo["forward"]
+    max_forward = int(max(0, forward.max()))
+    widths: list[int] = []
+    for dist in range(1, max_forward + 1):
+        widths.append(int((fill_mask & (forward == dist)).sum()))
+    while widths and widths[-1] == 0:
+        widths.pop()
+    return widths
+
+
+def combo_metrics(grid: np.ndarray, out: np.ndarray | None = None) -> dict:
+    geo = _analyze_scene(grid)
+    if out is None:
+        out = _solve_combo(grid)
+    fill_mask = out == geo["fill"]
+    widths = _outside_widths(fill_mask, geo)
+    width_gain_rows = sum(1 for i in range(1, len(widths)) if widths[i] > widths[i - 1] > 0)
+    plateau_rows = sum(1 for i in range(1, len(widths)) if widths[i] == widths[i - 1] > 0)
+    baseline = _solve_bottleneck_reference(grid)
+    baseline_delta = int(np.sum(out != baseline))
+    return {
+        "corridor_width": int(geo["corridor_width"]),
+        "outside_widths": widths,
+        "max_outside_width": max(widths) if widths else 0,
+        "width_gain_rows": int(width_gain_rows),
+        "plateau_rows": int(plateau_rows),
+        "baseline_delta": int(baseline_delta),
+    }
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Fill a chamber through a narrow bottleneck, then let the escaped color spread as a cone.
+
+    Input structure:
+    - bg is the most common color. The wall is the most frequent non-bg color and forms one 8-connected enclosure whose only outlet is a 1-2 cell neck.
+    - A fill-color seed sits inside the chamber near the closed end. Any remaining non-bg colors are preserved obstacle pixels.
+
+    Rule:
+    - First flood-fill all bg cells reachable from the seed inside the chamber and along the neck.
+    - Once the fill reaches the neck mouth, continue outward only inside a cone whose width stays fixed for short runs and expands by one cell per side every three forward steps.
+    - Obstacles cast shadows along the radiate direction, erasing fill behind them while keeping the obstacle pixels unchanged.
+
+    Key insight: The endpoints no longer define the final ray lines directly; they define the bottleneck mouth, and the external fill geometry must be reconstructed from that mouth plus the staged cone-expansion schedule.
+    """
+    return _solve_combo(grid)
+
+
+# --------------- generator ---------------
+
+# Canvas size bounds
+GRID_H_VERT = (15, 18)
+GRID_H_HORIZ = (9, 18)
+GRID_W = (16, 20)
+
+# Wall geometry
+WALL_PIXELS_MIN = 17
+WALL_PIXELS_MAX = 25
+DEPTH_VERT = (6, 8)
+DEPTH_HORIZ = (6, 8)
+BASE_SPAN = (5, 7)
+CORRIDOR_WIDTHS = (1, 2)
+TIP_12_PROB = 0.45
+
+# Placement margins
+OPEN_END_MARGIN = 6
+
+# Fill seed
+SEED_SIZE_WEIGHTS = [1, 1, 1, 2, 2, 3, 4, 5, 6]
+SEED_DEPTH_LOOKBACK = 3
+
+# Obstacles
+MAX_OBSTACLES = 5
+OBSTACLE_IN_FILL_PROB = 0.65
+OBSTACLE_MIN_SEP = 2
+
+# Validation
+MIN_NEW_FILL = 20
+PALETTE_SIZE = (3, 5)
+GEN_RETRIES = 500
+MIN_CONE_DELTA = 6
+MIN_PLATEAU_ROWS = 2
+
+
+def _degree1_pixels(points: set[tuple[int, int]]) -> list[tuple[int, int]]:
+    pts = set(points)
+    return [
+        (r, c)
+        for r, c in pts
+        if sum((rr, cc) in pts for rr, cc in neighbors8(r, c)) == 1
+    ]
+
+
+def _make_arm(depth: int, start_v: int, target_v: int, tip_12: bool = False) -> list[tuple[int, int]]:
+    sign = _sgn(target_v - start_v)
+    n_side_steps = abs(target_v - start_v)
+    if n_side_steps == 0:
+        chosen_rows: list[int] = []
+    elif tip_12:
+        chosen_rows = [2 * (i + 1) for i in range(n_side_steps)]
+    else:
+        chosen_rows = [1]
+        if n_side_steps > 1:
+            chosen_rows += random.sample(range(2, depth + 1), n_side_steps - 1)
+        chosen_rows.sort()
+
+    pts = [(0, start_v)]
+    u, v = 0, start_v
+    for row in range(1, depth + 1):
+        u += 1
+        if row in chosen_rows:
+            v += sign
+        pts.append((u, v))
+    assert v == target_v
+    return pts
+
+
+def _build_local_wall(rad: tuple[int, int], h: int, w: int):
+    if rad[0]:
+        max_depth = min(DEPTH_VERT[1], h - OPEN_END_MARGIN - 4)
+        if max_depth < DEPTH_VERT[0]:
+            return None
+        depth = random.randint(DEPTH_VERT[0], max_depth)
+    else:
+        max_depth = min(DEPTH_HORIZ[1], w - OPEN_END_MARGIN - 4)
+        if max_depth < DEPTH_HORIZ[0]:
+            return None
+        depth = random.randint(DEPTH_HORIZ[0], max_depth)
+
+    body_depth = depth - CORRIDOR_LEN
+    if body_depth < 3:
+        return None
+
+    corridor_width = random.choice(CORRIDOR_WIDTHS)
+    want_12 = random.random() < TIP_12_PROB
+    candidates = []
+    for base_span in range(BASE_SPAN[0], BASE_SPAN[1] + 1):
+        widen_total = base_span - (corridor_width + 1)
+        if widen_total < 2:
+            continue
+        for left_out in range(1, widen_total):
+            right_out = widen_total - left_out
+            if right_out < 1:
+                continue
+            if max(left_out, right_out) > body_depth:
+                continue
+            feasible_12 = body_depth >= 2 * max(left_out, right_out)
+            if want_12 and feasible_12:
+                candidates.append((base_span, left_out, right_out, True))
+            elif not want_12:
+                candidates.append((base_span, left_out, right_out, False))
+            elif feasible_12:
+                candidates.append((base_span, left_out, right_out, True))
+    if not candidates:
+        return None
+
+    base_span, left_out, right_out, tip_12 = random.choice(candidates)
+    left_bottom, right_bottom = 0, base_span
+    neck_left = left_bottom + left_out
+    neck_right = right_bottom - right_out
+
+    left_corridor = [(u, neck_left) for u in range(CORRIDOR_LEN + 1)]
+    right_corridor = [(u, neck_right) for u in range(CORRIDOR_LEN + 1)]
+    left_body = [(u + CORRIDOR_LEN, v) for u, v in _make_arm(body_depth, neck_left, left_bottom, tip_12=tip_12)]
+    right_body = [(u + CORRIDOR_LEN, v) for u, v in _make_arm(body_depth, neck_right, right_bottom, tip_12=tip_12)]
+
+    pts = set(left_corridor) | set(right_corridor) | set(left_body) | set(right_body)
+    for v in range(left_bottom, right_bottom + 1):
+        pts.add((depth, v))
+
+    if len(_degree1_pixels(pts)) != 2:
+        return None
+    if not (WALL_PIXELS_MIN <= len(pts) <= WALL_PIXELS_MAX):
+        return None
+    return pts, depth, base_span
+
+
+def _map_local(u: int, v: int, rad: tuple[int, int], anchor: tuple[int, int]) -> tuple[int, int]:
+    r0, c0 = anchor
+    if rad == (-1, 0):
+        return r0 + u, c0 + v
+    if rad == (1, 0):
+        return r0 - u, c0 + v
+    if rad == (0, -1):
+        return r0 + v, c0 + u
+    return r0 + v, c0 - u
+
+
+def _place_anchor(rad: tuple[int, int], h: int, w: int, depth: int, base_span: int) -> tuple[int, int]:
+    if rad == (-1, 0):
+        return random.randint(OPEN_END_MARGIN, h - depth - 3), random.randint(0, w - base_span - 1)
+    if rad == (1, 0):
+        return random.randint(depth + 2, h - OPEN_END_MARGIN - 1), random.randint(0, w - base_span - 1)
+    if rad == (0, -1):
+        return random.randint(0, h - base_span - 1), random.randint(OPEN_END_MARGIN, w - depth - 3)
+    return random.randint(0, h - base_span - 1), random.randint(depth + 2, w - OPEN_END_MARGIN - 1)
+
+
+def _local_interior(wall: set[tuple[int, int]], depth: int) -> list[tuple[int, int]]:
+    by_row: dict[int, list[int]] = {}
+    for u, v in wall:
+        by_row.setdefault(u, []).append(v)
+    interior = []
+    for u in range(1, depth):
+        vals = by_row.get(u)
+        if vals is None or len(vals) < 2:
+            continue
+        lo, hi = min(vals), max(vals)
+        for v in range(lo + 1, hi):
+            if (u, v) not in wall:
+                interior.append((u, v))
+    return interior
+
+
+def _grow_seed_blob(seed: tuple[int, int], interior_set: set[tuple[int, int]]) -> set[tuple[int, int]]:
+    blob = {seed}
+    target_size = random.choice(SEED_SIZE_WEIGHTS)
+    frontier = [seed]
+    while len(blob) < target_size and frontier:
+        p = frontier.pop(random.randrange(len(frontier)))
+        u, v = p
+        for q in random.sample([(u - 1, v), (u + 1, v), (u, v - 1), (u, v + 1)], 4):
+            if q in interior_set and q not in blob:
+                blob.add(q)
+                frontier.append(q)
+                if len(blob) >= target_size:
+                    break
+    return blob
+
+
+def _obstacle_fits(pos: tuple[int, int], placed: list[tuple[int, int]]) -> bool:
+    r, c = pos
+    return all(max(abs(r - rr), abs(c - cc)) >= OBSTACLE_MIN_SEP for rr, cc in placed)
+
+
+def _find_obstacle_candidates(grid: np.ndarray, bg: int, wall_color: int, nominal_fill_zone: np.ndarray):
+    wall_mask = grid == wall_color
+    dist = distance_transform_cdt(~wall_mask, metric="taxicab")
+    far_from_wall = dist > 1
+    eligible = (grid == bg) & far_from_wall
+    all_coords = list(zip(*np.where(eligible)))
+    fill_coords = [p for p in all_coords if nominal_fill_zone[p[0], p[1]]]
+    random.shuffle(all_coords)
+    random.shuffle(fill_coords)
+    return [(int(r), int(c)) for r, c in all_coords], [(int(r), int(c)) for r, c in fill_coords]
+
+
+def _place_obstacles(
+    n_obstacles: int,
+    candidates: list[tuple[int, int]],
+    fill_candidates: list[tuple[int, int]],
+    obstacle_colors: list[int],
+    grid: np.ndarray,
+) -> None:
+    placed: list[tuple[int, int]] = []
+    n_fill = random.randint(0, min(n_obstacles, len(fill_candidates)))
+    if fill_candidates and random.random() < OBSTACLE_IN_FILL_PROB:
+        n_fill = max(1, n_fill)
+    for p in fill_candidates:
+        if len(placed) >= n_fill:
+            break
+        if _obstacle_fits(p, placed):
+            placed.append(p)
+    placed_set = set(placed)
+    for p in candidates:
+        if len(placed) >= n_obstacles:
+            break
+        if p not in placed_set and _obstacle_fits(p, placed):
+            placed.append(p)
+            placed_set.add(p)
+    for i, (r, c) in enumerate(placed):
+        grid[r, c] = obstacle_colors[i % len(obstacle_colors)]
+
+
+def _touches_border(mask: np.ndarray) -> bool:
+    return bool(mask[0, :].any() or mask[-1, :].any() or mask[:, 0].any() or mask[:, -1].any())
+
+
+def _gen_attempt():
+    rad = random.choice([(-1, 0), (1, 0), (0, -1), (0, 1)])
+    h = random.randint(*GRID_H_VERT) if rad[0] else random.randint(*GRID_H_HORIZ)
+    w = random.randint(*GRID_W)
+
+    built = _build_local_wall(rad, h, w)
+    if built is None:
+        return None
+    local_wall, depth, base_span = built
+    anchor = _place_anchor(rad, h, w, depth, base_span)
+
+    palette = random.sample(range(10), random.randint(*PALETTE_SIZE))
+    bg, wall_color, fill_color = palette[:3]
+    obstacle_colors = palette[3:]
+
+    grid = np.full((h, w), bg, dtype=int)
+    for u, v in local_wall:
+        r, c = _map_local(u, v, rad, anchor)
+        if not (0 <= r < h and 0 <= c < w):
+            return None
+        grid[r, c] = wall_color
+
+    interior = _local_interior(local_wall, depth)
+    interior_set = set(interior)
+    wall_set = set(local_wall)
+    adjacent = [
+        p
+        for p in interior
+        if any((p[0] + dr, p[1] + dc) in wall_set for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)])
+    ]
+    seed_pool = [p for p in adjacent if p[0] >= max(1, depth - SEED_DEPTH_LOOKBACK)]
+    if not seed_pool:
+        return None
+
+    blob = _grow_seed_blob(random.choice(seed_pool), interior_set)
+    for u, v in blob:
+        r, c = _map_local(u, v, rad, anchor)
+        if grid[r, c] != bg:
+            return None
+        grid[r, c] = fill_color
+
+    try:
+        nominal_out = main(grid)
+        baseline_out = _solve_bottleneck_reference(grid)
+    except Exception:
+        return None
+
+    nominal_fill_zone = (nominal_out == fill_color) & (grid == bg)
+    metrics = combo_metrics(grid, nominal_out)
+    if metrics["max_outside_width"] <= metrics["corridor_width"]:
+        return None
+    if metrics["plateau_rows"] < MIN_PLATEAU_ROWS:
+        return None
+    if metrics["baseline_delta"] < MIN_CONE_DELTA:
+        return None
+    if int(np.sum(nominal_out != baseline_out)) < MIN_CONE_DELTA:
+        return None
+
+    n_obstacles = random.randint(0, MAX_OBSTACLES)
+    if n_obstacles and not obstacle_colors:
+        available = [c for c in range(10) if c not in (bg, wall_color, fill_color)]
+        obstacle_colors = random.sample(available, random.randint(1, 2))
+    if n_obstacles:
+        candidates, fill_candidates = _find_obstacle_candidates(grid, bg, wall_color, nominal_fill_zone)
+        _place_obstacles(n_obstacles, candidates, fill_candidates, obstacle_colors, grid)
+
+    try:
+        out = main(grid)
+    except Exception:
+        return None
+
+    new_fill = (out == fill_color) & (grid == bg)
+    if int(new_fill.sum()) < MIN_NEW_FILL or not _touches_border(new_fill):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate valid bottleneck-cone b9e38dc0 input")

diff --git a/ceshi/code_combo/b9e38dc0/17/code.py b/ceshi/code_combo/b9e38dc0/17/code.py
new file mode 100644
index 0000000000000000000000000000000000000000..08fc161fb146f1733eebd5f8ae0c58a32983996b
--- /dev/null
+++ b/ceshi/code_combo/b9e38dc0/17/code.py
@@ -0,0 +1,735 @@
+# Combo variant of b9e38dc0 (index 17)
+# combo_spec: D6/2+D14/1
+# Name: 锥形辐射+瓶颈通道
+
+# Design analysis
+# ---
+# combo_variant_spec:
+#   focus_change:
+#     from: "原题/瓶颈单变体都把外部辐射理解成由两条细边界线立即张开的扇区"
+#     to: "内部填充先被 1-2 格宽的瓶颈强制压缩，出了瓶颈后不再按原始斜边界立刻张开，而是以固定节奏逐段增宽，形成明显的锥形波束"
+#   concrete_geometry:
+#     wall:
+#       - 仍是最常见的非背景色、单个 8 连通组件、恰有 2 个 degree-1 端点。
+#       - 端点对应瓶颈出口，两端点位于同一条与 radiate_dir 垂直的轴线上。
+#       - 端点之间的可通行宽度固定为 1 或 2；这就是辐射在瓶颈中的束宽上限。
+#     radiate_zone:
+#       - 先在腔室+通道内部做常规 4 连通洪水填充。
+#       - 通道口之外，允许区域由 forward distance 控制：
+#         第 1-3 格保持瓶颈宽度，第 4-6 格每侧各多放 1 格，再往外重复。
+#       - 因此外部截面宽度序列是平台式增长，而不是原始 1:1 或 1:2 射线那种由墙臂斜率直接决定的增长。
+#   behavior_trace:
+#     - 原始 solver: 找到端点后直接从端点发细射线，把射线之间的整块背景都视为可达区。
+#     - D6/2 单变体: 先识别固定长度瓶颈，再从瓶颈口按旧射线规则外扩。
+#     - 本融合版:
+#       1. 用 wall 只封住腔室与通道，先限制 fill 只能到达瓶颈口。
+#       2. 再以瓶颈口作为二阶段源点，仅允许进入一个“宽度按 3 格一档扩张”的锥形区域。
+#       3. 障碍阴影仍沿 radiate_dir 扫描，因此瓶颈约束和锥形扩散会共同影响最终阴影轮廓。
+#   complexity_calibration:
+#     - 通道宽度只保留 {1,2} 两档，保持 D6 可见但不引入额外组合爆炸。
+#     - 锥形扩张周期固定为 3，不再让人类解题者猜多个速率；同时它与原题已有的 1:1 / 1:2 增宽节奏都不同，视觉上不会退化。
+#     - 墙体内部仍可出现 1:1 / 1:2 两种臂形，但 solver 不再把这个局部斜率当作外部扩张规则，从而真正体现融合后的“瓶颈主导 + 外部新规律”。
+#   implicit_assumption_audit:
+#     - 原 solver 假设: 端点邻域的墙方向就是外部边界方向。这里失效，因为端点只标记瓶颈口，不再直接定义最终边界。
+#     - 原 solver 假设: 一次全局 BFS + barrier 即可得到填充区。这里改为两段 BFS，否则填充会从瓶颈口外侧绕回锥形之外。
+#     - 原 solver 假设: 墙臂斜率决定外扩速度。这里被 D14/1 明确替换成固定周期的宽度增长。
+#     - 新 solver 假设:
+#       * 两个端点必须在同一出口线，且端点间空隙就是瓶颈宽度。
+#       * 通道口外至少有 6 格空间，这样 3 格一档的锥形增长在样例中可见。
+#       * 障碍不放进通道内部，否则会把“瓶颈约束”与“障碍阴影”混在一起，难以肉眼分辨。
+#   placement_legality:
+#     - 生成器沿用瓶颈局部坐标构造，保证墙不自交、恰有 2 个端点、通道直且宽度为 1-2。
+#     - anchor 选择强制开放侧至少保留 6 格空间，以展示至少两段锥形平台。
+#     - obstacle 候选要求离墙至少 2 格，因此不会堵住通道或贴在瓶颈边上造成歧义。
+#   visual_observability:
+#     - 输入里能直接看出“腔室明显宽于脖子”；输出里则能看出填充穿过窄颈后，外部宽度不是每步都涨，而是三格一档地变宽。
+#     - 生成器额外比较融合输出与 D6/2 基线输出，若二者太接近则丢弃，确保 D14/1 真正生效。
+#   cleanliness:
+#     - 颜色仍限制为 bg / wall / fill / 少量 obstacle。
+#     - 障碍优先撒在名义辐射区，但与墙保持距离，避免与通道壁或出口锥形边缘视觉重叠。
+#   generator_checks:
+#     - 主验证: 新 fill 至少 20 格，且触边。
+#     - 融合验证:
+#       * 外部截面宽度必须大于瓶颈宽度。
+#       * 至少有 2 次“相邻前进层宽度不变”的平台行，体现 3 格一档锥形。
+#       * 与瓶颈单变体基线输出的差异像素数达到阈值，防止退化成旧规则。
+
+from collections import deque
+import random
+
+import numpy as np
+from scipy.ndimage import distance_transform_cdt
+
+from arc_utils import neighbors4, neighbors8, components_mask, get_bg
+
+
+CORRIDOR_LEN = 3
+CONE_EXPAND_PERIOD = 3
+
+
+def _sgn(x: int) -> int:
+    return (x > 0) - (x < 0)
+
+
+def _bfs(starts: list[tuple[int, int]], passable: np.ndarray) -> np.ndarray:
+    seen = np.zeros_like(passable, dtype=bool)
+    q: deque[tuple[int, int]] = deque()
+    for r, c in starts:
+        if passable[r, c] and not seen[r, c]:
+            seen[r, c] = True
+            q.append((r, c))
+    h, w = passable.shape
+    while q:
+        r, c = q.popleft()
+        for rr, cc in neighbors4(r, c):
+            if 0 <= rr < h and 0 <= cc < w and passable[rr, cc] and not seen[rr, cc]:
+                seen[rr, cc] = True
+                q.append((rr, cc))
+    return seen
+
+
+def _analyze_scene(grid: np.ndarray) -> dict:
+    g = np.array(grid, copy=True)
+    h, w = g.shape
+    bg = get_bg(g)
+
+    vals = np.unique(g)
+    non_bg = [int(v) for v in vals if int(v) != bg]
+    assert non_bg, "expected at least one non-background color"
+
+    wall = max(non_bg, key=lambda c: int((g == c).sum()))
+    wall_mask = g == wall
+    comps = [set((int(r), int(c)) for r, c in pts) for pts in components_mask(wall_mask, connectivity=8)]
+    assert comps, "expected at least one wall connected component"
+
+    other_colors = [c for c in non_bg if c != wall]
+    assert other_colors, "expected at least one non-wall color"
+
+    wall_points = [p for comp in comps for p in comp]
+
+    def min_dist_to_wall(color: int) -> tuple[int, int]:
+        pts = [(int(r), int(c)) for r, c in zip(*np.where(g == color))]
+        best_d = 10**9
+        for r, c in pts:
+            for wr, wc in wall_points:
+                d = abs(r - wr) + abs(c - wc)
+                if d < best_d:
+                    best_d = d
+                    if best_d == 0:
+                        return 0, len(pts)
+        return best_d, len(pts)
+
+    fill = min(other_colors, key=lambda c: (min_dist_to_wall(c)[0], min_dist_to_wall(c)[1]))
+    fill_pos = [(int(r), int(c)) for r, c in zip(*np.where(g == fill))]
+    if not fill_pos:
+        raise AssertionError("expected at least one fill seed pixel")
+
+    def comp_min_dist(comp: set[tuple[int, int]]) -> int:
+        best_d = 10**9
+        for r, c in fill_pos:
+            for wr, wc in comp:
+                d = abs(r - wr) + abs(c - wc)
+                if d < best_d:
+                    best_d = d
+                    if best_d == 0:
+                        return 0
+        return best_d
+
+    wall_comp = min(comps, key=lambda comp: (comp_min_dist(comp), -len(comp)))
+    comp_mask = np.zeros_like(wall_mask, dtype=bool)
+    for r, c in wall_comp:
+        comp_mask[r, c] = True
+
+    def comp_neighbors(r: int, c: int) -> list[tuple[int, int]]:
+        out = []
+        for rr, cc in neighbors8(r, c):
+            if 0 <= rr < h and 0 <= cc < w and comp_mask[rr, cc]:
+                out.append((rr, cc))
+        return out
+
+    endpoints = [(r, c) for r, c in wall_comp if len(comp_neighbors(r, c)) == 1]
+    assert len(endpoints) == 2, "expected exactly two wall endpoints"
+
+    inward_dirs = []
+    for ep in endpoints:
+        nb = comp_neighbors(*ep)[0]
+        inward_dirs.append((_sgn(nb[0] - ep[0]), _sgn(nb[1] - ep[1])))
+
+    dr_sum = sum(d[0] for d in inward_dirs)
+    dc_sum = sum(d[1] for d in inward_dirs)
+    rad = (-_sgn(dr_sum), -_sgn(dc_sum))
+    assert rad in {(-1, 0), (1, 0), (0, -1), (0, 1)}, "expected cardinal radiate direction"
+
+    if rad[0] != 0:
+        endpoints.sort(key=lambda p: (p[1], p[0]))
+        exit_line = endpoints[0][0]
+        assert endpoints[1][0] == exit_line, "expected bottleneck endpoints on one row"
+        mouth_lo, mouth_hi = endpoints[0][1], endpoints[1][1]
+        lateral_axis = 1
+        rr, cc = np.indices(g.shape)
+        forward = (rr - exit_line) * rad[0]
+        lateral = cc
+        mouth_mask = np.zeros_like(comp_mask, dtype=bool)
+        mouth_mask[exit_line, mouth_lo + 1 : mouth_hi] = True
+    else:
+        endpoints.sort(key=lambda p: (p[0], p[1]))
+        exit_line = endpoints[0][1]
+        assert endpoints[1][1] == exit_line, "expected bottleneck endpoints on one column"
+        mouth_lo, mouth_hi = endpoints[0][0], endpoints[1][0]
+        lateral_axis = 0
+        rr, cc = np.indices(g.shape)
+        forward = (cc - exit_line) * rad[1]
+        lateral = rr
+        mouth_mask = np.zeros_like(comp_mask, dtype=bool)
+        mouth_mask[mouth_lo + 1 : mouth_hi, exit_line] = True
+
+    corridor_width = int(mouth_hi - mouth_lo - 1)
+    assert corridor_width in (1, 2), "expected 1-2 cell bottleneck width"
+
+    return {
+        "grid": g,
+        "h": h,
+        "w": w,
+        "bg": bg,
+        "wall": wall,
+        "fill": fill,
+        "fill_pos": fill_pos,
+        "wall_comp": wall_comp,
+        "comp_mask": comp_mask,
+        "comp_neighbors": comp_neighbors,
+        "endpoints": endpoints,
+        "rad": rad,
+        "exit_line": exit_line,
+        "mouth_lo": mouth_lo,
+        "mouth_hi": mouth_hi,
+        "corridor_width": corridor_width,
+        "lateral_axis": lateral_axis,
+        "forward": forward,
+        "lateral": lateral,
+        "mouth_mask": mouth_mask,
+        "base_passable": (~comp_mask) & ((g == bg) | (g == fill)),
+    }
+
+
+def _apply_shadows(geo: dict, filled_mask: np.ndarray) -> np.ndarray:
+    g = geo["grid"]
+    bg = geo["bg"]
+    fill = geo["fill"]
+    wall = geo["wall"]
+    rad = geo["rad"]
+
+    out = g.copy()
+    out[filled_mask] = fill
+
+    obstacles = (g != bg) & (g != fill) & (g != wall)
+
+    def shadow_process(coords: list[tuple[int, int]]) -> None:
+        started = False
+        blocked = False
+        for r, c in coords:
+            if filled_mask[r, c]:
+                started = True
+            if started and obstacles[r, c]:
+                blocked = True
+                continue
+            if blocked and filled_mask[r, c]:
+                out[r, c] = bg
+                filled_mask[r, c] = False
+
+    dr, dc = rad
+    h, w = g.shape
+    if dr != 0:
+        for c in range(w):
+            rows = range(h) if dr > 0 else range(h - 1, -1, -1)
+            shadow_process([(r, c) for r in rows])
+    else:
+        for r in range(h):
+            cols = range(w) if dc > 0 else range(w - 1, -1, -1)
+            shadow_process([(r, c) for c in cols])
+    return out
+
+
+def _solve_combo(grid: np.ndarray) -> np.ndarray:
+    geo = _analyze_scene(grid)
+    forward = geo["forward"]
+    lateral = geo["lateral"]
+    mouth_lo = geo["mouth_lo"]
+    mouth_hi = geo["mouth_hi"]
+    base_passable = geo["base_passable"]
+    mouth_mask = geo["mouth_mask"]
+
+    interior_passable = base_passable & ((forward < 0) | mouth_mask)
+    inside_seen = _bfs(geo["fill_pos"], interior_passable)
+
+    mouth_sources = [(int(r), int(c)) for r, c in zip(*np.where(inside_seen & mouth_mask))]
+    if mouth_sources:
+        grow = np.maximum(0, forward // CONE_EXPAND_PERIOD)
+        cone_mask = (
+            (forward > 0)
+            & (lateral >= (mouth_lo + 1 - grow))
+            & (lateral <= (mouth_hi - 1 + grow))
+        )
+        exterior_passable = base_passable & (mouth_mask | cone_mask)
+        outside_seen = _bfs(mouth_sources, exterior_passable)
+        seen = inside_seen | outside_seen
+    else:
+        seen = inside_seen
+
+    filled_mask = seen & (geo["grid"] == geo["bg"])
+    return _apply_shadows(geo, filled_mask)
+
+
+def _infer_tip12(geo: dict, limit: int = CORRIDOR_LEN + 6) -> bool:
+    comp_neighbors = geo["comp_neighbors"]
+    endpoints = list(geo["endpoints"])
+    rad = geo["rad"]
+    inward_axis = (-rad[0], -rad[1])
+
+    def trace_side(ep: tuple[int, int]) -> list[tuple[int, int]]:
+        path = [ep]
+        prev = None
+        cur = ep
+        while len(path) < limit:
+            nbs = [p for p in comp_neighbors(*cur) if p != prev]
+            if not nbs:
+                break
+            if len(nbs) == 1:
+                nxt = nbs[0]
+            else:
+                nbs.sort(
+                    key=lambda p: (
+                        (p[0] - ep[0]) * inward_axis[0] + (p[1] - ep[1]) * inward_axis[1],
+                        abs(p[0] - ep[0]) + abs(p[1] - ep[1]),
+                    ),
+                    reverse=True,
+                )
+                nxt = nbs[0]
+            path.append(nxt)
+            prev, cur = cur, nxt
+        return path
+
+    for ep in endpoints:
+        path = trace_side(ep)
+        steps = [
+            (_sgn(path[i + 1][0] - path[i][0]), _sgn(path[i + 1][1] - path[i][1]))
+            for i in range(len(path) - 1)
+        ]
+        if len(steps) > CORRIDOR_LEN and steps[CORRIDOR_LEN] == inward_axis:
+            return True
+    return False
+
+
+def _solve_bottleneck_reference(grid: np.ndarray) -> np.ndarray:
+    geo = _analyze_scene(grid)
+    g = geo["grid"]
+    h, w = g.shape
+    comp_mask = geo["comp_mask"]
+    endpoints = list(geo["endpoints"])
+    rad = geo["rad"]
+    fill_pos = geo["fill_pos"]
+    bg = geo["bg"]
+
+    lateral = (0, 1) if rad[0] != 0 else (1, 0)
+    tip_12 = _infer_tip12(geo)
+
+    barrier = comp_mask.copy()
+
+    def add_ray(start: tuple[int, int], d: tuple[int, int]) -> None:
+        rr, cc = start
+        while True:
+            rr += d[0]
+            cc += d[1]
+            if not (0 <= rr < h and 0 <= cc < w):
+                break
+            barrier[rr, cc] = True
+
+    def add_ray_12(start: tuple[int, int], diag_d: tuple[int, int]) -> None:
+        rr, cc = start
+        step = 0
+        while True:
+            step += 1
+            if step % 2 == 1:
+                rr += diag_d[0]
+                cc += diag_d[1]
+            else:
+                rr += rad[0]
+                cc += rad[1]
+            if not (0 <= rr < h and 0 <= cc < w):
+                break
+            barrier[rr, cc] = True
+
+    for side_sign, ep in [(-1, endpoints[0]), (1, endpoints[1])]:
+        diag_d = (rad[0] + side_sign * lateral[0], rad[1] + side_sign * lateral[1])
+        if tip_12:
+            add_ray_12(ep, diag_d)
+        else:
+            add_ray(ep, diag_d)
+
+    passable = (~barrier) & ((g == bg) | (g == geo["fill"]))
+    seen = _bfs(fill_pos, passable)
+    filled_mask = seen & (g == bg)
+    return _apply_shadows(geo, filled_mask)
+
+
+def _outside_widths(fill_mask: np.ndarray, geo: dict) -> list[int]:
+    forward = geo["forward"]
+    max_forward = int(max(0, forward.max()))
+    widths: list[int] = []
+    for dist in range(1, max_forward + 1):
+        widths.append(int((fill_mask & (forward == dist)).sum()))
+    while widths and widths[-1] == 0:
+        widths.pop()
+    return widths
+
+
+def combo_metrics(grid: np.ndarray, out: np.ndarray | None = None) -> dict:
+    geo = _analyze_scene(grid)
+    if out is None:
+        out = _solve_combo(grid)
+    fill_mask = out == geo["fill"]
+    widths = _outside_widths(fill_mask, geo)
+    width_gain_rows = sum(1 for i in range(1, len(widths)) if widths[i] > widths[i - 1] > 0)
+    plateau_rows = sum(1 for i in range(1, len(widths)) if widths[i] == widths[i - 1] > 0)
+    baseline = _solve_bottleneck_reference(grid)
+    baseline_delta = int(np.sum(out != baseline))
+    return {
+        "corridor_width": int(geo["corridor_width"]),
+        "outside_widths": widths,
+        "max_outside_width": max(widths) if widths else 0,
+        "width_gain_rows": int(width_gain_rows),
+        "plateau_rows": int(plateau_rows),
+        "baseline_delta": int(baseline_delta),
+    }
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Fill a chamber through a narrow bottleneck, then let the escaped color spread as a cone.
+
+    Input structure:
+    - bg is the most common color. The wall is the most frequent non-bg color and forms one 8-connected enclosure whose only outlet is a 1-2 cell neck.
+    - A fill-color seed sits inside the chamber near the closed end. Any remaining non-bg colors are preserved obstacle pixels.
+
+    Rule:
+    - First flood-fill all bg cells reachable from the seed inside the chamber and along the neck.
+    - Once the fill reaches the neck mouth, continue outward only inside a cone whose width stays fixed for short runs and expands by one cell per side every three forward steps.
+    - Obstacles cast shadows along the radiate direction, erasing fill behind them while keeping the obstacle pixels unchanged.
+
+    Key insight: The endpoints no longer define the final ray lines directly; they define the bottleneck mouth, and the external fill geometry must be reconstructed from that mouth plus the staged cone-expansion schedule.
+    """
+    return _solve_combo(grid)
+
+
+# --------------- generator ---------------
+
+# Canvas size bounds
+GRID_H_VERT = (15, 18)
+GRID_H_HORIZ = (9, 18)
+GRID_W = (16, 20)
+
+# Wall geometry
+WALL_PIXELS_MIN = 17
+WALL_PIXELS_MAX = 25
+DEPTH_VERT = (6, 8)
+DEPTH_HORIZ = (6, 8)
+BASE_SPAN = (5, 7)
+CORRIDOR_WIDTHS = (1, 2)
+TIP_12_PROB = 0.45
+
+# Placement margins
+OPEN_END_MARGIN = 6
+
+# Fill seed
+SEED_SIZE_WEIGHTS = [1, 1, 1, 2, 2, 3, 4, 5, 6]
+SEED_DEPTH_LOOKBACK = 3
+
+# Obstacles
+MAX_OBSTACLES = 5
+OBSTACLE_IN_FILL_PROB = 0.65
+OBSTACLE_MIN_SEP = 2
+
+# Validation
+MIN_NEW_FILL = 20
+PALETTE_SIZE = (3, 5)
+GEN_RETRIES = 500
+MIN_CONE_DELTA = 6
+MIN_PLATEAU_ROWS = 2
+
+
+def _degree1_pixels(points: set[tuple[int, int]]) -> list[tuple[int, int]]:
+    pts = set(points)
+    return [
+        (r, c)
+        for r, c in pts
+        if sum((rr, cc) in pts for rr, cc in neighbors8(r, c)) == 1
+    ]
+
+
+def _make_arm(depth: int, start_v: int, target_v: int, tip_12: bool = False) -> list[tuple[int, int]]:
+    sign = _sgn(target_v - start_v)
+    n_side_steps = abs(target_v - start_v)
+    if n_side_steps == 0:
+        chosen_rows: list[int] = []
+    elif tip_12:
+        chosen_rows = [2 * (i + 1) for i in range(n_side_steps)]
+    else:
+        chosen_rows = [1]
+        if n_side_steps > 1:
+            chosen_rows += random.sample(range(2, depth + 1), n_side_steps - 1)
+        chosen_rows.sort()
+
+    pts = [(0, start_v)]
+    u, v = 0, start_v
+    for row in range(1, depth + 1):
+        u += 1
+        if row in chosen_rows:
+            v += sign
+        pts.append((u, v))
+    assert v == target_v
+    return pts
+
+
+def _build_local_wall(rad: tuple[int, int], h: int, w: int):
+    if rad[0]:
+        max_depth = min(DEPTH_VERT[1], h - OPEN_END_MARGIN - 4)
+        if max_depth < DEPTH_VERT[0]:
+            return None
+        depth = random.randint(DEPTH_VERT[0], max_depth)
+    else:
+        max_depth = min(DEPTH_HORIZ[1], w - OPEN_END_MARGIN - 4)
+        if max_depth < DEPTH_HORIZ[0]:
+            return None
+        depth = random.randint(DEPTH_HORIZ[0], max_depth)
+
+    body_depth = depth - CORRIDOR_LEN
+    if body_depth < 3:
+        return None
+
+    corridor_width = random.choice(CORRIDOR_WIDTHS)
+    want_12 = random.random() < TIP_12_PROB
+    candidates = []
+    for base_span in range(BASE_SPAN[0], BASE_SPAN[1] + 1):
+        widen_total = base_span - (corridor_width + 1)
+        if widen_total < 2:
+            continue
+        for left_out in range(1, widen_total):
+            right_out = widen_total - left_out
+            if right_out < 1:
+                continue
+            if max(left_out, right_out) > body_depth:
+                continue
+            feasible_12 = body_depth >= 2 * max(left_out, right_out)
+            if want_12 and feasible_12:
+                candidates.append((base_span, left_out, right_out, True))
+            elif not want_12:
+                candidates.append((base_span, left_out, right_out, False))
+            elif feasible_12:
+                candidates.append((base_span, left_out, right_out, True))
+    if not candidates:
+        return None
+
+    base_span, left_out, right_out, tip_12 = random.choice(candidates)
+    left_bottom, right_bottom = 0, base_span
+    neck_left = left_bottom + left_out
+    neck_right = right_bottom - right_out
+
+    left_corridor = [(u, neck_left) for u in range(CORRIDOR_LEN + 1)]
+    right_corridor = [(u, neck_right) for u in range(CORRIDOR_LEN + 1)]
+    left_body = [(u + CORRIDOR_LEN, v) for u, v in _make_arm(body_depth, neck_left, left_bottom, tip_12=tip_12)]
+    right_body = [(u + CORRIDOR_LEN, v) for u, v in _make_arm(body_depth, neck_right, right_bottom, tip_12=tip_12)]
+
+    pts = set(left_corridor) | set(right_corridor) | set(left_body) | set(right_body)
+    for v in range(left_bottom, right_bottom + 1):
+        pts.add((depth, v))
+
+    if len(_degree1_pixels(pts)) != 2:
+        return None
+    if not (WALL_PIXELS_MIN <= len(pts) <= WALL_PIXELS_MAX):
+        return None
+    return pts, depth, base_span
+
+
+def _map_local(u: int, v: int, rad: tuple[int, int], anchor: tuple[int, int]) -> tuple[int, int]:
+    r0, c0 = anchor
+    if rad == (-1, 0):
+        return r0 + u, c0 + v
+    if rad == (1, 0):
+        return r0 - u, c0 + v
+    if rad == (0, -1):
+        return r0 + v, c0 + u
+    return r0 + v, c0 - u
+
+
+def _place_anchor(rad: tuple[int, int], h: int, w: int, depth: int, base_span: int) -> tuple[int, int]:
+    if rad == (-1, 0):
+        return random.randint(OPEN_END_MARGIN, h - depth - 3), random.randint(0, w - base_span - 1)
+    if rad == (1, 0):
+        return random.randint(depth + 2, h - OPEN_END_MARGIN - 1), random.randint(0, w - base_span - 1)
+    if rad == (0, -1):
+        return random.randint(0, h - base_span - 1), random.randint(OPEN_END_MARGIN, w - depth - 3)
+    return random.randint(0, h - base_span - 1), random.randint(depth + 2, w - OPEN_END_MARGIN - 1)
+
+
+def _local_interior(wall: set[tuple[int, int]], depth: int) -> list[tuple[int, int]]:
+    by_row: dict[int, list[int]] = {}
+    for u, v in wall:
+        by_row.setdefault(u, []).append(v)
+    interior = []
+    for u in range(1, depth):
+        vals = by_row.get(u)
+        if vals is None or len(vals) < 2:
+            continue
+        lo, hi = min(vals), max(vals)
+        for v in range(lo + 1, hi):
+            if (u, v) not in wall:
+                interior.append((u, v))
+    return interior
+
+
+def _grow_seed_blob(seed: tuple[int, int], interior_set: set[tuple[int, int]]) -> set[tuple[int, int]]:
+    blob = {seed}
+    target_size = random.choice(SEED_SIZE_WEIGHTS)
