   622	        r, c = _map_local(u, v, rad, anchor)
   623	        if grid[r, c] != bg:
   624	            return None
   625	        grid[r, c] = fill_color
   626	
   627	    try:
   628	        _, nominal_meta = _solve_core(grid)
   629	    except Exception:
   630	        return None
   631	    nominal_fill_zone = nominal_meta["paint_mask"] & (grid == bg)
   632	
   633	    n_obstacles = random.randint(0, MAX_OBSTACLES)
   634	    if n_obstacles and not obstacle_colors:
   635	        available = [c for c in range(10) if c not in (bg, wall_color, fill_color)]
   636	        obstacle_colors = random.sample(available, random.randint(1, 2))
   637	    if n_obstacles:
