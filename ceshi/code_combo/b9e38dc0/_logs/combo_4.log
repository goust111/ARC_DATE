   651	
   652	    if int(paint_mask.sum()) < MIN_NEW_FILL or not _touches_border(paint_mask):
   653	        return None
   654	    if meta["gate_width"] < 4:
   655	        return None
   656	    if int(radiated_mask.sum()) < MIN_RADIATE_PIXELS:
   657	        return None
   658	    if int(wall_band_mask.sum()) < MIN_WALL_BAND_PIXELS:
   659	        return None
   660	    if int(fill_band_mask.sum()) < MIN_FILL_BAND_PIXELS:
   661	        return None
   662	    if not np.any(radiated_mask):
   663	        return None
   664	    if int(depth_map[radiated_mask].max()) < PATTERN_REPEAT_DEPTH:
   665	        return None
   666	
