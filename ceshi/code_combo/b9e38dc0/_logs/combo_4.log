   562	def main(grid: np.ndarray) -> np.ndarray:
   563	    """
   564	    Fill a wall-bounded chamber, then emit an opening-width striped radiation band.
   565	
   566	    Input structure:
   567	    - The most common color is background. The dominant non-background color is a single wall
   568	      component forming a partial enclosure with one visible mouth between its two endpoints.
   569	    - A nearby non-wall color marks the seed blob inside the chamber. Any other non-background
   570	      pixels are preserved obstacles.
   571	
