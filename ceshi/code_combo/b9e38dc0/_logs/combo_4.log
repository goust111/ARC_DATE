+def _closest_wall_component(
+    comps: list[set[tuple[int, int]]],
+    fill_pos: list[tuple[int, int]],
+) -> set[tuple[int, int]]:
+    def comp_min_dist(comp: set[tuple[int, int]]) -> int:
+        best_d = 10**9
+        for r, c in fill_pos:
+            for wr, wc in comp:
+                d = abs(r - wr) + abs(c - wc)
+                if d < best_d:
+                    best_d = d
+                    if best_d == 0:
+                        return 0
+        return best_d
