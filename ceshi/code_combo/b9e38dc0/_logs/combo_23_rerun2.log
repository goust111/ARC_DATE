+
+def _sgn(x: int) -> int:
+    return (x > 0) - (x < 0)
+
+
+def _coords_of_color(grid: np.ndarray, color: int) -> list[tuple[int, int]]:
+    pts = list(zip(*np.where(grid == color)))
+    return [(int(r), int(c)) for r, c in pts]
+
+
+def _degree1_pixels(points: set[tuple[int, int]]) -> list[tuple[int, int]]:
+    pts = set(points)
+    return [
+        (r, c)
+        for r, c in pts
+        if sum((rr, cc) in pts for rr, cc in neighbors8(r, c)) == 1
+    ]
+
+
+def _make_arm(
+    depth: int,
+    start_v: int,
+    target_v: int,
+    extra_steps: int,
+    *,
+    tip_12: bool = False,
+) -> list[tuple[int, int]]:
+    sign = 1 if target_v > start_v else -1
+    n_side_steps = abs(target_v - start_v)
+    chosen_rows: list[int] = []
+    if n_side_steps:
+        if tip_12:
+            chosen_rows = [2 * (i + 1) for i in range(n_side_steps)]
+            extra_steps = 0
+        else:
+            chosen_rows = [1]
+            if n_side_steps > 1:
+                chosen_rows += random.sample(range(2, depth + 1), n_side_steps - 1)
+            chosen_rows.sort()
+
+    first_row = chosen_rows[0] if chosen_rows else 1
+    extra_rows = [r for r in chosen_rows if r != first_row]
+    random.shuffle(extra_rows)
+    orthogonal_rows = set(extra_rows[:extra_steps])
+
+    pts = [(0, start_v)]
+    u, v = 0, start_v
+    for row in range(1, depth + 1):
+        u += 1
+        if row in orthogonal_rows:
+            pts.append((u, v))
+            v += sign
+        elif row in chosen_rows:
+            v += sign
+        pts.append((u, v))
+    return pts
+
+
+def _build_local_wall(rad: tuple[int, int], h: int, w: int):
+    if rad[0]:
+        max_depth = min(DEPTH_VERT[1], h - 7)
+        if max_depth < DEPTH_VERT[0]:
+            return None
+        depth = random.randint(DEPTH_VERT[0], max_depth)
+        gap = random.randint(*GAP_VERT)
+    else:
+        max_depth = min(DEPTH_HORIZ[1], w - 7)
+        if max_depth < DEPTH_HORIZ[0]:
+            return None
+        depth = random.randint(DEPTH_HORIZ[0], max_depth)
+        gap = random.randint(GAP_HORIZ[0], min(GAP_HORIZ[1], h - 2))
+
+    if gap == 5:
+        left_bottom, right_bottom = 2, 3
+    elif gap == 6:
+        left_bottom, right_bottom = 2, 4
+    else:
+        left_bottom, right_bottom = random.choice([(2, 5), (3, 4)])
+
+    bridge_extra = max(0, right_bottom - left_bottom - 1)
+    base_count = 2 * (depth + 1) + bridge_extra
+    max_extra_l = max(0, left_bottom - 1)
+    max_extra_r = max(0, gap - right_bottom - 1)
+    min_extra = max(0, WALL_PIXELS_MIN - base_count)
+    max_extra = min(max_extra_l + max_extra_r, WALL_PIXELS_MAX - base_count)
+    if min_extra > max_extra:
+        return None
+
+    extra = random.randint(min_extra, max_extra)
+    extra_l = random.randint(max(0, extra - max_extra_r), min(max_extra_l, extra))
+    extra_r = extra - extra_l
+
+    max_n_side = max(left_bottom, gap - right_bottom)
+    tip_12 = depth >= 2 * max_n_side and random.random() < TIP_12_PROB
+
+    left = _make_arm(depth, 0, left_bottom, extra_l, tip_12=tip_12)
+    right = _make_arm(depth, gap, right_bottom, extra_r, tip_12=tip_12)
+    pts = set(left) | set(right)
+    for v in range(left_bottom, right_bottom + 1):
+        pts.add((depth, v))
+
+    while len(pts) < WALL_PIXELS_MIN:
+        candidates = [
+            (u, v)
+            for u in range(max(0, depth - 3), depth + 1)
+            for v in range(gap + 1)
+            if (u, v) not in pts
+            and sum(
+                (uu, vv) in pts
+                for uu in range(u - 1, u + 2)
+                for vv in range(v - 1, v + 2)
+                if (uu, vv) != (u, v)
+            )
+            >= 2
+        ]
+        random.shuffle(candidates)
+        added = False
+        for p in candidates:
+            trial = pts | {p}
+            if len(trial) <= WALL_PIXELS_MAX and len(_degree1_pixels(trial)) == 2:
+                pts = trial
+                added = True
+                break
+        if not added:
+            return None
+
+    if not (WALL_PIXELS_MIN <= len(pts) <= WALL_PIXELS_MAX):
+        return None
+    if len(_degree1_pixels(pts)) != 2:
+        return None
+    return pts, depth, gap
+
+
+def _map_local(u: int, v: int, rad: tuple[int, int], anchor: tuple[int, int]) -> tuple[int, int]:
+    r0, c0 = anchor
+    if rad == (-1, 0):
+        return r0 + u, c0 + v
+    if rad == (1, 0):
+        return r0 - u, c0 + v
+    if rad == (0, -1):
+        return r0 + v, c0 + u
+    return r0 + v, c0 - u
+
+
+def _map_points(
+    points: list[tuple[int, int]] | set[tuple[int, int]],
+    rad: tuple[int, int],
+    anchor: tuple[int, int],
+) -> list[tuple[int, int]]:
+    return [_map_local(u, v, rad, anchor) for u, v in points]
+
+
+def _local_interior(wall: set[tuple[int, int]], depth: int) -> list[tuple[int, int]]:
+    by_row: dict[int, list[int]] = {}
+    for u, v in wall:
+        by_row.setdefault(u, []).append(v)
+    interior: list[tuple[int, int]] = []
+    for u in range(1, depth):
+        if u not in by_row or len(by_row[u]) < 2:
+            continue
+        lo, hi = min(by_row[u]), max(by_row[u])
+        for v in range(lo + 1, hi):
+            if (u, v) not in wall:
+                interior.append((u, v))
+    return interior
+
+
+def _grow_seed_blob(seed: tuple[int, int], interior_set: set[tuple[int, int]]) -> set[tuple[int, int]]:
+    blob = {seed}
+    target_size = random.choice(SEED_SIZE_WEIGHTS)
+    frontier = [seed]
+    while len(blob) < target_size and frontier:
+        u, v = frontier.pop(random.randrange(len(frontier)))
+        nbrs = [(u - 1, v), (u + 1, v), (u, v - 1), (u, v + 1)]
+        random.shuffle(nbrs)
+        for q in nbrs:
+            if q in interior_set and q not in blob:
+                blob.add(q)
+                frontier.append(q)
+                if len(blob) >= target_size:
+                    break
+    return blob
+
+
+def _place_anchor(rad: tuple[int, int], h: int, w: int, depth: int, gap: int) -> tuple[int, int]:
+    if rad == (-1, 0):
+        return random.randint(OPEN_END_MARGIN, h - depth - 3), random.randint(1, w - gap - 2)
+    if rad == (1, 0):
+        return random.randint(depth + 2, h - OPEN_END_MARGIN - 1), random.randint(1, w - gap - 2)
+    if rad == (0, -1):
+        return random.randint(1, h - gap - 2), random.randint(OPEN_END_MARGIN, w - depth - 3)
+    return random.randint(1, h - gap - 2), random.randint(depth + 2, w - OPEN_END_MARGIN - 1)
+
+
+def _in_bounds_all(points: list[tuple[int, int]], h: int, w: int) -> bool:
+    return all(0 <= r < h and 0 <= c < w for r, c in points)
+
+
+def _opening_cells_from_endpoints(endpoints: list[tuple[int, int]]) -> list[tuple[int, int]]:
+    assert len(endpoints) == 2
+    (r1, c1), (r2, c2) = sorted(endpoints)
+    if r1 == r2:
+        lo, hi = sorted((c1, c2))
+        return [(r1, c) for c in range(lo + 1, hi)]
+    if c1 == c2:
+        lo, hi = sorted((r1, r2))
+        return [(r, c1) for r in range(lo + 1, hi)]
+    dr = _sgn(r2 - r1)
+    dc = _sgn(c2 - c1)
+    out = []
+    rr, cc = r1 + dr, c1 + dc
+    while (rr, cc) != (r2, c2):
+        out.append((rr, cc))
+        rr += dr
+        cc += dc
+    return out
+
+
+def _component_info(comp: set[tuple[int, int]], h: int, w: int) -> dict:
+    comp_mask = np.zeros((h, w), dtype=bool)
+    for r, c in comp:
+        comp_mask[r, c] = True
+
+    def comp_neighbors(r: int, c: int) -> list[tuple[int, int]]:
+        out = []
+        for rr, cc in neighbors8(r, c):
+            if 0 <= rr < h and 0 <= cc < w and comp_mask[rr, cc]:
+                out.append((rr, cc))
+        return out
+
+    endpoints = sorted((r, c) for r, c in comp if len(comp_neighbors(r, c)) == 1)
+    assert len(endpoints) == 2, "expected exactly two endpoints"
+
+    def outward_dir(ep: tuple[int, int]) -> tuple[tuple[int, int], bool]:
+        n1 = comp_neighbors(*ep)[0]
+        d1 = (_sgn(n1[0] - ep[0]), _sgn(n1[1] - ep[1]))
+        d_use = d1
+        is_12 = False
+        n2s = [p for p in comp_neighbors(*n1) if p != ep]
+        if n2s:
+            n2 = n2s[0]
+            d2 = (_sgn(n2[0] - n1[0]), _sgn(n2[1] - n1[1]))
+            if (d1[0] == 0) ^ (d1[1] == 0):
+                if d2[0] != 0 and d2[1] != 0:
+                    d_use = d2
+                    is_12 = True
+        return (-d_use[0], -d_use[1]), is_12
+
+    out_info = [outward_dir(ep) for ep in endpoints]
+    out_dirs = [d for d, _ in out_info]
+    rad = (_sgn(sum(d[0] for d in out_dirs)), _sgn(sum(d[1] for d in out_dirs)))
+    assert rad in {(-1, 0), (1, 0), (0, -1), (0, 1)}, "expected cardinal radiate direction"
+
+    rays = []
+    for ray_id, (ep, (d, is_12)) in enumerate(zip(endpoints, out_info)):
+        rays.append(
+            {
+                "local_ray_id": ray_id,
+                "start": ep,
+                "dir": d,
+                "is_12": is_12,
+            }
+        )
+
+    return {
+        "points": frozenset(comp),
+        "mask": comp_mask,
+        "endpoints": tuple(endpoints),
+        "opening": tuple(_opening_cells_from_endpoints(endpoints)),
+        "rad": rad,
+        "rays": rays,
+    }
+
+
+def _trace_ray_path(
+    shape: tuple[int, int],
+    wall_mask: np.ndarray,
+    *,
+    start: tuple[int, int],
+    direction: tuple[int, int],
+    is_12: bool,
+    rad: tuple[int, int],
+) -> list[tuple[int, int]]:
+    h, w = shape
+    rr, cc = start
+    phase = 0
+    out: list[tuple[int, int]] = []
+    while True:
+        if not is_12:
+            dr, dc = direction
+        elif phase % 2 == 0:
+            dr, dc = direction
+        elif rad[0] != 0:
+            dr, dc = direction[0], 0
+        else:
+            dr, dc = 0, direction[1]
+        rr += dr
+        cc += dc
+        if not (0 <= rr < h and 0 <= cc < w):
+            break
+        if wall_mask[rr, cc]:
+            break
+        out.append((rr, cc))
+        if is_12:
+            phase = (phase + 1) % 2
+    return out
+
+
+def _extract_scene(grid: np.ndarray):
+    g = np.array(grid, copy=True)
+    h, w = g.shape
+    bg = int(get_bg(g))
+    vals = [int(v) for v in np.unique(g)]
+    non_bg = [v for v in vals if v != bg]
+    assert non_bg, "expected at least one non-background color"
+
+    wall = max(non_bg, key=lambda c: int((g == c).sum()))
+    other_colors = [c for c in non_bg if c != wall]
+    assert other_colors, "expected at least one non-wall color"
+
+    wall_comps = [
+        set((int(r), int(c)) for r, c in pts)
+        for pts in components_mask(g == wall, connectivity=8)
+    ]
+    assert wall_comps, "expected wall components"
+
+    wall_points = [p for comp in wall_comps for p in comp]
+
+    def min_dist_to_wall(color: int) -> tuple[int, int]:
+        pts = _coords_of_color(g, color)
+        best_d = 10**9
+        for r, c in pts:
+            for wr, wc in wall_points:
+                d = abs(r - wr) + abs(c - wc)
+                if d < best_d:
+                    best_d = d
+                    if best_d == 0:
+                        return 0, len(pts)
+        return best_d, len(pts)
+
+    fill = min(other_colors, key=lambda c: (min_dist_to_wall(c)[0], min_dist_to_wall(c)[1]))
+    fill_pos = _coords_of_color(g, fill)
+    if not fill_pos:
+        return None
+
+    comp_infos = [_component_info(comp, h, w) for comp in wall_comps]
+    wall_mask = np.zeros_like(g, dtype=bool)
+    for info in comp_infos:
+        wall_mask |= info["mask"]
+    for info in comp_infos:
+        for ray in info["rays"]:
+            ray["full_path"] = _trace_ray_path(
+                g.shape,
+                wall_mask,
+                start=ray["start"],
+                direction=ray["dir"],
+                is_12=ray["is_12"],
+                rad=info["rad"],
+            )
+
+    def comp_min_dist(comp: set[tuple[int, int]]) -> int:
+        best_d = 10**9
+        for r, c in fill_pos:
+            for wr, wc in comp:
+                d = abs(r - wr) + abs(c - wc)
+                if d < best_d:
+                    best_d = d
+                    if best_d == 0:
+                        return 0
+        return best_d
+
+    start_idx = min(range(len(wall_comps)), key=lambda i: (comp_min_dist(wall_comps[i]), -len(wall_comps[i])))
+    component_index_by_points = {info["points"]: idx for idx, info in enumerate(comp_infos)}
+
+    return {
+        "grid": g,
+        "shape": g.shape,
+        "bg": bg,
+        "wall": wall,
+        "fill": fill,
+        "fill_pos": fill_pos,
+        "components": comp_infos,
+        "component_index_by_points": component_index_by_points,
+        "wall_mask": wall_mask,
+        "start_idx": start_idx,
+    }
+
+
+def _reachable_mask(
+    orig: np.ndarray,
+    *,
+    bg: int,
+    fill: int,
+    barrier: np.ndarray,
+    seeds: list[tuple[int, int]],
+) -> np.ndarray:
+    passable = (~barrier) & ((orig == bg) | (orig == fill))
+    seen = np.zeros_like(passable, dtype=bool)
+    q: list[tuple[int, int]] = []
+    for r, c in seeds:
+        if 0 <= r < orig.shape[0] and 0 <= c < orig.shape[1] and passable[r, c] and not seen[r, c]:
+            seen[r, c] = True
+            q.append((r, c))
+    while q:
+        r, c = q.pop()
+        for rr, cc in neighbors4(r, c):
+            if 0 <= rr < orig.shape[0] and 0 <= cc < orig.shape[1] and passable[rr, cc] and not seen[rr, cc]:
+                seen[rr, cc] = True
+                q.append((rr, cc))
+    return seen
+
+
+def _apply_shadow(
+    orig: np.ndarray,
+    reach: np.ndarray,
+    *,
+    bg: int,
+    fill: int,
+    wall: int,
+    rad: tuple[int, int],
+) -> np.ndarray:
+    out = reach.copy()
+    obstacles = (orig != bg) & (orig != fill) & (orig != wall)
+    h, w = orig.shape
+
+    def shadow_process(coords: list[tuple[int, int]]) -> None:
+        started = False
+        blocked = False
+        for r, c in coords:
+            if out[r, c]:
+                started = True
+            if started and obstacles[r, c]:
+                blocked = True
+                continue
+            if blocked and out[r, c]:
+                out[r, c] = False
+
+    dr, dc = rad
+    if dr != 0:
+        for c in range(w):
+            rows = range(h) if dr > 0 else range(h - 1, -1, -1)
+            shadow_process([(r, c) for r in rows])
+    else:
+        for r in range(h):
+            cols = range(w) if dc > 0 else range(w - 1, -1, -1)
+            shadow_process([(r, c) for c in cols])
+    return out
+
+
+def _component_propagation(scene: dict, comp_idx: int, seeds: list[tuple[int, int]], ray_cells: set[tuple[int, int]]) -> np.ndarray:
+    barrier = scene["wall_mask"].copy()
+    for r, c in ray_cells:
+        barrier[r, c] = True
+    reach = _reachable_mask(
+        scene["grid"],
+        bg=scene["bg"],
+        fill=scene["fill"],
+        barrier=barrier,
+        seeds=seeds,
+    )
+    return _apply_shadow(
+        scene["grid"],
+        reach,
+        bg=scene["bg"],
+        fill=scene["fill"],
+        wall=scene["wall"],
+        rad=scene["components"][comp_idx]["rad"],
+    )
+
+
+def _simulate_activation(scene: dict) -> dict:
+    start_idx = scene["start_idx"]
+    components = scene["components"]
+    seeds_map: dict[int, list[tuple[int, int]]] = {start_idx: list(scene["fill_pos"])}
+    activation_order = [start_idx]
+    parent: dict[int, int | None] = {start_idx: None}
+    active = {start_idx}
+    queue = [start_idx]
+    pre_masks: dict[int, np.ndarray] = {}
+
+    while queue:
+        idx = queue.pop(0)
+        info = components[idx]
+        to_edge_cells = {cell for ray in info["rays"] for cell in ray["full_path"]}
+        prop = _component_propagation(scene, idx, seeds_map[idx], to_edge_cells)
+        pre_masks[idx] = prop
+        opposite_rad = (-info["rad"][0], -info["rad"][1])
+
+        for other_idx, other in enumerate(components):
+            if other_idx in active:
+                continue
+            if other["rad"] != opposite_rad:
+                continue
+            hits = [(r, c) for r, c in other["opening"] if prop[r, c]]
+            if hits:
+                active.add(other_idx)
+                activation_order.append(other_idx)
+                parent[other_idx] = idx
+                seeds_map[other_idx] = list(dict.fromkeys(hits))
+                queue.append(other_idx)
+
+    return {
+        "activation_order": activation_order,
+        "parent": parent,
+        "seeds_map": seeds_map,
+        "pre_masks": pre_masks,
+    }
+
+
+def _simulate_ordered_rays(scene: dict, activation_order: list[int], *, ordered_collisions: bool) -> tuple[dict[int, set[tuple[int, int]]], dict]:
+    components = scene["components"]
+    ray_to_comp: dict[str, int] = {}
+    ray_paths: dict[str, list[tuple[int, int]]] = {}
+    ray_index: dict[str, dict[tuple[int, int], int]] = {}
+    cell_owners: dict[tuple[int, int], set[str]] = {}
+    collision_cells: set[tuple[int, int]] = set()
+
+    def add_cell(ray_id: str, cell: tuple[int, int]) -> None:
+        idx_map = ray_index[ray_id]
+        if cell in idx_map:
+            return
+        idx_map[cell] = len(ray_paths[ray_id])
+        ray_paths[ray_id].append(cell)
+        cell_owners.setdefault(cell, set()).add(ray_id)
+
+    def truncate_at_cell(ray_id: str, cell: tuple[int, int]) -> None:
+        idx = ray_index[ray_id].get(cell)
+        if idx is None:
+            return
+        tail = ray_paths[ray_id][idx + 1 :]
+        for old in tail:
+            owners = cell_owners.get(old)
+            if owners is not None:
+                owners.discard(ray_id)
+                if not owners:
+                    cell_owners.pop(old, None)
+            ray_index[ray_id].pop(old, None)
+        ray_paths[ray_id] = ray_paths[ray_id][: idx + 1]
+
+    for order_pos, comp_idx in enumerate(activation_order):
+        info = components[comp_idx]
+        for ray in info["rays"]:
+            ray_id = f"{comp_idx}:{ray['local_ray_id']}"
+            ray_to_comp[ray_id] = comp_idx
+            ray_paths[ray_id] = []
+            ray_index[ray_id] = {}
+            full_path = ray["full_path"]
+
+            if not ordered_collisions or order_pos == 0:
+                for cell in full_path:
+                    add_cell(ray_id, cell)
+                continue
+
+            for cell in full_path:
+                owners = cell_owners.get(cell, set())
+                foreign = [other_id for other_id in owners if ray_to_comp[other_id] != comp_idx]
+                if foreign:
+                    collision_cells.add(cell)
+                    for other_id in foreign:
+                        truncate_at_cell(other_id, cell)
+                    add_cell(ray_id, cell)
+                    break
+                if owners:
+                    break
+                add_cell(ray_id, cell)
+
+    comp_ray_cells: dict[int, set[tuple[int, int]]] = {idx: set() for idx in activation_order}
+    for ray_id, path in ray_paths.items():
+        comp_ray_cells[ray_to_comp[ray_id]].update(path)
+    return comp_ray_cells, {"collision_cells": collision_cells, "ray_paths": ray_paths}
+
+
+def _render_from_activation(scene: dict, activation: dict, *, ordered_collisions: bool):
+    activation_order = activation["activation_order"]
+    seeds_map = activation["seeds_map"]
+    comp_ray_cells, ray_stats = _simulate_ordered_rays(scene, activation_order, ordered_collisions=ordered_collisions)
+
+    out = scene["grid"].copy()
+    final_masks: dict[int, np.ndarray] = {}
+    component_new_fill: dict[int, int] = {}
+    union_new_fill = np.zeros(scene["shape"], dtype=bool)
+
+    for comp_idx in activation_order:
+        prop = _component_propagation(scene, comp_idx, seeds_map[comp_idx], comp_ray_cells.get(comp_idx, set()))
+        final_masks[comp_idx] = prop
+        new_fill_mask = prop & (scene["grid"] == scene["bg"])
+        component_new_fill[comp_idx] = int(new_fill_mask.sum())
+        union_new_fill |= new_fill_mask
+
+    out[union_new_fill] = scene["fill"]
+    return out, {
+        "final_masks": final_masks,
+        "component_new_fill": component_new_fill,
+        "total_new_fill": int(union_new_fill.sum()),
+        "collision_cells": len(ray_stats["collision_cells"]),
+        "collision_points": sorted(ray_stats["collision_cells"]),
+        "comp_ray_cells": comp_ray_cells,
+    }
+
+
+def _solve_scene(grid: np.ndarray, *, ordered_collisions: bool, want_details: bool = False):
+    scene = _extract_scene(grid)
+    if scene is None:
+        return np.array(grid, copy=True) if not want_details else (np.array(grid, copy=True), {})
+
+    activation = _simulate_activation(scene)
+    out, render = _render_from_activation(scene, activation, ordered_collisions=ordered_collisions)
+
+    if not want_details:
+        return out
+
+    details = {
+        "bg": scene["bg"],
+        "wall": scene["wall"],
+        "fill": scene["fill"],
+        "components": scene["components"],
+        "component_index_by_points": scene["component_index_by_points"],
+        "start_idx": scene["start_idx"],
+        "activation_order": activation["activation_order"],
+        "parent": activation["parent"],
+        "seeds_map": activation["seeds_map"],
+        "pre_masks": activation["pre_masks"],
+        "component_new_fill": render["component_new_fill"],
+        "total_new_fill": render["total_new_fill"],
+        "collision_cells": render["collision_cells"],
+        "collision_points": render["collision_points"],
+    }
+    return out, details
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Fill a paired set of opposite-opening wall sprites where the first sprite ignites its partner and reverse rays stop at ray meetings.
+
+    Input structure:
+    - The background is the most common color. The dominant non-background color forms two separate partial-enclosure wall sprites whose openings face each other.
+    - Only one sprite contains the fill-color seed blob near its closed end. The opposite sprite starts empty, and any extra non-background colors are inert obstacles.
+
+    Rule:
+    - The seeded sprite first behaves like the base task: it fills its interior and radiates out through its opening.
+    - If that outward fill reaches the other sprite's opening, those touched opening cells trigger the partner sprite, which then fills and radiates back in the opposite direction.
+    - When a later sprite's ray lands on a ray cell already owned by an earlier sprite, both rays terminate at that meeting cell; the earlier ray is truncated back to the same point before the final filled wedges are rendered.
+
+    Key insight:
+    - The output is determined by a causal pair interaction rather than by one isolated funnel: identify the seeded sprite, follow its wedge until it hits the facing opening, then account for the reverse wedge and the ray-to-ray cutoff that shortens the original outer spread.
+    """
+    return _solve_scene(grid, ordered_collisions=True, want_details=False)
+
+
+def _make_component(rad: tuple[int, int], h: int, w: int):
+    built = _build_local_wall(rad, h, w)
+    if built is None:
+        return None
+    wall, depth, gap = built
+    return {
+        "rad": rad,
+        "wall": wall,
+        "depth": depth,
+        "gap": gap,
+        "interior": _local_interior(wall, depth),
+        "opening_local": [(0, v) for v in range(1, gap)],
+    }
+
+
+def _mapped_component_cells(comp_def: dict, anchor: tuple[int, int]) -> dict:
+    return {
+        "wall": _map_points(comp_def["wall"], comp_def["rad"], anchor),
+        "interior": _map_points(comp_def["interior"], comp_def["rad"], anchor),
+        "opening": _map_points(comp_def["opening_local"], comp_def["rad"], anchor),
+    }
+
+
+def _wall_is_separate(existing_walls: set[tuple[int, int]], wall: list[tuple[int, int]]) -> bool:
+    for r, c in wall:
+        for rr in range(r - 1, r + 2):
+            for cc in range(c - 1, c + 2):
+                if (rr, cc) in existing_walls:
+                    return False
+    return True
+
+
+def _run_positions(mask: np.ndarray, vertical: bool, length: int) -> list[tuple[int, int]]:
+    h, w = mask.shape
+    out: list[tuple[int, int]] = []
+    if vertical:
+        for c in range(w):
+            start = 0
+            while start < h:
+                while start < h and not mask[start, c]:
+                    start += 1
+                end = start
+                while end < h and mask[end, c]:
+                    end += 1
+                if end - start >= length:
+                    for r0 in range(start, end - length + 1):
+                        out.append((r0, c))
+                start = end + 1
+    else:
+        for r in range(h):
+            start = 0
+            while start < w:
+                while start < w and not mask[r, start]:
+                    start += 1
+                end = start
+                while end < w and mask[r, end]:
+                    end += 1
+                if end - start >= length:
+                    for c0 in range(start, end - length + 1):
+                        out.append((r, c0))
+                start = end + 1
+    return out
+
+
+def _anchor_from_opening_start(rad: tuple[int, int], opening_start: tuple[int, int]) -> tuple[int, int]:
+    r, c = opening_start
+    if rad[0]:
+        return r, c - 1
+    return r - 1, c
+
+
+def _candidate_anchors_from_parent_mask(parent_mask: np.ndarray, rad: tuple[int, int], gap: int) -> list[tuple[int, int]]:
+    opening_len = gap - 1
+    vertical = rad[0] == 0
+    starts = _run_positions(parent_mask, vertical, opening_len)
+    anchors = [_anchor_from_opening_start(rad, start) for start in starts]
+    random.shuffle(anchors)
+    return anchors
+
+
+def _place_start_component(grid: np.ndarray, wall_color: int, fill_color: int, rad: tuple[int, int]):
+    h, w = grid.shape
+    for _ in range(PLACE_RETRIES):
+        comp_def = _make_component(rad, h, w)
+        if comp_def is None:
+            continue
+        anchor = _place_anchor(rad, h, w, comp_def["depth"], comp_def["gap"])
+        mapped = _mapped_component_cells(comp_def, anchor)
+        footprint = mapped["wall"] + mapped["interior"] + mapped["opening"]
+        if not _in_bounds_all(footprint, h, w):
+            continue
+        if any(grid[r, c] != grid[0, 0] for r, c in footprint):
+            continue
+
+        wall_set = set(comp_def["wall"])
+        adjacent = [
+            p
+            for p in comp_def["interior"]
+            if any((p[0] + dr, p[1] + dc) in wall_set for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)])
+        ]
+        seed_pool = [p for p in adjacent if p[0] >= max(1, comp_def["depth"] - SEED_DEPTH_LOOKBACK)]
+        if not seed_pool:
+            continue
+        blob_local = _grow_seed_blob(random.choice(seed_pool), set(comp_def["interior"]))
+        blob = _map_points(blob_local, rad, anchor)
+        if any((r, c) in mapped["wall"] for r, c in blob):
+            continue
+
+        for r, c in mapped["wall"]:
+            grid[r, c] = wall_color
+        for r, c in blob:
+            if grid[r, c] != grid[0, 0]:
+                break
+            grid[r, c] = fill_color
+        else:
+            return {
+                "rad": rad,
+                "wall_points": frozenset(mapped["wall"]),
+            }
+
+        for r, c in mapped["wall"]:
+            grid[r, c] = grid[0, 0]
+        for r, c in blob:
+            if grid[r, c] == fill_color:
+                grid[r, c] = grid[0, 0]
+    return None
+
+
+def _try_add_partner(grid: np.ndarray, base_out: np.ndarray, wall_color: int, start_info: dict):
+    h, w = grid.shape
+    _, base_details = _solve_scene(grid, ordered_collisions=False, want_details=True)
+    start_idx = base_details["start_idx"]
+    parent_mask = base_details["pre_masks"][start_idx]
+    existing_walls = set(start_info["wall_points"])
+    partner_rad = (-start_info["rad"][0], -start_info["rad"][1])
+
+    for _ in range(PLACE_RETRIES):
+        comp_def = _make_component(partner_rad, h, w)
+        if comp_def is None:
+            continue
+        anchors = _candidate_anchors_from_parent_mask(parent_mask, partner_rad, comp_def["gap"])
+        if not anchors:
+            continue
+        for anchor in anchors[:ANCHOR_TRIALS]:
+            mapped = _mapped_component_cells(comp_def, anchor)
+            footprint = mapped["wall"] + mapped["interior"] + mapped["opening"]
+            if not _in_bounds_all(footprint, h, w):
+                continue
+            if any(grid[r, c] != grid[0, 0] for r, c in footprint):
+                continue
+            if not _wall_is_separate(existing_walls, mapped["wall"]):
+                continue
+            if not all(parent_mask[r, c] for r, c in mapped["opening"]):
+                continue
+
+            temp = grid.copy()
+            for r, c in mapped["wall"]:
+                temp[r, c] = wall_color
+
+            try:
+                out_collision, dcol = _solve_scene(temp, ordered_collisions=True, want_details=True)
+                out_no_collision, _dnoc = _solve_scene(temp, ordered_collisions=False, want_details=True)
+            except Exception:
+                continue
+
+            partner_points = frozenset(mapped["wall"])
+            if partner_points not in dcol["component_index_by_points"]:
+                continue
+            partner_idx = dcol["component_index_by_points"][partner_points]
+            if len(dcol["activation_order"]) != 2:
+                continue
+            if dcol["parent"].get(partner_idx) != dcol["start_idx"]:
+                continue
+            if dcol["component_new_fill"].get(partner_idx, 0) < MIN_CHILD_NEW_FILL:
+                continue
+            if dcol["collision_cells"] < 1:
+                continue
+            if dcol["total_new_fill"] < MIN_TOTAL_NEW_FILL:
+                continue
+            if int(np.count_nonzero(out_collision != out_no_collision)) < MIN_COLLISION_DIFF:
+                continue
+            if int(np.count_nonzero(out_collision != base_out)) < MIN_CHAIN_DIFF:
+                continue
+
+            for r, c in mapped["wall"]:
+                grid[r, c] = wall_color
+            return {"wall_points": partner_points}
+    return None
+
+
+def _gen_attempt():
+    h = random.randint(*GRID_H)
+    w = random.randint(*GRID_W)
+    bg, wall_color, fill_color = random.sample(range(10), 3)
+    start_rad = random.choice([(-1, 0), (1, 0), (0, -1), (0, 1)])
+
+    grid = np.full((h, w), bg, dtype=int)
+    start = _place_start_component(grid, wall_color, fill_color, start_rad)
+    if start is None:
+        return None
+
+    try:
+        base_out, base_details = _solve_scene(grid, ordered_collisions=False, want_details=True)
+    except Exception:
+        return None
+    if len(base_details["activation_order"]) != 1:
+        return None
+
+    partner = _try_add_partner(grid, base_out, wall_color, start)
+    if partner is None:
+        return None
+
+    try:
+        out_collision, dcol = _solve_scene(grid, ordered_collisions=True, want_details=True)
+        out_no_collision, _dnoc = _solve_scene(grid, ordered_collisions=False, want_details=True)
+    except Exception:
+        return None
+
+    if len(dcol["activation_order"]) != 2:
+        return None
+    if dcol["collision_cells"] < 1:
+        return None
+    if dcol["total_new_fill"] < MIN_TOTAL_NEW_FILL:
+        return None
+    if min(dcol["component_new_fill"].values()) < MIN_CHILD_NEW_FILL:
+        return None
+    if int(np.count_nonzero(out_collision != out_no_collision)) < MIN_COLLISION_DIFF:
+        return None
+    if int(np.count_nonzero(out_collision != base_out)) < MIN_CHAIN_DIFF:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate valid combo input")

