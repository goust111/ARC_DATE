   542	        scene["grid"],
   543	        bg=scene["bg"],
   544	        fill=scene["fill"],
   545	        barrier=barrier,
   546	        seeds=seeds,
   547	    )
   548	    return _apply_shadow(
   549	        scene["grid"],
   550	        reach,
   551	        bg=scene["bg"],
   552	        fill=scene["fill"],
   553	        wall=scene["wall"],
   554	        rad=scene["components"][comp_idx]["rad"],
