   760	def _wall_is_separate(existing_walls: set[tuple[int, int]], wall: list[tuple[int, int]]) -> bool:
   761	    for r, c in wall:
   762	        for rr in range(r - 1, r + 2):
   763	            for cc in range(c - 1, c + 2):
   764	                if (rr, cc) in existing_walls:
   765	                    return False
   766	    return True
