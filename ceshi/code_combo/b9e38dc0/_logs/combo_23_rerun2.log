   769	def _run_positions(mask: np.ndarray, vertical: bool, length: int) -> list[tuple[int, int]]:
   770	    h, w = mask.shape
   771	    out: list[tuple[int, int]] = []
   772	    if vertical:
   773	        for c in range(w):
   774	            start = 0
   775	            while start < h:
   776	                while start < h and not mask[start, c]:
   777	                    start += 1
   778	                end = start
   779	                while end < h and mask[end, c]:
   780	                    end += 1
   781	                if end - start >= length:
   782	                    for r0 in range(start, end - length + 1):
   783	                        out.append((r0, c))
   784	                start = end + 1
   785	    else:
   786	        for r in range(h):
   787	            start = 0
   788	            while start < w:
   789	                while start < w and not mask[r, start]:
   790	                    start += 1
   791	                end = start
   792	                while end < w and mask[r, end]:
   793	                    end += 1
   794	                if end - start >= length:
   795	                    for c0 in range(start, end - length + 1):
   796	                        out.append((r, c0))
   797	                start = end + 1
   798	    return out
