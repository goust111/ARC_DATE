   537	def _component_propagation(scene: dict, comp_idx: int, seeds: list[tuple[int, int]], ray_cells: set[tuple[int, int]]) -> np.ndarray:
   538	    barrier = scene["wall_mask"].copy()
   539	    for r, c in ray_cells:
