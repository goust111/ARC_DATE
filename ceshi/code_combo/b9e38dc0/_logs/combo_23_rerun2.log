   558	def _simulate_activation(scene: dict) -> dict:
   559	    start_idx = scene["start_idx"]
   560	    components = scene["components"]
   561	    seeds_map: dict[int, list[tuple[int, int]]] = {start_idx: list(scene["fill_pos"])}
   562	    activation_order = [start_idx]
   563	    parent: dict[int, int | None] = {start_idx: None}
   564	    active = {start_idx}
   565	    queue = [start_idx]
   566	    pre_masks: dict[int, np.ndarray] = {}
   567	
   568	    while queue:
   569	        idx = queue.pop(0)
   570	        info = components[idx]
   571	        to_edge_cells = {cell for ray in info["rays"] for cell in ray["full_path"]}
   572	        prop = _component_propagation(scene, idx, seeds_map[idx], to_edge_cells)
   573	        pre_masks[idx] = prop
   574	        opposite_rad = (-info["rad"][0], -info["rad"][1])
   575	
   576	        for other_idx, other in enumerate(components):
   577	            if other_idx in active:
   578	                continue
   579	            if other["rad"] != opposite_rad:
   580	                continue
   581	            hits = [(r, c) for r, c in other["opening"] if prop[r, c]]
   582	            if hits:
   583	                active.add(other_idx)
   584	                activation_order.append(other_idx)
   585	                parent[other_idx] = idx
   586	                seeds_map[other_idx] = list(dict.fromkeys(hits))
   587	                queue.append(other_idx)
   588	
   589	    return {
   590	        "activation_order": activation_order,
   591	        "parent": parent,
   592	        "seeds_map": seeds_map,
   593	        "pre_masks": pre_masks,
   594	    }
   595	
