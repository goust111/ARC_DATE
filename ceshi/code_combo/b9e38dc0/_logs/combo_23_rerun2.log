   737	def _make_component(rad: tuple[int, int], h: int, w: int):
   738	    built = _build_local_wall(rad, h, w)
   739	    if built is None:
   740	        return None
   741	    wall, depth, gap = built
   742	    return {
   743	        "rad": rad,
   744	        "wall": wall,
   745	        "depth": depth,
   746	        "gap": gap,
   747	        "interior": _local_interior(wall, depth),
   748	        "opening_local": [(0, v) for v in range(1, gap)],
   749	    }
