   597	def _simulate_ordered_rays(scene: dict, activation_order: list[int], *, ordered_collisions: bool) -> tuple[dict[int, set[tuple[int, int]]], dict]:
   598	    components = scene["components"]
   599	    ray_to_comp: dict[str, int] = {}
   600	    ray_paths: dict[str, list[tuple[int, int]]] = {}
   601	    ray_index: dict[str, dict[tuple[int, int], int]] = {}
   602	    cell_owners: dict[tuple[int, int], set[str]] = {}
   603	    collision_cells: set[tuple[int, int]] = set()
   604	
   605	    def add_cell(ray_id: str, cell: tuple[int, int]) -> None:
   606	        idx_map = ray_index[ray_id]
   607	        if cell in idx_map:
   608	            return
   609	        idx_map[cell] = len(ray_paths[ray_id])
   610	        ray_paths[ray_id].append(cell)
   611	        cell_owners.setdefault(cell, set()).add(ray_id)
   612	
   613	    def truncate_at_cell(ray_id: str, cell: tuple[int, int]) -> None:
   614	        idx = ray_index[ray_id].get(cell)
   615	        if idx is None:
   616	            return
   617	        tail = ray_paths[ray_id][idx + 1 :]
   618	        for old in tail:
   619	            owners = cell_owners.get(old)
   620	            if owners is not None:
   621	                owners.discard(ray_id)
   622	                if not owners:
   623	                    cell_owners.pop(old, None)
   624	            ray_index[ray_id].pop(old, None)
   625	        ray_paths[ray_id] = ray_paths[ray_id][: idx + 1]
   626	
   627	    for order_pos, comp_idx in enumerate(activation_order):
   628	        info = components[comp_idx]
   629	        for ray in info["rays"]:
   630	            ray_id = f"{comp_idx}:{ray['local_ray_id']}"
   631	            ray_to_comp[ray_id] = comp_idx
   632	            ray_paths[ray_id] = []
   633	            ray_index[ray_id] = {}
   634	            full_path = ray["full_path"]
   635	
   636	            if not ordered_collisions or order_pos == 0:
   637	                for cell in full_path:
   638	                    add_cell(ray_id, cell)
   639	                continue
   640	
   641	            for cell in full_path:
   642	                owners = cell_owners.get(cell, set())
   643	                foreign = [other_id for other_id in owners if ray_to_comp[other_id] != comp_idx]
   644	                if foreign:
   645	                    collision_cells.add(cell)
   646	                    for other_id in foreign:
   647	                        truncate_at_cell(other_id, cell)
   648	                    add_cell(ray_id, cell)
   649	                    break
   650	                if owners:
   651	                    break
   652	                add_cell(ray_id, cell)
   653	
   654	    comp_ray_cells: dict[int, set[tuple[int, int]]] = {idx: set() for idx in activation_order}
   655	    for ray_id, path in ray_paths.items():
   656	        comp_ray_cells[ray_to_comp[ray_id]].update(path)
   657	    return comp_ray_cells, {"collision_cells": collision_cells, "ray_paths": ray_paths}
   658	
