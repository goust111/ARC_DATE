   688	def _solve_scene(grid: np.ndarray, *, ordered_collisions: bool, want_details: bool = False):
   689	    scene = _extract_scene(grid)
   690	    if scene is None:
   691	        return np.array(grid, copy=True) if not want_details else (np.array(grid, copy=True), {})
   692	
   693	    activation = _simulate_activation(scene)
   694	    out, render = _render_from_activation(scene, activation, ordered_collisions=ordered_collisions)
   695	
   696	    if not want_details:
   697	        return out
   698	
   699	    details = {
   700	        "bg": scene["bg"],
   701	        "wall": scene["wall"],
   702	        "fill": scene["fill"],
   703	        "components": scene["components"],
   704	        "component_index_by_points": scene["component_index_by_points"],
   705	        "start_idx": scene["start_idx"],
   706	        "activation_order": activation["activation_order"],
   707	        "parent": activation["parent"],
   708	        "seeds_map": activation["seeds_map"],
   709	        "pre_masks": activation["pre_masks"],
   710	        "component_new_fill": render["component_new_fill"],
   711	        "total_new_fill": render["total_new_fill"],
   712	        "collision_cells": render["collision_cells"],
   713	        "collision_points": render["collision_points"],
   714	    }
   715	    return out, details
