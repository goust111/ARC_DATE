   362	def _trace_ray_path(
   363	    shape: tuple[int, int],
   364	    wall_mask: np.ndarray,
   365	    *,
   366	    start: tuple[int, int],
   367	    direction: tuple[int, int],
   368	    is_12: bool,
   369	    rad: tuple[int, int],
   370	) -> list[tuple[int, int]]:
   371	    h, w = shape
   372	    rr, cc = start
   373	    phase = 0
   374	    out: list[tuple[int, int]] = []
   375	    while True:
   376	        if not is_12:
   377	            dr, dc = direction
   378	        elif phase % 2 == 0:
   379	            dr, dc = direction
   380	        elif rad[0] != 0:
   381	            dr, dc = direction[0], 0
   382	        else:
   383	            dr, dc = 0, direction[1]
   384	        rr += dr
   385	        cc += dc
   386	        if not (0 <= rr < h and 0 <= cc < w):
   387	            break
   388	        if wall_mask[rr, cc]:
   389	            break
   390	        out.append((rr, cc))
   391	        if is_12:
   392	            phase = (phase + 1) % 2
   393	    return out
