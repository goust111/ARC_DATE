   660	def _render_from_activation(scene: dict, activation: dict, *, ordered_collisions: bool):
   661	    activation_order = activation["activation_order"]
   662	    seeds_map = activation["seeds_map"]
   663	    comp_ray_cells, ray_stats = _simulate_ordered_rays(scene, activation_order, ordered_collisions=ordered_collisions)
   664	
   665	    out = scene["grid"].copy()
   666	    final_masks: dict[int, np.ndarray] = {}
   667	    component_new_fill: dict[int, int] = {}
   668	    union_new_fill = np.zeros(scene["shape"], dtype=bool)
   669	
   670	    for comp_idx in activation_order:
   671	        prop = _component_propagation(scene, comp_idx, seeds_map[comp_idx], comp_ray_cells.get(comp_idx, set()))
   672	        final_masks[comp_idx] = prop
   673	        new_fill_mask = prop & (scene["grid"] == scene["bg"])
   674	        component_new_fill[comp_idx] = int(new_fill_mask.sum())
   675	        union_new_fill |= new_fill_mask
   676	
   677	    out[union_new_fill] = scene["fill"]
   678	    return out, {
   679	        "final_masks": final_masks,
   680	        "component_new_fill": component_new_fill,
   681	        "total_new_fill": int(union_new_fill.sum()),
   682	        "collision_cells": len(ray_stats["collision_cells"]),
   683	        "collision_points": sorted(ray_stats["collision_cells"]),
   684	        "comp_ray_cells": comp_ray_cells,
   685	    }
