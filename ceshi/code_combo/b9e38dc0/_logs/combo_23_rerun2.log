   808	def _candidate_anchors_from_parent_mask(parent_mask: np.ndarray, rad: tuple[int, int], gap: int) -> list[tuple[int, int]]:
   809	    opening_len = gap - 1
   810	    vertical = rad[0] == 0
   811	    starts = _run_positions(parent_mask, vertical, opening_len)
   812	    anchors = [_anchor_from_opening_start(rad, start) for start in starts]
   813	    random.shuffle(anchors)
   814	    return anchors
