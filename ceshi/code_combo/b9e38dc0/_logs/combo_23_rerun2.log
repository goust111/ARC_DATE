   801	def _anchor_from_opening_start(rad: tuple[int, int], opening_start: tuple[int, int]) -> tuple[int, int]:
   802	    r, c = opening_start
   803	    if rad[0]:
   804	        return r, c - 1
   805	    return r - 1, c
