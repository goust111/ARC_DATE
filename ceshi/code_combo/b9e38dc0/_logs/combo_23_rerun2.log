   476	def _reachable_mask(
   477	    orig: np.ndarray,
   478	    *,
   479	    bg: int,
   480	    fill: int,
   481	    barrier: np.ndarray,
   482	    seeds: list[tuple[int, int]],
   483	) -> np.ndarray:
   484	    passable = (~barrier) & ((orig == bg) | (orig == fill))
   485	    seen = np.zeros_like(passable, dtype=bool)
   486	    q: list[tuple[int, int]] = []
   487	    for r, c in seeds:
   488	        if 0 <= r < orig.shape[0] and 0 <= c < orig.shape[1] and passable[r, c] and not seen[r, c]:
   489	            seen[r, c] = True
   490	            q.append((r, c))
   491	    while q:
   492	        r, c = q.pop()
   493	        for rr, cc in neighbors4(r, c):
   494	            if 0 <= rr < orig.shape[0] and 0 <= cc < orig.shape[1] and passable[rr, cc] and not seen[rr, cc]:
   495	                seen[rr, cc] = True
   496	                q.append((rr, cc))
   497	    return seen
