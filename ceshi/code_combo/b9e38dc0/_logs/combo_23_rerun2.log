   319	    assert len(endpoints) == 2, "expected exactly two endpoints"
   320	
   321	    def outward_dir(ep: tuple[int, int]) -> tuple[tuple[int, int], bool]:
   322	        n1 = comp_neighbors(*ep)[0]
   323	        d1 = (_sgn(n1[0] - ep[0]), _sgn(n1[1] - ep[1]))
   324	        d_use = d1
   325	        is_12 = False
   326	        n2s = [p for p in comp_neighbors(*n1) if p != ep]
   327	        if n2s:
   328	            n2 = n2s[0]
   329	            d2 = (_sgn(n2[0] - n1[0]), _sgn(n2[1] - n1[1]))
   330	            if (d1[0] == 0) ^ (d1[1] == 0):
   331	                if d2[0] != 0 and d2[1] != 0:
   332	                    d_use = d2
   333	                    is_12 = True
   334	        return (-d_use[0], -d_use[1]), is_12
   335	
   336	    out_info = [outward_dir(ep) for ep in endpoints]
   337	    out_dirs = [d for d, _ in out_info]
   338	    rad = (_sgn(sum(d[0] for d in out_dirs)), _sgn(sum(d[1] for d in out_dirs)))
   339	    assert rad in {(-1, 0), (1, 0), (0, -1), (0, 1)}, "expected cardinal radiate direction"
   340	
   341	    rays = []
   342	    for ray_id, (ep, (d, is_12)) in enumerate(zip(endpoints, out_info)):
   343	        rays.append(
   344	            {
   345	                "local_ray_id": ray_id,
   346	                "start": ep,
   347	                "dir": d,
   348	                "is_12": is_12,
   349	            }
   350	        )
   351	
   352	    return {
   353	        "points": frozenset(comp),
   354	        "mask": comp_mask,
   355	        "endpoints": tuple(endpoints),
   356	        "opening": tuple(_opening_cells_from_endpoints(endpoints)),
   357	        "rad": rad,
   358	        "rays": rays,
   359	    }
