   396	def _extract_scene(grid: np.ndarray):
   397	    g = np.array(grid, copy=True)
   398	    h, w = g.shape
   399	    bg = int(get_bg(g))
   400	    vals = [int(v) for v in np.unique(g)]
   401	    non_bg = [v for v in vals if v != bg]
   402	    assert non_bg, "expected at least one non-background color"
   403	
   404	    wall = max(non_bg, key=lambda c: int((g == c).sum()))
   405	    other_colors = [c for c in non_bg if c != wall]
   406	    assert other_colors, "expected at least one non-wall color"
   407	
   408	    wall_comps = [
   409	        set((int(r), int(c)) for r, c in pts)
   410	        for pts in components_mask(g == wall, connectivity=8)
   411	    ]
   412	    assert wall_comps, "expected wall components"
   413	
   414	    wall_points = [p for comp in wall_comps for p in comp]
   415	
   416	    def min_dist_to_wall(color: int) -> tuple[int, int]:
   417	        pts = _coords_of_color(g, color)
   418	        best_d = 10**9
   419	        for r, c in pts:
   420	            for wr, wc in wall_points:
   421	                d = abs(r - wr) + abs(c - wc)
   422	                if d < best_d:
   423	                    best_d = d
   424	                    if best_d == 0:
   425	                        return 0, len(pts)
   426	        return best_d, len(pts)
   427	
   428	    fill = min(other_colors, key=lambda c: (min_dist_to_wall(c)[0], min_dist_to_wall(c)[1]))
   429	    fill_pos = _coords_of_color(g, fill)
   430	    if not fill_pos:
   431	        return None
   432	
   433	    comp_infos = [_component_info(comp, h, w) for comp in wall_comps]
   434	    wall_mask = np.zeros_like(g, dtype=bool)
   435	    for info in comp_infos:
   436	        wall_mask |= info["mask"]
   437	    for info in comp_infos:
   438	        for ray in info["rays"]:
   439	            ray["full_path"] = _trace_ray_path(
   440	                g.shape,
   441	                wall_mask,
   442	                start=ray["start"],
   443	                direction=ray["dir"],
   444	                is_12=ray["is_12"],
   445	                rad=info["rad"],
   446	            )
   447	
   448	    def comp_min_dist(comp: set[tuple[int, int]]) -> int:
   449	        best_d = 10**9
   450	        for r, c in fill_pos:
   451	            for wr, wc in comp:
   452	                d = abs(r - wr) + abs(c - wc)
   453	                if d < best_d:
   454	                    best_d = d
   455	                    if best_d == 0:
   456	                        return 0
   457	        return best_d
   458	
   459	    start_idx = min(range(len(wall_comps)), key=lambda i: (comp_min_dist(wall_comps[i]), -len(wall_comps[i])))
   460	    component_index_by_points = {info["points"]: idx for idx, info in enumerate(comp_infos)}
   461	
   462	    return {
   463	        "grid": g,
   464	        "shape": g.shape,
   465	        "bg": bg,
   466	        "wall": wall,
   467	        "fill": fill,
   468	        "fill_pos": fill_pos,
   469	        "components": comp_infos,
   470	        "component_index_by_points": component_index_by_points,
   471	        "wall_mask": wall_mask,
   472	        "start_idx": start_idx,
   473	    }
