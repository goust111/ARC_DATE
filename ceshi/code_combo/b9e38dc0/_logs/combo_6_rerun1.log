+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Fill one half-enclosed wall region using a remote border control pixel whose position encodes direction.
+
+    Input structure:
+    - bg is the most common color. The wall color is the largest non-bg color and may appear in multiple
+      separate half-enclosed components.
+    - Exactly one isolated non-wall border pixel is the control marker; its color is the eventual fill color.
+    - Other non-bg non-wall interior pixels are preserved obstacles, not visible seeds.
+
+    Rule:
+    - For each wall component, compare the control pixel with that component's center. The dominant axis of
+      that offset encodes a cardinal direction. Choose the unique wall whose encoded direction matches its
+      opening direction, reconstruct hidden interior start cells for that wall, then flood and radiate using
+      the control color.
+    - Obstacles remain unchanged and cast background shadows behind themselves along the chosen radiate axis.
+
+    Key insight: The border control pixel does double duty. Its color donates the fill color, while its
+    position relative to a wall center identifies both which distant wall is active and which direction is
+    relevant for that wall.
+    """
+    g = np.array(grid, copy=True)
+    bg = get_bg(g)
+
+    vals = np.unique(g)
+    non_bg = [int(v) for v in vals if int(v) != bg]
+    assert non_bg, "expected non-background colors"
+
+    wall = max(non_bg, key=lambda c: int((g == c).sum()))
+    wall_mask = g == wall
+    comps = [set((int(r), int(c)) for r, c in pts) for pts in components_mask(wall_mask, connectivity=8)]
+    assert comps, "expected at least one wall component"
+
+    border_mask = np.zeros_like(g, dtype=bool)
+    border_mask[0, :] = True
+    border_mask[-1, :] = True
+    border_mask[:, 0] = True
+    border_mask[:, -1] = True
+    ctrl_coords = np.argwhere(border_mask & (g != bg) & (g != wall))
+    assert ctrl_coords.shape[0] == 1, "expected exactly one border control pixel"
+    ctrl_pt = (int(ctrl_coords[0, 0]), int(ctrl_coords[0, 1]))
+    fill = int(g[ctrl_pt[0], ctrl_pt[1]])
+
+    geoms = [_component_geometry(comp, g.shape) for comp in comps]
+    wall_geom = _select_wall_geom(geoms, ctrl_pt)
+
+    seed_positions = _infer_seed_positions(wall_geom["comp"], wall_geom["rad"])
+    filled_mask = _flood_from_internal_seeds(g, bg, wall_geom["barrier"], seed_positions)
+
+    out = g.copy()
+    out[filled_mask] = fill
+    _shadow_fill(out, filled_mask, g, bg, fill, wall, wall_geom["rad"])
+    return out
