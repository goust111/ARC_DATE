+WALL_PIXELS_MAX = 25
+DEPTH_VERT = (5, 10)
+DEPTH_HORIZ = (6, 8)
+GAP_VERT = (6, 7)
+GAP_HORIZ = (5, 7)
+TIP_12_PROB = 0.5
+
+OPEN_END_MARGIN = 3
+SEED_DEPTH_LOOKBACK = 3
+
+MAX_OBSTACLES = 5
+OBSTACLE_IN_FILL_PROB = 0.65
+OBSTACLE_MIN_SEP = 2
+
+PALETTE_SIZE = (3, 5)
+MIN_NEW_FILL = 20
+GEN_RETRIES = 400
+
+DECOY_PROB = 0.8
+DECOY_PLACEMENT_TRIES = 60
+WALL_CLEARANCE = 2
+CONTROL_MIN_CENTER_DIST = 5.0
