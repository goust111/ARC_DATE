+# Combo variant of b9e38dc0 (index 6)
+# combo_spec: D4/0+D13/0
+# Name: 边缘控制像素+像素位置编码方向
+
+import random
+
+import numpy as np
+from scipy.ndimage import distance_transform_cdt
+
+from arc_utils import components_mask, get_bg, neighbors4, neighbors8
+
+
+# Design analysis for the fused D4/0 + D13/0 variant
+# a) Concrete behavior and trace:
+#    - The wall keeps the original half-enclosure geometry and still has a genuine opening direction
+#      determined by its endpoints. Flooding still starts from hidden interior cells near the closed end.
+#    - The visible fill seed disappears. The only visible trigger is one isolated control pixel on the
+#      grid border. Its color becomes the propagated fill color.
+#    - The controlled region is no longer implicit: when multiple wall components share the same wall
+#      color, the solver tests each component separately. For a candidate wall, look at the vector from
+#      that wall's bbox center to the control pixel. The dominant axis of that vector encodes a cardinal
+#      direction. The active wall is the unique component whose encoded direction matches its own opening
+#      direction.
+#    - Small trace:
+#      original: interior seed near closed end -> nearest wall -> wall endpoints give radiate direction.
+#      fused: border control pixel -> for each wall, measure control-vs-center offset -> only one wall
+#      gets a matching direction -> reconstruct hidden interior seeds for that wall -> flood and radiate
+#      with the control color.
+#    - Main difference: the control pixel now simultaneously answers two questions from far away:
+#      which wall is active, and which direction should be associated with that wall.
+# b) Complexity calibration:
+#    - A second same-colored decoy wall is added frequently, but not always, so the region-matching
+#      problem is visible without making every sample crowded.
+#    - Direction is limited to the four cardinal axes via dominant-axis encoding, keeping the rule
+#      learnable from 2-4 examples instead of introducing continuous geometry.
+#    - The generator strongly prefers cases where the control pixel sits on a border side that does
+#      NOT equal the eventual radiate direction, preventing collapse back to "border side = direction".
+# c) Broken assumptions from the original solver:
+#    - "Fill-colored pixels are the BFS seed" is false; the only fill-colored input pixel is remote.
+#    - "The wall closest to fill pixels is the active wall" is false; the solver must evaluate remote
+#      control-vs-center relations across all wall components.
+#    - "Wall geometry alone tells the whole story" is false; the wall still has an opening, but the
+#      solver now needs the remote control position to know which wall is meant.
+#    - "Any non-wall border pixel can be treated by its edge side" is false; the encoded direction uses
+#      dominant offset from the wall center, so top-edge control pixels can legitimately mean LEFT/RIGHT.
+# d) Placement legality:
+#    - Every wall component is generated with the original size/margin constraints and rendered only on
+#      empty background cells.
+#    - The decoy wall is kept disjoint from the active wall and away from the active nominal fill zone.
+#    - The control pixel is placed on an empty border cell outside the active nominal fill zone.
+#    - Obstacles are forbidden on the border and on the reconstructed hidden seed cells.
+# e) Visual observability:
+#    - Across examples, the border pixel's color always spreads through exactly one wall region.
+#    - When a decoy wall exists, only the wall whose center-control offset agrees with its opening reacts.
+#    - Because the generator favors border-side/direction mismatches, humans can see that "which edge the
+#      control pixel sits on" is not sufficient; its relative position to the chosen wall matters.
+# f) Visual cleanliness:
+#    - There is still only one control pixel and at most one decoy wall, so the scene stays sparse.
+#    - Obstacles remain singleton dots and are kept off the border, leaving the control signal isolated.
+# g) Change inferability:
+#    - No invisible ordering by color id is used. The control color is copied directly into the filled
+#      region, and the region choice is supported by repeated geometric evidence across samples.
+# 9) New solver assumptions and generator guarantees:
+#    - Assumption: there is exactly one non-wall border control pixel. Generator guarantees this.
+#    - Assumption: at least one wall component yields a non-tied dominant-axis direction from its center
+#      to the control pixel. Generator searches only among such control placements.
+#    - Assumption: one wall uniquely satisfies "encoded direction == opening direction". Generator
+#      validates this uniqueness before accepting a sample.
+#    - Assumption: hidden seed cells remain background inside the chosen wall. Generator reserves them
+#      from obstacles and from decoy placement.
+
+
+# -- Configuration constants --------------------------------------------------
+GRID_H_VERT = (11, 18)
+GRID_H_HORIZ = (8, 18)
+GRID_W = (15, 19)
+
+WALL_PIXELS_MIN = 17
+WALL_PIXELS_MAX = 25
+DEPTH_VERT = (5, 10)
+DEPTH_HORIZ = (6, 8)
+GAP_VERT = (6, 7)
+GAP_HORIZ = (5, 7)
+TIP_12_PROB = 0.5
+
+OPEN_END_MARGIN = 3
+SEED_DEPTH_LOOKBACK = 3
+
+MAX_OBSTACLES = 5
+OBSTACLE_IN_FILL_PROB = 0.65
+OBSTACLE_MIN_SEP = 2
+
+PALETTE_SIZE = (3, 5)
+MIN_NEW_FILL = 20
+GEN_RETRIES = 400
+
+DECOY_PROB = 0.8
+DECOY_PLACEMENT_TRIES = 60
+WALL_CLEARANCE = 2
+CONTROL_MIN_CENTER_DIST = 5.0
+
+
+def _sgn(x: int) -> int:
+    return (x > 0) - (x < 0)
+
+
+def _degree1_pixels(points):
+    pts = set(points)
+    return [
+        (r, c)
+        for r, c in pts
+        if sum((rr, cc) in pts for rr, cc in neighbors8(r, c)) == 1
+    ]
+
+
+def _make_arm(depth, start_v, target_v, extra_steps, tip_12=False):
+    sign = 1 if target_v > start_v else -1
+    n_side_steps = abs(target_v - start_v)
+    chosen_rows = []
+    if n_side_steps:
+        if tip_12:
+            chosen_rows = [2 * (i + 1) for i in range(n_side_steps)]
+            extra_steps = 0
+        else:
+            chosen_rows = [1]
+            if n_side_steps > 1:
+                chosen_rows += random.sample(range(2, depth + 1), n_side_steps - 1)
+            chosen_rows.sort()
+
+    first_row = chosen_rows[0] if chosen_rows else 1
+    extra_rows = [r for r in chosen_rows if r != first_row]
+    random.shuffle(extra_rows)
+    orthogonal_rows = set(extra_rows[:extra_steps])
+
+    pts = [(0, start_v)]
+    u, v = 0, start_v
+    for row in range(1, depth + 1):
+        u += 1
+        if row in orthogonal_rows:
+            pts.append((u, v))
+            v += sign
+        elif row in chosen_rows:
+            v += sign
+        pts.append((u, v))
+    return pts
+
+
+def _build_local_wall(rad, h, w):
+    if rad[0]:
+        max_depth = min(DEPTH_VERT[1], h - 6)
+        if max_depth < DEPTH_VERT[0]:
+            return None
+        depth = random.randint(DEPTH_VERT[0], max_depth)
+        gap = random.randint(*GAP_VERT)
+    else:
+        depth = random.randint(DEPTH_HORIZ[0], min(DEPTH_HORIZ[1], w - 6))
+        gap = random.randint(GAP_HORIZ[0], min(GAP_HORIZ[1], h - 1))
+
+    if gap == 5:
+        left_bottom, right_bottom = 2, 3
+    elif gap == 6:
+        left_bottom, right_bottom = 2, 4
+    else:
+        left_bottom, right_bottom = random.choice([(2, 5), (3, 4)])
+
+    bridge_extra = max(0, right_bottom - left_bottom - 1)
+    base_count = 2 * (depth + 1) + bridge_extra
+    max_extra_l = max(0, left_bottom - 1)
+    max_extra_r = max(0, gap - right_bottom - 1)
+    min_extra = max(0, WALL_PIXELS_MIN - base_count)
+    max_extra = min(max_extra_l + max_extra_r, WALL_PIXELS_MAX - base_count)
+    if min_extra > max_extra:
+        return None
+
+    extra = random.randint(min_extra, max_extra)
+    extra_l = random.randint(max(0, extra - max_extra_r), min(max_extra_l, extra))
+    extra_r = extra - extra_l
+
+    max_n_side = max(left_bottom, gap - right_bottom)
+    tip_12 = depth >= 2 * max_n_side and random.random() < TIP_12_PROB
+    left = _make_arm(depth, 0, left_bottom, extra_l, tip_12=tip_12)
+    right = _make_arm(depth, gap, right_bottom, extra_r, tip_12=tip_12)
+    pts = set(left) | set(right)
+    for v in range(left_bottom, right_bottom + 1):
+        pts.add((depth, v))
+
+    while len(pts) < WALL_PIXELS_MIN:
+        candidates = [
+            (u, v)
+            for u in range(max(0, depth - 3), depth + 1)
+            for v in range(gap + 1)
+            if (u, v) not in pts
+            and sum(
+                (uu, vv) in pts
+                for uu in range(u - 1, u + 2)
+                for vv in range(v - 1, v + 2)
+                if (uu, vv) != (u, v)
+            )
+            >= 2
+        ]
+        random.shuffle(candidates)
+        added = False
+        for p in candidates:
+            trial = pts | {p}
+            if len(trial) <= WALL_PIXELS_MAX and len(_degree1_pixels(trial)) == 2:
+                pts = trial
+                added = True
+                break
+        if not added:
+            return None
+
+    if not (WALL_PIXELS_MIN <= len(pts) <= WALL_PIXELS_MAX) or len(_degree1_pixels(pts)) != 2:
+        return None
+    return pts, depth, gap
+
+
+def _map_local(u, v, rad, anchor):
+    r0, c0 = anchor
+    if rad == (-1, 0):
+        return r0 + u, c0 + v
+    if rad == (1, 0):
+        return r0 - u, c0 + v
+    if rad == (0, -1):
+        return r0 + v, c0 + u
+    return r0 + v, c0 - u
+
+
+def _place_anchor(rad, h, w, depth, gap):
+    if rad == (-1, 0):
+        return random.randint(OPEN_END_MARGIN, h - depth - 3), random.randint(0, w - gap - 1)
+    if rad == (1, 0):
+        return random.randint(depth + 2, h - 4), random.randint(0, w - gap - 1)
+    if rad == (0, -1):
+        return random.randint(0, h - gap - 1), random.randint(OPEN_END_MARGIN, w - depth - 3)
+    return random.randint(0, h - gap - 1), random.randint(depth + 2, w - 4)
+
+
+def _local_interior(wall, depth, gap):
+    by_row = {}
+    for u, v in wall:
+        by_row.setdefault(u, []).append(v)
+    interior = []
+    for u in range(1, depth):
+        if u not in by_row or len(by_row[u]) < 2:
+            continue
+        lo, hi = min(by_row[u]), max(by_row[u])
+        for v in range(lo + 1, hi):
+            if (u, v) not in wall:
+                interior.append((u, v))
+    return interior
+
+
+def _touches_border(mask):
+    return bool(mask[0, :].any() or mask[-1, :].any() or mask[:, 0].any() or mask[:, -1].any())
+
+
+def _comp_mask(shape, comp):
+    mask = np.zeros(shape, dtype=bool)
+    for r, c in comp:
+        mask[r, c] = True
+    return mask
+
+
+def _comp_neighbors(comp_mask, r, c):
+    h, w = comp_mask.shape
+    out = []
+    for rr, cc in neighbors8(r, c):
+        if 0 <= rr < h and 0 <= cc < w and comp_mask[rr, cc]:
+            out.append((rr, cc))
+    return out
+
+
+def _component_geometry(comp, shape):
+    comp = set((int(r), int(c)) for r, c in comp)
+    comp_mask = _comp_mask(shape, comp)
+    endpoints = []
+    for r, c in comp:
+        if len(_comp_neighbors(comp_mask, r, c)) == 1:
+            endpoints.append((r, c))
+    assert endpoints, "expected wall component endpoints"
+
+    def outward_dir(ep):
+        n1 = _comp_neighbors(comp_mask, *ep)[0]
+        d1 = (_sgn(n1[0] - ep[0]), _sgn(n1[1] - ep[1]))
+        d_use = d1
+        is_12 = False
+        n2s = [p for p in _comp_neighbors(comp_mask, *n1) if p != ep]
+        if n2s:
+            n2 = n2s[0]
+            d2 = (_sgn(n2[0] - n1[0]), _sgn(n2[1] - n1[1]))
+            if (d1[0] == 0) ^ (d1[1] == 0):
+                if d2[0] != 0 and d2[1] != 0:
+                    d_use = d2
+                    is_12 = True
+        return (-d_use[0], -d_use[1]), is_12
+
+    out_info = [outward_dir(ep) for ep in endpoints]
+    out_dirs = [d for d, _ in out_info]
+    tip_12 = [f for _, f in out_info]
+    rad = (_sgn(sum(d[0] for d in out_dirs)), _sgn(sum(d[1] for d in out_dirs)))
+
+    barrier = comp_mask.copy()
+
+    def add_ray(start, d):
+        rr, cc = start
+        while True:
+            rr += d[0]
+            cc += d[1]
+            if not (0 <= rr < shape[0] and 0 <= cc < shape[1]):
+                break
+            barrier[rr, cc] = True
+
+    def add_ray_12(start, d):
+        rr, cc = start
+        step = 0
+        while True:
+            step += 1
+            if step % 2 == 1:
+                rr += d[0]
+                cc += d[1]
+            else:
+                if rad[0] != 0:
+                    rr += d[0]
+                else:
+                    cc += d[1]
+            if not (0 <= rr < shape[0] and 0 <= cc < shape[1]):
+                break
+            barrier[rr, cc] = True
+
+    for ep, d, is_12 in zip(endpoints, out_dirs, tip_12):
+        if is_12:
+            add_ray_12(ep, d)
+        else:
+            add_ray(ep, d)
+
+    rows = [r for r, _ in comp]
+    cols = [c for _, c in comp]
+    center = ((min(rows) + max(rows)) / 2.0, (min(cols) + max(cols)) / 2.0)
+
+    return {
+        "comp": comp,
+        "comp_mask": comp_mask,
+        "endpoints": endpoints,
+        "rad": rad,
+        "barrier": barrier,
+        "center": center,
+    }
+
+
+def _anchor_from_comp(comp, rad):
+    rows = [r for r, _ in comp]
+    cols = [c for _, c in comp]
+    if rad == (-1, 0):
+        return min(rows), min(cols)
+    if rad == (1, 0):
+        return max(rows), min(cols)
+    if rad == (0, -1):
+        return min(rows), min(cols)
+    return min(rows), max(cols)
+
+
+def _to_local(comp, rad):
+    rows = [r for r, _ in comp]
+    cols = [c for _, c in comp]
+    r_min, r_max = min(rows), max(rows)
+    c_min, c_max = min(cols), max(cols)
+    local = set()
+    for r, c in comp:
+        if rad == (-1, 0):
+            local.add((r - r_min, c - c_min))
+        elif rad == (1, 0):
+            local.add((r_max - r, c - c_min))
+        elif rad == (0, -1):
+            local.add((c - c_min, r - r_min))
+        else:
+            local.add((c_max - c, r - r_min))
+    return local
+
+
+def _infer_seed_positions(comp, rad):
+    local_wall = _to_local(comp, rad)
+    depth = max(u for u, _ in local_wall)
+    gap = max(v for _, v in local_wall)
+    interior = _local_interior(local_wall, depth, gap)
+    assert interior, "expected wall interior"
+
+    wall_set = set(local_wall)
+    adjacent = [
+        p
+        for p in interior
+        if any((p[0] + dr, p[1] + dc) in wall_set for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)])
+    ]
+    pool = [p for p in adjacent if p[0] >= max(1, depth - SEED_DEPTH_LOOKBACK)]
+    if not pool:
+        pool = adjacent if adjacent else interior
+    max_u = max(u for u, _ in pool)
+    local_seed = [p for p in pool if p[0] == max_u]
+
+    anchor = _anchor_from_comp(comp, rad)
+    return [_map_local(u, v, rad, anchor) for u, v in local_seed]
+
+
+def _flood_from_internal_seeds(g, bg, barrier, seed_positions):
+    passable = (~barrier) & (g == bg)
+    seen = np.zeros_like(passable, dtype=bool)
+    q = []
+    for r, c in seed_positions:
+        if 0 <= r < g.shape[0] and 0 <= c < g.shape[1] and passable[r, c]:
+            seen[r, c] = True
+            q.append((r, c))
+    assert q, "expected at least one background interior seed cell"
+    while q:
+        r, c = q.pop()
+        for rr, cc in neighbors4(r, c):
+            if 0 <= rr < g.shape[0] and 0 <= cc < g.shape[1] and passable[rr, cc] and not seen[rr, cc]:
+                seen[rr, cc] = True
+                q.append((rr, cc))
+    return seen
+
+
+def _control_dir_for_geom(geom, ctrl_pt):
+    cr, cc = geom["center"]
+    dr = ctrl_pt[0] - cr
+    dc = ctrl_pt[1] - cc
+    if abs(dr) > abs(dc):
+        return (_sgn(int(round(dr * 1000))), 0)
+    if abs(dc) > abs(dr):
+        return (0, _sgn(int(round(dc * 1000))))
+    return None
+
+
+def _center_dist(geom, ctrl_pt):
+    cr, cc = geom["center"]
+    return abs(ctrl_pt[0] - cr) + abs(ctrl_pt[1] - cc)
+
+
+def _border_side_for_point(pt, h, w):
+    r, c = pt
+    if r == 0 and 0 < c < w - 1:
+        return (-1, 0)
+    if r == h - 1 and 0 < c < w - 1:
+        return (1, 0)
+    if c == 0 and 0 < r < h - 1:
+        return (0, -1)
+    if c == w - 1 and 0 < r < h - 1:
+        return (0, 1)
+    return None
+
+
+def _select_wall_geom(geoms, ctrl_pt):
+    matching = [geom for geom in geoms if _control_dir_for_geom(geom, ctrl_pt) == geom["rad"]]
+    pool = matching if matching else geoms
+    return min(pool, key=lambda geom: (_center_dist(geom, ctrl_pt), -len(geom["comp"])))
+
+
+def _shadow_fill(out, filled_mask, g, bg, fill, wall, rad):
+    obstacles = (g != bg) & (g != fill) & (g != wall)
+
+    def shadow_process(coords):
+        started = False
+        blocked = False
+        for r, c in coords:
+            if filled_mask[r, c]:
+                started = True
+            if started and obstacles[r, c]:
+                blocked = True
+                continue
+            if blocked and filled_mask[r, c]:
+                out[r, c] = bg
+                filled_mask[r, c] = False
+
+    if rad == (0, 0):
+        return
+
+    dr, dc = rad
+    h, w = g.shape
+    if dr != 0 and dc == 0:
+        for c in range(w):
+            rows = range(h) if dr > 0 else range(h - 1, -1, -1)
+            shadow_process([(r, c) for r in rows])
+    elif dc != 0 and dr == 0:
+        for r in range(h):
+            cols = range(w) if dc > 0 else range(w - 1, -1, -1)
+            shadow_process([(r, c) for c in cols])
+    elif dr == dc:
+        for k in range(-(w - 1), h):
+            coords = [(r, r - k) for r in range(h) if 0 <= r - k < w]
+            coords.sort(key=lambda rc: rc[0], reverse=(dr < 0))
+            shadow_process(coords)
+    else:
+        for k in range(h + w - 1):
+            coords = [(r, k - r) for r in range(h) if 0 <= k - r < w]
+            coords.sort(key=lambda rc: rc[0], reverse=(dr < 0))
+            shadow_process(coords)
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Fill one half-enclosed wall region using a remote border control pixel whose position encodes direction.
+
+    Input structure:
+    - bg is the most common color. The wall color is the largest non-bg color and may appear in multiple
+      separate half-enclosed components.
+    - Exactly one isolated non-wall border pixel is the control marker; its color is the eventual fill color.
+    - Other non-bg non-wall interior pixels are preserved obstacles, not visible seeds.
+
+    Rule:
+    - For each wall component, compare the control pixel with that component's center. The dominant axis of
+      that offset encodes a cardinal direction. Choose the unique wall whose encoded direction matches its
+      opening direction, reconstruct hidden interior start cells for that wall, then flood and radiate using
+      the control color.
+    - Obstacles remain unchanged and cast background shadows behind themselves along the chosen radiate axis.
+
+    Key insight: The border control pixel does double duty. Its color donates the fill color, while its
+    position relative to a wall center identifies both which distant wall is active and which direction is
+    relevant for that wall.
+    """
+    g = np.array(grid, copy=True)
+    bg = get_bg(g)
+
+    vals = np.unique(g)
+    non_bg = [int(v) for v in vals if int(v) != bg]
+    assert non_bg, "expected non-background colors"
+
+    wall = max(non_bg, key=lambda c: int((g == c).sum()))
+    wall_mask = g == wall
+    comps = [set((int(r), int(c)) for r, c in pts) for pts in components_mask(wall_mask, connectivity=8)]
+    assert comps, "expected at least one wall component"
+
+    border_mask = np.zeros_like(g, dtype=bool)
+    border_mask[0, :] = True
+    border_mask[-1, :] = True
+    border_mask[:, 0] = True
+    border_mask[:, -1] = True
+    ctrl_coords = np.argwhere(border_mask & (g != bg) & (g != wall))
+    assert ctrl_coords.shape[0] == 1, "expected exactly one border control pixel"
+    ctrl_pt = (int(ctrl_coords[0, 0]), int(ctrl_coords[0, 1]))
+    fill = int(g[ctrl_pt[0], ctrl_pt[1]])
+
+    geoms = [_component_geometry(comp, g.shape) for comp in comps]
+    wall_geom = _select_wall_geom(geoms, ctrl_pt)
+
+    seed_positions = _infer_seed_positions(wall_geom["comp"], wall_geom["rad"])
+    filled_mask = _flood_from_internal_seeds(g, bg, wall_geom["barrier"], seed_positions)
+
+    out = g.copy()
+    out[filled_mask] = fill
+    _shadow_fill(out, filled_mask, g, bg, fill, wall, wall_geom["rad"])
+    return out
+
+
+def _obstacle_fits(pos, placed):
+    r, c = pos
+    return all(max(abs(r - rr), abs(c - cc)) >= OBSTACLE_MIN_SEP for rr, cc in placed)
+
+
+def _find_obstacle_candidates(grid, bg, wall_color, nominal_fill_zone, reserved_mask):
+    wall_mask = grid == wall_color
+    dist = distance_transform_cdt(~wall_mask, metric="taxicab")
+    far_from_wall = dist > 1
+    border_mask = np.zeros_like(grid, dtype=bool)
+    border_mask[0, :] = True
+    border_mask[-1, :] = True
+    border_mask[:, 0] = True
+    border_mask[:, -1] = True
+    eligible = (grid == bg) & far_from_wall & (~border_mask) & (~reserved_mask)
+    all_coords = list(zip(*np.where(eligible)))
+    fill_coords = [p for p in all_coords if nominal_fill_zone[p[0], p[1]]]
+    random.shuffle(all_coords)
+    random.shuffle(fill_coords)
+    return [(int(r), int(c)) for r, c in all_coords], [(int(r), int(c)) for r, c in fill_coords]
+
+
+def _place_obstacles(n_obstacles, candidates, fill_candidates, obstacle_colors, grid):
+    placed = []
+    n_fill = random.randint(0, min(n_obstacles, len(fill_candidates)))
+    if fill_candidates and random.random() < OBSTACLE_IN_FILL_PROB:
+        n_fill = max(1, n_fill)
+    for p in fill_candidates:
+        if len(placed) >= n_fill:
+            break
+        if _obstacle_fits(p, placed):
+            placed.append(p)
+    placed_set = set(placed)
+    for p in candidates:
+        if len(placed) >= n_obstacles:
+            break
+        if p not in placed_set and _obstacle_fits(p, placed):
+            placed.append(p)
+            placed_set.add(p)
+    for i, (r, c) in enumerate(placed):
+        grid[r, c] = obstacle_colors[i % len(obstacle_colors)]
+
+
+def _render_wall_points(local_wall, rad, anchor):
+    pts = set()
+    for u, v in local_wall:
+        pts.add(_map_local(u, v, rad, anchor))
+    return pts
+
+
+def _wall_clear(points_a, points_b):
+    for ra, ca in points_a:
+        for rb, cb in points_b:
+            if max(abs(ra - rb), abs(ca - cb)) < WALL_CLEARANCE:
+                return False
+    return True
+
+
+def _try_place_decoy(grid, active_geom, active_fill_zone):
+    active_points = active_geom["comp"]
+    h, w = grid.shape
+    for _ in range(DECOY_PLACEMENT_TRIES):
+        rad_choices = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+        random.shuffle(rad_choices)
+        if active_geom["rad"] in rad_choices and random.random() < 0.8:
+            rad_choices.remove(active_geom["rad"])
+            rad_choices.insert(0, random.choice(rad_choices))
+        decoy_rad = rad_choices[0]
+        built = _build_local_wall(decoy_rad, h, w)
+        if built is None:
+            continue
+        local_wall, depth, gap = built
+        for _ in range(12):
+            anchor = _place_anchor(decoy_rad, h, w, depth, gap)
+            pts = _render_wall_points(local_wall, decoy_rad, anchor)
+            if any(grid[r, c] != get_bg(grid) for r, c in pts):
+                continue
+            if not _wall_clear(pts, active_points):
+                continue
+            if any(active_fill_zone[r, c] for r, c in pts):
+                continue
+            return pts
+    return None
+
+
+def _border_positions(h, w):
+    pts = []
+    for c in range(1, w - 1):
+        pts.append((0, c))
+        pts.append((h - 1, c))
+    for r in range(1, h - 1):
+        pts.append((r, 0))
+        pts.append((r, w - 1))
+    return pts
+
+
+def _choose_control_pos(grid, active_fill_zone, geoms, active_index):
+    bg = get_bg(grid)
+    active_geom = geoms[active_index]
+    candidates = []
+    for pt in _border_positions(*grid.shape):
+        if grid[pt[0], pt[1]] != bg:
+            continue
+        if active_fill_zone[pt[0], pt[1]]:
+            continue
+        if _center_dist(active_geom, pt) < CONTROL_MIN_CENTER_DIST:
+            continue
+        matches = [i for i, geom in enumerate(geoms) if _control_dir_for_geom(geom, pt) == geom["rad"]]
+        if matches != [active_index]:
+            continue
+        side = _border_side_for_point(pt, *grid.shape)
+        mismatch = side != active_geom["rad"]
+        candidates.append((mismatch, _center_dist(active_geom, pt), pt))
+    if not candidates:
+        return None
+    mismatching = [item for item in candidates if item[0]]
+    pool = mismatching if mismatching else candidates
+    best_dist = max(item[1] for item in pool)
+    far_pool = [item for item in pool if item[1] >= best_dist - 2.0]
+    return random.choice(far_pool)[2]
+
+
+def _gen_attempt():
+    active_rad = random.choice([(-1, 0), (1, 0), (0, -1), (0, 1)])
+    h = random.randint(*GRID_H_VERT) if active_rad[0] else random.randint(*GRID_H_HORIZ)
+    w = random.randint(*GRID_W)
+
+    built = _build_local_wall(active_rad, h, w)
+    if built is None:
+        return None
+    local_wall, depth, gap = built
+    anchor = _place_anchor(active_rad, h, w, depth, gap)
+
