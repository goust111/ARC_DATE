+        pool = strong
+    elif len(geoms) > 1:
+        return None
+    elif weak:
+        pool = weak
+    elif fallback:
+        pool = fallback
+    else:
+        return None
+    best_dist = max(item[0] for item in pool)
+    far_pool = [item for item in pool if item[0] >= best_dist - 2.0]
+    return random.choice(far_pool)[0 if False else 1]
+
+
+def _gen_attempt():
+    active_rad = random.choice([(-1, 0), (1, 0), (0, -1), (0, 1)])
