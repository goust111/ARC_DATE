+
+    ctrl_matches = [geom for geom in geoms if _control_dir_for_geom(geom, control_pos) == geom["rad"]]
+    if len(ctrl_matches) != 1 or ctrl_matches[0]["comp"] != active_geom["comp"]:
+        return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
