+# Combo variant of b9e38dc0 (index 37)
+# combo_spec: D3/0+D5/0+D12/2
+# Name: 周期涂色+碰撞终止+配对相对
+
+import random
+
+import numpy as np
+from scipy.ndimage import distance_transform_cdt
+
+from arc_utils import components_mask, get_bg, neighbors4, neighbors8
+
+# ---------------------------------------------------------------------------
+# Design analysis for the combo variant
+#
+# a) Concrete behavior and trace:
+#    We keep the original "funnel enclosure + seed + obstacle shadow" backbone,
+#    but the scene now contains a visible pair of wall sprites that face each
+#    other. Only one member of the pair contains the seed blob; that component
+#    is the active enclosure. Example with an active sprite opening upward:
+#      - Original task: seed flood-fills the interior, then the wedge extends
+#        upward until the canvas border; every painted cell uses one fill color.
+#      - D5 effect: the two boundary rays no longer run to the border. They are
+#        traced step by step and stop as soon as the next step would land on the
+#        opposite-facing partner sprite above.
+#      - D3 effect: after reachability and obstacle shadows are resolved, the
+#        surviving radiated cells outside the opening are recolored in AABB
+#        depth bands: fill, fill, wall, wall, fill, fill, ...
+#      - D12 effect: the blocker is not an arbitrary patch. It is a second
+#        funnel sprite of the same wall color, oriented with the opposite
+#        opening direction so humans can read it as a paired counterpart.
+#    The visible difference from the original is therefore twofold: the wedge
+#    has a finite object-to-object length, and within that finite corridor the
+#    color alternates periodically instead of staying uniform.
+#
+# b) Complexity calibration:
+#    The combo uses only one extra structural degree of freedom beyond the
+#    original task: a second wall component. Its role is heavily constrained:
+#    same wall color, opposite opening direction, placed in front of the active
+#    opening, and required to stop both boundary rays. The periodic coloring is
+#    fixed globally to one pattern (AABB with fill/wall colors), so examples are
+#    varied by corridor length and obstacle placement, not by many unrelated
+#    pattern families.
+#
+# c) Hidden-assumption audit:
+#    - The original `wall = most frequent non-bg color` still works because both
+#      paired sprites share one wall color and dominate the pixel count.
+#    - `wall_comp = closest component to the fill seed` becomes essential: the
+#      seed-bearing enclosure must be the active component, while the opposite
+#      partner acts only as a collision stop.
+#    - The original ray code assumed "stop only at border". That assumption is
+#      invalid now, so rays are explicitly traced and can terminate on another
+#      wall component before leaving the grid.
+#    - The original `out[filled_mask] = fill` assumed a single paint color.
+#      That fails under periodic recoloring, so the solver first computes the
+#      boolean painted region, then applies obstacle shadows, then assigns band
+#      colors by radiate depth.
+#    - BFS still assumes only bg and seed cells are passable. The generator
+#      preserves that by keeping the partner sprite wall-colored rather than
+#      introducing a distinct "stop" color.
+#    - New implicit assumption: the opposite-facing partner must actually cap
+#      the wedge rather than sit off to the side. The generator therefore
+#      searches placements and rejects any case where either boundary ray misses
+#      the partner or the output leaks to the border as if no collision existed.
+#
+# d) Placement legality:
+#    Both sprites are built from the original local wall generator, then one is
+#    rendered with radiate direction `rad` and the partner with `-rad`. The
+#    search enforces in-bounds placement, positive gap along the radiate axis,
+#    8-connectivity separation between the two wall components, and successful
+#    collision hits for both active boundary rays. Seeds are placed only inside
+#    the active enclosure; obstacles are placed on bg cells after nominal fill
+#    reachability is known.
+#
+# e) Visual observability:
+#    A solver seeing 2-4 examples can infer the fused rule from geometry alone:
+#    the seed always sits in one funnel, a second same-colored funnel faces it,
+#    the painted wedge always stops before reaching the border, and the finite
+#    corridor shows repeated fill/wall bands. No ranking by color id or other
+#    hidden numeric property is used.
+#
+# f) Visual neatness:
+#    The generator keeps exactly one paired partner and at most a few singleton
+#    obstacles, so the corridor remains readable. It also rejects placements
+#    where the collision is visually inert, where the radiated region is too
+#    short to reveal the pattern, or where the fill can still spill to a border.
+#
+# g) Color-inference quality:
+#    The periodic colors come from existing semantic colors already exposed by
+#    the puzzle: seed color and wall color. The enclosed interior remains solid
+#    seed color, while only the outward corridor alternates, giving a strong
+#    structural cue for when and where the color rule changes.
+# ---------------------------------------------------------------------------
+
+
+PATTERN_BLOCK = 2  # AABB using fill, fill, wall, wall, ...
+
+# Canvas size bounds
+GRID_H_VERT = (14, 18)
+GRID_H_HORIZ = (14, 18)
+GRID_W = (17, 19)
+
+# Wall geometry
+WALL_PIXELS_MIN = 17
+WALL_PIXELS_MAX = 25
+DEPTH_VERT = (5, 7)
+DEPTH_HORIZ = (5, 7)
+GAP_VERT = (6, 7)
+GAP_HORIZ = (5, 7)
+TIP_12_PROB = 0.45
+
+# Pair layout
+PAIR_OPENING_GAP_MIN = 5
+PAIR_OPENING_GAP_MAX = 8
+PAIR_CENTER_SHIFT_MAX = 2.0
+ACTIVE_EDGE_MARGIN = 2
+
+# Fill seed
+SEED_SIZE_WEIGHTS = [1, 1, 1, 1, 2, 2, 3, 4, 5, 6]
+SEED_DEPTH_LOOKBACK = 3
+
+# Obstacles
+MAX_OBSTACLES = 2
+OBSTACLE_IN_FILL_PROB = 0.35
+OBSTACLE_MIN_SEP = 2
+
+# Validation
+MIN_NEW_PAINT = 10
+MIN_RADIATE_PIXELS = 8
+MIN_WALL_BAND_PIXELS = 4
+MIN_PATTERN_DEPTH = 4
+PALETTE_SIZE = (3, 5)
+GEN_RETRIES = 700
+
+
+def _sgn(x: int) -> int:
+    return (x > 0) - (x < 0)
+
+
+def _projection(r: int, c: int, rad: tuple[int, int]) -> int:
+    return int(r) * int(rad[0]) + int(c) * int(rad[1])
+
+
+def _component_sets(mask: np.ndarray) -> list[set[tuple[int, int]]]:
+    return [set((int(r), int(c)) for r, c in pts) for pts in components_mask(mask, connectivity=8)]
+
+
+def _component_mask(shape: tuple[int, int], comp: set[tuple[int, int]]) -> np.ndarray:
+    mask = np.zeros(shape, dtype=bool)
+    for r, c in comp:
+        mask[r, c] = True
+    return mask
+
+
+def _comp_neighbors(comp_mask: np.ndarray, r: int, c: int) -> list[tuple[int, int]]:
+    h, w = comp_mask.shape
+    out = []
+    for rr, cc in neighbors8(r, c):
+        if 0 <= rr < h and 0 <= cc < w and comp_mask[rr, cc]:
+            out.append((rr, cc))
+    return out
+
+
+def _outward_dir(comp_mask: np.ndarray, ep: tuple[int, int]) -> tuple[tuple[int, int], bool]:
+    n1 = _comp_neighbors(comp_mask, *ep)[0]
+    d1 = (_sgn(n1[0] - ep[0]), _sgn(n1[1] - ep[1]))
+    d_use = d1
+    is_12 = False
+    n2s = [p for p in _comp_neighbors(comp_mask, *n1) if p != ep]
+    if n2s:
+        n2 = n2s[0]
+        d2 = (_sgn(n2[0] - n1[0]), _sgn(n2[1] - n1[1]))
+        if (d1[0] == 0) ^ (d1[1] == 0):
+            if d2[0] != 0 and d2[1] != 0:
+                d_use = d2
+                is_12 = True
+    return (-d_use[0], -d_use[1]), is_12
+
+
+def _component_ray_info(comp: set[tuple[int, int]], shape: tuple[int, int]) -> dict:
+    comp_mask = _component_mask(shape, comp)
+    endpoints = sorted((r, c) for r, c in comp if len(_comp_neighbors(comp_mask, r, c)) == 1)
+    assert len(endpoints) >= 2, "expected at least two endpoints"
+    out_info = [_outward_dir(comp_mask, ep) for ep in endpoints]
+    out_dirs = [d for d, _ in out_info]
+    tip_12 = [flag for _, flag in out_info]
+    dr_sum = sum(d[0] for d in out_dirs)
+    dc_sum = sum(d[1] for d in out_dirs)
+    rad = (_sgn(dr_sum), _sgn(dc_sum))
+    return {
+        "comp_mask": comp_mask,
+        "endpoints": endpoints,
+        "out_dirs": out_dirs,
+        "tip_12": tip_12,
+        "rad": rad,
+    }
+
+
+def _trace_ray(
+    start: tuple[int, int],
+    d: tuple[int, int],
+    rad: tuple[int, int],
+    is_12: bool,
+    shape: tuple[int, int],
+    stop_mask: np.ndarray | None = None,
+) -> tuple[list[tuple[int, int]], tuple[int, int] | None]:
+    h, w = shape
+    rr, cc = start
+    step = 0
+    path: list[tuple[int, int]] = []
+    while True:
+        step += 1
+        if not is_12 or step % 2 == 1:
+            nr = rr + d[0]
+            nc = cc + d[1]
+        else:
+            if rad[0] != 0:
+                nr = rr + d[0]
+                nc = cc
+            else:
+                nr = rr
+                nc = cc + d[1]
+        if not (0 <= nr < h and 0 <= nc < w):
+            return path, None
+        if stop_mask is not None and stop_mask[nr, nc]:
+            return path, (nr, nc)
+        path.append((nr, nc))
+        rr, cc = nr, nc
+
+
+def _parse_scene(grid: np.ndarray) -> dict:
+    g = np.array(grid, copy=True)
+    h, w = g.shape
+    bg = get_bg(g)
+    vals = np.unique(g)
+    non_bg = [int(v) for v in vals if int(v) != bg]
+    assert non_bg, "expected at least one non-background color"
+
+    wall = max(non_bg, key=lambda c: int((g == c).sum()))
+    wall_mask = g == wall
+    comps = _component_sets(wall_mask)
+    assert comps, "expected wall components"
+
+    other_colors = [c for c in non_bg if c != wall]
+    assert other_colors, "expected at least one non-wall color"
+
+    wall_points = [p for comp in comps for p in comp]
+
+    def min_dist_to_wall(color: int) -> tuple[int, int]:
+        pts = [(int(r), int(c)) for r, c in zip(*np.where(g == color))]
+        best_d = 10**9
+        for r, c in pts:
+            for wr, wc in wall_points:
+                d = abs(r - wr) + abs(c - wc)
+                if d < best_d:
+                    best_d = d
+                    if best_d == 0:
+                        return 0, len(pts)
+        return best_d, len(pts)
+
+    fill = min(other_colors, key=lambda c: (min_dist_to_wall(c)[0], min_dist_to_wall(c)[1]))
+    fill_pos = [(int(r), int(c)) for r, c in zip(*np.where(g == fill))]
+    if not fill_pos:
+        return {
+            "grid": g,
+            "shape": (h, w),
+            "bg": int(bg),
+            "wall": int(wall),
+            "fill": int(fill),
+            "fill_pos": [],
+            "wall_comps": comps,
+        }
+
+    def comp_min_dist(comp: set[tuple[int, int]]) -> int:
+        best_d = 10**9
+        for r, c in fill_pos:
+            for wr, wc in comp:
+                d = abs(r - wr) + abs(c - wc)
+                if d < best_d:
+                    best_d = d
+                    if best_d == 0:
+                        return 0
+        return best_d
+
+    active_comp = min(comps, key=lambda comp: (comp_min_dist(comp), -len(comp)))
+    ray_info = _component_ray_info(active_comp, (h, w))
+    comp_mask = ray_info["comp_mask"]
+    other_wall_mask = wall_mask & (~comp_mask)
+
+    return {
+        "grid": g,
+        "shape": (h, w),
+        "bg": int(bg),
+        "wall": int(wall),
+        "fill": int(fill),
+        "fill_pos": fill_pos,
+        "wall_comps": comps,
+        "active_comp": active_comp,
+        "comp_mask": comp_mask,
+        "other_wall_mask": other_wall_mask,
+        "endpoints": ray_info["endpoints"],
+        "out_dirs": ray_info["out_dirs"],
+        "tip_12": ray_info["tip_12"],
+        "rad": ray_info["rad"],
+    }
+
+
+def _build_barrier(scene: dict, *, stop_at_other_wall: bool) -> tuple[np.ndarray, list[dict]]:
+    barrier = scene["comp_mask"].copy()
+    stop_mask = scene["other_wall_mask"] if stop_at_other_wall else None
+    ray_meta = []
+    for ep, d, is_12 in zip(scene["endpoints"], scene["out_dirs"], scene["tip_12"]):
+        path, hit = _trace_ray(ep, d, scene["rad"], is_12, scene["shape"], stop_mask)
+        for r, c in path:
+            barrier[r, c] = True
+        ray_meta.append(
+            {
+                "start": ep,
+                "dir": d,
+                "is_12": is_12,
+                "cells": path,
+                "hit": hit,
+            }
+        )
+    return barrier, ray_meta
+
+
+def _apply_shadows(
+    filled_mask: np.ndarray,
+    grid: np.ndarray,
+    *,
+    bg: int,
+    wall: int,
+    fill: int,
+    rad: tuple[int, int],
+) -> np.ndarray:
+    painted = filled_mask.copy()
+    obstacles = (grid != bg) & (grid != fill) & (grid != wall)
+    h, w = grid.shape
+
+    def shadow_process(coords: list[tuple[int, int]]) -> None:
+        started = False
+        blocked = False
+        for r, c in coords:
+            if painted[r, c]:
+                started = True
+            if started and obstacles[r, c]:
+                blocked = True
+                continue
+            if blocked and painted[r, c]:
+                painted[r, c] = False
+
+    if rad != (0, 0):
+        dr, dc = rad
+        if dr != 0 and dc == 0:
+            rows = range(h) if dr > 0 else range(h - 1, -1, -1)
+            for c in range(w):
+                shadow_process([(r, c) for r in rows])
+        elif dc != 0 and dr == 0:
+            cols = range(w) if dc > 0 else range(w - 1, -1, -1)
+            for r in range(h):
+                shadow_process([(r, c) for c in cols])
+        else:
+            if dr == dc:
+                for k in range(-(w - 1), h):
+                    coords = [(r, r - k) for r in range(h) if 0 <= r - k < w]
+                    coords.sort(key=lambda rc: rc[0], reverse=(dr < 0))
+                    shadow_process(coords)
+            else:
+                for k in range(h + w - 1):
+                    coords = [(r, k - r) for r in range(h) if 0 <= k - r < w]
+                    coords.sort(key=lambda rc: rc[0], reverse=(dr < 0))
+                    shadow_process(coords)
+    return painted
+
+
+def _solve_core(grid: np.ndarray, *, stop_at_other_wall: bool, return_meta: bool = False):
+    scene = _parse_scene(grid)
+    g = scene["grid"]
+    h, w = g.shape
+    if not scene["fill_pos"]:
+        empty = np.zeros_like(g, dtype=bool)
+        meta = {
+            "scene": scene,
+            "ray_meta": [],
+            "paint_mask": empty,
+            "radiated_mask": empty,
+            "wall_band_mask": empty,
+            "depth_map": np.full((h, w), -1, dtype=int),
+        }
+        return (g, meta) if return_meta else g
+
+    barrier, ray_meta = _build_barrier(scene, stop_at_other_wall=stop_at_other_wall)
+    passable = (~barrier) & ((g == scene["bg"]) | (g == scene["fill"]))
+
+    q = scene["fill_pos"][:]
+    seen = np.zeros_like(passable, dtype=bool)
+    for r, c in q:
+        if passable[r, c]:
+            seen[r, c] = True
+    while q:
+        r, c = q.pop()
+        for rr, cc in neighbors4(r, c):
+            if 0 <= rr < h and 0 <= cc < w and passable[rr, cc] and not seen[rr, cc]:
+                seen[rr, cc] = True
+                q.append((rr, cc))
+
+    filled_mask = seen & (g == scene["bg"])
+    paint_mask = _apply_shadows(
+        filled_mask,
+        g,
+        bg=scene["bg"],
+        wall=scene["wall"],
+        fill=scene["fill"],
+        rad=scene["rad"],
+    )
+
+    out = g.copy()
+    out[paint_mask] = scene["fill"]
+
+    depth_map = np.full((h, w), -1, dtype=int)
+    radiated_mask = np.zeros_like(paint_mask, dtype=bool)
+    wall_band_mask = np.zeros_like(paint_mask, dtype=bool)
+    if scene["rad"] != (0, 0):
+        open_proj = max(_projection(r, c, scene["rad"]) for r, c in scene["endpoints"])
+        rows, cols = np.indices((h, w))
+        depth_map = rows * scene["rad"][0] + cols * scene["rad"][1] - open_proj
+        radiated_mask = paint_mask & (depth_map >= 0)
+        wall_band_mask = radiated_mask & (((depth_map // PATTERN_BLOCK) % 2) == 1)
+        out[wall_band_mask] = scene["wall"]
+
+    meta = {
+        "scene": scene,
+        "ray_meta": ray_meta,
+        "paint_mask": paint_mask.copy(),
+        "radiated_mask": radiated_mask,
+        "wall_band_mask": wall_band_mask,
+        "depth_map": depth_map,
+    }
+    return (out, meta) if return_meta else out
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Fill one member of an opposite-facing wall pair, then stop and recolor the outward corridor based on the partner sprite.
+
+    Input structure:
+    - The background is the most common color. The dominant non-background color forms at least one partial enclosure,
+      and in this combo the generator presents them as a facing pair of same-colored wall sprites.
+    - A nearby non-wall color marks the seed blob inside exactly one enclosure. Any other scattered non-wall pixels are
+      static obstacles.
+
+    Rule:
+    - Select the wall component nearest the seed as the active enclosure, flood-fill its reachable interior, and let the
+      fill radiate outward through that enclosure's opening.
+    - Trace the two boundary rays of that radiating wedge in the opening direction, but stop each ray as soon as its next
+      step would hit another wall component from the facing partner sprite instead of running to the canvas border.
+    - After obstacle shadows remove blocked cells, recolor the surviving radiated corridor with a repeating AABB pattern
+      that alternates seed-color bands and wall-color bands by depth from the opening; the enclosed interior stays seed-colored.
+
+    Key insight:
+    - The output is controlled by the relationship between the paired sprites: the gap to the opposite-facing partner sets
+      the corridor length, and depth within that finite corridor sets whether each painted band uses the seed color or the
+      wall color.
+    """
+    return _solve_core(grid, stop_at_other_wall=True)
+
+
+def _degree1_pixels(points: set[tuple[int, int]]) -> list[tuple[int, int]]:
+    pts = set(points)
+    return [(r, c) for r, c in pts if sum((rr, cc) in pts for rr, cc in neighbors8(r, c)) == 1]
+
+
+def _make_arm(depth: int, start_v: int, target_v: int, extra_steps: int, tip_12: bool = False) -> list[tuple[int, int]]:
+    sign = 1 if target_v > start_v else -1
+    n_side_steps = abs(target_v - start_v)
+    chosen_rows = []
+    if n_side_steps:
+        if tip_12:
+            chosen_rows = [2 * (i + 1) for i in range(n_side_steps)]
+            extra_steps = 0
+        else:
+            chosen_rows = [1]
+            if n_side_steps > 1:
+                chosen_rows += random.sample(range(2, depth + 1), n_side_steps - 1)
+            chosen_rows.sort()
+
+    first_row = chosen_rows[0] if chosen_rows else 1
+    extra_rows = [r for r in chosen_rows if r != first_row]
+    random.shuffle(extra_rows)
+    orthogonal_rows = set(extra_rows[:extra_steps])
+
+    pts = [(0, start_v)]
+    u, v = 0, start_v
+    for row in range(1, depth + 1):
+        u += 1
+        if row in orthogonal_rows:
+            pts.append((u, v))
+            v += sign
+        elif row in chosen_rows:
+            v += sign
+        pts.append((u, v))
+    return pts
+
+
+def _build_local_wall(rad: tuple[int, int], h: int, w: int):
+    if rad[0]:
+        max_depth = min(DEPTH_VERT[1], h - 7)
+        if max_depth < DEPTH_VERT[0]:
+            return None
+        depth = random.randint(DEPTH_VERT[0], max_depth)
+        gap = random.randint(*GAP_VERT)
+    else:
+        max_depth = min(DEPTH_HORIZ[1], w - 7)
+        if max_depth < DEPTH_HORIZ[0]:
+            return None
+        depth = random.randint(DEPTH_HORIZ[0], max_depth)
+        gap = random.randint(GAP_HORIZ[0], min(GAP_HORIZ[1], h - 1))
+
+    if gap == 5:
+        left_bottom, right_bottom = 2, 3
+    elif gap == 6:
+        left_bottom, right_bottom = 2, 4
+    else:
+        left_bottom, right_bottom = random.choice([(2, 5), (3, 4)])
+
+    bridge_extra = max(0, right_bottom - left_bottom - 1)
+    base_count = 2 * (depth + 1) + bridge_extra
+    max_extra_l = max(0, left_bottom - 1)
+    max_extra_r = max(0, gap - right_bottom - 1)
+    min_extra = max(0, WALL_PIXELS_MIN - base_count)
+    max_extra = min(max_extra_l + max_extra_r, WALL_PIXELS_MAX - base_count)
+    if min_extra > max_extra:
+        return None
+
+    extra = random.randint(min_extra, max_extra)
+    extra_l = random.randint(max(0, extra - max_extra_r), min(max_extra_l, extra))
+    extra_r = extra - extra_l
+
+    max_n_side = max(left_bottom, gap - right_bottom)
+    tip_12 = depth >= 2 * max_n_side and random.random() < TIP_12_PROB
+    left = _make_arm(depth, 0, left_bottom, extra_l, tip_12=tip_12)
+    right = _make_arm(depth, gap, right_bottom, extra_r, tip_12=tip_12)
+    pts = set(left) | set(right)
+    for v in range(left_bottom, right_bottom + 1):
+        pts.add((depth, v))
+
+    while len(pts) < WALL_PIXELS_MIN:
+        candidates = [
+            (u, v)
+            for u in range(max(0, depth - 3), depth + 1)
+            for v in range(gap + 1)
+            if (u, v) not in pts
+            and sum(
+                (uu, vv) in pts
+                for uu in range(u - 1, u + 2)
+                for vv in range(v - 1, v + 2)
+                if (uu, vv) != (u, v)
+            )
+            >= 2
+        ]
+        random.shuffle(candidates)
+        added = False
+        for p in candidates:
+            trial = pts | {p}
+            if len(trial) <= WALL_PIXELS_MAX and len(_degree1_pixels(trial)) == 2:
+                pts = trial
+                added = True
+                break
+        if not added:
+            return None
+
+    if not (WALL_PIXELS_MIN <= len(pts) <= WALL_PIXELS_MAX):
+        return None
+    if len(_degree1_pixels(pts)) != 2:
+        return None
+    return pts, depth, gap
+
+
+def _map_local(u: int, v: int, rad: tuple[int, int], anchor: tuple[int, int]) -> tuple[int, int]:
+    r0, c0 = anchor
+    if rad == (-1, 0):
+        return r0 + u, c0 + v
+    if rad == (1, 0):
+        return r0 - u, c0 + v
+    if rad == (0, -1):
+        return r0 + v, c0 + u
+    return r0 + v, c0 - u
+
+
+def _render_points(local_wall: set[tuple[int, int]], rad: tuple[int, int], anchor: tuple[int, int]) -> set[tuple[int, int]]:
+    return {_map_local(u, v, rad, anchor) for u, v in local_wall}
+
+
+def _fitting_anchors(local_wall: set[tuple[int, int]], rad: tuple[int, int], shape: tuple[int, int]) -> list[tuple[int, int]]:
+    h, w = shape
+    offsets = [_map_local(u, v, rad, (0, 0)) for u, v in local_wall]
+    row_offsets = [r for r, _ in offsets]
+    col_offsets = [c for _, c in offsets]
+    row_lo = -min(row_offsets)
+    row_hi = h - 1 - max(row_offsets)
+    col_lo = -min(col_offsets)
+    col_hi = w - 1 - max(col_offsets)
+    if row_lo > row_hi or col_lo > col_hi:
+        return []
+    return [(r, c) for r in range(row_lo, row_hi + 1) for c in range(col_lo, col_hi + 1)]
+
+
+def _place_active_anchor(rad: tuple[int, int], h: int, w: int, depth: int, gap: int):
+    if rad == (-1, 0):
+        row_lo = depth + PAIR_OPENING_GAP_MIN
+        row_hi = h - depth - ACTIVE_EDGE_MARGIN - 1
+        col_lo = 0
+        col_hi = w - gap - 1
+    elif rad == (1, 0):
+        row_lo = depth + ACTIVE_EDGE_MARGIN
+        row_hi = h - depth - PAIR_OPENING_GAP_MIN - 1
+        col_lo = 0
+        col_hi = w - gap - 1
+    elif rad == (0, -1):
+        row_lo = 0
+        row_hi = h - gap - 1
+        col_lo = depth + PAIR_OPENING_GAP_MIN
+        col_hi = w - depth - ACTIVE_EDGE_MARGIN - 1
+    else:
+        row_lo = 0
+        row_hi = h - gap - 1
+        col_lo = depth + ACTIVE_EDGE_MARGIN
+        col_hi = w - depth - PAIR_OPENING_GAP_MIN - 1
+    if row_lo > row_hi or col_lo > col_hi:
+        return None
+    return random.randint(row_lo, row_hi), random.randint(col_lo, col_hi)
+
+
+def _local_interior(wall: set[tuple[int, int]], depth: int) -> list[tuple[int, int]]:
+    by_row: dict[int, list[int]] = {}
+    for u, v in wall:
+        by_row.setdefault(u, []).append(v)
+    interior = []
+    for u in range(1, depth):
+        if u not in by_row or len(by_row[u]) < 2:
+            continue
+        lo, hi = min(by_row[u]), max(by_row[u])
+        for v in range(lo + 1, hi):
+            if (u, v) not in wall:
+                interior.append((u, v))
+    return interior
+
+
+def _grow_seed_blob(seed: tuple[int, int], interior_set: set[tuple[int, int]]) -> set[tuple[int, int]]:
+    blob = {seed}
+    target_size = random.choice(SEED_SIZE_WEIGHTS)
+    frontier = [seed]
+    while len(blob) < target_size and frontier:
+        p = frontier.pop(random.randrange(len(frontier)))
+        u, v = p
+        for q in random.sample([(u - 1, v), (u + 1, v), (u, v - 1), (u, v + 1)], 4):
+            if q in interior_set and q not in blob:
+                blob.add(q)
+                frontier.append(q)
+                if len(blob) >= target_size:
+                    break
+    return blob
+
+
+def _obstacle_fits(pos: tuple[int, int], placed: list[tuple[int, int]]) -> bool:
+    r, c = pos
+    return all(max(abs(r - rr), abs(c - cc)) >= OBSTACLE_MIN_SEP for rr, cc in placed)
+
+
+def _find_obstacle_candidates(grid: np.ndarray, bg: int, wall_color: int, nominal_fill_zone: np.ndarray):
+    wall_mask = grid == wall_color
+    dist = distance_transform_cdt(~wall_mask, metric="taxicab")
+    eligible = (grid == bg) & (dist > 1)
+    all_coords = list(zip(*np.where(eligible)))
+    fill_coords = [p for p in all_coords if nominal_fill_zone[p[0], p[1]]]
+    random.shuffle(all_coords)
+    random.shuffle(fill_coords)
+    return [(int(r), int(c)) for r, c in all_coords], [(int(r), int(c)) for r, c in fill_coords]
+
+
+def _place_obstacles(
+    n_obstacles: int,
+    candidates: list[tuple[int, int]],
+    fill_candidates: list[tuple[int, int]],
+    obstacle_colors: list[int],
+    grid: np.ndarray,
+) -> None:
+    placed: list[tuple[int, int]] = []
+    n_fill = random.randint(0, min(n_obstacles, len(fill_candidates)))
+    if fill_candidates and random.random() < OBSTACLE_IN_FILL_PROB:
+        n_fill = max(1, n_fill)
+    for p in fill_candidates:
+        if len(placed) >= n_fill:
+            break
+        if _obstacle_fits(p, placed):
+            placed.append(p)
+    placed_set = set(placed)
+    for p in candidates:
+        if len(placed) >= n_obstacles:
+            break
+        if p not in placed_set and _obstacle_fits(p, placed):
+            placed.append(p)
+            placed_set.add(p)
+    for i, (r, c) in enumerate(placed):
+        grid[r, c] = obstacle_colors[i % len(obstacle_colors)]
+
+
+def _touches_border(mask: np.ndarray) -> bool:
+    return bool(mask[0, :].any() or mask[-1, :].any() or mask[:, 0].any() or mask[:, -1].any())
+
+
+def _opening_center(endpoints: list[tuple[int, int]], rad: tuple[int, int]) -> float:
+    if rad[0] != 0:
+        return sum(c for _, c in endpoints) / len(endpoints)
+    return sum(r for r, _ in endpoints) / len(endpoints)
+
+
+def _chebyshev_separated(a: set[tuple[int, int]], b: set[tuple[int, int]]) -> bool:
+    for r1, c1 in a:
+        for r2, c2 in b:
+            if max(abs(r1 - r2), abs(c1 - c2)) <= 1:
+                return False
+    return True
+
+
+def _search_passive_component(
+    local_wall: set[tuple[int, int]],
+    active_pts: set[tuple[int, int]],
+    rad: tuple[int, int],
+    shape: tuple[int, int],
+) -> tuple[set[tuple[int, int]] | None, tuple[int, int] | None]:
+    opposite_rad = (-rad[0], -rad[1])
+    active_info = _component_ray_info(active_pts, shape)
+    active_open_proj = max(_projection(r, c, rad) for r, c in active_info["endpoints"])
+    active_center = _opening_center(active_info["endpoints"], rad)
+
+    candidates = []
+    for anchor in _fitting_anchors(local_wall, opposite_rad, shape):
+        passive_pts = _render_points(local_wall, opposite_rad, anchor)
+        if not _chebyshev_separated(active_pts, passive_pts):
+            continue
+        passive_info = _component_ray_info(passive_pts, shape)
+        passive_open_proj = min(_projection(r, c, rad) for r, c in passive_info["endpoints"])
+        gap = passive_open_proj - active_open_proj
+        if gap < PAIR_OPENING_GAP_MIN or gap > PAIR_OPENING_GAP_MAX:
+            continue
+        center_shift = abs(_opening_center(passive_info["endpoints"], rad) - active_center)
+        if center_shift > PAIR_CENTER_SHIFT_MAX:
+            continue
+        stop_mask = _component_mask(shape, passive_pts)
+        hits = []
+        for ep, d, is_12 in zip(active_info["endpoints"], active_info["out_dirs"], active_info["tip_12"]):
+            _, hit = _trace_ray(ep, d, active_info["rad"], is_12, shape, stop_mask)
+            hits.append(hit)
+        if not all(hit is not None for hit in hits):
+            continue
+        score = (center_shift, abs(gap - (PAIR_OPENING_GAP_MIN + PAIR_OPENING_GAP_MAX) / 2.0))
+        candidates.append((score, passive_pts, anchor))
+
+    if not candidates:
+        return None, None
+    candidates.sort(key=lambda x: x[0])
+    top = candidates[: min(8, len(candidates))]
+    _, pts, anchor = random.choice(top)
+    return pts, anchor
+
+
+def _build_paired_scene():
+    rad = random.choice([(-1, 0), (1, 0), (0, -1), (0, 1)])
+    h = random.randint(*GRID_H_VERT) if rad[0] else random.randint(*GRID_H_HORIZ)
+    w = random.randint(*GRID_W)
+
+    built = _build_local_wall(rad, h, w)
+    if built is None:
+        return None
+    local_wall, depth, gap = built
+    active_anchor = _place_active_anchor(rad, h, w, depth, gap)
+    if active_anchor is None:
+        return None
+
+    active_pts = _render_points(local_wall, rad, active_anchor)
+    passive_pts, passive_anchor = _search_passive_component(local_wall, active_pts, rad, (h, w))
+    if passive_pts is None or passive_anchor is None:
+        return None
+
+    return {
+        "shape": (h, w),
+        "rad": rad,
+        "local_wall": local_wall,
+        "depth": depth,
+        "gap": gap,
+        "active_anchor": active_anchor,
+        "active_pts": active_pts,
+        "passive_anchor": passive_anchor,
+        "passive_pts": passive_pts,
+    }
+
+
+def _gen_attempt():
+    scene = _build_paired_scene()
+    if scene is None:
+        return None
+
+    h, w = scene["shape"]
+    palette = random.sample(range(10), random.randint(*PALETTE_SIZE))
+    bg, wall_color, fill_color = palette[:3]
+    obstacle_colors = palette[3:]
+
+    grid = np.full((h, w), bg, dtype=int)
+    for r, c in scene["active_pts"] | scene["passive_pts"]:
+        grid[r, c] = wall_color
+
+    interior = _local_interior(scene["local_wall"], scene["depth"])
+    wall_set = set(scene["local_wall"])
+    adjacent = [
+        p
+        for p in interior
+        if any((p[0] + dr, p[1] + dc) in wall_set for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)])
+    ]
+    seed_pool = [p for p in adjacent if p[0] >= max(1, scene["depth"] - SEED_DEPTH_LOOKBACK)]
+    if not seed_pool:
+        return None
+
+    blob = _grow_seed_blob(random.choice(seed_pool), set(interior))
+    for u, v in blob:
+        r, c = _map_local(u, v, scene["rad"], scene["active_anchor"])
+        if grid[r, c] != bg:
+            return None
+        grid[r, c] = fill_color
+
+    try:
+        nominal_out, nominal_meta = _solve_core(grid, stop_at_other_wall=True, return_meta=True)
+        edge_out, edge_meta = _solve_core(grid, stop_at_other_wall=False, return_meta=True)
+    except Exception:
+        return None
+
+    if np.array_equal(nominal_out, edge_out):
+        return None
+
+    nominal_fill_zone = nominal_meta["paint_mask"] & (grid == bg)
+
+    n_obstacles = random.randint(0, MAX_OBSTACLES)
+    if n_obstacles and not obstacle_colors:
+        available = [c for c in range(10) if c not in (bg, wall_color, fill_color)]
+        obstacle_colors = random.sample(available, random.randint(1, 2))
+    if n_obstacles:
+        candidates, fill_candidates = _find_obstacle_candidates(grid, bg, wall_color, nominal_fill_zone)
+        _place_obstacles(n_obstacles, candidates, fill_candidates, obstacle_colors, grid)
+
+    try:
+        out, meta = _solve_core(grid, stop_at_other_wall=True, return_meta=True)
+        edge_out, _ = _solve_core(grid, stop_at_other_wall=False, return_meta=True)
+    except Exception:
+        return None
+
+    hits = [rm["hit"] is not None for rm in meta["ray_meta"]]
+    if len(hits) != 2 or not all(hits):
+        return None
+
+    paint_mask = meta["paint_mask"] & (grid == bg)
+    radiated_mask = meta["radiated_mask"] & paint_mask
+    wall_band_mask = meta["wall_band_mask"] & paint_mask
+    depth_map = meta["depth_map"]
+
+    if int(paint_mask.sum()) < MIN_NEW_PAINT:
+        return None
+    if _touches_border(paint_mask):
+        return None
+    if int(radiated_mask.sum()) < MIN_RADIATE_PIXELS:
+        return None
+    if int(wall_band_mask.sum()) < MIN_WALL_BAND_PIXELS:
+        return None
+    if not np.any(radiated_mask):
+        return None
+    if int(depth_map[radiated_mask].max()) < MIN_PATTERN_DEPTH:
+        return None
+    if np.array_equal(out, edge_out):
+        return None
+
+    new_wall = (grid == bg) & (out == wall_color)
+    new_fill = (grid == bg) & (out == fill_color)
+    if not new_wall.any() or not new_fill.any():
+        return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate valid b9e38dc0 combo input")

diff --git a/ceshi/code_combo/b9e38dc0/37/code.py b/ceshi/code_combo/b9e38dc0/37/code.py
new file mode 100644
index 0000000000000000000000000000000000000000..5738481da6615e0b239791e1e7dcb88e29af0f42
--- /dev/null
+++ b/ceshi/code_combo/b9e38dc0/37/code.py
@@ -0,0 +1,893 @@
+# Combo variant of b9e38dc0 (index 37)
+# combo_spec: D3/0+D5/0+D12/2
+# Name: 周期涂色+碰撞终止+配对相对
+
+import random
+
+import numpy as np
+from scipy.ndimage import distance_transform_cdt
+
+from arc_utils import components_mask, get_bg, neighbors4, neighbors8
+
+# ---------------------------------------------------------------------------
+# Design analysis for the combo variant
+#
+# a) Concrete behavior and trace:
+#    We keep the original "funnel enclosure + seed + obstacle shadow" backbone,
+#    but the scene now contains a visible pair of wall sprites that face each
+#    other. Only one member of the pair contains the seed blob; that component
+#    is the active enclosure. Example with an active sprite opening upward:
+#      - Original task: seed flood-fills the interior, then the wedge extends
+#        upward until the canvas border; every painted cell uses one fill color.
+#      - D5 effect: the two boundary rays no longer run to the border. They are
+#        traced step by step and stop as soon as the next step would land on the
+#        opposite-facing partner sprite above.
+#      - D3 effect: after reachability and obstacle shadows are resolved, the
+#        surviving radiated cells outside the opening are recolored in AABB
+#        depth bands: fill, fill, wall, wall, fill, fill, ...
+#      - D12 effect: the blocker is not an arbitrary patch. It is a second
+#        funnel sprite of the same wall color, oriented with the opposite
+#        opening direction so humans can read it as a paired counterpart.
+#    The visible difference from the original is therefore twofold: the wedge
+#    has a finite object-to-object length, and within that finite corridor the
+#    color alternates periodically instead of staying uniform.
+#
+# b) Complexity calibration:
+#    The combo uses only one extra structural degree of freedom beyond the
+#    original task: a second wall component. Its role is heavily constrained:
+#    same wall color, opposite opening direction, placed in front of the active
+#    opening, and required to stop both boundary rays. The periodic coloring is
+#    fixed globally to one pattern (AABB with fill/wall colors), so examples are
+#    varied by corridor length and obstacle placement, not by many unrelated
+#    pattern families.
+#
+# c) Hidden-assumption audit:
+#    - The original `wall = most frequent non-bg color` still works because both
+#      paired sprites share one wall color and dominate the pixel count.
+#    - `wall_comp = closest component to the fill seed` becomes essential: the
+#      seed-bearing enclosure must be the active component, while the opposite
+#      partner acts only as a collision stop.
+#    - The original ray code assumed "stop only at border". That assumption is
+#      invalid now, so rays are explicitly traced and can terminate on another
+#      wall component before leaving the grid.
+#    - The original `out[filled_mask] = fill` assumed a single paint color.
+#      That fails under periodic recoloring, so the solver first computes the
+#      boolean painted region, then applies obstacle shadows, then assigns band
+#      colors by radiate depth.
+#    - BFS still assumes only bg and seed cells are passable. The generator
+#      preserves that by keeping the partner sprite wall-colored rather than
+#      introducing a distinct "stop" color.
+#    - New implicit assumption: the opposite-facing partner must actually cap
+#      the wedge rather than sit off to the side. The generator therefore
+#      searches placements and rejects any case where either boundary ray misses
+#      the partner or the output leaks to the border as if no collision existed.
+#
+# d) Placement legality:
+#    Both sprites are built from the original local wall generator, then one is
+#    rendered with radiate direction `rad` and the partner with `-rad`. The
+#    search enforces in-bounds placement, positive gap along the radiate axis,
+#    8-connectivity separation between the two wall components, and successful
+#    collision hits for both active boundary rays. Seeds are placed only inside
+#    the active enclosure; obstacles are placed on bg cells after nominal fill
+#    reachability is known.
+#
+# e) Visual observability:
+#    A solver seeing 2-4 examples can infer the fused rule from geometry alone:
+#    the seed always sits in one funnel, a second same-colored funnel faces it,
+#    the painted wedge always stops before reaching the border, and the finite
+#    corridor shows repeated fill/wall bands. No ranking by color id or other
+#    hidden numeric property is used.
+#
+# f) Visual neatness:
+#    The generator keeps exactly one paired partner and at most a few singleton
+#    obstacles, so the corridor remains readable. It also rejects placements
+#    where the collision is visually inert, where the radiated region is too
+#    short to reveal the pattern, or where the fill can still spill to a border.
+#
+# g) Color-inference quality:
+#    The periodic colors come from existing semantic colors already exposed by
+#    the puzzle: seed color and wall color. The enclosed interior remains solid
+#    seed color, while only the outward corridor alternates, giving a strong
+#    structural cue for when and where the color rule changes.
+# ---------------------------------------------------------------------------
+
+
+PATTERN_BLOCK = 2  # AABB using fill, fill, wall, wall, ...
+
+# Canvas size bounds
+GRID_H_VERT = (14, 18)
+GRID_H_HORIZ = (14, 18)
+GRID_W = (17, 19)
+
+# Wall geometry
+WALL_PIXELS_MIN = 17
+WALL_PIXELS_MAX = 25
+DEPTH_VERT = (5, 7)
+DEPTH_HORIZ = (5, 7)
+GAP_VERT = (6, 7)
+GAP_HORIZ = (5, 7)
+TIP_12_PROB = 0.45
+
+# Pair layout
+PAIR_OPENING_GAP_MIN = 5
+PAIR_OPENING_GAP_MAX = 8
+PAIR_CENTER_SHIFT_MAX = 2.0
+ACTIVE_EDGE_MARGIN = 2
+
+# Fill seed
+SEED_SIZE_WEIGHTS = [1, 1, 1, 1, 2, 2, 3, 4, 5, 6]
+SEED_DEPTH_LOOKBACK = 3
+
+# Obstacles
+MAX_OBSTACLES = 2
+OBSTACLE_IN_FILL_PROB = 0.35
+OBSTACLE_MIN_SEP = 2
+
+# Validation
+MIN_NEW_PAINT = 10
+MIN_RADIATE_PIXELS = 8
+MIN_WALL_BAND_PIXELS = 4
+MIN_PATTERN_DEPTH = 4
+PALETTE_SIZE = (3, 5)
+GEN_RETRIES = 700
+
+
+def _sgn(x: int) -> int:
+    return (x > 0) - (x < 0)
+
+
+def _projection(r: int, c: int, rad: tuple[int, int]) -> int:
+    return int(r) * int(rad[0]) + int(c) * int(rad[1])
+
+
+def _component_sets(mask: np.ndarray) -> list[set[tuple[int, int]]]:
+    return [set((int(r), int(c)) for r, c in pts) for pts in components_mask(mask, connectivity=8)]
+
+
+def _component_mask(shape: tuple[int, int], comp: set[tuple[int, int]]) -> np.ndarray:
+    mask = np.zeros(shape, dtype=bool)
+    for r, c in comp:
+        mask[r, c] = True
+    return mask
+
+
+def _comp_neighbors(comp_mask: np.ndarray, r: int, c: int) -> list[tuple[int, int]]:
+    h, w = comp_mask.shape
+    out = []
+    for rr, cc in neighbors8(r, c):
+        if 0 <= rr < h and 0 <= cc < w and comp_mask[rr, cc]:
+            out.append((rr, cc))
+    return out
+
+
+def _outward_dir(comp_mask: np.ndarray, ep: tuple[int, int]) -> tuple[tuple[int, int], bool]:
+    n1 = _comp_neighbors(comp_mask, *ep)[0]
+    d1 = (_sgn(n1[0] - ep[0]), _sgn(n1[1] - ep[1]))
+    d_use = d1
+    is_12 = False
+    n2s = [p for p in _comp_neighbors(comp_mask, *n1) if p != ep]
+    if n2s:
+        n2 = n2s[0]
+        d2 = (_sgn(n2[0] - n1[0]), _sgn(n2[1] - n1[1]))
+        if (d1[0] == 0) ^ (d1[1] == 0):
+            if d2[0] != 0 and d2[1] != 0:
+                d_use = d2
+                is_12 = True
+    return (-d_use[0], -d_use[1]), is_12
+
+
+def _component_ray_info(comp: set[tuple[int, int]], shape: tuple[int, int]) -> dict:
+    comp_mask = _component_mask(shape, comp)
+    endpoints = sorted((r, c) for r, c in comp if len(_comp_neighbors(comp_mask, r, c)) == 1)
+    assert len(endpoints) >= 2, "expected at least two endpoints"
+    out_info = [_outward_dir(comp_mask, ep) for ep in endpoints]
+    out_dirs = [d for d, _ in out_info]
+    tip_12 = [flag for _, flag in out_info]
+    dr_sum = sum(d[0] for d in out_dirs)
+    dc_sum = sum(d[1] for d in out_dirs)
+    rad = (_sgn(dr_sum), _sgn(dc_sum))
+    return {
+        "comp_mask": comp_mask,
+        "endpoints": endpoints,
+        "out_dirs": out_dirs,
+        "tip_12": tip_12,
+        "rad": rad,
+    }
+
+
+def _trace_ray(
+    start: tuple[int, int],
+    d: tuple[int, int],
+    rad: tuple[int, int],
+    is_12: bool,
+    shape: tuple[int, int],
+    stop_mask: np.ndarray | None = None,
+) -> tuple[list[tuple[int, int]], tuple[int, int] | None]:
+    h, w = shape
+    rr, cc = start
+    step = 0
+    path: list[tuple[int, int]] = []
+    while True:
+        step += 1
+        if not is_12 or step % 2 == 1:
+            nr = rr + d[0]
+            nc = cc + d[1]
+        else:
+            if rad[0] != 0:
+                nr = rr + d[0]
+                nc = cc
+            else:
+                nr = rr
+                nc = cc + d[1]
+        if not (0 <= nr < h and 0 <= nc < w):
+            return path, None
+        if stop_mask is not None and stop_mask[nr, nc]:
+            return path, (nr, nc)
+        path.append((nr, nc))
+        rr, cc = nr, nc
+
+
+def _parse_scene(grid: np.ndarray) -> dict:
+    g = np.array(grid, copy=True)
+    h, w = g.shape
+    bg = get_bg(g)
+    vals = np.unique(g)
+    non_bg = [int(v) for v in vals if int(v) != bg]
+    assert non_bg, "expected at least one non-background color"
+
+    wall = max(non_bg, key=lambda c: int((g == c).sum()))
+    wall_mask = g == wall
+    comps = _component_sets(wall_mask)
+    assert comps, "expected wall components"
+
+    other_colors = [c for c in non_bg if c != wall]
+    assert other_colors, "expected at least one non-wall color"
+
+    wall_points = [p for comp in comps for p in comp]
+
+    def min_dist_to_wall(color: int) -> tuple[int, int]:
+        pts = [(int(r), int(c)) for r, c in zip(*np.where(g == color))]
+        best_d = 10**9
+        for r, c in pts:
+            for wr, wc in wall_points:
+                d = abs(r - wr) + abs(c - wc)
+                if d < best_d:
+                    best_d = d
+                    if best_d == 0:
+                        return 0, len(pts)
+        return best_d, len(pts)
+
+    fill = min(other_colors, key=lambda c: (min_dist_to_wall(c)[0], min_dist_to_wall(c)[1]))
+    fill_pos = [(int(r), int(c)) for r, c in zip(*np.where(g == fill))]
+    if not fill_pos:
+        return {
+            "grid": g,
+            "shape": (h, w),
+            "bg": int(bg),
+            "wall": int(wall),
+            "fill": int(fill),
+            "fill_pos": [],
+            "wall_comps": comps,
+        }
+
+    def comp_min_dist(comp: set[tuple[int, int]]) -> int:
+        best_d = 10**9
+        for r, c in fill_pos:
+            for wr, wc in comp:
+                d = abs(r - wr) + abs(c - wc)
+                if d < best_d:
+                    best_d = d
+                    if best_d == 0:
+                        return 0
+        return best_d
+
+    active_comp = min(comps, key=lambda comp: (comp_min_dist(comp), -len(comp)))
+    ray_info = _component_ray_info(active_comp, (h, w))
+    comp_mask = ray_info["comp_mask"]
+    other_wall_mask = wall_mask & (~comp_mask)
+
+    return {
+        "grid": g,
+        "shape": (h, w),
+        "bg": int(bg),
+        "wall": int(wall),
+        "fill": int(fill),
+        "fill_pos": fill_pos,
+        "wall_comps": comps,
+        "active_comp": active_comp,
+        "comp_mask": comp_mask,
+        "other_wall_mask": other_wall_mask,
+        "endpoints": ray_info["endpoints"],
+        "out_dirs": ray_info["out_dirs"],
+        "tip_12": ray_info["tip_12"],
+        "rad": ray_info["rad"],
+    }
+
+
+def _build_barrier(scene: dict, *, stop_at_other_wall: bool) -> tuple[np.ndarray, list[dict]]:
+    barrier = scene["comp_mask"].copy()
+    stop_mask = scene["other_wall_mask"] if stop_at_other_wall else None
+    ray_meta = []
+    for ep, d, is_12 in zip(scene["endpoints"], scene["out_dirs"], scene["tip_12"]):
+        path, hit = _trace_ray(ep, d, scene["rad"], is_12, scene["shape"], stop_mask)
+        for r, c in path:
+            barrier[r, c] = True
+        ray_meta.append(
+            {
+                "start": ep,
+                "dir": d,
+                "is_12": is_12,
+                "cells": path,
+                "hit": hit,
+            }
+        )
+    return barrier, ray_meta
+
+
+def _apply_shadows(
+    filled_mask: np.ndarray,
+    grid: np.ndarray,
+    *,
+    bg: int,
+    wall: int,
+    fill: int,
+    rad: tuple[int, int],
+) -> np.ndarray:
+    painted = filled_mask.copy()
+    obstacles = (grid != bg) & (grid != fill) & (grid != wall)
+    h, w = grid.shape
+
+    def shadow_process(coords: list[tuple[int, int]]) -> None:
+        started = False
+        blocked = False
+        for r, c in coords:
+            if painted[r, c]:
+                started = True
+            if started and obstacles[r, c]:
+                blocked = True
+                continue
+            if blocked and painted[r, c]:
+                painted[r, c] = False
+
+    if rad != (0, 0):
+        dr, dc = rad
+        if dr != 0 and dc == 0:
+            rows = range(h) if dr > 0 else range(h - 1, -1, -1)
+            for c in range(w):
+                shadow_process([(r, c) for r in rows])
+        elif dc != 0 and dr == 0:
+            cols = range(w) if dc > 0 else range(w - 1, -1, -1)
+            for r in range(h):
+                shadow_process([(r, c) for c in cols])
+        else:
+            if dr == dc:
+                for k in range(-(w - 1), h):
+                    coords = [(r, r - k) for r in range(h) if 0 <= r - k < w]
+                    coords.sort(key=lambda rc: rc[0], reverse=(dr < 0))
+                    shadow_process(coords)
+            else:
+                for k in range(h + w - 1):
+                    coords = [(r, k - r) for r in range(h) if 0 <= k - r < w]
+                    coords.sort(key=lambda rc: rc[0], reverse=(dr < 0))
+                    shadow_process(coords)
+    return painted
+
+
+def _solve_core(grid: np.ndarray, *, stop_at_other_wall: bool, return_meta: bool = False):
+    scene = _parse_scene(grid)
+    g = scene["grid"]
+    h, w = g.shape
+    if not scene["fill_pos"]:
+        empty = np.zeros_like(g, dtype=bool)
+        meta = {
+            "scene": scene,
+            "ray_meta": [],
+            "paint_mask": empty,
+            "radiated_mask": empty,
+            "wall_band_mask": empty,
+            "depth_map": np.full((h, w), -1, dtype=int),
+        }
+        return (g, meta) if return_meta else g
+
+    barrier, ray_meta = _build_barrier(scene, stop_at_other_wall=stop_at_other_wall)
+    passable = (~barrier) & ((g == scene["bg"]) | (g == scene["fill"]))
+
+    q = scene["fill_pos"][:]
+    seen = np.zeros_like(passable, dtype=bool)
+    for r, c in q:
+        if passable[r, c]:
+            seen[r, c] = True
+    while q:
+        r, c = q.pop()
+        for rr, cc in neighbors4(r, c):
+            if 0 <= rr < h and 0 <= cc < w and passable[rr, cc] and not seen[rr, cc]:
+                seen[rr, cc] = True
+                q.append((rr, cc))
+
+    filled_mask = seen & (g == scene["bg"])
+    paint_mask = _apply_shadows(
+        filled_mask,
+        g,
+        bg=scene["bg"],
+        wall=scene["wall"],
+        fill=scene["fill"],
+        rad=scene["rad"],
+    )
+
+    out = g.copy()
+    out[paint_mask] = scene["fill"]
+
+    depth_map = np.full((h, w), -1, dtype=int)
+    radiated_mask = np.zeros_like(paint_mask, dtype=bool)
+    wall_band_mask = np.zeros_like(paint_mask, dtype=bool)
+    if scene["rad"] != (0, 0):
+        open_proj = max(_projection(r, c, scene["rad"]) for r, c in scene["endpoints"])
+        rows, cols = np.indices((h, w))
+        depth_map = rows * scene["rad"][0] + cols * scene["rad"][1] - open_proj
+        radiated_mask = paint_mask & (depth_map >= 0)
+        wall_band_mask = radiated_mask & (((depth_map // PATTERN_BLOCK) % 2) == 1)
+        out[wall_band_mask] = scene["wall"]
+
+    meta = {
+        "scene": scene,
+        "ray_meta": ray_meta,
+        "paint_mask": paint_mask.copy(),
+        "radiated_mask": radiated_mask,
+        "wall_band_mask": wall_band_mask,
+        "depth_map": depth_map,
+    }
+    return (out, meta) if return_meta else out
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Fill one member of an opposite-facing wall pair, then stop and recolor the outward corridor based on the partner sprite.
+
+    Input structure:
+    - The background is the most common color. The dominant non-background color forms at least one partial enclosure,
+      and in this combo the generator presents them as a facing pair of same-colored wall sprites.
+    - A nearby non-wall color marks the seed blob inside exactly one enclosure. Any other scattered non-wall pixels are
+      static obstacles.
+
+    Rule:
+    - Select the wall component nearest the seed as the active enclosure, flood-fill its reachable interior, and let the
+      fill radiate outward through that enclosure's opening.
+    - Trace the two boundary rays of that radiating wedge in the opening direction, but stop each ray as soon as its next
+      step would hit another wall component from the facing partner sprite instead of running to the canvas border.
+    - After obstacle shadows remove blocked cells, recolor the surviving radiated corridor with a repeating AABB pattern
+      that alternates seed-color bands and wall-color bands by depth from the opening; the enclosed interior stays seed-colored.
+
+    Key insight:
+    - The output is controlled by the relationship between the paired sprites: the gap to the opposite-facing partner sets
+      the corridor length, and depth within that finite corridor sets whether each painted band uses the seed color or the
+      wall color.
+    """
+    return _solve_core(grid, stop_at_other_wall=True)
+
+
+def _degree1_pixels(points: set[tuple[int, int]]) -> list[tuple[int, int]]:
+    pts = set(points)
+    return [(r, c) for r, c in pts if sum((rr, cc) in pts for rr, cc in neighbors8(r, c)) == 1]
+
+
+def _make_arm(depth: int, start_v: int, target_v: int, extra_steps: int, tip_12: bool = False) -> list[tuple[int, int]]:
+    sign = 1 if target_v > start_v else -1
+    n_side_steps = abs(target_v - start_v)
+    chosen_rows = []
+    if n_side_steps:
+        if tip_12:
+            chosen_rows = [2 * (i + 1) for i in range(n_side_steps)]
+            extra_steps = 0
+        else:
+            chosen_rows = [1]
+            if n_side_steps > 1:
+                chosen_rows += random.sample(range(2, depth + 1), n_side_steps - 1)
+            chosen_rows.sort()
+
+    first_row = chosen_rows[0] if chosen_rows else 1
+    extra_rows = [r for r in chosen_rows if r != first_row]
+    random.shuffle(extra_rows)
+    orthogonal_rows = set(extra_rows[:extra_steps])
+
+    pts = [(0, start_v)]
+    u, v = 0, start_v
+    for row in range(1, depth + 1):
+        u += 1
+        if row in orthogonal_rows:
+            pts.append((u, v))
+            v += sign
+        elif row in chosen_rows:
+            v += sign
+        pts.append((u, v))
+    return pts
+
+
+def _build_local_wall(rad: tuple[int, int], h: int, w: int):
+    if rad[0]:
+        max_depth = min(DEPTH_VERT[1], h - 7)
+        if max_depth < DEPTH_VERT[0]:
+            return None
+        depth = random.randint(DEPTH_VERT[0], max_depth)
+        gap = random.randint(*GAP_VERT)
+    else:
+        max_depth = min(DEPTH_HORIZ[1], w - 7)
+        if max_depth < DEPTH_HORIZ[0]:
+            return None
+        depth = random.randint(DEPTH_HORIZ[0], max_depth)
+        gap = random.randint(GAP_HORIZ[0], min(GAP_HORIZ[1], h - 1))
+
+    if gap == 5:
+        left_bottom, right_bottom = 2, 3
+    elif gap == 6:
+        left_bottom, right_bottom = 2, 4
+    else:
+        left_bottom, right_bottom = random.choice([(2, 5), (3, 4)])
+
+    bridge_extra = max(0, right_bottom - left_bottom - 1)
+    base_count = 2 * (depth + 1) + bridge_extra
+    max_extra_l = max(0, left_bottom - 1)
+    max_extra_r = max(0, gap - right_bottom - 1)
+    min_extra = max(0, WALL_PIXELS_MIN - base_count)
+    max_extra = min(max_extra_l + max_extra_r, WALL_PIXELS_MAX - base_count)
+    if min_extra > max_extra:
+        return None
+
+    extra = random.randint(min_extra, max_extra)
+    extra_l = random.randint(max(0, extra - max_extra_r), min(max_extra_l, extra))
+    extra_r = extra - extra_l
+
+    max_n_side = max(left_bottom, gap - right_bottom)
+    tip_12 = depth >= 2 * max_n_side and random.random() < TIP_12_PROB
+    left = _make_arm(depth, 0, left_bottom, extra_l, tip_12=tip_12)
+    right = _make_arm(depth, gap, right_bottom, extra_r, tip_12=tip_12)
+    pts = set(left) | set(right)
+    for v in range(left_bottom, right_bottom + 1):
+        pts.add((depth, v))
+
+    while len(pts) < WALL_PIXELS_MIN:
+        candidates = [
+            (u, v)
+            for u in range(max(0, depth - 3), depth + 1)
+            for v in range(gap + 1)
+            if (u, v) not in pts
+            and sum(
+                (uu, vv) in pts
+                for uu in range(u - 1, u + 2)
+                for vv in range(v - 1, v + 2)
+                if (uu, vv) != (u, v)
+            )
+            >= 2
+        ]
+        random.shuffle(candidates)
+        added = False
+        for p in candidates:
+            trial = pts | {p}
+            if len(trial) <= WALL_PIXELS_MAX and len(_degree1_pixels(trial)) == 2:
+                pts = trial
+                added = True
+                break
+        if not added:
+            return None
+
+    if not (WALL_PIXELS_MIN <= len(pts) <= WALL_PIXELS_MAX):
+        return None
+    if len(_degree1_pixels(pts)) != 2:
+        return None
+    return pts, depth, gap
+
+
+def _map_local(u: int, v: int, rad: tuple[int, int], anchor: tuple[int, int]) -> tuple[int, int]:
+    r0, c0 = anchor
+    if rad == (-1, 0):
+        return r0 + u, c0 + v
+    if rad == (1, 0):
+        return r0 - u, c0 + v
+    if rad == (0, -1):
+        return r0 + v, c0 + u
+    return r0 + v, c0 - u
+
+
+def _render_points(local_wall: set[tuple[int, int]], rad: tuple[int, int], anchor: tuple[int, int]) -> set[tuple[int, int]]:
+    return {_map_local(u, v, rad, anchor) for u, v in local_wall}
+
+
+def _fitting_anchors(local_wall: set[tuple[int, int]], rad: tuple[int, int], shape: tuple[int, int]) -> list[tuple[int, int]]:
+    h, w = shape
+    offsets = [_map_local(u, v, rad, (0, 0)) for u, v in local_wall]
+    row_offsets = [r for r, _ in offsets]
+    col_offsets = [c for _, c in offsets]
+    row_lo = -min(row_offsets)
+    row_hi = h - 1 - max(row_offsets)
+    col_lo = -min(col_offsets)
+    col_hi = w - 1 - max(col_offsets)
+    if row_lo > row_hi or col_lo > col_hi:
+        return []
+    return [(r, c) for r in range(row_lo, row_hi + 1) for c in range(col_lo, col_hi + 1)]
+
+
+def _place_active_anchor(rad: tuple[int, int], h: int, w: int, depth: int, gap: int):
+    if rad == (-1, 0):
+        row_lo = depth + PAIR_OPENING_GAP_MIN
+        row_hi = h - depth - ACTIVE_EDGE_MARGIN - 1
+        col_lo = 0
+        col_hi = w - gap - 1
+    elif rad == (1, 0):
+        row_lo = depth + ACTIVE_EDGE_MARGIN
+        row_hi = h - depth - PAIR_OPENING_GAP_MIN - 1
+        col_lo = 0
+        col_hi = w - gap - 1
+    elif rad == (0, -1):
+        row_lo = 0
+        row_hi = h - gap - 1
+        col_lo = depth + PAIR_OPENING_GAP_MIN
+        col_hi = w - depth - ACTIVE_EDGE_MARGIN - 1
+    else:
+        row_lo = 0
+        row_hi = h - gap - 1
+        col_lo = depth + ACTIVE_EDGE_MARGIN
+        col_hi = w - depth - PAIR_OPENING_GAP_MIN - 1
+    if row_lo > row_hi or col_lo > col_hi:
+        return None
+    return random.randint(row_lo, row_hi), random.randint(col_lo, col_hi)
+
+
+def _local_interior(wall: set[tuple[int, int]], depth: int) -> list[tuple[int, int]]:
+    by_row: dict[int, list[int]] = {}
+    for u, v in wall:
+        by_row.setdefault(u, []).append(v)
+    interior = []
+    for u in range(1, depth):
+        if u not in by_row or len(by_row[u]) < 2:
+            continue
+        lo, hi = min(by_row[u]), max(by_row[u])
+        for v in range(lo + 1, hi):
+            if (u, v) not in wall:
+                interior.append((u, v))
+    return interior
+
+
+def _grow_seed_blob(seed: tuple[int, int], interior_set: set[tuple[int, int]]) -> set[tuple[int, int]]:
+    blob = {seed}
+    target_size = random.choice(SEED_SIZE_WEIGHTS)
+    frontier = [seed]
+    while len(blob) < target_size and frontier:
+        p = frontier.pop(random.randrange(len(frontier)))
+        u, v = p
+        for q in random.sample([(u - 1, v), (u + 1, v), (u, v - 1), (u, v + 1)], 4):
+            if q in interior_set and q not in blob:
+                blob.add(q)
+                frontier.append(q)
+                if len(blob) >= target_size:
+                    break
