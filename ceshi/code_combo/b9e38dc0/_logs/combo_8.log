+import random
+
+import numpy as np
+from scipy.ndimage import distance_transform_cdt
+
+from arc_utils import components_mask, get_bg, neighbors4, neighbors8
+
+
+# Design analysis for combo D8/0 + D15/0
+# ----------------------------------------
+# a) Concrete behavior and trace
+#    The input keeps the original scene grammar: one dominant non-bg wall sprite forms a
+#    semi-enclosure, a smaller seed-color blob sits inside near the closed end, and sparse
+#    obstacle pixels may lie elsewhere. The original solver would flood all reachable bg
+#    cells with the seed color, including both the enclosed interior and the ray emitted
+#    through the opening, and it would keep the wall visible. The combo changes two
+#    rendering stages in a coupled way:
+#    1. Cells inside the enclosure are no longer painted with the seed color; they are
+#       painted with the wall color instead.
+#    2. After all flood/shadow work is finished, the wall itself is erased to background.
+#    A tiny schematic:
+#      input            original output        combo output
+#      W . W            W F W                  . . .
+#      W S W    ->      W F W          ->      . W .
+#      . . .            . F .                  . F .
+#    Here `S` is the source seed color, `W` is the border color, and `F` means "newly
+#    filled". In the combo, the interior `F` cell becomes wall-colored while the radiating
+#    cell below keeps the source color. This makes the output visually split into a
+#    wall-colored interior mass plus source-colored rays, with the original frame removed.
+#
+# b) Complexity calibration
+#    The combo stays legible because it uses only two visible recoloring roles:
+#    enclosed interior -> wall color, emitted rays -> seed color. That is stronger than a
+#    subtle local tweak yet still much simpler than introducing several new color classes.
+#    We keep the original four radiate directions, two arm-angle modes, one wall sprite,
+#    and sparse singleton obstacles. Generator validation forces both a sizable interior
+#    region and a visible surviving ray so the two color roles repeat enough inside every
+#    accepted example.
+#
+# c) Implicit-assumption audit against the original solver
+#    - "Wall = most frequent non-bg color" still holds in the input because only the
+#      output changes; the generator never adds unrelated wall-colored distractors.
+#    - The original writeback `out[filled_mask] = fill` is no longer valid because the
+#      newly reached area splits into two semantic regions. We therefore compute the full
+#      reachable set first, then separate `interior_mask` from the outward ray region by
+#      sealing the mouth between the two endpoints and flooding again.
+#    - The wall must still act as a barrier during flood-fill even though it disappears in
+#      the final rendering. Erasing it earlier would leak fill outside the intended wedge.
+#    - Shadow trimming must run before interior recoloring is finalized. Otherwise cells
+#      behind obstacles could be repainted wall-colored after they should have been removed.
+#    - Only the selected wall component near the seed may be erased. Turning every pixel of
+#      the wall color into bg would silently assume there are no unrelated same-color marks.
+#
+# d) Placement legality
+#    The generator reuses the original wall builder and anchor placement, so the wall stays
+#    in bounds, 8-connected, and has exactly two degree-1 endpoints with enough open-end
+#    margin for radiation. Seed placement stays inside the enclosure near the closed end.
+#    Obstacles are still drawn only on background cells away from the wall, which prevents
+#    overlap with the seed, wall, or future erased border.
+#
+# e) Visual observability
+#    A human can infer the combo from a few examples because three large structures are
+#    visible at once: the input frame, the output interior patch in that same frame color,
+#    and the disappearance of the frame itself. The outward beam still uses the seed color,
+#    so the output clearly distinguishes "inside the cup" from "emitted through the mouth"
+#    without any hidden dependence on color ids.
+#
+# f) Visual cleanliness
+#    Although two transformations are combined, the output is cleaner than the base task:
+#    the border layer disappears, the interior becomes a single solid color, and obstacles
+#    remain sparse. The generator rejects cases where the surviving wall-colored interior is
+#    tiny or where the visible source-colored ray becomes too short, avoiding muddled scenes.
+#
+# g) Color-change inferability
+#    The recoloring is structurally anchored. Cells that are spatially enclosed by the wall
+#    become the wall color; cells that extend outward through the opening remain the source
+#    color. Because the border itself vanishes afterward, the preserved wall color is seen
+#    only as the filled interior, giving a strong cue that the color came from the original
+#    frame rather than from an arbitrary palette permutation.
+#
+# h) Generator-side anti-degeneration check
+#    Accepted samples must satisfy all of the following:
+#    - the combo output differs from the legacy output on exactly the erased wall component
+#      plus the visible interior fill region;
+#    - at least `MIN_VISIBLE_INTERIOR` background cells become wall-colored;
+#    - at least `MIN_VISIBLE_RAY` background cells remain seed-colored outside the interior.
+#    This rules out degenerate cases where the combo collapses to pure D8 (wall erased only)
+#    or to an all-wall recolor with no visible source-colored ray.
+#
+# i) New solver assumptions introduced by the combo
+#    - The two wall endpoints must define a single mouth that can be sealed by a short
+#      segment for interior detection. The inherited wall generator guarantees that geometry.
+#    - The fill seed must lie inside the target component's pocket so the sealed flood
+#      actually identifies the interior. The generator keeps the seed near the closed end.
+#    - The interior and ray must both exist and be visually non-trivial. The generator
+#      explicitly validates counts for each region before accepting a sample.
+
+
+def _sgn(x: int) -> int:
+    return (x > 0) - (x < 0)
+
+
+def _flood_mask(passable: np.ndarray, starts: list[tuple[int, int]]) -> np.ndarray:
+    seen = np.zeros_like(passable, dtype=bool)
+    q = starts[:]
+    for r, c in q:
+        if passable[r, c]:
+            seen[r, c] = True
+    while q:
+        r, c = q.pop()
+        for rr, cc in neighbors4(r, c):
+            if 0 <= rr < passable.shape[0] and 0 <= cc < passable.shape[1] and passable[rr, cc] and not seen[rr, cc]:
+                seen[rr, cc] = True
+                q.append((rr, cc))
+    return seen
+
+
+def _seal_opening(mask: np.ndarray, endpoints: list[tuple[int, int]], rad: tuple[int, int]) -> np.ndarray:
+    """Close the wall mouth with one short segment so interior flood cannot escape outward."""
+    sealed = mask.copy()
+    if len(endpoints) < 2:
+        return sealed
+
+    if rad[0] != 0:
+        row = endpoints[0][0]
+        c0 = min(c for _, c in endpoints)
+        c1 = max(c for _, c in endpoints)
+        sealed[row, c0 : c1 + 1] = True
+        return sealed
+
+    if rad[1] != 0:
+        col = endpoints[0][1]
+        r0 = min(r for r, _ in endpoints)
+        r1 = max(r for r, _ in endpoints)
+        sealed[r0 : r1 + 1, col] = True
+        return sealed
+
+    ep0, ep1 = endpoints[:2]
+    rr, cc = ep0
+    sealed[rr, cc] = True
+    while rr != ep1[0]:
+        rr += _sgn(ep1[0] - rr)
+        sealed[rr, cc] = True
+    while cc != ep1[1]:
+        cc += _sgn(ep1[1] - cc)
+        sealed[rr, cc] = True
+    return sealed
+
+
+def _compute_state(grid: np.ndarray) -> dict:
+    g = np.array(grid, copy=True)
+    h, w = g.shape
+
+    vals = np.unique(g)
+    bg = get_bg(g)
+    non_bg = [int(v) for v in vals if int(v) != bg]
+    assert non_bg, "expected at least one non-background color"
+
+    wall = max(non_bg, key=lambda c: int((g == c).sum()))
+    wall_mask = g == wall
+    comps = [set((int(r), int(c)) for r, c in pts) for pts in components_mask(wall_mask, connectivity=8)]
+    assert comps, "expected at least one wall connected component"
+
+    other_colors = [c for c in non_bg if c != wall]
+    assert other_colors, "expected at least one non-wall color (fill color)"
+
+    wall_points = [p for comp in comps for p in comp]
+
+    def min_dist_to_wall(color: int) -> tuple[int, int]:
+        pts = [(int(r), int(c)) for r, c in zip(*np.where(g == color))]
+        best_d = 10**9
+        for r, c in pts:
+            for wr, wc in wall_points:
+                d = abs(r - wr) + abs(c - wc)
+                if d < best_d:
+                    best_d = d
+                    if best_d == 0:
+                        return 0, len(pts)
+        return best_d, len(pts)
+
+    fill_stats = {c: min_dist_to_wall(c) for c in other_colors}
+    fill = min(other_colors, key=lambda c: (fill_stats[c][0], fill_stats[c][1]))
+
+    fill_pos = [(int(r), int(c)) for r, c in zip(*np.where(g == fill))]
+    if not fill_pos:
+        empty = np.zeros_like(g, dtype=bool)
+        return {
+            "grid": g,
+            "bg": bg,
+            "wall": wall,
+            "fill": fill,
+            "fill_pos": [],
+            "comp_mask": empty,
+            "rad": (0, 0),
+            "filled_mask": empty,
+            "interior_mask": empty,
+            "ray_mask": empty,
+            "endpoints": [],
+        }
+
+    def comp_min_dist(comp: set[tuple[int, int]]) -> int:
+        best_d = 10**9
+        for r, c in fill_pos:
+            for wr, wc in comp:
+                d = abs(r - wr) + abs(c - wc)
+                if d < best_d:
+                    best_d = d
+                    if best_d == 0:
+                        return 0
+        return best_d
+
+    wall_comp = min(comps, key=lambda comp: (comp_min_dist(comp), -len(comp)))
+
+    comp_mask = np.zeros_like(wall_mask, dtype=bool)
+    for r, c in wall_comp:
+        comp_mask[r, c] = True
+
+    def comp_neighbors(r: int, c: int) -> list[tuple[int, int]]:
+        out = []
+        for rr, cc in neighbors8(r, c):
+            if 0 <= rr < h and 0 <= cc < w and comp_mask[rr, cc]:
+                out.append((rr, cc))
+        return out
+
+    endpoints = [(r, c) for r, c in wall_comp if len(comp_neighbors(r, c)) == 1]
+    assert endpoints, "expected wall component to have endpoints (degree-1 pixels)"
+
+    def outward_dir(ep: tuple[int, int]) -> tuple[tuple[int, int], bool]:
+        n1 = comp_neighbors(*ep)[0]
+        d1 = (_sgn(n1[0] - ep[0]), _sgn(n1[1] - ep[1]))
+        d_use = d1
+        is_12 = False
+        n2s = [p for p in comp_neighbors(*n1) if p != ep]
+        if n2s:
+            n2 = n2s[0]
+            d2 = (_sgn(n2[0] - n1[0]), _sgn(n2[1] - n1[1]))
+            if (d1[0] == 0) ^ (d1[1] == 0) and d2[0] != 0 and d2[1] != 0:
+                d_use = d2
+                is_12 = True
+        return (-d_use[0], -d_use[1]), is_12
+
+    out_info = [outward_dir(ep) for ep in endpoints]
+    out_dirs = [d for d, _ in out_info]
+    tip_12 = [flag for _, flag in out_info]
+
+    rad = (_sgn(sum(d[0] for d in out_dirs)), _sgn(sum(d[1] for d in out_dirs)))
+
+    barrier = comp_mask.copy()
+
+    def add_ray(start: tuple[int, int], d: tuple[int, int]) -> None:
+        rr, cc = start
+        while True:
+            rr += d[0]
+            cc += d[1]
+            if not (0 <= rr < h and 0 <= cc < w):
+                break
+            barrier[rr, cc] = True
+
+    def add_ray_12(start: tuple[int, int], d: tuple[int, int]) -> None:
+        rr, cc = start
+        step = 0
+        while True:
+            step += 1
+            if step % 2 == 1:
+                rr += d[0]
+                cc += d[1]
+            else:
+                if rad[0] != 0:
+                    rr += d[0]
+                else:
+                    cc += d[1]
+            if not (0 <= rr < h and 0 <= cc < w):
+                break
+            barrier[rr, cc] = True
+
+    for ep, d, is_12 in zip(endpoints, out_dirs, tip_12):
+        if is_12:
+            add_ray_12(ep, d)
+        else:
+            add_ray(ep, d)
+
+    passable = (~barrier) & ((g == bg) | (g == fill))
+    seen = _flood_mask(passable, fill_pos)
+    filled_mask = seen & (g == bg)
+
+    sealed_barrier = _seal_opening(barrier, endpoints, rad)
+    interior_seen = _flood_mask((~sealed_barrier) & ((g == bg) | (g == fill)), fill_pos)
+    interior_mask = interior_seen & (g == bg)
+    ray_mask = filled_mask & ~interior_mask
+
+    return {
+        "grid": g,
+        "bg": bg,
+        "wall": wall,
+        "fill": fill,
+        "fill_pos": fill_pos,
+        "comp_mask": comp_mask,
+        "rad": rad,
+        "filled_mask": filled_mask,
+        "interior_mask": interior_mask,
+        "ray_mask": ray_mask,
+        "endpoints": endpoints,
+    }
+
+
+def _apply_shadows(
+    out: np.ndarray,
+    filled_mask: np.ndarray,
+    obstacles: np.ndarray,
+    rad: tuple[int, int],
+    bg: int,
+) -> np.ndarray:
+    visible = filled_mask.copy()
+    h, w = out.shape
+
+    def shadow_process(coords: list[tuple[int, int]]) -> None:
+        started = False
+        blocked = False
+        for r, c in coords:
+            if visible[r, c]:
+                started = True
+            if started and obstacles[r, c]:
+                blocked = True
+                continue
+            if blocked and visible[r, c]:
+                out[r, c] = bg
+                visible[r, c] = False
+
+    if rad != (0, 0):
+        dr, dc = rad
+        if dr != 0 and dc == 0:
+            for c in range(w):
+                rows = range(h) if dr > 0 else range(h - 1, -1, -1)
+                shadow_process([(r, c) for r in rows])
+        elif dc != 0 and dr == 0:
+            for r in range(h):
+                cols = range(w) if dc > 0 else range(w - 1, -1, -1)
+                shadow_process([(r, c) for c in cols])
+        else:
+            if dr == dc:
+                for k in range(-(w - 1), h):
+                    coords = [(r, r - k) for r in range(h) if 0 <= r - k < w]
+                    coords.sort(key=lambda rc: rc[0], reverse=(dr < 0))
+                    shadow_process(coords)
+            else:
+                for k in range(h + w - 1):
+                    coords = [(r, k - r) for r in range(h) if 0 <= k - r < w]
+                    coords.sort(key=lambda rc: rc[0], reverse=(dr < 0))
+                    shadow_process(coords)
+    return visible
+
+
+def _solve_core(
+    grid: np.ndarray,
+    *,
+    fill_interior_with_wall: bool,
+    erase_wall: bool,
+    return_meta: bool = False,
+) -> np.ndarray | tuple[np.ndarray, dict]:
+    state = _compute_state(grid)
+    g = state["grid"]
+    if not state["fill_pos"]:
+        return (g, state) if return_meta else g
+
+    out = g.copy()
+    out[state["filled_mask"]] = state["fill"]
+
+    obstacles = (g != state["bg"]) & (g != state["fill"]) & (g != state["wall"])
+    visible_filled = _apply_shadows(out, state["filled_mask"], obstacles, state["rad"], state["bg"])
+    visible_interior = state["interior_mask"] & visible_filled
+    visible_ray = visible_filled & ~state["interior_mask"]
+
+    if fill_interior_with_wall:
+        out[visible_interior] = state["wall"]
+
+    if erase_wall:
+        out[state["comp_mask"]] = state["bg"]
+
+    meta = dict(state)
+    meta["visible_filled_mask"] = visible_filled
+    meta["visible_interior_mask"] = visible_interior
+    meta["visible_ray_mask"] = visible_ray
+    return (out, meta) if return_meta else out
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Fill a semi-enclosed pocket, emit the source color through the opening, then erase the enclosing border.
+
+    Input structure:
+    - The most common color is background. The dominant non-background color is a partial wall component with two endpoints and one open side.
+    - A smaller seed blob of another color lies inside that wall near its closed end; any other non-background pixels are obstacles.
+
+    Rule:
+    - Use the wall geometry to flood all reachable background cells from the seed, but split the reached area into two regions: enclosed interior cells become the wall color, while cells that extend outward through the opening stay in the seed color.
+    - After obstacle shadows have removed blocked downstream fill, erase the wall component itself to background, leaving only the recolored interior, the seed-colored rays, and unchanged obstacles.
+
+    Key insight: The wall still determines both the interior pocket and the outward radiation corridor, but the final picture hides that frame; solving the task requires using the wall twice, first as geometry and then as the color donor that replaces the interior before the wall disappears.
+    """
+    return _solve_core(grid, fill_interior_with_wall=True, erase_wall=True)
+
+
+# --------------- generator ---------------
+
+# Canvas size bounds
+GRID_H_VERT = (11, 18)
+GRID_H_HORIZ = (8, 18)
+GRID_W = (15, 19)
+
+# Wall geometry
+WALL_PIXELS_MIN = 17
+WALL_PIXELS_MAX = 25
+DEPTH_VERT = (5, 10)
+DEPTH_HORIZ = (6, 8)
+GAP_VERT = (6, 7)
+GAP_HORIZ = (5, 7)
+TIP_12_PROB = 0.5
+
+# Placement margins
+OPEN_END_MARGIN = 3
+
+# Fill seed
+SEED_SIZE_WEIGHTS = [1, 1, 1, 1, 2, 2, 3, 4, 5, 6]
+SEED_DEPTH_LOOKBACK = 3
+
+# Obstacles
+MAX_OBSTACLES = 5
+OBSTACLE_IN_FILL_PROB = 0.65
+OBSTACLE_MIN_SEP = 2
+
+# Validation
+MIN_TOTAL_FILLED = 20
+MIN_VISIBLE_INTERIOR = 10
+MIN_VISIBLE_RAY = 6
+PALETTE_SIZE = (3, 5)
+GEN_RETRIES = 300
+
+
+def _degree1_pixels(points):
+    pts = set(points)
+    return [(r, c) for r, c in pts if sum((rr, cc) in pts for rr, cc in neighbors8(r, c)) == 1]
+
+
+def _make_arm(depth, start_v, target_v, extra_steps, tip_12=False):
+    sign = 1 if target_v > start_v else -1
+    n_side_steps = abs(target_v - start_v)
+    chosen_rows = []
+    if n_side_steps:
+        if tip_12:
+            chosen_rows = [2 * (i + 1) for i in range(n_side_steps)]
+            extra_steps = 0
+        else:
+            chosen_rows = [1]
+            if n_side_steps > 1:
+                chosen_rows += random.sample(range(2, depth + 1), n_side_steps - 1)
+            chosen_rows.sort()
+
+    first_row = chosen_rows[0] if chosen_rows else 1
+    extra_rows = [r for r in chosen_rows if r != first_row]
+    random.shuffle(extra_rows)
+    orthogonal_rows = set(extra_rows[:extra_steps])
+
+    pts = [(0, start_v)]
+    u, v = 0, start_v
+    for row in range(1, depth + 1):
+        u += 1
+        if row in orthogonal_rows:
+            pts.append((u, v))
+            v += sign
+        elif row in chosen_rows:
+            v += sign
+        pts.append((u, v))
+    return pts
+
+
+def _build_local_wall(rad, h, w):
+    if rad[0]:
+        max_depth = min(DEPTH_VERT[1], h - 6)
+        if max_depth < DEPTH_VERT[0]:
+            return None
+        depth = random.randint(DEPTH_VERT[0], max_depth)
+        gap = random.randint(*GAP_VERT)
+    else:
+        depth = random.randint(DEPTH_HORIZ[0], min(DEPTH_HORIZ[1], w - 6))
+        gap = random.randint(GAP_HORIZ[0], min(GAP_HORIZ[1], h - 1))
+
+    if gap == 5:
+        left_bottom, right_bottom = 2, 3
+    elif gap == 6:
+        left_bottom, right_bottom = 2, 4
+    else:
+        left_bottom, right_bottom = random.choice([(2, 5), (3, 4)])
+
+    bridge_extra = max(0, right_bottom - left_bottom - 1)
+    base_count = 2 * (depth + 1) + bridge_extra
+    max_extra_l = max(0, left_bottom - 1)
+    max_extra_r = max(0, gap - right_bottom - 1)
+    min_extra = max(0, WALL_PIXELS_MIN - base_count)
+    max_extra = min(max_extra_l + max_extra_r, WALL_PIXELS_MAX - base_count)
+    if min_extra > max_extra:
+        return None
+
+    extra = random.randint(min_extra, max_extra)
+    extra_l = random.randint(max(0, extra - max_extra_r), min(max_extra_l, extra))
+    extra_r = extra - extra_l
+
+    max_n_side = max(left_bottom, gap - right_bottom)
+    tip_12 = depth >= 2 * max_n_side and random.random() < TIP_12_PROB
+    left = _make_arm(depth, 0, left_bottom, extra_l, tip_12=tip_12)
+    right = _make_arm(depth, gap, right_bottom, extra_r, tip_12=tip_12)
+    pts = set(left) | set(right)
+    for v in range(left_bottom, right_bottom + 1):
+        pts.add((depth, v))
+
+    while len(pts) < WALL_PIXELS_MIN:
+        candidates = [
+            (u, v)
+            for u in range(max(0, depth - 3), depth + 1)
+            for v in range(gap + 1)
+            if (u, v) not in pts
+            and sum(
+                (uu, vv) in pts
+                for uu in range(u - 1, u + 2)
+                for vv in range(v - 1, v + 2)
+                if (uu, vv) != (u, v)
+            ) >= 2
+        ]
+        random.shuffle(candidates)
+        added = False
+        for p in candidates:
+            trial = pts | {p}
+            if len(trial) <= WALL_PIXELS_MAX and len(_degree1_pixels(trial)) == 2:
+                pts = trial
+                added = True
+                break
+        if not added:
+            return None
+
+    if not (WALL_PIXELS_MIN <= len(pts) <= WALL_PIXELS_MAX) or len(_degree1_pixels(pts)) != 2:
+        return None
+    return pts, depth, gap
+
+
+def _map_local(u, v, rad, anchor):
+    r0, c0 = anchor
+    if rad == (-1, 0):
+        return r0 + u, c0 + v
+    if rad == (1, 0):
+        return r0 - u, c0 + v
+    if rad == (0, -1):
+        return r0 + v, c0 + u
+    return r0 + v, c0 - u
+
+
+def _place_anchor(rad, h, w, depth, gap):
+    if rad == (-1, 0):
+        return random.randint(OPEN_END_MARGIN, h - depth - 3), random.randint(0, w - gap - 1)
+    if rad == (1, 0):
+        return random.randint(depth + 2, h - 4), random.randint(0, w - gap - 1)
+    if rad == (0, -1):
+        return random.randint(0, h - gap - 1), random.randint(OPEN_END_MARGIN, w - depth - 3)
+    return random.randint(0, h - gap - 1), random.randint(depth + 2, w - 4)
+
+
+def _local_interior(wall, depth, gap):
+    by_row = {}
+    for u, v in wall:
+        by_row.setdefault(u, []).append(v)
+    interior = []
+    for u in range(1, depth):
+        if u not in by_row or len(by_row[u]) < 2:
+            continue
+        lo, hi = min(by_row[u]), max(by_row[u])
+        for v in range(lo + 1, hi):
+            if (u, v) not in wall:
+                interior.append((u, v))
+    return interior
+
+
+def _grow_seed_blob(seed, interior_set):
+    blob = {seed}
+    target_size = random.choice(SEED_SIZE_WEIGHTS)
+    frontier = [seed]
+    while len(blob) < target_size and frontier:
+        p = frontier.pop(random.randrange(len(frontier)))
+        u, v = p
+        for q in random.sample([(u - 1, v), (u + 1, v), (u, v - 1), (u, v + 1)], 4):
+            if q in interior_set and q not in blob:
+                blob.add(q)
+                frontier.append(q)
+                if len(blob) >= target_size:
