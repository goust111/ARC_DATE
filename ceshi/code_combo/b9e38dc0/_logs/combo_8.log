+    if not np.array_equal(diff_vs_legacy, expected_diff):
+        return None
+    if not np.array_equal(diff_vs_d8, visible_interior):
+        return None
+    if int(combo_meta["comp_mask"].sum()) < WALL_PIXELS_MIN:
+        return None
+    if not np.any((combo_out == wall_color) & (grid == bg)):
