+    try:
+        legacy_out, legacy_meta = _solve_core(
+            grid,
+            fill_interior_with_wall=False,
+            erase_wall=False,
+            return_meta=True,
+        )
+        d8_out, d8_meta = _solve_core(
+            grid,
+            fill_interior_with_wall=False,
+            erase_wall=True,
+            return_meta=True,
+        )
+        combo_out, combo_meta = _solve_core(
+            grid,
+            fill_interior_with_wall=True,
+            erase_wall=True,
+            return_meta=True,
