   467	def _trace_diag_mover(start: tuple[int, int], d: tuple[int, int], sprite_mask: np.ndarray) -> dict:
   468	    h, w = sprite_mask.shape
   469	    cur = (int(start[0]), int(start[1]))
   470	    dr, dc = int(d[0]), int(d[1])
   471	    path: list[tuple[int, int]] = []
   472	    reflections = 0
   473	    seen = set()
   474	
   475	    while True:
   476	        state = (cur[0], cur[1], dr, dc)
   477	        if state in seen:
   478	            return {"ok": False, "end": cur, "path": path, "reflections": reflections}
   479	        seen.add(state)
   480	
   481	        nr, nc = cur[0] + dr, cur[1] + dc
   482	        if not (0 <= nr < h and 0 <= nc < w):
   483	            return {"ok": True, "end": cur, "path": path, "reflections": reflections}
   484	
   485	        if sprite_mask[nr, nc]:
   486	            dr, dc = -dr, -dc
   487	            reflections += 1
   488	            continue
   489	
   490	        cur = (int(nr), int(nc))
   491	        path.append(cur)
   492	
   493	        side_flip = 0
   494	        vr = nr + dr
   495	        if 0 <= vr < h and sprite_mask[vr, nc]:
   496	            dr = -dr
   497	            side_flip += 1
   498	        hc = nc + dc
   499	        if 0 <= hc < w and sprite_mask[nr, hc]:
   500	            dc = -dc
   501	            side_flip += 1
   502	        reflections += side_flip
