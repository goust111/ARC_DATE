   452	        side = _sgn(c - open_c)
   453	        if side == 0:
   454	            side = _sgn(c - center_c)
   455	        if side == 0:
   456	            side = 1
   457	        return int(rad[0]), int(side)
   458	
   459	    side = _sgn(r - open_r)
   460	    if side == 0:
   461	        side = _sgn(r - center_r)
   462	    if side == 0:
   463	        side = 1
   464	    return int(side), int(rad[1])
