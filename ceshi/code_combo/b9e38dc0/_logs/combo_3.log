+# Combo variant of b9e38dc0 (index 3)
+# combo_spec: D2/0+D7/1
+# Name: 对角线移动+障碍反射
+
+import random
+import sys
+
+import numpy as np
+from scipy.ndimage import distance_transform_cdt
+
+for _p in (
+    "/home/lixinyu/snap/new/solvers",
+    "/home/lixinyu/snap/new/arc2_solver_select",
+):
+    if _p not in sys.path:
+        sys.path.append(_p)
