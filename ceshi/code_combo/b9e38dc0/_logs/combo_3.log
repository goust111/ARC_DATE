   114	def _make_arm(depth, start_v, target_v, extra_steps, tip_12=False):
   115	    sign = 1 if target_v > start_v else -1
   116	    n_side_steps = abs(target_v - start_v)
   117	    chosen_rows = []
   118	    if n_side_steps:
   119	        if tip_12:
   120	            chosen_rows = [2 * (i + 1) for i in range(n_side_steps)]
   121	            extra_steps = 0
   122	        else:
   123	            chosen_rows = [1]
   124	            if n_side_steps > 1:
   125	                chosen_rows += random.sample(range(2, depth + 1), n_side_steps - 1)
   126	            chosen_rows.sort()
   127	
   128	    first_row = chosen_rows[0] if chosen_rows else 1
   129	    extra_rows = [r for r in chosen_rows if r != first_row]
   130	    random.shuffle(extra_rows)
   131	    orthogonal_rows = set(extra_rows[:extra_steps])
   132	
   133	    pts = [(0, start_v)]
   134	    u, v = 0, start_v
   135	    for row in range(1, depth + 1):
   136	        u += 1
   137	        if row in orthogonal_rows:
   138	            pts.append((u, v))
   139	            v += sign
   140	        elif row in chosen_rows:
   141	            v += sign
   142	        pts.append((u, v))
   143	    return pts
