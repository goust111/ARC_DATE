+from arc_utils import neighbors4, neighbors8, components_mask, get_bg
+
+
+# Design analysis
+# a) 具体化与行为追踪:
+#    - 第一阶段保留原题主体: 墙色形成一个半包围漏斗, seed 在内部, 先按端点推导出的开口方向
+#      进行 flood-fill, 得到 wall + fill 的 stage1 sprite.
+#    - 改动发生在第二阶段: 其余非背景单像素不再沿 `rad` 直线走, 而是沿“带有 outward 分量的
+#      45 度对角线”走. 具体地, 若 `rad` 向右, 则 mover 位于开口中线之上时走右上, 位于其下时
+#      走右下; 其余三个 `rad` 方向类推. 这样 diagonal 的一个分量仍来自 opening, 另一个分量
+#      由 mover 相对 opening 的位置决定.
+#    - 反射规则取 142ca369 的光线语义: mover 每步尝试走一个对角格. 若对角目标本身是 sprite,
+#      视作正撞角点, 两轴都反向; 若走到新格后发现前方紧贴 sprite 的是水平面, 则翻转垂直分量;
+#      紧贴的是垂直面, 则翻转水平分量. 因而路径可能在 sprite 外沿折返多次.
+#    - 小例子: `rad=(0,1)` 时, 原 D7/1 会让 mover 一律向右直走, 撞到 sprite 后转成纯上/下.
+#      现在位于 opening 中线上方的 mover 先走右上; 若它沿途在右上新格的正上方贴到 sprite,
+#      则 `dr` 反号, 后续改为右下. 同一个 sprite 可同时让上方 mover 走右上、下方 mover 走右下,
+#      视觉上能直接看出“相对位置 -> 对角朝向”的依赖.
+# b) 复杂度校准:
+#    - 第二阶段只引入两个自由度: 初始对角朝向的上下/左右分支, 以及由 sprite 边界触发的轴翻转.
+#      不引入颜色继承、速度变化、可穿透障碍等额外机制.
+#    - 每个样例固定只放 2 个 mover, 并强制它们落在 opening 中线两侧, 这样解题者能在单图中看到
+#      两种对角分支; 同时至少一个 mover 必须发生反射, 让 D7 行为也必然可见.
+# c) 隐式假设审查:
+#    - 原题 `shadow_process` 假设“其余像素静止并削掉 fill”, 在融合后完全失效, 必须删去.
+#    - 原 D7/1 的 mover 追踪假设路径是 cardinal; 在这里必须改成 diagonal 状态机, 否则无法表达
+#      D2/0 的 45 度移动.
+#    - fill 色仍通过“最接近墙的非墙色”识别. 因此 generator 必须保证 mover 离墙至少 3 格, 否则
+#      solver 可能误把 mover 颜色当 seed.
+#    - 反射逻辑依赖 stage1 sprite 是连续实体, 且 mover 不会一开始就放在 sprite 内/未来 fill 区.
+#      generator 会先运行 stage1 oracle, 只在 sprite 外背景上挑选 mover 起点.
+# d) 放置合法性:
+#    - wall、seed 的构造沿用原题数值约束, 保证单个 8 连通墙组件、2 个端点、17-25 像素规模.
+#    - mover 候选必须满足: 在 stage1 sprite 外、离墙足够远、路径能到达边界、不与另一 mover 的
+#      起点/路径/终点重叠.
+#    - 因为反射会改变方向, generator 用与 solver 相同的追踪器预演整条轨迹后再落点.
+# e) 视觉可观察性:
+#    - 单图内固定两枚 mover, 一枚在 opening 中线一侧, 另一枚在另一侧, 输出中它们会去往不同的
+#      对角边界位置; 至少一枚还会在 sprite 外沿折返. 这让“对角方向”和“反射”都能从 2-4 题目对
+#      中被人眼归纳出来.
+#    - 规则只依赖可见几何关系: mover 相对 opening 的上/下或左/右位置, 以及 sprite 边界. 不依赖
+#      颜色数值排序或隐藏标签.
+# f) 可视化整洁度:
+#    - 输出仍只显示“起点消失、终点出现”; 不绘制轨迹, 避免和 fill 区大面积叠色.
+#    - 两个 mover 的 footprint 禁止重叠, 终点也不共享, 使结果保持干净.
+# g) 变化的可推断性:
+#    - mover 颜色保持不变, 颜色只用于身份跟踪.
+#    - 变化由空间关系解释: 看开口方向确定 outward 分量, 再看 mover 在中线哪一侧确定另一轴分量.
+# 9) main() 的新隐式假设:
+#    - `opening_mid` 可由墙端点定义, 且 generator 会避免把 mover 恰好放在该中线上, 以免对角分支
+#      出现 `sgn == 0` 的退化情况.
+#    - diagonal 反射追踪允许循环检测; 若某个候选会在 sprite 外陷入周期, generator 直接丢弃.
+#    - 第二阶段默认 mover 为孤立像素. generator 只放单像素 mover, 从而 `main()` 无需再做组件级配对.
+
+
+# -- Configuration constants --------------------------------------------------
+GRID_H_VERT = (11, 18)
+GRID_H_HORIZ = (8, 18)
+GRID_W = (15, 19)
+
+WALL_PIXELS_MIN = 17
+WALL_PIXELS_MAX = 25
+DEPTH_VERT = (5, 10)
+DEPTH_HORIZ = (6, 8)
+GAP_VERT = (6, 7)
+GAP_HORIZ = (5, 7)
+TIP_12_PROB = 0.5
+
+OPEN_END_MARGIN = 3
+
+SEED_SIZE_WEIGHTS = [1, 1, 1, 1, 2, 2, 3, 4, 5, 6]
+SEED_DEPTH_LOOKBACK = 3
+
+MOVERS_REQUIRED = 2
+MOVER_MIN_TRAVEL = 3
+MOVER_MIN_WALL_DIST = 3
+REFLECT_REQUIRED = 1
+
+MIN_NEW_FILL = 20
+PALETTE_SIZE = (5, 5)
+GEN_RETRIES = 500
+
+
+def _sgn(x: float) -> int:
+    return int((x > 0) - (x < 0))
+
+
+def _degree1_pixels(points):
+    pts = set(points)
+    return [
+        (r, c)
+        for r, c in pts
+        if sum((rr, cc) in pts for rr, cc in neighbors8(r, c)) == 1
+    ]
+
+
+def _make_arm(depth, start_v, target_v, extra_steps, tip_12=False):
+    sign = 1 if target_v > start_v else -1
+    n_side_steps = abs(target_v - start_v)
+    chosen_rows = []
+    if n_side_steps:
+        if tip_12:
+            chosen_rows = [2 * (i + 1) for i in range(n_side_steps)]
+            extra_steps = 0
+        else:
+            chosen_rows = [1]
+            if n_side_steps > 1:
+                chosen_rows += random.sample(range(2, depth + 1), n_side_steps - 1)
+            chosen_rows.sort()
+
+    first_row = chosen_rows[0] if chosen_rows else 1
+    extra_rows = [r for r in chosen_rows if r != first_row]
+    random.shuffle(extra_rows)
+    orthogonal_rows = set(extra_rows[:extra_steps])
+
+    pts = [(0, start_v)]
+    u, v = 0, start_v
+    for row in range(1, depth + 1):
+        u += 1
+        if row in orthogonal_rows:
+            pts.append((u, v))
+            v += sign
+        elif row in chosen_rows:
+            v += sign
+        pts.append((u, v))
+    return pts
+
+
+def _build_local_wall(rad, h, w):
+    if rad[0]:
+        max_depth = min(DEPTH_VERT[1], h - 6)
+        if max_depth < DEPTH_VERT[0]:
+            return None
+        depth = random.randint(DEPTH_VERT[0], max_depth)
+        gap = random.randint(*GAP_VERT)
+    else:
+        depth = random.randint(DEPTH_HORIZ[0], min(DEPTH_HORIZ[1], w - 6))
+        gap = random.randint(GAP_HORIZ[0], min(GAP_HORIZ[1], h - 1))
+
+    if gap == 5:
+        left_bottom, right_bottom = 2, 3
+    elif gap == 6:
+        left_bottom, right_bottom = 2, 4
+    else:
+        left_bottom, right_bottom = random.choice([(2, 5), (3, 4)])
+
+    bridge_extra = max(0, right_bottom - left_bottom - 1)
+    base_count = 2 * (depth + 1) + bridge_extra
+    max_extra_l = max(0, left_bottom - 1)
+    max_extra_r = max(0, gap - right_bottom - 1)
+    min_extra = max(0, WALL_PIXELS_MIN - base_count)
+    max_extra = min(max_extra_l + max_extra_r, WALL_PIXELS_MAX - base_count)
+    if min_extra > max_extra:
+        return None
+
+    extra = random.randint(min_extra, max_extra)
+    extra_l = random.randint(max(0, extra - max_extra_r), min(max_extra_l, extra))
+    extra_r = extra - extra_l
+
+    max_n_side = max(left_bottom, gap - right_bottom)
+    tip_12 = depth >= 2 * max_n_side and random.random() < TIP_12_PROB
+    left = _make_arm(depth, 0, left_bottom, extra_l, tip_12=tip_12)
+    right = _make_arm(depth, gap, right_bottom, extra_r, tip_12=tip_12)
+    pts = set(left) | set(right)
+    for v in range(left_bottom, right_bottom + 1):
+        pts.add((depth, v))
+
+    while len(pts) < WALL_PIXELS_MIN:
+        candidates = [
+            (u, v)
+            for u in range(max(0, depth - 3), depth + 1)
+            for v in range(gap + 1)
+            if (u, v) not in pts
+            and sum(
+                (uu, vv) in pts
+                for uu in range(u - 1, u + 2)
+                for vv in range(v - 1, v + 2)
+                if (uu, vv) != (u, v)
+            ) >= 2
+        ]
+        random.shuffle(candidates)
+        added = False
+        for p in candidates:
+            trial = pts | {p}
+            if len(trial) <= WALL_PIXELS_MAX and len(_degree1_pixels(trial)) == 2:
+                pts = trial
+                added = True
+                break
+        if not added:
+            return None
+
+    if not (WALL_PIXELS_MIN <= len(pts) <= WALL_PIXELS_MAX):
+        return None
+    if len(_degree1_pixels(pts)) != 2:
+        return None
+    return pts, depth, gap
+
+
+def _map_local(u, v, rad, anchor):
+    r0, c0 = anchor
+    if rad == (-1, 0):
+        return r0 + u, c0 + v
+    if rad == (1, 0):
+        return r0 - u, c0 + v
+    if rad == (0, -1):
+        return r0 + v, c0 + u
+    return r0 + v, c0 - u
+
+
+def _place_anchor(rad, h, w, depth, gap):
+    if rad == (-1, 0):
+        return random.randint(OPEN_END_MARGIN, h - depth - 3), random.randint(0, w - gap - 1)
+    if rad == (1, 0):
+        return random.randint(depth + 2, h - 4), random.randint(0, w - gap - 1)
+    if rad == (0, -1):
+        return random.randint(0, h - gap - 1), random.randint(OPEN_END_MARGIN, w - depth - 3)
+    return random.randint(0, h - gap - 1), random.randint(depth + 2, w - 4)
+
+
+def _local_interior(wall, depth, gap):
+    by_row = {}
+    for u, v in wall:
+        by_row.setdefault(u, []).append(v)
+    interior = []
+    for u in range(1, depth):
+        if u not in by_row or len(by_row[u]) < 2:
+            continue
+        lo, hi = min(by_row[u]), max(by_row[u])
+        for v in range(lo + 1, hi):
+            if (u, v) not in wall:
+                interior.append((u, v))
+    return interior
+
+
+def _grow_seed_blob(seed, interior_set):
+    blob = {seed}
+    target_size = random.choice(SEED_SIZE_WEIGHTS)
+    frontier = [seed]
+    while len(blob) < target_size and frontier:
+        p = frontier.pop(random.randrange(len(frontier)))
+        u, v = p
+        for q in random.sample([(u - 1, v), (u + 1, v), (u, v - 1), (u, v + 1)], 4):
+            if q in interior_set and q not in blob:
+                blob.add(q)
+                frontier.append(q)
+                if len(blob) >= target_size:
+                    break
+    return blob
+
+
+def _touches_border(mask):
+    return bool(mask[0, :].any() or mask[-1, :].any() or mask[:, 0].any() or mask[:, -1].any())
+
+
+def _compute_stage1(grid: np.ndarray) -> dict:
+    g = np.array(grid, copy=True)
+    h, w = g.shape
+    bg = int(get_bg(g))
+
+    vals = np.unique(g)
+    non_bg = [int(v) for v in vals if int(v) != bg]
+    assert non_bg, "expected at least one non-background color"
+
+    wall = max(non_bg, key=lambda c: int((g == c).sum()))
+    wall_mask = g == wall
+    comps = [
+        set((int(r), int(c)) for r, c in pts)
+        for pts in components_mask(wall_mask, connectivity=8)
+    ]
+    assert comps, "expected at least one wall connected component"
+
+    other_colors = [c for c in non_bg if c != wall]
+    assert other_colors, "expected at least one non-wall color"
+
+    wall_points = [p for comp in comps for p in comp]
+
+    def min_dist_to_wall(color: int) -> tuple[int, int]:
+        pts = [(int(r), int(c)) for r, c in zip(*np.where(g == color))]
+        best_d = 10**9
+        for r, c in pts:
+            for wr, wc in wall_points:
+                d = abs(r - wr) + abs(c - wc)
+                if d < best_d:
+                    best_d = d
+                    if best_d == 0:
+                        return 0, len(pts)
+        return best_d, len(pts)
+
+    fill = min(other_colors, key=lambda c: (min_dist_to_wall(c)[0], min_dist_to_wall(c)[1]))
+    fill_pos = [(int(r), int(c)) for r, c in zip(*np.where(g == fill))]
+    if not fill_pos:
+        return {
+            "out": g,
+            "filled_mask": np.zeros_like(g, dtype=bool),
+            "sprite_mask": wall_mask.copy(),
+            "bg": bg,
+            "wall": wall,
+            "fill": fill,
+            "rad": (0, 0),
+            "wall_comp_mask": wall_mask.copy(),
+            "opening_mid": (0.0, 0.0),
+            "sprite_center": (0.0, 0.0),
+        }
+
+    def comp_min_dist(comp: set[tuple[int, int]]) -> int:
+        best_d = 10**9
+        for r, c in fill_pos:
+            for wr, wc in comp:
+                d = abs(r - wr) + abs(c - wc)
+                if d < best_d:
+                    best_d = d
+                    if best_d == 0:
+                        return 0
+        return best_d
+
+    wall_comp = min(comps, key=lambda comp: (comp_min_dist(comp), -len(comp)))
+    comp_mask = np.zeros_like(wall_mask, dtype=bool)
+    for r, c in wall_comp:
+        comp_mask[r, c] = True
+
+    def comp_neighbors(r: int, c: int) -> list[tuple[int, int]]:
+        return [
+            (rr, cc)
+            for rr, cc in neighbors8(r, c)
+            if 0 <= rr < h and 0 <= cc < w and comp_mask[rr, cc]
+        ]
+
+    endpoints = [(r, c) for r, c in wall_comp if len(comp_neighbors(r, c)) == 1]
+    assert endpoints, "expected wall component to have endpoints"
+
+    def outward_dir(ep: tuple[int, int]) -> tuple[tuple[int, int], bool]:
+        n1 = comp_neighbors(*ep)[0]
+        d1 = (_sgn(n1[0] - ep[0]), _sgn(n1[1] - ep[1]))
+        d_use = d1
+        is_12 = False
+        n2s = [p for p in comp_neighbors(*n1) if p != ep]
+        if n2s:
+            n2 = n2s[0]
+            d2 = (_sgn(n2[0] - n1[0]), _sgn(n2[1] - n1[1]))
+            if (d1[0] == 0) ^ (d1[1] == 0):
+                if d2[0] != 0 and d2[1] != 0:
+                    d_use = d2
+                    is_12 = True
+        return (-d_use[0], -d_use[1]), is_12
+
+    out_info = [outward_dir(ep) for ep in endpoints]
+    out_dirs = [d for d, _ in out_info]
+    tip_12 = [flag for _, flag in out_info]
+    rad = (_sgn(sum(d[0] for d in out_dirs)), _sgn(sum(d[1] for d in out_dirs)))
+
+    barrier = comp_mask.copy()
+
+    def add_ray(start: tuple[int, int], d: tuple[int, int]) -> None:
+        rr, cc = start
+        while True:
+            rr += d[0]
+            cc += d[1]
+            if not (0 <= rr < h and 0 <= cc < w):
+                break
+            barrier[rr, cc] = True
+
+    def add_ray_12(start: tuple[int, int], d: tuple[int, int]) -> None:
+        rr, cc = start
+        step = 0
+        while True:
+            step += 1
+            if step % 2 == 1:
+                rr += d[0]
+                cc += d[1]
+            else:
+                if rad[0] != 0:
+                    rr += d[0]
+                else:
+                    cc += d[1]
+            if not (0 <= rr < h and 0 <= cc < w):
+                break
+            barrier[rr, cc] = True
+
+    for ep, d, is_12 in zip(endpoints, out_dirs, tip_12):
+        if is_12:
+            add_ray_12(ep, d)
+        else:
+            add_ray(ep, d)
+
+    passable = (~barrier) & ((g == bg) | (g == fill))
+    q = fill_pos[:]
+    seen = np.zeros_like(passable, dtype=bool)
+    for r, c in q:
+        if passable[r, c]:
+            seen[r, c] = True
+
+    while q:
+        r, c = q.pop()
+        for rr, cc in neighbors4(r, c):
+            if 0 <= rr < h and 0 <= cc < w and passable[rr, cc] and not seen[rr, cc]:
+                seen[rr, cc] = True
+                q.append((rr, cc))
+
+    filled_mask = seen & (g == bg)
+    out = g.copy()
+    out[filled_mask] = fill
+    sprite_mask = comp_mask | (out == fill)
+
+    endpoint_mid = (
+        sum(r for r, _ in endpoints) / len(endpoints),
+        sum(c for _, c in endpoints) / len(endpoints),
+    )
+    sprite_rows, sprite_cols = np.where(sprite_mask)
+    sprite_center = (
+        float(np.mean(sprite_rows)) if len(sprite_rows) else endpoint_mid[0],
+        float(np.mean(sprite_cols)) if len(sprite_cols) else endpoint_mid[1],
+    )
+
+    return {
+        "out": out,
+        "filled_mask": filled_mask,
+        "sprite_mask": sprite_mask,
+        "bg": bg,
+        "wall": wall,
+        "fill": fill,
+        "rad": rad,
+        "wall_comp_mask": comp_mask,
+        "opening_mid": endpoint_mid,
+        "sprite_center": sprite_center,
+    }
+
+
+def _mover_dir(start: tuple[int, int], stage1_info: dict) -> tuple[int, int]:
+    rad = tuple(stage1_info["rad"])
+    open_r, open_c = stage1_info["opening_mid"]
+    center_r, center_c = stage1_info["sprite_center"]
+    r, c = start
+
+    if rad[0] != 0:
+        side = _sgn(c - open_c)
+        if side == 0:
+            side = _sgn(c - center_c)
+        if side == 0:
+            side = 1
+        return int(rad[0]), int(side)
+
+    side = _sgn(r - open_r)
+    if side == 0:
+        side = _sgn(r - center_r)
+    if side == 0:
+        side = 1
+    return int(side), int(rad[1])
+
+
+def _trace_diag_mover(start: tuple[int, int], d: tuple[int, int], sprite_mask: np.ndarray) -> dict:
+    h, w = sprite_mask.shape
+    cur = (int(start[0]), int(start[1]))
+    dr, dc = int(d[0]), int(d[1])
+    path: list[tuple[int, int]] = []
+    reflections = 0
+    seen = set()
+
+    while True:
+        state = (cur[0], cur[1], dr, dc)
+        if state in seen:
+            return {"ok": False, "end": cur, "path": path, "reflections": reflections}
+        seen.add(state)
+
+        nr, nc = cur[0] + dr, cur[1] + dc
+        if not (0 <= nr < h and 0 <= nc < w):
+            return {"ok": True, "end": cur, "path": path, "reflections": reflections}
+
+        if sprite_mask[nr, nc]:
+            dr, dc = -dr, -dc
+            reflections += 1
+            continue
+
+        cur = (int(nr), int(nc))
+        path.append(cur)
+
+        side_flip = 0
+        vr = nr + dr
+        if 0 <= vr < h and sprite_mask[vr, nc]:
+            dr = -dr
+            side_flip += 1
+        hc = nc + dc
+        if 0 <= hc < w and sprite_mask[nr, hc]:
+            dc = -dc
+            side_flip += 1
+        reflections += side_flip
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Fill the funnel region, then move isolated pixels along diagonal outward rays that can reflect off the filled sprite.
+
+    Input structure:
+    - The most common color is background. The dominant non-background color is a wall component forming a partial enclosure.
+    - A second color near that wall is the fill seed inside the enclosure. Any remaining non-background singleton pixels are movers placed outside the eventual wall+fill sprite.
+
+    Rule:
+    - First solve the original fill stage: flood the reachable enclosed region and outward radiate zone using the wall endpoints to infer the opening direction.
+    - Then erase each mover from its source cell and send it along a 45 degree ray whose outward component matches the opening direction, while the other component depends on which side of the opening midpoint the mover starts on.
+    - If a mover diagonally hits the stage1 sprite it reflects like a light ray: a corner hit flips both axes, a horizontal-face touch flips the vertical component, and a vertical-face touch flips the horizontal component.
+
+    Key insight: The wall still determines one cardinal outward axis, but the mover's relative position around that opening chooses the diagonal branch, and the already-generated wall+fill sprite then acts as a reflective obstacle that bends the rest of the path.
+    """
+    info = _compute_stage1(np.array(grid, copy=True))
+    out = np.array(info["out"], copy=True)
+    bg = int(info["bg"])
+    wall = int(info["wall"])
+    fill = int(info["fill"])
+    sprite_mask = np.array(info["sprite_mask"], copy=True)
+
+    g = np.array(grid, copy=True)
+    mover_cells = [
+        (int(r), int(c), int(g[r, c]))
+        for r, c in np.argwhere((g != bg) & (g != wall) & (g != fill))
+    ]
+    for r, c, _col in mover_cells:
+        out[r, c] = bg
+
+    for r, c, col in sorted(mover_cells):
+        d = _mover_dir((r, c), info)
+        traced = _trace_diag_mover((r, c), d, sprite_mask)
+        end_r, end_c = traced["end"]
+        out[end_r, end_c] = col
+
+    return out
+
+
+def _find_mover_candidates(grid: np.ndarray, stage1_info: dict):
+    bg = int(stage1_info["bg"])
+    wall = int(stage1_info["wall"])
+    sprite_mask = np.array(stage1_info["sprite_mask"], copy=True)
+
+    wall_mask = grid == wall
+    dist = distance_transform_cdt(~wall_mask, metric="taxicab")
+    eligible = (grid == bg) & (~sprite_mask) & (dist >= MOVER_MIN_WALL_DIST)
+
+    reflect = []
+    straight = []
+    for r, c in zip(*np.where(eligible)):
+        start = (int(r), int(c))
+        d = _mover_dir(start, stage1_info)
+        branch_sign = int(d[1] if stage1_info["rad"][0] != 0 else d[0])
+        traced = _trace_diag_mover(start, d, sprite_mask)
+        if not traced["ok"]:
+            continue
+        if len(traced["path"]) < MOVER_MIN_TRAVEL:
+            continue
+        end = traced["end"]
+        if not (end[0] in (0, grid.shape[0] - 1) or end[1] in (0, grid.shape[1] - 1)):
+            continue
+        footprint = {start, *traced["path"]}
+        item = {
+            "start": start,
+            "end": (int(end[0]), int(end[1])),
+            "path": list(traced["path"]),
+            "footprint": footprint,
+            "reflections": int(traced["reflections"]),
+            "direction": d,
+            "branch_sign": branch_sign,
+        }
+        if traced["reflections"] >= 1:
+            reflect.append(item)
+        else:
+            straight.append(item)
+
+    random.shuffle(reflect)
+    random.shuffle(straight)
+    reflect.sort(key=lambda x: (x["reflections"], len(x["path"])), reverse=True)
+    straight.sort(key=lambda x: len(x["path"]), reverse=True)
+    return reflect, straight
+
+
+def _choose_movers(reflect, straight):
+    if not reflect:
+        return None
+
+    all_items = reflect + straight
+    for item in all_items:
+        for other in all_items:
+            if other is item:
+                continue
+            if item["branch_sign"] == other["branch_sign"]:
+                continue
+            if item["footprint"] & other["footprint"]:
+                continue
+            pair = [item, other]
+            if sum(p["reflections"] >= 1 for p in pair) >= REFLECT_REQUIRED:
+                return pair
+    return None
+
+
+def _gen_attempt():
+    rad = random.choice([(-1, 0), (1, 0), (0, -1), (0, 1)])
+    h = random.randint(*GRID_H_VERT) if rad[0] else random.randint(*GRID_H_HORIZ)
+    w = random.randint(*GRID_W)
+
+    built = _build_local_wall(rad, h, w)
+    if built is None:
+        return None
+    local_wall, depth, gap = built
+    anchor = _place_anchor(rad, h, w, depth, gap)
+
+    palette = random.sample(range(10), random.randint(*PALETTE_SIZE))
+    bg, wall_color, fill_color = palette[:3]
+    mover_colors = palette[3:]
+    if len(mover_colors) < MOVERS_REQUIRED:
+        available = [c for c in range(10) if c not in (bg, wall_color, fill_color) and c not in mover_colors]
+        random.shuffle(available)
+        mover_colors = mover_colors + available[: MOVERS_REQUIRED - len(mover_colors)]
+
+    grid = np.full((h, w), bg, dtype=int)
+    for u, v in local_wall:
+        r, c = _map_local(u, v, rad, anchor)
+        grid[r, c] = wall_color
+
+    interior = _local_interior(local_wall, depth, gap)
+    wall_set = set(local_wall)
+    adjacent = [
+        p
+        for p in interior
+        if any((p[0] + dr, p[1] + dc) in wall_set for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)])
+    ]
+    seed_pool = [p for p in adjacent if p[0] >= max(1, depth - SEED_DEPTH_LOOKBACK)]
+    if not seed_pool:
+        return None
+
+    blob = _grow_seed_blob(random.choice(seed_pool), set(interior))
+    for u, v in blob:
+        r, c = _map_local(u, v, rad, anchor)
+        if grid[r, c] != bg:
+            return None
+        grid[r, c] = fill_color
+
+    try:
+        stage1_info = _compute_stage1(grid)
+    except Exception:
+        return None
+
+    reflect, straight = _find_mover_candidates(grid, stage1_info)
+    chosen = _choose_movers(reflect, straight)
+    if chosen is None or len(chosen) != MOVERS_REQUIRED:
+        return None
+
+    if len({item["branch_sign"] for item in chosen}) != MOVERS_REQUIRED:
+        return None
+    if sum(item["reflections"] >= 1 for item in chosen) < REFLECT_REQUIRED:
+        return None
+
+    nominal_out = np.array(stage1_info["out"], copy=True)
+    for i, item in enumerate(chosen):
+        r, c = item["start"]
+        grid[r, c] = mover_colors[i]
+
+    try:
+        out = main(grid)
+    except Exception:
+        return None
+
+    new_fill = (out == fill_color) & (grid == bg)
+    if int(new_fill.sum()) < MIN_NEW_FILL or not _touches_border(new_fill):
+        return None
+
+    if not np.array_equal((nominal_out == fill_color), (out == fill_color)):
+        return None
+
+    actual_mover_mask = (grid != bg) & (grid != wall_color) & (grid != fill_color)
+    if int(actual_mover_mask.sum()) != MOVERS_REQUIRED:
+        return None
+
+    for item in chosen:
+        color = int(grid[item["start"]])
+        endpoints = [(int(r), int(c)) for r, c in zip(*np.where(out == color))]
+        if item["end"] not in endpoints:
+            return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate valid b9e38dc0 combo input")

