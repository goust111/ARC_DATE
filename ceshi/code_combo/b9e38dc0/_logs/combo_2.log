+OBSTACLE_IN_FILL_PROB = 0.65
+OBSTACLE_MIN_SEP = 2
+
+MIN_NEW_FILL = 18
+MIN_MULTI_BONUS = 6
+PALETTE_SIZE = (3, 5)
+GEN_RETRIES = 500
