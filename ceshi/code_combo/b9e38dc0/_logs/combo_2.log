+
+    obstacles = (g != bg) & (g != fill) & (g != wall)
+    _paint_opening_rays(out, openings, bg, fill, obstacles)
+    return out
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Fill the inside of a multi-opening fence and radiate the color out through every gap.
+
+    Input structure:
+    - The background is the most common color. The wall is the most common non-background color
+      and forms a thin rectangular fence whose border has two or more missing segments.
+    - A non-wall seed blob sits inside that fence. Any other non-background pixels are obstacles
+      placed on background cells and kept unchanged.
+    Rule:
+    - First flood-fill the fence interior reachable from the seed.
+    - Then, for each detected opening, continue the fill straight outward from every gap cell to
+      the grid edge. Obstacles stop only the ray they lie on, while walls and obstacles remain unchanged.
+
+    Key insight: The missing border runs define several independent leak directions; the solver
+    must detect all openings and propagate one outward strip per opening instead of inventing one global direction.
+    """
+    return _solve_core(grid)
+
+
+def _single_opening_baseline(grid: np.ndarray) -> np.ndarray:
+    return _solve_core(grid, opening_limit=1)
+
+
+def analyze_primary_fence(grid: np.ndarray) -> dict:
+    bg, wall, fill, fill_pos, wall_comp = _select_wall_fill_and_component(grid)
+    comp_mask = _component_mask(wall_comp, grid.shape)
+    openings, bbox = _detect_openings(comp_mask)
+    return {
+        "bg": bg,
+        "wall": wall,
+        "fill": fill,
+        "seed_pixels": len(fill_pos),
+        "opening_count": len(openings),
+        "opening_sides": tuple(op["side"] for op in openings),
+        "bbox": bbox,
+    }
+
+
+def combo_behavior_metrics(grid: np.ndarray) -> dict:
+    out = main(grid)
+    base = _single_opening_baseline(grid)
+    info = analyze_primary_fence(grid)
+    fill = info["fill"]
+    new_fill = (out == fill) & (grid != fill)
+    multi_bonus = (out == fill) & (base != fill)
+    border_hits = 0
+    border_hits += int((out[0, :] == fill).any())
+    border_hits += int((out[-1, :] == fill).any())
+    border_hits += int((out[:, 0] == fill).any())
+    border_hits += int((out[:, -1] == fill).any())
+    return {
+        "opening_count": info["opening_count"],
+        "distinct_sides": len(set(info["opening_sides"])),
+        "new_fill": int(new_fill.sum()),
+        "multi_bonus": int(multi_bonus.sum()),
+        "border_hits": border_hits,
+    }
+
+
+def _rect_border_points(height: int, width: int) -> set[tuple[int, int]]:
+    pts: set[tuple[int, int]] = set()
+    for c in range(width):
+        pts.add((0, c))
+        pts.add((height - 1, c))
+    for r in range(height):
+        pts.add((r, 0))
+        pts.add((r, width - 1))
+    return pts
+
+
+def _choose_disjoint_intervals(line_len: int, count: int) -> list[tuple[int, int]] | None:
+    if line_len < 5:
+        return None
+    slots = list(range(1, line_len - 1))
+    for _ in range(100):
+        intervals: list[tuple[int, int]] = []
+        ok = True
+        for _idx in range(count):
+            length = random.randint(*OPEN_LEN)
+            starts = list(range(1, line_len - length))
+            random.shuffle(starts)
+            picked = None
+            for start in starts:
+                end = start + length - 1
+                if end >= line_len - 1:
+                    continue
+                if any(not (end + 1 < a or b + 1 < start) for a, b in intervals):
+                    continue
+                picked = (start, end)
+                break
+            if picked is None:
+                ok = False
+                break
+            intervals.append(picked)
+        if ok:
+            intervals.sort()
+            return intervals
+    return None
+
+
+def _choose_openings(frame_h: int, frame_w: int) -> list[tuple[str, int, int]]:
+    side_pair = random.choice(
+        [
+            ("top", "left"),
+            ("top", "right"),
+            ("bottom", "left"),
+            ("bottom", "right"),
+        ]
+    )
+    primary_side = random.choice(side_pair)
+    secondary_side = side_pair[1] if primary_side == side_pair[0] else side_pair[0]
+    primary_count = random.choice([1, 2])
+
+    side_lengths = {
+        "top": frame_w,
+        "bottom": frame_w,
+        "left": frame_h,
+        "right": frame_h,
+    }
+
+    first = _choose_disjoint_intervals(side_lengths[primary_side], primary_count)
+    second = _choose_disjoint_intervals(side_lengths[secondary_side], 1)
+    if first is None or second is None:
+        return []
+
+    openings: list[tuple[str, int, int]] = []
+    for a, b in first:
+        openings.append((primary_side, a, b - a + 1))
+    for a, b in second:
+        openings.append((secondary_side, a, b - a + 1))
+    return openings
+
+
+def _build_local_fence(frame_h: int, frame_w: int, openings: list[tuple[str, int, int]]) -> set[tuple[int, int]]:
+    pts = _rect_border_points(frame_h, frame_w)
+    for side, start, length in openings:
+        for k in range(length):
+            if side == "top":
+                pts.discard((0, start + k))
+            elif side == "bottom":
+                pts.discard((frame_h - 1, start + k))
+            elif side == "left":
+                pts.discard((start + k, 0))
+            else:
+                pts.discard((start + k, frame_w - 1))
+    return pts
+
+
+def _place_anchor(
+    grid_h: int,
+    grid_w: int,
+    frame_h: int,
+    frame_w: int,
+    openings: list[tuple[str, int, int]],
+) -> tuple[int, int] | None:
+    sides = {side for side, _, _ in openings}
+    top_margin = OPEN_END_MARGIN if "top" in sides else SIDE_MARGIN
+    bottom_margin = OPEN_END_MARGIN if "bottom" in sides else SIDE_MARGIN
+    left_margin = OPEN_END_MARGIN if "left" in sides else SIDE_MARGIN
+    right_margin = OPEN_END_MARGIN if "right" in sides else SIDE_MARGIN
+
+    r_lo = top_margin
+    r_hi = grid_h - frame_h - bottom_margin
+    c_lo = left_margin
+    c_hi = grid_w - frame_w - right_margin
+    if r_lo > r_hi or c_lo > c_hi:
+        return None
+    return random.randint(r_lo, r_hi), random.randint(c_lo, c_hi)
+
+
+def _grow_seed_blob(seed: tuple[int, int], interior_set: set[tuple[int, int]]) -> set[tuple[int, int]]:
+    blob = {seed}
+    frontier = [seed]
+    target = random.choice(SEED_SIZE_WEIGHTS)
+    while len(blob) < target and frontier:
+        r, c = frontier.pop(random.randrange(len(frontier)))
+        nbrs = [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+        random.shuffle(nbrs)
+        for q in nbrs:
+            if q in interior_set and q not in blob:
+                blob.add(q)
+                frontier.append(q)
+                if len(blob) >= target:
+                    break
+    return blob
+
+
+def _seed_pool(frame_h: int, frame_w: int, wall: set[tuple[int, int]], open_sides: set[str]) -> list[tuple[int, int]]:
+    pool: list[tuple[int, int]] = []
+    for r in range(1, frame_h - 1):
+        for c in range(1, frame_w - 1):
+            if not any((rr, cc) in wall for rr, cc in neighbors8(r, c)):
+                continue
+            score = 0
+            if "top" in open_sides:
+                score += r
+            if "bottom" in open_sides:
+                score += frame_h - 1 - r
+            if "left" in open_sides:
+                score += c
+            if "right" in open_sides:
+                score += frame_w - 1 - c
+            pool.append((score, r, c))
+    if not pool:
+        return []
+    pool.sort(reverse=True)
+    cutoff = max(1, len(pool) // 3)
+    return [(r, c) for _, r, c in pool[:cutoff]]
+
+
+def _obstacle_fits(pos: tuple[int, int], placed: list[tuple[int, int]]) -> bool:
+    r, c = pos
+    return all(max(abs(r - rr), abs(c - cc)) >= OBSTACLE_MIN_SEP for rr, cc in placed)
+
+
+def _find_obstacle_candidates(
+    grid: np.ndarray,
+    bg: int,
+    wall_color: int,
+    nominal_fill_zone: np.ndarray,
+    interior_mask: np.ndarray,
+) -> tuple[list[tuple[int, int]], list[tuple[int, int]]]:
+    wall_mask = grid == wall_color
+    dist = distance_transform_cdt(~wall_mask, metric="taxicab")
+    eligible = (grid == bg) & (dist > 1) & (~interior_mask)
+    all_coords = [(int(r), int(c)) for r, c in zip(*np.where(eligible))]
+    fill_coords = [p for p in all_coords if nominal_fill_zone[p[0], p[1]]]
+    random.shuffle(all_coords)
+    random.shuffle(fill_coords)
+    return all_coords, fill_coords
+
+
+def _place_obstacles(
+    n_obstacles: int,
+    candidates: list[tuple[int, int]],
+    fill_candidates: list[tuple[int, int]],
+    obstacle_colors: list[int],
+    grid: np.ndarray,
+) -> None:
+    placed: list[tuple[int, int]] = []
+    n_fill = random.randint(0, min(n_obstacles, len(fill_candidates)))
+    if fill_candidates and random.random() < OBSTACLE_IN_FILL_PROB:
+        n_fill = max(1, n_fill)
+
+    for p in fill_candidates:
+        if len(placed) >= n_fill:
+            break
+        if _obstacle_fits(p, placed):
+            placed.append(p)
+
+    placed_set = set(placed)
+    for p in candidates:
+        if len(placed) >= n_obstacles:
+            break
+        if p not in placed_set and _obstacle_fits(p, placed):
+            placed.append(p)
+            placed_set.add(p)
+
+    for i, (r, c) in enumerate(placed):
+        grid[r, c] = obstacle_colors[i % len(obstacle_colors)]
+
+
+def _border_touch_count(mask: np.ndarray) -> int:
+    hits = 0
+    hits += int(mask[0, :].any())
+    hits += int(mask[-1, :].any())
+    hits += int(mask[:, 0].any())
+    hits += int(mask[:, -1].any())
+    return hits
+
+
+def _gen_attempt() -> np.ndarray | None:
+    grid_h = random.randint(*GRID_H)
+    grid_w = random.randint(*GRID_W)
+    frame_h = random.randint(*FENCE_H)
+    frame_w = random.randint(*FENCE_W)
+
+    openings = _choose_openings(frame_h, frame_w)
+    if len(openings) < 2:
+        return None
+
+    local_wall = _build_local_fence(frame_h, frame_w, openings)
+    local_mask = _component_mask(local_wall, (frame_h, frame_w))
+    if len(components_mask(local_mask, connectivity=8)) != 1:
+        return None
+
+    anchor = _place_anchor(grid_h, grid_w, frame_h, frame_w, openings)
+    if anchor is None:
+        return None
+    r0, c0 = anchor
+
+    palette = random.sample(range(10), random.randint(*PALETTE_SIZE))
+    bg, wall_color, fill_color = palette[:3]
+    obstacle_colors = palette[3:]
+
+    grid = np.full((grid_h, grid_w), bg, dtype=int)
+    for r, c in local_wall:
+        grid[r0 + r, c0 + c] = wall_color
+
+    open_sides = {side for side, _, _ in openings}
+    seed_candidates = _seed_pool(frame_h, frame_w, local_wall, open_sides)
+    if not seed_candidates:
+        return None
+
+    interior_local = {(r, c) for r in range(1, frame_h - 1) for c in range(1, frame_w - 1)}
+    blob = _grow_seed_blob(random.choice(seed_candidates), interior_local)
+    for r, c in blob:
+        if grid[r0 + r, c0 + c] != bg:
+            return None
+        grid[r0 + r, c0 + c] = fill_color
+
+    try:
+        nominal_out = main(grid)
+    except Exception:
+        return None
+
+    interior_mask = np.zeros_like(grid, dtype=bool)
+    interior_mask[r0 + 1:r0 + frame_h - 1, c0 + 1:c0 + frame_w - 1] = True
+    nominal_fill_zone = (nominal_out == fill_color) & (grid == bg)
+    if int(nominal_fill_zone.sum()) < MIN_NEW_FILL:
+        return None
+
+    n_obstacles = random.randint(0, MAX_OBSTACLES)
+    if n_obstacles and not obstacle_colors:
+        available = [c for c in range(10) if c not in (bg, wall_color, fill_color)]
+        obstacle_colors = random.sample(available, random.randint(1, 2))
+    if n_obstacles:
+        candidates, fill_candidates = _find_obstacle_candidates(
+            grid, bg, wall_color, nominal_fill_zone, interior_mask
+        )
+        _place_obstacles(n_obstacles, candidates, fill_candidates, obstacle_colors, grid)
+
+    try:
+        out = main(grid)
+        base = _single_opening_baseline(grid)
+    except Exception:
+        return None
+
+    new_fill = (out == fill_color) & (grid == bg)
+    multi_bonus = (out == fill_color) & (base != fill_color)
+    if int(new_fill.sum()) < MIN_NEW_FILL:
+        return None
+    if _border_touch_count(out == fill_color) < 2:
+        return None
+    if int(multi_bonus.sum()) < MIN_MULTI_BONUS:
+        return None
+
+    metrics = analyze_primary_fence(grid)
+    if metrics["opening_count"] < 2 or len(set(metrics["opening_sides"])) < 2:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate valid b9e38dc0 combo input")

diff --git a/ceshi/code_combo/b9e38dc0/2/code.py b/ceshi/code_combo/b9e38dc0/2/code.py
new file mode 100644
index 0000000000000000000000000000000000000000..47468e96e8ba290e79219037463162ee02395bcb
--- /dev/null
+++ b/ceshi/code_combo/b9e38dc0/2/code.py
@@ -0,0 +1,622 @@
+# Combo variant of b9e38dc0 (index 2)
+# combo_spec: D1/1+D6/0
+# Name: 多开口辐射+多开口围栏
+
+import random
+
+import numpy as np
+from scipy.ndimage import distance_transform_cdt
+
+from arc_utils import components_mask, get_bg, neighbors4, neighbors8
+
+
+DESIGN_ANALYSIS = """
+Combo design analysis
+=====================
+
+a) 具体化与行为追踪
+- 原题依赖一个 U/C 形半包围墙和一个主开口方向: 先灌满内部，再沿这个唯一方向向外扩张。
+- 这个融合版把墙改成 1 像素厚的矩形围栏，边框上出现 2 到 3 个缺口。填充种子仍放在围栏内部。
+- 具体例子: 若围栏顶部有 1 个缺口、左侧有 2 个缺口，原题式逻辑只能抽出一个主方向，
+  结果只会产生一条外泄带；融合后应先把矩形内部填满，再让顶部缺口向上形成一条带，
+  左侧两个缺口分别向左形成两条带。差异是输出会同时出现多条朝不同边界延伸的填充轨迹。
+
+b) 复杂度校准
+- 如果允许任意厚度或任意多边形围栏，多开口检测会和“哪部分算内部”纠缠在一起，视觉上也会变乱。
+- 这里把结构收敛为薄矩形围栏，只允许 2 个相邻边参与开口，其中一条边可有 1 或 2 个缺口，
+  总开口数固定在 2 或 3。这样既能稳定体现“多开口 + 多射线”，又不会出现大量交叉条带。
+- 开口长度限制为 1 到 2 格，障碍保持少量单像素，保证样例中重复支撑的是“缺口数量/方向”，
+  而不是难以概括的细枝末节。
+
+c) 隐式假设审查
+- 原 solver 通过 degree-1 墙端点推断开口方向，这在矩形边框缺口上完全失效，因为缺口两侧不是端点。
+- 原 solver 把端点外向量合成为一个全局 `rad`，多开口时这个假设不成立，不同缺口可能朝不同方向。
+- 原 solver 用一组边界射线围出单个可达区，再做一次 BFS；融合后应先只在围栏 bbox 内部做 flood-fill，
+  再对每个开口独立向外投射条带。
+- 原阴影处理按单一方向扫描；融合后每个开口自己的条带都应独立被障碍截断。
+
+d) 放置合法性
+- 生成器只画 1 像素厚矩形围栏，缺口只挖在非角点边格，避免越界和角点歧义。
+- 只选相邻两条边开口，因此去掉多个缺口后围栏仍保持单个 8 连通分量，不需要额外连接桥。
+- 围栏锚点会根据哪些边开口来留出至少 3 格外部空间，保证所有射线在对应方向上有可见延伸。
+- 种子严格放在围栏内部；障碍只放在背景格上，并且远离墙，使填充色仍是离墙最近的非墙色。
+
+e) 视觉可观察性
+- 人类看到输入时能直接看出“这是一个带多个缺口的围栏”；看到输出时能直接看出“每个缺口都漏出一条带”。
+- 开口位置来自几何结构，不依赖颜色编号、排序、扫描顺序等不可视信息。
+- 开口方向在样例间变化，但都来自同一个稳定规则: 缺口朝哪一侧，填充就朝哪一侧继续延伸。
+
+f) 可视化整洁度
+- 生成器把多缺口限制在相邻两边，避免上下左右同时开口造成外部区域大面积重叠。
+- 同一条边上若有两个缺口，会强制它们相互分离，确保两条带肉眼可区分。
+- 障碍优先放到外泄带区域而非室内，避免把室内 flood-fill 切成难读的碎块。
+
+g) 变化的可推断性
+- 颜色规则保持极简: 只有背景色会变成填充色；墙和障碍颜色都保持不变。
+- 由于变化区域与“围栏内部 + 缺口外侧条带”强绑定，人类可以从结构上推断颜色扩张规则，
+  不需要猜测任何隐藏的颜色映射。
+
+h) 反退化策略
+- 仅仅让 solver 支持多开口还不够，generator 还必须避免生成“虽然有多个缺口，但第二个缺口没带来新结果”的样本。
+- 因此生成时会和单开口基线对比，要求完整 solver 比只保留一个开口时多填出至少若干格，
+  并且通常触达至少两个不同边界。
+
+i) 新 solver 假设与 generator 保证
+- 新 solver 假设目标墙组件是薄矩形边框，缺口表现为 bbox 四边上的连续背景段。
+- 新 solver 假设填充种子位于该边框内部，且其余非墙色像素只是种子或障碍。
+- generator 通过固定围栏几何、控制种子位置、让障碍远离墙并限制在背景格上，保证这些前提成立。
+"""
+
+
+GRID_H = (11, 18)
+GRID_W = (15, 19)
+
+FENCE_H = (7, 10)
+FENCE_W = (8, 12)
+OPEN_LEN = (1, 2)
+OPEN_END_MARGIN = 3
+SIDE_MARGIN = 1
+
+SEED_SIZE_WEIGHTS = [1, 1, 1, 2, 2, 3, 4, 5, 6]
+MAX_OBSTACLES = 4
+OBSTACLE_IN_FILL_PROB = 0.65
+OBSTACLE_MIN_SEP = 2
+
+MIN_NEW_FILL = 18
+MIN_MULTI_BONUS = 6
+PALETTE_SIZE = (3, 5)
+GEN_RETRIES = 500
+
+
+def _component_mask(points: set[tuple[int, int]], shape: tuple[int, int]) -> np.ndarray:
+    mask = np.zeros(shape, dtype=bool)
+    for r, c in points:
+        mask[r, c] = True
+    return mask
+
+
+def _bbox_from_mask(mask: np.ndarray) -> tuple[int, int, int, int]:
+    coords = np.argwhere(mask)
+    assert coords.size, "expected non-empty mask"
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _select_wall_fill_and_component(
+    grid: np.ndarray,
+) -> tuple[int, int, int, list[tuple[int, int]], set[tuple[int, int]]]:
+    g = np.asarray(grid)
+    bg = get_bg(g)
+    non_bg = [int(v) for v in np.unique(g) if int(v) != bg]
+    assert non_bg, "expected at least one non-background color"
+
+    wall = max(non_bg, key=lambda c: int((g == c).sum()))
+    wall_mask = g == wall
+    comps = [set((int(r), int(c)) for r, c in pts) for pts in components_mask(wall_mask, connectivity=8)]
+    assert comps, "expected at least one wall connected component"
+
+    other_colors = [c for c in non_bg if c != wall]
+    assert other_colors, "expected at least one non-wall color"
+
+    wall_points = [p for comp in comps for p in comp]
+
+    def min_dist_to_wall(color: int) -> tuple[int, int]:
+        pts = [(int(r), int(c)) for r, c in zip(*np.where(g == color))]
+        best = 10**9
+        for r, c in pts:
+            for wr, wc in wall_points:
+                d = abs(r - wr) + abs(c - wc)
+                if d < best:
+                    best = d
+                    if best == 0:
+                        return 0, len(pts)
+        return best, len(pts)
+
+    fill = min(other_colors, key=lambda c: (min_dist_to_wall(c)[0], min_dist_to_wall(c)[1]))
+    fill_pos = [(int(r), int(c)) for r, c in zip(*np.where(g == fill))]
+    assert fill_pos, "expected at least one fill seed"
+
+    def comp_min_dist(comp: set[tuple[int, int]]) -> int:
+        best = 10**9
+        for r, c in fill_pos:
+            for wr, wc in comp:
+                d = abs(r - wr) + abs(c - wc)
+                if d < best:
+                    best = d
+                    if best == 0:
+                        return 0
+        return best
+
+    wall_comp = min(comps, key=lambda comp: (comp_min_dist(comp), -len(comp)))
+    return bg, wall, fill, fill_pos, wall_comp
+
+
+def _false_runs(values: list[bool]) -> list[tuple[int, int]]:
+    runs: list[tuple[int, int]] = []
+    i = 0
+    while i < len(values):
+        if values[i]:
+            i += 1
+            continue
+        j = i
+        while j + 1 < len(values) and not values[j + 1]:
+            j += 1
+        runs.append((i, j))
+        i = j + 1
+    return runs
+
+
+def _detect_openings(comp_mask: np.ndarray) -> tuple[list[dict], tuple[int, int, int, int]]:
+    r0, c0, r1, c1 = _bbox_from_mask(comp_mask)
+    openings: list[dict] = []
+
+    def add_side(side: str, cells: list[tuple[int, int]], inner_offset: tuple[int, int], direction: tuple[int, int]) -> None:
+        run: list[tuple[int, int]] = []
+        for r, c in cells:
+            if not comp_mask[r, c]:
+                run.append((r, c))
+            elif run:
+                inner = [(rr + inner_offset[0], cc + inner_offset[1]) for rr, cc in run]
+                openings.append({"side": side, "cells": run[:], "inner": inner, "dir": direction})
+                run = []
+        if run:
+            inner = [(rr + inner_offset[0], cc + inner_offset[1]) for rr, cc in run]
+            openings.append({"side": side, "cells": run[:], "inner": inner, "dir": direction})
+
+    add_side("top", [(r0, c) for c in range(c0 + 1, c1)], (1, 0), (-1, 0))
+    add_side("bottom", [(r1, c) for c in range(c0 + 1, c1)], (-1, 0), (1, 0))
+    add_side("left", [(r, c0) for r in range(r0 + 1, r1)], (0, 1), (0, -1))
+    add_side("right", [(r, c1) for r in range(r0 + 1, r1)], (0, -1), (0, 1))
+    return openings, (r0, c0, r1, c1)
+
+
+def _flood(passable: np.ndarray, seeds: list[tuple[int, int]]) -> np.ndarray:
+    seen = np.zeros_like(passable, dtype=bool)
+    q = seeds[:]
+    for r, c in q:
+        if passable[r, c]:
+            seen[r, c] = True
+    while q:
+        r, c = q.pop()
+        for rr, cc in neighbors4(r, c):
+            if 0 <= rr < passable.shape[0] and 0 <= cc < passable.shape[1] and passable[rr, cc] and not seen[rr, cc]:
+                seen[rr, cc] = True
+                q.append((rr, cc))
+    return seen
+
+
+def _paint_opening_rays(
+    out: np.ndarray,
+    openings: list[dict],
+    bg: int,
+    fill: int,
+    obstacles: np.ndarray,
+) -> np.ndarray:
+    ray_mask = np.zeros_like(out, dtype=bool)
+    h, w = out.shape
+    for opening in openings:
+        dr, dc = opening["dir"]
+        for r, c in opening["cells"]:
+            rr, cc = r, c
+            while 0 <= rr < h and 0 <= cc < w:
+                if obstacles[rr, cc]:
+                    break
+                if out[rr, cc] == bg:
+                    out[rr, cc] = fill
+                if out[rr, cc] == fill:
+                    ray_mask[rr, cc] = True
+                rr += dr
+                cc += dc
+    return ray_mask
+
+
+def _solve_core(grid: np.ndarray, opening_limit: int | None = None) -> np.ndarray:
+    g = np.array(grid, copy=True)
+    bg, wall, fill, fill_pos, wall_comp = _select_wall_fill_and_component(g)
+
+    comp_mask = _component_mask(wall_comp, g.shape)
+    openings, bbox = _detect_openings(comp_mask)
+    assert openings, "expected at least one opening"
+    if opening_limit is not None:
+        openings = openings[:opening_limit]
+    else:
+        assert len(openings) >= 2, "expected a fence with two or more openings"
+
+    r0, c0, r1, c1 = bbox
+    room_mask = np.zeros_like(comp_mask, dtype=bool)
+    if r1 - r0 > 1 and c1 - c0 > 1:
+        room_mask[r0 + 1:r1, c0 + 1:c1] = True
+
+    passable_room = room_mask & (~comp_mask) & ((g == bg) | (g == fill))
+    seen_room = _flood(passable_room, fill_pos)
+
+    out = g.copy()
+    interior_fill = seen_room & (g == bg)
+    out[interior_fill] = fill
+
+    obstacles = (g != bg) & (g != fill) & (g != wall)
+    _paint_opening_rays(out, openings, bg, fill, obstacles)
+    return out
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Fill the inside of a multi-opening fence and radiate the color out through every gap.
+
+    Input structure:
+    - The background is the most common color. The wall is the most common non-background color
+      and forms a thin rectangular fence whose border has two or more missing segments.
+    - A non-wall seed blob sits inside that fence. Any other non-background pixels are obstacles
+      placed on background cells and kept unchanged.
+    Rule:
+    - First flood-fill the fence interior reachable from the seed.
+    - Then, for each detected opening, continue the fill straight outward from every gap cell to
+      the grid edge. Obstacles stop only the ray they lie on, while walls and obstacles remain unchanged.
+
+    Key insight: The missing border runs define several independent leak directions; the solver
+    must detect all openings and propagate one outward strip per opening instead of inventing one global direction.
+    """
+    return _solve_core(grid)
+
+
+def _single_opening_baseline(grid: np.ndarray) -> np.ndarray:
+    return _solve_core(grid, opening_limit=1)
+
+
+def analyze_primary_fence(grid: np.ndarray) -> dict:
+    bg, wall, fill, fill_pos, wall_comp = _select_wall_fill_and_component(grid)
+    comp_mask = _component_mask(wall_comp, grid.shape)
+    openings, bbox = _detect_openings(comp_mask)
+    return {
+        "bg": bg,
+        "wall": wall,
+        "fill": fill,
+        "seed_pixels": len(fill_pos),
+        "opening_count": len(openings),
+        "opening_sides": tuple(op["side"] for op in openings),
+        "bbox": bbox,
+    }
+
+
+def combo_behavior_metrics(grid: np.ndarray) -> dict:
+    out = main(grid)
+    base = _single_opening_baseline(grid)
+    info = analyze_primary_fence(grid)
+    fill = info["fill"]
+    new_fill = (out == fill) & (grid != fill)
+    multi_bonus = (out == fill) & (base != fill)
+    border_hits = 0
+    border_hits += int((out[0, :] == fill).any())
+    border_hits += int((out[-1, :] == fill).any())
+    border_hits += int((out[:, 0] == fill).any())
+    border_hits += int((out[:, -1] == fill).any())
+    return {
+        "opening_count": info["opening_count"],
+        "distinct_sides": len(set(info["opening_sides"])),
+        "new_fill": int(new_fill.sum()),
+        "multi_bonus": int(multi_bonus.sum()),
+        "border_hits": border_hits,
+    }
+
+
+def _rect_border_points(height: int, width: int) -> set[tuple[int, int]]:
+    pts: set[tuple[int, int]] = set()
+    for c in range(width):
+        pts.add((0, c))
+        pts.add((height - 1, c))
+    for r in range(height):
+        pts.add((r, 0))
+        pts.add((r, width - 1))
+    return pts
+
+
+def _choose_disjoint_intervals(line_len: int, count: int) -> list[tuple[int, int]] | None:
+    if line_len < 5:
+        return None
+    slots = list(range(1, line_len - 1))
+    for _ in range(100):
+        intervals: list[tuple[int, int]] = []
+        ok = True
+        for _idx in range(count):
+            length = random.randint(*OPEN_LEN)
+            starts = list(range(1, line_len - length))
+            random.shuffle(starts)
+            picked = None
+            for start in starts:
+                end = start + length - 1
+                if end >= line_len - 1:
+                    continue
+                if any(not (end + 1 < a or b + 1 < start) for a, b in intervals):
+                    continue
+                picked = (start, end)
+                break
+            if picked is None:
+                ok = False
+                break
+            intervals.append(picked)
+        if ok:
+            intervals.sort()
+            return intervals
+    return None
+
+
+def _choose_openings(frame_h: int, frame_w: int) -> list[tuple[str, int, int]]:
+    side_pair = random.choice(
+        [
+            ("top", "left"),
+            ("top", "right"),
+            ("bottom", "left"),
+            ("bottom", "right"),
+        ]
+    )
+    primary_side = random.choice(side_pair)
+    secondary_side = side_pair[1] if primary_side == side_pair[0] else side_pair[0]
+    primary_count = random.choice([1, 2])
+
+    side_lengths = {
+        "top": frame_w,
+        "bottom": frame_w,
+        "left": frame_h,
+        "right": frame_h,
+    }
+
+    first = _choose_disjoint_intervals(side_lengths[primary_side], primary_count)
+    second = _choose_disjoint_intervals(side_lengths[secondary_side], 1)
+    if first is None or second is None:
+        return []
+
+    openings: list[tuple[str, int, int]] = []
+    for a, b in first:
+        openings.append((primary_side, a, b - a + 1))
+    for a, b in second:
+        openings.append((secondary_side, a, b - a + 1))
+    return openings
+
+
+def _build_local_fence(frame_h: int, frame_w: int, openings: list[tuple[str, int, int]]) -> set[tuple[int, int]]:
+    pts = _rect_border_points(frame_h, frame_w)
+    for side, start, length in openings:
+        for k in range(length):
+            if side == "top":
+                pts.discard((0, start + k))
+            elif side == "bottom":
+                pts.discard((frame_h - 1, start + k))
+            elif side == "left":
+                pts.discard((start + k, 0))
+            else:
+                pts.discard((start + k, frame_w - 1))
+    return pts
+
+
+def _place_anchor(
+    grid_h: int,
+    grid_w: int,
+    frame_h: int,
+    frame_w: int,
+    openings: list[tuple[str, int, int]],
+) -> tuple[int, int] | None:
+    sides = {side for side, _, _ in openings}
+    top_margin = OPEN_END_MARGIN if "top" in sides else SIDE_MARGIN
+    bottom_margin = OPEN_END_MARGIN if "bottom" in sides else SIDE_MARGIN
+    left_margin = OPEN_END_MARGIN if "left" in sides else SIDE_MARGIN
+    right_margin = OPEN_END_MARGIN if "right" in sides else SIDE_MARGIN
+
+    r_lo = top_margin
+    r_hi = grid_h - frame_h - bottom_margin
+    c_lo = left_margin
+    c_hi = grid_w - frame_w - right_margin
+    if r_lo > r_hi or c_lo > c_hi:
+        return None
+    return random.randint(r_lo, r_hi), random.randint(c_lo, c_hi)
+
+
+def _grow_seed_blob(seed: tuple[int, int], interior_set: set[tuple[int, int]]) -> set[tuple[int, int]]:
+    blob = {seed}
+    frontier = [seed]
+    target = random.choice(SEED_SIZE_WEIGHTS)
+    while len(blob) < target and frontier:
+        r, c = frontier.pop(random.randrange(len(frontier)))
+        nbrs = [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+        random.shuffle(nbrs)
+        for q in nbrs:
+            if q in interior_set and q not in blob:
+                blob.add(q)
+                frontier.append(q)
+                if len(blob) >= target:
+                    break
