   380	    if rad == (1, 0):
   381	        r0 = _rand_between(depth + CLOSED_END_MARGIN, h - 1 - OPEN_END_MARGIN)
   382	        c0 = _rand_between(SIDE_MARGIN, w - gap - 1 - SIDE_MARGIN)
   383	        assert r0 is not None and c0 is not None
   384	        return r0, c0
   385	    if rad == (0, -1):
   386	        r0 = _rand_between(SIDE_MARGIN, h - gap - 1 - SIDE_MARGIN)
   387	        c0 = _rand_between(OPEN_END_MARGIN, w - depth - 1 - CLOSED_END_MARGIN)
   388	        assert r0 is not None and c0 is not None
   389	        return r0, c0
   390	    r0 = _rand_between(SIDE_MARGIN, h - gap - 1 - SIDE_MARGIN)
   391	    c0 = _rand_between(depth + CLOSED_END_MARGIN, w - 1 - OPEN_END_MARGIN)
   392	    assert r0 is not None and c0 is not None
   393	    return r0, c0
   394	
   395	
   396	def _local_interior(wall: set[tuple[int, int]], depth: int) -> list[tuple[int, int]]:
   397	    by_row: dict[int, list[int]] = {}
   398	    for u, v in wall:
   399	        by_row.setdefault(u, []).append(v)
   400	    interior = []
   401	    for u in range(1, depth):
   402	        if u not in by_row or len(by_row[u]) < 2:
   403	            continue
   404	        lo, hi = min(by_row[u]), max(by_row[u])
   405	        for v in range(lo + 1, hi):
   406	            if (u, v) not in wall:
   407	                interior.append((u, v))
   408	    return interior
   409	
   410	
   411	def _grow_seed_blob(seed: tuple[int, int], interior_set: set[tuple[int, int]]) -> set[tuple[int, int]]:
   412	    blob = {seed}
   413	    target_size = random.choice(SEED_SIZE_WEIGHTS)
   414	    frontier = [seed]
   415	    while len(blob) < target_size and frontier:
   416	        u, v = frontier.pop(random.randrange(len(frontier)))
   417	        for q in random.sample([(u - 1, v), (u + 1, v), (u, v - 1), (u, v + 1)], 4):
   418	            if q in interior_set and q not in blob:
   419	                blob.add(q)
   420	                frontier.append(q)
   421	                if len(blob) >= target_size:
   422	                    break
   423	    return blob
   424	
   425	
   426	def _bbox_margins(mask: np.ndarray) -> tuple[int, int, int, int]:
   427	    active_box = bbox(mask)
   428	    assert active_box is not None, "active bbox must exist"
   429	    r0, c0, r1, c1 = active_box
   430	    h, w = mask.shape
   431	    return r0, c0, h - 1 - r1, w - 1 - c1
   432	
   433	
   434	def _gen_attempt() -> np.ndarray | None:
   435	    rad = random.choice([(-1, 0), (1, 0), (0, -1), (0, 1)])
   436	    h = random.randint(*GRID_H_VERT) if rad[0] else random.randint(*GRID_H_HORIZ)
   437	    w = random.randint(*GRID_W)
   438	
   439	    built = _build_local_wall(rad, h, w)
   440	    if built is None:
   441	        return None
   442	    local_wall, depth, gap = built
   443	    try:
   444	        anchor = _place_anchor(rad, h, w, depth, gap)
   445	    except AssertionError:
   446	        return None
   447	
   448	    bg, wall_color, fill_color = random.sample(range(10), 3)
   449	    grid = np.full((h, w), bg, dtype=int)
   450	
   451	    for u, v in local_wall:
   452	        r, c = _map_local(u, v, rad, anchor)
   453	        if not (0 <= r < h and 0 <= c < w):
   454	            return None
   455	        grid[r, c] = wall_color
   456	
   457	    interior = _local_interior(local_wall, depth)
   458	    wall_set = set(local_wall)
   459	    adjacent = [
   460	        p
   461	        for p in interior
   462	        if any((p[0] + dr, p[1] + dc) in wall_set for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)])
   463	    ]
   464	    seed_pool = [p for p in adjacent if p[0] >= max(1, depth - SEED_DEPTH_LOOKBACK)]
   465	    if not seed_pool:
   466	        return None
   467	
   468	    blob = _grow_seed_blob(random.choice(seed_pool), set(interior))
   469	    for u, v in blob:
   470	        r, c = _map_local(u, v, rad, anchor)
   471	        if grid[r, c] != bg:
   472	            return None
   473	        grid[r, c] = fill_color
   474	
   475	    try:
   476	        full_out, info = _solve_full(grid)
   477	    except Exception:
   478	        return None
   479	
   480	    new_fill = (full_out == fill_color) & (grid == bg)
   481	    if int(new_fill.sum()) < MIN_NEW_FILL:
   482	        return None
   483	
   484	    active_mask = full_out != info["bg"]
   485	    margins = _bbox_margins(active_mask)
   486	    cropped = _tight_crop_active(full_out, info["bg"])
   487	    if cropped.shape == grid.shape:
   488	        return None
   489	    if sum(margins) < MIN_MARGIN_SUM:
   490	        return None
   491	    if sum(m > 0 for m in margins) < 2:
   492	        return None
   493	    return grid
   494	
   495	
   496	def generate_input() -> np.ndarray:
