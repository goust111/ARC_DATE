+# Combo variant of b9e38dc0 (index 11)
+# combo_spec: D9/0+D11/2
+# Name: 裁剪输出+无孤立像素
+#
+# Design analysis for the fused variant:
+# a) Concrete behavior trace:
+#    Original task: wall + interior seed + optional obstacle pixels. The solver fills the interior,
+#    then radiates through the opening, then removes filled cells hidden behind obstacles.
+#    Fused task: remove obstacle pixels entirely and delete the shadow-removal stage, so the only
+#    transformation is "fill + radiate". After that, crop the full-canvas result to the smallest
+#    rectangle containing every non-background output pixel. Example: if an upward-opening funnel
+#    sits in rows 4..10 and the fill radiates to row 0, the original output keeps the whole canvas
+#    while the fused output keeps only rows 0..10 and the occupied columns of the wall/radiation.
+# b) Complexity calibration:
+#    The geometric degrees of freedom stay the same as the base task: 4 cardinal radiate directions
+#    and 2 arm-angle modes (1:1 and 1:2). We simplify only the second-stage obstacle logic, but
+#    preserve enough variation in wall geometry and placement that the cropped output is still a
+#    visibly structured wedge rather than a trivial blob.
+# c) Implicit assumptions review:
+#    - The original "other non-bg colors may be obstacles" assumption is no longer valid, so the
+#      solver must not interpret extra colors as blockers or run the shadow scanlines.
+#    - Tight crop adds a new assumption: the transformed support is exactly the set of non-bg output
+#      pixels, so generator examples must avoid unrelated decorations.
+#    - Endpoint/radiate inference, wall connectivity, and seed-near-wall assumptions still matter,
+#      so generator construction continues to enforce a single 8-connected wall with exactly 2
+#      degree-1 endpoints and a fill blob inside the enclosure.
+# d) Placement legality:
+#    The generator places only wall and fill seed pixels on a blank canvas. Anchor ranges enforce
+#    in-bounds placement with margins around the wall footprint, and validation rejects cases where
+#    the resulting active bbox is degenerate or uncropped.
+# e) Visual observability:
+#    Inputs use exactly 3 colors: bg, wall, fill. This removes clutter and makes the fused rule
+#    legible from few examples: the output is the same fill/radiate structure as the base task, but
+#    with no obstacle-induced holes and with the surrounding blank canvas removed.
+# f) Visual cleanliness:
+#    No overlapping markings or extra singleton pixels remain. The only output objects are the wall
+#    and the filled region, so the crop boundary is easy to perceive.
+# g) Inferability of change:
+#    The main control signal is geometric, not color-id based. Across samples, the user can infer
+#    "same fill logic, no blockers, then crop to active content" because output size consistently
+#    shrinks while the wall/fill colors themselves remain unchanged.
+
+from __future__ import annotations
+
+import os
+import random
+import sys
+
+import numpy as np
+
+ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), "../../../../"))
+if ROOT not in sys.path:
+    sys.path.append(ROOT)
+
+from arc_utils import bbox, components_mask, crop_bbox, get_bg, neighbors4, neighbors8
+
+
+def _sgn(x: int) -> int:
+    return (x > 0) - (x < 0)
+
+
+def _tight_crop_active(grid: np.ndarray, bg: int) -> np.ndarray:
+    active_box = bbox(grid != bg)
+    if active_box is None:
+        return grid.copy()
+    return crop_bbox(grid, active_box)
+
+
+def _solve_full(grid: np.ndarray) -> tuple[np.ndarray, dict]:
+    g = np.array(grid, copy=True)
+    h, w = g.shape
+
+    vals = np.unique(g)
+    bg = get_bg(g)
+    non_bg = [int(v) for v in vals if int(v) != bg]
+    assert len(non_bg) >= 2, "expected wall color and fill color"
+
+    wall = max(non_bg, key=lambda c: int((g == c).sum()))
+    wall_mask = g == wall
+    comps = [set((int(r), int(c)) for r, c in pts) for pts in components_mask(wall_mask, connectivity=8)]
+    assert comps, "expected at least one wall connected component"
+
+    other_colors = [c for c in non_bg if c != wall]
+    assert other_colors, "expected a fill color distinct from the wall"
+    wall_points = [p for comp in comps for p in comp]
+
+    def min_dist_to_wall(color: int) -> tuple[int, int]:
+        pts = [(int(r), int(c)) for r, c in zip(*np.where(g == color), strict=False)]
+        best_d = 10**9
+        for r, c in pts:
+            for wr, wc in wall_points:
+                d = abs(r - wr) + abs(c - wc)
+                if d < best_d:
+                    best_d = d
+                    if best_d == 0:
+                        return 0, len(pts)
+        return best_d, len(pts)
+
+    fill = min(other_colors, key=lambda c: (min_dist_to_wall(c)[0], min_dist_to_wall(c)[1]))
+    fill_pos = [(int(r), int(c)) for r, c in zip(*np.where(g == fill), strict=False)]
+    assert fill_pos, "expected at least one fill seed pixel"
+
+    def comp_min_dist(comp: set[tuple[int, int]]) -> int:
+        best_d = 10**9
+        for r, c in fill_pos:
+            for wr, wc in comp:
+                d = abs(r - wr) + abs(c - wc)
+                if d < best_d:
+                    best_d = d
+                    if best_d == 0:
+                        return 0
+        return best_d
+
+    wall_comp = min(comps, key=lambda comp: (comp_min_dist(comp), -len(comp)))
+    comp_mask = np.zeros_like(wall_mask, dtype=bool)
+    for r, c in wall_comp:
+        comp_mask[r, c] = True
+
+    def comp_neighbors(r: int, c: int) -> list[tuple[int, int]]:
+        out = []
+        for rr, cc in neighbors8(r, c):
+            if 0 <= rr < h and 0 <= cc < w and comp_mask[rr, cc]:
+                out.append((rr, cc))
+        return out
+
+    endpoints = [(r, c) for r, c in wall_comp if len(comp_neighbors(r, c)) == 1]
+    assert len(endpoints) == 2, "expected exactly two wall endpoints"
+
+    def outward_dir(ep: tuple[int, int]) -> tuple[tuple[int, int], bool]:
+        n1 = comp_neighbors(*ep)[0]
+        d1 = (_sgn(n1[0] - ep[0]), _sgn(n1[1] - ep[1]))
+        d_use = d1
+        is_12 = False
+        n2s = [p for p in comp_neighbors(*n1) if p != ep]
+        if n2s:
+            n2 = n2s[0]
+            d2 = (_sgn(n2[0] - n1[0]), _sgn(n2[1] - n1[1]))
+            if (d1[0] == 0) ^ (d1[1] == 0) and d2[0] != 0 and d2[1] != 0:
+                d_use = d2
+                is_12 = True
+        return (-d_use[0], -d_use[1]), is_12
+
+    out_info = [outward_dir(ep) for ep in endpoints]
+    out_dirs = [d for d, _ in out_info]
+    tip_12 = [flag for _, flag in out_info]
+    rad = (_sgn(sum(d[0] for d in out_dirs)), _sgn(sum(d[1] for d in out_dirs)))
+    assert rad != (0, 0), "expected a cardinal radiate direction"
+
+    barrier = comp_mask.copy()
+
+    def add_ray(start: tuple[int, int], d: tuple[int, int]) -> None:
+        rr, cc = start
+        while True:
+            rr += d[0]
+            cc += d[1]
+            if not (0 <= rr < h and 0 <= cc < w):
+                break
+            barrier[rr, cc] = True
+
+    def add_ray_12(start: tuple[int, int], d: tuple[int, int]) -> None:
+        rr, cc = start
+        step = 0
+        while True:
+            step += 1
+            if step % 2 == 1:
+                rr += d[0]
+                cc += d[1]
+            elif rad[0] != 0:
+                rr += d[0]
+            else:
+                cc += d[1]
+            if not (0 <= rr < h and 0 <= cc < w):
+                break
+            barrier[rr, cc] = True
+
+    for ep, d, is_12 in zip(endpoints, out_dirs, tip_12, strict=False):
+        if is_12:
+            add_ray_12(ep, d)
+        else:
+            add_ray(ep, d)
+
+    passable = (~barrier) & ((g == bg) | (g == fill))
+    q = fill_pos[:]
+    seen = np.zeros_like(passable, dtype=bool)
+    for r, c in q:
+        if passable[r, c]:
+            seen[r, c] = True
+
+    while q:
+        r, c = q.pop()
+        for rr, cc in neighbors4(r, c):
+            if 0 <= rr < h and 0 <= cc < w and passable[rr, cc] and not seen[rr, cc]:
+                seen[rr, cc] = True
+                q.append((rr, cc))
+
+    filled_mask = seen & (g == bg)
+    out = g.copy()
+    out[filled_mask] = fill
+    return out, {"bg": bg, "wall": wall, "fill": fill, "filled_mask": filled_mask, "rad": rad}
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Fill the funnel interior and radiate the fill outward, then crop to the active footprint.
+
+    Input structure:
+    - The most common color is background.
+    - The most frequent non-background color is a single wall sprite forming a partial enclosure.
+    - The remaining non-background color is a fill seed/blob placed inside that enclosure; there are no obstacle pixels.
+
+    Rule:
+    - Infer the opening direction from the two wall endpoints.
+    - Treat the wall and the two endpoint rays as barriers, then flood-fill reachable background cells from the seed.
+    - The fill expands inside the enclosure and continues through the opening within the wedge defined by the rays.
+    - Return only the minimal bounding rectangle containing all non-background pixels of the transformed result.
+
+    Key insight:
+    - The wall geometry alone determines both the wedge of allowed fill and the crop bounds: once the endpoint directions are known,
+      the full-canvas fill can be reconstructed and then tightly cropped around the resulting wall-plus-radiation shape.
+    """
+    full_out, info = _solve_full(grid)
+    return _tight_crop_active(full_out, info["bg"])
+
+
+# --------------- generator (o5x) ---------------
+
+GRID_H_VERT = (11, 18)
+GRID_H_HORIZ = (8, 18)
+GRID_W = (15, 19)
+
+WALL_PIXELS_MIN = 17
+WALL_PIXELS_MAX = 25
+DEPTH_VERT = (5, 10)
+DEPTH_HORIZ = (6, 8)
+GAP_VERT = (6, 7)
+GAP_HORIZ = (5, 7)
+TIP_12_PROB = 0.5
+
+OPEN_END_MARGIN = 3
+CLOSED_END_MARGIN = 2
+SIDE_MARGIN = 1
+
+SEED_SIZE_WEIGHTS = [1, 1, 1, 1, 2, 2, 3, 4, 5, 6]
+SEED_DEPTH_LOOKBACK = 3
+
+MIN_NEW_FILL = 20
+MIN_MARGIN_SUM = 3
+GEN_RETRIES = 300
+
+
+def _degree1_pixels(points: set[tuple[int, int]]) -> list[tuple[int, int]]:
+    pts = set(points)
+    return [(r, c) for r, c in pts if sum((rr, cc) in pts for rr, cc in neighbors8(r, c)) == 1]
+
+
+def _make_arm(depth: int, start_v: int, target_v: int, extra_steps: int, tip_12: bool = False) -> list[tuple[int, int]]:
+    sign = 1 if target_v > start_v else -1
+    n_side_steps = abs(target_v - start_v)
+    chosen_rows: list[int] = []
+    if n_side_steps:
+        if tip_12:
+            chosen_rows = [2 * (i + 1) for i in range(n_side_steps)]
+            extra_steps = 0
+        else:
+            chosen_rows = [1]
+            if n_side_steps > 1:
+                chosen_rows += random.sample(range(2, depth + 1), n_side_steps - 1)
+            chosen_rows.sort()
+
+    first_row = chosen_rows[0] if chosen_rows else 1
+    extra_rows = [r for r in chosen_rows if r != first_row]
+    random.shuffle(extra_rows)
+    orthogonal_rows = set(extra_rows[:extra_steps])
+
+    pts = [(0, start_v)]
+    u, v = 0, start_v
+    for row in range(1, depth + 1):
+        u += 1
+        if row in orthogonal_rows:
+            pts.append((u, v))
+            v += sign
+        elif row in chosen_rows:
+            v += sign
+        pts.append((u, v))
+    return pts
+
+
+def _build_local_wall(rad: tuple[int, int], h: int, w: int) -> tuple[set[tuple[int, int]], int, int] | None:
+    if rad[0]:
+        max_depth = min(DEPTH_VERT[1], h - 6)
+        if max_depth < DEPTH_VERT[0]:
+            return None
+        depth = random.randint(DEPTH_VERT[0], max_depth)
+        gap = random.randint(*GAP_VERT)
+    else:
+        depth = random.randint(DEPTH_HORIZ[0], min(DEPTH_HORIZ[1], w - 6))
+        gap = random.randint(GAP_HORIZ[0], min(GAP_HORIZ[1], h - 1))
+
+    if gap == 5:
+        left_bottom, right_bottom = 2, 3
+    elif gap == 6:
+        left_bottom, right_bottom = 2, 4
+    else:
+        left_bottom, right_bottom = random.choice([(2, 5), (3, 4)])
+
+    bridge_extra = max(0, right_bottom - left_bottom - 1)
+    base_count = 2 * (depth + 1) + bridge_extra
+    max_extra_l = max(0, left_bottom - 1)
+    max_extra_r = max(0, gap - right_bottom - 1)
+    min_extra = max(0, WALL_PIXELS_MIN - base_count)
+    max_extra = min(max_extra_l + max_extra_r, WALL_PIXELS_MAX - base_count)
+    if min_extra > max_extra:
+        return None
+
+    extra = random.randint(min_extra, max_extra)
+    extra_l = random.randint(max(0, extra - max_extra_r), min(max_extra_l, extra))
+    extra_r = extra - extra_l
+
+    max_n_side = max(left_bottom, gap - right_bottom)
+    tip_12 = depth >= 2 * max_n_side and random.random() < TIP_12_PROB
+    left = _make_arm(depth, 0, left_bottom, extra_l, tip_12=tip_12)
+    right = _make_arm(depth, gap, right_bottom, extra_r, tip_12=tip_12)
+    pts = set(left) | set(right)
+    for v in range(left_bottom, right_bottom + 1):
+        pts.add((depth, v))
+
+    while len(pts) < WALL_PIXELS_MIN:
+        candidates = [
+            (u, v)
+            for u in range(max(0, depth - 3), depth + 1)
+            for v in range(gap + 1)
+            if (u, v) not in pts
+            and sum(
