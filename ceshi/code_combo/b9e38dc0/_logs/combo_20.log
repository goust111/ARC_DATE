                    if all(0 <= c < W for _, c in w3):
                        options.append((w3, 'dr'))
                    options.append(([(wr, wc)], 'dr'))
                # Vertical wall (flips dc): center pixel at (cur_r, cur_c+cur_dc)
                wr2, wc2 = cur_r, cur_c + cur_dc
