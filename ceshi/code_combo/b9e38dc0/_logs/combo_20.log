                        continue
                    chosen_wall = (wpxs, flip)
                    break
                if chosen_wall is None:
                    ok = False; break

                wpxs, flip = chosen_wall
                wcol = _rng.choice(palette)
                walls.append((wpxs, wcol))

                # Bounce cell adopts wall color in output
                if ray_cells:
                    lr, lc, _ = ray_cells[-1]
                    ray_cells[-1] = (lr, lc, wcol)
                cur_col = wcol
                if flip == 'dr':
                    cur_dr = -cur_dr
                else:
                    cur_dc = -cur_dc

