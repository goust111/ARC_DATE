+
+def _add_ray(barrier: np.ndarray, start: Coord, d: Coord) -> None:
+    h, w = barrier.shape
+    rr, cc = start
+    while True:
+        rr += d[0]
+        cc += d[1]
+        if not (0 <= rr < h and 0 <= cc < w):
+            break
+        barrier[rr, cc] = True
+
+
+def _add_ray_12(barrier: np.ndarray, start: Coord, d: Coord, rad: Coord) -> None:
+    h, w = barrier.shape
+    rr, cc = start
+    step = 0
+    while True:
+        step += 1
+        if step % 2 == 1:
+            rr += d[0]
+            cc += d[1]
+        elif rad[0] != 0:
+            rr += d[0]
+        else:
+            cc += d[1]
+        if not (0 <= rr < h and 0 <= cc < w):
+            break
+        barrier[rr, cc] = True
