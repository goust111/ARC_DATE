 # Combo variant of b9e38dc0 (index 20)
 # combo_spec: D2/0+D18/0
 # Name: 距离决定步长+对角线移动
+#
+# Design analysis for the fused rule
+# a) Concrete behavior:
+#    The wall funnel and seed-filling geometry stay intact. What changes is the
+#    treatment of extra singleton pixels. For example, with an upward opening,
+#    a singleton above-left of the opening that starts at wall-distance 3 paints
+#    only the 3rd, 6th, 9th, ... cells on an up-left diagonal instead of making
+#    a dense straight trace.
+# b) Complexity calibration:
+#    Diagonal choice is binary per side of the opening; generated step sizes are
+#    limited to 2-4 so the spacing rule is visible rather than noisy.
+# c) Hidden assumptions:
+#    Extra non-wall pixels are no longer static blockers. New assumptions are:
+#    they are singleton components, they sit outside the nominal fill zone, and
+#    their diagonal route stays clear. The generator guarantees that.
+# d) Placement legality:
+#    Generator candidates are bg cells only; any candidate whose full diagonal
+#    route touches wall/fill/non-bg cells or overlaps another route is rejected.
+# e) Visual observability:
+#    Each sample contains multiple movers with at least two distinct distances
+#    and both diagonal branches when possible, so the spacing rule repeats.
+# f) Visual cleanliness:
+#    Sparse trails are kept outside the main filled cone to avoid clutter.
+# g) Inferability:
+#    No rule depends on numeric color ids. Geometry alone determines direction
+#    and spacing.
+
+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+from arc_utils import components_mask, get_bg, neighbors4, neighbors8
+
+Coord = tuple[int, int]
+
+
+class Scene:
+    def __init__(
+        self,
+        bg: int,
+        wall: int,
+        fill: int,
+        wall_comp: set[Coord],
+        fill_pos: list[Coord],
+        rad: Coord,
+        opening_center: tuple[float, float],
+        filled_mask: np.ndarray,
+    ) -> None:
+        self.bg = bg
+        self.wall = wall
+        self.fill = fill
+        self.wall_comp = wall_comp
+        self.fill_pos = fill_pos
+        self.rad = rad
+        self.opening_center = opening_center
+        self.filled_mask = filled_mask
+
+
+def _sgn(x: int) -> int:
+    return (x > 0) - (x < 0)
+
+
+def _comp_neighbors(mask: np.ndarray, r: int, c: int) -> list[Coord]:
+    h, w = mask.shape
+    return [
+        (int(rr), int(cc))
+        for rr, cc in neighbors8(r, c)
+        if 0 <= rr < h and 0 <= cc < w and mask[rr, cc]
+    ]
+
+
+def _outward_dir(mask: np.ndarray, ep: Coord) -> tuple[Coord, bool]:
+    n1 = _comp_neighbors(mask, *ep)[0]
+    d1 = (_sgn(n1[0] - ep[0]), _sgn(n1[1] - ep[1]))
+    d_use = d1
+    is_12 = False
+    n2s = [p for p in _comp_neighbors(mask, *n1) if p != ep]
+    if n2s:
+        n2 = n2s[0]
+        d2 = (_sgn(n2[0] - n1[0]), _sgn(n2[1] - n1[1]))
+        if (d1[0] == 0) ^ (d1[1] == 0) and d2[0] != 0 and d2[1] != 0:
+            d_use = d2
+            is_12 = True
+    return (-d_use[0], -d_use[1]), is_12
+
+
+def _add_ray(barrier: np.ndarray, start: Coord, d: Coord) -> None:
+    h, w = barrier.shape
+    rr, cc = start
+    while True:
+        rr += d[0]
+        cc += d[1]
+        if not (0 <= rr < h and 0 <= cc < w):
+            break
+        barrier[rr, cc] = True
+
+
+def _add_ray_12(barrier: np.ndarray, start: Coord, d: Coord, rad: Coord) -> None:
+    h, w = barrier.shape
+    rr, cc = start
+    step = 0
+    while True:
+        step += 1
+        if step % 2 == 1:
+            rr += d[0]
+            cc += d[1]
+        elif rad[0] != 0:
+            rr += d[0]
+        else:
+            cc += d[1]
+        if not (0 <= rr < h and 0 <= cc < w):
+            break
+        barrier[rr, cc] = True
+
+
+def _build_scene(grid: np.ndarray) -> Scene:
+    g = np.array(grid, copy=False)
+    h, w = g.shape
+    bg = int(get_bg(g))
+    non_bg = [int(v) for v in np.unique(g) if int(v) != bg]
+    assert non_bg, "expected non-background colors"
+
+    wall = max(non_bg, key=lambda c: int((g == c).sum()))
+    wall_mask = g == wall
+    comps = [set((int(r), int(c)) for r, c in pts) for pts in components_mask(wall_mask, connectivity=8)]
+    assert comps, "expected wall component"
+
+    other_colors = [c for c in non_bg if c != wall]
+    assert other_colors, "expected fill color"
+    wall_points = [p for comp in comps for p in comp]
+
+    def min_dist_to_wall(color: int) -> tuple[int, int]:
+        pts = [(int(r), int(c)) for r, c in zip(*np.where(g == color))]
+        best = 10**9
+        for r, c in pts:
+            for wr, wc in wall_points:
+                d = abs(r - wr) + abs(c - wc)
+                if d < best:
+                    best = d
+                    if best == 0:
+                        return 0, len(pts)
+        return best, len(pts)
+
+    fill = min(other_colors, key=lambda c: (min_dist_to_wall(c)[0], min_dist_to_wall(c)[1]))
+    fill_pos = [(int(r), int(c)) for r, c in zip(*np.where(g == fill))]
+    assert fill_pos, "expected fill seed"
+
+    def comp_min_dist(comp: set[Coord]) -> int:
+        best = 10**9
+        for r, c in fill_pos:
+            for wr, wc in comp:
+                d = abs(r - wr) + abs(c - wc)
+                if d < best:
+                    best = d
+                    if best == 0:
+                        return 0
+        return best
+
+    wall_comp = min(comps, key=lambda comp: (comp_min_dist(comp), -len(comp)))
+    comp_mask = np.zeros_like(wall_mask, dtype=bool)
+    for r, c in wall_comp:
+        comp_mask[r, c] = True
+
+    endpoints = [(r, c) for r, c in wall_comp if len(_comp_neighbors(comp_mask, r, c)) == 1]
+    assert len(endpoints) >= 2, "expected two endpoints"
+
+    out_info = [_outward_dir(comp_mask, ep) for ep in endpoints]
+    out_dirs = [d for d, _ in out_info]
+    tip_12 = [flag for _, flag in out_info]
+    rad = (_sgn(sum(d[0] for d in out_dirs)), _sgn(sum(d[1] for d in out_dirs)))
+    assert rad != (0, 0), "failed to infer radiate direction"
+
+    barrier = comp_mask.copy()
+    for ep, d, is_12 in zip(endpoints, out_dirs, tip_12):
+        if is_12:
+            _add_ray_12(barrier, ep, d, rad)
+        else:
+            _add_ray(barrier, ep, d)
+
+    passable = (~barrier) & ((g == bg) | (g == fill))
+    q = fill_pos[:]
+    seen = np.zeros_like(passable, dtype=bool)
+    for r, c in q:
+        if passable[r, c]:
+            seen[r, c] = True
+    while q:
+        r, c = q.pop()
+        for rr, cc in neighbors4(r, c):
+            if 0 <= rr < h and 0 <= cc < w and passable[rr, cc] and not seen[rr, cc]:
+                seen[rr, cc] = True
+                q.append((int(rr), int(cc)))
+
+    return Scene(
+        bg=bg,
+        wall=wall,
+        fill=fill,
+        wall_comp=wall_comp,
+        fill_pos=fill_pos,
+        rad=rad,
+        opening_center=(
+            sum(r for r, _ in endpoints) / len(endpoints),
+            sum(c for _, c in endpoints) / len(endpoints),
+        ),
+        filled_mask=seen & (g == bg),
+    )
 
-"""
-Design analysis for the fused variant.
 
-- Concrete behavior:
-  The original core still exists: a wall component defines an opening, the seed
-  color floods the enclosed region and radiates outward through the opening.
-  The modified auxiliary object is every extra singleton pixel. Instead of being
-  treated as a straight-line side effect, each singleton moves on a 45-degree
-  ray. The diagonal's forward axis matches the wall opening direction, while the
-  sideways sign comes from whether the singleton starts on the left/right side
-  of a vertical opening or the upper/lower side of a horizontal opening.
-  Its painting period is its initial Manhattan distance to the wall component.
-  Example: if a red singleton is 3 cells from the wall, the output erases the
-  start cell and paints the 3rd, 6th, 9th, ... cells on that diagonal.
+def _distance_to_wall(scene: Scene, pos: Coord) -> int:
+    r, c = pos
+    return min(max(abs(r - wr), abs(c - wc)) for wr, wc in scene.wall_comp)
 
-- Complexity calibration:
-  A fully free-form distance would be hard to infer, so the generator restricts
-  spacing to a small visible set {2,3,4} and usually places 2-3 movers in one
-  grid. This creates repeated evidence without collapsing different movers into
-  the same path.
 
-- Hidden-assumption audit:
-  The original code treated every non-wall/non-fill pixel as an obstacle that
-  blocks fill. That conflicts with the new interpretation, because singleton
-  pixels must now become movers. To remove the ambiguity, the fused generator
-  omits shadow-obstacles entirely, and the solver interprets extra singleton
-  components as movers. Larger extra components are ignored rather than being
-  overloaded with a second meaning.
+def _diag_dir(scene: Scene, pos: Coord) -> Coord:
+    r, c = pos
+    if scene.rad[0] != 0:
+        return (scene.rad[0], -1 if c <= scene.opening_center[1] else 1)
+    return (-1 if r <= scene.opening_center[0] else 1, scene.rad[1])
 
-- Placement legality:
-  Movers are generated only on background cells outside the radiating fill cone.
-  Their full diagonal traversals are pre-simulated so they do not overlap the
-  wall, the seed/fill zone, or each other, and so each mover leaves at least two
-  painted landing cells before hitting the border.
 
-- Visual observability:
-  The sparse diagonal trail is visible by eye, and the period can be checked
-  against the visible gap from mover to wall. Using only one mover color keeps
-  the rule about geometry and spacing, not about hidden color ordering.
+def _trace_diag(shape: tuple[int, int], start: Coord, d: Coord) -> list[Coord]:
+    h, w = shape
+    rr, cc = start
+    trace = []
+    while True:
+        rr += d[0]
+        cc += d[1]
+        if not (0 <= rr < h and 0 <= cc < w):
+            break
+        trace.append((int(rr), int(cc)))
+    return trace
 
-- Visual cleanliness:
-  Fill stays in one coherent wedge, while mover trails stay outside it on the
-  radiating side. This avoids stacked semantics in the same cells.
 
