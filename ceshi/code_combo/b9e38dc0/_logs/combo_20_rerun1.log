GRID_H_HORIZ = (9, 18)
GRID_W = (15, 19)

# Wall geometry
WALL_PIXELS_MIN = 17
WALL_PIXELS_MAX = 25
DEPTH_VERT = (5, 10)
DEPTH_HORIZ = (6, 8)
GAP_VERT = (6, 7)
GAP_HORIZ = (5, 7)
TIP_12_PROB = 0.5
OPEN_END_MARGIN = 3

# Seed placement
SEED_SIZE_WEIGHTS = [1, 1, 1, 1, 2, 2, 3, 4, 5, 6]
SEED_DEPTH_LOOKBACK = 3

# Singleton movers
ISOLATE_COUNT_RANGE = (2, 4)
ISOLATE_STEP_RANGE = (2, 4)
MIN_DIAG_MARKS = 2
MIN_DIST_BETWEEN_PATHS = 2

# Validation
MIN_NEW_FILL = 20
GEN_RETRIES = 400


def _degree1_pixels(points: set[Coord]) -> list[Coord]:
    pts = set(points)
    return [
        (r, c)
        for r, c in pts
        if sum((rr, cc) in pts for rr, cc in neighbors8(r, c)) == 1
    ]


def _make_arm(depth: int, start_v: int, target_v: int, extra_steps: int, tip_12: bool = False) -> list[Coord]:
    sign = 1 if target_v > start_v else -1
    n_side_steps = abs(target_v - start_v)
    chosen_rows: list[int] = []
    if n_side_steps:
        if tip_12:
            chosen_rows = [2 * (i + 1) for i in range(n_side_steps)]
            extra_steps = 0
        else:
            chosen_rows = [1]
            if n_side_steps > 1:
                chosen_rows += random.sample(range(2, depth + 1), n_side_steps - 1)
            chosen_rows.sort()

    first_row = chosen_rows[0] if chosen_rows else 1
    extra_rows = [r for r in chosen_rows if r != first_row]
    random.shuffle(extra_rows)
    orthogonal_rows = set(extra_rows[:extra_steps])

    pts = [(0, start_v)]
    u, v = 0, start_v
    for row in range(1, depth + 1):
        u += 1
        if row in orthogonal_rows:
            pts.append((u, v))
            v += sign
        elif row in chosen_rows:
            v += sign
        pts.append((u, v))
    return pts


def _build_local_wall(rad: Coord, h: int, w: int) -> tuple[set[Coord], int, int] | None:
    if rad[0]:
        max_depth = min(DEPTH_VERT[1], h - 6)
        if max_depth < DEPTH_VERT[0]:
            return None
        depth = random.randint(DEPTH_VERT[0], max_depth)
        gap = random.randint(*GAP_VERT)
    else:
        depth = random.randint(DEPTH_HORIZ[0], min(DEPTH_HORIZ[1], w - 6))
        gap = random.randint(GAP_HORIZ[0], min(GAP_HORIZ[1], h - 1))

    if gap == 5:
        left_bottom, right_bottom = 2, 3
    elif gap == 6:
        left_bottom, right_bottom = 2, 4
    else:
        left_bottom, right_bottom = random.choice([(2, 5), (3, 4)])

    bridge_extra = max(0, right_bottom - left_bottom - 1)
    base_count = 2 * (depth + 1) + bridge_extra
    max_extra_l = max(0, left_bottom - 1)
    max_extra_r = max(0, gap - right_bottom - 1)
    min_extra = max(0, WALL_PIXELS_MIN - base_count)
    max_extra = min(max_extra_l + max_extra_r, WALL_PIXELS_MAX - base_count)
    if min_extra > max_extra:
        return None

    extra = random.randint(min_extra, max_extra)
    extra_l = random.randint(max(0, extra - max_extra_r), min(max_extra_l, extra))
    extra_r = extra - extra_l

    max_n_side = max(left_bottom, gap - right_bottom)
    tip_12 = depth >= 2 * max_n_side and random.random() < TIP_12_PROB
    left = _make_arm(depth, 0, left_bottom, extra_l, tip_12=tip_12)
    right = _make_arm(depth, gap, right_bottom, extra_r, tip_12=tip_12)
    pts = set(left) | set(right)
    for v in range(left_bottom, right_bottom + 1):
        pts.add((depth, v))

    while len(pts) < WALL_PIXELS_MIN:
        candidates = [
            (u, v)
            for u in range(max(0, depth - 3), depth + 1)
            for v in range(gap + 1)
            if (u, v) not in pts
            and sum(
                (uu, vv) in pts
                for uu in range(u - 1, u + 2)
                for vv in range(v - 1, v + 2)
                if (uu, vv) != (u, v)
            ) >= 2
        ]
        random.shuffle(candidates)
        added = False
        for p in candidates:
            trial = pts | {p}
            if len(trial) <= WALL_PIXELS_MAX and len(_degree1_pixels(trial)) == 2:
                pts = trial
                added = True
                break
        if not added:
            return None

    if not (WALL_PIXELS_MIN <= len(pts) <= WALL_PIXELS_MAX) or len(_degree1_pixels(pts)) != 2:
        return None
    return pts, depth, gap


def _map_local(u: int, v: int, rad: Coord, anchor: Coord) -> Coord:
    r0, c0 = anchor
    if rad == (-1, 0):
        return r0 + u, c0 + v
    if rad == (1, 0):
        return r0 - u, c0 + v
    if rad == (0, -1):
        return r0 + v, c0 + u
    return r0 + v, c0 - u


def _place_anchor(rad: Coord, h: int, w: int, depth: int, gap: int) -> Coord:
    if rad == (-1, 0):
        return random.randint(OPEN_END_MARGIN, h - depth - 3), random.randint(0, w - gap - 1)
    if rad == (1, 0):
        return random.randint(depth + 2, h - 4), random.randint(0, w - gap - 1)
    if rad == (0, -1):
        return random.randint(0, h - gap - 1), random.randint(OPEN_END_MARGIN, w - depth - 3)
    return random.randint(0, h - gap - 1), random.randint(depth + 2, w - 4)


def _local_interior(wall: set[Coord], depth: int, gap: int) -> list[Coord]:
    by_row: dict[int, list[int]] = {}
    for u, v in wall:
        by_row.setdefault(u, []).append(v)
    interior = []
    for u in range(1, depth):
        if u not in by_row or len(by_row[u]) < 2:
            continue
        lo, hi = min(by_row[u]), max(by_row[u])
        for v in range(lo + 1, hi):
            if (u, v) not in wall:
                interior.append((u, v))
    return interior


def _grow_seed_blob(seed: Coord, interior_set: set[Coord]) -> set[Coord]:
    blob = {seed}
    frontier = [seed]
    target_size = random.choice(SEED_SIZE_WEIGHTS)
    while len(blob) < target_size and frontier:
        u, v = frontier.pop(random.randrange(len(frontier)))
        for q in random.sample([(u - 1, v), (u + 1, v), (u, v - 1), (u, v + 1)], 4):
            if q in interior_set and q not in blob:
                blob.add(q)
                frontier.append(q)
                if len(blob) >= target_size:
                    break
    return blob


def _touches_border(mask: np.ndarray) -> bool:
    return bool(mask[0, :].any() or mask[-1, :].any() or mask[:, 0].any() or mask[:, -1].any())


def _min_trace_gap(trace_a: list[Coord], trace_b: list[Coord]) -> int:
    best = 10**9
    for ra, ca in trace_a:
        for rb, cb in trace_b:
            best = min(best, max(abs(ra - rb), abs(ca - cb)))
            if best == 0:
                return 0
    return best if best < 10**9 else 10**9


def _singleton_candidates(grid: np.ndarray, scene: Scene) -> list[dict]:
    g = np.array(grid, copy=False)
    candidates: list[dict] = []
    occupied_non_bg = g != scene.bg
    for r, c in zip(*np.where(g == scene.bg)):
        pos = (int(r), int(c))
        if scene.filled_mask[pos]:
            continue
        step = _distance_to_wall(scene, pos)
        if not (ISOLATE_STEP_RANGE[0] <= step <= ISOLATE_STEP_RANGE[1]):
            continue
        d = _diag_dir(scene, pos)
        if scene.rad[0] != 0 and abs(c - scene.opening_center[1]) < 1.0:
            continue
        if scene.rad[1] != 0 and abs(r - scene.opening_center[0]) < 1.0:
            continue
        trace = _trace_diag(g.shape, pos, d)
        if len(trace) < step * MIN_DIAG_MARKS:
            continue
        if any(occupied_non_bg[rr, cc] or scene.filled_mask[rr, cc] for rr, cc in trace):
            continue
        marks = [trace[i] for i in range(step - 1, len(trace), step)]
        if len(marks) < MIN_DIAG_MARKS:
            continue
        candidates.append(
            {
                "pos": pos,
                "step": step,
                "dir": d,
                "trace": trace,
                "marks": marks,
            }
        )
    random.shuffle(candidates)
    candidates.sort(key=lambda cand: (cand["step"], -len(cand["marks"])))
    return candidates


def _select_singletons(candidates: list[dict], rad: Coord) -> list[dict]:
    target_n = random.randint(*ISOLATE_COUNT_RANGE)
    selected: list[dict] = []
    used_sources: set[Coord] = set()
    sides_seen: set[int] = set()
    steps_seen: set[int] = set()

    def side_key(cand: dict) -> int:
        return cand["dir"][1] if rad[0] != 0 else cand["dir"][0]

    pools = sorted(candidates, key=lambda cand: (len(steps_seen), len(sides_seen), -len(cand["marks"])))
    for cand in pools:
        pos = cand["pos"]
        if pos in used_sources:
            continue
        if any(_min_trace_gap(cand["trace"], other["trace"]) < MIN_DIST_BETWEEN_PATHS for other in selected):
            continue
        if any(max(abs(pos[0] - op[0]), abs(pos[1] - op[1])) < MIN_DIST_BETWEEN_PATHS for op in used_sources):
            continue
        need_side = len(sides_seen) < 2 and side_key(cand) not in sides_seen
        need_step = len(steps_seen) < 2 and cand["step"] not in steps_seen
        if len(selected) >= 2 and not need_side and not need_step and random.random() < 0.45:
            continue
        selected.append(cand)
        used_sources.add(pos)
        sides_seen.add(side_key(cand))
        steps_seen.add(cand["step"])
        if len(selected) >= target_n and len(steps_seen) >= 2 and len(sides_seen) >= 2:
            break

    if len(selected) < 2 or len(steps_seen) < 2 or len(sides_seen) < 2:
        return []
    return selected


def _gen_attempt() -> np.ndarray | None:
    rad = random.choice([(-1, 0), (1, 0), (0, -1), (0, 1)])
    h = random.randint(*GRID_H_VERT) if rad[0] else random.randint(*GRID_H_HORIZ)
    w = random.randint(*GRID_W)

    built = _build_local_wall(rad, h, w)
    if built is None:
        return None
    local_wall, depth, gap = built
    anchor = _place_anchor(rad, h, w, depth, gap)

    colors = random.sample(range(10), 4)
    bg, wall_color, fill_color, isolate_color = colors

    grid = np.full((h, w), bg, dtype=int)
    for u, v in local_wall:
        r, c = _map_local(u, v, rad, anchor)
        grid[r, c] = wall_color

    interior = _local_interior(local_wall, depth, gap)
    wall_set = set(local_wall)
    adjacent = [
        p for p in interior
        if any((p[0] + dr, p[1] + dc) in wall_set for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)])
    ]
    seed_pool = [p for p in adjacent if p[0] >= max(1, depth - SEED_DEPTH_LOOKBACK)]
    if not seed_pool:
        return None

    blob = _grow_seed_blob(random.choice(seed_pool), set(interior))
    for u, v in blob:
        r, c = _map_local(u, v, rad, anchor)
        if grid[r, c] != bg:
            return None
        grid[r, c] = fill_color

    try:
        scene = _build_scene(grid)
    except Exception:
        return None

    candidates = _singleton_candidates(grid, scene)
    chosen = _select_singletons(candidates, scene.rad)
    if not chosen:
        return None


