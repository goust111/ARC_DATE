 # Combo variant of b9e38dc0 (index 20)
 # combo_spec: D2/0+D18/0
 # Name: 距离决定步长+对角线移动
+#
+# Design analysis for the fused rule
+# a) Concrete behavior:
+#    Original core geometry stays the same: a wall funnel encloses a seed, the seed
+#    flood-fills the interior and radiates through the opening. The changed object is
+#    the extra singleton pixel. Example with an upward opening: if a singleton sits
+#    above-left of the opening and its nearest wall pixel is Chebyshev distance 3,
+#    the old straight-ray idea would have produced a dense vertical run. The fused
+#    rule instead moves it along the up-left diagonal and paints only every 3rd cell,
+#    yielding marks at offsets 3, 6, 9, ... while the skipped cells stay bg.
+# b) Complexity calibration:
+#    The diagonal branch is binary per example side: for vertical radiation the pixel
+#    chooses left-vs-right diagonal; for horizontal radiation it chooses up-vs-down.
+#    Step sizes are restricted to 2-4 in generated samples so humans see repetition
+#    without the grids becoming sparse noise.
+# c) Hidden-assumption audit:
+#    The original solver assumed all extra non-wall pixels were static blockers used
+#    only in a radiate-direction scan. That assumption is removed. New assumptions:
+#    extras must be singleton components, they should sit outside the nominal fill
+#    zone so they do not interfere with flood-fill, and their diagonal tracks should
+#    have at least two visible painted marks. The generator enforces all three.
+# d) Placement legality:
+#    The generator samples singleton sources only from bg cells, rejects any candidate
+#    whose full diagonal route would hit wall/fill/non-bg cells, and rejects overlap
+#    between different singleton routes.
+# e) Visual observability:
+#    Each grid contains multiple singleton pixels with at least two distinct step
+#    values and usually both diagonal branches. This makes "distance controls spacing"
+#    inferable from 2-4 examples instead of looking like arbitrary sparse noise.
+# f) Visual cleanliness:
+#    Singleton tracks are kept outside the main filled cone, so the fill region, wall,
+#    seed, and sparse diagonal marks occupy separable regions.
+# g) Inferability:
+#    No ordering depends on hidden color ids. The moving singletons can share one
+#    color; the only cue that changes their spacing is geometric distance to the wall.
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+import random
+
+import numpy as np
+
+from arc_utils import components_mask, get_bg, neighbors4, neighbors8
+
+Coord = tuple[int, int]
+
+
+@dataclass
+class Scene:
+    bg: int
+    wall: int
+    fill: int
+    wall_comp: set[Coord]
+    comp_mask: np.ndarray
+    fill_pos: list[Coord]
+    rad: Coord
+    opening_center: tuple[float, float]
+    filled_mask: np.ndarray
+
+
+def _sgn(x: int) -> int:
+    return (x > 0) - (x < 0)
+
+
+def _comp_neighbors(mask: np.ndarray, r: int, c: int) -> list[Coord]:
+    h, w = mask.shape
+    out = []
+    for rr, cc in neighbors8(r, c):
+        if 0 <= rr < h and 0 <= cc < w and mask[rr, cc]:
+            out.append((int(rr), int(cc)))
+    return out
+
+
+def _outward_dir(mask: np.ndarray, ep: Coord, rad_hint: Coord | None = None) -> tuple[Coord, bool]:
+    n1 = _comp_neighbors(mask, *ep)[0]
+    d1 = (_sgn(n1[0] - ep[0]), _sgn(n1[1] - ep[1]))
+    d_use = d1
+    is_12 = False
+    n2s = [p for p in _comp_neighbors(mask, *n1) if p != ep]
+    if n2s:
+        n2 = n2s[0]
+        d2 = (_sgn(n2[0] - n1[0]), _sgn(n2[1] - n1[1]))
+        if (d1[0] == 0) ^ (d1[1] == 0) and d2[0] != 0 and d2[1] != 0:
+            d_use = d2
+            is_12 = True
+    return (-d_use[0], -d_use[1]), is_12
 
