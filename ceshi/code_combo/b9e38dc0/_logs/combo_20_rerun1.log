+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Fill the funnel interior, then let isolated pixels fire sparse diagonal trails.
+
+    Input structure:
+    - bg is the dominant color. The most frequent non-bg color is a wall component
+      shaped like a partial enclosure whose endpoints define an opening.
+    - One non-wall color sits inside that enclosure and acts as the fill seed.
+    - Any other non-wall, non-fill singleton pixels are movers associated with the
+      same wall sprite.
+
+    Rule:
+    - Flood-fill the background reachable from the seed inside the enclosure and
+      through the opening, using the same endpoint-derived barrier rays as the
+      original task.
+    - Each isolated singleton disappears from its source cell, picks the diagonal
+      branch that continues the opening direction while leaning away from the
+      opening center, and then paints only every Nth cell on that diagonal.
+    - N is the singleton's initial Chebyshev distance to the wall component, so
+      farther pixels leave sparser trails.
+
+    Key insight:
+    - The wall still determines the global radiate axis, but the extra singleton
+      behavior is no longer "dense straight ahead". Their side relative to the
+      opening chooses the diagonal, and their initial distance to the wall chooses
+      the spacing of the painted marks.
+    """
+    g = np.array(grid, copy=True)
+    scene = _build_scene(g)
+    out = g.copy()
+    out[scene.filled_mask] = scene.fill
+
+    for spec in _singleton_specs(g, scene):
+        sr, sc = spec["pos"]
+        out[sr, sc] = scene.bg
+        for rr, cc in spec["marks"]:
+            if g[rr, cc] == scene.bg and out[rr, cc] == scene.bg:
+                out[rr, cc] = spec["color"]
+
+    return out
