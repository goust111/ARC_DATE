# Combo variant of b9e38dc0 (index 20)
# combo_spec: D2/0+D18/0
# Name: 距离决定步长+对角线移动
#
# Design analysis for the fused rule
# a) Concrete behavior:
#    Original core geometry stays the same: a wall funnel encloses a seed, the seed
#    flood-fills the interior and radiates through the opening. The changed object is
#    the extra singleton pixel. Example with an upward opening: if a singleton sits
#    above-left of the opening and its nearest wall pixel is Chebyshev distance 3,
#    the old straight-ray idea would have produced a dense vertical run. The fused
#    rule instead moves it along the up-left diagonal and paints only every 3rd cell,
#    yielding marks at offsets 3, 6, 9, ... while the skipped cells stay bg.
# b) Complexity calibration:
#    The diagonal branch is binary per example side: for vertical radiation the pixel
#    chooses left-vs-right diagonal; for horizontal radiation it chooses up-vs-down.
#    Step sizes are restricted to 2-4 in generated samples so humans see repetition
#    without the grids becoming sparse noise.
# c) Hidden-assumption audit:
#    The original solver assumed all extra non-wall pixels were static blockers used
#    only in a radiate-direction scan. That assumption is removed. New assumptions:
#    extras must be singleton components, they should sit outside the nominal fill
#    zone so they do not interfere with flood-fill, and their diagonal tracks should
#    have at least two visible painted marks. The generator enforces all three.
# d) Placement legality:
#    The generator samples singleton sources only from bg cells, rejects any candidate
#    whose full diagonal route would hit wall/fill/non-bg cells, and rejects overlap
#    between different singleton routes.
# e) Visual observability:
#    Each grid contains multiple singleton pixels with at least two distinct step
#    values and usually both diagonal branches. This makes "distance controls spacing"
#    inferable from 2-4 examples instead of looking like arbitrary sparse noise.
# f) Visual cleanliness:
#    Singleton tracks are kept outside the main filled cone, so the fill region, wall,
#    seed, and sparse diagonal marks occupy separable regions.
# g) Inferability:
#    No ordering depends on hidden color ids. The moving singletons can share one
#    color; the only cue that changes their spacing is geometric distance to the wall.

from __future__ import annotations

from dataclasses import dataclass
import random

import numpy as np

from arc_utils import components_mask, get_bg, neighbors4, neighbors8

Coord = tuple[int, int]


@dataclass
class Scene:
    bg: int
    wall: int
    fill: int
    wall_comp: set[Coord]
    comp_mask: np.ndarray
    fill_pos: list[Coord]
    rad: Coord
    opening_center: tuple[float, float]
    filled_mask: np.ndarray


def _sgn(x: int) -> int:
    return (x > 0) - (x < 0)


def _comp_neighbors(mask: np.ndarray, r: int, c: int) -> list[Coord]:
    h, w = mask.shape
    out = []
    for rr, cc in neighbors8(r, c):
        if 0 <= rr < h and 0 <= cc < w and mask[rr, cc]:
            out.append((int(rr), int(cc)))
    return out


def _outward_dir(mask: np.ndarray, ep: Coord, rad_hint: Coord | None = None) -> tuple[Coord, bool]:
    n1 = _comp_neighbors(mask, *ep)[0]
    d1 = (_sgn(n1[0] - ep[0]), _sgn(n1[1] - ep[1]))
    d_use = d1
    is_12 = False
    n2s = [p for p in _comp_neighbors(mask, *n1) if p != ep]
    if n2s:
        n2 = n2s[0]
        d2 = (_sgn(n2[0] - n1[0]), _sgn(n2[1] - n1[1]))
        if (d1[0] == 0) ^ (d1[1] == 0) and d2[0] != 0 and d2[1] != 0:
            d_use = d2
            is_12 = True
    return (-d_use[0], -d_use[1]), is_12


def _add_ray(barrier: np.ndarray, start: Coord, d: Coord, skip: int = 0) -> None:
    h, w = barrier.shape
    rr, cc = start
    for _ in range(skip):
        rr += d[0]
        cc += d[1]
    while True:
        rr += d[0]
        cc += d[1]
        if not (0 <= rr < h and 0 <= cc < w):
            break
        barrier[rr, cc] = True


def _add_ray_12(barrier: np.ndarray, start: Coord, d: Coord, rad: Coord) -> None:
    h, w = barrier.shape
    rr, cc = start
    step = 0
    while True:
        step += 1
        if step % 2 == 1:
            rr += d[0]
            cc += d[1]
        else:
            if rad[0] != 0:
                rr += d[0]
            else:
                cc += d[1]
        if not (0 <= rr < h and 0 <= cc < w):
            break
        barrier[rr, cc] = True


def _build_scene(grid: np.ndarray) -> Scene:
    g = np.array(grid, copy=False)
    h, w = g.shape
    bg = int(get_bg(g))
    vals = [int(v) for v in np.unique(g)]
    non_bg = [v for v in vals if v != bg]
    assert non_bg, "expected at least one non-background color"

    wall = max(non_bg, key=lambda c: int((g == c).sum()))
    wall_mask = g == wall
    comps = [set((int(r), int(c)) for r, c in pts) for pts in components_mask(wall_mask, connectivity=8)]
    assert comps, "expected wall component"

    other_colors = [c for c in non_bg if c != wall]
    assert other_colors, "expected fill color"
    wall_points = [p for comp in comps for p in comp]

    def min_dist_to_wall(color: int) -> tuple[int, int]:
        pts = [(int(r), int(c)) for r, c in zip(*np.where(g == color))]
        best = 10**9
        for r, c in pts:
            for wr, wc in wall_points:
                d = abs(r - wr) + abs(c - wc)
                if d < best:
                    best = d
                    if best == 0:
                        return 0, len(pts)
        return best, len(pts)

    fill = min(other_colors, key=lambda c: (min_dist_to_wall(c)[0], min_dist_to_wall(c)[1]))
    fill_pos = [(int(r), int(c)) for r, c in zip(*np.where(g == fill))]
    assert fill_pos, "expected fill seed"

    def comp_min_dist(comp: set[Coord]) -> int:
        best = 10**9
        for r, c in fill_pos:
            for wr, wc in comp:
                d = abs(r - wr) + abs(c - wc)
                if d < best:
                    best = d
                    if best == 0:
                        return 0
        return best

    wall_comp = min(comps, key=lambda comp: (comp_min_dist(comp), -len(comp)))
    comp_mask = np.zeros_like(wall_mask, dtype=bool)
    for r, c in wall_comp:
        comp_mask[r, c] = True

    endpoints = [(r, c) for r, c in wall_comp if len(_comp_neighbors(comp_mask, r, c)) == 1]
    assert len(endpoints) >= 2, "expected at least two endpoints"

    out_info = [_outward_dir(comp_mask, ep) for ep in endpoints]
    out_dirs = [d for d, _ in out_info]
    tip_12 = [flag for _, flag in out_info]
    dr_sum = sum(d[0] for d in out_dirs)
    dc_sum = sum(d[1] for d in out_dirs)
    rad = (_sgn(dr_sum), _sgn(dc_sum))
    assert rad != (0, 0), "failed to infer radiate direction"

    barrier = comp_mask.copy()
    for ep, d, is_12 in zip(endpoints, out_dirs, tip_12):
        if is_12:
            _add_ray_12(barrier, ep, d, rad)
        else:
            _add_ray(barrier, ep, d)

    passable = (~barrier) & ((g == bg) | (g == fill))
    q = fill_pos[:]
    seen = np.zeros_like(passable, dtype=bool)
    for r, c in q:
        if passable[r, c]:
            seen[r, c] = True
    while q:
        r, c = q.pop()
        for rr, cc in neighbors4(r, c):
            if 0 <= rr < h and 0 <= cc < w and passable[rr, cc] and not seen[rr, cc]:
                seen[rr, cc] = True
                q.append((int(rr), int(cc)))

    return Scene(
        bg=bg,
        wall=wall,
        fill=fill,
        wall_comp=wall_comp,
        comp_mask=comp_mask,
        fill_pos=fill_pos,
        rad=rad,
        opening_center=(
            sum(r for r, _ in endpoints) / len(endpoints),
            sum(c for _, c in endpoints) / len(endpoints),
        ),
        filled_mask=seen & (g == bg),
    )


def _distance_to_wall(scene: Scene, pos: Coord) -> int:
    r, c = pos
    return min(max(abs(r - wr), abs(c - wc)) for wr, wc in scene.wall_comp)


def _diag_dir(scene: Scene, pos: Coord) -> Coord:
    r, c = pos
    if scene.rad[0] != 0:
        return (scene.rad[0], -1 if c <= scene.opening_center[1] else 1)
    return (-1 if r <= scene.opening_center[0] else 1, scene.rad[1])


def _trace_diag(shape: tuple[int, int], start: Coord, d: Coord) -> list[Coord]:
    h, w = shape
    rr, cc = start
    trace = []
    while True:
        rr += d[0]
        cc += d[1]
        if not (0 <= rr < h and 0 <= cc < w):
            break
        trace.append((int(rr), int(cc)))
    return trace


def _singleton_specs(grid: np.ndarray, scene: Scene) -> list[dict]:
    g = np.array(grid, copy=False)
    specs: list[dict] = []
    for color in sorted(int(v) for v in np.unique(g) if int(v) not in (scene.bg, scene.wall, scene.fill)):
        for comp in components_mask(g == color, connectivity=8):
            pts = [(int(r), int(c)) for r, c in comp]
            if len(pts) != 1:
                continue
            pos = pts[0]
            step = max(1, _distance_to_wall(scene, pos))
            d = _diag_dir(scene, pos)
            trace = _trace_diag(g.shape, pos, d)
            marks = [trace[i] for i in range(step - 1, len(trace), step)]
            specs.append(
                {
                    "color": int(color),
                    "pos": pos,
                    "step": step,
                    "dir": d,
                    "trace": trace,
                    "marks": marks,
                }
            )
    specs.sort(key=lambda spec: (spec["pos"][0], spec["pos"][1], spec["color"]))
    return specs


def main(grid: np.ndarray) -> np.ndarray:
    """
    Fill the funnel interior, then let isolated pixels fire sparse diagonal trails.

    Input structure:
    - bg is the dominant color. The most frequent non-bg color is a wall component
      shaped like a partial enclosure whose endpoints define an opening.
    - One non-wall color sits inside that enclosure and acts as the fill seed.
    - Any other non-wall, non-fill singleton pixels are movers associated with the
      same wall sprite.

    Rule:
    - Flood-fill the background reachable from the seed inside the enclosure and
      through the opening, using the same endpoint-derived barrier rays as the
      original task.
    - Each isolated singleton disappears from its source cell, picks the diagonal
      branch that continues the opening direction while leaning away from the
      opening center, and then paints only every Nth cell on that diagonal.
    - N is the singleton's initial Chebyshev distance to the wall component, so
      farther pixels leave sparser trails.

    Key insight:
    - The wall still determines the global radiate axis, but the extra singleton
      behavior is no longer "dense straight ahead". Their side relative to the
      opening chooses the diagonal, and their initial distance to the wall chooses
      the spacing of the painted marks.
    """
    g = np.array(grid, copy=True)
    scene = _build_scene(g)
    out = g.copy()
    out[scene.filled_mask] = scene.fill

    for spec in _singleton_specs(g, scene):
        sr, sc = spec["pos"]
        out[sr, sc] = scene.bg
        for rr, cc in spec["marks"]:
            if g[rr, cc] == scene.bg and out[rr, cc] == scene.bg:
                out[rr, cc] = spec["color"]

    return out


# --------------- generator ---------------

# Canvas bounds
GRID_H_VERT = (11, 18)
