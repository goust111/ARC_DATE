            if int(g[nr, nc]) == int(template_bg) and end_color is not None:
                out[nr, nc] = int(end_color)

            # Strict alternating turn: no fallback if blocked.
            left = (-int(dc), int(dr))  # CCW
            right = (int(dc), -int(dr))  # CW
