+def _factor_rows_cols(n: int) -> tuple[int, int]:
+    best = (1, n)
+    best_gap = abs(n - 1)
+    for rows in range(1, n + 1):
+        if n % rows != 0:
+            continue
+        cols = n // rows
+        gap = abs(cols - rows)
+        if gap < best_gap:
+            best = (rows, cols)
+            best_gap = gap
+    return best
