+def _layout_from_stencil(stencil_mask: np.ndarray) -> tuple[int, int, list[tuple[int, int, np.ndarray]]]:
+    components = components_mask(stencil_mask, connectivity=4)
+    if not components:
+        return 1, 1, [(0, 0, np.empty((0, 2), dtype=int))]
