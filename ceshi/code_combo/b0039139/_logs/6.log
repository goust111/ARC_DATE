+    out = np.full(
+        (rows * tile.shape[0] + (rows - 1), cols * tile.shape[1] + (cols - 1)),
+        background,
+        dtype=int,
+    )
+    for rr, cc, _comp in placements:
+        r0 = rr * (tile.shape[0] + 1)
+        c0 = cc * (tile.shape[1] + 1)
