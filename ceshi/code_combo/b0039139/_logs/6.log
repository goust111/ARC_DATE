+
+GRID_SHAPES = [(2, 2), (2, 3), (3, 2)]
+CROP_SIZE_RANGE = (2, 5)
+DENSITY_RANGE = (0.55, 0.85)
+COLOR_POOL = [2, 5, 6, 7, 8, 9]
+TEMPLATE_COLOR = 4
+STENCIL_COLOR = 3
+SEPARATOR_COLOR = 1
+SWATCH_DIM_RANGE = (3, 7)
