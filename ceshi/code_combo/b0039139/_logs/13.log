# combo_spec: D4/2+D8/3
# Name: 外部色块包裹独立边框+双层嵌套边框
#
# Design analysis
# a) Concrete behavior and trace:
#    - Source task:
#      * each recovered frame became one 1px rectangle with child offset +2,
#      * each outside blob stayed a lone pixel in a 3x3 slot beside the outer frame.
#    - Fused task:
#      * every canonical frame uses the D4/2 motif:
#        outer border / 1 bg gap / inner border / 1 bg gap / children,
#        so a child layout of size (h, w) becomes (h+8, w+8) with child offset +4;
#      * an outside blob is no longer rendered bare: it is promoted to its own tiny
#        double frame, i.e. the canonical rendering of "a frame whose only child is one dot".
#    - Small trace:
#      * one inside blob under a frame: old output was a 5x5 single rectangle with a centered dot;
#        fused output is a 9x9 double rectangle with the same centered dot.
#      * one outside blob on the right: old output placed only the dot center at
#        (mapped_row, frame_w + 1); fused output places a 9x9 double-frame mini-object with
#        its center still at that mapped row and with one bg cell between the two objects.
# b) Complexity calibration:
#    - The change is visually strong but still deterministic: frames always use exactly two
#      borders, and the outside promoted object always uses the same 9x9 size.
#    - We keep the original binary-color input language, containment logic, and sibling-order
#      rule so the task remains inferable instead of introducing many unrelated freedoms.
# c) Hidden assumption review:
#    - Original _build_layout assumed frame padding +4 and child offset +2; this breaks under
#      D4/2, so both the mask extent and propagated axis_map offsets must become +8 and +4.
#    - Original _layout_root assumed root blobs reserve only a 3x3 slot and can be drawn as a
#      single cell. Under the fusion this is false: extents must reserve the full 9x9 mini-frame.
#    - _outside_side(), _axis_coordinates(), and _layout_group() depend only on recovered
#      containment/order and on mask extents, so they stay valid once the new masks are used.
# d) Placement legality:
#    - The generator still creates only one true outer root frame and at most one outside blob.
#      This guarantees the root-side attachment branch is unambiguous.
#    - The outside blob stays separated from the rough outer frame by OUTSIDE_GAP_RANGE >= 2,
#      so containment never becomes ambiguous in the input.
# e) Visual observability:
#    - Double borders appear in every output sample containing any frame.
#    - We raise outside-blob probability so several samples also display the promoted outside
#      mini-frame, making the second rule visible within a small ARC training set.
# f) Visual cleanliness:
#    - The mini-frame is isolated on a single side with a fixed one-cell output gap, so it reads
#      as a separate object rather than cluttering the main frame interior.
# g) Color inferability:
#    - No color remapping is introduced; the single foreground color is reused everywhere.
# h) Generator-side new assumptions:
#    - Any root-level non-frame component is intended to be outside the unique outer frame.
#    - Depth remains 1-2 and children still occupy distinct overlap/order bands, so the solver's
#      band-based canonical placement remains well-defined for all generated inputs.

from __future__ import annotations

import random

import numpy as np

from arc_utils import find_components, get_bg, label_mask, paste


FRAME_CHILD_OFFSET = 4
FRAME_TOTAL_PAD = 8
INNER_BORDER_OFFSET = 2
OUTSIDE_FRAME_SIZE = 9
OUTSIDE_ANCHOR = 4
ROOT_SIDE_GAP = 1


class _Node:
    def __init__(self, coords: np.ndarray, bbox: tuple[int, int, int, int], center: np.ndarray):
        self.coords = coords
        self.bbox = bbox
        self.center = center
        self.is_frame = False
        self.parent: _Node | None = None
        self.children: list[_Node] = []
        self.mask: np.ndarray | None = None
        self.anchor: tuple[int, int] | None = None
        self.axis_map: dict[str, list[tuple[float, int]]] = {"row": [], "col": []}


def _component_holes(shape: tuple[int, int], coords: np.ndarray) -> list[np.ndarray]:
    mask = np.zeros(shape, dtype=bool)
    mask[tuple(coords.T)] = True
    lab, n = label_mask(~mask, connectivity=4)
    boundary = set(lab[0, :]) | set(lab[-1, :]) | set(lab[:, 0]) | set(lab[:, -1])
    return [(lab == k) for k in range(1, n + 1) if k not in boundary]


def _intervals_overlap(a: tuple[int, int], b: tuple[int, int]) -> bool:
    return max(a[0], b[0]) <= min(a[1], b[1])


def _paint_rect_border(mask: np.ndarray, inset: int) -> None:
    r1 = mask.shape[0] - 1 - inset
    c1 = mask.shape[1] - 1 - inset
    mask[inset, inset : c1 + 1] = True
    mask[r1, inset : c1 + 1] = True
    mask[inset : r1 + 1, inset] = True
    mask[inset : r1 + 1, c1] = True


def _double_frame_mask(child_mask: np.ndarray) -> np.ndarray:
    h, w = child_mask.shape
    out = np.zeros((h + FRAME_TOTAL_PAD, w + FRAME_TOTAL_PAD), dtype=bool)
    _paint_rect_border(out, inset=0)
    _paint_rect_border(out, inset=INNER_BORDER_OFFSET)
    out[
        FRAME_CHILD_OFFSET : FRAME_CHILD_OFFSET + h,
        FRAME_CHILD_OFFSET : FRAME_CHILD_OFFSET + w,
    ] |= child_mask
    return out


def _outside_frame_mask() -> tuple[np.ndarray, tuple[int, int]]:
    child = np.ones((1, 1), dtype=bool)
    out = _double_frame_mask(child)
    assert out.shape == (OUTSIDE_FRAME_SIZE, OUTSIDE_FRAME_SIZE)
    return out, (OUTSIDE_ANCHOR, OUTSIDE_ANCHOR)


def _build_layout(node: _Node) -> None:
    if node.mask is not None:
        return

    if not node.is_frame:
        node.mask = np.ones((1, 1), dtype=bool)
        node.anchor = (0, 0)
        node.axis_map = {
            "row": [(float(node.center[0]), 0)],
            "col": [(float(node.center[1]), 0)],
        }
        return

    assert node.children
    child_mask, _placements, axis_map = _layout_group(node.children)
    out = _double_frame_mask(child_mask)
    node.mask = out
    node.anchor = (out.shape[0] // 2, out.shape[1] // 2)
    node.axis_map = {
        "row": [(orig, pos + FRAME_CHILD_OFFSET) for orig, pos in axis_map["row"]],
        "col": [(orig, pos + FRAME_CHILD_OFFSET) for orig, pos in axis_map["col"]],
    }


def _axis_coordinates(nodes: list[_Node], axis: int) -> dict[_Node, int]:
    items = []
    for node in nodes:
        assert node.mask is not None and node.anchor is not None
        r0, c0, r1, c1 = node.bbox
        interval = (r0, r1) if axis == 0 else (c0, c1)
        mid = (interval[0] + interval[1]) / 2
        items.append((node, interval, mid, node.anchor[axis], node.mask.shape[axis]))

    bands: list[dict] = []
    for item in sorted(items, key=lambda x: x[2]):
        interval = item[1]
        for band in bands:
            if any(_intervals_overlap(interval, other[1]) for other in band["items"]):
                band["items"].append(item)
                band["interval"] = (
                    min(band["interval"][0], interval[0]),
                    max(band["interval"][1], interval[1]),
                )
                break
        else:
            bands.append({"items": [item], "interval": interval})

    coord_by_node: dict[_Node, int] = {}
    coord = 0
    for i, band in enumerate(bands):
        if i:
            prev = bands[i - 1]
            prev_down = max(item[4] - 1 - item[3] for item in prev["items"])
            curr_up = max(item[3] for item in band["items"])
            coord += prev_down + 2 + curr_up
        for item in band["items"]:
            coord_by_node[item[0]] = int(coord)

    return coord_by_node


def _layout_group(nodes: list[_Node]) -> tuple[np.ndarray, dict[_Node, tuple[int, int]], dict[str, list[tuple[float, int]]]]:
    assert nodes
    for node in nodes:
        _build_layout(node)

    row_coord = _axis_coordinates(nodes, axis=0)
    col_coord = _axis_coordinates(nodes, axis=1)

    min_r = min(row_coord[n] - n.anchor[0] for n in nodes if n.anchor is not None)
    min_c = min(col_coord[n] - n.anchor[1] for n in nodes if n.anchor is not None)
    max_r = max(
        row_coord[n] - n.anchor[0] - min_r + n.mask.shape[0]
        for n in nodes
        if n.anchor is not None and n.mask is not None
    )
    max_c = max(
        col_coord[n] - n.anchor[1] - min_c + n.mask.shape[1]
        for n in nodes
        if n.anchor is not None and n.mask is not None
    )

    out = np.zeros((max_r, max_c), dtype=bool)
    placements: dict[_Node, tuple[int, int]] = {}
    axis_map = {"row": [], "col": []}
    for node in nodes:
        assert node.mask is not None and node.anchor is not None
        r = row_coord[node] - node.anchor[0] - min_r
        c = col_coord[node] - node.anchor[1] - min_c
        placements[node] = (int(r), int(c))
        out[r : r + node.mask.shape[0], c : c + node.mask.shape[1]] |= node.mask
        axis_map["row"].append((float(node.center[0]), int(r + node.anchor[0])))
        axis_map["col"].append((float(node.center[1]), int(c + node.anchor[1])))

    return out, placements, axis_map


