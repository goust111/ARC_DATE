+
+TEMPLATE_COLOR = 4
+OUTPUT_BACKGROUND = 0
+SEPARATOR_COLOR = 1
+STENCIL_COLOR = 3
+COLOR_POOL = [2, 5, 6, 7, 8, 9]
+
+REPEAT_COUNT_RANGE = (2, 6)
+CROP_SIZE_RANGE = (4, 6)
+HOLE_COUNT_RANGE = (1, 3)
+NOTCH_COUNT_RANGE = (0, 2)
+SWATCH_DIM_RANGE = (3, 8)
+STENCIL_VARYING_EXTRA = 4
+BLOB_PLACE_RETRIES = 200
+SHAPE_RETRIES = 240
+GEN_RETRIES = 300
