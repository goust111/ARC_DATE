+
+REPEAT_COUNT_RANGE = (2, 6)
+CROP_SIZE_RANGE = (2, 5)
+DENSITY_RANGE = (0.55, 0.85)
+OUTPUT_COLOR_POOL = [2, 5, 6, 7, 8, 9]
+TEMPLATE_COLOR = 4
+STENCIL_COLOR = 3
+SEPARATOR_COLOR = 1
+SWATCH_DIM_RANGE = (6, 10)
+STENCIL_VARYING_EXTRA = 4
+BLOB_PLACE_RETRIES = 200
+GEN_RETRIES = 400
