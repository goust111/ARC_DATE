+            crop_h,
+            crop_w,
+            density=density,
+            color_palette=[TEMPLATE_COLOR],
+            connectivity=4,
+            symmetry="not_symmetric",
+        )
+        if _valid_shape_mask(shape != 0):
+            return shape
