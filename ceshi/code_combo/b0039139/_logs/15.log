    spec:
  layout:
    orientation: horizontal (column separators) or vertical (row separators), chosen randomly
    separator_color: 1 (blue), single-pixel-wide rows or columns
    sections: 4, separated by 3 blue separator lines; order is template, stencil, fg_swatch, bg_swatch
  template:
    section_size: (crop_h + 2) x (crop_w + 2); 1-pixel black border on all sides around the shape bbox
    shape_color: 4 (yellow) on black (0) background
    crop_size: 2-5 rows x 2-5 cols
    connectivity: single 4-connected component
    fill_ratio: 0.55-0.85 of bounding box
  stencil:
    background: black (0); blobs drawn in color 3 (green)
    each blob is exactly 2 cells (either 1x2 or 2x1), 4-connected
    blob_count: 2-6; this encodes the repeat count N for the output
    blobs separated by >=1 cell of black in all directions
    section_size: loosely sized, at least large enough to hold the blobs with 1-cell border
  swatches:
    fg_swatch and bg_swatch are each a solid rectangle of a single color
    fg_color != bg_color; both from {2-9} excluding 3 and 4 [observed: fg,bg can be 3 or 4]
    swatch dimensions: >=3 in varying axis; shared axis matches all sections
  output:
    tile: crop recolored so shape pixels -> fg_color, background pixels -> bg_color
    tile repeated N times along layout axis, with 1 bg_color separator row/col between copies
    output_size: along repeat axis = crop_dim * N + (N-1); cross axis = crop_dim

generation_strategy:
  approach: output-first
  steps:
    1. Pick orientation (horizontal or vertical) and N (repeat count, 2-6).
    2. Generate tile shape: random connected binary mask of size crop_h x crop_w (each 2-5), fill ratio 0.55-0.85.
    3. Pick fg_color and bg_color (distinct, from 2-9).
    4. Build output by tiling recolored shape N times with bg_color separator.
    5. Build template section: embed shape (drawn in color 4) centered in (crop_h+2) x (crop_w+2) black grid.
    6. Build stencil section: place N 2-cell blobs (1x2 or 2x1) of color 3 on a black grid, spaced apart.
    7. Build fg_swatch and bg_swatch: solid rectangles of their colors (>=3 in varying dim).
    8. Assemble input: join 4 sections with blue (1) separator rows/cols matching orientation.
