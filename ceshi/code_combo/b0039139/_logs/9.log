+# Combo variant of b0039139 (index 9)
+# combo_spec: D4/3+D5/0
+# Name: 紧凑镜像交替拼接无间隔
+
+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+from arc_utils import bbox, components_mask, crop_bbox, random_sprite
