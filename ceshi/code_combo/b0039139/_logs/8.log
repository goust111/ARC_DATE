def _generate_shape_mask(crop_h: int, crop_w: int) -> np.ndarray:
    """Generate a connected shape whose bbox still contains some non-shape cells."""
    for _ in range(GEN_RETRIES):
        density = random.uniform(*DENSITY_RANGE)
        shape = random_sprite(
