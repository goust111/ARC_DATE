   127	def _solid_color(block: np.ndarray) -> int:
   128	    vals, counts = np.unique(block, return_counts=True)
   129	    return int(vals[int(np.argmax(counts))])
   130	
   131	
   132	def _cross(o: tuple[float, float], a: tuple[float, float], b: tuple[float, float]) -> float:
   133	    return (a[0] - o[0]) * (b[1] - o[1]) - (a[1] - o[1]) * (b[0] - o[0])
   134	
   135	
   136	def _convex_hull(points: list[tuple[float, float]]) -> list[tuple[float, float]]:
   137	    pts = sorted(set(points))
   138	    if len(pts) <= 1:
   139	        return pts
   140	
   141	    lower: list[tuple[float, float]] = []
   142	    for p in pts:
   143	        while len(lower) >= 2 and _cross(lower[-2], lower[-1], p) <= 0:
   144	            lower.pop()
   145	        lower.append(p)
   146	
   147	    upper: list[tuple[float, float]] = []
   148	    for p in reversed(pts):
   149	        while len(upper) >= 2 and _cross(upper[-2], upper[-1], p) <= 0:
   150	            upper.pop()
   151	        upper.append(p)
   152	
   153	    return lower[:-1] + upper[:-1]
   154	
   155	
   156	def _point_in_convex_polygon(point: tuple[float, float], polygon: list[tuple[float, float]]) -> bool:
   157	    if not polygon:
   158	        return False
   159	    if len(polygon) == 1:
   160	        return point == polygon[0]
   161	
   162	    sign = 0
   163	    eps = 1e-9
   164	    for i, a in enumerate(polygon):
   165	        b = polygon[(i + 1) % len(polygon)]
   166	        cross = _cross(a, b, point)
   167	        if abs(cross) <= eps:
   168	            continue
   169	        cur = 1 if cross > 0 else -1
   170	        if sign == 0:
   171	            sign = cur
   172	        elif sign != cur:
   173	            return False
   174	    return True
   175	
   176	
   177	def _convex_hull_fill(mask: np.ndarray) -> np.ndarray:
   178	    coords = np.argwhere(mask)
   179	    if coords.size == 0:
   180	        return np.zeros_like(mask, dtype=bool)
   181	
   182	    corners: list[tuple[float, float]] = []
   183	    for r, c in coords:
   184	        rr, cc = int(r), int(c)
   185	        corners.extend(
   186	            [
   187	                (cc, rr),
   188	                (cc + 1, rr),
   189	                (cc, rr + 1),
   190	                (cc + 1, rr + 1),
   191	            ]
   192	        )
   193	
   194	    polygon = _convex_hull(corners)
   195	    h, w = mask.shape
   196	    filled = np.zeros((h, w), dtype=bool)
   197	    for r in range(h):
   198	        for c in range(w):
   199	            if _point_in_convex_polygon((c + 0.5, r + 0.5), polygon):
   200	                filled[r, c] = True
   201	    return filled
   202	
   203	
   204	def main(grid: np.ndarray) -> np.ndarray:
   205	    """
   206	    Recover a negative-space template, convex-hull-fill it, recolor it, and repeat it by stencil count.
   207	
   208	    Input structure:
   209	    - Solid blue (1) separator rows or columns divide the grid into four sections.
   210	    - Section 1 is a yellow (4) plaque whose black (0) cut-out defines the template shape;
   211	      section 2 is a component-count stencil.
   212	    - Sections 3 and 4 are solid color swatches for the output foreground and background.
   213	
   214	    Rule:
   215	    - Read section 1 by treating black cells as the template, crop to the bbox of those
   216	      black cells, then fill the convex hull of that cropped negative-space silhouette.
   217	    - Recolor the completed mask with the two swatch colors, count 4-connected non-black
   218	      components in section 2, and repeat the tile that many times with one background-
   219	      colored separator row/column between copies.
   220	
   221	    Key insight: The template is encoded as empty space rather than painted foreground, and
   222	    the output geometry is not the raw cut-out but its convex completion after cropping.
   223	    """
   224	    g = np.asarray(grid, dtype=int)
   225	    orientation, sections = _split_sections(g)
   226	    template, repetition_pattern, foreground_block, background_block = sections[:4]
   227	
   228	    template_mask = template == 0
   229	    template_bbox = bbox(template_mask)
   230	    if template_bbox is None:
   231	        return np.empty((0, 0), dtype=int)
   232	
   233	    foreground = _solid_color(foreground_block)
   234	    background = _solid_color(background_block)
   235	    cropped_mask = crop_bbox(template_mask, template_bbox)
   236	    tile_mask = _convex_hull_fill(cropped_mask)
   237	    tile = np.where(tile_mask, foreground, background).astype(int)
   238	
   239	    n_repeats = len(components_mask(repetition_pattern != 0, connectivity=4))
   240	    if n_repeats <= 1:
   241	        return tile
   242	
   243	    if orientation == "horizontal":
   244	        sep = np.full((tile.shape[0], 1), background, dtype=int)
   245	        pieces = [tile] + [x for _ in range(n_repeats - 1) for x in (sep, tile)]
   246	        return np.hstack(pieces)
   247	
   248	    sep = np.full((1, tile.shape[1]), background, dtype=int)
   249	    pieces = [tile] + [x for _ in range(n_repeats - 1) for x in (sep, tile)]
   250	    return np.vstack(pieces)
   251	
   252	
   253	# --------------- generator (negative_space_convex_hull) ---------------
   254	
   255	
   256	def _tile_repeat(tile: np.ndarray, n: int, bg_color: int, horizontal: bool) -> np.ndarray:
   257	    if horizontal:
   258	        sep = np.full((tile.shape[0], 1), bg_color, dtype=int)
   259	        pieces = [tile] + [x for _ in range(n - 1) for x in (sep, tile)]
   260	        return np.hstack(pieces)
   261	    sep = np.full((1, tile.shape[1]), bg_color, dtype=int)
   262	    pieces = [tile] + [x for _ in range(n - 1) for x in (sep, tile)]
   263	    return np.vstack(pieces)
   264	
   265	
   266	def _make_swatch(shared_dim: int, color: int, horizontal: bool) -> np.ndarray:
   267	    varying = random.randint(*SWATCH_DIM_RANGE)
   268	    if horizontal:
   269	        return np.full((shared_dim, varying), color, dtype=int)
   270	    return np.full((varying, shared_dim), color, dtype=int)
   271	
   272	
   273	def _join_sections(sections: list[np.ndarray], shared_dim: int, horizontal: bool) -> np.ndarray:
   274	    if horizontal:
   275	        sep = np.full((shared_dim, 1), SEPARATOR_COLOR, dtype=int)
   276	        parts = [sections[0]]
   277	        for s in sections[1:]:
   278	            parts.extend([sep, s])
   279	        return np.hstack(parts)
   280	    sep = np.full((1, shared_dim), SEPARATOR_COLOR, dtype=int)
   281	    parts = [sections[0]]
   282	    for s in sections[1:]:
   283	        parts.extend([sep, s])
   284	    return np.vstack(parts)
   285	
   286	
   287	def _build_stencil(n_blobs: int, shared_dim: int, horizontal: bool) -> np.ndarray | None:
   288	    min_varying = max(4, n_blobs * 2 + 2)
   289	    varying_dim = random.randint(min_varying, min_varying + STENCIL_VARYING_EXTRA)
   290	
   291	    h, w = (shared_dim, varying_dim) if horizontal else (varying_dim, shared_dim)
   292	    grid = np.zeros((h, w), dtype=int)
   293	
   294	    placed = 0
   295	    for _ in range(BLOB_PLACE_RETRIES):
   296	        if placed >= n_blobs:
   297	            break
   298	        br, bc = (1, 2) if random.choice([True, False]) else (2, 1)
   299	
   300	        if h - 1 - br < 1 or w - 1 - bc < 1:
   301	            continue
   302	        r = random.randint(1, h - 1 - br)
   303	        c = random.randint(1, w - 1 - bc)
   304	
   305	        r0, c0 = max(0, r - 1), max(0, c - 1)
   306	        r1, c1 = min(h, r + br + 1), min(w, c + bc + 1)
   307	        if np.any(grid[r0:r1, c0:c1] != 0):
   308	            continue
   309	
   310	        grid[r : r + br, c : c + bc] = STENCIL_COLOR
