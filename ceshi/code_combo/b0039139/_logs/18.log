+TEMPLATE_COLOR = 4
+STENCIL_COLOR = 3
+SEPARATOR_COLOR = 1
+COLOR_POOL = list(range(2, 10))
+GRID_SHAPES = [(2, 2), (2, 3)]
+TEMPLATE_CANVAS_SIZE = 7
+SPRITE_SIZE = 5
+DENSITY_RANGE = (0.45, 0.75)
+SWATCH_DIM_RANGE = (3, 8)
+GEN_RETRIES = 300
