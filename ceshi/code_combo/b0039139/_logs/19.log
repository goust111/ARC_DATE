def _repeat_is_horizontal(tile_mask: np.ndarray) -> bool:
    """Use the cropped template geometry to choose the replication axis."""
    h, w = tile_mask.shape
    if w > h:
        return True
    if h > w:
        return False
    return True


def _tile_repeat(tile: np.ndarray, n: int, bg_color: int, horizontal: bool) -> np.ndarray:
