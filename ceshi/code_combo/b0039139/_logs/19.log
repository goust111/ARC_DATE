+        bg_color,
+        n_repeats,
+        _repeat_is_horizontal(_square_then_rotate(crop_mask)),
+    )
+    if np.array_equal(output, old_output):
+        return None
+    if np.array_equal(output, square_only_output):
+        return None
+    if np.array_equal(output, square_then_rotate_output):
+        return None
+    return inp
