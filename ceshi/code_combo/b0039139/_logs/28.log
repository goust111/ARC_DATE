            ph, pw = piece.shape
            r0 = (shared_dim - ph) // 2
            grid[r0 : r0 + ph, cursor : cursor + pw] = piece
            cursor += pw + 1
        return grid

    height = 2 + sum(piece.shape[0] for piece in pieces) + (len(pieces) - 1)
    grid = np.zeros((height, shared_dim), dtype=int)
