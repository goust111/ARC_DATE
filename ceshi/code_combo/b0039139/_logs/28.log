+    cursor = 1
+    for piece in pieces:
+        ph, pw = piece.shape
+        c0 = (shared_dim - pw) // 2
+        grid[c0 * 0 + cursor : cursor + ph, c0 : c0 + pw] = piece
+        cursor += ph + 1
+    return grid
