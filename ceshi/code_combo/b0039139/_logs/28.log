+def _square_slot_tile(tile: np.ndarray, bg_color: int) -> np.ndarray:
+    h, w = tile.shape
+    side = max(h, w)
+    out = np.full((side, side), bg_color, dtype=int)
+    r0 = (side - h) // 2
+    c0 = (side - w) // 2
+    out[r0 : r0 + h, c0 : c0 + w] = tile
