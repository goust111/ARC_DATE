+        prev = 0
+        for cut in cuts + [total]:
+            parts.append(cut - prev)
+            prev = cut
+        if max(parts) >= 3 and len(set(parts)) >= 2 and sum(parts) == total:
+            random.shuffle(parts)
+            return parts
