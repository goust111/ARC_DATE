+    parts = _random_partition(total_pixels, n_components)
+    if parts is None:
+        return None
+
+    pieces: list[np.ndarray] = []
+    cross_cap = shared_dim - 2
+    if cross_cap <= 0:
+        return None
+
+    for area in parts:
