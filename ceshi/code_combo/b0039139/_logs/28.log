+            nr, nc = random.choice(tuple(frontier))
+            frontier.remove((nr, nc))
+            cells.add((nr, nc))
+            mask[nr, nc] = True
+            add_frontier(nr, nc)
+
+        if len(cells) != area:
+            continue
+
+        box = bbox(mask)
+        assert box is not None
+        cropped = crop_bbox(mask, box)
+        if int(np.count_nonzero(cropped)) == area:
