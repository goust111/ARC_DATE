+        grid = np.zeros((shared_dim, width), dtype=int)
+        cursor = 1
+        for piece in pieces:
+            ph, pw = piece.shape
+            r0 = (shared_dim - ph) // 2
+            grid[r0 : r0 + ph, cursor : cursor + pw] = piece
+            cursor += pw + 1
+        return grid
