def _placement_candidates(mask, subset, top, left):
    """Find all (t, l) offsets where the given subset of active cells is consistent with mask."""
    existing = np.zeros((CELL_GRID_N, CELL_GRID_N), dtype=bool)
    for r, c in subset:
