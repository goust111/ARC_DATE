+
+def _build_grid(
+    n_rows: int,
+    n_cols: int,
+    row_step: int,
+    col_step: int,
+    separator: int,
+    majority: np.ndarray,
+    minority: np.ndarray,
+    active_cells: list[tuple[int, int]],
