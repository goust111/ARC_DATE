index 0000000000000000000000000000000000000000..acea6458846e708b419f14694e0c564b242e0d15
--- /dev/null
+++ b/ceshi/code_combo/b99e7126/16/code.py
@@ -0,0 +1,389 @@
+# Combo variant of b99e7126 (index 16)
+# combo_spec: D4/2+D8/1
+# Name: 非均匀缩放 + 非正方形单元格
+
+# Design analysis for the fused variant
+# ------------------------------------
+# a) Concrete behavior trace:
+#    Original task:
+#    - Cells are 3x3 squares inside a 7x7 square cell lattice.
+#    - The minority cell's 3x3 interior is read as a 3x3 boolean mask.
+#    - Each mask pixel expands to one whole 3x3 cell, so the overlay is 3 cells tall
+#      and 3 cells wide.
+#    Fused task:
+#    - Cells are MxN rectangles, with M != N. Example: if M=2 and N=4, each cell is a
+#      2x4 interior separated by 1-pixel divider lines.
+#    - The minority cell's 2x4 interior is read as a 2x4 boolean mask.
+#    - Expansion is therefore non-uniform by construction: each mask row becomes one
+#      cell-row of height M, and each mask column becomes one cell-column of width N.
+#      In the 2x4 example the large overlay is 2 cells tall and 4 cells wide, so the
+#      solver must infer both the vertical period (M+1) and horizontal period (N+1).
+#    Difference:
+#    - The old single `step` assumption breaks. Both inference and placement must track
+#      row and column geometry separately.
+#
+# b) Complexity calibration:
+#    - The generator only emits a small catalog of rectangular cell sizes, all with
+#      repeated evidence across many cells, so humans can see the row/column periods.
+#    - The minority mask is dense enough that its active color is clearly dominant, but
+#      still contains multiple inactive pixels so the shape is informative.
+#    - The input shows only a strict subset of the active cells, preserving the original
+#      "complete the fractal placement" reasoning without making placement ambiguous.
+#
+# c) Implicit assumptions that had to change:
+#    - `_infer_cell_grid_params` in the original code assumed one square step for both
+#      axes. This variant needs independent `row_step` and `col_step`.
+#    - `n = (g.shape[0] - 1) // step` assumed a square cell lattice. We now infer
+#      `n_rows` and `n_cols` independently.
+#    - `inner = step - 1` assumed square interiors. We now use `inner_h` and `inner_w`.
+#    - The placement search previously used an `m x m` mask. It must now accept an
+#      `mh x mw` mask where `mh == inner_h` and `mw == inner_w`.
+#
+# d) Placement legality:
+#    - The generator chooses `(top, left)` only from ranges where the `mh x mw` mask
+#      fits inside the `n_rows x n_cols` cell lattice.
+#    - All cell pastes use those inferred dimensions, so no cell overlaps or out-of-
+#      bounds writes occur.
+#
+# e) Visual observability:
+#    - Humans can see the rectangle-shaped cell interiors immediately from the divider
+#      spacing, and can see that the completed minority region is also rectangular in
+#      cell coordinates, not square.
+#    - Because several configurations are tall-thin and wide-short, the anisotropy is
+#      visible across samples rather than hidden in one accidental example.
+#
+# f) Visual cleanliness:
+#    - Only two interior patterns exist: majority and minority. Divider color never
+#      appears inside cell interiors, so the cell boundaries stay crisp.
+#    - The output overlays whole-cell replacements only; no mixed partial overlays are
+#      introduced.
+#
+# g) Change inferability:
+#    - No color ordering assumptions are used. The active color is inferred from
+#      frequency inside the minority cell, with generator constraints guaranteeing a
+#      strict majority. The geometric cue is the main signal, not the numeric color id.
+
+from functools import reduce
+from itertools import combinations
+from math import gcd
+from pathlib import Path
+import random
+import sys
+
+import numpy as np
+
+_ROOT = Path(__file__).resolve().parents[4]
+_SOLVER_DIR = _ROOT / "solvers"
+if str(_SOLVER_DIR) not in sys.path:
+    sys.path.append(str(_SOLVER_DIR))
+
+from arc_utils import paste
+
+
+def _infer_cell_grid_params(g: np.ndarray) -> tuple[int, int, list[int], list[int]]:
+    """
+    Infer a rectangular cell grid separated by full rows/cols of the separator color.
+
+    Returns `(row_step, col_step, row_divs, col_divs)`, where each step includes the
+    1-pixel divider line.
+    """
+    h, w = g.shape
+    line = int(g[0, 0])
+    row_divs = [r for r in range(h) if np.all(g[r, :] == line)]
+    col_divs = [c for c in range(w) if np.all(g[:, c] == line)]
+    assert len(row_divs) >= 2 and len(col_divs) >= 2, "need at least 2 row and 2 col dividers"
+
+    row_divs.sort()
+    col_divs.sort()
+    row_diffs = [row_divs[i + 1] - row_divs[i] for i in range(len(row_divs) - 1)]
+    col_diffs = [col_divs[i + 1] - col_divs[i] for i in range(len(col_divs) - 1)]
+    row_step = reduce(gcd, row_diffs)
+    col_step = reduce(gcd, col_diffs)
+    assert row_step > 1 and col_step > 1, "divider steps must both be > 1"
+    assert row_divs[0] == 0 and col_divs[0] == 0, "first divider must be at index 0"
+    assert row_divs[-1] == h - 1 and col_divs[-1] == w - 1, "last divider must be at boundary"
+    assert (h - 1) % row_step == 0 and (w - 1) % col_step == 0, "grid dimensions must fit the inferred periods"
+
+    exp_row_divs = list(range(0, h, row_step))
+    exp_col_divs = list(range(0, w, col_step))
+    assert row_divs == exp_row_divs and col_divs == exp_col_divs, "divider rows/cols must form a regular rectangular lattice"
+    return int(row_step), int(col_step), row_divs, col_divs
+
+
+def _extract_cell_patterns(
+    g: np.ndarray, row_step: int, col_step: int
+) -> tuple[dict[tuple[int, ...], np.ndarray], list[list[tuple[int, ...]]], int, int]:
+    n_rows = (g.shape[0] - 1) // row_step
+    n_cols = (g.shape[1] - 1) // col_step
+    inner_h = row_step - 1
+    inner_w = col_step - 1
+
+    patterns: dict[tuple[int, ...], np.ndarray] = {}
+    cell_pat: list[list[tuple[int, ...]]] = []
+    for i in range(n_rows):
+        row: list[tuple[int, ...]] = []
+        for j in range(n_cols):
+            r0 = i * row_step + 1
+            c0 = j * col_step + 1
+            pat_arr = g[r0 : r0 + inner_h, c0 : c0 + inner_w].copy()
+            pat = tuple(pat_arr.ravel().tolist())
+            if pat not in patterns:
+                patterns[pat] = pat_arr
+            row.append(pat)
+        cell_pat.append(row)
+    return patterns, cell_pat, n_rows, n_cols
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Complete a rectangular fractal overlay by reading the minority cell as an anisotropic blueprint.
+
+    Input structure:
+    - The grid is partitioned by full separator rows and columns into a rectangular cell lattice.
+    - Each cell interior is MxN with M != N, so the row and column periods must be inferred separately.
+    - Most cells share one interior pattern, while a strict minority share a second pattern.
+
+    Rule:
+    - Extract the minority cell's MxN interior and mark its dominant color as the active mask.
+    - Interpret that MxN mask at the cell-grid level: each mask row expands by the cell height M,
+      and each mask column expands by the cell width N.
+    - Find the unique top-left placement where the already-visible minority cells align with active
+      mask positions.
+    - Replace every active target cell with the minority pattern and every inactive target cell with
+      the majority pattern, leaving the rest of the grid unchanged.
+
+    Key insight:
+    - The unusual cell is both a local texture and a non-uniform scale model of the larger answer:
+      because the cell is rectangular, its vertical and horizontal scaling factors are different and
+      must be inferred independently from the divider spacing.
+    """
+    g = np.asarray(grid, dtype=int)
+    row_step, col_step, _, _ = _infer_cell_grid_params(g)
+    patterns, cell_pat, n_rows, n_cols = _extract_cell_patterns(g, row_step, col_step)
+
+    counts: dict[tuple[int, ...], int] = {}
+    for i in range(n_rows):
+        for j in range(n_cols):
+            p = cell_pat[i][j]
+            counts[p] = counts.get(p, 0) + 1
+    assert len(counts) >= 2, "must have at least 2 distinct cell patterns"
+
+    ranked = sorted(counts.items(), key=lambda kv: kv[1])
+    minority_pat, minority_count = ranked[0]
+    majority_pat, majority_count = ranked[-1]
+    assert minority_count < majority_count, "minority and majority must be distinguishable by frequency"
+    minority_arr = patterns[minority_pat]
+
+    vals, cnts = np.unique(minority_arr, return_counts=True)
+    order = np.argsort(cnts)
+    active_color = int(vals[order[-1]])
+    assert cnts[order[-1]] > cnts[order[-2]], "minority pattern must have a unique dominant color"
+    mask = minority_arr == active_color
+    mh, mw = mask.shape
+
+    existing = np.zeros((n_rows, n_cols), dtype=bool)
+    for i in range(n_rows):
+        for j in range(n_cols):
+            existing[i, j] = cell_pat[i][j] == minority_pat
+
+    candidates: list[tuple[int, int]] = []
+    for top in range(0, n_rows - mh + 1):
+        for left in range(0, n_cols - mw + 1):
+            block = np.zeros_like(existing)
+            block[top : top + mh, left : left + mw] = True
+            if np.any(existing & ~block):
+                continue
+            ex_block = existing[top : top + mh, left : left + mw]
+            if np.any(ex_block & ~mask):
+                continue
+            candidates.append((int(top), int(left)))
+    assert len(candidates) == 1, "must have a unique anisotropic mask placement"
+    top, left = candidates[0]
+
+    out = g.copy()
+    inner_h = row_step - 1
+    inner_w = col_step - 1
+    majority_arr = patterns[majority_pat]
+    for i in range(mh):
+        for j in range(mw):
+            target_pat = minority_arr if mask[i, j] else majority_arr
+            r0 = (top + i) * row_step + 1
+            c0 = (left + j) * col_step + 1
+            out[r0 : r0 + inner_h, c0 : c0 + inner_w] = target_pat
+    return out
+
+
+# --------------- generator ---------------
+
+RECT_CONFIGS = [
+    (2, 3, 7, 6),
+    (2, 4, 6, 5),
+    (3, 2, 6, 7),
+    (3, 4, 6, 5),
+    (4, 2, 5, 6),
+    (4, 3, 5, 6),
+]
+GIVEN_CELL_SIZES = (3, 4, 5, 6)
+COLOR_POOL = 10
+MAX_RETRIES = 400
+
+
+def _bool_templates(h: int, w: int) -> list[np.ndarray]:
+    rr, cc = np.indices((h, w))
+    templates = [
+        (rr + cc) % 2 == 0,
+        rr % 2 == 0,
+        cc % 2 == 0,
+        rr <= (h - 1) // 2,
+        cc <= (w - 1) // 2,
+    ]
+    if h > 2 and w > 2:
+        templates.append((rr == 0) | (rr == h - 1) | (cc == 0) | (cc == w - 1))
+
+    unique: list[np.ndarray] = []
+    seen: set[tuple[int, ...]] = set()
+    for arr in templates:
+        if arr.all() or (~arr).all():
+            continue
+        key = tuple(arr.astype(int).ravel().tolist())
+        if key not in seen:
+            seen.add(key)
+            unique.append(arr.copy())
+    return unique
+
+
+_MAJORITY_TEMPLATES: dict[tuple[int, int], list[np.ndarray]] = {}
+_MASKS_BY_SHAPE: dict[tuple[int, int], list[np.ndarray]] = {}
+for _h, _w, _, _ in RECT_CONFIGS:
+    key = (_h, _w)
+    if key not in _MAJORITY_TEMPLATES:
+        _MAJORITY_TEMPLATES[key] = _bool_templates(_h, _w)
+
+    total = _h * _w
+    min_active = total // 2 + 1
+    masks: list[np.ndarray] = []
+    for bits in range(1 << total):
+        active = bits.bit_count()
+        inactive = total - active
+        if active < min_active or inactive < 2:
+            continue
+        arr = np.array([(bits >> idx) & 1 for idx in range(total)], dtype=bool).reshape(_h, _w)
+        if np.any(arr.sum(axis=1) == 0) or np.any(arr.sum(axis=0) == 0):
+            continue
+        if not arr[0, :].any() or not arr[-1, :].any() or not arr[:, 0].any() or not arr[:, -1].any():
+            continue
+        masks.append(arr)
+    _MASKS_BY_SHAPE[key] = masks
+
+
+def _random_majority_pattern(h: int, w: int, shared: int, maj_exclusive: int) -> np.ndarray:
+    template = random.choice(_MAJORITY_TEMPLATES[(h, w)])
+    return np.where(template, maj_exclusive, shared).astype(int)
+
+
+def _random_minority_mask(h: int, w: int) -> np.ndarray:
+    return random.choice(_MASKS_BY_SHAPE[(h, w)]).copy()
+
+
+def _cell_origin(i: int, j: int, row_step: int, col_step: int) -> tuple[int, int]:
+    return i * row_step + 1, j * col_step + 1
+
+
+def _build_grid(
+    n_rows: int,
+    n_cols: int,
+    row_step: int,
+    col_step: int,
+    separator: int,
+    majority: np.ndarray,
+    minority: np.ndarray,
+    active_cells: list[tuple[int, int]],
+) -> np.ndarray:
+    height = n_rows * row_step + 1
+    width = n_cols * col_step + 1
+    grid = np.full((height, width), separator, dtype=int)
+    for i in range(n_rows):
+        for j in range(n_cols):
+            paste(grid, majority, *_cell_origin(i, j, row_step, col_step))
+    for i, j in active_cells:
+        paste(grid, minority, *_cell_origin(i, j, row_step, col_step))
+    return grid
+
+
+def _placement_candidates(
+    mask: np.ndarray,
+    subset: tuple[tuple[int, int], ...],
+    actual_top: int,
+    actual_left: int,
+    n_rows: int,
+    n_cols: int,
+) -> list[tuple[int, int]]:
+    existing = np.zeros((n_rows, n_cols), dtype=bool)
+    for r, c in subset:
+        existing[actual_top + r, actual_left + c] = True
+
+    mh, mw = mask.shape
+    candidates: list[tuple[int, int]] = []
+    for top in range(n_rows - mh + 1):
+        for left in range(n_cols - mw + 1):
+            block = np.zeros_like(existing)
+            block[top : top + mh, left : left + mw] = True
+            if np.any(existing & ~block):
+                continue
+            ex_block = existing[top : top + mh, left : left + mw]
+            if np.any(ex_block & ~mask):
+                continue
+            candidates.append((top, left))
+    return candidates
+
+
+def _choose_given_subset(mask: np.ndarray, top: int, left: int, n_rows: int, n_cols: int):
+    active = [tuple(coord) for coord in np.argwhere(mask)]
+    random.shuffle(active)
+    valid_sizes = [size for size in GIVEN_CELL_SIZES if 2 < size < len(active)]
+    for size in valid_sizes:
+        options = [
+            subset
+            for subset in combinations(active, size)
+            if _placement_candidates(mask, subset, top, left, n_rows, n_cols) == [(top, left)]
+        ]
+        if options:
+            return random.choice(options)
+    return None
+
+
+def _gen_attempt():
+    inner_h, inner_w, n_rows, n_cols = random.choice(RECT_CONFIGS)
+    row_step = inner_h + 1
+    col_step = inner_w + 1
+
+    separator, maj_exclusive, shared, min_exclusive = random.sample(range(COLOR_POOL), 4)
+    majority = _random_majority_pattern(inner_h, inner_w, shared, maj_exclusive)
+    mask = _random_minority_mask(inner_h, inner_w)
+    minority = np.where(mask, min_exclusive, shared).astype(int)
+    if np.array_equal(majority, minority):
+        return None
+
+    top = random.randrange(n_rows - inner_h + 1)
+    left = random.randrange(n_cols - inner_w + 1)
+    active_cells = [(top + r, left + c) for r, c in np.argwhere(mask)]
+    out = _build_grid(n_rows, n_cols, row_step, col_step, separator, majority, minority, active_cells)
+
+    subset = _choose_given_subset(mask, top, left, n_rows, n_cols)
+    if subset is None:
+        return None
+    given_cells = [(top + r, left + c) for r, c in subset]
+    inp = _build_grid(n_rows, n_cols, row_step, col_step, separator, majority, minority, given_cells)
+
+    solved = main(inp)
+    if not np.array_equal(solved, out):
+        return None
+    return inp
+
+
+def generate_input():
+    for _ in range(MAX_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid fused b99e7126 input")

融合变体已实现并通过稳定性与非退化检查。
  ✓ 梳理原题假设并设计 D4/2+D8/1 的具体网格规则与生成约束
  ✓ 实现新的 solver 与 generator 到目标文件，包含分析注释和四段式 main 文档
  ✓ 运行 50 次稳定性测试，必要时迭代修复
  ✓ 统计融合行为指标，确认没有退化回原始正方形/等比版本
