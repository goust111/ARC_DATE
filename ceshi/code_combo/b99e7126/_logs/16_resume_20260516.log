+    - Find the unique top-left placement where the already-visible minority cells align with active
+      mask positions.
+    - Replace every active target cell with the minority pattern and every inactive target cell with
+      the majority pattern, leaving the rest of the grid unchanged.
+
+    Key insight:
+    - The unusual cell is both a local texture and a non-uniform scale model of the larger answer:
+      because the cell is rectangular, its vertical and horizontal scaling factors are different and
+      must be inferred independently from the divider spacing.
+    """
+    g = np.asarray(grid, dtype=int)
+    row_step, col_step, _, _ = _infer_cell_grid_params(g)
+    patterns, cell_pat, n_rows, n_cols = _extract_cell_patterns(g, row_step, col_step)
+
+    counts: dict[tuple[int, ...], int] = {}
+    for i in range(n_rows):
+        for j in range(n_cols):
+            p = cell_pat[i][j]
+            counts[p] = counts.get(p, 0) + 1
+    assert len(counts) >= 2, "must have at least 2 distinct cell patterns"
+
+    ranked = sorted(counts.items(), key=lambda kv: kv[1])
+    minority_pat, minority_count = ranked[0]
+    majority_pat, majority_count = ranked[-1]
+    assert minority_count < majority_count, "minority and majority must be distinguishable by frequency"
+    minority_arr = patterns[minority_pat]
+
+    vals, cnts = np.unique(minority_arr, return_counts=True)
+    order = np.argsort(cnts)
+    active_color = int(vals[order[-1]])
+    assert cnts[order[-1]] > cnts[order[-2]], "minority pattern must have a unique dominant color"
+    mask = minority_arr == active_color
+    mh, mw = mask.shape
+
+    existing = np.zeros((n_rows, n_cols), dtype=bool)
+    for i in range(n_rows):
+        for j in range(n_cols):
+            existing[i, j] = cell_pat[i][j] == minority_pat
+
+    candidates: list[tuple[int, int]] = []
+    for top in range(0, n_rows - mh + 1):
+        for left in range(0, n_cols - mw + 1):
+            block = np.zeros_like(existing)
+            block[top : top + mh, left : left + mw] = True
+            if np.any(existing & ~block):
+                continue
+            ex_block = existing[top : top + mh, left : left + mw]
+            if np.any(ex_block & ~mask):
+                continue
+            candidates.append((int(top), int(left)))
+    assert len(candidates) == 1, "must have a unique anisotropic mask placement"
+    top, left = candidates[0]
+
+    out = g.copy()
+    inner_h = row_step - 1
+    inner_w = col_step - 1
+    majority_arr = patterns[majority_pat]
+    for i in range(mh):
+        for j in range(mw):
+            target_pat = minority_arr if mask[i, j] else majority_arr
+            r0 = (top + i) * row_step + 1
+            c0 = (left + j) * col_step + 1
+            out[r0 : r0 + inner_h, c0 : c0 + inner_w] = target_pat
+    return out
+
+
+# --------------- generator ---------------
+
+RECT_CONFIGS = [
+    (2, 3, 7, 6),
+    (2, 4, 6, 5),
+    (3, 2, 6, 7),
+    (3, 4, 6, 5),
+    (4, 2, 5, 6),
+    (4, 3, 5, 6),
+]
+GIVEN_CELL_SIZES = (3, 4, 5, 6)
+COLOR_POOL = 10
+MAX_RETRIES = 400
+
+
+def _bool_templates(h: int, w: int) -> list[np.ndarray]:
+    rr, cc = np.indices((h, w))
+    templates = [
+        (rr + cc) % 2 == 0,
+        rr % 2 == 0,
+        cc % 2 == 0,
+        rr <= (h - 1) // 2,
+        cc <= (w - 1) // 2,
+    ]
+    if h > 2 and w > 2:
+        templates.append((rr == 0) | (rr == h - 1) | (cc == 0) | (cc == w - 1))
+
+    unique: list[np.ndarray] = []
+    seen: set[tuple[int, ...]] = set()
+    for arr in templates:
+        if arr.all() or (~arr).all():
+            continue
+        key = tuple(arr.astype(int).ravel().tolist())
+        if key not in seen:
+            seen.add(key)
+            unique.append(arr.copy())
+    return unique
+
+
+_MAJORITY_TEMPLATES: dict[tuple[int, int], list[np.ndarray]] = {}
+_MASKS_BY_SHAPE: dict[tuple[int, int], list[np.ndarray]] = {}
+for _h, _w, _, _ in RECT_CONFIGS:
+    key = (_h, _w)
+    if key not in _MAJORITY_TEMPLATES:
+        _MAJORITY_TEMPLATES[key] = _bool_templates(_h, _w)
+
+    total = _h * _w
+    min_active = total // 2 + 1
+    masks: list[np.ndarray] = []
+    for bits in range(1 << total):
+        active = bits.bit_count()
+        inactive = total - active
+        if active < min_active or inactive < 2:
+            continue
+        arr = np.array([(bits >> idx) & 1 for idx in range(total)], dtype=bool).reshape(_h, _w)
+        if np.any(arr.sum(axis=1) == 0) or np.any(arr.sum(axis=0) == 0):
+            continue
+        if not arr[0, :].any() or not arr[-1, :].any() or not arr[:, 0].any() or not arr[:, -1].any():
+            continue
+        masks.append(arr)
+    _MASKS_BY_SHAPE[key] = masks
+
+
+def _random_majority_pattern(h: int, w: int, shared: int, maj_exclusive: int) -> np.ndarray:
+    template = random.choice(_MAJORITY_TEMPLATES[(h, w)])
+    return np.where(template, maj_exclusive, shared).astype(int)
+
+
+def _random_minority_mask(h: int, w: int) -> np.ndarray:
+    return random.choice(_MASKS_BY_SHAPE[(h, w)]).copy()
+
+
+def _cell_origin(i: int, j: int, row_step: int, col_step: int) -> tuple[int, int]:
+    return i * row_step + 1, j * col_step + 1
+
+
+def _build_grid(
+    n_rows: int,
+    n_cols: int,
+    row_step: int,
+    col_step: int,
+    separator: int,
+    majority: np.ndarray,
+    minority: np.ndarray,
+    active_cells: list[tuple[int, int]],
+) -> np.ndarray:
+    height = n_rows * row_step + 1
+    width = n_cols * col_step + 1
+    grid = np.full((height, width), separator, dtype=int)
+    for i in range(n_rows):
+        for j in range(n_cols):
+            paste(grid, majority, *_cell_origin(i, j, row_step, col_step))
+    for i, j in active_cells:
+        paste(grid, minority, *_cell_origin(i, j, row_step, col_step))
+    return grid
+
+
+def _placement_candidates(
+    mask: np.ndarray,
+    subset: tuple[tuple[int, int], ...],
+    actual_top: int,
+    actual_left: int,
+    n_rows: int,
+    n_cols: int,
+) -> list[tuple[int, int]]:
+    existing = np.zeros((n_rows, n_cols), dtype=bool)
+    for r, c in subset:
+        existing[actual_top + r, actual_left + c] = True
+
+    mh, mw = mask.shape
+    candidates: list[tuple[int, int]] = []
+    for top in range(n_rows - mh + 1):
+        for left in range(n_cols - mw + 1):
+            block = np.zeros_like(existing)
+            block[top : top + mh, left : left + mw] = True
+            if np.any(existing & ~block):
+                continue
+            ex_block = existing[top : top + mh, left : left + mw]
+            if np.any(ex_block & ~mask):
+                continue
+            candidates.append((top, left))
+    return candidates
+
+
+def _choose_given_subset(mask: np.ndarray, top: int, left: int, n_rows: int, n_cols: int):
+    active = [tuple(coord) for coord in np.argwhere(mask)]
+    random.shuffle(active)
+    valid_sizes = [size for size in GIVEN_CELL_SIZES if 2 < size < len(active)]
+    for size in valid_sizes:
+        options = [
+            subset
+            for subset in combinations(active, size)
+            if _placement_candidates(mask, subset, top, left, n_rows, n_cols) == [(top, left)]
+        ]
+        if options:
+            return random.choice(options)
+    return None
+
+
+def _gen_attempt():
+    inner_h, inner_w, n_rows, n_cols = random.choice(RECT_CONFIGS)
+    row_step = inner_h + 1
+    col_step = inner_w + 1
+
+    separator, maj_exclusive, shared, min_exclusive = random.sample(range(COLOR_POOL), 4)
+    majority = _random_majority_pattern(inner_h, inner_w, shared, maj_exclusive)
+    mask = _random_minority_mask(inner_h, inner_w)
+    minority = np.where(mask, min_exclusive, shared).astype(int)
+    if np.array_equal(majority, minority):
+        return None
+
+    top = random.randrange(n_rows - inner_h + 1)
+    left = random.randrange(n_cols - inner_w + 1)
+    active_cells = [(top + r, left + c) for r, c in np.argwhere(mask)]
+    out = _build_grid(n_rows, n_cols, row_step, col_step, separator, majority, minority, active_cells)
+
+    subset = _choose_given_subset(mask, top, left, n_rows, n_cols)
+    if subset is None:
+        return None
+    given_cells = [(top + r, left + c) for r, c in subset]
+    inp = _build_grid(n_rows, n_cols, row_step, col_step, separator, majority, minority, given_cells)
+
+    solved = main(inp)
+    if not np.array_equal(solved, out):
+        return None
+    return inp
+
+
+def generate_input():
+    for _ in range(MAX_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid fused b99e7126 input")

