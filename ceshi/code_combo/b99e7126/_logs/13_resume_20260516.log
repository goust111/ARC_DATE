new file mode 100644
index 0000000000000000000000000000000000000000..1657c5cfbf1da3dec6d6f299fbb56eb7d4775cb1
--- /dev/null
+++ b/ceshi/code_combo/b99e7126/13/code.py
@@ -0,0 +1,400 @@
+# Combo variant of b99e7126 (index 13)
+# combo_spec: D7/0+D10/2
+# Name: 多异常顺序处理 + 多异常独立图案
+
+# Design analysis for the combo variant
+# a) Concrete behavior and trace
+#    - The canvas remains a 7x7 array of 3x3 cell interiors separated by 1-pixel divider
+#      lines. One majority cell pattern fills almost the whole grid.
+#    - The input now shows 2-3 singleton anomaly cells. Each anomaly has a different 3x3
+#      pattern, so each one carries its own local stencil instead of all anomalies sharing
+#      one minority type.
+#    - Each anomaly is treated as the center of a 3x3 coarse block. Its dominant interior
+#      color marks the active pixels of that stencil. Expanding that stencil means writing
+#      the anomaly pattern onto active coarse cells and the majority pattern onto inactive
+#      coarse cells in the surrounding 3x3 block.
+#    - The new D10 component changes the flow from "solve one anomaly once" to "sort all
+#      anomalies by (row, col) and apply them one after another". Because their coarse
+#      3x3 blocks may overlap, a later anomaly can overwrite an earlier anomaly with either
+#      its own pattern or the majority pattern.
+#    - Small trace:
+#      original logic: collect repeated minority cells -> infer one global placement ->
+#      fill that one placement.
+#      combo logic: detect three distinct singleton seeds -> sort them top-left to
+#      bottom-right -> expand seed A -> expand seed B over the partially updated grid ->
+#      expand seed C last.
+#      difference: there are multiple independent blueprints and the order of execution is
+#      part of the rule, not an implementation detail.
+# b) Complexity calibration
+#    - Keeping exactly 2-3 seeds prevents collapse back to the original single-anomaly
+#      task while still being readable from a few examples.
+#    - All seeds share one active color and one shared color; they differ by shape, not by
+#      arbitrary recoloring. This keeps color inference easy.
+#    - Seed masks are restricted to connected 3x3 patterns with 5-7 active pixels, active
+#      center, and coverage on all four edges. They are easy to see and generate clear
+#      coarse expansions.
+# c) Hidden assumptions from the original solver that must change
+#    - `minority_pat = min(...)` assumed one globally least-frequent anomaly pattern.
+#      This fails once several singleton patterns coexist.
+#    - The original unique-placement search assumed the observed anomaly cells were all
+#      instances of the same pattern. Here each singleton is decoded independently.
+#    - The original final write loop assumed one write pass with one minority pattern.
+#      This combo needs several passes and later passes must be allowed to overwrite
+#      earlier cells.
+#    - The D7 reference assumed expanded blocks never overlap. D10/2 intentionally breaks
+#      that assumption, so the solver must process anomalies in a stable visible order.
+# d) Placement legality
+#    - Every seed center is chosen from coarse coordinates 1..5 so its centered 3x3 block
+#      stays inside the 7x7 cell grid.
+#    - Generated center sets include at least one overlapping pair of 3x3 blocks, but
+#      avoid near-complete overlap so the output stays legible.
+#    - The generator rejects any sample where forward order and reverse order produce the
+#      same result, because that would hide the D10 behavior.
+# e) Visual observability
+#    - A human can see that each odd cell is unique, grows into its own 3x3 coarse block,
+#      and that the final appearance follows a consistent top-left to bottom-right order.
+#      No ranking depends on hidden color ids; it depends only on visible seed positions.
+# f) Visual cleanliness
+#    - Overlap is required, but limited to partial overlap. This gives visible overwrite
+#      effects without turning the center of the grid into an unreadable pileup.
+#    - The majority pattern is uniform everywhere else, so overwritten regions remain easy
+#      to parse.
+# g) Change inferability
+#    - The palette stays small: divider, majority-exclusive, shared, and one seed-active
+#      color. The only changing ingredient is the seed shape, which is structurally tied
+#      to the resulting coarse block.
+# 9) New solver assumptions and generator guarantees
+#    - Solver assumes the majority pattern is the unique most frequent cell pattern, and
+#      every non-majority pattern appears exactly once. Generator constructs the input that
+#      way.
+#    - Solver assumes each seed's dominant color is unique and includes the center pixel.
+#      Generator only samples masks with 5-7 active pixels and active center.
+#    - Solver assumes seeds are processed in lexicographic position order and may overlap.
+#      Generator sorts centers the same way and enforces a non-zero order-sensitivity
+#      score, so the overwrite priority is real rather than decorative.
+
+from functools import reduce
+from itertools import combinations
+from math import gcd
+from pathlib import Path
+import random
+import sys
+
+import numpy as np
+
+for _parent in Path(__file__).resolve().parents:
+    _solver_dir = _parent / "solvers"
+    if _solver_dir.is_dir():
+        if str(_solver_dir) not in sys.path:
+            sys.path.append(str(_solver_dir))
+        break
+else:
+    raise RuntimeError("could not locate solvers directory")
+
+from arc_utils import paste
+
+
+def _infer_cell_grid_params(g: np.ndarray) -> tuple[int, list[int], list[int]]:
+    """
+    Infer a regular cell grid separated by full rows/cols of the same line color.
+    Returns (step, row_divs, col_divs) where:
+      - row_divs/col_divs are divider indices
+      - step is the spacing between dividers (cell size including divider).
+    """
+    h, w = g.shape
+    line = int(g[0, 0])
+    row_divs = [r for r in range(h) if np.all(g[r, :] == line)]
+    col_divs = [c for c in range(w) if np.all(g[:, c] == line)]
+    assert len(row_divs) >= 2 and len(col_divs) >= 2, "need at least 2 row and 2 col dividers"
+    row_divs.sort()
+    col_divs.sort()
+    drs = [row_divs[i + 1] - row_divs[i] for i in range(len(row_divs) - 1) if row_divs[i + 1] > row_divs[i]]
+    dcs = [col_divs[i + 1] - col_divs[i] for i in range(len(col_divs) - 1) if col_divs[i + 1] > col_divs[i]]
+    step = reduce(gcd, drs + dcs)
+    assert step > 1, "divider step must be > 1"
+    assert row_divs[0] == 0 and col_divs[0] == 0, "first divider must be at index 0"
+    assert (h - 1) % step == 0 and (w - 1) % step == 0, "grid dimensions must be (k*step + 1)"
+    assert row_divs[-1] == h - 1 and col_divs[-1] == w - 1, "last divider must be at boundary"
+    return int(step), row_divs, col_divs
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Expand several singleton anomaly cells in sequence so later local fractals can overwrite earlier ones.
+
+    Input structure:
+    - The grid is split into equal cells by full divider rows and columns of one separator color.
+    - One 3x3 interior pattern is the dominant majority cell.
+    - There are 2-3 non-majority cells, each appearing once and each using a different 3x3 interior pattern.
+
+    Rule:
+    - For every singleton anomaly, read its own dominant interior color as the active color of a 3x3 stencil.
+    - Treat the anomaly's position as the center of a coarse 3x3 block: active stencil locations receive that anomaly pattern, inactive locations receive the majority pattern.
+    - Process all anomalies in top-left to bottom-right order, writing each block onto the current grid state.
+    - Because later blocks are written after earlier ones, they may replace earlier anomaly cells or restore majority cells in overlap areas.
+
+    Key insight:
+    Each odd cell is an independent self-encoding blueprint, but the final picture is not just the union of those blueprints: it is the ordered result of layering them from upper-left seeds to lower-right seeds.
+    """
+    g = np.asarray(grid, dtype=int)
+    step, _, _ = _infer_cell_grid_params(g)
+    n = (g.shape[0] - 1) // step
+    inner = step - 1
+    assert inner == 3, "combo generator uses 3x3 cell interiors"
+    radius = inner // 2
+
+    patterns: dict[tuple[int, ...], np.ndarray] = {}
+    positions: dict[tuple[int, ...], list[tuple[int, int]]] = {}
+    for i in range(n):
+        for j in range(n):
+            r0 = i * step + 1
+            c0 = j * step + 1
+            arr = g[r0 : r0 + inner, c0 : c0 + inner].copy()
+            pat = tuple(arr.ravel().tolist())
+            if pat not in patterns:
+                patterns[pat] = arr
+            positions.setdefault(pat, []).append((i, j))
+
+    counts = {pat: len(pos_list) for pat, pos_list in positions.items()}
+    assert len(counts) >= 3, "need one majority pattern plus 2-3 singleton anomalies"
+
+    majority_pat, majority_count = max(counts.items(), key=lambda kv: kv[1])
+    assert majority_count >= n * n - 3, "majority pattern must dominate the grid"
+    majority_arr = patterns[majority_pat]
+
+    seed_specs: list[tuple[int, int, np.ndarray, np.ndarray]] = []
+    for pat, count in counts.items():
+        if pat == majority_pat:
+            continue
+        assert count == 1, "every anomaly pattern must be a singleton"
+        (ci, cj) = positions[pat][0]
+        assert radius <= ci < n - radius and radius <= cj < n - radius, "seed block must fit inside the cell grid"
+        arr = patterns[pat]
+        vals, cnts = np.unique(arr, return_counts=True)
+        order = np.argsort(cnts)
+        assert cnts[order[-1]] > cnts[order[-2]], "seed needs a unique dominant color"
+        active_color = int(vals[order[-1]])
+        mask = arr == active_color
+        assert mask[radius, radius], "seed center must be active in its own stencil"
+        seed_specs.append((ci, cj, arr, mask))
+
+    assert 2 <= len(seed_specs) <= 3, "combo expects 2-3 distinct anomaly seeds"
+    seed_specs.sort(key=lambda spec: (spec[0], spec[1]))
+
+    out = g.copy()
+    for ci, cj, seed_arr, mask in seed_specs:
+        for di in range(inner):
+            for dj in range(inner):
+                target = seed_arr if mask[di, dj] else majority_arr
+                r0 = (ci + di - radius) * step + 1
+                c0 = (cj + dj - radius) * step + 1
+                out[r0 : r0 + inner, c0 : c0 + inner] = target
+    return out
+
+
+# --------------- generator (o5x) ---------------
+
+CELL_GRID_N = 7
+CELL_INNER = 3
+CELL_STEP = 4
+GRID_SIZE = CELL_GRID_N * CELL_STEP + 1
+SEED_COUNTS = (2, 3)
+ACTIVE_PIXEL_COUNTS = (5, 6, 7)
+COLOR_POOL = 10
+MAX_RETRIES = 400
+
+_LR_GROUPS = [
+    ((0, 0), (0, 2)),
+    ((1, 0), (1, 2)),
+    ((2, 0), (2, 2)),
+    ((0, 1),),
+    ((1, 1),),
+    ((2, 1),),
+]
+
+_VALID_CENTERS = [(r, c) for r in range(1, CELL_GRID_N - 1) for c in range(1, CELL_GRID_N - 1)]
+
+
+def _precompute_seed_masks() -> list[np.ndarray]:
+    """Enumerate readable 3x3 masks with an active center and connected active region."""
+    masks: list[np.ndarray] = []
+    for bits in range(1 << (CELL_INNER * CELL_INNER)):
+        mask = np.array([(bits >> k) & 1 for k in range(CELL_INNER * CELL_INNER)], dtype=bool).reshape(CELL_INNER, CELL_INNER)
+        active = int(mask.sum())
+        if active not in ACTIVE_PIXEL_COUNTS:
+            continue
+        if not mask[1, 1]:
+            continue
+        if not mask[0, :].any() or not mask[2, :].any() or not mask[:, 0].any() or not mask[:, 2].any():
+            continue
+        coords = [tuple(rc) for rc in np.argwhere(mask)]
+        seen = {coords[0]}
+        frontier = [coords[0]]
+        while frontier:
+            r, c = frontier.pop()
+            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                nr, nc = r + dr, c + dc
+                if 0 <= nr < CELL_INNER and 0 <= nc < CELL_INNER and mask[nr, nc] and (nr, nc) not in seen:
+                    seen.add((nr, nc))
+                    frontier.append((nr, nc))
+        if len(seen) != active:
+            continue
+        masks.append(mask)
+    return masks
+
+
+def _pair_overlap_area(a: tuple[int, int], b: tuple[int, int]) -> int:
+    dr = abs(a[0] - b[0])
+    dc = abs(a[1] - b[1])
+    return max(0, CELL_INNER - dr) * max(0, CELL_INNER - dc)
+
+
+def _precompute_center_sets() -> dict[int, list[tuple[tuple[int, int], ...]]]:
+    """
+    Center choices with at least one partial overlap.
+    Overlap area is capped so the examples show covering behavior without becoming cluttered.
+    """
+    by_count: dict[int, list[tuple[tuple[int, int], ...]]] = {}
+    for count in SEED_COUNTS:
+        valid: list[tuple[tuple[int, int], ...]] = []
+        for combo in combinations(_VALID_CENTERS, count):
+            overlaps = [_pair_overlap_area(a, b) for a, b in combinations(combo, 2)]
+            if not overlaps or max(overlaps) == 0:
+                continue
+            if max(overlaps) > 4:
+                continue
+            valid.append(combo)
+        by_count[count] = valid
+    return by_count
+
+
+_SEED_MASKS = _precompute_seed_masks()
+_CENTER_SETS = _precompute_center_sets()
+
+
+def _random_lr_pattern(color_a: int, color_b: int) -> np.ndarray:
+    """Generate a non-uniform LR-symmetric 3x3 majority pattern with two colors."""
+    arr = np.empty((CELL_INNER, CELL_INNER), dtype=int)
+    choices = [random.choice((color_a, color_b)) for _ in _LR_GROUPS]
+    if all(v == choices[0] for v in choices):
+        choices[random.randrange(len(choices))] = color_b if choices[0] == color_a else color_a
+    for group, color in zip(_LR_GROUPS, choices):
+        for r, c in group:
+            arr[r, c] = color
+    return arr
+
+
+def _cell_origin(i: int, j: int) -> tuple[int, int]:
+    return i * CELL_STEP + 1, j * CELL_STEP + 1
+
+
+def _build_base_grid(separator: int, majority: np.ndarray) -> np.ndarray:
+    grid = np.full((GRID_SIZE, GRID_SIZE), separator, dtype=int)
+    for i in range(CELL_GRID_N):
+        for j in range(CELL_GRID_N):
+            paste(grid, majority, *_cell_origin(i, j))
+    return grid
+
+
+def _simulate_ordered_output(
+    separator: int,
+    majority: np.ndarray,
+    seed_specs: list[tuple[int, int, np.ndarray, np.ndarray]],
+) -> np.ndarray:
+    out = _build_base_grid(separator, majority)
+    radius = CELL_INNER // 2
+    for ci, cj, seed_arr, mask in seed_specs:
+        for di in range(CELL_INNER):
+            for dj in range(CELL_INNER):
+                target = seed_arr if mask[di, dj] else majority
+                paste(out, target, *_cell_origin(ci + di - radius, cj + dj - radius))
+    return out
+
+
+def _count_changed_cells(a: np.ndarray, b: np.ndarray) -> int:
+    changed = 0
+    for i in range(CELL_GRID_N):
+        for j in range(CELL_GRID_N):
+            r0, c0 = _cell_origin(i, j)
+            if not np.array_equal(a[r0 : r0 + CELL_INNER, c0 : c0 + CELL_INNER], b[r0 : r0 + CELL_INNER, c0 : c0 + CELL_INNER]):
+                changed += 1
+    return changed
+
+
+def _visible_seed_counts(grid: np.ndarray, seed_patterns: list[np.ndarray]) -> list[int]:
+    counts = [0 for _ in seed_patterns]
+    for i in range(CELL_GRID_N):
+        for j in range(CELL_GRID_N):
+            r0, c0 = _cell_origin(i, j)
+            cell = grid[r0 : r0 + CELL_INNER, c0 : c0 + CELL_INNER]
+            for idx, pat in enumerate(seed_patterns):
+                if np.array_equal(cell, pat):
+                    counts[idx] += 1
+    return counts
+
+
+def _gen_attempt(return_meta: bool = False):
+    separator, maj_exclusive, shared, seed_color = random.sample(range(COLOR_POOL), 4)
+    majority = _random_lr_pattern(shared, maj_exclusive)
+
+    seed_count = random.choice(SEED_COUNTS)
+    centers = list(random.choice(_CENTER_SETS[seed_count]))
+    masks = random.sample(_SEED_MASKS, seed_count)
+    seed_specs: list[tuple[int, int, np.ndarray, np.ndarray]] = []
+    for (ci, cj), mask in zip(centers, masks):
+        seed_arr = np.where(mask, seed_color, shared).astype(int)
+        seed_specs.append((ci, cj, seed_arr, mask.copy()))
+    seed_specs.sort(key=lambda spec: (spec[0], spec[1]))
+    seed_patterns = [seed_arr for _, _, seed_arr, _ in seed_specs]
+
+    inp = _build_base_grid(separator, majority)
+    for ci, cj, seed_arr, _ in seed_specs:
+        paste(inp, seed_arr, *_cell_origin(ci, cj))
+
+    out = _simulate_ordered_output(separator, majority, seed_specs)
+    rev = _simulate_ordered_output(separator, majority, list(reversed(seed_specs)))
+    order_diff_cells = _count_changed_cells(out, rev)
+    if order_diff_cells < 2:
+        return None
+
+    visible_counts = _visible_seed_counts(out, seed_patterns)
+    if min(visible_counts) < 2:
+        return None
+
+    overlap_pairs = 0
+    overlap_cells = 0
+    for (a_idx, a), (b_idx, b) in combinations(enumerate(seed_specs), 2):
+        del a_idx, b_idx
+        area = _pair_overlap_area((a[0], a[1]), (b[0], b[1]))
+        if area > 0:
+            overlap_pairs += 1
+            overlap_cells += area
+    if overlap_pairs == 0:
+        return None
+
+    try:
+        solved = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(solved, out):
+        return None
+
+    if return_meta:
+        meta = {
+            "seed_count": len(seed_specs),
+            "centers": [(ci, cj) for ci, cj, _, _ in seed_specs],
+            "order_diff_cells": order_diff_cells,
+            "overlap_pairs": overlap_pairs,
+            "overlap_cells": overlap_cells,
+            "visible_counts": visible_counts,
+        }
+        return inp, out, meta
+    return inp
+
+
+def generate_input():
+    for _ in range(MAX_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid b99e7126 combo input")

