+# --------------- generator (o5x) ---------------
+
+CELL_GRID_N = 7
+CELL_INNER = 3
+CELL_STEP = 4
+GRID_SIZE = CELL_GRID_N * CELL_STEP + 1
+SEED_COUNTS = (2, 3)
+ACTIVE_PIXEL_COUNTS = (5, 6, 7)
