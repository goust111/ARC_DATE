+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Recover the odd cell's internal mask, then inflate it into a grid-sized overlay that may extend the canvas.
+
+    Input structure:
+    - A square cell grid with 1-pixel separator lines and 3x3 cell interiors.
+    - Most cells share one interior pattern; a sparse minority of cells share another.
+    - Those minority cells are a subset of a hidden 3x3 source mask placed somewhere inside the input grid.
+
+    Rule:
+    - Identify the minority cell pattern and read its dominant color as a binary source mask.
+    - Infer the unique top-left placement of that source mask from the visible minority subset.
+    - Blow the source mask up to a full grid-sized footprint: each source pixel becomes a proportional band of cells.
+    - Anchor that enlarged footprint at the inferred top-left; if it runs past the original lower/right edge, enlarge the output grid to keep the full pattern.
+
+    Key insight: The odd cell is not only a local exception; it is a miniature template for a much larger proportional copy whose anchor is revealed by the few minority cells already present.
+    """
+    g = np.asarray(grid, dtype=int)
+    step, _, _ = _infer_cell_grid_params(g)
+    n, _inner, patterns, cell_pat = _extract_patterns(g, step)
