+    try:
+        solved = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(solved, out):
+        return None
+
+    meta = {
+        "top": int(top),
+        "left": int(left),
+        "out_h": int(out.shape[0]),
+        "out_w": int(out.shape[1]),
+    }
+    return inp, out, meta
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_RETRIES):
+        result = _gen_attempt()
+        if result is not None:
+            inp, _out, _meta = result
+            return inp
+    raise RuntimeError("failed to generate a valid D3/1+D9/1 input")

