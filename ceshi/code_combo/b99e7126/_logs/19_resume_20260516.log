+# --------------- generator ---------------
+
+CELL_GRID_N = 7
+CELL_INNER = 3
+CELL_STEP = CELL_INNER + 1
+GRID_SIZE = CELL_GRID_N * CELL_STEP + 1
+MASK_SIZE = CELL_INNER
+PLACEMENT_RANGE = CELL_GRID_N - MASK_SIZE + 1
+ACTIVE_PIXEL_COUNTS = (6, 7)
