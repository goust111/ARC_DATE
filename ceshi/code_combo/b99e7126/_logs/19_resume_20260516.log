+from arc_utils import paste
+
+# Design analysis for the fused variant
+# ------------------------------------
+# a) Concrete behavior:
+#    Original b99e7126 used the minority cell's 3x3 interior as a 3x3 mask placed
+#    somewhere inside a 7x7 cell grid; each source pixel became exactly one cell.
+#    Here the same minority mask is still first localized from the sparse input subset,
+#    but the completed pattern is then blown up to a full grid-sized footprint:
+#    each source pixel expands into a proportional band of cells, and that footprint
+#    is anchored at the inferred minority block's top-left. Example with n=7, top=2:
+#    the old task only filled rows 2..4 of the cell grid, while the new task fills a
+#    7-row-tall proportional copy starting at row 2, so rows 2..8 are covered and the
+#    canvas must expand to keep rows 7..8.
+# b) Complexity calibration:
+#    The source mask is still only 3x3 and uses 6-7 active pixels, so the relation
+#    between the tiny source and the large target remains visible. We keep the original
+#    unique-placement constraint on the sparse minority subset so the task is not
+#    ambiguous, and we force expansion by avoiding top=left=0 so D9/1 is actually used.
+# c) Implicit assumptions that changed:
+#    - The old solver assumed the completed footprint was exactly mh x mw cells.
+#      That no longer holds; the new footprint is n x n cells.
+#    - The old solver assumed output shape equals input shape.
+#      That no longer holds; output may grow to (top+n) x (left+n) cells.
+#    - The old solver could update a copy of the input grid in place.
+#      That no longer holds; we rebuild a larger grid from scratch when needed.
+# d) Placement legality:
+#    Input placement still uses the original 3x3 mask window, so minority cells never
+#    overlap and always stay within the 7x7 input grid. The expanded output footprint is
+#    allowed to exceed the original bottom/right boundary, and the output canvas is sized
+#    to exactly contain it.
+# e) Visual observability:
+#    Across examples, the few minority cells in the input identify both the 3x3 source
+#    mask and its top-left anchor. In the output, the same motif becomes large bands of
+#    minority/majority cells, so the "small blueprint -> large proportional stamp" rule
+#    is visible without relying on numeric color ids.
+# f) Visual cleanliness:
+#    Only two cell interiors are used (majority/minority), with separator lines left
+#    intact. Expansion happens only on the lower/right side, so the result remains a
+#    clean rectilinear grid rather than a multi-layer overlap.
+# g) Learnability of color use:
+#    The active color is simply the more frequent color inside the minority cell, exactly
+#    as in the source task. No hidden color ordering is introduced; the enlarged output
+#    merely repeats minority vs majority cells according to the scaled mask.
+
+
+def _infer_cell_grid_params(g: np.ndarray) -> tuple[int, list[int], list[int]]:
+    """Infer the regular divider step from full separator rows and columns."""
+    h, w = g.shape
+    line = int(g[0, 0])
+    row_divs = [r for r in range(h) if np.all(g[r, :] == line)]
+    col_divs = [c for c in range(w) if np.all(g[:, c] == line)]
+    assert len(row_divs) >= 2 and len(col_divs) >= 2
+    row_divs.sort()
+    col_divs.sort()
+    drs = [row_divs[i + 1] - row_divs[i] for i in range(len(row_divs) - 1)]
+    dcs = [col_divs[i + 1] - col_divs[i] for i in range(len(col_divs) - 1)]
+    step = reduce(gcd, drs + dcs)
+    assert step > 1
+    assert row_divs[0] == 0 and col_divs[0] == 0
+    assert row_divs[-1] == h - 1 and col_divs[-1] == w - 1
+    assert (h - 1) % step == 0 and (w - 1) % step == 0
+    return int(step), row_divs, col_divs
+
+
+def _extract_patterns(g: np.ndarray, step: int) -> tuple[int, int, dict[tuple[int, ...], np.ndarray], list[list[tuple[int, ...]]]]:
+    """Return cell-grid size, inner size, unique pattern arrays, and per-cell pattern ids."""
+    n = (g.shape[0] - 1) // step
+    inner = step - 1
+    patterns: dict[tuple[int, ...], np.ndarray] = {}
+    cell_pat: list[list[tuple[int, ...]]] = []
+    for i in range(n):
+        row: list[tuple[int, ...]] = []
+        for j in range(n):
+            r0 = i * step + 1
+            c0 = j * step + 1
+            arr = g[r0 : r0 + inner, c0 : c0 + inner].copy()
+            key = tuple(arr.ravel().tolist())
+            patterns.setdefault(key, arr)
+            row.append(key)
+        cell_pat.append(row)
+    return int(n), int(inner), patterns, cell_pat
+
+
+def _minority_majority(cell_pat: list[list[tuple[int, ...]]]) -> tuple[tuple[int, ...], tuple[int, ...]]:
+    counts: dict[tuple[int, ...], int] = {}
+    for row in cell_pat:
+        for key in row:
+            counts[key] = counts.get(key, 0) + 1
+    assert len(counts) >= 2
+    minority_pat = min(counts.items(), key=lambda kv: kv[1])[0]
+    majority_pat = max(counts.items(), key=lambda kv: kv[1])[0]
+    return minority_pat, majority_pat
+
+
+def _minority_mask(minority_arr: np.ndarray) -> np.ndarray:
+    vals, cnts = np.unique(minority_arr, return_counts=True)
+    active_color = int(vals[cnts.argmax()])
+    return minority_arr == active_color
+
+
+def _existing_mask(cell_pat: list[list[tuple[int, ...]]], minority_pat: tuple[int, ...]) -> np.ndarray:
+    n = len(cell_pat)
+    out = np.zeros((n, n), dtype=bool)
+    for i in range(n):
+        for j in range(n):
+            out[i, j] = cell_pat[i][j] == minority_pat
+    return out
+
+
+def _locate_source_block(existing: np.ndarray, mask: np.ndarray) -> tuple[int, int]:
+    """Recover the original mh x mw placement from the sparse minority subset."""
+    n = existing.shape[0]
+    mh, mw = mask.shape
+    candidates: list[tuple[int, int]] = []
+    for top in range(0, n - mh + 1):
+        for left in range(0, n - mw + 1):
+            block = np.zeros_like(existing)
+            block[top : top + mh, left : left + mw] = True
+            if np.any(existing & ~block):
+                continue
+            ex_block = existing[top : top + mh, left : left + mw]
+            if np.any(ex_block & ~mask):
+                continue
+            candidates.append((int(top), int(left)))
+    assert len(candidates) == 1
+    return candidates[0]
+
+
+def _build_majority_grid(separator: int, majority: np.ndarray, step: int, rows: int, cols: int) -> np.ndarray:
+    out = np.full((rows * step + 1, cols * step + 1), int(separator), dtype=int)
+    inner = step - 1
+    assert majority.shape == (inner, inner)
+    for i in range(rows):
+        for j in range(cols):
+            paste(out, majority, i * step + 1, j * step + 1)
+    return out
+
+
+def _render_scaled_overlay(
+    separator: int,
+    majority: np.ndarray,
+    minority: np.ndarray,
+    mask: np.ndarray,
+    step: int,
+    anchor_top: int,
+    anchor_left: int,
+    n: int,
+) -> np.ndarray:
+    """
+    Render an n x n proportional blow-up of `mask`, anchored at (anchor_top, anchor_left)
+    in cell coordinates. The canvas grows as needed to hold the full footprint.
+    """
+    out_rows = anchor_top + n
+    out_cols = anchor_left + n
+    out = _build_majority_grid(separator, majority, step, out_rows, out_cols)
+    mh, mw = mask.shape
+    inner = step - 1
+    assert minority.shape == (inner, inner)
+    for i in range(n):
+        for j in range(n):
+            src_r = (i * mh) // n
+            src_c = (j * mw) // n
+            patch = minority if mask[src_r, src_c] else majority
+            r0 = (anchor_top + i) * step + 1
+            c0 = (anchor_left + j) * step + 1
+            out[r0 : r0 + inner, c0 : c0 + inner] = patch
+    return out
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Recover the odd cell's internal mask, then inflate it into a grid-sized overlay that may extend the canvas.
+
+    Input structure:
+    - A square cell grid with 1-pixel separator lines and 3x3 cell interiors.
+    - Most cells share one interior pattern; a sparse minority of cells share another.
+    - Those minority cells are a subset of a hidden 3x3 source mask placed somewhere inside the input grid.
+
+    Rule:
+    - Identify the minority cell pattern and read its dominant color as a binary source mask.
+    - Infer the unique top-left placement of that source mask from the visible minority subset.
+    - Blow the source mask up to a full grid-sized footprint: each source pixel becomes a proportional band of cells.
+    - Anchor that enlarged footprint at the inferred top-left; if it runs past the original lower/right edge, enlarge the output grid to keep the full pattern.
+
+    Key insight: The odd cell is not only a local exception; it is a miniature template for a much larger proportional copy whose anchor is revealed by the few minority cells already present.
+    """
+    g = np.asarray(grid, dtype=int)
+    step, _, _ = _infer_cell_grid_params(g)
+    n, _inner, patterns, cell_pat = _extract_patterns(g, step)
+
+    minority_pat, majority_pat = _minority_majority(cell_pat)
+    minority_arr = patterns[minority_pat]
+    majority_arr = patterns[majority_pat]
+    mask = _minority_mask(minority_arr)
+    existing = _existing_mask(cell_pat, minority_pat)
+    top, left = _locate_source_block(existing, mask)
+
+    separator = int(g[0, 0])
+    return _render_scaled_overlay(separator, majority_arr, minority_arr, mask, step, top, left, n)
+
+
+# --------------- generator ---------------
+
+CELL_GRID_N = 7
+CELL_INNER = 3
+CELL_STEP = CELL_INNER + 1
+GRID_SIZE = CELL_GRID_N * CELL_STEP + 1
+MASK_SIZE = CELL_INNER
+PLACEMENT_RANGE = CELL_GRID_N - MASK_SIZE + 1
+ACTIVE_PIXEL_COUNTS = (6, 7)
+GIVEN_CELL_SIZES = (3, 4)
+COLOR_POOL = 10
+MAX_RETRIES = 400
+
+_LR_GROUPS = [
+    ((0, 0), (0, 2)),
+    ((1, 0), (1, 2)),
+    ((2, 0), (2, 2)),
+    ((0, 1),),
+    ((1, 1),),
+    ((2, 1),),
