+def _minority_mask(minority_arr: np.ndarray) -> np.ndarray:
+    vals, cnts = np.unique(minority_arr, return_counts=True)
+    active_color = int(vals[cnts.argmax()])
+    return minority_arr == active_color
+
+
+def _existing_mask(cell_pat: list[list[tuple[int, ...]]], minority_pat: tuple[int, ...]) -> np.ndarray:
+    n = len(cell_pat)
+    out = np.zeros((n, n), dtype=bool)
+    for i in range(n):
+        for j in range(n):
+            out[i, j] = cell_pat[i][j] == minority_pat
+    return out
+
+
+def _locate_source_block(existing: np.ndarray, mask: np.ndarray) -> tuple[int, int]:
+    """Recover the original mh x mw placement from the sparse minority subset."""
+    n = existing.shape[0]
+    mh, mw = mask.shape
+    candidates: list[tuple[int, int]] = []
+    for top in range(0, n - mh + 1):
+        for left in range(0, n - mw + 1):
+            block = np.zeros_like(existing)
+            block[top : top + mh, left : left + mw] = True
+            if np.any(existing & ~block):
+                continue
+            ex_block = existing[top : top + mh, left : left + mw]
+            if np.any(ex_block & ~mask):
+                continue
+            candidates.append((int(top), int(left)))
+    assert len(candidates) == 1
+    return candidates[0]
+
+
+def _build_majority_grid(separator: int, majority: np.ndarray, step: int, rows: int, cols: int) -> np.ndarray:
+    out = np.full((rows * step + 1, cols * step + 1), int(separator), dtype=int)
+    inner = step - 1
+    assert majority.shape == (inner, inner)
+    for i in range(rows):
+        for j in range(cols):
+            paste(out, majority, i * step + 1, j * step + 1)
+    return out
+
+
+def _render_scaled_overlay(
+    separator: int,
+    majority: np.ndarray,
+    minority: np.ndarray,
+    mask: np.ndarray,
+    step: int,
+    anchor_top: int,
+    anchor_left: int,
+    n: int,
+) -> np.ndarray:
+    """
+    Render an n x n proportional blow-up of `mask`, anchored at (anchor_top, anchor_left)
+    in cell coordinates. The canvas grows as needed to hold the full footprint.
+    """
+    out_rows = anchor_top + n
+    out_cols = anchor_left + n
+    out = _build_majority_grid(separator, majority, step, out_rows, out_cols)
+    mh, mw = mask.shape
+    inner = step - 1
+    assert minority.shape == (inner, inner)
+    for i in range(n):
+        for j in range(n):
+            src_r = (i * mh) // n
+            src_c = (j * mw) // n
+            patch = minority if mask[src_r, src_c] else majority
+            r0 = (anchor_top + i) * step + 1
+            c0 = (anchor_left + j) * step + 1
+            out[r0 : r0 + inner, c0 : c0 + inner] = patch
+    return out
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Recover the odd cell's internal mask, then inflate it into a grid-sized overlay that may extend the canvas.
+
+    Input structure:
+    - A square cell grid with 1-pixel separator lines and 3x3 cell interiors.
+    - Most cells share one interior pattern; a sparse minority of cells share another.
+    - Those minority cells are a subset of a hidden 3x3 source mask placed somewhere inside the input grid.
+
+    Rule:
+    - Identify the minority cell pattern and read its dominant color as a binary source mask.
+    - Infer the unique top-left placement of that source mask from the visible minority subset.
+    - Blow the source mask up to a full grid-sized footprint: each source pixel becomes a proportional band of cells.
+    - Anchor that enlarged footprint at the inferred top-left; if it runs past the original lower/right edge, enlarge the output grid to keep the full pattern.
+
+    Key insight: The odd cell is not only a local exception; it is a miniature template for a much larger proportional copy whose anchor is revealed by the few minority cells already present.
+    """
+    g = np.asarray(grid, dtype=int)
+    step, _, _ = _infer_cell_grid_params(g)
+    n, _inner, patterns, cell_pat = _extract_patterns(g, step)
+
+    minority_pat, majority_pat = _minority_majority(cell_pat)
+    minority_arr = patterns[minority_pat]
+    majority_arr = patterns[majority_pat]
+    mask = _minority_mask(minority_arr)
+    existing = _existing_mask(cell_pat, minority_pat)
+    top, left = _locate_source_block(existing, mask)
+
+    separator = int(g[0, 0])
+    return _render_scaled_overlay(separator, majority_arr, minority_arr, mask, step, top, left, n)
+
+
+# --------------- generator ---------------
+
+CELL_GRID_N = 7
+CELL_INNER = 3
+CELL_STEP = CELL_INNER + 1
+GRID_SIZE = CELL_GRID_N * CELL_STEP + 1
+MASK_SIZE = CELL_INNER
+PLACEMENT_RANGE = CELL_GRID_N - MASK_SIZE + 1
+ACTIVE_PIXEL_COUNTS = (6, 7)
+GIVEN_CELL_SIZES = (3, 4)
+COLOR_POOL = 10
+MAX_RETRIES = 400
+
+_LR_GROUPS = [
+    ((0, 0), (0, 2)),
+    ((1, 0), (1, 2)),
+    ((2, 0), (2, 2)),
+    ((0, 1),),
+    ((1, 1),),
+    ((2, 1),),
+]
+
+
+def _precompute_masks() -> dict[int, list[np.ndarray]]:
+    weights = [len(group) for group in _LR_GROUPS]
+    by_count: dict[int, list[np.ndarray]] = {}
+    for active_count in ACTIVE_PIXEL_COUNTS:
+        inactive = MASK_SIZE * MASK_SIZE - active_count
+        masks: list[np.ndarray] = []
+        for k in range(1, len(_LR_GROUPS) + 1):
+            for combo in combinations(range(len(_LR_GROUPS)), k):
+                if sum(weights[idx] for idx in combo) != inactive:
+                    continue
+                mask = np.ones((MASK_SIZE, MASK_SIZE), dtype=bool)
+                for idx in combo:
+                    for r, c in _LR_GROUPS[idx]:
+                        mask[r, c] = False
+                if mask[0, :].any() and mask[2, :].any() and mask[:, 0].any() and mask[:, 2].any():
+                    masks.append(mask)
+        by_count[active_count] = masks
+    return by_count
+
+
+_MASKS_BY_COUNT = _precompute_masks()
+
+
+def _random_lr_pattern(color_a: int, color_b: int) -> np.ndarray:
+    arr = np.empty((MASK_SIZE, MASK_SIZE), dtype=int)
+    choices = [random.choice((color_a, color_b)) for _ in _LR_GROUPS]
+    if all(v == choices[0] for v in choices):
+        choices[random.randrange(len(choices))] = color_b if choices[0] == color_a else color_a
+    for group, color in zip(_LR_GROUPS, choices):
+        for r, c in group:
+            arr[r, c] = color
+    return arr
+
+
+def _random_minority_mask() -> np.ndarray:
+    active_count = random.choice(ACTIVE_PIXEL_COUNTS)
+    return random.choice(_MASKS_BY_COUNT[active_count])
+
+
+def _cell_origin(i: int, j: int) -> tuple[int, int]:
+    return i * CELL_STEP + 1, j * CELL_STEP + 1
+
+
+def _build_input_grid(separator: int, majority: np.ndarray, minority: np.ndarray, active_cells: list[tuple[int, int]]) -> np.ndarray:
+    grid = np.full((GRID_SIZE, GRID_SIZE), int(separator), dtype=int)
+    for i in range(CELL_GRID_N):
+        for j in range(CELL_GRID_N):
+            paste(grid, majority, *_cell_origin(i, j))
+    for i, j in active_cells:
+        paste(grid, minority, *_cell_origin(i, j))
+    return grid
+
+
+def _placement_candidates(mask: np.ndarray, subset: tuple[tuple[int, int], ...], top: int, left: int) -> list[tuple[int, int]]:
+    existing = np.zeros((CELL_GRID_N, CELL_GRID_N), dtype=bool)
+    for r, c in subset:
+        existing[top + r, left + c] = True
+
+    candidates: list[tuple[int, int]] = []
+    for t in range(PLACEMENT_RANGE):
+        for l in range(PLACEMENT_RANGE):
+            block = np.zeros_like(existing)
+            block[t : t + MASK_SIZE, l : l + MASK_SIZE] = True
+            if np.any(existing & ~block):
+                continue
+            if np.any(existing[t : t + MASK_SIZE, l : l + MASK_SIZE] & ~mask):
+                continue
+            candidates.append((int(t), int(l)))
+    return candidates
+
+
+def _choose_given_subset(mask: np.ndarray, top: int, left: int) -> tuple[tuple[int, int], ...] | None:
+    active = [tuple(coord) for coord in np.argwhere(mask)]
+    sizes = list(GIVEN_CELL_SIZES)
+    random.shuffle(sizes)
+    for size in sizes:
+        valid = [
+            subset
+            for subset in combinations(active, size)
+            if _placement_candidates(mask, subset, top, left) == [(top, left)]
+        ]
+        if valid:
+            return random.choice(valid)
+    return None
+
+
+def _pick_anchor() -> tuple[int, int]:
+    """Force at least one positive offset so output expansion is always exercised."""
+    while True:
+        top = random.randrange(PLACEMENT_RANGE)
+        left = random.randrange(PLACEMENT_RANGE)
+        if top > 0 or left > 0:
+            return int(top), int(left)
+
+
+def _gen_attempt() -> tuple[np.ndarray, np.ndarray, dict[str, int]] | None:
+    separator, maj_exclusive, shared, min_exclusive = random.sample(range(COLOR_POOL), 4)
+    majority = _random_lr_pattern(shared, maj_exclusive)
+    mask = _random_minority_mask()
+    minority = np.where(mask, min_exclusive, shared).astype(int)
+
+    top, left = _pick_anchor()
+    active_cells = [(top + r, left + c) for r, c in np.argwhere(mask)]
+    out = _render_scaled_overlay(separator, majority, minority, mask, CELL_STEP, top, left, CELL_GRID_N)
+
+    subset = _choose_given_subset(mask, top, left)
+    if subset is None:
+        return None
+    given_cells = [(top + r, left + c) for r, c in subset]
+    inp = _build_input_grid(separator, majority, minority, given_cells)
+
+    try:
+        solved = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(solved, out):
+        return None
+
+    meta = {
+        "top": int(top),
+        "left": int(left),
+        "out_h": int(out.shape[0]),
+        "out_w": int(out.shape[1]),
+    }
+    return inp, out, meta
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_RETRIES):
+        result = _gen_attempt()
+        if result is not None:
+            inp, _out, _meta = result
+            return inp
+    raise RuntimeError("failed to generate a valid D3/1+D9/1 input")

