+    col_divs = [c for c in range(w) if np.all(g[:, c] == line)]
+    assert len(row_divs) >= 2 and len(col_divs) >= 2, "need at least 2 row and 2 col dividers"
+    row_divs.sort()
+    col_divs.sort()
+    drs = [row_divs[i + 1] - row_divs[i] for i in range(len(row_divs) - 1) if row_divs[i + 1] > row_divs[i]]
+    dcs = [col_divs[i + 1] - col_divs[i] for i in range(len(col_divs) - 1) if col_divs[i + 1] > col_divs[i]]
+    step = reduce(gcd, drs + dcs)
+    assert step > 1, "divider step must be > 1"
+    assert row_divs[0] == 0 and col_divs[0] == 0, "first divider must be at index 0"
+    assert (h - 1) % step == 0 and (w - 1) % step == 0, "grid dimensions must be (k*step + 1)"
+    assert row_divs[-1] == h - 1 and col_divs[-1] == w - 1, "last divider must be at boundary"
+    return int(step), row_divs, col_divs
+
+
+def _anchor_values(n_cells: int, mask_size: int) -> list[int]:
+    """Allow only anchors clearly above/below and left/right of the middle band."""
+    split = (n_cells - mask_size) // 2
+    return [idx for idx in range(n_cells - mask_size + 1) if idx != split]
+
+
+def _source_rotation_quarters(left: int, n_cells: int, mask_size: int) -> int:
+    """Left anchors turn the source CCW; right anchors turn it CW."""
+    split = (n_cells - mask_size) // 2
+    return 1 if left < split else 3
+
+
+def _overlay_rotation_quarters(top: int, n_cells: int, mask_size: int) -> int:
+    """Top anchors turn the enlarged blueprint CCW; bottom anchors turn it CW."""
+    split = (n_cells - mask_size) // 2
+    return 1 if top < split else 3
+
+
+def _build_candidate_masks(
+    minority_arr: np.ndarray,
+    active_color: int,
+    top: int,
+    left: int,
+    n_cells: int,
+) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
+    """Return (rotated_source_pattern, source_mask, final_overlay_mask) for one anchor."""
+    src_turns = _source_rotation_quarters(left, n_cells, minority_arr.shape[0])
+    src_arr = np.rot90(minority_arr, src_turns)
+    src_mask = src_arr == active_color
+    overlay_turns = _overlay_rotation_quarters(top, n_cells, minority_arr.shape[0])
+    final_mask = np.rot90(src_mask, overlay_turns)
+    return src_arr, src_mask, final_mask
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Complete the fractal overlay after rotating both the source motif and the enlarged blueprint.
+
+    Input structure:
+    - The board is a 7x7 cell lattice of 3x3 interiors separated by 1-pixel divider lines.
+    - One 3x3 interior pattern is the majority motif; a few cells show one raw minority motif.
+    - The raw minority motif is not yet in its final orientation, and its foreground layout is only
+      the starting point for the large-scale placement.
+
+    Rule:
+    - Identify the raw minority motif and its more frequent color.
+    - For each possible 3x3 block anchor, rotate the minority motif first according to the anchor's
+      left/right region, then read that rotated motif's foreground as a 3x3 mask.
+    - Rotate that mask again according to the anchor's top/bottom region, and keep the unique
+      anchor whose twice-transformed mask contains every shown minority cell.
+    - Fill every active cell in that block with the once-rotated minority motif; inactive cells in
+      the block keep the majority motif.
+
+    Key insight:
+    The abnormal cell still encodes the macro layout, but now there are two linked orientation
+    steps: one decides what the minority cell should look like in the output, and the other decides
+    how that oriented motif is arranged across the full cell grid.
+    """
+    g = np.asarray(grid, dtype=int)
+    step, _, _ = _infer_cell_grid_params(g)
+    n = (g.shape[0] - 1) // step
+    inner = step - 1
+
+    patterns: dict[tuple[int, ...], np.ndarray] = {}
+    cell_pat: list[list[tuple[int, ...]]] = []
+    for i in range(n):
+        row: list[tuple[int, ...]] = []
+        for j in range(n):
+            r0 = i * step + 1
+            c0 = j * step + 1
+            pat_arr = g[r0 : r0 + inner, c0 : c0 + inner].copy()
+            pat = tuple(pat_arr.ravel().tolist())
+            if pat not in patterns:
+                patterns[pat] = pat_arr
+            row.append(pat)
+        cell_pat.append(row)
+
+    counts: dict[tuple[int, ...], int] = {}
+    for i in range(n):
+        for j in range(n):
+            p = cell_pat[i][j]
+            counts[p] = counts.get(p, 0) + 1
+    assert len(counts) >= 2, "must have at least 2 distinct cell patterns (minority + majority)"
+
+    minority_pat = min(counts.items(), key=lambda kv: kv[1])[0]
+    majority_pat = max(counts.items(), key=lambda kv: kv[1])[0]
+    minority_arr = patterns[minority_pat]
+    majority_arr = patterns[majority_pat]
+
+    vals, cnts = np.unique(minority_arr, return_counts=True)
+    active_color = int(vals[cnts.argmax()])
+    mh, mw = minority_arr.shape
+
+    existing = np.zeros((n, n), dtype=bool)
+    for i in range(n):
+        for j in range(n):
+            existing[i, j] = cell_pat[i][j] == minority_pat
+
+    candidates: list[tuple[int, int]] = []
+    for top in _anchor_values(n, mh):
+        for left in _anchor_values(n, mw):
+            block = np.zeros_like(existing)
+            block[top : top + mh, left : left + mw] = True
+            if np.any(existing & ~block):
+                continue
+            _src_arr, _src_mask, final_mask = _build_candidate_masks(minority_arr, active_color, top, left, n)
+            ex_block = existing[top : top + mh, left : left + mw]
+            if np.any(ex_block & ~final_mask):
+                continue
+            candidates.append((int(top), int(left)))
+
+    assert len(candidates) == 1, "must have a unique two-stage rotated mask placement"
+    top, left = candidates[0]
+    rotated_source, _src_mask, final_mask = _build_candidate_masks(minority_arr, active_color, top, left, n)
+
+    out = g.copy()
+    for i in range(mh):
+        for j in range(mw):
+            target_pat = rotated_source if final_mask[i, j] else majority_arr
+            r0 = (top + i) * step + 1
+            c0 = (left + j) * step + 1
+            out[r0 : r0 + inner, c0 : c0 + inner] = target_pat
+    return out
+
+
+# --------------- generator (o5x) ---------------
+
+CELL_GRID_N = 7
+CELL_INNER = 3
+CELL_STEP = 4
+GRID_SIZE = 29
+MASK_SIZE = 3
+PLACEMENT_RANGE = CELL_GRID_N - MASK_SIZE + 1
+ACTIVE_PIXEL_COUNTS = (5, 6)
+GIVEN_CELL_SIZES = [3, 4]
+PLACEMENT_CHOICES = tuple(
+    (top, left)
+    for top in _anchor_values(CELL_GRID_N, MASK_SIZE)
+    for left in _anchor_values(CELL_GRID_N, MASK_SIZE)
+)
+COLOR_POOL = 10
+MAX_RETRIES = 600
+
+
+def _precompute_masks() -> dict[int, list[np.ndarray]]:
+    """Enumerate asymmetric 3x3 masks whose four quarter-turns are all distinct."""
+    by_count: dict[int, list[np.ndarray]] = {count: [] for count in ACTIVE_PIXEL_COUNTS}
+    for bits in range(1 << (MASK_SIZE * MASK_SIZE)):
+        mask = np.array([(bits >> k) & 1 for k in range(MASK_SIZE * MASK_SIZE)], dtype=bool).reshape(MASK_SIZE, MASK_SIZE)
+        active_count = int(mask.sum())
+        if active_count not in by_count:
+            continue
+        if not (mask[0, :].any() and mask[2, :].any() and mask[:, 0].any() and mask[:, 2].any()):
+            continue
+        rotations = {np.rot90(mask, k).tobytes() for k in range(4)}
+        if len(rotations) != 4:
+            continue
+        by_count[active_count].append(mask)
+    return by_count
+
+
+_MASKS_BY_COUNT = _precompute_masks()
+
+
+def _random_two_color_pattern(color_a: int, color_b: int) -> np.ndarray:
+    """Generate a non-uniform 3x3 pattern using exactly two colors."""
+    arr = np.array([[random.choice((color_a, color_b)) for _ in range(MASK_SIZE)] for _ in range(MASK_SIZE)], dtype=int)
+    if np.all(arr == arr[0, 0]):
+        rr = random.randrange(MASK_SIZE)
+        cc = random.randrange(MASK_SIZE)
+        arr[rr, cc] = color_b if arr[rr, cc] == color_a else color_a
+    if not (np.any(arr == color_a) and np.any(arr == color_b)):
+        rr = random.randrange(MASK_SIZE)
+        cc = random.randrange(MASK_SIZE)
+        arr[rr, cc] = color_b
+    return arr
+
+
+def _random_minority_mask() -> np.ndarray:
+    """Pick a random asymmetric minority blueprint mask."""
+    active_count = random.choice(ACTIVE_PIXEL_COUNTS)
+    return random.choice(_MASKS_BY_COUNT[active_count]).copy()
+
+
+def _cell_origin(i: int, j: int) -> tuple[int, int]:
+    """Pixel origin of cell (i, j) interior within the full grid."""
+    return i * CELL_STEP + 1, j * CELL_STEP + 1
+
+
+def _build_grid(separator: int, majority: np.ndarray, minority: np.ndarray, active_cells: list[tuple[int, int]]) -> np.ndarray:
+    """Construct a 29x29 grid: fill all cells with majority, then overwrite active_cells."""
+    grid = np.full((GRID_SIZE, GRID_SIZE), separator, dtype=int)
+    for i in range(CELL_GRID_N):
+        for j in range(CELL_GRID_N):
+            paste(grid, majority, *_cell_origin(i, j))
+    for i, j in active_cells:
+        paste(grid, minority, *_cell_origin(i, j))
+    return grid
+
+
+def _placement_candidates(
+    minority_arr: np.ndarray,
+    active_color: int,
+    subset_abs: tuple[tuple[int, int], ...] | list[tuple[int, int]],
+) -> list[tuple[int, int]]:
+    """Find all anchors whose two-stage transformed mask is consistent with the shown cells."""
+    existing = np.zeros((CELL_GRID_N, CELL_GRID_N), dtype=bool)
+    for r, c in subset_abs:
+        existing[r, c] = True
+
+    candidates: list[tuple[int, int]] = []
+    for top, left in PLACEMENT_CHOICES:
+        _src_arr, _src_mask, final_mask = _build_candidate_masks(minority_arr, active_color, top, left, CELL_GRID_N)
+        block = np.zeros((CELL_GRID_N, CELL_GRID_N), dtype=bool)
+        block[top : top + MASK_SIZE, left : left + MASK_SIZE] = True
+        if np.any(existing & ~block):
+            continue
+        if np.any(existing[top : top + MASK_SIZE, left : left + MASK_SIZE] & ~final_mask):
+            continue
+        candidates.append((top, left))
+    return candidates
+
+
+def _choose_given_subset(minority_arr: np.ndarray, active_color: int, top: int, left: int) -> list[tuple[int, int]] | None:
+    """Choose a shown subset of active cells that pins down one anchor uniquely."""
+    _src_arr, _src_mask, final_mask = _build_candidate_masks(minority_arr, active_color, top, left, CELL_GRID_N)
+    active_abs = [(top + r, left + c) for r, c in np.argwhere(final_mask)]
+    sizes = list(GIVEN_CELL_SIZES)
+    random.shuffle(sizes)
+    for size in sizes:
+        valid = [
+            list(subset)
+            for subset in combinations(active_abs, size)
+            if _placement_candidates(minority_arr, active_color, subset) == [(top, left)]
+        ]
+        if valid:
+            return random.choice(valid)
+    return None
+
+
+def _gen_attempt() -> np.ndarray | None:
+    """Single generation attempt: build output, choose input subset, verify with solver."""
+    separator, maj_exclusive, shared, min_exclusive = random.sample(range(COLOR_POOL), 4)
+    majority = _random_two_color_pattern(shared, maj_exclusive)
+    base_mask = _random_minority_mask()
+    minority = np.where(base_mask, min_exclusive, shared).astype(int)
+
+    top, left = random.choice(PLACEMENT_CHOICES)
+    rotated_source, _src_mask, final_mask = _build_candidate_masks(minority, min_exclusive, top, left, CELL_GRID_N)
+    active_cells = [(top + r, left + c) for r, c in np.argwhere(final_mask)]
+    out = _build_grid(separator, majority, rotated_source, active_cells)
+
+    given_cells = _choose_given_subset(minority, min_exclusive, top, left)
+    if given_cells is None:
+        return None
+    inp = _build_grid(separator, majority, minority, given_cells)
+
+    try:
+        solved = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(solved, out):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid b99e7126 combo input")

