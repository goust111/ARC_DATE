+def _choose_given_subset(minority_arr: np.ndarray, active_color: int, top: int, left: int) -> list[tuple[int, int]] | None:
+    """Choose a shown subset of active cells that pins down one anchor uniquely."""
+    _src_arr, _src_mask, final_mask = _build_candidate_masks(minority_arr, active_color, top, left, CELL_GRID_N)
+    active_abs = [(top + r, left + c) for r, c in np.argwhere(final_mask)]
+    sizes = list(GIVEN_CELL_SIZES)
+    random.shuffle(sizes)
