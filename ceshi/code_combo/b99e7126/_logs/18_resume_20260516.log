+
+def _placement_candidates(
+    coarse_mask: np.ndarray,
+    given_cells: list[tuple[int, int]],
+    n_rows: int,
+    n_cols: int,
+) -> list[tuple[int, int]]:
+    """Return all placements that can explain the visible minority cells."""
+    existing = np.zeros((n_rows, n_cols), dtype=bool)
+    for r, c in given_cells:
+        existing[r, c] = True
+
+    sh, sw = coarse_mask.shape
+    candidates: list[tuple[int, int]] = []
+    for top in range(n_rows - sh + 1):
+        for left in range(n_cols - sw + 1):
+            block = np.zeros_like(existing)
+            block[top : top + sh, left : left + sw] = True
+            if np.any(existing & ~block):
+                continue
+            ex_block = existing[top : top + sh, left : left + sw]
+            if np.any(ex_block & ~coarse_mask):
+                continue
+            candidates.append((int(top), int(left)))
+    return candidates
+
+
+def _choose_given_cells(
+    coarse_mask: np.ndarray,
+    top: int,
+    left: int,
+    n_rows: int,
+    n_cols: int,
+    given_sizes: tuple[int, ...],
+) -> list[tuple[int, int]] | None:
+    """Randomly sample a strict active subset that fixes the scaled placement uniquely."""
+    active_abs = [(top + int(r), left + int(c)) for r, c in np.argwhere(coarse_mask)]
+    sizes = list(given_sizes)
+    random.shuffle(sizes)
+    for size in sizes:
+        if size >= len(active_abs):
+            continue
+        for _ in range(SUBSET_TRIES):
+            subset = random.sample(active_abs, size)
+            if _placement_candidates(coarse_mask, subset, n_rows, n_cols) == [(top, left)]:
+                return subset
+    return None
+
+
+def _gen_attempt() -> np.ndarray | None:
+    """Single generation attempt for the fused variable-size + variable-scale variant."""
+    cfg = random.choice(SIZE_CONFIGS)
