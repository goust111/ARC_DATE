+
+    coarse_mask = _scaled_mask(mask, scale)
+    sh, sw = coarse_mask.shape
+    top = random.randrange(n_rows - sh + 1)
+    left = random.randrange(n_cols - sw + 1)
+
+    active_cells = [(top + int(r), left + int(c)) for r, c in np.argwhere(coarse_mask)]
+    out = _build_grid(separator, majority, minority, active_cells, n_rows, n_cols)
+
+    given_cells = _choose_given_cells(coarse_mask, top, left, n_rows, n_cols, given_sizes)
+    if given_cells is None:
+        return None
+    inp = _build_grid(separator, majority, minority, given_cells, n_rows, n_cols)
+
+    try:
+        solved = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(solved, out):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
