+
+
+def _choose_evidence_partition(mask: np.ndarray, top: int, left: int):
+    """
+    Choose which active positions are visible in the input.
+
+    Returns:
+      (minority_subset, recolored_subset, mixed_subset) in mask-local coordinates, or None.
+    """
+    active = [tuple(coord) for coord in np.argwhere(mask)]
+    clue_count, recolor_count, mix_count = EVIDENCE_COUNTS
+    total = clue_count + recolor_count + mix_count
+    assert total < len(active), "input must hide at least one active position"
+
+    valid_total_subsets = [
+        subset
+        for subset in combinations(active, total)
+        if _placement_candidates(mask, subset, top, left) == [(top, left)]
+    ]
+    random.shuffle(valid_total_subsets)
+    for subset in valid_total_subsets:
+        local = list(subset)
+        minority_choices = list(combinations(local, clue_count))
+        random.shuffle(minority_choices)
+        for minority_subset in minority_choices:
+            rem1 = [pos for pos in local if pos not in minority_subset]
+            recolor_choices = list(combinations(rem1, recolor_count))
+            random.shuffle(recolor_choices)
+            for recolored_subset in recolor_choices:
+                mixed_subset = tuple(pos for pos in rem1 if pos not in recolored_subset)
+                return tuple(sorted(minority_subset)), tuple(sorted(recolored_subset)), tuple(sorted(mixed_subset))
+    return None
+
+
+def _gen_attempt():
+    """
+    Single generation attempt.
+
+    Output-first construction:
+    - Output contains the full active block as mixed cells.
+    - Input reveals a strict subset of active positions split across the raw
+      blueprint, recolored preview, and mixed preview roles.
+    """
+    separator, shared, maj_exclusive, min_exclusive, recolor_color, mix_color = random.sample(range(COLOR_POOL), 6)
+    majority = _random_lr_pattern(shared, maj_exclusive)
+    mask = _random_minority_mask()
+    minority = np.where(mask, min_exclusive, shared).astype(int)
+    recolored = np.where(mask, recolor_color, shared).astype(int)
+    mixed = majority.copy()
+    mixed[mask] = mix_color
+
+    if len({tuple(arr.ravel()) for arr in (majority, minority, recolored, mixed)}) != 4:
+        return None
+    if not np.array_equal(mixed[~mask], majority[~mask]):
+        return None
+    if np.any(majority[mask] == mix_color):
+        return None
+    if np.any(recolored[mask] == mix_color):
+        return None
+    if np.any(minority[mask] == recolor_color):
+        return None
+
+    top = random.randrange(PLACEMENT_RANGE)
+    left = random.randrange(PLACEMENT_RANGE)
+    active_cells = [(top + r, left + c) for r, c in np.argwhere(mask)]
+    out = _build_grid(separator, majority, [], [], active_cells, minority, recolored, mixed)
+
+    partition = _choose_evidence_partition(mask, top, left)
+    if partition is None:
+        return None
+    minority_subset, recolored_subset, mixed_subset = partition
+    minority_cells = [(top + r, left + c) for r, c in minority_subset]
+    recolored_cells = [(top + r, left + c) for r, c in recolored_subset]
+    mixed_cells = [(top + r, left + c) for r, c in mixed_subset]
+    inp = _build_grid(separator, majority, minority_cells, recolored_cells, mixed_cells, minority, recolored, mixed)
+
+    try:
+        solved = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(solved, out):
+        return None
+    return inp
+
+
+def generate_input():
+    for _ in range(MAX_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid b99e7126 combo input")

diff --git a/ceshi/code_combo/b99e7126/10/code.py b/ceshi/code_combo/b99e7126/10/code.py
new file mode 100644
index 0000000000000000000000000000000000000000..19373d3141706e080f95e96fa0b49de75b7ec487
--- /dev/null
+++ b/ceshi/code_combo/b99e7126/10/code.py
@@ -0,0 +1,450 @@
+# Combo variant of b99e7126 (index 10)
+# combo_spec: D5/1+D11/0
+# Name: 颜色混合叠加 + 颜色重映射
+
+from functools import reduce
+from itertools import combinations
+from math import gcd
+
+import numpy as np
+import random
+
+from arc_utils import paste
+
+# ---------------------------------------------------------------------------
+# Design analysis for the combo variant
+#
+# concretization_and_trace:
+# - Keep the original 29x29 board: a 7x7 lattice of 3x3 cell interiors, split by
+#   1-pixel divider lines.
+# - Most cells still show one repeated majority template `M`.
+# - The odd-cell blueprint still exists as a raw minority template `B` whose
+#   dominant color marks a 3x3 boolean mask.
+# - To realize the fusion, the input now also shows:
+#   - a recolored preview template `R`: same 3x3 geometry as `B`, but the active
+#     color is remapped to a different color;
+#   - a mixed result template `X`: start from `M`, then replace the mask-active
+#     pixels by a third mix color.
+# - Example trace at one active cell position:
+#   - Original task: active lattice cell became the raw minority template `B`.
+#   - D11 step here: `B` is first recolored into `R`, so the active foreground is
+#     no longer the minority-exclusive color.
+#   - D5 step here: `R` is then overlaid onto the majority template `M`, yielding
+#     `X`, where mask-active pixels become the mix color while mask-inactive
+#     pixels keep the original majority pixels.
+#   - Final output uses `X`, not `B` and not `R`.
+#
+# complexity_calibration:
+# - Use exactly 6 colors per instance:
+#   separator, shared, majority-exclusive, minority-exclusive, recolor color,
+#   and mix color.
+# - Fix the mask to 7 active pixels. This is a deliberate narrowing from the
+#   original 6-7 range so the generator can show all three non-majority roles
+#   with distinct counts 1/2/3 while still hiding one active cell that must be
+#   completed.
+# - Keep a single 3x3 target block and a single remap case:
+#   minority-active -> recolor-active -> mix-active.
+#   This makes the fusion visible without introducing an unconstrained table.
+#
+# implicit_assumption_audit:
+# - Divider inference is unchanged: full rows/cols of one color still define the
+#   cell grid.
+# - The original solver assumed only two interior patterns; that breaks here.
+#   The combo solver expects exactly four: majority, minority clue, recolor
+#   preview, and mixed preview.
+# - The original solver treated only raw minority cells as active evidence.
+#   That also breaks: recolored and mixed previews are active evidence too.
+# - The original writeback pasted the minority cell itself. That would erase both
+#   combo components, so writeback must paste the derived mixed template.
+# - Ranking by frequency is now meaningful only because the generator enforces
+#   strict counts: minority < recolor < mixed < majority.
+#
+# placement_legality:
+# - All pasted objects are full 3x3 cell interiors anchored at valid cell
+#   origins, so there is no overlap ambiguity or out-of-bounds risk.
+# - The 3x3 mask is still placed wholly inside the 7x7 lattice with offsets 0..4.
+# - The generator only accepts subsets whose union gives a unique placement.
+#
+# visual_observability_and_cleanliness:
+# - A human sees four clean cell types in the input:
+#   repeated majority background, one raw blueprint clue, two recolor previews,
+#   and three already-mixed results.
+# - The three non-majority templates all share the same geometry, so the eye can
+#   line them up and read the chain B -> R -> X.
+# - Mixed cells preserve the majority's inactive pixels, so the board remains
+#   coherent instead of becoming noisy.
+#
+# inferability_of_change:
+# - D11 is visible because `B` and `R` have identical shape but different active
+#   colors.
+# - D5 is visible because `R` and `X` keep the same active footprint, yet `X`
+#   switches from the recolor foreground to a third mix color and restores the
+#   majority background outside the footprint.
+# - The generator rejects any case where these three templates collapse or become
+#   pairwise equal, preventing degenerate samples that visually mimic the base
+#   task.
+# ---------------------------------------------------------------------------
+
+
+def _infer_cell_grid_params(g: np.ndarray) -> tuple[int, list[int], list[int]]:
+    """
+    Infer a regular cell grid separated by full rows/cols of the same line color.
+    Returns (step, row_divs, col_divs) where:
+      - row_divs/col_divs are divider indices
+      - step is the spacing between dividers (cell size including divider).
+    """
+    h, w = g.shape
+    line = int(g[0, 0])
+    row_divs = [r for r in range(h) if np.all(g[r, :] == line)]
+    col_divs = [c for c in range(w) if np.all(g[:, c] == line)]
+    assert len(row_divs) >= 2 and len(col_divs) >= 2, "need at least 2 row and 2 col dividers"
+    row_divs.sort()
+    col_divs.sort()
+    drs = [row_divs[i + 1] - row_divs[i] for i in range(len(row_divs) - 1) if row_divs[i + 1] > row_divs[i]]
+    dcs = [col_divs[i + 1] - col_divs[i] for i in range(len(col_divs) - 1) if col_divs[i + 1] > col_divs[i]]
+    step = reduce(gcd, drs + dcs)
+    assert step > 1, "divider step must be > 1"
+    assert row_divs[0] == 0 and col_divs[0] == 0, "first divider must be at index 0"
+    assert (h - 1) % step == 0 and (w - 1) % step == 0, "grid dimensions must be (k*step + 1)"
+    assert row_divs[-1] == h - 1 and col_divs[-1] == w - 1, "last divider must be at boundary"
+    return int(step), row_divs, col_divs
+
+
+def _extract_patterns(g: np.ndarray, step: int) -> tuple[dict[tuple[int, ...], np.ndarray], list[list[tuple[int, ...]]]]:
+    """Collect each cell-interior pattern and the cell-grid pattern ids."""
+    n = (g.shape[0] - 1) // step
+    inner = step - 1
+    patterns: dict[tuple[int, ...], np.ndarray] = {}
+    cell_pat: list[list[tuple[int, ...]]] = []
+    for i in range(n):
+        row: list[tuple[int, ...]] = []
+        for j in range(n):
+            r0 = i * step + 1
+            c0 = j * step + 1
+            pat_arr = g[r0 : r0 + inner, c0 : c0 + inner].copy()
+            pat = tuple(pat_arr.ravel().tolist())
+            if pat not in patterns:
+                patterns[pat] = pat_arr
+            row.append(pat)
+        cell_pat.append(row)
+    return patterns, cell_pat
+
+
+def _pattern_counts(cell_pat: list[list[tuple[int, ...]]]) -> dict[tuple[int, ...], int]:
+    counts: dict[tuple[int, ...], int] = {}
+    for row in cell_pat:
+        for pat in row:
+            counts[pat] = counts.get(pat, 0) + 1
+    return counts
+
+
+def _dominant_mask(arr: np.ndarray) -> tuple[np.ndarray, int, int]:
+    vals, cnts = np.unique(arr, return_counts=True)
+    idx = int(cnts.argmax())
+    active_color = int(vals[idx])
+    active_count = int(cnts[idx])
+    return arr == active_color, active_color, active_count
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Complete the fractal cell layout by recoloring the odd-cell blueprint and then mixing it onto the majority template.
+
+    Input structure:
+    - The board is a regular 7x7 cell lattice separated by one-color divider lines.
+    - Most cells share one repeated majority interior pattern.
+    - The remaining visible odd cells come in three rarer forms: one raw minority blueprint, two recolored previews, and three mixed-result previews.
+
+    Rule:
+    - Read the minority blueprint's dominant color as a 3x3 activity mask.
+    - Use all non-majority cells as evidence to place that 3x3 mask uniquely on the 7x7 lattice.
+    - Interpret the recolored preview as the minority template after color remapping, then interpret the mixed preview as the result of overlaying that remapped template onto the majority template.
+    - Fill every active lattice position in the placed block with the mixed template; leave inactive positions as the majority template.
+
+    Key insight:
+    - The odd cell is still a miniature placement blueprint, but the finished large-scale motif is a two-step derivative of it: first recolor the blueprint, then apply the already-demonstrated color-mixing overlay, so the output stamp is neither the raw clue nor the recolored intermediate.
+    """
+    g = np.asarray(grid, dtype=int)
+    step, _, _ = _infer_cell_grid_params(g)
+    n = (g.shape[0] - 1) // step
+    inner = step - 1
+
+    patterns, cell_pat = _extract_patterns(g, step)
+    counts = _pattern_counts(cell_pat)
+    assert len(counts) == 4, "combo variant expects exactly four cell patterns"
+
+    ranked = sorted(counts.items(), key=lambda kv: kv[1])
+    minority_pat = ranked[0][0]
+    recolored_pat = ranked[1][0]
+    mixed_pat = ranked[2][0]
+    majority_pat = ranked[3][0]
+    assert counts[minority_pat] < counts[recolored_pat] < counts[mixed_pat] < counts[majority_pat], "pattern frequencies must be strictly ordered"
+
+    minority_arr = patterns[minority_pat]
+    recolored_arr = patterns[recolored_pat]
+    mixed_arr = patterns[mixed_pat]
+    majority_arr = patterns[majority_pat]
+
+    mask, minority_active, active_count = _dominant_mask(minority_arr)
+    mh, mw = mask.shape
+    assert mh == inner and mw == inner, "minority mask must match the cell interior"
+    assert active_count == 7, "generator guarantees a 7-pixel active footprint"
+
+    minority_colors = set(map(int, np.unique(minority_arr)))
+    recolored_colors = set(map(int, np.unique(recolored_arr)))
+    majority_colors = set(map(int, np.unique(majority_arr)))
+    assert len(minority_colors) == 2 and len(recolored_colors) == 2 and len(majority_colors) == 2, "blueprint, recolor preview, and majority must each use two colors"
+
+    shared_colors = minority_colors & recolored_colors & majority_colors
+    assert len(shared_colors) == 1, "all three templates must share exactly one background color"
+    shared_color = next(iter(shared_colors))
+
+    minority_only = minority_colors - {shared_color}
+    recolored_only = recolored_colors - {shared_color}
+    majority_only = majority_colors - {shared_color}
+    assert len(minority_only) == 1 and len(recolored_only) == 1 and len(majority_only) == 1, "each template must have one exclusive foreground color"
+    assert minority_active == next(iter(minority_only)), "minority dominant color must be its exclusive foreground"
+
+    recolored_active = next(iter(recolored_only))
+    assert np.all(minority_arr[~mask] == shared_color), "minority inactive pixels must be the shared color"
+    assert np.all(recolored_arr[~mask] == shared_color), "recolored inactive pixels must keep the shared color"
+    assert np.all(recolored_arr[mask] == recolored_active), "recolored active pixels must be uniform"
+    assert recolored_active != minority_active, "recolor step must change the active color"
+
+    assert np.array_equal(mixed_arr[~mask], majority_arr[~mask]), "mixed preview must preserve majority pixels outside the mask"
+    mix_colors = set(map(int, np.unique(mixed_arr[mask])))
+    assert len(mix_colors) == 1, "mixed preview must use one uniform mix color on active pixels"
+    mix_color = next(iter(mix_colors))
+    assert mix_color not in minority_colors | recolored_colors | majority_colors, "mix color must be a third-stage color"
+    expected_mixed = majority_arr.copy()
+    expected_mixed[mask] = mix_color
+    assert np.array_equal(mixed_arr, expected_mixed), "mixed preview must equal majority plus mix color on the active mask"
+
+    existing = np.zeros((n, n), dtype=bool)
+    for i in range(n):
+        for j in range(n):
+            existing[i, j] = cell_pat[i][j] in (minority_pat, recolored_pat, mixed_pat)
+
+    candidates: list[tuple[int, int]] = []
+    for top in range(0, n - mh + 1):
+        for left in range(0, n - mw + 1):
+            block = np.zeros_like(existing)
+            block[top : top + mh, left : left + mw] = True
+            if np.any(existing & ~block):
+                continue
+            ex_block = existing[top : top + mh, left : left + mw]
+            if np.any(ex_block & ~mask):
+                continue
+            candidates.append((int(top), int(left)))
+    assert len(candidates) == 1, "must have a unique mask placement aligning all active evidence"
+    top, left = candidates[0]
+
+    out = g.copy()
+    for i in range(mh):
+        for j in range(mw):
+            target = mixed_arr if mask[i, j] else majority_arr
+            r0 = (top + i) * step + 1
+            c0 = (left + j) * step + 1
+            out[r0 : r0 + inner, c0 : c0 + inner] = target
+    return out
+
+
+# --------------- generator (o5x) ---------------
+
+CELL_GRID_N = 7
+CELL_INNER = 3
+CELL_STEP = 4
+GRID_SIZE = 29
+MASK_SIZE = 3
+PLACEMENT_RANGE = CELL_GRID_N - MASK_SIZE + 1
+ACTIVE_PIXEL_COUNTS = (7,)
+EVIDENCE_COUNTS = (1, 2, 3)  # minority clues, recolor previews, mixed previews
+COLOR_POOL = 10
+MAX_RETRIES = 500
+
+_LR_GROUPS = [
+    ((0, 0), (0, 2)),
+    ((1, 0), (1, 2)),
+    ((2, 0), (2, 2)),
+    ((0, 1),),
+    ((1, 1),),
+    ((2, 1),),
+]
+
+
+def _precompute_masks() -> dict[int, list[np.ndarray]]:
+    """Enumerate all valid LR-symmetric 3x3 masks, keyed by active count."""
+    weights = [len(group) for group in _LR_GROUPS]
+    by_count: dict[int, list[np.ndarray]] = {}
+    for active_count in ACTIVE_PIXEL_COUNTS:
+        inactive_count = MASK_SIZE * MASK_SIZE - active_count
+        masks: list[np.ndarray] = []
+        for k in range(1, len(_LR_GROUPS) + 1):
+            for combo in combinations(range(len(_LR_GROUPS)), k):
+                if sum(weights[i] for i in combo) != inactive_count:
+                    continue
+                mask = np.ones((MASK_SIZE, MASK_SIZE), dtype=bool)
+                for i in combo:
+                    for r, c in _LR_GROUPS[i]:
+                        mask[r, c] = False
+                if mask[0, :].any() and mask[2, :].any() and mask[:, 0].any() and mask[:, 2].any():
+                    masks.append(mask)
+        by_count[active_count] = masks
+    return by_count
+
+
+_MASKS_BY_COUNT = _precompute_masks()
+
+
+def _random_lr_pattern(color_a: int, color_b: int) -> np.ndarray:
+    """Generate a random LR-symmetric 3x3 pattern using two colors."""
+    arr = np.empty((MASK_SIZE, MASK_SIZE), dtype=int)
+    choices = [random.choice((color_a, color_b)) for _ in _LR_GROUPS]
+    if all(v == choices[0] for v in choices):
+        choices[random.randrange(len(choices))] = color_b if choices[0] == color_a else color_a
+    for group, color in zip(_LR_GROUPS, choices):
+        for r, c in group:
+            arr[r, c] = color
+    return arr
+
+
+def _random_minority_mask() -> np.ndarray:
+    return random.choice(_MASKS_BY_COUNT[ACTIVE_PIXEL_COUNTS[0]])
+
+
+def _cell_origin(i: int, j: int) -> tuple[int, int]:
+    return i * CELL_STEP + 1, j * CELL_STEP + 1
+
+
+def _build_grid(
+    separator: int,
+    majority: np.ndarray,
+    minority_cells: list[tuple[int, int]],
+    recolored_cells: list[tuple[int, int]],
+    mixed_cells: list[tuple[int, int]],
+    minority: np.ndarray,
+    recolored: np.ndarray,
+    mixed: np.ndarray,
+) -> np.ndarray:
+    """Construct the full board from the majority background plus three preview roles."""
+    grid = np.full((GRID_SIZE, GRID_SIZE), separator, dtype=int)
+    for i in range(CELL_GRID_N):
+        for j in range(CELL_GRID_N):
+            paste(grid, majority, *_cell_origin(i, j))
+    for i, j in minority_cells:
+        paste(grid, minority, *_cell_origin(i, j))
+    for i, j in recolored_cells:
+        paste(grid, recolored, *_cell_origin(i, j))
+    for i, j in mixed_cells:
+        paste(grid, mixed, *_cell_origin(i, j))
+    return grid
+
+
+def _placement_candidates(mask: np.ndarray, evidence_subset: tuple[tuple[int, int], ...], top: int, left: int) -> list[tuple[int, int]]:
+    """Find all offsets where the observed active-evidence subset fits the mask."""
+    existing = np.zeros((CELL_GRID_N, CELL_GRID_N), dtype=bool)
+    for r, c in evidence_subset:
+        existing[top + r, left + c] = True
+
+    candidates: list[tuple[int, int]] = []
+    for t in range(PLACEMENT_RANGE):
+        for l in range(PLACEMENT_RANGE):
+            block = np.zeros((CELL_GRID_N, CELL_GRID_N), dtype=bool)
+            block[t : t + MASK_SIZE, l : l + MASK_SIZE] = True
+            if np.any(existing & ~block):
+                continue
+            if np.any(existing[t : t + MASK_SIZE, l : l + MASK_SIZE] & ~mask):
+                continue
+            candidates.append((t, l))
+    return candidates
+
+
+def _choose_evidence_partition(mask: np.ndarray, top: int, left: int):
+    """
+    Choose which active positions are visible in the input.
+
+    Returns:
+      (minority_subset, recolored_subset, mixed_subset) in mask-local coordinates, or None.
+    """
+    active = [tuple(coord) for coord in np.argwhere(mask)]
+    clue_count, recolor_count, mix_count = EVIDENCE_COUNTS
+    total = clue_count + recolor_count + mix_count
+    assert total < len(active), "input must hide at least one active position"
+
+    valid_total_subsets = [
+        subset
+        for subset in combinations(active, total)
+        if _placement_candidates(mask, subset, top, left) == [(top, left)]
+    ]
+    random.shuffle(valid_total_subsets)
+    for subset in valid_total_subsets:
+        local = list(subset)
+        minority_choices = list(combinations(local, clue_count))
+        random.shuffle(minority_choices)
+        for minority_subset in minority_choices:
+            rem1 = [pos for pos in local if pos not in minority_subset]
+            recolor_choices = list(combinations(rem1, recolor_count))
+            random.shuffle(recolor_choices)
+            for recolored_subset in recolor_choices:
+                mixed_subset = tuple(pos for pos in rem1 if pos not in recolored_subset)
+                return tuple(sorted(minority_subset)), tuple(sorted(recolored_subset)), tuple(sorted(mixed_subset))
+    return None
+
+
+def _gen_attempt():
+    """
+    Single generation attempt.
+
+    Output-first construction:
+    - Output contains the full active block as mixed cells.
+    - Input reveals a strict subset of active positions split across the raw
+      blueprint, recolored preview, and mixed preview roles.
+    """
+    separator, shared, maj_exclusive, min_exclusive, recolor_color, mix_color = random.sample(range(COLOR_POOL), 6)
+    majority = _random_lr_pattern(shared, maj_exclusive)
+    mask = _random_minority_mask()
+    minority = np.where(mask, min_exclusive, shared).astype(int)
+    recolored = np.where(mask, recolor_color, shared).astype(int)
+    mixed = majority.copy()
+    mixed[mask] = mix_color
+
+    if len({tuple(arr.ravel()) for arr in (majority, minority, recolored, mixed)}) != 4:
+        return None
+    if not np.array_equal(mixed[~mask], majority[~mask]):
+        return None
+    if np.any(majority[mask] == mix_color):
+        return None
+    if np.any(recolored[mask] == mix_color):
+        return None
+    if np.any(minority[mask] == recolor_color):
+        return None
+
+    top = random.randrange(PLACEMENT_RANGE)
+    left = random.randrange(PLACEMENT_RANGE)
+    active_cells = [(top + r, left + c) for r, c in np.argwhere(mask)]
+    out = _build_grid(separator, majority, [], [], active_cells, minority, recolored, mixed)
+
+    partition = _choose_evidence_partition(mask, top, left)
+    if partition is None:
+        return None
+    minority_subset, recolored_subset, mixed_subset = partition
