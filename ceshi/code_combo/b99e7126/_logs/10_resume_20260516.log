+    mix_color = next(iter(mix_colors))
+    assert mix_color not in minority_colors | recolored_colors | majority_colors, "mix color must be a third-stage color"
+    expected_mixed = majority_arr.copy()
+    expected_mixed[mask] = mix_color
+    assert np.array_equal(mixed_arr, expected_mixed), "mixed preview must equal majority plus mix color on the active mask"
