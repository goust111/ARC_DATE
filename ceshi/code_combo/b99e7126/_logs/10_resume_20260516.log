+    mixed_cells = [(top + r, left + c) for r, c in mixed_subset]
+    inp = _build_grid(separator, majority, minority_cells, recolored_cells, mixed_cells, minority, recolored, mixed)
+
+    try:
+        solved = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(solved, out):
+        return None
+    return inp
+
+
+def generate_input():
+    for _ in range(MAX_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
