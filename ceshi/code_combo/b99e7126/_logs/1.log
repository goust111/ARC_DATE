+    return i * CELL_STEP + 1, j * CELL_STEP + 1
+
+
+def _build_grid(
+    separator: int,
+    even_pat: np.ndarray,
+    odd_pat: np.ndarray,
+    overrides: dict[tuple[int, int], np.ndarray],
+) -> np.ndarray:
+    grid = np.full((GRID_SIZE, GRID_SIZE), separator, dtype=int)
+    for i in range(CELL_GRID_N):
+        for j in range(CELL_GRID_N):
+            base_pat = even_pat if (i + j) % 2 == 0 else odd_pat
+            paste(grid, base_pat, *_cell_origin(i, j))
+    for (i, j), pat in overrides.items():
+        paste(grid, pat, *_cell_origin(i, j))
+    return grid
+
+
+def _positions_outside_block(top: int, left: int) -> list[tuple[int, int]]:
+    return [
+        (i, j)
+        for i in range(CELL_GRID_N)
+        for j in range(CELL_GRID_N)
+        if not (top <= i < top + MASK_SIZE and left <= j < left + MASK_SIZE)
+    ]
+
+
+def _analyze_grid(grid: np.ndarray) -> tuple[dict[tuple[int, ...], int], tuple[int, ...], tuple[int, ...], tuple[int, ...]]:
+    step, _, _ = _infer_cell_grid_params(grid)
