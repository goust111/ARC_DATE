+    even_pat, odd_pat = _infer_checkerboard_basis(counts, cell_pat, source_pat)
+    return counts, source_pat, even_pat, odd_pat
+
+
+def _generate_case() -> dict[str, object] | None:
+    separator, shared, base_exclusive, source_exclusive, distractor_exclusive = random.sample(range(COLOR_POOL), 5)
+
+    even_pat, odd_pat = _random_checkerboard_pair(shared, base_exclusive)
