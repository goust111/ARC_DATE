   151	def main(grid: np.ndarray) -> np.ndarray:
   152	    """
   153	    Complete a fractal source motif over a checkerboard base after ranking motif frequencies.
   154	
   155	    Input structure:
   156	    - The board is partitioned into equal 3x3 cell interiors separated by one-color divider lines.
   157	    - Two motifs form the checkerboard base on even/odd cell parities, a rarer source motif appears a few
   158	      times inside one hidden 3x3 macro-block, and at least one additional repeated distractor motif sits
   159	      elsewhere on the board.
   160	
   161	    Rule:
   162	    - Count exact cell motifs and choose the uniquely least frequent motif type as the source blueprint.
   163	    - Infer which two non-source motifs define the checkerboard by finding the parity assignment with the
   164	      fewest mismatches, then read the source motif's dominant color as a 3x3 active/inactive mask.
   165	    - Place that mask so the shown source cells land on active positions, fill the remaining active slots
   166	      with the source motif, and refill inactive slots with the checkerboard tile dictated by absolute parity.
   167	
   168	    Key insight: The task is a fusion of counting and structure: the correct blueprint is the least frequent
   169	    repeated motif family, but its expansion only makes sense after recovering the alternating A/B lattice it
   170	    is supposed to overwrite.
   171	    """
   172	    g = np.asarray(grid, dtype=int)
   173	    step, _, _ = _infer_cell_grid_params(g)
   174	    n, inner, patterns, cell_pat = _extract_cell_patterns(g, step)
   175	
   176	    counts = _count_patterns(cell_pat)
   177	    assert len(counts) >= 4, "need checkerboard bases, a source, and at least one distractor family"
   178	
   179	    ordered = sorted(counts.items(), key=lambda kv: kv[1])
   180	    assert ordered[0][1] >= 2, "source motif must be repeated"
   181	    assert ordered[0][1] < ordered[1][1], "source frequency must be uniquely minimal"
   182	    source_pat = ordered[0][0]
   183	
   184	    even_pat, odd_pat = _infer_checkerboard_basis(counts, cell_pat, source_pat)
   185	    source_arr = patterns[source_pat]
   186	
   187	    vals, cnts = np.unique(source_arr, return_counts=True)
   188	    order = np.argsort(cnts)[::-1]
   189	    assert len(order) >= 2 and cnts[order[0]] > cnts[order[1]], "source motif needs a unique active color"
   190	    active_color = int(vals[order[0]])
   191	    mask = source_arr == active_color
   192	    mh, mw = mask.shape
   193	
   194	    existing = np.zeros((n, n), dtype=bool)
   195	    for i in range(n):
   196	        for j in range(n):
   197	            existing[i, j] = cell_pat[i][j] == source_pat
   198	
   199	    candidates: list[tuple[int, int]] = []
   200	    for top in range(0, n - mh + 1):
   201	        for left in range(0, n - mw + 1):
   202	            block = np.zeros_like(existing)
   203	            block[top : top + mh, left : left + mw] = True
   204	            if np.any(existing & ~block):
   205	                continue
   206	            ex_block = existing[top : top + mh, left : left + mw]
   207	            if np.any(ex_block & ~mask):
   208	                continue
   209	            candidates.append((int(top), int(left)))
   210	    assert len(candidates) == 1, "source mask placement must be uniquely determined"
   211	    top, left = candidates[0]
   212	
   213	    out = g.copy()
   214	    for i in range(mh):
   215	        for j in range(mw):
   216	            abs_i = top + i
   217	            abs_j = left + j
   218	            if mask[i, j]:
   219	                target_pat = source_arr
   220	            else:
   221	                key = even_pat if (abs_i + abs_j) % 2 == 0 else odd_pat
   222	                target_pat = patterns[key]
   223	            r0 = abs_i * step + 1
   224	            c0 = abs_j * step + 1
   225	            out[r0 : r0 + inner, c0 : c0 + inner] = target_pat
   226	    return out
   227	
   228	
   229	# --------------- generator ---------------
   230	
   231	CELL_GRID_N = 7
   232	CELL_INNER = 3
