diff --git a/ceshi/code_combo/b99e7126/1/code.py b/ceshi/code_combo/b99e7126/1/code.py
new file mode 100644
index 0000000000000000000000000000000000000000..c437d6336a0d264cc7777c62aa4692afde7fd3e8
--- /dev/null
+++ b/ceshi/code_combo/b99e7126/1/code.py
@@ -0,0 +1,490 @@
+# Combo variant of b99e7126 (index 1)
+# combo_spec: D1/0+D6/0
+# Name: 频率排序 + 棋盘式双图案铺贴
+
+from functools import reduce
+from itertools import combinations, permutations
+from math import gcd
+
+import numpy as np
+import random
+
+from arc_utils import paste
+
+
+# Design analysis for the combo variant
+# -------------------------------------
+# a) Concrete behavior:
+#    The 29x29 board still contains a 7x7 lattice of 3x3 cell interiors with 1-pixel dividers.
+#    The base tiling is checkerboard: parity-even cells use motif A, parity-odd cells use motif B.
+#    A source motif S appears only 3-4 times in the input and is the one that must be fractally
+#    completed. To make D1 active rather than cosmetic, the input also contains a repeated distractor
+#    family D outside the completion block. A typical count profile is A=22, B=18, D=6, S=3. The
+#    old task could treat "the rare pattern" as a simple exception against one uniform background.
+#    The fused task requires two linked inferences: first rank motif frequencies to pick S, then use
+#    S's dense color as a 3x3 macro-mask whose inactive slots must revert to A or B by parity.
+# b) Complexity calibration:
+#    Only one distractor family is added. That is enough to raise the distinct motif count from the
+#    natural checkerboard triple {A,B,S} to four repeated families {A,B,D,S}, so counting matters,
+#    but the visual scene stays readable because every cell still contains exactly one motif. The
+#    source remains uniquely least frequent, the distractor remains clearly more frequent than the
+#    source, and A/B still dominate the board so the checkerboard is obvious to a human.
+# c) Hidden assumptions from the old solver:
+#    - "majority_pat = max(counts)" fails because inactive cells are not globally uniform.
+#    - "len(counts) == 3" from the D6-only variant also fails because D is present.
+#    - "all non-source cells participate in the checkerboard" fails because D intentionally breaks
+#      the parity lattice outside the completion block. The new solver therefore scores every ordered
+#      pair of non-source motifs as a potential checkerboard basis and chooses the unique pair with
+#      the fewest mismatches; those mismatches correspond exactly to distractor cells.
+#    - Placement search may still rely only on already-shown source cells because distractors never
+#      appear inside the 3x3 completion block, so they do not alter the source subset geometry.
+# d) Placement legality:
+#    The 3x3 source mask is placed at offsets 0..4 inside the 7x7 cell lattice. Source samples are a
+#    strict subset of active mask positions. Distractor cells are sampled only from coordinates
+#    outside the 3x3 block, so they cannot overwrite future completion slots or clash with source
+#    cells. All motifs occupy fixed 3x3 interiors, so overlap is impossible once cell coordinates are
+#    distinct.
+# e) Visual observability:
+#    A and B share a palette and differ by arrangement, making the checkerboard legible. S introduces
+#    its own exclusive color and appears a few times, so its self-similar role is visible. D uses one
+#    extra exclusive color and repeats more often than S, giving the solver a genuine frequency-sorting
+#    step that a human can infer from examples by counting motif families rather than by reading color
+#    ids. The source mask is constrained so inactive pixels hit both checkerboard parities, which makes
+#    the D6-style parity-aware refill visible inside the transformed region itself.
+# f) Visual cleanliness:
+#    No overlays are drawn on top of each other. Each cell is exactly one of A, B, D, or S, and
+#    divider lines remain untouched. Distractors stay outside the completion block so the central
+#    transformed region still reads as "checkerboard plus source expansion" instead of a pile of
+#    unrelated motifs.
+# g) Change inferability:
+#    The color budget stays small: separator, shared, base-exclusive, source-exclusive, and one
+#    distractor-exclusive color. That keeps the mapping learnable. Structural cues do the real work:
+#    parity explains A/B placement, frequency singles out S against D, and S's own interior pattern
+#    explains the macro-scale completion.
+
+
+def _infer_cell_grid_params(g: np.ndarray) -> tuple[int, list[int], list[int]]:
+    """
+    Infer a regular cell grid separated by full rows/cols of the same line color.
+    Returns (step, row_divs, col_divs) where:
+      - row_divs/col_divs are divider indices
+      - step is the spacing between dividers (cell size including divider).
+    """
+    h, w = g.shape
+    line = int(g[0, 0])
+    row_divs = [r for r in range(h) if np.all(g[r, :] == line)]
+    col_divs = [c for c in range(w) if np.all(g[:, c] == line)]
+    assert len(row_divs) >= 2 and len(col_divs) >= 2, "need at least 2 row and 2 col dividers"
+    row_divs.sort()
+    col_divs.sort()
+    drs = [row_divs[i + 1] - row_divs[i] for i in range(len(row_divs) - 1) if row_divs[i + 1] > row_divs[i]]
+    dcs = [col_divs[i + 1] - col_divs[i] for i in range(len(col_divs) - 1) if col_divs[i + 1] > col_divs[i]]
+    step = reduce(gcd, drs + dcs)
+    assert step > 1, "divider step must be > 1"
+    assert row_divs[0] == 0 and col_divs[0] == 0, "first divider must be at index 0"
+    assert (h - 1) % step == 0 and (w - 1) % step == 0, "grid dimensions must be (k*step + 1)"
+    assert row_divs[-1] == h - 1 and col_divs[-1] == w - 1, "last divider must be at boundary"
+    return int(step), row_divs, col_divs
+
+
+def _extract_cell_patterns(
+    g: np.ndarray, step: int
+) -> tuple[int, int, dict[tuple[int, ...], np.ndarray], list[list[tuple[int, ...]]]]:
+    n = (g.shape[0] - 1) // step
+    inner = step - 1
+    patterns: dict[tuple[int, ...], np.ndarray] = {}
+    cell_pat: list[list[tuple[int, ...]]] = []
+    for i in range(n):
+        row: list[tuple[int, ...]] = []
+        for j in range(n):
+            r0 = i * step + 1
+            c0 = j * step + 1
+            pat_arr = g[r0 : r0 + inner, c0 : c0 + inner].copy()
+            pat = tuple(int(v) for v in pat_arr.ravel())
+            if pat not in patterns:
+                patterns[pat] = pat_arr
+            row.append(pat)
+        cell_pat.append(row)
+    return n, inner, patterns, cell_pat
+
+
+def _count_patterns(cell_pat: list[list[tuple[int, ...]]]) -> dict[tuple[int, ...], int]:
+    counts: dict[tuple[int, ...], int] = {}
+    for row in cell_pat:
+        for pat in row:
+            counts[pat] = counts.get(pat, 0) + 1
+    return counts
+
+
+def _checkerboard_score(
+    cell_pat: list[list[tuple[int, ...]]],
+    source_pat: tuple[int, ...],
+    even_pat: tuple[int, ...],
+    odd_pat: tuple[int, ...],
+) -> int:
+    mismatches = 0
+    for i, row in enumerate(cell_pat):
+        for j, pat in enumerate(row):
+            if pat == source_pat:
+                continue
+            expected = even_pat if (i + j) % 2 == 0 else odd_pat
+            mismatches += int(pat != expected)
+    return mismatches
+
+
+def _infer_checkerboard_basis(
+    counts: dict[tuple[int, ...], int],
+    cell_pat: list[list[tuple[int, ...]]],
+    source_pat: tuple[int, ...],
+) -> tuple[tuple[int, ...], tuple[int, ...]]:
+    candidates: list[tuple[int, tuple[int, ...], tuple[int, ...]]] = []
+    others = [pat for pat in counts if pat != source_pat]
+    for even_pat, odd_pat in permutations(others, 2):
+        score = _checkerboard_score(cell_pat, source_pat, even_pat, odd_pat)
+        candidates.append((score, even_pat, odd_pat))
+    candidates.sort(key=lambda item: item[0])
+    assert len(candidates) >= 2, "need at least two non-source motifs for checkerboard inference"
+    assert candidates[0][0] < candidates[1][0], "checkerboard basis must be uniquely identifiable"
+    return candidates[0][1], candidates[0][2]
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Complete a fractal source motif over a checkerboard base after ranking motif frequencies.
+
+    Input structure:
+    - The board is partitioned into equal 3x3 cell interiors separated by one-color divider lines.
+    - Two motifs form the checkerboard base on even/odd cell parities, a rarer source motif appears a few
+      times inside one hidden 3x3 macro-block, and at least one additional repeated distractor motif sits
+      elsewhere on the board.
+
+    Rule:
+    - Count exact cell motifs and choose the uniquely least frequent motif type as the source blueprint.
+    - Infer which two non-source motifs define the checkerboard by finding the parity assignment with the
+      fewest mismatches, then read the source motif's dominant color as a 3x3 active/inactive mask.
+    - Place that mask so the shown source cells land on active positions, fill the remaining active slots
+      with the source motif, and refill inactive slots with the checkerboard tile dictated by absolute parity.
+
+    Key insight: The task is a fusion of counting and structure: the correct blueprint is the least frequent
+    repeated motif family, but its expansion only makes sense after recovering the alternating A/B lattice it
+    is supposed to overwrite.
+    """
+    g = np.asarray(grid, dtype=int)
+    step, _, _ = _infer_cell_grid_params(g)
+    n, inner, patterns, cell_pat = _extract_cell_patterns(g, step)
+
+    counts = _count_patterns(cell_pat)
+    assert len(counts) >= 4, "need checkerboard bases, a source, and at least one distractor family"
+
+    ordered = sorted(counts.items(), key=lambda kv: kv[1])
+    assert ordered[0][1] >= 2, "source motif must be repeated"
+    assert ordered[0][1] < ordered[1][1], "source frequency must be uniquely minimal"
+    source_pat = ordered[0][0]
+
+    even_pat, odd_pat = _infer_checkerboard_basis(counts, cell_pat, source_pat)
+    source_arr = patterns[source_pat]
+
+    vals, cnts = np.unique(source_arr, return_counts=True)
+    order = np.argsort(cnts)[::-1]
+    assert len(order) >= 2 and cnts[order[0]] > cnts[order[1]], "source motif needs a unique active color"
+    active_color = int(vals[order[0]])
+    mask = source_arr == active_color
+    mh, mw = mask.shape
+
+    existing = np.zeros((n, n), dtype=bool)
+    for i in range(n):
+        for j in range(n):
+            existing[i, j] = cell_pat[i][j] == source_pat
+
+    candidates: list[tuple[int, int]] = []
+    for top in range(0, n - mh + 1):
+        for left in range(0, n - mw + 1):
+            block = np.zeros_like(existing)
+            block[top : top + mh, left : left + mw] = True
+            if np.any(existing & ~block):
+                continue
+            ex_block = existing[top : top + mh, left : left + mw]
+            if np.any(ex_block & ~mask):
+                continue
+            candidates.append((int(top), int(left)))
+    assert len(candidates) == 1, "source mask placement must be uniquely determined"
+    top, left = candidates[0]
+
+    out = g.copy()
+    for i in range(mh):
+        for j in range(mw):
+            abs_i = top + i
+            abs_j = left + j
+            if mask[i, j]:
+                target_pat = source_arr
+            else:
+                key = even_pat if (abs_i + abs_j) % 2 == 0 else odd_pat
+                target_pat = patterns[key]
+            r0 = abs_i * step + 1
+            c0 = abs_j * step + 1
+            out[r0 : r0 + inner, c0 : c0 + inner] = target_pat
+    return out
+
+
+# --------------- generator ---------------
+
+CELL_GRID_N = 7
+CELL_INNER = 3
+CELL_STEP = 4
+GRID_SIZE = 29
+MASK_SIZE = 3
+PLACEMENT_RANGE = CELL_GRID_N - MASK_SIZE + 1
+ACTIVE_PIXEL_COUNTS = (6, 7)
+SOURCE_GIVEN_SIZES = (3, 4)
+DISTRACTOR_EXTRA = (2, 3, 4)
+COLOR_POOL = 10
+MAX_RETRIES = 500
+
+_LR_GROUPS = [
+    ((0, 0), (0, 2)),
+    ((1, 0), (1, 2)),
+    ((2, 0), (2, 2)),
+    ((0, 1),),
+    ((1, 1),),
+    ((2, 1),),
+]
+
+_BASE_SEEDS = [
+    np.array([[1, 1, 0], [0, 1, 0], [1, 0, 0]], dtype=bool),
+    np.array([[1, 0, 0], [1, 1, 0], [0, 1, 1]], dtype=bool),
+    np.array([[0, 1, 1], [1, 0, 1], [0, 0, 1]], dtype=bool),
+]
+
+
+def _precompute_masks() -> dict[int, list[np.ndarray]]:
+    """Enumerate source masks whose inactive pixels hit both checkerboard parities."""
+    weights = [len(group) for group in _LR_GROUPS]
+    by_count: dict[int, list[np.ndarray]] = {}
+    for active_count in ACTIVE_PIXEL_COUNTS:
+        inactive_count = MASK_SIZE * MASK_SIZE - active_count
+        masks: list[np.ndarray] = []
+        for k in range(1, len(_LR_GROUPS) + 1):
+            for combo in combinations(range(len(_LR_GROUPS)), k):
+                if sum(weights[i] for i in combo) != inactive_count:
+                    continue
+                mask = np.ones((MASK_SIZE, MASK_SIZE), dtype=bool)
+                for idx in combo:
+                    for r, c in _LR_GROUPS[idx]:
+                        mask[r, c] = False
+                if not (mask[0, :].any() and mask[-1, :].any() and mask[:, 0].any() and mask[:, -1].any()):
+                    continue
+                inactive_parities = {(int(r) + int(c)) % 2 for r, c in np.argwhere(~mask)}
+                if len(inactive_parities) != 2:
+                    continue
+                masks.append(mask)
+        by_count[active_count] = masks
+    return by_count
+
+
+def _precompute_base_masks() -> list[np.ndarray]:
+    """Build a catalog of asymmetric 3x3 motifs for checkerboard and distractor tiles."""
+    seen: set[tuple[int, ...]] = set()
+    catalog: list[np.ndarray] = []
+    for seed in _BASE_SEEDS:
+        variants = [
+            seed,
+            np.rot90(seed, 1),
+            np.rot90(seed, 2),
+            np.rot90(seed, 3),
+            np.fliplr(seed),
+            np.flipud(seed),
+        ]
+        for variant in variants:
+            key = tuple(int(v) for v in variant.ravel())
+            if key not in seen:
+                seen.add(key)
+                catalog.append(variant.copy())
+    return catalog
+
+
+_MASKS_BY_COUNT = _precompute_masks()
+_BASE_MASKS = _precompute_base_masks()
+
+
+def _random_source_mask() -> np.ndarray:
+    active_count = random.choice(ACTIVE_PIXEL_COUNTS)
+    return random.choice(_MASKS_BY_COUNT[active_count]).copy()
+
+
+def _random_checkerboard_pair(shared: int, base_exclusive: int) -> tuple[np.ndarray, np.ndarray]:
+    for _ in range(60):
+        mask_a, mask_b = random.sample(_BASE_MASKS, 2)
+        if np.count_nonzero(mask_a != mask_b) >= 3:
+            arr_a = np.where(mask_a, base_exclusive, shared).astype(int)
+            arr_b = np.where(mask_b, base_exclusive, shared).astype(int)
+            return arr_a, arr_b
+    raise RuntimeError("failed to choose checkerboard motifs")
+
+
+def _random_distractor_pattern(shared: int, distractor_exclusive: int) -> np.ndarray:
+    mask = random.choice(_BASE_MASKS)
+    return np.where(mask, distractor_exclusive, shared).astype(int)
+
+
+def _placement_candidates(
+    mask: np.ndarray, subset: tuple[tuple[int, int], ...], top: int, left: int
+) -> list[tuple[int, int]]:
+    existing = np.zeros((CELL_GRID_N, CELL_GRID_N), dtype=bool)
+    for r, c in subset:
+        existing[top + r, left + c] = True
+
+    candidates: list[tuple[int, int]] = []
+    for t in range(PLACEMENT_RANGE):
+        for l in range(PLACEMENT_RANGE):
+            block = np.zeros((CELL_GRID_N, CELL_GRID_N), dtype=bool)
+            block[t : t + MASK_SIZE, l : l + MASK_SIZE] = True
+            if np.any(existing & ~block):
+                continue
+            if np.any(existing[t : t + MASK_SIZE, l : l + MASK_SIZE] & ~mask):
+                continue
+            candidates.append((t, l))
+    return candidates
+
+
+def _subset_is_informative(subset: tuple[tuple[int, int], ...], top: int, left: int) -> bool:
+    parities = {(top + r + left + c) % 2 for r, c in subset}
+    even_count = sum(1 for r, c in subset if (top + r + left + c) % 2 == 0)
+    odd_count = len(subset) - even_count
+    return len(parities) == 2 and even_count != odd_count
+
+
+def _choose_given_subset(mask: np.ndarray, top: int, left: int) -> tuple[tuple[int, int], ...] | None:
+    active = [tuple(int(v) for v in coord) for coord in np.argwhere(mask)]
+    sizes = list(SOURCE_GIVEN_SIZES)
+    random.shuffle(sizes)
+    for size in sizes:
+        valid = [
+            subset
+            for subset in combinations(active, size)
+            if _subset_is_informative(subset, top, left)
+            and _placement_candidates(mask, subset, top, left) == [(top, left)]
+        ]
+        if valid:
+            return random.choice(valid)
+    return None
+
+
+def _cell_origin(i: int, j: int) -> tuple[int, int]:
+    return i * CELL_STEP + 1, j * CELL_STEP + 1
+
+
+def _build_grid(
+    separator: int,
+    even_pat: np.ndarray,
+    odd_pat: np.ndarray,
+    overrides: dict[tuple[int, int], np.ndarray],
+) -> np.ndarray:
+    grid = np.full((GRID_SIZE, GRID_SIZE), separator, dtype=int)
+    for i in range(CELL_GRID_N):
+        for j in range(CELL_GRID_N):
+            base_pat = even_pat if (i + j) % 2 == 0 else odd_pat
+            paste(grid, base_pat, *_cell_origin(i, j))
+    for (i, j), pat in overrides.items():
+        paste(grid, pat, *_cell_origin(i, j))
+    return grid
+
+
+def _positions_outside_block(top: int, left: int) -> list[tuple[int, int]]:
+    return [
+        (i, j)
+        for i in range(CELL_GRID_N)
+        for j in range(CELL_GRID_N)
+        if not (top <= i < top + MASK_SIZE and left <= j < left + MASK_SIZE)
+    ]
+
+
+def _analyze_grid(grid: np.ndarray) -> tuple[dict[tuple[int, ...], int], tuple[int, ...], tuple[int, ...], tuple[int, ...]]:
+    step, _, _ = _infer_cell_grid_params(grid)
+    _, _, patterns, cell_pat = _extract_cell_patterns(grid, step)
+    counts = _count_patterns(cell_pat)
+    source_pat = min(counts.items(), key=lambda kv: kv[1])[0]
+    even_pat, odd_pat = _infer_checkerboard_basis(counts, cell_pat, source_pat)
+    return counts, source_pat, even_pat, odd_pat
+
+
+def _generate_case() -> dict[str, object] | None:
+    separator, shared, base_exclusive, source_exclusive, distractor_exclusive = random.sample(range(COLOR_POOL), 5)
+
+    even_pat, odd_pat = _random_checkerboard_pair(shared, base_exclusive)
+    mask = _random_source_mask()
+    source_pat = np.where(mask, source_exclusive, shared).astype(int)
