    90	def _extract_cell_patterns(
    91	    g: np.ndarray, step: int
    92	) -> tuple[int, int, dict[tuple[int, ...], np.ndarray], list[list[tuple[int, ...]]]]:
    93	    n = (g.shape[0] - 1) // step
    94	    inner = step - 1
    95	    patterns: dict[tuple[int, ...], np.ndarray] = {}
    96	    cell_pat: list[list[tuple[int, ...]]] = []
    97	    for i in range(n):
    98	        row: list[tuple[int, ...]] = []
    99	        for j in range(n):
   100	            r0 = i * step + 1
   101	            c0 = j * step + 1
   102	            pat_arr = g[r0 : r0 + inner, c0 : c0 + inner].copy()
   103	            pat = tuple(int(v) for v in pat_arr.ravel())
   104	            if pat not in patterns:
   105	                patterns[pat] = pat_arr
   106	            row.append(pat)
   107	        cell_pat.append(row)
   108	    return n, inner, patterns, cell_pat
