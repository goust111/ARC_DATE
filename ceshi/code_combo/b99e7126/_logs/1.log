   111	def _count_patterns(cell_pat: list[list[tuple[int, ...]]]) -> dict[tuple[int, ...], int]:
   112	    counts: dict[tuple[int, ...], int] = {}
   113	    for row in cell_pat:
   114	        for pat in row:
   115	            counts[pat] = counts.get(pat, 0) + 1
   116	    return counts
   117	
   118	
   119	def _checkerboard_score(
   120	    cell_pat: list[list[tuple[int, ...]]],
   121	    source_pat: tuple[int, ...],
   122	    even_pat: tuple[int, ...],
   123	    odd_pat: tuple[int, ...],
   124	) -> int:
   125	    mismatches = 0
   126	    for i, row in enumerate(cell_pat):
   127	        for j, pat in enumerate(row):
   128	            if pat == source_pat:
   129	                continue
   130	            expected = even_pat if (i + j) % 2 == 0 else odd_pat
   131	            mismatches += int(pat != expected)
   132	    return mismatches
   133	
   134	
   135	def _infer_checkerboard_basis(
   136	    counts: dict[tuple[int, ...], int],
   137	    cell_pat: list[list[tuple[int, ...]]],
   138	    source_pat: tuple[int, ...],
   139	) -> tuple[tuple[int, ...], tuple[int, ...]]:
   140	    candidates: list[tuple[int, tuple[int, ...], tuple[int, ...]]] = []
   141	    others = [pat for pat in counts if pat != source_pat]
   142	    for even_pat, odd_pat in permutations(others, 2):
   143	        score = _checkerboard_score(cell_pat, source_pat, even_pat, odd_pat)
   144	        candidates.append((score, even_pat, odd_pat))
   145	    candidates.sort(key=lambda item: item[0])
   146	    assert len(candidates) >= 2, "need at least two non-source motifs for checkerboard inference"
   147	    assert candidates[0][0] < candidates[1][0], "checkerboard basis must be uniquely identifiable"
   148	    return candidates[0][1], candidates[0][2]
