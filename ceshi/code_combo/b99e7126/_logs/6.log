+    left = _choose_left()
+    valid_tops = _repeat_class_tops(parity, CELL_GRID_N)
+    top = random.choice(valid_tops)
+
+    active_cells = sorted(_repeated_active_cells(mask, parity, left, CELL_GRID_N))
+    out = _build_grid(separator, majority, minority, active_cells)
+
+    given_cells = _choose_given_subset(mask, top, left)
