+
+def _choose_given_subset(mask: np.ndarray, top: int, left: int) -> tuple[tuple[int, int], ...] | None:
+    """Choose a subset of active cells that identifies the wrapped repeat class."""
+    placed = sorted(_placed_active_cells(mask, top, left, CELL_GRID_N))
+    target = (top % REPEAT_STEP, left)
+    sizes = list(GIVEN_CELL_SIZES)
+    random.shuffle(sizes)
+    for size in sizes:
+        valid = [
+            subset
+            for subset in combinations(placed, size)
+            if _repeat_class_candidates(mask, subset) == [target]
+        ]
+        if valid:
+            return random.choice(valid)
+    return None
+
+
+def _cell_origin(i: int, j: int) -> tuple[int, int]:
+    """Pixel origin of cell (i, j) interior within the full grid."""
+    return i * CELL_STEP + 1, j * CELL_STEP + 1
+
+
+def _build_grid(separator: int, majority: np.ndarray, minority: np.ndarray, active_cells) -> np.ndarray:
+    """Construct a 29x29 grid: fill all cells with majority, then overwrite active_cells."""
+    grid = np.full((GRID_SIZE, GRID_SIZE), separator, dtype=int)
+    for i in range(CELL_GRID_N):
