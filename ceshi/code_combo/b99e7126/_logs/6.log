import importlib.util
import numpy as np
from collections import Counter

spec = importlib.util.spec_from_file_location('variant', '/home/lixinyu/snap/new/ceshi/code_combo/b99e7126/6/code.py')
mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)


def parse(grid):
    g = np.asarray(grid, dtype=int)
    step, _, _ = mod._infer_cell_grid_params(g)
    n = (g.shape[0] - 1) // step
    inner = step - 1
    patterns = {}
    cell_pat = []
    for i in range(n):
        row = []
        for j in range(n):
            r0 = i * step + 1
            c0 = j * step + 1
            arr = g[r0:r0+inner, c0:c0+inner].copy()
            pat = tuple(arr.ravel().tolist())
            patterns.setdefault(pat, arr)
            row.append(pat)
        cell_pat.append(row)
    counts = Counter(p for row in cell_pat for p in row)
    minority_pat = min(counts.items(), key=lambda kv: kv[1])[0]
    minority_arr = patterns[minority_pat]
    vals, cnts = np.unique(minority_arr, return_counts=True)
    active_color = int(vals[cnts.argmax()])
    mask = minority_arr == active_color
    existing = set()
    for i in range(n):
        for j in range(n):
            if cell_pat[i][j] == minority_pat:
                existing.add((i, j))
    return n, mask, existing

samples = 100
extra_sizes = []
wrapped_cells = []
edge_interference = []
col_wrap_samples = 0
for _ in range(samples):
    inp = mod.generate_input()
    n, mask, existing = parse(inp)
    candidates = [(t, l) for t in range(n) for l in range(n) if existing <= mod._placed_active_cells(mask, t, l, n)]
    classes = sorted({(t % mod.REPEAT_STEP, l) for t, l in candidates})
    assert len(classes) == 1
    parity, left = classes[0]
    union = mod._repeated_active_cells(mask, parity, left, n)
    single_size = int(mask.sum())
    extra_sizes.append(len(union) - single_size)

    hit_counts = Counter()
    wrapped_sources = set()
    for top in mod._repeat_class_tops(parity, n):
        for r, c in mod._mask_coords(mask):
            cell = ((top + r) % n, (left + c) % n)
            if mask[r, c]:
                hit_counts[cell] += 1
                if top + r >= n or left + c >= n:
                    wrapped_sources.add(cell)
        if any(left + c >= n for r, c in mod._mask_coords(mask) if mask[r, c]):
            col_wrap_samples += 1
            break
    wrapped_cells.append(len(wrapped_sources))
    edge_interference.append(sum(1 for (i, j), v in hit_counts.items() if v >= 2 and (i in (0, n - 1) or j in (0, n - 1))))

