+# Combo variant of b99e7126 (index 6)
+# combo_spec: D3/3+D14/0
+# Name: 多次叠加 + 环绕式边界
+#
+# Design analysis:
+# fused_rule:
+#   - Original b99e7126 reconstructs one in-bounds 3x3 cell-level enlargement of the minority cell.
+#   - D3/3 changes the destination from one anchor block to a repeat class of anchors.
+#   - D14/0 changes each enlarged placement from clipped Cartesian addressing to toroidal addressing.
+#   - The fused variant uses both together: once a repeat class is identified, the same 3x3 stencil is
+#     placed at every canonical top in that class (`top = parity, parity+2, ... < 7`) with one fixed left,
+#     and every individual placement wraps modulo the 7x7 cell lattice.
+# example_trace:
+#   - Suppose the minority mask is active at local coordinates
+#     {(0,0),(0,1),(1,0),(1,1),(2,1),(2,2)}, and the chosen class is parity=1, left=6.
+#   - Original task: choose one anchor such as (top,left)=(3,6), then only cells in that single 3x3 block
+#     are affected; anything beyond the right edge would have been impossible.
+#   - Fused task: use anchors top in {1,3,5}. The block at top=5 wraps vertically to rows {5,6,0};
+#     left=6 wraps horizontally to cols {6,0,1}. The union of the three wrapped placements becomes the
+#     output minority region, so top/bottom and left/right borders both show continuation and overlaps.
+# complexity_calibration:
+#   - Repeating along one axis keeps the search space to 14 repeat classes `(top % 2, left)` instead of
+#     exploding to all pairwise combinations of anchors.
+#   - Each class has 3 or 4 placements, enough to make the repeated structure obvious without flooding the
+#     7x7 board; minority cells stay below half of the grid, so the minority pattern remains identifiable.
+# implicit_assumptions_review:
+#   - The original solver assumed a unique concrete anchor `(top,left)`. That breaks here because several
+#     anchors in the same repeat class can explain the visible givens, so the solver must deduplicate by
+#     output-equivalent class `(top % 2, left)`.
+#   - The original solver also assumed rectangular slicing without wrap. That fails once an anchor like
+#     `(5,6)` is legal, so candidate testing and painting must both use modulo-7 coordinates.
+#   - Sequentially writing one placement after another would let inactive pixels from a later block erase
+#     active pixels from an earlier block. The fused rule therefore computes the union of active hits first
+#     and paints cells once from that union.
+# placement_legality:
+#   - A single 3x3 toroidal placement on a 7x7 lattice never self-overlaps because the mask is smaller than
+#     the lattice in both axes.
+#   - Canonical anchor rows are `range(parity, 7, 2)`, so a class has either 4 placements (parity 0) or
+#     3 placements (parity 1). Their overlaps are intentional and only affect the active/majority choice.
+#   - The generator is output-first and only returns inputs whose subsets are accepted by `main()` and
+#     reconstruct the same repeated wrapped union.
+# visual_observability:
+#   - Human-solvable cues are spatial: the output grows from a small visible subset into a vertical repeated
+#     band whose topmost and bottommost fragments continue across borders.
+#   - No color ordering is used; colors keep the original roles of separator, majority-exclusive, shared,
+#     and minority-exclusive.
+# cleanliness_and_inference:
+#   - The final board still contains only two cell interiors, so the image stays legible even where repeated
+#     placements overlap.
+#   - Row-wrap is guaranteed in every generated output because each repeat class includes a highest anchor
+#     (`top=5` or `top=6`) whose 3x3 placement crosses the bottom edge.
+# solver_assumptions_after_change:
+#   - The input still contains exactly two relevant cell patterns, with the minority one appearing 3-4 times.
+#   - Those visible minority cells come from one concrete wrapped placement inside the true repeat class.
+#   - Among all 14 repeat classes, exactly one is compatible with the givens; the generator enforces this.
+
+from functools import reduce
+from itertools import combinations
+from math import gcd
+import random
+
+import numpy as np
+
+from arc_utils import paste
+
+
+def _infer_cell_grid_params(g: np.ndarray) -> tuple[int, list[int], list[int]]:
+    """
+    Infer a regular cell grid separated by full rows/cols of the same line color.
+    Returns (step, row_divs, col_divs) where:
+      - row_divs/col_divs are divider indices
+      - step is the spacing between dividers (cell size including divider).
+    """
+    h, w = g.shape
+    line = int(g[0, 0])
+    row_divs = [r for r in range(h) if np.all(g[r, :] == line)]
+    col_divs = [c for c in range(w) if np.all(g[:, c] == line)]
+    assert len(row_divs) >= 2 and len(col_divs) >= 2, "need at least 2 row and 2 col dividers"
+    row_divs.sort()
+    col_divs.sort()
+    drs = [row_divs[i + 1] - row_divs[i] for i in range(len(row_divs) - 1) if row_divs[i + 1] > row_divs[i]]
+    dcs = [col_divs[i + 1] - col_divs[i] for i in range(len(col_divs) - 1) if col_divs[i + 1] > col_divs[i]]
+    step = reduce(gcd, drs + dcs)
+    assert step > 1, "divider step must be > 1"
+    assert row_divs[0] == 0 and col_divs[0] == 0, "first divider must be at index 0"
+    assert (h - 1) % step == 0 and (w - 1) % step == 0, "grid dimensions must be (k*step + 1)"
+    assert row_divs[-1] == h - 1 and col_divs[-1] == w - 1, "last divider must be at boundary"
+    return int(step), row_divs, col_divs
+
+
+def _mask_coords(mask: np.ndarray) -> list[tuple[int, int]]:
+    return [tuple(map(int, coord)) for coord in np.argwhere(mask)]
+
+
+def _placed_active_cells(mask: np.ndarray, top: int, left: int, n: int) -> set[tuple[int, int]]:
+    coords = _mask_coords(mask)
+    return {((top + r) % n, (left + c) % n) for r, c in coords}
+
+
+def _repeat_class_tops(parity: int, n: int) -> list[int]:
+    return list(range(parity, n, REPEAT_STEP))
+
+
+def _repeated_active_cells(mask: np.ndarray, parity: int, left: int, n: int) -> set[tuple[int, int]]:
+    cells: set[tuple[int, int]] = set()
+    for top in _repeat_class_tops(parity, n):
+        cells |= _placed_active_cells(mask, top, left, n)
+    return cells
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Read the odd cell as a large-scale stencil, then repeat that wrapped stencil across one anchor class.
+
+    Input structure:
+    - The board is split into equal 3x3 interiors by one-color divider rows and columns.
+    - Almost all cells share one interior pattern, while a few visible cells use a distinct minority pattern.
+    - Those visible minority cells come from one wrapped 3x3 enlargement, but the finished output will reuse
+      the same enlargement at several anchor rows belonging to one repeat class.
+
+    Rule:
+    - Extract the minority cell interior and use its most frequent color as the active mask inside a 3x3
+      stencil.
+    - Find every toroidal anchor whose active cells could contain the visible minority cells, then collapse
+      those anchors to output-equivalent repeat classes `(top % 2, left)`.
+    - Keep the unique repeat class and place the stencil at every canonical top in that class, wrapping row
+      and column coordinates modulo the cell-grid size.
+    - A cell becomes minority if any repeated wrapped placement hits it with an active mask pixel; all other
+      cells stay majority.
+
+    Key insight:
+    - The odd cell is still a self-similar blueprint, but now the blueprint is not a one-off patch. It is a
+      toroidal stamp reused at several aligned anchors, so border-crossing fragments and overlaps belong to
+      the same repeated structure.
+    """
+    g = np.asarray(grid, dtype=int)
+    step, _, _ = _infer_cell_grid_params(g)
+    n = (g.shape[0] - 1) // step
+    inner = step - 1
+
+    patterns: dict[tuple[int, ...], np.ndarray] = {}
+    cell_pat: list[list[tuple[int, ...]]] = []
+    for i in range(n):
+        row: list[tuple[int, ...]] = []
+        for j in range(n):
+            r0 = i * step + 1
+            c0 = j * step + 1
+            pat_arr = g[r0 : r0 + inner, c0 : c0 + inner].copy()
+            pat = tuple(pat_arr.ravel().tolist())
+            if pat not in patterns:
+                patterns[pat] = pat_arr
+            row.append(pat)
+        cell_pat.append(row)
+
+    counts: dict[tuple[int, ...], int] = {}
+    for i in range(n):
+        for j in range(n):
+            pat = cell_pat[i][j]
+            counts[pat] = counts.get(pat, 0) + 1
+    assert len(counts) >= 2, "must have at least 2 distinct cell patterns (minority + majority)"
+
+    minority_pat = min(counts.items(), key=lambda kv: kv[1])[0]
+    majority_pat = max(counts.items(), key=lambda kv: kv[1])[0]
+    minority_arr = patterns[minority_pat]
+    majority_arr = patterns[majority_pat]
+
+    vals, cnts = np.unique(minority_arr, return_counts=True)
+    active_color = int(vals[cnts.argmax()])
+    mask = minority_arr == active_color
+
+    existing: set[tuple[int, int]] = set()
+    for i in range(n):
+        for j in range(n):
+            if cell_pat[i][j] == minority_pat:
+                existing.add((i, j))
+
+    candidates: list[tuple[int, int]] = []
+    for top in range(n):
+        for left in range(n):
+            if existing <= _placed_active_cells(mask, top, left, n):
+                candidates.append((top, left))
+
+    repeat_classes = sorted({(top % REPEAT_STEP, left) for top, left in candidates})
+    assert len(repeat_classes) == 1, "must have a unique wrapped repeat class aligning the given minority cells"
+    parity, left = repeat_classes[0]
+    active_cells = _repeated_active_cells(mask, parity, left, n)
+
+    out = g.copy()
+    for i in range(n):
+        for j in range(n):
+            target = minority_arr if (i, j) in active_cells else majority_arr
+            r0 = i * step + 1
+            c0 = j * step + 1
+            out[r0 : r0 + inner, c0 : c0 + inner] = target
+    return out
+
+
+# --------------- generator (o5x) ---------------
+
+CELL_GRID_N = 7
+CELL_INNER = 3
+CELL_STEP = 4
+GRID_SIZE = 29
+MASK_SIZE = 3
+PLACEMENT_RANGE = CELL_GRID_N
+REPEAT_STEP = 2
+ACTIVE_PIXEL_COUNTS = (6, 7)
+GIVEN_CELL_SIZES = [3, 4]
+COLOR_POOL = 10
+MAX_RETRIES = 500
+WRAP_LEFT_OFFSETS = tuple(range(CELL_GRID_N - MASK_SIZE + 1, CELL_GRID_N))
+
+_LR_GROUPS = [
+    ((0, 0), (0, 2)),
+    ((1, 0), (1, 2)),
