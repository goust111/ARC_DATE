+    counts: dict[tuple[int, ...], int] = {}
+    for i in range(n):
+        for j in range(n):
+            pat = cell_pat[i][j]
+            counts[pat] = counts.get(pat, 0) + 1
+    assert len(counts) >= 2, "must have at least 2 distinct cell patterns (minority + majority)"
+
+    minority_pat = min(counts.items(), key=lambda kv: kv[1])[0]
+    majority_pat = max(counts.items(), key=lambda kv: kv[1])[0]
+    minority_arr = patterns[minority_pat]
+    majority_arr = patterns[majority_pat]
+
+    vals, cnts = np.unique(minority_arr, return_counts=True)
+    active_color = int(vals[cnts.argmax()])
+    mask = minority_arr == active_color
+
+    existing: set[tuple[int, int]] = set()
+    for i in range(n):
+        for j in range(n):
+            if cell_pat[i][j] == minority_pat:
+                existing.add((i, j))
+
+    candidates: list[tuple[int, int]] = []
+    for top in range(n):
+        for left in range(n):
+            if existing <= _placed_active_cells(mask, top, left, n):
+                candidates.append((top, left))
+
+    repeat_classes = sorted({(top % REPEAT_STEP, left) for top, left in candidates})
+    assert len(repeat_classes) == 1, "must have a unique wrapped repeat class aligning the given minority cells"
+    parity, left = repeat_classes[0]
+    active_cells = _repeated_active_cells(mask, parity, left, n)
+
+    out = g.copy()
+    for i in range(n):
+        for j in range(n):
+            target = minority_arr if (i, j) in active_cells else majority_arr
+            r0 = i * step + 1
+            c0 = j * step + 1
+            out[r0 : r0 + inner, c0 : c0 + inner] = target
+    return out
+
+
+# --------------- generator (o5x) ---------------
+
+CELL_GRID_N = 7
+CELL_INNER = 3
+CELL_STEP = 4
+GRID_SIZE = 29
+MASK_SIZE = 3
+PLACEMENT_RANGE = CELL_GRID_N
+REPEAT_STEP = 2
+ACTIVE_PIXEL_COUNTS = (6, 7)
+GIVEN_CELL_SIZES = [3, 4]
+COLOR_POOL = 10
+MAX_RETRIES = 500
+WRAP_LEFT_OFFSETS = tuple(range(CELL_GRID_N - MASK_SIZE + 1, CELL_GRID_N))
+
+_LR_GROUPS = [
+    ((0, 0), (0, 2)),
+    ((1, 0), (1, 2)),
+    ((2, 0), (2, 2)),
+    ((0, 1),),
+    ((1, 1),),
+    ((2, 1),),
+]
+
+
+def _precompute_masks():
+    """Enumerate all valid LR-symmetric 3x3 masks, keyed by active pixel count."""
+    weights = [len(group) for group in _LR_GROUPS]
+    by_count: dict[int, list[np.ndarray]] = {}
+    for active_count in ACTIVE_PIXEL_COUNTS:
+        inactive_count = MASK_SIZE * MASK_SIZE - active_count
+        masks: list[np.ndarray] = []
+        for k in range(1, len(_LR_GROUPS) + 1):
+            for combo in combinations(range(len(_LR_GROUPS)), k):
+                if sum(weights[idx] for idx in combo) != inactive_count:
+                    continue
+                mask = np.ones((MASK_SIZE, MASK_SIZE), dtype=bool)
+                for idx in combo:
+                    for r, c in _LR_GROUPS[idx]:
+                        mask[r, c] = False
+                if mask[0, :].any() and mask[2, :].any() and mask[:, 0].any() and mask[:, 2].any():
+                    masks.append(mask)
+        by_count[active_count] = masks
+    return by_count
+
+
+_MASKS_BY_COUNT = _precompute_masks()
+
+
+def _random_lr_pattern(color_a: int, color_b: int) -> np.ndarray:
+    """Generate a random LR-symmetric 3x3 pattern using two colors (guaranteed non-uniform)."""
+    arr = np.empty((MASK_SIZE, MASK_SIZE), dtype=int)
+    choices = [random.choice((color_a, color_b)) for _ in _LR_GROUPS]
+    if all(value == choices[0] for value in choices):
+        choices[random.randrange(len(choices))] = color_b if choices[0] == color_a else color_a
+    for group, color in zip(_LR_GROUPS, choices):
+        for r, c in group:
+            arr[r, c] = color
+    return arr
+
+
+def _random_minority_mask() -> np.ndarray:
+    """Pick a random valid minority mask (uniform over active count, then uniform within count)."""
+    active_count = random.choice(ACTIVE_PIXEL_COUNTS)
+    return random.choice(_MASKS_BY_COUNT[active_count])
+
+
+def _repeat_class_candidates(mask: np.ndarray, given_cells: tuple[tuple[int, int], ...]) -> list[tuple[int, int]]:
+    candidates = []
+    existing = set(given_cells)
+    for top in range(PLACEMENT_RANGE):
+        for left in range(PLACEMENT_RANGE):
+            if existing <= _placed_active_cells(mask, top, left, CELL_GRID_N):
+                candidates.append((top % REPEAT_STEP, left))
+    return sorted(set(candidates))
+
+
+def _choose_given_subset(mask: np.ndarray, top: int, left: int) -> tuple[tuple[int, int], ...] | None:
+    """Choose a subset of active cells that identifies the wrapped repeat class."""
+    placed = sorted(_placed_active_cells(mask, top, left, CELL_GRID_N))
+    target = (top % REPEAT_STEP, left)
+    sizes = list(GIVEN_CELL_SIZES)
+    random.shuffle(sizes)
+    for size in sizes:
+        valid = [
+            subset
+            for subset in combinations(placed, size)
+            if _repeat_class_candidates(mask, subset) == [target]
+        ]
+        if valid:
+            return random.choice(valid)
+    return None
+
+
+def _cell_origin(i: int, j: int) -> tuple[int, int]:
+    """Pixel origin of cell (i, j) interior within the full grid."""
+    return i * CELL_STEP + 1, j * CELL_STEP + 1
+
+
+def _build_grid(separator: int, majority: np.ndarray, minority: np.ndarray, active_cells) -> np.ndarray:
+    """Construct a 29x29 grid: fill all cells with majority, then overwrite active_cells."""
+    grid = np.full((GRID_SIZE, GRID_SIZE), separator, dtype=int)
+    for i in range(CELL_GRID_N):
+        for j in range(CELL_GRID_N):
+            paste(grid, majority, *_cell_origin(i, j))
+    for i, j in active_cells:
+        paste(grid, minority, *_cell_origin(i, j))
+    return grid
+
+
+def _choose_left() -> int:
+    if random.random() < 0.5:
+        return random.choice(WRAP_LEFT_OFFSETS)
+    return random.randrange(CELL_GRID_N)
+
+
+def _gen_attempt() -> np.ndarray | None:
+    """Single generation attempt: build output, choose input subset, verify with solver."""
+    separator, maj_exclusive, shared, min_exclusive = random.sample(range(COLOR_POOL), 4)
+    majority = _random_lr_pattern(shared, maj_exclusive)
+    mask = _random_minority_mask()
+    minority = np.where(mask, min_exclusive, shared).astype(int)
+
+    parity = random.randrange(REPEAT_STEP)
+    left = _choose_left()
+    valid_tops = _repeat_class_tops(parity, CELL_GRID_N)
+    top = random.choice(valid_tops)
+
+    active_cells = sorted(_repeated_active_cells(mask, parity, left, CELL_GRID_N))
+    out = _build_grid(separator, majority, minority, active_cells)
+
+    given_cells = _choose_given_subset(mask, top, left)
+    if given_cells is None:
+        return None
+    inp = _build_grid(separator, majority, minority, given_cells)
+
+    try:
+        solved = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(solved, out):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid b99e7126 combo input")

