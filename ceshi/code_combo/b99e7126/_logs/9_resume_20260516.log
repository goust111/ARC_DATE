+# Combo variant of b99e7126 (index 9)
+# combo_spec: D1/4+D2/1
+# Name: 形状匹配识别 + 三色源图案
+
+from functools import reduce
+from itertools import combinations, product
+from math import gcd
+
+import numpy as np
+import random
+
+from arc_utils import paste
+
+# Design analysis
+# ---------------
+# a) Concrete behavior trace
+# - 原题用“精确 3x3 位图计数”找 minority，再把该 cell 当作二值模板放大。
+# - 这里改成两层耦合：
+#   1. 先把每个 cell 压缩成“唯一主色的 4 连通形状”，再按 D4 规范形状类计数。
+#      多数类允许大量旋转/镜像/背景换色的像素变体，所以像素计数会失效，但形状类仍稳定。
+#   2. 稀有类 cell 本身是三色 source legend。其 3x3 颜色不再是二值 mask，而是：
+#      - `main` 色: 该宏观位置要放 source cell
+#      - `accent` 色: 该宏观位置要放辅助 cell
+#      - `shared` 色: 该宏观位置保留原有多数类 cell
+# - 小追踪：
+#   source legend 的一行如果是 [main, accent, shared]，
+#   原题二值逻辑会把后两者都塌缩成“非 active -> majority”；
+#   融合后则分别变成 [source, accent, keep-existing-majority]。
+#   同时，source 的识别并不是靠“这张三色图案出现次数最少”，
+#   而是靠“这批 cell 的主色几何形状类最少见”。
+#
+# b) Complexity calibration
+# - 网格骨架仍是 7x7 个 cell、cell 内部 3x3、分隔线 1 像素，空间关系与原题一致。
+# - 多数类只保留一个几何形状类，但制造几十种 exact bitmap 变体，避免退化成像素比较。
+# - source legend 固定使用三色且含 3 个 accent 位置；generator 只显露其中一部分，
+#   因而输出必须真正补出缺失 accent，不能退化成“只补 source”的二值版本。
+# - 颜色角色总数控制在 6 个：分隔线、source-main、shared、accent、两种背景色。
+#
+# c) Hidden assumption audit against the original main()
+# - 原代码假设“最少见 exact pattern 就是 minority”；这里不成立，因为多数类被打散成大量 unique bitmap。
+# - 原代码假设 minority cell 内只有 active/inactive 两种像素；这里不成立，因为三色 legend 有三种宏观行为。
+# - 原代码假设 inactive 位置都要统一写回某个 majority pattern；这里不成立，因为多数底板允许同形异纹。
+#   新 solver 只在 `main` 和 `accent` 位置真正覆盖，`shared` 位置保持原样。
+# - 原代码的 placement check 只看 bool mask；这里必须分别检查 source clue 和 accent clue，
+#   因为两者对应 source legend 中不同的颜色标签。
+#
+# d) Placement legality
+# - 宏观 block 仍是 3x3 cell，偏移范围仍为 0..4，不会越界。
+# - 生成时先铺满唯一化的多数类底板，再按 legend 覆盖完整输出，再隐藏一部分 source/accent 得到输入，
+#   因此不会出现重叠冲突。
+# - 给定子集必须同时包含 source clue 与 accent clue，并且唯一确定 block 偏移，否则重采样。
+#
+# e) Visual observability
+# - 人眼能先看出：绝大多数 cell 虽像素不同，但主色形状是同一类；少数 cell 的主色形状是另一类。
+# - 然后能看出三色 source legend 中的 `shared`/`accent` 颜色分别在多数类与辅助类里重复出现，
+#   于是可把 legend 读成“宏观 3x3 说明图”。
+# - 规则不依赖颜色编号大小；只依赖可见的形状类和颜色复现关系。
+#
+# f) Visual neatness
+# - 覆盖只发生在 cell 粒度，不在同一 3x3 内叠多层像素对象。
+# - source 与 accent 都是整块 cell 替换；shared 位置则保留底板，输出区域仍规整。
+# - 多数类背景花纹只存在各自 cell 内部，不会破坏宏观 block 的可读性。
+#
+# g) Color-change inferability
+# - `shared` 色在 source legend 中出现，同时也是多数类 cell 的主色。
+# - `accent` 色在 source legend 中出现，同时也是辅助 cell 的主色。
+# - 因此三色映射不是任意 recolor，而是通过“legend 颜色 -> 重复 cell 类型”显式提示出来。
+#
+# h) Quantitative anti-degeneration target
+# - 每个样本都要求 source legend 含 3 个 accent 位置，且输入只揭示其中 2 个，因此输出至少新增 1 个 accent cell。
+# - 每个样本的多数底板都从大 bank 中无放回抽样，保证 common shape class 下有大量 exact-pattern singleton，
+#   从而原题式 exact-pattern minority 识别会失真。
+#
+# i) New solver assumptions and generator guarantees
+# - solver 假设每个 cell 都有唯一主色且该主色形成单个 4 连通块；generator 对 source/majority/accent 全部满足。
+# - solver 假设 canonical shape class 恰好两类：rare source 类与 common majority 类；generator 固定如此构造。
+# - solver 假设 common 类里有两种主色：大量 shared、多次但更少的 accent；generator 保证输入至少显露 2 个 accent。
+# - solver 假设所有显露的 accent cell 精确相同，便于作为隐藏 accent 的模板；generator 固定使用一个 accent pattern。
+
+CELL_GRID_N = 7
+CELL_INNER = 3
+CELL_STEP = 4
+GRID_SIZE = 29
+PLACEMENT_RANGE = CELL_GRID_N - CELL_INNER + 1
+GIVEN_CELL_SIZES = (4, 5)
+COLOR_POOL = 10
+MAX_RETRIES = 500
+
+LABEL_MAIN = 0
+LABEL_SHARED = 1
+LABEL_ACCENT = 2
+
+MAJORITY_MASK = np.array(
+    [
+        [1, 1, 0],
+        [1, 0, 0],
+        [1, 1, 0],
+    ],
+    dtype=bool,
+)
+
+
+def _infer_cell_grid_params(g: np.ndarray) -> tuple[int, list[int], list[int]]:
+    """
+    Infer a regular cell grid separated by full rows/cols of the same line color.
+    Returns (step, row_divs, col_divs) where:
+      - row_divs/col_divs are divider indices
+      - step is the spacing between dividers (cell size including divider).
+    """
+    h, w = g.shape
+    line = int(g[0, 0])
+    row_divs = [r for r in range(h) if np.all(g[r, :] == line)]
+    col_divs = [c for c in range(w) if np.all(g[:, c] == line)]
+    assert len(row_divs) >= 2 and len(col_divs) >= 2, "need at least 2 row and 2 col dividers"
+    row_divs.sort()
+    col_divs.sort()
+    drs = [row_divs[i + 1] - row_divs[i] for i in range(len(row_divs) - 1) if row_divs[i + 1] > row_divs[i]]
+    dcs = [col_divs[i + 1] - col_divs[i] for i in range(len(col_divs) - 1) if col_divs[i + 1] > col_divs[i]]
+    step = reduce(gcd, drs + dcs)
+    assert step > 1, "divider step must be > 1"
+    assert row_divs[0] == 0 and col_divs[0] == 0, "first divider must be at index 0"
+    assert (h - 1) % step == 0 and (w - 1) % step == 0, "grid dimensions must be (k*step + 1)"
+    assert row_divs[-1] == h - 1 and col_divs[-1] == w - 1, "last divider must be at boundary"
+    return int(step), row_divs, col_divs
+
+
+def _symmetry_variants(arr: np.ndarray) -> list[np.ndarray]:
+    """Unique D4 transforms of a small 2D array."""
+    variants = []
+    seen = set()
+    for k in range(4):
+        rot = np.rot90(arr, k)
+        for cand in (rot, np.fliplr(rot)):
+            key = tuple(int(v) for v in cand.ravel())
+            if key not in seen:
+                seen.add(key)
+                variants.append(cand.copy())
+    return variants
+
+
+def _canonical_shape(mask: np.ndarray) -> tuple[int, ...]:
+    """D4-invariant signature for a boolean shape mask."""
+    return min(tuple(int(v) for v in cand.ravel()) for cand in _symmetry_variants(mask))
+
+
+def _pattern_key(arr: np.ndarray) -> tuple[int, ...]:
+    return tuple(int(v) for v in arr.ravel())
+
+
+def _is_connected(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if len(coords) == 0:
+        return False
+    start = tuple(int(v) for v in coords[0])
+    seen = {start}
+    stack = [start]
+    h, w = mask.shape
+    while stack:
+        r, c = stack.pop()
+        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                stack.append((nr, nc))
+    return len(seen) == int(mask.sum())
+
+
+def _dominant_shape(arr: np.ndarray) -> tuple[int, np.ndarray]:
+    """Return the unique most frequent color and its connected shape mask."""
+    vals, cnts = np.unique(arr, return_counts=True)
+    order = np.argsort(-cnts)
+    assert len(order) >= 2 and cnts[order[0]] > cnts[order[1]], "dominant color must be unique"
+    color = int(vals[order[0]])
+    mask = arr == color
+    assert _is_connected(mask), "dominant color must form one connected component"
+    return color, mask
+
+
+MAJORITY_SIG = _canonical_shape(MAJORITY_MASK)
+MAJORITY_MASK_VARIANTS = _symmetry_variants(MAJORITY_MASK)
+
+
+def _precompute_source_layouts() -> list[np.ndarray]:
+    """Catalog of tricolor legends whose dominant-color shape differs from the majority shape."""
+    layouts: list[np.ndarray] = []
+    for bits in range(3 ** (CELL_INNER * CELL_INNER)):
+        x = bits
+        arr = np.empty((CELL_INNER, CELL_INNER), dtype=int)
+        counts = [0, 0, 0]
+        for idx in range(CELL_INNER * CELL_INNER):
+            label = x % 3
+            x //= 3
+            arr[idx // CELL_INNER, idx % CELL_INNER] = label
+            counts[label] += 1
+
+        if counts != [4, 2, 3]:
+            continue
+
+        main_mask = arr == LABEL_MAIN
+        accent_mask = arr == LABEL_ACCENT
+        if not _is_connected(main_mask):
+            continue
+        if _canonical_shape(main_mask) == MAJORITY_SIG:
+            continue
+        if len({int(r) for r, _ in np.argwhere(main_mask)}) < 2:
+            continue
+        if len({int(c) for _, c in np.argwhere(main_mask)}) < 2:
+            continue
+        if len({int(r) for r, _ in np.argwhere(accent_mask)}) < 2:
+            continue
+        if len({int(c) for _, c in np.argwhere(accent_mask)}) < 2:
+            continue
+        if np.array_equal(arr, np.fliplr(arr)):
+            continue
+        if np.array_equal(arr, np.flipud(arr)):
+            continue
+        if np.array_equal(arr, np.rot90(arr)):
+            continue
+        if len({tuple(int(v) for v in arr[r, :]) for r in range(CELL_INNER)}) < 3:
+            continue
+        if len({tuple(int(v) for v in arr[:, c]) for c in range(CELL_INNER)}) < 2:
+            continue
+        layouts.append(arr)
+    assert layouts, "need at least one valid source layout"
+    return layouts
+
+
+SOURCE_LAYOUTS = _precompute_source_layouts()
+
+
+def _cell_origin(i: int, j: int) -> tuple[int, int]:
+    return i * CELL_STEP + 1, j * CELL_STEP + 1
+
+
+def _extract_cells(g: np.ndarray, step: int) -> list[list[np.ndarray]]:
+    n = (g.shape[0] - 1) // step
+    inner = step - 1
+    cells: list[list[np.ndarray]] = []
+    for i in range(n):
+        row: list[np.ndarray] = []
+        for j in range(n):
+            r0 = i * step + 1
+            c0 = j * step + 1
+            row.append(g[r0 : r0 + inner, c0 : c0 + inner].copy())
+        cells.append(row)
+    return cells
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Complete a fractal legend whose special cells are identified by geometric shape rather than exact pixels.
+
+    Input structure:
+    - The board is a 7x7 lattice of 3x3 cell interiors separated by one-color divider lines.
+    - Most cells belong to one shape class: they share the same dominant connected geometry, but vary by rotation and background colors.
+    - A few cells belong to a rarer shape class; those cells are identical tricolor legends.
+    - Some cells from the common shape class use a second dominant color and act as auxiliary clues.
+
+    Rule:
+    - Reduce every cell to the mask of its unique dominant connected color and count canonical shape classes up to rotation/flip.
+    - Take the rarer shape class as the source class and read one of its tricolor cells as a 3x3 legend.
+    - The legend's dominant color marks where source cells should appear, one secondary color marks where auxiliary cells should appear, and the remaining color means keep the existing majority cell.
+    - Use the observed source-shape cells plus the observed auxiliary-color cells to locate the unique 3x3 macro placement, then fill in the missing source and auxiliary cells.
+
+    Key insight:
+    - The anomaly is only visible after abstracting away color decoration into shape classes; once that rare shape is found, its three internal colors become a macro-scale instruction sheet with three different outcomes instead of a binary mask.
+    """
+    g = np.asarray(grid, dtype=int)
+    step, _, _ = _infer_cell_grid_params(g)
+    n = (g.shape[0] - 1) // step
+    inner = step - 1
+
+    cell_arrs = _extract_cells(g, step)
+    shape_sig: list[list[tuple[int, ...]]] = []
+    dom_colors: list[list[int]] = []
+    for i in range(n):
+        sig_row: list[tuple[int, ...]] = []
+        dom_row: list[int] = []
+        for j in range(n):
+            color, mask = _dominant_shape(cell_arrs[i][j])
+            sig_row.append(_canonical_shape(mask))
+            dom_row.append(color)
+        shape_sig.append(sig_row)
+        dom_colors.append(dom_row)
+
+    sig_counts: dict[tuple[int, ...], int] = {}
+    for i in range(n):
+        for j in range(n):
+            sig = shape_sig[i][j]
+            sig_counts[sig] = sig_counts.get(sig, 0) + 1
+    assert len(sig_counts) == 2, "expected exactly two canonical shape classes"
+
+    source_sig = min(sig_counts.items(), key=lambda kv: kv[1])[0]
+
+    source_arr = None
+    source_cells: list[tuple[int, int]] = []
+    common_dom_counts: dict[int, int] = {}
+    common_cells: list[tuple[int, int, np.ndarray, int]] = []
+    for i in range(n):
+        for j in range(n):
+            arr = cell_arrs[i][j]
+            dom = dom_colors[i][j]
+            if shape_sig[i][j] == source_sig:
+                source_cells.append((i, j))
+                if source_arr is None:
+                    source_arr = arr
+                else:
+                    assert np.array_equal(arr, source_arr), "source-shape clues must share one legend pattern"
+            else:
+                common_cells.append((i, j, arr, dom))
+                common_dom_counts[dom] = common_dom_counts.get(dom, 0) + 1
+
+    assert source_arr is not None, "need a source legend"
+    source_colors = {int(v) for v in np.unique(source_arr)}
+    assert len(source_colors) == 3, "source legend must be tricolor"
+
+    main_color, source_mask = _dominant_shape(source_arr)
+    assert _canonical_shape(source_mask) == source_sig, "source legend dominant shape must define the rare class"
+
+    dom_rank = sorted(common_dom_counts.items(), key=lambda kv: kv[1], reverse=True)
+    assert len(dom_rank) == 2, "common shape class must expose shared and accent dominant colors"
+    shared_color = int(dom_rank[0][0])
+    accent_color = int(dom_rank[1][0])
+    assert source_colors == {main_color, shared_color, accent_color}, "legend colors must match macro cell roles"
+
+    accent_arr = None
+    accent_cells: list[tuple[int, int]] = []
+    for i, j, arr, dom in common_cells:
+        if dom == accent_color:
+            accent_cells.append((i, j))
+            if accent_arr is None:
+                accent_arr = arr
+            else:
+                assert np.array_equal(arr, accent_arr), "accent clues must use one fixed auxiliary pattern"
+    assert accent_arr is not None and accent_cells, "need at least one accent clue"
+
+    candidates: list[tuple[int, int]] = []
+    for top in range(PLACEMENT_RANGE):
+        for left in range(PLACEMENT_RANGE):
+            valid = True
+            for i, j in source_cells:
+                if not (top <= i < top + inner and left <= j < left + inner):
+                    valid = False
+                    break
+                if int(source_arr[i - top, j - left]) != main_color:
+                    valid = False
+                    break
+            if not valid:
+                continue
+            for i, j in accent_cells:
+                if not (top <= i < top + inner and left <= j < left + inner):
+                    valid = False
+                    break
+                if int(source_arr[i - top, j - left]) != accent_color:
+                    valid = False
+                    break
+            if valid:
+                candidates.append((top, left))
+
+    assert len(candidates) == 1, "must have a unique legend placement"
+    top, left = candidates[0]
+
+    out = g.copy()
+    for i in range(inner):
+        for j in range(inner):
+            color = int(source_arr[i, j])
+            if color == shared_color:
+                continue
+            target = source_arr if color == main_color else accent_arr
+            paste(out, target, *_cell_origin(top + i, left + j))
+    return out
+
+
+def _build_source_pattern(layout: np.ndarray, main_color: int, shared_color: int, accent_color: int) -> np.ndarray:
+    palette = np.array([main_color, shared_color, accent_color], dtype=int)
+    return palette[layout]
+
+
+def _majority_variants(shared_color: int, bg_a: int, bg_b: int) -> list[np.ndarray]:
+    """Many exact majority bitmaps sharing one canonical geometry."""
+    variants: list[np.ndarray] = []
+    seen = set()
+    for mask in MAJORITY_MASK_VARIANTS:
+        gaps = [tuple(int(v) for v in coord) for coord in np.argwhere(~mask)]
+        for assignment in product((bg_a, bg_b), repeat=len(gaps)):
+            arr = np.full((CELL_INNER, CELL_INNER), shared_color, dtype=int)
+            for (r, c), color in zip(gaps, assignment):
+                arr[r, c] = int(color)
+            key = _pattern_key(arr)
+            if key not in seen:
+                seen.add(key)
+                variants.append(arr)
+    assert len(variants) >= CELL_GRID_N * CELL_GRID_N, "need enough unique majority variants"
+    return variants
+
+
+def _choose_accent_pattern(shared_color: int, accent_color: int, bg_a: int, bg_b: int) -> np.ndarray:
+    mask = random.choice(MAJORITY_MASK_VARIANTS)
+    gap_choices = [bg_a, bg_b]
+    while True:
+        assignment = [random.choice(gap_choices) for _ in range(int((~mask).sum()))]
+        if len(set(assignment)) >= 1:
+            arr = np.full((CELL_INNER, CELL_INNER), accent_color, dtype=int)
+            for (r, c), color in zip(np.argwhere(~mask), assignment):
+                arr[int(r), int(c)] = int(color)
+            return arr
+
+
+def _build_grid(separator: int, cell_patterns: list[list[np.ndarray]]) -> np.ndarray:
+    grid = np.full((GRID_SIZE, GRID_SIZE), separator, dtype=int)
+    for i in range(CELL_GRID_N):
+        for j in range(CELL_GRID_N):
+            paste(grid, cell_patterns[i][j], *_cell_origin(i, j))
+    return grid
+
+
+def _placement_candidates(layout: np.ndarray, observed: list[tuple[int, int, int]]) -> list[tuple[int, int]]:
+    candidates: list[tuple[int, int]] = []
+    for top in range(PLACEMENT_RANGE):
+        for left in range(PLACEMENT_RANGE):
+            ok = True
+            for abs_r, abs_c, label in observed:
+                if not (top <= abs_r < top + CELL_INNER and left <= abs_c < left + CELL_INNER):
+                    ok = False
+                    break
+                if int(layout[abs_r - top, abs_c - left]) != label:
+                    ok = False
+                    break
+            if ok:
+                candidates.append((top, left))
+    return candidates
+
+
+def _choose_given_subset(layout: np.ndarray, top: int, left: int) -> list[tuple[int, int, int]] | None:
+    informative = [
+        (top + r, left + c, int(layout[r, c]))
+        for r in range(CELL_INNER)
+        for c in range(CELL_INNER)
+        if int(layout[r, c]) != LABEL_SHARED
+    ]
+    total_main = int(np.sum(layout == LABEL_MAIN))
+    total_accent = int(np.sum(layout == LABEL_ACCENT))
+
+    sizes = list(GIVEN_CELL_SIZES)
+    random.shuffle(sizes)
+    for size in sizes:
+        valid: list[list[tuple[int, int, int]]] = []
+        for subset in combinations(informative, size):
+            main_seen = sum(1 for _, _, label in subset if label == LABEL_MAIN)
+            accent_seen = sum(1 for _, _, label in subset if label == LABEL_ACCENT)
+            if main_seen < 2 or accent_seen < 2:
+                continue
+            if main_seen >= total_main or accent_seen >= total_accent:
+                continue
+            if _placement_candidates(layout, list(subset)) == [(top, left)]:
+                valid.append(list(subset))
+        if valid:
+            return random.choice(valid)
+    return None
+
+
+def _gen_attempt() -> np.ndarray | None:
+    separator, main_color, shared_color, accent_color, bg_a, bg_b = random.sample(range(COLOR_POOL), 6)
+    layout = random.choice(SOURCE_LAYOUTS)
+    source = _build_source_pattern(layout, main_color, shared_color, accent_color)
+    accent = _choose_accent_pattern(shared_color, accent_color, bg_a, bg_b)
+    majority_bank = _majority_variants(shared_color, bg_a, bg_b)
+
+    chosen = random.sample(majority_bank, CELL_GRID_N * CELL_GRID_N)
+    cell_patterns: list[list[np.ndarray]] = []
+    idx = 0
+    for _ in range(CELL_GRID_N):
+        row: list[np.ndarray] = []
+        for _ in range(CELL_GRID_N):
+            row.append(chosen[idx].copy())
+            idx += 1
+        cell_patterns.append(row)
+
+    top = random.randrange(PLACEMENT_RANGE)
+    left = random.randrange(PLACEMENT_RANGE)
+
+    out_cells = [[cell_patterns[i][j].copy() for j in range(CELL_GRID_N)] for i in range(CELL_GRID_N)]
+    for r in range(CELL_INNER):
+        for c in range(CELL_INNER):
+            label = int(layout[r, c])
+            if label == LABEL_MAIN:
+                out_cells[top + r][left + c] = source.copy()
+            elif label == LABEL_ACCENT:
+                out_cells[top + r][left + c] = accent.copy()
+    out = _build_grid(separator, out_cells)
+
+    subset = _choose_given_subset(layout, top, left)
+    if subset is None:
+        return None
+
+    inp_cells = [[cell_patterns[i][j].copy() for j in range(CELL_GRID_N)] for i in range(CELL_GRID_N)]
+    for r, c, label in subset:
+        inp_cells[r][c] = source.copy() if label == LABEL_MAIN else accent.copy()
+    inp = _build_grid(separator, inp_cells)
+
+    try:
+        solved = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(solved, out):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid b99e7126 combo input")

