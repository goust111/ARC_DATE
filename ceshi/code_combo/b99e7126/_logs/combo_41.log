MASK_SIZE = 3
PLACEMENT_RANGE = CELL_GRID_N - MASK_SIZE + 1
ACTIVE_PIXEL_COUNTS = (6, 7)
GIVEN_CELL_SIZES = [3, 4]
COLOR_POOL = 10
MAX_RETRIES = 300

# LR-symmetric pixel groups: pairs share left/right, singletons sit on center col.
_LR_GROUPS = [
    ((0, 0), (0, 2)),
