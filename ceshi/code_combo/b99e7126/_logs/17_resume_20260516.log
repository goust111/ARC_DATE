+# Combo variant of b99e7126 (index 17)
+# combo_spec: D6/0+D12/1
+# Name: 行间镜像对称 + 棋盘式双图案
+
+from functools import reduce
+from itertools import combinations
+from math import gcd
+
+import numpy as np
+import random
+
+from arc_utils import paste
+
+
+# Design analysis for the combo variant D6/0 + D12/1
+# a) Concrete behavior:
+#    The original task had one background tile repeated everywhere, plus a rare anomaly tile whose
+#    own 3x3 pixels describe the macro-level anomaly placement. In this combo the 7x7 cell lattice
+#    has two interacting regularities:
+#    - checkerboard alternation between canonical tile A and canonical tile B
+#    - odd rows are horizontal mirrors of the even-row tiles
+#    So the visible background literals are A / B on even rows and fliplr(A) / fliplr(B) on odd
+#    rows. Example trace: if cell (2,3) is canonical-B, then cell (3,3) must be fliplr(A) because
+#    moving down flips row parity and checkerboard parity simultaneously. The anomaly tile C still
+#    expands into a 3x3 macro-block, but every inactive macro position must now restore whichever of
+#    those four background literals belongs there. The difference from the source task is therefore
+#    not "fill with one majority tile", but "reconstruct a 2D alternating field whose odd rows are
+#    mirrored copies of the even rows".
+# b) Complexity calibration:
+#    Keep the original geometry: 29x29 full grid, 7x7 cell lattice, 3x3 cell interiors, 3x3 anomaly
+#    mask, and 3-4 given anomaly cells. The background uses exactly two semantic motifs and one
+#    mirror rule, producing four literal tiles. That is visually richer than the original but still
+#    compact enough for humans to infer from 2-4 examples. Generator rejects symmetric base motifs so
+#    the row-mirror rule is always visible instead of collapsing back to plain checkerboard tiling.
+# c) Hidden assumptions broken from the old solver:
+#    - "one majority pattern exists" is false: there are four literal background tiles.
+#    - "the most common tile is the background tile to paste into every inactive slot" is false.
+#    - "background identity depends only on checkerboard parity" is also false after D12/1; row
+#      parity matters because odd rows use horizontal mirrors.
+#    The new solver therefore keeps the anomaly-placement logic, but infers an ordered canonical pair
+#    for even rows and scores every non-anomaly cell against the coupled checkerboard+mirror law.
+# d) Placement legality:
+#    The anomaly macro-block still occupies one 3x3 window inside the 7x7 cell grid, so offsets stay
+#    in 0..4. Cells never overlap because each cell interior is disjoint between divider lines. The
+#    generator chooses only masks and anomaly subsets whose placement is unique under the original
+#    macro-mask search, then verifies solver(output) exactly matches the intended completion.
+# e) Visual observability:
+#    A and B are asymmetric and differ from each other by several pixels, so their mirrored odd-row
+#    versions are visibly different too. Accepted masks must leave inactive positions on both local
+#    row parities and both checkerboard parities, ensuring the completed 3x3 macro-block visibly
+#    contains more than one background literal. Given anomaly cells must also span both local row
+#    parities and both checkerboard parities, so the input already shows the same anomaly tile
+#    violating the mirrored background on multiple row/column contexts.
+# f) Visual cleanliness:
+#    Each cell still contains exactly one 3x3 pattern: one of the four background literals or the
+#    anomaly tile. No extra markers or overlays are added; only the chosen cell interiors change.
+#    Divider lines remain untouched, so the lattice stays as legible as the source task.
+# g) Color inference:
+#    Keep the original 4-color budget: separator + shared + background-exclusive + anomaly-exclusive.
+#    A/B and their row mirrors use {shared, background-exclusive}; the anomaly tile uses
+#    {shared, anomaly-exclusive}. This gives strong structural cues without forcing the solver to rely
+#    on absolute color ids or on any hidden ordering of colors.
+
+
+def _infer_cell_grid_params(g: np.ndarray) -> tuple[int, list[int], list[int]]:
+    """
+    Infer a regular cell grid separated by full rows/cols of the same line color.
+    Returns (step, row_divs, col_divs) where:
+      - row_divs/col_divs are divider indices
+      - step is the spacing between dividers (cell size including divider).
+    """
+    h, w = g.shape
+    line = int(g[0, 0])
+    row_divs = [r for r in range(h) if np.all(g[r, :] == line)]
+    col_divs = [c for c in range(w) if np.all(g[:, c] == line)]
+    assert len(row_divs) >= 2 and len(col_divs) >= 2, "need at least 2 row and 2 col dividers"
+    row_divs.sort()
+    col_divs.sort()
+    drs = [row_divs[i + 1] - row_divs[i] for i in range(len(row_divs) - 1) if row_divs[i + 1] > row_divs[i]]
+    dcs = [col_divs[i + 1] - col_divs[i] for i in range(len(col_divs) - 1) if col_divs[i + 1] > col_divs[i]]
+    step = reduce(gcd, drs + dcs)
+    assert step > 1, "divider step must be > 1"
+    assert row_divs[0] == 0 and col_divs[0] == 0, "first divider must be at index 0"
+    assert (h - 1) % step == 0 and (w - 1) % step == 0, "grid dimensions must be (k*step + 1)"
+    assert row_divs[-1] == h - 1 and col_divs[-1] == w - 1, "last divider must be at boundary"
+    return int(step), row_divs, col_divs
+
+
+def _extract_cell_patterns(
+    g: np.ndarray, step: int
+) -> tuple[int, int, dict[tuple[int, ...], np.ndarray], list[list[tuple[int, ...]]]]:
+    n = (g.shape[0] - 1) // step
+    inner = step - 1
+    patterns: dict[tuple[int, ...], np.ndarray] = {}
+    cell_pat: list[list[tuple[int, ...]]] = []
+    for i in range(n):
+        row: list[tuple[int, ...]] = []
+        for j in range(n):
+            r0 = i * step + 1
+            c0 = j * step + 1
+            pat_arr = g[r0 : r0 + inner, c0 : c0 + inner].copy()
+            pat = tuple(int(v) for v in pat_arr.ravel())
+            if pat not in patterns:
+                patterns[pat] = pat_arr
+            row.append(pat)
+        cell_pat.append(row)
+    return n, inner, patterns, cell_pat
+
+
+def _flipped_key(arr: np.ndarray) -> tuple[int, ...]:
+    return tuple(int(v) for v in np.fliplr(arr).ravel())
+
+
+def _expected_literal(
+    even_type0: tuple[int, ...],
+    even_type1: tuple[int, ...],
+    flip_map: dict[tuple[int, ...], tuple[int, ...]],
+    i: int,
+    j: int,
+) -> tuple[int, ...]:
+    base = even_type0 if (i + j) % 2 == 0 else even_type1
+    return base if i % 2 == 0 else flip_map[base]
+
+
+def _checker_mirror_score(
+    cell_pat: list[list[tuple[int, ...]]],
+    anomaly_pat: tuple[int, ...],
+    even_type0: tuple[int, ...],
+    even_type1: tuple[int, ...],
+    flip_map: dict[tuple[int, ...], tuple[int, ...]],
+) -> int:
+    mismatches = 0
+    for i, row in enumerate(cell_pat):
+        for j, pat in enumerate(row):
+            if pat == anomaly_pat:
+                continue
+            mismatches += int(pat != _expected_literal(even_type0, even_type1, flip_map, i, j))
+    return mismatches
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Complete a fractal anomaly overlay on top of a mirrored checkerboard cell field.
+
+    Input structure:
+    - Grid divided into NxN cells by single-color separator lines.
+    - Background cells follow two coupled rules: checkerboard alternation between two canonical 3x3
+      motifs, and horizontal mirroring on every odd cell row.
+    - A few cells show one rarer third motif; these are the anomaly samples.
+
+    Rule:
+    - Treat the anomaly tile's most frequent color as active and read its 3x3 interior as a binary
+      placement mask.
+    - Locate the unique 3x3 macro-position whose active entries contain all shown anomaly cells.
+    - Fill every active macro-cell with the anomaly tile and every inactive macro-cell with the
+      background literal implied by both checkerboard parity and row-mirror parity.
+
+    Key insight: The rare tile still self-encodes the missing macro pattern, but solving now also
+    requires reconstructing a four-state background made from two canonical motifs plus odd-row
+    horizontal mirroring.
+    """
+    g = np.asarray(grid, dtype=int)
+    step, _, _ = _infer_cell_grid_params(g)
+    n, inner, patterns, cell_pat = _extract_cell_patterns(g, step)
+
+    counts: dict[tuple[int, ...], int] = {}
+    for row in cell_pat:
+        for pat in row:
+            counts[pat] = counts.get(pat, 0) + 1
+    assert len(counts) == 5, "combo expects 4 background literals plus 1 anomaly literal"
+
+    anomaly_pat = min(counts.items(), key=lambda kv: kv[1])[0]
+    background_pats = [pat for pat in counts if pat != anomaly_pat]
+    background_set = set(background_pats)
+
+    flip_map = {pat: _flipped_key(patterns[pat]) for pat in background_pats}
+    assignments: list[tuple[int, tuple[int, ...], tuple[int, ...]]] = []
+    for even_type0 in background_pats:
+        flip0 = flip_map[even_type0]
+        if flip0 not in background_set or flip0 == even_type0:
+            continue
+        for even_type1 in background_pats:
+            if even_type1 == even_type0:
+                continue
+            flip1 = flip_map[even_type1]
+            if flip1 not in background_set or flip1 == even_type1:
+                continue
+            if len({even_type0, even_type1, flip0, flip1}) != 4:
+                continue
+            score = _checker_mirror_score(cell_pat, anomaly_pat, even_type0, even_type1, flip_map)
+            assignments.append((score, even_type0, even_type1))
+
+    assert assignments, "failed to find any checkerboard+mirror interpretation"
+    assignments.sort(key=lambda item: item[0])
+    best_score, even_type0, even_type1 = assignments[0]
+    assert best_score == 0, "background cells must fit the mirrored checkerboard exactly"
+    assert len([a for a in assignments if a[0] == 0]) == 1, "background interpretation must be unique"
+
+    anomaly_arr = patterns[anomaly_pat]
+    vals, cnts = np.unique(anomaly_arr, return_counts=True)
+    active_color = int(vals[cnts.argmax()])
+    mask = anomaly_arr == active_color
+    mh, mw = mask.shape
+
+    existing = np.zeros((n, n), dtype=bool)
+    for i in range(n):
+        for j in range(n):
+            existing[i, j] = cell_pat[i][j] == anomaly_pat
+
+    candidates: list[tuple[int, int]] = []
+    for top in range(n - mh + 1):
+        for left in range(n - mw + 1):
+            block = np.zeros_like(existing)
+            block[top : top + mh, left : left + mw] = True
+            if np.any(existing & ~block):
+                continue
+            ex_block = existing[top : top + mh, left : left + mw]
+            if np.any(ex_block & ~mask):
+                continue
+            candidates.append((int(top), int(left)))
+    assert len(candidates) == 1, "anomaly mask placement must be uniquely determined"
+    top, left = candidates[0]
+
+    out = g.copy()
+    for i in range(mh):
+        for j in range(mw):
+            abs_i = top + i
+            abs_j = left + j
+            if mask[i, j]:
+                target_pat = anomaly_arr
+            else:
+                literal = _expected_literal(even_type0, even_type1, flip_map, abs_i, abs_j)
+                target_pat = patterns[literal]
+            r0 = abs_i * step + 1
+            c0 = abs_j * step + 1
+            out[r0 : r0 + inner, c0 : c0 + inner] = target_pat
+    return out
+
+
+# --------------- generator (o5x) ---------------
+
+CELL_GRID_N = 7
+CELL_INNER = 3
+CELL_STEP = 4
+GRID_SIZE = 29
+MASK_SIZE = 3
+PLACEMENT_RANGE = CELL_GRID_N - MASK_SIZE + 1
+ACTIVE_PIXEL_COUNTS = (6, 7)
+GIVEN_CELL_SIZES = [3, 4]
+COLOR_POOL = 10
+MAX_RETRIES = 500
+
+_BASE_SEEDS = [
+    np.array([[1, 1, 0], [0, 1, 0], [1, 0, 0]], dtype=bool),
+    np.array([[1, 0, 0], [1, 1, 0], [0, 1, 1]], dtype=bool),
+    np.array([[0, 1, 1], [1, 0, 1], [0, 0, 1]], dtype=bool),
+]
+
+
+def _mask_key(mask: np.ndarray) -> tuple[int, ...]:
+    return tuple(int(v) for v in mask.ravel())
+
+
+def _coord_row_parities(coords: tuple[tuple[int, int], ...] | list[tuple[int, int]]) -> set[int]:
+    return {r % 2 for r, _ in coords}
+
+
+def _coord_checker_parities(coords: tuple[tuple[int, int], ...] | list[tuple[int, int]]) -> set[int]:
+    return {(r + c) % 2 for r, c in coords}
+
+
+def _precompute_masks() -> dict[int, list[np.ndarray]]:
+    """
+    Enumerate salient anomaly masks.
+
+    Requirements:
+    - active count is 6 or 7
+    - active cells touch all four edges
+    - mask is not LR-symmetric, so the anomaly does not itself mimic the row-mirror law
+    - active and inactive positions both span local row parities and checkerboard parities
+    """
+    by_count: dict[int, list[np.ndarray]] = {}
+    for active_count in ACTIVE_PIXEL_COUNTS:
+        masks: list[np.ndarray] = []
+        for combo in combinations(range(MASK_SIZE * MASK_SIZE), active_count):
+            mask = np.zeros((MASK_SIZE, MASK_SIZE), dtype=bool)
+            for idx in combo:
+                mask[idx // MASK_SIZE, idx % MASK_SIZE] = True
+            active = [tuple(coord) for coord in np.argwhere(mask)]
+            inactive = [tuple(coord) for coord in np.argwhere(~mask)]
+            if np.array_equal(mask, np.fliplr(mask)):
+                continue
+            if not (mask[0, :].any() and mask[2, :].any() and mask[:, 0].any() and mask[:, 2].any()):
+                continue
+            if len(_coord_row_parities(active)) != 2 or len(_coord_checker_parities(active)) != 2:
+                continue
+            if len(_coord_row_parities(inactive)) != 2 or len(_coord_checker_parities(inactive)) != 2:
+                continue
+            masks.append(mask)
+        by_count[active_count] = masks
+    return by_count
+
+
+def _precompute_base_masks() -> list[np.ndarray]:
+    """Build a catalog of asymmetric 3x3 motifs whose horizontal mirrors are visibly different."""
+    seen: set[tuple[int, ...]] = set()
+    catalog: list[np.ndarray] = []
+    for seed in _BASE_SEEDS:
+        variants = [
+            seed,
+            np.rot90(seed, 1),
+            np.rot90(seed, 2),
+            np.rot90(seed, 3),
+            np.flipud(seed),
+            np.fliplr(seed),
+        ]
+        for variant in variants:
+            if np.array_equal(variant, np.fliplr(variant)):
+                continue
+            key = _mask_key(variant)
+            if key in seen:
+                continue
+            seen.add(key)
+            catalog.append(variant.copy())
+    return catalog
+
+
+_MASKS_BY_COUNT = _precompute_masks()
+_BASE_MASKS = _precompute_base_masks()
+
+
+def _random_anomaly_mask() -> np.ndarray:
+    active_count = random.choice(ACTIVE_PIXEL_COUNTS)
+    return random.choice(_MASKS_BY_COUNT[active_count])
+
+
+def _random_canonical_pair(shared: int, base_exclusive: int) -> tuple[np.ndarray, np.ndarray]:
+    for _ in range(100):
+        mask_a, mask_b = random.sample(_BASE_MASKS, 2)
+        keys = {
+            _mask_key(mask_a),
+            _mask_key(mask_b),
+            _mask_key(np.fliplr(mask_a)),
+            _mask_key(np.fliplr(mask_b)),
+        }
+        if len(keys) != 4:
+            continue
+        if np.count_nonzero(mask_a != mask_b) < 3:
+            continue
+        if np.count_nonzero(mask_a != np.fliplr(mask_a)) < 2:
+            continue
+        if np.count_nonzero(mask_b != np.fliplr(mask_b)) < 2:
+            continue
+        arr_a = np.where(mask_a, base_exclusive, shared).astype(int)
+        arr_b = np.where(mask_b, base_exclusive, shared).astype(int)
+        return arr_a, arr_b
+    raise RuntimeError("failed to choose a visible checkerboard mirror pair")
+
+
+def _placement_candidates(
+    mask: np.ndarray, subset: tuple[tuple[int, int], ...], top: int, left: int
+) -> list[tuple[int, int]]:
+    existing = np.zeros((CELL_GRID_N, CELL_GRID_N), dtype=bool)
+    for r, c in subset:
+        existing[top + r, left + c] = True
+
+    candidates = []
+    for t in range(PLACEMENT_RANGE):
+        for l in range(PLACEMENT_RANGE):
+            block = np.zeros((CELL_GRID_N, CELL_GRID_N), dtype=bool)
+            block[t : t + MASK_SIZE, l : l + MASK_SIZE] = True
+            if np.any(existing & ~block):
+                continue
+            if np.any(existing[t : t + MASK_SIZE, l : l + MASK_SIZE] & ~mask):
+                continue
+            candidates.append((t, l))
+    return candidates
+
+
+def _subset_is_salient(subset: tuple[tuple[int, int], ...]) -> bool:
+    return len(_coord_row_parities(subset)) == 2 and len(_coord_checker_parities(subset)) == 2
+
+
+def _choose_given_subset(mask: np.ndarray, top: int, left: int) -> tuple[tuple[int, int], ...] | None:
+    active = [tuple(coord) for coord in np.argwhere(mask)]
+    sizes = list(GIVEN_CELL_SIZES)
+    random.shuffle(sizes)
+    for size in sizes:
+        valid = [
+            subset
+            for subset in combinations(active, size)
+            if _subset_is_salient(subset) and _placement_candidates(mask, subset, top, left) == [(top, left)]
+        ]
+        if valid:
+            return random.choice(valid)
+    return None
+
+
+def _cell_origin(i: int, j: int) -> tuple[int, int]:
+    return i * CELL_STEP + 1, j * CELL_STEP + 1
+
+
+def _background_literal(
+    even_type0: np.ndarray, even_type1: np.ndarray, odd_type0: np.ndarray, odd_type1: np.ndarray, i: int, j: int
+) -> np.ndarray:
+    if i % 2 == 0:
+        return even_type0 if (i + j) % 2 == 0 else even_type1
+    return odd_type0 if (i + j) % 2 == 0 else odd_type1
+
+
+def _build_grid(
+    separator: int,
+    even_type0: np.ndarray,
+    even_type1: np.ndarray,
+    anomaly_pat: np.ndarray,
+    active_cells: list[tuple[int, int]],
+) -> np.ndarray:
+    odd_type0 = np.fliplr(even_type0)
+    odd_type1 = np.fliplr(even_type1)
+    grid = np.full((GRID_SIZE, GRID_SIZE), separator, dtype=int)
+    for i in range(CELL_GRID_N):
+        for j in range(CELL_GRID_N):
+            paste(grid, _background_literal(even_type0, even_type1, odd_type0, odd_type1, i, j), *_cell_origin(i, j))
+    for i, j in active_cells:
+        paste(grid, anomaly_pat, *_cell_origin(i, j))
+    return grid
+
+
+def _fusion_metrics(mask: np.ndarray, subset: tuple[tuple[int, int], ...]) -> dict[str, int]:
+    active = [tuple(coord) for coord in np.argwhere(mask)]
+    inactive = [tuple(coord) for coord in np.argwhere(~mask)]
+    return {
+        "active_row_parities": len(_coord_row_parities(active)),
+        "active_checker_parities": len(_coord_checker_parities(active)),
+        "inactive_row_parities": len(_coord_row_parities(inactive)),
+        "inactive_checker_parities": len(_coord_checker_parities(inactive)),
+        "given_row_parities": len(_coord_row_parities(subset)),
+        "given_checker_parities": len(_coord_checker_parities(subset)),
+    }
+
+
+def _generate_case():
+    separator, base_exclusive, shared, anomaly_exclusive = random.sample(range(COLOR_POOL), 4)
+    even_type0, even_type1 = _random_canonical_pair(shared, base_exclusive)
+    mask = _random_anomaly_mask()
+    anomaly_pat = np.where(mask, anomaly_exclusive, shared).astype(int)
+
+    top = random.randrange(PLACEMENT_RANGE)
+    left = random.randrange(PLACEMENT_RANGE)
+    active_cells = [(top + r, left + c) for r, c in np.argwhere(mask)]
+    out = _build_grid(separator, even_type0, even_type1, anomaly_pat, active_cells)
+
+    subset = _choose_given_subset(mask, top, left)
+    if subset is None:
+        return None
+    metrics = _fusion_metrics(mask, subset)
+    if min(metrics.values()) < 2:
+        return None
+
+    given_cells = [(top + r, left + c) for r, c in subset]
+    inp = _build_grid(separator, even_type0, even_type1, anomaly_pat, given_cells)
+
+    try:
+        solved = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(solved, out):
+        return None
+
+    return {
+        "input": inp,
+        "output": out,
+        "metrics": metrics,
+    }
+
+
+def generate_input():
+    for _ in range(MAX_RETRIES):
+        case = _generate_case()
+        if case is not None:
+            return case["input"]
+    raise RuntimeError("failed to generate a valid b99e7126 combo D6/0+D12/1 input")

diff --git a/ceshi/code_combo/b99e7126/17/code.py b/ceshi/code_combo/b99e7126/17/code.py
new file mode 100644
index 0000000000000000000000000000000000000000..cde6965b37e51d6f0be01e07cf8c4a263bc6a742
--- /dev/null
+++ b/ceshi/code_combo/b99e7126/17/code.py
@@ -0,0 +1,482 @@
+# Combo variant of b99e7126 (index 17)
+# combo_spec: D6/0+D12/1
+# Name: 行间镜像对称 + 棋盘式双图案
+
+from functools import reduce
+from itertools import combinations
+from math import gcd
+
+import numpy as np
+import random
+
+from arc_utils import paste
+
+
+# Design analysis for the combo variant D6/0 + D12/1
+# a) Concrete behavior:
+#    The original task had one background tile repeated everywhere, plus a rare anomaly tile whose
+#    own 3x3 pixels describe the macro-level anomaly placement. In this combo the 7x7 cell lattice
+#    has two interacting regularities:
+#    - checkerboard alternation between canonical tile A and canonical tile B
+#    - odd rows are horizontal mirrors of the even-row tiles
+#    So the visible background literals are A / B on even rows and fliplr(A) / fliplr(B) on odd
+#    rows. Example trace: if cell (2,3) is canonical-B, then cell (3,3) must be fliplr(A) because
+#    moving down flips row parity and checkerboard parity simultaneously. The anomaly tile C still
+#    expands into a 3x3 macro-block, but every inactive macro position must now restore whichever of
+#    those four background literals belongs there. The difference from the source task is therefore
+#    not "fill with one majority tile", but "reconstruct a 2D alternating field whose odd rows are
+#    mirrored copies of the even rows".
+# b) Complexity calibration:
+#    Keep the original geometry: 29x29 full grid, 7x7 cell lattice, 3x3 cell interiors, 3x3 anomaly
+#    mask, and 3-4 given anomaly cells. The background uses exactly two semantic motifs and one
+#    mirror rule, producing four literal tiles. That is visually richer than the original but still
+#    compact enough for humans to infer from 2-4 examples. Generator rejects symmetric base motifs so
+#    the row-mirror rule is always visible instead of collapsing back to plain checkerboard tiling.
+# c) Hidden assumptions broken from the old solver:
+#    - "one majority pattern exists" is false: there are four literal background tiles.
+#    - "the most common tile is the background tile to paste into every inactive slot" is false.
+#    - "background identity depends only on checkerboard parity" is also false after D12/1; row
+#      parity matters because odd rows use horizontal mirrors.
+#    The new solver therefore keeps the anomaly-placement logic, but infers an ordered canonical pair
+#    for even rows and scores every non-anomaly cell against the coupled checkerboard+mirror law.
+# d) Placement legality:
+#    The anomaly macro-block still occupies one 3x3 window inside the 7x7 cell grid, so offsets stay
+#    in 0..4. Cells never overlap because each cell interior is disjoint between divider lines. The
+#    generator chooses only masks and anomaly subsets whose placement is unique under the original
+#    macro-mask search, then verifies solver(output) exactly matches the intended completion.
+# e) Visual observability:
+#    A and B are asymmetric and differ from each other by several pixels, so their mirrored odd-row
+#    versions are visibly different too. Accepted masks must leave inactive positions on both local
+#    row parities and both checkerboard parities, ensuring the completed 3x3 macro-block visibly
+#    contains more than one background literal. Given anomaly cells must also span both local row
+#    parities and both checkerboard parities, so the input already shows the same anomaly tile
+#    violating the mirrored background on multiple row/column contexts.
+# f) Visual cleanliness:
+#    Each cell still contains exactly one 3x3 pattern: one of the four background literals or the
+#    anomaly tile. No extra markers or overlays are added; only the chosen cell interiors change.
+#    Divider lines remain untouched, so the lattice stays as legible as the source task.
+# g) Color inference:
+#    Keep the original 4-color budget: separator + shared + background-exclusive + anomaly-exclusive.
+#    A/B and their row mirrors use {shared, background-exclusive}; the anomaly tile uses
+#    {shared, anomaly-exclusive}. This gives strong structural cues without forcing the solver to rely
+#    on absolute color ids or on any hidden ordering of colors.
+
+
+def _infer_cell_grid_params(g: np.ndarray) -> tuple[int, list[int], list[int]]:
+    """
+    Infer a regular cell grid separated by full rows/cols of the same line color.
+    Returns (step, row_divs, col_divs) where:
+      - row_divs/col_divs are divider indices
+      - step is the spacing between dividers (cell size including divider).
+    """
+    h, w = g.shape
+    line = int(g[0, 0])
+    row_divs = [r for r in range(h) if np.all(g[r, :] == line)]
+    col_divs = [c for c in range(w) if np.all(g[:, c] == line)]
+    assert len(row_divs) >= 2 and len(col_divs) >= 2, "need at least 2 row and 2 col dividers"
+    row_divs.sort()
+    col_divs.sort()
+    drs = [row_divs[i + 1] - row_divs[i] for i in range(len(row_divs) - 1) if row_divs[i + 1] > row_divs[i]]
+    dcs = [col_divs[i + 1] - col_divs[i] for i in range(len(col_divs) - 1) if col_divs[i + 1] > col_divs[i]]
+    step = reduce(gcd, drs + dcs)
+    assert step > 1, "divider step must be > 1"
+    assert row_divs[0] == 0 and col_divs[0] == 0, "first divider must be at index 0"
+    assert (h - 1) % step == 0 and (w - 1) % step == 0, "grid dimensions must be (k*step + 1)"
+    assert row_divs[-1] == h - 1 and col_divs[-1] == w - 1, "last divider must be at boundary"
+    return int(step), row_divs, col_divs
+
+
+def _extract_cell_patterns(
+    g: np.ndarray, step: int
+) -> tuple[int, int, dict[tuple[int, ...], np.ndarray], list[list[tuple[int, ...]]]]:
+    n = (g.shape[0] - 1) // step
+    inner = step - 1
+    patterns: dict[tuple[int, ...], np.ndarray] = {}
+    cell_pat: list[list[tuple[int, ...]]] = []
+    for i in range(n):
+        row: list[tuple[int, ...]] = []
+        for j in range(n):
+            r0 = i * step + 1
+            c0 = j * step + 1
+            pat_arr = g[r0 : r0 + inner, c0 : c0 + inner].copy()
+            pat = tuple(int(v) for v in pat_arr.ravel())
+            if pat not in patterns:
+                patterns[pat] = pat_arr
+            row.append(pat)
+        cell_pat.append(row)
+    return n, inner, patterns, cell_pat
+
+
+def _flipped_key(arr: np.ndarray) -> tuple[int, ...]:
+    return tuple(int(v) for v in np.fliplr(arr).ravel())
+
+
+def _expected_literal(
+    even_type0: tuple[int, ...],
+    even_type1: tuple[int, ...],
+    flip_map: dict[tuple[int, ...], tuple[int, ...]],
+    i: int,
+    j: int,
+) -> tuple[int, ...]:
+    base = even_type0 if (i + j) % 2 == 0 else even_type1
+    return base if i % 2 == 0 else flip_map[base]
+
+
+def _checker_mirror_score(
+    cell_pat: list[list[tuple[int, ...]]],
+    anomaly_pat: tuple[int, ...],
+    even_type0: tuple[int, ...],
+    even_type1: tuple[int, ...],
+    flip_map: dict[tuple[int, ...], tuple[int, ...]],
+) -> int:
+    mismatches = 0
+    for i, row in enumerate(cell_pat):
+        for j, pat in enumerate(row):
+            if pat == anomaly_pat:
+                continue
+            mismatches += int(pat != _expected_literal(even_type0, even_type1, flip_map, i, j))
+    return mismatches
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Complete a fractal anomaly overlay on top of a mirrored checkerboard cell field.
+
+    Input structure:
+    - Grid divided into NxN cells by single-color separator lines.
+    - Background cells follow two coupled rules: checkerboard alternation between two canonical 3x3
+      motifs, and horizontal mirroring on every odd cell row.
+    - A few cells show one rarer third motif; these are the anomaly samples.
+
+    Rule:
+    - Treat the anomaly tile's most frequent color as active and read its 3x3 interior as a binary
+      placement mask.
+    - Locate the unique 3x3 macro-position whose active entries contain all shown anomaly cells.
+    - Fill every active macro-cell with the anomaly tile and every inactive macro-cell with the
+      background literal implied by both checkerboard parity and row-mirror parity.
+
+    Key insight: The rare tile still self-encodes the missing macro pattern, but solving now also
+    requires reconstructing a four-state background made from two canonical motifs plus odd-row
+    horizontal mirroring.
+    """
+    g = np.asarray(grid, dtype=int)
+    step, _, _ = _infer_cell_grid_params(g)
+    n, inner, patterns, cell_pat = _extract_cell_patterns(g, step)
+
+    counts: dict[tuple[int, ...], int] = {}
+    for row in cell_pat:
+        for pat in row:
+            counts[pat] = counts.get(pat, 0) + 1
+    assert len(counts) == 5, "combo expects 4 background literals plus 1 anomaly literal"
+
+    anomaly_pat = min(counts.items(), key=lambda kv: kv[1])[0]
+    background_pats = [pat for pat in counts if pat != anomaly_pat]
+    background_set = set(background_pats)
+
+    flip_map = {pat: _flipped_key(patterns[pat]) for pat in background_pats}
+    assignments: list[tuple[int, tuple[int, ...], tuple[int, ...]]] = []
+    for even_type0 in background_pats:
+        flip0 = flip_map[even_type0]
+        if flip0 not in background_set or flip0 == even_type0:
+            continue
+        for even_type1 in background_pats:
+            if even_type1 == even_type0:
+                continue
+            flip1 = flip_map[even_type1]
+            if flip1 not in background_set or flip1 == even_type1:
+                continue
+            if len({even_type0, even_type1, flip0, flip1}) != 4:
+                continue
+            score = _checker_mirror_score(cell_pat, anomaly_pat, even_type0, even_type1, flip_map)
+            assignments.append((score, even_type0, even_type1))
+
+    assert assignments, "failed to find any checkerboard+mirror interpretation"
+    assignments.sort(key=lambda item: item[0])
+    best_score, even_type0, even_type1 = assignments[0]
+    assert best_score == 0, "background cells must fit the mirrored checkerboard exactly"
+    assert len([a for a in assignments if a[0] == 0]) == 1, "background interpretation must be unique"
+
+    anomaly_arr = patterns[anomaly_pat]
+    vals, cnts = np.unique(anomaly_arr, return_counts=True)
+    active_color = int(vals[cnts.argmax()])
+    mask = anomaly_arr == active_color
+    mh, mw = mask.shape
+
+    existing = np.zeros((n, n), dtype=bool)
+    for i in range(n):
+        for j in range(n):
+            existing[i, j] = cell_pat[i][j] == anomaly_pat
+
+    candidates: list[tuple[int, int]] = []
+    for top in range(n - mh + 1):
+        for left in range(n - mw + 1):
+            block = np.zeros_like(existing)
+            block[top : top + mh, left : left + mw] = True
+            if np.any(existing & ~block):
+                continue
+            ex_block = existing[top : top + mh, left : left + mw]
+            if np.any(ex_block & ~mask):
+                continue
+            candidates.append((int(top), int(left)))
+    assert len(candidates) == 1, "anomaly mask placement must be uniquely determined"
+    top, left = candidates[0]
+
+    out = g.copy()
+    for i in range(mh):
+        for j in range(mw):
+            abs_i = top + i
+            abs_j = left + j
+            if mask[i, j]:
+                target_pat = anomaly_arr
+            else:
+                literal = _expected_literal(even_type0, even_type1, flip_map, abs_i, abs_j)
+                target_pat = patterns[literal]
+            r0 = abs_i * step + 1
+            c0 = abs_j * step + 1
+            out[r0 : r0 + inner, c0 : c0 + inner] = target_pat
+    return out
+
+
+# --------------- generator (o5x) ---------------
+
+CELL_GRID_N = 7
+CELL_INNER = 3
+CELL_STEP = 4
+GRID_SIZE = 29
+MASK_SIZE = 3
+PLACEMENT_RANGE = CELL_GRID_N - MASK_SIZE + 1
+ACTIVE_PIXEL_COUNTS = (6, 7)
+GIVEN_CELL_SIZES = [3, 4]
+COLOR_POOL = 10
+MAX_RETRIES = 500
+
+_BASE_SEEDS = [
+    np.array([[1, 1, 0], [0, 1, 0], [1, 0, 0]], dtype=bool),
+    np.array([[1, 0, 0], [1, 1, 0], [0, 1, 1]], dtype=bool),
+    np.array([[0, 1, 1], [1, 0, 1], [0, 0, 1]], dtype=bool),
+]
+
+
+def _mask_key(mask: np.ndarray) -> tuple[int, ...]:
+    return tuple(int(v) for v in mask.ravel())
+
+
+def _coord_row_parities(coords: tuple[tuple[int, int], ...] | list[tuple[int, int]]) -> set[int]:
+    return {r % 2 for r, _ in coords}
+
+
+def _coord_checker_parities(coords: tuple[tuple[int, int], ...] | list[tuple[int, int]]) -> set[int]:
+    return {(r + c) % 2 for r, c in coords}
+
+
+def _precompute_masks() -> dict[int, list[np.ndarray]]:
+    """
+    Enumerate salient anomaly masks.
+
+    Requirements:
+    - active count is 6 or 7
+    - active cells touch all four edges
+    - mask is not LR-symmetric, so the anomaly does not itself mimic the row-mirror law
+    - active and inactive positions both span local row parities and checkerboard parities
+    """
+    by_count: dict[int, list[np.ndarray]] = {}
+    for active_count in ACTIVE_PIXEL_COUNTS:
+        masks: list[np.ndarray] = []
+        for combo in combinations(range(MASK_SIZE * MASK_SIZE), active_count):
+            mask = np.zeros((MASK_SIZE, MASK_SIZE), dtype=bool)
+            for idx in combo:
+                mask[idx // MASK_SIZE, idx % MASK_SIZE] = True
+            active = [tuple(coord) for coord in np.argwhere(mask)]
+            inactive = [tuple(coord) for coord in np.argwhere(~mask)]
+            if np.array_equal(mask, np.fliplr(mask)):
+                continue
+            if not (mask[0, :].any() and mask[2, :].any() and mask[:, 0].any() and mask[:, 2].any()):
+                continue
+            if len(_coord_row_parities(active)) != 2 or len(_coord_checker_parities(active)) != 2:
+                continue
+            if len(_coord_row_parities(inactive)) != 2 or len(_coord_checker_parities(inactive)) != 2:
+                continue
+            masks.append(mask)
+        by_count[active_count] = masks
+    return by_count
+
+
+def _precompute_base_masks() -> list[np.ndarray]:
+    """Build a catalog of asymmetric 3x3 motifs whose horizontal mirrors are visibly different."""
+    seen: set[tuple[int, ...]] = set()
+    catalog: list[np.ndarray] = []
+    for seed in _BASE_SEEDS:
+        variants = [
+            seed,
+            np.rot90(seed, 1),
+            np.rot90(seed, 2),
+            np.rot90(seed, 3),
+            np.flipud(seed),
+            np.fliplr(seed),
+        ]
+        for variant in variants:
+            if np.array_equal(variant, np.fliplr(variant)):
+                continue
+            key = _mask_key(variant)
+            if key in seen:
+                continue
+            seen.add(key)
+            catalog.append(variant.copy())
+    return catalog
+
+
+_MASKS_BY_COUNT = _precompute_masks()
+_BASE_MASKS = _precompute_base_masks()
+
+
+def _random_anomaly_mask() -> np.ndarray:
+    active_count = random.choice(ACTIVE_PIXEL_COUNTS)
+    return random.choice(_MASKS_BY_COUNT[active_count])
+
+
+def _random_canonical_pair(shared: int, base_exclusive: int) -> tuple[np.ndarray, np.ndarray]:
+    for _ in range(100):
+        mask_a, mask_b = random.sample(_BASE_MASKS, 2)
+        keys = {
+            _mask_key(mask_a),
+            _mask_key(mask_b),
+            _mask_key(np.fliplr(mask_a)),
+            _mask_key(np.fliplr(mask_b)),
+        }
+        if len(keys) != 4:
+            continue
+        if np.count_nonzero(mask_a != mask_b) < 3:
+            continue
+        if np.count_nonzero(mask_a != np.fliplr(mask_a)) < 2:
+            continue
+        if np.count_nonzero(mask_b != np.fliplr(mask_b)) < 2:
+            continue
+        arr_a = np.where(mask_a, base_exclusive, shared).astype(int)
+        arr_b = np.where(mask_b, base_exclusive, shared).astype(int)
+        return arr_a, arr_b
+    raise RuntimeError("failed to choose a visible checkerboard mirror pair")
+
+
+def _placement_candidates(
+    mask: np.ndarray, subset: tuple[tuple[int, int], ...], top: int, left: int
+) -> list[tuple[int, int]]:
+    existing = np.zeros((CELL_GRID_N, CELL_GRID_N), dtype=bool)
+    for r, c in subset:
+        existing[top + r, left + c] = True
+
+    candidates = []
+    for t in range(PLACEMENT_RANGE):
+        for l in range(PLACEMENT_RANGE):
+            block = np.zeros((CELL_GRID_N, CELL_GRID_N), dtype=bool)
+            block[t : t + MASK_SIZE, l : l + MASK_SIZE] = True
+            if np.any(existing & ~block):
+                continue
+            if np.any(existing[t : t + MASK_SIZE, l : l + MASK_SIZE] & ~mask):
+                continue
+            candidates.append((t, l))
+    return candidates
+
+
+def _subset_is_salient(subset: tuple[tuple[int, int], ...]) -> bool:
+    return len(_coord_row_parities(subset)) == 2 and len(_coord_checker_parities(subset)) == 2
+
+
+def _choose_given_subset(mask: np.ndarray, top: int, left: int) -> tuple[tuple[int, int], ...] | None:
+    active = [tuple(coord) for coord in np.argwhere(mask)]
+    sizes = list(GIVEN_CELL_SIZES)
+    random.shuffle(sizes)
+    for size in sizes:
+        valid = [
+            subset
+            for subset in combinations(active, size)
+            if _subset_is_salient(subset) and _placement_candidates(mask, subset, top, left) == [(top, left)]
+        ]
+        if valid:
+            return random.choice(valid)
+    return None
+
+
+def _cell_origin(i: int, j: int) -> tuple[int, int]:
+    return i * CELL_STEP + 1, j * CELL_STEP + 1
+
+
+def _background_literal(
+    even_type0: np.ndarray, even_type1: np.ndarray, odd_type0: np.ndarray, odd_type1: np.ndarray, i: int, j: int
+) -> np.ndarray:
+    if i % 2 == 0:
+        return even_type0 if (i + j) % 2 == 0 else even_type1
+    return odd_type0 if (i + j) % 2 == 0 else odd_type1
+
+
+def _build_grid(
+    separator: int,
+    even_type0: np.ndarray,
+    even_type1: np.ndarray,
+    anomaly_pat: np.ndarray,
+    active_cells: list[tuple[int, int]],
+) -> np.ndarray:
+    odd_type0 = np.fliplr(even_type0)
+    odd_type1 = np.fliplr(even_type1)
+    grid = np.full((GRID_SIZE, GRID_SIZE), separator, dtype=int)
+    for i in range(CELL_GRID_N):
+        for j in range(CELL_GRID_N):
+            paste(grid, _background_literal(even_type0, even_type1, odd_type0, odd_type1, i, j), *_cell_origin(i, j))
+    for i, j in active_cells:
+        paste(grid, anomaly_pat, *_cell_origin(i, j))
+    return grid
+
+
+def _fusion_metrics(mask: np.ndarray, subset: tuple[tuple[int, int], ...]) -> dict[str, int]:
+    active = [tuple(coord) for coord in np.argwhere(mask)]
+    inactive = [tuple(coord) for coord in np.argwhere(~mask)]
+    return {
+        "active_row_parities": len(_coord_row_parities(active)),
+        "active_checker_parities": len(_coord_checker_parities(active)),
+        "inactive_row_parities": len(_coord_row_parities(inactive)),
+        "inactive_checker_parities": len(_coord_checker_parities(inactive)),
+        "given_row_parities": len(_coord_row_parities(subset)),
+        "given_checker_parities": len(_coord_checker_parities(subset)),
+    }
+
+
+def _generate_case():
+    separator, base_exclusive, shared, anomaly_exclusive = random.sample(range(COLOR_POOL), 4)
+    even_type0, even_type1 = _random_canonical_pair(shared, base_exclusive)
+    mask = _random_anomaly_mask()
+    anomaly_pat = np.where(mask, anomaly_exclusive, shared).astype(int)
+
+    top = random.randrange(PLACEMENT_RANGE)
+    left = random.randrange(PLACEMENT_RANGE)
+    active_cells = [(top + r, left + c) for r, c in np.argwhere(mask)]
+    out = _build_grid(separator, even_type0, even_type1, anomaly_pat, active_cells)
+
+    subset = _choose_given_subset(mask, top, left)
+    if subset is None:
+        return None
+    metrics = _fusion_metrics(mask, subset)
+    if min(metrics.values()) < 2:
+        return None
+
+    given_cells = [(top + r, left + c) for r, c in subset]
+    inp = _build_grid(separator, even_type0, even_type1, anomaly_pat, given_cells)
+
+    try:
+        solved = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(solved, out):
+        return None
+
+    return {
+        "input": inp,
+        "output": out,
+        "metrics": metrics,
+    }
+
+
+def generate_input():
+    for _ in range(MAX_RETRIES):
+        case = _generate_case()
+        if case is not None:
+            return case["input"]
+    raise RuntimeError("failed to generate a valid b99e7126 combo D6/0+D12/1 input")

