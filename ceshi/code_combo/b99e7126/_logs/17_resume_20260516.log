+    given_cells = [(top + r, left + c) for r, c in subset]
+    inp = _build_grid(separator, even_type0, even_type1, anomaly_pat, given_cells)
+
+    try:
+        solved = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(solved, out):
+        return None
+
+    return {
+        "input": inp,
+        "output": out,
+        "metrics": metrics,
+    }
+
+
+def generate_input():
+    for _ in range(MAX_RETRIES):
+        case = _generate_case()
+        if case is not None:
+            return case["input"]
+    raise RuntimeError("failed to generate a valid b99e7126 combo D6/0+D12/1 input")

