+# Combo variant of b99e7126 (index 31)
+# combo_spec: D11/0+D14/0
+# Name: 颜色重映射 + 环绕边界
+
+from functools import reduce
+from itertools import combinations
+from math import gcd
+
+import numpy as np
+import random
+
+from arc_utils import paste
+
+
+# Design analysis for the D11/0 + D14/0 combo
+# -------------------------------------------
+# concretization_and_trace:
+# - The canvas is still a 29x29 grid made from a 7x7 lattice of 3x3 cell interiors
+#   separated by 1-pixel divider lines. Most cells show one majority template. A
+#   small visible subset shows one minority template.
+# - Concrete example: let the minority interior be
+#     [[m, m, m],
+#      [m, s, m],
+#      [m, s, m]]
+#   where `m` is the minority-only color and `s` is the shared color. The active
+#   mask is therefore
+#     [[1, 1, 1],
+#      [1, 0, 1],
+#      [1, 0, 1]].
+# - Original task: choose an in-bounds offset such as `(top, left) = (2, 3)` and
+#   stamp whole-cell copies of the minority template at the active positions. The
+#   3x3 enlarged block stays inside rows/cols 0..6.
+# - D11 alone changes the stamped template to
+#     [[a, a, a],
+#      [a, s, a],
+#      [a, s, a]]
+#   where `a` is the majority-only color; geometry is preserved, palette is not.
+# - D14 alone changes placement to toroidal addressing. With `(top, left) = (6, 5)`,
+#   local cell `(0, 0)` lands at global `(6, 5)`, `(1, 0)` wraps to `(0, 5)`, and
+#   `(2, 2)` wraps to `(1, 0)`.
+# - The combo must do both at once: locate the enlarged 3x3 stencil on the torus,
+#   then write the recolored template at wrapped active positions and the majority
+#   template at wrapped inactive positions. The visible difference from the original
+#   is therefore dual: border crossing and palette translation happen in the same
+#   enlarged object.
+#
+# complexity_calibration:
+# - Keep only 4 visible colors: divider, shared, majority-only, minority-only. That
+#   is enough to express the recolor relation without creating unreadable palette
+#   churn.
+# - The recolor rule stays single-case and repeated throughout one sample:
+#   minority-only -> majority-only, shared -> shared. This gives multiple repeated
+#   examples of the same mapping inside the enlarged pattern.
+# - The generator always chooses a wrapping placement on the row axis, column axis,
+#   or both, so the D14 change cannot degenerate into the original in-bounds case.
+# - The generator also rejects cases where the recolored template equals the ordinary
+#   majority template or differs in too few pixels; otherwise the D11 change would be
+#   too weak to infer from a few demonstrations.
+#
+# hidden_assumption_audit:
+# - `_infer_cell_grid_params()` assumes regular full-line dividers; unchanged.
+# - Pattern extraction/counting assumes the input itself has exactly two recurring
+#   cell interiors. The combo preserves that: input uses only majority and minority
+#   templates. The recolored template appears only in the output.
+# - The original candidate search assumed an in-bounds rectangle
+#   `top:top+mh, left:left+mw`. Under wraparound this is false, so candidate search
+#   must enumerate all `n*n` toroidal offsets and compare sets of wrapped active
+#   cells instead of rectangular slices.
+# - The original writeback assumed the output stamp was the minority template. Under
+#   D11 this is false; we must derive a third template from the shared color plus the
+#   majority-only color.
+# - The original writeback also assumed non-wrapping coordinates when slicing the
+#   output grid. Under D14 that is false; each target cell must be addressed with
+#   modulo arithmetic before its 3x3 interior is overwritten.
+# - Combining D11 and D14 does not create a conflict because one change acts on color
+#   interpretation and the other acts on spatial addressing. The solver simply needs
+#   both derived template logic and toroidal placement logic at the same time.
+#
+# placement_legality:
+# - With a 7x7 cell lattice and a 3x3 mask, the wrapped destinations
+#   `((top+r) % 7, (left+c) % 7)` are always distinct, so the enlarged stencil never
+#   self-overlaps.
+# - The input still shows only a strict subset of active positions, and the generator
+#   searches subsets until exactly one toroidal placement remains valid.
+# - Output construction starts from an all-majority lattice and only overwrites whole
+#   cell interiors, so objects neither partially overlap nor touch divider lines.
+#
+# visual_observability_and_cleanliness:
+# - The puzzle remains visually tidy because there are only two cell motifs in the
+#   input and two motifs in the output: ordinary majority cells and one coherent
+#   enlarged wrapped pattern.
+# - Wraparound is easy to see because the active mask spans all four edges of its 3x3
+#   frame, so a wrapped placement produces minority-like evidence on opposite borders.
+# - Recolor is easy to see because the completed cells adopt the minority geometry but
+#   visibly switch from the minority-only color to the majority-only color already
+#   demonstrated elsewhere in the grid.
+#
+# inferability_of_change:
+# - A solver can infer the color mapping structurally: majority and minority cells
+#   share exactly one color, so the only plausible recolor is "keep the shared color,
+#   swap the minority-only foreground to the majority-only foreground".
+# - A solver can infer the toroidal placement structurally: visible minority cells may
+#   be separated by borders, but they become a single 3x3 stencil when indices are
+#   interpreted modulo the 7x7 lattice size.
+# - Because every sample enforces both wrapping and recolor, the combo does not reduce
+#   to either single variant or the base task.
+#
+# new_solver_assumptions_and_generator_guarantees:
+# - `main()` assumes majority and minority templates each use exactly two colors and
+#   share exactly one color. The generator constructs them that way.
+# - `main()` assumes the dominant minority color is the minority-only color. Active
+#   counts are fixed at 6 or 7, so the generator guarantees that.
+# - `main()` assumes exactly one toroidal offset matches the visible minority subset.
+#   `_choose_given_subset()` enforces that before an input is emitted.
+# - `main()` assumes the recolored template is observably different from the majority
+#   template. `_gen_attempt()` enforces a minimum Hamming difference.
+
+
+def _infer_cell_grid_params(g: np.ndarray) -> tuple[int, list[int], list[int]]:
+    """
+    Infer a regular cell grid separated by full rows/cols of the same line color.
+    Returns (step, row_divs, col_divs) where:
+      - row_divs/col_divs are divider indices
+      - step is the spacing between dividers (cell size including divider).
+    """
+    h, w = g.shape
+    line = int(g[0, 0])
+    row_divs = [r for r in range(h) if np.all(g[r, :] == line)]
+    col_divs = [c for c in range(w) if np.all(g[:, c] == line)]
+    assert len(row_divs) >= 2 and len(col_divs) >= 2, "need at least 2 row and 2 col dividers"
+    row_divs.sort()
+    col_divs.sort()
+    drs = [row_divs[i + 1] - row_divs[i] for i in range(len(row_divs) - 1) if row_divs[i + 1] > row_divs[i]]
+    dcs = [col_divs[i + 1] - col_divs[i] for i in range(len(col_divs) - 1) if col_divs[i + 1] > col_divs[i]]
+    step = reduce(gcd, drs + dcs)
+    assert step > 1, "divider step must be > 1"
+    assert row_divs[0] == 0 and col_divs[0] == 0, "first divider must be at index 0"
+    assert (h - 1) % step == 0 and (w - 1) % step == 0, "grid dimensions must be (k*step + 1)"
+    assert row_divs[-1] == h - 1 and col_divs[-1] == w - 1, "last divider must be at boundary"
+    return int(step), row_divs, col_divs
+
+
+def _mask_coords(mask: np.ndarray) -> list[tuple[int, int]]:
+    return [tuple(map(int, coord)) for coord in np.argwhere(mask)]
+
+
+def _placed_cells(mask: np.ndarray, top: int, left: int, n: int) -> set[tuple[int, int]]:
+    return {
+        ((top + r) % n, (left + c) % n)
+        for r, c in _mask_coords(mask)
+    }
+
+
+def _derive_recolored_pattern(minority_arr: np.ndarray, majority_arr: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
+    """Return (active_mask, recolored_template) for the combined transform."""
+    vals, cnts = np.unique(minority_arr, return_counts=True)
+    active_color = int(vals[cnts.argmax()])
+    mask = minority_arr == active_color
+
+    minority_colors = set(map(int, np.unique(minority_arr)))
+    majority_colors = set(map(int, np.unique(majority_arr)))
+    shared_colors = minority_colors & majority_colors
+    assert len(shared_colors) == 1, "majority/minority must share exactly one color"
+    shared_color = next(iter(shared_colors))
+
+    minority_only = minority_colors - {shared_color}
+    majority_only = majority_colors - {shared_color}
+    assert len(minority_only) == 1 and len(majority_only) == 1, "each template must have one exclusive color"
+    assert active_color == next(iter(minority_only)), "minority active color must be the minority-only color"
+
+    mapped_active = next(iter(majority_only))
+    recolored = np.where(mask, mapped_active, shared_color).astype(int)
+    return mask, recolored
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Complete a wrapped cell-grid fractal by enlarging the odd cell's pattern with a remapped palette.
+
+    Input structure:
+    - The board is partitioned into equal 3x3 cell interiors separated by full divider rows and columns.
+    - Most cells share one repeated majority template; a smaller visible subset uses one minority template.
+    - Those visible minority cells may already be split across opposite borders because the large-scale stencil wraps around the cell lattice.
+
+    Rule:
+    - Read the minority cell as a 3x3 binary mask, taking its dominant color as the active pixels.
+    - Infer the recolored output template by keeping the color shared with the majority cell and replacing the minority-only color with the majority-only color.
+    - Search all toroidal placements of the 3x3 mask on the cell grid, then use the unique placement to repaint the enlarged stencil: active positions get the recolored template and inactive positions get the majority template.
+
+    Key insight:
+    - The odd cell still encodes a self-similar blueprint, but the enlarged copy is transformed in two coupled ways: its foreground color is translated through the majority/minority palette relationship, and its 3x3 footprint continues across borders with wraparound.
+    """
+    g = np.asarray(grid, dtype=int)
+    step, _, _ = _infer_cell_grid_params(g)
+    n = (g.shape[0] - 1) // step
+    inner = step - 1
+
+    patterns: dict[tuple[int, ...], np.ndarray] = {}
+    cell_pat: list[list[tuple[int, ...]]] = []
+    for i in range(n):
+        row: list[tuple[int, ...]] = []
+        for j in range(n):
+            r0 = i * step + 1
+            c0 = j * step + 1
+            pat_arr = g[r0 : r0 + inner, c0 : c0 + inner].copy()
+            pat = tuple(pat_arr.ravel().tolist())
+            if pat not in patterns:
+                patterns[pat] = pat_arr
+            row.append(pat)
+        cell_pat.append(row)
+
+    counts: dict[tuple[int, ...], int] = {}
+    for i in range(n):
+        for j in range(n):
+            p = cell_pat[i][j]
+            counts[p] = counts.get(p, 0) + 1
+    assert len(counts) >= 2, "must have at least 2 distinct cell patterns (minority + majority)"
+
+    minority_pat = min(counts.items(), key=lambda kv: kv[1])[0]
+    majority_pat = max(counts.items(), key=lambda kv: kv[1])[0]
+    minority_arr = patterns[minority_pat]
+    majority_arr = patterns[majority_pat]
+    mask, recolored_arr = _derive_recolored_pattern(minority_arr, majority_arr)
+    mh, mw = mask.shape
+
+    existing: set[tuple[int, int]] = set()
+    for i in range(n):
+        for j in range(n):
+            if cell_pat[i][j] == minority_pat:
+                existing.add((i, j))
+
+    candidates: list[tuple[int, int]] = []
+    for top in range(n):
+        for left in range(n):
+            if existing <= _placed_cells(mask, top, left, n):
+                candidates.append((top, left))
+    assert len(candidates) == 1, "must have a unique toroidal mask placement aligning existing minority cells"
+    top, left = candidates[0]
+
+    out = g.copy()
+    for i in range(mh):
+        for j in range(mw):
+            rr = (top + i) % n
+            cc = (left + j) % n
+            r0 = rr * step + 1
+            c0 = cc * step + 1
+            out[r0 : r0 + inner, c0 : c0 + inner] = recolored_arr if mask[i, j] else majority_arr
+    return out
+
+
+# --------------- generator (o5x) ---------------
+
+CELL_GRID_N = 7
+CELL_INNER = 3
+CELL_STEP = 4
+GRID_SIZE = 29
+MASK_SIZE = 3
+PLACEMENT_RANGE = CELL_GRID_N
+ACTIVE_PIXEL_COUNTS = (6, 7)
+GIVEN_CELL_SIZES = [3, 4]
+COLOR_POOL = 10
+MAX_RETRIES = 300
+MIN_RECOLOR_DIFF = 3
+
+NON_WRAP_OFFSETS = tuple(range(CELL_GRID_N - MASK_SIZE + 1))
+WRAP_OFFSETS = tuple(range(CELL_GRID_N - MASK_SIZE + 1, CELL_GRID_N))
+WRAP_BRANCHES = ("row", "col", "both")
+
+_LR_GROUPS = [
+    ((0, 0), (0, 2)),
+    ((1, 0), (1, 2)),
+    ((2, 0), (2, 2)),
+    ((0, 1),),
+    ((1, 1),),
+    ((2, 1),),
+]
+
+
+def _precompute_masks():
+    """Enumerate all valid LR-symmetric 3x3 masks, keyed by active pixel count."""
+    weights = [len(group) for group in _LR_GROUPS]
+    by_count = {}
+    for active_count in ACTIVE_PIXEL_COUNTS:
+        inactive_count = MASK_SIZE * MASK_SIZE - active_count
+        masks = []
+        for k in range(1, len(_LR_GROUPS) + 1):
+            for combo in combinations(range(len(_LR_GROUPS)), k):
+                if sum(weights[i] for i in combo) != inactive_count:
+                    continue
+                mask = np.ones((MASK_SIZE, MASK_SIZE), dtype=bool)
+                for i in combo:
+                    for r, c in _LR_GROUPS[i]:
+                        mask[r, c] = False
+                if mask[0, :].any() and mask[2, :].any() and mask[:, 0].any() and mask[:, 2].any():
+                    masks.append(mask)
+        by_count[active_count] = masks
+    return by_count
+
+
+_MASKS_BY_COUNT = _precompute_masks()
+
+
+def _random_lr_pattern(color_a: int, color_b: int) -> np.ndarray:
+    """Generate a random LR-symmetric 3x3 pattern using two colors."""
+    arr = np.empty((MASK_SIZE, MASK_SIZE), dtype=int)
+    choices = [random.choice((color_a, color_b)) for _ in _LR_GROUPS]
+    if all(v == choices[0] for v in choices):
+        choices[random.randrange(len(choices))] = color_b if choices[0] == color_a else color_a
+    for group, color in zip(_LR_GROUPS, choices):
+        for r, c in group:
+            arr[r, c] = color
+    return arr
+
+
+def _random_minority_mask() -> np.ndarray:
+    """Pick a random valid minority mask."""
+    active_count = random.choice(ACTIVE_PIXEL_COUNTS)
+    return random.choice(_MASKS_BY_COUNT[active_count])
+
+
+def _wrapped_active_cells(mask: np.ndarray, top: int, left: int) -> list[tuple[int, int]]:
+    return [
+        ((top + r) % CELL_GRID_N, (left + c) % CELL_GRID_N)
+        for r, c in _mask_coords(mask)
+    ]
+
+
+def _placement_candidates(mask: np.ndarray, subset_cells) -> list[tuple[int, int]]:
+    """Find all toroidal offsets where the visible minority cells fit the mask."""
+    existing = set(subset_cells)
+    candidates = []
+    for t in range(PLACEMENT_RANGE):
+        for l in range(PLACEMENT_RANGE):
+            if existing <= _placed_cells(mask, t, l, CELL_GRID_N):
+                candidates.append((t, l))
+    return candidates
+
+
+def _choose_given_subset(mask: np.ndarray, top: int, left: int):
+    """Choose a visible subset that uniquely determines the toroidal placement."""
+    placed = _wrapped_active_cells(mask, top, left)
+    sizes = list(GIVEN_CELL_SIZES)
+    random.shuffle(sizes)
+    for size in sizes:
+        valid = [
+            subset
+            for subset in combinations(placed, size)
+            if _placement_candidates(mask, subset) == [(top, left)]
+        ]
+        if valid:
+            return random.choice(valid)
+    return None
+
+
+def _cell_origin(i: int, j: int) -> tuple[int, int]:
+    """Pixel origin of cell (i, j) interior within the full grid."""
+    return i * CELL_STEP + 1, j * CELL_STEP + 1
+
+
+def _build_grid(separator: int, majority: np.ndarray, active_pattern: np.ndarray, active_cells) -> np.ndarray:
+    """Construct a 29x29 grid: fill all cells with majority, then overwrite active_cells."""
+    grid = np.full((GRID_SIZE, GRID_SIZE), separator, dtype=int)
+    for i in range(CELL_GRID_N):
+        for j in range(CELL_GRID_N):
+            paste(grid, majority, *_cell_origin(i, j))
+    for i, j in active_cells:
+        paste(grid, active_pattern, *_cell_origin(i, j))
+    return grid
+
+
+def _choose_wrapping_offset() -> tuple[int, int]:
+    branch = random.choice(WRAP_BRANCHES)
+    if branch == "row":
+        return random.choice(WRAP_OFFSETS), random.choice(NON_WRAP_OFFSETS)
+    if branch == "col":
+        return random.choice(NON_WRAP_OFFSETS), random.choice(WRAP_OFFSETS)
+    return random.choice(WRAP_OFFSETS), random.choice(WRAP_OFFSETS)
+
+
+def _gen_attempt():
+    """Single generation attempt: build output, choose input subset, verify with solver."""
+    separator, maj_exclusive, shared, min_exclusive = random.sample(range(COLOR_POOL), 4)
+    mask = _random_minority_mask()
+    majority = _random_lr_pattern(shared, maj_exclusive)
+    minority = np.where(mask, min_exclusive, shared).astype(int)
+    recolored = np.where(mask, maj_exclusive, shared).astype(int)
+
+    if np.array_equal(majority, recolored):
+        return None
+    if int(np.sum(majority != recolored)) < MIN_RECOLOR_DIFF:
+        return None
+
+    top, left = _choose_wrapping_offset()
+    active_cells = _wrapped_active_cells(mask, top, left)
+    out = _build_grid(separator, majority, recolored, active_cells)
+
+    given_cells = _choose_given_subset(mask, top, left)
+    if given_cells is None:
+        return None
+    inp = _build_grid(separator, majority, minority, given_cells)
+
+    try:
+        solved = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(solved, out):
+        return None
+    return inp
+
+
+def generate_input():
+    for _ in range(MAX_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid b99e7126 D11+D14 combo input")

