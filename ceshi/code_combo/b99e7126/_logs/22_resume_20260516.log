+# Combo variant of b99e7126 (index 22)
+# combo_spec: D4/1+D16/1
+# Name: 反向分形 + 仅覆盖背景区域
+
+from functools import reduce
+from itertools import combinations
+from math import gcd
+from pathlib import Path
+import random
+import sys
+
+import numpy as np
+
+_ROOT = Path(__file__).resolve().parents[4]
+_SOLVER_DIR = _ROOT / "solvers"
+if str(_SOLVER_DIR) not in sys.path:
+    sys.path.append(str(_SOLVER_DIR))
+
+from arc_utils import paste
+
+# Design analysis for this combo variant
+# --------------------------------------
+# a) Concrete behavior trace
+# - Original task:
+#   a minority 3x3 cell is a miniature boolean blueprint. After locating its 3x3
+#   coarse-cell placement, every active coarse slot is overwritten with another
+#   full copy of the minority cell.
+# - Fused task:
+#   the minority cell is still the blueprint, but the completed coarse slots are
+#   no longer raw minority copies. They are "repaired" hybrids:
+#   keep the minority foreground pixels, and fill only the minority background
+#   pixels from the majority cell's corresponding pixels.
+# - Small pixel example:
+#   minority  = [[M, M, s],
+#                [M, M, M],
+#                [s, M, s]]
+#   majority  = [[a, s, a],
+#                [s, a, s],
+#                [a, s, a]]
+#   repaired  = [[M, M, a],
+#                [M, M, M],
+#                [a, M, a]]
+#   Here `M` is the minority foreground and `s` is its background/shared color.
+#   The repaired cell keeps all `M` pixels and only repairs the `s` positions.
+#
+# b) Complexity calibration
+# - The puzzle keeps the original 29x29 canvas, 7x7 cell lattice, 3x3 interiors,
+#   and hidden 3x3 fractal placement, so the core "find the placed blueprint"
+#   reasoning remains visible.
+# - To make the fused rule observable, the input contains three exact cell types:
+#   majority, raw minority clue, and repaired preview. This prevents the task from
+#   collapsing into a pure local recoloring rule or into the original binary fill.
+# - The generator enforces 6-7 active blueprint pixels and 2-3 inactive pixels,
+#   so the repaired cell always shows a meaningful mix instead of full replacement.
+#
+# c) Implicit-assumption audit against the original solver
+# - Original assumption: there are exactly two cell patterns in the input.
+#   Broken here; the input must contain majority, minority, and repaired cells.
+# - Original assumption: every visible non-majority cell is a minority copy.
+#   Broken here; repaired previews are also evidence for active coarse positions.
+# - Original assumption: active coarse positions should end as raw minority cells.
+#   Broken here; they must end as repaired hybrids derived from majority+minority.
+# - Original assumption: inactive coarse positions can be forced to the majority
+#   pattern because the output block is binary. This still holds, but only after
+#   the solver has recognized that the active class is `repaired`, not `minority`.
+#
+# d) Placement legality
+# - The hidden block is still 3x3 coarse cells, so its top-left offset stays in
+#   0..4 and never crosses the 7x7 lattice boundary.
+# - Each coarse slot holds exactly one whole 3x3 cell interior; there is no pixel-
+#   level overlap between neighbors because writes always occur at legal cell origins.
+# - The generator rejects any evidence subset whose minority+repaired cells do not
+#   identify exactly one block placement.
+#
+# e) Visual observability
+# - Humans can compare three repeated motifs directly: majority cells, raw minority
+#   clues, and repaired cells that visibly mix minority foreground with majority
+#   background. The output then extends that repaired motif to all active block slots.
+# - The reverse-fractal part stays readable because the minority cell still acts as
+#   the miniature blueprint for the large-scale 3x3 coarse placement.
+#
+# f) Visual cleanliness
+# - Only one 3x3 coarse block is semantically active, and there are only three cell
+#   types. No extra marker objects, border annotations, or partial divider edits are
+#   introduced.
+# - Repaired cells are shape-compatible with both source motifs, so the completed
+#   block reads as a controlled partial restoration rather than as noisy clutter.
+#
+# g) Quantitative non-degeneration target
+# - Every sample contains at least one raw minority clue and at least two repaired
+#   previews, so the fused transform cannot collapse to "all active cells become
+#   minority" or to "all active cells become majority".
+# - The generator also enforces at least one repaired background pixel per repaired
+#   cell: `repaired != minority` on at least one inactive blueprint position.
+#
+# h) New solver assumptions and generator guarantees
+# - Solver assumes exactly three input cell patterns and a strict frequency order
+#   minority < repaired < majority; generator constructs that order.
+# - Solver assumes repaired cells preserve minority pixels on mask=True positions and
+#   preserve majority pixels on mask=False positions; generator defines repaired cells
+#   exactly that way.
+# - Solver assumes the union of minority and repaired cells is a strict subset of the
+#   active blueprint positions and gives a unique placement; generator verifies that.
+
+CELL_GRID_N = 7
+CELL_INNER = 3
+CELL_STEP = 4
+GRID_SIZE = 29
+MASK_SIZE = 3
+PLACEMENT_RANGE = CELL_GRID_N - MASK_SIZE + 1
+ACTIVE_PIXEL_COUNTS = (6, 7)
+GIVEN_COUNT_PAIRS = ((1, 2), (1, 3), (2, 3))
+COLOR_POOL = 10
+MAX_RETRIES = 500
+
+_LR_GROUPS = [
+    ((0, 0), (0, 2)),
+    ((1, 0), (1, 2)),
+    ((2, 0), (2, 2)),
+    ((0, 1),),
+    ((1, 1),),
+    ((2, 1),),
+]
+
+
+def _infer_cell_grid_params(g: np.ndarray) -> tuple[int, list[int], list[int]]:
+    """
+    Infer a regular cell grid separated by full rows/cols of the same line color.
+    Returns (step, row_divs, col_divs) where:
+      - row_divs/col_divs are divider indices
+      - step is the spacing between dividers (cell size including divider).
+    """
+    h, w = g.shape
+    line = int(g[0, 0])
+    row_divs = [r for r in range(h) if np.all(g[r, :] == line)]
+    col_divs = [c for c in range(w) if np.all(g[:, c] == line)]
+    assert len(row_divs) >= 2 and len(col_divs) >= 2, "need at least 2 row and 2 col dividers"
+    row_divs.sort()
+    col_divs.sort()
+    drs = [row_divs[i + 1] - row_divs[i] for i in range(len(row_divs) - 1) if row_divs[i + 1] > row_divs[i]]
+    dcs = [col_divs[i + 1] - col_divs[i] for i in range(len(col_divs) - 1) if col_divs[i + 1] > col_divs[i]]
+    step = reduce(gcd, drs + dcs)
+    assert step > 1, "divider step must be > 1"
+    assert row_divs[0] == 0 and col_divs[0] == 0, "first divider must be at index 0"
+    assert (h - 1) % step == 0 and (w - 1) % step == 0, "grid dimensions must be (k*step + 1)"
+    assert row_divs[-1] == h - 1 and col_divs[-1] == w - 1, "last divider must be at boundary"
+    return int(step), row_divs, col_divs
+
+
+def _extract_patterns(g: np.ndarray, step: int) -> tuple[dict[tuple[int, ...], np.ndarray], list[list[tuple[int, ...]]]]:
+    """Collect every cell interior pattern and its array form."""
+    n = (g.shape[0] - 1) // step
+    inner = step - 1
+    patterns: dict[tuple[int, ...], np.ndarray] = {}
+    cell_pat: list[list[tuple[int, ...]]] = []
+    for i in range(n):
+        row: list[tuple[int, ...]] = []
+        for j in range(n):
+            r0 = i * step + 1
+            c0 = j * step + 1
+            pat_arr = g[r0 : r0 + inner, c0 : c0 + inner].copy()
+            pat = tuple(int(v) for v in pat_arr.ravel())
+            if pat not in patterns:
+                patterns[pat] = pat_arr
+            row.append(pat)
+        cell_pat.append(row)
+    return patterns, cell_pat
+
+
+def _pattern_counts(cell_pat: list[list[tuple[int, ...]]]) -> dict[tuple[int, ...], int]:
+    counts: dict[tuple[int, ...], int] = {}
+    for row in cell_pat:
+        for pat in row:
+            counts[pat] = counts.get(pat, 0) + 1
+    return counts
+
+
+def _minority_mask(minority_arr: np.ndarray) -> np.ndarray:
+    vals, cnts = np.unique(minority_arr, return_counts=True)
+    active_color = int(vals[cnts.argmax()])
+    return minority_arr == active_color
+
+
+def _active_evidence_mask(
+    cell_pat: list[list[tuple[int, ...]]],
+    minority_pat: tuple[int, ...],
+    repaired_pat: tuple[int, ...],
+) -> np.ndarray:
+    n = len(cell_pat)
+    existing = np.zeros((n, n), dtype=bool)
+    for i in range(n):
+        for j in range(n):
+            existing[i, j] = cell_pat[i][j] in (minority_pat, repaired_pat)
+    return existing
+
+
+def _locate_source_block(existing: np.ndarray, mask: np.ndarray) -> tuple[int, int]:
+    """Find the unique top-left placement whose active cells cover all evidence cells."""
+    n = existing.shape[0]
+    mh, mw = mask.shape
+    candidates: list[tuple[int, int]] = []
+    for top in range(0, n - mh + 1):
+        for left in range(0, n - mw + 1):
+            block = np.zeros_like(existing)
+            block[top : top + mh, left : left + mw] = True
+            if np.any(existing & ~block):
+                continue
+            ex_block = existing[top : top + mh, left : left + mw]
+            if np.any(ex_block & ~mask):
+                continue
+            candidates.append((int(top), int(left)))
+    assert len(candidates) == 1, "must have a unique mask placement aligning active evidence"
+    return candidates[0]
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Complete a fractal repair pattern by filling every active coarse slot with a partially repaired hybrid cell.
+
+    Input structure:
+    - The board is partitioned into a 7x7 lattice of 3x3 cell interiors separated by one-color divider lines.
+    - Most cells share one majority interior pattern.
+    - A hidden 3x3 coarse block contains a strict subset of active positions shown in the input using two non-majority patterns:
+      raw minority clues and already-repaired preview cells.
+
+    Rule:
+    - Read the raw minority cell as a 3x3 boolean blueprint, using its dominant color as the foreground mask.
+    - Use both raw minority cells and repaired preview cells as evidence for the active positions of that blueprint on the 7x7 coarse lattice.
+    - Infer the repaired cell by preserving minority pixels on blueprint-foreground positions and borrowing majority pixels only on blueprint-background positions.
+    - Replace every active coarse slot of the placed block with that repaired cell, while inactive coarse slots remain majority cells.
+
+    Key insight:
+    - The odd cell still acts as the miniature fractal legend, but the large-scale target is not another copy of the odd cell.
+      It is a partial repair: foreground survives from the anomaly, background is restored from the normal majority motif.
+    """
+    g = np.asarray(grid, dtype=int)
+    step, _, _ = _infer_cell_grid_params(g)
+    n = (g.shape[0] - 1) // step
+    inner = step - 1
+
+    patterns, cell_pat = _extract_patterns(g, step)
+    counts = _pattern_counts(cell_pat)
+    assert len(counts) == 3, "variant expects exactly three cell patterns"
+
+    ranked = sorted(counts.items(), key=lambda kv: kv[1])
+    minority_pat = ranked[0][0]
+    repaired_pat = ranked[1][0]
+    majority_pat = ranked[2][0]
+    assert counts[minority_pat] < counts[repaired_pat] < counts[majority_pat], "pattern frequencies must be ordered"
+
+    minority_arr = patterns[minority_pat]
+    repaired_arr = patterns[repaired_pat]
+    majority_arr = patterns[majority_pat]
+
+    mask = _minority_mask(minority_arr)
+    mh, mw = mask.shape
+    assert mh == inner and mw == inner, "minority mask must match the cell interior"
+    assert int(mask.sum()) in ACTIVE_PIXEL_COUNTS, "minority blueprint must use the configured active counts"
+
+    # Fused D16 behavior: repaired cells keep anomaly foreground and only restore anomaly background.
+    assert np.array_equal(repaired_arr[mask], minority_arr[mask]), "repaired cell must keep minority foreground pixels"
+    assert np.array_equal(repaired_arr[~mask], majority_arr[~mask]), "repaired cell must borrow majority background pixels"
+    assert np.any(repaired_arr != minority_arr), "repair must visibly change the minority cell"
+    assert np.any(repaired_arr != majority_arr), "repair must remain a hybrid rather than full majority"
+
+    existing = _active_evidence_mask(cell_pat, minority_pat, repaired_pat)
+    top, left = _locate_source_block(existing, mask)
+
+    out = g.copy()
+    for i in range(mh):
+        for j in range(mw):
+            target_pat = repaired_arr if mask[i, j] else majority_arr
+            r0 = (top + i) * step + 1
+            c0 = (left + j) * step + 1
+            out[r0 : r0 + inner, c0 : c0 + inner] = target_pat
+    return out
+
+
+def _precompute_masks() -> dict[int, list[np.ndarray]]:
+    """Enumerate valid LR-symmetric 3x3 masks keyed by active-pixel count."""
+    weights = [len(group) for group in _LR_GROUPS]
+    by_count: dict[int, list[np.ndarray]] = {}
+    for active_count in ACTIVE_PIXEL_COUNTS:
+        inactive_count = MASK_SIZE * MASK_SIZE - active_count
+        masks: list[np.ndarray] = []
+        for k in range(1, len(_LR_GROUPS) + 1):
+            for combo in combinations(range(len(_LR_GROUPS)), k):
+                if sum(weights[i] for i in combo) != inactive_count:
+                    continue
+                mask = np.ones((MASK_SIZE, MASK_SIZE), dtype=bool)
+                for idx in combo:
+                    for r, c in _LR_GROUPS[idx]:
+                        mask[r, c] = False
+                if mask[0, :].any() and mask[2, :].any() and mask[:, 0].any() and mask[:, 2].any():
+                    masks.append(mask)
+        by_count[active_count] = masks
+    return by_count
+
+
+_MASKS_BY_COUNT = _precompute_masks()
+
+
+def _random_lr_pattern(color_a: int, color_b: int) -> np.ndarray:
+    """Generate a random non-uniform LR-symmetric 3x3 pattern using two colors."""
+    arr = np.empty((MASK_SIZE, MASK_SIZE), dtype=int)
+    choices = [random.choice((color_a, color_b)) for _ in _LR_GROUPS]
+    if all(v == choices[0] for v in choices):
+        choices[random.randrange(len(choices))] = color_b if choices[0] == color_a else color_a
+    for group, color in zip(_LR_GROUPS, choices):
+        for r, c in group:
+            arr[r, c] = color
+    return arr
+
+
+def _random_minority_mask() -> np.ndarray:
+    active_count = random.choice(ACTIVE_PIXEL_COUNTS)
+    return random.choice(_MASKS_BY_COUNT[active_count])
+
+
+def _cell_origin(i: int, j: int) -> tuple[int, int]:
+    return i * CELL_STEP + 1, j * CELL_STEP + 1
+
+
+def _build_grid(
+    separator: int,
+    majority: np.ndarray,
+    minority: np.ndarray,
+    repaired: np.ndarray,
+    minority_cells: list[tuple[int, int]],
+    repaired_cells: list[tuple[int, int]],
+) -> np.ndarray:
+    """Construct a full grid from majority cells plus minority/repaired exceptions."""
+    grid = np.full((GRID_SIZE, GRID_SIZE), separator, dtype=int)
+    for i in range(CELL_GRID_N):
+        for j in range(CELL_GRID_N):
+            paste(grid, majority, *_cell_origin(i, j))
+    for i, j in minority_cells:
+        paste(grid, minority, *_cell_origin(i, j))
+    for i, j in repaired_cells:
+        paste(grid, repaired, *_cell_origin(i, j))
+    return grid
+
+
+def _placement_candidates(
+    mask: np.ndarray,
+    evidence_subset: tuple[tuple[int, int], ...],
+    top: int,
+    left: int,
+) -> list[tuple[int, int]]:
+    """Find all offsets where the observed active-evidence subset fits the mask."""
+    existing = np.zeros((CELL_GRID_N, CELL_GRID_N), dtype=bool)
+    for r, c in evidence_subset:
+        existing[top + r, left + c] = True
+
+    candidates: list[tuple[int, int]] = []
+    for t in range(PLACEMENT_RANGE):
+        for l in range(PLACEMENT_RANGE):
+            block = np.zeros((CELL_GRID_N, CELL_GRID_N), dtype=bool)
+            block[t : t + MASK_SIZE, l : l + MASK_SIZE] = True
+            if np.any(existing & ~block):
+                continue
+            if np.any(existing[t : t + MASK_SIZE, l : l + MASK_SIZE] & ~mask):
+                continue
+            candidates.append((t, l))
+    return candidates
+
+
+def _choose_evidence_partition(mask: np.ndarray, top: int, left: int):
+    """
+    Choose active positions shown in the input.
+
+    Returns:
+      (minority_subset, repaired_subset) in mask-local coordinates, or None.
+    """
+    active = [tuple(coord) for coord in np.argwhere(mask)]
+    pair_options = list(GIVEN_COUNT_PAIRS)
+    random.shuffle(pair_options)
+    for clue_count, preview_count in pair_options:
+        total = clue_count + preview_count
+        if total >= len(active):
+            continue
+        valid_total_subsets = [
+            subset
+            for subset in combinations(active, total)
+            if _placement_candidates(mask, subset, top, left) == [(top, left)]
+        ]
+        random.shuffle(valid_total_subsets)
+        for subset in valid_total_subsets:
+            local = list(subset)
+            minority_choices = [tuple(sorted(choice)) for choice in combinations(local, clue_count)]
+            random.shuffle(minority_choices)
+            for minority_subset in minority_choices:
+                repaired_subset = tuple(pos for pos in local if pos not in minority_subset)
+                return tuple(minority_subset), repaired_subset
+    return None
+
+
+def _valid_repaired_pattern(majority: np.ndarray, repaired: np.ndarray, minority: np.ndarray, mask: np.ndarray) -> bool:
+    """Check that the repaired cell is a visible hybrid and not a degenerate duplicate."""
+    if np.array_equal(majority, minority) or np.array_equal(majority, repaired) or np.array_equal(minority, repaired):
+        return False
+    if not np.array_equal(repaired[mask], minority[mask]):
+        return False
+    if not np.array_equal(repaired[~mask], majority[~mask]):
+        return False
+    return bool(np.any(repaired != minority) and np.any(repaired != majority))
+
+
+def _gen_attempt():
+    """
+    Single generation attempt.
+
+    Output-first construction:
+    - Output contains the full active block as repaired hybrid cells.
+    - Input keeps a strict subset of active positions visible, split into raw
+      minority clues and repaired previews.
+    """
+    separator, shared, maj_exclusive, min_exclusive = random.sample(range(COLOR_POOL), 4)
+    majority = _random_lr_pattern(shared, maj_exclusive)
+    mask = _random_minority_mask()
+    minority = np.where(mask, min_exclusive, shared).astype(int)
+    repaired = majority.copy()
+    repaired[mask] = minority[mask]
+
+    if not _valid_repaired_pattern(majority, repaired, minority, mask):
+        return None
+
+    top = random.randrange(PLACEMENT_RANGE)
+    left = random.randrange(PLACEMENT_RANGE)
+    active_cells = [(top + r, left + c) for r, c in np.argwhere(mask)]
+    out = _build_grid(separator, majority, minority, repaired, [], active_cells)
+
+    partition = _choose_evidence_partition(mask, top, left)
+    if partition is None:
+        return None
+    minority_subset, repaired_subset = partition
+    minority_cells = [(top + r, left + c) for r, c in minority_subset]
+    repaired_cells = [(top + r, left + c) for r, c in repaired_subset]
+    inp = _build_grid(separator, majority, minority, repaired, minority_cells, repaired_cells)
+
+    try:
+        solved = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(solved, out):
+        return None
+    return inp
+
+
+def generate_input():
+    for _ in range(MAX_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid b99e7126 combo input")

