# Combo variant of b99e7126 (index 18)
# combo_spec: D8/0+D15/2
# Name: 可变放大倍数 + 可变单元格尺寸

from itertools import combinations
import random

import numpy as np

from arc_utils import paste


# Design analysis for the combo variant
# -------------------------------------
# a) Concrete behavior trace
#    Base task: infer the repeated cell lattice, read the odd cell's full interior as a mask,
#    and map each source pixel to exactly one cell on the coarse grid.
#    Combo task: still infer the repeated cell lattice first, but now the odd cell interior is
#    only the *logical* blueprint. After extracting that blueprint, we infer an independent
#    integer scale k from the minority cell itself, then expand every blueprint pixel into a
#    k-by-k block of coarse cells. Example: with a 2x3 cell interior and minority pattern
#    [[A, A, S],
#     [A, S, A]]
#    the active mask is [[1,1,0],[1,0,1]]. Because there are two S "holes", k = 2 + 1 = 3.
#    The output patch therefore occupies 6x9 coarse cells, not 2x3 coarse cells, with each 1
#    becoming a 3x3 block of minority cells and each 0 becoming a 3x3 block of majority cells.
#
# b) Complexity calibration
#    The two freedoms are deliberately small and repeated:
#    - cell interiors vary among a few rectangular sizes;
#    - scale varies only in {2, 3}.
#    This is enough to visibly break the original "cell size == magnification" assumption
#    without introducing too many cases for humans to infer from 2-4 examples.
#
# c) Implicit assumptions broken from the base solver
#    - Base code assumes the blueprint height/width in cells equals the cell interior size.
#      That no longer holds: the painted region is (inner_h * k) by (inner_w * k) cells.
#    - Base code assumes checking placement against the raw mask is sufficient.
#      Here placement must be checked against kron(mask, ones((k,k))).
#    - Base code effectively only needs the cell size; here cell size and scale are separate,
#      so extracting the minority interior correctly is a prerequisite for recovering k.
#
# d) Placement legality
#    Generator chooses (inner_h, inner_w, n_rows, n_cols, k) so the scaled mask fits:
#    top in [0, n_rows - inner_h*k], left in [0, n_cols - inner_w*k].
#    All minority cells lie within that rectangle, and painting only overwrites whole cells.
#
# e) Visual observability
#    The minority motif is almost full of its dominant color, with exactly k-1 shared-color
#    holes. Humans can see both signals:
#    - the odd cell resolution changes across examples;
#    - the number of holes in the odd cell changes the coarse expansion from 2x2 blocks to
#      3x3 blocks.
#    This uses visible structure, not palette ordering or numeric color ids.
#
# f) Visual cleanliness
#    Only two cell motifs exist on the board: the majority motif and the minority motif.
#    The scaled result is one clean rectangular coarse patch with a few rectangular holes,
#    so there is no multi-layer clutter or overlapping annotations.
#
# g) New solver assumptions and generator guarantees
#    main() assumes:
#    - one regular rectangular divider lattice;
#    - at least one majority and one minority cell pattern;
#    - the minority motif has a unique dominant color and uses exactly one shared hole color;
#    - the visible minority subset identifies exactly one placement after scaled expansion.
#    generate_input() enforces those conditions by construction and rejects any sample that
#    fails the solver or makes the placement ambiguous.

SIZE_CONFIGS = (
    {"inner_h": 2, "inner_w": 3, "n_rows": 8, "n_cols": 10, "scales": (2, 3), "given_sizes": (4, 5, 6)},
    {"inner_h": 3, "inner_w": 2, "n_rows": 10, "n_cols": 8, "scales": (2, 3), "given_sizes": (4, 5, 6)},
    {"inner_h": 4, "inner_w": 3, "n_rows": 13, "n_cols": 11, "scales": (2, 3), "given_sizes": (5, 6, 7, 8)},
)
COLOR_POOL = 10
MAX_RETRIES = 500
SUBSET_TRIES = 180


def _infer_cell_grid_params(g: np.ndarray) -> tuple[int, int, list[int], list[int]]:
    """
    Infer a regular rectangular cell grid separated by full rows/cols of one line color.
    Returns (row_step, col_step, row_divs, col_divs).
    """
    h, w = g.shape
    line = int(g[0, 0])
    row_divs = [r for r in range(h) if np.all(g[r, :] == line)]
    col_divs = [c for c in range(w) if np.all(g[:, c] == line)]
    assert len(row_divs) >= 2 and len(col_divs) >= 2, "need at least 2 row and 2 col dividers"
    row_divs.sort()
    col_divs.sort()
    assert row_divs[0] == 0 and col_divs[0] == 0, "first divider must be at index 0"
    assert row_divs[-1] == h - 1 and col_divs[-1] == w - 1, "last divider must be at boundary"

    row_steps = [row_divs[i + 1] - row_divs[i] for i in range(len(row_divs) - 1)]
    col_steps = [col_divs[i + 1] - col_divs[i] for i in range(len(col_divs) - 1)]
    assert len(set(row_steps)) == 1 and len(set(col_steps)) == 1, "dividers must be regularly spaced"
    row_step = int(row_steps[0])
    col_step = int(col_steps[0])
    assert row_step > 1 and col_step > 1, "cell steps must exceed 1"
    assert (h - 1) % row_step == 0 and (w - 1) % col_step == 0, "grid dimensions must be k*step+1"
    return row_step, col_step, row_divs, col_divs


def _extract_patterns(
    g: np.ndarray, row_step: int, col_step: int
) -> tuple[dict[tuple[int, ...], np.ndarray], list[list[tuple[int, ...]]]]:
    """Extract every cell interior as both a flat key and a 2D array."""
    n_rows = (g.shape[0] - 1) // row_step
    n_cols = (g.shape[1] - 1) // col_step
    inner_h = row_step - 1
    inner_w = col_step - 1
    patterns: dict[tuple[int, ...], np.ndarray] = {}
    cell_pat: list[list[tuple[int, ...]]] = []
    for i in range(n_rows):
        row: list[tuple[int, ...]] = []
        for j in range(n_cols):
            r0 = i * row_step + 1
            c0 = j * col_step + 1
            pat_arr = g[r0 : r0 + inner_h, c0 : c0 + inner_w].copy()
            pat = tuple(int(v) for v in pat_arr.ravel())
            if pat not in patterns:
                patterns[pat] = pat_arr
            row.append(pat)
        cell_pat.append(row)
    return patterns, cell_pat


def _minority_mask_and_scale(minority_arr: np.ndarray) -> tuple[np.ndarray, int]:
    """
    Active color = most frequent value in the minority cell.
    Scale factor = number of non-active pixels + 1.
    """
    vals, cnts = np.unique(minority_arr, return_counts=True)
    order = np.argsort(cnts)
    active_color = int(vals[order[-1]])
    inactive_count = int(minority_arr.size - cnts[order[-1]])
    assert inactive_count in (1, 2), "minority motif must encode scale 2 or 3 via one or two holes"
    mask = minority_arr == active_color
    scale = inactive_count + 1
    return mask, int(scale)


def _scaled_mask(mask: np.ndarray, scale: int) -> np.ndarray:
    """Expand each blueprint pixel to a scale-by-scale coarse cell block."""
    return np.kron(mask.astype(bool), np.ones((scale, scale), dtype=bool))


def main(grid: np.ndarray) -> np.ndarray:
    """
    Complete a repeated cell mosaic after inferring both cell size and a separate expansion factor.

    Input structure:
    - The board is split by one-color divider rows and columns into equal rectangular cells.
    - Different samples use different cell interior sizes, so the cell lattice must be recovered
      from the divider spacing instead of assumed.
    - Most cells share one majority motif; a smaller visible subset uses one minority motif.

    Rule:
    - Infer the cell size, extract the minority cell interior, and read its dominant color as a
      boolean blueprint mask.
    - Count the minority cell's non-dominant pixels; that count plus one is the independent scale
      factor k.
    - Replace each blueprint pixel by a k-by-k block on the coarse cell grid, slide that expanded
      mask until the visible minority cells fit in exactly one place, then fill active blocks with
      the minority motif and inactive blocks with the majority motif.

    Key insight: The odd cell still contains the large-scale layout, but now it encodes two things
    at once: its geometry tells you the blueprint resolution, while its number of holes tells you
    how many coarse cells each blueprint pixel must grow into.
    """
    g = np.asarray(grid, dtype=int)
    row_step, col_step, _, _ = _infer_cell_grid_params(g)
    inner_h = row_step - 1
    inner_w = col_step - 1
    n_rows = (g.shape[0] - 1) // row_step
    n_cols = (g.shape[1] - 1) // col_step

    patterns, cell_pat = _extract_patterns(g, row_step, col_step)
    counts: dict[tuple[int, ...], int] = {}
    for row in cell_pat:
        for pat in row:
            counts[pat] = counts.get(pat, 0) + 1
    assert len(counts) >= 2, "must have at least 2 distinct cell patterns"

    minority_pat = min(counts.items(), key=lambda kv: kv[1])[0]
    majority_pat = max(counts.items(), key=lambda kv: kv[1])[0]
    minority_arr = patterns[minority_pat]
    majority_arr = patterns[majority_pat]

    mask, scale = _minority_mask_and_scale(minority_arr)
    coarse_mask = _scaled_mask(mask, scale)
    sh, sw = coarse_mask.shape

    existing = np.zeros((n_rows, n_cols), dtype=bool)
    for i in range(n_rows):
        for j in range(n_cols):
            existing[i, j] = cell_pat[i][j] == minority_pat

    candidates: list[tuple[int, int]] = []
    for top in range(n_rows - sh + 1):
        for left in range(n_cols - sw + 1):
            block = np.zeros_like(existing)
            block[top : top + sh, left : left + sw] = True
            if np.any(existing & ~block):
                continue
            ex_block = existing[top : top + sh, left : left + sw]
            if np.any(ex_block & ~coarse_mask):
                continue
            candidates.append((int(top), int(left)))
    assert len(candidates) == 1, "must have a unique scaled placement aligning minority cells"
    top, left = candidates[0]

    out = g.copy()
    for i in range(sh):
        for j in range(sw):
            target = minority_arr if coarse_mask[i, j] else majority_arr
            r0 = (top + i) * row_step + 1
            c0 = (left + j) * col_step + 1
            out[r0 : r0 + inner_h, c0 : c0 + inner_w] = target

