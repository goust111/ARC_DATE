+
+def _build_grid(
+    separator: int,
+    majority: np.ndarray,
+    minority: np.ndarray,
+    repaired: np.ndarray,
+    minority_cells: list[tuple[int, int]],
+    repaired_cells: list[tuple[int, int]],
