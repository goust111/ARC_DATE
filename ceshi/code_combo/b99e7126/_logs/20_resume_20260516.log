    return i * CELL_STEP + 1, j * CELL_STEP + 1


def _render_grid(separator: int, base_patterns: list[list[np.ndarray]], overrides: dict[tuple[int, int], np.ndarray]) -> np.ndarray:
    """Render a grid from per-cell base motifs plus selected overrides."""
    grid = np.full((GRID_SIZE, GRID_SIZE), separator, dtype=int)
    for i in range(CELL_GRID_N):
        for j in range(CELL_GRID_N):
            paste(grid, base_patterns[i][j], *_cell_origin(i, j))
    for (i, j), pat in overrides.items():
        paste(grid, pat, *_cell_origin(i, j))
    return grid


def _build_base_patterns(shared: int, accent_colors: list[int], blocked: set[tuple[int, ...]]) -> list[list[np.ndarray]] | None:
    """Sample 49 unique singleton motifs from a controlled LR-symmetric catalog."""
    pool: list[np.ndarray] = []
    for accent in accent_colors:
