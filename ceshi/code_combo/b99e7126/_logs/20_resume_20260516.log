_MASKS_BY_COUNT = _precompute_masks()


def _pattern_key(arr: np.ndarray) -> tuple[int, ...]:
    return tuple(int(v) for v in arr.ravel())


def _build_lr_pattern(color_a: int, color_b: int, picks: tuple[int, ...]) -> np.ndarray:
    """Materialize an LR-symmetric 3x3 pattern from 6 binary group picks."""
    arr = np.empty((MASK_SIZE, MASK_SIZE), dtype=int)
