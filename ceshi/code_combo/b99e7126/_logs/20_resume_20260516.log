+# Combo variant of b99e7126 (index 20)
+# combo_spec: D1/0+D7/2
+# Name: 频率排序 + 异常是多数
+
+from functools import reduce
+from itertools import combinations, product
+from math import gcd
+
+import numpy as np
+import random
+
+from arc_utils import paste
+
+
+# Design analysis for the combo variant
+# -------------------------------------
+# Concrete behavior shift:
+# - Base task: almost every cell shares one background motif, one minority motif repeats a few times,
+#   and the solver can reconstruct the whole 3x3 fractal block by toggling between minority/background.
+# - Here the inversion removes that background family entirely. Start from a 7x7 board where all 49
+#   cell interiors are unique, then overwrite only 3-4 cells with the same source motif in the input.
+#   Those repeated cells are a subset of a 3x3 mask whose full active count is 6-7 in the output.
+# - Example: if the source mask has 6 active pixels and the input shows source cells at three of those
+#   positions, the remaining 46 visible cells stay singleton distractors. The output only adds the
+#   missing three source copies; nothing ever restores a common background because none exists.
+#
+# Complexity calibration and observability:
+# - The board still uses a tight visual vocabulary: all singleton distractors are LR-symmetric 3x3 motifs
+#   built from one shared color plus one of three accent colors. This keeps the grid readable while making
+#   exact repeats easy to spot by eye.
+# - The only repeated motif family is the source motif, so the "frequency sorting" dimension survives as
+#   "ignore the sea of singletons and select the uniquely repeated family". That is visibly different from
+#   the original majority-background regime because the maximum exact frequency in generated inputs is only 3-4.
+#
+# Implicit-assumption audit against the original solver:
+# - `majority_pat = max(counts)` is no longer valid: there is no repeated background, so inactive cells
+#   inside the completion block must be left unchanged instead of overwritten.
+# - `minority_pat = min(counts)` is also invalid because most motifs are singletons; the source must be
+#   chosen from repeated motifs only.
+# - The placement test still works, but now it constrains only the repeated source cells. Distractor cells
+#   carry no semantic role in placement and must not participate in reconstruction.
+#
+# Generator guarantees matching the new solver assumptions:
+# - regular 7x7 cell lattice with 3x3 interiors and 1-pixel dividers
+# - exactly one repeated motif family in the input, shown 3-4 times
+# - every non-source cell motif is unique, so "anomaly is majority" is visually explicit
+# - the repeated source motif has a unique dominant color (6-7 pixels in its 3x3 interior)
+# - the shown subset of source cells yields a unique 3x3 placement under the source mask
+
+
+def _infer_cell_grid_params(g: np.ndarray) -> tuple[int, list[int], list[int]]:
+    """
+    Infer a regular cell grid separated by full rows/cols of the same line color.
+    Returns (step, row_divs, col_divs) where:
+      - row_divs/col_divs are divider indices
+      - step is the spacing between dividers (cell size including divider).
+    """
+    h, w = g.shape
+    line = int(g[0, 0])
+    row_divs = [r for r in range(h) if np.all(g[r, :] == line)]
+    col_divs = [c for c in range(w) if np.all(g[:, c] == line)]
+    assert len(row_divs) >= 2 and len(col_divs) >= 2, "need at least 2 row and 2 col dividers"
+    row_divs.sort()
+    col_divs.sort()
+    drs = [row_divs[i + 1] - row_divs[i] for i in range(len(row_divs) - 1) if row_divs[i + 1] > row_divs[i]]
+    dcs = [col_divs[i + 1] - col_divs[i] for i in range(len(col_divs) - 1) if col_divs[i + 1] > col_divs[i]]
+    step = reduce(gcd, drs + dcs)
+    assert step > 1, "divider step must be > 1"
+    assert row_divs[0] == 0 and col_divs[0] == 0, "first divider must be at index 0"
+    assert (h - 1) % step == 0 and (w - 1) % step == 0, "grid dimensions must be (k*step + 1)"
+    assert row_divs[-1] == h - 1 and col_divs[-1] == w - 1, "last divider must be at boundary"
+    return int(step), row_divs, col_divs
+
+
+def _extract_cell_patterns(g: np.ndarray, step: int) -> tuple[dict[tuple[int, ...], np.ndarray], list[list[tuple[int, ...]]]]:
+    """Extract each cell interior as both a flat tuple key and its 2D array."""
+    n = (g.shape[0] - 1) // step
+    inner = step - 1
+    patterns: dict[tuple[int, ...], np.ndarray] = {}
+    cell_pat: list[list[tuple[int, ...]]] = []
+    for i in range(n):
+        row: list[tuple[int, ...]] = []
+        for j in range(n):
+            r0 = i * step + 1
+            c0 = j * step + 1
+            pat_arr = g[r0 : r0 + inner, c0 : c0 + inner].copy()
+            pat = tuple(int(v) for v in pat_arr.ravel())
+            if pat not in patterns:
+                patterns[pat] = pat_arr
+            row.append(pat)
+        cell_pat.append(row)
+    return patterns, cell_pat
+
+
+def _count_patterns(cell_pat: list[list[tuple[int, ...]]]) -> dict[tuple[int, ...], int]:
+    """Count exact cell-interior motifs across the cell grid."""
+    counts: dict[tuple[int, ...], int] = {}
+    for row in cell_pat:
+        for pat in row:
+            counts[pat] = counts.get(pat, 0) + 1
+    return counts
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Complete a fractal overlay using the only repeated motif hidden inside a field of singletons.
+
+    Input structure:
+    - The board is partitioned into equal 3x3 cell interiors separated by one-color divider lines.
+    - Most cell motifs are all different from one another; exactly one motif family repeats 3-4 times.
+    - Those repeated cells are not noise: they are visible samples of a larger 3x3 source mask.
+
+    Rule:
+    - Count exact cell motifs and pick the uniquely least frequent repeated motif as the source, ignoring
+      singleton distractors.
+    - Read the source motif's dominant color as a boolean 3x3 mask and find the unique placement where the
+      shown source cells fit that mask.
+    - Overlay the source motif onto every missing active mask position, leaving every inactive cell exactly
+      as it already appears in the input.
+
+    Key insight: The search is inverted twice: the useful motif is not a lone oddball and there is no shared
+    background to restore. The solver must first notice that the only repeated motif is the "normal" family,
+    then treat its own pixel pattern as the blueprint for where more copies should be stamped.
+    """
+    g = np.asarray(grid, dtype=int)
+    step, _, _ = _infer_cell_grid_params(g)
+    n = (g.shape[0] - 1) // step
+    inner = step - 1
+
+    patterns, cell_pat = _extract_cell_patterns(g, step)
+    counts = _count_patterns(cell_pat)
+    repeated = sorted((pat, cnt) for pat, cnt in counts.items() if cnt >= 2)
+
+    assert len(counts) >= 4, "need many distinct motifs so the inversion is visible"
+    assert len(repeated) == 1, "combo expects exactly one repeated motif family"
+
+    source_pat, source_count = repeated[0]
+    source_arr = patterns[source_pat]
+    vals, cnts = np.unique(source_arr, return_counts=True)
+    order = np.argsort(cnts)[::-1]
+    assert len(order) >= 2 and cnts[order[0]] > cnts[order[1]], "source motif needs a unique dominant color"
+    active_color = int(vals[order[0]])
+    mask = source_arr == active_color
+    mh, mw = mask.shape
+    assert 2 <= source_count < int(mask.sum()), "input must show a strict subset of source cells"
+
+    existing = np.zeros((n, n), dtype=bool)
+    for i in range(n):
+        for j in range(n):
+            existing[i, j] = cell_pat[i][j] == source_pat
+
+    candidates: list[tuple[int, int]] = []
+    for top in range(0, n - mh + 1):
+        for left in range(0, n - mw + 1):
+            block = np.zeros_like(existing)
+            block[top : top + mh, left : left + mw] = True
+            if np.any(existing & ~block):
+                continue
+            ex_block = existing[top : top + mh, left : left + mw]
+            if np.any(ex_block & ~mask):
+                continue
+            candidates.append((int(top), int(left)))
+    assert len(candidates) == 1, "source motif must admit a unique placement"
+    top, left = candidates[0]
+
+    out = g.copy()
+    for i in range(mh):
+        for j in range(mw):
+            if not mask[i, j]:
+                continue
+            r0 = (top + i) * step + 1
+            c0 = (left + j) * step + 1
+            out[r0 : r0 + inner, c0 : c0 + inner] = source_arr
+    return out
+
+
+# --------------- generator ---------------
+
+CELL_GRID_N = 7
+CELL_STEP = 4
+GRID_SIZE = 29
+MASK_SIZE = 3
+PLACEMENT_RANGE = CELL_GRID_N - MASK_SIZE + 1
+ACTIVE_PIXEL_COUNTS = (6, 7)
+SOURCE_GIVEN_SIZES = (3, 4)
+COLOR_POOL = 10
+ACCENT_COLOR_COUNT = 3
+MAX_RETRIES = 400
+
+_LR_GROUPS = [
+    ((0, 0), (0, 2)),
+    ((1, 0), (1, 2)),
+    ((2, 0), (2, 2)),
+    ((0, 1),),
+    ((1, 1),),
+    ((2, 1),),
+]
+
+
+def _precompute_masks() -> dict[int, list[np.ndarray]]:
+    """Enumerate valid LR-symmetric 3x3 masks keyed by active-pixel count."""
+    weights = [len(group) for group in _LR_GROUPS]
+    by_count: dict[int, list[np.ndarray]] = {}
+    for active_count in ACTIVE_PIXEL_COUNTS:
+        inactive_count = MASK_SIZE * MASK_SIZE - active_count
+        masks: list[np.ndarray] = []
+        for k in range(1, len(_LR_GROUPS) + 1):
+            for combo in combinations(range(len(_LR_GROUPS)), k):
+                if sum(weights[i] for i in combo) != inactive_count:
+                    continue
+                mask = np.ones((MASK_SIZE, MASK_SIZE), dtype=bool)
+                for i in combo:
+                    for r, c in _LR_GROUPS[i]:
+                        mask[r, c] = False
+                if mask[0, :].any() and mask[-1, :].any() and mask[:, 0].any() and mask[:, -1].any():
+                    masks.append(mask)
+        by_count[active_count] = masks
+    return by_count
+
+
+_MASKS_BY_COUNT = _precompute_masks()
+
+
+def _pattern_key(arr: np.ndarray) -> tuple[int, ...]:
+    return tuple(int(v) for v in arr.ravel())
+
+
+def _build_lr_pattern(color_a: int, color_b: int, picks: tuple[int, ...]) -> np.ndarray:
+    """Materialize an LR-symmetric 3x3 pattern from 6 binary group picks."""
+    arr = np.empty((MASK_SIZE, MASK_SIZE), dtype=int)
+    for group, pick in zip(_LR_GROUPS, picks):
+        color = color_a if pick == 0 else color_b
+        for r, c in group:
+            arr[r, c] = color
+    return arr
+
+
+def _all_lr_patterns(color_a: int, color_b: int) -> list[np.ndarray]:
+    """Enumerate all non-uniform LR-symmetric 3x3 two-color patterns."""
+    pats: list[np.ndarray] = []
+    for picks in product((0, 1), repeat=len(_LR_GROUPS)):
+        if all(v == picks[0] for v in picks):
+            continue
+        pats.append(_build_lr_pattern(color_a, color_b, picks))
+    return pats
+
+
+def _random_source_mask() -> np.ndarray:
+    """Pick one valid source mask."""
+    active_count = random.choice(ACTIVE_PIXEL_COUNTS)
+    return random.choice(_MASKS_BY_COUNT[active_count]).copy()
+
+
+def _placement_candidates(mask: np.ndarray, subset: tuple[tuple[int, int], ...], top: int, left: int) -> list[tuple[int, int]]:
+    """Find every placement where the shown source cells could fit the source mask."""
+    existing = np.zeros((CELL_GRID_N, CELL_GRID_N), dtype=bool)
+    for r, c in subset:
+        existing[top + r, left + c] = True
+
+    candidates: list[tuple[int, int]] = []
+    for t in range(PLACEMENT_RANGE):
+        for l in range(PLACEMENT_RANGE):
+            block = np.zeros((CELL_GRID_N, CELL_GRID_N), dtype=bool)
+            block[t : t + MASK_SIZE, l : l + MASK_SIZE] = True
+            if np.any(existing & ~block):
+                continue
+            if np.any(existing[t : t + MASK_SIZE, l : l + MASK_SIZE] & ~mask):
+                continue
+            candidates.append((t, l))
+    return candidates
+
+
+def _choose_given_subset(mask: np.ndarray, top: int, left: int) -> tuple[tuple[int, int], ...] | None:
+    """Choose a strict subset of active cells that uniquely determines the placement."""
+    active = [tuple(int(v) for v in coord) for coord in np.argwhere(mask)]
+    sizes = list(SOURCE_GIVEN_SIZES)
+    random.shuffle(sizes)
+    for size in sizes:
+        valid = [
+            subset
+            for subset in combinations(active, size)
+            if _placement_candidates(mask, subset, top, left) == [(top, left)]
+        ]
+        if valid:
+            return random.choice(valid)
+    return None
+
+
+def _cell_origin(i: int, j: int) -> tuple[int, int]:
+    return i * CELL_STEP + 1, j * CELL_STEP + 1
+
+
+def _render_grid(separator: int, base_patterns: list[list[np.ndarray]], overrides: dict[tuple[int, int], np.ndarray]) -> np.ndarray:
+    """Render a grid from per-cell base motifs plus selected overrides."""
+    grid = np.full((GRID_SIZE, GRID_SIZE), separator, dtype=int)
+    for i in range(CELL_GRID_N):
+        for j in range(CELL_GRID_N):
+            paste(grid, base_patterns[i][j], *_cell_origin(i, j))
+    for (i, j), pat in overrides.items():
+        paste(grid, pat, *_cell_origin(i, j))
+    return grid
+
+
+def _build_base_patterns(shared: int, accent_colors: list[int], blocked: set[tuple[int, ...]]) -> list[list[np.ndarray]] | None:
+    """Sample 49 unique singleton motifs from a controlled LR-symmetric catalog."""
+    pool: list[np.ndarray] = []
+    for accent in accent_colors:
+        for pat in _all_lr_patterns(shared, accent):
+            if _pattern_key(pat) in blocked:
+                continue
+            pool.append(pat)
+    if len(pool) < CELL_GRID_N * CELL_GRID_N:
+        return None
+
+    chosen = random.sample(pool, CELL_GRID_N * CELL_GRID_N)
+    base_patterns: list[list[np.ndarray]] = []
+    idx = 0
+    for i in range(CELL_GRID_N):
+        row: list[np.ndarray] = []
+        for j in range(CELL_GRID_N):
+            row.append(chosen[idx])
+            idx += 1
+        base_patterns.append(row)
+    return base_patterns
+
+
+def _input_signature(grid: np.ndarray) -> tuple[int, list[int]]:
+    """Return (singleton_count, sorted repeated counts) for exact cell motifs."""
+    step, _, _ = _infer_cell_grid_params(grid)
+    _, cell_pat = _extract_cell_patterns(grid, step)
+    counts = _count_patterns(cell_pat)
+    singleton_count = sum(1 for cnt in counts.values() if cnt == 1)
+    repeated = sorted(cnt for cnt in counts.values() if cnt >= 2)
+    return singleton_count, repeated
+
+
+def _gen_attempt() -> np.ndarray | None:
+    """Build one valid input for the fused inversion+frequency variant."""
+    colors = random.sample(range(COLOR_POOL), 3 + ACCENT_COLOR_COUNT)
+    separator, shared, src_color, *accent_colors = colors
+
+    mask = _random_source_mask()
+    source = np.where(mask, src_color, shared).astype(int)
+    base_patterns = _build_base_patterns(shared, accent_colors, blocked={_pattern_key(source)})
+    if base_patterns is None:
+        return None
+
+    top = random.randrange(PLACEMENT_RANGE)
+    left = random.randrange(PLACEMENT_RANGE)
+    active_cells = [(top + int(r), left + int(c)) for r, c in np.argwhere(mask)]
+
+    subset = _choose_given_subset(mask, top, left)
+    if subset is None:
+        return None
+    given_cells = [(top + r, left + c) for r, c in subset]
+
+    inp = _render_grid(separator, base_patterns, {(i, j): source for i, j in given_cells})
+    out = _render_grid(separator, base_patterns, {(i, j): source for i, j in active_cells})
+
+    singleton_count, repeated = _input_signature(inp)
+    assert repeated == [len(given_cells)]
+    assert singleton_count == CELL_GRID_N * CELL_GRID_N - len(given_cells)
+
+    try:
+        solved = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(solved, out):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid b99e7126 combo input")

