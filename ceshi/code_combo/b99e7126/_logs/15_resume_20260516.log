#      swaps the two colors inside that inherited template.
#    Small trace: if cell (top+1,left+2) normally contains a template with one accent at local pixel
#      (1,2), the output there becomes the color-swapped version of that exact template, not the minority
#      template and not one global swap pattern reused everywhere.
# b) Complexity calibration:
#    Using 9 residue-class templates keeps the inheritance effect visible across the board, while still
#    giving repeated evidence for each template. Each template is only two colors, so the color-swap rule
#    remains easy to see. Minority anchors are kept at exactly 3 cells so the rare pattern stays the unique
#    least-frequent cell type; if anchors were 4, some residue templates would tie with it in a 7x7 board.
# c) Hidden-assumption audit against the original main():
#    - Grid inference and divider parsing stay valid.
#    - Counting "majority vs minority" no longer works: there is one minority template plus nine repeated
#      position templates, so any logic depending on a single dominant majority tile must be removed.
#    - The original final overwrite loop assumed every active site gets identical content; this fused rule
#      breaks that assumption because output content depends on absolute position before the swap.
#    - Recovering inherited content now assumes each residue class has exemplars outside the 3x3 target
#      block. On a 7x7 grid each class appears 4/6/9 times; the generator preserves at least 3 outside
#      every class and never uses low-frequency classes as minority anchors.
# d) Placement legality:
#    The scaled 3x3 mask still fits only with top/left in 0..4. Minority clues are chosen from active
#    sites whose residue-class templates remain common enough after replacement, and the subset is accepted
#    only if the placement search returns exactly one candidate.
# e) Visual observability:
#    Humans can see the base field repeating nine local accent placements. In the output, the hit region
#    does not become a flat copied motif; each active cell flips whatever template already belongs there.
#    That makes the result read like a local "invert filter" on existing detail, which is the intended
#    fused behavior.
# f) Visual cleanliness:
#    There is only one structured background field plus one localized transformed block. Divider lines stay
#    untouched, and the minority anchors remain sparse, so the board stays readable.
# g) Change inferability:
#    Only four colors are used: divider, shared background, repeated accent, and minority-anchor color.
#    The color change is not keyed to hidden color ids; it is supported by repeated residue templates and
#    by the fact that active outputs become exact two-color inversions of those templates.
# Post-edit assumption audit:
#    - `_swap_two_colors()` requires inherited templates to contain exactly two colors; generator enforces
#      that by using one accent pixel over a shared-color fill.
#    - `minority_pat = min(counts...)` requires the minority anchor count to be strictly smallest; the
#      generator fixes clue count at 3 and never chooses clue positions from the 4-count residue classes.
#    - Residue-template recovery assumes no non-minority distractor pattern exists outside the target block;
#      generator fills the whole board from the same 9-template field.


def _infer_cell_grid_params(g: np.ndarray) -> tuple[int, list[int], list[int]]:
    """
    Infer a regular cell grid separated by full rows/cols of the same line color.
    Returns (step, row_divs, col_divs) where:
      - row_divs/col_divs are divider indices
      - step is the spacing between dividers (cell size including divider).
    """
    h, w = g.shape
    line = int(g[0, 0])
    row_divs = [r for r in range(h) if np.all(g[r, :] == line)]
    col_divs = [c for c in range(w) if np.all(g[:, c] == line)]
    assert len(row_divs) >= 2 and len(col_divs) >= 2, "need at least 2 row and 2 col dividers"
    row_divs.sort()
    col_divs.sort()
    drs = [row_divs[i + 1] - row_divs[i] for i in range(len(row_divs) - 1) if row_divs[i + 1] > row_divs[i]]
    dcs = [col_divs[i + 1] - col_divs[i] for i in range(len(col_divs) - 1) if col_divs[i + 1] > col_divs[i]]
    step = reduce(gcd, drs + dcs)
    assert step > 1, "divider step must be > 1"
    assert row_divs[0] == 0 and col_divs[0] == 0, "first divider must be at index 0"
    assert (h - 1) % step == 0 and (w - 1) % step == 0, "grid dimensions must be (k*step + 1)"
    assert row_divs[-1] == h - 1 and col_divs[-1] == w - 1, "last divider must be at boundary"
    return int(step), row_divs, col_divs


def _extract_cell_patterns(g: np.ndarray, step: int) -> tuple[dict[tuple[int, ...], np.ndarray], list[list[tuple[int, ...]]]]:
    """Extract every cell interior as both an array and a hashable flat tuple."""
    n = (g.shape[0] - 1) // step
    inner = step - 1
    patterns: dict[tuple[int, ...], np.ndarray] = {}
    cell_pat: list[list[tuple[int, ...]]] = []
    for i in range(n):
        row: list[tuple[int, ...]] = []
        for j in range(n):
            r0 = i * step + 1
            c0 = j * step + 1
            pat_arr = g[r0 : r0 + inner, c0 : c0 + inner].copy()
            pat = tuple(pat_arr.ravel().tolist())
            if pat not in patterns:
                patterns[pat] = pat_arr
            row.append(pat)
        cell_pat.append(row)
    return patterns, cell_pat


def _count_patterns(cell_pat: list[list[tuple[int, ...]]]) -> dict[tuple[int, ...], int]:
    counts: dict[tuple[int, ...], int] = {}
    for row in cell_pat:
        for pat in row:
            counts[pat] = counts.get(pat, 0) + 1
    return counts


def _most_common(items: list[tuple[int, ...]]) -> tuple[int, ...]:
    counts: dict[tuple[int, ...], int] = {}
    for item in items:
        counts[item] = counts.get(item, 0) + 1
    assert counts, "expected at least one pattern"
    return max(counts.items(), key=lambda kv: kv[1])[0]


def _swap_two_colors(arr: np.ndarray) -> np.ndarray:
    """Return a copy of arr with its two present colors exchanged."""
    vals = [int(v) for v in np.unique(arr)]
    assert len(vals) == 2, "color-swap overlay requires exactly two colors per inherited template"
    a, b = vals
    out = arr.copy()
    mask_a = out == a
    mask_b = out == b
    out[mask_a] = b
    out[mask_b] = a
    return out


def _find_unique_mask_placement(
    cell_pat: list[list[tuple[int, ...]]], minority_pat: tuple[int, ...], mask: np.ndarray
) -> tuple[int, int]:
    """Locate the unique top-left placement whose active cells can contain all minority anchors."""
    n = len(cell_pat)
    mh, mw = mask.shape
    existing = np.zeros((n, n), dtype=bool)
    for i in range(n):
        for j in range(n):
            existing[i, j] = cell_pat[i][j] == minority_pat

    candidates: list[tuple[int, int]] = []
    for top in range(0, n - mh + 1):
        for left in range(0, n - mw + 1):
            block = np.zeros_like(existing)
            block[top : top + mh, left : left + mw] = True
            if np.any(existing & ~block):
                continue
            ex_block = existing[top : top + mh, left : left + mw]
            if np.any(ex_block & ~mask):
                continue
            candidates.append((int(top), int(left)))
    assert len(candidates) == 1, "must have a unique mask placement aligning existing minority cells"
    return candidates[0]


def _recover_residue_templates(
    cell_pat: list[list[tuple[int, ...]]],
    patterns: dict[tuple[int, ...], np.ndarray],
    minority_pat: tuple[int, ...],
    top: int,
    left: int,
    mh: int,
    mw: int,
) -> dict[tuple[int, int], np.ndarray]:
    """Infer the base template for each absolute residue class from cells outside the target block."""
    n = len(cell_pat)
    residue_templates: dict[tuple[int, int], np.ndarray] = {}
    for ri in range(mh):
        for cj in range(mw):
            samples: list[tuple[int, ...]] = []
            for i in range(n):
                for j in range(n):
                    if top <= i < top + mh and left <= j < left + mw:
                        continue
                    if i % mh != ri or j % mw != cj:
                        continue
                    pat = cell_pat[i][j]
                    if pat == minority_pat:
                        continue
                    samples.append(pat)
            residue_templates[(ri, cj)] = patterns[_most_common(samples)]
    return residue_templates


def main(grid: np.ndarray) -> np.ndarray:
    """
    Locate the odd-cell stencil, recover the position-dependent base field, and swap colors through it.

    Input structure:
    - The 29x29 board is split into a 7x7 lattice of 3x3 cell interiors by one divider color.
    - Most cells belong to a repeating position-coded template field; only a few cells share one rarer
      minority pattern that serves as visible anchors for the hidden 3x3 stencil.

    Rule:
    - Interpret the minority cell's dominant-color layout as a 3x3 boolean mask and place it uniquely so
      that all visible minority anchors lie on active sites.
    - Recover, for each absolute residue class modulo 3, the template that normally belongs there by
      looking at matching cells outside the target block.
    - Rebuild the 3x3 block from those inherited templates, but on active mask sites swap the two colors
      inside the inherited template instead of copying the minority cell.

    Key insight:
    - The odd cell still tells you where the enlarged region lives, but it no longer supplies the output
      colors directly. The enlarged region acts like a local inversion filter applied to the board's own
      repeated detail field.
    """
    g = np.asarray(grid, dtype=int)
    step, _, _ = _infer_cell_grid_params(g)
    inner = step - 1

    patterns, cell_pat = _extract_cell_patterns(g, step)
    counts = _count_patterns(cell_pat)
    assert len(counts) >= 10, "need one minority pattern plus a repeated position-template field"

    minority_pat = min(counts.items(), key=lambda kv: kv[1])[0]
    minority_arr = patterns[minority_pat]

    vals, cnts = np.unique(minority_arr, return_counts=True)
    active_color = int(vals[cnts.argmax()])
    mask = minority_arr == active_color
    mh, mw = mask.shape

    top, left = _find_unique_mask_placement(cell_pat, minority_pat, mask)
    residue_templates = _recover_residue_templates(cell_pat, patterns, minority_pat, top, left, mh, mw)

    out = g.copy()
    for i in range(mh):
        for j in range(mw):
            base_pat = residue_templates[((top + i) % mh, (left + j) % mw)]
            target_pat = _swap_two_colors(base_pat) if mask[i, j] else base_pat
            r0 = (top + i) * step + 1
            c0 = (left + j) * step + 1
            out[r0 : r0 + inner, c0 : c0 + inner] = target_pat
    return out


