+# Combo variant of b99e7126 (index 15)
+# combo_spec: D1/2+D13/2
+# Name: 位置规则选择 + 镜像后对齐叠加
+
+# Design analysis for the D1/2 + D13/2 fused variant
+# a) Concrete behavior and trace:
+#    - The original task uses one globally rare cell pattern as both the source blueprint and the visible
+#      clue pattern. Its dominant-color mask is enlarged directly, without any orientation change.
+#    - This fused variant separates "where to read the blueprint" from "which cells are already active".
+#      Four identical source cells sit at the middle of the four sides of the 7x7 cell board. They are
+#      not anomalies in the original sense because the same source pattern appears four times.
+#    - The hidden enlarged 3x3 block sits near one side of the board. That side chooses the source cell:
+#      top block -> top source, bottom block -> bottom source, left block -> left source, right block ->
+#      right source. The chosen source pattern is mirrored before enlargement: top/bottom use vertical
+#      flipping, left/right use horizontal flipping.
+#    - Small trace:
+#      original: rare cell P -> mask(P) -> place P itself at every active coarse site.
+#      fused: side sources all show S -> choose the side matching the clue block -> mirror S along the
+#      side-dependent axis -> place mirror(S) at every active coarse site.
+#      The visible clue cells in the block already use mirror(S), not S.
+# b) Complexity calibration:
+#    - Restricting the block to one of four side-adjacent zones makes the position rule legible from a
+#      few ARC examples: the active cluster is visibly top/bottom/left/right biased.
+#    - Using exactly one repeated source pattern on all four sides keeps the D1 behavior real. The source
+#      cannot be recovered by rarity or by "pick the weirdest tile"; it must be recovered from position.
+#    - The source mask uses 6-7 active pixels, touches all four edges, and is asymmetric under both flips.
+#      That makes the mirror effect visually obvious while keeping the pattern easy to track.
+# c) Hidden-assumption audit against the original solver:
+#    - `minority_pat = min(counts...)` is invalid now: the source appears four times and clue cells use a
+#      different mirrored pattern. Solver must read the source from fixed positions instead of frequency.
+#    - The original code assumed the observed clue tiles and the source tile are the same pattern. That
+#      breaks here because observed clue cells contain the mirrored source pattern.
+#    - The old placement scan assumed every top/left offset was admissible. Here admissible placements are
+#      side-specific because the chosen side is part of the rule.
+#    - The original final loop copied one untransformed pattern. Here the copied pattern depends on the
+#      chosen side through a mirror transform.
+# d) Placement legality:
+#    - The enlarged 3x3 block is limited to four side-adjacent placement families that never overlap the
+#      four side-center source cells.
+#    - All writes stay within the 7x7 cell board; generator-side active cells are exactly the true sites of
+#      the mirrored source mask for the chosen placement.
+# e) Visual observability:
+#    - A human sees the same 3x3 source tile repeated on all four sides and a partial block of matching-but-
+#      flipped clue cells near one side. Across examples, the active block side and the mirror axis agree.
+#    - No hidden color ordering is used. The side category is visible geometrically, and the flip is visible
+#      because the source pattern is deliberately asymmetric.
+# f) Visual cleanliness:
+#    - There are only three semantic layers: the majority field, the four side-center source tiles, and one
+#      localized enlarged block. The block is kept away from the side-center sources so the picture remains
+#      readable.
+# g) Change inferability:
+#    - Only four colors are used: divider, majority-exclusive, shared, and source-active. Color changes are
+#      structural rather than numeric: the output uses the mirrored source pattern because of where the block
+#      sits, not because of any hidden color ranking.
+# 9) New solver assumptions and generator guarantees:
+#    - Solver assumes the four side-center cells all share one source pattern; generator constructs exactly
+#      that.
+#    - Solver assumes the source pattern is non-symmetric under both flips and that its mirrored versions are
+#      distinct from both the source and the majority tile; generator rejects samples that violate this.
+#    - Solver assumes exactly one side-specific placement is consistent with the visible clue subset; the
+#      generator only accepts uniquely placed subsets.
+
+from functools import reduce
+from itertools import combinations
+from math import gcd
+from pathlib import Path
+import random
+import sys
+
+import numpy as np
+
+for _parent in Path(__file__).resolve().parents:
+    _solver_dir = _parent / "solvers"
+    if _solver_dir.is_dir():
+        if str(_solver_dir) not in sys.path:
+            sys.path.append(str(_solver_dir))
+        break
+else:
+    raise RuntimeError("could not locate solvers directory")
+
+from arc_utils import paste
+
+
+def _infer_cell_grid_params(g: np.ndarray) -> tuple[int, list[int], list[int]]:
+    """
+    Infer a regular cell grid separated by full rows/cols of the same line color.
+    Returns (step, row_divs, col_divs) where:
+      - row_divs/col_divs are divider indices
+      - step is the spacing between dividers (cell size including divider).
+    """
+    h, w = g.shape
+    line = int(g[0, 0])
+    row_divs = [r for r in range(h) if np.all(g[r, :] == line)]
+    col_divs = [c for c in range(w) if np.all(g[:, c] == line)]
+    assert len(row_divs) >= 2 and len(col_divs) >= 2, "need at least 2 row and 2 col dividers"
+    row_divs.sort()
+    col_divs.sort()
+    drs = [row_divs[i + 1] - row_divs[i] for i in range(len(row_divs) - 1) if row_divs[i + 1] > row_divs[i]]
+    dcs = [col_divs[i + 1] - col_divs[i] for i in range(len(col_divs) - 1) if col_divs[i + 1] > col_divs[i]]
+    step = reduce(gcd, drs + dcs)
+    assert step > 1, "divider step must be > 1"
+    assert row_divs[0] == 0 and col_divs[0] == 0, "first divider must be at index 0"
+    assert (h - 1) % step == 0 and (w - 1) % step == 0, "grid dimensions must be (k*step + 1)"
+    assert row_divs[-1] == h - 1 and col_divs[-1] == w - 1, "last divider must be at boundary"
+    return int(step), row_divs, col_divs
+
+
+def _extract_cell_patterns(g: np.ndarray, step: int) -> tuple[dict[tuple[int, ...], np.ndarray], list[list[tuple[int, ...]]]]:
+    """Extract each cell interior as both an array and a hashable flat tuple."""
+    n = (g.shape[0] - 1) // step
+    inner = step - 1
+    patterns: dict[tuple[int, ...], np.ndarray] = {}
+    cell_pat: list[list[tuple[int, ...]]] = []
+    for i in range(n):
+        row: list[tuple[int, ...]] = []
+        for j in range(n):
+            r0 = i * step + 1
+            c0 = j * step + 1
+            arr = g[r0 : r0 + inner, c0 : c0 + inner].copy()
+            pat = tuple(arr.ravel().tolist())
+            if pat not in patterns:
+                patterns[pat] = arr
+            row.append(pat)
+        cell_pat.append(row)
+    return patterns, cell_pat
+
+
+def _count_patterns(cell_pat: list[list[tuple[int, ...]]]) -> dict[tuple[int, ...], int]:
+    counts: dict[tuple[int, ...], int] = {}
+    for row in cell_pat:
+        for pat in row:
+            counts[pat] = counts.get(pat, 0) + 1
+    return counts
+
+
+def _selector_positions(n: int) -> dict[str, tuple[int, int]]:
+    mid = n // 2
+    return {
+        "top": (0, mid),
+        "bottom": (n - 1, mid),
+        "left": (mid, 0),
+        "right": (mid, n - 1),
+    }
+
+
+def _allowed_side_placements(n: int, mask_h: int, mask_w: int) -> dict[str, list[tuple[int, int]]]:
+    """Side-specific placement families; for this task n=7 and mask size is 3x3."""
+    assert n == 7 and mask_h == 3 and mask_w == 3, "combo is calibrated for 7x7 cells and a 3x3 source mask"
+    return {
+        "top": [(1, 1), (1, 2)],
+        "bottom": [(3, 1), (3, 2)],
+        "left": [(1, 1), (2, 1)],
+        "right": [(1, 3), (2, 3)],
+    }
+
+
+def _transform_for_side(arr: np.ndarray, side: str) -> np.ndarray:
+    """Mirror the source pattern according to the chosen side."""
+    if side in ("top", "bottom"):
+        return np.flipud(arr)
+    if side in ("left", "right"):
+        return np.fliplr(arr)
+    raise AssertionError(f"unknown side: {side}")
+
+
+def _dominant_mask(arr: np.ndarray) -> np.ndarray:
+    vals, cnts = np.unique(arr, return_counts=True)
+    order = np.argsort(cnts)
+    assert len(order) >= 2 and cnts[order[-1]] > cnts[order[-2]], "source pattern needs a unique dominant color"
+    return arr == int(vals[order[-1]])
+
+
+def _find_side_and_placement(
+    cell_pat: list[list[tuple[int, ...]]],
+    transformed_pats: dict[str, tuple[int, ...]],
+    allowed: dict[str, list[tuple[int, int]]],
+    masks: dict[str, np.ndarray],
+) -> tuple[str, int, int]:
+    """
+    Jointly recover the side-selected source and the 3x3 block placement.
+    Each side contributes its own mirrored pattern and allowed placement family.
+    """
+    n = len(cell_pat)
+    matches: list[tuple[str, int, int]] = []
+    for side, transformed_pat in transformed_pats.items():
+        existing = np.zeros((n, n), dtype=bool)
+        for i in range(n):
+            for j in range(n):
+                existing[i, j] = cell_pat[i][j] == transformed_pat
+        if not existing.any():
+            continue
+        mask = masks[side]
+        mh, mw = mask.shape
+        for top, left in allowed[side]:
+            block = np.zeros_like(existing)
+            block[top : top + mh, left : left + mw] = True
+            if np.any(existing & ~block):
+                continue
+            ex_block = existing[top : top + mh, left : left + mw]
+            if np.any(ex_block & ~mask):
+                continue
+            matches.append((side, int(top), int(left)))
+    assert len(matches) == 1, "must have a unique side-specific mirrored placement"
+    return matches[0]
+
+
+def _solve_core(grid: np.ndarray, *, use_flip: bool) -> tuple[np.ndarray, str, int]:
+    """Shared solver path; `use_flip=False` is used only for anti-degeneration checks."""
+    g = np.asarray(grid, dtype=int)
+    step, _, _ = _infer_cell_grid_params(g)
+    n = (g.shape[0] - 1) // step
+    inner = step - 1
+
+    patterns, cell_pat = _extract_cell_patterns(g, step)
+    counts = _count_patterns(cell_pat)
+    assert len(counts) >= 3, "need majority, side source, and at least one mirrored clue cell"
+
+    selector_pos = _selector_positions(n)
+    source_keys = {cell_pat[i][j] for i, j in selector_pos.values()}
+    assert len(source_keys) == 1, "all four side-center source cells must share one pattern"
+    source_pat = next(iter(source_keys))
+    source_arr = patterns[source_pat]
+
+    majority_pat = max(counts.items(), key=lambda kv: kv[1])[0]
+    majority_arr = patterns[majority_pat]
+
+    masks: dict[str, np.ndarray] = {}
+    transformed_pats: dict[str, tuple[int, ...]] = {}
+    transformed_arrs: dict[str, np.ndarray] = {}
+    for side in selector_pos:
+        arr_t = _transform_for_side(source_arr, side) if use_flip else source_arr
+        transformed_arrs[side] = arr_t
+        masks[side] = _dominant_mask(arr_t)
+        transformed_pats[side] = tuple(arr_t.ravel().tolist())
+
+    allowed = _allowed_side_placements(n, inner, inner)
+    side, top, left = _find_side_and_placement(cell_pat, transformed_pats, allowed, masks)
+
+    out = g.copy()
+    target_arr = transformed_arrs[side]
+    target_mask = masks[side]
+    for i in range(inner):
+        for j in range(inner):
+            stamp = target_arr if target_mask[i, j] else majority_arr
+            r0 = (top + i) * step + 1
+            c0 = (left + j) * step + 1
+            out[r0 : r0 + inner, c0 : c0 + inner] = stamp
+    return out, side, int(target_mask.sum())
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Choose a source cell by side position, mirror it according to that side, and complete the enlarged block.
+
+    Input structure:
+    - The board is a 7x7 lattice of 3x3 cell interiors separated by one divider color.
+    - One majority tile fills most cells.
+    - The same source tile appears exactly at the four side-center positions of the cell grid.
+    - A few interior clue cells already show a mirrored copy of that source tile, forming a strict subset of
+      one hidden 3x3 enlarged block.
+
+    Rule:
+    - Pick the side-center source that matches the side where the clue block sits.
+    - Mirror the source before enlargement: top/bottom sources flip vertically, left/right sources flip
+      horizontally.
+    - Read the mirrored source tile's dominant-color layout as a 3x3 activity mask and place that mask in the
+      side-specific zone so the visible clue cells land on active positions.
+    - Fill every active coarse cell of that 3x3 block with the mirrored source tile; leave inactive cells as
+      the majority tile.
+
+    Key insight:
+    The repeated side-center tile is only a blueprint pool. Its absolute side position tells you both which
+    copy to use and which mirror axis to apply before the usual fractal-style enlargement.
+    """
+    return _solve_core(grid, use_flip=True)[0]
+
+
+# --------------- generator (combo) ---------------
+
+CELL_GRID_N = 7
+CELL_INNER = 3
+CELL_STEP = 4
+GRID_SIZE = CELL_GRID_N * CELL_STEP + 1
+COLOR_POOL = 10
+GIVEN_CELL_SIZES = (3, 4)
+MAX_RETRIES = 400
+
+SIDE_ORDER = ("top", "bottom", "left", "right")
+ACTIVE_PIXEL_COUNTS = (6, 7)
+
+_SELECTOR_POS = _selector_positions(CELL_GRID_N)
+_SIDE_PLACEMENTS = _allowed_side_placements(CELL_GRID_N, CELL_INNER, CELL_INNER)
+
+
+def _precompute_source_masks() -> list[np.ndarray]:
+    """Readable 3x3 masks: edge-spanning, connected, and asymmetric under both flips."""
+    masks: list[np.ndarray] = []
+    for bits in range(1 << (CELL_INNER * CELL_INNER)):
+        mask = np.array([(bits >> k) & 1 for k in range(CELL_INNER * CELL_INNER)], dtype=bool).reshape(CELL_INNER, CELL_INNER)
+        active = int(mask.sum())
+        if active not in ACTIVE_PIXEL_COUNTS:
+            continue
+        if not mask[0, :].any() or not mask[2, :].any() or not mask[:, 0].any() or not mask[:, 2].any():
+            continue
+        coords = [tuple(rc) for rc in np.argwhere(mask)]
+        seen = {coords[0]}
+        frontier = [coords[0]]
+        while frontier:
+            r, c = frontier.pop()
+            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                nr, nc = r + dr, c + dc
+                if 0 <= nr < CELL_INNER and 0 <= nc < CELL_INNER and mask[nr, nc] and (nr, nc) not in seen:
+                    seen.add((nr, nc))
+                    frontier.append((nr, nc))
+        if len(seen) != active:
+            continue
+        if np.array_equal(mask, np.flipud(mask)) or np.array_equal(mask, np.fliplr(mask)):
+            continue
+        if np.array_equal(np.flipud(mask), np.fliplr(mask)):
+            continue
+        masks.append(mask)
+    return masks
+
+
+_SOURCE_MASKS = _precompute_source_masks()
+
+
+def _random_majority_pattern(shared: int, exclusive: int) -> np.ndarray:
+    """Build a readable non-uniform 3x3 majority tile using two colors."""
+    while True:
+        arr = np.array(
+            [[random.choice((shared, exclusive)) for _ in range(CELL_INNER)] for _ in range(CELL_INNER)],
+            dtype=int,
+        )
+        vals = np.unique(arr)
+        if len(vals) == 2:
+            return arr
+
+
+def _cell_origin(i: int, j: int) -> tuple[int, int]:
+    return i * CELL_STEP + 1, j * CELL_STEP + 1
+
+
+def _build_grid(separator: int, majority: np.ndarray, source: np.ndarray, side: str, active_cells: list[tuple[int, int]]) -> np.ndarray:
+    """Construct the full grid with majority background, four side-center sources, and active mirrored cells."""
+    transformed = _transform_for_side(source, side)
+    grid = np.full((GRID_SIZE, GRID_SIZE), separator, dtype=int)
+    for i in range(CELL_GRID_N):
+        for j in range(CELL_GRID_N):
+            paste(grid, majority, *_cell_origin(i, j))
+    for i, j in _SELECTOR_POS.values():
+        paste(grid, source, *_cell_origin(i, j))
+    for i, j in active_cells:
+        paste(grid, transformed, *_cell_origin(i, j))
+    return grid
+
+
+def _placement_cells(mask: np.ndarray, top: int, left: int) -> list[tuple[int, int]]:
+    return [(top + r, left + c) for r, c in np.argwhere(mask)]
+
+
+def _all_solution_candidates(grid: np.ndarray) -> list[tuple[str, int, int]]:
+    """Enumerate every side/placement pair consistent with the visible mirrored clue cells."""
+    g = np.asarray(grid, dtype=int)
+    step, _, _ = _infer_cell_grid_params(g)
+    patterns, cell_pat = _extract_cell_patterns(g, step)
+    source_keys = {cell_pat[i][j] for i, j in _SELECTOR_POS.values()}
+    if len(source_keys) != 1:
+        return []
+    source_pat = next(iter(source_keys))
+    source_arr = patterns[source_pat]
+
+    candidates: list[tuple[str, int, int]] = []
+    for side in SIDE_ORDER:
+        transformed = _transform_for_side(source_arr, side)
+        transformed_pat = tuple(transformed.ravel().tolist())
+        existing = np.zeros((CELL_GRID_N, CELL_GRID_N), dtype=bool)
+        for i in range(CELL_GRID_N):
+            for j in range(CELL_GRID_N):
+                existing[i, j] = cell_pat[i][j] == transformed_pat
+        if not existing.any():
+            continue
+        mask = _dominant_mask(transformed)
+        for top, left in _SIDE_PLACEMENTS[side]:
+            block = np.zeros_like(existing)
+            block[top : top + CELL_INNER, left : left + CELL_INNER] = True
+            if np.any(existing & ~block):
+                continue
+            ex_block = existing[top : top + CELL_INNER, left : left + CELL_INNER]
+            if np.any(ex_block & ~mask):
+                continue
+            candidates.append((side, int(top), int(left)))
+    return candidates
+
+
+def _choose_subset(
+    side: str,
+    source: np.ndarray,
+    majority: np.ndarray,
+    mask: np.ndarray,
+    top: int,
+    left: int,
+) -> tuple[tuple[int, int], ...] | None:
+    """Choose a clue subset whose side-aware placement is unique."""
+    probe_source = np.where(_dominant_mask(source), 3, 2).astype(int)
+    probe_majority = np.array([[1, 2, 1], [2, 1, 2], [1, 2, 1]], dtype=int)
+    if np.array_equal(probe_majority, probe_source):
+        probe_majority = np.array([[1, 1, 2], [2, 2, 1], [1, 2, 2]], dtype=int)
+    active = [tuple(coord) for coord in np.argwhere(mask)]
+    sizes = list(GIVEN_CELL_SIZES)
+    random.shuffle(sizes)
+    for size in sizes:
+        valid: list[tuple[tuple[int, int], ...]] = []
+        for subset in combinations(active, size):
+            active_cells = [(top + r, left + c) for r, c in subset]
+            probe = _build_grid(4, probe_majority, probe_source, side, active_cells)
+            if _all_solution_candidates(probe) == [(side, top, left)]:
+                valid.append(tuple((top + r, left + c) for r, c in subset))
+        if valid:
+            return random.choice(valid)
+    return None
+
+
+def _baseline_no_flip_output(grid: np.ndarray) -> np.ndarray:
+    """Ablated baseline: recover the true side/placement, but stamp the unmirrored source tile."""
+    g = np.asarray(grid, dtype=int)
+    step, _, _ = _infer_cell_grid_params(g)
+    n = (g.shape[0] - 1) // step
+    inner = step - 1
+
+    patterns, cell_pat = _extract_cell_patterns(g, step)
+    counts = _count_patterns(cell_pat)
+    assert len(counts) >= 3, "need majority, side source, and mirrored clue cells"
+
+    selector_pos = _selector_positions(n)
+    source_keys = {cell_pat[i][j] for i, j in selector_pos.values()}
+    assert len(source_keys) == 1, "all side-center source cells must match"
+    source_pat = next(iter(source_keys))
+    source_arr = patterns[source_pat]
+    majority_pat = max(counts.items(), key=lambda kv: kv[1])[0]
+    majority_arr = patterns[majority_pat]
+
+    true_masks = {side: _dominant_mask(_transform_for_side(source_arr, side)) for side in selector_pos}
+    true_pats = {
+        side: tuple(_transform_for_side(source_arr, side).ravel().tolist())
+        for side in selector_pos
+    }
+    allowed = _allowed_side_placements(n, inner, inner)
+    side, top, left = _find_side_and_placement(cell_pat, true_pats, allowed, true_masks)
+
+    plain_mask = _dominant_mask(source_arr)
+    out = g.copy()
+    for i in range(inner):
+        for j in range(inner):
+            stamp = source_arr if plain_mask[i, j] else majority_arr
+            r0 = (top + i) * step + 1
+            c0 = (left + j) * step + 1
+            out[r0 : r0 + inner, c0 : c0 + inner] = stamp
+    return out
+
+
+def _behavior_metrics(grid: np.ndarray) -> dict[str, int | str]:
+    """Quantify whether the sample really uses side selection plus mirroring."""
+    fused, side, active_count = _solve_core(grid, use_flip=True)
+    plain = _baseline_no_flip_output(grid)
+    return {
+        "side": side,
+        "active_count": active_count,
+        "flip_delta": int(np.count_nonzero(fused != plain)),
+    }
+
+
+def _gen_attempt() -> np.ndarray | None:
+    separator, maj_exclusive, shared, source_exclusive = random.sample(range(COLOR_POOL), 4)
+    majority = _random_majority_pattern(shared, maj_exclusive)
+    source_mask = random.choice(_SOURCE_MASKS)
+    source = np.where(source_mask, source_exclusive, shared).astype(int)
+    if np.array_equal(source, majority):
+        return None
+
+    flip_v = np.flipud(source)
+    flip_h = np.fliplr(source)
+    if np.array_equal(source, flip_v) or np.array_equal(source, flip_h) or np.array_equal(flip_v, flip_h):
+        return None
+    if tuple(flip_v.ravel().tolist()) == tuple(majority.ravel().tolist()):
+        return None
+    if tuple(flip_h.ravel().tolist()) == tuple(majority.ravel().tolist()):
+        return None
+
+    side = random.choice(list(SIDE_ORDER))
+    transformed = _transform_for_side(source, side)
+    mask = _dominant_mask(transformed)
+    top, left = random.choice(_SIDE_PLACEMENTS[side])
+    active_cells = _placement_cells(mask, top, left)
+    out = _build_grid(separator, majority, source, side, active_cells)
+
+    subset = _choose_subset(side, source, majority, mask, top, left)
+    if subset is None:
+        return None
+    inp = _build_grid(separator, majority, source, side, list(subset))
+
+    try:
+        solved = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(solved, out):
+        return None
+
+    metrics = _behavior_metrics(inp)
+    if metrics["flip_delta"] <= 0:
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid fused b99e7126 input")

