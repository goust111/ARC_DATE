+# Combo variant of b99e7126 (index 11)
+# combo_spec: D6/1+D8/0
+# Name: 条带式铺贴 + 可变单元格尺寸
+
+from itertools import combinations
+import random
+
+import numpy as np
+
+from arc_utils import paste
+
+
+# Design analysis
+# a) Concrete behavior:
+#    原题把整块底板看成“单一 majority 单元格”的平铺，且单元尺寸固定为 3x3。
+#    这里同时改两处：底板改成 A/B 两种单元格按整行或整列交替的条带；单元内部尺寸
+#    在不同样例中改为 2x2、4x4、5x5。具体追踪一个 4x4 的例子：
+#    - 原题：少数单元 M 的 4x4 内部像素被当作 4x4 单元级掩码，False 位统一回填同一个 majority。
+#    - 融合后：若条带方向是按行交替，则这个 4x4 覆盖块里的第 0/2 行要回到 A，第 1/3 行要回到 B
+#      （或反过来）；若按列交替则改成看列奇偶。也就是说，解题者既要从分隔线推断单元尺寸，
+#      又要从非异常区域看出 A/B 条带，再用 M 的内部图案决定哪些单元改成 M。
+# b) Complexity calibration:
+#    只保留两种背景条带单元 A/B，方向只在 row/col 两档里选，尺寸只在少量离散档位里选。
+#    这样自由度可控，但视觉差异仍然明显：同一题里既能看到“背景不是单一 tile”，又能看到
+#    “异常单元不是固定 3x3，而是跟随样例变化的更大/更小蓝图”。
+# c) Broken assumptions from the original solver:
+#    - `majority_pat = max(counts, ...)` 不再等价于“所有非 minority 都相同”，因为现在常驻背景有 A/B 两种。
+#    - 固定 `step -> inner=3` 的想法失效，必须从 divider 行列间距恢复实际单元尺寸。
+#    - `mask-False -> majority` 这条原逻辑也失效，False 位必须恢复成该位置所属条带本该出现的 A 或 B。
+#    - placement 搜索本身仍然有效，因为“输入中的 minority 只是完整 active 集合的真子集”这一点没变。
+# d) Placement legality:
+#    生成器仍采用 output-first。先造完整条带底板，再按 minority 掩码覆盖完整输出，最后只保留一部分
+#    active 位置作为输入中的已知 minority。所有单元都落在规则 divider 网格内，不重叠、不越界。
+# e) Visual observability:
+#    人类可以直接看到三层稳定线索：分隔线给出单元尺寸；大面积 A/B 重复给出条带方向；M 单元内部的
+#    shared/minority-exclusive 分布给出上层掩码。训练样例之间尺寸会变化，方向也会变化，因此两项改动
+#    都会在少量样例里被重复呈现。
+# f) Visual cleanliness:
+#    总颜色数仍维持 4：divider、shared、stripe-exclusive、minority-exclusive。A/B 只靠纹理区别，
+#    不额外增加颜色角色；M 也只比背景多一个专属颜色，避免画面变杂。
+# g) Color-rule inferability:
+#    求解过程不依赖颜色编号大小。active 色由 minority 单元内部“唯一多数色”决定，生成器显式保证该色
+#    占比严格大于一半，因此这是可视结构，不是数值技巧。
+# h) Anti-degeneration guard:
+#    生成器拒绝两类退化样本：一类是完整覆盖块里 active 只落在一种条带 parity 上，导致条带信息无关；
+#    另一类是把 mask-False 统一刷成旧版的单一 majority 后仍与新输出相同。后者用显式差异计数检查。
+# i) New solver assumptions and generator guarantees:
+#    - 输入里恰有 3 种 cell interior：stripe A、stripe B、minority M。
+#    - 非 M 单元严格服从“整行交替”或“整列交替”的唯一条带规则。
+#    - minority 内部的多数色唯一，对应一个与单元尺寸同形状的布尔掩码。
+#    - 已展示的 minority 子集唯一确定该掩码在粗网格上的放置位置。
+#    这些前提都由 `_gen_attempt()` 构造并用 `main(inp) == out` 复验。
+
+SIZE_CONFIGS = (
+    {"inner": 2, "n_rows": 7, "n_cols": 7, "active_count": 3, "given_sizes": (2,), "min_old_diff": 1},
+    {"inner": 4, "n_rows": 7, "n_cols": 7, "active_count": 10, "given_sizes": (4, 5), "min_old_diff": 2},
+    {"inner": 5, "n_rows": 7, "n_cols": 7, "active_count": 16, "given_sizes": (5, 6), "min_old_diff": 3},
+)
+ORIENTATIONS = ("row", "col")
+COLOR_POOL = 10
+MAX_RETRIES = 700
+
+
+def _pattern_key(arr: np.ndarray) -> tuple[int, ...]:
+    return tuple(int(v) for v in arr.ravel())
+
+
+def _infer_cell_grid_params(g: np.ndarray) -> tuple[int, int, list[int], list[int]]:
+    """
+    Infer a regular cell grid separated by full rows/cols of one divider color.
+    Returns (row_step, col_step, row_divs, col_divs).
+    """
+    h, w = g.shape
+    line = int(g[0, 0])
+    row_divs = [r for r in range(h) if np.all(g[r, :] == line)]
+    col_divs = [c for c in range(w) if np.all(g[:, c] == line)]
+    assert len(row_divs) >= 2 and len(col_divs) >= 2, "need at least 2 row and 2 col dividers"
+    row_divs.sort()
+    col_divs.sort()
+    assert row_divs[0] == 0 and col_divs[0] == 0, "first divider must be at index 0"
+    assert row_divs[-1] == h - 1 and col_divs[-1] == w - 1, "last divider must be at boundary"
+
+    row_steps = [row_divs[i + 1] - row_divs[i] for i in range(len(row_divs) - 1)]
+    col_steps = [col_divs[i + 1] - col_divs[i] for i in range(len(col_divs) - 1)]
+    assert len(set(row_steps)) == 1 and len(set(col_steps)) == 1, "dividers must be regularly spaced"
+    row_step = int(row_steps[0])
+    col_step = int(col_steps[0])
+    assert row_step > 1 and col_step > 1, "cell steps must exceed 1"
+    assert (h - 1) % row_step == 0 and (w - 1) % col_step == 0, "grid dimensions must be k*step+1"
+    return row_step, col_step, row_divs, col_divs
+
+
+def _extract_patterns(
+    g: np.ndarray, row_step: int, col_step: int
+) -> tuple[dict[tuple[int, ...], np.ndarray], list[list[tuple[int, ...]]]]:
+    """Extract each cell interior as both a flat key and its 2D array."""
+    n_rows = (g.shape[0] - 1) // row_step
+    n_cols = (g.shape[1] - 1) // col_step
+    inner_h = row_step - 1
+    inner_w = col_step - 1
+    patterns: dict[tuple[int, ...], np.ndarray] = {}
+    cell_pat: list[list[tuple[int, ...]]] = []
+    for i in range(n_rows):
+        row: list[tuple[int, ...]] = []
+        for j in range(n_cols):
+            r0 = i * row_step + 1
+            c0 = j * col_step + 1
+            pat_arr = g[r0 : r0 + inner_h, c0 : c0 + inner_w].copy()
+            pat = _pattern_key(pat_arr)
+            if pat not in patterns:
+                patterns[pat] = pat_arr
+            row.append(pat)
+        cell_pat.append(row)
+    return patterns, cell_pat
+
+
+def _infer_stripe_tiling(
+    cell_pat: list[list[tuple[int, ...]]], minority_pat: tuple[int, ...]
+) -> tuple[str, list[list[tuple[int, ...]]]]:
+    """
+    Recover whether the persistent background alternates by rows or by columns.
+
+    Assumptions:
+    - exactly two recurring base patterns remain after removing the minority pattern
+    - every non-minority cell obeys one unique stripe rule
+    """
+    n_rows = len(cell_pat)
+    n_cols = len(cell_pat[0])
+    base_patterns = sorted({pat for row in cell_pat for pat in row if pat != minority_pat})
+    assert len(base_patterns) == 2, "expected exactly 2 stripe patterns and 1 minority pattern"
+
+    candidates: dict[tuple[tuple[tuple[int, ...], ...], ...], tuple[str, list[list[tuple[int, ...]]]]] = {}
+    for orientation in ORIENTATIONS:
+        for even_pat, odd_pat in (base_patterns, base_patterns[::-1]):
+            expected_grid: list[list[tuple[int, ...]]] = []
+            ok = True
+            for i in range(n_rows):
+                row: list[tuple[int, ...]] = []
+                for j in range(n_cols):
+                    stripe_idx = i if orientation == "row" else j
+                    expected = even_pat if stripe_idx % 2 == 0 else odd_pat
+                    row.append(expected)
+                    if cell_pat[i][j] != minority_pat and cell_pat[i][j] != expected:
+                        ok = False
+                        break
+                if not ok:
+                    break
+                expected_grid.append(row)
+            if ok:
+                key = tuple(tuple(row) for row in expected_grid)
+                candidates[key] = (orientation, expected_grid)
+
+    assert len(candidates) == 1, "stripe direction and alternation must be uniquely inferable"
+    return next(iter(candidates.values()))
+
+
+def _find_mask_placement(existing: np.ndarray, mask: np.ndarray) -> list[tuple[int, int]]:
+    """Return all coarse-grid placements compatible with the shown minority cells."""
+    n_rows, n_cols = existing.shape
+    mh, mw = mask.shape
+    candidates: list[tuple[int, int]] = []
+    for top in range(n_rows - mh + 1):
+        for left in range(n_cols - mw + 1):
+            block = np.zeros_like(existing)
+            block[top : top + mh, left : left + mw] = True
+            if np.any(existing & ~block):
+                continue
+            if np.any(existing[top : top + mh, left : left + mw] & ~mask):
+                continue
+            candidates.append((top, left))
+    return candidates
+
+
+def _analyze_instance(grid: np.ndarray) -> dict[str, object]:
+    """Parse a puzzle instance into the structures needed by the solver and by diagnostics."""
+    g = np.asarray(grid, dtype=int)
+    row_step, col_step, _, _ = _infer_cell_grid_params(g)
+    inner_h = row_step - 1
+    inner_w = col_step - 1
+    n_rows = (g.shape[0] - 1) // row_step
+    n_cols = (g.shape[1] - 1) // col_step
+
+    patterns, cell_pat = _extract_patterns(g, row_step, col_step)
+    counts: dict[tuple[int, ...], int] = {}
+    for row in cell_pat:
+        for pat in row:
+            counts[pat] = counts.get(pat, 0) + 1
+    assert len(counts) == 3, "variant expects exactly 3 cell patterns: stripe A, stripe B, minority"
+
+    minority_pat = min(counts.items(), key=lambda kv: kv[1])[0]
+    minority_arr = patterns[minority_pat]
+    orientation, stripe_grid = _infer_stripe_tiling(cell_pat, minority_pat)
+
+    vals, cnts = np.unique(minority_arr, return_counts=True)
+    assert int(cnts.max()) > minority_arr.size // 2, "minority active color must be a strict majority"
+    assert int(np.sum(cnts == cnts.max())) == 1, "minority active color must be unique"
+    active_color = int(vals[cnts.argmax()])
+    mask = minority_arr == active_color
+
+    existing = np.zeros((n_rows, n_cols), dtype=bool)
+    for i in range(n_rows):
+        for j in range(n_cols):
+            existing[i, j] = cell_pat[i][j] == minority_pat
+
+    candidates = _find_mask_placement(existing, mask)
+    assert len(candidates) == 1, "must have a unique mask placement aligning minority cells"
+    top, left = candidates[0]
+    dominant_pat = max(counts.items(), key=lambda kv: kv[1])[0]
+
+    return {
+        "grid": g,
+        "row_step": row_step,
+        "col_step": col_step,
+        "inner_h": inner_h,
+        "inner_w": inner_w,
+        "n_rows": n_rows,
+        "n_cols": n_cols,
+        "patterns": patterns,
+        "cell_pat": cell_pat,
+        "counts": counts,
+        "minority_pat": minority_pat,
+        "minority_arr": minority_arr,
+        "orientation": orientation,
+        "stripe_grid": stripe_grid,
+        "mask": mask,
+        "existing": existing,
+        "top": top,
+        "left": left,
+        "dominant_pat": dominant_pat,
+    }
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Complete the fractal overlay after inferring both the cell size and the stripe background rule.
+
+    Input structure:
+    - The board is split by one-color divider rows and columns into equal square cells, but different
+      samples may use 2x2, 4x4, or 5x5 interiors instead of a fixed 3x3 size.
+    - Ordinary cells are not uniform: two recurring base tiles alternate by whole rows or by whole columns,
+      forming visible horizontal or vertical stripes.
+    - A smaller set of cells uses one minority tile whose interior still serves as the blueprint.
+
+    Rule:
+    - Infer the cell size from the divider spacing, then extract every cell interior.
+    - Identify the minority tile, convert its unique majority color into a boolean mask of the same size,
+      and locate the one placement where the shown minority cells fit that mask.
+    - Repaint every mask-True coarse cell with the minority tile, and repaint every mask-False coarse cell
+      with whichever stripe tile the row/column alternation requires at that position.
+
+    Key insight:
+    - The odd tile still encodes a self-similar coarse-grid pattern, but solving now needs two coupled
+      inferences: the blueprint resolution comes from the variable divider lattice, and the cells outside
+      the active mask must preserve the A/B stripe regime instead of collapsing to one global majority tile.
+    """
+    info = _analyze_instance(grid)
+    out = info["grid"].copy()
+    row_step = int(info["row_step"])
+    col_step = int(info["col_step"])
+    inner_h = int(info["inner_h"])
+    inner_w = int(info["inner_w"])
+    top = int(info["top"])
+    left = int(info["left"])
+    minority_arr = info["minority_arr"]
+    patterns = info["patterns"]
+    stripe_grid = info["stripe_grid"]
+    mask = info["mask"]
+
+    mh, mw = mask.shape
+    for i in range(mh):
+        for j in range(mw):
+            target = minority_arr if mask[i, j] else patterns[stripe_grid[top + i][left + j]]
+            r0 = (top + i) * row_step + 1
+            c0 = (left + j) * col_step + 1
+            out[r0 : r0 + inner_h, c0 : c0 + inner_w] = target
+    return out
+
+
+def _grid_shape(inner: int, n_rows: int, n_cols: int) -> tuple[int, int]:
+    step = inner + 1
+    return n_rows * step + 1, n_cols * step + 1
+
+
+def _cell_origin(i: int, j: int, step: int) -> tuple[int, int]:
+    return i * step + 1, j * step + 1
+
+
+def _template_pool(inner: int) -> list[np.ndarray]:
+    """Build a small bank of structured stripe motifs for a given square cell size."""
+    rr, cc = np.indices((inner, inner))
+    center = inner // 2
+    raw = [
+        rr == cc,
+        rr + cc == inner - 1,
+        rr <= cc,
+        rr >= cc,
+        (rr + cc) % 2 == 0,
+        rr == center,
+        cc == center,
+        (rr == center) | (cc == center),
+        (rr == 0) | (cc == inner - 1),
+        (rr < center) | (cc == center),
+        (cc < center) | (rr == center),
+    ]
+
+    pool: list[np.ndarray] = []
+    seen: set[tuple[int, ...]] = set()
+    total = inner * inner
+    for arr in raw:
+        for candidate in (np.asarray(arr, dtype=bool), np.asarray(~arr, dtype=bool)):
+            active = int(candidate.sum())
+            if active == 0 or active == total:
+                continue
+            density = active / total
+            if density < 0.2 or density > 0.8:
+                continue
+            key = _pattern_key(candidate.astype(int))
+            if key in seen:
+                continue
+            seen.add(key)
+            pool.append(candidate.copy())
+    assert len(pool) >= 4, "need enough stripe templates for visible alternation"
+    return pool
+
+
+def _random_stripe_patterns(inner: int, shared: int, stripe_exclusive: int) -> tuple[np.ndarray, np.ndarray]:
+    """Choose two visibly different stripe tiles using the same two colors."""
+    pool = _template_pool(inner)
+    random.shuffle(pool)
+    total = inner * inner
+    for i in range(len(pool)):
+        for j in range(i + 1, len(pool)):
+            if int(np.sum(pool[i] != pool[j])) < max(2, total // 4):
+                continue
+            pat_a = np.where(pool[i], stripe_exclusive, shared).astype(int)
+            pat_b = np.where(pool[j], stripe_exclusive, shared).astype(int)
+            return pat_a, pat_b
+    raise RuntimeError("failed to choose distinct stripe patterns")
+
+
+def _random_mask(inner: int, active_count: int) -> np.ndarray:
+    """Sample a square minority mask whose active color is the strict majority."""
+    coords = [(r, c) for r in range(inner) for c in range(inner)]
+    for _ in range(400):
+        chosen = set(random.sample(coords, active_count))
+        mask = np.zeros((inner, inner), dtype=bool)
+        for r, c in chosen:
+            mask[r, c] = True
+        if not mask[0, :].any():
+            continue
+        if not mask[-1, :].any():
+            continue
+        if not mask[:, 0].any():
+            continue
+        if not mask[:, -1].any():
+            continue
+        return mask
+    raise RuntimeError("failed to sample a legal minority mask")
+
+
+def _pattern_grid(
+    stripe_a: np.ndarray, stripe_b: np.ndarray, orientation: str, n_rows: int, n_cols: int
+) -> list[list[np.ndarray]]:
+    """Build the full background tile assignment for the chosen stripe direction."""
+    grid: list[list[np.ndarray]] = []
+    for i in range(n_rows):
+        row: list[np.ndarray] = []
+        for j in range(n_cols):
+            stripe_idx = i if orientation == "row" else j
+            row.append(stripe_a if stripe_idx % 2 == 0 else stripe_b)
+        grid.append(row)
+    return grid
+
+
+def _build_grid(
+    separator: int,
+    base_grid: list[list[np.ndarray]],
+    minority: np.ndarray,
+    active_cells: list[tuple[int, int]],
+    step: int,
+) -> np.ndarray:
+    """Construct the full pixel grid from the stripe base and an optional set of minority cells."""
+    n_rows = len(base_grid)
+    n_cols = len(base_grid[0])
+    inner = step - 1
+    h, w = _grid_shape(inner, n_rows, n_cols)
+    grid = np.full((h, w), separator, dtype=int)
+    for i in range(n_rows):
+        for j in range(n_cols):
+            paste(grid, base_grid[i][j], *_cell_origin(i, j, step))
+    for i, j in active_cells:
+        paste(grid, minority, *_cell_origin(i, j, step))
+    return grid
+
+
+def _stripe_parities(cells: list[tuple[int, int]], orientation: str) -> set[int]:
+    """Return which stripe parities the absolute cell coordinates touch."""
+    if orientation == "row":
+        return {r % 2 for r, _ in cells}
+    return {c % 2 for _, c in cells}
+
+
+def _old_rule_diff_count(
+    mask: np.ndarray,
+    stripe_key_grid: list[list[tuple[int, ...]]],
+    dominant_pat: tuple[int, ...],
+    top: int,
+    left: int,
+) -> int:
+    """Count how many mask-False cells would be wrong under the original single-majority completion."""
+    diff = 0
+    mh, mw = mask.shape
+    for r in range(mh):
+        for c in range(mw):
+            if mask[r, c]:
+                continue
+            if stripe_key_grid[top + r][left + c] != dominant_pat:
+                diff += 1
+    return diff
+
+
+def _choose_given_cells(
+    mask: np.ndarray,
+    top: int,
+    left: int,
+    n_rows: int,
+    n_cols: int,
+    given_sizes: tuple[int, ...],
+    orientation: str,
+) -> list[tuple[int, int]] | None:
+    """Choose a strict active subset that uniquely fixes the placement and spans both stripe parities."""
+    active_abs = [(top + int(r), left + int(c)) for r, c in np.argwhere(mask)]
+    sizes = list(given_sizes)
+    random.shuffle(sizes)
+    for size in sizes:
+        if size >= len(active_abs):
+            continue
+        valid: list[list[tuple[int, int]]] = []
+        for subset in combinations(active_abs, size):
+            subset_list = list(subset)
+            if len(_stripe_parities(subset_list, orientation)) != 2:
+                continue
+            existing = np.zeros((n_rows, n_cols), dtype=bool)
+            for r, c in subset_list:
+                existing[r, c] = True
+            candidates = _find_mask_placement(
+                existing,
+                mask,
+            )
+            if candidates == [(top, left)]:
+                valid.append(subset_list)
+        if valid:
+            return random.choice(valid)
+    return None
+
+
+def _gen_attempt() -> np.ndarray | None:
+    """Single generation attempt: build output, choose an input subset, and verify with the solver."""
+    cfg = random.choice(SIZE_CONFIGS)
+    inner = int(cfg["inner"])
+    n_rows = int(cfg["n_rows"])
+    n_cols = int(cfg["n_cols"])
+    active_count = int(cfg["active_count"])
+    given_sizes = tuple(int(v) for v in cfg["given_sizes"])
+    min_old_diff = int(cfg["min_old_diff"])
+    step = inner + 1
+
+    separator, shared, stripe_exclusive, min_exclusive = random.sample(range(COLOR_POOL), 4)
+    stripe_a, stripe_b = _random_stripe_patterns(inner, shared, stripe_exclusive)
+    stripe_a_key = _pattern_key(stripe_a)
+    stripe_b_key = _pattern_key(stripe_b)
+    mask = _random_mask(inner, active_count)
+    minority = np.where(mask, min_exclusive, shared).astype(int)
+    orientation = random.choice(ORIENTATIONS)
+
+    base_grid = _pattern_grid(stripe_a, stripe_b, orientation, n_rows, n_cols)
+    stripe_key_grid: list[list[tuple[int, ...]]] = []
+    for i in range(n_rows):
+        row: list[tuple[int, ...]] = []
+        for j in range(n_cols):
+            stripe_idx = i if orientation == "row" else j
+            row.append(stripe_a_key if stripe_idx % 2 == 0 else stripe_b_key)
+        stripe_key_grid.append(row)
+
+    placements = [(top, left) for top in range(n_rows - inner + 1) for left in range(n_cols - inner + 1)]
+    random.shuffle(placements)
+    for top, left in placements:
+        active_abs = [(top + int(r), left + int(c)) for r, c in np.argwhere(mask)]
+        inactive_abs = [(top + int(r), left + int(c)) for r, c in np.argwhere(~mask)]
+        if len(_stripe_parities(active_abs, orientation)) != 2:
+            continue
+        if len(inactive_abs) > 1 and len(_stripe_parities(inactive_abs, orientation)) != 2:
+            continue
+
+        shown_minority = _choose_given_cells(mask, top, left, n_rows, n_cols, given_sizes, orientation)
+        if shown_minority is None:
+            continue
+
+        minority_key = _pattern_key(minority)
+        shown_set = set(shown_minority)
+        input_counts: dict[tuple[int, ...], int] = {}
+        for i in range(n_rows):
+            for j in range(n_cols):
+                pat = minority_key if (i, j) in shown_set else stripe_key_grid[i][j]
+                input_counts[pat] = input_counts.get(pat, 0) + 1
+        dominant_pat = max(input_counts.items(), key=lambda kv: kv[1])[0]
+        if dominant_pat == minority_key:
+            continue
+        if _old_rule_diff_count(mask, stripe_key_grid, dominant_pat, top, left) < min_old_diff:
+            continue
+
+        full_active = [(top + int(r), left + int(c)) for r, c in np.argwhere(mask)]
+        out = _build_grid(separator, base_grid, minority, full_active, step)
+        inp = _build_grid(separator, base_grid, minority, shown_minority, step)
+
+        try:
+            solved = main(inp)
+        except Exception:
+            continue
+        if not np.array_equal(solved, out):
+            continue
+        return inp
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid b99e7126 combo input")

