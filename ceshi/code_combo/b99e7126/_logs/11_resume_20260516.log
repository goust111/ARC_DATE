   292	    raw = [
   293	        rr == cc,
   294	        rr + cc == inner - 1,
   295	        rr <= cc,
   296	        rr >= cc,
   297	        (rr + cc) % 2 == 0,
   298	        rr == center,
   299	        cc == center,
   300	        (rr == center) | (cc == center),
   301	        (rr == 0) | (cc == inner - 1),
   302	        (rr < center) | (cc == center),
   303	        (cc < center) | (rr == center),
   304	    ]
