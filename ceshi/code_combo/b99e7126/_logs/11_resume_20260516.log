    81	    assert row_divs[-1] == h - 1 and col_divs[-1] == w - 1, "last divider must be at boundary"
    82	
    83	    row_steps = [row_divs[i + 1] - row_divs[i] for i in range(len(row_divs) - 1)]
    84	    col_steps = [col_divs[i + 1] - col_divs[i] for i in range(len(col_divs) - 1)]
