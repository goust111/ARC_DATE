    68	def _infer_cell_grid_params(g: np.ndarray) -> tuple[int, int, list[int], list[int]]:
    69	    """
    70	    Infer a regular cell grid separated by full rows/cols of one divider color.
    71	    Returns (row_step, col_step, row_divs, col_divs).
    72	    """
    73	    h, w = g.shape
    74	    line = int(g[0, 0])
    75	    row_divs = [r for r in range(h) if np.all(g[r, :] == line)]
