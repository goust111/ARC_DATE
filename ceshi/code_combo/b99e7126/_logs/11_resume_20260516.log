   181	    n_cols = (g.shape[1] - 1) // col_step
   182	
   183	    patterns, cell_pat = _extract_patterns(g, row_step, col_step)
   184	    counts: dict[tuple[int, ...], int] = {}
   185	    for row in cell_pat:
   186	        for pat in row:
   187	            counts[pat] = counts.get(pat, 0) + 1
   188	    assert len(counts) == 3, "variant expects exactly 3 cell patterns: stripe A, stripe B, minority"
   189	
   190	    minority_pat = min(counts.items(), key=lambda kv: kv[1])[0]
   191	    minority_arr = patterns[minority_pat]
   192	    orientation, stripe_grid = _infer_stripe_tiling(cell_pat, minority_pat)
   193	
   194	    vals, cnts = np.unique(minority_arr, return_counts=True)
   195	    assert int(cnts.max()) > minority_arr.size // 2, "minority active color must be a strict majority"
   196	    assert int(np.sum(cnts == cnts.max())) == 1, "minority active color must be unique"
   197	    active_color = int(vals[cnts.argmax()])
   198	    mask = minority_arr == active_color
   199	
   200	    existing = np.zeros((n_rows, n_cols), dtype=bool)
   201	    for i in range(n_rows):
