   206	    assert len(candidates) == 1, "must have a unique mask placement aligning minority cells"
   207	    top, left = candidates[0]
   208	    dominant_pat = max(counts.items(), key=lambda kv: kv[1])[0]
   209	
   210	    return {
   211	        "grid": g,
   212	        "row_step": row_step,
   213	        "col_step": col_step,
   214	        "inner_h": inner_h,
   215	        "inner_w": inner_w,
   216	        "n_rows": n_rows,
   217	        "n_cols": n_cols,
   218	        "patterns": patterns,
   219	        "cell_pat": cell_pat,
   220	        "counts": counts,
   221	        "minority_pat": minority_pat,
   222	        "minority_arr": minority_arr,
   223	        "orientation": orientation,
   224	        "stripe_grid": stripe_grid,
   225	        "mask": mask,
   226	        "existing": existing,
   227	        "top": top,
   228	        "left": left,
   229	        "dominant_pat": dominant_pat,
   230	    }
   231	
   232	
   233	def main(grid: np.ndarray) -> np.ndarray:
   234	    """
   235	    Complete the fractal overlay after inferring both the cell size and the stripe background rule.
   236	
   237	    Input structure:
   238	    - The board is split by one-color divider rows and columns into equal square cells, but different
   239	      samples may use 2x2, 4x4, or 5x5 interiors instead of a fixed 3x3 size.
   240	    - Ordinary cells are not uniform: two recurring base tiles alternate by whole rows or by whole columns,
   241	      forming visible horizontal or vertical stripes.
   242	    - A smaller set of cells uses one minority tile whose interior still serves as the blueprint.
   243	
   244	    Rule:
   245	    - Infer the cell size from the divider spacing, then extract every cell interior.
   246	    - Identify the minority tile, convert its unique majority color into a boolean mask of the same size,
   247	      and locate the one placement where the shown minority cells fit that mask.
   248	    - Repaint every mask-True coarse cell with the minority tile, and repaint every mask-False coarse cell
   249	      with whichever stripe tile the row/column alternation requires at that position.
   250	
   251	    Key insight:
   252	    - The odd tile still encodes a self-similar coarse-grid pattern, but solving now needs two coupled
   253	      inferences: the blueprint resolution comes from the variable divider lattice, and the cells outside
   254	      the active mask must preserve the A/B stripe regime instead of collapsing to one global majority tile.
   255	    """
   256	    info = _analyze_instance(grid)
   257	    out = info["grid"].copy()
   258	    row_step = int(info["row_step"])
