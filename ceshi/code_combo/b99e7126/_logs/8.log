+#    crosses boundaries. Input clue cells are chosen only from active blueprint positions and must
+#    uniquely determine the placement. Output rewrites only whole 3x3 interiors at legal cell origins,
+#    using either the minority texture or a solid divider-colored hole, so no overlap ambiguity occurs.
+# e) Visual observability:
+#    A human still reads the minority clue cell as the miniature blueprint. Comparing input/output now
+#    reveals a structured two-way change inside the same enlarged region: some clue cells disappear
+#    into holes while complementary positions light up as minority cells. This paired disappearance/
+#    appearance pattern is visible from examples without any color-id arithmetic.
+# f) Visual cleanliness:
+#    Each cell interior ends in exactly one of three clean states: majority texture, minority texture,
+#    or solid divider-colored hole. There is no partial-cell mixing, so the placed 3x3 region remains
+#    easy to segment visually.
+# g) Change inferability:
+#    Only four colors are used overall, and output meaning is tied to spatial role rather than numeric
+#    color identity: divider color marks erased holes, the minority texture marks toggled-on actives,
+#    and majority fills the inactive background. Because given clue cells form a strict subset of the
+#    active support, every sample demonstrates both branches of the fused XOR-with-erasure rule.
+# h) Quantitative anti-degeneracy target:
+#    For every generated sample, `painted_count = active_count - given_count` and `erased_count =
+#    given_count`. Since active_count is 6-7 and given_count is 3-4, both counts are always positive;
+#    therefore the combo cannot collapse to the original completion, pure erasure, or standard XOR.
+# i) New solver assumptions and generator support:
+#    The solver now assumes every input minority clue belongs to the hidden active support and that
+#    the only active cells initially visible are those clues. The generator enforces that by selecting
+#    clue cells from the active mask only, guaranteeing unique placement, and verifying `main(input)`
+#    against the fused output during generation.
+
+
+def _infer_cell_grid_params(g: np.ndarray) -> tuple[int, list[int], list[int]]:
+    """
+    Infer a regular cell grid separated by full rows/cols of the same line color.
+    Returns (step, row_divs, col_divs) where:
+      - row_divs/col_divs are divider indices
+      - step is the spacing between dividers (cell size including divider).
+    """
+    h, w = g.shape
+    line = int(g[0, 0])
+    row_divs = [r for r in range(h) if np.all(g[r, :] == line)]
+    col_divs = [c for c in range(w) if np.all(g[:, c] == line)]
+    assert len(row_divs) >= 2 and len(col_divs) >= 2, "need at least 2 row and 2 col dividers"
+    row_divs.sort()
+    col_divs.sort()
+    drs = [row_divs[i + 1] - row_divs[i] for i in range(len(row_divs) - 1) if row_divs[i + 1] > row_divs[i]]
+    dcs = [col_divs[i + 1] - col_divs[i] for i in range(len(col_divs) - 1) if col_divs[i + 1] > col_divs[i]]
+    step = reduce(gcd, drs + dcs)
+    assert step > 1, "divider step must be > 1"
+    assert row_divs[0] == 0 and col_divs[0] == 0, "first divider must be at index 0"
+    assert (h - 1) % step == 0 and (w - 1) % step == 0, "grid dimensions must be (k*step + 1)"
+    assert row_divs[-1] == h - 1 and col_divs[-1] == w - 1, "last divider must be at boundary"
+    return int(step), row_divs, col_divs
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Recover the hidden enlarged blueprint and apply it as a toggle between painted clues and carved holes.
+
+    Input structure:
+    - The board is split by uniform divider lines into a 7x7 lattice of equal 3x3 cell interiors.
+    - Almost every cell shows one repeated majority texture, while a small clue subset shows one distinct minority texture.
+
+    Rule:
+    - Interpret the minority cell's 3x3 interior as a binary blueprint, using its dominant color as the active pixels.
+    - Place that 3x3 blueprint on the 7x7 cell lattice so all visible minority clues fall on active blueprint positions.
+    - Inside the placed blueprint, active cells are XOR-like toggles between minority and background-hole states: a visible minority clue is erased to the divider color, and a non-clue active cell is filled with the minority pattern. Blueprint-inactive cells stay as the majority pattern.
+
+    Key insight:
+    - The exceptional cell is still a miniature map of a larger cell block, but the larger block is no longer completed by one fixed overwrite. The active support acts like a boolean overlay whose "off" result is an erasure hole and whose "on" result is the minority texture.
+    """
+    g = np.asarray(grid, dtype=int)
+    step, _, _ = _infer_cell_grid_params(g)
+    n = (g.shape[0] - 1) // step
+    inner = step - 1
+    bg = int(g[0, 0])
+
+    patterns: dict[tuple[int, ...], np.ndarray] = {}
+    cell_pat: list[list[tuple[int, ...]]] = []
+    for i in range(n):
+        row: list[tuple[int, ...]] = []
+        for j in range(n):
+            r0 = i * step + 1
+            c0 = j * step + 1
+            pat_arr = g[r0 : r0 + inner, c0 : c0 + inner].copy()
+            pat = tuple(pat_arr.ravel().tolist())
+            if pat not in patterns:
+                patterns[pat] = pat_arr
+            row.append(pat)
+        cell_pat.append(row)
+
+    counts: dict[tuple[int, ...], int] = {}
+    for i in range(n):
+        for j in range(n):
+            p = cell_pat[i][j]
+            counts[p] = counts.get(p, 0) + 1
+    assert len(counts) >= 2, "must have at least 2 distinct cell patterns (minority clues + majority)"
+
+    minority_pat = min(counts.items(), key=lambda kv: kv[1])[0]
+    majority_pat = max(counts.items(), key=lambda kv: kv[1])[0]
+    minority_arr = patterns[minority_pat]
+    majority_arr = patterns[majority_pat]
+
+    vals, cnts = np.unique(minority_arr, return_counts=True)
+    active_color = int(vals[cnts.argmax()])
+    mask = minority_arr == active_color
+    mh, mw = mask.shape
+
+    existing = np.zeros((n, n), dtype=bool)
+    for i in range(n):
+        for j in range(n):
+            existing[i, j] = cell_pat[i][j] == minority_pat
+
+    candidates: list[tuple[int, int]] = []
+    for top in range(0, n - mh + 1):
+        for left in range(0, n - mw + 1):
+            block = np.zeros_like(existing)
+            block[top : top + mh, left : left + mw] = True
+            if np.any(existing & ~block):
+                continue
+            ex_block = existing[top : top + mh, left : left + mw]
+            if np.any(ex_block & ~mask):
+                continue
+            candidates.append((int(top), int(left)))
+    assert len(candidates) == 1, "must have a unique mask placement aligning existing minority clues"
+    top, left = candidates[0]
+
+    erased_cell = np.full((inner, inner), bg, dtype=int)
+    out = g.copy()
+    for i in range(mh):
+        for j in range(mw):
+            r0 = (top + i) * step + 1
+            c0 = (left + j) * step + 1
+            if mask[i, j]:
+                target_pat = erased_cell if existing[top + i, left + j] else minority_arr
+            else:
+                target_pat = majority_arr
+            out[r0 : r0 + inner, c0 : c0 + inner] = target_pat
+    return out
+
+
+# --------------- generator (o5x) ---------------
+
+# --- CFG: tunable generation parameters ---
+CELL_GRID_N = 7
+CELL_INNER = 3
+CELL_STEP = 4
+GRID_SIZE = 29
+MASK_SIZE = 3
+PLACEMENT_RANGE = CELL_GRID_N - MASK_SIZE + 1
+ACTIVE_PIXEL_COUNTS = (6, 7)
+GIVEN_CELL_SIZES = [3, 4]
+COLOR_POOL = 10
+MAX_RETRIES = 300
+
+_LR_GROUPS = [
+    ((0, 0), (0, 2)),
+    ((1, 0), (1, 2)),
+    ((2, 0), (2, 2)),
+    ((0, 1),),
+    ((1, 1),),
+    ((2, 1),),
+]
+
+
+def _precompute_masks() -> dict[int, list[np.ndarray]]:
+    """Enumerate all valid LR-symmetric 3x3 masks, keyed by active pixel count."""
+    weights = [len(group) for group in _LR_GROUPS]
+    by_count: dict[int, list[np.ndarray]] = {}
+    for active_count in ACTIVE_PIXEL_COUNTS:
+        inactive_count = MASK_SIZE * MASK_SIZE - active_count
+        masks: list[np.ndarray] = []
+        for k in range(1, len(_LR_GROUPS) + 1):
+            for combo in combinations(range(len(_LR_GROUPS)), k):
+                if sum(weights[idx] for idx in combo) != inactive_count:
+                    continue
+                mask = np.ones((MASK_SIZE, MASK_SIZE), dtype=bool)
+                for idx in combo:
+                    for r, c in _LR_GROUPS[idx]:
+                        mask[r, c] = False
+                if mask[0, :].any() and mask[2, :].any() and mask[:, 0].any() and mask[:, 2].any():
+                    masks.append(mask)
+        by_count[active_count] = masks
+    return by_count
+
+
+_MASKS_BY_COUNT = _precompute_masks()
+
+
+def _random_lr_pattern(color_a: int, color_b: int) -> np.ndarray:
+    """Generate a random LR-symmetric 3x3 pattern using two colors."""
+    arr = np.empty((MASK_SIZE, MASK_SIZE), dtype=int)
+    choices = [random.choice((color_a, color_b)) for _ in _LR_GROUPS]
+    if all(value == choices[0] for value in choices):
+        choices[random.randrange(len(choices))] = color_b if choices[0] == color_a else color_a
+    for group, color in zip(_LR_GROUPS, choices):
+        for r, c in group:
+            arr[r, c] = color
+    return arr
+
+
+def _random_minority_mask() -> np.ndarray:
+    """Pick a random valid minority mask."""
+    active_count = random.choice(ACTIVE_PIXEL_COUNTS)
+    return random.choice(_MASKS_BY_COUNT[active_count])
+
+
+def _placement_candidates(mask: np.ndarray, subset, top: int, left: int) -> list[tuple[int, int]]:
+    """Find all offsets where the given clue subset is consistent with the mask."""
+    existing = np.zeros((CELL_GRID_N, CELL_GRID_N), dtype=bool)
+    for r, c in subset:
+        existing[top + r, left + c] = True
+
+    candidates: list[tuple[int, int]] = []
+    for cand_top in range(PLACEMENT_RANGE):
+        for cand_left in range(PLACEMENT_RANGE):
+            block = np.zeros((CELL_GRID_N, CELL_GRID_N), dtype=bool)
+            block[cand_top : cand_top + MASK_SIZE, cand_left : cand_left + MASK_SIZE] = True
+            if np.any(existing & ~block):
+                continue
+            if np.any(existing[cand_top : cand_top + MASK_SIZE, cand_left : cand_left + MASK_SIZE] & ~mask):
+                continue
+            candidates.append((cand_top, cand_left))
+    return candidates
+
+
+def _choose_given_subset(mask: np.ndarray, top: int, left: int):
+    """Choose a clue subset that uniquely determines the placement."""
+    active = [tuple(coord) for coord in np.argwhere(mask)]
+    sizes = list(GIVEN_CELL_SIZES)
+    random.shuffle(sizes)
+    for size in sizes:
+        valid = [
+            subset
+            for subset in combinations(active, size)
+            if _placement_candidates(mask, subset, top, left) == [(top, left)]
+        ]
+        if valid:
+            return random.choice(valid)
+    return None
+
+
+def _cell_origin(i: int, j: int) -> tuple[int, int]:
+    """Pixel origin of cell (i, j) interior within the full grid."""
+    return i * CELL_STEP + 1, j * CELL_STEP + 1
+
+
+def _build_majority_base(separator: int, majority: np.ndarray) -> np.ndarray:
+    """Construct the full grid with the majority pattern in every cell."""
+    grid = np.full((GRID_SIZE, GRID_SIZE), separator, dtype=int)
+    for i in range(CELL_GRID_N):
+        for j in range(CELL_GRID_N):
+            paste(grid, majority, *_cell_origin(i, j))
+    return grid
+
+
+def _build_input(separator: int, majority: np.ndarray, minority: np.ndarray, given_cells) -> np.ndarray:
+    """Construct the input grid from the majority base plus chosen minority clue cells."""
+    grid = _build_majority_base(separator, majority)
+    for i, j in given_cells:
+        paste(grid, minority, *_cell_origin(i, j))
+    return grid
+
+
+def _build_output(
+    separator: int,
+    majority: np.ndarray,
+    minority: np.ndarray,
+    mask: np.ndarray,
+    top: int,
+    left: int,
+    given_cells,
+) -> np.ndarray:
+    """Construct the fused output: active clues become holes; other active cells become minority."""
+    grid = _build_majority_base(separator, majority)
+    erased = np.full((CELL_INNER, CELL_INNER), separator, dtype=int)
+    given_set = set(given_cells)
+    for r, c in np.argwhere(mask):
+        rr = top + int(r)
+        cc = left + int(c)
+        stamp = erased if (rr, cc) in given_set else minority
+        paste(grid, stamp, *_cell_origin(rr, cc))
+    return grid
+
+
+def _gen_attempt():
+    """Single generation attempt: build fused output, synthesize clues, and verify."""
+    separator, maj_exclusive, shared, min_exclusive = random.sample(range(COLOR_POOL), 4)
+    majority = _random_lr_pattern(shared, maj_exclusive)
+    mask = _random_minority_mask()
+    minority = np.where(mask, min_exclusive, shared).astype(int)
+
+    top = random.randrange(PLACEMENT_RANGE)
+    left = random.randrange(PLACEMENT_RANGE)
+
+    subset = _choose_given_subset(mask, top, left)
+    if subset is None:
+        return None
+    given_cells = [(top + int(r), left + int(c)) for r, c in subset]
+
+    inp = _build_input(separator, majority, minority, given_cells)
+    out = _build_output(separator, majority, minority, mask, top, left, given_cells)
+
+    try:
+        solved = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(solved, out):
+        return None
+    return inp
+
+
+def generate_input():
+    for _ in range(MAX_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid b99e7126 combo input")

