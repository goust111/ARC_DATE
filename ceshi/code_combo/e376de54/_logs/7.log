            cell = _cell_from_ts(d, t, s["s"], (h, w))
            assert cell is not None, "target segment cell must stay in bounds"
            r, c = cell
            if s["t_start"] <= t <= s["t_end"]:
                out[r, c] = s["color"]
            else:
                out[r, c] = _MARKER

    return out


