    input_offsets: [2, 5, 8]
    reference_offset: 5
    reference_extent: columns 4..9
    old_output: rows 2, 5, 8 all become length 6 on columns 4..9
    new_output: rows 2 and 8 become length 6 on columns 4..9, row 5 is background
  difference_point:
