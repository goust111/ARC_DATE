+        if meta["ref_idx"] == meta["median_idx"]:
+            return None
+        if not meta["all_nonrefs_shorter"]:
+            return None
+        return inp
+    except Exception:
+        return None
+
+
+def generate_input():
+    for _ in range(_GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate valid input")

