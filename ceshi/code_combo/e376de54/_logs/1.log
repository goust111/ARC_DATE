+        "ref_idx": ref_idx,
+        "median_idx": n // 2,
+        "ref_len": ref_len,
+        "input_lengths": tuple(lengths),
+        "all_nonrefs_shorter": all(lengths[i] < ref_len for i in range(n) if i != ref_idx),
