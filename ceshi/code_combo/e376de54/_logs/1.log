+                    {
+                        "color": col,
+                        "cells": cells,
+                        "start": start,
+                        "end": end,
+                        "t_start": _dot(start, d),
+                        "t_end": _dot(end, d),
+                        "s": _perp_dot(start, d),
+                        "len": len(cells),
+                    }
+                )
