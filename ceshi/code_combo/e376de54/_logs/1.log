        if not np.array_equal(solved, out):
            return None
        if np.array_equal(_old_median_output(inp), out):
            return None
        return inp
    except Exception:
        return None


def generate_input():
    for _ in range(_GEN_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid input")

