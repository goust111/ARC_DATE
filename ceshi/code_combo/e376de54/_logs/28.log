+# --------------- generator ---------------
+
+_H, _W = 24, 24
+_BG = 7
+
+_DIRS = [(0, 1), (1, 0), (1, 1), (1, -1)]
+_COLORS = [1, 2, 3, 4, 5, 6, 8, 9]
+
+_SEGMENT_COUNTS = [7, 8, 9, 10]
+_MODE_LEN_RANGE = (4, 9)
+_MAX_SEG_LEN = 15
+
+_PERP_GAP_ORTHO = [2, 3]
+_PERP_GAP_DIAG = [4, 5]
+
+_MIN_COLORS = 2
+_MAX_DISTINCT_COLORS = 4
+
+_T_SCAN_RANGE = (-60, 61)
+_GEN_RETRIES = 800
