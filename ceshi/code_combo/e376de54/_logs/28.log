+    for s in segments:
+        for r, c in s["cells"]:
+            out[r, c] = bg
+
+    for s in segments:
+        if use_start_anchor:
+            r0, c0 = s["start"]
+        else:
+            r0 = s["end"][0] - (target_len - 1) * dr
+            c0 = s["end"][1] - (target_len - 1) * dc
+
+        rr, cc = r0, c0
+        for _ in range(target_len):
+            assert 0 <= rr < h and 0 <= cc < w, "resized segment must stay in bounds"
+            out[rr, cc] = s["color"]
+            rr += dr
+            cc += dc
+
+    return out
+
+
+# --------------- generator ---------------
+
+_H, _W = 24, 24
+_BG = 7
+
+_DIRS = [(0, 1), (1, 0), (1, 1), (1, -1)]
+_COLORS = [1, 2, 3, 4, 5, 6, 8, 9]
+
+_SEGMENT_COUNTS = [7, 8, 9, 10]
+_MODE_LEN_RANGE = (4, 9)
+_MAX_SEG_LEN = 15
+
+_PERP_GAP_ORTHO = [2, 3]
+_PERP_GAP_DIAG = [4, 5]
+
+_MIN_COLORS = 2
+_MAX_DISTINCT_COLORS = 4
+
+_T_SCAN_RANGE = (-60, 61)
+_GEN_RETRIES = 800
