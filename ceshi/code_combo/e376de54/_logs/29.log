+        cells = _centered_segment_cells(d, center_t, s, length, _H, _W)
+        if cells is None:
+            return False
+        for cell in cells:
+            if cell in used:
+                return False
+            used.add(cell)
+        objects.append((cells, color))
+    for cells, color in objects:
+        for r, c in cells:
+            grid[r, c] = color
