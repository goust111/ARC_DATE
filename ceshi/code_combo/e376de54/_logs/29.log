+
+def _choose_output_offsets(d: tuple[int, int], n: int) -> tuple[int, ...]:
+    lo, hi = _s_limits(d)
+    gap = random.choice(_equal_gap_choices(d, n))
+    span = (n - 1) * gap
+    s0 = random.randint(lo, hi - span)
+    return tuple(s0 + i * gap for i in range(n))
