+    if not _paint_centered(out, d, s_out, center_t, [ref_len] * n, colors):
+        return None
+
+    inp = np.full((_H, _W), _BG, dtype=int)
+    if not _paint_centered(inp, d, s_in, center_t, lengths, colors):
+        return None
+
+    try:
+        if np.array_equal(main(inp), out):
+            return inp
+    except Exception:
+        return None
+    return None
