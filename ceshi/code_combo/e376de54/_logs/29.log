+
+def _extract_segments(g: np.ndarray, bg: int, d: tuple[int, int]) -> list[dict]:
+    h, w = g.shape
+    dr, dc = d
+    segments = []
+    colors = [int(c) for c in np.unique(g) if int(c) != bg]
+    for col in colors:
