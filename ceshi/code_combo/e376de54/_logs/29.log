+
+def _choose_irregular_gaps(d: tuple[int, int], n: int, equal_gap: int) -> list[int]:
+    min_gap = _min_gap(d)
+    unit = _gap_unit(d)
+    base = [equal_gap] * (n - 1)
+    for _ in range(300):
+        gaps = base.copy()
+        moves = 1 if n == 3 else random.randint(1, 3)
+        for _ in range(moves):
+            donors = [i for i, g in enumerate(gaps) if g - unit >= min_gap]
+            if not donors:
