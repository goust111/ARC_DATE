+    moved_nubs, legacy_diff = _fusion_metric(inp, out, d, ref_len)
+    if moved_nubs < 2 or legacy_diff == 0:
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(_GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
