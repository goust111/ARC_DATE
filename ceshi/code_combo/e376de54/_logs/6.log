+    if not _paint(out, d, s_vals, ref_center, [ref_len] * n, colors, nub_anchor, nub_side):
+        return None
+
+    inp = np.full((_H, _W), _BG, dtype=int)
+    if not _paint(inp, d, s_vals, ref_center, lengths, colors, nub_anchor, nub_side):
