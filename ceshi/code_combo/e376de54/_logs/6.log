+def _gap_patterns(d: tuple[int, int], n: int) -> list[list[int]]:
+    allowed = _PERP_GAP_DIAG if d in [(1, 1), (1, -1)] else _PERP_GAP_ORTHO
+    lo, hi = _s_limits(d)
+    max_span = hi - lo
+    patterns = [[]]
+    for _ in range(n - 1):
+        patterns = [p + [g] for p in patterns for g in allowed]
