+            assert all(v is not None for v in lengths)
+            assert len(set(lengths)) == n
+            assert sorted(lengths, reverse=True)[2] == ref_len
+            return [int(v) for v in lengths]
+    return None
+
+
+def _paint(
+    grid: np.ndarray,
+    d: tuple[int, int],
+    s_vals: tuple[int, ...],
+    starts: list[int],
+    lengths: list[int],
+    colors: tuple[int, ...],
+) -> bool:
+    for s, t0, length, color in zip(s_vals, starts, lengths, colors):
+        cells = _segment_cells(d, t0, s, length)
+        if cells is None:
+            return False
+        for r, c in cells:
+            if grid[r, c] != _BG:
+                return False
+            grid[r, c] = color
