+# --------------- generator ---------------
+
+_H, _W = 16, 16
+_BG = 7
+
+_DIRS = [(0, 1), (1, 0), (1, 1), (1, -1)]
+_COLORS = [0, 1, 2, 3, 4, 5, 6, 8, 9]
+
+_SEGMENT_COUNTS = [7, 8, 9, 10]
+_REF_LEN_RANGE_BY_COUNT = {
+    7: (6, 9),
+    8: (7, 9),
+    9: (8, 10),
+    10: (9, 10),
+}
+_MAX_SEG_LEN = 13
+
+_PERP_GAP_ORTHO = [1, 2]
+_PERP_GAP_DIAG = [2, 3]
+
+_T_SCAN_RANGE = (-30, 31)
