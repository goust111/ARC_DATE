+
+
+def _gen_attempt() -> np.ndarray | None:
+    d = random.choice(_DIRS)
+    n = random.choice(_SEGMENT_COUNTS)
+    ref_len = random.randint(*_REF_LEN_RANGE_BY_COUNT[n])
