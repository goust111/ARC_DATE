# --- Canvas ---
_H, _W = 16, 16
_BG = 7

# --- Directions and colors ---
_DIRS = [(0, 1), (1, 0), (1, 1), (1, -1)]
_COLORS = [1, 3, 5, 6, 8, 9]  # exclude red because red is the trail marker

# --- Segment counts and reference length ---
_SEGMENT_COUNTS = [3, 5]
