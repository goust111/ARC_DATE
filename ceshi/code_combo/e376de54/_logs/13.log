   100	                if 0 <= rr < h and 0 <= cc < w and int(g[rr, cc]) == v:
   101	                    cnt += 1
   102	        counts.append(((dr, dc), cnt))
   103	
   104	    best_cnt = max(cnt for _, cnt in counts)
   105	    assert best_cnt > 0, "main direction must be detectable"
   106	    best_dirs = [d for d, cnt in counts if cnt == best_cnt]
   107	    assert len(best_dirs) == 1, "main direction must be unique"
   108	    return best_dirs[0]
