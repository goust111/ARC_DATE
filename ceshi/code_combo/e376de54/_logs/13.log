   473	    if not placements:
   474	        return None
   475	
   476	    ref_candidates = _eligible_ref_indices(n)
   477	    random.shuffle(ref_candidates)
   478	    random.shuffle(placements)
   479	
   480	    for t0, anchor, caps in placements:
   481	        for ref_idx in ref_candidates:
   482	            lengths = _choose_lengths(ref_len, caps, ref_idx)
   483	            if lengths is None:
   484	                continue
   485	
   486	            colors = _choose_colors(n)
   487	
   488	            out = np.full((_H, _W), _BG, dtype=int)
   489	            if not _paint(out, d, s_vals, [t0] * n, [ref_len] * n, colors):
   490	                continue
   491	
   492	            delta = _step(d)
   493	            t1 = t0 + (ref_len - 1) * delta
   494	            if anchor == "start":
   495	                starts = [t0] * n
   496	            else:
   497	                starts = [t1 - (length - 1) * delta for length in lengths]
   498	
   499	            inp = np.full((_H, _W), _BG, dtype=int)
   500	            if not _paint(inp, d, s_vals, starts, lengths, colors):
   501	                continue
