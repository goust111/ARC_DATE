+def _choose_offsets(d: tuple[int, int], n: int) -> tuple[int, ...] | None:
+    lo, hi = _s_limits(d)
+    for _ in range(_OFFSET_RETRIES):
+        gaps = _pick_gap_sequence(d, n)
+        if gaps is None:
+            return None
+        s0 = random.randint(lo, hi - sum(gaps))
