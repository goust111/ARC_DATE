   162	def main(grid: np.ndarray) -> np.ndarray:
   163	    """
   164	    Snap a dense bundle of parallel segments onto the span of the low-median length segment.
   165	
   166	    Input structure:
   167	    - The most frequent color is background.
   168	    - Foreground cells form 7-8 straight parallel segments in one shared direction.
   169	    - Segments live on distinct parallel lines, may reuse colors, and have visibly different lengths
   170	      while sharing one anchored endpoint in the input.
   171	
   172	    Rule:
   173	    - Detect the common direction and extract every contiguous segment of length at least 2.
   174	    - Sort segment lengths and choose the low median as the reference
   175	      (middle value for odd counts, shorter middle value for even counts).
   176	    - Take the unique segment with that length, align every segment start to its start, and redraw
   177	      each segment at exactly the reference length.
   178	    - Keep the canvas size unchanged and leave isolated single pixels untouched.
   179	
   180	    Key insight:
   181	    The target span comes from a visible order statistic over many lengths, not from spatial order:
   182	    once the low-median length segment is identified, every parallel segment is cropped or extended
   183	    to match that segment's extent.
   184	    """
   185	    g = np.asarray(grid, dtype=int)
   186	    h, w = g.shape
   187	    bg = get_bg(g)
   188	
   189	    d = _pick_main_dir(g, bg)
   190	    dr, dc = d
   191	    delta_t = dr * dr + dc * dc
   192	
   193	    segments = _extract_segments(g, bg, d)
   194	    assert segments, "at least one multi-cell segment must exist"
   195	
   196	    s_vals = sorted(s["s"] for s in segments)
   197	    if delta_t == 2:
   198	        for i in range(len(s_vals) - 1):
   199	            assert s_vals[i + 1] - s_vals[i] >= 4
   200	    assert len(s_vals) == len(set(s_vals)), "segment line coordinates must be unique"
   201	
   202	    lengths = sorted(s["len"] for s in segments)
   203	    target_len = lengths[_low_median_index(len(lengths))]
   204	    ref_cands = [s for s in segments if s["len"] == target_len]
   205	    assert len(ref_cands) == 1, "median-length reference segment must be unique"
   206	    ref = ref_cands[0]
   207	    ref_t0, ref_t1 = ref["t_start"], ref["t_end"]
   208	    assert ref_t1 >= ref_t0, "traced segment coordinates must increase"
   209	    assert (ref_t1 - ref_t0) % delta_t == 0, "reference segment length must align with delta_t"
   210	
   211	    out = g.copy()
   212	    for s in segments:
   213	        for r, c in s["cells"]:
   214	            out[r, c] = bg
   215	
   216	    for s in segments:
   217	        dt = ref_t0 - s["t_start"]
   218	        assert dt % delta_t == 0, "segment shift must be aligned to delta_t"
   219	        k = dt // delta_t
   220	        rr = s["start"][0] + k * dr
   221	        cc = s["start"][1] + k * dc
   222	        for _ in range(target_len):
   223	            assert 0 <= rr < h and 0 <= cc < w, "shifted segment must stay in bounds"
   224	            out[rr, cc] = s["color"]
   225	            rr += dr
   226	            cc += dc
   227	
   228	    return out
