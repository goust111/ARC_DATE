+        assert all(val is not None for val in lengths)
+        assert len(set(lengths)) == n
+        return [int(val) for val in lengths]
+    return None
+
+
+def _eligible_ref_indices(n: int) -> list[int]:
+    if n % 2 == 1:
+        blocked = {n // 2}
+    else:
+        blocked = {n // 2 - 1, n // 2}
+    return [i for i in range(n) if i not in blocked]
