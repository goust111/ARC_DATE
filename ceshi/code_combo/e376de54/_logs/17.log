    93	                    cnt += 1
    94	        counts.append(((dr, dc), cnt))
    95	
    96	    best_cnt = max(cnt for _, cnt in counts)
    97	    assert best_cnt > 0, "main direction must be detectable"
    98	    best_dirs = [d for d, cnt in counts if cnt == best_cnt]
    99	    assert len(best_dirs) == 1, "main direction must be unique"
   100	    return best_dirs[0]
   101	
   102	
   103	def _dot(p: tuple[int, int], d: tuple[int, int]) -> int:
   104	    return p[0] * d[0] + p[1] * d[1]
   105	
   106	
   107	def _perp_dot(p: tuple[int, int], d: tuple[int, int]) -> int:
   108	    return p[0] * d[1] - p[1] * d[0]
   109	
   110	
   111	def _cell_from_ts(
   112	    d: tuple[int, int], t: int, s: int, bounds: tuple[int, int] | None = None
   113	) -> tuple[int, int] | None:
   114	    if d == (0, 1):
   115	        r, c = s, t
   116	    elif d == (1, 0):
   117	        r, c = t, -s
   118	    elif d == (1, 1):
   119	        if (t + s) % 2 or (t - s) % 2:
   120	            return None
   121	        r, c = (t + s) // 2, (t - s) // 2
   122	    else:
   123	        if (t - s) % 2 or (-s - t) % 2:
   124	            return None
   125	        r, c = (t - s) // 2, (-s - t) // 2
   126	
   127	    if bounds is not None:
   128	        h, w = bounds
   129	        if not (0 <= r < h and 0 <= c < w):
   130	            return None
   131	    return int(r), int(c)
   132	
   133	
   134	def _segment_cells_from_t(
   135	    d: tuple[int, int],
   136	    t0: int,
   137	    s: int,
   138	    length: int,
   139	    bounds: tuple[int, int] | None = None,
   140	) -> list[tuple[int, int]] | None:
   141	    delta_t = _step(d)
   142	    cells = []
   143	    for k in range(length):
   144	        cell = _cell_from_ts(d, t0 + k * delta_t, s, bounds=bounds)
   145	        if cell is None:
   146	            return None
   147	        cells.append(cell)
   148	    return cells
   149	
   150	
   151	def _extract_segments(g: np.ndarray, bg: int, d: tuple[int, int]) -> list[dict]:
   152	    h, w = g.shape
   153	    dr, dc = d
   154	    segments = []
   155	
   156	    colors = [int(c) for c in np.unique(g) if int(c) != bg]
   157	    for col in colors:
   158	        mask = g == col
   159	        for r in range(h):
   160	            for c in range(w):
   161	                if not mask[r, c]:
   162	                    continue
   163	                pr, pc = r - dr, c - dc
   164	                if 0 <= pr < h and 0 <= pc < w and mask[pr, pc]:
   165	                    continue
   166	                cells = []
   167	                rr, cc = r, c
   168	                while 0 <= rr < h and 0 <= cc < w and mask[rr, cc]:
   169	                    cells.append((rr, cc))
   170	                    rr += dr
   171	                    cc += dc
   172	                if len(cells) < 2:
   173	                    continue
   174	                start = cells[0]
   175	                end = cells[-1]
   176	                segments.append(
   177	                    {
   178	                        "color": col,
   179	                        "cells": cells,
   180	                        "start": start,
   181	                        "end": end,
   182	                        "t_start": _dot(start, d),
   183	                        "t_end": _dot(end, d),
   184	                        "s": _perp_dot(start, d),
   185	                        "len": len(cells),
   186	                    }
   187	                )
   188	    return segments
   189	
   190	
   191	def _select_reference(segments: list[dict], d: tuple[int, int], mode: str) -> tuple[dict, int, int]:
   192	    delta_t = _step(d)
   193	    if mode == "longest":
   194	        max_len = max(s["len"] for s in segments)
   195	        ref_cands = [s for s in segments if s["len"] == max_len]
   196	        assert len(ref_cands) == 1, "reference segment must be the unique longest"
   197	        ref = ref_cands[0]
   198	    elif mode == "median":
   199	        s_vals = sorted(s["s"] for s in segments)
   200	        assert len(s_vals) % 2 == 1, "segment count must have a single median"
   201	        assert len(s_vals) == len(set(s_vals)), "segment line coordinates must be unique"
   202	        s_ref = s_vals[len(s_vals) // 2]
   203	        ref_cands = [s for s in segments if s["s"] == s_ref]
   204	        assert len(ref_cands) == 1, "median reference segment must be unique"
   205	        ref = ref_cands[0]
   206	    else:
   207	        raise ValueError(mode)
   208	
   209	    ref_t0, ref_t1 = ref["t_start"], ref["t_end"]
   210	    assert ref_t1 >= ref_t0, "traced segment coordinates must increase"
   211	    assert (ref_t1 - ref_t0) % delta_t == 0, "reference segment length must align with delta_t"
   212	    target_len = (ref_t1 - ref_t0) // delta_t + 1
