   220	    segments: list[dict],
   221	    ref_t0: int,
   222	    target_len: int,
   223	) -> np.ndarray:
   224	    h, w = g.shape
   225	    dr, dc = d
   226	    delta_t = _step(d)
   227	
   228	    shifted = []
   229	    min_r, max_r = 0, h - 1
   230	    min_c, max_c = 0, w - 1
   231	    for seg in segments:
   232	        dt = ref_t0 - seg["t_start"]
   233	        assert dt % delta_t == 0, "segment shift must be aligned to delta_t"
   234	        k = dt // delta_t
