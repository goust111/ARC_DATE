    24	#   Example, horizontal shared-end input:
    25	#     reference extent = cols 4..8, ref_len = 5
    26	#     long blue input  = cols 2..8
    27	#     short green input = cols 6..8
    28	#   Seed output:
    29	#     blue  -> cols 4..8
    30	#     green -> cols 4..8
    31	#     cols 2..3 vanish to bg
    32	#   Combo output:
    33	#     blue  -> cols 4..8
    34	#     green -> cols 4..8
    35	#     old blue cells at cols 2..3 stay red
    36	#   Difference:
    37	#     the kept aligned segment geometry is unchanged, but shortening now leaves
    38	#     a visible warning scar. Extension still uses the segment's own color and
    39	#     does not create any red trail.
    40	#
    41	# b_complexity_calibration:
    42	#   Keep the original 16x16 canvas, direction set, odd segment counts, median
    43	#   reference rule, and irregular offset spacing. Use exactly one reserved
    44	#   warning color, red, and exclude it from input segment colors. Generator
    45	#   still forces both a shorter and a longer non-reference segment, so examples
    46	#   simultaneously demonstrate extension and cropping without adding new object
    47	#   types or a large color vocabulary.
    48	#
    49	# c_implicit_assumption_audit:
    50	#   - Direction detection still works because the input contains only plain
    51	#     monochrome segments; red exists only in output.
    52	#   - Segment extraction by monochrome runs remains valid because every input
    53	#     segment is still a single-color collinear run on a unique parallel line.
    54	#   - The seed solver cleared all segment cells to background before redraw.
    55	#     That assumption breaks here because deleted cells must survive. We still
    56	#     clear first, but then explicitly restore cropped-only cells in red and
    57	#     paint final aligned cells last.
    58	#   - Marking "orig minus final" as trail is only semantically correct when
    59	#     segments share one anchor endpoint, because then shortened segments are
    60	#     strict supersets of the kept interval while shorter ones are strict
    61	#     subsets. The generator preserves that original anchor invariant.
    62	#   - To avoid false trails on odd out-of-distribution inputs, main marks red
    63	#     only when a segment is actually longer than the target length.
    64	#
    65	# d_placement_legality:
    66	#   Output-first generation is preserved. First choose the final aligned
    67	#   placement for all segments; then derive the input by anchoring either all
    68	#   starts or all ends and varying lengths within per-line capacity. Distinct
    69	#   perpendicular offsets prevent overlap across segments, and every original,
    70	#   final, and cropped cell is guaranteed in-bounds by the same t/s coordinate
    71	#   checks used by the seed generator.
    72	#
    73	# e_visual_observability:
    74	#   A human sees the same alignment behavior as the seed task plus red cells
    75	#   exactly where longer lines were cut back. Across a few examples, start-
    76	#   anchored cases place red at suffixes and end-anchored cases place red at
    77	#   prefixes, making it clear that red denotes trimmed-overhang evidence rather
    78	#   than a new segment color or a shifted duplicate.
    79	#
    80	# f_visual_cleanliness:
    81	#   Red trail cells lie on the same support line as their source segment and
    82	#   never branch. Offset gaps remain wide enough that colored finals and red
    83	#   remnants do not merge into ambiguous blobs, including diagonals where gaps
    84	#   stay at least four in perpendicular coordinates.
    85	#
    86	# g_change_inferability:
    87	#   The color rule is structural, not identity-based: red always means "this
    88	#   cell existed in the input but was removed by cropping." Because red is
    89	#   absent from the input palette and the kept segment retains its own original
    90	#   color, the mapping is inferable from 2-4 examples without hidden numeric
    91	#   color ordering.
    92	#
    93	# h_new_solver_assumptions_and_generator_guarantees:
    94	#   - Input reserves red for output-only warning marks.
    95	#   - There is at least one multi-cell segment, the dominant direction is
    96	#     unique, and perpendicular offsets are unique and odd in count.
    97	#   - At least one segment is longer than the reference, so the combo behavior
    98	#     differs from the seed output on every generated sample.
    99	#   - Shorter segments are also present, preserving the original extend/crop
   100	#     contrast instead of collapsing into a pure-cropping puzzle family.
   101	# ---------------------------------------------------------------------
   102	
   103	_DIR_CANDIDATES = [(0, 1), (1, 0), (1, 1), (1, -1)]  # horiz, vert, diag \, diag /
   104	_TRAIL_COLOR = int(Color.RED)
   105	
   106	
   107	def _pick_main_dir(g: np.ndarray, bg: int) -> tuple[int, int]:
   108	    counts = []
   109	    h, w = g.shape
   110	    for dr, dc in _DIR_CANDIDATES:
   111	        cnt = 0
   112	        for r in range(h):
   113	            for c in range(w):
   114	                v = int(g[r, c])
   115	                if v == bg:
   116	                    continue
   117	                rr, cc = r + dr, c + dc
   118	                if 0 <= rr < h and 0 <= cc < w and int(g[rr, cc]) == v:
   119	                    cnt += 1
   120	        counts.append(((dr, dc), cnt))
   121	
   122	    best_cnt = max(cnt for _, cnt in counts)
   123	    assert best_cnt > 0, "main direction must be detectable"
   124	    best_dirs = [d for d, cnt in counts if cnt == best_cnt]
   125	    assert len(best_dirs) == 1, "main direction must be unique"
   126	    return best_dirs[0]
   127	
   128	
   129	def _dot(p: tuple[int, int], d: tuple[int, int]) -> int:
   130	    return p[0] * d[0] + p[1] * d[1]
   131	
   132	
   133	def _perp_dot(p: tuple[int, int], d: tuple[int, int]) -> int:
   134	    return p[0] * d[1] - p[1] * d[0]
   135	
   136	
   137	def _cells_from_start(start: tuple[int, int], d: tuple[int, int], length: int) -> list[tuple[int, int]]:
   138	    dr, dc = d
   139	    rr, cc = start
   140	    cells = []
   141	    for _ in range(length):
   142	        cells.append((int(rr), int(cc)))
   143	        rr += dr
   144	        cc += dc
   145	    return cells
   146	
   147	
   148	def main(grid: np.ndarray) -> np.ndarray:
   149	    """
   150	    Align all parallel segments to the median reference span, while keeping every cropped-away cell visible in red.
   151	
   152	    Input structure:
   153	    - The background is the most common color.
   154	    - Several multi-cell monochrome line segments share one direction and sit on distinct parallel offsets.
   155	    - Red is reserved for output-only crop marks, while isolated single pixels may still appear and must stay untouched.
   156	
   157	    Rule:
   158	    - Detect the common segment direction and choose the segment at the median perpendicular offset as the reference.
   159	    - Shift every detected segment so its start matches the reference start, then redraw exactly the reference length in the segment's own color.
   160	    - If a segment was longer than that target length, any original cells that get cut off remain at their old coordinates in red instead of reverting to background.
   161	
   162	    Key insight:
   163	    - The alignment target is unchanged from the seed task; the only new signal is that red explicitly records the cells lost to cropping, while extensions remain ordinary segment-colored growth.
   164	    """
   165	    g = np.asarray(grid, dtype=int)
   166	    h, w = g.shape
   167	    bg = int(get_bg(g))
   168	    assert _TRAIL_COLOR != bg, "trail color must differ from background"
   169	
   170	    d = _pick_main_dir(g, bg)
   171	    dr, dc = d
   172	    delta_t = dr * dr + dc * dc
   173	
   174	    segments = []
   175	    colors = [int(c) for c in np.unique(g) if int(c) != bg]
   176	    assert _TRAIL_COLOR not in colors, "input must reserve red for crop marks"
   177	    for col in colors:
   178	        mask = g == col
   179	        for r in range(h):
   180	            for c in range(w):
   181	                if not mask[r, c]:
   182	                    continue
   183	                pr, pc = r - dr, c - dc
   184	                if 0 <= pr < h and 0 <= pc < w and mask[pr, pc]:
   185	                    continue
   186	                cells = []
   187	                rr, cc = r, c
   188	                while 0 <= rr < h and 0 <= cc < w and mask[rr, cc]:
   189	                    cells.append((rr, cc))
   190	                    rr += dr
   191	                    cc += dc
   192	                if len(cells) < 2:
   193	                    continue
   194	                start = cells[0]
   195	                end = cells[-1]
   196	                segments.append(
   197	                    {
   198	                        "color": col,
   199	                        "cells": cells,
   200	                        "start": start,
   201	                        "t_start": _dot(start, d),
   202	                        "t_end": _dot(end, d),
   203	                        "s": _perp_dot(start, d),
   204	                        "len": len(cells),
   205	                    }
   206	                )
   207	
   208	    assert segments, "at least one multi-cell segment must exist"
   209	
   210	    s_vals = sorted(s["s"] for s in segments)
   211	    if delta_t == 2:
   212	        for i in range(len(s_vals) - 1):
   213	            assert s_vals[i + 1] - s_vals[i] >= 4
   214	    assert len(s_vals) % 2 == 1, "segment count must have a single median"
   215	    assert len(s_vals) == len(set(s_vals)), "segment line coordinates must be unique"
   216	    s_ref = s_vals[len(s_vals) // 2]
   217	    ref_cands = [s for s in segments if s["s"] == s_ref]
   218	    assert len(ref_cands) == 1, "median reference segment must be unique"
   219	    ref = ref_cands[0]
   220	    ref_t0, ref_t1 = ref["t_start"], ref["t_end"]
   221	    assert ref_t1 >= ref_t0, "traced segment coordinates must increase"
   222	    assert (ref_t1 - ref_t0) % delta_t == 0, "reference segment length must align with delta_t"
   223	    target_len = (ref_t1 - ref_t0) // delta_t + 1
   224	
   225	    out = g.copy()
   226	    for s in segments:
   227	        for r, c in s["cells"]:
   228	            out[r, c] = bg
   229	
   230	    placements = []
   231	    for s in segments:
   232	        dt = ref_t0 - s["t_start"]
   233	        assert dt % delta_t == 0, "segment shift must be aligned to delta_t"
   234	        k = dt // delta_t
   235	        r0 = s["start"][0] + k * dr
   236	        c0 = s["start"][1] + k * dc
   237	        final_cells = _cells_from_start((r0, c0), d, target_len)
   238	        for rr, cc in final_cells:
   239	            assert 0 <= rr < h and 0 <= cc < w, "shifted segment must stay in bounds"
   240	        placements.append(
   241	            {
   242	                "color": s["color"],
   243	                "orig_cells": s["cells"],
   244	                "final_cells": final_cells,
   245	                "was_trimmed": s["len"] > target_len,
   246	            }
   247	        )
   248	
   249	    for p in placements:
   250	        if not p["was_trimmed"]:
   251	            continue
   252	        final_set = set(p["final_cells"])
   253	        for r, c in p["orig_cells"]:
   254	            if (r, c) not in final_set:
   255	                out[r, c] = _TRAIL_COLOR
   256	
   257	    for p in placements:
   258	        for r, c in p["final_cells"]:
   259	            out[r, c] = p["color"]
   260	
   261	    return out
   262	
   263	
   264	# --------------- generator (combo D4/3 + D14/1) ---------------
   265	
   266	# --- Canvas ---
   267	_H, _W = 16, 16
   268	_BG = 7
   269	
   270	# --- Directions and colors ---
   271	_DIRS = [(0, 1), (1, 0), (1, 1), (1, -1)]
   272	_COLORS = [1, 3, 5, 6, 8, 9]  # exclude red because red is the trail marker
   273	
   274	# --- Segment counts and reference length ---
   275	_SEGMENT_COUNTS = [3, 5]
   276	_REF_LEN_RANGE = (3, 8)
   277	_MAX_SEG_LEN = 12
   278	
   279	# --- Perpendicular gap constraints ---
   280	_PERP_GAP_ORTHO = [2, 3, 4, 5, 6]
   281	_PERP_GAP_DIAG = [4, 6]
   282	
   283	# --- Color assignment ---
   284	_MAX_DISTINCT_COLORS = 3
   285	_SAME_LEN_AVOID_PROB = 0.75
   286	_EXTRA_LONG_PROB = 0.45
   287	
   288	# --- Search / retry ---
   289	_T_SCAN_RANGE = (-30, 31)
   290	_GEN_RETRIES = 300
   291	
   292	
   293	def _step(d: tuple[int, int]) -> int:
   294	    dr, dc = d
   295	    return dr * dr + dc * dc
   296	
   297	
   298	def _cell_from_ts(d: tuple[int, int], t: int, s: int) -> tuple[int, int] | None:
   299	    if d == (0, 1):
   300	        r, c = s, t
   301	    elif d == (1, 0):
   302	        r, c = t, -s
   303	    elif d == (1, 1):
   304	        if (t + s) % 2 or (t - s) % 2:
   305	            return None
   306	        r, c = (t + s) // 2, (t - s) // 2
   307	    else:
   308	        if (t - s) % 2 or (-s - t) % 2:
   309	            return None
   310	        r, c = (t - s) // 2, (-s - t) // 2
   311	    if 0 <= r < _H and 0 <= c < _W:
   312	        return int(r), int(c)
   313	    return None
   314	
   315	
   316	def _segment_cells(d: tuple[int, int], t0: int, s: int, length: int) -> list[tuple[int, int]] | None:
   317	    delta = _step(d)
   318	    cells = []
   319	    for k in range(length):
   320	        cell = _cell_from_ts(d, t0 + k * delta, s)
   321	        if cell is None:
   322	            return None
   323	        cells.append(cell)
   324	    return cells
   325	
   326	
   327	def _max_len_from(d: tuple[int, int], t0: int, s: int) -> int:
   328	    delta = _step(d)
   329	    length = 0
   330	    while _cell_from_ts(d, t0 + length * delta, s) is not None:
   331	        length += 1
   332	    return length
   333	
   334	
   335	def _max_len_to(d: tuple[int, int], t1: int, s: int) -> int:
   336	    delta = _step(d)
   337	    length = 0
   338	    while _cell_from_ts(d, t1 - length * delta, s) is not None:
   339	        length += 1
   340	    return length

