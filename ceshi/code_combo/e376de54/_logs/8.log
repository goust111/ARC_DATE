from arc_utils import Color, get_bg

# ---------------------------------------------------------------------
# Design analysis for the D4 variant
#
# variant_spec:
#   core_change:
#     original_behavior:
#       Every detected segment is shifted so its start matches the reference
#       start, then re-drawn at the reference length. Any overhang from a
