+
+def _trace_dashed_segment(
+    g: np.ndarray, bg: int, r: int, c: int, d: tuple[int, int]
+) -> list[tuple[int, int]]:
+    color = int(g[r, c])
+    cells = [(r, c)]
+    rr, cc = r, c
+    while _has_dash_link(g, bg, rr, cc, d, color):
+        rr += 2 * d[0]
+        cc += 2 * d[1]
+        cells.append((rr, cc))
+    return cells
