+def _extract_segments(g: np.ndarray, bg: int) -> tuple[list[dict], set[tuple[int, int]]]:
+    d = _DIR
+    dr, dc = d
+    delta_t = _step(d)
+    h, w = g.shape
+    segments = []
+    used = set()
+
+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if color == bg:
+                continue
+            if _has_dash_link(g, bg, r, c, (-dr, -dc), color):
+                continue
+
+            cells = _trace_dashed_segment(g, bg, r, c, d)
+            if len(cells) < 2:
+                continue
+
+            start = cells[0]
+            end = cells[-1]
+            t_start = _dot(start, d)
+            t_end = _dot(end, d)
+            assert (t_end - t_start) % delta_t == 0
+            span = (t_end - t_start) // delta_t + 1
+            assert span >= _MIN_SPAN and span % 2 == 1
+            assert len(cells) == (span + 1) // 2
+            segments.append(
+                {
+                    "color": color,
+                    "cells": cells,
+                    "start": start,
+                    "end": end,
+                    "t_start": t_start,
+                    "t_end": t_end,
+                    "s": _perp_dot(start, d),
+                    "span": span,
+                }
+            )
+            used.update(cells)
