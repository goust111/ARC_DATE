+def _dot(p: tuple[int, int], d: tuple[int, int]) -> int:
+    return p[0] * d[0] + p[1] * d[1]
+
+
+def _perp_dot(p: tuple[int, int], d: tuple[int, int]) -> int:
+    return p[0] * d[1] - p[1] * d[0]
+
+
+def _step(d: tuple[int, int]) -> int:
+    dr, dc = d
+    return dr * dr + dc * dc
+
+
+def _cell_from_ts(shape: tuple[int, int], d: tuple[int, int], t: int, s: int) -> tuple[int, int] | None:
+    h, w = shape
+    if d == (0, 1):
+        r, c = s, t
+    elif d == (1, 0):
+        r, c = t, -s
+    elif d == (1, 1):
+        if (t + s) % 2 or (t - s) % 2:
+            return None
+        r, c = (t + s) // 2, (t - s) // 2
+    else:
+        if (t - s) % 2 or (-s - t) % 2:
+            return None
+        r, c = (t - s) // 2, (-s - t) // 2
+    if 0 <= r < h and 0 <= c < w:
+        return int(r), int(c)
+    return None
+
+
+def _extract_segments(g: np.ndarray, d: tuple[int, int], bg: int) -> list[dict]:
+    h, w = g.shape
+    dr, dc = d
+    segments = []
+    colors = [int(c) for c in np.unique(g) if int(c) != bg]
+    for col in colors:
+        mask = g == col
+        for r in range(h):
+            for c in range(w):
+                if not mask[r, c]:
+                    continue
+                pr, pc = r - dr, c - dc
+                if 0 <= pr < h and 0 <= pc < w and mask[pr, pc]:
+                    continue
+                cells = []
+                rr, cc = r, c
+                while 0 <= rr < h and 0 <= cc < w and mask[rr, cc]:
+                    cells.append((rr, cc))
+                    rr += dr
+                    cc += dc
+                if len(cells) < 2:
+                    continue
+                start = cells[0]
+                end = cells[-1]
+                segments.append(
+                    {
+                        "color": col,
+                        "cells": cells,
+                        "start": start,
+                        "end": end,
+                        "t_start": _dot(start, d),
+                        "t_end": _dot(end, d),
+                        "s": _perp_dot(start, d),
+                        "len": len(cells),
+                    }
+                )
+    return segments
+
