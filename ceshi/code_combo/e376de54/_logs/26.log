   176	def main(grid: np.ndarray) -> np.ndarray:
   177	    """
   178	    Normalize a family of parallel segments while preserving the old layout, marking extensions, and greying the chosen reference.
   179	
   180	    Input structure:
   181	    - The most frequent color is background.
   182	    - Foreground consists of 3 or 5 monochrome multi-cell segments, all parallel and all lying on distinct perpendicular offsets.
   183	    - The segments share a single dominant direction and one anchor mode; isolated single cells, if any, are ignored.
   184	
   185	    Rule:
   186	    - Detect the dominant direction, extract every multi-cell segment, and choose the reference as the segment at the median perpendicular offset.
   187	    - Keep every original segment cell as a pale trail in the output.
   188	    - Shift each segment so its start matches the reference start and redraw a segment of the reference length.
   189	    - On non-reference tracks, the carried-over aligned prefix keeps the original color, any extra cells needed for extension become the extension marker color, and trimmed source-only cells remain visible only as trail.
   190	    - On the reference track, the normalized segment is painted entirely grey to expose the selected reference line.
   191	
   192	    Key insight: The geometry still follows the base task exactly, but the rendering now encodes three facts simultaneously: where each line used to be, which pixels were newly added by extension, and which line served as the hidden reference.
   193	    """
   194	    g = np.asarray(grid, dtype=int)
   195	    h, w = g.shape
   196	    bg = get_bg(g)
   197	
   198	    d = _pick_main_dir(g, bg)
   199	    dr, dc = d
   200	    delta_t = dr * dr + dc * dc
   201	
   202	    segments = _extract_segments(g, bg, d)
   203	    s_ref, ref_t0, target_len = _pick_reference(segments, delta_t)
   204	
   205	    out = g.copy()
   206	    for s in segments:
   207	        for r, c in s["cells"]:
   208	            out[r, c] = _TRAIL_MARK
   209	
   210	    for s in segments:
   211	        dt = ref_t0 - int(s["t_start"])
   212	        assert dt % delta_t == 0, "segment shift must be aligned to delta_t"
   213	        k = dt // delta_t
   214	        r0 = int(s["start"][0]) + k * dr
   215	        c0 = int(s["start"][1]) + k * dc
   216	        rr, cc = r0, c0
   217	        if int(s["s"]) == s_ref:
   218	            for _ in range(target_len):
   219	                assert 0 <= rr < h and 0 <= cc < w, "shifted reference must stay in bounds"
   220	                out[rr, cc] = _REF_MARK
   221	                rr += dr
   222	                cc += dc
   223	            continue
   224	
   225	        original_keep = min(int(s["len"]), target_len)
   226	        for idx in range(target_len):
   227	            assert 0 <= rr < h and 0 <= cc < w, "shifted segment must stay in bounds"
   228	            out[rr, cc] = int(s["color"]) if idx < original_keep else _EXT_MARK
   229	            rr += dr
   230	            cc += dc
   231	
   232	    return out
