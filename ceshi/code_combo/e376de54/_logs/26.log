   157	def _pick_reference(segments: list[dict[str, object]], delta_t: int) -> tuple[int, int, int]:
   158	    s_vals = sorted(int(s["s"]) for s in segments)
   159	    if delta_t == 2:
   160	        for i in range(len(s_vals) - 1):
   161	            assert s_vals[i + 1] - s_vals[i] >= 4
   162	    assert len(s_vals) % 2 == 1, "segment count must have a single median"
   163	    assert len(s_vals) == len(set(s_vals)), "segment line coordinates must be unique"
   164	    s_ref = s_vals[len(s_vals) // 2]
   165	    ref_cands = [s for s in segments if int(s["s"]) == s_ref]
   166	    assert len(ref_cands) == 1, "median reference segment must be unique"
   167	    ref = ref_cands[0]
   168	    ref_t0 = int(ref["t_start"])
   169	    ref_t1 = int(ref["t_end"])
   170	    assert ref_t1 >= ref_t0, "traced segment coordinates must increase"
   171	    assert (ref_t1 - ref_t0) % delta_t == 0, "reference segment length must align with delta_t"
   172	    target_len = (ref_t1 - ref_t0) // delta_t + 1
   173	    return s_ref, ref_t0, target_len
