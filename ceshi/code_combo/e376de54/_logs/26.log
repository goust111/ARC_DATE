   143	                    {
   144	                        "color": col,
   145	                        "cells": cells,
   146	                        "start": start,
   147	                        "t_start": _dot(start, d),
   148	                        "t_end": _dot(end, d),
   149	                        "s": _perp_dot(start, d),
   150	                        "len": len(cells),
   151	                    }
