   118	def _extract_segments(g: np.ndarray, bg: int, d: tuple[int, int]) -> list[dict[str, object]]:
   119	    h, w = g.shape
   120	    dr, dc = d
   121	    segments: list[dict[str, object]] = []
   122	    colors = [int(c) for c in np.unique(g) if int(c) != bg]
   123	    for col in colors:
   124	        mask = g == col
   125	        for r in range(h):
   126	            for c in range(w):
   127	                if not mask[r, c]:
   128	                    continue
   129	                pr, pc = r - dr, c - dc
   130	                if 0 <= pr < h and 0 <= pc < w and mask[pr, pc]:
   131	                    continue
   132	                cells = []
   133	                rr, cc = r, c
   134	                while 0 <= rr < h and 0 <= cc < w and mask[rr, cc]:
   135	                    cells.append((rr, cc))
   136	                    rr += dr
   137	                    cc += dc
