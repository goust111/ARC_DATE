   193	    while _cell_from_ts(d, t1 - length * delta, s) is not None:
   194	        length += 1
   195	    return length
   196	
   197	
   198	def _extract_segments(
   199	    g: np.ndarray, bg: int, d: tuple[int, int]
   200	) -> list[dict[str, object]]:
   201	    h, w = g.shape
   202	    dr, dc = d
   203	    segments: list[dict[str, object]] = []
   204	
   205	    for col in [int(c) for c in np.unique(g) if int(c) != bg]:
   206	        mask = g == col
   207	        for r in range(h):
   208	            for c in range(w):
   209	                if not mask[r, c]:
   210	                    continue
   211	                pr, pc = r - dr, c - dc
   212	                if 0 <= pr < h and 0 <= pc < w and mask[pr, pc]:
   213	                    continue
   214	                cells = []
   215	                rr, cc = r, c
   216	                while 0 <= rr < h and 0 <= cc < w and mask[rr, cc]:
   217	                    cells.append((rr, cc))
   218	                    rr += dr
   219	                    cc += dc
   220	                if len(cells) < 2:
   221	                    continue
   222	                start = cells[0]
   223	                end = cells[-1]
   224	                segments.append(
   225	                    {
   226	                        "color": col,
   227	                        "cells": cells,
   228	                        "start": start,
   229	                        "end": end,
   230	                        "t_start": _dot(start, d),
   231	                        "t_end": _dot(end, d),
   232	                        "s": _perp_dot(start, d),
   233	                        "len": len(cells),
   234	                    }
   235	                )
   236	    assert segments, "at least one multi-cell segment must exist"
   237	    return segments
   238	
   239	
   240	def _select_reference(
   241	    segments: list[dict[str, object]], delta_t: int
   242	) -> tuple[dict[str, object], int]:
   243	    s_vals = sorted(int(s["s"]) for s in segments)
   244	    if delta_t == 2:
   245	        for i in range(len(s_vals) - 1):
   246	            assert s_vals[i + 1] - s_vals[i] >= 4
   247	    assert len(s_vals) % 2 == 1, "segment count must have a single median"
   248	    assert len(s_vals) == len(set(s_vals)), "segment line coordinates must be unique"
   249	    s_ref = s_vals[len(s_vals) // 2]
   250	    ref_cands = [s for s in segments if int(s["s"]) == s_ref]
   251	    assert len(ref_cands) == 1, "median reference segment must be unique"
   252	    return ref_cands[0], s_ref
   253	
   254	
   255	def _head_align_segments(
   256	    segments: list[dict[str, object]], ref_t0: int, d: tuple[int, int], delta_t: int
   257	) -> list[dict[str, object]]:
   258	    dr, dc = d
   259	    aligned = []
   260	    for s in segments:
   261	        dt = ref_t0 - int(s["t_start"])
   262	        assert dt % delta_t == 0, "segment shift must be aligned to delta_t"
   263	        k = dt // delta_t
   264	        start = s["start"]
   265	        r0 = int(start[0]) + k * dr
   266	        c0 = int(start[1]) + k * dc
   267	        aligned.append(
   268	            {
   269	                "color": int(s["color"]),
   270	                "start": (r0, c0),
   271	                "len": int(s["len"]),
   272	                "s": int(s["s"]),
   273	            }
   274	        )
   275	    return aligned
   276	
   277	
   278	def _paint_segments(
   279	    out: np.ndarray,
   280	    segments: list[dict[str, object]],
