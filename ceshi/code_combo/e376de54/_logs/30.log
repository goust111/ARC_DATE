+    for _ in range(n - 1):
+        patterns = [p + [g] for p in patterns for g in _PERP_GAP_DIAG]
+    return [
+        p
+        for p in patterns
+        if sum(p) <= max_span and (n == 3 and p[0] != p[1] or n == 5 and len(set(p)) > 1)
+    ]
+
+
