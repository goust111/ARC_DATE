+def _trace_dashed_segment(
+    g: np.ndarray, bg: int, r: int, c: int
+) -> list[tuple[int, int]]:
+    color = int(g[r, c])
+    cells = [(r, c)]
+    rr, cc = r, c
+    while _has_dash_link(g, bg, rr, cc, _DIR, color):
+        rr += 2 * _DIR[0]
+        cc += 2 * _DIR[1]
+        cells.append((rr, cc))
+    return cells
+
+
+def _extract_segments(
+    g: np.ndarray, bg: int
+) -> tuple[list[dict], set[tuple[int, int]]]:
+    segments = []
+    used = set()
+    h, w = g.shape
+
+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if color == bg:
