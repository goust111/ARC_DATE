+
+
+def _choose_spans(ref_span: int, caps: list[int], n: int) -> list[int] | None:
+    ref_idx = n // 2
+    spans = [ref_span] * n
+    nonrefs = [i for i in range(n) if i != ref_idx]
+    longable = [i for i in nonrefs if caps[i] >= ref_span + 2]
