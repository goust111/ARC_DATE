+                {
+                    "color": color,
+                    "cells": cells,
+                    "start": start,
+                    "t_start": t_start,
+                    "t_end": t_end,
+                    "s": _perp_dot(start, _DIR),
+                    "occ_len": len(cells),
+                    "span": span,
+                }
+            )
+            used.update(cells)
