+    lo, hi = _s_limits()
+    gaps = random.choice(_gap_patterns(n))
+    s0 = random.randint(lo, hi - sum(gaps))
+    s_vals = [s0]
+    for gap in gaps:
+        s_vals.append(s_vals[-1] + gap)
+    return tuple(s_vals)
+
+
