+
+    out = np.full((_H, _W), _BG, dtype=int)
+    if not _paint(out, s_vals, [ref_t0] * n, [ref_span] * n, colors):
+        return None
+
+    starts = [ref_t0 + shift * _STEP for shift in stair_steps]
+    if len(set(starts)) != n:
+        return None
+    inp = np.full((_H, _W), _BG, dtype=int)
