+    short_i = random.choice([i for i in nonrefs if i != long_i])
+    spans[long_i] = random.choice(_odd_span_options(ref_span + 2, min(_MAX_SEG_SPAN, caps[long_i])))
+    spans[short_i] = random.choice(short_opts)
