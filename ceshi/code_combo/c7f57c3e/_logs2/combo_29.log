+# --------------- generator (o5x) ---------------
+
+# --- CFG: canvas ---
+GRID_SIZE_MIN = 22
+GRID_SIZE_MAX = 32
+GRID_MARGIN_FOR_SPRITES = 9
+
+# --- CFG: prototypes ---
+CORE_SHAPES = [(3, 3), (3, 4), (4, 4)]
+BG_CHOICES = [0, 2, 3, 4, 5, 6, 7, 8, 9]
