+
+    orientation = random.choice(BAND_ORIENTATIONS)
+    block = random.choice(BAND_BLOCK_CHOICES)
+    band_span = 4 * block + 2
+
+    low = max(GRID_SIZE_MIN, max_union_dim + GRID_MARGIN_FOR_SPRITES, band_span)
