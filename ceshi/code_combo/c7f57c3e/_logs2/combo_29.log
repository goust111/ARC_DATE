+OUTER_FIXUP_PROB = 0.7
+
+# --- CFG: sprite instances ---
+BIG_SCALES = [2, 3]
+
+# --- CFG: instruction band ---
+BAND_ORIENTATIONS = ["top", "left"]
+BAND_BLOCK_CHOICES = [2, 3]
+
+# --- CFG: placement ---
+PLACEMENT_BORDER = 1
+PLACEMENT_PADDING = 2
+PLACEMENT_CONNECTIVITY = 8
+
