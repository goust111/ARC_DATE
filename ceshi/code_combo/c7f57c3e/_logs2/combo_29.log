+    if start is None:
+        start = random.randint(1, n - band_len - 1)
+    if orientation == "top":
+        canvas[0, start : start + band_len] = seq
+    else:
+        canvas[start : start + band_len, 0] = seq
+    return start
+
+
+def _gen_attempt() -> np.ndarray | None:
