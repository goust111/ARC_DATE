+    raw_in_c = int(oa[1] - ia[1])
+
+    top = min(0, raw_in_r)
+    left = min(0, raw_in_c)
+    bottom = max(int(output_patch.shape[0]), raw_in_r + int(input_patch.shape[0]))
+    right = max(int(output_patch.shape[1]), raw_in_c + int(input_patch.shape[1]))
