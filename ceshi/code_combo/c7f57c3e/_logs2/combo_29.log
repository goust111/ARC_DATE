+
+
+def _make_prototypes(
+    bg: int,
+) -> tuple[list[np.ndarray], list[np.ndarray], dict[int, int], tuple[int, int, int, int]]:
+    """Create 4 source prototypes and their recolored target versions."""
+    for _ in range(60):
