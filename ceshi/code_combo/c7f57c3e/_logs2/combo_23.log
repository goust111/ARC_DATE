    75	def _infer_scale(arr: np.ndarray, base_anchor_hw: tuple[int, int], bg: int) -> tuple[int, tuple[int, int, int, int]]:
    76	    anc = _pick_anchor_bbox(arr, bg)
    77	    ar0, ac0, ar1, ac1 = anc
    78	    inst_h = int(ar1 - ar0 + 1)
    79	    inst_w = int(ac1 - ac0 + 1)
    80	    base_h, base_w = base_anchor_hw
    81	    assert inst_h % base_h == 0 and inst_w % base_w == 0, "anchor bbox must scale integrally"
    82	    scale_h = inst_h // base_h
    83	    scale_w = inst_w // base_w
    84	    assert scale_h == scale_w and scale_h >= 1, "sprite scale must be a positive integer"
    85	    return int(scale_h), anc
