+def _render_input(shape: tuple[int, int], bg: int, placed: list[dict]) -> np.ndarray:
+    out = np.full(shape, bg, dtype=int)
+    for item in placed:
+        paste(out, item["patch"], item["top"], item["left"], transparent=bg)
+    return out
