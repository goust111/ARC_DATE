   128	def _transfer_color(arr: np.ndarray, bg: int) -> int:
   129	    """Return the unique non-bg, non-1 color touching the anchor in 4-neighborhood."""
   130	    h, w = arr.shape
   131	    colors: set[int] = set()
   132	    for r, c in np.argwhere(arr == 1):
   133	        rr = int(r)
   134	        cc = int(c)
   135	        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
   136	            nr = rr + dr
   137	            nc = cc + dc
   138	            if 0 <= nr < h and 0 <= nc < w:
   139	                v = int(arr[nr, nc])
   140	                if v not in (bg, 1):
   141	                    colors.add(v)
   142	    assert len(colors) == 1, "expected exactly one anchor-adjacent transfer color"
   143	    return next(iter(colors))
