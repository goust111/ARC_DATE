   183	def _swap_items_from_pairs(pairs: list[tuple[dict, dict]], bg: int) -> tuple[list[dict], list[dict]]:
   184	    """Build gravity items and trail metadata from opposite-type pairs."""
   185	    items = []
   186	    trails = []
   187	    for sa, sb in pairs:
   188	        start_anchor_a = sb["anchor_pos"]
   189	        start_anchor_b = sa["anchor_pos"]
   190	        a_ar0, a_ac0, _a_ar1, _a_ac1 = _pick_anchor_bbox(sa["arr"], bg)
   191	        b_ar0, b_ac0, _b_ar1, _b_ac1 = _pick_anchor_bbox(sb["arr"], bg)
   192	        items.append(
   193	            {
   194	                "patch": sa["arr"],
   195	                "start_top": int(start_anchor_a[0] - a_ar0),
   196	                "start_left": int(start_anchor_a[1] - a_ac0),
   197	            }
   198	        )
   199	        items.append(
   200	            {
   201	                "patch": sb["arr"],
   202	                "start_top": int(start_anchor_b[0] - b_ar0),
   203	                "start_left": int(start_anchor_b[1] - b_ac0),
   204	            }
   205	        )
   206	
   207	        trails.append(
   208	            {
   209	                "a": sa,
   210	                "b": sb,
   211	                "color_a": _transfer_color(sa["arr"], bg),
   212	                "color_b": _transfer_color(sb["arr"], bg),
   213	                "anchor_box_a": _anchor_bbox_global(sa["bbox"], sa["arr"], bg),
   214	                "anchor_box_b": _anchor_bbox_global(sb["bbox"], sb["arr"], bg),
   215	            }
   216	        )
   217	    return items, trails
   218	
