+# --------------- generator ---------------
+
+# --- CFG: canvas ---
+GRID_SIZE_MIN = 22
+GRID_SIZE_MAX = 28
+
+# --- CFG: prototypes ---
+BG_CHOICES = [0, 2, 3, 4, 5, 6, 7, 8, 9]
+SECONDARY_SHARE_PROB = 0.45
+LABEL_TEMPLATES = [
+    np.array(
+        [
+            [0, 2, 0],
+            [1, 1, 1],
+            [0, 2, 0],
+            [3, 3, 3],
+        ],
+        dtype=int,
+    ),
+    np.array(
+        [
+            [0, 2, 2, 0],
+            [1, 1, 1, 1],
+            [0, 2, 2, 0],
+            [3, 0, 0, 3],
+        ],
+        dtype=int,
+    ),
+    np.array(
+        [
+            [0, 2, 2, 0],
+            [1, 1, 1, 1],
+            [0, 2, 2, 0],
+            [0, 2, 2, 0],
+            [3, 0, 0, 3],
+        ],
+        dtype=int,
+    ),
+]
+
+# --- CFG: instances / layout ---
+BIG_SCALES = [2, 3]
+LEFT_RIGHT_GAP = [5, 6, 7, 8]
+PAIR_ROW_GAP = [4, 5, 6, 7]
+TOP_ANCHOR_CHOICES = [2, 3, 4, 5]
+BORDER = 1
+INPUT_PADDING = 2
+MIN_FALL_DISTANCE = 4
+
+# --- CFG: generation retries ---
