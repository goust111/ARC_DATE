+        sub_g = grid[rr0:rr1, cc0:cc1]
+        sub_p = sp[(rr0 - top) : (rr1 - top), (cc0 - left) : (cc1 - left)]
+        mask = sub_p != bg
+        score = int(np.sum(sub_g[mask] == sub_p[mask])) if np.any(mask) else 0
+        if score > best_score:
