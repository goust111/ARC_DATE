   632	                    "pair_idx": pair_idx,
   633	                    "side": side,
   634	                    "patch": patch,
   635	                    "top": int(top),
   636	                    "left": int(left),
   637	                    "bbox": bbox,
   638	                }
   639	            )
   640	            bboxes.append(bbox)
   641	
   642	    if not _bboxes_separated(bboxes, INPUT_PADDING):
   643	        return None
   644	
   645	    for pair_idx in range(2):
   646	        left_box = [item for item in placed_inputs if item["pair_idx"] == pair_idx and item["side"] == "L"][0]["bbox"]
   647	        right_box = [item for item in placed_inputs if item["pair_idx"] == pair_idx and item["side"] == "R"][0]["bbox"]
   648	        if left_box[3] >= right_box[1]:
