   120	        mask = sub_p != bg
   121	        score = int(np.sum(sub_g[mask] == sub_p[mask])) if np.any(mask) else 0
   122	        if score > best_score:
   123	            best_score = score
   124	            best_idx = idx
   125	    return int(best_idx)
