    55	def _pick_anchor_bbox(arr: np.ndarray, bg: int) -> tuple[int, int, int, int]:
    56	    """Return the bbox of color-1 pixels; all valid sprites contain them."""
    57	    if np.any(arr == 1):
    58	        ys, xs = np.where(arr == 1)
    59	        return int(ys.min()), int(xs.min()), int(ys.max()), int(xs.max())
    60	    assert False, "sprite array has no color-1 pixels"
