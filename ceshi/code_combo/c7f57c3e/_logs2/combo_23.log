   146	def _best_opposite_pairing(group_a: list[dict], group_b: list[dict]) -> list[tuple[dict, dict]]:
   147	    """Minimum-total-distance bipartite pairing between A and B sprites."""
   148	    assert len(group_a) == len(group_b) and len(group_a) > 0
   149	    best_perm = None
   150	    best_score = None
   151	    for perm in itertools.permutations(range(len(group_b))):
   152	        score = 0
   153	        for ia, ib in enumerate(perm):
   154	            ra, ca = group_a[ia]["anchor_pos"]
   155	            rb, cb = group_b[ib]["anchor_pos"]
   156	            score += abs(ra - rb) + abs(ca - cb)
   157	        if best_score is None or score < best_score:
   158	            best_score = score
   159	            best_perm = perm
   160	    assert best_perm is not None
   161	    return [(group_a[i], group_b[j]) for i, j in enumerate(best_perm)]
