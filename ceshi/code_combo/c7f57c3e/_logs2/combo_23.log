   164	def _can_place(board: np.ndarray, patch: np.ndarray, top: int, left: int, bg: int) -> bool:
   165	    h, w = board.shape
   166	    ph, pw = patch.shape
   167	    if top < 0 or left < 0 or top + ph > h or left + pw > w:
   168	        return False
   169	    sub = board[top : top + ph, left : left + pw]
   170	    return not bool(((patch != bg) & (sub != bg)).any())
