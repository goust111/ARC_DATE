            placed_inputs.append({'pair_idx':pair_idx,'side':side,'patch':patch,'top':int(top),'left':int(left),'bbox':bbox}); bboxes.append(bbox)
        if not ok: break
    if not ok: continue
    if not mod._bboxes_separated(bboxes, mod.INPUT_PADDING): reasons['bbox_not_separated'] += 1; continue
    pairbad=False
    for pair_idx in range(2):
        left_box=[i for i in placed_inputs if i['pair_idx']==pair_idx and i['side']=='L'][0]['bbox']
        right_box=[i for i in placed_inputs if i['pair_idx']==pair_idx and i['side']=='R'][0]['bbox']
        if left_box[3] >= right_box[1]: reasons['no_corridor'] += 1; pairbad=True; break
    if pairbad: continue
    inp=mod._render_input((n,n), bg, placed_inputs)
    if len(mod.components_mask(inp "'!= bg, connectivity=8)) != 4: reasons['"'components"'!=4'"'] += 1; continue
    try:
        _sprites,pairs=mod._classify_sprites(inp,bg)
        items,trails=mod._swap_items_from_pairs(pairs,bg)
        swapped_only=mod._render_swapped_without_gravity(inp.shape,bg,items)
        landed_board,landed=mod._settle_items(inp.shape,bg,items)
        if mod._count_moving_replacements(landed) < 2: reasons['moved<2'] += 1; continue
        if mod._count_supported_replacements(landed, bg, inp.shape) < 1: reasons['supported<1'] += 1; continue
        if np.array_equal(swapped_only, landed_board): reasons['gravity_no_effect'] += 1; continue
        if not all(mod._trail_has_clear_final_corridor(landed_board, trail, bg) for trail in trails): reasons['trail_not_clear'] += 1; continue
        expected_out=landed_board.copy()
        for trail in trails: mod._draw_horizontal_trail(expected_out, trail)
        if np.array_equal(expected_out, swapped_only): reasons['trail_no_effect'] += 1; continue
        if np.array_equal(expected_out, inp): reasons['same_as_input'] += 1; continue
        if max(int(item['final_top']) - int(item['start_top']) for item in landed) < mod.MIN_FALL_DISTANCE: reasons['max_fall_small'] += 1; continue
        if not np.array_equal(mod.main(inp), expected_out): reasons['oracle_mismatch'] += 1; continue
        reasons['success'] += 1
    except Exception as e:
        reasons[type(e).__name__+':'+str(e)] += 1
print(reasons)
