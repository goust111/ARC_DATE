+    g = np.asarray(grid, dtype=int)
+    bg = get_bg(g)
+
+    _sprites, pairs = _classify_sprites(g, bg)
+    items, trails = _swap_items_from_pairs(pairs, bg)
+    out, _landed = _settle_items(g.shape, bg, items)
+    for trail in trails:
+        _draw_horizontal_trail(out, trail)
+    return out
