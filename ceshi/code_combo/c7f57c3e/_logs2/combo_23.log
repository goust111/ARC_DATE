+# Combo variant of c7f57c3e (index 23)
+# combo_spec: D3/1+D5/2+D14/1
+# Name: 完全位置交换 + 重力下落 + 路径可视化
+
+from __future__ import annotations
+
+import itertools
+import random
+from collections import defaultdict
+
+import numpy as np
