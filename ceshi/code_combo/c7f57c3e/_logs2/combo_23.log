+def _transfer_color(arr: np.ndarray, bg: int) -> int:
+    """Return the unique non-bg, non-1 color touching the anchor in 4-neighborhood."""
+    h, w = arr.shape
+    colors: set[int] = set()
+    for r, c in np.argwhere(arr == 1):
+        rr = int(r)
+        cc = int(c)
+        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+            nr = rr + dr
+            nc = cc + dc
+            if 0 <= nr < h and 0 <= nc < w:
+                v = int(arr[nr, nc])
+                if v not in (bg, 1):
+                    colors.add(v)
