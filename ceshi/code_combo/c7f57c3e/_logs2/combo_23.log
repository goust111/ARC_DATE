   596	        2 * BORDER + max_anchor_up + required_row_delta + bot_down + 1,
   597	    )
   598	    if min_n > GRID_SIZE_MAX:
   599	        return None
   600	    n = random.randint(min_n, GRID_SIZE_MAX)
   601	
   602	    extra_col_slack = max(0, n - (BORDER + max_anchor_left + required_col_delta + max_anchor_right + 1))
   603	    left_anchor_col = BORDER + max_anchor_left + random.randint(0, max(0, extra_col_slack // 3))
   604	    right_anchor_col = left_anchor_col + required_col_delta + random.randint(0, min(2, extra_col_slack))
   605	    if right_anchor_col > n - BORDER - max_anchor_right:
   606	        return None
   607	
   608	    min_top_anchor = BORDER + max_anchor_up
   609	    max_top_anchor = min(min_top_anchor + 3, n - BORDER - required_row_delta - bot_down)
   610	    if min_top_anchor > max_top_anchor:
   611	        return None
   612	    top_anchor_row = random.randint(min_top_anchor, max_top_anchor)
   613	    bottom_anchor_row = top_anchor_row + required_row_delta
   614	
   615	    pair_anchors = [
   616	        ((top_anchor_row, left_anchor_col), (top_anchor_row, right_anchor_col)),
   617	        ((bottom_anchor_row, left_anchor_col), (bottom_anchor_row, right_anchor_col)),
   618	    ]
   619	
   620	    placed_inputs = []
   621	    bboxes = []
   622	    for pair_idx, ((left_patch, right_patch), (left_anchor, right_anchor)) in enumerate(
   623	        zip(pair_patches, pair_anchors, strict=True)
   624	    ):
   625	        for side, patch, anchor in (("L", left_patch, left_anchor), ("R", right_patch, right_anchor)):
   626	            top, left, r1, c1 = _place_from_anchor(patch, anchor)
   627	            bbox = (top, left, r1, c1)
   628	            if not _in_bounds_bbox(bbox, n):
