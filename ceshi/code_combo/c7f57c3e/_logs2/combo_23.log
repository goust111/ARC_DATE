    88	def _match_prototype(
    89	    grid: np.ndarray,
    90	    sprite: dict,
    91	    protos: list[np.ndarray],
    92	    scale: int,
    93	    bg: int,
    94	) -> int:
    95	    """Score which prototype matches the observed sprite when anchor-aligned."""
    96	    h, w = grid.shape
    97	    r0, c0, _r1, _c1 = sprite["bbox"]
    98	    arr = sprite["arr"]
    99	    ar0, ac0, _ar1, _ac1 = _pick_anchor_bbox(arr, bg)
   100	
   101	    best_idx = 0
   102	    best_score = -1
   103	    for idx, proto in enumerate(protos):
   104	        sp = _scale_nn(proto, scale)
   105	        pr0, pc0, _pr1, _pc1 = _pick_anchor_bbox(proto, bg)
   106	        pr0 *= scale
   107	        pc0 *= scale
   108	        top = int((r0 + ar0) - pr0)
   109	        left = int((c0 + ac0) - pc0)
   110	
   111	        rr0 = max(0, top)
   112	        cc0 = max(0, left)
   113	        rr1 = min(h, top + sp.shape[0])
   114	        cc1 = min(w, left + sp.shape[1])
