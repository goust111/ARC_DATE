+    best_idx = 0
+    best_score = -1
+    for idx, proto in enumerate(protos):
+        sp = _scale_nn(proto, scale)
+        pr0, pc0, _pr1, _pc1 = _pick_anchor_bbox(proto, bg)
+        pr0 *= scale
+        pc0 *= scale
+        top = int((r0 + ar0) - pr0)
+        left = int((c0 + ac0) - pc0)
+
+        rr0 = max(0, top)
+        cc0 = max(0, left)
+        rr1 = min(h, top + sp.shape[0])
+        cc1 = min(w, left + sp.shape[1])
+        if rr0 >= rr1 or cc0 >= cc1:
+            continue
