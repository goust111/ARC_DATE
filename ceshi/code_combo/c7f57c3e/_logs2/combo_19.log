    return labels


def _colorize(labels: np.ndarray, colors: tuple[int, int], bg: int) -> np.ndarray:
    arr = np.full(labels.shape, bg, dtype=int)
    arr[labels == 1] = 1
    arr[labels == 2] = colors[0]
    arr[labels == 3] = colors[1]
    return arr


