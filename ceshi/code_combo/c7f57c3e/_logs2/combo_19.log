    """Pick count ordered color pairs with no reuse across sprites."""
    pool = [c for c in range(10) if c not in (bg, 1)]
    chosen = random.sample(pool, 2 * count)
    return [(chosen[2 * i], chosen[2 * i + 1]) for i in range(count)]


