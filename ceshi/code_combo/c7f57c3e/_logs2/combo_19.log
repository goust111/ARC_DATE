+def _place_aligned(out: np.ndarray, sprite: dict, donor_base: np.ndarray, bg: int) -> None:
+    """Paste a scaled donor pattern using anchor alignment onto the recipient sprite location."""
+    h, w = out.shape
+    scale = sprite["scale"]
+    repl = _scale_nn(donor_base, scale)
