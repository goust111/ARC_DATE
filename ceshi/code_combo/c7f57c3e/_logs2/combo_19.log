+        paste(reserve, marker, r, c, transparent=bg)
+        placements.append({"bbox": (r, c, r + marker.shape[0] - 1, c + marker.shape[1] - 1), "scale": scale})
+
+    ordered_x = sorted(placements, key=lambda rec: (_center_x(rec["bbox"]), rec["bbox"][0] + rec["bbox"][2]))
