+        sprite["scale"] = scale
+        sprite["anchor"] = (ar0, ac0, ar1, ac1)
+        sprite["base_arr"] = _downscale_nn_exact(arr, scale)
+        scales_seen.add(scale)
+
+    assert scales_seen == {1, 2, 3}, "sprites must use scales 1, 2, and 3 exactly once"
+    return sprites
