GRID_SIZE_MIN = 18
GRID_SIZE_MAX = 28
GRID_MARGIN_FOR_SPRITES = 8

# --- CFG: colors ---
BG_CHOICES = [0, 2, 3, 4, 5, 6, 7, 8, 9]

# --- CFG: sprite instances ---
SPRITE_COUNTS = [3, 4]
BIG_SCALES = [2, 3]

# --- CFG: placement ---
PLACEMENT_BORDER = 1
PLACEMENT_PADDING = 2
PLACEMENT_CONNECTIVITY = 8

# --- CFG: generation retries ---
MAX_RETRIES = 300

INNER_LABEL_TEMPLATES = [
    np.array(
        [
            [1, 2, 0],
            [1, 2, 3],
            [0, 0, 3],
        ],
        dtype=int,
    ),
    np.array(
        [
            [0, 1, 2],
            [3, 1, 2],
            [3, 0, 0],
        ],
        dtype=int,
    ),
    np.array(
        [
            [2, 1, 0],
