+    up = np.zeros_like(mask, dtype=bool)
+    down = np.zeros_like(mask, dtype=bool)
+    left = np.zeros_like(mask, dtype=bool)
+    right = np.zeros_like(mask, dtype=bool)
+    up[1:, :] = mask[:-1, :]
+    down[:-1, :] = mask[1:, :]
+    left[:, 1:] = mask[:, :-1]
+    right[:, :-1] = mask[:, 1:]
+
+    interior = mask & up & down & left & right
+    return mask & ~interior
