+BASE_SHAPE = (6, 6)
+INNER_SLICE = (slice(1, 5), slice(1, 5))
+
+# --- CFG: canvas ---
+GRID_SIZE_MIN = 18
+GRID_SIZE_MAX = 28
+GRID_MARGIN_FOR_SPRITES = 6
+
+# --- CFG: colors ---
+BG_CHOICES = [0, 2, 3, 4, 5, 6, 7, 8, 9]
+
+# --- CFG: sprite instances ---
+SPRITE_COUNTS = [3, 4]
+BIG_SCALES = [2, 3]
+
+# --- CFG: placement ---
+PLACEMENT_BORDER = 1
+PLACEMENT_PADDING = 2
+PLACEMENT_CONNECTIVITY = 8
+
+# --- CFG: generation retries ---
+MAX_RETRIES = 400
+
+INNER_LABEL_TEMPLATES = [
+    np.array(
+        [
+            [0, 2, 2, 0],
+            [3, 2, 1, 2],
+            [3, 1, 3, 2],
+            [0, 3, 3, 0],
+        ],
+        dtype=int,
+    ),
+    np.array(
+        [
+            [0, 2, 3, 0],
+            [2, 1, 2, 3],
+            [3, 2, 3, 1],
+            [0, 3, 2, 0],
+        ],
+        dtype=int,
+    ),
+    np.array(
+        [
+            [0, 0, 2, 0],
+            [3, 2, 1, 2],
+            [2, 3, 2, 1],
+            [0, 3, 3, 0],
+        ],
+        dtype=int,
+    ),
