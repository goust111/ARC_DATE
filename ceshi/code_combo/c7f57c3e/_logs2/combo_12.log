+def _infer_scale(arr: np.ndarray) -> int:
+    bh, bw = BASE_SHAPE
+    ah, aw = arr.shape
+    assert ah % bh == 0 and aw % bw == 0, "sprite bbox must be an integer scale of the base shape"
+    scale_h = ah // bh
+    scale_w = aw // bw
+    assert scale_h == scale_w and scale_h >= 1, "sprite scale must be isotropic"
+    return int(scale_h)
