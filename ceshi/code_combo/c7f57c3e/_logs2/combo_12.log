+        for rr, cc in s["pts"]:
+            out[rr, cc] = bg
+
+        swapped_patch = _scale_nn(swaps[group_idx], scale)
+        combo_patch = _compose_combo_patch(arr, swapped_patch, scale, bg)
+        paste(out, combo_patch, r0, c0, transparent=bg)
