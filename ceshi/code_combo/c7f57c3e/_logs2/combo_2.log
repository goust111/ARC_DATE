+
+
+def _ordered_variable_colors(arr: np.ndarray, bg: int) -> tuple[int, int]:
+    seen: list[int] = []
+    for value in arr.ravel().tolist():
+        v = int(value)
+        if v in (bg, 1):
+            continue
+        if v not in seen:
+            seen.append(v)
+    assert len(seen) == 2, "each sprite must expose exactly two ordered variable colors"
+    return int(seen[0]), int(seen[1])
