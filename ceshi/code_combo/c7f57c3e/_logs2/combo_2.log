+        [
+            [1, 0, 0, 2],
+            [1, 2, 2, 2],
+            [1, 0, 3, 0],
+            [1, 3, 3, 3],
+        ],
+        dtype=int,
+    ),
+    np.array(
+        [
+            [2, 2, 1, 2],
+            [0, 2, 1, 0],
+            [3, 3, 1, 3],
+            [0, 3, 1, 0],
+        ],
+        dtype=int,
+    ),
+    np.array(
+        [
+            [2, 1, 2, 0],
+            [2, 1, 2, 3],
+            [0, 1, 2, 3],
+            [3, 1, 3, 3],
+        ],
+        dtype=int,
+    ),
+    np.array(
+        [
+            [0, 2, 1, 3],
+            [2, 2, 1, 0],
+            [0, 3, 1, 3],
+            [2, 3, 1, 0],
+        ],
+        dtype=int,
+    ),
+]
+
+
+def _pick_shape_pair() -> tuple[np.ndarray, np.ndarray]:
+    idx_a, idx_b = random.sample(range(len(SHAPE_LIBRARY)), 2)
+    return SHAPE_LIBRARY[idx_a].copy(), SHAPE_LIBRARY[idx_b].copy()
