+# --------------- generator (combo D1/0 + D15/0) ---------------
+
+# --- CFG: canvas ---
+GRID_SIZE_MIN = 18
+GRID_SIZE_MAX = 28
+GRID_MARGIN_FOR_SPRITES = 7
+
+# --- CFG: palettes ---
+BG_CHOICES = [2, 3, 4, 5, 6, 7, 8, 9]
+
+# --- CFG: sprite instances ---
+SPRITE_COUNTS = [3, 4]
+BIG_SCALES = [2, 3]
+
+# --- CFG: placement ---
+PLACEMENT_BORDER = 1
+PLACEMENT_PADDING = 2
+PLACEMENT_CONNECTIVITY = 8
+
+# --- CFG: legend ---
