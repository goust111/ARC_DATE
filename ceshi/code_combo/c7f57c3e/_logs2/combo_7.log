+    paste(out, _scale_nn(protos[second_type], scale), top_a, left_a, transparent=bg)
+    paste(out, _scale_nn(protos[first_type], scale), top_b, left_b, transparent=bg)
+
+    records = [
+        {
+            "bbox": (
+                top_a,
+                left_a,
+                top_a + left_or_top.shape[0] - 1,
+                left_a + left_or_top.shape[1] - 1,
+            ),
+            "type": int(first_type),
+            "scale": int(scale),
+            "anchor_global": (
