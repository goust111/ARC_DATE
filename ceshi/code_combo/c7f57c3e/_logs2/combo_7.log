   119	def _transfer_color(arr: np.ndarray, bg: int) -> int:
   120	    """Return the unique non-bg, non-1 color touching the anchor in 4-neighborhood."""
   121	    h, w = arr.shape
   122	    colors: set[int] = set()
   123	    for r, c in np.argwhere(arr == 1):
   124	        rr = int(r)
   125	        cc = int(c)
   126	        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
   127	            nr = rr + dr
   128	            nc = cc + dc
   129	            if 0 <= nr < h and 0 <= nc < w:
   130	                v = int(arr[nr, nc])
   131	                if v not in (bg, 1):
   132	                    colors.add(v)
   133	    assert len(colors) == 1, "expected exactly one anchor-adjacent transfer color"
   134	    return next(iter(colors))
