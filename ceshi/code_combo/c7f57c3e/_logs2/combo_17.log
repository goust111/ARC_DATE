+        "scale": int(scale),
+        "row_idx": int(row_idx),
+        "col_idx": int(col_idx),
+        "out_top": int(out_top),
+        "out_left": int(out_left),
+        "in_top": int(in_top),
+        "in_left": int(in_left),
+    }
+
+
