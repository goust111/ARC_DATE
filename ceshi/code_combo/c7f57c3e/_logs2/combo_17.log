+#     - 假设外推目标锚点只需落在 `-1..3` 的一圈扩展内；generator 明确按此范围构造。
+
+from __future__ import annotations
+
+import os
+import random
+import sys
+
+import numpy as np
+
+THIS_DIR = os.path.dirname(__file__)
+SOLVER_DIR = os.path.abspath(os.path.join(THIS_DIR, "..", "..", "..", "..", "..", "solvers"))
+if SOLVER_DIR not in sys.path:
