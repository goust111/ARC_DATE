+        "expanded_top": int(min(row_indices) < 0),
+        "expanded_left": int(min(col_indices) < 0),
+        "expanded_bottom": int(max(row_indices) > 2),
+        "expanded_right": int(max(col_indices) > 2),
+    }
+    return inp, expected, stats
+
+
+def generate_input() -> np.ndarray:
