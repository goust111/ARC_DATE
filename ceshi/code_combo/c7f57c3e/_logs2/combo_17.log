   133	def _prototype_pair(sprites: list[dict[str, object]]) -> list[np.ndarray]:
   134	    areas = [
   135	        int((s["bbox"][2] - s["bbox"][0] + 1) * (s["bbox"][3] - s["bbox"][1] + 1))
   136	        for s in sprites
   137	    ]
   138	    min_area = min(areas)
   139	    base = [s for s, area in zip(sprites, areas, strict=False) if area == min_area]
   140	    uniq: dict[tuple[int, ...], np.ndarray] = {}
   141	    for s in base:
   142	        arr = s["arr"]
   143	        assert isinstance(arr, np.ndarray)
   144	        key = tuple(arr.ravel().tolist())
   145	        if key not in uniq:
   146	            uniq[key] = arr
   147	    assert len(uniq) == 2, "smallest-area sprites must yield exactly 2 distinct prototypes"
   148	    keys = list(uniq.keys())[:2]
   149	    return [uniq[keys[0]], uniq[keys[1]]]
