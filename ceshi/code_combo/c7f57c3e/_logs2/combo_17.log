+# --------------- generator (o5x) ---------------
+
+# --- CFG: canvas ---
+GRID_SIZE_MIN = 26
+GRID_SIZE_MAX = 30
+
+# --- CFG: guide lattice ---
+GUIDE_SIZE = 3
+GUIDE_STEP = 7
+GUIDE_ROW0_CHOICES = [5, 6, 7]
+GUIDE_COL0_CHOICES = [5, 6, 7]
