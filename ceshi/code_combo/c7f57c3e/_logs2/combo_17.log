    96	def _detect_guide_lattice(g: np.ndarray, bg: int) -> tuple[int, list[int], list[int], int]:
    97	    candidates: list[tuple[int, list[int], list[int], int]] = []
    98	    for color in sorted(int(c) for c in np.unique(g) if int(c) != bg):
    99	        comps = components_mask(g == color, connectivity=8)
   100	        if len(comps) != 9 or not all(len(comp) == 1 for comp in comps):
