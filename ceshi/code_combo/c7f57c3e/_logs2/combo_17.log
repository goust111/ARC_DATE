+def _classify_sprite(arr: np.ndarray, protos: list[np.ndarray]) -> tuple[int, int]:
+    base_h, base_w = protos[0].shape
+    h, w = arr.shape
+    assert h % base_h == 0 and w % base_w == 0, "sprite bbox must be integer-scaled prototype bbox"
