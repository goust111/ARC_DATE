+    min_area = min(areas)
+    base = [s for s, area in zip(sprites, areas, strict=False) if area == min_area]
+    uniq: dict[tuple[int, ...], np.ndarray] = {}
+    for s in base:
+        arr = s["arr"]
+        assert isinstance(arr, np.ndarray)
+        key = tuple(arr.ravel().tolist())
+        if key not in uniq:
