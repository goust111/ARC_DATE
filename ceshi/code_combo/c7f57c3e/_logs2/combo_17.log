+    all_guide_cols = [int(guide_origin_cols[0] + idx * step) for idx in range(min(col_indices), max(col_indices) + 1)]
+
+    min_r, max_r = 0, h - 1
+    min_c, max_c = 0, w - 1
+    for r in all_guide_rows:
