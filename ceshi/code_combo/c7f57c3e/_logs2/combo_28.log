+    g = np.asarray(grid, dtype=int)
+    bg = get_bg(g)
+    sprites = _extract_sprites(g, bg)
+
+    out = g.copy()
+    for s in sprites:
+        rr = s["pts"][:, 0]
+        cc = s["pts"][:, 1]
+        vals = out[rr, cc]
+        out[rr, cc] = np.array([_invert_color(int(v), bg) for v in vals], dtype=int)
+    return out
