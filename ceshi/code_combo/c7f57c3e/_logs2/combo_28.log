+        repl = protos[1 - best_idx]
+        for rr, cc in s["pts"]:
+            out[rr, cc] = bg
+        _place_patch_aligned(
+            out,
+            _scale_nn(repl, scale),
+            bbox,
+            inst_anchor,
+            _pick_anchor_bbox(repl, bg),
+            scale,
+            bg,
+        )
