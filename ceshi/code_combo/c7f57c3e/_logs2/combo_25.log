+    body0 = _pick_body_bbox(protos[0], bg)
+    body1 = _pick_body_bbox(protos[1], bg)
+    base_body_h = body0[2] - body0[0] + 1
+    base_body_w = body0[3] - body0[1] + 1
+    assert base_body_h == body1[2] - body1[0] + 1
+    assert base_body_w == body1[3] - body1[1] + 1
