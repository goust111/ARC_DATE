+            [0, 1, 0],
+            [1, 1, 1],
+        ],
+        dtype=int,
+    ),
+]
+
+# --- CFG: sprite instances ---
+SPRITE_COUNTS = [3, 4]
+BIG_SCALES = [2, 3]
+
+# --- CFG: placement ---
+PLACEMENT_BORDER = 1
+PLACEMENT_PADDING = 2
+PLACEMENT_CONNECTIVITY = 8
+
+# --- CFG: generation retries ---
+MAX_RETRIES = 400
