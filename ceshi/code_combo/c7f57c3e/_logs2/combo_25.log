+
+        paste(reserve, marker, ur, uc)
+        paste(out, output_patch, ur + out_r, uc + out_c, transparent=bg)
+        paste(inp, input_patch, ur + in_r, uc + in_c, transparent=bg)
+
+    for patch in distractors:
