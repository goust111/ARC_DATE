+def _recolor_sprite(arr: np.ndarray, src_colors: tuple[int, int], dst_colors: tuple[int, int]) -> np.ndarray:
+    out = arr.copy()
+    out[arr == src_colors[0]] = dst_colors[0]
+    out[arr == src_colors[1]] = dst_colors[1]
+    return out
