+
+def _colorize(labels: np.ndarray, palette: tuple[int, int], bg: int) -> np.ndarray:
+    out = np.full(labels.shape, bg, dtype=int)
+    out[labels == 1] = 1
+    out[labels == 2] = palette[0]
+    out[labels == 3] = palette[1]
+    return out
