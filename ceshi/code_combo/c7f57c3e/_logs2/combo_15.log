   321	        [
   322	            [0, 0, 1, 0, 0],
   323	            [0, 2, 2, 0, 0],
   324	            [0, 0, 3, 0, 0],
   325	            [0, 0, 3, 3, 0],
   326	            [0, 0, 0, 3, 0],
   327	        ],
   328	        dtype=int,
   329	    ),
   330	    np.array(
   331	        [
   332	            [0, 1, 0, 0],
   333	            [0, 2, 0, 0],
   334	            [0, 2, 3, 0],
   335	            [0, 0, 3, 3],
   336	            [0, 0, 0, 3],
   337	        ],
   338	        dtype=int,
   339	    ),
   340	)
   341	
   342	
   343	def _template_pool() -> tuple[np.ndarray, ...]:
   344	    seen: dict[tuple[tuple[int, int], tuple[int, ...]], np.ndarray] = {}
   345	    for template in PROTO_TEMPLATES:
   346	        seen.setdefault(_family_key(template), template)
   347	    return tuple(seen.values())
   348	
   349	
   350	TEMPLATE_POOL = _template_pool()
   351	
   352	
   353	def _colorize(labels: np.ndarray, palette: tuple[int, int], bg: int) -> np.ndarray:
   354	    out = np.full(labels.shape, bg, dtype=int)
   355	    out[labels == 1] = 1
   356	    out[labels == 2] = palette[0]
   357	    out[labels == 3] = palette[1]
   358	    return out
   359	
   360	
   361	def _valid_mirror_kinds(labels: np.ndarray) -> list[str]:
   362	    return [kind for kind in MIRROR_KINDS if not np.array_equal(_mirror(labels, kind), labels)]
   363	
   364	
   365	def _changed_inner_pixels(source_patch: np.ndarray, output_patch: np.ndarray, bg: int) -> int:
