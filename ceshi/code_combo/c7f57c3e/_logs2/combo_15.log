+
+# --------------- generator ---------------
+
+GRID_SIZE_MIN = 18
+GRID_SIZE_MAX = 28
+GRID_MARGIN_FOR_SPRITES = 6
+
+BG_CHOICES = [0, 2, 3, 4, 5, 6, 7, 8, 9]
+SMALL_SCALE = 2
+BIG_SCALE = 3
+
+PLACEMENT_BORDER = 1
+PLACEMENT_PADDING = 2
+PLACEMENT_CONNECTIVITY = 8
+
+MAX_RETRIES = 500
+
+PROTO_TEMPLATES = (
+    np.array(
+        [
+            [0, 1, 0, 0],
+            [2, 2, 3, 0],
+            [0, 3, 3, 0],
+            [0, 0, 3, 0],
