   414	        in_a = _scale_nn(_colorize(labels_a, pal_a, bg), scale_a)
   415	        in_b = _scale_nn(_colorize(labels_b, pal_b, bg), scale_b)
   416	        out_a = _compose_combo_patch(in_a, bg, pal_a, pal_b)
