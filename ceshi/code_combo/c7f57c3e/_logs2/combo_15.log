import importlib.util, collections, numpy as np
spec = importlib.util.spec_from_file_location('variant', '/home/lixinyu/snap/new/ceshi/code_combo/c7f57c3e/15/code.py')
mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)
counts = collections.Counter()
for i in range(100):
    bg = mod.random.choice(mod.BG_CHOICES)
    try:
        records = mod._build_sprite_records(bg)
    except Exception as e:
        counts['build:'+type(e).__name__+':'+str(e)] += 1
        continue
    placed = mod._place_sprites(records, bg)
    if placed is None:
        counts['place_fail'] += 1
        continue
    inp, expected = placed
    try:
        solved = mod.main(inp)
    except Exception as e:
        counts['main:'+type(e).__name__+':'+str(e)] += 1
        continue
    if not np.array_equal(solved, expected):
        counts['mismatch'] += 1
