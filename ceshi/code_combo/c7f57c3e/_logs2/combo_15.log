+    bg = get_bg(g)
+
+    comps = components_mask(g != bg, connectivity=8)
+    assert len(comps) == 2 * PAIR_COUNT, "grid must contain exactly four sprites"
+
+    sprites = [_extract_sprite_record(g, pts, bg) for pts in comps]
+
