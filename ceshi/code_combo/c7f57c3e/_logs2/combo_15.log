+def _detect_pair_transform(a: np.ndarray, b: np.ndarray) -> str:
+    for kind in MIRROR_KINDS:
+        if np.array_equal(_mirror(a, kind), b):
+            return kind
+    raise AssertionError("paired sprites are not related by a supported mirror")
