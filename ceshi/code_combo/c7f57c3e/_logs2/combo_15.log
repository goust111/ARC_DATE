+    records = _build_sprite_records(bg)
+    placed = _place_sprites(records, bg)
+    if placed is None:
+        return None
+    inp, expected = placed
+
+    try:
+        solved = main(inp)
+    except Exception:
+        return None
+    if np.array_equal(solved, expected):
+        return inp
+    return None
