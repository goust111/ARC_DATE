            ```python
            # Variant of c7f57c3e
# Dimension: D2 — 配对匹配策略 (match_cond)
# Change: 跨组配对时要求尺度相同（s.scale == d.scale）且位置重叠最大化... → 按对称性匹配

import random

import numpy as np

from arc_utils import bbox_coords, components_mask, get_bg, paste, random_free_location


# Design analysis for the D2 variant
# ----------------------------------
# variant_spec:
#   concrete_behavior:
#     - 每个非背景连通块仍然是一个缩放后的多色精灵，且都包含固定的颜色 1 锚点。
#     - 但输入不再只含“两个全局原型反复出现”。现在每个样例包含 2 对精灵；
#       每一对内部的两只精灵在形状上互为镜像（水平 / 垂直 / 主对角线 / 副对角线），
#       同时各自携带不同的两色调色板。
#     - 输出时，每只精灵保留自己的位置、尺度和几何形状，只把自己的两种非锚点颜色
#       换成镜像配对对象的两种颜色；因此真正交换的是“颜色对”，不是整个形状。
#   behavior_trace:
#     - 原逻辑：从最小精灵提取两种原型 -> 识别某精灵属于哪种原型与尺度 -> 直接替换成另一原型。
#     - 新逻辑：先对每个精灵按锚点恢复尺度 -> 压回未缩放标签图 -> 用镜像闭包求规范键；
#       规范键相同的两个精灵视为一对 -> 仅交换这一对的两种非锚点颜色。
#     - 差异：原题的“替换目标”由全局另一原型决定；变体的“替换颜色来源”由局部镜像配对决定。
#   complexity_calibration:
#     - 为了避免规则退化成“全局统一换色”，每对精灵都使用独立的颜色对，且样例内共有 4 个
#       不同的有序颜色对；这样不做配对就无法推出正确输出。
#     - 为了让镜像匹配成为必要条件，两对精灵使用不同的不对称模板，且至少有 1 对跨尺度
#       （一只 scale=1，另一只 scale in {2,3}），从而明确打破旧的“同尺度优先”思路。
#   implicit_assumption_audit:
#     - 原代码依赖“最小面积精灵恰好给出两个原型”以及“替换对象只由原型类别决定”；这些前提
#       在变体里都失效，因此不能再从最小精灵抽原型，也不能按原型二选一替换。
#     - 新 solver 改为依赖以下输入性质：
#       1. 每个精灵恰有 1 个锚点块（颜色 1），其缩放后仍是正方形块，可据此恢复 scale。
#       2. 两种非锚点角色的像素数固定为 2 和 4，缩放后面积仍严格有别，可据此恢复角色顺序。
#       3. 每个镜像家族在同一网格中恰好出现 2 次，可唯一成对。
#     - generator 会显式构造并验证这些性质。
#   placement_legality:
#     - 精灵按 bbox 留白放置，边界至少 1 格，bbox 之间至少间隔 2 格，避免 8 邻域粘连。
#     - 输出只在原 bbox 内重着色，不改变占用区域，因此不会新增越界或重叠风险。
#   visual_observability:
#     - 模板全部是非对称形状，镜像关系肉眼可见；而输出只交换颜色、不换形，能让人看到
#       “左边这只拿到了右边镜像体的颜色”。
#     - 至少一对跨尺度，能避免误读为“同尺寸精灵互换”。
#   cleanliness_and_color_inference:
#     - 每个精灵只有背景、锚点 1 和两种可变颜色，总颜色负担低。
#     - 两个可变区域的角色由几何面积区分，而非颜色 id 排序；这满足 ARC 中“可见特征驱动”
#       的要求，也让颜色交换规则可从少量样例推断。


# --------------- shared helpers ---------------

GRID_SIZE_MIN = 18
GRID_SIZE_MAX = 28
GRID_MARGIN_FOR_SPRITES = 6

BG_CHOICES = [0, 2, 3, 4, 5, 6, 7, 8, 9]
PAIR_COUNT = 2
BIG_SCALES = [2, 3]

PLACEMENT_BORDER = 1
PLACEMENT_PADDING = 2
PLACEMENT_CONNECTIVITY = 8

MAX_RETRIES = 400

MIRROR_KINDS = ("h", "v", "d", "ad")


def _anti_diag(arr: np.ndarray) -> np.ndarray:
    return np.fliplr(np.flipud(arr)).T


def _mirror(arr: np.ndarray, kind: str) -> np.ndarray:
    if kind == "id":
        return arr.copy()
    if kind == "h":
        return np.flipud(arr)
    if kind == "v":
        return np.fliplr(arr)
    if kind == "d":
        return arr.T
    if kind == "ad":
        return _anti_diag(arr)
    raise ValueError(f"unknown mirror kind: {kind}")


def _all_symmetries(arr: np.ndarray) -> list[np.ndarray]:
    return [
        arr.copy(),
        np.rot90(arr, 1),
        np.rot90(arr, 2),
        np.rot90(arr, 3),
        np.flipud(arr),
        np.fliplr(arr),
        arr.T,
        _anti_diag(arr),
    ]


def _scale_nn(arr: np.ndarray, scale: int) -> np.ndarray:
    if scale <= 1:
        return arr.copy()
    return np.repeat(np.repeat(arr, scale, axis=0), scale, axis=1)


def _tight_crop(arr: np.ndarray) -> np.ndarray:
    ys, xs = np.where(arr != 0)
    assert len(ys) > 0, "template must contain foreground cells"
    return arr[int(ys.min()) : int(ys.max()) + 1, int(xs.min()) : int(xs.max()) + 1].copy()


def _pick_anchor_bbox(arr: np.ndarray) -> tuple[int, int, int, int]:
    ys, xs = np.where(arr == 1)
    assert len(ys) > 0, "sprite must contain anchor color 1"
    return int(ys.min()), int(xs.min()), int(ys.max()), int(xs.max())


def _infer_scale(arr: np.ndarray) -> int:
    r0, c0, r1, c1 = _pick_anchor_bbox(arr)
    h = r1 - r0 + 1
    w = c1 - c0 + 1
    assert h == w, "scaled anchor must remain a square block"
    return int(h)


def _compress_scaled(arr: np.ndarray, scale: int) -> np.ndarray:
    h, w = arr.shape
    assert h % scale == 0 and w % scale == 0, "bbox must be divisible by scale"
    out = np.zeros((h // scale, w // scale), dtype=int)
    for r in range(out.shape[0]):
        for c in range(out.shape[1]):
            block = arr[r * scale : (r + 1) * scale, c * scale : (c + 1) * scale]
            vals = np.unique(block)
            assert len(vals) == 1, "sprite is not a nearest-neighbor scaled template"
            out[r, c] = int(vals[0])
    return out


def _normalize_roles(arr: np.ndarray, bg: int) -> tuple[np.ndarray, tuple[int, int]]:
    colors = [int(c) for c in np.unique(arr) if c not in (bg, 1)]
    assert len(colors) == 2, "each sprite must contain exactly two non-anchor colors"
    counts = sorted((int(np.sum(arr == c)), c) for c in colors)
    assert counts[0][0] != counts[1][0], "role areas must be distinct"
    role2_color = counts[0][1]
    role3_color = counts[1][1]

    norm = np.zeros(arr.shape, dtype=int)
    norm[arr == 1] = 1
    norm[arr == role2_color] = 2
    norm[arr == role3_color] = 3
    return norm, (role2_color, role3_color)


def _family_key(norm: np.ndarray) -> tuple[tuple[int, int], tuple[int, ...]]:
    candidates = []
    for variant in _all_symmetries(norm):
        candidates.append((tuple(map(int, variant.shape)), tuple(int(x) for x in variant.ravel())))
    return min(candidates)


def _extract_sprite_record(grid: np.ndarray, pts: np.ndarray, bg: int) -> dict:
    r0, c0, r1, c1 = bbox_coords(pts)
    arr = grid[r0 : r1 + 1, c0 : c1 + 1].copy()
    scale = _infer_scale(arr)
    base = _compress_scaled(arr, scale)
    norm, role_colors = _normalize_roles(base, bg)
    return {
        "pts": pts,
        "bbox": (r0, c0, r1, c1),
        "arr": arr,
        "scale": scale,
        "base": base,
        "norm": norm,
        "role_colors": role_colors,
        "key": _family_key(norm),
    }


def _recolor_sprite(arr: np.ndarray, bg: int, src_colors: tuple[int, int], dst_colors: tuple[int, int]) -> np.ndarray:
    out = arr.copy()
    out[arr == src_colors[0]] = dst_colors[0]
    out[arr == src_colors[1]] = dst_colors[1]
    out[arr == 1] = 1
    out[arr == bg] = bg
    return out


def _detect_pair_transform(a: np.ndarray, b: np.ndarray) -> str:
    for kind in MIRROR_KINDS:
        if np.array_equal(_mirror(a, kind), b):
            return kind
    if np.array_equal(a, b):
        return "id"
    raise AssertionError("paired sprites are not related by a supported mirror")


def main(grid: np.ndarray) -> np.ndarray:
    """
    Swap non-anchor colors between mirror-matched sprites while keeping every sprite fixed in place.

    Input structure:
    - bg is the most frequent color. Each foreground component is one scaled multicolor sprite with a color-1 anchor block and exactly two other colors.
    - The grid contains two mirror families; within each family, the two sprites have shapes related by one horizontal, vertical, or diagonal reflection, possibly at different scales.

    Rule:
    - Recover each sprite's integer scale from its anchor block, compress it back to an unscaled label pattern, and normalize the two non-anchor roles by their visible region sizes.
    - Group sprites by mirror-family equivalence, then for each matched pair exchange only the two non-anchor colors; each sprite keeps its own geometry, scale, and position.

    Key insight:
    - Mirror matching must happen on a scale-free, color-normalized representation. Once the reflected mate is found, the output is just a recoloring of the existing pixels, not a shape replacement.
    """
    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)

    comps = components_mask(g != bg, connectivity=8)
    assert len(comps) >= 2, "grid must contain at least two sprites"

    sprites = [_extract_sprite_record(g, pts, bg) for pts in comps]

    groups: dict[tuple[tuple[int, int], tuple[int, ...]], list[dict]] = {}
    for sprite in sprites:
        groups.setdefault(sprite["key"], []).append(sprite)

    assert len(groups) == PAIR_COUNT, "the grid must contain exactly two mirror families"

    out = g.copy()
    for family in groups.values():
        assert len(family) == 2, "each mirror family must contain exactly two sprites"
        left, right = family
        _detect_pair_transform(left["norm"], right["norm"])

        for sprite, partner in ((left, right), (right, left)):
            for rr, cc in sprite["pts"]:
                out[rr, cc] = bg
            recolored = _recolor_sprite(sprite["arr"], bg, sprite["role_colors"], partner["role_colors"])
            r0, c0, _r1, _c1 = sprite["bbox"]
            paste(out, recolored, r0, c0, transparent=bg)

    return out


# --------------- generator ---------------

PROTO_TEMPLATES = (
    np.array(
        [
            [0, 1, 0, 0],
            [2, 2, 3, 0],
            [0, 3, 3, 0],
            [0, 0, 3, 0],
        ],
        dtype=int,
    ),
    np.array(
        [
            [0, 1, 0, 0, 0],
            [0, 2, 0, 3, 0],
            [0, 2, 3, 3, 0],
            [0, 0, 0, 3, 0],
        ],
        dtype=int,
    ),
    np.array(
        [
            [0, 0, 1, 0],
            [0, 2, 2, 0],
            [3, 0, 0, 0],
            [0, 3, 3, 0],
            [0, 0, 3, 0],
        ],
        dtype=int,
    ),
    np.array(
        [
            [0, 1, 0, 0, 0],
            [0, 2, 2, 0, 0],
            [0, 0, 3, 3, 0],
            [0, 0, 0, 3, 3],
        ],
        dtype=int,
    ),
    np.array(
        [
            [0, 0, 1, 0, 0],
            [0, 2, 2, 0, 0],
            [0, 0, 3, 0, 0],
            [0, 0, 3, 3, 0],
            [0, 0, 0, 3, 0],
        ],
        dtype=int,
    ),
    np.array(
        [
            [0, 1, 0, 0],
            [0, 2, 0, 0],
            [0, 2, 3, 0],
            [0, 0, 3, 3],
            [0, 0, 0, 3],
        ],
        dtype=int,
    ),
)


def _colorize(labels: np.ndarray, palette: tuple[int, int], bg: int) -> np.ndarray:
    out = np.full(labels.shape, bg, dtype=int)
    out[labels == 1] = 1
    out[labels == 2] = palette[0]
    out[labels == 3] = palette[1]
    return out


def _pair_specs(bg: int) -> list[dict]:
    templates = random.sample(list(PROTO_TEMPLATES), PAIR_COUNT)
    mirror_kinds = random.sample(list(MIRROR_KINDS), PAIR_COUNT)

    pool = [c for c in range(10) if c not in (bg, 1)]
    palettes = random.sample([(a, b) for a in pool for b in pool if a != b], 2 * PAIR_COUNT)

    big_pair_idx = random.randrange(PAIR_COUNT)
    big_scale = random.choice(BIG_SCALES)

    specs = []
    palette_idx = 0
    for idx in range(PAIR_COUNT):
        template = _tight_crop(templates[idx])
        mirror_kind = mirror_kinds[idx]
        pal_a = palettes[palette_idx]
        pal_b = palettes[palette_idx + 1]
        palette_idx += 2

        scales = [1, 1]
        if idx == big_pair_idx:
            scales[random.randrange(2)] = big_scale

        left_labels = template
        right_labels = _tight_crop(_mirror(template, mirror_kind))
        if random.random() < 0.5:
            left_labels, right_labels = right_labels, left_labels

        specs.append(
            {
                "mirror_kind": mirror_kind,
                "labels": (left_labels, right_labels),
                "palettes": (pal_a, pal_b),
                "scales": tuple(scales),
            }
        )
    return specs


def _build_patches(bg: int) -> tuple[list[dict], list[dict]]:
    input_sprites = []
    output_sprites = []

    for spec in _pair_specs(bg):
        labels_a, labels_b = spec["labels"]
        pal_a, pal_b = spec["palettes"]
        scale_a, scale_b = spec["scales"]

        in_a = _scale_nn(_colorize(labels_a, pal_a, bg), scale_a)
        in_b = _scale_nn(_colorize(labels_b, pal_b, bg), scale_b)
        out_a = _scale_nn(_colorize(labels_a, pal_b, bg), scale_a)
        out_b = _scale_nn(_colorize(labels_b, pal_a, bg), scale_b)

        input_sprites.extend(
            [
                {"patch": in_a, "pair": len(input_sprites) // 2, "scale": scale_a},
                {"patch": in_b, "pair": len(input_sprites) // 2, "scale": scale_b},
            ]
        )
        output_sprites.extend(
            [
                {"patch": out_a, "pair": len(output_sprites) // 2, "scale": scale_a},
                {"patch": out_b, "pair": len(output_sprites) // 2, "scale": scale_b},
            ]
        )

    return input_sprites, output_sprites


def _place_sprites(inp_sprites: list[dict], out_sprites: list[dict], bg: int) -> tuple[np.ndarray, np.ndarray] | None:
    max_dim = max(max(sprite["patch"].shape) for sprite in inp_sprites)
    n = random.randint(max(GRID_SIZE_MIN, max_dim + GRID_MARGIN_FOR_SPRITES), GRID_SIZE_MAX)

    inp = np.full((n, n), bg, dtype=int)
    out = np.full((n, n), bg, dtype=int)
    reserve = np.full((n, n), bg, dtype=int)

    order = sorted(range(len(inp_sprites)), key=lambda idx: max(inp_sprites[idx]["patch"].shape), reverse=True)
    for idx in order:
        in_patch = inp_sprites[idx]["patch"]
        out_patch = out_sprites[idx]["patch"]
        marker = np.full(in_patch.shape, 1, dtype=int)
        try:
            r0, c0 = random_free_location(
                reserve,
                marker,
                transparent=bg,
                border=PLACEMENT_BORDER,
                padding=PLACEMENT_PADDING,
                padding_connectivity=PLACEMENT_CONNECTIVITY,
            )
        except ValueError:
            return None

        paste(reserve, marker, r0, c0)
        paste(inp, in_patch, r0, c0, transparent=bg)
        paste(out, out_patch, r0, c0, transparent=bg)

    return inp, out


def _gen_attempt() -> np.ndarray | None:
    bg = random.choice(BG_CHOICES)
    inp_sprites, out_sprites = _build_patches(bg)
    placed = _place_sprites(inp_sprites, out_sprites, bg)
    if placed is None:
        return None
    inp, expected = placed

    try:
        solved = main(inp)
    except Exception:
        return None
    if np.array_equal(solved, expected):
        return inp
    return None


def generate_input() -> np.ndarray:
    for _ in range(MAX_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid c7f57c3e D2 input")

            ```

            ### 参考代码: D14/0

            文件: `/home/lixinyu/snap/new/ceshi/code/c7f57c3e/D14/0/code.py`

            ```python
            # Variant of c7f57c3e
# Dimension: D14 — 交换后的轨迹/残留 (trajectory)
# Change: 无轨迹，颜色模式直接替换，原始颜色完全消失... → 保留原始颜色的轮廓痕迹

"""
Design analysis for the D14 variant.

- Concrete behavior:
  Input stays the same as the base task: 3-4 disconnected multicolor sprites, each a
  scaled copy of one of two prototypes. Output still swaps every sprite to the other
  prototype at the same scale and anchor alignment, but the source sprite does not
  vanish completely. A 1-pixel-wide contour of the source instance is painted back on
  top using the source colors. The contour is computed on the scaled instance pixels,
  so a scale-3 sprite gets a true 1-pixel rim instead of a 3-pixel-thick rim.
- Behavior trace on one sprite:
  Base task: clear the source sprite -> place the opposite prototype.
  Variant: clear the source sprite -> place the opposite prototype -> repaint only the
  source boundary pixels at their original coordinates and colors.
  The difference is visible exactly on the old sprite edge cells.
- Complexity calibration:
  The rule keeps the original two-prototype matching problem intact and adds one extra
  layer with a single binary choice per pixel: boundary or non-boundary. This avoids a
  proliferation of cases while producing a clear visual difference from direct replace.
- Hidden-assumption audit for main():
  Prototype detection from the smallest sprites still works because the input format is
  unchanged. Scale inference still depends on color-1 anchor bboxes being present and
  equally sized across the two prototypes; the generator keeps that invariant. The new
  edge repaint must not use prototype-space edges, or large sprites would get thick
  bands, so the solver computes edges from the observed scaled instance array itself.
  Repainting also assumes different sprites do not share the same swap footprint; the
  generator already reserves the aligned input/output union for every placed instance.
- Placement legality:
  The generator still works output-first. For each intended output sprite, it builds the
  full swapped patch (target sprite plus source contour), then reserves that aligned
  union footprint before placing both the output patch and the source input patch.
  This prevents overlap, clipping, and cross-sprite interference.
- Visual observability:
  The contour is visible in the output only, which matches the "trajectory/residue"
  interpretation. To make the new layer easy to notice, the generator biases the single
  large sprite toward scale 3 and lowers cross-prototype color sharing, so the old rim
  usually contrasts with the new interior.
- Visual cleanliness:
  Only one extra layer is added, and it lives on the boundary of the source sprite.
  There is no extra marker object and no global bookkeeping, so the output remains a
  set of separated sprites rather than a cluttered scene.
- Color inference:
  The recolored contour always copies literal source colors from the input sprite at the
  same cells. No hidden ordering by color id is used.
"""

import random

import numpy as np

from arc_utils import bbox_coords, components_mask, get_bg, paste, random_free_location


def _pick_anchor_bbox(arr: np.ndarray, bg: int) -> tuple[int, int, int, int]:
    """Pick the bbox of the color-1 anchor block; it is guaranteed to exist."""
    if np.any(arr == 1):
        ys, xs = np.where(arr == 1)
        return int(ys.min()), int(xs.min()), int(ys.max()), int(xs.max())
    assert False, "sprite array has no color-1 pixels and should always have them"


def _scale_nn(arr: np.ndarray, scale: int) -> np.ndarray:
    if scale <= 1:
        return arr.copy()
    return np.repeat(np.repeat(arr, scale, axis=0), scale, axis=1)


def _edge_mask(arr: np.ndarray, bg: int) -> np.ndarray:
    """1-pixel contour of the observed sprite instance, using 4-neighborhood erosion."""
    mask = arr != bg
    if not np.any(mask):
        return np.zeros_like(mask, dtype=bool)

    up = np.zeros_like(mask, dtype=bool)
    down = np.zeros_like(mask, dtype=bool)
    left = np.zeros_like(mask, dtype=bool)
    right = np.zeros_like(mask, dtype=bool)
    up[1:, :] = mask[:-1, :]
    down[:-1, :] = mask[1:, :]
    left[:, 1:] = mask[:, :-1]
    right[:, :-1] = mask[:, 1:]

    interior = mask & up & down & left & right
    return mask & ~interior


def _aligned_union_layout(
    source_patch: np.ndarray, target_patch: np.ndarray, bg: int
) -> tuple[int, int, tuple[int, int], tuple[int, int]]:
    """Return union size and top-left offsets when anchor-aligning target to source."""
    sa0, sb0, _sa1, _sb1 = _pick_anchor_bbox(source_patch, bg)
    ta0, tb0, _ta1, _tb1 = _pick_anchor_bbox(target_patch, bg)
    dr = int(sa0 - ta0)
    dc = int(sb0 - tb0)

    sh, sw = map(int, source_patch.shape)
    th, tw = map(int, target_patch.shape)
    top = min(0, dr)
    left = min(0, dc)
    bottom = max(sh, dr + th)
    right = max(sw, dc + tw)

    union_h = int(bottom - top)
    union_w = int(right - left)
    source_pos = (int(-top), int(-left))
    target_pos = (int(dr - top), int(dc - left))
    return union_h, union_w, source_pos, target_pos


def _compose_swapped_patch(source_patch: np.ndarray, target_patch: np.ndarray, bg: int) -> tuple[np.ndarray, tuple[int, int]]:
    """Build the aligned output patch: swapped target plus source-colored contour."""
    union_h, union_w, source_pos, target_pos = _aligned_union_layout(source_patch, target_patch, bg)
    out = np.full((union_h, union_w), bg, dtype=int)

    paste(out, target_patch, target_pos[0], target_pos[1], transparent=bg)

    edge = _edge_mask(source_patch, bg)
    sr, sc = source_pos
    out_view = out[sr : sr + source_patch.shape[0], sc : sc + source_patch.shape[1]]
    out_view[edge] = source_patch[edge]
    out[sr : sr + source_patch.shape[0], sc : sc + source_patch.shape[1]] = out_view
    return out, source_pos


def main(grid: np.ndarray) -> np.ndarray:
    """
    Swap each sprite to the opposite prototype while keeping a source-colored rim.

    Input structure:
    - The background is the most frequent color. Foreground pixels form 3-4 isolated sprites.
    - Every sprite is an integer-scaled copy of one of two small multicolor prototypes, and
      both prototypes contain a color-1 anchor region that survives all scaling.

    Rule:
    - Recover the two prototypes from the smallest sprites, infer each sprite's scale, and
      decide which prototype it currently matches.
    - Replace that sprite with the other prototype at the same scale and anchor alignment.
    - After placing the swapped sprite, repaint the 1-pixel boundary of the original instance
      at its original cells using its original colors.

    Key insight:
    - The anchor still solves the placement problem exactly as in the base task; the only new
      step is that the source instance is not discarded completely. Its scaled edge pixels are
      overlaid at the end, creating a colored trace of the old sprite around the new one.
    """
    g = np.asarray(grid, dtype=int)
    h, w = g.shape
    bg = get_bg(g)

    comps = components_mask(g != bg, connectivity=8)
    assert len(comps) >= 2, "grid must contain at least 2 sprite components"

    sprites = []
    for pts in comps:
        r0, c0, r1, c1 = bbox_coords(pts)
        arr = g[r0 : r1 + 1, c0 : c1 + 1].copy()
        sprites.append({"pts": pts, "bbox": (r0, c0, r1, c1), "arr": arr})

    areas = [int((s["bbox"][2] - s["bbox"][0] + 1) * (s["bbox"][3] - s["bbox"][1] + 1)) for s in sprites]
    min_area = min(areas)
    base = [s for s, a in zip(sprites, areas, strict=False) if a == min_area]
    uniq: dict[tuple[int, ...], np.ndarray] = {}
    for s in base:
        key = tuple(s["arr"].ravel().tolist())
        if key not in uniq:
            uniq[key] = s["arr"]
    assert len(uniq) == 2, "smallest-area sprites must yield exactly 2 distinct prototype patterns"

    proto_keys = list(uniq.keys())[:2]
    protos = [uniq[proto_keys[0]], uniq[proto_keys[1]]]

    anc0 = _pick_anchor_bbox(protos[0], bg)
    anc1 = _pick_anchor_bbox(protos[1], bg)
    base_anc_h0 = anc0[2] - anc0[0] + 1
    base_anc_w0 = anc0[3] - anc0[1] + 1
    base_anc_h1 = anc1[2] - anc1[0] + 1
    base_anc_w1 = anc1[3] - anc1[1] + 1
    assert (base_anc_h0, base_anc_w0) == (base_anc_h1, base_anc_w1), "prototype anchors must share the same size"

    out = g.copy()

    for s in sprites:
        r0, c0, _r1, _c1 = s["bbox"]
        arr = s["arr"]
        anc = _pick_anchor_bbox(arr, bg)
        ar0, ac0, ar1, ac1 = anc
        inst_anc_h = ar1 - ar0 + 1
        inst_anc_w = ac1 - ac0 + 1
        scale_h = max(1, inst_anc_h // max(1, base_anc_h0))
        scale_w = max(1, inst_anc_w // max(1, base_anc_w0))
        scale = int(max(scale_h, scale_w))

        best_idx = 0
        best_score = -1
        for idx, p in enumerate(protos):
            sp = _scale_nn(p, scale)
            panc = _pick_anchor_bbox(p, bg)
            pr0, pc0 = int(panc[0] * scale), int(panc[1] * scale)
            top = (r0 + ar0) - pr0
            left = (c0 + ac0) - pc0

            score = 0
            ph, pw = sp.shape
            rr0 = max(0, top)
            cc0 = max(0, left)
            rr1 = min(h, top + ph)
            cc1 = min(w, left + pw)
            if rr0 >= rr1 or cc0 >= cc1:
                continue
            sub_g = g[rr0:rr1, cc0:cc1]
            sub_p = sp[(rr0 - top) : (rr1 - top), (cc0 - left) : (cc1 - left)]
            m = sub_p != bg
            if np.any(m):
                score = int(np.sum(sub_g[m] == sub_p[m]))
            if score > best_score:
                best_score = score
                best_idx = idx

        repl_idx = 1 - best_idx

        for rr, cc in s["pts"]:
            out[rr, cc] = bg

        p = protos[repl_idx]
        sp = _scale_nn(p, scale)
        panc = _pick_anchor_bbox(p, bg)
        pr0, pc0 = int(panc[0] * scale), int(panc[1] * scale)
        top = (r0 + ar0) - pr0
        left = (c0 + ac0) - pc0

        ph, pw = sp.shape
        rr0 = max(0, top)
        cc0 = max(0, left)
        rr1 = min(h, top + ph)
        cc1 = min(w, left + pw)
        sub_p = sp[(rr0 - top) : (rr1 - top), (cc0 - left) : (cc1 - left)]
        m = sub_p != bg
        out_slice = out[rr0:rr1, cc0:cc1]
        out_slice[m] = sub_p[m]
        out[rr0:rr1, cc0:cc1] = out_slice

        edge = _edge_mask(arr, bg)
        edge_slice = out[r0 : r0 + arr.shape[0], c0 : c0 + arr.shape[1]]
        edge_slice[edge] = arr[edge]
        out[r0 : r0 + arr.shape[0], c0 : c0 + arr.shape[1]] = edge_slice

    return out


# --------------- generator (o5x, D14 variant) ---------------

# --- CFG: canvas ---
GRID_SIZE_MIN = 18
GRID_SIZE_MAX = 28
GRID_MARGIN_FOR_SPRITES = 6

# --- CFG: prototypes ---
PROTO_SHAPES = [(4, 3), (3, 4), (4, 4)]
BG_CHOICES = [0, 2, 3, 4, 5, 6, 7, 8, 9]
COLOR_SHARE_PROB = 0.2

# --- CFG: row-mask weights ---
ANCHOR_ROW_WEIGHTS = [("center", 0.45), ("outer", 0.35), ("full", 0.20)]
VARIABLE_ROW_WEIGHTS = [("center", 0.68), ("full", 0.32)]
OUTER_FIXUP_PROB = 0.7

# --- CFG: sprite instances ---
SPRITE_COUNTS = [3, 4]
BIG_SCALES = [2, 3, 3]

# --- CFG: placement ---
PLACEMENT_BORDER = 1
PLACEMENT_PADDING = 2
PLACEMENT_CONNECTIVITY = 8

# --- CFG: generation retries ---
MAX_RETRIES = 300

_ROW_MASKS = {
    "center": {3: [0, 1, 0], 4: [0, 1, 1, 0]},
    "outer": {3: [1, 0, 1], 4: [1, 0, 0, 1]},
    "full": {3: [1, 1, 1], 4: [1, 1, 1, 1]},
}


def _row_mask(kind: str, w: int) -> list[int]:
    return list(_ROW_MASKS[kind][w])


def _anchor_bbox(arr: np.ndarray) -> tuple[int, int, int, int]:
    rs, cs = np.where(arr == 1)
    return int(rs.min()), int(cs.min()), int(rs.max()), int(cs.max())


def _scale(arr: np.ndarray, k: int) -> np.ndarray:
    if k == 1:
        return arr.copy()
    return np.repeat(np.repeat(arr, k, axis=0), k, axis=1)


def _make_labels() -> np.ndarray:
    h, w = random.choice(PROTO_SHAPES)

    counts = {1: 1, 2: 1, 3: 1}
    if h > 3:
        counts[random.choice([1, 2, 3])] += h - 3
    roles = []
    for role in random.sample([1, 2, 3], 3):
        roles.extend([role] * counts[role])

    weights_by_role = {
        1: ANCHOR_ROW_WEIGHTS,
        2: VARIABLE_ROW_WEIGHTS,
        3: VARIABLE_ROW_WEIGHTS,
    }
    masks = []
    for role in roles:
        entries = weights_by_role[role]
        kinds, wts = zip(*entries)
        chosen_kind = random.choices(kinds, weights=wts)[0]
        masks.append(_row_mask(chosen_kind, w))

    if not any(mask[0] or mask[-1] for mask in masks):
        i = random.randrange(h)
        if roles[i] == 1 and random.random() < OUTER_FIXUP_PROB:
            masks[i] = _row_mask("outer", w)
        else:
            masks[i] = _row_mask("full", w)

    if all(all(mask) for mask in masks):
        masks[random.randrange(h)] = _row_mask("center", w)

    labels = np.zeros((h, w), dtype=int)
    for r, (role, mask) in enumerate(zip(roles, masks)):
        for c, bit in enumerate(mask):
            if bit:
                labels[r, c] = role
    return labels


def _make_prototypes(bg: int) -> tuple[np.ndarray, np.ndarray]:
    labels = _make_labels()
    pool = [c for c in range(10) if c not in (bg, 1)]
    a_cols = random.sample(pool, 2)
    remaining = [c for c in pool if c not in a_cols]
    if random.random() < COLOR_SHARE_PROB:
        b_cols = [random.choice(a_cols), random.choice(remaining)]
        random.shuffle(b_cols)
    else:
        b_cols = random.sample(remaining, 2)

    def _colorize(lab: np.ndarray, cols: list[int]) -> np.ndarray:
        proto = np.full(lab.shape, bg, dtype=int)
        proto[lab == 1] = 1
        proto[lab == 2] = cols[0]
        proto[lab == 3] = cols[1]
        return proto

    return _colorize(labels, a_cols), _colorize(np.flipud(labels), b_cols)


def _gen_attempt() -> np.ndarray | None:
    bg = random.choice(BG_CHOICES)
    proto_a, proto_b = _make_prototypes(bg)
    protos = [proto_a, proto_b]

    count = random.choice(SPRITE_COUNTS)
    big_scale = random.choice(BIG_SCALES)
    instances = [(0, 1), (1, 1), (random.randrange(2), big_scale)]
    if count == 4:
        instances.append((random.randrange(2), 1))

    records = []
    for out_type, scale in instances:
        target_patch = _scale(protos[out_type], scale)
        source_patch = _scale(protos[1 - out_type], scale)
        output_patch, source_pos = _compose_swapped_patch(source_patch, target_patch, bg)
        records.append(
            {
                "source_patch": source_patch,
                "output_patch": output_patch,
                "source_pos": source_pos,
                "size_key": max(output_patch.shape),
            }
        )
    random.shuffle(records)
    records.sort(key=lambda item: item["size_key"], reverse=True)

    max_dim = max(max(rec["output_patch"].shape) for rec in records)
    n = random.randint(max(GRID_SIZE_MIN, max_dim + GRID_MARGIN_FOR_SPRITES), GRID_SIZE_MAX)
    out = np.full((n, n), bg, dtype=int)
    inp = np.full((n, n), bg, dtype=int)
    reserve = np.full((n, n), bg, dtype=int)

    for rec in records:
        marker = np.full(rec["output_patch"].shape, 1, dtype=int)
        try:
            ur, uc = random_free_location(
                reserve,
                marker,
                transparent=bg,
                border=PLACEMENT_BORDER,
                padding=PLACEMENT_PADDING,
                padding_connectivity=PLACEMENT_CONNECTIVITY,
            )
        except ValueError:
            return None

        paste(reserve, marker, ur, uc)
        paste(out, rec["output_patch"], ur, uc, transparent=bg)
        src_r, src_c = rec["source_pos"]
        paste(inp, rec["source_patch"], ur + src_r, uc + src_c, transparent=bg)

    try:
        if np.array_equal(main(inp), out):
            return inp
    except Exception:
        return None
    return None


def generate_input() -> np.ndarray:
    for _ in range(MAX_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid c7f57c3e D14 input")

