+
+# --------------- generator (output-first hollow-frame role swap) ---------------
+
+# --- CFG: canvas ---
+GRID_SIZE_MIN = 21
+GRID_SIZE_MAX = 28
+GRID_MARGIN_FOR_SPRITES = 6
