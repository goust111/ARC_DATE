+    a_idx = flags.index(True)
+    return [proto_infos[a_idx], proto_infos[1 - a_idx]]
+
+
+def _scaled_overlap_score(sprite_roles: np.ndarray, proto_roles: np.ndarray, scale: int) -> int:
+    scaled = _scale_nn(proto_roles, scale)
