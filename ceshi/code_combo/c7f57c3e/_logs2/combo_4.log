+
+def _place_patch_aligned(
+    out: np.ndarray,
+    patch: np.ndarray,
+    bbox: tuple[int, int, int, int],
+    inst_anchor: tuple[int, int, int, int],
+    proto_anchor: tuple[int, int, int, int],
+    scale: int,
+    bg: int,
+) -> None:
+    h, w = out.shape
+    r0, c0, _r1, _c1 = bbox
+    ar0, ac0, _ar1, _ac1 = inst_anchor
