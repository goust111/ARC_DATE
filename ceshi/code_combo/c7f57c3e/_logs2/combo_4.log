+    base_anc_w = base_anchor[3] - base_anchor[1] + 1
+    other_anchor = families[1]["anchor_bbox"]
+    assert other_anchor[2] - other_anchor[0] + 1 == base_anc_h
+    assert other_anchor[3] - other_anchor[1] + 1 == base_anc_w
