+
+def _role_centroid(labels: np.ndarray, role: int) -> tuple[float, float]:
+    ys, xs = np.where(labels == role)
+    assert ys.size > 0, f"role {role} must be present"
+    return float(np.mean(ys)), float(np.mean(xs))
