   471	        (0, 2): round2_proto,
   472	        (1, 0): donor_proto,
   473	    }
   474	    instances = _build_instances()
   475	
   476	    max_dim = max(max(output_protos[(family, stage)].shape) * scale for family, scale, stage in instances)
   477	    n = random.randint(max(GRID_SIZE_MIN, max_dim + GRID_MARGIN_FOR_SPRITES), GRID_SIZE_MAX)
   478	    inp = np.full((n, n), bg, dtype=int)
   479	    out = np.full((n, n), bg, dtype=int)
   480	    reserve = np.full((n, n), bg, dtype=int)
   481	
   482	    for family, scale, stage in instances:
   483	        input_patch = _scale(raw_protos[family], scale)
   484	        output_patch = _scale(output_protos[(family, stage)], scale)
   485	        dr, dc, uh, uw = _union_bbox(output_patch, input_patch)
   486	        marker = np.full((uh, uw), 1, dtype=int)
   487	        try:
   488	            ur, uc = random_free_location(
   489	                reserve,
   490	                marker,
   491	                transparent=bg,
   492	                border=PLACEMENT_BORDER,
   493	                padding=PLACEMENT_PADDING,
   494	                padding_connectivity=PLACEMENT_CONNECTIVITY,
   495	            )
   496	        except ValueError:
