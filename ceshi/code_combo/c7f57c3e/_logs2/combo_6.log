   502	        in_c = out_c + dc
   503	
   504	        paste(reserve, marker, ur, uc)
   505	        paste(inp, input_patch, in_r, in_c, transparent=bg)
   506	        paste(out, output_patch, out_r, out_c, transparent=bg)
   507	
   508	    try:
   509	        if np.array_equal(main(inp), out):
   510	            return inp
   511	    except Exception:
   512	        return None
   513	    return None
