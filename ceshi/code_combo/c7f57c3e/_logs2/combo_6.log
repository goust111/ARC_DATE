   140	def _infer_scale(
   141	    arr: np.ndarray,
   142	    base_anchor_h: int,
   143	    base_anchor_w: int,
   144	    bg: int,
   145	) -> tuple[int, tuple[int, int, int, int]]:
   146	    anc = _pick_anchor_bbox(arr, bg)
