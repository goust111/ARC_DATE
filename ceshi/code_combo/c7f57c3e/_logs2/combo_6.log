    99	def _direction_key(arr: np.ndarray, bg: int) -> tuple[int, int, int]:
   100	    ar0, ac0, ar1, ac1 = _pick_anchor_bbox(arr, bg)
   101	    non_bg = arr != bg
   102	    above = int(np.sum(non_bg[:ar0, :]))
