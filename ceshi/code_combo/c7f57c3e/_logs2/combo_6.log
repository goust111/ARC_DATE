+    for sprite in sprites:
+        scale, anc = _infer_scale(sprite["arr"], receiver_anchor_h, receiver_anchor_w, bg)
+        family_idx = _match_prototype(g, sprite["bbox"], raw_protos, scale, anc, bg)
