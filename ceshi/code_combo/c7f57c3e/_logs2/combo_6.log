+    in_anchor = _anchor_bbox(patch_b)
+    dr = out_anchor[0] - in_anchor[0]
+    dc = out_anchor[1] - in_anchor[1]
+    h, w = patch_a.shape
+    return dr, dc, h + abs(dr), w + abs(dc)
