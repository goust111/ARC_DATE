+    br0, _bc0, br1, _bc1 = _anchor_bbox(flipped)
+    if ar0 + ar1 == br0 + br1:
+        return False
+    if _role_centroid(labels, 2) == _role_centroid(labels, 3):
+        return False
+    if _role_centroid(flipped, 2) == _role_centroid(flipped, 3):
+        return False
+    return True
+
+
+def _make_labels() -> np.ndarray:
