   459	def _gen_attempt() -> np.ndarray | None:
   460	    bg = random.choice(BG_CHOICES)
   461	    receiver_proto, donor_proto = _make_prototypes(bg)
   462	    round1_proto = _make_receiver_round(receiver_proto, donor_proto, bg, rounds=1)
   463	    round2_proto = _make_receiver_round(receiver_proto, donor_proto, bg, rounds=2)
   464	
   465	    assert not np.array_equal(receiver_proto, round1_proto), "round-1 state must be visible"
   466	    assert not np.array_equal(round1_proto, round2_proto), "round-2 state must add visible change"
