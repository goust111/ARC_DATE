+def _transform_labels(arr: np.ndarray, transform: str) -> np.ndarray:
+    if transform == "id":
+        return arr.copy()
+    if transform == "flipud":
+        return np.flipud(arr).copy()
+    if transform == "fliplr":
+        return np.fliplr(arr).copy()
