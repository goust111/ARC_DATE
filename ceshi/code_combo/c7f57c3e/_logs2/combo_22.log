    64	import numpy as np
    65	
    66	ROOT = None
    67	for _parent in Path(__file__).resolve().parents:
    68	    if (_parent / "solvers" / "arc_utils.py").exists():
    69	        ROOT = _parent
    70	        break
    71	assert ROOT is not None, "could not locate project root containing solvers/arc_utils.py"
    72	SOLVER_DIR = ROOT / "solvers"
    73	if str(SOLVER_DIR) not in sys.path:
    74	    sys.path.append(str(SOLVER_DIR))
    75	
    76	from arc_utils import bbox_coords, components_mask, get_bg, label_mask, paste, random_free_location
    77	
    78	
    79	HOLE_CONNECTIVITY = 4
    80	
    81	
    82	def _scale_nn(arr: np.ndarray, scale: int) -> np.ndarray:
    83	    if scale <= 1:
    84	        return arr.copy()
    85	    return np.repeat(np.repeat(arr, scale, axis=0), scale, axis=1)
    86	
    87	
    88	def _count_enclosed_holes(arr: np.ndarray, bg: int) -> int:
    89	    hole_mask = arr == bg
    90	    lab, n = label_mask(hole_mask, connectivity=HOLE_CONNECTIVITY)
    91	    h, w = arr.shape
    92	    count = 0
    93	    for k in range(1, n + 1):
    94	        pts = np.argwhere(lab == k)
    95	        if np.any(pts[:, 0] == 0) or np.any(pts[:, 0] == h - 1) or np.any(pts[:, 1] == 0) or np.any(pts[:, 1] == w - 1):
    96	            continue
    97	        count += 1
    98	    return int(count)
    99	
   100	
   101	def _frame_fill_colors(arr: np.ndarray, bg: int) -> tuple[int, int]:
   102	    colors = [int(v) for v in np.unique(arr) if v not in (bg, 1)]
   103	    assert len(colors) == 2, "each frame sprite must have exactly two variable colors"
   104	
   105	    border_vals = set(map(int, arr[0, :].tolist() + arr[-1, :].tolist() + arr[:, 0].tolist() + arr[:, -1].tolist()))
   106	    frame_candidates = [c for c in colors if c in border_vals]
   107	    assert len(frame_candidates) == 1, "exactly one variable color must touch the bbox boundary"
   108	
   109	    frame = int(frame_candidates[0])
   110	    fill = int(colors[0] if colors[1] == frame else colors[1])
   111	    return frame, fill
   112	
   113	
   114	def _canonicalize_frame(arr: np.ndarray, bg: int) -> np.ndarray:
   115	    frame, fill = _frame_fill_colors(arr, bg)
   116	    out = np.zeros(arr.shape, dtype=int)
   117	    out[arr == 1] = 1
   118	    out[arr == frame] = 2
   119	    out[arr == fill] = 3
   120	    return out
   121	
   122	
   123	def _paint_from_canonical(labels: np.ndarray, bg: int, palette: tuple[int, int]) -> np.ndarray:
   124	    out = np.full(labels.shape, bg, dtype=int)
   125	    out[labels == 1] = 1
   126	    out[labels == 2] = int(palette[0])
   127	    out[labels == 3] = int(palette[1])
   128	    return out
   129	
   130	
   131	def _filled_silhouette(arr: np.ndarray, bg: int) -> np.ndarray:
   132	    filled = (arr != bg).copy()
   133	    hole_mask = arr == bg
   134	    lab, n = label_mask(hole_mask, connectivity=HOLE_CONNECTIVITY)
   135	    h, w = arr.shape
   136	    for k in range(1, n + 1):
   137	        pts = np.argwhere(lab == k)
   138	        if np.any(pts[:, 0] == 0) or np.any(pts[:, 0] == h - 1) or np.any(pts[:, 1] == 0) or np.any(pts[:, 1] == w - 1):
   139	            continue
   140	        filled[lab == k] = True
   141	    return filled.astype(int)
   142	
   143	
   144	def _shape_key(arr: np.ndarray, bg: int) -> tuple[int, ...]:
   145	    return tuple(_filled_silhouette(arr, bg).ravel().tolist())
   146	
   147	
   148	def _extract_sprites(grid: np.ndarray, bg: int) -> list[dict[str, object]]:
   149	    comps = components_mask(grid != bg, connectivity=8)
   150	    sprites: list[dict[str, object]] = []
   151	    for pts in comps:
   152	        r0, c0, r1, c1 = bbox_coords(pts)
   153	        arr = grid[r0 : r1 + 1, c0 : c1 + 1].copy()
   154	        sprites.append({"pts": pts, "bbox": (r0, c0, r1, c1), "arr": arr})
   155	    return sprites
   156	
   157	
   158	def main(grid: np.ndarray) -> np.ndarray:
   159	    """
   160	    Repaint each hollow-frame sprite with the opposite shape group's palette, matched by hole count.
   161	
   162	    Input structure:
   163	    - bg is the most common color. Every non-bg component is a connected hollow-frame sprite with a color-1 anchor spine, one frame color, one fill color, and either one or two enclosed bg holes.
   164	    - The smallest sprites expose four base templates: two outer-silhouette families, each appearing once with 1 hole and once with 2 holes. Larger sprites are scaled copies of those templates.
   165	
   166	    Rule:
   167	    - Recover the four base templates from the smallest sprites, then group them by filled outer silhouette rather than by literal colors.
   168	    - For each sprite, infer its shape family from that silhouette and count its enclosed holes from the original hollow structure.
   169	    - Keep the sprite's own canonical frame layout fixed, but repaint its frame/fill roles with the palette taken from the other shape family at the same hole count.
   170	
   171	    Key insight: the swap no longer changes the object's outline; shape only tells you which opposite family to consult, while the visible hole count selects which palette inside that family should be borrowed.
   172	    """
   173	    g = np.asarray(grid, dtype=int)
   174	    bg = get_bg(g)
   175	
   176	    sprites = _extract_sprites(g, bg)
   177	    assert len(sprites) >= 5, "grid must contain 4 base hollow frames plus at least one extra sprite"
   178	
   179	    areas = [int((s["bbox"][2] - s["bbox"][0] + 1) * (s["bbox"][3] - s["bbox"][1] + 1)) for s in sprites]
   180	    min_area = min(areas)
   181	    base = [s for s, a in zip(sprites, areas, strict=False) if a == min_area]
   182	
   183	    uniq: dict[tuple[int, ...], dict[str, object]] = {}
   184	    for s in base:
   185	        arr = np.asarray(s["arr"], dtype=int)
   186	        canon = _canonicalize_frame(arr, bg)
   187	        key = tuple(canon.ravel().tolist())
   188	        if key not in uniq:
   189	            uniq[key] = {
   190	                "canon": canon,
   191	                "palette": _frame_fill_colors(arr, bg),
   192	                "shape_key": _shape_key(arr, bg),
   193	                "shape_mask": _filled_silhouette(arr, bg),
   194	                "holes": _count_enclosed_holes(arr, bg),
   195	            }
   196	    assert len(uniq) == 4, "smallest-area sprites must yield exactly 4 distinct base hollow frames"
   197	
   198	    protos = list(uniq.values())
   199	    base_h, base_w = protos[0]["canon"].shape
   200	    for proto in protos[1:]:
   201	        assert proto["canon"].shape == (base_h, base_w), "all base templates must share one bbox size"
   202	
   203	    family_groups: dict[tuple[int, ...], dict[int, dict[str, object]]] = {}
   204	    for proto in protos:
   205	        hole_count = int(proto["holes"])
   206	        group = family_groups.setdefault(proto["shape_key"], {})
   207	        assert hole_count not in group, "each shape family should expose one prototype per hole count"
   208	        group[hole_count] = proto
   209	
   210	    assert len(family_groups) == 2, "base prototypes must form exactly 2 outer-silhouette families"
   211	    families = list(family_groups.values())
   212	    for family in families:
   213	        assert set(family.keys()) == {1, 2}, "each shape family must provide both 1-hole and 2-hole variants"
   214	
   215	    out = g.copy()
   216	
   217	    for s in sprites:
   218	        r0, c0, r1, c1 = s["bbox"]
   219	        arr = np.asarray(s["arr"], dtype=int)
   220	        h = int(r1 - r0 + 1)
   221	        w = int(c1 - c0 + 1)
   222	        assert h % base_h == 0 and w % base_w == 0, "sprite bbox must be an integer scale of the base template"
   223	        scale_h = h // base_h
   224	        scale_w = w // base_w
   225	        assert scale_h == scale_w, "scaling must be isotropic"
   226	        scale = int(scale_h)
   227	
   228	        filled_arr = _filled_silhouette(arr, bg)
   229	        family_idx = None
   230	        best_score = -1
   231	        for idx, family in enumerate(families):
   232	            ref_shape = next(iter(family.values()))["shape_mask"]
   233	            scaled_shape = _scale_nn(np.asarray(ref_shape, dtype=int), scale)
   234	            if scaled_shape.shape != filled_arr.shape:
   235	                continue
   236	            score = int(np.sum(scaled_shape == filled_arr))
   237	            if np.array_equal(scaled_shape, filled_arr):
   238	                score += int(filled_arr.size * 10)
   239	            if score > best_score:
   240	                best_score = score
   241	                family_idx = idx
   242	        assert family_idx is not None, "could not identify the sprite's shape family"
   243	
   244	        holes = _count_enclosed_holes(arr, bg)
   245	        assert holes in (1, 2), "every sprite must have 1 or 2 enclosed holes"
   246	
   247	        target_family = families[1 - family_idx]
   248	        assert holes in target_family, "opposite family must contain the same hole-count palette"
   249	        target_palette = tuple(target_family[holes]["palette"])
   250	
   251	        canon_arr = _canonicalize_frame(arr, bg)
   252	        replacement = _paint_from_canonical(canon_arr, bg, target_palette)
   253	
   254	        for rr, cc in s["pts"]:
   255	            out[rr, cc] = bg
   256	        paste(out, replacement, r0, c0, transparent=bg)
   257	
   258	    return out
   259	
