+# --------------- generator (shape-grouped hollow-frame palette swap) ---------------
+
+# --- CFG: canvas ---
+GRID_SIZE_MIN = 26
+GRID_SIZE_MAX = 36
+GRID_MARGIN_FOR_SPRITES = 8
