+GRID_SIZE_MAX = 30
+GRID_MARGIN_FOR_SPRITES = 8
+
+BG_CHOICES = [0, 2, 3, 4, 5, 6, 7, 8, 9]
+
+SPRITE_COUNTS = [3, 4]
+BIG_SCALES = [2]
+
+PLACEMENT_BORDER = 1
+PLACEMENT_PADDING = 2
+PLACEMENT_CONNECTIVITY = 8
+
+MAX_RETRIES = 400
