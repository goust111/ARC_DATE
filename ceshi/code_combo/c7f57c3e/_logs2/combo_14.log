+def _make_label_proto(orientation: str) -> np.ndarray:
+    labels = np.zeros(_FOOTPRINT.shape, dtype=int)
+    for r in range(_FOOTPRINT.shape[0]):
+        for c in range(_FOOTPRINT.shape[1]):
+            if not _FOOTPRINT[r, c]:
