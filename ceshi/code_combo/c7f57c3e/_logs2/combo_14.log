+    a_primary, a_secondary, b_primary, b_secondary = random.sample(pool, 4)
+    proto_a = _colorize(labels_a, bg, a_primary, a_secondary)
+    proto_b = _colorize(labels_b, bg, b_primary, b_secondary)
+    return proto_a, proto_b
+
