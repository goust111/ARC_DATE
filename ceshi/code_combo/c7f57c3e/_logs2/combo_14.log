+        arr = sprite["arr"]
+        ar0, ac0, _ar1, _ac1 = _pick_anchor_bbox(arr)
+        scale = _infer_scale(arr, base_anchor_bbox)
+        src_idx = _match_sprite(g, sprite, prototypes, bg, scale)
+        dst_idx = 1 - src_idx
