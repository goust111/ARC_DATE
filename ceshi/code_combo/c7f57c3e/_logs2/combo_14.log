+    best_score = -1
+    for idx, proto in enumerate(prototypes):
+        scaled = _scale_nn(proto, scale)
+        pr0, pc0, _pr1, _pc1 = _pick_anchor_bbox(proto)
+        pr0 *= scale
+        pc0 *= scale
