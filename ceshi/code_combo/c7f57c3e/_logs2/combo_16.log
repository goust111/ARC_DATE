    17	#      例如左列上下两个区域分别放 A、B, 则输出中上格变成 B、下格变成 A; 如果右列上下都放 A,
    18	#      则这一整列在输出里保持 A。也就是说, 控制变量不再是“这个精灵当前是什么颜色模式”,
    19	#      而是“它位于分隔线哪一侧, 它同列另一侧的伙伴是什么原型”。
    20	# b) 复杂度校准:
    21	#    - 仍然只保留 2 种原型、4 个精灵、1 个放大尺度, 自由度受控。
    22	#    - 每个样例强制一列为 mixed pair、另一列为 same-type pair, 这样新规则会稳定地产生
    23	#      “两格变化、两格不变”的重复证据, 不会退化成原题的“全都翻转”。
    24	# c) 隐式假设审查:
    25	#    - 原 solver 假设所有非背景连通块都参与交换; 现在分隔线是额外连通块, 必须先识别并剔除。
    26	#    - 原 solver 的 `1 - best_idx` 依赖逐精灵切换; 现在替换目标来自同列对侧精灵的 proto_idx。
    27	#    - 行列分组不再依赖颜色或排序缝隙推断, 而是依赖显式横线/竖线, 所以 generator 必须保证
    28	#      每个象限只有一个精灵, 且精灵与分隔线之间留空隙。
    29	# d) 放置合法性:
    30	#    - 每个象限预留的是“输入 patch 与输出 patch 按锚点对齐后的并集框”, 因此无论交换后变成哪种
    31	#      原型, 都不会越界或跨过分隔线。
    32	#    - 四个象限彼此独立, 分隔线厚度固定为 1, 精灵不接触边框和分隔线, 因而无重叠风险。
    33	# e) 视觉可观察性:
    34	#    - 分隔线是肉眼可见的物理分组线索, 上下交换发生在同一列内部, 不是按颜色值做隐藏排序。
    35	#    - 观察者从 2-3 个样例可看到: 同列上下是配对单位, 而另一列若上下原型相同则整列不变。
    36	# f) 可视化整洁度:
    37	#    - 只使用一个十字分隔结构, 不叠加额外标记。每个象限单独容纳一个精灵, 版面规则且清晰。
    38	# g) 变化的可推断性:
    39	#    - 颜色变化仍来自两种重复出现的原型, 不是任意颜色映射。空间分区与是否变化同步出现,
    40	#      因此人类可以从“位置组 + 同列配对”归纳规则。
    41	# h) main() 的新假设与 generator 保证:
    42	#    - main() 假设存在同色的全宽横线与全高竖线; generator 固定绘制一个十字分隔。
    43	#    - main() 假设四个象限各一个精灵, 且最小尺度精灵里能恢复两种原型; generator 固定四象限布局,
    44	#      并让 mixed pair 保持 scale=1, 把唯一的大精灵放在 same-type 列中。
    45	
    46	
    47	def _pick_anchor_bbox(arr: np.ndarray, bg: int) -> tuple[int, int, int, int]:
    48	    """Bounding box of color-1 pixels; color 1 is guaranteed to exist."""
    49	    if np.any(arr == 1):
    50	        ys, xs = np.where(arr == 1)
    51	        return int(ys.min()), int(xs.min()), int(ys.max()), int(xs.max())
    52	    assert False, "sprite array has no color-1 pixels"
    53	
    54	
    55	def _scale_nn(arr: np.ndarray, scale: int) -> np.ndarray:
    56	    if scale <= 1:
    57	        return arr.copy()
    58	    return np.repeat(np.repeat(arr, scale, axis=0), scale, axis=1)
    59	
    60	
    61	def _match_proto_index(
    62	    grid: np.ndarray,
    63	    arr: np.ndarray,
    64	    bbox: tuple[int, int, int, int],
    65	    protos: list[np.ndarray],
    66	    scale: int,
    67	    bg: int,
    68	) -> int:
    69	    """Return the prototype index whose scaled patch best matches this sprite."""
    70	    h, w = grid.shape
    71	    r0, c0, _r1, _c1 = bbox
    72	    ar0, ac0, _ar1, _ac1 = _pick_anchor_bbox(arr, bg)
    73	
    74	    best_idx = 0
    75	    best_score = -1
    76	    for idx, proto in enumerate(protos):
    77	        sp = _scale_nn(proto, scale)
    78	        pr0, pc0, _pr1, _pc1 = _pick_anchor_bbox(proto, bg)
    79	        top = int(r0 + ar0 - pr0 * scale)
    80	        left = int(c0 + ac0 - pc0 * scale)
    81	
    82	        ph, pw = sp.shape
    83	        rr0 = max(0, top)
    84	        cc0 = max(0, left)
    85	        rr1 = min(h, top + ph)
    86	        cc1 = min(w, left + pw)
    87	        if rr0 >= rr1 or cc0 >= cc1:
    88	            continue
    89	
    90	        sub_g = grid[rr0:rr1, cc0:cc1]
    91	        sub_p = sp[(rr0 - top) : (rr1 - top), (cc0 - left) : (cc1 - left)]
    92	        m = sub_p != bg
    93	        score = int(np.sum(sub_g[m] == sub_p[m])) if np.any(m) else 0
    94	        if score > best_score:
    95	            best_score = score
    96	            best_idx = idx
    97	    return best_idx
    98	
    99	
   100	def _place_scaled_proto(
   101	    out: np.ndarray,
   102	    proto: np.ndarray,
   103	    scale: int,
   104	    anchor_rc: tuple[int, int],
   105	    bg: int,
   106	) -> None:
   107	    """Paste a scaled prototype so its anchor top-left lands on `anchor_rc`."""
   108	    sp = _scale_nn(proto, scale)
   109	    pr0, pc0, _pr1, _pc1 = _pick_anchor_bbox(proto, bg)
   110	    top = int(anchor_rc[0] - pr0 * scale)
   111	    left = int(anchor_rc[1] - pc0 * scale)
   112	    paste(out, sp, top, left, transparent=bg)
   113	
   114	
   115	def _detect_separator_cross(grid: np.ndarray, bg: int) -> tuple[int, list[int], list[int]]:
   116	    """Detect the non-bg cross that partitions the four sprite regions."""
   117	    h, w = grid.shape
   118	    row_candidates = [r for r in range(h) if int(grid[r, 0]) != bg and np.all(grid[r, :] == grid[r, 0])]
   119	    col_candidates = [c for c in range(w) if int(grid[0, c]) != bg and np.all(grid[:, c] == grid[0, c])]
   120	    assert row_candidates and col_candidates, "missing separator cross"
   121	
   122	    colors = set(int(grid[r, 0]) for r in row_candidates) & set(int(grid[0, c]) for c in col_candidates)
   123	    assert colors, "separator row/col colors must agree"
   124	
   125	    best = None
   126	    for color in colors:
   127	        rows = [r for r in row_candidates if int(grid[r, 0]) == color]
   128	        cols = [c for c in col_candidates if int(grid[0, c]) == color]
   129	        score = len(rows) + len(cols)
   130	        if best is None or score > best[0]:
   131	            best = (score, color, rows, cols)
   132	
   133	    assert best is not None
   134	    _score, sep_color, row_lines, col_lines = best
   135	    return int(sep_color), sorted(row_lines), sorted(col_lines)
   136	
   137	
   138	def _aligned_union_bbox(output_patch: np.ndarray, input_patch: np.ndarray) -> tuple[int, int, int, int]:
   139	    """Union box for two anchor-aligned patches; returns (dr, dc, union_h, union_w)."""
   140	    oa = _pick_anchor_bbox(output_patch, -1)
   141	    ia = _pick_anchor_bbox(input_patch, -1)
   142	    dr = oa[0] - ia[0]
   143	    dc = oa[1] - ia[1]
   144	
   145	    top = min(0, dr)
   146	    left = min(0, dc)
   147	    bottom = max(output_patch.shape[0], dr + input_patch.shape[0])
   148	    right = max(output_patch.shape[1], dc + input_patch.shape[1])
   149	    return int(dr), int(dc), int(bottom - top), int(right - left)
   150	
   151	
   152	def main(grid: np.ndarray) -> np.ndarray:
   153	    """
   154	    Exchange prototype identity across the separator-defined upper/lower regions of each column.
   155	
   156	    Input structure:
   157	    - bg is the most common color. A single non-bg cross (one horizontal line and one vertical
   158	      line of the same color) partitions the canvas into four clean regions.
   159	    - Each region contains one disconnected sprite, and the four sprites are scaled copies of
   160	      exactly two prototype patterns that all contain color 1 as an anchor subshape.
   161	
   162	    Rule:
   163	    - Ignore the separator cross when extracting sprites, recover the two prototypes from the
   164	      smallest sprites, and infer every sprite's scale and current prototype identity.
   165	    - Group sprites by which side of the cross they occupy, yielding four quadrant slots.
   166	    - Within each column, swap prototype identity between the upper sprite and the lower sprite,
   167	      while keeping each slot's own scale, anchor position, and the separator cross unchanged.
   168	
   169	    Key insight:
   170	    - The cross is not decoration: it is the visible statement of the grouping rule. A sprite
   171	      does not flip just because of its own colors; it copies the prototype used in the region
   172	      directly above or below it across the same vertical partition.
   173	    """
   174	    g = np.asarray(grid, dtype=int)
   175	    bg = get_bg(g)
   176	    sep_color, row_lines, col_lines = _detect_separator_cross(g, bg)
   177	
   178	    sprite_mask = g != bg
   179	    sprite_mask[row_lines, :] = False
   180	    sprite_mask[:, col_lines] = False
   181	    comps = components_mask(sprite_mask, connectivity=8)
   182	    assert len(comps) == 4, "grid must contain exactly 4 sprite components outside the separators"
   183	
   184	    sprites = []
   185	    for pts in comps:
   186	        r0, c0, r1, c1 = bbox_coords(pts)
   187	        arr = g[r0 : r1 + 1, c0 : c1 + 1].copy()
   188	        sprites.append({"pts": pts, "bbox": (r0, c0, r1, c1), "arr": arr})
   189	
   190	    areas = [int((s["bbox"][2] - s["bbox"][0] + 1) * (s["bbox"][3] - s["bbox"][1] + 1)) for s in sprites]
   191	    min_area = min(areas)
   192	    base = [s for s, a in zip(sprites, areas, strict=False) if a == min_area]
   193	    uniq: dict[tuple[int, ...], np.ndarray] = {}
   194	    for s in base:
   195	        key = tuple(s["arr"].ravel().tolist())
   196	        if key not in uniq:
   197	            uniq[key] = s["arr"]
   198	    assert len(uniq) == 2, "smallest sprites must expose both prototype patterns"
   199	
   200	    protos = list(uniq.values())[:2]
   201	    anc0 = _pick_anchor_bbox(protos[0], bg)
   202	    anc1 = _pick_anchor_bbox(protos[1], bg)
   203	    base_anc_h = anc0[2] - anc0[0] + 1
   204	    base_anc_w = anc0[3] - anc0[1] + 1
   205	    assert (anc1[2] - anc1[0] + 1, anc1[3] - anc1[1] + 1) == (base_anc_h, base_anc_w)
   206	
   207	    top_limit = min(row_lines)
   208	    bottom_limit = max(row_lines)
   209	    left_limit = min(col_lines)
   210	    right_limit = max(col_lines)
   211	
   212	    quadrants: dict[tuple[int, int], dict[str, object]] = {}
   213	    for s in sprites:
   214	        r0, c0, r1, c1 = s["bbox"]
   215	        ar0, ac0, ar1, ac1 = _pick_anchor_bbox(s["arr"], bg)
   216	        inst_anc_h = ar1 - ar0 + 1
   217	        inst_anc_w = ac1 - ac0 + 1
   218	        scale_h = max(1, inst_anc_h // max(1, base_anc_h))
   219	        scale_w = max(1, inst_anc_w // max(1, base_anc_w))
   220	        scale = int(max(scale_h, scale_w))
   221	        center_r = (r0 + r1) / 2.0
   222	        center_c = (c0 + c1) / 2.0
   223	
   224	        if center_r < top_limit:
   225	            row_group = 0
   226	        else:
   227	            assert center_r > bottom_limit, "sprite may not overlap the horizontal separator"
   228	            row_group = 1
   229	        if center_c < left_limit:
   230	            col_group = 0
   231	        else:
   232	            assert center_c > right_limit, "sprite may not overlap the vertical separator"
   233	            col_group = 1
   234	
   235	        key = (row_group, col_group)
   236	        assert key not in quadrants, "each quadrant must contain exactly one sprite"
   237	        s["scale"] = scale
   238	        s["anchor_rc"] = (int(r0 + ar0), int(c0 + ac0))
   239	        s["proto_idx"] = _match_proto_index(g, s["arr"], s["bbox"], protos, scale, bg)
   240	        quadrants[key] = s
   241	
   242	    assert set(quadrants) == {(0, 0), (0, 1), (1, 0), (1, 1)}
   243	
   244	    out = np.full_like(g, bg)
   245	    out[row_lines, :] = sep_color
   246	    out[:, col_lines] = sep_color
   247	    for col in range(2):
   248	        top_sprite = quadrants[(0, col)]
   249	        bottom_sprite = quadrants[(1, col)]
   250	        _place_scaled_proto(out, protos[int(bottom_sprite["proto_idx"])], int(top_sprite["scale"]), top_sprite["anchor_rc"], bg)
   251	        _place_scaled_proto(out, protos[int(top_sprite["proto_idx"])], int(bottom_sprite["scale"]), bottom_sprite["anchor_rc"], bg)
   252	
   253	    return out
   254	
   255	
   256	# --------------- generator ---------------
   257	
   258	# --- CFG: canvas ---
   259	GRID_SIZE_MIN = 22
   260	GRID_SIZE_MAX = 28
   261	PLACEMENT_BORDER = 1
   262	REGION_MARGIN = 1
   263	REGION_EXTRA_MAX = 2
   264	MAX_RETRIES = 300
   265	
   266	# --- CFG: prototypes ---
   267	PROTO_SHAPES = [(4, 3), (3, 4), (4, 4)]
   268	BG_CHOICES = [0, 2, 3, 4, 5, 6, 7, 8, 9]
   269	COLOR_SHARE_PROB = 0.65
   270	
   271	# --- CFG: row-mask weights (anchor role vs variable role) ---
   272	ANCHOR_ROW_WEIGHTS = [("center", 0.45), ("outer", 0.35), ("full", 0.20)]
   273	VARIABLE_ROW_WEIGHTS = [("center", 0.68), ("full", 0.32)]
   274	OUTER_FIXUP_PROB = 0.7
   275	
   276	# --- CFG: sprite instances ---
   277	BIG_SCALES = [2]
   278	
   279	_ROW_MASKS = {
   280	    "center": {3: [0, 1, 0], 4: [0, 1, 1, 0]},
   281	    "outer": {3: [1, 0, 1], 4: [1, 0, 0, 1]},
   282	    "full": {3: [1, 1, 1], 4: [1, 1, 1, 1]},
   283	}
   284	
   285	
   286	def _row_mask(kind: str, w: int) -> list[int]:
   287	    return list(_ROW_MASKS[kind][w])
   288	
   289	
   290	def _make_labels() -> np.ndarray:
   291	    h, w = random.choice(PROTO_SHAPES)
   292	
   293	    counts = {1: 1, 2: 1, 3: 1}
   294	    if h > 3:
   295	        counts[random.choice([1, 2, 3])] += h - 3
   296	
   297	    roles = []
   298	    for role in random.sample([1, 2, 3], 3):
   299	        roles.extend([role] * counts[role])
   300	
   301	    weights_by_role = {
   302	        1: ANCHOR_ROW_WEIGHTS,
   303	        2: VARIABLE_ROW_WEIGHTS,
   304	        3: VARIABLE_ROW_WEIGHTS,
   305	    }
   306	    masks = []
   307	    for role in roles:
   308	        kinds, wts = zip(*weights_by_role[role])
   309	        chosen = random.choices(kinds, weights=wts)[0]
   310	        masks.append(_row_mask(chosen, w))
   311	
   312	    if not any(mask[0] or mask[-1] for mask in masks):
   313	        idx = random.randrange(h)
   314	        if roles[idx] == 1 and random.random() < OUTER_FIXUP_PROB:
   315	            masks[idx] = _row_mask("outer", w)
   316	        else:
   317	            masks[idx] = _row_mask("full", w)
   318	
   319	    if all(all(mask) for mask in masks):
   320	        masks[random.randrange(h)] = _row_mask("center", w)

