+    sprite_mask[row_lines, :] = False
+    sprite_mask[:, col_lines] = False
+    comps = components_mask(sprite_mask, connectivity=8)
+    assert len(comps) == 4, "grid must contain exactly 4 sprite components outside the separators"
+
+    sprites = []
