+
+def _make_input(base: np.ndarray, top: int, water_count: int) -> np.ndarray:
+    inp = np.array(base, dtype=int).copy()
+    remaining = int(water_count)
+    for r in range(8, top - 1, -1):
+        for c in BASIN_COLS[0]:
+            if remaining == 0:
+                break
+            inp[r, c] = 1
+            remaining -= 1
+        if remaining == 0:
+            break
