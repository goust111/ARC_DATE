WIDTHS=(2,2,2)

def build(top, thresholds, level):
    H=W=10
    g=np.zeros((H,W),dtype=int)
    walls=[0,3,6,9]
    g[9,:]=2
    g[top:,0]=2
    g[top:,9]=2
    for c,h,col in zip(walls[1:-1], thresholds, [3,4]):
        g[9-h:10,c]=col
    prefix=1+sum(th < level for th in thresholds)
    water=level*sum(WIDTHS[:prefix])
