+) -> set[tuple[int, int]]:
+    filled: set[tuple[int, int]] = set()
+    top_row = H - 1 - level
+    for cols in basin_cols[:prefix]:
+        for r in range(top_row, H - 1):
+            for c in cols:
+                filled.add((int(r), int(c)))
+    return filled
+
+
