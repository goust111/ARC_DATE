+    three_basin_specs = [spec for spec in all_specs if spec[1] == (1, 2) and spec[2] == 3 and spec[0] == 0]
+    two_basin_specs = [spec for spec in all_specs if spec not in three_basin_specs]
+
+    if random.random() < 0.35:
