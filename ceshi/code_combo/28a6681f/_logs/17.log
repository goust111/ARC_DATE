    for r in range(8,top-1,-1):
        for c in (1,2):
            if rem:
                g[r,c]=1; rem-=1
    assert rem==0
    out=g.copy(); out[out==1]=0
    basin_cols=((1,2),(4,5),(7,8))
    for cols in basin_cols[:prefix]:
        for depth in range(1,level+1):
            r=9-depth
            for c in cols: out[r,c]=1
    return g,out,prefix,water

cases=[]
for top in [0,1]:
    for thresholds in [(1,2),(1,3),(1,4),(2,3),(2,4)]:
        for level in [2,3,4]:
            prefix=1+sum(th < level for th in thresholds)
            if prefix<2: continue
            water=level*sum(WIDTHS[:prefix])
            if water>2*(9-top):
