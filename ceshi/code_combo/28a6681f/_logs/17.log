+def _parse_structure(
+    g: np.ndarray, bg: int, water: int, check: bool
+) -> tuple[list[int], list[tuple[int, ...]], list[int], list[int], int]:
+    H, W = g.shape
+    solid = np.logical_and(g != int(bg), g != int(water))
+    if check:
