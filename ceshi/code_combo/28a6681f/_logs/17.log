+        raise AssertionError("left source basin was too small for the sampled water volume")
+    return inp
+
+
+def _candidate_specs() -> list[tuple[int, tuple[int, int], int]]:
+    specs: list[tuple[int, tuple[int, int], int]] = []
+    for top in (0, 1):
