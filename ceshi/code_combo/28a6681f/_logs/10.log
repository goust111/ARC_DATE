   230	    def erode_cells() -> list[tuple[int, int]]:
   231	        if not allow_erosion:
   232	            return []
   233	        cells: list[tuple[int, int]] = []
   234	        for r in range(H - 1):
   235	            for c in range(1, W - 1):
   236	                v = int(g[r, c])
   237	                if v in (BG, WATER):
   238	                    continue
   239	                left = int(g[r, c - 1])
   240	                right = int(g[r, c + 1])
   241	                if left == int(WATER) and right == int(BG):
   242	                    if water_run_depth(int(r), int(c - 1)) >= EROSION_DEPTH:
   243	                        cells.append((int(r), int(c)))
   244	                elif left == int(BG) and right == int(WATER):
   245	                    if water_run_depth(int(r), int(c + 1)) >= EROSION_DEPTH:
   246	                        cells.append((int(r), int(c)))
   247	        return cells
