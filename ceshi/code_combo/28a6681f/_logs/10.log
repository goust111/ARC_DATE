    74	#    - Because accepted samples require transfer into the neighboring basin, the
    75	#      changed geometry has an obvious behavioral consequence; this prevents the task
    76	#      from looking like a pure recolor puzzle.
    77	#
    78	# f) Visual cleanliness:
    79	#    - The generator keeps all changes concentrated around the two basins. There is
    80	#      no overlay on water itself and no scattered annotation elsewhere.
    81	#    - The shelf stays above the deeper target floor, so the missing-wall region and
    82	#      the wet contour do not visually collapse into a noisy mass.
    83	#
    84	# g) Inferability of the change:
    85	#    - Color 5 is not tied to a specific dry color. Any surviving structure pixel can
    86	#      become wet if and only if final water touches it orthogonally.
    87	#    - Erosion is not keyed by color either; it depends only on a visible geometric
    88	#      cue: a two-cell water stack pressing on one side of a thin wall with empty
    89	#      space on the other.
    90	#
    91	# h) Non-degeneration metric used by the generator:
    92	#    - Each accepted sample must remove at least 2 structure pixels, create at least
    93	#      4 wet pixels, wet at least 1 pixel on the divider column itself, and send at
    94	#      least 2 water cells into the formerly empty target basin.
    95	#    - The accepted combo output must also differ from the "wet-only, no-erosion"
    96	#      baseline on the same input. This rules out samples where the fused solver
    97	#      behaves exactly like the recolor-only variant.
    98	#
    99	# i) New solver assumptions checked against the generator:
   100	#    - Wet color 5 never appears in the input.
   101	#    - The divider is one cell thick and bordered by background on the target side
   102	#      before erosion, so the erosion test has a clear "water side / empty side".
   103	#    - The source water column height is at least 3, ensuring the erosion threshold is
   104	#      actually reachable and yields a visible breach instead of a trivial wet-only
   105	#      case.
   106	
   107	
   108	BG = 0
   109	WATER = 1
   110	LEFT_COLOR = 2
   111	MID_COLOR = 3
   112	RIGHT_COLOR = 4
   113	WET = 5
   114	GRID_SIZE = 10
   115	EROSION_DEPTH = 2
   116	
   117	
   118	def _component_count(points: set[tuple[int, int]], use_diagonal: bool) -> int:
   119	    remaining = set(points)
   120	    if use_diagonal:
   121	        neighbors = [(dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if (dr, dc) != (0, 0)]
   122	    else:
   123	        neighbors = [(-1, 0), (1, 0), (0, -1), (0, 1)]
   124	    count = 0
   125	    while remaining:
   126	        count += 1
   127	        stack = [remaining.pop()]
   128	        while stack:
   129	            r, c = stack.pop()
   130	            for dr, dc in neighbors:
   131	                nxt = (int(r + dr), int(c + dc))
   132	                if nxt in remaining:
   133	                    remaining.remove(nxt)
   134	                    stack.append(nxt)
   135	    return count
   136	
   137	
   138	def _simulate(
   139	    grid: np.ndarray,
   140	    *,
   141	    allow_erosion: bool,
   142	    check_input: bool,
   143	    check_output: bool,
   144	) -> np.ndarray:
   145	    g = np.array(grid, dtype=int).copy()
   146	    H, W = g.shape
   147	
   148	    if check_input:
   149	        assert not np.any(g == int(WET)), "wet color is output-only"
   150	        for r, c in np.argwhere(g == int(WATER)):
   151	            rr = int(r)
   152	            cc = int(c)
   153	            assert rr == H - 1 or int(g[rr + 1, cc]) != int(BG), "input water must be supported"
   154	            left_bg = cc > 0 and int(g[rr, cc - 1]) == int(BG)
   155	            right_bg = cc + 1 < W and int(g[rr, cc + 1]) == int(BG)
   156	            assert not (left_bg and right_bg), "input water cannot have bg on both horizontal sides"
   157	
   158	    bottom_colors = set(map(int, g[H - 1]))
   159	    for color in sorted(set(map(int, g[:7].flatten())) - {BG, WATER, WET} - bottom_colors):
   160	        pts = {(int(r), int(c)) for r, c in np.argwhere(g[:7] == int(color))}
   161	        diag_links = sum(1 for r, c in pts if (r + 1, c - 1) in pts or (r + 1, c + 1) in pts)
   162	        if diag_links >= 3:
   163	            assert any(c in (0, W - 1) for _r, c in pts), "guide must enter from a grid edge"
   164	            assert _component_count(pts, False) == _component_count(pts, True), "guide must be 4-connected"
   165	
   166	    def settle(r: int, c: int) -> tuple[int, int]:
   167	        rr = int(r)
   168	        cc = int(c)
   169	        for _ in range(H * W):
   170	            if rr + 1 < H and int(g[rr + 1, cc]) == int(BG):
   171	                rr += 1
   172	                continue
   173	
   174	            opts: list[tuple[int, int]] = []
   175	            if (
   176	                rr + 1 < H
   177	                and cc - 1 >= 0
   178	                and int(g[rr, cc - 1]) == int(BG)
   179	                and int(g[rr + 1, cc - 1]) == int(BG)
   180	            ):
   181	                opts.append((int(rr + 1), int(cc - 1)))
   182	            if (
   183	                rr + 1 < H
   184	                and cc + 1 < W
   185	                and int(g[rr, cc + 1]) == int(BG)
   186	                and int(g[rr + 1, cc + 1]) == int(BG)
   187	            ):
   188	                opts.append((int(rr + 1), int(cc + 1)))
   189	            if opts:
   190	                assert len(opts) == 1, f"ambiguous diagonal moves: {opts}"
   191	                rr, cc = opts[0]
   192	                continue
   193	
   194	            if rr + 1 < H and int(g[rr + 1, cc]) != int(BG):
   195	                left = int(cc)
   196	                while left - 1 >= 0 and int(g[rr, left - 1]) == int(BG):
   197	                    left -= 1
   198	                right = int(cc)
   199	                while right + 1 < W and int(g[rr, right + 1]) == int(BG):
   200	                    right += 1
   201	
   202	                drops = [int(x) for x in range(left, right + 1) if int(g[rr + 1, int(x)]) == int(BG)]
   203	                if not drops:
   204	                    break
   205	
   206	                min_dist = min(abs(int(x - cc)) for x in drops)
   207	                nearest = [int(x) for x in drops if abs(int(x - cc)) == int(min_dist)]
   208	                assert len(nearest) == 1, f"ambiguous nearest drop columns: {nearest}"
   209	                best = nearest[0]
   210	                assert best != int(cc)
   211	                step = -1 if best < int(cc) else 1
   212	                nx = int(cc + step)
   213	                assert int(g[rr, nx]) == int(BG)
   214	                cc = nx
