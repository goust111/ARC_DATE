+        if metrics["bottom_solid_count"] != 0:
+            continue
+
+        return candidate
+
+    if last_error is not None:
+        raise RuntimeError(f"failed to generate fused suspended-BFS sample: {last_error}")
+    raise RuntimeError("failed to generate fused suspended-BFS sample")

