+        for r, c in sources:
+            assert r == h - 1 or int(g[r + 1, c]) != int(BG), "input water must be supported"
+            left_bg = c > 0 and int(g[r, c - 1]) == int(BG)
+            right_bg = c + 1 < w and int(g[r, c + 1]) == int(BG)
