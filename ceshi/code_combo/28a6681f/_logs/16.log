+            total += 1
+    return total
+
+
+def _zone_fill(out: np.ndarray, points: tuple[tuple[int, int], ...]) -> int:
+    return int(sum(int(out[r, c]) == int(WATER) for r, c in points))
+
+
+def _behavior_metrics(grid: np.ndarray) -> dict[str, int | float | bool]:
