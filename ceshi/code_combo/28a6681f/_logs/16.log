   297	            if rr + 1 < h and int(g[rr + 1, cc]) != int(BG):
   298	                left = int(cc)
   299	                while left - 1 >= 0 and int(g[rr, left - 1]) == int(BG):
   300	                    left -= 1
   301	                right = int(cc)
   302	                while right + 1 < w and int(g[rr, right + 1]) == int(BG):
   303	                    right += 1
   304	
   305	                drops = [int(x) for x in range(left, right + 1) if int(g[rr + 1, int(x)]) == int(BG)]
   306	                if not drops:
   307	                    break
   308	
   309	                min_dist = min(abs(int(x - cc)) for x in drops)
   310	                nearest = [int(x) for x in drops if abs(int(x - cc)) == int(min_dist)]
   311	                if len(nearest) != 1:
   312	                    raise AssertionError(f"ambiguous nearest drop columns: {nearest}")
   313	                best = nearest[0]
   314	                step = -1 if best < cc else 1
   315	                nx = int(cc + step)
   316	                if int(g[rr, nx]) != int(BG):
   317	                    raise AssertionError("horizontal slide blocked")
   318	                cc = nx
   319	                continue
   320	
   321	            break
   322	        else:
   323	            raise AssertionError("water pixel did not settle")
   324	
   325	        return int(rr), int(cc)
   326	
   327	    for _pass in range(h * w):
   328	        moved = False
   329	        pts = sorted(_water_positions(g), reverse=True)
   330	        for r, c in pts:
   331	            if int(g[r, c]) != int(WATER):
   332	                continue
   333	            g[r, c] = int(BG)
   334	            rr, cc = settle(r, c)
   335	            moved = bool(moved or ((rr, cc) != (r, c)))
   336	            g[rr, cc] = int(WATER)
   337	        if not moved:
   338	            return g
   339	
   340	    raise AssertionError("gravity baseline did not converge")
   341	
   342	
   343	def _build_candidate(rng: random.Random) -> np.ndarray:
   344	    pocket_color, chamber_color, bar_color = rng.sample(list(COLOR_POOL), 3)
   345	    mirror = rng.choice((False, True))
   346	
   347	    g = np.zeros(GRID_SHAPE, dtype=int)
   348	
   349	    # Side source pocket with one outlet into the chamber.
   350	    g[SOURCE_ROWS, SOURCE_COLS] = int(WATER)
   351	    g[0, 3] = int(pocket_color)
   352	    g[4, 0:4] = int(pocket_color)
   353	
   354	    # Suspended outer chamber.
   355	    g[1, 3:9] = int(chamber_color)
   356	    g[8, 3:9] = int(chamber_color)
   357	    g[1:9, 8] = int(chamber_color)
   358	    g[1:9, 3] = int(chamber_color)
   359	    g[2, 3] = int(BG)
   360	
   361	    # Internal floating bars that create one clear split and a later reconnection.
   362	    g[3, 5:7] = int(bar_color)
   363	    g[5, 4:6] = int(bar_color)
   364	    g[7, 5:7] = int(bar_color)
   365	
   366	    if mirror:
   367	        g = np.fliplr(g).copy()
   368	
   369	    assert int(np.count_nonzero(g == int(WATER))) == int(SOURCE_WATER_COUNT)
   370	    return g
   371	
   372	
   373	def _count_unsupported(out: np.ndarray) -> int:
   374	    h, _w = out.shape
   375	    total = 0
   376	    for r, c in _water_positions(out):
   377	        if r + 1 < h and int(out[r + 1, c]) == int(BG):
   378	            total += 1
   379	    return total
   380	
   381	
   382	def _zone_fill(out: np.ndarray, points: tuple[tuple[int, int], ...]) -> int:
   383	    return int(sum(int(out[r, c]) == int(WATER) for r, c in points))
   384	
   385	
   386	def _behavior_metrics(grid: np.ndarray) -> dict[str, int | float | bool]:
   387	    new_out = main(grid)
   388	    old_out = _gravity_baseline(grid)
   389	    _filled, layers, partial_last_layer, remaining = _diffusion_plan(grid)
   390	    assert remaining == 0
   391	
   392	    features = _feature_points(grid)
   393	    new_rows = [r for r, _c in _water_positions(new_out)]
   394	    old_rows = [r for r, _c in _water_positions(old_out)]
   395	
   396	    return {
   397	        "delta_vs_gravity": int(np.sum(new_out != old_out)),
   398	        "unsupported_water": int(_count_unsupported(new_out)),
   399	        "height_gap": float(np.mean(old_rows) - np.mean(new_rows)),
   400	        "layer_count": int(len(layers)),
   401	        "partial_last_layer": bool(partial_last_layer),
   402	        "split_left": int(_zone_fill(new_out, features["split_left"])),
   403	        "split_right": int(_zone_fill(new_out, features["split_right"])),
   404	        "merge_fill": int(_zone_fill(new_out, features["merge_zone"])),
   405	        "lower_progress": int(_zone_fill(new_out, features["lower_progress"])),
   406	        "bottom_solid_count": int(np.count_nonzero((grid[-1] != int(BG)) & (grid[-1] != int(WATER)))),
   407	    }
   408	
   409	
   410	def generate_example(
   411	    rng: random.Random | None = None,
   412	) -> tuple[np.ndarray, np.ndarray, dict[str, int | float | bool]]:
   413	    if rng is None:
   414	        rng = random.Random()
   415	
   416	    candidate = _build_candidate(rng)
   417	    output = main(candidate)
   418	    metadata = _behavior_metrics(candidate)
   419	    return candidate, output, metadata
   420	
   421	
   422	def generate_input() -> np.ndarray:
   423	    rng = random.Random()
   424	    last_error: Exception | None = None
   425	
   426	    for _ in range(MAX_GENERATION_ATTEMPTS):
   427	        candidate = _build_candidate(rng)
   428	        try:
   429	            metrics = _behavior_metrics(candidate)
   430	        except Exception as exc:
   431	            last_error = exc
   432	            continue
   433	
   434	        if metrics["delta_vs_gravity"] < 14:
   435	            continue
   436	        if metrics["unsupported_water"] < 2:
   437	            continue
   438	        if metrics["height_gap"] < 1.25:
   439	            continue
   440	        if metrics["layer_count"] < 7:
   441	            continue
   442	        if metrics["partial_last_layer"]:
   443	            continue
   444	        if metrics["split_left"] < 2 or metrics["split_right"] < 2:
   445	            continue
   446	        if metrics["merge_fill"] < 2:
   447	            continue
   448	        if metrics["lower_progress"] < 1:
   449	            continue
   450	        if metrics["bottom_solid_count"] != 0:
   451	            continue
   452	
   453	        return candidate
   454	
   455	    if last_error is not None:
   456	        raise RuntimeError(f"failed to generate fused suspended-BFS sample: {last_error}")
   457	    raise RuntimeError("failed to generate fused suspended-BFS sample")

diff --git a/ceshi/code_combo/28a6681f/16/code.py b/ceshi/code_combo/28a6681f/16/code.py
