import numpy as np

def sim(grid,check_input=True):
    g=np.array(grid,dtype=int).copy(); H,W=g.shape; bg=0; water=1
    if check_input:
        for r,c in np.argwhere(g==1):
            if r<H-1 and g[r+1,c]==0: raise AssertionError('unsupported')
            left_bg=c>0 and g[r,c-1]==0
            right_bg=c+1<W and g[r,c+1]==0
            if left_bg and right_bg: raise AssertionError(('bothbg',(r,c)))
    def settle(r,c):
        rr,cc=r,c
        for _ in range(H*W):
            if rr+1<H and g[rr+1,cc]==0:
                rr+=1; continue
            opts=[]
            if rr+1<H and cc-1>=0 and g[rr,cc-1]==0 and g[rr+1,cc-1]==0: opts.append((rr+1,cc-1))
            if rr+1<H and cc+1<W and g[rr,cc+1]==0 and g[rr+1,cc+1]==0: opts.append((rr+1,cc+1))
            if opts:
                if len(opts)"'!=1: raise AssertionError(('"'diag',opts,(rr,cc)))
                rr,cc=opts[0]; continue
            if rr+1<H and g[rr+1,cc]"'!=0:
                L=cc
                while L-1>=0 and g[rr,L-1]==0: L-=1
                R=cc
                while R+1<W and g[rr,R+1]==0: R+=1
                drops=[x for x in range(L,R+1) if g[rr+1,x]==0]
                if not drops: break
                md=min(abs(x-cc) for x in drops)
                near=[x for x in drops if abs(x-cc)==md]
                if len(near)!=1: raise AssertionError(('"'horiz',near,(rr,cc)))
                best=near[0]
                cc += -1 if best<cc else 1
                continue
            break
        return rr,cc
    for _ in range(H*W):
        moved=False
        for r,c in sorted([tuple(map(int,rc)) for rc in np.argwhere(g==1)], reverse=True):
            if g[r,c]"'!=1: continue
            g[r,c]=0
            rr,cc=settle(r,c)
            moved |= (rr,cc)!=(r,c)
            g[rr,cc]=1
        if not moved: return g
    raise AssertionError('"'no conv')

def test(name, base, source_sets, guide_color):
    for idx, cells in enumerate(source_sets):
        g=base.copy()
        ok=True
        try:
            for r,c in cells:
                if g[r,c]"'!=0: raise AssertionError('"'overlap')
                g[r,c]=1
            out=sim(g)
            gg=g.copy(); gg[gg==guide_color]=0
            try:
                out2=sim(gg,check_input=False)
                diff=np.count_nonzero((out==1)"'!=(out2==1))
                msg=f'"'diff {diff}'
            except Exception as e:
                msg=f'no-guide fails {e}'
            print(name,idx,'ok','water',len(cells),'out',np.argwhere(out==1).tolist(),msg)
        except Exception as e:
            print(name,idx,'bad',e)

