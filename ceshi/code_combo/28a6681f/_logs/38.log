+    hole_row = int(profile["hole_row"])
+    left_wall_top = int(profile["left_wall_top"])
+    mid_wall_top = int(profile["mid_wall_top"])
+
+    g[1:3, src_left : src_left + src_width] = int(WATER)
+    g[3, : src_left + src_width] = 2
