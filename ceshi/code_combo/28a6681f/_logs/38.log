+        neighbors = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+    count = 0
+    while remaining:
+        count += 1
+        stack = [remaining.pop()]
+        while stack:
+            r, c = stack.pop()
+            for dr, dc in neighbors:
+                nxt = (int(r + dr), int(c + dc))
