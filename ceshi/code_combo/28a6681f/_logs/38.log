def sim(grid, strict_diag=False, nearest=False, left_tie=True, metrics=False):
    g=np.array(grid,dtype=int).copy(); H,W=g.shape
    m={k:0 for k in ['relaxed_only_diag','diag_ties','horiz_ties','farthest_commits','hole_row_steps','hole_crossings','moved']}
