+        if report["diff_from_originalized"] < 4:
+            continue
+        if report["diff_from_strict_far"] < 2:
+            continue
+        if report["diff_from_relaxed_near"] < 6:
+            continue
+        return grid
+
+    raise AssertionError("failed to sample a valid combo-38 input")

