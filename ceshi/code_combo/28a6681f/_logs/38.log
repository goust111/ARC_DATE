+def _colorize(template: np.ndarray, colors: tuple[int, int, int]) -> np.ndarray:
+    out = np.array(template, dtype=int).copy()
+    for code, color in zip((2, 3, 4), colors):
+        out[out == int(code)] = int(color)
+    return out
+
