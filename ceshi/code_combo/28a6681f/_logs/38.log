import numpy as np, itertools

def sim(grid, *, strict_diag_side=False, prefer_farthest=True, tie_left=True):
    g=np.array(grid,dtype=int).copy(); H,W=g.shape
    m={k:0 for k in ['relaxed_only_diag','diag_ties','horiz_ties','farthest_commits','hole_crossings','moved']}
    def settle(r,c):
        rr,cc=int(r),int(c)
        for _ in range(H*W):
            if rr+1<H and g[rr+1,cc]==0:
                rr+=1; continue
            all_opts=[]; strict_opts=[]
            for dc in (-1,1):
                nc=cc+dc
                if rr+1<H and 0<=nc<W and g[rr+1,nc]==0:
                    all_opts.append((rr+1,nc))
                    if g[rr,nc]==0:
                        strict_opts.append((rr+1,nc))
            opts=strict_opts if strict_diag_side else all_opts
            if opts:
                if not strict_diag_side and all_opts and not strict_opts:
                    m['relaxed_only_diag'] += 1
                if len(opts)>1:
                    m['diag_ties'] += 1
                rr,cc=(min(opts,key=lambda rc: rc[1]) if tie_left else max(opts,key=lambda rc: rc[1]))
                continue
            if rr+1<H and g[rr+1,cc]"'!=0:
                L=cc
                while L-1>=0 and g[rr,L-1]==0: L-=1
                R=cc
                while R+1<W and g[rr,R+1]==0: R+=1
                drops=[x for x in range(L,R+1) if g[rr+1,x]==0]
                if not drops: break
                dist=(max if prefer_farthest else min)(abs(x-cc) for x in drops)
                best=[x for x in drops if abs(x-cc)==dist]
                if len(best)>1:
                    m['"'horiz_ties'] += 1
                target=(min(best) if tie_left else max(best))
                if target==cc: break
                if prefer_farthest and abs(target-cc)>1:
                    m['farthest_commits'] += 1
                for wall in (3,6):
                    if (cc < wall < target) or (target < wall < cc):
                        m['hole_crossings'] += 1
                if prefer_farthest:
                    cc=target
                else:
                    cc += -1 if target<cc else 1
                continue
            break
        return rr,cc
    for _ in range(H*W):
        moved=False
        pts=sorted([(int(r),int(c)) for r,c in np.argwhere(g==1)], reverse=True)
        for r,c in pts:
            if g[r,c]"'!=1: continue
            g[r,c]=0
            rr,cc=settle(r,c)
            if (rr,cc)!=(r,c):
                m['"'moved'] += 1
                moved=True
            g[rr,cc]=1
        if not moved:
            break
    return g,m

def build(src_left, src_width, peg_col, hole_row, left_wall_top, mid_cap_row):
    g=np.zeros((10,10),dtype=int)
    # source block 2xW on rows 1-2
    g[1:3, src_left:src_left+src_width]=1
    # support platform row3 from 0..src_left+src_width-1, but leave one gap before peg if needed
    plat_end=src_left+src_width-1
    g[3, :plat_end+1]=2
    if peg_col is not None:
        g[3, peg_col]=2
    # left divider at c3 with optional hole
    for r in range(left_wall_top,9):
        if r"'!=hole_row:
            g[r,3]=2
    # middle lip / basin shaping
    g[4,5]=2
    # right divider at c6 with hole at row4 or row5 maybe
    for r in range(mid_cap_row,9):
        if r!=hole_row:
            g[r,6]=2
    # outer wall
    for r in range(4,9):
        g[r,9]=2
    g[9,:]=2
    return g

valid=[]
for src_left, src_width, peg_col, hole_row, left_wall_top, mid_cap_row in itertools.product([1,2],[3,4],[6,7],[4,5],[4,5],[3,4,5]):
    g=build(src_left,src_width,peg_col,hole_row,left_wall_top,mid_cap_row)
