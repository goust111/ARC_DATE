def tie_left_from_grid(g):
    top=min(5,g.shape[0])
    left=sum(int(g[r,0] not in (0,1)) for r in range(top))
    right=sum(int(g[r,-1] not in (0,1)) for r in range(top))
    return left >= right

def sim(grid, *, strict_diag_side=False, prefer_farthest=True, tie_mode='guide'):
    g=np.array(grid,dtype=int).copy(); H,W=g.shape
    prefer_left = tie_left_from_grid(g) if tie_mode=='guide' else (tie_mode=='left')
    m={k:0 for k in ['relaxed_only_diag','diag_ties','horiz_ties','farthest_commits','hole_crossings','moved','right_ties']}
