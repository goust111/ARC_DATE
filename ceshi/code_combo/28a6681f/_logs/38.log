+    g = np.array(grid, dtype=int).copy()
+    H, W = g.shape
+    prefer_left = _prefer_left_from_source(g)
+    metrics = {
+        "relaxed_only_diag": 0,
+        "diag_ties": 0,
+        "horiz_ties": 0,
+        "farthest_commits": 0,
+        "hole_crossings": 0,
+        "moved_pixels": 0,
+        "tie_pref_left": int(prefer_left),
+        "tie_pref_right": int(not prefer_left),
