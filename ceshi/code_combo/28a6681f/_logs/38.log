+
+def _simulate(
+    grid: np.ndarray,
+    *,
+    strict_diag_side: bool,
+    prefer_farthest: bool,
+    check_input: bool = True,
+    check_output: bool = True,
+    collect_metrics: bool = False,
+) -> np.ndarray | tuple[np.ndarray, dict[str, int]]:
