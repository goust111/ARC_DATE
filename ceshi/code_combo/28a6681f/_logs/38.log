+                    metrics["hole_crossings"] += sum(
+                        1
+                        for wall in WALL_COLUMNS
+                        if (int(cc) < int(wall) < int(target_col)) or (int(target_col) < int(wall) < int(cc))
+                    )
+                    cc = int(target_col)
+                else:
