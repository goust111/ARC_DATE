+    report = dict(combo_metrics)
+    report["diff_from_originalized"] = _hamming(combo, strict_near)
+    report["diff_from_strict_far"] = _hamming(combo, strict_far)
+    report["diff_from_relaxed_near"] = _hamming(combo, relaxed_near)
