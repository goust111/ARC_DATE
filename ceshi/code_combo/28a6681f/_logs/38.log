                    for x in range(min(cc,target), max(cc,target)+1):
                        if x in hole_cols and x"'!=cc and x!=target:
                            m['"'hole_row_steps']+=1
                    # detect crossing from one side of a wall to the other along same row
                    for wall in hole_cols:
                        if (cc < wall < target) or (target < wall < cc):
