+        check_input=True,
+        check_output=False,
+        collect_metrics=False,
+    )
+    assert isinstance(strict_near, np.ndarray)
+    assert isinstance(strict_far, np.ndarray)
+    assert isinstance(relaxed_near, np.ndarray)
