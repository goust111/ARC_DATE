+def _leak_visibility(output: np.ndarray, hole_row: int, prefer_left: bool) -> bool:
+    remote_cols = (7, 8) if prefer_left else (1, 2)
+    remote = np.argwhere(output[:, remote_cols] == int(WATER))
+    middle = np.argwhere(output[:, 4:6] == int(WATER))
