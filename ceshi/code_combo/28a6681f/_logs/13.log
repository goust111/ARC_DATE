+                continue
+            g[int(r), int(c)] = int(BG)
+            dest = settle(int(r), int(c), record_metrics=True)
+            if dest is None:
+                moved = True
+                continue
+            rr, cc = dest
+            moved = bool(moved or ((int(rr), int(cc)) != (int(r), int(c))))
+            g[int(rr), int(cc)] = int(WATER)
