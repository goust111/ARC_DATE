+                nearest = [int(x) for x in drops if abs(int(x - cc)) == int(min_dist)]
+                assert len(nearest) == 1, f"ambiguous nearest drop columns: {nearest}"
+                best = int(nearest[0])
+                assert best != int(cc)
+                step = -1 if best < int(cc) else 1
+                nx = int(cc + step)
+                assert int(g[rr, nx]) == int(BG)
+                if evaporation_enabled:
