+    right_mask = settled_masks.get(int(RIGHT_NEW_WATER), np.zeros_like(grid, dtype=bool))
+    total = 0
+
+    for r, c in np.argwhere(left_mask):
+        rr = int(r)
+        cc = int(c)
+        if rr + 1 < grid.shape[0] and old_mask[rr + 1, cc]:
+            total += 1
+
+    support_mask = old_mask | left_mask
