+            int(r)
+            for r in range(source_mask.shape[0] - 1, -1, -1)
+            if source_mask[int(r), 8] and source_mask[int(r), 9] and int(forbidden[int(r), 7])
+        ]
+        assert keep_count % 2 == 0, "right source remainder must occupy full stable pairs"
+        pairs = keep_count // 2
+        assert pairs <= len(stable_rows), "right source cannot stably retain that much blocked water"
