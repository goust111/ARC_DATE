+    source_mask: np.ndarray,
+    *,
+    keep_count: int,
+    forbidden: np.ndarray,
+) -> np.ndarray:
+    keep_count = int(keep_count)
+    if keep_count <= 0:
+        return np.zeros_like(source_mask, dtype=bool)
+
+    remainder = np.zeros_like(source_mask, dtype=bool)
+    cols = sorted({int(c) for _r, c in np.argwhere(source_mask)})
+
+    if cols == [0]:
+        stable_rows = [int(r) for r, c in np.argwhere(source_mask) if int(c) == 0 and int(forbidden[int(r), 1])]
+        stable_rows.sort(reverse=True)
