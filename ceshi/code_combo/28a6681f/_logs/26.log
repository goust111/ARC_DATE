+def _batch_order(g: np.ndarray) -> list[int]:
+    return [int(color) for color in NEW_WATER_COLORS if np.any(g == int(color))]
+
+
+def _assert_final_stability(g: np.ndarray) -> None:
+    h, w = g.shape
+    for r, c in np.argwhere(g == int(OLD_WATER)):
+        rr = int(r)
+        cc = int(c)
+        assert cc == 0 or int(g[rr, cc - 1]) != int(BG)
+        assert rr == h - 1 or int(g[rr + 1, cc]) != int(BG)
+        assert cc == w - 1 or int(g[rr, cc + 1]) != int(BG)
+
+
+def _pick_source_remainder(
+    source_mask: np.ndarray,
+    *,
+    keep_count: int,
+    forbidden: np.ndarray,
+) -> np.ndarray:
+    keep_count = int(keep_count)
+    if keep_count <= 0:
+        return np.zeros_like(source_mask, dtype=bool)
+
+    remainder = np.zeros_like(source_mask, dtype=bool)
+    cols = sorted({int(c) for _r, c in np.argwhere(source_mask)})
+
+    if cols == [0]:
+        stable_rows = [int(r) for r, c in np.argwhere(source_mask) if int(c) == 0 and int(forbidden[int(r), 1])]
+        stable_rows.sort(reverse=True)
+        assert keep_count <= len(stable_rows), "left source cannot stably retain that much blocked water"
+        for r in stable_rows[:keep_count]:
+            remainder[int(r), 0] = True
+        return remainder
+
+    if set(cols) == {8, 9}:
+        stable_rows = [
+            int(r)
+            for r in range(source_mask.shape[0] - 1, -1, -1)
+            if source_mask[int(r), 8] and source_mask[int(r), 9] and int(forbidden[int(r), 7])
+        ]
+        assert keep_count % 2 == 0, "right source remainder must occupy full stable pairs"
+        pairs = keep_count // 2
+        assert pairs <= len(stable_rows), "right source cannot stably retain that much blocked water"
+        for r in stable_rows[:pairs]:
+            remainder[int(r), 8] = True
+            remainder[int(r), 9] = True
+        return remainder
+
+    raise AssertionError("unsupported source geometry for blocked-water remainder")
+
+
+def _solve_sequential_batches(
+    grid: np.ndarray,
+    *,
+    check_input: bool,
+    check_output: bool,
+) -> tuple[np.ndarray, dict[int, np.ndarray]]:
+    g = np.array(grid, dtype=int).copy()
+    base = np.where(np.isin(g, NEW_WATER_COLORS), BG, g)
+    occupied = base.copy()
+    settled_masks: dict[int, np.ndarray] = {}
+
+    if check_input:
+        assert g.shape == GRID_SHAPE, f"expected a {GRID_SHAPE[0]}x{GRID_SHAPE[1]} grid"
+        _validate_old_water(g)
+        _validate_new_water_sources(g, NEW_WATER_COLORS)
+        _validate_guides(g)
