+    for r in range(10 - left_height, 10):
+        g[r, LEFT_WALL] = int(left_color)
+    for r in range(10 - mid_height, 10):
+        g[r, MID_WALL] = int(mid_color)
+    for r in range(10 - right_height, 10):
