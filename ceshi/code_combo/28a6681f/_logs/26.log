+            source_mask,
+            keep_count=source_count - claimed_count,
+            forbidden=occupied != BG,
+        )
+        final_mask = claim_mask | remainder_mask
+        settled_masks[int(color)] = final_mask
+        occupied[final_mask] = int(OLD_WATER)
