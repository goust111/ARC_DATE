+
+def _pick_source_remainder(
+    source_mask: np.ndarray,
+    *,
+    keep_count: int,
+    forbidden: np.ndarray,
+    already_kept: np.ndarray,
+) -> np.ndarray:
+    keep_count = int(keep_count)
+    if keep_count <= 0:
+        return np.zeros_like(source_mask, dtype=bool)
+
+    remainder = np.zeros_like(source_mask, dtype=bool)
+    points = [(int(r), int(c)) for r, c in np.argwhere(source_mask & ~already_kept)]
+    points.sort(key=lambda rc: (-int(rc[0]), int(rc[1])))
+    kept = 0
+    for r, c in points:
+        if forbidden[int(r), int(c)]:
+            continue
+        remainder[int(r), int(c)] = True
+        kept += 1
+        if kept == keep_count:
+            break
+    assert kept == keep_count, "could not keep blocked water inside its source region"
+    return remainder
