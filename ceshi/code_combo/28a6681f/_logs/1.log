+            rr, cc = settle(int(r), int(c))
+            moved = bool(moved or ((int(rr), int(cc)) != (int(r), int(c))))
+            assert int(g[int(rr), int(cc)]) == int(BG), "water paths should not overlap"
+            g[int(rr), int(cc)] = int(WATER)
+        if not moved:
