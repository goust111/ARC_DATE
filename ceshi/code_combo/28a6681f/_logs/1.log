+        metrics = _behavior_metrics(grid)
+        if (
+            metrics["diff_vs_original"] >= 4
+            and metrics["diff_vs_vertical_nearest"] >= 4
+            and metrics["diff_vs_diagonal_farthest"] >= 4
+            and metrics["combo_far"]
