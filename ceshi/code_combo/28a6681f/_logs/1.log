+        for r, c in final_pts:
+            g[int(r), int(c)] = int(BG)
+            rr, cc = settle(int(r), int(c))
+            g[int(r), int(c)] = int(WATER)
+            assert (int(rr), int(cc)) == (int(r), int(c)), f"output water at {(r, c)} is not stable"
