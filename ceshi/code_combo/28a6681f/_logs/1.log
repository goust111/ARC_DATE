import numpy as np

BG=0; W=1

def sim(grid, allow_diag=True, prefer_far=False, check=True):
    g=np.array(grid,dtype=int).copy()
    H,Wd=g.shape
    if check:
        for r,c in np.argwhere(g==W):
            assert r==H-1 or g[r+1,c]"'!=BG
            left_bg=c>0 and g[r,c-1]==BG
            right_bg=c+1<Wd and g[r,c+1]==BG
            assert not (left_bg and right_bg), (r,c)
    def settle(r,c):
        rr,cc=int(r),int(c)
        for _ in range(H*Wd):
            if rr+1<H and g[rr+1,cc]==BG:
                rr+=1; continue
            if allow_diag:
                opts=[]
                if rr+1<H and cc-1>=0 and g[rr,cc-1]==BG and g[rr+1,cc-1]==BG:
                    opts.append((rr+1,cc-1))
                if rr+1<H and cc+1<Wd and g[rr,cc+1]==BG and g[rr+1,cc+1]==BG:
                    opts.append((rr+1,cc+1))
                if opts:
                    assert len(opts)==1, opts
                    rr,cc=opts[0]; continue
            if rr+1<H and g[rr+1,cc]!=BG:
                L=cc
                while L-1>=0 and g[rr,L-1]==BG: L-=1
                R=cc
                while R+1<Wd and g[rr,R+1]==BG: R+=1
                drops=[x for x in range(L,R+1) if g[rr+1,x]==BG]
                if not drops: break
                if prefer_far:
                    dist=max(abs(x-cc) for x in drops)
                    cand=[x for x in drops if abs(x-cc)==dist]
                    assert len(cand)==1, cand
                    cc=cand[0]
                else:
                    dist=min(abs(x-cc) for x in drops)
                    cand=[x for x in drops if abs(x-cc)==dist]
                    assert len(cand)==1, cand
                    step=-1 if cand[0]<cc else 1
                    cc=cc+step
                continue
            break
        return rr,cc
    for _ in range(H*Wd):
        moved=False
        pts=sorted([(int(r),int(c)) for r,c in np.argwhere(g==W)], reverse=True)
        for r,c in pts:
            if g[r,c]!=W: continue
            g[r,c]=BG
            rr,cc=settle(r,c)
            moved = moved or ((rr,cc)!=(r,c))
            assert g[rr,cc]==BG, ((r,c),(rr,cc))
            g[rr,cc]=W
        if not moved: break
    return g


def build(mirror=False,left_cap=4,right_cap=6,src_cols=(3,4),roof=3,left_shaft=2,right_shaft=8):
    g=np.zeros((10,10),dtype=int)
    g[roof:,:]=4
    g[roof:,:4]=2
    g[roof:,6:]=3
    for r in range(roof,roof+left_cap): g[r,left_shaft]=0
    for r in range(roof,roof+right_cap): g[r,right_shaft]=0
    g[:roof,src_cols[0]:src_cols[-1]+1]=1
    if mirror:
        g=np.fliplr(g)
    return g

for params in [
    dict(left_cap=4,right_cap=6,roof=3,left_shaft=2,right_shaft=8),
    dict(left_cap=3,right_cap=6,roof=3,left_shaft=2,right_shaft=8),
    dict(left_cap=4,right_cap=5,roof=3,left_shaft=2,right_shaft=8),
]:
    g=build(**params)
    try:
        orig=sim(g,allow_diag=True,prefer_far=False)
        combo=sim(g,allow_diag=False,prefer_far=True)
        d1=sim(g,allow_diag=False,prefer_far=False)
        d3=sim(g,allow_diag=True,prefer_far=True)
        print('"'params',params)
        print('input\\n',g)
        print('orig\\n',orig)
        print('d1\\n',d1)
        print('d3\\n',d3)
        print('combo\\n',combo)
        print('diff vs orig',np.sum(combo"'!=orig),'"'vs d1',np.sum(combo"'!=d1),'"'vs d3',np.sum(combo"'!=d3))
        print()
    except Exception as e:
        print('"'params failed',params,e)
