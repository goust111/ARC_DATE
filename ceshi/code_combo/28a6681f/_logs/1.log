+    matter, and the reversed "pick the farthest drop" policy then sends water past nearer shafts into more remote ones.
+    """
+    return _simulate(
+        grid,
+        allow_diagonal=False,
+        prefer_farthest=True,
+        check_input=check_input,
+        check_output=check_output,
+    )
+
+
+def _build_case(
+    *,
+    left_color: int,
+    center_color: int,
+    right_color: int,
+    left_capacity: int,
+    right_capacity: int,
+    mirror: bool,
