            # Variant of 28a6681f
# Dimension: D7 — 盆地结构形状 (obstacle)
# Change: 2-3个底部锚定的结构：U形、L形、阶梯形或单竖壁，相邻盆地壁高不等且可相互连通允许溢流... → 嵌套盆地（盆中盆）

from __future__ import annotations

import random

import numpy as np


# Design analysis
# a) 具体化与行为追踪
#    - 网格仍固定为 10x10，背景为 0，水为 1，障碍使用 2 种不同颜色。
#    - 原任务强调“相邻盆地之间的侧向溢流”；这个变体把障碍改成“外层大 U 形盆 + 内层小 U 形盆”。
#    - 外盆始终落在底边，内盆完全放在外盆内部，且内盆底比外盆底高 1 格，因此会出现两层可见容积：
#      1) 内盆腔体
#      2) 外盆与内盆之间的环形侧槽
#    - 输入水源不再依赖导流件。为了把 D7 的变化放到视觉中心，直接在内盆开口上方放一个 2 列、竖向堆叠的受支撑水柱。
#      这个水柱本身满足原 solver 的输入断言：每格都由下方水格或内盆底支撑，而且每格左右至少有一侧不是背景。
#    - 具体跟踪一个样例：
#      外盆左右墙在 c=1,8，内盆左右墙在 c=3,6，内盆墙顶在 r=5，输入水量为 14。
#      原题的“相邻盆地”思路会把额外水看成从一个盆溢到旁边的另一个盆。
#      这里同样的局部水流规则会先把 6 格水塞满内盆腔体 (r=5..7, c=4..5)，随后剩余 8 格被迫绕到两侧环槽
#      (r=5..8, c=2 与 c=7)，形成“先内后外”的分级填充。差异不在移动规则，而在障碍拓扑。
#
# b) 复杂度校准
#    - 如果内盆太宽，样例会退化成“只是一个更宽的普通盆”；如果内盆太窄，视觉上难以看出是嵌套结构。
#    - 这里固定内盆腔宽为 2、内盆底宽为 4、外盆总宽为 8。这样既能清楚看见内外两层，又不会引入太多自由度。
#    - 只保留两个合法水量档位：10 或 14。它们分别对应“填到内盆边缘并已溢入外环”的两个稳定层级，
#      能重复支持同一条规律；不采样半层水量，避免出现肉眼难解释的边缘状态。
#
# c) 隐式假设审查（围绕 main 中与变体相关的代码）
#    - 输入检查 `input water must be supported` 依赖“每个输入水格下方非背景”。生成器用竖直水柱并让其底部落在内盆底上，
#      所以前提仍成立。
#    - 输入检查 `input water cannot have bg on both horizontal sides` 在原题中约束侧向孤立水格。这里用宽 2 的水柱，
#      每格至少有一个水平水邻居，因此前提仍成立。
#    - `bottom_colors` / guide 检查原本会对顶部斜坡导流件做合法性断言。嵌套盆地全由水平/垂直墙构成，
#      对角相邻计数不会达到 guide 的阈值，因此不会被误判成导流件。
#    - `settle()` 的下落、对角滑动、水平找最近落点逻辑完全保留；变体只改变障碍形状，不改局部物理。
#    - 最关键的新隐式约束来自原 solver 的输出检查：最终每个水格左、右、下都必须非背景。
#      这意味着“刚越过内盆边缘但还没铺满外盆整层”的半层状态会被判为非法。
#      生成器因此只使用累计满层水量 10 / 14，严格避开非法半层。
#
# d) 放置合法性
#    - 外盆左右墙固定相距 7 列，始终完全落在网格内；外盆整体可左右平移 0/1/2 列。
#    - 内盆始终放在外盆内部，左右墙比外盆各缩进 2 列，因此不会与外盆重叠，也不会越界。
#    - 外盆底固定在 r=9，内盆底固定在 r=8；内盆墙顶只取 r=5 或 r=6，保证既看得出嵌套，又给输入水柱留出高度。
#    - 水柱只落在内盆腔体两列中，绝不覆盖障碍。
#
# e) 视觉可观察性
#    - 人类观察 2-4 个样例时，应直接看到：一个大盆里面还有一个小盆，输出里小盆先被填满，水再出现在外环。
#    - 为了让这一点稳定可见，这里不混入 guide、颜色排序、镜像规则等额外变化，只保留左右平移、墙高和颜色变化。
#    - 水量只取两个档位，样例间会反复出现“内盆已满且外环有水”的共同模式，便于归纳。
#
# f) 可视化整洁度
#    - 所有元素都处在同一静态场景：外盆、内盆、水源。
#    - 不让水源跨越多个不相干区域，也不让额外障碍散落到上半区，避免画面同时出现太多结构层次。
#    - 外盆和内盆用不同颜色，能快速分辨“包裹关系”。
#
# g) 颜色变化可推断性
#    - 颜色只用于区分两层静态障碍，不参与任何排序、匹配或变换逻辑。
#    - 水永远保持颜色 1，背景永远保持 0，因此解题者不需要推断隐藏的颜色映射。


def _component_count(points: set[tuple[int, int]], use_diagonal: bool) -> int:
    remaining = set(points)
    if use_diagonal:
        neighbors = [(dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if (dr, dc) != (0, 0)]
    else:
        neighbors = [(-1, 0), (1, 0), (0, -1), (0, 1)]
    count = 0
    while remaining:
        count += 1
        stack = [remaining.pop()]
        while stack:
            r, c = stack.pop()
            for dr, dc in neighbors:
                nxt = (int(r + dr), int(c + dc))
                if nxt in remaining:
                    remaining.remove(nxt)
                    stack.append(nxt)
    return count


def _find_layout(grid: np.ndarray) -> dict[str, int]:
    solids = grid > 1
    assert solids.shape == (10, 10)
    bottom_cols = [int(c) for c in np.where(solids[9])[0]]
    assert bottom_cols, "missing outer basin base"
    outer_left = min(bottom_cols)
    outer_right = max(bottom_cols)

    inner_cols = [int(c) for c in np.where(solids[8])[0] if outer_left < int(c) < outer_right]
    assert inner_cols, "missing inner basin base"
    inner_left = min(inner_cols)
    inner_right = max(inner_cols)

    left_wall_rows = [int(r) for r in np.where(solids[:, inner_left])[0] if int(r) < 9]
    right_wall_rows = [int(r) for r in np.where(solids[:, inner_right])[0] if int(r) < 9]
    assert left_wall_rows and right_wall_rows, "missing inner basin walls"
    inner_top = min(min(left_wall_rows), min(right_wall_rows))

    outer_left_rows = [int(r) for r in np.where(solids[:, outer_left])[0]]
    outer_right_rows = [int(r) for r in np.where(solids[:, outer_right])[0]]
    outer_top = min(min(outer_left_rows), min(outer_right_rows))

    return {
        "outer_left": int(outer_left),
        "outer_right": int(outer_right),
        "outer_top": int(outer_top),
        "inner_left": int(inner_left),
        "inner_right": int(inner_right),
        "inner_top": int(inner_top),
    }


def _nested_metrics(inp: np.ndarray, out: np.ndarray) -> dict[str, int]:
    layout = _find_layout(inp)
    inner_left = layout["inner_left"]
    inner_right = layout["inner_right"]
    inner_top = layout["inner_top"]
    outer_left = layout["outer_left"]
    outer_right = layout["outer_right"]

    inner_cells = [
        (r, c)
        for r in range(inner_top, 8)
        for c in range(inner_left + 1, inner_right)
    ]
    annulus_cells = [
        (r, c)
        for r in range(inner_top, 9)
        for c in range(outer_left + 1, outer_right)
        if c < inner_left or c > inner_right
    ]
    water_total = int(np.sum(out == 1))
    inner_fill = sum(1 for r, c in inner_cells if int(out[r, c]) == 1)
    annulus_fill = sum(1 for r, c in annulus_cells if int(out[r, c]) == 1)
    inner_capacity = len(inner_cells)
    annulus_capacity = len(annulus_cells)
    moved = int(np.any(inp != out))
    return {
        "water_total": water_total,
        "inner_fill": int(inner_fill),
        "annulus_fill": int(annulus_fill),
        "inner_capacity": int(inner_capacity),
        "annulus_capacity": int(annulus_capacity),
        "moved": moved,
    }


def main(grid: np.ndarray, check_input: bool = True, check_output: bool = True) -> np.ndarray:
    """
    Simulate water settling into nested basins where a smaller cup sits inside a larger outer basin.

    Input structure:
    - Background is 0 and water is color 1.
    - Other colors draw static walls: one large bottom-anchored basin plus one smaller basin nested inside it.
    - Water begins as a supported source column above the inner opening, so some water is already stacked but not yet fully settled.

    Rule:
    - A water pixel first falls straight downward through background.
    - If the cell below is blocked, it may slide diagonally only through an open side opening.
    - If it is resting on support, it moves horizontally toward the nearest drop column and continues falling from there.
    - Repeating that local motion fills the inner basin first and only then spills water into the outer ring.

    Key insight:
    - The motion law is unchanged from the original task; the new challenge is to read the nested obstacle topology so the staged inner-to-outer fill can be predicted.
    """
    g = np.array(grid, dtype=int).copy()
    H, W = g.shape
    bg = 0
    water = 1

    if check_input:
        for r, c in np.argwhere(g == int(water)):
            rr = int(r)
            cc = int(c)
            assert rr == H - 1 or int(g[rr + 1, cc]) != int(bg), "input water must be supported"
            left_bg = cc > 0 and int(g[rr, cc - 1]) == int(bg)
            right_bg = cc + 1 < W and int(g[rr, cc + 1]) == int(bg)
            assert not (left_bg and right_bg), "input water cannot have bg on both horizontal sides"

    bottom_colors = set(map(int, g[H - 1]))
    for color in sorted(set(map(int, g[:7].flatten())) - {bg, water} - bottom_colors):
        pts = {(int(r), int(c)) for r, c in np.argwhere(g[:7] == int(color))}
        diag_links = sum(1 for r, c in pts if (r + 1, c - 1) in pts or (r + 1, c + 1) in pts)
        if diag_links >= 3:
            assert any(c in (0, W - 1) for _r, c in pts), "guide must enter from a grid edge"
            assert _component_count(pts, False) == _component_count(pts, True), "guide must be 4-connected"

    def settle(r: int, c: int) -> tuple[int, int]:
        rr = int(r)
        cc = int(c)
        for _ in range(H * W):
            if rr + 1 < H and int(g[rr + 1, cc]) == int(bg):
                rr += 1
                continue

            opts = []
            if (
                rr + 1 < H
                and cc - 1 >= 0
                and int(g[rr, cc - 1]) == int(bg)
                and int(g[rr + 1, cc - 1]) == int(bg)
            ):
                opts.append((int(rr + 1), int(cc - 1)))
            if (
                rr + 1 < H
                and cc + 1 < W
                and int(g[rr, cc + 1]) == int(bg)
                and int(g[rr + 1, cc + 1]) == int(bg)
            ):
                opts.append((int(rr + 1), int(cc + 1)))
            if opts:
                assert len(opts) == 1, f"ambiguous diagonal moves: {opts}"
                rr, cc = opts[0]
                continue

            if rr + 1 < H and int(g[rr + 1, cc]) != int(bg):
                left = int(cc)
                while left - 1 >= 0 and int(g[rr, left - 1]) == int(bg):
                    left -= 1
                right = int(cc)
                while right + 1 < W and int(g[rr, right + 1]) == int(bg):
                    right += 1

                drops = [int(x) for x in range(int(left), int(right) + 1) if int(g[rr + 1, int(x)]) == int(bg)]
                if not drops:
                    break

                min_dist = min(abs(int(x - cc)) for x in drops)
                nearest = [int(x) for x in drops if abs(int(x - cc)) == int(min_dist)]
                assert len(nearest) == 1, f"ambiguous nearest drop columns: {nearest}"
                best = nearest[0]
                assert best != int(cc)
                step = -1 if best < int(cc) else 1
                nx = int(cc + step)
                assert int(g[rr, nx]) == int(bg)
                cc = nx
                continue

            break
        else:
            raise AssertionError("water pixel did not settle")
        return int(rr), int(cc)

    for _pass in range(H * W):
        moved = False
        pts = sorted([(int(r), int(c)) for r, c in np.argwhere(g == int(water))], reverse=True)
        for r, c in pts:
            if int(g[int(r), int(c)]) != int(water):
                continue
            g[int(r), int(c)] = int(bg)
            rr, cc = settle(int(r), int(c))
            moved = bool(moved or ((int(rr), int(cc)) != (int(r), int(c))))
            g[int(rr), int(cc)] = int(water)
        if not moved:
            break
    else:
        raise AssertionError("water simulation did not converge")

    if check_output:
        for r, c in np.argwhere(g == int(water)):
            rr = int(r)
            cc = int(c)
            assert cc == 0 or int(g[rr, cc - 1]) != int(bg)
            assert rr == H - 1 or int(g[rr + 1, cc]) != int(bg)
            assert cc == W - 1 or int(g[rr, cc + 1]) != int(bg)

    return g


def _build_nested_basin(
    outer_left: int,
    outer_top: int,
    inner_top: int,
    outer_color: int,
    inner_color: int,
) -> np.ndarray:
    grid = np.zeros((10, 10), dtype=int)
    outer_right = outer_left + 7
    inner_left = outer_left + 2
    inner_right = inner_left + 3

    for r in range(outer_top, 10):
        grid[r, outer_left] = int(outer_color)
        grid[r, outer_right] = int(outer_color)
    for c in range(outer_left, outer_right + 1):
        grid[9, c] = int(outer_color)

    for r in range(inner_top, 9):
        grid[r, inner_left] = int(inner_color)
        grid[r, inner_right] = int(inner_color)
    for c in range(inner_left, inner_right + 1):
        grid[8, c] = int(inner_color)

    return grid


def _place_source_water(grid: np.ndarray, inner_top: int) -> np.ndarray:
    g = np.array(grid, dtype=int).copy()
    layout = _find_layout(g)
    inner_left = layout["inner_left"]
    inner_right = layout["inner_right"]

    water_count = 2 + 4 * (8 - inner_top)
    height = water_count // 2
    start_row = 8 - height
    assert height in (5, 7)
    assert start_row >= 0

    for r in range(start_row, 8):
        for c in range(inner_left + 1, inner_right):
            assert int(g[r, c]) == 0
            g[r, c] = 1
    return g


def generate_input() -> np.ndarray:
    solid_colors = [2, 3, 4, 5, 6, 7, 8, 9]

    for _ in range(200):
        inner_top = random.choice([5, 6])
        outer_top = random.randint(2, inner_top - 2)
        outer_left = random.choice([0, 1, 2])
        outer_color, inner_color = random.sample(solid_colors, 2)

        base = _build_nested_basin(
            outer_left=outer_left,
            outer_top=outer_top,
            inner_top=inner_top,
            outer_color=outer_color,
            inner_color=inner_color,
        )
        inp = _place_source_water(base, inner_top=inner_top)
        out = main(inp)
        metrics = _nested_metrics(inp, out)

        if metrics["moved"] != 1:
            continue
        if metrics["inner_fill"] != metrics["inner_capacity"]:
            continue
        if metrics["annulus_fill"] <= 0:
            continue
        if metrics["water_total"] <= metrics["inner_capacity"]:
            continue

        return inp

    raise AssertionError("failed to generate a nested-basin sample")

            ```

            ### 参考代码: D9/1

            文件: `/home/lixinyu/snap/new/ceshi/code/28a6681f/D9/1/code.py`

            ```python
            # Variant of 28a6681f
# Dimension: D9 — 溢流机制 (path)
# Change: 水填满一个盆地后从较低壁顶溢出流入相邻盆地，约50%样本展示可见溢流... → 连通器原理（水位趋于平衡）

from __future__ import annotations

import random

import numpy as np

# Design analysis
# a) Concrete geometry and behavior:
#    - The original task relied on open basins plus local falling / sliding. That cannot express
#      true communicating vessels because a water pixel would need to move down through a connector
#      and then rise inside a neighboring chamber.
#    - The variant therefore keeps the "bottom-anchored colored container" vocabulary but turns the
#      basin group into two enclosed vertical chambers linked by a one-row-low connector corridor.
#      Input water is piled inside only one wider source chamber. Output redistributes the same
#      total water across the whole enclosed cavity so that both chambers end at the same height.
#    - Small trace:
#      original logic on a left-full / right-empty pair would leave most water in the left cup
#      until a wall-top overflow exists; variant logic counts all water in the connected cavity and
#      refills the cavity from the bottom upward, so the right chamber gains water even though this
#      requires "rising" after passing through the bottom connector.
# b) Complexity calibration:
#    - Two chambers are enough to make the new rule visible. The source chamber is width 3 and the
#      other chamber width 2, so input is clearly lopsided while output is clearly balanced.
#    - Water volumes are sampled only from exact cumulative row capacities. This avoids ambiguous
#      partial top rows and makes the flat shared waterline human-visible.
# c) Original-code assumptions that break under D9:
#    - `settle()` assumes every move is local and monotone downward/sideways. That blocks the
#      upward leg required by a communicating-vessel connector, so it must be replaced.
#    - The old output check forbids background on left/right/below every water pixel. That matches
#      wedged basin water, but a flat shared level inside a wider chamber naturally has water with
#      air on one side, so the stability criterion must change.
#    - Guide-specific diagonal-connectivity assertions are irrelevant here because this variant no
#      longer uses edge-entering ramps as the core mechanism.
# d) Placement legality:
#    - The generator fixes a 10x10 grid, chooses a container span of width 8, adds one internal
#      partition that stops one row above the floor, and keeps the open cavity away from grid edges.
#      This guarantees no overlap, no leaks, and a single enclosed connected vessel component.
# e) Visual observability:
#    - Input: one chamber is tall and full while the neighbor is empty.
#    - Output: both chambers and the connector show one common horizontal waterline.
#      This is visibly different from wall-top overflow because the distant chamber fills without
#      needing the source chamber to crest over a higher local rim.
# f) Visual cleanliness:
#    - Only water and 2-3 solid colors are used, with a single large container and one partition.
#      No overlapping markers or hidden color encodings are needed.
# g) Color inference:
#    - Colors do not encode ordering or behavior. They only distinguish static walls/roof/partition.
# New solver assumptions audited against the generator:
#    - Every water-bearing open component is an enclosed cavity that does not touch the grid edge.
#    - The sampled water amount matches a whole communicating level: full lower rows, no partial
#      shared surface row. `generate_input()` enforces this exactly.
#    - Components are simple monotone chambers over a connector; no overhang-dependent edge cases
#      are generated.


def _collect_component(
    open_mask: np.ndarray, start: tuple[int, int], seen: set[tuple[int, int]]
) -> list[tuple[int, int]]:
    H, W = open_mask.shape
    stack = [start]
    seen.add(start)
    comp: list[tuple[int, int]] = []
    while stack:
        r, c = stack.pop()
        comp.append((r, c))
        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
            rr = r + dr
            cc = c + dc
            nxt = (rr, cc)
            if 0 <= rr < H and 0 <= cc < W and open_mask[rr, cc] and nxt not in seen:
                seen.add(nxt)
                stack.append(nxt)
    return comp


def _group_rows(component: list[tuple[int, int]]) -> dict[int, list[tuple[int, int]]]:
    by_row: dict[int, list[tuple[int, int]]] = {}
    for r, c in component:
        by_row.setdefault(r, []).append((r, c))
    for cells in by_row.values():
        cells.sort()
    return by_row


def _fill_lowest_rows(
    component: list[tuple[int, int]], water_count: int, require_exact_level: bool
) -> set[tuple[int, int]]:
    by_row = _group_rows(component)
    filled: set[tuple[int, int]] = set()
    remaining = int(water_count)
    for r in sorted(by_row, reverse=True):
        row_cells = by_row[r]
        if remaining >= len(row_cells):
            filled.update(row_cells)
            remaining -= len(row_cells)
            continue
        if remaining == 0:
            break
        if require_exact_level:
            raise AssertionError("water volume does not match a complete shared waterline")
        filled.update(row_cells[:remaining])
        remaining = 0
        break
    if remaining != 0:
        raise AssertionError("water volume exceeds vessel capacity")
    return filled


def _assert_flat_level(component: list[tuple[int, int]], filled: set[tuple[int, int]]) -> None:
    by_row = _group_rows(component)
    seen_air = False
    for r in sorted(by_row, reverse=True):
        row_cells = by_row[r]
        row_has_water = [cell in filled for cell in row_cells]
        if any(row_has_water) and not all(row_has_water):
            raise AssertionError("communicating-vessel row cannot be partially filled")
        if all(row_has_water):
            assert not seen_air, "water must occupy the lowest rows only"
        else:
            seen_air = True


def main(grid: np.ndarray, check_input: bool = True, check_output: bool = True) -> np.ndarray:
    """
    Rebalance water across connected vessel chambers until one common level is reached.

    Input structure:
    - bg = 0 and water = 1.
    - Other colors form bottom-anchored walls, a roof, and an internal partition whose bottom gap
      links neighboring chambers into one enclosed vessel network.
    - Water begins as a supported pile inside one source chamber while other connected chambers are
      partially empty.

    Rule:
    - For each enclosed open cavity that already contains water, count the total number of water
      pixels in that connected cavity.
    - Ignore the initial lopsided pile and refill that cavity from the lowest rows upward.
    - Because the chambers share a low connector, all connected chambers finish with the same
      horizontal waterline.

    Key insight: The answer depends on total water volume versus the full cross-section of the
    connected cavity at each height, not on local overflow paths over the partition top.
    """
    g = np.array(grid, dtype=int).copy()
    H, W = g.shape
    bg = 0
    water = 1
    initial_water = int(np.count_nonzero(g == int(water)))

    if check_input:
        for r, c in np.argwhere(g == int(water)):
            rr = int(r)
            cc = int(c)
            assert rr == H - 1 or int(g[rr + 1, cc]) != int(bg), "input water must be supported"
            left_bg = cc > 0 and int(g[rr, cc - 1]) == int(bg)
            right_bg = cc + 1 < W and int(g[rr, cc + 1]) == int(bg)
            assert not (left_bg and right_bg), "input water cannot have bg on both horizontal sides"

    open_mask = np.logical_or(g == int(bg), g == int(water))
    seen: set[tuple[int, int]] = set()
    for r, c in np.argwhere(g == int(water)):
        start = (int(r), int(c))
        if start in seen:
            continue
        component = _collect_component(open_mask, start, seen)
        touches_edge = any(rr in (0, H - 1) or cc in (0, W - 1) for rr, cc in component)
        if check_input:
            assert not touches_edge, "water must lie inside an enclosed communicating-vessel cavity"
        if touches_edge:
            continue
        water_count = sum(1 for rr, cc in component if int(g[rr, cc]) == int(water))
        filled = _fill_lowest_rows(component, water_count, require_exact_level=check_input)
        for rr, cc in component:
            g[rr, cc] = int(bg)
        for rr, cc in filled:
            g[rr, cc] = int(water)

    if check_output:
        assert int(np.count_nonzero(g == int(water))) == initial_water, "water count must be conserved"
        open_mask = np.logical_or(g == int(bg), g == int(water))
        seen = set()
        for r, c in np.argwhere(g == int(water)):
            rr = int(r)
            cc = int(c)
            assert rr == H - 1 or int(g[rr + 1, cc]) != int(bg), "output water must be supported"
            start = (rr, cc)
            if start in seen:
                continue
            component = _collect_component(open_mask, start, seen)
            touches_edge = any(r0 in (0, H - 1) or c0 in (0, W - 1) for r0, c0 in component)
            assert not touches_edge, "output water leaked out of the vessel"
            filled = {(r0, c0) for r0, c0 in component if int(g[r0, c0]) == int(water)}
            _assert_flat_level(component, filled)

    return g


def _draw_case(
    top: int,
    left_wall: int,
    partition_col: int,
    source_on_left: bool,
    colors: tuple[int, int, int],
) -> tuple[np.ndarray, list[tuple[int, int]], list[int], list[int]]:
    g = np.zeros((10, 10), dtype=int)
    right_wall = left_wall + 7
    wall_color, roof_color, partition_color = colors

    g[9, left_wall : right_wall + 1] = wall_color
    g[top, left_wall : right_wall + 1] = roof_color
    g[top:10, left_wall] = wall_color
    g[top:10, right_wall] = wall_color
    g[top + 1 : 8, partition_col] = partition_color

    open_mask = np.logical_or(g == 0, g == 1)
    component = _collect_component(open_mask, (8, left_wall + 1), set())

    if source_on_left:
        source_cols = list(range(left_wall + 1, partition_col))
        other_cols = list(range(partition_col + 1, right_wall))
        source_order = source_cols[:]
    else:
        source_cols = list(range(partition_col + 1, right_wall))
        other_cols = list(range(left_wall + 1, partition_col))
        source_order = source_cols[::-1]

    assert len(source_cols) == 3
    assert len(other_cols) == 2
    return g, component, source_cols, source_order


def _exact_water_counts(top: int) -> list[int]:
    counts: list[int] = []
    source_capacity = 3 * (8 - top)
    for levels_above_connector in range(1, 7):
        water_count = 6 + 5 * levels_above_connector
        if water_count <= source_capacity:
            counts.append(water_count)
    return counts


def _make_output(base: np.ndarray, component: list[tuple[int, int]], water_count: int) -> np.ndarray:
    out = np.array(base, dtype=int).copy()
    for r, c in _fill_lowest_rows(component, water_count, require_exact_level=True):
        out[r, c] = 1
    return out


def _make_input(
    base: np.ndarray, top: int, source_order: list[int], water_count: int
) -> np.ndarray:
    inp = np.array(base, dtype=int).copy()
    remaining = int(water_count)
    for r in range(8, top, -1):
        for c in source_order:
            if remaining == 0:
                break
            inp[r, c] = 1
            remaining -= 1
        if remaining == 0:
            break
    if remaining != 0:
        raise AssertionError("source chamber was too small for the sampled water volume")
    return inp


def _build_case() -> tuple[np.ndarray, np.ndarray]:
    top = random.choice([1, 2])
    left_wall = random.choice([0, 1, 2])
    source_on_left = bool(random.randrange(2))
    partition_col = left_wall + (4 if source_on_left else 3)
    colors = tuple(random.sample([2, 3, 4, 5, 6, 7, 8, 9], 3))

    base, component, _source_cols, source_order = _draw_case(
        top=top,
        left_wall=left_wall,
        partition_col=partition_col,
        source_on_left=source_on_left,
        colors=colors,
    )
    water_count = random.choice(_exact_water_counts(top))
    inp = _make_input(base, top, source_order, water_count)
    out = _make_output(base, component, water_count)
    return inp, out


def generate_input() -> np.ndarray:
    for _ in range(100):
        inp, out = _build_case()
        solved = main(inp)
        if np.array_equal(solved, out):
            return inp
    raise AssertionError("failed to generate a valid communicating-vessel sample")

            ```

