+    outer_side_cells = [(r, c) for r in (6, 7) for c in range(1, 9) if c not in (4, 5)]
+    full_equalization_rows = [(r, c) for r in (6, 7) for c in range(1, 9)]
+    source_cells = [(r, c) for r in range(8, 10) for c in (4, 5)]
