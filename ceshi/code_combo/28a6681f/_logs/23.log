+
+
+BG = 0
+WATER = 1
+TAP = 8
+CONTROL_TO_AMOUNT = {6: 3, 7: 5, 9: 7}
+CONTROL_COLORS = tuple(sorted(CONTROL_TO_AMOUNT))
+STRUCTURE_COLORS = (2, 3, 4, 5)
+GRID_SHAPE = (10, 10)
+TAP_LENGTH = 2
+MAX_GENERATION_ATTEMPTS = 400
