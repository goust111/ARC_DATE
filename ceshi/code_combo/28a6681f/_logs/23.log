BG=0; WATER=1

def sim(grid):
    g=np.array(grid,dtype=int).copy(); H,W=g.shape
    def settle(r,c):
        rr,cc=r,c
        for _ in range(H*W):
            if rr+1<H and g[rr+1,cc]==BG:
                rr+=1; continue
            opts=[]
            if rr+1<H and cc-1>=0 and g[rr,cc-1]==BG and g[rr+1,cc-1]==BG:
                opts.append((rr+1,cc-1))
            if rr+1<H and cc+1<W and g[rr,cc+1]==BG and g[rr+1,cc+1]==BG:
                opts.append((rr+1,cc+1))
            if opts:
                if len(opts)"'!=1: raise AssertionError(('"'diag',rr,cc,opts))
                rr,cc=opts[0]; continue
            if rr+1<H and g[rr+1,cc]"'!=BG:
                L=cc
                while L-1>=0 and g[rr,L-1]==BG: L-=1
                R=cc
                while R+1<W and g[rr,R+1]==BG: R+=1
                drops=[x for x in range(L,R+1) if g[rr+1,x]==BG]
                if not drops: break
                md=min(abs(x-cc) for x in drops)
                near=[x for x in drops if abs(x-cc)==md]
                if len(near)!=1: raise AssertionError(('"'near',rr,cc,near))
                best=near[0]
                if best==cc: break
                cc += -1 if best<cc else 1
                continue
            break
        return rr,cc
    for _ in range(H*W):
        moved=False
        pts=sorted([(int(r),int(c)) for r,c in np.argwhere(g==WATER)], reverse=True)
        for r,c in pts:
            if g[r,c]"'!=WATER: continue
            g[r,c]=BG
            rr,cc=settle(r,c)
            moved |= (rr,cc)!=(r,c)
            g[rr,cc]=WATER
        if not moved: return g
    raise AssertionError('"'no conv')

def emit(base, src, n):
    g=base.copy(); r,c=src
    for _ in range(n):
        if g[r,c]"'!=0: raise AssertionError(('"'blocked',r,c))
        g[r,c]=1
        g=sim(g)
    return g

def stable(g):
    H,W=g.shape
    for r,c in np.argwhere(g==1):
        if not (c==0 or g[r,c-1]"'!=0): return False, (int(r),int(c),'"'L')
        if not (r==H-1 or g[r+1,c]"'!=0): return False, (int(r),int(c),'"'D')
        if not (c==W-1 or g[r,c+1]"'!=0): return False, (int(r),int(c),'"'R')
    return True, None
