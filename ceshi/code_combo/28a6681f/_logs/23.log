import numpy as np, random
BG=0; WATER=1; TAP=8

def relax(grid):
    g=np.array(grid,dtype=int).copy(); H,W=g.shape
    def settle(r,c):
        rr,cc=r,c
        for _ in range(H*W):
            if rr+1<H and g[rr+1,cc]==BG:
                rr+=1; continue
            opts=[]
            if rr+1<H and cc-1>=0 and g[rr,cc-1]==BG and g[rr+1,cc-1]==BG: opts.append((rr+1,cc-1))
            if rr+1<H and cc+1<W and g[rr,cc+1]==BG and g[rr+1,cc+1]==BG: opts.append((rr+1,cc+1))
            if opts:
                if len(opts)"'!=1: raise AssertionError(('"'diag',rr,cc,opts))
                rr,cc=opts[0]; continue
            if rr+1<H and g[rr+1,cc]"'!=BG:
                left=cc
                while left-1>=0 and g[rr,left-1]==BG: left-=1
                right=cc
                while right+1<W and g[rr,right+1]==BG: right+=1
                drops=[x for x in range(left,right+1) if g[rr+1,x]==BG]
                if not drops: break
                md=min(abs(x-cc) for x in drops)
                near=[x for x in drops if abs(x-cc)==md]
                if len(near)!=1: raise AssertionError(('"'near',rr,cc,near))
                best=near[0]
                if best==cc: break
                cc += -1 if best<cc else 1
                continue
            break
        return rr,cc
    for _ in range(H*W):
        moved=False
        for r,c in sorted([(int(r),int(c)) for r,c in np.argwhere(g==WATER)], reverse=True):
            if g[r,c]"'!=WATER: continue
            g[r,c]=BG
            rr,cc=settle(r,c)
            moved |= (rr,cc)!=(r,c)
            g[rr,cc]=WATER
        if not moved: return g
    raise AssertionError('"'conv')

def stable(g):
    H,W=g.shape
    for r,c in np.argwhere(g==1):
        if not (c==0 or g[r,c-1]"'!=0): return False, (int(r),int(c),'"'L')
        if not (r==H-1 or g[r+1,c]"'!=0): return False, (int(r),int(c),'"'D')
        if not (c==W-1 or g[r,c+1]"'!=0): return False, (int(r),int(c),'"'R')
    return True, None

def emit(base, src, n):
    g=base.copy(); r,c=src
    for _ in range(n):
        if g[r,c]"'!=0: raise AssertionError(('"'blocked',r,c))
        g[r,c]=1
        g=relax(g)
    return g

def build(surface, shelf_row=1, length=2, flip=False):
    left_color,right_color,shelf_color = 2,3,4
    g=np.zeros((10,10),dtype=int)
    for c,top in enumerate(surface):
        if top<10:
            fill = left_color if c<=4 else right_color
            g[top:,c]=fill
    g[shelf_row,0:length]=shelf_color
    if flip:
        g=np.fliplr(g)
    return g
surface=(10,6,5,6,9,7,6,9,9,4)
for flip in [False,True]:
    base=build(surface, shelf_row=1, length=2, flip=flip)
    src=(0,1) if not flip else (0,8)
    alt=(0,9) if not flip else (0,0)
    print('flip',flip)
    for n in [8,10]:
        out=emit(base,src,n)
        ok,bad=stable(out)
        print('n',n,'stable',ok,bad,'src')
        print(out)
        out2=emit(base,alt,n)
        print('same as alt?', np.array_equal(out,out2))
