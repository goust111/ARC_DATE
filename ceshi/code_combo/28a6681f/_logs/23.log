def _component_count(points: set[tuple[int, int]], use_diagonal: bool) -> int:
    remaining = set(points)
    if use_diagonal:
        neighbors = [(dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if (dr, dc) != (0, 0)]
    else:
        neighbors = [(-1, 0), (1, 0), (0, -1), (0, 1)]
    count = 0
    while remaining:
        count += 1
        stack = [remaining.pop()]
        while stack:
            r, c = stack.pop()
            for dr, dc in neighbors:
                nxt = (int(r + dr), int(c + dc))
                if nxt in remaining:
                    remaining.remove(nxt)
                    stack.append(nxt)
    return count


def _slope_direction(g: np.ndarray, rr: int, cc: int, bg: int, water: int) -> int:
    H, W = g.shape
    sr = rr + 1
    if sr >= H:
        return 0
    color = int(g[sr, cc])
    if color in (int(bg), int(water)):
        return 0

    def chain(dc: int) -> int:
        k = 0
        while True:
            r = int(sr + k)
            c = int(cc + dc * k)
            if not (0 <= r < H and 0 <= c < W):
                break
            if int(g[r, c]) != color:
                break
            k += 1
        return int(k)

    left = chain(-1)
    right = chain(1)
    if max(left, right) < 2 or left == right:
        return 0
    return 1 if right > left else -1


def _simulate(
    grid: np.ndarray,
    slope_mode: bool,
    check_input: bool,
    check_output: bool,
    track_metrics: bool = False,
) -> np.ndarray | tuple[np.ndarray, dict[str, int]]:
    g = np.array(grid, dtype=int).copy()
    H, W = g.shape
    bg = 0
    water = 1
    metrics = {"slope_steps": 0, "diag_steps": 0, "horiz_steps": 0, "falls": 0}

    if check_input:
