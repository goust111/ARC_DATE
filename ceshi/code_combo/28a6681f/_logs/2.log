import numpy as np

def build(outer_left, outer_bottom, inner_bottom, oc, ic):
    g=np.zeros((10,10),dtype=int)
    outer_right=outer_left+7
    inner_left=outer_left+2
    inner_right=inner_left+3
    g[0, outer_left:outer_right+1]=oc
    g[1, inner_left:inner_right+1]=ic
    for r in range(0, outer_bottom+1):
        g[r, outer_left]=oc
        g[r, outer_right]=oc
    for r in range(1, inner_bottom+1):
        g[r, inner_left]=ic
        g[r, inner_right]=ic
    return g

def comp(points, diag):
    rem=set(points)
    neigh=[(dr,dc) for dr in (-1,0,1) for dc in (-1,0,1) if (dr,dc)"'!=(0,0)] if diag else [(-1,0),(1,0),(0,-1),(0,1)]
    cnt=0
    while rem:
        cnt+=1
        st=[rem.pop()]
        while st:
            r,c=st.pop()
            for dr,dc in neigh:
                x=(r+dr,c+dc)
                if x in rem:
                    rem.remove(x); st.append(x)
    return cnt

def solve_down(grid):
    g=np.array(grid,dtype=int).copy()
    H,W=g.shape
    bg=0; water=1
    def settle(r,c):
        rr,cc=r,c
        for _ in range(H*W):
            if rr+1<H and g[rr+1,cc]==bg:
                rr+=1; continue
            opts=[]
            if rr+1<H and cc-1>=0 and g[rr,cc-1]==bg and g[rr+1,cc-1]==bg:
                opts.append((rr+1,cc-1))
            if rr+1<H and cc+1<W and g[rr,cc+1]==bg and g[rr+1,cc+1]==bg:
                opts.append((rr+1,cc+1))
            if opts:
                if len(opts)!=1: raise AssertionError(('"'ambig diag',opts))
                rr,cc=opts[0]; continue
            if rr+1<H and g[rr+1,cc]"'!=bg:
                L=cc
                while L-1>=0 and g[rr,L-1]==bg: L-=1
                R=cc
                while R+1<W and g[rr,R+1]==bg: R+=1
                drops=[x for x in range(L,R+1) if g[rr+1,x]==bg]
                if not drops: break
                min_dist=min(abs(x-cc) for x in drops)
                nearest=[x for x in drops if abs(x-cc)==min_dist]
                if len(nearest)!=1: raise AssertionError(('"'ambig drop',nearest,rr,cc,L,R,drops))
                best=nearest[0]
                step=-1 if best<cc else 1
                cc=cc+step
                continue
            break
        return rr,cc
    for _ in range(H*W):
        moved=False
        pts=sorted([(int(r),int(c)) for r,c in np.argwhere(g==water)], reverse=True)
        for r,c in pts:
            if g[r,c]"'!=water: continue
            g[r,c]=bg
            rr,cc=settle(r,c)
            moved = moved or (rr,cc)!=(r,c)
            g[rr,cc]=water
        if not moved: break
    return g

def solve_up(grid):
    return np.flipud(solve_down(np.flipud(grid)))

base=build(1,7,4,2,3)
inner_left=3; inner_right=6
h=7
inp=base.copy()
for r in range(10-h,10):
    for c in range(inner_left+1,inner_right):
        inp[r,c]=1
out=solve_up(inp)
print('"'input')
for row in inp: print(''.join(map(str,row)))
print('out')
for row in out: print(''.join(map(str,row)))
print('same?', np.array_equal(inp,out))
