    65	#    - 反向物理通过上下翻转实现，因此要求结构与水都完全落在单张 10x10 网格内；生成器无越界放置。
    66	
    67	
    68	BG = 0
    69	WATER = 1
    70	
    71	
    72	def _simulate_downward(grid: np.ndarray) -> np.ndarray:
    73	    g = np.array(grid, dtype=int).copy()
    74	    height, width = g.shape
    75	
    76	    def settle(r: int, c: int) -> tuple[int, int]:
    77	        rr = int(r)
    78	        cc = int(c)
    79	        for _ in range(height * width):
    80	            if rr + 1 < height and int(g[rr + 1, cc]) == BG:
    81	                rr += 1
    82	                continue
    83	
    84	            opts: list[tuple[int, int]] = []
    85	            if (
    86	                rr + 1 < height
    87	                and cc - 1 >= 0
    88	                and int(g[rr, cc - 1]) == BG
    89	                and int(g[rr + 1, cc - 1]) == BG
    90	            ):
    91	                opts.append((int(rr + 1), int(cc - 1)))
    92	            if (
    93	                rr + 1 < height
    94	                and cc + 1 < width
    95	                and int(g[rr, cc + 1]) == BG
    96	                and int(g[rr + 1, cc + 1]) == BG
    97	            ):
    98	                opts.append((int(rr + 1), int(cc + 1)))
    99	            if opts:
   100	                assert len(opts) == 1, f"ambiguous diagonal moves: {opts}"
   101	                rr, cc = opts[0]
   102	                continue
   103	
   104	            if rr + 1 < height and int(g[rr + 1, cc]) != BG:
   105	                left = int(cc)
   106	                while left - 1 >= 0 and int(g[rr, left - 1]) == BG:
   107	                    left -= 1
   108	                right = int(cc)
   109	                while right + 1 < width and int(g[rr, right + 1]) == BG:
   110	                    right += 1
   111	
   112	                drops = [int(x) for x in range(int(left), int(right) + 1) if int(g[rr + 1, int(x)]) == BG]
   113	                if not drops:
   114	                    break
   115	
   116	                min_dist = min(abs(int(x - cc)) for x in drops)
   117	                nearest = [int(x) for x in drops if abs(int(x - cc)) == int(min_dist)]
   118	                assert len(nearest) == 1, f"ambiguous nearest drop columns: {nearest}"
   119	                best = nearest[0]
   120	                step = -1 if best < int(cc) else 1
   121	                nx = int(cc + step)
   122	                assert int(g[rr, nx]) == BG
   123	                cc = nx
   124	                continue
   125	
   126	            break
   127	        else:
   128	            raise AssertionError("water pixel did not settle")
   129	        return int(rr), int(cc)
   130	
   131	    for _pass in range(height * width):
   132	        moved = False
   133	        pts = sorted([(int(r), int(c)) for r, c in np.argwhere(g == WATER)], reverse=True)
   134	        for r, c in pts:
   135	            if int(g[r, c]) != WATER:
   136	                continue
   137	            g[r, c] = BG
   138	            rr, cc = settle(int(r), int(c))
   139	            moved = bool(moved or ((int(rr), int(cc)) != (int(r), int(c))))
   140	            g[int(rr), int(cc)] = WATER
   141	        if not moved:
   142	            break
   143	    else:
   144	        raise AssertionError("water simulation did not converge")
   145	
   146	    return g
