   149	def _find_inverted_layout(grid: np.ndarray) -> dict[str, int]:
   150	    solids = grid > 1
   151	    assert solids.shape == (10, 10), "this combo keeps the original 10x10 canvas"
   152	
   153	    outer_cols = [int(c) for c in np.where(solids[0])[0]]
   154	    assert outer_cols, "missing outer roof"
   155	    outer_left = min(outer_cols)
   156	    outer_right = max(outer_cols)
   157	
   158	    inner_cols = [int(c) for c in np.where(solids[1])[0] if outer_left < int(c) < outer_right]
   159	    assert inner_cols, "missing inner roof"
   160	    inner_left = min(inner_cols)
   161	    inner_right = max(inner_cols)
   162	
   163	    outer_rows_left = [int(r) for r in np.where(solids[:, outer_left])[0]]
   164	    outer_rows_right = [int(r) for r in np.where(solids[:, outer_right])[0]]
   165	    inner_rows_left = [int(r) for r in np.where(solids[:, inner_left])[0]]
   166	    inner_rows_right = [int(r) for r in np.where(solids[:, inner_right])[0]]
   167	    assert outer_rows_left and outer_rows_right and inner_rows_left and inner_rows_right
   168	
   169	    return {
   170	        "outer_left": int(outer_left),
   171	        "outer_right": int(outer_right),
   172	        "outer_bottom": int(max(max(outer_rows_left), max(outer_rows_right))),
   173	        "inner_left": int(inner_left),
   174	        "inner_right": int(inner_right),
   175	        "inner_bottom": int(max(max(inner_rows_left), max(inner_rows_right))),
   176	    }
   177	
   178	
   179	def _inner_cells(layout: dict[str, int]) -> list[tuple[int, int]]:
   180	    return [
   181	        (int(r), int(c))
   182	        for r in range(2, int(layout["inner_bottom"]) + 1)
   183	        for c in range(int(layout["inner_left"]) + 1, int(layout["inner_right"]))
   184	    ]
   185	
   186	
   187	def _annulus_cells(layout: dict[str, int]) -> list[tuple[int, int]]:
   188	    outer_left = int(layout["outer_left"])
   189	    outer_right = int(layout["outer_right"])
   190	    inner_left = int(layout["inner_left"])
   191	    inner_right = int(layout["inner_right"])
   192	    inner_bottom = int(layout["inner_bottom"])
   193	    return [
   194	        (int(r), int(c))
   195	        for r in range(1, inner_bottom + 1)
   196	        for c in range(outer_left + 1, outer_right)
   197	        if int(c) < inner_left or int(c) > inner_right
   198	    ]
   199	
   200	
   201	def _fusion_metrics(inp: np.ndarray, out: np.ndarray) -> dict[str, int]:
   202	    layout = _find_inverted_layout(inp)
   203	    inner_cells = _inner_cells(layout)
   204	    annulus_cells = _annulus_cells(layout)
   205	    input_rows = [int(r) for r, _c in np.argwhere(inp == WATER)]
   206	    output_rows = [int(r) for r, _c in np.argwhere(out == WATER)]
   207	    downward_baseline = _simulate_downward(inp)
   208	
   209	    return {
   210	        "water_total": int(np.sum(out == WATER)),
   211	        "inner_fill": int(sum(1 for r, c in inner_cells if int(out[r, c]) == WATER)),
   212	        "inner_capacity": int(len(inner_cells)),
   213	        "annulus_fill": int(sum(1 for r, c in annulus_cells if int(out[r, c]) == WATER)),
   214	        "annulus_capacity": int(len(annulus_cells)),
   215	        "moved": int(np.any(inp != out)),
   216	        "input_bottom_touch": int(max(input_rows) == inp.shape[0] - 1),
   217	        "input_top": int(min(input_rows)),
   218	        "output_top": int(min(output_rows)),
   219	        "differs_from_downward": int(not np.array_equal(out, downward_baseline)),
   220	    }
   221	
   222	
   223	def _build_inverted_nested_basin(
   224	    outer_left: int,
   225	    outer_bottom: int,
   226	    inner_bottom: int,
   227	    outer_color: int,
   228	    inner_color: int,
   229	) -> np.ndarray:
   230	    assert 0 <= outer_left <= 2
   231	    assert inner_bottom in (3, 4)
   232	    assert outer_bottom >= inner_bottom + 2
   233	    grid = np.zeros((10, 10), dtype=int)
   234	
   235	    outer_right = outer_left + 7
   236	    inner_left = outer_left + 2
   237	    inner_right = inner_left + 3
   238	
   239	    for c in range(outer_left, outer_right + 1):
   240	        grid[0, c] = int(outer_color)
   241	    for r in range(0, outer_bottom + 1):
   242	        grid[r, outer_left] = int(outer_color)
   243	        grid[r, outer_right] = int(outer_color)
   244	
   245	    for c in range(inner_left, inner_right + 1):
   246	        grid[1, c] = int(inner_color)
   247	    for r in range(1, inner_bottom + 1):
   248	        grid[r, inner_left] = int(inner_color)
   249	        grid[r, inner_right] = int(inner_color)
   250	
   251	    return grid
   252	
   253	
   254	def _place_bottom_source(grid: np.ndarray) -> np.ndarray:
   255	    g = np.array(grid, dtype=int).copy()
   256	    layout = _find_inverted_layout(g)
   257	    source_cols = [int(layout["inner_left"]) + 1, int(layout["inner_right"]) - 1]
   258	
   259	    # Full inner cup + full outer side annulus gives a clean two-stage target level.
   260	    water_count = int(len(_inner_cells(layout)) + len(_annulus_cells(layout)))

