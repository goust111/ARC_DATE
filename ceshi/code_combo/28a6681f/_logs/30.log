            g[rr,cc]=WATER
        if not moved: break
    return (g,metrics) if collect else g

def build(src_left=4,left_rows=3,right_depth=6,carry=0):
    colors=(2,3,4)
    g=np.zeros((10,10),dtype=int)
    for r in range(3,10):
        for c in range(10):
            g[r,c]=colors[0] if c<=src_left-1 else colors[1] if c<=src_left+1 else colors[2]
    for r in range(0,3):
        g[r,src_left:src_left+2]=WATER
    left_drop=src_left-3; near=src_left+2; far=src_left+3
    for r in range(3,3+left_rows): g[r,left_drop]=BG
    for r in range(3,3+right_depth): g[r,near]=BG; g[r,far]=BG
    chamber=3+left_rows
    g[chamber,left_drop-1]=BG; g[chamber,left_drop+1]=BG
