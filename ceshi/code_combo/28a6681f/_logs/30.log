+        allow_blocked_side_diagonal=True,
+        prefer_farthest_drop=True,
+        tie_break_left=True,
+        check_input=check_input,
+        check_output=check_output,
+        collect_metrics=False,
+    )
+    assert isinstance(result, np.ndarray)
+    return result
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
