+        grid = _build_case(
+            src_left=int(src_left),
+            left_shaft_depth=int(left_shaft_depth),
+            right_shaft_depth=int(right_shaft_depth),
+            colors=(int(colors[0]), int(colors[1]), int(colors[2])),
