                d=min(abs(int(x-cc)) for x in drops)
                cols=[int(x) for x in drops if abs(int(x-cc))==d]
                if len(cols)>1: metrics['horizontal_ties']+=1
                best=min(cols) if left_tie else cols[0]
                if best==cc: break
                cc=cc+(-1 if best<cc else 1)
