            if rr+1<H and int(g[rr+1,cc])==BG:
                rr+=1; continue
            diag_opts=[]
            for dc in (-1,1):
                nc=cc+dc
                if rr+1>=H or not (0<=nc<W):
                    continue
                if int(g[rr+1,nc])"'!=BG:
                    continue
                if not loose_diag and int(g[rr,nc])!=BG:
                    continue
                diag_opts.append((int(rr+1), int(nc), dc, int(g[rr,nc])!=BG))
            if diag_opts:
                if len(diag_opts)>1:
                    metrics['"'diag_ties']+=1
                best=min(diag_opts, key=lambda item: item[1]) if left_tie else diag_opts[0]
                if best[3]:
                    metrics['blocked_side_diagonals']+=1
                rr,cc=best[0],best[1]
                continue
            if rr+1<H and int(g[rr+1,cc])"'!=BG:
                L=cc
                while L-1>=0 and int(g[rr,L-1])==BG:
                    L-=1
                R=cc
                while R+1<W and int(g[rr,R+1])==BG:
                    R+=1
                drops=[int(x) for x in range(L,R+1) if int(g[rr+1,x])==BG]
                if not drops:
                    break
                if prefer_farthest:
                    d=max(abs(int(x-cc)) for x in drops)
                    best_cols=[int(x) for x in drops if abs(int(x-cc))==d]
                    if len(best_cols)>1:
                        metrics['"'horizontal_ties']+=1
                    best=min(best_cols) if left_tie else best_cols[0]
                    if best==cc:
                        break
                    metrics['farthest_slides']+=1
                    cc=best
                    continue
                d=min(abs(int(x-cc)) for x in drops)
                best_cols=[int(x) for x in drops if abs(int(x-cc))==d]
                if len(best_cols)>1:
                    metrics['horizontal_ties']+=1
                best=min(best_cols) if left_tie else best_cols[0]
                if best==cc:
                    break
                cc=cc + (-1 if best<cc else 1)
                continue
            break
        return rr,cc
    for _ in range(H*W):
        moved=False
        for r,c in sorted([(int(r),int(c)) for r,c in np.argwhere(g==WATER)], reverse=True):
            if int(g[r,c])"'!=WATER:
                continue
            g[r,c]=BG
            rr,cc=settle(r,c)
            if (rr,cc)!=(int(r),int(c)):
                moved=True
                metrics['"'moved_pixels']+=1
            g[rr,cc]=WATER
        if not moved:
            break
    if collect:
        return g, metrics
    return g

def build(src_left=4, left_shaft_rows=3, right_depth=6, colors=(2,3,4), carry=0):
    left_color, center_color, right_color = colors
    g=np.zeros((10,10),dtype=int)
    # bottom-anchored colored mass
    for r in range(3,10):
        for c in range(10):
            if c <= src_left - 1:
                g[r,c]=left_color
            elif c <= src_left + 1:
                g[r,c]=center_color
            else:
                g[r,c]=right_color
    # source block
    for r in range(0,3):
        g[r,src_left:src_left+2]=WATER
    left_drop=src_left-3
    near_drop=src_left+2
    far_drop=src_left+3
    for r in range(3, 3+left_shaft_rows):
        g[r,left_drop]=BG
    for r in range(3, 3+right_depth):
        g[r,near_drop]=BG
        g[r,far_drop]=BG
    chamber_row=3+left_shaft_rows
    if chamber_row >= 9:
        return None
    # leave blocker below shaft and open diagonal pockets
    g[chamber_row, left_drop-1] = BG
    g[chamber_row, left_drop+1] = BG
    for r in range(chamber_row+1, 9):
