            opts=[]
            if rr+1<H and cc-1>=0 and g[rr+1,cc-1]==0 and (loose_diag or g[rr,cc-1]==0):
                if loose_diag and g[rr,cc-1]"'!=0: m['"'blocked_diag']+=1
