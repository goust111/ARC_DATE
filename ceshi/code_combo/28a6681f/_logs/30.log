import numpy as np

BG=0; W=1

def sim(grid, *, loose_diag=False, prefer_farthest=False, tie_left=False, collect=False):
    g=np.array(grid,dtype=int).copy(); H,Wd=g.shape
    m={'blocked_diag':0,'diag_ties':0,'horiz_ties':0,'farthest_choices':0,'moved':0}
    def settle(r,c):
        rr,cc=int(r),int(c)
        for _ in range(H*Wd):
            if rr+1<H and int(g[rr+1,cc])==BG:
                rr+=1; continue
            opts=[]
            if rr+1<H and cc-1>=0 and int(g[rr+1,cc-1])==BG and (loose_diag or int(g[rr,cc-1])==BG):
                if loose_diag and int(g[rr,cc-1])"'!=BG: m['"'blocked_diag']+=1
                opts.append((rr+1,cc-1))
            if rr+1<H and cc+1<Wd and int(g[rr+1,cc+1])==BG and (loose_diag or int(g[rr,cc+1])==BG):
                if loose_diag and int(g[rr,cc+1])"'!=BG: m['"'blocked_diag']+=1
                opts.append((rr+1,cc+1))
            if opts:
                if len(opts)>1: m['diag_ties']+=1
                rr,cc=min(opts,key=lambda x:x[1]) if tie_left else opts[0]
                continue
            if rr+1<H and int(g[rr+1,cc])"'!=BG:
                L=cc
                while L-1>=0 and int(g[rr,L-1])==BG: L-=1
                R=cc
                while R+1<Wd and int(g[rr,R+1])==BG: R+=1
                drops=[x for x in range(L,R+1) if int(g[rr+1,x])==BG]
                if not drops: break
                if prefer_farthest:
                    best_dist=max(abs(x-cc) for x in drops)
                    cols=[x for x in drops if abs(x-cc)==best_dist]
                    if len(cols)>1: m['"'horiz_ties']+=1
                    best=min(cols) if tie_left else cols[0]
                    if best"'!=cc:
                        m['"'farthest_choices']+=1
                        cc=best
                        continue
                    break
                else:
                    best_dist=min(abs(x-cc) for x in drops)
                    cols=[x for x in drops if abs(x-cc)==best_dist]
                    if len(cols)>1: m['horiz_ties']+=1
                    best=min(cols) if tie_left else cols[0]
                    if best==cc: break
                    step=-1 if best<cc else 1
                    cc=cc+step
                    continue
            break
        return rr,cc
    for _ in range(H*Wd):
        moved=False
        for r,c in sorted([(int(r),int(c)) for r,c in np.argwhere(g==1)], reverse=True):
            if int(g[r,c])"'!=1: continue
            g[r,c]=0
            rr,cc=settle(r,c)
            if (rr,cc)!=(r,c): moved=True; m['"'moved']+=1
            g[rr,cc]=1
        if not moved: break
    return (g,m) if collect else g

g=np.full((10,10), 2, dtype=int)
g[:3,:]=0
# source
for r in range(0,3):
    g[r,4]=1; g[r,5]=1
# carve shelf row 2 open across 1..8? row2 already water partly, bg elsewhere
# below shelf row 3 solid with mouths at 1,5,7
for c in [1,5,7]:
    g[3,c]=0
# carve left shaft rows 3..5
for r in [3,4,5]: g[r,1]=0
# carve near shaft rows 3..8 at c5
for r in range(3,9): g[r,5]=0
# carve right far shaft rows 3..8 at c7
for r in range(3,9): g[r,7]=0
# left chamber for loose diagonal from (5,1)
# ensure row5 side blockers at 0 and2 remain solid(2)
# below at row6: col1 solid, col0/2 open
for c in [0,2]: g[6,c]=0
# continue left basin col0 to bottom, central side maybe small basin at2
for r in [7,8]: g[r,0]=0
for r in [7,8]: g[r,2]=0
# maybe connect c2 to c3 basin etc
for r in [6,7,8]: g[r,8]=0

print('grid')
for row in g: print(''.join(map(str,row.tolist())))
new, m = sim(g, loose_diag=True, prefer_farthest=True, tie_left=True, collect=True)
old = sim(g, loose_diag=False, prefer_farthest=False, tie_left=False)
print('new metrics',m)
print('new')
for row in new: print(''.join(map(str,row.tolist())))
print('old')
for row in old: print(''.join(map(str,row.tolist())))
print('diff', int((new"'!=old).sum()))
