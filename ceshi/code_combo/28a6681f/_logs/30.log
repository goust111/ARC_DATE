+        if metrics["blocked_side_diagonals"] < 1:
+            continue
+        if metrics["diag_ties"] < 1:
+            continue
+        if metrics["horizontal_ties"] < 1:
+            continue
+        if metrics["farthest_slides"] < 1:
+            continue
+        if metrics["moved_pixels"] < 4:
+            continue
+        if metrics["combo_vs_baseline_diff"] < 4:
