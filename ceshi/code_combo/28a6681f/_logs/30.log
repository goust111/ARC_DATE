        stable=sorted(stable, reverse=True)
        take=stable[:carry]
        # clear some top-left source cells first
        source=[(2,src_left),(1,src_left),(0,src_left),(2,src_left+1),(1,src_left+1),(0,src_left+1)]
        for r,c in source[:carry]: g[r,c]=BG
        for r,c in take: g[r,c]=WATER
    return g

params=[]
for src_left in [4,5]:
