+    if check_output:
+        _validate_output(g)
+
+    if collect_metrics:
+        return g, metrics
+    return g
+
+
+def _build_case(
+    *,
+    src_left: int,
+    left_shaft_depth: int,
+    right_shaft_depth: int,
+    colors: tuple[int, int, int],
+) -> np.ndarray:
+    left_color, center_color, right_color = colors
