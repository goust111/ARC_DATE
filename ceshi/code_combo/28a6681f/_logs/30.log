import numpy as np

def build(src_left,left_shaft_depth,right_shaft_depth,extra_far=1):
    g=np.zeros((10,10),dtype=int)
    for r in range(3,10):
        for c in range(10):
            g[r,c]=2 if c<=src_left-1 else 3 if c<=src_left+1 else 4
    g[:3,src_left:src_left+2]=1
    left_drop=src_left-3; near=src_left+2; far=src_left+3; chamber=3+left_shaft_depth
    for r in range(3,3+left_shaft_depth): g[r,left_drop]=0
    for r in range(3,3+right_shaft_depth): g[r,near]=0; g[r,far]=0
    g[chamber,left_drop-1]=0; g[chamber,left_drop+1]=0
    for r in range(chamber+1,9): g[r,left_drop-1]=0; g[r,left_drop+1]=0
    for r in range(3+right_shaft_depth-extra_far, 3+right_shaft_depth): g[r,far]=1
    return g

def simulate(grid, loose, far, left, collect=False):
    g=np.array(grid,dtype=int).copy(); H,W=g.shape
    m={'blocked':0,'dt':0,'ht':0,'fs':0,'mv':0}
    def settle(r,c):
        rr,cc=r,c
        for _ in range(H*W):
            if rr+1<H and g[rr+1,cc]==0: rr+=1; continue
            opts=[]
            for dc in (-1,1):
                nc=cc+dc
                if rr+1<H and 0<=nc<W and g[rr+1,nc]==0 and (loose or g[rr,nc]==0):
                    opts.append((rr+1,nc,g[rr,nc]"'!=0))
            if opts:
                if len(opts)>1: m['"'dt']+=1
                pick=min(opts,key=lambda x:x[1]) if left else opts[0]
                if pick[2]: m['blocked']+=1
                rr,cc=pick[0],pick[1]; continue
            if rr+1<H and g[rr+1,cc]"'!=0:
                L=cc
                while L-1>=0 and g[rr,L-1]==0: L-=1
                R=cc
                while R+1<W and g[rr,R+1]==0: R+=1
                drops=[x for x in range(L,R+1) if g[rr+1,x]==0]
                if not drops: break
                if far:
                    d=max(abs(x-cc) for x in drops); cols=[x for x in drops if abs(x-cc)==d]
                    if len(cols)>1: m['"'ht']+=1
                    best=min(cols)
                    if best==cc: break
                    cc=best; m['fs']+=1; continue
                d=min(abs(x-cc) for x in drops); cols=[x for x in drops if abs(x-cc)==d]
                best=min(cols)
                if best==cc: break
                cc=cc+(-1 if best<cc else 1); continue
            break
        return rr,cc
    for _ in range(H*W):
        moved=False
        for r,c in sorted([(int(r),int(c)) for r,c in np.argwhere(g==1)], reverse=True):
            if g[r,c]"'!=1: continue
            g[r,c]=0
            rr,cc=settle(r,c)
            if (rr,cc)!=(r,c): moved=True; m['"'mv']+=1
            g[rr,cc]=1
        if not moved: break
    return (g,m) if collect else g

for params in [(4,3,5),(4,3,6),(4,4,5),(4,4,6),(5,3,5),(5,3,6),(5,4,5),(5,4,6)]:
    g=build(*params)
    new,m=simulate(g,True,True,True,True)
    H,W=new.shape
    bad=[]
    for r,c in np.argwhere(new==1):
        if (c"'!=0 and new[r,c-1]==0) or (r!=H-1 and new[r+1,c]==0) or (c!=W-1 and new[r,c+1]==0): bad.append((int(r),int(c)))
    old=simulate(g,False,False,True)
    print(params,'"'bad',bad,'diff',int((new"'!=old).sum()),'"'metrics',m,'water',int((g==1).sum()))
