# Combo variant of 2d0172a1 (index 8)
# combo_spec: D1/0+D12/2
# Name: 多颜色前景对象+输出按类型着色

from __future__ import annotations

import random

import numpy as np

from arc_utils import find_components, get_bg, label_mask, paste


# Design analysis for combo D1/0 + D12/2
# --------------------------------------
# spec grounding:
#   - Keep the original spatial task exactly: rough nested frames/blobs, depth 1-2,
#     frames 1-2, blobs 1-4, optional outside blob, canonical output based only on
#     containment plus sibling row/column order.
#   - The base spec already gives safe size ranges and spacing guarantees, so the
#     fusion should change only color semantics, not geometry construction.
#
# a) Concretization and behavior trace
#   Example trace:
#   - Base input: one rough outer loop and two rough blobs, all one foreground color.
#   - Combo input: the loop is color A, the blobs are color B.
#   - Base solver:
#       1. read the single fg color
#       2. find all fg components together
#       3. use hole-count to split frame vs blob
#       4. emit one-color canonical rectangles/dots
#   - Combo solver:
#       1. read the two non-bg colors
#       2. find components per color-group
#       3. infer which color-group is "frame" because every component in it has a hole,
#          and which is "blob" because every component in it is hole-free
#       4. rebuild the same containment tree and the same canonical geometry
#       5. color canonical frame borders with the frame input color and canonical dots
#          with the blob input color
#   Difference: D1 contributes typed input colors; D12 contributes typed output colors;
#   together they form a single visible rule where type-color identity persists end to end.
#
# b) Complexity calibration
#   - Use exactly two foreground role colors in every sample: one shared by all frames,
#     one shared by all blobs.
#   - Do not introduce per-object recoloring or larger palettes; that would make the
#     mapping underdetermined from 2-4 ARC examples.
#   - Every sample still contains at least one frame and one blob, and often repeats one
#     or both roles, so the type-color association has in-sample support.
#
# c) Hidden assumption audit against the original main()
#   - `assert len(fg_colors) == 1` no longer holds; combo inputs require two fg colors.
#   - `find_components(... colors=[fg])` would miss one role entirely.
#   - The base code assumed boolean canonical masks were enough because all output fg
#     pixels shared one color. That breaks here: we need a transparent color render layer.
#   - `node.is_frame = bool(node_holes)` is still geometrically correct, but the combo
#     rule now also assumes color grouping is meaningful. We therefore infer roles from
#     color groups and assert geometry agrees with that inference.
#   - `out[mask] = fg` is invalid because canonical rectangles and dots use different
#     colors in the output.
#
# d) Placement legality
#   - Reuse the original generator's frame margins, sibling gaps, outside-blob offsets,
#     and grid padding. Those already prevent overlap and keep all objects in bounds.
#   - Color does not affect collision logic, so legality is preserved as long as the
#     geometry generator is unchanged.
#
# e) Visual observability
#   - A solver sees rough loops in one color and rough blobs in another; in the output,
#     clean rectangles keep the loop color and clean dots keep the blob color.
#   - This is inferable from a few examples because the same two role colors repeat on
#     multiple objects and across both input and output.
#
# f) Visual tidiness
#   - The canonical layout is unchanged: one-cell separation, two-cell frame padding,
#     and disjoint placements. The only extra signal is the frame/blob color split.
#   - No same-cell overlays or decorative markers are introduced.
#
# g) Change inferability
#   - The output colors are not arbitrary remaps; they are structurally tied to visible
#     input categories. That avoids the ambiguity of "memorize a palette permutation".
#   - Because both type and color are repeated within a sample, humans can recover the
#     rule without relying on hidden color ids.
#
# h) New solver assumptions and generator contract
#   - Exactly two foreground colors appear.
#   - One foreground color is frame-only and the other is blob-only.
#   - At least one frame and at least one blob are present.
#   - Outside objects, if present, are blobs.
#   The generator enforces all of these assumptions explicitly.


TRANSPARENT = -1


class _Node:
    def __init__(self, coords: np.ndarray, bbox: tuple[int, int, int, int], center: np.ndarray, color: int):
        self.coords = coords
        self.bbox = bbox
        self.center = center
        self.color = color
        self.is_frame = False
        self.parent: _Node | None = None
        self.children: list[_Node] = []
        self.mask: np.ndarray | None = None
        self.render: np.ndarray | None = None
        self.anchor: tuple[int, int] | None = None
        self.axis_map: dict[str, list[tuple[float, int]]] = {"row": [], "col": []}


def _component_holes(shape: tuple[int, int], coords: np.ndarray) -> list[np.ndarray]:
    mask = np.zeros(shape, dtype=bool)
    mask[tuple(coords.T)] = True
    lab, n = label_mask(~mask, connectivity=4)
    boundary = set(lab[0, :]) | set(lab[-1, :]) | set(lab[:, 0]) | set(lab[:, -1])
    return [(lab == k) for k in range(1, n + 1) if k not in boundary]


def _intervals_overlap(a: tuple[int, int], b: tuple[int, int]) -> bool:
    return max(a[0], b[0]) <= min(a[1], b[1])


def _overlay(dst: np.ndarray, src: np.ndarray, top: int, left: int) -> None:
    mask = src != TRANSPARENT
    if not np.any(mask):
        return
    view = dst[top : top + src.shape[0], left : left + src.shape[1]]
    view[mask] = src[mask]


def _build_layout(node: _Node) -> None:
    if node.mask is not None:
        return

    if not node.is_frame:
        node.mask = np.ones((1, 1), dtype=bool)
        node.render = np.array([[node.color]], dtype=int)
        node.anchor = (0, 0)
        node.axis_map = {
            "row": [(float(node.center[0]), 0)],
            "col": [(float(node.center[1]), 0)],
        }
        return

    assert node.children
    child_mask, child_render, _placements, axis_map = _layout_group(node.children)
    h, w = child_mask.shape
    out_mask = np.zeros((h + 4, w + 4), dtype=bool)
    out_render = np.full((h + 4, w + 4), TRANSPARENT, dtype=int)

    out_mask[0, :] = True
    out_mask[-1, :] = True
    out_mask[:, 0] = True
    out_mask[:, -1] = True
    out_mask[2 : 2 + h, 2 : 2 + w] |= child_mask

    out_render[0, :] = node.color
    out_render[-1, :] = node.color
    out_render[:, 0] = node.color
    out_render[:, -1] = node.color
    _overlay(out_render, child_render, 2, 2)

    node.mask = out_mask
    node.render = out_render
    node.anchor = (out_mask.shape[0] // 2, out_mask.shape[1] // 2)
    node.axis_map = {
        "row": [(orig, pos + 2) for orig, pos in axis_map["row"]],
        "col": [(orig, pos + 2) for orig, pos in axis_map["col"]],
    }


def _axis_coordinates(nodes: list[_Node], axis: int) -> dict[_Node, int]:
    items = []
    for node in nodes:
        assert node.mask is not None and node.anchor is not None
        r0, c0, r1, c1 = node.bbox
        interval = (r0, r1) if axis == 0 else (c0, c1)
        mid = (interval[0] + interval[1]) / 2
        items.append((node, interval, mid, node.anchor[axis], node.mask.shape[axis]))

    bands: list[dict] = []
    for item in sorted(items, key=lambda x: x[2]):
        interval = item[1]
        for band in bands:
            if any(_intervals_overlap(interval, other[1]) for other in band["items"]):
                band["items"].append(item)
                band["interval"] = (
                    min(band["interval"][0], interval[0]),
                    max(band["interval"][1], interval[1]),
                )
                break
        else:
            bands.append({"items": [item], "interval": interval})

    coord_by_node: dict[_Node, int] = {}
    coord = 0
    for i, band in enumerate(bands):
        if i:
            prev = bands[i - 1]
            prev_down = max(item[4] - 1 - item[3] for item in prev["items"])
            curr_up = max(item[3] for item in band["items"])
            coord += prev_down + 2 + curr_up
        for item in band["items"]:
            coord_by_node[item[0]] = int(coord)

    return coord_by_node


def _layout_group(
    nodes: list[_Node],
) -> tuple[np.ndarray, np.ndarray, dict[_Node, tuple[int, int]], dict[str, list[tuple[float, int]]]]:
    assert nodes
    for node in nodes:
        _build_layout(node)

    row_coord = _axis_coordinates(nodes, axis=0)
    col_coord = _axis_coordinates(nodes, axis=1)

    min_r = min(row_coord[n] - n.anchor[0] for n in nodes if n.anchor is not None)
    min_c = min(col_coord[n] - n.anchor[1] for n in nodes if n.anchor is not None)
    max_r = max(
        row_coord[n] - n.anchor[0] - min_r + n.mask.shape[0]
        for n in nodes
        if n.anchor is not None and n.mask is not None
    )
    max_c = max(
        col_coord[n] - n.anchor[1] - min_c + n.mask.shape[1]
        for n in nodes
        if n.anchor is not None and n.mask is not None
    )

    out_mask = np.zeros((max_r, max_c), dtype=bool)
    out_render = np.full((max_r, max_c), TRANSPARENT, dtype=int)
    placements: dict[_Node, tuple[int, int]] = {}
    axis_map = {"row": [], "col": []}
    for node in nodes:
        assert node.mask is not None and node.anchor is not None and node.render is not None
        r = row_coord[node] - node.anchor[0] - min_r
        c = col_coord[node] - node.anchor[1] - min_c
        placements[node] = (int(r), int(c))
        out_mask[r : r + node.mask.shape[0], c : c + node.mask.shape[1]] |= node.mask
        _overlay(out_render, node.render, r, c)
        axis_map["row"].append((float(node.center[0]), int(r + node.anchor[0])))
        axis_map["col"].append((float(node.center[1]), int(c + node.anchor[1])))

    return out_mask, out_render, placements, axis_map


def _outside_side(dot: _Node, frame: _Node) -> str:
    r0, c0, r1, c1 = dot.bbox
    fr0, fc0, fr1, fc1 = frame.bbox
    if c0 > fc1:
        return "right"
    if c1 < fc0:
        return "left"
    if r0 > fr1:
        return "bottom"
    if r1 < fr0:
        return "top"


