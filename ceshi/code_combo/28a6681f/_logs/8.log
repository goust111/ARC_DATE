H=W=10; BG=0; WATER=1

def build(widths,tops,dir_,count):
    g=np.zeros((H,W),dtype=int)
    basin_colors=[2,3,4]
    guide=8
    # scaffold
    if dir_==1:
        g[:7,0]=guide
        g[6,0:5]=guide
        source_cols=list(range(1,5))
        order=[(r,c) for r in range(5,-1,-1) for c in source_cols]
    else:
        g[:7,9]=guide
        g[6,5:10]=guide
        source_cols=list(range(5,9))
        order=[(r,c) for r in range(5,-1,-1) for c in range(8,4,-1)]
    for cell in order[:count]:
        g[cell]=WATER
    # basins
    segs=[]; c=0
    for i,w in enumerate(widths):
        segs.append((c,c+w-1)); c+=w
        if i"'!=len(widths)-1: c+=1
    for x in range(W): g[9,x]=basin_colors[x%3]
    gaps=[]
    for i in range(len(segs)-1):
        gap=segs[i][1]+1; gaps.append(gap)
        top=tops[i]
        g[top:9,gap]=basin_colors[i%3]
    return g,segs,gaps

def solve(g):
    out=np.array(g)
    # detect dir
    left=np.any((out[:7,0]!=0)&(out[:7,0]!=1))
    right=np.any((out[:7,-1]!=0)&(out[:7,-1]!=1))
    dir_=1 if left and not right else -1
    water=np.count_nonzero(out==1)
    out[out==1]=0
    open8=[out[8,c] in (0,1) for c in range(W)]
    segs=[]; c=0
    while c<W:
        if open8[c]:
            s=c
            while c+1<W and open8[c+1]: c+=1
            segs.append((s,c))
        c+=1
    gaps=[segs[i][1]+1 for i in range(len(segs)-1)]
    tops=[]
    for gc in gaps:
        t=min(r for r in range(9) if out[r,gc]!=0 and out[r,gc]!=1)
        tops.append(t)
    widths=[b-a+1 for a,b in segs]
    if dir_==-1:
        segs=list(reversed(segs)); widths=list(reversed(widths)); tops=list(reversed(tops))
    rem=water
    fills=[]
    for i,(seg,w) in enumerate(zip(segs,widths)):
        cap=w*((9-tops[i]) if i<len(segs)-1 else 9)
        take=min(rem,cap)
        fills.append((seg,take))
        rem-=take
        if rem==0: break
    for seg,take in fills:
        a,b=seg; w=b-a+1
        rows_full=take//w; part=take%w
        for r in range(8,8-rows_full,-1):
            out[r,a:b+1]=1
        if part:
            r=8-rows_full
            out[r,a:a+part]=1 if dir_==1 else out[r,b-part+1:b+1].fill(1)
    return out

