+BG = 0
+WATER = 1
+GUIDE = 8
+H = 10
+W = 10
+SHELF_ROW = 4
+SOURCE_CAPACITY = 16
+MAX_ATTEMPTS = 600
+STRUCTURE_PALETTE = (2, 3, 4, 5, 6, 7, 9)
+ORTHO_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
