+
+def _ordered_chain(scene: dict[str, object], direction: int) -> tuple[list[tuple[int, int]], list[int]]:
+    basins = list(scene["basins"])  # type: ignore[arg-type]
+    tops = list(scene["partition_tops"])  # type: ignore[arg-type]
+    if direction == 1:
