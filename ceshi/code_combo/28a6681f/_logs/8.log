        r,c=stack.pop()
        if seen[r,c]: continue
        seen[r,c]=True
        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
            rr,cc=r+dr,c+dc
            if 0<=rr<H and 0<=cc<W and solid[rr,cc] and not seen[rr,cc]:
                stack.append((rr,cc))
    return seen

def build(widths,tops,dir_,count):
    g=np.zeros((H,W),dtype=int)
    guide=8; cols=[2,3,4]
    if dir_==1:
        g[:SHELF_ROW+1,0]=guide
        g[SHELF_ROW,0:5]=guide
        order=[(r,c) for r in range(SHELF_ROW-1,-1,-1) for c in range(1,5)]
    else:
        g[:SHELF_ROW+1,9]=guide
        g[SHELF_ROW,5:10]=guide
