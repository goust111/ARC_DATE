import numpy as np, random
H=W=10; BG=0; WATER=1; SHELF_ROW=4; MAX_SOURCE=16

def anchored_mask(g):
    solid=(g"'!=BG)&(g!=WATER)
    seen=np.zeros_like(solid,dtype=bool)
    stack=[(H-1,c) for c in range(W) if solid[H-1,c]]
