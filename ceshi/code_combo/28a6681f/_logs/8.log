    tops=[]
    for i in range(len(segs)-1):
        gc=segs[i][1]+1
        r=8
        while r-1>=0 and anchored[r-1,gc]: r-=1
        tops.append(r)
    return anchored,segs,tops

def solve(g):
    out=np.array(g)
    left=np.any((out[:7,0]!=0)&(out[:7,0]!=1))
    right=np.any((out[:7,-1]!=0)&(out[:7,-1]!=1))
    dir_=1 if left and not right else -1
    water=np.count_nonzero(out==1)
    out[out==1]=0
    anchored,segs,tops=detect(out)
    widths=[b-a+1 for a,b in segs]
    ordered_segs=segs if dir_==1 else list(reversed(segs))
    ordered_widths=widths if dir_==1 else list(reversed(widths))
    ordered_tops=tops if dir_==1 else list(reversed(tops))
    rem=water
    for i,(seg,w) in enumerate(zip(ordered_segs,ordered_widths)):
        cap=w*((9-ordered_tops[i]) if i<len(ordered_segs)-1 else 9)
        take=min(rem,cap)
        rem-=take
        a,b=seg
        full,mod=divmod(take,w)
        for rr in range(8,8-full,-1): out[rr,a:b+1]=1
        if mod:
            rr=8-full
            if dir_==1: out[rr,a:a+mod]=1
            else: out[rr,b-mod+1:b+1]=1
        if rem==0: break
    return out

rng=random.Random(1)
for _ in range(5):
    n=rng.choice([4,5])
    widths=[2,1,1,1,1] if n==5 else [2,2,2,1]
    rng.shuffle(widths)
    tops=[rng.choice([6,7]) for _ in range(n-1)]
    dir_=rng.choice([1,-1])
    ow=widths if dir_==1 else list(reversed(widths))
    ot=tops if dir_==1 else list(reversed(tops))
    caps=[ow[i]*((9-ot[i]) if i<n-1 else 9) for i in range(n)]
    opts=[]
    for reach in range(4,n+1):
        pref=sum(caps[:reach-1]); w=ow[reach-1]; max_rows=(9-ot[reach-1]) if reach<n else min(3,9)
        for rows in range(1,max_rows+1):
            cnt=pref+w*rows
            if cnt<=MAX_SOURCE: opts.append((reach,rows,cnt))
    if not opts: continue
    reach,rows,cnt=rng.choice(opts)
    g=build(widths,tops,dir_,cnt)
    out=solve(g)
    print('"'n',n,'widths',widths,'tops',tops,'dir',dir_,'cnt',cnt)
    print(out)
    print()
