   293	                while right + 1 < W and int(g[rr, right + 1]) == BG:
   294	                    right += 1
   295	                drops = [int(x) for x in range(int(left), int(right) + 1) if int(g[rr + 1, int(x)]) == BG]
   296	                if not drops:
   297	                    break
