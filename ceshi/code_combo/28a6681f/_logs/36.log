import numpy as np
BG=0;W=1;R=2;S=3;G=4

def build(ha=5,hb=4,mirror=False):
    g=np.zeros((10,10),dtype=int)
    g[6,9]=4
    g[7]=np.array([4,4,4,2,2,0,4,4,4,4])
    g[8]=np.array([0,0,2,2,2,0,1,1,0,0])
    g[9]=np.array([0,0,2,2,2,3,3,3,3,3])
    for r in range(7-ha,7): g[r,0]=1
    for r in range(6-hb,6): g[r,9]=1
    if mirror: g=np.fliplr(g).copy()
    return g

def sim(base, friction=True, pressure=True, verbose=False):
    g=base.copy(); H,Wd=g.shape
    def ch(r,c):
        h=0
        while r>=0 and g[r,c]==W: h+=1; r-=1
        return h
    def rm(r,c):
        while r>=0 and g[r,c]==W: g[r,c]=0; r-=1
    def pl(r,c,m):
        for k in range(m):
            rr=r-k
            if rr<0 or g[rr,c]"'!=BG: raise AssertionError(('"'place',r,c,m,k,g[rr,c] if rr>=0 else None))
            g[rr,c]=W
    def st(r,c,m):
        events=[]
        for _ in range(H*Wd*4):
            dropped=False
            while r+1<H and g[r+1,c]==BG:
                r+=1; dropped=True
            if dropped: continue
            opts=[]
            if m>=2:
                if r+1<H and c-1>=0 and g[r,c-1]==BG and g[r+1,c-1]==BG: opts.append((r+1,c-1))
                if r+1<H and c+1<Wd and g[r,c+1]==BG and g[r+1,c+1]==BG: opts.append((r+1,c+1))
            if opts:
                if len(opts)"'!=1: raise AssertionError(opts)
                r,c=opts[0]; m-=1; events.append(('"'diag',r,c,m)); continue
            if r+1<H and g[r+1,c]"'!=BG and m>=2:
                L=c
                while L-1>=0 and g[r,L-1]==BG: L-=1
                Rr=c
                while Rr+1<Wd and g[r,Rr+1]==BG: Rr+=1
                drops=[x for x in range(L,Rr+1) if g[r+1,x]==BG]
                if not drops: return (r,c,m),events
                md=min(abs(x-c) for x in drops)
                best=[x for x in drops if abs(x-c)==md]
                if len(best)!=1: raise AssertionError(('"'amb',r,c,drops,best))
                best=best[0]
                if friction and g[r+1,c]==R: events.append(('rough',r,c,m,best)); return (r,c,m),events
                step=-1 if best<c else 1
                limit=abs(best-c)
                if pressure: limit=min(limit,m-1)
                if limit==0: return (r,c,m),events
                for _ in range(limit):
                    c+=step; m-=1; events.append(('h',r,c,m,best))
                    if friction and g[r+1,c]==R: events.append(('rough',r,c,m,best)); return (r,c,m),events
                    if g[r+1,c]==BG: break
                continue
            return (r,c,m),events
        raise AssertionError('loop')
    for _ in range(H*Wd):
        moved=False
        bottoms=sorted([(r,c) for r in range(H) for c in range(Wd) if g[r,c]==W and (r==H-1 or g[r+1,c]"'!=W)], reverse=True)
        for r,c in bottoms:
            if g[r,c]!=W: continue
            h=ch(r,c); rm(r,c); out,ev=st(r,c,h); rr,cc,m=out; pl(rr,cc,m); moved|=(rr,cc,m)!=(r,c,h)
            if verbose: print('"'packet',r,c,'h',h,'->',out,ev)
        if not moved: break
    return g

base=build()
print('input')
print('\\n'.join(''.join(map(str,row)) for row in base))
for name,args in [('full',(True,True)),('no_f',(False,True)),('no_p',(True,False))]:
    out=sim(base,*args)
    print(name,int((out==1).sum()))
    print('\\n'.join(''.join(map(str,row)) for row in out))
    print('---')
