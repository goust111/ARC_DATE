+                    left -= 1
+                right = int(cc)
+                while right + 1 < W and int(g[rr, right + 1]) == BG:
+                    right += 1
+                drops = [int(x) for x in range(int(left), int(right) + 1) if int(g[rr + 1, int(x)]) == BG]
