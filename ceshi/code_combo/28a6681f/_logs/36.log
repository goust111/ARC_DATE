        if r+1<10 and c+1<10 and g[r,c+1]==0 and g[r+1,c+1]==0: opts.append((r+1,c+1))
        if opts:
            if len(opts)!=1: raise AssertionError(opts)
            r,c=opts[0]
            m-=1; events.append(('"'diag',r,c,m))
            if m<=0: return None,events
            continue
        if r+1<10 and g[r+1,c]"'!=0:
