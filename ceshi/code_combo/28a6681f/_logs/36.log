   226	            "pressure_caps": 0,
   227	            "evaporation_loss": 0,
   228	            "fully_evaporated_packets": 0,
   229	        }
   230	        if collect_metrics
   231	        else None
   232	    )
   233	
   234	    if check_input:
   235	        assert g.shape == (10, 10), "grid must be 10x10"
   236	        assert np.any(g == ROUGH), "input must contain rough supports"
   237	        assert np.any(g == GUIDE), "input must contain guide supports"
   238	        assert np.any(g == SMOOTH), "input must contain a lower smooth basin"
   239	        for r, c in np.argwhere(g == WATER):
   240	            rr = int(r)
   241	            cc = int(c)
   242	            assert rr == H - 1 or int(g[rr + 1, cc]) != BG, "input water must be supported"
   243	            left_bg = cc > 0 and int(g[rr, cc - 1]) == BG
   244	            right_bg = cc + 1 < W and int(g[rr, cc + 1]) == BG
   245	            assert not (left_bg and right_bg), "input water cannot have bg on both horizontal sides"
   246	
   247	    def bump(key: str, amount: int = 1) -> None:
   248	        if metrics is not None:
   249	            metrics[key] += int(amount)
   250	
   251	    def settle_packet(r: int, c: int, height: int) -> tuple[int, int, int] | None:
   252	        rr = int(r)
   253	        cc = int(c)
   254	        mass = int(height)
   255	
   256	        for _ in range(H * W * 4):
   257	            fell = False
   258	            while rr + 1 < H and int(g[rr + 1, cc]) == BG:
   259	                rr += 1
   260	                fell = True
   261	            if fell:
   262	                continue
   263	
   264	            opts: list[tuple[int, int]] = []
   265	            if mass >= 2:
   266	                if (
   267	                    rr + 1 < H
   268	                    and cc - 1 >= 0
   269	                    and int(g[rr, cc - 1]) == BG
   270	                    and int(g[rr + 1, cc - 1]) == BG
   271	                ):
   272	                    opts.append((int(rr + 1), int(cc - 1)))
   273	                if (
   274	                    rr + 1 < H
   275	                    and cc + 1 < W
   276	                    and int(g[rr, cc + 1]) == BG
   277	                    and int(g[rr + 1, cc + 1]) == BG
