+                best = int(nearest[0])
+
+                if friction_enabled and int(g[rr + 1, cc]) == ROUGH:
+                    bump("rough_stops")
+                    break
+
+                step = -1 if best < int(cc) else 1
+                if pressure_enabled:
+                    if min_dist > int(mass - 1):
+                        bump("pressure_caps")
