def build(profile, mirror=False):
    g=np.zeros((10,10),dtype=int)
    g[7]=np.array([4,4,2,2,2,0,0,0,0,0])
    g[8]=np.array([0,0,2,2,2,0,0,0,0,0])
    g[9]=np.array([0,0,2,2,2,3,3,3,3,3])
