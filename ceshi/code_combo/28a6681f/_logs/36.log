   299	                min_dist = min(abs(int(x - cc)) for x in drops)
   300	                nearest = [int(x) for x in drops if abs(int(x - cc)) == int(min_dist)]
   301	                assert len(nearest) == 1, f"ambiguous nearest drop columns: {nearest}"
