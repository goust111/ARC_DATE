            Rr=c
            while Rr+1<10 and g[r,Rr+1]==0: Rr+=1
            drops=[x for x in range(L,Rr+1) if g[r+1,x]==0]
            if not drops: return (r,c,m),events
            best=min(drops,key=lambda x:(abs(x-c),x))
            if abs(best-c)==0: return (r,c,m),events
            step=-1 if best<c else 1
            support=g[r+1,c]
            if support==R:
                events.append(('"'rough_stop',r,c,m))
                return (r,c,m),events
            while c"'!=best and m>0:
                nx=c+step
                if g[r,nx]!=0:
                    return (r,c,m),events
                c=nx; m-=1; events.append(('"'h',r,c,m))
                if m<=0: return None,events
                if g[r+1,c]==R:
                    events.append(('rough_stop',r,c,m))
                    return (r,c,m),events
                if g[r+1,c]==0:
                    break
            continue
        return (r,c,m),events
    raise RuntimeError

def sim(grid):
    g=grid.copy()
    for p in range(20):
        moved=False
        bottoms=sorted([(r,c) for r in range(10) for c in range(10) if g[r,c]==1 and (r==9 or g[r+1,c]"'!=1)], reverse=True)
        for r,c in bottoms:
            if g[r,c]!=1: continue
            h=col_height(g,r,c)
            remove_col(g,r,c)
