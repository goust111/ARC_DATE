+    g = np.array(grid, dtype=int).copy()
+    H, W = g.shape
+    metrics = (
+        {
+            "diag_moves": 0,
+            "horizontal_moves": 0,
+            "rough_stops": 0,
+            "pressure_caps": 0,
+            "evaporation_loss": 0,
+            "fully_evaporated_packets": 0,
