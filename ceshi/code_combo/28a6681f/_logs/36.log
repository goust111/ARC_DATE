            if out is not None:
                rr,cc,m=out
                place(g,rr,cc,m)
                if (rr,cc,m)!=(r,c,h): moved=True
            else:
                moved=True
        if not moved: break
    return g

profiles=[[4,6,3,2,2],[5,7,4,3,2],[3,6,4,2,3],[4,7,3,3,2],[6,7,4,3,2]]
for prof in profiles:
    g=build(prof,False)
    out=sim(g)
    print('"'profile',prof,'in',int((g==1).sum()),'out',int((out==1).sum()))
    print('\\n'.join(''.join(map(str,row)) for row in out))
    print()
