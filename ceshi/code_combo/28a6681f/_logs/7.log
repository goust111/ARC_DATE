   332	def _full_span_options(base: np.ndarray) -> list[tuple[int, int]]:
   333	    runs = _find_basin_runs(base, 0, 1)
   334	    assert len(runs) == 3, "generator expects three basins"
   335	    thresholds = [_separator_threshold(base, runs[i], runs[i + 1], 0, 1) for i in range(2)]
