   361	def _make_input(base: np.ndarray, source_run: tuple[int, int], water_count: int) -> np.ndarray:
   362	    inp = np.array(base, dtype=int).copy()
   363	    source_slots: list[tuple[int, int]] = []
   364	    for r in range(8, -1, -1):
