   374	def _variant_visible(base: np.ndarray, output: np.ndarray) -> bool:
   375	    runs = _find_basin_runs(base, 0, 1)
   376	    thresholds = [_separator_threshold(base, runs[i], runs[i + 1], 0, 1) for i in range(2)]
   377	    tops = [_water_top_in_run(output, run) for run in runs]
