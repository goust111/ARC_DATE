+TEMPLATE_SPECS: tuple[dict[str, object], ...] = (
+    {
+        "size": 15,
+        "left": 0,
+        "widths": (1, 2, 1, 1),
+        "heights": (4, 3, 5),
+        "source_basin": 1,
+        "source_height_options": (10,),
+        "source_width": 2,
+    },
+    {
+        "size": 20,
+        "left": 2,
+        "widths": (2, 2, 2, 2),
+        "heights": (2, 2, 5),
+        "source_basin": 1,
+        "source_height_options": (15, 16),
+        "source_width": 2,
