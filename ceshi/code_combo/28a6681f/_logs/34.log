import numpy as np
BG=0; W=1; S=2

def infer_dir(g):
    solids=(g"'!=0)&(g!=1)
    h,w=g.shape
    mask=np.zeros_like(solids,dtype=bool)
    seen=set()
    for r,c in np.argwhere(solids):
        start=(int(r),int(c))
        if start in seen: continue
        stack=[start]; seen.add(start); comp=[]
        while stack:
            rr,cc=stack.pop(); comp.append((rr,cc))
            for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
                nr,nc=rr+dr,cc+dc
                if 0<=nr<h and 0<=nc<w and solids[nr,nc] and (nr,nc) not in seen:
                    seen.add((nr,nc)); stack.append((nr,nc))
        if any(r0==h-1 for r0,_ in comp):
            for p in comp: mask[p]=True
    pts=np.argwhere(mask)
    basin_center=(pts[:,1].min()+pts[:,1].max())/2
    waters=np.argwhere(g==1)
    water_center=(waters[:,1].min()+waters[:,1].max())/2
    return 1 if water_center<basin_center else -1, basin_center, water_center

def simulate(grid, dirsign=None):
    g=grid.copy(); H,Wd=g.shape
    def settle(r,c):
        rr,cc=r,c
        for _ in range(H*Wd):
            if rr+1<H and g[rr+1,cc]==BG:
                rr+=1; continue
            opts=[]
