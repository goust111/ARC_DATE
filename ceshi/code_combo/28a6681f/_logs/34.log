import numpy as np, itertools
BG=0; W=1; S=2

def simulate(grid, dirsign=None):
    g=grid.copy(); H,Wd=g.shape
    def settle(r,c):
        rr,cc=r,c
        for _ in range(H*Wd):
            if rr+1<H and g[rr+1,cc]==BG:
                rr+=1; continue
            opts=[]
            if rr+1<H and cc-1>=0 and g[rr,cc-1]==BG and g[rr+1,cc-1]==BG: opts.append((rr+1,cc-1))
            if rr+1<H and cc+1<Wd and g[rr,cc+1]==BG and g[rr+1,cc+1]==BG: opts.append((rr+1,cc+1))
            if opts:
                if len(opts)"'!=1: raise AssertionError(('"'diag',opts,(rr,cc)))
                rr,cc=opts[0]; continue
            if rr+1<H and g[rr+1,cc]"'!=BG:
                L=cc
                while L-1>=0 and g[rr,L-1]==BG: L-=1
                R=cc
                while R+1<Wd and g[rr,R+1]==BG: R+=1
                drops=[x for x in range(L,R+1) if g[rr+1,x]==BG]
                if dirsign is not None:
                    drops=[x for x in drops if (x-cc)*dirsign>0]
                if not drops: break
                md=min(abs(x-cc) for x in drops)
                near=[x for x in drops if abs(x-cc)==md]
                if len(near)!=1: raise AssertionError(('"'horiz',near,(rr,cc),drops))
                best=near[0]; cc += -1 if best<cc else 1; continue
            break
        return rr,cc
    for _ in range(H*Wd):
        moved=False
        for r,c in sorted(map(tuple,np.argwhere(g==W)), reverse=True):
            if g[r,c]"'!=W: continue
            g[r,c]=BG
            rr,cc=settle(r,c)
            moved|=(rr,cc)!=(r,c)
            g[rr,cc]=W
        if not moved: return g
    raise AssertionError('"'no converge')

def build(size=20,left=1,widths=(2,1,2,1,2),heights=(2,2,5,2),src=2,sh=15,sw=2):
    g=np.zeros((size,size),dtype=int)
    floor=size-1
    wall_cols=[left]
    x=left
    for w in widths:
        x += w+1; wall_cols.append(x)
    if wall_cols[-1]>=size-1: return None,None
    outer=10
    hs=[outer]+list(heights)+[outer]
    g[floor,wall_cols[0]:wall_cols[-1]+1]=S
    for c,h in zip(wall_cols,hs):
        g[max(0,floor-h+1):floor+1,c]=S
    start=wall_cols[src]+1
    end=wall_cols[src+1]
    if sw > end-start: return None,None
    g[max(0,floor-sh):floor-1,start:start+sw]=W
    return g,wall_cols

cands=[]
for left in (0,1,2,3):
  for widths in [
      (2,1,2,1,2),
      (1,2,1,2,1),
      (2,2,1,2,1),
      (2,1,1,2,2),
      (1,2,2,1,2),
      (2,2,2,1,1),
  ]:
    for heights in itertools.product((2,3,4,5), repeat=4):
      for src in (1,2,3):
        sw=min(2,widths[src])
        if sw==0: continue
        g,cols=build(left=left,widths=widths,heights=heights,src=src,sh=15,sw=sw)
        if g is None: continue
        try:
          a=simulate(g,1); b=simulate(g,None)
        except Exception:
          continue
        occA=[int(np.any(a[:,cols[i]+1:cols[i+1]]==1)) for i in range(len(cols)-1)]
        occB=[int(np.any(b[:,cols[i]+1:cols[i+1]]==1)) for i in range(len(cols)-1)]
        gap=int(np.count_nonzero(a"'!=b))
        span=cols[-1]-cols[0]
        if sum(occA)>=5 and gap>=4 and occB[-1]==0:
          cands.append((span,left,widths,heights,src,gap,occA,occB,np.count_nonzero(g==1)))

cands.sort(reverse=True)
print('"'count',len(cands))
for item in cands[:20]:
    print(item)
