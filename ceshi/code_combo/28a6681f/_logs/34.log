+BG = 0
+WATER = 1
+SOLID_POOL = (2, 3, 4, 5, 6, 7, 8, 9)
+SIZE_OPTIONS = (15, 20)
+MAX_GENERATION_ATTEMPTS = 300
+
+TEMPLATE_SPECS: tuple[dict[str, object], ...] = (
+    {
+        "size": 15,
+        "left": 1,
+        "widths": (1, 2, 1, 1),
+        "heights": (5, 5, 5),
+        "source_basin": 1,
+        "source_height_options": (10, 11),
+        "source_width": 2,
+    },
+    {
+        "size": 20,
+        "left": 2,
+        "widths": (2, 2, 2, 2),
+        "heights": (2, 2, 5),
+        "source_basin": 1,
+        "source_height_options": (15, 16),
+        "source_width": 2,
+    },
+    {
+        "size": 20,
+        "left": 3,
+        "widths": (2, 2, 2, 1, 1),
+        "heights": (5, 5, 5, 5),
+        "source_basin": 1,
+        "source_height_options": (15,),
+        "source_width": 2,
+    },
+)
