+        "size": 20,
+        "left": 3,
+        "widths": (2, 2, 2, 1, 1),
+        "heights": (5, 5, 5, 5),
+        "source_basin": 1,
+        "source_height_options": (15,),
+        "source_width": 2,
+    },
