+def _occupied_basin_count(grid: np.ndarray) -> int:
+    walls = _wall_columns(grid)
+    occupied = 0
+    for left, right in zip(walls, walls[1:]):
+        if np.any(grid[:, int(left) + 1 : int(right)] == int(WATER)):
