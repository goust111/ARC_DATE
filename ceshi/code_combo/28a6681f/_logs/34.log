+
+
+def _build_template(spec: dict[str, object], rng: random.Random) -> np.ndarray:
+    size = int(spec["size"])
+    left = int(spec["left"])
+    widths = tuple(int(x) for x in spec["widths"])
+    heights = tuple(int(x) for x in spec["heights"])
