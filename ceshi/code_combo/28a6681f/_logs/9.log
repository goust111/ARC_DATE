+# combo_spec: D10/1+D22/2
+# Name: 多guide+多水源汇聚
+
+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+# Design analysis
+# ---------------
+# spec:
+#   concretization:
+#     The local water physics stays the same as the original task, but the admissible input family is narrowed to a
