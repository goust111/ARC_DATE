+
+def _validate_variant_input(grid: np.ndarray) -> tuple[list[dict[str, object]], list[dict[str, object]]]:
+    g = np.array(grid, dtype=int)
+    guides = _extract_guides(g)
+    sources = _extract_sources(g, guides)
+    return guides, sources
