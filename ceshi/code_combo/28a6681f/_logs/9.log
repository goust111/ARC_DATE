+BG = 0
+WATER = 1
+H = 10
+W = 10
+PALETTE = (2, 3, 4, 5, 6, 7, 8, 9)
+
+
+ONE_BASIN_TEMPLATE: tuple[str, ...] = (
+    "0000660000",
+    "4400160055",
+    "0440660550",
+    "0041001500",
+    "0044005500",
+    "0000000000",
+    "0000000000",
+    "0020002000",
+    "0020002000",
+    "0022222000",
+)
+
+TWO_BASIN_TEMPLATE: tuple[str, ...] = (
+    "0000660000",
+    "4400160055",
+    "0440660550",
+    "0041000150",
+    "0044000550",
+    "0000000000",
+    "0000000000",
+    "0020020300",
+    "0020020300",
+    "0022223300",
+)
+
+BASE_TEMPLATES: tuple[tuple[str, ...], ...] = (ONE_BASIN_TEMPLATE, TWO_BASIN_TEMPLATE)
