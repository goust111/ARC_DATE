+            opts: list[tuple[int, int]] = []
+            if (
+                rr + 1 < H
+                and cc - 1 >= 0
+                and int(g[rr, cc - 1]) == int(BG)
+                and int(g[rr + 1, cc - 1]) == int(BG)
+            ):
+                opts.append((int(rr + 1), int(cc - 1)))
+            if (
+                rr + 1 < H
+                and cc + 1 < W
+                and int(g[rr, cc + 1]) == int(BG)
+                and int(g[rr + 1, cc + 1]) == int(BG)
+            ):
+                opts.append((int(rr + 1), int(cc + 1)))
+            if opts:
+                assert len(opts) == 1, f"ambiguous diagonal moves: {opts}"
+                rr, cc = opts[0]
+                continue
+
+            if rr + 1 < H and int(g[rr + 1, cc]) != int(BG):
