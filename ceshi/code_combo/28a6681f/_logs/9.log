+
+TWO_BASIN_TEMPLATE: tuple[str, ...] = (
+    "0000660000",
+    "4400160055",
+    "0440660550",
+    "0041000150",
+    "0044000550",
+    "0000000000",
+    "0000000000",
+    "0020020300",
+    "0020020300",
+    "0022223300",
