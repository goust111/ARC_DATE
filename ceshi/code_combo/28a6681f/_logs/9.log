        if metrics["open_side_sources"] < 1:
            continue
        if metrics["single_only_cells"] < 1 or metrics["iterative_only_cells"] < 1:
            continue
        return candidate
    raise AssertionError("failed to generate a non-degenerate D12/2+D15/2 sample")

