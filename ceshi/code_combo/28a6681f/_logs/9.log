+ONE_BASIN_TEMPLATE: tuple[str, ...] = (
+    "0000660000",
+    "4400160055",
+    "0440660550",
+    "0041001500",
+    "0044005500",
+    "0000000000",
+    "0000000000",
+    "0020000200",
+    "0020000200",
+    "0022222200",
