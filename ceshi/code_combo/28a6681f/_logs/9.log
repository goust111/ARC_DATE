+
+def _components_from_mask(mask: np.ndarray) -> list[set[tuple[int, int]]]:
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[set[tuple[int, int]]] = []
+    for r, c in np.argwhere(mask):
+        rr = int(r)
