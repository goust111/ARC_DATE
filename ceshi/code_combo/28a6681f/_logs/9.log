import numpy as np

def simulate(grid):
    g=np.array(grid,dtype=int).copy(); H,W=g.shape; bg=0; water=1
    def settle(r,c):
        rr,cc=r,c
        for _ in range(H*W):
            if rr+1<H and g[rr+1,cc]==bg:
                rr+=1; continue
            opts=[]
            if rr+1<H and cc-1>=0 and g[rr,cc-1]==bg and g[rr+1,cc-1]==bg:
                opts.append((rr+1,cc-1))
            if rr+1<H and cc+1<W and g[rr,cc+1]==bg and g[rr+1,cc+1]==bg:
                opts.append((rr+1,cc+1))
            if opts:
                if len(opts)"'!=1:
                    raise Exception(f'"'ambig diag {opts} from {(r,c)} now {(rr,cc)}')
                rr,cc=opts[0]; continue
            if rr+1<H and g[rr+1,cc]"'!=bg:
                L=cc
                while L-1>=0 and g[rr,L-1]==bg: L-=1
                R=cc
                while R+1<W and g[rr,R+1]==bg: R+=1
                drops=[x for x in range(L,R+1) if g[rr+1,x]==bg]
                if not drops: break
                md=min(abs(x-cc) for x in drops)
                nearest=[x for x in drops if abs(x-cc)==md]
                if len(nearest)!=1:
                    raise Exception(f'"'ambig horiz {nearest} from {(r,c)} now {(rr,cc)}')
                best=nearest[0]
                step=-1 if best<cc else 1
                nx=cc+step
                if g[rr,nx]"'!=bg: raise Exception('"'blocked horiz')
                cc=nx; continue
            break
        return rr,cc
    for _ in range(H*W):
        moved=False
        pts=sorted([(int(r),int(c)) for r,c in np.argwhere(g==water)], reverse=True)
        for r,c in pts:
            if g[r,c]"'!=water: continue
            g[r,c]=bg
            rr,cc=settle(r,c)
            moved|=((rr,cc)!=(r,c))
            g[rr,cc]=water
        if not moved: return g
    raise Exception('"'no converge')

g=np.zeros((10,10),dtype=int)
for c in range(2,8): g[9,c]=2
for r in range(7,9): g[r,2]=2; g[r,7]=2
