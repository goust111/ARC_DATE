+    if metrics["edge_count"] != 3:
+        return None
+    if metrics["source_count"] != 3:
+        return None
+    if metrics["occupied_basin_count"] not in (1, 2):
+        return None
+    if metrics["merged_source_count"] < 2:
+        return None
+    if metrics["merge_profile"] not in ((3,), (2, 1)):
+        return None
+    return candidate
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(200):
