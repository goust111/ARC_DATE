   307	            g[int(r), int(c)] = int(BG)
   308	            rr, cc = settle(int(r), int(c))
   309	            moved = bool(moved or ((int(rr), int(cc)) != (int(r), int(c))))
   310	            g[int(rr), int(cc)] = int(WATER)
   311	        if not moved:
   312	            break
   313	    else:
   314	        raise AssertionError("legacy water simulation did not converge")
   315	
   316	    if check_output:
   317	        for r, c in np.argwhere(g == int(WATER)):
   318	            rr = int(r)
   319	            cc = int(c)
   320	            assert cc == 0 or int(g[rr, cc - 1]) != int(BG)
   321	            assert rr == H - 1 or int(g[rr + 1, cc]) != int(BG)
   322	            assert cc == W - 1 or int(g[rr, cc + 1]) != int(BG)
   323	
   324	    return g
   325	
   326	
   327	def _basin_counts(grid: np.ndarray) -> tuple[int, int]:
   328	    walls = [int(c) for c in range(W) if int(grid[H - 1, c]) not in (int(BG), int(WATER))]
   329	    assert walls in ([1, 4, 7], [2, 5, 8]), f"unexpected wall columns: {walls}"
   330	    counts = [int(np.sum(grid[:, int(left) + 1 : int(right)] == int(WATER))) for left, right in zip(walls, walls[1:])]
   331	    assert len(counts) == 2
   332	    return int(counts[0]), int(counts[1])
   333	
   334	
   335	def _active_basin_count(counts: tuple[int, int]) -> int:
   336	    return int(sum(int(x > 0) for x in counts))
   337	
   338	
   339	def _draw_case(
   340	    rng: random.Random,
   341	    source_side: str,
   342	    outer_top_left: int,
   343	    outer_top_right: int,
   344	    water_count: int,
   345	) -> np.ndarray:
   346	    wall_cols = _wall_columns(source_side)
   347	    wall_tops = (int(outer_top_left), int(MIDDLE_TOP), int(outer_top_right))
   348	    outer_color, middle_color, shelf_color = rng.sample(list(SOLID_POOL), 3)
   349	
   350	    g = np.zeros((H, W), dtype=int)
   351	    wall_colors = (int(outer_color), int(middle_color), int(outer_color))
   352	    for c, top, color in zip(wall_cols, wall_tops, wall_colors):
   353	        g[int(top) :, int(c)] = int(color)
   354	
   355	    for c in _source_columns(source_side):
   356	        g[int(SHELF_ROW), int(c)] = int(shelf_color)
   357	
   358	    cells = _source_cells(source_side)
   359	    assert 1 <= int(water_count) <= len(cells)
   360	    for r, c in cells[: int(water_count)]:
   361	        assert int(g[int(r), int(c)]) == int(BG)
   362	        g[int(r), int(c)] = int(WATER)
   363	
   364	    return g
   365	
   366	
   367	def main(grid: np.ndarray, check_input: bool = True, check_output: bool = True) -> np.ndarray:
   368	    """
   369	    Simulate basin-filling water with row-synchronous global rounds instead of letting each pixel settle to completion on its own.
   370	
   371	    Input structure:
   372	    - Background is 0 and moving water is color 1.
   373	    - Other colors are rigid obstacles: bottom-anchored basin walls plus an upper support shelf for the source water.
   374	    - Water starts in supported edge reservoirs above the basin chain; it is not already settled inside the lower basins.
   375	
   376	    Rule:
   377	    - Repeat global rounds until no water moves.
   378	    - Each round has three ordered phases: one-cell downward motion, then one-cell diagonal slipping, then one-cell supported horizontal sliding toward a unique reachable drop.
   379	    - Inside each phase, collect the water pixels currently present in that phase, process rows from top to bottom, and move all pixels from the same row simultaneously; if two same-row pixels claim the same destination, neither one moves there in that phase.
   380	    - Because higher rows act first in each phase and the grid is updated between rows, upper water can occupy or block cells before lower water gets its turn.
   381	
   382	    Key insight:
   383	    - The fusion is not just “top-down” or just “global” in isolation. Water now evolves as layered fronts: every round updates many pixels together, but the update itself has a visible row priority, which changes when overflow into the neighboring basin begins.
   384	    """
   385	    g = np.array(grid, dtype=int).copy()
   386	    assert g.shape == (H, W), f"expected a {H}x{W} grid"
   387	
   388	    if check_input:
   389	        for r, c in np.argwhere(g == int(WATER)):
   390	            rr = int(r)
   391	            cc = int(c)
   392	            assert rr == H - 1 or int(g[rr + 1, cc]) != int(BG), "input water must be supported"
   393	            left_bg = cc > 0 and int(g[rr, cc - 1]) == int(BG)
   394	            right_bg = cc + 1 < W and int(g[rr, cc + 1]) == int(BG)
   395	            assert not (left_bg and right_bg), "input water cannot have bg on both horizontal sides"
   396	
   397	    structure = np.array(g, dtype=int).copy()
   398	    structure[structure == int(WATER)] = int(BG)
   399	    input_water = int(np.count_nonzero(g == int(WATER)))
   400	
   401	    for _round in range(H * W * 4):
   402	        g, moved = _run_round(g)
   403	        if not moved:
   404	            break
   405	    else:
   406	        raise AssertionError("fused water simulation did not converge")
   407	
   408	    if check_output:
   409	        out_structure = np.array(g, dtype=int).copy()
   410	        out_structure[out_structure == int(WATER)] = int(BG)
   411	        assert np.array_equal(out_structure, structure), "structure pixels must stay unchanged"
   412	        assert int(np.count_nonzero(g == int(WATER))) == int(input_water), "water count must be conserved"
   413	        _probe, probe_moved = _run_round(g)
   414	        assert not probe_moved, "output must be a fused-simulation fixed point"
   415	
   416	    return g
   417	
   418	
   419	def generate_input(rng: random.Random | None = None) -> np.ndarray:
   420	    rng = rng or random.Random()

