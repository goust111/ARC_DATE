/bin/bash -lc "python - <<'PY'
import numpy as np
BG=0; WATER=1
H=W=10
SAFE_LAYOUTS = (
    ((1,4,7),(4,6,4)),
    ((1,4,7),(4,7,4)),
    ((1,4,7),(5,7,5)),
    ((1,4,7),(4,6,5)),
    ((1,4,7),(5,6,4)),
    ((1,4,7),(4,7,5)),
    ((2,5,8),(4,6,4)),
    ((2,5,8),(4,7,4)),
    ((2,5,8),(5,7,5)),
    ((2,5,8),(4,6,5)),
    ((2,5,8),(5,6,4)),
    ((2,5,8),(4,7,5)),
)

def orig(grid):
    g=np.array(grid,int).copy(); H,W=g.shape
    def settle(r,c):
        rr,cc=r,c
        for _ in range(H*W):
            if rr+1<H and g[rr+1,cc]==BG: rr+=1; continue
            opts=[]
            if rr+1<H and cc-1>=0 and g[rr,cc-1]==BG and g[rr+1,cc-1]==BG: opts.append((rr+1,cc-1))
            if rr+1<H and cc+1<W and g[rr,cc+1]==BG and g[rr+1,cc+1]==BG: opts.append((rr+1,cc+1))
            if opts:
                if len(opts)"'!=1: raise AssertionError
                rr,cc=opts[0]; continue
            if rr+1<H and g[rr+1,cc]!=BG:
                L=cc
                while L-1>=0 and g[rr,L-1]==BG: L-=1
                R=cc
                while R+1<W and g[rr,R+1]==BG: R+=1
                drops=[x for x in range(L,R+1) if g[rr+1,x]==BG]
                if not drops: break
                md=min(abs(x-cc) for x in drops)
                nearest=[x for x in drops if abs(x-cc)==md]
                if len(nearest)!=1: raise AssertionError
                best=nearest[0]
                if best==cc: raise AssertionError
                cc += -1 if best<cc else 1
                continue
            break
        return rr,cc
    for _ in range(H*W):
        moved=False
        pts=sorted([(int(r),int(c)) for r,c in np.argwhere(g==WATER)], reverse=True)
        for r,c in pts:
            if g[r,c]!=WATER: continue
            g[r,c]=BG
            rr,cc=settle(r,c)
            moved|=(rr,cc)!=(r,c)
            g[rr,cc]=WATER
        if not moved: return g
    raise AssertionError

def phase_target(g,r,c,phase):
    H,W=g.shape
    if phase=='"'down':
        if r+1<H and g[r+1,c]==BG: return (r+1,c)
        return None
    if phase=='diag':
        if r+1>=H or g[r+1,c]==BG: return None
        opts=[]
        if c-1>=0 and g[r,c-1]==BG and g[r+1,c-1]==BG: opts.append((r+1,c-1))
        if c+1<W and g[r,c+1]==BG and g[r+1,c+1]==BG: opts.append((r+1,c+1))
        return opts[0] if len(opts)==1 else None
    if phase=='horiz':
        if r+1>=H or g[r+1,c]==BG: return None
        L=c
        while L-1>=0 and g[r,L-1]==BG: L-=1
        R=c
        while R+1<W and g[r,R+1]==BG: R+=1
        drops=[x for x in range(L,R+1) if g[r+1,x]==BG]
        if not drops: return None
        md=min(abs(x-c) for x in drops)
        nearest=[x for x in drops if abs(x-c)==md]
        if len(nearest)"'!=1: return None
        best=nearest[0]
        if best==c: return None
        step=-1 if best<c else 1
        if g[r,c+step]!=BG: return None
        return (r,c+step)

def fused(grid):
    g=np.array(grid,int).copy(); H,W=g.shape
    for _ in range(H*W*4):
        moved=False
        for phase in ('"'down','diag','horiz'):
            groups={r:[] for r in range(H)}
            for r,c in np.argwhere(g==WATER): groups[int(r)].append((int(r),int(c)))
            for r in range(H):
                coords=groups[r]
                if not coords: continue
                snap=g.copy()
                rev={}
                for rr,cc in coords:
                    tgt=phase_target(snap,rr,cc,phase)
                    if tgt is not None: rev.setdefault(tgt,[]).append((rr,cc))
                valid=[(srcs[0],tgt) for tgt,srcs in rev.items() if len(srcs)==1]
                if valid:
                    moved=True
                    for src,_ in valid: g[src]=BG
                    for _,tgt in valid: g[tgt]=WATER
        if not moved: return g
    raise AssertionError

def make(side, walls, tops, shelf_row, shelf_w, water_count):
    g=np.zeros((H,W),int)
    cols=(3,5,7)
    for i,(c,top) in enumerate(zip(walls,tops)): g[top:,c]=cols[i%3]
    if side=='left':
        g[shelf_row,:shelf_w]=2
        cells=[(r,c) for r in range(shelf_row-1,-1,-1) for c in range(shelf_w)]
    else:
        g[shelf_row,W-shelf_w:]=2
        cells=[(r,c) for r in range(shelf_row-1,-1,-1) for c in range(W-1,W-shelf_w-1,-1)]
    for r,c in cells[:water_count]: g[r,c]=WATER
    return g

def basin_counts(grid,walls):
    out=[]
    for a,b in zip(walls,walls[1:]):
        out.append(int(np.sum(grid[:,a+1:b]==WATER)))
    return tuple(out)

def show(arr):
    return '\\n'.join(''.join(map(str,row)) for row in arr)

best=[]
for side in ('left','right'):
  for walls,tops in SAFE_LAYOUTS:
    for shelf_row in [2,3,4]:
      for shelf_w in [3,4,5,6]:
        cap=shelf_row*shelf_w
        for water_count in range(3, min(cap,12)+1):
