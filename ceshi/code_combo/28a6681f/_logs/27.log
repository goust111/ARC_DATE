+        gravity_gap = int(np.count_nonzero(fused != legacy))
+        fused_counts = _basin_counts(fused)
+        legacy_counts = _basin_counts(legacy)
+        basin_l1_gap = int(sum(abs(int(a) - int(b)) for a, b in zip(fused_counts, legacy_counts)))
