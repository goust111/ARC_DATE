+    for _ in range(200):
+        source_side = rng.choice(["left", "right"])
+        outer_top_left = rng.choice(OUTER_TOP_CHOICES)
+        outer_top_right = rng.choice(OUTER_TOP_CHOICES)
+        water_count = rng.choice(WATER_COUNT_CHOICES)
