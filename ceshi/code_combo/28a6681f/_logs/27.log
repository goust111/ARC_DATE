import numpy as np, random
from pathlib import Path

BG=0; WATER=1
H=W=10
SAFE_LAYOUTS = (
    ((1,4,7),(4,6,4)),
    ((1,4,7),(4,7,4)),
    ((1,4,7),(5,7,5)),
    ((1,4,7),(4,6,5)),
