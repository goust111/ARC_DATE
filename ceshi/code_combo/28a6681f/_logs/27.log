    ((2,5,8),(4,7,5)),
)

def orig(grid):
    g=np.array(grid,int).copy()
    H,W=g.shape
    def settle(r,c):
        rr,cc=int(r),int(c)
        for _ in range(H*W):
            if rr+1<H and g[rr+1,cc]==BG:
                rr+=1; continue
            opts=[]
            if rr+1<H and cc-1>=0 and g[rr,cc-1]==BG and g[rr+1,cc-1]==BG:
                opts.append((rr+1,cc-1))
            if rr+1<H and cc+1<W and g[rr,cc+1]==BG and g[rr+1,cc+1]==BG:
                opts.append((rr+1,cc+1))
            if opts:
                if len(opts)"'!=1:
                    raise AssertionError(f'"'ambig diag {opts}')
                rr,cc=opts[0]; continue
            if rr+1<H and g[rr+1,cc]"'!=BG:
                L=cc
                while L-1>=0 and g[rr,L-1]==BG: L-=1
                R=cc
                while R+1<W and g[rr,R+1]==BG: R+=1
                drops=[x for x in range(L,R+1) if g[rr+1,x]==BG]
                if not drops: break
                md=min(abs(x-cc) for x in drops)
                nearest=[x for x in drops if abs(x-cc)==md]
                if len(nearest)!=1:
                    raise AssertionError(f'"'ambig horiz {nearest}')
                best=nearest[0]
                if best==cc: raise AssertionError('best==cc')
                cc += -1 if best<cc else 1
                continue
            break
        return rr,cc
    for _ in range(H*W):
        moved=False
        pts=sorted([(int(r),int(c)) for r,c in np.argwhere(g==WATER)], reverse=True)
        for r,c in pts:
            if g[r,c]"'!=WATER: continue
            g[r,c]=BG
            rr,cc=settle(r,c)
            moved |= (rr,cc)!=(r,c)
            g[rr,cc]=WATER
        if not moved: return g
    raise AssertionError('"'no converge')

def phase_targets(g, coords, phase):
    H,W=g.shape
    targets={}
    for r,c in coords:
        rr,cc=int(r),int(c)
        tgt=None
        if phase=='down':
            if rr+1<H and g[rr+1,cc]==BG:
                tgt=(rr+1,cc)
        elif phase=='diag':
            if rr+1<H and g[rr+1,cc]"'!=BG:
                opts=[]
                if rr+1<H and cc-1>=0 and g[rr,cc-1]==BG and g[rr+1,cc-1]==BG:
                    opts.append((rr+1,cc-1))
                if rr+1<H and cc+1<W and g[rr,cc+1]==BG and g[rr+1,cc+1]==BG:
                    opts.append((rr+1,cc+1))
                if len(opts)==1:
                    tgt=opts[0]
        elif phase=='"'horiz':
            if rr+1<H and g[rr+1,cc]"'!=BG:
                L=cc
                while L-1>=0 and g[rr,L-1]==BG: L-=1
                R=cc
                while R+1<W and g[rr,R+1]==BG: R+=1
                drops=[x for x in range(L,R+1) if g[rr+1,x]==BG]
                if drops:
                    md=min(abs(x-cc) for x in drops)
                    nearest=[x for x in drops if abs(x-cc)==md]
                    if len(nearest)==1:
                        best=nearest[0]
                        if best!=cc:
                            step=-1 if best<cc else 1
                            nx=cc+step
                            if g[rr,nx]==BG:
                                tgt=(rr,nx)
        if tgt is not None:
            targets[(rr,cc)] = tgt
    return targets

def apply_row_phase(g, phase):
    moved=False
    groups={r:[] for r in range(g.shape[0])}
    for r,c in np.argwhere(g==WATER):
        groups[int(r)].append((int(r),int(c)))
    for r in range(g.shape[0]):
        coords=groups[r]
        if not coords:
            continue
        snapshot=g.copy()
        intents=phase_targets(snapshot, coords, phase)
        rev={}
        for src,tgt in intents.items():
            rev.setdefault(tgt, []).append(src)
        valid=[]
        for tgt,srcs in rev.items():
            if len(srcs)==1:
                valid.append((srcs[0],tgt))
        if valid:
            moved=True
            for src,_ in valid:
                g[src]=BG
            for _,tgt in valid:
                g[tgt]=WATER
    return moved

def fused(grid):
    g=np.array(grid,int).copy()
    for _ in range(H*W*4):
        moved=False
        for phase in ('"'down','diag','horiz'):
            moved = apply_row_phase(g, phase) or moved
        if not moved:
            return g
    raise AssertionError('no converge fused')

def make(side, walls, tops, shelf_row, shelf_w, water_count):
    g=np.zeros((H,W),int)
    colors=(3,5,7)
    for i,(c,top) in enumerate(zip(walls,tops)):
        g[top:,c]=colors[i%3]
    if side=='left':
        g[shelf_row,:shelf_w]=2
        cells=[(r,c) for r in range(shelf_row-1,-1,-1) for c in range(shelf_w)]
    else:
        g[shelf_row,W-shelf_w:]=2
        cells=[(r,c) for r in range(shelf_row-1,-1,-1) for c in range(W-1,W-shelf_w-1,-1)]
    for r,c in cells[:water_count]:
        g[r,c]=WATER
    return g

def show(arr):
    return '\\n'.join(''.join(map(str,row)) for row in arr)

found=0
for side in ('left','right'):
  for walls,tops in SAFE_LAYOUTS:
    for shelf_row in [2,3,4,5]:
      for shelf_w in [3,4,5,6]:
        cap=shelf_row*shelf_w
        for water_count in range(3, min(cap,12)+1):
          g=make(side,walls,tops,shelf_row,shelf_w,water_count)
          try:
            o1=orig(g)
            o2=fused(g)
          except Exception:
            continue
          gap=int(np.count_nonzero(o1"'!=o2))
          if gap>=2:
            found+=1
            print('"'CASE', found, 'side',side,'walls',walls,'tops',tops,'shelf_row',shelf_row,'shelf_w',shelf_w,'water',water_count,'gap',gap)
            print('input\\n'+show(g))
            print('orig\\n'+show(o1))
            print('fused\\n'+show(o2))
            print()
            if found>=12:
              raise SystemExit
print('found',found)
