+        valid_moves = [
+            ((int(srcs[0][0]), int(srcs[0][1])), (int(tgt[0]), int(tgt[1])))
+            for tgt, srcs in claims.items()
+            if len(srcs) == 1
+        ]
+        if not valid_moves:
+            continue
+
+        moved = True
+        for (sr, sc), _ in valid_moves:
+            grid[int(sr), int(sc)] = int(BG)
+        for _, (tr, tc) in valid_moves:
