def build(n=15, side='left', widths=[1,1,2,2], left_margin=3, right_margin=1, depth=4, floor_row=6):
    bc=len(widths)
    wall_cols=[left_margin]
    for w in widths: wall_cols.append(wall_cols[-1]+w+1)
    g=np.zeros((n,n),dtype=int)
