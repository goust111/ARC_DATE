                best=near[0]
                step=-1 if best<cc else 1
                if g[rr,cc+step]"'!=bg: raise AssertionError('"'blocked step')
                cc+=step; continue
            break
        else: raise AssertionError('no settle')
        return rr,cc
    for _ in range(H*W):
