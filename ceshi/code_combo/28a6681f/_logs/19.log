+        "size": 15,
+        "widths": (1, 1, 2, 1),
+        "wall_heights": (7, 4, 4, 2, 7),
+        "source_margin": 4,
+        "floor_row": 6,
+        "fill_heights": (5,),
+    },
+    {
+        "size": 20,
+        "widths": (1, 1, 2, 2, 2),
+        "wall_heights": (6, 3, 2, 3, 2, 7),
+        "source_margin": 4,
+        "floor_row": 8,
+        "fill_heights": (6, 7, 8),
