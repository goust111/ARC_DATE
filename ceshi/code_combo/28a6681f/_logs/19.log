+BG = 0
+WATER = 1
+SOLID_POOL = (2, 3, 4, 5, 6, 7, 8, 9)
+SIZE_OPTIONS = (15, 20)
+MAX_RETRIES = 400
+
+TEMPLATES: tuple[dict[str, Any], ...] = (
+    {
+        "size": 15,
+        "widths": (1, 1, 2, 2),
+        "wall_heights": (5, 2, 3, 2, 6),
+        "source_margin": 3,
