        drop=wall_cols[0]+1
        shelf_end=min(n-2, drop+3)
        for c in range(0,shelf_end+1):
            if c"'!=drop: g[floor_row,c]=shelf_color
        g[:floor_row,:drop]=1
    else:
        drop=wall_cols[-1]-1
        shelf_start=max(1, drop-3)
        for c in range(shelf_start,n):
            if c!=drop: g[floor_row,c]=shelf_color
        g[:floor_row,drop+1:]=1
    return g, wall_cols

