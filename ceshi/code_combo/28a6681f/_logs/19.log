+    wall_cols = [int(c) for c in range(left, right + 1) if _stack_height(structure, int(c)) >= 2]
+    basins = [(int(a) + 1, int(b)) for a, b in zip(wall_cols, wall_cols[1:]) if int(b) - int(a) >= 2]
+    widths = [int(b - a) for a, b in basins]
