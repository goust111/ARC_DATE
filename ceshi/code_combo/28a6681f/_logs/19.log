+
+
+def _occupied_counts(grid: np.ndarray, basins: list[tuple[int, int]]) -> list[int]:
+    counts: list[int] = []
+    for left, right in basins:
+        counts.append(int(np.count_nonzero(grid[:, int(left) : int(right)] == int(WATER))))
