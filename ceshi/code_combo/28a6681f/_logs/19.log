+    return int(rr), int(cc)
+
+
+def _simulate(grid: np.ndarray, *, check_input: bool, check_output: bool) -> np.ndarray:
+    g = np.array(grid, dtype=int).copy()
+    h, w = g.shape
+
+    assert h == w and h in SIZE_OPTIONS, "grid must be 15x15 or 20x20"
+
