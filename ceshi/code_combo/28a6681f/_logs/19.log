+
+        sig = _fusion_signature(out)
+        expected_basins = int(len(tpl["widths"]))
+        if sig["basin_count"] != expected_basins:
+            continue
+        if sig["active_basins"] != expected_basins:
+            continue
+        if sig["cascade_steps"] != expected_basins - 1:
