15x15 模板目前被稳定性断言筛掉了，所以上一轮统计全是 20x20。原因不是成功率，而是 15x15 的某些短隔墙会让最终水面在局部暴露侧向背景，不满足原任务的“稳定水”判据。我先枚举一批 15x15 高度组合，找出同时满足“4 盆地全连通”和“输出稳定”的安全模板，再补回生成器。
exec
/bin/bash -lc "python - <<'PY'
import itertools, importlib.util, numpy as np
spec = importlib.util.spec_from_file_location('variant', '/home/lixinyu/snap/new/ceshi/code_combo/28a6681f/19/code.py')
mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)
width_templates=[(1,1,2,2),(1,2,1,2),(2,1,1,2),(2,1,2,1)]
solutions=[]
for widths in width_templates:
  for outer_l in [5,6,7]:
    for outer_r in [5,6,7]:
      for mids in itertools.product([2,3,4], repeat=3):
        heights=(outer_l,)+mids+(outer_r,)
        ok=True
        sigs=[]
        for side in ['left','right']:
          for fill in [5,6]:
            base, meta = mod._draw_structure(
                size=15,
                widths=widths,
                wall_heights=heights,
                source_margin=3,
                floor_row=6,
                source_side=side,
                colors=(2,3,4,8),
            )
            inp=base.copy()
            mod._add_source_water(inp, fill, tuple(meta['source_cols']), meta['floor_row'])
            try:
              out=mod.main(inp)
            except Exception:
              ok=False
              break
            sig=mod._fusion_signature(out)
            if sig['basin_count']"'!=4 or sig['"'active_basins']"'!=4 or sig['"'cascade_steps']"'!=3 or sig['"'top_row_spread']>1:
              ok=False
              break
            sigs.append(sig)
          if not ok:
            break
        if ok:
          solutions.append((widths, heights, sigs[:2]))
          print('FOUND', widths, heights, sigs[:2])
          if len(solutions)>=10:
            raise SystemExit
print('total', len(solutions))
