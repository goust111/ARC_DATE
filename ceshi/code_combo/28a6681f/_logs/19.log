            g[r,c]=0
            rr,cc=settle(r,c)
            moved|=(rr,cc)!=(r,c)
            g[rr,cc]=1
        if not moved: return g
    raise AssertionError('"'conv')

def metrics(out, walls):
    counts=[]
    tops=[]
    for i,(l,r) in enumerate(zip(walls,walls[1:])):
        sub=out[:,l+1:r]
        cnt=int(np.count_nonzero(sub==1))
        counts.append(cnt)
        pts=np.argwhere(sub==1)
        if len(pts): tops.append(int(pts[:,0].min()))
    return counts,sum(x>0 for x in counts),max((i for i,x in enumerate(counts) if x>0), default=-1),tops

def build(n,widths,heights,source_margin,floor_row,fill_height,side):
    span=sum(widths)+len(widths)+1
    if side=='left': left=source_margin
    else: left=n-span-source_margin
    walls=[left]
    for w in widths: walls.append(walls[-1]+w+1)
    g=np.zeros((n,n),dtype=int)
    cols=[2,3,4]
    for i in range(len(walls)-1): g[n-1,walls[i]:walls[i+1]+1]=cols[i%3]
    for i,c in enumerate(walls): g[n-heights[i]:,c]=cols[i%3]
    shelf=8
    if side=='left':
        drop=walls[0]+1
        for c in range(0,min(n-2, drop+3)+1):
            if c"'!=drop: g[floor_row,c]=shelf
        g[floor_row-fill_height:floor_row,0:drop]=1
    else:
        drop=walls[-1]-1
        for c in range(max(1, drop-3), n):
            if c!=drop: g[floor_row,c]=shelf
        g[floor_row-fill_height:floor_row,drop+1:n]=1
    return g,walls

