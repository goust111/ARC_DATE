+
+def _top_rows(grid: np.ndarray, basins: list[tuple[int, int]]) -> list[int]:
+    rows: list[int] = []
+    for left, right in basins:
+        pts = np.argwhere(grid[:, int(left) : int(right)] == int(WATER))
