def basin_metrics(grid, wall_cols):
    out=[]
    for i,(l,r) in enumerate(zip(wall_cols, wall_cols[1:])):
        out.append(int(np.count_nonzero(grid[:, l+1:r]==1)))
    active=sum(x>0 for x in out)
    far=max((i for i,x in enumerate(out) if x>0), default=-1)
    return out,active,far

def build(n, side, widths, left_margin, heights, floor_row, shelf_ext=3):
    wall_cols=[left_margin]
    for w in widths: wall_cols.append(wall_cols[-1]+w+1)
    g=np.zeros((n,n),dtype=int)
    # bottom bases with repeated colors
    palette=[2,3,4]
    for i in range(len(wall_cols)-1):
