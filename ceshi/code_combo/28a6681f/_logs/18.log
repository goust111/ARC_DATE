+            if rr + 1 < H and int(g[rr + 1, cc]) != int(BG):
+                left = int(cc)
+                while left - 1 >= 0 and int(g[rr, left - 1]) == int(BG):
+                    left -= 1
+                right = int(cc)
+                while right + 1 < W and int(g[rr, right + 1]) == int(BG):
+                    right += 1
