+    while stack:
+        r, c = stack.pop()
+        if (r, c) in anchored:
+            continue
+        anchored.add((int(r), int(c)))
+        for dr, dc in ORTHO_DIRS:
+            rr = int(r + dr)
+            cc = int(c + dc)
+            if 0 <= rr < H and 0 <= cc < W and bool(solid[rr, cc]) and (rr, cc) not in anchored:
+                stack.append((rr, cc))
