   307	def main(grid: np.ndarray, check_input: bool = True, check_output: bool = True) -> np.ndarray:
   308	    """
   309	    Simulate water that fills chained basins only up to a visible line, then erase the dry basin parts.
   310	
   311	    Input structure:
   312	    - Background is 0, movable water is 1, and color 8 marks a shared waterline on bottom-anchored basin walls.
   313	    - Other nonzero colors are fixed solids that form two neighboring bottom basins plus a supported source shelf near one side.
   314	    - Water starts on that shelf or in already-settled cells, while the marker cells are part of the wall itself.
   315	
   316	    Rule:
   317	    - Move water with the source task physics: fall vertically through background, slip through a unique open diagonal, and while supported slide horizontally toward the nearest reachable drop.
   318	    - A moved water pixel may not finish above the marker row. If its best new resting place would cross that height, it stays in its original supported source cell instead.
   319	    - After the limited fill stabilizes, inspect only bottom-anchored structure pixels and delete every one that is not 4-neighbor adjacent to final water.
   320	
   321	    Key insight:
   322	    - The visible waterline does not merely cap the water depth; it also changes which wall pixels ever become wet, so the surviving structure can be inferred only after simulating the limited fill.
   323	    """
   324	    g = np.array(grid, dtype=int).copy()
   325	    limit_row = _marker_row(g)
   326	    if check_input:
   327	        _check_input_constraints(g, limit_row)
   328	    settled = _simulate_water(g, limit_row=limit_row, check_input=False)
   329	    out = _delete_unused_basin_pixels(settled)
   330	    if check_output:
   331	        _check_settled_water_fixed_point(settled, limit_row=limit_row)
   332	        assert np.array_equal(_delete_unused_basin_pixels(settled), out), "dry-structure deletion mismatch"
   333	    return out
