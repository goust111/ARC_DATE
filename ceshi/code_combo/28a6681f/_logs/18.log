        for height in range(1, 5):
            rows, cols = mod._source_box(side, shelf_row, height)
            if all(0 <= r < mod.H for r in rows):
                water = mod._count_water(inp, rows, cols)
                if water > 0:
                    meta_guess = {'"'source_side': side, 'shelf_row': shelf_row, 'source_height': height}
                    break
        if meta_guess is not None:
            break
    assert meta_guess is not None
    # Recover source box from the highest solid shelf directly below the edge block.
    if side == 'left':
        shelf_row = next(r for r in range(mod.H) if all(inp[r, c] "'!= mod.BG for c in range(0, 3)) and r > 0 and any(inp[r-1, c] == mod.WATER for c in range(0, 3)))
    else:
        shelf_row = next(r for r in range(mod.H) if all(inp[r, c] != mod.BG for c in range(7, 10)) and r > 0 and any(inp[r-1, c] == mod.WATER for c in range(7, 10)))
    height = 0
    if side == '"'left':
        r = shelf_row - 1
        while r >= 0 and any(inp[r, c] == mod.WATER for c in range(0, 3)):
            height += 1
            r -= 1
    else:
        r = shelf_row - 1
        while r >= 0 and any(inp[r, c] == mod.WATER for c in range(7, 10)):
            height += 1
            r -= 1
    meta = {'source_side': side, 'shelf_row': shelf_row, 'source_height': height}
    m = mod._variant_metrics(inp, meta)
    records.append(m)

def summary(key):
    vals = [r[key] for r in records]
    return min(vals), round(statistics.mean(vals), 2), max(vals)

print('overflow_samples', sum(1 for r in records if r['left_basin_water'] and r['right_basin_water']))
print('single_basin_samples', sum(1 for r in records if not (r['left_basin_water'] and r['right_basin_water'])))
for key in ['limited_source', 'deleted', 'deleted_above_line', 'line_forced_deleted', 'limited_vs_unlimited_diff', 'marker_contacts']:
    lo, mean, hi = summary(key)
    print(key, lo, mean, hi)
