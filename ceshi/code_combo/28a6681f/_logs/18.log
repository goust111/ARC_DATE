+    used: set[tuple[int, int]] = set()
+    for r, c in np.argwhere(g == int(WATER)):
+        rr = int(r)
+        cc = int(c)
+        for dr, dc in ORTHO_DIRS:
+            nr = int(rr + dr)
+            nc = int(cc + dc)
+            if 0 <= nr < H and 0 <= nc < W and (nr, nc) in anchored:
+                used.add((nr, nc))
+
+    out = g.copy()
+    for r, c in anchored:
+        if (int(r), int(c)) not in used:
+            out[int(r), int(c)] = int(BG)
