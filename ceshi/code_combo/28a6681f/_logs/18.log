+    g = np.zeros((H, W), dtype=int)
+    wall_colors = rng.sample([2, 3, 4, 5, 6, 7, 9], 3)
+    left_color, divider_color, right_color = wall_colors
+
+    left_wall = 2
+    divider = 4
+    right_wall = 7
+    source_side = rng.choice(["left", "right"])
+    if want_overflow:
+        template = rng.choice(
