+    out = _delete_unused_basin_pixels(settled)
+    if check_output:
+        _check_settled_water_fixed_point(settled, limit_row=limit_row)
+        assert np.array_equal(_delete_unused_basin_pixels(settled), out), "dry-structure deletion mismatch"
