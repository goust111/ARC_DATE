   110	def _component_count(points: set[tuple[int, int]], use_diagonal: bool) -> int:
   111	    remaining = set(points)
   112	    if use_diagonal:
   113	        neighbors = [(dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if (dr, dc) != (0, 0)]
   114	    else:
   115	        neighbors = ORTHO_DIRS
   116	
   117	    count = 0
   118	    while remaining:
   119	        count += 1
   120	        stack = [remaining.pop()]
   121	        while stack:
   122	            r, c = stack.pop()
   123	            for dr, dc in neighbors:
   124	                nxt = (int(r + dr), int(c + dc))
   125	                if nxt in remaining:
   126	                    remaining.remove(nxt)
   127	                    stack.append(nxt)
   128	    return count
