+    shelf_row = int(template["shelf_row"])
+    source_height = int(template["source_height"])
+    level_row = int(template["level_row"])
+    divider_top = int(template["divider_top"])
+    left_top = rng.choice([2, 3, 4])
+    right_top = rng.choice([2, 3, 4])
