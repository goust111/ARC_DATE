+
+def _solve_once(grid: np.ndarray, limit_row: int | None, check_input: bool) -> np.ndarray:
+    settled = _simulate_water(grid, limit_row=limit_row, check_input=check_input)
+    return _delete_unused_basin_pixels(settled)
