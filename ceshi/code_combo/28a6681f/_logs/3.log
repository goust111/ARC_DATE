+        relaxed_diagonal=False,
+        prefer_farthest=False,
+        check_input=True,
+        check_output=True,
+    )
+    diag_only = _simulate(
+        grid,
+        relaxed_diagonal=True,
+        prefer_farthest=False,
+        check_input=True,
+        check_output=True,
+    )
+    far_only = _simulate(
+        grid,
+        relaxed_diagonal=False,
+        prefer_farthest=True,
+        check_input=True,
+        check_output=True,
