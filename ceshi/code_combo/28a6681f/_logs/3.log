+    for r in range(int(support_row), min(10, int(support_row + far_depth))):
+        g[int(r), 1] = 0
+    for r in range(int(support_row), min(10, int(support_row + near_depth))):
+        g[int(r), 5] = 0
+
+    if mirror:
+        g = np.fliplr(g)
+
+    return g
+
+
