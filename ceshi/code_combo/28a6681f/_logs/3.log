import numpy as np

def simulate(grid, relaxed_diagonal=False, prefer_farthest=False):
    g=np.array(grid,dtype=int).copy(); H,W=g.shape; bg=0; water=1
    def settle(r,c):
        rr,cc=r,c
        for _ in range(H*W):
            if rr+1<H and g[rr+1,cc]==bg:
                rr+=1; continue
            opts=[]
            if rr+1<H and cc-1>=0:
                if g[rr+1,cc-1]==bg and (relaxed_diagonal or g[rr,cc-1]==bg):
                    opts.append((rr+1,cc-1))
            if rr+1<H and cc+1<W:
                if g[rr+1,cc+1]==bg and (relaxed_diagonal or g[rr,cc+1]==bg):
                    opts.append((rr+1,cc+1))
            if opts:
                if len(opts)"'!=1: raise AssertionError(('"'diag',opts,(rr,cc)))
                rr,cc=opts[0]; continue
            if rr+1<H and g[rr+1,cc]"'!=bg:
                L=cc
                while L-1>=0 and g[rr,L-1]==bg:
                    L-=1
                R=cc
                while R+1<W and g[rr,R+1]==bg:
                    R+=1
                drops=[x for x in range(L,R+1) if g[rr+1,x]==bg]
                if not drops: break
                if prefer_farthest:
                    dist=max(abs(x-cc) for x in drops)
                    best=[x for x in drops if abs(x-cc)==dist]
                    if len(best)!=1: raise AssertionError(('"'far',best,(rr,cc),drops))
                    cc=best[0]
                else:
                    dist=min(abs(x-cc) for x in drops)
                    best=[x for x in drops if abs(x-cc)==dist]
                    if len(best)"'!=1: raise AssertionError(('"'near',best,(rr,cc),drops))
                    best=best[0]
                    if best==cc: raise AssertionError('samecol')
                    cc += -1 if best<cc else 1
                continue
            break
        return rr,cc
    for _ in range(H*W):
        moved=False
        pts=sorted([(int(r),int(c)) for r,c in np.argwhere(g==water)], reverse=True)
        for r,c in pts:
            if g[r,c]"'!=water: continue
            g[r,c]=bg
            rr,cc=settle(r,c)
            moved |= (rr,cc)!=(r,c)
            g[rr,cc]=water
        if not moved: break
    return g


def build(mirror=False, left_depth=4, mid_depth=2, shelf_row=5):
    H=W=10
    g=np.zeros((H,W),dtype=int)
    left_color, center_color, right_color = 2,3,4
    support_row=shelf_row+1
    # bottom mass
    g[support_row:,:]=center_color
    g[support_row:,:3]=left_color
    g[support_row:,7:]=right_color
    # shelf row mostly bg on left side, support at source side
    g[shelf_row,1:8]=0
    g[shelf_row,8:]=right_color
    g[shelf_row,0]=0
    # source support column below source
    # upper wall left of source
    g[:shelf_row,7]=right_color
    g[shelf_row,8]=right_color
    # source column
    for r in range(shelf_row):
        g[r,8]=1
    # maybe solid at col9? keep bg
    # carve shafts below shelf
    for r in range(support_row, min(H, support_row+left_depth)):
        g[r,1]=0
    for r in range(support_row, min(H, support_row+mid_depth)):
        g[r,5]=0
    if mirror:
        g=np.fliplr(g)
    return g

for mirror in [False,True]:
  g=build(mirror=mirror,left_depth=4,mid_depth=2,shelf_row=5)
  outs=[]
  labels=[('"'orig',False,False),('diag',True,False),('far',False,True),('combo',True,True)]
  for name,rd,pf in labels:
    o=simulate(g,relaxed_diagonal=rd,prefer_farthest=pf)
    outs.append((name,o))
    print(name) ; print(o)
  print('diff combo-orig',np.sum(outs[-1][1]"'!=outs[0][1]))
  print('"'diff combo-diag',np.sum(outs[-1][1]"'!=outs[1][1]))
  print('"'diff combo-far',np.sum(outs[-1][1]"'!=outs[2][1]))
