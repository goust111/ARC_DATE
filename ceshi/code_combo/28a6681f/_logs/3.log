        pts=sorted([(int(r),int(c)) for r,c in np.argwhere(g==1)], reverse=True)
        for r,c in pts:
            if g[r,c]"'!=1: continue
            g[r,c]=0
            rr,cc=settle(r,c)
            moved |= (rr,cc)!=(r,c)
            g[rr,cc]=1
        if not moved: break
    return g

def build(mirror=False, left_depth=4, mid_depth=2, shelf_row=5):
    H=W=10
