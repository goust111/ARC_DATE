+
+
+def _present_pairs_in_patch(patch: np.ndarray, tracked_colors: set[int]) -> set[tuple[int, int]]:
+    """Legend-color adjacency pairs present in a component patch."""
+    h, w = patch.shape
+    pairs: set[tuple[int, int]] = set()
+    for r in range(h):
+        for c in range(w):
+            a = int(patch[r, c])
+            if a not in tracked_colors:
