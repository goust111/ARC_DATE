+                b = int(patch[nr, nc])
+                if b not in tracked_colors or a == b:
+                    continue
+                pairs.add(tuple(sorted((a, b))))
+    return pairs
+
+
+def _build_component_patch(h: int, w: int, legend_colors: list[int], role: str) -> np.ndarray | None:
+    """
