+        colors = list(chosen_targets)
+        filler_palette = non_targets + chosen_targets
+
+    colors.extend(random.choice(filler_palette) for _ in range(n_colored - len(colors)))
+    random.shuffle(colors)
+
+    patch = np.zeros((h, w), dtype=int)
+    rs, cs = zip(*coords)
