+        placement_grid[0, :] = BORDER
+        placement_grid[-1, :] = BORDER
+        placement_grid[:, 0] = BORDER
+        placement_grid[:, -1] = BORDER
+        try:
+            r, c = random_free_location(
+                placement_grid,
+                np.zeros_like(patch),
+                transparent=BG,
+                padding=1,
+                padding_connectivity=8,
+            )
+        except ValueError:
+            return None
+        paste(inp, patch, r, c)
+        if role.startswith("kept"):
+            paste(out, patch, r, c)
+
+    if not np.array_equal(main(inp), out):
+        return None
+
+    witnesses = _fusion_witness_counts(inp)
+    if witnesses["kept_count"] != NUM_KEPT:
+        return None
+    if witnesses["deleted_count"] < 2:
+        return None
+    if witnesses["deleted_partial_targets"] < 1:
+        return None
+    if witnesses["kept_all_exclusions"] < 1:
+        return None
+    if witnesses["legend_color_count"] != NUM_LEGEND_COLORS:
+        return None
+    if witnesses["target_count"] != NUM_TARGETS:
+        return None
+    if witnesses["diff_vs_original"] != 1:
+        return None
+    if witnesses["diff_vs_d15_only"] != 1:
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate valid input")

codex
根因上看，不需要把布局空间缩得这么厉害。更合理的处理是保留原本宽松放置，只把那些让 `main()` 断言失败的候选样本当作无效尝试丢弃，让 `generate_input()` 自己重试。这样既保住稳定性，也不牺牲可放置空间。
