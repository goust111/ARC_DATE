+    patches: list[np.ndarray] = []
+    for r0, c0, r1, c1 in _frame_bboxes(g, bg, legend_sz):
+        patch = g[r0 : r1 + 1, c0 : c1 + 1].copy()
+        colors = set(map(int, np.unique(patch)))
+        colors.discard(bg)
+        colors.discard(BOX_FRAME)
