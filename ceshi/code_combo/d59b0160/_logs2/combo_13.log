+
+
+def _footprint(h: int, w: int) -> np.ndarray:
+    """Full bbox occupancy mask for legal placement."""
+    return np.full((h, w), BOX_FRAME, dtype=int)
+
+
+def _collect_free_kept_patches(g: np.ndarray) -> tuple[int, list[np.ndarray]]:
