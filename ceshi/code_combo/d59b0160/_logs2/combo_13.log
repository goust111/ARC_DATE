   185	def main(grid: np.ndarray) -> np.ndarray:
   186	    """
   187	    Keep only the rectangle-framed regions that fail the legend color test, then output those regions as separate crops.
   188	
   189	    Input structure:
   190	    - The background fills most of the 16x16 grid.
   191	    - A top-left legend square has one color on its bottom edge and right edge; its interior lists the target colors.
   192	    - Elsewhere, each candidate object is a black rectangular frame containing one or more colored marks, and those marks do not need to be mutually connected.
   193	
   194	    Rule:
   195	    - Read the target color set from the legend interior.
   196	    - Ignore the legend, then detect each black rectangular frame and treat its entire bounding box as one analysis unit.
   197	    - If the union of non-background, non-frame colors inside that box contains all target colors, discard the whole box; otherwise keep the whole box.
   198	    - Crop every kept box to its own rectangle and concatenate the crops left-to-right with a 1-cell background gap.
   199	
   200	    Key insight:
   201	    The grouping cue is the visible rectangle boundary, not free 4-connectivity of the colored marks inside it. The legend still defines which color set is forbidden, but the answer is a new strip of surviving framed regions rather than a cleaned copy of the input canvas.
   202	    """
   203	    g = np.asarray(grid, dtype=int)
   204	    bg, patches = _collect_kept_patches(g)
   205	    return _assemble_patches(patches, bg)
