+    kept: list[tuple[tuple[int, int], np.ndarray]] = []
+    for pts in components_mask(fg_mask, connectivity=4):
+        colors = {int(g[r, c]) for r, c in pts}
+        colors.discard(BOX_FRAME)
+        if legend_colors.issubset(colors):
