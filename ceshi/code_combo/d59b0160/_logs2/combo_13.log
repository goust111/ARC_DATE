+    placements = [
+        (SLOT_SMALL, False, 0, False),
+        (SLOT_MED, False, 1, True),
+        ((big_slots[0][0], big_slots[0][1], kept_big_h, kept_big_w), False, 2, True),
+        (big_slots[1], True, NUM_TARGETS, True),
