+def _place_legend(inp: np.ndarray, targets: list[int]) -> None:
+    """Draw the 4x4 legend at top-left and place the target colors."""
+    s = LEGEND_SIZE
+    inp[:s, :s] = BG
+    inp[s - 1, :s] = BORDER
