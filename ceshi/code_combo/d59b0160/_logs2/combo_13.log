+# --------------- generator ---------------
+
+# -- Box shape families --
+SHAPE_WEIGHTS = [5, 3, 2]  # medium, tall, wide
+TALL_H = (6, 7)
+TALL_W = (5, 6)
+WIDE_H = (5, 6)
+WIDE_W = (6, 7)
+MED_H = (5, 6)
+MED_W = (5, 6)
+
+# -- Box count & kept/deleted split --
+BOX_COUNTS = [4, 5]
+BOX_WEIGHTS = [5, 2]
