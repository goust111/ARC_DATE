    42	def _bg_boundary(g: np.ndarray) -> int:
    43	    """Most common color along the 1-cell outer border."""
    44	    border = np.concatenate([g[0, :], g[-1, :], g[1:-1, 0], g[1:-1, -1]])
    45	    vals, cnts = np.unique(border, return_counts=True)
    46	    return int(vals[cnts.argmax()])
    47	
    48	
    49	def _find_legend(g: np.ndarray, bg: int) -> tuple[int, int, set[int]]:
    50	    """
    51	    Detect the top-left legend whose bottom edge and right edge share one border color.
    52	
    53	    Returns:
    54	      (legend_size, border_color, interior_target_colors)
    55	    """
    56	    h, w = g.shape
    57	    for sz in range(2, min(h, w) + 1):
    58	        x = int(g[sz - 1, sz - 1])
    59	        if x == bg:
    60	            continue
    61	        if np.all(g[sz - 1, 0:sz] == x) and np.all(g[0:sz, sz - 1] == x):
    62	            inside = g[0 : sz - 1, 0 : sz - 1]
    63	            colors = set(map(int, np.unique(inside)))
    64	            colors.discard(bg)
    65	            colors.discard(x)
    66	            return int(sz), int(x), colors
    67	    assert False, "no legend border found in grid"
    68	
