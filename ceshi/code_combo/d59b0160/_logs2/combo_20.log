   168	
   169	def _place_legend(inp: np.ndarray, out: np.ndarray, targets: list[int]) -> None:
   170	    """Draw the top-left legend while keeping one target isolated from border-connected legend cells."""
   171	    s = LEGEND_SIZE
   172	    for g in (inp, out):
   173	        g[:s, :s] = BG
   174	        g[s - 1, :s] = BORDER
   175	        g[:s, s - 1] = BORDER
   176	
   177	    isolated = random.choice([(0, 0), (0, 1), (1, 0), (1, 1)])
   178	    border_side = [(0, 2), (1, 2), (2, 0), (2, 1), (2, 2)]
   179	    side_choices = [
   180	        p for p in border_side
   181	        if abs(p[0] - isolated[0]) + abs(p[1] - isolated[1]) != 1
   182	    ]
   183	    positions = [isolated] + random.sample(side_choices, 2)
   184	    random.shuffle(positions)
   185	    for color, (r, c) in zip(targets, positions):
   186	        inp[r, c] = color
   187	        out[r, c] = color
   188	
   189	
   190	def _component_dims(matching: bool) -> tuple[int, int]:
   191	    """Sample component dimensions, keeping matched components large enough for holes plus residual mass."""
   192	    for _ in range(30):
   193	        mode = random.choices(["medium", "tall", "wide"], weights=SHAPE_WEIGHTS)[0]
   194	        if mode == "tall":
   195	            h, w = random.randint(*TALL_H), random.randint(*TALL_W)
   196	        elif mode == "wide":
   197	            h, w = random.randint(*WIDE_H), random.randint(*WIDE_W)
   198	        else:
   199	            h, w = random.randint(*MED_H), random.randint(*MED_W)
   200	        if (not matching) or h * w >= MATCH_MIN_AREA:
   201	            return int(h), int(w)
   202	    return 5, 4
   203	
   204	
   205	def _assign_target_colors(
   206	    n_cells: int,
   207	    targets: list[int],
   208	    *,
   209	    require_all: bool,
   210	) -> list[int]:
   211	    """Color a set of target cells using either all target colors or only a strict subset."""
   212	    if require_all:
   213	        used = list(targets)
   214	    else:
   215	        used_count = random.randint(1, NUM_TARGETS - 1)
   216	        used = random.sample(targets, used_count)
   217	    colors = list(used)
   218	    while len(colors) < n_cells:
   219	        colors.append(random.choice(used))
   220	    random.shuffle(colors)
   221	    return colors
