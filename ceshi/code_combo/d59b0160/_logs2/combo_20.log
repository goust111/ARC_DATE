   141	
   142	GRID_H, GRID_W = 16, 16
   143	BG = 7
   144	BORDER = 3
   145	LEGEND_SIZE = 4
   146	PALETTE = [1, 2, 4, 5, 6, 8, 9]
   147	NUM_TARGETS = 3
   148	
   149	SHAPE_WEIGHTS = [5, 2, 2]  # medium, tall, wide
   150	TALL_H = (7, 11)
   151	TALL_W = (2, 4)
   152	WIDE_H = (3, 5)
   153	WIDE_W = (5, 8)
   154	MED_H = (3, 6)
   155	MED_W = (3, 6)
   156	
   157	MATCH_MIN_AREA = 10
   158	RESIDUAL_MIN = 4
   159	MATCH_MUTATE_MAX = 5
   160	KEEP_MUTATE_MAX = 6
   161	
   162	COMP_COUNTS = [4, 5, 6]
   163	COMP_WEIGHTS = [2, 5, 3]
   164	NUM_KEPT = 3
