    70	def _majority_non_legend_color(coords: np.ndarray, g: np.ndarray, legend_colors: set[int]) -> int | None:
    71	    """Return the most frequent color among component pixels not in the legend palette."""
    72	    counts: dict[int, int] = {}
    73	    best_color: int | None = None
    74	    best_count = -1
    75	    for r, c in coords:
    76	        color = int(g[int(r), int(c)])
    77	        if color in legend_colors:
    78	            continue
    79	        counts[color] = counts.get(color, 0) + 1
    80	        if counts[color] > best_count:
    81	            best_color = color
    82	            best_count = counts[color]
    83	    return best_color
    84	
    85	
    86	def _target_pixel_count(coords: np.ndarray, g: np.ndarray, legend_colors: set[int]) -> int:
    87	    """Count component pixels whose color belongs to the legend palette."""
    88	    total = 0
    89	    for r, c in coords:
    90	        if int(g[int(r), int(c)]) in legend_colors:
    91	            total += 1
    92	    return int(total)
