    95	def main(grid: np.ndarray) -> np.ndarray:
    96	    """
    97	    Edit components whose legend-colored area forms a strict majority.
    98	
    99	    Input structure:
   100	    - Most cells are the background color, while a small framed legend sits in the top-left corner.
   101	    - The legend uses one border color along its bottom and right edges; its interior pixels list the target palette.
   102	    - Elsewhere are several 4-connected non-background components separated by background gaps.
   103	
   104	    Rule:
   105	    - Read the target color set from inside the legend.
   106	    - For each non-background component outside the legend box, count how many of its pixels use legend colors.
   107	    - If those legend-colored pixels make up more than half of the component, delete only those pixels to background, then recolor every remaining pixel in that component to the most frequent non-legend color from the original component.
   108	    - Components whose legend-colored area is at most half are left unchanged.
   109	
   110	    Key insight: The legend now defines a voting palette rather than a required full set: components are selected by target-color area ratio, then locally hollowed out and homogenized by their surviving non-legend majority color.
   111	    """
   112	    g = np.asarray(grid, dtype=int)
   113	    bg = _bg_boundary(g)
   114	
   115	    sz, _border_color, legend_colors = _find_legend(g, bg)
   116	    assert legend_colors, "legend interior contains no target colors"
   117	
   118	    out = g.copy()
   119	    comps = components_mask(g != bg, connectivity=4)
   120	    for pts in comps:
   121	        if np.all(pts[:, 0] < sz) and np.all(pts[:, 1] < sz):
   122	            continue
   123	
   124	        total = int(pts.shape[0])
   125	        target_count = _target_pixel_count(pts, g, legend_colors)
   126	        if target_count * 2 <= total:
   127	            continue
   128	
   129	        fill_color = _majority_non_legend_color(pts, g, legend_colors)
   130	        for r, c in pts:
   131	            r = int(r)
   132	            c = int(c)
   133	            if int(g[r, c]) in legend_colors:
   134	                out[r, c] = bg
   135	            elif fill_color is not None:
   136	                out[r, c] = int(fill_color)
   137	    return out
