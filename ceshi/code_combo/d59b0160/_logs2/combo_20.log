   224	def _pick_dominant_color(targets: list[int]) -> int:
   225	    """Choose a non-legend dominant color for a component."""
   226	    non_targets = [0] + [v for v in PALETTE if v not in targets]
   227	    return int(random.choice(non_targets))
   228	
   229	
   230	def _other_non_legend_colors(targets: list[int], dominant: int) -> list[int]:
   231	    """List alternative non-legend colors that can appear without becoming the residual majority."""
   232	    return [c for c in ([0] + PALETTE) if c not in set(targets) | {dominant, BG, BORDER}]
   233	
   234	
   235	def _component_patch_matching(
   236	    h: int,
   237	    w: int,
   238	    targets: list[int],
   239	    *,
   240	    require_all_targets: bool,
   241	) -> tuple[np.ndarray, np.ndarray]:
   242	    """
   243	    Build a matched component.
   244	
   245	    The input has a strict majority of legend colors. The output deletes those
   246	    legend-colored cells to background, then recolors the residual to the unique
   247	    dominant non-legend color.
   248	    """
   249	    area = h * w
   250	    max_target_cells = area - RESIDUAL_MIN
   251	    min_target_cells = max(NUM_TARGETS if require_all_targets else 1, area // 2 + 1)
   252	    if max_target_cells < min_target_cells:
   253	        raise ValueError("matching component too small for required majority-with-residual layout")
   254	
   255	    dominant = _pick_dominant_color(targets)
   256	    all_coords = [(r, c) for r in range(h) for c in range(w)]
   257	    target_count = random.randint(min_target_cells, max_target_cells)
   258	    target_coords = random.sample(all_coords, target_count)
   259	    target_coord_set = set(target_coords)
   260	
   261	    out_patch = np.full((h, w), dominant, dtype=int)
   262	    for r, c in target_coords:
   263	        out_patch[r, c] = BG
   264	
   265	    inp_patch = out_patch.copy()
   266	    target_colors = _assign_target_colors(target_count, targets, require_all=require_all_targets)
   267	    for (r, c), color in zip(target_coords, target_colors):
   268	        inp_patch[r, c] = color
   269	
   270	    residual_coords = [p for p in all_coords if p not in target_coord_set]
   271	    alt_colors = _other_non_legend_colors(targets, dominant)
   272	    max_mutate = min(MATCH_MUTATE_MAX, max(0, len(residual_coords) // 3))
   273	    if alt_colors and max_mutate > 0:
   274	        n_mutate = random.randint(1, max_mutate)
   275	        for r, c in random.sample(residual_coords, n_mutate):
   276	            inp_patch[r, c] = random.choice(alt_colors)
   277	
   278	    fill_color = _majority_non_legend_color(np.argwhere(inp_patch != BG), inp_patch, set(targets))
   279	    assert fill_color == dominant
   280	    assert _target_pixel_count(np.argwhere(inp_patch != BG), inp_patch, set(targets)) * 2 > area
   281	    if require_all_targets:
   282	        assert set(targets).issubset({int(inp_patch[r, c]) for r, c in target_coords})
   283	    else:
   284	        assert not set(targets).issubset({int(inp_patch[r, c]) for r, c in target_coords})
   285	    return inp_patch, out_patch
   286	
   287	
   288	def _component_patch_keep(
   289	    h: int,
   290	    w: int,
   291	    targets: list[int],
   292	    *,
   293	    require_all_targets: bool,
   294	) -> np.ndarray:
   295	    """Build a kept component whose legend-colored share stays at or below half."""
   296	    area = h * w
   297	    dominant = _pick_dominant_color(targets)
   298	    patch = np.full((h, w), dominant, dtype=int)
   299	    all_coords = [(r, c) for r in range(h) for c in range(w)]
   300	
   301	    max_target_cells = area // 2
   302	    min_target_cells = NUM_TARGETS if require_all_targets else 0
   303	    if max_target_cells < min_target_cells:
   304	        raise ValueError("kept component too small for requested target coverage")
   305	
   306	    if require_all_targets:
   307	        lo = max(NUM_TARGETS, max_target_cells - max(1, area // 6))
   308	        hi = max_target_cells
   309	        target_count = random.randint(lo, hi)
   310	    else:
   311	        target_count = random.randint(min_target_cells, max_target_cells)
   312	
   313	    target_coords = random.sample(all_coords, target_count) if target_count > 0 else []
   314	    target_colors = _assign_target_colors(target_count, targets, require_all=require_all_targets) if target_count > 0 else []
   315	    for (r, c), color in zip(target_coords, target_colors):
   316	        patch[r, c] = color
   317	
   318	    residual_coords = [p for p in all_coords if p not in set(target_coords)]
   319	    alt_colors = _other_non_legend_colors(targets, dominant)
   320	    max_mutate = min(KEEP_MUTATE_MAX, max(0, len(residual_coords) // 3))

