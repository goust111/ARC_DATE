+    if not np.array_equal(main(inp), out):
+        return None
+    if np.array_equal(_baseline_all_legend_colors_main(inp), out):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate valid input")

