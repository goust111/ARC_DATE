    if not np.array_equal(combo, quota_all_output(inp)):
        combo_vs_all += 1
    if not np.array_equal(combo, presence_threshold_output(inp)):
        combo_vs_presence += 1

    g = np.asarray(inp, dtype=int)
    bg = mod._bg_boundary(g)
    _, _, legend_counts = mod._find_legend(g, bg)
    threshold = mod._delete_threshold(len(legend_counts))
    legend_colors = set(legend_counts)
