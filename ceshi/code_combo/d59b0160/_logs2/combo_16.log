+                np.zeros_like(patch),
+                transparent=BG,
+                padding=1,
+                padding_connectivity=8,
+            )
+        except ValueError:
+            return None
+
+        paste(inp, patch, r, c)
+        if not role.startswith("deleted_"):
+            paste(out, patch, r, c)
+
+    if np.array_equal(main(inp), out):
+        return inp
+    return None
+
+
+def generate_input() -> np.ndarray:
