+        elif mode == "wide":
+            h, w = random.randint(*WIDE_H), random.randint(*WIDE_W)
+        else:
+            h, w = random.randint(*MED_H), random.randint(*MED_W)
+        if h * w >= min_area:
+            return h, w
+    h = max(3, min_area)
+    w = max(2, math.ceil(min_area / h))
+    return h, w
