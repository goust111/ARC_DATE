        comp_counts = Counter(int(g[r, c]) for r, c in pts)
        quota_matched = mod._matched_legend_kinds(comp_counts, legend_counts)
        presence_matched = len(set(comp_counts) & legend_colors)
        if quota_matched > threshold and quota_matched < len(legend_counts):
            quorum_only_deleted += 1
        if presence_matched > threshold and quota_matched <= threshold:
            quota_saved_kept += 1

print({
