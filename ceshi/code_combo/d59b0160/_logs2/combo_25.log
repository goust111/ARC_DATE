+    if any(direct_deleted):
+        return None
+    if combo_deleted == direct_deleted:
+        return None
+
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_RETRIES):
+        grid = _gen_attempt()
