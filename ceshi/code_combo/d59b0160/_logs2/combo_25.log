+    rank_orders = [_sample_rank_colors(legend_top, legend_bottom) for _ in range(3)]
+    patterns = ["fusion", "wrong", "mixed"]
+    components = [_build_patch(pattern, rank_orders[idx]) for idx, pattern in enumerate(patterns)]
