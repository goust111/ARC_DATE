+    bg = _bg_boundary(inp)
+    combo_deleted = tuple(
+        not np.array_equal(inp[r : r + PATCH_H, c : c + PATCH_W], combo_out[r : r + PATCH_H, c : c + PATCH_W])
+        for r, c in PATCH_ANCHORS
