+def _place_legend(inp: np.ndarray, out: np.ndarray, legend_top: list[int], legend_bottom: list[int]) -> None:
+    """Draw the 4x4 legend box and encode 3 column-wise token pairs."""
+    s = LEGEND_SIZE
+    for g in (inp, out):
+        g[:s, :s] = BG
+        g[s - 1, :s] = BORDER
+        g[:s, s - 1] = BORDER
