+GRID_H, GRID_W = 16, 16
+BG = 7
+BORDER = 3
+SCAFFOLD = 0
+LEGEND_SIZE = 4
+PALETTE = [1, 2, 4, 5, 6, 8, 9]
+NUM_PAIRS = 3
+NUM_LEGEND_TOKENS = 2 * NUM_PAIRS
+PATCH_H, PATCH_W = 6, 6
+PATCH_ANCHORS = [(1, 9), (9, 1), (9, 9)]
