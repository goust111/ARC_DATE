+    colors = forced + [random.choice(allowed) for _ in range(n_colored - len(forced))]
+    random.shuffle(colors)
+
+    patch = np.zeros((h, w), dtype=int)
+    rs, cs = zip(*coords)
+    patch[rs, cs] = colors
+    return patch
