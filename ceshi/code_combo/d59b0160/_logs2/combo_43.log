+    Return (size, border_color, interior_target_colors).
+    """
+    h, w = g.shape
+    for sz in range(2, min(h, w) + 1):
+        x = int(g[sz - 1, sz - 1])
+        if x == bg:
+            continue
+        if np.all(g[sz - 1, :sz] == x) and np.all(g[:sz, sz - 1] == x):
+            inside = g[: sz - 1, : sz - 1]
