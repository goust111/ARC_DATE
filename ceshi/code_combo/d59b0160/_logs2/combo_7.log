+BG = 7
+BORDER = 3
+LEGEND_SIZE = 4
+PALETTE = [1, 2, 4, 5, 6, 8, 9]
+NUM_TARGETS = 3
+
+DENSITY_LO = 0.12
+DENSITY_HI = 0.50
+MAX_RETRIES = 400
+
+KEEP_SINGLES = 2
+DELETE_SINGLES = 2
+
+
