+    h: int,
+    w: int,
+    guaranteed: list[int],
+    extras: list[int],
+) -> np.ndarray:
+    """Build one full rectangular component: color 0 base plus scattered accent colors."""
+    area = h * w
+    lo = max(1, math.ceil(area * DENSITY_LO), len(guaranteed))
+    hi = max(lo, math.floor(area * DENSITY_HI))
