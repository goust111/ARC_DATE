+# Combo variant of d59b0160 (index 7)
+# combo_spec: D1/2+D4/0
+# Name: 8-连通+不含图例颜色则删除
+
+import math
+import random
+import sys
+from pathlib import Path
+
+import numpy as np
+
+SOLVER_DIR = Path(__file__).resolve().parents[4] / "solvers"
+if str(SOLVER_DIR) not in sys.path:
+    sys.path.append(str(SOLVER_DIR))
