   116	def _bg_boundary(g: np.ndarray) -> int:
   117	    """Most common color along the 1-cell outer border."""
   118	    border = np.concatenate([g[0, :], g[-1, :], g[1:-1, 0], g[1:-1, -1]])
   119	    vals, cnts = np.unique(border, return_counts=True)
   120	    return int(vals[cnts.argmax()])
   121	
   122	
   123	def _legend_candidates(g: np.ndarray, bg: int) -> list[tuple[str, int, int, set[int], np.ndarray]]:
   124	    """Find top-left single-line legend separators and return candidate descriptors."""
   125	    h, w = g.shape
   126	    candidates: list[tuple[str, int, int, set[int], np.ndarray]] = []
   127	
   128	    for c in range(1, w - 1):
   129	        x = int(g[0, c])
   130	        if x == bg:
   131	            continue
   132	        if np.all(g[:, c] == x):
   133	            legend_side = g[:, :c]
   134	            payload_mask = (legend_side != bg) & (legend_side != x)
   135	            colors = set(map(int, np.unique(legend_side[payload_mask])))
   136	            if payload_mask.sum() == NUM_TARGETS and len(colors) == NUM_TARGETS and not np.any(legend_side == 0):
   137	                main_mask = np.zeros_like(g, dtype=bool)
   138	                main_mask[:, c + 1 :] = True
   139	                candidates.append(("vertical", c, x, colors, main_mask))
   140	
   141	    for r in range(1, h - 1):
   142	        x = int(g[r, 0])
   143	        if x == bg:
   144	            continue
   145	        if np.all(g[r, :] == x):
   146	            legend_side = g[:r, :]
   147	            payload_mask = (legend_side != bg) & (legend_side != x)
   148	            colors = set(map(int, np.unique(legend_side[payload_mask])))
   149	            if payload_mask.sum() == NUM_TARGETS and len(colors) == NUM_TARGETS and not np.any(legend_side == 0):
   150	                main_mask = np.zeros_like(g, dtype=bool)
   151	                main_mask[r + 1 :, :] = True
   152	                candidates.append(("horizontal", r, x, colors, main_mask))
   153	
   154	    return candidates
