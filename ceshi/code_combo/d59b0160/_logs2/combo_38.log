   246	def _place_legend(inp: np.ndarray, out: np.ndarray, sep_col: int, targets: list[int]) -> None:
   247	    """Draw the full-height legend divider and place 3 swatches in the top-left strip."""
   248	    for g in (inp, out):
   249	        g[:, sep_col] = BORDER
   250	
   251	    cells = [(r, c) for r in range(LEGEND_ROWS) for c in range(sep_col)]
   252	    for color, (r, c) in zip(targets, random.sample(cells, len(targets))):
   253	        inp[r, c] = color
   254	        out[r, c] = color
   255	
