   380	def _gen_attempt() -> np.ndarray | None:
   381	    """Construct one candidate input and keep only layouts that exhibit the fused behavior."""
   382	    inp = np.full((GRID_H, GRID_W), BG, dtype=int)
   383	    out = inp.copy()
   384	
   385	    targets = random.sample(PALETTE, NUM_TARGETS)
   386	    sep_col = random.choice(LEGEND_SEP_COLS)
   387	    split_r = random.choice(SPLIT_ROWS)
   388	    split_c = random.choice([c for c in SPLIT_COLS if c > sep_col + 3])
   389	
   390	    _place_legend(inp, out, sep_col, targets)
   391	    _draw_main_separators(inp, out, sep_col, split_r, split_c)
   392	
   393	    boxes = _region_boxes(sep_col, split_r, split_c)
   394	    deleted_idx = set(random.sample(range(len(boxes)), DELETED_REGIONS))
   395	    for idx, box in enumerate(boxes):
   396	        if not _populate_region(inp, out, box, targets, idx in deleted_idx):
   397	            return None
   398	
   399	    metrics = _region_metrics(inp)
   400	    if metrics["deleted_regions"] != DELETED_REGIONS:
   401	        return None
   402	    if metrics["region_only_deleted"] < 1:
   403	        return None
   404	    if metrics["ordinary_vertical_walls"] < 1:
   405	        return None
   406	    if np.array_equal(main(inp), out):
   407	        return inp
   408	    return None
   409	
   410	
   411	def generate_input() -> np.ndarray:
   412	    for _ in range(MAX_RETRIES):
   413	        grid = _gen_attempt()
   414	        if grid is not None:
   415	            return grid
   416	    raise RuntimeError("failed to generate valid input")

