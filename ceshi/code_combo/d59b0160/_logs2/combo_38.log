   164	
   165	def _separator_regions(g: np.ndarray, main_mask: np.ndarray, border_color: int) -> list[np.ndarray]:
   166	    """Connected regions inside the main area after treating color-3 lines as walls."""
   167	    region_space = main_mask & (g != border_color)
   168	    return components_mask(region_space, connectivity=4)
   169	
   170	
   171	def _region_object_points(g: np.ndarray, region: np.ndarray, bg: int) -> list[tuple[int, int]]:
   172	    """All non-background pixels inside one region."""
   173	    return [(int(r), int(c)) for r, c in region if int(g[r, c]) != bg]
   174	
   175	
   176	def _region_metrics(g: np.ndarray) -> dict[str, int]:
   177	    """Quantify whether region-level deletion really differs from componentwise deletion."""
   178	    bg = _bg_boundary(g)
   179	    orient, idx, border_color, legend_colors, main_mask = _find_single_line_legend(g, bg)
   180	    deleted_regions = 0
   181	    region_only_deleted = 0
   182	    full_height_vertical_walls = sum(int(np.all(g[:, c] == border_color)) for c in range(g.shape[1]))
   183	
   184	    for region in _separator_regions(g, main_mask, border_color):
   185	        object_pts = _region_object_points(g, region, bg)
   186	        if not object_pts:
   187	            continue
   188	        cols = {int(g[r, c]) for r, c in object_pts}
   189	        if not legend_colors.issubset(cols):
   190	            continue
   191	        deleted_regions += 1
   192	
   193	        object_mask = np.zeros_like(g, dtype=bool)
   194	        for r, c in object_pts:
   195	            object_mask[r, c] = True
   196	        comps = components_mask(object_mask, connectivity=4)
   197	        if all(not legend_colors.issubset({int(g[r, c]) for r, c in comp}) for comp in comps):
   198	            region_only_deleted += 1
   199	
   200	    ordinary_vertical_walls = full_height_vertical_walls - (1 if orient == "vertical" else 0)
   201	    return {
   202	        "legend_divider_index": int(idx),
   203	        "deleted_regions": int(deleted_regions),
   204	        "region_only_deleted": int(region_only_deleted),
   205	        "ordinary_vertical_walls": int(ordinary_vertical_walls),
   206	    }
