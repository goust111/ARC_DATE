   336	def _populate_region(
   337	    inp: np.ndarray,
   338	    out: np.ndarray,
   339	    box: tuple[int, int, int, int],
   340	    targets: list[int],
   341	    deleted: bool,
   342	) -> bool:
   343	    """Place one region's disconnected objects without crossing walls."""
   344	    r0, c0, r1, c1 = box
   345	    box_h = r1 - r0 + 1
   346	    box_w = c1 - c0 + 1
   347	    if box_h < 2 or box_w < 2:
   348	        return False
   349	
   350	    plans = _deleted_region_plan(targets) if deleted else _kept_region_plan(targets)
   351	    region_canvas = np.full((box_h, box_w), BG, dtype=int)
   352	
   353	    for required, allowed_targets in plans:
   354	        placed = False
   355	        for _ in range(25):
   356	            h, w = _component_dims(box_h, box_w, region_canvas)
   357	            patch = _component_patch(h, w, required, allowed_targets, targets)
   358	            try:
   359	                rr, cc = random_free_location(
   360	                    region_canvas,
   361	                    patch,
   362	                    transparent=BG,
   363	                    padding=1,
   364	                    padding_connectivity=8,
   365	                )
   366	            except ValueError:
   367	                continue
   368	            paste(region_canvas, patch, rr, cc)
   369	            placed = True
   370	            break
   371	        if not placed:
   372	            return False
   373	
   374	    paste(inp, region_canvas, r0, c0, transparent=BG)
   375	    if not deleted:
   376	        paste(out, region_canvas, r0, c0, transparent=BG)
   377	    return True
