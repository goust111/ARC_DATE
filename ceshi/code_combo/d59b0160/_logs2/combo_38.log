   209	def main(grid: np.ndarray) -> np.ndarray:
   210	    """
   211	    Erase every separator-bounded main-board region whose combined object colors match the legend palette.
   212	
   213	    Input structure:
   214	    - A straight color-3 separator line near the top-left acts as the legend divider instead of the original L-shaped frame.
   215	    - The top-left side of that divider contains exactly three target-color swatches on background.
   216	    - On the main side of the divider, extra color-3 lines further split the board into multiple regions.
   217	    - Each region may contain one or more disconnected non-background objects made from black rectangles with colored accents.
   218	
   219	    Rule:
   220	    - Identify the unique single color-3 line whose top-left side is the tiny legend strip, then read the three legend colors from that side.
   221	    - Restrict attention to the cells on the opposite side of that divider: this is the main board.
   222	    - Treat every color-3 line in the main board as a wall and split the main board into 4-connected regions.
   223	    - For each region, collect all non-background, non-3 object pixels in the region.
   224	    - If the union of those colors contains all legend colors, erase every object pixel in that region; otherwise keep the region unchanged.
   225	
   226	    Key insight: color 3 has two structural jobs at once, so the solver must first separate the legend-defining line from the ordinary walls, then evaluate target coverage region by region rather than object by object.
   227	    """
   228	    g = np.asarray(grid, dtype=int)
   229	    bg = _bg_boundary(g)
   230	
   231	    _orient, _idx, border_color, legend_colors, main_mask = _find_single_line_legend(g, bg)
   232	    assert legend_colors, "legend contains no target colors"
   233	
   234	    out = g.copy()
   235	    for region in _separator_regions(g, main_mask, border_color):
   236	        object_pts = _region_object_points(g, region, bg)
   237	        if not object_pts:
   238	            continue
   239	        cols = {int(g[r, c]) for r, c in object_pts}
   240	        if legend_colors.issubset(cols):
   241	            for r, c in object_pts:
   242	                out[r, c] = bg
   243	    return out
