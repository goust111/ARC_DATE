   156	
   157	def _find_single_line_legend(g: np.ndarray, bg: int) -> tuple[str, int, int, set[int], np.ndarray]:
   158	    """Return the unique top-left legend separator: (orientation, index, border_color, colors, main_mask)."""
   159	    candidates = _legend_candidates(g, bg)
   160	    assert candidates, "no single-line legend separator found"
   161	    assert len(candidates) == 1, "ambiguous single-line legend separator"
   162	    return candidates[0]
