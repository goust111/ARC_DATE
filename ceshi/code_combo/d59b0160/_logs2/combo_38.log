    99	GRID_H, GRID_W = 16, 16
   100	BG = 7
   101	BORDER = 3
   102	PALETTE = [1, 2, 4, 5, 6, 8, 9]
   103	NUM_TARGETS = 3
   104	
   105	LEGEND_ROWS = 4
   106	LEGEND_SEP_COLS = [3, 4]
   107	SPLIT_ROWS = [6, 7, 8, 9, 10]
   108	SPLIT_COLS = [9, 10, 11, 12]
   109	
   110	DELETED_REGIONS = 2
   111	MAX_RETRIES = 500
   112	DENSITY_LO = 0.18
   113	DENSITY_HI = 0.50
