   274	def _component_dims(box_h: int, box_w: int, region_canvas: np.ndarray) -> tuple[int, int]:
   275	    """Choose a compact rectangle that fits the local region and leaves room for peers."""
   276	    existing = int(np.count_nonzero(region_canvas != BG))
   277	    max_h = min(4 if existing == 0 else 3, box_h)
   278	    max_w = min(4 if existing == 0 else 3, box_w)
   279	    min_h = 2 if box_h >= 2 else 1
   280	    min_w = 2 if box_w >= 2 else 1
   281	    return random.randint(min_h, max_h), random.randint(min_w, max_w)
   282	
   283	
   284	def _component_patch(
   285	    h: int,
   286	    w: int,
   287	    required: list[int],
   288	    allowed_targets: list[int],
   289	    legend_targets: list[int],
   290	) -> np.ndarray:
   291	    """Build one black-based rectangular object and force selected target colors to appear."""
   292	    area = h * w
   293	    lo = max(len(required), math.ceil(area * DENSITY_LO))
   294	    hi = max(lo, math.floor(area * DENSITY_HI))
   295	    n_colored = random.randint(lo, hi)
   296	
   297	    coords = random.sample([(r, c) for r in range(h) for c in range(w)], n_colored)
   298	    non_targets = [v for v in PALETTE if v not in legend_targets]
   299	    color_pool = non_targets + list(allowed_targets)
   300	    if not color_pool:
   301	        color_pool = non_targets[:]
   302	
   303	    colors = list(required)
   304	    colors.extend(random.choice(color_pool) for _ in range(n_colored - len(required)))
   305	    random.shuffle(colors)
   306	
   307	    patch = np.zeros((h, w), dtype=int)
   308	    for (r, c), color in zip(coords, colors):
   309	        patch[r, c] = color
   310	    return patch
   311	
   312	
   313	def _deleted_region_plan(targets: list[int]) -> list[tuple[list[int], list[int]]]:
   314	    """Split all 3 target colors across multiple objects so only the whole region qualifies."""
   315	    shuffled = random.sample(targets, len(targets))
   316	    pattern = random.choice(["2+1", "1+1+1"])
   317	    if pattern == "2+1":
   318	        groups = [shuffled[:2], shuffled[2:]]
   319	    else:
   320	        groups = [[color] for color in shuffled]
   321	    return [(group, group) for group in groups]
   322	
   323	
   324	def _kept_region_plan(targets: list[int]) -> list[tuple[list[int], list[int]]]:
   325	    """Choose a strict subset of legend colors for a kept region and distribute it."""
   326	    n_components = random.choice([1, 2])
   327	    present_count = random.randint(0, NUM_TARGETS - 1)
   328	    present = random.sample(targets, present_count)
   329	    required_lists = [[] for _ in range(n_components)]
   330	    for idx, color in enumerate(present):
   331	        required_lists[idx % n_components].append(color)
   332	    random.shuffle(required_lists)
   333	    return [(required, present) for required in required_lists]
