+TALL_H = (6, 12)
+TALL_W = (2, 4)
+WIDE_H = (3, 5)
+WIDE_W = (5, 8)
+MED_H = (3, 6)
+MED_W = (3, 7)
+
+DENSITY_LO = 0.10
+DENSITY_HI = 0.50
+
+COMP_COUNTS = [4, 5, 6]
+COMP_WEIGHTS = [3, 5, 4]
+NUM_NONMATCH = 1
