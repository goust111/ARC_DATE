+
+    deleted: list[np.ndarray] = []
+    for pts in components_mask(g != bg, connectivity=4):
+        if _is_legend_component(pts, sz):
+            continue
+        cols = {int(g[r, c]) for r, c in pts}
+        if not legend_colors.issubset(cols):
