+    r0, c0, r1, c1 = bbox_coords(all_pts)
+    out = np.full((r1 - r0 + 1, c1 - c0 + 1), bg, dtype=int)
+    for pts in deleted:
+        for r, c in pts:
+            out[int(r) - r0, int(c) - c0] = int(g[r, c])
+    return out
+
+
+# --------------- generator (combo 32) ---------------
+
+GRID_H, GRID_W = 16, 16
+BG = 7
+BORDER = 3
+LEGEND_SIZE = 4
+PALETTE = [1, 2, 4, 5, 6, 8, 9]
+NUM_TARGETS = 3
+
+SHAPE_WEIGHTS = [6, 2, 2]
+TALL_H = (6, 12)
+TALL_W = (2, 4)
+WIDE_H = (3, 5)
+WIDE_W = (5, 8)
+MED_H = (3, 6)
+MED_W = (3, 7)
+
+DENSITY_LO = 0.10
+DENSITY_HI = 0.50
+
+COMP_COUNTS = [4, 5, 6]
+COMP_WEIGHTS = [3, 5, 4]
