+    non_targets = [v for v in PALETTE if v not in targets]
+
+    if deleted:
+        colors = list(targets) + [random.choice(PALETTE) for _ in range(n_colored - len(targets))]
+    else:
+        used_target_count = random.randint(0, len(targets) - 1)
