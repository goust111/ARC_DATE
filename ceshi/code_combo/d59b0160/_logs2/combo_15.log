+
+
+def _place_legend(
+    inp: np.ndarray,
+    out: np.ndarray,
+    placement: np.ndarray,
+    inner: int,
+    targets: list[int],
+) -> None:
+    """Draw a variable-size legend and reserve its full square for later placement."""
+    outer = inner + 1
+    for g in (inp, out):
+        g[:outer, :outer] = BG
+        g[outer - 1, :outer] = BORDER
+        g[:outer, outer - 1] = BORDER
