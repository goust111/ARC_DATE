    11	
    12	sys.path.append(os.path.join(os.path.dirname(__file__), "..", "..", "..", "..", "solvers"))
    13	from arc_utils import components_mask, paste, random_free_location
    14	
    15	
    16	# Design analysis for the combo variant
    17	# -------------------------------------
    18	# a) Concrete behavior and trace:
    19	#    - Keep two readable legends with the same color-3 frame language:
    20	#      top-left legend = original orientation, bottom-right legend = mirrored orientation.
    21	#    - Add one horizontal and one vertical color-3 separator to partition the non-legend board
    22	#      into four wall-bounded regions.
    23	#    - Each round reads one legend, then checks each separator-defined region as a whole.
    24	#      If the union of colors on all non-background object pixels inside that region contains
    25	#      the full legend set, erase every object pixel in that region.
    26	#    - Small trace:
    27	#        round-1 legend = {1,4,8}
    28	#        one region has two disconnected objects with colors {0,1,4} and {0,8,5}
    29	#        original task: neither component has all {1,4,8}, so both survive
    30	#        combo task, round 1: the region union has {0,1,4,8,5}, so the whole region is erased
    31	#        another region may realize only the second legend colors, so it survives round 1 and
    32	#        disappears only after round 2. This makes both "region scope" and "ordered rounds"
    33	#        visible in the same sample.
    34	# b) Complexity calibration:
