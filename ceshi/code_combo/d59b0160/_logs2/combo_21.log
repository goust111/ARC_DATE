+    roles = random.choice(ROLE_BLUEPRINTS).copy()
+    random.shuffle(roles)
+    for spec, role in zip(specs, roles):
+        plans = _component_plans_for_role(first, second, extras, role)
+        if not _populate_region(inp, spec, plans):
