+                    comp_match = True
+                    break
+            if not comp_match:
+                metrics["split_deleted_regions"] += 1
+
+        out[object_mask] = bg
+    return metrics
+
+
+def _solve_with_metrics(grid: np.ndarray, *, collect_metrics: bool) -> tuple[np.ndarray, dict]:
+    g = np.asarray(grid, dtype=int)
