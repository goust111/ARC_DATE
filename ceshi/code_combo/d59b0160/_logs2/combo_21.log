+    return specs
+
+
+def _paint_forbidden(canvas: np.ndarray, bbox: tuple[int, int, int, int], value: int) -> None:
+    r0, c0, r1, c1 = bbox
+    rr0 = max(0, r0)
+    cc0 = max(0, c0)
+    rr1 = min(canvas.shape[0] - 1, r1)
+    cc1 = min(canvas.shape[1] - 1, c1)
+    if rr0 <= rr1 and cc0 <= cc1:
+        canvas[rr0 : rr1 + 1, cc0 : cc1 + 1] = value
