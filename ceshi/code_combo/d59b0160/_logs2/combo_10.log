+
+def _is_legend_component(pts: np.ndarray, sz: int) -> bool:
+    """Legend cells live entirely inside the top-left sz x sz square."""
+    return bool(np.all(pts[:, 0] < sz) and np.all(pts[:, 1] < sz))
