import importlib.util
import numpy as np
from collections import Counter

new_path = '/home/lixinyu/snap/new/ceshi/code_combo/d59b0160/12/code.py'
old_path = '/home/lixinyu/snap/new/arc2_solver_select/d59b0160.py'

def load(path, name):
    spec = importlib.util.spec_from_file_location(name, path)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod

new = load(new_path, 'new_variant')
old = load(old_path, 'old_variant')

n = 100
legend_sizes = Counter()
deleted_counts = Counter()
old_same = 0
old_diff = 0
old_err = 0
all_black_bg = 0
all_full_rect = 0

for _ in range(n):
    inp = new.generate_input()
