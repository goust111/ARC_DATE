+    out = g.copy()
+    for pts in components_mask(_nonlegend_mask(g, bg, legend_size), connectivity=4):
+        cols = {int(g[r, c]) for r, c in pts}
+        if legend_colors.issubset(cols):
+            out[pts[:, 0], pts[:, 1]] = bg
+    return out
