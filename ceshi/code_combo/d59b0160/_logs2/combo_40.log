+        (2,): [2],
+        (4,): [4],
+        (8,): [8],
+        (1, 2): [1, 2],
+        (1, 4): [5],
+        (1, 8): [9],
+        (2, 4): [6],
+        (2, 8): [6, 8],
+        (4, 8): [6, 8],
+        (1, 2, 4): [5, 6],
+        (1, 2, 8): [6, 9],
+        (1, 4, 8): [5, 9],
+        (2, 4, 8): [6, 8],
