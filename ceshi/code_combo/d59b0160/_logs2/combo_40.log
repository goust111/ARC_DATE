+GRID_H, GRID_W = 16, 16
+BG = 7
+BORDER = 3
+LEGEND_SIZE = 4
+
+BASIS_COLORS = [1, 2, 4, 8]
+OBJECT_COLORS = [0, 1, 2, 4, 5, 6, 8, 9]
