+BASIS_COLORS = [1, 2, 4, 8]
+OBJECT_COLORS = [0, 1, 2, 4, 5, 6, 8, 9]
+
+COMP_COUNTS = [4, 5, 6]
+COMP_WEIGHTS = [2, 4, 4]
+KEEP_COUNT_ZERO_FREE = 3
+
+SHAPE_WEIGHTS = [5, 3, 2]  # medium, tall, wide
+TALL_H = (7, 12)
+TALL_W = (2, 4)
+WIDE_H = (3, 5)
+WIDE_W = (5, 9)
+MED_H = (3, 7)
+MED_W = (2, 8)
+
+DENSITY_LO = 0.10
+DENSITY_HI = 0.42
+MAX_RETRIES = 800
+
