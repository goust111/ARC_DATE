+
+def _gen_attempt() -> np.ndarray | None:
+    """Build one candidate input and reject degenerate samples."""
+    grid = np.full((GRID_H, GRID_W), BG, dtype=int)
+    reserve = np.full((GRID_H, GRID_W), BG, dtype=int)
