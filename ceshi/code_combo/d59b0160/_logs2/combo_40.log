+
+def _nonlegend_mask(g: np.ndarray, bg: int, legend_size: int) -> np.ndarray:
+    """Foreground mask with the legend square removed."""
+    mask = (g != bg).copy()
+    mask[:legend_size, :legend_size] = False
+    return mask
+
