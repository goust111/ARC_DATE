+        placed.append((r0, c0, mask, holes, input_border, is_matched))
+        sh, sw = mask.shape
+        occ[max(0, r0 - 1) : min(h, r0 + sh + 1), max(0, c0 - 1) : min(w, c0 + sw + 1)] = True
+
+    inp = output.copy()
+    swap_border_cells = 0
+    self_fill_cells = 0
+    for r0, c0, mask, holes, input_border, is_matched in placed:
