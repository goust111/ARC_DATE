+            for rr, cc in neighbors4(int(r), int(c)):
+                if 0 <= rr < h and 0 <= cc < w and not pal_mask[rr, cc]:
+                    col = int(inp[rr, cc])
+                    if col != bg:
+                        adj_counts[col] = adj_counts.get(col, 0) + 1
+
+        border = None
+        best = -1
+        for col, cnt in adj_counts.items():
+            if col in mapping and cnt > best:
+                border = col
+                best = cnt
+        if border is None:
+            continue
+
+        fill = int(mapping[border])
+        for r, c in pts:
+            out[r, c] = fill
