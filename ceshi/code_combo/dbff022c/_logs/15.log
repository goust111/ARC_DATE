+
+def _legacy_like_output(inp: np.ndarray) -> np.ndarray:
+    g = np.asarray(inp, dtype=int)
+    bg = _bg_boundary(g)
+    mapping, pal_mask = _palette_mapping(g, bg)
+    out = g.copy()
+    _legacy_fill_enclosed_bg_regions(g, out, bg, mapping, pal_mask)
+    return out
