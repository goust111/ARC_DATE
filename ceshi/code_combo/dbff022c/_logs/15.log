+# --------------- generator (rectangular-frame bbox-fill combo) ---------------
+
+_GRID_H_MIN, _GRID_H_MAX = 8, 13
+_GRID_W_MIN, _GRID_W_MAX = 10, 15
+_PALETTE_N_MIN, _PALETTE_N_MAX = 2, 4
+_SPRITE_H_MIN, _SPRITE_H_MAX = 4, 7
+_SPRITE_W_MIN, _SPRITE_W_MAX = 4, 6
