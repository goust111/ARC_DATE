+
+def _paint_bbox_fill(grid: np.ndarray, r0: int, c0: int, mask: np.ndarray, fill: int) -> None:
+    sh, sw = mask.shape
+    for rr in range(sh):
+        for cc in range(sw):
+            if not mask[rr, cc]:
