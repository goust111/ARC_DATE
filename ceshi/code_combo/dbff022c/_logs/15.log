+        r0, c0 = 0, rng.randint(0, w - pw)
+    elif side == "bottom":
+        r0, c0 = h - ph, rng.randint(0, w - pw)
+    elif side == "left":
+        r0, c0 = rng.randint(0, h - ph), 0
