+
+
+def _make_rect_frame(h: int, w: int, rng: random.Random, gapped: bool) -> tuple[np.ndarray, int]:
+    mask = np.zeros((h, w), dtype=bool)
+    mask[0, :] = True
+    mask[-1, :] = True
+    mask[:, 0] = True
+    mask[:, -1] = True
+    gap_len = 0
+
