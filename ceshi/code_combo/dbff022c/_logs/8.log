   498	        pal = np.zeros((2, n_pairs), dtype=int)
   499	        outer, inner = (0, 1) if side == "top" else (1, 0)
   500	        pal[outer] = border_keys
   501	        pal[inner] = fill_values
   502	    else:
   503	        pal = np.zeros((n_pairs, 2), dtype=int)
   504	        outer, inner = (0, 1) if side == "left" else (1, 0)
   505	        pal[:, outer] = border_keys
   506	        pal[:, inner] = fill_values
   507	    return pal
   508	
   509	
   510	def _place_palette(
   511	    grid: np.ndarray, occ: np.ndarray, pal: np.ndarray, side: str, rng: random.Random
   512	) -> None:
   513	    """Place the palette on the chosen edge and reserve a 1-cell padding zone."""
   514	    h, w = grid.shape
