   312	    delete_ids: set[int] = set()
   313	    bg_mask = (g == bg) & (~pal_mask)
   314	    for pts in components_mask(bg_mask, connectivity=4):
   315	        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):
   316	            continue
   317	
   318	        adj_counts: dict[int, int] = {}
   319	        adj_color_to_ids: dict[int, set[int]] = {}
   320	        for r, c in pts:
   321	            for rr, cc in neighbors4(int(r), int(c)):
   322	                if not (0 <= rr < h and 0 <= cc < w):
   323	                    continue
   324	                if pal_mask[rr, cc]:
   325	                    continue
   326	                v = int(g[rr, cc])
   327	                if v == bg:
   328	                    continue
   329	                adj_counts[v] = adj_counts.get(v, 0) + 1
   330	                cid = int(comp_id[rr, cc])
   331	                if cid >= 0:
   332	                    adj_color_to_ids.setdefault(v, set()).add(cid)
   333	
   334	        if not adj_counts:
   335	            continue
   336	
   337	        mapped_border = None
   338	        mapped_count = -1
   339	        for color, count in adj_counts.items():
   340	            if color in mapping and count > mapped_count:
   341	                mapped_border = int(color)
   342	                mapped_count = int(count)
   343	
   344	        if mapped_border is not None:
   345	            fills.append((pts, int(mapping[mapped_border])))
   346	            continue
   347	
   348	        unmatched_border = max(adj_counts.items(), key=lambda item: item[1])[0]
   349	        for cid in adj_color_to_ids.get(int(unmatched_border), set()):
   350	            delete_ids.add(int(cid))
   351	
   352	    for pts, fill in fills:
   353	        _checkerboard_fill_region(out, pts, fill)
   354	    for cid in delete_ids:
   355	        for r, c in obj_comps[cid]:
   356	            out[int(r), int(c)] = bg
   357	
   358	
   359	def main(grid: np.ndarray) -> np.ndarray:
   360	    """
   361	    Use an edge palette to both filter hollow sprites and checker-fill the ones that survive.
   362	
   363	    Input structure:
   364	    - The outer border is mostly background, with several hollow single-color sprites inside the grid.
   365	    - A compact 2xN or Nx2 legend lies on one edge; its outer line lists sprite border colors and its
   366	      inner line lists the corresponding fill colors.
   367	
   368	    Rule:
   369	    - Read the edge legend as a border-to-fill mapping.
   370	    - Find enclosed background regions that act as sprite interiors, ignoring the palette area itself.
   371	    - If a hole is surrounded by a border color found in the palette, fill only the even-parity hole
   372	      cells with the mapped color and leave the odd-parity hole cells as background.
   373	    - If a hole is surrounded by a border color absent from the palette, erase the whole touching sprite
   374	      back to the background color.
   375	
   376	    Key insight:
   377	    - The palette does two jobs at once: it says which border colors survive and what fill color they use.
   378	    - Surviving interiors are not solid; the mapped color must be written on alternating grid positions
   379	      based on absolute row-plus-column parity.
   380	    """
   381	    g = np.asarray(grid, dtype=int)
   382	    bg = _bg_boundary(g)
   383	    mapping, pal_mask = _palette_mapping(g, bg)
   384	    assert mapping, "main: palette mapping must be non-empty"
   385	
   386	    out = g.copy()
   387	    _apply_combo_transform(out, g, bg, mapping, pal_mask)
   388	    return out
   389	
   390	
   391	# --------------- generator (combo variant) ---------------
   392	
   393	# Grid
   394	_GRID_H_MIN, _GRID_H_MAX = 4, 13
   395	_GRID_W_MIN, _GRID_W_MAX = 10, 15
   396	_SMALL_H_THRESHOLD = 6
   397	_SMALL_H_PALETTE_FLIP = 0.7
   398	_TINY_H_THRESHOLD = 5
   399	
   400	# Palette
   401	_PALETTE_N_MIN, _PALETTE_N_MAX = 2, 5
   402	
   403	# Sprite geometry
   404	_SPRITE_H_MAX = 7
   405	_SPRITE_W_MAX = 6
   406	_SPRITE_DIM_SUM_CAP = 10
   407	_SPRITE_CELL_MAX = 16
   408	_FILLED_SPRITE_MAX = 3
   409	
   410	# Sprite mutation
   411	_P_HORIZ_WALL = 0.3
   412	_P_VERT_WALL = 0.3
   413	_P_BORDER_REMOVAL = 0.4
   414	_P_DIAMOND = 0.2
   415	
   416	# Generation
   417	_MAX_RETRIES = 300
   418	
   419	
   420	def _get_enclosed_holes(sprite: np.ndarray) -> list[np.ndarray]:
   421	    """Return point-arrays for bg components not touching the sprite boundary."""
   422	    h, w = sprite.shape
   423	    return [
   424	        pts
   425	        for pts in components_mask(~sprite, connectivity=4)
   426	        if not any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)
   427	    ]
   428	
   429	
   430	def _make_diamond() -> np.ndarray:
   431	    """Return a 3x3 diamond-shaped hollow mask."""
   432	    sprite = np.zeros((3, 3), dtype=bool)
   433	    sprite[0, 1] = True
   434	    sprite[1, 0] = True
   435	    sprite[1, 2] = True
   436	    sprite[2, 1] = True
   437	    return sprite
   438	
   439	
   440	def _make_hollow_sprite(h: int, w: int, rng: random.Random) -> np.ndarray | None:
   441	    """Create a hollow sprite with at least one enclosed hole and limited border area."""
   442	    sprite = np.ones((h, w), dtype=bool)
   443	    if h >= 3 and w >= 3:
   444	        sprite[1:-1, 1:-1] = False
   445	    if h >= 5 and w >= 4 and rng.random() < _P_HORIZ_WALL:
   446	        br = rng.randint(2, h - 2)
   447	        n = rng.randint(1, w - 2)
   448	        s = rng.randint(1, w - n - 1)
   449	        sprite[br, s : s + n] = True
   450	    if h >= 4 and w >= 5 and rng.random() < _P_VERT_WALL:
   451	        bc = rng.randint(2, w - 2)
   452	        n = rng.randint(1, h - 2)
   453	        s = rng.randint(1, h - n - 1)
   454	        sprite[s : s + n, bc] = True
   455	    if rng.random() < _P_BORDER_REMOVAL:
   456	        border_cells = [
   457	            (r, c)
   458	            for r in range(h)
   459	            for c in range(w)
   460	            if sprite[r, c] and (r in (0, h - 1) or c in (0, w - 1))
   461	        ]
   462	        rng.shuffle(border_cells)
   463	        for rr, cc in border_cells[: rng.randint(1, min(4, len(border_cells)))]:
   464	            test = sprite.copy()
   465	            test[rr, cc] = False
   466	            if _get_enclosed_holes(test):
   467	                sprite = test
   468	    holes = _get_enclosed_holes(sprite)
   469	    if not holes or int(sprite.sum()) > _SPRITE_CELL_MAX:
   470	        return None
   471	    return sprite
   472	
   473	
   474	def _choose_colors(
   475	    rng: random.Random, n_pairs: int, num_matched: int
   476	) -> tuple[list[int], list[int], int, dict[int, int], list[int]]:
   477	    """Pick palette colors, one distractor color, and the matched sprite border keys."""
   478	    all_colors = list(range(1, 10))
   479	    rng.shuffle(all_colors)
   480	    border_keys = all_colors[:n_pairs]
   481	    rng.shuffle(all_colors)
   482	    fill_values = all_colors[:n_pairs]
   483	    distractor_candidates = [
   484	        c for c in range(1, 10) if c not in border_keys and c not in fill_values
   485	    ]
   486	    if not distractor_candidates:
   487	        distractor_candidates = [c for c in range(1, 10) if c not in border_keys]
   488	    distractor_color = int(rng.choice(distractor_candidates))
   489	    mapping = dict(zip(border_keys, fill_values))
   490	    matched_keys = rng.sample(border_keys, num_matched)
   491	    return border_keys, fill_values, distractor_color, mapping, matched_keys
   492	
   493	
   494	def _build_palette(side: str, border_keys: list[int], fill_values: list[int]) -> np.ndarray:
   495	    """Construct the 2xN or Nx2 palette array for the chosen edge."""
   496	    n_pairs = len(border_keys)
