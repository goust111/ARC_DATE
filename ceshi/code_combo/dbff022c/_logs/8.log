   517	        r0, c0 = 0, rng.randint(0, w - pal_w)
   518	    elif side == "bottom":
   519	        r0, c0 = h - pal_h, rng.randint(0, w - pal_w)
   520	    elif side == "left":

diff --git a/ceshi/code_combo/dbff022c/8/code.py b/ceshi/code_combo/dbff022c/8/code.py
