+    def consider_bottom() -> None:
+        nonlocal best
+        if h < 2:
+            return
+        outer = g[h - 1, :]
+        inner = g[h - 2, :]
+        for c0 in range(w):
+            for c1 in range(c0 + 2, w + 1):
+                seg_outer = outer[c0:c1]
+                seg_inner = inner[c0:c1]
+                outer_colors = set(map(int, np.unique(seg_outer)))
+                inner_colors = set(map(int, np.unique(seg_inner)))
