   323	    assert len(mapping) == len(entries), "Palette border keys must be unique"
   324	
   325	    filled = g.copy()
   326	    _fill_enclosed_bg_regions(filled, bg, mapping, pal_mask)
   327	    return _packed_output_from_filled(filled, bg, entries, pal_mask, side)
   328	
   329	
   330	# --------------- generator ---------------
   331	
   332	_GRID_H_MIN, _GRID_H_MAX = 10, 16
   333	_GRID_W_MIN, _GRID_W_MAX = 10, 16
   334	
   335	_PALETTE_N_MIN, _PALETTE_N_MAX = 2, 4
   336	
   337	_SPRITE_H_MIN, _SPRITE_H_MAX = 3, 6
   338	_SPRITE_W_MIN, _SPRITE_W_MAX = 3, 5
   339	_SPRITE_DIM_SUM_CAP = 9
   340	_SPRITE_CELL_MAX = 15
   341	
   342	_P_HORIZ_WALL = 0.35
   343	_P_VERT_WALL = 0.35
   344	_P_BORDER_REMOVAL = 0.35
   345	_P_DIAMOND = 0.2
   346	
   347	_MAX_RETRIES = 400
   348	_MAX_OUTPUT_SIDE = 30
   349	
   350	
   351	def _get_enclosed_holes(sprite: np.ndarray) -> list[np.ndarray]:
   352	    """Return bg components inside the sprite mask that do not touch the bbox boundary."""
   353	    h, w = sprite.shape
   354	    return [
   355	        pts
   356	        for pts in components_mask(~sprite, connectivity=4)
   357	        if not any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)
   358	    ]
   359	
   360	
   361	def _make_diamond() -> np.ndarray:
   362	    """Return a 3x3 diamond-shaped hollow sprite."""
   363	    s = np.zeros((3, 3), dtype=bool)
   364	    s[0, 1] = s[1, 0] = s[1, 2] = s[2, 1] = True
   365	    return s
   366	
   367	
   368	def _random_transform(mask: np.ndarray, rng: random.Random) -> np.ndarray:
   369	    """Apply a random rotation and optional mirror to a boolean sprite mask."""
   370	    k = rng.randint(0, 3)
   371	    out = np.rot90(mask, k)
   372	    if rng.random() < 0.5:
   373	        out = np.fliplr(out)
   374	    return out.copy()
   375	
   376	
   377	def _make_hollow_sprite(h: int, w: int, rng: random.Random) -> np.ndarray | None:
   378	    """Create a hollow sprite with at least one enclosed hole."""
   379	    sprite = np.ones((h, w), dtype=bool)
   380	    sprite[1:-1, 1:-1] = False
   381	
   382	    if h >= 5 and w >= 4 and rng.random() < _P_HORIZ_WALL:
   383	        br = rng.randint(2, h - 2)
   384	        length = rng.randint(1, w - 2)
   385	        start = rng.randint(1, w - length - 1)
   386	        sprite[br, start : start + length] = True
   387	
   388	    if h >= 4 and w >= 5 and rng.random() < _P_VERT_WALL:
   389	        bc = rng.randint(2, w - 2)
   390	        length = rng.randint(1, h - 2)
   391	        start = rng.randint(1, h - length - 1)
   392	        sprite[start : start + length, bc] = True
   393	
   394	    if rng.random() < _P_BORDER_REMOVAL:
   395	        bcells = [
   396	            (r, c)
   397	            for r in range(h)
   398	            for c in range(w)
   399	            if sprite[r, c] and (r in (0, h - 1) or c in (0, w - 1))
   400	        ]
   401	        rng.shuffle(bcells)
   402	        for rr, cc in bcells[: rng.randint(1, min(4, len(bcells)))]:
   403	            test = sprite.copy()
   404	            test[rr, cc] = False
   405	            if _get_enclosed_holes(test):
   406	                sprite = test
   407	
   408	    if not _get_enclosed_holes(sprite):
   409	        return None
   410	    if int(sprite.sum()) > _SPRITE_CELL_MAX:
   411	        return None
   412	    return _random_transform(sprite, rng)
   413	
   414	
   415	def _choose_colors(
   416	    rng: random.Random, n: int
   417	) -> tuple[list[int], list[int], dict[int, int]]:
   418	    """Choose disjoint border and fill colors."""
   419	    colors = list(range(1, 10))
   420	    rng.shuffle(colors)
   421	    border_keys = colors[:n]
   422	    fill_values = colors[n : 2 * n]
   423	    mapping = dict(zip(border_keys, fill_values))
   424	    return border_keys, fill_values, mapping
   425	
   426	
   427	def _build_palette(side: str, border_keys: list[int], fill_values: list[int]) -> np.ndarray:
   428	    """Construct the palette block for the chosen edge."""
   429	    n = len(border_keys)
   430	    if side in {"top", "bottom"}:
   431	        pal = np.zeros((2, n), dtype=int)
   432	        outer, inner = (0, 1) if side == "top" else (1, 0)
   433	        pal[outer, :] = border_keys
   434	        pal[inner, :] = fill_values
   435	        return pal
   436	
   437	    pal = np.zeros((n, 2), dtype=int)
   438	    outer, inner = (0, 1) if side == "left" else (1, 0)
   439	    pal[:, outer] = border_keys
   440	    pal[:, inner] = fill_values
   441	    return pal
   442	
   443	
   444	def _place_palette(
   445	    grid: np.ndarray, occ: np.ndarray, pal: np.ndarray, side: str, rng: random.Random
   446	) -> None:
   447	    """Place the palette on the requested edge and reserve a padded occupancy box."""
   448	    h, w = grid.shape
   449	    ph, pw = pal.shape
   450	    if side == "top":
   451	        r0, c0 = 0, rng.randint(0, w - pw)
   452	    elif side == "bottom":
   453	        r0, c0 = h - ph, rng.randint(0, w - pw)
   454	    elif side == "left":
   455	        r0, c0 = rng.randint(0, h - ph), 0
   456	    else:
   457	        r0, c0 = rng.randint(0, h - ph), w - pw
   458	
   459	    grid[r0 : r0 + ph, c0 : c0 + pw] = pal
   460	    occ[max(0, r0 - 1) : min(h, r0 + ph + 1), max(0, c0 - 1) : min(w, c0 + pw + 1)] = True
   461	
   462	
   463	def _find_valid_positions(
   464	    h: int, w: int, occ: np.ndarray, mask: np.ndarray, holes: list[np.ndarray]
   465	) -> list[tuple[int, int]]:
   466	    """Find placements with 1-cell spacing and with holes away from the canvas boundary."""
   467	    sh, sw = mask.shape
   468	    positions: list[tuple[int, int]] = []
   469	    for r0 in range(h - sh + 1):
   470	        for c0 in range(w - sw + 1):
   471	            if occ[max(0, r0 - 1) : min(h, r0 + sh + 1), max(0, c0 - 1) : min(w, c0 + sw + 1)].any():
   472	                continue
   473	            if any(
   474	                r0 + hr == 0 or c0 + hc == 0 or r0 + hr == h - 1 or c0 + hc == w - 1
   475	                for hole in holes
   476	                for hr, hc in hole
   477	            ):
   478	                continue
   479	            positions.append((r0, c0))
   480	    return positions
   481	
   482	
   483	def _paint_sprite(
   484	    grid: np.ndarray,
   485	    r0: int,
   486	    c0: int,
   487	    mask: np.ndarray,
   488	    border_color: int,
   489	    fill_color: int | None,
   490	    holes: list[np.ndarray],
   491	) -> None:
   492	    """Render one sprite onto the grid."""
   493	    patch = grid[r0 : r0 + mask.shape[0], c0 : c0 + mask.shape[1]]
   494	    patch[mask] = int(border_color)
   495	    if fill_color is None:
   496	        return
   497	    for hole in holes:
   498	        for hr, hc in hole:
   499	            grid[r0 + int(hr), c0 + int(hc)] = int(fill_color)
   500	
   501	
   502	def _sprite_patch(
   503	    mask: np.ndarray, border_color: int, fill_color: int, bg: int
   504	) -> np.ndarray:
   505	    """Create the filled cropped patch for one sprite."""
   506	    patch = np.full(mask.shape, int(bg), dtype=int)
   507	    patch[mask] = int(border_color)
   508	    for hole in _get_enclosed_holes(mask):
   509	        for hr, hc in hole:
   510	            patch[int(hr), int(hc)] = int(fill_color)
   511	    return patch
   512	
   513	
   514	def _random_sprite(rng: random.Random) -> np.ndarray | None:
   515	    """Sample one hollow sprite shape."""
