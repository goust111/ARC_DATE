    """
    Return the sorted unique colors present in `grid`.

    Args:
        exclude: optional iterable of colors to exclude (e.g. `{bg}`)
    """
    cols = set(map(int, grid.flatten()))
    if exclude is not None:
        cols -= set(map(int, exclude))
    return sorted(cols)


