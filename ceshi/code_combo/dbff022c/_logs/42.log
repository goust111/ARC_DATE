+    if side == "bottom":
+        return 1, rng.randint(1, _GRID_W - cluster_w - 1)
+    if side == "left":
+        return rng.randint(1, _GRID_H - cluster_h - 1), 3
+    return rng.randint(1, _GRID_H - cluster_h - 1), 1
+
