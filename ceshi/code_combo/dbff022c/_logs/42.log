+                                r0=r0,
+                                c0=c0,
+                                h=sh,
+                                w=sw,
+                                area=area,
+                                major_color=int(major_color),
+                                accent_color=int(accent_color),
+                                ring_fillable=tuple(fillable),
+                                core_bg=tuple(core_bg),
+                            )
