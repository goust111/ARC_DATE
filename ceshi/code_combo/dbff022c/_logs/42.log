from itertools import product

def frame(r0,c0,h,w):
    border=set(); inner=set(); ring=set(); core=set(); hole=set()
    for r in range(r0,r0+h):
        for c in range(c0,c0+w):
            if r<r0+2 or r>=r0+h-2 or c<c0+2 or c>=c0+w-2:
                border.add((r,c))
            else:
                hole.add((r,c))
    for r,c in border:
        for rr,cc in ((r+1,c),(r-1,c),(r,c+1),(r,c-1)):
            if (rr,cc) in hole:
                inner.add((r,c)); break
    for r,c in hole:
        if r in (r0+2,r0+h-3) or c in (c0+2,c0+w-3):
            ring.add((r,c))
        else:
            core.add((r,c))
    return border, inner, ring, core

res=[]
for h1,w1,h2,w2 in product(range(7,10), repeat=4):
  area1=(h1*w1-(h1-4)*(w1-4))
  area2=(h2*w2-(h2-4)*(w2-4))
  if area1>=area2: continue
  b1,i1,r1,c1=frame(0,0,h1,w1)
  for dr in range(-4,5):
    for dc in range(-4,5):
      b2,i2,r2,c2=frame(dr,dc,h2,w2)
      bo=len(b1&b2); shared=len(r1&r2)
      if not (2 <= shared <= 6): continue
      if bo > 16: continue
      core1=len(c1-b2); core2=len(c2-b1)
      if core1 < 1 or core2 < 1: continue
      res.append((bo,-shared,-core1-core2,area1,area2,(h1,w1),(h2,w2),(dr,dc),len(r1&b2),len(r2&b1),core1,core2))
res.sort()
print('count',len(res))
for x in res[:60]: print(x)
