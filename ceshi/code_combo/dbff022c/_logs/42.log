from itertools import product

def diamond_sprite(center_r, center_c, outer_r=3, hole_r=1):
    border=set(); ring=set(); core=set(); hole=set()
    for dr in range(-outer_r, outer_r+1):
        for dc in range(-outer_r, outer_r+1):
            if abs(dr)+abs(dc) <= outer_r:
                if abs(dr)+abs(dc) > hole_r:
                    border.add((center_r+dr, center_c+dc))
                else:
                    hole.add((center_r+dr, center_c+dc))
    for r,c in hole:
        if any((r+dr,c+dc) in border for dr,dc in ((1,0),(-1,0),(0,1),(0,-1))):
            ring.add((r,c))
        else:
            core.add((r,c))
    return border, ring, core

H=W=15
sprites=[]
for cr in range(3,H-3):
  for cc in range(3,W-3):
    b,r,c=diamond_sprite(cr,cc,outer_r=4,hole_r=2)
    sprites.append(((cr,cc),b,r,c))
print('sprites',len(sprites))
found=[]
for i in range(len(sprites)):
  ma,b1,r1,c1=sprites[i]
  for j in range(i+1,len(sprites)):
    mb,b2,r2,c2=sprites[j]
    if b1 & b2: continue
    shared=r1 & r2
    if len(shared) < 1: continue
    if not (c1 - b2): continue
    if not (c2 - b1): continue
    found.append((ma,mb,len(shared),len(r1&b2),len(r2&b1)))
    if len(found)>=20: break
  if len(found)>=20: break
print('found',len(found))
for x in found[:20]: print(x)
