+        return None
+    if stats["majority_disagreements"] < 2 or stats["core_bg_total"] < 2:
+        return None
+
+    try:
+        if np.array_equal(main(grid), output):
+            return grid
+    except Exception:
+        pass
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(_MAX_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
