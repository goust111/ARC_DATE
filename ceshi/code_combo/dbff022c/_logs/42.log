+    for r in range(2, h - 2):
+        for c in range(2, w - 2):
+            if r in (2, h - 3) or c in (2, w - 3):
+                hole_ring.append((r, c))
+            else:
+                hole_core.append((r, c))
+
+    return tuple(border), tuple(inner_border), tuple(hole_ring), tuple(hole_core)
