+_MAX_RETRIES = 200
+_PALETTE_LEN_CHOICES = (4, 5)
+_LAYOUT_ROWS = 3
+_LAYOUT_COLS = 3
+_SPRITE_SHAPES = ((4, 4), (4, 5), (5, 4))
