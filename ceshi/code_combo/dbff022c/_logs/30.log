+def _grid_size_and_origins(
+    side: str, sh: int, sw: int, pal_len: int
+) -> tuple[int, int, tuple[int, int], tuple[int, int]]:
+    lattice_h = _LAYOUT_ROWS * sh + (_LAYOUT_ROWS - 1) * _GAP
+    lattice_w = _LAYOUT_COLS * sw + (_LAYOUT_COLS - 1) * _GAP
