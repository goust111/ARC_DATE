+# --------------- generator (c) ---------------
+
+_GRID_H = 13
+_GRID_W = 15
+
+_PALETTE_N_MIN, _PALETTE_N_MAX = 3, 4
+_PALETTE_SIDES = ("left", "right")
+
+_OUTER_H, _OUTER_W = 7, 8
+_INNER_H, _INNER_W = 3, 4
+_WITNESS_H, _WITNESS_W = 4, 4
+
+_OUTER_R0 = 1
+_WITNESS_R0 = 9
+
+_MAX_RETRIES = 200
