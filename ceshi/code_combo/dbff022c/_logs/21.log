+        r0, c0 = rng.randint(0, h - ph), 0
+    elif side == "right":
+        r0, c0 = rng.randint(0, h - ph), w - pw
+    elif side == "top":
+        r0, c0 = 0, rng.randint(0, w - pw)
+    else:
