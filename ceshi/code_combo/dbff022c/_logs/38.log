from solvers.arc_utils import components_mask, neighbors4


def naive_lr_main(grid):
    g = np.asarray(grid, dtype=int)
    bg = mod._bg_boundary(g)
    start, end = mod._best_right_palette(g, bg)
    h, w = g.shape
    pal_mask = np.zeros((h, w), dtype=bool)
    pal_mask[start:end, w - 2 : w] = True
    mapping = {}
    # Wrong on purpose: read the right-edge palette from left to right.
    for b, f in zip(g[start:end, w - 2].tolist(), g[start:end, w - 1].tolist(), strict=False):
        b = int(b)
        if b "'!= bg:
            mapping[b] = int(f)
    out = g.copy()
    mod._fill_enclosed_bg_regions(out, bg, mapping, pal_mask)
    return out


def region_summary(inp, out):
    bg = mod._bg_boundary(inp)
    mapping, pal_mask = mod._palette_mapping(inp, bg)
    comps = components_mask((inp == bg) & (~pal_mask), connectivity=4)
    mapped_regions = 0
    self_regions = 0
    for pts in comps:
        if any(r == 0 or c == 0 or r == inp.shape[0] - 1 or c == inp.shape[1] - 1 for r, c in pts):
            continue
        adj_counts = {}
        for r, c in pts:
            for rr, cc in neighbors4(int(r), int(c)):
                if 0 <= rr < inp.shape[0] and 0 <= cc < inp.shape[1] and not pal_mask[rr, cc]:
                    v = int(inp[rr, cc])
                    if v != bg:
                        adj_counts[v] = adj_counts.get(v, 0) + 1
        if not adj_counts:
            continue
        border = max(adj_counts.items(), key=lambda item: item[1])[0]
        fill = int(out[int(pts[0][0]), int(pts[0][1])])
        if border in mapping and fill == mapping[border]:
            mapped_regions += 1
        if border not in mapping and fill == border:
            self_regions += 1
    return mapped_regions, self_regions

samples = 100
orig_diff = 0
naive_diff = 0
self_counts = []
mapped_counts = []
right_edge_ok = 0
for _ in range(samples):
    inp = mod.generate_input()
    out = mod.main(inp)
    if not np.array_equal(out, orig.main(inp)):
        orig_diff += 1
    if not np.array_equal(out, naive_lr_main(inp)):
        naive_diff += 1
    mapped_regions, self_regions = region_summary(inp, out)
    mapped_counts.append(mapped_regions)
    self_counts.append(self_regions)
    start, end = mod._best_right_palette(inp, mod._bg_boundary(inp))
    if inp[start:end, -2:].any():
        right_edge_ok += 1

print({
