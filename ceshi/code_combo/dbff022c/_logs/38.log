    'orig_diff': orig_diff,
    'naive_lr_diff': naive_diff,
    'right_edge_ok': right_edge_ok,
    'mapped_region_min': min(mapped_counts),
    'mapped_region_max': max(mapped_counts),
    'mapped_region_avg': round(sum(mapped_counts) / samples, 2),
    'self_region_min': min(self_counts),
    'self_region_max': max(self_counts),
    'self_region_avg': round(sum(self_counts) / samples, 2),
})
