+
+    try:
+        if np.array_equal(main(inp), output):
+            return inp
+    except Exception:
+        return None
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(_MAX_RETRIES):
+        result = _gen_attempt()
+        if result is not None:
