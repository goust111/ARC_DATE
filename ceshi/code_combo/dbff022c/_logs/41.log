+    grid[1, shared_col] = wide_fill
+    grid[0, wide_only_col] = wide_key
+    grid[1, wide_only_col] = wide_only_fill
+    grid[2, stem_start] = shared_key
+    grid[2, stem_start + 1] = tall_fill
