                        continue
                    comp_counts[comp_id] = comp_counts.get(comp_id, 0) + 1
        comp_id = max(comp_counts.items(), key=lambda item: item[1])[0]
        color = int(infos[comp_id]['color'])
        fill = merged[color]
        for r, c in pts:
            out[int(r), int(c)] = fill
    return out

surplus = []
conflicts = []
diff_cells = []
for _ in range(100):
    inp = mod.generate_input()
    out = mod.main(inp)
    bg = mod._bg_boundary(inp)
    wide_mapping, tall_mapping, pal_mask = mod._parse_palette(inp, bg)
    sprite_count = len(mod.components_mask((inp "'!= bg) & (~pal_mask), connectivity=4))
    entry_count = len(wide_mapping) + len(tall_mapping)
    conflict_count = sum(1 for k, v in wide_mapping.items() if k in tall_mapping and tall_mapping[k] != v)
    collapsed = collapsed_main(inp)
    surplus.append(sprite_count - entry_count)
    conflicts.append(conflict_count)
    diff_cells.append(int(np.sum(out != collapsed)))

print('"'sprite_minus_entries', Counter(surplus))
print('cross_branch_conflict_keys', Counter(conflicts))
print('diff_cells_vs_color_only', Counter(diff_cells))
print('avg_diff_cells', sum(diff_cells)/len(diff_cells))
