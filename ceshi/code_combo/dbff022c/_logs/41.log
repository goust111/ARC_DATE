def collapsed_main(inp):
    g = np.asarray(inp, dtype=int)
    bg = mod._bg_boundary(g)
    wide_mapping, tall_mapping, pal_mask = mod._parse_palette(g, bg)
    merged = dict(wide_mapping)
    merged.update(tall_mapping)
    out = g.copy()
    cell_to_comp, infos = mod._sprite_components(out, bg, pal_mask)
    h, w = out.shape
    bg_mask = (out == bg) & (~pal_mask)
