+    else:
+        stem_start = c0 if rng.random() < 0.5 else c0 + 2
+
+    entry_cols = [c for c in range(c0, c0 + _BAR_WIDTH) if c not in (stem_start, stem_start + 1)]
+    rng.shuffle(entry_cols)
+    shared_col, wide_only_col = entry_cols
