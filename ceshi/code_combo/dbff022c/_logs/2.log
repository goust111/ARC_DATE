+            placed.append((r0, c0, sh, sw, role))
+            occ[max(0, r0 - 1) : min(h, r0 + sh + 1), max(0, c0 - 1) : min(w, c0 + sw + 1)] = True
+            success = True
+            break
+        if not success:
+            return None
