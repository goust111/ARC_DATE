+    room_colors: list[int],
+) -> list[tuple[tuple[int, int, int, int], int]]:
+    """Render the shared-wall room strip and return room hole boxes with owner colors."""
+    shared_wall_colors = [room_colors[0], room_colors[2]]
+    wall_cols = [c0]
