    counts: dict[int, int] = {}
    for col in side_colors.values():
        counts[col] = counts.get(col, 0) + 1
    ranked = sorted(((cnt, col) for col, cnt in counts.items()), reverse=True)
    if not ranked:
        return None
    if len(ranked) >= 2 and ranked[0][0] == ranked[1][0]:
        return None
    return int(ranked[0][1])


