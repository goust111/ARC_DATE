+    cursor = c0
+    for width in widths:
+        hole_c0 = cursor + 1
+        hole_c1 = hole_c0 + width - 1
+        hole_boxes.append(((r0 + 1, hole_c0, r0 + hole_h, hole_c1), 0))
+        cursor = hole_c1 + 1
+        wall_cols.append(cursor)
