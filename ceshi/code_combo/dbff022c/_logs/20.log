def _build_corner_palette(corner: str, orient: str, border_keys: list[int], fill_values: list[int]) -> np.ndarray:
    n = len(border_keys)
    if orient == "horizontal":
        pal = np.zeros((2, n), dtype=int)
        if corner in ("tl", "tr"):
            pal[0] = border_keys
            pal[1] = fill_values
