+    if int(vals[cnts.argmax()]) != bg:
+        return None
+
+    if not _exposes_shared_border_ambiguity(grid):
+        return None
+
+    try:
+        if np.array_equal(main(grid), output):
+            return grid
+    except Exception:
+        return None
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(_MAX_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
