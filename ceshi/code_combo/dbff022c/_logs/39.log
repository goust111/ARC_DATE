+    stats["painted"] = painted
+    stats["skipped"] = skipped
+
+    extra_painted = 0
+    for r, c in np.argwhere(analysis["extra_mask"]):
+        if (r0 + int(r) + c0 + int(c)) % 2 == 0:
+            extra_painted += 1
+    stats["extra_painted"] = extra_painted
+    return stats
+
+
+def _gen_attempt():
