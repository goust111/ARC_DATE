+def _checkerboard_fill_region(out: np.ndarray, pts: np.ndarray, fill: int) -> tuple[int, int]:
+    """Paint even-parity cells in pts with fill and leave odd-parity cells unchanged."""
+    painted = 0
+    skipped = 0
+    for r, c in pts:
+        rr = int(r)
+        cc = int(c)
+        if (rr + cc) % 2 == 0:
+            out[rr, cc] = fill
+            painted += 1
+        else:
+            skipped += 1
