+            c0 = int(comp[:, 1].min())
+            r1 = int(comp[:, 0].max())
+            c1 = int(comp[:, 1].max())
+            sprite = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+            for r, c in comp:
+                sprite[int(r) - r0, int(c) - c0] = True
