+        positions = _find_valid_positions(
+            h,
+            w,
+            occ,
+            info["mask"],
+            target_mask,
+            require_combo_visibility=bool(info["require_combo_visibility"]),
+            extra_mask=info["analysis"]["extra_mask"],
