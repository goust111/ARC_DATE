+
+    if not np.array_equal(main(inp), output):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(_MAX_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
