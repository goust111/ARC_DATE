+    accent2_count = 1 if accent2 is not None and accent_total >= 3 and rng.random() < 0.6 else 0
+    accent1_count = accent_total - accent2_count
+
+    chosen: list[tuple[int, int]] = adjacent[:accent1_count]
+    if len(chosen) < accent1_count:
