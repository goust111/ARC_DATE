   396	        n = rng.randint(1, h - 2)
   397	        s = rng.randint(1, h - n - 1)
   398	        sprite[s : s + n, bc] = True
   399	
   400	    if rng.random() < _P_BORDER_REMOVAL:
   401	        bcells = [
   402	            (r, c)
   403	            for r in range(h)
   404	            for c in range(w)
   405	            if sprite[r, c] and (r in (0, h - 1) or c in (0, w - 1))
   406	        ]
   407	        rng.shuffle(bcells)
   408	        for cr, cc in bcells[: rng.randint(1, min(4, len(bcells)))]:
   409	            test = sprite.copy()
   410	            test[cr, cc] = False
   411	            if _get_enclosed_holes(test):
   412	                sprite = test
