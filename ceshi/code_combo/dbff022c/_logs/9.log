   433	
   434	def _build_palette(side: str, border_keys: list[int], fill_values: list[int]) -> np.ndarray:
   435	    """Construct the 2xN or Nx2 palette array for the chosen edge."""
   436	    n_pairs = len(border_keys)
   437	    if side in ("top", "bottom"):
   438	        pal = np.zeros((2, n_pairs), dtype=int)
   439	        outer, inner = (0, 1) if side == "top" else (1, 0)
   440	        pal[outer] = border_keys
   441	        pal[inner] = fill_values
   442	    else:
   443	        pal = np.zeros((n_pairs, 2), dtype=int)
   444	        outer, inner = (0, 1) if side == "left" else (1, 0)
   445	        pal[:, outer] = border_keys
   446	        pal[:, inner] = fill_values
   447	    return pal
   448	
   449	
   450	def _place_palette(
   451	    grid: np.ndarray, pal: np.ndarray, side: str, rng: random.Random
   452	) -> np.ndarray:
   453	    """Place the palette inside the removable strip and return its exact mask."""
   454	    h, w = grid.shape
   455	    pal_h, pal_w = pal.shape
   456	    if side == "top":
   457	        r0, c0 = 0, rng.randint(0, w - pal_w)
   458	    elif side == "bottom":
   459	        r0, c0 = h - pal_h, rng.randint(0, w - pal_w)
   460	    elif side == "left":
   461	        r0, c0 = rng.randint(0, h - pal_h), 0
   462	    else:
   463	        r0, c0 = rng.randint(0, h - pal_h), w - pal_w
   464	
   465	    grid[r0 : r0 + pal_h, c0 : c0 + pal_w] = pal
   466	    pal_mask = np.zeros_like(grid, dtype=bool)
   467	    pal_mask[r0 : r0 + pal_h, c0 : c0 + pal_w] = True
   468	    return pal_mask
