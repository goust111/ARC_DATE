   388	    if h >= 5 and w >= 4 and rng.random() < _P_HORIZ_WALL:
   389	        br = rng.randint(2, h - 2)
   390	        n = rng.randint(1, w - 2)
   391	        s = rng.randint(1, w - n - 1)
   392	        sprite[br, s : s + n] = True
   393	
   394	    if h >= 4 and w >= 5 and rng.random() < _P_VERT_WALL:
