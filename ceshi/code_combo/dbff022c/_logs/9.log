   471	def _cropped_shape(side: str, h: int, w: int) -> tuple[int, int]:
   472	    """Shape after removing the palette strip."""
   473	    if side in ("top", "bottom"):
   474	        return h - 2, w
   475	    return h, w - 2
   476	
   477	
   478	def _embed_cropped(full: np.ndarray, crop: np.ndarray, side: str) -> None:
   479	    """Paste the cropped sprite field into the full pre-crop canvas."""
   480	    if side == "top":
   481	        full[2:, :] = crop
   482	    elif side == "bottom":
   483	        full[:-2, :] = crop
   484	    elif side == "left":
   485	        full[:, 2:] = crop
   486	    else:
   487	        full[:, :-2] = crop
   488	
   489	
   490	def _crop_to_full_coords(side: str, r: int, c: int) -> tuple[int, int]:
   491	    """Map a coordinate from the retained crop canvas back to the full input canvas."""
   492	    if side == "top":
   493	        return r + 2, c
   494	    if side == "left":
   495	        return r, c + 2
   496	    return r, c
   497	
   498	
   499	def _find_valid_positions(h: int, w: int, occ: np.ndarray, mask: np.ndarray) -> list[tuple[int, int]]:
   500	    """Find placements with 1-cell margin from the cropped canvas border and other sprites."""
   501	    sh, sw = mask.shape
   502	    positions: list[tuple[int, int]] = []
   503	    for r0 in range(1, h - sh):
   504	        for c0 in range(1, w - sw):
   505	            if occ[max(0, r0 - 1) : min(h, r0 + sh + 1), max(0, c0 - 1) : min(w, c0 + sw + 1)].any():
   506	                continue
   507	            positions.append((r0, c0))
   508	    return positions
