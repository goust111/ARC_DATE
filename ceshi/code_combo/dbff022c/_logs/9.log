+                    continue
+                union = d_outer | d_inner
+                if len(union) < 3:
+                    continue
+                border_keys = [int(x) for x in seg_outer.tolist() if int(x) != bg]
+                if not border_keys or len(border_keys) != len(set(border_keys)):
+                    continue
