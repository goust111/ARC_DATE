   419	def _choose_colors(
   420	    rng: random.Random, n_pairs: int, num_filled: int
   421	) -> tuple[list[int], list[int], int, dict[int, int], list[int]]:
   422	    """Pick palette pairs, a distractor border color, and the keys used by filled sprites."""
   423	    all_colors = list(range(1, 10))
   424	    rng.shuffle(all_colors)
   425	    border_keys = all_colors[:n_pairs]
   426	    rng.shuffle(all_colors)
   427	    fill_values = all_colors[:n_pairs]
   428	    distractor_color = rng.choice([c for c in range(1, 10) if c not in border_keys])
   429	    mapping = dict(zip(border_keys, fill_values))
   430	    filled_keys = rng.sample(border_keys, num_filled)
   431	    return border_keys, fill_values, distractor_color, mapping, filled_keys
