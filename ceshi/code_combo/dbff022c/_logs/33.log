def original_style_output(inp):
    g=np.asarray(inp, dtype=int)
    bg=mod._bg_boundary(g)
    corner, orientation, n, r0, c0, pal_mask = mod._best_palette(g, bg)
    if orientation == 'horizontal':
        top = g[r0, c0:c0+n]
        bottom = g[r0+1, c0:c0+n]
        if corner.startswith('top'):
            border_line, fill_line = top, bottom
        else:
            border_line, fill_line = bottom, top
    else:
        left = g[r0:r0+n, c0]
        right = g[r0:r0+n, c0+1]
        if corner.endswith('left'):
            border_line, fill_line = left, right
        else:
            border_line, fill_line = right, left
    mapping = {int(b): int(f) for b, f in zip(border_line.tolist(), fill_line.tolist(), strict=False)}
    out = g.copy()
    mod._fill_enclosed_bg_regions(out, bg, mapping, pal_mask)
    return out, corner, orientation, n

layout_counts = Counter()
disagree = 0
samples = 200
for _ in range(samples):
