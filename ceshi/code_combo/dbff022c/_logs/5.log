   296	def _fill_enclosed_bg_regions(out: np.ndarray, bg: int, mapping: dict[int, int], pal_mask: np.ndarray) -> None:
   297	    """
   298	    Fill non-boundary background holes outside the palette using the dominant mapped border color.
   299	    """
   300	    h, w = out.shape
   301	    bg_mask = (out == bg) & (~pal_mask)
   302	    for pts in components_mask(bg_mask, connectivity=4):
   303	        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):
   304	            continue
   305	
   306	        adj_counts: dict[int, int] = {}
   307	        for r, c in pts:
   308	            for rr, cc in neighbors4(int(r), int(c)):
   309	                if 0 <= rr < h and 0 <= cc < w:
   310	                    if pal_mask[rr, cc]:
   311	                        continue
   312	                    v = int(out[rr, cc])
   313	                    if v == bg:
   314	                        continue
   315	                    adj_counts[v] = adj_counts.get(v, 0) + 1
   316	        if not adj_counts:
   317	            continue
   318	
   319	        border = None
   320	        best = -1
   321	        for col, cnt in adj_counts.items():
   322	            if col not in mapping:
   323	                continue
   324	            if cnt > best:
   325	                best = cnt
   326	                border = col
   327	        if border is None:
   328	            continue
   329	
   330	        fill = int(mapping[border])
   331	        for r, c in pts:
   332	            out[int(r), int(c)] = fill
