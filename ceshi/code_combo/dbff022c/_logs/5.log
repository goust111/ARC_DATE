   335	def _crop_palette_strip(out: np.ndarray, side: str) -> np.ndarray:
   336	    """Remove the full 2-cell edge strip that contains the palette legend."""
   337	    if side == "top":
   338	        return out[2:, :].copy()
   339	    if side == "bottom":
   340	        return out[:-2, :].copy()
   341	    if side == "left":
   342	        return out[:, 2:].copy()
   343	    return out[:, :-2].copy()
