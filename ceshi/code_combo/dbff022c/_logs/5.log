   346	def _solve_with_mapping(
   347	    g: np.ndarray,
   348	    bg: int,
   349	    mapping: dict[int, int],
   350	    pal_mask: np.ndarray,
   351	    side: str,
   352	) -> np.ndarray:
   353	    out = g.copy()
   354	    _fill_enclosed_bg_regions(out, bg, mapping, pal_mask)
   355	    return _crop_palette_strip(out, side)
