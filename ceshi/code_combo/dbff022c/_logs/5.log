   439	def _make_diamond() -> np.ndarray:
   440	    """Return a 3x3 diamond-shaped boolean mask."""
   441	    s = np.zeros((3, 3), dtype=bool)
   442	    s[0, 1] = s[1, 0] = s[1, 2] = s[2, 1] = True
   443	    return s
