   482	
   483	def _choose_colors(
   484	    rng: random.Random, n_pairs: int, num_filled: int
   485	) -> tuple[list[int], list[int], int, dict[int, int], list[int]]:
   486	    """
   487	    Choose disjoint border/fill sets so the reversed read direction is behaviorally necessary.
   488	    """
   489	    colors = list(range(1, 10))
   490	    rng.shuffle(colors)
   491	    border_keys = colors[:n_pairs]
   492	    fill_values = colors[n_pairs : 2 * n_pairs]
   493	    distractor_color = colors[2 * n_pairs]
   494	    mapping = dict(zip(border_keys, fill_values, strict=False))
   495	    filled_keys = rng.sample(border_keys, num_filled)
   496	    return border_keys, fill_values, distractor_color, mapping, filled_keys
   497	
   498	
   499	def _build_palette(side: str, border_keys: list[int], fill_values: list[int]) -> np.ndarray:
   500	    """Construct the reversed-direction 2xN or Nx2 palette for the chosen side."""
   501	    n_pairs = len(border_keys)
   502	    if side in ("top", "bottom"):
   503	        pal = np.zeros((2, n_pairs), dtype=int)
   504	        if side == "top":
   505	            pal[0] = fill_values
   506	            pal[1] = border_keys
   507	        else:
   508	            pal[0] = border_keys
   509	            pal[1] = fill_values
   510	        return pal
   511	
   512	    pal = np.zeros((n_pairs, 2), dtype=int)
   513	    if side == "left":
   514	        pal[:, 0] = fill_values
   515	        pal[:, 1] = border_keys
   516	    else:
   517	        pal[:, 0] = border_keys
   518	        pal[:, 1] = fill_values
   519	    return pal
