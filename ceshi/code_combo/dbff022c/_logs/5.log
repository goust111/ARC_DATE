   429	def _get_enclosed_holes(sprite: np.ndarray) -> list[np.ndarray]:
   430	    """Return bg components that stay fully inside the sprite bbox."""
   431	    h, w = sprite.shape
   432	    return [
   433	        pts
   434	        for pts in components_mask(~sprite, connectivity=4)
   435	        if not any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)
   436	    ]
