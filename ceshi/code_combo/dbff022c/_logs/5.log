   222	def _combo_palette_mapping(
   223	    g: np.ndarray, bg: int
   224	) -> tuple[dict[int, int], np.ndarray, tuple[str, int, int]]:
   225	    """
   226	    Return (mapping border->fill, palette_mask, palette_info) using the reversed read direction.
   227	    """
   228	    h, w = g.shape
   229	    side, start, end = _best_palette(g, bg)
   230	    pal_mask = np.zeros((h, w), dtype=bool)
   231	    mapping: dict[int, int] = {}
   232	
   233	    if side == "top":
   234	        pal_mask[0:2, start:end] = True
   235	        border_line = g[1, start:end]
   236	        fill_line = g[0, start:end]
   237	    elif side == "bottom":
   238	        pal_mask[h - 2 : h, start:end] = True
   239	        border_line = g[h - 2, start:end]
   240	        fill_line = g[h - 1, start:end]
   241	    elif side == "left":
   242	        pal_mask[start:end, 0:2] = True
   243	        border_line = g[start:end, 1]
   244	        fill_line = g[start:end, 0]
   245	    else:
   246	        pal_mask[start:end, w - 2 : w] = True
   247	        border_line = g[start:end, w - 2]
   248	        fill_line = g[start:end, w - 1]
   249	
   250	    for b, f in zip(border_line.tolist(), fill_line.tolist(), strict=False):
   251	        b = int(b)
   252	        f = int(f)
   253	        if b == bg:
   254	            continue
   255	        mapping[b] = f
   256	
   257	    return mapping, pal_mask, (side, start, end)
