    56	def _best_palette(g: np.ndarray, bg: int) -> tuple[str, int, int]:
    57	    """
    58	    Find the 2xN or Nx2 palette block on a grid edge.
    59	
    60	    Returns (side, start, end) where:
    61	      - side in {"top", "bottom", "left", "right"}
    62	      - for top/bottom: start/end are column indices [start,end)
    63	      - for left/right: start/end are row indices [start,end)
    64	    """
    65	    h, w = g.shape
    66	    best = None  # (score_tuple, side, start, end)
    67	
    68	    def isolated(side: str, start: int, end: int) -> bool:
    69	        """
    70	        Palette cells (excluding bg) must stay isolated from same-colored non-palette cells.
    71	        """
    72	        pal = np.zeros((h, w), dtype=bool)
    73	        if side == "top":
    74	            pal[0:2, start:end] = True
    75	        elif side == "bottom":
    76	            pal[h - 2 : h, start:end] = True
    77	        elif side == "left":
    78	            pal[start:end, 0:2] = True
    79	        else:
    80	            pal[start:end, w - 2 : w] = True
    81	
    82	        for r, c in zip(*np.where(pal), strict=False):
    83	            v = int(g[int(r), int(c)])
    84	            if v == bg:
    85	                continue
    86	            for rr, cc in neighbors4(int(r), int(c)):
    87	                if 0 <= rr < h and 0 <= cc < w and not pal[rr, cc]:
    88	                    if int(g[rr, cc]) == v:
    89	                        return False
    90	        return True
    91	
    92	    def consider_top() -> None:
    93	        nonlocal best
    94	        if h < 2:
    95	            return
    96	        outer = g[0, :]
    97	        inner = g[1, :]
    98	        for c0 in range(w):
    99	            for c1 in range(c0 + 2, w + 1):
   100	                seg_outer = outer[c0:c1]
   101	                seg_inner = inner[c0:c1]
   102	                d_outer = set(map(int, np.unique(seg_outer)))
   103	                d_inner = set(map(int, np.unique(seg_inner)))
   104	                d_outer.discard(bg)
   105	                d_inner.discard(bg)
   106	                if len(d_outer) < 2 or len(d_inner) < 2:
   107	                    continue
   108	                union = d_outer | d_inner
   109	                if len(union) < 3:
   110	                    continue
   111	                keys = [int(x) for x in seg_outer.tolist() if int(x) != bg]
   112	                if not keys or len(keys) != len(set(keys)):
   113	                    continue
   114	                if not isolated("top", c0, c1):
   115	                    continue
   116	                nonbg = int(np.sum(seg_outer != bg) + np.sum(seg_inner != bg))
   117	                score = (len(set(keys)), len(union), -(c1 - c0), nonbg)
   118	                cand = (score, "top", c0, c1)
   119	                if best is None or cand[0] > best[0]:
   120	                    best = cand
   121	
   122	    def consider_bottom() -> None:
   123	        nonlocal best
   124	        if h < 2:
   125	            return
   126	        outer = g[h - 1, :]
   127	        inner = g[h - 2, :]
   128	        for c0 in range(w):
   129	            for c1 in range(c0 + 2, w + 1):
   130	                seg_outer = outer[c0:c1]
   131	                seg_inner = inner[c0:c1]
   132	                d_outer = set(map(int, np.unique(seg_outer)))
   133	                d_inner = set(map(int, np.unique(seg_inner)))
   134	                d_outer.discard(bg)
   135	                d_inner.discard(bg)
   136	                if len(d_outer) < 2 or len(d_inner) < 2:
   137	                    continue
   138	                union = d_outer | d_inner
   139	                if len(union) < 3:
   140	                    continue
   141	                keys = [int(x) for x in seg_outer.tolist() if int(x) != bg]
   142	                if not keys or len(keys) != len(set(keys)):
   143	                    continue
   144	                if not isolated("bottom", c0, c1):
   145	                    continue
   146	                nonbg = int(np.sum(seg_outer != bg) + np.sum(seg_inner != bg))
   147	                score = (len(set(keys)), len(union), -(c1 - c0), nonbg)
   148	                cand = (score, "bottom", c0, c1)
   149	                if best is None or cand[0] > best[0]:
   150	                    best = cand
   151	
   152	    def consider_left() -> None:
   153	        nonlocal best
   154	        if w < 2:
   155	            return
   156	        outer = g[:, 0]
   157	        inner = g[:, 1]
   158	        for r0 in range(h):
   159	            for r1 in range(r0 + 2, h + 1):
   160	                seg_outer = outer[r0:r1]
   161	                seg_inner = inner[r0:r1]
   162	                d_outer = set(map(int, np.unique(seg_outer)))
   163	                d_inner = set(map(int, np.unique(seg_inner)))
   164	                d_outer.discard(bg)
   165	                d_inner.discard(bg)
   166	                if len(d_outer) < 2 or len(d_inner) < 2:
   167	                    continue
   168	                union = d_outer | d_inner
   169	                if len(union) < 3:
   170	                    continue
   171	                keys = [int(x) for x in seg_outer.tolist() if int(x) != bg]
   172	                if not keys or len(keys) != len(set(keys)):
   173	                    continue
   174	                if not isolated("left", r0, r1):
   175	                    continue
   176	                nonbg = int(np.sum(seg_outer != bg) + np.sum(seg_inner != bg))
   177	                score = (len(set(keys)), len(union), -(r1 - r0), nonbg)
   178	                cand = (score, "left", r0, r1)
   179	                if best is None or cand[0] > best[0]:
   180	                    best = cand
   181	
   182	    def consider_right() -> None:
   183	        nonlocal best
   184	        if w < 2:
   185	            return
   186	        outer = g[:, w - 1]
   187	        inner = g[:, w - 2]
   188	        for r0 in range(h):
   189	            for r1 in range(r0 + 2, h + 1):
   190	                seg_outer = outer[r0:r1]
   191	                seg_inner = inner[r0:r1]
   192	                d_outer = set(map(int, np.unique(seg_outer)))
   193	                d_inner = set(map(int, np.unique(seg_inner)))
   194	                d_outer.discard(bg)
   195	                d_inner.discard(bg)
   196	                if len(d_outer) < 2 or len(d_inner) < 2:
   197	                    continue
   198	                union = d_outer | d_inner
   199	                if len(union) < 3:
   200	                    continue
   201	                keys = [int(x) for x in seg_outer.tolist() if int(x) != bg]
   202	                if not keys or len(keys) != len(set(keys)):
   203	                    continue
   204	                if not isolated("right", r0, r1):
   205	                    continue
   206	                nonbg = int(np.sum(seg_outer != bg) + np.sum(seg_inner != bg))
   207	                score = (len(set(keys)), len(union), -(r1 - r0), nonbg)
   208	                cand = (score, "right", r0, r1)
   209	                if best is None or cand[0] > best[0]:
   210	                    best = cand
   211	
   212	    consider_top()
   213	    consider_bottom()
   214	    consider_left()
   215	    consider_right()
   216	
   217	    assert best is not None, "_best_palette must find a valid palette region"
   218	    _, side, start, end = best
   219	    return side, int(start), int(end)
