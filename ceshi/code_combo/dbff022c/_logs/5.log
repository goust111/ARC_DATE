   446	def _make_hollow_sprite(h: int, w: int, rng: random.Random) -> np.ndarray | None:
   447	    """Create a hollow sprite with at least one enclosed hole."""
   448	    sprite = np.ones((h, w), dtype=bool)
   449	    if h >= 3 and w >= 3:
   450	        sprite[1:-1, 1:-1] = False
   451	
   452	    if h >= 5 and w >= 4 and rng.random() < _P_HORIZ_WALL:
   453	        br = rng.randint(2, h - 2)
   454	        n = rng.randint(1, w - 2)
   455	        s = rng.randint(1, w - n - 1)
   456	        sprite[br, s : s + n] = True
   457	
   458	    if h >= 4 and w >= 5 and rng.random() < _P_VERT_WALL:
   459	        bc = rng.randint(2, w - 2)
   460	        n = rng.randint(1, h - 2)
   461	        s = rng.randint(1, h - n - 1)
   462	        sprite[s : s + n, bc] = True
   463	
   464	    if rng.random() < _P_BORDER_REMOVAL:
   465	        bcells = [
   466	            (r, c)
   467	            for r in range(h)
   468	            for c in range(w)
   469	            if sprite[r, c] and (r in (0, h - 1) or c in (0, w - 1))
   470	        ]
