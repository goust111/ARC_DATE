   358	def _legacy_output(grid: np.ndarray) -> np.ndarray:
   359	    """Reference output under the original read direction, used for generator guards."""
   360	    g = np.asarray(grid, dtype=int)
   361	    bg = _bg_boundary(g)
   362	    mapping, pal_mask, (side, _start, _end) = _legacy_palette_mapping(g, bg)
   363	    return _solve_with_mapping(g, bg, mapping, pal_mask, side)
