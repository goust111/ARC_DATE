   366	def _behavior_metrics(grid: np.ndarray) -> dict[str, int | bool | tuple[int, int]]:
   367	    """Small quantitative probe used after testing to verify the fused behavior is active."""
   368	    g = np.asarray(grid, dtype=int)
   369	    combo = main(g)
   370	    legacy = _legacy_output(g)
   371	    bg = _bg_boundary(g)
   372	    side, _start, _end = _best_palette(g, bg)
   373	    cropped_input = _crop_palette_strip(g, side)
   374	    delta = (int(g.shape[0] - combo.shape[0]), int(g.shape[1] - combo.shape[1]))
   375	    return {
   376	        "shape_delta": delta,
   377	        "legacy_equal": bool(np.array_equal(combo, legacy)),
   378	        "legacy_diff_cells": int(np.count_nonzero(combo != legacy)),
   379	        "filled_cells": int(np.count_nonzero(combo != cropped_input)),
   380	    }
