    49	def _bg_boundary(g: np.ndarray) -> int:
    50	    """Most common color along the 1-cell outer border."""
    51	    border = np.concatenate([g[0, :], g[-1, :], g[1:-1, 0], g[1:-1, -1]])
    52	    vals, cnts = np.unique(border, return_counts=True)
    53	    return int(vals[cnts.argmax()])
