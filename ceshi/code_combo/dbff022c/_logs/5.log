   407	# --------------- generator (combo D3/2 + D6/0) ---------------
   408	
   409	_GRID_H_MIN, _GRID_H_MAX = 7, 13
   410	_GRID_W_MIN, _GRID_W_MAX = 12, 15
   411	
   412	_PALETTE_N_MIN, _PALETTE_N_MAX = 2, 4
   413	
   414	_SPRITE_H_MAX = 7
   415	_SPRITE_W_MAX = 6
   416	_SPRITE_DIM_SUM_CAP = 10
   417	_SPRITE_CELL_MAX = 16
   418	_FILLED_SPRITE_MIN = 2
   419	_FILLED_SPRITE_MAX = 3
   420	
   421	_P_HORIZ_WALL = 0.3
   422	_P_VERT_WALL = 0.3
   423	_P_BORDER_REMOVAL = 0.4
   424	_P_DIAMOND = 0.2
   425	
   426	_MAX_RETRIES = 1000
