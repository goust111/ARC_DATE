+            for hr, hc in hpts:
+                grid[r0 + int(hr), c0 + int(hc)] = int(fill)
+
+
+def _clear_holes(grid: np.ndarray, r0: int, c0: int, holes: list[np.ndarray], bg: int) -> None:
