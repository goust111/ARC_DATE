                    v = int(inp[rr, cc])
                    if v != bg:
                        counts[v] = counts.get(v, 0) + 1
        if not counts:
            continue
        border = max(counts.items(), key=lambda kv: kv[1])[0]
        if border not in correct:
            continue
        active_holes += 1
        if naive.get(border) != correct[border]:
            mirrored_holes += 1
        vals = {int(out[int(r), int(c)]) for r, c in pts}
        if bg in vals and any(v != bg for v in vals):
            striped_holes += 1
    baseline = naive_baseline(inp)
    diff = int(np.sum(out != baseline))
    baseline_diff_cells.append(diff)
    if diff > 0:
        baseline_diff_samples += 1

print(f'"'Active holes: {active_holes}')
print(f'Mirrored-pair holes: {mirrored_holes}')
print(f'Striped holes: {striped_holes}')
print(f'Baseline-different samples: {baseline_diff_samples}/{samples}')
print(f'Baseline diff cells avg/min/max: {np.mean(baseline_diff_cells):.1f}/{min(baseline_diff_cells)}/{max(baseline_diff_cells)}')
