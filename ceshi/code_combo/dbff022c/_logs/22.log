def naive_baseline(inp):
    g = np.asarray(inp, dtype=int)
    bg = mod._bg_boundary(g)
    side, start, end = mod._best_palette(g, bg)
    outer, inner, pal_mask = mod._extract_palette_lines(g, side, start, end)
    outer_vals = [int(x) for x in outer.tolist() if int(x) "'!= bg]
    inner_vals = [int(x) for x in inner.tolist() if int(x) != bg]
    mapping = {b: f for b, f in zip(outer_vals, inner_vals, strict=False)}
    out = g.copy()
    h, w = out.shape
    bg_mask = (out == bg) & (~pal_mask)
    for pts in components_mask(bg_mask, connectivity=4):
        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):
            continue
        counts = {}
        for r, c in pts:
            for rr, cc in neighbors4(int(r), int(c)):
                if 0 <= rr < h and 0 <= cc < w and not pal_mask[rr, cc]:
                    v = int(out[rr, cc])
                    if v != bg:
                        counts[v] = counts.get(v, 0) + 1
        if not counts:
            continue
        border = None
        best = -1
        for col, cnt in counts.items():
            if col in mapping and cnt > best:
                best = cnt
                border = col
        if border is None:
            continue
        out[np.array([int(r) for r, _ in pts]), np.array([int(c) for _, c in pts])] = int(mapping[border])
    return out

samples = 100
active_holes = 0
mirrored_holes = 0
striped_holes = 0
baseline_diff_samples = 0
baseline_diff_cells = []
for _ in range(samples):
    inp = mod.generate_input()
    out = mod.main(inp)
    bg = mod._bg_boundary(inp)
    side, start, end = mod._best_palette(inp, bg)
    outer, inner, pal_mask = mod._extract_palette_lines(inp, side, start, end)
    correct = mod._palette_mapping(inp, bg)[0]
    naive = {int(b): int(f) for b, f in zip(outer.tolist(), inner.tolist(), strict=False) if int(b) != bg}
    h, w = inp.shape
    bg_mask = (inp == bg) & (~pal_mask)
    for pts in components_mask(bg_mask, connectivity=4):
        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):
            continue
        counts = {}
        for r, c in pts:
            for rr, cc in neighbors4(int(r), int(c)):
