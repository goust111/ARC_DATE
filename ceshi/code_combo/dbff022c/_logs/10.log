+        for r, c in pts:
+            for rr, cc in neighbors4(int(r), int(c)):
+                if 0 <= rr < h and 0 <= cc < w:
+                    if pal_mask[rr, cc]:
+                        continue
+                    value = int(out[rr, cc])
+                    if value == bg:
+                        continue
+                    adj_counts[value] = adj_counts.get(value, 0) + 1
+        if not adj_counts:
+            continue
+
+        border = max(adj_counts.items(), key=lambda item: item[1])[0]
+        fill = int(mapping.get(border, border))
+        for r, c in pts:
