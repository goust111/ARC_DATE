for i in range(samples):
    inp = mod.generate_input()
    out = mod.main(inp)
    bg = mod._bg_boundary(inp)
    mapping, pal_mask = mod._palette_mapping(inp, bg)
    palette_sizes.append(len(mapping))
    bg_mask = (inp == bg) & (~pal_mask)
    comps = mod.components_mask(bg_mask, connectivity=4)
    hole_info = []
    for pts in comps:
        if any(r == 0 or c == 0 or r == inp.shape[0]-1 or c == inp.shape[1]-1 for r, c in pts):
            continue
        adj = Counter()
        out_vals = set()
        for r, c in pts:
            out_vals.add(int(out[r, c]))
            for rr, cc in mod.neighbors4(int(r), int(c)):
                if 0 <= rr < inp.shape[0] and 0 <= cc < inp.shape[1] and not pal_mask[rr, cc]:
                    v = int(inp[rr, cc])
                    if v "'!= bg:
                        adj[v] += 1
        if not adj:
            continue
        border = adj.most_common(1)[0][0]
        fill = next(iter(out_vals))
        hole_info.append((border, fill))
    hole_counts.append(len(hole_info))
    mapped = [b for b, f in hole_info if b in mapping and f == mapping[b]]
    unmatched = [b for b, f in hole_info if b not in mapping and f == b]
    counts = Counter(mapped)
    shared = sum(1 for _, n in counts.items() if n >= 2)
    singletons = sum(1 for _, n in counts.items() if n == 1)
    shared_counts.append(shared)
    singleton_counts.append(singletons)
    unmatched_counts.append(len(unmatched))
    if shared < 1 or singletons < 1 or len(unmatched) < 1 or len(mapping) >= len(hole_info):
        violations.append({
            '"'idx': i,
            'palette': len(mapping),
            'holes': hole_info,
            'shared': shared,
            'singletons': singletons,
            'unmatched': len(unmatched),
        })

print('samples', samples)
print('palette_sizes', Counter(palette_sizes))
print('hole_counts', Counter(hole_counts))
print('shared_key_groups', Counter(shared_counts))
print('singleton_key_groups', Counter(singleton_counts))
print('unmatched_holes', Counter(unmatched_counts))
print('violations', len(violations))
if violations:
    print('first_violation', violations[0])
    raise SystemExit(1)
