import importlib.util
from collections import Counter
import numpy as np

spec = importlib.util.spec_from_file_location('variant', '/home/lixinyu/snap/new/ceshi/code_combo/dbff022c/10/code.py')
mod = importlib.util.module_from_spec(spec)
