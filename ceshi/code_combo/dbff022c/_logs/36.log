    row_bands = len(set(mod._cluster_axis([r0 + r1 for r0, _, r1, _, _ in frames])))
    col_bands = len(set(mod._cluster_axis([c0 + c1 for _, c0, _, c1, _ in frames])))
    layout_counts[(row_bands, col_bands)] += 1
    size_var_counts[len({(r1-r0+1, c1-c0+1) for r0, c0, r1, c1, _ in frames})] += 1
    mapped_colors = [color for *_, color in frames if color in mapping]
    if len(set(mapped_colors)) < len(mapped_colors):
        repeat_key += 1
    if row_bands >= 2 and col_bands >= 2 and len(frames) == len(comps):
        all_ok += 1

print('"'samples:', n)
print('all non-palette components are exact rectangle frames:', f'{rect_exact}/{n}')
print('row x col band distribution:', dict(sorted(layout_counts.items())))
print('frame-count distribution:', dict(sorted(frame_counts.items())))
print('distinct frame-size-count distribution:', dict(sorted(size_var_counts.items())))
print('samples with repeated mapped border keys:', f'{repeat_key}/{n}')
print('samples satisfying all structural fusion checks:', f'{all_ok}/{n}')
