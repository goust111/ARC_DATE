+
+    span = w if side in ("top", "bottom") else h
+    max_n = min(_PALETTE_N_MAX, span)
+    if max_n < _PALETTE_N_MIN:
+        return None
+    n_palette = rng.randint(_PALETTE_N_MIN, max_n)
