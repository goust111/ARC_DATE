n = 100
layout_counts = collections.Counter()
frame_counts = collections.Counter()
size_var_counts = collections.Counter()
rect_exact = 0
repeat_key = 0
all_ok = 0
for _ in range(n):
    inp = mod.generate_input()
    bg = mod._bg_boundary(inp)
    mapping, pal_mask = mod._palette_mapping(inp, bg)
