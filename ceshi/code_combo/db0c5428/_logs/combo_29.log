+# Combo variant of db0c5428 (index 29)
+# combo_spec: D2/2+D9/1
+# Name: 可变块大小+图案紧贴角落
+
+from __future__ import annotations
+
+import random
+import sys
+from pathlib import Path
+
+import numpy as np
+
+SOLVER_DIR = Path("/home/lixinyu/snap/new/solvers")
+if str(SOLVER_DIR) not in sys.path:
