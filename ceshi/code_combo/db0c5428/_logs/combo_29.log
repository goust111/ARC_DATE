+def _slot_fits(shape: tuple[int, int], r0: int, c0: int, block: int) -> bool:
+    h, w = map(int, shape)
+    return 0 <= int(r0) and 0 <= int(c0) and int(r0) + int(block) <= h and int(c0) + int(block) <= w
+
