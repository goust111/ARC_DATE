#     structurally dominant; other colors occupy repeated symmetry orbits.


BLOCK_CHOICES = (2, 4)
GRID_SIZE_BY_BLOCK = {
    2: (12, 16),
    4: (22, 26),
}
BG = 8
FOREGROUND_COLORS = [1, 2, 3, 4, 5, 6, 7, 9]
COLOR_COUNT_MIN = 2
COLOR_COUNT_MAX_BY_BLOCK = {
