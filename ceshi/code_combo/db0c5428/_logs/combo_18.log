# Diagonal-symmetric orbits for the corner seed.
DIAG_ORBITS = (
    ((0, 0),),
    ((1, 1),),
    ((2, 2),),
    ((0, 1), (1, 0)),
    ((0, 2), (2, 0)),
    ((1, 2), (2, 1)),
)

# LR-symmetric orbits for the top-edge seed.
LR_ORBITS = (
    ((0, 0), (0, 2)),
    ((1, 0), (1, 2)),
