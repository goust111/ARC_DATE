+def _expanded_output(motif: np.ndarray, center: np.ndarray, *, rotate_outer: bool) -> np.ndarray:
+    expanded = np.full((EXPANDED_SIZE, EXPANDED_SIZE), BG, dtype=int)
+    output_motif = motif.copy()
