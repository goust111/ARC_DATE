+            src = motif[br * BLOCK : (br + 1) * BLOCK, bc * BLOCK : (bc + 1) * BLOCK]
+            patch = _rot180(src) if rotate_outer else src
+            paste(expanded, patch, (4 - 2 * br) * BLOCK, (4 - 2 * bc) * BLOCK)
+    return expanded
