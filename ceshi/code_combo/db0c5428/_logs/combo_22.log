            src = motif[br * BLOCK:(br + 1) * BLOCK, bc * BLOCK:(bc + 1) * BLOCK]
            paste(expanded, _outer_copy_transform(src, br, bc), (4 - 2 * br) * BLOCK, (4 - 2 * bc) * BLOCK)
