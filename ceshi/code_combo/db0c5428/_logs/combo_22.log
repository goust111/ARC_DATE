def _corner_rotation_visible(motif: np.ndarray) -> bool:
    for br, bc in ((0, 0), (0, 2), (2, 0), (2, 2)):
        blk = motif[br * BLOCK:(br + 1) * BLOCK, bc * BLOCK:(bc + 1) * BLOCK]
        if np.array_equal(blk, np.rot90(blk, -1)):
