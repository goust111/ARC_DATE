# Combo variant of db0c5428 (index 4)
# combo_spec: D1/3+D10/1
# Name: 颜色匹配映射+独特颜色块

from __future__ import annotations

from collections import Counter
import sys
import random

import numpy as np

try:
    from arc_utils import crop_bbox, get_bg, paste
except ModuleNotFoundError:
