+    if np.array_equal(main(inp), out):
+        return inp, {
+            "pair_signature_count": _pair_signature_count(motif),
+            "mismatch_count": mismatch_count,
+            "center_color": hub_color,
+        }
+    return None
+
+
+def generate_input() -> np.ndarray:
