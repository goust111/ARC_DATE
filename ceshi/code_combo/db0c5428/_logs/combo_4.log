+def _major_block_color(block: np.ndarray, bg: int) -> int:
+    vals, counts = np.unique(block[block != int(bg)], return_counts=True)
+    assert vals.size, "block must contain foreground colors"
+    return int(vals[int(np.argmax(counts))])
