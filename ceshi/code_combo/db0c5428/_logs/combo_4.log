+def _largest_component_bbox(g: np.ndarray, bg: int) -> tuple[int, int, int, int] | None:
+    mask = g != int(bg)
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    best_bbox = None
+    best_size = -1
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            size = 0
+            r0 = r1 = r
+            c0 = c1 = c
+            while stack:
+                rr, cc = stack.pop()
+                size += 1
+                r0 = min(r0, rr)
+                r1 = max(r1, rr)
