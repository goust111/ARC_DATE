+    mid = block // 2
+    motif[mid, block + mid] = int(center[0, mid])
+    motif[block + mid, mid] = int(center[mid, 0])
+    motif[block + mid, 2 * block + mid] = int(center[mid, 2])
+    motif[2 * block + mid, block + mid] = int(center[2, mid])
+
+
