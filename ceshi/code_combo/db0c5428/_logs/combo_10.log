   282	def _assemble_motif(blocks: dict[tuple[int, int], np.ndarray]) -> np.ndarray:
   283	    motif = np.full((MOTIF_SIZE, MOTIF_SIZE), BG, dtype=int)
   284	    for (br, bc), blk in blocks.items():
   285	        paste(motif, blk, br * BLOCK, bc * BLOCK)
   286	    return motif
   287	
   288	
   289	def _gen_center_patch(symbol: np.ndarray) -> np.ndarray:
   290	    return _decode_symbol(symbol)
   291	
   292	
   293	def _build_complete_motif(frame: np.ndarray, center: np.ndarray) -> np.ndarray:
   294	    motif = frame.copy()
   295	    paste(motif, center, BLOCK, BLOCK)
   296	    _restore_cross_arms(motif, center, BLOCK)
   297	    return motif
   298	
   299	
   300	def _carve_cross_input(motif: np.ndarray) -> np.ndarray:
   301	    inp_motif = motif.copy()
   302	    inp_motif[BLOCK : 2 * BLOCK, BLOCK : 2 * BLOCK] = BG
   303	    mid = BLOCK // 2
   304	    inp_motif[mid, BLOCK + mid] = BG
   305	    inp_motif[BLOCK + mid, mid] = BG
   306	    inp_motif[BLOCK + mid, 2 * BLOCK + mid] = BG
   307	    inp_motif[2 * BLOCK + mid, BLOCK + mid] = BG
   308	    return inp_motif
