   157	            src = motif[br * block : (br + 1) * block, bc * block : (bc + 1) * block]
   158	            paste(expanded, src, (4 - 2 * br) * block, (4 - 2 * bc) * block)
   159	    return expanded
   160	
   161	
   162	def main(grid: np.ndarray) -> np.ndarray:
   163	    """
   164	    Expand a 3x3 block motif whose center is corner-coded and whose damage forms a cross.
   165	
   166	    Input structure:
   167	    - One 9x9 foreground motif sits on a teal background.
   168	    - The motif is a 3x3 arrangement of 3x3 blocks, but the whole middle block is empty
   169	      and the center pixel of each adjacent edge block is also removed.
   170	    - The missing center is encoded only by the four corner-block pixels that point
   171	      diagonally toward the hole.
   172	
   173	    Rule:
   174	    - First rebuild the missing 3x3 center by reading the four diagonal corner-code
   175	      pixels as a 2x2 symbol and enlarging that symbol to 3x3 by nearest-neighbor scaling.
   176	    - Use the decoded center to repair the four extra missing edge-block centers, taking
   177	      each repaired arm pixel from the adjacent cardinal cell of the decoded center.
   178	    - After the 9x9 motif is fully healed, copy each non-center block to its point-
   179	      symmetric outer slot in the implied 5x5 block grid, without rotating the copied block.
   180	
   181	    Key insight:
   182	    - The cross-shaped hole is larger than before, but it is not carrying more independent
   183	      information. Four visible corner code pixels determine the whole center, and that
   184	      reconstructed center in turn determines the four punctured arm cells, so healing must
   185	      happen before any outward block copying.
   186	    """
   187	    g = np.asarray(grid, dtype=int)
   188	    bg = get_bg(g)
   189	    motif_bbox = bbox(g != bg)
   190	    assert motif_bbox is not None, "expected a foreground motif"
   191	    r0, c0, r1, c1 = motif_bbox
   192	    h = int(r1 - r0 + 1)
   193	    w = int(c1 - c0 + 1)
   194	    assert h == w and h % 3 == 0, "motif must be a square 3x3 block grid"
   195	    block = h // 3
   196	    assert block == 3, "this task uses 3x3 blocks"
   197	
   198	    motif = _healed_motif(g, int(r0), int(c0), block)
   199	    expanded = _expanded_output(motif, bg)
   200	
   201	    out = g.copy()
   202	    paste(out, expanded, int(r0) - block, int(c0) - block)
   203	    return out
   204	
   205	
   206	# --------------- generator (o5x) ---------------
   207	
   208	# -- CFG: canvas & structure --
   209	GRID_SIZE_MIN, GRID_SIZE_MAX = 16, 19
   210	BLOCK = 3
   211	MOTIF_SIZE = BLOCK * 3
   212	EXPANDED_SIZE = BLOCK * 5
   213	MOTIF_PAD = 3
   214	
   215	# -- CFG: colors --
   216	BG = 8
   217	FOREGROUND_COLORS = [1, 2, 3, 4, 5, 6, 7, 9]
   218	COLOR_COUNT_MIN, COLOR_COUNT_MAX = 2, 4
   219	
   220	# -- CFG: generation --
   221	MAX_RETRIES = 400
   222	
   223	_CORNER_CODE_POS = {
   224	    (0, 0): (2, 2),
   225	    (0, 2): (2, 0),
   226	    (2, 0): (0, 2),
   227	    (2, 2): (0, 0),
   228	}
   229	
   230	_EDGE_ARM_FROM_CENTER = {
   231	    (0, 1): (0, 1),
   232	    (1, 0): (1, 0),
   233	    (1, 2): (1, 2),
   234	    (2, 1): (2, 1),
   235	}
   236	
   237	_EDGE_INNER_POS = {
   238	    (0, 1): (2, 1),
   239	    (1, 0): (1, 2),
   240	    (1, 2): (1, 0),
   241	    (2, 1): (0, 1),
   242	}
   243	
   244	
   245	def _major_foreground_color(g: np.ndarray, bg: int) -> int:
   246	    vals, counts = np.unique(g[g != int(bg)], return_counts=True)
   247	    assert vals.size, "input must contain foreground colors"
   248	    return int(vals[int(np.argmax(counts))])
   249	
   250	
   251	def _sample_symbol(colors: list[int], majority: int) -> np.ndarray:
   252	    """Choose a nontrivial 2x2 code whose decoded center also gives informative arms."""
   253	    while True:
   254	        vals = [random.choice(colors) for _ in range(4)]
   255	        if len(set(vals)) < 2:
   256	            continue
   257	        if sum(v != majority for v in vals) < 2:
   258	            continue
   259	        arm_vals = [vals[0], vals[0], vals[1], vals[2]]
   260	        if len(set(arm_vals)) < 2:
   261	            continue
   262	        if sum(v != majority for v in arm_vals) < 2:
   263	            continue
   264	        return np.array(vals, dtype=int).reshape(2, 2)
   265	
   266	
   267	def _make_block(majority: int, colors: list[int], forced: dict[tuple[int, int], int]) -> np.ndarray:
   268	    """Create a mostly-majority 3x3 block while preserving required clue cells."""
   269	    block = np.full((BLOCK, BLOCK), majority, dtype=int)
   270	    for coord, color in forced.items():
   271	        block[coord] = color
   272	
   273	    accent_colors = [c for c in colors if c != majority]
   274	    available = [(r, c) for r in range(BLOCK) for c in range(BLOCK) if (r, c) not in forced]
   275	    random.shuffle(available)
   276	    accent_count = min(len(available), random.randint(2, 4))
   277	    for r, c in available[:accent_count]:
   278	        block[r, c] = random.choice(accent_colors)
   279	    return block
   280	
