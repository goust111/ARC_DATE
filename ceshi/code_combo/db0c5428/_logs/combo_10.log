+def _decode_symbol(symbol: np.ndarray) -> np.ndarray:
+    """Expand a 2x2 symbol into a 3x3 patch by nearest-neighbor scaling."""
+    idx = np.array([0, 0, 1], dtype=int)
+    return symbol[np.ix_(idx, idx)].copy()
