+        (0, 1): edge_seed,
+        (0, 2): np.rot90(corner_seed, -1),
+        (1, 0): np.rot90(edge_seed, 1),
+        (1, 2): np.rot90(edge_seed, -1),
+        (2, 0): np.rot90(corner_seed, 1),
+        (2, 1): np.rot90(edge_seed, 2),
