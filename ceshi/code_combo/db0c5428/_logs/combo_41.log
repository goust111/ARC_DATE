+def _gen_center_patch(motif: np.ndarray, majority: int) -> np.ndarray:
+    rows = BLOCK + _CENTER_OFFSETS
+    cols = BLOCK + _CENTER_OFFSETS
+    patch = motif[np.ix_(rows, cols)].copy()
+    patch[1, 1] = int(majority)
+    return patch
