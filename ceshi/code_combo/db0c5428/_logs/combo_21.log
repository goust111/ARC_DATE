    93	def _major_foreground_color(g: np.ndarray, bg: int) -> int:
    94	    vals, counts = np.unique(g[g != int(bg)], return_counts=True)
    95	    assert vals.size, "input must contain foreground colors"
    96	    return int(vals[int(np.argmax(counts))])
