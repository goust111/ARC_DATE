    74	DIAG_ORBITS = (
    75	    ((0, 0),),
    76	    ((1, 1),),
    77	    ((2, 2),),
    78	    ((0, 1), (1, 0)),
    79	    ((0, 2), (2, 0)),
    80	    ((1, 2), (2, 1)),
