    99	def _center_patch(g: np.ndarray, r0: int, c0: int, block: int, bg: int) -> np.ndarray:
   100	    assert int(block) == 3, "this task uses 3x3 blocks"
   101	    main = _major_foreground_color(g, bg)
   102	    patch = np.full((block, block), main, dtype=int)
   103	    hole_r = int(r0) + block
   104	    hole_c = int(c0) + block
   105	    for rr in range(block):
   106	        for cc in range(block):
   107	            if (rr, cc) == (block // 2, block // 2):
   108	                continue
   109	            patch[rr, cc] = int(g[hole_r + int(_CENTER_OFFSETS[rr]), hole_c + int(_CENTER_OFFSETS[cc])])
   110	    return patch
