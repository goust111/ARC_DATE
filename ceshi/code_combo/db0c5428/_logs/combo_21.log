   128	def _interp_horizontal(left: np.ndarray, right: np.ndarray) -> np.ndarray:
   129	    block = int(left.shape[0])
   130	    assert left.shape == right.shape == (block, block) and block == 3
   131	    patch = np.empty_like(left)
   132	    left_edge = left[:, -1]
   133	    right_edge = right[:, 0]
   134	    patch[:, 0] = left_edge
   135	    patch[:, -1] = right_edge
   136	    for rr in range(block):
   137	        patch[rr, 1] = left_edge[rr] if rr % 2 == 0 else right_edge[rr]
   138	    return patch
   139	
   140	
   141	def _interp_vertical(top: np.ndarray, bottom: np.ndarray) -> np.ndarray:
   142	    block = int(top.shape[0])
   143	    assert top.shape == bottom.shape == (block, block) and block == 3
   144	    patch = np.empty_like(top)
   145	    top_edge = top[-1, :]
   146	    bottom_edge = bottom[0, :]
   147	    patch[0, :] = top_edge
   148	    patch[-1, :] = bottom_edge
   149	    for cc in range(block):
   150	        patch[1, cc] = top_edge[cc] if cc % 2 == 0 else bottom_edge[cc]
   151	    return patch
