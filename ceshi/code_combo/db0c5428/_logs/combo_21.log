   154	def _seed_block_map(blocks: list[list[np.ndarray]]) -> list[list[np.ndarray | None]]:
   155	    block_map: list[list[np.ndarray | None]] = [[None for _ in range(5)] for _ in range(5)]
   156	    for br in range(3):
   157	        for bc in range(3):
   158	            block_map[br + 1][bc + 1] = np.array(blocks[br][bc], dtype=int)
   159	    for br in range(3):
   160	        for bc in range(3):
   161	            if (br, bc) == (1, 1):
   162	                continue
   163	            block_map[4 - 2 * br][4 - 2 * bc] = np.array(blocks[br][bc], dtype=int)
   164	    return block_map
   165	
   166	
   167	def _complete_block_map(blocks: list[list[np.ndarray]]) -> list[list[np.ndarray]]:
   168	    block_map = _seed_block_map(blocks)
   169	    changed = True
   170	    while changed:
   171	        changed = False
   172	        for br in range(5):
   173	            for bc in range(5):
   174	                if block_map[br][bc] is not None:
   175	                    continue
   176	                left = block_map[br][bc - 1] if bc - 1 >= 0 else None
   177	                right = block_map[br][bc + 1] if bc + 1 < 5 else None
   178	                top = block_map[br - 1][bc] if br - 1 >= 0 else None
   179	                bottom = block_map[br + 1][bc] if br + 1 < 5 else None
   180	                if left is not None and right is not None:
   181	                    block_map[br][bc] = _interp_horizontal(left, right)
   182	                    changed = True
   183	                elif top is not None and bottom is not None:
   184	                    block_map[br][bc] = _interp_vertical(top, bottom)
   185	                    changed = True
   186	    assert all(block_map[br][bc] is not None for br in range(5) for bc in range(5))
   187	    return [[np.array(block_map[br][bc], dtype=int) for bc in range(5)] for br in range(5)]
   188	
   189	
   190	def _render_block_map(block_map: list[list[np.ndarray]], bg: int) -> np.ndarray:
   191	    canvas = np.full((EXPANDED_SIZE, EXPANDED_SIZE), int(bg), dtype=int)
   192	    for br in range(5):
   193	        for bc in range(5):
   194	            paste(canvas, block_map[br][bc], br * BLOCK, bc * BLOCK)
   195	    return canvas
   196	
   197	
   198	def _dense_expansion_from_blocks(blocks: list[list[np.ndarray]], bg: int) -> np.ndarray:
   199	    return _render_block_map(_complete_block_map(blocks), bg)
   200	
   201	
   202	def _gap_metrics_from_blocks(blocks: list[list[np.ndarray]]) -> dict[str, int]:
   203	    block_map = _seed_block_map(blocks)
   204	    mixed_gap_slots = 0
   205	    total_edge_mismatches = 0
   206	    gap_slots = 0
   207	    for br in range(5):
   208	        for bc in range(5):
   209	            if block_map[br][bc] is not None:
   210	                continue
   211	            gap_slots += 1
   212	            left = block_map[br][bc - 1] if bc - 1 >= 0 else None
   213	            right = block_map[br][bc + 1] if bc + 1 < 5 else None
   214	            top = block_map[br - 1][bc] if br - 1 >= 0 else None
   215	            bottom = block_map[br + 1][bc] if br + 1 < 5 else None
   216	            if left is not None and right is not None:
   217	                mismatch = int(np.count_nonzero(left[:, -1] != right[:, 0]))
   218	            else:
   219	                assert top is not None and bottom is not None
   220	                mismatch = int(np.count_nonzero(top[-1, :] != bottom[0, :]))
   221	            total_edge_mismatches += mismatch
   222	            if mismatch > 0:
   223	                mixed_gap_slots += 1
   224	    return {
   225	        "gap_slots": int(gap_slots),
   226	        "mixed_gap_slots": int(mixed_gap_slots),
   227	        "total_edge_mismatches": int(total_edge_mismatches),
   228	    }
