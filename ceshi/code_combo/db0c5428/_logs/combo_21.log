   113	def _extract_blocks(g: np.ndarray, r0: int, c0: int, block: int, center: np.ndarray | None = None) -> list[list[np.ndarray]]:
   114	    blocks: list[list[np.ndarray]] = []
   115	    for br in range(3):
   116	        row: list[np.ndarray] = []
   117	        for bc in range(3):
   118	            if (br, bc) == (1, 1) and center is not None:
   119	                row.append(np.array(center, dtype=int))
   120	            else:
   121	                r1 = int(r0) + br * block
   122	                c1 = int(c0) + bc * block
   123	                row.append(np.array(g[r1:r1 + block, c1:c1 + block], dtype=int))
   124	        blocks.append(row)
   125	    return blocks
