   342	def _assemble_motif(b00: np.ndarray, b01: np.ndarray) -> np.ndarray:
   343	    motif = np.full((MOTIF_SIZE, MOTIF_SIZE), BG, dtype=int)
   344	    blocks = {
   345	        (0, 0): b00,
   346	        (0, 1): b01,
   347	        (0, 2): np.fliplr(b00),
   348	        (1, 0): b01.T,
   349	        (1, 2): np.rot90(b01, -1),
   350	        (2, 0): np.flipud(b00),
   351	        (2, 1): np.flipud(b01),
   352	        (2, 2): np.rot90(b00, 2),
   353	    }
   354	    for (br, bc), blk in blocks.items():
   355	        paste(motif, blk, br * BLOCK, bc * BLOCK)
   356	    return motif
   357	
   358	
   359	def _gen_center_patch(motif: np.ndarray, majority: int) -> np.ndarray:
   360	    rows = BLOCK + _CENTER_OFFSETS
   361	    cols = BLOCK + _CENTER_OFFSETS
   362	    patch = motif[np.ix_(rows, cols)].copy()
   363	    patch[1, 1] = int(majority)
   364	    return patch
   365	
   366	
   367	def _gen_attempt() -> np.ndarray | None:
   368	    n = random.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)
   369	    color_count = random.randint(COLOR_COUNT_MIN, COLOR_COUNT_MAX)
   370	    colors = random.sample(FOREGROUND_COLORS, color_count)
   371	    majority = colors[0]
   372	    minor_colors = colors[1:]
   373	
   374	    possible_totals = [
   375	        total for total in range(MAJORITY_TOTAL_MIN, MAJORITY_TOTAL_MAX + 1)
   376	        if 18 - total >= len(minor_colors)
   377	    ]
   378	    majority_total = random.choice(possible_totals)
   379	    pairs = [
   380	        (corner, majority_total - corner)
   381	        for corner in range(CORNER_MAJOR_MIN, CORNER_MAJOR_MAX + 1)
   382	        if EDGE_MAJOR_MIN <= majority_total - corner <= EDGE_MAJOR_MAX
   383	    ]
   384	    corner_major, edge_major = random.choice(pairs)
   385	
   386	    b00, b01 = _make_blocks(majority, minor_colors, corner_major, edge_major)
   387	    motif = _assemble_motif(b00, b01)
   388	    center = _gen_center_patch(motif, majority)
   389	    filled = motif.copy()
   390	    paste(filled, center, BLOCK, BLOCK)
   391	    blocks = _extract_blocks(filled, 0, 0, BLOCK)
   392	    metrics = _gap_metrics_from_blocks(blocks)
   393	    if metrics["mixed_gap_slots"] < 4 or metrics["total_edge_mismatches"] < 8:
   394	        return None
   395	
   396	    expanded = _dense_expansion_from_blocks(blocks, BG)
   397	    r0 = random.randint(MOTIF_PAD, n - MOTIF_SIZE - MOTIF_PAD)
   398	    c0 = random.randint(MOTIF_PAD, n - MOTIF_SIZE - MOTIF_PAD)
   399	
   400	    inp = np.full((n, n), BG, dtype=int)
   401	    out = np.full((n, n), BG, dtype=int)
   402	    paste(inp, motif, r0, c0)
   403	    paste(out, expanded, r0 - BLOCK, c0 - BLOCK)
   404	
   405	    if np.array_equal(main(inp), out):
   406	        return inp
   407	    return None
   408	
   409	
   410	def generate_input() -> np.ndarray:
   411	    for _ in range(MAX_RETRIES):
   412	        grid = _gen_attempt()
   413	        if grid is not None:
   414	            return grid
   415	    raise AssertionError("failed to generate a valid db0c5428 combo input")

