+
+def _render_block_map(block_map: list[list[np.ndarray]], bg: int) -> np.ndarray:
+    canvas = np.full((EXPANDED_SIZE, EXPANDED_SIZE), int(bg), dtype=int)
+    for br in range(5):
+        for bc in range(5):
+            paste(canvas, block_map[br][bc], br * BLOCK, bc * BLOCK)
+    return canvas
