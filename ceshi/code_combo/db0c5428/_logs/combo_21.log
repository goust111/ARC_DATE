   246	def main(grid: np.ndarray) -> np.ndarray:
   247	    """
   248	    Expand the 3x3-block motif into a fully filled 5x5 block mosaic.
   249	
   250	    Input structure:
   251	    - One 9x9 motif sits on the background and is itself a 3x3 arrangement of 3x3 blocks.
   252	    - The middle block is missing, and the 8 pixels facing that hole encode the missing block.
   253	    - The visible 8 surrounding blocks already imply the larger 5x5 layout used by the output.
   254	
   255	    Rule:
   256	    - Rebuild the center 3x3 block from the inner-boundary pixels exactly as in the original task.
   257	    - Keep the original 3x3 block region in place and mirror each non-center block to its point-symmetric
   258	      outer slot of the 5x5 block grid.
   259	    - Fill every remaining gap slot of that 5x5 grid by interpolating between its two neighboring donor
   260	      blocks: horizontal gaps mix left/right edge columns, vertical gaps mix top/bottom edge rows.
   261	
   262	    Key insight:
   263	    - The output is no longer the sparse 5x5 scaffold of the source task. After center repair, the solver
   264	      should treat the known blocks as anchors of a complete block lattice and synthesize the in-between
   265	      blocks from the adjacent visible edges, yielding a dense 15x15 pattern.
   266	    """
   267	    g = np.asarray(grid, dtype=int)
   268	    bg = get_bg(g)
   269	    motif_bbox = bbox(g != bg)
   270	    assert motif_bbox is not None, "expected a foreground motif"
   271	    r0, c0, r1, c1 = motif_bbox
   272	    h = int(r1 - r0 + 1)
   273	    w = int(c1 - c0 + 1)
   274	    assert h == w and h % 3 == 0, "motif must be a square 3x3 block grid"
   275	    block = h // 3
   276	    assert int(block) == 3, "this task uses 3x3 blocks"
   277	
   278	    center = _center_patch(g, int(r0), int(c0), block, bg)
   279	    blocks = _extract_blocks(g, int(r0), int(c0), block, center)
   280	    dense = _dense_expansion_from_blocks(blocks, bg)
   281	
   282	    out = np.array(g, copy=True)
   283	    paste(out, dense, int(r0) - block, int(c0) - block)
   284	    return out
   285	
   286	
   287	def _major_orbits(orbits, forced_minor, target_count):
   288	    forced_minor = set(forced_minor)
   289	    usable = [
   290	        idx for idx, orbit in enumerate(orbits)
   291	        if all(coord not in forced_minor for coord in orbit)
   292	    ]
   293	    choices = []
   294	    for mask in range(1 << len(usable)):
   295	        selected = set()
   296	        total = 0
   297	        for bit, idx in enumerate(usable):
   298	            if mask & (1 << bit):
   299	                selected.add(idx)
   300	                total += len(orbits[idx])
   301	        if total == int(target_count):
   302	            choices.append(selected)
   303	    assert choices, "unreachable symmetric majority count"
   304	    return random.choice(choices)
   305	
   306	
   307	def _seed_block(orbits, forced_minor, majority, target_count):
   308	    block = np.full((BLOCK, BLOCK), -1, dtype=int)
   309	    major_idxs = _major_orbits(orbits, forced_minor, target_count)
   310	    minor_orbits = []
   311	    for idx, orbit in enumerate(orbits):
   312	        if idx in major_idxs:
   313	            for rr, cc in orbit:
   314	                block[rr, cc] = int(majority)
   315	        else:
   316	            minor_orbits.append((block, orbit))
   317	    return block, minor_orbits
   318	
   319	
   320	def _assign_minor_colors(minor_orbits, colors):
   321	    random.shuffle(minor_orbits)
   322	    guaranteed = list(colors)
   323	    random.shuffle(guaranteed)
   324	    assignments = guaranteed + [
   325	        random.choice(colors) for _ in range(len(minor_orbits) - len(guaranteed))
   326	    ]
   327	    for (block, orbit), color in zip(minor_orbits, assignments):
   328	        for rr, cc in orbit:
   329	            block[rr, cc] = int(color)
   330	
   331	
   332	def _make_blocks(majority, minor_colors, corner_major, edge_major):
   333	    b00, corner_minors = _seed_block(DIAG_ORBITS, [(2, 2)], majority, corner_major)
   334	    b01, edge_minors = _seed_block(LR_ORBITS, [(2, 1)], majority, edge_major)
   335	    minor_orbits = corner_minors + edge_minors
   336	    assert len(minor_orbits) >= len(minor_colors)
   337	    _assign_minor_colors(minor_orbits, minor_colors)
   338	    assert np.all(b00 != -1) and np.all(b01 != -1)
   339	    return b00, b01
