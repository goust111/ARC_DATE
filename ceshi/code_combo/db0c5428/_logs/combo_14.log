+            dst_r = expanded_r0 + (4 - 2 * br) * block
+            dst_c = expanded_c0 + (4 - 2 * bc) * block
+            paste(out, src, dst_r, dst_c)
+
+    paste(out, _solid_center_patch(g, int(r0), int(c0), block, bg), int(r0) + block, int(c0) + block)
+    return out
+
