+
+
+def _assemble_motif(b00, b01):
+    motif = np.full((MOTIF_SIZE, MOTIF_SIZE), BG, dtype=int)
+    blocks = {
+        (0, 0): b00,
+        (0, 1): b01,
+        (0, 2): np.fliplr(b00),
+        (1, 0): b01.T,
+        (1, 2): np.rot90(b01, -1),
+        (2, 0): np.flipud(b00),
+        (2, 1): np.flipud(b01),
