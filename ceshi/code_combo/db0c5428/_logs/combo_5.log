   181	def _find_separator_structure(motif: np.ndarray, bg: int) -> tuple[int, int]:
   182	    h, w = motif.shape
   183	    assert h == w, "motif must be square"
   184	    candidates: list[tuple[int, int]] = []
   185	    for raw_color in np.unique(motif):
   186	        color = int(raw_color)
   187	        if color == int(bg):
   188	            continue
   189	        row_hits = [r for r in range(h) if np.all(motif[r, :] == color)]
   190	        col_hits = [c for c in range(w) if np.all(motif[:, c] == color)]
   191	        if len(row_hits) != 2 or len(col_hits) != 2:
   192	            continue
   193	        row_gap = row_hits[1] - row_hits[0]
   194	        col_gap = col_hits[1] - col_hits[0]
   195	        if row_gap != col_gap or row_gap < 2:
   196	            continue
   197	        block = row_gap - SEP
   198	        if h != block * 3 + SEP * 2 or w != block * 3 + SEP * 2:
   199	            continue
   200	        expected = [block, 2 * block + SEP]
   201	        if row_hits == expected and col_hits == expected:
   202	            candidates.append((color, block))
   203	    assert len(candidates) == 1, "expected a unique separator color"
   204	    return candidates[0]
