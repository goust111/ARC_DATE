+    combo_out = _render_on_resized_canvas(inp, combo_expanded, int(r0) - BLOCK, int(c0) - BLOCK, BG)
+    d7_out = _render_on_resized_canvas(inp, d7_expanded, int(r0) - BLOCK, int(c0) - BLOCK, BG)
+
+    if combo_out.shape == inp.shape:
