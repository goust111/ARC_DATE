+BLOCK = 3
+MOTIF_SIZE = BLOCK * 3
+EXPANDED_SIZE = BLOCK * 5
+BG = 8
+FOREGROUND_COLORS = [1, 2, 3, 4, 5, 6, 7, 9]
+GRID_SIZE_MIN, GRID_SIZE_MAX = 16, 19
+MAX_RETRIES = 300
+PLACEMENT_MODES = ("top", "bottom", "left", "right", "tl", "tr", "bl", "br")
