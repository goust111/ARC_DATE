+    try:
+        block = random.choice(BLOCK_CHOICES)
+        motif_size = 4 * block
+        n_min = max(motif_size + GRID_EXTRA_MIN, 5 * block)
+        n_max = max(n_min, 5 * block + (GRID_EXTRA_MAX - GRID_EXTRA_MIN))
+        n = random.randint(n_min, n_max)
