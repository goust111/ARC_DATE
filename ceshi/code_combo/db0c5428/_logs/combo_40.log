+        paste(inp, motif, r0, c0)
+        out = _expected_output(inp, motif, r0, c0, block)
+    except (AssertionError, ValueError):
+        return None
+ 
+    if out.shape == inp.shape:
+        return None
+    if np.array_equal(main(inp), out):
+        return inp
+    return None
+
