+def _diag_orbits(block: int) -> tuple[tuple[tuple[int, int], ...], ...]:
+    seen: set[tuple[int, int]] = set()
+    orbits = []
+    for r in range(block):
+        for c in range(block):
+            if (r, c) in seen:
+                continue
+            orbit = tuple(sorted({(r, c), (c, r)}))
+            seen.update(orbit)
+            orbits.append(orbit)
