   357	    high_c = list(range(max(0, max_c0 - block + 1), max_c0 + 1))
   358	    mid_r = list(range(min(block, max_r0 + 1), max(0, max_r0 - block + 1)))
   359	    mid_c = list(range(min(block, max_c0 + 1), max(0, max_c0 - block + 1)))
   360	
