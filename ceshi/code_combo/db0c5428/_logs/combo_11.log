    src_cols = [int(c0) + 3 * block - 1, int(c0) + block + 1, int(c0)]
    for r in range(block):
        for c in range(block):
            if r == block // 2 and c == block // 2:
                continue
            patch[r, c] = int(g[src_rows[r], src_cols[c]])
    return patch


