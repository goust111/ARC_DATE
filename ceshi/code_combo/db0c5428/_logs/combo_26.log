+BLOCK = 3
+MOTIF_BLOCKS = 3
+OUTPUT_BLOCKS = 5
+MOTIF_SIZE = BLOCK * MOTIF_BLOCKS
+EXPANDED_SIZE = BLOCK * OUTPUT_BLOCKS
+MOTIF_PAD = BLOCK
