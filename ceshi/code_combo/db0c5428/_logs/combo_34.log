    99	                continue
   100	            patch[r, c] = int(g[hole_r + offsets[r], hole_c + offsets[c]])
   101	    return patch
   102	
   103	
   104	def _outer_transform(block: np.ndarray) -> np.ndarray:
   105	    """Reflect a copied block across the horizontal axis."""
   106	    return np.flipud(np.asarray(block, dtype=int))
   107	
   108	
   109	_OUTER_SPECS = (
   110	    ((0, 0), (3, 2), (2, 2), "below"),
   111	    ((0, 1), (3, 1), (2, 1), "below"),
   112	    ((0, 2), (3, 0), (2, 0), "below"),
   113	    ((1, 0), (1, 3), (1, 2), "right"),
   114	    ((1, 2), (1, -1), (1, 0), "left"),
   115	    ((2, 0), (-1, 2), (0, 2), "above"),
   116	    ((2, 1), (-1, 1), (0, 1), "above"),
   117	    ((2, 2), (-1, 0), (0, 0), "above"),
   118	)
   119	
   120	
   121	def _iter_outer_specs():
   122	    for spec in _OUTER_SPECS:
   123	        yield spec
   124	
   125	
   126	def _extract_block(motif: np.ndarray, br: int, bc: int) -> np.ndarray:
   127	    return motif[br * BLOCK : (br + 1) * BLOCK, bc * BLOCK : (bc + 1) * BLOCK]
   128	
   129	
   130	def _edge_match_count(outer_block: np.ndarray, adjacent_block: np.ndarray, side: str) -> int:
   131	    if side == "above":
   132	        return int(np.count_nonzero(outer_block[-1, :] == adjacent_block[0, :]))
   133	    if side == "below":
   134	        return int(np.count_nonzero(outer_block[0, :] == adjacent_block[-1, :]))
   135	    if side == "left":
   136	        return int(np.count_nonzero(outer_block[:, -1] == adjacent_block[:, 0]))
   137	    if side == "right":
   138	        return int(np.count_nonzero(outer_block[:, 0] == adjacent_block[:, -1]))
   139	    raise ValueError(f"unknown side: {side}")
   140	
   141	
   142	def _flipud_distance(block: np.ndarray) -> int:
   143	    return int(np.count_nonzero(np.asarray(block, dtype=int) != np.flipud(block)))
   144	
   145	
   146	def _variant_difference_score(motif: np.ndarray) -> int:
   147	    """Count changed pixels between copied blocks with and without the combo flip."""
   148	    score = 0
   149	    for (src_br, src_bc), _dst, _adj, _side in _iter_outer_specs():
   150	        src = _extract_block(motif, src_br, src_bc)
   151	        score += int(np.count_nonzero(src != _outer_transform(src)))
   152	    return score
   153	
   154	
   155	def _boundary_continuity_delta(motif: np.ndarray) -> int:
   156	    """
   157	    Quantify the combo-specific seam signal:
   158	    how much the number of matching edge pixels changes when the pasted copy is
   159	    flipped versus left unchanged.
   160	    """
   161	    delta = 0
   162	    for (src_br, src_bc), _dst, (adj_br, adj_bc), side in _iter_outer_specs():
   163	        src = _extract_block(motif, src_br, src_bc)
   164	        adj = _extract_block(motif, adj_br, adj_bc)
   165	        flipped = _outer_transform(src)
   166	        delta += abs(_edge_match_count(flipped, adj, side) - _edge_match_count(src, adj, side))
   167	    return int(delta)
   168	
   169	
   170	def main(grid: np.ndarray) -> np.ndarray:
   171	    """
   172	    Expand a 3x3 block motif into a connected 15x15 layout with flipped outer copies.
   173	
   174	    Input structure:
   175	    - A single 9x9 foreground motif sits on a teal background.
   176	    - The motif is a 3x3 arrangement of 3x3 blocks whose middle block is empty.
   177	    - The eight pixels facing the hole still encode the missing center block border.
   178	
   179	    Rule:
   180	    - Keep the original motif in place and reconstruct the missing center block
   181	      from the eight inner-boundary pixels, using the majority foreground color
   182	      at the center of that 3x3 patch.
   183	    - Copy each non-center block to its point-symmetric outer location, but pack
   184	      those outer copies so they touch the original motif with no blank block gap.
   185	    - Before each outer paste, flip the copied 3x3 block top-to-bottom.
   186	
   187	    Key insight: The hole decoding is unchanged, but the outer ring is no longer
   188	    a sparse checkerboard. The copied blocks are compressed until they share edges
   189	    with the motif, so the vertical flip becomes readable from the seam patterns
   190	    where the new copies meet the original blocks.
   191	    """
   192	    g = np.asarray(grid, dtype=int)
   193	    bg = get_bg(g)
   194	    motif_bbox = bbox(g != bg)
   195	    assert motif_bbox is not None, "expected a foreground motif"
   196	    r0, c0, r1, c1 = motif_bbox
   197	    h = int(r1 - r0 + 1)
   198	    w = int(c1 - c0 + 1)
   199	    assert h == w and h % 3 == 0, "motif must be a square 3x3 block grid"
   200	    block = h // 3
   201	
   202	    out = g.copy()
   203	    for (src_br, src_bc), (dst_br, dst_bc), _adj, _side in _iter_outer_specs():
   204	        src = crop_bbox(
   205	            g,
   206	            (
   207	                int(r0) + src_br * block,
   208	                int(c0) + src_bc * block,
   209	                int(r0) + (src_br + 1) * block - 1,
   210	                int(c0) + (src_bc + 1) * block - 1,
   211	            ),
   212	        )
   213	        paste(out, _outer_transform(src), int(r0) + dst_br * block, int(c0) + dst_bc * block)
   214	
