   223	BLOCK = 3
   224	MOTIF_SIZE = BLOCK * 3
   225	EXPANDED_SIZE = BLOCK * 5
   226	MOTIF_PAD = 3
   227	
   228	# -- CFG: colors --
   229	BG = 8
   230	FOREGROUND_COLORS = [1, 2, 3, 4, 5, 6, 7, 9]
   231	COLOR_COUNT_MIN, COLOR_COUNT_MAX = 2, 4
   232	
   233	# -- CFG: majority pixel counts (corner block + edge block combined) --
   234	MAJORITY_TOTAL_MIN, MAJORITY_TOTAL_MAX = 10, 16
   235	CORNER_MAJOR_MIN, CORNER_MAJOR_MAX = 5, 8
   236	EDGE_MAJOR_MIN, EDGE_MAJOR_MAX = 5, 8
   237	
   238	# -- CFG: generation --
