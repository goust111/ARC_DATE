   240	MIN_SEED_FLIP_DIFF = 2
   241	MIN_VARIANT_SCORE = 16
   242	MIN_BOUNDARY_DELTA = 6
   243	
   244	# -- Symmetry orbits for 3x3 blocks --
   245	DIAG_ORBITS = (
   246	    ((0, 0),),
   247	    ((1, 1),),
   248	    ((2, 2),),
   249	    ((0, 1), (1, 0)),
   250	    ((0, 2), (2, 0)),
   251	    ((1, 2), (2, 1)),
   252	)
   253	LR_ORBITS = (
   254	    ((0, 0), (0, 2)),
   255	    ((1, 0), (1, 2)),
