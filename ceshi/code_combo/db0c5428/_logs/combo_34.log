+
+def _outer_transform(block: np.ndarray) -> np.ndarray:
+    """Reflect a copied block across the horizontal axis."""
+    return np.flipud(np.asarray(block, dtype=int))
+
+
+_OUTER_SPECS = (
+    ((0, 0), (3, 2), (2, 2), "below"),
+    ((0, 1), (3, 1), (2, 1), "below"),
+    ((0, 2), (3, 0), (2, 0), "below"),
+    ((1, 0), (1, 3), (1, 2), "right"),
+    ((1, 2), (1, -1), (1, 0), "left"),
+    ((2, 0), (-1, 2), (0, 2), "above"),
+    ((2, 1), (-1, 1), (0, 1), "above"),
+    ((2, 2), (-1, 0), (0, 0), "above"),
