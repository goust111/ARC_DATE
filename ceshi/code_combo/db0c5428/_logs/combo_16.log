+    return {
+        (0, 1): seed.copy(),
+        (1, 0): np.rot90(seed, 1),
+        (1, 2): np.rot90(seed, -1),
+        (2, 1): np.flipud(seed),
+    }
+
+
+def _signatures(blocks: dict[tuple[int, int], np.ndarray], positions: tuple[tuple[int, int], ...]) -> list[tuple[int, ...]]:
+    return [tuple(map(int, blocks[pos].flatten())) for pos in positions]
+
+
