+    if sorted(len(holes) for _r, _c, _m, holes in motifs) != sorted((len(holes_a), len(holes_b))):
+        return None
+    if np.array_equal(main(inp), out):
+        return inp
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
