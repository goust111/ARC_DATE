   171	) -> tuple[list[list[np.ndarray]], list[tuple[int, int]]]:
   172	    size = len(blocks)
   173	    out = [
   174	        [None if blocks[r][c] is None else _copy_block(blocks[r][c]) for c in range(size)]
   175	        for r in range(size)
   176	    ]
   177	    interpolated: list[tuple[int, int]] = []
   178	
   179	    while True:
   180	        empties = [(r, c) for r in range(size) for c in range(size) if out[r][c] is None]
   181	        if not empties:
   182	            return out, interpolated  # type: ignore[return-value]
   183	
   184	        changed = False
   185	        for r, c in empties:
   186	            has_lr = 0 < c < size - 1 and out[r][c - 1] is not None and out[r][c + 1] is not None
   187	            has_ud = 0 < r < size - 1 and out[r - 1][c] is not None and out[r + 1][c] is not None
   188	            if has_lr == has_ud:
   189	                continue
   190	            if has_lr:
   191	                out[r][c] = _interpolate_horizontal(out[r][c - 1], out[r][c + 1])  # type: ignore[arg-type]
   192	            else:
   193	                out[r][c] = _interpolate_vertical(out[r - 1][c], out[r + 1][c])  # type: ignore[arg-type]
   194	            interpolated.append((r, c))
   195	            changed = True
   196	
   197	        if not changed:
   198	            raise AssertionError("unfillable interpolation gap")
   199	
   200	
   201	def _render_block_grid(blocks: list[list[np.ndarray]], bg: int) -> np.ndarray:
   202	    size = len(blocks)
   203	    canvas = np.full((size * BLOCK, size * BLOCK), bg, dtype=int)
   204	    for r in range(size):
   205	        for c in range(size):
   206	            paste(canvas, blocks[r][c], r * BLOCK, c * BLOCK)
   207	    return canvas
   208	
   209	
   210	def _build_trace(motif: np.ndarray, bg: int) -> dict[str, object]:
   211	    center = _center_patch(motif, bg)
   212	    stage0 = _motif_block_grid(motif, center)
   213	
   214	    stage1_sparse, stage1_copied_from = _expand_dense_grid(stage0)
   215	    stage1_dense, stage1_interp = _fill_interpolation_gaps(stage1_sparse)
   216	
   217	    stage2_sparse, stage2_copied_from = _expand_dense_grid(stage1_dense)
