   229	        "stage1_dense": stage1_dense,
   230	        "stage1_interp": stage1_interp,
   231	        "stage1_copied_from": stage1_copied_from,
   232	        "stage2_sparse": stage2_sparse,
   233	        "stage2_dense": stage2_dense,
   234	        "stage2_interp": stage2_interp,
   235	        "stage2_copied_from": stage2_copied_from,
   236	        "cascade_copies": cascade_copies,
   237	    }
   238	
