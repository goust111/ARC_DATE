+def _ring_slot_from_source(br: int, bc: int) -> tuple[int, int]:
+    assert (br, bc) != (1, 1), "center block is not copied into the ring"
+    dr = 1 - int(br)
+    dc = 1 - int(bc)
+    return _RING_COORD[dr], _RING_COORD[dc]
