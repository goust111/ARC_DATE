            paste(out, src_left, int(r0) + br * block, int(c0) + 3 * block)
    else:
        for bc in range(3):
            src_top = crop_bbox(
                g,
                (
                    int(r0),
                    int(c0) + bc * block,
                    int(r0) + block - 1,
                    int(c0) + (bc + 1) * block - 1,
