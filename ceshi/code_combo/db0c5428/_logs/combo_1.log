+    blocks = {
+        (0, 0): b00,
+        (0, 1): b01,
+        (0, 2): np.fliplr(b00),
+        (1, 0): b01.T,
+        (1, 2): np.rot90(b01, -1),
+        (2, 0): np.flipud(b00),
+        (2, 1): np.flipud(b01),
+        (2, 2): _rot180(b00),
