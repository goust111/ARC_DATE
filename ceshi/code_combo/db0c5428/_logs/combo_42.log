+
+def _largest_component_bbox(g: np.ndarray, bg: int) -> tuple[int, int, int, int] | None:
+    mask = g != int(bg)
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    best_bbox = None
+    best_size = -1
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            size = 0
+            r0 = r1 = r
+            c0 = c1 = c
+            while stack:
+                rr, cc = stack.pop()
+                size += 1
+                r0 = min(r0, rr)
+                r1 = max(r1, rr)
+                c0 = min(c0, cc)
+                c1 = max(c1, cc)
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            if size > best_size:
+                best_size = size
+                best_bbox = (r0, c0, r1, c1)
+    return best_bbox
