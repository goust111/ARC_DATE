+BLOCK_DIMS = [(2, 2), (2, 3), (3, 2), (3, 3)]
+BLOCK_PROB = 0.5
+FILL_RATIO_MIN = 0.5
+FILL_RATIO_MAX = 0.8
+FREEFORM_H_RANGE = (3, 6)
+FREEFORM_W_RANGE = (3, 6)
+MOTIF_COLORS_MIN = 3
