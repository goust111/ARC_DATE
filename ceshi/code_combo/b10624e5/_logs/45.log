+    tl_anchor_r0, tl_anchor_c0 = anchors[(0, 0)]
+    tl_patch_r0 = tl_anchor_r0 - anchor_r_in_patch
+    tl_patch_c0 = tl_anchor_c0 - anchor_c_in_patch
+    paste(inp, patch, tl_patch_r0, tl_patch_c0)
