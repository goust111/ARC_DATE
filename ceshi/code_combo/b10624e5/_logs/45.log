+    paste(inp, np.full((SOURCE_ANCHOR_SIZE, SOURCE_ANCHOR_SIZE), RED, dtype=int), tl_anchor_r0, tl_anchor_c0)
+    for key, size in target_sizes.items():
+        ar, ac = anchors[key]
+        paste(inp, np.full((size, size), RED, dtype=int), ar, ac)
