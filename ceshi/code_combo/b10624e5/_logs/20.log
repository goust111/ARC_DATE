+    assert c1 < mid_c or c0 > mid_c, "component must stay within one col half"
+    rr = (r0 + r1) // 2
+    cc = (c0 + c1) // 2
+    return (0 if rr < mid_r else 1, 0 if cc < mid_c else 1)
