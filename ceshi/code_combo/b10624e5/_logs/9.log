+
+    anchors: dict[tuple[int, int], tuple[int, int]] = {
+        (0, 0): (tl_r0 + sar, tl_c0 + sac)
+    }
+    markers: dict[tuple[int, int], tuple[int, int]] = {}
+
+    for key, target_size in target_sizes.items():
