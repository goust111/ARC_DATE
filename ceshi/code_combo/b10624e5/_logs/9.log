+BG = 4
+DIV = 1
+RED = 2
+MARKER = 8
+GRID_SIZE = 27
+MID = 13
+QUADS = {
+    (0, 0): (0, 12, 0, 12),
+    (0, 1): (0, 12, 14, 26),
+    (1, 0): (14, 26, 0, 12),
+    (1, 1): (14, 26, 14, 26),
+}
+
+SOURCE_ANCHOR_SIZE = 2
+TARGET_SIZE_OPTIONS = (2, 3, 4)
+SOURCE_GAP = 1
+MARKER_SHIFT_MIN = 2
+MAX_RETRIES = 500
+
+MOTIF_H_RANGE = (2, 4)
+MOTIF_W_RANGE = (2, 3)
+FILL_RATIO_MIN = 0.6
+FILL_RATIO_MAX = 0.9
+MOTIF_COLORS_MIN = 2
+MOTIF_COLORS_MAX = 4
+COLOR_POOL = [0, 3, 5, 6, 7, 9]
