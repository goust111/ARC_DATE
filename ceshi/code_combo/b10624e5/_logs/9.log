SOURCE_NOMINAL_SIZE = 2
TARGET_SIZE_RANGE = (1, 4)
MOTIF_H_RANGE = (2, 4)
MOTIF_W_RANGE = (2, 4)
FILL_RATIO_MIN = 0.6
FILL_RATIO_MAX = 0.9
MOTIF_COLORS_MIN = 3
MOTIF_COLORS_MAX = 5
COLOR_POOL = [0, 1, 3, 5, 6, 7, 8, 9]
MAX_RETRIES = 300

SOURCE_ANCHOR = np.array(
