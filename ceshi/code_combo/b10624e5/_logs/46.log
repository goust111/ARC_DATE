+
+def _region_bounds(
+    h: int, w: int, frame_bbox: tuple[int, int, int, int]
+) -> dict[str, tuple[int, int, int, int]]:
+    """Inclusive bounds for center + four outer corner sectors."""
+    r0, c0, r1, c1 = frame_bbox
