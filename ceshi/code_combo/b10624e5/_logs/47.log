+            out[rr, cc] = int(trail)
+
+
+def _find_anchors(g: np.ndarray, mid_r: int, mid_c: int) -> dict[tuple[int, int], tuple[int, int, int]]:
+    """Find one red square anchor per quadrant; values are (r0, c0, size)."""
+    red = components_mask(g == RED, connectivity=4)
