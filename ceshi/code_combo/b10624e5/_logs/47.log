   334	def _assign_colors(
   335	    filled: set[tuple[int, int]],
   336	    red_cells: set[tuple[int, int]],
   337	    h: int,
   338	    w: int,
   339	) -> np.ndarray | None:
   340	    """Assign motif colors; all rows and cols inside the bbox must be represented."""
   341	    rows = {r for r, _ in filled}
   342	    cols = {c for _, c in filled}
   343	    if rows != set(range(h)) or cols != set(range(w)):
   344	        return None
   345	    non_red = [p for p in filled if p not in red_cells]
   346	    random.shuffle(non_red)
   347	    max_colors = min(MOTIF_COLORS_MAX, len(non_red) + 1)
   348	    if max_colors < MOTIF_COLORS_MIN:
   349	        return None
   350	    n_colors = random.randint(MOTIF_COLORS_MIN, max_colors)
   351	    extras = random.sample(COLOR_POOL, n_colors - 1)
   352	    grid = np.full((h, w), BG, dtype=int)
   353	    for r, c in red_cells:
   354	        grid[r, c] = RED
   355	    for i, (r, c) in enumerate(non_red):
   356	        grid[r, c] = extras[i] if i < len(extras) else random.choice(extras)
   357	    return grid
