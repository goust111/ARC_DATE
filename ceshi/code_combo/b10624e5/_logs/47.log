   268	def main(grid: np.ndarray) -> np.ndarray:
   269	    """
   270	    Propagate the source motif around the quadrants in a fixed chain, leaving a visible trail for each hop while ignoring inert distractor blocks.
   271	
   272	    Input structure:
   273	    - One monochrome full row and one matching full column split the 27x27 board into four 13x13 quadrants.
   274	    - Every quadrant contains exactly one red square anchor block; only the top-left quadrant also contains the full source motif attached to its anchor.
   275	    - Extra small non-red colored blocks may appear anywhere outside that source component; they are distractors and do not participate in any copy step.
   276	
   277	    Rule:
   278	    - Extract the top-left motif, then copy it in the fixed order TL -> TR -> BR -> BL.
   279	    - On each hop, reflect the current source patch for the left/right and top/bottom change between the two quadrants, then scale it by the destination-anchor/source-anchor size ratio and align its red region to the destination anchor.
   280	    - After each hop, draw a thin trail from the current source anchor center to the destination anchor center using the dedicated trail color, without overwriting motifs, red anchors, or distractor blocks.
   281	
   282	    Key insight:
   283	    - The output is not three independent copies from TL: the trail topology reveals a chain, and the patch used at BR and BL is whatever the previous hop produced.
   284	    """
   285	    g = np.asarray(grid, dtype=int)
   286	    out = g.copy()
   287	
   288	    bg = get_bg(g)
   289	    mid_r, mid_c = _find_dividers(g, bg)
   290	    divider = int(g[mid_r, mid_c])
   291	    anchors = _find_anchors(g, mid_r, mid_c)
   292	    patch = _extract_source_patch(g, bg, mid_r, mid_c)
   293	
   294	    anchor_sizes = {key: size for key, (_r0, _c0, size) in anchors.items()}
   295	    patches = _build_chain_patches(patch, anchor_sizes)
   296	    assert patches is not None, "iterative scaling must be lossless for every chain hop"
   297	
   298	    for src_key, dst_key in CHAIN:
   299	        sr0, sc0, ssize = anchors[src_key]
   300	        tr0, tc0, _tsize = anchors[dst_key]
   301	        _stamp(out, patches[dst_key], tr0, tc0, bg, divider, TRAIL, mid_r, mid_c)
   302	        _paint_trail(
   303	            out,
   304	            _anchor_center(sr0, sc0, ssize),
   305	            _anchor_center(tr0, tc0, anchors[dst_key][2]),
   306	            bg,
   307	            divider,
   308	            TRAIL,
   309	        )
