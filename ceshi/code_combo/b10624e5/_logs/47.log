   122	def _line_cells(r0: int, c0: int, r1: int, c1: int) -> list[tuple[int, int]]:
   123	    """Return a continuous 8-connected integer line between two cells."""
   124	    dr = int(r1 - r0)
   125	    dc = int(c1 - c0)
