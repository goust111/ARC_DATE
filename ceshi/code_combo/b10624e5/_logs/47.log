   360	def _source_patch() -> tuple[np.ndarray, int, int] | None:
   361	    """Build a logical motif and upscale it so every source cell is a 2x2 block."""
   362	    lh, lw = random.choice(BLOCK_DIMS)
   363	    n_cells = lh * lw
   364	    min_fill = max(3, int(np.ceil(FILL_RATIO_MIN * n_cells)))
   365	    max_fill = max(min_fill, int(np.floor(FILL_RATIO_MAX * n_cells)))
   366	    ar, ac = random.randrange(lh), random.randrange(lw)
   367	    filled = _grow_4conn(lh, lw, {(ar, ac)}, random.randint(min_fill, max_fill))
   368	    logical = _assign_colors(filled, {(ar, ac)}, lh, lw)
   369	    if logical is None:
   370	        return None
   371	    patch = np.repeat(np.repeat(logical, SOURCE_ANCHOR_SIZE, axis=0), SOURCE_ANCHOR_SIZE, axis=1)
   372	    return patch, int(ar * SOURCE_ANCHOR_SIZE), int(ac * SOURCE_ANCHOR_SIZE)
