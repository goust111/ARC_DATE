+        q_r0, q_r1, q_c0, q_c1 = QUADS[(qb, qr)]
+        for h, w in DISTRACTOR_SHAPES:
+            for r0 in range(q_r0, q_r1 - h + 2):
+                for c0 in range(q_c0, q_c1 - w + 2):
