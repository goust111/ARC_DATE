   314	def _grow_4conn(h: int, w: int, seeds: set[tuple[int, int]], n_fill: int) -> set[tuple[int, int]]:
   315	    """Grow a 4-connected region from seeds until it has n_fill cells."""
   316	    filled = set(seeds)
   317	    frontier = set()
   318	    for r, c in seeds:
   319	        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
   320	            nr, nc = r + dr, c + dc
   321	            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in filled:
   322	                frontier.add((nr, nc))
   323	    while len(filled) < n_fill and frontier:
   324	        cell = random.choice(list(frontier))
   325	        filled.add(cell)
   326	        frontier.discard(cell)
   327	        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
   328	            nr, nc = cell[0] + dr, cell[1] + dc
   329	            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in filled:
   330	                frontier.add((nr, nc))
   331	    return filled
