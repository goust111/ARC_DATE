+    tgt_cc = src_cc + place_c0
+    valid = (
+        (tgt_rr >= 0)
+        & (tgt_rr < out.shape[0])
+        & (tgt_cc >= 0)
+        & (tgt_cc < out.shape[1])
+        & (tgt_rr != mid_r)
+        & (tgt_cc != mid_c)
