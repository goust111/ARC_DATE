+        (tgt_rr >= 0)
+        & (tgt_rr < GRID_SIZE)
+        & (tgt_cc >= 0)
+        & (tgt_cc < GRID_SIZE)
+        & (tgt_rr != MID)
+        & (tgt_cc != MID)
+    )
+    tgt_rr = tgt_rr[valid]
+    tgt_cc = tgt_cc[valid]
+    src_rr = src_rr[valid]
+    src_cc = src_cc[valid]
