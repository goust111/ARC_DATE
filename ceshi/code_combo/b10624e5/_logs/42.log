    tgt_rr = tgt_rr[valid]
    tgt_cc = tgt_cc[valid]
    src_rr = src_rr[valid]
    src_cc = src_cc[valid]
    keep = ~np.isin(out[tgt_rr, tgt_cc], np.array(ANCHOR_COLORS))
    out[tgt_rr[keep], tgt_cc[keep]] = patch_s[src_rr[keep], src_cc[keep]]


def _target_sizes() -> dict[tuple[int, int], int]:
    while True:
        sizes = {(0, 0): SOURCE_ANCHOR_SIZE}

