+    tl_c0 = random.randint(0, MID - patch.shape[1])
+    anchors[(0, 0)] = (tl_r0 + anchor_r_in_patch, tl_c0 + anchor_c_in_patch)
+    for key, spec in target_specs.items():
+        anchor = _choose_anchor(
+            key,
+            int(spec["size"]),
+            realized[key],
+            str(spec["side"]),
+            int(spec["marker_len"]),
