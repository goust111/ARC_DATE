    ```python
    import numpy as np

from arc_utils import bbox_coords, components_mask, get_bg, paste
import random


def _find_dividers(g: np.ndarray, bg: int) -> tuple[int, int]:
    """
    Return the unique full-row/full-col quadrant divider: (mid_row, mid_col).
    """
    h, w = g.shape
    full_rows = [(r, int(g[r, 0])) for r in range(h) if np.all(g[r, :] == g[r, 0]) and int(g[r, 0]) != bg]
    full_cols = [(c, int(g[0, c])) for c in range(w) if np.all(g[:, c] == g[0, c]) and int(g[0, c]) != bg]
    matches = []
    for r, vr in full_rows:
        for c, vc in full_cols:
            if vr == vc:
                matches.append((int(r), int(c)))
    assert len(matches) == 1, "grid must have exactly one matching full-row/full-col divider"
    return matches[0]


def main(grid: np.ndarray) -> np.ndarray:
    """
    Replicate a motif across quadrants with scaling and reflection keyed to red anchor blocks.

    Input structure:
    - Grid divided into four quadrants by a full-row and full-column divider of a single non-bg color.
    - Each quadrant contains a red (2) square anchor block of varying size.
    - The top-left quadrant also has a colored motif attached to its red anchor.

    Rule:
    - Use the top-left quadrant's motif as the source pattern.
    - For each other quadrant, scale the motif by the ratio of that quadrant's red block size to the source red block size.
    - Reflect horizontally for right-side quadrants, vertically for bottom quadrants (both for bottom-right).
    - Align the scaled/reflected motif so its red region overlaps the target anchor, then stamp non-bg pixels.

    Key insight: Red block size encodes the scale factor; quadrant position encodes the reflection axes.
    """
    g = np.asarray(grid, dtype=int)
    h, w = g.shape
    out = g.copy()

    bg = get_bg(g)
    mid_r, mid_c = _find_dividers(g, bg)

    # Find red anchor blocks (color 2) in each quadrant.
    red = components_mask(g == 2, connectivity=4)
    assert red, "grid must contain red (color 2) anchor blocks"

    # Quadrant key: (top/bottom, left/right)
    anchors: dict[tuple[int, int], tuple[int, int, int]] = {}
    # value: (r0,c0,size)
    for pts in red:
        r0, c0, r1, c1 = bbox_coords(pts)
        rr = (r0 + r1) // 2
        cc = (c0 + c1) // 2
        qb = 0 if rr < mid_r else 1
        qr = 0 if cc < mid_c else 1
        size = max(r1 - r0 + 1, c1 - c0 + 1)
        key = (qb, qr)
        assert key not in anchors, "each quadrant must contain exactly one red anchor block"
        anchors[key] = (int(r0), int(c0), int(size))

    assert (0, 0) in anchors, "top-left quadrant must contain a red anchor block"
    sr0, sc0, sL = anchors[(0, 0)]
    assert sL > 0, "top-left red anchor must have positive size"

    # Build a source patch around the TL motif: take the non-bg connected component (4-neigh)
    # in the TL quadrant that contains the TL red anchor.
    tl = g[0:mid_r, 0:mid_c]
    comps = components_mask(tl != bg, connectivity=4)
    patch_bb = None
    for pts in comps:
        # component contains any red pixel?
        if any(tl[r, c] == 2 for r, c in pts):
            r0, c0, r1, c1 = bbox_coords(pts)
            patch_bb = (int(r0), int(c0), int(r1), int(c1))
            break
    assert patch_bb is not None, "top-left quadrant must contain a non-bg component with a red pixel"

    pr0, pc0, pr1, pc1 = patch_bb
    patch = tl[pr0 : pr1 + 1, pc0 : pc1 + 1].copy()

    def resize_nn(img: np.ndarray, new_h: int, new_w: int) -> np.ndarray:
        src_h, src_w = img.shape
        if new_h <= 0 or new_w <= 0:
            return img.copy()
        rr = (np.floor(np.arange(new_h) * src_h / new_h)).astype(int)
        cc = (np.floor(np.arange(new_w) * src_w / new_w)).astype(int)
        rr = np.clip(rr, 0, src_h - 1)
        cc = np.clip(cc, 0, src_w - 1)
        return img[rr[:, None], cc[None, :]]

    # For each quadrant anchor, paste a scaled/reflected version of the patch.
    for (qb, qr), (tr0, tc0, tL) in anchors.items():
        if (qb, qr) == (0, 0):
            continue
        patch_t = patch
        if qr == 1:
            patch_t = np.fliplr(patch_t)
        if qb == 1:
            patch_t = np.flipud(patch_t)

        ratio = float(tL) / float(sL)
        new_h = int(round(patch_t.shape[0] * ratio))
        new_w = int(round(patch_t.shape[1] * ratio))
        new_h = max(1, new_h)
        new_w = max(1, new_w)
        patch_s = resize_nn(patch_t, new_h, new_w)
        roundtrip = resize_nn(patch_s, patch_t.shape[0], patch_t.shape[1])
        assert np.array_equal(roundtrip, patch_t), "scaling must preserve all motif information"

        # Align scaled red bbox in patch_s to the target red bbox.
        rr_red, cc_red = np.where(patch_s == 2)
        assert rr_red.size > 0, "scaled source patch must contain red anchor pixels"
        ar0, ac0 = int(rr_red.min()), int(cc_red.min())
        place_r0 = tr0 - ar0
        place_c0 = tc0 - ac0

        rr_p, cc_p = np.where(patch_s != bg)
        for rr0, cc0 in zip(rr_p.tolist(), cc_p.tolist(), strict=False):
            val = int(patch_s[rr0, cc0])
            rr_t = place_r0 + rr0
            cc_t = place_c0 + cc0
            if not (0 <= rr_t < h and 0 <= cc_t < w):
                continue
            if rr_t == mid_r or cc_t == mid_c:
                continue
            if out[rr_t, cc_t] == 2:
                continue
            out[rr_t, cc_t] = val

    return out

# --------------- generator (o5x) ---------------

# --- Grid constants ---
BG = 4                  # background color
DIV = 1                 # divider color
RED = 2                 # anchor color
GRID_SIZE = 27          # full grid dimension
MID = 13                # divider row/col index
QUADS = {               # (row_lo, row_hi, col_lo, col_hi) inclusive per quadrant
    (0, 0): (0, 12, 0, 12),
    (0, 1): (0, 12, 14, 26),
    (1, 0): (14, 26, 0, 12),
    (1, 1): (14, 26, 14, 26),
}

# --- Source motif parameters ---
SOURCE_ANCHOR_SIZE = 2                  # TL anchor is always 2x2
BLOCK_DIMS = [(2, 2), (2, 3), (3, 2), (3, 3)]  # logical block sizes for block method
BLOCK_PROB = 0.5                        # prob of block method when not forced
FILL_RATIO_MIN = 0.5                    # minimum motif fill ratio
FILL_RATIO_MAX = 0.8                    # maximum motif fill ratio
FREEFORM_H_RANGE = (3, 6)              # freeform motif height range
FREEFORM_W_RANGE = (3, 6)              # freeform motif width range
MOTIF_COLORS_MIN = 3                    # min distinct non-bg colors (including red)
MOTIF_COLORS_MAX = 5                    # max distinct non-bg colors
COLOR_POOL = [0, 1, 3, 5, 6, 7, 8, 9]  # non-red, non-bg candidate colors

# --- Target anchor parameters ---
TARGET_SIZE_RANGE = (1, 4)              # anchor size range for non-TL quadrants

# --- Generation retry limit ---
MAX_RETRIES = 300


def _resize_nn(img: np.ndarray, new_h: int, new_w: int) -> np.ndarray:
    """Nearest-neighbor resize supporting fractional scale ratios."""
    src_h, src_w = img.shape
    rr = np.clip(np.floor(np.arange(new_h) * src_h / new_h).astype(int), 0, src_h - 1)
    cc = np.clip(np.floor(np.arange(new_w) * src_w / new_w).astype(int), 0, src_w - 1)
    return img[rr[:, None], cc[None, :]]


def _scaled_patch(patch: np.ndarray, qb: int, qr: int, target_size: int) -> np.ndarray:
    """Reflect and scale the source patch for a given quadrant and target anchor size."""
    p = patch
    if qr:
        p = np.fliplr(p)
    if qb:
        p = np.flipud(p)
    ratio = target_size / SOURCE_ANCHOR_SIZE
    h = max(1, int(round(p.shape[0] * ratio)))
    w = max(1, int(round(p.shape[1] * ratio)))
    return _resize_nn(p, h, w)


def _grow_4conn(h: int, w: int, seeds: set[tuple[int, int]], n_fill: int) -> set[tuple[int, int]]:
    """Grow a 4-connected region from seeds until it has n_fill cells."""
    filled = set(seeds)
    frontier = set()
    for r, c in seeds:
        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
            nr, nc = r + dr, c + dc
            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in filled:
                frontier.add((nr, nc))
    while len(filled) < n_fill and frontier:
        cell = random.choice(list(frontier))
        filled.add(cell)
        frontier.discard(cell)
        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
            nr, nc = cell[0] + dr, cell[1] + dc
            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in filled:
                frontier.add((nr, nc))
    return filled


def _assign_colors(filled: set[tuple[int, int]], red_cells: set[tuple[int, int]],
                   h: int, w: int) -> np.ndarray | None:
    """Assign random colors to filled cells; returns None if coverage is incomplete."""
    rows = {r for r, _ in filled}
    cols = {c for _, c in filled}
    if rows != set(range(h)) or cols != set(range(w)):
        return None
    non_red = [p for p in filled if p not in red_cells]
    random.shuffle(non_red)
    max_colors = min(MOTIF_COLORS_MAX, len(non_red) + 1)
    if max_colors < MOTIF_COLORS_MIN:
        return None
    n_colors = random.randint(MOTIF_COLORS_MIN, max_colors)
    pool = COLOR_POOL[:]
    random.shuffle(pool)
    extras = pool[: n_colors - 1]
    grid = np.full((h, w), BG, dtype=int)
    for r, c in red_cells:
        grid[r, c] = RED
    for i, (r, c) in enumerate(non_red):
        grid[r, c] = extras[i] if i < len(extras) else random.choice(extras)
    return grid


def _source_patch(needs_block: bool) -> tuple[np.ndarray, int, int] | None:
    """Build the TL motif patch. Block method upscales a logical grid by SOURCE_ANCHOR_SIZE;
    freeform method grows directly at pixel resolution with a 2x2 red anchor."""
    S = SOURCE_ANCHOR_SIZE
    use_block = needs_block or random.random() < BLOCK_PROB
    if use_block:
        lh, lw = random.choice(BLOCK_DIMS)
        n_cells = lh * lw
        min_fill = max(3, int(np.ceil(FILL_RATIO_MIN * n_cells)))
        max_fill = max(min_fill, int(np.floor(FILL_RATIO_MAX * n_cells)))
        ar, ac = random.randrange(lh), random.randrange(lw)
        filled = _grow_4conn(lh, lw, {(ar, ac)}, random.randint(min_fill, max_fill))
        logical = _assign_colors(filled, {(ar, ac)}, lh, lw)
        if logical is None:
            return None
        patch = np.repeat(np.repeat(logical, S, axis=0), S, axis=1)
        return patch, ar * S, ac * S
    else:
        h = random.randint(*FREEFORM_H_RANGE)
        w = random.randint(*FREEFORM_W_RANGE)
        ar, ac = random.randint(0, h - S), random.randint(0, w - S)
        red_cells = {(ar + dr, ac + dc) for dr in range(S) for dc in range(S)}
        min_fill = max(len(red_cells) + 2, int(np.ceil(FILL_RATIO_MIN * h * w)))
        max_fill = int(np.floor(FILL_RATIO_MAX * h * w))
        if max_fill < min_fill:
            return None
        filled = _grow_4conn(h, w, red_cells, random.randint(min_fill, max_fill))
        patch = _assign_colors(filled, red_cells, h, w)
        if patch is None:
            return None
        return patch, ar, ac


def _choose_anchor(qb: int, qr: int, size: int, patch_s: np.ndarray) -> tuple[int, int]:
    """Pick a random anchor position for the red block within the quadrant,
    preferring positions where the full scaled motif fits inside the quadrant."""
    q_r0, q_r1, q_c0, q_c1 = QUADS[(qb, qr)]
    rr, cc = np.where(patch_s == RED)
    red_r0, red_c0 = int(rr.min()), int(cc.min())

    # Range where the full motif fits inside the quadrant
    fit_r0 = q_r0 + red_r0
    fit_r1 = q_r1 - patch_s.shape[0] + 1 + red_r0
    fit_c0 = q_c0 + red_c0
    fit_c1 = q_c1 - patch_s.shape[1] + 1 + red_c0

    # Range where the anchor block itself fits inside the quadrant
    anch_r0, anch_r1 = q_r0, q_r1 - size + 1
    anch_c0, anch_c1 = q_c0, q_c1 - size + 1

    # Intersect: prefer full-fit, fall back to anchor-only fit
    r_lo, r_hi = max(fit_r0, anch_r0), min(fit_r1, anch_r1)
    c_lo, c_hi = max(fit_c0, anch_c0), min(fit_c1, anch_c1)
    if r_lo <= r_hi and c_lo <= c_hi:
        return random.randint(r_lo, r_hi), random.randint(c_lo, c_hi)
    return random.randint(anch_r0, anch_r1), random.randint(anch_c0, anch_c1)


def _stamp(out: np.ndarray, patch_s: np.ndarray, anchor_r: int, anchor_c: int) -> None:
    """Stamp non-bg pixels from a scaled patch onto the output grid, aligned by red anchor.
    Skips divider row/col, out-of-bounds pixels, and existing red pixels."""
    rr_red, cc_red = np.where(patch_s == RED)
    place_r0 = anchor_r - int(rr_red.min())
    place_c0 = anchor_c - int(cc_red.min())

    # Source pixel coordinates and their target positions
    src_rr, src_cc = np.where(patch_s != BG)
    tgt_rr = src_rr + place_r0
    tgt_cc = src_cc + place_c0

    # Mask: in-bounds, not on divider, target is not already red
    valid = ((tgt_rr >= 0) & (tgt_rr < GRID_SIZE) &
             (tgt_cc >= 0) & (tgt_cc < GRID_SIZE) &
             (tgt_rr != MID) & (tgt_cc != MID))
    tgt_rr, tgt_cc, src_rr, src_cc = tgt_rr[valid], tgt_cc[valid], src_rr[valid], src_cc[valid]
    not_red = out[tgt_rr, tgt_cc] != RED
    out[tgt_rr[not_red], tgt_cc[not_red]] = patch_s[src_rr[not_red], src_cc[not_red]]


def _gen_attempt() -> np.ndarray | None:
    """Single generation attempt: build output, derive input, oracle-check."""
    target_sizes = {
        (0, 0): SOURCE_ANCHOR_SIZE,
        (0, 1): random.randint(*TARGET_SIZE_RANGE),
        (1, 0): random.randint(*TARGET_SIZE_RANGE),
        (1, 1): random.randint(*TARGET_SIZE_RANGE),
    }

    needs_block = any(s % SOURCE_ANCHOR_SIZE != 0 for k, s in target_sizes.items() if k != (0, 0))
    source = _source_patch(needs_block)
    if source is None:
        return None
    patch, anchor_r_in_patch, anchor_c_in_patch = source

    scaled = {
        key: _scaled_patch(patch, key[0], key[1], size)
        for key, size in target_sizes.items()
        if key != (0, 0)
    }

    # Place anchors
    anchors: dict[tuple[int, int], tuple[int, int]] = {}
    tl_r0 = random.randint(0, MID - patch.shape[0])
    tl_c0 = random.randint(0, MID - patch.shape[1])
    anchors[(0, 0)] = (tl_r0 + anchor_r_in_patch, tl_c0 + anchor_c_in_patch)
    for key, patch_s in scaled.items():
        anchors[key] = _choose_anchor(key[0], key[1], target_sizes[key], patch_s)

    # Build output grid
    out = np.full((GRID_SIZE, GRID_SIZE), BG, dtype=int)
    out[MID, :] = DIV
    out[:, MID] = DIV
    paste(out, patch, tl_r0, tl_c0)
    for key, size in target_sizes.items():
        if key == (0, 0):
            continue
        ar, ac = anchors[key]
        paste(out, np.full((size, size), RED, dtype=int), ar, ac)
    for key, patch_s in scaled.items():
        _stamp(out, patch_s, *anchors[key])

    # Build input: clear non-TL quadrants, keep only red anchors
    inp = out.copy()
    for key, size in target_sizes.items():
        if key == (0, 0):
            continue
        q_r0, q_r1, q_c0, q_c1 = QUADS[key]
        inp[q_r0 : q_r1 + 1, q_c0 : q_c1 + 1] = BG
        ar, ac = anchors[key]
        paste(inp, np.full((size, size), RED, dtype=int), ar, ac)

    return inp if np.array_equal(main(inp), out) else None


def generate_input() -> np.ndarray:
    for _ in range(MAX_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid b10624e5 input")

    ```

    ## 原始任务规格（Spec）

    以下是从原始 solver 代码和示例中提炼的完整任务规格，包含精确的数值约束和生成策略。
    Spec 本身就是原题代码生成时的参考文件，因此：
    - 在**设计分析**阶段，参考 spec 理解原始任务的完整设计细节（对象结构、空间关系、生成策略等），以此为基础思考融合变体的改动如何落实
    - 在**实现**阶段，参考 spec 中的数值约束（网格尺寸、对象数量/尺寸、颜色数等），确保融合变体在物理上可实现

    ```yaml
    spec:
  grid: 27x27, bg=4 [observed], divider color=1 [observed]
  divider: one full row + one full col of same non-bg color crossing at (13,13), splitting grid into four 13x13 quadrants
  anchors:
    count: exactly 4, one per quadrant
    shape: NxN filled red (color 2) squares
    source: TL anchor is always 2x2 [observed]
    target_sizes: 1-4; each quadrant gets a distinct or shared size; set includes sizes from {1,2,3,4}
    position: anywhere within the quadrant with room for the scaled motif (clipping at grid edge is OK)
  motif:
    location: TL quadrant only; single 4-connected non-bg component containing the red anchor
    shape: 2-6 rows x 2-6 cols bounding box; fill ratio 0.5-0.8 (contains bg holes)
    colors: 3-5 distinct non-bg colors including red (2); may include divider color
    connectivity: all non-bg pixels form one 4-connected component
    exact_scaling: nearest-neighbor resize to any target anchor size must be lossless (roundtrip: resize to target then back to source recovers the original pixel-for-pixel)
  non_TL_quadrants_input: contain ONLY the red anchor block (no other non-bg pixels)
  output_rule: |
    For each non-TL quadrant, scale the TL motif by (target_anchor_size / source_anchor_size)
    via nearest-neighbor resize. Reflect LR for right quadrants, UD for bottom quadrants,
    both for BR. Align scaled red region onto target anchor and stamp non-bg pixels.
    Skip divider row/col and existing red pixels. Clip at grid bounds.

generation_strategy:
  approach: output-first
  steps:
    1. Fix grid 27x27, bg=4, divider color=1 at row 13 col 13.
    2. Choose 3 target anchor sizes from {1,2,3,4} for TR/BL/BR (source TL is always 2).
    3. Design the source motif (4-connected, 3-5 non-bg colors including red 2, red anchor occupies a 2×2 sub-region). Motif must satisfy exact_scaling constraint for all chosen target sizes.
    4. For each of the 4 quadrants, compute the scaled+reflected motif. Verify all
       scaled motifs have >=1 non-bg pixel visible in their quadrant (not fully clipped).
    5. Place anchors in each quadrant so that the scaled motif fits reasonably (allow partial clipping at grid edge).
    6. Build the input: fill grid with bg+divider, place TL motif, place only-red-anchors in TR/BL/BR.
    ```

额外要求：原始代码的 `main()` 已包含四段式说明注释/文档字符串（开头概述 + `Input structure:` + `Rule:` + `Key insight:`）。
生成的新代码里也必须在 `main()` 上方保留这一结构，并根据**融合后的新规则**与**原注释提供的信息**重新编写；可以借鉴原注释的组织方式，但**不要照抄原文**，要让内容准确反映融合后的输入结构、规则和关键洞察。


## 已有单变体参考代码

以下组成项已有单变体实现，可作为融合时的参考：

            ### 参考代码: D5/0

            文件: `/home/lixinyu/snap/new/ceshi/code/b10624e5/D5/0/code.py`

            ```python
            # Variant of b10624e5
# Dimension: D5 — 变换：反射规则 (transform)
# Change: 反射轴由源与目标的象限相对位置决定——左右关系用水平轴反射，上下关系用垂直轴反射，对角关系用双轴反射... → 旋转替代反射

import random

import numpy as np

from arc_utils import bbox_coords, components_mask, get_bg, paste


# Design analysis for this D5 variant
# -----------------------------------
# spec:
#   unchanged_structure:
#     grid: 27x27 with one full-row/full-col divider at (13, 13)
#     anchors: exactly one red square per quadrant, TL anchor fixed at 2x2
#     motif: only TL contains the full colored 4-connected motif attached to its red anchor
#     scaling: non-TL motifs still use nearest-neighbor scaling by target_anchor_size / 2
#     alignment: scaled red area is still aligned to the target red anchor before stamping
#   core_change:
#     old_transform:
#       TR: left-right reflection
#       BL: up-down reflection
#       BR: both reflections
#     new_transform:
#       TR: 90 degrees clockwise
#       BL: 270 degrees clockwise
#       BR: 180 degrees
#   concrete_trace:
#     example:
#       source_patch: a 4x6 asymmetric motif whose extra colors sit mostly above and left of the 2x2 red block
#       old_TR: fliplr keeps the patch 4x6 and swaps left/right mass
#       new_TR: rot90 makes it 6x4 and moves the same mass below/left in the rotated frame
#       difference: width/height swap plus pixel relocation, so the right-top quadrant visibly stops looking mirrored
#   complexity_calibration:
#     why_not_more_changes:
#       Only the transform operator changes; divider detection, anchor extraction, source-component detection,
#       scaling and stamping remain intact so the task is still recognizably the same puzzle family.
#     why_some_generator_filtering_is_needed:
#       BR is unchanged because double reflection equals 180-degree rotation.
#       Therefore observability must come from TR and BL, and symmetric motifs must be rejected.
#   implicit_assumptions_review:
#     main_lines_affected:
#       - the original `fliplr` / `flipud` branch assumed quadrant relation was encoded as reflections
#       - the red-anchor alignment code assumes transformed motifs still contain a contiguous red block
#       - the scaling roundtrip assertion assumes rotation preserves the same lossless-resize property as reflection
#     status_in_variant:
#       - replaced with a fixed quadrant->rotation mapping
#       - preserved because rotating a square red anchor keeps it square and connected
#       - preserved because rotation only permutes pixels before resize; it does not add new frequencies
#   placement_legality:
#     generator still chooses anchor positions from the transformed+scaled patch footprint, so rotated rectangular
#     motifs also fit inside their quadrants whenever the preferred full-fit range exists.
#   visual_observability:
#     generator compares the rotation output against the legacy reflection output using the same anchors and sizes.
#     Samples are accepted only when TR or BL show non-red pixel differences after scaling, preventing degeneration.
#   cleanliness:
#     Non-TL input quadrants still contain only one red block each, so the rotated copies appear in isolated regions
#     without extra labels or overlapping clues.


ROTATION_K = {
    (0, 0): 0,
    (0, 1): 3,  # 90 degrees clockwise; np.rot90 uses CCW
    (1, 0): 1,  # 270 degrees clockwise
    (1, 1): 2,  # 180 degrees
}


def _find_dividers(g: np.ndarray, bg: int) -> tuple[int, int]:
    """Return the unique full-row/full-col quadrant divider: (mid_row, mid_col)."""
    h, w = g.shape
    full_rows = [(r, int(g[r, 0])) for r in range(h) if np.all(g[r, :] == g[r, 0]) and int(g[r, 0]) != bg]
    full_cols = [(c, int(g[0, c])) for c in range(w) if np.all(g[:, c] == g[0, c]) and int(g[0, c]) != bg]
    matches = []
    for r, vr in full_rows:
        for c, vc in full_cols:
            if vr == vc:
                matches.append((int(r), int(c)))
    assert len(matches) == 1, "grid must have exactly one matching full-row/full-col divider"
    return matches[0]


def _resize_nn(img: np.ndarray, new_h: int, new_w: int) -> np.ndarray:
    src_h, src_w = img.shape
    if new_h <= 0 or new_w <= 0:
        return img.copy()
    rr = np.clip(np.floor(np.arange(new_h) * src_h / new_h).astype(int), 0, src_h - 1)
    cc = np.clip(np.floor(np.arange(new_w) * src_w / new_w).astype(int), 0, src_w - 1)
    return img[rr[:, None], cc[None, :]]


def _transform_patch(patch: np.ndarray, qb: int, qr: int, *, use_rotation: bool) -> np.ndarray:
    if use_rotation:
        return np.rot90(patch, ROTATION_K[(qb, qr)])
    out = patch
    if qr == 1:
        out = np.fliplr(out)
    if qb == 1:
        out = np.flipud(out)
    return out


def _solve(grid: np.ndarray, *, use_rotation: bool) -> np.ndarray:
    g = np.asarray(grid, dtype=int)
    h, w = g.shape
    out = g.copy()

    bg = get_bg(g)
    mid_r, mid_c = _find_dividers(g, bg)

    red = components_mask(g == 2, connectivity=4)
    assert red, "grid must contain red (color 2) anchor blocks"

    anchors: dict[tuple[int, int], tuple[int, int, int]] = {}
    for pts in red:
        r0, c0, r1, c1 = bbox_coords(pts)
        rr = (r0 + r1) // 2
        cc = (c0 + c1) // 2
        qb = 0 if rr < mid_r else 1
        qr = 0 if cc < mid_c else 1
        size = max(r1 - r0 + 1, c1 - c0 + 1)
        key = (qb, qr)
        assert key not in anchors, "each quadrant must contain exactly one red anchor block"
        anchors[key] = (int(r0), int(c0), int(size))

    assert (0, 0) in anchors, "top-left quadrant must contain a red anchor block"
    _sr0, _sc0, sL = anchors[(0, 0)]
    assert sL > 0, "top-left red anchor must have positive size"

    tl = g[0:mid_r, 0:mid_c]
    comps = components_mask(tl != bg, connectivity=4)
    patch_bb = None
    for pts in comps:
        if any(tl[r, c] == 2 for r, c in pts):
            r0, c0, r1, c1 = bbox_coords(pts)
            patch_bb = (int(r0), int(c0), int(r1), int(c1))
            break
    assert patch_bb is not None, "top-left quadrant must contain a non-bg component with a red pixel"

    pr0, pc0, pr1, pc1 = patch_bb
    patch = tl[pr0 : pr1 + 1, pc0 : pc1 + 1].copy()

    for (qb, qr), (tr0, tc0, tL) in anchors.items():
        if (qb, qr) == (0, 0):
            continue

        patch_t = _transform_patch(patch, qb, qr, use_rotation=use_rotation)
        ratio = float(tL) / float(sL)
        new_h = max(1, int(round(patch_t.shape[0] * ratio)))
        new_w = max(1, int(round(patch_t.shape[1] * ratio)))
        patch_s = _resize_nn(patch_t, new_h, new_w)
        roundtrip = _resize_nn(patch_s, patch_t.shape[0], patch_t.shape[1])
        assert np.array_equal(roundtrip, patch_t), "scaling must preserve all motif information"

        rr_red, cc_red = np.where(patch_s == 2)
        assert rr_red.size > 0, "scaled source patch must contain red anchor pixels"
        ar0, ac0 = int(rr_red.min()), int(cc_red.min())
        place_r0 = tr0 - ar0
        place_c0 = tc0 - ac0

        rr_p, cc_p = np.where(patch_s != bg)
        for rr0, cc0 in zip(rr_p.tolist(), cc_p.tolist(), strict=False):
            val = int(patch_s[rr0, cc0])
            rr_t = place_r0 + rr0
            cc_t = place_c0 + cc0
            if not (0 <= rr_t < h and 0 <= cc_t < w):
                continue
            if rr_t == mid_r or cc_t == mid_c:
                continue
            if out[rr_t, cc_t] == 2:
                continue
            out[rr_t, cc_t] = val

    return out


def main(grid: np.ndarray) -> np.ndarray:
    """
    Copy the top-left motif to the other quadrants using anchor-based scaling and rotation.

    Input structure:
    - A full row and full column of one non-background color split the board into four quadrants.
    - Each quadrant contains one red square anchor, and the top-left quadrant also contains the full colored motif.
    - The top-left motif is a single non-background component that includes the red anchor.

    Rule:
    - Treat the top-left motif as the source patch.
    - Resize that patch for each other quadrant according to the ratio between the target red square size and the top-left red square size.
    - Replace the old mirror rule with rotations: top-right gets 90 degrees clockwise, bottom-left gets 270 degrees clockwise, bottom-right gets 180 degrees.
    - Align the transformed red area to the target anchor and stamp the non-background pixels while leaving the divider row and column untouched.

    Key insight: The red square size still encodes scale, but quadrant location now selects a fixed rotation instead of a reflection axis.
    """
    return _solve(grid, use_rotation=True)


# --------------- generator (o5x) ---------------

# --- Grid constants ---
BG = 4
DIV = 1
RED = 2
GRID_SIZE = 27
MID = 13
QUADS = {
    (0, 0): (0, 12, 0, 12),
    (0, 1): (0, 12, 14, 26),
    (1, 0): (14, 26, 0, 12),
    (1, 1): (14, 26, 14, 26),
}

# --- Source motif parameters ---
SOURCE_ANCHOR_SIZE = 2
BLOCK_DIMS = [(2, 2), (2, 3), (3, 2), (3, 3)]
BLOCK_PROB = 0.5
FILL_RATIO_MIN = 0.5
FILL_RATIO_MAX = 0.8
FREEFORM_H_RANGE = (3, 6)
FREEFORM_W_RANGE = (3, 6)
MOTIF_COLORS_MIN = 3
MOTIF_COLORS_MAX = 5
COLOR_POOL = [0, 1, 3, 5, 6, 7, 8, 9]

# --- Target anchor parameters ---
TARGET_SIZE_RANGE = (1, 4)

# --- Generation retry limit ---
MAX_RETRIES = 400


def _scaled_patch(
    patch: np.ndarray, qb: int, qr: int, target_size: int, *, use_rotation: bool
) -> np.ndarray:
    """Transform and scale the source patch for a given quadrant and target anchor size."""
    p = _transform_patch(patch, qb, qr, use_rotation=use_rotation)
    ratio = target_size / SOURCE_ANCHOR_SIZE
    h = max(1, int(round(p.shape[0] * ratio)))
    w = max(1, int(round(p.shape[1] * ratio)))
    return _resize_nn(p, h, w)


def _grow_4conn(h: int, w: int, seeds: set[tuple[int, int]], n_fill: int) -> set[tuple[int, int]]:
    """Grow a 4-connected region from seeds until it has n_fill cells."""
    filled = set(seeds)
    frontier = set()
    for r, c in seeds:
        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
            nr, nc = r + dr, c + dc
            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in filled:
                frontier.add((nr, nc))
    while len(filled) < n_fill and frontier:
        cell = random.choice(list(frontier))
        filled.add(cell)
        frontier.discard(cell)
        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
            nr, nc = cell[0] + dr, cell[1] + dc
            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in filled:
                frontier.add((nr, nc))
    return filled


def _assign_colors(
    filled: set[tuple[int, int]], red_cells: set[tuple[int, int]], h: int, w: int
) -> np.ndarray | None:
    """Assign random colors to filled cells; returns None if coverage is incomplete."""
    rows = {r for r, _ in filled}
    cols = {c for _, c in filled}
    if rows != set(range(h)) or cols != set(range(w)):
        return None
    non_red = [p for p in filled if p not in red_cells]
    random.shuffle(non_red)
    max_colors = min(MOTIF_COLORS_MAX, len(non_red) + 1)
    if max_colors < MOTIF_COLORS_MIN:
        return None
    n_colors = random.randint(MOTIF_COLORS_MIN, max_colors)
    pool = COLOR_POOL[:]
    random.shuffle(pool)
    extras = pool[: n_colors - 1]
    grid = np.full((h, w), BG, dtype=int)
    for r, c in red_cells:
        grid[r, c] = RED
    for i, (r, c) in enumerate(non_red):
        grid[r, c] = extras[i] if i < len(extras) else random.choice(extras)
    return grid


def _source_patch(needs_block: bool) -> tuple[np.ndarray, int, int] | None:
    """Build the TL motif patch."""
    s = SOURCE_ANCHOR_SIZE
    use_block = needs_block or random.random() < BLOCK_PROB
    if use_block:
        lh, lw = random.choice(BLOCK_DIMS)
        n_cells = lh * lw
        min_fill = max(3, int(np.ceil(FILL_RATIO_MIN * n_cells)))
        max_fill = max(min_fill, int(np.floor(FILL_RATIO_MAX * n_cells)))
        ar, ac = random.randrange(lh), random.randrange(lw)
        filled = _grow_4conn(lh, lw, {(ar, ac)}, random.randint(min_fill, max_fill))
        logical = _assign_colors(filled, {(ar, ac)}, lh, lw)
        if logical is None:
            return None
        patch = np.repeat(np.repeat(logical, s, axis=0), s, axis=1)
        return patch, ar * s, ac * s

    h = random.randint(*FREEFORM_H_RANGE)
    w = random.randint(*FREEFORM_W_RANGE)
    ar, ac = random.randint(0, h - s), random.randint(0, w - s)
    red_cells = {(ar + dr, ac + dc) for dr in range(s) for dc in range(s)}
    min_fill = max(len(red_cells) + 2, int(np.ceil(FILL_RATIO_MIN * h * w)))
    max_fill = int(np.floor(FILL_RATIO_MAX * h * w))
    if max_fill < min_fill:
        return None
    filled = _grow_4conn(h, w, red_cells, random.randint(min_fill, max_fill))
    patch = _assign_colors(filled, red_cells, h, w)
    if patch is None:
        return None
    return patch, ar, ac


def _choose_anchor(qb: int, qr: int, size: int, patch_s: np.ndarray) -> tuple[int, int]:
    """Pick a random anchor position within the quadrant, preferring full motif fit."""
    q_r0, q_r1, q_c0, q_c1 = QUADS[(qb, qr)]
    rr, cc = np.where(patch_s == RED)
    red_r0, red_c0 = int(rr.min()), int(cc.min())

    fit_r0 = q_r0 + red_r0
    fit_r1 = q_r1 - patch_s.shape[0] + 1 + red_r0
    fit_c0 = q_c0 + red_c0
    fit_c1 = q_c1 - patch_s.shape[1] + 1 + red_c0

    anch_r0, anch_r1 = q_r0, q_r1 - size + 1
    anch_c0, anch_c1 = q_c0, q_c1 - size + 1

    r_lo, r_hi = max(fit_r0, anch_r0), min(fit_r1, anch_r1)
    c_lo, c_hi = max(fit_c0, anch_c0), min(fit_c1, anch_c1)
    if r_lo <= r_hi and c_lo <= c_hi:
        return random.randint(r_lo, r_hi), random.randint(c_lo, c_hi)
    return random.randint(anch_r0, anch_r1), random.randint(anch_c0, anch_c1)


def _stamp(out: np.ndarray, patch_s: np.ndarray, anchor_r: int, anchor_c: int) -> None:
    """Stamp non-bg pixels from a scaled patch onto the output grid, aligned by red anchor."""
    rr_red, cc_red = np.where(patch_s == RED)
    place_r0 = anchor_r - int(rr_red.min())
    place_c0 = anchor_c - int(cc_red.min())

    src_rr, src_cc = np.where(patch_s != BG)
    tgt_rr = src_rr + place_r0
    tgt_cc = src_cc + place_c0
    valid = (
        (tgt_rr >= 0)
        & (tgt_rr < GRID_SIZE)
        & (tgt_cc >= 0)
        & (tgt_cc < GRID_SIZE)
        & (tgt_rr != MID)
        & (tgt_cc != MID)
    )
    tgt_rr, tgt_cc, src_rr, src_cc = tgt_rr[valid], tgt_cc[valid], src_rr[valid], src_cc[valid]
    not_red = out[tgt_rr, tgt_cc] != RED
    out[tgt_rr[not_red], tgt_cc[not_red]] = patch_s[src_rr[not_red], src_cc[not_red]]


def _build_output(
    patch: np.ndarray,
    tl_r0: int,
    tl_c0: int,
    target_sizes: dict[tuple[int, int], int],
    anchors: dict[tuple[int, int], tuple[int, int]],
    scaled: dict[tuple[int, int], np.ndarray],
) -> np.ndarray:
    out = np.full((GRID_SIZE, GRID_SIZE), BG, dtype=int)
    out[MID, :] = DIV
    out[:, MID] = DIV
    paste(out, patch, tl_r0, tl_c0)
    for key, size in target_sizes.items():
        if key == (0, 0):
            continue
        ar, ac = anchors[key]
        paste(out, np.full((size, size), RED, dtype=int), ar, ac)
    for key, patch_s in scaled.items():
        _stamp(out, patch_s, *anchors[key])
    return out


def _build_input(
    out: np.ndarray,
    target_sizes: dict[tuple[int, int], int],
    anchors: dict[tuple[int, int], tuple[int, int]],
) -> np.ndarray:
    inp = out.copy()
    for key, size in target_sizes.items():
        if key == (0, 0):
            continue
        q_r0, q_r1, q_c0, q_c1 = QUADS[key]
        inp[q_r0 : q_r1 + 1, q_c0 : q_c1 + 1] = BG
        ar, ac = anchors[key]
        paste(inp, np.full((size, size), RED, dtype=int), ar, ac)
    return inp


def _rotation_diff_stats(rot_out: np.ndarray, ref_out: np.ndarray) -> dict[tuple[int, int], int]:
    stats: dict[tuple[int, int], int] = {}
    for key, (r0, r1, c0, c1) in QUADS.items():
        if key == (0, 0):
            continue
        q_rot = rot_out[r0 : r1 + 1, c0 : c1 + 1]
        q_ref = ref_out[r0 : r1 + 1, c0 : c1 + 1]
        diff = (q_rot != q_ref) & (q_rot != RED) & (q_ref != RED)
        stats[key] = int(diff.sum())
    return stats


def _observable_rotation_variant(stats: dict[tuple[int, int], int]) -> bool:
    changed = [key for key, count in stats.items() if count > 0]
    return bool(changed) and any(key in {(0, 1), (1, 0)} for key in changed)


def _gen_attempt() -> np.ndarray | None:
    """Single generation attempt: build output, derive input, oracle-check."""
    target_sizes = {
        (0, 0): SOURCE_ANCHOR_SIZE,
        (0, 1): random.randint(*TARGET_SIZE_RANGE),
        (1, 0): random.randint(*TARGET_SIZE_RANGE),
        (1, 1): random.randint(*TARGET_SIZE_RANGE),
    }

    needs_block = any(size % SOURCE_ANCHOR_SIZE != 0 for key, size in target_sizes.items() if key != (0, 0))
    source = _source_patch(needs_block)
    if source is None:
        return None
    patch, anchor_r_in_patch, anchor_c_in_patch = source

    scaled_rot = {
        key: _scaled_patch(patch, key[0], key[1], size, use_rotation=True)
        for key, size in target_sizes.items()
        if key != (0, 0)
    }
    scaled_ref = {
        key: _scaled_patch(patch, key[0], key[1], size, use_rotation=False)
        for key, size in target_sizes.items()
        if key != (0, 0)
    }

    anchors: dict[tuple[int, int], tuple[int, int]] = {}
    tl_r0 = random.randint(0, MID - patch.shape[0])
    tl_c0 = random.randint(0, MID - patch.shape[1])
    anchors[(0, 0)] = (tl_r0 + anchor_r_in_patch, tl_c0 + anchor_c_in_patch)
    for key, patch_s in scaled_rot.items():
        anchors[key] = _choose_anchor(key[0], key[1], target_sizes[key], patch_s)

    out_rot = _build_output(patch, tl_r0, tl_c0, target_sizes, anchors, scaled_rot)
    out_ref = _build_output(patch, tl_r0, tl_c0, target_sizes, anchors, scaled_ref)

    if not _observable_rotation_variant(_rotation_diff_stats(out_rot, out_ref)):
        return None

    inp = _build_input(out_rot, target_sizes, anchors)
    return inp if np.array_equal(main(inp), out_rot) else None


def generate_input() -> np.ndarray:
    for _ in range(MAX_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid b10624e5 input")

            ```

            ### 参考代码: D10/0

            文件: `/home/lixinyu/snap/new/ceshi/code/b10624e5/D10/0/code.py`

            ```python
            # Variant of b10624e5
# Dimension: D10 — 锚块颜色的角色 (meta)
# Change: 锚块统一为红色，颜色仅用于标识锚块身份... → 锚块颜色编码变换类型

import random

import numpy as np

from arc_utils import bbox_coords, components_mask, get_bg, paste


# Design analysis for the D10 variant
# - Concrete behavior:
#   The 27x27 grid still has one divider row and one divider column crossing at (13,13).
#   The TL quadrant still contains the full source motif with a red 2x2 source anchor inside it.
#   The three target quadrants still contain only square anchors in the input, but those anchors
#   now use three different colors. Size keeps its old meaning (scaling ratio), while color gets
#   a new meaning:
#     red(2)   -> horizontal mirror
#     green(3) -> vertical mirror
#     teal(8)  -> 90-degree clockwise rotation
#   A concrete trace: in the original task, a TR anchor of size 3 always caused an LR reflection
#   because TR is on the right. In this variant, a TR anchor of size 3 can instead trigger any of
#   the three transforms; if it is teal, the motif rotates 90 degrees and then scales by 3/2.
#   This is the key behavioral difference: quadrant position no longer determines the transform.
# - Complexity calibration:
#   Only three transform colors are used, exactly one per non-TL quadrant in every sample, and
#   their placement is randomly permuted across quadrants. This is enough to visibly contradict
#   the old position-based rule without introducing an unbounded color vocabulary.
# - Hidden assumptions from the old solver that must change:
#   1. `components_mask(g == 2)` assumed every anchor was red. This would now miss green/teal
#      anchors, so anchor search must scan a fixed anchor-color codebook instead.
#   2. `if out[rr_t, cc_t] == 2: continue` only protected red anchors during stamping. In this
#      variant target anchors can be green or teal, so all anchor colors must be protected.
#   3. Quadrant position previously implied the transform. That logic must be replaced by a
#      color->transform lookup, otherwise the solver silently solves the old task instead.
# - Placement legality:
#   The generator places anchors only where the whole transformed+scaled motif fits when possible,
#   falling back to anchor-only placement if needed, matching the original permissive clipping
#   rule. Motif colors exclude the target-anchor colors, so color-coded anchors remain isolated
#   monochrome square components that the solver can recover unambiguously.
# - Visual observability:
#   Every sample uses all three target-anchor colors and randomly permutes them across TR/BL/BR.
#   This prevents a human from explaining the outputs with the old "right means LR, bottom means
#   UD" rule. The source motif is filtered to be asymmetric under LR, UD, 180, and rot90, and the
#   generator rejects samples whose realized target patches collapse back to the old behavior.
# - Visual cleanliness:
#   The grid still contains only one motif component per quadrant. Target quadrants remain sparse
#   in the input, and the output only overlays one transformed motif per anchor, preserving the
#   original task's tidy four-panel appearance.
# - Color-rule inferability:
#   The mapping uses only three recurring anchor colors, and those colors never appear as ordinary
#   motif paint in non-anchor roles. This keeps the "color encodes transform" signal explicit.


BG = 4
DIV = 1
SOURCE_ANCHOR = 2
GRID_SIZE = 27
MID = 13
QUADS = {
    (0, 0): (0, 12, 0, 12),
    (0, 1): (0, 12, 14, 26),
    (1, 0): (14, 26, 0, 12),
    (1, 1): (14, 26, 14, 26),
}

TRANSFORM_BY_COLOR = {
    2: "flip_lr",
    3: "flip_ud",
    8: "rot90",
}
ANCHOR_COLORS = tuple(sorted(TRANSFORM_BY_COLOR))
TARGET_KEYS = ((0, 1), (1, 0), (1, 1))
ORIGINAL_BY_QUADRANT = {
    (0, 1): "flip_lr",
    (1, 0): "flip_ud",
    (1, 1): "rot180",
}

SOURCE_ANCHOR_SIZE = 2
BLOCK_DIMS = [(2, 3), (3, 2), (3, 3)]
FILL_RATIO_MIN = 0.5
FILL_RATIO_MAX = 0.8
MOTIF_COLORS_MIN = 3
MOTIF_COLORS_MAX = 5
MOTIF_EXTRA_COLORS = [0, 5, 6, 7, 9]
TARGET_SIZE_RANGE = (1, 4)
MAX_RETRIES = 400


def _find_dividers(g: np.ndarray, bg: int) -> tuple[int, int]:
    """Return the unique full-row/full-col divider intersection."""
    h, w = g.shape
    full_rows = [(r, int(g[r, 0])) for r in range(h) if np.all(g[r, :] == g[r, 0]) and int(g[r, 0]) != bg]
    full_cols = [(c, int(g[0, c])) for c in range(w) if np.all(g[:, c] == g[0, c]) and int(g[0, c]) != bg]
    matches = []
    for r, vr in full_rows:
        for c, vc in full_cols:
            if vr == vc:
                matches.append((int(r), int(c)))
    assert len(matches) == 1, "grid must have exactly one matching full-row/full-col divider"
    return matches[0]


def _resize_nn(img: np.ndarray, new_h: int, new_w: int) -> np.ndarray:
    src_h, src_w = img.shape
    if new_h <= 0 or new_w <= 0:
        return img.copy()
    rr = np.clip(np.floor(np.arange(new_h) * src_h / new_h).astype(int), 0, src_h - 1)
    cc = np.clip(np.floor(np.arange(new_w) * src_w / new_w).astype(int), 0, src_w - 1)
    return img[rr[:, None], cc[None, :]]


def _apply_transform(patch: np.ndarray, op: str) -> np.ndarray:
    if op == "flip_lr":
        return np.fliplr(patch)
    if op == "flip_ud":
        return np.flipud(patch)
    if op == "rot180":
        return np.rot90(patch, 2)
    if op == "rot90":
        return np.rot90(patch, -1)
    raise ValueError(f"unknown transform {op}")


def _anchor_signature(patch: np.ndarray) -> tuple[tuple[int, ...], ...]:
    view = patch.copy()
    view[view == SOURCE_ANCHOR] = BG
    return tuple(tuple(int(x) for x in row) for row in view.tolist())


def _square_component(g: np.ndarray, pts: np.ndarray, color: int) -> tuple[int, int, int] | None:
    r0, c0, r1, c1 = bbox_coords(pts)
    side_r = r1 - r0 + 1
    side_c = c1 - c0 + 1
    if side_r != side_c:
        return None
    if not np.all(g[r0 : r1 + 1, c0 : c1 + 1] == color):
        return None
    return int(r0), int(c0), int(side_r)


def main(grid: np.ndarray) -> np.ndarray:
    """
    Copy the TL motif into the other quadrants, with scale still read from anchor size and
    the geometric transform now read from anchor color.

    Input structure:
    - A single non-background full row and full column split the 27x27 board into four 13x13 quadrants.
    - The TL quadrant contains one connected colored motif with a red 2x2 source anchor embedded in it.
    - Each non-TL quadrant contains exactly one square anchor block; its side length gives the scale,
      and its color is one of the transform-code colors.

    Rule:
    - Extract the TL motif component containing the red source anchor.
    - For each other quadrant, look up the transform from the anchor color:
      red(2)=horizontal mirror, green(3)=vertical mirror, teal(8)=rotate 90 degrees clockwise.
    - Apply that transform to the source motif, scale it by target_anchor_size / source_anchor_size,
      align the transformed red region onto the target anchor, and stamp non-background pixels while
      leaving divider cells and anchor cells unchanged.

    Key insight: The anchor's size and color now split the old anchor job: size says how much to
    scale the copied motif, while color says which transform that quadrant should receive.
    """
    g = np.asarray(grid, dtype=int)
    h, w = g.shape
    out = g.copy()

    bg = get_bg(g)
    mid_r, mid_c = _find_dividers(g, bg)

    anchors: dict[tuple[int, int], tuple[int, int, int, int]] = {}
    for color in ANCHOR_COLORS:
        for pts in components_mask(g == color, connectivity=4):
            square = _square_component(g, pts, color)
            if square is None:
                continue
            r0, c0, size = square
            rr = r0 + size // 2
            cc = c0 + size // 2
            qb = 0 if rr < mid_r else 1
            qr = 0 if cc < mid_c else 1
            key = (qb, qr)
            assert key not in anchors, "each quadrant must contain exactly one anchor block"
            anchors[key] = (r0, c0, size, color)

    assert set(anchors) == {(0, 0), (0, 1), (1, 0), (1, 1)}, "must find one anchor in each quadrant"
    sr0, sc0, sL, scol = anchors[(0, 0)]
    assert scol == SOURCE_ANCHOR, "top-left source anchor must stay red"
    assert sL > 0, "top-left anchor must have positive size"

    tl = g[0:mid_r, 0:mid_c]
    patch_bb = None
    for pts in components_mask(tl != bg, connectivity=4):
        if any(tl[r, c] == SOURCE_ANCHOR for r, c in pts):
            r0, c0, r1, c1 = bbox_coords(pts)
            patch_bb = (int(r0), int(c0), int(r1), int(c1))
            break
    assert patch_bb is not None, "top-left quadrant must contain a motif component with the red source anchor"

    pr0, pc0, pr1, pc1 = patch_bb
    patch = tl[pr0 : pr1 + 1, pc0 : pc1 + 1].copy()

    for key, (tr0, tc0, tL, color) in anchors.items():
        if key == (0, 0):
            continue
        patch_t = _apply_transform(patch, TRANSFORM_BY_COLOR[color])
        ratio = float(tL) / float(sL)
        new_h = max(1, int(round(patch_t.shape[0] * ratio)))
        new_w = max(1, int(round(patch_t.shape[1] * ratio)))
        patch_s = _resize_nn(patch_t, new_h, new_w)
        roundtrip = _resize_nn(patch_s, patch_t.shape[0], patch_t.shape[1])
        assert np.array_equal(roundtrip, patch_t), "scaling must preserve all motif information"

        rr_red, cc_red = np.where(patch_s == SOURCE_ANCHOR)
        assert rr_red.size > 0, "transformed source patch must still contain the red source anchor"
        ar0, ac0 = int(rr_red.min()), int(cc_red.min())
        place_r0 = tr0 - ar0
        place_c0 = tc0 - ac0

        rr_p, cc_p = np.where(patch_s != bg)
        for rr0, cc0 in zip(rr_p.tolist(), cc_p.tolist(), strict=False):
            rr_t = place_r0 + rr0
            cc_t = place_c0 + cc0
            if not (0 <= rr_t < h and 0 <= cc_t < w):
                continue
            if rr_t == mid_r or cc_t == mid_c:
                continue
            if int(out[rr_t, cc_t]) in ANCHOR_COLORS:
                continue
            out[rr_t, cc_t] = int(patch_s[rr0, cc0])

    return out


def _grow_4conn(h: int, w: int, seeds: set[tuple[int, int]], n_fill: int) -> set[tuple[int, int]]:
    filled = set(seeds)
    frontier = set()
    for r, c in seeds:
        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
            nr, nc = r + dr, c + dc
            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in filled:
                frontier.add((nr, nc))
    while len(filled) < n_fill and frontier:
        cell = random.choice(list(frontier))
        frontier.discard(cell)
        filled.add(cell)
        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
            nr, nc = cell[0] + dr, cell[1] + dc
            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in filled:
                frontier.add((nr, nc))
    return filled


def _assign_colors(filled: set[tuple[int, int]], anchor_cell: tuple[int, int], h: int, w: int) -> np.ndarray | None:
    rows = {r for r, _ in filled}
    cols = {c for _, c in filled}
    if rows != set(range(h)) or cols != set(range(w)):
        return None
    non_anchor = [p for p in filled if p != anchor_cell]
    if len(non_anchor) < MOTIF_COLORS_MIN - 1:
        return None
    max_colors = min(MOTIF_COLORS_MAX, len(non_anchor) + 1)
    if max_colors < MOTIF_COLORS_MIN:
        return None
    n_colors = random.randint(MOTIF_COLORS_MIN, max_colors)
    extras = MOTIF_EXTRA_COLORS[:]
    random.shuffle(extras)
    palette = extras[: n_colors - 1]

    logical = np.full((h, w), BG, dtype=int)
    logical[anchor_cell] = SOURCE_ANCHOR
    random.shuffle(non_anchor)
    for i, (r, c) in enumerate(non_anchor):
        logical[r, c] = palette[i] if i < len(palette) else random.choice(palette)
    return logical


def _build_source_patch() -> tuple[np.ndarray, int, int] | None:
    logical_h, logical_w = random.choice(BLOCK_DIMS)
    n_cells = logical_h * logical_w
    min_fill = max(4, int(np.ceil(FILL_RATIO_MIN * n_cells)))
    max_fill = max(min_fill, int(np.floor(FILL_RATIO_MAX * n_cells)))
    anchor_cell = (random.randrange(logical_h), random.randrange(logical_w))
    filled = _grow_4conn(logical_h, logical_w, {anchor_cell}, random.randint(min_fill, max_fill))
    logical = _assign_colors(filled, anchor_cell, logical_h, logical_w)
    if logical is None:
        return None

    patch = np.repeat(np.repeat(logical, SOURCE_ANCHOR_SIZE, axis=0), SOURCE_ANCHOR_SIZE, axis=1)

    signatures = {
        op: _anchor_signature(_apply_transform(patch, op))
        for op in ("flip_lr", "flip_ud", "rot180", "rot90")
    }
    if len(set(signatures.values())) != len(signatures):
        return None

    anchor_r = anchor_cell[0] * SOURCE_ANCHOR_SIZE
    anchor_c = anchor_cell[1] * SOURCE_ANCHOR_SIZE
    return patch, anchor_r, anchor_c


def _scaled_patch(patch: np.ndarray, color: int, target_size: int) -> np.ndarray:
    op = TRANSFORM_BY_COLOR[color]
    p = _apply_transform(patch, op)
    ratio = target_size / SOURCE_ANCHOR_SIZE
    h = max(1, int(round(p.shape[0] * ratio)))
    w = max(1, int(round(p.shape[1] * ratio)))
    return _resize_nn(p, h, w)


def _choose_anchor(qb: int, qr: int, size: int, patch_s: np.ndarray) -> tuple[int, int]:
    q_r0, q_r1, q_c0, q_c1 = QUADS[(qb, qr)]
    rr, cc = np.where(patch_s == SOURCE_ANCHOR)
    red_r0, red_c0 = int(rr.min()), int(cc.min())

    fit_r0 = q_r0 + red_r0
    fit_r1 = q_r1 - patch_s.shape[0] + 1 + red_r0
    fit_c0 = q_c0 + red_c0
    fit_c1 = q_c1 - patch_s.shape[1] + 1 + red_c0

    anch_r0, anch_r1 = q_r0, q_r1 - size + 1
    anch_c0, anch_c1 = q_c0, q_c1 - size + 1

    r_lo, r_hi = max(fit_r0, anch_r0), min(fit_r1, anch_r1)
    c_lo, c_hi = max(fit_c0, anch_c0), min(fit_c1, anch_c1)
    if r_lo <= r_hi and c_lo <= c_hi:
        return random.randint(r_lo, r_hi), random.randint(c_lo, c_hi)
    return random.randint(anch_r0, anch_r1), random.randint(anch_c0, anch_c1)


def _stamp(out: np.ndarray, patch_s: np.ndarray, anchor_r: int, anchor_c: int) -> None:
    rr_red, cc_red = np.where(patch_s == SOURCE_ANCHOR)
    place_r0 = anchor_r - int(rr_red.min())
    place_c0 = anchor_c - int(cc_red.min())

    src_rr, src_cc = np.where(patch_s != BG)
    tgt_rr = src_rr + place_r0
    tgt_cc = src_cc + place_c0
    valid = (
        (tgt_rr >= 0)
        & (tgt_rr < GRID_SIZE)
        & (tgt_cc >= 0)
        & (tgt_cc < GRID_SIZE)
        & (tgt_rr != MID)
        & (tgt_cc != MID)
    )
    tgt_rr = tgt_rr[valid]
    tgt_cc = tgt_cc[valid]
    src_rr = src_rr[valid]
    src_cc = src_cc[valid]
    keep = ~np.isin(out[tgt_rr, tgt_cc], np.array(ANCHOR_COLORS))
    out[tgt_rr[keep], tgt_cc[keep]] = patch_s[src_rr[keep], src_cc[keep]]


def _target_sizes() -> dict[tuple[int, int], int]:
    while True:
        sizes = {(0, 0): SOURCE_ANCHOR_SIZE}
        for key in TARGET_KEYS:
            sizes[key] = random.randint(*TARGET_SIZE_RANGE)
        non_tl = [sizes[key] for key in TARGET_KEYS]
        if sum(size >= 2 for size in non_tl) >= 2 and any(size != SOURCE_ANCHOR_SIZE for size in non_tl):
            return sizes


def _variant_visible(patch: np.ndarray, target_specs: dict[tuple[int, int], tuple[int, int]]) -> bool:
    realized = {}
    for key, (size, color) in target_specs.items():
        realized[key] = _anchor_signature(_scaled_patch(patch, color, size))
    if len(set(realized.values())) != 3:
        return False

    differs_from_original = False
    for key, (size, color) in target_specs.items():
        new_sig = realized[key]
        old_patch = _apply_transform(patch, ORIGINAL_BY_QUADRANT[key])
        ratio = size / SOURCE_ANCHOR_SIZE
        old_scaled = _resize_nn(old_patch, max(1, int(round(old_patch.shape[0] * ratio))), max(1, int(round(old_patch.shape[1] * ratio))))
        old_sig = _anchor_signature(old_scaled)
        if new_sig != old_sig:
            differs_from_original = True
    return differs_from_original


def _gen_attempt() -> np.ndarray | None:
    source = _build_source_patch()
    if source is None:
        return None
    patch, anchor_r_in_patch, anchor_c_in_patch = source

    target_sizes = _target_sizes()
    target_colors = random.sample(list(ANCHOR_COLORS), k=3)
    target_specs = {
        key: (target_sizes[key], color)
        for key, color in zip(TARGET_KEYS, target_colors, strict=False)
    }

    rot90_key = next(key for key, (_size, color) in target_specs.items() if TRANSFORM_BY_COLOR[color] == "rot90")
    if target_specs[rot90_key][0] < 2:
        return None
    if not _variant_visible(patch, target_specs):
        return None

    scaled = {
        key: _scaled_patch(patch, color, size)
        for key, (size, color) in target_specs.items()
    }

    anchors: dict[tuple[int, int], tuple[int, int]] = {}
    tl_r0 = random.randint(0, MID - patch.shape[0])
    tl_c0 = random.randint(0, MID - patch.shape[1])
    anchors[(0, 0)] = (tl_r0 + anchor_r_in_patch, tl_c0 + anchor_c_in_patch)
    for key, patch_s in scaled.items():
        size, _color = target_specs[key]
        anchors[key] = _choose_anchor(key[0], key[1], size, patch_s)

    out = np.full((GRID_SIZE, GRID_SIZE), BG, dtype=int)
    out[MID, :] = DIV
    out[:, MID] = DIV
    paste(out, patch, tl_r0, tl_c0)
    for key, (size, color) in target_specs.items():
        ar, ac = anchors[key]
        paste(out, np.full((size, size), color, dtype=int), ar, ac)
    for key, patch_s in scaled.items():
        _stamp(out, patch_s, *anchors[key])

    inp = out.copy()
    for key, (size, color) in target_specs.items():
        q_r0, q_r1, q_c0, q_c1 = QUADS[key]
        inp[q_r0 : q_r1 + 1, q_c0 : q_c1 + 1] = BG
        ar, ac = anchors[key]
        paste(inp, np.full((size, size), color, dtype=int), ar, ac)

    return inp if np.array_equal(main(inp), out) else None


def generate_input() -> np.ndarray:
    for _ in range(MAX_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid D10 b10624e5 input")

