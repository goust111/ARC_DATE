+def _legacy_scaled_patch(patch: np.ndarray, key: tuple[int, int], target_size: int) -> np.ndarray:
+    p = _reflect_by_quadrant(patch, key[0], key[1])
+    ratio = target_size / SOURCE_ANCHOR_SIZE
+    h = max(1, int(round(p.shape[0] * ratio)))
