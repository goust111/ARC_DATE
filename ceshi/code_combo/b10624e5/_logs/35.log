+    if expected.shape != (13, 13):
+        return None
+    if not np.any((expected != BG) & (expected != RED)):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid b10624e5 combo input")

