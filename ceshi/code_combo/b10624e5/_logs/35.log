+        expected = main(inp)
+    except AssertionError:
+        return None
+    if expected.shape != (13, 13):
+        return None
+    if not np.any((expected != BG) & (expected != RED)):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
