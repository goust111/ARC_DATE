+        anchors[key] = rc
+
+    inp = np.full((GRID_SIZE, GRID_SIZE), BG, dtype=int)
+    inp[MID, :] = DIV
+    inp[:, MID] = DIV
+    for r, c in ctrl_pts:
+        inp[r, c] = CTRL
+
+    paste(inp, patch, src_patch_r0, src_patch_c0)
