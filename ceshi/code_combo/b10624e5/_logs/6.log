+    rotated = _rotate_cw(patch, turns)
+    ratio = target_size / SOURCE_ANCHOR_SIZE
+    h = max(1, int(round(rotated.shape[0] * ratio)))
+    w = max(1, int(round(rotated.shape[1] * ratio)))
+    return _resize_nn(rotated, h, w)
