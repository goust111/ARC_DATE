+
+def _is_asymmetric(patch: np.ndarray) -> bool:
+    """Reject motifs that collapse under flips or quarter-turn rotations."""
+    transforms = [
+        np.fliplr(patch),
+        np.flipud(patch),
+        _rotate_cw(patch, 1),
+        _rotate_cw(patch, 2),
+        _rotate_cw(patch, 3),
+    ]
+    for other in transforms:
+        if other.shape == patch.shape and np.array_equal(other, patch):
+            return False
+    return True
