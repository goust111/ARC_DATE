+    for side in MARKER_SIDES:
+        ok = True
+        for mr, mc in _marker_rel_cells(red_r0, red_c0, size, side, length):
+            if 0 <= mr < patch_s.shape[0] and 0 <= mc < patch_s.shape[1] and patch_s[mr, mc] != BG:
