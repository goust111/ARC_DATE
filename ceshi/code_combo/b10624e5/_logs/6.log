+def _valid_marker_sides(patch_s: np.ndarray, size: int, length: int) -> list[str]:
+    """Marker sides that keep the symbol disjoint from the stamped motif."""
+    rr, cc = np.where(patch_s == RED)
+    red_r0, red_c0 = int(rr.min()), int(cc.min())
