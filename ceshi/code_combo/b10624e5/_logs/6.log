+        return None
+    if not _observable_combo(combo_out, _solve_fixed_rotation(inp), _solve_reflection(inp)):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
