+    if qr:
+        p = np.fliplr(p)
+    if qb:
+        p = np.flipud(p)
+    sh, sw = source_shape
+    th, tw = target_shape
+    out_h = max(1, int(round(p.shape[0] * th / sh)))
+    out_w = max(1, int(round(p.shape[1] * tw / sw)))
+    return _resize_nn(p, out_h, out_w)
+
