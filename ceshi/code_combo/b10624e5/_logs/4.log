+
+def _scaled_patch(
+    patch: np.ndarray,
+    qb: int,
+    qr: int,
+    source_shape: tuple[int, int],
+    target_shape: tuple[int, int],
+) -> np.ndarray:
+    """Reflect and anisotropically scale the source patch for one quadrant."""
