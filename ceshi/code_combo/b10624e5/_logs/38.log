+def _quadrant_array(g: np.ndarray, key: tuple[int, int], mid_r: int, mid_c: int) -> np.ndarray:
+    qb, qr = key
+    r0 = 0 if qb == 0 else mid_r + 1
+    r1 = mid_r if qb == 0 else g.shape[0]
+    c0 = 0 if qr == 0 else mid_c + 1
+    c1 = mid_c if qr == 0 else g.shape[1]
