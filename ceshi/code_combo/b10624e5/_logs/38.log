+def _stamp_non_red(out: np.ndarray, patch: np.ndarray, top: int, left: int, mid_r: int, mid_c: int) -> None:
+    h, w = out.shape
+    rr, cc = np.where((patch != BG) & (patch != RED))
+    for pr, pc in zip(rr.tolist(), cc.tolist(), strict=False):
+        tr = int(top) + pr
+        tc = int(left) + pc
