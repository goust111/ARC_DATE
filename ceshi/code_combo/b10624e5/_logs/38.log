+            return None
+        top, left = _choose_anchor_top_left(key[0], key[1], patch_t, source_count, count)
+        q_r0, q_r1, q_c0, q_c1 = QUADS[key]
+        if top + count - 1 > q_r1 or left + count - 1 > q_c1:
+            return None
+        target_anchor_tops[key] = (top, left)
