+
+
+def _output_from_layout(
+    patch: np.ndarray,
+    source_count: int,
+    tl_patch_r0: int,
+    tl_patch_c0: int,
+    target_counts: dict[tuple[int, int], int],
+    target_anchor_tops: dict[tuple[int, int], tuple[int, int]],
