+BG = 4
+DIV = 1
+RED = 2
+GRID_SIZE = 27
+MID = 13
+QUADS = {
+    (0, 0): (0, 12, 0, 12),
+    (0, 1): (0, 12, 14, 26),
+    (1, 0): (14, 26, 0, 12),
+    (1, 1): (14, 26, 14, 26),
+}
+
+COUNT_CHOICES = (2, 3, 4)
+LOGICAL_DIMS = ((2, 2), (2, 3), (3, 2), (3, 3))
