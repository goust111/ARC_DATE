+    tl_patch_r0 = random.randint(0, MID - patch.shape[0])
+    tl_patch_c0 = random.randint(0, MID - patch.shape[1])
+
+    target_anchor_tops: dict[tuple[int, int], tuple[int, int]] = {}
+    for key, count in target_counts.items():
