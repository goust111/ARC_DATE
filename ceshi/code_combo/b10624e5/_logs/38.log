+def _find_dividers(g: np.ndarray, bg: int) -> tuple[int, int]:
+    """Return the unique full-row/full-col divider pair."""
+    h, w = g.shape
+    full_rows = [(r, int(g[r, 0])) for r in range(h) if np.all(g[r, :] == g[r, 0]) and int(g[r, 0]) != bg]
