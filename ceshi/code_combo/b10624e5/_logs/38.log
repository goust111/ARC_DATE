+    inp = np.full((GRID_SIZE, GRID_SIZE), BG, dtype=int)
+    inp[MID, :] = DIV
+    inp[:, MID] = DIV
+    paste(inp, patch, tl_patch_r0, tl_patch_c0)
+    for key, count in target_counts.items():
+        if key == (0, 0):
+            continue
+        top, left = target_anchor_tops[key]
+        _paint_anchor_group(inp, top, left, count)
