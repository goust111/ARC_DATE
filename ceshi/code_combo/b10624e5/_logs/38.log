+        place_c0 = left - (src_anchor_c0 // source_count) * count
+        _stamp_non_red(out, patch_s, place_r0, place_c0, MID, MID)
+    return out
+
+
+def _gen_attempt() -> np.ndarray | None:
+    source_count = random.choice((2, 3))
+    made = _make_source_patch(source_count)
+    if made is None:
+        return None
