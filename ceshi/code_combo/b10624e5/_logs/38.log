+    out = _output_from_layout(
+        patch=patch,
+        source_count=source_count,
+        tl_patch_r0=tl_patch_r0,
+        tl_patch_c0=tl_patch_c0,
+        target_counts=target_counts,
+        target_anchor_tops=target_anchor_tops,
+    )
