+
+def _stamp(
+    out: np.ndarray,
+    patch_s: np.ndarray,
+    anchor_r: int,
+    anchor_c: int,
+    mid_r: int,
+    mid_c: int,
+    bg: int,
+) -> None:
+    rr_red, cc_red = np.where(patch_s == RED)
+    assert rr_red.size > 0, "scaled patch must contain red anchor pixels"
+    place_r0 = anchor_r - int(rr_red.min())
+    place_c0 = anchor_c - int(cc_red.min())
