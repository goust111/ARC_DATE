   170	    key: tuple[int, int],
   171	) -> np.ndarray:
   172	    q_r0, q_r1, q_c0, q_c1 = _quad_bounds(g.shape, mid_r, mid_c, key)
   173	    quad = g[q_r0 : q_r1 + 1, q_c0 : q_c1 + 1]
   174	    comps = components_mask(quad != bg, connectivity=4)
   175	    matches = [pts for pts in comps if any(quad[r, c] == RED for r, c in pts)]
   176	    assert len(matches) == 1, "each quadrant must contain exactly one non-bg component with red"
   177	    r0, c0, r1, c1 = bbox_coords(matches[0])
   178	    return quad[r0 : r1 + 1, c0 : c1 + 1].copy()
   179	
   180	
   181	def _logical_from_patch(patch: np.ndarray, block: int) -> np.ndarray:
   182	    h, w = patch.shape
   183	    assert h % block == 0 and w % block == 0, "patch dimensions must be multiples of anchor size"
   184	    logical_h = h // block
   185	    logical_w = w // block
   186	    view = patch.reshape(logical_h, block, logical_w, block)
   187	    logical = view[:, 0, :, 0].copy()
   188	    assert np.all(view == logical[:, None, :, None]), "each logical cell must be a uniform block"
   189	    return logical
   190	
   191	
   192	def _merge_sources(shape_logical: np.ndarray, color_logical: np.ndarray, bg: int) -> np.ndarray:
   193	    assert shape_logical.shape == color_logical.shape, "paired sources must share one logical bbox"
   194	    assert _red_signature(shape_logical) == _red_signature(color_logical), "paired source anchors must align"
   195	    merged = color_logical.copy()
   196	    merged[shape_logical == bg] = bg
   197	    return merged
   198	
   199	
   200	def _stamp(
   201	    out: np.ndarray,
   202	    patch_s: np.ndarray,
   203	    anchor_r: int,
   204	    anchor_c: int,
   205	    mid_r: int,
   206	    mid_c: int,
   207	    bg: int,
   208	) -> None:
   209	    rr_red, cc_red = np.where(patch_s == RED)
   210	    assert rr_red.size > 0, "scaled patch must contain red anchor pixels"
   211	    place_r0 = anchor_r - int(rr_red.min())
   212	    place_c0 = anchor_c - int(cc_red.min())
   213	
   214	    rr_p, cc_p = np.where(patch_s != bg)
   215	    for rr0, cc0 in zip(rr_p.tolist(), cc_p.tolist(), strict=False):
   216	        rr_t = place_r0 + rr0
   217	        cc_t = place_c0 + cc0
   218	        if not (0 <= rr_t < out.shape[0] and 0 <= cc_t < out.shape[1]):
   219	            continue
   220	        if rr_t == mid_r or cc_t == mid_c:
   221	            continue
   222	        if out[rr_t, cc_t] == RED:
   223	            continue
   224	        out[rr_t, cc_t] = int(patch_s[rr0, cc0])
   225	
   226	
   227	def _anchors_by_quadrant(g: np.ndarray, mid_r: int, mid_c: int) -> dict[tuple[int, int], tuple[int, int, int]]:
   228	    red = components_mask(g == RED, connectivity=4)
   229	    assert red, "grid must contain red anchor blocks"
   230	
   231	    anchors: dict[tuple[int, int], tuple[int, int, int]] = {}
   232	    for pts in red:
   233	        r0, c0, r1, c1 = bbox_coords(pts)
   234	        rr = (r0 + r1) // 2
   235	        cc = (c0 + c1) // 2
   236	        qb = 0 if rr < mid_r else 1
   237	        qr = 0 if cc < mid_c else 1
   238	        size_h = r1 - r0 + 1
   239	        size_w = c1 - c0 + 1
   240	        assert size_h == size_w, "anchors must be square"
   241	        key = (qb, qr)
   242	        assert key not in anchors, "each quadrant must contain exactly one red anchor block"
   243	        anchors[key] = (int(r0), int(c0), int(size_h))
   244	
   245	    assert len(anchors) == 4, "all four quadrants must contain anchors"
   246	    return anchors
   247	
   248	
   249	def main(grid: np.ndarray) -> np.ndarray:
   250	    """
   251	    Fuse diagonal shape/color sources after anchor-size normalization, then add the merged lobe back to both members.
   252	
   253	    Input structure:
   254	    - A single non-background full row and full column split the 27x27 grid into four quadrants.
   255	    - Every quadrant contains one red square anchor block and one local anchor-containing source component.
   256	    - The two top quadrants are shape sources: their local components use one dummy support color plus red.
   257	    - The two bottom quadrants are color sources: their local components use several final colors plus red.
   258	    - Diagonal quadrants form the two fusion pairs: TL with BR, and TR with BL.
   259	
   260	    Rule:
   261	    - Extract the anchor-containing component from each quadrant and use that quadrant's anchor size as the block size
   262	      that converts the pixel patch back into a logical cell grid.
   263	    - For each diagonal pair, take the top patch as a shape mask and the bottom patch as a color template. Keep the
   264	      bottom colors only where the top mask is non-background, producing one merged logical motif for that pair.
   265	    - For each member of the pair, upscale the merged logical motif to that member's anchor size, reflect it across
   266	      both axes, align its red block to the destination anchor, and stamp the non-background pixels.
   267	
   268	    Key insight:
   269	    - No single quadrant is self-sufficient anymore. The solver must identify four local sources, separate shape from
   270	      color by quadrant role, normalize each source by its own anchor size, then combine diagonal partners before the
   271	      final reflected copy step.
   272	    """
   273	    g = np.asarray(grid, dtype=int)
   274	    out = g.copy()
   275	
   276	    bg = get_bg(g)
   277	    mid_r, mid_c = _find_dividers(g, bg)
   278	    anchors = _anchors_by_quadrant(g, mid_r, mid_c)
   279	
   280	    logicals: dict[tuple[int, int], np.ndarray] = {}
   281	    for key, (_, _, size) in anchors.items():
   282	        patch = _extract_patch(g, bg, mid_r, mid_c, key)
   283	        logicals[key] = _logical_from_patch(patch, size)
   284	
   285	    for shape_key in SHAPE_TOP_KEYS:
   286	        color_key = COLOR_KEY_FOR_SHAPE[shape_key]
   287	        merged = _merge_sources(logicals[shape_key], logicals[color_key], bg)
   288	        merged_reflected = _diag_reflect(merged)
   289	        for dst_key in (shape_key, color_key):
   290	            tr0, tc0, tL = anchors[dst_key]
   291	            patch_s = _upscale_logical(merged_reflected, tL)
   292	            _stamp(out, patch_s, tr0, tc0, mid_r, mid_c, bg)
   293	
   294	    return out
   295	
   296	
   297	def _grow_4conn(h: int, w: int, seeds: set[tuple[int, int]], n_fill: int) -> set[tuple[int, int]]:
   298	    filled = set(seeds)
   299	    frontier = set()
   300	    for r, c in seeds:
   301	        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
   302	            nr, nc = r + dr, c + dc
   303	            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in filled:
   304	                frontier.add((nr, nc))
   305	    while len(filled) < n_fill and frontier:
   306	        cell = random.choice(list(frontier))
   307	        filled.add(cell)
   308	        frontier.discard(cell)
   309	        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
   310	            nr, nc = cell[0] + dr, cell[1] + dc
   311	            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in filled:
   312	                frontier.add((nr, nc))
   313	    return filled
   314	
   315	
   316	def _max_anchor_size(lh: int, lw: int) -> int:
   317	    limit_h = 13 // (2 * lh - 1)
   318	    limit_w = 13 // (2 * lw - 1)
   319	    return min(TARGET_SIZE_RANGE[1], limit_h, limit_w)
   320	
   321	
   322	def _build_shape_logical(lh: int, lw: int) -> np.ndarray | None:
   323	    anchor = (lh - 1, lw - 1)
   324	    total = lh * lw
   325	    min_fill = max(3, int(np.ceil(0.55 * total)))
   326	    max_fill = total - 1
   327	    if max_fill < min_fill:
   328	        return None
   329	    for _ in range(200):
   330	        filled = _grow_4conn(lh, lw, {anchor}, random.randint(min_fill, max_fill))
   331	        if len(filled) == total:
   332	            continue
   333	        rows = {r for r, _ in filled}
   334	        cols = {c for _, c in filled}
   335	        if rows != set(range(lh)) or cols != set(range(lw)):
   336	            continue
   337	        logical = np.full((lh, lw), BG, dtype=int)
   338	        for r, c in filled:
   339	            logical[r, c] = SHAPE_COLOR
   340	        logical[anchor] = RED

diff --git a/ceshi/code_combo/b10624e5/16/code.py b/ceshi/code_combo/b10624e5/16/code.py
