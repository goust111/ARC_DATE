+
+BG = 4
+DIV = 1
+RED = 2
+SHAPE_COLOR = 8
+GRID_SIZE = 27
+MID = 13
+MAX_RETRIES = 500
+TARGET_SIZE_RANGE = (1, 4)
+COLOR_POOL = [0, 3, 5, 6, 7, 9]
+LOGICAL_DIMS = [(2, 2), (2, 3), (3, 2)]
+SHAPE_TOP_KEYS = ((0, 0), (0, 1))
+COLOR_KEY_FOR_SHAPE = {
+    (0, 0): (1, 1),
+    (0, 1): (1, 0),
