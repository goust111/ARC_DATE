+    patch_w = lw * size
+    r_lo = q_r0 + (patch_h - size)
+    r_hi = q_r1 - patch_h + 1
+    c_lo = q_c0 + (patch_w - size)
+    c_hi = q_c1 - patch_w + 1
+    if r_lo > r_hi or c_lo > c_hi:
+        return None
+    return random.randint(r_lo, r_hi), random.randint(c_lo, c_hi)
