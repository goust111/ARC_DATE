+BG = 4
+DIV = 1
+RED = 2
+GRID_SIZE = 27
+DIV_ROW = 13
+DIV_COLS = (8, 17)
+SOURCE_SIZES = (1, 2, 3)
+TARGET_SIZES = (2, 3, 4)
+BLOCK_DIMS = ((2, 2), (3, 2))
+FILL_RATIO_MIN = 0.6
+FILL_RATIO_MAX = 0.9
+MOTIF_COLORS_MIN = 3
+MOTIF_COLORS_MAX = 4
+COLOR_POOL = [0, 3, 5, 6, 7, 8, 9]
+MAX_RETRIES = 500
