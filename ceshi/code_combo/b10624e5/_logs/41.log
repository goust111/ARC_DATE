+    return region[pr0 : pr1 + 1, pc0 : pc1 + 1].copy()
+
+
+def _transform_patch(
+    patch: np.ndarray,
+    src_key: tuple[int, int],
+    dst_key: tuple[int, int],
+    source_size: int,
+    target_size: int,
+) -> np.ndarray:
