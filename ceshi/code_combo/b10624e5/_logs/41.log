+    anchors: dict[tuple[int, int], dict[str, object]] = {}
+    for pts in red:
+        r0, c0, r1, c1 = bbox_coords(pts)
+        size_h = int(r1 - r0 + 1)
+        size_w = int(c1 - c0 + 1)
+        assert size_h == size_w, "anchor blocks must be square"
+        rr = (r0 + r1) // 2
+        cc = (c0 + c1) // 2
+        key = _region_key(rr, cc, div_row, div_cols)
