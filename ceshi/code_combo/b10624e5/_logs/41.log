+def _region_key(rr: int, cc: int, div_row: int, div_cols: tuple[int, int]) -> tuple[int, int]:
+    """Map a point to its (row band, col band) region key."""
+    rb = 0 if rr < div_row else 1
+    if cc < div_cols[0]:
+        cb = 0
+    elif cc < div_cols[1]:
+        cb = 1
+    else:
+        cb = 2
+    return rb, cb
