+        if local_noise > 0:
+            noise_quadrants += 1
+
+    return {
+        "source_signal_pixels": source_signal,
+        "source_off_lattice_noise": source_noise,
+        "target_noise_pixels": target_noise,
+        "noise_quadrants": noise_quadrants,
