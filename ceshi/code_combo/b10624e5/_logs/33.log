+        inp[q_r0 : q_r1 + 1, q_c0 : q_c1 + 1] = BG
+        ar0, ac0, ar1, ac1 = anchors[key]
+        paste(inp, np.full((ar1 - ar0 + 1, ac1 - ac0 + 1), RED, dtype=int), ar0, ac0)
+
+    return inp if np.array_equal(main(inp), out) else None
