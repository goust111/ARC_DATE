+        return random.choice(full_fit)
+    if partial_fit:
+        return random.choice(partial_fit)
+    return None
+
+
+def _stamp_output(out: np.ndarray, patch: np.ndarray, anchor_r: int, anchor_c: int) -> None:
+    """Centered stamping helper used by the generator."""
+    size = int((out[anchor_r : anchor_r + 4, anchor_c : anchor_c + 4] == RED).sum())
+    del size  # placement only needs the explicit bbox below; keep local logic simple
