+
+def _sample_scale_map() -> dict[tuple[int, int], int]:
+    """Pick a visibly varied scale triple from the power-of-two legend vocabulary."""
+    patterns = [
+        [1, 2, 4],
+        [2, 2, 4],
+        [2, 4, 4],
