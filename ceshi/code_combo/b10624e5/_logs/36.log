+    return None
+
+
+def _scaled_patch(patch: np.ndarray, qb: int, qr: int, factor: int) -> np.ndarray:
+    """Reflect by quadrant, then enlarge by a legend-coded power-of-two factor."""
+    p = patch
+    if qr == 1:
+        p = np.fliplr(p)
+    if qb == 1:
+        p = np.flipud(p)
+    return _scale_integer(p, factor)
