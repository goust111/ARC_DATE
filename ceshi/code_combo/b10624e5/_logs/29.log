+
+def _scaled_patch(patch: np.ndarray, qb: int, qr: int, target_scale: int) -> np.ndarray:
+    p = patch
+    if qr == 1:
+        p = np.fliplr(p)
+    if qb == 1:
+        p = np.flipud(p)
