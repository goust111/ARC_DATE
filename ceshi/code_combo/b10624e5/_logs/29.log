+    palette = COLOR_POOL[:]
+    random.shuffle(palette)
+    n_extra_colors = random.randint(2, 3)
+    extra_colors = palette[:n_extra_colors]
+    for idx, (r, c) in enumerate(extra_cells):
+        patch[r, c] = extra_colors[idx % n_extra_colors]
+    return patch
