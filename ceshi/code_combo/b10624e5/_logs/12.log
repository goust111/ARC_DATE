+    src_patch_r0, src_patch_c0 = random.choice(choices)
+    anchors: dict[tuple[int, int], tuple[int, int]] = {
+        src_key: (src_patch_r0 + anchor_r_in_patch, src_patch_c0 + anchor_c_in_patch)
+    }
