+        paste(inp, np.full((ANCHOR_SIZE, ANCHOR_SIZE), RED, dtype=int), ar, ac)
+
+    try:
+        return inp if np.array_equal(main(inp), out) else None
+    except AssertionError:
+        return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
