+def _gen_attempt() -> np.ndarray | None:
+    sizes = {key: random.randint(*SIZE_RANGE) for key in QUADS}
+    if sizes[(0, 0)] == sizes[(1, 1)] and sizes[(0, 1)] == sizes[(1, 0)]:
