+    except Exception:
+        return None
+
+    # Additional non-degeneracy: all four quadrants should visibly change after swapping.
+    for key in QUADS:
+        q_r0, q_r1, q_c0, q_c1 = QUADS[key]
+        before = grid[q_r0 : q_r1 + 1, q_c0 : q_c1 + 1]
