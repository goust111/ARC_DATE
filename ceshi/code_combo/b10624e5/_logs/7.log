+def _extract_quadrant_patch(
+    g: np.ndarray,
+    bg: int,
+    h: int,
+    w: int,
+    mid_r: int,
+    mid_c: int,
+    key: tuple[int, int],
+) -> tuple[np.ndarray, tuple[int, int, int, int]]:
+    q_r0, q_r1, q_c0, q_c1 = _quadrant_bounds(h, w, mid_r, mid_c, key)
+    quad = g[q_r0 : q_r1 + 1, q_c0 : q_c1 + 1]
+    comps = components_mask(quad != bg, connectivity=4)
