+    patches: dict[tuple[int, int], np.ndarray] = {}
+    patch_boxes: dict[tuple[int, int], tuple[int, int, int, int]] = {}
+    for key in anchors:
+        patch, bb = _extract_quadrant_patch(g, bg, h, w, mid_r, mid_c, key)
+        patches[key] = patch
+        patch_boxes[key] = bb
