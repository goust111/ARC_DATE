+    for key in QUADS:
+        anchor = _choose_anchor_with_fit(key, sizes[key], [patches[key], incoming[key]])
+        if anchor is None:
+            return None
+        anchors[key] = anchor
+
+    grid = np.full((GRID_SIZE, GRID_SIZE), BG, dtype=int)
+    grid[MID, :] = DIV
+    grid[:, MID] = DIV
