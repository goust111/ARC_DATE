+def _quadrant_bounds(h: int, w: int, mid_r: int, mid_c: int, key: tuple[int, int]) -> tuple[int, int, int, int]:
+    qb, qr = key
+    r0, r1 = (0, mid_r - 1) if qb == 0 else (mid_r + 1, h - 1)
+    c0, c1 = (0, mid_c - 1) if qr == 0 else (mid_c + 1, w - 1)
+    return r0, r1, c0, c1
