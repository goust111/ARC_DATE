+    scaled = _resize_nn(flipped, new_h, new_w)
+    roundtrip = _resize_nn(scaled, flipped.shape[0], flipped.shape[1])
+    assert np.array_equal(roundtrip, flipped), "motif must be exactly rescalable between anchor sizes"
+    return scaled
