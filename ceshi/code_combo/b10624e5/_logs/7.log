+
+def _make_logical_motif() -> np.ndarray | None:
+    h, w = random.choice(LOGICAL_DIMS)
+    n_cells = h * w
+    min_fill = max(3, int(np.ceil(FILL_RATIO_MIN * n_cells)))
+    max_fill = max(min_fill, int(np.floor(FILL_RATIO_MAX * n_cells)))
