+        fit_r0 = q_r0 + red_r0
+        fit_r1 = q_r1 - patch.shape[0] + 1 + red_r0
+        fit_c0 = q_c0 + red_c0
+        fit_c1 = q_c1 - patch.shape[1] + 1 + red_c0
+        r_lo = max(r_lo, fit_r0)
+        r_hi = min(r_hi, fit_r1)
+        c_lo = max(c_lo, fit_c0)
+        c_hi = min(c_hi, fit_c1)
