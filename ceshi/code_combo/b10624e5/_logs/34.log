   232	        cell = random.choice(list(frontier))
   233	        filled.add(cell)
   234	        frontier.discard(cell)
   235	        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
   236	            nr, nc = cell[0] + dr, cell[1] + dc
   237	            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in filled:
