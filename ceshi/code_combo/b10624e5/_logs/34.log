+
+    if not np.array_equal(main(inp), out):
+        return None
+    return inp, out
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_RETRIES):
+        sample = _gen_attempt()
+        if sample is not None:
+            inp, _out = sample
+            return inp
