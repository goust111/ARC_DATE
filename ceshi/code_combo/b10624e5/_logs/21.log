    86	def _find_dividers(g: np.ndarray, bg: int) -> tuple[int, int]:
    87	    """
    88	    Return the unique full-row/full-col quadrant divider: (mid_row, mid_col).
    89	    """
    90	    h, w = g.shape
    91	    full_rows = [(r, int(g[r, 0])) for r in range(h) if np.all(g[r, :] == g[r, 0]) and int(g[r, 0]) != bg]
    92	    full_cols = [(c, int(g[0, c])) for c in range(w) if np.all(g[:, c] == g[0, c]) and int(g[0, c]) != bg]
    93	    matches = []
    94	    for r, vr in full_rows:
    95	        for c, vc in full_cols:
    96	            if vr == vc:
    97	                matches.append((int(r), int(c)))
    98	    assert len(matches) == 1, "grid must have exactly one matching full-row/full-col divider"
    99	    return matches[0]
