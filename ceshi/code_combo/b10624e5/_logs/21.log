   134	def _extract_side_pieces(patch: np.ndarray, bg: int) -> dict[str, np.ndarray]:
   135	    mask = (patch != bg) & (patch != RED)
   136	    comps = components_mask(mask, connectivity=4)
   137	    h, w = patch.shape
   138	    pieces: dict[str, np.ndarray] = {}
   139	    for pts in comps:
   140	        r0, c0, r1, c1 = bbox_coords(pts)
   141	        touches = []
   142	        if r0 == 0:
   143	            touches.append("top")
   144	        if r1 == h - 1:
   145	            touches.append("bottom")
   146	        if c0 == 0:
   147	            touches.append("left")
   148	        if c1 == w - 1:
   149	            touches.append("right")
   150	        assert len(touches) == 1, "each source side piece must touch exactly one outer edge"
   151	        side = touches[0]
   152	        assert side not in pieces, "there must be exactly one side piece per edge"
   153	        pieces[side] = patch[r0 : r1 + 1, c0 : c1 + 1].copy()
   154	    assert set(pieces) == set(SIDES), "source motif must provide top/bottom/left/right side pieces"
   155	    return pieces
