   158	def _transform_side_piece(
   159	    piece: np.ndarray, side: str, qb: int, qr: int, target_size: int
   160	) -> tuple[str, np.ndarray]:
   161	    out_side = side
   162	    out_piece = piece
   163	
   164	    if side in {"top", "bottom"} and qr == 1:
   165	        out_piece = np.fliplr(out_piece)
   166	    if side in {"left", "right"} and qb == 1:
   167	        out_piece = np.flipud(out_piece)
   168	
   169	    if qr == 1:
   170	        out_side = _horizontal_mirror(out_side)
   171	    if qb == 1:
   172	        out_side = _vertical_mirror(out_side)
   173	
   174	    ratio = target_size / SOURCE_ANCHOR_SIZE
   175	    new_h = max(1, int(round(out_piece.shape[0] * ratio)))
   176	    new_w = max(1, int(round(out_piece.shape[1] * ratio)))
   177	    return out_side, _resize_nn(out_piece, new_h, new_w)
