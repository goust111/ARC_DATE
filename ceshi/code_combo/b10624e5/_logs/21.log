   201	def _stamp_piece(
   202	    out: np.ndarray, piece: np.ndarray, place_r0: int, place_c0: int, bg: int, mid_r: int, mid_c: int
   203	) -> None:
   204	    h, w = out.shape
   205	    rr_p, cc_p = np.where(piece != bg)
   206	    for rr0, cc0 in zip(rr_p.tolist(), cc_p.tolist(), strict=False):
   207	        rr_t = place_r0 + rr0
   208	        cc_t = place_c0 + cc0
   209	        if not (0 <= rr_t < h and 0 <= cc_t < w):
   210	            continue
   211	        if rr_t == mid_r or cc_t == mid_c:
   212	            continue
   213	        if out[rr_t, cc_t] == RED:
   214	            continue
   215	        out[rr_t, cc_t] = int(piece[rr0, cc0])
