   399	def _footprint_bounds(side_pieces: dict[str, np.ndarray], qb: int, qr: int, target_size: int) -> tuple[int, int, int, int]:
   400	    min_r, max_r = 0, target_size - 1
   401	    min_c, max_c = 0, target_size - 1
   402	    for side, piece_s in _transformed_side_pieces(side_pieces, qb, qr, target_size):
   403	        dr, dc = _relative_piece_start(side, piece_s.shape, target_size)
   404	        min_r = min(min_r, dr)
   405	        max_r = max(max_r, dr + piece_s.shape[0] - 1)
   406	        min_c = min(min_c, dc)
   407	        max_c = max(max_c, dc + piece_s.shape[1] - 1)
   408	    return int(min_r), int(max_r), int(min_c), int(max_c)
