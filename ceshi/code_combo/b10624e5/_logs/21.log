   218	def _anchors_by_quadrant(g: np.ndarray, mid_r: int, mid_c: int) -> dict[tuple[int, int], tuple[int, int, int]]:
   219	    red = components_mask(g == RED, connectivity=4)
   220	    assert red, "grid must contain red anchor blocks"
   221	    anchors: dict[tuple[int, int], tuple[int, int, int]] = {}
   222	    for pts in red:
   223	        r0, c0, r1, c1 = bbox_coords(pts)
   224	        rr = (r0 + r1) // 2
   225	        cc = (c0 + c1) // 2
   226	        qb = 0 if rr < mid_r else 1
   227	        qr = 0 if cc < mid_c else 1
   228	        size = max(r1 - r0 + 1, c1 - c0 + 1)
   229	        key = (qb, qr)
   230	        assert key not in anchors, "each quadrant must contain exactly one red anchor block"
   231	        anchors[key] = (int(r0), int(c0), int(size))
   232	    assert set(anchors) == set(QUADS), "there must be one red anchor in every quadrant"
   233	    return anchors
