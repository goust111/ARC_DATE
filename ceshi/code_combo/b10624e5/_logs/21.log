   194	def _absolute_piece_start(
   195	    side: str, piece_shape: tuple[int, int], anchor_r: int, anchor_c: int, target_size: int
   196	) -> tuple[int, int]:
   197	    dr, dc = _relative_piece_start(side, piece_shape, target_size)
   198	    return int(anchor_r + dr), int(anchor_c + dc)
