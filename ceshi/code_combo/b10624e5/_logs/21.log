   102	def _resize_nn(img: np.ndarray, new_h: int, new_w: int) -> np.ndarray:
   103	    src_h, src_w = img.shape
   104	    rr = np.clip(np.floor(np.arange(new_h) * src_h / new_h).astype(int), 0, src_h - 1)
   105	    cc = np.clip(np.floor(np.arange(new_w) * src_w / new_w).astype(int), 0, src_w - 1)
   106	    return img[rr[:, None], cc[None, :]]
