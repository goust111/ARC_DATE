   366	def _build_source_patch() -> np.ndarray:
   367	    patch = np.full((SOURCE_PATCH_SIZE, SOURCE_PATCH_SIZE), BG, dtype=int)
   368	    patch[2:4, 2:4] = RED
   369	    palette = random.sample(COLOR_POOL, 4)
   370	
   371	    while True:
   372	        specs = {}
   373	        for side in SIDES:
   374	            length = random.randint(2, 4)
   375	            start = random.randint(1, 5 - length)
   376	            specs[side] = (start, _rand_seq(length, palette))
   377	        legacy_like = all(
   378	            (side in {"top", "bottom"} and specs[side][0] == 1 and len(specs[side][1]) == 4)
   379	            or (side in {"left", "right"} and specs[side][0] == 1 and len(specs[side][1]) == 4)
   380	            for side in SIDES
   381	        )
   382	        if not legacy_like:
   383	            break
   384	
   385	    for side, (start, colors) in specs.items():
   386	        _paint_side(patch, side, start, colors)
   387	
   388	    pieces = _extract_side_pieces(patch, BG)
   389	    assert set(pieces) == set(SIDES)
   390	    return patch
