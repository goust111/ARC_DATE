   282	def main(grid: np.ndarray) -> np.ndarray:
   283	    """
   284	    Transfer four surround side-pieces from the top-left anchor into the other quadrants using centered placement.
   285	
   286	    Input structure:
   287	    - The grid is split into four quadrants by one full divider row and one full divider column.
   288	    - Every quadrant contains exactly one red square anchor block.
   289	    - The top-left quadrant contains the only complete source motif: four disconnected colored side-pieces around the red anchor, one touching each outer edge of the source bbox.
   290	
   291	    Rule:
   292	    - Take the full non-background bbox from the top-left quadrant, then split its non-red pixels into the top/bottom/left/right side-pieces.
   293	    - For each destination quadrant, reflect each side-piece according to the quadrant relation, scale that side-piece by the target/source anchor-size ratio, and map it to the corresponding destination side.
   294	    - Place every transformed side-piece relative to the target anchor center, centered along that edge, with a scaled background gap preserved between the side-piece and the anchor.
   295	
   296	    Key insight: The transferable object is not one monolithic template anymore; it is a four-part surround layout whose pieces are transformed independently and re-centered around each target anchor.
   297	    """
   298	    g = np.asarray(grid, dtype=int)
   299	    out = g.copy()
   300	
   301	    bg = get_bg(g)
   302	    mid_r, mid_c = _find_dividers(g, bg)
   303	    anchors = _anchors_by_quadrant(g, mid_r, mid_c)
   304	
   305	    sr0, sc0, sL = anchors[(0, 0)]
   306	    assert sL == SOURCE_ANCHOR_SIZE, "top-left red anchor must be 2x2 in this combo"
   307	
   308	    tl = g[0:mid_r, 0:mid_c]
   309	    patch = _source_patch_from_tl(tl, bg)
   310	    assert patch.shape == (SOURCE_PATCH_SIZE, SOURCE_PATCH_SIZE), "source surround template must be 6x6"
   311	
   312	    rr_red, cc_red = np.where(patch == RED)
   313	    assert rr_red.size > 0, "source template must contain a red anchor"
   314	    assert int(rr_red.min()) == 2 and int(cc_red.min()) == 2, "source anchor must sit in the center of the 6x6 frame"
   315	    assert int(rr_red.max()) == 3 and int(cc_red.max()) == 3
   316	
   317	    side_pieces = _extract_side_pieces(patch, bg)
   318	    assert sr0 >= 0 and sc0 >= 0  # kept only to make the source-anchor dependency explicit
   319	
   320	    for (qb, qr), (tr0, tc0, tL) in anchors.items():
   321	        if (qb, qr) == (0, 0):
   322	            continue
   323	        for side, piece in side_pieces.items():
   324	            out_side, piece_s = _transform_side_piece(piece, side, qb, qr, tL)
   325	            place_r0, place_c0 = _absolute_piece_start(out_side, piece_s.shape, tr0, tc0, tL)
   326	            _stamp_piece(out, piece_s, place_r0, place_c0, bg, mid_r, mid_c)
   327	
   328	    return out
