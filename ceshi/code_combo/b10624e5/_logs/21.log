   180	def _relative_piece_start(side: str, piece_shape: tuple[int, int], target_size: int) -> tuple[int, int]:
   181	    h, w = map(int, piece_shape)
   182	    gap = _scaled_gap(target_size)
   183	    if side == "top":
   184	        return -gap - h, _center_start(0, target_size, w)
   185	    if side == "bottom":
   186	        return target_size + gap, _center_start(0, target_size, w)
   187	    if side == "left":
   188	        return _center_start(0, target_size, h), -gap - w
   189	    if side == "right":
   190	        return _center_start(0, target_size, h), target_size + gap
   191	    raise ValueError(f"unknown side: {side}")
