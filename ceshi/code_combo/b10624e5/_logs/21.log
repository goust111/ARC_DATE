   350	def _paint_side(patch: np.ndarray, side: str, start: int, colors: list[int]) -> None:
   351	    if side == "top":
   352	        patch[0, start : start + len(colors)] = colors
   353	        return
   354	    if side == "bottom":
   355	        patch[-1, start : start + len(colors)] = colors
   356	        return
   357	    if side == "left":
   358	        patch[start : start + len(colors), 0] = colors
   359	        return
   360	    if side == "right":
   361	        patch[start : start + len(colors), -1] = colors
   362	        return
   363	    raise ValueError(f"unknown side: {side}")
