    tl_mask[sr0 + 1:sr1, sc0 + 1:sc1] = True
    embedded_outside_counts.append(int(np.count_nonzero((tl "'!= mod.BG) & (tl != mod.RED) & (~tl_mask))))

    cavity_mask = np.zeros_like(inp, dtype=bool)
    sample_sizes = []
    for key in ((0, 1), (1, 0), (1, 1)):
        r0, c0, r1, c1 = boxes[key]
        cavity_mask[r0 + 1:r1, c0 + 1:c1] = True
        size = r1 - r0 - 1
        sample_sizes.append(size)
        size_counter[size] += 1
    outside_cavity_changes.append(int(np.count_nonzero((inp != out) & (~cavity_mask))))
    if len(set(sample_sizes)) >= 2 and any(size != mod.SOURCE_INNER_SIZE for size in sample_sizes):
        nontrivial_scale_samples += 1

print('"'embedded_outside_counts:', Counter(embedded_outside_counts))
print('outside_cavity_changes:', Counter(outside_cavity_changes))
print('target_cavity_size_counts:', dict(sorted(size_counter.items())))
print('nontrivial_scale_samples:', f'{nontrivial_scale_samples}/{samples}')
