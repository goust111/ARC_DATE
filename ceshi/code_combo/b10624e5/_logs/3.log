+# Combo variant of b10624e5 (index 3)
+# combo_spec: D2/2+D3/0
+# Name: 锚块内部嵌入源图案 + 锚块空洞目标槽位
+
+import random
+import sys
+from pathlib import Path
+
+import numpy as np
+
+SOLVER_DIR = Path(__file__).resolve().parents[4] / "solvers"
+if str(SOLVER_DIR) not in sys.path:
