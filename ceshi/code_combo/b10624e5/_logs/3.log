+
+        target_frame = g[r0 : r1 + 1, c0 : c1 + 1]
+        assert _is_hollow_red_square(target_frame, bg), "non-TL red object must be a hollow square frame"
+        cavity_size = target_frame.shape[0] - 2 * FRAME_THICKNESS
