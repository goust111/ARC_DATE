    ```python
    import numpy as np

from arc_utils import bbox_coords, components_mask, get_bg, paste
import random


def _find_dividers(g: np.ndarray, bg: int) -> tuple[int, int]:
    """
    Return the unique full-row/full-col quadrant divider: (mid_row, mid_col).
    """
    h, w = g.shape
    full_rows = [(r, int(g[r, 0])) for r in range(h) if np.all(g[r, :] == g[r, 0]) and int(g[r, 0]) != bg]
    full_cols = [(c, int(g[0, c])) for c in range(w) if np.all(g[:, c] == g[0, c]) and int(g[0, c]) != bg]
    matches = []
    for r, vr in full_rows:
        for c, vc in full_cols:
            if vr == vc:
                matches.append((int(r), int(c)))
    assert len(matches) == 1, "grid must have exactly one matching full-row/full-col divider"
    return matches[0]


def main(grid: np.ndarray) -> np.ndarray:
    """
    Replicate a motif across quadrants with scaling and reflection keyed to red anchor blocks.

    Input structure:
    - Grid divided into four quadrants by a full-row and full-column divider of a single non-bg color.
    - Each quadrant contains a red (2) square anchor block of varying size.
    - The top-left quadrant also has a colored motif attached to its red anchor.

    Rule:
    - Use the top-left quadrant's motif as the source pattern.
    - For each other quadrant, scale the motif by the ratio of that quadrant's red block size to the source red block size.
    - Reflect horizontally for right-side quadrants, vertically for bottom quadrants (both for bottom-right).
    - Align the scaled/reflected motif so its red region overlaps the target anchor, then stamp non-bg pixels.

    Key insight: Red block size encodes the scale factor; quadrant position encodes the reflection axes.
    """
    g = np.asarray(grid, dtype=int)
    h, w = g.shape
    out = g.copy()

    bg = get_bg(g)
    mid_r, mid_c = _find_dividers(g, bg)

    # Find red anchor blocks (color 2) in each quadrant.
    red = components_mask(g == 2, connectivity=4)
    assert red, "grid must contain red (color 2) anchor blocks"

    # Quadrant key: (top/bottom, left/right)
    anchors: dict[tuple[int, int], tuple[int, int, int]] = {}
    # value: (r0,c0,size)
    for pts in red:
        r0, c0, r1, c1 = bbox_coords(pts)
        rr = (r0 + r1) // 2
        cc = (c0 + c1) // 2
        qb = 0 if rr < mid_r else 1
        qr = 0 if cc < mid_c else 1
        size = max(r1 - r0 + 1, c1 - c0 + 1)
        key = (qb, qr)
        assert key not in anchors, "each quadrant must contain exactly one red anchor block"
        anchors[key] = (int(r0), int(c0), int(size))

    assert (0, 0) in anchors, "top-left quadrant must contain a red anchor block"
    sr0, sc0, sL = anchors[(0, 0)]
    assert sL > 0, "top-left red anchor must have positive size"

    # Build a source patch around the TL motif: take the non-bg connected component (4-neigh)
    # in the TL quadrant that contains the TL red anchor.
    tl = g[0:mid_r, 0:mid_c]
    comps = components_mask(tl != bg, connectivity=4)
    patch_bb = None
    for pts in comps:
        # component contains any red pixel?
        if any(tl[r, c] == 2 for r, c in pts):
            r0, c0, r1, c1 = bbox_coords(pts)
            patch_bb = (int(r0), int(c0), int(r1), int(c1))
            break
    assert patch_bb is not None, "top-left quadrant must contain a non-bg component with a red pixel"

    pr0, pc0, pr1, pc1 = patch_bb
    patch = tl[pr0 : pr1 + 1, pc0 : pc1 + 1].copy()

    def resize_nn(img: np.ndarray, new_h: int, new_w: int) -> np.ndarray:
        src_h, src_w = img.shape
        if new_h <= 0 or new_w <= 0:
            return img.copy()
        rr = (np.floor(np.arange(new_h) * src_h / new_h)).astype(int)
        cc = (np.floor(np.arange(new_w) * src_w / new_w)).astype(int)
        rr = np.clip(rr, 0, src_h - 1)
        cc = np.clip(cc, 0, src_w - 1)
        return img[rr[:, None], cc[None, :]]

    # For each quadrant anchor, paste a scaled/reflected version of the patch.
    for (qb, qr), (tr0, tc0, tL) in anchors.items():
        if (qb, qr) == (0, 0):
            continue
        patch_t = patch
        if qr == 1:
            patch_t = np.fliplr(patch_t)
        if qb == 1:
            patch_t = np.flipud(patch_t)

        ratio = float(tL) / float(sL)
        new_h = int(round(patch_t.shape[0] * ratio))
        new_w = int(round(patch_t.shape[1] * ratio))
        new_h = max(1, new_h)
        new_w = max(1, new_w)
        patch_s = resize_nn(patch_t, new_h, new_w)
        roundtrip = resize_nn(patch_s, patch_t.shape[0], patch_t.shape[1])
        assert np.array_equal(roundtrip, patch_t), "scaling must preserve all motif information"

        # Align scaled red bbox in patch_s to the target red bbox.
        rr_red, cc_red = np.where(patch_s == 2)
        assert rr_red.size > 0, "scaled source patch must contain red anchor pixels"
        ar0, ac0 = int(rr_red.min()), int(cc_red.min())
        place_r0 = tr0 - ar0
        place_c0 = tc0 - ac0

        rr_p, cc_p = np.where(patch_s != bg)
        for rr0, cc0 in zip(rr_p.tolist(), cc_p.tolist(), strict=False):
            val = int(patch_s[rr0, cc0])
            rr_t = place_r0 + rr0
            cc_t = place_c0 + cc0
            if not (0 <= rr_t < h and 0 <= cc_t < w):
                continue
            if rr_t == mid_r or cc_t == mid_c:
                continue
            if out[rr_t, cc_t] == 2:
                continue
            out[rr_t, cc_t] = val

    return out

# --------------- generator (o5x) ---------------

# --- Grid constants ---
BG = 4                  # background color
DIV = 1                 # divider color
RED = 2                 # anchor color
GRID_SIZE = 27          # full grid dimension
MID = 13                # divider row/col index
QUADS = {               # (row_lo, row_hi, col_lo, col_hi) inclusive per quadrant
    (0, 0): (0, 12, 0, 12),
    (0, 1): (0, 12, 14, 26),
    (1, 0): (14, 26, 0, 12),
    (1, 1): (14, 26, 14, 26),
}

# --- Source motif parameters ---
SOURCE_ANCHOR_SIZE = 2                  # TL anchor is always 2x2
BLOCK_DIMS = [(2, 2), (2, 3), (3, 2), (3, 3)]  # logical block sizes for block method
BLOCK_PROB = 0.5                        # prob of block method when not forced
FILL_RATIO_MIN = 0.5                    # minimum motif fill ratio
FILL_RATIO_MAX = 0.8                    # maximum motif fill ratio
FREEFORM_H_RANGE = (3, 6)              # freeform motif height range
FREEFORM_W_RANGE = (3, 6)              # freeform motif width range
MOTIF_COLORS_MIN = 3                    # min distinct non-bg colors (including red)
MOTIF_COLORS_MAX = 5                    # max distinct non-bg colors
COLOR_POOL = [0, 1, 3, 5, 6, 7, 8, 9]  # non-red, non-bg candidate colors

# --- Target anchor parameters ---
TARGET_SIZE_RANGE = (1, 4)              # anchor size range for non-TL quadrants

# --- Generation retry limit ---
MAX_RETRIES = 300


def _resize_nn(img: np.ndarray, new_h: int, new_w: int) -> np.ndarray:
    """Nearest-neighbor resize supporting fractional scale ratios."""
    src_h, src_w = img.shape
    rr = np.clip(np.floor(np.arange(new_h) * src_h / new_h).astype(int), 0, src_h - 1)
    cc = np.clip(np.floor(np.arange(new_w) * src_w / new_w).astype(int), 0, src_w - 1)
    return img[rr[:, None], cc[None, :]]


def _scaled_patch(patch: np.ndarray, qb: int, qr: int, target_size: int) -> np.ndarray:
    """Reflect and scale the source patch for a given quadrant and target anchor size."""
    p = patch
    if qr:
        p = np.fliplr(p)
    if qb:
        p = np.flipud(p)
    ratio = target_size / SOURCE_ANCHOR_SIZE
    h = max(1, int(round(p.shape[0] * ratio)))
    w = max(1, int(round(p.shape[1] * ratio)))
    return _resize_nn(p, h, w)


def _grow_4conn(h: int, w: int, seeds: set[tuple[int, int]], n_fill: int) -> set[tuple[int, int]]:
    """Grow a 4-connected region from seeds until it has n_fill cells."""
    filled = set(seeds)
    frontier = set()
    for r, c in seeds:
        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
            nr, nc = r + dr, c + dc
            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in filled:
                frontier.add((nr, nc))
    while len(filled) < n_fill and frontier:
        cell = random.choice(list(frontier))
        filled.add(cell)
        frontier.discard(cell)
        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
            nr, nc = cell[0] + dr, cell[1] + dc
            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in filled:
                frontier.add((nr, nc))
    return filled


def _assign_colors(filled: set[tuple[int, int]], red_cells: set[tuple[int, int]],
                   h: int, w: int) -> np.ndarray | None:
    """Assign random colors to filled cells; returns None if coverage is incomplete."""
    rows = {r for r, _ in filled}
    cols = {c for _, c in filled}
    if rows != set(range(h)) or cols != set(range(w)):
        return None
    non_red = [p for p in filled if p not in red_cells]
    random.shuffle(non_red)
    max_colors = min(MOTIF_COLORS_MAX, len(non_red) + 1)
    if max_colors < MOTIF_COLORS_MIN:
        return None
    n_colors = random.randint(MOTIF_COLORS_MIN, max_colors)
    pool = COLOR_POOL[:]
    random.shuffle(pool)
    extras = pool[: n_colors - 1]
    grid = np.full((h, w), BG, dtype=int)
    for r, c in red_cells:
        grid[r, c] = RED
    for i, (r, c) in enumerate(non_red):
        grid[r, c] = extras[i] if i < len(extras) else random.choice(extras)
    return grid


def _source_patch(needs_block: bool) -> tuple[np.ndarray, int, int] | None:
    """Build the TL motif patch. Block method upscales a logical grid by SOURCE_ANCHOR_SIZE;
    freeform method grows directly at pixel resolution with a 2x2 red anchor."""
    S = SOURCE_ANCHOR_SIZE
    use_block = needs_block or random.random() < BLOCK_PROB
    if use_block:
        lh, lw = random.choice(BLOCK_DIMS)
        n_cells = lh * lw
        min_fill = max(3, int(np.ceil(FILL_RATIO_MIN * n_cells)))
        max_fill = max(min_fill, int(np.floor(FILL_RATIO_MAX * n_cells)))
        ar, ac = random.randrange(lh), random.randrange(lw)
        filled = _grow_4conn(lh, lw, {(ar, ac)}, random.randint(min_fill, max_fill))
        logical = _assign_colors(filled, {(ar, ac)}, lh, lw)
        if logical is None:
            return None
        patch = np.repeat(np.repeat(logical, S, axis=0), S, axis=1)
        return patch, ar * S, ac * S
    else:
        h = random.randint(*FREEFORM_H_RANGE)
        w = random.randint(*FREEFORM_W_RANGE)
        ar, ac = random.randint(0, h - S), random.randint(0, w - S)
        red_cells = {(ar + dr, ac + dc) for dr in range(S) for dc in range(S)}
        min_fill = max(len(red_cells) + 2, int(np.ceil(FILL_RATIO_MIN * h * w)))
        max_fill = int(np.floor(FILL_RATIO_MAX * h * w))
        if max_fill < min_fill:
            return None
        filled = _grow_4conn(h, w, red_cells, random.randint(min_fill, max_fill))
        patch = _assign_colors(filled, red_cells, h, w)
        if patch is None:
            return None
        return patch, ar, ac


def _choose_anchor(qb: int, qr: int, size: int, patch_s: np.ndarray) -> tuple[int, int]:
    """Pick a random anchor position for the red block within the quadrant,
    preferring positions where the full scaled motif fits inside the quadrant."""
    q_r0, q_r1, q_c0, q_c1 = QUADS[(qb, qr)]
    rr, cc = np.where(patch_s == RED)
    red_r0, red_c0 = int(rr.min()), int(cc.min())

    # Range where the full motif fits inside the quadrant
    fit_r0 = q_r0 + red_r0
    fit_r1 = q_r1 - patch_s.shape[0] + 1 + red_r0
    fit_c0 = q_c0 + red_c0
    fit_c1 = q_c1 - patch_s.shape[1] + 1 + red_c0

    # Range where the anchor block itself fits inside the quadrant
    anch_r0, anch_r1 = q_r0, q_r1 - size + 1
    anch_c0, anch_c1 = q_c0, q_c1 - size + 1

    # Intersect: prefer full-fit, fall back to anchor-only fit
    r_lo, r_hi = max(fit_r0, anch_r0), min(fit_r1, anch_r1)
    c_lo, c_hi = max(fit_c0, anch_c0), min(fit_c1, anch_c1)
    if r_lo <= r_hi and c_lo <= c_hi:
        return random.randint(r_lo, r_hi), random.randint(c_lo, c_hi)
    return random.randint(anch_r0, anch_r1), random.randint(anch_c0, anch_c1)


def _stamp(out: np.ndarray, patch_s: np.ndarray, anchor_r: int, anchor_c: int) -> None:
    """Stamp non-bg pixels from a scaled patch onto the output grid, aligned by red anchor.
    Skips divider row/col, out-of-bounds pixels, and existing red pixels."""
    rr_red, cc_red = np.where(patch_s == RED)
    place_r0 = anchor_r - int(rr_red.min())
    place_c0 = anchor_c - int(cc_red.min())

    # Source pixel coordinates and their target positions
    src_rr, src_cc = np.where(patch_s != BG)
    tgt_rr = src_rr + place_r0
    tgt_cc = src_cc + place_c0

    # Mask: in-bounds, not on divider, target is not already red
    valid = ((tgt_rr >= 0) & (tgt_rr < GRID_SIZE) &
             (tgt_cc >= 0) & (tgt_cc < GRID_SIZE) &
             (tgt_rr != MID) & (tgt_cc != MID))
    tgt_rr, tgt_cc, src_rr, src_cc = tgt_rr[valid], tgt_cc[valid], src_rr[valid], src_cc[valid]
    not_red = out[tgt_rr, tgt_cc] != RED
    out[tgt_rr[not_red], tgt_cc[not_red]] = patch_s[src_rr[not_red], src_cc[not_red]]


def _gen_attempt() -> np.ndarray | None:
    """Single generation attempt: build output, derive input, oracle-check."""
    target_sizes = {
        (0, 0): SOURCE_ANCHOR_SIZE,
        (0, 1): random.randint(*TARGET_SIZE_RANGE),
        (1, 0): random.randint(*TARGET_SIZE_RANGE),
        (1, 1): random.randint(*TARGET_SIZE_RANGE),
    }

    needs_block = any(s % SOURCE_ANCHOR_SIZE != 0 for k, s in target_sizes.items() if k != (0, 0))
    source = _source_patch(needs_block)
    if source is None:
        return None
    patch, anchor_r_in_patch, anchor_c_in_patch = source

    scaled = {
        key: _scaled_patch(patch, key[0], key[1], size)
        for key, size in target_sizes.items()
        if key != (0, 0)
    }

    # Place anchors
    anchors: dict[tuple[int, int], tuple[int, int]] = {}
    tl_r0 = random.randint(0, MID - patch.shape[0])
    tl_c0 = random.randint(0, MID - patch.shape[1])
    anchors[(0, 0)] = (tl_r0 + anchor_r_in_patch, tl_c0 + anchor_c_in_patch)
    for key, patch_s in scaled.items():
        anchors[key] = _choose_anchor(key[0], key[1], target_sizes[key], patch_s)

    # Build output grid
    out = np.full((GRID_SIZE, GRID_SIZE), BG, dtype=int)
    out[MID, :] = DIV
    out[:, MID] = DIV
    paste(out, patch, tl_r0, tl_c0)
    for key, size in target_sizes.items():
        if key == (0, 0):
            continue
        ar, ac = anchors[key]
        paste(out, np.full((size, size), RED, dtype=int), ar, ac)
    for key, patch_s in scaled.items():
        _stamp(out, patch_s, *anchors[key])

    # Build input: clear non-TL quadrants, keep only red anchors
    inp = out.copy()
    for key, size in target_sizes.items():
        if key == (0, 0):
            continue
        q_r0, q_r1, q_c0, q_c1 = QUADS[key]
        inp[q_r0 : q_r1 + 1, q_c0 : q_c1 + 1] = BG
        ar, ac = anchors[key]
        paste(inp, np.full((size, size), RED, dtype=int), ar, ac)

    return inp if np.array_equal(main(inp), out) else None


def generate_input() -> np.ndarray:
    for _ in range(MAX_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid b10624e5 input")

    ```

    ## 原始任务规格（Spec）

    以下是从原始 solver 代码和示例中提炼的完整任务规格，包含精确的数值约束和生成策略。
    Spec 本身就是原题代码生成时的参考文件，因此：
    - 在**设计分析**阶段，参考 spec 理解原始任务的完整设计细节（对象结构、空间关系、生成策略等），以此为基础思考融合变体的改动如何落实
    - 在**实现**阶段，参考 spec 中的数值约束（网格尺寸、对象数量/尺寸、颜色数等），确保融合变体在物理上可实现

    ```yaml
    spec:
  grid: 27x27, bg=4 [observed], divider color=1 [observed]
  divider: one full row + one full col of same non-bg color crossing at (13,13), splitting grid into four 13x13 quadrants
  anchors:
    count: exactly 4, one per quadrant
    shape: NxN filled red (color 2) squares
    source: TL anchor is always 2x2 [observed]
    target_sizes: 1-4; each quadrant gets a distinct or shared size; set includes sizes from {1,2,3,4}
    position: anywhere within the quadrant with room for the scaled motif (clipping at grid edge is OK)
  motif:
    location: TL quadrant only; single 4-connected non-bg component containing the red anchor
    shape: 2-6 rows x 2-6 cols bounding box; fill ratio 0.5-0.8 (contains bg holes)
    colors: 3-5 distinct non-bg colors including red (2); may include divider color
    connectivity: all non-bg pixels form one 4-connected component
    exact_scaling: nearest-neighbor resize to any target anchor size must be lossless (roundtrip: resize to target then back to source recovers the original pixel-for-pixel)
  non_TL_quadrants_input: contain ONLY the red anchor block (no other non-bg pixels)
  output_rule: |
    For each non-TL quadrant, scale the TL motif by (target_anchor_size / source_anchor_size)
    via nearest-neighbor resize. Reflect LR for right quadrants, UD for bottom quadrants,
    both for BR. Align scaled red region onto target anchor and stamp non-bg pixels.
    Skip divider row/col and existing red pixels. Clip at grid bounds.

generation_strategy:
  approach: output-first
  steps:
    1. Fix grid 27x27, bg=4, divider color=1 at row 13 col 13.
    2. Choose 3 target anchor sizes from {1,2,3,4} for TR/BL/BR (source TL is always 2).
    3. Design the source motif (4-connected, 3-5 non-bg colors including red 2, red anchor occupies a 2×2 sub-region). Motif must satisfy exact_scaling constraint for all chosen target sizes.
    4. For each of the 4 quadrants, compute the scaled+reflected motif. Verify all
       scaled motifs have >=1 non-bg pixel visible in their quadrant (not fully clipped).
    5. Place anchors in each quadrant so that the scaled motif fits reasonably (allow partial clipping at grid edge).
    6. Build the input: fill grid with bg+divider, place TL motif, place only-red-anchors in TR/BL/BR.
    ```

额外要求：原始代码的 `main()` 已包含四段式说明注释/文档字符串（开头概述 + `Input structure:` + `Rule:` + `Key insight:`）。
生成的新代码里也必须在 `main()` 上方保留这一结构，并根据**融合后的新规则**与**原注释提供的信息**重新编写；可以借鉴原注释的组织方式，但**不要照抄原文**，要让内容准确反映融合后的输入结构、规则和关键洞察。


## 已有单变体参考代码

以下组成项已有单变体实现，可作为融合时的参考：

            ### 参考代码: D2/2

            文件: `/home/lixinyu/snap/new/ceshi/code/b10624e5/D2/2/code.py`

            ```python
            # Variant of b10624e5
# Dimension: D2 — 源对象：左上象限锚块旁的彩色图案 (src)
# Change: 左上象限中与红色锚块相邻的彩色像素构成源图案... → 锚块内部嵌入的微型图案作为源

from pathlib import Path
import random
import sys

import numpy as np

try:
    from arc_utils import bbox_coords, components_mask, get_bg, paste
except ImportError:
    sys.path.append(str(Path(__file__).resolve().parents[5]))
    from arc_utils import bbox_coords, components_mask, get_bg, paste


# Design analysis for the D2 variant
# ==================================
# a) Concrete behavior:
# - The divider layout and four-quadrant scaffold stay unchanged.
# - Every quadrant still contains one red square anchor.
# - The change is local to the source object: in TL, the anchor is no longer accompanied by
#   an outside motif. Instead, the anchor itself is a red square with a 1-pixel red frame and
#   a 2x2 colored miniature inside it.
# - The output fills the interiors of the other anchors with reflected+scaled copies of that
#   2x2 miniature. The copied pattern is placed strictly inside each target anchor, preserving
#   a 1-pixel red border there as well.
# - Small trace:
#   original path: find TL connected component containing red -> scale whole component ->
#   align its red bbox to each target anchor.
#   variant path: find TL red anchor bbox -> extract only the interior miniature ->
#   reflect/resize it to each target interior -> write it inside the target anchor frame.
#   The difference matters when target size != TL size: scaling the full 4x4 anchor would move
#   colors toward borders, while the variant keeps a fixed red frame and scales only the inner art.
#
# b) Complexity calibration:
# - The miniature is 2x2 with 3-4 visible colors and forced LR/UD asymmetry, so reflections are
#   observable in a few examples.
# - Target sizes are limited to 4..6. This keeps interiors at 2..4 pixels wide: large enough to
#   see the miniature, but still few enough that the relationship is easy to infer.
# - At least one non-TL anchor is larger than the TL anchor, and the three target sizes are not
#   all identical, so anchor size actually carries information.
#
# c) Old implicit assumptions that must change:
# - Original solver assumed the source pattern was the entire non-bg component touching the TL
#   anchor. That is now false: the informative part is the anchor interior only.
# - Original solver aligned by the scaled red bbox inside the copied patch. Here alignment by the
#   full patch would be wrong, because the target red frame must remain a fixed 1-pixel border.
# - Original roundtrip scaling assertion depended on a specially generated external motif. After
#   moving the motif into a fixed interior cavity, retaining that assertion would reject many
#   visually clear samples; generator-side oracle validation is sufficient instead.
#
# d) Placement legality:
# - All anchors are axis-aligned squares fully contained in one quadrant.
# - TL anchor size is fixed at 4, so the source interior is always exactly 2x2.
# - Target anchors have size 4..6, guaranteeing a non-empty interior and preventing the copied
#   pattern from touching the divider or leaving the anchor.
#
# e) Visual observability:
# - The only colored pixels in TL outside the divider are inside the anchor, so the embedded-source
#   change is visible immediately.
# - Because the 2x2 source is asymmetric, left/right and up/down reflections show up across the
#   other three quadrants.
#
# f) Visual cleanliness:
# - There is no extra decoration near anchors, no overlapping objects, and no ambiguous connected
#   components beyond the intended TL framed anchor.
# - The red border keeps anchors legible even after the interiors are filled.
#
# g) Color inference:
# - No hidden ordering or color-id arithmetic is used.
# - Colors are copied verbatim; only geometry changes.
#
# New solver assumptions audited against generator:
# - Each quadrant has exactly one red connected component whose bbox is a square anchor.
# - The TL anchor has size 4 and contains at least one non-red pixel in its 2x2 interior.
# - Non-TL anchors are at least 4x4, so their writable interior exists and is fully inside the
#   quadrant. The generator enforces all three conditions.


BG = 4
DIV = 1
RED = 2
GRID_SIZE = 27
MID = 13
QUADS = {
    (0, 0): (0, 12, 0, 12),
    (0, 1): (0, 12, 14, 26),
    (1, 0): (14, 26, 0, 12),
    (1, 1): (14, 26, 14, 26),
}

SOURCE_ANCHOR_SIZE = 4
TARGET_SIZE_RANGE = (4, 6)
COLOR_POOL = [0, 3, 5, 6, 7, 8, 9]
MAX_RETRIES = 400


def _find_dividers(g: np.ndarray, bg: int) -> tuple[int, int]:
    """
    Return the unique full-row/full-col quadrant divider: (mid_row, mid_col).
    """
    h, w = g.shape
    full_rows = [(r, int(g[r, 0])) for r in range(h) if np.all(g[r, :] == g[r, 0]) and int(g[r, 0]) != bg]
    full_cols = [(c, int(g[0, c])) for c in range(w) if np.all(g[:, c] == g[0, c]) and int(g[0, c]) != bg]
    matches = []
    for r, vr in full_rows:
        for c, vc in full_cols:
            if vr == vc:
                matches.append((int(r), int(c)))
    assert len(matches) == 1, "grid must have exactly one matching full-row/full-col divider"
    return matches[0]


def _resize_nn(img: np.ndarray, new_h: int, new_w: int) -> np.ndarray:
    src_h, src_w = img.shape
    assert new_h > 0 and new_w > 0
    rr = np.clip(np.floor(np.arange(new_h) * src_h / new_h).astype(int), 0, src_h - 1)
    cc = np.clip(np.floor(np.arange(new_w) * src_w / new_w).astype(int), 0, src_w - 1)
    return img[rr[:, None], cc[None, :]]


def main(grid: np.ndarray) -> np.ndarray:
    """
    Propagate an anchor-interior miniature across quadrants using anchor-size scaling and reflections.

    Input structure:
    - A single full row and full column of one non-background color split the 27x27 grid into four quadrants.
    - Each quadrant contains one red square anchor; the top-left anchor is larger and has colored pixels embedded inside it.
    - The other three quadrants show only solid red anchors in the input.

    Rule:
    - Extract the miniature pattern from inside the top-left anchor, excluding its red border.
    - For every other quadrant, reflect that miniature left/right for right-side quadrants and up/down for bottom quadrants.
    - Resize the reflected miniature to the writable interior of the target anchor, then place it inside the red frame.

    Key insight: The source blueprint is hidden inside the top-left anchor itself; anchor size determines how large the interior copy becomes, while quadrant position determines the reflection.
    """
    g = np.asarray(grid, dtype=int)
    out = g.copy()

    bg = get_bg(g)
    mid_r, mid_c = _find_dividers(g, bg)

    anchors: dict[tuple[int, int], tuple[int, int, int]] = {}
    for pts in components_mask(g == RED, connectivity=4):
        r0, c0, r1, c1 = bbox_coords(pts)
        side_r = r1 - r0 + 1
        side_c = c1 - c0 + 1
        assert side_r == side_c, "red anchors must have square bounding boxes"
        rr = (r0 + r1) // 2
        cc = (c0 + c1) // 2
        key = (0 if rr < mid_r else 1, 0 if cc < mid_c else 1)
        assert key not in anchors, "each quadrant must contain exactly one red anchor"
        anchors[key] = (int(r0), int(c0), int(side_r))

    assert set(anchors) == set(QUADS), "must detect one red anchor in every quadrant"

    sr0, sc0, sL = anchors[(0, 0)]
    assert sL >= 4, "top-left anchor must be large enough to contain an interior pattern"
    src_inner = g[sr0 + 1 : sr0 + sL - 1, sc0 + 1 : sc0 + sL - 1].copy()
    assert src_inner.size > 0, "source interior must be non-empty"
    assert np.any(src_inner != RED), "source anchor interior must contain non-red pixels"

    for (qb, qr), (tr0, tc0, tL) in anchors.items():
        if (qb, qr) == (0, 0):
            continue
        assert tL >= 4, "target anchor must have a writable interior"

        motif = src_inner
        if qr == 1:
            motif = np.fliplr(motif)
        if qb == 1:
            motif = np.flipud(motif)

        inner_size = tL - 2
        motif_s = _resize_nn(motif, inner_size, inner_size)
        out[tr0 + 1 : tr0 + tL - 1, tc0 + 1 : tc0 + tL - 1] = motif_s

    return out


def _random_inner_pattern() -> np.ndarray:
    while True:
        n_colors = random.randint(3, 4)
        picked = random.sample(COLOR_POOL, n_colors)
        cells = picked + random.choices(picked, k=4 - n_colors)
        random.shuffle(cells)
        arr = np.array(cells, dtype=int).reshape(2, 2)
        if np.array_equal(arr, np.fliplr(arr)):
            continue
        if np.array_equal(arr, np.flipud(arr)):
            continue
        return arr


def _build_source_patch(inner: np.ndarray) -> np.ndarray:
    patch = np.full((SOURCE_ANCHOR_SIZE, SOURCE_ANCHOR_SIZE), RED, dtype=int)
    patch[1:-1, 1:-1] = inner
    return patch


def _scaled_inner(inner: np.ndarray, qb: int, qr: int, target_size: int) -> np.ndarray:
    motif = inner
    if qr == 1:
        motif = np.fliplr(motif)
    if qb == 1:
        motif = np.flipud(motif)
    inner_size = target_size - 2
    return _resize_nn(motif, inner_size, inner_size)


def _choose_anchor_top_left(qb: int, qr: int, size: int) -> tuple[int, int]:
    q_r0, q_r1, q_c0, q_c1 = QUADS[(qb, qr)]
    return (
        random.randint(q_r0, q_r1 - size + 1),
        random.randint(q_c0, q_c1 - size + 1),
    )


def _paint_inner(out: np.ndarray, top: int, left: int, inner: np.ndarray) -> None:
    out[top + 1 : top + 1 + inner.shape[0], left + 1 : left + 1 + inner.shape[1]] = inner


def _sample_target_sizes() -> dict[tuple[int, int], int]:
    while True:
        sizes = {
            (0, 0): SOURCE_ANCHOR_SIZE,
            (0, 1): random.randint(*TARGET_SIZE_RANGE),
            (1, 0): random.randint(*TARGET_SIZE_RANGE),
            (1, 1): random.randint(*TARGET_SIZE_RANGE),
        }
        non_tl = [sizes[(0, 1)], sizes[(1, 0)], sizes[(1, 1)]]
        if max(non_tl) == SOURCE_ANCHOR_SIZE:
            continue
        if len(set(non_tl)) == 1:
            continue
        return sizes


def _gen_attempt() -> np.ndarray | None:
    inner = _random_inner_pattern()
    source_patch = _build_source_patch(inner)
    sizes = _sample_target_sizes()

    anchors: dict[tuple[int, int], tuple[int, int]] = {}
    anchors[(0, 0)] = _choose_anchor_top_left(0, 0, SOURCE_ANCHOR_SIZE)
    for key, size in sizes.items():
        if key == (0, 0):
            continue
        anchors[key] = _choose_anchor_top_left(key[0], key[1], size)

    out = np.full((GRID_SIZE, GRID_SIZE), BG, dtype=int)
    out[MID, :] = DIV
    out[:, MID] = DIV
    paste(out, source_patch, *anchors[(0, 0)])

    for key, size in sizes.items():
        if key == (0, 0):
            continue
        paste(out, np.full((size, size), RED, dtype=int), *anchors[key])
        _paint_inner(out, anchors[key][0], anchors[key][1], _scaled_inner(inner, key[0], key[1], size))

    inp = np.full((GRID_SIZE, GRID_SIZE), BG, dtype=int)
    inp[MID, :] = DIV
    inp[:, MID] = DIV
    paste(inp, source_patch, *anchors[(0, 0)])
    for key, size in sizes.items():
        if key == (0, 0):
            continue
        paste(inp, np.full((size, size), RED, dtype=int), *anchors[key])

    try:
        solved = main(inp)
    except Exception:
        return None
    if not np.array_equal(solved, out):
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(MAX_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid b10624e5 D2 input")

            ```

            ### 参考代码: D3/0

            文件: `/home/lixinyu/snap/new/ceshi/code/b10624e5/D3/0/code.py`

            ```python
            # Variant of b10624e5
# Dimension: D3 — 目标对象：其他象限的红色锚块定位 (dst)
# Change: 其他象限中红色锚块的相邻位置作为目标，图案根据锚块尺寸和象限关系进行缩放和反射后放置... → 锚块内部的空洞作为目标槽位

"""
design_analysis:
  variant_goal:
    keep:
      - 四象限布局、十字分隔线、TL 源图案、按象限做左右/上下镜像
      - 缩放仍然由 TL 的 2x2 红锚块作为基准，目标尺度仍取 1..4 档
    change:
      - 原题把缩放后的图案对齐到目标红方块并向外盖章
      - 本变体把非 TL 目标改成 1 像素厚的红色空心框，内部矩形空洞是唯一合法槽位
      - 输出时不再向锚块外部扩展，而是把缩放+镜像后的整块 TL patch 精确塞进空洞 bbox

  concretization_and_trace:
    source_object:
      - TL 仍保留一个包含 2x2 红锚块的单个 4 连通彩色 patch
      - patch bbox 是后续缩放的整体对象；其中红色子块只负责提供尺度基准
    destination_object:
      - 其他三个象限各有一个红色矩形框，框内全是背景色
      - 框内空洞尺寸 == 对应缩放后 patch 的尺寸，因此空洞本身就是 dst
    example_trace:
      - 原逻辑: TR 有 3x3 实心红块，先把 TL patch 左右翻转，再按 3/2 缩放，然后让 patch 中红块覆盖目标红块，剩余像素落在其周围
      - 新逻辑: TR 改成包住一个 6x5 空洞的红框，仍做左右翻转和 3/2 缩放，但现在把 6x5 整个 patch bbox 直接放入空洞左上角；红框只负责提供槽位，不被覆盖
      - 差异: “目标定位点” 从红块相邻区域变成红框内部的矩形洞槽；图案落点从外贴变成内填

  complexity_calibration:
    choices:
      - 空洞保持矩形且四边框厚度固定为 1，避免 cavity 过自由导致匹配分支过多
      - 仍保留 1..4 四档尺度，但只在洞槽能完整容纳时使用
      - 要求 TL patch 对左右/上下翻转至少都不是完全对称，保证反射在人眼上可见
    why_not_simpler:
      - 如果直接把目标改成任意空白矩形而没有红框，人类很难知道哪些空白区是槽位
      - 如果所有目标尺寸都固定或都等于 2，则 D3 的“洞槽约束”存在，但缩放信息会变弱

  implicit_assumption_audit:
    original_main_lines_affected:
      - 原版通过 red 组件 bbox 直接得到目标锚块大小，并把 scaled red bbox 对齐到该方块
      - 该写法隐含前提: 目标红物体是实心方块，而且图案可以落在方块周边
      - 变体后此假设失效，因为非 TL 红物体变成空心框；若仍按原逻辑对齐 red bbox，会把图案错误贴到框外
    new_solver_assumptions:
      - 非 TL 每个象限恰有一个红色 4 连通矩形框
      - 红框内部全是背景，且空洞 bbox 与某个 1..4 尺度的缩放 patch 尺寸唯一匹配
      - TL patch 所在连通块仍是该象限唯一含红色的非背景连通块
    generator_guarantees:
      - 每个非 TL 红框都严格是 1 像素厚矩形边框
      - 只选择会让 scaled patch 完整放进 13x13 象限的尺度
      - 若可行尺度多于 1 个，尽量采样至少两种不同尺度，避免样本退化

  placement_legality:
    - TL patch 完整放在 TL 象限内
    - 每个目标红框完整放在自己的象限内，且框内空洞完整放在象限内
    - 输出时 patch 只写入洞槽内部，不碰分隔线、不越界

  visual_observability:
    - 输入中目标框内是干净空洞，输出中该空洞被完整填入彩色图案，D3 变化一眼可见
    - 通过要求 TL patch 对 LR / UD 都不完全对称，TR / BL / BR 三象限的结果可体现镜像差异
    - 不依赖颜色 id 做排序或变换；颜色只作为图案本身的可见纹理

  neatness:
    - 一个象限只放一个目标框，避免多对象重叠
    - 红框与内部内容分层清楚：边框始终保留，内容始终在框内
"""

import random
import sys
from pathlib import Path

import numpy as np

SOLVER_DIR = Path(__file__).resolve().parents[5] / "solvers"
if str(SOLVER_DIR) not in sys.path:
    sys.path.append(str(SOLVER_DIR))

from arc_utils import bbox_coords, components_mask, get_bg, paste


def _find_dividers(g: np.ndarray, bg: int) -> tuple[int, int]:
    """
    Return the unique full-row/full-col quadrant divider: (mid_row, mid_col).
    """
    h, w = g.shape
    full_rows = [(r, int(g[r, 0])) for r in range(h) if np.all(g[r, :] == g[r, 0]) and int(g[r, 0]) != bg]
    full_cols = [(c, int(g[0, c])) for c in range(w) if np.all(g[:, c] == g[0, c]) and int(g[0, c]) != bg]
    matches = []
    for r, vr in full_rows:
        for c, vc in full_cols:
            if vr == vc:
                matches.append((int(r), int(c)))
    assert len(matches) == 1, "grid must have exactly one matching full-row/full-col divider"
    return matches[0]


def _resize_nn(img: np.ndarray, new_h: int, new_w: int) -> np.ndarray:
    src_h, src_w = img.shape
    assert new_h > 0 and new_w > 0
    rr = np.clip(np.floor(np.arange(new_h) * src_h / new_h).astype(int), 0, src_h - 1)
    cc = np.clip(np.floor(np.arange(new_w) * src_w / new_w).astype(int), 0, src_w - 1)
    return img[rr[:, None], cc[None, :]]


def _reflect_patch(patch: np.ndarray, qb: int, qr: int) -> np.ndarray:
    out = patch
    if qr == 1:
        out = np.fliplr(out)
    if qb == 1:
        out = np.flipud(out)
    return out


def _is_rect_frame(red_patch: np.ndarray, bg: int) -> bool:
    h, w = red_patch.shape
    if h < 3 or w < 3:
        return False
    if not np.all(red_patch[0, :] == 2):
        return False
    if not np.all(red_patch[-1, :] == 2):
        return False
    if not np.all(red_patch[:, 0] == 2):
        return False
    if not np.all(red_patch[:, -1] == 2):
        return False
    return bool(np.all(red_patch[1:-1, 1:-1] == bg))


def main(grid: np.ndarray) -> np.ndarray:
    """
    Replicate the top-left motif into hollow red target frames using scaling and reflection.

    Input structure:
    - A full-row/full-col divider splits the board into four quadrants.
    - The top-left quadrant contains one colored 4-connected motif with a filled 2x2 red anchor inside it.
    - Each other quadrant contains one hollow red rectangular frame whose interior is empty background.

    Rule:
    - Extract the TL motif component and use it as the source patch.
    - For every non-TL quadrant, reflect the source according to quadrant position and scale it by one of the anchor-size ratios 1/2, 1, 3/2, or 2.
    - Choose the unique scale whose resized patch dimensions exactly match the target frame's interior cavity, then place the whole resized patch into that cavity.

    Key insight: The red target no longer marks an external attachment point; its empty interior is the destination slot, and the slot size reveals which scaled mirror of the TL patch must be inserted.
    """
    g = np.asarray(grid, dtype=int)
    out = g.copy()

    bg = int(get_bg(g))
    mid_r, mid_c = _find_dividers(g, bg)

    red_comps = components_mask(g == 2, connectivity=4)
    assert red_comps, "grid must contain red components"

    anchors: dict[tuple[int, int], tuple[int, int, int, int]] = {}
    for pts in red_comps:
        r0, c0, r1, c1 = bbox_coords(pts)
        rr = (r0 + r1) // 2
        cc = (c0 + c1) // 2
        key = (0 if rr < mid_r else 1, 0 if cc < mid_c else 1)
        assert key not in anchors, "each quadrant must contain exactly one red component"
        anchors[key] = (int(r0), int(c0), int(r1), int(c1))

    assert set(anchors) == {(0, 0), (0, 1), (1, 0), (1, 1)}, "need exactly one red component per quadrant"

    sr0, sc0, sr1, sc1 = anchors[(0, 0)]
    sL = max(sr1 - sr0 + 1, sc1 - sc0 + 1)
    assert sL > 0, "top-left red anchor must have positive size"

    tl = g[0:mid_r, 0:mid_c]
    comps = components_mask(tl != bg, connectivity=4)
    patch_bb = None
    for pts in comps:
        if any(tl[r, c] == 2 for r, c in pts):
            patch_bb = bbox_coords(pts)
            break
    assert patch_bb is not None, "top-left quadrant must contain a non-bg component with a red pixel"
    pr0, pc0, pr1, pc1 = patch_bb
    patch = tl[pr0 : pr1 + 1, pc0 : pc1 + 1].copy()

    for (qb, qr), (r0, c0, r1, c1) in anchors.items():
        if (qb, qr) == (0, 0):
            continue

        red_patch = g[r0 : r1 + 1, c0 : c1 + 1]
        assert _is_rect_frame(red_patch, bg), "non-TL red target must be a hollow rectangular frame"
        cavity_h = red_patch.shape[0] - 2
        cavity_w = red_patch.shape[1] - 2

        patch_t = _reflect_patch(patch, qb, qr)
        matches: list[np.ndarray] = []
        for target_size in (1, 2, 3, 4):
            ratio = float(target_size) / float(sL)
            new_h = max(1, int(round(patch_t.shape[0] * ratio)))
            new_w = max(1, int(round(patch_t.shape[1] * ratio)))
            if (new_h, new_w) != (cavity_h, cavity_w):
                continue
            patch_s = _resize_nn(patch_t, new_h, new_w)
            roundtrip = _resize_nn(patch_s, patch_t.shape[0], patch_t.shape[1])
            assert np.array_equal(roundtrip, patch_t), "scaling must preserve motif information"
            matches.append(patch_s)

        assert len(matches) == 1, "target cavity must match exactly one scaled reflected source patch"
        paste(out, matches[0], r0 + 1, c0 + 1)

    return out


# --------------- generator ---------------

BG = 4
DIV = 1
RED = 2
GRID_SIZE = 27
MID = 13
SOURCE_ANCHOR_SIZE = 2
FRAME_THICKNESS = 1
MAX_CAVITY_DIM = 11
TARGET_SIZE_CHOICES = (1, 2, 3, 4)
MAX_RETRIES = 400

QUADS = {
    (0, 0): (0, 12, 0, 12),
    (0, 1): (0, 12, 14, 26),
    (1, 0): (14, 26, 0, 12),
    (1, 1): (14, 26, 14, 26),
}

BLOCK_DIMS = [(2, 2), (2, 3), (3, 2), (3, 3)]
BLOCK_PROB = 0.5
FILL_RATIO_MIN = 0.5
FILL_RATIO_MAX = 0.8
FREEFORM_H_RANGE = (3, 6)
FREEFORM_W_RANGE = (3, 6)
MOTIF_COLORS_MIN = 3
MOTIF_COLORS_MAX = 5
COLOR_POOL = [0, 1, 3, 5, 6, 7, 8, 9]


def _grow_4conn(h: int, w: int, seeds: set[tuple[int, int]], n_fill: int) -> set[tuple[int, int]]:
    filled = set(seeds)
    frontier = set()
    for r, c in seeds:
        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
            nr, nc = r + dr, c + dc
            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in filled:
                frontier.add((nr, nc))
    while len(filled) < n_fill and frontier:
        cell = random.choice(list(frontier))
        frontier.remove(cell)
        filled.add(cell)
        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
            nr, nc = cell[0] + dr, cell[1] + dc
            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in filled:
                frontier.add((nr, nc))
    return filled


def _assign_colors(
    filled: set[tuple[int, int]],
    red_cells: set[tuple[int, int]],
    h: int,
    w: int,
) -> np.ndarray | None:
    rows = {r for r, _ in filled}
    cols = {c for _, c in filled}
    if rows != set(range(h)) or cols != set(range(w)):
        return None

    non_red = [p for p in filled if p not in red_cells]
    random.shuffle(non_red)
    max_colors = min(MOTIF_COLORS_MAX, len(non_red) + 1)
    if max_colors < MOTIF_COLORS_MIN:
        return None

    n_colors = random.randint(MOTIF_COLORS_MIN, max_colors)
    pool = COLOR_POOL[:]
    random.shuffle(pool)
    extras = pool[: n_colors - 1]

    grid = np.full((h, w), BG, dtype=int)
    for r, c in red_cells:
        grid[r, c] = RED
    for i, (r, c) in enumerate(non_red):
        grid[r, c] = extras[i] if i < len(extras) else random.choice(extras)
    return grid


def _source_patch() -> tuple[np.ndarray, int, int] | None:
    s = SOURCE_ANCHOR_SIZE
    use_block = random.random() < BLOCK_PROB
    if use_block:
        lh, lw = random.choice(BLOCK_DIMS)
        n_cells = lh * lw
        min_fill = max(3, int(np.ceil(FILL_RATIO_MIN * n_cells)))
        max_fill = max(min_fill, int(np.floor(FILL_RATIO_MAX * n_cells)))
        ar, ac = random.randrange(lh), random.randrange(lw)
        filled = _grow_4conn(lh, lw, {(ar, ac)}, random.randint(min_fill, max_fill))
        logical = _assign_colors(filled, {(ar, ac)}, lh, lw)
        if logical is None:
            return None
        patch = np.repeat(np.repeat(logical, s, axis=0), s, axis=1)
        return patch, ar * s, ac * s

    h = random.randint(*FREEFORM_H_RANGE)
    w = random.randint(*FREEFORM_W_RANGE)
    ar = random.randint(0, h - s)
    ac = random.randint(0, w - s)
    red_cells = {(ar + dr, ac + dc) for dr in range(s) for dc in range(s)}
    min_fill = max(len(red_cells) + 2, int(np.ceil(FILL_RATIO_MIN * h * w)))
    max_fill = int(np.floor(FILL_RATIO_MAX * h * w))
    if max_fill < min_fill:
        return None
    filled = _grow_4conn(h, w, red_cells, random.randint(min_fill, max_fill))
    patch = _assign_colors(filled, red_cells, h, w)
    if patch is None:
        return None
    return patch, ar, ac


def _feasible_sizes(patch: np.ndarray) -> list[int]:
    ok = []
    for target_size in TARGET_SIZE_CHOICES:
        ratio = target_size / SOURCE_ANCHOR_SIZE
        new_h = max(1, int(round(patch.shape[0] * ratio)))
        new_w = max(1, int(round(patch.shape[1] * ratio)))
        if new_h > MAX_CAVITY_DIM or new_w > MAX_CAVITY_DIM:
            continue
        patch_s = _resize_nn(patch, new_h, new_w)
        roundtrip = _resize_nn(patch_s, patch.shape[0], patch.shape[1])
        if np.array_equal(roundtrip, patch):
            ok.append(int(target_size))
    return ok


def _frame_patch(cavity_h: int, cavity_w: int) -> np.ndarray:
    frame = np.full((cavity_h + 2 * FRAME_THICKNESS, cavity_w + 2 * FRAME_THICKNESS), RED, dtype=int)
    frame[FRAME_THICKNESS:-FRAME_THICKNESS, FRAME_THICKNESS:-FRAME_THICKNESS] = BG
    return frame


def _choose_quad_position(key: tuple[int, int], patch_h: int, patch_w: int) -> tuple[int, int]:
    q_r0, q_r1, q_c0, q_c1 = QUADS[key]
    max_r0 = q_r1 - patch_h + 1
    max_c0 = q_c1 - patch_w + 1
    assert q_r0 <= max_r0 and q_c0 <= max_c0
    return random.randint(q_r0, max_r0), random.randint(q_c0, max_c0)


def _visibly_asymmetric(patch: np.ndarray) -> bool:
    return (not np.array_equal(patch, np.fliplr(patch))) and (not np.array_equal(patch, np.flipud(patch)))


def _choose_target_sizes(feasible: list[int]) -> dict[tuple[int, int], int]:
    keys = [(0, 1), (1, 0), (1, 1)]
    for _ in range(40):
        picks = [random.choice(feasible) for _ in keys]
        if len(feasible) >= 2 and len(set(picks)) < 2:
            continue
        if any(v != SOURCE_ANCHOR_SIZE for v in picks) or len(feasible) == 1:
            return dict(zip(keys, picks, strict=False))
    picks = [random.choice(feasible) for _ in keys]
    return dict(zip(keys, picks, strict=False))


def _gen_attempt() -> tuple[np.ndarray, np.ndarray] | None:
    source = _source_patch()
    if source is None:
        return None
    patch, anchor_r_in_patch, anchor_c_in_patch = source

    if not _visibly_asymmetric(patch):
        return None

    feasible = _feasible_sizes(patch)
    if not feasible:
        return None

    target_sizes = _choose_target_sizes(feasible)
    scaled = {
        key: _resize_nn(
            _reflect_patch(patch, key[0], key[1]),
            max(1, int(round(patch.shape[0] * target_sizes[key] / SOURCE_ANCHOR_SIZE))),
            max(1, int(round(patch.shape[1] * target_sizes[key] / SOURCE_ANCHOR_SIZE))),
        )
        for key in target_sizes
    }

    out = np.full((GRID_SIZE, GRID_SIZE), BG, dtype=int)
    out[MID, :] = DIV
    out[:, MID] = DIV

    tl_r0, tl_c0 = _choose_quad_position((0, 0), patch.shape[0], patch.shape[1])
    paste(out, patch, tl_r0, tl_c0)

    frame_boxes: dict[tuple[int, int], tuple[int, int, int, int]] = {}
    for key, patch_s in scaled.items():
        frame = _frame_patch(*patch_s.shape)
        fr0, fc0 = _choose_quad_position(key, frame.shape[0], frame.shape[1])
        paste(out, frame, fr0, fc0)
        paste(out, patch_s, fr0 + FRAME_THICKNESS, fc0 + FRAME_THICKNESS)
        frame_boxes[key] = (fr0, fc0, frame.shape[0], frame.shape[1])

    inp = out.copy()
    for key, (fr0, fc0, fh, fw) in frame_boxes.items():
        inp[fr0 + FRAME_THICKNESS : fr0 + fh - FRAME_THICKNESS, fc0 + FRAME_THICKNESS : fc0 + fw - FRAME_THICKNESS] = BG

    if inp[tl_r0 + anchor_r_in_patch, tl_c0 + anchor_c_in_patch] != RED:
        return None
    if np.array_equal(main(inp), out):
        return inp, out
    return None


def generate_input() -> np.ndarray:
    for _ in range(MAX_RETRIES):
        result = _gen_attempt()
        if result is not None:
            return result[0]
    raise RuntimeError("failed to generate a valid b10624e5 D3 input")

            ```

