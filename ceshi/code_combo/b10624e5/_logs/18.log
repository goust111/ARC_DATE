   111	def _red_bbox_dims(img: np.ndarray) -> tuple[int, int, int, int]:
   112	    """Return the red bbox as (r0, c0, h, w)."""
   113	    rr, cc = np.where(img == RED)
   114	    assert rr.size > 0, "patch must contain red pixels"
   115	    r0, c0 = int(rr.min()), int(cc.min())
   116	    h = int(rr.max() - rr.min() + 1)
   117	    w = int(cc.max() - cc.min() + 1)
   118	    return r0, c0, h, w
