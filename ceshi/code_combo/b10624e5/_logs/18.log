   131	def _scaled_patch(patch: np.ndarray, qb: int, qr: int, target_h: int, target_w: int) -> np.ndarray:
   132	    """Reflect the source patch and resize it with independent vertical and horizontal factors."""
   133	    patch_t = _reflect_patch(patch, qb, qr)
   134	    new_h = max(1, int(round(patch_t.shape[0] * target_h / SOURCE_ANCHOR_H)))
   135	    new_w = max(1, int(round(patch_t.shape[1] * target_w / SOURCE_ANCHOR_W)))
   136	    patch_s = _resize_nn(patch_t, new_h, new_w)
   137	    roundtrip = _resize_nn(patch_s, patch_t.shape[0], patch_t.shape[1])
   138	    assert np.array_equal(roundtrip, patch_t), "non-uniform scaling must preserve all motif information"
   139	    red_r0, red_c0, red_h, red_w = _red_bbox_dims(patch_s)
   140	    assert (red_h, red_w) == (target_h, target_w), "scaled red anchor must match the target anchor rectangle"
   141	    assert red_r0 >= 0 and red_c0 >= 0
   142	    return patch_s
