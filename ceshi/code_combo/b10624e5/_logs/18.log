   312	        grid[r, c] = extras[i] if i < len(extras) else random.choice(extras)
   313	    return grid
   314	
   315	
   316	def _logical_patch_is_observable(logical: np.ndarray, ar: int, ac: int) -> bool:
   317	    """Reject motifs where mirror and one-axis stretch cues would be too weak."""
   318	    non_red = logical != BG
   319	    same_row = any(non_red[ar, c] and logical[ar, c] != RED for c in range(logical.shape[1]))
   320	    same_col = any(non_red[r, ac] and logical[r, ac] != RED for r in range(logical.shape[0]))
   321	    asym_h = not np.array_equal(logical, np.fliplr(logical))
