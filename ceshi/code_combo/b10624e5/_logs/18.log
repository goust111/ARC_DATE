+    if min(extra_values) < MIN_EXTRA_PER_QUADRANT:
+        return None
+    if sum(v >= MIN_STRONG_EXTRA for v in extra_values) < 2:
+        return None
+    if sum(extra_values) < MIN_TOTAL_EXTRA:
