+SOURCE_ANCHOR_H = 2
+SOURCE_ANCHOR_W = 2
+BLOCK_DIMS = [(2, 2), (2, 3), (3, 2)]
+FILL_RATIO_MIN = 0.5
+FILL_RATIO_MAX = 0.8
