   102	def _resize_nn(img: np.ndarray, new_h: int, new_w: int) -> np.ndarray:
   103	    """Nearest-neighbor resize that supports different row and column target sizes."""
   104	    src_h, src_w = img.shape
   105	    assert new_h > 0 and new_w > 0, "resized patch must stay positive"
   106	    rr = np.clip(np.floor(np.arange(new_h) * src_h / new_h).astype(int), 0, src_h - 1)
   107	    cc = np.clip(np.floor(np.arange(new_w) * src_w / new_w).astype(int), 0, src_w - 1)
   108	    return img[rr[:, None], cc[None, :]]
