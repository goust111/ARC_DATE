   121	def _reflect_patch(patch: np.ndarray, qb: int, qr: int) -> np.ndarray:
   122	    """Apply quadrant-dependent reflections."""
   123	    out = patch
   124	    if qr == 1:
   125	        out = np.fliplr(out)
   126	    if qb == 1:
   127	        out = np.flipud(out)
   128	    return out
