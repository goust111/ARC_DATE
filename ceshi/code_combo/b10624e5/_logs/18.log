   268	def _grow_4conn(h: int, w: int, seeds: set[tuple[int, int]], n_fill: int) -> set[tuple[int, int]]:
   269	    """Grow a 4-connected region from seeds until it has n_fill cells."""
   270	    filled = set(seeds)
   271	    frontier = set()
   272	    for r, c in seeds:
   273	        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
   274	            nr, nc = r + dr, c + dc
   275	            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in filled:
   276	                frontier.add((nr, nc))
   277	    while len(filled) < n_fill and frontier:
   278	        cell = random.choice(list(frontier))
   279	        filled.add(cell)
   280	        frontier.discard(cell)
   281	        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
   282	            nr, nc = cell[0] + dr, cell[1] + dc
   283	            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in filled:
   284	                frontier.add((nr, nc))
   285	    return filled
   286	
   287	
   288	def _assign_colors(
   289	    filled: set[tuple[int, int]],
   290	    red_cells: set[tuple[int, int]],
   291	    h: int,
   292	    w: int,
   293	) -> np.ndarray | None:
   294	    """Assign colors while ensuring every row and column of the bbox is visibly occupied."""
   295	    rows = {r for r, _ in filled}
   296	    cols = {c for _, c in filled}
   297	    if rows != set(range(h)) or cols != set(range(w)):
   298	        return None
   299	    non_red = [p for p in filled if p not in red_cells]
   300	    random.shuffle(non_red)
   301	    max_colors = min(MOTIF_COLORS_MAX, len(non_red) + 1)
   302	    if max_colors < MOTIF_COLORS_MIN:
   303	        return None
   304	    n_colors = random.randint(MOTIF_COLORS_MIN, max_colors)
   305	    pool = COLOR_POOL[:]
   306	    random.shuffle(pool)
   307	    extras = pool[: n_colors - 1]
   308	    grid = np.full((h, w), BG, dtype=int)
   309	    for r, c in red_cells:
   310	        grid[r, c] = RED
