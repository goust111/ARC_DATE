   193	def main(grid: np.ndarray) -> np.ndarray:
   194	    """
   195	    Replicate the top-left motif into the other quadrants, but use rectangular red anchors to drive non-uniform scaling and then tile the result through each target quadrant.
   196	
   197	    Input structure:
   198	    - One full colored row and one full colored column split the grid into four 13x13 quadrants.
   199	    - Every quadrant contains exactly one red anchor block; the TL quadrant shows the full colored motif around its 2x2 red anchor, while the other quadrants show only their red rectangular anchors.
   200	    - The TL motif is a single non-background 4-connected component containing the TL red anchor.
   201	
   202	    Rule:
   203	    - Extract the TL connected motif as the source patch.
   204	    - For each non-TL quadrant, mirror the patch according to quadrant side, resize rows by target_anchor_height / source_anchor_height and columns by target_anchor_width / source_anchor_width, and align the resized red bbox onto the target anchor.
   205	    - Treat that aligned placement as one tile in a rectangular lattice and repeat the transformed patch across the entire target quadrant, clipping at the quadrant border and skipping repeated red pixels.
   206	
   207	    Key insight:
   208	    - Quadrant position still selects the reflection, but the target red anchor now carries two independent scale codes and the transformed patch is not stamped once:
   209	      it becomes a repeating tile whose phase is locked by the anchor.
   210	    """
   211	    g = np.asarray(grid, dtype=int)
   212	    out = g.copy()
   213	
   214	    bg = get_bg(g)
   215	    mid_r, mid_c = _find_dividers(g, bg)
   216	
   217	    red = components_mask(g == RED, connectivity=4)
   218	    assert red, "grid must contain red (color 2) anchor blocks"
   219	
   220	    anchors: dict[tuple[int, int], tuple[int, int, int, int]] = {}
   221	    for pts in red:
   222	        r0, c0, r1, c1 = bbox_coords(pts)
   223	        ah = int(r1 - r0 + 1)
   224	        aw = int(c1 - c0 + 1)
   225	        assert len(pts) == ah * aw, "each anchor must be a filled rectangle"
   226	        rr = (r0 + r1) // 2
   227	        cc = (c0 + c1) // 2
   228	        qb = 0 if rr < mid_r else 1
   229	        qr = 0 if cc < mid_c else 1
   230	        key = (qb, qr)
   231	        assert key not in anchors, "each quadrant must contain exactly one red anchor block"
   232	        anchors[key] = (int(r0), int(c0), ah, aw)
   233	
   234	    assert len(anchors) == 4 and (0, 0) in anchors, "each quadrant must contain exactly one red anchor"
   235	    _, _, source_h, source_w = anchors[(0, 0)]
   236	    assert source_h > 0 and source_w > 0, "top-left red anchor must have positive dimensions"
   237	
   238	    tl = g[0:mid_r, 0:mid_c]
   239	    comps = components_mask(tl != bg, connectivity=4)
   240	    patch_bb = None
   241	    for pts in comps:
   242	        if any(tl[r, c] == RED for r, c in pts):
   243	            r0, c0, r1, c1 = bbox_coords(pts)
   244	            patch_bb = (int(r0), int(c0), int(r1), int(c1))
   245	            break
   246	    assert patch_bb is not None, "top-left quadrant must contain a non-bg component with a red pixel"
   247	
   248	    pr0, pc0, pr1, pc1 = patch_bb
   249	    patch = tl[pr0 : pr1 + 1, pc0 : pc1 + 1].copy()
   250	
   251	    quads = {
   252	        (0, 0): (0, mid_r - 1, 0, mid_c - 1),
   253	        (0, 1): (0, mid_r - 1, mid_c + 1, g.shape[1] - 1),
   254	        (1, 0): (mid_r + 1, g.shape[0] - 1, 0, mid_c - 1),
   255	        (1, 1): (mid_r + 1, g.shape[0] - 1, mid_c + 1, g.shape[1] - 1),
   256	    }
   257	
   258	    for (qb, qr), (tr0, tc0, target_h, target_w) in anchors.items():
   259	        if (qb, qr) == (0, 0):
   260	            continue
   261	        patch_s = _scaled_patch(patch, qb, qr, target_h, target_w)
   262	        q_r0, q_r1, q_c0, q_c1 = quads[(qb, qr)]
   263	        _tile_quadrant(out, patch_s, tr0, tc0, q_r0, q_r1, q_c0, q_c1, bg)
   264	
   265	    return out
