+            "color": int(anchor["color"]),
+            "size": int(anchor["size"]),
+            "anchor_r0": q_r0 + pr0 + int(anchor["r0"]),
+            "anchor_c0": q_c0 + pc0 + int(anchor["c0"]),
+            "is_source": int(np.count_nonzero(patch != bg)) > int(anchor["size"]) * int(anchor["size"]),
+        }
