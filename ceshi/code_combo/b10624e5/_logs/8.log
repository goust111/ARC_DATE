+def _is_asymmetric(arr: np.ndarray) -> bool:
+    return not (
+        np.array_equal(arr, np.fliplr(arr))
+        or np.array_equal(arr, np.flipud(arr))
+        or np.array_equal(arr, np.flipud(np.fliplr(arr)))
