   207	def _grow_4conn(h: int, w: int, seeds: set[tuple[int, int]], n_fill: int) -> set[tuple[int, int]]:
   208	    """Grow a 4-connected region from seeds until it reaches n_fill cells."""
   209	    filled = set(seeds)
   210	    frontier = set()
   211	    for r, c in seeds:
   212	        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
   213	            nr, nc = r + dr, c + dc
   214	            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in filled:
   215	                frontier.add((nr, nc))
   216	    while len(filled) < n_fill and frontier:
   217	        cell = random.choice(list(frontier))
   218	        frontier.discard(cell)
   219	        filled.add(cell)
   220	        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
   221	            nr, nc = cell[0] + dr, cell[1] + dc
