+    p = _reflect_patch(patch, qb, qr)
+    ratio = float(target_size) / float(source_size)
+    new_h = max(1, int(round(p.shape[0] * ratio)))
+    new_w = max(1, int(round(p.shape[1] * ratio)))
+    return _resize_nn(p, new_h, new_w)
