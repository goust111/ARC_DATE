+        (0, 1): (0, mid_r - 1, mid_c + 1, w - 1),
+        (1, 0): (mid_r + 1, h - 1, 0, mid_c - 1),
+        (1, 1): (mid_r + 1, h - 1, mid_c + 1, w - 1),
