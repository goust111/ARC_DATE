+TARGET_SIZES = (2, 4)
+BLOCK_DIMS = [(2, 2), (2, 3), (3, 2), (3, 3)]
+BLOCK_PROB = 0.5
+FILL_RATIO_MIN = 0.5
+FILL_RATIO_MAX = 0.8
+FREEFORM_H_RANGE = (3, 6)
+FREEFORM_W_RANGE = (3, 6)
+MOTIF_COLORS_MIN = 3
+MOTIF_COLORS_MAX = 5
+COLOR_POOL = [0, 5, 6, 7, 9]
+MAX_RETRIES = 500
+MIN_VARIANT_DIFF = 3
