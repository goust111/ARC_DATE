   443	            scan_out, scan_chosen = _scan_ranked_output(inp)
   444	            original_out, original_chosen = _distance_ranked_output(inp)
   445	        except Exception:
   446	            continue
   447	
   448	        if fused_chosen != chosen_fused or scan_chosen != chosen_scan or original_chosen != chosen_original:
   449	            continue
   450	        if fused_chosen == scan_chosen or fused_chosen == original_chosen:
   451	            continue
   452	        if np.array_equal(fused_out, scan_out) or np.array_equal(fused_out, original_out):
   453	            continue
   454	        return inp
   455	    return None
   456	
   457	
   458	def generate_input() -> np.ndarray:
   459	    for _ in range(GEN_RETRIES):
   460	        result = _gen_attempt()
   461	        if result is not None:
   462	            return result
   463	    raise RuntimeError(f"Failed to generate valid input after {GEN_RETRIES} attempts")

