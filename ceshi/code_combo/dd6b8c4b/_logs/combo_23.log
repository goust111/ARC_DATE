+
+        sorting_gap, checker_gap = _variant_metrics(inp)
+        if sorting_gap <= 0 or checker_gap <= 0:
+            return None
+        return inp
+    except Exception:
+        return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        result = _gen_attempt()
+        if result is not None:
