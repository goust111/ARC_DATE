    farthest = {(r, c) for _, r, c in sorted(ordered, key=lambda t: (-t[0], t[1], t[2]))[:moved_count]}
    if nearest == farthest:
        return None

    return {
        "source_cells": source_cells,
        "chosen_far": farthest,
        "cutoff": cutoff,
        "leftover": leftover,
    }


