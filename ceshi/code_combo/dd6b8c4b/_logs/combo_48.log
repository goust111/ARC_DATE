+    return visited
+
+
+def _expected_output(base_grid: np.ndarray, dest_cells: list[tuple[int, int]], reachable_floor: set[tuple[int, int]], distractor_cells: list[tuple[int, int]], k: int) -> np.ndarray:
+    out = base_grid.copy()
