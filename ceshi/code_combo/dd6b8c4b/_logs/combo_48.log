import importlib.util
import numpy as np
from collections import Counter

path='/home/lixinyu/snap/new/ceshi/code_combo/dd6b8c4b/48/code.py'
spec=importlib.util.spec_from_file_location('variant', path)
mod=importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)

def original_like(grid):
    grid=np.asarray(grid,dtype=int)
    out=grid.copy()
    dest_cells=mod._dest_cells()
    dest_set=set(dest_cells)
    dist, _, _ = mod._reachable_info(grid, dest_set)
    maroons=[]
    for r,c in np.argwhere(grid==mod.MAROON):
        d=int(dist[r,c])
        if d < 10**9:
            maroons.append((d,int(r),int(c)))
    maroons.sort()
    k=min(len(dest_cells),len(maroons))
    for _,r,c in maroons[:k]:
        out[r,c]=mod.FLOOR_COLOR
    for r,c in dest_cells[:k]:
        out[r,c]=mod.MAROON
    return out

N=100
trail=[]
blue=[]
untouched=[]
delta=[]
for _ in range(N):
    inp=mod.generate_input()
    out=mod.main(inp)
    base=original_like(inp)
    trail.append(int((out==mod.TRAIL_COLOR).sum()))
    blue.append(int((out==mod.REJECT_COLOR).sum()))
    untouched.append(int((out==mod.FLOOR_COLOR).sum()))
    delta.append(int((out"'!=base).sum()))

for name, vals in [('"'trail', trail), ('blue', blue), ('untouched_floor', untouched), ('delta_vs_original', delta)]:
    vals=np.array(vals)
    print(name, 'min', int(vals.min()), 'max', int(vals.max()), 'mean', round(float(vals.mean()),2))
    cnt=Counter(map(int, vals))
    print(' top_counts', cnt.most_common(8))
