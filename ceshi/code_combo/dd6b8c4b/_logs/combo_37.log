+GRID_H, GRID_W = 11, 11
+FLOOR_COLOR, WALL_COLOR = 7, 6
+DEST_RING = 3
+SOURCE_PALETTE = (1, 4, 8, 9)
+INF = 10**9
+
+TARGET_CENTERS = [(2, 2), (2, 8)]
+TARGET_COUNT = 2
+TARGET_TOKEN_RANGE = (2, 7)
+TOTAL_TOKEN_RANGE = (6, 14)
+GEN_RETRIES = 300
