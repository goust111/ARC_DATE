+    assert queue, "each destination needs at least one adjacent passable cell"
+
+    while queue:
+        r, c = queue.popleft()
+        for rr, cc in neighbors4(r, c):
+            if 0 <= rr < h and 0 <= cc < w and int(dist[rr, cc]) == INF:
+                if int(grid[rr, cc]) in passable:
+                    dist[rr, cc] = int(dist[r, c]) + 1
+                    queue.append((rr, cc))
+
+    return dist
+
