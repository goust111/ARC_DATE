   137	                if int(grid[rr, cc2]) in passable and dist[rr, cc2] == inf:
   138	                    dist[rr, cc2] = d + 1
   139	                    q.append((rr, cc2))
   140	    return dist, starts
   141	
   142	
   143	def _reachable_analysis(
   144	    grid: np.ndarray,
   145	) -> tuple[list[tuple[int, int]], list[tuple[int, int]], int, list[tuple[int, int, int]]]:
   146	    grid = np.asarray(grid, dtype=int)
   147	    h, w = grid.shape
   148	
   149	    centers = np.argwhere(grid == 2)
   150	    assert len(centers) == 1, "grid must have exactly one red (2) center pixel"
   151	    cr, cc = map(int, centers[0])
   152	
