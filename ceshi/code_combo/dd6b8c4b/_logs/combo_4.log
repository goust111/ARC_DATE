   159	    assert starts, "there must be at least one passable cell adjacent to the destination block to begin BFS"
   160	
   161	    inf = 10**9
   162	    maroons = [(int(dist[r, c]), int(r), int(c)) for r, c in np.argwhere(grid == 9)]
   163	    maroons = [t for t in maroons if t[0] < inf]
   164	    return dest_cells, fill_order, floor, maroons
   165	
   166	
   167	def _solve_variant(grid: np.ndarray, *, descending_distance: bool, reverse_fill: bool) -> np.ndarray:
   168	    grid = np.asarray(grid, dtype=int)
   169	    out = grid.copy()
   170	    dest_cells, fill_order, floor, maroons = _reachable_analysis(grid)
   171	
   172	    if descending_distance:
   173	        maroons.sort(key=lambda t: (-t[0], t[1], t[2]))
   174	    else:
   175	        maroons.sort()
   176	
   177	    write_order = fill_order if reverse_fill else dest_cells
   178	    k = min(len(write_order), len(maroons))
   179	    chosen = {(r, c) for _, r, c in maroons[:k]}
   180	
   181	    for r, c in chosen:
   182	        out[r, c] = floor
   183	
