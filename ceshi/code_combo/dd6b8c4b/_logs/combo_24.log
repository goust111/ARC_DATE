+    all_maroons = {(int(r), int(c)) for r, c in np.argwhere(grid == MAROON)}
+    unreachable = all_maroons - reachable_set
+
+    for r, c in unreachable:
+        out[r, c] = FLOOR_COLOR
+
+    k = min(len(dest_cells), len(reachable))
+    for r, c in dest_cells[:k]:
+        out[r, c] = MAROON
+
+    return out
