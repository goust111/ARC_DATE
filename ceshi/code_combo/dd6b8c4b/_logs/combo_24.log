+                if grid[nr, nc] == FLOOR_COLOR and (nr, nc) not in visited:
+                    visited.add((nr, nc))
+                    queue.append((nr, nc))
+    while queue:
+        r, c = queue.popleft()
+        for nr, nc in neighbors4(r, c):
+            if 0 <= nr < GRID_H and 0 <= nc < GRID_W and (nr, nc) not in visited:
+                if grid[nr, nc] == FLOOR_COLOR and (nr, nc) not in dest_set:
+                    visited.add((nr, nc))
+                    queue.append((nr, nc))
+    return visited
+
+
+def _outward_dirs(r: int, c: int) -> list[tuple[int, int]]:
+    dirs = []
+    if r < CENTER_R:
+        dirs.append((-1, 0))
+    if r > CENTER_R:
+        dirs.append((1, 0))
+    if c < CENTER_C:
+        dirs.append((0, -1))
+    if c > CENTER_C:
+        dirs.append((0, 1))
+    return dirs
+
+
+def _extend_arm(
+    wall_cells: set[tuple[int, int]],
+    dest_set: set[tuple[int, int]],
+    r: int,
+    c: int,
+    max_len: int,
+) -> None:
