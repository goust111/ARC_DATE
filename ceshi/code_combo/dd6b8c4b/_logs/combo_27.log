+def _reachable_maroons(grid: np.ndarray, dest_cells: list[tuple[int, int]], dest_set: set[tuple[int, int]], floor: int) -> list[tuple[int, int, int]]:
+    h, w = grid.shape
+    passable = {floor, 9}
+
