+
+    dest_cells = [(r, c) for r in range(bbox[0], bbox[2] + 1) for c in range(bbox[1], bbox[3] + 1)]
+    assert all(int(grid[r, c]) in (2, 3) for r, c in dest_cells), "destination bbox must contain only red/green cells"
