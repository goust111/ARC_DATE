+    chains: dict[str, list[tuple[int, int]]] = {}
+    pockets: list[tuple[int, int]] = []
+
+    for side in open_sides:
+        dr, dc = SIDES[side]
+        rr, rc = _ring_cell_for_side(side)
+        max_len = 0
+        nr, nc = rr, rc
+        while 0 <= nr < GRID_H and 0 <= nc < GRID_W:
+            max_len += 1
+            nr += dr
+            nc += dc
+            if not (0 <= nr < GRID_H and 0 <= nc < GRID_W):
+                max_len -= 1
+                break
