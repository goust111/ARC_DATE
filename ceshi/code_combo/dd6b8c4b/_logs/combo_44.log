+    open_sides = random.sample(list(SIDES), num_ports)
+    chains: dict[str, list[tuple[int, int]]] = {}
+    pockets: list[tuple[int, int]] = []
+
+    for side in open_sides:
+        dr, dc = SIDES[side]
+        rr, rc = _ring_cell_for_side(side)
+        max_len = 0
+        nr, nc = rr, rc
