+
+def _gate_dir(cr: int, cc: int, r: int, c: int) -> tuple[int, int]:
+    dr = r - cr
+    dc = c - cc
+    if abs(dr) >= abs(dc):
+        return (1 if dr > 0 else -1, 0)
+    return (0, 1 if dc > 0 else -1)
+
+
+def _can_start_into(grid: np.ndarray, cr: int, cc: int, src: tuple[int, int], dst: tuple[int, int]) -> bool:
+    r, c = dst
