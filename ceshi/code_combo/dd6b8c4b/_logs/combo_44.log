+
+def _frame_ring(dest_set: set[tuple[int, int]], h: int, w: int) -> list[tuple[int, int]]:
+    ring = set()
+    for r, c in dest_set:
+        for nr, nc in neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in dest_set:
