+
+def _add_ports_and_pockets(
+    grid: np.ndarray,
+    ring_cells: list[tuple[int, int]],
+    dest_set: set[tuple[int, int]],
+) -> tuple[list[str], dict[str, list[tuple[int, int]]], list[tuple[int, int]]]:
+    reserved = set(ring_cells) | set(dest_set)
+    for r, c in ring_cells:
+        grid[r, c] = SOLID_WALL
+
