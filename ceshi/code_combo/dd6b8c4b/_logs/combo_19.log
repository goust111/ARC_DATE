+    collected = _collect_positions(grid)
+    one_shot = _one_shot_positions(grid)
+    if not (4 <= len(collected) <= 9):
+        return None
+    if len(one_shot) < 2:
+        return None
+    if len(collected) <= len(one_shot):
+        return None
+
+    expected = _paint_output(grid, collected)
+    try:
+        result = main(grid)
+    except Exception:
+        return None
+    if not np.array_equal(result, expected):
+        return None
+    return grid
