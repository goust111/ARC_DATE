+        {"path": [(3, 5), (2, 5), (1, 5), (1, 4), (1, 3)], "room": [(0, 3), (1, 2)]},
+        {"path": [(3, 5), (2, 5), (1, 5), (1, 6), (1, 7)], "room": [(0, 7), (1, 8)]},
