+    dist = np.full((h, w), -1, dtype=int)
+    q = deque()
+    for r, c in dest_cells:
+        for nr, nc in neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in dest_set and g[nr, nc] in (FLOOR, MAROON) and dist[nr, nc] < 0:
