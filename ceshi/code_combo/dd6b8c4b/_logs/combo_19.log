+        {"path": [(5, 7), (5, 8), (4, 8), (3, 8), (2, 8), (1, 8)], "room": [(0, 8), (1, 9)]},
+        {"path": [(5, 7), (5, 8), (6, 8), (7, 8), (8, 8), (9, 8)], "room": [(10, 8), (9, 9)]},
+    ],
