    floor = mod._floor_color(inp)
    dist = mod._reachable_distances(inp, dest_cells, {floor, mod.MAROON})
    maroons = [(int(dist[r, c]), int(r), int(c)) for r, c in np.argwhere(inp == mod.MAROON)]
