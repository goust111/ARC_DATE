   132	
   133	WALL_PROB = 0.75
   134	BARRIER_GAP_RANGE = (1, 4)
   135	WALL_STYLES = ("arms", "frame", "mixed")
   136	
   137	ARM_EXTEND_PROB = 0.45
   138	ARM_LENGTH_RANGE = (1, 3)
   139	FRAME_CONNECT_PROB = 0.4
   140	FRAME_GAP_REMOVE_PROB = 0.3
   141	MIXED_EXTEND_PROB = 0.65
   142	
   143	DISTRACTOR_MAX = 6
   144	OVERFLOW_PROB = 0.65
   145	MAX_OVERFLOW_COUNT = 6
   146	PARTIAL_EMPTY_MARGIN = 2
   147	MIN_SOURCE_COUNT = {4: 6, 5: 8}
   148	MIN_REACHABLE_SOURCE_CELLS = {4: 18, 5: 24}
   149	GEN_RETRIES = 500
   150	
   151	
   152	def _perimeter_path(top: int, left: int, height: int, width: int) -> list[tuple[int, int]]:
   153	    """Clockwise perimeter path starting at the top-left corner."""
   154	    if height <= 0 or width <= 0:
   155	        return []
   156	    bottom = top + height - 1
   157	    right = left + width - 1
   158	    cells: list[tuple[int, int]] = []
   159	
   160	    for c in range(left, right + 1):
   161	        cells.append((top, c))
   162	    for r in range(top + 1, bottom + 1):
   163	        cells.append((r, right))
   164	    if bottom > top:
   165	        for c in range(right - 1, left - 1, -1):
   166	            cells.append((bottom, c))
   167	    if right > left:
   168	        for r in range(bottom - 1, top, -1):
   169	            cells.append((r, left))
   170	
   171	    return [(r, c) for r, c in cells if 0 <= r < GRID_H and 0 <= c < GRID_W]
   172	
   173	
   174	def _square_spiral_path(top: int, left: int, size: int) -> list[tuple[int, int]]:
   175	    """Clockwise inward spiral for a square, starting at its top-left corner."""
   176	    path: list[tuple[int, int]] = []
   177	    r0, c0 = top, left
   178	    r1, c1 = top + size - 1, left + size - 1
   179	
   180	    while r0 <= r1 and c0 <= c1:
   181	        for c in range(c0, c1 + 1):
   182	            path.append((r0, c))
   183	        for r in range(r0 + 1, r1 + 1):
   184	            path.append((r, c1))
   185	        if r0 < r1:
   186	            for c in range(c1 - 1, c0 - 1, -1):
   187	                path.append((r1, c))
   188	        if c0 < c1:
   189	            for r in range(r1 - 1, r0, -1):
   190	                path.append((r, c0))
   191	        r0 += 1
   192	        c0 += 1
   193	        r1 -= 1
   194	        c1 -= 1
   195	
   196	    return path
   197	
   198	
   199	def _destination_cells(size: int) -> list[tuple[int, int]]:
   200	    return [
   201	        (r, c)
   202	        for r in range(DEST_TOP, DEST_TOP + size)
   203	        for c in range(DEST_LEFT, DEST_LEFT + size)
   204	    ]
   205	
   206	
   207	def _spill_path(top: int, left: int, size: int) -> list[tuple[int, int]]:
   208	    return _perimeter_path(top - 1, left - 1, size + 2, size + 2)
   209	
   210	
   211	def _barrier_ring(top: int, left: int, size: int) -> list[tuple[int, int]]:
   212	    return _perimeter_path(top - 2, left - 2, size + 4, size + 4)
   213	
   214	
   215	def _find_destination(grid: np.ndarray) -> tuple[int, int, int, list[tuple[int, int]]]:
   216	    coords = np.argwhere(np.isin(grid, [RED_ANCHOR, DEST_COLOR]))
   217	    assert len(coords) > 0, "grid must contain a red/green destination square"
   218	
   219	    red_coords = np.argwhere(grid == RED_ANCHOR)
   220	    assert len(red_coords) == 1, "grid must contain exactly one red anchor"
   221	    rr, rc = map(int, red_coords[0])
   222	
   223	    r0, c0 = coords.min(axis=0)
   224	    r1, c1 = coords.max(axis=0)
   225	    r0, c0, r1, c1 = map(int, (r0, c0, r1, c1))
   226	    height = r1 - r0 + 1
   227	    width = c1 - c0 + 1
   228	    assert height == width, "destination must be a square"
   229	    assert (rr, rc) == (r0, c0), "red anchor must mark the square's top-left corner"
   230	
   231	    dest_cells = [(r, c) for r in range(r0, r1 + 1) for c in range(c0, c1 + 1)]
   232	    assert len(coords) == len(dest_cells), "destination square must be solid"
   233	    for r, c in dest_cells:
   234	        assert int(grid[r, c]) in (RED_ANCHOR, DEST_COLOR), "destination square must be solid"
   235	
   236	    return r0, c0, height, dest_cells
   237	
   238	
   239	def _floor_color(grid: np.ndarray) -> int:
   240	    colors = [int(x) for x in np.unique(grid) if int(x) not in (RED_ANCHOR, DEST_COLOR, MAROON)]
   241	    assert colors, "grid must contain at least one non-destination background color"
   242	    return max(colors, key=lambda color: int((grid == color).sum()))
   243	
   244	
   245	def _reachable_distances(
   246	    grid: np.ndarray,
   247	    dest_cells: list[tuple[int, int]],
   248	    passable: set[int],
   249	) -> np.ndarray:
   250	    h, w = grid.shape
   251	    dest_set = set(dest_cells)
   252	
   253	    starts: list[tuple[int, int]] = []
   254	    seen: set[tuple[int, int]] = set()
   255	    for r, c in dest_cells:
   256	        for nr, nc in neighbors4(r, c):
   257	            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in dest_set and int(grid[nr, nc]) in passable:
   258	                if (nr, nc) not in seen:
   259	                    seen.add((nr, nc))
   260	                    starts.append((nr, nc))
   261	    assert starts, "there must be at least one passable cell touching the destination square"
   262	
   263	    inf = 10**9
   264	    dist = np.full((h, w), inf, dtype=int)
   265	    q: deque[tuple[int, int]] = deque(starts)
   266	    for r, c in starts:
   267	        dist[r, c] = 0
   268	
   269	    while q:
   270	        r, c = q.popleft()
   271	        for nr, nc in neighbors4(r, c):
   272	            if 0 <= nr < h and 0 <= nc < w and int(grid[nr, nc]) in passable and dist[nr, nc] == inf:
   273	                dist[nr, nc] = dist[r, c] + 1
   274	                q.append((nr, nc))
   275	    return dist
   276	
   277	
   278	def main(grid: np.ndarray) -> np.ndarray:
   279	    """
   280	    Move the closest reachable maroon pixels into a variable-size square, and spill any excess onto the square's outer ring.
   281	
   282	    Input structure:
   283	    - Orange floor cells may be partitioned by magenta walls, with maroon tokens scattered on reachable and unreachable floor.
   284	    - The target is one solid red/green square: the unique red cell is its top-left anchor, and the square side length varies.
   285	
   286	    Rule:
   287	    - Flood-fill from passable cells touching the square, traversing only floor and maroon cells, then rank reachable maroons by BFS distance, row, and column.
   288	    - Fill the square first along a clockwise inward spiral. If more ranked maroons remain after the square is full, continue by placing them on the one-cell-thick ring immediately outside the square in clockwise perimeter order.
   289	    - Every moved maroon is erased from its source cell back to floor; unreachable maroons and any maroons beyond the supported spill ring remain in place.
   290	
   291	    Key insight:
   292	    - The solver must recover both the square size and the two-stage write geometry. The square size sets the internal capacity, while overflow activates a second visible path just outside the square instead of leaving extra reachable maroons on the floor.
   293	    """
   294	
   295	    grid = np.asarray(grid, dtype=int)
   296	    out = grid.copy()
   297	
   298	    top, left, size, dest_cells = _find_destination(grid)
   299	    fill_path = _square_spiral_path(top, left, size)
   300	    spill_order = _spill_path(top, left, size)
   301	    floor = _floor_color(grid)
   302	    passable = {floor, MAROON}
   303	
   304	    dist = _reachable_distances(grid, dest_cells, passable)
   305	    reachable_maroons = [(int(dist[r, c]), int(r), int(c)) for r, c in np.argwhere(grid == MAROON)]
   306	    reachable_maroons = [item for item in reachable_maroons if item[0] < 10**9]
   307	    reachable_maroons.sort()
   308	
   309	    inner_count = min(len(fill_path), len(reachable_maroons))
   310	    overflow_count = min(len(spill_order), max(0, len(reachable_maroons) - inner_count))
   311	    moved_total = inner_count + overflow_count
   312	    chosen = {(r, c) for _, r, c in reachable_maroons[:moved_total]}
   313	
   314	    for r, c in chosen:
   315	        out[r, c] = floor
   316	    for r, c in fill_path[:inner_count]:
   317	        out[r, c] = MAROON
   318	    for r, c in spill_order[:overflow_count]:
   319	        out[r, c] = MAROON
   320	
   321	    return out
   322	
   323	
   324	def _outward_dirs(r: int, c: int, top: int, left: int, size: int) -> list[tuple[int, int]]:
   325	    center_r = top + (size - 1) / 2.0
   326	    center_c = left + (size - 1) / 2.0
   327	    dirs: list[tuple[int, int]] = []
   328	    if r < center_r:
   329	        dirs.append((-1, 0))
   330	    if r > center_r:
   331	        dirs.append((1, 0))
   332	    if c < center_c:
   333	        dirs.append((0, -1))
   334	    if c > center_c:
   335	        dirs.append((0, 1))
   336	    return dirs
   337	
   338	
   339	def _extend_arm(
   340	    wall_cells: set[tuple[int, int]],
   341	    reserved: set[tuple[int, int]],
   342	    top: int,
   343	    left: int,
   344	    size: int,
   345	    r: int,
   346	    c: int,
   347	    max_len: int,
   348	) -> None:
   349	    dirs = _outward_dirs(r, c, top, left, size)
   350	    if not dirs:
   351	        return
   352	    dr, dc = random.choice(dirs)
   353	    nr, nc = r, c
   354	    for _ in range(random.randint(1, max_len)):
   355	        nr += dr
   356	        nc += dc
   357	        if 0 <= nr < GRID_H and 0 <= nc < GRID_W and (nr, nc) not in reserved:
   358	            wall_cells.add((nr, nc))
   359	        else:
   360	            break

