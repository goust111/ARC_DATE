+
+def _add_extra_solid_bars(grid: np.ndarray, dest_set: set[tuple[int, int]]) -> None:
+    for _ in range(random.randint(*EXTRA_SOLID_BARS_RANGE)):
+        horizontal = random.random() < 0.5
+        length = random.randint(*EXTRA_SOLID_BAR_LEN)
