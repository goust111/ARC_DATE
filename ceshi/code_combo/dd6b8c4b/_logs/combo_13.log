   238	    dirs = []
   239	    if r < CENTER_R:
   240	        dirs.append((-1, 0))
   241	    if r > CENTER_R:
   242	        dirs.append((1, 0))
   243	    if c < CENTER_C:
   244	        dirs.append((0, -1))
   245	    if c > CENTER_C:
   246	        dirs.append((0, 1))
   247	    return dirs
