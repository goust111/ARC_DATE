   177	    out = grid.copy()
   178	    maroons = [(int(dist[r, c]), int(r), int(c)) for r, c in np.argwhere(grid == MAROON)]
   179	    maroons = [item for item in maroons if item[0] < INF]
   180	    maroons.sort()
   181	    k = min(len(dest_cells), len(maroons))
   182	    chosen = {(r, c) for _, r, c in maroons[:k]}
