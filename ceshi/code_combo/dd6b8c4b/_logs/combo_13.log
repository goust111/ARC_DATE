   122	def _directed_dist(grid: np.ndarray, dest_cells: list[tuple[int, int]]) -> np.ndarray:
   123	    h, w = grid.shape
   124	    dest_set = set(dest_cells)
   125	    dist = np.full((h, w), INF, dtype=int)
   126	    q = deque()
   127	    seen = set()
   128	    for r, c in dest_cells:
