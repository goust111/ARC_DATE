   285	
   286	def _add_extra_solid_bars(grid: np.ndarray, dest_set: set[tuple[int, int]]) -> None:
   287	    for _ in range(random.randint(*EXTRA_SOLID_BARS_RANGE)):
   288	        horizontal = random.random() < 0.5
   289	        length = random.randint(*EXTRA_SOLID_BAR_LEN)
   290	        if horizontal:
   291	            r = random.choice([rr for rr in range(GRID_H) if abs(rr - CENTER_R) >= 2])
   292	            c0 = random.randint(0, GRID_W - length)
   293	            for c in range(c0, c0 + length):
   294	                if (r, c) not in dest_set and int(grid[r, c]) != VERT_GATE:
   295	                    grid[r, c] = SOLID_WALL
   296	        else:
   297	            c = random.choice([cc for cc in range(GRID_W) if abs(cc - CENTER_C) >= 2])
   298	            r0 = random.randint(0, GRID_H - length)
   299	            for r in range(r0, r0 + length):
   300	                if (r, c) not in dest_set and int(grid[r, c]) != VERT_GATE:
   301	                    grid[r, c] = SOLID_WALL
