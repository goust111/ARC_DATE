   219	    grid = np.asarray(grid, dtype=int)
   220	    h, w = grid.shape
   221	    centers = np.argwhere(grid == RED_CENTER)
   222	    assert len(centers) == 1, "grid must contain exactly one red center"
   223	    cr, cc = map(int, centers[0])
   224	    dest_cells = _dest_cells_around(cr, cc, h, w)
   225	    dist = _directed_dist(grid, dest_cells)
   226	    out, _, _ = _apply_with_dist(grid, dist, dest_cells)
   227	    return out
