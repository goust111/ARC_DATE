   251	    up = random.randint(*BLUE_SPAN_RANGE)
   252	    down = random.randint(*BLUE_SPAN_RANGE)
   253	    for rr in range(r - up, r + down + 1):
   254	        if 0 <= rr < GRID_H and (rr, c) not in dest_set and int(grid[rr, c]) != SOLID_WALL:
   255	            grid[rr, c] = VERT_GATE
