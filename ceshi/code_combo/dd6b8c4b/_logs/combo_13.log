+def _paint_background(grid: np.ndarray, dest_set: set[tuple[int, int]]) -> None:
+    for r in range(GRID_H):
+        for c in range(GRID_W):
+            if (r, c) not in dest_set:
+                grid[r, c] = _base_floor_at(r, c)
