+def _add_extra_blue_columns(grid: np.ndarray, dest_set: set[tuple[int, int]]) -> None:
+    cols = [c for c in range(GRID_W) if c not in (CENTER_C - 1, CENTER_C, CENTER_C + 1)]
+    random.shuffle(cols)
