+) -> tuple[list[tuple[int, int]], list[tuple[int, int]], np.ndarray] | None:
+    background_cells = {
+        (r, c)
+        for r in range(GRID_H)
+        for c in range(GRID_W)
+        if int(grid[r, c]) in (H_FLOOR, V_FLOOR)
+    }
