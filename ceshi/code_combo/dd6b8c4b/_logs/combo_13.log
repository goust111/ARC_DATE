   275	def _add_extra_blue_columns(grid: np.ndarray, dest_set: set[tuple[int, int]]) -> None:
   276	    cols = [c for c in range(GRID_W) if c not in (CENTER_C - 1, CENTER_C, CENTER_C + 1)]
   277	    random.shuffle(cols)
   278	    for c in cols[: random.randint(*EXTRA_BLUE_COLS_RANGE)]:
   279	        top = random.randint(0, GRID_H - 3)
   280	        bottom = random.randint(top + 1, min(GRID_H - 1, top + 5))
   281	        for r in range(top, bottom + 1):
   282	            if (r, c) not in dest_set and int(grid[r, c]) != SOLID_WALL:
   283	                grid[r, c] = VERT_GATE
