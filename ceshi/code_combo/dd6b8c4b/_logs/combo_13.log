   304	def _build_barriers(grid: np.ndarray, dest_set: set[tuple[int, int]]) -> None:
   305	    ring = _ring_cells(dest_set)
   306	    top_bottom = [(r, c) for r, c in ring if r in (CENTER_R - 2, CENTER_R + 2)]
   307	    left_right = [(r, c) for r, c in ring if c in (CENTER_C - 2, CENTER_C + 2)]
   308	
   309	    openings = {
   310	        random.choice(top_bottom),
   311	        random.choice(left_right),
   312	    }
   313	    ring_left = [cell for cell in ring if cell not in openings]
   314	    extra_openings = random.randint(RING_OPEN_RANGE[0] - len(openings), RING_OPEN_RANGE[1] - len(openings))
   315	    if extra_openings > 0:
   316	        openings.update(random.sample(ring_left, extra_openings))
   317	    ring_left = [cell for cell in ring if cell not in openings]
   318	
   319	    blue_count = random.randint(BLUE_RING_RANGE[0], min(BLUE_RING_RANGE[1], len(ring_left) - 1))
   320	    blue_ring = set(random.sample(ring_left, blue_count))

