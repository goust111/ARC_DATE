+
+def _sorted_cells(cells: set[tuple[int, int]], dist: np.ndarray) -> list[tuple[int, int]]:
+    return sorted(cells, key=lambda rc: (int(dist[rc[0], rc[1]]), rc[0], rc[1]))
+
+
+def _select_tokens(
+    grid: np.ndarray,
+    dest_cells: list[tuple[int, int]],
+    directed: np.ndarray,
