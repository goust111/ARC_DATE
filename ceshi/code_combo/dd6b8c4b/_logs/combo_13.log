   259	    dirs = _outward_dirs(r, c)
   260	    if not dirs:
   261	        return
   262	    dr, dc = random.choice(dirs)
   263	    length = random.randint(*SOLID_ARM_RANGE)
   264	    nr, nc = r, c
   265	    for _ in range(length):
   266	        nr += dr
   267	        nc += dc
   268	        if not (0 <= nr < GRID_H and 0 <= nc < GRID_W) or (nr, nc) in dest_set:
   269	            break
   270	        if int(grid[nr, nc]) == VERT_GATE:
   271	            break
   272	        grid[nr, nc] = SOLID_WALL
   273	
