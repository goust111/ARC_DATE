        (5, 3),
        (6, 2),
        [(7, 1), (7, 2)],
        (8, 8),
        [(8, 9), (9, 9)],
        {(4, 8), (5, 8), (6, 8), (2, 2), (2, 4), (2, 6), (2, 8)},
    )
    add_route(
        "wide_right_top",
        "wide",
        (5, 7),
        (4, 8),
        [(3, 8), (3, 9)],
        (2, 2),
        [(1, 1), (2, 1)],
        {(4, 2), (5, 2), (6, 2), (8, 2), (8, 4), (8, 6), (8, 8)},
    )
    add_route(
        "wide_right_bottom",
        "wide",
