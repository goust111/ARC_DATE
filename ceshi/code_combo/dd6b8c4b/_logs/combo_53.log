+    banned = {route["opening"], route["shell1"], route["shell2"], *route["gate2"], *route["gate3"]}
+    pool = [cell for cell in route["outer_pool"] if cell not in banned]
+    count = random.randint(*OUTER_COUNT_RANGE)
