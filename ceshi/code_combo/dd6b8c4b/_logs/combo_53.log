+    if _inside(box2, cell) and not _inside(BOX1, cell):
+        return 1
+    if _inside(box3, cell) and not _inside(box2, cell):
+        return 2
+    if not _inside(box3, cell):
+        return 3
+    return 0
+
+
+def _detect_route(grid: np.ndarray, wall: int) -> dict:
