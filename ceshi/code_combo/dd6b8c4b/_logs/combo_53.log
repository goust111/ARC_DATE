GRID_H, GRID_W = 11, 11
CENTER_R, CENTER_C = 5, 5
FLOOR_COLOR, WALL_COLOR = 7, 6
DEST_COLOR, RED_CENTER = 3, 2
MAROON = 9

FILL_K_RANGE = (10, 13)
TOTAL_MAROON_RANGE = (4, 16)
DISTRACTOR_MAX = 6
GEN_RETRIES = 400

FRAME_TEMPLATES = [
    {
        "name": "two_square",
        "boxes": [(3, 3, 7, 7), (1, 1, 9, 9)],
        "outer_sides": ("top", "bottom", "left", "right"),
        "weight": 1,
    },
    {
