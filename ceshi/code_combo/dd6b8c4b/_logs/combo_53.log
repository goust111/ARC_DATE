+            {
+                "name": name,
+                "orientation": orientation,
+                "boxes": (BOX1, BOX2_WIDE if orientation == "wide" else BOX2_TALL, BOX3),
+                "opening": opening,
+                "shell1": shell1,
+                "gate2": tuple(gate2),
+                "shell2": shell2,
+                "gate3": tuple(gate3),
+                "distractors": tuple(sorted(distractors)),
+                "outer_pool": tuple(OUTSIDE_CELLS),
+            }
+        )
+
+    add_route(
+        "wide_left_top",
+        "wide",
+        (5, 3),
+        (4, 2),
+        [(3, 1), (3, 2)],
+        (2, 8),
+        [(1, 9), (2, 9)],
+        {(4, 8), (5, 8), (6, 8), (8, 2), (8, 4), (8, 6), (8, 8)},
+    )
+    add_route(
+        "wide_left_bottom",
+        "wide",
+        (5, 3),
+        (6, 2),
+        [(7, 1), (7, 2)],
+        (8, 8),
+        [(8, 9), (9, 9)],
+        {(4, 8), (5, 8), (6, 8), (2, 2), (2, 4), (2, 6), (2, 8)},
+    )
+    add_route(
+        "wide_right_top",
+        "wide",
+        (5, 7),
+        (4, 8),
+        [(3, 8), (3, 9)],
+        (2, 2),
+        [(1, 1), (2, 1)],
+        {(4, 2), (5, 2), (6, 2), (8, 2), (8, 4), (8, 6), (8, 8)},
+    )
+    add_route(
+        "wide_right_bottom",
+        "wide",
+        (5, 7),
+        (6, 8),
+        [(7, 8), (7, 9)],
+        (8, 2),
+        [(8, 1), (9, 1)],
+        {(4, 2), (5, 2), (6, 2), (2, 2), (2, 4), (2, 6), (2, 8)},
+    )
+    add_route(
+        "tall_top_left",
+        "tall",
+        (3, 5),
+        (2, 4),
+        [(1, 3), (2, 3)],
+        (8, 2),
+        [(9, 1), (9, 2)],
+        {(8, 4), (8, 5), (8, 6), (2, 8), (4, 8), (6, 8), (8, 8)},
+    )
+    add_route(
+        "tall_top_right",
+        "tall",
+        (3, 5),
+        (2, 6),
+        [(1, 7), (2, 7)],
+        (8, 8),
+        [(9, 8), (9, 9)],
+        {(8, 4), (8, 5), (8, 6), (2, 2), (4, 2), (6, 2), (8, 2)},
+    )
+    add_route(
+        "tall_bottom_left",
+        "tall",
+        (7, 5),
+        (8, 4),
+        [(8, 3), (9, 3)],
+        (2, 2),
+        [(1, 1), (1, 2)],
+        {(2, 4), (2, 5), (2, 6), (2, 8), (4, 8), (6, 8), (8, 8)},
+    )
+    add_route(
+        "tall_bottom_right",
+        "tall",
+        (7, 5),
+        (8, 6),
+        [(8, 7), (9, 7)],
+        (2, 8),
+        [(1, 8), (1, 9)],
