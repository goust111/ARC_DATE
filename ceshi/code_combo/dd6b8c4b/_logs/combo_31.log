+
+GRID_H, GRID_W = 11, 11
+FLOOR_COLOR, WALL_COLOR = 7, 6
+DEST_COLOR, RED_CENTER = 3, 2
+MAROON = 9
+INF = 10**9
+
+CENTER_PAIRS = [
+    [(1, 1), (9, 9)],
+    [(1, 9), (9, 1)],
+]
+FRAME_BOX = (4, 4, 6, 6)  # inclusive bbox of the detached 3x3 frame
