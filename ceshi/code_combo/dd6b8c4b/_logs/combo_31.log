+    strict_owner_maroons = [0 for _ in containers]
+    for r, c in np.argwhere(grid == MAROON):
+        r, c = int(r), int(c)
+        reaches = []
+        for idx in range(len(containers)):
+            d = int(dists[idx][r, c])
+            if d < INF:
+                reaches.append((d, idx))
