+    floor = _infer_floor(grid)
+    passable = {floor, MAROON}
+    containers = [(center, _dest_cells(center), set(_dest_cells(center))) for center in centers]
+    dists = [_bfs_distance(grid, dest_set, passable) for _, _, dest_set in containers]
+
