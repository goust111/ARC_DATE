+def _dest_cells(center: tuple[int, int], h: int = GRID_H, w: int = GRID_W) -> list[tuple[int, int]]:
+    cr, cc = center
+    cells = []
+    for r in range(cr - 1, cr + 2):
+        for c in range(cc - 1, cc + 2):
+            if 0 <= r < h and 0 <= c < w:
+                cells.append((r, c))
