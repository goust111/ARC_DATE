+
+
+def _pick_sources(owner_buckets, private_buckets, contested_buckets):
+    fill_counts = []
+    for bucket in owner_buckets:
+        hi = min(FILL_RANGE_PER_CONTAINER[1], len(bucket))
+        if hi < FILL_RANGE_PER_CONTAINER[0]:
