+                cur = (nr, nc)
+                facing = nd
+                path.append(cur)
+                moved = True
+                break
+        if not moved:
+            break
+
+    return path, False
+
+
+def _unique_in_order(path: list[tuple[int, int]]) -> list[tuple[int, int]]:
+    out = []
+    seen = set()
+    for cell in path:
+        if cell not in seen:
+            seen.add(cell)
+            out.append(cell)
+    return out
+
+
