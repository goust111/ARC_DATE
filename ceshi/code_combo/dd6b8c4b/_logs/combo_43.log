+    h, w = grid.shape
+    r0, c0, r1, c1 = frame_bbox
+    inf = int(dist.max())
+    records: list[tuple[int, int, int]] = []
+
+    for r, c in np.argwhere(grid == MARKER_COLOR):
+        r, c = int(r), int(c)
+        if not (r in (r0, r1) or c in (c0, c1)):
+            continue
