+    grid[FRAME_R1, FRAME_C0 : FRAME_C1 + 1] = WALL_COLOR
+    grid[FRAME_R0 : FRAME_R1 + 1, FRAME_C0] = WALL_COLOR
+    grid[FRAME_R0 : FRAME_R1 + 1, FRAME_C1] = WALL_COLOR
