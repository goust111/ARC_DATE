    for r, c in chosen:
        out[r, c] = mod.FLOOR_COLOR
    for r, c in dest_cells[:k]:
        out[r, c] = mod.MARKER_COLOR
    return out

samples = 200
diff = 0
marker_on_border = []
reachable_counts = []
open_side_counts = []
closed_marker_counts = []
side_gate_scores = []

for _ in range(samples):
    grid = mod.generate_input()
    new_out = mod.main(grid)
    old_out = old_style_baseline(grid)
    diff += int(not np.array_equal(new_out, old_out))

    bbox = mod._find_frame_bbox(grid)
    dist = mod._distance_from_dest(grid, set(mod._dest_cells(*grid.shape, mod.CENTER_R, mod.CENTER_C)))
    reachable = {(r, c) for _d, r, c in mod._reachable_markers(grid, dist, bbox)}
    reachable_counts.append(len(reachable))

    r0, c0, r1, c1 = bbox
    side_cells = mod._side_cells(r0, c0, r1, c1)
    open_sides = set()
    for side, cells in side_cells.items():
        if any(grid[r, c] == mod.FLOOR_COLOR for r, c in cells):
            open_sides.add(side)
    open_side_counts.append(len(open_sides))

