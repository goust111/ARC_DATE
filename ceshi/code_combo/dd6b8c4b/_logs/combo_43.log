import importlib.util
import numpy as np
from collections import Counter

path = '/home/lixinyu/snap/new/ceshi/code_combo/dd6b8c4b/43/code.py'
spec = importlib.util.spec_from_file_location('variant', path)
mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)

def old_style_baseline(grid):
    grid = np.asarray(grid, dtype=int)
    h, w = grid.shape
    out = grid.copy()
    centers = np.argwhere(grid == mod.RED_CENTER)
    cr, cc = map(int, centers[0])
    dest_cells = mod._dest_cells(h, w, cr, cc)
    dest_set = set(dest_cells)
    inf = h * w + 10
    dist = np.full((h, w), inf, dtype=int)
    q = []
    seen = set()
    for r, c in dest_cells:
        for rr, cc2 in mod.neighbors4(r, c):
            if 0 <= rr < h and 0 <= cc2 < w and grid[rr, cc2] in (mod.FLOOR_COLOR, mod.MARKER_COLOR):
                if (rr, cc2) not in seen:
                    seen.add((rr, cc2))
                    dist[rr, cc2] = 0
                    q.append((rr, cc2))
    qi = 0
    while qi < len(q):
        r, c = q[qi]
        qi += 1
        for rr, cc2 in mod.neighbors4(r, c):
            if 0 <= rr < h and 0 <= cc2 < w and grid[rr, cc2] in (mod.FLOOR_COLOR, mod.MARKER_COLOR) and dist[rr, cc2] == inf:
                dist[rr, cc2] = dist[r, c] + 1
                q.append((rr, cc2))
    maroons = [(int(dist[r, c]), int(r), int(c)) for r, c in np.argwhere(grid == mod.MARKER_COLOR)]
    maroons = [t for t in maroons if t[0] < inf]
    maroons.sort()
    k = min(len(dest_cells), len(maroons))
    chosen = {(r, c) for _, r, c in maroons[:k]}
    for r, c in chosen:
        out[r, c] = mod.FLOOR_COLOR
    for r, c in dest_cells[:k]:
        out[r, c] = mod.MARKER_COLOR
    return out

samples = 200
diff = 0
marker_on_border = []
reachable_counts = []
open_side_counts = []
closed_marker_counts = []
side_gate_scores = []

for _ in range(samples):
    grid = mod.generate_input()
    new_out = mod.main(grid)
    old_out = old_style_baseline(grid)
    diff += int(not np.array_equal(new_out, old_out))

    bbox = mod._find_frame_bbox(grid)
    dist = mod._distance_from_dest(grid, set(mod._dest_cells(*grid.shape, mod.CENTER_R, mod.CENTER_C)))
    reachable = {(r, c) for _d, r, c in mod._reachable_markers(grid, dist, bbox)}
    reachable_counts.append(len(reachable))

    r0, c0, r1, c1 = bbox
    side_cells = mod._side_cells(r0, c0, r1, c1)
    open_sides = set()
    for side, cells in side_cells.items():
        if any(grid[r, c] == mod.FLOOR_COLOR for r, c in cells):
            open_sides.add(side)
    open_side_counts.append(len(open_sides))

    markers = [(int(r), int(c)) for r, c in np.argwhere(grid == mod.MARKER_COLOR)]
    border_count = sum(int(r in (r0, r1) or c in (c0, c1)) for r, c in markers)
    marker_on_border.append(border_count / max(1, len(markers)))

    closed_markers = 0
    matched = 0
    for r, c in markers:
        if r == r0:
            side = 'top'
        elif r == r1:
            side = 'bottom'
        elif c == c0:
            side = 'left'
        else:
            side = 'right'
        should_reach = side in open_sides
        is_reached = (r, c) in reachable
        matched += int(should_reach == is_reached)
        if side not in open_sides:
            closed_markers += 1
    closed_marker_counts.append(closed_markers)
    side_gate_scores.append(matched / len(markers))

print('baseline_diff_rate', diff / samples)
print('border_marker_fraction_mean', round(sum(marker_on_border) / samples, 3))
print('reachable_count_dist', dict(sorted(Counter(reachable_counts).items())))
print('open_side_count_dist', dict(sorted(Counter(open_side_counts).items())))
print('closed_side_marker_dist', dict(sorted(Counter(closed_marker_counts).items())))
print('side_gate_score_dist', dict(sorted(Counter(round(x, 3) for x in side_gate_scores).items())))
