+                    dist[rr, cc] = 0
+                    q.append((rr, cc))
+
+    assert q, "destination block must touch at least one floor cell"
+
+    while q:
+        r, c = q.popleft()
+        for rr, cc in neighbors4(r, c):
+            if 0 <= rr < h and 0 <= cc < w and (rr, cc) not in dest_set and grid[rr, cc] == FLOOR_COLOR:
