+GRID_H = GRID_W = 11
+CENTER_R = CENTER_C = 5
+FRAME_R0 = FRAME_C0 = 1
+FRAME_R1 = FRAME_C1 = 9
+
+FLOOR_COLOR = 7
+WALL_COLOR = 6
+DEST_COLOR = 3
+RED_CENTER = 2
+MARKER_COLOR = 9
+
+SIDES = ("top", "bottom", "left", "right")
+GEN_RETRIES = 400
