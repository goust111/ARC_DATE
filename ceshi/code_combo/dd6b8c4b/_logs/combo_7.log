   201	    maroons = [triple for triple in maroons if triple[0] < inf]
   202	    maroons.sort()
   203	
   204	    k = min(len(fill_order), len(maroons))
   205	    chosen = {(r, c) for _, r, c in maroons[:k]}
   206	
   207	    for r, c in chosen:
   208	        out[r, c] = floor
   209	
   210	    for r, c in fill_order[:k]:
