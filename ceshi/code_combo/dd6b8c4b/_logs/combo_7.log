def _bfs_reachable(grid: np.ndarray, dest_set: set[tuple[int, int]]) -> set[tuple[int, int]]:
    """BFS from floor cells adjacent to dest through floor cells. Returns reachable floor cells."""
    visited: set[tuple[int, int]] = set()
