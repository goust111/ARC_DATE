   167	def main(grid: np.ndarray) -> np.ndarray:
   168	    """
   169	    Move the closest reachable maroon pixels into the 3×3 block around the unique red center, tracing a spiral that leaves the center untouched.
   170	
   171	    Input structure:
   172	    - Orange floor cells contain scattered maroon tokens, while magenta walls may block some corridors near the target.
   173	    - A single red pixel marks the middle of a green 3×3 destination block.
   174	
   175	    Rule:
   176	    - Flood-fill from passable cells touching the destination through floor/maroon cells; only reachable maroons are movable candidates.
   177	    - Sort those candidates by BFS distance to the destination, then by row and column.
   178	    - Erase the chosen sources back to floor and place them into the destination along the fixed clockwise spiral, skipping the red center so only the 8 outer cells can be filled.
   179	
   180	    Key insight:
   181	    - Two constraints interact: connectivity still decides which maroons qualify, but the destination now behaves like a spiral track wrapped around a permanent red hole.
   182	    """
   183	
   184	    grid = np.asarray(grid, dtype=int)
   185	    h, w = grid.shape
   186	    out = grid.copy()
   187	
   188	    centers = np.argwhere(grid == 2)
