+
+def _distance_map(
+    grid: np.ndarray,
+    dest_cells: list[tuple[int, int]],
+    dest_set: set[tuple[int, int]],
+    passable: set[int],
+) -> np.ndarray:
+    h, w = grid.shape
+    starts: list[tuple[int, int]] = []
+    seen: set[tuple[int, int]] = set()
+    for r, c in dest_cells:
