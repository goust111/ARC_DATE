+    ordered = [(int(dist[r, c]), int(r), int(c)) for r, c in np.argwhere(grid == FLOOR_COLOR)]
+    ordered = [triple for triple in ordered if triple[0] < inf and (triple[1], triple[2]) not in dest_set]
