+    maroons = [triple for triple in maroons if triple[0] < inf]
+    maroons.sort()
+
+    k = min(len(fill_order), len(maroons))
+    chosen = {(r, c) for _, r, c in maroons[:k]}
+
+    for r, c in chosen:
+        out[r, c] = floor
+
+    for r, c in fill_order[:k]:
+        out[r, c] = 9
+
+    return out
