+
+    inf = 10**9
+    dist = np.full((h, w), inf, dtype=int)
+    queue = list(starts)
+    for r, c in starts:
+        dist[r, c] = 0
+
+    qi = 0
+    while qi < len(queue):
+        r, c = queue[qi]
+        qi += 1
+        d = int(dist[r, c])
+        for rr, cc2 in neighbors4(r, c):
+            if 0 <= rr < h and 0 <= cc2 < w and int(grid[rr, cc2]) in passable and dist[rr, cc2] == inf:
