+    gap = random.choice(CHANNEL_WIDTHS)
+    cr, cc = random.choice(CENTER_OPTIONS[gap])
+    dest_cells, dest_set, frame_box, frame_cells, channel_cells = _layout_from_center(cr, cc, gap)
+    r0, c0, r1, c1 = frame_box
+
