+FLOOR_COLOR, FRAME_COLOR = 7, 6
+DEST_COLOR, RED_CENTER = 3, 2
+MAROON = 9
+
+# ---- Generation controls ----
+CHANNEL_WIDTHS = (1, 2)
+CENTER_OPTIONS = {
+    1: [(4, 4), (4, 5), (4, 6), (5, 4), (5, 5), (5, 6), (6, 4), (6, 5), (6, 6)],
+    2: [(5, 5)],
