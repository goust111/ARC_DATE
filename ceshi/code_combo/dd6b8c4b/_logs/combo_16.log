+
+def _bfs_distances(
+    grid: np.ndarray,
+    dest_cells: list[tuple[int, int]],
+    passable: set[int],
+) -> np.ndarray:
+    h, w = grid.shape
+    inf = 10**9
+    dist = np.full((h, w), inf, dtype=int)
+    q = deque()
+    for r, c in dest_cells:
+        for rr, cc in neighbors4(r, c):
+            if 0 <= rr < h and 0 <= cc < w and int(grid[rr, cc]) in passable and dist[rr, cc] == inf:
+                dist[rr, cc] = 0
+                q.append((rr, cc))
