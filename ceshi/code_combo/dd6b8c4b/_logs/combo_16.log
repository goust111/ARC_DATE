+    reachable.sort()
+
+    out = inp.copy()
+    k = min(len(dest_cells), len(reachable))
+    for _, r, c in reachable[:k]:
+        out[r, c] = FLOOR_COLOR
+    for r, c in dest_cells[:k]:
+        out[r, c] = MAROON
+
+    r0, c0, r1, c1 = frame_box
+    return out[r0 : r1 + 1, c0 : c1 + 1]
+
+
