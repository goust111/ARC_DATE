+    return grid, dest_cells, dest_set, frame
+
+
+def _apply_portals(grid: np.ndarray):
+    portal_count = random.randint(*PORTAL_COUNT_RANGE)
+    portals = random.sample(_portal_catalog(), portal_count)
+    reserved = set()
+    for portal in portals:
