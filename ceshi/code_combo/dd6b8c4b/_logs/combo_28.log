+
+
+def _dest_cells() -> list[tuple[int, int]]:
+    return [
+        (r, c)
+        for r in range(CENTER_R - 1, CENTER_R + 2)
+        for c in range(CENTER_C - 1, CENTER_C + 2)
+    ]
+
+
+def _frame_cells() -> set[tuple[int, int]]:
