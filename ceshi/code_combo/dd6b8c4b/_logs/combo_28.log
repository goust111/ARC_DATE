+GRID_H = 11
+GRID_W = 11
+CENTER_R = 5
+CENTER_C = 5
+
+FLOOR_COLOR = 7
+WALL_COLOR = 6
+DEST_COLOR = 3
+RED_CENTER = 2
+MAROON = 9
+
+FRAME_TOP = 3
+FRAME_BOTTOM = 7
+FRAME_LEFT = 3
+FRAME_RIGHT = 7
+
+GEN_RETRIES = 400
+FILL_RANGE = (4, 9)
+PORTAL_COUNT_RANGE = (1, 2)
+SOURCE_PREFIX_EXTRA = (3, 8)
