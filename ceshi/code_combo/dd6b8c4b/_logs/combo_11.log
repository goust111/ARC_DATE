+def _gen_attempt() -> np.ndarray | None:
+    dest_cells = _dest_cells(CENTER_R, CENTER_C, GRID_H, GRID_W)
+    dest_set = set(dest_cells)
+
+    grid = np.full((GRID_H, GRID_W), FLOOR_COLOR, dtype=int)
