+    if len(reachable_floor) < MIN_REACHABLE:
+        return None
+
+    all_floor = {(r, c) for r in range(GRID_H) for c in range(GRID_W) if int(grid[r, c]) == FLOOR_COLOR and (r, c) not in dest_set}
