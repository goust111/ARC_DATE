+
+def _outward_dirs(r: int, c: int) -> list[tuple[int, int]]:
+    dirs: list[tuple[int, int]] = []
+    if r < CENTER_R:
+        dirs.append((-1, 0))
+    if r > CENTER_R:
+        dirs.append((1, 0))
+    if c < CENTER_C:
+        dirs.append((0, -1))
+    if c > CENTER_C:
+        dirs.append((0, 1))
+    return dirs
