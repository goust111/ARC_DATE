+CENTER_R, CENTER_C = 5, 5
+FLOOR_COLOR = 7
+WALL_COLOR = 6
+DEST_COLOR = 3
+RED_CENTER = 2
+MAROON = 9
+TRACE_COLOR = 5
+UNREACHABLE_COLOR = 1
+
+RING_GAP_RANGE = (1, 4)
+WALL_STYLES = ["arms", "frame", "mixed"]
+ARM_EXTEND_PROB = 0.5
+ARM_LENGTH_RANGE = (1, 5)
+FRAME_DIST_RANGE = (3, 4)
