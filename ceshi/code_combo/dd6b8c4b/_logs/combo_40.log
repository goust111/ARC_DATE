+            for rc in random.sample(outer_frame, min(n_remove, len(outer_frame))):
+                if random.random() < FRAME_GAP_REMOVE_PROB:
+                    wall_cells.discard(rc)
+    else:
+        for r, c in wall_ring:
+            if random.random() < MIXED_EXTEND_PROB:
