+    (3, 5), (2, 5), (1, 5),
+    (1, 4), (1, 3), (2, 3), (2, 2), (2, 1),
+    (3, 3), (3, 2), (3, 1), (4, 1), (5, 1), (6, 1), (6, 2), (7, 1), (8, 1),
+    (9, 1), (9, 2), (9, 3), (8, 3),
+    (1, 9), (2, 9), (4, 9), (5, 9), (6, 9), (6, 8), (7, 9), (8, 9),
+    (9, 9), (9, 8), (9, 7), (8, 7),
+    (8, 5),  # isolated pocket for an unreachable distractor
