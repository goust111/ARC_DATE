+    out = _solve_variant(grid)
+    assert int((out == MAROON).sum()) == len(REACHABLE_TOKEN_CELLS) + len(UNREACHABLE_TOKEN_CELLS)
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
