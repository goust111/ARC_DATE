+    if len(other_distances) < num_groups - 1:
+        return None
+    chosen_distances = sorted([mixed_distance] + random.sample(other_distances, num_groups - 1))
+
+    sizes = _choose_group_sizes(chosen_distances, buckets, mixed_distance)
+    if sizes is None:
+        return None
