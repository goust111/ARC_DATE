+def _distance_map(
+    grid: np.ndarray,
+    dest_cells: list[tuple[int, int]],
+    passable: set[int],
+) -> np.ndarray:
+    h, w = grid.shape
+    dest_set = set(dest_cells)
+    dist = np.full((h, w), INF, dtype=int)
+    queue = deque()
