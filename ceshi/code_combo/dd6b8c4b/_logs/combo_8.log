        grid[r, c] = WALL_COLOR


def _gen_attempt():
    """Build a candidate input grid; returns the grid or None on failure."""
    dest_cells = [(r, c) for r in range(CENTER_R - 1, CENTER_R + 2)
                  for c in range(CENTER_C - 1, CENTER_C + 2)]
    dest_set = set(dest_cells)

