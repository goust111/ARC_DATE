+def _random_composition(total: int, parts: int, min_each: int) -> list[int]:
+    remainder = total - parts * min_each
+    assert remainder >= 0
+    cuts = sorted(random.sample(range(remainder + parts - 1), parts - 1)) if parts > 1 else []
