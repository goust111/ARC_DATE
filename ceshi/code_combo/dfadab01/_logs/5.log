+        pairs[j] = i
+    return pairs
+
+
+def _render_output(
+    shape: tuple[int, int],
+    markers: list[tuple[int, int, int]],
+    pair_map: dict[int, int],
+) -> np.ndarray:
+    out = np.zeros(shape, dtype=int)
+    for i, (marker_color, r, c) in enumerate(markers):
+        glyph_color = DEFAULT_GLYPH_COLORS[marker_color]
