   258	) -> np.ndarray:
   259	    out = np.zeros(shape, dtype=int)
   260	    for i, (marker_color, r, c) in enumerate(markers):
   261	        glyph_color = DEFAULT_GLYPH_COLORS[marker_color]
   262	        if i in pair_map:
   263	            partner_color = markers[pair_map[i]][0]
   264	            glyph_color = DEFAULT_GLYPH_COLORS[partner_color]
   265	        mask = GLYPHS[marker_color][1]
   266	        _paint_clipped(out, r, c, glyph_color, mask)
   267	    return out
   268	
   269	
   270	def _place_marker_pair(inp: np.ndarray, marker_color: int, center_r: int, center_c: int, diag_index: int) -> bool:
   271	    cells = _pair_cells(center_r, center_c, diag_index)
   272	    h, w = inp.shape
   273	    for rr, cc in cells:
   274	        if not (0 <= rr < h and 0 <= cc < w) or inp[rr, cc] != 0:
   275	            return False
   276	    for rr, cc in cells:
   277	        inp[rr, cc] = marker_color
   278	    return True
   279	
   280	
   281	def _markers_match_expected(inp: np.ndarray, expected_markers: list[tuple[int, int, int]]) -> bool:
   282	    try:
   283	        actual = _collect_real_markers(inp)
   284	    except AssertionError:
   285	        return False
   286	    return actual == sorted(expected_markers, key=lambda item: (item[1], item[2], item[0]))
   287	
   288	
   289	def main(grid: np.ndarray) -> np.ndarray:
   290	    """
   291	    Decode diagonal pixel-pair markers into fixed glyphs, then let nearest different-color markers exchange glyph colors.
   292	
   293	    Input structure:
   294	    - Black background with control colors 2, 3, 5, and/or 8, but each logical marker is now a same-color diagonal pair spanning a 5x5 box rather than a single pixel.
   295	    - Some inputs may also include one legend entry: a 4x4 sample glyph in the default output color plus a matching diagonal label pair whose decoded center sits four cells below-right of that sample.
   296	
   297	    Rule:
   298	    - First pair same-color pixels that differ by four rows and four columns; each midpoint is a recovered marker anchor.
   299	    - Ignore decoded anchors that belong to a legend label, and erase the legend glyph itself in the output.
   300	    - Marker color still chooses the 4x4 glyph shape, placed with its top-left corner at the recovered anchor and clipped at the border.
   301	    - Among the remaining real markers, two different-color markers swap default glyph colors only when they are each other's unique nearest different-color neighbor in Manhattan distance; all others keep their own default color.
   302	
   303	    Key insight:
   304	    - Neither input pixel directly becomes a glyph: first recover one logical marker from a visible diagonal pair, then use spatial nearest-neighbor reasoning between those decoded markers to decide whether each glyph keeps its own color or borrows a neighbor's.
   305	    """
   306	    g = np.asarray(grid, dtype=int)
   307	    assert g.ndim == 2
   308	    assert set(np.unique(g)).issubset(ALLOWED_COLORS)
   309	
   310	    markers = _collect_real_markers(g)
   311	    assert markers
   312	    pair_map = _mutual_nearest_pairs(markers)
   313	    return _render_output(g.shape, markers, pair_map)
   314	
   315	
   316	def _try_add_legend(inp: np.ndarray, free_cell: tuple[int, int] | None, used_markers: list[int]) -> bool:
   317	    if free_cell is None or not used_markers or random.random() >= LEGEND_PROB:
   318	        return True
   319	
   320	    cell_r, cell_c = free_cell
   321	    marker_color = random.choice(used_markers)
   322	    glyph_color, mask = GLYPHS[marker_color]
   323	    glyph_r = cell_r + 1
   324	    glyph_c = cell_c + 1
   325	    label_center_r = cell_r + 5
   326	    label_center_c = cell_c + 5
   327	    label_cells = _pair_cells(label_center_r, label_center_c, 1)
   328	
   329	    trial = inp.copy()
   330	    for rr, cc in label_cells:
   331	        if trial[rr, cc] != 0:
   332	            return False
   333	    for rr, cc in label_cells:
   334	        trial[rr, cc] = marker_color
   335	    for dr in range(4):
