+    for marker_color in MARKER_COLORS:
+        for r, c in _decode_centers(g, marker_color):
+            if _is_legend_center(g, marker_color, r, c):
+                continue
+            markers.append((marker_color, r, c))
+    markers.sort(key=lambda item: (item[1], item[2], item[0]))
+    return markers
