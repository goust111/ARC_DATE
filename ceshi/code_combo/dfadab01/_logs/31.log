+    if len(centers) < 2:
+        return False
+    deltas = [(r1 - r0, c1 - c0) for (r0, c0), (r1, c1) in zip(centers, centers[1:])]
+    step_r, step_c = deltas[0]
+    if step_r not in DIAGONAL_STEPS or abs(step_c) != step_r:
+        return False
+    return all(dr == step_r and dc == step_c for dr, dc in deltas)
+
