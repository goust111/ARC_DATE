+
+        glyph_cells = [(r0 + dr, c0 + dc) for dr in range(4) for dc in range(4) if bool(mask[dr, dc])]
+        for rr, cc in glyph_cells:
+            if inp[rr, cc] != 0:
+                ok = False
+                break
+        if not ok:
+            continue
+
+        trial = inp.copy()
+        for rr, cc in glyph_cells:
