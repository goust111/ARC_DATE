+
+
+def _add_legend(rng: random.Random, grid: np.ndarray, markers: list[tuple[int, int, int]]) -> None:
+    if rng.random() >= 0.45:
+        return
+    spots = _find_legend_spots(grid.shape, markers)
+    if not spots:
