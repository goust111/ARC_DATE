+    used_rows = {r for _, r, _ in markers}
+    used_cols = {c for _, _, c in markers}
+    extras: list[tuple[int, int]] = []
+
+    for _ in range(800):
+        if len(positions) >= target_count:
+            break
+
+        if rng.random() < 0.35:
+            _, base_r, base_c = rng.choice(markers)
+            r = base_r + rng.choice([-5, -4, -3, -2, -1, 1, 2, 3, 4, 5])
