+    ),
+}
+
+MARKER_ORDER: tuple[int, ...] = (2, 3, 5, 8)
+OVERLAP_OFFSETS_23: tuple[tuple[int, int], ...] = (
+    (1, 1),
+    (1, 2),
+    (2, 1),
+    (2, 2),
+    (1, 3),
+    (3, 1),
+    (0, 1),
+    (1, 0),
+    (0, 2),
+    (2, 0),
+)
