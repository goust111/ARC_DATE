+        seen_shapes.add(shape_key)
+        legend_mask[:, c : c + 2] = True
+        c += 2
+
+    if not mapping or c >= w or np.any(g[:, c] != 0):
+        return None
+    legend_mask[:, c] = True
+    return mapping, legend_mask
