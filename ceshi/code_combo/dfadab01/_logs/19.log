+def _decode_band(outer: np.ndarray, inner: np.ndarray) -> tuple[int, int, np.ndarray] | None:
+    if outer.shape != (GRID_SIZE,) or inner.shape != (GRID_SIZE,):
+        return None
+    if any(int(outer[i]) != 0 or int(inner[i]) != 0 for i in SEP_IDXS):
+        return None
