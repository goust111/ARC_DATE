+    seen_colors: set[int] = set()
+    c = 0
+    while c + 1 < w:
+        decoded = _decode_band(g[:, c], g[:, c + 1])
+        if decoded is None:
+            break
+        marker, glyph_color, mask = decoded
+        shape_key = _shape_key(mask)
