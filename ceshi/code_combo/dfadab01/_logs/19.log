+#     - The decoded mask always belongs to the original 4-glyph alphabet, and every legend band has at least
+#       one matching scene marker.
+
+
+CANONICAL_GLYPHS: dict[int, np.ndarray] = {
+    2: np.array(
+        [
+            [1, 1, 1, 1],
+            [1, 0, 0, 1],
+            [1, 0, 0, 1],
