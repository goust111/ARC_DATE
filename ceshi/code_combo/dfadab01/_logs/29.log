+
+    assert seen_marker
+    return out
+
+
+def _iter_real_markers(g: np.ndarray) -> list[tuple[int, int, int]]:
+    real: list[tuple[int, int, int]] = []
+    for marker_color, (glyph_color, mask) in GLYPHS.items():
