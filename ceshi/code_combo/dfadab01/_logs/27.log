+ORIGINAL_GLYPH_COLORS = (1, 4, 6, 7)
+LEGEND_PAINT_COLORS = tuple(range(1, 9))
+ALLOWED_COLORS = {0, *MARKER_COLORS, *ORIGINAL_GLYPH_COLORS}
+GRID_SIZE = 20
