def nearest(markers):
    donors=[]
    for i,(r,c,color) in enumerate(markers):
        ds=[]
        for j,(rr,cc,ccolor) in enumerate(markers):
            if i==j: continue
            ds.append((abs(r-rr)+abs(c-cc),ccolor))
        md=min(d for d,_ in ds)
        colors={col for d,col in ds if d==md}
        if len(colors)"'!=1:
            return None
        donors.append(next(iter(colors)))
    return donors


def run(roots, use_all_known=True):
    known={(r,c):color for r,c,color in roots}
    wave=list(roots)
    waves=[]
    while wave:
        allm=[(r,c,color) for (r,c),color in sorted(known.items())]
        donors=nearest(allm if use_all_known else roots)
        if donors is None: return None
        donor_map={(r,c):donor for (r,c,_),donor in zip(allm, donors)}
        cur=[]
        next_map={}
        for r,c,color in wave:
            donor=donor_map[(r,c)]
            cur.append((r,c,color,donor))
            if MASKS[color][3,3]:
                nr,nc=r+3,c+3
                if 0<=nr<H and 0<=nc<W:
                    prev=known.get((nr,nc))
                    if prev is None:
                        old=next_map.get((nr,nc))
                        if old is None or old==donor:
                            next_map[(nr,nc)]=donor
                        else:
                            return None
                    elif prev!=donor:
                        return None
        waves.append(cur)
        wave=[]
        for (r,c),color in sorted(next_map.items()):
            known[(r,c)]=color
            wave.append((r,c,color))
        if len(waves)>8:
            break
    return waves


def output(waves):
    out=np.zeros((H,W),dtype=int)
    for wave in waves:
        for r,c,color,donor in wave:
            mask=MASKS[color]
            for dr in range(4):
                for dc in range(4):
                    if mask[dr,dc]:
                        rr,cc=r+dr,c+dc
                        if 0<=rr<H and 0<=cc<W:
                            out[rr,cc]=donor
    return out

for trial in range(20000):
    pos=random.sample(CANDS, random.randint(3,5))
    roots=[(r,c,random.choice(MARKERS)) for r,c in pos]
    if len({c for _,_,c in roots})<2:
        continue
    w1=run(roots,True)
    if not w1: continue
    total=sum(len(w) for w in w1)
    if total<=len(roots):
        continue
    if max(len(w) for w in w1)<2:
