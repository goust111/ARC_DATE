+    mask = _mask_for_marker(inp.shape, r0, c0, marker_color, quadrant_rotation=True)
+    color = _glyph_color(inp.shape, r0, c0, marker_color, quadrant_color=True)
+    patch = inp[r0 : r0 + 4, c0 : c0 + 4]
+    patch[mask] = color
+    inp[r0 + 4, c0 + 4] = marker_color
+
