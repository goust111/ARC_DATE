+MARKER_COLORS = tuple(MARKER_ROTATIONS.keys())
+OUTPUT_COLORS = tuple(sorted(set(QUADRANT_COLORS.values())))
+ALLOWED_INPUT_COLORS = {0, *MARKER_COLORS, *OUTPUT_COLORS}
