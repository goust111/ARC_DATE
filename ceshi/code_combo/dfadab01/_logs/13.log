   228	def _sample_positions() -> list[tuple[int, int]]:
   229	    for _ in range(200):
   230	        rows = random.randint(2, 5)
   231	        cols = random.randint(3, 5)
   232	        if rows * cols < 6:
   233	            continue
   234	        row_spacing = random.randint(4, 5)
   235	        col_spacing = random.randint(4, 5)
   236	        max_row_start = GRID_SIZE - 1 - row_spacing * (rows - 1)
   237	        max_col_start = GRID_SIZE - 1 - col_spacing * (cols - 1)
   238	        if max_row_start < 0 or max_col_start < 0:
   239	            continue
   240	        start_r = random.randint(0, max_row_start)
   241	        start_c = random.randint(0, max_col_start)
   242	        row_positions = [start_r + i * row_spacing for i in range(rows)]
   243	        col_positions = [start_c + i * col_spacing for i in range(cols)]
   244	        return [(r, c) for r in row_positions for c in col_positions]
   245	    raise RuntimeError("failed to sample a legal lattice")
