   249	    used_count = random.choices([3, 4], weights=[3, 2], k=1)[0]
   250	    used_colors = {8, random.choice([3, 5])}
   251	    remaining = [color for color in MARKER_COLORS if color not in used_colors]
   252	    while len(used_colors) < used_count:
   253	        used_colors.add(random.choice(remaining))
   254	        remaining = [color for color in MARKER_COLORS if color not in used_colors]
   255	    return sorted(used_colors)
