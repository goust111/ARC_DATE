   203	def main(grid: np.ndarray) -> np.ndarray:
   204	    """
   205	    Replace each marker by its original 4x4 glyph shape, but recolor that glyph with a fixed +2 shift.
   206	
   207	    Input structure:
   208	    - Black background with single-pixel markers in colors 2, 3, 5, and/or 8.
   209	    - Some grids may also include an optional visible legend entry: a 4x4 sample glyph in the shifted output color, with its label marker one cell below-right of the sample.
   210	
   211	    Rule:
   212	    - A marker's color still selects which 4x4 glyph mask to draw, using the same shape dictionary as the base task.
   213	    - The glyph's fill color is no longer read from a fixed lookup table; it is `(marker_color + 2) mod 10`.
   214	    - Paint the glyph with its top-left corner at the marker position, clip anything beyond the grid edge, and remove any visible legend sample plus its label marker from the output.
   215	
   216	    Key insight:
   217	    - Shape and color have been decoupled: the marker color still names the geometry, while the displayed color is a uniform arithmetic offset, causing color 8 markers to disappear into the black background.
   218	    """
   219	    g = np.asarray(grid, dtype=int)
   220	    assert g.ndim == 2
   221	    assert set(map(int, np.unique(g))).issubset(ALLOWED_COLORS)
   222	
   223	    markers = _collect_real_markers(g)
   224	    assert markers, "expected at least one real marker"
   225	    return _render_output(g.shape, markers)
