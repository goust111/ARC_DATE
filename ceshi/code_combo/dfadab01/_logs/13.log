+
+
+def _fusion_metrics_from_markers(markers: list[tuple[int, int, int]]) -> dict[str, float]:
+    total = len(markers)
+    assert total > 0
+    invisible_count = sum(marker_color == 8 for _, _, marker_color in markers)
