+def _detect_scale(g: np.ndarray) -> int:
+    matches: set[int] = set()
+    for marker_color in MARKER_COLORS:
+        coords = np.argwhere(g == marker_color)
+        for r, c in coords:
+            for factor in SCALE_FACTORS:
+                glyph_color, mask = _glyph_for_scale(marker_color, factor)
