+    new_out = main(g)
+    old_out = np.zeros_like(g)
+    for r0, c0, marker_color in _collect_real_markers(g):
+        glyph_color, mask = old_masks[marker_color]
+        mh, mw = mask.shape
+        for dr in range(mh):
