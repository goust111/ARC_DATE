    out = np.full_like(g, bg)

    for info in parsed_lines:
        li = int(info["line"])
        marker = int(info["marker"])
        a = int(info["a"])
        b = int(info["b"])
        step = int(info["step"])
        companion_color = info["companion_color"]
        companion_pos = info["companion_pos"]

        paint = marker if companion_color is None else int(companion_color)
