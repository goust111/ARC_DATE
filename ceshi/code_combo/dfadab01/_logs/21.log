            if r0 + GLYPH_SIZE >= h or c0 + GLYPH_SIZE >= w:
                continue
            block = grid[r0 : r0 + GLYPH_SIZE + 1, c0 : c0 + GLYPH_SIZE + 1]
            if np.all(block == 0):
