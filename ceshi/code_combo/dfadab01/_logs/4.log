   127	def _paint_clipped(out: np.ndarray, r0: int, c0: int, color: int, mask: np.ndarray) -> None:
   128	    h, w = out.shape
   129	    for dr in range(GLYPH_SIZE):
   130	        rr = r0 + dr
   131	        if rr < 0 or rr >= h:
   132	            continue
   133	        for dc in range(GLYPH_SIZE):
   134	            cc = c0 + dc
   135	            if 0 <= cc < w and bool(mask[dr, dc]):
   136	                out[rr, cc] = color
