   210	def main(grid: np.ndarray) -> np.ndarray:
   211	    """
   212	    Decode the full per-puzzle legend, then expand each marker with its locally defined colored 4x4 glyph.
   213	
   214	    Input structure:
   215	    - Left side: four complete legend entries stacked vertically; each entry is a colored 4x4 sample plus a marker-color label one cell down-right.
   216	    - Right side: isolated single-pixel markers in colors 2, 3, 5, and 8 placed on a regular lattice.
   217	    - The legend covers all four marker colors, but its order, sample colors, and 4x4 masks can change from puzzle to puzzle.
   218	
   219	    Rule:
   220	    - For each label pixel, read the 4x4 patch immediately above-left of it to learn both the output color and the glyph mask owned by that marker color.
   221	    - Replace every non-legend marker of that color with the learned 4x4 sample, anchored at the marker position and clipped by the grid boundary.
   222	    - Remove the entire legend region and do not expand the label pixels themselves.
   223	
   224	    Key insight:
   225	    - There is no global marker dictionary anymore: both the color assignment and the glyph shapes are specified locally by the full legend, so solving requires decoding all legend entries before painting the scene.
   226	    """
   227	    g = np.asarray(grid, dtype=int)
   228	    assert g.ndim == 2
   229	    assert g.shape == (GRID_SIZE, GRID_SIZE)
   230	    assert set(map(int, np.unique(g))).issubset(ALLOWED_COLORS)
   231	
   232	    mapping, legend_labels = _decode_full_legend(g)
   233	
   234	    out = np.zeros_like(g)
   235	    seen_real_marker = False
   236	    for marker_color in MARKER_COLORS:
   237	        glyph_color, mask = mapping[marker_color]
   238	        for r, c in np.argwhere(g == marker_color):
   239	            cell = (int(r), int(c))
   240	            if cell in legend_labels:
   241	                continue
   242	            seen_real_marker = True
   243	            _paint_clipped(out, cell[0], cell[1], glyph_color, mask)
   244	
