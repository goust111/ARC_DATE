+        "min_pairwise_mask_distance": min_pairwise_mask_distance,
+        "min_base_distance": min_base_distance,
+        "color_effect_cells": color_effect_cells,
+        "mask_effect_cells": mask_effect_cells,
+        "baseline_diff_cells": baseline_diff_cells,
