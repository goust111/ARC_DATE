   169	def _read_legend_entry(g: np.ndarray, r: int, c: int) -> tuple[int, np.ndarray] | None:
   170	    if r < GLYPH_SIZE or c < GLYPH_SIZE:
   171	        return None
   172	    patch = g[r - GLYPH_SIZE : r, c - GLYPH_SIZE : c]
   173	    nonzero = np.unique(patch[patch != 0])
