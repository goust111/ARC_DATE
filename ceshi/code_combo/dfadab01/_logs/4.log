   202	        mapping[marker_color] = (glyph_color, mask)
   203	        legend_labels.add((r, c))
   204	
   205	    used_output_colors = {mapping[marker_color][0] for marker_color in MARKER_COLORS}
   206	    assert used_output_colors == set(OUTPUT_COLORS), "legend must expose all four output colors"
