   190	
   191	    for marker_color in MARKER_COLORS:
   192	        matches: list[tuple[int, int, int, np.ndarray]] = []
   193	        for r, c in np.argwhere(g == marker_color):
   194	            entry = _read_legend_entry(g, int(r), int(c))
   195	            if entry is None:
