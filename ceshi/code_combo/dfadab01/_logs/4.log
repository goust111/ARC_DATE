+def _paint_clipped(out: np.ndarray, r0: int, c0: int, color: int, mask: np.ndarray) -> None:
+    h, w = out.shape
+    for dr in range(GLYPH_SIZE):
+        rr = r0 + dr
+        if rr < 0 or rr >= h:
+            continue
+        for dc in range(GLYPH_SIZE):
+            cc = c0 + dc
+            if 0 <= cc < w and bool(mask[dr, dc]):
+                out[rr, cc] = color
