   138	
   139	def _mask_connected(mask: np.ndarray) -> bool:
   140	    cells = [tuple(map(int, rc)) for rc in np.argwhere(mask)]
   141	    if not cells:
   142	        return False
   143	    seen = {cells[0]}
   144	    stack = [cells[0]]
   145	    while stack:
   146	        r, c = stack.pop()
   147	        for dr in (-1, 0, 1):
   148	            for dc in (-1, 0, 1):
   149	                if dr == 0 and dc == 0:
   150	                    continue
   151	                rr = r + dr
   152	                cc = c + dc
   153	                if 0 <= rr < GLYPH_SIZE and 0 <= cc < GLYPH_SIZE and bool(mask[rr, cc]) and (rr, cc) not in seen:
   154	                    seen.add((rr, cc))
   155	                    stack.append((rr, cc))
   156	    return len(seen) == len(cells)
