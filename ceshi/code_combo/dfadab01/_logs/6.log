+            if _has_source_glyph(grid, rr - 4, cc - 4, glyph_color, mask):
+                continue
+            for dr in range(4):
+                for dc in range(4):
+                    if not bool(mask[dr, dc]):
+                        continue
+                    tr, tc = rr + dr, cc + dc
+                    if 0 <= tr < out.shape[0] and 0 <= tc < out.shape[1]:
+                        out[tr, tc] = int(glyph_color)
+    return out
