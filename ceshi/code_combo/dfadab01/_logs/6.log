+        label = (r0 + size, c0 + size)
+        patch = grid[r0 : r0 + size, c0 : c0 + size]
+        if np.any(patch != 0) or int(grid[label]) != 0:
+            continue
+        patch[mask] = int(glyph_color)
+        grid[label] = int(marker_color)
+        return True
+    return False
