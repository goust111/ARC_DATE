   131	
   132	def _has_source_glyph(g: np.ndarray, r0: int, c0: int, color: int, mask: np.ndarray) -> bool:
   133	    h, w = g.shape
   134	    if r0 < 0 or c0 < 0 or r0 + 4 > h or c0 + 4 > w:
   135	        return False
   136	    patch = g[r0 : r0 + 4, c0 : c0 + 4]
   137	    return bool(np.all(patch[mask] == color) and np.all(patch[~mask] != color))
   138	
   139	
   140	def _paint_clipped(out: np.ndarray, r0: int, c0: int, color: int, mask: np.ndarray) -> None:
   141	    h, w = out.shape
   142	    for dr in range(4):
   143	        rr = r0 + dr
   144	        if rr < 0 or rr >= h:
   145	            continue
   146	        for dc in range(4):
   147	            cc = c0 + dc
   148	            if 0 <= cc < w and bool(mask[dr, dc]):
   149	                out[rr, cc] = color
   150	
   151	
   152	def _orient_mask_for_row(mask: np.ndarray, row_idx: int) -> np.ndarray:
   153	    if row_idx % 2 == 1:
   154	        return np.fliplr(mask)
   155	    return mask
   156	
   157	
   158	def _extract_real_markers(g: np.ndarray) -> list[tuple[int, int, int]]:
   159	    markers: list[tuple[int, int, int]] = []
   160	    for marker_color, (glyph_color, mask) in GLYPHS.items():
   161	        for r, c in np.argwhere(g == marker_color):
   162	            rr = int(r)
   163	            cc = int(c)
   164	            if _has_source_glyph(g, rr - 4, cc - 4, glyph_color, mask):
   165	                continue
   166	            markers.append((rr, cc, int(marker_color)))
   167	    return markers
   168	
   169	
   170	def _render_markers(shape: tuple[int, int], markers: list[tuple[int, int, int]], *, flip_by_row: bool) -> np.ndarray:
   171	    out = np.zeros(shape, dtype=int)
   172	    if not markers:
   173	        return out
   174	    row_ids = {int(r): idx for idx, r in enumerate(sorted({int(r) for r, _c, _mc in markers}))}
   175	    for r, c, marker_color in markers:
   176	        glyph_color, base_mask = GLYPHS[int(marker_color)]
   177	        mask = base_mask if not flip_by_row else _orient_mask_for_row(base_mask, row_ids[int(r)])
   178	        _paint_clipped(out, int(r), int(c), int(glyph_color), mask)
   179	    return out
   180	
   181	
   182	def _row_ids_from_markers(markers: list[tuple[int, int, int]]) -> dict[int, int]:
   183	    return {int(r): idx for idx, r in enumerate(sorted({int(r) for r, _c, _mc in markers}))}
   184	
   185	
   186	def _cross_parity_same_color(markers: list[tuple[int, int, int]]) -> bool:
   187	    row_ids = _row_ids_from_markers(markers)
   188	    color_parities: dict[int, set[int]] = {}
   189	    for r, _c, marker_color in markers:
   190	        color_parities.setdefault(int(marker_color), set()).add(int(row_ids[int(r)] % 2))
   191	    return any(len(parities) >= 2 for parities in color_parities.values())
   192	
   193	
   194	def _flip_delta_pixels(markers: list[tuple[int, int, int]], shape: tuple[int, int]) -> int:
   195	    flipped = _render_markers(shape, markers, flip_by_row=True)
   196	    baseline = _render_markers(shape, markers, flip_by_row=False)
   197	    return int(np.count_nonzero(flipped != baseline))
