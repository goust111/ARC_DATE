   199	
   200	def main(grid: np.ndarray) -> np.ndarray:
   201	    """
   202	    Expand each control pixel into a non-symmetric 4x4 glyph, flipping it horizontally on odd marker rows.
   203	
   204	    Input structure:
   205	    - Black background with single-pixel markers in colors 2, 3, 5, and/or 8 placed on a sparse regular lattice.
   206	    - Some inputs also include one legend entry: a canonical 4x4 glyph in its output color plus a matching label marker
   207	      one cell below-right of the glyph's bounding box.
   208	
   209	    Rule:
   210	    - Remove legend glyphs and skip their label markers just as in the base task.
   211	    - For each real marker, look up its fixed output color and canonical non-symmetric 4x4 glyph.
   212	    - If the marker lies on an even-indexed visible marker row, draw the glyph as-is; if it lies on an odd-indexed
   213	      visible marker row, draw the left-right mirror of that glyph. Anchor every glyph at the marker pixel and clip at
   214	      the grid boundary.
   215	
   216	    Key insight:
   217	    - Marker color still determines which glyph family appears, but the glyph's facing direction is controlled by row
   218	      parity within the marker lattice, so the same color can produce two mirrored shapes on alternating rows.
   219	    """
   220	    g = np.asarray(grid, dtype=int)
   221	    assert g.ndim == 2
   222	    assert set(np.unique(g)).issubset({0, *GLYPHS.keys(), 1, 4, 6, 7})
   223	
   224	    real_markers = _extract_real_markers(g)
   225	    assert real_markers
   226	    return _render_markers(g.shape, real_markers, flip_by_row=True)
   227	
   228	
   229	# --------------- generator (output-first row-parity mirrored substitution) ---------------
   230	
   231	
   232	def _build_occupancy(rng: random.Random, rows: int, cols: int) -> np.ndarray:
   233	    occ = np.zeros((rows, cols), dtype=bool)
   234	
   235	    # Force visible support on both parities near the top-left.
   236	    occ[0, 0] = True
   237	    occ[1, 0] = True
   238	    if cols >= 2:
   239	        occ[0, 1] = True
   240	        occ[1, 1] = True
   241	
   242	    for r in range(rows):
   243	        occ[r, rng.randrange(cols)] = True
   244	    for c in range(cols):
   245	        occ[rng.randrange(rows), c] = True
   246	
   247	    min_fill = max(4, int(np.ceil(0.7 * rows * cols)))
   248	    target_fill = rng.randint(min_fill, rows * cols)
   249	    vacant = [(r, c) for r in range(rows) for c in range(cols) if not occ[r, c]]
   250	    rng.shuffle(vacant)
   251	    for r, c in vacant[: max(0, target_fill - int(occ.sum()))]:
   252	        occ[r, c] = True
   253	    return occ
   254	
   255	
   256	def _place_legend(rng: random.Random, grid: np.ndarray, legend_marker_color: int) -> bool:
   257	    glyph_color, mask = GLYPHS[int(legend_marker_color)]
   258	    h, w = grid.shape
   259	    if h < 5 or w < 5:
   260	        return False

