   325	
   326	    remaining_types = marker_types[:]
   327	    rng.shuffle(remaining_types)
   328	    extras: list[int] = []
   329	    while len(used_colors | set(extras)) < len(marker_types):
   330	        extras.append(remaining_types.pop())
   331	
   332	    free_cells = [cell for cell in occupied_cells if cell not in anchors]
   333	    rng.shuffle(free_cells)
