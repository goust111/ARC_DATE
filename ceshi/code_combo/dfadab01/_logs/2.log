   299	    col_span = sum(col_steps)
   300	
   301	    min_h = max(10, row_span + 1)
   302	    max_h = max(min_h, row_span + 5)
   303	    min_w = max(10, col_span + 1)
   304	    max_w = max(min_w, col_span + 5)
   305	    h = rng.randint(min_h, max_h)
   306	    w = rng.randint(min_w, max_w)
   307	    top = rng.randint(0, h - 1 - row_span)
   308	    left = rng.randint(0, w - 1 - col_span)
   309	
   310	    row_positions = [top + i * row_step for i in range(rows)]
   311	    col_positions = [left]
   312	    for step in col_steps:
   313	        col_positions.append(col_positions[-1] + step)
   314	
   315	    occ = _build_occupancy(rng, rows, cols)
   316	    occupied_cells = [(r, c) for r in range(rows) for c in range(cols) if bool(occ[r, c])]
   317	    rng.shuffle(occupied_cells)
   318	
   319	    marker_types = rng.sample(sorted(GLYPHS), k=rng.randint(2, 4))
   320	    anchors = _choose_anchor_colors(rng, marker_types, cols)
   321	
   322	    inp = np.zeros((h, w), dtype=int)
