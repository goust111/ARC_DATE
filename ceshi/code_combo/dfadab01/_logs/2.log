   292	def _generate_case(rng: random.Random) -> tuple[np.ndarray, np.ndarray, int]:
   293	    rows = rng.randint(3, 5)
   294	    cols = rng.randint(2, 5)
   295	
   296	    row_step = rng.randint(4, 6)
   297	    col_steps = [rng.randint(4, 6) for _ in range(cols - 1)]
