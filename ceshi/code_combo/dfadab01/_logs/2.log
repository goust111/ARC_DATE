   335	    forced_cells = {cell for cell, _marker_color in forced_assignments}
   336	
   337	    for rr, cc in occupied_cells:
   338	        if (rr, cc) in anchors:
   339	            marker_color = anchors[(rr, cc)]
   340	        elif (rr, cc) in forced_cells:
   341	            marker_color = next(color for cell, color in forced_assignments if cell == (rr, cc))
   342	        else:
   343	            marker_color = rng.choice(marker_types)
   344	        r = row_positions[rr]
   345	        c = col_positions[cc]
