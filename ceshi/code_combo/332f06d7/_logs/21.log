    H, W = g.shape

    bg = int(
        Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0]
    )

    squares: list[dict] = []
    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict"):
        col = int(comp["color"])
        b = comp["bbox"]
        if bbox_h(b) != bbox_w(b):
            continue
        patch = g[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1]
        if not bool((patch == col).all()):
            continue
        squares.append({"col": col, "r0": int(b[0]), "c0": int(b[1]), "n": int(bbox_h(b))})

    assert len(squares) >= 2

    by_n: dict[int, list[dict]] = defaultdict(list)
    for sq in squares:
        by_n[int(sq["n"])].append(sq)
    nside = max(by_n.items(), key=lambda kv: (len(kv[1]), kv[0]))[0]
    cand = by_n[int(nside)]
    assert len(cand) >= 2

    by_color = {int(s["col"]): s for s in cand}
    assert _MOVER in by_color and _DEST in by_color
    mover = by_color[_MOVER]
    dest = by_color[_DEST]

    counts = Counter(map(int, g.flatten()))
    river = None
    for col, _ct in counts.most_common():
        if col == bg or col in (_MOVER, _DEST):
            continue
        river = int(col)
        break
    assert river is not None

    return {
        "grid": g,
        "H": H,
        "W": W,
        "bg": bg,
        "river": river,
        "mover": mover,
        "dest": dest,
        "n": int(mover["n"]),
        "sr": int(mover["r0"]),
        "sc": int(mover["c0"]),
        "dr": int(dest["r0"]),
        "dc": int(dest["c0"]),
    }


def _build_feasible(g: np.ndarray, river: int, n: int) -> np.ndarray:
    H, W = g.shape
    trav = (g == river) | (g == _MOVER) | (g == _DEST)
    h2, w2 = H - n + 1, W - n + 1
    assert h2 > 0 and w2 > 0
    feasible = np.zeros((h2, w2), dtype=bool)
    for r in range(h2):
        for c in range(w2):
            if bool(trav[r : r + n, c : c + n].all()):
                feasible[r, c] = True
    return feasible


def _bfs(feasible: np.ndarray, start: tuple[int, int]) -> tuple[np.ndarray, dict[tuple[int, int], tuple[int, int] | None]]:
    h2, w2 = feasible.shape
    sr, sc = start
    assert 0 <= sr < h2 and 0 <= sc < w2 and bool(feasible[sr, sc])

    dist = -np.ones((h2, w2), dtype=int)
    parent: dict[tuple[int, int], tuple[int, int] | None] = {(sr, sc): None}
    dist[sr, sc] = 0
    q = deque([(sr, sc)])
    while q:
        r, c = q.popleft()
        for dr, dc in _DIR4:
            rr, cc = r + dr, c + dc
            if 0 <= rr < h2 and 0 <= cc < w2 and bool(feasible[rr, cc]) and int(dist[rr, cc]) == -1:
                dist[rr, cc] = int(dist[r, c] + 1)
                parent[(rr, cc)] = (r, c)
                q.append((rr, cc))
    return dist, parent


def _reconstruct_path(parent: dict[tuple[int, int], tuple[int, int] | None], end: tuple[int, int]) -> list[tuple[int, int]]:
    path = []
    cur: tuple[int, int] | None = end
    while cur is not None:
        path.append(cur)
        cur = parent[cur]
    path.reverse()
    return path


def _best_frontier_pair(dist_a: np.ndarray, dist_b: np.ndarray) -> tuple[tuple[int, int], tuple[int, int], int]:
    a_pts = np.argwhere(dist_a >= 0)
    b_pts = np.argwhere(dist_b >= 0)
    assert len(a_pts) > 0 and len(b_pts) > 0

    best_pair = None
    best_score = None
    for ar, ac in a_pts:
        da = int(dist_a[ar, ac])
        for br, bc in b_pts:
            db = int(dist_b[br, bc])
            gap = abs(int(ar) - int(br)) + abs(int(ac) - int(bc))
            score = (gap, -(da + db), abs(da - db), int(ar), int(ac), int(br), int(bc))
            if best_score is None or score < best_score:
                best_score = score
                best_pair = ((int(ar), int(ac)), (int(br), int(bc)), gap)
    assert best_pair is not None
    return best_pair


def _solve_positions(grid: np.ndarray) -> dict:
    scene = _parse_scene(grid)
    g = scene["grid"]
    n = int(scene["n"])
    sr, sc = int(scene["sr"]), int(scene["sc"])
    dr, dc = int(scene["dr"]), int(scene["dc"])
    feasible = _build_feasible(g, int(scene["river"]), n)
    assert bool(feasible[sr, sc]) and bool(feasible[dr, dc])

    dist_s, parent_s = _bfs(feasible, (sr, sc))
    dist_d, _parent_d = _bfs(feasible, (dr, dc))

    if int(dist_s[dr, dc]) >= 0:
        path = _reconstruct_path(parent_s, (dr, dc))
        D = len(path) - 1
        steps_each = max(0, (D - 1) // 2)
        mover_final = path[steps_each]
        dest_final = path[D - steps_each]
        gap = abs(mover_final[0] - dest_final[0]) + abs(mover_final[1] - dest_final[1])
        return {
            **scene,
            "feasible": feasible,
            "dist_s": dist_s,
            "dist_d": dist_d,
            "connected": True,
            "path": path,
            "mover_final": mover_final,
            "dest_final": dest_final,
            "mover_steps": steps_each,
            "dest_steps": steps_each,
            "gap": gap,
        }

    mover_final, dest_final, gap = _best_frontier_pair(dist_s, dist_d)
    return {
        **scene,
        "feasible": feasible,
        "dist_s": dist_s,
        "dist_d": dist_d,
        "connected": False,
        "path": None,
        "mover_final": mover_final,
        "dest_final": dest_final,
        "mover_steps": int(dist_s[mover_final]),
        "dest_steps": int(dist_d[dest_final]),
        "gap": gap,
    }


def main(grid: np.ndarray) -> np.ndarray:
    """
    Bidirectional variant of 332f06d7.

    The black and red n×n squares both slide through the same river geometry.
    If they share a feasible placement component, they advance simultaneously
    along a shortest path until one more step would cause overlap/crossing.
    If a chokepoint splits the placement graph, each square advances to the
    frontier of its own reachable region, so the final pair is determined by
    both sides' reachable ranges rather than only the black square's range.
    """
    info = _solve_positions(grid)
    g = info["grid"]
    n = int(info["n"])
    sr, sc = int(info["sr"]), int(info["sc"])
    dr, dc = int(info["dr"]), int(info["dc"])
    river = int(info["river"])
    mr, mc = info["mover_final"]
    rr, rc = info["dest_final"]

    out = g.copy()
    out[sr : sr + n, sc : sc + n] = river
    out[dr : dr + n, dc : dc + n] = river
    out[mr : mr + n, mc : mc + n] = _MOVER
    out[rr : rr + n, rc : rc + n] = _DEST
    return out


def _hamiltonian_walk(rows: int, cols: int, start: tuple[int, int], end: tuple[int, int]) -> list[tuple[int, int]] | None:
    total = rows * cols
    best_path = None
    best_len = 0
    for _attempt in range(80):
        visited = {start}
        path = [start]
        cur = start
        while True:
            if cur == end and len(path) >= total * 0.7:
                if len(path) > best_len:
                    best_path = list(path)
                    best_len = len(path)
                break
            neighbors = []
            for dr, dc in _DIR4:
                nr, nc = cur[0] + dr, cur[1] + dc
                if 0 <= nr < rows and 0 <= nc < cols and (nr, nc) not in visited:
                    neighbors.append((nr, nc))
            if not neighbors:
                break
            valid = []
            for nb in neighbors:
                if nb == end:
                    valid.append(nb)
                    continue
                test_visited = visited | {nb}
                seen = {end}
                q = deque([end])
                while q:
                    cr, cc = q.popleft()
                    for dr2, dc2 in _DIR4:
                        nr2, nc2 = cr + dr2, cc + dc2
                        if (
                            0 <= nr2 < rows
                            and 0 <= nc2 < cols
                            and (nr2, nc2) not in test_visited
                            and (nr2, nc2) not in seen
                        ):
                            seen.add((nr2, nc2))
                            q.append((nr2, nc2))
                for dr2, dc2 in _DIR4:
                    ar, ac = nb[0] + dr2, nb[1] + dc2
                    if 0 <= ar < rows and 0 <= ac < cols and (ar, ac) not in test_visited and (ar, ac) in seen:
                        valid.append(nb)
                        break
            if not valid:
                break
            random.shuffle(valid)
            nxt = valid[0]
            visited.add(nxt)
            path.append(nxt)
            cur = nxt
        if best_path and best_len >= total * 0.85:
            break
    return best_path


def _render_channel(
    grid: np.ndarray, path: list[tuple[int, int]], n: int, offsets_r: list[int], offsets_c: list[int]
) -> list[tuple[int, int]]:
    pixel_pos = []
    for cr, cc in path:
        pr, pc = offsets_r[cr], offsets_c[cc]
        pixel_pos.append((pr, pc))
        grid[pr : pr + n, pc : pc + n] = _RIVER
    for i in range(len(path) - 1):
        pr1, pc1 = pixel_pos[i]
        pr2, pc2 = pixel_pos[i + 1]
        if pr1 == pr2:
            c_lo, c_hi = min(pc1, pc2), max(pc1, pc2) + n
            grid[pr1 : pr1 + n, c_lo:c_hi] = _RIVER
        else:
            r_lo, r_hi = min(pr1, pr2), max(pr1, pr2) + n
            grid[r_lo:r_hi, pc1 : pc1 + n] = _RIVER
    return pixel_pos


def _add_chokepoint(
    grid: np.ndarray, pixel_pos_i: tuple[int, int], pixel_pos_j: tuple[int, int], n: int, direction: str
) -> None:
    H, W = grid.shape
    pr1, pc1 = pixel_pos_i
    pr2, pc2 = pixel_pos_j
    narrow_w = random.randint(1, n - 1)
    remove = n - narrow_w
    side = random.randint(0, 1)

    if direction == "h":
        c_lo = min(pc1, pc2) + n
        c_hi = max(pc1, pc2)
        if c_hi <= c_lo:
            c_lo, c_hi = min(pc1, pc2), max(pc1, pc2) + n
        hold_len = random.randint(1, min(6, max(1, c_hi - c_lo - 2 * remove)))

