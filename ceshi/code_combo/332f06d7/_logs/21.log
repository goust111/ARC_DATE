            ```python
            # Variant of 332f06d7
# Dimension: D17 — src-dst 基数关系 (meta)
# Change: 1:1 关系——一个移动体对应一个目标... → 多移动体对一目标 (many:1)

from __future__ import annotations

from collections import Counter, defaultdict, deque
import random

import numpy as np
from scipy.ndimage import label as scipy_label

from arc_utils import bbox_h, bbox_w, find_components

"""
Design analysis for the D17 many:1 variant
==========================================

a) Concrete behavior and flow impact
spec_variant:
  objects:
    background: color 3 dominates corners
    river: color 1 winding corridor
    destination: one n×n solid square on the boundary
    movers: 2-3 different-colored n×n solid squares inside the same river
  preserved_from_source:
    - all active squares remain same-sized solid n×n blocks
    - movement still happens on the placement grid of feasible n×n windows
    - the winner still covers the destination and its old location becomes river
  changed_core:
    - source cardinality becomes many:1
    - every mover is evaluated against the same destination
    - only the mover with the shortest feasible-path distance reaches the target
    - safety tie-break only: topmost, then leftmost start wins if distances tie

  small trace:
    original:
      - detect two same-sized squares
      - sort by color -> first is mover, second is destination
      - run one BFS from that mover
    variant:
      - detect one boundary square as destination and the remaining same-sized
        interior squares as movers
      - run one BFS per mover on the same feasible-placement mask
      - compare destination distances across movers
      - move only the nearest reachable mover; all losing movers stay put
    visible difference:
      - input now shows several colored candidate blocks aiming at one red block
      - output changes exactly one of those candidate blocks

b) Complexity calibration
  - Movers stay as plain solid squares; the novelty comes only from multiplicity.
  - There are at most 3 movers, so the visual scene stays readable.
  - Generator avoids equal-distance races in normal samples, so humans can infer
    "nearest wins" from geometry instead of hidden conventions.
  - The winner color is randomized, so the task does not collapse to a color-id rule.

c) Implicit-assumption audit against the source main()
  - Source assumed exactly two relevant same-sized squares via:
      cand.sort(...); mover = cand[0]; dest = cand[1]
    This is invalid now. Replaced with:
      one unique boundary-touching square = destination
      all remaining same-sized squares = movers
  - Source river detection excluded only two square colors.
    Now it must exclude every relevant square color.
  - Source built one traversable mask and one BFS.
    Now the mask is shared, but BFS is repeated per mover.
  - Source cleared exactly one start square in the output.
    Still valid, but now it must clear only the winning mover.

d) Placement legality
  - Generator keeps one destination touching the outer border and keeps every mover
    strictly off the border so destination detection is unambiguous.
  - Movers are selected from well-separated river positions to avoid overlap and
    keep each square as its own monochromatic component.
  - All objects share the same size n and lie on feasible n×n river placements.

e) Visual observability
  - The rule is inferable from geometry: several same-sized colored blocks point to
    one red target; only the closest one disappears from its start and appears at
    the target.
  - Tie-breaking by color is intentionally not used as the main rule because it is
    not visually derivable from a few ARC examples.

f) Visual cleanliness
  - The grid still contains only four layers of meaning: bg, river, movers, target.
  - No extra glyphs or annotations are introduced.
  - Movers are capped at 3 and spaced apart, so the river is not visually cluttered.

g) Color-rule inferability
  - Colors only label different movers; they do not determine the winner.
  - The target keeps its dedicated color, preserving the original red goal cue.

New solver-side assumptions introduced here
------------------------------------------
  - Exactly one relevant n×n square touches the border; generator guarantees this.
  - At least two interior movers of the same size exist; generator guarantees this.
  - Generator strongly prefers a unique nearest reachable mover; solver keeps a
    top-left safety fallback only for unexpected ties.
"""


_BG, _RIVER, _DEST = 3, 1, 2
_MOVER_COLORS = [0, 4, 5, 6, 7, 8, 9]


def _touches_edge(r0: int, c0: int, n: int, H: int, W: int) -> bool:
    return r0 == 0 or c0 == 0 or r0 + n == H or c0 + n == W


def _bfs_placement(feasible: np.ndarray, sr: int, sc: int) -> np.ndarray:
    h2, w2 = feasible.shape
    dist = -np.ones((h2, w2), dtype=int)
    dist[sr, sc] = 0
    q = deque([(sr, sc)])
    while q:
        r, c = q.popleft()
        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
            rr, cc = r + dr, c + dc
            if 0 <= rr < h2 and 0 <= cc < w2 and feasible[rr, cc] and dist[rr, cc] == -1:
                dist[rr, cc] = dist[r, c] + 1
                q.append((rr, cc))
    return dist


def _find_square_components(g: np.ndarray, bg: int) -> list[dict]:
    squares: list[dict] = []
    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict"):
        col = int(comp["color"])
        b = comp["bbox"]
        if bbox_h(b) != bbox_w(b):
            continue
        patch = g[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1]
        if not bool((patch == col).all()):
            continue
        squares.append({"col": col, "r0": int(b[0]), "c0": int(b[1]), "n": int(bbox_h(b))})
    return squares


def _extract_scene(grid: np.ndarray) -> dict:
    g = np.array(grid, dtype=int)
    H, W = g.shape
    bg = int(Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0])

    squares = _find_square_components(g, bg)
    by_n: dict[int, list[dict]] = defaultdict(list)
    for sq in squares:
        by_n[int(sq["n"])].append(sq)

    candidates = [(len(v), n) for n, v in by_n.items() if len(v) >= 3]
    assert candidates
    n = max(candidates)[1]
    same = list(by_n[n])

    boundary = [sq for sq in same if _touches_edge(int(sq["r0"]), int(sq["c0"]), n, H, W)]
    assert len(boundary) == 1
    dest = boundary[0]
    movers = [sq for sq in same if (int(sq["r0"]), int(sq["c0"])) != (int(dest["r0"]), int(dest["c0"]))]
    assert len(movers) >= 2

    excluded_square_colors = {int(sq["col"]) for sq in same}
    river = None
    counts = Counter(map(int, g.flatten()))
    for col, _ct in counts.most_common():
        if col == bg or col in excluded_square_colors:
            continue
        river = int(col)
        break
    assert river is not None

    trav = (g == river)
    for sq in same:
        r0 = int(sq["r0"])
        c0 = int(sq["c0"])
        trav[r0 : r0 + n, c0 : c0 + n] = True

    h2 = H - n + 1
    w2 = W - n + 1
    assert h2 > 0 and w2 > 0
    feasible = np.zeros((h2, w2), dtype=bool)
    for r in range(h2):
        for c in range(w2):
            if bool(trav[r : r + n, c : c + n].all()):
                feasible[r, c] = True

    dr, dc = int(dest["r0"]), int(dest["c0"])
    assert feasible[dr, dc]
    for mv in movers:
        assert feasible[int(mv["r0"]), int(mv["c0"])]

    return {
        "grid": g,
        "H": H,
        "W": W,
        "bg": bg,
        "river": river,
        "n": n,
        "dest": dest,
        "movers": movers,
        "feasible": feasible,
    }


def _profile_mover(feasible: np.ndarray, mover: dict, dest: dict) -> dict:
    sr, sc = int(mover["r0"]), int(mover["c0"])
    dr, dc = int(dest["r0"]), int(dest["c0"])
    dist = _bfs_placement(feasible, sr, sc)
    dest_dist = int(dist[dr, dc]) if 0 <= dr < dist.shape[0] and 0 <= dc < dist.shape[1] else -1

    best = -1
    farthest = (sr, sc)
    for r in range(dist.shape[0]):
        for c in range(dist.shape[1]):
            if int(dist[r, c]) > best:
                best = int(dist[r, c])
                farthest = (r, c)

    return {
        "mover": mover,
        "start": (sr, sc),
        "dist": dist,
        "dest_dist": dest_dist,
        "best_dist": best,
        "farthest": farthest,
    }


def _solve_competition(grid: np.ndarray, return_meta: bool = False):
    scene = _extract_scene(grid)
    g = scene["grid"]
    n = int(scene["n"])
    river = int(scene["river"])
    dest = scene["dest"]
    dr, dc = int(dest["r0"]), int(dest["c0"])

    profiles = [_profile_mover(scene["feasible"], mover, dest) for mover in scene["movers"]]
    reachable = [p for p in profiles if int(p["dest_dist"]) >= 0]

    if reachable:
        winner = min(reachable, key=lambda p: (int(p["dest_dist"]), int(p["start"][0]), int(p["start"][1])))
        tr, tc = dr, dc
        mode = "target"
    else:
        winner = sorted(profiles, key=lambda p: (-int(p["best_dist"]), int(p["start"][0]), int(p["start"][1])))[0]
        tr, tc = map(int, winner["farthest"])
        mode = "fallback"

    out = g.copy()
    sr, sc = map(int, winner["start"])
    out[sr : sr + n, sc : sc + n] = river
    out[tr : tr + n, tc : tc + n] = int(winner["mover"]["col"])

    if return_meta:
        return out, {
            "scene": scene,
            "profiles": profiles,
            "reachable_profiles": reachable,
            "winner": winner,
            "winner_mode": mode,
            "winner_target_dist": None if mode != "target" else int(winner["dest_dist"]),
            "num_movers": len(scene["movers"]),
        }
    return out


def main(grid: np.ndarray) -> np.ndarray:
    """
    Many same-sized colored squares share one boundary target on the river.

    Each mover is evaluated independently on the same feasible n×n placement mask.
    The unique nearest reachable mover wins the race to the single destination.
    Only that winner moves; all losing movers remain in place.
    """
    return _solve_competition(grid)


def _hamiltonian_walk(rows: int, cols: int, start: tuple[int, int], end: tuple[int, int]):
    total = rows * cols
    best_path = None
    best_len = 0
    for _attempt in range(80):
        visited = {start}
        path = [start]
        cur = start
        while True:
            if cur == end and len(path) >= total * 0.7:
                if len(path) > best_len:
                    best_path = list(path)
                    best_len = len(path)
                break
            neighbors = []
            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nr, nc = cur[0] + dr, cur[1] + dc
                if 0 <= nr < rows and 0 <= nc < cols and (nr, nc) not in visited:
                    neighbors.append((nr, nc))
            if not neighbors:
                break
            valid = []
            for nb in neighbors:
                if nb == end:
                    valid.append(nb)
                    continue
                test_visited = visited | {nb}
                seen = {end}
                q = deque([end])
                while q:
                    cr, cc = q.popleft()
                    for dr2, dc2 in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                        nr2, nc2 = cr + dr2, cc + dc2
                        if (0 <= nr2 < rows and 0 <= nc2 < cols and
                                (nr2, nc2) not in test_visited and (nr2, nc2) not in seen):
                            seen.add((nr2, nc2))
                            q.append((nr2, nc2))
                for dr2, dc2 in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                    ar, ac = nb[0] + dr2, nb[1] + dc2
                    if (0 <= ar < rows and 0 <= ac < cols and
                            (ar, ac) not in test_visited and (ar, ac) in seen):
                        valid.append(nb)
                        break
            if not valid:
                break
            random.shuffle(valid)
            nxt = valid[0]
            visited.add(nxt)
            path.append(nxt)
            cur = nxt
        if best_path and best_len >= total * 0.85:
            break
    return best_path


def _render_channel(grid: np.ndarray, path: list[tuple[int, int]], n: int,
                    offsets_r: list[int], offsets_c: list[int]) -> list[tuple[int, int]]:
    pixel_pos = []
    for cr, cc in path:
        pr, pc = offsets_r[cr], offsets_c[cc]
        pixel_pos.append((pr, pc))
        grid[pr : pr + n, pc : pc + n] = _RIVER
    for i in range(len(path) - 1):
        pr1, pc1 = pixel_pos[i]
        pr2, pc2 = pixel_pos[i + 1]
        if pr1 == pr2:
            c_lo, c_hi = min(pc1, pc2), max(pc1, pc2) + n
            grid[pr1 : pr1 + n, c_lo:c_hi] = _RIVER
        else:
            r_lo, r_hi = min(pr1, pr2), max(pr1, pr2) + n
            grid[r_lo:r_hi, pc1 : pc1 + n] = _RIVER
    return pixel_pos


def _add_chokepoint(grid: np.ndarray, pixel_pos_i: tuple[int, int], pixel_pos_j: tuple[int, int],
                    n: int, direction: str) -> None:
    H, W = grid.shape
    pr1, pc1 = pixel_pos_i
    pr2, pc2 = pixel_pos_j
    narrow_w = random.randint(1, n - 1)
    remove = n - narrow_w
    side = random.randint(0, 1)

    if direction == "h":
        c_lo = min(pc1, pc2) + n
        c_hi = max(pc1, pc2)
        if c_hi <= c_lo:
            c_lo, c_hi = min(pc1, pc2), max(pc1, pc2) + n
        hold_len = random.randint(1, min(6, max(1, c_hi - c_lo - 2 * remove)))
        total_len = 2 * remove + hold_len
        c_mid = (c_lo + c_hi) // 2
        c_start = max(c_lo, c_mid - total_len // 2)
        for step in range(total_len):
            c = c_start + step
            if not (0 <= c < W):
                continue
            if step < remove:
                depth = step + 1
            elif step >= total_len - remove:
                depth = total_len - step
            else:
                depth = remove
            for k in range(depth):
                rr = pr1 + k if side == 0 else pr1 + n - 1 - k
                if 0 <= rr < H:
                    grid[rr, c] = _BG
    else:
        r_lo = min(pr1, pr2) + n
        r_hi = max(pr1, pr2)
        if r_hi <= r_lo:
            r_lo, r_hi = min(pr1, pr2), max(pr1, pr2) + n
        hold_len = random.randint(1, min(6, max(1, r_hi - r_lo - 2 * remove)))
        total_len = 2 * remove + hold_len
        r_mid = (r_lo + r_hi) // 2
        r_start = max(r_lo, r_mid - total_len // 2)
        for step in range(total_len):
            r = r_start + step
            if not (0 <= r < H):
                continue
            if step < remove:
                depth = step + 1
            elif step >= total_len - remove:
                depth = total_len - step
            else:
                depth = remove
            for k in range(depth):
                cc = pc1 + k if side == 0 else pc1 + n - 1 - k
                if 0 <= cc < W:
                    grid[r, cc] = _BG


def _river_connected(grid: np.ndarray) -> bool:
    mask = (grid == _RIVER)
    if not bool(mask.any()):
        return False
    _labeled, num = scipy_label(mask.astype(int))
    return int(num) == 1


def _compute_offsets(G: int, n: int, num_coarse: int):
    if num_coarse == 1:
        return [1]
    first = 1
    last = G - n - 1
    if last < first:
        return None
    step = (last - first) / (num_coarse - 1)
    return [int(round(first + i * step)) for i in range(num_coarse)]


def _extend_to_edge(grid: np.ndarray, pr: int, pc: int, n: int):
    H, W = grid.shape
    candidates = []
    for direction in ("top", "bottom", "left", "right"):
        if direction == "top":
            dist = pr
            if dist == 0:
                candidates.append((0, pc, 0))
            elif all(grid[r, c] in (_BG, _RIVER) for r in range(pr) for c in range(pc, pc + n) if c < W):
                candidates.append((0, pc, dist))
        elif direction == "bottom":
            dist = H - (pr + n)
            if dist == 0:
                candidates.append((pr, pc, 0))
            elif all(grid[r, c] in (_BG, _RIVER) for r in range(pr + n, H) for c in range(pc, pc + n) if c < W):
                candidates.append((H - n, pc, dist))
        elif direction == "left":
            dist = pc
            if dist == 0:
                candidates.append((pr, 0, 0))
            elif all(grid[r, c] in (_BG, _RIVER) for r in range(pr, pr + n) for c in range(pc) if r < H):
                candidates.append((pr, 0, dist))
        else:
            dist = W - (pc + n)
            if dist == 0:
                candidates.append((pr, pc, 0))
            elif all(grid[r, c] in (_BG, _RIVER) for r in range(pr, pr + n) for c in range(pc + n, W) if r < H):
                candidates.append((pr, W - n, dist))
    if not candidates:
        return None
    candidates.sort(key=lambda x: x[2])
    return candidates[0][:2]


def _choose_mover_indices(pixel_pos: list[tuple[int, int]], n: int, H: int, W: int):
    interior = [
        i for i, (r, c) in enumerate(pixel_pos[:-1])
        if not _touches_edge(r, c, n, H, W)
    ]
    if len(interior) < 2:
        return None

    preferred_winners = [
        i for i in interior
        if max(2, len(pixel_pos) // 3) <= i <= len(pixel_pos) - 4
    ]
    if not preferred_winners:
        return None

    target_num = 3 if len(interior) >= 7 and random.random() < 0.6 else 2
    random.shuffle(preferred_winners)
    for winner_idx in preferred_winners:
        earlier = [i for i in interior if i <= winner_idx - 3]
        random.shuffle(earlier)
        chosen = [winner_idx]
        for idx in earlier:
            if all(abs(idx - j) >= 3 for j in chosen):
                chosen.append(idx)
            if len(chosen) >= target_num:
                break
        if len(chosen) >= 2:
            return sorted(chosen)
    return None


def _gen_attempt():
    n = random.choice([1, 2, 3, 4])
    min_size = max(10, 5 * n)
    if min_size > 20:
        return None
    G = random.randint(min_size, 20)
    H = W = G

    min_spacing = n + 1
    max_coarse = max(3, (G - 2) // min_spacing)
    coarse_dim = random.randint(3, min(6, max_coarse))
    offsets_r = _compute_offsets(G, n, coarse_dim)
    offsets_c = _compute_offsets(G, n, coarse_dim)
    if offsets_r is None or offsets_c is None:
        return None
    if any(offsets_r[i + 1] - offsets_r[i] < n for i in range(len(offsets_r) - 1)):
        return None
    if any(offsets_c[i + 1] - offsets_c[i] < n for i in range(len(offsets_c) - 1)):
        return None

    edge_cells = set()
    for c in range(coarse_dim):
        edge_cells.add((0, c))
        edge_cells.add((coarse_dim - 1, c))
    for r in range(1, coarse_dim - 1):
        edge_cells.add((r, 0))
        edge_cells.add((r, coarse_dim - 1))
    edge_cells = list(edge_cells)
    random.shuffle(edge_cells)
    start_coarse = edge_cells[0]
    far = sorted(edge_cells, key=lambda e: -(abs(e[0] - start_coarse[0]) + abs(e[1] - start_coarse[1])))
    end_coarse = far[0] if far[0] != start_coarse else far[1]

    walk = _hamiltonian_walk(coarse_dim, coarse_dim, start_coarse, end_coarse)
    if walk is None or len(walk) < 7:
        return None

    grid = np.full((H, W), _BG, dtype=int)
    pixel_pos = _render_channel(grid, walk, n, offsets_r, offsets_c)

    mask = (grid == _RIVER)
    area_ratio = float(mask.sum()) / float(H * W)
    if not (0.18 <= area_ratio <= 0.62):
        return None

    dest_r, dest_c = pixel_pos[-1]
    extended = _extend_to_edge(grid, dest_r, dest_c, n)
    if extended is None:
        return None
    new_dest_r, new_dest_c = extended
    if new_dest_r != dest_r:
        r_lo, r_hi = min(new_dest_r, dest_r), max(new_dest_r, dest_r) + n
        grid[r_lo:r_hi, dest_c : dest_c + n] = _RIVER
    if new_dest_c != dest_c:
        c_lo, c_hi = min(new_dest_c, dest_c), max(new_dest_c, dest_c) + n
        grid[dest_r : dest_r + n, c_lo:c_hi] = _RIVER
    dest_r, dest_c = new_dest_r, new_dest_c
    if not _touches_edge(dest_r, dest_c, n, H, W):
        return None

    mover_indices = _choose_mover_indices(pixel_pos, n, H, W)
    if mover_indices is None:
        return None
    winner_idx = max(mover_indices)

    use_choke = n >= 2 and len(mover_indices) >= 2 and random.random() < 0.45
    if use_choke:
        choke_lo = max(mover_indices[:-1]) + 1
        choke_hi = winner_idx - 1
        if choke_lo > choke_hi:
            return None
        choke_idx = random.randint(choke_lo, choke_hi)
        pr1, pc1 = pixel_pos[choke_idx]
        pr2, pc2 = pixel_pos[choke_idx + 1]
        direction = "h" if pr1 == pr2 else "v"
        _add_chokepoint(grid, (pr1, pc1), (pr2, pc2), n, direction)
        if not _river_connected(grid):
            return None

    mover_colors = random.sample(_MOVER_COLORS, len(mover_indices))
    winner_start = pixel_pos[winner_idx]
    winner_color = mover_colors[mover_indices.index(winner_idx)]

    for idx, col in zip(mover_indices, mover_colors):
        r0, c0 = pixel_pos[idx]
        if _touches_edge(r0, c0, n, H, W):
            return None
        grid[r0 : r0 + n, c0 : c0 + n] = int(col)
    grid[dest_r : dest_r + n, dest_c : dest_c + n] = _DEST

    try:
        expected, meta = _solve_competition(grid, return_meta=True)
    except Exception:
        return None

    if meta["winner_mode"] != "target":
        return None
    if tuple(meta["winner"]["start"]) != tuple(winner_start):
        return None

    reachable_count = sum(int(p["dest_dist"]) >= 0 for p in meta["profiles"])
    if use_choke and reachable_count >= len(mover_indices):
        return None
    if not use_choke and reachable_count < 2:
        return None

    dest_distances = sorted(int(p["dest_dist"]) for p in meta["profiles"] if int(p["dest_dist"]) >= 0)
    if len(dest_distances) >= 2 and dest_distances[0] == dest_distances[1]:
        return None

    out = main(grid)
    if not np.array_equal(out, expected):
        return None
    if int(out[dest_r, dest_c]) != int(winner_color):
        return None
    return grid


def generate_input():
    for _ in range(400):
        result = _gen_attempt()
        if result is not None:
            return result
    raise RuntimeError("Failed to generate valid input after 400 attempts")

