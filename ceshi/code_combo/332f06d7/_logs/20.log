+    stripe_count = random.choice([2, 3] if W < 24 else [3, 4])
+    thick = random.choice([1, 2] if n <= 2 else [2, 3])
+    centers = np.linspace(W / (stripe_count + 1), W * stripe_count / (stripe_count + 1), stripe_count)
+    starts = []
+    for center in centers:
