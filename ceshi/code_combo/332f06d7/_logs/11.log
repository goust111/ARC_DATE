+    return None
+
+
+def _target_specs(
+    main_end: tuple[int, int],
+    branch_ends: list[tuple[int, int]],
+) -> list[dict[str, int]]:
+    colors = random.sample(_TARGET_COLORS, 1 + len(branch_ends))
+    specs = [{"r": int(main_end[0]), "c": int(main_end[1]), "col": int(colors[0]), "selected": 1}]
