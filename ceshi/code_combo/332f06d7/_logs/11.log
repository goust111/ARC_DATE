+        branch_dir_1 = -1
+        branch_dir_2 = 1
+    else:
+        r0, r1, r2 = b, c, a
+        branch_dir_1 = 1
+        branch_dir_2 = -1
+
+    c1_lo = 4
+    c1_hi = min(max(4, w2 // 3), w2 - 6)
+    if c1_hi < c1_lo:
+        return None
+    c1 = random.randint(c1_lo, c1_hi)
+    c2_lo = c1 + 3
+    c2_hi = w2 - 4
+    if c2_hi < c2_lo:
+        return None
+    c2 = random.randint(c2_lo, c2_hi)
+
+    start = (r0, 1)
+    p1 = (r0, c1)
+    p2 = (r1, c1)
+    p3 = (r1, c2)
+    p4 = (r2, c2)
+    main_end = (r2, w2 - 1)
+    trunk = _concat_segments([start, p1, p2, p3, p4, main_end])
+    if len(trunk) != len(set(trunk)):
+        return None
+    placements = set(trunk)
