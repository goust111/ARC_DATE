+        cut_idx = random.randint(cut_lo, cut_hi)
+
+    if cut_idx is not None:
+        _color_main_suffix(grid, main_pixels, cut_idx, n, (dest_r, dest_c))
+
+    grid[mover_r : mover_r + n, mover_c : mover_c + n] = _MOVER
