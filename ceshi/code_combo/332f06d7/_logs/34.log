+
+from collections import Counter, defaultdict, deque
+import random
+
+import numpy as np
+
+from arc_utils import bbox_h, bbox_w, find_components
+
+
+"""
+design_analysis:
+  fused_rule:
+    - 河道现在有两种蓝色语义:
+      - 深蓝(1) = 该段对任意 n 都足够宽
+      - 浅蓝(8) = 只对 n=1 等价可通，对 n>=2 语义上等价“窄于 n 的卡点”
+    - 输出也有两种终态:
+      - 成功到达红块: 黑块覆盖红块
+      - 被卡住: 黑块不会继续滑向其他支路，而是停在通往红块的主路上、第一段浅蓝前的最后一个深蓝停泊位，并变成橙色(7)
+  behavior_trace:
