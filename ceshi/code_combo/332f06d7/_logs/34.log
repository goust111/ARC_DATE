+def _bfs(feasible: np.ndarray, sr: int, sc: int, with_parent: bool = False):
+    h2, w2 = feasible.shape
+    dist = -np.ones((h2, w2), dtype=int)
+    parent: dict[tuple[int, int], tuple[int, int] | None] | None = {(sr, sc): None} if with_parent else None
+    dist[sr, sc] = 0
+    q = deque([(sr, sc)])
+    while q:
