+    gate_sequence = []
+    reqs = [h, w, h, w, h]
+    reqs_swapped = [w, h, w, h, w]
+    for idx, width in enumerate(seg_widths):
+        axis = "h" if idx % 2 == 0 else "v"
+        gate_sequence.append(
