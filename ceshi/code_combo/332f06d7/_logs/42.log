+                "width": int(width),
+                "req": int(reqs[idx]),
+                "req_swapped": int(reqs_swapped[idx]),
+                "passable": bool(width >= reqs[idx]),
+                "passable_swapped": bool(width >= reqs_swapped[idx]),
