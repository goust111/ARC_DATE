+    while True:
+        path.append((top + r, left + c))
+        used[r, c] = True
+        moved = False
+        for turn in range(4):
+            nd = (d + turn) % 4
+            dr, dc = dirs[nd]
+            nr, nc = r + dr, c + dc
+            if not (0 <= nr < rows and 0 <= nc < cols) or bool(used[nr, nc]):
+                continue
+            blocked = False
+            for adr, adc in dirs:
+                ar, ac = nr + adr, nc + adc
+                if 0 <= ar < rows and 0 <= ac < cols and bool(used[ar, ac]) and (ar, ac) != (r, c):
