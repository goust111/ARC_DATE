+    elif c2 == c1 and r2 == r1 + 1:
+        row = r2 + n - 1
+        for cc in range(n):
+            if not bool(keep_mask[cc]):
+                grid[row, c2 + cc] = _BG
+    elif c2 == c1 and r2 == r1 - 1:
+        row = r2
+        for cc in range(n):
