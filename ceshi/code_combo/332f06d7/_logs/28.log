+
+    if 0 <= dr < h2 and 0 <= dc < w2 and bool(feasible[dr, dc]) and int(dist[dr, dc]) >= 0:
+        return dr, dc
+
+    best = -1
+    tr, tc = sr, sc
+    for r in range(h2):
+        for c in range(w2):
+            if int(dist[r, c]) > best:
+                best = int(dist[r, c])
+                tr, tc = r, c
