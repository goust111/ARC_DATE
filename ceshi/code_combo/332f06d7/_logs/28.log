    cnt = Counter(map(int, g.flatten()))
    bg = int(max((c for c in cnt.keys() if int(c) != BORDER), key=lambda c: int(cnt[int(c)])))

    containers = _find_containers(g)
    assert containers

    out = g.copy()

    for cont in containers:
        box = cont["box"]
        r0, c0, r1, c1 = box


