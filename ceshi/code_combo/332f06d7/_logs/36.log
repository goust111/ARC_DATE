import importlib.util
import numpy as np
from collections import Counter, defaultdict
from arc_utils import bbox_h, bbox_w, find_components

combo_spec = importlib.util.spec_from_file_location('combo', '/home/lixinyu/snap/new/ceshi/code_combo/332f06d7/36/code.py')
combo = importlib.util.module_from_spec(combo_spec)
combo_spec.loader.exec_module(combo)
base_spec = importlib.util.spec_from_file_location('base', '/home/lixinyu/snap/new/arc2_solver_select/332f06d7.py')
base = importlib.util.module_from_spec(base_spec)
base_spec.loader.exec_module(base)

def edge_distance(r0, c0, n, H, W):
    return min(r0, c0, H - (r0 + n), W - (c0 + n))

samples = 80
stats = Counter()
for _ in range(samples):
    grid = combo.generate_input()
    out = combo.main(grid)
    H, W = grid.shape
    corners = [int(grid[0,0]), int(grid[0,-1]), int(grid[-1,0]), int(grid[-1,-1])]
    bg = Counter(corners).most_common(1)[0][0]
    counts = Counter(map(int, grid.flatten()))
    if bg == 1:
        stats['blue_corner_bg'] += 1
    if 3 in counts:
        stats['green_river_present'] += 1
    if counts[1] > counts[3]:
        stats['bg_area_gt_river_area'] += 1
    comps = []
    for comp in find_components(grid, bg=bg, connectivity=4, monochromatic=True, return_format='dict'):
        col = int(comp['color'])
        b = comp['bbox']
        if bbox_h(b) "'!= bbox_w(b):
            continue
        patch = grid[int(b[0]):int(b[2])+1, int(b[1]):int(b[3])+1]
        if not (patch == col).all():
            continue
        comps.append({'"'col': col, 'r0': int(b[0]), 'c0': int(b[1]), 'n': int(bbox_h(b))})
    by_n = defaultdict(list)
    for c in comps:
        by_n[c['n']].append(c)
    nside = max(by_n.items(), key=lambda kv: (len(kv[1]), kv[0]))[0]
    cand = by_n[nside]
    annotated = sorted(
        [(edge_distance(sq['r0'], sq['c0'], sq['n'], H, W), sq['r0'], sq['c0'], sq) for sq in cand],
        key=lambda x: (x[0], x[1], x[2]),
    )
    dest = annotated[0][3]
    mover = annotated[-1][3]
    if mover['col'] > dest['col']:
        stats['position_vs_color_sort_disagree'] += 1
    if not np.array_equal(base.main(grid), out):
        stats['base_solver_output_diff'] += 1
    if np.array_equal(out[dest['r0']:dest['r0']+dest['n'], dest['c0']:dest['c0']+dest['n']], np.full((dest['n'], dest['n']), mover['col'])):
        stats['reachable'] += 1
    else:
        stats['stuck'] += 1
print(dict(stats), 'samples=', samples)
