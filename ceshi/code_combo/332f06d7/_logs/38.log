+            return None
+
+    for spec in selected_targets[:reachable_selected_count]:
+        rr, cc = int(spec["r"]), int(spec["c"])
+        if not bool((out[rr : rr + n, cc : cc + n] == _MOVER).all()):
+            return None
+    for spec in selected_targets[reachable_selected_count:]:
+        rr, cc = int(spec["r"]), int(spec["c"])
