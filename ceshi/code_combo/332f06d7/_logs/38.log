            ```python
            # Variant of 332f06d7
# Dimension: D17 — src-dst 基数关系 (meta)
# Change: 1:1 关系——一个移动体对应一个目标... → 一移动体对多目标 (1:many)

from __future__ import annotations

from collections import Counter, defaultdict, deque
import random

import numpy as np
from scipy.ndimage import label as scipy_label

from arc_utils import bbox_h, bbox_w, find_components


# Design analysis for the D17 variant
# a) Concrete behavior / trace
#    Input still shows one black n x n square moving inside one blue winding corridor on green background.
#    The visible change is that there are now 2-4 red n x n target squares of the same size on later parts
#    of the same corridor, rather than exactly one red square. In the output the black square advances through
#    the corridor, every red square that is reachable before the first true bottleneck disappears into blue,
#    and the black square ends either on the last reachable red square (if all targets are reachable) or at the
#    farthest feasible placement before the first too-narrow chokepoint. Any downstream unreachable red squares
#    remain red.
#    Small trace:
#    - Original: mover at A, one target at C. If C reachable, output leaves black at C; otherwise at farthest B.
#    - Variant: mover at A, targets at B/C/D in path order. If B and C reachable but D lies beyond a chokepoint,
#      output clears B and C to blue and leaves black at the farthest feasible placement before the chokepoint.
#      If all B/C/D are reachable, B and C are cleared and black ends on D.
#    The algorithmic change is therefore not in "how a square slides", but in "how many target squares are
#    consumed before stopping" and in the output cleanup of already-visited targets.
#
# b) Complexity calibration
#    The variant keeps only one mover and one target color, so object typing stays visually simple. The new
#    degree of freedom is only the count of red targets (2-4) plus whether all are reachable. This is enough
#    to make the change visible without introducing branches or extra color semantics. Generator examples are
#    forced to contain multiple targets, and blocked cases are forced to have both reachable and unreachable
#    targets so the 1:many behavior is not degenerate.
#
# c) Hidden assumptions in the original solver that break under D17
#    - "Choose the size that appears at least twice" is no longer enough; now the relevant size appears at
#      least three times (1 mover + many targets), and there may be multiple red components.
#    - "Sort by color and pick exactly two squares" relied on the old 1:1 cardinality and on invisible numeric
#      color ordering. That is invalid here. The new solver instead detects one singleton color component as
#      the mover and one repeated color as the targets, both at the same square size.
#    - "Destination = one top-left coordinate" is invalid; the solver must reason over a target set.
#    - "If destination unreachable, keep the unique red target unchanged" is also invalid. Now some earlier
#      red targets may be reachable and must be cleared even when a later target is not.
#
# d) Placement legality
#    Generator places every target as a separate solid n x n component with at least one blue-cell gap in
#    4-connectivity terms, so same-color targets do not merge into a single non-square component. All squares
#    stay inside the grid. Chokepoints are inserted only between already separated target positions. The final
#    input is validated by feasible-placement BFS before being accepted.
#
# e) Visual observability
#    The new rule is visible in 2-3 examples: multiple red squares lie ahead on the same river, some outputs
#    erase all reds, others erase only a prefix and leave later reds untouched. No invisible numeric ordering
#    is needed for the human solver; the ordering is the spatial order along the corridor.
#
# f) Visual cleanliness
#    The variant avoids extra markers and keeps the original palette. Targets are spaced apart so the red
#    squares remain separate, readable objects rather than one merged blob. Only one black square is present
#    in the output, preserving the original visual grammar.
#
# g) Color inference
#    Colors retain their original roles: green background, blue corridor, black mover, red targets. The new
#    logic does not depend on numeric color values for sorting; it depends on visible multiplicity:
#    one black-like role object vs multiple same-colored target objects of the same size.
#
# 9) New solver assumptions and how the generator guarantees them
#    - All relevant solid squares share one size n. Generator constructs mover and every target with that n.
#    - Exactly one color occurs once at that size (mover), and one color occurs multiple times at that size
#      (targets). Generator enforces this.
#    - Reachable targets form a path-order prefix of the target list. Generator places targets along one
#      corridor and validates that reachability is a prefix, so "consume all reachable targets" matches the
#      intended sequential narrative.


_BG, _RIVER, _MOVER, _DEST = 3, 1, 0, 2


def _find_square_roles(g: np.ndarray):
    bg = int(Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0])

    squares: list[dict] = []
    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict"):
        col = int(comp["color"])
        b = comp["bbox"]
        if bbox_h(b) != bbox_w(b):
            continue
        patch = g[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1]
        if not bool((patch == col).all()):
            continue
        squares.append({"col": col, "r0": int(b[0]), "c0": int(b[1]), "n": int(bbox_h(b))})

    assert len(squares) >= 3

    candidates = []
    by_n: dict[int, list[dict]] = defaultdict(list)
    for sq in squares:
        by_n[int(sq["n"])].append(sq)

    for nside, group in by_n.items():
        by_color: dict[int, list[dict]] = defaultdict(list)
        for sq in group:
            by_color[int(sq["col"])].append(sq)
        singletons = [col for col, parts in by_color.items() if len(parts) == 1]
        repeated = [col for col, parts in by_color.items() if len(parts) >= 2]
        if not singletons or not repeated:
            continue
        candidates.append((len(group), nside, singletons, repeated, by_color))

    assert candidates
    _total, n, singletons, repeated, by_color = max(candidates, key=lambda item: (item[0], item[1]))

    def edge_margin(sq: dict) -> int:
        H, W = g.shape
        return min(int(sq["r0"]), int(H - (sq["r0"] + sq["n"])), int(sq["c0"]), int(W - (sq["c0"] + sq["n"])))

    if len(singletons) == 1:
        mover_col = int(singletons[0])
    else:
        mover_col = min(singletons, key=lambda col: edge_margin(by_color[int(col)][0]))
    if len(repeated) == 1:
        target_col = int(repeated[0])
    else:
        target_col = max(repeated, key=lambda col: len(by_color[int(col)]))

    mover = dict(by_color[int(mover_col)][0])
    targets = sorted(
        (dict(sq) for sq in by_color[int(target_col)]),
        key=lambda sq: (int(sq["r0"]), int(sq["c0"])),
    )

    counts = Counter(map(int, g.flatten()))
    river = None
    for col, _ct in counts.most_common():
        if int(col) == int(bg):
            continue
        if int(col) in (int(mover_col), int(target_col)):
            continue
        river = int(col)
        break
    assert river is not None
    return bg, river, mover, targets, int(n), int(target_col)


def _placement_dist(g: np.ndarray, n: int, sr: int, sc: int, river: int, mover_col: int, target_col: int):
    H, W = g.shape
    trav = (g == river) | (g == mover_col) | (g == target_col)
    h2 = int(H - n + 1)
    w2 = int(W - n + 1)
    assert h2 > 0 and w2 > 0
    assert 0 <= sr < h2 and 0 <= sc < w2

    feasible = np.zeros((h2, w2), dtype=bool)
    for r in range(h2):
        for c in range(w2):
            feasible[r, c] = bool(trav[r : r + n, c : c + n].all())
    assert bool(feasible[sr, sc])

    dist = -np.ones((h2, w2), dtype=int)
    q = deque([(int(sr), int(sc))])
    dist[int(sr), int(sc)] = 0
    while q:
        r, c = q.popleft()
        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
            rr, cc = int(r + dr), int(c + dc)
            if 0 <= rr < h2 and 0 <= cc < w2 and bool(feasible[rr, cc]) and int(dist[rr, cc]) == -1:
                dist[rr, cc] = int(dist[r, c] + 1)
                q.append((rr, cc))
    return feasible, dist


def _solve_details(grid: np.ndarray):
    g = np.array(grid, dtype=int)
    _bg, river, mover, targets, n, target_col = _find_square_roles(g)

    sr, sc = int(mover["r0"]), int(mover["c0"])
    feasible, dist = _placement_dist(g, n, sr, sc, river, int(mover["col"]), int(target_col))

    reachable_targets = []
    unreachable_targets = []
    for sq in targets:
        r0, c0 = int(sq["r0"]), int(sq["c0"])
        ok = 0 <= r0 < feasible.shape[0] and 0 <= c0 < feasible.shape[1] and bool(feasible[r0, c0]) and int(dist[r0, c0]) >= 0
        (reachable_targets if ok else unreachable_targets).append(dict(sq))

    if len(reachable_targets) == len(targets):
        final_target = max(
            reachable_targets,
            key=lambda sq: (int(dist[int(sq["r0"]), int(sq["c0"])]), int(sq["r0"]), int(sq["c0"])),
        )
        tr, tc = int(final_target["r0"]), int(final_target["c0"])
    else:
        best = -1
        tr, tc = int(sr), int(sc)
        for r in range(dist.shape[0]):
            for c in range(dist.shape[1]):
                cand = int(dist[r, c])
                if cand > best:
                    best = cand
                    tr, tc = int(r), int(c)

    out = g.copy()
    out[int(sr) : int(sr + n), int(sc) : int(sc + n)] = int(river)
    for sq in reachable_targets:
        rr, cc = int(sq["r0"]), int(sq["c0"])
        out[rr : rr + n, cc : cc + n] = int(river)
    out[int(tr) : int(tr + n), int(tc) : int(tc + n)] = int(mover["col"])

    return {
        "out": out,
        "river": int(river),
        "mover": mover,
        "targets": targets,
        "reachable_targets": reachable_targets,
        "unreachable_targets": unreachable_targets,
        "final_pos": (int(tr), int(tc)),
        "n": int(n),
        "dist": dist,
    }


def main(grid: np.ndarray) -> np.ndarray:
    """
    Variant rule:
    - There is one solid mover square and multiple same-sized destination squares on the river.
    - The mover can occupy only n x n windows fully covered by traversable cells.
    - Every reachable destination square is visited in corridor order and then left behind as river.
    - If all destination squares are reachable, the mover ends on the farthest destination.
    - Otherwise it continues after the last reached destination and stops at the farthest reachable placement.
    """
    return _solve_details(np.array(grid, dtype=int))["out"]


def _bfs_placement(feasible: np.ndarray, sr: int, sc: int) -> np.ndarray:
    h2, w2 = feasible.shape
    dist = -np.ones((h2, w2), dtype=int)
    dist[sr, sc] = 0
    q = deque([(sr, sc)])
    while q:
        r, c = q.popleft()
        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
            rr, cc = r + dr, c + dc
            if 0 <= rr < h2 and 0 <= cc < w2 and feasible[rr, cc] and dist[rr, cc] == -1:
                dist[rr, cc] = dist[r, c] + 1
                q.append((rr, cc))
    return dist


def _hamiltonian_walk(rows: int, cols: int, start: tuple[int, int], end: tuple[int, int]):
    total = rows * cols
    best_path = None
    best_len = 0
    for _attempt in range(80):
        visited = {start}
        path = [start]
        cur = start
        while True:
            if cur == end and len(path) >= total * 0.7:
                if len(path) > best_len:
                    best_path = list(path)
                    best_len = len(path)
                break
            neighbors = []
            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nr, nc = cur[0] + dr, cur[1] + dc
                if 0 <= nr < rows and 0 <= nc < cols and (nr, nc) not in visited:
                    neighbors.append((nr, nc))
            if not neighbors:
                break
            valid = []
            for nb in neighbors:
                if nb == end:
                    valid.append(nb)
                    continue
                test_visited = visited | {nb}
                seen = {end}
                q = deque([end])
                while q:
                    cr, cc = q.popleft()
                    for dr2, dc2 in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                        nr2, nc2 = cr + dr2, cc + dc2
                        if 0 <= nr2 < rows and 0 <= nc2 < cols and (nr2, nc2) not in test_visited and (nr2, nc2) not in seen:
                            seen.add((nr2, nc2))
                            q.append((nr2, nc2))
                for dr2, dc2 in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                    ar, ac = nb[0] + dr2, nb[1] + dc2
                    if 0 <= ar < rows and 0 <= ac < cols and (ar, ac) not in test_visited and (ar, ac) in seen:
                        valid.append(nb)
                        break
            if not valid:
                break
            random.shuffle(valid)
            nxt = valid[0]
            visited.add(nxt)
            path.append(nxt)
            cur = nxt
        if best_path and best_len >= total * 0.85:
            break
    return best_path


def _render_channel(grid: np.ndarray, path, n: int, offsets_r: list[int], offsets_c: list[int]):
    pixel_pos = []
    for cr, cc in path:
        pr, pc = offsets_r[cr], offsets_c[cc]
        pixel_pos.append((pr, pc))
        grid[pr : pr + n, pc : pc + n] = _RIVER
    for i in range(len(path) - 1):
        pr1, pc1 = pixel_pos[i]
        pr2, pc2 = pixel_pos[i + 1]
        if pr1 == pr2:
            c_lo, c_hi = min(pc1, pc2), max(pc1, pc2) + n
            grid[pr1 : pr1 + n, c_lo:c_hi] = _RIVER
        else:
            r_lo, r_hi = min(pr1, pr2), max(pr1, pr2) + n
            grid[r_lo:r_hi, pc1 : pc1 + n] = _RIVER
    return pixel_pos


def _add_chokepoint(grid: np.ndarray, pixel_pos_i: tuple[int, int], pixel_pos_j: tuple[int, int], n: int, direction: str):
    H, W = grid.shape
    pr1, pc1 = pixel_pos_i
    pr2, pc2 = pixel_pos_j
    narrow_w = random.randint(1, n - 1)
    remove = n - narrow_w
    side = random.randint(0, 1)

    if direction == "h":
        c_lo = min(pc1, pc2) + n
        c_hi = max(pc1, pc2)
        if c_hi <= c_lo:
            c_lo, c_hi = min(pc1, pc2), max(pc1, pc2) + n
        hold_len = random.randint(1, min(6, max(1, c_hi - c_lo - 2 * remove)))
        total_len = 2 * remove + max(1, hold_len)
        c_mid = (c_lo + c_hi) // 2
        c_start = max(c_lo, c_mid - total_len // 2)
        for step in range(total_len):
            c = c_start + step
            if not (0 <= c < W):
                continue
            if step < remove:
                depth = step + 1
            elif step >= total_len - remove:
                depth = total_len - step
            else:
                depth = remove
            for k in range(depth):
                rr = pr1 + k if side == 0 else pr1 + n - 1 - k
                if 0 <= rr < H:
                    grid[rr, c] = _BG
    else:
        r_lo = min(pr1, pr2) + n
        r_hi = max(pr1, pr2)
        if r_hi <= r_lo:
            r_lo, r_hi = min(pr1, pr2), max(pr1, pr2) + n
        hold_len = random.randint(1, min(6, max(1, r_hi - r_lo - 2 * remove)))
        total_len = 2 * remove + max(1, hold_len)
        r_mid = (r_lo + r_hi) // 2
        r_start = max(r_lo, r_mid - total_len // 2)
        for step in range(total_len):
            r = r_start + step
            if not (0 <= r < H):
                continue
            if step < remove:
                depth = step + 1
            elif step >= total_len - remove:
                depth = total_len - step
            else:
                depth = remove
            for k in range(depth):
                cc = pc1 + k if side == 0 else pc1 + n - 1 - k
                if 0 <= cc < W:
                    grid[r, cc] = _BG


def _river_connected(grid: np.ndarray) -> bool:
    mask = grid == _RIVER
    if not mask.any():
        return False
    _labeled, num = scipy_label(mask.astype(int))
    return int(num) == 1


def _compute_offsets(G: int, n: int, num_coarse: int):
    if num_coarse == 1:
        return [1]
    first = 1
    last = G - n - 1
    if last < first:
        return None
    step = (last - first) / (num_coarse - 1)
    return [int(round(first + i * step)) for i in range(num_coarse)]


def _boxes_4touch(a: tuple[int, int], b: tuple[int, int], n: int) -> bool:
    r1, c1 = a
    r2, c2 = b
    rows_overlap = not (r1 + n - 1 < r2 or r2 + n - 1 < r1)
    cols_overlap = not (c1 + n - 1 < c2 or c2 + n - 1 < c1)
    rows_adj_or_overlap = not (r1 + n < r2 or r2 + n < r1)
    cols_adj_or_overlap = not (c1 + n < c2 or c2 + n < c1)
    return (rows_overlap and cols_adj_or_overlap) or (cols_overlap and rows_adj_or_overlap)


def _extend_to_edge(grid: np.ndarray, pr: int, pc: int, n: int):
    H, W = grid.shape
    candidates = []
    for direction in ("top", "bottom", "left", "right"):
        if direction == "top":
            dist = pr
            if dist == 0:
                candidates.append((0, pc, 0))
            elif all(grid[r, c] in (_BG, _RIVER) for r in range(pr) for c in range(pc, pc + n) if c < W):
                candidates.append((0, pc, dist))
        elif direction == "bottom":
            dist = H - (pr + n)
            if dist == 0:
                candidates.append((pr, pc, 0))
            elif all(grid[r, c] in (_BG, _RIVER) for r in range(pr + n, H) for c in range(pc, pc + n) if c < W):
                candidates.append((H - n, pc, dist))
        elif direction == "left":
            dist = pc
            if dist == 0:
                candidates.append((pr, 0, 0))
            elif all(grid[r, c] in (_BG, _RIVER) for r in range(pr, pr + n) for c in range(pc) if r < H):
                candidates.append((pr, 0, dist))
        else:
            dist = W - (pc + n)
            if dist == 0:
                candidates.append((pr, pc, 0))
            elif all(grid[r, c] in (_BG, _RIVER) for r in range(pr, pr + n) for c in range(pc + n, W) if r < H):
                candidates.append((pr, W - n, dist))
    if not candidates:
        return None
    candidates.sort(key=lambda item: item[2])
    return candidates[0][:2]


def _select_intermediate_targets(pixel_pos, final_pos: tuple[int, int], mover_pos: tuple[int, int], n: int, count: int):
    if count <= 0:
        return []
    L = len(pixel_pos)
    chosen: list[tuple[int, tuple[int, int]]] = []
    blocked = [final_pos, mover_pos]
    desired = [int(round((i + 1) * (L - 3) / (count + 1))) for i in range(count)]
    for want in desired:
        picked = None
        for delta in range(L):
            for cand_idx in {want - delta, want + delta}:
                if not (2 <= cand_idx <= L - 2):
                    continue
                pos = pixel_pos[cand_idx]
                if any(_boxes_4touch(pos, other, n) for other in blocked):
                    continue
                if any(cand_idx == old_idx for old_idx, _ in chosen):
                    continue
                picked = (cand_idx, pos)
                break
            if picked is not None:
                break
        if picked is None:
            return None
        chosen.append(picked)
        blocked.append(picked[1])
    chosen.sort(key=lambda item: item[0])
    return chosen


def _expected_output_from_layout(grid: np.ndarray, mover_pos: tuple[int, int], target_positions: list[tuple[int, int]], n: int):
    H, W = grid.shape
    feasible = np.zeros((H - n + 1, W - n + 1), dtype=bool)
    trav = (grid == _RIVER) | (grid == _MOVER) | (grid == _DEST)
    for r in range(feasible.shape[0]):
        for c in range(feasible.shape[1]):
            feasible[r, c] = bool(trav[r : r + n, c : c + n].all())
    dist = _bfs_placement(feasible, mover_pos[0], mover_pos[1])
    reachable = [pos for pos in target_positions if dist[pos[0], pos[1]] >= 0]

    if len(reachable) == len(target_positions):
        tr, tc = reachable[-1]
    else:
        best = -1
        tr, tc = mover_pos
        for r in range(dist.shape[0]):
            for c in range(dist.shape[1]):
                if int(dist[r, c]) > best:
                    best = int(dist[r, c])
                    tr, tc = int(r), int(c)

    out = grid.copy()
    sr, sc = mover_pos
    out[sr : sr + n, sc : sc + n] = _RIVER
    for rr, cc in reachable:
        out[rr : rr + n, cc : cc + n] = _RIVER
    out[tr : tr + n, tc : tc + n] = _MOVER
    return out, reachable, (tr, tc), dist


def _gen_attempt():
    all_reachable = random.random() < 0.5
    n = random.choice([1, 2, 3, 4]) if all_reachable else random.choice([2, 3, 4])

    min_size = max(10, 5 * n)
    if min_size > 20:
        return None
    G = random.randint(min_size, 20)
    H = W = G

    min_spacing = n + 1
    max_coarse = max(3, (G - 2) // min_spacing)
    coarse_dim = random.randint(3, min(6, max_coarse))
    coarse_rows = coarse_cols = coarse_dim

    offsets_r = _compute_offsets(G, n, coarse_rows)
    offsets_c = _compute_offsets(G, n, coarse_cols)
    if offsets_r is None or offsets_c is None:
        return None
    if any(offsets_r[i + 1] - offsets_r[i] < n for i in range(len(offsets_r) - 1)):
        return None
    if any(offsets_c[i + 1] - offsets_c[i] < n for i in range(len(offsets_c) - 1)):
        return None

    edge_cells = set()
    for c in range(coarse_cols):
        edge_cells.add((0, c))
        edge_cells.add((coarse_rows - 1, c))
    for r in range(1, coarse_rows - 1):
        edge_cells.add((r, 0))
        edge_cells.add((r, coarse_cols - 1))
    edge_cells = list(edge_cells)
    random.shuffle(edge_cells)
    start_coarse = edge_cells[0]
    far = sorted(edge_cells, key=lambda e: -(abs(e[0] - start_coarse[0]) + abs(e[1] - start_coarse[1])))
    end_coarse = far[0] if far[0] != start_coarse else far[1]

    walk = _hamiltonian_walk(coarse_rows, coarse_cols, start_coarse, end_coarse)
    if walk is None or len(walk) < 6:
        return None
    if len(set(cr for cr, _ in walk)) < coarse_rows or len(set(cc for _, cc in walk)) < coarse_cols:
        return None

    grid = np.full((H, W), _BG, dtype=int)
    pixel_pos = _render_channel(grid, walk, n, offsets_r, offsets_c)

    mask = grid != _BG
    if np.any(mask, axis=1).sum() / H < 0.70 or np.any(mask, axis=0).sum() / W < 0.70:
        return None

    mover_r, mover_c = pixel_pos[0]
    dest_r, dest_c = pixel_pos[-1]

    final_pos = _extend_to_edge(grid, dest_r, dest_c, n)
    if final_pos is None:
        return None
    new_dest_r, new_dest_c = final_pos
    if new_dest_r != dest_r:
        r_lo, r_hi = min(new_dest_r, dest_r), max(new_dest_r, dest_r) + n
        grid[r_lo:r_hi, dest_c : dest_c + n] = _RIVER
    if new_dest_c != dest_c:
        c_lo, c_hi = min(new_dest_c, dest_c), max(new_dest_c, dest_c) + n
        grid[dest_r : dest_r + n, c_lo:c_hi] = _RIVER
    dest_r, dest_c = new_dest_r, new_dest_c
    if not (dest_r == 0 or dest_r + n == H or dest_c == 0 or dest_c + n == W):
        return None

    touching = mover_r == 0 or mover_r + n == H or mover_c == 0 or mover_c + n == W
    if touching:
        if mover_r == 0:
            grid[0, mover_c : mover_c + n] = _RIVER
            mover_r = 1
        elif mover_r + n == H:
            grid[H - 1, mover_c : mover_c + n] = _RIVER
            mover_r = H - n - 1
        elif mover_c == 0:
            grid[mover_r : mover_r + n, 0] = _RIVER
            mover_c = 1
        else:
            grid[mover_r : mover_r + n, W - 1] = _RIVER
            mover_c = W - n - 1
    if mover_r == 0 or mover_r + n == H or mover_c == 0 or mover_c + n == W:
        return None
    if min(mover_r, H - (mover_r + n), mover_c, W - (mover_c + n)) > 2:
        return None

    mover_pos = (mover_r, mover_c)
    final_target = (dest_r, dest_c)

    max_targets = 4 if len(pixel_pos) >= 10 else (3 if len(pixel_pos) >= 7 else 2)
    max_targets = min(max_targets, 4)
    target_count = random.randint(2, max_targets)
    chosen_mid = None
    for count in range(target_count - 1, 0, -1):
        chosen_mid = _select_intermediate_targets(pixel_pos, final_target, mover_pos, n, count)
        if chosen_mid is not None:
            target_count = count + 1
            break
    if chosen_mid is None:
        return None

    ordered_targets = [pos for _idx, pos in chosen_mid] + [final_target]
    ordered_indices = [idx for idx, _pos in chosen_mid] + [len(pixel_pos)]
    if len(ordered_targets) < 2:
        return None

    grid[mover_r : mover_r + n, mover_c : mover_c + n] = _RIVER
    for rr, cc in ordered_targets:
        grid[rr : rr + n, cc : cc + n] = _RIVER

    if not all_reachable:
        reached_prefix = random.randint(1, len(ordered_targets) - 1)
        left = ordered_indices[reached_prefix - 1]
        right = ordered_indices[reached_prefix]
        lo = max(left, 1)
        hi = min(right - 1, len(pixel_pos) - 2)
        if lo > hi:
            return None
        seg_idx = random.randint(lo, hi)
        pr1, pc1 = pixel_pos[seg_idx]
        pr2, pc2 = pixel_pos[seg_idx + 1]
        direction = "h" if pr1 == pr2 else "v"
        _add_chokepoint(grid, (pr1, pc1), (pr2, pc2), n, direction)
        if not _river_connected(grid):
            return None

    grid[mover_r : mover_r + n, mover_c : mover_c + n] = _MOVER
    for rr, cc in ordered_targets:
        grid[rr : rr + n, cc : cc + n] = _DEST

    expected, reachable, final_pos, dist = _expected_output_from_layout(grid, mover_pos, ordered_targets, n)

    reachable_prefix_len = 0
    for pos in ordered_targets:
        if int(dist[pos[0], pos[1]]) >= 0:
            reachable_prefix_len += 1
        else:
            break
    if any(int(dist[pos[0], pos[1]]) >= 0 for pos in ordered_targets[reachable_prefix_len:]):
        return None

    if all_reachable:
        if len(reachable) != len(ordered_targets):
            return None
        if np.any(expected == _DEST):
            return None
    else:
        if not (1 <= len(reachable) < len(ordered_targets)):
            return None
        if not np.any(expected == _DEST):
            return None

    if not np.array_equal(main(grid), expected):
        return None

    info = _solve_details(grid)
    if len(info["targets"]) != len(ordered_targets):
        return None
    if len(info["reachable_targets"]) != len(reachable):
        return None
    return grid


def generate_input():
    for _ in range(500):
        result = _gen_attempt()
        if result is not None:
            return result
    raise RuntimeError("Failed to generate valid input after 500 attempts")

