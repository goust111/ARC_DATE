# Variant of 332f06d7
# Dimension: D17 — src-dst 基数关系 (meta)
# Change: 1:1 关系——一个移动体对应一个目标... → 一移动体对多目标 (1:many)

from __future__ import annotations

from collections import Counter, defaultdict, deque
import random

import numpy as np
from scipy.ndimage import label as scipy_label

from arc_utils import bbox_h, bbox_w, find_components


# Design analysis for the D17 variant
# a) Concrete behavior / trace
#    Input still shows one black n x n square moving inside one blue winding corridor on green background.
#    The visible change is that there are now 2-4 red n x n target squares of the same size on later parts
#    of the same corridor, rather than exactly one red square. In the output the black square advances through
#    the corridor, every red square that is reachable before the first true bottleneck disappears into blue,
#    and the black square ends either on the last reachable red square (if all targets are reachable) or at the
#    farthest feasible placement before the first too-narrow chokepoint. Any downstream unreachable red squares
#    remain red.
#    Small trace:
#    - Original: mover at A, one target at C. If C reachable, output leaves black at C; otherwise at farthest B.
#    - Variant: mover at A, targets at B/C/D in path order. If B and C reachable but D lies beyond a chokepoint,
#      output clears B and C to blue and leaves black at the farthest feasible placement before the chokepoint.
#      If all B/C/D are reachable, B and C are cleared and black ends on D.
#    The algorithmic change is therefore not in "how a square slides", but in "how many target squares are
#    consumed before stopping" and in the output cleanup of already-visited targets.
#
# b) Complexity calibration
#    The variant keeps only one mover and one target color, so object typing stays visually simple. The new
#    degree of freedom is only the count of red targets (2-4) plus whether all are reachable. This is enough
#    to make the change visible without introducing branches or extra color semantics. Generator examples are
#    forced to contain multiple targets, and blocked cases are forced to have both reachable and unreachable
#    targets so the 1:many behavior is not degenerate.
#
# c) Hidden assumptions in the original solver that break under D17
#    - "Choose the size that appears at least twice" is no longer enough; now the relevant size appears at
#      least three times (1 mover + many targets), and there may be multiple red components.
#    - "Sort by color and pick exactly two squares" relied on the old 1:1 cardinality and on invisible numeric
#      color ordering. That is invalid here. The new solver instead detects one singleton color component as
#      the mover and one repeated color as the targets, both at the same square size.
#    - "Destination = one top-left coordinate" is invalid; the solver must reason over a target set.
#    - "If destination unreachable, keep the unique red target unchanged" is also invalid. Now some earlier
#      red targets may be reachable and must be cleared even when a later target is not.
#
# d) Placement legality
#    Generator places every target as a separate solid n x n component with at least one blue-cell gap in
#    4-connectivity terms, so same-color targets do not merge into a single non-square component. All squares
#    stay inside the grid. Chokepoints are inserted only between already separated target positions. The final
#    input is validated by feasible-placement BFS before being accepted.
#
# e) Visual observability
#    The new rule is visible in 2-3 examples: multiple red squares lie ahead on the same river, some outputs
#    erase all reds, others erase only a prefix and leave later reds untouched. No invisible numeric ordering
#    is needed for the human solver; the ordering is the spatial order along the corridor.
#
# f) Visual cleanliness
#    The variant avoids extra markers and keeps the original palette. Targets are spaced apart so the red
#    squares remain separate, readable objects rather than one merged blob. Only one black square is present
#    in the output, preserving the original visual grammar.
#
# g) Color inference
#    Colors retain their original roles: green background, blue corridor, black mover, red targets. The new
#    logic does not depend on numeric color values for sorting; it depends on visible multiplicity:
#    one black-like role object vs multiple same-colored target objects of the same size.
#
# 9) New solver assumptions and how the generator guarantees them
#    - All relevant solid squares share one size n. Generator constructs mover and every target with that n.
#    - Exactly one color occurs once at that size (mover), and one color occurs multiple times at that size
#      (targets). Generator enforces this.
#    - Reachable targets form a path-order prefix of the target list. Generator places targets along one
#      corridor and validates that reachability is a prefix, so "consume all reachable targets" matches the
#      intended sequential narrative.


_BG, _RIVER, _MOVER, _DEST = 3, 1, 0, 2


def _find_square_roles(g: np.ndarray):
    bg = int(Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0])

    squares: list[dict] = []
    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict"):
        col = int(comp["color"])
        b = comp["bbox"]
        if bbox_h(b) != bbox_w(b):
            continue
        patch = g[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1]
        if not bool((patch == col).all()):
            continue
        squares.append({"col": col, "r0": int(b[0]), "c0": int(b[1]), "n": int(bbox_h(b))})

    assert len(squares) >= 3

    candidates = []
    by_n: dict[int, list[dict]] = defaultdict(list)
    for sq in squares:
        by_n[int(sq["n"])].append(sq)

    for nside, group in by_n.items():
        by_color: dict[int, list[dict]] = defaultdict(list)
        for sq in group:
            by_color[int(sq["col"])].append(sq)
        singletons = [col for col, parts in by_color.items() if len(parts) == 1]
        repeated = [col for col, parts in by_color.items() if len(parts) >= 2]
        if not singletons or not repeated:
            continue
        candidates.append((len(group), nside, singletons, repeated, by_color))

    assert candidates
    _total, n, singletons, repeated, by_color = max(candidates, key=lambda item: (item[0], item[1]))

    def edge_margin(sq: dict) -> int:
        H, W = g.shape
        return min(int(sq["r0"]), int(H - (sq["r0"] + sq["n"])), int(sq["c0"]), int(W - (sq["c0"] + sq["n"])))

    if len(singletons) == 1:
        mover_col = int(singletons[0])
    else:
        mover_col = min(singletons, key=lambda col: edge_margin(by_color[int(col)][0]))
    if len(repeated) == 1:
        target_col = int(repeated[0])
    else:
        target_col = max(repeated, key=lambda col: len(by_color[int(col)]))

    mover = dict(by_color[int(mover_col)][0])
    targets = sorted(
        (dict(sq) for sq in by_color[int(target_col)]),
        key=lambda sq: (int(sq["r0"]), int(sq["c0"])),
    )

    counts = Counter(map(int, g.flatten()))
    river = None
    for col, _ct in counts.most_common():
        if int(col) == int(bg):
            continue
        if int(col) in (int(mover_col), int(target_col)):
            continue
        river = int(col)
        break
    assert river is not None
    return bg, river, mover, targets, int(n), int(target_col)


def _placement_dist(g: np.ndarray, n: int, sr: int, sc: int, river: int, mover_col: int, target_col: int):
    H, W = g.shape
    trav = (g == river) | (g == mover_col) | (g == target_col)
    h2 = int(H - n + 1)
    w2 = int(W - n + 1)
    assert h2 > 0 and w2 > 0
    assert 0 <= sr < h2 and 0 <= sc < w2

    feasible = np.zeros((h2, w2), dtype=bool)
    for r in range(h2):
        for c in range(w2):
            feasible[r, c] = bool(trav[r : r + n, c : c + n].all())
    assert bool(feasible[sr, sc])

    dist = -np.ones((h2, w2), dtype=int)
    q = deque([(int(sr), int(sc))])
    dist[int(sr), int(sc)] = 0
    while q:
        r, c = q.popleft()
        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
            rr, cc = int(r + dr), int(c + dc)
            if 0 <= rr < h2 and 0 <= cc < w2 and bool(feasible[rr, cc]) and int(dist[rr, cc]) == -1:
                dist[rr, cc] = int(dist[r, c] + 1)
                q.append((rr, cc))
    return feasible, dist


def _solve_details(grid: np.ndarray):
    g = np.array(grid, dtype=int)
    _bg, river, mover, targets, n, target_col = _find_square_roles(g)

    sr, sc = int(mover["r0"]), int(mover["c0"])
    feasible, dist = _placement_dist(g, n, sr, sc, river, int(mover["col"]), int(target_col))

    reachable_targets = []
    unreachable_targets = []
    for sq in targets:
        r0, c0 = int(sq["r0"]), int(sq["c0"])
        ok = 0 <= r0 < feasible.shape[0] and 0 <= c0 < feasible.shape[1] and bool(feasible[r0, c0]) and int(dist[r0, c0]) >= 0
        (reachable_targets if ok else unreachable_targets).append(dict(sq))

    if len(reachable_targets) == len(targets):
        final_target = max(
            reachable_targets,
            key=lambda sq: (int(dist[int(sq["r0"]), int(sq["c0"])]), int(sq["r0"]), int(sq["c0"])),
        )
        tr, tc = int(final_target["r0"]), int(final_target["c0"])
    else:
        best = -1
        tr, tc = int(sr), int(sc)
        for r in range(dist.shape[0]):
            for c in range(dist.shape[1]):
                cand = int(dist[r, c])
                if cand > best:
                    best = cand
                    tr, tc = int(r), int(c)

    out = g.copy()
    out[int(sr) : int(sr + n), int(sc) : int(sc + n)] = int(river)
    for sq in reachable_targets:
        rr, cc = int(sq["r0"]), int(sq["c0"])
        out[rr : rr + n, cc : cc + n] = int(river)
    out[int(tr) : int(tr + n), int(tc) : int(tc + n)] = int(mover["col"])

    return {
        "out": out,
        "river": int(river),
        "mover": mover,
        "targets": targets,
        "reachable_targets": reachable_targets,
        "unreachable_targets": unreachable_targets,
        "final_pos": (int(tr), int(tc)),
        "n": int(n),
        "dist": dist,
    }


def main(grid: np.ndarray) -> np.ndarray:
    """
    Variant rule:
    - There is one solid mover square and multiple same-sized destination squares on the river.
    - The mover can occupy only n x n windows fully covered by traversable cells.
    - Every reachable destination square is visited in corridor order and then left behind as river.
    - If all destination squares are reachable, the mover ends on the farthest destination.
    - Otherwise it continues after the last reached destination and stops at the farthest reachable placement.
    """
    return _solve_details(np.array(grid, dtype=int))["out"]


def _bfs_placement(feasible: np.ndarray, sr: int, sc: int) -> np.ndarray:
    h2, w2 = feasible.shape
    dist = -np.ones((h2, w2), dtype=int)
    dist[sr, sc] = 0
    q = deque([(sr, sc)])
    while q:
        r, c = q.popleft()
        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
            rr, cc = r + dr, c + dc
            if 0 <= rr < h2 and 0 <= cc < w2 and feasible[rr, cc] and dist[rr, cc] == -1:
                dist[rr, cc] = dist[r, c] + 1
                q.append((rr, cc))
    return dist


