            ```python
            from __future__ import annotations

# Variant of 332f06d7
# Dimension: D5 — 目标与停止条件 (dst)
# Change: 同尺寸红色(color 2)方块位于通道末端靠近网格边缘；可达时覆盖目标，不可达时停在最远可达位置
#   → 多目标选择：通道上存在多个不同颜色的同尺寸目标方块；其中只有一个目标颜色
#   会在背景里额外出现一次，表现为一个细长的同色提示条。黑色移动方块必须去覆盖
#   这个“被提示颜色”对应的目标；若该目标不可达，仍按原题停在最远可达位置。
#
# Design analysis
# a) Concrete behavior and trace
#    - Input still has a green background, a blue winding river, and one black n x n mover.
#    - Instead of one red destination square, there are 2-4 same-sized target squares sitting on the river.
#      Their colors are all distinct. One of those colors also appears as a separate 1x2 or 2x1 bar in the
#      background. That repeated color is the only visible cue for which target matters.
#    - Small trace:
#      original: black square + red square -> BFS checks whether red top-left is reachable -> if yes, black ends there.
#      variant: black square + yellow/red/grey targets + one isolated yellow bar ->
#      BFS still runs on the same placement grid, but the chosen destination is now the yellow target because yellow
#      is the only target color echoed by a non-square marker. All other targets are distractors and remain unchanged.
# b) Complexity calibration
#    - The change is visible because every sample has multiple target squares with different colors, and exactly one
#      color is duplicated by a selector bar.
#    - The rule is constrained: only one selector bar, only one mover, only one target per color, and 2-4 targets.
#      This avoids color-order ambiguity while keeping the object vocabulary small enough for ARC.
# c) Implicit assumptions in the original main()
#    - Original `cand.sort(key=color); mover=cand[0]; dest=cand[1]` assumed exactly two same-sized squares and used
#      invisible color ordering. That is invalid now; the new solver identifies the mover by its fixed black color
#      and identifies the destination by the visible repeated-color cue.
#    - Original traversable mask used `{river, mover, dest}`. Now the river must treat every target square as
#      passable area, but must *not* treat the selector bar as passable. The new solver therefore builds the
#      traversable mask from the river plus the detected square bboxes only.
#    - Original river detection excluded just mover/dest colors. Now it must exclude all target colors because one
#      chosen color also appears in the selector bar.
# d) Placement legality
#    - Generator keeps the original output-first strategy: build a winding river first, optionally carve a chokepoint,
#      then place several n x n targets on distinct placements along that river.
#    - The selector bar is only placed on a background patch with a one-cell moat of background, so it cannot merge
#      with the river or with its matching target square.
#    - Target placements are distinct walk positions, so they do not overlap and remain valid n x n solid squares.
# e) Visual observability
#    - The target-selection rule is not based on hidden numeric color ids. A human can see that one target color is
#      echoed by a separate little bar, and that the black square heads to that matching color when reachable.
#    - In stuck cases the selected target is chosen after a chokepoint while at least one distractor target remains
#      reachable before the choke, so the examples show that "any reachable target" is not the rule.
# f) Visual cleanliness
#    - No extra symbols are drawn on the river itself except the target squares; the selector stays isolated in the
#      background. The original river geometry remains dominant and readable.
# g) Color-change inferability
#    - Colors are not remapped. The only color relation is equality: the isolated bar and the true target share
#      the same color. This is easy to infer from 2-3 examples.
#
# New solver assumptions to audit against the generator
# - Exactly one solid black square exists; generator enforces one mover.
# - Every target is a solid n x n square of the mover's size; generator enforces this.
# - Exactly one target color appears in more than one monochromatic component because of the selector bar;
#   generator enforces distinct target colors and a single isolated bar.
# - River is the most common non-background color after excluding mover/target colors; generator keeps river area
#   much larger than the small target squares and marker.

from collections import Counter, defaultdict, deque
import random

import numpy as np
from scipy.ndimage import label as scipy_label

from arc_utils import bbox_h, bbox_w, find_components


_BG, _RIVER, _MOVER = 3, 1, 0
_TARGET_COLORS = [2, 4, 5, 6, 7, 8, 9]


def _is_full_square(grid: np.ndarray, comp: dict) -> bool:
    b = comp["bbox"]
    if bbox_h(b) != bbox_w(b):
        return False
    col = int(comp["color"])
    patch = grid[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1]
    return bool((patch == col).all())


def _collect_square_components(grid: np.ndarray, bg: int) -> tuple[list[dict], dict[int, list[dict]], Counter]:
    comps = find_components(grid, bg=bg, connectivity=4, monochromatic=True, return_format="dict")
    squares: list[dict] = []
    by_color: dict[int, list[dict]] = defaultdict(list)
    counts: Counter = Counter()
    for comp in comps:
        col = int(comp["color"])
        counts[col] += 1
        by_color[col].append(comp)
        if not _is_full_square(grid, comp):
            continue
        b = comp["bbox"]
        squares.append({"col": col, "r0": int(b[0]), "c0": int(b[1]), "n": int(bbox_h(b))})
    return squares, by_color, counts


def _build_feasible_mask(trav: np.ndarray, n: int) -> np.ndarray:
    H, W = trav.shape
    h2, w2 = H - n + 1, W - n + 1
    feasible = np.zeros((h2, w2), dtype=bool)
    for r in range(h2):
        for c in range(w2):
            if bool(trav[r : r + n, c : c + n].all()):
                feasible[r, c] = True
    return feasible


def _bfs_placement(feasible: np.ndarray, sr: int, sc: int) -> np.ndarray:
    h2, w2 = feasible.shape
    dist = -np.ones((h2, w2), dtype=int)
    dist[sr, sc] = 0
    q = deque([(sr, sc)])
    while q:
        r, c = q.popleft()
        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
            rr, cc = r + dr, c + dc
            if 0 <= rr < h2 and 0 <= cc < w2 and feasible[rr, cc] and dist[rr, cc] == -1:
                dist[rr, cc] = dist[r, c] + 1
                q.append((rr, cc))
    return dist


def _find_farthest(dist: np.ndarray, sr: int, sc: int) -> tuple[int, int]:
    best = -1
    tr, tc = sr, sc
    for r in range(dist.shape[0]):
        for c in range(dist.shape[1]):
            if int(dist[r, c]) > best:
                best = int(dist[r, c])
                tr, tc = r, c
    return tr, tc


def main(grid: np.ndarray) -> np.ndarray:
    g = np.array(grid, dtype=int)
    H, W = g.shape

    bg = int(Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0])
    counts = Counter(map(int, g.flatten()))
    river = None
    for col, _ct in counts.most_common():
        if int(col) in (bg, _MOVER):
            continue
        river = int(col)
        break
    assert river is not None
    squares, by_color, component_counts = _collect_square_components(g, bg)

    movers = [sq for sq in squares if int(sq["col"]) == _MOVER]
    assert len(movers) == 1
    mover = movers[0]
    n = int(mover["n"])
    sr, sc = int(mover["r0"]), int(mover["c0"])

    targets = [sq for sq in squares if int(sq["col"]) not in (_MOVER, river) and int(sq["n"]) == n]
    assert len(targets) >= 2
    target_colors = {int(t["col"]) for t in targets}

    selected_colors = []
    for col in sorted(target_colors):
        if any(not _is_full_square(g, comp) for comp in by_color[col]):
            selected_colors.append(col)
    if len(selected_colors) != 1:
        selected_colors = [col for col in sorted(target_colors) if int(component_counts[col]) >= 2]
        assert len(selected_colors) == 1
    selected_color = int(selected_colors[0])
    selected_targets = [t for t in targets if int(t["col"]) == selected_color]
    assert len(selected_targets) == 1
    dest = selected_targets[0]
    dr, dc = int(dest["r0"]), int(dest["c0"])

    trav = (g == river)
    trav[sr : sr + n, sc : sc + n] = True
    for sq in targets:
        rr, cc = int(sq["r0"]), int(sq["c0"])
        trav[rr : rr + n, cc : cc + n] = True

    feasible = _build_feasible_mask(trav, n)
    h2, w2 = feasible.shape
    assert 0 <= sr < h2 and 0 <= sc < w2 and bool(feasible[sr, sc])

    dist = _bfs_placement(feasible, sr, sc)
    if 0 <= dr < h2 and 0 <= dc < w2 and bool(feasible[dr, dc]) and int(dist[dr, dc]) >= 0:
        tr, tc = dr, dc
    else:
        tr, tc = _find_farthest(dist, sr, sc)

    out = g.copy()
    out[sr : sr + n, sc : sc + n] = river
    out[tr : tr + n, tc : tc + n] = _MOVER
    return out


def _hamiltonian_walk(rows: int, cols: int, start: tuple[int, int], end: tuple[int, int]) -> list[tuple[int, int]] | None:
    total = rows * cols
    best_path = None
    best_len = 0
    for _attempt in range(80):
        visited = {start}
        path = [start]
        cur = start
        while True:
            if cur == end and len(path) >= total * 0.7:
                if len(path) > best_len:
                    best_path = list(path)
                    best_len = len(path)
                break
            neighbors = []
            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nr, nc = cur[0] + dr, cur[1] + dc
                if 0 <= nr < rows and 0 <= nc < cols and (nr, nc) not in visited:
                    neighbors.append((nr, nc))
            if not neighbors:
                break
            valid = []
            for nb in neighbors:
                if nb == end:
                    valid.append(nb)
                    continue
                test_visited = visited | {nb}
                seen = {end}
                q = deque([end])
                while q:
                    cr, cc = q.popleft()
                    for dr2, dc2 in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                        nr2, nc2 = cr + dr2, cc + dc2
                        if 0 <= nr2 < rows and 0 <= nc2 < cols and (nr2, nc2) not in test_visited and (nr2, nc2) not in seen:
                            seen.add((nr2, nc2))
                            q.append((nr2, nc2))
                for dr2, dc2 in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                    ar, ac = nb[0] + dr2, nb[1] + dc2
                    if 0 <= ar < rows and 0 <= ac < cols and (ar, ac) not in test_visited and (ar, ac) in seen:
                        valid.append(nb)
                        break
            if not valid:
                break
            random.shuffle(valid)
            nxt = valid[0]
            visited.add(nxt)
            path.append(nxt)
            cur = nxt
        if best_path and best_len >= total * 0.85:
            break
    return best_path


def _render_channel(grid: np.ndarray, path: list[tuple[int, int]], n: int, offsets_r: list[int], offsets_c: list[int]) -> list[tuple[int, int]]:
    pixel_pos = []
    for cr, cc in path:
        pr, pc = offsets_r[cr], offsets_c[cc]
        pixel_pos.append((pr, pc))
        grid[pr : pr + n, pc : pc + n] = _RIVER
    for i in range(len(path) - 1):
        pr1, pc1 = pixel_pos[i]
        pr2, pc2 = pixel_pos[i + 1]
        if pr1 == pr2:
            c_lo, c_hi = min(pc1, pc2), max(pc1, pc2) + n
            grid[pr1 : pr1 + n, c_lo:c_hi] = _RIVER
        else:
            r_lo, r_hi = min(pr1, pr2), max(pr1, pr2) + n
            grid[r_lo:r_hi, pc1 : pc1 + n] = _RIVER
    return pixel_pos


def _add_chokepoint(grid: np.ndarray, pixel_pos_i: tuple[int, int], pixel_pos_j: tuple[int, int], n: int, direction: str) -> None:
    H, W = grid.shape
    pr1, pc1 = pixel_pos_i
    pr2, pc2 = pixel_pos_j
    narrow_w = random.randint(1, n - 1)
    remove = n - narrow_w
    side = random.randint(0, 1)

    if direction == "h":
        c_lo = min(pc1, pc2) + n
        c_hi = max(pc1, pc2)
        if c_hi <= c_lo:
            c_lo, c_hi = min(pc1, pc2), max(pc1, pc2) + n
        hold_len = random.randint(1, min(6, max(1, c_hi - c_lo - 2 * remove)))
        total_len = 2 * remove + max(1, hold_len)
        c_mid = (c_lo + c_hi) // 2
        c_start = max(c_lo, c_mid - total_len // 2)
        for step in range(total_len):
            c = c_start + step
            if not (0 <= c < W):
                continue
            if step < remove:
                depth = step + 1
            elif step >= total_len - remove:
                depth = total_len - step
            else:
                depth = remove
            for k in range(depth):
                rr = pr1 + k if side == 0 else pr1 + n - 1 - k
                if 0 <= rr < H:
                    grid[rr, c] = _BG
    else:
        r_lo = min(pr1, pr2) + n
        r_hi = max(pr1, pr2)
        if r_hi <= r_lo:
            r_lo, r_hi = min(pr1, pr2), max(pr1, pr2) + n
        hold_len = random.randint(1, min(6, max(1, r_hi - r_lo - 2 * remove)))
        total_len = 2 * remove + max(1, hold_len)
        r_mid = (r_lo + r_hi) // 2
        r_start = max(r_lo, r_mid - total_len // 2)
        for step in range(total_len):
            r = r_start + step
            if not (0 <= r < H):
                continue
            if step < remove:
                depth = step + 1
            elif step >= total_len - remove:
                depth = total_len - step
            else:
                depth = remove
            for k in range(depth):
                cc = pc1 + k if side == 0 else pc1 + n - 1 - k
                if 0 <= cc < W:
                    grid[r, cc] = _BG


def _river_connected(grid: np.ndarray) -> bool:
    mask = (grid == _RIVER)
    if not mask.any():
        return False
    _, num = scipy_label(mask.astype(int))
    return bool(num == 1)


def _compute_offsets(G: int, n: int, num_coarse: int) -> list[int] | None:
    if num_coarse == 1:
        return [1]
    first = 1
    last = G - n - 1
    if last < first:
        return None
    step = (last - first) / (num_coarse - 1)
    return [int(round(first + i * step)) for i in range(num_coarse)]


def _extend_to_edge(grid: np.ndarray, pr: int, pc: int, n: int) -> tuple[int, int] | None:
    H, W = grid.shape
    candidates = []
    for direction in ("top", "bottom", "left", "right"):
        if direction == "top":
            dist = pr
            if dist == 0:
                candidates.append((0, pc, 0))
                continue
            if all(grid[r, c] in (_BG, _RIVER) for r in range(pr) for c in range(pc, pc + n) if c < W):
                candidates.append((0, pc, dist))
        elif direction == "bottom":
            dist = H - (pr + n)
            if dist == 0:
                candidates.append((pr, pc, 0))
                continue
            if all(grid[r, c] in (_BG, _RIVER) for r in range(pr + n, H) for c in range(pc, pc + n) if c < W):
                candidates.append((H - n, pc, dist))
        elif direction == "left":
            dist = pc
            if dist == 0:
                candidates.append((pr, 0, 0))
                continue
            if all(grid[r, c] in (_BG, _RIVER) for r in range(pr, pr + n) for c in range(pc) if r < H):
                candidates.append((pr, 0, dist))
        else:
            dist = W - (pc + n)
            if dist == 0:
                candidates.append((pr, pc, 0))
                continue
            if all(grid[r, c] in (_BG, _RIVER) for r in range(pr, pr + n) for c in range(pc + n, W) if r < H):
                candidates.append((pr, W - n, dist))
    if not candidates:
        return None
    candidates.sort(key=lambda x: x[2])
    return int(candidates[0][0]), int(candidates[0][1])


def _sample_target_indices(path_len: int, num_targets: int) -> list[int] | None:
    pool = list(range(1, path_len))
    if len(pool) < num_targets:
        return None
    random.shuffle(pool)
    chosen: list[int] = []
    for idx in pool:
        if all(abs(idx - old) >= 2 for old in chosen):
            chosen.append(idx)
            if len(chosen) == num_targets:
                return sorted(chosen)
    if len(pool) < num_targets:
        return None
    return sorted(random.sample(range(1, path_len), num_targets))


def _find_selector_slot(grid: np.ndarray) -> tuple[int, int, int, int] | None:
    H, W = grid.shape
    shapes = [(1, 2), (2, 1)]
    random.shuffle(shapes)
    positions = [(r, c) for r in range(1, H - 1) for c in range(1, W - 1)]
    positions.sort(key=lambda rc: min(rc[0] + rc[1], rc[0] + (W - 1 - rc[1]), (H - 1 - rc[0]) + rc[1], (H - 1 - rc[0]) + (W - 1 - rc[1])))
    for h, w in shapes:
        for r, c in positions:
            if r + h >= H or c + w >= W:
                continue
            if not bool((grid[r : r + h, c : c + w] == _BG).all()):
                continue
            rr0, rr1 = r - 1, r + h + 1
            cc0, cc1 = c - 1, c + w + 1
            if rr0 < 0 or cc0 < 0 or rr1 > H or cc1 > W:
                continue
            if bool((grid[rr0:rr1, cc0:cc1] == _BG).all()):
                return r, c, h, w
    return None


def _analyze_targets(grid: np.ndarray) -> tuple[list[dict], dict[int, tuple[int, int]], int, int, int]:
    bg = int(Counter([int(grid[0, 0]), int(grid[0, -1]), int(grid[-1, 0]), int(grid[-1, -1])]).most_common(1)[0][0])
    counts_all = Counter(map(int, grid.flatten()))
    river = None
    for col, _ct in counts_all.most_common():
        if int(col) in (bg, _MOVER):
            continue
        river = int(col)
        break
    squares, by_color, counts = _collect_square_components(grid, bg)
    mover = [sq for sq in squares if int(sq["col"]) == _MOVER][0]
    n = int(mover["n"])
    targets = [sq for sq in squares if int(sq["col"]) not in (_MOVER, river) and int(sq["n"]) == n]
    selected = []
    for t in targets:
        if any(not _is_full_square(grid, comp) for comp in by_color[int(t["col"])]):
            selected.append(int(t["col"]))
    selected_color = selected[0] if len(selected) == 1 else [int(t["col"]) for t in targets if int(counts[int(t["col"])]) >= 2][0]
    target_pos = {int(t["col"]): (int(t["r0"]), int(t["c0"])) for t in targets}
    return targets, target_pos, int(mover["r0"]), int(mover["c0"]), selected_color


def _gen_attempt() -> np.ndarray | None:
    reached = random.random() < 0.5
    n = random.choice([1, 2, 3, 4]) if reached else random.choice([2, 3, 4])

    min_size = max(10, 5 * n)
    if min_size > 20:
        return None
    G = random.randint(min_size, 20)
    H = W = G

    min_spacing = n + 1
    max_coarse = max(3, (G - 2) // min_spacing)
    coarse_dim = random.randint(3, min(6, max_coarse))
    offsets_r = _compute_offsets(G, n, coarse_dim)
    offsets_c = _compute_offsets(G, n, coarse_dim)
    if offsets_r is None or offsets_c is None:
        return None
    if any(offsets_r[i + 1] - offsets_r[i] < n for i in range(len(offsets_r) - 1)):
        return None
    if any(offsets_c[i + 1] - offsets_c[i] < n for i in range(len(offsets_c) - 1)):
        return None

    edge_cells = set()
    for c in range(coarse_dim):
        edge_cells.add((0, c))
        edge_cells.add((coarse_dim - 1, c))
    for r in range(1, coarse_dim - 1):
        edge_cells.add((r, 0))
        edge_cells.add((r, coarse_dim - 1))
    edge_cells = list(edge_cells)
    random.shuffle(edge_cells)
    start_coarse = edge_cells[0]
    far = sorted(edge_cells, key=lambda e: -(abs(e[0] - start_coarse[0]) + abs(e[1] - start_coarse[1])))
    end_coarse = far[0] if far[0] != start_coarse else far[1]

    walk = _hamiltonian_walk(coarse_dim, coarse_dim, start_coarse, end_coarse)
    if walk is None or len(walk) < 6:
        return None
    if len(set(cr for cr, _ in walk)) < coarse_dim or len(set(cc for _, cc in walk)) < coarse_dim:
        return None

    grid = np.full((H, W), _BG, dtype=int)
    pixel_pos = _render_channel(grid, walk, n, offsets_r, offsets_c)
    if np.any(grid != _BG, axis=1).sum() / H < 0.70 or np.any(grid != _BG, axis=0).sum() / W < 0.70:
        return None

    mover_r, mover_c = pixel_pos[0]
    end_r, end_c = pixel_pos[-1]
    edge_end = _extend_to_edge(grid, end_r, end_c, n)
    if edge_end is None:
        return None
    new_end_r, new_end_c = edge_end
    if new_end_r != end_r:
        r_lo, r_hi = min(new_end_r, end_r), max(new_end_r, end_r) + n
        grid[r_lo:r_hi, end_c : end_c + n] = _RIVER
    if new_end_c != end_c:
        c_lo, c_hi = min(new_end_c, end_c), max(new_end_c, end_c) + n
        grid[end_r : end_r + n, c_lo:c_hi] = _RIVER
    pixel_pos = list(pixel_pos)
    pixel_pos[-1] = (new_end_r, new_end_c)

    touching = mover_r == 0 or mover_r + n == H or mover_c == 0 or mover_c + n == W
    if touching:
        if mover_r == 0:
            grid[0, mover_c : mover_c + n] = _RIVER
            mover_r = 1
        elif mover_r + n == H:
            grid[H - 1, mover_c : mover_c + n] = _RIVER
            mover_r = H - n - 1
        elif mover_c == 0:
            grid[mover_r : mover_r + n, 0] = _RIVER
            mover_c = 1
        else:
            grid[mover_r : mover_r + n, W - 1] = _RIVER
            mover_c = W - n - 1
    if mover_r == 0 or mover_r + n == H or mover_c == 0 or mover_c + n == W:
        return None
    if min(mover_r, H - (mover_r + n), mover_c, W - (mover_c + n)) > 2:
        return None

    num_targets = random.randint(2, min(4, len(pixel_pos) - 1))
    target_indices = _sample_target_indices(len(pixel_pos), num_targets)
    if target_indices is None:
        return None
    if not reached and len(target_indices) < 2:
        return None

    if reached:
        selectable = target_indices[:-1] if len(target_indices) >= 3 and random.random() < 0.8 else target_indices
        selected_idx = random.choice(selectable)
    else:
        selected_idx = random.choice(target_indices[1:]) if len(target_indices) > 1 else target_indices[0]
        choke_candidates = list(range(max(1, target_indices[0]), selected_idx))
        if not choke_candidates:
            return None
        random.shuffle(choke_candidates)
        added = False
        for seg_idx in choke_candidates[: min(4, len(choke_candidates))]:
            pr1, pc1 = pixel_pos[seg_idx]
            pr2, pc2 = pixel_pos[min(seg_idx + 1, len(pixel_pos) - 1)]
            direction = "h" if pr1 == pr2 else "v"
            before = grid.copy()
            _add_chokepoint(grid, (pr1, pc1), (pr2, pc2), n, direction)
            if _river_connected(grid):
                added = True
                break
            grid = before
        if not added:
            return None

    colors = random.sample(_TARGET_COLORS, num_targets)
    selected_color = colors[target_indices.index(selected_idx)]

    target_specs = []
    for idx, color in zip(target_indices, colors):
        rr, cc = pixel_pos[idx]
        target_specs.append({"idx": idx, "col": color, "r": rr, "c": cc})
        grid[rr : rr + n, cc : cc + n] = color

    marker = _find_selector_slot(grid)
    if marker is None:
        return None
    mr, mc, mh, mw = marker
    grid[mr : mr + mh, mc : mc + mw] = selected_color
    grid[mover_r : mover_r + n, mover_c : mover_c + n] = _MOVER

    trav = (grid == _RIVER)
    trav[mover_r : mover_r + n, mover_c : mover_c + n] = True
    for spec in target_specs:
        trav[spec["r"] : spec["r"] + n, spec["c"] : spec["c"] + n] = True
    feasible = _build_feasible_mask(trav, n)
    if not feasible[mover_r, mover_c]:
        return None
    dist = _bfs_placement(feasible, mover_r, mover_c)

    selected_target = next(spec for spec in target_specs if int(spec["col"]) == selected_color)
    dest_ok = bool(feasible[selected_target["r"], selected_target["c"]]) and int(dist[selected_target["r"], selected_target["c"]]) >= 0
    if reached != dest_ok:
        return None

    reachable_other = 0
    for spec in target_specs:
        if spec is selected_target:
            continue
        if bool(feasible[spec["r"], spec["c"]]) and int(dist[spec["r"], spec["c"]]) >= 0:
            reachable_other += 1
    if not reached and reachable_other == 0:
        return None

    if dest_ok:
        tr, tc = selected_target["r"], selected_target["c"]
    else:
        tr, tc = _find_farthest(dist, mover_r, mover_c)

    output = grid.copy()
    output[mover_r : mover_r + n, mover_c : mover_c + n] = _RIVER
    output[tr : tr + n, tc : tc + n] = _MOVER

    if not np.array_equal(main(grid), output):
        return None
    return grid


def generate_input() -> np.ndarray:
    for _ in range(400):
        result = _gen_attempt()
        if result is not None:
            return result
    raise RuntimeError("Failed to generate valid input after 400 attempts")

