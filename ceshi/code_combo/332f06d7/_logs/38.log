+def _find_branch_paths(main_walk: list[tuple[int, int]], rows: int, cols: int, desired: int) -> list[list[tuple[int, int]]]:
+    used = set(main_walk)
+    branches: list[list[tuple[int, int]]] = []
+    attach_indices = list(range(2, len(main_walk) - 2))
