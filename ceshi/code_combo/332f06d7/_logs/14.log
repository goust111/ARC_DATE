   137	def _detect_squares(grid: np.ndarray, bg: int) -> list[dict]:
   138	    squares: list[dict] = []
   139	    for comp in find_components(grid, bg=bg, connectivity=4, monochromatic=True, return_format="dict"):
   140	        col = int(comp["color"])
   141	        b = comp["bbox"]
   142	        if bbox_h(b) != bbox_w(b):
   143	            continue
   144	        patch = grid[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1]
   145	        if not bool((patch == col).all()):
   146	            continue
   147	        squares.append({"col": col, "r0": int(b[0]), "c0": int(b[1]), "n": int(bbox_h(b))})
   148	    return squares
