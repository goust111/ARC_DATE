   104	def _bfs_placement(feasible: np.ndarray, sr: int, sc: int) -> np.ndarray:
   105	    h2, w2 = feasible.shape
   106	    dist = -np.ones((h2, w2), dtype=int)
   107	    dist[sr, sc] = 0
   108	    q = deque([(sr, sc)])
   109	    while q:
   110	        r, c = q.popleft()
   111	        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
   112	            rr, cc = r + dr, c + dc
   113	            if 0 <= rr < h2 and 0 <= cc < w2 and feasible[rr, cc] and dist[rr, cc] == -1:
   114	                dist[rr, cc] = dist[r, c] + 1
   115	                q.append((rr, cc))
   116	    return dist
