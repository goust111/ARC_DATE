   191	        "H": H,
   192	        "W": W,
   193	        "bg": bg,
   194	        "mover": mover,
   195	        "dest": dest,
   196	        "n": n,
   197	        "start": (sr, sc),
   198	        "terminal": (tr, tc),
   199	        "reached": reached,
   200	    }
