   324	def _extend_to_edge(grid: np.ndarray, pr: int, pc: int, n: int) -> tuple[int, int] | None:
   325	    H, W = grid.shape
   326	    corridor_colors = {_WIDE, _NARROW}
   327	    candidates = []
   328	    for direction in ("top", "bottom", "left", "right"):
   329	        if direction == "top":
   330	            dist = pr
   331	            if dist == 0:
   332	                candidates.append((0, pc, 0))
