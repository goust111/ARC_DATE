   151	def _pick_mover_and_dest(squares: list[dict]) -> tuple[dict, dict]:
   152	    mover = next((sq for sq in squares if int(sq["col"]) == _MOVER), None)
   153	    dest = next((sq for sq in squares if int(sq["col"]) == _DEST), None)
   154	    if mover is not None and dest is not None and int(mover["n"]) == int(dest["n"]):
   155	        return mover, dest
   156	
   157	    by_n: dict[int, list[dict]] = defaultdict(list)
   158	    for sq in squares:
   159	        by_n[int(sq["n"])].append(sq)
   160	    assert not (not by_n)
   161	    nside = max(by_n.items(), key=lambda kv: (len(kv[1]), kv[0]))[0]
   162	    cand = sorted(by_n[int(nside)], key=lambda sq: int(sq["col"]))
   163	    assert not (len(cand) < 2)
   164	    return cand[0], cand[1]
