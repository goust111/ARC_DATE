   335	                candidates.append((0, pc, dist))
   336	        elif direction == "bottom":
   337	            dist = H - (pr + n)
   338	            if dist == 0:
   339	                candidates.append((pr, pc, 0))
   340	                continue
   341	            if all(
   342	                grid[r, c] in corridor_colors | {_BG}
   343	                for r in range(pr + n, H)
   344	                for c in range(pc, pc + n)
   345	                if c < W
   346	            ):
   347	                candidates.append((H - n, pc, dist))
   348	        elif direction == "left":
   349	            dist = pc
   350	            if dist == 0:
