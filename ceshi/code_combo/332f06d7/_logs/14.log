   289	def _compute_offsets(G: int, n: int, num_coarse: int) -> list[int] | None:
   290	    if num_coarse == 1:
   291	        return [1]
   292	    first = 1
   293	    last = G - n - 1
   294	    if last < first:
   295	        return None
   296	    step = (last - first) / (num_coarse - 1)
   297	    return [int(round(first + i * step)) for i in range(num_coarse)]
