   167	def _analyze_scene(grid: np.ndarray) -> dict:
   168	    g = np.array(grid, dtype=int)
   169	    H, W = g.shape
   170	    bg = int(Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0])
   171	
   172	    squares = _detect_squares(g, bg)
   173	    assert not (len(squares) < 2)
   174	    mover, dest = _pick_mover_and_dest(squares)
   175	
   176	    n = int(mover["n"])
   177	    sr, sc = int(mover["r0"]), int(mover["c0"])
   178	    dr, dc = int(dest["r0"]), int(dest["c0"])
   179	
   180	    feasible = _compute_feasible(g, n, int(mover["col"]), int(dest["col"]))
   181	    h2, w2 = feasible.shape
   182	    assert not (not (0 <= sr < h2 and 0 <= sc < w2))
   183	    assert not (not bool(feasible[sr, sc]))
   184	
   185	    dist = _bfs_placement(feasible, sr, sc)
   186	    reached = _dest_reachable(feasible, dist, dr, dc)
   187	    tr, tc = _pick_terminal(dist, feasible, dr, dc, sr, sc)
   188	
   189	    return {
