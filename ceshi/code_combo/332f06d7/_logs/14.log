   203	def main(grid: np.ndarray) -> np.ndarray:
   204	    """
   205	    Fused rule:
   206	    - Dark blue is always traversable.
   207	    - Light blue is traversable only for a 1x1 mover.
   208	    - If the destination is reached, the mover adopts the destination color (red).
   209	    - Otherwise it stops at the farthest reachable placement and stays black.
   210	    - The source block is restored to dark blue.
   211	    """
   212	    info = _analyze_scene(grid)
   213	    out = info["grid"].copy()
   214	
   215	    n = int(info["n"])
   216	    sr, sc = info["start"]
   217	    tr, tc = info["terminal"]
   218	    mover_col = int(info["mover"]["col"])
   219	    dest_col = int(info["dest"]["col"])
   220	
   221	    out[sr : sr + n, sc : sc + n] = _WIDE
   222	    out[tr : tr + n, tc : tc + n] = dest_col if info["reached"] else mover_col
   223	    return out
