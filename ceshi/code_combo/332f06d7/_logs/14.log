   128	    tr, tc = sr, sc
   129	    for r in range(feasible.shape[0]):
   130	        for c in range(feasible.shape[1]):
   131	            if int(dist[r, c]) > best:
   132	                best = int(dist[r, c])
   133	                tr, tc = r, c
