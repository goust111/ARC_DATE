+                    tr, tc = r, c
+        expected[mover_r : mover_r + n, mover_c : mover_c + n] = _RIVER
+        expected[tr : tr + n, tc : tc + n] = _MOVER
+
+    if not np.array_equal(main(grid), expected):
+        return None
+    return grid
