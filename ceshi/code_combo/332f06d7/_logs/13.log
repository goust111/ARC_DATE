from __future__ import annotations

from collections import Counter, defaultdict, deque
import random

import numpy as np
from scipy.ndimage import label as scipy_label

from arc_utils import bbox_h, bbox_w, find_components


def _touches_edge(square: dict, H: int, W: int) -> bool:
    n = int(square["n"])
    r0 = int(square["r0"])
    c0 = int(square["c0"])
    return r0 == 0 or c0 == 0 or r0 + n == H or c0 + n == W


def _edge_gap(square: dict, H: int, W: int) -> int:
    n = int(square["n"])
    r0 = int(square["r0"])
    c0 = int(square["c0"])
    return int(min(r0, H - (r0 + n), c0, W - (c0 + n)))


def _select_roles(cand: list[dict], H: int, W: int) -> tuple[dict, dict]:
    edge = [s for s in cand if _touches_edge(s, H, W)]
    inner = [s for s in cand if not _touches_edge(s, H, W)]
    if edge and inner:
        mover = min(inner, key=lambda s: (_edge_gap(s, H, W), int(s["r0"]), int(s["c0"]), int(s["col"])))
        dest = min(edge, key=lambda s: (_edge_gap(s, H, W), int(s["r0"]), int(s["c0"]), int(s["col"])))
        return mover, dest
    ordered = sorted(cand, key=lambda s: int(s["col"]))
    return ordered[0], ordered[1]


def main(grid: np.ndarray) -> np.ndarray:
    """
    Slide a solid square through a winding channel; if it reaches the target square,
    the two square colors swap locations instead of the target simply disappearing.
    """
    g = np.array(grid, dtype=int)
    H, W = g.shape

    bg = int(
        Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0]
    )

    squares: list[dict] = []
    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict"):
        col = int(comp["color"])
        b = comp["bbox"]
        if bbox_h(b) != bbox_w(b):
            continue
        patch = g[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1]
        if not bool((patch == int(col)).all()):
            continue
        squares.append({"col": col, "r0": int(b[0]), "c0": int(b[1]), "n": int(bbox_h(b))})

    assert not (len(squares) < 2)

    by_n: dict[int, list[dict]] = defaultdict(list)
    for s in squares:
        by_n[int(s["n"])].append(s)
    nside = max(by_n.items(), key=lambda kv: (len(kv[1]), kv[0]))[0]
    cand = by_n[int(nside)]
    assert not (len(cand) < 2)

    mover, dest = _select_roles(cand, H, W)

    n = int(mover["n"])
    sr, sc = int(mover["r0"]), int(mover["c0"])
    dr, dc = int(dest["r0"]), int(dest["c0"])

    counts = Counter(map(int, g.flatten()))
    river = None
    for col, _ct in counts.most_common():
        if int(col) == int(bg):
            continue
        if int(col) in (int(mover["col"]), int(dest["col"])):
            continue
        river = int(col)
        break
    assert not (river is None)

    trav = (g == int(river)) | (g == int(mover["col"])) | (g == int(dest["col"]))

    h2 = int(H - n + 1)
    w2 = int(W - n + 1)
    assert not (h2 <= 0 or w2 <= 0)
    assert not (not (0 <= sr < h2 and 0 <= sc < w2))

    feasible = np.zeros((h2, w2), dtype=bool)
    for r in range(h2):
        for c in range(w2):
            if bool(trav[int(r) : int(r + n), int(c) : int(c + n)].all()):
                feasible[int(r), int(c)] = True
    assert not (not bool(feasible[int(sr), int(sc)]))

    dist = -np.ones((h2, w2), dtype=int)
    q = deque([(int(sr), int(sc))])
    dist[int(sr), int(sc)] = 0
    while q:
        r, c = q.popleft()
        for dr2, dc2 in [(1, 0), (-1, 0), (0, 1), (0, -1)]:
            rr = int(r + dr2)
            cc = int(c + dc2)
            if 0 <= rr < h2 and 0 <= cc < w2 and bool(feasible[rr, cc]) and int(dist[rr, cc]) == -1:
                dist[rr, cc] = int(dist[int(r), int(c)] + 1)
                q.append((int(rr), int(cc)))

    reached_dest = 0 <= dr < h2 and 0 <= dc < w2 and bool(feasible[int(dr), int(dc)]) and int(dist[int(dr), int(dc)]) >= 0
    if reached_dest:
        tr, tc = int(dr), int(dc)
    else:
        best = -1
        tr, tc = int(sr), int(sc)
        for r in range(h2):
            for c in range(w2):
                if int(dist[int(r), int(c)]) > best:
                    best = int(dist[int(r), int(c)])
                    tr, tc = int(r), int(c)

    out = g.copy()
    if reached_dest:
        out[int(sr) : int(sr + n), int(sc) : int(sc + n)] = int(dest["col"])
        out[int(tr) : int(tr + n), int(tc) : int(tc + n)] = int(mover["col"])
    else:
        out[int(sr) : int(sr + n), int(sc) : int(sc + n)] = int(river)
        out[int(tr) : int(tr + n), int(tc) : int(tc + n)] = int(mover["col"])
    return out


