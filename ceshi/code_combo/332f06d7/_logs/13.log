    d8_only[tr:tr+n, tc:tc+n] = mover['col']
    if np.array_equal(out, d8_only):
        same_as_d8_only += 1

    # Original task baseline: lower color moves and simply covers target.
    orig = np.array(grid, copy=True)
    low, high = sorted([mover, dest], key=lambda s: int(s['col']))
    n0 = low['n']
    sr0, sc0 = low['r0'], low['c0']
    dr0, dc0 = high['r0'], high['c0']
    trav0 = (grid == river) | (grid == low['col']) | (grid == high['col'])
    feasible0 = mod._feasible_windows(trav0, n0)
    dist0 = mod._bfs_placement(feasible0, sr0, sc0)
    if 0 <= dr0 < feasible0.shape[0] and 0 <= dc0 < feasible0.shape[1] and feasible0[dr0, dc0] and dist0[dr0, dc0] >= 0:
        tr0, tc0 = dr0, dc0
    else:
        best = -1
        tr0, tc0 = sr0, sc0
        for r in range(feasible0.shape[0]):
            for c in range(feasible0.shape[1]):
                if dist0[r, c] > best:
                    best = dist0[r, c]
                    tr0, tc0 = r, c
    orig[sr0:sr0+n0, sc0:sc0+n0] = river
    orig[tr0:tr0+n0, tc0:tc0+n0] = low['col']
    if np.array_equal(out, orig):
        same_as_original += 1

