+
+def _feasible_windows(traversable: np.ndarray, n: int) -> np.ndarray:
+    H, W = traversable.shape
+    h2, w2 = H - n + 1, W - n + 1
+    assert not (h2 <= 0 or w2 <= 0)
+    feasible = np.zeros((h2, w2), dtype=bool)
+    for r in range(h2):
+        for c in range(w2):
+            if bool(traversable[r : r + n, c : c + n].all()):
+                feasible[r, c] = True
