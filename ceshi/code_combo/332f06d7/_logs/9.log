# Dimension: D6 — 到达时的变换：覆盖/重着色/消除 (transform)
# Change: 可达时移动体覆盖目标位置(目标消失)，原位置恢复为河流色；不可达时移动体停在最远位置，原位置恢复为河流色... → 合并融合

from __future__ import annotations

from collections import Counter, defaultdict, deque
import random

import numpy as np
from scipy.ndimage import label as scipy_label

from arc_utils import bbox_h, bbox_w, find_components

"""
Design analysis for the D6 fusion variant
=========================================

Source-task review:
- No external source task was provided, so the design baseline is the original
  332f06d7 solver/generator only.

a) Concretization and behavior trace
- Input stays visually close to the original task:
  - background = green (dominates corners)
  - river = blue winding corridor
  - mover = one solid n×n square, not touching the border
  - destination = one solid n×n square touching exactly one border, never a corner
- Core change happens only when the mover can reach the destination placement.
- Original reachable behavior:
  - mover slides to the destination n×n slot
  - destination disappears
  - mover color occupies that same n×n slot
- New reachable behavior:
  - mover still travels by the same n×n placement BFS
  - when it reaches the destination, the two same-sized squares fuse into a
    larger 2n×n or n×2n rectangle
  - the destination keeps the border-side half, the mover occupies the inward
    half; both colors remain visible
  - if destination touches top/bottom, fusion is vertical (2n×n)
  - if destination touches left/right, fusion is horizontal (n×2n)
- Example trace for n=2, destination on the top edge:
  - original rule: red 2×2 at rows 0:2 becomes black 2×2 at rows 0:2
  - new rule: rows 0:2 stay red, rows 2:4 directly below become black, so the
    final object is a 4×2 two-color block attached to the same edge
- Unreachable behavior is intentionally unchanged: mover stops at the farthest
  reachable placement, destination stays intact, mover origin becomes river.

b) Complexity calibration
- The rule change is large enough to be visible: reachable outputs no longer
  contain a same-size replacement, they contain a doubled rectangle with both
  input colors preserved.
- The rule is still low-branch:
  - branch 1: reachable vs stuck
  - branch 2: fusion orientation determined only by the visible border side of
    the destination
- This avoids both triviality and excessive case explosion.

c) Implicit-assumption audit against the original main()
- Original `cand.sort(key=lambda s: int(s["col"]))` assumes color order defines
  mover vs destination. That is not visually inferable, so it must be removed.
  New assumption: destination is the unique same-sized solid square touching
  exactly one border; mover is the unique same-sized square touching none.
- Original reachable write:
  `out[tr:tr+n, tc:tc+n] = mover_color`
  assumes "arrival means overwrite destination with one solid n×n color".
  This is false in the variant. Reachable output now depends on the destination
  border side and paints a doubled rectangle with both colors.
- Original generator allowed a destination in a corner. That becomes ambiguous
  because a corner touches two borders and would give two possible fusion
  directions. New generator therefore guarantees exactly one touched border.

d) Placement legality
- The destination is extended to exactly one edge but never to a corner.
- Because the grid size is still at least about 5n, there is always room for
  the inward half of the fused rectangle.
- The added half sits directly inside the grid, adjacent to the destination,
  so it never goes out of bounds.
- Stuck cases remain valid because the fusion branch is never used there.

e) Visual observability
- A human can see:
  - same river-navigation premise as the original task
  - destination always on one border
  - reachable outputs grow into a larger two-color rectangle attached to that
    border instead of collapsing to one color
- No hidden ordering by color id is used in either solver or generator.

f) Visual cleanliness
- Fusion uses only one extra adjacent block, not scattered marks.
- The doubled object stays in one compact rectangle, so there is no clutter or
  overlap ambiguity.

g) Color-change inferability
- Only two object colors participate, and both are already present in the input.
- The output keeps the destination color on the border-side half and the mover
  color on the inward half, giving a stable spatial cue for the color layout.

New solver assumptions to enforce in the generator
--------------------------------------------------
- Among same-sized solid squares, exactly one touches one border and exactly one
  touches none.
- The border-touching square is not in a corner.
- The inward adjacent n×n block next to the destination is inside the grid.
"""


_BG, _RIVER, _MOVER, _DEST = 3, 1, 0, 2
_DIR4 = [(1, 0), (-1, 0), (0, 1), (0, -1)]


def _touching_sides(r0: int, c0: int, n: int, H: int, W: int) -> list[str]:
    sides: list[str] = []
    if r0 == 0:
        sides.append("top")
    if r0 + n == H:
        sides.append("bottom")
    if c0 == 0:
        sides.append("left")
    if c0 + n == W:
        sides.append("right")
    return sides


def _find_solid_squares(g: np.ndarray, bg: int) -> list[dict]:
    squares: list[dict] = []
    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict"):
        col = int(comp["color"])
        b = comp["bbox"]
        if bbox_h(b) != bbox_w(b):
            continue
        patch = g[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1]
        if not bool((patch == col).all()):
            continue
        squares.append({"col": col, "r0": int(b[0]), "c0": int(b[1]), "n": int(bbox_h(b))})
    return squares


def _identify_roles(squares: list[dict], H: int, W: int) -> tuple[dict, dict, str]:
    by_n: dict[int, list[dict]] = defaultdict(list)
    for sq in squares:
        by_n[int(sq["n"])].append(sq)

    candidates: list[tuple[int, dict, dict, str]] = []
    for n, group in by_n.items():
        edge_touchers: list[tuple[dict, str]] = []
        interior: list[dict] = []
        for sq in group:
            sides = _touching_sides(int(sq["r0"]), int(sq["c0"]), int(sq["n"]), H, W)
            if len(sides) == 1:
                edge_touchers.append((sq, sides[0]))
            elif len(sides) == 0:
                interior.append(sq)
        if len(edge_touchers) == 1 and len(interior) == 1:
            candidates.append((n, interior[0], edge_touchers[0][0], edge_touchers[0][1]))

    assert candidates
    n, mover, dest, side = max(candidates, key=lambda item: item[0])
    assert int(mover["n"]) == int(dest["n"]) == int(n)
    return mover, dest, side


def _infer_river(g: np.ndarray, bg: int, mover_col: int, dest_col: int) -> int:
    counts = Counter(map(int, g.flatten()))
    for col, _ct in counts.most_common():
        if col == bg:
            continue
        if col in (mover_col, dest_col):
            continue
        return int(col)
    raise AssertionError("river color not found")


def _bfs_placement(feasible: np.ndarray, sr: int, sc: int) -> np.ndarray:
    h2, w2 = feasible.shape
    dist = -np.ones((h2, w2), dtype=int)
    dist[sr, sc] = 0
    q = deque([(sr, sc)])
    while q:
        r, c = q.popleft()
        for dr, dc in _DIR4:
            rr, cc = r + dr, c + dc
            if 0 <= rr < h2 and 0 <= cc < w2 and feasible[rr, cc] and dist[rr, cc] == -1:
                dist[rr, cc] = dist[r, c] + 1
                q.append((rr, cc))
    return dist


def _build_feasible(trav: np.ndarray, n: int) -> np.ndarray:
    H, W = trav.shape
    h2, w2 = H - n + 1, W - n + 1
    assert h2 > 0 and w2 > 0
    feasible = np.zeros((h2, w2), dtype=bool)
    for r in range(h2):
        for c in range(w2):
            if bool(trav[r : r + n, c : c + n].all()):
                feasible[r, c] = True
    return feasible


def _choose_terminal(dist: np.ndarray, feasible: np.ndarray, sr: int, sc: int, dr: int, dc: int) -> tuple[int, int, bool]:
    h2, w2 = feasible.shape
    dest_ok = 0 <= dr < h2 and 0 <= dc < w2 and feasible[dr, dc] and dist[dr, dc] >= 0
    if dest_ok:
        return dr, dc, True

    best = -1
    tr, tc = sr, sc
    for r in range(h2):
        for c in range(w2):
            if int(dist[r, c]) > best:
                best = int(dist[r, c])
                tr, tc = r, c
    return tr, tc, False


def _paint_fusion(out: np.ndarray, dest: dict, mover_col: int, dest_col: int, side: str) -> None:
    n = int(dest["n"])
    dr, dc = int(dest["r0"]), int(dest["c0"])
    if side == "top":
        out[dr : dr + n, dc : dc + n] = dest_col
        out[dr + n : dr + 2 * n, dc : dc + n] = mover_col
    elif side == "bottom":
        out[dr - n : dr, dc : dc + n] = mover_col
        out[dr : dr + n, dc : dc + n] = dest_col
    elif side == "left":
        out[dr : dr + n, dc : dc + n] = dest_col
        out[dr : dr + n, dc + n : dc + 2 * n] = mover_col
    elif side == "right":
        out[dr : dr + n, dc - n : dc] = mover_col
        out[dr : dr + n, dc : dc + n] = dest_col
    else:
        raise AssertionError(f"unexpected side: {side}")


def _solve(grid: np.ndarray) -> tuple[np.ndarray, dict]:
    g = np.array(grid, dtype=int)
    H, W = g.shape

    bg = int(Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0])
    squares = _find_solid_squares(g, bg)
    assert len(squares) >= 2

    mover, dest, side = _identify_roles(squares, H, W)
    n = int(mover["n"])
    sr, sc = int(mover["r0"]), int(mover["c0"])
    dr, dc = int(dest["r0"]), int(dest["c0"])

    river = _infer_river(g, bg, int(mover["col"]), int(dest["col"]))
    trav = (g == river) | (g == int(mover["col"])) | (g == int(dest["col"]))
    feasible = _build_feasible(trav, n)
    assert feasible[sr, sc]

    dist = _bfs_placement(feasible, sr, sc)
    tr, tc, reached = _choose_terminal(dist, feasible, sr, sc, dr, dc)

    out = g.copy()
    out[sr : sr + n, sc : sc + n] = river
    if reached:
        _paint_fusion(out, dest, int(mover["col"]), int(dest["col"]), side)

