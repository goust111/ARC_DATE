+    if trail_info["trail_steps"] < len(_TRAIL_COLORS):
+        return None
+    if trail_info["used_colors"] != set(_TRAIL_COLORS):
+        return None
+    if trail_info["visible_colors"] != set(_TRAIL_COLORS):
