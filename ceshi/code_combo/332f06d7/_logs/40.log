# Variant of 332f06d7
# Dimension: D3 — 轨迹涂色：路径上的视觉痕迹 (trajectory)
# Change: 无轨迹涂色，方块移动后原位置恢复为河流颜色(蓝色)... → 颜色渐变轨迹

from __future__ import annotations

from collections import Counter, defaultdict, deque
import random

import numpy as np
from scipy.ndimage import label as scipy_label

from arc_utils import bbox_h, bbox_w, find_components

# Design analysis for this D3 variant
# a) Concrete behavior
#    - Input stays structurally identical to the original task: green background, one blue river,
#      one black mover square, one red destination square of the same size.
#    - Output changes only in the "what remains behind after motion" stage.
#    - Original: after motion, the mover's previous cells revert to blue river.
#    - Variant: every vacated top-left placement on the actual motion path is recolored with a
#      distance-coded trail. Near the start the trail uses color 4, the middle uses color 8,
#      and the final vacated placements near the stopping point use color 6. The final mover stays
#      black at its stopping square. Untraversed river stays blue.
#    - Small example in placement coordinates for n=2:
#      path [(2,2),(2,3),(3,3),(4,3)].
#      Original output: first three placements become blue, final placement black.
#      Variant output: first placement becomes color 4, second color 8, third color 6, final
#      placement black. Overlaps are resolved by temporal overwrite, so each pixel shows the last
#      time the mover occupied it before leaving.
# b) Complexity calibration
#    - Only three fixed trail colors are used. This is enough to visibly encode distance while
#      avoiding an explosion of arbitrary color mappings.
#    - The generator rejects samples whose motion is too short to expose the full 3-color gradient.
#      That keeps the D3 change visible instead of collapsing into "just one recolored square".
# c) Implicit-assumption audit against the original main()
#    - Component detection of the two solid squares still works because input is unchanged; trail
#      colors appear only in outputs, never inputs.
#    - River detection via "most common non-bg non-square color" still holds because only blue is
#      present as the non-square traversable color in inputs.
#    - Feasible-placement BFS is unchanged; the variant depends on the visited-parent relation, so
#      BFS now stores parents. This adds the new assumption that the chosen target has a recorded
#      parent chain from start, which the BFS construction guarantees for every reachable placement.
#    - Original unconditional refill of the start square with river would be wrong now; it would
#      erase the new trail. Therefore output rendering must paint the trail directly instead of
#      blindly restoring blue.
# d) Placement legality
#    - Generator still builds the same corridor, same mover/destination placement rules, and same
#      chokepoint construction. No new objects are added to the input, so there are no new overlap
#      constraints there.
#    - Output trail can overlap destination pixels only if the mover physically overlaps them while
#      passing or stopping; that matches the motion semantics.
# e) Visual observability
#    - Across 2-4 examples, the solver-visible invariant is clear: black travels through blue, but
#      the visited path is now marked start→middle→end by fixed colors 4→8→6.
#    - The rule does not rely on hidden numeric ordering of colors in the input. The only ordering
#      is geometric distance along the traversed path, which is visible.
# f) Visual cleanliness
#    - The trail is confined to the mover's occupied footprint, not the entire river, so the river
#      remains readable.
#    - Using three broad bands rather than per-step random colors avoids noisy outputs.
# g) Color-change inferability
#    - The colors always appear in the same ordered role: start-near cells = 4, middle = 8,
#      end-near cells = 6. Generator enforces enough path length that multiple bands are present.
# h) Source-task note
#    - The prompt cites 195c6913 as inspiration. A repository search found only the ARC JSON for
#      that task, not a local solver implementation, so no source solver code was available to read.
# i) New main() assumptions guaranteed by generate_input()
#    - The actual motion path has at least 3 vacated placements, so all three trail bands appear.
#    - Input uses only colors {0,1,2,3}; trail colors {4,8,6} are reserved for outputs only.
#    - The path chosen by BFS is deterministic because neighbor order is fixed and parents are set
#      on first visit; generator validates every sample by comparing against main().

_BG, _RIVER, _MOVER, _DEST = 3, 1, 0, 2
_TRAIL_COLORS = (4, 8, 6)
_DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))


def _find_squares(g: np.ndarray, bg: int) -> list[dict]:
    squares: list[dict] = []
    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict"):
        col = int(comp["color"])
        b = comp["bbox"]
        if bbox_h(b) != bbox_w(b):
            continue
        patch = g[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1]
        if not bool((patch == col).all()):
            continue
        squares.append({"col": col, "r0": int(b[0]), "c0": int(b[1]), "n": int(bbox_h(b))})
    return squares


def _extract_scene(grid: np.ndarray) -> dict:
    g = np.array(grid, dtype=int)
    H, W = g.shape

    bg = int(Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0])
    squares = _find_squares(g, bg)
    assert not (len(squares) < 2)

    by_n: dict[int, list[dict]] = defaultdict(list)
    for sq in squares:
        by_n[int(sq["n"])].append(sq)
    nside = max(by_n.items(), key=lambda kv: (len(kv[1]), kv[0]))[0]
    cand = by_n[int(nside)]
    assert not (len(cand) < 2)
    cand.sort(key=lambda s: int(s["col"]))
    mover = cand[0]
    dest = cand[1]

    counts = Counter(map(int, g.flatten()))
    river = None
    for col, _ct in counts.most_common():
        if int(col) == int(bg):
            continue
        if int(col) in (int(mover["col"]), int(dest["col"])):
            continue
        river = int(col)
        break
    assert not (river is None)

    return {
        "grid": g,
        "shape": (H, W),
        "bg": bg,
        "river": int(river),
        "mover": mover,
        "dest": dest,
    }


def _build_feasible(trav: np.ndarray, n: int) -> np.ndarray:
    H, W = trav.shape
    h2 = H - n + 1
    w2 = W - n + 1
    assert not (h2 <= 0 or w2 <= 0)
    feasible = np.zeros((h2, w2), dtype=bool)
    for r in range(h2):
        for c in range(w2):
            if bool(trav[r : r + n, c : c + n].all()):
                feasible[r, c] = True
    return feasible


def _bfs_with_parent(feasible: np.ndarray, sr: int, sc: int) -> tuple[np.ndarray, dict[tuple[int, int], tuple[int, int] | None]]:
    h2, w2 = feasible.shape
    dist = -np.ones((h2, w2), dtype=int)
    dist[sr, sc] = 0
    parent: dict[tuple[int, int], tuple[int, int] | None] = {(sr, sc): None}
    q = deque([(sr, sc)])
    while q:
        r, c = q.popleft()
        for dr, dc in _DIR4:
            rr, cc = r + dr, c + dc
            if 0 <= rr < h2 and 0 <= cc < w2 and feasible[rr, cc] and dist[rr, cc] == -1:
                dist[rr, cc] = dist[r, c] + 1
                parent[(rr, cc)] = (r, c)
                q.append((rr, cc))
    return dist, parent


def _choose_target(dist: np.ndarray, feasible: np.ndarray, sr: int, sc: int, dr: int, dc: int) -> tuple[tuple[int, int], bool]:
    h2, w2 = feasible.shape
    dest_ok = 0 <= dr < h2 and 0 <= dc < w2 and bool(feasible[dr, dc]) and int(dist[dr, dc]) >= 0
    if dest_ok:
        return (dr, dc), True

    best = -1
    tr, tc = sr, sc
    for r in range(h2):
        for c in range(w2):
            if int(dist[r, c]) > best:
                best = int(dist[r, c])
                tr, tc = r, c
    return (tr, tc), False


def _reconstruct_path(parent: dict[tuple[int, int], tuple[int, int] | None], target: tuple[int, int]) -> list[tuple[int, int]]:
    path: list[tuple[int, int]] = []
    cur: tuple[int, int] | None = target
    while cur is not None:
        path.append(cur)
        cur = parent[cur]
    path.reverse()
    return path


def _solve_path_info(grid: np.ndarray) -> dict:
    scene = _extract_scene(grid)
    g = scene["grid"]
    mover = scene["mover"]
    dest = scene["dest"]
    river = int(scene["river"])

    n = int(mover["n"])
    sr, sc = int(mover["r0"]), int(mover["c0"])
    dr, dc = int(dest["r0"]), int(dest["c0"])

    trav = (g == river) | (g == int(mover["col"])) | (g == int(dest["col"]))
    feasible = _build_feasible(trav, n)
    assert not (not (0 <= sr < feasible.shape[0] and 0 <= sc < feasible.shape[1]))
    assert not (not bool(feasible[sr, sc]))

    dist, parent = _bfs_with_parent(feasible, sr, sc)
    target, reached_dest = _choose_target(dist, feasible, sr, sc, dr, dc)
    assert target in parent
    path = _reconstruct_path(parent, target)

    return {
        **scene,
        "n": n,
        "start": (sr, sc),
        "dest_pos": (dr, dc),
        "target": target,
        "reached_dest": reached_dest,
        "feasible": feasible,
        "dist": dist,
        "path": path,
    }


def _trail_color(step_idx: int, trail_steps: int) -> int:
    if trail_steps <= 1:
        return int(_TRAIL_COLORS[0])
    band = (step_idx * (len(_TRAIL_COLORS) - 1)) // (trail_steps - 1)
    return int(_TRAIL_COLORS[band])


def _render_output_from_info(grid: np.ndarray, info: dict) -> np.ndarray:
    out = np.array(grid, dtype=int).copy()
    n = int(info["n"])
    trail_steps = max(0, len(info["path"]) - 1)

    for step_idx, (r, c) in enumerate(info["path"][:-1]):
        out[r : r + n, c : c + n] = _trail_color(step_idx, trail_steps)

    tr, tc = info["target"]
    out[tr : tr + n, tc : tc + n] = int(info["mover"]["col"])
    return out


def _trail_stats(info: dict) -> dict:
    trail_steps = max(0, len(info["path"]) - 1)
    used = set()
    for step_idx in range(trail_steps):
        used.add(_trail_color(step_idx, trail_steps))
    return {"trail_steps": trail_steps, "used_colors": used}


def main(grid: np.ndarray) -> np.ndarray:
    """
    Slide a solid square through a winding channel to reach a same-sized target square.

    Variant rule:
    - Motion and blocking logic are unchanged from the original task.
