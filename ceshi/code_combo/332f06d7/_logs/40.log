   308	
   309	def _hamiltonian_walk(rows: int, cols: int, start: tuple[int, int], end: tuple[int, int]) -> list[tuple[int, int]] | None:
   310	    total = rows * cols
   311	    best_path = None
   312	    best_len = 0
   313	    for _attempt in range(80):
   314	        visited = {start}
   315	        path = [start]
   316	        cur = start
   317	        while True:
   318	            if cur == end and len(path) >= total * 0.7:
   319	                if len(path) > best_len:
   320	                    best_path = list(path)
   321	                    best_len = len(path)
   322	                break
   323	            neighbors = []
   324	            for dr, dc in _DIR4:
   325	                nr, nc = cur[0] + dr, cur[1] + dc
   326	                if 0 <= nr < rows and 0 <= nc < cols and (nr, nc) not in visited:
   327	                    neighbors.append((nr, nc))
   328	            if not neighbors:
   329	                break
   330	            valid = []
   331	            for nb in neighbors:
   332	                if nb == end:
   333	                    valid.append(nb)
   334	                    continue
   335	                test_visited = visited | {nb}
   336	                seen = {end}
   337	                q = deque([end])
   338	                while q:
   339	                    cr, cc = q.popleft()
   340	                    for dr2, dc2 in _DIR4:
   341	                        nr2, nc2 = cr + dr2, cc + dc2
   342	                        if 0 <= nr2 < rows and 0 <= nc2 < cols and (nr2, nc2) not in test_visited and (nr2, nc2) not in seen:
   343	                            seen.add((nr2, nc2))
   344	                            q.append((nr2, nc2))
   345	                for dr2, dc2 in _DIR4:
   346	                    ar, ac = nb[0] + dr2, nb[1] + dc2
   347	                    if 0 <= ar < rows and 0 <= ac < cols and (ar, ac) not in test_visited and (ar, ac) in seen:
   348	                        valid.append(nb)
   349	                        break
   350	            if not valid:
   351	                break
   352	            random.shuffle(valid)
   353	            nxt = valid[0]
   354	            visited.add(nxt)
   355	            path.append(nxt)
   356	            cur = nxt
   357	        if best_path and best_len >= total * 0.85:
   358	            break
   359	    return best_path
   360	
   361	
   362	def _render_channel(
   363	    grid: np.ndarray, path: list[tuple[int, int]], n: int, offsets_r: list[int], offsets_c: list[int]
   364	) -> list[tuple[int, int]]:
   365	    pixel_pos = []
   366	    for cr, cc in path:
   367	        pr, pc = offsets_r[cr], offsets_c[cc]
   368	        pixel_pos.append((pr, pc))
   369	        grid[pr : pr + n, pc : pc + n] = _RIVER
   370	    for i in range(len(path) - 1):
   371	        pr1, pc1 = pixel_pos[i]
   372	        pr2, pc2 = pixel_pos[i + 1]
   373	        if pr1 == pr2:
   374	            c_lo, c_hi = min(pc1, pc2), max(pc1, pc2) + n
   375	            grid[pr1 : pr1 + n, c_lo:c_hi] = _RIVER
   376	        else:
   377	            r_lo, r_hi = min(pr1, pr2), max(pr1, pr2) + n
   378	            grid[r_lo:r_hi, pc1 : pc1 + n] = _RIVER
   379	    return pixel_pos
   380	
   381	
   382	def _add_chokepoint(
   383	    grid: np.ndarray, pixel_pos_i: tuple[int, int], pixel_pos_j: tuple[int, int], n: int, direction: str
   384	) -> None:
   385	    H, W = grid.shape
   386	    pr1, pc1 = pixel_pos_i
   387	    pr2, pc2 = pixel_pos_j
   388	    narrow_w = random.randint(1, n - 1)
   389	    remove = n - narrow_w
   390	    side = random.randint(0, 1)
   391	
   392	    if direction == "h":
   393	        c_lo = min(pc1, pc2) + n
   394	        c_hi = max(pc1, pc2)
   395	        if c_hi <= c_lo:
   396	            c_lo, c_hi = min(pc1, pc2), max(pc1, pc2) + n
   397	        hold_len = random.randint(1, min(6, max(1, c_hi - c_lo - 2 * remove)))
   398	        total_len = 2 * remove + hold_len
   399	        c_mid = (c_lo + c_hi) // 2
   400	        c_start = max(c_lo, c_mid - total_len // 2)
   401	        for step in range(total_len):
   402	            c = c_start + step
   403	            if not (0 <= c < W):
   404	                continue
   405	            if step < remove:
   406	                depth = step + 1
   407	            elif step >= total_len - remove:
   408	                depth = total_len - step
   409	            else:
   410	                depth = remove
   411	            for k in range(depth):
   412	                rr = pr1 + k if side == 0 else pr1 + n - 1 - k
   413	                if 0 <= rr < H:
   414	                    grid[rr, c] = _BG
   415	    else:
   416	        r_lo = min(pr1, pr2) + n
   417	        r_hi = max(pr1, pr2)
   418	        if r_hi <= r_lo:
   419	            r_lo, r_hi = min(pr1, pr2), max(pr1, pr2) + n
   420	        hold_len = random.randint(1, min(6, max(1, r_hi - r_lo - 2 * remove)))
   421	        total_len = 2 * remove + hold_len
   422	        r_mid = (r_lo + r_hi) // 2
   423	        r_start = max(r_lo, r_mid - total_len // 2)
   424	        for step in range(total_len):
   425	            r = r_start + step
   426	            if not (0 <= r < H):
   427	                continue
   428	            if step < remove:
   429	                depth = step + 1
   430	            elif step >= total_len - remove:
   431	                depth = total_len - step
   432	            else:
   433	                depth = remove
   434	            for k in range(depth):
   435	                cc = pc1 + k if side == 0 else pc1 + n - 1 - k
   436	                if 0 <= cc < W:
   437	                    grid[r, cc] = _BG
   438	
   439	
   440	def _river_connected(grid: np.ndarray) -> bool:
   441	    mask = (grid == _RIVER) | (grid == _MOVER) | (grid == _DEST)
   442	    if not bool(mask.any()):
   443	        return False
   444	    _labeled, num = scipy_label(mask.astype(int))
   445	    return int(num) == 1
   446	
   447	
   448	def _compute_offsets(G: int, n: int, num_coarse: int, margin: int) -> list[int] | None:
   449	    if num_coarse == 1:
   450	        return [margin]
   451	    first = margin
   452	    last = G - n - margin
   453	    if last < first:
   454	        return None
   455	    step = (last - first) / (num_coarse - 1)
   456	    return [int(round(first + i * step)) for i in range(num_coarse)]
   457	
   458	
   459	def _gen_attempt() -> np.ndarray | None:
   460	    reached = random.random() < 0.5
   461	    n = random.choice([1, 2, 3, 4]) if reached else random.choice([2, 3, 4])
   462	
   463	    min_size = max(10, 5 * n)
   464	    if min_size > 20:
   465	        return None
   466	    G = random.randint(min_size, 20)
   467	    H = W = G
   468	
   469	    max_margin = max(1, min(3, (G - n - 3) // 2))
   470	    if max_margin < 1:
   471	        return None
   472	    margin = random.randint(1, max_margin)
   473	
   474	    min_spacing = n + 1
   475	    usable = G - 2 * margin
   476	    max_coarse = max(3, usable // min_spacing)
   477	    coarse_dim = random.randint(3, min(6, max_coarse))
   478	    coarse_rows = coarse_cols = coarse_dim
   479	
   480	    offsets_r = _compute_offsets(G, n, coarse_rows, margin)
   481	    offsets_c = _compute_offsets(G, n, coarse_cols, margin)
   482	    if offsets_r is None or offsets_c is None:
   483	        return None
   484	    for i in range(len(offsets_r) - 1):
   485	        if offsets_r[i + 1] - offsets_r[i] < n:
   486	            return None
   487	    for i in range(len(offsets_c) - 1):
   488	        if offsets_c[i + 1] - offsets_c[i] < n:
   489	            return None
   490	
   491	    edge_cells = set()
   492	    for c in range(coarse_cols):
   493	        edge_cells.add((0, c))
   494	        edge_cells.add((coarse_rows - 1, c))
   495	    for r in range(1, coarse_rows - 1):
   496	        edge_cells.add((r, 0))
   497	        edge_cells.add((r, coarse_cols - 1))
   498	    edge_list = list(edge_cells)
   499	    random.shuffle(edge_list)
   500	    start_coarse = edge_list[0]
   501	    far = sorted(edge_list, key=lambda e: -(abs(e[0] - start_coarse[0]) + abs(e[1] - start_coarse[1])))
   502	    end_coarse = far[0] if far[0] != start_coarse else far[1]
   503	
   504	    walk = _hamiltonian_walk(coarse_rows, coarse_cols, start_coarse, end_coarse)
   505	    if walk is None or len(walk) < 4:
   506	        return None
   507	    if len({cr for cr, _ in walk}) < coarse_rows or len({cc for _, cc in walk}) < coarse_cols:
   508	        return None
   509	
   510	    grid = np.full((H, W), _BG, dtype=int)
   511	    pixel_pos = _render_channel(grid, walk, n, offsets_r, offsets_c)
   512	
   513	    mover_r, mover_c = pixel_pos[0]
   514	    dest_r, dest_c = pixel_pos[-1]
   515	
   516	    grid[mover_r : mover_r + n, mover_c : mover_c + n] = _RIVER
   517	    grid[dest_r : dest_r + n, dest_c : dest_c + n] = _RIVER
   518	
   519	    if not reached and n >= 2:
   520	        num_choke = random.randint(1, min(3, len(walk) - 2))

