   169	def _bfs_with_parent(
   170	    feasible: np.ndarray, sr: int, sc: int
   171	) -> tuple[np.ndarray, dict[tuple[int, int], tuple[int, int] | None]]:
   172	    h2, w2 = feasible.shape
   173	    dist = -np.ones((h2, w2), dtype=int)
   174	    dist[sr, sc] = 0
   175	    parent: dict[tuple[int, int], tuple[int, int] | None] = {(sr, sc): None}
   176	    q = deque([(sr, sc)])
