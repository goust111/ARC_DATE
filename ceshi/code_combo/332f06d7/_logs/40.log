   156	def _build_feasible(trav: np.ndarray, n: int) -> np.ndarray:
   157	    H, W = trav.shape
   158	    h2 = H - n + 1
   159	    w2 = W - n + 1
   160	    assert h2 > 0 and w2 > 0
   161	    feasible = np.zeros((h2, w2), dtype=bool)
