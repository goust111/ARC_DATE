+        if not _river_connected(grid):
+            return None
+
+    feasible_base = _feasible_from_river(grid, n)
+    if not bool(feasible_base[hidden_sr, hidden_sc]):
+        return None
+
+    base_options = []
+    for step in _DIR4:
+        summary = _branch_summary(feasible_base, hidden_sr, hidden_sc, dest_r, dest_c, step)
