   200	def _decode_start_from_src_marker(src_pt: tuple[int, int], n: int, h: int, w: int) -> tuple[int, int]:
   201	    r, c = src_pt
   202	    if r == 0:
   203	        return 1, c
   204	    if r == h - 1:
   205	        return h - n - 1, c
   206	    if c == 0:
   207	        return r, 1
   208	    if c == w - 1:
   209	        return r, w - n - 1
   210	    raise AssertionError("Source marker must lie on the border")
