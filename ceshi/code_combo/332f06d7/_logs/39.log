   135	def _branch_dist(feasible: np.ndarray, sr: int, sc: int, step: tuple[int, int]) -> tuple[np.ndarray | None, tuple[int, int]]:
   136	    dr, dc = step
   137	    h2, w2 = feasible.shape
   138	    fr, fc = sr + dr, sc + dc
   139	    if not (0 <= fr < h2 and 0 <= fc < w2):
   140	        return None, (fr, fc)
   141	    if not feasible[fr, fc]:
   142	        return None, (fr, fc)
   143	    allowed = feasible.copy()
   144	    allowed[sr, sc] = False
   145	    if not allowed[fr, fc]:
   146	        return None, (fr, fc)
   147	    return _bfs_placement(allowed, fr, fc), (fr, fc)
