            ```python
            # Variant of 332f06d7
# Dimension: D20 — 移动体起始位置约束 (src)
# Change: 移动体位于通道内部，靠近网格边缘但不接触(距边缘1-2像素)，不在四个角落... → 起点由边缘标记指示

from __future__ import annotations

from collections import Counter, deque
import random

import numpy as np
from scipy.ndimage import label as scipy_label

from arc_utils import bbox_h, bbox_w, find_components


# Design analysis for the D20 variant
# ----------------------------------
# a) Concrete visual change and behavior trace
#    - Original input shows two same-size solid squares on the blue river:
#      a black mover and a red destination.
#    - Variant input removes the black square entirely. The blue river still
#      contains the hidden n x n starting pocket, but that pocket remains blue.
#      A single yellow border pixel marks where the black square enters.
#    - The yellow marker encodes the hidden mover's top-left coordinate:
#      top marker    (0, c)     -> hidden start at (1, c)
#      bottom marker (H-1, c)   -> hidden start at (H-n-1, c)
#      left marker   (r, 0)     -> hidden start at (r, 1)
#      right marker  (r, W-1)   -> hidden start at (r, W-n-1)
#    - Example trace:
#      original: visible black square at (1, 6) starts BFS directly there.
#      variant: a yellow pixel at (0, 6) means "pretend the black n x n square
#      starts at (1, 6)". BFS, chokepoint logic, and stopping rule then proceed
#      exactly as before.
#    - Output keeps the yellow marker unchanged and paints the black square only
#      at its final resting place. The hidden source pocket stays blue because
#      it was already river in the input.
#
# b) Complexity calibration
#    - Only one new mechanism is introduced: a single border control pixel.
#    - The rest of the task remains the original channel-sliding puzzle, so the
#      visual difference is obvious but the rule set does not explode.
#    - To keep the marker and destination visually distinct, generation uses
#      n in {2, 3, 4}. If n were 1, both the red destination and the yellow
#      control would collapse to single border pixels, weakening the new cue.
#
# c) Original-code assumptions that break under D20
#    - Original square detection assumes there are at least two visible solid
#      squares and uses color ordering to choose mover vs destination.
#      That fails now because the mover is hidden.
#    - Original traversable mask includes mover pixels. That is no longer
#      needed; the hidden start pocket is already blue river.
#    - Original generator validates feasibility from the visible mover location.
#      The new generator must validate from the decoded hidden start.
#
# d) Placement legality
#    - The control pixel is always on the border, never in a corner.
#    - Its decoded hidden n x n start stays one cell inside the chosen edge and
#      does not overlap the red destination.
#    - The river is still drawn first, then the red destination and yellow
#      marker are overlaid, so the solver sees a legal traversable corridor.
#
# e) Visual observability
#    - Across examples, the only new non-original color is the border marker.
#    - The black square never appears in the input, so the solver must use the
#      marker; this cannot silently degenerate back to the original task.
#    - The red target still reveals n directly, making the hidden source size
#      inferable by inspection.
#
# f) Visual cleanliness
#    - Only one yellow control pixel is added.
#    - It sits on the frame, outside the river interior, so it does not clutter
#      the corridor or obscure chokepoints.
#
# g) Color inferability
#    - Colors remain structured and low-entropy:
#      green bg, blue river, red destination, yellow source marker, black mover.
#    - Yellow always means "entry marker" and black only appears in the output,
#      which makes the role mapping easy to infer from 2-4 samples.
#
# h) Quantifiable anti-degeneration target
#    - Every generated input must satisfy:
#      1. zero black pixels in the input,
#      2. exactly one yellow border control pixel,
#      3. a decodable hidden start whose BFS result matches the output.
#    - This is stricter than merely checking main(input) does not crash.
#
# i) New solver assumptions and generator guarantees
#    - Solver assumes the largest solid non-bg square is the destination.
#      Generator guarantees the only solid square of size >= 2 is the red one.
#    - Solver assumes there is exactly one yellow control pixel on the border.
#      Generator places exactly one and never in a corner.
#    - Solver assumes the decoded hidden start pocket is fully traversable.
#      Generator keeps that n x n pocket blue and validates feasibility there.


_BG, _RIVER, _MOVER, _DEST, _CTRL = 3, 1, 0, 2, 4


def _bfs_placement(feasible: np.ndarray, sr: int, sc: int) -> np.ndarray:
    h2, w2 = feasible.shape
    dist = -np.ones((h2, w2), dtype=int)
    dist[sr, sc] = 0
    q = deque([(sr, sc)])
    while q:
        r, c = q.popleft()
        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
            rr, cc = r + dr, c + dc
            if 0 <= rr < h2 and 0 <= cc < w2 and feasible[rr, cc] and dist[rr, cc] == -1:
                dist[rr, cc] = dist[r, c] + 1
                q.append((rr, cc))
    return dist


def _hamiltonian_walk(rows: int, cols: int, start: tuple[int, int], end: tuple[int, int]):
    total = rows * cols
    best_path = None
    best_len = 0
    for _attempt in range(80):
        visited = {start}
        path = [start]
        cur = start
        while True:
            if cur == end and len(path) >= total * 0.7:
                if len(path) > best_len:
                    best_path = list(path)
                    best_len = len(path)
                break
            neighbors = []
            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nr, nc = cur[0] + dr, cur[1] + dc
                if 0 <= nr < rows and 0 <= nc < cols and (nr, nc) not in visited:
                    neighbors.append((nr, nc))
            if not neighbors:
                break
            valid = []
            for nb in neighbors:
                if nb == end:
                    valid.append(nb)
                    continue
                test_visited = visited | {nb}
                seen = {end}
                q = deque([end])
                while q:
                    cr, cc = q.popleft()
                    for dr2, dc2 in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                        nr2, nc2 = cr + dr2, cc + dc2
                        if (
                            0 <= nr2 < rows
                            and 0 <= nc2 < cols
                            and (nr2, nc2) not in test_visited
                            and (nr2, nc2) not in seen
                        ):
                            seen.add((nr2, nc2))
                            q.append((nr2, nc2))
                for dr2, dc2 in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                    ar, ac = nb[0] + dr2, nb[1] + dc2
                    if (
                        0 <= ar < rows
                        and 0 <= ac < cols
                        and (ar, ac) not in test_visited
                        and (ar, ac) in seen
                    ):
                        valid.append(nb)
                        break
            if not valid:
                break
            random.shuffle(valid)
            nxt = valid[0]
            visited.add(nxt)
            path.append(nxt)
            cur = nxt
        if best_path and best_len >= total * 0.85:
            break
    return best_path


def _render_channel(
    grid: np.ndarray,
    path: list[tuple[int, int]],
    n: int,
    offsets_r: list[int],
    offsets_c: list[int],
) -> list[tuple[int, int]]:
    pixel_pos: list[tuple[int, int]] = []
    for cr, cc in path:
        pr, pc = offsets_r[cr], offsets_c[cc]
        pixel_pos.append((pr, pc))
        grid[pr : pr + n, pc : pc + n] = _RIVER
    for i in range(len(path) - 1):
        pr1, pc1 = pixel_pos[i]
        pr2, pc2 = pixel_pos[i + 1]
        if pr1 == pr2:
            c_lo, c_hi = min(pc1, pc2), max(pc1, pc2) + n
            grid[pr1 : pr1 + n, c_lo:c_hi] = _RIVER
        else:
            r_lo, r_hi = min(pr1, pr2), max(pr1, pr2) + n
            grid[r_lo:r_hi, pc1 : pc1 + n] = _RIVER
    return pixel_pos


def _add_chokepoint(
    grid: np.ndarray,
    pixel_pos_i: tuple[int, int],
    pixel_pos_j: tuple[int, int],
    n: int,
    direction: str,
) -> None:
    h, w = grid.shape
    pr1, pc1 = pixel_pos_i
    pr2, pc2 = pixel_pos_j
    narrow_w = random.randint(1, n - 1)
    remove = n - narrow_w
    side = random.randint(0, 1)

    if direction == "h":
        c_lo = min(pc1, pc2) + n
        c_hi = max(pc1, pc2)
        if c_hi <= c_lo:
            c_lo, c_hi = min(pc1, pc2), max(pc1, pc2) + n
        hold_len = random.randint(1, min(6, max(1, c_hi - c_lo - 2 * remove)))
        total_len = 2 * remove + max(1, hold_len)
        c_mid = (c_lo + c_hi) // 2
        c_start = max(c_lo, c_mid - total_len // 2)
        for step in range(total_len):
            c = c_start + step
            if not (0 <= c < w):
                continue
            if step < remove:
                depth = step + 1
            elif step >= total_len - remove:
                depth = total_len - step
            else:
                depth = remove
            for k in range(depth):
                rr = pr1 + k if side == 0 else pr1 + n - 1 - k
                if 0 <= rr < h:
                    grid[rr, c] = _BG
    else:
        r_lo = min(pr1, pr2) + n
        r_hi = max(pr1, pr2)
        if r_hi <= r_lo:
            r_lo, r_hi = min(pr1, pr2), max(pr1, pr2) + n
        hold_len = random.randint(1, min(6, max(1, r_hi - r_lo - 2 * remove)))
        total_len = 2 * remove + max(1, hold_len)
        r_mid = (r_lo + r_hi) // 2
        r_start = max(r_lo, r_mid - total_len // 2)
        for step in range(total_len):
            r = r_start + step
            if not (0 <= r < h):
                continue
            if step < remove:
                depth = step + 1
            elif step >= total_len - remove:
                depth = total_len - step
            else:
                depth = remove
            for k in range(depth):
                cc = pc1 + k if side == 0 else pc1 + n - 1 - k
                if 0 <= cc < w:
                    grid[r, cc] = _BG


def _river_connected(grid: np.ndarray) -> bool:
    mask = (grid == _RIVER) | (grid == _DEST)
    if not mask.any():
        return False
    _labeled, num = scipy_label(mask.astype(int))
    return int(num) == 1


def _compute_offsets(gsize: int, n: int, num_coarse: int) -> list[int] | None:
    if num_coarse == 1:
        return [1]
    first = 1
    last = gsize - n - 1
    if last < first:
        return None
    step = (last - first) / (num_coarse - 1)
    return [int(round(first + i * step)) for i in range(num_coarse)]


def _is_border_square(square: dict, h: int, w: int) -> bool:
    r0, c0, n = int(square["r0"]), int(square["c0"]), int(square["n"])
    return r0 == 0 or c0 == 0 or r0 + n == h or c0 + n == w


def _decode_start_from_ctrl(ctrl_pt: tuple[int, int], n: int, h: int, w: int) -> tuple[int, int]:
    r, c = ctrl_pt
    if r == 0:
        return 1, c
    if r == h - 1:
        return h - n - 1, c
    if c == 0:
        return r, 1
    if c == w - 1:
        return r, w - n - 1
    raise AssertionError("Control pixel must lie on the border")


def _control_from_start_side(start_coarse: tuple[int, int], sr: int, sc: int, coarse_rows: int, coarse_cols: int, h: int, w: int) -> tuple[int, int]:
    cr, cc = start_coarse
    if cr == 0:
        return 0, sc
    if cr == coarse_rows - 1:
        return h - 1, sc
    if cc == 0:
        return sr, 0
    if cc == coarse_cols - 1:
        return sr, w - 1
    raise AssertionError("Start coarse cell must be on the border")


def main(grid: np.ndarray) -> np.ndarray:
    """
    Variant rule:
    - The red n x n square is still the destination.
    - The black mover is hidden in the input.
    - A single yellow border pixel marks the hidden mover's entry position.
    - Decode that hidden start, then run the original sliding-square BFS rule.
    """
    g = np.array(grid, dtype=int)
    h, w = g.shape

    bg = int(Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0])

    squares: list[dict] = []
    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict"):
        col = int(comp["color"])
        b = comp["bbox"]
        if bbox_h(b) != bbox_w(b):
            continue
        patch = g[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1]
        if not bool((patch == col).all()):
            continue
        squares.append({"col": col, "r0": int(b[0]), "c0": int(b[1]), "n": int(bbox_h(b))})

    assert squares

    dest = max(squares, key=lambda s: int(s["n"]))
    n = int(dest["n"])
    dr, dc = int(dest["r0"]), int(dest["c0"])

    ctrl_candidates = [
        s
        for s in squares
        if int(s["n"]) == 1 and _is_border_square(s, h, w) and int(s["col"]) != int(dest["col"])
    ]
    assert ctrl_candidates
    ctrl = int(ctrl_candidates[0]["col"])
    ctrl_pts = [(int(r), int(c)) for r, c in np.argwhere(g == ctrl)]
    assert len(ctrl_pts) == 1
    sr, sc = _decode_start_from_ctrl(ctrl_pts[0], n, h, w)

    counts = Counter(map(int, g.flatten()))
    river = None
    for col, _ct in counts.most_common():
        if col in (bg, int(dest["col"]), ctrl):
            continue
        river = int(col)
        break
    assert river is not None

    trav = (g == river) | (g == int(dest["col"]))

    h2 = h - n + 1
    w2 = w - n + 1
    assert h2 > 0 and w2 > 0
    assert 0 <= sr < h2 and 0 <= sc < w2

    feasible = np.zeros((h2, w2), dtype=bool)
    for r in range(h2):
        for c in range(w2):
            if bool(trav[r : r + n, c : c + n].all()):
                feasible[r, c] = True
    assert feasible[sr, sc]

    dist = _bfs_placement(feasible, sr, sc)

    if 0 <= dr < h2 and 0 <= dc < w2 and feasible[dr, dc] and dist[dr, dc] >= 0:
        tr, tc = dr, dc
    else:
        best = -1
        tr, tc = sr, sc
        for r in range(h2):
            for c in range(w2):
                if dist[r, c] > best:
                    best = int(dist[r, c])
                    tr, tc = r, c

    out = g.copy()
    out[tr : tr + n, tc : tc + n] = _MOVER
    return out


def _gen_attempt() -> np.ndarray | None:
    reached = random.random() < 0.5
    n = random.choice([2, 3, 4])

    min_size = max(10, 5 * n)
    if min_size > 20:
        return None
    gsize = random.randint(min_size, 20)
    h = w = gsize

    min_spacing = n + 1
    max_coarse = max(3, (gsize - 2) // min_spacing)
    coarse_dim = random.randint(3, min(6, max_coarse))
    coarse_rows = coarse_cols = coarse_dim

    offsets_r = _compute_offsets(gsize, n, coarse_rows)
    offsets_c = _compute_offsets(gsize, n, coarse_cols)
    if offsets_r is None or offsets_c is None:
        return None
    for i in range(len(offsets_r) - 1):
        if offsets_r[i + 1] - offsets_r[i] < n:
            return None
    for i in range(len(offsets_c) - 1):
        if offsets_c[i + 1] - offsets_c[i] < n:
            return None

    edge_cells = []
    for c in range(1, coarse_cols - 1):
        edge_cells.append((0, c))
        edge_cells.append((coarse_rows - 1, c))
    for r in range(1, coarse_rows - 1):
        edge_cells.append((r, 0))
        edge_cells.append((r, coarse_cols - 1))
    if len(edge_cells) < 2:
        return None

    random.shuffle(edge_cells)
    start_coarse = edge_cells[0]
    far = sorted(edge_cells, key=lambda e: -(abs(e[0] - start_coarse[0]) + abs(e[1] - start_coarse[1])))
    end_coarse = far[0] if far[0] != start_coarse else far[1]

    walk = _hamiltonian_walk(coarse_rows, coarse_cols, start_coarse, end_coarse)
    if walk is None or len(walk) < 4:
        return None
    if len(set(cr for cr, _ in walk)) < coarse_rows or len(set(cc for _, cc in walk)) < coarse_cols:
        return None

    grid = np.full((h, w), _BG, dtype=int)
    pixel_pos = _render_channel(grid, walk, n, offsets_r, offsets_c)

    mask = grid != _BG
    if np.any(mask, axis=1).sum() / h < 0.70 or np.any(mask, axis=0).sum() / w < 0.70:
        return None

    start_r, start_c = pixel_pos[0]
    dest_r, dest_c = pixel_pos[-1]

    def _extend_to_edge(pr: int, pc: int) -> tuple[int, int] | None:
        candidates = []
        for direction in ("top", "bottom", "left", "right"):
            if direction == "top":
                dist = pr
                if all(grid[r, c] in (_BG, _RIVER) for r in range(pr) for c in range(pc, pc + n) if c < w):
                    candidates.append((0, pc, dist))
            elif direction == "bottom":
                dist = h - (pr + n)
                if all(
                    grid[r, c] in (_BG, _RIVER)
                    for r in range(pr + n, h)
                    for c in range(pc, pc + n)
                    if c < w
                ):
                    candidates.append((h - n, pc, dist))
            elif direction == "left":
                dist = pc
                if all(grid[r, c] in (_BG, _RIVER) for r in range(pr, pr + n) for c in range(pc) if r < h):
                    candidates.append((pr, 0, dist))
            else:
                dist = w - (pc + n)
                if all(
                    grid[r, c] in (_BG, _RIVER)
                    for r in range(pr, pr + n)
                    for c in range(pc + n, w)
                    if r < h
                ):
                    candidates.append((pr, w - n, dist))
        if not candidates:
            return None
        candidates.sort(key=lambda x: x[2])
        return int(candidates[0][0]), int(candidates[0][1])

    edge_dest = _extend_to_edge(dest_r, dest_c)
    if edge_dest is None:
        return None
    new_dest_r, new_dest_c = edge_dest
    if new_dest_r != dest_r:
        r_lo, r_hi = min(new_dest_r, dest_r), max(new_dest_r, dest_r) + n
        grid[r_lo:r_hi, dest_c : dest_c + n] = _RIVER
    if new_dest_c != dest_c:
        c_lo, c_hi = min(new_dest_c, dest_c), max(new_dest_c, dest_c) + n
        grid[dest_r : dest_r + n, c_lo:c_hi] = _RIVER
    dest_r, dest_c = new_dest_r, new_dest_c

    if not (dest_r == 0 or dest_r + n == h or dest_c == 0 or dest_c + n == w):
        return None
    if (dest_r in (0, h - n)) and (dest_c in (0, w - n)):
        return None

    hidden_sr, hidden_sc = start_r, start_c
    if not (0 < hidden_sr < h - n and 0 < hidden_sc < w - n):
        return None

    ctrl_r, ctrl_c = _control_from_start_side(start_coarse, hidden_sr, hidden_sc, coarse_rows, coarse_cols, h, w)
    if ctrl_r in (0, h - 1) and ctrl_c in (0, w - 1):
        return None

    grid[dest_r : dest_r + n, dest_c : dest_c + n] = _RIVER

    if not reached:
        num_choke = random.randint(1, min(3, len(walk) - 2))
        min_seg = max(1, len(walk) // 4)
        available = list(range(min_seg, len(walk) - 1))
        random.shuffle(available)
        for seg_idx in available[:num_choke]:
            pr1, pc1 = pixel_pos[seg_idx]
            pr2, pc2 = pixel_pos[min(seg_idx + 1, len(pixel_pos) - 1)]
            direction = "h" if pr1 == pr2 else "v"
            _add_chokepoint(grid, (pr1, pc1), (pr2, pc2), n, direction)
        if not _river_connected(grid):
            return None

    grid[dest_r : dest_r + n, dest_c : dest_c + n] = _DEST
    grid[ctrl_r, ctrl_c] = _CTRL

    if np.count_nonzero(grid == _MOVER) != 0:
        return None
    if np.count_nonzero(grid == _CTRL) != 1:
        return None

    trav = (grid == _RIVER) | (grid == _DEST)
    h2, w2 = h - n + 1, w - n + 1
    feasible = np.zeros((h2, w2), dtype=bool)
    for r in range(h2):
        for c in range(w2):
            if bool(trav[r : r + n, c : c + n].all()):
                feasible[r, c] = True
    if not feasible[hidden_sr, hidden_sc]:
        return None

    dist = _bfs_placement(feasible, hidden_sr, hidden_sc)
    dest_ok = 0 <= dest_r < h2 and 0 <= dest_c < w2 and feasible[dest_r, dest_c] and dist[dest_r, dest_c] >= 0
    if reached and not dest_ok:
        return None
    if not reached and dest_ok:
        return None

    if dest_ok:
        tr, tc = dest_r, dest_c
    else:
        best_d = -1
        tr, tc = hidden_sr, hidden_sc
        for r in range(h2):
            for c in range(w2):
                if dist[r, c] > best_d:
                    best_d = int(dist[r, c])
                    tr, tc = r, c

    output = grid.copy()
    output[tr : tr + n, tc : tc + n] = _MOVER

    if not np.array_equal(main(grid), output):
        return None
    return grid


def generate_input() -> np.ndarray:
    for _ in range(300):
        result = _gen_attempt()
        if result is not None:
            return result
    raise RuntimeError("Failed to generate valid input after 300 attempts")

