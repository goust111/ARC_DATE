   384	        hold_len = random.randint(1, min(6, max(1, c_hi - c_lo - 2 * remove)))
   385	        total_len = 2 * remove + max(1, hold_len)
   386	        c_mid = (c_lo + c_hi) // 2
   387	        c_start = max(c_lo, c_mid - total_len // 2)
   388	        for step in range(total_len):
