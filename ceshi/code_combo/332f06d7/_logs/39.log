def _pick_control_cell(
    grid: np.ndarray, step: tuple[int, int], mover_r: int, mover_c: int, n: int
) -> tuple[int, int] | None:
    H, W = grid.shape
    pref_r = mover_r + n // 2
    pref_c = mover_c + n // 2

    if step == (1, 0):
        row = 0
        cols = sorted(range(1, W - 1), key=lambda c: abs(c - pref_c))
        for c in cols:
            if grid[row, c] != _BG:
                continue
            if row + 1 < H and grid[row + 1, c] == _DEST:
                continue
            return row, c
    elif step == (-1, 0):
        row = H - 1
        cols = sorted(range(1, W - 1), key=lambda c: abs(c - pref_c))
        for c in cols:
            if grid[row, c] != _BG:
                continue
            if row - 1 >= 0 and grid[row - 1, c] == _DEST:
                continue
            return row, c
    elif step == (0, 1):
        col = 0
        rows = sorted(range(1, H - 1), key=lambda r: abs(r - pref_r))
        for r in rows:
            if grid[r, col] != _BG:
                continue
            if col + 1 < W and grid[r, col + 1] == _DEST:
                continue
            return r, col
    else:
        col = W - 1
        rows = sorted(range(1, H - 1), key=lambda r: abs(r - pref_r))
        for r in rows:
            if grid[r, col] != _BG:
                continue
            if col - 1 >= 0 and grid[r, col - 1] == _DEST:
                continue
            return r, col
    return None


