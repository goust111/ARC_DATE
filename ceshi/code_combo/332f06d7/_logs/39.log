+        free_target = (dest_r, dest_c)
+    else:
+        free_target = _pick_farthest(dist_free, (hidden_sr, hidden_sc))
+    if free_target == (tr, tc):
+        return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(500):
+        try:
+            result = _gen_attempt()
+        except Exception:
+            result = None
+        if result is not None:
