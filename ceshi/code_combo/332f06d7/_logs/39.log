   161	def _simulate_direction(
   162	    feasible: np.ndarray, sr: int, sc: int, dest_r: int, dest_c: int, step: tuple[int, int]
   163	) -> tuple[int, int, bool, np.ndarray | None]:
   164	    dist, start_pos = _branch_dist(feasible, sr, sc, step)
   165	    if dist is None:
   166	        return int(sr), int(sc), False, None
   167	    if 0 <= dest_r < dist.shape[0] and 0 <= dest_c < dist.shape[1] and int(dist[dest_r, dest_c]) >= 0:
   168	        return int(dest_r), int(dest_c), True, dist
   169	    tr, tc = _pick_farthest(dist, start_pos)
   170	    return int(tr), int(tc), False, dist
