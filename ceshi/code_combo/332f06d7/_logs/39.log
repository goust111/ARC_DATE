   291	def _hamiltonian_walk(rows: int, cols: int, start: tuple[int, int], end: tuple[int, int]) -> list[tuple[int, int]] | None:
   292	    total = rows * cols
   293	    best_path = None
   294	    best_len = 0
   295	    for _attempt in range(80):
   296	        visited = {start}
   297	        path = [start]
   298	        cur = start
   299	        while True:
   300	            if cur == end and len(path) >= total * 0.7:
   301	                if len(path) > best_len:
   302	                    best_path = list(path)
   303	                    best_len = len(path)
   304	                break
   305	            neighbors = []
   306	            for dr, dc in _DIR4:
   307	                nr, nc = cur[0] + dr, cur[1] + dc
   308	                if 0 <= nr < rows and 0 <= nc < cols and (nr, nc) not in visited:
   309	                    neighbors.append((nr, nc))
   310	            if not neighbors:
   311	                break
   312	            valid = []
   313	            for nb in neighbors:
   314	                if nb == end:
   315	                    valid.append(nb)
   316	                    continue
   317	                test_visited = visited | {nb}
   318	                seen = {end}
   319	                q = deque([end])
   320	                while q:
   321	                    cr, cc = q.popleft()
   322	                    for dr2, dc2 in _DIR4:
   323	                        nr2, nc2 = cr + dr2, cc + dc2
   324	                        if (
   325	                            0 <= nr2 < rows
   326	                            and 0 <= nc2 < cols
   327	                            and (nr2, nc2) not in test_visited
   328	                            and (nr2, nc2) not in seen
   329	                        ):
   330	                            seen.add((nr2, nc2))
   331	                            q.append((nr2, nc2))
   332	                for dr2, dc2 in _DIR4:
   333	                    ar, ac = nb[0] + dr2, nb[1] + dc2
   334	                    if 0 <= ar < rows and 0 <= ac < cols and (ar, ac) not in test_visited and (ar, ac) in seen:
   335	                        valid.append(nb)
   336	                        break
   337	            if not valid:
   338	                break
   339	            random.shuffle(valid)
   340	            nxt = valid[0]
   341	            visited.add(nxt)
   342	            path.append(nxt)
   343	            cur = nxt
   344	        if best_path and best_len >= total * 0.85:
   345	            break
   346	    return best_path
