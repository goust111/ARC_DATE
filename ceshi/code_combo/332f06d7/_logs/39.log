def _is_border_square(square: dict, h: int, w: int) -> bool:
    r0, c0, n = int(square["r0"]), int(square["c0"]), int(square["n"])
    return r0 == 0 or c0 == 0 or r0 + n == h or c0 + n == w


def _decode_start_from_ctrl(ctrl_pt: tuple[int, int], n: int, h: int, w: int) -> tuple[int, int]:
    r, c = ctrl_pt
    if r == 0:
        return 1, c
    if r == h - 1:
        return h - n - 1, c
    if c == 0:
        return r, 1
    if c == w - 1:
        return r, w - n - 1
    raise AssertionError("Control pixel must lie on the border")


def _control_from_start_side(start_coarse: tuple[int, int], sr: int, sc: int, coarse_rows: int, coarse_cols: int, h: int, w: int) -> tuple[int, int]:
    cr, cc = start_coarse
    if cr == 0:
        return 0, sc
    if cr == coarse_rows - 1:
        return h - 1, sc
    if cc == 0:
        return sr, 0
    if cc == coarse_cols - 1:
        return sr, w - 1
    raise AssertionError("Start coarse cell must be on the border")


def main(grid: np.ndarray) -> np.ndarray:
    """
    Variant rule:
    - The red n x n square is still the destination.
    - The black mover is hidden in the input.
    - A single yellow border pixel marks the hidden mover's entry position.
    - Decode that hidden start, then run the original sliding-square BFS rule.
    """
    g = np.array(grid, dtype=int)
    h, w = g.shape

    bg = int(Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0])

    squares: list[dict] = []
    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict"):
        col = int(comp["color"])
        b = comp["bbox"]
        if bbox_h(b) != bbox_w(b):
            continue
        patch = g[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1]
        if not bool((patch == col).all()):
            continue
        squares.append({"col": col, "r0": int(b[0]), "c0": int(b[1]), "n": int(bbox_h(b))})

    assert squares

    dest = max(squares, key=lambda s: int(s["n"]))
    n = int(dest["n"])
    dr, dc = int(dest["r0"]), int(dest["c0"])

    ctrl_candidates = [
        s
        for s in squares
        if int(s["n"]) == 1 and _is_border_square(s, h, w) and int(s["col"]) != int(dest["col"])
    ]
    assert ctrl_candidates
    ctrl = int(ctrl_candidates[0]["col"])
    ctrl_pts = [(int(r), int(c)) for r, c in np.argwhere(g == ctrl)]
    assert len(ctrl_pts) == 1
    sr, sc = _decode_start_from_ctrl(ctrl_pts[0], n, h, w)

    counts = Counter(map(int, g.flatten()))
    river = None
    for col, _ct in counts.most_common():
        if col in (bg, int(dest["col"]), ctrl):
            continue
        river = int(col)
        break
    assert river is not None

    trav = (g == river) | (g == int(dest["col"]))

    h2 = h - n + 1
    w2 = w - n + 1
    assert h2 > 0 and w2 > 0
    assert 0 <= sr < h2 and 0 <= sc < w2

    feasible = np.zeros((h2, w2), dtype=bool)
    for r in range(h2):
        for c in range(w2):
            if bool(trav[r : r + n, c : c + n].all()):
                feasible[r, c] = True
    assert feasible[sr, sc]

    dist = _bfs_placement(feasible, sr, sc)

    if 0 <= dr < h2 and 0 <= dc < w2 and feasible[dr, dc] and dist[dr, dc] >= 0:
        tr, tc = dr, dc
    else:
        best = -1
        tr, tc = sr, sc
        for r in range(h2):
            for c in range(w2):
                if dist[r, c] > best:
                    best = int(dist[r, c])
                    tr, tc = r, c

    out = g.copy()
    out[tr : tr + n, tc : tc + n] = _MOVER
    return out


def _gen_attempt() -> np.ndarray | None:
    reached = random.random() < 0.5
