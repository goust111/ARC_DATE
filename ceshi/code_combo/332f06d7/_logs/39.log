   120	def _bfs_placement(feasible: np.ndarray, sr: int, sc: int) -> np.ndarray:
   121	    h2, w2 = feasible.shape
   122	    dist = -np.ones((h2, w2), dtype=int)
   123	    dist[sr, sc] = 0
   124	    q = deque([(sr, sc)])
   125	    while q:
   126	        r, c = q.popleft()
   127	        for dr, dc in _DIR4:
   128	            rr, cc = r + dr, c + dc
   129	            if 0 <= rr < h2 and 0 <= cc < w2 and feasible[rr, cc] and dist[rr, cc] == -1:
   130	                dist[rr, cc] = dist[r, c] + 1
   131	                q.append((rr, cc))
   132	    return dist
