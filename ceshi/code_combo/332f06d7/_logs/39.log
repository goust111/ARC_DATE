   150	def _pick_farthest(dist: np.ndarray, default: tuple[int, int]) -> tuple[int, int]:
   151	    best = -1
   152	    tr, tc = default
   153	    for r in range(dist.shape[0]):
   154	        for c in range(dist.shape[1]):
   155	            if int(dist[r, c]) > best:
   156	                best = int(dist[r, c])
   157	                tr, tc = int(r), int(c)
   158	    return tr, tc
