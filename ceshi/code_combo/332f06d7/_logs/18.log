   231	def _hamiltonian_walk(rows: int, cols: int, start: tuple[int, int], end: tuple[int, int]) -> list[tuple[int, int]] | None:
   232	    total = rows * cols
   233	    best_path = None
   234	    best_len = 0
   235	    for _attempt in range(120):
   236	        visited = {start}
   237	        path = [start]
   238	        cur = start
   239	        while True:
   240	            if cur == end and len(path) >= total * 0.7:
   241	                if len(path) > best_len:
   242	                    best_path = list(path)
   243	                    best_len = len(path)
   244	                break
   245	            neighbors = []
   246	            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
   247	                nr, nc = cur[0] + dr, cur[1] + dc
   248	                if 0 <= nr < rows and 0 <= nc < cols and (nr, nc) not in visited:
   249	                    neighbors.append((nr, nc))
   250	            if not neighbors:
   251	                break
   252	            valid = []
   253	            for nb in neighbors:
   254	                if nb == end:
   255	                    valid.append(nb)
   256	                    continue
   257	                test_visited = visited | {nb}
   258	                seen = {end}
   259	                q = deque([end])
   260	                while q:
   261	                    cr, cc = q.popleft()
   262	                    for dr2, dc2 in ((1, 0), (-1, 0), (0, 1), (0, -1)):
   263	                        nr2, nc2 = cr + dr2, cc + dc2
   264	                        if 0 <= nr2 < rows and 0 <= nc2 < cols and (nr2, nc2) not in test_visited and (nr2, nc2) not in seen:
   265	                            seen.add((nr2, nc2))
