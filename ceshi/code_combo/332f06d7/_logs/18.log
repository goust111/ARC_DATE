+    if not reached and dest_ok:
+        return None
+
+    output = grid.copy()
+    output[mover_r : mover_r + n, mover_c : mover_c + n] = _RIVER
+    output[tr : tr + n, tc : tc + n] = mover_col
+    if not np.array_equal(main(grid), output):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(500):
+        result = _gen_attempt()
+        if result is not None:
+            return result
