   125	    dest_cands = [s for s in squares if int(s["n"]) == int(sizes[-1])]
   126	    assert len(mover_cands) == 1 and len(dest_cands) == 1
   127	    mover = mover_cands[0]
   128	    dest = dest_cands[0]
