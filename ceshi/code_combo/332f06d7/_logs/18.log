   575	        return None
   576	
   577	    trav = (grid == _RIVER) | (grid == mover_col) | (grid == dest_col)
   578	    feasible = _feasible_placements(trav, n)
   579	    if not bool(feasible[mover_r, mover_c]):
   580	        return None
   581	    dist = _bfs_placement(feasible, mover_r, mover_c)
   582	    tr, tc, dest_ok = _landing_position(feasible, dist, mover_r, mover_c, dest, n)
   583	    if reached and not dest_ok:
   584	        return None
   585	    if not reached and dest_ok:
   586	        return None
   587	
   588	    output = grid.copy()
   589	    output[mover_r : mover_r + n, mover_c : mover_c + n] = _RIVER
   590	    output[tr : tr + n, tc : tc + n] = mover_col
   591	    if not np.array_equal(main(grid), output):
   592	        return None
   593	    return grid
   594	
   595	
   596	def generate_input() -> np.ndarray:
   597	    for _ in range(500):
   598	        result = _gen_attempt()
   599	        if result is not None:
