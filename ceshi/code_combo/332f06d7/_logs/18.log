   106	def _square_components(g: np.ndarray, bg: int) -> list[dict]:
   107	    squares: list[dict] = []
   108	    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict"):
   109	        col = int(comp["color"])
   110	        b = comp["bbox"]
   111	        if bbox_h(b) != bbox_w(b):
   112	            continue
   113	        patch = g[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1]
   114	        if not bool((patch == col).all()):
   115	            continue
   116	        squares.append({"col": col, "r0": int(b[0]), "c0": int(b[1]), "n": int(bbox_h(b))})
   117	    return squares
