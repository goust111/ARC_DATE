from arc_utils import bbox_h, bbox_w, find_components


def _edge_distance(H: int, W: int, r0: int, c0: int, n: int) -> int:
    return int(min(r0, c0, H - (r0 + n), W - (c0 + n)))


def _touches_edge(H: int, W: int, r0: int, c0: int, n: int) -> bool:
    return bool(r0 == 0 or c0 == 0 or r0 + n == H or c0 + n == W)


def _pick_mover_dest(cand: list[dict], H: int, W: int) -> tuple[dict, dict]:
    enriched = []
    for s in cand:
        n = int(s["n"])
        r0 = int(s["r0"])
        c0 = int(s["c0"])
        enriched.append(
            {
                **s,
                "touch": _touches_edge(H, W, r0, c0, n),
                "edge_dist": _edge_distance(H, W, r0, c0, n),
            }
        )

    dest_pref = sorted(enriched, key=lambda s: (0 if s["touch"] else 1, s["edge_dist"], s["r0"], s["c0"]))
    dest = dest_pref[0]

    mover_pref = sorted(
        [s for s in enriched if s is not dest],
        key=lambda s: (0 if not s["touch"] else 1, s["edge_dist"], s["r0"], s["c0"]),
    )
    assert mover_pref
    mover = mover_pref[0]
    return mover, dest


