   670	
   671	    meta = {
   672	        "reached": bool(reached),
   673	        "n": int(n),
   674	        "direction": str(plan["direction"]),
   675	        "side": int(plan["side"]),
   676	        "start_width": int(plan["start_w"]),
   677	        "spine_width": int(plan["spine_w"]),
   678	        "taper_len": int(plan["taper_len"]),
   679	        "frontier_dist": int(choice["frontier_d"]),
   680	        "midpoint_dist": int(choice["dist"][tr, tc]),
   681	        "frontier": (int(choice["frontier_r"]), int(choice["frontier_c"])),
   682	        "stop": (int(tr), int(tc)),
   683	    }
   684	    if return_meta:
   685	        return grid, meta
   686	    return grid
   687	
   688	
   689	def generate_input():
