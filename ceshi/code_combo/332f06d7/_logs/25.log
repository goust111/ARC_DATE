+
+    if not dest_ok:
+        frontier_d = int(choice["frontier_d"])
+        if frontier_d < 4:
+            return (None, None) if return_meta else None
+        if (int(choice["tr"]), int(choice["tc"])) == (int(choice["frontier_r"]), int(choice["frontier_c"])):
+            return (None, None) if return_meta else None
