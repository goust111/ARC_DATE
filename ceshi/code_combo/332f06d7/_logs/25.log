    frontier_ds.append(meta['frontier_dist'])
    mid_ds.append(meta['midpoint_dist'])
    mid_gaps.append(meta['frontier_dist'] - meta['midpoint_dist'])
    out_combo = combo.main(grid)
    out_base = base.main(grid)
    out_d2 = d2.main(grid)
    if not np.array_equal(out_combo, out_base):
        base_diff += 1
    if not np.array_equal(out_combo, out_d2):
        d2_diff += 1

print({
    'samples': samples,
    'reachable': reachable,
    'blocked': blocked,
    'width_delta_counts': {d: width_deltas.count(d) for d in sorted(set(width_deltas))},
    'frontier_dist_range': (min(frontier_ds), max(frontier_ds)) if frontier_ds else None,
    'midpoint_dist_range': (min(mid_ds), max(mid_ds)) if mid_ds else None,
    'mid_gap_range': (min(mid_gaps), max(mid_gaps)) if mid_gaps else None,
    'mid_gap_mean': round(sum(mid_gaps) / len(mid_gaps), 2) if mid_gaps else None,
    'combo_diff_vs_base': f'{base_diff}/{blocked}',
    'combo_diff_vs_d2': f'{d2_diff}/{blocked}',
})
