   573	        elif mover_c == 0:
   574	            grid[mover_r : mover_r + n, 0] = _RIVER
   575	            mover_c = 1
   576	        else:
   577	            grid[mover_r : mover_r + n, W - 1] = _RIVER
   578	            mover_c = W - n - 1
   579	    if mover_r == 0 or mover_r + n == H or mover_c == 0 or mover_c + n == W:
   580	        return None
   581	    if min(mover_r, H - (mover_r + n), mover_c, W - (mover_c + n)) > 2:
   582	        return None
   583	    return int(mover_r), int(mover_c)
   584	
   585	
   586	def _count_same_frontier_key(dist: np.ndarray, dr: int, dc: int, frontier_key: tuple[int, int, int, int]) -> int:
   587	    count = 0
   588	    for r in range(dist.shape[0]):
   589	        for c in range(dist.shape[1]):
   590	            d = int(dist[r, c])
