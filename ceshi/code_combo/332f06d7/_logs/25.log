# Variant of 332f06d7
# Dimension: D13 — 卡点判定：最远可达 vs 其他策略 (meta)
# Change: 不可达时停在BFS距离最远的可行位置(即最远可达点)... → 停在通道中间
#
# Design analysis
# ---------------
# spec:
#   core_visuals:
#     - 输入仍是绿色背景、蓝色蜿蜒水道、黑色 n×n mover、红色 n×n destination。
#     - 黑红方块仍与原题一样是同尺寸纯色实心方块，蓝色水道仍是单连通通道。
#     - reachable 样例完全保持原行为：黑块滑到红块处并覆盖红块。
#     - stuck 样例的可观察变化：黑块不再停在卡点前最后一个可达位置，而是停在
#       “起点到卡点前沿之间”的路径中点，因此输出中的黑块会明显离卡点更远。
#   behavior_trace:
#     - 原逻辑：在 placement-grid 上 BFS，若红块不可达，选 dist 最大的可行位置。
#     - 新逻辑：仍然先 BFS；若红块不可达，先找唯一“最远可达前沿格” F
#       （在本生成器里它就是卡点上游最后一个可达 placement），再沿 BFS 父链回退到
#       dist(F)//2 的祖先位置 M，把 mover 停在 M。
#     - 小例子：若起点到卡点前沿共有 8 步，原题停在第 8 步，新题停在第 4 步。
#   complexity_calibration:
#     - 不增加新颜色，不引入额外标记，避免把 D13 变化和其他维度混在一起。
#     - 为了避免“多个卡点该取哪个中点”的歧义，stuck 样例只生成一个有效卡点。
#     - 为了让差异肉眼可见，stuck 样例要求卡点前 BFS 距离至少 4，确保中点位置
#       与最远可达点不同且通常相隔数格。
#   implicit_assumptions_review:
#     - 原 solver 的不可达分支默认“最后停靠点 = dist 最大点”；这是本变体唯一需要
#       替换的旧假设。
#     - 新 solver 需要额外假设：start 连通分量中的“卡点前沿格”可以由唯一最远可达点
#       代表；generator 通过单卡点、简单通道和唯一最大 dist 约束保证这一点。
#     - 仍保留原题对对象检测的假设：四角多数色是背景；黑红是同尺寸实心方块；
#       剩余主色是河道色；这些在变体中不变。
#   placement_legality:
#     - 生成器仍先渲染完整水道，再在 stuck 情况下只收窄一个连接段。
#     - 卡点放在 walk 的后半段，保证上游路径足够长；同时继续验证 river 像素整体连通，
#       所以视觉上仍是一条不断开的河，但 n×n 方块无法通过。
#     - 输出仍把起始黑块位置填回蓝色，只移动一个黑块，不产生重叠或越界。
#   observability:
#     - 人类从样例中可见：可达时黑块到红块；不可达时黑块并不贴着卡点，而是停在
#       中途位置。新旧区别体现在 stuck 输出里，且不依赖颜色编号等不可见排序。

from __future__ import annotations

from collections import Counter, defaultdict, deque
import random

import numpy as np
from scipy.ndimage import label as scipy_label

from arc_utils import bbox_h, bbox_w, find_components


_BG, _RIVER, _MOVER, _DEST = 3, 1, 0, 2
_DIR4 = [(1, 0), (-1, 0), (0, 1), (0, -1)]


def _detect_scene(grid: np.ndarray):
    g = np.array(grid, dtype=int)
    H, W = g.shape

    bg = int(
        Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0]
    )

    squares: list[dict] = []
    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict"):
        col = int(comp["color"])
        b = comp["bbox"]
        if bbox_h(b) != bbox_w(b):
            continue
        patch = g[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1]
        if not bool((patch == col).all()):
            continue
        squares.append({"col": col, "r0": int(b[0]), "c0": int(b[1]), "n": int(bbox_h(b))})

    assert len(squares) >= 2

    by_n: dict[int, list[dict]] = defaultdict(list)
    for sq in squares:
        by_n[int(sq["n"])].append(sq)
    nside = max(by_n.items(), key=lambda kv: (len(kv[1]), kv[0]))[0]
    cand = by_n[int(nside)]
    assert len(cand) >= 2

    cand.sort(key=lambda s: int(s["col"]))
    mover = cand[0]
    dest = cand[1]

    counts = Counter(map(int, g.flatten()))
    river = None
    for col, _ct in counts.most_common():
        if col == bg:
            continue
        if col in (int(mover["col"]), int(dest["col"])):
            continue
        river = int(col)
        break
    assert river is not None

    n = int(mover["n"])
    sr, sc = int(mover["r0"]), int(mover["c0"])
    dr, dc = int(dest["r0"]), int(dest["c0"])
    trav = (g == river) | (g == int(mover["col"])) | (g == int(dest["col"]))
    return g, H, W, bg, river, mover, dest, n, sr, sc, dr, dc, trav


def _feasible_mask(trav: np.ndarray, n: int) -> np.ndarray:
    H, W = trav.shape
    h2 = H - n + 1
    w2 = W - n + 1
    assert h2 > 0 and w2 > 0
    feasible = np.zeros((h2, w2), dtype=bool)
    for r in range(h2):
        for c in range(w2):
            if bool(trav[r : r + n, c : c + n].all()):
                feasible[r, c] = True
    return feasible


def _bfs_placement(feasible: np.ndarray, sr: int, sc: int):
    h2, w2 = feasible.shape
    dist = -np.ones((h2, w2), dtype=int)
    parent_r = -np.ones((h2, w2), dtype=int)
    parent_c = -np.ones((h2, w2), dtype=int)
    q = deque([(int(sr), int(sc))])
    dist[int(sr), int(sc)] = 0
    while q:
        r, c = q.popleft()
        for dr, dc in _DIR4:
            rr, cc = int(r + dr), int(c + dc)
            if 0 <= rr < h2 and 0 <= cc < w2 and bool(feasible[rr, cc]) and int(dist[rr, cc]) == -1:
                dist[rr, cc] = int(dist[r, c] + 1)
                parent_r[rr, cc] = int(r)
                parent_c[rr, cc] = int(c)
                q.append((rr, cc))
    return dist, parent_r, parent_c


def _farthest_reachable(dist: np.ndarray):
    best = -1
    tr = tc = 0
    for r in range(dist.shape[0]):
        for c in range(dist.shape[1]):
            if int(dist[r, c]) > best:
                best = int(dist[r, c])
                tr, tc = int(r), int(c)
    return tr, tc, best


def _midpoint_stop(dist: np.ndarray, parent_r: np.ndarray, parent_c: np.ndarray, sr: int, sc: int):
    fr, fc, best = _farthest_reachable(dist)
    assert best >= 0
    target_dist = best // 2
    tr, tc = int(fr), int(fc)
    while int(dist[tr, tc]) > target_dist:
        nr, nc = int(parent_r[tr, tc]), int(parent_c[tr, tc])
        assert nr >= 0 and nc >= 0
        tr, tc = nr, nc
    assert int(dist[tr, tc]) == target_dist
    return tr, tc, fr, fc, best


def _select_target(feasible: np.ndarray, sr: int, sc: int, dr: int, dc: int):
    assert bool(feasible[int(sr), int(sc)])
    dist, parent_r, parent_c = _bfs_placement(feasible, sr, sc)
    dest_ok = (
        0 <= dr < feasible.shape[0]
        and 0 <= dc < feasible.shape[1]
        and bool(feasible[int(dr), int(dc)])
        and int(dist[int(dr), int(dc)]) >= 0
    )
    if dest_ok:
        return {
            "dist": dist,
            "dest_ok": True,
            "tr": int(dr),
            "tc": int(dc),
            "frontier_r": int(dr),
            "frontier_c": int(dc),
            "frontier_d": int(dist[int(dr), int(dc)]),
        }
    tr, tc, fr, fc, best = _midpoint_stop(dist, parent_r, parent_c, sr, sc)
    return {
        "dist": dist,
        "dest_ok": False,
        "tr": int(tr),
        "tc": int(tc),
        "frontier_r": int(fr),
        "frontier_c": int(fc),
        "frontier_d": int(best),
    }


def main(grid: np.ndarray) -> np.ndarray:
    """
    Slide a solid square through a winding channel to reach a same-sized target square.

    Variant D13:
    - Reachable: unchanged, mover covers the destination.
    - Unreachable: instead of stopping at the farthest reachable placement, the mover stops
      halfway along the BFS path from its start to the chokepoint's upstream frontier.
    """
    g, H, W, _bg, river, mover, _dest, n, sr, sc, dr, dc, trav = _detect_scene(grid)
    feasible = _feasible_mask(trav, n)
    assert 0 <= sr < feasible.shape[0] and 0 <= sc < feasible.shape[1]
    assert bool(feasible[int(sr), int(sc)])

    choice = _select_target(feasible, sr, sc, dr, dc)
    tr, tc = int(choice["tr"]), int(choice["tc"])

    out = g.copy()
    out[int(sr) : int(sr + n), int(sc) : int(sc + n)] = int(river)
    out[int(tr) : int(tr + n), int(tc) : int(tc + n)] = int(mover["col"])
    return out


def _hamiltonian_walk(rows: int, cols: int, start: tuple[int, int], end: tuple[int, int]):
    total = rows * cols
    best_path = None
    best_len = 0
    for _attempt in range(80):
        visited = {start}
        path = [start]
        cur = start
        while True:
            if cur == end and len(path) >= total * 0.7:
                if len(path) > best_len:
                    best_path = list(path)
                    best_len = len(path)
                break
            neighbors = []
            for dr, dc in _DIR4:
                nr, nc = cur[0] + dr, cur[1] + dc
                if 0 <= nr < rows and 0 <= nc < cols and (nr, nc) not in visited:
                    neighbors.append((nr, nc))
            if not neighbors:
                break
            valid = []
            for nb in neighbors:
                if nb == end:
                    valid.append(nb)
                    continue
                test_visited = visited | {nb}
                seen = {end}
                q = deque([end])
                while q:
                    cr, cc = q.popleft()
                    for dr2, dc2 in _DIR4:
                        nr2, nc2 = cr + dr2, cc + dc2
                        if (
                            0 <= nr2 < rows
                            and 0 <= nc2 < cols
                            and (nr2, nc2) not in test_visited
                            and (nr2, nc2) not in seen
                        ):
                            seen.add((nr2, nc2))
                            q.append((nr2, nc2))
                for dr2, dc2 in _DIR4:
                    ar, ac = nb[0] + dr2, nb[1] + dc2
                    if (
                        0 <= ar < rows
                        and 0 <= ac < cols
                        and (ar, ac) not in test_visited
                        and (ar, ac) in seen
                    ):
                        valid.append(nb)
                        break
            if not valid:
                break
            random.shuffle(valid)
            nxt = valid[0]
            visited.add(nxt)
            path.append(nxt)
            cur = nxt
        if best_path and best_len >= total * 0.85:
            break
    return best_path


def _render_channel(grid: np.ndarray, path: list[tuple[int, int]], n: int, offsets_r, offsets_c):
    pixel_pos = []
    for cr, cc in path:
        pr, pc = offsets_r[cr], offsets_c[cc]
        pixel_pos.append((pr, pc))
        grid[pr : pr + n, pc : pc + n] = _RIVER
    for i in range(len(path) - 1):
        pr1, pc1 = pixel_pos[i]
        pr2, pc2 = pixel_pos[i + 1]
        if pr1 == pr2:
            c_lo, c_hi = min(pc1, pc2), max(pc1, pc2) + n
            grid[pr1 : pr1 + n, c_lo:c_hi] = _RIVER
        else:
            r_lo, r_hi = min(pr1, pr2), max(pr1, pr2) + n
            grid[r_lo:r_hi, pc1 : pc1 + n] = _RIVER
    return pixel_pos


def _add_chokepoint(grid: np.ndarray, pixel_pos_i, pixel_pos_j, n: int, direction: str):
