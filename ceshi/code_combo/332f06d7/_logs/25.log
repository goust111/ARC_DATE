   592	                continue
   593	            key = (abs(r - dr) + abs(c - dc), -d, r, c)
   594	            if key == frontier_key:
   595	                count += 1
   596	    return count
   597	
   598	
   599	def _gen_attempt(return_meta: bool = False):
   600	    reached = random.random() < 0.45
   601	    n = random.choice([1, 2, 3, 4]) if reached else random.choice([2, 3, 4])
   602	
   603	    min_size = max(10, 5 * n)
   604	    if min_size > 20:
   605	        return (None, None) if return_meta else None
   606	    G = random.randint(min_size, 20)
   607	    H = W = G
   608	
   609	    built = _build_walk(G, n)
   610	    if built is None:
   611	        return (None, None) if return_meta else None
   612	    walk, offsets_r, offsets_c = built
   613	
   614	    grid = np.full((H, W), _BG, dtype=int)
   615	    pixel_pos = _render_channel(grid, walk, n, offsets_r, offsets_c)
   616	    mask = grid != _BG
   617	    if np.any(mask, axis=1).sum() / H < 0.55 or np.any(mask, axis=0).sum() / W < 0.55:
   618	        return (None, None) if return_meta else None
   619	
   620	    mover_r, mover_c = pixel_pos[0]
   621	    tail_r, tail_c = pixel_pos[-1]
   622	    plan = _pick_tail_plan(grid, tail_r, tail_c, n, reached)
   623	    if plan is None:
   624	        return (None, None) if return_meta else None
   625	    dest_r, dest_c = _paint_tapered_tail(grid, tail_r, tail_c, n, plan)
   626	
   627	    adjusted = _adjust_mover_inward(grid, mover_r, mover_c, n)
   628	    if adjusted is None:
   629	        return (None, None) if return_meta else None
   630	    mover_r, mover_c = adjusted
   631	
   632	    grid[mover_r : mover_r + n, mover_c : mover_c + n] = _MOVER
   633	    grid[dest_r : dest_r + n, dest_c : dest_c + n] = _DEST
   634	    if not _river_connected(grid):
   635	        return (None, None) if return_meta else None
   636	
   637	    g, river, mover_col, n2, sr, sc, dr, dc, feasible = _analyze_grid(grid)
   638	    if n2 != n or river != _RIVER or mover_col != _MOVER:
   639	        return (None, None) if return_meta else None
   640	    choice = _select_target(feasible, sr, sc, dr, dc)
   641	    dest_ok = bool(choice["dest_ok"])
   642	    if dest_ok != reached:
   643	        return (None, None) if return_meta else None
   644	
   645	    if not dest_ok:
   646	        frontier_d = int(choice["frontier_d"])
   647	        if frontier_d < 4:
   648	            return (None, None) if return_meta else None
   649	        if (int(choice["tr"]), int(choice["tc"])) == (int(choice["frontier_r"]), int(choice["frontier_c"])):
   650	            return (None, None) if return_meta else None
   651	        if _count_same_frontier_key(choice["dist"], dr, dc, tuple(choice["frontier_key"])) != 1:
   652	            return (None, None) if return_meta else None
   653	
   654	        old_best = -1
   655	        old_tr, old_tc = sr, sc
   656	        for r in range(choice["dist"].shape[0]):
