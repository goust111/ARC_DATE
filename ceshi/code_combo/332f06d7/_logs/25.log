   661	        if (old_tr, old_tc) == (int(choice["tr"]), int(choice["tc"])):
   662	            return (None, None) if return_meta else None
   663	
   664	    output = g.copy()
   665	    output[sr : sr + n, sc : sc + n] = _RIVER
   666	    tr, tc = int(choice["tr"]), int(choice["tc"])
