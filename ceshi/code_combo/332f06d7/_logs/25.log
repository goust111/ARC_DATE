+        "frontier": (int(choice["frontier_r"]), int(choice["frontier_c"])),
+        "stop": (int(tr), int(tc)),
+    }
+    if return_meta:
+        return grid, meta
+    return grid
+
+
+def generate_input():
+    for _ in range(500):
+        result = _gen_attempt()
+        if result is not None:
