261:def main(grid: np.ndarray) -> np.ndarray:
262:    """
263:    Variant rule:
264:    - Top 2 rows form a legend strip. Each obstacle color appears twice there.
265:      Bottom-left shift means CCW; bottom-right shift means CW.
266:    - In the playfield, the black n x n square moves along the blue river.
267:    - At a dead-end marked by a colored wall strip, it turns according to the legend.
268:    - If it reaches the red square, it covers it; otherwise it stops at the last reachable
269:      placement before an unturnable blockage or a narrowed gate.
270:    """
271:    g = np.array(grid, dtype=int)
272:    assert not (g.shape[0] <= LEGEND_H)
273:
274:    turn_by_color = _parse_legend(g)
275:    core = g[LEGEND_H:, :].copy()
276:    bg, mover, dest = _infer_roles(core)
277:    tr, tc = _simulate(core, turn_by_color=turn_by_color, mover=mover, dest=dest)
278:
279:    river = _infer_river(core, bg=bg, mover_col=int(mover["col"]), dest_col=int(dest["col"]))
280:    sr, sc, n = int(mover["r0"]), int(mover["c0"]), int(mover["n"])
281:
282:    out_core = core.copy()
283:    out_core[int(sr) : int(sr + n), int(sc) : int(sc + n)] = int(river)
284:    out_core[int(tr) : int(tr + n), int(tc) : int(tc + n)] = int(mover["col"])
285:
286:    out = g.copy()
287:    out[LEGEND_H:, :] = out_core
288:    return out
