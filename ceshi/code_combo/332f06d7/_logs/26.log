161:def _feasible_mask(core: np.ndarray, river: int, mover_col: int, dest_col: int, n: int) -> np.ndarray:
162:    trav = (core == int(river)) | (core == int(mover_col)) | (core == int(dest_col))
163:    h2 = int(core.shape[0] - n + 1)
164:    w2 = int(core.shape[1] - n + 1)
