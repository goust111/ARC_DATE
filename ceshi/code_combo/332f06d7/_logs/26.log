290:
291:def _compute_offsets(size: int, n: int, num_coarse: int) -> list[int] | None:
292:    if num_coarse <= 1:
293:        return [1]
294:    first = 1
295:    last = size - n - 1
296:    if last < first:
297:        return None
298:    step = (last - first) / (num_coarse - 1)
299:    offsets = [int(round(first + i * step)) for i in range(num_coarse)]
300:    if any(offsets[i + 1] - offsets[i] < n + 1 for i in range(len(offsets) - 1)):
301:        return None
302:    return offsets
303:
304:
305:def _paint_edge(grid: np.ndarray, p1: tuple[int, int], p2: tuple[int, int], n: int) -> None:
306:    pr1, pc1 = p1
307:    pr2, pc2 = p2
308:    if pr1 == pr2:
309:        c0, c1 = min(pc1, pc2), max(pc1, pc2) + n
310:        grid[int(pr1) : int(pr1 + n), int(c0) : int(c1)] = _RIVER
311:    else:
312:        r0, r1 = min(pr1, pr2), max(pr1, pr2) + n
313:        grid[int(r0) : int(r1), int(pc1) : int(pc1 + n)] = _RIVER
314:
315:
316:def _render_network(
317:    grid: np.ndarray,
318:    nodes: set[tuple[int, int]],
319:    edges: set[tuple[tuple[int, int], tuple[int, int]]],
320:    offsets_r: list[int],
321:    offsets_c: list[int],
322:    n: int,
323:) -> dict[tuple[int, int], tuple[int, int]]:
324:    pixel = {(r, c): (int(offsets_r[r]), int(offsets_c[c])) for (r, c) in nodes}
325:    for pr, pc in pixel.values():
326:        grid[int(pr) : int(pr + n), int(pc) : int(pc + n)] = _RIVER
327:    for a, b in edges:
328:        _paint_edge(grid, pixel[a], pixel[b], n=n)
329:    return pixel
