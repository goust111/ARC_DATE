103:
104:def _detect_square_objects(g: np.ndarray, bg: int, river: int) -> tuple[dict, dict]:
105:    mask = (g != int(bg)) & (g != int(river))
106:    labeled, num = scipy_label(mask.astype(int), structure=STRUCT4)
107:
108:    squares: list[dict] = []
109:    for k in range(1, int(num) + 1):
110:        coords = np.argwhere(labeled == int(k))
111:        if coords.size == 0:
112:            continue
113:        r0, c0, r1, c1 = bbox_coords(coords)
114:        if int(r1 - r0) != int(c1 - c0):
115:            continue
116:        patch = g[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1]
117:        comp_mask = labeled[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1] == int(k)
118:        if not bool(comp_mask.all()):
119:            continue
120:        colors = {int(x) for x in np.unique(patch)}
121:        squares.append(
122:            {
123:                "r0": int(r0),
124:                "c0": int(c0),
125:                "n": int(r1 - r0 + 1),
126:                "patch": patch.copy(),
127:                "colors": colors,
128:            }
129:        )
130:
131:    assert len(squares) >= 2
132:    by_n: dict[int, list[dict]] = defaultdict(list)
133:    for sq in squares:
134:        by_n[int(sq["n"])].append(sq)
135:    nside = max(by_n.items(), key=lambda kv: (len(kv[1]), kv[0]))[0]
136:    cand = by_n[int(nside)]
137:    assert len(cand) >= 2
138:
139:    movers = [sq for sq in cand if int(_SYMBOL) in sq["colors"]]
140:    dests = [sq for sq in cand if sq["colors"] == {int(_DEST)}]
141:    assert len(movers) == 1
142:    assert len(dests) == 1
143:    return movers[0], dests[0]
144:
145:
146:def main(grid: np.ndarray) -> np.ndarray:
147:    g = np.array(grid, dtype=int)
148:    H, W = g.shape
149:
150:    bg = int(Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0])
151:    counts = Counter(map(int, g.flatten()))
152:    river = int(max((col for col in counts if int(col) != int(bg)), key=lambda col: int(counts[int(col)])))
153:
154:    mover, dest = _detect_square_objects(g, bg, river)
155:    n = int(mover["n"])
156:    sr, sc = int(mover["r0"]), int(mover["c0"])
157:    dr, dc = int(dest["r0"]), int(dest["c0"])
158:    mover_patch = np.array(mover["patch"], dtype=int)
159:    max_steps = int(np.count_nonzero(mover_patch == int(_SYMBOL)))
160:    assert max_steps >= 1
161:
162:    trav = g == int(river)
163:    trav[int(sr) : int(sr + n), int(sc) : int(sc + n)] = True
164:    trav[int(dr) : int(dr + n), int(dc) : int(dc + n)] = True
165:
166:    h2 = int(H - n + 1)
167:    w2 = int(W - n + 1)
168:    assert h2 > 0 and w2 > 0
169:    assert 0 <= sr < h2 and 0 <= sc < w2
170:
171:    feasible = np.zeros((h2, w2), dtype=bool)
172:    for r in range(h2):
173:        for c in range(w2):
174:            feasible[r, c] = bool(trav[r : r + n, c : c + n].all())
175:    assert bool(feasible[sr, sc])
176:
177:    dist = _bfs_placement(feasible, sr, sc)
178:    tr, tc = _pick_target(dist, dr, dc, max_steps)
179:
180:    out = g.copy()
181:    out[int(sr) : int(sr + n), int(sc) : int(sc + n)] = int(river)
182:    out[int(tr) : int(tr + n), int(tc) : int(tc + n)] = mover_patch
183:    return out
