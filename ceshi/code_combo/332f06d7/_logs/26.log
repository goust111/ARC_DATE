184:def _obstacle_color_ahead(
185:    core: np.ndarray,
186:    r: int,
187:    c: int,
188:    d: int,
189:    n: int,
190:    ignore: set[int],
191:) -> int | None:
192:    h, w = core.shape
193:    if d == 0:
194:        if r - 1 < 0:
