134:def _infer_roles(core: np.ndarray) -> tuple[int, dict, dict]:
135:    bg = int(Counter([int(core[0, 0]), int(core[0, -1]), int(core[-1, 0]), int(core[-1, -1])]).most_common(1)[0][0])
136:    squares = _detect_squares(core, bg=bg)
137:    assert not (len(squares) < 2)
138:
139:    by_n: dict[int, list[dict]] = defaultdict(list)
140:    for sq in squares:
141:        by_n[int(sq["n"])].append(sq)
142:    nside = max(by_n.items(), key=lambda kv: (len(kv[1]), kv[0]))[0]
143:    cand = by_n[int(nside)]
144:    assert not (len(cand) < 2)
145:
146:    cand.sort(key=lambda s: int(s["col"]))
147:    mover = cand[0]
148:    dest = cand[1]
149:    return bg, mover, dest
