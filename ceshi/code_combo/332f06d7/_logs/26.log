            ```python
            # Variant of 332f06d7
# Dimension: D18 — 符号编码：控制像素或图例 (symbol_instructions)
# Change: 无符号编码，所有信息通过颜色和空间位置隐式传达 → 移动体内部图案编码距离
#
# Design analysis
# ---------------
# yaml:
#   variant_goal:
#     keep: 方形移动体、同尺寸红色目标、水道可达性/卡点、移动后原位置回填为河道
#     change: 不再总是移动到目标或最远可达点；移动体内部黄色符号像素数=最大可移动步数
#   concrete_representation:
#     background: 3
#     river: 1
#     destination: 2 的实心 n×n 正方形
#     mover:
#       body: 0 的 n×n 正方形
#       symbol: 8，仅出现在 mover 内部；计数值就是 movement cap
#       layout: 固定保留左上角一个黑格，其余按行序填入黄色，保证“在数黄色格子”可见
#   behavior_trace:
#     original:
#       - 求出 mover 起点到各可放置位置的 BFS 距离
#       - 若目标可达则直接到目标，否则到最远可达位置
#     variant:
#       - 先同样求 BFS 距离
#       - 再数 mover 中黄色格子数 k
#       - 若目标可达且 dist(target) <= k，则覆盖目标
#       - 否则停在 dist <= k 的最远可达位置；若卡点更早，则仍停在卡点前
#     small_example:
#       - n=3，黄色数 k=4，目标距离 7，且无卡点
#       - 原题输出会到目标；变体输出只前进 4 步
#       - 若同一输入里卡点前最远只到 3 步，则变体也只能到 3 步
#   complexity_calibration:
#     - 保留原水道/卡点结构，避免把题目简化成“数格子直线平移”
#     - 限制 n in {3,4}，因为 n<=2 时符号数量自由度太小，肉眼很难稳健读出计数规则
#     - 生成器以“reachable-but-capped”样例为主，让 D18 差异在少量样例中肉眼可见
#   main_assumption_audit:
#     - 原 solver 假设 mover/dest 都是单色实心方块；变体下 mover 变成双色，原有 monochromatic square 检测会失效
#     - 原 solver 用颜色排序决定 mover/dest；变体改为按“是否含 symbol 色”区分，避免依赖不可见的数值顺序
#     - 原 solver 输出时整块写成 mover 单色；变体必须搬运整块双色 patch，否则会丢失符号编码
#     - 原 solver 的 traversable 集合只含 river/mover/dest 三色；变体要把 mover patch 整个 bbox 视作可通行
#   placement_legality:
#     - mover/dest 仍占完整 n×n bbox，且与河道不重叠到越界
#     - symbol 只放在 mover 内部，不额外引入独立组件
#     - 生成器先在“河道版本”上验证可达性，再覆盖 mover/dest patch，保证 solver 检测稳定
#   observability:
#     - 解题者能直接看到：不同样例中 mover 里的黄色格数不同，输出位移也同步变化
#     - 红色目标仍保留，说明“若步数够则能到目标，否则会提前停下”
#     - 少量 choke 样例保留旧约束，提示“步数上限”和“水道宽度”共同限制移动
#   cleanliness:
#     - symbol 只叠在 mover 内，不在河道额外撒点，画面仍是 5 色且对象边界清晰
#   new_solver_assumptions_to_guarantee:
#     - river 是除背景外面积最大的颜色
#     - 非 river/非 bg 的完整方形组件中，恰有一个含 symbol 色（mover），恰有一个单色（dest）
#     - symbol 数至少 1，至多 n^2-1，因此 mover 始终保留可见黑色主体

from __future__ import annotations

from collections import Counter, defaultdict, deque
import random

import numpy as np
from scipy.ndimage import label as scipy_label

from arc_utils import STRUCT4, bbox_coords


_BG, _RIVER, _MOVER, _DEST, _SYMBOL = 3, 1, 0, 2, 8
_DIR4 = [(1, 0), (-1, 0), (0, 1), (0, -1)]


def _bfs_placement(feasible: np.ndarray, sr: int, sc: int) -> np.ndarray:
    h2, w2 = feasible.shape
    dist = -np.ones((h2, w2), dtype=int)
    dist[sr, sc] = 0
    q = deque([(sr, sc)])
    while q:
        r, c = q.popleft()
        for dr, dc in _DIR4:
            rr, cc = r + dr, c + dc
            if 0 <= rr < h2 and 0 <= cc < w2 and feasible[rr, cc] and dist[rr, cc] == -1:
                dist[rr, cc] = dist[r, c] + 1
                q.append((rr, cc))
    return dist


def _pick_target(dist: np.ndarray, dr: int, dc: int, max_steps: int) -> tuple[int, int]:
    if 0 <= dr < dist.shape[0] and 0 <= dc < dist.shape[1]:
        d = int(dist[dr, dc])
        if 0 <= d <= max_steps:
            return int(dr), int(dc)

    best = -1
    tr, tc = 0, 0
    for r in range(dist.shape[0]):
        for c in range(dist.shape[1]):
            d = int(dist[r, c])
            if 0 <= d <= max_steps and d > best:
                best = d
                tr, tc = int(r), int(c)
    assert best >= 0
    return tr, tc


def _detect_square_objects(g: np.ndarray, bg: int, river: int) -> tuple[dict, dict]:
    mask = (g != int(bg)) & (g != int(river))
    labeled, num = scipy_label(mask.astype(int), structure=STRUCT4)

    squares: list[dict] = []
    for k in range(1, int(num) + 1):
        coords = np.argwhere(labeled == int(k))
        if coords.size == 0:
            continue
        r0, c0, r1, c1 = bbox_coords(coords)
        if int(r1 - r0) != int(c1 - c0):
            continue
        patch = g[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1]
        comp_mask = labeled[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1] == int(k)
        if not bool(comp_mask.all()):
            continue
        colors = {int(x) for x in np.unique(patch)}
        squares.append(
            {
                "r0": int(r0),
                "c0": int(c0),
                "n": int(r1 - r0 + 1),
                "patch": patch.copy(),
                "colors": colors,
            }
        )

    assert len(squares) >= 2
    by_n: dict[int, list[dict]] = defaultdict(list)
    for sq in squares:
        by_n[int(sq["n"])].append(sq)
    nside = max(by_n.items(), key=lambda kv: (len(kv[1]), kv[0]))[0]
    cand = by_n[int(nside)]
    assert len(cand) >= 2

    movers = [sq for sq in cand if int(_SYMBOL) in sq["colors"]]
    dests = [sq for sq in cand if sq["colors"] == {int(_DEST)}]
    assert len(movers) == 1
    assert len(dests) == 1
    return movers[0], dests[0]


def main(grid: np.ndarray) -> np.ndarray:
    g = np.array(grid, dtype=int)
    H, W = g.shape

    bg = int(Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0])
    counts = Counter(map(int, g.flatten()))
    river = int(max((col for col in counts if int(col) != int(bg)), key=lambda col: int(counts[int(col)])))

    mover, dest = _detect_square_objects(g, bg, river)
    n = int(mover["n"])
    sr, sc = int(mover["r0"]), int(mover["c0"])
    dr, dc = int(dest["r0"]), int(dest["c0"])
    mover_patch = np.array(mover["patch"], dtype=int)
    max_steps = int(np.count_nonzero(mover_patch == int(_SYMBOL)))
    assert max_steps >= 1

    trav = g == int(river)
    trav[int(sr) : int(sr + n), int(sc) : int(sc + n)] = True
    trav[int(dr) : int(dr + n), int(dc) : int(dc + n)] = True

    h2 = int(H - n + 1)
    w2 = int(W - n + 1)
    assert h2 > 0 and w2 > 0
    assert 0 <= sr < h2 and 0 <= sc < w2

    feasible = np.zeros((h2, w2), dtype=bool)
    for r in range(h2):
        for c in range(w2):
            feasible[r, c] = bool(trav[r : r + n, c : c + n].all())
    assert bool(feasible[sr, sc])

    dist = _bfs_placement(feasible, sr, sc)
    tr, tc = _pick_target(dist, dr, dc, max_steps)

    out = g.copy()
    out[int(sr) : int(sr + n), int(sc) : int(sc + n)] = int(river)
    out[int(tr) : int(tr + n), int(tc) : int(tc + n)] = mover_patch
    return out


def _hamiltonian_walk(rows: int, cols: int, start: tuple[int, int], end: tuple[int, int]):
    total = rows * cols
    best_path = None
    best_len = 0
    for _attempt in range(80):
        visited = {start}
        path = [start]
        cur = start
        while True:
            if cur == end and len(path) >= total * 0.7:
                if len(path) > best_len:
                    best_path = list(path)
                    best_len = len(path)
                break
            neighbors = []
            for dr, dc in _DIR4:
                nr, nc = cur[0] + dr, cur[1] + dc
                if 0 <= nr < rows and 0 <= nc < cols and (nr, nc) not in visited:
                    neighbors.append((nr, nc))
            if not neighbors:
                break
            valid = []
            for nb in neighbors:
                if nb == end:
                    valid.append(nb)
                    continue
                test_visited = visited | {nb}
                seen = {end}
                q = deque([end])
                while q:
                    cr, cc = q.popleft()
                    for dr2, dc2 in _DIR4:
                        nr2, nc2 = cr + dr2, cc + dc2
                        if (
                            0 <= nr2 < rows
                            and 0 <= nc2 < cols
                            and (nr2, nc2) not in test_visited
                            and (nr2, nc2) not in seen
                        ):
                            seen.add((nr2, nc2))
                            q.append((nr2, nc2))
                for dr2, dc2 in _DIR4:
                    ar, ac = nb[0] + dr2, nb[1] + dc2
                    if (
                        0 <= ar < rows
                        and 0 <= ac < cols
                        and (ar, ac) not in test_visited
                        and (ar, ac) in seen
                    ):
                        valid.append(nb)
                        break
            if not valid:
                break
            random.shuffle(valid)
            nxt = valid[0]
            visited.add(nxt)
            path.append(nxt)
            cur = nxt
        if best_path and best_len >= total * 0.85:
            break
    return best_path


def _render_channel(grid: np.ndarray, path, n: int, offsets_r: list[int], offsets_c: list[int]):
    pixel_pos = []
    for cr, cc in path:
        pr, pc = offsets_r[cr], offsets_c[cc]
        pixel_pos.append((pr, pc))
        grid[pr : pr + n, pc : pc + n] = _RIVER
    for i in range(len(path) - 1):
        pr1, pc1 = pixel_pos[i]
        pr2, pc2 = pixel_pos[i + 1]
        if pr1 == pr2:
            c_lo, c_hi = min(pc1, pc2), max(pc1, pc2) + n
            grid[pr1 : pr1 + n, c_lo:c_hi] = _RIVER
        else:
            r_lo, r_hi = min(pr1, pr2), max(pr1, pr2) + n
            grid[r_lo:r_hi, pc1 : pc1 + n] = _RIVER
    return pixel_pos


def _count_turns(path) -> int:
    turns = 0
    for i in range(1, len(path) - 1):
        dr1 = path[i][0] - path[i - 1][0]
        dc1 = path[i][1] - path[i - 1][1]
        dr2 = path[i + 1][0] - path[i][0]
        dc2 = path[i + 1][1] - path[i][1]
        if (dr1, dc1) != (dr2, dc2):
            turns += 1
    return turns


def _add_chokepoint(grid: np.ndarray, pixel_pos_i, pixel_pos_j, n: int, direction: str):
    H, W = grid.shape
    pr1, pc1 = pixel_pos_i
    pr2, pc2 = pixel_pos_j
    narrow_w = random.randint(1, n - 1)
    remove = n - narrow_w
    side = random.randint(0, 1)

    if direction == "h":
        c_lo = min(pc1, pc2) + n
        c_hi = max(pc1, pc2)
        if c_hi <= c_lo:
            c_lo, c_hi = min(pc1, pc2), max(pc1, pc2) + n
        hold_len = random.randint(1, min(6, max(1, c_hi - c_lo - 2 * remove)))
        total_len = 2 * remove + hold_len
        c_mid = (c_lo + c_hi) // 2
        c_start = max(c_lo, c_mid - total_len // 2)
        for step in range(total_len):
            c = c_start + step
            if not (0 <= c < W):
                continue
            if step < remove:
                depth = step + 1
            elif step >= total_len - remove:
                depth = total_len - step
            else:
                depth = remove
            for k in range(depth):
                rr = pr1 + k if side == 0 else pr1 + n - 1 - k
                if 0 <= rr < H:
                    grid[rr, c] = _BG
    else:
        r_lo = min(pr1, pr2) + n
        r_hi = max(pr1, pr2)
        if r_hi <= r_lo:
            r_lo, r_hi = min(pr1, pr2), max(pr1, pr2) + n
        hold_len = random.randint(1, min(6, max(1, r_hi - r_lo - 2 * remove)))
        total_len = 2 * remove + hold_len
        r_mid = (r_lo + r_hi) // 2
        r_start = max(r_lo, r_mid - total_len // 2)
        for step in range(total_len):
            r = r_start + step
            if not (0 <= r < H):
                continue
            if step < remove:
                depth = step + 1
            elif step >= total_len - remove:
                depth = total_len - step
            else:
                depth = remove
            for k in range(depth):
                cc = pc1 + k if side == 0 else pc1 + n - 1 - k
                if 0 <= cc < W:
                    grid[r, cc] = _BG


def _river_connected(grid: np.ndarray) -> bool:
    mask = grid == int(_RIVER)
    if not bool(mask.any()):
        return False
    _labeled, num = scipy_label(mask.astype(int), structure=STRUCT4)
    return int(num) == 1


def _compute_offsets(G: int, n: int, num_coarse: int):
    if num_coarse == 1:
        return [1]
    first = 1
    last = G - n - 1
    if last < first:
        return None
    step = (last - first) / (num_coarse - 1)
    return [int(round(first + i * step)) for i in range(num_coarse)]


def _make_mover_patch(n: int, steps: int) -> np.ndarray:
    assert 1 <= steps <= n * n - 1
    patch = np.full((n, n), _MOVER, dtype=int)
    cells = [(r, c) for r in range(n) for c in range(n) if not (r == 0 and c == 0)]
    for r, c in cells[:steps]:
        patch[r, c] = _SYMBOL
    return patch


def _gen_attempt(scenario: str | None = None):
    if scenario is None:
        scenario = random.choices(
            ["short", "reach", "choke"],
            weights=[0.50, 0.30, 0.20],
            k=1,
        )[0]
    reached = scenario != "choke"
    n = random.choice([4, 4, 3]) if scenario == "reach" else random.choice([3, 4])

    min_size = max(10, 5 * n)
    if min_size > 20:
        return None
    G = random.randint(min_size, 20)
    H = W = G

    min_spacing = n + 1
    max_coarse = max(3, (G - 2) // min_spacing)
    coarse_dim = random.randint(3, min(6, max_coarse))
    coarse_rows = coarse_cols = coarse_dim

    offsets_r = _compute_offsets(G, n, coarse_rows)
    offsets_c = _compute_offsets(G, n, coarse_cols)
    if offsets_r is None or offsets_c is None:
        return None
    if any(offsets_r[i + 1] - offsets_r[i] < n for i in range(len(offsets_r) - 1)):
        return None
    if any(offsets_c[i + 1] - offsets_c[i] < n for i in range(len(offsets_c) - 1)):
        return None

    edge_cells = set()
    for c in range(coarse_cols):
        edge_cells.add((0, c))
        edge_cells.add((coarse_rows - 1, c))
    for r in range(1, coarse_rows - 1):
        edge_cells.add((r, 0))
        edge_cells.add((r, coarse_cols - 1))
    edge_cells = list(edge_cells)
    random.shuffle(edge_cells)
    start_coarse = edge_cells[0]
    far = sorted(edge_cells, key=lambda e: -(abs(e[0] - start_coarse[0]) + abs(e[1] - start_coarse[1])))
    end_coarse = far[0] if far[0] != start_coarse else far[1]

    walk = _hamiltonian_walk(coarse_rows, coarse_cols, start_coarse, end_coarse)
    if walk is None or len(walk) < 4:
        return None
    if scenario == "reach":
        hi = min(len(walk), 6)
        if hi < 4:
            return None
        walk = walk[: random.randint(4, hi)]
        if _count_turns(walk) < 2:
            return None
    elif len({cr for cr, _ in walk}) < coarse_rows or len({cc for _, cc in walk}) < coarse_cols:
        return None

    grid = np.full((H, W), _BG, dtype=int)
    pixel_pos = _render_channel(grid, walk, n, offsets_r, offsets_c)
    mask = grid != _BG
    if np.any(mask, axis=1).sum() / H < 0.70 or np.any(mask, axis=0).sum() / W < 0.70:
        return None

    mover_r, mover_c = pixel_pos[0]
    dest_r, dest_c = pixel_pos[-1]

    def _extend_to_edge(pr: int, pc: int):
        candidates = []
        for direction in ["top", "bottom", "left", "right"]:
            if direction == "top":
                dist = pr
                if dist == 0:
                    candidates.append((0, pc, 0))
                elif all(grid[r, c] in (_BG, _RIVER) for r in range(pr) for c in range(pc, pc + n)):
                    candidates.append((0, pc, dist))
            elif direction == "bottom":
                dist = H - (pr + n)
                if dist == 0:
                    candidates.append((pr, pc, 0))
                elif all(grid[r, c] in (_BG, _RIVER) for r in range(pr + n, H) for c in range(pc, pc + n)):
                    candidates.append((H - n, pc, dist))
            elif direction == "left":
                dist = pc
                if dist == 0:
                    candidates.append((pr, 0, 0))
                elif all(grid[r, c] in (_BG, _RIVER) for r in range(pr, pr + n) for c in range(pc)):
                    candidates.append((pr, 0, dist))
            else:
                dist = W - (pc + n)
                if dist == 0:
                    candidates.append((pr, pc, 0))
                elif all(grid[r, c] in (_BG, _RIVER) for r in range(pr, pr + n) for c in range(pc + n, W)):
                    candidates.append((pr, W - n, dist))
        if not candidates:
            return None
        candidates.sort(key=lambda x: x[2])
        return candidates[0][:2]

    result = _extend_to_edge(dest_r, dest_c)
    if result is None:
        return None
    new_dest_r, new_dest_c = result
    if new_dest_r != dest_r:
        r_lo, r_hi = min(new_dest_r, dest_r), max(new_dest_r, dest_r) + n
        grid[r_lo:r_hi, dest_c : dest_c + n] = _RIVER
    if new_dest_c != dest_c:
        c_lo, c_hi = min(new_dest_c, dest_c), max(new_dest_c, dest_c) + n
        grid[dest_r : dest_r + n, c_lo:c_hi] = _RIVER
    dest_r, dest_c = new_dest_r, new_dest_c
    if not (dest_r == 0 or dest_r + n == H or dest_c == 0 or dest_c + n == W):
        return None

    touching = mover_r == 0 or mover_r + n == H or mover_c == 0 or mover_c + n == W
    if touching:
        if mover_r == 0:
            grid[0, mover_c : mover_c + n] = _RIVER
            mover_r = 1
        elif mover_r + n == H:
            grid[H - 1, mover_c : mover_c + n] = _RIVER
            mover_r = H - n - 1
        elif mover_c == 0:
            grid[mover_r : mover_r + n, 0] = _RIVER
            mover_c = 1
        else:
            grid[mover_r : mover_r + n, W - 1] = _RIVER
            mover_c = W - n - 1
    if mover_r == 0 or mover_r + n == H or mover_c == 0 or mover_c + n == W:
        return None
    if min(mover_r, H - (mover_r + n), mover_c, W - (mover_c + n)) > 2:
        return None

    grid[mover_r : mover_r + n, mover_c : mover_c + n] = _RIVER
    grid[dest_r : dest_r + n, dest_c : dest_c + n] = _RIVER

    if not reached and n >= 2:
        num_choke = random.randint(1, min(3, len(walk) - 2))
        min_seg = max(1, len(walk) // 4)
        available = list(range(min_seg, len(walk) - 1))
        random.shuffle(available)
        for seg_idx in available[:num_choke]:
            pr1, pc1 = pixel_pos[seg_idx]
            pr2, pc2 = pixel_pos[min(seg_idx + 1, len(pixel_pos) - 1)]
            direction = "h" if pr1 == pr2 else "v"
            _add_chokepoint(grid, (pr1, pc1), (pr2, pc2), n, direction)
        if not _river_connected(grid):
            return None

    trav = grid == _RIVER
    h2, w2 = H - n + 1, W - n + 1
    feasible = np.zeros((h2, w2), dtype=bool)
    for r in range(h2):
        for c in range(w2):
            feasible[r, c] = bool(trav[r : r + n, c : c + n].all())
    if not bool(feasible[mover_r, mover_c]):
        return None

    dist = _bfs_placement(feasible, mover_r, mover_c)
    max_symbol_steps = n * n - 1

    if scenario == "reach":
        reach_cells = []
        for r in range(h2):
            for c in range(w2):
                d = int(dist[r, c])
                if 3 <= d <= max_symbol_steps:
                    reach_cells.append((d, r, c))
        if not reach_cells:
            return None
        reach_cells.sort()
        best_d, best_r, best_c = reach_cells[-1]
        dest_r, dest_c = int(best_r), int(best_c)

    dest_ok = bool(0 <= dest_r < h2 and 0 <= dest_c < w2 and feasible[dest_r, dest_c] and dist[dest_r, dest_c] >= 0)
    farthest = int(dist.max())

    if scenario == "reach":
        if not dest_ok:
            return None
        encoded_steps = int(dist[dest_r, dest_c])
        if not (1 <= encoded_steps <= max_symbol_steps):
            return None
    elif scenario == "short":
        if not dest_ok:
            return None
        max_short = min(int(dist[dest_r, dest_c]) - 1, max_symbol_steps)
        if max_short < 1:
            return None
        encoded_steps = random.randint(1, max_short)
    else:
        if dest_ok or farthest < 1 or farthest >= max_symbol_steps:
            return None
        encoded_steps = random.randint(farthest + 1, max_symbol_steps)

    mover_patch = _make_mover_patch(n, encoded_steps)
    grid[mover_r : mover_r + n, mover_c : mover_c + n] = mover_patch
    grid[dest_r : dest_r + n, dest_c : dest_c + n] = _DEST

    tr, tc = _pick_target(dist, dest_r, dest_c, encoded_steps)
    output = grid.copy()
    output[mover_r : mover_r + n, mover_c : mover_c + n] = _RIVER
    output[tr : tr + n, tc : tc + n] = mover_patch

    if not np.array_equal(main(grid), output):
        return None
    return grid


def generate_input():
    scenario = random.choices(
        ["short", "reach", "choke"],
        weights=[0.50, 0.30, 0.20],
        k=1,
    )[0]
    for _ in range(250):
        result = _gen_attempt(scenario)
        if result is not None:
            return result
    for fallback in ["short", "reach", "choke"]:
        for _ in range(120):
            result = _gen_attempt(fallback)
            if result is not None:
                return result
    for _ in range(60):
        result = _gen_attempt()
        if result is not None:
            return result
    raise RuntimeError("Failed to generate valid input after retries")

