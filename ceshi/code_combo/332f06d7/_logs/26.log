+_BG, _RIVER, _MOVER, _DEST, _SYMBOL = 3, 1, 0, 2, 8
+_TURN_COLORS = (4, 6)
+_DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]  # U, R, D, L
