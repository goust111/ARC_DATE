85:
86:def _pick_target(dist: np.ndarray, dr: int, dc: int, max_steps: int) -> tuple[int, int]:
87:    if 0 <= dr < dist.shape[0] and 0 <= dc < dist.shape[1]:
88:        d = int(dist[dr, dc])
89:        if 0 <= d <= max_steps:
90:            return int(dr), int(dc)
91:
92:    best = -1
93:    tr, tc = 0, 0
94:    for r in range(dist.shape[0]):
95:        for c in range(dist.shape[1]):
96:            d = int(dist[r, c])
97:            if 0 <= d <= max_steps and d > best:
98:                best = d
99:                tr, tc = int(r), int(c)
100:    assert best >= 0
101:    return tr, tc
