        expected[mod.LEGEND_H + int(mover_r): mod.LEGEND_H + int(mover_r+n), int(mover_c):int(mover_c+n)] = mod._RIVER
        expected[mod.LEGEND_H + int(exp_r): mod.LEGEND_H + int(exp_r+n), int(exp_c):int(exp_c+n)] = mover_patch
        if not np.array_equal(out, expected):
            reasons['output_mismatch'] += 1; continue
        reasons['success'] += 1
print(reasons)
