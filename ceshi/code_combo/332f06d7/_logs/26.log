332:def _add_turn_wall(grid: np.ndarray, pr: int, pc: int, n: int, incoming_dir: int, color: int) -> bool:
333:    h, w = grid.shape
334:    if incoming_dir == 0:
335:        if pr - 1 < 0:
336:            return False
337:        grid[int(pr - 1), int(pc) : int(pc + n)] = int(color)
338:    elif incoming_dir == 1:
339:        if pc + n >= w:
340:            return False
341:        grid[int(pr) : int(pr + n), int(pc + n)] = int(color)
342:    elif incoming_dir == 2:
343:        if pr + n >= h:
344:            return False
345:        grid[int(pr + n), int(pc) : int(pc + n)] = int(color)
346:    else:
347:        if pc - 1 < 0:
348:            return False
349:        grid[int(pr) : int(pr + n), int(pc - 1)] = int(color)
350:    return True
