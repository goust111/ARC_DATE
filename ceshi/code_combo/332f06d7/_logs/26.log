353:def _add_chokepoint(grid: np.ndarray, p1: tuple[int, int], p2: tuple[int, int], n: int) -> bool:
354:    pr1, pc1 = p1
355:    pr2, pc2 = p2
356:    if pr1 == pr2:
357:        gap_lo = min(pc1, pc2) + n
358:        gap_hi = max(pc1, pc2)
359:        if gap_hi < gap_lo:
360:            return False
361:        wall_c = random.randint(gap_lo, gap_hi)
362:        open_top = 0 if random.random() < 0.5 else n - 1
363:        keep = random.randint(1, n - 1)
364:        if open_top == 0:
365:            grid[int(pr1 + keep) : int(pr1 + n), int(wall_c)] = _BG
366:        else:
367:            grid[int(pr1) : int(pr1 + n - keep), int(wall_c)] = _BG
368:    else:
369:        gap_lo = min(pr1, pr2) + n
370:        gap_hi = max(pr1, pr2)
371:        if gap_hi < gap_lo:
372:            return False
373:        wall_r = random.randint(gap_lo, gap_hi)
374:        open_left = 0 if random.random() < 0.5 else n - 1
375:        keep = random.randint(1, n - 1)
376:        if open_left == 0:
377:            grid[int(wall_r), int(pc1 + keep) : int(pc1 + n)] = _BG
378:        else:
379:            grid[int(wall_r), int(pc1) : int(pc1 + n - keep)] = _BG
380:    return np.any(grid == _RIVER)
