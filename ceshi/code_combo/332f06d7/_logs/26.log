180:                        valid.append(nb)
181:                        break
182:            if not valid:
183:                break
184:            random.shuffle(valid)
185:            nxt = valid[0]
186:            visited.add(nxt)
187:            path.append(nxt)
188:            cur = nxt
189:        if best_path and best_len >= total * 0.85:
190:            break
191:    return best_path
