496:def _gen_attempt() -> np.ndarray | None:
497:    total = random.randint(18, 20)
498:    core_h = total - LEGEND_H
499:    core_w = total
500:    n = 2
501:    if core_h < 16 or core_w < 16:
502:        return None
503:
504:    base_r = random.randint(1, core_h - 15)
505:    base_c = random.randint(1, core_w - 15)
506:    offsets_r = [int(base_r + 3 * i) for i in range(5)]
507:    offsets_c = [int(base_c + 3 * i) for i in range(5)]
508:
509:    turn_by_color = {
510:        int(_TURN_COLORS[0]): random.choice(["cw", "ccw"]),
511:        int(_TURN_COLORS[1]): None,
512:    }
513:    turn_by_color[int(_TURN_COLORS[1])] = "ccw" if turn_by_color[int(_TURN_COLORS[0])] == "cw" else "cw"
514:    color_for_turn = {v: k for k, v in turn_by_color.items()}
515:
516:    base_main_path = [
517:        (1, 0),
518:        (1, 1),
519:        (1, 2),
520:        (2, 2),
521:        (3, 2),
522:        (3, 3),
523:        (3, 4),
524:        (4, 4),
525:    ]
526:    base_short_decoys = [
527:        ((1, 2), (0, 2)),
528:        ((3, 2), (3, 1)),
529:    ]
530:    base_red_branch = [(2, 4), (1, 4), (0, 4)]
531:
532:    mode = random.choice([0, 1, 2, 3])
533:
534:    def tr(cell: tuple[int, int]) -> tuple[int, int]:
535:        r, c = cell
536:        if mode == 0:
537:            return int(r), int(c)
538:        if mode == 1:
539:            return int(r), int(4 - c)
540:        if mode == 2:
541:            return int(4 - r), int(c)
542:        return int(4 - r), int(4 - c)
543:
544:    def dir_between(a: tuple[int, int], b: tuple[int, int]) -> int:
545:        dr = int(b[0] - a[0])
546:        dc = int(b[1] - a[1])
547:        for d, (rr, cc) in enumerate(_DIRS):
548:            if (dr, dc) == (rr, cc):
549:                return int(d)
550:        raise AssertionError("non-adjacent coarse step")
551:
552:    main_path = [tr(cell) for cell in base_main_path]
553:    short_decoys = [(tr(a), tr(b)) for a, b in base_short_decoys]
554:    red_branch = [tr(cell) for cell in base_red_branch]
555:
556:    turn_events: list[dict] = []
557:    for i in range(1, len(main_path) - 1):
558:        d_in = dir_between(main_path[i - 1], main_path[i])
559:        d_out = dir_between(main_path[i], main_path[i + 1])
560:        if d_in == d_out:
561:            continue
562:        turn = "cw" if _rot_cw(d_in) == d_out else "ccw"
563:        turn_events.append({"node": tuple(main_path[i]), "incoming_dir": d_in, "turn": turn})
564:    if len(turn_events) != 3:
565:        return None
566:
567:    branch_edges = list(short_decoys)
568:    branch_edges.append((tuple(main_path[-2]), tuple(red_branch[0])))
569:    for a, b in zip(red_branch, red_branch[1:], strict=False):
570:        branch_edges.append((tuple(a), tuple(b)))
571:
572:    core = np.full((core_h, core_w), _BG, dtype=int)
573:    main_edges = {_pair(a, b) for a, b in zip(main_path, main_path[1:])}
574:    nodes = set(main_path)
575:    for a, b in branch_edges:
576:        nodes.add(a)
577:        nodes.add(b)
578:    all_edges = set(main_edges) | {_pair(a, b) for a, b in branch_edges}
579:    pixel = _render_network(core, nodes=nodes, edges=all_edges, offsets_r=offsets_r, offsets_c=offsets_c, n=n)
580:
581:    for ev in turn_events:
582:        pr, pc = pixel[tuple(ev["node"])]
583:        wall_col = int(color_for_turn[str(ev["turn"])])
584:        if not _add_turn_wall(core, pr=pr, pc=pc, n=n, incoming_dir=int(ev["incoming_dir"]), color=wall_col):
585:            return None
586:        ev["wall_color"] = wall_col
587:
588:    mover_cell = tuple(main_path[0])
589:    expected_cell = tuple(main_path[-1])
590:    dest_cell = tuple(red_branch[-1])
591:    mover_r, mover_c = pixel[mover_cell]
592:    dest_r, dest_c = pixel[dest_cell]
593:    core[int(mover_r) : int(mover_r + n), int(mover_c) : int(mover_c + n)] = _MOVER
594:    core[int(dest_r) : int(dest_r + n), int(dest_c) : int(dest_c + n)] = _DEST
595:
596:    legend_order = list(_TURN_COLORS)
597:    random.shuffle(legend_order)
598:    legend = _build_legend(core_w, turn_by_color=turn_by_color, order=legend_order)
599:    full = np.vstack([legend, core])
600:
601:    turn_map = _parse_legend(full)
602:    if set(turn_map) != set(_TURN_COLORS):
603:        return None
604:    if len({turn_map[c] for c in _TURN_COLORS}) != 2:
605:        return None
606:    if sum(1 for ev in turn_events if ev["wall_color"] == _TURN_COLORS[0]) == 0:
607:        return None
608:    if sum(1 for ev in turn_events if ev["wall_color"] == _TURN_COLORS[1]) == 0:
609:        return None
610:
611:    core_only = full[LEGEND_H:, :]
612:    bg, mover, dest = _infer_roles(core_only)
613:    river = _infer_river(core_only, bg=bg, mover_col=int(mover["col"]), dest_col=int(dest["col"]))
614:    feasible = _feasible_mask(core_only, river=river, mover_col=int(mover["col"]), dest_col=int(dest["col"]), n=int(mover["n"]))
615:    try:
616:        _ = _start_direction(feasible, int(mover["r0"]), int(mover["c0"]))
617:    except AssertionError:
618:        return None
619:
620:    variant_tr, variant_tc = _simulate(core_only, turn_by_color=turn_map, mover=mover, dest=dest)
621:    exp_r, exp_c = pixel[expected_cell]
622:    if (variant_tr, variant_tc) != (int(exp_r), int(exp_c)):
623:        return None
624:    if (variant_tr, variant_tc) == (int(dest["r0"]), int(dest["c0"])):
625:        return None
626:
627:    # Red remains geometrically reachable in the plain river network, so the legend-driven
628:    # result genuinely differs from the original BFS-style interpretation.
629:    dist = -np.ones_like(feasible, dtype=int)
630:    sr, sc = int(mover["r0"]), int(mover["c0"])
631:    dist[sr, sc] = 0
632:    q = [(sr, sc)]
633:    head = 0
634:    while head < len(q):
635:        r, c = q[head]
636:        head += 1
637:        for dr, dc in _DIRS:
638:            rr, cc = int(r + dr), int(c + dc)
639:            if 0 <= rr < feasible.shape[0] and 0 <= cc < feasible.shape[1] and bool(feasible[rr, cc]) and int(dist[rr, cc]) < 0:
640:                dist[rr, cc] = int(dist[r, c] + 1)
641:                q.append((rr, cc))
642:    if int(dist[int(dest["r0"]), int(dest["c0"])]) < 0:
643:        return None
644:
645:    out = main(full)
646:    if not bool((out[LEGEND_H + int(exp_r) : LEGEND_H + int(exp_r + n), int(exp_c) : int(exp_c + n)] == _MOVER).all()):
647:        return None
648:    return full
649:
650:
651:def generate_input() -> np.ndarray:
652:    for _ in range(1000):
653:        grid = _gen_attempt()
654:        if grid is not None:
655:            return grid
656:    raise RuntimeError("Failed to generate valid input after 1000 attempts")

