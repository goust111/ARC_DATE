120:def _detect_squares(g: np.ndarray, bg: int) -> list[dict]:
121:    squares: list[dict] = []
122:    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict"):
123:        col = int(comp["color"])
124:        b = comp["bbox"]
125:        if bbox_h(b) != bbox_w(b):
126:            continue
127:        patch = g[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1]
128:        if not bool((patch == int(col)).all()):
129:            continue
130:        squares.append({"col": int(col), "r0": int(b[0]), "c0": int(b[1]), "n": int(bbox_h(b))})
131:    return squares
