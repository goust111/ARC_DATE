214:
215:def _simulate(core: np.ndarray, turn_by_color: dict[int, str], mover: dict, dest: dict) -> tuple[int, int]:
216:    bg = int(Counter([int(core[0, 0]), int(core[0, -1]), int(core[-1, 0]), int(core[-1, -1])]).most_common(1)[0][0])
217:    n = int(mover["n"])
218:    sr, sc = int(mover["r0"]), int(mover["c0"])
219:    dr, dc = int(dest["r0"]), int(dest["c0"])
220:    river = _infer_river(core, bg=bg, mover_col=int(mover["col"]), dest_col=int(dest["col"]))
221:    feasible = _feasible_mask(core, river=river, mover_col=int(mover["col"]), dest_col=int(dest["col"]), n=n)
222:    assert not (not bool(feasible[int(sr), int(sc)]))
223:
224:    d = _start_direction(feasible, sr=sr, sc=sc)
225:    r, c = int(sr), int(sc)
226:    ignore = {int(bg), int(river), int(mover["col"]), int(dest["col"])}
227:    seen: set[tuple[int, int, int]] = set()
228:
229:    for _ in range(core.shape[0] * core.shape[1] * 8):
230:        if (int(r), int(c)) == (int(dr), int(dc)):
231:            break
232:        state = (int(r), int(c), int(d))
233:        if state in seen:
234:            break
235:        seen.add(state)
236:
237:        dr0, dc0 = _DIRS[int(d)]
238:        rr, cc = int(r + dr0), int(c + dc0)
239:        if 0 <= rr < feasible.shape[0] and 0 <= cc < feasible.shape[1] and bool(feasible[rr, cc]):
240:            r, c = int(rr), int(cc)
241:            continue
242:
243:        wall_col = _obstacle_color_ahead(core, r=r, c=c, d=d, n=n, ignore=ignore)
244:        if wall_col is None:
245:            break
246:        turn = turn_by_color.get(int(wall_col))
247:        if turn is None:
248:            break
249:
250:        nd = _rot_cw(d) if turn == "cw" else _rot_ccw(d)
251:        dr1, dc1 = _DIRS[int(nd)]
252:        rr, cc = int(r + dr1), int(c + dc1)
253:        if 0 <= rr < feasible.shape[0] and 0 <= cc < feasible.shape[1] and bool(feasible[rr, cc]):
254:            r, c, d = int(rr), int(cc), int(nd)
255:            continue
256:        break
257:
258:    return int(r), int(c)
