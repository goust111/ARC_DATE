383:def _pair(a: tuple[int, int], b: tuple[int, int]) -> tuple[tuple[int, int], tuple[int, int]]:
384:    return (a, b) if a <= b else (b, a)
385:
386:
387:def _edge_start_options(rows: int, cols: int) -> list[tuple[tuple[int, int], int]]:
388:    opts: list[tuple[tuple[int, int], int]] = []
389:    for c in range(1, cols - 1):
390:        opts.append(((0, c), 2))
391:        opts.append(((rows - 1, c), 0))
392:    for r in range(1, rows - 1):
393:        opts.append(((r, 0), 1))
394:        opts.append(((r, cols - 1), 3))
395:    random.shuffle(opts)
396:    return opts
397:
398:
399:def _advance(cell: tuple[int, int], d: int, steps: int = 1) -> tuple[int, int]:
400:    dr, dc = _DIRS[int(d)]
401:    return int(cell[0] + dr * steps), int(cell[1] + dc * steps)
402:
403:
404:def _build_route(
405:    rows: int,
406:    cols: int,
407:    turn_seq: list[str],
408:) -> tuple[
409:    list[tuple[int, int]],
410:    list[dict],
411:    int,
412:] | None:
413:    for start, d0 in _edge_start_options(rows, cols):
414:        for _ in range(80):
415:            cur = start
416:            d = d0
417:            main_path = [cur]
418:            occupied = {cur}
419:            turn_events: list[dict] = []
420:            ok = True
421:
422:            for turn in turn_seq:
423:                chosen = _rot_cw(d) if turn == "cw" else _rot_ccw(d)
424:                other = _rot_ccw(d) if turn == "cw" else _rot_cw(d)
425:                candidates = []
426:                for seg_len in [3, 2, 1]:
427:                    seg = [_advance(cur, d, k) for k in range(1, seg_len + 1)]
428:                    if any(not (0 <= r < rows and 0 <= c < cols) for r, c in seg):
429:                        continue
430:                    if any(cell in occupied for cell in seg):
431:                        continue
432:                    end = seg[-1]
433:                    nxt = _advance(end, chosen, 1)
434:                    dec = _advance(end, other, 1)
435:                    if not (0 <= nxt[0] < rows and 0 <= nxt[1] < cols):
436:                        continue
437:                    if not (0 <= dec[0] < rows and 0 <= dec[1] < cols):
438:                        continue
439:                    if nxt in occupied or dec in occupied or nxt == dec:
440:                        continue
441:                    candidates.append((seg_len, seg, end, chosen, other, nxt, dec))
442:                if not candidates:
443:                    ok = False
444:                    break
445:                seg_len, seg, end, chosen, other, nxt, dec = random.choice(candidates)
446:                main_path.extend(seg)
447:                occupied.update(seg)
448:                turn_events.append(
449:                    {
450:                        "node": end,
451:                        "incoming_dir": d,
452:                        "turn": turn,
453:                        "decoy_cell": dec,
454:                        "decoy_dir": other,
455:                        "chosen_dir": chosen,
456:                    }
457:                )
458:                cur = end
459:                d = chosen
460:
461:            if not ok:
462:                continue
463:
464:            tail_choices = []
465:            for tail_len in [3, 2, 1]:
466:                seg = [_advance(cur, d, k) for k in range(1, tail_len + 1)]
467:                if any(not (0 <= r < rows and 0 <= c < cols) for r, c in seg):
468:                    continue
469:                if any(cell in occupied for cell in seg):
470:                    continue
471:                tail_choices.append((seg, seg[-1], d))
472:            if not tail_choices:
473:                continue
474:            seg, end, tail_dir = random.choice(tail_choices)
475:            main_path.extend(seg)
476:            occupied.update(seg)
477:            return main_path, turn_events, tail_dir
478:    return None
