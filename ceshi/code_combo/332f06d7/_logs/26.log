+    ]
+    red_branch = [_transform_cell(cell, flip_r=flip_r, flip_c=flip_c) for cell in _BASE_RED_BRANCH]
+    return main_path, decoy_edges, red_branch
+
+
+def _gen_attempt() -> np.ndarray | None:
