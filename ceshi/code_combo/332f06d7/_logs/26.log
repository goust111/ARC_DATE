207:            return None
208:        strip = core[int(r) : int(r + n), int(c - 1)]
209:    cols = {int(x) for x in np.array(strip).flatten() if int(x) not in ignore}
210:    if len(cols) != 1:
211:        return None
212:    return int(next(iter(cols)))
