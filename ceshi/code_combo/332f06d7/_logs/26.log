481:def _build_legend(width: int, turn_by_color: dict[int, str], order: list[int]) -> np.ndarray:
482:    legend = np.full((LEGEND_H, width), LEGEND_BG, dtype=int)
483:    cursor = 1
484:    for col in order:
485:        if cursor + 2 >= width:
486:            break
487:        legend[0, cursor + 1] = int(col)
488:        if turn_by_color[int(col)] == "ccw":
489:            legend[1, cursor] = int(col)
490:        else:
491:            legend[1, cursor + 2] = int(col)
492:        cursor += 4
493:    return legend
