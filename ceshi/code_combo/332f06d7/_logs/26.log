194:def _render_channel(grid, path, n, offsets_r, offsets_c):
195:    pixel_pos = []
196:    for cr, cc in path:
197:        pr, pc = offsets_r[cr], offsets_c[cc]
198:        pixel_pos.append((pr, pc))
199:        grid[pr:pr + n, pc:pc + n] = _RIVER
200:    for i in range(len(path) - 1):
201:        pr1, pc1 = pixel_pos[i]
202:        pr2, pc2 = pixel_pos[i + 1]
203:        if pr1 == pr2:
204:            c_lo, c_hi = min(pc1, pc2), max(pc1, pc2) + n
205:            grid[pr1:pr1 + n, c_lo:c_hi] = _RIVER
206:        else:
207:            r_lo, r_hi = min(pr1, pr2), max(pr1, pr2) + n
208:            grid[r_lo:r_hi, pc1:pc1 + n] = _RIVER
209:    return pixel_pos
