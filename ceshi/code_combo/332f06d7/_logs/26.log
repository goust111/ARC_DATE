103:def _parse_legend(grid: np.ndarray) -> dict[int, str]:
104:    legend = np.array(grid[:LEGEND_H, :], dtype=int)
105:    turn_by_color: dict[int, str] = {}
106:    for col in sorted(set(map(int, legend.flatten()))):
107:        if int(col) == LEGEND_BG:
108:            continue
109:        pts = np.argwhere(legend == int(col))
110:        if len(pts) != 2:
111:            continue
112:        top = [p for p in pts if int(p[0]) == 0]
113:        bot = [p for p in pts if int(p[0]) == 1]
114:        if len(top) != 1 or len(bot) != 1:
115:            continue
116:        turn_by_color[int(col)] = "ccw" if int(bot[0][1]) < int(top[0][1]) else "cw"
117:    return turn_by_color
