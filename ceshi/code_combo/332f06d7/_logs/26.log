185:
186:def _hamiltonian_walk(rows: int, cols: int, start: tuple[int, int], end: tuple[int, int]):
187:    total = rows * cols
188:    best_path = None
189:    best_len = 0
190:    for _attempt in range(80):
191:        visited = {start}
192:        path = [start]
193:        cur = start
194:        while True:
195:            if cur == end and len(path) >= total * 0.7:
196:                if len(path) > best_len:
197:                    best_path = list(path)
198:                    best_len = len(path)
199:                break
200:            neighbors = []
201:            for dr, dc in _DIR4:
202:                nr, nc = cur[0] + dr, cur[1] + dc
203:                if 0 <= nr < rows and 0 <= nc < cols and (nr, nc) not in visited:
204:                    neighbors.append((nr, nc))
205:            if not neighbors:
206:                break
207:            valid = []
208:            for nb in neighbors:
209:                if nb == end:
210:                    valid.append(nb)
211:                    continue
212:                test_visited = visited | {nb}
213:                seen = {end}
214:                q = deque([end])
215:                while q:
216:                    cr, cc = q.popleft()
217:                    for dr2, dc2 in _DIR4:
218:                        nr2, nc2 = cr + dr2, cc + dc2
219:                        if (
220:                            0 <= nr2 < rows
221:                            and 0 <= nc2 < cols
222:                            and (nr2, nc2) not in test_visited
223:                            and (nr2, nc2) not in seen
224:                        ):
225:                            seen.add((nr2, nc2))
226:                            q.append((nr2, nc2))
227:                for dr2, dc2 in _DIR4:
228:                    ar, ac = nb[0] + dr2, nb[1] + dc2
229:                    if (
230:                        0 <= ar < rows
231:                        and 0 <= ac < cols
232:                        and (ar, ac) not in test_visited
233:                        and (ar, ac) in seen
234:                    ):
235:                        valid.append(nb)
236:                        break
237:            if not valid:
238:                break
239:            random.shuffle(valid)
240:            nxt = valid[0]
241:            visited.add(nxt)
242:            path.append(nxt)
243:            cur = nxt
244:        if best_path and best_len >= total * 0.85:
245:            break
246:    return best_path
247:
248:
249:def _render_channel(grid: np.ndarray, path, n: int, offsets_r: list[int], offsets_c: list[int]):
250:    pixel_pos = []
251:    for cr, cc in path:
252:        pr, pc = offsets_r[cr], offsets_c[cc]
253:        pixel_pos.append((pr, pc))
254:        grid[pr : pr + n, pc : pc + n] = _RIVER
255:    for i in range(len(path) - 1):
256:        pr1, pc1 = pixel_pos[i]
257:        pr2, pc2 = pixel_pos[i + 1]
258:        if pr1 == pr2:
259:            c_lo, c_hi = min(pc1, pc2), max(pc1, pc2) + n
260:            grid[pr1 : pr1 + n, c_lo:c_hi] = _RIVER
261:        else:
262:            r_lo, r_hi = min(pr1, pr2), max(pr1, pr2) + n
263:            grid[r_lo:r_hi, pc1 : pc1 + n] = _RIVER
264:    return pixel_pos
265:
266:
267:def _count_turns(path) -> int:
268:    turns = 0
269:    for i in range(1, len(path) - 1):
270:        dr1 = path[i][0] - path[i - 1][0]
271:        dc1 = path[i][1] - path[i - 1][1]
272:        dr2 = path[i + 1][0] - path[i][0]
273:        dc2 = path[i + 1][1] - path[i][1]
274:        if (dr1, dc1) != (dr2, dc2):
275:            turns += 1
276:    return turns
277:
278:
279:def _add_chokepoint(grid: np.ndarray, pixel_pos_i, pixel_pos_j, n: int, direction: str):
280:    H, W = grid.shape
281:    pr1, pc1 = pixel_pos_i
282:    pr2, pc2 = pixel_pos_j
283:    narrow_w = random.randint(1, n - 1)
284:    remove = n - narrow_w
285:    side = random.randint(0, 1)
286:
287:    if direction == "h":
288:        c_lo = min(pc1, pc2) + n
289:        c_hi = max(pc1, pc2)
290:        if c_hi <= c_lo:
291:            c_lo, c_hi = min(pc1, pc2), max(pc1, pc2) + n
292:        hold_len = random.randint(1, min(6, max(1, c_hi - c_lo - 2 * remove)))
293:        total_len = 2 * remove + hold_len
294:        c_mid = (c_lo + c_hi) // 2
295:        c_start = max(c_lo, c_mid - total_len // 2)
296:        for step in range(total_len):
297:            c = c_start + step
298:            if not (0 <= c < W):
299:                continue
300:            if step < remove:
301:                depth = step + 1
302:            elif step >= total_len - remove:
303:                depth = total_len - step
304:            else:
305:                depth = remove
306:            for k in range(depth):
307:                rr = pr1 + k if side == 0 else pr1 + n - 1 - k
308:                if 0 <= rr < H:
309:                    grid[rr, c] = _BG
310:    else:
311:        r_lo = min(pr1, pr2) + n
312:        r_hi = max(pr1, pr2)
313:        if r_hi <= r_lo:
314:            r_lo, r_hi = min(pr1, pr2), max(pr1, pr2) + n
315:        hold_len = random.randint(1, min(6, max(1, r_hi - r_lo - 2 * remove)))
316:        total_len = 2 * remove + hold_len
317:        r_mid = (r_lo + r_hi) // 2
318:        r_start = max(r_lo, r_mid - total_len // 2)
319:        for step in range(total_len):
320:            r = r_start + step
321:            if not (0 <= r < H):
322:                continue
323:            if step < remove:
324:                depth = step + 1
325:            elif step >= total_len - remove:
326:                depth = total_len - step
327:            else:
328:                depth = remove
329:            for k in range(depth):
330:                cc = pc1 + k if side == 0 else pc1 + n - 1 - k
331:                if 0 <= cc < W:
332:                    grid[r, cc] = _BG
333:
334:
335:def _river_connected(grid: np.ndarray) -> bool:
336:    mask = grid == int(_RIVER)
337:    if not bool(mask.any()):
338:        return False
339:    _labeled, num = scipy_label(mask.astype(int), structure=STRUCT4)
340:    return int(num) == 1
341:
342:
343:def _compute_offsets(G: int, n: int, num_coarse: int):
344:    if num_coarse == 1:
345:        return [1]
346:    first = 1
347:    last = G - n - 1
348:    if last < first:
349:        return None
350:    step = (last - first) / (num_coarse - 1)
351:    return [int(round(first + i * step)) for i in range(num_coarse)]
352:
353:
354:def _make_mover_patch(n: int, steps: int) -> np.ndarray:
355:    assert 1 <= steps <= n * n - 1
356:    patch = np.full((n, n), _MOVER, dtype=int)
357:    cells = [(r, c) for r in range(n) for c in range(n) if not (r == 0 and c == 0)]
358:    for r, c in cells[:steps]:
359:        patch[r, c] = _SYMBOL
360:    return patch
361:
362:
363:def _gen_attempt(scenario: str | None = None):
364:    if scenario is None:
365:        scenario = random.choices(
366:            ["short", "reach", "choke"],
367:            weights=[0.50, 0.30, 0.20],
368:            k=1,
369:        )[0]
370:    reached = scenario != "choke"
371:    n = random.choice([4, 4, 3]) if scenario == "reach" else random.choice([3, 4])
372:
373:    min_size = max(10, 5 * n)
374:    if min_size > 20:
375:        return None
376:    G = random.randint(min_size, 20)
377:    H = W = G
378:
379:    min_spacing = n + 1
380:    max_coarse = max(3, (G - 2) // min_spacing)
381:    coarse_dim = random.randint(3, min(6, max_coarse))
382:    coarse_rows = coarse_cols = coarse_dim
383:
384:    offsets_r = _compute_offsets(G, n, coarse_rows)
385:    offsets_c = _compute_offsets(G, n, coarse_cols)
386:    if offsets_r is None or offsets_c is None:
387:        return None
388:    if any(offsets_r[i + 1] - offsets_r[i] < n for i in range(len(offsets_r) - 1)):
389:        return None
390:    if any(offsets_c[i + 1] - offsets_c[i] < n for i in range(len(offsets_c) - 1)):
391:        return None
392:
393:    edge_cells = set()
394:    for c in range(coarse_cols):
395:        edge_cells.add((0, c))
396:        edge_cells.add((coarse_rows - 1, c))
397:    for r in range(1, coarse_rows - 1):
398:        edge_cells.add((r, 0))
399:        edge_cells.add((r, coarse_cols - 1))
400:    edge_cells = list(edge_cells)
401:    random.shuffle(edge_cells)
402:    start_coarse = edge_cells[0]
403:    far = sorted(edge_cells, key=lambda e: -(abs(e[0] - start_coarse[0]) + abs(e[1] - start_coarse[1])))
404:    end_coarse = far[0] if far[0] != start_coarse else far[1]
405:
406:    walk = _hamiltonian_walk(coarse_rows, coarse_cols, start_coarse, end_coarse)
407:    if walk is None or len(walk) < 4:
408:        return None
409:    if scenario == "reach":
410:        hi = min(len(walk), 6)
411:        if hi < 4:
412:            return None
413:        walk = walk[: random.randint(4, hi)]
414:        if _count_turns(walk) < 2:
415:            return None
416:    elif len({cr for cr, _ in walk}) < coarse_rows or len({cc for _, cc in walk}) < coarse_cols:
417:        return None
418:
419:    grid = np.full((H, W), _BG, dtype=int)
420:    pixel_pos = _render_channel(grid, walk, n, offsets_r, offsets_c)
421:    mask = grid != _BG
422:    if np.any(mask, axis=1).sum() / H < 0.70 or np.any(mask, axis=0).sum() / W < 0.70:
423:        return None
424:
425:    mover_r, mover_c = pixel_pos[0]
426:    dest_r, dest_c = pixel_pos[-1]
427:
428:    def _extend_to_edge(pr: int, pc: int):
429:        candidates = []
430:        for direction in ["top", "bottom", "left", "right"]:
431:            if direction == "top":
432:                dist = pr
433:                if dist == 0:
434:                    candidates.append((0, pc, 0))
435:                elif all(grid[r, c] in (_BG, _RIVER) for r in range(pr) for c in range(pc, pc + n)):
436:                    candidates.append((0, pc, dist))
437:            elif direction == "bottom":
438:                dist = H - (pr + n)
439:                if dist == 0:
440:                    candidates.append((pr, pc, 0))
441:                elif all(grid[r, c] in (_BG, _RIVER) for r in range(pr + n, H) for c in range(pc, pc + n)):
442:                    candidates.append((H - n, pc, dist))
443:            elif direction == "left":
444:                dist = pc
445:                if dist == 0:
446:                    candidates.append((pr, 0, 0))
447:                elif all(grid[r, c] in (_BG, _RIVER) for r in range(pr, pr + n) for c in range(pc)):
448:                    candidates.append((pr, 0, dist))
449:            else:
450:                dist = W - (pc + n)
451:                if dist == 0:
452:                    candidates.append((pr, pc, 0))
453:                elif all(grid[r, c] in (_BG, _RIVER) for r in range(pr, pr + n) for c in range(pc + n, W)):
454:                    candidates.append((pr, W - n, dist))
455:        if not candidates:
456:            return None
457:        candidates.sort(key=lambda x: x[2])
458:        return candidates[0][:2]
459:
460:    result = _extend_to_edge(dest_r, dest_c)
461:    if result is None:
462:        return None
463:    new_dest_r, new_dest_c = result
464:    if new_dest_r != dest_r:
465:        r_lo, r_hi = min(new_dest_r, dest_r), max(new_dest_r, dest_r) + n
466:        grid[r_lo:r_hi, dest_c : dest_c + n] = _RIVER
467:    if new_dest_c != dest_c:
468:        c_lo, c_hi = min(new_dest_c, dest_c), max(new_dest_c, dest_c) + n
469:        grid[dest_r : dest_r + n, c_lo:c_hi] = _RIVER
470:    dest_r, dest_c = new_dest_r, new_dest_c
471:    if not (dest_r == 0 or dest_r + n == H or dest_c == 0 or dest_c + n == W):
472:        return None
473:
474:    touching = mover_r == 0 or mover_r + n == H or mover_c == 0 or mover_c + n == W
475:    if touching:
476:        if mover_r == 0:
477:            grid[0, mover_c : mover_c + n] = _RIVER
478:            mover_r = 1
479:        elif mover_r + n == H:
480:            grid[H - 1, mover_c : mover_c + n] = _RIVER
481:            mover_r = H - n - 1
482:        elif mover_c == 0:
483:            grid[mover_r : mover_r + n, 0] = _RIVER
484:            mover_c = 1
485:        else:
486:            grid[mover_r : mover_r + n, W - 1] = _RIVER
487:            mover_c = W - n - 1
488:    if mover_r == 0 or mover_r + n == H or mover_c == 0 or mover_c + n == W:
489:        return None
490:    if min(mover_r, H - (mover_r + n), mover_c, W - (mover_c + n)) > 2:
491:        return None
492:
493:    grid[mover_r : mover_r + n, mover_c : mover_c + n] = _RIVER
494:    grid[dest_r : dest_r + n, dest_c : dest_c + n] = _RIVER
495:
496:    if not reached and n >= 2:
497:        num_choke = random.randint(1, min(3, len(walk) - 2))
498:        min_seg = max(1, len(walk) // 4)
499:        available = list(range(min_seg, len(walk) - 1))
500:        random.shuffle(available)
501:        for seg_idx in available[:num_choke]:
502:            pr1, pc1 = pixel_pos[seg_idx]
503:            pr2, pc2 = pixel_pos[min(seg_idx + 1, len(pixel_pos) - 1)]
504:            direction = "h" if pr1 == pr2 else "v"
505:            _add_chokepoint(grid, (pr1, pc1), (pr2, pc2), n, direction)
506:        if not _river_connected(grid):
507:            return None
508:
509:    trav = grid == _RIVER
510:    h2, w2 = H - n + 1, W - n + 1
511:    feasible = np.zeros((h2, w2), dtype=bool)
512:    for r in range(h2):
513:        for c in range(w2):
514:            feasible[r, c] = bool(trav[r : r + n, c : c + n].all())
515:    if not bool(feasible[mover_r, mover_c]):
516:        return None
517:
518:    dist = _bfs_placement(feasible, mover_r, mover_c)
