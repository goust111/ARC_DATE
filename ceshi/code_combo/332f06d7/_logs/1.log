# Variant of 332f06d7
# Dimension: D1 — 路径结构：蜿蜒走廊 vs 其他路径形态 (path)
# Change: 蜿蜒的水道走廊(corridor_following)，通道宽度可变，方块沿通道BFS滑行... → 对角线路径加反射
#
# Design analysis
# a) Concrete behavior and trace
#    - Input still contains a green background (3), a blue traversable medium (1), one black n×n mover (0),
#      and one red n×n destination (2). The adaptation adds yellow wall pixels (4).
#    - Blue is no longer a 4-neighbor corridor to be flood-filled by placement BFS. Instead it is the union of
#      diagonal n×n placements of the mover's top-left, so the visible river becomes a diagonal ribbon / chain.
#    - The mover starts at one end of that ribbon. Its initial direction is the unique diagonal feasible neighbor
#      of the black square. After each diagonal advance, if the square is flush against a yellow wall on the side
#      it was moving toward, that axis flips (horizontal wall flips dr, vertical wall flips dc) and motion continues.
#    - Reachable case: the red square lies on the simulated reflected trajectory, so the black square lands on it.
#      Miss case: the red square sits on a visible blue decoy diagonal that is not part of the mover's reflected
#      route; the black square follows the main reflected route and stops at the terminal placement.
#    - Small trace: old task at a bend used BFS to visit every orthogonally adjacent feasible placement; new task
#      at the analogous point cannot branch freely. If current direction is (1,1) and a wall is directly below the
#      landed square, the next step becomes (-1,1). The same blue geometry under old BFS would still allow moving
#      elsewhere, so the control variable changed from undirected connectivity to stateful reflection.
#
# b) Complexity calibration
#    - Reflections are limited to 1-3 per sample and each bounce flips exactly one axis. This is enough to make
#      the path non-trivial and visibly different from the original corridor, without introducing too many regimes.
#    - The optional unreachable red decoy adds one controlled alternative target region. The solver never needs
#      global search over many alternatives; it only needs one deterministic simulation with direction state.
#
# c) Old implicit assumptions that no longer hold
#    - Old square detection sorted candidate squares by numeric color. The variant avoids that hidden assumption and
#      reads the black mover and red destination by their visible roles/colors directly.
#    - Old traversability used 4-neighbor BFS on feasible placements. This assumes directionless motion and makes
#      every orthogonally connected feasible position reachable. Under diagonal reflection, that is false.
#    - Old "farthest reachable point" was max BFS distance. Here "final point" is the last state on the simulated
#      reflected trajectory before no next diagonal placement exists.
#    - Old chokepoints narrower than n blocked motion. The variant instead uses explicit yellow wall contacts to
#      change direction; width-based narrowing is not part of the control logic anymore.
#
# d) Placement legality
#    - The generator builds placement-grid states first, then paints each state as an n×n blue window.
#    - It rejects any attempt whose painted feasible placements are not exactly the intended state set, preventing
#      accidental extra windows, overlaps, or solver ambiguity.
#    - Walls are placed flush outside the landed n×n square at bounce states, never on top of mover/destination.
#
# e) Visual observability
#    - Across examples, humans can see the black square always start at a ribbon endpoint, move diagonally, and
#      change direction only when it reaches a yellow wall. This is a visible structure, not a numeric-color trick.
#    - Reachable and miss cases differ by whether the red square lies on the actual reflected route or on a decoy.
#
# f) Visual cleanliness
#    - Only five colors are used. The blue ribbon, black/red squares, and yellow walls occupy separate roles.
#    - The generator prevents self-touching states except consecutive path cells, so the ribbon remains legible.
#
# g) Color reasoning
#    - No hidden color ordering is used. Fixed visible roles are: black mover, red destination, blue track,
#      green background, yellow reflectors.

from __future__ import annotations

from collections import Counter
import random
import numpy as np


_BG, _RIVER, _DEST, _WALL = 3, 1, 2, 4
_MOVER = 0


def _find_solid_square(grid: np.ndarray, color: int) -> tuple[int, int, int]:
    coords = np.argwhere(grid == int(color))
    assert coords.size > 0
    r0, c0 = coords.min(axis=0)
    r1, c1 = coords.max(axis=0)
    n = int(r1 - r0 + 1)
    assert n == int(c1 - c0 + 1)
    patch = grid[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1]
    assert bool((patch == int(color)).all())
    assert int(patch.size) == int(coords.shape[0])
    return int(r0), int(c0), int(n)


def _feasible_mask(grid: np.ndarray, n: int) -> np.ndarray:
    H, W = grid.shape
    h2, w2 = H - n + 1, W - n + 1
    assert h2 > 0 and w2 > 0
    trav = (grid == int(_RIVER)) | (grid == int(_MOVER)) | (grid == int(_DEST))
    feasible = np.zeros((h2, w2), dtype=bool)
    for r in range(h2):
        for c in range(w2):
            if bool(trav[r : r + n, c : c + n].all()):
                feasible[r, c] = True
    return feasible


def _diag_dirs() -> list[tuple[int, int]]:
    return [(-1, -1), (-1, 1), (1, -1), (1, 1)]


def _unique_start_dir(feasible: np.ndarray, sr: int, sc: int) -> tuple[int, int]:
    h2, w2 = feasible.shape
    dirs: list[tuple[int, int]] = []
    for dr, dc in _diag_dirs():
        rr, cc = sr + dr, sc + dc
        if 0 <= rr < h2 and 0 <= cc < w2 and bool(feasible[rr, cc]):
            dirs.append((int(dr), int(dc)))
    assert len(dirs) == 1
    return dirs[0]


def _touch_row_wall(grid: np.ndarray, r: int, c: int, n: int, dr: int) -> bool:
    if dr == 1:
        rr = r + n
        return rr < grid.shape[0] and bool((grid[rr, c : c + n] == int(_WALL)).any())
    rr = r - 1
    return rr >= 0 and bool((grid[rr, c : c + n] == int(_WALL)).any())


def _touch_col_wall(grid: np.ndarray, r: int, c: int, n: int, dc: int) -> bool:
    if dc == 1:
        cc = c + n
        return cc < grid.shape[1] and bool((grid[r : r + n, cc] == int(_WALL)).any())
    cc = c - 1
    return cc >= 0 and bool((grid[r : r + n, cc] == int(_WALL)).any())


def _simulate(grid: np.ndarray, n: int, sr: int, sc: int, dr: int, dc: int, dest: tuple[int, int]) -> tuple[int, int]:
    feasible = _feasible_mask(grid, n)
    h2, w2 = feasible.shape
    assert bool(feasible[sr, sc])
    cur_r, cur_c = int(sr), int(sc)
    seen = {(int(cur_r), int(cur_c), int(dr), int(dc))}

    while True:
        nr, nc = int(cur_r + dr), int(cur_c + dc)
        if not (0 <= nr < h2 and 0 <= nc < w2 and bool(feasible[nr, nc])):
            return int(cur_r), int(cur_c)

        cur_r, cur_c = int(nr), int(nc)
        if (int(cur_r), int(cur_c)) == (int(dest[0]), int(dest[1])):
            return int(cur_r), int(cur_c)

        if _touch_row_wall(grid, cur_r, cur_c, n, dr):
            dr = -int(dr)
        if _touch_col_wall(grid, cur_r, cur_c, n, dc):
            dc = -int(dc)

        state = (int(cur_r), int(cur_c), int(dr), int(dc))
        if state in seen:
            return int(cur_r), int(cur_c)
        seen.add(state)


def main(grid: np.ndarray) -> np.ndarray:
    g = np.array(grid, dtype=int)
    H, W = g.shape
    assert H == W

    bg = int(Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0])
    assert bg == int(_BG)

    sr, sc, n = _find_solid_square(g, _MOVER)
    dr0, dc0, n2 = _find_solid_square(g, _DEST)
    assert n == n2

    feasible = _feasible_mask(g, n)
    assert bool(feasible[sr, sc])
    init_dr, init_dc = _unique_start_dir(feasible, sr, sc)
    tr, tc = _simulate(g, n, sr, sc, init_dr, init_dc, (dr0, dc0))

    out = g.copy()
    out[sr : sr + n, sc : sc + n] = int(_RIVER)
    out[tr : tr + n, tc : tc + n] = int(_MOVER)
    return out


def _candidate_starts(h2: int, w2: int) -> list[tuple[int, int, int, int]]:
    out: list[tuple[int, int, int, int]] = []
    for c in range(1, w2 - 1):
        out.append((0, c, 1, random.choice([-1, 1])))
        out.append((h2 - 1, c, -1, random.choice([-1, 1])))
    for r in range(1, h2 - 1):
        out.append((r, 0, random.choice([-1, 1]), 1))
        out.append((r, w2 - 1, random.choice([-1, 1]), -1))
    random.shuffle(out)
    return out


def _too_close(p: tuple[int, int], states: list[tuple[int, int]]) -> bool:
    if not states:
        return False
    prev = states[-1]
    for q in states[:-1]:
        if max(abs(int(p[0]) - int(q[0])), abs(int(p[1]) - int(q[1]))) <= 1:
            return True
    return p == prev


def _walk_segment(
    states: list[tuple[int, int]], used: set[tuple[int, int]], cur: tuple[int, int], direction: tuple[int, int], seg_len: int, h2: int, w2: int
) -> list[tuple[int, int]] | None:
    dr, dc = direction
    added: list[tuple[int, int]] = []
    rr, cc = cur
    for _ in range(seg_len):
        rr += int(dr)
        cc += int(dc)
        p = (int(rr), int(cc))
        if not (0 <= p[0] < h2 and 0 <= p[1] < w2):
            return None
        if p in used or _too_close(p, states + added):
            return None
        added.append(p)
    return added


def _bounce_options(cur_dir: tuple[int, int]) -> list[tuple[int, int, str]]:
    dr, dc = cur_dir
    return [(-int(dr), int(dc), "row"), (int(dr), -int(dc), "col")]


def _plan_main_states(h2: int, w2: int) -> tuple[list[tuple[int, int]], list[tuple[int, str]], tuple[int, int]] | None:
    n_bounces = random.choices([1, 2, 3], weights=[2, 4, 3])[0]
    min_seg = 2
    max_seg = 5

    for sr, sc, dr0, dc0 in _candidate_starts(h2, w2)[:40]:
        states = [(int(sr), int(sc))]
        used = {(int(sr), int(sc))}
        cur = (int(sr), int(sc))
        cur_dir = (int(dr0), int(dc0))
        bounces: list[tuple[int, str]] = []
        ok = True

        for seg_idx in range(n_bounces + 1):
            remaining = n_bounces - seg_idx
            options = []
            for seg_len in range(max_seg, min_seg - 1, -1):
                added = _walk_segment(states, used, cur, cur_dir, seg_len, h2, w2)
                if added is None:
                    continue
                endpoint = added[-1]
                if remaining == 0:
                    options.append((seg_len, added, None))
                    continue
                future = []
                for ndr, ndc, axis in _bounce_options(cur_dir):
                    nxt = (int(endpoint[0] + ndr), int(endpoint[1] + ndc))
                    if not (0 <= nxt[0] < h2 and 0 <= nxt[1] < w2):
                        continue
                    future_states = states + added
                    if nxt in used or nxt in set(added) or _too_close(nxt, future_states):
                        continue
                    future.append((int(ndr), int(ndc), axis))
                if future:
                    options.append((seg_len, added, random.choice(future)))
            if not options:
                ok = False
                break

            _seg_len, added, bounce_choice = random.choice(options)
            for p in added:
                states.append(p)
                used.add(p)
            cur = states[-1]
            if bounce_choice is not None:
                ndr, ndc, axis = bounce_choice
                bounces.append((len(states) - 1, axis))
                cur_dir = (int(ndr), int(ndc))

        if ok and len(states) >= 7:
            return states, bounces, (int(dr0), int(dc0))
    return None


def _paint_states(grid: np.ndarray, states: list[tuple[int, int]], n: int, color: int) -> None:
    for r, c in states:
        grid[r : r + n, c : c + n] = int(color)


def _wall_cells_at(state: tuple[int, int], n: int, incoming_dir: tuple[int, int], axis: str, shape: tuple[int, int]) -> list[tuple[int, int]]:
    H, W = shape
    r, c = state
    dr, dc = incoming_dir
    cells: list[tuple[int, int]] = []
    if axis == "row":
        rr = r + n if dr == 1 else r - 1
        if 0 <= rr < H:
            for cc in range(c, c + n):
                if 0 <= cc < W:
                    cells.append((int(rr), int(cc)))
    else:
        cc = c + n if dc == 1 else c - 1
        if 0 <= cc < W:
            for rr in range(r, r + n):
                if 0 <= rr < H:
                    cells.append((int(rr), int(cc)))
    return cells


def _incoming_dirs(states: list[tuple[int, int]]) -> list[tuple[int, int] | None]:
    inc: list[tuple[int, int] | None] = [None]
    for i in range(1, len(states)):
        pr, pc = states[i - 1]
        r, c = states[i]
        inc.append((int(r - pr), int(c - pc)))
    return inc


def _feasible_state_set(grid: np.ndarray, n: int) -> set[tuple[int, int]]:
    feasible = _feasible_mask(grid, n)
    return {(int(r), int(c)) for r, c in np.argwhere(feasible)}


def _make_spur(
    main_states: list[tuple[int, int]], bounce_indices: set[int], h2: int, w2: int
) -> list[tuple[int, int]] | None:
    _ = bounce_indices
    used = set(main_states)
    for _attempt in range(120):
        length = random.randint(1, 3)
        direction = random.choice(_diag_dirs())

