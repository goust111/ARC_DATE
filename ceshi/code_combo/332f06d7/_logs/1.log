+        if any(grid[r, c] != int(_BG) for r, c in cells):
+            return None
+        if idx == omit_turn_idx:
+            continue
+        for r, c in cells:
+            grid[r, c] = int(_MIRROR)
+        mirrors_added += 1
+        if omit_turn_idx is None or idx < int(omit_turn_idx):
