+def _touch_col_mirror(grid: np.ndarray, r: int, c: int, n: int, dc: int) -> bool:
+    if dc == 1:
+        cc = c + n
+        return cc < grid.shape[1] and bool((grid[r : r + n, cc] == int(_MIRROR)).all())
+    cc = c - 1
+    return cc >= 0 and bool((grid[r : r + n, cc] == int(_MIRROR)).all())
