+
+        return {
+            "size": size,
+            "start": start,
+            "dest": dest,
+            "a": a,
+            "b": b,
+            "u1": u1,
+            "u2": u2,
+            "l1": l1,
+            "l2": l2,
+            "river": river,
+        }
+    return None
+
+
+def _available_pocket_len(size: int, gate: tuple[int, int], step: tuple[int, int], river: set[tuple[int, int]]) -> int:
+    count = 0
+    cur = gate
+    while count < 2:
+        cur = (cur[0] + step[0], cur[1] + step[1])
+        if not (0 <= cur[0] < size and 0 <= cur[1] < size):
+            break
+        if cur in river:
