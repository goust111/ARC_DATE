+        Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0]
+    )
+    mover = _find_single(g, _MOVER)
+    dest = _find_single(g, _DEST)
+    fixed = _sorted_coords(g == _FIXED)
+    pushes0 = _sorted_coords(g == _PUSH)
