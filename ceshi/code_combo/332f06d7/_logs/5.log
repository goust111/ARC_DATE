+    best_state = start_state
+    best_pos_dist = 0
+    seen_pos = {mover}
+    dest_state = None
+
+    while q:
+        state = q.popleft()
+        (mr, mc), pushes = state
+        cur_dist = dist[state]
+        if (mr, mc) == dest:
+            dest_state = state
+            break
