+    floor = {tuple(map(int, rc)) for rc in np.argwhere(g != bg)}
+    fixed_set = set(fixed)
+
+    start_state = (mover, pushes0)
+    q = deque([start_state])
+    dist = {start_state: 0}
+    best_state = start_state
+    best_pos_dist = 0
+    seen_pos = {mover}
+    dest_state = None
+
+    while q:
+        state = q.popleft()
+        (mr, mc), pushes = state
+        cur_dist = dist[state]
+        if (mr, mc) == dest:
+            dest_state = state
+            break
+
+        push_set = set(pushes)
+        for dr, dc in _DIR4:
+            nr, nc = mr + dr, mc + dc
+            nxt = (nr, nc)
+            if nxt not in floor or nxt in fixed_set:
+                continue
+
+            if nxt not in push_set:
+                new_state = (nxt, pushes)
+            else:
+                if not allow_push:
+                    continue
+                chain = []
+                cr, cc = nr, nc
+                while (cr, cc) in push_set:
+                    chain.append((cr, cc))
+                    cr += dr
+                    cc += dc
+                landing = (cr, cc)
+                if landing not in floor or landing in fixed_set or landing == dest:
+                    continue
