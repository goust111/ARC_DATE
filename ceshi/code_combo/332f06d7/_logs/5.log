+            if nxt not in push_set:
+                new_state = (nxt, pushes)
+            else:
+                if not allow_push:
+                    continue
+                chain = []
+                cr, cc = nr, nc
+                while (cr, cc) in push_set:
+                    chain.append((cr, cc))
+                    cr += dr
+                    cc += dc
+                landing = (cr, cc)
+                if landing not in floor or landing in fixed_set or landing == dest:
+                    continue
