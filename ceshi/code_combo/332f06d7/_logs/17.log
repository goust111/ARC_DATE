# Variant of 332f06d7
# Dimension: D7 — 网格输出形式 (grid_shape)
# Change: 输出与输入相同尺寸，仅移动方块位置变化... → 网格缩放

from __future__ import annotations

from collections import Counter, defaultdict, deque
import random

import numpy as np
from scipy.ndimage import label as scipy_label

from arc_utils import bbox_h, bbox_w, find_components


"""
Design analysis for the D7 variant
==================================

variant_spec:
  kept_from_original:
    - 输入仍是 10-20 的方形网格
    - 颜色角色不变: 背景=3, 河道=1, mover=0, destination=2
    - mover 与 destination 仍是同尺寸的实心 n×n 方块
    - 仍然先在 "可放置的 n×n top-left 网格" 上做 BFS
    - 仍然按原题规则决定 black 方块最终停在 destination 还是停在最远可达位置
  changed_dimension_D7:
    - 输出不再是原尺寸网格
    - 输出改为 mover 实际运动轨迹的缩小示意图
    - 轨迹先在 placement path 上抽取: 起点、每个转折点、终点
    - 再对这些点的行列坐标分别做坐标压缩
    - 每个转折点在输出中对应一个像素；相邻转折点之间用 1 像素宽折线连接
    - 输出保留背景色和河道色；最终停点用 mover 色覆盖

  concrete_visualization:
    input:
      - 大网格里有粗蓝色蜿蜒通道
      - 黑色 n×n 方块在通道一端，红色 n×n 方块在另一端或通道后段
    output:
      - 小网格，只保留 mover 实际运动过的折线路径
      - 直线长走廊被压缩，长距离不再按原长度保留
      - 只有转向结构和最终停点被保留
      - 因此人眼会看到“同一条路径的骨架图”

  behavior_trace_example:
    original:
      - 假设 feasible path 的 top-left 序列是
        [(9,8),(9,7),(9,6),(8,6),(7,6),(7,5),(7,4)]
      - 原题输出是在原网格把黑方块移到 (7,4)
    variant:
      - 先取转折点: [(9,8),(9,6),(7,6),(7,4)]
      - 压缩行坐标 {7,9}->{0,1}，列坐标 {4,6,8}->{0,1,2}
      - 得到缩小顶点 [(1,2),(1,1),(0,1),(0,0)]
      - 输出是一条小折线，终点像素涂成黑色
    difference:
      - 原题保留原始尺度与整块面积
      - 变体只保留路径拓扑和终点，删除绝对长度

  complexity_calibration:
    - 若输出只画单个黑点，变体太弱，因此生成器要求实际运动路径至少 2 次转向
    - 若压缩后路径仍接近原尺寸，D7 不明显，因此生成器额外要求输出严格小于输入
    - 不引入额外对象或颜色，避免把 D7 变成“新标记系统”任务

  implicit_assumption_review:
    - 原 solver 用实心同尺寸方块识别 mover/destination；该前提仍保留
    - 原 solver 依赖 mover/destination 颜色排序；生成器仍固定 mover=0, dest=2
    - 原 solver 的关键状态其实是 feasible top-left path，而不是粗河道像素本身；
      变体正是复用这一层状态来做压缩，所以 BFS 与 farthest-stop 逻辑可以原样保留
    - 原 solver 最后一段直接在原网格上覆盖 n×n 黑块，这个前提在 D7 中失效，
      必须替换为“从 reconstructed path 生成新网格”
    - 压缩渲染若采用“每段都缩成长度 1”的办法会制造新的自交；因此这里改为
      对转折点坐标做行/列坐标压缩，保持正交拓扑而不是只保留转向序列

  placement_legality:
    - 生成器仍使用原题的 output-first 风格通道生成法，保证 mover/destination 不越界
    - chokepoint 仍只出现在 n>=2 的 stuck 情况
    - 生成后必须满足:
      - mover 起点可放置
      - reached case: destination 可达
      - stuck case: destination 不可达，但存在更远的可达停止点
      - 压缩输出至少包含 4 个关键点(起点+终点+至少 2 个转折)

  visual_observability:
    - 2-4 个样例里，人眼可直接看到: 大蓝河道被转写成小蓝折线
    - 黑色最终停点仍保留，所以“滑到终点/卡住停下”仍然可见
    - 颜色含义没变，没有依赖不可见数值排序来决定输出几何

  cleanliness:
    - 输出只有背景/河道/终点黑点三层，不叠加大块对象，视觉比原图更干净
"""


_BG, _RIVER, _MOVER, _DEST = 3, 1, 0, 2
_DIR4 = [(1, 0), (-1, 0), (0, 1), (0, -1)]


def _detect_roles(g: np.ndarray) -> tuple[int, dict, dict, int]:
    bg = int(Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0])

    squares: list[dict] = []
    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict"):
        col = int(comp["color"])
        b = comp["bbox"]
        if bbox_h(b) != bbox_w(b):
            continue
        patch = g[int(b[0]): int(b[2]) + 1, int(b[1]): int(b[3]) + 1]
        if not bool((patch == col).all()):
            continue
        squares.append({"col": col, "r0": int(b[0]), "c0": int(b[1]), "n": int(bbox_h(b))})

    assert len(squares) >= 2

    by_n: dict[int, list[dict]] = defaultdict(list)
    for sq in squares:
        by_n[int(sq["n"])].append(sq)
    nside = max(by_n.items(), key=lambda kv: (len(kv[1]), kv[0]))[0]
    cand = by_n[int(nside)]
    assert len(cand) >= 2
    cand.sort(key=lambda s: int(s["col"]))
    mover = cand[0]
    dest = cand[1]

    counts = Counter(map(int, g.flatten()))
    river = None
    for col, _ct in counts.most_common():
        if int(col) == int(bg):
            continue
        if int(col) in (int(mover["col"]), int(dest["col"])):
            continue
        river = int(col)
        break
    assert river is not None
    return bg, mover, dest, river


def _bfs_with_parent(feasible: np.ndarray, sr: int, sc: int) -> tuple[np.ndarray, dict[tuple[int, int], tuple[int, int] | None]]:
    h2, w2 = feasible.shape
    dist = -np.ones((h2, w2), dtype=int)
    parent: dict[tuple[int, int], tuple[int, int] | None] = {(sr, sc): None}
    q = deque([(sr, sc)])
    dist[sr, sc] = 0
    while q:
        r, c = q.popleft()
        for dr, dc in _DIR4:
            rr, cc = r + dr, c + dc
            if 0 <= rr < h2 and 0 <= cc < w2 and bool(feasible[rr, cc]) and int(dist[rr, cc]) == -1:
                dist[rr, cc] = int(dist[r, c] + 1)
                parent[(rr, cc)] = (r, c)
                q.append((rr, cc))
    return dist, parent


def _reconstruct_path(parent: dict[tuple[int, int], tuple[int, int] | None], end: tuple[int, int]) -> list[tuple[int, int]]:
    path = []
    cur: tuple[int, int] | None = end
    while cur is not None:
        path.append(cur)
        cur = parent[cur]
    path.reverse()
    return path


def _simplify_turns(path: list[tuple[int, int]]) -> list[tuple[int, int]]:
    if len(path) <= 2:
        return list(path)

    out = [path[0]]
    for i in range(1, len(path) - 1):
        pr, pc = path[i - 1]
        cr, cc = path[i]
        nr, nc = path[i + 1]
        d1 = (cr - pr, cc - pc)
        d2 = (nr - cr, nc - cc)
        if d1 != d2:
            out.append((cr, cc))
    out.append(path[-1])
    return out


def _compress_turn_coords(turns: list[tuple[int, int]]) -> list[tuple[int, int]]:
    rows = sorted({r for r, _c in turns})
    cols = sorted({c for _r, c in turns})
    r_map = {r: i for i, r in enumerate(rows)}
    c_map = {c: i for i, c in enumerate(cols)}
    return [(r_map[r], c_map[c]) for r, c in turns]


def _render_compressed_path(bg: int, river: int, mover_col: int, turns: list[tuple[int, int]]) -> np.ndarray:
    pts = _compress_turn_coords(turns)
    H = max(r for r, _c in pts) + 1
    W = max(c for _r, c in pts) + 1
    out = np.full((H, W), bg, dtype=int)
    for (r1, c1), (r2, c2) in zip(pts, pts[1:]):
        if r1 == r2:
            c_lo, c_hi = sorted((c1, c2))
            out[r1, c_lo:c_hi + 1] = river
        else:
            r_lo, r_hi = sorted((r1, r2))
            out[r_lo:r_hi + 1, c1] = river
    if len(pts) == 1:
        out[pts[0]] = river
    out[pts[-1]] = mover_col
    return out


def _solve_core(grid: np.ndarray) -> dict:
    g = np.array(grid, dtype=int)
    H, W = g.shape
    bg, mover, dest, river = _detect_roles(g)

    n = int(mover["n"])
    sr, sc = int(mover["r0"]), int(mover["c0"])
    dr, dc = int(dest["r0"]), int(dest["c0"])

    trav = (g == int(river)) | (g == int(mover["col"])) | (g == int(dest["col"]))
    h2 = int(H - n + 1)
    w2 = int(W - n + 1)
    assert h2 > 0 and w2 > 0
    assert 0 <= sr < h2 and 0 <= sc < w2

    feasible = np.zeros((h2, w2), dtype=bool)
    for r in range(h2):
        for c in range(w2):
            if bool(trav[r:r + n, c:c + n].all()):
                feasible[r, c] = True
    assert bool(feasible[sr, sc])

    dist, parent = _bfs_with_parent(feasible, sr, sc)

    if 0 <= dr < h2 and 0 <= dc < w2 and bool(feasible[dr, dc]) and int(dist[dr, dc]) >= 0:
        tr, tc = dr, dc
        reached = True
    else:
        reached = False
        best = -1
        tr, tc = sr, sc
        for r in range(h2):
            for c in range(w2):
                if int(dist[r, c]) > best:
                    best = int(dist[r, c])
                    tr, tc = r, c

    path = _reconstruct_path(parent, (tr, tc))
    turns = _simplify_turns(path)
    return {
        "bg": bg,
        "river": river,
        "mover_col": int(mover["col"]),
        "dest_col": int(dest["col"]),
        "n": n,
        "start": (sr, sc),
        "dest": (dr, dc),
        "target": (tr, tc),
        "reached": reached,
        "feasible": feasible,
        "dist": dist,
        "path": path,
        "turns": turns,
    }


def main(grid: np.ndarray) -> np.ndarray:
    """
    Variant rule:
    1. Solve the original sliding problem on the feasible-placement grid.
    2. Reconstruct the mover's actual shortest motion path to its final stop.
    3. Keep only start/end/turning points.
    4. Compress those turning-point coordinates into a smaller orthogonal diagram.
    5. Draw the compressed trajectory in river color and overwrite the final stop in mover color.
    """
    info = _solve_core(np.array(grid, dtype=int))
    return _render_compressed_path(info["bg"], info["river"], info["mover_col"], info["turns"])


def _bfs_placement(feasible: np.ndarray, sr: int, sc: int) -> np.ndarray:
    dist = -np.ones(feasible.shape, dtype=int)
    dist[sr, sc] = 0
    q = deque([(sr, sc)])
    while q:
        r, c = q.popleft()
        for dr, dc in _DIR4:
            rr, cc = r + dr, c + dc
            if 0 <= rr < feasible.shape[0] and 0 <= cc < feasible.shape[1] and feasible[rr, cc] and dist[rr, cc] == -1:
                dist[rr, cc] = dist[r, c] + 1
                q.append((rr, cc))
    return dist


def _hamiltonian_walk(rows: int, cols: int, start: tuple[int, int], end: tuple[int, int]) -> list[tuple[int, int]] | None:
    total = rows * cols
    best_path = None
    best_len = 0
    for _attempt in range(80):
        visited = {start}
        path = [start]
        cur = start
        while True:
            if cur == end and len(path) >= total * 0.7:
                if len(path) > best_len:
                    best_path = list(path)
                    best_len = len(path)
                break
            neighbors = []
            for dr, dc in _DIR4:
                nr, nc = cur[0] + dr, cur[1] + dc
                if 0 <= nr < rows and 0 <= nc < cols and (nr, nc) not in visited:
                    neighbors.append((nr, nc))
            if not neighbors:
                break
            valid = []
            for nb in neighbors:
                if nb == end:
                    valid.append(nb)
                    continue
                test_visited = visited | {nb}
                seen = {end}
                q = deque([end])
                while q:
                    cr, cc = q.popleft()
                    for dr2, dc2 in _DIR4:
                        nr2, nc2 = cr + dr2, cc + dc2
                        if 0 <= nr2 < rows and 0 <= nc2 < cols and (nr2, nc2) not in test_visited and (nr2, nc2) not in seen:
                            seen.add((nr2, nc2))
                            q.append((nr2, nc2))
                for dr2, dc2 in _DIR4:
                    ar, ac = nb[0] + dr2, nb[1] + dc2
                    if 0 <= ar < rows and 0 <= ac < cols and (ar, ac) not in test_visited and (ar, ac) in seen:
                        valid.append(nb)
                        break
            if not valid:
                break
            random.shuffle(valid)
            nxt = valid[0]
            visited.add(nxt)
            path.append(nxt)
            cur = nxt
        if best_path and best_len >= total * 0.85:
            break
    return best_path


def _render_channel(grid: np.ndarray, path: list[tuple[int, int]], n: int, offsets_r: list[int], offsets_c: list[int]) -> list[tuple[int, int]]:
    pixel_pos = []
    for cr, cc in path:
        pr, pc = offsets_r[cr], offsets_c[cc]
        pixel_pos.append((pr, pc))
        grid[pr:pr + n, pc:pc + n] = _RIVER
    for i in range(len(path) - 1):
        pr1, pc1 = pixel_pos[i]
        pr2, pc2 = pixel_pos[i + 1]
        if pr1 == pr2:
            c_lo, c_hi = min(pc1, pc2), max(pc1, pc2) + n
            grid[pr1:pr1 + n, c_lo:c_hi] = _RIVER
        else:
            r_lo, r_hi = min(pr1, pr2), max(pr1, pr2) + n
            grid[r_lo:r_hi, pc1:pc1 + n] = _RIVER
    return pixel_pos


def _add_chokepoint(grid: np.ndarray, pixel_pos_i: tuple[int, int], pixel_pos_j: tuple[int, int], n: int, direction: str) -> None:
    H, W = grid.shape
    pr1, pc1 = pixel_pos_i
    pr2, pc2 = pixel_pos_j
    narrow_w = random.randint(1, n - 1)
    remove = n - narrow_w
    side = random.randint(0, 1)

    if direction == "h":
        c_lo = min(pc1, pc2) + n
        c_hi = max(pc1, pc2)
        if c_hi <= c_lo:
            c_lo, c_hi = min(pc1, pc2), max(pc1, pc2) + n
        hold_len = random.randint(1, min(6, max(1, c_hi - c_lo - 2 * remove)))
        total_len = 2 * remove + hold_len
        c_mid = (c_lo + c_hi) // 2
        c_start = max(c_lo, c_mid - total_len // 2)
        for step in range(total_len):
            c = c_start + step
            if not (0 <= c < W):
                continue
            if step < remove:
                depth = step + 1
            elif step >= total_len - remove:
                depth = total_len - step
            else:
                depth = remove
            for k in range(depth):
                rr = pr1 + k if side == 0 else pr1 + n - 1 - k
                if 0 <= rr < H:
                    grid[rr, c] = _BG
    else:
        r_lo = min(pr1, pr2) + n
        r_hi = max(pr1, pr2)
        if r_hi <= r_lo:
            r_lo, r_hi = min(pr1, pr2), max(pr1, pr2) + n
        hold_len = random.randint(1, min(6, max(1, r_hi - r_lo - 2 * remove)))
        total_len = 2 * remove + hold_len
        r_mid = (r_lo + r_hi) // 2
        r_start = max(r_lo, r_mid - total_len // 2)
        for step in range(total_len):
            r = r_start + step
            if not (0 <= r < H):
                continue
            if step < remove:
                depth = step + 1
            elif step >= total_len - remove:
                depth = total_len - step
            else:
                depth = remove
            for k in range(depth):
                cc = pc1 + k if side == 0 else pc1 + n - 1 - k
                if 0 <= cc < W:
                    grid[r, cc] = _BG


def _river_connected(grid: np.ndarray) -> bool:
    mask = (grid == _RIVER) | (grid == _MOVER) | (grid == _DEST)
    if not mask.any():
        return False
    _labeled, num = scipy_label(mask.astype(int))

