# Variant of 332f06d7
# Dimension: D15 — 通道转折规则 (path)
# Change: 通道至少有3次方向转折，路径在粗网格上通过随机行走生成... → 图例控制转向

from __future__ import annotations

from collections import Counter, defaultdict
import random

import numpy as np

from arc_utils import bbox_h, bbox_w, find_components


# Design analysis for the D15 variant
# ----------------------------------
# spec_variant:
#   core idea:
#     - Keep the original object vocabulary: green background, blue river, black mover square,
#       red destination square, same-size solid squares, mover origin becomes river in output.
#     - Replace "the river geometry itself tells you where to turn" with a symbolic rule:
#       a grey legend strip on the top edge says whether each obstacle color means
#       clockwise or counterclockwise turning.
#   concrete pixel structure:
#     - The top 2 rows are a dedicated legend region with grey background (5).
#     - Each legend entry uses exactly two same-colored pixels:
#         row 0: one anchor pixel
#         row 1: one pixel shifted left  -> this color means CCW
#         row 1: one pixel shifted right -> this color means CW
#     - The playfield below still contains a blue corridor and the black/red n x n squares.
#     - At each turning site the corridor becomes a T-junction:
#         straight ahead is blocked by a 1-pixel-thick colored strip,
#         left and right branches are both visible,
#         the legend decides which branch the mover takes.
#   behavior trace:
#     - Original:
#         a winding blue path already contains the bends, so BFS on feasible n x n placements
#         can recover the final position without reading any extra symbol.
#     - Variant:
#         the blue river alone is ambiguous at turns because both side branches are present.
#         When the mover reaches a dead-end wall, it reads the wall's color, consults the top
#         legend, rotates its direction CW/CCW, and continues along that chosen branch.
#         If it later meets a narrowed gate (< n wide), it stops at the farthest feasible
#         placement before that gate, as in the original task.
#     - Difference:
#         path geometry no longer fully determines motion; the legend mediates every bend.
#   complexity calibration:
#     - Use exactly two obstacle colors per sample, one mapped to CW and one to CCW.
#       Both colors are reused across multiple turns, so the mapping has repeated evidence.
#     - Every generated sample has 3-5 turn events, so the new behavior is visually salient.
#     - Each turn shows both side branches, preventing degeneration back to a single obvious path.
#   implicit assumptions review for main():
#     - The original code assumes the largest non-bg non-square color is the river.
#       That still works after cropping away the legend because obstacle strips are thin and
#       river area dominates; generator enforces that.
#     - The original BFS assumes all choices are encoded by pure geometry.
#       That no longer holds, so main() must simulate directional motion with turn-state.
#     - New assumption: the legend occupies the top 2 rows and grey (5) is reserved for it.
#       Generator guarantees grey never appears in the playfield.
#     - New assumption: the mover's start cell has a unique outgoing feasible direction.
#       Generator constructs the start as a corridor endpoint.
#     - New assumption: when forward motion is blocked at a turn site, the blocking face has
#       exactly one non-river control color. Generator uses one colored strip per turn wall.
#   placement legality:
#     - Coarse nodes are laid out on a regular lattice with gaps >= n+2, so separate branches
#       do not accidentally merge when rendered as n-wide corridors.
#     - Decoy branches are only one coarse step long and are reserved during route construction
#       to avoid overlaps with the main route.
#     - Chokepoints are inserted only on a straight tail segment with enough pixel length.
#   visual observability:
#     - The legend is a dedicated top-edge strip and remains unchanged in the output.
#     - The same colors appear in the legend and on the turning walls, giving direct support
#       for the symbolic mapping from color to turn direction.
#     - Because both branches at each turn are visibly open, a solver must explain why the mover
#       chose one branch rather than the other; that explanation is exactly the legend.
#   cleanliness:
#     - The legend is isolated from the playfield.
#     - Obstacles are thin strips at corridor ends rather than overlapping blobs.
#     - Only two extra colors are introduced, keeping the scene readable.
#   color inference:
#     - No ordering depends on numeric color ids. The legend explicitly states the mapping.
#     - The generator shuffles which obstacle color is CW vs CCW across samples, so the solver
#       cannot rely on fixed color semantics.


LEGEND_H = 2
LEGEND_BG = 5

_BG, _RIVER, _MOVER, _DEST = 3, 1, 0, 2
_TURN_COLORS = (4, 6)

_DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]  # U, R, D, L


def _rot_cw(d: int) -> int:
    return (d + 1) % 4


def _rot_ccw(d: int) -> int:
    return (d - 1) % 4


def _parse_legend(grid: np.ndarray) -> dict[int, str]:
    legend = np.array(grid[:LEGEND_H, :], dtype=int)
    turn_by_color: dict[int, str] = {}
    for col in sorted(set(map(int, legend.flatten()))):
        if int(col) == LEGEND_BG:
            continue
        pts = np.argwhere(legend == int(col))
        if len(pts) != 2:
            continue
        top = [p for p in pts if int(p[0]) == 0]
        bot = [p for p in pts if int(p[0]) == 1]
        if len(top) != 1 or len(bot) != 1:
            continue
        turn_by_color[int(col)] = "ccw" if int(bot[0][1]) < int(top[0][1]) else "cw"
    return turn_by_color


def _detect_squares(g: np.ndarray, bg: int) -> list[dict]:
    squares: list[dict] = []
    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict"):
        col = int(comp["color"])
        b = comp["bbox"]
        if bbox_h(b) != bbox_w(b):
            continue
        patch = g[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1]
        if not bool((patch == int(col)).all()):
            continue
        squares.append({"col": int(col), "r0": int(b[0]), "c0": int(b[1]), "n": int(bbox_h(b))})
    return squares


def _infer_roles(core: np.ndarray) -> tuple[int, dict, dict]:
    bg = int(Counter([int(core[0, 0]), int(core[0, -1]), int(core[-1, 0]), int(core[-1, -1])]).most_common(1)[0][0])
    squares = _detect_squares(core, bg=bg)
    assert not (len(squares) < 2)

    by_n: dict[int, list[dict]] = defaultdict(list)
    for sq in squares:
        by_n[int(sq["n"])].append(sq)
    nside = max(by_n.items(), key=lambda kv: (len(kv[1]), kv[0]))[0]
    cand = by_n[int(nside)]
    assert not (len(cand) < 2)

    cand.sort(key=lambda s: int(s["col"]))
    mover = cand[0]
    dest = cand[1]
    return bg, mover, dest


def _infer_river(core: np.ndarray, bg: int, mover_col: int, dest_col: int) -> int:
    counts = Counter(map(int, core.flatten()))
    for col, _ct in counts.most_common():
        if int(col) in (int(bg), int(mover_col), int(dest_col)):
            continue
        return int(col)
    raise AssertionError("river not found")


def _feasible_mask(core: np.ndarray, river: int, mover_col: int, dest_col: int, n: int) -> np.ndarray:
    trav = (core == int(river)) | (core == int(mover_col)) | (core == int(dest_col))
    h2 = int(core.shape[0] - n + 1)
    w2 = int(core.shape[1] - n + 1)
    assert not (h2 <= 0 or w2 <= 0)
    feasible = np.zeros((h2, w2), dtype=bool)
    for r in range(h2):
        for c in range(w2):
            if bool(trav[int(r) : int(r + n), int(c) : int(c + n)].all()):
                feasible[int(r), int(c)] = True
    return feasible


def _start_direction(feasible: np.ndarray, sr: int, sc: int) -> int:
    dirs = []
    for d, (dr, dc) in enumerate(_DIRS):
        rr, cc = int(sr + dr), int(sc + dc)
        if 0 <= rr < feasible.shape[0] and 0 <= cc < feasible.shape[1] and bool(feasible[rr, cc]):
            dirs.append(d)
    assert not (len(dirs) != 1)
    return int(dirs[0])


def _obstacle_color_ahead(
    core: np.ndarray,
    r: int,
    c: int,
    d: int,
    n: int,
    ignore: set[int],
) -> int | None:
    h, w = core.shape
    if d == 0:
        if r - 1 < 0:
            return None
        strip = core[int(r - 1), int(c) : int(c + n)]
    elif d == 1:
        if c + n >= w:
            return None
        strip = core[int(r) : int(r + n), int(c + n)]
    elif d == 2:
        if r + n >= h:
            return None
        strip = core[int(r + n), int(c) : int(c + n)]
    else:
        if c - 1 < 0:
            return None
        strip = core[int(r) : int(r + n), int(c - 1)]
    cols = {int(x) for x in np.array(strip).flatten() if int(x) not in ignore}
    if len(cols) != 1:
        return None
    return int(next(iter(cols)))


def _simulate(core: np.ndarray, turn_by_color: dict[int, str], mover: dict, dest: dict) -> tuple[int, int]:
    bg = int(Counter([int(core[0, 0]), int(core[0, -1]), int(core[-1, 0]), int(core[-1, -1])]).most_common(1)[0][0])
    n = int(mover["n"])
    sr, sc = int(mover["r0"]), int(mover["c0"])
    dr, dc = int(dest["r0"]), int(dest["c0"])
    river = _infer_river(core, bg=bg, mover_col=int(mover["col"]), dest_col=int(dest["col"]))
    feasible = _feasible_mask(core, river=river, mover_col=int(mover["col"]), dest_col=int(dest["col"]), n=n)
    assert not (not bool(feasible[int(sr), int(sc)]))

    d = _start_direction(feasible, sr=sr, sc=sc)
    r, c = int(sr), int(sc)
    ignore = {int(bg), int(river), int(mover["col"]), int(dest["col"])}
    seen: set[tuple[int, int, int]] = set()

    for _ in range(core.shape[0] * core.shape[1] * 8):
        if (int(r), int(c)) == (int(dr), int(dc)):
            break
        state = (int(r), int(c), int(d))
        if state in seen:
            break
        seen.add(state)

        dr0, dc0 = _DIRS[int(d)]
        rr, cc = int(r + dr0), int(c + dc0)
        if 0 <= rr < feasible.shape[0] and 0 <= cc < feasible.shape[1] and bool(feasible[rr, cc]):
            r, c = int(rr), int(cc)
            continue

        wall_col = _obstacle_color_ahead(core, r=r, c=c, d=d, n=n, ignore=ignore)
        if wall_col is None:
            break
        turn = turn_by_color.get(int(wall_col))
        if turn is None:
            break

        nd = _rot_cw(d) if turn == "cw" else _rot_ccw(d)
        dr1, dc1 = _DIRS[int(nd)]
        rr, cc = int(r + dr1), int(c + dc1)
        if 0 <= rr < feasible.shape[0] and 0 <= cc < feasible.shape[1] and bool(feasible[rr, cc]):
            r, c, d = int(rr), int(cc), int(nd)
            continue
        break

    return int(r), int(c)



