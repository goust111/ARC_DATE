# Variant of 332f06d7
# Dimension: D1 — 路径结构：蜿蜒走廊 vs 其他路径形态 (path)
# Change: 蜿蜒的水道走廊(corridor_following)，通道宽度可变，方块沿通道BFS滑行... → 螺旋路径

from __future__ import annotations

from collections import Counter, defaultdict, deque
import random

import numpy as np

from arc_utils import bbox_h, bbox_w, find_components

# Design analysis for the D1/path variant
# =======================================
# a) Concrete form and behavior trace
#    - Input still has exactly one background color, one blue traversable region, one black solid n×n mover,
#      and one red solid n×n destination of the same size.
#    - The key geometric change is that the blue region is no longer an arbitrary winding corridor. It is a
#      canonical clockwise spiral with a one-cell gap between adjacent arms, rendered as an n-pixel-thick band
#      because each top-left placement on the spiral paints an n×n river window.
#    - The mover and destination sit on two cells of that spiral sequence. Some examples go outer→inner,
#      others inner→outer, so the visible black square can start near the border or near the spiral core.
#    - Reachable case: every next spiral placement from mover toward destination remains feasible, so black
#      walks the whole spiral subsequence and covers red.
#    - Stuck case: one later step of the spiral is narrowed below n by carving the entering edge of the next
#      placement. The downstream red square still exists visually, but the next spiral placement becomes
#      infeasible; black stops at the previous spiral cell. A side pocket is added near the gate so generic BFS
#      would have an off-path option, but the spiral-following rule ignores it.
#    - Small trace:
#      original task at the critical step:
#        feasible positions = all n×n windows fully inside the river, BFS may move into any reachable window;
#        when blocked, it picks the globally farthest reachable window.
#      variant task at the critical step:
#        compute the canonical spiral order for the traversable bounding box; only the ordered cells between
#        mover and destination matter. If the next ordered cell is infeasible, stop immediately on the current
#        ordered cell even if a side pocket is reachable.
#      difference:
#        path geometry changes from free-form corridor to spiral, and the stopping rule is tied to spiral order
#        instead of unrestricted BFS over the whole feasible set.
# b) Complexity calibration
#    - The spiral uses a fixed clockwise turning rule and one-cell arm spacing. That is visually strong enough
#      to distinguish from the original meander, but still simple enough for 2-4 ARC examples.
#    - Only two scenario branches remain: reachable and stuck. The only extra variability is direction
#      (outer→inner vs inner→outer), which is directly visible from where black and red are placed.
#    - Pocket cells are used only in stuck cases and only as a local bulge; they do not add a second hidden
#      rule, they merely prevent degeneration to the original BFS behavior.
# c) Old implicit assumptions that break
#    - Original `main()` assumes the river can be summarized by an unrestricted feasible-placement graph.
#      That no longer holds; extra reachable pocket windows must be ignored.
#    - Original target selection "global farthest reachable placement" also no longer matches the variant.
#      The correct stop is the last feasible cell on the mover→dest spiral subsequence.
#    - Square detection by color ordering remains safe because the task still uses exactly two same-sized solid
#      colored squares and the generator preserves `mover color < dest color`.
# d) Placement legality
#    - The generator works in placement-coordinate space first. It chooses a spiral box inset from the grid
#      border, paints all spiral windows, and then places mover/destination on two spiral cells, so overlap and
#      bounds are controlled before rasterization.
#    - Stuck cases carve only the leading row/column of one downstream placement, which preserves the upstream
#      cell while invalidating the next spiral step.
#    - Pockets are only inserted on interior spiral cells whose extra adjacent placement has exactly one spiral
#      neighbor, preventing accidental shortcuts or bbox growth.
# e) Visual observability
#    - Humans can read the rule from a few examples: the blue region is a rectangular spiral; black progresses
#      along that spiral toward red; in blocked examples it halts right before a narrowed turn/segment.
#    - The movement direction is visible because one endpoint is near the outer rim and the other near the core.
#      No invisible color ranking or arbitrary coordinate ordering is needed for inference.
# f) Visual cleanliness
#    - The spiral is the only large blue structure. The two squares are solid and high-contrast.
#    - Pockets are small local widenings rather than separate objects, so the grid still reads as one coherent
#      spiral river instead of a noisy maze.
# g) Color-change inference
#    - Colors keep their original roles: green background, blue path, black mover, red destination. No new
#      color mapping is introduced.
# Source-task check
#    - The prompt names `da515329` as the spiral reference. I searched the current workspace for a readable
#      solver source file and only found the JSON data/examples, not a `da515329.py` solver implementation.
#      The implementation below therefore uses the observable "clockwise inward spiral with 90-degree turns and
#      one-cell spacing" as the minimal borrowed mechanism and does not import any other variant behavior.


_BG, _RIVER, _MOVER, _DEST = 3, 1, 0, 2
_DIR4 = [(1, 0), (-1, 0), (0, 1), (0, -1)]


def _find_squares(g: np.ndarray, bg: int) -> list[dict]:
    squares: list[dict] = []
    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict"):
        col = int(comp["color"])
        b = comp["bbox"]
        if bbox_h(b) != bbox_w(b):
            continue
        patch = g[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1]
        if not bool((patch == col).all()):
            continue
        squares.append({"col": col, "r0": int(b[0]), "c0": int(b[1]), "n": int(bbox_h(b))})
    return squares


def _feasible_windows(trav: np.ndarray, n: int) -> np.ndarray:
    H, W = trav.shape
    h2, w2 = H - n + 1, W - n + 1
    feasible = np.zeros((h2, w2), dtype=bool)
    for r in range(h2):
        for c in range(w2):
            feasible[r, c] = bool(trav[r : r + n, c : c + n].all())
    return feasible


def _spiral_path(rows: int, cols: int, top: int = 0, left: int = 0) -> list[tuple[int, int]]:
    used = np.zeros((rows, cols), dtype=bool)
    dirs = [(0, 1), (1, 0), (0, -1), (-1, 0)]
    path: list[tuple[int, int]] = []
    d = 0
    r = 0
    c = 0
    while True:
        path.append((top + r, left + c))
        used[r, c] = True
        moved = False
        for turn in range(4):
            nd = (d + turn) % 4
            dr, dc = dirs[nd]
            nr, nc = r + dr, c + dc
            if not (0 <= nr < rows and 0 <= nc < cols) or bool(used[nr, nc]):
                continue
            blocked = False
            for adr, adc in dirs:
                ar, ac = nr + adr, nc + adc
                if 0 <= ar < rows and 0 <= ac < cols and bool(used[ar, ac]) and (ar, ac) != (r, c):
                    blocked = True
                    break
            if blocked:
                continue
            d = nd
            r, c = nr, nc
            moved = True
            break
        if not moved:
            break
    return path


def _placement_box_from_traversable(trav: np.ndarray, n: int) -> tuple[int, int, int, int]:
    rs, cs = np.where(trav)
    assert not (len(rs) == 0)
    r0 = int(rs.min())
    c0 = int(cs.min())
    rows = int(rs.max() - rs.min() - n + 2)
    cols = int(cs.max() - cs.min() - n + 2)
    assert not (rows <= 0 or cols <= 0)
    return r0, c0, rows, cols


def _follow_spiral_path(
    feasible: np.ndarray,
    path: list[tuple[int, int]],
    mover_pos: tuple[int, int],
    dest_pos: tuple[int, int],
) -> tuple[int, int]:
    index = {pos: i for i, pos in enumerate(path)}
    assert not (mover_pos not in index or dest_pos not in index)
    s_idx = int(index[mover_pos])
    d_idx = int(index[dest_pos])
    step = 1 if d_idx >= s_idx else -1
    cur_idx = s_idx
    while cur_idx != d_idx:
        nxt_idx = cur_idx + step
        nr, nc = path[nxt_idx]
        if not (0 <= nr < feasible.shape[0] and 0 <= nc < feasible.shape[1] and bool(feasible[nr, nc])):
            break
        cur_idx = nxt_idx
    return path[cur_idx]


def main(grid: np.ndarray) -> np.ndarray:
    g = np.array(grid, dtype=int)
    bg = int(Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0])

    squares = _find_squares(g, bg)
    assert not (len(squares) < 2)

    by_n: dict[int, list[dict]] = defaultdict(list)
    for s in squares:
        by_n[int(s["n"])].append(s)
