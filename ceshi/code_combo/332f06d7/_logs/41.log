   473	            if side_options:
   474	                other_side = random.choice(side_options)
   475	                other_avail = mover_r if other_side < 0 else H - (mover_r + n)
   476	                other_len = random.randint(2, min(other_avail, 4))
   477	                _paint_branch(grid, "h", mover_r, 0, other_c, other_len, other_side, n)
   478	                extra_branch = ("v", other_c, mover_r, other_side, other_len)
   479	
