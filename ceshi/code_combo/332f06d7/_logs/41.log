   496	
   497	    else:
   498	        positive = random.choice([True, False])
   499	        step = 1 if positive else -1
   500	
   501	        mover_r = random.randint(1, 2) if positive else H - n - random.randint(1, 2)
   502	        dest_r = H - n if positive else 0
   503	        total_steps = abs(dest_r - mover_r)
   504	        if total_steps < 7:
