    info = _placement_info(np.array(grid, dtype=int), obstacle_passable=False)
    g = info["grid"]
    n = int(info["n"])
    sr, sc = int(info["sr"]), int(info["sc"])
    tr, tc = int(info["tr"]), int(info["tc"])
    river = int(info["river"])
    mover_col = int(info["mover"]["col"])

    out = g.copy()
    out[sr : sr + n, sc : sc + n] = river
    out[tr : tr + n, tc : tc + n] = mover_col
    return out


def _compute_offsets(G: int, n: int, num_coarse: int, slack: int) -> list[int] | None:
    if num_coarse == 1:
        return [slack + 1]
    first = slack + 1
    last = G - n - slack - 1
    if last < first:
        return None
    step = (last - first) / (num_coarse - 1)
    return [int(round(first + i * step)) for i in range(num_coarse)]


