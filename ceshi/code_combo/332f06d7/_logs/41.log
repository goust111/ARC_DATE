+    tr, tc = int(sr), int(sc)
+    while True:
+        nr = int(tr + step_r)
+        nc = int(tc + step_c)
+        if not _window_ok(trav, nr, nc, n):
+            break
+        tr, tc = int(nr), int(nc)
+        if tr == int(dr) and tc == int(dc):
