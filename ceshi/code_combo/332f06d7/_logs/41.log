+
+def _ray_direction(sr: int, sc: int, dr: int, dc: int) -> tuple[int, int]:
+    if sr == dr and sc != dc:
+        return 0, 1 if dc > sc else -1
+    if sc == dc and sr != dr:
+        return 1 if dr > sr else -1, 0
+    raise AssertionError("mover and destination must align on exactly one axis")
+
