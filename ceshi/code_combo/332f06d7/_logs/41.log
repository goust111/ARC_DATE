+def _ray_terminal(trav: np.ndarray, sr: int, sc: int, dr: int, dc: int, n: int) -> tuple[int, int]:
+    assert _window_ok(trav, sr, sc, n)
+    step_r, step_c = _ray_direction(sr, sc, dr, dc)
