+    if reached:
+        output = grid.copy()
+        output[mover_r : mover_r + n, mover_c : mover_c + n] = _RIVER
+        output[dest_r : dest_r + n, dest_c : dest_c + n] = _RIVER
+    else:
+        output = grid.copy()
+
+    if not np.array_equal(main(grid), output):
+        return None
+    return grid
+
+
+def generate_input():
+    for _ in range(300):
+        result = _gen_attempt()
+        if result is not None:
