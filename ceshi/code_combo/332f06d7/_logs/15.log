# Variant of 332f06d7
# Dimension: D6 — 到达时的变换：覆盖/重着色/消除 (transform)
# Change: 可达时移动体覆盖目标位置(目标消失)，原位置恢复为河流色；不可达时移动体停在最远位置，原位置恢复为河流色... → 消除——两者都消失

from __future__ import annotations

from collections import Counter, defaultdict, deque
import random

import numpy as np
from scipy.ndimage import label as scipy_label

from arc_utils import bbox_h, bbox_w, find_components


"""
Design analysis for the D6 variant
==================================

variant_spec:
  task_family: sliding n×n square through a blue winding river
  preserved_structure:
    - square grid, size 10..20
    - background is green and dominates the four corners
    - river is blue and forms one connected winding corridor
    - mover is a solid black n×n square
    - destination is a solid red n×n square of the same size
    - movement rule is unchanged: BFS over feasible n×n placements inside {river,mover,dest}
    - stuck cases still use a sub-n chokepoint so the square halts at the farthest reachable placement
  changed_structure:
    - reachable case no longer ends with black covering red
    - instead, when mover reaches the destination, both n×n squares are erased to river color
    - because the path between start and destination is already blue, the full corridor becomes pure blue

  concrete_behavior_trace:
    - original reachable example:
      input has black 2×2 on one end of the blue river and red 2×2 on the other end
      BFS reaches the red top-left placement
      output paints start 2×2 blue and destination 2×2 black
    - new reachable example:
      same BFS result
      output paints start 2×2 blue and destination 2×2 blue
      visible effect: both black and red disappear; only green background and blue river remain
    - stuck example:
      BFS cannot reach red because some river cross-section is narrower than n
      output still paints start blue and farthest reachable placement black
      red remains untouched
    - difference location:
      only the final rendering branch changes when chosen target == destination and destination is reachable

  complexity_calibration:
    - this is not a trivial no-op because reachable outputs now lose two salient objects at once
    - stuck and reachable examples remain visually distinct:
      reachable -> no black/red remain
      stuck -> both black and red remain, with black advanced along the river
    - color roles stay low-entropy and human-visible; no invisible ordering rule is introduced
    - generator should keep both branches appearing often enough so a solver can infer "collision causes erasure"

  implicit_assumption_audit_main:
    - square detection still assumes both special objects are solid monochromatic squares; generator preserves this
    - choosing mover/dest by ascending color is still safe because colors remain fixed at black=0, red=2
      and no extra same-sized solid non-bg squares are generated
    - river detection as the most common non-bg, non-square color still holds because only blue fills the corridor
    - feasibility windows on {river,mover,dest} remain correct because the motion geometry is unchanged
    - the original unconditional final write
        out[tr:tr+n, tc:tc+n] = mover_color
      relied on the old invariant "reachable means mover occupies destination in output"
      this is false in the variant, so rendering must branch on reachability
    - in stuck cases the old write remains valid

  placement_legality:
    - generator still ensures start and destination are non-overlapping n×n squares inside the river envelope
    - destination reaches a boundary edge; mover stays near an edge but not touching, matching the original look
    - chokepoints are only inserted after carving the river and before placing colored squares
    - oracle validation uses the new main(), so any illegal geometry is rejected

  visual_observability:
    - across 2-4 examples, humans can spot the new rule because some pairs will show total disappearance at contact
      while others show incomplete travel with both objects still visible
    - the "entire channel becomes blue" effect is especially clear because the red end-cap vanishes too

  cleanliness:
    - no extra markers are added
    - the corridor stays the only blue structure, so reachable outputs are visually simpler, not noisier

  new_solver_assumptions_to_enforce_in_generator:
    - at least one non-bg color besides mover and dest must be present, so river color can be inferred
    - if a sample is labeled reachable, destination placement must be BFS-reachable
    - if a sample is labeled stuck, destination placement must be unreachable and some other feasible placement exists
"""


def main(grid: np.ndarray) -> np.ndarray:
    """
    Slide a solid square through a winding channel toward a same-sized target square.

    D6 variant:
    - If the destination placement is reachable, the mover and destination annihilate each other:
      both become river color.
    - If unreachable, the mover stops at the farthest reachable placement as before.
    """
    g = np.array(grid, dtype=int)
    H, W = g.shape

    bg = int(
        Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])])
        .most_common(1)[0][0]
    )

    squares: list[dict] = []
    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict"):
        col = int(comp["color"])
        b = comp["bbox"]
        if bbox_h(b) != bbox_w(b):
            continue
        patch = g[int(b[0]): int(b[2]) + 1, int(b[1]): int(b[3]) + 1]
        if not bool((patch == col).all()):
            continue
        squares.append({"col": col, "r0": int(b[0]), "c0": int(b[1]), "n": int(bbox_h(b))})

    assert not (len(squares) < 2)

    by_n: dict[int, list[dict]] = defaultdict(list)
    for sq in squares:
        by_n[int(sq["n"])].append(sq)
    nside = max(by_n.items(), key=lambda kv: (len(kv[1]), kv[0]))[0]
    cand = by_n[int(nside)]
    assert not (len(cand) < 2)

    cand.sort(key=lambda s: int(s["col"]))
    mover = cand[0]
    dest = cand[1]

    n = int(mover["n"])
    sr, sc = int(mover["r0"]), int(mover["c0"])
    dr, dc = int(dest["r0"]), int(dest["c0"])

    counts = Counter(map(int, g.flatten()))
    river = None
    for col, _ct in counts.most_common():
        if int(col) == bg:
            continue
        if int(col) in (int(mover["col"]), int(dest["col"])):
            continue
        river = int(col)
        break
    assert not (river is None)

    trav = (g == river) | (g == int(mover["col"])) | (g == int(dest["col"]))

    h2 = int(H - n + 1)
    w2 = int(W - n + 1)
    assert not (h2 <= 0 or w2 <= 0)
    assert not (not (0 <= sr < h2 and 0 <= sc < w2))

    feasible = np.zeros((h2, w2), dtype=bool)
    for r in range(h2):
        for c in range(w2):
            if bool(trav[int(r): int(r + n), int(c): int(c + n)].all()):
                feasible[int(r), int(c)] = True
    assert not (not bool(feasible[int(sr), int(sc)]))

    dist = -np.ones((h2, w2), dtype=int)
    q = deque([(int(sr), int(sc))])
    dist[int(sr), int(sc)] = 0
    while q:
        r, c = q.popleft()
        for dr2, dc2 in ((1, 0), (-1, 0), (0, 1), (0, -1)):
            rr = int(r + dr2)
            cc = int(c + dc2)
            if 0 <= rr < h2 and 0 <= cc < w2 and bool(feasible[rr, cc]) and int(dist[rr, cc]) == -1:
                dist[rr, cc] = int(dist[int(r), int(c)] + 1)
                q.append((int(rr), int(cc)))

    dest_reached = (
        0 <= dr < h2
        and 0 <= dc < w2
        and bool(feasible[int(dr), int(dc)])
        and int(dist[int(dr), int(dc)]) >= 0
    )

    if dest_reached:
        tr, tc = int(dr), int(dc)
    else:
        best = -1
        tr, tc = int(sr), int(sc)
        for r in range(h2):
            for c in range(w2):
                if int(dist[int(r), int(c)]) > best:
                    best = int(dist[int(r), int(c)])
                    tr, tc = int(r), int(c)

    out = g.copy()
    out[int(sr): int(sr + n), int(sc): int(sc + n)] = river
    if dest_reached:
        out[int(dr): int(dr + n), int(dc): int(dc + n)] = river
    else:
        out[int(tr): int(tr + n), int(tc): int(tc + n)] = int(mover["col"])
    return out


