   106	def _bfs_placement(feasible: np.ndarray, sr: int, sc: int) -> np.ndarray:
   107	    h2, w2 = feasible.shape
   108	    dist = -np.ones((h2, w2), dtype=int)
   109	    dist[sr, sc] = 0
   110	    q = deque([(sr, sc)])
   111	    while q:
   112	        r, c = q.popleft()
   113	        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
   114	            rr, cc = r + dr, c + dc
   115	            if 0 <= rr < h2 and 0 <= cc < w2 and feasible[rr, cc] and dist[rr, cc] == -1:
   116	                dist[rr, cc] = dist[r, c] + 1
   117	                q.append((rr, cc))
   118	    return dist
