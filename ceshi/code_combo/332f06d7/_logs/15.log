   121	def _farthest_reachable(dist: np.ndarray, sr: int, sc: int) -> tuple[int, int, int]:
   122	    best_d = -1
   123	    tr, tc = sr, sc
   124	    for r in range(dist.shape[0]):
   125	        for c in range(dist.shape[1]):
   126	            if int(dist[r, c]) > best_d:
   127	                best_d = int(dist[r, c])
   128	                tr, tc = r, c
