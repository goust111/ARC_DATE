# Variant of 332f06d7
# Dimension: D13 — 卡点判定：最远可达 vs 其他策略 (meta)
# Change: 不可达时停在BFS距离最远的可行位置(即最远可达点)... → 回退到起点

from __future__ import annotations

from collections import Counter, defaultdict, deque
import random

import numpy as np
from scipy.ndimage import label as scipy_label

from arc_utils import bbox_h, bbox_w, find_components


# Design analysis for the D13 variant
# ==================================
# a) Concrete behavior and trace
#    - The input still contains one blue winding river on green background, plus two
#      same-sized solid squares: black mover and red destination.
#    - The solver still builds the placement graph of n x n top-left positions whose
#      full window lies inside {river, mover, dest}, then runs BFS from the mover.
#    - Original stuck behavior:
#         if dest unreachable -> choose the feasible placement with maximum BFS distance.
#      Variant behavior:
#         if dest unreachable -> do not advance at all; keep the mover at its start.
#    - Small trace:
#         suppose feasible BFS visits start S, then two more placements A and B, but a
#         1-pixel chokepoint blocks the rest of the corridor before red target D.
#         Original output places black at B.
#         Variant output leaves black at S, so the input and output are identical in the
#         stuck case.
# b) Complexity calibration
#    - The visual language is unchanged, so object detection remains unambiguous.
#    - The only altered degree of freedom is the stuck policy. To keep the difference
#      visible, the generator rejects stuck instances where the old farthest-reachable
#      policy would also leave the mover at the start.
# c) Implicit assumption review for main()
#    - Background-by-corners still holds because generation keeps green in all corners.
#    - Two same-sized solid squares still exist and remain monochromatic.
#    - River inference by most common non-bg, non-square color still holds because the
#      palette is unchanged.
#    - Feasible-window BFS is still the correct reachability model; only the final target
#      selection changes. The old scan for max(dist) depended on the original D13 policy
#      and must be removed from the unreachable branch.
#    - Filling the source square with river before repainting the target remains safe:
#      when stuck, target=start, so repainting restores the original black block.
# d) Placement legality
#    - The generator preserves all original geometric constraints: square grids, no
#      overlap beyond intended river occupancy, destination on an edge, mover near but
#      not touching an edge, and chokepoints only for n >= 2.
#    - Stuck instances are checked by BFS so the destination is truly unreachable while
#      the mover placement itself stays feasible.
# e) Visual observability
#    - Humans can infer the rule from mixed samples: reachable examples still show the
#      black square sliding to red, while stuck examples show no change despite a visible
#      downstream river and red target behind a narrowed passage.
#    - Because output can equal input in stuck cases, generation explicitly requires that
#      the old solver would have moved forward by at least one BFS step, making this
#      variant materially different from the source task on those samples.
# f) Visual cleanliness
#    - No new markers are added. The river remains a single connected blue channel, and
#      the black/red squares stay visually isolated and easy to parse.
# g) Color-change inference
#    - No new color mapping is introduced. Colors keep their original roles, so the only
#      inferred change is the motion policy under blockage.
# h) Variant-specific generator guarantee
#    - For each stuck instance we compute the source-task fallback target. If it equals
#      the start, the sample is rejected. This prevents silent regression to visually
#      unchanged source behavior.
# i) New assumptions introduced by the variant
#    - The solver now assumes that leaving the mover at the start is always legal when
#      stuck. The generator guarantees this by ensuring the detected mover square is a
#      feasible starting window before BFS, exactly as in the original task.


def _bfs_placement(feasible: np.ndarray, sr: int, sc: int) -> np.ndarray:
    h2, w2 = feasible.shape
    dist = -np.ones((h2, w2), dtype=int)
    dist[sr, sc] = 0
    q = deque([(sr, sc)])
    while q:
        r, c = q.popleft()
        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
            rr, cc = r + dr, c + dc
            if 0 <= rr < h2 and 0 <= cc < w2 and feasible[rr, cc] and dist[rr, cc] == -1:
                dist[rr, cc] = dist[r, c] + 1
                q.append((rr, cc))
    return dist


def _farthest_reachable(dist: np.ndarray, sr: int, sc: int) -> tuple[int, int, int]:
    best_d = -1
    tr, tc = sr, sc
    for r in range(dist.shape[0]):
        for c in range(dist.shape[1]):
            if int(dist[r, c]) > best_d:
                best_d = int(dist[r, c])
                tr, tc = r, c
    return tr, tc, best_d


def main(grid: np.ndarray) -> np.ndarray:
    """
    Slide a solid square through a winding channel to reach a same-sized target square.

    D13 variant:
    - If the destination is reachable, the mover still slides onto it.
    - If the destination is blocked by a chokepoint narrower than the mover, the mover
      no longer advances to the farthest reachable placement; it stays at its start.
    """
    g = np.array(grid, dtype=int)
    H, W = g.shape

    bg = int(
        Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0]
    )

    squares: list[dict] = []
    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict"):
        col = int(comp["color"])
        b = comp["bbox"]
        if bbox_h(b) != bbox_w(b):
            continue
        patch = g[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1]
        if not bool((patch == col).all()):
            continue
        squares.append({"col": col, "r0": int(b[0]), "c0": int(b[1]), "n": int(bbox_h(b))})

    assert len(squares) >= 2

    by_n: dict[int, list[dict]] = defaultdict(list)
    for s in squares:
        by_n[int(s["n"])].append(s)
    nside = max(by_n.items(), key=lambda kv: (len(kv[1]), kv[0]))[0]
    cand = by_n[int(nside)]
    assert len(cand) >= 2

    cand.sort(key=lambda s: int(s["col"]))
    mover = cand[0]
    dest = cand[1]

    n = int(mover["n"])
    sr, sc = int(mover["r0"]), int(mover["c0"])
    dr, dc = int(dest["r0"]), int(dest["c0"])

    counts = Counter(map(int, g.flatten()))
    river = None
    for col, _ct in counts.most_common():
        if int(col) == bg:
            continue
        if int(col) in (int(mover["col"]), int(dest["col"])):
            continue
        river = int(col)
        break
    assert river is not None

    trav = (g == river) | (g == int(mover["col"])) | (g == int(dest["col"]))

    h2 = int(H - n + 1)
    w2 = int(W - n + 1)
    assert h2 > 0 and w2 > 0
    assert 0 <= sr < h2 and 0 <= sc < w2

    feasible = np.zeros((h2, w2), dtype=bool)
    for r in range(h2):
        for c in range(w2):
            if bool(trav[r : r + n, c : c + n].all()):
                feasible[r, c] = True
    assert bool(feasible[sr, sc])

    dist = _bfs_placement(feasible, sr, sc)

    if 0 <= dr < h2 and 0 <= dc < w2 and bool(feasible[dr, dc]) and int(dist[dr, dc]) >= 0:
        tr, tc = dr, dc
    else:
        tr, tc = sr, sc

    out = g.copy()
    out[sr : sr + n, sc : sc + n] = river
    out[tr : tr + n, tc : tc + n] = int(mover["col"])
    return out


_BG, _RIVER, _MOVER, _DEST = 3, 1, 0, 2


def _hamiltonian_walk(rows: int, cols: int, start: tuple[int, int], end: tuple[int, int]):
    total = rows * cols
    best_path = None
    best_len = 0
    for _attempt in range(80):
        visited = {start}
        path = [start]
        cur = start
        while True:
            if cur == end and len(path) >= total * 0.7:
                if len(path) > best_len:
                    best_path = list(path)
                    best_len = len(path)
                break
            neighbors = []
            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nr, nc = cur[0] + dr, cur[1] + dc
                if 0 <= nr < rows and 0 <= nc < cols and (nr, nc) not in visited:
                    neighbors.append((nr, nc))
            if not neighbors:
                break
            valid = []
            for nb in neighbors:
                if nb == end:
                    valid.append(nb)
                    continue
                test_visited = visited | {nb}
                seen = {end}
                q = deque([end])
                while q:
                    cr, cc = q.popleft()
                    for dr2, dc2 in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                        nr2, nc2 = cr + dr2, cc + dc2
                        if (
                            0 <= nr2 < rows
                            and 0 <= nc2 < cols
                            and (nr2, nc2) not in test_visited
                            and (nr2, nc2) not in seen
                        ):
                            seen.add((nr2, nc2))
                            q.append((nr2, nc2))
                for dr2, dc2 in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                    ar, ac = nb[0] + dr2, nb[1] + dc2
                    if (
                        0 <= ar < rows
                        and 0 <= ac < cols
                        and (ar, ac) not in test_visited
                        and (ar, ac) in seen
                    ):
                        valid.append(nb)
                        break
            if not valid:
                break
            random.shuffle(valid)
            nxt = valid[0]
            visited.add(nxt)
            path.append(nxt)
            cur = nxt
        if best_path and best_len >= total * 0.85:
            break
    return best_path


