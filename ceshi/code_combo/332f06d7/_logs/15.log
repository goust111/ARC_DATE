   300	    grid: np.ndarray,
   301	    pixel_pos_i: tuple[int, int],
   302	    pixel_pos_j: tuple[int, int],
   303	    n: int,
   304	    direction: str,
   305	) -> None:
   306	    H, W = grid.shape
   307	    pr1, pc1 = pixel_pos_i
   308	    pr2, pc2 = pixel_pos_j
   309	    narrow_w = random.randint(1, n - 1)
   310	    remove = n - narrow_w
   311	    side = random.randint(0, 1)
   312	
   313	    if direction == "h":
   314	        c_lo = min(pc1, pc2) + n
   315	        c_hi = max(pc1, pc2)
   316	        if c_hi <= c_lo:
   317	            c_lo, c_hi = min(pc1, pc2), max(pc1, pc2) + n
   318	        hold_len = random.randint(1, min(6, max(1, c_hi - c_lo - 2 * remove)))
   319	        total_len = 2 * remove + max(1, hold_len)
   320	        c_mid = (c_lo + c_hi) // 2
   321	        c_start = max(c_lo, c_mid - total_len // 2)
   322	        for step in range(total_len):
   323	            c = c_start + step
   324	            if c < 0 or c >= W:
   325	                continue
   326	            if step < remove:
   327	                depth = step + 1
   328	            elif step >= total_len - remove:
   329	                depth = total_len - step
   330	            else:
   331	                depth = remove
   332	            for k in range(depth):
   333	                rr = pr1 + k if side == 0 else pr1 + n - 1 - k
   334	                if 0 <= rr < H:
   335	                    grid[rr, c] = _BG
   336	    else:
   337	        r_lo = min(pr1, pr2) + n
   338	        r_hi = max(pr1, pr2)
   339	        if r_hi <= r_lo:
   340	            r_lo, r_hi = min(pr1, pr2), max(pr1, pr2) + n
   341	        hold_len = random.randint(1, min(6, max(1, r_hi - r_lo - 2 * remove)))
   342	        total_len = 2 * remove + max(1, hold_len)
   343	        r_mid = (r_lo + r_hi) // 2
   344	        r_start = max(r_lo, r_mid - total_len // 2)
   345	        for step in range(total_len):
   346	            r = r_start + step
   347	            if r < 0 or r >= H:
   348	                continue
   349	            if step < remove:
   350	                depth = step + 1
   351	            elif step >= total_len - remove:
   352	                depth = total_len - step
   353	            else:
   354	                depth = remove
   355	            for k in range(depth):
   356	                cc = pc1 + k if side == 0 else pc1 + n - 1 - k
   357	                if 0 <= cc < W:
   358	                    grid[r, cc] = _BG
   359	
   360	
   361	def _river_connected(grid: np.ndarray) -> bool:
   362	    mask = (grid == _RIVER) | (grid == _MOVER) | (grid == _DEST)
   363	    if not mask.any():
   364	        return False
   365	    _labeled, num = scipy_label(mask.astype(int))
   366	    return num == 1
   367	
   368	
   369	def _compute_offsets(G: int, n: int, num_coarse: int):
   370	    if num_coarse == 1:
   371	        return [1]
   372	    first = 1
   373	    last = G - n - 1
   374	    if last < first:
   375	        return None
   376	    step = (last - first) / (num_coarse - 1)
   377	    return [int(round(first + i * step)) for i in range(num_coarse)]
   378	
   379	
   380	def _extend_to_edge(grid: np.ndarray, pr: int, pc: int, n: int):
   381	    H, W = grid.shape
   382	    candidates = []
   383	    for direction in ("top", "bottom", "left", "right"):
   384	        if direction == "top":
   385	            dist = pr
   386	            if dist == 0:
   387	                candidates.append((0, pc, 0))
   388	                continue
   389	            if all(grid[r, c] in (_BG, _RIVER) for r in range(pr) for c in range(pc, pc + n) if c < W):
   390	                candidates.append((0, pc, dist))
   391	        elif direction == "bottom":
   392	            dist = H - (pr + n)
   393	            if dist == 0:
   394	                candidates.append((pr, pc, 0))
   395	                continue
   396	            if all(
   397	                grid[r, c] in (_BG, _RIVER) for r in range(pr + n, H) for c in range(pc, pc + n) if c < W
   398	            ):
   399	                candidates.append((H - n, pc, dist))
   400	        elif direction == "left":
   401	            dist = pc
   402	            if dist == 0:
   403	                candidates.append((pr, 0, 0))
   404	                continue
   405	            if all(grid[r, c] in (_BG, _RIVER) for r in range(pr, pr + n) for c in range(pc) if r < H):
   406	                candidates.append((pr, 0, dist))
   407	        else:
   408	            dist = W - (pc + n)
   409	            if dist == 0:
   410	                candidates.append((pr, pc, 0))
   411	                continue
   412	            if all(
   413	                grid[r, c] in (_BG, _RIVER) for r in range(pr, pr + n) for c in range(pc + n, W) if r < H
   414	            ):
   415	                candidates.append((pr, W - n, dist))
   416	    if not candidates:
   417	        return None
   418	    candidates.sort(key=lambda x: x[2])
   419	    return candidates[0][:2]
   420	
   421	
   422	def _gen_attempt():
   423	    reached = random.random() < 0.5
   424	    n = random.choice([1, 2, 3, 4]) if reached else random.choice([2, 3, 4])
   425	
   426	    min_size = max(10, 5 * n)
   427	    if min_size > 20:
   428	        return None
   429	    G = random.randint(min_size, 20)
   430	    H = W = G
   431	
   432	    min_spacing = n + 1
   433	    max_coarse = max(3, (G - 2) // min_spacing)
   434	    coarse_dim = random.randint(3, min(6, max_coarse))
   435	    coarse_rows = coarse_cols = coarse_dim
   436	
   437	    offsets_r = _compute_offsets(G, n, coarse_rows)
   438	    offsets_c = _compute_offsets(G, n, coarse_cols)
   439	    if offsets_r is None or offsets_c is None:
   440	        return None
   441	    for i in range(len(offsets_r) - 1):
   442	        if offsets_r[i + 1] - offsets_r[i] < n:
   443	            return None
   444	    for i in range(len(offsets_c) - 1):
   445	        if offsets_c[i + 1] - offsets_c[i] < n:
   446	            return None
   447	
   448	    edge_cells = set()
   449	    for c in range(coarse_cols):
   450	        edge_cells.add((0, c))
   451	        edge_cells.add((coarse_rows - 1, c))
   452	    for r in range(1, coarse_rows - 1):
   453	        edge_cells.add((r, 0))
   454	        edge_cells.add((r, coarse_cols - 1))
   455	    edge_cells = list(edge_cells)
   456	    random.shuffle(edge_cells)
   457	    start_coarse = edge_cells[0]
   458	    far = sorted(edge_cells, key=lambda e: -(abs(e[0] - start_coarse[0]) + abs(e[1] - start_coarse[1])))
   459	    end_coarse = far[0] if far[0] != start_coarse else far[1]
   460	
   461	    walk = _hamiltonian_walk(coarse_rows, coarse_cols, start_coarse, end_coarse)
   462	    if walk is None or len(walk) < 4:
   463	        return None
   464	    if len(set(cr for cr, _ in walk)) < coarse_rows or len(set(cc for _, cc in walk)) < coarse_cols:
   465	        return None
   466	
   467	    grid = np.full((H, W), _BG, dtype=int)
   468	    pixel_pos = _render_channel(grid, walk, n, offsets_r, offsets_c)
   469	
   470	    mask = grid != _BG
   471	    if np.any(mask, axis=1).sum() / H < 0.70 or np.any(mask, axis=0).sum() / W < 0.70:
   472	        return None
   473	
   474	    mover_r, mover_c = pixel_pos[0]
   475	    dest_r, dest_c = pixel_pos[-1]
   476	
   477	    result = _extend_to_edge(grid, dest_r, dest_c, n)
   478	    if result is None:
   479	        return None
   480	    new_dest_r, new_dest_c = result
   481	    if new_dest_r != dest_r:
   482	        r_lo, r_hi = min(new_dest_r, dest_r), max(new_dest_r, dest_r) + n
   483	        grid[r_lo:r_hi, dest_c : dest_c + n] = _RIVER
   484	    if new_dest_c != dest_c:
   485	        c_lo, c_hi = min(new_dest_c, dest_c), max(new_dest_c, dest_c) + n
   486	        grid[dest_r : dest_r + n, c_lo:c_hi] = _RIVER
   487	    dest_r, dest_c = new_dest_r, new_dest_c
   488	    if not (dest_r == 0 or dest_r + n == H or dest_c == 0 or dest_c + n == W):
   489	        return None
   490	
   491	    touching = mover_r == 0 or mover_r + n == H or mover_c == 0 or mover_c + n == W
   492	    if touching:
   493	        if mover_r == 0:
   494	            grid[0, mover_c : mover_c + n] = _RIVER
   495	            mover_r = 1
   496	        elif mover_r + n == H:
   497	            grid[H - 1, mover_c : mover_c + n] = _RIVER
   498	            mover_r = H - n - 1
   499	        elif mover_c == 0:
   500	            grid[mover_r : mover_r + n, 0] = _RIVER
   501	            mover_c = 1
   502	        else:
   503	            grid[mover_r : mover_r + n, W - 1] = _RIVER
   504	            mover_c = W - n - 1
   505	    if mover_r == 0 or mover_r + n == H or mover_c == 0 or mover_c + n == W:
   506	        return None
   507	    if min(mover_r, H - (mover_r + n), mover_c, W - (mover_c + n)) > 2:
   508	        return None
   509	
   510	    grid[mover_r : mover_r + n, mover_c : mover_c + n] = _RIVER
   511	    grid[dest_r : dest_r + n, dest_c : dest_c + n] = _RIVER
   512	
   513	    if not reached and n >= 2:
   514	        num_choke = random.randint(1, min(3, len(walk) - 2))
   515	        min_seg = max(1, len(walk) // 4)
   516	        available = list(range(min_seg, len(walk) - 1))
   517	        random.shuffle(available)
   518	        for seg_idx in available[:num_choke]:
   519	            pr1, pc1 = pixel_pos[seg_idx]
   520	            pr2, pc2 = pixel_pos[min(seg_idx + 1, len(pixel_pos) - 1)]

diff --git a//home/lixinyu/snap/new/ceshi/code_combo/332f06d7/15/code.py b//home/lixinyu/snap/new/ceshi/code_combo/332f06d7/15/code.py
new file mode 100644
