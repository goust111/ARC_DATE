+    mover = _detect_mover(g, bg)
+    n = int(mover["n"])
+    sr, sc = int(mover["r0"]), int(mover["c0"])
+    start_side = str(mover["side"])
+    exit_side = _opposite_side(start_side)
+
+    counts = Counter(map(int, g.flatten()))
