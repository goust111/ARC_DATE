+        total_len = 2 * remove + max(1, hold_len)
+        c_mid = (c_lo + c_hi) // 2
+        c_start = max(c_lo, c_mid - total_len // 2)
+        for step in range(total_len):
+            c = c_start + step
+            if c < 0 or c >= W:
+                continue
+            if step < remove:
+                depth = step + 1
+            elif step >= total_len - remove:
