+def _farthest_reachable(dist: np.ndarray, sr: int, sc: int) -> tuple[int, int]:
+    best = -1
+    tr, tc = int(sr), int(sc)
+    h2, w2 = dist.shape
+    for r in range(h2):
+        for c in range(w2):
+            if int(dist[r, c]) > best:
+                best = int(dist[r, c])
+                tr, tc = int(r), int(c)
+    return tr, tc
