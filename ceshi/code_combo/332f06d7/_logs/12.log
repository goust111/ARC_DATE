+def _positions_on_side(dist: np.ndarray, side: str) -> list[tuple[int, int]]:
+    h2, w2 = dist.shape
+    positions: list[tuple[int, int]] = []
+    for r in range(h2):
+        for c in range(w2):
+            if int(dist[r, c]) < 0:
+                continue
+            if side == "top" and r == 0:
+                positions.append((r, c))
+            elif side == "bottom" and r == h2 - 1:
+                positions.append((r, c))
+            elif side == "left" and c == 0:
+                positions.append((r, c))
+            elif side == "right" and c == w2 - 1:
+                positions.append((r, c))
