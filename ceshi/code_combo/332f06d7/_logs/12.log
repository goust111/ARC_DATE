   296	    narrow_w = random.randint(1, n - 1)
   297	    remove = n - narrow_w
   298	    side = random.randint(0, 1)
   299	
   300	    if direction == "h":
   301	        c_lo = min(pc1, pc2) + n
   302	        c_hi = max(pc1, pc2)
   303	        if c_hi <= c_lo:
   304	            c_lo, c_hi = min(pc1, pc2), max(pc1, pc2) + n
   305	        hold_len = random.randint(1, min(6, max(1, c_hi - c_lo - 2 * remove)))
   306	        total_len = 2 * remove + max(1, hold_len)
   307	        c_mid = (c_lo + c_hi) // 2
   308	        c_start = max(c_lo, c_mid - total_len // 2)
   309	        for step in range(total_len):
   310	            c = c_start + step
   311	            if c < 0 or c >= W:
   312	                continue
   313	            if step < remove:
   314	                depth = step + 1
   315	            elif step >= total_len - remove:
   316	                depth = total_len - step
   317	            else:
   318	                depth = remove
   319	            for k in range(depth):
   320	                rr = pr1 + k if side == 0 else pr1 + n - 1 - k

