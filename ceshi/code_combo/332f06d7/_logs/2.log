# Variant of 332f06d7
# Dimension: D2 — 宽度约束：通道窄化卡点机制 (path)
# Change: 通道宽度在卡点处收窄至1到n-1像素，NxN方块无法通过而被卡住... → 渐变宽度约束

from __future__ import annotations

from collections import Counter, defaultdict, deque
import random

import numpy as np
from scipy.ndimage import label as scipy_label

from arc_utils import bbox_h, bbox_w, find_components

# Design analysis for the variant
# a) Concrete form + behavior trace:
#    - The input still shows one blue river, one black n×n mover, and one red n×n target.
#    - The key change is localized to the final straight tail that approaches the target:
#      one river wall stays fixed while the opposite wall steps inward over several columns/rows.
#      Reachable cases taper from width n+extra down to n; blocked cases taper from width n+extra
#      down to a 1..n-1 spine before the red pocket at the boundary.
#    - Small trace, n=3, horizontal tail widths by column:
#      original stuck logic: 3,3,3,1,1,...  -> a sudden gate.
#      variant logic:       5,4,3,2,2,...  -> the first 2-wide column makes any 3×3 placement fail.
#      The black square therefore advances until the last reachable 3×3 placement nearest the red square.
# b) Complexity calibration:
#    - Only one taper zone is introduced per sample. Width changes in a monotone staircase, not arbitrary noise.
#    - Colors and object types stay unchanged, so the new inference burden is focused on reading the width trend.
#    - Taper lengths are kept to a few steps (typically 4-8) so the pattern is visible in 2-4 demonstrations.
# c) Implicit-assumption review of main():
#    - Square detection and river-color detection remain valid: the mover and target are still solid same-sized squares.
#    - Feasible-window BFS remains the correct core solver because it already reasons about full n×n clearance, which
#      naturally handles gradual narrowing without any special chokepoint code.
#    - The original blocked-case fallback picked the maximum BFS distance from the start. That was harmless when the
#      placement graph was effectively a 1-cell-wide path, but gradual tapering introduces wider upstream sections with
#      lateral slack. In the variant, "how far toward the target" is better represented by minimum Manhattan distance
#      to the target among reachable placements, not by raw graph eccentricity. The fallback is changed accordingly.
# d) Placement legality:
#    - The tapered tail is only painted into a clear rectangular region beyond the winding prefix.
#    - The red pocket always touches exactly one grid edge and avoids corners; the mover remains near an edge but not
#      touching it after a one-cell inward adjustment if needed.
#    - The river stays pixel-connected even in blocked cases because the thin spine still links the prefix to the target pocket.
# e) Visual observability:
#    - The solver-facing change is directly visible as a long staircase wall on the final corridor.
#    - Comparing samples lets a human see that the black square stops where the corridor becomes just too narrow, not
#      merely at an isolated one-column gate.
# f) Visual cleanliness:
#    - There is still only one river and one mover/target pair. No extra markers are added.
#    - The taper is axis-aligned and kept on the straight tail so it reads cleanly rather than cluttering the winding prefix.
# g) Color inferability:
#    - No new color mapping is introduced. The variant depends only on visible geometry: same colors, different width trend.


_BG, _RIVER, _MOVER, _DEST = 3, 1, 0, 2


def _detect_square_pair(g: np.ndarray, bg: int) -> tuple[dict, dict]:
    squares: list[dict] = []
    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict"):
        col = int(comp["color"])
        b = comp["bbox"]
        if bbox_h(b) != bbox_w(b):
            continue
        patch = g[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1]
        if not bool((patch == int(col)).all()):
            continue
        squares.append({"col": int(col), "r0": int(b[0]), "c0": int(b[1]), "n": int(bbox_h(b))})
    assert len(squares) >= 2

    by_n: dict[int, list[dict]] = defaultdict(list)
    for s in squares:
        by_n[int(s["n"])].append(s)
    nside = max(by_n.items(), key=lambda kv: (len(kv[1]), kv[0]))[0]
    cand = by_n[int(nside)]
    assert len(cand) >= 2

    cand.sort(key=lambda s: int(s["col"]))
    return cand[0], cand[1]


def _choose_river_color(g: np.ndarray, bg: int, mover_col: int, dest_col: int) -> int:
    counts = Counter(map(int, g.flatten()))
    for col, _ct in counts.most_common():
        if int(col) == int(bg):
            continue
        if int(col) in (int(mover_col), int(dest_col)):
            continue
        return int(col)
    raise AssertionError("river color not found")


def _compute_feasible(trav: np.ndarray, n: int) -> np.ndarray:
    H, W = trav.shape
    h2 = H - n + 1
    w2 = W - n + 1
    assert h2 > 0 and w2 > 0
    feasible = np.zeros((h2, w2), dtype=bool)
    for r in range(h2):
        for c in range(w2):
            if bool(trav[r : r + n, c : c + n].all()):
                feasible[r, c] = True
    return feasible


def _bfs_placement(feasible: np.ndarray, sr: int, sc: int) -> np.ndarray:
    h2, w2 = feasible.shape
    dist = -np.ones((h2, w2), dtype=int)
    dist[sr, sc] = 0
    q = deque([(sr, sc)])
    while q:
        r, c = q.popleft()
        for dr, dc in [(1, 0), (-1, 0), (0, 1), (0, -1)]:
            rr, cc = r + dr, c + dc
            if 0 <= rr < h2 and 0 <= cc < w2 and feasible[rr, cc] and dist[rr, cc] == -1:
                dist[rr, cc] = dist[r, c] + 1
                q.append((rr, cc))
    return dist


def _select_stop(dist: np.ndarray, sr: int, sc: int, dr: int, dc: int) -> tuple[int, int]:
    h2, w2 = dist.shape
    if 0 <= dr < h2 and 0 <= dc < w2 and dist[dr, dc] >= 0:
        return int(dr), int(dc)

    best_key = None
    best_pos = (int(sr), int(sc))
    for r in range(h2):
        for c in range(w2):
            if dist[r, c] < 0:
                continue
            key = (abs(r - dr) + abs(c - dc), -int(dist[r, c]), r, c)
            if best_key is None or key < best_key:
                best_key = key
                best_pos = (int(r), int(c))
    return best_pos


def _analyze_grid(grid: np.ndarray) -> tuple[int, int, int, int, int, int, np.ndarray]:
    g = np.array(grid, dtype=int)
    bg = int(Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0])
    mover, dest = _detect_square_pair(g, bg)
    n = int(mover["n"])
    sr, sc = int(mover["r0"]), int(mover["c0"])
    dr, dc = int(dest["r0"]), int(dest["c0"])
    river = _choose_river_color(g, bg, int(mover["col"]), int(dest["col"]))
    trav = (g == int(river)) | (g == int(mover["col"])) | (g == int(dest["col"]))
    feasible = _compute_feasible(trav, n)
    assert feasible[sr, sc]
    return river, int(mover["col"]), n, sr, sc, dr, dc, feasible


def main(grid: np.ndarray) -> np.ndarray:
    """
    Slide a solid square through a winding channel toward a same-sized target square.

    Variant detail:
    - The river can gradually taper over a long straight tail.
    - A placement is legal only when the full n×n window is traversable.
    - If the target is unreachable, choose the reachable placement closest to the target.
    """
    g = np.array(grid, dtype=int)
    river, mover_col, n, sr, sc, dr, dc, feasible = _analyze_grid(g)
    dist = _bfs_placement(feasible, sr, sc)
    tr, tc = _select_stop(dist, sr, sc, dr, dc)

    out = g.copy()
    out[sr : sr + n, sc : sc + n] = int(river)
    out[tr : tr + n, tc : tc + n] = int(mover_col)
    return out


def _hamiltonian_walk(rows: int, cols: int, start: tuple[int, int], end: tuple[int, int]) -> list[tuple[int, int]] | None:
    total = rows * cols
    best_path = None
    best_len = 0
    for _attempt in range(80):
        visited = {start}
        path = [start]
        cur = start
        while True:
            if cur == end and len(path) >= total * 0.65:
                if len(path) > best_len:
                    best_path = list(path)
                    best_len = len(path)
                break
            neighbors = []
            for dr, dc in [(1, 0), (-1, 0), (0, 1), (0, -1)]:
                nr, nc = cur[0] + dr, cur[1] + dc
                if 0 <= nr < rows and 0 <= nc < cols and (nr, nc) not in visited:
                    neighbors.append((nr, nc))
            if not neighbors:
                break
            valid = []
            for nb in neighbors:
                if nb == end:
                    valid.append(nb)
                    continue
                test_visited = visited | {nb}
                seen = {end}
                q = deque([end])
                while q:
                    cr, cc = q.popleft()
                    for dr2, dc2 in [(1, 0), (-1, 0), (0, 1), (0, -1)]:
                        nr2, nc2 = cr + dr2, cc + dc2
                        if (
                            0 <= nr2 < rows
                            and 0 <= nc2 < cols
                            and (nr2, nc2) not in test_visited
                            and (nr2, nc2) not in seen
                        ):
                            seen.add((nr2, nc2))
                            q.append((nr2, nc2))
                for dr2, dc2 in [(1, 0), (-1, 0), (0, 1), (0, -1)]:
                    ar, ac = nb[0] + dr2, nb[1] + dc2
                    if (
                        0 <= ar < rows
                        and 0 <= ac < cols
                        and (ar, ac) not in test_visited
                        and (ar, ac) in seen
                    ):
                        valid.append(nb)
                        break
            if not valid:
                break
            random.shuffle(valid)
            nxt = valid[0]
            visited.add(nxt)
