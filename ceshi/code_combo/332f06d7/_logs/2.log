+    cells = np.argwhere(reach)
+    if len(cells) == 0:
+        raise ValueError("empty gravity reachable set")
+    best_key = None
+    best_pos = None
+    for r, c in cells:
+        rr = int(r)
+        cc = int(c)
+        key = (rr, -(abs(rr - dr) + abs(cc - dc)), -abs(cc - dc), -cc)
+        if best_key is None or key > best_key:
