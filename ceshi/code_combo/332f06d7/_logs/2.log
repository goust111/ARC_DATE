+        return (None, None) if return_meta else None
+
+    plan = _choose_taper_plan(grid, int(taper["tail_r"]), int(taper["tail_c"]), n, reached)
+    if plan is None:
+        return (None, None) if return_meta else None
+    ok = _apply_vertical_taper(
+        grid,
+        int(taper["tail_r"]),
+        int(taper["tail_c"]),
+        n,
+        int(plan["dest_r"]),
