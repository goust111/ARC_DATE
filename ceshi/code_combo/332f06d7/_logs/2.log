+    candidates: list[dict] = []
+    room_left = int(tail_c)
+    room_right = int(w - (tail_c + n))
+    for side, room in [(-1, room_left), (1, room_right)]:
+        if room < 1:
+            continue
+        max_extra = min(int(room), max(1, min(3, n + 1)))
+        for extra in range(1, max_extra + 1):
