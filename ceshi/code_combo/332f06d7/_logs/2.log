   415	        max_extra = min(int(room), max(1, min(3, n + 1)))
   416	        for extra in range(1, max_extra + 1):
   417	            start_w = int(n + extra)
   418	            end_widths = [n] if reached else list(range(1, n))
   419	            for end_w in end_widths:
   420	                min_taper = max(3, start_w - end_w + 1)
   421	                if body_len < min_taper:
   422	                    continue
   423	                for taper_len in range(min_taper, body_len + 1):
   424	                    candidates.append(
   425	                        {
   426	                            "side": int(side),
   427	                            "extra": int(extra),
   428	                            "start_w": int(start_w),
   429	                            "end_w": int(end_w),
   430	                            "taper_len": int(taper_len),
   431	                            "dest_r": int(dest_r),
   432	                        }
   433	                    )
   434	    if not candidates:
   435	        return None
   436	    candidates.sort(key=lambda plan: (plan["start_w"] - plan["end_w"], plan["extra"], plan["taper_len"]), reverse=True)
   437	    return random.choice(candidates[: min(10, len(candidates))])
   438	
   439	
   440	def _analyze_instance(grid: np.ndarray) -> dict:
   441	    g = np.array(grid, dtype=int)
   442	    _bg, river, mover, dest = _detect_entities(g)
   443	    n = int(mover["n"])
   444	    sr, sc = int(mover["r0"]), int(mover["c0"])
   445	    dr, dc = int(dest["r0"]), int(dest["c0"])
   446	    feasible = _compute_feasible(g, river, int(mover["col"]), int(dest["col"]), n)
   447	    if not bool(feasible[sr, sc]):
   448	        raise ValueError("start not feasible")
   449	    if not bool(feasible[dr, dc]):
   450	        raise ValueError("dest not feasible")
   451	    grav = _gravity_reachable(feasible, sr, sc)
   452	    dist = _bfs_distance(feasible, sr, sc)
   453	    final = (dr, dc) if bool(grav[dr, dc]) else _select_gravity_stop(grav, (dr, dc))
   454	    original = (dr, dc) if int(dist[dr, dc]) >= 0 else _select_original_stop(dist, (sr, sc))
   455	    return {
   456	        "n": int(n),
   457	        "start": (int(sr), int(sc)),
   458	        "dest": (int(dr), int(dc)),
   459	        "feasible": feasible,
   460	        "gravity": grav,
   461	        "dist": dist,
   462	        "gravity_final": tuple(map(int, final)),
   463	        "original_final": tuple(map(int, original)),
   464	    }
   465	
   466	
   467	def _accept_layout(grid: np.ndarray, reached: bool) -> dict | None:
   468	    try:
   469	        info = _analyze_instance(grid)
   470	    except Exception:
   471	        return None
   472	
   473	    grav = info["gravity"]
   474	    dist = info["dist"]
   475	    dr, dc = info["dest"]
   476	    sr, sc = info["start"]
   477	    gravity_hits_dest = bool(grav[dr, dc])
   478	
   479	    if bool(reached) != gravity_hits_dest:
   480	        return None
   481	    if not reached and int(dist[dr, dc]) >= 0:
   482	        return None
   483	    if int(np.sum(grav)) >= int(np.sum(dist >= 0)):
   484	        return None
   485	    if not reached and tuple(info["gravity_final"]) == tuple(info["original_final"]):
   486	        return None
   487	
   488	    out = grid.copy()
   489	    n = int(info["n"])
   490	    tr, tc = info["gravity_final"]
   491	    out[sr : sr + n, sc : sc + n] = _RIVER
   492	    out[tr : tr + n, tc : tc + n] = _MOVER
   493	    if not np.array_equal(main(grid), out):
   494	        return None
   495	
   496	    meta = {
   497	        "reached": bool(reached),
   498	        "n": int(info["n"]),
   499	        "gravity_cells": int(np.sum(grav)),
   500	        "bfs_cells": int(np.sum(dist >= 0)),
   501	        "gravity_final": tuple(map(int, info["gravity_final"])),
   502	        "original_final": tuple(map(int, info["original_final"])),
   503	        "dest": tuple(map(int, info["dest"])),
   504	    }
   505	    return meta
   506	
   507	
   508	def _gen_attempt(return_meta: bool = False):
   509	    reached = random.random() < 0.5
   510	    n = random.choice([1, 2, 3, 4]) if reached else random.choice([2, 3, 4])
   511	
   512	    p_min = 10
   513	    p_max = 21 - n
   514	    if p_min > p_max:
   515	        return (None, None) if return_meta else None
   516	    p = random.randint(p_min, min(16, p_max))
   517	
   518	    layout = _build_abstract_layout(p)
   519	    if layout is None:
   520	        return (None, None) if return_meta else None

