+        if side < 0:
+            cc0 = int(pc + n - cur_w)
+        else:
+            cc0 = int(pc)
+        grid[int(r), cc0 : cc0 + cur_w] = _RIVER
+    grid[dest_r:h, pc : pc + n] = _RIVER
+    return True
