+    sr, sc = mover
+    dr, dc = dest
+    if not (0 <= sr <= grid.shape[0] - n and 0 <= sc <= grid.shape[1] - n):
+        return (None, None) if return_meta else None
+    if not (0 <= dr <= grid.shape[0] - n and 0 <= dc <= grid.shape[1] - n):
+        return (None, None) if return_meta else None
