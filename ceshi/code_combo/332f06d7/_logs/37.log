+    dr, _dc = incoming_dir
+    rr = int(r + n) if int(dr) == 1 else int(r - 1)
+    if not (0 <= rr < H):
+        return []
+    c0 = max(0, int(c - 1))
+    c1 = min(W - 1, int(c + n))
+    return [(int(rr), int(cc)) for cc in range(int(c0), int(c1 + 1))]
