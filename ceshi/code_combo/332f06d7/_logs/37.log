"""


_BG, _RIVER, _PLATFORM, _MOVER, _DEST = 3, 1, 2, 0, 4


def _corner_majority_bg(g: np.ndarray) -> int:
    corners = [int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]
    return int(Counter(corners).most_common(1)[0][0])


def _find_solid_squares(g: np.ndarray, bg: int) -> list[dict]:
    squares: list[dict] = []
    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict"):
        b = comp["bbox"]
        if bbox_h(b) != bbox_w(b):
            continue
        r0, c0, r1, c1 = map(int, b)
        patch = g[r0 : r1 + 1, c0 : c1 + 1]
        col = int(comp["color"])
        if bool((patch == col).all()):
            squares.append({"col": col, "r0": r0, "c0": c0, "n": int(bbox_h(b))})
    return squares


def _choose_mover_and_dest(squares: list[dict]) -> tuple[dict, dict]:
    by_n: dict[int, list[dict]] = defaultdict(list)
    for sq in squares:
        by_n[int(sq["n"])].append(sq)
    viable = [(n, items) for n, items in by_n.items() if len(items) >= 2]
    assert not (not viable)
    nside, cand = max(viable, key=lambda kv: (len(kv[1]), kv[0]))
    chosen = sorted(cand, key=lambda s: (int(s["r0"]), int(s["c0"]), int(s["col"])))[:2]
    mover, dest = chosen[0], chosen[1]
    assert int(mover["n"]) == int(nside) and int(dest["n"]) == int(nside)
    return mover, dest


def _identify_river_and_platform(
    g: np.ndarray, bg: int, mover_col: int, dest_col: int, n: int
) -> tuple[int, int]:
    counts = Counter(map(int, g.flatten()))
    candidates = [int(col) for col in counts if int(col) not in (int(bg), int(mover_col), int(dest_col))]
    assert not (len(candidates) < 2)

    platform = None
    for col in candidates:
        comps = find_components(
            g, bg=bg, connectivity=4, monochromatic=True, colors=[int(col)], return_format="dict"
        )
        if comps and all(bbox_h(comp["bbox"]) == 1 and bbox_w(comp["bbox"]) >= int(n + 1) for comp in comps):
            platform = int(col)
            break
    assert not (platform is None)

    river_choices = [int(col) for col in candidates if int(col) != int(platform)]
    assert not (not river_choices)
    river = max(river_choices, key=lambda col: (int(counts[int(col)]), -int(col)))
    return int(river), int(platform)


def _feasible_mask(g: np.ndarray, n: int, allowed_colors: set[int]) -> np.ndarray:
    H, W = g.shape
    h2, w2 = H - n + 1, W - n + 1
    feasible = np.zeros((h2, w2), dtype=bool)
    allowed = np.isin(g, list(allowed_colors))
    for r in range(h2):
        for c in range(w2):
            if bool(allowed[r : r + n, c : c + n].all()):
                feasible[r, c] = True
    return feasible


def _fall(feasible: np.ndarray, r: int, c: int) -> int:
    rr = int(r)
    while int(rr + 1) < int(feasible.shape[0]) and bool(feasible[int(rr + 1), int(c)]):
        rr += 1
    return int(rr)


def _platform_segment(g: np.ndarray, platform: int, support_row: int, c: int, n: int) -> tuple[int, int] | None:
    H, W = g.shape
    if not (0 <= int(support_row) < H and 0 <= int(c) and int(c + n) <= W):
        return None
    if not bool((g[int(support_row), int(c) : int(c + n)] == int(platform)).all()):
        return None
    a = int(c)
    while a - 1 >= 0 and int(g[int(support_row), int(a - 1)]) == int(platform):
        a -= 1
    b = int(c + n - 1)
    while b + 1 < W and int(g[int(support_row), int(b + 1)]) == int(platform):
        b += 1
    return int(a), int(b)


def _simulate_terminals(
    g: np.ndarray, feasible: np.ndarray, sr: int, sc: int, n: int, platform: int
) -> set[tuple[int, int]]:
    h2, w2 = feasible.shape
    assert not (not bool(feasible[int(sr), int(sc)]))

    q = deque([(int(sr), int(sc))])
    processed: set[tuple[int, int]] = set()
    terminals: set[tuple[int, int]] = set()

    while q:
        r, c = q.popleft()
        if not (0 <= int(r) < h2 and 0 <= int(c) < w2 and bool(feasible[int(r), int(c)])):
            continue

        landed = (int(_fall(feasible, int(r), int(c))), int(c))
        if landed in processed:
            continue
        processed.add(landed)

        support_row = int(landed[0] + n)
        seg = _platform_segment(g, int(platform), support_row, int(landed[1]), int(n))
        if seg is None:
            terminals.add(landed)
            continue

        a, b = seg
        next_states: list[tuple[int, int]] = []
        for cc in (int(a - n), int(b + 1)):
            if 0 <= int(cc) < w2 and bool(feasible[int(landed[0]), int(cc)]):
                state = (int(landed[0]), int(cc))
                if state != landed and state not in next_states:
                    next_states.append(state)

        if not next_states:
            terminals.add(landed)
            continue

        for state in next_states:
            q.append(state)

    return terminals


def _parse_scene(grid: np.ndarray) -> dict:
    g = np.array(grid, dtype=int)
    bg = _corner_majority_bg(g)

    squares = _find_solid_squares(g, bg)
    assert not (len(squares) < 2)
    mover, dest = _choose_mover_and_dest(squares)

    n = int(mover["n"])
    sr, sc = int(mover["r0"]), int(mover["c0"])
    river, platform = _identify_river_and_platform(g, bg, int(mover["col"]), int(dest["col"]), n)

    feasible = _feasible_mask(g, n, {int(river), int(mover["col"]), int(dest["col"])})
    terminals = _simulate_terminals(g, feasible, sr, sc, n, platform)

    return {
        "grid": g,
        "bg": int(bg),
        "river": int(river),
        "platform": int(platform),
        "mover": mover,
        "dest": dest,
        "n": int(n),
        "sr": int(sr),
        "sc": int(sc),
        "terminals": terminals,
        "feasible": feasible,
    }


def main(grid: np.ndarray) -> np.ndarray:
    """
    Bounce a solid square through a blue chute network.

    Input structure:
    - bg at the corners.
    - Two same-sized solid squares: upper one is the black mover, lower one is the target.
    - Blue n-wide shafts/corridors form the traversable air channel.
    - Red 1-pixel-high horizontal bars are bounce platforms.

    Rule:
    - The mover falls straight down through feasible n×n placements.
    - When it lands directly on a red platform, it bounces to the left and right overflow positions
      at the platform edges, then those branches fall independently.
    - All terminal landing positions become black; the original mover position becomes blue.
    """
    info = _parse_scene(np.array(grid, dtype=int))
    g = info["grid"]
    n = int(info["n"])
    sr, sc = int(info["sr"]), int(info["sc"])
    river = int(info["river"])
    mover_col = int(info["mover"]["col"])

    out = g.copy()
    out[sr : sr + n, sc : sc + n] = int(river)
    for tr, tc in sorted(info["terminals"]):
        out[int(tr) : int(tr + n), int(tc) : int(tc + n)] = int(mover_col)
    return out


def _paint_vertical_channel(grid: np.ndarray, top_r: int, bottom_r: int, c: int, n: int) -> None:
    grid[int(top_r) : int(bottom_r + n), int(c) : int(c + n)] = int(_RIVER)


def _paint_horizontal_channel(grid: np.ndarray, r: int, c0: int, c1: int, n: int) -> None:
    lo, hi = sorted((int(c0), int(c1)))
    grid[int(r) : int(r + n), int(lo) : int(hi + n)] = int(_RIVER)


def _expected_output(grid: np.ndarray, start: tuple[int, int], terminals: set[tuple[int, int]], n: int) -> np.ndarray:
    out = np.array(grid, copy=True)
    sr, sc = start
    out[int(sr) : int(sr + n), int(sc) : int(sc + n)] = int(_RIVER)
    for tr, tc in terminals:
        out[int(tr) : int(tr + n), int(tc) : int(tc + n)] = int(_MOVER)
    return out


def _gen_attempt() -> np.ndarray | None:
    n = random.choice([2, 3])
    min_size = 13 if n == 2 else 16
    H = W = random.randint(min_size, 20)
    grid = np.full((H, W), _BG, dtype=int)

    gap = n + 2
    sr = 1
    sc_low = 1 + gap
    sc_high = W - n - 1 - gap
    if sc_low > sc_high:
        return None
    sc = random.randint(sc_low, sc_high)

    left_c = sc - gap
    right_c = sc + gap
    if left_c < 1 or right_c + n > W - 1:
        return None

    platform_row_low = sr + n + 2

