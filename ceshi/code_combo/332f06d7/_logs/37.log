    feasible=np.zeros((h2,w2),dtype=bool)
    for r in range(h2):
        for c in range(w2):
            feasible[r,c]=trav[r:r+n,c:c+n].all()
    dist=-np.ones((h2,w2),dtype=int)
    q=deque([(sr,sc)])
    dist[sr,sc]=0
    while q:
        r,c=q.popleft()
        for rr,cc in ((r+1,c),(r-1,c),(r,c+1),(r,c-1)):
            if 0<=rr<h2 and 0<=cc<w2 and feasible[rr,cc] and dist[rr,cc]==-1:
                dist[rr,cc]=dist[r,c]+1
                q.append((rr,cc))
    if 0<=dr0<h2 and 0<=dc0<w2 and feasible[dr0,dc0] and dist[dr0,dc0]>=0:
        return (dr0,dc0)
    best=-1
    tr,tc=sr,sc
    for r in range(h2):
        for c in range(w2):
            if dist[r,c]>best:
                best=dist[r,c]
                tr,tc=r,c
    return (tr,tc)

