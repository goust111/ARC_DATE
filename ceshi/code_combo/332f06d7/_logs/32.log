            ### 参考代码: D2/0

            文件: `/home/lixinyu/snap/new/ceshi/code/332f06d7/D2/0/code.py`

            ```python
            # Variant of 332f06d7
# Dimension: D2 — 宽度约束：通道窄化卡点机制 (path)
# Change: 通道宽度在卡点处收窄至1到n-1像素，NxN方块无法通过而被卡住... → 无宽度约束（始终可达）
#
# Design analysis
# ---------------
# variant_spec:
#   core_change:
#     - Keep the same visual objects as the base task: green background, a single blue winding river,
#       one black n×n mover square, one red n×n destination square of the same size.
#     - Preserve visible chokepoints where the blue river narrows below n pixels.
#     - Change only the motion rule: the black square now follows blue connectivity at pixel level,
#       so narrow gates are decorative shape cues rather than blockers.
#   concrete_behavior:
#     - In the original task, a 3×3 black block facing a 1-pixel neck cannot advance because no 3×3
#       top-left placement fits through the gate; it stops upstream.
#     - In this variant, the exact same input still has one connected blue route from black to red, so
#       the black block is considered able to reach the red square and always covers it in the output.
#   complexity_calibration:
#     - The task is not reduced to a generic "swap black to red" puzzle, because every generated sample
#       still contains a long winding river and at least one visible sub-n chokepoint.
#     - The generator rejects samples where the legacy width-based solver would also reach the target;
#       this forces the D2 change to be behaviorally active rather than merely possible.
#   old_main_dependency_review:
#     - Square detection by monochromatic connected components still works unchanged, because the variant
#       keeps exactly two solid same-sized special squares.
#     - The legacy feasible-placement scan `trav[r:r+n, c:c+n].all()` encoded the old width constraint.
#       That assumption is invalid here and is removed from `main()`.
#     - The legacy fallback "farthest reachable placement" only existed for blocked cases. Since the
#       variant semantics say the square always reaches the destination, that branch disappears.
#     - River color inference as "most common non-bg, non-square color" remains valid because generation
#       still uses a single blue river color and no extra distractor colors.
#   placement_legality:
#     - The generator reuses the original placement-path construction, so squares stay in bounds and do
#       not overlap each other improperly.
#     - Chokepoints are carved only out of river pixels; the river remains 4-connected at pixel level.
#   observability:
#     - Samples only use n in {2,3,4}; otherwise the width change would be invisible when n=1.
#     - Every accepted sample contains at least one chokepoint and is verified to differ from the legacy
#       width-constrained outcome, so humans can see that narrow segments no longer stop the mover.
#   visual_cleanliness:
#     - No new markers, colors, or overlays are introduced. The picture stays close to the base task:
#       one river, one black square, one red square, green background.
#   color_inference:
#     - No hidden color ordering is introduced beyond the original fixed roles: black is the mover,
#       red is the destination, blue is the river, green is the background.
#   new_main_assumptions:
#     - The mover and destination sit on the same blue-connected component when counting the squares as
#       traversable river cells.
#     - The generator guarantees that property and additionally guarantees that the old solver would have
#       stopped early, so the new rule is both valid and visibly different.

from __future__ import annotations

from collections import Counter, defaultdict, deque
import random

import numpy as np
from scipy.ndimage import label as scipy_label

from arc_utils import bbox_h, bbox_w, find_components


_BG, _RIVER, _MOVER, _DEST = 3, 1, 0, 2


def _scene_info(grid: np.ndarray):
    g = np.array(grid, dtype=int)
    H, W = g.shape

    bg = int(
        Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])])
        .most_common(1)[0][0]
    )

    squares: list[dict] = []
    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict"):
        col = int(comp["color"])
        b = comp["bbox"]
        if bbox_h(b) != bbox_w(b):
            continue
        patch = g[int(b[0]): int(b[2]) + 1, int(b[1]): int(b[3]) + 1]
        if not bool((patch == col).all()):
            continue
        squares.append({"col": col, "r0": int(b[0]), "c0": int(b[1]), "n": int(bbox_h(b))})

    assert len(squares) >= 2

    by_n: dict[int, list[dict]] = defaultdict(list)
    for sq in squares:
        by_n[int(sq["n"])].append(sq)
    nside = max(by_n.items(), key=lambda kv: (len(kv[1]), kv[0]))[0]
    cand = sorted(by_n[int(nside)], key=lambda s: int(s["col"]))
    assert len(cand) >= 2
    mover = cand[0]
    dest = cand[1]

    counts = Counter(map(int, g.flatten()))
    river = None
    for col, _ct in counts.most_common():
        if col == bg:
            continue
        if col in (int(mover["col"]), int(dest["col"])):
            continue
        river = int(col)
        break
    assert river is not None

    return g, H, W, bg, river, mover, dest


def main(grid: np.ndarray) -> np.ndarray:
    """
    Variant rule: the blue river is only a connectivity cue.

    The black n×n square always reaches the same-sized red square as long as both lie on the same
    4-connected river component when river, mover, and destination pixels are all treated as traversable.
    Local river width no longer matters, so narrow chokepoints do not block movement.
    """
    g, H, W, _bg, river, mover, dest = _scene_info(grid)

    n = int(mover["n"])
    sr, sc = int(mover["r0"]), int(mover["c0"])
    dr, dc = int(dest["r0"]), int(dest["c0"])

    trav = (g == river) | (g == int(mover["col"])) | (g == int(dest["col"]))

    seen = np.zeros((H, W), dtype=bool)
    q = deque()
    for r in range(sr, sr + n):
        for c in range(sc, sc + n):
            if trav[r, c] and not seen[r, c]:
                seen[r, c] = True
                q.append((r, c))

    reached_dest = False
    while q:
        r, c = q.popleft()
        if dr <= r < dr + n and dc <= c < dc + n:
            reached_dest = True
            break
        for rr, cc in ((r + 1, c), (r - 1, c), (r, c + 1), (r, c - 1)):
            if 0 <= rr < H and 0 <= cc < W and trav[rr, cc] and not seen[rr, cc]:
                seen[rr, cc] = True
                q.append((rr, cc))

    assert reached_dest

    out = g.copy()
    out[sr:sr + n, sc:sc + n] = river
    out[dr:dr + n, dc:dc + n] = int(mover["col"])
    return out


def _bfs_placement(feasible: np.ndarray, sr: int, sc: int) -> np.ndarray:
    h2, w2 = feasible.shape
    dist = -np.ones((h2, w2), dtype=int)
    dist[sr, sc] = 0
    q = deque([(sr, sc)])
    while q:
        r, c = q.popleft()
        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
            rr, cc = r + dr, c + dc
            if 0 <= rr < h2 and 0 <= cc < w2 and feasible[rr, cc] and dist[rr, cc] == -1:
                dist[rr, cc] = dist[r, c] + 1
                q.append((rr, cc))
    return dist


def _legacy_output(grid: np.ndarray):
    """
    Original width-constrained solver, kept only as a generator-side oracle.

    The generator uses this to reject degenerate samples where the new variant would accidentally behave
    exactly like the base task.
    """
    g, H, W, _bg, river, mover, dest = _scene_info(grid)

    n = int(mover["n"])
    sr, sc = int(mover["r0"]), int(mover["c0"])
    dr, dc = int(dest["r0"]), int(dest["c0"])

    trav = (g == river) | (g == int(mover["col"])) | (g == int(dest["col"]))
    h2, w2 = H - n + 1, W - n + 1
    if h2 <= 0 or w2 <= 0:
        return None, False

    feasible = np.zeros((h2, w2), dtype=bool)
    for r in range(h2):
        for c in range(w2):
            if bool(trav[r:r + n, c:c + n].all()):
                feasible[r, c] = True
    if not feasible[sr, sc]:
        return None, False

    dist = _bfs_placement(feasible, sr, sc)
    dest_ok = bool(
        0 <= dr < h2
        and 0 <= dc < w2
        and feasible[dr, dc]
        and dist[dr, dc] >= 0
    )

    if dest_ok:
        tr, tc = dr, dc
    else:
        best = -1
        tr, tc = sr, sc
        for r in range(h2):
            for c in range(w2):
                if int(dist[r, c]) > best:
                    best = int(dist[r, c])
                    tr, tc = r, c

    out = g.copy()
    out[sr:sr + n, sc:sc + n] = river
    out[tr:tr + n, tc:tc + n] = int(mover["col"])
    return out, dest_ok


def _hamiltonian_walk(rows: int, cols: int, start: tuple[int, int], end: tuple[int, int]):
    total = rows * cols
    best_path = None
    best_len = 0
    for _attempt in range(80):
        visited = {start}
        path = [start]
        cur = start
        while True:
            if cur == end and len(path) >= total * 0.7:
                if len(path) > best_len:
                    best_path = list(path)
                    best_len = len(path)
                break
            neighbors = []
            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nr, nc = cur[0] + dr, cur[1] + dc
                if 0 <= nr < rows and 0 <= nc < cols and (nr, nc) not in visited:
                    neighbors.append((nr, nc))
            if not neighbors:
                break
            valid = []
            for nb in neighbors:
                if nb == end:
                    valid.append(nb)
                    continue
                test_visited = visited | {nb}
                seen = {end}
                q = deque([end])
                while q:
                    cr, cc = q.popleft()
                    for dr2, dc2 in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                        nr2, nc2 = cr + dr2, cc + dc2
                        if (
                            0 <= nr2 < rows and 0 <= nc2 < cols and
                            (nr2, nc2) not in test_visited and
                            (nr2, nc2) not in seen
                        ):
                            seen.add((nr2, nc2))
                            q.append((nr2, nc2))
                for dr2, dc2 in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                    ar, ac = nb[0] + dr2, nb[1] + dc2
                    if (
                        0 <= ar < rows and 0 <= ac < cols and
                        (ar, ac) not in test_visited and
                        (ar, ac) in seen
                    ):
                        valid.append(nb)
                        break
            if not valid:
                break
            random.shuffle(valid)
            nxt = valid[0]
            visited.add(nxt)
            path.append(nxt)
            cur = nxt
        if best_path and best_len >= total * 0.85:
            break
    return best_path


def _render_channel(
    grid: np.ndarray,
    path: list[tuple[int, int]],
    n: int,
    offsets_r: list[int],
    offsets_c: list[int],
):
    pixel_pos = []
    for cr, cc in path:
        pr, pc = offsets_r[cr], offsets_c[cc]
        pixel_pos.append((pr, pc))
        grid[pr:pr + n, pc:pc + n] = _RIVER
    for i in range(len(path) - 1):
        pr1, pc1 = pixel_pos[i]
        pr2, pc2 = pixel_pos[i + 1]
        if pr1 == pr2:
            c_lo, c_hi = min(pc1, pc2), max(pc1, pc2) + n
            grid[pr1:pr1 + n, c_lo:c_hi] = _RIVER
        else:
            r_lo, r_hi = min(pr1, pr2), max(pr1, pr2) + n
            grid[r_lo:r_hi, pc1:pc1 + n] = _RIVER
    return pixel_pos


def _add_chokepoint(
    grid: np.ndarray,
    pixel_pos_i: tuple[int, int],
    pixel_pos_j: tuple[int, int],
    n: int,
    direction: str,
):
    H, W = grid.shape
    pr1, pc1 = pixel_pos_i
    pr2, pc2 = pixel_pos_j
    narrow_w = random.randint(1, n - 1)
    remove = n - narrow_w
    side = random.randint(0, 1)

    if direction == "h":
        c_lo = min(pc1, pc2) + n
        c_hi = max(pc1, pc2)
        if c_hi <= c_lo:
            c_lo, c_hi = min(pc1, pc2), max(pc1, pc2) + n
        hold_len = random.randint(1, min(6, max(1, c_hi - c_lo - 2 * remove)))
        total_len = 2 * remove + hold_len
        c_mid = (c_lo + c_hi) // 2
        c_start = max(c_lo, c_mid - total_len // 2)
        for step in range(total_len):
            c = c_start + step
            if not (0 <= c < W):
                continue
            if step < remove:
                depth = step + 1
            elif step >= total_len - remove:
                depth = total_len - step
            else:
                depth = remove
            for k in range(depth):
                rr = pr1 + k if side == 0 else pr1 + n - 1 - k
                if 0 <= rr < H:
                    grid[rr, c] = _BG
    else:
        r_lo = min(pr1, pr2) + n
        r_hi = max(pr1, pr2)
        if r_hi <= r_lo:
            r_lo, r_hi = min(pr1, pr2), max(pr1, pr2) + n
        hold_len = random.randint(1, min(6, max(1, r_hi - r_lo - 2 * remove)))
        total_len = 2 * remove + hold_len
        r_mid = (r_lo + r_hi) // 2
        r_start = max(r_lo, r_mid - total_len // 2)
        for step in range(total_len):
            r = r_start + step
            if not (0 <= r < H):
                continue
            if step < remove:
                depth = step + 1
            elif step >= total_len - remove:
                depth = total_len - step
            else:
                depth = remove
            for k in range(depth):
                cc = pc1 + k if side == 0 else pc1 + n - 1 - k
                if 0 <= cc < W:
                    grid[r, cc] = _BG


def _river_connected(grid: np.ndarray) -> bool:
    mask = (grid == _RIVER) | (grid == _MOVER) | (grid == _DEST)
    if not mask.any():
        return False
    _labeled, num = scipy_label(mask.astype(int))
    return num == 1


def _compute_offsets(G: int, n: int, num_coarse: int):
    if num_coarse == 1:
        return [1]
    first = 1
    last = G - n - 1
    if last < first:
        return None
    step = (last - first) / (num_coarse - 1)
    return [int(round(first + i * step)) for i in range(num_coarse)]


def _gen_attempt():
    # Use only n>=2 so the removal of width constraints is visible.
    n = random.choice([2, 3, 4])

    min_size = max(10, 5 * n)
    if min_size > 20:
        return None
    G = random.randint(min_size, 20)
    H = W = G

    min_spacing = n + 1
    max_coarse = max(3, (G - 2) // min_spacing)
    coarse_dim = random.randint(3, min(6, max_coarse))
    coarse_rows = coarse_cols = coarse_dim

    offsets_r = _compute_offsets(G, n, coarse_rows)
    offsets_c = _compute_offsets(G, n, coarse_cols)
    if offsets_r is None or offsets_c is None:
        return None
    for i in range(len(offsets_r) - 1):
        if offsets_r[i + 1] - offsets_r[i] < n:
            return None
    for i in range(len(offsets_c) - 1):
        if offsets_c[i + 1] - offsets_c[i] < n:
            return None

    edge_cells = set()
    for c in range(coarse_cols):
        edge_cells.add((0, c))
        edge_cells.add((coarse_rows - 1, c))
    for r in range(1, coarse_rows - 1):
        edge_cells.add((r, 0))
        edge_cells.add((r, coarse_cols - 1))
    edge_cells = list(edge_cells)
    random.shuffle(edge_cells)
    start_coarse = edge_cells[0]
    far = sorted(edge_cells, key=lambda e: -(abs(e[0] - start_coarse[0]) + abs(e[1] - start_coarse[1])))
    end_coarse = far[0] if far[0] != start_coarse else far[1]

    walk = _hamiltonian_walk(coarse_rows, coarse_cols, start_coarse, end_coarse)
    if walk is None or len(walk) < 4:
        return None
    if len(set(cr for cr, _ in walk)) < coarse_rows or len(set(cc for _, cc in walk)) < coarse_cols:
        return None

    grid = np.full((H, W), _BG, dtype=int)
    pixel_pos = _render_channel(grid, walk, n, offsets_r, offsets_c)

    mask = grid != _BG
    if np.any(mask, axis=1).sum() / H < 0.70 or np.any(mask, axis=0).sum() / W < 0.70:
        return None

    mover_r, mover_c = pixel_pos[0]
    dest_r, dest_c = pixel_pos[-1]

    def _extend_to_edge(pr: int, pc: int):
        candidates = []
        for direction in ("top", "bottom", "left", "right"):
            if direction == "top":
                dist = pr
                if dist == 0:
                    candidates.append((0, pc, 0))
                elif all(grid[r, c] in (_BG, _RIVER) for r in range(pr) for c in range(pc, pc + n) if c < W):
                    candidates.append((0, pc, dist))
            elif direction == "bottom":
                dist = H - (pr + n)
                if dist == 0:
                    candidates.append((pr, pc, 0))
                elif all(grid[r, c] in (_BG, _RIVER) for r in range(pr + n, H) for c in range(pc, pc + n) if c < W):
                    candidates.append((H - n, pc, dist))
            elif direction == "left":
                dist = pc
                if dist == 0:
                    candidates.append((pr, 0, 0))
                elif all(grid[r, c] in (_BG, _RIVER) for r in range(pr, pr + n) for c in range(pc) if r < H):
                    candidates.append((pr, 0, dist))
            else:
                dist = W - (pc + n)
                if dist == 0:
                    candidates.append((pr, pc, 0))
                elif all(grid[r, c] in (_BG, _RIVER) for r in range(pr, pr + n) for c in range(pc + n, W) if r < H):
                    candidates.append((pr, W - n, dist))
        if not candidates:
            return None
        candidates.sort(key=lambda x: x[2])
        return candidates[0][:2]

    result = _extend_to_edge(dest_r, dest_c)
    if result is None:
        return None
    new_dest_r, new_dest_c = result
    if new_dest_r != dest_r:
        r_lo, r_hi = min(new_dest_r, dest_r), max(new_dest_r, dest_r) + n
        grid[r_lo:r_hi, dest_c:dest_c + n] = _RIVER
    if new_dest_c != dest_c:
        c_lo, c_hi = min(new_dest_c, dest_c), max(new_dest_c, dest_c) + n
        grid[dest_r:dest_r + n, c_lo:c_hi] = _RIVER
    dest_r, dest_c = new_dest_r, new_dest_c
    if not (dest_r == 0 or dest_r + n == H or dest_c == 0 or dest_c + n == W):
        return None

    # Keep mover near an edge, but not touching it.
    touching = (mover_r == 0 or mover_r + n == H or mover_c == 0 or mover_c + n == W)
    if touching:
        if mover_r == 0:
            grid[0, mover_c:mover_c + n] = _RIVER
            mover_r = 1
        elif mover_r + n == H:
            grid[H - 1, mover_c:mover_c + n] = _RIVER
            mover_r = H - n - 1
        elif mover_c == 0:
            grid[mover_r:mover_r + n, 0] = _RIVER
            mover_c = 1
        elif mover_c + n == W:
            grid[mover_r:mover_r + n, W - 1] = _RIVER
            mover_c = W - n - 1
    if mover_r == 0 or mover_r + n == H or mover_c == 0 or mover_c + n == W:
        return None
    if min(mover_r, H - (mover_r + n), mover_c, W - (mover_c + n)) > 2:
        return None

    grid[mover_r:mover_r + n, mover_c:mover_c + n] = _RIVER
    grid[dest_r:dest_r + n, dest_c:dest_c + n] = _RIVER

    # Always add chokepoints: they remain visible, but no longer block in the variant.
    max_choke = min(3, len(walk) - 2)
    if max_choke < 1:
        return None
    num_choke = random.randint(1, max_choke)
    min_seg = max(1, len(walk) // 4)
    available = list(range(min_seg, len(walk) - 1))
    random.shuffle(available)
    for seg_idx in available[:num_choke]:
        pr1, pc1 = pixel_pos[seg_idx]
        pr2, pc2 = pixel_pos[min(seg_idx + 1, len(pixel_pos) - 1)]
        direction = "h" if pr1 == pr2 else "v"
        _add_chokepoint(grid, (pr1, pc1), (pr2, pc2), n, direction)
    if not _river_connected(grid):
        return None

    grid[mover_r:mover_r + n, mover_c:mover_c + n] = _MOVER
    grid[dest_r:dest_r + n, dest_c:dest_c + n] = _DEST

    legacy_out, legacy_reaches_dest = _legacy_output(grid)
    if legacy_out is None or legacy_reaches_dest:
        return None

    new_out = main(grid)
    if np.array_equal(new_out, legacy_out):
        return None
    return grid


def generate_input():
    for _ in range(400):
        result = _gen_attempt()
        if result is not None:
            return result
    raise RuntimeError("Failed to generate valid input after 400 attempts")

