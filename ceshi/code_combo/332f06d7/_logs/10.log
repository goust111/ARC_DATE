   426	    if max_first < min_first:
   427	        return None
   428	    first = random.randint(min_first, max_first)
   429	    return [first + gap * i for i in range(k)]
   430	
   431	
   432	def _pick_particle_count(path_len: int) -> int | None:
   433	    choices = [k for k in (4, 3) if _target_positions(path_len, k) is not None]
   434	    if not choices:
