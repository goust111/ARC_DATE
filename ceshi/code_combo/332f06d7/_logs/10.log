            ```python
            # Variant of 332f06d7
# Dimension: D4 — 源对象：移动方块的形状与属性 (src)
# Change: 黑色(color 0)实心NxN正方形，N在1-4之间，位于通道内部靠近网格边缘... → 单像素粒子移动体
#
# Design analysis
# ----------------
# variant_spec:
#   source_task_reading:
#     original_332f06d7:
#       mover: one solid black NxN square
#       goal: one same-sized red NxN square
#       motion_rule: BFS over feasible NxN placements on the blue river
#       failure_mode: a river segment narrower than N blocks the square
#     reference_9bbf930d:
#       imported_idea: treat the mover as particles whose final positions are redrawn
#       kept_simple: no inertia here; particles still use path reachability, not momentum
#   input_objects:
#     background: color 3, dominates the four corners
#     river: color 1, a single-pixel-wide winding simple path
#     movers: 2-4 black particles on the first k cells of the accessible river prefix
#     destination: one red pixel on the river endpoint touching an outer edge
#   output_objects:
#     the black particles slide as a queue to the end of the reachable prefix
#     if the red pixel is in the same connected river component, the front particle covers it
#     if a one-cell gap disconnects the downstream river, particles stop at the last reachable cells before the gap
#     original black cells become blue river
#   behavior_trace:
#     original_local_example:
#       path prefix: A-B-C-D-E-[narrow]-F-G-red
#       mover: 3x3 square at A
#       outcome: width<n blocks motion, final top-left stays at E
#     variant_local_example:
#       path prefix: a-b-c-d-e-[gap]-f-g-red
#       movers: three black particles on a,b,c
#       outcome: particles occupy c,d,e
#     difference:
#       original reasoning depends on the mover footprint and chokepoint width
#       variant reasoning depends only on graph reachability along a 1-pixel path, plus queue size k
#   complexity_calibration:
#     why_not_single_particle_only:
#       a lone 1x1 mover would resemble the original n=1 subcase too closely
#       using 2-4 particles makes the D4 change visible in every training example
#     why_not_many_branches:
#       a branching river would make "farthest reachable" ambiguous to humans
#       the generator therefore keeps every traversable component as a simple path
#   implicit_assumption_audit_for_main:
#     original_square_detection:
#       dependency: non-bg objects are solid equal-sized squares
#       status_in_variant: invalid, removed entirely
#     original_size_selection_by_color_sorted_squares:
#       dependency: exactly two key square components exist and color sorting is harmless
#       status_in_variant: invalid, replaced with explicit particle-color and destination-color roles
#     original_feasible_NxN_window_scan:
#       dependency: motion state is a top-left placement of a square
#       status_in_variant: invalid, replaced with a BFS component over single traversable pixels
#     original_farthest_dist_scan:
#       dependency: farthest feasible placement may live anywhere in a 2D state grid
#       status_in_variant: adapted to the end of the accessible simple path component
#     new_solver_assumptions:
#       1: all black pixels belong to one connected simple-path component
#       2: black pixels occupy the first k cells of that path, so their order is inferable
#       3: every traversable component has degree <= 2 at every cell, i.e. no branches
#       4: the destination is a single red endpoint pixel
#     generator_guarantees:
#       1: it draws a non-self-intersecting simple path with spacing >= 3 between coarse rows/cols
#       2: it places black particles on the path prefix only
#       3: unreachable cases are created only by deleting one interior path cell, yielding two simple path components
#       4: the red pixel is always the final path cell and remains visible when unreachable
#   legality_and_visual_cleanliness:
#     non_overlap: particles and destination overwrite distinct path cells
#     bounds: all path construction and edge extensions stay inside the square grid
#     observability:
#       black objects are visibly multiple single pixels, not a square block
#       the river itself is 1-pixel wide, so "size constraint removed" is immediately visible
#       reachable/unreachable examples differ by a visible one-cell break in the river

from __future__ import annotations

from collections import Counter, deque
import random

import numpy as np


_BG, _RIVER, _MOVER, _DEST = 3, 1, 0, 2
_DIR4 = [(1, 0), (-1, 0), (0, 1), (0, -1)]


def _neighbors4(r: int, c: int, h: int, w: int):
    for dr, dc in _DIR4:
        rr = r + dr
        cc = c + dc
        if 0 <= rr < h and 0 <= cc < w:
            yield rr, cc


def _component(mask: np.ndarray, start: tuple[int, int]) -> set[tuple[int, int]]:
    h, w = mask.shape
    q = deque([start])
    seen = {start}
    while q:
        r, c = q.popleft()
        for rr, cc in _neighbors4(r, c, h, w):
            if mask[rr, cc] and (rr, cc) not in seen:
                seen.add((rr, cc))
                q.append((rr, cc))
    return seen


def _bfs_dist(component: set[tuple[int, int]], start: tuple[int, int], h: int, w: int) -> dict[tuple[int, int], int]:
    q = deque([start])
    dist = {start: 0}
    while q:
        r, c = q.popleft()
        for rr, cc in _neighbors4(r, c, h, w):
            pos = (rr, cc)
            if pos in component and pos not in dist:
                dist[pos] = dist[(r, c)] + 1
                q.append(pos)
    return dist


def _degree(component: set[tuple[int, int]], cell: tuple[int, int], h: int, w: int) -> int:
    r, c = cell
    deg = 0
    for rr, cc in _neighbors4(r, c, h, w):
        if (rr, cc) in component:
            deg += 1
    return deg


def _ordered_path(component: set[tuple[int, int]], start_endpoint: tuple[int, int], h: int, w: int) -> list[tuple[int, int]]:
    path = [start_endpoint]
    prev = None
    cur = start_endpoint
    while True:
        nxt = []
        for rr, cc in _neighbors4(cur[0], cur[1], h, w):
            pos = (rr, cc)
            if pos in component and pos != prev:
                nxt.append(pos)
        if not nxt:
            break
        assert len(nxt) == 1
        prev, cur = cur, nxt[0]
        path.append(cur)
    return path


def main(grid: np.ndarray) -> np.ndarray:
    """
    Slide a queue of black single-pixel particles along a winding 1-pixel river.

    Input structure:
    - bg (corner-majority color 3).
    - A blue 1-pixel-wide simple river path.
    - 2-4 black particles on the upstream path prefix.
    - One red destination pixel at the downstream endpoint on the grid edge.

    Rule:
    - Treat river, particles, and destination as traversable.
    - All black particles move together as a queue to the last k cells of the reachable
      path component that contains them, where k is the number of black pixels.
    - If the destination is connected, the lead particle covers the red pixel.
    - If a one-cell river gap disconnects the destination, particles stop before the gap.
    """
    g = np.array(grid, dtype=int)
    h, w = g.shape

    bg = int(Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0])
    particles = [tuple(map(int, rc)) for rc in np.argwhere(g == _MOVER)]
    destinations = [tuple(map(int, rc)) for rc in np.argwhere(g == _DEST)]
    assert particles
    assert len(destinations) == 1

    counts = Counter(map(int, g.flatten()))
    river = None
    for col, _ct in counts.most_common():
        if col == bg or col in (_MOVER, _DEST):
            continue
        river = int(col)
        break
    assert river is not None

    traversable = (g == river) | (g == _MOVER) | (g == _DEST)
    start_component = _component(traversable, particles[0])
    assert all(pos in start_component for pos in particles)

    degrees = {pos: _degree(start_component, pos, h, w) for pos in start_component}
    assert all(deg <= 2 for deg in degrees.values())
    endpoints = [pos for pos, deg in degrees.items() if deg <= 1]
    assert endpoints

    if len(endpoints) == 1:
        start_endpoint = endpoints[0]
    else:
        def endpoint_score(ep: tuple[int, int]) -> tuple[int, int, int]:
            dist = _bfs_dist(start_component, ep, h, w)
            return (
                sum(dist[pos] for pos in particles),
                dist[particles[0]],
                ep[0] + ep[1],
            )

        start_endpoint = min(endpoints, key=endpoint_score)

    path = _ordered_path(start_component, start_endpoint, h, w)
    order = {pos: idx for idx, pos in enumerate(path)}
    particle_indices = sorted(order[pos] for pos in particles)
    k = len(particles)
    assert particle_indices == list(range(k))
    assert len(path) >= k

    out = g.copy()
    for r, c in particles:
        out[r, c] = river
    for r, c in path[-k:]:
        out[r, c] = _MOVER
    return out


def _compute_offsets(size: int, coarse_dim: int) -> list[int] | None:
    if coarse_dim == 1:
        return [1]
    first = 1
    last = size - 2
    if last < first:
        return None
    step = (last - first) / (coarse_dim - 1)
    offsets = [int(round(first + i * step)) for i in range(coarse_dim)]
    if any(offsets[i + 1] - offsets[i] < 3 for i in range(coarse_dim - 1)):
        return None
    return offsets


def _snake_walk(dim: int) -> list[tuple[int, int]]:
    walk = []
    for r in range(dim):
        cols = range(dim) if r % 2 == 0 else range(dim - 1, -1, -1)
        for c in cols:
            walk.append((r, c))
    return walk


def _transform_walk(walk: list[tuple[int, int]], dim: int) -> list[tuple[int, int]]:
    out = list(walk)
    if random.random() < 0.5:
        out = [(c, r) for r, c in out]
    if random.random() < 0.5:
        out = [(dim - 1 - r, c) for r, c in out]
    if random.random() < 0.5:
        out = [(r, dim - 1 - c) for r, c in out]
    return out


def _extend_to_edge(last_cell: tuple[int, int], coarse_end: tuple[int, int], dim: int, size: int) -> list[tuple[int, int]]:
    r, c = last_cell
    cr, cc = coarse_end
    candidates = []
    if cr == 0:
        candidates.append(((-1, 0), r))
    if cr == dim - 1:
        candidates.append(((1, 0), size - 1 - r))
    if cc == 0:
        candidates.append(((0, -1), c))
    if cc == dim - 1:
        candidates.append(((0, 1), size - 1 - c))
    assert candidates
    outward, _ = random.choice(candidates)
    dr, dc = outward
    ext = []
    rr, cc2 = r, c
    while True:
        nr = rr + dr
        nc = cc2 + dc
        if not (0 <= nr < size and 0 <= nc < size):
            break
        ext.append((nr, nc))
        rr, cc2 = nr, nc
    assert ext
    return ext


def _render_path(size: int, walk: list[tuple[int, int]], offsets: list[int]) -> list[tuple[int, int]]:
    centers = [(offsets[r], offsets[c]) for r, c in walk]
    cells = [centers[0]]
    for idx in range(len(centers) - 1):
        r1, c1 = centers[idx]
        r2, c2 = centers[idx + 1]
        dr = 0 if r1 == r2 else (1 if r2 > r1 else -1)
        dc = 0 if c1 == c2 else (1 if c2 > c1 else -1)
        rr, cc = r1, c1
        while (rr, cc) != (r2, c2):
            rr += dr
            cc += dc
            cells.append((rr, cc))
    cells.extend(_extend_to_edge(cells[-1], walk[-1], len(offsets), size))
    assert len(cells) == len(set(cells))
    return cells


def _degrees_ok(path_cells: list[tuple[int, int]], size: int) -> bool:
    cell_set = set(path_cells)
    degs = []
    for cell in cell_set:
        degs.append(_degree(cell_set, cell, size, size))
    return max(degs) <= 2 and sum(deg == 1 for deg in degs) == 2


def _build_expected(grid: np.ndarray, path: list[tuple[int, int]], particle_count: int, gap_idx: int | None) -> np.ndarray:
    out = grid.copy()
    for r, c in path[:particle_count]:
        out[r, c] = _RIVER
    reachable_len = len(path) if gap_idx is None else gap_idx
    for r, c in path[reachable_len - particle_count:reachable_len]:
        out[r, c] = _MOVER
    return out


def _gen_attempt():
    size = random.randint(12, 20)
    coarse_dim = random.randint(4, min(6, max(4, (size - 2) // 3 + 1)))
    offsets = _compute_offsets(size, coarse_dim)
    if offsets is None:
        return None

    walk = _transform_walk(_snake_walk(coarse_dim), coarse_dim)
    path = _render_path(size, walk, offsets)
    if len(path) < 16 or not _degrees_ok(path, size):
        return None

    particle_count = random.randint(2, 4)
    if len(path) < particle_count + 8:
        return None

    reachable = random.random() < 0.55
    gap_idx = None
    if not reachable:
        lo = particle_count + 4
        hi = len(path) - 5
        if lo > hi:
            return None
        gap_idx = random.randint(lo, hi)

    grid = np.full((size, size), _BG, dtype=int)
    skip = {gap_idx} if gap_idx is not None else set()
    for idx, (r, c) in enumerate(path):
        if idx not in skip:
            grid[r, c] = _RIVER

    for r, c in path[:particle_count]:
        grid[r, c] = _MOVER
    dest_r, dest_c = path[-1]
    grid[dest_r, dest_c] = _DEST

    expected = _build_expected(grid, path, particle_count, gap_idx)
    if not np.array_equal(main(grid), expected):
        return None
    return grid


def generate_input():
    for _ in range(300):
        result = _gen_attempt()
        if result is not None:
            return result
    raise RuntimeError("Failed to generate valid input after 300 attempts")

            ```

            ### 参考代码: D10/0

            文件: `/home/lixinyu/snap/new/ceshi/code/332f06d7/D10/0/code.py`

            ```python
            # Variant of 332f06d7
# Dimension: D10 — 多步/多移动体序列 (multi_step)
# Change: 单步操作：一个移动体执行一次移动... → 多移动体顺序移动
#
# Design analysis
# ===============
# variant_spec:
#   core_objects:
#     background: color 3, still dominates the corners
#     river: color 1, still a single winding blue corridor of width n except optional stuck chokepoints
#     destination: one red n×n square at the corridor end
#     movers: 2-4 solid n×n squares of distinct colors, all different from {1,2,3}
#     legend: 2-4 isolated 1×1 colored cells on a straight line, one per mover color, giving visible move order
#   behavior:
#     order_visibility:
#       - The move order is not inferred from numeric color ids.
#       - The legend row/column is the only ordering cue; read it left→right or top→bottom.
#     movement:
#       - Process movers in legend order.
#       - For the current mover, blue river pixels plus its own current square are traversable.
#       - The red destination is also traversable if still visible.
#       - Other mover squares are blockers because earlier movers remain parked.
#       - If the original red destination anchor is reachable and empty, the mover occupies it.
#       - Otherwise it stops at the farthest reachable n×n placement, which on these single-lane corridors
#         means “as far forward as possible until blocked by a chokepoint or an earlier mover”.
#       - The mover's old location becomes blue.
#   concrete_small_example:
#     original_task:
#       - One black 2×2 square moves through the blue path toward one red 2×2 square.
#       - If reachable, output has only that black square at the red position.
#     variant_task:
#       - Suppose there are orange and black 2×2 movers on the same path and the legend shows [orange, black].
#       - Orange moves first and may occupy the red target.
#       - Black moves second on the updated board; because orange now blocks the lane, black stops behind it.
#       - The output therefore contains both colored squares queued near the destination instead of one mover.
#   complexity_calibration:
#     - n is restricted to 2..4 so legend pixels cannot be confused with movers.
#     - There is exactly one destination and one legend marker per mover color.
#     - Corridors remain essentially single-lane, keeping the sequential dependency visible instead of hidden in branches.
#     - Samples require at least one mover whose sequential final position differs from its independent single-mover result.
#   implicit_assumption_audit:
#     old_main_assumptions_broken:
#       - "sort same-sized squares by color and take first two" no longer works because there are >2 movers.
#       - "all pixels of mover color are traversable" is now unsafe because the legend reuses mover colors.
#       - "there is only one move step" no longer holds because later movers see a modified board.
#     new_solver_guards:
#       - Only the n×n component of the active mover color is treated as traversable, never its 1×1 legend marker.
#       - The legend must contain exactly one singleton component for each mover color and lie on one row or one column.
#       - The generator guarantees one red n×n destination, unique mover colors, and n>1.
#   placement_legality:
#     - All movers and the destination are placed on non-overlapping n×n river windows.
#     - Legend pixels are placed on background cells, spaced apart, and never overlap corridor objects.
#     - In stuck cases, the chokepoint is inserted downstream of every mover so all movers stay on the same side of it.
#   visual_observability:
#     - Inputs visibly contain multiple large colored squares plus a separate colored order legend.
#     - Outputs visibly show queueing near the target/chokepoint, making the sequential dependency recoverable from 2-3 examples.
#   cleanliness:
#     - Only three structural layers appear: blue river, large moving squares, tiny legend cells.
#     - No overlapping symbols or hidden color remappings are used.

from __future__ import annotations

from collections import Counter, defaultdict, deque
import random

import numpy as np
from scipy.ndimage import label as scipy_label

from arc_utils import bbox_h, bbox_w, find_components


_BG = 3
_RIVER = 1
_DEST = 2
_MOVER_POOL = [0, 4, 5, 6, 7, 8, 9]
_DIR4 = [(1, 0), (-1, 0), (0, 1), (0, -1)]


def _solid_square_components(g: np.ndarray, bg: int) -> list[dict]:
    squares: list[dict] = []
    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict"):
        col = int(comp["color"])
        b = comp["bbox"]
        if bbox_h(b) != bbox_w(b):
            continue
        patch = g[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1]
        if not bool((patch == int(col)).all()):
            continue
        squares.append(
            {
                "col": col,
                "r0": int(b[0]),
                "c0": int(b[1]),
                "n": int(bbox_h(b)),
                "area": int(comp["area"]),
            }
        )
    return squares


def _locate_color_square(g: np.ndarray, bg: int, color: int, n: int) -> tuple[int, int, np.ndarray]:
    matches = []
    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[color], return_format="dict"):
        b = comp["bbox"]
        if bbox_h(b) != n or bbox_w(b) != n or int(comp["area"]) != n * n:
            continue
        patch = g[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1]
        if not bool((patch == int(color)).all()):
            continue
        mask = np.zeros_like(g, dtype=bool)
        mask[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1] = True
        matches.append((int(b[0]), int(b[1]), mask))
    assert len(matches) == 1
    return matches[0]


def _compute_feasible(trav: np.ndarray, n: int) -> np.ndarray:
    H, W = trav.shape
    h2, w2 = H - n + 1, W - n + 1
    assert h2 > 0 and w2 > 0
    feasible = np.zeros((h2, w2), dtype=bool)
    for r in range(h2):
        for c in range(w2):
            if bool(trav[r : r + n, c : c + n].all()):
                feasible[r, c] = True
    return feasible


def _bfs_placement(feasible: np.ndarray, sr: int, sc: int) -> np.ndarray:
    h2, w2 = feasible.shape
    dist = -np.ones((h2, w2), dtype=int)
    dist[sr, sc] = 0
    q = deque([(sr, sc)])
    while q:
        r, c = q.popleft()
        for dr, dc in _DIR4:
            rr, cc = r + dr, c + dc
            if 0 <= rr < h2 and 0 <= cc < w2 and feasible[rr, cc] and dist[rr, cc] == -1:
                dist[rr, cc] = dist[r, c] + 1
                q.append((rr, cc))
    return dist


def _pick_farthest(dist: np.ndarray, dest_anchor: tuple[int, int], sr: int, sc: int) -> tuple[int, int]:
    dr, dc = dest_anchor
    best = -1
    best_cell = (sr, sc)
    best_tie = (10**9, 10**9)
    for r in range(dist.shape[0]):
        for c in range(dist.shape[1]):
            d = int(dist[r, c])
            if d < 0:
                continue
            tie = (abs(r - dr) + abs(c - dc), abs(r - sr) + abs(c - sc))
            if d > best or (d == best and tie < best_tie):
                best = d
                best_cell = (r, c)
                best_tie = tie
    return best_cell


def _legend_order(g: np.ndarray, bg: int, mover_colors: set[int]) -> list[int]:
    singles: list[tuple[int, int, int]] = []
    for col in mover_colors:
        comps = [
            comp
            for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[col], return_format="dict")
            if int(comp["area"]) == 1
        ]
        assert len(comps) == 1
        r, c = map(int, comps[0]["coords"][0])
        singles.append((r, c, col))
    same_row = len({r for r, _c, _col in singles}) == 1
    same_col = len({c for _r, c, _col in singles}) == 1
    assert same_row or same_col
    if same_row:
        singles.sort(key=lambda item: item[1])
    else:
        singles.sort(key=lambda item: item[0])
    return [col for _r, _c, col in singles]


def _infer_setup(g: np.ndarray) -> tuple[int, int, int, tuple[int, int], list[int], list[int]]:
    bg = int(Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0])
    squares = _solid_square_components(g, bg)
    by_n: dict[int, list[dict]] = defaultdict(list)
    for sq in squares:
        if int(sq["n"]) > 1:
            by_n[int(sq["n"])].append(sq)
    candidates = [(n, comps) for n, comps in by_n.items() if len(comps) >= 3]
    assert candidates
    n, comps = max(candidates, key=lambda item: (len(item[1]), item[0]))
    dests = [sq for sq in comps if int(sq["col"]) == _DEST]
    assert len(dests) == 1
    dest_anchor = (int(dests[0]["r0"]), int(dests[0]["c0"]))
    mover_colors = sorted({int(sq["col"]) for sq in comps if int(sq["col"]) != _DEST})
    assert len(mover_colors) >= 2
    counts = Counter(map(int, g.flatten()))
    river = None
    banned = set(mover_colors) | {_DEST, bg}
    for col, _ct in counts.most_common():
        if int(col) not in banned:
            river = int(col)
            break
    assert river is not None
    order = _legend_order(g, bg, set(mover_colors))
    assert sorted(order) == mover_colors
    return bg, int(n), int(river), dest_anchor, mover_colors, order


def _move_one(out: np.ndarray, bg: int, n: int, river: int, dest_anchor: tuple[int, int], color: int) -> tuple[tuple[int, int], tuple[int, int]]:
    sr, sc, current_mask = _locate_color_square(out, bg, color, n)
    trav = (out == int(river)) | current_mask
    if bool((out == _DEST).any()):
        trav |= (out == _DEST)
    feasible = _compute_feasible(trav, n)
    assert bool(feasible[sr, sc])
    dist = _bfs_placement(feasible, sr, sc)
    dr, dc = dest_anchor
    if 0 <= dr < feasible.shape[0] and 0 <= dc < feasible.shape[1] and feasible[dr, dc] and dist[dr, dc] >= 0:
        tr, tc = dr, dc
    else:
        tr, tc = _pick_farthest(dist, dest_anchor, sr, sc)
    out[current_mask] = int(river)
    out[tr : tr + n, tc : tc + n] = int(color)
    return (sr, sc), (tr, tc)


def _simulate_positions(grid: np.ndarray, persist_blockers: bool) -> tuple[list[int], list[tuple[int, int]]]:
    g = np.array(grid, dtype=int)
    bg, n, river, dest_anchor, _mover_colors, order = _infer_setup(g)
    out = g.copy()
    finals: list[tuple[int, int]] = []
    for color in order:
        if persist_blockers:
            _start, final = _move_one(out, bg, n, river, dest_anchor, color)
            finals.append(final)
            continue

        sr, sc, current_mask = _locate_color_square(out, bg, color, n)
        trav = (out == int(river)) | current_mask
        if bool((out == _DEST).any()):
            trav |= (out == _DEST)
        feasible = _compute_feasible(trav, n)
        dist = _bfs_placement(feasible, sr, sc)
        dr, dc = dest_anchor
        if 0 <= dr < feasible.shape[0] and 0 <= dc < feasible.shape[1] and feasible[dr, dc] and dist[dr, dc] >= 0:
            final = (dr, dc)
        else:
            final = _pick_farthest(dist, dest_anchor, sr, sc)
        finals.append(final)
        out[current_mask] = int(river)
        out[sr : sr + n, sc : sc + n] = int(color)
    return order, finals


def main(grid: np.ndarray) -> np.ndarray:
    g = np.array(grid, dtype=int)
    bg, n, river, dest_anchor, _mover_colors, order = _infer_setup(g)
    out = g.copy()
    for color in order:
        _move_one(out, bg, n, river, dest_anchor, color)
    return out


def _hamiltonian_walk(rows: int, cols: int, start: tuple[int, int], end: tuple[int, int]) -> list[tuple[int, int]] | None:
    total = rows * cols
    best_path = None
    best_len = 0
    for _attempt in range(80):
        visited = {start}
        path = [start]
        cur = start
        while True:
            if cur == end and len(path) >= total * 0.7:
                if len(path) > best_len:
                    best_path = list(path)
                    best_len = len(path)
                break
            neighbors = []
            for dr, dc in _DIR4:
                nr, nc = cur[0] + dr, cur[1] + dc
                if 0 <= nr < rows and 0 <= nc < cols and (nr, nc) not in visited:
                    neighbors.append((nr, nc))
            if not neighbors:
                break
            valid = []
            for nb in neighbors:
                if nb == end:
                    valid.append(nb)
                    continue
                test_visited = visited | {nb}
                seen = {end}
                q = deque([end])
                while q:
                    cr, cc = q.popleft()
                    for dr2, dc2 in _DIR4:
                        nr2, nc2 = cr + dr2, cc + dc2
                        if 0 <= nr2 < rows and 0 <= nc2 < cols and (nr2, nc2) not in test_visited and (nr2, nc2) not in seen:
                            seen.add((nr2, nc2))
                            q.append((nr2, nc2))
                for dr2, dc2 in _DIR4:
                    ar, ac = nb[0] + dr2, nb[1] + dc2
                    if 0 <= ar < rows and 0 <= ac < cols and (ar, ac) not in test_visited and (ar, ac) in seen:
                        valid.append(nb)
                        break
            if not valid:
                break
            random.shuffle(valid)
            nxt = valid[0]
            visited.add(nxt)
            path.append(nxt)
            cur = nxt
        if best_path and best_len >= total * 0.85:
            break
    return best_path


def _render_channel(grid: np.ndarray, path: list[tuple[int, int]], n: int, offsets_r: list[int], offsets_c: list[int]) -> list[tuple[int, int]]:
    pixel_pos = []
    for cr, cc in path:
        pr, pc = offsets_r[cr], offsets_c[cc]
        pixel_pos.append((pr, pc))
        grid[pr : pr + n, pc : pc + n] = _RIVER
    for i in range(len(path) - 1):
        pr1, pc1 = pixel_pos[i]
        pr2, pc2 = pixel_pos[i + 1]
        if pr1 == pr2:
            c_lo, c_hi = min(pc1, pc2), max(pc1, pc2) + n
            grid[pr1 : pr1 + n, c_lo:c_hi] = _RIVER
        else:
            r_lo, r_hi = min(pr1, pr2), max(pr1, pr2) + n
            grid[r_lo:r_hi, pc1 : pc1 + n] = _RIVER
    return pixel_pos


def _add_chokepoint(grid: np.ndarray, pixel_pos_i: tuple[int, int], pixel_pos_j: tuple[int, int], n: int, direction: str) -> None:
    H, W = grid.shape
    pr1, pc1 = pixel_pos_i
    pr2, pc2 = pixel_pos_j
    narrow_w = random.randint(1, n - 1)
    remove = n - narrow_w
    side = random.randint(0, 1)

    if direction == "h":
        c_lo = min(pc1, pc2) + n
        c_hi = max(pc1, pc2)
        if c_hi <= c_lo:
            c_lo, c_hi = min(pc1, pc2), max(pc1, pc2) + n
        hold_len = random.randint(1, min(6, max(1, c_hi - c_lo - 2 * remove)))
        total_len = 2 * remove + max(1, hold_len)
        c_mid = (c_lo + c_hi) // 2
        c_start = max(c_lo, c_mid - total_len // 2)
        for step in range(total_len):
            c = c_start + step
            if not (0 <= c < W):
                continue
            if step < remove:
                depth = step + 1
            elif step >= total_len - remove:
                depth = total_len - step
            else:
                depth = remove
            for k in range(depth):
                rr = pr1 + k if side == 0 else pr1 + n - 1 - k
                if 0 <= rr < H:
                    grid[rr, c] = _BG
    else:
        r_lo = min(pr1, pr2) + n
        r_hi = max(pr1, pr2)
        if r_hi <= r_lo:
            r_lo, r_hi = min(pr1, pr2), max(pr1, pr2) + n
        hold_len = random.randint(1, min(6, max(1, r_hi - r_lo - 2 * remove)))
        total_len = 2 * remove + max(1, hold_len)
        r_mid = (r_lo + r_hi) // 2
        r_start = max(r_lo, r_mid - total_len // 2)
        for step in range(total_len):
            r = r_start + step
            if not (0 <= r < H):
                continue
            if step < remove:
                depth = step + 1
            elif step >= total_len - remove:
                depth = total_len - step
            else:
                depth = remove
            for k in range(depth):
                cc = pc1 + k if side == 0 else pc1 + n - 1 - k
                if 0 <= cc < W:
                    grid[r, cc] = _BG


def _river_connected(grid: np.ndarray) -> bool:
    mask = (grid == _RIVER)
    if not bool(mask.any()):
        return False
    _labeled, num = scipy_label(mask.astype(int))
    return int(num) == 1


def _compute_offsets(G: int, n: int, num_coarse: int) -> list[int] | None:
    if num_coarse == 1:
        return [1]
    first = 1
    last = G - n - 1
    if last < first:
        return None
    step = (last - first) / (num_coarse - 1)
    return [int(round(first + i * step)) for i in range(num_coarse)]


def _extend_to_edge(grid: np.ndarray, pr: int, pc: int, n: int) -> tuple[int, int] | None:
    H, W = grid.shape
    candidates = []
    for direction in ["top", "bottom", "left", "right"]:
        if direction == "top":
            if all(grid[r, c] in (_BG, _RIVER) for r in range(pr) for c in range(pc, pc + n)):
                nr, nc = 0, pc
                dist = pr
                if not ((nr == 0 and nc == 0) or (nr == 0 and nc + n == W)):
                    candidates.append((dist, nr, nc))
        elif direction == "bottom":
            if all(grid[r, c] in (_BG, _RIVER) for r in range(pr + n, H) for c in range(pc, pc + n)):
                nr, nc = H - n, pc
                dist = H - (pr + n)
                if not ((nr + n == H and nc == 0) or (nr + n == H and nc + n == W)):
                    candidates.append((dist, nr, nc))
        elif direction == "left":
            if all(grid[r, c] in (_BG, _RIVER) for r in range(pr, pr + n) for c in range(pc)):
                nr, nc = pr, 0
                dist = pc
                if not ((nr == 0 and nc == 0) or (nr + n == H and nc == 0)):
                    candidates.append((dist, nr, nc))
        else:
            if all(grid[r, c] in (_BG, _RIVER) for r in range(pr, pr + n) for c in range(pc + n, W)):
                nr, nc = pr, W - n
                dist = W - (pc + n)
                if not ((nr == 0 and nc + n == W) or (nr + n == H and nc + n == W)):
                    candidates.append((dist, nr, nc))
    if not candidates:
        return None
    candidates.sort()
    return candidates[0][1], candidates[0][2]


def _pick_mover_indices(pixel_pos: list[tuple[int, int]], H: int, W: int, n: int, reached: bool) -> list[int] | None:
    candidates = [
        idx
        for idx, (r, c) in enumerate(pixel_pos[:-2])
        if 1 <= r <= H - n - 1 and 1 <= c <= W - n - 1
    ]
    if len(candidates) < 2:
        return None
    max_k = min(4, len(candidates))
    for _ in range(60):
        k = random.randint(2, max_k)
        chosen = sorted(random.sample(candidates, k))
        if any(chosen[i + 1] - chosen[i] < 2 for i in range(len(chosen) - 1)):
            continue
        if reached and chosen[-1] > len(pixel_pos) - 4:
            continue
        if not reached and chosen[-1] > len(pixel_pos) - 5:
            continue
        return chosen
    return None


def _place_legend(grid: np.ndarray, colors: list[int]) -> bool:
    H, W = grid.shape
    need = 2 * len(colors) - 1
    rows = [0, H - 1, 1, H - 2]
    cols = [0, W - 1, 1, W - 2]
    for r in rows:
        if not (0 <= r < H):
            continue
        for start in range(0, W - need + 1):
            slots = [(r, start + 2 * i) for i in range(len(colors))]
            if all(grid[rr, cc] == _BG for rr, cc in slots):
                for (rr, cc), col in zip(slots, colors):
                    grid[rr, cc] = int(col)
                return True
    for c in cols:
        if not (0 <= c < W):
            continue
        for start in range(0, H - need + 1):
            slots = [(start + 2 * i, c) for i in range(len(colors))]
            if all(grid[rr, cc] == _BG for rr, cc in slots):
                for (rr, cc), col in zip(slots, colors):
                    grid[rr, cc] = int(col)
                return True
    return False


def _independent_difference_count(grid: np.ndarray) -> int:
    order_seq, finals_seq = _simulate_positions(grid, persist_blockers=True)
    order_ind, finals_ind = _simulate_positions(grid, persist_blockers=False)
    assert order_seq == order_ind
    return sum(int(a != b) for a, b in zip(finals_seq, finals_ind))


def _gen_attempt() -> np.ndarray | None:
    reached = random.random() < 0.5
    n = random.choice([2, 3, 4])
    min_size = max(12, 5 * n)
    if min_size > 20:
        return None
    G = random.randint(min_size, 20)
    H = W = G

    min_spacing = n + 1
    max_coarse = max(4, (G - 2) // min_spacing)
    coarse_dim = random.randint(4, min(6, max_coarse))
    coarse_rows = coarse_cols = coarse_dim

    offsets_r = _compute_offsets(G, n, coarse_rows)
    offsets_c = _compute_offsets(G, n, coarse_cols)
    if offsets_r is None or offsets_c is None:
        return None
    if any(offsets_r[i + 1] - offsets_r[i] < n for i in range(len(offsets_r) - 1)):
        return None
    if any(offsets_c[i + 1] - offsets_c[i] < n for i in range(len(offsets_c) - 1)):
        return None

    edge_cells = set()
    for c in range(coarse_cols):
        edge_cells.add((0, c))
        edge_cells.add((coarse_rows - 1, c))
    for r in range(1, coarse_rows - 1):
        edge_cells.add((r, 0))
        edge_cells.add((r, coarse_cols - 1))
    edge_cells = list(edge_cells)
    random.shuffle(edge_cells)
    start_coarse = edge_cells[0]
    far = sorted(edge_cells, key=lambda e: -(abs(e[0] - start_coarse[0]) + abs(e[1] - start_coarse[1])))
    end_coarse = far[0] if far[0] != start_coarse else far[1]

    walk = _hamiltonian_walk(coarse_rows, coarse_cols, start_coarse, end_coarse)
    if walk is None or len(walk) < 8:
        return None

    grid = np.full((H, W), _BG, dtype=int)
    pixel_pos = _render_channel(grid, walk, n, offsets_r, offsets_c)
    if np.any(grid != _BG, axis=1).sum() / H < 0.60 or np.any(grid != _BG, axis=0).sum() / W < 0.60:
        return None

    dest_r, dest_c = pixel_pos[-1]
    result = _extend_to_edge(grid, dest_r, dest_c, n)
    if result is None:
        return None
    new_dest_r, new_dest_c = result
    if new_dest_r != dest_r:
        r_lo, r_hi = min(new_dest_r, dest_r), max(new_dest_r, dest_r) + n
        grid[r_lo:r_hi, dest_c : dest_c + n] = _RIVER
    if new_dest_c != dest_c:
        c_lo, c_hi = min(new_dest_c, dest_c), max(new_dest_c, dest_c) + n
        grid[dest_r : dest_r + n, c_lo:c_hi] = _RIVER
    dest_r, dest_c = new_dest_r, new_dest_c

    mover_indices = _pick_mover_indices(pixel_pos, H, W, n, reached)
    if mover_indices is None:
        return None

    if not reached:
        lo = mover_indices[-1] + 1
        hi = len(pixel_pos) - 1
        if hi - lo < 1:
            return None
        seg_idx = random.randint(lo, hi - 1)
        pr1, pc1 = pixel_pos[seg_idx]
        pr2, pc2 = pixel_pos[seg_idx + 1]
        direction = "h" if pr1 == pr2 else "v"
        _add_chokepoint(grid, (pr1, pc1), (pr2, pc2), n, direction)
        if not _river_connected(grid):
            return None

    mover_colors = random.sample(_MOVER_POOL, len(mover_indices))
    ordered_colors = [mover_colors[i] for i in range(len(mover_indices) - 1, -1, -1)]

    for r, c in [pixel_pos[idx] for idx in mover_indices]:
        grid[r : r + n, c : c + n] = _RIVER
    grid[dest_r : dest_r + n, dest_c : dest_c + n] = _RIVER

    for idx, color in zip(mover_indices, mover_colors):
        r, c = pixel_pos[idx]
        grid[r : r + n, c : c + n] = int(color)
    grid[dest_r : dest_r + n, dest_c : dest_c + n] = _DEST

    if not _place_legend(grid, ordered_colors):
        return None

    try:
        out = main(grid)
    except Exception:
        return None

    if sorted(set(map(int, grid.flatten())) - {_BG, _RIVER, _DEST}) != sorted(mover_colors):
        return None
    diff_count = _independent_difference_count(grid)
    if diff_count < 1:
        return None
    order, finals = _simulate_positions(grid, persist_blockers=True)
    moved = 0
    for color, (tr, tc) in zip(order, finals):
        sr, sc, _mask = _locate_color_square(grid, _BG, color, n)
        moved += int((sr, sc) != (tr, tc))
    if moved < 2:
        return None
    return grid


def generate_input() -> np.ndarray:
    for _ in range(400):
        result = _gen_attempt()
        if result is not None:
            return result
    raise RuntimeError("Failed to generate valid input after 400 attempts")

