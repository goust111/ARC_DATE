   318	def _simulate_finals(setup: dict, sequential: bool) -> dict[int, int]:
   319	    path_len = len(setup["path"])
   320	    roles = setup["roles"]
   321	    order = setup["order"]
   322	    finals = {color: int(roles[color][1]) for color in roles}
   323	    if not sequential:
   324	        return finals
   325	
   326	    positions = {color: int(roles[color][0]) for color in roles}
   327	    occupied = set(positions.values())
   328	    for color in order:
   329	        cur = positions[color]
   330	        occupied.remove(cur)
   331	        blocker = min((idx for idx in occupied if idx > cur), default=path_len)
   332	        max_reach = blocker - 1
   333	        tgt = int(roles[color][1])
   334	        final = tgt if cur <= tgt <= max_reach else max_reach
   335	        positions[color] = final
   336	        finals[color] = final
   337	        occupied.add(final)
   338	    return finals
