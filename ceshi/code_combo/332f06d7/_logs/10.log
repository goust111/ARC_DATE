    cells = [centers[0]]
    for idx in range(len(centers) - 1):
        r1, c1 = centers[idx]
        r2, c2 = centers[idx + 1]
        dr = 0 if r1 == r2 else (1 if r2 > r1 else -1)
        dc = 0 if c1 == c2 else (1 if c2 > c1 else -1)
