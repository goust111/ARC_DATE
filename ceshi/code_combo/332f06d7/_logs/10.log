            ```python
            # Variant of 332f06d7
# Dimension: D17 — src-dst 基数关系 (meta)
# Change: 1:1 关系——一个移动体对应一个目标... → 多对多配对 (many:many)
#
# Design analysis
# ===============
# a) Concrete variant:
#    - Keep the original visual language: green background, blue winding river, solid n×n colored squares.
#    - Replace the single black mover + single red destination with 2-3 color pairs.
#    - For each pair, the two solid squares have the same color. The interior one is the mover; the border-touching
#      one is the destination. The output is produced by solving each color pair independently on its own river strip.
#    - Small trace:
#      original: one black square BFSes through blue feasible n×n placements toward one red square.
#      variant: colors {yellow, red, pink} may each appear twice; for yellow, BFS uses only {blue, yellow},
#      starts at the non-border yellow square, and aims for the border yellow square. Repeat for each color, then
#      merge the results. The new reasoning step is "which destination belongs to this mover?" and the answer is
#      "the same-colored destination", not "the only destination in the scene".
# b) Complexity calibration:
#    - 2-3 pairs are enough to make the many:many change visible without clutter.
#    - All pairs share the same n, so the original "solid square sliding through n-wide channel" idea remains intact.
#    - Distinct pair colors are sampled from a small ARC palette subset; each color appears exactly twice.
# c) Original-code assumptions that break under D17:
#    - Sorting squares by color and taking the first two as mover/dest is invalid once there are >2 squares.
#    - Treating exactly one mover color and one destination color as traversable is invalid once each pair has its
#      own color and the two role markers share that color.
#    - Writing one moved square is insufficient; we must write all pair results while evaluating each pair against
#      the original input grid, otherwise one move could accidentally open space for another.
# d) Placement legality:
#    - The generator builds separate horizontal river strips with at least one green separator row, so pairs do not
#      overlap and different colors do not merge into one component.
#    - Each color has exactly two n×n solid squares of that size: one border-touching target and one interior mover.
# e) Visual observability:
#    - Across 2-4 examples a human can see that every repeated color comes in a source/target pair, and each source
#      disappears or slides only relative to its own same-colored border square.
#    - Some colors reach the border target; some stop before a chokepoint. This preserves the original motion rule
#      while making the pairing rule explicit.
# f) Visual cleanliness:
#    - Each pair lives in its own strip, so no layered overlaps occur and the blue corridors remain readable.
# g) Color-change inferability:
#    - No hidden color ordering is used. Colors are only used as visible equality labels for pairing.
# h) New solver assumptions:
#    - Among same-sized solid squares, every active color appears exactly twice.
#    - For each active color, exactly one square touches the outer border and exactly one does not.
#    - The generator enforces both conditions directly.

from __future__ import annotations

from collections import Counter, defaultdict, deque
import random
import numpy as np

from arc_utils import bbox_h, bbox_w, find_components


_BG = 3
_RIVER = 1
_PAIR_COLORS = [0, 2, 4, 5, 6, 7, 8, 9]


def _touches_border(r0: int, c0: int, n: int, H: int, W: int) -> bool:
    return r0 == 0 or c0 == 0 or r0 + n == H or c0 + n == W


def _bfs_placement(feasible: np.ndarray, sr: int, sc: int) -> np.ndarray:
    h2, w2 = feasible.shape
    dist = -np.ones((h2, w2), dtype=int)
    dist[sr, sc] = 0
    q = deque([(sr, sc)])
    while q:
        r, c = q.popleft()
        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
            rr, cc = r + dr, c + dc
            if 0 <= rr < h2 and 0 <= cc < w2 and feasible[rr, cc] and dist[rr, cc] == -1:
                dist[rr, cc] = dist[r, c] + 1
                q.append((rr, cc))
    return dist


def _compute_feasible(trav: np.ndarray, n: int) -> np.ndarray:
    H, W = trav.shape
    h2, w2 = H - n + 1, W - n + 1
    assert h2 > 0 and w2 > 0
    feasible = np.zeros((h2, w2), dtype=bool)
    for r in range(h2):
        for c in range(w2):
            if bool(trav[r : r + n, c : c + n].all()):
                feasible[r, c] = True
    return feasible


def _solve_pair_position(
    g: np.ndarray, river: int, color: int, n: int, sr: int, sc: int, dr: int, dc: int
) -> tuple[int, int, bool]:
    trav = (g == river) | (g == color)
    feasible = _compute_feasible(trav, n)
    assert feasible[sr, sc]
    dist = _bfs_placement(feasible, sr, sc)
    if 0 <= dr < feasible.shape[0] and 0 <= dc < feasible.shape[1] and feasible[dr, dc] and dist[dr, dc] >= 0:
        return dr, dc, True

    best = -1
    tr, tc = sr, sc
    for r in range(feasible.shape[0]):
        for c in range(feasible.shape[1]):
            if dist[r, c] > best:
                best = int(dist[r, c])
                tr, tc = r, c
    return tr, tc, False


def _detect_pairs(g: np.ndarray) -> tuple[int, int, int, list[dict]]:
    H, W = g.shape
    bg = int(Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0])

    squares: list[dict] = []
    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict"):
        col = int(comp["color"])
        if col == _RIVER:
            continue
        b = comp["bbox"]
        if bbox_h(b) != bbox_w(b):
            continue
        patch = g[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1]
        if not bool((patch == col).all()):
            continue
        squares.append({"col": col, "r0": int(b[0]), "c0": int(b[1]), "n": int(bbox_h(b))})

    by_n: dict[int, list[dict]] = defaultdict(list)
    for sq in squares:
        by_n[int(sq["n"])].append(sq)
    valid = [(n, items) for n, items in by_n.items() if len(items) >= 4]
    assert valid
    nside, cand = max(valid, key=lambda kv: (len(kv[1]), kv[0]))

    by_col: dict[int, list[dict]] = defaultdict(list)
    for sq in cand:
        by_col[int(sq["col"])].append(sq)

    pairs: list[dict] = []
    for col, items in by_col.items():
        if len(items) != 2:
            continue
        edge = [sq for sq in items if _touches_border(int(sq["r0"]), int(sq["c0"]), int(sq["n"]), H, W)]
        inner = [sq for sq in items if not _touches_border(int(sq["r0"]), int(sq["c0"]), int(sq["n"]), H, W)]
        if len(edge) != 1 or len(inner) != 1:
            continue
        mover = inner[0]
        dest = edge[0]
        pairs.append(
            {
                "col": int(col),
                "n": int(nside),
                "sr": int(mover["r0"]),
                "sc": int(mover["c0"]),
                "dr": int(dest["r0"]),
                "dc": int(dest["c0"]),
            }
        )

    assert len(pairs) >= 2
    counts = Counter(map(int, g.flatten()))
    river = None
    pair_colors = {int(p["col"]) for p in pairs}
    for col, _ in counts.most_common():
        if int(col) == bg or int(col) in pair_colors:
            continue
        river = int(col)
        break
    assert river is not None
    return bg, river, int(nside), sorted(pairs, key=lambda p: int(p["col"]))


def main(grid: np.ndarray) -> np.ndarray:
    g = np.array(grid, dtype=int)
    _bg, river, n, pairs = _detect_pairs(g)

    out = g.copy()
    for pair in pairs:
        sr, sc = int(pair["sr"]), int(pair["sc"])
        dr, dc = int(pair["dr"]), int(pair["dc"])
        color = int(pair["col"])
        tr, tc, _ = _solve_pair_position(g, river, color, n, sr, sc, dr, dc)
        out[sr : sr + n, sc : sc + n] = river
        out[tr : tr + n, tc : tc + n] = color
    return out


def _compute_offsets(length: int, n: int, count: int) -> list[int] | None:
    if count == 1:
        return [1]
    first = 1
    last = length - n - 1
    if last < first:
        return None
    step = (last - first) / (count - 1)
    return [int(round(first + i * step)) for i in range(count)]


def _render_channel(grid: np.ndarray, path: list[tuple[int, int]], n: int, row_offsets: list[int], col_offsets: list[int]):
    pixel_pos: list[tuple[int, int]] = []
    for rr, cc in path:
        pr, pc = row_offsets[rr], col_offsets[cc]
        pixel_pos.append((pr, pc))
        grid[pr : pr + n, pc : pc + n] = _RIVER
    for i in range(len(path) - 1):
        pr1, pc1 = pixel_pos[i]
        pr2, pc2 = pixel_pos[i + 1]
        if pr1 == pr2:
            c_lo, c_hi = min(pc1, pc2), max(pc1, pc2) + n
            grid[pr1 : pr1 + n, c_lo:c_hi] = _RIVER
        else:
            r_lo, r_hi = min(pr1, pr2), max(pr1, pr2) + n
            grid[r_lo:r_hi, pc1 : pc1 + n] = _RIVER
    return pixel_pos


def _add_chokepoint(grid: np.ndarray, pixel_pos_i: tuple[int, int], pixel_pos_j: tuple[int, int], n: int, direction: str) -> None:
    H, W = grid.shape
    pr1, pc1 = pixel_pos_i
    pr2, pc2 = pixel_pos_j
    narrow_w = random.randint(1, n - 1)
    remove = n - narrow_w
    side = random.randint(0, 1)

    if direction == "h":
        c_lo = min(pc1, pc2) + n
        c_hi = max(pc1, pc2)
        if c_hi <= c_lo:
            c_lo, c_hi = min(pc1, pc2), max(pc1, pc2) + n
        hold_len = random.randint(1, min(6, max(1, c_hi - c_lo - 2 * remove)))
        total_len = 2 * remove + hold_len
        c_mid = (c_lo + c_hi) // 2
        c_start = max(c_lo, c_mid - total_len // 2)
        for step in range(total_len):
            c = c_start + step
            if not (0 <= c < W):
                continue
            if step < remove:
                depth = step + 1
            elif step >= total_len - remove:
                depth = total_len - step
            else:
                depth = remove
            for k in range(depth):
                rr = pr1 + k if side == 0 else pr1 + n - 1 - k
                if 0 <= rr < H:
                    grid[rr, c] = _BG
    else:
        r_lo = min(pr1, pr2) + n
        r_hi = max(pr1, pr2)
        if r_hi <= r_lo:
            r_lo, r_hi = min(pr1, pr2), max(pr1, pr2) + n
        hold_len = random.randint(1, min(6, max(1, r_hi - r_lo - 2 * remove)))
        total_len = 2 * remove + hold_len
        r_mid = (r_lo + r_hi) // 2
        r_start = max(r_lo, r_mid - total_len // 2)
        for step in range(total_len):
            r = r_start + step
            if not (0 <= r < H):
                continue
            if step < remove:
                depth = step + 1
            elif step >= total_len - remove:
                depth = total_len - step
            else:
                depth = remove
            for k in range(depth):
                cc = pc1 + k if side == 0 else pc1 + n - 1 - k
                if 0 <= cc < W:
                    grid[r, cc] = _BG


def _make_band_walk(cols: int, reverse: bool) -> list[tuple[int, int]]:
    for _ in range(60):
        row = random.randint(0, 1)
        path = [(row, 0)]
        flips = 0
        for c in range(cols - 1):
            if c < cols - 2 and random.random() < 0.8:
                row = 1 - row
                path.append((row, c))
                flips += 1
            path.append((row, c + 1))
        if flips >= 2:
            break
    else:
        row = 0
        path = [(0, 0)]
        for c in range(cols - 1):
            row = 1 - row
            path.append((row, c))
            path.append((row, c + 1))

    if reverse:
        return [(r, cols - 1 - c) for r, c in path]
    return path


def _band_rows(top: int, band_h: int, n: int) -> list[int]:
    return [top + 1, top + band_h - n - 1]


def _place_band(
    grid: np.ndarray,
    top: int,
    band_h: int,
    n: int,
    color: int,
    reached: bool,
    reverse: bool,
) -> dict | None:
    G = grid.shape[1]
    possible_cols = []
    for cols in range(4, 8):
        offsets = _compute_offsets(G, n, cols)
        if offsets is None:
            continue
        if all(offsets[i + 1] - offsets[i] >= n for i in range(cols - 1)):
            possible_cols.append(cols)
    if not possible_cols:
        return None

    cols = random.choice(possible_cols)
    col_offsets = _compute_offsets(G, n, cols)
    assert col_offsets is not None
    row_offsets = _band_rows(top, band_h, n)
    if row_offsets[1] - row_offsets[0] < n:
        return None

    path = _make_band_walk(cols, reverse)
    pixel_pos = _render_channel(grid, path, n, row_offsets, col_offsets)

    mover_r, mover_c = pixel_pos[0]
    dest_r, dest_c = pixel_pos[-1]
    new_dest_c = 0 if reverse else G - n
    c_lo, c_hi = min(dest_c, new_dest_c), max(dest_c, new_dest_c) + n
    grid[dest_r : dest_r + n, c_lo:c_hi] = _RIVER
    dest_c = new_dest_c

    if not reached and n >= 2:
        horiz = [i for i in range(1, len(pixel_pos) - 1) if pixel_pos[i][0] == pixel_pos[i + 1][0]]
        if not horiz:
            return None
        random.shuffle(horiz)
        num_chokes = random.randint(1, min(2, len(horiz)))
        for idx in horiz[:num_chokes]:
            _add_chokepoint(grid, pixel_pos[idx], pixel_pos[idx + 1], n, "h")

    grid[mover_r : mover_r + n, mover_c : mover_c + n] = color
    grid[dest_r : dest_r + n, dest_c : dest_c + n] = color
    return {"color": color, "sr": mover_r, "sc": mover_c, "dr": dest_r, "dc": dest_c, "reached": reached}


def _gen_attempt() -> np.ndarray | None:
    n = random.choice([1, 2, 3])
    pair_count = 2 if n == 3 else random.choice([2, 3])
    band_h = 2 * n + 2
    required_h = pair_count * band_h + (pair_count - 1)
    min_size = max(required_h, 12)
    if min_size > 20:
        return None
    G = random.randint(min_size, 20)

    grid = np.full((G, G), _BG, dtype=int)
    colors = random.sample(_PAIR_COLORS, pair_count)
    states = [True] * pair_count if n == 1 else [random.random() < 0.5 for _ in range(pair_count)]
    if n >= 2 and pair_count >= 2 and all(states):
        states[random.randrange(pair_count)] = False

    top_margin = (G - required_h) // 2
    for idx in range(pair_count):
        top = top_margin + idx * (band_h + 1)
        reverse = bool(random.getrandbits(1))
        info = _place_band(grid, top, band_h, n, colors[idx], states[idx], reverse)
        if info is None:
            return None

    if Counter([int(grid[0, 0]), int(grid[0, -1]), int(grid[-1, 0]), int(grid[-1, -1])]).most_common(1)[0][0] != _BG:
        return None

    # Structural guarantees expected by main().
    _bg, river, n2, pairs = _detect_pairs(grid)
    if river != _RIVER or n2 != n or len(pairs) != pair_count:
        return None

    reached_count = 0
    stuck_count = 0
    for pair in pairs:
        tr, tc, ok = _solve_pair_position(grid, river, int(pair["col"]), n, int(pair["sr"]), int(pair["sc"]), int(pair["dr"]), int(pair["dc"]))
        if ok:
            reached_count += 1
            if (tr, tc) != (int(pair["dr"]), int(pair["dc"])):
                return None
        else:
            stuck_count += 1
            if n == 1:
                return None
            if (tr, tc) == (int(pair["dr"]), int(pair["dc"])):
                return None

    if n >= 2 and reached_count == 0:
        return None
    if len({int(p["col"]) for p in pairs}) < 2:
        return None

    out = main(grid)
    if out.shape != grid.shape:
        return None
    return grid


def generate_input() -> np.ndarray:
    for _ in range(400):
        result = _gen_attempt()
        if result is not None:
            return result
    raise RuntimeError("Failed to generate valid input after 400 attempts")

