# Variant of 332f06d7
# Dimension: D10 — 多步/多移动体序列 (multi_step)
# Change: 单步操作：一个移动体执行一次移动... → 多移动体顺序移动
#
# Design analysis
# ===============
# variant_spec:
#   core_objects:
#     background: color 3, still dominates the corners
#     river: color 1, still a single winding blue corridor of width n except optional stuck chokepoints
#     destination: one red n×n square at the corridor end
#     movers: 2-4 solid n×n squares of distinct colors, all different from {1,2,3}
#     legend: 2-4 isolated 1×1 colored cells on a straight line, one per mover color, giving visible move order
#   behavior:
#     order_visibility:
#       - The move order is not inferred from numeric color ids.
#       - The legend row/column is the only ordering cue; read it left→right or top→bottom.
#     movement:
#       - Process movers in legend order.
#       - For the current mover, blue river pixels plus its own current square are traversable.
#       - The red destination is also traversable if still visible.
#       - Other mover squares are blockers because earlier movers remain parked.
#       - If the original red destination anchor is reachable and empty, the mover occupies it.
#       - Otherwise it stops at the farthest reachable n×n placement, which on these single-lane corridors
#         means “as far forward as possible until blocked by a chokepoint or an earlier mover”.
#       - The mover's old location becomes blue.
#   concrete_small_example:
#     original_task:
#       - One black 2×2 square moves through the blue path toward one red 2×2 square.
#       - If reachable, output has only that black square at the red position.
#     variant_task:
#       - Suppose there are orange and black 2×2 movers on the same path and the legend shows [orange, black].
#       - Orange moves first and may occupy the red target.
#       - Black moves second on the updated board; because orange now blocks the lane, black stops behind it.
#       - The output therefore contains both colored squares queued near the destination instead of one mover.
#   complexity_calibration:
#     - n is restricted to 2..4 so legend pixels cannot be confused with movers.
#     - There is exactly one destination and one legend marker per mover color.
#     - Corridors remain essentially single-lane, keeping the sequential dependency visible instead of hidden in branches.
#     - Samples require at least one mover whose sequential final position differs from its independent single-mover result.
#   implicit_assumption_audit:
#     old_main_assumptions_broken:
#       - "sort same-sized squares by color and take first two" no longer works because there are >2 movers.
#       - "all pixels of mover color are traversable" is now unsafe because the legend reuses mover colors.
#       - "there is only one move step" no longer holds because later movers see a modified board.
#     new_solver_guards:
#       - Only the n×n component of the active mover color is treated as traversable, never its 1×1 legend marker.
#       - The legend must contain exactly one singleton component for each mover color and lie on one row or one column.
#       - The generator guarantees one red n×n destination, unique mover colors, and n>1.
#   placement_legality:
#     - All movers and the destination are placed on non-overlapping n×n river windows.
#     - Legend pixels are placed on background cells, spaced apart, and never overlap corridor objects.
#     - In stuck cases, the chokepoint is inserted downstream of every mover so all movers stay on the same side of it.
#   visual_observability:
#     - Inputs visibly contain multiple large colored squares plus a separate colored order legend.
#     - Outputs visibly show queueing near the target/chokepoint, making the sequential dependency recoverable from 2-3 examples.
#   cleanliness:
#     - Only three structural layers appear: blue river, large moving squares, tiny legend cells.
#     - No overlapping symbols or hidden color remappings are used.

from __future__ import annotations

from collections import Counter, defaultdict, deque
import random

import numpy as np
from scipy.ndimage import label as scipy_label

from arc_utils import bbox_h, bbox_w, find_components


_BG = 3
_RIVER = 1
_DEST = 2
_MOVER_POOL = [0, 4, 5, 6, 7, 8, 9]
_DIR4 = [(1, 0), (-1, 0), (0, 1), (0, -1)]


def _solid_square_components(g: np.ndarray, bg: int) -> list[dict]:
    squares: list[dict] = []
    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict"):
        col = int(comp["color"])
        b = comp["bbox"]
        if bbox_h(b) != bbox_w(b):
            continue
        patch = g[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1]
        if not bool((patch == int(col)).all()):
            continue
        squares.append(
            {
                "col": col,
                "r0": int(b[0]),
                "c0": int(b[1]),
                "n": int(bbox_h(b)),
                "area": int(comp["area"]),
            }
        )
    return squares


def _locate_color_square(g: np.ndarray, bg: int, color: int, n: int) -> tuple[int, int, np.ndarray]:
    matches = []
    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[color], return_format="dict"):
        b = comp["bbox"]
        if bbox_h(b) != n or bbox_w(b) != n or int(comp["area"]) != n * n:
            continue
        patch = g[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1]
        if not bool((patch == int(color)).all()):
            continue
        mask = np.zeros_like(g, dtype=bool)
        mask[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1] = True
        matches.append((int(b[0]), int(b[1]), mask))
    assert len(matches) == 1
    return matches[0]


def _compute_feasible(trav: np.ndarray, n: int) -> np.ndarray:
    H, W = trav.shape
    h2, w2 = H - n + 1, W - n + 1
    assert h2 > 0 and w2 > 0
    feasible = np.zeros((h2, w2), dtype=bool)
    for r in range(h2):
        for c in range(w2):
            if bool(trav[r : r + n, c : c + n].all()):
                feasible[r, c] = True
    return feasible


def _bfs_placement(feasible: np.ndarray, sr: int, sc: int) -> np.ndarray:
    h2, w2 = feasible.shape
    dist = -np.ones((h2, w2), dtype=int)
    dist[sr, sc] = 0
    q = deque([(sr, sc)])
    while q:
        r, c = q.popleft()
        for dr, dc in _DIR4:
            rr, cc = r + dr, c + dc
            if 0 <= rr < h2 and 0 <= cc < w2 and feasible[rr, cc] and dist[rr, cc] == -1:
                dist[rr, cc] = dist[r, c] + 1
                q.append((rr, cc))
    return dist


def _pick_farthest(dist: np.ndarray, dest_anchor: tuple[int, int], sr: int, sc: int) -> tuple[int, int]:
    dr, dc = dest_anchor
    best = -1
    best_cell = (sr, sc)
    best_tie = (10**9, 10**9)
    for r in range(dist.shape[0]):
        for c in range(dist.shape[1]):
            d = int(dist[r, c])
            if d < 0:
                continue
            tie = (abs(r - dr) + abs(c - dc), abs(r - sr) + abs(c - sc))
            if d > best or (d == best and tie < best_tie):
                best = d
                best_cell = (r, c)
                best_tie = tie
    return best_cell


def _legend_order(g: np.ndarray, bg: int, mover_colors: set[int]) -> list[int]:
    singles: list[tuple[int, int, int]] = []
    for col in mover_colors:
        comps = [
            comp
            for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[col], return_format="dict")
            if int(comp["area"]) == 1
        ]
        assert len(comps) == 1
        r, c = map(int, comps[0]["coords"][0])
        singles.append((r, c, col))
    same_row = len({r for r, _c, _col in singles}) == 1
    same_col = len({c for _r, c, _col in singles}) == 1
    assert same_row or same_col
    if same_row:
        singles.sort(key=lambda item: item[1])
    else:
        singles.sort(key=lambda item: item[0])
    return [col for _r, _c, col in singles]


def _infer_setup(g: np.ndarray) -> tuple[int, int, int, tuple[int, int], list[int], list[int]]:
    bg = int(Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0])
    squares = _solid_square_components(g, bg)
    by_n: dict[int, list[dict]] = defaultdict(list)
    for sq in squares:
        if int(sq["n"]) > 1:
            by_n[int(sq["n"])].append(sq)
    candidates = [(n, comps) for n, comps in by_n.items() if len(comps) >= 3]
    assert candidates
    n, comps = max(candidates, key=lambda item: (len(item[1]), item[0]))
    dests = [sq for sq in comps if int(sq["col"]) == _DEST]
    assert len(dests) == 1
    dest_anchor = (int(dests[0]["r0"]), int(dests[0]["c0"]))
    mover_colors = sorted({int(sq["col"]) for sq in comps if int(sq["col"]) != _DEST})
    assert len(mover_colors) >= 2
    counts = Counter(map(int, g.flatten()))
    river = None
    banned = set(mover_colors) | {_DEST, bg}
    for col, _ct in counts.most_common():
        if int(col) not in banned:
            river = int(col)
            break
    assert river is not None
    order = _legend_order(g, bg, set(mover_colors))
    assert sorted(order) == mover_colors
    return bg, int(n), int(river), dest_anchor, mover_colors, order


def _move_one(out: np.ndarray, bg: int, n: int, river: int, dest_anchor: tuple[int, int], color: int) -> tuple[tuple[int, int], tuple[int, int]]:
    sr, sc, current_mask = _locate_color_square(out, bg, color, n)
    trav = (out == int(river)) | current_mask
    if bool((out == _DEST).any()):
        trav |= (out == _DEST)
    feasible = _compute_feasible(trav, n)
    assert bool(feasible[sr, sc])
    dist = _bfs_placement(feasible, sr, sc)
    dr, dc = dest_anchor
    if 0 <= dr < feasible.shape[0] and 0 <= dc < feasible.shape[1] and feasible[dr, dc] and dist[dr, dc] >= 0:
        tr, tc = dr, dc
    else:
        tr, tc = _pick_farthest(dist, dest_anchor, sr, sc)
    out[current_mask] = int(river)
    out[tr : tr + n, tc : tc + n] = int(color)
    return (sr, sc), (tr, tc)


def _simulate_positions(grid: np.ndarray, persist_blockers: bool) -> tuple[list[int], list[tuple[int, int]]]:
    g = np.array(grid, dtype=int)
    bg, n, river, dest_anchor, _mover_colors, order = _infer_setup(g)
    out = g.copy()
    finals: list[tuple[int, int]] = []
    for color in order:
        if persist_blockers:
            _start, final = _move_one(out, bg, n, river, dest_anchor, color)
            finals.append(final)
            continue

        sr, sc, current_mask = _locate_color_square(out, bg, color, n)
        trav = (out == int(river)) | current_mask
        if bool((out == _DEST).any()):
            trav |= (out == _DEST)
        feasible = _compute_feasible(trav, n)
        dist = _bfs_placement(feasible, sr, sc)
        dr, dc = dest_anchor
        if 0 <= dr < feasible.shape[0] and 0 <= dc < feasible.shape[1] and feasible[dr, dc] and dist[dr, dc] >= 0:
            final = (dr, dc)
        else:
            final = _pick_farthest(dist, dest_anchor, sr, sc)
        finals.append(final)
        out[current_mask] = int(river)
        out[sr : sr + n, sc : sc + n] = int(color)
    return order, finals


def main(grid: np.ndarray) -> np.ndarray:
    g = np.array(grid, dtype=int)
    bg, n, river, dest_anchor, _mover_colors, order = _infer_setup(g)
    out = g.copy()
    for color in order:
        _move_one(out, bg, n, river, dest_anchor, color)
    return out


