def _add_chokepoint(grid: np.ndarray, pixel_pos_i: tuple[int, int], pixel_pos_j: tuple[int, int], n: int, direction: str) -> None:
    H, W = grid.shape
    pr1, pc1 = pixel_pos_i
    pr2, pc2 = pixel_pos_j
    narrow_w = random.randint(1, n - 1)
    remove = n - narrow_w
    side = random.randint(0, 1)

    if direction == "h":
        c_lo = min(pc1, pc2) + n
        c_hi = max(pc1, pc2)
        if c_hi <= c_lo:
            c_lo, c_hi = min(pc1, pc2), max(pc1, pc2) + n
        hold_len = random.randint(1, min(6, max(1, c_hi - c_lo - 2 * remove)))
        total_len = 2 * remove + max(1, hold_len)
        c_mid = (c_lo + c_hi) // 2
        c_start = max(c_lo, c_mid - total_len // 2)
        for step in range(total_len):
            c = c_start + step
            if not (0 <= c < W):
                continue
            if step < remove:
                depth = step + 1
            elif step >= total_len - remove:
                depth = total_len - step
            else:
                depth = remove
            for k in range(depth):
                rr = pr1 + k if side == 0 else pr1 + n - 1 - k
                if 0 <= rr < H:
                    grid[rr, c] = _BG
    else:
        r_lo = min(pr1, pr2) + n
        r_hi = max(pr1, pr2)
        if r_hi <= r_lo:
            r_lo, r_hi = min(pr1, pr2), max(pr1, pr2) + n
        hold_len = random.randint(1, min(6, max(1, r_hi - r_lo - 2 * remove)))
        total_len = 2 * remove + max(1, hold_len)
        r_mid = (r_lo + r_hi) // 2
        r_start = max(r_lo, r_mid - total_len // 2)
        for step in range(total_len):
            r = r_start + step
            if not (0 <= r < H):
                continue
            if step < remove:
                depth = step + 1
            elif step >= total_len - remove:
                depth = total_len - step
            else:
                depth = remove
            for k in range(depth):
                cc = pc1 + k if side == 0 else pc1 + n - 1 - k
                if 0 <= cc < W:
                    grid[r, cc] = _BG


def _river_connected(grid: np.ndarray) -> bool:
    mask = (grid == _RIVER)
    if not bool(mask.any()):
        return False
    _labeled, num = scipy_label(mask.astype(int))
    return int(num) == 1


def _compute_offsets(G: int, n: int, num_coarse: int) -> list[int] | None:
    if num_coarse == 1:
        return [1]
    first = 1
    last = G - n - 1
    if last < first:
        return None
    step = (last - first) / (num_coarse - 1)
    return [int(round(first + i * step)) for i in range(num_coarse)]


def _extend_to_edge(grid: np.ndarray, pr: int, pc: int, n: int) -> tuple[int, int] | None:
    H, W = grid.shape
    candidates = []
    for direction in ["top", "bottom", "left", "right"]:
        if direction == "top":
            if all(grid[r, c] in (_BG, _RIVER) for r in range(pr) for c in range(pc, pc + n)):
                nr, nc = 0, pc
                dist = pr
                if not ((nr == 0 and nc == 0) or (nr == 0 and nc + n == W)):
                    candidates.append((dist, nr, nc))
        elif direction == "bottom":
            if all(grid[r, c] in (_BG, _RIVER) for r in range(pr + n, H) for c in range(pc, pc + n)):
                nr, nc = H - n, pc
                dist = H - (pr + n)
                if not ((nr + n == H and nc == 0) or (nr + n == H and nc + n == W)):
                    candidates.append((dist, nr, nc))
        elif direction == "left":
            if all(grid[r, c] in (_BG, _RIVER) for r in range(pr, pr + n) for c in range(pc)):
                nr, nc = pr, 0
                dist = pc
                if not ((nr == 0 and nc == 0) or (nr + n == H and nc == 0)):
                    candidates.append((dist, nr, nc))
        else:
            if all(grid[r, c] in (_BG, _RIVER) for r in range(pr, pr + n) for c in range(pc + n, W)):
                nr, nc = pr, W - n
                dist = W - (pc + n)
                if not ((nr == 0 and nc + n == W) or (nr + n == H and nc + n == W)):
                    candidates.append((dist, nr, nc))
    if not candidates:
        return None
    candidates.sort()
    return candidates[0][1], candidates[0][2]


def _pick_mover_indices(pixel_pos: list[tuple[int, int]], H: int, W: int, n: int, reached: bool) -> list[int] | None:
    candidates = [
        idx
        for idx, (r, c) in enumerate(pixel_pos[:-2])
        if 1 <= r <= H - n - 1 and 1 <= c <= W - n - 1
    ]
    if len(candidates) < 2:
        return None
    max_k = min(4, len(candidates))
    for _ in range(60):
        k = random.randint(2, max_k)
        chosen = sorted(random.sample(candidates, k))
        if any(chosen[i + 1] - chosen[i] < 2 for i in range(len(chosen) - 1)):
            continue
        if reached and chosen[-1] > len(pixel_pos) - 4:
            continue
        if not reached and chosen[-1] > len(pixel_pos) - 5:
            continue
        return chosen
    return None


def _place_legend(grid: np.ndarray, colors: list[int]) -> bool:
    H, W = grid.shape
    need = 2 * len(colors) - 1
    rows = [0, H - 1, 1, H - 2]
    cols = [0, W - 1, 1, W - 2]
    for r in rows:
        if not (0 <= r < H):
            continue
        for start in range(0, W - need + 1):
            slots = [(r, start + 2 * i) for i in range(len(colors))]
            if all(grid[rr, cc] == _BG for rr, cc in slots):
                for (rr, cc), col in zip(slots, colors):
                    grid[rr, cc] = int(col)
                return True
    for c in cols:
        if not (0 <= c < W):
            continue
        for start in range(0, H - need + 1):
            slots = [(start + 2 * i, c) for i in range(len(colors))]
            if all(grid[rr, cc] == _BG for rr, cc in slots):
                for (rr, cc), col in zip(slots, colors):
                    grid[rr, cc] = int(col)
                return True
    return False


def _independent_difference_count(grid: np.ndarray) -> int:
    order_seq, finals_seq = _simulate_positions(grid, persist_blockers=True)
    order_ind, finals_ind = _simulate_positions(grid, persist_blockers=False)
    assert order_seq == order_ind
    return sum(int(a != b) for a, b in zip(finals_seq, finals_ind))


def _gen_attempt() -> np.ndarray | None:
    reached = random.random() < 0.5
    n = random.choice([2, 3, 4])
    min_size = max(12, 5 * n)
    if min_size > 20:
        return None
    G = random.randint(min_size, 20)
    H = W = G

    min_spacing = n + 1
    max_coarse = max(4, (G - 2) // min_spacing)
    coarse_dim = random.randint(4, min(6, max_coarse))
    coarse_rows = coarse_cols = coarse_dim

    offsets_r = _compute_offsets(G, n, coarse_rows)
    offsets_c = _compute_offsets(G, n, coarse_cols)
    if offsets_r is None or offsets_c is None:
        return None
    if any(offsets_r[i + 1] - offsets_r[i] < n for i in range(len(offsets_r) - 1)):
        return None
    if any(offsets_c[i + 1] - offsets_c[i] < n for i in range(len(offsets_c) - 1)):
        return None

    edge_cells = set()
    for c in range(coarse_cols):
        edge_cells.add((0, c))
        edge_cells.add((coarse_rows - 1, c))
    for r in range(1, coarse_rows - 1):
        edge_cells.add((r, 0))
        edge_cells.add((r, coarse_cols - 1))
    edge_cells = list(edge_cells)
    random.shuffle(edge_cells)
    start_coarse = edge_cells[0]
    far = sorted(edge_cells, key=lambda e: -(abs(e[0] - start_coarse[0]) + abs(e[1] - start_coarse[1])))
    end_coarse = far[0] if far[0] != start_coarse else far[1]

    walk = _hamiltonian_walk(coarse_rows, coarse_cols, start_coarse, end_coarse)
    if walk is None or len(walk) < 8:
        return None

    grid = np.full((H, W), _BG, dtype=int)
    pixel_pos = _render_channel(grid, walk, n, offsets_r, offsets_c)
    if np.any(grid != _BG, axis=1).sum() / H < 0.60 or np.any(grid != _BG, axis=0).sum() / W < 0.60:
        return None

    dest_r, dest_c = pixel_pos[-1]
    result = _extend_to_edge(grid, dest_r, dest_c, n)
    if result is None:
        return None
    new_dest_r, new_dest_c = result
    if new_dest_r != dest_r:
        r_lo, r_hi = min(new_dest_r, dest_r), max(new_dest_r, dest_r) + n
        grid[r_lo:r_hi, dest_c : dest_c + n] = _RIVER
    if new_dest_c != dest_c:
        c_lo, c_hi = min(new_dest_c, dest_c), max(new_dest_c, dest_c) + n
        grid[dest_r : dest_r + n, c_lo:c_hi] = _RIVER
    dest_r, dest_c = new_dest_r, new_dest_c

    mover_indices = _pick_mover_indices(pixel_pos, H, W, n, reached)
    if mover_indices is None:
        return None

    if not reached:
        lo = mover_indices[-1] + 1
        hi = len(pixel_pos) - 1
        if hi - lo < 1:
            return None
        seg_idx = random.randint(lo, hi - 1)
        pr1, pc1 = pixel_pos[seg_idx]
        pr2, pc2 = pixel_pos[seg_idx + 1]
        direction = "h" if pr1 == pr2 else "v"
        _add_chokepoint(grid, (pr1, pc1), (pr2, pc2), n, direction)
        if not _river_connected(grid):
            return None

    mover_colors = random.sample(_MOVER_POOL, len(mover_indices))
    ordered_colors = [mover_colors[i] for i in range(len(mover_indices) - 1, -1, -1)]

    for r, c in [pixel_pos[idx] for idx in mover_indices]:
        grid[r : r + n, c : c + n] = _RIVER
    grid[dest_r : dest_r + n, dest_c : dest_c + n] = _RIVER

    for idx, color in zip(mover_indices, mover_colors):
        r, c = pixel_pos[idx]
        grid[r : r + n, c : c + n] = int(color)
    grid[dest_r : dest_r + n, dest_c : dest_c + n] = _DEST

    if not _place_legend(grid, ordered_colors):
        return None

    try:
        out = main(grid)
    except Exception:
        return None

    if sorted(set(map(int, grid.flatten())) - {_BG, _RIVER, _DEST}) != sorted(mover_colors):
        return None
    diff_count = _independent_difference_count(grid)
    if diff_count < 1:
        return None
    order, finals = _simulate_positions(grid, persist_blockers=True)
    moved = 0
    for color, (tr, tc) in zip(order, finals):
        sr, sc, _mask = _locate_color_square(grid, _BG, color, n)
        moved += int((sr, sc) != (tr, tc))
    if moved < 2:
        return None
    return grid


def generate_input() -> np.ndarray:
    for _ in range(400):
        result = _gen_attempt()
        if result is not None:
            return result
    raise RuntimeError("Failed to generate valid input after 400 attempts")

