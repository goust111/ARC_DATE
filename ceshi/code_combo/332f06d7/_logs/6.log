+    grid[mover_r : mover_r + n, mover_c : mover_c + n] = _RIVER
+    grid[dest_r : dest_r + n, dest_c : dest_c + n] = _RIVER
+
+    if not reached and n >= 2:
+        num_choke = random.randint(1, min(3, len(walk) - 2))
