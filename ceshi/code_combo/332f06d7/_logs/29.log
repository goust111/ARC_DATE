    99	def _bool_components(mask: np.ndarray) -> list[np.ndarray]:
   100	    h, w = mask.shape
   101	    seen = np.zeros((h, w), dtype=bool)
   102	    comps: list[np.ndarray] = []
   103	    for r in range(h):
   104	        for c in range(w):
   105	            if not bool(mask[r, c]) or bool(seen[r, c]):
   106	                continue
   107	            comp = np.zeros((h, w), dtype=bool)
   108	            q = deque([(r, c)])
   109	            seen[r, c] = True
   110	            comp[r, c] = True
   111	            while q:
   112	                rr, cc = q.popleft()
   113	                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
   114	                    nr, nc = rr + dr, cc + dc
   115	                    if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]) and not bool(seen[nr, nc]):
   116	                        seen[nr, nc] = True
   117	                        comp[nr, nc] = True
   118	                        q.append((nr, nc))
   119	            comps.append(comp)
   120	    return comps
   121	
   122	
   123	def _feasible_windows(trav: np.ndarray, size: int) -> np.ndarray:
   124	    h, w = trav.shape
   125	    h2, w2 = h - size + 1, w - size + 1
   126	    assert h2 > 0 and w2 > 0
   127	    feasible = np.zeros((h2, w2), dtype=bool)
   128	    for r in range(h2):
   129	        for c in range(w2):
   130	            feasible[r, c] = bool(trav[r : r + size, c : c + size].all())
   131	    return feasible
   132	
   133	
   134	def _bfs_with_parent(mask: np.ndarray, seeds: list[tuple[int, int]]) -> tuple[np.ndarray, np.ndarray]:
   135	    h, w = mask.shape
   136	    dist = -np.ones((h, w), dtype=int)
   137	    parent = -np.ones((h, w, 2), dtype=int)
   138	    q = deque()
   139	    for r, c in seeds:
   140	        if 0 <= r < h and 0 <= c < w and bool(mask[r, c]) and int(dist[r, c]) == -1:
   141	            dist[r, c] = 0
   142	            parent[r, c] = (r, c)
   143	            q.append((r, c))
   144	    while q:
   145	        r, c = q.popleft()
   146	        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
   147	            rr, cc = r + dr, c + dc
   148	            if 0 <= rr < h and 0 <= cc < w and bool(mask[rr, cc]) and int(dist[rr, cc]) == -1:
   149	                dist[rr, cc] = int(dist[r, c]) + 1
   150	                parent[rr, cc] = (r, c)
   151	                q.append((rr, cc))
   152	    return dist, parent
   153	
   154	
   155	def _reachable_cover(reach: np.ndarray, size: int, shape: tuple[int, int]) -> np.ndarray:
   156	    cover = np.zeros(shape, dtype=bool)
   157	    for r in range(reach.shape[0]):
   158	        for c in range(reach.shape[1]):
   159	            if int(reach[r, c]) >= 0:
   160	                cover[r : r + size, c : c + size] = True
   161	    return cover
   162	
