   359	def _render_output(state: dict, *, with_trails: bool) -> np.ndarray:
   360	    g = state["grid"]
   361	    river = int(state["river"])
   362	    mover_color = int(state["mover"]["color"])
   363	    big_n = int(state["mover"]["n"])
   364	    sr, sc = int(state["mover"]["r0"]), int(state["mover"]["c0"])
   365	    child_n = int(state["child_n"])
   366	
   367	    out = g.copy()
   368	    out[sr : sr + big_n, sc : sc + big_n] = river
   369	    for branch in state["branches"]:
   370	        if with_trails:
   371	            for rr, cc in branch["trail_positions"]:
   372	                out[rr : rr + child_n, cc : cc + child_n] = mover_color
   373	        tr, tc = int(branch["tr"]), int(branch["tc"])
   374	        out[tr : tr + child_n, tc : tc + child_n] = mover_color
   375	    return out
