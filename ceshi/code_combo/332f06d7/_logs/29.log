   164	def _dense_path(points: list[tuple[int, int]]) -> list[tuple[int, int]]:
   165	    assert points
   166	    path = [points[0]]
   167	    for (r0, c0), (r1, c1) in zip(points, points[1:]):
   168	        if r0 == r1:
   169	            step = 1 if c1 > c0 else -1
   170	            for c in range(c0 + step, c1 + step, step):
   171	                path.append((r0, c))
   172	        else:
   173	            assert c0 == c1
   174	            step = 1 if r1 > r0 else -1
   175	            for r in range(r0 + step, r1 + step, step):
   176	                path.append((r, c0))
   177	    return path
   178	
   179	
   180	def _paint_path(grid: np.ndarray, path: list[tuple[int, int]], size: int, color: int) -> None:
   181	    for r, c in path:
   182	        grid[r : r + size, c : c + size] = color
