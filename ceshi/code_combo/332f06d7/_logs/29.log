   185	def _narrow_vertical_corridor(
   186	    grid: np.ndarray,
   187	    c: int,
   188	    top_r: int,
   189	    root_r: int,
   190	    width: int,
   191	    min_open_steps: int,
   192	) -> bool:
   193	    assert width == 2
   194	    cut_min = top_r + 1
   195	    cut_max = root_r - min_open_steps
   196	    if cut_max < cut_min:
   197	        return False
   198	    cut_r = random.randint(cut_min, cut_max)
   199	    length = min(2, root_r - cut_r)
   200	    if length < 1:
   201	        return False
   202	    keep_right = bool(random.getrandbits(1))
   203	    if keep_right:
   204	        grid[cut_r : cut_r + length, c : c + width - 1] = _BG
   205	    else:
   206	        grid[cut_r : cut_r + length, c + 1 : c + width] = _BG
   207	    return True
