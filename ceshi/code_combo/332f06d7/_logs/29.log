    84	def _solid_square_components(grid: np.ndarray, bg: int) -> list[dict]:
    85	    squares: list[dict] = []
    86	    for comp in find_components(grid, bg=bg, connectivity=4, monochromatic=True, return_format="dict"):
    87	        color = int(comp["color"])
    88	        box = comp["bbox"]
    89	        if bbox_h(box) != bbox_w(box):
    90	            continue
    91	        r0, c0, r1, c1 = map(int, box)
    92	        patch = grid[r0 : r1 + 1, c0 : c1 + 1]
    93	        if not bool((patch == color).all()):
    94	            continue
    95	        squares.append({"color": color, "r0": r0, "c0": c0, "n": int(bbox_h(box))})
    96	    return squares
