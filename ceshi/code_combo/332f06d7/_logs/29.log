   329	    dest_colors = {int(d["color"]) for d in dests}
   330	    trav = (g == river) | (g == mover_color)
   331	    for color in dest_colors:
   332	        trav |= g == color
   333	
   334	    big_n = int(mover["n"])
   335	    sr, sc = int(mover["r0"]), int(mover["c0"])
   336	    big_feasible = _feasible_windows(trav, big_n)
   337	    assert bool(big_feasible[sr, sc])
   338	    big_reach, _big_parent = _bfs_with_parent(big_feasible, [(sr, sc)])
   339	    big_cover = _reachable_cover(big_reach, big_n, (h, w))
   340	
