/bin/bash -lc "nl -ba /home/lixinyu/snap/new/ceshi/code_combo/332f06d7/29/code.py | sed -n '1,220p'" in /home/lixinyu/snap/new
 succeeded in 0ms:
     1	# Combo variant of 332f06d7 (index 29)
     2	# combo_spec: D3/1+D10/1
     3	# Name: 间歇轨迹+移动体分裂
     4	#
     5	# Design analysis
     6	# ---------------
     7	# a) 具体化与行为追踪
     8	# - 输入保留原题的可视角色：绿色背景、蓝色河道、黑色 mover、红色目标。
     9	# - 但几何改成固定的分裂场景：一个 5x5 黑方块沿 5 像素宽干道进入 5x5 分叉室，
    10	#   然后在分叉室顶部裂成两个 2x2 子方块，分别进入左、右两条 2 像素宽分支。
    11	# - 左右分支末端各有一个 2x2 红色目标；若分支上出现 1 像素卡点，该子方块会停在
    12	#   最后一个可行 2x2 放置位置，否则覆盖该红块。
    13	# - 与 D10 单变体相比，输出不再只有两个最终 2x2 黑块。每个子方块沿自己的实际路径
    14	#   还会留下间歇轨迹：左分支周期固定为 3，右分支周期固定为 4。
    15	# - 具体例子：左子方块路径 placements 为 p0..p10，则在 p3、p6、p9 留下 2x2 黑印记；
    16	#   右子方块路径 q0..q9，则在 q4、q8 留下 2x2 黑印记。终点本身不是轨迹印记，因为
    17	#   它本来就由最终子方块占据。
    18	#
    19	# b) 复杂度校准
    20	# - 仍只使用 4 种颜色，避免颜色映射歧义。
    21	# - 大小关系固定为 5x5 -> 两个 2x2，保证“分裂”在视觉上稳定、明显。
    22	# - 轨迹周期只取两个值 3 和 4，且固定绑定到左/右分支，避免自由度过多。
    23	# - generator 强制两条分支都足够长，且总轨迹印记数至少为 3，从而肉眼能看到“分裂”
    24	#   和“虚线”两种变化同时出现。
    25	#
    26	# c) 隐式假设审查
    27	# - 原题 `main()` 假设 mover 与 destination 同尺寸；这里不成立，必须先检测唯一最大黑块，
    28	#   再检测两个较小且同尺寸的红块。
    29	# - 原题只需要一个 BFS 和一个终点；这里不成立，需要：
    30	#   1. 5x5 大方块的可达覆盖区；
    31	#   2. 去掉该覆盖区后得到两条独立分支；
    32	#   3. 每条分支各自做 2x2 BFS，并记录 parent 恢复实际路径。
    33	# - D3 的轨迹规则要求显式路径；因此分支 BFS 必须保留 parent，不能只保留 dist。
    34	# - 原题默认输出里除终点外没有额外黑块；这里不成立，输出会新增多个 2x2 轨迹印记。
    35	#
    36	# d) 放置合法性
    37	# - 干道用 5x5 top-left 稠密路径绘制，分支用 2x2 top-left 稠密路径绘制，确保 solver 的
    38	#   placement-BFS 与 generator 的几何完全一致。
    39	# - 两条 2 宽分支在分叉室上方由 1 列背景隔开，去掉大方块可达覆盖区后必定拆成两个像素组件。
    40	# - mover、targets、轨迹都不越界；红目标不放在角落；卡点只削成 1 宽，不会破坏整条河道的
    41	#   可视连通性。
    42	#
    43	# e) 视觉可观察性
    44	# - 人类从样例能直接看出：
    45	#   1. 一个大黑块消失，变成两个小黑块；
    46	#   2. 左右两条分支各自沿路出现虚线印记；
    47	#   3. 某些样例里某个子方块会停在卡点前，红目标保留。
    48	# - 轨迹密度差异不依赖颜色编号，而依赖可见的左右分支角色：左边更密，右边更疏。
    49	#
    50	# f) 可视化整洁度
    51	# - 不引入新装饰色，不在同一区域叠多层标记。
    52	# - 轨迹只画在 2x2 合法放置窗口上，且左右分支分离，避免两条虚线纠缠成黑团。
    53	# - generator 过滤掉轨迹过少、或融合版输出与“纯分裂版”完全相同的样例。
    54	#
    55	# g) 变化的可推断性
    56	# - 没有隐藏的数值排序规则。颜色角色固定且可见：黑=移动体/轨迹，红=目标，蓝=河道，绿=背景。
    57	# - 左右两条分支持续重复同一规律：左边每 3 步留下一个 2x2 黑印记，右边每 4 步留下一个。
    58	#   这在 2-4 个样例中是可归纳的稳定结构。
    59	#
    60	# New solver assumptions enforced by the generator
    61	# ------------------------------------------------
    62	# - 输入中恰有一个最大的实心方块作为 mover，且其尺寸固定为 5。
    63	# - 输入中恰有两个相同尺寸的较小红方块作为分裂后的目标，尺寸固定为 2。
    64	# - 去掉 5x5 mover 的可达覆盖后，剩余可 traversable 像素正好分成两个含目标的分支组件。
    65	# - 左右分支可按目标的列坐标稳定区分，并分别绑定周期 3 / 4。
    66	# - 每条分支从分叉口到最终停点的路径足够长，至少留下一个轨迹印记，且融合输出必须不同于
    67	#   不带轨迹的纯 D10 输出。
    68	
    69	from __future__ import annotations
    70	
    71	from collections import Counter, defaultdict, deque
    72	import random
    73	
    74	import numpy as np
    75	
    76	from arc_utils import bbox_h, bbox_w, find_components
    77	
    78	
    79	_BG, _RIVER, _MOVER, _DEST = 3, 1, 0, 2
    80	_BIG, _SMALL = 5, 2
    81	_PERIODS = (3, 4)
