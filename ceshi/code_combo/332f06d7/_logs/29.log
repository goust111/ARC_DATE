   210	def _pick_roles(grid: np.ndarray, bg: int) -> tuple[dict, list[dict], int]:
   211	    squares = _solid_square_components(grid, bg)
   212	    assert squares
   213	
   214	    by_n: dict[int, list[dict]] = defaultdict(list)
   215	    for sq in squares:
   216	        by_n[int(sq["n"])].append(sq)
   217	
   218	    mover_n = max(by_n)
   219	    assert len(by_n[mover_n]) == 1
   220	    mover = by_n[mover_n][0]

