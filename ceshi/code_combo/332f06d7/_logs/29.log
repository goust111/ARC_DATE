   320	def _scene_state(grid: np.ndarray) -> dict:
   321	    g = np.array(grid, dtype=int)
   322	    h, w = g.shape
   323	
   324	    bg = int(Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0])
