# Variant of 332f06d7
# Dimension: D11 — 背景与河流的颜色/角色关系 (meta)
# Change: 背景为绿色(color 3)占据四角，河流为蓝色(color 1)形成通道，角色固定... → 颜色从示例中推断

from __future__ import annotations

from collections import Counter, defaultdict, deque
import random

import numpy as np
from scipy.ndimage import label as scipy_label

from arc_utils import bbox_h, bbox_w, find_components

# Design analysis for the D11 variant
# -----------------------------------
# a) 具体化与行为追踪
# - 视觉对象仍然只有四类：背景、河流、黑色 mover、红色 destination。
# - 变体只改变前两类颜色角色：背景不再固定为 3，河流不再固定为 1，而是每个样例从
#   非 {0, 2} 的颜色中抽取一对有序颜色。四角始终是背景色，蜿蜒通道始终是河流色。
# - 小例子：原逻辑在一个样例里看到 corner=3、通道=1；变体样例可能是 corner=8、
#   通道=4。几何结构与输出行为完全不变，只是 solver 不能把 3/1 当常量，而要先从
#   角落和剩余颜色里推断角色，再执行同样的 BFS 滑动。
#
# b) 复杂度校准
# - 只让背景/河流变色，保持 mover=0、destination=2，不引入额外对象或额外分支。
# - 仍然只有 4 种颜色，角色数量少，且背景有四角锚点、河流有连通通道锚点，足够让
#   人类在少量样例中归纳“颜色在变，但角色由结构决定”。
#
# c) 隐式假设审查
# - main() 中真正依赖旧固定配色的是“如果有人把 3/1 写死就会坏”；因此这里显式用
#   corner-majority 推断背景，再用“除背景和两个方块色之外的唯一剩余色”推断河流。
# - generator 中原本所有 `_BG` / `_RIVER` 常量写入都必须参数化：初始铺底、画河道、
#   收窄卡点、边界延展、恢复起点、输出填河等位置都依赖旧固定颜色。
# - mover/destination 的黑色/红色身份在本变体中不变，因此仍可作为稳定锚点使用。
#
# d) 放置合法性
# - 仍沿用原题的 output-first 构造：先生成合法河道，再放置同尺寸 mover/destination，
#   然后用 solver 回验。颜色变化不改变任何几何约束，所以合法性条件与原题一致。
#
# e) 视觉可观察性
# - 连续生成的样例如果恰好总抽到同一对颜色，会弱化 D11。为避免这一点，生成器使用
#   一个全局打乱后的颜色对队列，让连续调用优先拿到不同的 `(bg, river)` 配对。
#
# f) 可视化整洁度
# - 仍然保持“一条河 + 两个实心方块 + 单一背景”的图面组织，不增加叠层或标记。
#
# g) 颜色变化可推断性
# - 变化只发生在两种角色色上，且两种角色都有稳定结构线索：
#   四角/大面积空地 = 背景；细长连通通道 = 河流。
# - 因此即便颜色值跨样例不同，人类也能从位置与形状推断角色映射。
#
# main() 的新隐式假设与 generator 保证
# - 假设四角的多数色就是背景：generator 保证四角都保留为背景。
# - 假设存在两个同尺寸实心方块且颜色分别是 0 和 2：generator 始终这样构造。
# - 假设去掉背景与两方块色后只剩一个颜色，即河流色：generator 始终只使用 4 种色。

_MOVER, _DEST = 0, 2
_ROLE_COLORS = [1, 3, 4, 5, 6, 7, 8, 9]
_ROLE_PAIR_QUEUE: list[tuple[int, int]] = []


def main(grid: np.ndarray) -> np.ndarray:
    """
    Slide a solid square through a winding channel to reach a same-sized target square.

    D11 variant:
    - mover stays black (0), destination stays red (2)
    - background and river colors vary per instance and must be inferred from structure
    """
    g = np.array(grid, dtype=int)
    H, W = g.shape

    bg = int(Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0])

    squares: list[dict] = []
    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict"):
        col = int(comp["color"])
        b = comp["bbox"]
        if bbox_h(b) != bbox_w(b):
            continue
        patch = g[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1]
        if not bool((patch == col).all()):
            continue
        squares.append({"col": col, "r0": int(b[0]), "c0": int(b[1]), "n": int(bbox_h(b))})

    assert len(squares) >= 2

    by_n: dict[int, list[dict]] = defaultdict(list)
    for sq in squares:
        by_n[int(sq["n"])].append(sq)
    nside = max(by_n.items(), key=lambda kv: (len(kv[1]), kv[0]))[0]
    cand = by_n[int(nside)]
    assert len(cand) >= 2

    mover = next((sq for sq in cand if int(sq["col"]) == _MOVER), None)
    dest = next((sq for sq in cand if int(sq["col"]) == _DEST), None)
    assert mover is not None and dest is not None

    n = int(mover["n"])
    sr, sc = int(mover["r0"]), int(mover["c0"])
    dr, dc = int(dest["r0"]), int(dest["c0"])

    role_colors = set(map(int, g.flatten())) - {int(bg), _MOVER, _DEST}
    assert len(role_colors) == 1
    river = int(next(iter(role_colors)))

    trav = (g == river) | (g == _MOVER) | (g == _DEST)

    h2 = int(H - n + 1)
    w2 = int(W - n + 1)
    assert h2 > 0 and w2 > 0
    assert 0 <= sr < h2 and 0 <= sc < w2

    feasible = np.zeros((h2, w2), dtype=bool)
    for r in range(h2):
        for c in range(w2):
            if bool(trav[r : r + n, c : c + n].all()):
                feasible[r, c] = True
    assert bool(feasible[sr, sc])

    dist = -np.ones((h2, w2), dtype=int)
    q = deque([(sr, sc)])
    dist[sr, sc] = 0
    while q:
        r, c = q.popleft()
        for dr2, dc2 in ((1, 0), (-1, 0), (0, 1), (0, -1)):
            rr = int(r + dr2)
            cc = int(c + dc2)
            if 0 <= rr < h2 and 0 <= cc < w2 and bool(feasible[rr, cc]) and int(dist[rr, cc]) == -1:
                dist[rr, cc] = int(dist[r, c] + 1)
                q.append((rr, cc))

    if 0 <= dr < h2 and 0 <= dc < w2 and bool(feasible[dr, dc]) and int(dist[dr, dc]) >= 0:
        tr, tc = int(dr), int(dc)
    else:
        best = -1
        tr, tc = int(sr), int(sc)
        for r in range(h2):
            for c in range(w2):
                if int(dist[r, c]) > best:
                    best = int(dist[r, c])
                    tr, tc = int(r), int(c)

    out = g.copy()
    out[sr : sr + n, sc : sc + n] = river
    out[tr : tr + n, tc : tc + n] = _MOVER
    return out


def _next_role_pair():
    global _ROLE_PAIR_QUEUE
    if not _ROLE_PAIR_QUEUE:
        _ROLE_PAIR_QUEUE = [
            (bg, river)
            for bg in _ROLE_COLORS
            for river in _ROLE_COLORS
            if river != bg
        ]
        random.shuffle(_ROLE_PAIR_QUEUE)
    return _ROLE_PAIR_QUEUE.pop()


def _bfs_placement(feasible, sr, sc):
    h2, w2 = feasible.shape
    dist = -np.ones((h2, w2), dtype=int)
    dist[sr, sc] = 0
    q = deque([(sr, sc)])
    while q:
        r, c = q.popleft()
        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
            rr, cc = r + dr, c + dc
            if 0 <= rr < h2 and 0 <= cc < w2 and feasible[rr, cc] and dist[rr, cc] == -1:
                dist[rr, cc] = dist[r, c] + 1
                q.append((rr, cc))
    return dist


def _hamiltonian_walk(rows, cols, start, end):
    total = rows * cols
    best_path = None
    best_len = 0
    for _attempt in range(80):
        visited = {start}
        path = [start]
        cur = start
        while True:
            if cur == end and len(path) >= total * 0.7:
                if len(path) > best_len:
                    best_path = list(path)
                    best_len = len(path)
                break
            neighbors = []
            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nr, nc = cur[0] + dr, cur[1] + dc
                if 0 <= nr < rows and 0 <= nc < cols and (nr, nc) not in visited:
