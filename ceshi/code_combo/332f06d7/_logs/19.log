+# Combo variant of 332f06d7 (index 19)
+# combo_spec: D8/3+D18/0
+# Name: 形状线索方向+边缘控制像素
+
+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+from scipy.ndimage import label as scipy_label
