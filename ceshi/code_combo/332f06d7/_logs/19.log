+def _control_to_step(H: int, W: int, ctrl_r: int, ctrl_c: int) -> tuple[int, int]:
+    hits: list[tuple[int, int]] = []
+    if ctrl_r == 0:
+        hits.append((1, 0))
+    if ctrl_r == H - 1:
+        hits.append((-1, 0))
+    if ctrl_c == 0:
+        hits.append((0, 1))
+    if ctrl_c == W - 1:
+        hits.append((0, -1))
+    assert len(hits) == 1
+    return hits[0]
