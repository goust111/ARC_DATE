+    return 0
+
+
+def _pick_control_cell(
+    grid: np.ndarray, step: tuple[int, int], mover_r: int, mover_c: int, n: int
+) -> tuple[int, int] | None:
+    H, W = grid.shape
+    pref_r = mover_r + n // 2
+    pref_c = mover_c + n // 2
+
+    if step == (1, 0):
+        row = 0
+        cols = sorted(range(1, W - 1), key=lambda c: abs(c - pref_c))
+        for c in cols:
+            if grid[row, c] != _BG:
+                continue
+            if row + 1 < H and grid[row + 1, c] != _BG:
