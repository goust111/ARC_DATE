from __future__ import annotations

from collections import Counter, deque
import random

import numpy as np
from scipy.ndimage import label as scipy_label

from arc_utils import bbox_h, bbox_w, find_components


# Design analysis for this D8 variant
# -----------------------------------
# a) Concrete visual change:
#    - The destination stays a solid n×n square.
#    - The mover is no longer identified by color rank. Instead, it is rendered as the
#      same n×n square body plus one extra same-colored protrusion pixel on one side.
#      That protrusion points along the mover's unique outgoing corridor direction.
#    - The protrusion is an input-only cue. The sliding body is still the n×n square,
#      so the original river-width / placement BFS logic remains valid.
#    - Small trace:
#      original: colors {0,2} -> sort -> 0 moves to 2
#      variant: colors can be in either order; solver finds the component that becomes
#      a solid square after deleting exactly one boundary-adjacent tip pixel, treats its
#      square core as the mover body, erases the whole marked source component to river,
#      and moves only the square body to the destination.
# b) Complexity calibration:
#    - A single protrusion pixel is the smallest visible cue that changes the identification
#      rule without rewriting the task's spatial core.
#    - n is restricted to 2..4 in generation. n=1 would make a 2-pixel domino whose
#      "body vs tip" decomposition is ambiguous and visually weak.
#    - Object colors are randomized from a small palette and may appear in either order,
#      so the old color-sorting heuristic fails often enough to make the new rule necessary.
# c) Hidden assumptions from the original solver that break here:
#    - "Both objects are solid squares" is no longer true for the mover; we must detect
#      a square-with-tip component instead of sorting two plain squares.
#    - "The lower color is the mover" is no longer true; colors are ignored for role
#      assignment beyond distinguishing the two object colors from river/background.
#    - "Erasing the mover means repainting only an n×n box" is no longer enough; the tip
#      must also be restored to river in the output.
# d) Placement legality:
#    - The tip is always painted onto an already-river cell just outside the mover body,
#      so it never causes overlap, never leaves the grid, and never changes the true
#      passable geometry relative to the pre-marker river.
#    - The generator enforces that the mover start has exactly one feasible neighboring
#      placement, so the tip direction is visually meaningful and unambiguous.
# e) Visual observability:
#    - Across examples, the mover color may be lower or higher than the destination color,
#      but the protruding arrow-like marker always identifies the source. This is directly
#      visible from input/output pairs without any hidden numeric ordering.
# f) Visual cleanliness:
#    - Only one extra pixel is added, always on the mover boundary and on the river side.
#      No extra legend objects or overlapping annotations are introduced.
# g) Color-rule readability:
#    - The transformation does not rely on any color arithmetic. Colors only label regions;
#      shape determines role.
# h) New solver assumptions introduced here:
#    - Exactly one non-river component is a "solid square + one tip" mover marker.
#    - Exactly one other non-river component is a solid square of the same side length.
#    - The tip is 4-neighbor adjacent to one side of the mover's square core.
#    The generator explicitly constructs inputs to satisfy all three assumptions.


DIR4 = {
    "D": (1, 0),
    "U": (-1, 0),
    "R": (0, 1),
    "L": (0, -1),
}


def _solid_square_info(g: np.ndarray, comp: dict) -> dict | None:
    col = int(comp["color"])
    b = comp["bbox"]
    if bbox_h(b) != bbox_w(b):
        return None
    patch = g[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1]
    if not bool((patch == col).all()):
        return None
    return {
        "col": col,
        "r0": int(b[0]),
        "c0": int(b[1]),
        "n": int(bbox_h(b)),
        "coords": {(int(r), int(c)) for r, c in comp["coords"]},
    }


def _arrow_square_info(comp: dict) -> dict | None:
    coords = {(int(r), int(c)) for r, c in comp["coords"]}
    if len(coords) < 5:
        return None

    matches: list[dict] = []
    for tip_r, tip_c in coords:
        rem = coords - {(tip_r, tip_c)}
        rows = [r for r, _ in rem]
        cols = [c for _, c in rem]
        r0, r1 = min(rows), max(rows)
        c0, c1 = min(cols), max(cols)
        n = int(r1 - r0 + 1)
        if n != int(c1 - c0 + 1):
            continue
        if len(rem) != n * n:
            continue
        full_square = True
        for r in range(r0, r1 + 1):
            for c in range(c0, c1 + 1):
                if (r, c) not in rem:
                    full_square = False
                    break
            if not full_square:
                break
        if not full_square:
            continue

        direction = None
        if tip_r == r0 - 1 and c0 <= tip_c <= c1:
            direction = "U"
        elif tip_r == r1 + 1 and c0 <= tip_c <= c1:
            direction = "D"
        elif tip_c == c0 - 1 and r0 <= tip_r <= r1:
            direction = "L"
        elif tip_c == c1 + 1 and r0 <= tip_r <= r1:
            direction = "R"
        if direction is None:
            continue

        matches.append(
            {
                "col": int(comp["color"]),
                "r0": int(r0),
                "c0": int(c0),
                "n": int(n),
                "dir": direction,
                "tip": (int(tip_r), int(tip_c)),
                "coords": set(coords),
            }
        )

    if len(matches) != 1:
        return None
    return matches[0]


def main(grid: np.ndarray) -> np.ndarray:
    """
    Slide a square body through a winding channel to reach a same-sized target square.

    Variant input structure:
    - bg (corner-majority color) and a river color form the original winding corridor.
    - Destination = a solid n×n square.
    - Mover = an n×n square body plus one extra same-colored tip pixel on one side.
      The tip points along the mover's initial corridor direction and is the only cue
      used to identify the mover when colors are not ordered reliably.

    Rule:
    - Ignore color ordering.
    - Detect the arrow-marked mover by finding the unique component that becomes a solid
      square after removing one side-adjacent protrusion pixel.
    - Slide that square body through the river exactly as in the original task.
    - Repaint the entire marked source component (body + tip) with river color.
    - Draw the mover body at the destination if reachable, else at the farthest feasible
      placement before the first blocking chokepoint.
    """
    g = np.array(grid, dtype=int)
    H, W = g.shape

    bg = int(Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0])

    counts = Counter(map(int, g.flatten()))
    river = None
    for col, _ct in counts.most_common():
        if int(col) != int(bg):
            river = int(col)
            break
    assert river is not None

    mover_candidates: list[dict] = []
    dest_candidates: list[dict] = []
    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict"):
        col = int(comp["color"])
        if col == river:
            continue
        mover_info = _arrow_square_info(comp)
        if mover_info is not None:
            mover_candidates.append(mover_info)
            continue
        square_info = _solid_square_info(g, comp)
        if square_info is not None:
            dest_candidates.append(square_info)

    pairs = [
        (m, d)
        for m in mover_candidates
        for d in dest_candidates
        if int(m["n"]) == int(d["n"]) and int(m["col"]) != int(d["col"])
    ]
    assert len(pairs) == 1
    mover, dest = pairs[0]

    n = int(mover["n"])
    sr, sc = int(mover["r0"]), int(mover["c0"])
    dr, dc = int(dest["r0"]), int(dest["c0"])

    trav = (g == int(river)) | (g == int(mover["col"])) | (g == int(dest["col"]))

    h2 = int(H - n + 1)
    w2 = int(W - n + 1)
    assert not (h2 <= 0 or w2 <= 0)
    assert not (not (0 <= sr < h2 and 0 <= sc < w2))

    feasible = np.zeros((h2, w2), dtype=bool)
    for r in range(h2):
        for c in range(w2):
            if bool(trav[int(r) : int(r + n), int(c) : int(c + n)].all()):
                feasible[int(r), int(c)] = True
    assert bool(feasible[int(sr), int(sc)])

    dist = -np.ones((h2, w2), dtype=int)
    q = deque([(int(sr), int(sc))])
    dist[int(sr), int(sc)] = 0
    for _ in range(h2 * w2):
        if not q:
            break
        r, c = q.popleft()
        for dr2, dc2 in DIR4.values():
            rr = int(r + dr2)
            cc = int(c + dc2)
            if 0 <= rr < h2 and 0 <= cc < w2 and bool(feasible[rr, cc]) and int(dist[rr, cc]) == -1:
                dist[rr, cc] = int(dist[int(r), int(c)] + 1)
                q.append((int(rr), int(cc)))

    if 0 <= dr < h2 and 0 <= dc < w2 and bool(feasible[int(dr), int(dc)]) and int(dist[int(dr), int(dc)]) >= 0:
        tr, tc = int(dr), int(dc)
    else:
        best = -1
        tr, tc = int(sr), int(sc)
        for r in range(h2):
            for c in range(w2):
                if int(dist[int(r), int(c)]) > best:
                    best = int(dist[int(r), int(c)])
                    tr, tc = int(r), int(c)

    out = g.copy()
    for r, c in mover["coords"]:
        out[int(r), int(c)] = int(river)
    out[int(tr) : int(tr + n), int(tc) : int(tc + n)] = int(mover["col"])
    return out


# --- Generator ---

_BG, _RIVER = 3, 1
_OBJECT_COLORS = [0, 2, 4, 5, 6, 7, 8, 9]


