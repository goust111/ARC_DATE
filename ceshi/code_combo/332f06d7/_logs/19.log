+
+
+def _choose_tip_cell(grid: np.ndarray, r0: int, c0: int, n: int, direction: str) -> tuple[int, int] | None:
+    offsets = sorted(range(n), key=lambda k: (abs(k - (n - 1) / 2.0), k))
+    for off in offsets:
+        if direction == "U":
+            rr, cc = r0 - 1, c0 + off
+        elif direction == "D":
+            rr, cc = r0 + n, c0 + off
+        elif direction == "L":
+            rr, cc = r0 + off, c0 - 1
+        else:
