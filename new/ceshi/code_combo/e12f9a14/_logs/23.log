        # Detect geometric crossings: a diagonal move crossing an already-drawn diagonal segment.
        seg_cross: set[tuple[int, int]] = set()  # (moving_bid, other_bid)
        for bid, (nxt, d) in prop.items():
            if abs(d[0]) + abs(d[1]) != 2:
