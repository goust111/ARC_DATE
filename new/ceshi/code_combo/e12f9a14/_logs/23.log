+def _border_order(side: int) -> tuple[tuple[int, int], ...]:
+    pts: list[tuple[int, int]] = []
+    for c in range(side):
+        pts.append((0, c))
+    for r in range(1, side - 1):
+        pts.append((r, side - 1))
+    for c in range(side - 1, -1, -1):
+        pts.append((side - 1, c))
+    for r in range(side - 2, 0, -1):
+        pts.append((r, 0))
