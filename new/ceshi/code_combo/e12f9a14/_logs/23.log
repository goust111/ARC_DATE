+def _choose_positions(
+    n: int,
+    sides: list[int],
+    rng: np.random.Generator,
+) -> list[tuple[int, int]] | None:
+    count = len(sides)
+    for _ in range(80):
+        order = sorted(range(count), key=lambda i: (-sides[i], float(rng.random())))
