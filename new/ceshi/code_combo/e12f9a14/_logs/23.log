+# --------------- generator (o5x) ---------------
+
+BLOCK_COUNT_RANGE = (2, 6)
+GRID_SIZE_MAX = 31
+GRID_SIZE_MIN_BY_BLOCKS = {2: 14, 3: 18, 4: 22, 5: 26}
+BG_CHOICES = [0, 8]
+BG_WEIGHTS = [0.25, 0.75]
+FRAME_COLOR_FOR_BG = {8: 3, 0: 8}
+PALETTE_FOR_BG = {
+    8: [1, 2, 4, 6, 7, 9],
+    0: [1, 2, 3, 4, 6, 7, 9],
+}
+FRAME_BBOX_GAP = 2
+PLACEMENT_MARGIN = 2
+MIN_POST_STOP_BUFFER = 1
+MIN_BEAM_PIXELS_PER_GAP = 2
+GEN_RETRIES = 400
