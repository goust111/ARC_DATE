+        u = _normalize_dir(da[0] + seg_dir[0], da[1] + seg_dir[1])
+        assert u != (0, 0), "expected segment crossing to resolve to a forward direction"
+
+        consume_step(a)
+        group = {a, b}
+        pa = find_partner(a)
+        pb = find_partner(b)
+        if pa is not None:
+            group.add(pa)
+        if pb is not None:
