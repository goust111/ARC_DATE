+def _pick_colors(rng: np.random.Generator, block_count: int) -> tuple[int, int, list[int]]:
+    bg = int(rng.choice(BG_CHOICES, p=BG_WEIGHTS))
+    frame_color = FRAME_COLOR_FOR_BG[bg]
