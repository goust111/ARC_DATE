    67	def _infer_frame_color(g: np.ndarray, bg: int, br: int, bc: int, block_col: int) -> int:
    68	    h, w = g.shape
    69	    fr0, fc0 = br - 1, bc - 1
    70	    fr1, fc1 = br + 2, bc + 2
    71	    vals: list[int] = []
    72	    for r in range(fr0, fr1 + 1):
    73	        for c in range(fc0, fc1 + 1):
    74	            if not (0 <= r < h and 0 <= c < w):
    75	                continue
    76	            if not (r in (fr0, fr1) or c in (fc0, fc1)):
    77	                continue
    78	            v = int(g[r, c])
    79	            if v != bg and v != block_col:
    80	                vals.append(v)
    81	    frame_colors = sorted(set(vals))
    82	    assert len(frame_colors) == 1, "expected a unique frame color around each 2x2 block"
    83	    return frame_colors[0]
    84	
