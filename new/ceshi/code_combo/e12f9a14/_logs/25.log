    54	def _find_blocks_2x2(g: np.ndarray, bg: int) -> list[tuple[int, int, int]]:
    55	    h, w = g.shape
    56	    blocks: list[tuple[int, int, int]] = []
    57	    for r in range(h - 1):
    58	        for c in range(w - 1):
    59	            v = int(g[r, c])
    60	            if v == bg:
    61	                continue
    62	            if int(g[r, c + 1]) == v and int(g[r + 1, c]) == v and int(g[r + 1, c + 1]) == v:
    63	                blocks.append((v, r, c))
    64	    return blocks
    65	
