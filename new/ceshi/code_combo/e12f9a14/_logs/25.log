   351	            stats["legacy90_collision_count"] += 1
   352	
   353	        blocked.add(cell)
   354	        unpaint_cell(cell)
   355	        stats["blocked_cell_count"] = len(blocked)
   356	        apply_redirect(a, src_a, da, b, src_b, db)
