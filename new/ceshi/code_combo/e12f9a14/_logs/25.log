   266	    def in_bounds(cell: tuple[int, int]) -> bool:
   267	        r, c = cell
   268	        return 0 <= r < h and 0 <= c < w
   269	
   270	    def is_open_bg(cell: tuple[int, int]) -> bool:
   271	        r, c = cell
   272	        return int(g[r, c]) == bg and cell not in blocked
