   314	    def apply_redirect(
   315	        bid_a: int,
   316	        src_a: tuple[int, int] | None,
   317	        dir_a: tuple[int, int],
   318	        bid_b: int,
   319	        src_b: tuple[int, int] | None,
   320	        dir_b: tuple[int, int],
   321	    ) -> None:
   322	        choice = choose_turn_pair(src_a, dir_a, src_b, dir_b)
   323	        if choice is None:
   324	            beams[bid_a].active = False
   325	            beams[bid_b].active = False
   326	            return
   327	        out_a, out_b = choice
   328	        beams[bid_a].dir = out_a
   329	        beams[bid_b].dir = out_b
   330	        beams[bid_a].active = True
   331	        beams[bid_b].active = True
   332	        beams[bid_a].turned = True
   333	        beams[bid_b].turned = True
