   182	def _solve(grid: np.ndarray, *, want_stats: bool = False):
   183	    g = np.asarray(grid, dtype=int)
   184	    h, w = g.shape
   185	    bg = get_bg(g)
   186	    out = g.copy()
   187	    blocked: set[tuple[int, int]] = set()
   188	
   189	    stats = {
   190	        "collision_count": 0,
   191	        "legacy45_collision_count": 0,
   192	        "legacy90_collision_count": 0,
   193	        "diag_cross_collision_count": 0,
   194	        "segment_cross_collision_count": 0,
   195	        "blocked_cell_count": 0,
   196	        "post_turn_steps": 0,
   197	    }
   198	
   199	    blocks = _find_blocks_2x2(g, bg)
   200	    assert blocks, "expected at least one 2x2 block in input"
   201	
   202	    beams: dict[int, _Beam] = {}
   203	    next_bid = 0
   204	    cell_owner: dict[tuple[int, int], int] = {}
   205	    cell_enter: dict[tuple[int, int], tuple[int, int]] = {}
   206	    cell_index: dict[tuple[int, int], int] = {}
   207	
   208	    def paint_cell(bid: int, cell: tuple[int, int], enter_dir: tuple[int, int]) -> None:
   209	        r, c = cell
   210	        out[r, c] = beams[bid].color
   211	        cell_owner[cell] = bid
   212	        cell_enter[cell] = enter_dir
   213	        cell_index[cell] = len(beams[bid].path) - 1
   214	
   215	    def unpaint_cell(cell: tuple[int, int]) -> None:
   216	        if cell not in cell_owner:
   217	            return
   218	        out[cell[0], cell[1]] = bg
   219	        cell_owner.pop(cell, None)
   220	        cell_enter.pop(cell, None)
   221	        cell_index.pop(cell, None)
   222	
   223	    def clear_beam(bid: int) -> None:
   224	        b = beams[bid]
   225	        for cell in b.path:
   226	            if cell_owner.get(cell) == bid:
   227	                unpaint_cell(cell)
   228	        b.path = []
   229	        b.enter_dirs = []
   230	        b.active = False
   231	
   232	    def rewind_beam(bid: int, keep_len: int) -> tuple[int, int] | None:
   233	        b = beams[bid]
   234	        if keep_len <= 0:
   235	            clear_beam(bid)
   236	            return None
   237	        assert keep_len <= len(b.path), "invalid rewind length"
   238	        for cell in b.path[keep_len:]:
   239	            if cell_owner.get(cell) == bid:
   240	                unpaint_cell(cell)
   241	        b.path = b.path[:keep_len]
   242	        b.enter_dirs = b.enter_dirs[:keep_len]
   243	        b.pos = b.path[-1]
   244	        b.active = True
   245	        return b.pos
   246	
   247	    def spawn_beam(color: int, pos: tuple[int, int], direction: tuple[int, int]) -> None:
   248	        nonlocal next_bid
   249	        assert int(out[pos[0], pos[1]]) == bg, "expected beam seed at a frame gap"
   250	        bid = next_bid
   251	        next_bid += 1
   252	        beams[bid] = _Beam(bid, color, pos, direction)
   253	        paint_cell(bid, pos, direction)
   254	
   255	    for col, br, bc in blocks:
   256	        frame_col = _infer_frame_color(g, bg, br, bc, col)
   257	        for gr, gc in _frame_gaps_for_block(g, bg, frame_col, br, bc):
   258	            dr = -1 if gr == br - 1 else (1 if gr == br + 2 else 0)
   259	            dc = -1 if gc == bc - 1 else (1 if gc == bc + 2 else 0)
   260	            direction = _normalize_dir(dr, dc)

