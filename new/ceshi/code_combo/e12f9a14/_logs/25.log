   168	class _Beam:
   169	    __slots__ = ("bid", "color", "pos", "dir", "path", "enter_dirs", "active", "turned")
   170	
   171	    def __init__(self, bid: int, color: int, pos: tuple[int, int], direction: tuple[int, int]):
   172	        self.bid = bid
   173	        self.color = int(color)
   174	        self.pos = pos
   175	        self.dir = direction
   176	        self.path = [pos]
   177	        self.enter_dirs = [direction]
   178	        self.active = True
   179	        self.turned = False
   180	
