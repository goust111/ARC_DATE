    86	def _frame_gaps_for_block(g: np.ndarray, bg: int, wall: int, br: int, bc: int) -> list[tuple[int, int]]:
    87	    h, w = g.shape
    88	    fr0, fc0 = br - 1, bc - 1
    89	    fr1, fc1 = br + 2, bc + 2
    90	    gaps: list[tuple[int, int]] = []
    91	    for r in range(fr0, fr1 + 1):
    92	        for c in range(fc0, fc1 + 1):
    93	            if not (0 <= r < h and 0 <= c < w):
    94	                continue
    95	            if not (r in (fr0, fr1) or c in (fc0, fc1)):
    96	                continue
    97	            if int(g[r, c]) == bg:
    98	                gaps.append((r, c))
    99	
   100	    out: list[tuple[int, int]] = []
   101	    for r, c in gaps:
   102	        dr = -1 if r == fr0 else (1 if r == fr1 else 0)
   103	        dc = -1 if c == fc0 else (1 if c == fc1 else 0)
   104	        assert dr != 0 or dc != 0, "expected candidate gap on frame border"
   105	        ok = True
   106	        if dr == 0:
   107	            ok = (
   108	                0 <= r - 1 < h
   109	                and 0 <= r + 1 < h
   110	                and int(g[r - 1, c]) == wall
   111	                and int(g[r + 1, c]) == wall
   112	            )
   113	        elif dc == 0:
   114	            ok = (
   115	                0 <= c - 1 < w
   116	                and 0 <= c + 1 < w
   117	                and int(g[r, c - 1]) == wall
   118	                and int(g[r, c + 1]) == wall
   119	            )
   120	        else:
   121	            ok = (
   122	                0 <= r - dr < h
   123	                and 0 <= c < w
   124	                and 0 <= r < h
   125	                and 0 <= c - dc < w
   126	                and int(g[r - dr, c]) == wall
   127	                and int(g[r, c - dc]) == wall
   128	            )
   129	        if ok:
   130	            out.append((r, c))
   131	
   132	    out_set = set(out)
   133	    if len(out_set) >= 3 and (fr1, fc1) in out_set and (fr0, bc + 1) in out_set:
   134	        out = [p for p in out if p != (fr1, fc1)]
   135	    return out
