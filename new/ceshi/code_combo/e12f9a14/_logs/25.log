+# --------------- generator (combo) ---------------
+
+GRID_SIZE_MIN = 16
+GRID_SIZE_MAX = 30
+GEN_RETRIES = 300
+MIN_POST_TURN_STEPS = 3
+BG_CHOICES = [0, 8]
+BG_WEIGHTS = [0.25, 0.75]
+FRAME_COLOR_FOR_BG = {8: 3, 0: 8}
+PALETTE_FOR_BG = {
+    8: [1, 2, 4, 6, 7, 9],
+    0: [1, 2, 3, 4, 6, 7, 9],
+}
+
+
