   274	    def diag_segment_owner(p: tuple[int, int], q: tuple[int, int]) -> int | None:
   275	        dr, dc = q[0] - p[0], q[1] - p[1]
   276	        if abs(dr) != 1 or abs(dc) != 1:
   277	            return None
   278	        oq = cell_owner.get(q)
   279	        if oq is not None and cell_index.get(q, 0) > 0 and cell_enter.get(q) == (dr, dc):
   280	            return oq
   281	        op = cell_owner.get(p)
   282	        if op is not None and cell_index.get(p, 0) > 0 and cell_enter.get(p) == (-dr, -dc):
   283	            return op
   284	        return None
