   138	def _normalize_dir(dr: int, dc: int) -> tuple[int, int]:
   139	    if dr == 0 and dc == 0:
   140	        return (0, 0)
   141	    if dr != 0 and dc != 0:
   142	        return (int(np.sign(dr)), int(np.sign(dc)))
   143	    if dr != 0:
   144	        return (int(np.sign(dr)), 0)
   145	    return (0, int(np.sign(dc)))
   146	
   147	
   148	def _dir_diff(a: tuple[int, int], b: tuple[int, int]) -> int:
   149	    ia = _DIR_TO_I[a]
   150	    ib = _DIR_TO_I[b]
   151	    d = (ia - ib) % 8
   152	    return min(d, 8 - d)
   153	
   154	
   155	def _is_diag(d: tuple[int, int]) -> bool:
   156	    return abs(d[0]) + abs(d[1]) == 2
   157	
   158	
   159	def _turn_options(d: tuple[int, int]) -> tuple[tuple[int, int], tuple[int, int]]:
   160	    dr, dc = d
   161	    if _is_diag(d):
   162	        return ((dr, 0), (0, dc))
   163	    if dr == 0:
   164	        return ((-1, 0), (1, 0))
   165	    return ((0, -1), (0, 1))
