+            src_b = rewind_beam(b, cell_index[n2])
+        elif cell_owner.get(p2) == b and cell_index.get(p2, 0) > 0 and cell_enter.get(p2) == (p2[0] - n2[0], p2[1] - n2[1]):
+            db = (p2[0] - n2[0], p2[1] - n2[1])
+            src_b = rewind_beam(b, cell_index[p2])
