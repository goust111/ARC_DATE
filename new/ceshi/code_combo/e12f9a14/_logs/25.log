   286	    def choose_turn_pair(
   287	        src_a: tuple[int, int] | None,
   288	        dir_a: tuple[int, int],
   289	        src_b: tuple[int, int] | None,
   290	        dir_b: tuple[int, int],
   291	    ) -> tuple[tuple[int, int], tuple[int, int]] | None:
   292	        if src_a is None or src_b is None:
   293	            return None
   294	        best: tuple[int, int, tuple[int, int], tuple[int, int]] | None = None
   295	        for out_a in _turn_options(dir_a):
   296	            ta = (src_a[0] + out_a[0], src_a[1] + out_a[1])
   297	            if not in_bounds(ta) or not is_open_bg(ta) or cell_owner.get(ta) is not None:
   298	                continue
   299	            for out_b in _turn_options(dir_b):
   300	                tb = (src_b[0] + out_b[0], src_b[1] + out_b[1])
   301	                if not in_bounds(tb) or not is_open_bg(tb) or cell_owner.get(tb) is not None:
   302	                    continue
   303	                if ta == tb:
   304	                    continue
   305	                score = abs(ta[0] - tb[0]) + abs(ta[1] - tb[1])
   306	                tie = int(out_a != out_b)
   307	                cand = (score, tie, out_a, out_b)
   308	                if best is None or cand > best:
   309	                    best = cand
   310	        if best is None:
   311	            return None
   312	        return best[2], best[3]
