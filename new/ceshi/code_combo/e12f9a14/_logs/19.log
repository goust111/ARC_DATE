+# --------------- generator ---------------
+
+GRID_SIZE_RANGE = (16, 31)
+BG_CHOICES = [0, 8]
+BG_WEIGHTS = [0.25, 0.75]
+FRAME_COLOR_FOR_BG = {8: 3, 0: 8}
+PALETTE_FOR_BG = {
+    8: [1, 2, 4, 6, 7, 9],
+    0: [1, 2, 3, 4, 6, 7, 9],
+}
+FRAME_BBOX_GAP = 2
+MIN_PRE_CROSS_STEPS = 3
+MIN_POST_CROSS_STEPS = 4
+MIN_TOTAL_BEAM_PIXELS = 12
+GEN_RETRIES = 400
