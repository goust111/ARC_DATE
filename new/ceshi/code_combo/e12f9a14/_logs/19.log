+
+
+def _ray_cells(
+    grid: np.ndarray,
+    bg: int,
+    seed: tuple[int, int],
+    direction: tuple[int, int],
+) -> list[tuple[int, int]] | None:
+    h, w = grid.shape
+    cells = [seed]
+    r, c = seed
+    dr, dc = direction
