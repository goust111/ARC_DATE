def _collect_beam_specs(g: np.ndarray) -> tuple[int, list[tuple[int, tuple[int, int], tuple[int, int]]]]:
    bg = get_bg(g)
    specs: list[tuple[int, tuple[int, int], tuple[int, int]]] = []
