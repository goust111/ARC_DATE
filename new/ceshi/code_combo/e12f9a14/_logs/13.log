+            group.add(pa)
+        if pb is not None:
+            group.add(pb)
+        for gid in group:
+            beams[gid].pattern = (u,)
+            beams[gid].phase = 0
+            beams[gid].active = True
+
+    max_iters = h * w * 200
+    for _ in range(max_iters):
+        active = [bid for bid, b in beams.items() if b.active]
+        if not active:
