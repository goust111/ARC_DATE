+            unpaint_cell(cell)
+            nd = _normalize_dir(da[0] + db[0], da[1] + db[1])
+            group = {a, b}
+            pa = find_partner(a)
+            pb = find_partner(b)
+            if pa is not None:
+                group.add(pa)
+            if pb is not None:
+                group.add(pb)
