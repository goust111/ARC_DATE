   574	def _gap_combos(size: int) -> list[tuple[tuple[int, int], ...]]:
   575	    combos = []
   576	    for combo in itertools.combinations(_BORDER_ORDER, size):
   577	        idxs = sorted(_BORDER_INDEX[p] for p in combo)
   578	        if any((idxs[(i + 1) % size] - idxs[i]) % 12 == 1 for i in range(size)):
   579	            continue
   580	        if size >= 3 and (3, 3) in combo and (0, 2) in combo:
   581	            continue
   582	        combos.append(combo)
   583	    return combos
   584	
   585	
   586	_GAP_COMBOS = {n: _gap_combos(n) for n in range(1, 5)}
   587	
   588	
   589	def _gap_dir(gap: tuple[int, int]) -> tuple[int, int]:
   590	    gr, gc = gap
   591	    dr = -1 if gr == 0 else (1 if gr == 3 else 0)
   592	    dc = -1 if gc == 0 else (1 if gc == 3 else 0)
   593	    return dr, dc
   594	
   595	
   596	def _frames_separated(a: tuple[int, int], b: tuple[int, int]) -> bool:
   597	    ar0, ac0 = a
   598	    br0, bc0 = b
   599	    ar1, ac1 = ar0 + 3, ac0 + 3
   600	    br1, bc1 = br0 + 3, bc0 + 3
   601	    gap = FRAME_BBOX_GAP
   602	    return ar1 + gap < br0 or br1 + gap < ar0 or ac1 + gap < bc0 or bc1 + gap < ac0
   603	
   604	
   605	def _choose_positions(n: int, count: int, rng: np.random.Generator) -> list[tuple[int, int]] | None:
   606	    margin = PLACEMENT_MARGIN
   607	    all_positions = [(r, c) for r in range(margin, n - 5) for c in range(margin, n - 5)]
   608	    selected: list[tuple[int, int]] = []
   609	    for _ in range(count):
   610	        viable = [p for p in all_positions if all(_frames_separated(p, q) for q in selected)]
   611	        if not viable:
   612	            return None
   613	        selected.append(viable[int(rng.integers(len(viable)))])
   614	    return selected
