+FRAME_BBOX_GAP = 2
+PLACEMENT_MARGIN = 2
+MIN_RAY_STEPS = 2
+MIN_BEAM_PIXELS_PER_GAP = 2
+GEN_RETRIES = 300
+
+_BORDER_ORDER = (
+    (0, 0), (0, 1), (0, 2), (0, 3),
+    (1, 3), (2, 3), (3, 3), (3, 2),
+    (3, 1), (3, 0), (2, 0), (1, 0),
+)
+_BORDER_INDEX = {p: i for i, p in enumerate(_BORDER_ORDER)}
+
