+
+def _collision_layout(
+    n: int,
+    orientation: str,
+    left_or_top_size: int,
+    other_size: int,
+    steps: int,
+    rng: np.random.Generator,
+) -> list[dict] | None:
+    h1 = left_or_top_size // 2
+    h2 = other_size // 2
+
