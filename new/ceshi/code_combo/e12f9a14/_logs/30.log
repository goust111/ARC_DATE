+def _collision_layout(
+    n: int,
+    orientation: str,
+    left_or_top_size: int,
+    other_size: int,
+    steps: int,
+    rng: np.random.Generator,
+) -> list[dict] | None:
+    h1 = left_or_top_size // 2
+    h2 = other_size // 2
+
+    for _ in range(60):
+        cr = int(rng.integers(4, n - 4))
+        cc = int(rng.integers(4, n - 4))
+
+        if orientation == "LT":
+            specs = [
+                {"center": (cr, cc - (h1 + steps)), "size": left_or_top_size, "dir": (0, 1)},
+                {"center": (cr - (h2 + steps), cc), "size": other_size, "dir": (1, 0)},
+            ]
+            runway_dirs = [(0, 1), (1, 0), (1, 1)]
+        elif orientation == "RT":
+            specs = [
+                {"center": (cr, cc + (h1 + steps)), "size": left_or_top_size, "dir": (0, -1)},
+                {"center": (cr - (h2 + steps), cc), "size": other_size, "dir": (1, 0)},
+            ]
+            runway_dirs = [(0, -1), (1, 0), (1, -1)]
+        elif orientation == "LB":
+            specs = [
+                {"center": (cr, cc - (h1 + steps)), "size": left_or_top_size, "dir": (0, 1)},
+                {"center": (cr + (h2 + steps), cc), "size": other_size, "dir": (-1, 0)},
+            ]
+            runway_dirs = [(0, 1), (-1, 0), (-1, 1)]
+        elif orientation == "RB":
+            specs = [
+                {"center": (cr, cc + (h1 + steps)), "size": left_or_top_size, "dir": (0, -1)},
+                {"center": (cr + (h2 + steps), cc), "size": other_size, "dir": (-1, 0)},
+            ]
+            runway_dirs = [(0, -1), (-1, 0), (-1, -1)]
+        else:
+            raise ValueError(f"unknown orientation: {orientation}")
+
+        ok = True
+        for spec in specs:
+            hs = spec["size"] // 2
+            r0 = spec["center"][0] - hs
+            c0 = spec["center"][1] - hs
+            r1 = spec["center"][0] + hs
+            c1 = spec["center"][1] + hs
+            if r0 < 0 or c0 < 0 or r1 >= n or c1 >= n:
+                ok = False
+                break
+        if not ok:
+            continue
+
+        min_runway = min(
+            sum(
+                1
+                for k in range(1, n)
+                if 0 <= cr + d[0] * k < n and 0 <= cc + d[1] * k < n
+            )
+            for d in runway_dirs
+        )
+        if min_runway < 3:
+            continue
+        return specs
+
+    return None
+
