+class _Beam:
+    __slots__ = ("bid", "color", "source", "pos", "direction", "active")
+
+    def __init__(self, bid: int, source: dict):
+        self.bid = bid
+        self.color = int(source["color"])
+        self.source = source
+        self.pos = source["gap"]
+        self.direction = source["dir"]
+        self.active = True
