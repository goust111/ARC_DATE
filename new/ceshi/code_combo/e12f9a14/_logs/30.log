+    r0 = center[0] - h
+    c0 = center[1] - h
+    patch = np.full((outer_size, outer_size), frame_color, dtype=int)
+    patch[1:-1, 1:-1] = block_color
+    gr, gc = _side_gap_local(outer_size, direction)
+    patch[gr, gc] = bg
+    paste(grid, patch, r0, c0)
