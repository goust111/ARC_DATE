+def _side_gap_local(size: int, direction: tuple[int, int]) -> tuple[int, int]:
+    h = size // 2
+    dr, dc = direction
+    if (dr, dc) == (0, 1):
+        return (h, size - 1)
+    if (dr, dc) == (0, -1):
+        return (h, 0)
+    if (dr, dc) == (1, 0):
