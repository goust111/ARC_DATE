+
+def _draw_source(
+    grid: np.ndarray,
+    center: tuple[int, int],
+    outer_size: int,
+    bg: int,
+    frame_color: int,
+    block_color: int,
+    direction: tuple[int, int],
+) -> None:
+    h = outer_size // 2
+    r0 = center[0] - h
+    c0 = center[1] - h
+    patch = np.full((outer_size, outer_size), frame_color, dtype=int)
+    patch[1:-1, 1:-1] = block_color
+    gr, gc = _side_gap_local(outer_size, direction)
+    patch[gr, gc] = bg
+    paste(grid, patch, r0, c0)
