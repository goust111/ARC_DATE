+
+def _infer_frame_color(g: np.ndarray, bg: int) -> int:
+    vals = [int(v) for v in g.ravel() if int(v) != bg]
+    assert vals, "expected non-background objects"
+    counts = np.bincount(vals, minlength=10)
+    return int(np.argmax(counts))
