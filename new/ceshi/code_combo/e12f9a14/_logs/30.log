+            a, b = sorted(bidders)
+            ba = beams[a]
+            bb = beams[b]
+            sa = ba.source
+            sb = bb.source
+            dist = _manhattan(sa["center"], sb["center"])
+            near = dist <= NEAR_DISTANCE_THRESHOLD
+
+            if sa["outer_size"] > sb["outer_size"]:
+                winner, loser = a, b
+            elif sb["outer_size"] > sa["outer_size"]:
