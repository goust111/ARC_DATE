+        (fr0, fc1),
+        (fr0 + 1, fc1),
+        (fr0 + 2, fc1),
+        (fr1, fc1),
+        (fr1, fc0 + 2),
+        (fr1, fc0 + 1),
+        (fr1, fc0),
+        (fr0 + 2, fc0),
+        (fr0 + 1, fc0),
+    ]
