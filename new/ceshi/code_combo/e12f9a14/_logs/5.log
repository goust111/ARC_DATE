+    cell_collisions = 0
+
+    for cell, colors in visitors.items():
+        if len(colors) < 2:
+            continue
+        assert len(colors) == 2, "generator must avoid triple cell collisions"
+        beam_ids = sorted(cell_beams[cell])
+        assert len(beam_ids) == 2, "expected one beam per color at a cell collision"
