+class _Beam:
+    __slots__ = ("bid", "color", "seed", "direction", "path", "path_index")
+
+    def __init__(
+        self,
+        bid: int,
+        color: int,
+        seed: tuple[int, int],
+        direction: tuple[int, int],
+        path: tuple[tuple[int, int], ...],
+    ) -> None:
+        self.bid = bid
+        self.color = int(color)
+        self.seed = seed
+        self.direction = direction
+        self.path = path
+        self.path_index = {cell: i for i, cell in enumerate(path)}
