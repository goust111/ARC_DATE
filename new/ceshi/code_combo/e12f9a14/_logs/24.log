+
+def _dir_diff(a: tuple[int, int], b: tuple[int, int]) -> int:
+    ia = _DIR_TO_I[a]
+    ib = _DIR_TO_I[b]
+    d = (ia - ib) % 8
+    return min(d, 8 - d)
