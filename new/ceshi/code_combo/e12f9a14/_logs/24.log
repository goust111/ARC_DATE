+def _normalize_dir(dr: int, dc: int) -> tuple[int, int]:
+    if dr == 0 and dc == 0:
+        return (0, 0)
+    if dr != 0 and dc != 0:
+        return (int(np.sign(dr)), int(np.sign(dc)))
+    if dr != 0:
+        return (int(np.sign(dr)), 0)
+    return (0, int(np.sign(dc)))
