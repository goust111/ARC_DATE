+    grid = np.full((n, n), bg, dtype=int)
+    for obj in objects:
+        r0, c0 = obj["pos"]
+        _draw_frame(
+            grid,
+            r0,
+            c0,
+            bg,
+            frame_color,
+            obj["gaps"],
+            str(obj["kind"]),
+            obj["beam_color"],
+            obj["turn"],
+        )
+
+    if int(np.bincount(grid.ravel(), minlength=10).argmax()) != bg:
+        return None
+    if not _rays_clear(grid, bg, seeds):
+        return None
+
+    frames = _classify_frames(grid, bg)
+    if len(frames) != total_frames:
