+def _frame_gaps_for_frame(g: np.ndarray, bg: int, wall: int, r0: int, c0: int) -> list[tuple[int, int]]:
+    h, w = g.shape
+    fr0, fc0 = r0, c0
+    fr1, fc1 = r0 + 3, c0 + 3
