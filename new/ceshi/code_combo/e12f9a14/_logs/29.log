   112	def _parse_symbol(inner: np.ndarray, bg: int, frame_color: int) -> tuple[int, int] | None:
   113	    vals = [int(v) for v in inner.ravel()]
   114	    if any(v in (bg, frame_color) for v in vals):
   115	        return None
   116	    a, b, c, d = vals
   117	    if a == INSTRUCTION_COLOR and d == INSTRUCTION_COLOR and b == c and b != INSTRUCTION_COLOR:
   118	        return int(b), TURN_LEFT
   119	    if b == INSTRUCTION_COLOR and c == INSTRUCTION_COLOR and a == d and a != INSTRUCTION_COLOR:
   120	        return int(a), TURN_RIGHT
   121	    return None
