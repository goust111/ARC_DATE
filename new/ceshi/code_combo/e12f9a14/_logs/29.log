+        available = _clear_gap_combos(obstacles, bg, r0, c0)
+        if kind == "source":
+            candidate_counts = [k for k in sorted(available) if 2 <= k <= 4]
+            if not candidate_counts:
+                candidate_counts = [k for k in sorted(available) if 1 <= k <= 4]
