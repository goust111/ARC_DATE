   173	def _classify_frames(g: np.ndarray, bg: int) -> list[_FrameCandidate]:
   174	    h, w = g.shape
   175	    frames: list[_FrameCandidate] = []
   176	    for r0 in range(h - 3):
   177	        for c0 in range(w - 3):
   178	            border_vals: list[int] = []
   179	            border_bg: list[tuple[int, int]] = []
   180	            border_ok = True
   181	            for dr, dc in _BORDER_ORDER:
   182	                v = int(g[r0 + dr, c0 + dc])
   183	                if v == bg:
   184	                    border_bg.append((r0 + dr, c0 + dc))
   185	                else:
   186	                    border_vals.append(v)
   187	            if not border_vals:
   188	                continue
   189	            wall_colors = sorted(set(border_vals))
   190	            if len(wall_colors) != 1:
   191	                continue
   192	            wall = wall_colors[0]
   193	            for dr, dc in _BORDER_ORDER:
   194	                if int(g[r0 + dr, c0 + dc]) not in (bg, wall):
   195	                    border_ok = False
   196	                    break
   197	            if not border_ok:
   198	                continue
   199	            wall_count = sum(int(g[r0 + dr, c0 + dc]) == wall for dr, dc in _BORDER_ORDER)
   200	            if not (6 <= wall_count <= 12):
   201	                continue
   202	
   203	            gaps = tuple(_frame_gaps_for_frame(g, bg, wall, r0, c0))
   204	            if set(border_bg) != set(gaps):
   205	                continue
   206	
   207	            inner = g[r0 + 1 : r0 + 3, c0 + 1 : c0 + 3]
   208	            parsed = _parse_symbol(inner, bg, wall)
   209	            if parsed is not None:
   210	                beam_color, turn = parsed
   211	                if 1 <= len(gaps) <= 4:
   212	                    kind = "source"
   213	                elif len(gaps) == 0:
   214	                    kind = "sealed_symbol"
   215	                elif 5 <= len(gaps) <= 6:
   216	                    kind = "shattered_symbol"
   217	                else:
   218	                    continue
   219	                frames.append(_FrameCandidate(r0, c0, wall, gaps, kind, beam_color, turn))
   220	                continue

