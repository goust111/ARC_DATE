+def _parse_symbol(inner: np.ndarray, bg: int, frame_color: int) -> tuple[int, int] | None:
+    vals = [int(v) for v in inner.ravel()]
+    if any(v in (bg, frame_color) for v in vals):
+        return None
+    a, b, c, d = vals
