   124	def _frame_gaps_for_frame(g: np.ndarray, bg: int, wall: int, r0: int, c0: int) -> list[tuple[int, int]]:
   125	    h, w = g.shape
   126	    fr0, fc0 = r0, c0
   127	    fr1, fc1 = r0 + 3, c0 + 3
   128	    gaps: list[tuple[int, int]] = []
   129	    for r in range(fr0, fr1 + 1):
   130	        for c in range(fc0, fc1 + 1):
   131	            if not (0 <= r < h and 0 <= c < w):
   132	                continue
   133	            if not (r in (fr0, fr1) or c in (fc0, fc1)):
   134	                continue
   135	            if int(g[r, c]) == bg:
   136	                gaps.append((r, c))
   137	
   138	    out: list[tuple[int, int]] = []
   139	    for r, c in gaps:
   140	        dr = -1 if r == fr0 else (1 if r == fr1 else 0)
   141	        dc = -1 if c == fc0 else (1 if c == fc1 else 0)
   142	        assert dr != 0 or dc != 0, "expected candidate gap on frame border"
   143	        if dr == 0:
   144	            ok = (
   145	                0 <= r - 1 < h
   146	                and 0 <= r + 1 < h
   147	                and int(g[r - 1, c]) == wall
   148	                and int(g[r + 1, c]) == wall
   149	            )
   150	        elif dc == 0:
   151	            ok = (
   152	                0 <= c - 1 < w
   153	                and 0 <= c + 1 < w
   154	                and int(g[r, c - 1]) == wall
   155	                and int(g[r, c + 1]) == wall
   156	            )
   157	        else:
   158	            ok = (
   159	                0 <= r - dr < h
   160	                and 0 <= c - dc < w
   161	                and int(g[r - dr, c]) == wall
   162	                and int(g[r, c - dc]) == wall
   163	            )
   164	        if ok:
   165	            out.append((r, c))
   166	
   167	    out_set = set(out)
   168	    if len(out_set) >= 3 and (fr1, fc1) in out_set and (fr0, c0 + 2) in out_set:
   169	        out = [p for p in out if p != (fr1, fc1)]
   170	    return out
   171	
