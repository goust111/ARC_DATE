+
+
+def _rays_clear(
+    grid: np.ndarray,
+    bg: int,
+    seeds: list[tuple[tuple[int, int], tuple[int, int], int]],
+) -> bool:
+    h, w = grid.shape
+    for (r, c), (dr, dc), steps in seeds:
