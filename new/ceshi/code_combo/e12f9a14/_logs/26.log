+class _Beam:
+    __slots__ = (
+        "bid",
+        "color",
+        "pos",
+        "pattern",
+        "phase",
+        "path",
+        "path_steps",
+        "enter_dirs",
+        "active",
+        "remaining",
+        "trace_step",
+    )
