+def _ray_cells(
+    seed: tuple[int, int],
+    direction: tuple[int, int],
+    total_cells: int,
+) -> list[tuple[int, int]]:
+    r, c = seed
+    dr, dc = direction
+    cells = [seed]
+    for _ in range(total_cells - 1):
+        r += dr
+        c += dc
+        cells.append((r, c))
+    return cells
+
+
+def _rays_clear(
+    grid: np.ndarray,
+    bg: int,
+    seeds: list[tuple[tuple[int, int], tuple[int, int], int]],
+) -> bool:
+    h, w = grid.shape
+    for (r, c), (dr, dc), steps in seeds:
+        nr, nc = r, c
+        for _ in range(steps):
+            nr += dr
+            nc += dc
+            if not (0 <= nr < h and 0 <= nc < w):
+                return False
+            if int(grid[nr, nc]) != bg:
+                return False
+        for _ in range(MIN_POST_STOP_BUFFER):
