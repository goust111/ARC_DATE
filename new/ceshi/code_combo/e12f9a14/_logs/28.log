+        cell_owner[cell] = bid
+        cell_enter[cell] = enter_dir
+        cell_index[cell] = len(beam.path) - 1
+
+    max_iters = h * w + len(beams)
+    for _ in range(max_iters):
+        active_any = False
+        moved_any = False
+        for bid in sorted(beams):
+            beam = beams[bid]
+            if not beam.active:
+                continue
+            active_any = True
+            dr, dc = beam.direction
+            nxt = (beam.pos[0] + dr, beam.pos[1] + dc)
+            if not in_bounds(nxt):
