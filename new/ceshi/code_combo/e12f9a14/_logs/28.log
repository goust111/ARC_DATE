+        if not _frames_separated(pos_a, pos_c, FRAME_BBOX_GAP):
+            continue
+        if not _frames_separated(pos_b, pos_c, FRAME_BBOX_GAP):
+            continue
+
+        meet_row = pos_b[0] + 2
+        a_col = pos_a[1] + 1
+        c_col = pos_c[1] + 1
+        b_col = pos_b[1]
