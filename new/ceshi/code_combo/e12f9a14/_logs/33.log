+    stats = {
+        "source_count": len(sources),
+        "horizontal_count": len(horizontal),
+        "vertical_count": len(vertical),
+        "orth_crossings": len(crossings),
+        "changed_pixels": int(np.count_nonzero(out != g)),
+    }
