+
+
+def _gen_attempt() -> np.ndarray | None:
+    rng = np.random.default_rng()
+    n = int(rng.integers(*GRID_SIZE_RANGE))
+    counts = _SIDE_COUNT_CHOICES[int(rng.integers(len(_SIDE_COUNT_CHOICES)))]
