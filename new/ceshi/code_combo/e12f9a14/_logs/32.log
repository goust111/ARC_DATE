from itertools import product, combinations

def bbox(seed, kind):
    r,c=seed
    if kind=='E': return (r-1,c-3,r+2,c)
    if kind=='N': return (r,c-1,r+3,c+2)
    if kind=='NW': return (r,c,r+3,c+3)
    if kind=='NE': return (r,c-3,r+3,c)

def sep(b1,b2,g=2):
    r0,c0,r1,c1=b1; s0,t0,s1,t1=b2
    return r1+g < s0 or s1+g < r0 or c1+g < t0 or t1+g < c0

def frame_cells(seed, kind):
    r0,c0,r1,c1=bbox(seed,kind)
    cells=set()
    for r in range(r0,r1+1):
        for c in range(c0,c1+1):
            if r in (r0,r1) or c in (c0,c1):
                cells.add((r,c))
    cells.remove(seed)
    return cells

def path(seed,d,n=30):
    r,c=seed; dr,dc=d
    pts=[seed]
    while True:
        r+=dr; c+=dc
        if not (0<=r<n and 0<=c<n): break
        pts.append((r,c))
    return pts

def intersections(E,N,C,D):
    rH,cE=E; rN,cV=N; rC,cC=C; rD,cD=D
    if cV<=cE: return None
    pts=[]
    pts.append((rH,cV))
    # with NW: r-c = k
    k=rC-cC
    c = rH-k
    r = cV+k
    pts.append((rH,c))
    pts.append((r,cV))
    # with NE: r+c=s
    s=rD+cD
    c2=s-rH
    r2=s-cV
    pts.append((rH,c2))
    pts.append((r2,cV))
    # diag-diag need any crossing, allow cell only for now
    if (k+s)%2"'!=0:
        return None
    rc=((k+s)//2,(s-k)//2)
    pts.append(rc)
    return pts

cand=[]
E_seeds=[(r,c) for r in range(5,10) for c in range(3,7)]
N_seeds=[(r,c) for r in range(15,21) for c in range(10,17)]
C_seeds=[(r,c) for r in range(14,21) for c in range(16,25)]
D_seeds=[(r,c) for r in range(14,21) for c in range(6,15)]
for E in E_seeds:
  bE=bbox(E,'"'E')
  for N in N_seeds:
    bN=bbox(N,'N')
    if not sep(bE,bN): continue
    for C in C_seeds:
