   104	def _infer_frame_color(g: np.ndarray, bg: int, br: int, bc: int, block_col: int) -> int:
   105	    h, w = g.shape
   106	    fr0, fc0 = br - 1, bc - 1
   107	    fr1, fc1 = br + 2, bc + 2
   108	    vals: list[int] = []
   109	    for r in range(fr0, fr1 + 1):
   110	        for c in range(fc0, fc1 + 1):
   111	            if not (0 <= r < h and 0 <= c < w):
   112	                continue
   113	            if not (r in (fr0, fr1) or c in (fc0, fc1)):
   114	                continue
   115	            v = int(g[r, c])
   116	            if v != bg and v != block_col:
   117	                vals.append(v)
   118	    frame_colors = sorted(set(vals))
   119	    assert len(frame_colors) == 1, "expected a unique frame color around each 2x2 block"
   120	    return frame_colors[0]
   121	
   122	
   123	def _frame_gaps_for_block(g: np.ndarray, bg: int, wall: int, br: int, bc: int) -> list[tuple[int, int]]:
   124	    h, w = g.shape
   125	    fr0, fc0 = br - 1, bc - 1
   126	    fr1, fc1 = br + 2, bc + 2
   127	    gaps: list[tuple[int, int]] = []
   128	    for r in range(fr0, fr1 + 1):
   129	        for c in range(fc0, fc1 + 1):
   130	            if not (0 <= r < h and 0 <= c < w):
   131	                continue
   132	            if not (r in (fr0, fr1) or c in (fc0, fc1)):
   133	                continue
   134	            if int(g[r, c]) == bg:
   135	                gaps.append((r, c))
   136	
   137	    out: list[tuple[int, int]] = []
   138	    for r, c in gaps:
   139	        dr = -1 if r == fr0 else (1 if r == fr1 else 0)
   140	        dc = -1 if c == fc0 else (1 if c == fc1 else 0)
   141	        assert dr != 0 or dc != 0, "expected candidate gap on frame border"
   142	        if dr == 0:
   143	            ok = (
   144	                0 <= r - 1 < h
   145	                and 0 <= r + 1 < h
   146	                and int(g[r - 1, c]) == wall
   147	                and int(g[r + 1, c]) == wall
   148	            )
   149	        elif dc == 0:
   150	            ok = (
   151	                0 <= c - 1 < w
   152	                and 0 <= c + 1 < w
   153	                and int(g[r, c - 1]) == wall
   154	                and int(g[r, c + 1]) == wall
   155	            )
   156	        else:
   157	            ok = (
   158	                0 <= r - dr < h
   159	                and 0 <= c - dc < w
   160	                and int(g[r - dr, c]) == wall
   161	                and int(g[r, c - dc]) == wall
   162	            )
   163	        if ok:
   164	            out.append((r, c))
   165	
   166	    out_set = set(out)
   167	    if len(out_set) >= 3 and (fr1, fc1) in out_set and (fr0, bc + 1) in out_set:
   168	        out = [p for p in out if p != (fr1, fc1)]
   169	    return out
   170	
   171	
   172	def _gap_dir(gap: tuple[int, int]) -> tuple[int, int]:
   173	    gr, gc = gap
   174	    dr = -1 if gr == 0 else (1 if gr == 3 else 0)
   175	    dc = -1 if gc == 0 else (1 if gc == 3 else 0)
   176	    return dr, dc
   177	
   178	
   179	def _draw_framed_block(
   180	    grid: np.ndarray,
   181	    r0: int,
   182	    c0: int,
   183	    bg: int,
   184	    frame_color: int,
   185	    block_color: int,
   186	    gaps: tuple[tuple[int, int], ...],
   187	) -> None:
   188	    patch = np.full((4, 4), frame_color, dtype=int)
   189	    patch[1:3, 1:3] = block_color
   190	    for gr, gc in gaps:
   191	        patch[gr, gc] = bg
   192	    paste(grid, patch, r0, c0)
   193	
   194	
   195	def _trace_ray(
   196	    g: np.ndarray,
   197	    bg: int,
   198	    seed: tuple[int, int],
   199	    direction: tuple[int, int],
   200	) -> tuple[tuple[int, int], ...]:
   201	    h, w = g.shape
   202	    r, c = seed
   203	    dr, dc = direction
   204	    path = [seed]
   205	    while True:
   206	        nr, nc = r + dr, c + dc
   207	        if not (0 <= nr < h and 0 <= nc < w):
   208	            break
   209	        if int(g[nr, nc]) != bg:
   210	            break
   211	        path.append((nr, nc))
   212	        r, c = nr, nc
   213	    return tuple(path)
