   216	def _extract_beams(g: np.ndarray) -> tuple[int, list[int], list[_Beam]]:
   217	    bg = get_bg(g)
   218	    blocks = _find_blocks_2x2(g, bg)
   219	    assert blocks, "expected at least one 2x2 block in input"
   220	
   221	    block_colors = sorted({int(col) for col, _, _ in blocks})
   222	    assert block_colors == sorted(BLOCK_COLORS), "variant expects blue/red/green/yellow source blocks"
   223	
   224	    beams: list[_Beam] = []
   225	    for col, br, bc in blocks:
   226	        frame_col = _infer_frame_color(g, bg, br, bc, col)
   227	        assert frame_col == FRAME_COLOR, "variant expects a shared cyan frame color"
   228	        gaps = _frame_gaps_for_block(g, bg, frame_col, br, bc)
   229	        assert len(gaps) == 1, "variant expects exactly one structural gap per frame"
   230	        gr, gc = gaps[0]
   231	        dr = -1 if gr == br - 1 else (1 if gr == br + 2 else 0)
   232	        dc = -1 if gc == bc - 1 else (1 if gc == bc + 2 else 0)
   233	        direction = (dr, dc)
   234	        assert direction != (0, 0), "expected gap to face outward"
   235	        beams.append(_Beam(int(col), (gr, gc), direction, _trace_ray(g, bg, (gr, gc), direction)))
   236	
   237	    assert len(beams) == 4, "variant expects exactly four beams"
   238	    return bg, block_colors, beams
