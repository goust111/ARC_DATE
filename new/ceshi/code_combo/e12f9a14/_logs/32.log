from itertools import product, combinations

# Search for 4 frames with directions E, N, NW, NE.
# Frame top-left positions in template bounds 0..24 maybe.
# Separation by at least 2 cells between 4x4 bounding boxes.

def sep(a,b,gap=2):
    ar,ac=a; br,bc=b
    return ar+3+gap < br or br+3+gap < ar or ac+3+gap < bc or bc+3+gap < ac

def seed(pos, kind):
    r,c=pos
    if kind=='E': return (r+1,c+3),(0,1)
    if kind=='N': return (r,c+1),(-1,0)
    if kind=='NW': return (r,c),(-1,-1)
    if kind=='NE': return (r,c+3),(-1,1)
    raise

def trace(seed,d,n=40):
    (r,c), (dr,dc) = seed,d
    pts=[(r,c)]
    while True:
        r += dr; c += dc
        if not (0<=r<n and 0<=c<n): break
        pts.append((r,c))
    return pts

def cross_area(seg1, seg2):
    p0,p1=seg1; q0,q1=seg2
    pts={p0,p1,q0,q1}
    if len(pts)"'!=4: return None
    rows=sorted({r for r,_ in pts}); cols=sorted({c for _,c in pts})
    if len(rows)==2 and len(cols)==2 and rows[1]-rows[0]==1 and cols[1]-cols[0]==1:
        return tuple((r,c) for r in rows for c in cols)
    return None

# obstacle hit check against all frames excluding own starting gap cell maybe any non-bg means blocked.
def frame_cells(pos, kind):
    r,c=pos
    cells=set()
    for rr in range(r,r+4):
        for cc in range(c,c+4):
            if rr in (r,r+3) or cc in (c,c+3):
                cells.add((rr,cc))
    # remove gap
    gr,gc = {'"'E':(r+1,c+3),'N':(r,c+1),'NW':(r,c),'NE':(r,c+3)}[kind]
    cells.remove((gr,gc))
    return cells

kinds=['E','N','NW','NE']
# hand constrained ranges to bias layout
Erange=[(r,c) for r in range(4,12) for c in range(0,6)]
Nrange=[(r,c) for r in range(16,24) for c in range(10,18)]
NWrange=[(r,c) for r in range(17,25) for c in range(18,26)]
NErange=[(r,c) for r in range(17,25) for c in range(0,8)]
count=0
best=[]
for E in Erange:
    for N in Nrange:
        if not sep(E,N):
            continue
        for NW in NWrange:
            if not (sep(E,NW) and sep(N,NW)):
                continue
            for NE in NErange:
                if not (sep(E,NE) and sep(N,NE) and sep(NW,NE)):
                    continue
                poss=[E,N,NW,NE]
                all_frame_cells=set()
                for p,k in zip(poss,kinds):
                    all_frame_cells |= frame_cells(p,k)
                beams=[]
                valid=True
                for p,k in zip(poss,kinds):
                    s,d=seed(p,k)
                    path=trace(s,d)
                    # check no hits other frames
                    for cell in path[1:]:
                        if cell in all_frame_cells:
                            valid=False; break
                    if not valid: break
                    beams.append((k,s,d,path))
                if not valid:
                    continue
                # collect pairwise collisions
                cells=[]
                areas=[]
                collision_loci=[]
                for i,j in combinations(range(4),2):
                    _,_,di,pi=beams[i]
                    _,_,dj,pj=beams[j]
                    si=set(pi); sj=set(pj)
                    inter=si & sj
                    if inter:
                        # geometric diag-diag also gives cells if same parity; we allow exactly one cell only for non opposite-diag?
                        if len(inter)"'!=1:
                            valid=False; break
                        collision_loci.append(tuple(sorted(inter))[0])
                        continue
                    # maybe diag cross area
                    if abs(di[0])+abs(di[1])==2 and abs(dj[0])+abs(dj[1])==2 and di[1]!=dj[1]:
                        found=None
                        for a,b in zip(pi,pi[1:]):
                            for c,d in zip(pj,pj[1:]):
                                area=cross_area((a,b),(c,d))
                                if area is not None:
                                    found=area; break
                            if found is not None: break
                        if found is None:
                            valid=False; break
                        collision_loci.append(found)
                    else:
                        valid=False; break
                if not valid:
                    continue
                # distinct non-overlapping loci
                flat=[]
                ok=True
                for loc in collision_loci:
                    if isinstance(loc[0], tuple):
                        cells=list(loc)
                    else:
                        cells=[loc]
                    if any(c in flat for c in cells): ok=False
                    flat.extend(cells)
                if not ok:
