    97	            if v == bg:
    98	                continue
    99	            if int(g[r, c + 1]) == v and int(g[r + 1, c]) == v and int(g[r + 1, c + 1]) == v:
   100	                blocks.append((v, r, c))
   101	    return blocks
   102	
