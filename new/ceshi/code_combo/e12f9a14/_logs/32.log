                bbox_w=max(c for p in poss for c in range(p[1],p[1]+4))+1-min(p[1] for p in poss)
                best.append((mind,bbox_h,bbox_w,poss,collision_loci,reps))

best=sorted(best, key=lambda x:(-x[0],x[1]*x[2]))
