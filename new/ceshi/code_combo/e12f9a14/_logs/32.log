        H=max(rmaxs)-min(rmins)+1; W=max(cmaxs)-min(cmins)+1
        cand.append((W*H,W,H,frames,pts))
cand.sort()
print('count',len(cand))
for item in cand[:30]:
    area,W,H,frames,pts=item
    print('W,H',W,H,'frames',frames,'pts',pts)
