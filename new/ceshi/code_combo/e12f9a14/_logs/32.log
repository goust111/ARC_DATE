    91	def _find_blocks_2x2(g: np.ndarray, bg: int) -> list[tuple[int, int, int]]:
    92	    h, w = g.shape
    93	    blocks: list[tuple[int, int, int]] = []
    94	    for r in range(h - 1):
    95	        for c in range(w - 1):
