+
+    assert goal_state is not None, "a valid path to the opposite edge must exist"
+    path: list[tuple[int, int]] = []
+    st = goal_state
+    while True:
+        r, c, _ = st
+        path.append((r, c))
+        if (r, c) == (sr, sc):
+            break
+        st = prev[st]
+    path.reverse()
+    return path
+
+
+def _turn_indices(path: list[tuple[int, int]]) -> list[int]:
+    turns: list[int] = []
+    for i in range(1, len(path) - 1):
+        dr1 = path[i][0] - path[i - 1][0]
