   290	def main(grid: np.ndarray) -> np.ndarray:
   291	    """
   292	    Recover the obstacle-avoiding route from the source task, then keep only sparse turn markers on an otherwise blank output board.
   293	
   294	    Input structure:
   295	    - bg = azure (8). Red/blue bars (colors 2/1) still define the forbidden zones that the hidden route must avoid.
   296	    - A single green (3) pixel lies on one border edge and identifies the route's starting side.
   297	
   298	    Rule:
   299	    - For each bar, count its blue pixels and expand a Manhattan keep-out region of that radius around the whole bar.
   300	    - Find the shortest orthogonal route from the seed edge to the opposite edge that stays outside all forbidden cells.
   301	    - Do not draw the full route. Mark only the short elbow neighborhoods around right-angle turns, leaving straight path segments as background.
   302	    - Build the result on a blank azure grid: remove the obstacle bars, remove the original seed, and keep only those turn-local green path pixels.
   303	
   304	    Key insight: The hidden path logic is unchanged, but the output is now an abstract waypoint map. Blue still encodes how far the path must detour from each bar, while green no longer means "entire route" and instead marks only the route's turning locations.
   305	    """
   306	    g = np.array(grid, copy=True)
   307	    path = _recover_path(g)
   308	    return _render_sparse_turn_path(g, path)
