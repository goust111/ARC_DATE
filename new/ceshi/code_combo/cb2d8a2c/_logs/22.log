+def _find_start(grid: np.ndarray) -> tuple[int, int]:
+    pts = np.argwhere(grid == GREEN)
+    assert pts.shape[0] == 1, "grid must contain exactly one green start pixel"
+    return int(pts[0, 0]), int(pts[0, 1])
