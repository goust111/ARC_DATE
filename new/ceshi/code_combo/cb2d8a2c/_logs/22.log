+        return None
+
+    for _ in range(120):
+        start_c = random.choice(start_choices)
+        current_c = start_c
+        spans: list[tuple[int, int, int]] = []
+        ok = True
+        for color in colors:
+            choices = _bar_choices(cross_size, current_c, color)
+            if not choices:
+                ok = False
+                break
+            c0, c1, next_c = random.choice(choices)
+            spans.append((c0, c1, color))
+            current_c = next_c
+        if not ok:
+            continue
