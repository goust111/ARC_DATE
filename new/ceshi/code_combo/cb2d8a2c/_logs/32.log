+    if metrics["boundary_only_bg"] < MIN_BOUNDARY_ONLY_BG:
+        return False
+    if metrics["hidden_bg"] < MIN_HIDDEN_BG:
+        return False
+    if metrics["max_blank_run"] < 2:
