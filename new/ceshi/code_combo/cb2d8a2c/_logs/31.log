+                "r1": r1,
+                "c0": c0,
+                "c1": c1,
+                "side": side,
+                "base": base,
+                "spacing": spacing,
+                "radius": radius,
+                "prefer_outer": bool(prefer_outer),
+                "target_col": int(target_col),
+                "comp": comp,
+            }
