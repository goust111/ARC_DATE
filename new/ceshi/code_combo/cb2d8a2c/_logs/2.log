+    if slack < 0:
+        return None
+
+    extras = _random_composition(slack, len(radii) + 1)
+    row = radii[0] + 2 + extras[0]
+    rows = [row]
+    for i in range(1, len(radii)):
+        row += radii[i - 1] + radii[i] + 2 + extras[i]
+        rows.append(row)
+
