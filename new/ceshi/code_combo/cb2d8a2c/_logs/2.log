+
+
+def _choose_start_col(cross_size: int, length: int, first_side: int) -> int:
+    half = max(1, length // 2)
+    if first_side == 0:
+        return random.randint(1, min(length - 1, half))
+    lo = max(cross_size - length, cross_size - half - 1)
+    return random.randint(lo, cross_size - 2)
+
+
+def _canonical_grid(
+    main_size: int,
+    cross_size: int,
+    length: int,
+    blues: tuple[int, ...],
+    radii: tuple[int, ...],
