+        "turns": turny,
+        "extra_turns": int(turny > 2 * bars),
+        "diff_from_original": int(not np.array_equal(bfs_out, original_out)),
+        "reaches_goal": int(_reaches_opposite_edge(bfs_out, _start_info(inp)[2])),
