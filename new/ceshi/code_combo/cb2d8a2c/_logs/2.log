+        if min_main > main_hi:
+            continue
+        main_size = random.randint(min_main, min(main_hi, min_main + MAX_MAIN_SLACK))
+        first_side = random.randrange(2)
+
+        canonical = _canonical_grid(main_size, cross_size, length, blues, radii, first_side)
+        if canonical is None:
