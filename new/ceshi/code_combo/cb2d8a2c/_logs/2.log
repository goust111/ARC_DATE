   311	def _random_composition(total: int, parts: int) -> list[int]:
   312	    if parts == 1:
   313	        return [total]
   314	    cuts = sorted(random.sample(range(total + parts - 1), parts - 1))
   315	    out = []
   316	    prev = -1
   317	    for cut in cuts + [total + parts - 1]:
   318	        out.append(cut - prev - 1)
   319	        prev = cut
   320	    return out
