+        start = (0, start_col)
+        turns = list(zip(turn_rows, turn_cols))
+        end = (height - 1, end_col)
+        points = [start, *turns, end]
+
+        try:
+            path: list[tuple[int, int]] = []
+            for (r0, c0), (r1, c1) in zip(points, points[1:]):
