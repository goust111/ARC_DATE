+        ok = True
+        for i in range(count - 1):
+            diff = abs(turn_cols[i + 1] - turn_cols[i])
+            min_gap = 2
+            if diff < min_gap:
+                ok = False
+                break
+            if sides[i] == 0 and turn_cols[i + 1] <= turn_cols[i]:
+                ok = False
+                break
+            if sides[i] == 1 and turn_cols[i + 1] >= turn_cols[i]:
