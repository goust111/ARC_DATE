+    inf = (10**9, 10**9)
+    best_cost: dict[tuple[int, int, int], tuple[int, int]] = {}
+    prev: dict[tuple[int, int, int], tuple[int, int, int]] = {}
+    heap: list[tuple[tuple[int, int], int, int, int]] = []
+
+    for d in init_dirs:
+        state = (sr, sc, d)
+        best_cost[state] = (0, 0)
+        heapq.heappush(heap, ((0, 0), sr, sc, d))
