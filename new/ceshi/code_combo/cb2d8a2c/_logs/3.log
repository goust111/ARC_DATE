+            ncost = (turns + (0 if nd == dprev else 1), steps + 1)
+            key = (rr, cc, nd)
+            if ncost < best_cost.get(key, inf):
+                best_cost[key] = ncost
+                prev[key] = (r, c, dprev)
+                heapq.heappush(heap, (ncost, rr, cc, nd))
