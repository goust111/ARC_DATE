+
+        if _path_turn_count(path) != count:
+            continue
+
+        grid[start] = GREEN
+        expected = _expected_output(grid, path)
+        solved = main(grid)
+        if not np.array_equal(solved, expected):
+            continue
+        if not np.array_equal(main(grid), solved):
+            continue
+        return grid, expected
+    return None
