+def _segment_cells(r0: int, c0: int, r1: int, c1: int) -> list[tuple[int, int]]:
+    dr = r1 - r0
+    dc = c1 - c0
+    assert abs(dr) == abs(dc), "segment must be a 45-degree diagonal"
+    sr = 1 if dr > 0 else -1
+    sc = 1 if dc > 0 else -1
+    return [(r0 + k * sr, c0 + k * sc) for k in range(abs(dr) + 1)]
