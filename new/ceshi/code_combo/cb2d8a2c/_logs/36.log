+        cross_vals = [_cross_coord(info, r, c) for r, c in cells]
+        bars.append(
+            {
+                "id": idx,
+                "cells": cells,
+                "blue_count": blue_count,
+                "dist_to_start": int(dist_to_start),
+                "main_pos": int(min(main_vals)),
+                "cross_pos": int(min(cross_vals)),
