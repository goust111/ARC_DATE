+def _reaches_opposite_edge(out: np.ndarray) -> bool:
+    return bool(np.any(out[-1, :] == GREEN))
+
+
+def _gen_attempt() -> np.ndarray | None:
+    h = random.randint(ROWS_LO, ROWS_HI)
+    w = random.randint(COLS_LO, COLS_HI)
