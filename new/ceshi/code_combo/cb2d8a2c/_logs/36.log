+                dist[rr, cc] = d + 1
+                q.append((rr, cc))
+
+
+def _solve_variant(
+    grid: np.ndarray,
+    *,
+    order_mode: str,
+    truncate: bool,
+    stop_at_opposite_edge: bool,
+    return_debug: bool = False,
