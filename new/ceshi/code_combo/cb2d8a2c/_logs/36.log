+                "id": idx,
+                "cells": cells,
+                "blue_count": blue_count,
+                "dist_to_start": int(dist_to_start),
+                "main_pos": int(min(main_vals)),
+                "cross_pos": int(min(cross_vals)),
+            }
+        )
+    return bars
+
+
+def _expand_keepout(mask: np.ndarray, cells: list[tuple[int, int]], radius: int) -> None:
+    h, w = mask.shape
