+    if np.array_equal(combo_out, full_out):
+        return None
+    if _reaches_opposite_edge(combo_out):
+        return None
+    if not np.array_equal(main(grid), combo_out):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
