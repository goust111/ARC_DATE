+# combo_spec: D6/2+D12/3
+# Name: 按距离排序处理+绕行N条后终止
+
+import heapq
+import itertools
+import random
+from collections import deque
+
+import numpy as np
+
+from arc_utils import components_mask, neighbors4
+
+BG = 8
+BLUE = 1
+RED = 2
+GREEN = 3
+
+_DIRS_URDL = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+
+# --- Tunable parameters (generator) ---
+ROWS_LO, ROWS_HI = 17, 29
