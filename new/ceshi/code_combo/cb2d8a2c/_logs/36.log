+    assert goal_state is not None, "a valid path to the selected stopping line must exist"
+
+    out = g.copy()
+    path: list[tuple[int, int]] = []
+    st = goal_state
+    while True:
+        r, c, _ = st
+        path.append((r, c))
+        if (r, c) == (sr, sc):
+            break
+        st = prev[st]
+    path.reverse()
+    for r, c in path:
+        if out[r, c] == BG:
+            out[r, c] = GREEN
+    out[out == BLUE] = RED
+
+    if return_debug:
+        debug = {
+            "n_value": decoded_n,
+            "bar_count": len(bars),
+            "selected_ids": tuple(int(bar["id"]) for bar in selected),
+            "ordered_ids": tuple(int(bar["id"]) for bar in ordered),
+            "goal_main": int(goal_main),
+            "path_len": len(path),
+        }
+        return out, debug
+    return out
+
