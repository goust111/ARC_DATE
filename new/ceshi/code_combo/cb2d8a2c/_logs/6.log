+def _combo_observable(inp: np.ndarray, combo_out: np.ndarray) -> bool:
+    combo_path = _path_mask(combo_out)
+
+    try:
+        manhattan_out = _solve_grid(inp, radius_from_red=True, chebyshev_metric=False)
+    except AssertionError:
