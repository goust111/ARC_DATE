   204	def _random_composition(total: int, parts: int) -> list[int]:
   205	    if parts == 1:
   206	        return [total]
   207	    cuts = sorted(random.sample(range(total + parts - 1), parts - 1))
   208	    out = []
   209	    prev = -1
   210	    for cut in cuts + [total + parts - 1]:
   211	        out.append(cut - prev - 1)
   212	        prev = cut
   213	    return out
