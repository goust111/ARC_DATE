+    if edge == "bottom":
+        return bool(np.any(out[0, :] == GREEN))
+    if edge == "left":
+        return bool(np.any(out[:, -1] == GREEN))
+    return bool(np.any(out[:, 0] == GREEN))
+
+
+def _variant_metrics(inp: np.ndarray, out: np.ndarray, details: dict[str, object] | None = None) -> dict[str, object]:
