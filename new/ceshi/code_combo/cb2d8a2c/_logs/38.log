+
+def _length_bounds(cross_size: int, blue_count: int, detour: bool) -> tuple[int, int] | None:
+    lo = max(BAR_LEN_MIN, 2 * blue_count + 1, (BAR_CROSS_PCT_LO * cross_size + 99) // 100)
