+        bounds = _length_bounds(cross_size, blue_count, detour)
+        if bounds is None:
+            return None
+        length = random.randint(*bounds)
+        lengths.append(length)
+        placed_rows.append(_paint_bar(grid, row, side, length, blue_count, detour))
