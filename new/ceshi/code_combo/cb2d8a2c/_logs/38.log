+
+def _shortest_path(
+    blocked: np.ndarray,
+    start: tuple[int, int],
+    init_dir: int,
+    goal_kind: str,
+    goal_val: int,
+) -> list[tuple[int, int]]:
+    h, w = blocked.shape
+    sr, sc = start
+    inf = (10**9, 10**9)
