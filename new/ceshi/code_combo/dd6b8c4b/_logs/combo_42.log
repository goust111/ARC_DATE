+    for r, c in chosen:
+        expected[r, c] = FLOOR_COLOR
+    for r, c in dest_cells[:k]:
+        expected[r, c] = MAROON
+
+    if not np.array_equal(new_out, expected):
+        return None
+
+    return inp
