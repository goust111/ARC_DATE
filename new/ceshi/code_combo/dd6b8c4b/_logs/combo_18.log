+GRID_H, GRID_W = 11, 11
+CENTER_R, CENTER_C = 5, 5
+FLOOR_COLOR, WALL_COLOR = 7, 6
+DEST_COLOR, RED_CENTER = 3, 2
+MAROON = 9
+DEST_SIDE = 3
+PATH_LIMIT = 3
+GEN_RETRIES = 300
+DISTRACTOR_RANGE = (1, 4)
+
+
+# Canonical west-facing chamber.
+CANONICAL_BOX = {(dr, dc) for dr in range(-3, 3) for dc in range(-5, -1)}
+CANONICAL_FLOOR = {
+    (0, -2),
+    (-1, -2),
+    (-2, -2),
+    (-2, -3),
+    (-2, -4),
+    (-1, -4),
+    (-1, -5),
+}
