+    dist = np.full((h, w), inf, dtype=int)
+    q = deque(starts)
+    for r, c in starts:
+        dist[r, c] = 0
+
+    while q:
+        r, c = q.popleft()
+        d = int(dist[r, c])
+        for rr, cc in move_neighbor_fn(r, c):
+            if 0 <= rr < h and 0 <= cc < w and int(grid[rr, cc]) in passable and dist[rr, cc] == inf:
+                dist[rr, cc] = d + 1
+                q.append((rr, cc))
+    return dist
+
