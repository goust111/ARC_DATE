+# combo_spec: D3/1+D4/1
+# Name: 空间位置排序+列优先填充
+
+import random
+from collections import deque
+from pathlib import Path
+import sys
+
+import numpy as np
+
+try:
+    from arc_utils import neighbors4
+except ImportError:
+    sys.path.append(str(Path(__file__).resolve().parents[4] / "solvers"))
