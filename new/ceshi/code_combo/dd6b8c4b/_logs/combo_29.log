+FILL_K_RANGE = (5, 7)
+NEAR_LEFTOVER_RANGE = (1, 3)
+DISTRACTOR_MAX = 8
+TOTAL_MAROON_RANGE = (6, 16)
+MIN_REACHABLE = 10
+GEN_RETRIES = 500
+
+
+def _dest_cells() -> list[tuple[int, int]]:
