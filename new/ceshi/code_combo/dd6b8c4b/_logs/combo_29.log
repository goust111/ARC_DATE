+    unreachable_floor = list(all_floor - reachable_floor - set(source_cells))
+
+    base_total = len(source_cells)
+    max_distractors = min(DISTRACTOR_MAX, len(unreachable_floor), TOTAL_MAROON_RANGE[1] - base_total)
