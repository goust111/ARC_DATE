    dest_cells = _dest_cells()
    fill_order = _reverse_row_major_fill_order(dest_cells)
    dest_set = set(dest_cells)

    grid = np.full((GRID_H, GRID_W), FLOOR_COLOR, dtype=int)
    for r, c in dest_cells:
        grid[r, c] = DEST_COLOR
