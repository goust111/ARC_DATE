+        if metrics["fill_gap"] == 0:
+            return None
+        if metrics["center_saved"] == 0:
+            return None
+        if metrics["combo_vs_original"] == 0:
+            return None
+        return inp
+    except Exception:
+        return None
+
+
+def generate_input() -> np.ndarray:
