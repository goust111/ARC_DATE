+    layers = sorted(by_distance)
+    if len(layers) < 2:
+        return None
+
+    candidates = []
+    for idx in range(len(layers) - 1):
+        near_pool = [cell for d in layers[: idx + 1] for cell in by_distance[d]]
+        far_pool = [cell for d in layers[idx + 1 :] for cell in by_distance[d]]
