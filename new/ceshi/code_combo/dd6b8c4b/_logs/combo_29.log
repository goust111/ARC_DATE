    dest_cells = sorted(dest_set)
    dist, starts = _distance_map(grid, dest_cells, dest_set, {FLOOR_COLOR})
    if not starts:
        return set(), dist
    reachable = {(r, c) for r in range(GRID_H) for c in range(GRID_W) if dist[r, c] < 10**9}
    return reachable, dist


