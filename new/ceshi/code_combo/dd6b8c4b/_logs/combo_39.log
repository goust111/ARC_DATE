+    if metrics["moved_to_inner"] < 1 or metrics["moved_to_outer"] < 1:
+        return None
+    if metrics["moved_to_wide"] < 1:
+        return None
+    if metrics["moved_then_reachable"] < 1 or metrics["moved_then_filled"] < 1:
+        return None
+
+    try:
+        _ = main(inp)
+    except Exception:
