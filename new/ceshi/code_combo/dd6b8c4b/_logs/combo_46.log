+def _sort_marked_maroons(marked: list[tuple[int, int, int]], center_r: int, center_c: int) -> list[tuple[int, int, int]]:
+    return sorted(marked, key=lambda item: _euclidean_key((item[1], item[2]), center_r, center_c))
