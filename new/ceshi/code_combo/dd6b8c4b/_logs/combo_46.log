+def _expected_output(inp: np.ndarray, source_cells: list[tuple[int, int]], dest_cells: list[tuple[int, int]]) -> np.ndarray:
+    ordered = sorted([(0, r, c) for r, c in source_cells], key=lambda item: _euclidean_key((item[1], item[2])))
+    out = inp.copy()
