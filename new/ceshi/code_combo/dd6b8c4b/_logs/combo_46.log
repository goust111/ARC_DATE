+def _fill_destination(grid: np.ndarray, ordered_marked: list[tuple[int, int, int]], dest_cells: list[tuple[int, int]]) -> np.ndarray:
+    out = grid.copy()
+    k = min(len(dest_cells), len(ordered_marked))
