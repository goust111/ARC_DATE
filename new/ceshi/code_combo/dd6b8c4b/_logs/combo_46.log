+        else:
+            cc = 2 if side == "west" else GRID_W - 3
+            gap_row = random.randint(2, GRID_H - 3)
+            for rr in range(1, GRID_H - 1):
+                if rr != gap_row:
+                    wall_cells.add((rr, cc))
+
