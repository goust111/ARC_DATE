+
+    gap_count = random.randint(*RING_GAP_RANGE)
+    gap_cells = set(random.sample(ring, gap_count))
+    wall_ring = [rc for rc in ring if rc not in gap_cells]
+    wall_cells = set(wall_ring)
+    style = random.choice(WALL_STYLES)
