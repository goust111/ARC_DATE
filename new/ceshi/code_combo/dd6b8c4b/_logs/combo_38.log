+    dist = np.full((GRID_H, GRID_W), inf, dtype=int)
+    queue = deque()
+    for r, c in dest_set:
+        for nr, nc in neighbors4(r, c):
+            if 0 <= nr < GRID_H and 0 <= nc < GRID_W and (nr, nc) not in dest_set:
+                if int(grid[nr, nc]) in passable and dist[nr, nc] == inf:
+                    dist[nr, nc] = 0
+                    queue.append((nr, nc))
+    while queue:
+        r, c = queue.popleft()
+        for nr, nc in neighbors4(r, c):
