+    source_cells = None
+    gap = 0
+    for _ in range(SUBSET_RETRIES):
+        picked, gap = _pick_source_cells(grid)
+        if picked is not None:
+            source_cells = picked
+            break
+    if source_cells is None or len(source_cells) <= 9 or gap == 0:
+        return None
