+    reachable = _center_reachable(grid)
+    reachable_floor = {
+        (r, c)
+        for r, c in reachable
+        if (r, c) not in dest_set and int(grid[r, c]) == FLOOR_COLOR
+    }
+    if len(reachable_floor) < MIN_REACHABLE:
+        return None
