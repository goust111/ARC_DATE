+
+def _top9_sets(grid: np.ndarray) -> tuple[set[tuple[int, int]], set[tuple[int, int]], int]:
+    dest_set = set(_dest_cells())
+    reachable = _center_reachable(grid)
+    reachable_floor = sorted(
