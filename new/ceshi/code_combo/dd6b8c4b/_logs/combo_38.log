+    for r, c in wall_cells:
+        grid[r, c] = WALL_COLOR
+
+
+def _base_grid() -> np.ndarray:
+    dest_cells = _dest_cells()
+    grid = np.full((GRID_H, GRID_W), FLOOR_COLOR, dtype=int)
+    for r, c in dest_cells:
+        grid[r, c] = DEST_COLOR
+    grid[CENTER_R, CENTER_C] = RED_CENTER
