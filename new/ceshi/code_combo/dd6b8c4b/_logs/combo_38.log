+
+def _edge_distance(r: int, c: int, edge_cells: list[tuple[int, int]]) -> int:
+    return min(abs(r - er) + abs(c - ec) for er, ec in edge_cells)
+
+
+def _reachable_maroons_sorted(grid: np.ndarray) -> list[tuple[int, int, int]]:
