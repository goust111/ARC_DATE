   107	def _bg_boundary(g: np.ndarray) -> int:
   108	    border = np.concatenate([g[0, :], g[-1, :], g[1:-1, 0], g[1:-1, -1]])
   109	    vals, cnts = np.unique(border, return_counts=True)
   110	    return int(vals[cnts.argmax()])
   111	
   112	
   113	def _bbox_area(coords: np.ndarray) -> int:
   114	    r0, c0 = coords.min(axis=0)
   115	    r1, c1 = coords.max(axis=0)
   116	    return int((r1 - r0 + 1) * (c1 - c0 + 1))
   117	
   118	
   119	def _cross(o: tuple[float, float], a: tuple[float, float], b: tuple[float, float]) -> float:
   120	    return (a[0] - o[0]) * (b[1] - o[1]) - (a[1] - o[1]) * (b[0] - o[0])
   121	
