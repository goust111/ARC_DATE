   186	def _palette_component(g: np.ndarray, bg: int) -> np.ndarray:
   187	    mask = g != bg
   188	    comps = components_mask(mask, connectivity=4)
   189	    boundary = []
   190	    h, w = g.shape
   191	    for pts in comps:
   192	        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):
   193	            boundary.append(pts)
   194	    assert len(boundary) == 1, "_palette_component expects exactly one boundary-touching component"
   195	    pal_mask = np.zeros_like(g, dtype=bool)
   196	    pal_mask[boundary[0][:, 0], boundary[0][:, 1]] = True
   197	    return pal_mask
