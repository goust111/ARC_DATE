   200	def _parse_top_t(g: np.ndarray, pal_mask: np.ndarray) -> tuple[dict[int, int], dict[int, int]]:
   201	    cols = np.where(pal_mask[0])[0]
   202	    assert cols.size >= 3
   203	    c0, c1 = int(cols.min()), int(cols.max()) + 1
   204	    assert np.all(pal_mask[0:2, c0:c1])
   205	    assert np.sum(pal_mask[0:2]) == 2 * (c1 - c0)
   206	
   207	    tail_pts = np.argwhere(pal_mask[2:, :])
   208	    assert tail_pts.size > 0
   209	    tail_pts[:, 0] += 2
   210	    tail_rows = sorted(set(int(r) for r, _ in tail_pts))
   211	    tail_cols = sorted(set(int(c) for _, c in tail_pts))
   212	    assert tail_rows == list(range(2, tail_rows[-1] + 1))
   213	    assert len(tail_cols) == 2 and tail_cols[1] == tail_cols[0] + 1
   214	    for r in tail_rows:
   215	        assert pal_mask[r, tail_cols[0]] and pal_mask[r, tail_cols[1]]
   216	    expected = np.zeros_like(pal_mask)
   217	    expected[0:2, c0:c1] = True
   218	    expected[2 : tail_rows[-1] + 1, tail_cols[0] : tail_cols[1] + 1] = True
   219	    assert np.array_equal(expected, pal_mask)
   220	
   221	    small = {int(g[0, c]): int(g[1, c]) for c in range(c0, c1)}
   222	    large = {int(g[r, tail_cols[0]]): int(g[r, tail_cols[1]]) for r in tail_rows}
   223	    return small, large
   224	
