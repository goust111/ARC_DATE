   123	def _convex_hull(points: list[tuple[float, float]]) -> list[tuple[float, float]]:
   124	    pts = sorted(set(points))
   125	    if len(pts) <= 1:
   126	        return pts
   127	
   128	    lower: list[tuple[float, float]] = []
   129	    for p in pts:
   130	        while len(lower) >= 2 and _cross(lower[-2], lower[-1], p) <= 0:
   131	            lower.pop()
   132	        lower.append(p)
   133	
   134	    upper: list[tuple[float, float]] = []
   135	    for p in reversed(pts):
   136	        while len(upper) >= 2 and _cross(upper[-2], upper[-1], p) <= 0:
   137	            upper.pop()
   138	        upper.append(p)
   139	
   140	    return lower[:-1] + upper[:-1]
   141	
   142	
   143	def _inside_convex_polygon(p: tuple[float, float], poly: list[tuple[float, float]]) -> bool:
   144	    if len(poly) < 3:
   145	        return False
   146	    sign = 0
   147	    for i, a in enumerate(poly):
   148	        b = poly[(i + 1) % len(poly)]
   149	        cp = _cross(a, b, p)
   150	        if abs(cp) < 1e-9:
   151	            continue
   152	        cur = 1 if cp > 0 else -1
   153	        if sign == 0:
   154	            sign = cur
   155	        elif cur != sign:
   156	            return False
   157	    return True
