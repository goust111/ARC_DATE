+            if any(r == 0 or c == 0 or r == mask.shape[0] - 1 or c == mask.shape[1] - 1 for r, c in pts):
+                continue
+            hole_fill[pts[:, 0], pts[:, 1]] = True
+        convex_gain += int(np.sum(local_fill & (~hole_fill)))
+    if convex_gain <= 0:
+        return None
+
+    return inp
+
+
+def generate_input() -> np.ndarray:
