   226	def _parse_bottom_t(g: np.ndarray, pal_mask: np.ndarray) -> tuple[dict[int, int], dict[int, int]]:
   227	    h = g.shape[0]
   228	    cols = np.where(pal_mask[h - 1])[0]
   229	    assert cols.size >= 3
   230	    c0, c1 = int(cols.min()), int(cols.max()) + 1
   231	    assert np.all(pal_mask[h - 2 : h, c0:c1])
   232	    assert np.sum(pal_mask[h - 2 : h]) == 2 * (c1 - c0)
   233	
   234	    tail_pts = np.argwhere(pal_mask[: h - 2, :])
   235	    assert tail_pts.size > 0
   236	    tail_rows = sorted(set(int(r) for r, _ in tail_pts))
   237	    tail_cols = sorted(set(int(c) for _, c in tail_pts))
   238	    assert tail_rows == list(range(tail_rows[0], h - 2))
   239	    assert len(tail_cols) == 2 and tail_cols[1] == tail_cols[0] + 1
   240	    for r in tail_rows:
   241	        assert pal_mask[r, tail_cols[0]] and pal_mask[r, tail_cols[1]]
   242	    expected = np.zeros_like(pal_mask)
   243	    expected[h - 2 : h, c0:c1] = True
   244	    expected[tail_rows[0] : h - 2, tail_cols[0] : tail_cols[1] + 1] = True
   245	    assert np.array_equal(expected, pal_mask)
   246	
   247	    small = {int(g[h - 1, c]): int(g[h - 2, c]) for c in range(c0, c1)}
   248	    large = {int(g[r, tail_cols[0]]): int(g[r, tail_cols[1]]) for r in tail_rows}
   249	    return small, large
