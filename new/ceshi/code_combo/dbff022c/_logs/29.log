   160	def _convex_fill_mask_from_coords(coords: np.ndarray, shape: tuple[int, int]) -> np.ndarray:
   161	    pts = [(float(c), float(r)) for r, c in coords.tolist()]
   162	    hull = _convex_hull(pts)
   163	    out = np.zeros(shape, dtype=bool)
   164	    if len(hull) < 3:
   165	        return out
   166	
   167	    r0, c0 = coords.min(axis=0)
   168	    r1, c1 = coords.max(axis=0)
   169	    sprite_mask = np.zeros(shape, dtype=bool)
   170	    sprite_mask[coords[:, 0], coords[:, 1]] = True
   171	
   172	    for r in range(int(r0), int(r1) + 1):
   173	        for c in range(int(c0), int(c1) + 1):
   174	            if sprite_mask[r, c]:
   175	                continue
   176	            if _inside_convex_polygon((float(c), float(r)), hull):
   177	                out[r, c] = True
   178	    return out
   179	
