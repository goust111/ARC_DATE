+    candidates: list[tuple[int, int, int, str, np.ndarray]] = []
+    for start in range(limit):
+        if side == "top":
+            sub = g[0:5, start : start + 5]
+        elif side == "bottom":
+            sub = g[h - 5 : h, start : start + 5]
+        elif side == "left":
+            sub = g[start : start + 5, 0:5]
+        else:
+            sub = g[start : start + 5, w - 5 : w]
+
