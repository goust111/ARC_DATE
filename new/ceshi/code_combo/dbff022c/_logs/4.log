+    infos = []
+    for i, mask in enumerate(shapes):
+        if i < len(filled_keys):
+            border = filled_keys[i]
+            fill, mode = mapping[border]
+        else:
+            border, fill, mode = distractor_color, None, None
+        infos.append((mask, border, fill, mode))
