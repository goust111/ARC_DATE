+_PALETTE_N = 3
+_SMALL_SPECS = [(3, 3), (3, 4), (4, 3)]
+_LARGE_SPECS = [(4, 5), (5, 4)]
+_ROLE_PATTERNS = [
+    ("large", "small", "large"),
+    ("small", "large", "small"),
+]
+_P_CORNER_NOTCH = 0.35
+_MAX_RETRIES = 500
