+) -> dict[int, int]:
+    """Return border_color -> fill_color under the fused cyclic rule."""
+    sorted_areas = sorted(area_by_rank)
+    area_rank = {area: idx for idx, area in enumerate(sorted_areas)}
+    mapping: dict[int, int] = {}
