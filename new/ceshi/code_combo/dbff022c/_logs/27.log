+            return None
+        shapes.append(mask)
+
+    all_colors = rng.sample(list(range(1, 10)), total_sprites + 1)
+    sprite_colors = all_colors[:total_sprites]
+    anchor_color = int(all_colors[-1])
+
+    grid = np.full((H, W), bg, dtype=int)
