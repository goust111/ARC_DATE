+    # Optional D: farther than C, with no extra special condition beyond preserving order.
+    if total_sprites == 4:
+        mask_d, color_d = sprite_specs[3]
+        holes_d = _get_enclosed_holes(mask_d)
+        pos_d = _find_valid_positions(H, W, occ, mask_d, holes_d)
+        if not pos_d:
+            return None
+        dist_c = _anchor_distance(sprite_c, anchor)
+        ranked_d = []
+        for r0, c0 in pos_d:
+            cand = _candidate_sprite(mask_d, r0, c0, int(color_d), holes_d)
+            dd = _anchor_distance(cand, anchor)
+            if dd <= dist_c + 1:
+                continue
+            ranked_d.append((dd, _coords_distance(sprite_c["coords"], cand["coords"]), rng.random(), r0, c0))
+        if not ranked_d:
+            return None
+        ranked_d.sort()
+        _, _, _, rD, cD = ranked_d[min(len(ranked_d) - 1, rng.randint(0, max(0, len(ranked_d) // 2)))]
+        sprite_d = _candidate_sprite(mask_d, rD, cD, int(color_d), holes_d)
+        _place_sprite(grid, occ, mask_d, int(color_d), rD, cD)
+        placed.append(sprite_d)
