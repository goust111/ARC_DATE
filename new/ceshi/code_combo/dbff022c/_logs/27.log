+        ranked_d = []
+        for r0, c0 in pos_d:
+            cand = _candidate_sprite(mask_d, r0, c0, int(color_d), holes_d)
+            dd = _anchor_distance(cand, anchor)
+            if dd <= dist_c + 1:
