+
+
+def _global_holes(r0: int, c0: int, holes: list[np.ndarray]) -> list[np.ndarray]:
+    return [np.asarray([(r0 + int(r), c0 + int(c)) for r, c in pts], dtype=int) for pts in holes]
+
+
+def _anchor_cell(H: int, W: int, corner: str) -> tuple[int, int]:
+    if corner == "tl":
