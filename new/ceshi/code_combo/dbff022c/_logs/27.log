+        ranked_c.append((dbc, dc, rng.random(), r0, c0))
+    if not ranked_c:
+        return None
+    ranked_c.sort()
+    _, _, _, rC, cC = ranked_c[min(len(ranked_c) - 1, rng.randint(0, max(0, len(ranked_c) // 3)))]
+    sprite_c = _candidate_sprite(mask_c, rC, cC, int(color_c), holes_c)
+    _place_sprite(grid, occ, mask_c, int(color_c), rC, cC)
+    placed.append(sprite_c)
+
+    # Optional D: farther than C, with no extra special condition beyond preserving order.
+    if total_sprites == 4:
+        mask_d, color_d = sprite_specs[3]
+        holes_d = _get_enclosed_holes(mask_d)
+        pos_d = _find_valid_positions(H, W, occ, mask_d, holes_d)
+        if not pos_d:
+            return None
