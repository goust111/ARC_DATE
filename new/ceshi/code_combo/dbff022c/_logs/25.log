import importlib.util, numpy as np
from collections import Counter

spec = importlib.util.spec_from_file_location('variant', '/home/lixinyu/snap/new/ceshi/code_combo/dbff022c/25/code.py')
mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)

core_counts = []
open_counts = []
crop_deltas = []
full_fill_diffs = []

for _ in range(50):
    inp = mod.generate_input()
    out = mod.main(inp)
    solved, pal_mask, mapping, bg = mod._solve_full(inp)

    bg_mask = (inp == bg) & (~pal_mask)
    bg_comps = mod.components_mask(bg_mask, connectivity=4)
    external = np.zeros_like(bg_mask, dtype=bool)
    fillable_core = 0
    full_fill = inp.copy()
    for pts in bg_comps:
        touches = any(r == 0 or c == 0 or r == inp.shape[0] - 1 or c == inp.shape[1] - 1 for r, c in pts)
        if touches:
            for r, c in pts:
                external[int(r), int(c)] = True
            continue
        border = mod._dominant_mapped_border(inp, pts, bg, mapping, pal_mask)
        if border is None:
            continue
        ring, core = mod._component_ring_and_core(pts)
        fillable_core += len(core)
        fill = mapping[border]
        for r, c in pts:
            full_fill[int(r), int(c)] = fill
    core_counts.append(fillable_core)

    sprite_comps = mod.components_mask((inp "'!= bg) & (~pal_mask), connectivity=4)
    mapped_open = 0
    for pts in sprite_comps:
        r0 = int(np.min(pts[:, 0]))
        r1 = int(np.max(pts[:, 0]))
        c0 = int(np.min(pts[:, 1]))
        c1 = int(np.max(pts[:, 1]))
        color = int(inp[int(pts[0, 0]), int(pts[0, 1])])
        if color not in mapping:
            continue
        has_external_inside = False
        for r in range(r0, r1 + 1):
            for c in range(c0, c1 + 1):
                if external[r, c]:
                    has_external_inside = True
                    break
            if has_external_inside:
                break
        if has_external_inside:
            mapped_open += 1
    open_counts.append(mapped_open)

    crop_deltas.append((inp.shape[0] - out.shape[0], inp.shape[1] - out.shape[1]))
    full_fill_crop = mod._tight_crop_sprites(full_fill, pal_mask, bg)
    full_fill_diffs.append(int(np.sum(full_fill_crop != out)))

print('"'core_counts', Counter(core_counts))
print('mapped_open_counts', Counter(open_counts))
print('crop_deltas', Counter(crop_deltas))
print('full_fill_diff_cells', Counter(full_fill_diffs))
print('mins', {
    'min_core': min(core_counts),
    'min_open': min(open_counts),
    'min_row_crop': min(x for x, _ in crop_deltas),
    'min_col_crop': min(y for _, y in crop_deltas),
    'min_full_fill_diff': min(full_fill_diffs),
})
