+
+
+def _ring_cells_of_closed_sprite(sprite: np.ndarray) -> list[tuple[int, int]] | None:
+    """Return the local ring cells of all true internal holes, requiring at least one non-empty core."""
+    holes = _get_internal_holes(sprite)
