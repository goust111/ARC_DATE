+
+# --------------- generator ---------------
+
+_GRID_H_MIN, _GRID_H_MAX = 10, 13
+_GRID_W_MIN, _GRID_W_MAX = 12, 15
+_PALETTE_N_MIN, _PALETTE_N_MAX = 3, 4
