+        return None
+
+    try:
+        if np.array_equal(main(inp), expected):
+            return inp
+    except Exception:
+        return None
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(_MAX_RETRIES):
+        inp = _gen_attempt()
+        if inp is not None:
+            return inp
+    raise RuntimeError(f"Failed to generate input after {_MAX_RETRIES} attempts")

