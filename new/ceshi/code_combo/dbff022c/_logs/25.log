+                    continue
+                nonbg = int(np.sum(seg_outer != bg) + np.sum(seg_inner != bg))
+                cand = ((len(set(keys)), len(all_cols), -(r1 - r0), nonbg), "left", r0, r1)
+                if best is None or cand[0] > best[0]:
+                    best = cand
+
+    def consider_right() -> None:
+        nonlocal best
+        if w < 2:
+            return
+        outer = g[:, w - 1]
+        inner = g[:, w - 2]
