+    for r, c in pts:
+        rr = int(r)
+        cc = int(c)
+        for nr, nc in neighbors4(rr, cc):
+            if 0 <= nr < h and 0 <= nc < w and not pal_mask[nr, nc]:
+                v = int(out[nr, nc])
+                if v != bg:
