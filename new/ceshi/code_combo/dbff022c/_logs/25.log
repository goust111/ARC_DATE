+_CLOSED_SPRITE_H_MIN = 5
+_CLOSED_SPRITE_W_MIN = 5
+_OPEN_SPRITE_H_MIN = 4
+_OPEN_SPRITE_W_MIN = 4
+_SPRITE_H_MAX = 6
+_SPRITE_W_MAX = 6
