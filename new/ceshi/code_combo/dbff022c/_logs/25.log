    vals,cnts=np.unique(border, return_counts=True)
    if int(vals[cnts.argmax()]) "'!= bg:
        reasons['"'bg_border'] = reasons.get('bg_border',0)+1
        continue
    expected = mod._tight_crop_sprites(solved_full, pal_mask, bg)
    if not (expected.shape[0] < inp.shape[0] and expected.shape[1] < inp.shape[1]):
        reasons['no_crop'] = reasons.get('no_crop',0)+1
        continue
    try:
