   454	
   455	def _place_palette(grid: np.ndarray, occ: np.ndarray, pal: np.ndarray, side: str, rng: random.Random) -> None:
   456	    """Place the palette and reserve a one-cell padding band around it."""
   457	    h, w = grid.shape
   458	    pal_h, pal_w = pal.shape
   459	    if side == "top":
   460	        pr0, pc0 = 0, rng.randint(0, w - pal_w)
   461	    elif side == "bottom":
   462	        pr0, pc0 = h - pal_h, rng.randint(0, w - pal_w)
   463	    elif side == "left":
   464	        pr0, pc0 = rng.randint(0, h - pal_h), 0
   465	    else:
   466	        pr0, pc0 = rng.randint(0, h - pal_h), w - pal_w
   467	    grid[pr0 : pr0 + pal_h, pc0 : pc0 + pal_w] = pal
   468	    occ[max(0, pr0 - 1) : min(h, pr0 + pal_h + 1), max(0, pc0 - 1) : min(w, pc0 + pal_w + 1)] = True
   469	
   470	
   471	def _find_valid_positions(h: int, w: int, occ: np.ndarray, mask: np.ndarray, holes: list[np.ndarray]) -> list[tuple[int, int]]:
   472	    """Find placements that preserve separation and keep holes away from the outer boundary."""
   473	    sh, sw = mask.shape
   474	    positions: list[tuple[int, int]] = []
   475	    for r0 in range(h - sh + 1):
   476	        for c0 in range(w - sw + 1):
   477	            if occ[max(0, r0 - 1) : min(h, r0 + sh + 1), max(0, c0 - 1) : min(w, c0 + sw + 1)].any():
   478	                continue
   479	            if any(
   480	                r0 + hr == 0 or c0 + hc == 0 or r0 + hr == h - 1 or c0 + hc == w - 1
   481	                for hpts in holes
   482	                for hr, hc in hpts
   483	            ):
   484	                continue
   485	            positions.append((int(r0), int(c0)))
   486	    return positions
