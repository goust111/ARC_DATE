   395	    h, w = sprite.shape
   396	    return [
   397	        pts
   398	        for pts in components_mask(~sprite, connectivity=4)
   399	        if not any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)
   400	    ]
