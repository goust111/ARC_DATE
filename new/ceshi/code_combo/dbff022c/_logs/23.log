   488	
   489	def _hole_adj_sets(mask: np.ndarray, holes: list[np.ndarray]) -> tuple[list[set[tuple[int, int]]], set[tuple[int, int]], set[tuple[int, int]]]:
   490	    """Return per-hole touching shell cells, their union, and all shell cells."""
   491	    border_cells = {(int(r), int(c)) for r, c in np.argwhere(mask)}
   492	    per_hole: list[set[tuple[int, int]]] = []
   493	    union: set[tuple[int, int]] = set()
   494	    for hpts in holes:
   495	        cells: set[tuple[int, int]] = set()
   496	        for r, c in hpts:
   497	            for rr, cc in neighbors4(int(r), int(c)):
   498	                if (rr, cc) in border_cells:
   499	                    cells.add((rr, cc))
   500	        if cells:
   501	            per_hole.append(cells)
   502	            union |= cells
   503	    return per_hole, union, border_cells
