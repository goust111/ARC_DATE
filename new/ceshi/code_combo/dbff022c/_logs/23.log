   403	def _make_hollow_sprite(h: int, w: int, rng: random.Random) -> np.ndarray | None:
   404	    """Create a one-hole ring with occasional small irregularity."""
   405	    sprite = np.ones((h, w), dtype=bool)
   406	    sprite[1:-1, 1:-1] = False
   407	
   408	    if h >= 4 and w >= 4 and rng.random() < _P_CORNER_GAP:
   409	        corners = [(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)]
   410	        rng.shuffle(corners)
   411	        cr, cc = corners[0]
   412	        test = sprite.copy()
   413	        test[cr, cc] = False
   414	        if _get_enclosed_holes(test):
   415	            sprite = test
   416	
   417	    holes = _get_enclosed_holes(sprite)
   418	    if len(holes) != 1 or int(sprite.sum()) > _SPRITE_CELL_MAX:
   419	        return None
   420	    return sprite
