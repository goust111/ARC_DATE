   423	def _choose_colors(rng: random.Random, n_pairs: int, num_filled: int) -> tuple[list[int], list[int], list[int], int, dict[int, int]]:
   424	    """
   425	    Pick palette border keys, fill values, used matched keys, and unmatched majority color.
   426	    """
   427	    colors = list(range(1, 10))
   428	    rng.shuffle(colors)
   429	    border_keys = colors[:n_pairs]
   430	    remaining = colors[n_pairs:]
   431	    rng.shuffle(remaining)
   432	    fill_values = remaining[:n_pairs]
   433	    unmatched_major = int(remaining[n_pairs])
   434	    used_keys = rng.sample(border_keys, num_filled)
   435	    mapping = dict(zip(border_keys, fill_values))
   436	    return border_keys, fill_values, [int(x) for x in used_keys], unmatched_major, mapping
