   506	def _make_multicolor_border(mask: np.ndarray, major_color: int, accent_color: int, rng: random.Random) -> tuple[np.ndarray, list[np.ndarray]] | None:
   507	    """
   508	    Color a shell so the accent dominates around the hole but the major dominates globally.
   509	    """
   510	    holes = _get_enclosed_holes(mask)
   511	    per_hole, _inner_union, border_cells = _hole_adj_sets(mask, holes)
   512	    if len(holes) != 1 or len(per_hole) != 1:
   513	        return None
   514	
   515	    local_cells = list(per_hole[0])
   516	    accent_need = len(local_cells) // 2 + 1
   517	    if len(border_cells) - accent_need <= accent_need:
   518	        return None
   519	
   520	    rng.shuffle(local_cells)

