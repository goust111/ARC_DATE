   439	def _build_palette(side: str, border_keys: list[int], fill_values: list[int]) -> np.ndarray:
   440	    """Construct the 2xN or Nx2 palette block for the chosen edge side."""
   441	    n = len(border_keys)
   442	    if side in ("top", "bottom"):
   443	        pal = np.zeros((2, n), dtype=int)
   444	        outer, inner = (0, 1) if side == "top" else (1, 0)
   445	        pal[outer] = border_keys
   446	        pal[inner] = fill_values
   447	    else:
   448	        pal = np.zeros((n, 2), dtype=int)
   449	        outer, inner = (0, 1) if side == "left" else (1, 0)
   450	        pal[:, outer] = border_keys
   451	        pal[:, inner] = fill_values
   452	    return pal
