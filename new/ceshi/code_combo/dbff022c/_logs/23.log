+    def consider_top() -> None:
+        nonlocal best
+        if h < 2:
+            return
+        a = g[0, :]
+        b = g[1, :]
+        for c0 in range(w):
+            for c1 in range(c0 + 2, w + 1):
+                seg_a = a[c0:c1]
+                seg_b = b[c0:c1]
