    41	#     - 只用两类孔形，避免规则档位太多，保证 2-4 个样例可归纳。
    42	#     - 每个样例里共享团块固定同时出现矩形与 L，避免退化成“每个边框色只配一个填色”。
    43	#     - 第三个独立孔洞重复其中一类并换边框色，给出跨颜色重复支撑。
    44	#   implicit_assumption_audit_for_main:
    45	#     - 原 `_best_palette()` / `_palette_mapping()` 假设边缘一定有图例；融合后彻底失效，必须移除。
    46	#     - 原 `_fill_enclosed_bg_regions()` 假设可以凭邻接边框色查表；现在边框色不再决定结果，必须改为孔洞形状分类。
    47	#     - 原任务常可把每个孔洞视作各自独立精灵；共享边框后，“按非背景连通块分割对象再读对象属性”会把两洞误并到同一对象，
    48	#       所以 solver 必须直接以背景孔洞连通块为核心单位。
    49	#   placement_legality:
    50	#     - 生成器仍用 output-first：先画已填色输出，再把孔洞清回背景得到输入。
    51	#     - 共享团块内部允许共享边框，但不同团块之间仍保留至少 1 格背景，避免整图过乱。
    52	#     - 所有孔洞都必须不接触整张图外边界，这样 solver 的“边界接触=外部背景”前提仍成立。
    53	#   visual_observability:
    54	#     - 共享团块中同色边框包住两个不同孔形，输出里会出现同边框色对应两种填色，足以否定原题式颜色查表。
    55	#     - 独立重复孔型提供“相同孔形跨边框色同填色”的第二条证据，强化“看形状而不是看颜色”的规律。
    56	#   cleanliness_and_inference:
    57	#     - 不引入噪声、标记或额外装饰；视觉信息只来自边框团块结构和孔洞形状。
    58	#     - 填色只用 3 和 7 两种固定颜色，且都由肉眼可见的结构条件触发，不依赖颜色编号大小、排序或计数。
    59	#   audit_of_new_main_assumptions:
    60	#     - `_hole_fill_color()` 假设每个待处理孔洞只有“矩形”或“L”两类；生成器据此只产生这两类。
    61	#     - `_fill_enclosed_bg_regions()` 假设共享边框不会让两个孔洞的背景连成一个大孔；生成器用 1 像素实墙隔开它们。
    62	#     - `_bg_boundary()` 假设外边界仍以背景为主；生成器放置时禁止孔洞贴图外边界并保持大部分边框为空背景。
    63	
    64	import random
    65	
    66	import numpy as np
    67	
    68	from arc_utils import components_mask
    69	
    70	
    71	_RECT_FILL = 3
    72	_L_FILL = 7
    73	_BORDER_COLOR_POOL = [1, 2, 4, 5, 6, 8, 9]
    74	
    75	# Grid dimensions
    76	_GRID_H_MIN, _GRID_H_MAX = 8, 13
    77	_GRID_W_MIN, _GRID_W_MAX = 11, 15
    78	
    79	# Hole families
    80	_RECT_HOLE_SIZES = [(1, 2), (2, 1), (2, 2), (2, 3), (3, 2)]
    81	_L_HOLE_SIZES = [(2, 2), (2, 3), (3, 2)]
    82	
    83	# Generation
    84	_MAX_RETRIES = 500
    85	
    86	
    87	def _bg_boundary(g: np.ndarray) -> int:
    88	    """Most common color along the 1-cell outer border."""
    89	    border = np.concatenate([g[0, :], g[-1, :], g[1:-1, 0], g[1:-1, -1]])
    90	    vals, cnts = np.unique(border, return_counts=True)
    91	    return int(vals[cnts.argmax()])
    92	
    93	
    94	def _component_to_mask(pts: np.ndarray) -> np.ndarray:
    95	    """Crop component coordinates to their bbox and return a boolean mask."""
    96	    rs = pts[:, 0]
    97	    cs = pts[:, 1]
    98	    r0 = int(rs.min())
    99	    c0 = int(cs.min())
   100	    mask = np.zeros((int(rs.max()) - r0 + 1, int(cs.max()) - c0 + 1), dtype=bool)
   101	    mask[rs - r0, cs - c0] = True
   102	    return mask
   103	
   104	
   105	def _is_l_shape(mask: np.ndarray) -> bool:
   106	    """True iff the mask is a rotated L made from one full row plus one full column."""
   107	    h, w = mask.shape
   108	    if h < 2 or w < 2:
   109	        return False
   110	    for k in range(4):
   111	        rot = np.rot90(mask, k)
   112	        if np.all(rot[0, :]) and np.all(rot[:, 0]) and not np.any(rot[1:, 1:]):
   113	            return True
   114	    return False
   115	
   116	
   117	def _hole_fill_color(mask: np.ndarray) -> int | None:
   118	    """Map a hole shape mask to its fixed fill color."""
   119	    if mask.all():
   120	        return _RECT_FILL
   121	    if _is_l_shape(mask):
   122	        return _L_FILL
   123	    return None
   124	
   125	
   126	def _fill_enclosed_bg_regions(out: np.ndarray, bg: int) -> None:
   127	    """Fill each enclosed background component by its local geometry."""
   128	    h, w = out.shape
   129	    for pts in components_mask(out == bg, connectivity=4):
   130	        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts):
   131	            continue
   132	        fill = _hole_fill_color(_component_to_mask(pts))
   133	        if fill is None:
   134	            continue
   135	        for r, c in pts:
   136	            out[int(r), int(c)] = fill
   137	
   138	
   139	def main(grid: np.ndarray) -> np.ndarray:
   140	    """
   141	    Fill enclosed cavities from their own geometry, even when neighboring sprites share border pixels.
   142	
   143	    Input structure:
   144	    - The outer border is mostly background, and the non-background cells form hollow border structures.
   145	    - There is no palette on any grid edge; the informative signal is each enclosed bg cavity's shape.
   146	    - At least one connected border cluster contains two cavities that touch the same 1-cell wall segment, so object ownership is ambiguous.
   147	
   148	    Rule:
   149	    - Find every background component that is fully enclosed by non-background cells and does not touch the grid boundary.
   150	    - Crop each enclosed cavity to its own bbox and classify that local mask: solid rectangle cavities get one fixed fill, rotated L cavities get another.
   151	    - Fill each cavity independently, without trying to split shared-border clusters back into separate sprites.
   152	
   153	    Key insight: the correct unit is the enclosed hole itself, not the surrounding border object; shared walls make sprite segmentation unreliable, but the cavity geometry still cleanly determines the fill color.
   154	    """
   155	    g = np.asarray(grid, dtype=int)
   156	    bg = _bg_boundary(g)
   157	    out = g.copy()
   158	    _fill_enclosed_bg_regions(out, bg)
   159	    return out
   160	
   161	
   162	def _get_enclosed_holes(sprite: np.ndarray) -> list[np.ndarray]:
   163	    """Return point arrays for background components enclosed by a sprite mask."""
   164	    h, w = sprite.shape
   165	    return [
   166	        pts
   167	        for pts in components_mask(~sprite, connectivity=4)
   168	        if not any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)
   169	    ]
   170	
   171	
   172	def _make_rect_hole(rng: random.Random) -> np.ndarray:
   173	    """Return a filled rectangular hole mask."""
   174	    h, w = rng.choice(_RECT_HOLE_SIZES)
   175	    return np.ones((h, w), dtype=bool)
   176	
   177	
   178	def _make_l_hole(rng: random.Random, touch_side: str | None = None) -> np.ndarray:
   179	    """Return an L hole mask, optionally forced to touch a specific side with its long arm."""
   180	    h, w = rng.choice(_L_HOLE_SIZES)
   181	    base = np.zeros((h, w), dtype=bool)
   182	    base[0, :] = True
   183	    base[:, 0] = True
   184	
   185	    if touch_side is None:
   186	        return np.rot90(base, rng.randint(0, 3)).copy()
   187	    if touch_side == "left":
   188	        return np.flipud(base).copy() if rng.random() < 0.5 else base.copy()
   189	    if touch_side == "right":
   190	        right = np.fliplr(base)
   191	        return np.flipud(right).copy() if rng.random() < 0.5 else right.copy()
   192	    if touch_side == "top":
   193	        return np.fliplr(base).copy() if rng.random() < 0.5 else base.copy()
   194	    if touch_side == "bottom":
   195	        bottom = np.flipud(base)
   196	        return np.fliplr(bottom).copy() if rng.random() < 0.5 else bottom.copy()
   197	    raise ValueError(f"Unknown touch side: {touch_side}")
   198	
   199	
   200	def _make_hole(kind: str, rng: random.Random, touch_side: str | None = None) -> np.ndarray:
   201	    """Return a hole mask of the requested family."""
   202	    if kind == "rect":
   203	        return _make_rect_hole(rng)
   204	    if kind == "L":
   205	        return _make_l_hole(rng, touch_side=touch_side)
   206	    raise ValueError(f"Unknown hole kind: {kind}")
   207	
   208	
   209	def _sprite_from_hole(hole: np.ndarray) -> np.ndarray:
   210	    """Build a hollow border mask whose only cavity is the given hole."""
   211	    h, w = hole.shape
   212	    sprite = np.ones((h + 2, w + 2), dtype=bool)
   213	    sprite[1 : h + 1, 1 : w + 1][hole] = False
   214	    return sprite
   215	
   216	
   217	def _compose_shared_pair(hole_a: np.ndarray, hole_b: np.ndarray, horizontal: bool) -> np.ndarray:
   218	    """Combine two hollow sprites so they share one wall column or row."""
   219	    sprite_a = _sprite_from_hole(hole_a)
   220	    sprite_b = _sprite_from_hole(hole_b)
   221	    ha, wa = sprite_a.shape
   222	    hb, wb = sprite_b.shape
   223	
   224	    if horizontal:
   225	        out_h = max(ha, hb)
   226	        out_w = wa + wb - 1
   227	        combo = np.zeros((out_h, out_w), dtype=bool)
   228	        combo[0:ha, 0:wa] |= sprite_a
   229	        combo[0:hb, wa - 1 : wa - 1 + wb] |= sprite_b
   230	    else:
   231	        out_h = ha + hb - 1
   232	        out_w = max(wa, wb)
   233	        combo = np.zeros((out_h, out_w), dtype=bool)
   234	        combo[0:ha, 0:wa] |= sprite_a
   235	        combo[ha - 1 : ha - 1 + hb, 0:wb] |= sprite_b
   236	
   237	    return combo
   238	
   239	
   240	def _find_valid_positions(
   241	    H: int, W: int, occ: np.ndarray, mask: np.ndarray, holes: list[np.ndarray]
   242	) -> list[tuple[int, int]]:
   243	    """Find placements with 1-cell separation from other objects and internal holes away from the outer frame."""
   244	    sh, sw = mask.shape
   245	    positions: list[tuple[int, int]] = []
   246	    for r0 in range(H - sh + 1):
   247	        for c0 in range(W - sw + 1):
   248	            if occ[max(0, r0 - 1) : min(H, r0 + sh + 1), max(0, c0 - 1) : min(W, c0 + sw + 1)].any():
   249	                continue
   250	            if any(
   251	                r0 + hr == 0 or c0 + hc == 0 or r0 + hr == H - 1 or c0 + hc == W - 1
   252	                for hpts in holes
   253	                for hr, hc in hpts
   254	            ):
   255	                continue
   256	            positions.append((r0, c0))
   257	    return positions
   258	
   259	
   260	def _paint_object(
   261	    grid: np.ndarray, r0: int, c0: int, mask: np.ndarray, border_color: int, holes: list[np.ndarray]
   262	) -> list[tuple[np.ndarray, int]]:
   263	    """Render one border object and return hole point-arrays with their fill colors."""
   264	    grid[r0 : r0 + mask.shape[0], c0 : c0 + mask.shape[1]][mask] = border_color
   265	    painted: list[tuple[np.ndarray, int]] = []
   266	    for hpts in holes:
   267	        fill = _hole_fill_color(_component_to_mask(hpts))
   268	        if fill is None:
   269	            raise ValueError("Unexpected hole shape in generator")
   270	        for hr, hc in hpts:
   271	            grid[r0 + int(hr), c0 + int(hc)] = fill
   272	        painted.append((hpts, fill))
   273	    return painted
   274	
   275	
   276	def _gen_attempt() -> np.ndarray | None:
   277	    rng = random.Random()
   278	    bg = 0
   279	
   280	    H = rng.randint(_GRID_H_MIN, _GRID_H_MAX)
   281	    W = rng.randint(_GRID_W_MIN, _GRID_W_MAX)
   282	
   283	    shared_color, solo_color = rng.sample(_BORDER_COLOR_POOL, 2)
   284	    repeated_kind = rng.choice(["rect", "L"])
   285	
   286	    horizontal = rng.random() < 0.5
   287	    if horizontal:
   288	        if rng.random() < 0.5:
   289	            shared_hole_a = _make_hole("rect", rng)
   290	            shared_hole_b = _make_hole("L", rng, touch_side="left")
   291	        else:
   292	            shared_hole_a = _make_hole("L", rng, touch_side="right")
   293	            shared_hole_b = _make_hole("rect", rng)
   294	    else:
   295	        if rng.random() < 0.5:
   296	            shared_hole_a = _make_hole("rect", rng)
   297	            shared_hole_b = _make_hole("L", rng, touch_side="top")
   298	        else:
   299	            shared_hole_a = _make_hole("L", rng, touch_side="bottom")
   300	            shared_hole_b = _make_hole("rect", rng)
   301	    shared_mask = _compose_shared_pair(shared_hole_a, shared_hole_b, horizontal=horizontal)
   302	    shared_holes = _get_enclosed_holes(shared_mask)
   303	    if len(shared_holes) != 2:
   304	        return None
   305	    shared_fills = {_hole_fill_color(_component_to_mask(hpts)) for hpts in shared_holes}
   306	    if shared_fills != {_RECT_FILL, _L_FILL}:
   307	        return None
   308	
   309	    solo_mask = _sprite_from_hole(_make_hole(repeated_kind, rng))
   310	    solo_holes = _get_enclosed_holes(solo_mask)
   311	    if len(solo_holes) != 1:
   312	        return None
   313	    solo_fill = _hole_fill_color(_component_to_mask(solo_holes[0]))
   314	    if solo_fill is None:
   315	        return None
   316	
   317	    output = np.full((H, W), bg, dtype=int)
   318	    occ = np.zeros((H, W), dtype=bool)
   319	    placed: list[tuple[int, int, list[np.ndarray]]] = []
   320	

diff --git a/ceshi/code_combo/dbff022c/44/code.py b/ceshi/code_combo/dbff022c/44/code.py
