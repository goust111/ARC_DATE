+                seg_a = a[c0:c1]
+                seg_b = b[c0:c1]
+                da = set(map(int, np.unique(seg_a))) - {bg}
+                db = set(map(int, np.unique(seg_b))) - {bg}
+                if len(da) < 2 or len(db) < 2:
