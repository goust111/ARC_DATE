+    vals, cnts = np.unique(border, return_counts=True)
+    if int(vals[cnts.argmax()]) != bg:
+        return None
+
+    # Guard against degenerating back to either single-axis variant.
+    if not filled_sprite["middle_core"].any():
+        return None
+    if filled_inner not in mapping:
