+# Combo variant of dbff022c (index 7)
+# combo_spec: D4/1+D5/2
+# Name: 多层嵌套精灵 + 仅填充内部边缘
+
+import random
+import sys
+
+import numpy as np
+
+_ARC_UTILS_DIR = "/home/lixinyu/snap/new/solvers"
+if _ARC_UTILS_DIR not in sys.path:
+    sys.path.append(_ARC_UTILS_DIR)
