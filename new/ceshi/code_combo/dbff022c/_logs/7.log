+) -> None:
+    view = grid[r0 : r0 + sprite["body"].shape[0], c0 : c0 + sprite["body"].shape[1]]
+    view[sprite["outer"]] = int(outer_color)
+    view[sprite["inner"]] = int(inner_color)
