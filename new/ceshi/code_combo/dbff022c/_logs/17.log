import numpy as np
from collections import Counter

spec = importlib.util.spec_from_file_location('variant', '/home/lixinyu/snap/new/ceshi/code_combo/dbff022c/17/code.py')
mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)

samples = 100
same_as_solid = 0
same_shape_as_input = 0
same_as_striped_scene = 0
piece_count_dist = Counter()
axis_dist = Counter()
height_dist = Counter()
width_dist = Counter()

for _ in range(samples):
    inp = mod.generate_input()
    out = mod.main(inp)
    solved_scene, bg, pieces_with_pos = mod._solve_scene_and_collect(np.asarray(inp, dtype=int))
    piece_count_dist[len(pieces_with_pos)] += 1
    height_dist[out.shape[0]] += 1
    width_dist[out.shape[1]] += 1
    if out.shape == inp.shape:
        same_shape_as_input += 1
    if out.shape == solved_scene.shape and np.array_equal(out, solved_scene):
        same_as_striped_scene += 1

    mapping, pal_mask = mod._palette_mapping(np.asarray(inp, dtype=int), mod._bg_boundary(np.asarray(inp, dtype=int)))
    matched = mod._matched_hole_infos(np.asarray(inp, dtype=int), mod._bg_boundary(np.asarray(inp, dtype=int)), mapping, pal_mask)
