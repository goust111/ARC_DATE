    ```python
    import numpy as np

from arc_utils import components_mask, neighbors4
import random


def _bg_boundary(g: np.ndarray) -> int:
    """Most common color along the 1-cell outer border."""
    border = np.concatenate([g[0, :], g[-1, :], g[1:-1, 0], g[1:-1, -1]])
    vals, cnts = np.unique(border, return_counts=True)
    return int(vals[cnts.argmax()])


def _best_palette(g: np.ndarray, bg: int) -> tuple[str, int, int]:
    """
    Find the 2xN or Nx2 palette block on a grid edge.

    Returns (side, start, end) where:
      - side in {"top","bottom","left","right"}
      - for top/bottom: start/end are column indices [start,end)
      - for left/right: start/end are row indices [start,end)
    """
    h, w = g.shape
    best = None  # (score_tuple, side, start, end)

    def isolated(side: str, start: int, end: int) -> bool:
        """
        Palette cells (excluding bg) should not be 4-neigh adjacent to same-colored cells
        outside the palette region; this prevents accidentally absorbing parts of large sprites
        that touch the grid edge.
        """
        h2, w2 = g.shape
        pal = np.zeros((h2, w2), dtype=bool)
        if side == "top":
            pal[0:2, start:end] = True
        elif side == "bottom":
            pal[h2 - 2 : h2, start:end] = True
        elif side == "left":
            pal[start:end, 0:2] = True
        else:
            pal[start:end, w2 - 2 : w2] = True

        for r, c in zip(*np.where(pal), strict=False):
            r = int(r)
            c = int(c)
            v = int(g[r, c])
            if v == bg:
                continue
            for rr, cc in neighbors4(r, c):
                if 0 <= rr < h2 and 0 <= cc < w2 and not pal[rr, cc]:
                    if int(g[rr, cc]) == v:
                        return False
        return True

    def consider_top():
        nonlocal best
        if h < 2:
            return
        a = g[0, :]
        b = g[1, :]
        for c0 in range(w):
            for c1 in range(c0 + 2, w + 1):
                seg_a = a[c0:c1]
                seg_b = b[c0:c1]
                da = set(map(int, np.unique(seg_a)))
                db = set(map(int, np.unique(seg_b)))
                da.discard(bg)
                db.discard(bg)
                if len(da) < 2 or len(db) < 2:
                    continue
                d = da | db
                if len(d) < 3:
                    continue
                # Border keys should be unique (excluding bg) to form a well-defined mapping.
                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]
                if len(border_keys) == 0:
                    continue
                if len(border_keys) != len(set(border_keys)):
                    continue
                if not isolated("top", c0, c1):
                    continue
                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))
                score = (len(set(border_keys)), len(d), -(c1 - c0), nonbg)
                cand = (score, "top", c0, c1)
                if best is None or cand[0] > best[0]:
                    best = cand

    def consider_bottom():
        nonlocal best
        if h < 2:
            return
        a = g[h - 1, :]
        b = g[h - 2, :]
        for c0 in range(w):
            for c1 in range(c0 + 2, w + 1):
                seg_a = a[c0:c1]
                seg_b = b[c0:c1]
                da = set(map(int, np.unique(seg_a)))
                db = set(map(int, np.unique(seg_b)))
                da.discard(bg)
                db.discard(bg)
                if len(da) < 2 or len(db) < 2:
                    continue
                d = da | db
                if len(d) < 3:
                    continue
                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]
                if len(border_keys) == 0:
                    continue
                if len(border_keys) != len(set(border_keys)):
                    continue
                if not isolated("bottom", c0, c1):
                    continue
                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))
                score = (len(set(border_keys)), len(d), -(c1 - c0), nonbg)
                cand = (score, "bottom", c0, c1)
                if best is None or cand[0] > best[0]:
                    best = cand

    def consider_left():
        nonlocal best
        if w < 2:
            return
        a = g[:, 0]
        b = g[:, 1]
        for r0 in range(h):
            for r1 in range(r0 + 2, h + 1):
                seg_a = a[r0:r1]
                seg_b = b[r0:r1]
                da = set(map(int, np.unique(seg_a)))
                db = set(map(int, np.unique(seg_b)))
                da.discard(bg)
                db.discard(bg)
                if len(da) < 2 or len(db) < 2:
                    continue
                d = da | db
                if len(d) < 3:
                    continue
                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]
                if len(border_keys) == 0:
                    continue
                if len(border_keys) != len(set(border_keys)):
                    continue
                if not isolated("left", r0, r1):
                    continue
                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))
                score = (len(set(border_keys)), len(d), -(r1 - r0), nonbg)
                cand = (score, "left", r0, r1)
                if best is None or cand[0] > best[0]:
                    best = cand

    def consider_right():
        nonlocal best
        if w < 2:
            return
        a = g[:, w - 1]
        b = g[:, w - 2]
        for r0 in range(h):
            for r1 in range(r0 + 2, h + 1):
                seg_a = a[r0:r1]
                seg_b = b[r0:r1]
                da = set(map(int, np.unique(seg_a)))
                db = set(map(int, np.unique(seg_b)))
                da.discard(bg)
                db.discard(bg)
                if len(da) < 2 or len(db) < 2:
                    continue
                d = da | db
                if len(d) < 3:
                    continue
                border_keys = [int(x) for x in seg_a.tolist() if int(x) != bg]
                if len(border_keys) == 0:
                    continue
                if len(border_keys) != len(set(border_keys)):
                    continue
                if not isolated("right", r0, r1):
                    continue
                nonbg = int(np.sum(seg_a != bg) + np.sum(seg_b != bg))
                score = (len(set(border_keys)), len(d), -(r1 - r0), nonbg)
                cand = (score, "right", r0, r1)
                if best is None or cand[0] > best[0]:
                    best = cand

    consider_top()
    consider_bottom()
    consider_left()
    consider_right()

    assert best is not None, "_best_palette must find a valid palette region"
    _, side, start, end = best
    return side, int(start), int(end)


def _palette_mapping(g: np.ndarray, bg: int) -> tuple[dict[int, int], np.ndarray]:
    """
    Returns (mapping border->fill, palette_mask).
    """
    h, w = g.shape
    info = _best_palette(g, bg)
    side, start, end = info
    pal_mask = np.zeros((h, w), dtype=bool)
    mapping: dict[int, int] = {}

    if side == "top":
        pal_mask[0:2, start:end] = True
        border_line = g[0, start:end]
        fill_line = g[1, start:end]
    elif side == "bottom":
        pal_mask[h - 2 : h, start:end] = True
        border_line = g[h - 1, start:end]
        fill_line = g[h - 2, start:end]
    elif side == "left":
        pal_mask[start:end, 0:2] = True
        border_line = g[start:end, 0]
        fill_line = g[start:end, 1]
    else:  # right
        pal_mask[start:end, w - 2 : w] = True
        border_line = g[start:end, w - 1]
        fill_line = g[start:end, w - 2]

    for b, f in zip(border_line.tolist(), fill_line.tolist(), strict=False):
        b = int(b)
        f = int(f)
        if b == bg:
            continue
        mapping[b] = f

    return mapping, pal_mask


def _fill_enclosed_bg_regions(out: np.ndarray, bg: int, mapping: dict[int, int], pal_mask: np.ndarray) -> None:
    """
    Find background regions (excluding the palette area) that do NOT touch the grid boundary,
    and fill each region based on the most common adjacent border color (mapped via palette).
    """
    h, w = out.shape
    bg_mask = (out == bg) & (~pal_mask)
    comps = components_mask(bg_mask, connectivity=4)
    for pts in comps:
        touches_boundary = any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)
        if touches_boundary:
            continue

        adj_counts: dict[int, int] = {}
        for r, c in pts:
            for rr, cc in neighbors4(int(r), int(c)):
                if 0 <= rr < h and 0 <= cc < w:
                    if pal_mask[rr, cc]:
                        continue
                    v = int(out[rr, cc])
                    if v == bg:
                        continue
                    adj_counts[v] = adj_counts.get(v, 0) + 1
        if not adj_counts:
            continue

        # Prefer an adjacent color that exists in the mapping; pick the most frequent border.
        border = None
        best = -1
        for col, cnt in adj_counts.items():
            if col not in mapping:
                continue
            if cnt > best:
                best = cnt
                border = col
        if border is None:
            continue

        fill = int(mapping[border])
        for r, c in pts:
            out[r, c] = fill


def main(grid: np.ndarray) -> np.ndarray:
    """
    Fill hollow sprites' interiors using a color-palette legend on the grid edge.

    Input structure:
    - bg = most common color. Several hollow sprites with distinct border colors.
    - A small 2×N or N×2 palette block sits on one grid edge; one row/column lists border colors, the other lists corresponding fill colors.

    Rule:
    - Locate the palette legend on a grid edge and read it as a border→fill color mapping.
    - Find enclosed bg regions (holes) inside sprites that don't touch the grid boundary.
    - For each hole, identify the most common adjacent border color, look it up in the palette, and fill the hole with the mapped fill color.

    Key insight: The palette's edge position and orientation determine reading direction; border colors in the palette uniquely key into fill colors.
    """
    g = np.asarray(grid, dtype=int)
    bg = _bg_boundary(g)

    mapping, pal_mask = _palette_mapping(g, bg)
    assert mapping, "main: palette mapping must be non-empty"

    out = g.copy()
    _fill_enclosed_bg_regions(out, bg, mapping, pal_mask)

    return out

# --------------- generator (c) ---------------

# -- Configuration constants --------------------------------------------------
# Grid dimensions
_GRID_H_MIN, _GRID_H_MAX = 4, 13
_GRID_W_MIN, _GRID_W_MAX = 10, 15
_SMALL_H_THRESHOLD = 6        # below this, prefer left/right palette
_SMALL_H_PALETTE_FLIP = 0.7   # probability of flipping top/bottom -> left/right
_TINY_H_THRESHOLD = 5         # below this, cap sprite height at 3

# Palette
_PALETTE_N_MIN, _PALETTE_N_MAX = 2, 5

# Sprite geometry
_SPRITE_H_MAX = 7
_SPRITE_W_MAX = 6
_SPRITE_DIM_SUM_CAP = 10      # if sh + sw exceeds this, clamp sw
_SPRITE_CELL_MAX = 16
_FILLED_SPRITE_MAX = 3

# Sprite mutation probabilities
_P_HORIZ_WALL = 0.3           # add horizontal internal wall
_P_VERT_WALL = 0.3            # add vertical internal wall
_P_BORDER_REMOVAL = 0.4       # remove border cells for irregular shapes
_P_DIAMOND = 0.2              # use diamond shape for 3x3

# Generation
_MAX_RETRIES = 300
# -- End configuration --------------------------------------------------------


def _get_enclosed_holes(sprite):
    """Return list of point-arrays for bg components not touching sprite boundary."""
    h, w = sprite.shape
    return [pts for pts in components_mask(~sprite, connectivity=4)
            if not any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)]


def _make_diamond():
    """Return a 3x3 diamond-shaped boolean mask."""
    s = np.zeros((3, 3), dtype=bool)
    s[0, 1] = s[1, 0] = s[1, 2] = s[2, 1] = True
    return s


def _make_hollow_sprite(h, w, rng):
    """Create hollow sprite (h x w) with at least 1 enclosed bg hole, cell count <= _SPRITE_CELL_MAX."""
    sprite = np.ones((h, w), dtype=bool)
    if h >= 3 and w >= 3:
        sprite[1:-1, 1:-1] = False
    # Optionally add internal horizontal wall
    if h >= 5 and w >= 4 and rng.random() < _P_HORIZ_WALL:
        br = rng.randint(2, h - 2)
        n = rng.randint(1, w - 2)
        s = rng.randint(1, w - 1 - n + 1)
        sprite[br, s:s + n] = True
    # Optionally add internal vertical wall
    if h >= 4 and w >= 5 and rng.random() < _P_VERT_WALL:
        bc = rng.randint(2, w - 2)
        n = rng.randint(1, h - 2)
        s = rng.randint(1, h - 1 - n + 1)
        sprite[s:s + n, bc] = True
    # Optionally remove border cells for irregularity
    if rng.random() < _P_BORDER_REMOVAL:
        bcells = [(r, c) for r in range(h) for c in range(w)
                  if sprite[r, c] and (r in (0, h - 1) or c in (0, w - 1))]
        rng.shuffle(bcells)
        for cr, cc in bcells[:rng.randint(1, min(4, len(bcells)))]:
            test = sprite.copy()
            test[cr, cc] = False
            if _get_enclosed_holes(test):
                sprite = test
    if not _get_enclosed_holes(sprite) or int(sprite.sum()) > _SPRITE_CELL_MAX:
        return None
    return sprite


def _choose_colors(rng, N, num_filled):
    """Pick palette border/fill colors, distractor color, and filled-sprite keys."""
    all_c = list(range(1, 10))
    rng.shuffle(all_c)
    border_keys = all_c[:N]
    rng.shuffle(all_c)
    fill_values = all_c[:N]
    dist_cands = [c for c in range(1, 10) if c not in border_keys]
    distractor_color = rng.choice(dist_cands)
    mapping = dict(zip(border_keys, fill_values))
    filled_keys = rng.sample(border_keys, num_filled)
    return border_keys, fill_values, distractor_color, mapping, filled_keys


def _build_palette(side, border_keys, fill_values):
    """Construct the 2xN or Nx2 palette array for the given edge side."""
    N = len(border_keys)
    if side in ('top', 'bottom'):
        pal = np.zeros((2, N), dtype=int)
        outer, inner = (0, 1) if side == 'top' else (1, 0)
        pal[outer] = border_keys
        pal[inner] = fill_values
    else:
        pal = np.zeros((N, 2), dtype=int)
        outer, inner = (0, 1) if side == 'left' else (1, 0)
        pal[:, outer] = border_keys
        pal[:, inner] = fill_values
    return pal


def _place_palette(grid, occ, pal, side, rng):
    """Place palette on the chosen edge and mark its occupancy (with 1-cell padding)."""
    H, W = grid.shape
    pal_h, pal_w = pal.shape
    if side == 'top':
        pr0, pc0 = 0, rng.randint(0, W - pal_w)
    elif side == 'bottom':
        pr0, pc0 = H - pal_h, rng.randint(0, W - pal_w)
    elif side == 'left':
        pr0, pc0 = rng.randint(0, H - pal_h), 0
    else:
        pr0, pc0 = rng.randint(0, H - pal_h), W - pal_w
    grid[pr0:pr0 + pal_h, pc0:pc0 + pal_w] = pal
    occ[max(0, pr0 - 1):min(H, pr0 + pal_h + 1),
        max(0, pc0 - 1):min(W, pc0 + pal_w + 1)] = True


def _find_valid_positions(H, W, occ, mask, holes):
    """Find all (r0, c0) where mask fits without overlap and holes don't touch grid boundary."""
    sh, sw = mask.shape
    positions = []
    for r0 in range(H - sh + 1):
        for c0 in range(W - sw + 1):
            if occ[max(0, r0 - 1):min(H, r0 + sh + 1),
                   max(0, c0 - 1):min(W, c0 + sw + 1)].any():
                continue
            if any(r0 + hr == 0 or c0 + hc == 0 or r0 + hr == H - 1 or c0 + hc == W - 1
                   for hpts in holes for hr, hc in hpts):
                continue
            positions.append((r0, c0))
    return positions


def _paint_sprite(grid, r0, c0, mask, color, fill, holes):
    """Render a sprite onto the grid: border cells in color, hole cells in fill (if given)."""
    grid[r0:r0 + mask.shape[0], c0:c0 + mask.shape[1]][mask] = color
    if fill is not None:
        for hpts in holes:
            for hr, hc in hpts:
                grid[r0 + hr, c0 + hc] = fill


def _gen_attempt():
    rng = random.Random()
    bg = 0

    # Grid size and palette side
    H = rng.randint(_GRID_H_MIN, _GRID_H_MAX)
    W = rng.randint(_GRID_W_MIN, _GRID_W_MAX)
    side = rng.choice(['top', 'bottom', 'left', 'right'])
    if H <= _SMALL_H_THRESHOLD and side in ('top', 'bottom') and rng.random() < _SMALL_H_PALETTE_FLIP:
        side = rng.choice(['left', 'right'])

    max_N = H if side in ('left', 'right') else W
    N = rng.randint(_PALETTE_N_MIN, min(_PALETTE_N_MAX, max_N))

    # Sprite dimension bounds
    max_sh = min(_SPRITE_H_MAX, H)
    max_sw = min(_SPRITE_W_MAX, W)
    if H <= _TINY_H_THRESHOLD:
        max_sh = 3

    # Sprite counts
    num_filled = rng.randint(1, min(_FILLED_SPRITE_MAX, N))
    total_sprites = num_filled + 1

    # Generate sprite shapes
    shapes = []
    for _ in range(total_sprites):
        sh = rng.randint(3, max_sh)
        sw = rng.randint(3, max_sw)
        if sh + sw > _SPRITE_DIM_SUM_CAP:
            sw = max(3, _SPRITE_DIM_SUM_CAP - sh)
        if sh == 3 and sw == 3 and rng.random() < _P_DIAMOND:
            mask = _make_diamond()
        else:
            mask = _make_hollow_sprite(sh, sw, rng)
        if mask is None:
            return None
        shapes.append(mask)

    # Colors and palette
    border_keys, fill_values, distractor_color, mapping, filled_keys = \
        _choose_colors(rng, N, num_filled)
    pal = _build_palette(side, border_keys, fill_values)

    grid = np.full((H, W), bg, dtype=int)
    occ = np.zeros((H, W), dtype=bool)
    _place_palette(grid, occ, pal, side, rng)

    # Assign colors to sprites: filled sprites use palette keys, last one is distractor
    infos = []
    for i, mask in enumerate(shapes):
        if i < num_filled:
            c, f = filled_keys[i], mapping[filled_keys[i]]
        else:
            c, f = distractor_color, None
        infos.append((mask, c, f))

    # Place sprites
    placed = []
    for mask, color, fill in infos:
        holes = _get_enclosed_holes(mask)
        positions = _find_valid_positions(H, W, occ, mask, holes)
        if not positions:
            return None
        r0, c0 = rng.choice(positions)
        _paint_sprite(grid, r0, c0, mask, color, fill, holes)
        placed.append((r0, c0, mask, fill))
        sh, sw = mask.shape
        occ[max(0, r0 - 1):min(H, r0 + sh + 1),
            max(0, c0 - 1):min(W, c0 + sw + 1)] = True

    # Derive input from output by clearing filled holes
    output = grid.copy()
    inp = grid.copy()
    for r0, c0, mask, fill in placed:
        if fill is not None:
            for hpts in _get_enclosed_holes(mask):
                for hr, hc in hpts:
                    inp[r0 + hr, c0 + hc] = bg

    # Validate bg is dominant on border
    border = np.concatenate([inp[0], inp[-1], inp[1:-1, 0], inp[1:-1, -1]])
    vals, cnts = np.unique(border, return_counts=True)
    if int(vals[cnts.argmax()]) != bg:
        return None

    # Oracle check
    try:
        if np.array_equal(main(inp), output):
            return inp
    except Exception:
        pass
    return None


def generate_input():
    for _ in range(_MAX_RETRIES):
        r = _gen_attempt()
        if r is not None:
            return r
    raise RuntimeError(f"Failed to generate input after {_MAX_RETRIES} attempts")

    ```

    ## 原始任务规格（Spec）

    以下是从原始 solver 代码和示例中提炼的完整任务规格，包含精确的数值约束和生成策略。
    Spec 本身就是原题代码生成时的参考文件，因此：
    - 在**设计分析**阶段，参考 spec 理解原始任务的完整设计细节（对象结构、空间关系、生成策略等），以此为基础思考融合变体的改动如何落实
    - 在**实现**阶段，参考 spec 中的数值约束（网格尺寸、对象数量/尺寸、颜色数等），确保融合变体在物理上可实现

    ```yaml
    spec:
  grid: 4-13 rows x 10-15 cols, bg=0
  palette:
    shape: 2xN or Nx2 block on one grid edge (top/bottom/left/right)
    entries: 2-5 pairs; outer row/col = border-key colors (all distinct, all non-bg), inner row/col = fill colors (all distinct)
    no bg cells within palette region
    isolated from all sprites (no 4-adjacent non-bg cell outside palette shares its color)
  sprites:
    count: 2-4 distinct single-color hollow shapes on bg, each separated from others and palette by >=1 bg cell
    each sprite is a connected or near-connected region of one non-bg color forming a closed or semi-closed boundary with >=1 enclosed bg hole
    bbox: 3-7 rows x 3-6 cols, cell count 8-16
    filled_sprites: 1-3 sprites whose border color appears as a palette key; their enclosed holes get filled with the mapped fill color
    distractor_sprite: exactly 1 sprite whose border color is NOT a palette key; its holes stay unfilled
    palette may also contain extra entries (border keys with no corresponding sprite): 1-3 unused entries [observed]
  transformation:
    for each enclosed bg region not touching grid boundary, find dominant adjacent border color; if in palette mapping, fill hole with mapped fill color; otherwise leave unchanged
    palette block itself is unchanged

generation_strategy:
  approach: output-first
  steps:
    1. Pick grid size (4-13 x 10-15), bg=0, palette side (top/bottom/left/right), and palette length N (2-5).
    2. Choose 2N+1 to 2N+3 distinct non-bg colors; assign N as border-keys, N as fill-values, remainder for sprites not in palette.
    3. Build palette 2xN block: outer line = border-key colors, inner line = fill colors. Place on chosen edge.
    4. Generate 2-4 hollow single-color sprites (bbox 3-7 x 3-6) with 1-2 enclosed holes each. For filled sprites, use a palette border-key color and pre-fill holes with the mapped fill color (output state). For the 1 distractor sprite, use a color NOT in palette keys and leave holes as bg.
    5. Place sprites on grid separated from each other and palette by >=1 bg cell.
    6. Save grid as output. To get input, replace all filled-hole cells back to bg.
    ```

额外要求：原始代码的 `main()` 已包含四段式说明注释/文档字符串（开头概述 + `Input structure:` + `Rule:` + `Key insight:`）。
生成的新代码里也必须在 `main()` 上方保留这一结构，并根据**融合后的新规则**与**原注释提供的信息**重新编写；可以借鉴原注释的组织方式，但**不要照抄原文**，要让内容准确反映融合后的输入结构、规则和关键洞察。


## 已有单变体参考代码

以下组成项已有单变体实现，可作为融合时的参考：

            ### 参考代码: D2/1

            文件: `/home/lixinyu/snap/new/ceshi/code/dbff022c/D2/1/code.py`

            ```python
            # Variant of dbff022c
# Dimension: D2 — 调色板图例的位置与朝向 (symbol_instructions)
# Change: 调色板为2xN或Nx2色块，位于网格边缘（上/下/左），根据所在边缘确定阅读方向：上边缘从上到下读，下边缘从下到上读，左... → 调色板为分散的颜色对而非连续色块

import random

import numpy as np

from arc_utils import components_mask, neighbors4


# ---------------------------------------------------------------------------
# Design analysis for the D2 variant
#
# design_analysis:
#   concrete_form:
#     - Each legend entry is now one isolated 2-cell domino on the boundary.
#     - Top/bottom entries are vertical and read from the edge inward.
#     - Left/right entries are horizontal and read from the edge inward.
#     - Multiple entries may appear on multiple edges, so the solver must gather
#       them before building the border->fill table.
#   behavior_trace:
#     old:
#       One contiguous 2xN or Nx2 strip could be read by zipping two aligned lines.
#     new:
#       Example: top has (4,2), right has (6,7), bottom has (9,3). There is no
#       single rectangle covering all entries, so the solver must detect isolated
#       edge dominoes one by one and merge them into a mapping.
#     difference:
#       Legend discovery changes completely; enclosed-hole filling can stay the same.
#   complexity_calibration:
#     - Keep a small legend, usually exactly 3 pairs, so the scatter is readable
#       without overcrowding the grid.
#     - Force the legend to use at least two edges so the scatter is visible and
#       the samples do not collapse back to the original single-strip reading.
#     - Large grids may include one distractor sprite; cramped grids may omit it
#       to preserve a clean, legal layout.
#   implicit_assumption_audit:
#     - Original `_best_palette()` relied on one contiguous edge block. That is no
#       longer true and must be replaced.
#     - Original `_palette_mapping()` assumed one aligned pair of rows/cols. The
#       variant instead assembles the mapping from isolated edge dominoes.
#     - `_fill_enclosed_bg_regions()` only needs a correct mapping and a legend mask,
#       so it remains valid.
#   placement_legality:
#     - Every legend domino is 4-neighbor isolated from all other non-bg cells.
#     - Sprites are kept away from the outer border, so non-bg boundary cells belong
#       only to legend pieces.
#     - Palette pieces and sprites still keep background padding for clean separation.
#   observability:
#     - At least two legend edges are used.
#     - At least two filled sprites use keys coming from different legend edges.
#     - No rule branch depends on color id ordering.
#   new_solver_assumptions:
#     - Any non-bg boundary domino with only bg outside-neighbors is a legend pair.
#     - Border colors are unique legend keys.
#     - `generate_input()` enforces both assumptions.
# ---------------------------------------------------------------------------


_EDGE_SIDES = ("top", "bottom", "left", "right")


def _bg_boundary(g: np.ndarray) -> int:
    """Most common color along the 1-cell outer border."""
    border = np.concatenate([g[0, :], g[-1, :], g[1:-1, 0], g[1:-1, -1]])
    vals, cnts = np.unique(border, return_counts=True)
    return int(vals[cnts.argmax()])


def _pair_cells(side: str, idx: int, h: int, w: int) -> tuple[tuple[int, int], tuple[int, int]]:
    """Return (border_cell, fill_cell) for one inward-reading edge pair."""
    if side == "top":
        return (0, idx), (1, idx)
    if side == "bottom":
        return (h - 1, idx), (h - 2, idx)
    if side == "left":
        return (idx, 0), (idx, 1)
    return (idx, w - 1), (idx, w - 2)


def _pair_slots(side: str, h: int, w: int) -> list[int]:
    """Candidate anchor indices, excluding literal corners."""
    if side in ("top", "bottom"):
        return list(range(1, w - 1))
    return list(range(1, h - 1))


def _rect_with_padding(cells: tuple[tuple[int, int], tuple[int, int]], h: int, w: int) -> tuple[int, int, int, int]:
    rs = [cells[0][0], cells[1][0]]
    cs = [cells[0][1], cells[1][1]]
    r0 = max(0, min(rs) - 1)
    r1 = min(h, max(rs) + 2)
    c0 = max(0, min(cs) - 1)
    c1 = min(w, max(cs) + 2)
    return r0, r1, c0, c1


def _occupy_with_padding(occ: np.ndarray, cells: tuple[tuple[int, int], tuple[int, int]]) -> None:
    h, w = occ.shape
    r0, r1, c0, c1 = _rect_with_padding(cells, h, w)
    occ[r0:r1, c0:c1] = True


def _can_place_pair(occ: np.ndarray, cells: tuple[tuple[int, int], tuple[int, int]]) -> bool:
    return all(not occ[r, c] for r, c in cells)


def _isolated_pair(g: np.ndarray, bg: int, cells: tuple[tuple[int, int], tuple[int, int]]) -> bool:
    """True iff both cells are non-bg and every outside 4-neighbor is bg."""
    h, w = g.shape
    pair = {cells[0], cells[1]}
    for r, c in cells:
        if int(g[r, c]) == bg:
            return False
        for rr, cc in neighbors4(r, c):
            if 0 <= rr < h and 0 <= cc < w and (rr, cc) not in pair:
                if int(g[rr, cc]) != bg:
                    return False
    return True


def _collect_palette_pairs(
    g: np.ndarray, bg: int
) -> tuple[dict[int, int], np.ndarray, list[tuple[str, int, int, int]]]:
    """
    Returns (mapping border->fill, palette_mask, pair_infos).

    pair_infos entries are (side, idx, border_color, fill_color).
    """
    h, w = g.shape
    pal_mask = np.zeros((h, w), dtype=bool)
    mapping: dict[int, int] = {}
    pair_infos: list[tuple[str, int, int, int]] = []
    seen: set[frozenset[tuple[int, int]]] = set()

    for side in _EDGE_SIDES:
        for idx in _pair_slots(side, h, w):
            cells = _pair_cells(side, idx, h, w)
            key = frozenset(cells)
            if key in seen:
                continue
            border_cell, fill_cell = cells
            b = int(g[border_cell])
            f = int(g[fill_cell])
            if b == bg or f == bg:
                continue
            if not _isolated_pair(g, bg, cells):
                continue
            if b in mapping:
                assert mapping[b] == f, "legend border color repeated with conflicting fill"
            mapping[b] = f
            pal_mask[border_cell] = True
            pal_mask[fill_cell] = True
            pair_infos.append((side, int(idx), b, f))
            seen.add(key)

    assert mapping, "_collect_palette_pairs must find at least one isolated edge pair"
    return mapping, pal_mask, pair_infos


def _fill_enclosed_bg_regions(out: np.ndarray, bg: int, mapping: dict[int, int], pal_mask: np.ndarray) -> None:
    """
    Find background regions (excluding the palette area) that do NOT touch the grid boundary,
    and fill each region based on the most common adjacent border color (mapped via palette).
    """
    h, w = out.shape
    bg_mask = (out == bg) & (~pal_mask)
    comps = components_mask(bg_mask, connectivity=4)
    for pts in comps:
        touches_boundary = any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)
        if touches_boundary:
            continue

        adj_counts: dict[int, int] = {}
        for r, c in pts:
            for rr, cc in neighbors4(int(r), int(c)):
                if 0 <= rr < h and 0 <= cc < w:
                    if pal_mask[rr, cc]:
                        continue
                    v = int(out[rr, cc])
                    if v == bg:
                        continue
                    adj_counts[v] = adj_counts.get(v, 0) + 1
        if not adj_counts:
            continue

        border = None
        best = -1
        for col, cnt in adj_counts.items():
            if col not in mapping:
                continue
            if cnt > best:
                best = cnt
                border = col
        if border is None:
            continue

        fill = int(mapping[border])
        for r, c in pts:
            out[r, c] = fill


def main(grid: np.ndarray) -> np.ndarray:
    """
    Fill hollow sprites' interiors by reading scattered color-pair legend pieces on the grid boundary.

    Input structure:
    - The dominant border color is bg, and several hollow single-color sprites sit away from the outer frame.
    - The border->fill legend is not one compact strip anymore: it is split into isolated 2-cell dominoes placed on one or more grid edges, each read from the edge cell toward the interior.

    Rule:
    - Detect every isolated edge domino and convert it into one border-color to fill-color mapping entry.
    - Find enclosed bg regions that are not part of the legend and do not touch the grid boundary.
    - For each such hole, identify its dominant adjacent border color and, if that color is a legend key, fill the hole with the mapped color.

    Key insight: The mapping must be assembled from multiple tiny edge-local clues first; only after collecting those scattered pairs can the usual hole-filling step be applied.
    """
    g = np.asarray(grid, dtype=int)
    bg = _bg_boundary(g)

    mapping, pal_mask, _ = _collect_palette_pairs(g, bg)
    assert mapping, "main: palette mapping must be non-empty"

    out = g.copy()
    _fill_enclosed_bg_regions(out, bg, mapping, pal_mask)

    return out


# --------------- generator (c) ---------------

# -- Configuration constants --------------------------------------------------
_GRID_H_MIN, _GRID_H_MAX = 6, 13
_GRID_W_MIN, _GRID_W_MAX = 10, 15
_TINY_H_THRESHOLD = 5

_PALETTE_N_MIN, _PALETTE_N_MAX = 2, 3
_MIN_USED_EDGES = 2

_SPRITE_H_MAX = 7
_SPRITE_W_MAX = 6
_SPRITE_DIM_SUM_CAP = 10
_SPRITE_CELL_MAX = 16

_P_HORIZ_WALL = 0.3
_P_VERT_WALL = 0.3
_P_BORDER_REMOVAL = 0.4
_P_DIAMOND = 0.2

_MAX_RETRIES = 500
# -- End configuration --------------------------------------------------------


def _get_enclosed_holes(sprite: np.ndarray) -> list[np.ndarray]:
    """Return list of point-arrays for bg components not touching sprite boundary."""
    h, w = sprite.shape
    return [
        pts
        for pts in components_mask(~sprite, connectivity=4)
        if not any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)
    ]


def _make_diamond() -> np.ndarray:
    """Return a 3x3 diamond-shaped boolean mask."""
    s = np.zeros((3, 3), dtype=bool)
    s[0, 1] = s[1, 0] = s[1, 2] = s[2, 1] = True
    return s


def _make_hollow_sprite(h: int, w: int, rng: random.Random) -> np.ndarray | None:
    """Create hollow sprite (h x w) with at least 1 enclosed bg hole, cell count <= _SPRITE_CELL_MAX."""
    sprite = np.ones((h, w), dtype=bool)
    if h >= 3 and w >= 3:
        sprite[1:-1, 1:-1] = False
    if h >= 5 and w >= 4 and rng.random() < _P_HORIZ_WALL:
        br = rng.randint(2, h - 2)
        n = rng.randint(1, w - 2)
        s = rng.randint(1, w - n - 1)
        sprite[br, s : s + n] = True
    if h >= 4 and w >= 5 and rng.random() < _P_VERT_WALL:
        bc = rng.randint(2, w - 2)
        n = rng.randint(1, h - 2)
        s = rng.randint(1, h - n - 1)
        sprite[s : s + n, bc] = True
    if rng.random() < _P_BORDER_REMOVAL:
        bcells = [
            (r, c)
            for r in range(h)
            for c in range(w)
            if sprite[r, c] and (r in (0, h - 1) or c in (0, w - 1))
        ]
        rng.shuffle(bcells)
        for cr, cc in bcells[: rng.randint(1, min(4, len(bcells)))]:
            test = sprite.copy()
            test[cr, cc] = False
            if _get_enclosed_holes(test):
                sprite = test
    if not _get_enclosed_holes(sprite) or int(sprite.sum()) > _SPRITE_CELL_MAX:
        return None
    return sprite


def _sample_shape(max_sh: int, max_sw: int, rng: random.Random) -> np.ndarray | None:
    """Retry shape sampling before failing the whole attempt."""
    for _ in range(40):
        sh = rng.randint(3, max_sh)
        sw = rng.randint(3, max_sw)
        if sh + sw > _SPRITE_DIM_SUM_CAP:
            sw = max(3, _SPRITE_DIM_SUM_CAP - sh)
        if sh == 3 and sw == 3 and rng.random() < _P_DIAMOND:
            return _make_diamond()
        mask = _make_hollow_sprite(sh, sw, rng)
        if mask is not None:
            return mask
    return None


def _choose_colors(rng: random.Random, n: int) -> tuple[list[int], list[int], int, dict[int, int]] | None:
    """Pick palette border/fill colors plus one distractor border color."""
    all_c = list(range(1, 10))
    border_keys = rng.sample(all_c, n)

    for _ in range(100):
        fill_values = rng.sample(all_c, n)
        if all(b != f for b, f in zip(border_keys, fill_values, strict=False)):
            break
    else:
        return None

    distractor_color = rng.choice([c for c in all_c if c not in border_keys])
    mapping = dict(zip(border_keys, fill_values, strict=False))
    return border_keys, fill_values, distractor_color, mapping


def _select_palette_positions(
    h: int, w: int, n: int, rng: random.Random
) -> list[tuple[str, int, tuple[tuple[int, int], tuple[int, int]]]] | None:
    """Choose n isolated edge-domino positions spanning at least two edges."""
    candidates: list[tuple[str, int, tuple[tuple[int, int], tuple[int, int]]]] = []
    for side in _EDGE_SIDES:
        for idx in _pair_slots(side, h, w):
            candidates.append((side, int(idx), _pair_cells(side, idx, h, w)))

    usable_edges = [side for side in _EDGE_SIDES if _pair_slots(side, h, w)]
    for _ in range(200):
        occ = np.zeros((h, w), dtype=bool)
        chosen: list[tuple[str, int, tuple[tuple[int, int], tuple[int, int]]]] = []
        used: set[tuple[str, int]] = set()

        edge_target = rng.randint(_MIN_USED_EDGES, min(len(usable_edges), n))
        required_edges = rng.sample(usable_edges, edge_target)

        ok = True
        for side in required_edges:
            opts = [
                cand
                for cand in candidates
                if cand[0] == side and (cand[0], cand[1]) not in used and _can_place_pair(occ, cand[2])
            ]
            if not opts:
                ok = False
                break
            cand = rng.choice(opts)
            chosen.append(cand)
            used.add((cand[0], cand[1]))
            _occupy_with_padding(occ, cand[2])
        if not ok:
            continue

        while len(chosen) < n:
            opts = [cand for cand in candidates if (cand[0], cand[1]) not in used and _can_place_pair(occ, cand[2])]
            if not opts:
                ok = False
                break
            cand = rng.choice(opts)
            chosen.append(cand)
            used.add((cand[0], cand[1]))
            _occupy_with_padding(occ, cand[2])
        if ok and len({side for side, _, _ in chosen}) >= _MIN_USED_EDGES:
            return chosen
    return None


def _choose_filled_keys(
    rng: random.Random, pair_infos: list[tuple[str, int, int, int]], num_filled: int
) -> list[int] | None:
    """Choose filled-sprite keys, ensuring at least two legend edges contribute."""
    edge_to_keys: dict[str, list[int]] = {}
    for side, _idx, border, _fill in pair_infos:
        edge_to_keys.setdefault(side, []).append(border)

    used_edges = list(edge_to_keys)
    if len(used_edges) < _MIN_USED_EDGES:
        return None

    filled: list[int] = []
    for side in rng.sample(used_edges, _MIN_USED_EDGES):
        filled.append(rng.choice(edge_to_keys[side]))

    remaining = num_filled - len(filled)
    if remaining > 0:
        others = [border for _side, _idx, border, _fill in pair_infos if border not in filled]
        filled.extend(rng.sample(others, remaining))

    rng.shuffle(filled)
    return filled


def _find_valid_positions(h: int, w: int, occ: np.ndarray, mask: np.ndarray, holes: list[np.ndarray]) -> list[tuple[int, int]]:
    """Find inset placements where mask fits without overlap and holes stay interior."""
    sh, sw = mask.shape
    positions = []
    for r0 in range(1, h - sh):
        for c0 in range(1, w - sw):
            if np.any(occ[r0 : r0 + sh, c0 : c0 + sw] & mask):
                continue
            if any(
                r0 + hr == 0 or c0 + hc == 0 or r0 + hr == h - 1 or c0 + hc == w - 1
                for hpts in holes
                for hr, hc in hpts
            ):
                continue
            positions.append((r0, c0))
    return positions


def _paint_sprite(
    grid: np.ndarray,
    r0: int,
    c0: int,
    mask: np.ndarray,
    color: int,
    fill: int | None,
    holes: list[np.ndarray],
) -> None:
    """Render a sprite onto the grid: border cells in color, hole cells in fill (if given)."""
    grid[r0 : r0 + mask.shape[0], c0 : c0 + mask.shape[1]][mask] = color
    if fill is not None:
        for hpts in holes:
            for hr, hc in hpts:
                grid[r0 + hr, c0 + hc] = fill


def _occupy_sprite(occ: np.ndarray, r0: int, c0: int, mask: np.ndarray) -> None:
    """Mark sprite cells and their 1-cell padding using the actual shape."""
    h, w = occ.shape
    for rr, cc in zip(*np.where(mask), strict=False):
        r = r0 + int(rr)
        c = c0 + int(cc)
        occ[max(0, r - 1) : min(h, r + 2), max(0, c - 1) : min(w, c + 2)] = True


def _palette_capacity(h: int, w: int) -> int:
    """Loose upper bound on isolated pair count under 1-cell same-edge gaps."""
    top_bottom = ((w - 2) + 1) // 2
    left_right = ((h - 2) + 1) // 2
    return 2 * top_bottom + 2 * left_right


def _gen_attempt() -> np.ndarray | None:
    rng = random.Random()
    bg = 0

    h = rng.randint(_GRID_H_MIN, _GRID_H_MAX)
    w = rng.randint(_GRID_W_MIN, _GRID_W_MAX)

    max_pairs = min(_PALETTE_N_MAX, _palette_capacity(h, w))
    if max_pairs < _PALETTE_N_MIN:
        return None
    n = 3 if max_pairs >= 3 else 2

    max_sh = min(5, h - 2)
    max_sw = min(5, w - 2)
    if h <= _TINY_H_THRESHOLD:
        max_sh = min(max_sh, 3)
    if max_sh < 3 or max_sw < 3:
        return None

    num_filled = 2
    has_distractor = h >= 9 and w >= 12 and rng.random() < 0.5
    total_sprites = num_filled + int(has_distractor)

    shapes = []
    for _ in range(total_sprites):
        mask = _sample_shape(max_sh, max_sw, rng)
        if mask is None:
            return None
        shapes.append(mask)

    palette_positions = _select_palette_positions(h, w, n, rng)
    if palette_positions is None:
        return None

    color_info = _choose_colors(rng, n)
    if color_info is None:
        return None
    border_keys, fill_values, distractor_color, mapping = color_info

    grid = np.full((h, w), bg, dtype=int)
    occ = np.zeros((h, w), dtype=bool)
    pair_infos: list[tuple[str, int, int, int]] = []

    rng.shuffle(palette_positions)
    for (side, idx, cells), border, fill in zip(palette_positions, border_keys, fill_values, strict=False):
        border_cell, fill_cell = cells
        grid[border_cell] = border
        grid[fill_cell] = fill
        pair_infos.append((side, idx, border, fill))
        _occupy_with_padding(occ, cells)

    filled_keys = _choose_filled_keys(rng, pair_infos, num_filled)
    if filled_keys is None:
        return None

    infos = []
    for i, mask in enumerate(shapes):
        if i < num_filled:
            c, f = filled_keys[i], mapping[filled_keys[i]]
        else:
            c, f = distractor_color, None
        infos.append((mask, c, f))

    placed = []
    for mask, color, fill in infos:
        holes = _get_enclosed_holes(mask)
        positions = _find_valid_positions(h, w, occ, mask, holes)
        if not positions:
            return None
        r0, c0 = rng.choice(positions)
        _paint_sprite(grid, r0, c0, mask, color, fill, holes)
        placed.append((r0, c0, mask, fill))
        _occupy_sprite(occ, r0, c0, mask)

    output = grid.copy()
    inp = grid.copy()
    for r0, c0, mask, fill in placed:
        if fill is not None:
            for hpts in _get_enclosed_holes(mask):
                for hr, hc in hpts:
                    inp[r0 + hr, c0 + hc] = bg

