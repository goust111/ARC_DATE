    75	def _bg_boundary(g: np.ndarray) -> int:
    76	    """Most common color along the 1-cell outer border."""
    77	    border = np.concatenate([g[0, :], g[-1, :], g[1:-1, 0], g[1:-1, -1]])
    78	    vals, cnts = np.unique(border, return_counts=True)
    79	    return int(vals[cnts.argmax()])
