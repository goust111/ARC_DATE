   341	def main(grid: np.ndarray) -> np.ndarray:
   342	    """
   343	    Refill hollow multicolor sprites by combining majority-color lookup with striped interiors.
   344	
   345	    Input structure:
   346	    - The outer boundary is mostly background, and one edge holds a compact 2xN or Nx2 palette legend.
   347	    - Hollow sprites sit away from that legend; each sprite shell may mix multiple border colors instead of staying monochrome.
   348	
   349	    Rule:
   350	    - Detect the edge palette and read it as a border-key to fill-color mapping.
   351	    - Find each enclosed background hole that is truly inside a sprite rather than connected to the outside.
   352	    - For every hole, gather the whole touching shell, choose the shell's most frequent border color as the lookup key, read the mapped fill color from the palette, and paint the hole with alternating stripes of that fill color and the background. Wider-or-square holes use vertical stripes; taller holes use horizontal stripes.
   353	
   354	    Key insight:
   355	    - The color decision and the painting pattern are controlled by different visible cues: the shell's global majority color chooses the palette entry, while the hole's own geometry chooses whether the mapped color alternates by column or by row.
   356	    """
   357	    g = np.asarray(grid, dtype=int)
   358	    bg = _bg_boundary(g)
   359	    mapping, pal_mask = _palette_mapping(g, bg)
   360	    assert mapping, "main: palette mapping must be non-empty"
   361	
   362	    out = g.copy()
   363	    _fill_enclosed_bg_regions(out, bg, mapping, pal_mask)
   364	    return out
