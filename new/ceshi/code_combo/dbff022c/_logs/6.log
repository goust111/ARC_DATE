   310	def _fill_enclosed_bg_regions(out: np.ndarray, bg: int, mapping: dict[int, int], pal_mask: np.ndarray) -> None:
   311	    """
   312	    Fill each enclosed hole by using the touching shell's majority color as the palette key,
   313	    then write alternating stripes of the mapped fill color and background.
