+    placed: list[tuple[int, int, list[np.ndarray], int | None]] = []
+    for sprite_colors, holes, fill in infos:
+        mask = sprite_colors != 0
+        positions = _find_valid_positions(h, w, occ, mask, holes)
+        if not positions:
+            return None
