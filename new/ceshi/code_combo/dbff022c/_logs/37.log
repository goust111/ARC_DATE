+    inp_box[mask] = border
+
+
+def _expected_mapping(colors: tuple[int, ...]) -> dict[int, int]:
+    ordered = sorted(int(c) for c in colors)
+    return {col: ordered[(i - 1) % len(ordered)] for i, col in enumerate(ordered)}
+
+
+def _gen_attempt() -> np.ndarray | None:
+    rng = random.Random()
+    bg = 0
