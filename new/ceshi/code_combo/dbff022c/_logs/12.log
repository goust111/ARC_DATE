   276	    bg = _bg_boundary(g)
   277	
   278	    mapping, pal_mask = _palette_mapping(g, bg)
   279	    assert mapping, "main: palette mapping must be non-empty"
   280	
   281	    out = g.copy()
   282	    _fill_enclosed_bg_regions(out, bg, mapping, pal_mask)
   283	    return out
