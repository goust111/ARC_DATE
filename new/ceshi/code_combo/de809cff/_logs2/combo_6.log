def legacy_output(inp):
    bg = Color.BLACK
    colors = mod._main_colors(inp, bg)
    clean = mod._clean_foreground(inp, colors, bg)
    centers = mod._dent_centers(inp, clean, colors, bg)
    region_mask = mod._reconstruct_regions(clean, centers)
    out = clean.copy()
    h, w = out.shape
