    ```python
    from __future__ import annotations

import numpy as np

from arc_utils import Color
import random


def _main_colors(g: np.ndarray, bg: int) -> tuple[int, int]:
    colors = [int(c) for c in np.unique(g) if int(c) != int(bg)]
    colors.sort(key=lambda c: int(np.sum(g == c)), reverse=True)
    assert len(colors) >= 2, "expected two foreground colors"
    return int(colors[0]), int(colors[1])


def _has_same_2x2(g: np.ndarray, r: int, c: int, color: int) -> bool:
    h, w = g.shape
    for dr in (-1, 0):
        for dc in (-1, 0):
            rr = int(r) + dr
            cc = int(c) + dc
            if 0 <= rr < h - 1 and 0 <= cc < w - 1:
                if bool(np.all(g[rr : rr + 2, cc : cc + 2] == int(color))):
                    return True
    return False


def _clean_foreground(g: np.ndarray, colors: tuple[int, int], bg: int) -> np.ndarray:
    """
    Remove one-cell specks/protrusions before detecting black dents.

    Two sweeps are enough for the observed corruption pattern: the first removes
    protruding wrong-color cells, the second lets their neighboring true cells
    keep the corrected local majority.
    """
    h, w = g.shape
    a, b = map(int, colors)
    cur = g.copy()

    for _ in range(2):
        nxt = cur.copy()
        for r in range(h):
            for c in range(w):
                v = int(cur[r, c])
                if v not in colors:
                    nxt[r, c] = bg
                    continue

                sub = cur[max(0, r - 1) : min(h, r + 2), max(0, c - 1) : min(w, c + 2)]
                own = int(np.sum(sub == v))
                other = b if v == a else a
                other_count = int(np.sum(sub == other))
                bg_count = int(np.sum(sub == bg))

                if _has_same_2x2(cur, r, c, v):
                    nxt[r, c] = v
                elif other_count > own and other_count >= 5:
                    nxt[r, c] = other
                elif bg_count >= 5 and own <= 4:
                    nxt[r, c] = bg
                elif own <= 2:
                    nxt[r, c] = bg
                else:
                    nxt[r, c] = v
        cur = nxt

    return cur


def _dent_centers(original: np.ndarray, clean: np.ndarray, colors: tuple[int, int], bg: int) -> list[tuple[int, int, int]]:
    h, w = original.shape
    centers: list[tuple[int, int, int]] = []
    for r, c in zip(*np.where(original == int(bg)), strict=False):
        rr = int(r)
        cc = int(c)
        sub = clean[max(0, rr - 1) : min(h, rr + 2), max(0, cc - 1) : min(w, cc + 2)]
        counts = {int(color): int(np.sum(sub == int(color))) for color in colors}
        host = max(colors, key=lambda color: counts[int(color)])
        other = colors[1] if int(host) == int(colors[0]) else colors[0]
        if counts[int(host)] >= 5 and counts[int(host)] > counts[int(other)]:
            centers.append((rr, cc, int(host)))
    return centers


def main(grid: np.ndarray) -> np.ndarray:
    """
    Turn black dents in two colored regions into marked opposite-color patches.

    Input structure:
    - Black background with two large foreground colors.
    - The large regions contain small black dents and a few one-cell color specks
      or protrusions along region boundaries.

    Rule:
    - Locally clean the two foreground regions: isolated specks become black, and
      one-cell protrusions surrounded by the other region take that region's color.
    - Each original black dent whose cleaned 3x3 neighborhood is mostly one
      foreground color becomes the center of a 3x3 patch in the opposite color.
    - The dent center itself is recolored teal (8).

    Key insight: The teal pixels mark the original black defects; the surrounding
    3x3 patch uses the other foreground color, after first removing boundary noise.
    """
    g = np.asarray(grid, dtype=int)
    bg = Color.BLACK
    colors = _main_colors(g, bg)
    clean = _clean_foreground(g, colors, bg)

    out = clean.copy()
    centers = _dent_centers(g, clean, colors, bg)
    h, w = g.shape
    for r, c, host in centers:
        other = colors[1] if int(host) == int(colors[0]) else colors[0]
        out[max(0, r - 1) : min(h, r + 2), max(0, c - 1) : min(w, c + 2)] = int(other)

    for r, c, _host in centers:
        out[r, c] = Color.TEAL

    return out

# --------------- generator (cx) ---------------

from collections import Counter as _Counter

# --- CFG: canvas & region layout ---
GRID_SIZE_MIN, GRID_SIZE_MAX = 20, 30
RECT_SIZE_FRAC_MIN, RECT_SIZE_FRAC_MAX = 0.45, 0.75  # rect side as fraction of N
RECT_MARGIN_MAX = 3                                     # corner inset range [0, RECT_MARGIN_MAX]
MIN_REGION_CELLS = 100                                  # minimum cells per fg color
COVERAGE_MIN, COVERAGE_MAX = 0.55, 0.85                 # total fg coverage bounds

# --- CFG: dent placement ---
DENT_COUNT_MIN, DENT_COUNT_MAX = 12, 22
DENT_MIN_HOST_3x3 = 5       # host cells required in 3x3 around dent center
DENT_PATCH_SEPARATION = 3   # min Chebyshev distance between dent centers
DENT_PAIR_PROB = 0.13        # probability of expanding a single-cell dent to a 2-cell pair

# --- CFG: noise ---
NOISE_COUNT_MIN, NOISE_COUNT_MAX = 7, 22
BG_NOISE_FRAC_MIN, BG_NOISE_FRAC_MAX = 0.65, 0.85  # fraction of noise that is bg specks
BG_SPECK_MIN_BG_3x3 = 6     # min black cells in 3x3 for a bg speck to stay isolated
BOUNDARY_MIN_HOST_3x3 = 6   # min host cells in 3x3 for boundary contamination

# --- CFG: generation control ---
MAX_GENERATION_ATTEMPTS = 300


def _sub3x3(grid: np.ndarray, r: int, c: int) -> np.ndarray:
    """Return the 3x3 neighborhood of (r,c), clipped to grid bounds."""
    h, w = grid.shape
    return grid[max(0, r - 1):min(h, r + 2), max(0, c - 1):min(w, c + 2)]


def _build_regions(N: int, color_a: int, color_b: int, rng: random.Random) -> np.ndarray | None:
    """Paint 2-3 overlapping rectangles (simple occlusion, painter's algorithm)."""
    n_rects = rng.choice([2, 3])
    corners = ['TL', 'TR', 'BL', 'BR']
    rng.shuffle(corners)
    chosen_corners = corners[:n_rects]

    if n_rects == 2:
        rect_colors = [color_a, color_b]
        rng.shuffle(rect_colors)
    else:
        first = rng.choice([color_a, color_b])
        mid = color_b if first == color_a else color_a
        rect_colors = [first, mid, first]

    def _make_rect(corner):
        h = rng.randint(int(N * RECT_SIZE_FRAC_MIN), int(N * RECT_SIZE_FRAC_MAX))
        w = rng.randint(int(N * RECT_SIZE_FRAC_MIN), int(N * RECT_SIZE_FRAC_MAX))
        m = rng.randint(0, RECT_MARGIN_MAX)
        r0 = m if corner[0] == 'T' else max(0, N - h - m)
        c0 = m if corner[1] == 'L' else max(0, N - w - m)
        return r0, c0, min(N, r0 + h), min(N, c0 + w)

    grid = np.zeros((N, N), dtype=int)
    for corner, color in zip(chosen_corners, rect_colors):
        r0, c0, r1, c1 = _make_rect(corner)
        grid[r0:r1, c0:c1] = color

    cnt_a = int(np.sum(grid == color_a))
    cnt_b = int(np.sum(grid == color_b))
    if cnt_a < MIN_REGION_CELLS or cnt_b < MIN_REGION_CELLS:
        return None
    coverage = (cnt_a + cnt_b) / (N * N)
    if not (COVERAGE_MIN <= coverage <= COVERAGE_MAX):
        return None
    if n_rects == 3:
        from scipy.ndimage import label
        _, n_components = label(grid == rect_colors[0])
        if n_components < 2:
            return None
    return grid


def _is_safe_dent_center(grid: np.ndarray, r: int, c: int, host: int, other: int) -> bool:
    """After setting (r,c) to black, the solver must detect it as a dent in host region."""
    if grid[r, c] != host:
        return False
    sub = _sub3x3(grid, r, c)
    host_count = int(np.sum(sub == host)) - 1  # exclude center cell
    return host_count >= DENT_MIN_HOST_3x3 and host_count > int(np.sum(sub == other))


def _would_form_2x2(grid: np.ndarray, r: int, c: int, color: int) -> bool:
    """Check whether placing `color` at (r,c) would complete a 2x2 block of that color."""
    h, w = grid.shape
    for dr in (-1, 0):
        for dc in (-1, 0):
            rr, cc = r + dr, c + dc
            if 0 <= rr < h - 1 and 0 <= cc < w - 1:
                block = grid[rr:rr + 2, cc:cc + 2].copy()
                block[r - rr, c - cc] = color
                if int(np.sum(block == color)) == 4:
                    return True
    return False


def _pick_dent_centers(candidates, n, rng):
    """Select n dent centers from candidates with Chebyshev distance >= DENT_PATCH_SEPARATION."""
    rng.shuffle(candidates)
    chosen = []
    for r, c in candidates:
        if all(max(abs(r - rr), abs(c - cc)) >= DENT_PATCH_SEPARATION for rr, cc in chosen):
            chosen.append((r, c))
            if len(chosen) >= n:
                return chosen
    return None


def _expand_to_pairs(dents, host, other, clean, all_dents, rng):
    """Optionally expand single-cell dents into 2-cell adjacent pairs (~13% chance each)."""
    h, w = clean.shape
    result = []
    for r, c in dents:
        cells = [(r, c)]
        if rng.random() < DENT_PAIR_PROB:
            neighbors = [(r + 1, c), (r - 1, c), (r, c + 1), (r, c - 1)]
            rng.shuffle(neighbors)
            for nr, nc in neighbors:
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                if clean[nr, nc] != host or not _is_safe_dent_center(clean, nr, nc, host, other):
                    continue
                if all(max(abs(nr - r2), abs(nc - c2)) >= DENT_PATCH_SEPARATION
                       for r2, c2 in all_dents if (r2, c2) != (r, c)):
                    cells.append((nr, nc))
                    break
        result.append(cells)
    return result


def _stamp_dents(clean, dent_groups_a, dent_groups_b, color_a, color_b):
    """Build output by stamping 3x3 opposite-color patches and marking teal at dent centers."""
    h, w = clean.shape
    output = clean.copy()
    for dent_groups, stamp_color in [(dent_groups_a, color_b), (dent_groups_b, color_a)]:
        for cells in dent_groups:
            for r, c in cells:
                output[max(0, r - 1):min(h, r + 2), max(0, c - 1):min(w, c + 2)] = stamp_color
    for dent_groups in (dent_groups_a, dent_groups_b):
        for cells in dent_groups:
            for r, c in cells:
                output[r, c] = Color.TEAL
    return output


def _add_bg_noise(inp, clean, n_in_bg, color_a, color_b, rng):
    """Place isolated fg-color specks in background area."""
    h, w = inp.shape
    bg_candidates = list(zip(*np.where(clean == 0), strict=False))
    rng.shuffle(bg_candidates)

    placed = 0
    for r_, c_ in bg_candidates:
        if placed >= n_in_bg:
            break
        r, c = int(r_), int(c_)
        sub = _sub3x3(inp, r, c)
        if int(np.sum(sub == 0)) < BG_SPECK_MIN_BG_3x3:
            continue
        # Pick the most common nearby fg color to look like a stray cell
        nearby = _sub3x3(clean, r, c)
        nearby_fg = [int(x) for x in nearby.flat if int(x) != 0]
        speck_color = _Counter(nearby_fg).most_common(1)[0][0] if nearby_fg else rng.choice([color_a, color_b])
        inp[r, c] = speck_color
        placed += 1


def _neighbor_cleanup_safe(inp, r, c, host, other):
    """Check that changing (r,c) to `other` won't cause the solver to misclassify any neighbor."""
    h, w = inp.shape
    for dr in (-1, 0, 1):
        for dc in (-1, 0, 1):
            if dr == 0 and dc == 0:
                continue
            nr, nc = r + dr, c + dc
            if not (0 <= nr < h and 0 <= nc < w) or inp[nr, nc] != host:
                continue
            nsub = _sub3x3(inp, nr, nc).copy()
            # Simulate the change at (r,c) in this neighbor's 3x3
            nr0, nc0 = max(0, nr - 1), max(0, nc - 1)
            nsub[r - nr0, c - nc0] = other
            own_n = int(np.sum(nsub == host))
            other_n = int(np.sum(nsub == other))
            bg_n = int(np.sum(nsub == 0))
            if (other_n > own_n and other_n >= 5) or own_n <= 2 or (bg_n >= 5 and own_n <= 4):
                return False
    return True


def _add_boundary_noise(inp, clean, n_at_boundary, color_a, color_b, rng):
    """Place cross-color contamination at region-region boundaries."""
    h, w = clean.shape
    # Find fg cells adjacent to the other region
    boundary_candidates = []
    for r in range(h):
        for c in range(w):
            v = int(clean[r, c])
            if v not in (color_a, color_b):
                continue
            other = color_b if v == color_a else color_a
            if int(np.sum(_sub3x3(clean, r, c) == other)) >= 1:
                boundary_candidates.append((r, c, v, other))
    rng.shuffle(boundary_candidates)

    placed = 0
    for r, c, host, other in boundary_candidates:
        if placed >= n_at_boundary:
            break
        if inp[r, c] != host:
            continue
        # Ensure solver's cleanup will revert this cell back to host:
        # need host_count >= BOUNDARY_MIN_HOST_3x3 and host_count-1 > other_count+1
        sub_now = _sub3x3(inp, r, c)
        host_count = int(np.sum(sub_now == host))
        other_count = int(np.sum(sub_now == other))
        if host_count < BOUNDARY_MIN_HOST_3x3 or host_count - 1 <= other_count + 1:
            continue
        if _would_form_2x2(inp, r, c, other):
            continue
        if not _neighbor_cleanup_safe(inp, r, c, host, other):
            continue
        inp[r, c] = other
        placed += 1


def _gen_attempt(rng: random.Random) -> np.ndarray | None:
    N = rng.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)
    fg_pool = [c for c in Color.NOT_BLACK if c != Color.TEAL]
    color_a, color_b = rng.sample(fg_pool, 2)

    clean = _build_regions(N, color_a, color_b, rng)
    if clean is None:
        return None

    # Decide per-color dent counts
    n_total = rng.randint(DENT_COUNT_MIN, DENT_COUNT_MAX)
    n_a, n_b = n_total // 2, n_total - n_total // 2
    if rng.random() < 0.5:
        n_a, n_b = n_b, n_a

    # Enumerate valid dent center positions per color
    h, w = clean.shape
    valid = {color_a: [], color_b: []}
    for r in range(h):
        for c in range(w):
            v = clean[r, c]
            if v == color_a and _is_safe_dent_center(clean, r, c, color_a, color_b):
                valid[color_a].append((r, c))
            elif v == color_b and _is_safe_dent_center(clean, r, c, color_b, color_a):
                valid[color_b].append((r, c))

    if len(valid[color_a]) < n_a + 2 or len(valid[color_b]) < n_b + 2:
        return None

    dents_a = _pick_dent_centers(valid[color_a], n_a, rng)
    dents_b = _pick_dent_centers(valid[color_b], n_b, rng)
    if dents_a is None or dents_b is None:
        return None

    # Expand some dents to 2-cell pairs
    groups_a = _expand_to_pairs(dents_a, color_a, color_b, clean, dents_a, rng)
    groups_b = _expand_to_pairs(dents_b, color_b, color_a, clean, dents_b, rng)

    # Build output
    output = _stamp_dents(clean, groups_a, groups_b, color_a, color_b)

    # Build input: clean grid with dent centers blackened
    inp = clean.copy()
    for cells in groups_a + groups_b:
        for r, c in cells:
            inp[r, c] = 0

    # Add noise
    n_noise = rng.randint(NOISE_COUNT_MIN, NOISE_COUNT_MAX)
    n_in_bg = int(round(n_noise * rng.uniform(BG_NOISE_FRAC_MIN, BG_NOISE_FRAC_MAX)))
    _add_bg_noise(inp, clean, n_in_bg, color_a, color_b, rng)
    _add_boundary_noise(inp, clean, n_noise - n_in_bg, color_a, color_b, rng)

    # Oracle check
    try:
        produced = main(inp)
    except Exception:
        return None
    if not np.array_equal(produced, output):
        return None
    return inp


def generate_input() -> np.ndarray:
    rng = random.Random()
    for _ in range(MAX_GENERATION_ATTEMPTS):
        try:
            grid = _gen_attempt(rng)
        except Exception:
            grid = None
        if grid is not None:
            return grid
    raise RuntimeError("generate_input: failed after %d attempts" % MAX_GENERATION_ATTEMPTS)

    ```

    ## 原始任务规格（Spec）

    以下是从原始 solver 代码和示例中提炼的完整任务规格，包含精确的数值约束和生成策略。
    Spec 本身就是原题代码生成时的参考文件，因此：
    - 在**设计分析**阶段，参考 spec 理解原始任务的完整设计细节（对象结构、空间关系、生成策略等），以此为基础思考融合变体的改动如何落实
    - 在**实现**阶段，参考 spec 中的数值约束（网格尺寸、对象数量/尺寸、颜色数等），确保融合变体在物理上可实现

    ```yaml
    spec:
  grid: 20-30 rows x 20-30 cols (square)
  colors: 2 foreground colors (any non-black, non-teal) on black background
  regions:
    layout: 2-3 axis-aligned rectangles of 2 fg colors, painted in order (later covers earlier = simple occlusion); together covering 68-76% of grid
    each_rectangle: 100-400 cells; partially overlapping with at least one other rectangle
    visible_shape: each color's visible area appears L-shaped or rectangular due to occlusion, not by staircase splitting
    background: fills corners/edges not covered by any rectangle; ~24-31% of grid
  dents:
    count: 12-22 clusters (scales with grid area), split roughly equally between the two regions
    shape: mostly 1-cell; ~10-15% are 2-cell (orthogonally adjacent pair)
    placement: each dent center's clean 3x3 neighborhood must contain >=5 host-color cells; 8-35% of dents are on the region boundary (4-neighbor includes non-host or grid edge)
    role: black (0) holes punched into the clean foreground regions
  noise:
    count: 7-22 isolated 1-cell wrong-color specks
    in_bg: foreground-color pixels scattered in background area (majority of noise)
    at_boundary: 0-7 cells of one fg color placed inside the other region, within 1 cell of the region-region boundary
  output_rule: |
    1. Clean regions: remove noise specks (isolated fg in bg -> black; boundary contamination -> correct region color)
    2. For each black dent whose cleaned 3x3 neighborhood is mostly one fg color (>=5 host cells):
       fill its 3x3 neighborhood with the OTHER fg color, then mark the dent center as teal (8)
    3. 3x3 patches clip to grid bounds and may overflow into bg or the other region at edges

generation_strategy:
  approach: output-first
  steps:
    1. Choose grid size N in [20,30] and two distinct fg colors (not black/teal).
    2. Build clean regions: paint 2-3 axis-aligned rectangles in order (later covers earlier). Use 2 fg colors; when 3 rects, two share a color. Ensure partial overlap between adjacent rects and 68-76% total coverage.
    3. Place dent centers: 12-22 total, ~equal per color. Center must have >=5 host cells in 3x3. Allow placement on region boundary (8-35%). ~10-15% are 2-cell adjacent pairs.
    4. Build output - stamp each dent's 3x3 neighborhood with the opposite fg color (clipping at grid bounds), then set dent centers to teal (8).
    5. Build input from clean regions - set dent center cells to black (0). Add 7-22 noise specks: place ~70% as isolated fg-color pixels in bg area (within 1-3 cells of a region edge), and ~30% as cross-color contamination at the region-region boundary.
    ```

额外要求：原始代码的 `main()` 已包含四段式说明注释/文档字符串（开头概述 + `Input structure:` + `Rule:` + `Key insight:`）。
生成的新代码里也必须在 `main()` 上方保留这一结构，并根据**融合后的新规则**与**原注释提供的信息**重新编写；可以借鉴原注释的组织方式，但**不要照抄原文**，要让内容准确反映融合后的输入结构、规则和关键洞察。


## 已有单变体参考代码

以下组成项已有单变体实现，可作为融合时的参考：

            ### 参考代码: D10/0

            文件: `/home/lixinyu/snap/new/ceshi/code/de809cff/D10/0/code.py`

            ```python
            # Variant of de809cff
# Dimension: D10 — 补丁大小 (transform)
# Change: 固定为3x3的补丁（以凹痕为中心的9像素方块）... → 补丁大小由凹痕到最近区域边界的距离决定

from __future__ import annotations

import random
from collections import Counter as _Counter

import numpy as np
from scipy.ndimage import label

from arc_utils import Color

# -----------------------------------------------------------------------------
# Design analysis for the D10 variant
#
# concretization:
#   - The two large foreground regions and the black background remain unchanged.
#   - The input still contains isolated wrong-color specks and cross-boundary
#     contamination, so the cleanup stage remains necessary.
#   - The changed object is the opposite-color patch produced around each dent.
#     In the original task every valid dent produced a fixed 3x3 square.
#     Here, each dent produces the largest odd square supported by the host
#     region around that dent: if the dent has one full same-color ring around
#     it, output 3x3; two rings, output 5x5; three rings, output 7x7.
#   - Concretely, after cleanup, a dent at (r,c) hosted by color A has radius d
#     iff every cell in the square [r-d:r+d, c-d:c+d] except the center is A,
#     and radius d+1 fails. The output stamps a (2d+1)x(2d+1) square in color B
#     and then recolors the center teal.
#
# behavior trace:
#   - Original logic at a dent: detect host from cleaned 3x3 majority -> always
#     stamp radius 1.
#   - New logic at a dent: detect host from cleaned 3x3 majority -> expand the
#     checked square while all non-center cells stay host-colored -> stamp the
#     resulting radius d.
#   - Example: a dent with host rings of widths 1, 2, 3 behaves as 3x3, 5x5,
#     7x7 respectively. This is the only semantic change in the transform.
#
# complexity calibration:
#   - If the generator allowed only radius-1 dents, the variant would visually
#     collapse back to the original task. To keep D10 observable, each sample is
#     forced to include several dents with radius > 1 and at least one 7x7 case.
#   - To avoid introducing unrelated ambiguity, the generator only uses three
#     repeated tiers (radii 1/2/3), not a wide unconstrained range.
#
# hidden assumptions reviewed:
#   - main() originally assumed every detected dent should stamp exactly one
#     clipped 3x3 square. That assumption fails under D10, so the solver now
#     computes a per-dent radius before stamping.
#   - The old dent detector accepted boundary dents with only 5 host cells in
#     the 3x3 neighborhood. Under D10 that would create ambiguous "distance"
#     values. The new solver still uses the 3x3 majority to infer the host, but
#     only accepts dents whose host support expands to at least one full ring.
#   - Because patch sizes now vary, overlapping large patches would hide the
#     scaling cue. The generator therefore spaces dents so their stamped squares
#     do not overlap.
#
# placement legality:
#   - Candidate dent cells are chosen from the clean regions before blackening.
#     Their exact support radius is measured on the clean grid.
#   - Dents are selected with Chebyshev spacing greater than the sum of their
#     radii, so opposite-color squares stay disjoint and fully inside the host
#     region that justified the radius.
#   - Noise placement skips protected neighborhoods around dents so cleanup
#     remains stable and the solver's inferred radii match the intended output.
#
# observability / cleanliness:
#   - Both foreground colors still participate, and every generated sample
#     contains repeated radius tiers. This gives the human solver multiple
#     examples of "deeper dent -> larger odd square" instead of a one-off.
#   - Patches remain monochrome with a teal center, so the output stays visually
#     tidy even though patch sizes now vary.
# -----------------------------------------------------------------------------


def _main_colors(g: np.ndarray, bg: int) -> tuple[int, int]:
    colors = [int(c) for c in np.unique(g) if int(c) != int(bg)]
    colors.sort(key=lambda c: int(np.sum(g == c)), reverse=True)
    assert len(colors) >= 2, "expected two foreground colors"
    return int(colors[0]), int(colors[1])


def _has_same_2x2(g: np.ndarray, r: int, c: int, color: int) -> bool:
    h, w = g.shape
    for dr in (-1, 0):
        for dc in (-1, 0):
            rr = int(r) + dr
            cc = int(c) + dc
            if 0 <= rr < h - 1 and 0 <= cc < w - 1:
                if bool(np.all(g[rr : rr + 2, cc : cc + 2] == int(color))):
                    return True
    return False


def _clean_foreground(g: np.ndarray, colors: tuple[int, int], bg: int) -> np.ndarray:
    """
    Remove one-cell specks/protrusions before reading dent geometry.

    Two sweeps are enough for this corruption model: one to wipe isolated
    outliers, one to let their neighbors settle to the corrected local majority.
    """
    h, w = g.shape
    a, b = map(int, colors)
    cur = g.copy()

    for _ in range(2):
        nxt = cur.copy()
        for r in range(h):
            for c in range(w):
                v = int(cur[r, c])
                if v not in colors:
                    nxt[r, c] = bg
                    continue

                sub = cur[max(0, r - 1) : min(h, r + 2), max(0, c - 1) : min(w, c + 2)]
                own = int(np.sum(sub == v))
                other = b if v == a else a
                other_count = int(np.sum(sub == other))
                bg_count = int(np.sum(sub == bg))

                if _has_same_2x2(cur, r, c, v):
                    nxt[r, c] = v
                elif other_count > own and other_count >= 5:
                    nxt[r, c] = other
                elif bg_count >= 5 and own <= 4:
                    nxt[r, c] = bg
                elif own <= 2:
                    nxt[r, c] = bg
                else:
                    nxt[r, c] = v
        cur = nxt

    return cur


def _square_support_radius(clean: np.ndarray, r: int, c: int, host: int) -> int:
    """Largest radius whose centered square is all host-colored except the dent center."""
    h, w = clean.shape
    radius = 0
    probe = 1
    while True:
        r0 = int(r) - probe
        c0 = int(c) - probe
        r1 = int(r) + probe + 1
        c1 = int(c) + probe + 1
        if r0 < 0 or c0 < 0 or r1 > h or c1 > w:
            break
        patch = clean[r0:r1, c0:c1]
        center_rr = int(r) - r0
        center_cc = int(c) - c0
        ok = True
        for rr in range(patch.shape[0]):
            for cc in range(patch.shape[1]):
                if rr == center_rr and cc == center_cc:
                    continue
                if int(patch[rr, cc]) != int(host):
                    ok = False
                    break
            if not ok:
                break
        if not ok:
            break
        radius = probe
        probe += 1
    return int(radius)


def _dent_specs(
    original: np.ndarray, clean: np.ndarray, colors: tuple[int, int], bg: int
) -> list[tuple[int, int, int, int]]:
    h, w = original.shape
    specs: list[tuple[int, int, int, int]] = []
    for r, c in zip(*np.where(original == int(bg)), strict=False):
        rr = int(r)
        cc = int(c)
        sub = clean[max(0, rr - 1) : min(h, rr + 2), max(0, cc - 1) : min(w, cc + 2)]
        counts = {int(color): int(np.sum(sub == int(color))) for color in colors}
        host = max(colors, key=lambda color: counts[int(color)])
        other = colors[1] if int(host) == int(colors[0]) else colors[0]
        if counts[int(host)] < 5 or counts[int(host)] <= counts[int(other)]:
            continue
        radius = _square_support_radius(clean, rr, cc, int(host))
        if radius >= 1:
            specs.append((rr, cc, int(host), int(radius)))
    return specs


def main(grid: np.ndarray) -> np.ndarray:
    """
    Turn black dents in two colored regions into size-scaled opposite-color patches.

    Input structure:
    - Black background with two large foreground regions in distinct colors.
    - The regions contain black dents plus one-cell foreground specks and
      one-cell cross-boundary contamination that should be cleaned first.

    Rule:
    - First denoise the two foreground regions exactly as in the original task:
      isolated specks fall back to black, and one-cell protrusions revert to the
      locally dominant neighboring region.
    - For each original black dent, infer which foreground color hosts it from
      the cleaned local majority, then measure how many full same-color square
      rings surround the dent center.
    - Stamp the opposite foreground color on the centered odd square whose side
      length is 2*d+1, where d is that measured ring depth, and recolor the
      dent center itself teal (8).

    Key insight: The output patch is no longer fixed-size; it is the largest
    centered odd square that the cleaned host region can support around the
    original defect, with teal preserving the defect location.
    """
    g = np.asarray(grid, dtype=int)
    bg = Color.BLACK
    colors = _main_colors(g, bg)
    clean = _clean_foreground(g, colors, bg)

    out = clean.copy()
    dent_specs = _dent_specs(g, clean, colors, bg)
    h, w = g.shape
    for r, c, host, radius in dent_specs:
        other = colors[1] if int(host) == int(colors[0]) else colors[0]
        out[max(0, r - radius) : min(h, r + radius + 1), max(0, c - radius) : min(w, c + radius + 1)] = int(
            other
        )

    for r, c, _host, _radius in dent_specs:
        out[r, c] = Color.TEAL

    return out


# --------------- generator (cx) ---------------

# --- CFG: canvas & region layout ---
GRID_SIZE_MIN, GRID_SIZE_MAX = 20, 30
RECT_SIZE_FRAC_MIN, RECT_SIZE_FRAC_MAX = 0.45, 0.75
RECT_MARGIN_MAX = 3
MIN_REGION_CELLS = 100
COVERAGE_MIN, COVERAGE_MAX = 0.55, 0.85

# --- CFG: dent placement ---
DENT_COUNT_MIN, DENT_COUNT_MAX = 8, 12
TARGET_RADII = (1, 2, 3)
REQUIRED_RADIUS3_COUNT = 2

# --- CFG: noise ---
NOISE_COUNT_MIN, NOISE_COUNT_MAX = 7, 18
BG_NOISE_FRAC_MIN, BG_NOISE_FRAC_MAX = 0.65, 0.85
BG_SPECK_MIN_BG_3x3 = 6
BOUNDARY_MIN_HOST_3x3 = 6

# --- CFG: generation control ---
MAX_GENERATION_ATTEMPTS = 400


def _sub3x3(grid: np.ndarray, r: int, c: int) -> np.ndarray:
    h, w = grid.shape
    return grid[max(0, r - 1) : min(h, r + 2), max(0, c - 1) : min(w, c + 2)]


def _build_regions(N: int, color_a: int, color_b: int, rng: random.Random) -> np.ndarray | None:
    """Paint 2-3 overlapping rectangles with painter's-algorithm occlusion."""
    n_rects = rng.choice([2, 3])
    corners = ["TL", "TR", "BL", "BR"]
    rng.shuffle(corners)
    chosen_corners = corners[:n_rects]

    if n_rects == 2:
        rect_colors = [color_a, color_b]
        rng.shuffle(rect_colors)
    else:
        first = rng.choice([color_a, color_b])
        mid = color_b if first == color_a else color_a
        rect_colors = [first, mid, first]

    def _make_rect(corner: str) -> tuple[int, int, int, int]:
        h = rng.randint(int(N * RECT_SIZE_FRAC_MIN), int(N * RECT_SIZE_FRAC_MAX))
        w = rng.randint(int(N * RECT_SIZE_FRAC_MIN), int(N * RECT_SIZE_FRAC_MAX))
        m = rng.randint(0, RECT_MARGIN_MAX)
        r0 = m if corner[0] == "T" else max(0, N - h - m)
        c0 = m if corner[1] == "L" else max(0, N - w - m)
        return r0, c0, min(N, r0 + h), min(N, c0 + w)

    grid = np.zeros((N, N), dtype=int)
    for corner, color in zip(chosen_corners, rect_colors):
        r0, c0, r1, c1 = _make_rect(corner)
        grid[r0:r1, c0:c1] = color

    cnt_a = int(np.sum(grid == color_a))
    cnt_b = int(np.sum(grid == color_b))
    if cnt_a < MIN_REGION_CELLS or cnt_b < MIN_REGION_CELLS:
        return None
    coverage = (cnt_a + cnt_b) / (N * N)
    if not (COVERAGE_MIN <= coverage <= COVERAGE_MAX):
        return None
    if n_rects == 3:
        _, n_components = label(grid == rect_colors[0])
        if int(n_components) < 2:
            return None
    return grid


def _full_square_radius(clean: np.ndarray, r: int, c: int, host: int) -> int:
    """Largest radius whose centered square is entirely host-colored, including the center."""
    if int(clean[r, c]) != int(host):
        return 0
    h, w = clean.shape
    radius = 0
    probe = 0
    while True:
        r0 = int(r) - probe
        c0 = int(c) - probe
        r1 = int(r) + probe + 1
        c1 = int(c) + probe + 1
        if r0 < 0 or c0 < 0 or r1 > h or c1 > w:
            break
        if not bool(np.all(clean[r0:r1, c0:c1] == int(host))):
            break
        radius = probe
        probe += 1
    return int(radius)


def _would_form_2x2(grid: np.ndarray, r: int, c: int, color: int) -> bool:
    h, w = grid.shape
    for dr in (-1, 0):
        for dc in (-1, 0):
            rr, cc = r + dr, c + dc
            if 0 <= rr < h - 1 and 0 <= cc < w - 1:
                block = grid[rr : rr + 2, cc : cc + 2].copy()
                block[r - rr, c - cc] = color
                if int(np.sum(block == color)) == 4:
                    return True
    return False


def _extract_radius_buckets(clean: np.ndarray, color_a: int, color_b: int) -> dict[int, dict[int, list[tuple[int, int]]]]:
    buckets: dict[int, dict[int, list[tuple[int, int]]]] = {
        int(color_a): {radius: [] for radius in TARGET_RADII},
        int(color_b): {radius: [] for radius in TARGET_RADII},
    }
    h, w = clean.shape
    for r in range(h):
        for c in range(w):
            v = int(clean[r, c])
            if v not in buckets:
                continue
            radius = _full_square_radius(clean, r, c, v)
            if radius in TARGET_RADII:
                buckets[v][int(radius)].append((int(r), int(c)))
    return buckets


def _far_enough(selected: list[tuple[int, int, int, int]], r: int, c: int, radius: int) -> bool:
    for rr, cc, _host, old_radius in selected:
        if max(abs(int(r) - int(rr)), abs(int(c) - int(cc))) <= int(radius) + int(old_radius):
            return False
    return True


def _pick_from_bucket(
    bucket: list[tuple[int, int]],
    radius: int,
    host: int,
    selected: list[tuple[int, int, int, int]],
    used: set[tuple[int, int]],
    rng: random.Random,
) -> tuple[int, int, int, int] | None:
    choices = bucket[:]
    rng.shuffle(choices)
    for r, c in choices:
        if (int(r), int(c)) in used:
            continue
        if _far_enough(selected, int(r), int(c), int(radius)):
            used.add((int(r), int(c)))
            return int(r), int(c), int(host), int(radius)
    return None


def _select_dents(
    buckets: dict[int, dict[int, list[tuple[int, int]]]],
    color_a: int,
    color_b: int,
    rng: random.Random,
) -> list[tuple[int, int, int, int]] | None:
    selected: list[tuple[int, int, int, int]] = []
    used: set[tuple[int, int]] = set()

    required = [
        (int(color_a), 1),
        (int(color_a), 2),
        (int(color_b), 1),
        (int(color_b), 2),
    ]
    for host, radius in required:
        spec = _pick_from_bucket(buckets[host][radius], radius, host, selected, used, rng)
        if spec is None:
            return None
        selected.append(spec)

    radius3_pool = [
        (int(host), int(r), int(c))
        for host in (int(color_a), int(color_b))
        for r, c in buckets[host][3]
        if (int(r), int(c)) not in used
    ]
    rng.shuffle(radius3_pool)
    radius3_added = 0
    for host, r, c in radius3_pool:
        if radius3_added >= REQUIRED_RADIUS3_COUNT:
            break
        if not _far_enough(selected, int(r), int(c), 3):
            continue
        used.add((int(r), int(c)))
        selected.append((int(r), int(c), int(host), 3))
        radius3_added += 1
    if radius3_added < REQUIRED_RADIUS3_COUNT:
        return None

    target_total = rng.randint(DENT_COUNT_MIN, DENT_COUNT_MAX)
    extras = [
        (radius, int(host), int(r), int(c))
        for host in (int(color_a), int(color_b))
        for radius in TARGET_RADII
        for r, c in buckets[host][radius]
        if (int(r), int(c)) not in used
    ]
    rng.shuffle(extras)
    for radius, host, r, c in extras:
        if len(selected) >= target_total:
            break
        if not _far_enough(selected, int(r), int(c), int(radius)):
            continue
        used.add((int(r), int(c)))
        selected.append((int(r), int(c), int(host), int(radius)))

    if len(selected) < max(6, DENT_COUNT_MIN):
        return None
    return selected


def _stamp_dents(clean: np.ndarray, dent_specs: list[tuple[int, int, int, int]], colors: tuple[int, int]) -> np.ndarray:
    h, w = clean.shape
    output = clean.copy()
    for r, c, host, radius in dent_specs:
        other = colors[1] if int(host) == int(colors[0]) else colors[0]
        output[max(0, r - radius) : min(h, r + radius + 1), max(0, c - radius) : min(w, c + radius + 1)] = int(other)
    for r, c, _host, _radius in dent_specs:
        output[r, c] = Color.TEAL
    return output


def _build_protected_mask(shape: tuple[int, int], dent_specs: list[tuple[int, int, int, int]]) -> np.ndarray:
    h, w = shape
    protected = np.zeros((h, w), dtype=bool)
    for r, c, _host, radius in dent_specs:
        pad = int(radius) + 1
        protected[max(0, r - pad) : min(h, r + pad + 1), max(0, c - pad) : min(w, c + pad + 1)] = True
    return protected


def _add_bg_noise(
    inp: np.ndarray,
    clean: np.ndarray,
    protected: np.ndarray,
    n_in_bg: int,
    color_a: int,
    color_b: int,
    rng: random.Random,
) -> None:
    h, w = inp.shape
    bg_candidates = list(zip(*np.where((clean == 0) & (~protected)), strict=False))
    rng.shuffle(bg_candidates)

    placed = 0
    for r_, c_ in bg_candidates:
        if placed >= n_in_bg:
            break
        r, c = int(r_), int(c_)
        sub = _sub3x3(inp, r, c)
        if int(np.sum(sub == 0)) < BG_SPECK_MIN_BG_3x3:
            continue
        nearby = _sub3x3(clean, r, c)
        nearby_fg = [int(x) for x in nearby.flat if int(x) != 0]
        speck_color = _Counter(nearby_fg).most_common(1)[0][0] if nearby_fg else rng.choice([color_a, color_b])
        inp[r, c] = int(speck_color)
        placed += 1


def _neighbor_cleanup_safe(inp: np.ndarray, r: int, c: int, host: int, other: int) -> bool:
    h, w = inp.shape
    for dr in (-1, 0, 1):
        for dc in (-1, 0, 1):
            if dr == 0 and dc == 0:
                continue
            nr, nc = r + dr, c + dc
            if not (0 <= nr < h and 0 <= nc < w) or int(inp[nr, nc]) != int(host):
                continue
            nsub = _sub3x3(inp, nr, nc).copy()
            nr0, nc0 = max(0, nr - 1), max(0, nc - 1)
            nsub[r - nr0, c - nc0] = int(other)
            own_n = int(np.sum(nsub == int(host)))
            other_n = int(np.sum(nsub == int(other)))
            bg_n = int(np.sum(nsub == 0))
            if (other_n > own_n and other_n >= 5) or own_n <= 2 or (bg_n >= 5 and own_n <= 4):
                return False
    return True


def _add_boundary_noise(
    inp: np.ndarray,
    clean: np.ndarray,
    protected: np.ndarray,
    n_at_boundary: int,
    color_a: int,
    color_b: int,
    rng: random.Random,
) -> None:
    h, w = clean.shape
    boundary_candidates = []
    for r in range(h):
        for c in range(w):
            if protected[r, c]:
                continue
            v = int(clean[r, c])
            if v not in (int(color_a), int(color_b)):
                continue
            other = int(color_b) if v == int(color_a) else int(color_a)
            if int(np.sum(_sub3x3(clean, r, c) == other)) >= 1:
                boundary_candidates.append((int(r), int(c), v, other))
    rng.shuffle(boundary_candidates)

    placed = 0
    for r, c, host, other in boundary_candidates:
        if placed >= n_at_boundary:
            break
        if int(inp[r, c]) != int(host):
            continue
        sub_now = _sub3x3(inp, r, c)
        host_count = int(np.sum(sub_now == int(host)))
        other_count = int(np.sum(sub_now == int(other)))
        if host_count < BOUNDARY_MIN_HOST_3x3 or host_count - 1 <= other_count + 1:
            continue
        if _would_form_2x2(inp, r, c, other):
            continue
        if not _neighbor_cleanup_safe(inp, r, c, host, other):
            continue
        inp[r, c] = int(other)
        placed += 1


def _gen_attempt(rng: random.Random) -> np.ndarray | None:
    N = rng.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)
    fg_pool = [c for c in Color.NOT_BLACK if c != Color.TEAL]
    color_a, color_b = rng.sample(fg_pool, 2)

    clean = _build_regions(N, color_a, color_b, rng)
    if clean is None:
        return None

    buckets = _extract_radius_buckets(clean, color_a, color_b)
    if any(not buckets[int(color_a)][radius] for radius in (1, 2)):
        return None
    if any(not buckets[int(color_b)][radius] for radius in (1, 2)):
        return None
    if len(buckets[int(color_a)][3]) + len(buckets[int(color_b)][3]) < REQUIRED_RADIUS3_COUNT:
        return None

    dent_specs = _select_dents(buckets, color_a, color_b, rng)
    if dent_specs is None:
        return None

    colors = (int(color_a), int(color_b))
    output = _stamp_dents(clean, dent_specs, colors)

    inp = clean.copy()
    for r, c, _host, _radius in dent_specs:
        inp[r, c] = 0

    protected = _build_protected_mask(clean.shape, dent_specs)

    n_noise = rng.randint(NOISE_COUNT_MIN, NOISE_COUNT_MAX)
    n_in_bg = int(round(n_noise * rng.uniform(BG_NOISE_FRAC_MIN, BG_NOISE_FRAC_MAX)))
    _add_bg_noise(inp, clean, protected, n_in_bg, color_a, color_b, rng)
    _add_boundary_noise(inp, clean, protected, n_noise - n_in_bg, color_a, color_b, rng)

    try:
        produced = main(inp)
    except Exception:
        return None
    if not np.array_equal(produced, output):
        return None
    return inp


