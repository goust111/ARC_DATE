    ```python
    from __future__ import annotations

import numpy as np

from arc_utils import Color
import random


def _main_colors(g: np.ndarray, bg: int) -> tuple[int, int]:
    colors = [int(c) for c in np.unique(g) if int(c) != int(bg)]
    colors.sort(key=lambda c: int(np.sum(g == c)), reverse=True)
    assert len(colors) >= 2, "expected two foreground colors"
    return int(colors[0]), int(colors[1])


def _has_same_2x2(g: np.ndarray, r: int, c: int, color: int) -> bool:
    h, w = g.shape
    for dr in (-1, 0):
        for dc in (-1, 0):
            rr = int(r) + dr
            cc = int(c) + dc
            if 0 <= rr < h - 1 and 0 <= cc < w - 1:
                if bool(np.all(g[rr : rr + 2, cc : cc + 2] == int(color))):
                    return True
    return False


def _clean_foreground(g: np.ndarray, colors: tuple[int, int], bg: int) -> np.ndarray:
    """
    Remove one-cell specks/protrusions before detecting black dents.

    Two sweeps are enough for the observed corruption pattern: the first removes
    protruding wrong-color cells, the second lets their neighboring true cells
    keep the corrected local majority.
    """
    h, w = g.shape
    a, b = map(int, colors)
    cur = g.copy()

    for _ in range(2):
        nxt = cur.copy()
        for r in range(h):
            for c in range(w):
                v = int(cur[r, c])
                if v not in colors:
                    nxt[r, c] = bg
                    continue

                sub = cur[max(0, r - 1) : min(h, r + 2), max(0, c - 1) : min(w, c + 2)]
                own = int(np.sum(sub == v))
                other = b if v == a else a
                other_count = int(np.sum(sub == other))
                bg_count = int(np.sum(sub == bg))

                if _has_same_2x2(cur, r, c, v):
                    nxt[r, c] = v
                elif other_count > own and other_count >= 5:
                    nxt[r, c] = other
                elif bg_count >= 5 and own <= 4:
                    nxt[r, c] = bg
                elif own <= 2:
                    nxt[r, c] = bg
                else:
                    nxt[r, c] = v
        cur = nxt

    return cur


def _dent_centers(original: np.ndarray, clean: np.ndarray, colors: tuple[int, int], bg: int) -> list[tuple[int, int, int]]:
    h, w = original.shape
    centers: list[tuple[int, int, int]] = []
    for r, c in zip(*np.where(original == int(bg)), strict=False):
        rr = int(r)
        cc = int(c)
        sub = clean[max(0, rr - 1) : min(h, rr + 2), max(0, cc - 1) : min(w, cc + 2)]
        counts = {int(color): int(np.sum(sub == int(color))) for color in colors}
        host = max(colors, key=lambda color: counts[int(color)])
        other = colors[1] if int(host) == int(colors[0]) else colors[0]
        if counts[int(host)] >= 5 and counts[int(host)] > counts[int(other)]:
            centers.append((rr, cc, int(host)))
    return centers


def main(grid: np.ndarray) -> np.ndarray:
    """
    Turn black dents in two colored regions into marked opposite-color patches.

    Input structure:
    - Black background with two large foreground colors.
    - The large regions contain small black dents and a few one-cell color specks
      or protrusions along region boundaries.

    Rule:
    - Locally clean the two foreground regions: isolated specks become black, and
      one-cell protrusions surrounded by the other region take that region's color.
    - Each original black dent whose cleaned 3x3 neighborhood is mostly one
      foreground color becomes the center of a 3x3 patch in the opposite color.
    - The dent center itself is recolored teal (8).

    Key insight: The teal pixels mark the original black defects; the surrounding
    3x3 patch uses the other foreground color, after first removing boundary noise.
    """
    g = np.asarray(grid, dtype=int)
    bg = Color.BLACK
    colors = _main_colors(g, bg)
    clean = _clean_foreground(g, colors, bg)

    out = clean.copy()
    centers = _dent_centers(g, clean, colors, bg)
    h, w = g.shape
    for r, c, host in centers:
        other = colors[1] if int(host) == int(colors[0]) else colors[0]
        out[max(0, r - 1) : min(h, r + 2), max(0, c - 1) : min(w, c + 2)] = int(other)

    for r, c, _host in centers:
        out[r, c] = Color.TEAL

    return out

# --------------- generator (cx) ---------------

from collections import Counter as _Counter

# --- CFG: canvas & region layout ---
GRID_SIZE_MIN, GRID_SIZE_MAX = 20, 30
RECT_SIZE_FRAC_MIN, RECT_SIZE_FRAC_MAX = 0.45, 0.75  # rect side as fraction of N
RECT_MARGIN_MAX = 3                                     # corner inset range [0, RECT_MARGIN_MAX]
MIN_REGION_CELLS = 100                                  # minimum cells per fg color
COVERAGE_MIN, COVERAGE_MAX = 0.55, 0.85                 # total fg coverage bounds

# --- CFG: dent placement ---
DENT_COUNT_MIN, DENT_COUNT_MAX = 12, 22
DENT_MIN_HOST_3x3 = 5       # host cells required in 3x3 around dent center
DENT_PATCH_SEPARATION = 3   # min Chebyshev distance between dent centers
DENT_PAIR_PROB = 0.13        # probability of expanding a single-cell dent to a 2-cell pair

# --- CFG: noise ---
NOISE_COUNT_MIN, NOISE_COUNT_MAX = 7, 22
BG_NOISE_FRAC_MIN, BG_NOISE_FRAC_MAX = 0.65, 0.85  # fraction of noise that is bg specks
BG_SPECK_MIN_BG_3x3 = 6     # min black cells in 3x3 for a bg speck to stay isolated
BOUNDARY_MIN_HOST_3x3 = 6   # min host cells in 3x3 for boundary contamination

# --- CFG: generation control ---
MAX_GENERATION_ATTEMPTS = 300


def _sub3x3(grid: np.ndarray, r: int, c: int) -> np.ndarray:
    """Return the 3x3 neighborhood of (r,c), clipped to grid bounds."""
    h, w = grid.shape
    return grid[max(0, r - 1):min(h, r + 2), max(0, c - 1):min(w, c + 2)]


def _build_regions(N: int, color_a: int, color_b: int, rng: random.Random) -> np.ndarray | None:
    """Paint 2-3 overlapping rectangles (simple occlusion, painter's algorithm)."""
    n_rects = rng.choice([2, 3])
    corners = ['TL', 'TR', 'BL', 'BR']
    rng.shuffle(corners)
    chosen_corners = corners[:n_rects]

    if n_rects == 2:
        rect_colors = [color_a, color_b]
        rng.shuffle(rect_colors)
    else:
        first = rng.choice([color_a, color_b])
        mid = color_b if first == color_a else color_a
        rect_colors = [first, mid, first]

    def _make_rect(corner):
        h = rng.randint(int(N * RECT_SIZE_FRAC_MIN), int(N * RECT_SIZE_FRAC_MAX))
        w = rng.randint(int(N * RECT_SIZE_FRAC_MIN), int(N * RECT_SIZE_FRAC_MAX))
        m = rng.randint(0, RECT_MARGIN_MAX)
        r0 = m if corner[0] == 'T' else max(0, N - h - m)
        c0 = m if corner[1] == 'L' else max(0, N - w - m)
        return r0, c0, min(N, r0 + h), min(N, c0 + w)

    grid = np.zeros((N, N), dtype=int)
    for corner, color in zip(chosen_corners, rect_colors):
        r0, c0, r1, c1 = _make_rect(corner)
        grid[r0:r1, c0:c1] = color

    cnt_a = int(np.sum(grid == color_a))
    cnt_b = int(np.sum(grid == color_b))
    if cnt_a < MIN_REGION_CELLS or cnt_b < MIN_REGION_CELLS:
        return None
    coverage = (cnt_a + cnt_b) / (N * N)
    if not (COVERAGE_MIN <= coverage <= COVERAGE_MAX):
        return None
    if n_rects == 3:
        from scipy.ndimage import label
        _, n_components = label(grid == rect_colors[0])
        if n_components < 2:
            return None
    return grid


def _is_safe_dent_center(grid: np.ndarray, r: int, c: int, host: int, other: int) -> bool:
    """After setting (r,c) to black, the solver must detect it as a dent in host region."""
    if grid[r, c] != host:
        return False
    sub = _sub3x3(grid, r, c)
    host_count = int(np.sum(sub == host)) - 1  # exclude center cell
    return host_count >= DENT_MIN_HOST_3x3 and host_count > int(np.sum(sub == other))


def _would_form_2x2(grid: np.ndarray, r: int, c: int, color: int) -> bool:
    """Check whether placing `color` at (r,c) would complete a 2x2 block of that color."""
    h, w = grid.shape
    for dr in (-1, 0):
        for dc in (-1, 0):
            rr, cc = r + dr, c + dc
            if 0 <= rr < h - 1 and 0 <= cc < w - 1:
                block = grid[rr:rr + 2, cc:cc + 2].copy()
                block[r - rr, c - cc] = color
                if int(np.sum(block == color)) == 4:
                    return True
    return False


def _pick_dent_centers(candidates, n, rng):
    """Select n dent centers from candidates with Chebyshev distance >= DENT_PATCH_SEPARATION."""
    rng.shuffle(candidates)
    chosen = []
    for r, c in candidates:
        if all(max(abs(r - rr), abs(c - cc)) >= DENT_PATCH_SEPARATION for rr, cc in chosen):
            chosen.append((r, c))
            if len(chosen) >= n:
                return chosen
    return None


def _expand_to_pairs(dents, host, other, clean, all_dents, rng):
    """Optionally expand single-cell dents into 2-cell adjacent pairs (~13% chance each)."""
    h, w = clean.shape
    result = []
    for r, c in dents:
        cells = [(r, c)]
        if rng.random() < DENT_PAIR_PROB:
            neighbors = [(r + 1, c), (r - 1, c), (r, c + 1), (r, c - 1)]
            rng.shuffle(neighbors)
            for nr, nc in neighbors:
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                if clean[nr, nc] != host or not _is_safe_dent_center(clean, nr, nc, host, other):
                    continue
                if all(max(abs(nr - r2), abs(nc - c2)) >= DENT_PATCH_SEPARATION
                       for r2, c2 in all_dents if (r2, c2) != (r, c)):
                    cells.append((nr, nc))
                    break
        result.append(cells)
    return result


def _stamp_dents(clean, dent_groups_a, dent_groups_b, color_a, color_b):
    """Build output by stamping 3x3 opposite-color patches and marking teal at dent centers."""
    h, w = clean.shape
    output = clean.copy()
    for dent_groups, stamp_color in [(dent_groups_a, color_b), (dent_groups_b, color_a)]:
        for cells in dent_groups:
            for r, c in cells:
                output[max(0, r - 1):min(h, r + 2), max(0, c - 1):min(w, c + 2)] = stamp_color
    for dent_groups in (dent_groups_a, dent_groups_b):
        for cells in dent_groups:
            for r, c in cells:
                output[r, c] = Color.TEAL
    return output


def _add_bg_noise(inp, clean, n_in_bg, color_a, color_b, rng):
    """Place isolated fg-color specks in background area."""
    h, w = inp.shape
    bg_candidates = list(zip(*np.where(clean == 0), strict=False))
    rng.shuffle(bg_candidates)

    placed = 0
    for r_, c_ in bg_candidates:
        if placed >= n_in_bg:
            break
        r, c = int(r_), int(c_)
        sub = _sub3x3(inp, r, c)
        if int(np.sum(sub == 0)) < BG_SPECK_MIN_BG_3x3:
            continue
        # Pick the most common nearby fg color to look like a stray cell
        nearby = _sub3x3(clean, r, c)
        nearby_fg = [int(x) for x in nearby.flat if int(x) != 0]
        speck_color = _Counter(nearby_fg).most_common(1)[0][0] if nearby_fg else rng.choice([color_a, color_b])
        inp[r, c] = speck_color
        placed += 1


def _neighbor_cleanup_safe(inp, r, c, host, other):
    """Check that changing (r,c) to `other` won't cause the solver to misclassify any neighbor."""
    h, w = inp.shape
    for dr in (-1, 0, 1):
        for dc in (-1, 0, 1):
            if dr == 0 and dc == 0:
                continue
            nr, nc = r + dr, c + dc
            if not (0 <= nr < h and 0 <= nc < w) or inp[nr, nc] != host:
                continue
            nsub = _sub3x3(inp, nr, nc).copy()
            # Simulate the change at (r,c) in this neighbor's 3x3
            nr0, nc0 = max(0, nr - 1), max(0, nc - 1)
            nsub[r - nr0, c - nc0] = other
            own_n = int(np.sum(nsub == host))
            other_n = int(np.sum(nsub == other))
            bg_n = int(np.sum(nsub == 0))
            if (other_n > own_n and other_n >= 5) or own_n <= 2 or (bg_n >= 5 and own_n <= 4):
                return False
    return True


def _add_boundary_noise(inp, clean, n_at_boundary, color_a, color_b, rng):
    """Place cross-color contamination at region-region boundaries."""
    h, w = clean.shape
    # Find fg cells adjacent to the other region
    boundary_candidates = []
    for r in range(h):
        for c in range(w):
            v = int(clean[r, c])
            if v not in (color_a, color_b):
                continue
            other = color_b if v == color_a else color_a
            if int(np.sum(_sub3x3(clean, r, c) == other)) >= 1:
                boundary_candidates.append((r, c, v, other))
    rng.shuffle(boundary_candidates)

    placed = 0
    for r, c, host, other in boundary_candidates:
        if placed >= n_at_boundary:
            break
        if inp[r, c] != host:
            continue
        # Ensure solver's cleanup will revert this cell back to host:
        # need host_count >= BOUNDARY_MIN_HOST_3x3 and host_count-1 > other_count+1
        sub_now = _sub3x3(inp, r, c)
        host_count = int(np.sum(sub_now == host))
        other_count = int(np.sum(sub_now == other))
        if host_count < BOUNDARY_MIN_HOST_3x3 or host_count - 1 <= other_count + 1:
            continue
        if _would_form_2x2(inp, r, c, other):
            continue
        if not _neighbor_cleanup_safe(inp, r, c, host, other):
            continue
        inp[r, c] = other
        placed += 1


def _gen_attempt(rng: random.Random) -> np.ndarray | None:
    N = rng.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)
    fg_pool = [c for c in Color.NOT_BLACK if c != Color.TEAL]
    color_a, color_b = rng.sample(fg_pool, 2)

    clean = _build_regions(N, color_a, color_b, rng)
    if clean is None:
        return None

    # Decide per-color dent counts
    n_total = rng.randint(DENT_COUNT_MIN, DENT_COUNT_MAX)
    n_a, n_b = n_total // 2, n_total - n_total // 2
    if rng.random() < 0.5:
        n_a, n_b = n_b, n_a

    # Enumerate valid dent center positions per color
    h, w = clean.shape
    valid = {color_a: [], color_b: []}
    for r in range(h):
        for c in range(w):
            v = clean[r, c]
            if v == color_a and _is_safe_dent_center(clean, r, c, color_a, color_b):
                valid[color_a].append((r, c))
            elif v == color_b and _is_safe_dent_center(clean, r, c, color_b, color_a):
                valid[color_b].append((r, c))

    if len(valid[color_a]) < n_a + 2 or len(valid[color_b]) < n_b + 2:
        return None

    dents_a = _pick_dent_centers(valid[color_a], n_a, rng)
    dents_b = _pick_dent_centers(valid[color_b], n_b, rng)
    if dents_a is None or dents_b is None:
        return None

    # Expand some dents to 2-cell pairs
    groups_a = _expand_to_pairs(dents_a, color_a, color_b, clean, dents_a, rng)
    groups_b = _expand_to_pairs(dents_b, color_b, color_a, clean, dents_b, rng)

    # Build output
    output = _stamp_dents(clean, groups_a, groups_b, color_a, color_b)

    # Build input: clean grid with dent centers blackened
    inp = clean.copy()
    for cells in groups_a + groups_b:
        for r, c in cells:
            inp[r, c] = 0

    # Add noise
    n_noise = rng.randint(NOISE_COUNT_MIN, NOISE_COUNT_MAX)
    n_in_bg = int(round(n_noise * rng.uniform(BG_NOISE_FRAC_MIN, BG_NOISE_FRAC_MAX)))
    _add_bg_noise(inp, clean, n_in_bg, color_a, color_b, rng)
    _add_boundary_noise(inp, clean, n_noise - n_in_bg, color_a, color_b, rng)

    # Oracle check
    try:
        produced = main(inp)
    except Exception:
        return None
    if not np.array_equal(produced, output):
        return None
    return inp


def generate_input() -> np.ndarray:
    rng = random.Random()
    for _ in range(MAX_GENERATION_ATTEMPTS):
        try:
            grid = _gen_attempt(rng)
        except Exception:
            grid = None
        if grid is not None:
            return grid
    raise RuntimeError("generate_input: failed after %d attempts" % MAX_GENERATION_ATTEMPTS)

    ```

    ## 原始任务规格（Spec）

    以下是从原始 solver 代码和示例中提炼的完整任务规格，包含精确的数值约束和生成策略。
    Spec 本身就是原题代码生成时的参考文件，因此：
    - 在**设计分析**阶段，参考 spec 理解原始任务的完整设计细节（对象结构、空间关系、生成策略等），以此为基础思考融合变体的改动如何落实
    - 在**实现**阶段，参考 spec 中的数值约束（网格尺寸、对象数量/尺寸、颜色数等），确保融合变体在物理上可实现

    ```yaml
    spec:
  grid: 20-30 rows x 20-30 cols (square)
  colors: 2 foreground colors (any non-black, non-teal) on black background
  regions:
    layout: 2-3 axis-aligned rectangles of 2 fg colors, painted in order (later covers earlier = simple occlusion); together covering 68-76% of grid
    each_rectangle: 100-400 cells; partially overlapping with at least one other rectangle
    visible_shape: each color's visible area appears L-shaped or rectangular due to occlusion, not by staircase splitting
    background: fills corners/edges not covered by any rectangle; ~24-31% of grid
  dents:
    count: 12-22 clusters (scales with grid area), split roughly equally between the two regions
    shape: mostly 1-cell; ~10-15% are 2-cell (orthogonally adjacent pair)
    placement: each dent center's clean 3x3 neighborhood must contain >=5 host-color cells; 8-35% of dents are on the region boundary (4-neighbor includes non-host or grid edge)
    role: black (0) holes punched into the clean foreground regions
  noise:
    count: 7-22 isolated 1-cell wrong-color specks
    in_bg: foreground-color pixels scattered in background area (majority of noise)
    at_boundary: 0-7 cells of one fg color placed inside the other region, within 1 cell of the region-region boundary
  output_rule: |
    1. Clean regions: remove noise specks (isolated fg in bg -> black; boundary contamination -> correct region color)
    2. For each black dent whose cleaned 3x3 neighborhood is mostly one fg color (>=5 host cells):
       fill its 3x3 neighborhood with the OTHER fg color, then mark the dent center as teal (8)
    3. 3x3 patches clip to grid bounds and may overflow into bg or the other region at edges

generation_strategy:
  approach: output-first
  steps:
    1. Choose grid size N in [20,30] and two distinct fg colors (not black/teal).
    2. Build clean regions: paint 2-3 axis-aligned rectangles in order (later covers earlier). Use 2 fg colors; when 3 rects, two share a color. Ensure partial overlap between adjacent rects and 68-76% total coverage.
    3. Place dent centers: 12-22 total, ~equal per color. Center must have >=5 host cells in 3x3. Allow placement on region boundary (8-35%). ~10-15% are 2-cell adjacent pairs.
    4. Build output - stamp each dent's 3x3 neighborhood with the opposite fg color (clipping at grid bounds), then set dent centers to teal (8).
    5. Build input from clean regions - set dent center cells to black (0). Add 7-22 noise specks: place ~70% as isolated fg-color pixels in bg area (within 1-3 cells of a region edge), and ~30% as cross-color contamination at the region-region boundary.
    ```

额外要求：原始代码的 `main()` 已包含四段式说明注释/文档字符串（开头概述 + `Input structure:` + `Rule:` + `Key insight:`）。
生成的新代码里也必须在 `main()` 上方保留这一结构，并根据**融合后的新规则**与**原注释提供的信息**重新编写；可以借鉴原注释的组织方式，但**不要照抄原文**，要让内容准确反映融合后的输入结构、规则和关键洞察。


## 已有单变体参考代码

以下组成项已有单变体实现，可作为融合时的参考：

            ### 参考代码: D1/1

            文件: `/home/lixinyu/snap/new/ceshi/code/de809cff/D1/1/code.py`

            ```python
            # Variant of de809cff
# Dimension: D1 — 核心变换规则：凹痕到3x3补丁 (transform)
# Change: 每个黑色凹痕的3x3邻域多数前景色为A时，凹痕变为3x3的前景色B补丁，中心为teal(8)... → 凹痕变为同侧前景色补丁（非对侧）

from __future__ import annotations

import random
from collections import Counter as _Counter

import numpy as np

from arc_utils import Color


# Design analysis for the D1 inversion variant
# --------------------------------------------
# a) Concrete behavior trace
# - The input still contains two large non-black regions on a black background,
#   with black dents and one-cell noise. The solver still has to clean the
#   regions first, then identify every original black cell whose cleaned 3x3
#   neighborhood clearly belongs to one host color.
# - Original behavior at one dent:
#     clean 3x3 majority = red -> paint the whole 3x3 yellow -> recolor center teal.
# - Variant behavior at the same dent:
#     clean 3x3 majority = red -> paint the whole 3x3 red -> recolor center teal.
# - The difference matters most when the 3x3 touches background or the other
#   region. In that case the original task "plants" a foreign-color block,
#   while the variant "repairs" the host region by expanding its own color into
#   nearby non-host cells. Interior dents remain mostly teal-center markers.
#
# b) Complexity calibration
# - If dents were mostly deep inside solid rectangles, the new 3x3 repaint would
#   often be visually indistinguishable from simply restoring the center before
#   marking it teal. That would weaken the D1 signal.
# - To keep the variant observable without changing the task family, the
#   generator requires multiple visible edge-adjacent dents overall, while still
#   keeping many interior dents. This preserves repeated evidence for
#   "same-side repair" in 2-4 ARC examples without over-constraining layout
#   sampling.
#
# c) Main() line-by-line assumption review
# - _main_colors assumes exactly two dominant foreground colors after excluding
#   black; that still holds because the input palette is unchanged.
# - _clean_foreground assumes all non-main colors are noise and should collapse
#   to black or the local majority. That remains valid because the variant only
#   changes the final dent repaint, not the corruption model.
# - _dent_centers assumes a dent can be assigned to the local majority color if
#   that color has at least 5 cells in the cleaned 3x3 and strictly beats the
#   other color. This still defines the host region correctly for the variant.
# - The original main() relied on the extra step "host -> other" when stamping
#   the 3x3 patch. That is the only old-property dependency that must change.
#   In the variant, stamping must use host directly; otherwise the solver would
#   silently revert to the old rule.
#
# d) Placement legality
# - Dent centers are only chosen from host-colored cells whose 3x3 neighborhood
#   still has at least 5 host cells after removing the center. This guarantees
#   the solver can recover the host color from the input.
# - Centers keep Chebyshev distance >= 3 from other chosen centers of the same
#   color, preventing accidental overlap between unrelated 3x3 patches.
# - Optional 2-cell dents are added only when the second cell is also a valid
#   dent center and does not crowd other same-color dents.
#
# e) Visual observability
# - The generator classifies dent candidates as "visible-patch" when their
#   clean 3x3 already contains at least one non-host cell. These are the cases
#   where same-color stamping visibly extends the region.
# - Each generated grid must contain multiple such dents after final cleanup.
#   This avoids a degenerate dataset where the variant is technically correct
#   but hard to infer by eye.
#
# f) Visual cleanliness
# - Noise remains one-cell only, and dents are spaced apart. The output shows
#   large clean regions plus teal markers, with only local 3x3 repairs around
#   dents. That keeps the image readable even when some repairs clip over region
#   boundaries or into background.
#
# g) Color inference
# - No hidden color ordering is introduced. The host color comes purely from the
#   visible majority in the cleaned 3x3. The only special output color remains
#   teal at dent centers, matching the original task family.
#
# h) New implicit assumptions after the change
# - main() now assumes that at least some dents have non-host cells in their
#   surrounding 3x3 if the dataset is meant to advertise the "same-side patch"
#   rule visually. generate_input() enforces that by validating the final count
#   of visible same-side repairs after noise and cleanup.
# - main() also assumes the cleaned grid is the intended pre-dent canvas; the
#   generator therefore continues using output-first construction plus an oracle
#   equality check so every produced input is solvable by the implemented logic.


def _main_colors(g: np.ndarray, bg: int) -> tuple[int, int]:
    colors = [int(c) for c in np.unique(g) if int(c) != int(bg)]
    colors.sort(key=lambda c: int(np.sum(g == c)), reverse=True)
    assert len(colors) >= 2, "expected two foreground colors"
    return int(colors[0]), int(colors[1])


def _has_same_2x2(g: np.ndarray, r: int, c: int, color: int) -> bool:
    h, w = g.shape
    for dr in (-1, 0):
        for dc in (-1, 0):
            rr = int(r) + dr
            cc = int(c) + dc
            if 0 <= rr < h - 1 and 0 <= cc < w - 1:
                if bool(np.all(g[rr : rr + 2, cc : cc + 2] == int(color))):
                    return True
    return False


def _clean_foreground(g: np.ndarray, colors: tuple[int, int], bg: int) -> np.ndarray:
    """
    Remove one-cell specks/protrusions before detecting black dents.

    Two sweeps are enough for the observed corruption pattern: the first removes
    protruding wrong-color cells, the second lets their neighboring true cells
    keep the corrected local majority.
    """
    h, w = g.shape
    a, b = map(int, colors)
    cur = g.copy()

    for _ in range(2):
        nxt = cur.copy()
        for r in range(h):
            for c in range(w):
                v = int(cur[r, c])
                if v not in colors:
                    nxt[r, c] = bg
                    continue

                sub = cur[max(0, r - 1) : min(h, r + 2), max(0, c - 1) : min(w, c + 2)]
                own = int(np.sum(sub == v))
                other = b if v == a else a
                other_count = int(np.sum(sub == other))
                bg_count = int(np.sum(sub == bg))

                if _has_same_2x2(cur, r, c, v):
                    nxt[r, c] = v
                elif other_count > own and other_count >= 5:
                    nxt[r, c] = other
                elif bg_count >= 5 and own <= 4:
                    nxt[r, c] = bg
                elif own <= 2:
                    nxt[r, c] = bg
                else:
                    nxt[r, c] = v
        cur = nxt

    return cur


def _dent_centers(
    original: np.ndarray, clean: np.ndarray, colors: tuple[int, int], bg: int
) -> list[tuple[int, int, int]]:
    h, w = original.shape
    centers: list[tuple[int, int, int]] = []
    for r, c in zip(*np.where(original == int(bg)), strict=False):
        rr = int(r)
        cc = int(c)
        sub = clean[max(0, rr - 1) : min(h, rr + 2), max(0, cc - 1) : min(w, cc + 2)]
        counts = {int(color): int(np.sum(sub == int(color))) for color in colors}
        host = max(colors, key=lambda color: counts[int(color)])
        other = colors[1] if int(host) == int(colors[0]) else colors[0]
        if counts[int(host)] >= 5 and counts[int(host)] > counts[int(other)]:
            centers.append((rr, cc, int(host)))
    return centers


def main(grid: np.ndarray) -> np.ndarray:
    """
    Repair black dents in two colored regions and mark them with teal centers.

    Input structure:
    - Black background with two broad foreground regions in two non-black colors.
    - The regions contain black dents plus a small amount of one-cell foreground
      noise in background space or along the border between the two regions.

    Rule:
    - First denoise the foreground locally: isolated color specks disappear into
      black, and one-cell cross-boundary contamination flips back to the region
      that dominates its local neighborhood.
    - Then inspect each original black cell. If the cleaned 3x3 neighborhood is
      mostly one foreground color, repaint that whole 3x3 with the SAME host
      color rather than the opposite one.
    - Finally recolor the dent center itself to teal (8).

    Key insight: teal still marks where the original black defects were, but the
    surrounding 3x3 now repairs the damaged region with its own color instead of
    inserting a contrasting block from the other region.
    """
    g = np.asarray(grid, dtype=int)
    bg = Color.BLACK
    colors = _main_colors(g, bg)
    clean = _clean_foreground(g, colors, bg)

    centers = _dent_centers(g, clean, colors, bg)
    return _render_centers(clean, centers)


# --------------- generator (cx) ---------------

# --- CFG: canvas & region layout ---
GRID_SIZE_MIN, GRID_SIZE_MAX = 20, 30
RECT_SIZE_FRAC_MIN, RECT_SIZE_FRAC_MAX = 0.45, 0.75
RECT_MARGIN_MAX = 3
MIN_REGION_CELLS = 100
COVERAGE_MIN, COVERAGE_MAX = 0.55, 0.85

# --- CFG: dent placement ---
DENT_COUNT_MIN, DENT_COUNT_MAX = 12, 22
DENT_MIN_HOST_3x3 = 5
DENT_PATCH_SEPARATION = 3
DENT_PAIR_PROB = 0.13
VISIBLE_DENTS_TOTAL_MIN = 2

# --- CFG: noise ---
NOISE_COUNT_MIN, NOISE_COUNT_MAX = 7, 22
BG_NOISE_FRAC_MIN, BG_NOISE_FRAC_MAX = 0.65, 0.85
BG_SPECK_MIN_BG_3x3 = 6
BOUNDARY_MIN_HOST_3x3 = 6

# --- CFG: generation control ---
MAX_GENERATION_ATTEMPTS = 300


def _sub3x3(grid: np.ndarray, r: int, c: int) -> np.ndarray:
    h, w = grid.shape
    return grid[max(0, r - 1) : min(h, r + 2), max(0, c - 1) : min(w, c + 2)]


def _build_regions(N: int, color_a: int, color_b: int, rng: random.Random) -> np.ndarray | None:
    """Paint 2-3 overlapping rectangles (simple occlusion, painter's algorithm)."""
    n_rects = rng.choice([2, 3])
    corners = ["TL", "TR", "BL", "BR"]
    rng.shuffle(corners)
    chosen_corners = corners[:n_rects]

    if n_rects == 2:
        rect_colors = [color_a, color_b]
        rng.shuffle(rect_colors)
    else:
        first = rng.choice([color_a, color_b])
        mid = color_b if first == color_a else color_a
        rect_colors = [first, mid, first]

    def _make_rect(corner: str) -> tuple[int, int, int, int]:
        h = rng.randint(int(N * RECT_SIZE_FRAC_MIN), int(N * RECT_SIZE_FRAC_MAX))
        w = rng.randint(int(N * RECT_SIZE_FRAC_MIN), int(N * RECT_SIZE_FRAC_MAX))
        m = rng.randint(0, RECT_MARGIN_MAX)
        r0 = m if corner[0] == "T" else max(0, N - h - m)
        c0 = m if corner[1] == "L" else max(0, N - w - m)
        return r0, c0, min(N, r0 + h), min(N, c0 + w)

    grid = np.zeros((N, N), dtype=int)
    for corner, color in zip(chosen_corners, rect_colors):
        r0, c0, r1, c1 = _make_rect(corner)
        grid[r0:r1, c0:c1] = color

    cnt_a = int(np.sum(grid == color_a))
    cnt_b = int(np.sum(grid == color_b))
    if cnt_a < MIN_REGION_CELLS or cnt_b < MIN_REGION_CELLS:
        return None
    coverage = (cnt_a + cnt_b) / (N * N)
    if not (COVERAGE_MIN <= coverage <= COVERAGE_MAX):
        return None
    if n_rects == 3:
        from scipy.ndimage import label

        _, n_components = label(grid == rect_colors[0])
        if n_components < 2:
            return None
    return grid


def _is_safe_dent_center(grid: np.ndarray, r: int, c: int, host: int, other: int) -> bool:
    """After setting (r,c) to black, the solver must detect it as a dent in host region."""
    if int(grid[r, c]) != int(host):
        return False
    sub = _sub3x3(grid, r, c)
    host_count = int(np.sum(sub == int(host))) - 1
    return host_count >= DENT_MIN_HOST_3x3 and host_count > int(np.sum(sub == int(other)))


def _is_visible_patch_center(grid: np.ndarray, r: int, c: int, host: int) -> bool:
    """True when same-color 3x3 stamping changes more than the center cell."""
    sub = _sub3x3(grid, r, c)
    host_count = int(np.sum(sub == int(host)))
    non_host = sub.size - host_count
    return 1 <= non_host <= 2 and host_count >= 6 and _has_same_2x2(grid, r, c, host)


def _would_form_2x2(grid: np.ndarray, r: int, c: int, color: int) -> bool:
    h, w = grid.shape
    for dr in (-1, 0):
        for dc in (-1, 0):
            rr, cc = r + dr, c + dc
            if 0 <= rr < h - 1 and 0 <= cc < w - 1:
                block = grid[rr : rr + 2, cc : cc + 2].copy()
                block[r - rr, c - cc] = color
                if int(np.sum(block == color)) == 4:
                    return True
    return False


def _pick_dent_centers(candidates, n, rng):
    rng.shuffle(candidates)
    chosen = []
    for r, c in candidates:
        if all(max(abs(r - rr), abs(c - cc)) >= DENT_PATCH_SEPARATION for rr, cc in chosen):
            chosen.append((r, c))
            if len(chosen) >= n:
                return chosen
    return None


def _pick_dent_centers_with_visible(visible, hidden, n: int, min_visible: int, rng: random.Random):
    """Pick n same-color dent centers while reserving enough visually revealing ones."""
    visible = list(visible)
    hidden = list(hidden)
    rng.shuffle(visible)
    rng.shuffle(hidden)

    chosen: list[tuple[int, int]] = []

    def _try_add(pool) -> None:
        for r, c in pool:
            if len(chosen) >= n:
                return
            if all(max(abs(r - rr), abs(c - cc)) >= DENT_PATCH_SEPARATION for rr, cc in chosen):
                chosen.append((r, c))

    _try_add(visible)
    if len(chosen) < min_visible:
        return None

    remaining = [pos for pos in visible if pos not in chosen] + hidden
    rng.shuffle(remaining)
    _try_add(remaining)
    if len(chosen) != n:
        return None
    return chosen


def _dent_remains_detectable(grid: np.ndarray, r: int, c: int, host: int, other: int) -> bool:
    """Check the main() dent predicate on an already-blackened working grid."""
    if int(grid[r, c]) != Color.BLACK:
        return False
    sub = _sub3x3(grid, r, c)
    host_count = int(np.sum(sub == int(host)))
    other_count = int(np.sum(sub == int(other)))
    return host_count >= DENT_MIN_HOST_3x3 and host_count > other_count


def _expand_to_pairs(dents, host, other, clean, all_dents, rng):
    h, w = clean.shape
    result = []
    for r, c in dents:
        cells = [(r, c)]
        if rng.random() < DENT_PAIR_PROB:
            neighbors = [(r + 1, c), (r - 1, c), (r, c + 1), (r, c - 1)]
            rng.shuffle(neighbors)
            for nr, nc in neighbors:
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                if clean[nr, nc] != host or not _is_safe_dent_center(clean, nr, nc, host, other):
                    continue
                if all(
                    max(abs(nr - r2), abs(nc - c2)) >= DENT_PATCH_SEPARATION
                    for r2, c2 in all_dents
                    if (r2, c2) != (r, c)
                ):
                    temp = clean.copy()
                    temp[r, c] = Color.BLACK
                    temp[nr, nc] = Color.BLACK
                    if not (
                        _dent_remains_detectable(temp, r, c, host, other)
                        and _dent_remains_detectable(temp, nr, nc, host, other)
                    ):
                        continue
                    cells.append((nr, nc))
                    break
        result.append(cells)
    return result


def _stamp_dents(clean, dent_groups_a, dent_groups_b, color_a, color_b):
    """Build output by stamping 3x3 host-color patches and marking teal centers."""
    dent_cells = []
    for dent_groups, stamp_color in ((dent_groups_a, color_a), (dent_groups_b, color_b)):
        for cells in dent_groups:
            for r, c in cells:
                dent_cells.append((r, c, stamp_color))
    return _render_centers(clean, sorted(dent_cells))


def _render_centers(clean: np.ndarray, centers: list[tuple[int, int, int]]) -> np.ndarray:
    h, w = clean.shape
    output = clean.copy()
    for r, c, host in centers:
        output[max(0, r - 1) : min(h, r + 2), max(0, c - 1) : min(w, c + 2)] = int(host)
    for r, c, _host in centers:
        output[r, c] = Color.TEAL
    return output


def _center_has_visible_extension(clean: np.ndarray, r: int, c: int, host: int) -> bool:
    """After cleanup, would same-color stamping change any neighbor besides the center?"""
    sub = _sub3x3(clean, r, c).copy()
    r0 = max(0, r - 1)
    c0 = max(0, c - 1)
    sub[r - r0, c - c0] = host
    return bool(np.any(sub != int(host)))


def _add_bg_noise(inp, clean, n_in_bg, color_a, color_b, rng):
    """Place isolated fg-color specks in background area."""
    bg_candidates = list(zip(*np.where(clean == 0), strict=False))
    rng.shuffle(bg_candidates)

    placed = 0
    for r_, c_ in bg_candidates:
        if placed >= n_in_bg:
            break
        r, c = int(r_), int(c_)
        sub = _sub3x3(inp, r, c)
        if int(np.sum(sub == 0)) < BG_SPECK_MIN_BG_3x3:
            continue
        nearby = _sub3x3(clean, r, c)
        nearby_fg = [int(x) for x in nearby.flat if int(x) != 0]
        speck_color = _Counter(nearby_fg).most_common(1)[0][0] if nearby_fg else rng.choice([color_a, color_b])
        inp[r, c] = speck_color
        placed += 1


def _neighbor_cleanup_safe(inp, r, c, host, other):
    """Check that changing (r,c) to `other` won't cause the solver to misclassify any neighbor."""
    h, w = inp.shape
    for dr in (-1, 0, 1):
        for dc in (-1, 0, 1):
            if dr == 0 and dc == 0:
                continue
            nr, nc = r + dr, c + dc
            if not (0 <= nr < h and 0 <= nc < w) or inp[nr, nc] != host:
                continue
            nsub = _sub3x3(inp, nr, nc).copy()
            nr0, nc0 = max(0, nr - 1), max(0, nc - 1)
            nsub[r - nr0, c - nc0] = other
            own_n = int(np.sum(nsub == host))
            other_n = int(np.sum(nsub == other))
            bg_n = int(np.sum(nsub == 0))
            if (other_n > own_n and other_n >= 5) or own_n <= 2 or (bg_n >= 5 and own_n <= 4):
                return False
    return True


def _add_boundary_noise(inp, clean, n_at_boundary, color_a, color_b, rng):
    """Place cross-color contamination at region-region boundaries."""
    h, w = clean.shape
    boundary_candidates = []
    for r in range(h):
        for c in range(w):
            v = int(clean[r, c])
            if v not in (color_a, color_b):
                continue
            other = color_b if v == color_a else color_a
            if int(np.sum(_sub3x3(clean, r, c) == other)) >= 1:
                boundary_candidates.append((r, c, v, other))
    rng.shuffle(boundary_candidates)

    placed = 0
    for r, c, host, other in boundary_candidates:
        if placed >= n_at_boundary:
            break
        if inp[r, c] != host:
            continue
        sub_now = _sub3x3(inp, r, c)
        host_count = int(np.sum(sub_now == host))
        other_count = int(np.sum(sub_now == other))
        if host_count < BOUNDARY_MIN_HOST_3x3 or host_count - 1 <= other_count + 1:
            continue
        if _would_form_2x2(inp, r, c, other):
            continue
        if not _neighbor_cleanup_safe(inp, r, c, host, other):
            continue
        inp[r, c] = other
        placed += 1


def _gen_attempt(rng: random.Random) -> np.ndarray | None:
    N = rng.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)
    fg_pool = [c for c in Color.NOT_BLACK if c != Color.TEAL]
    color_a, color_b = rng.sample(fg_pool, 2)

    clean = _build_regions(N, color_a, color_b, rng)
    if clean is None:
        return None

    n_total = rng.randint(DENT_COUNT_MIN, DENT_COUNT_MAX)
    n_a, n_b = n_total // 2, n_total - n_total // 2
    if rng.random() < 0.5:
        n_a, n_b = n_b, n_a

    valid_visible = {color_a: [], color_b: []}
    valid_hidden = {color_a: [], color_b: []}
    h, w = clean.shape
    for r in range(h):
        for c in range(w):
            v = int(clean[r, c])
            if v == color_a and _is_safe_dent_center(clean, r, c, color_a, color_b):
                target = valid_visible if _is_visible_patch_center(clean, r, c, color_a) else valid_hidden
                target[color_a].append((r, c))
            elif v == color_b and _is_safe_dent_center(clean, r, c, color_b, color_a):
                target = valid_visible if _is_visible_patch_center(clean, r, c, color_b) else valid_hidden
                target[color_b].append((r, c))

    if len(valid_visible[color_a]) + len(valid_hidden[color_a]) < n_a:
        return None
    if len(valid_visible[color_b]) + len(valid_hidden[color_b]) < n_b:
        return None

    dents_a = _pick_dent_centers_with_visible(
        valid_visible[color_a], valid_hidden[color_a], n_a, 0, rng
    )
    dents_b = _pick_dent_centers_with_visible(
        valid_visible[color_b], valid_hidden[color_b], n_b, 0, rng
    )
    if dents_a is None or dents_b is None:
        return None

    groups_a = _expand_to_pairs(dents_a, color_a, color_b, clean, dents_a, rng)
    groups_b = _expand_to_pairs(dents_b, color_b, color_a, clean, dents_b, rng)

    inp = clean.copy()
    for cells in groups_a + groups_b:
        for r, c in cells:
            inp[r, c] = 0

    n_noise = rng.randint(NOISE_COUNT_MIN, NOISE_COUNT_MAX)
    n_in_bg = int(round(n_noise * rng.uniform(BG_NOISE_FRAC_MIN, BG_NOISE_FRAC_MAX)))
    _add_bg_noise(inp, clean, n_in_bg, color_a, color_b, rng)
    _add_boundary_noise(inp, clean, n_noise - n_in_bg, color_a, color_b, rng)

    try:
        cleaned_input = _clean_foreground(inp, (color_a, color_b), Color.BLACK)
        centers = _dent_centers(inp, cleaned_input, (color_a, color_b), Color.BLACK)
        output = _render_centers(cleaned_input, centers)
        produced = main(inp)
    except Exception:
        return None
    if len(centers) < DENT_COUNT_MIN:
        return None
    if sum(_center_has_visible_extension(cleaned_input, r, c, host) for r, c, host in centers) < VISIBLE_DENTS_TOTAL_MIN:
        return None
    if not np.array_equal(produced, output):
        return None
    return inp


def generate_input() -> np.ndarray:
    rng = random.Random()
    for _ in range(MAX_GENERATION_ATTEMPTS):
        try:
            grid = _gen_attempt(rng)
        except Exception:
            grid = None
        if grid is not None:
            return grid
    raise RuntimeError("generate_input: failed after %d attempts" % MAX_GENERATION_ATTEMPTS)

            ```

            ### 参考代码: D13/2

            文件: `/home/lixinyu/snap/new/ceshi/code/de809cff/D13/2/code.py`

            ```python
            # Variant of de809cff
# Dimension: D13 — 两种前景色之间的对调映射关系 (meta)
# Change: 固定双色对调：区域A的凹痕用色B填充补丁，区域B的凹痕用色A填充补丁（简单二元交换）... → 单向映射：只有一种区域的凹痕触发变换

from __future__ import annotations

import random
from collections import Counter as _Counter

import numpy as np

from arc_utils import Color

# Design analysis for the D13 variant
# -----------------------------------
# a) concretization_and_trace:
#    - The visible scene is still two large colored regions on black background,
#      with black dents and a small amount of one-cell noise.
#    - The original task treated dents in both colors symmetrically:
#      green dent -> 3x3 yellow patch, yellow dent -> 3x3 green patch.
#    - This variant keeps the opposite-color patch, but only for the active
#      region. The inactive region's dents remain black one-cell (or paired)
#      holes in the output.
#    - To make "region A" observable without using color ids, region A is
#      concretized as the larger cleaned foreground region by visible area.
#      Example: if blue occupies clearly more cells than red, then a black hole
#      inside blue becomes a red 3x3 patch with teal center, while a black hole
#      inside red stays black after cleanup.
# b) complexity_calibration:
#    - The rule change is small but visible: every sample contains dents in both
#      colors, so the output simultaneously shows transformed dents and
#      untouched black dents.
#    - The active/inactive choice is binary and repeated multiple times inside
#      each example, avoiding sparse one-off evidence.
# c) implicit_assumption_review:
#    - `_main_colors(...)` may still identify the two foreground colors, but it
#      can no longer imply that both should be transformed.
#    - `_dent_centers(...)` still detects dents for both hosts; the changed
#      assumption is only in `main(...)`, which must now split dents by active
#      host instead of stamping every detected center.
#    - Starting from `clean.copy()` would incorrectly heal inactive dents unless
#      they are explicitly restored to black after stamping active patches.
# d) placement_legality:
#    - Generator keeps dents globally separated across both colors so an active
#      3x3 patch cannot cover an inactive dent center.
#    - Active and inactive regions both receive several dents, and pair-expansion
#      is allowed only when it preserves the same global spacing constraints.
# e) visual_observability:
#    - The larger region is forced to exceed the smaller by a clear cell-count
#      margin, so humans can see which color is active from the examples.
#    - Both colors appear with multiple dents, making the one-way behavior easy
#      to compare.
# f) visual_cleanliness:
#    - Noise remains one-cell and is cleaned away first, so the decisive visual
#      difference is the presence of teal-marked opposite-color patches versus
#      untouched black holes.
# g) color_mapping_inference:
#    - Only two foreground colors participate, and the mapping is still
#      structured: active color dents map to the other color; inactive color
#      dents do not map at all. No hidden color-id ordering is used.


def _main_colors(g: np.ndarray, bg: int) -> tuple[int, int]:
    colors = [int(c) for c in np.unique(g) if int(c) != int(bg)]
    colors.sort(key=lambda c: int(np.sum(g == c)), reverse=True)
    assert len(colors) >= 2, "expected two foreground colors"
    return int(colors[0]), int(colors[1])


def _has_same_2x2(g: np.ndarray, r: int, c: int, color: int) -> bool:
    h, w = g.shape
    for dr in (-1, 0):
        for dc in (-1, 0):
            rr = int(r) + dr
            cc = int(c) + dc
            if 0 <= rr < h - 1 and 0 <= cc < w - 1:
                if bool(np.all(g[rr : rr + 2, cc : cc + 2] == int(color))):
                    return True
    return False


def _clean_foreground(g: np.ndarray, colors: tuple[int, int], bg: int) -> np.ndarray:
    """
    Remove one-cell specks/protrusions before detecting black dents.

    Two sweeps are enough for the observed corruption pattern: the first removes
    protruding wrong-color cells, the second lets their neighboring true cells
    keep the corrected local majority.
    """
    h, w = g.shape
    a, b = map(int, colors)
    cur = g.copy()

    for _ in range(2):
        nxt = cur.copy()
        for r in range(h):
            for c in range(w):
                v = int(cur[r, c])
                if v not in colors:
                    nxt[r, c] = bg
                    continue

                sub = cur[max(0, r - 1) : min(h, r + 2), max(0, c - 1) : min(w, c + 2)]
                own = int(np.sum(sub == v))
                other = b if v == a else a
                other_count = int(np.sum(sub == other))
                bg_count = int(np.sum(sub == bg))

                if _has_same_2x2(cur, r, c, v):
                    nxt[r, c] = v
                elif other_count > own and other_count >= 5:
                    nxt[r, c] = other
                elif bg_count >= 5 and own <= 4:
                    nxt[r, c] = bg
                elif own <= 2:
                    nxt[r, c] = bg
                else:
                    nxt[r, c] = v
        cur = nxt

    return cur


def _dent_centers(
    original: np.ndarray, clean: np.ndarray, colors: tuple[int, int], bg: int
) -> list[tuple[int, int, int]]:
    h, w = original.shape
    centers: list[tuple[int, int, int]] = []
    for r, c in zip(*np.where(original == int(bg)), strict=False):
        rr = int(r)
        cc = int(c)
        sub = clean[max(0, rr - 1) : min(h, rr + 2), max(0, cc - 1) : min(w, cc + 2)]
        counts = {int(color): int(np.sum(sub == int(color))) for color in colors}
        host = max(colors, key=lambda color: counts[int(color)])
        other = colors[1] if int(host) == int(colors[0]) else colors[0]
        if counts[int(host)] >= 5 and counts[int(host)] > counts[int(other)]:
            centers.append((rr, cc, int(host)))
    return centers


def _active_host_color(clean: np.ndarray, colors: tuple[int, int]) -> int:
    counts = {int(color): int(np.sum(clean == int(color))) for color in colors}
    return max(colors, key=lambda color: counts[int(color)])


def main(grid: np.ndarray) -> np.ndarray:
    """
    Convert dents from only the larger colored region into marked opposite-color patches.

    Input structure:
    - Black background with two large foreground colors and a noticeable size imbalance.
    - Both colored regions can contain black dents, plus a few one-cell specks
      or boundary protrusions that should be cleaned first.

    Rule:
    - First denoise the two foreground regions in the same local way as the
      original task: isolated specks become black and wrong-color protrusions
      near the boundary revert to the surrounding host region.
    - Determine which foreground color owns the larger cleaned area. Only dents
      attributed to that larger region produce a 3x3 patch in the other color.
    - Mark active dent centers with teal (8), but keep dents in the smaller
      region as black holes.

    Key insight: The asymmetry is no longer "every dent swaps to the other
    color"; instead, size decides which color is active, so only the dominant
    region's dents get the opposite-color teal-marked treatment.
    """
    g = np.asarray(grid, dtype=int)
    bg = Color.BLACK
    colors = _main_colors(g, bg)
    clean = _clean_foreground(g, colors, bg)
    active = int(_active_host_color(clean, colors))
    inactive = int(colors[1] if active == int(colors[0]) else colors[0])

    out = clean.copy()
    active_centers: list[tuple[int, int]] = []
    inactive_centers: list[tuple[int, int]] = []
    for r, c, host in _dent_centers(g, clean, colors, bg):
        if int(host) == active:
            active_centers.append((r, c))
        else:
            inactive_centers.append((r, c))

    h, w = g.shape
    for r, c in active_centers:
        out[max(0, r - 1) : min(h, r + 2), max(0, c - 1) : min(w, c + 2)] = inactive

    for r, c in active_centers:
        out[r, c] = Color.TEAL

    for r, c in inactive_centers:
        out[r, c] = bg

    return out


# --------------- generator (cx) ---------------

# --- CFG: canvas & region layout ---
GRID_SIZE_MIN, GRID_SIZE_MAX = 20, 30
RECT_SIZE_FRAC_MIN, RECT_SIZE_FRAC_MAX = 0.45, 0.75
RECT_MARGIN_MAX = 3
MIN_REGION_CELLS = 100
COVERAGE_MIN, COVERAGE_MAX = 0.55, 0.85
ACTIVE_AREA_GAP_MIN = 35
SOLVER_ACTIVE_AREA_GAP_MIN = 20

# --- CFG: dent placement ---
DENT_COUNT_MIN, DENT_COUNT_MAX = 12, 22
MIN_ACTIVE_DENTS = 6
MIN_INACTIVE_DENTS = 4
DENT_MIN_HOST_3x3 = 5
DENT_PATCH_SEPARATION = 3
DENT_PAIR_PROB = 0.13

# --- CFG: noise ---
NOISE_COUNT_MIN, NOISE_COUNT_MAX = 7, 22
BG_NOISE_FRAC_MIN, BG_NOISE_FRAC_MAX = 0.65, 0.85
BG_SPECK_MIN_BG_3x3 = 6
BOUNDARY_MIN_HOST_3x3 = 6

# --- CFG: generation control ---
MAX_GENERATION_ATTEMPTS = 300
CENTER_PICK_ATTEMPTS = 12


def _sub3x3(grid: np.ndarray, r: int, c: int) -> np.ndarray:
    h, w = grid.shape
    return grid[max(0, r - 1) : min(h, r + 2), max(0, c - 1) : min(w, c + 2)]


def _build_regions(N: int, color_a: int, color_b: int, rng: random.Random) -> np.ndarray | None:
    """Paint 2-3 overlapping rectangles (simple occlusion, painter's algorithm)."""
    n_rects = rng.choice([2, 3])
    corners = ["TL", "TR", "BL", "BR"]
    rng.shuffle(corners)
    chosen_corners = corners[:n_rects]

    if n_rects == 2:
        rect_colors = [color_a, color_b]
        rng.shuffle(rect_colors)
    else:
        first = rng.choice([color_a, color_b])
        mid = color_b if first == color_a else color_a
        rect_colors = [first, mid, first]

    def _make_rect(corner: str) -> tuple[int, int, int, int]:
        h = rng.randint(int(N * RECT_SIZE_FRAC_MIN), int(N * RECT_SIZE_FRAC_MAX))
        w = rng.randint(int(N * RECT_SIZE_FRAC_MIN), int(N * RECT_SIZE_FRAC_MAX))
        m = rng.randint(0, RECT_MARGIN_MAX)
        r0 = m if corner[0] == "T" else max(0, N - h - m)
        c0 = m if corner[1] == "L" else max(0, N - w - m)
        return r0, c0, min(N, r0 + h), min(N, c0 + w)

    grid = np.zeros((N, N), dtype=int)
    for corner, color in zip(chosen_corners, rect_colors):
        r0, c0, r1, c1 = _make_rect(corner)
        grid[r0:r1, c0:c1] = color

    cnt_a = int(np.sum(grid == color_a))
    cnt_b = int(np.sum(grid == color_b))
    if cnt_a < MIN_REGION_CELLS or cnt_b < MIN_REGION_CELLS:
        return None
    coverage = (cnt_a + cnt_b) / (N * N)
    if not (COVERAGE_MIN <= coverage <= COVERAGE_MAX):
        return None
    if n_rects == 3:
        from scipy.ndimage import label

        _, n_components = label(grid == rect_colors[0])
        if n_components < 2:
            return None
    return grid


def _is_safe_dent_center(grid: np.ndarray, r: int, c: int, host: int, other: int) -> bool:
    """After setting (r,c) to black, the solver must detect it as a dent in host region."""
    if grid[r, c] != host:
        return False
    sub = _sub3x3(grid, r, c)
    host_count = int(np.sum(sub == host)) - 1
    return host_count >= DENT_MIN_HOST_3x3 and host_count > int(np.sum(sub == other))


def _would_form_2x2(grid: np.ndarray, r: int, c: int, color: int) -> bool:
    h, w = grid.shape
    for dr in (-1, 0):
        for dc in (-1, 0):
            rr, cc = r + dr, c + dc
            if 0 <= rr < h - 1 and 0 <= cc < w - 1:
                block = grid[rr : rr + 2, cc : cc + 2].copy()
                block[r - rr, c - cc] = color
                if int(np.sum(block == color)) == 4:
                    return True
    return False


def _far_enough(r: int, c: int, others: list[tuple[int, int]]) -> bool:
    return all(max(abs(r - rr), abs(c - cc)) >= DENT_PATCH_SEPARATION for rr, cc in others)


def _pick_dent_centers(
    candidates: list[tuple[int, int]],
    n: int,
    rng: random.Random,
    blocked: list[tuple[int, int]] | None = None,
) -> list[tuple[int, int]] | None:
    """Select n dent centers with global Chebyshev separation."""
    pool = list(candidates)
    rng.shuffle(pool)
    chosen: list[tuple[int, int]] = []
    blocked = [] if blocked is None else list(blocked)
    for r, c in pool:
        if _far_enough(r, c, chosen) and _far_enough(r, c, blocked):
            chosen.append((r, c))
            if len(chosen) >= n:
                return chosen
    return None


def _expand_to_pairs(
    dents: list[tuple[int, int]],
    host: int,
    other: int,
    clean: np.ndarray,
    blocked_centers: list[tuple[int, int]],
    rng: random.Random,
) -> list[list[tuple[int, int]]]:
    """Optionally expand single-cell dents into 2-cell adjacent pairs."""
    h, w = clean.shape
    result: list[list[tuple[int, int]]] = []
    for r, c in dents:
        cells = [(r, c)]
        if rng.random() < DENT_PAIR_PROB:
            neighbors = [(r + 1, c), (r - 1, c), (r, c + 1), (r, c - 1)]
            rng.shuffle(neighbors)
            for nr, nc in neighbors:
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                if clean[nr, nc] != host or not _is_safe_dent_center(clean, nr, nc, host, other):
                    continue
                if any((nr, nc) == center for center in blocked_centers if center != (r, c)):
                    continue
                if not _far_enough(nr, nc, [center for center in blocked_centers if center != (r, c)]):
                    continue
                cells.append((nr, nc))
                break
        result.append(cells)
    return result


def _build_output(
    clean: np.ndarray,
    active_groups: list[list[tuple[int, int]]],
    inactive_groups: list[list[tuple[int, int]]],
    inactive_color: int,
) -> np.ndarray:
    """Build expected output for the one-way mapping variant."""
    h, w = clean.shape
    output = clean.copy()
    for cells in active_groups:
        for r, c in cells:
            output[max(0, r - 1) : min(h, r + 2), max(0, c - 1) : min(w, c + 2)] = inactive_color
    for cells in active_groups:
        for r, c in cells:
            output[r, c] = Color.TEAL
    for cells in inactive_groups:
        for r, c in cells:
            output[r, c] = Color.BLACK
    return output


def _add_bg_noise(inp: np.ndarray, clean: np.ndarray, n_in_bg: int, color_a: int, color_b: int, rng: random.Random) -> None:
    """Place isolated fg-color specks in background area."""
    bg_candidates = list(zip(*np.where(clean == 0), strict=False))
    rng.shuffle(bg_candidates)

    placed = 0
    for r_, c_ in bg_candidates:
        if placed >= n_in_bg:
            break
        r, c = int(r_), int(c_)
        sub = _sub3x3(inp, r, c)
        if int(np.sum(sub == 0)) < BG_SPECK_MIN_BG_3x3:
            continue
        nearby = _sub3x3(clean, r, c)
        nearby_fg = [int(x) for x in nearby.flat if int(x) != 0]
        speck_color = _Counter(nearby_fg).most_common(1)[0][0] if nearby_fg else rng.choice([color_a, color_b])
        inp[r, c] = speck_color
        placed += 1


def _neighbor_cleanup_safe(inp: np.ndarray, r: int, c: int, host: int, other: int) -> bool:
    """Check that changing (r,c) to `other` won't cause the solver to misclassify any neighbor."""
    h, w = inp.shape
    for dr in (-1, 0, 1):
        for dc in (-1, 0, 1):
            if dr == 0 and dc == 0:
                continue
            nr, nc = r + dr, c + dc
            if not (0 <= nr < h and 0 <= nc < w) or inp[nr, nc] != host:
                continue
            nsub = _sub3x3(inp, nr, nc).copy()
            nr0, nc0 = max(0, nr - 1), max(0, nc - 1)
            nsub[r - nr0, c - nc0] = other
            own_n = int(np.sum(nsub == host))
            other_n = int(np.sum(nsub == other))
            bg_n = int(np.sum(nsub == 0))
            if (other_n > own_n and other_n >= 5) or own_n <= 2 or (bg_n >= 5 and own_n <= 4):
                return False
    return True


def _add_boundary_noise(inp: np.ndarray, clean: np.ndarray, n_at_boundary: int, color_a: int, color_b: int, rng: random.Random) -> None:
    """Place cross-color contamination at region-region boundaries."""
    h, w = clean.shape
    boundary_candidates = []
    for r in range(h):
        for c in range(w):
            v = int(clean[r, c])
            if v not in (color_a, color_b):
                continue
            other = color_b if v == color_a else color_a
            if int(np.sum(_sub3x3(clean, r, c) == other)) >= 1:
                boundary_candidates.append((r, c, v, other))
    rng.shuffle(boundary_candidates)

    placed = 0
    for r, c, host, other in boundary_candidates:
        if placed >= n_at_boundary:
            break
        if inp[r, c] != host:
            continue
        sub_now = _sub3x3(inp, r, c)
        host_count = int(np.sum(sub_now == host))
        other_count = int(np.sum(sub_now == other))
        if host_count < BOUNDARY_MIN_HOST_3x3 or host_count - 1 <= other_count + 1:
            continue
        if _would_form_2x2(inp, r, c, other):
            continue
        if not _neighbor_cleanup_safe(inp, r, c, host, other):
            continue
        inp[r, c] = other
        placed += 1


def _gen_attempt(rng: random.Random) -> np.ndarray | None:
    N = rng.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)
    fg_pool = [c for c in Color.NOT_BLACK if c != Color.TEAL]
    color_a, color_b = rng.sample(fg_pool, 2)

    clean = _build_regions(N, color_a, color_b, rng)
    if clean is None:
        return None

    counts = {color_a: int(np.sum(clean == color_a)), color_b: int(np.sum(clean == color_b))}
    if abs(counts[color_a] - counts[color_b]) < ACTIVE_AREA_GAP_MIN:
        return None
    active_color = max((color_a, color_b), key=lambda color: counts[color])
    inactive_color = color_b if active_color == color_a else color_a

    n_total = rng.randint(DENT_COUNT_MIN, DENT_COUNT_MAX)
    n_active_min = max(MIN_ACTIVE_DENTS, n_total // 2)
    n_active_max = n_total - MIN_INACTIVE_DENTS
    if n_active_min > n_active_max:
        return None
    n_active = rng.randint(n_active_min, n_active_max)
    n_inactive = n_total - n_active

    h, w = clean.shape
    valid = {color_a: [], color_b: []}
    for r in range(h):
        for c in range(w):
            v = int(clean[r, c])
            if v == color_a and _is_safe_dent_center(clean, r, c, color_a, color_b):
                valid[color_a].append((r, c))
            elif v == color_b and _is_safe_dent_center(clean, r, c, color_b, color_a):
                valid[color_b].append((r, c))

    if len(valid[active_color]) < n_active + 2 or len(valid[inactive_color]) < n_inactive + 2:
        return None

    dents_active = None
    dents_inactive = None
    for _ in range(CENTER_PICK_ATTEMPTS):
        dents_active = _pick_dent_centers(valid[active_color], n_active, rng)
        if dents_active is None:
            continue
        dents_inactive = _pick_dent_centers(valid[inactive_color], n_inactive, rng, blocked=dents_active)
        if dents_inactive is not None:
            break
    if dents_active is None or dents_inactive is None:
        return None

    blocked_centers = dents_active + dents_inactive
    active_groups = _expand_to_pairs(dents_active, active_color, inactive_color, clean, blocked_centers, rng)
    inactive_groups = _expand_to_pairs(dents_inactive, inactive_color, active_color, clean, blocked_centers, rng)

    output = _build_output(clean, active_groups, inactive_groups, inactive_color)

    inp = clean.copy()
    for cells in active_groups + inactive_groups:
        for r, c in cells:
            inp[r, c] = 0

    n_noise = rng.randint(NOISE_COUNT_MIN, NOISE_COUNT_MAX)
    n_in_bg = int(round(n_noise * rng.uniform(BG_NOISE_FRAC_MIN, BG_NOISE_FRAC_MAX)))
    _add_bg_noise(inp, clean, n_in_bg, color_a, color_b, rng)
    _add_boundary_noise(inp, clean, n_noise - n_in_bg, color_a, color_b, rng)

    # The solver chooses the active region after dents are blackened and noise
    # is cleaned. Keep that visible ordering explicit instead of relying only on
    # the final oracle comparison.
    solver_clean = _clean_foreground(inp, (color_a, color_b), Color.BLACK)
    resolved_active = int(_active_host_color(solver_clean, (color_a, color_b)))
    resolved_inactive = int(color_b if resolved_active == color_a else color_a)
    if resolved_active != int(active_color):
        return None
    if abs(int(np.sum(solver_clean == resolved_active)) - int(np.sum(solver_clean == resolved_inactive))) < SOLVER_ACTIVE_AREA_GAP_MIN:
        return None
    solver_centers = _dent_centers(inp, solver_clean, (color_a, color_b), Color.BLACK)
    resolved_active_count = sum(int(host == resolved_active) for _r, _c, host in solver_centers)
    resolved_inactive_count = sum(int(host == resolved_inactive) for _r, _c, host in solver_centers)
    if resolved_active_count < MIN_ACTIVE_DENTS or resolved_inactive_count < MIN_INACTIVE_DENTS:
        return None

    try:
        produced = main(inp)
    except Exception:
        return None
    if not np.array_equal(produced, output):
        return None
    return inp


def generate_input() -> np.ndarray:
    rng = random.Random()
    for _ in range(MAX_GENERATION_ATTEMPTS):
        try:
            grid = _gen_attempt(rng)
        except Exception:
            grid = None
        if grid is not None:
            return grid
    raise RuntimeError("generate_input: failed after %d attempts" % MAX_GENERATION_ATTEMPTS)

            ```

    ## 你的任务

    1. **理解原代码**: 弄清 `main()` 和 `generate_input()` 的逻辑。

    2. **阅读参考代码**（如有）: 上面列出的已有单变体代码是各组成项单独实现的版本，帮助你理解每项变更的实现方式。融合版本应综合参考但不能简单拼接。

