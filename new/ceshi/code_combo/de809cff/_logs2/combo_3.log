+    if np.array_equal(combo_output, same_side_bidir_output):
+        return None
+    if np.array_equal(combo_output, one_way_opposite_output):
+        return None
+
+    try:
+        produced = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(produced, combo_output):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
