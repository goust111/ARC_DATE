+    if not _all_groups_present(inp, true_clean, (color_a, color_b), expected_groups):
+        return None
+
+    output = _stamp_dent_groups(true_clean, groups_a, groups_b, color_a, color_b)
+
+    try:
+        produced = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(produced, output):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(MAX_GENERATION_ATTEMPTS):
