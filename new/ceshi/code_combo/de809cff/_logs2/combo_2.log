    inp=canon.copy(); dent_cells={cell for cells,_ in ga+gb for cell in cells}
    for cells,_ in ga+gb:
        for r,c in cells: inp[r,c]=0
    n_noise=rng.randint(mod.NOISE_COUNT_MIN, mod.NOISE_COUNT_MAX)
    n_in_bg=int(round(n_noise * rng.uniform(mod.BG_NOISE_FRAC_MIN, mod.BG_NOISE_FRAC_MAX)))
    mod._add_bg_noise(inp, canon, n_in_bg, a, b, dent_cells, rng)
    mod._add_boundary_noise(inp, canon, n_noise-n_in_bg, a, b, dent_cells, rng)
    produced=mod.main(inp)
    if not np.array_equal(produced,out): reasons['oracle']+=1; continue
    reasons['success']+=1
print(reasons)
