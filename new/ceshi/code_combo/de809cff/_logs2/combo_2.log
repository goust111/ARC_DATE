+        n_a, n_b = n_b, n_a
+
+    availability = {
+        color_a: {
+            "horizontal": len(_enumerate_pair_candidates(clean, color_a, color_b, "horizontal")),
+            "vertical": len(_enumerate_pair_candidates(clean, color_a, color_b, "vertical")),
+        },
+        color_b: {
+            "horizontal": len(_enumerate_pair_candidates(clean, color_b, color_a, "horizontal")),
+            "vertical": len(_enumerate_pair_candidates(clean, color_b, color_a, "vertical")),
+        },
