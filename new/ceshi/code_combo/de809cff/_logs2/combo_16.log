+def _cluster_variants(shape: list[tuple[int, int]]) -> list[list[tuple[int, int]]]:
+    variants = set()
+    pts = np.array(shape, dtype=int)
+    for flip in (1, -1):
+        work = pts.copy()
+        work[:, 1] *= flip
+        for _ in range(4):
+            norm = work.copy()
+            for anchor_r, anchor_c in norm:
