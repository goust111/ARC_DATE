+        k: sum((_cluster_variants(shape) for shape in shapes), [])
+        for k, shapes in _CLUSTER_SHAPES.items()
+    }
+
+    for size in sizes:
+        anchors = candidates[:]
+        rng.shuffle(anchors)
+        for ar, ac in anchors:
+            for offsets in rng.sample(shape_bank[size], k=len(shape_bank[size])):
+                if (0, 0) not in offsets:
+                    continue
+                cells = [(int(ar + dr), int(ac + dc)) for dr, dc in offsets]
+                if len(set(cells)) != len(cells):
+                    continue
+                if not all(0 <= r < clean.shape[0] and 0 <= c < clean.shape[1] for r, c in cells):
