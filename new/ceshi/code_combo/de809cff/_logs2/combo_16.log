+# --- CFG: noise ---
+NOISE_COUNT_MIN, NOISE_COUNT_MAX = 6, 14
+BG_NOISE_FRAC_MIN, BG_NOISE_FRAC_MAX = 0.60, 0.82
+BG_SPECK_MIN_BG_3x3 = 6
+BOUNDARY_MIN_HOST_3x3 = 6
