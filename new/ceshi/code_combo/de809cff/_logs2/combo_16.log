+    return None
+
+
+def _place_clusters(clean: np.ndarray, color_a: int, color_b: int, rng: random.Random) -> list[tuple[int, int]]:
+    n_clusters = rng.randint(CLUSTER_COUNT_MIN, CLUSTER_COUNT_MAX)
