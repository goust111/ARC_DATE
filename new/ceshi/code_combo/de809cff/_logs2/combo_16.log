+
+    if not touches_other:
+        return False
+
+    spawned = 0
+    for r, c in cells:
+        for rr in range(max(0, r - 1), min(clean.shape[0], r + 2)):
+            for cc in range(max(0, c - 1), min(clean.shape[1], c + 2)):
+                if int(clean[rr, cc]) == int(other) and _host_supported(clean, rr, cc, other, host):
+                    spawned += 1
+    return spawned >= 1
+
+
+def _cluster_variants(shape: list[tuple[int, int]]) -> list[list[tuple[int, int]]]:
+    variants = set()
+    pts = np.array(shape, dtype=int)
+    for flip in (1, -1):
+        work = pts.copy()
+        work[:, 1] *= flip
+        for _ in range(4):
+            norm = work.copy()
+            for anchor_r, anchor_c in norm:
+                shifted = norm.copy()
+                shifted[:, 0] -= int(anchor_r)
+                shifted[:, 1] -= int(anchor_c)
+                variants.add(tuple(sorted((int(r), int(c)) for r, c in shifted)))
+            work = np.stack([work[:, 1], -work[:, 0]], axis=1)
+    return [list(v) for v in sorted(variants)]
+
+
+_SHAPE_BANK: dict[int, list[list[tuple[int, int]]]] = {
+    k: sum((_cluster_variants(shape) for shape in shapes), [])
+    for k, shapes in _CLUSTER_SHAPES.items()
+}
+
+
+def _boundary_candidates(clean: np.ndarray, host: int, other: int) -> list[tuple[int, int]]:
+    h, w = clean.shape
+    out = []
+    for r in range(h):
+        for c in range(w):
+            if int(clean[r, c]) != int(host):
+                continue
+            if not _host_supported(clean, r, c, host, other):
+                continue
+            if int(np.sum(_sub3x3(clean, r, c) == other)) == 0:
+                continue
+            out.append((r, c))
+    return out
+
+
+def _try_place_cluster(
+    clean: np.ndarray,
+    dent_cells: set[tuple[int, int]],
+    occupied: set[tuple[int, int]],
+    host: int,
+    other: int,
+    rng: random.Random,
+) -> list[tuple[int, int]] | None:
+    candidates = _boundary_candidates(clean, host, other)
+    rng.shuffle(candidates)
+    sizes = CLUSTER_SIZE_CHOICES[:]
+    rng.shuffle(sizes)
+
+    for size in sizes:
+        anchors = candidates[:]
+        rng.shuffle(anchors)
+        for ar, ac in anchors:
+            bank = _SHAPE_BANK[size][:]
+            rng.shuffle(bank)
+            for offsets in bank:
+                if (0, 0) not in offsets:
+                    continue
+                cells = [(int(ar + dr), int(ac + dc)) for dr, dc in offsets]
+                if len(set(cells)) != len(cells):
+                    continue
+                if not all(0 <= r < clean.shape[0] and 0 <= c < clean.shape[1] for r, c in cells):
+                    continue
+                if not _cluster_far_enough(cells, occupied):
+                    continue
+                if not _cluster_supported(clean, dent_cells, cells, host, other):
+                    continue
+                return sorted(cells)
+    return None
+
+
+def _place_clusters(clean: np.ndarray, color_a: int, color_b: int, rng: random.Random) -> list[tuple[int, int]]:
+    n_clusters = rng.randint(CLUSTER_COUNT_MIN, CLUSTER_COUNT_MAX)
+    order = [color_a, color_b] * ((n_clusters + 1) // 2)
+    order = order[:n_clusters]
+    rng.shuffle(order)
+    if color_a not in order:
+        order[0] = color_a
+    if color_b not in order:
+        order[-1] = color_b
+
+    dent_cells: set[tuple[int, int]] = set()
+    occupied: set[tuple[int, int]] = set()
+    clusters_by_host = {color_a: 0, color_b: 0}
+
+    for host in order:
+        other = color_b if host == color_a else color_a
+        cluster = _try_place_cluster(clean, dent_cells, occupied, host, other, rng)
+        if cluster is None:
+            return []
+        for cell in cluster:
+            dent_cells.add(cell)
+            occupied.add(cell)
+        clusters_by_host[host] += 1
+
+    if min(clusters_by_host.values()) == 0:
+        return []
+    return sorted(dent_cells)
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    N = rng.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)
+    fg_pool = [c for c in Color.NOT_BLACK if c != Color.TEAL]
+    color_a, color_b = rng.sample(fg_pool, 2)
+
+    clean = _build_regions(N, color_a, color_b, rng)
+    if clean is None:
+        return None
+
+    dents = _place_clusters(clean, color_a, color_b, rng)
+    if not dents:
+        return None
+
+    inp = clean.copy()
+    for r, c in dents:
+        inp[r, c] = 0
+
+    n_noise = rng.randint(NOISE_COUNT_MIN, NOISE_COUNT_MAX)
+    n_in_bg = int(round(n_noise * rng.uniform(BG_NOISE_FRAC_MIN, BG_NOISE_FRAC_MAX)))
+    _add_bg_noise(inp, clean, n_in_bg, color_a, color_b, rng)
+    _add_boundary_noise(inp, clean, n_noise - n_in_bg, color_a, color_b, rng)
+
+    try:
+        info = _analyze(inp)
+    except Exception:
+        return None
+
+    if len(info["initial_centers"]) != len(dents):
+        return None
+    if int(info["secondary_centers"]) < MIN_SECONDARY_CENTERS:
+        return None
+    if int(info["max_wave"]) < 1:
+        return None
+    if int(info["delta_vs_single"]) < MIN_CHAIN_DELTA:
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        try:
+            grid = _gen_attempt(rng)
+        except Exception:
+            grid = None
+        if grid is not None:
+            return grid
+    raise RuntimeError(f"generate_input: failed after {MAX_GENERATION_ATTEMPTS} attempts")

