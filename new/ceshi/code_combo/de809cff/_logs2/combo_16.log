+            if int(clean[r, c]) != int(host):
+                continue
+            if not _host_supported(clean, r, c, host, other):
+                continue
+            if int(np.sum(_sub3x3(clean, r, c) == other)) == 0:
+                continue
+            out.append((r, c))
+    return out
+
