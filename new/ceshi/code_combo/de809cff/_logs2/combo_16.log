+# --- CFG: clustered dents ---
+CLUSTER_COUNT_MIN, CLUSTER_COUNT_MAX = 4, 6
+CLUSTER_SIZE_CHOICES = [2, 3, 3, 4]
+CLUSTER_GAP = 4
+MIN_CHAIN_DELTA = 6
+MIN_SECONDARY_CENTERS = 3
