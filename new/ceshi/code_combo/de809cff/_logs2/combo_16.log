+                continue
+            if not _host_supported(clean, r, c, host, other):
+                continue
+            sub5 = clean[max(0, r - 2) : min(h, r + 3), max(0, c - 2) : min(w, c + 3)]
+            if int(np.sum(sub5 == other)) == 0:
