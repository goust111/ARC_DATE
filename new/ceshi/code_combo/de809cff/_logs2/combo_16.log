+    if int(info["secondary_centers"]) < MIN_SECONDARY_CENTERS:
+        return None
+    if int(info["max_wave"]) < 1:
+        return None
+    if int(info["delta_vs_single"]) < MIN_CHAIN_DELTA:
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
