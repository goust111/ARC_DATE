+
+
+def _add_bg_noise(
+    inp: np.ndarray,
+    clean: np.ndarray,
+    n_in_bg: int,
+    color_a: int,
+    color_b: int,
+    rng: random.Random,
+) -> None:
+    bg_candidates = list(zip(*np.where(clean == 0), strict=False))
+    rng.shuffle(bg_candidates)
+
+    placed = 0
+    for r_, c_ in bg_candidates:
+        if placed >= n_in_bg:
+            break
+        r, c = int(r_), int(c_)
+        sub = _sub3x3(inp, r, c)
+        if int(np.sum(sub == 0)) < BG_SPECK_MIN_BG_3x3:
