+
+
+def _plan_shape_counts(n_total: int, rng: random.Random) -> dict[str, int]:
+    pair_total = rng.randint(PAIR_GROUP_COUNT_MIN, min(PAIR_GROUP_COUNT_MAX, n_total - 4))
