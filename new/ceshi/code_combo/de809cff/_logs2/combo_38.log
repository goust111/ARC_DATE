+    group_b: tuple[list[tuple[int, int]], int, str],
+) -> int:
+    cells_a, _host_a, _shape_a = group_a
+    cells_b, _host_b, _shape_b = group_b
+    return min(
+        max(abs(int(r0) - int(r1)), abs(int(c0) - int(c1)))
