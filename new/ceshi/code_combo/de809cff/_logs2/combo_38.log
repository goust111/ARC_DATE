+        remaining_by_shape[str(group[2])] -= 1
+
+    vertical_seed = _find_collision_pair(
+        clean,
+        colors,
+        candidates["single"],
+        candidates["vertical"],
+        selected,
+        remaining_by_color,
+        rng,
