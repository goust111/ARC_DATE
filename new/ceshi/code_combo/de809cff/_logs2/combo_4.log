            run = 1
            for a, b in zip(idxs, idxs[1:]):
                if b == a + 1:
                    run += 1
                else:
                    if run >= mod.LINE_LEN_MIN:
                        cover += run
                    run = 1
            if run >= mod.LINE_LEN_MIN:
                cover += run
        if cover > best:
            best = cover
            best_dir = (dr, dc)
    return best / len(pts), best_dir

maroons = []
line_ratios = []
dent_counts = []
