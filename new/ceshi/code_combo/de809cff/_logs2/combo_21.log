+        or clip_b < target_clip_b
+        or interior_a < MIN_INTERIOR_DENTS_PER_COLOR
+        or interior_b < MIN_INTERIOR_DENTS_PER_COLOR
+        or shared_a < MIN_SHARED_CLIPPED_PER_COLOR
