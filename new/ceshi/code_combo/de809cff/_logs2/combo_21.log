+
+
+def _cross_cells(shape: tuple[int, int], r: int, c: int) -> list[tuple[int, int]]:
+    h, w = map(int, shape)
+    cells: list[tuple[int, int]] = []
+    for dr, dc in ((0, 0), (-1, 0), (1, 0), (0, -1), (0, 1)):
+        rr = int(r) + dr
+        cc = int(c) + dc
+        if 0 <= rr < h and 0 <= cc < w:
+            cells.append((rr, cc))
