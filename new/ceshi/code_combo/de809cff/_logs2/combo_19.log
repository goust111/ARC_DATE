+# Combo variant of de809cff (index 19)
+# combo_spec: D10/2+D12/0
+# Name: 多像素凹痕连通区域+补丁大小由凹痕总数决定
+
+from __future__ import annotations
+
+import random
+from collections import Counter as _Counter
+
+import numpy as np
+
+from arc_utils import Color
