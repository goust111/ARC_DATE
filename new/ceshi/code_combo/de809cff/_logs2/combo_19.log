+    dents_a = _place_dents_for_color(
+        clean, color_a, target_counts[color_a], LOW_CENTER_SEP if target_counts[color_a] == low_count else HIGH_CENTER_SEP, rng
+    )
+    dents_b = _place_dents_for_color(
