+        return None
+    coverage = (cnt_a + cnt_b) / (N * N)
+    if not (COVERAGE_MIN <= coverage <= COVERAGE_MAX):
+        return None
+    return grid
+
+
+def _window_all_color(grid: np.ndarray, r: int, c: int, radius: int, color: int) -> bool:
