+
+
+def _add_boundary_noise(
+    inp: np.ndarray,
+    clean: np.ndarray,
+    colors: tuple[int, int],
+    n_noise: int,
+    protected: set[tuple[int, int]],
+    rng: random.Random,
+) -> int:
+    color_a, color_b = map(int, colors)
+    h, w = clean.shape
