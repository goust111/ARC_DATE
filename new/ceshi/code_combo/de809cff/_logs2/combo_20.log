+
+def _expand_to_pairs(
+    dents: list[tuple[int, int]],
+    host: int,
+    other: int,
+    clean: np.ndarray,
+    all_reserved: list[tuple[int, int]],
+    rng: random.Random,
+) -> list[list[tuple[int, int]]]:
+    h, w = clean.shape
+    reserved = list(all_reserved)
+    result: list[list[tuple[int, int]]] = []
+    for r, c in dents:
+        cells = [(int(r), int(c))]
