+
+def _quadrant(shape: tuple[int, int], r: int, c: int) -> str:
+    h, w = shape
+    top = r < h // 2
+    left = c < w // 2
+    if top and left:
+        return "tl"
+    if top and not left:
+        return "tr"
+    if not top and left:
+        return "bl"
+    return "br"
+
+
+def _quadrant_rotation_k(shape: tuple[int, int], r: int, c: int) -> int:
+    quadrant = _quadrant(shape, r, c)
+    if quadrant == "tl":
+        return 0
+    if quadrant == "tr":
