+    if quadrant == "bl":
+        return 1
+    return 2
+
+
+def _effective_rotation_k(
+    shape: tuple[int, int],
+    r: int,
+    c: int,
+    marker_color: int,
+    *,
+    use_intrinsic_rotation: bool,
