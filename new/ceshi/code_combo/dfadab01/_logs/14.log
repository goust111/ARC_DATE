    spec:
  grid: 10x10 or 20x20 [observed]; must accommodate marker_grid_rows * row_spacing + glyph_size(4)
  glyph_alphabet:
    fixed 4x4 patterns, each 8 filled pixels out of 16:
      marker 2 (red) -> color 4 (yellow) solid frame
      marker 3 (green) -> color 1 (blue) open ring
      marker 5 (gray) -> color 6 (magenta) diagonal blocks
      marker 8 (azure) -> color 7 (orange) X-shape
  marker_grid:
    markers placed on a regular grid of positions (rows x cols)
    shape: 2x2 to 5x5; rows and cols chosen independently
    row_spacing: 4-6, uniform within example [observed]
    col_spacing: 4-6, may be non-uniform across columns
    fill_rate: 60-100% of grid cells contain a marker; unfilled cells are empty (black)
