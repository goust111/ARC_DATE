+    if h < 12 or w < 12 or np.random.rand() < 0.35:
+        return
+
+    legend_color = int(np.random.choice(sorted(used_colors)))
+    for _ in range(100):
+        r0 = int(np.random.randint(0, h - 4))
+        c0 = int(np.random.randint(0, w - 4))
+        if not _can_place_legend(grid, marker_coords, r0, c0):
+            continue
