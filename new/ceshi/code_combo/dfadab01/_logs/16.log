+    inner_micro = MICRO_GLYPHS[inner_marker]
+
+    pattern = np.zeros((4, 4), dtype=int)
+    pattern[outer_mask] = outer_color
+    pattern[1:3, 1:3][inner_micro] = inner_color
+    return pattern
+
