+
+                    edge_occ.update(ctrl_cells)
+                    visible_boxes.append(legend_box)
+                    placements.append((color, channel, r0, c0, True))
+                    used_channels[color].add(channel)
+                    legend_added = True
+                    break
+                if legend_added:
