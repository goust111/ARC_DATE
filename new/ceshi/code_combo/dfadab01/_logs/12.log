GLYPH_SIZE = 4
MARKER_COLORS = (2, 3, 5, 8)
GLYPH_COLORS = (1, 4, 6, 7)
ALLOWED_COLORS = {0, *MARKER_COLORS, *GLYPH_COLORS}
MAX_RETRIES = 400

