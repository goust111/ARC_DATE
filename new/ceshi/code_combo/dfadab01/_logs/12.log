+                    if any(cell in edge_occ for cell in ctrl_cells):
+                        continue
+                    legend_box = (r0, c0, r0 + GLYPH_SIZE - 1, c0 + GLYPH_SIZE - 1)
+                    if any(_bbox_overlaps(legend_box, other) for other in visible_boxes):
