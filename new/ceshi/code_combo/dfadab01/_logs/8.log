+        if i == 0:
+            donors.append(1)
+            continue
+        if i == len(scalars) - 1:
+            donors.append(len(scalars) - 2)
+            continue
+        prev_gap = scalars[i] - scalars[i - 1]
+        next_gap = scalars[i + 1] - scalars[i]
+        assert prev_gap >= 4 and next_gap >= 4
+        if prev_gap < next_gap:
+            donors.append(i - 1)
+        elif next_gap < prev_gap:
+            donors.append(i + 1)
+        else:
