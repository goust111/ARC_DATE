+def _collect_real_markers(g: np.ndarray) -> list[tuple[int, int, int]]:
+    markers: list[tuple[int, int, int]] = []
+    for r, c in np.argwhere(np.isin(g, MARKER_COLORS)):
+        rr = int(r)
+        cc = int(c)
+        marker_color = int(g[rr, cc])
