+        picks = random.sample(range(GLYPH_SIZE * GLYPH_SIZE), GLYPH_AREA)
+        mask = np.zeros((GLYPH_SIZE, GLYPH_SIZE), dtype=bool)
+        for idx in picks:
+            mask[idx // GLYPH_SIZE, idx % GLYPH_SIZE] = True
+        if not _mask_connected(mask):
