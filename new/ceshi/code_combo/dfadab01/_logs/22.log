        _paint_clipped(out, r, c, color_map[marker_color], mask)
    return out


def _build_input(
    base_mask: np.ndarray,
    rotation_map: dict[int, int],
    color_map: dict[int, int],
    real_markers: list[tuple[int, int, int]],
) -> np.ndarray:
