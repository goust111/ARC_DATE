+                for i in range(4)
+                for j in range(i + 1, 4)
+            ),
+        }
+        return inp, out, meta
+
+    raise RuntimeError(f"failed to generate a valid combo instance after {MAX_GEN_ATTEMPTS} attempts")
+
+
+def generate_input() -> np.ndarray:
+    inp, _, _ = _build_case()
+    return inp
+
+
+def generate_pair() -> tuple[np.ndarray, np.ndarray]:
