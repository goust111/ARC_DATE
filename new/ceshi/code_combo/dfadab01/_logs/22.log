+        g[r0 + GLYPH_SIZE, LEGEND_LABEL_COL] = marker_color
+
+    for r, c, marker_color in real_markers:
+        g[r, c] = marker_color
+    return g
+
+
+def _build_case() -> tuple[np.ndarray, np.ndarray, dict[str, object]]:
