+            if _has_source_glyph(g, rr - 4, cc - 4, glyph_color, mask):
+                legends.append((rr, cc, marker_color, glyph_color, mask))
+    return legends
+
+
+def _prepare_scene(g: np.ndarray, erase_legend: bool) -> tuple[np.ndarray, list[tuple[int, int, int, np.ndarray]]]:
+    work = g.copy()
