+GRID_SHAPE = (20, 20)
+ROW_COUNT_CHOICES = [2, 3]
+COL_COUNT_CHOICES = [2, 3, 4]
+SPACING_CHOICES = [4, 5, 6]
+MIN_FILL_RATE = 0.6
+MAX_RETRIES = 500
+ALLOWED_COLORS = {0, *GLYPHS.keys(), 1, 4, 6, 7}
