   346	    h, w = inp.shape
   347	    rr0 = max(0, r0 - 1)
   348	    cc0 = max(0, c0 - 1)
   349	    rr1 = min(h, r0 + size + 1)
   350	    cc1 = min(w, c0 + size + 1)
   351	    patch = inp[rr0:rr1, cc0:cc1]
   352	    if not np.any(patch == color):
   353	        return False
   354	    mask = np.ones_like(patch, dtype=bool)
   355	    mask[r0 - rr0 : r0 - rr0 + size, c0 - cc0 : c0 - cc0 + size] = False
   356	    return bool(np.any(patch[mask] == color))
