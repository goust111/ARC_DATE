   358	
   359	def _try_add_legend(
   360	    rng: random.Random,
   361	    inp: np.ndarray,
   362	    expected: np.ndarray,
   363	    used_marker_colors: set[int],
   364	) -> bool:
   365	    if not used_marker_colors or rng.random() >= LEGEND_PROB:
   366	        return False
   367	
   368	    h, w = inp.shape
   369	    candidates: list[tuple[int, int, int]] = []
