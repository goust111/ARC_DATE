+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        size = rng.choice(GRID_SIZES)
+        max_axis_count = 3
+        row_count = rng.randint(2, max_axis_count)
+        col_count = rng.randint(2, max_axis_count)
