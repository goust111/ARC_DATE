+    min_fill = max(
+        len(used_colors) * 2,
+        int(np.ceil(cell_count * random.uniform(*FILL_RATE_RANGE))),
+    )
+    min_fill = min(cell_count, max(len(used_colors), min_fill))
+    fill_count = random.randint(min_fill, cell_count)
