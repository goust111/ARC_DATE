+
+def _assign_markers(
+    rng: random.Random,
+    shape: tuple[int, int],
+    rows: list[int],
+    cols: list[int],
+) -> dict[tuple[int, int], int] | None:
+    quadrant_cells = _quadrant_cells(shape, rows, cols)
