   309	def main(grid: np.ndarray) -> np.ndarray:
   310	    """
   311	    Expand real markers into propagation-enabled 4x4 glyphs and show every collision in color 9.
   312	
   313	    Input structure:
   314	    - The canvas is black except for single-pixel markers in colors 2, 3, 5, and/or 8.
   315	    - A legend may also appear as one full 4x4 sample template plus its matching marker at the sample's lower-right label cell.
   316	    - Unlike the original task, some visible sample/template corners can themselves use marker colors because those corners explain the propagation rule.
   317	
   318	    Rule:
   319	    - Ignore the entire legend patch and its label; every remaining marker is a true glyph anchor.
   320	    - Place each anchor's fixed 4x4 template with its top-left at the marker position, clipping at the grid edge.
   321	    - After each wave, if a placed template's lower-right corner cell is another marker color, treat that corner as a fresh marker for the next wave.
   322	    - Render all waves together: cells painted by exactly one glyph keep that glyph's color, while any cell painted by two or more glyphs becomes the special overlap color 9.
   323	
   324	    Key insight:
   325	    - Solving requires two coupled inferences at once: the marker dictionary is still local, but the full output only appears after simulating diagonal corner-seed propagation and replacing every shared painted cell with 9.
   326	    """
   327	    g = np.asarray(grid, dtype=int)
   328	    assert g.ndim == 2
   329	    assert set(int(x) for x in np.unique(g)).issubset(ALLOWED_INPUT_COLORS)
   330	
   331	    masked = _legend_mask(g)
   332	    markers = _initial_markers(g, masked)
   333	    assert markers
   334	
   335	    placements = _simulate_placements(g.shape, markers)
   336	    out, _ = _render_placements(g.shape, placements)
   337	    return out
   338	
   339	
   340	def _choose_canvas(rng: random.Random) -> tuple[int, int]:
   341	    size = rng.choice([18, 20, 22])
   342	    return size, size
   343	
   344	
   345	def _build_root_lattice(rng: random.Random, h: int, w: int) -> tuple[list[int], list[int]]:
   346	    for _ in range(120):
   347	        row_step = rng.choice([3, 4, 5])
   348	        col_step = rng.choice([3, 4, 5])
   349	        if row_step != 3 and col_step != 3:
   350	            continue
   351	
   352	        rows = rng.randint(3, 4 if h <= 20 else 5)
   353	        cols = rng.randint(3, 4 if w <= 20 else 5)
   354	        max_r0 = h - 1 - (rows - 1) * row_step
   355	        max_c0 = w - 1 - (cols - 1) * col_step
   356	        if max_r0 < 0 or max_c0 < 0:
   357	            continue
   358	
   359	        cap_r0 = min(max_r0, h - 10)
   360	        cap_c0 = min(max_c0, w - 10)
   361	        if cap_r0 < 0 or cap_c0 < 0:
   362	            continue
   363	
   364	        r0 = rng.randint(0, cap_r0)
   365	        c0 = rng.randint(0, cap_c0)
   366	        rows_pos = [r0 + i * row_step for i in range(rows)]
   367	        cols_pos = [c0 + j * col_step for j in range(cols)]
   368	        return rows_pos, cols_pos
   369	
   370	    raise RuntimeError("failed to build a feasible root lattice")
   371	
   372	
   373	def _partner_coord(rows_pos: list[int], cols_pos: list[int]) -> tuple[int, int]:
   374	    r0 = rows_pos[0]
   375	    c0 = cols_pos[0]
   376	    if len(rows_pos) >= 2 and rows_pos[1] - rows_pos[0] == 3:
   377	        return rows_pos[1], c0
   378	    if len(cols_pos) >= 2 and cols_pos[1] - cols_pos[0] == 3:
   379	        return r0, cols_pos[1]
   380	    raise RuntimeError("lattice does not support the forced propagated-overlap partner")
   381	
   382	
   383	def _place_legend(rng: random.Random, grid: np.ndarray, used_markers: list[int]) -> None:
   384	    if rng.random() >= 0.7:
   385	        return
   386	
   387	    h, w = grid.shape
   388	    choices: list[tuple[int, int, int]] = []
   389	    for marker_color in sorted(set(used_markers)):
   390	        template = TEMPLATES[marker_color]
   391	        for r0 in range(max(0, h - 4)):
   392	            for c0 in range(max(0, w - 4)):
   393	                bbox = grid[r0 : r0 + 5, c0 : c0 + 5]
   394	                if bbox.shape != (5, 5):
   395	                    continue
   396	                if np.any(bbox != 0):
   397	                    continue
   398	                choices.append((marker_color, r0, c0))
   399	
   400	    if not choices:
   401	        return
   402	
   403	    marker_color, r0, c0 = rng.choice(choices)
   404	    template = TEMPLATES[marker_color]
   405	    for dr in range(4):
   406	        for dc in range(4):
   407	            val = int(template[dr, dc])
   408	            if val != 0:
   409	                grid[r0 + dr, c0 + dc] = val
   410	    grid[r0 + 4, c0 + 4] = int(marker_color)
   411	
   412	
   413	def _gen_attempt(rng: random.Random) -> np.ndarray:
   414	    h, w = _choose_canvas(rng)
   415	    rows_pos, cols_pos = _build_root_lattice(rng, h, w)
   416	    cells = [(r, c) for r in rows_pos for c in cols_pos]
   417	
   418	    root_anchor = (rows_pos[0], cols_pos[0])
   419	    partner_anchor = _partner_coord(rows_pos, cols_pos)
   420	    chain_anchors = {(r, c) for _, r, c, _, _ in _simulate_placements((h, w), [(root_anchor[0], root_anchor[1], 8)])}
   421	
   422	    available = [cell for cell in cells if cell not in chain_anchors and cell != partner_anchor]
   423	    min_roots = 4
   424	    max_roots = min(7, len(cells))
   425	    if max_roots < min_roots:
   426	        raise RuntimeError("lattice too small")
   427	    root_count = rng.randint(min_roots, max_roots)
   428	    extra_needed = root_count - 2
   429	    if len(available) < extra_needed:
   430	        raise RuntimeError("not enough free lattice cells")
   431	
   432	    extras = rng.sample(available, extra_needed)
   433	    roots: list[tuple[int, int, int]] = [
   434	        (root_anchor[0], root_anchor[1], 8),
   435	        (partner_anchor[0], partner_anchor[1], rng.choice([2, 3, 5, 8])),
   436	    ]
   437	    extra_colors = [2, 3, 5, 8]
   438	    for r, c in extras:
   439	        roots.append((r, c, rng.choice(extra_colors)))
   440	
   441	    rng.shuffle(roots)
   442	
   443	    placements = _simulate_placements((h, w), roots)
   444	    out, render_metrics = _render_placements((h, w), placements)
   445	    baseline = _single_step_output((h, w), roots)
   446	
   447	    metrics = {
   448	        "total_placed_glyphs": int(len(placements)),
   449	        "generated_glyphs": int(sum(1 for wave, *_ in placements if wave > 0)),
   450	        "wave_count": int(max(wave for wave, *_ in placements) + 1),
   451	        "overlap_pixels": int(render_metrics["overlap_pixels"]),
   452	        "propagated_overlap_pixels": int(render_metrics["propagated_overlap_pixels"]),
   453	        "painted_pixels": int(render_metrics["painted_pixels"]),
   454	        "changed_vs_single_step": int(np.count_nonzero(out != baseline)),
   455	    }
   456	
   457	    if metrics["wave_count"] < MIN_PROPAGATION_WAVES:
   458	        raise RuntimeError("too few propagation waves")
   459	    if metrics["generated_glyphs"] <= 0:
   460	        raise RuntimeError("no generated glyphs")
   461	    if metrics["overlap_pixels"] < 3:
   462	        raise RuntimeError("too little overlap")
   463	    if metrics["propagated_overlap_pixels"] < 2:
   464	        raise RuntimeError("overlap did not materially involve generated glyphs")
   465	    if metrics["changed_vs_single_step"] < 6:
   466	        raise RuntimeError("propagation not visibly distinct from single step")
   467	    if metrics["overlap_pixels"] * 3 > metrics["painted_pixels"] * 2:
   468	        raise RuntimeError("overlap saturation too high")
   469	
   470	    grid = np.zeros((h, w), dtype=int)
   471	    for r, c, color in roots:
   472	        grid[r, c] = int(color)
   473	    _place_legend(rng, grid, [color for _, _, color in roots])
   474	
   475	    actual = main(grid)
   476	    if not np.array_equal(actual, out):
   477	        raise RuntimeError("solver/render mismatch")
   478	
   479	    post_metrics = fusion_metrics(grid)
   480	    if post_metrics["propagated_overlap_pixels"] < 2:
   481	        raise RuntimeError("legend insertion changed core behavior")
   482	    return grid
   483	
   484	
   485	def generate_input() -> np.ndarray:
   486	    rng = random.Random()
   487	    for _ in range(GEN_RETRIES):
   488	        try:
   489	            return _gen_attempt(rng)
   490	        except Exception:
   491	            continue
   492	    raise RuntimeError("failed to generate a valid fused dfadab01 variant")

