+
+
+def _initial_markers(g: np.ndarray, masked: np.ndarray) -> list[tuple[int, int, int]]:
+    markers: list[tuple[int, int, int]] = []
+    h, w = g.shape
+    for r in range(h):
+        for c in range(w):
+            val = int(g[r, c])
