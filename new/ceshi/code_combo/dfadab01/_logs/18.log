+    h, w = g.shape
+    center_color = int(g[r, c])
+    arm_color = _other_marker_color(center_color)
+    count = 0
+    for dr, dc in CARDINAL_DIRS:
+        rr, cc = r + dr, c + dc
+        if 0 <= rr < h and 0 <= cc < w and int(g[rr, cc]) == arm_color:
