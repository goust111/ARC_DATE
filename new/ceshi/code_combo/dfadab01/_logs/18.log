+def _find_legend(
+    shape: tuple[int, int],
+    used_types: list[tuple[int, int]],
+    occupied: set[tuple[int, int]],
+    rng: random.Random,
+) -> tuple[int, int, int, tuple[tuple[int, int], ...]] | None:
+    h, w = shape
+    order = [(r, c) for r in range(h - 5) for c in range(w - 5)]
+    rng.shuffle(order)
