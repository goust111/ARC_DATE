+                anchor = (tr + dr, tc + dc)
+                candidates: list[tuple[int, int, np.ndarray, tuple[int, int], np.ndarray]] = []
+                for pattern_index, pattern, center, buckets in patterns:
+                    dist = _anchor_distance(pattern, anchor)
+                    if dist <= 1:
