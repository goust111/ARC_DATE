+
+
+def _pattern_center(pattern: np.ndarray) -> tuple[int, int]:
+    rows = pattern[:, 0]
+    cols = pattern[:, 1]
+    return (
+        int((int(rows.min()) + int(rows.max())) // 2),
+        int((int(cols.min()) + int(cols.max())) // 2),
