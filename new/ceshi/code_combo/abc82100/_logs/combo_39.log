   249	def main(grid: np.ndarray) -> np.ndarray:
   250	    """
   251	    Learn local source-target-frame examples and stamp centered gradient rings elsewhere.
   252	
   253	    Input structure:
   254	    - The grid has a dominant background, isolated colored pixels, and teal (8)
   255	      components used as local rule legends.
   256	    - Each relevant teal component is a hollow rectangular frame: only its border
   257	      cells are teal and its interior remains background.
   258	    - A rule example is still a 4-neighbor source->target pair whose continuation
   259	      reaches an anchor touching that teal frame.
   260	
   261	    Rule:
   262	    - For each learned source_color -> target_color mapping, copy the associated
   263	      hollow frame onto every non-legend pixel of that source color.
   264	    - Position the copy by aligning the frame's geometric center (its bbox center)
   265	      to the scattered source pixel, ignoring the legend anchor for placement.
   266	    - Recolor the copied border with a center-outward gradient: the nearest border
   267	      layer to the center uses the target color, the next layer uses a lighter
   268	      intermediate color, and any farther layer uses the lightest outer color.
   269	      Remove all legend pixels and all teal frame pixels from the final output.
   270	
   271	    Key insight: the adjacent colored pair still teaches which source color maps to
   272	    which target palette, but the teal example now means "center this hollow frame
   273	    on the source pixel and color its border by distance from the frame center."
   274	    """
   275	    g = np.asarray(grid, dtype=int)
   276	    bg = get_bg(g)
   277	    pattern_color = 8
   278	    h, w = g.shape
   279	
   280	    rules = _discover_rules(g, bg=bg, pattern_color=pattern_color)
   281	    legend_pixels: set[tuple[int, int]] = set()
   282	    source_colors: set[int] = set()
   283	    for rule in rules:
   284	        legend_pixels.add(rule["source_pos"])
   285	        legend_pixels.add(rule["target_pos"])
   286	        source_colors.add(rule["source_color"])
   287	
   288	    out = np.full_like(g, int(bg))
   289	
   290	    for r, c in map(tuple, np.argwhere((g != int(bg)) & (g != pattern_color))):
   291	        r = int(r)
   292	        c = int(c)
   293	        color = int(g[r, c])
   294	        if (r, c) in legend_pixels or color in source_colors:
   295	            continue
   296	        out[r, c] = color
   297	
   298	    for rule in rules:
   299	        cr, cc = rule["center"]
   300	        pattern = rule["pattern"]
   301	        rel_rows = pattern[:, 0] - int(cr)
   302	        rel_cols = pattern[:, 1] - int(cc)
   303	        pattern_colors = np.array(
   304	            [_gradient_color(rule["target_color"], int(bucket)) for bucket in rule["distance_buckets"]],
   305	            dtype=int,
   306	        )
   307	        for sr, sc in map(tuple, np.argwhere(g == rule["source_color"])):
   308	            sr = int(sr)
   309	            sc = int(sc)
   310	            if (sr, sc) in legend_pixels:
   311	                continue
   312	            rows = rel_rows + sr
   313	            cols = rel_cols + sc
   314	            ok = (0 <= rows) & (rows < h) & (0 <= cols) & (cols < w)
   315	            out[rows[ok], cols[ok]] = pattern_colors[ok]
   316	
   317	    return out
