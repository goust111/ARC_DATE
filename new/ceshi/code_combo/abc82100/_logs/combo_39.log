+        pattern = rule["pattern"]
+        rel_rows = pattern[:, 0] - int(cr)
+        rel_cols = pattern[:, 1] - int(cc)
+        pattern_colors = np.array(
+            [_gradient_color(rule["target_color"], int(bucket)) for bucket in rule["distance_buckets"]],
+            dtype=int,
