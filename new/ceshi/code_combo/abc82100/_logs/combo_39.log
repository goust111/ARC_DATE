+    rows = pattern[:, 0]
+    cols = pattern[:, 1]
+    r0 = int(rows.min())
+    r1 = int(rows.max())
+    c0 = int(cols.min())
+    c1 = int(cols.max())
+    height = r1 - r0 + 1
+    width = c1 - c0 + 1
+    if height < 3 or width < 3:
+        return None
+
+    normalized = {(int(r - r0), int(c - c0)) for r, c in pattern}
+    expected = set()
+    for r in range(height):
+        expected.add((r, 0))
+        expected.add((r, width - 1))
+    for c in range(width):
+        expected.add((0, c))
+        expected.add((height - 1, c))
+
+    if normalized != expected:
+        return None
+
+    center = (height // 2, width // 2)
+    dists = [abs(r - center[0]) + abs(c - center[1]) for r, c in expected]
+    if len(set(dists)) < 3:
+        return None
+
+    return {
+        "bbox": (r0, c0, r1, c1),
+        "height": height,
+        "width": width,
+        "center": (r0 + center[0], c0 + center[1]),
+    }
+
+
+def _pattern_center(pattern: np.ndarray) -> tuple[int, int]:
+    rows = pattern[:, 0]
+    cols = pattern[:, 1]
