   434	def main(grid: np.ndarray) -> np.ndarray:
   435	    """
   436	    Learn local source-target stencil rules, then render them on an auto-expanded output canvas.
   437	
   438	    Input structure:
   439	    - The grid has a black background, several isolated colored pixels, and one teal
   440	      component per rule that serves as the stencil template.
   441	    - Each rule is shown by two 4-neighbor colored cells in a line; continuing one
   442	      more step in the same direction reaches an anchor touching that teal stencil.
   443	
   444	    Rule:
   445	    - For every learned rule, find the other pixels of the same source color and
   446	      translate the rule's teal component so the rule anchor lands on that source.
   447	    - Recolor the translated stencil to the rule's target color and erase all legend
   448	      pixels together with every original teal template pixel.
   449	    - If any translated stencil would leave the input frame, expand the output grid
   450	      on the needed side or sides instead of discarding those cells.
   451	
   452	    Key insight: The legends still define both the source->target color mapping and
   453	    the template shape; the extra step is to compute one global canvas large enough
   454	    to contain the entire original frame plus every translated template cell.
   455	    """
   456	    g = np.asarray(grid, dtype=int)
   457	    bg = get_bg(g)
   458	    pattern_color = 8
   459	    h, w = g.shape
   460	
   461	    rules = _discover_rules(g, bg=bg, pattern_color=pattern_color)
   462	    legend_pixels: set[tuple[int, int]] = set()
   463	    source_colors: set[int] = set()
   464	    for rule in rules:
   465	        legend_pixels.add(rule["source_pos"])
   466	        legend_pixels.add(rule["target_pos"])
   467	        source_colors.add(rule["source_color"])
   468	
   469	    preserved_cells: list[tuple[int, int, int]] = []
   470	    for r, c in map(tuple, np.argwhere((g != int(bg)) & (g != pattern_color))):
   471	        r = int(r)
   472	        c = int(c)
   473	        color = int(g[r, c])
   474	        if (r, c) in legend_pixels or color in source_colors:
   475	            continue
   476	        preserved_cells.append((int(r), int(c), int(color)))
   477	
   478	    stamped_cells: list[tuple[int, int, int]] = []
   479	    for rule in rules:
   480	        ar, ac = rule["anchor"]
   481	        pattern = rule["pattern"]
   482	        for sr, sc in map(tuple, np.argwhere(g == rule["source_color"])):
   483	            sr = int(sr)
   484	            sc = int(sc)
   485	            if (sr, sc) in legend_pixels:
   486	                continue
   487	            dr = int(sr) - int(ar)
   488	            dc = int(sc) - int(ac)
   489	            for pr, pc in pattern:
   490	                stamped_cells.append((int(pr) + dr, int(pc) + dc, int(rule["target_color"])))
   491	
   492	    return _render_expanded(h, w, int(bg), preserved_cells, stamped_cells)
   493	
   494	
   495	def _gen_attempt():
   496	    num_rules = random.choice([1, 1, 2, 2, 3, 3, 4])
   497	    min_dim = {1: 5, 2: 10, 3: 14, 4: 18}[num_rules]
   498	    h = random.randint(min_dim, 20)
   499	    w = random.randint(min_dim, 20)
   500	
   501	    rules, used_colors = _build_rules(num_rules, h * w)
   502	    required_dirs = _choose_required_dirs(rules, h, w)
   503	    if len(required_dirs) < 2:
   504	        return None
   505	
   506	    occupied: set[tuple[int, int]] = set()
   507	    reserved: set[tuple[int, int]] = set()
   508	    inp = np.zeros((h, w), dtype=int)
   509	
   510	    if not _place_legends(rules, inp, occupied, reserved):
   511	        return None
   512	    if not _place_scattered(rules, inp, occupied, reserved, required_dirs):
   513	        return None
   514	    bystander_pos = _place_bystanders(used_colors, inp, occupied, reserved)
   515	
   516	    expanded, dirs, out_shape = _expansion_signature(rules, h, w)
   517	    if not expanded:
   518	        return None
   519	    if not ({*dirs} & set(_VERT_DIRS) and {*dirs} & set(_HORZ_DIRS)):
   520	        return None

