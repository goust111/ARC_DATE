def _place_bystanders(used_colors, inp, occupied, reserved):
    """Place 0-BYSTANDER_MAX bystander pixels. Returns list of (r, c, color)."""
    bystander_colors = [c for c in NON_BG_NON_TEAL_COLORS if c not in used_colors]
