   233	    best_score = -1
   234	    for ar, ac in coords_list:
   235	        rel = [(int(r - ar), int(c - ac)) for r, c in coords_list]
   236	        min_rr, max_rr, min_cc, max_cc = _rel_bounds(rel)
   237	        score = int(min_rr < 0) + int(max_rr > 0) + int(min_cc < 0) + int(max_cc > 0)
