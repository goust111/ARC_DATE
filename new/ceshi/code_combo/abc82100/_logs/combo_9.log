def _king_path(start: tuple[int, int], end: tuple[int, int]) -> list[tuple[int, int]]:
    r, c = start
    tr, tc = end
    path = [(int(r), int(c))]
    while (r, c) != (tr, tc):
        if r < tr:
            r += 1
        elif r > tr:
            r -= 1
        if c < tc:
            c += 1
        elif c > tc:
            c -= 1
        path.append((int(r), int(c)))
    return path


