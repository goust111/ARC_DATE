+        "tl": (range(0, r_split), range(0, c_split)),
+        "tr": (range(0, r_split), range(c_split, int(w))),
+        "bl": (range(r_split, int(h)), range(0, c_split)),
+        "br": (range(r_split, int(h)), range(c_split, int(w))),
