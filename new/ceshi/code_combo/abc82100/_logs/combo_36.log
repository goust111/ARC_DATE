MIN_DIM_BY_GROUPS = {1: 10, 2: 16}

# Each source-color family owns exactly two conditional branches.
GROUP_COUNT_WEIGHTS = [1, 1, 2]
BRANCHES_PER_GROUP = 2
NON_BG_NON_TEAL_COLORS = [1, 2, 3, 4, 5, 6, 7, 9]

