        col_lo = work_c0 - min_cc
        if row_lo >= h or col_lo >= w:
            return False

        n_sc = random.randint(SCATTERED_MIN, sc_max)
        positions: list[tuple[int, int]] = []
        for _ in range(n_sc * SCATTERED_RETRIES_PER_PIXEL):
