        chosen: list[int] = []
        order = candidates[:]
        random.shuffle(order)
        for row in order:
            if all(abs(int(row) - int(prev)) >= RULE_ROW_GAP for prev in chosen):
                chosen.append(int(row))
                if len(chosen) == num_rules:
                    return sorted(chosen)
    return None


