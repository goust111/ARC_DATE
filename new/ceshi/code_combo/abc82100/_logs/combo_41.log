+        inp[pos] = color
+        placed.append((int(r), int(c), color))
+        occupied.add(pos)
+        _reserve_4neighbors(reserved, [pos])
+    return placed
+
+
+def _build_output(
+    row_rules: list[dict],
+    col_rules: list[dict],
+    bystanders: list[tuple[int, int, int]],
+    shape: tuple[int, int],
+) -> np.ndarray:
+    out = np.zeros(shape, dtype=int)
