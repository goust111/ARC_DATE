+    for r, c in map(tuple, np.argwhere(work & (g != int(bg)) & (g != int(PATTERN_COLOR)))):
+        r = int(r)
+        c = int(c)
+        color = int(g[r, c])
+        if color == int(source_marker) and r in row_rules and c in col_rules:
+            continue
