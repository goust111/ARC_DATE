+    h, w = map(int, shape)
+    cells: set[tuple[int, int]] = set()
+    for rr, cc in np.asarray(rel, dtype=int):
+        nr = int(center_r) + int(rr)
+        nc = int(center_c) + int(cc)
+        if 0 <= nr < h and 0 <= nc < w:
