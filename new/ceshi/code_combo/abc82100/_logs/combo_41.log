+        inp[int(row), LEFT_TARGET_COL] = int(rule["target"])
+        rule["row"] = int(row)
+
+    for col, rule in zip(active_cols, col_rules):
+        inp[TOP_MARKER_ROW, int(col)] = int(source_marker)
