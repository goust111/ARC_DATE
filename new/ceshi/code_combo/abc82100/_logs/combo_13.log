+def _discover_rules(grid: np.ndarray, bg: int, pattern_color: int = PATTERN_COLOR) -> list[dict]:
+    h, w = grid.shape
+    patterns = components_mask(grid == pattern_color, connectivity=8)
+    rules: list[dict] = []
+    seen: set[tuple[tuple[int, int], tuple[int, int], int]] = set()
+
+    for r in range(h):
+        for c in range(w):
+            source_color = int(grid[r, c])
+            if source_color in (int(bg), int(pattern_color)):
+                continue
+
+            for dr, dc in _DIRS4:
+                tr = r + dr
+                tc = c + dc
+                if not (0 <= tr < h and 0 <= tc < w):
+                    continue
+
+                target_color = int(grid[tr, tc])
+                if target_color in (int(bg), int(pattern_color)) or target_color == source_color:
+                    continue
+
+                anchor = (tr + dr, tc + dc)
+                candidates: list[tuple[int, int, np.ndarray]] = []
+                for i, pattern in enumerate(patterns):
+                    dist = _anchor_distance(pattern, anchor)
+                    if dist <= 1:
+                        candidates.append((int(dist), int(i), pattern))
+
+                if not candidates:
+                    continue
+
+                candidates.sort(key=lambda item: (item[0], len(item[2])))
+                _dist, pattern_index, pattern = candidates[0]
+                key = ((int(r), int(c)), (int(tr), int(tc)), int(pattern_index))
+                if key in seen:
+                    continue
+                seen.add(key)
+                rules.append(
+                    {
+                        "source_color": int(source_color),
+                        "target_color": int(target_color),
+                        "source_pos": (int(r), int(c)),
+                        "target_pos": (int(tr), int(tc)),
+                        "anchor": (int(anchor[0]), int(anchor[1])),
+                        "pattern": np.asarray(pattern, dtype=int),
+                    }
+                )
+
+    return rules
+
+
+def _merge_color(current: int, incoming: int, bg: int, conflict_color: int = CONFLICT_COLOR) -> int:
+    current = int(current)
+    incoming = int(incoming)
+    if current == int(bg):
+        return int(incoming)
+    if current == int(incoming) or current == int(conflict_color):
+        return int(current)
+    return int(conflict_color)
