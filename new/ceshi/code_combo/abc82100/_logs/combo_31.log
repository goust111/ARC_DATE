+def _make_stencil(min_pixels: int, max_pixels: int) -> tuple[list[tuple[int, int]], tuple[int, int]]:
+    n = random.randint(min_pixels, max_pixels)
+    coords = {(0, 0)}
+    for _ in range(n - 1):
+        frontier = set()
+        for r, c in coords:
+            for dr, dc in _DIRS8:
+                pos = (int(r + dr), int(c + dc))
+                if pos not in coords:
