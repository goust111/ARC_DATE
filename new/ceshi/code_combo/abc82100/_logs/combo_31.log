+    if not _place_legends(rules, vote_palette, inp, occupied, reserved):
+        return None
+    if not _place_source_blocks(rules, vote_palette, inp, occupied, reserved):
+        return None
+    bystanders = _place_bystanders(inp, occupied, reserved)
