+    out = _build_output(rules, bystanders, h, w)
+    try:
+        if np.array_equal(main(inp), out):
+            return inp
+    except Exception:
+        return None
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(OUTER_RETRIES):
+        result = _gen_attempt()
+        if result is not None:
+            return result
