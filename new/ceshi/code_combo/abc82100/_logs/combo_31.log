+    if metrics["unique_keys"] != num_rules:
+        return None
+    if metrics["repeated_source_rules"] < 1:
+        return None
+    if metrics["matched_blocks"] != expected_blocks:
+        return None
+    if metrics["varying_rules"] < 1:
+        return None
+    if metrics["min_block_size"] < 2:
