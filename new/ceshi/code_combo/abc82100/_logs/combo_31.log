+    out = np.full_like(g, int(bg))
+
+    for r, c in map(tuple, np.argwhere((g != int(bg)) & (g != int(PATTERN_COLOR)))):
+        r = int(r)
+        c = int(c)
+        color = int(g[r, c])
+        if (r, c) in legend_pixels or (r, c) in legend_context or color in source_colors:
+            continue
+        out[r, c] = color
