   321	def main(grid: np.ndarray) -> np.ndarray:
   322	    """
   323	    Learn stencil ownership from local source-guide-pattern examples, then apply
   324	    each stencil once per matching source block using the block anchor's context.
   325	
   326	    Input structure:
   327	    - Black background with teal (8) stencil components, legend source->guide
   328	      pairs, extra legend helper pixels, and free-standing monochrome source
   329	      blocks elsewhere in the grid.
   330	    - Each source block is a 4-connected shape of size at least 2. Its top-left
   331	      occupied cell acts as the block anchor.
   332	    - The legend source and each block anchor have a visible local 4-neighborhood
   333	      whose total non-background count is either 3 or 4, and whose majority color
   334	      is shown by repeated neighboring pixels.
   335	
   336	    Rule:
   337	    - Discover a rule from each legend by reading the source color, the nearby
   338	      teal stencil, and the legend source's non-background 4-neighbor count.
   339	    - For every non-legend source block, look at its anchor cell. The block uses
   340	      the rule whose source color matches and whose anchor-neighbor count matches.
   341	    - Copy that rule's teal stencil once onto the block anchor, and recolor the
   342	      copied stencil with the unique most frequent non-background color among the
   343	      anchor's four neighbors. Remove the legend area, all original teal cells,
   344	      and the source blocks themselves; preserve unrelated support/bystander
   345	      pixels unless a stamp later covers them.
   346	
   347	    Key insight: the same local neighborhood around a source-block anchor must be
   348	    analyzed twice. Its size class chooses which rule applies, and its color vote
   349	    chooses what color that rule's stencil will use for this specific block.
   350	    """
   351	    g = np.asarray(grid, dtype=int)
   352	    bg = get_bg(g)
