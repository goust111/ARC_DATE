+    mask = grid == int(source_color)
+    if legend_pixels or legend_context:
+        mask = mask.copy()
+        for r, c in legend_pixels | legend_context:
+            if 0 <= r < mask.shape[0] and 0 <= c < mask.shape[1]:
+                mask[r, c] = False
