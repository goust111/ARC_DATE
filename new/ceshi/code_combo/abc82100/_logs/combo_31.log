+
+
+def _place_bystanders(
+    inp: np.ndarray,
+    occupied: set[tuple[int, int]],
+    reserved: set[tuple[int, int]],
+) -> list[tuple[int, int, int]]:
+    h, w = inp.shape
+    n = random.randint(0, BYSTANDER_MAX)
