+STENCIL_MAX_CAP = 12
+STENCIL_MIN_AREA_DIV = 100
+STENCIL_MAX_AREA_DIV = 25
+
+SOURCE_BLOCK_MIN = 3
+SOURCE_BLOCK_MAX_CAP = 5
+SOURCE_BLOCK_AREA_DIV = 55
+
+BYSTANDER_MAX = 4
+
+LEGEND_RETRIES = 700
+SOURCE_BLOCK_RETRIES_PER_BLOCK = 120
