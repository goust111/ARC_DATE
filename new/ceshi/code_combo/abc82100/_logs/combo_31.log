+RULE_COUNT_WEIGHTS = [2, 2, 3, 3, 4]
+SOURCE_COLORS = [1, 2, 3]
+VOTE_COLORS = [4, 5, 6, 7, 9]
+PATTERN_COLOR = 8
+COUNT_CLASSES = [3, 4]
