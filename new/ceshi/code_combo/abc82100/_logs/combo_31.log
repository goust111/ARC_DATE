+            target_color = int(block["majority"])
+            for rr, cc in rel:
+                nr = int(ar + rr)
+                nc = int(ac + cc)
+                if 0 <= nr < h and 0 <= nc < w:
+                    out[nr, nc] = target_color
+    return out
+
+
+def _variant_metrics(inp: np.ndarray) -> dict[str, int]:
+    bg = get_bg(inp)
