        rel = [(r - anchor[0], c - anchor[1]) for r, c in stencil]
        rules.append({
            'src': src_c, 'tgt': tgt_c,
            'rel': rel, 'n_sc': random.randint(SCATTERED_MIN, sc_max),
        })
    return rules, used


