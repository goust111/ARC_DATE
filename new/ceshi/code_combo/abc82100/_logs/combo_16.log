   294	def _build_rules(num_rules: int) -> tuple[list[dict], set[int]]:
   295	    colors = NON_BG_NON_TEAL_COLORS[:]
   296	    random.shuffle(colors)
   297	    rules: list[dict] = []
   298	    used_colors: set[int] = set()
   299	    for i in range(num_rules):
   300	        src_c = int(colors[2 * i])
   301	        tgt_c = int(colors[2 * i + 1])
   302	        stencil, anchor = _make_stencil()
   303	        rel = [(int(r - anchor[0]), int(c - anchor[1])) for r, c in stencil]
   304	        min_r, max_r, min_c, max_c = _rel_bounds(rel)
   305	        rules.append(
   306	            {
   307	                "src": src_c,
   308	                "tgt": tgt_c,
   309	                "rel": rel,
   310	                "bounds": (min_r, max_r, min_c, max_c),
   311	            }
   312	        )
   313	        used_colors.update((src_c, tgt_c))
   314	    return rules, used_colors
