   148	def main(grid: np.ndarray) -> np.ndarray:
   149	    """
   150	    Learn local source-target-stencil examples, keep their colored legend pairs,
   151	    and return only the cropped transformation region.
   152	
   153	    Input structure:
   154	    - A black-background grid with a separated top instruction strip and a lower
   155	      work region.
   156	    - Each legend is a 4-neighbor source->target pair whose forward continuation
   157	      reaches a teal (8) stencil component; elsewhere, isolated source-color
   158	      pixels repeat those source colors inside the work region.
   159	
   160	    Rule:
   161	    - For every discovered legend, translate its teal stencil onto every non-legend
   162	      pixel of the same source color, recoloring the stencil to the legend's
   163	      target color and aligning the legend anchor with that source pixel.
   164	    - On the full transformed canvas, teal is removed but the colored legend pair
   165	      remains.
   166	    - The final answer is then cropped to the surviving non-legend result area,
   167	      excluding the preserved rule strip.
   168	
   169	    Key insight: The colored legend pair is still a valid part of the transformed
   170	    full canvas, so a naive non-background crop is wrong. You must separate
   171	    "instruction pixels" from "result pixels" and crop only around the latter.
   172	    """
   173	    g = np.asarray(grid, dtype=int)
   174	    bg = get_bg(g)
   175	    pattern_color = 8
   176	    h, w = g.shape
   177	
   178	    rules = _discover_rules(g, bg=bg, pattern_color=pattern_color)
   179	    legend_pixels: set[tuple[int, int]] = set()
   180	    source_colors: set[int] = set()
   181	    for rule in rules:
   182	        legend_pixels.add(rule["source_pos"])
   183	        legend_pixels.add(rule["target_pos"])
   184	        source_colors.add(rule["source_color"])
   185	
   186	    out = np.full_like(g, int(bg))
   187	
   188	    for r, c in map(tuple, np.argwhere((g != int(bg)) & (g != pattern_color))):
   189	        r = int(r)
   190	        c = int(c)
   191	        color = int(g[r, c])
   192	        if (r, c) in legend_pixels:
   193	            out[r, c] = color
   194	            continue
   195	        if color in source_colors:
   196	            continue
   197	        out[r, c] = color
   198	
   199	    for rule in rules:
   200	        ar, ac = rule["anchor"]
   201	        pattern = rule["pattern"]
   202	        for sr, sc in map(tuple, np.argwhere(g == rule["source_color"])):
   203	            sr = int(sr)
   204	            sc = int(sc)
   205	            if (sr, sc) in legend_pixels:
   206	                continue
   207	            dr = sr - ar
   208	            dc = sc - ac
   209	            rows = pattern[:, 0] + dr
   210	            cols = pattern[:, 1] + dc
   211	            ok = (0 <= rows) & (rows < h) & (0 <= cols) & (cols < w)
   212	            out[rows[ok], cols[ok]] = rule["target_color"]
   213	
   214	    for rule in rules:
   215	        sr, sc = rule["source_pos"]
   216	        tr, tc = rule["target_pos"]
   217	        out[int(sr), int(sc)] = int(rule["source_color"])
   218	        out[int(tr), int(tc)] = int(rule["target_color"])
   219	
   220	    return _crop_result_region(out, legend_pixels=legend_pixels, bg=bg)
