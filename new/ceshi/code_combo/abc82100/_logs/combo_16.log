   318	    max_pattern_h = max(int(rule["bounds"][1] - rule["bounds"][0] + 1) for rule in rules)
   319	    legend_h = max(6, max_pattern_h + 2)
   320	    min_h = max(MIN_HEIGHT_BY_RULES[num_rules], legend_h + LEGEND_GAP + 5 + EDGE_MARGIN)
   321	    min_w = MIN_WIDTH_BY_RULES[num_rules]
