   455	    result_cells = {(int(r), int(c)) for r in range(box[0], box[2] + 1) for c in range(box[1], box[3] + 1)}
   456	    blocked = set(map(tuple, np.argwhere(out != 0)))
   457	    blocked.update(map(tuple, np.argwhere(inp != 0)))
   458	    free_cells = list(result_cells - blocked)
   459	    random.shuffle(free_cells)
   460	
   461	    n = random.randint(0, min(BYSTANDER_MAX, len(free_cells)))
   462	    placed: list[tuple[int, int, int]] = []
   463	    for r, c in free_cells[:n]:
   464	        color = int(random.choice(bystander_colors))
   465	        inp[int(r), int(c)] = color
   466	        out[int(r), int(c)] = color
   467	        placed.append((int(r), int(c), color))
   468	    return placed
   469	
   470	
   471	def _legend_pixels_from_rules(rules: list[dict]) -> set[tuple[int, int]]:
   472	    legend_pixels: set[tuple[int, int]] = set()
   473	    for rule in rules:
   474	        legend_pixels.add(tuple(rule["source_pos"]))
   475	        legend_pixels.add(tuple(rule["target_pos"]))
   476	    return legend_pixels
   477	
   478	
   479	def _seed_legends_into_output(rules: list[dict], out: np.ndarray) -> None:
   480	    for rule in rules:
   481	        sr, sc = rule["source_pos"]
   482	        tr, tc = rule["target_pos"]
   483	        out[int(sr), int(sc)] = int(rule["src"])
   484	        out[int(tr), int(tc)] = int(rule["tgt"])
   485	
   486	
   487	def _gen_attempt() -> np.ndarray | None:
