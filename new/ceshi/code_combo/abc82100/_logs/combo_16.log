        row_hi = legend_h - 1 - max_r
        col_lo = max(0, -2 - min_c)
        col_hi = min(w - 2, w - 3 - max_c)
        if row_lo > row_hi or col_lo > col_hi:
            return False

        placed = False
        for _ in range(LEGEND_RETRIES):
