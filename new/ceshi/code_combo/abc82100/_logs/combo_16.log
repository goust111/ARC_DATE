+# Combo variant of abc82100 (index 16)
+# combo_spec: D7/0+D8/2
+# Name: 保留规则示例+仅输出变换区域
+
+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+from arc_utils import components_mask, get_bg
