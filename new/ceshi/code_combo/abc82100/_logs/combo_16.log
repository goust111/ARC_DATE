+            source_color = int(grid[r, c])
+            if source_color in (int(bg), int(pattern_color)):
+                continue
+
+            for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                tr = r + dr
+                tc = c + dc
+                if not (0 <= tr < h and 0 <= tc < w):
