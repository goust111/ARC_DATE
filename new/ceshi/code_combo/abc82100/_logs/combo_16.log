   271	def _make_stencil() -> tuple[list[tuple[int, int]], tuple[int, int]]:
   272	    for _ in range(200):
   273	        n = random.randint(STENCIL_MIN_PIXELS, STENCIL_MAX_PIXELS)
   274	        coords = {(0, 0)}
   275	        for _ in range(n - 1):
   276	            frontier = set()
   277	            for r, c in coords:
   278	                for dr, dc in _DIRS8:
   279	                    pos = (int(r + dr), int(c + dc))
