   335	def _choose_result_box(h: int, w: int, legend_h: int, rules: list[dict]) -> tuple[int, int, int, int] | None:
   336	    start_row = legend_h + LEGEND_GAP
   337	    max_stamp_h = max(int(rule["bounds"][1] - rule["bounds"][0] + 1) for rule in rules)
   338	    max_stamp_w = max(int(rule["bounds"][3] - rule["bounds"][2] + 1) for rule in rules)
   339	
   340	    max_result_h = h - start_row - EDGE_MARGIN
   341	    max_result_w = w - 2 * EDGE_MARGIN
   342	    min_result_h = max(5, max_stamp_h + 1)
   343	    min_result_w = max(6, max_stamp_w + 2)
   344	    if max_result_h < min_result_h or max_result_w < min_result_w:
   345	        return None
   346	
   347	    result_h = random.randint(min_result_h, max_result_h)
   348	    result_w = random.randint(min_result_w, max_result_w)
   349	    slack_down = h - EDGE_MARGIN - result_h - start_row
   350	    top = start_row + random.randint(0, max(0, slack_down))
   351	    left = random.randint(EDGE_MARGIN, w - EDGE_MARGIN - result_w)
   352	    return int(top), int(left), int(top + result_h - 1), int(left + result_w - 1)
