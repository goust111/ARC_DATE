   355	def _place_legends_top(rules: list[dict], inp: np.ndarray, legend_h: int) -> bool:
   356	    _h, w = inp.shape
   357	    occupied: set[tuple[int, int]] = set()
   358	    reserved: set[tuple[int, int]] = set()
   359	
   360	    for rule in rules:
   361	        rel = rule["rel"]
   362	        min_r, max_r, min_c, max_c = rule["bounds"]
   363	        row_lo = max(0, -min_r)
   364	        row_hi = legend_h - 1 - max_r
   365	        col_lo = max(0, -2 - min_c)
   366	        col_hi = min(w - 2, w - 3 - max_c)
   367	        if row_lo > row_hi or col_lo > col_hi:
   368	            return False
   369	
   370	        placed = False
   371	        for _ in range(LEGEND_RETRIES):
   372	            sr = random.randint(row_lo, row_hi)
   373	            sc = random.randint(col_lo, col_hi)
   374	            teal_cells = {(int(sr + rr), int(sc + 2 + cc)) for rr, cc in rel}
   375	            if (int(sr), int(sc)) in teal_cells or (int(sr), int(sc + 1)) in teal_cells:
