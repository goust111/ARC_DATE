   282	            coords.add(random.choice(list(frontier)))
   283	        rows = [r for r, _ in coords]
   284	        cols = [c for _, c in coords]
   285	        if max(rows) - min(rows) + 1 > STENCIL_SPAN_MAX:
   286	            continue
   287	        if max(cols) - min(cols) + 1 > STENCIL_SPAN_MAX:
   288	            continue
   289	        coords_list = sorted(coords)
   290	        return coords_list, random.choice(coords_list)
