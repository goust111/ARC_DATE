+                dc = sc - int(ac)
+                rows = pattern[:, 0] + dr
+                cols = pattern[:, 1] + dc
+                ok = (0 <= rows) & (rows < h) & (0 <= cols) & (cols < w)
+                out[rows[ok], cols[ok]] = target_color
+
