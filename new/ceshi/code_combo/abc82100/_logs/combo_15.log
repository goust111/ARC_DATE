   424	
   425	            legend_cells = {
   426	                (ar - 2 * dr, ac - 2 * dc),
   427	                (ar - dr, ac - dc),
   428	                (ar + dr, ac + dc),
   429	                (ar + 2 * dr, ac + 2 * dc),
   430	            }
