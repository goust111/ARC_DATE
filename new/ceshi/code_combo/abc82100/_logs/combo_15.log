   332	def _make_stencil(min_pixels: int, max_pixels: int):
   333	    n = random.randint(min_pixels, max_pixels)
   334	    coords = {(0, 0)}
   335	    for _ in range(n - 1):
   336	        frontier = set()
   337	        for r, c in coords:
   338	            for dr, dc in _DIRS8:
   339	                candidate = (r + dr, c + dc)
   340	                if candidate not in coords:
   341	                    frontier.add(candidate)
