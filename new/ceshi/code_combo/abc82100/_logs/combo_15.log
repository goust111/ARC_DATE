   248	            active_colors.add(int(source_color))
   249	            legend_pixels.add(tuple(rule["source_pos"]))
   250	            legend_pixels.add(tuple(rule["target_pos"]))
   251	
   252	    for color in active_colors:
   253	        color_positions[color] = np.argwhere(g == int(color))
   254	
   255	    out = np.full_like(g, int(bg))
   256	
   257	    # Preserve colored pixels that are neither legend cells nor members of a
   258	    # validated reciprocal swap pair.
   259	    for r, c in map(tuple, np.argwhere((g != int(bg)) & (g != pattern_color))):
   260	        r = int(r)

