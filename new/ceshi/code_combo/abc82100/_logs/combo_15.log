+                anchor = (tr + dr, tc + dc)
+                candidates: list[tuple[int, int, np.ndarray]] = []
+                for i, pattern in enumerate(patterns):
+                    dist = _anchor_distance(pattern, anchor)
+                    if dist <= 1:
+                        candidates.append((int(dist), int(i), pattern))
