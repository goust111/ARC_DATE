+    swap_groups: list[dict] = []
+    for key in key_order:
+        dirs = grouped[key]["dirs"]
+        first_rule = grouped[key]["rules"][0]
+        a = int(first_rule["source_color"])
+        b = int(first_rule["target_color"])
+        if (b, a) not in dirs:
+            continue
