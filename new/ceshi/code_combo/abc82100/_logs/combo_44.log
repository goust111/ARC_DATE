+def _legend_bbox_from_rel(rel: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [-2, -1] + [int(rr) for rr, _ in rel]
+    cols = [0, 0] + [int(cc) for _, cc in rel]
+    return min(rows), min(cols), max(rows), max(cols)
