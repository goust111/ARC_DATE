   152	                target_color = int(grid[tr, tc])
   153	                if target_color in (int(bg), int(pattern_color)) or target_color == source_color:
   154	                    continue
   155	
   156	                anchor = (tr + dr, tc + dc)
   157	                candidates: list[tuple[int, int, np.ndarray]] = []
   158	                for i, pattern in enumerate(patterns):
   159	                    dist = _anchor_distance(pattern, anchor)
   160	                    if dist <= 1:
   161	                        candidates.append((int(dist), int(i), pattern))
   162	
   163	                if not candidates:
   164	                    continue
   165	
   166	                candidates.sort(key=lambda item: (item[0], len(item[2])))
   167	                _dist, pattern_index, pattern = candidates[0]
   168	                key = ((int(r), int(c)), (int(tr), int(tc)), int(pattern_index))
   169	                if key in seen:
   170	                    continue
   171	                seen.add(key)
   172	                rules.append(
   173	                    {
   174	                        "source_color": int(source_color),
   175	                        "target_color": int(target_color),
   176	                        "source_pos": (int(r), int(c)),
   177	                        "target_pos": (int(tr), int(tc)),
   178	                        "anchor": (int(anchor[0]), int(anchor[1])),
   179	                        "pattern": np.asarray(pattern, dtype=int),
   180	                    }
   181	                )
