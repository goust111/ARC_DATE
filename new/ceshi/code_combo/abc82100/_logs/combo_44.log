   134	def _discover_rules(grid: np.ndarray, bg: int, pattern_color: int = PATTERN_COLOR) -> list[dict]:
   135	    h, w = grid.shape
   136	    patterns = components_mask(grid == pattern_color, connectivity=8)
   137	    rules: list[dict] = []
   138	    seen: set[tuple[tuple[int, int], tuple[int, int], int]] = set()
   139	
   140	    for r in range(h):
   141	        for c in range(w):
   142	            source_color = int(grid[r, c])
   143	            if source_color in (int(bg), int(pattern_color)):
   144	                continue
   145	
   146	            for dr, dc in _DIRS4:
   147	                tr = r + dr
   148	                tc = c + dc
   149	                if not (0 <= tr < h and 0 <= tc < w):
   150	                    continue
