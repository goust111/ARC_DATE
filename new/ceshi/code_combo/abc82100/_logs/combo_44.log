   196	def _render_legend_block(rule: dict, bg: int, pattern_color: int = PATTERN_COLOR) -> np.ndarray:
   197	    cells: list[tuple[int, int, int]] = [
   198	        (int(rule["source_pos"][0]), int(rule["source_pos"][1]), int(rule["source_color"])),
   199	        (int(rule["target_pos"][0]), int(rule["target_pos"][1]), int(rule["target_color"])),
   200	    ]
   201	    for r, c in rule["pattern"]:
   202	        cells.append((int(r), int(c), int(pattern_color)))
   203	
   204	    rs = [r for r, _c, _v in cells]
   205	    cs = [c for _r, c, _v in cells]
   206	    min_r, max_r = min(rs), max(rs)
   207	    min_c, max_c = min(cs), max(cs)
   208	    block = np.full((int(max_r - min_r + 1), int(max_c - min_c + 1)), int(bg), dtype=int)
   209	    for r, c, value in cells:
   210	        block[int(r - min_r), int(c - min_c)] = int(value)
   211	    return block
