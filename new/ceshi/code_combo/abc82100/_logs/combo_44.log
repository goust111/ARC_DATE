   186	def _project_edge_source(h: int, w: int, sr: int, sc: int) -> tuple[int, int]:
   187	    sr = int(sr)
   188	    sc = int(sc)
   189	    if sr == 0 or sr == h - 1:
   190	        return int(h // 2), int(sc)
   191	    if sc == 0 or sc == w - 1:
   192	        return int(sr), int(w // 2)
   193	    return int(sr), int(sc)
