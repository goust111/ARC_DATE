+def _project_edge_source(h: int, w: int, sr: int, sc: int) -> tuple[int, int]:
+    sr = int(sr)
+    sc = int(sc)
+    if sr == 0 or sr == h - 1:
+        return int(h // 2), int(sc)
+    if sc == 0 or sc == w - 1:
+        return int(sr), int(w // 2)
+    return int(sr), int(sc)
