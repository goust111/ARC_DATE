+def _legend_size_from_rel(rel: list[tuple[int, int]]) -> tuple[int, int]:
+    min_r, min_c, max_r, max_c = _legend_bbox_from_rel(rel)
+    return int(max_r - min_r + 1), int(max_c - min_c + 1)
