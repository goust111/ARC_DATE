   292	def main(grid: np.ndarray) -> np.ndarray:
   293	    """
   294	    Learn edge legends, project edge controls inward, then crop the rebuilt scene.
   295	
   296	    Input structure:
   297	    - A black-background grid contains teal (8) stencil components and colored
   298	      pixels, but the true rule examples live on the border rather than in the
   299	      interior.
   300	    - Each rule example is still a 4-neighbor source->target pair whose forward
   301	      continuation reaches an anchor touching a teal stencil; in generated
   302	      samples these legends sit on the top edge, while the activatable source
   303	      pixels appear as isolated edge controls on the border.
   304	
   305	    Rule:
   306	    - Learn the same source-color -> target-color + teal-stencil mapping from
   307	      each local legend.
   308	    - For every non-legend source pixel, do not stamp at the border cell
   309	      itself; instead project that edge pixel inward onto the grid's middle row
   310	      or middle column, then translate the stencil there and recolor it with
   311	      the target color.
   312	    - Preserve non-rule bystanders, rebuild the visible rule legends as a
   313	      compact strip along the top edge of the result, and finally tight-crop to
   314	      the minimal rectangle containing all non-background output pixels.
   315	
   316	    Key insight: Edge pixels now play two different roles. Some edge pixels are
   317	    legends that teach the color/stencil rule, while other edge pixels are
   318	    control markers whose row/column is projected into the center where the
   319	    actual painted result appears.
   320	    """
   321	    core, rules, bg = _solve_core(np.asarray(grid, dtype=int))
   322	    core_crop = _tight_crop_non_bg(core, bg=bg)
   323	    legend_strip = _build_legend_strip(rules, bg=bg)
   324	    return _stack_legend_and_core(legend_strip, core_crop, bg=bg)
