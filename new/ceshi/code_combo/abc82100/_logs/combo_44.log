   336	def _make_stencil(min_pixels: int, max_pixels: int) -> tuple[list[tuple[int, int]], tuple[int, int]]:
   337	    for _ in range(STENCIL_SHAPE_RETRIES):
   338	        target = random.randint(int(min_pixels), int(max_pixels))
   339	        coords = {(0, 0)}
   340	        while len(coords) < target:
   341	            frontier = set()
   342	            for r, c in coords:
   343	                for dr, dc in _DIRS8:
   344	                    cand = (int(r + dr), int(c + dc))
   345	                    if cand in coords:
   346	                        continue
   347	                    trial = coords | {cand}
   348	                    rs = [pt[0] for pt in trial]
   349	                    cs = [pt[1] for pt in trial]
   350	                    if max(rs) - min(rs) + 1 > STENCIL_MAX_H:
   351	                        continue
   352	                    if max(cs) - min(cs) + 1 > STENCIL_MAX_W:
   353	                        continue
   354	                    frontier.add(cand)
   355	            if not frontier:
   356	                break
   357	            coords.add(random.choice(list(frontier)))
   358	
   359	        if len(coords) < min_pixels:
   360	            continue
   361	
   362	        coords_list = sorted(coords)
   363	        min_r = min(r for r, _c in coords_list)
   364	        anchors = [pt for pt in coords_list if int(pt[0]) == int(min_r)]
   365	        anchor = random.choice(anchors)
   366	        return coords_list, anchor
   367	
   368	    raise RuntimeError("failed to build stencil")
