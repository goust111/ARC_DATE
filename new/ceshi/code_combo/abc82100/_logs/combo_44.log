   327	def _reserve_4neighbors(reserved: set[tuple[int, int]], cells) -> None:
   328	    for r, c in cells:
   329	        r = int(r)
   330	        c = int(c)
   331	        reserved.add((r, c))
   332	        for dr, dc in _DIRS4:
   333	            reserved.add((int(r + dr), int(c + dc)))
