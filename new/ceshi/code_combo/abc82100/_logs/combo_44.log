   377	def _build_rules(num_rules: int, area: int) -> tuple[list[dict], set[int]]:
   378	    colors = NON_BG_NON_TEAL_COLORS[:]
   379	    random.shuffle(colors)
   380	
   381	    max_pixels = min(STENCIL_MAX_CAP, max(STENCIL_MIN_PIXELS, area // 35))
   382	    max_pixels = max(STENCIL_MIN_PIXELS, max_pixels)
   383	
   384	    rules: list[dict] = []
   385	    used_colors: set[int] = set()
   386	    for i in range(num_rules):
   387	        src_c = int(colors[2 * i])
   388	        tgt_c = int(colors[2 * i + 1])
   389	        used_colors.update((src_c, tgt_c))
   390	        stencil, anchor = _make_stencil(STENCIL_MIN_PIXELS, max_pixels)
   391	        rel = [(int(r - anchor[0]), int(c - anchor[1])) for r, c in stencil]
   392	        rule = {
   393	            "src": src_c,
   394	            "tgt": tgt_c,
   395	            "rel": rel,
   396	            "bounds": _rel_bounds(rel),
   397	            "n_sc": random.randint(SCATTERED_MIN, SCATTERED_MAX),
   398	        }
   399	        leg_h, leg_w = _legend_size_from_rel(rel)
   400	        rule["legend_h"] = int(leg_h)
   401	        rule["legend_w"] = int(leg_w)
   402	        rules.append(rule)
   403	    return rules, used_colors
