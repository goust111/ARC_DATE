   214	def _build_legend_strip(rules: list[dict], bg: int, gap: int = LEGEND_GAP) -> np.ndarray:
   215	    if not rules:
   216	        return np.full((0, 0), int(bg), dtype=int)
   217	
   218	    ordered = sorted(rules, key=lambda rule: (int(rule["source_pos"][1]), int(rule["source_pos"][0])))
   219	    blocks = [_render_legend_block(rule, bg=bg) for rule in ordered]
   220	    height = max(int(block.shape[0]) for block in blocks)
   221	    width = sum(int(block.shape[1]) for block in blocks) + gap * max(0, len(blocks) - 1)
   222	    strip = np.full((height, width), int(bg), dtype=int)
   223	
   224	    cur = 0
   225	    for block in blocks:
   226	        bh, bw = block.shape
   227	        mask = block != int(bg)
   228	        strip[0:bh, cur : cur + bw][mask] = block[mask]
   229	        cur += int(bw) + gap
   230	    return strip
