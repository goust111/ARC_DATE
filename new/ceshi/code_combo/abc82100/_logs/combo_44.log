   426	        target_pos = (1, int(anchor_c))
   427	        anchor = (2, int(anchor_c))
   428	        teal_cells = {(int(anchor[0] + rr), int(anchor[1] + cc)) for rr, cc in rule["rel"]}
   429	        visible_cells = {source_pos, target_pos} | teal_cells
