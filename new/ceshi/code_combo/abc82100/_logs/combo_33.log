+def _pattern_bbox(pattern: np.ndarray) -> tuple[int, int, int, int]:
+    rows = pattern[:, 0]
+    cols = pattern[:, 1]
+    return int(rows.min()), int(cols.min()), int(rows.max()), int(cols.max())
