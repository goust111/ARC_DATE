   485	def _make_fragmented_stencil(min_pixels: int, max_pixels: int) -> np.ndarray:
   486	    for _ in range(FRAGMENT_RETRIES):
   487	        total = random.randint(max(STENCIL_TOTAL_MIN, min_pixels), max_pixels)
   488	        n_fragments = random.randint(FRAGMENT_COUNT_MIN, min(FRAGMENT_COUNT_MAX, total))
   489	        sizes = _random_partition(total, n_fragments, FRAGMENT_SIZE_CAP)
   490	        if not sizes:
   491	            continue
   492	
   493	        fragments: list[set[tuple[int, int]]] = []
   494	        first = _grow_fragment((0, 0), sizes[0], blocked=set())
   495	        if first is None:
   496	            continue
   497	        fragments.append(first)
   498	        used = set(first)
   499	
   500	        ok = True
   501	        for size in sizes[1:]:
   502	            starts = [
   503	                cell
   504	                for cell in _LOCAL_CELLS
   505	                if cell not in used and _far_from_cells(cell, used)
   506	            ]
   507	            if not starts:
   508	                ok = False
   509	                break
   510	            start = random.choice(starts)
   511	            fragment = _grow_fragment(start, size, blocked=used)
   512	            if fragment is None:
   513	                ok = False
   514	                break
   515	            fragments.append(fragment)
   516	            used.update(fragment)
   517	        if not ok or len(fragments) < FRAGMENT_COUNT_MIN:
   518	            continue
   519	
   520	        local_coords = sorted(used)

