   445	
   446	def _random_partition(total: int, parts: int, piece_cap: int) -> list[int]:
   447	    pieces = [1] * parts
   448	    remaining = total - parts
   449	    while remaining > 0:
   450	        candidates = [i for i, size in enumerate(pieces) if size < piece_cap]
   451	        if not candidates:
   452	            return []
   453	        idx = random.choice(candidates)
   454	        pieces[idx] += 1
   455	        remaining -= 1
   456	    random.shuffle(pieces)
   457	    return pieces
   458	
   459	
   460	def _grow_fragment(
   461	    start: tuple[int, int],
   462	    size: int,
   463	    blocked: set[tuple[int, int]],
   464	) -> set[tuple[int, int]] | None:
   465	    fragment = {start}
   466	    while len(fragment) < size:
   467	        frontier: set[tuple[int, int]] = set()
   468	        for r, c in fragment:
   469	            for dr, dc in _DIRS8:
   470	                nr, nc = int(r) + dr, int(c) + dc
   471	                cell = (int(nr), int(nc))
   472	                if cell in fragment:
   473	                    continue
   474	                if max(abs(cell[0]), abs(cell[1])) > LOCAL_RADIUS:
   475	                    continue
   476	                if not _far_from_cells(cell, blocked):
   477	                    continue
   478	                frontier.add(cell)
   479	        if not frontier:
   480	            return None
   481	        fragment.add(random.choice(sorted(frontier)))
   482	    return fragment
