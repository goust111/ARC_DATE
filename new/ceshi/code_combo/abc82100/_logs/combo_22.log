   368	def main(grid: np.ndarray) -> np.ndarray:
   369	    """
   370	    Reconstruct fragmented teal legends and stamp their rotated or mirrored unions.
   371	
   372	    Input structure:
   373	    - The background is black, with local rule legends made from a source->target
   374	      color pair and a nearby teal(8) anchor window.
   375	    - Inside each legend window, the teal template is split into several detached
   376	      fragments rather than one connected component.
   377	    - Each scattered occurrence is a 3-cell seed: a source-colored center, a
   378	      same-color forward arm, and a target-colored side arm.
   379	
   380	    Rule:
   381	    - For every legend, merge all teal fragments in the anchor's compact local
   382	      window into one template and express that template in the legend's local frame.
   383	    - For every matching scattered seed, rotate the merged template so its forward
   384	      axis matches the seed's same-color arm; if the target-colored arm is on the
   385	      opposite side, mirror the rotated template before stamping.
   386	    - Recolor every stamped pixel to the legend target color, and erase legends,
   387	      teal fragments, and seed markers from the output.
   388	
   389	    Key insight:
   390	    - The solver must perform two linked spatial steps in order: first group several
   391	      nearby teal islands into one stencil, then apply a dihedral transform chosen
   392	      by the seed's two short arms before copying that full fragmented stencil.
   393	    """
   394	    g = np.asarray(grid, dtype=int)
   395	    bg = get_bg(g)
   396	    pattern_color = 8
   397	    h, w = g.shape
   398	
   399	    rules = _discover_rules(g, bg=bg, pattern_color=pattern_color)
   400	    legend_pixels: set[tuple[int, int]] = set()
   401	    source_colors: set[int] = set()
   402	    for rule in rules:
   403	        legend_pixels.add(rule["source_pos"])
   404	        legend_pixels.add(rule["target_pos"])
   405	        source_colors.add(rule["source_color"])
   406	
   407	    seeds_by_rule: list[list[dict]] = []
   408	    seed_pixels: set[tuple[int, int]] = set()
   409	    for rule in rules:
   410	        seeds = _find_rule_seeds(g, rule=rule, legend_pixels=legend_pixels, bg=bg)
   411	        seeds_by_rule.append(seeds)
   412	        for seed in seeds:
   413	            seed_pixels.update(seed["cells"])
   414	
   415	    out = np.full_like(g, int(bg))
   416	
   417	    for r, c in map(tuple, np.argwhere((g != int(bg)) & (g != pattern_color))):
   418	        r = int(r)
   419	        c = int(c)
   420	        color = int(g[r, c])
   421	        if (r, c) in legend_pixels or (r, c) in seed_pixels or color in source_colors:
   422	            continue
   423	        out[r, c] = color
   424	
   425	    for rule, seeds in zip(rules, seeds_by_rule):
   426	        local_pattern = rule["local_pattern"]
   427	        for seed in seeds:
   428	            placed = _apply_local_pattern(
   429	                local_pattern,
   430	                anchor=seed["center"],
   431	                forward=seed["forward"],
   432	                flip=seed["flip"],
   433	            )
   434	            rows = placed[:, 0]
   435	            cols = placed[:, 1]
   436	            ok = (0 <= rows) & (rows < h) & (0 <= cols) & (cols < w)
   437	            out[rows[ok], cols[ok]] = int(rule["target_color"])
   438	
   439	    return out
