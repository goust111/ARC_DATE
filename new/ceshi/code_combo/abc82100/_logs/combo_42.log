+def _place_actors(
+    rules: list[dict],
+    footprints: dict[int, dict[int, set[tuple[int, int]]]],
+    inp: np.ndarray,
+    occupied: set[tuple[int, int]],
+    reserved: set[tuple[int, int]],
+) -> tuple[bool, dict[int, list[tuple[int, int]]], dict[int, set[tuple[int, int]]]]:
