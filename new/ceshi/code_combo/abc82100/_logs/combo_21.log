   306	
   307	    keep_mask = (g != int(bg)) & (g != int(PATTERN_COLOR)) & (g != int(MARKER_COLOR))
   308	    for r, c in map(tuple, np.argwhere(keep_mask)):
   309	        pos = (int(r), int(c))
   310	        if pos in legend_pixels or pos in local_source_pixels:
   311	            continue
   312	        out[pos] = int(g[pos])
