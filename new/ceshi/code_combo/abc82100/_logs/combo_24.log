+
+def _anchor_wrap_cells(rule: dict, sr: int, sc: int, h: int, w: int) -> set[tuple[int, int]]:
+    ar, ac = rule["anchor"]
+    cells: set[tuple[int, int]] = set()
+    for rr, cc in rule["cells"]:
+        raw_r = int(sr + rr - ar)
+        raw_c = int(sc + cc - ac)
+        cells.add((raw_r % h, raw_c % w))
+    return cells
