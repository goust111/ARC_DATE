+
+def _quadrant_ranges(h: int, w: int) -> dict[str, tuple[range, range]]:
+    r_split = (h + 1) // 2
+    c_split = (w + 1) // 2
+    return {
+        "tl": (range(0, r_split), range(0, c_split)),
+        "tr": (range(0, r_split), range(c_split, w)),
+        "bl": (range(r_split, h), range(0, c_split)),
+        "br": (range(r_split, h), range(c_split, w)),
