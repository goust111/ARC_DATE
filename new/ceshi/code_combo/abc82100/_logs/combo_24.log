+# --------------- generator (c) ---------------
+
+GRID_SHORT_DIM = 8
+GRID_LONG_DIM_OPTIONS = [8, 9, 10]
+
+RULE_COUNT_WEIGHTS = [1]
+NON_BG_NON_TEAL_COLORS = [1, 2, 3, 4, 5, 6, 7, 9]
+
+STENCIL_MIN_PIXELS = 9
+STENCIL_MAX_CAP = 12
+STENCIL_EXTRA_PIXELS_MAX = 3
+
+SCATTERED_MIN = 4
+SCATTERED_MAX = 6
+BYSTANDER_MAX = 3
