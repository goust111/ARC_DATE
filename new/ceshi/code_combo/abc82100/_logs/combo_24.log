def _wrapped_stamp_cells(
    rel: list[tuple[int, int]], sr: int, sc: int, h: int, w: int
) -> tuple[set[tuple[int, int]], bool, bool]:
    cells: set[tuple[int, int]] = set()
    wraps_row = False
    wraps_col = False
    for rr, cc in rel:
        raw_r = int(sr + rr)
        raw_c = int(sc + cc)
        if not (0 <= raw_r < h):
            wraps_row = True
        if not (0 <= raw_c < w):
