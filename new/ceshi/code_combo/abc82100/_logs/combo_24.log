+
+def _build_anchor_wrap_output(rules, bystanders, h: int, w: int) -> np.ndarray:
+    out = np.zeros((h, w), dtype=int)
+    for r, c, bc in bystanders:
+        out[int(r), int(c)] = int(bc)
+    for rule in rules:
