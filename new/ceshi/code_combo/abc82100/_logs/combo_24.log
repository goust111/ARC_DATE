+        "clipped_diff_sources": 0,
+        "quadrant_sources": 0,
+    }
+    for rule in rules:
+        quadrants = {_quadrant_key(int(sr), int(sc), h, w) for sr, sc in rule["scattered"]}
+        metrics["quadrant_sources"] += len(quadrants)
+        for sr, sc in rule["scattered"]:
