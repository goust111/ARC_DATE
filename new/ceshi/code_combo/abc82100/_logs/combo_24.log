+def _combo_origin(rule: dict, sr: int, sc: int, h: int, w: int) -> tuple[int, int]:
+    ph, pw = rule["size"]
+    quadrant = _quadrant_key(sr, sc, h, w)
+    if quadrant == "tl":
+        return sr, sc
+    if quadrant == "tr":
+        return sr, sc - (pw - 1)
+    if quadrant == "bl":
+        return sr - (ph - 1), sc
+    return sr - (ph - 1), sc - (pw - 1)
