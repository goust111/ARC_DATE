+def _pattern_corner(pattern: np.ndarray, quadrant: str) -> tuple[int, int]:
+    rows = pattern[:, 0]
+    cols = pattern[:, 1]
+    r0 = int(rows.min())
+    r1 = int(rows.max())
+    c0 = int(cols.min())
+    c1 = int(cols.max())
+    if quadrant == "tl":
+        return r0, c0
+    if quadrant == "tr":
+        return r0, c1
+    if quadrant == "bl":
+        return r1, c0
+    return r1, c1
