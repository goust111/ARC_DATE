+    row_hi = min(h - 2, h - max(2, h // 3) - 1)
+    col_lo = max(2, w // 4)
+    col_hi = min(w - 3, w - max(2, w // 4) - 1)
+    return int(row_lo), int(row_hi), int(col_lo), int(col_hi)
