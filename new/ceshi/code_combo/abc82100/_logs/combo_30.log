+STENCIL_AREA_RANGE = (4, 7)
+SCATTERED_COUNT_RANGE = (4, 7)
+SCATTERED_COLOR_COUNT_RANGE = (2, 4)
+SCATTERED_RETRIES_PER_PIXEL = 120
+OUTER_RETRIES = 300
+
+_DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
