+def _reserve_4neighbors(reserved: set[tuple[int, int]], cells: list[tuple[int, int]]) -> None:
+    for r, c in cells:
+        for dr, dc in _DIRS4:
+            reserved.add((int(r) + dr, int(c) + dc))
