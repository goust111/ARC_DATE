+LEGEND_HEIGHT = 3
+LEGEND_WIDTH = 6
+LEGEND_SEPARATOR = 1
+TEMPLATE_H = 3
+TEMPLATE_W = 4
+TEMPLATE_COL0 = 2
+ANCHOR_LOCAL = (1, 1)
