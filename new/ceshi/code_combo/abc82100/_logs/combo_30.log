+    anchor = (r0 + ANCHOR_LOCAL[0], c0 + ANCHOR_LOCAL[1])
+    legend_left = c0 - TEMPLATE_COL0
+    legend_right = legend_left + LEGEND_WIDTH - 1
+    if legend_left < 0 or legend_right >= grid.shape[1]:
