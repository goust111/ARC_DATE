+    rows = pattern[:, 0]
+    cols = pattern[:, 1]
+    r0 = max(0, int(rows.min()) - 1)
+    r1 = min(grid.shape[0] - 1, int(rows.max()) + 1)
+    c0 = max(0, int(cols.min()) - 1)
+    c1 = min(grid.shape[1] - 1, int(cols.max()) + 1)
+
+    template_cells: list[tuple[int, int, int]] = []
+    for r in range(r0, r1 + 1):
