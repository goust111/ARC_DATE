+# --------------- generator (combo: C4 + conditional corner rotation) ---------------
+
+# -- CFG: canvas & structure --
+GRID_SIZE_MIN, GRID_SIZE_MAX = 16, 19
+BLOCK = 3
+MOTIF_SIZE = BLOCK * 3
+EXPANDED_SIZE = BLOCK * 5
+MOTIF_PAD = 3
+
+# -- CFG: colors --
