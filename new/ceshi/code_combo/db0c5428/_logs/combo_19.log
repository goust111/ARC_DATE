+BLOCK_OPTIONS = (2, 4)
+GRID_SIZE_BY_BLOCK = {
+    2: (14, 18),
+    4: (22, 26),
+}
+BG = 8
+FOREGROUND_COLORS = [1, 2, 3, 4, 5, 6, 7, 9]
+COLOR_COUNT_MIN, COLOR_COUNT_MAX = 2, 4
+MAJORITY_SHARE_MIN, MAJORITY_SHARE_MAX = 0.55, 0.80
+MAX_RETRIES = 500
+BLOCK_BUILD_RETRIES = 400
+
