+    return _apply_transform(base_mask, random.randrange(8))
+
+
+def _choose_surrounding_transforms(base_mask: np.ndarray, center_mask: np.ndarray) -> dict[tuple[int, int], int]:
+    options: dict[tuple[int, int], list[int]] = {}
