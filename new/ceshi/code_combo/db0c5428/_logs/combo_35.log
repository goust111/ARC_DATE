import itertools
import numpy as np

def tf(arr, idx):
    if idx == 0: return arr.copy()
    if idx == 1: return np.rot90(arr, 1)
    if idx == 2: return np.rot90(arr, 2)
    if idx == 3: return np.rot90(arr, 3)
    if idx == 4: return np.fliplr(arr)
    if idx == 5: return np.flipud(arr)
    if idx == 6: return arr.T.copy()
    if idx == 7: return np.fliplr(arr.T)

cands = []
coords = [(r,c) for r in range(3) for c in range(3) if (r,c)"'!=(1,1)]
for k in (2,3):
    for comb in itertools.combinations(coords, k):
        arr = np.zeros((3,3), dtype=np.uint8)
        for rc in comb: arr[rc]=1
        uniq = {tf(arr,i).tobytes() for i in range(8)}
        if len(uniq)==8:
            cands.append(arr)
            if len(cands)>=10:
                break
    if len(cands)>=10:
        break
for i, arr in enumerate(cands[:10]):
    print('"'cand', i)
    print(arr)
