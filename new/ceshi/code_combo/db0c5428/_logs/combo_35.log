+    n = random.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)
+    majority, accent = random.sample(FOREGROUND_COLORS, 2)
+    base_mask = TEMPLATE_LIBRARY[random.randrange(len(TEMPLATE_LIBRARY))].copy()
