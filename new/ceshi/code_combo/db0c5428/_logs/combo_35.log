+
+def _apply_transform(arr: np.ndarray, idx: int) -> np.ndarray:
+    if idx == 0:
+        return arr.copy()
+    if idx == 1:
+        return np.rot90(arr, 1)
+    if idx == 2:
+        return np.rot90(arr, 2)
+    if idx == 3:
+        return np.rot90(arr, 3)
+    if idx == 4:
+        return np.fliplr(arr)
+    if idx == 5:
