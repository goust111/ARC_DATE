+    bl = _make_block(GENERAL_ORBITS, majority, minor_colors, [(0, 2)], forbid_ud=True, forbid_lr=True)
+    tm = _make_block(LR_ORBITS, majority, minor_colors, [(2, 1)], forbid_ud=True)
