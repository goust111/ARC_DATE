+    motif = np.full((MOTIF_SIZE, MOTIF_SIZE), BG, dtype=int)
+    blocks = {
+        (0, 0): tl,
+        (0, 1): tm,
+        (0, 2): np.fliplr(tl),
+        (1, 0): ml,
+        (1, 2): np.fliplr(ml),
+        (2, 0): bl,
+        (2, 1): bm,
+        (2, 2): np.fliplr(bl),
+    }
