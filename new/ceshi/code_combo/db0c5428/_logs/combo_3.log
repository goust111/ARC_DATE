+    blocks = {
+        (0, 0): tl,
+        (0, 1): tm,
+        (0, 2): tr,
+        (1, 0): ml,
+        (1, 2): mr,
+        (2, 0): np.flipud(tl),
+        (2, 1): np.flipud(tm),
+        (2, 2): np.flipud(tr),
