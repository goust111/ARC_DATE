+    tm = _make_block(GENERAL_ORBITS, majority, minor_colors, [(2, 1)], forbid_ud=True, forbid_lr=True)
+    tr = _make_block(GENERAL_ORBITS, majority, minor_colors, [(2, 0)], forbid_ud=True, forbid_lr=True)
