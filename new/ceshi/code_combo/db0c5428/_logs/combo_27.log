+EDGE_MAJOR_MIN, EDGE_MAJOR_MAX = 5, 8
+
+# -- CFG: generation --
+MAX_RETRIES = 300
+
+# -- Symmetry orbits for 3x3 blocks --
+DIAG_ORBITS = (
+    ((0, 0),),
+    ((1, 1),),
+    ((2, 2),),
+    ((0, 1), (1, 0)),
+    ((0, 2), (2, 0)),
+    ((1, 2), (2, 1)),
+)
+LR_ORBITS = (
+    ((0, 0), (0, 2)),
+    ((1, 0), (1, 2)),
+    ((2, 0), (2, 2)),
+    ((0, 1),),
+    ((1, 1),),
+    ((2, 1),),
+)
+
