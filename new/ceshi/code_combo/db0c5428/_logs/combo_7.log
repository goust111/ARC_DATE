+    "down": (5, 3),
+    "left": (3, 5),
+    "right": (3, 5),
+}
+
+BOUNDARY_BINDINGS = (
+    ((0, 0), (0, 0, 2, 2)),
+    ((0, 1), (0, 1, 2, 1)),
+    ((0, 2), (0, 2, 2, 0)),
+    ((1, 0), (1, 0, 1, 2)),
