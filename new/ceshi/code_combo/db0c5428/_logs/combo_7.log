+    vals = _signature_values(block_arr, direction)
+    if len(set(vals)) != 1:
+        return
+    r, c = SIGNATURE_POS[direction][0]
+    choices = [color for color in palette if color != vals[0]]
+    block_arr[r, c] = random.choice(choices)
