+MOTIF_PAD = 3
+
+BG = 8
+FOREGROUND_COLORS = [1, 2, 3, 4, 5, 6, 7, 9]
+COLOR_COUNT_MIN, COLOR_COUNT_MAX = 3, 4
+MAX_RETRIES = 400
+
+SIDE_BLOCK = {
+    "up": (0, 1),
+    "down": (2, 1),
+    "left": (1, 0),
+    "right": (1, 2),
+}
+
