+BLOCK = 3
+MOTIF_BLOCKS = 3
+MOTIF_SIZE = BLOCK * MOTIF_BLOCKS
+GRID_SIZE_MIN, GRID_SIZE_MAX = 16, 19
+MOTIF_PAD = 3
+
+BG = 8
+FOREGROUND_COLORS = [1, 2, 3, 4, 5, 6, 7, 9]
+COLOR_COUNT_MIN, COLOR_COUNT_MAX = 3, 4
+MAX_RETRIES = 400
+
+SIDE_BLOCK = {
+    "up": (0, 1),
+    "down": (2, 1),
+    "left": (1, 0),
+    "right": (1, 2),
+}
+
+SIGNATURE_POS = {
+    "up": ((0, 0), (0, 1), (0, 2), (1, 1)),
+    "down": ((2, 0), (2, 1), (2, 2), (1, 1)),
+    "left": ((0, 0), (1, 0), (2, 0), (1, 1)),
+    "right": ((0, 2), (1, 2), (2, 2), (1, 1)),
+}
+
+SOURCE_SLOTS = {
+    "up": ((2, 0), (2, 1), (2, 2)),
+    "down": ((0, 0), (0, 1), (0, 2)),
+    "left": ((0, 2), (1, 2), (2, 2)),
+    "right": ((0, 0), (1, 0), (2, 0)),
+}
+
+OUTER_DST_SLOTS = {
+    "up": ((0, 0), (0, 1), (0, 2)),
+    "down": ((4, 0), (4, 1), (4, 2)),
+    "left": ((0, 0), (1, 0), (2, 0)),
+    "right": ((0, 4), (1, 4), (2, 4)),
