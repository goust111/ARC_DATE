+    patch[0, -1] = int(g[hole_r - 1, hole_c + block])
+    patch[-1, 0] = int(g[hole_r + block, hole_c - 1])
+    patch[-1, -1] = int(g[hole_r + block, hole_c + block])
+    return patch
