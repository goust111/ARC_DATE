+def _gen_attempt() -> np.ndarray | None:
+    block = random.choice(BLOCK_CHOICES)
+    n_min, n_max = GRID_SIZE_BY_BLOCK[block]
+    n = random.randint(n_min, n_max)
+    majority = random.choice(FOREGROUND_COLORS)
