+        paste(motif, blk, br * block, bc * block)
+    return motif
+
+
+def _expanded_output(motif: np.ndarray, center: np.ndarray, block: int) -> np.ndarray:
+    expanded = np.full((block * 5, block * 5), BG, dtype=int)
+    output_motif = motif.copy()
