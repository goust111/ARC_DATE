+    lr_orbits = _lr_orbits(block)
+    max_minor_orbits = len(diag_orbits) + len(lr_orbits) - 1
+    color_count_max = min(COLOR_COUNT_MAX_BY_BLOCK[block], max_minor_orbits + 1)
