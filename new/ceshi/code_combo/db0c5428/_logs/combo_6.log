+    patch[0, :] = g[hole_r - 1, hole_c : hole_c + block]
+    patch[-1, :] = g[hole_r + block, hole_c : hole_c + block]
+    patch[:, 0] = g[hole_r : hole_r + block, hole_c - 1]
+    patch[:, -1] = g[hole_r : hole_r + block, hole_c + block]
