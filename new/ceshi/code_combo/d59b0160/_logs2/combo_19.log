+    keeping only non-bg and non-border cells, and we also record their interior coordinates.
+    """
+    h, w = g.shape
+    sizes = [LEGEND_SIZE] + [sz for sz in range(2, min(h, w) + 1) if sz != LEGEND_SIZE]
+    for sz in sizes:
