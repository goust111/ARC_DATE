+        if x == bg:
+            continue
+        if np.all(g[sz - 1, 0:sz] == x) and np.all(g[0:sz, sz - 1] == x):
+            inside = g[0 : sz - 1, 0 : sz - 1]
+            seq: list[int] = []
+            pos: list[tuple[int, int]] = []
+            for r in range(inside.shape[0]):
+                for c in range(inside.shape[1]):
+                    color = int(inside[r, c])
+                    if color not in (bg, x):
