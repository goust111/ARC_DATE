+    placement_canvas = _legend_reserved_canvas(inp)
+    for role in roles:
+        patch = _build_patch(role, legend_targets, required_targets)
+        try:
+            r, c = random_free_location(
+                placement_canvas,
+                patch,
+                transparent=BG,
+                border=1,
+                padding=1,
+                padding_connectivity=8,
+            )
+        except ValueError:
