    elif total_components == 5:
        sizes = [2, 3]
    else:
        sizes = [2, 2, 2]

    groups = [[True, False]]
    idx = 0
    for size in sizes[1:]:
        group = remaining[idx : idx + size]
        random.shuffle(group)
        groups.append(group)
        idx += size
    return groups


