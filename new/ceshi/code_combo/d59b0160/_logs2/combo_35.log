print('matched_pairwise_touch distribution:', dict(sorted(Counter(matched_counts).items())))
print(f'combo differs from original on {diff_vs_base}/{samples} samples')
print(f'combo differs from D2-only on {diff_vs_d2}/{samples} samples')
