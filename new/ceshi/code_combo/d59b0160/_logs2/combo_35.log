+def generate_input() -> np.ndarray:
+    """Sample a valid input grid whose output exhibits both the D2 and D16 changes."""
+    for _ in range(MAX_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate valid input")

