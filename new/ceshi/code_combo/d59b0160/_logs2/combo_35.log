+            )
+        except ValueError:
+            return None
+
+        paste(inp, patch, r, c)
+        if role == "matched":
+            paste(out, _filtered_patch(patch, targets), r, c)
+        else:
+            paste(out, patch, r, c)
+
+    if np.array_equal(main(inp), out):
+        return inp
+    return None
+
+
+def generate_input() -> np.ndarray:
+    """Sample a valid input grid whose output exhibits both the D2 and D16 changes."""
