+def _sample_pairwise_nonadjacent_coords(h: int, w: int, k: int) -> list[tuple[int, int]]:
+    """Sample k coords with pairwise Manhattan distance > 1."""
+    coords = _all_coords(h, w)
+    for _ in range(80):
+        random.shuffle(coords)
