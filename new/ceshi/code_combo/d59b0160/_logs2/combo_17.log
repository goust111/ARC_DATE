+    assert False, "no legend border found in grid"
+
+
+def _component_bbox(pts: np.ndarray) -> tuple[int, int, int, int]:
+    rs = pts[:, 0]
+    cs = pts[:, 1]
+    return int(rs.min()), int(cs.min()), int(rs.max()), int(cs.max())
