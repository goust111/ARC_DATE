+    solved = main(inp)
+    if not np.array_equal(solved, out):
+        return None
+
+    bg = _bg_boundary(inp)
+    legend_colors = _find_legend(inp, bg)[2]
+    match_infos: list[tuple[int, int]] = []
+    for pts in components_mask(inp != bg, connectivity=4):
+        cols = {int(inp[int(r), int(c)]) for r, c in pts}
