+# --------------- generator (combo 36) ---------------
+
+GRID_H, GRID_W = 16, 16
+BG = 7
+BORDER = 3
+LEGEND_SIZE = 4
+PALETTE = [1, 2, 4, 5, 6, 8, 9]
+NUM_TARGETS = 3
+
+SHAPE_WEIGHTS = [5, 3, 2]  # medium, tall, wide
+TALL_H = (7, 12)
+TALL_W = (2, 4)
+WIDE_H = (3, 5)
+WIDE_W = (5, 8)
+MED_H = (3, 6)
+MED_W = (2, 8)
+
+DENSITY_LO = 0.10
+DENSITY_HI = 0.55
+
+NONMATCH_COUNT = 3
+MATCH_COUNTS = [2, 3]
+MATCH_WEIGHTS = [3, 2]
+MIN_MATCH_AREA = 10
+MAX_MATCH_AREA = 30
+MIN_OTHER_MATCH_AREA = 6
