+    return _erase_matching_components(g, bg, legend_colors)
+
+
+# --------------- generator (combo variant) ---------------
+
+GRID_H, GRID_W = 16, 16
+BG = 7
+BORDER = 3
+PALETTE = [1, 2, 4, 5, 6, 8, 9]
+NUM_TARGETS = 3
+NUM_DISTRACTORS = 3
