                seen.add(key)

                legend_cells = {(int(r), int(c)), (int(tr), int(tc)), tuple(anchor)}
                legend_cells.update((int(pr), int(pc)) for pr, pc in np.asarray(pattern, dtype=int))
                rules.append(
