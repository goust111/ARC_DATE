+def _find_legend(g: np.ndarray, bg: int) -> dict:
+    h, w = map(int, g.shape)
+    candidates: list[dict] = []
+
+    for inner_size in range(MIN_INNER, MAX_INNER + 1):
+        total_size = inner_size + 1
