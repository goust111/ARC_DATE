+GRID_H, GRID_W = 16, 16
+BG = 7
+BASE_COLOR = 0
+EDGE_NAMES = ("top", "bottom", "left", "right")
+BORDER_POOL = [1, 2, 3, 4, 5, 6, 8, 9]
+MIN_INNER = 2
+MAX_INNER = 5
+
+EDGE_TO_ORIENTATIONS = {
+    "top": ("br", "bl"),
+    "bottom": ("tr", "tl"),
+    "left": ("br", "tr"),
+    "right": ("bl", "tl"),
+}
+
+SHAPE_WEIGHTS = [5, 3, 2]
+TALL_H = (7, 12)
+TALL_W = (2, 4)
+WIDE_H = (3, 5)
+WIDE_W = (5, 8)
+MED_H = (3, 7)
+MED_W = (2, 8)
+
+DENSITY_LO = 0.10
+DENSITY_HI = 0.55
