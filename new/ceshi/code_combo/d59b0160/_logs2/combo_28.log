+def _iter_edge_windows(h: int, w: int, total_size: int):
+    sz = int(total_size)
+    for c0 in range(1, w - sz):
+        yield "top", 0, int(c0)
+        yield "bottom", int(h - sz), int(c0)
+    for r0 in range(1, h - sz):
+        yield "left", int(r0), 0
+        yield "right", int(r0), int(w - sz)
