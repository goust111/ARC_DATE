+GRID_H, GRID_W = 16, 16
+BG = 7
+BASE_COLOR = 0
+EDGE_NAMES = ("top", "bottom", "left", "right")
+BORDER_POOL = [1, 2, 3, 4, 5, 6, 8, 9]
+MIN_INNER = 2
+MAX_INNER = 5
+
+EDGE_TO_ORIENTATIONS = {
+    "top": ("br", "bl"),
+    "bottom": ("tr", "tl"),
+    "left": ("br", "tr"),
+    "right": ("bl", "tl"),
