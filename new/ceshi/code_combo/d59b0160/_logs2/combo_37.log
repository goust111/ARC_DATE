   241	def _place_legend(inp: np.ndarray, out: np.ndarray, targets: list[int]) -> None:
   242	    """Draw the 4x4 legend and place three target colors with one guaranteed isolated swatch."""
   243	    s = LEGEND_SIZE
   244	    for g in (inp, out):
   245	        g[:s, :s] = BG
   246	        g[s - 1, :s] = BORDER
   247	        g[:s, s - 1] = BORDER
   248	
   249	    isolated = random.choice([(0, 1), (1, 0), (1, 1)])
   250	    border_side = [(0, 2), (1, 2), (2, 0), (2, 1), (2, 2)]
   251	    side_choices = [
   252	        p for p in border_side
   253	        if abs(p[0] - isolated[0]) + abs(p[1] - isolated[1]) != 1
   254	    ]
   255	    positions = [isolated] + random.sample(side_choices, 2)
   256	    random.shuffle(positions)
   257	    for color, (r, c) in zip(targets, positions):
   258	        inp[r, c] = color
   259	        out[r, c] = color
