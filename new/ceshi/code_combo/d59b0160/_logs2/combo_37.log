   209	DEL_TALL_H = (6, 10)
   210	DEL_TALL_W = (2, 4)
   211	DEL_WIDE_H = (3, 5)
   212	DEL_WIDE_W = (5, 8)
   213	DEL_MED_H = (3, 6)
   214	DEL_MED_W = (2, 7)
