   263	    """Sample component dimensions with slightly tighter kept-object bounds for reliable repacking."""
   264	    mode = random.choices(["medium", "tall", "wide"], weights=SHAPE_WEIGHTS)[0]
   265	    if deleted:
   266	        if mode == "tall":
   267	            return random.randint(*DEL_TALL_H), random.randint(*DEL_TALL_W)
   268	        if mode == "wide":
   269	            return random.randint(*DEL_WIDE_H), random.randint(*DEL_WIDE_W)
   270	        return random.randint(*DEL_MED_H), random.randint(*DEL_MED_W)
   271	    if mode == "tall":
   272	        return random.randint(*KEEP_TALL_H), random.randint(*KEEP_TALL_W)
   273	    if mode == "wide":
   274	        return random.randint(*KEEP_WIDE_H), random.randint(*KEEP_WIDE_W)
   275	    return random.randint(*KEEP_MED_H), random.randint(*KEEP_MED_W)
