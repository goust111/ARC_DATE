   277	
   278	def _component_patch(h: int, w: int, targets: list[int], deleted: bool) -> np.ndarray:
   279	    """Build an h x w solid color-0 component with sprinkled palette cells."""
   280	    area = h * w
   281	    lo = max(1, math.ceil(area * DENSITY_LO))
   282	    hi = max(lo, math.floor(area * DENSITY_HI))
   283	    if deleted:
   284	        lo = max(lo, NUM_TARGETS)
   285	
   286	    n_colored = random.randint(lo, hi)
   287	    coords = random.sample([(r, c) for r in range(h) for c in range(w)], n_colored)
   288	    non_targets = [v for v in PALETTE if v not in targets]
   289	
   290	    if deleted:
   291	        colors = list(targets) + [random.choice(PALETTE) for _ in range(n_colored - NUM_TARGETS)]
   292	    else:
   293	        used_target_count = random.randint(0, NUM_TARGETS - 1)
   294	        allowed = non_targets + random.sample(targets, used_target_count)
   295	        colors = [random.choice(allowed) for _ in range(n_colored)]
   296	
   297	    random.shuffle(colors)
   298	    patch = np.zeros((h, w), dtype=int)
   299	    rs, cs = zip(*coords)
   300	    patch[rs, cs] = colors
   301	    return patch
   302	
   303	
   304	def _candidate_locations(
   305	    canvas: np.ndarray,
   306	    patch: np.ndarray,
   307	    *,
   308	    row_lo: int = 0,
   309	    row_hi: int | None = None,
   310	    col_lo: int = 0,
   311	    col_hi: int | None = None,
   312	    padding: int = PADDING,
   313	    predicate=None,
   314	) -> list[tuple[int, int]]:
   315	    """Enumerate legal top-left locations under optional bounds plus a background moat."""
   316	    h, w = patch.shape
   317	    H, W = canvas.shape
   318	    row_hi = H - h if row_hi is None else min(int(row_hi), H - h)
   319	    col_hi = W - w if col_hi is None else min(int(col_hi), W - w)
   320	    row_lo = max(0, int(row_lo))

