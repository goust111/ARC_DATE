   231	    {"row_lo": 8, "row_hi": 10, "col_lo": 8, "col_hi": 10},
   232	]
   233	MIN_TOTAL_SHIFT = 10
   234	MAX_SURVIVOR_R1 = 13
   235	MAX_SURVIVOR_C1 = 13
   236	
