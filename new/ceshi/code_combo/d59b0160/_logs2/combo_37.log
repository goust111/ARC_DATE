   203	KEEP_TALL_H = (5, 8)
   204	KEEP_TALL_W = (2, 4)
   205	KEEP_WIDE_H = (3, 5)
   206	KEEP_WIDE_W = (5, 7)
   207	KEEP_MED_H = (3, 6)
