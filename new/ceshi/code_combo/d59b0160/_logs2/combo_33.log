+    external_mask = (g != bg).copy()
+    external_mask[:legend_size, :legend_size] = False
+    for pts in components_mask(external_mask, connectivity=4):
+        cols = {int(g[r, c]) for r, c in pts}
+        if legend_colors.issubset(cols):
