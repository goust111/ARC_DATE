BG=0; BLUE=1; RED=2; ROUGH=3; SMOOTH=4; GUIDE=5
W=(BLUE,RED)

def simulate(grid,batch=True,friction=True):
    g=np.array(grid,int).copy(); H,Wd=g.shape
    def settle(rr,cc):
        for _ in range(H*Wd):
            if rr+1<H and g[rr+1,cc]==BG:
                rr+=1; continue
            opts=[]
            if rr+1<H and cc-1>=0 and g[rr,cc-1]==BG and g[rr+1,cc-1]==BG: opts.append((rr+1,cc-1))
            if rr+1<H and cc+1<Wd and g[rr,cc+1]==BG and g[rr+1,cc+1]==BG: opts.append((rr+1,cc+1))
            if opts:
                if len(opts)"'!=1: raise AssertionError(('"'diag',opts,(rr,cc)))
                rr,cc=opts[0]; continue
            if rr+1<H and g[rr+1,cc]"'!=BG:
                L=cc
                while L-1>=0 and g[rr,L-1]==BG: L-=1
                R=cc
                while R+1<Wd and g[rr,R+1]==BG: R+=1
                drops=[x for x in range(L,R+1) if g[rr+1,x]==BG]
                if friction and g[rr+1,cc]==ROUGH and drops: break
                if not drops: break
                d=min(abs(x-cc) for x in drops)
                ne=[x for x in drops if abs(x-cc)==d]
                if len(ne)!=1: raise AssertionError(('"'h',ne,(rr,cc),drops,L,R))
                best=ne[0]; nx=cc+(-1 if best<cc else 1)
                if g[rr,nx]"'!=BG: raise AssertionError(('"'step',(rr,cc),nx))
                cc=nx; continue
            break
        return rr,cc
    if batch:
        starts={c:[tuple(map(int,p)) for p in np.argwhere(g==c)] for c in W}
        base=g.copy();
        for c in W: base[base==c]=BG
        g=base
        for color in W:
            for r,c in starts[color]:
                assert g[r,c]==BG
                g[r,c]=color
            for _ in range(H*Wd):
                moved=False
                pts=sorted([(int(r),int(c)) for r,c in np.argwhere(g==color)], reverse=True)
                for r,c in pts:
                    if g[r,c]"'!=color: continue
                    g[r,c]=BG
                    rr,cc=settle(r,c)
                    moved|=(rr,cc)!=(r,c)
                    assert g[rr,cc]==BG
                    g[rr,cc]=color
                if not moved: break
            else: raise AssertionError('"'no converge batch')
    else:
        for _ in range(H*Wd):
            moved=False
            pts=sorted([(int(r),int(c),int(g[r,c])) for r,c in np.argwhere(np.isin(g,W))], reverse=True)
            for r,c,color in pts:
                if g[r,c]"'!=color: continue
                g[r,c]=BG
                rr,cc=settle(r,c)
                moved|=(rr,cc)!=(r,c)
                assert g[rr,cc]==BG
                g[rr,cc]=color
            if not moved: break
        else: raise AssertionError('"'no converge sim')
    return g

def shared_component(grid):
    pts={(int(r),int(c)) for r,c in np.argwhere(np.isin(grid,W))}
    seen=[]
    while pts:
        s=pts.pop(); comp={s}; st=[s]
        while st:
            r,c=st.pop()
            for dr,dc in [(1,0),(-1,0),(0,1),(0,-1)]:
                n=(r+dr,c+dc)
                if n in pts:
                    pts.remove(n); comp.add(n); st.append(n)
        cols={int(grid[r,c]) for r,c in comp}
        if cols==set(W): return True
    return False

def metrics(inp):
    combo=simulate(inp,True,True)
    no_batch=simulate(inp,False,True)
    no_fric=simulate(inp,True,False)
