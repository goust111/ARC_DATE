    red_touch=sum(1 for r,c in np.argwhere(combo==RED) if any(0<=int(r)+dr<10 and 0<=int(c)+dc<10 and combo[int(r)+dr,int(c)+dc]==BLUE for dr,dc in [(1,0),(-1,0),(0,1),(0,-1)]))
    blue_moved=int(np.count_nonzero((inp==BLUE)&(combo"'!=BLUE)))
