        _add_vline(corridor, split_c, outlet_r, split_r)
    else:
        src_h = random.choice([2, 3])
        src_r0 = random.choice([1, 2])
        outlet_r = int(src_r0 + src_h // 2)
        for r in range(src_r0, src_r0 + src_h):
