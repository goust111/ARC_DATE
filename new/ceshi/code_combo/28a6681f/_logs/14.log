+            [0, 0, 0, 0, 0, 3, 0, 3, 1, 1],
+            [0, 0, 0, 0, 0, 3, 0, 3, 1, 1],
+            [0, 0, 0, 0, 2, 3, 0, 3, 1, 1],
+            [0, 0, 0, 0, 2, 3, 0, 3, 1, 1],
+            [0, 2, 2, 2, 2, 3, 3, 3, 1, 1],
