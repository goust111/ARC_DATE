+            if int(g[r, c]) != WATER:
+                continue
+            g[r, c] = BG
+            rr, cc = _settle_down(g, int(r), int(c))
+            moved = bool(moved or ((int(rr), int(cc)) != (int(r), int(c))))
+            g[rr, cc] = WATER
+        if not moved:
