+        for r, c in water_cells:
+            assert r == h - 1 or int(g[r + 1, c]) != BG, "downward-frame input water must be supported"
+
+    for _pass in range(h * w):
+        moved = False
+        pts = sorted([(int(r), int(c)) for r, c in np.argwhere(g == WATER)], reverse=True)
