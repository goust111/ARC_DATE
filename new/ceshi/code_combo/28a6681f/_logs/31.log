+            return []
+        cells: list[tuple[int, int]] = []
+        for r in range(H - 1):
+            for c in range(1, W - 1):
+                if int(solid[r, c]) == int(BG):
+                    continue
+                left_is_water = (int(r), int(c - 1)) in occupancy
+                right_is_water = (int(r), int(c + 1)) in occupancy
