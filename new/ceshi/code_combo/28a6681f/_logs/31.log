+    return {
+        "distinct_dyed_colors": int(len(dyed_colors)),
+        "dyed_particles": int(sum(1 for p in particles if int(p["color"]) != int(INPUT_WATER))),
+        "dye_events": int(sum(int(p["dye_events"]) for p in particles)),
