+    """
+    return _simulate(
+        grid,
+        allow_erosion=True,
+        colorize=True,
+        mark_wet=True,
+        check_input=bool(check_input),
+        check_output=bool(check_output),
+        return_state=False,
+    )
+
+
+def _main_plain(grid: np.ndarray) -> np.ndarray:
