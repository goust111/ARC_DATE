+def _variant_metrics(grid: np.ndarray, meta: dict[str, int | str]) -> dict[str, int | bool]:
+    state = _simulate(
+        grid,
+        allow_erosion=True,
+        colorize=True,
+        mark_wet=True,
+        check_input=True,
+        check_output=True,
+        return_state=True,
