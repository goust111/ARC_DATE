+                right_is_empty = int(solid[r, c + 1]) == int(BG) and (int(r), int(c + 1)) not in occupancy
+                if (left_is_water and right_is_empty) or (right_is_water and left_is_empty):
+                    cells.append((int(r), int(c)))
