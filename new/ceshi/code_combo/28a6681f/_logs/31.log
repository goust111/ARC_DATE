from __future__ import annotations

import random

import numpy as np


# Design analysis for this D4 variant
# a) 具体化与行为追踪:
#    原题里输入水都用蓝色 1 表示, 求解时也一直把所有水当成同一种像素。这里保留同样的重力/斜滑/横滑几何,
