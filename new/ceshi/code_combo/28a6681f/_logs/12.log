+        "baseline_allowed_cup": int(np.sum(norm_base[:, 7:9] == WATER)),
+        "baseline_forbidden_cup": int(np.sum(norm_base[:, 1:3] == WATER)),
+        "diff_cells": int(np.sum(out != baseline)),
