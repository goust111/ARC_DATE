+    if check_output:
+        assert int(np.sum(g == WATER)) == initial_water, "water count must be conserved"
+        for r, c in np.argwhere(g == WATER):
+            rr = int(r)
+            cc = int(c)
+            g[rr, cc] = int(BG)
+            nxt = settle(rr, cc)
+            g[rr, cc] = int(WATER)
+            assert nxt == (rr, cc), "output water must already be a fixed point"
