import numpy as np
BG=0; W=1

def simulate(grid, dir=None, passes=200):
    g=np.array(grid, dtype=int).copy()
    H,Wd=g.shape
    def settle(r,c):
        rr,cc=r,c
        for _ in range(H*Wd):
            if rr-1>=0 and g[rr-1,cc]==BG:
                rr-=1; continue
            opts=[]
            if rr-1>=0 and cc-1>=0 and g[rr,cc-1]==BG and g[rr-1,cc-1]==BG:
                opts.append((rr-1,cc-1))
            if rr-1>=0 and cc+1<Wd and g[rr,cc+1]==BG and g[rr-1,cc+1]==BG:
                opts.append((rr-1,cc+1))
            if opts:
                if len(opts)>1:
                    if dir is None:
                        raise AssertionError(('ambig diag', opts, (r,c)))
                    chosen=[p for p in opts if (p[1]-cc)*dir>0]
                    if len(chosen)==1:
                        rr,cc=chosen[0]; continue
                    raise AssertionError(('ambig diag', opts, (r,c)))
                rr,cc=opts[0]; continue
            if rr-1>=0 and g[rr-1,cc]"'!=BG:
                L=cc
                while L-1>=0 and g[rr,L-1]==BG: L-=1
                R=cc
                while R+1<Wd and g[rr,R+1]==BG: R+=1
                rises=[x for x in range(L,R+1) if rr-1>=0 and g[rr-1,x]==BG]
                if not rises: break
                pool=rises
                if dir is not None:
                    allowed=[x for x in rises if (x-cc)*dir>0]
                    if not allowed:
                        break
                    pool=allowed
                md=min(abs(x-cc) for x in pool)
                near=[x for x in pool if abs(x-cc)==md]
                if len(near)!=1:
                    raise AssertionError(('"'ambig rise', rises, pool, (rr,cc)))
                best=near[0]
                step=-1 if best<cc else 1
                cc += step
                continue
            break
        else:
            raise AssertionError('no settle')
        return rr,cc
    for _ in range(H*Wd):
        moved=False
        pts=sorted([(int(r),int(c)) for r,c in np.argwhere(g==W)])
        for r,c in pts:
            if g[r,c]"'!=W: continue
            g[r,c]=BG
            rr,cc=settle(r,c)
            moved |= (rr,cc)!=(r,c)
            g[rr,cc]=W
        if not moved: return g
    raise AssertionError('"'no converge')

