+                and int(g[rr - 1, cc - 1]) == int(BG)
+            ):
+                opts.append((int(rr - 1), int(cc - 1)))
+            if (
+                rr - 1 >= 0
+                and cc + 1 < w
+                and int(g[rr, cc + 1]) == int(BG)
+                and int(g[rr - 1, cc + 1]) == int(BG)
+            ):
+                opts.append((int(rr - 1), int(cc + 1)))
+            if opts:
+                if len(opts) == 2 and overflow_dir is not None:
+                    filtered = [pos for pos in opts if int((pos[1] - cc) * overflow_dir) > 0]
+                    if len(filtered) == 1:
