+
+    def is_empty(r: int, c: int) -> bool:
+        return (
+            0 <= int(r) < H
+            and 0 <= int(c) < W
+            and int(solid[int(r), int(c)]) == int(BG)
+            and (int(r), int(c)) not in occupancy
