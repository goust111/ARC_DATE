+def _grid_from_rows(rows: list[str]) -> np.ndarray:
+    return np.array([[int(ch) for ch in row] for row in rows], dtype=int)
+
+
+def _build_candidate(spec: dict[str, object], mirror: bool) -> np.ndarray:
