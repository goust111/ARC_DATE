+        if stats["smooth_slides"] < 1:
+            continue
+        if stats["dye_to_rough"] < 2:
+            continue
+        if stats["dye_to_smooth"] < 2:
+            continue
+        if stats["distinct_final_colors"] < 2:
+            continue
+        if stats["final_rough"] < 2:
