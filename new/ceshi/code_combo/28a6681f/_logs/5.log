+    """
+    out, _particles, _metrics = _simulate(
+        grid,
+        friction_enabled=True,
+        colorize=True,
+        check_input=bool(check_input),
+        check_output=bool(check_output),
+        collect_metrics=False,
+    )
+    return out
+
