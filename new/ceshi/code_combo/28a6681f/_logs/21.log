+
+    surface = tuple(int(x) for x in template["surface"])
+    rain_cols = [int(c) for c in template["rain_cols"] if _source_rows(int(surface[int(c)]))]
+    pedestals = [int(c) for c in template["pedestals"] if _source_rows(int(surface[int(c)]))]
