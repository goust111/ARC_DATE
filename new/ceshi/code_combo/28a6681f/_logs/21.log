+            rr = int(r)
+            cc = int(c)
+            assert rr == h - 1 or int(g[rr + 1, cc]) != int(BG), "output water must be vertically supported"
+
+    return g
+
+
+def _build_case(rng: random.Random) -> np.ndarray | None:
+    template = rng.choice(TEMPLATES)
+    if rng.random() < 0.5:
+        template = _mirror_template(template)
+
