+        solid_rows = [int(r) for r in range(h) if int(col[r]) not in (int(BG), int(WATER))]
+        prev = -1
+        for solid_r in solid_rows + [h]:
+            lo = int(prev + 1)
+            hi = int(solid_r - 1)
+            if lo <= hi:
+                segment = col[lo : hi + 1].copy()
+                water_count = int(np.count_nonzero(segment == int(WATER)))
+                segment[:] = int(BG)
+                if water_count:
