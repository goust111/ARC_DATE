+        return None
+
+    grid = np.zeros((10, 10), dtype=int)
+    _paint_surface(grid, surface, rng)
+
+    forced_col = int(rng.choice(pedestals))
+    other_cols = [int(c) for c in rain_cols if int(c) != int(forced_col)]
