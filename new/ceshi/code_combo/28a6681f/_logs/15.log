+
+def _remap_structure_colors(g: np.ndarray) -> np.ndarray:
+    targets = random.sample([2, 3, 4, 5, 6, 7, 8, 9], 3)
+    mapping = dict(zip(STRUCTURE_TEMPLATE_COLORS, targets))
+    out = g.copy()
