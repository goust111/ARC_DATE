+
+
+def _behavior_metrics(grid: np.ndarray) -> dict[str, object]:
+    combo_out, combo_stats = _simulate(
+        grid,
+        order_mode="wall_distance",
+        allow_bounce=True,
+        check_input=True,
+        check_output=True,
+    )
+    reverse_bounce_out, reverse_bounce_stats = _simulate(
