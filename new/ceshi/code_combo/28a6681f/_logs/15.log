+            [0, 0, 0, 0, 1, 3, 0, 0, 0, 0],
+            [0, 0, 0, 0, 1, 3, 0, 0, 0, 0],
+            [0, 0, 0, 2, 2, 3, 0, 0, 0, 0],
+            [0, 2, 0, 0, 1, 3, 3, 0, 4, 0],
+            [0, 2, 0, 2, 3, 3, 2, 0, 4, 0],
+            [0, 2, 2, 2, 2, 3, 4, 4, 4, 0],
+            [0, 2, 2, 2, 2, 3, 4, 4, 4, 0],
