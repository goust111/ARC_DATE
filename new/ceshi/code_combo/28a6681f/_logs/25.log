/bin/bash -lc "python - <<'PY'
import numpy as np, importlib.util, itertools
spec=importlib.util.spec_from_file_location('orig','arc2_solver_select/28a6681f.py')
orig=importlib.util.module_from_spec(spec); spec.loader.exec_module(orig)

PROFILES=(
    {\"w1_top\":2,\"hole_row\":4,\"w2_top\":5,\"water_counts\":(22,24,26)},
    {\"w1_top\":2,\"hole_row\":4,\"w2_top\":6,\"water_counts\":(20,22,24)},
    {\"w1_top\":3,\"hole_row\":4,\"w2_top\":5,\"water_counts\":(22,24,26)},
    {\"w1_top\":3,\"hole_row\":5,\"w2_top\":6,\"water_counts\":(17,19,21)},
    {\"w1_top\":4,\"hole_row\":5,\"w2_top\":6,\"water_counts\":(17,19,21)},
)
RIGHT_TOPS=(3,4,5)
GUIDE=[(2,0),(2,1),(3,1),(3,2),(4,2),(4,3),(5,0),(5,1),(5,2),(5,3),(5,4)]

def guide_cells(mirror=False):
    return [(r,9-c) for r,c in GUIDE] if mirror else list(GUIDE)

def lower_base(profile,right_top,mirror=False):
    g=np.zeros((10,10),dtype=int)
    for c in range(0,4): g[9,c]=2
    for c in range(4,7): g[9,c]=5
    for c in range(7,10): g[9,c]=7
    for r in range(profile['w1_top'],9):
        if r"'!=profile['"'hole_row']: g[r,3]=2
    for r in range(profile['w2_top'],9): g[r,6]=5
    for r in range(right_top,9): g[r,9]=7
    if mirror: g=np.fliplr(g)
    return g

def source_slots(base,mirror=False):
    blocked=set(guide_cells(mirror))|{(int(r),int(c)) for r,c in np.argwhere(base"'!=0)}
    cols=range(5,10) if mirror else range(0,5)
    return [(r,c) for r in range(4,-1,-1) for c in cols if (r,c) not in blocked]

def build(profile,right_top,total,retain_rows,mirror=False):
    lower=lower_base(profile,right_top,mirror)
    source=(0,9) if mirror else (0,0)
    out=lower.copy()
    for _ in range(total):
        out[source]=1
        out=orig.main(out,check_input=False,check_output=False)
    if not np.any(out[:,4:6]==1): return None,None
    far = out[:,1:3] if mirror else out[:,7:9]
    if not np.any(far==1): return None,None
    out_with_guide=out.copy()
    for rc in guide_cells(mirror): out_with_guide[rc]=4
    inp=out_with_guide.copy()
    src_cols=set(range(7,10)) if mirror else set(range(0,3))
    retain={(int(r),int(c)) for r,c in np.argwhere(out==1) if int(r)>=9-retain_rows and int(c) in src_cols}
    moved=[]
    for r,c in np.argwhere(out==1):
        rc=(int(r),int(c))
        if rc in retain: continue
        moved.append(rc); inp[rc]=0
    slots=source_slots(lower,mirror)
    if len(moved)>len(slots): return None,None
    for pos in slots[:len(moved)]: inp[pos]=1
    return inp,out_with_guide

def new_main(inp,profile,right_top):
    g=np.array(inp,dtype=int)
    mirror=bool(np.any(g[:,9]==4))
    lower=lower_base(profile,right_top,mirror)
    source_count=int(np.count_nonzero(g[:5]==1))
    for r,c in np.argwhere(g==1):
        if r>=5: lower[int(r),int(c)]=1
    source=(0,9) if mirror else (0,0)
    for _ in range(source_count):
        lower[source]=1
        lower=orig.main(lower,check_input=False,check_output=False)
    out=lower.copy()
    for rc in guide_cells(mirror): out[rc]=4
    return out

ok=0
for profile,right_top,total,retain_rows,mirror in itertools.product(PROFILES,RIGHT_TOPS,[17,19,20,21,22,24],[1,2],[False,True]):
    if total not in profile['"'water_counts']: continue
    inp,out=build(profile,right_top,total,retain_rows,mirror)
    if inp is None: continue
    res=new_main(inp,profile,right_top)
    if not np.array_equal(res,out):
        continue
    try:
        legacy=orig.main(inp)
        same=np.array_equal(legacy,out)
    except Exception:
        same=False
    if same: continue
    ok+=1
    print('valid',profile,right_top,total,retain_rows,mirror,'source',np.count_nonzero(inp[:5]==1))
print('ok',ok)
