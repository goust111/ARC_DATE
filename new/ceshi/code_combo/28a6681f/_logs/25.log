def pour(base, source, n):
    g=base.copy()
    sr,sc=source
    for _ in range(n):
        if g[sr,sc] not in (0,1):
            return None
        g[sr,sc]=1
        g=mod.main(g, check_input=False, check_output=False)
    return g

for template_id,mirror,hole_row,wall_top,source,water_count in itertools.product([0,1],[False,True],[5,6,7,8],[4,5,6],[(0,0),(0,1),(1,0)],range(4,18)):
    g=mod._build_structure(template_id,(2,3,4))
    if mirror:
        g=np.fliplr(g)
        wall_col=1
        basin_cols=(0,)
    else:
        wall_col=8
        basin_cols=(9,)
    # add right tiny basin floor and leaking wall
    g[9, basin_cols[0]] = 2
    for r in range(wall_top,9):
        if r"'!=hole_row:
            g[r,wall_col]=2
    out=None
    try:
        out=pour(g, source if not mirror else (source[0],9-source[1]), water_count)
        if out is None: continue
    except Exception:
        continue
    # stable final
    try:
        stable=mod.main(out)
    except Exception:
        continue
    if not np.array_equal(stable,out):
        continue
    leak=bool(np.any(out[:, basin_cols[0]]==1))
    if not leak:
        continue
    # try reverse into source region on same side
    if mirror:
        source_cols=range(7,10)
    else:
        source_cols=range(0,3)
    inp=out.copy()
    retain={(r,c) for r,c in np.argwhere(out==1) if r>=7 and c in source_cols}
    moved=[]
    for r,c in np.argwhere(out==1):
        rc=(int(r),int(c))
        if rc in retain: continue
        moved.append(rc); inp[rc]=0
    slots=[]
    for r in range(8,-1,-1):
        for c in source_cols:
            if inp[r,c]==0:
                slots.append((r,c))
    if len(moved)>len(slots):
        continue
    for (r,c) in slots[:len(moved)]: inp[r,c]=1
    try:
        final,metrics=mod._simulate(inp, slope_mode=True, check_input=True, check_output=True, track_metrics=True)
    except Exception:
        continue
    if not np.array_equal(final,out):
        continue
    if metrics['"'slope_steps']<=0:
        continue
    same=False
    try:
        legacy=mod._legacy_main(inp)
        same=np.array_equal(legacy,out)
    except Exception:
        same=False
    if same:
        continue
    print('FOUND',template_id,mirror,hole_row,wall_top,source,water_count,metrics)
    print('input\\n',inp)
    print('out\\n',out)
    raise SystemExit
