+def _solid_components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r, c in np.argwhere(mask):
+        rr = int(r)
+        cc = int(c)
+        if bool(seen[rr, cc]):
+            continue
+        stack = [(rr, cc)]
