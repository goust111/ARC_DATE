def build(template_id=0, hole_row=7, wall_top=5, carry=0, src='2x2'):
    g=mod._build_structure(template_id, (2,3,4))
    # add leaking wall at col 8 and tiny basin at col 9
    for r in range(wall_top, 9):
        if r "'!= hole_row:
            g[r,8]=2
    g[9,9]=2
    # source
    if src=='"'2x2':
        cells=[(0,0),(0,1),(1,0),(1,1)]
