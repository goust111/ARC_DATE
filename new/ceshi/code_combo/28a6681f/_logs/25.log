# D7 profile terrain
profile={\"w1_top\":3,\"hole_row\":5,\"w2_top\":6}
right_top=4

def lower_base(mirror=False):
    g=np.zeros((10,10),dtype=int)
    colors=(2,5,7)
    left,mid,right=colors
    for c in range(0,4): g[9,c]=left
    for c in range(4,7): g[9,c]=mid
    for c in range(7,10): g[9,c]=right
