    return g

def build_input(total=19, retain=2, mirror=False):
    out=lower_base(mirror)
    source=(0,9) if mirror else (0,0)
    for _ in range(total):
        out[source]=1
        out=orig.main(out,check_input=False,check_output=False)
    # reverse into upper source area with guide
    inp=out.copy()
