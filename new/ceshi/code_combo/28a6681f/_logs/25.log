+    {"w1_top": 2, "hole_row": 4, "w2_top": 5, "water_choices": (22,), "retain_choices": (2,)},
+    {"w1_top": 2, "hole_row": 4, "w2_top": 6, "water_choices": (20, 22), "retain_choices": (1, 2)},
+    {"w1_top": 3, "hole_row": 4, "w2_top": 5, "water_choices": (22, 24), "retain_choices": (2,)},
+    {"w1_top": 3, "hole_row": 5, "w2_top": 6, "water_choices": (17, 19, 21), "retain_choices": (1, 2)},
