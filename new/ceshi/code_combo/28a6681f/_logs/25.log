    moved=[]
    for r,c in np.argwhere(out==1):
        rc=(int(r),int(c))
        if rc in retain: continue
        moved.append(rc)
        inp[rc]=0
    slots=[]
    for r in range(8,-1,-1):
        for c in retain_cols:
            if inp[r,c]==0:
                slots.append((r,c))
    if len(moved)>len(slots): return None
    for pos in slots[:len(moved)]: inp[pos]=1
    return inp

