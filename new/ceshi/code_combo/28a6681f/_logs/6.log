+def _component_count(points: set[tuple[int, int]]) -> int:
+    remaining = set(points)
+    count = 0
+    while remaining:
+        count += 1
+        stack = [remaining.pop()]
+        while stack:
+            r, c = stack.pop()
+            for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
+                nxt = (int(r + dr), int(c + dc))
+                if nxt in remaining:
+                    remaining.remove(nxt)
+                    stack.append(nxt)
+    return count
+
