    if not np.array_equal(solved, expected):
        reasons['mismatch expected'] = reasons.get('mismatch expected', 0) + 1
        continue
    if np.array_equal(solved, classic):
        reasons['same as classic'] = reasons.get('same as classic', 0) + 1
        continue
    reasons['success'] = reasons.get('success', 0) + 1
print(reasons)
