+BG = 0
+WATER = 1
+H = 10
+W = 10
+SHELF_ROW = 4
+
+LAYOUTS: tuple[tuple[int, ...], ...] = (
+    (2, 5, 9),      # widths 2 and 3 -> total target width 5
+    (3, 6, 9),      # widths 2 and 2 -> total target width 4
+    (2, 4, 7, 9),   # widths 1, 2, 1 -> total target width 4
+)
