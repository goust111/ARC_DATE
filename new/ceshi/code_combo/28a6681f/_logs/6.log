    expected = np.array(out, dtype=int).copy()
    expected[mod.SHELF_ROW, :src_width] = int(shelf_color)
    inp = np.array(expected, dtype=int).copy()
    inp[inp == int(mod.WATER)] = int(mod.BG)
    mod._place_source_rectangle(inp, height, src_width, shelf_color)
    inp, expected = mod._flip_pair_if_needed(inp, expected, rng)
    try:
        solved = mod.main(inp)
    except Exception as e:
        reasons['main: '+str(e)] = reasons.get('main: '+str(e), 0) + 1
