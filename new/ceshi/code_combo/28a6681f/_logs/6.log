    42	# - 盆地墙只从第 5..9 行开始，保证不会和源块或支撑台重叠。
    43	# - 底行所有非背景列都保留给盆地墙，方便 solver 通过底行唯一解析盆地区间。
    44	# - generator 只选那些外侧墙足够高的布局，保证 h 层水不会从最左或最右边外泄到背景里。
    45	#
    46	# e) 视觉可观察性
    47	# - 输入里最显眼的是矩形水块的高度；输出里最显眼的是每个盆地列都出现同样的堆叠层数。
    48	# - 源宽度在不同样例中会变化，但输出高度只跟源高度同步，这能直接提示“宽度/总像素数不重要”。
    49	# - 某些样例里内部墙会比 h 更矮，于是输出跨墙连通；另一些样例里内部墙更高，输出分成多个槽。
    50	#   这两类都遵循同一个规则，能帮助解题者看到“高度编码 + 盆地链”的联合模式。
    51	#
    52	# f) 可视化整洁度
    53	# - 结构只用 3 个非水颜色：1 个给源支撑台，2 个交替给墙。没有额外标记、符号或噪声。
    54	# - 支撑台始终待在上半区，墙始终锚定底部，源块和目标区上下分层，读图时不需要猜覆盖关系。
    55	#
    56	# g) 变化的可推断性
    57	# - 没有任何基于颜色编号大小的逻辑；颜色只区分“水 / 背景 / 静态结构”。
    58	# - 真正决定输出的是可见的几何属性“源块高度”，并且这一属性在输入里是直接可数的。
    59	#
    60	# h) 量化退化检查目标
    61	# - 生成器故意让源宽度 2..3，而底部目标内部宽度为 4 或 5，因此大多数样本都会产生显式的
    62	#   水量不守恒；这保证新规则与原始守恒重力模拟不能退化为同一输出。
    63	# - 另外保留 `_classic_main()` 作为旧行为参考，后续统计时可直接比较新旧输出是否不同。
    64	#
    65	# i) main() 的新增假设与 generator 保证
    66	# - `main()` 假设所有输入水像素恰好组成一个贴单侧边缘的实心矩形；generator 始终这样放。
    67	# - `main()` 假设底行所有非背景列就是盆地墙列，且相邻墙之间至少留 1 列内部空间；
    68	#   generator 只采样满足这一点的墙布局。
    69	# - `main()` 假设目标盆地内部列没有别的固体障碍；generator 不在这些列里放额外结构，
    70	#   这样“每列取最深 h 个背景格”就是清晰、稳定且可见的规则。
    71	
    72	
    73	BG = 0
    74	WATER = 1
    75	H = 10
    76	W = 10
    77	SHELF_ROW = 4
    78	
    79	LAYOUTS: tuple[tuple[int, ...], ...] = (
    80	    (2, 5, 9),      # widths 2 and 3 -> total target width 5
    81	    (3, 6, 9),      # widths 2 and 2 -> total target width 4
    82	    (2, 4, 7, 9),   # widths 1, 2, 1 -> total target width 4
    83	)
    84	
    85	
    86	def _component_count(points: set[tuple[int, int]]) -> int:
    87	    remaining = set(points)
    88	    count = 0
    89	    while remaining:
    90	        count += 1
    91	        stack = [remaining.pop()]
    92	        while stack:
    93	            r, c = stack.pop()
    94	            for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
    95	                nxt = (int(r + dr), int(c + dc))
    96	                if nxt in remaining:
    97	                    remaining.remove(nxt)
    98	                    stack.append(nxt)
    99	    return count
   100	
   101	
   102	def _source_box(grid: np.ndarray) -> tuple[int, int, int, int]:
   103	    pts = np.argwhere(grid == int(WATER))
   104	    assert pts.size > 0, "expected a non-empty water source"
   105	    r0, c0 = pts.min(axis=0)
   106	    r1, c1 = pts.max(axis=0)
   107	    return int(r0), int(c0), int(r1), int(c1)
   108	
   109	
   110	def _source_info(grid: np.ndarray) -> tuple[int, int, int, int, int, int, str]:
   111	    r0, c0, r1, c1 = _source_box(grid)
   112	    height = int(r1 - r0 + 1)
   113	    width = int(c1 - c0 + 1)
   114	    if c0 == 0:
   115	        side = "left"
   116	    elif c1 == W - 1:
   117	        side = "right"
   118	    else:
   119	        raise AssertionError("water source must touch exactly one side edge")
   120	    assert not (c0 == 0 and c1 == W - 1), "source cannot touch both side edges"
   121	    return height, width, r0, c0, r1, c1, side
   122	
   123	
   124	def _find_wall_columns(grid: np.ndarray) -> list[int]:
   125	    return [int(c) for c in range(W) if int(grid[H - 1, c]) not in (BG, WATER)]
   126	
   127	
   128	def _parse_basins(grid: np.ndarray) -> list[dict[str, int]]:
   129	    wall_cols = _find_wall_columns(grid)
   130	    assert 3 <= len(wall_cols) <= 4, f"expected 2-3 basins, got wall columns {wall_cols}"
   131	    basins: list[dict[str, int]] = []
   132	    for left, right in zip(wall_cols, wall_cols[1:]):
   133	        assert right - left >= 2, "each basin needs at least one interior column"
   134	        basins.append(
   135	            {
   136	                "left": int(left),
   137	                "right": int(right),
   138	                "width": int(right - left - 1),
   139	            }
   140	        )
   141	    assert 2 <= len(basins) <= 3
   142	    return basins
   143	
   144	
   145	def _target_columns(basins: list[dict[str, int]]) -> list[int]:
   146	    cols: list[int] = []
   147	    for basin in basins:
   148	        cols.extend(int(c) for c in range(int(basin["left"]) + 1, int(basin["right"])))
   149	    return cols
   150	
   151	
   152	def _stack_height_output(base: np.ndarray, height: int, basins: list[dict[str, int]]) -> np.ndarray:
   153	    out = np.array(base, dtype=int).copy()
   154	    for c in _target_columns(basins):
   155	        empties = [int(r) for r in range(H - 1, -1, -1) if int(out[r, c]) == int(BG)]
   156	        assert len(empties) >= int(height), "not enough empty depth for encoded stack height"
   157	        for r in empties[:height]:
   158	            out[int(r), int(c)] = int(WATER)
   159	    return out
   160	
   161	
   162	def main(grid: np.ndarray, check_input: bool = True, check_output: bool = True) -> np.ndarray:
   163	    """
   164	    Rebuild basin water from a rectangular source block, using source height as the destination stack depth.
   165	
   166	    Input structure:
   167	    - Background is 0 and water is 1.
   168	    - Static non-water colors form 2 or 3 adjacent bottom-anchored basins in the lower half of the grid.
   169	    - The only input water is one filled rectangle touching exactly one side edge and resting on an upper shelf.
   170	    - The rectangle's row count is the code that matters; its width is not the target water amount.
   171	
   172	    Rule:
   173	    - Identify the source rectangle and read its height h.
   174	    - Remove the source water, parse the basin intervals from the non-background columns on the bottom row,
   175	      and treat every interior basin column independently.
   176	    - In each interior basin column, fill the deepest h background cells with water.
   177	    - Static structure colors stay unchanged, but total water pixel count is allowed to change.
   178	
   179	    Key insight:
   180	    - The solver must ignore literal water quantity and instead use a visible source attribute: the rectangle's
   181	      height. The output is an h-layer restacking across the whole basin chain, even when that creates or deletes
   182	      water compared with the input.
   183	    """
   184	    g = np.array(grid, dtype=int).copy()
   185	    assert g.shape == (H, W), f"expected 10x10 grid, got {g.shape}"
   186	
   187	    height, width, r0, c0, r1, c1, _side = _source_info(g)
   188	    basins = _parse_basins(g)
   189	
   190	    if check_input:
   191	        source = {(int(r), int(c)) for r, c in np.argwhere(g == int(WATER))}
   192	        assert _component_count(source) == 1, "water source must be one 4-connected component"
   193	        assert np.all(g[r0 : r1 + 1, c0 : c1 + 1] == int(WATER)), "source must be a filled rectangle"
   194	        assert int(np.sum(g == int(WATER))) == int(height * width), "there must be no water outside the source rectangle"
   195	        assert 2 <= int(height) <= 4, "generator uses source heights 2..4"
   196	        assert 2 <= int(width) <= 3, "generator uses compact rectangle widths 2..3"
   197	        assert int(r1) == SHELF_ROW - 1, "source must sit directly on the upper shelf"
   198	        assert int(g[SHELF_ROW, c0:c1 + 1].min()) != int(BG), "source shelf must support the whole rectangle"
   199	        for r, c in source:
   200	            assert r == H - 1 or int(g[r + 1, c]) != int(BG), "input water must be supported"
   201	            left_bg = c > 0 and int(g[r, c - 1]) == int(BG)
   202	            right_bg = c + 1 < W and int(g[r, c + 1]) == int(BG)
   203	            assert not (left_bg and right_bg), "input water cannot have bg on both horizontal sides"
   204	
   205	        target_cols = _target_columns(basins)
   206	        assert target_cols, "need at least one basin interior column"
   207	        for c in target_cols:
   208	            assert np.all(g[SHELF_ROW:, c] == int(BG)), "target basin columns must be free of extra solids"
   209	
   210	    base = g.copy()
   211	    base[base == int(WATER)] = int(BG)
   212	    out = _stack_height_output(base, height, basins)
   213	
   214	    if check_output:
   215	        target_cols = set(_target_columns(basins))
   216	        solid_mask = (g != int(WATER)) & (g != int(BG))
   217	        assert np.array_equal(out[solid_mask], g[solid_mask]), "structure colors must stay unchanged"
   218	        for c in range(W):
   219	            col_water = int(np.sum(out[:, c] == int(WATER)))
   220	            if c in target_cols:
   221	                assert col_water == int(height), "each basin column must receive exactly source-height water"
   222	            else:
   223	                assert col_water == 0, "water must appear only inside the basin interiors"
   224	
   225	    return out
   226	
   227	
   228	def _classic_main(grid: np.ndarray) -> np.ndarray:
   229	    """Original deepest-fill behavior, kept only for anti-degeneracy checks."""
   230	    g = np.array(grid, dtype=int).copy()
   231	
   232	    def settle(r: int, c: int) -> tuple[int, int]:
   233	        rr = int(r)
   234	        cc = int(c)
   235	        for _ in range(H * W):
   236	            if rr + 1 < H and int(g[rr + 1, cc]) == int(BG):
   237	                rr += 1
   238	                continue
   239	
   240	            opts = []
   241	            if (
   242	                rr + 1 < H
   243	                and cc - 1 >= 0
   244	                and int(g[rr, cc - 1]) == int(BG)
   245	                and int(g[rr + 1, cc - 1]) == int(BG)
   246	            ):
   247	                opts.append((int(rr + 1), int(cc - 1)))
   248	            if (
   249	                rr + 1 < H
   250	                and cc + 1 < W
   251	                and int(g[rr, cc + 1]) == int(BG)
   252	                and int(g[rr + 1, cc + 1]) == int(BG)
   253	            ):
   254	                opts.append((int(rr + 1), int(cc + 1)))
   255	            if opts:
   256	                if len(opts) != 1:
   257	                    raise AssertionError(f"ambiguous diagonal moves: {opts}")
   258	                rr, cc = opts[0]
   259	                continue
   260	

 succeeded in 165ms:
   260	
   261	            if rr + 1 < H and int(g[rr + 1, cc]) != int(BG):
   262	                left = int(cc)
   263	                while left - 1 >= 0 and int(g[rr, left - 1]) == int(BG):
   264	                    left -= 1
   265	                right = int(cc)
   266	                while right + 1 < W and int(g[rr, right + 1]) == int(BG):
   267	                    right += 1
   268	
   269	                drops = [int(x) for x in range(left, right + 1) if int(g[rr + 1, int(x)]) == int(BG)]
   270	                if not drops:
   271	                    break
   272	
   273	                min_dist = min(abs(int(x - cc)) for x in drops)
   274	                nearest = [int(x) for x in drops if abs(int(x - cc)) == int(min_dist)]
   275	                if len(nearest) != 1:
   276	                    raise AssertionError(f"ambiguous nearest drop columns: {nearest}")
   277	                best = nearest[0]
   278	                if best == int(cc):
   279	                    raise AssertionError("classic settle found a zero-step horizontal move")
   280	                step = -1 if best < int(cc) else 1
   281	                nx = int(cc + step)
   282	                if int(g[rr, nx]) != int(BG):
   283	                    raise AssertionError("classic horizontal slide hit a blocked cell")
   284	                cc = nx
   285	                continue
   286	
   287	            break
   288	        else:
   289	            raise AssertionError("classic water pixel did not settle")
   290	        return int(rr), int(cc)
   291	
   292	    for _pass in range(H * W):
   293	        moved = False
   294	        pts = sorted([(int(r), int(c)) for r, c in np.argwhere(g == int(WATER))], reverse=True)
   295	        for r, c in pts:
   296	            if int(g[r, c]) != int(WATER):
   297	                continue
   298	            g[r, c] = int(BG)
   299	            rr, cc = settle(r, c)
   300	            moved = bool(moved or ((rr, cc) != (r, c)))
   301	            g[rr, cc] = int(WATER)
   302	        if not moved:
   303	            break
   304	    else:
   305	        raise AssertionError("classic water simulation did not converge")
   306	
   307	    return g
   308	
   309	
   310	def _draw_walls(grid: np.ndarray, wall_cols: tuple[int, ...], wall_tops: list[int], colors: tuple[int, int]) -> None:
   311	    for idx, (c, top) in enumerate(zip(wall_cols, wall_tops)):
   312	        grid[int(top) :, int(c)] = int(colors[idx % len(colors)])
   313	
   314	
   315	def _sample_wall_tops(rng: random.Random, wall_cols: tuple[int, ...], height: int) -> list[int]:
   316	    water_top = int(H - height)
   317	    outer_choices = [int(r) for r in range(5, water_top + 1)]
   318	    left_outer = int(rng.choice(outer_choices))
   319	    right_outer = int(rng.choice(outer_choices))
   320	
   321	    tops = {int(wall_cols[0]): left_outer, int(wall_cols[-1]): right_outer}
   322	    for c in wall_cols[1:-1]:
   323	        if rng.random() < 0.7 and water_top + 1 <= 9:
   324	            short_low = max(6, water_top + 1)
   325	            top = int(rng.randint(short_low, 9))
   326	        else:
   327	            tall_low = max(6, water_top - 1)
   328	            tall_high = min(9, water_top)
   329	            top = int(rng.randint(tall_low, tall_high))
   330	        tops[int(c)] = top
   331	    return [int(tops[int(c)]) for c in wall_cols]
   332	
   333	
   334	def _build_output_case(rng: random.Random) -> tuple[np.ndarray, int, int, int]:
   335	    height = int(rng.randint(2, 4))
   336	    wall_cols = tuple(rng.choice(LAYOUTS))
   337	    wall_tops = _sample_wall_tops(rng, wall_cols, height)
   338	    colors = rng.sample(list(range(2, 10)), 3)
   339	    shelf_color = int(colors[0])
   340	    wall_colors = (int(colors[1]), int(colors[2]))
   341	
   342	    base = np.zeros((H, W), dtype=int)
   343	    _draw_walls(base, wall_cols, wall_tops, wall_colors)
   344	    basins = _parse_basins(base)
   345	    out = _stack_height_output(base, height, basins)
   346	    target_width = int(len(_target_columns(basins)))
   347	    return out, height, target_width, shelf_color
   348	
   349	
   350	def _place_source_rectangle(grid: np.ndarray, height: int, width: int, shelf_color: int) -> None:
   351	    assert 2 <= int(height) <= 4
   352	    assert 2 <= int(width) <= 3
   353	    top = int(SHELF_ROW - height)
   354	    grid[SHELF_ROW, :width] = int(shelf_color)
   355	    grid[top:SHELF_ROW, :width] = int(WATER)
   356	
   357	
   358	def _flip_pair_if_needed(inp: np.ndarray, out: np.ndarray, rng: random.Random) -> tuple[np.ndarray, np.ndarray]:
   359	    if rng.random() < 0.5:
   360	        return np.fliplr(inp).copy(), np.fliplr(out).copy()
   361	    return inp, out
   362	
   363	
   364	def generate_input() -> np.ndarray:
   365	    for _ in range(400):
   366	        rng = random.Random(random.randrange(1 << 30))
   367	        out, height, target_width, shelf_color = _build_output_case(rng)
   368	        src_width = int(rng.choice([2, 3]))
   369	        assert src_width != target_width, "generator must preserve count mismatch against the target width"
   370	
   371	        expected = np.array(out, dtype=int).copy()
   372	        expected[SHELF_ROW, :src_width] = int(shelf_color)
   373	        inp = np.array(expected, dtype=int).copy()
   374	        inp[inp == int(WATER)] = int(BG)
   375	        _place_source_rectangle(inp, height, src_width, shelf_color)
   376	        inp, expected = _flip_pair_if_needed(inp, expected, rng)
   377	
   378	        try:
   379	            solved = main(inp)
   380	            classic = _classic_main(inp)
   381	        except Exception:
   382	            continue
   383	
   384	        if np.array_equal(solved, expected) and not np.array_equal(solved, classic):
   385	            return inp
   386	
   387	    raise RuntimeError("failed to generate a valid combo variant sample")

