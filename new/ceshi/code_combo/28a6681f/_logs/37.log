from __future__ import annotations
import numpy as np, random

BG=0
BLUE=1
RED=2
ROUGH=3
SMOOTH=4
GUIDE=5
WATERS=(BLUE,RED)

TEMPLATES=[
    (\"5533300000\",\"0033300400\",\"0033304440\"),
    (\"5533300000\",\"0033304000\",\"0033304440\"),
    (\"5533000400\",\"0033300400\",\"0033344440\"),
    (\"5533300000\",\"0033304040\",\"0033344440\"),
    (\"5533000400\",\"0033304400\",\"0033344400\"),
]

def grid_from_rows(rows):
    return np.array([[int(ch) for ch in row] for row in rows], dtype=int)

def infer_side(grid):
    left=np.any(np.isin(grid[:,0], WATERS))
    right=np.any(np.isin(grid[:,-1], WATERS))
    if left and not right: return 'left'
    if right and not left: return 'right'
    return 'left'

def order_positions(points, side):
    if side=='left':
        return sorted(points, key=lambda rc:(-rc[0], -rc[1]))
    return sorted(points, key=lambda rc:(-rc[0], rc[1]))

def settle_path(g, start, friction_enabled=True):
    h,w=g.shape
    rr,cc=start
    cost=0
    rough_blocks=0
    smooth_steps=0
    for _ in range(h*w):
        if rr+1<h and int(g[rr+1,cc])==BG:
            rr+=1
            continue
        opts=[]
        if rr+1<h and cc-1>=0 and int(g[rr,cc-1])==BG and int(g[rr+1,cc-1])==BG:
            opts.append((rr+1,cc-1))
        if rr+1<h and cc+1<w and int(g[rr,cc+1])==BG and int(g[rr+1,cc+1])==BG:
            opts.append((rr+1,cc+1))
        if opts:
            if len(opts)"'!=1: raise AssertionError(('"'diag', start, opts))
            rr,cc=opts[0]
            cost+=1
            smooth_steps+=1
            continue
        if rr+1<h and int(g[rr+1,cc])"'!=BG:
            left=cc
            while left-1>=0 and int(g[rr,left-1])==BG:
                left-=1
            right=cc
            while right+1<w and int(g[rr,right+1])==BG:
                right+=1
            drops=[x for x in range(left,right+1) if int(g[rr+1,x])==BG]
            support=int(g[rr+1,cc])
            if friction_enabled and support==ROUGH:
                if drops:
                    rough_blocks+=1
                break
            if not drops:
                break
            md=min(abs(x-cc) for x in drops)
            near=[x for x in drops if abs(x-cc)==md]
            if len(near)!=1: raise AssertionError(('"'h', start, rr,cc,drops,near))
            best=near[0]
            cc += -1 if best<cc else 1
            cost+=1
            smooth_steps+=1
            continue
        break
    return (rr,cc), cost, rough_blocks, smooth_steps

def simulate(grid, friction_enabled=True, evaporation_enabled=True, blue_blocks_red=True):
    src=np.array(grid, dtype=int)
    side=infer_side(src)
    base=np.where(np.isin(src,[ROUGH,SMOOTH,GUIDE]),src,BG)
    final=base.copy()
    metrics={'rough_blocks':0,'smooth_steps':0,'costs':{BLUE:0,RED:0},'survivors':{BLUE:0,RED:0},'initial':{BLUE:int(np.count_nonzero(src==BLUE)),RED:int(np.count_nonzero(src==RED))}}
    blue_final=None
    for color in WATERS:
        queue=order_positions([tuple(map(int,p)) for p in np.argwhere(src==color)], side)
        if color==RED and not blue_blocks_red:
            # strip blue before simulating red
            final=np.where(final==BLUE,BG,final)
        while queue:
            start=queue.pop(0)
            end,cost,rb,ss=settle_path(final,start,friction_enabled=friction_enabled)
            metrics['rough_blocks'] += rb
            metrics['smooth_steps'] += ss
            metrics['costs'][color] += cost
            metrics['survivors'][color] += 1
            if evaporation_enabled:
                for _ in range(cost):
                    if queue:
                        queue.pop()
            final[end]=color
        if color==BLUE:
            blue_final=np.array(final)
    return final, metrics


def metrics(grid):
    combo,m=simulate(grid,True,True,True)
    no_fric,_=simulate(grid,False,True,True)
    no_evap,_=simulate(grid,True,False,True)
    red_free,_=simulate(grid,True,True,False)
    return {
        'diff_fric':int(np.count_nonzero(combo"'!=no_fric)),
        '"'diff_evap':int(np.count_nonzero(combo"'!=no_evap)),
        '"'diff_red':int(np.count_nonzero(combo"'!=red_free)),
        '"'rough_blocks':m['rough_blocks'],
        'smooth_steps':m['smooth_steps'],
        'blue_surv':m['survivors'][BLUE],
        'red_surv':m['survivors'][RED],
        'blue_loss':m['initial'][BLUE]-m['survivors'][BLUE],
        'red_loss':m['initial'][RED]-m['survivors'][RED],
    }, combo, no_fric, no_evap, red_free

rng=random.Random(0)
