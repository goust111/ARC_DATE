   119	def _horizontal_run(grid: np.ndarray, rr: int, cc: int) -> tuple[int, int, list[int]]:
   120	    h, w = grid.shape
   121	    assert rr + 1 < h
   122	    left = int(cc)
   123	    while left - 1 >= 0 and int(grid[rr, left - 1]) == int(BG):
   124	        left -= 1
   125	    right = int(cc)
   126	    while right + 1 < w and int(grid[rr, right + 1]) == int(BG):
   127	        right += 1
   128	    drops = [int(x) for x in range(int(left), int(right) + 1) if int(grid[rr + 1, int(x)]) == int(BG)]
   129	    return int(left), int(right), drops
   130	
   131	
   132	def _trace_unit(
   133	    grid: np.ndarray,
   134	    start: tuple[int, int],
   135	    *,
   136	    friction_enabled: bool,
   137	) -> tuple[tuple[int, int], int, dict[str, int]]:
   138	    h, w = grid.shape
   139	    rr, cc = map(int, start)
   140	    nonvertical_steps = 0
   141	    rough_blocks = 0
   142	
   143	    for _ in range(h * w):
   144	        if rr + 1 < h and int(grid[rr + 1, cc]) == int(BG):
   145	            rr += 1
   146	            continue
   147	
   148	        opts: list[tuple[int, int]] = []
   149	        if (
   150	            rr + 1 < h
   151	            and cc - 1 >= 0
   152	            and int(grid[rr, cc - 1]) == int(BG)
   153	            and int(grid[rr + 1, cc - 1]) == int(BG)
   154	        ):
   155	            opts.append((int(rr + 1), int(cc - 1)))
   156	        if (
   157	            rr + 1 < h
   158	            and cc + 1 < w
   159	            and int(grid[rr, cc + 1]) == int(BG)
   160	            and int(grid[rr + 1, cc + 1]) == int(BG)
   161	        ):
   162	            opts.append((int(rr + 1), int(cc + 1)))
   163	        if opts:
   164	            assert len(opts) == 1, f"ambiguous diagonal moves: {opts}"
   165	            rr, cc = opts[0]
   166	            nonvertical_steps += 1
   167	            continue
   168	
   169	        if rr + 1 < h and int(grid[rr + 1, cc]) != int(BG):
   170	            _left, _right, drops = _horizontal_run(grid, int(rr), int(cc))
   171	            support_color = int(grid[rr + 1, cc])
   172	            if friction_enabled and support_color == int(ROUGH):
   173	                if drops:
   174	                    rough_blocks += 1
   175	                break
   176	            if not drops:
   177	                break
   178	            min_dist = min(abs(int(x - cc)) for x in drops)
   179	            nearest = [int(x) for x in drops if abs(int(x - cc)) == int(min_dist)]
   180	            assert len(nearest) == 1, f"ambiguous nearest drop columns: {nearest}"
   181	            best = int(nearest[0])
   182	            assert best != int(cc)
   183	            step = -1 if best < int(cc) else 1
   184	            nx = int(cc + step)
   185	            assert int(grid[rr, nx]) == int(BG)
   186	            cc = nx
   187	            nonvertical_steps += 1
   188	            continue
   189	
   190	        break
   191	    else:
   192	        raise AssertionError("water unit did not settle")
   193	
   194	    return (int(rr), int(cc)), int(nonvertical_steps), {"rough_blocks": int(rough_blocks)}
   195	
