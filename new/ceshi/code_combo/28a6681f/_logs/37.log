    return 'left' if left and not right else 'right'

def order_positions(points, side):
    return sorted(points, key=(lambda rc:(-rc[0], -rc[1])) if side=='left' else (lambda rc:(-rc[0], rc[1])))

def settle_path(g, start, friction_enabled=True):
    h,w=g.shape; rr,cc=start; cost=0; rb=0; ss=0
    for _ in range(h*w):
        if rr+1<h and int(g[rr+1,cc])==BG: rr+=1; continue
        opts=[]
        if rr+1<h and cc-1>=0 and int(g[rr,cc-1])==BG and int(g[rr+1,cc-1])==BG: opts.append((rr+1,cc-1))
        if rr+1<h and cc+1<w and int(g[rr,cc+1])==BG and int(g[rr+1,cc+1])==BG: opts.append((rr+1,cc+1))
        if opts:
            if len(opts)"'!=1: raise AssertionError
            rr,cc=opts[0]; cost+=1; ss+=1; continue
        if rr+1<h and int(g[rr+1,cc])!=BG:
            left=cc
            while left-1>=0 and int(g[rr,left-1])==BG: left-=1
            right=cc
            while right+1<w and int(g[rr,right+1])==BG: right+=1
            drops=[x for x in range(left,right+1) if int(g[rr+1,x])==BG]
            if friction_enabled and int(g[rr+1,cc])==ROUGH:
                if drops: rb+=1
                break
            if not drops: break
            md=min(abs(x-cc) for x in drops)
            near=[x for x in drops if abs(x-cc)==md]
            if len(near)!=1: raise AssertionError
            cc += -1 if near[0]<cc else 1
            cost+=1; ss+=1; continue
        break
    return (rr,cc), cost, rb, ss

def simulate(grid, friction_enabled=True, evaporation_enabled=True, blue_blocks_red=True):
    src=np.array(grid, dtype=int)
    side=infer_side(src)
    base=np.where(np.isin(src,[ROUGH,SMOOTH,GUIDE]),src,BG)
    final=base.copy()
    metrics={'"'rough_blocks':0,'smooth_steps':0,'surv':{BLUE:0,RED:0},'init':{BLUE:int(np.count_nonzero(src==BLUE)),RED:int(np.count_nonzero(src==RED))}}
    for color in WATERS:
        queue=order_positions([tuple(map(int,p)) for p in np.argwhere(src==color)], side)
        if color==RED and not blue_blocks_red:
            final=np.where(final==BLUE,BG,final)
        while queue:
            start=queue.pop(0)
            end,cost,rb,ss=settle_path(final,start,friction_enabled)
            metrics['rough_blocks'] += rb; metrics['smooth_steps'] += ss; metrics['surv'][color]+=1
            if evaporation_enabled:
                for _ in range(cost):
                    if queue: queue.pop()
            final[end]=color
    return final, metrics

def stats(grid):
    combo,m=simulate(grid,True,True,True)
    nf,_=simulate(grid,False,True,True)
    ne,_=simulate(grid,True,False,True)
    rb,_=simulate(grid,True,True,False)
    return {
      'diff_fric': int(np.count_nonzero(combo"'!=nf)),
      '"'diff_evap': int(np.count_nonzero(combo"'!=ne)),
      '"'diff_red': int(np.count_nonzero(combo"'!=rb)),
      '"'rough_blocks': m['rough_blocks'],
      'smooth_steps': m['smooth_steps'],
      'blue_surv': m['surv'][BLUE],
      'red_surv': m['surv'][RED],
      'blue_loss': m['init'][BLUE]-m['surv'][BLUE],
      'red_loss': m['init'][RED]-m['surv'][RED],
    }

def build(tpl, mirror, blue_width, red_width, blue_rows_n, red_rows_n):
    rows=['0000000000']*7+list(tpl)
    g=grid_from_rows(rows)
    blue_rows=list(range(7-blue_rows_n,7))
    red_top=7-blue_rows_n-red_rows_n
    red_rows=list(range(red_top,7-blue_rows_n))
    for r in blue_rows:
        g[r,:blue_width]=BLUE
    for r in red_rows:
        g[r,:red_width]=RED
    if mirror: g=np.fliplr(g).copy()
    return g

count=0
