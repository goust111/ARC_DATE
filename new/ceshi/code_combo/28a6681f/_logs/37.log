设计已经收敛到一个可实现版本：每个颜色批次都被当作“按几何顺序逐滴放水”的 reservoir，横向/对角一步会额外消耗同色的一个后续水滴，这样总损失量就正好等于非垂直步数。现在我先拿一个小模板做原型验证，确认蓝先落位、粗糙壁减滑、红再被蓝阻挡这三件事能同时出现。
exec
/bin/bash -lc "python - <<'PY'
from __future__ import annotations
import numpy as np

BG=0
BLUE=1
RED=2
ROUGH=3
SMOOTH=4
GUIDE=5
ORDER=(BLUE,RED)

def order_positions(points, side):
    # lower first, then closer to interior spill edge first
    if side=='left':
        return sorted(points, key=lambda rc: (-rc[0], -rc[1]))
    return sorted(points, key=lambda rc: (-rc[0], rc[1]))

def settle_path(g, start, rough_enabled=True):
    h,w=g.shape
    rr,cc=start
    cost=0
    path=[start]
    for _ in range(h*w):
        if rr+1<h and g[rr+1,cc]==BG:
            rr+=1; path.append((rr,cc)); continue
        opts=[]
        if rr+1<h and cc-1>=0 and g[rr,cc-1]==BG and g[rr+1,cc-1]==BG:
            opts.append((rr+1,cc-1))
        if rr+1<h and cc+1<w and g[rr,cc+1]==BG and g[rr+1,cc+1]==BG:
            opts.append((rr+1,cc+1))
        if opts:
            if len(opts)"'!=1: raise AssertionError(opts)
            rr,cc=opts[0]
            cost+=1
            path.append((rr,cc))
            continue
        if rr+1<h and g[rr+1,cc]!=BG:
            left=cc
            while left-1>=0 and g[rr,left-1]==BG:
                left-=1
            right=cc
            while right+1<w and g[rr,right+1]==BG:
                right+=1
            drops=[x for x in range(left,right+1) if g[rr+1,x]==BG]
            if rough_enabled and g[rr+1,cc]==ROUGH:
                break
            if not drops:
                break
