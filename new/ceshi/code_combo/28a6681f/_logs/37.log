   105	def _source_side(grid: np.ndarray) -> str:
   106	    left = bool(np.isin(grid[:, 0], WATER_BATCHES).any())
   107	    right = bool(np.isin(grid[:, -1], WATER_BATCHES).any())
   108	    assert left ^ right, "source water must touch exactly one vertical edge"
   109	    return "left" if left else "right"
