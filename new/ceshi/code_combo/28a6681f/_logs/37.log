   112	def _ordered_source_cells(grid: np.ndarray, color: int, side: str) -> list[tuple[int, int]]:
   113	    points = [(int(r), int(c)) for r, c in np.argwhere(grid == int(color))]
   114	    if side == "left":
   115	        return sorted(points, key=lambda rc: (-int(rc[0]), -int(rc[1])))
   116	    return sorted(points, key=lambda rc: (-int(rc[0]), int(rc[1])))
