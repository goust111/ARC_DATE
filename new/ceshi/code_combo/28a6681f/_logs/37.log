   197	def _simulate_batches(
   198	    grid: np.ndarray,
   199	    *,
   200	    friction_enabled: bool,
   201	    evaporation_enabled: bool,
   202	    blue_blocks_red: bool,
   203	    collect_metrics: bool,
   204	) -> tuple[np.ndarray, dict[str, int]] | np.ndarray:
   205	    src = np.array(grid, dtype=int).copy()
   206	    side = _source_side(src)
   207	    settled = np.where(np.isin(src, STATIC_COLORS), src, int(BG))
   208	
   209	    metrics = {
   210	        "rough_blocks": 0,
   211	        "nonvertical_steps": 0,
   212	        "initial_blue": int(np.count_nonzero(src == int(BLUE))),
   213	        "initial_red": int(np.count_nonzero(src == int(RED))),
   214	        "surviving_blue": 0,
   215	        "surviving_red": 0,
   216	    }
   217	
   218	    for color in WATER_BATCHES:
   219	        queue = _ordered_source_cells(src, int(color), side)
   220	        if color == int(RED) and not blue_blocks_red:
   221	            settled = np.where(settled == int(BLUE), int(BG), settled)
   222	
   223	        while queue:
   224	            start = queue.pop(0)
   225	            assert int(settled[start]) == int(BG), "source cell must stay open while a batch is pouring"
   226	            end, cost, unit_metrics = _trace_unit(settled, start, friction_enabled=friction_enabled)
   227	            assert int(settled[end]) == int(BG), "settled water cannot overwrite an occupied cell"
   228	            settled[end] = int(color)
   229	
   230	            if color == int(BLUE):
   231	                metrics["surviving_blue"] += 1
   232	            else:
   233	                metrics["surviving_red"] += 1
   234	
   235	            if collect_metrics:
   236	                metrics["rough_blocks"] += int(unit_metrics["rough_blocks"])
   237	                metrics["nonvertical_steps"] += int(cost)
   238	
   239	            if evaporation_enabled:
   240	                for _ in range(int(cost)):
   241	                    if queue:
   242	                        queue.pop()
   243	
   244	    if not collect_metrics:
   245	        return settled
   246	    return settled, metrics
