def _distribute(total: int, parts: int, min_each: int, rng: random.Random) -> list[int]:
    vals = [int(min_each)] * int(parts)
    rem = int(total - min_each * parts)
    assert rem >= 0
    for _ in range(rem):
        vals[rng.randrange(parts)] += 1
    rng.shuffle(vals)
    return vals



