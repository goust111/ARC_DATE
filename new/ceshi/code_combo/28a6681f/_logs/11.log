+    for col, depth in zip(drops, depths):
+        for r in range(int(roof_row), min(GRID_SHAPE[0], int(roof_row + depth))):
+            g[int(r), int(col)] = int(BG)
+    g[: int(roof_row), int(source_start) : int(source_start + source_width)] = int(WATER)
+    if mirror:
+        g = np.fliplr(g)
+    return g
+
