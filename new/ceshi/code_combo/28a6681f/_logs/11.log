+    assert isinstance(farthest_right, np.ndarray)
+    return {
+        **combo_metrics,
+        "combo_vs_nearest_diff": int(np.sum(combo != nearest_left)),
+        "combo_vs_far_right_diff": int(np.sum(combo != farthest_right)),
+        "water_count": int(np.count_nonzero(combo == int(WATER))),
