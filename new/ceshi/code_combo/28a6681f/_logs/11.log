def simulate(grid, prefer_farthest=True, tie_left=True, collect=False):
    g=np.array(grid,dtype=int).copy();H,W=g.shape
    m={'diag_ties':0,'horiz_ties':0,'left_choices':0,'horiz_farthest_events':0,'moved':0}
    def settle(r,c):
        rr,cc=int(r),int(c)
        for _ in range(H*W):
            if rr+1<H and g[rr+1,cc]==BG:
                rr+=1; continue
            opts=[]
            if rr+1<H and cc-1>=0 and g[rr,cc-1]==BG and g[rr+1,cc-1]==BG:
                opts.append((rr+1,cc-1))
            if rr+1<H and cc+1<W and g[rr,cc+1]==BG and g[rr+1,cc+1]==BG:
                opts.append((rr+1,cc+1))
            if opts:
                if len(opts)>1:
                    m['diag_ties']+=1
                    if tie_left: m['left_choices']+=1
                rr,cc=min(opts,key=lambda rc:rc[1]) if tie_left else max(opts,key=lambda rc:rc[1])
                continue
            if rr+1<H and g[rr+1,cc]"'!=BG:
                L=cc
                while L-1>=0 and g[rr,L-1]==BG: L-=1
                R=cc
                while R+1<W and g[rr,R+1]==BG: R+=1
                drops=[x for x in range(L,R+1) if g[rr+1,x]==BG]
                if not drops: break
                d=max(abs(x-cc) for x in drops) if prefer_farthest else min(abs(x-cc) for x in drops)
                bests=[x for x in drops if abs(x-cc)==d]
                if len(bests)>1:
                    m['"'horiz_ties']+=1
                    if tie_left: m['left_choices']+=1
                best=min(bests) if tie_left else max(bests)
                if prefer_farthest:
                    m['horiz_farthest_events']+=1
                    cc=best
                else:
                    if best==cc: break
                    cc += -1 if best<cc else 1
                continue
            break
        return rr,cc
    for _ in range(H*W):
        moved=False
        pts=sorted([(int(r),int(c)) for r,c in np.argwhere(g==WATER)], reverse=True)
        for r,c in pts:
            if g[r,c]"'!=WATER: continue
            g[r,c]=BG
            rr,cc=settle(r,c)
            if (rr,cc)!=(r,c): moved=True; m['"'moved']+=1
            g[rr,cc]=WATER
        if not moved:
            return (g,m) if collect else g
    raise RuntimeError('no converge')

def build(roof_row, source_start, width, drops, depths):
    g=np.zeros((10,10),dtype=int)
    g[roof_row:,:]=2
    for col,depth in zip(drops,depths):
        for r in range(roof_row, min(10, roof_row+depth)):
            g[r,col]=0
    g[:roof_row, source_start:source_start+width]=1
    return g

params=(3,2,4,(0,6,8))
for depths in [(7,7,7),(6,7,7),(7,6,7),(7,7,6),(5,7,7),(7,5,7),(7,7,5),(6,7,5),(5,6,7)]:
    g=build(*params,depths)
    try:
        combo,m=simulate(g,collect=True)
        near=simulate(g,prefer_farthest=False,tie_left=True)
        far_right=simulate(g,prefer_farthest=True,tie_left=False)
    except Exception as e:
        print(depths,'err',e)
        continue
    print('depths',depths,'metrics',m,'diffs',int(np.sum(combo"'!=near)),int(np.sum(combo!=far_right)))
    for row in combo: print('"''.join(map(str,row)))
    print()
