                    best_cols = [int(x) for x in drops if abs(int(x - cc)) == int(best_dist)]
                    assert len(best_cols) == 1, f"ambiguous nearest drop columns: {best_cols}"
                    best = int(best_cols[0])
                    assert best != int(cc)
                    step = -1 if best < int(cc) else 1
