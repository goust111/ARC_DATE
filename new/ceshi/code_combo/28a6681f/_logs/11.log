+    return out
+
+
+def _behavior_metrics(grid: np.ndarray) -> dict[str, int]:
+    combo, combo_metrics = _simulate(
+        grid,
+        prefer_farthest=True,
+        tie_break="left",
+        check_input=True,
+        check_output=True,
+        collect_metrics=True,
+    )
