+            rr = int(r)
+            cc = int(c)
+            assert cc == 0 or int(g[rr, cc - 1]) != int(BG), "output water must be left-supported"
+            assert rr == h - 1 or int(g[rr + 1, cc]) != int(BG), "output water must be floor-supported"
+            assert cc == w - 1 or int(g[rr, cc + 1]) != int(BG), "output water must be right-supported"
+
+    if collect_metrics:
+        return g, metrics
+    return g
+
