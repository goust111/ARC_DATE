    g[6:10,1]=BASIN
    g[6:10,8]=BASIN
    g[partition_top:10,5]=BASIN
    g[8,3]=BASIN
    # left guide
    top=4-left_h
    if top-1>=0: g[top-1,1]=SIDE
    g[1:4,0]=SIDE
    g[1:3,2]=SIDE
    g[4,1]=SIDE
    for r in range(top,4): g[r,1]=WATER
    # right
    top=4-right_h
    if top-1>=0: g[top-1,8]=SIDE
    g[1:4,9]=SIDE
    g[1:3,7]=SIDE
    g[4,8]=SIDE
    for r in range(top,4): g[r,8]=WATER
    # top guide
    top=3-top_h
    if top-1>=0: g[top-1,5]=TOP
    g[0:3,4]=TOP
    g[0:2,6]=TOP
    g[3,5]=TOP
    for r in range(top,3): g[r,5]=WATER
    return g

def exits(g):
    h,w=g.shape
    out=[]
    for comp in comps(g==WATER):
        adj=set()
        for r,c in comp:
            for nr,nc in neighbors4(r,c,h,w):
                if g[nr,nc]==BG:
                    adj.add((nr,nc))
        out.append((comp,sorted(adj)))
    return out

def layers(g):
    h,w=g.shape
    src=[tuple(map(int,p)) for p in np.argwhere(g==WATER)]
    compsrc=comps(g==WATER)
    exits=[]
    for comp in compsrc:
        adj=set()
        for r,c in comp:
            for nr,nc in neighbors4(r,c,h,w):
                if g[nr,nc]==BG: adj.add((nr,nc))
        exits.append(sorted(adj)[0])
        print('comp',comp,'adj',sorted(adj))
    seen=np.zeros((h,w),dtype=bool)
    for r,c in src: seen[r,c]=True
    rem=len(src)
    filled=[]
    frontier=sorted(exits)
    for r,c in frontier: seen[r,c]=True
    if rem>=len(frontier):
        chosen=frontier; rem-=len(frontier); filled+=chosen; lays=[chosen]
    else:
        chosen=frontier[:rem]; filled+=chosen; rem=0; lays=[chosen]; frontier=[]
    while frontier and rem>0:
        layer=set()
        for r,c in frontier:
            for nr,nc in neighbors4(r,c,h,w):
                if seen[nr,nc] or g[nr,nc]"'!=BG: continue
                seen[nr,nc]=True
                layer.add((nr,nc))
        ordered=sorted(layer)
        if not ordered: break
        if rem>=len(ordered):
            chosen=ordered; frontier=ordered; rem-=len(ordered)
        else:
            chosen=ordered[:rem]; frontier=[]; rem=0
        lays.append(chosen); filled+=chosen
    return lays,filled,rem

for params in [(3,3,3,7),(2,3,3,7),(3,3,2,6),(3,2,2,6)]:
    g=build(*params)
