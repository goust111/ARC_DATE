import numpy as np
BG=0; WATER=1

def build(left_h=5,right_h=5):
    g=np.zeros((10,10),dtype=int)
    B=2; S=3; T=4
    g[9,1:9]=B
    g[5:10,1]=B
    g[5:10,8]=B
    g[6:10,5]=B
    g[1:4,1]=S
    if 5-left_h-1 >= 0: g[5-left_h-1,0]=S
    g[5,0]=S
    g[5-left_h:5,0]=WATER
    g[1:4,8]=S
    if 5-right_h-1 >= 0: g[5-right_h-1,9]=S
    g[5,9]=S
    g[5-right_h:5,9]=WATER
    g[0:5,4]=T
    g[0:3,6]=T
    g[4,5]=T
    g[0:4,5]=WATER
    return g

from collections import deque

def neigh(r,c,h,w):
    for dr,dc in ((-1,0),(1,0),(0,-1),(0,1)):
        nr,nc=r+dr,c+dc
        if 0<=nr<h and 0<=nc<w: yield nr,nc

def comps(mask):
    h,w=mask.shape; seen=set(); out=[]
    for r,c in np.argwhere(mask):
        s=(int(r),int(c))
        if s in seen: continue
        st=[s]; seen.add(s); comp=[]
        while st:
            rr,cc=st.pop(); comp.append((rr,cc))
            for nr,nc in neigh(rr,cc,h,w):
                if mask[nr,nc] and (nr,nc) not in seen:
                    seen.add((nr,nc)); st.append((nr,nc))
        out.append(sorted(comp))
    return out

def plan(g):
    compsrc=comps(g==1)
    exits=[]
    for comp in compsrc:
        adj=set()
        for r,c in comp:
            for nr,nc in neigh(r,c,*g.shape):
                if g[nr,nc]==0: adj.add((nr,nc))
        exits.append(sorted(adj)[0])
    seen=np.zeros(g.shape,dtype=bool)
    for r,c in np.argwhere(g==1): seen[int(r),int(c)]=True
    rem=int(np.sum(g==1)); filled=[]; layers=[]
    frontier=sorted(exits)
    for r,c in frontier: seen[r,c]=True
    layers.append(frontier); filled+=frontier; rem-=len(frontier)
    while frontier and rem>0:
        layer=set()
        for r,c in frontier:
            for nr,nc in neigh(r,c,*g.shape):
                if seen[nr,nc] or g[nr,nc]"'!=0: continue
                seen[nr,nc]=True; layer.add((nr,nc))
        ord=sorted(layer)
        if not ord: break
        if rem>=len(ord):
            chosen=ord; frontier=ord; rem-=len(chosen)
        else:
            chosen=ord[:rem]; frontier=[]; rem=0
        layers.append(chosen); filled+=chosen
    out=g.copy(); out[out==1]=0
    for r,c in filled: out[r,c]=1
    return layers,out

for params in [(5,5),(5,4),(4,5)]:
    g=build(*params)
    print('"'params',params,'water',np.sum(g==1))
    for row in g: print(''.join(map(str,row)))
    layers,out=plan(g)
    print('layers', [len(x) for x in layers])
    for row in out: print(''.join(map(str,row)))
    # component count
    mask=out==1; h,w=mask.shape; seen=set(); n=0
    for r,c in np.argwhere(mask):
        s=(int(r),int(c))
        if s in seen: continue
        n+=1; st=[s]; seen.add(s)
        while st:
            rr,cc=st.pop()
            for nr,nc in neigh(rr,cc,h,w):
                if mask[nr,nc] and (nr,nc) not in seen:
                    seen.add((nr,nc)); st.append((nr,nc))
    print('components',n)
    print('-'*20)
