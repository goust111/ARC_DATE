    print('layers', [len(x) for x in lays], 'rem', rem, 'filled', filled)
    out=g.copy(); out[out==WATER]=0
    for r,c in filled: out[r,c]=1
    print('out')
    for row in out: print(''.join(map(str,row)))
    print('-'*30)
