+BG = 0
+WATER = 1
+GRID_SHAPE = (10, 10)
+SOLID_POOL = (2, 3, 4, 5, 6, 7, 8, 9)
+GEN_RETRIES = 400
+
+ABSTRACT_BASIN = 2
+ABSTRACT_SIDE_GUIDE = 3
+ABSTRACT_TOP_GUIDE = 4
