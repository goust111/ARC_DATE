+
+def _component_edge_labels(comp: list[tuple[int, int]], h: int, w: int) -> set[str]:
+    labels: set[str] = set()
+    if any(r == 0 for r, _c in comp):
+        labels.add("top")
+    if any(c == 0 for _r, c in comp):
+        labels.add("left")
+    if any(c == w - 1 for _r, c in comp):
+        labels.add("right")
+    if any(r == h - 1 for r, _c in comp):
+        labels.add("bottom")
+    return labels
+
