        for _ in range(H*W):
            if rr+1<H and int(g[rr+1,cc])==0:
                rr+=1; continue
            opts=[]
            if rr+1<H and cc-1>=0 and int(g[rr,cc-1])==0 and int(g[rr+1,cc-1])==0:
