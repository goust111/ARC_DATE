+    exits: list[tuple[int, int]] = []
+    source_edges: list[str] = []
+    for comp in comps:
+        if check_input:
+            for r, c in comp:
+                assert r == h - 1 or int(g[r + 1, c]) != int(BG), "input water must be supported"
