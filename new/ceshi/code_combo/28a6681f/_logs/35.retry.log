import numpy as np
BG=0; WATER=1

def neigh(r,c,h,w):
    for dr,dc in ((-1,0),(1,0),(0,-1),(0,1)):
        nr,nc=r+dr,c+dc
        if 0<=nr<h and 0<=nc<w: yield nr,nc

def comps(mask):
    h,w=mask.shape
    seen=set(); out=[]
    for r,c in np.argwhere(mask):
        start=(int(r),int(c))
        if start in seen: continue
        stack=[start]; seen.add(start); comp=[]
        while stack:
            rr,cc=stack.pop(); comp.append((rr,cc))
            for nr,nc in neigh(rr,cc,h,w):
                if mask[nr,nc] and (nr,nc) not in seen:
                    seen.add((nr,nc)); stack.append((nr,nc))
        out.append(sorted(comp))
    return out

def build(left_h=4,right_h=4,top_h=5,partition_top=6,wall_top=5):
    g=np.zeros((10,10),dtype=int)
    B=2; S=3; T=4
    g[9,1:9]=B
    g[wall_top:10,1]=B
    g[wall_top:10,8]=B
    g[partition_top:10,5]=B
    g[partition_top+1,6]=B
    bottom=4; top=bottom-left_h+1
    # left guide connected-ish
    g[0,0:2]=S
    g[1:4,1]=S
    g[3:6,2]=S
    g[5,0:3]=S
    for r in range(top,bottom+1): g[r,0]=WATER
    # right
    g[0,8:10]=S
    g[1:4,8]=S
    g[3:6,7]=S
    g[5,7:10]=S
    for r in range(top,bottom+1): g[r,9]=WATER
    # top source vertical mouth at (4,6)
    bottomt=4; topt=bottomt-top_h+1
    g[0:5,4]=T
    g[0:4,6]=T
    g[5,4:7]=T
    for r in range(topt,bottomt+1): g[r,5]=WATER
    return g

def exits(g):
    ex=[]
    for comp in comps(g==WATER):
        adj=set()
        for r,c in comp:
            for nr,nc in neigh(r,c,*g.shape):
                if g[nr,nc]==0: adj.add((nr,nc))
        ex.append((comp,sorted(adj)))
    return ex

def diffusion(g):
    src=[tuple(map(int,p)) for p in np.argwhere(g==1)]
    seen=np.zeros(g.shape,dtype=bool)
    for p in src: seen[p]=True
    frontier=[]; rem=len(src); lays=[]; filled=[]
    for comp,adj in exits(g): frontier.append(adj[0])
    frontier=sorted(frontier)
    for p in frontier: seen[p]=True
    lays.append(frontier); filled+=frontier; rem-=len(frontier)
    while frontier and rem>0:
        layer=set()
        for r,c in frontier:
            for nr,nc in neigh(r,c,*g.shape):
                if seen[nr,nc] or g[nr,nc]"'!=0: continue
                seen[nr,nc]=True; layer.add((nr,nc))
        ordered=sorted(layer)
        if not ordered: break
        if rem>=len(ordered):
            chosen=ordered; frontier=ordered; rem-=len(ordered)
        else:
            chosen=ordered[:rem]; frontier=[]; rem=0
        lays.append(chosen); filled+=chosen
    return lays,filled,rem

g=build()
for row in g: print('"''.join(map(str,row)))
print(exits(g))
lays,filled,rem=diffusion(g)
print([len(x) for x in lays], rem)
out=g.copy(); out[out==1]=0
for r,c in filled: out[r,c]=1
print('out')
for row in out: print(''.join(map(str,row)))
