+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    dist: dict[tuple[int, int], int] = {start: 0}
+    queue = [start]
+    head = 0
+    while head < len(queue):
+        r, c = queue[head]
+        head += 1
+        for nr, nc in _neighbors4(r, c, h, w):
+            nxt = (int(nr), int(nc))
+            if nxt in blocked or nxt in dist:
