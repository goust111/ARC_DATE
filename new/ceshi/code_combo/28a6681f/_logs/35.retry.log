import numpy as np
from collections import deque
BG=0; WATER=1

def neighbors4(r,c,h,w):
    for dr,dc in ((-1,0),(1,0),(0,-1),(0,1)):
        nr,nc=r+dr,c+dc
        if 0<=nr<h and 0<=nc<w:
            yield nr,nc

def comps(mask):
    h,w=mask.shape
    seen=set(); out=[]
    for r,c in np.argwhere(mask):
        r=int(r); c=int(c)
        if (r,c) in seen: continue
        stack=[(r,c)]; seen.add((r,c)); comp=[]
        while stack:
            rr,cc=stack.pop(); comp.append((rr,cc))
            for nr,nc in neighbors4(rr,cc,h,w):
                if mask[nr,nc] and (nr,nc) not in seen:
                    seen.add((nr,nc)); stack.append((nr,nc))
        out.append(sorted(comp))
    return out

def build(left_h=3,right_h=3,top_h=3,partition_top=7):
    g=np.zeros((10,10),dtype=int)
