+        return int(rr), int(cc)
+
+    for _pass in range(h * w):
+        moved = False
+        pts = sorted([(int(r), int(c)) for r, c in np.argwhere(g == int(WATER))], reverse=True)
+        for r, c in pts:
+            if int(g[r, c]) != int(WATER):
+                continue
+            g[r, c] = int(BG)
+            rr, cc = settle(r, c)
