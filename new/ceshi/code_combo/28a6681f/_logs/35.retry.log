                if not drops: break
                md=min(abs(x-cc) for x in drops)
                nearest=[x for x in drops if abs(x-cc)==md]
                if len(nearest)!=1: raise AssertionError(nearest)
                best=nearest[0]
                step=-1 if best<cc else 1
                nx=cc+step
                assert int(g[rr,nx])==0
                cc=nx; continue
            break
        else:
            raise AssertionError('"'loop')
        return rr,cc
    for _ in range(H*W):
        moved=False
