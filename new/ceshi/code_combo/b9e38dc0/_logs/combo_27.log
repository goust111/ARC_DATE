+    obstacles = (g != bg) & (g != fill) & (g != wall)
+
+    return {
+        "grid": g,
+        "h": h,
+        "w": w,
+        "bg": bg,
+        "wall": wall,
+        "fill": fill,
+        "fill_pos": fill_pos,
+        "comp_mask": comp_mask,
+        "seen": seen,
+        "filled_mask": filled_mask,
+        "obstacles": obstacles,
+        "rad": rad,
+    }
+
+
+def _shadowed_fill_mask(filled_mask: np.ndarray, obstacles: np.ndarray, rad: tuple[int, int]) -> np.ndarray:
+    h, w = filled_mask.shape
+    keep = filled_mask.copy()
+
+    def shadow_process(coords: list[tuple[int, int]]) -> None:
+        started = False
+        blocked = False
+        for r, c in coords:
+            if keep[r, c]:
+                started = True
+            if started and obstacles[r, c]:
+                blocked = True
+                continue
+            if blocked and keep[r, c]:
+                keep[r, c] = False
+
+    if rad == (0, 0):
+        return keep
+
+    dr, dc = rad
+    if dr != 0 and dc == 0:
+        for c in range(w):
+            rows = range(h) if dr > 0 else range(h - 1, -1, -1)
+            shadow_process([(r, c) for r in rows])
+    elif dc != 0 and dr == 0:
+        for r in range(h):
+            cols = range(w) if dc > 0 else range(w - 1, -1, -1)
+            shadow_process([(r, c) for c in cols])
+    elif dr == dc:
+        for k in range(-(w - 1), h):
+            coords = [(r, r - k) for r in range(h) if 0 <= r - k < w]
+            coords.sort(key=lambda rc: rc[0], reverse=(dr < 0))
+            shadow_process(coords)
+    else:
+        for k in range(h + w - 1):
+            coords = [(r, k - r) for r in range(h) if 0 <= k - r < w]
+            coords.sort(key=lambda rc: rc[0], reverse=(dr < 0))
+            shadow_process(coords)
+    return keep
+
+
+def _render_combo(geom: dict) -> np.ndarray:
+    g = geom["grid"]
+    if not geom["fill_pos"]:
+        return g.copy()
+
+    out = g.copy()
+    out[geom["comp_mask"]] = geom["fill"]
+    out[geom["seen"]] = geom["wall"]
+
+    kept_fill = _shadowed_fill_mask(geom["filled_mask"], geom["obstacles"], geom["rad"])
+    out[geom["filled_mask"] & ~kept_fill] = geom["bg"]
+    return out
+
+
+def _render_base(geom: dict) -> np.ndarray:
+    g = geom["grid"]
+    if not geom["fill_pos"]:
+        return g.copy()
+
+    out = g.copy()
+    out[geom["filled_mask"]] = geom["fill"]
+
+    kept_fill = _shadowed_fill_mask(geom["filled_mask"], geom["obstacles"], geom["rad"])
+    out[geom["filled_mask"] & ~kept_fill] = geom["bg"]
+    return out
