   377	            chosen_rows = [1]
   378	            if n_side_steps > 1:
   379	                chosen_rows += random.sample(range(2, depth + 1), n_side_steps - 1)
   380	            chosen_rows.sort()
   381	
   382	    first_row = chosen_rows[0] if chosen_rows else 1
   383	    extra_rows = [r for r in chosen_rows if r != first_row]
   384	    random.shuffle(extra_rows)
   385	    orthogonal_rows = set(extra_rows[:extra_steps])
   386	
   387	    pts = [(0, start_v)]
   388	    u, v = 0, start_v
   389	    for row in range(1, depth + 1):
   390	        u += 1
   391	        if row in orthogonal_rows:
   392	            pts.append((u, v))
   393	            v += sign
   394	        elif row in chosen_rows:
   395	            v += sign
   396	        pts.append((u, v))
   397	    return pts
   398	
   399	
   400	def _build_local_wall(rad, h, w):
   401	    if rad[0]:
   402	        max_depth = min(DEPTH_VERT[1], h - 6)
   403	        if max_depth < DEPTH_VERT[0]:
   404	            return None
   405	        depth = random.randint(DEPTH_VERT[0], max_depth)
   406	        gap = random.randint(*GAP_VERT)
   407	    else:
   408	        depth = random.randint(DEPTH_HORIZ[0], min(DEPTH_HORIZ[1], w - 6))
   409	        gap = random.randint(GAP_HORIZ[0], min(GAP_HORIZ[1], h - 1))
   410	
   411	    if gap == 5:
   412	        left_bottom, right_bottom = 2, 3
   413	    elif gap == 6:
   414	        left_bottom, right_bottom = 2, 4
   415	    else:
   416	        left_bottom, right_bottom = random.choice([(2, 5), (3, 4)])
   417	
   418	    bridge_extra = max(0, right_bottom - left_bottom - 1)
   419	    base_count = 2 * (depth + 1) + bridge_extra
   420	    max_extra_l = max(0, left_bottom - 1)
   421	    max_extra_r = max(0, gap - right_bottom - 1)
   422	    min_extra = max(0, WALL_PIXELS_MIN - base_count)
   423	    max_extra = min(max_extra_l + max_extra_r, WALL_PIXELS_MAX - base_count)
   424	    if min_extra > max_extra:
   425	        return None
   426	
   427	    extra = random.randint(min_extra, max_extra)
   428	    extra_l = random.randint(max(0, extra - max_extra_r), min(max_extra_l, extra))
   429	    extra_r = extra - extra_l
   430	
   431	    max_n_side = max(left_bottom, gap - right_bottom)
   432	    tip_12 = depth >= 2 * max_n_side and random.random() < TIP_12_PROB
   433	    left = _make_arm(depth, 0, left_bottom, extra_l, tip_12=tip_12)
   434	    right = _make_arm(depth, gap, right_bottom, extra_r, tip_12=tip_12)
   435	    pts = set(left) | set(right)
   436	    for v in range(left_bottom, right_bottom + 1):
   437	        pts.add((depth, v))
   438	
   439	    while len(pts) < WALL_PIXELS_MIN:
   440	        candidates = [
   441	            (u, v)
   442	            for u in range(max(0, depth - 3), depth + 1)
   443	            for v in range(gap + 1)
   444	            if (u, v) not in pts
   445	            and sum(
   446	                (uu, vv) in pts
   447	                for uu in range(u - 1, u + 2)
   448	                for vv in range(v - 1, v + 2)
   449	                if (uu, vv) != (u, v)
   450	            ) >= 2
   451	        ]
   452	        random.shuffle(candidates)
   453	        added = False
   454	        for p in candidates:
   455	            trial = pts | {p}
   456	            if len(trial) <= WALL_PIXELS_MAX and len(_degree1_pixels(trial)) == 2:
   457	                pts = trial
   458	                added = True
   459	                break
   460	        if not added:
   461	            return None
   462	
   463	    if not (WALL_PIXELS_MIN <= len(pts) <= WALL_PIXELS_MAX) or len(_degree1_pixels(pts)) != 2:
   464	        return None
   465	    return pts, depth, gap
   466	
   467	
   468	def _map_local(u, v, rad, anchor):
   469	    r0, c0 = anchor
   470	    if rad == (-1, 0):
   471	        return r0 + u, c0 + v
   472	    if rad == (1, 0):
   473	        return r0 - u, c0 + v
   474	    if rad == (0, -1):
