+    if (
+        int(new_fill.sum()) < MIN_NEW_FILL
+        or not _touches_border(new_fill)
+        or int(border_swap.sum()) < MIN_BORDER_SWAP
+        or behavior_gap < MIN_BEHAVIOR_GAP
+    ):
