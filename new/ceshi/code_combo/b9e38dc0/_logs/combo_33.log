+    target_size = random.choice(SEED_SIZE_WEIGHTS)
+    while len(blob) < target_size and frontier:
+        r, c = frontier.pop(random.randrange(len(frontier)))
+        nbrs = [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+        for q in random.sample(nbrs, len(nbrs)):
+            if q in interior_cells and q not in blob:
+                blob.add(q)
+                frontier.append(q)
+                if len(blob) >= target_size:
+                    break
+    return blob
+
+
+def _obstacle_fits(pos: tuple[int, int], placed: list[tuple[int, int]]) -> bool:
+    r, c = pos
+    return all(max(abs(r - rr), abs(c - cc)) >= OBSTACLE_MIN_SEP for rr, cc in placed)
+
+
+def _choose_thicknesses(rad: tuple[int, int]) -> dict[str, int]:
+    pipe_thick = random.randint(*PIPE_THICK)
+    far_thick = random.randint(*FAR_THICK)
+    if rad == (-1, 0):
+        return {"top": 1, "bottom": far_thick, "left": pipe_thick, "right": pipe_thick}
+    if rad == (1, 0):
+        return {"top": far_thick, "bottom": 1, "left": pipe_thick, "right": pipe_thick}
+    if rad == (0, -1):
+        return {"top": pipe_thick, "bottom": pipe_thick, "left": 1, "right": far_thick}
+    return {"top": pipe_thick, "bottom": pipe_thick, "left": far_thick, "right": 1}
+
+
+def _choose_inner_dims(rad: tuple[int, int], h: int, w: int, t: dict[str, int]) -> tuple[int, int] | None:
+    hs = list(range((INNER_H_VERT if rad[0] else INNER_H_HORIZ)[0], (INNER_H_VERT if rad[0] else INNER_H_HORIZ)[1] + 1))
+    ws = list(range((INNER_W_VERT if rad[0] else INNER_W_HORIZ)[0], (INNER_W_VERT if rad[0] else INNER_W_HORIZ)[1] + 1))
+    random.shuffle(hs)
+    random.shuffle(ws)
+    for inner_h in hs:
+        for inner_w in ws:
+            outer_h = t["top"] + inner_h + t["bottom"]
+            outer_w = t["left"] + inner_w + t["right"]
+            if rad[0]:
+                if outer_h + OPEN_END_MARGIN + FAR_SIDE_MARGIN <= h and outer_w + SIDE_MARGIN * 2 <= w:
+                    return inner_h, inner_w
+            else:
+                if outer_w + OPEN_END_MARGIN + FAR_SIDE_MARGIN <= w and outer_h + SIDE_MARGIN * 2 <= h:
+                    return inner_h, inner_w
+    return None
+
+
+def _place_outer_box(rad: tuple[int, int], h: int, w: int, outer_h: int, outer_w: int) -> tuple[int, int]:
+    if rad == (-1, 0):
+        return random.randint(OPEN_END_MARGIN, h - outer_h - FAR_SIDE_MARGIN), random.randint(SIDE_MARGIN, w - outer_w - SIDE_MARGIN)
+    if rad == (1, 0):
+        return random.randint(FAR_SIDE_MARGIN, h - outer_h - OPEN_END_MARGIN), random.randint(SIDE_MARGIN, w - outer_w - SIDE_MARGIN)
+    if rad == (0, -1):
+        return random.randint(SIDE_MARGIN, h - outer_h - SIDE_MARGIN), random.randint(OPEN_END_MARGIN, w - outer_w - FAR_SIDE_MARGIN)
+    return random.randint(SIDE_MARGIN, h - outer_h - SIDE_MARGIN), random.randint(FAR_SIDE_MARGIN, w - outer_w - OPEN_END_MARGIN)
+
+
+def _render_shell(
+    grid: np.ndarray,
+    r0: int,
+    c0: int,
+    inner_h: int,
+    inner_w: int,
+    t: dict[str, int],
+    wall_color: int,
+) -> tuple[np.ndarray, np.ndarray]:
+    outer_h = t["top"] + inner_h + t["bottom"]
+    outer_w = t["left"] + inner_w + t["right"]
+    grid[r0 : r0 + outer_h, c0 : c0 + outer_w] = wall_color
+
+    ir0 = r0 + t["top"]
+    ic0 = c0 + t["left"]
+    interior = np.zeros_like(grid, dtype=bool)
+    interior[ir0 : ir0 + inner_h, ic0 : ic0 + inner_w] = True
+    grid[interior] = get_bg(grid)
+
+    wall_mask = np.zeros_like(grid, dtype=bool)
+    wall_mask[r0 : r0 + outer_h, c0 : c0 + outer_w] = True
+    wall_mask[interior] = False
+    return wall_mask, interior
+
+
+def _seed_pool(interior: np.ndarray, rad: tuple[int, int]) -> list[tuple[int, int]]:
+    top, left, bottom, right = _bbox_from_mask(interior)
+    pool: list[tuple[int, int]] = []
+    for r, c in zip(*np.where(interior)):
+        rr = int(r)
+        cc = int(c)
+        if rad == (-1, 0) and rr >= bottom - SEED_DEPTH_LOOKBACK:
+            pool.append((rr, cc))
+        elif rad == (1, 0) and rr <= top + SEED_DEPTH_LOOKBACK:
+            pool.append((rr, cc))
+        elif rad == (0, -1) and cc >= right - SEED_DEPTH_LOOKBACK:
+            pool.append((rr, cc))
+        elif rad == (0, 1) and cc <= left + SEED_DEPTH_LOOKBACK:
+            pool.append((rr, cc))
+    return pool
+
+
+def _find_obstacle_candidates(
+    grid: np.ndarray,
+    bg: int,
+    wall_color: int,
+    beam_mask: np.ndarray,
+    pipe_mask: np.ndarray,
+    exterior_bg: np.ndarray,
+) -> tuple[list[tuple[int, int]], list[tuple[int, int]]]:
+    wall_mask = grid == wall_color
+    dist = distance_transform_cdt(~wall_mask, metric="taxicab")
+    eligible = exterior_bg & (grid == bg) & (dist > 1) & (~pipe_mask)
+    all_coords = [(int(r), int(c)) for r, c in zip(*np.where(eligible))]
+    beam_coords = [p for p in all_coords if beam_mask[p[0], p[1]]]
+    random.shuffle(all_coords)
+    random.shuffle(beam_coords)
+    return all_coords, beam_coords
+
+
+def _place_obstacles(
+    n_obstacles: int,
+    candidates: list[tuple[int, int]],
+    beam_candidates: list[tuple[int, int]],
+    obstacle_colors: list[int],
+    grid: np.ndarray,
+) -> None:
+    placed: list[tuple[int, int]] = []
+    n_beam = random.randint(0, min(n_obstacles, len(beam_candidates)))
+    if beam_candidates and random.random() < OBSTACLE_IN_BEAM_PROB:
+        n_beam = max(1, n_beam)
+    for p in beam_candidates:
+        if len(placed) >= n_beam:
+            break
+        if _obstacle_fits(p, placed):
+            placed.append(p)
+    placed_set = set(placed)
+    for p in candidates:
+        if len(placed) >= n_obstacles:
+            break
+        if p not in placed_set and _obstacle_fits(p, placed):
+            placed.append(p)
+            placed_set.add(p)
+    for i, (r, c) in enumerate(placed):
+        grid[r, c] = obstacle_colors[i % len(obstacle_colors)]
+
+
+def _variant_metrics(grid: np.ndarray) -> dict:
+    info = _solution_masks(grid)
+    return {
+        "rad": info["rad"],
+        "trace_cells": int(info["trace"].sum()),
+        "core_gap": int(info["interior_core_bg"].sum()),
+        "beam_cells": int(info["beam"].sum()),
+        "pipe_cells": int(info["pipe"].sum()),
+        "thin_side": int(info["thicknesses"][info["rad"]]),
+        "other_thicknesses": tuple(
+            int(v) for d, v in info["thicknesses"].items() if d != info["rad"]
+        ),
+    }
+
+
+def _gen_attempt() -> np.ndarray | None:
+    rad = random.choice([(-1, 0), (1, 0), (0, -1), (0, 1)])
+    h = random.randint(*GRID_H_VERT) if rad[0] else random.randint(*GRID_H_HORIZ)
+    w = random.randint(*GRID_W)
+
+    t = _choose_thicknesses(rad)
+    dims = _choose_inner_dims(rad, h, w, t)
+    if dims is None:
+        return None
+    inner_h, inner_w = dims
+    outer_h = t["top"] + inner_h + t["bottom"]
+    outer_w = t["left"] + inner_w + t["right"]
+    r0, c0 = _place_outer_box(rad, h, w, outer_h, outer_w)
+
+    palette = random.sample(range(10), random.randint(*PALETTE_SIZE))
+    bg, wall_color, fill_color = palette[:3]
+    obstacle_colors = palette[3:]
+
+    grid = np.full((h, w), bg, dtype=int)
+    wall_mask, interior = _render_shell(grid, r0, c0, inner_h, inner_w, t, wall_color)
+
+    pool = _seed_pool(interior, rad)
+    if not pool:
+        return None
+    interior_cells = {tuple(map(int, p)) for p in zip(*np.where(interior))}
+    blob = _grow_seed_blob(random.choice(pool), interior_cells)
+    for r, c in blob:
+        if grid[r, c] != bg:
+            return None
+        grid[r, c] = fill_color
+
+    try:
+        metrics = _variant_metrics(grid)
+    except Exception:
+        return None
+    if (
+        metrics["trace_cells"] < MIN_TRACE_CELLS
+        or metrics["core_gap"] < MIN_CORE_GAP
+        or metrics["beam_cells"] < MIN_BEAM_CELLS
+        or metrics["pipe_cells"] < MIN_PIPE_CELLS
+        or metrics["thin_side"] != 1
+        or not all(v >= 2 for v in metrics["other_thicknesses"])
+    ):
+        return None
+
+    n_obstacles = random.randint(0, MAX_OBSTACLES)
+    if n_obstacles and not obstacle_colors:
+        available = [c for c in range(10) if c not in (bg, wall_color, fill_color)]
+        obstacle_colors = random.sample(available, random.randint(1, 2))
+    if n_obstacles:
+        info = _solution_masks(grid)
+        exterior_bg = (~info["interior"]) & (~wall_mask) & (grid == bg)
+        candidates, beam_candidates = _find_obstacle_candidates(
+            grid,
+            bg,
+            wall_color,
+            info["beam"],
+            info["pipe"],
+            exterior_bg,
+        )
+        _place_obstacles(n_obstacles, candidates, beam_candidates, obstacle_colors, grid)
+
+    try:
+        metrics = _variant_metrics(grid)
+        out = main(grid)
+    except Exception:
+        return None
+
+    new_fill = (out == fill_color) & (grid == bg)
+    new_wall = (out == wall_color) & (grid == bg)
+    if int(new_fill.sum()) < MIN_NEW_FILL or not _touches_border(new_fill):
+        return None
+    if int(new_wall.sum()) < MIN_PIPE_CELLS:
+        return None
+    if (
+        metrics["trace_cells"] < MIN_TRACE_CELLS
+        or metrics["core_gap"] < MIN_CORE_GAP
+        or metrics["beam_cells"] < MIN_BEAM_CELLS
+        or metrics["pipe_cells"] < MIN_PIPE_CELLS
+    ):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate valid b9e38dc0 combo input")

diff --git a/ceshi/code_combo/b9e38dc0/33/code.py b/ceshi/code_combo/b9e38dc0/33/code.py
new file mode 100644
index 0000000000000000000000000000000000000000..d02a3a669f2cd66c75c74fa59596749ca9c547d1
--- /dev/null
+++ b/ceshi/code_combo/b9e38dc0/33/code.py
@@ -0,0 +1,641 @@
+# Combo variant of b9e38dc0 (index 33)
+# combo_spec: D1/2+D6/3+D8/2
+# Name: 边界追踪+薄壁突破+管道延伸
+
+import random
+
+import numpy as np
+from scipy.ndimage import distance_transform_cdt
+
+from arc_utils import components_mask, get_bg, neighbors4
+
+# ---------------------------------------------------------------------------
+# Design analysis for the combo variant
+#
+# a) Concretization and behavior trace
+#    - Base task: an open U/funnel wall exposes a direction; the solver flood-fills
+#      the pocket, then continues outward through the opening.
+#    - Combo task: the wall is now a sealed axis-aligned shell around one cavity.
+#      Exactly one side is 1 cell thick; the other three sides are thicker.
+#      The seed is still the non-wall color nearest to the wall and sits inside
+#      the cavity near the side opposite the thin wall.
+#    - Output behavior becomes three-stage but geometric evidence is shared:
+#      1. Recover the sealed interior from the seed.
+#      2. Compare the four side thicknesses; the uniquely thinnest side is the
+#         breach direction.
+#      3. Inside the chamber, do not fill the whole interior. Only color the
+#         interior background cells that touch the wall, producing an inner
+#         contour trace.
+#      4. Replace the thin wall strip by fill, extend a straight beam outward,
+#         and simultaneously extend the flanking thick walls as visible pipe
+#         walls around that beam.
+#    - Small trace example:
+#      original: seed in open pocket -> entire pocket fills -> spray exits.
+#      combo: seed in closed rectangle -> measure side widths -> thin top wins ->
+#      only the chamber's inner outline is colored -> top wall strip opens ->
+#      fill travels upward inside a vertical pipe whose left/right wall bands
+#      are wall-color continuations of the shell.
+#
+# b) Complexity calibration
+#    - The wall remains a single structured object rather than an arbitrary blob.
+#    - Only four cardinal breach directions exist, and the cue is repeated across
+#      an entire side, not hidden in one pixel.
+#    - Pipe walls are symmetric around the beam by construction, which keeps the
+#      visual language stable across samples and avoids too many independent
+#      thickness variables.
+#
+# c) Implicit-assumption review against the original solver
+#    - Endpoint detection is invalid because the wall is a loop, so the solver
+#      must infer direction from thickness, not degree-1 tips.
+#    - Global flood-fill of the pocket is no longer correct; we split chamber
+#      behavior into "reachable interior" and "wall-adjacent trace".
+#    - The outgoing boundary is no longer invisible geometry. The generator must
+#      reserve future pipe-wall cells so obstacles do not occupy them.
+#    - Shadow logic must only affect the external beam fill. It must not erase
+#      the interior trace or the wall-color pipe.
+#
+# d) Placement legality guaranteed by the generator
+#    - The shell is an axis-aligned rectangular ring, so there is a unique cavity
+#      and no self-overlap.
+#    - The thin side always has at least OPEN_END_MARGIN cells before the grid
+#      edge, making the breach and pipe extension visible.
+#    - Obstacles are placed only on exterior background cells, away from both the
+#      existing wall and the future pipe walls.
+#
+# e) Visual observability
+#    - A human can compare the four side widths and identify the thinnest side.
+#    - The chamber interior visibly remains hollow in the center, which separates
+#      this combo from a simple chamber flood-fill.
+#    - The outside region shows a pipe: fill in the middle, wall-color rails on
+#      the sides. That makes the D8 contribution directly visible.
+#
+# f) Visual cleanliness
+#    - Obstacles stay outside the shell, so the chamber trace remains readable.
+#    - Only three transformations occur in the active region: fill trace, fill
+#      beam, and wall-color pipe extension. They occupy different masks.
+#
+# g) Inferability of changes
+#    - No color-id ordering is used. Roles are inferred from frequency and
+#      geometry: wall is the dominant non-bg shell, fill is the closest non-wall
+#      color to that shell, obstacles are sparse preserved outliers.
+# ---------------------------------------------------------------------------
+
+# Canvas size bounds
+GRID_H_VERT = (13, 18)
+GRID_H_HORIZ = (10, 18)
+GRID_W = (15, 19)
+
+# Shell geometry
+INNER_H_VERT = (5, 7)
+INNER_W_VERT = (5, 8)
+INNER_H_HORIZ = (5, 8)
+INNER_W_HORIZ = (5, 7)
+
+OPEN_END_MARGIN = 3
+FAR_SIDE_MARGIN = 2
+SIDE_MARGIN = 1
+
+PIPE_THICK = (2, 3)
+FAR_THICK = (2, 3)
+
+# Fill seed
+SEED_SIZE_WEIGHTS = [1, 1, 1, 2, 2, 3, 4]
+SEED_DEPTH_LOOKBACK = 2
+
+# Obstacles
+MAX_OBSTACLES = 5
+OBSTACLE_IN_BEAM_PROB = 0.75
+OBSTACLE_MIN_SEP = 2
+
+# Validation
+MIN_NEW_FILL = 20
+MIN_TRACE_CELLS = 12
+MIN_CORE_GAP = 6
+MIN_BEAM_CELLS = 8
+MIN_PIPE_CELLS = 8
+PALETTE_SIZE = (3, 5)
+GEN_RETRIES = 400
+
+
+def _touches_border(mask: np.ndarray) -> bool:
+    return bool(mask[0, :].any() or mask[-1, :].any() or mask[:, 0].any() or mask[:, -1].any())
+
+
+def _seed_fill(mask: np.ndarray, starts: list[tuple[int, int]]) -> np.ndarray:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    q: list[tuple[int, int]] = []
+    for r, c in starts:
+        if 0 <= r < h and 0 <= c < w and mask[r, c] and not seen[r, c]:
+            seen[r, c] = True
+            q.append((r, c))
+    while q:
+        r, c = q.pop()
+        for rr, cc in neighbors4(r, c):
+            if 0 <= rr < h and 0 <= cc < w and mask[rr, cc] and not seen[rr, cc]:
+                seen[rr, cc] = True
+                q.append((rr, cc))
+    return seen
+
+
+def _min_dist_to_wall(grid: np.ndarray, color: int, wall_points: list[tuple[int, int]]) -> tuple[int, int]:
+    pts = [(int(r), int(c)) for r, c in zip(*np.where(grid == color))]
+    best_d = 10**9
+    for r, c in pts:
+        for wr, wc in wall_points:
+            d = abs(r - wr) + abs(c - wc)
+            if d < best_d:
+                best_d = d
+                if best_d == 0:
+                    return 0, len(pts)
+    return best_d, len(pts)
+
+
+def _bbox_from_mask(mask: np.ndarray) -> tuple[int, int, int, int]:
+    rows, cols = np.where(mask)
+    return int(rows.min()), int(cols.min()), int(rows.max()), int(cols.max())
+
+
+def _side_samples(interior: np.ndarray) -> dict[tuple[int, int], list[tuple[int, int]]]:
+    top, left, bottom, right = _bbox_from_mask(interior)
+    return {
+        (-1, 0): [(top, c) for c in range(left, right + 1) if interior[top, c]],
+        (1, 0): [(bottom, c) for c in range(left, right + 1) if interior[bottom, c]],
+        (0, -1): [(r, left) for r in range(top, bottom + 1) if interior[r, left]],
+        (0, 1): [(r, right) for r in range(top, bottom + 1) if interior[r, right]],
+    }
+
+
+def _count_wall_run(comp_mask: np.ndarray, start: tuple[int, int], d: tuple[int, int]) -> int:
+    h, w = comp_mask.shape
+    rr, cc = start[0] + d[0], start[1] + d[1]
+    count = 0
+    while 0 <= rr < h and 0 <= cc < w and comp_mask[rr, cc]:
+        count += 1
+        rr += d[0]
+        cc += d[1]
+    return count
+
+
+def _measure_side_thicknesses(comp_mask: np.ndarray, interior: np.ndarray) -> dict[tuple[int, int], int]:
+    thicknesses: dict[tuple[int, int], int] = {}
+    for d, pts in _side_samples(interior).items():
+        runs = [_count_wall_run(comp_mask, p, d) for p in pts]
+        assert runs and min(runs) > 0, "expected each interior side to face wall"
+        thicknesses[d] = min(runs)
+    return thicknesses
+
+
+def _choose_radiate_dir(thicknesses: dict[tuple[int, int], int]) -> tuple[int, int]:
+    items = sorted(thicknesses.items(), key=lambda kv: kv[1])
+    assert len(items) == 4, "expected four side thicknesses"
+    assert items[0][1] < items[1][1], "expected a unique thinnest side"
+    return items[0][0]
+
+
+def _build_combo_masks(
+    shape: tuple[int, int],
+    interior: np.ndarray,
+    thicknesses: dict[tuple[int, int], int],
+    rad: tuple[int, int],
+) -> dict:
+    h, w = shape
+    top, left, bottom, right = _bbox_from_mask(interior)
+    outer_top = top - thicknesses[(-1, 0)]
+    outer_bottom = bottom + thicknesses[(1, 0)]
+    outer_left = left - thicknesses[(0, -1)]
+    outer_right = right + thicknesses[(0, 1)]
+
+    assert 0 <= outer_top <= top <= bottom < h
+    assert 0 <= outer_left <= left <= right < w
+    assert 0 <= outer_bottom < h and 0 <= outer_right < w
+
+    breach = np.zeros(shape, dtype=bool)
+    beam = np.zeros(shape, dtype=bool)
+    pipe = np.zeros(shape, dtype=bool)
+
+    if rad == (-1, 0):
+        breach[outer_top, left : right + 1] = True
+        beam[:outer_top, left : right + 1] = True
+        pipe[:outer_top, outer_left:left] = True
+        pipe[:outer_top, right + 1 : outer_right + 1] = True
+    elif rad == (1, 0):
+        breach[outer_bottom, left : right + 1] = True
+        beam[outer_bottom + 1 :, left : right + 1] = True
+        pipe[outer_bottom + 1 :, outer_left:left] = True
+        pipe[outer_bottom + 1 :, right + 1 : outer_right + 1] = True
+    elif rad == (0, -1):
+        breach[top : bottom + 1, outer_left] = True
+        beam[top : bottom + 1, :outer_left] = True
+        pipe[outer_top:top, :outer_left] = True
+        pipe[bottom + 1 : outer_bottom + 1, :outer_left] = True
+    else:
+        breach[top : bottom + 1, outer_right] = True
+        beam[top : bottom + 1, outer_right + 1 :] = True
+        pipe[outer_top:top, outer_right + 1 :] = True
+        pipe[bottom + 1 : outer_bottom + 1, outer_right + 1 :] = True
+
+    return {
+        "interior_bbox": (top, left, bottom, right),
+        "outer_bbox": (outer_top, outer_left, outer_bottom, outer_right),
+        "breach": breach,
+        "beam": beam,
+        "pipe": pipe,
+    }
+
+
+def _analyze_scene(grid: np.ndarray) -> dict:
+    g = np.array(grid, copy=False)
+    h, w = g.shape
+    bg = int(get_bg(g))
+    vals = [int(v) for v in np.unique(g) if int(v) != bg]
+    assert vals, "expected at least one non-background color"
+
+    wall = max(vals, key=lambda c: int((g == c).sum()))
+    wall_mask = g == wall
+    comps = [set((int(r), int(c)) for r, c in pts) for pts in components_mask(wall_mask, connectivity=8)]
+    assert comps, "expected wall connected component"
+
+    other_colors = [c for c in vals if c != wall]
+    assert other_colors, "expected a non-wall fill color"
+
+    wall_points = [p for comp in comps for p in comp]
+    fill = min(other_colors, key=lambda c: _min_dist_to_wall(g, c, wall_points))
+    fill_pos = [(int(r), int(c)) for r, c in zip(*np.where(g == fill))]
+    assert fill_pos, "expected at least one fill seed cell"
+
+    def comp_min_dist(comp: set[tuple[int, int]]) -> int:
+        best = 10**9
+        for r, c in fill_pos:
+            for wr, wc in comp:
+                d = abs(r - wr) + abs(c - wc)
+                if d < best:
+                    best = d
+                    if best == 0:
+                        return 0
+        return best
+
+    wall_comp = min(comps, key=lambda comp: (comp_min_dist(comp), -len(comp)))
+    comp_mask = np.zeros_like(wall_mask, dtype=bool)
+    for r, c in wall_comp:
+        comp_mask[r, c] = True
+
+    interior_passable = (~comp_mask) & ((g == bg) | (g == fill))
+    interior = _seed_fill(interior_passable, fill_pos)
+    assert interior.any(), "expected enclosed interior"
+    assert not _touches_border(interior), "interior leaked to border"
+
+    thicknesses = _measure_side_thicknesses(comp_mask, interior)
+    rad = _choose_radiate_dir(thicknesses)
+    masks = _build_combo_masks((h, w), interior, thicknesses, rad)
+
+    return {
+        "grid": g,
+        "shape": (h, w),
+        "bg": bg,
+        "wall": int(wall),
+        "fill": int(fill),
+        "fill_pos": fill_pos,
+        "comp_mask": comp_mask,
+        "interior": interior,
+        "thicknesses": thicknesses,
+        "rad": rad,
+        **masks,
+    }
+
+
+def _solution_masks(grid: np.ndarray) -> dict:
+    info = _analyze_scene(grid)
+    g = info["grid"]
+    h, w = info["shape"]
+
+    trace = np.zeros((h, w), dtype=bool)
+    for r, c in zip(*np.where(info["interior"] & (g == info["bg"]))):
+        rr = int(r)
+        cc = int(c)
+        if any(
+            0 <= nr < h and 0 <= nc < w and info["comp_mask"][nr, nc]
+            for nr, nc in neighbors4(rr, cc)
+        ):
+            trace[rr, cc] = True
+
+    info["trace"] = trace
+    info["interior_bg"] = info["interior"] & (g == info["bg"])
+    info["interior_core_bg"] = info["interior_bg"] & (~trace)
+    return info
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Trace the inside rim of a sealed chamber, break its thinnest wall, and extend a pipe around the outgoing beam.
+
+    Input structure:
+    - The dominant color is background. The most common non-background color forms one closed rectangular shell around a cavity.
+    - A smaller non-wall color seed lies inside that cavity near the side opposite the eventual exit. Exactly one wall side is 1 cell thick; the other three sides are thicker. Any remaining non-background pixels are sparse obstacles outside the shell.
+
+    Rule:
+    - Recover the enclosed chamber from the seed, compare the four wall-side thicknesses, and choose the uniquely thinnest side as the breach direction.
+    - Inside the chamber, color only the reachable background cells that touch the wall, leaving the interior core hollow. Replace the thin wall strip with fill, extend a straight fill beam outward from that breach, and recolor the flanking extension bands as wall so the beam sits inside a pipe. Obstacles stay fixed and cast background shadows only through the external beam.
+
+    Key insight:
+    - The same recovered cavity supports all three inferences: it reveals which wall is thinnest, which interior cells form the traceable inner contour, and which outer bands are the pipe walls that must extend in the breach direction.
+    """
+    info = _solution_masks(grid)
+    g = np.array(info["grid"], copy=True)
+    bg = info["bg"]
+    wall = info["wall"]
+    fill = info["fill"]
+
+    trace = info["trace"].copy()
+    breach = info["breach"].copy()
+    beam = info["beam"].copy()
+    pipe = info["pipe"].copy()
+
+    out = g.copy()
+    out[trace | breach | beam] = fill
+
+    obstacles = (g != bg) & (g != fill) & (g != wall)
+    rad = info["rad"]
+    beam_after_shadow = beam.copy()
+    shadow_track = breach | beam
+
+    def shadow_process(coords: list[tuple[int, int]]) -> None:
+        started = False
+        blocked = False
+        for r, c in coords:
+            if shadow_track[r, c]:
+                started = True
+            if started and obstacles[r, c]:
+                blocked = True
+                continue
+            if blocked and beam_after_shadow[r, c]:
+                out[r, c] = bg
+                beam_after_shadow[r, c] = False
+
+    dr, dc = rad
+    if dr != 0:
+        for c in range(g.shape[1]):
+            rows = range(g.shape[0]) if dr > 0 else range(g.shape[0] - 1, -1, -1)
+            shadow_process([(r, c) for r in rows])
+    else:
+        for r in range(g.shape[0]):
+            cols = range(g.shape[1]) if dc > 0 else range(g.shape[1] - 1, -1, -1)
+            shadow_process([(r, c) for c in cols])
+
+    out[pipe & (g == bg)] = wall
+    return out
+
+
+def _grow_seed_blob(seed: tuple[int, int], interior_cells: set[tuple[int, int]]) -> set[tuple[int, int]]:
+    blob = {seed}
+    frontier = [seed]
+    target_size = random.choice(SEED_SIZE_WEIGHTS)
+    while len(blob) < target_size and frontier:
+        r, c = frontier.pop(random.randrange(len(frontier)))
+        nbrs = [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+        for q in random.sample(nbrs, len(nbrs)):
+            if q in interior_cells and q not in blob:
+                blob.add(q)
+                frontier.append(q)
+                if len(blob) >= target_size:
+                    break
+    return blob
+
+
+def _obstacle_fits(pos: tuple[int, int], placed: list[tuple[int, int]]) -> bool:
+    r, c = pos
+    return all(max(abs(r - rr), abs(c - cc)) >= OBSTACLE_MIN_SEP for rr, cc in placed)
+
+
+def _choose_thicknesses(rad: tuple[int, int]) -> dict[str, int]:
+    pipe_thick = random.randint(*PIPE_THICK)
+    far_thick = random.randint(*FAR_THICK)
+    if rad == (-1, 0):
+        return {"top": 1, "bottom": far_thick, "left": pipe_thick, "right": pipe_thick}
+    if rad == (1, 0):
+        return {"top": far_thick, "bottom": 1, "left": pipe_thick, "right": pipe_thick}
+    if rad == (0, -1):
+        return {"top": pipe_thick, "bottom": pipe_thick, "left": 1, "right": far_thick}
+    return {"top": pipe_thick, "bottom": pipe_thick, "left": far_thick, "right": 1}
+
+
+def _choose_inner_dims(rad: tuple[int, int], h: int, w: int, t: dict[str, int]) -> tuple[int, int] | None:
+    hs = list(range((INNER_H_VERT if rad[0] else INNER_H_HORIZ)[0], (INNER_H_VERT if rad[0] else INNER_H_HORIZ)[1] + 1))
+    ws = list(range((INNER_W_VERT if rad[0] else INNER_W_HORIZ)[0], (INNER_W_VERT if rad[0] else INNER_W_HORIZ)[1] + 1))
+    random.shuffle(hs)
+    random.shuffle(ws)
+    for inner_h in hs:
+        for inner_w in ws:
+            outer_h = t["top"] + inner_h + t["bottom"]
+            outer_w = t["left"] + inner_w + t["right"]
+            if rad[0]:
+                if outer_h + OPEN_END_MARGIN + FAR_SIDE_MARGIN <= h and outer_w + SIDE_MARGIN * 2 <= w:
+                    return inner_h, inner_w
+            else:
+                if outer_w + OPEN_END_MARGIN + FAR_SIDE_MARGIN <= w and outer_h + SIDE_MARGIN * 2 <= h:
+                    return inner_h, inner_w
+    return None
+
+
+def _place_outer_box(rad: tuple[int, int], h: int, w: int, outer_h: int, outer_w: int) -> tuple[int, int]:
+    if rad == (-1, 0):
+        return random.randint(OPEN_END_MARGIN, h - outer_h - FAR_SIDE_MARGIN), random.randint(SIDE_MARGIN, w - outer_w - SIDE_MARGIN)
+    if rad == (1, 0):
+        return random.randint(FAR_SIDE_MARGIN, h - outer_h - OPEN_END_MARGIN), random.randint(SIDE_MARGIN, w - outer_w - SIDE_MARGIN)
+    if rad == (0, -1):
+        return random.randint(SIDE_MARGIN, h - outer_h - SIDE_MARGIN), random.randint(OPEN_END_MARGIN, w - outer_w - FAR_SIDE_MARGIN)
+    return random.randint(SIDE_MARGIN, h - outer_h - SIDE_MARGIN), random.randint(FAR_SIDE_MARGIN, w - outer_w - OPEN_END_MARGIN)
+
+
+def _render_shell(
+    grid: np.ndarray,
+    r0: int,
+    c0: int,
+    inner_h: int,
+    inner_w: int,
+    t: dict[str, int],
+    wall_color: int,
+) -> tuple[np.ndarray, np.ndarray]:
+    outer_h = t["top"] + inner_h + t["bottom"]
+    outer_w = t["left"] + inner_w + t["right"]
+    grid[r0 : r0 + outer_h, c0 : c0 + outer_w] = wall_color
+
+    ir0 = r0 + t["top"]
+    ic0 = c0 + t["left"]
+    interior = np.zeros_like(grid, dtype=bool)
+    interior[ir0 : ir0 + inner_h, ic0 : ic0 + inner_w] = True
+    grid[interior] = get_bg(grid)
+
+    wall_mask = np.zeros_like(grid, dtype=bool)
+    wall_mask[r0 : r0 + outer_h, c0 : c0 + outer_w] = True
+    wall_mask[interior] = False
+    return wall_mask, interior
+
+
+def _seed_pool(interior: np.ndarray, rad: tuple[int, int]) -> list[tuple[int, int]]:
+    top, left, bottom, right = _bbox_from_mask(interior)
+    pool: list[tuple[int, int]] = []
+    for r, c in zip(*np.where(interior)):
+        rr = int(r)
+        cc = int(c)
+        if rad == (-1, 0) and rr >= bottom - SEED_DEPTH_LOOKBACK:
+            pool.append((rr, cc))
+        elif rad == (1, 0) and rr <= top + SEED_DEPTH_LOOKBACK:
+            pool.append((rr, cc))
+        elif rad == (0, -1) and cc >= right - SEED_DEPTH_LOOKBACK:
+            pool.append((rr, cc))
+        elif rad == (0, 1) and cc <= left + SEED_DEPTH_LOOKBACK:
+            pool.append((rr, cc))
+    return pool
+
+
+def _find_obstacle_candidates(
+    grid: np.ndarray,
+    bg: int,
+    wall_color: int,
+    beam_mask: np.ndarray,
+    pipe_mask: np.ndarray,
+    exterior_bg: np.ndarray,
+) -> tuple[list[tuple[int, int]], list[tuple[int, int]]]:
+    wall_mask = grid == wall_color
+    dist = distance_transform_cdt(~wall_mask, metric="taxicab")
+    eligible = exterior_bg & (grid == bg) & (dist > 1) & (~pipe_mask)
+    all_coords = [(int(r), int(c)) for r, c in zip(*np.where(eligible))]
+    beam_coords = [p for p in all_coords if beam_mask[p[0], p[1]]]
+    random.shuffle(all_coords)
+    random.shuffle(beam_coords)
+    return all_coords, beam_coords
+
+
+def _place_obstacles(
+    n_obstacles: int,
+    candidates: list[tuple[int, int]],
+    beam_candidates: list[tuple[int, int]],
+    obstacle_colors: list[int],
+    grid: np.ndarray,
+) -> None:
+    placed: list[tuple[int, int]] = []
+    n_beam = random.randint(0, min(n_obstacles, len(beam_candidates)))
+    if beam_candidates and random.random() < OBSTACLE_IN_BEAM_PROB:
+        n_beam = max(1, n_beam)
+    for p in beam_candidates:
+        if len(placed) >= n_beam:
+            break
+        if _obstacle_fits(p, placed):
+            placed.append(p)
+    placed_set = set(placed)
+    for p in candidates:
+        if len(placed) >= n_obstacles:
+            break
+        if p not in placed_set and _obstacle_fits(p, placed):
+            placed.append(p)
+            placed_set.add(p)
+    for i, (r, c) in enumerate(placed):
+        grid[r, c] = obstacle_colors[i % len(obstacle_colors)]
+
+
+def _variant_metrics(grid: np.ndarray) -> dict:
+    info = _solution_masks(grid)
+    return {
+        "rad": info["rad"],
+        "trace_cells": int(info["trace"].sum()),
+        "core_gap": int(info["interior_core_bg"].sum()),
+        "beam_cells": int(info["beam"].sum()),
+        "pipe_cells": int(info["pipe"].sum()),
+        "thin_side": int(info["thicknesses"][info["rad"]]),
+        "other_thicknesses": tuple(
+            int(v) for d, v in info["thicknesses"].items() if d != info["rad"]
+        ),
+    }
+
+
+def _gen_attempt() -> np.ndarray | None:
+    rad = random.choice([(-1, 0), (1, 0), (0, -1), (0, 1)])
+    h = random.randint(*GRID_H_VERT) if rad[0] else random.randint(*GRID_H_HORIZ)
+    w = random.randint(*GRID_W)
+
+    t = _choose_thicknesses(rad)
+    dims = _choose_inner_dims(rad, h, w, t)
+    if dims is None:
+        return None
+    inner_h, inner_w = dims
+    outer_h = t["top"] + inner_h + t["bottom"]
+    outer_w = t["left"] + inner_w + t["right"]
+    r0, c0 = _place_outer_box(rad, h, w, outer_h, outer_w)
+
+    palette = random.sample(range(10), random.randint(*PALETTE_SIZE))
+    bg, wall_color, fill_color = palette[:3]
+    obstacle_colors = palette[3:]
+
+    grid = np.full((h, w), bg, dtype=int)
+    wall_mask, interior = _render_shell(grid, r0, c0, inner_h, inner_w, t, wall_color)
+
+    pool = _seed_pool(interior, rad)
+    if not pool:
+        return None
+    interior_cells = {tuple(map(int, p)) for p in zip(*np.where(interior))}
+    blob = _grow_seed_blob(random.choice(pool), interior_cells)
+    for r, c in blob:
+        if grid[r, c] != bg:
+            return None
+        grid[r, c] = fill_color
+
+    try:
+        metrics = _variant_metrics(grid)
+    except Exception:
+        return None
+    if (
+        metrics["trace_cells"] < MIN_TRACE_CELLS
+        or metrics["core_gap"] < MIN_CORE_GAP
+        or metrics["beam_cells"] < MIN_BEAM_CELLS
+        or metrics["pipe_cells"] < MIN_PIPE_CELLS
+        or metrics["thin_side"] != 1
+        or not all(v >= 2 for v in metrics["other_thicknesses"])
+    ):
+        return None
+
+    n_obstacles = random.randint(0, MAX_OBSTACLES)
+    if n_obstacles and not obstacle_colors:
+        available = [c for c in range(10) if c not in (bg, wall_color, fill_color)]
+        obstacle_colors = random.sample(available, random.randint(1, 2))
+    if n_obstacles:
+        info = _solution_masks(grid)
+        exterior_bg = (~info["interior"]) & (~wall_mask) & (grid == bg)
+        candidates, beam_candidates = _find_obstacle_candidates(
+            grid,
+            bg,
+            wall_color,
+            info["beam"],
+            info["pipe"],
+            exterior_bg,
+        )
+        _place_obstacles(n_obstacles, candidates, beam_candidates, obstacle_colors, grid)
+
+    try:
+        metrics = _variant_metrics(grid)
+        out = main(grid)
+    except Exception:
+        return None
+
+    new_fill = (out == fill_color) & (grid == bg)
+    new_wall = (out == wall_color) & (grid == bg)
+    if int(new_fill.sum()) < MIN_NEW_FILL or not _touches_border(new_fill):
+        return None
+    if int(new_wall.sum()) < MIN_PIPE_CELLS:
+        return None
+    if (
+        metrics["trace_cells"] < MIN_TRACE_CELLS
+        or metrics["core_gap"] < MIN_CORE_GAP
+        or metrics["beam_cells"] < MIN_BEAM_CELLS
+        or metrics["pipe_cells"] < MIN_PIPE_CELLS
+    ):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate valid b9e38dc0 combo input")

