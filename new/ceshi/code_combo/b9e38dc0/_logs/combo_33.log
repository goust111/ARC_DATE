            ```python
            # Variant of b9e38dc0
# Dimension: D8 — 变换——填充后精灵的变化 (transform)
# Change: flood_fill变换——半包围区域内部被源像素颜色填满，源像素扩展为整个区域的填充色... → 精灵边框扩展包围辐射射线

# Design analysis for this D8 variant
# -----------------------------------
# spec_variant:
#   preserved_core:
#     - The input still contains one open wall sprite, one fill seed blob inside it, and optional singleton obstacles.
#     - The wall endpoints still determine the opening direction and the two outward boundary rays.
#     - Flood-fill and obstacle shadows keep the original semantics.
#   changed_transform:
#     - In the base task, the endpoint rays are invisible geometry used only as barriers that confine the fill.
#     - In this variant, those same rays become visible wall-color extensions in the output.
#     - Visually, the open funnel is "completed" into a pipe: original wall at the back, two extended wall sides in front,
#       fill color inside the pipe, and background shadows behind blockers.
#   concrete_trace:
#     - Example: a U-like wall opens upward. Originally the solver filled the cavity and then colored the triangular/upward
#       corridor between two invisible rays. Here the solver first computes exactly that same corridor, then paints the two
#       ray cell chains as wall color. The fill remains in the interior cells only, so the output shows a bordered tube.
#     - Difference from the base task at the critical step:
#       original: barrier = wall + invisible rays; output paints only fill cells.
#       variant:  barrier = wall + invisible rays for reachability, then output additionally paints the ray cells as wall.
#   complexity_calibration:
#     - The change is deliberately narrow: only one new visible structure is introduced, and it is repeated twice per sample
#       (one extension from each endpoint), which gives enough support for human inference.
#     - The generator rejects cases with very short extensions so the D8 effect is visible in a few examples.
#     - The allowed ray modes remain the original two discrete families (1:1 and 1:2), preventing excessive branching.
#   implicit_assumption_review:
#     - The fill color must remain the non-wall color nearest to the wall. The generator therefore keeps obstacles at
#       taxicab distance > 1 from the wall so they cannot steal fill-color detection.
#     - Endpoint detection assumes the chosen wall component has degree-1 tips. The generator continues to enforce exactly 2.
#     - Painting the new wall extensions would be wrong if obstacles could land on future ray cells; the generator forbids
#       obstacle placement on the computed ray mask.
#     - Shadow logic assumes the radiate direction is still derived from the endpoint outward vectors. That assumption is
#       preserved unchanged, so the original scanline shadow code remains valid.
#   placement_legality:
#     - The original anchor logic already guarantees space from the opening to the radiate edge.
#     - Additional validation now requires both ray extensions to have visible length, which ensures no out-of-bounds or
#       zero-length pipe walls.
#   visual_observability:
#     - The variant does not rely on color-id ordering or hidden metadata. The new rule is directly visible because wall
#       color appears on previously blank boundary rays in the output, while the fill stays enclosed between them.
#     - Obstacles still matter because they carve holes in the beam interior without removing the surrounding pipe walls.
#   cleanliness:
#     - Obstacles remain sparse singleton pixels and are kept off the pipe walls, preventing ambiguous overlaps.
#     - The wall color is reused for the extension, so the added structure reads as a continuation of the same sprite rather
#       than as a new object class.

import random

import numpy as np
from scipy.ndimage import distance_transform_cdt

from arc_utils import components_mask, get_bg, neighbors4, neighbors8


def _sgn(x: int) -> int:
    return (x > 0) - (x < 0)


def _analyze_scene(grid: np.ndarray) -> dict:
    g = np.array(grid, copy=True)
    h, w = g.shape

    vals = np.unique(g)
    bg = get_bg(g)
    non_bg = [int(v) for v in vals if int(v) != bg]
    assert non_bg, "expected at least one non-background color"

    wall = max(non_bg, key=lambda c: int((g == c).sum()))
    wall_mask = g == wall
    comps = [set((int(r), int(c)) for r, c in pts) for pts in components_mask(wall_mask, connectivity=8)]
    assert comps, "expected at least one wall connected component"

    other_colors = [c for c in non_bg if c != wall]
    assert other_colors, "expected at least one non-wall color"

    wall_points = [p for comp in comps for p in comp]

    def min_dist_to_wall(color: int) -> tuple[int, int]:
        pts = [(int(r), int(c)) for r, c in zip(*np.where(g == color))]
        best_d = 10**9
        for r, c in pts:
            for wr, wc in wall_points:
                d = abs(r - wr) + abs(c - wc)
                if d < best_d:
                    best_d = d
                    if best_d == 0:
                        return 0, len(pts)
        return best_d, len(pts)

    fill = min(other_colors, key=lambda c: (min_dist_to_wall(c)[0], min_dist_to_wall(c)[1]))
    fill_pos = [(int(r), int(c)) for r, c in zip(*np.where(g == fill))]

    def comp_min_dist(comp: set[tuple[int, int]]) -> int:
        best_d = 10**9
        for r, c in fill_pos:
            for wr, wc in comp:
                d = abs(r - wr) + abs(c - wc)
                if d < best_d:
                    best_d = d
                    if best_d == 0:
                        return 0
        return best_d

    wall_comp = min(comps, key=lambda comp: (comp_min_dist(comp), -len(comp)))
    comp_mask = np.zeros_like(wall_mask, dtype=bool)
    for r, c in wall_comp:
        comp_mask[r, c] = True

    def comp_neighbors(r: int, c: int) -> list[tuple[int, int]]:
        out = []
        for rr, cc in neighbors8(r, c):
            if 0 <= rr < h and 0 <= cc < w and comp_mask[rr, cc]:
                out.append((rr, cc))
        return out

    endpoints = [(r, c) for r, c in wall_comp if len(comp_neighbors(r, c)) == 1]
    assert endpoints, "expected wall component to have degree-1 endpoints"

    def outward_dir(ep: tuple[int, int]) -> tuple[tuple[int, int], bool]:
        n1 = comp_neighbors(*ep)[0]
        d1 = (_sgn(n1[0] - ep[0]), _sgn(n1[1] - ep[1]))
        d_use = d1
        is_12 = False
        n2s = [p for p in comp_neighbors(*n1) if p != ep]
        if n2s:
            n2 = n2s[0]
            d2 = (_sgn(n2[0] - n1[0]), _sgn(n2[1] - n1[1]))
            if (d1[0] == 0) ^ (d1[1] == 0) and d2[0] != 0 and d2[1] != 0:
                d_use = d2
                is_12 = True
        return (-d_use[0], -d_use[1]), is_12

    out_info = [outward_dir(ep) for ep in endpoints]
    out_dirs = [d for d, _ in out_info]
    tip_12 = [flag for _d, flag in out_info]
    rad = (_sgn(sum(d[0] for d in out_dirs)), _sgn(sum(d[1] for d in out_dirs)))

    ray_mask = np.zeros_like(comp_mask, dtype=bool)
    ray_paths: list[list[tuple[int, int]]] = []

    def trace_ray(start: tuple[int, int], d: tuple[int, int], is_12: bool) -> list[tuple[int, int]]:
        rr, cc = start
        step = 0
        cells = []
        while True:
            step += 1
            if is_12:
                if step % 2 == 1:
                    rr += d[0]
                    cc += d[1]
                else:
                    if rad[0] != 0:
                        rr += d[0]
                    else:
                        cc += d[1]
            else:
                rr += d[0]
                cc += d[1]
            if not (0 <= rr < h and 0 <= cc < w):
                break
            cells.append((rr, cc))
        return cells

    for ep, d, is_12 in zip(endpoints, out_dirs, tip_12):
        path = trace_ray(ep, d, is_12)
        ray_paths.append(path)
        for rr, cc in path:
            ray_mask[rr, cc] = True

    barrier = comp_mask | ray_mask
    return {
        "grid": g,
        "h": h,
        "w": w,
        "bg": int(bg),
        "wall": int(wall),
        "fill": int(fill),
        "fill_pos": fill_pos,
        "wall_comp": wall_comp,
        "comp_mask": comp_mask,
        "endpoints": endpoints,
        "out_dirs": out_dirs,
        "tip_12": tip_12,
        "rad": rad,
        "ray_mask": ray_mask,
        "ray_paths": ray_paths,
        "barrier": barrier,
    }


def _variant_metrics(grid: np.ndarray) -> dict:
    info = _analyze_scene(grid)
    return {
        "rad": info["rad"],
        "tip_12": tuple(bool(x) for x in info["tip_12"]),
        "ray_lengths": tuple(len(path) for path in info["ray_paths"]),
        "ray_cells": int(info["ray_mask"].sum()),
    }


def main(grid: np.ndarray) -> np.ndarray:
    """
    Fill the half-enclosed region, then extend the wall itself into a pipe around the outgoing beam.

    Input structure:
    - The background is the dominant color, and the most common non-background color forms a single open wall sprite with two tips.
    - A smaller non-wall color blob sits inside the cavity near the closed end; any remaining non-background colors are sparse obstacles.

    Rule:
    - Flood-fill from the seed through the cavity and outward through the opening, using the endpoint-derived rays as the corridor boundaries.
    - Apply the original obstacle-shadow rule to remove fill behind blockers, then recolor the two boundary rays as wall-color extensions so the beam is enclosed inside a visible tube.

    Key insight:
    - The endpoint geometry is reused twice: first to bound reachability, then to tell you exactly which new cells become the extended wall border.
    """
    info = _analyze_scene(grid)
    g = info["grid"]
    h, w = info["h"], info["w"]
    bg, wall, fill = info["bg"], info["wall"], info["fill"]
    fill_pos = info["fill_pos"]
    if not fill_pos:
        return g

    passable = (~info["barrier"]) & ((g == bg) | (g == fill))
    q = fill_pos[:]
    seen = np.zeros_like(passable, dtype=bool)
    for r, c in q:
        if passable[r, c]:
            seen[r, c] = True

    while q:
        r, c = q.pop()
        for rr, cc in neighbors4(r, c):
            if 0 <= rr < h and 0 <= cc < w and passable[rr, cc] and not seen[rr, cc]:
                seen[rr, cc] = True
                q.append((rr, cc))

    filled_mask = seen & (g == bg)
    out = g.copy()
    out[filled_mask] = fill

    obstacles = (g != bg) & (g != fill) & (g != wall)

    def shadow_process(coords: list[tuple[int, int]]) -> None:
        started = False
        blocked = False
        for r, c in coords:
            if filled_mask[r, c]:
                started = True
            if started and obstacles[r, c]:
                blocked = True
                continue
            if blocked and filled_mask[r, c]:
                out[r, c] = bg
                filled_mask[r, c] = False

    rad = info["rad"]
    if rad != (0, 0):
        dr, dc = rad
        if dr != 0 and dc == 0:
            for c in range(w):
                rows = range(h) if dr > 0 else range(h - 1, -1, -1)
                shadow_process([(r, c) for r in rows])
        elif dc != 0 and dr == 0:
            for r in range(h):
                cols = range(w) if dc > 0 else range(w - 1, -1, -1)
                shadow_process([(r, c) for c in cols])
        else:
            if dr == dc:
                for k in range(-(w - 1), h):
                    coords = [(r, r - k) for r in range(h) if 0 <= r - k < w]
                    coords.sort(key=lambda rc: rc[0], reverse=(dr < 0))
                    shadow_process(coords)
            else:
                for k in range(h + w - 1):
                    coords = [(r, k - r) for r in range(h) if 0 <= k - r < w]
                    coords.sort(key=lambda rc: rc[0], reverse=(dr < 0))
                    shadow_process(coords)

    out[info["ray_mask"]] = wall
    return out


# --------------- generator ---------------

# Canvas size bounds
GRID_H_VERT = (11, 18)
GRID_H_HORIZ = (8, 18)
GRID_W = (15, 19)

# Wall geometry
WALL_PIXELS_MIN = 17
WALL_PIXELS_MAX = 25
DEPTH_VERT = (5, 10)
DEPTH_HORIZ = (6, 8)
GAP_VERT = (6, 7)
GAP_HORIZ = (5, 7)
TIP_12_PROB = 0.5

# Placement margins
OPEN_END_MARGIN = 3

# Fill seed
SEED_SIZE_WEIGHTS = [1, 1, 1, 1, 2, 2, 3, 4, 5, 6]
SEED_DEPTH_LOOKBACK = 3

# Obstacles
MAX_OBSTACLES = 5
OBSTACLE_IN_FILL_PROB = 0.65
OBSTACLE_MIN_SEP = 2

# Validation
MIN_NEW_FILL = 20
MIN_RAY_CELLS = 8
MIN_RAY_LEN = 3
PALETTE_SIZE = (3, 5)
GEN_RETRIES = 400


def _degree1_pixels(points):
    pts = set(points)
    return [(r, c) for r, c in pts if sum((rr, cc) in pts for rr, cc in neighbors8(r, c)) == 1]


def _make_arm(depth, start_v, target_v, extra_steps, tip_12=False):
    sign = 1 if target_v > start_v else -1
    n_side_steps = abs(target_v - start_v)
    chosen_rows = []
    if n_side_steps:
        if tip_12:
            chosen_rows = [2 * (i + 1) for i in range(n_side_steps)]
            extra_steps = 0
        else:
            chosen_rows = [1]
            if n_side_steps > 1:
                chosen_rows += random.sample(range(2, depth + 1), n_side_steps - 1)
            chosen_rows.sort()

    first_row = chosen_rows[0] if chosen_rows else 1
    extra_rows = [r for r in chosen_rows if r != first_row]
    random.shuffle(extra_rows)
    orthogonal_rows = set(extra_rows[:extra_steps])

    pts = [(0, start_v)]
    u, v = 0, start_v
    for row in range(1, depth + 1):
        u += 1
        if row in orthogonal_rows:
            pts.append((u, v))
            v += sign
        elif row in chosen_rows:
            v += sign
        pts.append((u, v))
    return pts


def _build_local_wall(rad, h, w):
    if rad[0]:
        max_depth = min(DEPTH_VERT[1], h - 6)
        if max_depth < DEPTH_VERT[0]:
            return None
        depth = random.randint(DEPTH_VERT[0], max_depth)
        gap = random.randint(*GAP_VERT)
    else:
        depth = random.randint(DEPTH_HORIZ[0], min(DEPTH_HORIZ[1], w - 6))
        gap = random.randint(GAP_HORIZ[0], min(GAP_HORIZ[1], h - 1))

    if gap == 5:
        left_bottom, right_bottom = 2, 3
    elif gap == 6:
        left_bottom, right_bottom = 2, 4
    else:
        left_bottom, right_bottom = random.choice([(2, 5), (3, 4)])

    bridge_extra = max(0, right_bottom - left_bottom - 1)
    base_count = 2 * (depth + 1) + bridge_extra
    max_extra_l = max(0, left_bottom - 1)
    max_extra_r = max(0, gap - right_bottom - 1)
    min_extra = max(0, WALL_PIXELS_MIN - base_count)
    max_extra = min(max_extra_l + max_extra_r, WALL_PIXELS_MAX - base_count)
    if min_extra > max_extra:
        return None

    extra = random.randint(min_extra, max_extra)
    extra_l = random.randint(max(0, extra - max_extra_r), min(max_extra_l, extra))
    extra_r = extra - extra_l

    max_n_side = max(left_bottom, gap - right_bottom)
    tip_12 = depth >= 2 * max_n_side and random.random() < TIP_12_PROB
    left = _make_arm(depth, 0, left_bottom, extra_l, tip_12=tip_12)
    right = _make_arm(depth, gap, right_bottom, extra_r, tip_12=tip_12)
    pts = set(left) | set(right)
    for v in range(left_bottom, right_bottom + 1):
        pts.add((depth, v))

    while len(pts) < WALL_PIXELS_MIN:
        candidates = [
            (u, v)
            for u in range(max(0, depth - 3), depth + 1)
            for v in range(gap + 1)
            if (u, v) not in pts
            and sum(
                (uu, vv) in pts
                for uu in range(u - 1, u + 2)
                for vv in range(v - 1, v + 2)
                if (uu, vv) != (u, v)
            )
            >= 2
        ]
        random.shuffle(candidates)
        added = False
        for p in candidates:
            trial = pts | {p}
            if len(trial) <= WALL_PIXELS_MAX and len(_degree1_pixels(trial)) == 2:
                pts = trial
                added = True
                break
        if not added:
            return None

    if not (WALL_PIXELS_MIN <= len(pts) <= WALL_PIXELS_MAX) or len(_degree1_pixels(pts)) != 2:
        return None
    return pts, depth, gap


def _map_local(u, v, rad, anchor):
    r0, c0 = anchor
    if rad == (-1, 0):
        return r0 + u, c0 + v
    if rad == (1, 0):
        return r0 - u, c0 + v
    if rad == (0, -1):
        return r0 + v, c0 + u
    return r0 + v, c0 - u


def _place_anchor(rad, h, w, depth, gap):
    if rad == (-1, 0):
        return random.randint(OPEN_END_MARGIN, h - depth - 3), random.randint(0, w - gap - 1)
    if rad == (1, 0):
        return random.randint(depth + 2, h - 4), random.randint(0, w - gap - 1)
    if rad == (0, -1):
        return random.randint(0, h - gap - 1), random.randint(OPEN_END_MARGIN, w - depth - 3)
    return random.randint(0, h - gap - 1), random.randint(depth + 2, w - 4)


def _local_interior(wall, depth, gap):
    by_row = {}
    for u, v in wall:
        by_row.setdefault(u, []).append(v)
    interior = []
    for u in range(1, depth):
        if u not in by_row or len(by_row[u]) < 2:
            continue
        lo, hi = min(by_row[u]), max(by_row[u])
        for v in range(lo + 1, hi):
            if (u, v) not in wall:
                interior.append((u, v))
    return interior


def _grow_seed_blob(seed, interior_set):
    blob = {seed}
    target_size = random.choice(SEED_SIZE_WEIGHTS)
    frontier = [seed]
    while len(blob) < target_size and frontier:
        u, v = frontier.pop(random.randrange(len(frontier)))
        for q in random.sample([(u - 1, v), (u + 1, v), (u, v - 1), (u, v + 1)], 4):
            if q in interior_set and q not in blob:
                blob.add(q)
                frontier.append(q)
                if len(blob) >= target_size:
                    break
    return blob


def _obstacle_fits(pos, placed):
    r, c = pos
    return all(max(abs(r - rr), abs(c - cc)) >= OBSTACLE_MIN_SEP for rr, cc in placed)


def _find_obstacle_candidates(grid, bg, wall_color, nominal_fill_zone, forbidden_mask):
    wall_mask = grid == wall_color
    dist = distance_transform_cdt(~wall_mask, metric="taxicab")
    far_from_wall = dist > 1
    eligible = (grid == bg) & far_from_wall & (~forbidden_mask)
    all_coords = [(int(r), int(c)) for r, c in zip(*np.where(eligible))]
    fill_coords = [p for p in all_coords if nominal_fill_zone[p[0], p[1]]]
    random.shuffle(all_coords)
    random.shuffle(fill_coords)
    return all_coords, fill_coords


def _place_obstacles(n_obstacles, candidates, fill_candidates, obstacle_colors, grid):
    placed = []
    n_fill = random.randint(0, min(n_obstacles, len(fill_candidates)))
    if fill_candidates and random.random() < OBSTACLE_IN_FILL_PROB:
        n_fill = max(1, n_fill)
    for p in fill_candidates:
        if len(placed) >= n_fill:
            break
        if _obstacle_fits(p, placed):
            placed.append(p)
    placed_set = set(placed)
    for p in candidates:
        if len(placed) >= n_obstacles:
            break
        if p not in placed_set and _obstacle_fits(p, placed):
            placed.append(p)
            placed_set.add(p)
    for i, (r, c) in enumerate(placed):
        grid[r, c] = obstacle_colors[i % len(obstacle_colors)]


def _touches_border(mask):
    return bool(mask[0, :].any() or mask[-1, :].any() or mask[:, 0].any() or mask[:, -1].any())


def _gen_attempt():
    rad = random.choice([(-1, 0), (1, 0), (0, -1), (0, 1)])
    h = random.randint(*GRID_H_VERT) if rad[0] else random.randint(*GRID_H_HORIZ)
    w = random.randint(*GRID_W)

    built = _build_local_wall(rad, h, w)
    if built is None:
        return None
    local_wall, depth, gap = built
    anchor = _place_anchor(rad, h, w, depth, gap)

    palette = random.sample(range(10), random.randint(*PALETTE_SIZE))
    bg, wall_color, fill_color = palette[:3]
    obstacle_colors = palette[3:]

    grid = np.full((h, w), bg, dtype=int)
    for u, v in local_wall:
        r, c = _map_local(u, v, rad, anchor)
        grid[r, c] = wall_color

    interior = _local_interior(local_wall, depth, gap)
    wall_set = set(local_wall)
    adjacent = [
        p
        for p in interior
        if any((p[0] + dr, p[1] + dc) in wall_set for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)])
    ]
    seed_pool = [p for p in adjacent if p[0] >= max(1, depth - SEED_DEPTH_LOOKBACK)]
    if not seed_pool:
        return None

    blob = _grow_seed_blob(random.choice(seed_pool), set(interior))
    for u, v in blob:
        r, c = _map_local(u, v, rad, anchor)
        if grid[r, c] != bg:
            return None
        grid[r, c] = fill_color

    try:
        layout = _analyze_scene(grid)
        nominal_out = main(grid)
    except Exception:
        return None

    ray_lengths = [len(path) for path in layout["ray_paths"]]
    if not ray_lengths or min(ray_lengths) < MIN_RAY_LEN or int(layout["ray_mask"].sum()) < MIN_RAY_CELLS:
        return None

    nominal_fill_zone = (nominal_out == fill_color) & (grid == bg)

    n_obstacles = random.randint(0, MAX_OBSTACLES)
    if n_obstacles and not obstacle_colors:
        available = [c for c in range(10) if c not in (bg, wall_color, fill_color)]
        obstacle_colors = random.sample(available, random.randint(1, 2))
    if n_obstacles:
        candidates, fill_candidates = _find_obstacle_candidates(
            grid,
            bg,
            wall_color,
            nominal_fill_zone,
            layout["ray_mask"],
        )
        _place_obstacles(n_obstacles, candidates, fill_candidates, obstacle_colors, grid)

    try:
        layout = _analyze_scene(grid)
        out = main(grid)
    except Exception:
        return None

    new_fill = (out == fill_color) & (grid == bg)
    new_wall = (out == wall_color) & (grid == bg)
    ray_lengths = [len(path) for path in layout["ray_paths"]]
    if int(new_fill.sum()) < MIN_NEW_FILL or not _touches_border(new_fill):
        return None
    if not ray_lengths or min(ray_lengths) < MIN_RAY_LEN or int(new_wall.sum()) < MIN_RAY_CELLS:
        return None
    return grid


def generate_input() -> np.ndarray:
    for _ in range(GEN_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid b9e38dc0 D8 variant input")

            ```

