+# Combo variant of b9e38dc0 (index 19)
+# combo_spec: D1/2+D17/0
+# Name: 不规则边框+边界追踪替代填充
+
+import random
+
+import numpy as np
+from scipy.ndimage import distance_transform_cdt
+
+from arc_utils import components_mask, get_bg, neighbors4, neighbors8
+
+# Design analysis for the combo variant
+# variant_spec:
+#   concretization:
+#   - 保留原题的对象角色: 一个主墙体、一个靠墙的填色种子、若干零散障碍点。
+#   - 与原题不同的第一处是内部机制: 种子先经由“墙体 + 开口射线”定义的可达区找到半包围口袋，
+#     但口袋内部不再整片洪水填充；只有那些既可达、又与墙体 4 邻接的背景格会被染色，
+#     因而形成沿内侧轮廓走的一圈描边。
+#   - 第二处变化是墙体不再是简单规则 U/C 形。生成器从原始双臂骨架出发，在口袋内侧长出 2-5 个
+#     锯齿/凹凸“牙齿”，这些额外墙像素仍保持单一 8 连通组件和恰好两个端点，但会让内轮廓出现更多折返。
+#   - 具体追踪例子: 原题里某个 7x7 口袋若种子可达 14 个背景格，则这 14 格全会变成填色。
+#     在本变体里，同一可达口袋会先筛出其中贴着不规则墙面的那一圈，例如只给 9 格上色，
+#     口袋中央的 5 格保持背景；随后开口外侧仍按原题方式向网格边缘辐射。
+#   complexity_calibration:
+#   - 仍保留四个基向辐射方向与 1:1 / 1:2 两种端点射线斜率，避免把问题降成固定朝向。
+#   - 不规则性只放在“口袋内侧的锯齿轮廓”这一维上，取值控制在少量额外牙齿，保证视觉差异稳定但不失控。
+#   - 生成器拒绝“内部几乎没有中心空白”的样例，确保解题者能看出这是描边而不是整块填充。
+#   implicit_assumptions_review:
+#   - 原 `filled_mask = seen & (g == bg)` 假设所有可达背景格都要上色；这里失效，必须拆成
+#     `trace_mask` 与 `radiated_mask` 两部分。
+#   - 原阴影逻辑作用于全部新填色格；若直接复用会擦掉口袋内描边，所以这里将阴影限制为开口外辐射区。
+#   - 开口方向推断仍依赖两个 degree-1 端点及其外指方向，因此生成器必须保证额外锯齿不会制造新端点，
+#     也不会破坏端点附近的局部朝向。
+#   - `_opening_side_masks` 仍把端点所在行/列当作“开口截面”；这要求不规则墙体的所有口袋区域
+#     依然位于端点闭口一侧。生成器保持原始 local(u,v) 几何，不把锯齿伸到开口外侧。
+#   placement_legality:
+#   - 锯齿只允许向口袋内侧生长，不能越过对侧墙臂，也不能封死种子到开口的可达通道。
+#   - 墙像素总数仍限定在 17-25；额外锯齿会预留预算，避免越界。
+#   - 障碍继续放在远离墙的背景格，优先放在外辐射区，减少与内部描边叠层导致的辨识困难。
+#   visual_observability:
+#   - 输出必须同时出现两种信号: 内部“空心描边”与外部“实心喷射”；并且墙内轮廓要有多个折点，
+#     否则视觉上会退化成单变体 D1/2 或原题。
+#   cleanliness_and_color:
+#   - 规则完全由几何关系决定，不依赖颜色编号大小。
+#   - 颜色角色仍由频率与距离区分: 墙体最多，种子离墙最近，障碍较远且稀疏。
+#   new_main_assumptions:
+#   - `trace_mask` 假设口袋中存在至少一批可达且贴墙的背景格；生成器据此筛掉过窄或被种子吞没的口袋。
+#   - `wall_irregularity_score` 假设不规则性体现在中间深度行的“内部墙像素”增多；生成器显式构造并校验此点。
+
+
+GRID_H_VERT = (11, 18)
+GRID_H_HORIZ = (8, 18)
+GRID_W = (15, 19)
+
+WALL_PIXELS_MIN = 17
+WALL_PIXELS_MAX = 25
+DEPTH_VERT = (5, 10)
+DEPTH_HORIZ = (6, 8)
+GAP_VERT = (6, 7)
+GAP_HORIZ = (5, 7)
+TIP_12_PROB = 0.5
+
+OPEN_END_MARGIN = 3
+
+SEED_SIZE_WEIGHTS = [1, 1, 1, 1, 2, 2, 3, 4, 5, 6]
+SEED_DEPTH_LOOKBACK = 3
+
+MAX_OBSTACLES = 5
+OBSTACLE_IN_RADIATE_PROB = 0.75
+OBSTACLE_MIN_SEP = 2
+
+IRREGULAR_NOTCH_MIN = 2
+IRREGULAR_NOTCH_MAX = 5
+MIN_IRREGULAR_DELTA = 2
+MIN_IRREGULAR_SCORE = 4
+
+MIN_NEW_FILL = 20
+MIN_INTERIOR_TRACE = 8
+MIN_INTERIOR_GAP = 6
+MIN_RADIATED_FILL = 12
+MIN_BEHAVIOR_DELTA = 6
+PALETTE_SIZE = (3, 5)
+GEN_RETRIES = 500
+
+
+def _sgn(x: int) -> int:
+    return (x > 0) - (x < 0)
+
+
+def _degree1_pixels(points: set[tuple[int, int]] | list[tuple[int, int]]) -> list[tuple[int, int]]:
+    pts = set(points)
+    return [
+        (r, c)
+        for r, c in pts
+        if sum((rr, cc) in pts for rr, cc in neighbors8(r, c)) == 1
+    ]
+
+
+def _analyze_scene(grid: np.ndarray) -> dict:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+
+    vals = np.unique(g)
+    bg = get_bg(g)
+    non_bg = [int(v) for v in vals if int(v) != bg]
+    assert non_bg, "expected at least one non-background color"
+
+    wall = max(non_bg, key=lambda c: int((g == c).sum()))
+    wall_mask = g == wall
+    comps = [
+        set((int(r), int(c)) for r, c in pts)
+        for pts in components_mask(wall_mask, connectivity=8)
+    ]
+    assert comps, "expected at least one wall connected component"
+
+    other_colors = [c for c in non_bg if c != wall]
+    assert other_colors, "expected at least one non-wall color"
+
+    wall_points = [p for comp in comps for p in comp]
+
+    def min_dist_to_wall(color: int) -> tuple[int, int]:
+        pts = [(int(r), int(c)) for r, c in zip(*np.where(g == color))]
+        best_d = 10**9
+        for r, c in pts:
+            for wr, wc in wall_points:
+                d = abs(r - wr) + abs(c - wc)
+                if d < best_d:
+                    best_d = d
+                    if best_d == 0:
+                        return 0, len(pts)
+        return best_d, len(pts)
+
+    fill = min(other_colors, key=lambda c: (min_dist_to_wall(c)[0], min_dist_to_wall(c)[1]))
+    fill_pos = [(int(r), int(c)) for r, c in zip(*np.where(g == fill))]
+    if not fill_pos:
+        return {
+            "g": g,
+            "h": h,
+            "w": w,
+            "bg": bg,
+            "wall": wall,
+            "fill": fill,
+            "fill_pos": fill_pos,
+        }
+
+    def comp_min_dist(comp: set[tuple[int, int]]) -> int:
+        best_d = 10**9
+        for r, c in fill_pos:
+            for wr, wc in comp:
+                d = abs(r - wr) + abs(c - wc)
+                if d < best_d:
+                    best_d = d
+                    if best_d == 0:
+                        return 0
+        return best_d
+
+    wall_comp = min(comps, key=lambda comp: (comp_min_dist(comp), -len(comp)))
+    comp_mask = np.zeros_like(wall_mask, dtype=bool)
+    for r, c in wall_comp:
+        comp_mask[r, c] = True
+
+    def comp_neighbors(r: int, c: int) -> list[tuple[int, int]]:
+        out = []
+        for rr, cc in neighbors8(r, c):
+            if 0 <= rr < h and 0 <= cc < w and comp_mask[rr, cc]:
+                out.append((rr, cc))
+        return out
+
+    endpoints = [(r, c) for r, c in wall_comp if len(comp_neighbors(r, c)) == 1]
+    assert endpoints, "expected wall component endpoints"
+
+    def outward_dir(ep: tuple[int, int]) -> tuple[tuple[int, int], bool]:
+        n1 = comp_neighbors(*ep)[0]
+        d1 = (_sgn(n1[0] - ep[0]), _sgn(n1[1] - ep[1]))
+        d_use = d1
+        is_12 = False
+        n2s = [p for p in comp_neighbors(*n1) if p != ep]
+        if n2s:
+            n2 = n2s[0]
+            d2 = (_sgn(n2[0] - n1[0]), _sgn(n2[1] - n1[1]))
+            if (d1[0] == 0) ^ (d1[1] == 0) and d2[0] != 0 and d2[1] != 0:
+                d_use = d2
+                is_12 = True
+        return (-d_use[0], -d_use[1]), is_12
+
+    out_info = [outward_dir(ep) for ep in endpoints]
+    out_dirs = [d for d, _ in out_info]
+    tip_12 = [flag for _, flag in out_info]
+    rad = (_sgn(sum(d[0] for d in out_dirs)), _sgn(sum(d[1] for d in out_dirs)))
+    assert rad in {(-1, 0), (1, 0), (0, -1), (0, 1)}, "expected cardinal radiate direction"
+
+    barrier = comp_mask.copy()
+
+    def add_ray(start: tuple[int, int], d: tuple[int, int]) -> None:
+        rr, cc = start
+        while True:
+            rr += d[0]
+            cc += d[1]
+            if not (0 <= rr < h and 0 <= cc < w):
+                break
+            barrier[rr, cc] = True
+
+    def add_ray_12(start: tuple[int, int], d: tuple[int, int]) -> None:
+        rr, cc = start
+        step = 0
+        while True:
+            step += 1
+            if step % 2 == 1:
+                rr += d[0]
+                cc += d[1]
+            else:
+                if rad[0] != 0:
+                    rr += d[0]
+                else:
+                    cc += d[1]
+            if not (0 <= rr < h and 0 <= cc < w):
+                break
+            barrier[rr, cc] = True
+
+    for ep, d, is_12 in zip(endpoints, out_dirs, tip_12):
+        if is_12:
+            add_ray_12(ep, d)
+        else:
+            add_ray(ep, d)
+
+    return {
+        "g": g,
+        "h": h,
+        "w": w,
+        "bg": bg,
+        "wall": wall,
+        "fill": fill,
+        "fill_pos": fill_pos,
+        "wall_comp": wall_comp,
+        "comp_mask": comp_mask,
+        "endpoints": endpoints,
+        "rad": rad,
+        "barrier": barrier,
+        "tip_12": tip_12,
+    }
+
+
+def _reachable_mask(
+    g: np.ndarray,
+    bg: int,
+    fill: int,
+    barrier: np.ndarray,
+    fill_pos: list[tuple[int, int]],
+) -> np.ndarray:
+    passable = (~barrier) & ((g == bg) | (g == fill))
+    q = fill_pos[:]
+    seen = np.zeros_like(passable, dtype=bool)
+    for r, c in q:
+        if passable[r, c]:
+            seen[r, c] = True
+    while q:
+        r, c = q.pop()
+        for rr, cc in neighbors4(r, c):
+            if 0 <= rr < g.shape[0] and 0 <= cc < g.shape[1] and passable[rr, cc] and not seen[rr, cc]:
+                seen[rr, cc] = True
+                q.append((rr, cc))
+    return seen
+
+
+def _opening_side_masks(
+    h: int,
+    w: int,
+    endpoints: list[tuple[int, int]],
+    rad: tuple[int, int],
+) -> tuple[np.ndarray, np.ndarray]:
+    rows = np.arange(h)[:, None]
+    cols = np.arange(w)[None, :]
+    ep_rows = [r for r, _ in endpoints]
+    ep_cols = [c for _, c in endpoints]
+
+    if rad == (-1, 0):
+        interior = rows > max(ep_rows)
+    elif rad == (1, 0):
+        interior = rows < min(ep_rows)
+    elif rad == (0, -1):
+        interior = cols > max(ep_cols)
+    else:
+        interior = cols < min(ep_cols)
+
+    interior = np.broadcast_to(interior, (h, w)).copy()
+    exterior = ~interior
+    return interior, exterior
+
+
+def _wall_irregularity_score_local(wall: set[tuple[int, int]], depth: int) -> int:
+    by_row: dict[int, list[int]] = {}
+    for u, v in wall:
+        by_row.setdefault(u, []).append(v)
+    score = 0
+    for u in range(1, depth):
+        if u not in by_row:
+            continue
+        vs = by_row[u]
+        lo, hi = min(vs), max(vs)
+        score += sum(1 for v in vs if lo < v < hi)
+    return score
+
+
+def _wall_irregularity_score_scene(info: dict) -> int:
+    rad = info["rad"]
+    by_u: dict[int, list[int]] = {}
+    for r, c in info["wall_comp"]:
+        if rad == (-1, 0):
+            u, v = r, c
+        elif rad == (1, 0):
+            u, v = -r, c
+        elif rad == (0, -1):
+            u, v = c, r
+        else:
+            u, v = -c, r
+        by_u.setdefault(int(u), []).append(int(v))
+
+    levels = sorted(by_u)
+    score = 0
+    for u in levels[1:-1]:
+        vs = by_u[u]
+        lo, hi = min(vs), max(vs)
+        score += sum(1 for v in vs if lo < v < hi)
+    return score
+
+
+def _solution_masks(grid: np.ndarray) -> dict:
+    scene = _analyze_scene(grid)
+    g = scene["g"]
+    h, w = scene["h"], scene["w"]
+
+    if not scene["fill_pos"]:
+        zero = np.zeros((h, w), dtype=bool)
+        scene.update(
+            {
+                "seen": zero,
+                "interior_reachable": zero,
+                "radiated_reachable": zero,
+                "trace_mask": zero,
+                "radiated_mask": zero,
+                "flood_mask": zero,
+            }
+        )
+        return scene
+
+    seen = _reachable_mask(g, scene["bg"], scene["fill"], scene["barrier"], scene["fill_pos"])
+    interior_side, exterior_side = _opening_side_masks(h, w, scene["endpoints"], scene["rad"])
+    bg_mask = g == scene["bg"]
+
+    interior_reachable = seen & interior_side
+    radiated_reachable = seen & exterior_side
+
+    trace_mask = np.zeros((h, w), dtype=bool)
+    for r, c in zip(*np.where(interior_reachable & bg_mask)):
+        if any(
+            0 <= rr < h and 0 <= cc < w and scene["comp_mask"][rr, cc]
+            for rr, cc in neighbors4(int(r), int(c))
+        ):
+            trace_mask[r, c] = True
+
+    scene.update(
+        {
+            "seen": seen,
+            "interior_reachable": interior_reachable,
+            "radiated_reachable": radiated_reachable,
+            "trace_mask": trace_mask,
+            "radiated_mask": radiated_reachable & bg_mask,
+            "flood_mask": seen & bg_mask,
+        }
+    )
+    return scene
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Trace the inner skin of an irregular partial enclosure, then spray the color outward through its opening.
+
+    Input structure:
+    - The most common color is background. The dominant non-background color is a single 8-connected wall sprite whose pocket has a jagged inner edge but still leaves one open side.
+    - Another non-background color is the seed placed inside that pocket near the closed end. Any further non-background pixels are preserved obstacles.
+    Rule:
+    - Follow the seed-reachable pocket, but inside the enclosure color only the reachable background cells that touch the wall by 4-neighborhood, producing an inner contour trace instead of a solid fill.
+    - Through the opening, continue the original outward radiation bounded by endpoint rays; obstacles keep casting shadows only in that outward spray.
+
+    Key insight: The endpoints still reveal the open direction, but the pocket action changes from area fill to boundary tracing, and the irregular inner wall forces the traced path to hug a more complex contour.
+    """
+    g = np.array(grid, copy=True)
+    info = _solution_masks(g)
+    if not info["fill_pos"]:
+        return g
+
+    bg = info["bg"]
+    fill = info["fill"]
+    wall = info["wall"]
+    rad = info["rad"]
+
+    traced_mask = info["trace_mask"].copy()
+    radiated_mask = info["radiated_mask"].copy()
+
+    out = g.copy()
+    out[traced_mask | radiated_mask] = fill
+
+    obstacles = (g != bg) & (g != fill) & (g != wall)
+
+    def shadow_process(coords: list[tuple[int, int]]) -> None:
+        started = False
+        blocked = False
+        for r, c in coords:
+            if radiated_mask[r, c]:
+                started = True
+            if started and obstacles[r, c]:
+                blocked = True
+                continue
+            if blocked and radiated_mask[r, c]:
+                out[r, c] = bg
+                radiated_mask[r, c] = False
+
+    dr, dc = rad
+    if dr != 0:
+        for c in range(g.shape[1]):
+            rows = range(g.shape[0]) if dr > 0 else range(g.shape[0] - 1, -1, -1)
+            shadow_process([(r, c) for r in rows])
+    else:
+        for r in range(g.shape[0]):
+            cols = range(g.shape[1]) if dc > 0 else range(g.shape[1] - 1, -1, -1)
+            shadow_process([(r, c) for c in cols])
+
+    return out
+
+
+def _make_arm(depth: int, start_v: int, target_v: int, extra_steps: int, tip_12: bool = False) -> list[tuple[int, int]]:
+    sign = 1 if target_v > start_v else -1
+    n_side_steps = abs(target_v - start_v)
+    chosen_rows: list[int] = []
+    if n_side_steps:
+        if tip_12:
+            chosen_rows = [2 * (i + 1) for i in range(n_side_steps)]
+            extra_steps = 0
+        else:
+            chosen_rows = [1]
+            if n_side_steps > 1:
+                chosen_rows += random.sample(range(2, depth + 1), n_side_steps - 1)
+            chosen_rows.sort()
+
+    first_row = chosen_rows[0] if chosen_rows else 1
+    extra_rows = [r for r in chosen_rows if r != first_row]
+    random.shuffle(extra_rows)
+    orthogonal_rows = set(extra_rows[:extra_steps])
+
+    pts = [(0, start_v)]
+    u, v = 0, start_v
+    for row in range(1, depth + 1):
+        u += 1
+        if row in orthogonal_rows:
+            pts.append((u, v))
+            v += sign
+        elif row in chosen_rows:
+            v += sign
+        pts.append((u, v))
+    return pts
+
+
+def _build_base_wall(rad: tuple[int, int], h: int, w: int):
+    if rad[0]:
+        max_depth = min(DEPTH_VERT[1], h - 6)
+        if max_depth < DEPTH_VERT[0]:
+            return None
+        depth = random.randint(DEPTH_VERT[0], max_depth)
+        gap = random.randint(*GAP_VERT)
+    else:
+        depth = random.randint(DEPTH_HORIZ[0], min(DEPTH_HORIZ[1], w - 6))
+        gap = random.randint(GAP_HORIZ[0], min(GAP_HORIZ[1], h - 1))
+
+    if gap == 5:
+        left_bottom, right_bottom = 2, 3
+    elif gap == 6:
+        left_bottom, right_bottom = 2, 4
+    else:
+        left_bottom, right_bottom = random.choice([(2, 5), (3, 4)])
+
+    bridge_extra = max(0, right_bottom - left_bottom - 1)
+    base_count = 2 * (depth + 1) + bridge_extra
+    max_extra_l = max(0, left_bottom - 1)
+    max_extra_r = max(0, gap - right_bottom - 1)
+    reserved_cap = WALL_PIXELS_MAX - IRREGULAR_NOTCH_MIN
+    min_extra = max(0, WALL_PIXELS_MIN - base_count)
+    max_extra = min(max_extra_l + max_extra_r, reserved_cap - base_count)
+    if min_extra > max_extra:
+        return None
+
+    extra = random.randint(min_extra, max_extra)
+    extra_l = random.randint(max(0, extra - max_extra_r), min(max_extra_l, extra))
+    extra_r = extra - extra_l
+
+    max_n_side = max(left_bottom, gap - right_bottom)
+    tip_12 = depth >= 2 * max_n_side and random.random() < TIP_12_PROB
+    left = _make_arm(depth, 0, left_bottom, extra_l, tip_12=tip_12)
+    right = _make_arm(depth, gap, right_bottom, extra_r, tip_12=tip_12)
+    pts = set(left) | set(right)
+    for v in range(left_bottom, right_bottom + 1):
+        pts.add((depth, v))
+
+    while len(pts) < WALL_PIXELS_MIN:
+        candidates = [
+            (u, v)
+            for u in range(max(0, depth - 3), depth + 1)
+            for v in range(gap + 1)
+            if (u, v) not in pts
+            and sum(
+                (uu, vv) in pts
+                for uu in range(u - 1, u + 2)
+                for vv in range(v - 1, v + 2)
+                if (uu, vv) != (u, v)
+            ) >= 2
+        ]
+        random.shuffle(candidates)
+        added = False
+        for p in candidates:
+            trial = pts | {p}
+            if len(trial) <= reserved_cap and len(_degree1_pixels(trial)) == 2:
+                pts = trial
+                added = True
+                break
+        if not added:
+            return None
+
+    if not (WALL_PIXELS_MIN <= len(pts) <= reserved_cap) or len(_degree1_pixels(pts)) != 2:
+        return None
+    return pts, depth, gap
+
+
+def _interior_notch_candidates(wall: set[tuple[int, int]], depth: int) -> list[tuple[int, int]]:
+    by_row: dict[int, set[int]] = {}
+    for u, v in wall:
+        by_row.setdefault(u, set()).add(v)
+
+    candidates: set[tuple[int, int]] = set()
+    for u in range(1, depth):
+        row = by_row.get(u)
+        if not row or len(row) < 2:
+            continue
+        lo, hi = min(row), max(row)
+        left = lo
+        while left + 1 in row:
+            left += 1
+        cand = left + 1
+        if cand < hi and cand not in row and cand <= lo + 2:
+            candidates.add((u, cand))
+
+        right = hi
+        while right - 1 in row:
+            right -= 1
+        cand = right - 1
+        if cand > lo and cand not in row and cand >= hi - 2:
+            candidates.add((u, cand))
+
+    return list(candidates)
+
+
+def _local_interior(wall: set[tuple[int, int]], depth: int) -> list[tuple[int, int]]:
+    by_row: dict[int, list[int]] = {}
+    for u, v in wall:
+        by_row.setdefault(u, []).append(v)
+
+    interior = []
+    for u in range(1, depth):
+        if u not in by_row or len(by_row[u]) < 2:
+            continue
+        lo, hi = min(by_row[u]), max(by_row[u])
+        for v in range(lo + 1, hi):
+            if (u, v) not in wall:
+                interior.append((u, v))
+    return interior
+
+
+def _local_outline_and_core(wall: set[tuple[int, int]], depth: int) -> tuple[list[tuple[int, int]], list[tuple[int, int]]]:
+    interior = _local_interior(wall, depth)
+    wall_set = set(wall)
+    outline = [
+        p
+        for p in interior
+        if any((p[0] + dr, p[1] + dc) in wall_set for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)])
+    ]
+    outline_set = set(outline)
+    core = [p for p in interior if p not in outline_set]
+    return outline, core
+
+
+def _build_irregular_wall(rad: tuple[int, int], h: int, w: int):
+    built = _build_base_wall(rad, h, w)
+    if built is None:
+        return None
+
+    pts, depth, gap = built
+    base_score = _wall_irregularity_score_local(pts, depth)
+    target_notches = random.randint(IRREGULAR_NOTCH_MIN, IRREGULAR_NOTCH_MAX)
+    added = 0
+
+    for _ in range(20):
+        candidates = _interior_notch_candidates(pts, depth)
+        random.shuffle(candidates)
+        progressed = False
+        for p in candidates:
+            if len(pts) >= WALL_PIXELS_MAX:
+                break
+            neighbor_count = sum((rr, cc) in pts for rr, cc in neighbors8(*p))
+            if neighbor_count < 2:
+                continue
+            trial = set(pts)
+            trial.add(p)
+            if len(_degree1_pixels(trial)) != 2:
+                continue
+            outline, core = _local_outline_and_core(trial, depth)
+            if len(outline) < MIN_INTERIOR_TRACE or len(core) < MIN_INTERIOR_GAP:
+                continue
+            pts = trial
+            added += 1
+            progressed = True
+            break
+        if not progressed:
+            break
+        if added >= target_notches:
+            break
+
+    score = _wall_irregularity_score_local(pts, depth)
+    if added < IRREGULAR_NOTCH_MIN or score < max(MIN_IRREGULAR_SCORE, base_score + MIN_IRREGULAR_DELTA):
+        return None
+    if not (WALL_PIXELS_MIN <= len(pts) <= WALL_PIXELS_MAX):
+        return None
+    return pts, depth, gap
+
+
+def _map_local(u: int, v: int, rad: tuple[int, int], anchor: tuple[int, int]) -> tuple[int, int]:
+    r0, c0 = anchor
+    if rad == (-1, 0):
+        return r0 + u, c0 + v
+    if rad == (1, 0):
+        return r0 - u, c0 + v
+    if rad == (0, -1):
+        return r0 + v, c0 + u
+    return r0 + v, c0 - u
+
+
+def _place_anchor(rad: tuple[int, int], h: int, w: int, depth: int, gap: int) -> tuple[int, int]:
+    if rad == (-1, 0):
+        return random.randint(OPEN_END_MARGIN, h - depth - 3), random.randint(0, w - gap - 1)
+    if rad == (1, 0):
+        return random.randint(depth + 2, h - 4), random.randint(0, w - gap - 1)
+    if rad == (0, -1):
+        return random.randint(0, h - gap - 1), random.randint(OPEN_END_MARGIN, w - depth - 3)
+    return random.randint(0, h - gap - 1), random.randint(depth + 2, w - 4)
+
+
+def _grow_seed_blob(seed: tuple[int, int], interior_set: set[tuple[int, int]]) -> set[tuple[int, int]]:
+    blob = {seed}
+    target_size = random.choice(SEED_SIZE_WEIGHTS)
+    frontier = [seed]
+    while len(blob) < target_size and frontier:
+        p = frontier.pop(random.randrange(len(frontier)))
+        u, v = p
+        for q in random.sample([(u - 1, v), (u + 1, v), (u, v - 1), (u, v + 1)], 4):
+            if q in interior_set and q not in blob:
+                blob.add(q)
+                frontier.append(q)
+                if len(blob) >= target_size:
+                    break
+    return blob
+
+
+def _obstacle_fits(pos: tuple[int, int], placed: list[tuple[int, int]]) -> bool:
+    r, c = pos
+    return all(max(abs(r - rr), abs(c - cc)) >= OBSTACLE_MIN_SEP for rr, cc in placed)
+
+
+def _find_obstacle_candidates(
+    grid: np.ndarray,
+    bg: int,
+    wall_color: int,
+    radiated_zone: np.ndarray,
+) -> tuple[list[tuple[int, int]], list[tuple[int, int]]]:
+    wall_mask = grid == wall_color
+    dist = distance_transform_cdt(~wall_mask, metric="taxicab")
+    far_from_wall = dist > 1
+    eligible = (grid == bg) & far_from_wall
+    all_coords = [(int(r), int(c)) for r, c in zip(*np.where(eligible))]
+    radiate_coords = [p for p in all_coords if radiated_zone[p[0], p[1]]]
+    random.shuffle(all_coords)
+    random.shuffle(radiate_coords)
+    return all_coords, radiate_coords
+
+
+def _place_obstacles(
+    n_obstacles: int,
+    candidates: list[tuple[int, int]],
+    radiate_candidates: list[tuple[int, int]],
+    obstacle_colors: list[int],
+    grid: np.ndarray,
+) -> None:
+    placed: list[tuple[int, int]] = []
+    n_radiate = random.randint(0, min(n_obstacles, len(radiate_candidates)))
+    if radiate_candidates and random.random() < OBSTACLE_IN_RADIATE_PROB:
+        n_radiate = max(1, n_radiate)
+    for p in radiate_candidates:
+        if len(placed) >= n_radiate:
+            break
+        if _obstacle_fits(p, placed):
+            placed.append(p)
+    placed_set = set(placed)
+    for p in candidates:
+        if len(placed) >= n_obstacles:
+            break
+        if p not in placed_set and _obstacle_fits(p, placed):
+            placed.append(p)
+            placed_set.add(p)
+    for i, (r, c) in enumerate(placed):
+        grid[r, c] = obstacle_colors[i % len(obstacle_colors)]
+
+
+def _touches_border(mask: np.ndarray) -> bool:
+    return bool(mask[0, :].any() or mask[-1, :].any() or mask[:, 0].any() or mask[:, -1].any())
+
+
+def _variant_metrics(grid: np.ndarray) -> dict:
+    info = _solution_masks(grid)
+    interior_bg = info["interior_reachable"] & (info["g"] == info["bg"])
+    fill_now = info["trace_mask"] | info["radiated_mask"]
+    return {
+        "trace": int(info["trace_mask"].sum()),
+        "interior_gap": int(interior_bg.sum() - info["trace_mask"].sum()),
+        "radiated": int(info["radiated_mask"].sum()),
+        "behavior_delta": int(info["flood_mask"].sum() - fill_now.sum()),
+        "irregularity": int(_wall_irregularity_score_scene(info)),
+        "rad": info["rad"],
+    }
+
+
+def _gen_attempt() -> np.ndarray | None:
+    rad = random.choice([(-1, 0), (1, 0), (0, -1), (0, 1)])
+    h = random.randint(*GRID_H_VERT) if rad[0] else random.randint(*GRID_H_HORIZ)
+    w = random.randint(*GRID_W)
+
+    built = _build_irregular_wall(rad, h, w)
+    if built is None:
+        return None
+    local_wall, depth, gap = built
+    outline, core = _local_outline_and_core(local_wall, depth)
+    if len(outline) < MIN_INTERIOR_TRACE or len(core) < MIN_INTERIOR_GAP:
+        return None
+
+    anchor = _place_anchor(rad, h, w, depth, gap)
+
+    palette = random.sample(range(10), random.randint(*PALETTE_SIZE))
+    bg, wall_color, fill_color = palette[:3]
+    obstacle_colors = palette[3:]
+
+    grid = np.full((h, w), bg, dtype=int)
+    for u, v in local_wall:
+        r, c = _map_local(u, v, rad, anchor)
+        if not (0 <= r < h and 0 <= c < w):
+            return None
+        grid[r, c] = wall_color
+
+    interior = _local_interior(local_wall, depth)
+    wall_set = set(local_wall)
+    adjacent = [
+        p
+        for p in interior
+        if any((p[0] + dr, p[1] + dc) in wall_set for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)])
+    ]
+    seed_pool = [p for p in adjacent if p[0] >= max(1, depth - SEED_DEPTH_LOOKBACK)]
+    if not seed_pool:
+        return None
+
+    blob = _grow_seed_blob(random.choice(seed_pool), set(interior))
+    for u, v in blob:
+        r, c = _map_local(u, v, rad, anchor)
+        if grid[r, c] != bg:
+            return None
+        grid[r, c] = fill_color
+
+    try:
+        metrics = _variant_metrics(grid)
+    except Exception:
+        return None
+    if (
+        metrics["trace"] < MIN_INTERIOR_TRACE
+        or metrics["interior_gap"] < MIN_INTERIOR_GAP
+        or metrics["radiated"] < MIN_RADIATED_FILL
+        or metrics["behavior_delta"] < MIN_BEHAVIOR_DELTA
+        or metrics["irregularity"] < MIN_IRREGULAR_SCORE
+    ):
+        return None
+
+    n_obstacles = random.randint(0, MAX_OBSTACLES)
+    if n_obstacles and not obstacle_colors:
+        available = [c for c in range(10) if c not in (bg, wall_color, fill_color)]
+        obstacle_colors = random.sample(available, random.randint(1, 2))
+    if n_obstacles:
+        info = _solution_masks(grid)
+        candidates, radiate_candidates = _find_obstacle_candidates(grid, bg, wall_color, info["radiated_mask"])
+        _place_obstacles(n_obstacles, candidates, radiate_candidates, obstacle_colors, grid)
+
+    try:
+        metrics = _variant_metrics(grid)
+        out = main(grid)
+    except Exception:
+        return None
+
+    new_fill = (out == fill_color) & (grid == bg)
+    if int(new_fill.sum()) < MIN_NEW_FILL or not _touches_border(new_fill):
+        return None
+    if (
+        metrics["trace"] < MIN_INTERIOR_TRACE
+        or metrics["interior_gap"] < MIN_INTERIOR_GAP
+        or metrics["radiated"] < MIN_RADIATED_FILL
+        or metrics["behavior_delta"] < MIN_BEHAVIOR_DELTA
+        or metrics["irregularity"] < MIN_IRREGULAR_SCORE
+    ):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate valid b9e38dc0 combo input")

diff --git a/ceshi/code_combo/b9e38dc0/19/code.py b/ceshi/code_combo/b9e38dc0/19/code.py
new file mode 100644
index 0000000000000000000000000000000000000000..b9ef40bfca5e1b7c258f1173add20dd63f9f7197
--- /dev/null
+++ b/ceshi/code_combo/b9e38dc0/19/code.py
@@ -0,0 +1,828 @@
+# Combo variant of b9e38dc0 (index 19)
+# combo_spec: D1/2+D17/0
+# Name: 不规则边框+边界追踪替代填充
+
+import random
+
+import numpy as np
+from scipy.ndimage import distance_transform_cdt
+
+from arc_utils import components_mask, get_bg, neighbors4, neighbors8
+
+# Design analysis for the combo variant
+# variant_spec:
+#   concretization:
+#   - 保留原题的对象角色: 一个主墙体、一个靠墙的填色种子、若干零散障碍点。
+#   - 与原题不同的第一处是内部机制: 种子先经由“墙体 + 开口射线”定义的可达区找到半包围口袋，
+#     但口袋内部不再整片洪水填充；只有那些既可达、又与墙体 4 邻接的背景格会被染色，
+#     因而形成沿内侧轮廓走的一圈描边。
+#   - 第二处变化是墙体不再是简单规则 U/C 形。生成器从原始双臂骨架出发，在口袋内侧长出 2-5 个
+#     锯齿/凹凸“牙齿”，这些额外墙像素仍保持单一 8 连通组件和恰好两个端点，但会让内轮廓出现更多折返。
+#   - 具体追踪例子: 原题里某个 7x7 口袋若种子可达 14 个背景格，则这 14 格全会变成填色。
+#     在本变体里，同一可达口袋会先筛出其中贴着不规则墙面的那一圈，例如只给 9 格上色，
+#     口袋中央的 5 格保持背景；随后开口外侧仍按原题方式向网格边缘辐射。
+#   complexity_calibration:
+#   - 仍保留四个基向辐射方向与 1:1 / 1:2 两种端点射线斜率，避免把问题降成固定朝向。
+#   - 不规则性只放在“口袋内侧的锯齿轮廓”这一维上，取值控制在少量额外牙齿，保证视觉差异稳定但不失控。
+#   - 生成器拒绝“内部几乎没有中心空白”的样例，确保解题者能看出这是描边而不是整块填充。
+#   implicit_assumptions_review:
+#   - 原 `filled_mask = seen & (g == bg)` 假设所有可达背景格都要上色；这里失效，必须拆成
+#     `trace_mask` 与 `radiated_mask` 两部分。
+#   - 原阴影逻辑作用于全部新填色格；若直接复用会擦掉口袋内描边，所以这里将阴影限制为开口外辐射区。
+#   - 开口方向推断仍依赖两个 degree-1 端点及其外指方向，因此生成器必须保证额外锯齿不会制造新端点，
+#     也不会破坏端点附近的局部朝向。
+#   - `_opening_side_masks` 仍把端点所在行/列当作“开口截面”；这要求不规则墙体的所有口袋区域
+#     依然位于端点闭口一侧。生成器保持原始 local(u,v) 几何，不把锯齿伸到开口外侧。
+#   placement_legality:
+#   - 锯齿只允许向口袋内侧生长，不能越过对侧墙臂，也不能封死种子到开口的可达通道。
+#   - 墙像素总数仍限定在 17-25；额外锯齿会预留预算，避免越界。
+#   - 障碍继续放在远离墙的背景格，优先放在外辐射区，减少与内部描边叠层导致的辨识困难。
+#   visual_observability:
+#   - 输出必须同时出现两种信号: 内部“空心描边”与外部“实心喷射”；并且墙内轮廓要有多个折点，
+#     否则视觉上会退化成单变体 D1/2 或原题。
+#   cleanliness_and_color:
+#   - 规则完全由几何关系决定，不依赖颜色编号大小。
+#   - 颜色角色仍由频率与距离区分: 墙体最多，种子离墙最近，障碍较远且稀疏。
+#   new_main_assumptions:
+#   - `trace_mask` 假设口袋中存在至少一批可达且贴墙的背景格；生成器据此筛掉过窄或被种子吞没的口袋。
+#   - `wall_irregularity_score` 假设不规则性体现在中间深度行的“内部墙像素”增多；生成器显式构造并校验此点。
+
+
+GRID_H_VERT = (11, 18)
+GRID_H_HORIZ = (8, 18)
+GRID_W = (15, 19)
+
+WALL_PIXELS_MIN = 17
+WALL_PIXELS_MAX = 25
+DEPTH_VERT = (5, 10)
+DEPTH_HORIZ = (6, 8)
+GAP_VERT = (6, 7)
+GAP_HORIZ = (5, 7)
+TIP_12_PROB = 0.5
+
+OPEN_END_MARGIN = 3
+
+SEED_SIZE_WEIGHTS = [1, 1, 1, 1, 2, 2, 3, 4, 5, 6]
+SEED_DEPTH_LOOKBACK = 3
+
+MAX_OBSTACLES = 5
+OBSTACLE_IN_RADIATE_PROB = 0.75
+OBSTACLE_MIN_SEP = 2
+
+IRREGULAR_NOTCH_MIN = 2
+IRREGULAR_NOTCH_MAX = 5
+MIN_IRREGULAR_DELTA = 2
+MIN_IRREGULAR_SCORE = 4
+
+MIN_NEW_FILL = 20
+MIN_INTERIOR_TRACE = 8
+MIN_INTERIOR_GAP = 6
+MIN_RADIATED_FILL = 12
+MIN_BEHAVIOR_DELTA = 6
+PALETTE_SIZE = (3, 5)
+GEN_RETRIES = 500
+
+
+def _sgn(x: int) -> int:
+    return (x > 0) - (x < 0)
+
+
+def _degree1_pixels(points: set[tuple[int, int]] | list[tuple[int, int]]) -> list[tuple[int, int]]:
+    pts = set(points)
+    return [
+        (r, c)
+        for r, c in pts
+        if sum((rr, cc) in pts for rr, cc in neighbors8(r, c)) == 1
+    ]
+
+
+def _analyze_scene(grid: np.ndarray) -> dict:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+
+    vals = np.unique(g)
+    bg = get_bg(g)
+    non_bg = [int(v) for v in vals if int(v) != bg]
+    assert non_bg, "expected at least one non-background color"
+
+    wall = max(non_bg, key=lambda c: int((g == c).sum()))
+    wall_mask = g == wall
+    comps = [
+        set((int(r), int(c)) for r, c in pts)
+        for pts in components_mask(wall_mask, connectivity=8)
+    ]
+    assert comps, "expected at least one wall connected component"
+
+    other_colors = [c for c in non_bg if c != wall]
+    assert other_colors, "expected at least one non-wall color"
+
+    wall_points = [p for comp in comps for p in comp]
+
+    def min_dist_to_wall(color: int) -> tuple[int, int]:
+        pts = [(int(r), int(c)) for r, c in zip(*np.where(g == color))]
+        best_d = 10**9
+        for r, c in pts:
+            for wr, wc in wall_points:
+                d = abs(r - wr) + abs(c - wc)
+                if d < best_d:
+                    best_d = d
+                    if best_d == 0:
+                        return 0, len(pts)
+        return best_d, len(pts)
+
+    fill = min(other_colors, key=lambda c: (min_dist_to_wall(c)[0], min_dist_to_wall(c)[1]))
+    fill_pos = [(int(r), int(c)) for r, c in zip(*np.where(g == fill))]
+    if not fill_pos:
+        return {
+            "g": g,
+            "h": h,
+            "w": w,
+            "bg": bg,
+            "wall": wall,
+            "fill": fill,
+            "fill_pos": fill_pos,
+        }
+
+    def comp_min_dist(comp: set[tuple[int, int]]) -> int:
+        best_d = 10**9
+        for r, c in fill_pos:
+            for wr, wc in comp:
+                d = abs(r - wr) + abs(c - wc)
+                if d < best_d:
+                    best_d = d
+                    if best_d == 0:
+                        return 0
+        return best_d
+
+    wall_comp = min(comps, key=lambda comp: (comp_min_dist(comp), -len(comp)))
+    comp_mask = np.zeros_like(wall_mask, dtype=bool)
+    for r, c in wall_comp:
+        comp_mask[r, c] = True
+
+    def comp_neighbors(r: int, c: int) -> list[tuple[int, int]]:
+        out = []
+        for rr, cc in neighbors8(r, c):
+            if 0 <= rr < h and 0 <= cc < w and comp_mask[rr, cc]:
+                out.append((rr, cc))
+        return out
+
+    endpoints = [(r, c) for r, c in wall_comp if len(comp_neighbors(r, c)) == 1]
+    assert endpoints, "expected wall component endpoints"
+
+    def outward_dir(ep: tuple[int, int]) -> tuple[tuple[int, int], bool]:
+        n1 = comp_neighbors(*ep)[0]
+        d1 = (_sgn(n1[0] - ep[0]), _sgn(n1[1] - ep[1]))
+        d_use = d1
+        is_12 = False
+        n2s = [p for p in comp_neighbors(*n1) if p != ep]
+        if n2s:
+            n2 = n2s[0]
+            d2 = (_sgn(n2[0] - n1[0]), _sgn(n2[1] - n1[1]))
+            if (d1[0] == 0) ^ (d1[1] == 0) and d2[0] != 0 and d2[1] != 0:
+                d_use = d2
+                is_12 = True
+        return (-d_use[0], -d_use[1]), is_12
+
+    out_info = [outward_dir(ep) for ep in endpoints]
+    out_dirs = [d for d, _ in out_info]
+    tip_12 = [flag for _, flag in out_info]
+    rad = (_sgn(sum(d[0] for d in out_dirs)), _sgn(sum(d[1] for d in out_dirs)))
+    assert rad in {(-1, 0), (1, 0), (0, -1), (0, 1)}, "expected cardinal radiate direction"
+
+    barrier = comp_mask.copy()
+
+    def add_ray(start: tuple[int, int], d: tuple[int, int]) -> None:
+        rr, cc = start
+        while True:
+            rr += d[0]
+            cc += d[1]
+            if not (0 <= rr < h and 0 <= cc < w):
+                break
+            barrier[rr, cc] = True
+
+    def add_ray_12(start: tuple[int, int], d: tuple[int, int]) -> None:
+        rr, cc = start
+        step = 0
+        while True:
+            step += 1
+            if step % 2 == 1:
+                rr += d[0]
+                cc += d[1]
+            else:
+                if rad[0] != 0:
+                    rr += d[0]
+                else:
+                    cc += d[1]
+            if not (0 <= rr < h and 0 <= cc < w):
+                break
+            barrier[rr, cc] = True
+
+    for ep, d, is_12 in zip(endpoints, out_dirs, tip_12):
+        if is_12:
+            add_ray_12(ep, d)
+        else:
+            add_ray(ep, d)
+
+    return {
+        "g": g,
+        "h": h,
+        "w": w,
+        "bg": bg,
+        "wall": wall,
+        "fill": fill,
+        "fill_pos": fill_pos,
+        "wall_comp": wall_comp,
+        "comp_mask": comp_mask,
+        "endpoints": endpoints,
+        "rad": rad,
+        "barrier": barrier,
+        "tip_12": tip_12,
+    }
+
+
+def _reachable_mask(
+    g: np.ndarray,
+    bg: int,
+    fill: int,
+    barrier: np.ndarray,
+    fill_pos: list[tuple[int, int]],
+) -> np.ndarray:
+    passable = (~barrier) & ((g == bg) | (g == fill))
+    q = fill_pos[:]
+    seen = np.zeros_like(passable, dtype=bool)
+    for r, c in q:
+        if passable[r, c]:
+            seen[r, c] = True
+    while q:
+        r, c = q.pop()
+        for rr, cc in neighbors4(r, c):
+            if 0 <= rr < g.shape[0] and 0 <= cc < g.shape[1] and passable[rr, cc] and not seen[rr, cc]:
+                seen[rr, cc] = True
+                q.append((rr, cc))
+    return seen
+
+
+def _opening_side_masks(
+    h: int,
+    w: int,
+    endpoints: list[tuple[int, int]],
+    rad: tuple[int, int],
+) -> tuple[np.ndarray, np.ndarray]:
+    rows = np.arange(h)[:, None]
+    cols = np.arange(w)[None, :]
+    ep_rows = [r for r, _ in endpoints]
+    ep_cols = [c for _, c in endpoints]
+
+    if rad == (-1, 0):
+        interior = rows > max(ep_rows)
+    elif rad == (1, 0):
+        interior = rows < min(ep_rows)
+    elif rad == (0, -1):
+        interior = cols > max(ep_cols)
+    else:
+        interior = cols < min(ep_cols)
+
+    interior = np.broadcast_to(interior, (h, w)).copy()
+    exterior = ~interior
+    return interior, exterior
+
+
+def _wall_irregularity_score_local(wall: set[tuple[int, int]], depth: int) -> int:
+    by_row: dict[int, list[int]] = {}
+    for u, v in wall:
+        by_row.setdefault(u, []).append(v)
+    score = 0
+    for u in range(1, depth):
+        if u not in by_row:
+            continue
+        vs = by_row[u]
+        lo, hi = min(vs), max(vs)
+        score += sum(1 for v in vs if lo < v < hi)
+    return score
+
+
+def _wall_irregularity_score_scene(info: dict) -> int:
+    rad = info["rad"]
+    by_u: dict[int, list[int]] = {}
+    for r, c in info["wall_comp"]:
+        if rad == (-1, 0):
+            u, v = r, c
+        elif rad == (1, 0):
+            u, v = -r, c
+        elif rad == (0, -1):
+            u, v = c, r
+        else:
+            u, v = -c, r
+        by_u.setdefault(int(u), []).append(int(v))
+
+    levels = sorted(by_u)
+    score = 0
+    for u in levels[1:-1]:
+        vs = by_u[u]
+        lo, hi = min(vs), max(vs)
+        score += sum(1 for v in vs if lo < v < hi)
+    return score
+
+
+def _solution_masks(grid: np.ndarray) -> dict:
+    scene = _analyze_scene(grid)
+    g = scene["g"]
+    h, w = scene["h"], scene["w"]
+
+    if not scene["fill_pos"]:
+        zero = np.zeros((h, w), dtype=bool)
+        scene.update(
+            {
+                "seen": zero,
+                "interior_reachable": zero,
+                "radiated_reachable": zero,
+                "trace_mask": zero,
+                "radiated_mask": zero,
+                "flood_mask": zero,
+            }
+        )
+        return scene
+
+    seen = _reachable_mask(g, scene["bg"], scene["fill"], scene["barrier"], scene["fill_pos"])
+    interior_side, exterior_side = _opening_side_masks(h, w, scene["endpoints"], scene["rad"])
+    bg_mask = g == scene["bg"]
+
+    interior_reachable = seen & interior_side
+    radiated_reachable = seen & exterior_side
+
+    trace_mask = np.zeros((h, w), dtype=bool)
+    for r, c in zip(*np.where(interior_reachable & bg_mask)):
+        if any(
+            0 <= rr < h and 0 <= cc < w and scene["comp_mask"][rr, cc]
+            for rr, cc in neighbors4(int(r), int(c))
+        ):
+            trace_mask[r, c] = True
+
+    scene.update(
+        {
+            "seen": seen,
+            "interior_reachable": interior_reachable,
+            "radiated_reachable": radiated_reachable,
+            "trace_mask": trace_mask,
+            "radiated_mask": radiated_reachable & bg_mask,
+            "flood_mask": seen & bg_mask,
+        }
+    )
+    return scene
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Trace the inner skin of an irregular partial enclosure, then spray the color outward through its opening.
+
+    Input structure:
+    - The most common color is background. The dominant non-background color is a single 8-connected wall sprite whose pocket has a jagged inner edge but still leaves one open side.
+    - Another non-background color is the seed placed inside that pocket near the closed end. Any further non-background pixels are preserved obstacles.
+    Rule:
+    - Follow the seed-reachable pocket, but inside the enclosure color only the reachable background cells that touch the wall by 4-neighborhood, producing an inner contour trace instead of a solid fill.
+    - Through the opening, continue the original outward radiation bounded by endpoint rays; obstacles keep casting shadows only in that outward spray.
+
+    Key insight: The endpoints still reveal the open direction, but the pocket action changes from area fill to boundary tracing, and the irregular inner wall forces the traced path to hug a more complex contour.
+    """
+    g = np.array(grid, copy=True)
+    info = _solution_masks(g)
+    if not info["fill_pos"]:
+        return g
+
+    bg = info["bg"]
+    fill = info["fill"]
+    wall = info["wall"]
+    rad = info["rad"]
+
+    traced_mask = info["trace_mask"].copy()
+    radiated_mask = info["radiated_mask"].copy()
+
+    out = g.copy()
+    out[traced_mask | radiated_mask] = fill
+
+    obstacles = (g != bg) & (g != fill) & (g != wall)
+
+    def shadow_process(coords: list[tuple[int, int]]) -> None:
+        started = False
+        blocked = False
+        for r, c in coords:
+            if radiated_mask[r, c]:
+                started = True
+            if started and obstacles[r, c]:
+                blocked = True
+                continue
+            if blocked and radiated_mask[r, c]:
+                out[r, c] = bg
+                radiated_mask[r, c] = False
+
+    dr, dc = rad
+    if dr != 0:
+        for c in range(g.shape[1]):
+            rows = range(g.shape[0]) if dr > 0 else range(g.shape[0] - 1, -1, -1)
+            shadow_process([(r, c) for r in rows])
+    else:
+        for r in range(g.shape[0]):
+            cols = range(g.shape[1]) if dc > 0 else range(g.shape[1] - 1, -1, -1)
+            shadow_process([(r, c) for c in cols])
+
+    return out
+
+
+def _make_arm(depth: int, start_v: int, target_v: int, extra_steps: int, tip_12: bool = False) -> list[tuple[int, int]]:
+    sign = 1 if target_v > start_v else -1
+    n_side_steps = abs(target_v - start_v)
+    chosen_rows: list[int] = []
+    if n_side_steps:
+        if tip_12:
+            chosen_rows = [2 * (i + 1) for i in range(n_side_steps)]
+            extra_steps = 0
+        else:
+            chosen_rows = [1]
+            if n_side_steps > 1:
+                chosen_rows += random.sample(range(2, depth + 1), n_side_steps - 1)
+            chosen_rows.sort()
+
+    first_row = chosen_rows[0] if chosen_rows else 1
+    extra_rows = [r for r in chosen_rows if r != first_row]
+    random.shuffle(extra_rows)
+    orthogonal_rows = set(extra_rows[:extra_steps])
+
+    pts = [(0, start_v)]
+    u, v = 0, start_v
+    for row in range(1, depth + 1):
+        u += 1
+        if row in orthogonal_rows:
+            pts.append((u, v))
+            v += sign
+        elif row in chosen_rows:
+            v += sign
+        pts.append((u, v))
+    return pts
+
+
+def _build_base_wall(rad: tuple[int, int], h: int, w: int):
+    if rad[0]:
+        max_depth = min(DEPTH_VERT[1], h - 6)
+        if max_depth < DEPTH_VERT[0]:
+            return None
+        depth = random.randint(DEPTH_VERT[0], max_depth)
+        gap = random.randint(*GAP_VERT)
+    else:
+        depth = random.randint(DEPTH_HORIZ[0], min(DEPTH_HORIZ[1], w - 6))
+        gap = random.randint(GAP_HORIZ[0], min(GAP_HORIZ[1], h - 1))
+
+    if gap == 5:
+        left_bottom, right_bottom = 2, 3
+    elif gap == 6:
+        left_bottom, right_bottom = 2, 4
+    else:
+        left_bottom, right_bottom = random.choice([(2, 5), (3, 4)])
+
+    bridge_extra = max(0, right_bottom - left_bottom - 1)
+    base_count = 2 * (depth + 1) + bridge_extra
+    max_extra_l = max(0, left_bottom - 1)
+    max_extra_r = max(0, gap - right_bottom - 1)
+    reserved_cap = WALL_PIXELS_MAX - IRREGULAR_NOTCH_MIN
+    min_extra = max(0, WALL_PIXELS_MIN - base_count)
+    max_extra = min(max_extra_l + max_extra_r, reserved_cap - base_count)
+    if min_extra > max_extra:
+        return None
+
+    extra = random.randint(min_extra, max_extra)
+    extra_l = random.randint(max(0, extra - max_extra_r), min(max_extra_l, extra))
+    extra_r = extra - extra_l
+
+    max_n_side = max(left_bottom, gap - right_bottom)
+    tip_12 = depth >= 2 * max_n_side and random.random() < TIP_12_PROB
+    left = _make_arm(depth, 0, left_bottom, extra_l, tip_12=tip_12)
+    right = _make_arm(depth, gap, right_bottom, extra_r, tip_12=tip_12)
+    pts = set(left) | set(right)
+    for v in range(left_bottom, right_bottom + 1):
+        pts.add((depth, v))
+
+    while len(pts) < WALL_PIXELS_MIN:
+        candidates = [
+            (u, v)
+            for u in range(max(0, depth - 3), depth + 1)
+            for v in range(gap + 1)
+            if (u, v) not in pts
+            and sum(
+                (uu, vv) in pts
+                for uu in range(u - 1, u + 2)
+                for vv in range(v - 1, v + 2)
+                if (uu, vv) != (u, v)
+            ) >= 2
+        ]
+        random.shuffle(candidates)
+        added = False
+        for p in candidates:
+            trial = pts | {p}
+            if len(trial) <= reserved_cap and len(_degree1_pixels(trial)) == 2:
+                pts = trial
+                added = True
+                break
+        if not added:
+            return None
+
+    if not (WALL_PIXELS_MIN <= len(pts) <= reserved_cap) or len(_degree1_pixels(pts)) != 2:
+        return None
+    return pts, depth, gap
+
+
+def _interior_notch_candidates(wall: set[tuple[int, int]], depth: int) -> list[tuple[int, int]]:
+    by_row: dict[int, set[int]] = {}
+    for u, v in wall:
+        by_row.setdefault(u, set()).add(v)
+
+    candidates: set[tuple[int, int]] = set()
+    for u in range(1, depth):
+        row = by_row.get(u)
+        if not row or len(row) < 2:
+            continue
+        lo, hi = min(row), max(row)
+        left = lo
+        while left + 1 in row:
+            left += 1
+        cand = left + 1
+        if cand < hi and cand not in row and cand <= lo + 2:
+            candidates.add((u, cand))
+
+        right = hi
+        while right - 1 in row:
+            right -= 1
+        cand = right - 1
+        if cand > lo and cand not in row and cand >= hi - 2:
+            candidates.add((u, cand))
+
+    return list(candidates)
+
+
+def _local_interior(wall: set[tuple[int, int]], depth: int) -> list[tuple[int, int]]:
+    by_row: dict[int, list[int]] = {}
+    for u, v in wall:
+        by_row.setdefault(u, []).append(v)
+
+    interior = []
+    for u in range(1, depth):
+        if u not in by_row or len(by_row[u]) < 2:
+            continue
+        lo, hi = min(by_row[u]), max(by_row[u])
+        for v in range(lo + 1, hi):
+            if (u, v) not in wall:
+                interior.append((u, v))
+    return interior
+
+
+def _local_outline_and_core(wall: set[tuple[int, int]], depth: int) -> tuple[list[tuple[int, int]], list[tuple[int, int]]]:
+    interior = _local_interior(wall, depth)
+    wall_set = set(wall)
+    outline = [
+        p
+        for p in interior
+        if any((p[0] + dr, p[1] + dc) in wall_set for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)])
+    ]
+    outline_set = set(outline)
+    core = [p for p in interior if p not in outline_set]
+    return outline, core
+
+
+def _build_irregular_wall(rad: tuple[int, int], h: int, w: int):
+    built = _build_base_wall(rad, h, w)
+    if built is None:
+        return None
+
+    pts, depth, gap = built
+    base_score = _wall_irregularity_score_local(pts, depth)
+    target_notches = random.randint(IRREGULAR_NOTCH_MIN, IRREGULAR_NOTCH_MAX)
+    added = 0
+
+    for _ in range(20):
+        candidates = _interior_notch_candidates(pts, depth)
+        random.shuffle(candidates)
+        progressed = False
+        for p in candidates:
+            if len(pts) >= WALL_PIXELS_MAX:
+                break
+            neighbor_count = sum((rr, cc) in pts for rr, cc in neighbors8(*p))
+            if neighbor_count < 2:
+                continue
+            trial = set(pts)
+            trial.add(p)
+            if len(_degree1_pixels(trial)) != 2:
+                continue
+            outline, core = _local_outline_and_core(trial, depth)
+            if len(outline) < MIN_INTERIOR_TRACE or len(core) < MIN_INTERIOR_GAP:
+                continue
+            pts = trial
+            added += 1
+            progressed = True
+            break
+        if not progressed:
+            break
+        if added >= target_notches:
+            break
+
+    score = _wall_irregularity_score_local(pts, depth)
+    if added < IRREGULAR_NOTCH_MIN or score < max(MIN_IRREGULAR_SCORE, base_score + MIN_IRREGULAR_DELTA):
+        return None
+    if not (WALL_PIXELS_MIN <= len(pts) <= WALL_PIXELS_MAX):
+        return None
+    return pts, depth, gap
+
+
+def _map_local(u: int, v: int, rad: tuple[int, int], anchor: tuple[int, int]) -> tuple[int, int]:
+    r0, c0 = anchor
+    if rad == (-1, 0):
+        return r0 + u, c0 + v
+    if rad == (1, 0):
+        return r0 - u, c0 + v
+    if rad == (0, -1):
+        return r0 + v, c0 + u
+    return r0 + v, c0 - u
+
+
+def _place_anchor(rad: tuple[int, int], h: int, w: int, depth: int, gap: int) -> tuple[int, int]:
+    if rad == (-1, 0):
+        return random.randint(OPEN_END_MARGIN, h - depth - 3), random.randint(0, w - gap - 1)
+    if rad == (1, 0):
+        return random.randint(depth + 2, h - 4), random.randint(0, w - gap - 1)
+    if rad == (0, -1):
+        return random.randint(0, h - gap - 1), random.randint(OPEN_END_MARGIN, w - depth - 3)
+    return random.randint(0, h - gap - 1), random.randint(depth + 2, w - 4)
+
+
+def _grow_seed_blob(seed: tuple[int, int], interior_set: set[tuple[int, int]]) -> set[tuple[int, int]]:
+    blob = {seed}
+    target_size = random.choice(SEED_SIZE_WEIGHTS)
+    frontier = [seed]
+    while len(blob) < target_size and frontier:
+        p = frontier.pop(random.randrange(len(frontier)))
+        u, v = p
+        for q in random.sample([(u - 1, v), (u + 1, v), (u, v - 1), (u, v + 1)], 4):
+            if q in interior_set and q not in blob:
+                blob.add(q)
+                frontier.append(q)
+                if len(blob) >= target_size:
+                    break
+    return blob
+
+
+def _obstacle_fits(pos: tuple[int, int], placed: list[tuple[int, int]]) -> bool:
+    r, c = pos
+    return all(max(abs(r - rr), abs(c - cc)) >= OBSTACLE_MIN_SEP for rr, cc in placed)
+
+
+def _find_obstacle_candidates(
+    grid: np.ndarray,
+    bg: int,
+    wall_color: int,
+    radiated_zone: np.ndarray,
+) -> tuple[list[tuple[int, int]], list[tuple[int, int]]]:
+    wall_mask = grid == wall_color
+    dist = distance_transform_cdt(~wall_mask, metric="taxicab")
+    far_from_wall = dist > 1
+    eligible = (grid == bg) & far_from_wall
+    all_coords = [(int(r), int(c)) for r, c in zip(*np.where(eligible))]
+    radiate_coords = [p for p in all_coords if radiated_zone[p[0], p[1]]]
+    random.shuffle(all_coords)
+    random.shuffle(radiate_coords)
+    return all_coords, radiate_coords
+
+
+def _place_obstacles(
+    n_obstacles: int,
+    candidates: list[tuple[int, int]],
+    radiate_candidates: list[tuple[int, int]],
+    obstacle_colors: list[int],
+    grid: np.ndarray,
+) -> None:
+    placed: list[tuple[int, int]] = []
+    n_radiate = random.randint(0, min(n_obstacles, len(radiate_candidates)))
+    if radiate_candidates and random.random() < OBSTACLE_IN_RADIATE_PROB:
+        n_radiate = max(1, n_radiate)
+    for p in radiate_candidates:
+        if len(placed) >= n_radiate:
+            break
+        if _obstacle_fits(p, placed):
+            placed.append(p)
+    placed_set = set(placed)
+    for p in candidates:
+        if len(placed) >= n_obstacles:
+            break
+        if p not in placed_set and _obstacle_fits(p, placed):
+            placed.append(p)
+            placed_set.add(p)
+    for i, (r, c) in enumerate(placed):
+        grid[r, c] = obstacle_colors[i % len(obstacle_colors)]
+
+
+def _touches_border(mask: np.ndarray) -> bool:
+    return bool(mask[0, :].any() or mask[-1, :].any() or mask[:, 0].any() or mask[:, -1].any())
+
+
+def _variant_metrics(grid: np.ndarray) -> dict:
+    info = _solution_masks(grid)
+    interior_bg = info["interior_reachable"] & (info["g"] == info["bg"])
+    fill_now = info["trace_mask"] | info["radiated_mask"]
+    return {
+        "trace": int(info["trace_mask"].sum()),
+        "interior_gap": int(interior_bg.sum() - info["trace_mask"].sum()),
+        "radiated": int(info["radiated_mask"].sum()),
+        "behavior_delta": int(info["flood_mask"].sum() - fill_now.sum()),
+        "irregularity": int(_wall_irregularity_score_scene(info)),
+        "rad": info["rad"],
+    }
+
+
+def _gen_attempt() -> np.ndarray | None:
+    rad = random.choice([(-1, 0), (1, 0), (0, -1), (0, 1)])
+    h = random.randint(*GRID_H_VERT) if rad[0] else random.randint(*GRID_H_HORIZ)
+    w = random.randint(*GRID_W)
+
+    built = _build_irregular_wall(rad, h, w)
+    if built is None:
+        return None
+    local_wall, depth, gap = built
+    outline, core = _local_outline_and_core(local_wall, depth)
+    if len(outline) < MIN_INTERIOR_TRACE or len(core) < MIN_INTERIOR_GAP:
+        return None
+
+    anchor = _place_anchor(rad, h, w, depth, gap)
+
+    palette = random.sample(range(10), random.randint(*PALETTE_SIZE))
+    bg, wall_color, fill_color = palette[:3]
+    obstacle_colors = palette[3:]
+
+    grid = np.full((h, w), bg, dtype=int)
+    for u, v in local_wall:
+        r, c = _map_local(u, v, rad, anchor)
+        if not (0 <= r < h and 0 <= c < w):
+            return None
+        grid[r, c] = wall_color
+
+    interior = _local_interior(local_wall, depth)
+    wall_set = set(local_wall)
+    adjacent = [
+        p
+        for p in interior
+        if any((p[0] + dr, p[1] + dc) in wall_set for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)])
+    ]
+    seed_pool = [p for p in adjacent if p[0] >= max(1, depth - SEED_DEPTH_LOOKBACK)]
+    if not seed_pool:
+        return None
+
+    blob = _grow_seed_blob(random.choice(seed_pool), set(interior))
+    for u, v in blob:
+        r, c = _map_local(u, v, rad, anchor)
+        if grid[r, c] != bg:
+            return None
+        grid[r, c] = fill_color
+
+    try:
+        metrics = _variant_metrics(grid)
+    except Exception:
+        return None
+    if (
+        metrics["trace"] < MIN_INTERIOR_TRACE
+        or metrics["interior_gap"] < MIN_INTERIOR_GAP
+        or metrics["radiated"] < MIN_RADIATED_FILL
+        or metrics["behavior_delta"] < MIN_BEHAVIOR_DELTA
+        or metrics["irregularity"] < MIN_IRREGULAR_SCORE
+    ):
+        return None
+
+    n_obstacles = random.randint(0, MAX_OBSTACLES)
+    if n_obstacles and not obstacle_colors:
+        available = [c for c in range(10) if c not in (bg, wall_color, fill_color)]
+        obstacle_colors = random.sample(available, random.randint(1, 2))
+    if n_obstacles:
+        info = _solution_masks(grid)
+        candidates, radiate_candidates = _find_obstacle_candidates(grid, bg, wall_color, info["radiated_mask"])
+        _place_obstacles(n_obstacles, candidates, radiate_candidates, obstacle_colors, grid)
+
+    try:
+        metrics = _variant_metrics(grid)
+        out = main(grid)
+    except Exception:
+        return None
+
+    new_fill = (out == fill_color) & (grid == bg)
+    if int(new_fill.sum()) < MIN_NEW_FILL or not _touches_border(new_fill):
+        return None
+    if (
+        metrics["trace"] < MIN_INTERIOR_TRACE
+        or metrics["interior_gap"] < MIN_INTERIOR_GAP
+        or metrics["radiated"] < MIN_RADIATED_FILL
+        or metrics["behavior_delta"] < MIN_BEHAVIOR_DELTA
+        or metrics["irregularity"] < MIN_IRREGULAR_SCORE
+    ):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
