            add_ray(ep, d)

    return {
        "g": g,
        "h": h,
        "w": w,
        "bg": bg,
        "wall": wall,
        "fill": fill,
        "fill_pos": fill_pos,
        "comp_mask": comp_mask,
        "endpoints": endpoints,
        "rad": rad,
        "barrier": barrier,
        "tip_12": tip_12,
