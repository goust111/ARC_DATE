+
+    scene.update(
+        {
+            "seen": seen,
+            "interior_reachable": interior_reachable,
+            "radiated_reachable": radiated_reachable,
+            "trace_mask": trace_mask,
+            "radiated_mask": radiated_reachable & bg_mask,
+            "flood_mask": seen & bg_mask,
+        }
+    )
+    return scene
