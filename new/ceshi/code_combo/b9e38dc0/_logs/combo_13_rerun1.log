# Combo variant of b9e38dc0 (index 39)
# combo_spec: D5/1+D18/1
# Name: 半程停止+像素计数终止

import random

import numpy as np

from arc_utils import components_mask, get_bg, neighbors4, neighbors8

# Design analysis for the fused variant:
# - The original stable scaffold is "wall determines a cardinal opening, a seed blob
#   floods the pocket, and the fill radiates outward through that opening".
# - D5/1 changes only the outward termination: instead of letting the radiated wedge
#   run to the border, the exterior fill depth is capped by the number of source pixels
#   already present in the seed blob. The interior pocket still fills completely.
# - This code keeps the original wedge geometry by building the same infinite side
#   barriers, then trims outward fill by projection depth. That preserves the original
#   shape cue while making the numerical cap visible.
# - The provided base solver does not actually contain isolated-pixel motion, so D18/1
#   is introduced explicitly via singleton non-wall/non-fill components. Every such
#   singleton moves along the same radiate direction but only by floor(distance_to_edge/2).
# - To avoid ambiguous semantics, the generator no longer places shadow obstacles:
#   singleton extras are movers, not blockers. This keeps the examples visually legible.
# - The generator guarantees two non-degenerate signals:
#   1) opening-to-edge distance is larger than the seed count, so ray truncation does
#      not collapse back to the edge-reaching original behavior;
#   2) movers start at least two cells from the target edge, so half-stop motion is visible.


def _sgn(x: int) -> int:
    return (x > 0) - (x < 0)


def _distance_to_edge(r: int, c: int, rad: tuple[int, int], h: int, w: int) -> int:
    if rad == (1, 0):
        return h - 1 - r
    if rad == (-1, 0):
        return r
    if rad == (0, 1):
        return w - 1 - c
    if rad == (0, -1):
        return c
    return 0


def _halfway_destination(r: int, c: int, rad: tuple[int, int], h: int, w: int) -> tuple[tuple[int, int], int]:
    dist = _distance_to_edge(r, c, rad, h, w)
    steps = dist // 2
    return (r + rad[0] * steps, c + rad[1] * steps), steps


def _opening_edge_distance(endpoints: list[tuple[int, int]], rad: tuple[int, int], h: int, w: int) -> int:
    if rad == (1, 0):
        return h - 1 - max(r for r, _ in endpoints)
    if rad == (-1, 0):
        return min(r for r, _ in endpoints)
    if rad == (0, 1):
        return w - 1 - max(c for _, c in endpoints)
    if rad == (0, -1):
        return min(c for _, c in endpoints)
    return 0


def _outward_depth(r: int, c: int, endpoints: list[tuple[int, int]], rad: tuple[int, int]) -> int:
    if rad == (1, 0):
        return r - max(rr for rr, _ in endpoints)
    if rad == (-1, 0):
        return min(rr for rr, _ in endpoints) - r
    if rad == (0, 1):
        return c - max(cc for _, cc in endpoints)
    if rad == (0, -1):
        return min(cc for _, cc in endpoints) - c
    return 0


def _scene_info(g: np.ndarray) -> dict:
    h, w = g.shape
    vals = np.unique(g)
    bg = get_bg(g)

    non_bg = [int(v) for v in vals if int(v) != bg]
    assert non_bg, "expected at least one non-background color"

    wall = max(non_bg, key=lambda c: int((g == c).sum()))
    wall_mask = g == wall
    comps = [set((int(r), int(c)) for r, c in pts) for pts in components_mask(wall_mask, connectivity=8)]
    assert comps, "expected at least one wall connected component"

    other_colors = [c for c in non_bg if c != wall]
    assert other_colors, "expected at least one non-wall color"

    wall_points = [p for comp in comps for p in comp]

    def min_dist_to_wall(color: int) -> tuple[int, int]:
        pts = [(int(r), int(c)) for r, c in zip(*np.where(g == color))]
        best_d = 10**9
        for r, c in pts:
            for wr, wc in wall_points:
                d = abs(r - wr) + abs(c - wc)
                if d < best_d:
                    best_d = d
                    if best_d == 0:
                        return 0, len(pts)
        return best_d, len(pts)

    fill = min(other_colors, key=lambda c: (min_dist_to_wall(c)[0], min_dist_to_wall(c)[1]))
    fill_pos = [(int(r), int(c)) for r, c in zip(*np.where(g == fill))]
    assert fill_pos, "expected at least one fill pixel"

    def comp_min_dist(comp: set[tuple[int, int]]) -> int:
        best_d = 10**9
        for r, c in fill_pos:
            for wr, wc in comp:
                d = abs(r - wr) + abs(c - wc)
                if d < best_d:
                    best_d = d
                    if best_d == 0:
                        return 0
        return best_d

    wall_comp = min(comps, key=lambda comp: (comp_min_dist(comp), -len(comp)))
    comp_mask = np.zeros_like(wall_mask, dtype=bool)
    for r, c in wall_comp:
        comp_mask[r, c] = True

    def comp_neighbors(r: int, c: int) -> list[tuple[int, int]]:
        out = []
        for rr, cc in neighbors8(r, c):
            if 0 <= rr < h and 0 <= cc < w and comp_mask[rr, cc]:
                out.append((rr, cc))
        return out

    endpoints = [(r, c) for r, c in wall_comp if len(comp_neighbors(r, c)) == 1]
    assert endpoints, "expected wall component endpoints"

    def outward_dir(ep: tuple[int, int]) -> tuple[tuple[int, int], bool]:
        n1 = comp_neighbors(*ep)[0]
        d1 = (_sgn(n1[0] - ep[0]), _sgn(n1[1] - ep[1]))
        d_use = d1
        is_12 = False
        n2s = [p for p in comp_neighbors(*n1) if p != ep]
        if n2s:
            n2 = n2s[0]
            d2 = (_sgn(n2[0] - n1[0]), _sgn(n2[1] - n1[1]))
            if (d1[0] == 0) ^ (d1[1] == 0):
                if d2[0] != 0 and d2[1] != 0:
                    d_use = d2
                    is_12 = True
        return (-d_use[0], -d_use[1]), is_12

    out_info = [outward_dir(ep) for ep in endpoints]
    out_dirs = [d for d, _ in out_info]
    tip_12 = [flag for _, flag in out_info]
    rad = (_sgn(sum(d[0] for d in out_dirs)), _sgn(sum(d[1] for d in out_dirs)))
    assert rad != (0, 0), "expected non-zero radiate direction"

    return {
        "bg": bg,
        "wall": wall,
        "fill": fill,
        "fill_pos": fill_pos,
        "wall_comp": wall_comp,
        "comp_mask": comp_mask,
        "endpoints": endpoints,
        "out_dirs": out_dirs,
        "tip_12": tip_12,
        "rad": rad,
    }


def _radiate_barrier(shape: tuple[int, int], comp_mask: np.ndarray, endpoints, out_dirs, tip_12, rad) -> np.ndarray:
    h, w = shape
    barrier = comp_mask.copy()

    def add_ray(start: tuple[int, int], d: tuple[int, int]) -> None:
        rr, cc = start
        while True:
            rr += d[0]
            cc += d[1]
            if not (0 <= rr < h and 0 <= cc < w):
                break
            barrier[rr, cc] = True

    def add_ray_12(start: tuple[int, int], d: tuple[int, int]) -> None:
        rr, cc = start
        step = 0
        while True:
            step += 1
            if step % 2 == 1:
                rr += d[0]
                cc += d[1]
            else:
                if rad[0] != 0:
                    rr += d[0]
                else:
                    cc += d[1]
            if not (0 <= rr < h and 0 <= cc < w):
                break
            barrier[rr, cc] = True

    for ep, d, is_12 in zip(endpoints, out_dirs, tip_12):
        if is_12:
            add_ray_12(ep, d)
        else:
            add_ray(ep, d)
    return barrier


def main(grid: np.ndarray) -> np.ndarray:
    """
    Fill a wall pocket, radiate outward for a counted distance, and move remote singleton markers halfway.

    Input structure:
    - The background is the dominant color; the wall is the most frequent non-background color and forms a single open pocket.
    - A compact fill-colored seed blob sits inside that pocket near the closed end. Other non-wall singletons sit away from the wall and indicate movers.

    Rule:
    - Flood-fill the pocket from the seed color, then continue through the opening inside the wall-defined wedge.
    - The outward part no longer runs to the border: its depth equals the number of source seed pixels. Each isolated singleton moves along the same opening direction by half of its remaining distance to the relevant grid edge, leaving background behind.

    Key insight:
    - The wall endpoints still reveal the radiate direction, but the two transformed object families stop for different numerical reasons: wedge fill stops after a count equal to seed size, while each singleton stops after floor(remaining-edge-distance / 2).
    """
    g = np.array(grid, copy=True)
    h, w = g.shape
    info = _scene_info(g)
    bg = info["bg"]
    wall = info["wall"]
    fill = info["fill"]
    fill_pos = info["fill_pos"]
    endpoints = info["endpoints"]
    rad = info["rad"]

    barrier = _radiate_barrier((h, w), info["comp_mask"], endpoints, info["out_dirs"], info["tip_12"], rad)
    passable = (~barrier) & ((g == bg) | (g == fill))

    q = fill_pos[:]
    seen = np.zeros_like(passable, dtype=bool)
    for r, c in q:
        if passable[r, c]:
            seen[r, c] = True
    while q:
        r, c = q.pop()
        for rr, cc in neighbors4(r, c):
            if 0 <= rr < h and 0 <= cc < w and passable[rr, cc] and not seen[rr, cc]:
                seen[rr, cc] = True
                q.append((rr, cc))

    ray_len = len(fill_pos)
    filled_mask = seen & (g == bg)
    for r, c in np.argwhere(filled_mask):
        if _outward_depth(int(r), int(c), endpoints, rad) > ray_len:
            filled_mask[int(r), int(c)] = False

    out = g.copy()
    out[filled_mask] = fill

    extra_mask = (g != bg) & (g != fill) & (g != wall)
    mover_comps = [pts for pts in components_mask(extra_mask, connectivity=8) if len(pts) == 1]

 succeeded in 0ms:
    mover_comps = [pts for pts in components_mask(extra_mask, connectivity=8) if len(pts) == 1]
    planned_moves = []
    blocked = {
        (int(r), int(c))
        for r, c in np.argwhere((g != bg) & (~extra_mask))
    }
    for pts in mover_comps:
        r, c = map(int, pts[0])
        color = int(g[r, c])
        (nr, nc), steps = _halfway_destination(r, c, rad, h, w)
        if steps <= 0:
            continue
        if (nr, nc) in blocked:
            continue
        planned_moves.append((r, c, int(nr), int(nc), color))

    for r, c, _nr, _nc, _color in planned_moves:
        out[r, c] = bg
    for _r, _c, nr, nc, color in planned_moves:
        out[nr, nc] = color

    return out


# --------------- generator ---------------

# Canvas size bounds
GRID_H_VERT = (12, 18)
GRID_H_HORIZ = (10, 18)
GRID_W = (15, 19)

# Wall geometry
WALL_PIXELS_MIN = 17
WALL_PIXELS_MAX = 25
DEPTH_VERT = (5, 10)
DEPTH_HORIZ = (6, 8)
GAP_VERT = (6, 7)
GAP_HORIZ = (5, 7)
TIP_12_PROB = 0.5

# Placement margins
OPEN_END_MARGIN = 5

# Fill seed
SEED_SIZE_WEIGHTS = [2, 2, 3, 3, 4, 4, 5]
SEED_DEPTH_LOOKBACK = 3

# Movers
MOVER_COUNT = (2, 4)
MOVER_MIN_SEP = 2

# Validation
MIN_NEW_FILL = 12
GEN_RETRIES = 400


def _degree1_pixels(points):
    pts = set(points)
    return [
        (r, c)
        for r, c in pts
        if sum((rr, cc) in pts for rr, cc in neighbors8(r, c)) == 1
    ]


def _make_arm(depth, start_v, target_v, extra_steps, tip_12=False):
    sign = 1 if target_v > start_v else -1
    n_side_steps = abs(target_v - start_v)
    chosen_rows = []
    if n_side_steps:
        if tip_12:
            chosen_rows = [2 * (i + 1) for i in range(n_side_steps)]
            extra_steps = 0
        else:
            chosen_rows = [1]
            if n_side_steps > 1:
                chosen_rows += random.sample(range(2, depth + 1), n_side_steps - 1)
            chosen_rows.sort()

    first_row = chosen_rows[0] if chosen_rows else 1
    extra_rows = [r for r in chosen_rows if r != first_row]
    random.shuffle(extra_rows)
    orthogonal_rows = set(extra_rows[:extra_steps])

    pts = [(0, start_v)]
    u, v = 0, start_v
    for row in range(1, depth + 1):
        u += 1
        if row in orthogonal_rows:
            pts.append((u, v))
            v += sign
        elif row in chosen_rows:
            v += sign
        pts.append((u, v))
    return pts


def _build_local_wall(rad, h, w):
    if rad[0]:
        max_depth = min(DEPTH_VERT[1], h - 6)
        if max_depth < DEPTH_VERT[0]:
            return None
        depth = random.randint(DEPTH_VERT[0], max_depth)
        gap = random.randint(*GAP_VERT)
    else:
        depth = random.randint(DEPTH_HORIZ[0], min(DEPTH_HORIZ[1], w - 6))
        gap = random.randint(GAP_HORIZ[0], min(GAP_HORIZ[1], h - 1))

    if gap == 5:
        left_bottom, right_bottom = 2, 3
    elif gap == 6:
        left_bottom, right_bottom = 2, 4
    else:
        left_bottom, right_bottom = random.choice([(2, 5), (3, 4)])

    bridge_extra = max(0, right_bottom - left_bottom - 1)
    base_count = 2 * (depth + 1) + bridge_extra
    max_extra_l = max(0, left_bottom - 1)
    max_extra_r = max(0, gap - right_bottom - 1)
    min_extra = max(0, WALL_PIXELS_MIN - base_count)
    max_extra = min(max_extra_l + max_extra_r, WALL_PIXELS_MAX - base_count)
    if min_extra > max_extra:
        return None

    extra = random.randint(min_extra, max_extra)
    extra_l = random.randint(max(0, extra - max_extra_r), min(max_extra_l, extra))
    extra_r = extra - extra_l

    max_n_side = max(left_bottom, gap - right_bottom)
    tip_12 = depth >= 2 * max_n_side and random.random() < TIP_12_PROB
    left = _make_arm(depth, 0, left_bottom, extra_l, tip_12=tip_12)
    right = _make_arm(depth, gap, right_bottom, extra_r, tip_12=tip_12)
    pts = set(left) | set(right)
    for v in range(left_bottom, right_bottom + 1):
        pts.add((depth, v))

    while len(pts) < WALL_PIXELS_MIN:
        candidates = [
            (u, v)
            for u in range(max(0, depth - 3), depth + 1)
            for v in range(gap + 1)
            if (u, v) not in pts
            and sum(
                (uu, vv) in pts
                for uu in range(u - 1, u + 2)
                for vv in range(v - 1, v + 2)
                if (uu, vv) != (u, v)
            ) >= 2
        ]
        random.shuffle(candidates)
        added = False
        for p in candidates:
            trial = pts | {p}
            if len(trial) <= WALL_PIXELS_MAX and len(_degree1_pixels(trial)) == 2:
                pts = trial
                added = True
                break
        if not added:
            return None

    if not (WALL_PIXELS_MIN <= len(pts) <= WALL_PIXELS_MAX) or len(_degree1_pixels(pts)) != 2:
        return None
    return pts, depth, gap


def _map_local(u, v, rad, anchor):
    r0, c0 = anchor
    if rad == (-1, 0):
        return r0 + u, c0 + v
    if rad == (1, 0):
        return r0 - u, c0 + v
    if rad == (0, -1):
        return r0 + v, c0 + u
    return r0 + v, c0 - u


def _place_anchor(rad, h, w, depth, gap):
    if rad == (-1, 0):
        r_lo, r_hi = OPEN_END_MARGIN, h - depth - 3
        c_lo, c_hi = 0, w - gap - 1
    elif rad == (1, 0):
        r_lo, r_hi = depth + 2, h - OPEN_END_MARGIN - 1
        c_lo, c_hi = 0, w - gap - 1
    elif rad == (0, -1):
        r_lo, r_hi = 0, h - gap - 1
        c_lo, c_hi = OPEN_END_MARGIN, w - depth - 3
    else:
        r_lo, r_hi = 0, h - gap - 1
        c_lo, c_hi = depth + 2, w - OPEN_END_MARGIN - 1

    if r_lo > r_hi or c_lo > c_hi:
        return None
    return random.randint(r_lo, r_hi), random.randint(c_lo, c_hi)


def _local_interior(wall, depth, gap):
    by_row = {}
    for u, v in wall:
        by_row.setdefault(u, []).append(v)
    interior = []
    for u in range(1, depth):
        if u not in by_row or len(by_row[u]) < 2:
            continue
        lo, hi = min(by_row[u]), max(by_row[u])
        for v in range(lo + 1, hi):
            if (u, v) not in wall:
                interior.append((u, v))
    return interior


def _grow_seed_blob(seed, interior_set):
    blob = {seed}
    target_size = random.choice(SEED_SIZE_WEIGHTS)
    frontier = [seed]
    while len(blob) < target_size and frontier:
        p = frontier.pop(random.randrange(len(frontier)))
        u, v = p
        for q in random.sample([(u - 1, v), (u + 1, v), (u, v - 1), (u, v + 1)], 4):
            if q in interior_set and q not in blob:
                blob.add(q)
                frontier.append(q)
                if len(blob) >= target_size:
                    break
    return blob


def _mover_candidate_ok(grid, fill_zone, r, c, rad):
    h, w = grid.shape
    if int(grid[r, c]) != int(get_bg(grid)):
        return False
    if fill_zone[r, c]:
        return False
    dist = _distance_to_edge(r, c, rad, h, w)
    if dist < 2:
        return False
    (nr, nc), steps = _halfway_destination(r, c, rad, h, w)
    if steps <= 0 or fill_zone[nr, nc]:
        return False
    for k in range(1, steps + 1):
        rr = r + rad[0] * k
        cc = c + rad[1] * k
        if fill_zone[rr, cc] or int(grid[rr, cc]) != int(get_bg(grid)):
            return False
    return True


def _place_movers(grid, fill_zone, mover_color, rad):
    h, w = grid.shape
    bg = get_bg(grid)
    candidates = []
    for r in range(h):
        for c in range(w):
            if _mover_candidate_ok(grid, fill_zone, r, c, rad):
                candidates.append((r, c))
    random.shuffle(candidates)

    target = random.randint(*MOVER_COUNT)
    placed = []
    used_dest = set()
    used_axis = set()
    for r, c in candidates:
        (nr, nc), _steps = _halfway_destination(r, c, rad, h, w)
        axis_key = c if rad[0] != 0 else r
        if axis_key in used_axis:
            continue
        if (nr, nc) in used_dest:
            continue
        if any(max(abs(r - rr), abs(c - cc)) < MOVER_MIN_SEP for rr, cc in placed):
            continue
        placed.append((r, c))
        used_dest.add((nr, nc))
        used_axis.add(axis_key)
        if len(placed) >= target:
            break

    if len(placed) < 2:
        return False

    for r, c in placed:
        assert int(grid[r, c]) == int(bg)
        grid[r, c] = mover_color
    return True


def _variant_metrics(inp: np.ndarray, out: np.ndarray) -> dict:
    info = _scene_info(inp)
    fill = info["fill"]
    endpoints = info["endpoints"]
    rad = info["rad"]
    ray_len = len(info["fill_pos"])
    opening_edge = _opening_edge_distance(endpoints, rad, *inp.shape)
    new_fill = (out == fill) & (inp == info["bg"])
    outward_depths = [
        _outward_depth(int(r), int(c), endpoints, rad)
        for r, c in np.argwhere(new_fill)
        if _outward_depth(int(r), int(c), endpoints, rad) > 0
    ]
    max_depth = max(outward_depths) if outward_depths else 0

    extra_mask = (inp != info["bg"]) & (inp != fill) & (inp != info["wall"])
    mover_steps = []
    for pts in components_mask(extra_mask, connectivity=8):
        if len(pts) != 1:
            continue
        r, c = map(int, pts[0])
        color = int(inp[r, c])
        outs = [(int(rr), int(cc)) for rr, cc in zip(*np.where(out == color))]
        best = None
        for rr, cc in outs:
            if (rr, cc) == (r, c):
                continue
            delta = (rr - r, cc - c)
            if rad[0] != 0 and delta[1] == 0 and _sgn(delta[0]) == rad[0]:
                dist = abs(delta[0])
            elif rad[1] != 0 and delta[0] == 0 and _sgn(delta[1]) == rad[1]:
                dist = abs(delta[1])
            else:
                continue
            if best is None or dist < best:
                best = dist
        if best is not None:
            mover_steps.append((r, c, best, _distance_to_edge(r, c, rad, *inp.shape)))

    return {
        "ray_len": ray_len,
        "opening_edge": opening_edge,
        "max_depth": max_depth,
        "mover_steps": mover_steps,
    }


def _gen_attempt():
    rad = random.choice([(-1, 0), (1, 0), (0, -1), (0, 1)])
    h = random.randint(*GRID_H_VERT) if rad[0] else random.randint(*GRID_H_HORIZ)
    w = random.randint(*GRID_W)

    built = _build_local_wall(rad, h, w)
    if built is None:
        return None
    local_wall, depth, gap = built
    anchor = _place_anchor(rad, h, w, depth, gap)
    if anchor is None:
        return None

    palette = random.sample(range(10), 4)
    bg, wall_color, fill_color, mover_color = palette

    grid = np.full((h, w), bg, dtype=int)
    for u, v in local_wall:
        r, c = _map_local(u, v, rad, anchor)
        grid[r, c] = wall_color

    interior = _local_interior(local_wall, depth, gap)
    wall_set = set(local_wall)
    adjacent = [
        p
        for p in interior
        if any((p[0] + dr, p[1] + dc) in wall_set for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)])
    ]
    seed_pool = [p for p in adjacent if p[0] >= max(1, depth - SEED_DEPTH_LOOKBACK)]
    if not seed_pool:
        return None

    blob = _grow_seed_blob(random.choice(seed_pool), set(interior))
    if len(blob) < 2:
        return None
    for u, v in blob:
        r, c = _map_local(u, v, rad, anchor)
        if grid[r, c] != bg:
            return None
        grid[r, c] = fill_color

    try:
        nominal_out = main(grid)
    except Exception:
        return None

    metrics = _variant_metrics(grid, nominal_out)
    new_fill = (nominal_out == fill_color) & (grid == bg)
    if int(new_fill.sum()) < MIN_NEW_FILL:
        return None
    if metrics["ray_len"] < 2:
        return None
    if metrics["max_depth"] != metrics["ray_len"]:
        return None
    if metrics["opening_edge"] <= metrics["ray_len"] + 1:
        return None

    fill_zone = nominal_out == fill_color
    if not _place_movers(grid, fill_zone, mover_color, rad):
        return None

    try:
        out = main(grid)
    except Exception:
        return None

    metrics = _variant_metrics(grid, out)
    if metrics["max_depth"] != metrics["ray_len"]:
        return None
    if metrics["opening_edge"] <= metrics["ray_len"] + 1:
        return None
    if len(metrics["mover_steps"]) < 2:
        return None
    for _r, _c, moved, dist in metrics["mover_steps"]:
        if moved != dist // 2:
            return None
        if dist < 2 or moved <= 0:
            return None
        if moved >= dist:
            return None

    return grid


def generate_input() -> np.ndarray:
    for _ in range(GEN_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid fused b9e38dc0 input")

