+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Drop detached singleton pixels downward first, then fill a funnel pocket and radiate through its opening.
+
+    Input structure:
+    - The background is the dominant color. The wall is the most frequent non-background color and forms one open funnel/U shape.
