+# Combo variant of b9e38dc0 (index 13)
+# combo_spec: D2/3+D10/0
+# Name: 重力下落+先移后填
+
+import random
+
+import numpy as np
+
+from arc_utils import components_mask, get_bg, neighbors4, neighbors8
+
+
+# ---------------------------------------------------------------------------
+# Design analysis for the combo variant
+#
+# a) Concrete behavior and traced example:
+#    - Base task geometry is still one funnel/U wall, one fill-colored seed blob
+#      near the closed end, and a background region that later floods through the
+#      opening and radiates outward inside the two endpoint rays.
+#    - The new object family is explicit singleton movers: every non-bg, non-wall,
+#      non-fill 8-component of size 1 is a falling pixel.
+#    - Small trace:
+#      old base code:
+#        1. treat extra colors as static obstacles
+#        2. fill the pocket and exterior wedge
+#        3. erase shadowed fill behind those static obstacles
+#      fused combo:
+#        1. detect singleton movers
+#        2. drop each mover straight down under gravity, leaving bg behind
+#        3. with those new obstacle positions fixed, run the original fill+radiate
+#           stage and then the same shadow trimming
+#      difference:
+#        a mover that starts above the future wedge is no longer blocked by future
+#        fill, because it falls first; after landing, that same mover can now sit
+#        inside the later radiated corridor and carve a different hole/shadow.
+#
+# b) Complexity calibration:
+#    - Only one new motion rule is introduced: all singleton movers fall downward.
+#      The radiate direction still varies over four cardinal cases, so examples
+#      visibly separate "gravity axis" from "opening axis".
+#    - The generator uses 2-4 movers but a single mover color. That is enough
+#      repetition for humans to recognize a class of falling pixels without
+#      cluttering the grid or turning the task into color bookkeeping.
+#
+# c) Hidden-assumption audit against the provided solver:
+#    - The original code assumed all extra colors are static blockers during fill.
+#      That is false now, so obstacle extraction is split into two stages:
+#      singleton extras move first, then the moved grid supplies blockers.
+#    - Fill-color inference by "closest non-wall color to the wall" still works
+#      only if movers stay farther from the wall than the seed blob. The generator
+#      enforces 8-neighbor clearance from non-bg structure for mover start cells.
+#    - The original flood starts from the seed positions and assumes the wall is
+#      unchanged. That still holds, because only singleton extras move.
+#    - The original shadow pass scans the final moved grid, so landed movers can
+#      block later radiation exactly where they end up.
+#
+# d) Placement legality:
+#    - Wall construction and seed placement stay within the original numeric bounds.
+#    - Movers are placed only on bg cells, one per column, with 8-neighbor spacing,
+#      so they remain singleton components and their vertical gravity paths do not
+#      interfere with each other.
+#    - Candidate movers are rejected unless they drop at least two cells and remain
+#      in-bounds the whole time.
+#
+# e) Visual observability:
+#    - Across examples, the wall still identifies the radiate direction, while the
+#      extra dots always move downward regardless of the opening direction. That
+#      contrast is directly visible.
+#    - The generator forces at least one mover to land in the future outward fill
+#      zone, so examples show not just motion but also the second-stage interaction:
+#      the later beam is visibly interrupted by the fallen dot(s).
+#
+# f) Visual cleanliness:
+#    - Semantic layers stay separated: wall and seed define the funnel, movers are
+#      sparse detached dots, and the output adds only fill of the existing seed
+#      color. No legends or additional textures are introduced.
+#
+# g) Inferability of changes:
+#    - No rule depends on numeric color ids. Movers are recognized by shape
+#      (singleton extras) and by their shared downward displacement. The changed
+#      fill is supported by geometry: the same fallen pixels later sit inside the
+#      wedge and interrupt it.
+#
+# h) Fusion metric used after implementation:
+#    - `moved_count`: how many singleton movers actually drop.
+#    - `blocked_radiation_cells`: how many cells belong to the no-mover radiated
+#      region but are not fill in the combo output.
+#    - `order_diff`: Hamming distance between the combo output and a baseline that
+#      fills first and only then applies the same gravity. Nonzero `order_diff`
+#      proves the sample does not collapse back to the old step order.
+#
+# i) New solver assumptions and generator guarantees:
+#    - Only singleton extra components move: generator places movers as isolated
+#      dots and does not create multi-cell extra components.
+#    - Mover columns are unique, so sequential bottom-up gravity exactly matches
+#      simultaneous falling for these samples.
+#    - At least one moved destination lies in the outward fill corridor, and the
+#      combo output differs from the fill-first baseline: both are enforced during
+#      generation, so the fused behavior is always present in produced samples.
+# ---------------------------------------------------------------------------
+
+
+# Canvas size bounds
+GRID_H_VERT = (12, 18)
+GRID_H_HORIZ = (10, 18)
+GRID_W = (15, 19)
+
+# Wall geometry
+WALL_PIXELS_MIN = 17
+WALL_PIXELS_MAX = 25
+DEPTH_VERT = (5, 10)
+DEPTH_HORIZ = (6, 8)
+GAP_VERT = (6, 7)
+GAP_HORIZ = (5, 7)
+TIP_12_PROB = 0.5
+
+# Placement margins
+OPEN_END_MARGIN = 4
+
+# Fill seed
+SEED_SIZE_WEIGHTS = [1, 1, 2, 2, 3, 3, 4, 5]
+SEED_DEPTH_LOOKBACK = 3
+
+# Movers
+MOVER_COUNT = (2, 4)
+MOVER_MIN_GAP = 2
+MIN_MOVER_DROP = 2
+
+# Validation
+MIN_NEW_FILL = 16
+MIN_ORDER_DIFF = 2
+GEN_RETRIES = 500
+
+
+def _sgn(x: int) -> int:
+    return (x > 0) - (x < 0)
+
+
+def _touches_border(mask: np.ndarray) -> bool:
+    return bool(mask[0, :].any() or mask[-1, :].any() or mask[:, 0].any() or mask[:, -1].any())
+
+
+def _degree1_pixels(points: set[tuple[int, int]]) -> list[tuple[int, int]]:
+    pts = set(points)
+    return [
+        (r, c)
+        for r, c in pts
+        if sum((rr, cc) in pts for rr, cc in neighbors8(r, c)) == 1
+    ]
+
+
+def _make_arm(depth: int, start_v: int, target_v: int, extra_steps: int, tip_12: bool = False) -> list[tuple[int, int]]:
+    sign = 1 if target_v > start_v else -1
+    n_side_steps = abs(target_v - start_v)
+    chosen_rows: list[int] = []
+    if n_side_steps:
+        if tip_12:
+            chosen_rows = [2 * (i + 1) for i in range(n_side_steps)]
+            extra_steps = 0
+        else:
+            chosen_rows = [1]
+            if n_side_steps > 1:
+                chosen_rows += random.sample(range(2, depth + 1), n_side_steps - 1)
+            chosen_rows.sort()
+
+    first_row = chosen_rows[0] if chosen_rows else 1
+    extra_rows = [r for r in chosen_rows if r != first_row]
+    random.shuffle(extra_rows)
+    orthogonal_rows = set(extra_rows[:extra_steps])
+
+    pts = [(0, start_v)]
+    u, v = 0, start_v
+    for row in range(1, depth + 1):
+        u += 1
+        if row in orthogonal_rows:
+            pts.append((u, v))
+            v += sign
+        elif row in chosen_rows:
+            v += sign
+        pts.append((u, v))
+    return pts
+
+
+def _build_local_wall(rad: tuple[int, int], h: int, w: int):
+    if rad[0]:
+        max_depth = min(DEPTH_VERT[1], h - 6)
+        if max_depth < DEPTH_VERT[0]:
+            return None
+        depth = random.randint(DEPTH_VERT[0], max_depth)
+        gap = random.randint(*GAP_VERT)
+    else:
+        depth = random.randint(DEPTH_HORIZ[0], min(DEPTH_HORIZ[1], w - 6))
+        gap = random.randint(GAP_HORIZ[0], min(GAP_HORIZ[1], h - 1))
+
+    if gap == 5:
+        left_bottom, right_bottom = 2, 3
+    elif gap == 6:
+        left_bottom, right_bottom = 2, 4
+    else:
+        left_bottom, right_bottom = random.choice([(2, 5), (3, 4)])
+
+    bridge_extra = max(0, right_bottom - left_bottom - 1)
+    base_count = 2 * (depth + 1) + bridge_extra
+    max_extra_l = max(0, left_bottom - 1)
+    max_extra_r = max(0, gap - right_bottom - 1)
+    min_extra = max(0, WALL_PIXELS_MIN - base_count)
+    max_extra = min(max_extra_l + max_extra_r, WALL_PIXELS_MAX - base_count)
+    if min_extra > max_extra:
+        return None
+
+    extra = random.randint(min_extra, max_extra)
+    extra_l = random.randint(max(0, extra - max_extra_r), min(max_extra_l, extra))
+    extra_r = extra - extra_l
+
+    max_n_side = max(left_bottom, gap - right_bottom)
+    tip_12 = depth >= 2 * max_n_side and random.random() < TIP_12_PROB
+    left = _make_arm(depth, 0, left_bottom, extra_l, tip_12=tip_12)
+    right = _make_arm(depth, gap, right_bottom, extra_r, tip_12=tip_12)
+    pts = set(left) | set(right)
+    for v in range(left_bottom, right_bottom + 1):
+        pts.add((depth, v))
+
+    while len(pts) < WALL_PIXELS_MIN:
+        candidates = [
+            (u, v)
+            for u in range(max(0, depth - 3), depth + 1)
+            for v in range(gap + 1)
+            if (u, v) not in pts
+            and sum(
+                (uu, vv) in pts
+                for uu in range(u - 1, u + 2)
+                for vv in range(v - 1, v + 2)
+                if (uu, vv) != (u, v)
+            ) >= 2
+        ]
+        random.shuffle(candidates)
+        added = False
+        for p in candidates:
+            trial = pts | {p}
+            if len(trial) <= WALL_PIXELS_MAX and len(_degree1_pixels(trial)) == 2:
+                pts = trial
+                added = True
+                break
+        if not added:
+            return None
+
+    if not (WALL_PIXELS_MIN <= len(pts) <= WALL_PIXELS_MAX) or len(_degree1_pixels(pts)) != 2:
+        return None
+    return pts, depth, gap
+
+
+def _map_local(u: int, v: int, rad: tuple[int, int], anchor: tuple[int, int]) -> tuple[int, int]:
+    r0, c0 = anchor
+    if rad == (-1, 0):
+        return r0 + u, c0 + v
+    if rad == (1, 0):
+        return r0 - u, c0 + v
+    if rad == (0, -1):
+        return r0 + v, c0 + u
+    return r0 + v, c0 - u
+
+
+def _place_anchor(rad: tuple[int, int], h: int, w: int, depth: int, gap: int):
+    if rad == (-1, 0):
+        r_lo, r_hi = OPEN_END_MARGIN, h - depth - 3
+        c_lo, c_hi = 0, w - gap - 1
+    elif rad == (1, 0):
+        r_lo, r_hi = depth + 2, h - OPEN_END_MARGIN - 1
+        c_lo, c_hi = 0, w - gap - 1
+    elif rad == (0, -1):
+        r_lo, r_hi = 0, h - gap - 1
+        c_lo, c_hi = OPEN_END_MARGIN, w - depth - 3
+    else:
+        r_lo, r_hi = 0, h - gap - 1
+        c_lo, c_hi = depth + 2, w - OPEN_END_MARGIN - 1
+    if r_lo > r_hi or c_lo > c_hi:
+        return None
+    return random.randint(r_lo, r_hi), random.randint(c_lo, c_hi)
+
+
+def _local_interior(wall: set[tuple[int, int]], depth: int, gap: int) -> list[tuple[int, int]]:
+    by_row: dict[int, list[int]] = {}
+    for u, v in wall:
+        by_row.setdefault(u, []).append(v)
+    interior = []
+    for u in range(1, depth):
+        if u not in by_row or len(by_row[u]) < 2:
+            continue
+        lo, hi = min(by_row[u]), max(by_row[u])
+        for v in range(lo + 1, hi):
+            if (u, v) not in wall:
+                interior.append((u, v))
+    return interior
+
+
+def _grow_seed_blob(seed: tuple[int, int], interior_set: set[tuple[int, int]]) -> set[tuple[int, int]]:
+    blob = {seed}
+    target_size = random.choice(SEED_SIZE_WEIGHTS)
+    frontier = [seed]
+    while len(blob) < target_size and frontier:
+        u, v = frontier.pop(random.randrange(len(frontier)))
+        for q in random.sample([(u - 1, v), (u + 1, v), (u, v - 1), (u, v + 1)], 4):
+            if q in interior_set and q not in blob:
+                blob.add(q)
+                frontier.append(q)
+                if len(blob) >= target_size:
+                    break
+    return blob
+
+
+def _scene_info(grid: np.ndarray) -> dict:
+    g = np.array(grid, copy=True)
+    h, w = g.shape
+    vals = np.unique(g)
+    bg = get_bg(g)
+    non_bg = [int(v) for v in vals if int(v) != bg]
+    assert non_bg, "expected at least one non-background color"
+
+    wall = max(non_bg, key=lambda c: int((g == c).sum()))
+    wall_mask = g == wall
+    comps = [set((int(r), int(c)) for r, c in pts) for pts in components_mask(wall_mask, connectivity=8)]
+    assert comps, "expected at least one wall connected component"
+
+    other_colors = [c for c in non_bg if c != wall]
+    assert other_colors, "expected at least one non-wall color"
+    wall_points = [p for comp in comps for p in comp]
+
+    def min_dist_to_wall(color: int) -> tuple[int, int]:
+        pts = [(int(r), int(c)) for r, c in zip(*np.where(g == color))]
+        best_d = 10**9
+        for r, c in pts:
+            for wr, wc in wall_points:
+                d = abs(r - wr) + abs(c - wc)
+                if d < best_d:
+                    best_d = d
+                    if best_d == 0:
+                        return 0, len(pts)
+        return best_d, len(pts)
+
+    fill = min(other_colors, key=lambda c: (min_dist_to_wall(c)[0], min_dist_to_wall(c)[1]))
+    fill_pos = [(int(r), int(c)) for r, c in zip(*np.where(g == fill))]
+    assert fill_pos, "expected at least one fill seed pixel"
+
+    def comp_min_dist(comp: set[tuple[int, int]]) -> int:
+        best_d = 10**9
+        for r, c in fill_pos:
+            for wr, wc in comp:
+                d = abs(r - wr) + abs(c - wc)
+                if d < best_d:
+                    best_d = d
+                    if best_d == 0:
+                        return 0
+        return best_d
+
+    wall_comp = min(comps, key=lambda comp: (comp_min_dist(comp), -len(comp)))
+    comp_mask = np.zeros_like(wall_mask, dtype=bool)
+    for r, c in wall_comp:
+        comp_mask[r, c] = True
+
+    def comp_neighbors(r: int, c: int) -> list[tuple[int, int]]:
+        out = []
+        for rr, cc in neighbors8(r, c):
+            if 0 <= rr < h and 0 <= cc < w and comp_mask[rr, cc]:
+                out.append((rr, cc))
+        return out
+
+    endpoints = [(r, c) for r, c in wall_comp if len(comp_neighbors(r, c)) == 1]
+    assert endpoints, "expected wall component endpoints"
+
+    def outward_dir(ep: tuple[int, int]) -> tuple[tuple[int, int], bool]:
+        n1 = comp_neighbors(*ep)[0]
+        d1 = (_sgn(n1[0] - ep[0]), _sgn(n1[1] - ep[1]))
+        d_use = d1
+        is_12 = False
+        n2s = [p for p in comp_neighbors(*n1) if p != ep]
+        if n2s:
+            n2 = n2s[0]
+            d2 = (_sgn(n2[0] - n1[0]), _sgn(n2[1] - n1[1]))
+            if (d1[0] == 0) ^ (d1[1] == 0) and d2[0] != 0 and d2[1] != 0:
+                d_use = d2
+                is_12 = True
+        return (-d_use[0], -d_use[1]), is_12
+
+    out_info = [outward_dir(ep) for ep in endpoints]
+    out_dirs = [d for d, _ in out_info]
+    tip_12 = [flag for _, flag in out_info]
+    rad = (_sgn(sum(d[0] for d in out_dirs)), _sgn(sum(d[1] for d in out_dirs)))
+    assert rad != (0, 0), "expected non-zero radiate direction"
+
+    return {
+        "bg": bg,
+        "wall": wall,
+        "fill": fill,
+        "fill_pos": fill_pos,
+        "wall_comp": wall_comp,
+        "comp_mask": comp_mask,
+        "endpoints": endpoints,
+        "out_dirs": out_dirs,
+        "tip_12": tip_12,
+        "rad": rad,
+    }
+
+
+def _outward_depth(r: int, c: int, endpoints: list[tuple[int, int]], rad: tuple[int, int]) -> int:
+    if rad == (1, 0):
+        return r - max(rr for rr, _ in endpoints)
+    if rad == (-1, 0):
+        return min(rr for rr, _ in endpoints) - r
+    if rad == (0, 1):
+        return c - max(cc for _, cc in endpoints)
+    if rad == (0, -1):
+        return min(cc for _, cc in endpoints) - c
+    return 0
+
+
+def _radiate_barrier(
+    shape: tuple[int, int],
+    comp_mask: np.ndarray,
+    endpoints: list[tuple[int, int]],
+    out_dirs: list[tuple[int, int]],
+    tip_12: list[bool],
+    rad: tuple[int, int],
+) -> np.ndarray:
+    h, w = shape
+    barrier = comp_mask.copy()
+
+    def add_ray(start: tuple[int, int], d: tuple[int, int]) -> None:
+        rr, cc = start
+        while True:
+            rr += d[0]
+            cc += d[1]
+            if not (0 <= rr < h and 0 <= cc < w):
+                break
+            barrier[rr, cc] = True
+
+    def add_ray_12(start: tuple[int, int], d: tuple[int, int]) -> None:
+        rr, cc = start
+        step = 0
+        while True:
+            step += 1
+            if step % 2 == 1:
+                rr += d[0]
+                cc += d[1]
+            else:
+                if rad[0] != 0:
+                    rr += d[0]
+                else:
+                    cc += d[1]
+            if not (0 <= rr < h and 0 <= cc < w):
+                break
+            barrier[rr, cc] = True
+
+    for ep, d, is_12 in zip(endpoints, out_dirs, tip_12):
+        if is_12:
+            add_ray_12(ep, d)
+        else:
+            add_ray(ep, d)
+    return barrier
+
+
+def _extra_mask(grid: np.ndarray, info: dict) -> np.ndarray:
+    return (grid != info["bg"]) & (grid != info["wall"]) & (grid != info["fill"])
+
+
+def _extract_singleton_movers(grid: np.ndarray, info: dict) -> list[tuple[int, int, int]]:
+    movers = []
+    for pts in components_mask(_extra_mask(grid, info), connectivity=8):
+        if len(pts) == 1:
+            r, c = map(int, pts[0])
+            movers.append((r, c, int(grid[r, c])))
+    return movers
+
+
+def _apply_gravity(grid: np.ndarray, info: dict) -> tuple[np.ndarray, list[tuple[int, int, int, int, int]]]:
+    g = np.array(grid, copy=True)
+    bg = info["bg"]
+    movers = sorted(_extract_singleton_movers(g, info), key=lambda x: (-x[0], x[1]))
+    records: list[tuple[int, int, int, int, int]] = []
+
+    for r, c, color in movers:
+        if int(g[r, c]) != color:
+            continue
+        g[r, c] = bg
+        rr = r
+        while rr + 1 < g.shape[0] and int(g[rr + 1, c]) == bg:
+            rr += 1
+        g[rr, c] = color
+        records.append((r, c, int(rr), int(c), int(rr - r)))
+    return g, records
+
+
+def _fill_stage(grid: np.ndarray, info: dict) -> tuple[np.ndarray, np.ndarray]:
+    g = np.array(grid, copy=True)
+    h, w = g.shape
+    bg = info["bg"]
+    wall = info["wall"]
+    fill = info["fill"]
+    fill_pos = info["fill_pos"]
+
+    barrier = _radiate_barrier((h, w), info["comp_mask"], info["endpoints"], info["out_dirs"], info["tip_12"], info["rad"])
+    passable = (~barrier) & ((g == bg) | (g == fill))
+
+    q = fill_pos[:]
+    seen = np.zeros_like(passable, dtype=bool)
+    for r, c in q:
+        if passable[r, c]:
+            seen[r, c] = True
+    while q:
+        r, c = q.pop()
+        for rr, cc in neighbors4(r, c):
+            if 0 <= rr < h and 0 <= cc < w and passable[rr, cc] and not seen[rr, cc]:
+                seen[rr, cc] = True
+                q.append((rr, cc))
+
+    filled_mask = seen & (g == bg)
+    out = g.copy()
+    out[filled_mask] = fill
+
+    obstacles = (g != bg) & (g != fill) & (g != wall)
+
+    def shadow_process(coords: list[tuple[int, int]]) -> None:
+        started = False
+        blocked = False
+        for r, c in coords:
+            if filled_mask[r, c]:
+                started = True
+            if started and obstacles[r, c]:
+                blocked = True
+                continue
+            if blocked and filled_mask[r, c]:
+                out[r, c] = bg
+                filled_mask[r, c] = False
+
+    rad = info["rad"]
+    dr, dc = rad
+    if dr != 0 and dc == 0:
+        for c in range(w):
+            rows = range(h) if dr > 0 else range(h - 1, -1, -1)
+            shadow_process([(r, c) for r in rows])
+    elif dc != 0 and dr == 0:
+        for r in range(h):
+            cols = range(w) if dc > 0 else range(w - 1, -1, -1)
+            shadow_process([(r, c) for c in cols])
+    else:
+        if dr == dc:
+            for k in range(-(w - 1), h):
+                coords = [(r, r - k) for r in range(h) if 0 <= r - k < w]
+                coords.sort(key=lambda rc: rc[0], reverse=(dr < 0))
+                shadow_process(coords)
+        else:
+            for k in range(h + w - 1):
+                coords = [(r, k - r) for r in range(h) if 0 <= k - r < w]
+                coords.sort(key=lambda rc: rc[0], reverse=(dr < 0))
+                shadow_process(coords)
+    return out, filled_mask
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Drop detached singleton pixels downward first, then fill a funnel pocket and radiate through its opening.
+
+    Input structure:
+    - The background is the dominant color. The wall is the most frequent non-background color and forms one open funnel/U shape.
+    - A compact seed blob in another color sits inside that wall near the closed end. Any remaining isolated extra pixels are falling movers, not static blockers.
+
+    Rule:
+    - First move every isolated extra pixel straight downward under gravity until it reaches the bottom or lands on an occupied cell, leaving background behind.
+    - Then use the unchanged wall endpoints to infer the opening direction, flood the reachable interior and outward wedge with the seed color, and apply the usual obstacle-shadow rule using the movers' new landed positions.
+
+    Key insight:
+    - The wall still determines the fill geometry, but the singleton extras no longer describe fixed obstacle locations. They must be settled under a separate global gravity rule before the fill stage, and those landed cells can then interrupt the later radiation.
+    """
+    g = np.array(grid, copy=True)
+    info = _scene_info(g)
+    moved, _records = _apply_gravity(g, info)
+    out, _filled = _fill_stage(moved, info)
+    return out
+
+
+def _drop_destination(grid: np.ndarray, r: int, c: int) -> tuple[int, int] | None:
+    if int(grid[r, c]) != int(get_bg(grid)):
+        return None
+    rr = r
+    while rr + 1 < grid.shape[0] and int(grid[rr + 1, c]) == int(get_bg(grid)):
+        rr += 1
+    if rr == r:
+        return None
+    return int(rr), int(c)
+
+
+def _bg_is_isolated(grid: np.ndarray, r: int, c: int) -> bool:
+    if int(grid[r, c]) != int(get_bg(grid)):
+        return False
+    h, w = grid.shape
+    for rr, cc in neighbors8(r, c):
+        if 0 <= rr < h and 0 <= cc < w and int(grid[rr, cc]) != int(get_bg(grid)):
+            return False
+    return True
+
+
+def _mover_candidates(
+    base_grid: np.ndarray,
+    info: dict,
+    nominal_out: np.ndarray,
+) -> tuple[list[tuple[int, int, int]], list[tuple[int, int, int]]]:
+    h, w = base_grid.shape
+    fill = info["fill"]
+    bg = info["bg"]
+    nominal_fill = (nominal_out == fill) & (base_grid == bg)
+    radiated_zone = np.zeros_like(nominal_fill, dtype=bool)
+    for r, c in np.argwhere(nominal_fill):
+        if _outward_depth(int(r), int(c), info["endpoints"], info["rad"]) > 0:
+            radiated_zone[int(r), int(c)] = True
+
+    blockers: list[tuple[int, int, int]] = []
+    others: list[tuple[int, int, int]] = []
+    for r in range(h):
+        for c in range(w):
+            if not _bg_is_isolated(base_grid, r, c):
+                continue
+            if nominal_fill[r, c]:
+                continue
+            dest = _drop_destination(base_grid, r, c)
+            if dest is None:
+                continue
+            rr, _cc = dest
+            if rr - r < MIN_MOVER_DROP:
+                continue
+            if radiated_zone[rr, c]:
+                blockers.append((r, c, rr))
+            elif not nominal_fill[rr, c]:
+                others.append((r, c, rr))
+    random.shuffle(blockers)
+    random.shuffle(others)
+    return blockers, others
+
+
+def _place_movers(base_grid: np.ndarray, info: dict, mover_color: int, nominal_out: np.ndarray) -> bool:
+    blockers, others = _mover_candidates(base_grid, info, nominal_out)
+    if not blockers:
+        return False
+
+    target = random.randint(*MOVER_COUNT)
+    chosen: list[tuple[int, int, int]] = []
+    used_cols: set[int] = set()
+
+    def try_add(pool: list[tuple[int, int, int]], limit: int) -> None:
+        for r, c, rr in pool:
+            if len(chosen) >= limit:
+                break
+            if c in used_cols:
+                continue
+            if any(max(abs(r - r0), abs(c - c0)) < MOVER_MIN_GAP for r0, c0, _rr0 in chosen):
+                continue
+            chosen.append((r, c, rr))
+            used_cols.add(c)
+
+    try_add(blockers, 1)
+    if not chosen:
+        return False
+    try_add(others, target)
+    if len(chosen) < 2:
+        try_add(blockers, target)
+    if len(chosen) < 2:
+        return False
+
+    for r, c, _rr in chosen:
+        assert int(base_grid[r, c]) == int(info["bg"])
+        base_grid[r, c] = mover_color
+    return True
+
+
+def _variant_metrics(inp: np.ndarray) -> dict:
+    info = _scene_info(inp)
+
+    moved_grid, move_records = _apply_gravity(inp, info)
+    combo_out, _combo_mask = _fill_stage(moved_grid, info)
+
+    fill_first_out, _fill_first_mask = _fill_stage(inp, info)
+    baseline_out, _baseline_records = _apply_gravity(fill_first_out, info)
+
+    no_mover = np.array(inp, copy=True)
+    no_mover[_extra_mask(inp, info)] = info["bg"]
+    no_mover_out, _nomask = _fill_stage(no_mover, info)
+
+    nominal_radiated = np.zeros_like(inp, dtype=bool)
+    for r, c in np.argwhere((no_mover_out == info["fill"]) & (no_mover == info["bg"])):
+        if _outward_depth(int(r), int(c), info["endpoints"], info["rad"]) > 0:
+            nominal_radiated[int(r), int(c)] = True
+
+    blocking_movers = 0
+    for _r, c, rr, _cc, steps in move_records:
+        if steps > 0 and nominal_radiated[rr, c]:
+            blocking_movers += 1
+
+    combo_new_fill = (combo_out == info["fill"]) & (inp == info["bg"])
+    return {
+        "moved_count": sum(1 for _r, _c, _rr, _cc, steps in move_records if steps > 0),
+        "max_drop": max([steps for _r, _c, _rr, _cc, steps in move_records] or [0]),
+        "blocking_movers": blocking_movers,
+        "blocked_radiation_cells": int(np.sum(nominal_radiated & (combo_out != info["fill"]))),
+        "order_diff": int(np.sum(combo_out != baseline_out)),
+        "new_fill": int(combo_new_fill.sum()),
+        "touches_border": _touches_border(combo_new_fill),
+    }
+
+
+def _gen_attempt():
+    rad = random.choice([(-1, 0), (1, 0), (0, -1), (0, 1)])
+    h = random.randint(*GRID_H_VERT) if rad[0] else random.randint(*GRID_H_HORIZ)
+    w = random.randint(*GRID_W)
+
+    built = _build_local_wall(rad, h, w)
+    if built is None:
+        return None
+    local_wall, depth, gap = built
+    anchor = _place_anchor(rad, h, w, depth, gap)
+    if anchor is None:
+        return None
+
+    bg, wall_color, fill_color, mover_color = random.sample(range(10), 4)
+    grid = np.full((h, w), bg, dtype=int)
+    for u, v in local_wall:
+        r, c = _map_local(u, v, rad, anchor)
+        grid[r, c] = wall_color
+
+    interior = _local_interior(local_wall, depth, gap)
+    wall_set = set(local_wall)
+    adjacent = [
+        p
+        for p in interior
+        if any((p[0] + dr, p[1] + dc) in wall_set for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)])
+    ]
+    seed_pool = [p for p in adjacent if p[0] >= max(1, depth - SEED_DEPTH_LOOKBACK)]
+    if not seed_pool:
+        return None
+
+    blob = _grow_seed_blob(random.choice(seed_pool), set(interior))
+    for u, v in blob:
+        r, c = _map_local(u, v, rad, anchor)
+        if int(grid[r, c]) != bg:
+            return None
+        grid[r, c] = fill_color
+
+    info = _scene_info(grid)
+    nominal_out, _nominal_mask = _fill_stage(grid, info)
+    nominal_new_fill = (nominal_out == fill_color) & (grid == bg)
+    if int(nominal_new_fill.sum()) < MIN_NEW_FILL or not _touches_border(nominal_new_fill):
+        return None
+
+    if not _place_movers(grid, info, mover_color, nominal_out):
+        return None
+
+    try:
+        out = main(grid)
+    except Exception:
+        return None
+
+    metrics = _variant_metrics(grid)
+    if metrics["moved_count"] < 2:
+        return None
+    if metrics["max_drop"] < MIN_MOVER_DROP:
+        return None
+    if metrics["blocking_movers"] < 1:
+        return None
+    if metrics["blocked_radiation_cells"] <= 0:
+        return None
+    if metrics["order_diff"] < MIN_ORDER_DIFF:
+        return None
+    if metrics["new_fill"] < MIN_NEW_FILL or not metrics["touches_border"]:
+        return None
+
+    # Sanity check: direct call already succeeded; keep the output around only as validation.
+    _ = out
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate valid fused b9e38dc0 input")

diff --git a/ceshi/code_combo/b9e38dc0/13/code.py b/ceshi/code_combo/b9e38dc0/13/code.py
new file mode 100644
index 0000000000000000000000000000000000000000..e898e786a204cc27f3bae18d9959743682fafecb
--- /dev/null
+++ b/ceshi/code_combo/b9e38dc0/13/code.py
@@ -0,0 +1,782 @@
+# Combo variant of b9e38dc0 (index 13)
+# combo_spec: D2/3+D10/0
+# Name: 重力下落+先移后填
+
+import random
+
+import numpy as np
+
+from arc_utils import components_mask, get_bg, neighbors4, neighbors8
+
+
+# ---------------------------------------------------------------------------
+# Design analysis for the combo variant
+#
+# a) Concrete behavior and traced example:
+#    - Base task geometry is still one funnel/U wall, one fill-colored seed blob
+#      near the closed end, and a background region that later floods through the
+#      opening and radiates outward inside the two endpoint rays.
+#    - The new object family is explicit singleton movers: every non-bg, non-wall,
+#      non-fill 8-component of size 1 is a falling pixel.
+#    - Small trace:
+#      old base code:
+#        1. treat extra colors as static obstacles
+#        2. fill the pocket and exterior wedge
+#        3. erase shadowed fill behind those static obstacles
+#      fused combo:
+#        1. detect singleton movers
+#        2. drop each mover straight down under gravity, leaving bg behind
+#        3. with those new obstacle positions fixed, run the original fill+radiate
+#           stage and then the same shadow trimming
+#      difference:
+#        a mover that starts above the future wedge is no longer blocked by future
+#        fill, because it falls first; after landing, that same mover can now sit
+#        inside the later radiated corridor and carve a different hole/shadow.
+#
+# b) Complexity calibration:
+#    - Only one new motion rule is introduced: all singleton movers fall downward.
+#      The radiate direction still varies over four cardinal cases, so examples
+#      visibly separate "gravity axis" from "opening axis".
+#    - The generator uses 2-4 movers but a single mover color. That is enough
+#      repetition for humans to recognize a class of falling pixels without
+#      cluttering the grid or turning the task into color bookkeeping.
+#
+# c) Hidden-assumption audit against the provided solver:
+#    - The original code assumed all extra colors are static blockers during fill.
+#      That is false now, so obstacle extraction is split into two stages:
+#      singleton extras move first, then the moved grid supplies blockers.
+#    - Fill-color inference by "closest non-wall color to the wall" still works
+#      only if movers stay farther from the wall than the seed blob. The generator
+#      enforces 8-neighbor clearance from non-bg structure for mover start cells.
+#    - The original flood starts from the seed positions and assumes the wall is
+#      unchanged. That still holds, because only singleton extras move.
+#    - The original shadow pass scans the final moved grid, so landed movers can
+#      block later radiation exactly where they end up.
+#
+# d) Placement legality:
+#    - Wall construction and seed placement stay within the original numeric bounds.
+#    - Movers are placed only on bg cells, one per column, with 8-neighbor spacing,
+#      so they remain singleton components and their vertical gravity paths do not
+#      interfere with each other.
+#    - Candidate movers are rejected unless they drop at least two cells and remain
+#      in-bounds the whole time.
+#
+# e) Visual observability:
+#    - Across examples, the wall still identifies the radiate direction, while the
+#      extra dots always move downward regardless of the opening direction. That
+#      contrast is directly visible.
+#    - The generator forces at least one mover to land in the future outward fill
+#      zone, so examples show not just motion but also the second-stage interaction:
+#      the later beam is visibly interrupted by the fallen dot(s).
+#
+# f) Visual cleanliness:
+#    - Semantic layers stay separated: wall and seed define the funnel, movers are
+#      sparse detached dots, and the output adds only fill of the existing seed
+#      color. No legends or additional textures are introduced.
+#
+# g) Inferability of changes:
+#    - No rule depends on numeric color ids. Movers are recognized by shape
+#      (singleton extras) and by their shared downward displacement. The changed
+#      fill is supported by geometry: the same fallen pixels later sit inside the
+#      wedge and interrupt it.
+#
+# h) Fusion metric used after implementation:
+#    - `moved_count`: how many singleton movers actually drop.
+#    - `blocked_radiation_cells`: how many cells belong to the no-mover radiated
+#      region but are not fill in the combo output.
+#    - `order_diff`: Hamming distance between the combo output and a baseline that
+#      fills first and only then applies the same gravity. Nonzero `order_diff`
+#      proves the sample does not collapse back to the old step order.
+#
+# i) New solver assumptions and generator guarantees:
+#    - Only singleton extra components move: generator places movers as isolated
+#      dots and does not create multi-cell extra components.
+#    - Mover columns are unique, so sequential bottom-up gravity exactly matches
+#      simultaneous falling for these samples.
+#    - At least one moved destination lies in the outward fill corridor, and the
+#      combo output differs from the fill-first baseline: both are enforced during
+#      generation, so the fused behavior is always present in produced samples.
+# ---------------------------------------------------------------------------
+
+
+# Canvas size bounds
+GRID_H_VERT = (12, 18)
+GRID_H_HORIZ = (10, 18)
+GRID_W = (15, 19)
+
+# Wall geometry
+WALL_PIXELS_MIN = 17
+WALL_PIXELS_MAX = 25
+DEPTH_VERT = (5, 10)
+DEPTH_HORIZ = (6, 8)
+GAP_VERT = (6, 7)
+GAP_HORIZ = (5, 7)
+TIP_12_PROB = 0.5
+
+# Placement margins
+OPEN_END_MARGIN = 4
+
+# Fill seed
+SEED_SIZE_WEIGHTS = [1, 1, 2, 2, 3, 3, 4, 5]
+SEED_DEPTH_LOOKBACK = 3
+
+# Movers
+MOVER_COUNT = (2, 4)
+MOVER_MIN_GAP = 2
+MIN_MOVER_DROP = 2
+
+# Validation
+MIN_NEW_FILL = 16
+MIN_ORDER_DIFF = 2
+GEN_RETRIES = 500
+
+
+def _sgn(x: int) -> int:
+    return (x > 0) - (x < 0)
+
+
+def _touches_border(mask: np.ndarray) -> bool:
+    return bool(mask[0, :].any() or mask[-1, :].any() or mask[:, 0].any() or mask[:, -1].any())
+
+
+def _degree1_pixels(points: set[tuple[int, int]]) -> list[tuple[int, int]]:
+    pts = set(points)
+    return [
+        (r, c)
+        for r, c in pts
+        if sum((rr, cc) in pts for rr, cc in neighbors8(r, c)) == 1
+    ]
+
+
+def _make_arm(depth: int, start_v: int, target_v: int, extra_steps: int, tip_12: bool = False) -> list[tuple[int, int]]:
+    sign = 1 if target_v > start_v else -1
+    n_side_steps = abs(target_v - start_v)
+    chosen_rows: list[int] = []
+    if n_side_steps:
+        if tip_12:
+            chosen_rows = [2 * (i + 1) for i in range(n_side_steps)]
+            extra_steps = 0
+        else:
+            chosen_rows = [1]
+            if n_side_steps > 1:
+                chosen_rows += random.sample(range(2, depth + 1), n_side_steps - 1)
+            chosen_rows.sort()
+
+    first_row = chosen_rows[0] if chosen_rows else 1
+    extra_rows = [r for r in chosen_rows if r != first_row]
+    random.shuffle(extra_rows)
+    orthogonal_rows = set(extra_rows[:extra_steps])
+
+    pts = [(0, start_v)]
+    u, v = 0, start_v
+    for row in range(1, depth + 1):
+        u += 1
+        if row in orthogonal_rows:
+            pts.append((u, v))
+            v += sign
+        elif row in chosen_rows:
+            v += sign
+        pts.append((u, v))
+    return pts
+
+
+def _build_local_wall(rad: tuple[int, int], h: int, w: int):
+    if rad[0]:
+        max_depth = min(DEPTH_VERT[1], h - 6)
+        if max_depth < DEPTH_VERT[0]:
+            return None
+        depth = random.randint(DEPTH_VERT[0], max_depth)
+        gap = random.randint(*GAP_VERT)
+    else:
+        depth = random.randint(DEPTH_HORIZ[0], min(DEPTH_HORIZ[1], w - 6))
+        gap = random.randint(GAP_HORIZ[0], min(GAP_HORIZ[1], h - 1))
+
+    if gap == 5:
+        left_bottom, right_bottom = 2, 3
+    elif gap == 6:
+        left_bottom, right_bottom = 2, 4
+    else:
+        left_bottom, right_bottom = random.choice([(2, 5), (3, 4)])
+
+    bridge_extra = max(0, right_bottom - left_bottom - 1)
+    base_count = 2 * (depth + 1) + bridge_extra
+    max_extra_l = max(0, left_bottom - 1)
+    max_extra_r = max(0, gap - right_bottom - 1)
+    min_extra = max(0, WALL_PIXELS_MIN - base_count)
+    max_extra = min(max_extra_l + max_extra_r, WALL_PIXELS_MAX - base_count)
+    if min_extra > max_extra:
+        return None
+
+    extra = random.randint(min_extra, max_extra)
+    extra_l = random.randint(max(0, extra - max_extra_r), min(max_extra_l, extra))
+    extra_r = extra - extra_l
+
+    max_n_side = max(left_bottom, gap - right_bottom)
+    tip_12 = depth >= 2 * max_n_side and random.random() < TIP_12_PROB
+    left = _make_arm(depth, 0, left_bottom, extra_l, tip_12=tip_12)
+    right = _make_arm(depth, gap, right_bottom, extra_r, tip_12=tip_12)
+    pts = set(left) | set(right)
+    for v in range(left_bottom, right_bottom + 1):
+        pts.add((depth, v))
+
+    while len(pts) < WALL_PIXELS_MIN:
+        candidates = [
+            (u, v)
+            for u in range(max(0, depth - 3), depth + 1)
+            for v in range(gap + 1)
+            if (u, v) not in pts
+            and sum(
+                (uu, vv) in pts
+                for uu in range(u - 1, u + 2)
+                for vv in range(v - 1, v + 2)
+                if (uu, vv) != (u, v)
+            ) >= 2
+        ]
+        random.shuffle(candidates)
+        added = False
+        for p in candidates:
+            trial = pts | {p}
+            if len(trial) <= WALL_PIXELS_MAX and len(_degree1_pixels(trial)) == 2:
+                pts = trial
+                added = True
+                break
+        if not added:
+            return None
+
+    if not (WALL_PIXELS_MIN <= len(pts) <= WALL_PIXELS_MAX) or len(_degree1_pixels(pts)) != 2:
+        return None
+    return pts, depth, gap
+
+
+def _map_local(u: int, v: int, rad: tuple[int, int], anchor: tuple[int, int]) -> tuple[int, int]:
+    r0, c0 = anchor
+    if rad == (-1, 0):
+        return r0 + u, c0 + v
+    if rad == (1, 0):
+        return r0 - u, c0 + v
+    if rad == (0, -1):
+        return r0 + v, c0 + u
+    return r0 + v, c0 - u
+
+
+def _place_anchor(rad: tuple[int, int], h: int, w: int, depth: int, gap: int):
+    if rad == (-1, 0):
+        r_lo, r_hi = OPEN_END_MARGIN, h - depth - 3
+        c_lo, c_hi = 0, w - gap - 1
+    elif rad == (1, 0):
+        r_lo, r_hi = depth + 2, h - OPEN_END_MARGIN - 1
+        c_lo, c_hi = 0, w - gap - 1
+    elif rad == (0, -1):
+        r_lo, r_hi = 0, h - gap - 1
+        c_lo, c_hi = OPEN_END_MARGIN, w - depth - 3
+    else:
+        r_lo, r_hi = 0, h - gap - 1
+        c_lo, c_hi = depth + 2, w - OPEN_END_MARGIN - 1
+    if r_lo > r_hi or c_lo > c_hi:
+        return None
+    return random.randint(r_lo, r_hi), random.randint(c_lo, c_hi)
+
+
+def _local_interior(wall: set[tuple[int, int]], depth: int, gap: int) -> list[tuple[int, int]]:
+    by_row: dict[int, list[int]] = {}
+    for u, v in wall:
+        by_row.setdefault(u, []).append(v)
+    interior = []
+    for u in range(1, depth):
+        if u not in by_row or len(by_row[u]) < 2:
+            continue
+        lo, hi = min(by_row[u]), max(by_row[u])
+        for v in range(lo + 1, hi):
+            if (u, v) not in wall:
+                interior.append((u, v))
+    return interior
+
+
+def _grow_seed_blob(seed: tuple[int, int], interior_set: set[tuple[int, int]]) -> set[tuple[int, int]]:
+    blob = {seed}
+    target_size = random.choice(SEED_SIZE_WEIGHTS)
+    frontier = [seed]
+    while len(blob) < target_size and frontier:
+        u, v = frontier.pop(random.randrange(len(frontier)))
+        for q in random.sample([(u - 1, v), (u + 1, v), (u, v - 1), (u, v + 1)], 4):
+            if q in interior_set and q not in blob:
+                blob.add(q)
+                frontier.append(q)
+                if len(blob) >= target_size:
+                    break
+    return blob
+
+
+def _scene_info(grid: np.ndarray) -> dict:
+    g = np.array(grid, copy=True)
+    h, w = g.shape
+    vals = np.unique(g)
+    bg = get_bg(g)
+    non_bg = [int(v) for v in vals if int(v) != bg]
+    assert non_bg, "expected at least one non-background color"
+
+    wall = max(non_bg, key=lambda c: int((g == c).sum()))
+    wall_mask = g == wall
+    comps = [set((int(r), int(c)) for r, c in pts) for pts in components_mask(wall_mask, connectivity=8)]
+    assert comps, "expected at least one wall connected component"
+
+    other_colors = [c for c in non_bg if c != wall]
+    assert other_colors, "expected at least one non-wall color"
+    wall_points = [p for comp in comps for p in comp]
+
+    def min_dist_to_wall(color: int) -> tuple[int, int]:
+        pts = [(int(r), int(c)) for r, c in zip(*np.where(g == color))]
+        best_d = 10**9
+        for r, c in pts:
+            for wr, wc in wall_points:
+                d = abs(r - wr) + abs(c - wc)
+                if d < best_d:
+                    best_d = d
+                    if best_d == 0:
+                        return 0, len(pts)
+        return best_d, len(pts)
+
+    fill = min(other_colors, key=lambda c: (min_dist_to_wall(c)[0], min_dist_to_wall(c)[1]))
+    fill_pos = [(int(r), int(c)) for r, c in zip(*np.where(g == fill))]
+    assert fill_pos, "expected at least one fill seed pixel"
+
+    def comp_min_dist(comp: set[tuple[int, int]]) -> int:
+        best_d = 10**9
+        for r, c in fill_pos:
+            for wr, wc in comp:
+                d = abs(r - wr) + abs(c - wc)
+                if d < best_d:
+                    best_d = d
+                    if best_d == 0:
+                        return 0
+        return best_d
+
+    wall_comp = min(comps, key=lambda comp: (comp_min_dist(comp), -len(comp)))
+    comp_mask = np.zeros_like(wall_mask, dtype=bool)
+    for r, c in wall_comp:
+        comp_mask[r, c] = True
+
+    def comp_neighbors(r: int, c: int) -> list[tuple[int, int]]:
+        out = []
+        for rr, cc in neighbors8(r, c):
+            if 0 <= rr < h and 0 <= cc < w and comp_mask[rr, cc]:
+                out.append((rr, cc))
+        return out
+
+    endpoints = [(r, c) for r, c in wall_comp if len(comp_neighbors(r, c)) == 1]
+    assert endpoints, "expected wall component endpoints"
+
+    def outward_dir(ep: tuple[int, int]) -> tuple[tuple[int, int], bool]:
+        n1 = comp_neighbors(*ep)[0]
+        d1 = (_sgn(n1[0] - ep[0]), _sgn(n1[1] - ep[1]))
+        d_use = d1
+        is_12 = False
+        n2s = [p for p in comp_neighbors(*n1) if p != ep]
+        if n2s:
+            n2 = n2s[0]
+            d2 = (_sgn(n2[0] - n1[0]), _sgn(n2[1] - n1[1]))
+            if (d1[0] == 0) ^ (d1[1] == 0) and d2[0] != 0 and d2[1] != 0:
+                d_use = d2
+                is_12 = True
+        return (-d_use[0], -d_use[1]), is_12
+
+    out_info = [outward_dir(ep) for ep in endpoints]
+    out_dirs = [d for d, _ in out_info]
+    tip_12 = [flag for _, flag in out_info]
+    rad = (_sgn(sum(d[0] for d in out_dirs)), _sgn(sum(d[1] for d in out_dirs)))
+    assert rad != (0, 0), "expected non-zero radiate direction"
+
+    return {
+        "bg": bg,
+        "wall": wall,
+        "fill": fill,
+        "fill_pos": fill_pos,
+        "wall_comp": wall_comp,
+        "comp_mask": comp_mask,
+        "endpoints": endpoints,
+        "out_dirs": out_dirs,
+        "tip_12": tip_12,
+        "rad": rad,
+    }
+
+
+def _outward_depth(r: int, c: int, endpoints: list[tuple[int, int]], rad: tuple[int, int]) -> int:
+    if rad == (1, 0):
+        return r - max(rr for rr, _ in endpoints)
+    if rad == (-1, 0):
+        return min(rr for rr, _ in endpoints) - r
+    if rad == (0, 1):
+        return c - max(cc for _, cc in endpoints)
+    if rad == (0, -1):
+        return min(cc for _, cc in endpoints) - c
+    return 0
+
+
+def _radiate_barrier(
+    shape: tuple[int, int],
+    comp_mask: np.ndarray,
+    endpoints: list[tuple[int, int]],
+    out_dirs: list[tuple[int, int]],
+    tip_12: list[bool],
+    rad: tuple[int, int],
+) -> np.ndarray:
+    h, w = shape
+    barrier = comp_mask.copy()
+
+    def add_ray(start: tuple[int, int], d: tuple[int, int]) -> None:
+        rr, cc = start
+        while True:
+            rr += d[0]
+            cc += d[1]
+            if not (0 <= rr < h and 0 <= cc < w):
+                break
+            barrier[rr, cc] = True
+
+    def add_ray_12(start: tuple[int, int], d: tuple[int, int]) -> None:
+        rr, cc = start
+        step = 0
+        while True:
+            step += 1
+            if step % 2 == 1:
+                rr += d[0]
+                cc += d[1]
+            else:
+                if rad[0] != 0:
+                    rr += d[0]
+                else:
+                    cc += d[1]
+            if not (0 <= rr < h and 0 <= cc < w):
+                break
+            barrier[rr, cc] = True
+
+    for ep, d, is_12 in zip(endpoints, out_dirs, tip_12):
+        if is_12:
+            add_ray_12(ep, d)
+        else:
+            add_ray(ep, d)
+    return barrier
+
+
