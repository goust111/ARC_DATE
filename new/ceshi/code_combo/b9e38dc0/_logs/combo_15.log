+def _wall_side_info(
+    wall_comp: set[tuple[int, int]],
+    rad: tuple[int, int],
+) -> tuple[int, int, int]:
+    if rad == (-1, 0):
+        side_value = min(r for r, _ in wall_comp)
+    elif rad == (1, 0):
+        side_value = max(r for r, _ in wall_comp)
+    elif rad == (0, -1):
+        side_value = min(c for _, c in wall_comp)
+    else:
+        side_value = max(c for _, c in wall_comp)
+
+    local_pts = {_to_local(r, c, rad, side_value) for r, c in wall_comp}
+    side_vs = sorted(v for u, v in local_pts if u == 0)
+    assert side_vs, "expected capped side on the marked face"
+    v_lo, v_hi = side_vs[0], side_vs[-1]
+    for v in range(v_lo, v_hi + 1):
+        assert (0, v) in local_pts, "expected contiguous cap on marked face"
+    return side_value, v_lo, v_hi
+
+
+def _recover_open_wall(
+    shape: tuple[int, int],
+    wall_comp: set[tuple[int, int]],
+    rad: tuple[int, int],
+    side_value: int,
+    v_lo: int,
+    v_hi: int,
+) -> tuple[np.ndarray, set[tuple[int, int]], set[tuple[int, int]]]:
+    h, w = shape
+    breach_cells = {
+        _from_local(0, v, rad, side_value)
+        for v in range(v_lo + 1, v_hi)
+    }
+    open_wall = set(wall_comp) - breach_cells
+    open_mask = np.zeros((h, w), dtype=bool)
+    for r, c in open_wall:
+        open_mask[r, c] = True
+    return open_mask, open_wall, breach_cells
+
+
+def _endpoint_radiation(
+    open_wall: set[tuple[int, int]],
+    open_mask: np.ndarray,
+) -> tuple[list[tuple[int, int]], list[tuple[int, int]], list[bool], tuple[int, int]]:
+    h, w = open_mask.shape
+
+    def comp_neighbors(r: int, c: int) -> list[tuple[int, int]]:
+        out = []
+        for rr, cc in neighbors8(r, c):
+            if 0 <= rr < h and 0 <= cc < w and open_mask[rr, cc]:
+                out.append((rr, cc))
+        return out
+
+    endpoints = [(r, c) for r, c in open_wall if len(comp_neighbors(r, c)) == 1]
+    assert len(endpoints) == 2, "expected exactly two recovered mouth endpoints"
+
+    def outward_dir(ep: tuple[int, int]) -> tuple[tuple[int, int], bool]:
+        n1 = comp_neighbors(*ep)[0]
+        d1 = (_sgn(n1[0] - ep[0]), _sgn(n1[1] - ep[1]))
+        d_use = d1
+        is_12 = False
+        n2s = [p for p in comp_neighbors(*n1) if p != ep]
+        if n2s:
+            n2 = n2s[0]
+            d2 = (_sgn(n2[0] - n1[0]), _sgn(n2[1] - n1[1]))
+            if (d1[0] == 0) ^ (d1[1] == 0):
+                if d2[0] != 0 and d2[1] != 0:
+                    d_use = d2
+                    is_12 = True
+        return (-d_use[0], -d_use[1]), is_12
+
+    out_info = [outward_dir(ep) for ep in endpoints]
+    out_dirs = [d for d, _ in out_info]
+    tip_12 = [f for _, f in out_info]
+    rad = (_sgn(sum(d[0] for d in out_dirs)), _sgn(sum(d[1] for d in out_dirs)))
+    assert rad != (0, 0), "expected non-zero radiate direction from recovered mouth"
+    return endpoints, out_dirs, tip_12, rad
+
+
+def _add_rays(
+    barrier: np.ndarray,
+    endpoints: list[tuple[int, int]],
+    out_dirs: list[tuple[int, int]],
+    tip_12: list[bool],
+    rad: tuple[int, int],
+) -> None:
+    h, w = barrier.shape
+
+    def add_ray(start: tuple[int, int], d: tuple[int, int]) -> None:
+        rr, cc = start
+        while True:
+            rr += d[0]
+            cc += d[1]
+            if not (0 <= rr < h and 0 <= cc < w):
+                break
+            barrier[rr, cc] = True
+
+    def add_ray_12(start: tuple[int, int], d: tuple[int, int]) -> None:
+        rr, cc = start
+        step = 0
+        while True:
+            step += 1
+            if step % 2 == 1:
+                rr += d[0]
+                cc += d[1]
+            else:
+                if rad[0] != 0:
+                    rr += d[0]
+                else:
+                    cc += d[1]
+            if not (0 <= rr < h and 0 <= cc < w):
+                break
+            barrier[rr, cc] = True
+
+    for ep, d, is_12 in zip(endpoints, out_dirs, tip_12):
+        if is_12:
+            add_ray_12(ep, d)
+        else:
+            add_ray(ep, d)
+
+
+def _touches_border(mask: np.ndarray) -> bool:
+    return bool(mask[0, :].any() or mask[-1, :].any() or mask[:, 0].any() or mask[:, -1].any())
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Fill a sealed funnel from a border trigger and radiate through the side named by an external arrow.
+
+    Input structure:
+    - bg is the most common color. The dominant non-bg color is a capped funnel/U wall whose former mouth is
+      now sealed by wall pixels.
+    - One singleton marker of the fill color is embedded on the opposite border of the wall, while a detached
+      2-pixel arrow marker sits outside the capped side. Other sparse non-bg pixels are obstacles.
+
+    Rule:
+    - Treat the wall-touching singleton as a trigger, recover the wall by folding that pixel back into the
+      border, and use the external arrow to decide which capped side becomes the virtual opening.
+    - Start the flood from the trigger's inner neighbor, fill the interior with the trigger color, pass
+      through the virtual mouth, and keep obstacle shadows along the arrow-selected radiate direction.
+
+    Key insight: Two different marker roles coexist: the wall-attached singleton says which color spreads,
+    while the detached 2-pixel arrow says where the sealed wall should open and where the radiation proceeds.
+    """
+    g = np.array(grid, copy=True)
+    h, w = g.shape
+
+    bg = int(get_bg(g))
+    non_bg = [int(v) for v in np.unique(g) if int(v) != bg]
+    assert non_bg, "expected at least one non-background color"
+
+    wall = max(non_bg, key=lambda c: int((g == c).sum()))
+    trigger, fill = _find_trigger_marker(g, bg, wall)
+
+    wall_mask = g == wall
+    combined_wall = wall_mask.copy()
+    combined_wall[trigger] = True
+    comps = [
+        set((int(r), int(c)) for r, c in pts)
+        for pts in components_mask(combined_wall, connectivity=8)
+    ]
+    assert comps, "expected at least one wall connected component"
+    wall_comp = max(comps, key=len)
+
+    arrow_rad, arrow_cells = _find_direction_marker(g, bg, wall, fill, wall_comp)
+    side_value, v_lo, v_hi = _wall_side_info(wall_comp, arrow_rad)
+    open_mask, open_wall, breach_cells = _recover_open_wall((h, w), wall_comp, arrow_rad, side_value, v_lo, v_hi)
+
+    endpoints, out_dirs, tip_12, geom_rad = _endpoint_radiation(open_wall, open_mask)
+    assert geom_rad == arrow_rad, "external arrow must match the recovered wall orientation"
+
+    barrier = open_mask.copy()
+    _add_rays(barrier, endpoints, out_dirs, tip_12, arrow_rad)
+
+    breach_mask = np.zeros((h, w), dtype=bool)
+    for r, c in breach_cells:
+        breach_mask[r, c] = True
+
+    passable = (~barrier) & ((g == bg) | (g == fill) | breach_mask)
+
+    seed_candidates: list[tuple[int, int, int]] = []
+    for rr, cc in neighbors4(*trigger):
+        if 0 <= rr < h and 0 <= cc < w and passable[rr, cc]:
+            score = (rr - trigger[0]) * arrow_rad[0] + (cc - trigger[1]) * arrow_rad[1]
+            seed_candidates.append((score, int(rr), int(cc)))
+    assert seed_candidates, "expected a trigger-adjacent interior start cell"
+    best_score, seed_r, seed_c = max(seed_candidates)
+    assert best_score > 0, "trigger must point toward the interior/opening side"
+
+    seen = _seed_fill(passable, [(seed_r, seed_c)])
+    filled_mask = seen & ((g == bg) | breach_mask)
+
+    out = g.copy()
+    out[filled_mask] = fill
+
+    obstacles = (g != bg) & (g != fill) & (g != wall)
+    for r, c in arrow_cells:
+        obstacles[r, c] = False
+
+    def shadow_process(coords: list[tuple[int, int]]) -> None:
+        started = False
+        blocked = False
+        for r, c in coords:
+            if filled_mask[r, c]:
+                started = True
+            if started and obstacles[r, c]:
+                blocked = True
+                continue
+            if blocked and filled_mask[r, c]:
+                out[r, c] = bg
+                filled_mask[r, c] = False
+
+    dr, dc = arrow_rad
+    if dr != 0 and dc == 0:
+        for c in range(w):
+            rows = range(h) if dr > 0 else range(h - 1, -1, -1)
+            shadow_process([(r, c) for r in rows])
+    elif dc != 0 and dr == 0:
+        for r in range(h):
+            cols = range(w) if dc > 0 else range(w - 1, -1, -1)
+            shadow_process([(r, c) for c in cols])
+    else:
+        if dr == dc:
+            for k in range(-(w - 1), h):
+                coords = [(r, r - k) for r in range(h) if 0 <= r - k < w]
+                coords.sort(key=lambda rc: rc[0], reverse=(dr < 0))
+                shadow_process(coords)
+        else:
+            for k in range(h + w - 1):
+                coords = [(r, k - r) for r in range(h) if 0 <= k - r < w]
+                coords.sort(key=lambda rc: rc[0], reverse=(dr < 0))
+                shadow_process(coords)
+
+    return out
+
+
+# --------------- generator ---------------
+
+
+def _make_arm(depth, start_v, target_v, extra_steps, tip_12=False):
+    sign = 1 if target_v > start_v else -1
+    n_side_steps = abs(target_v - start_v)
+    chosen_rows = []
+    if n_side_steps:
+        if tip_12:
+            chosen_rows = [2 * (i + 1) for i in range(n_side_steps)]
+            extra_steps = 0
+        else:
+            chosen_rows = [1]
+            if n_side_steps > 1:
+                chosen_rows += random.sample(range(2, depth + 1), n_side_steps - 1)
+            chosen_rows.sort()
+
+    first_row = chosen_rows[0] if chosen_rows else 1
+    extra_rows = [r for r in chosen_rows if r != first_row]
+    random.shuffle(extra_rows)
+    orthogonal_rows = set(extra_rows[:extra_steps])
+
+    pts = [(0, start_v)]
+    u, v = 0, start_v
+    for row in range(1, depth + 1):
+        u += 1
+        if row in orthogonal_rows:
+            pts.append((u, v))
+            v += sign
+        elif row in chosen_rows:
+            v += sign
+        pts.append((u, v))
+    return pts
+
+
+def _build_local_wall(rad, h, w):
+    if rad[0]:
+        max_depth = min(DEPTH_VERT[1], h - 6)
+        if max_depth < DEPTH_VERT[0]:
+            return None
+        depth = random.randint(DEPTH_VERT[0], max_depth)
+        gap = random.randint(*GAP_VERT)
+    else:
+        max_depth = min(DEPTH_HORIZ[1], w - 6)
+        if max_depth < DEPTH_HORIZ[0]:
+            return None
+        depth = random.randint(DEPTH_HORIZ[0], max_depth)
+        gap = random.randint(GAP_HORIZ[0], min(GAP_HORIZ[1], h - 1))
+
+    if gap == 5:
+        left_bottom, right_bottom = 2, 3
+    elif gap == 6:
+        left_bottom, right_bottom = 2, 4
+    else:
+        left_bottom, right_bottom = random.choice([(2, 5), (3, 4)])
+
+    cap_extra = gap - 1
+    base_wall_min = WALL_PIXELS_MIN - cap_extra
+    base_wall_max = WALL_PIXELS_MAX - cap_extra
+    if base_wall_max < 11:
+        return None
+
+    bridge_extra = max(0, right_bottom - left_bottom - 1)
+    base_count = 2 * (depth + 1) + bridge_extra
+    max_extra_l = max(0, left_bottom - 1)
+    max_extra_r = max(0, gap - right_bottom - 1)
+    min_extra = max(0, base_wall_min - base_count)
+    max_extra = min(max_extra_l + max_extra_r, base_wall_max - base_count)
+    if min_extra > max_extra:
+        return None
+
+    extra = random.randint(min_extra, max_extra)
+    extra_l = random.randint(max(0, extra - max_extra_r), min(max_extra_l, extra))
+    extra_r = extra - extra_l
+
+    max_n_side = max(left_bottom, gap - right_bottom)
+    tip_12 = depth >= 2 * max_n_side and random.random() < TIP_12_PROB
+    left = _make_arm(depth, 0, left_bottom, extra_l, tip_12=tip_12)
+    right = _make_arm(depth, gap, right_bottom, extra_r, tip_12=tip_12)
+    pts = set(left) | set(right)
+    for v in range(left_bottom, right_bottom + 1):
+        pts.add((depth, v))
+
+    while len(pts) < base_wall_min:
+        candidates = [
+            (u, v)
+            for u in range(max(0, depth - 3), depth + 1)
+            for v in range(gap + 1)
+            if (u, v) not in pts
+            and sum(
+                (uu, vv) in pts
+                for uu in range(u - 1, u + 2)
+                for vv in range(v - 1, v + 2)
+                if (uu, vv) != (u, v)
+            ) >= 2
+        ]
+        random.shuffle(candidates)
+        added = False
+        for p in candidates:
+            trial = pts | {p}
+            if len(trial) <= base_wall_max and len(_degree1_pixels(trial)) == 2:
+                pts = trial
+                added = True
+                break
+        if not added:
+            return None
+
+    if not (base_wall_min <= len(pts) <= base_wall_max):
+        return None
+    if len(_degree1_pixels(pts)) != 2:
+        return None
+    return pts, depth, gap
+
+
+def _cap_local_wall(wall, gap):
+    pts = set(wall)
+    for v in range(gap + 1):
+        pts.add((0, v))
+    return pts
+
+
+def _map_local(u, v, rad, anchor):
+    r0, c0 = anchor
+    if rad == (-1, 0):
+        return r0 + u, c0 + v
+    if rad == (1, 0):
+        return r0 - u, c0 + v
+    if rad == (0, -1):
+        return r0 + v, c0 + u
+    return r0 + v, c0 - u
+
+
+def _place_anchor(rad, h, w, depth, gap):
+    if rad == (-1, 0):
+        return random.randint(OPEN_END_MARGIN, h - depth - 3), random.randint(0, w - gap - 1)
+    if rad == (1, 0):
+        return random.randint(depth + 2, h - 4), random.randint(0, w - gap - 1)
+    if rad == (0, -1):
+        return random.randint(0, h - gap - 1), random.randint(OPEN_END_MARGIN, w - depth - 3)
+    return random.randint(0, h - gap - 1), random.randint(depth + 2, w - 4)
+
+
+def _local_interior(wall, depth):
+    by_row = {}
+    for u, v in wall:
+        by_row.setdefault(u, []).append(v)
+    interior = []
+    for u in range(1, depth):
+        if u not in by_row or len(by_row[u]) < 2:
+            continue
+        lo, hi = min(by_row[u]), max(by_row[u])
+        for v in range(lo + 1, hi):
+            if (u, v) not in wall:
+                interior.append((u, v))
+    return interior
+
+
+def _obstacle_fits(pos, placed):
+    r, c = pos
+    return all(max(abs(r - rr), abs(c - cc)) >= OBSTACLE_MIN_SEP for rr, cc in placed)
+
+
+def _protect_mask(shape: tuple[int, int], points: list[tuple[int, int]], radius: int = 1) -> np.ndarray:
+    h, w = shape
+    mask = np.zeros((h, w), dtype=bool)
+    for r, c in points:
+        for rr in range(max(0, r - radius), min(h, r + radius + 1)):
+            for cc in range(max(0, c - radius), min(w, c + radius + 1)):
+                mask[rr, cc] = True
+    return mask
+
+
+def _find_obstacle_candidates(grid, bg, wall_color, nominal_fill_zone, protected):
+    wall_mask = grid == wall_color
+    dist = distance_transform_cdt(~wall_mask, metric="chessboard")
+    eligible = (grid == bg) & (dist > 1) & (~protected)
+    all_coords = list(zip(*np.where(eligible)))
+    fill_coords = [p for p in all_coords if nominal_fill_zone[p[0], p[1]]]
+    random.shuffle(all_coords)
+    random.shuffle(fill_coords)
+    return [(int(r), int(c)) for r, c in all_coords], [(int(r), int(c)) for r, c in fill_coords]
+
+
+def _place_obstacles(n_obstacles, candidates, fill_candidates, obstacle_colors, grid):
+    placed: list[tuple[int, int]] = []
+    n_fill = random.randint(0, min(n_obstacles, len(fill_candidates)))
+    if fill_candidates and random.random() < OBSTACLE_IN_FILL_PROB:
+        n_fill = max(1, n_fill)
+    for p in fill_candidates:
+        if len(placed) >= n_fill:
+            break
+        if _obstacle_fits(p, placed):
+            placed.append(p)
+    placed_set = set(placed)
+    for p in candidates:
+        if len(placed) >= n_obstacles:
+            break
+        if p not in placed_set and _obstacle_fits(p, placed):
+            placed.append(p)
+            placed_set.add(p)
+    for i, (r, c) in enumerate(placed):
+        grid[r, c] = obstacle_colors[i % len(obstacle_colors)]
+
+
+def _place_arrow(grid, marker_color, rad, anchor, gap):
+    mid_v = gap // 2
+    wall_r, wall_c = _map_local(0, mid_v, rad, anchor)
+    tail_r = wall_r + rad[0] * (MARKER_GAP + 1)
+    tail_c = wall_c + rad[1] * (MARKER_GAP + 1)
+    head_r = wall_r + rad[0] * (MARKER_GAP + MARKER_LEN)
+    head_c = wall_c + rad[1] * (MARKER_GAP + MARKER_LEN)
+    coords = [(tail_r, tail_c), (head_r, head_c)]
+    h, w = grid.shape
+    for r, c in coords:
+        if not (0 <= r < h and 0 <= c < w):
+            return None
+        if grid[r, c] != grid[0, 0]:
+            return None
+    for r, c in coords:
+        grid[r, c] = marker_color
+    return coords
+
+
+def _gen_attempt():
+    rad = random.choice([(-1, 0), (1, 0), (0, -1), (0, 1)])
+    h = random.randint(*GRID_H_VERT) if rad[0] else random.randint(*GRID_H_HORIZ)
+    w = random.randint(*GRID_W)
+
+    built = _build_local_wall(rad, h, w)
+    if built is None:
+        return None
+    local_wall_open, depth, gap = built
+    local_wall = _cap_local_wall(local_wall_open, gap)
+    anchor = _place_anchor(rad, h, w, depth, gap)
+
+    palette = random.sample(range(10), random.randint(*PALETTE_SIZE))
+    bg, wall_color, fill_color, arrow_color = palette[:4]
+    obstacle_colors = [c for c in palette[4:] if c not in (bg, wall_color, fill_color, arrow_color)]
+
+    grid = np.full((h, w), bg, dtype=int)
+    for u, v in local_wall:
+        r, c = _map_local(u, v, rad, anchor)
+        grid[r, c] = wall_color
+
+    arrow_cells = _place_arrow(grid, arrow_color, rad, anchor, gap)
+    if arrow_cells is None:
+        return None
+
+    interior = set(_local_interior(local_wall_open, depth))
+    if not interior:
+        return None
+
+    bridge_candidates = [
+        (u, v)
+        for u, v in local_wall_open
+        if u == depth and (u - 1, v) in interior
+    ]
+    if not bridge_candidates:
+        return None
+
+    trigger_u, trigger_v = random.choice(bridge_candidates)
+    trigger_r, trigger_c = _map_local(trigger_u, trigger_v, rad, anchor)
+    if grid[trigger_r, trigger_c] != wall_color:
+        return None
+    grid[trigger_r, trigger_c] = fill_color
+
+    if int((grid == fill_color).sum()) != 1:
+        return None
+
+    try:
+        nominal_out = main(grid)
+    except Exception:
+        return None
+    nominal_fill_zone = (nominal_out == fill_color) & (grid == bg)
+
+    protected = _protect_mask(grid.shape, arrow_cells + [(trigger_r, trigger_c)], radius=1)
+
+    n_obstacles = random.randint(0, MAX_OBSTACLES)
+    if n_obstacles and not obstacle_colors:
+        available = [c for c in range(10) if c not in (bg, wall_color, fill_color, arrow_color)]
+        obstacle_colors = random.sample(available, random.randint(1, 2))
+    if n_obstacles:
+        candidates, fill_candidates = _find_obstacle_candidates(
+            grid, bg, wall_color, nominal_fill_zone, protected
+        )
+        _place_obstacles(n_obstacles, candidates, fill_candidates, obstacle_colors, grid)
+
+    try:
+        out = main(grid)
+    except Exception:
+        return None
+
+    new_fill = (out == fill_color) & (grid == bg)
+    if int(new_fill.sum()) < MIN_NEW_FILL or not _touches_border(new_fill):
+        return None
+
+    breach_wall_fill = int(((out == fill_color) & (grid == wall_color)).sum())
+    if breach_wall_fill < gap - 1:
+        return None
+
+    try:
+        orig_out = _original_main(grid)
+    except Exception:
+        orig_out = None
+    if orig_out is not None and np.array_equal(orig_out, out):
+        return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate valid b9e38dc0 combo input")

diff --git a/ceshi/code_combo/b9e38dc0/15/code.py b/ceshi/code_combo/b9e38dc0/15/code.py
new file mode 100644
index 0000000000000000000000000000000000000000..cc4c63a07c7bf1863a9efc7cd877568bfeef8330
--- /dev/null
+++ b/ceshi/code_combo/b9e38dc0/15/code.py
@@ -0,0 +1,774 @@
+# Combo variant of b9e38dc0 (index 15)
+# combo_spec: D4/3+D13/2
+# Name: 边框标记触发+外部标记指示方向
+
+import importlib.util
+import random
+from pathlib import Path
+
+import numpy as np
+from scipy.ndimage import distance_transform_cdt
+
+from arc_utils import components_mask, get_bg, neighbors4, neighbors8
+
+
+# ---------------------------------------------------------------------------
+# Design analysis for combo D4/3 + D13/2
+#
+# combo_design:
+#   a) concrete_behavior_trace:
+#     - Base geometry keeps the original funnel/U family, but the former mouth is capped with wall pixels.
+#       This removes the original "visible opening tells the direction" cue.
+#     - A single trigger marker replaces one wall pixel on the opposite closed bridge. Its color is the fill
+#       color, and it is the only non-bg non-wall pixel that touches the wall.
+#     - A separate 2-pixel external marker sits outside the capped side with a one-cell bg gap. The nearer
+#       pixel is the tail and the farther one is the head, so the pair points along the radiate axis.
+#     - Small trace:
+#       old:
+#         1. detect interior fill blob
+#         2. infer radiate direction from the wall's two open endpoints
+#         3. flood interior from the blob, then radiate out of the mouth
+#       combo:
+#         1. detect the wall-touching singleton trigger marker and treat it as wall-colored geometry
+#         2. decode the external 2-pixel arrow to choose which side is the virtual opening
+#         3. remove only the capped mouth cells between the arrow-selected endpoints
+#         4. start BFS from the trigger's inner neighbor in the arrow direction
+#         5. flood the interior, pass through the virtual mouth, and keep the original slanted boundary rays
+#       difference:
+#         旧逻辑依赖“内部 seed + 几何开口”；融合后改成“边框触发 + 外部箭头选开口侧”。
+#   b) complexity_calibration:
+#     - Trigger marker is exactly one wall-touching pixel, so it is visually distinct from the external arrow.
+#     - Direction marker has only 4 possible cardinal directions and always uses exactly 2 pixels, keeping
+#       the new freedom small and repeated across examples.
+#     - The wall family, obstacle shadows, and ray slopes remain from the original task, so the puzzle still
+#       reads as a modified b9e38dc0 rather than a new unrelated task.
+#   c) hidden_assumption_audit:
+#     - Original `fill_pos` was assumed to be passable interior cells. That fails because the fill-colored
+#       trigger now lies on the wall, so the solver must derive an interior start cell from the trigger.
+#     - Original endpoint detection assumed a true open mouth. That fails after capping, so the solver must
+#       first decode the external arrow, then virtually remove only the selected cap cells.
+#     - Original obstacle detection treated every non-bg non-fill non-wall pixel as a blocker. That would
+#       wrongly include the external arrow, so marker cells must be excluded from shadow casting.
+#     - Original "closest non-wall color to wall" still works only if the trigger is the wall-adjacent color
+#       and obstacles / arrow stay farther away; the generator explicitly enforces that spacing.
+#   d) placement_legality:
+#     - The capped side is chosen from the original mouth and stays within the original open-end margin, so
+#       the 2-pixel arrow with a one-cell gap fits inside the grid.
+#     - The trigger marker is placed only on the closed bridge at positions whose arrow-facing 4-neighbor is
+#       an interior cell, guaranteeing a valid BFS start candidate.
+#     - Obstacles are placed only on background cells, far from the wall and both marker types, so they do
+#       not overlap or visually merge with either marker.
+#   e) observability:
+#     - Across examples, humans see two distinct cues: a singleton wall-attached trigger and a detached
+#       2-pixel arrow. The output then expands from the trigger color and exits on the arrow side.
+#     - Because the mouth is visibly capped, the arrow is the only explicit directional token in the input.
+#   f) cleanliness:
+#     - The trigger stays on the wall; the arrow stays outside the wall with a bg gap; obstacles stay sparse
+#       and separated. No region carries more than one semantic layer.
+#   g) inferability_of_changes:
+#     - No hidden color remapping is introduced. The trigger's own color becomes the filled region, while the
+#       arrow is identified by shape and placement rather than by any numeric color ordering.
+#   post_change_solver_assumptions_and_generator_guarantees:
+#     - exactly one wall-touching non-bg non-wall pixel exists -> generator makes the trigger unique
+#     - exactly one 2-pixel cardinal external marker with unequal wall distances exists -> generator makes
+#       the arrow unique and keeps obstacles non-adjacent
+#     - the arrow-selected side is a contiguous cap -> generator builds the cap deterministically
+#     - removing cap-interior cells restores an open wall with exactly two endpoints -> generator starts from
+#       the original open-wall constructor and only adds the cap
+#     - the trigger has a positive-dot interior neighbor in the arrow direction -> generator chooses it only
+#       from bridge cells whose inward neighbor exists
+# ---------------------------------------------------------------------------
+
+
+# -- Configuration constants --------------------------------------------------
+GRID_H_VERT = (11, 18)
+GRID_H_HORIZ = (8, 18)
+GRID_W = (15, 19)
+
+WALL_PIXELS_MIN = 17
+WALL_PIXELS_MAX = 25
+DEPTH_VERT = (5, 8)
+DEPTH_HORIZ = (5, 8)
+GAP_VERT = (6, 7)
+GAP_HORIZ = (5, 7)
+TIP_12_PROB = 0.5
+
+OPEN_END_MARGIN = 3
+MARKER_GAP = 1
+MARKER_LEN = 2
+
+MAX_OBSTACLES = 5
+OBSTACLE_IN_FILL_PROB = 0.65
+OBSTACLE_MIN_SEP = 2
+
+MIN_NEW_FILL = 20
+PALETTE_SIZE = (4, 6)
+GEN_RETRIES = 400
+_ORIG_MAIN = None
+
+
+def _sgn(x: int) -> int:
+    return (x > 0) - (x < 0)
+
+
+def _original_main(grid: np.ndarray) -> np.ndarray:
+    global _ORIG_MAIN
+    if _ORIG_MAIN is None:
+        root = Path(__file__).resolve().parents[5]
+        spec = importlib.util.spec_from_file_location(
+            "b9e38dc0_orig_combo15", root / "arc2_solver_select" / "b9e38dc0.py"
+        )
+        mod = importlib.util.module_from_spec(spec)
+        assert spec.loader is not None
+        spec.loader.exec_module(mod)
+        _ORIG_MAIN = mod.main
+    return _ORIG_MAIN(grid)
+
+
+def _degree1_pixels(points):
+    pts = set(points)
+    return [
+        (r, c)
+        for r, c in pts
+        if sum((rr, cc) in pts for rr, cc in neighbors8(r, c)) == 1
+    ]
+
+
+def _seed_fill(mask: np.ndarray, starts: list[tuple[int, int]]) -> np.ndarray:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    q: list[tuple[int, int]] = []
+    for r, c in starts:
+        if 0 <= r < h and 0 <= c < w and mask[r, c] and not seen[r, c]:
+            seen[r, c] = True
+            q.append((r, c))
+    while q:
+        r, c = q.pop()
+        for rr, cc in neighbors4(r, c):
+            if 0 <= rr < h and 0 <= cc < w and mask[rr, cc] and not seen[rr, cc]:
+                seen[rr, cc] = True
+                q.append((rr, cc))
+    return seen
+
+
+def _to_local(r: int, c: int, rad: tuple[int, int], side_value: int) -> tuple[int, int]:
+    if rad == (-1, 0):
+        return r - side_value, c
+    if rad == (1, 0):
+        return side_value - r, c
+    if rad == (0, -1):
+        return c - side_value, r
+    return side_value - c, r
+
+
+def _from_local(u: int, v: int, rad: tuple[int, int], side_value: int) -> tuple[int, int]:
+    if rad == (-1, 0):
+        return side_value + u, v
+    if rad == (1, 0):
+        return side_value - u, v
+    if rad == (0, -1):
+        return v, side_value + u
+    return v, side_value - u
+
+
+def _find_trigger_marker(g: np.ndarray, bg: int, wall: int) -> tuple[tuple[int, int], int]:
+    h, w = g.shape
+    wall_mask = g == wall
+    trigger_candidates: list[tuple[int, int]] = []
+    for r, c in zip(*np.where((g != bg) & (g != wall))):
+        rr = int(r)
+        cc = int(c)
+        if any(
+            0 <= nr < h and 0 <= nc < w and wall_mask[nr, nc]
+            for nr, nc in neighbors8(rr, cc)
+        ):
+            trigger_candidates.append((rr, cc))
+    assert len(trigger_candidates) == 1, "expected exactly one wall-touching trigger marker"
+    trigger = trigger_candidates[0]
+    return trigger, int(g[trigger])
+
+
+def _find_direction_marker(
+    g: np.ndarray,
+    bg: int,
+    wall: int,
+    fill: int,
+    wall_comp: set[tuple[int, int]],
+) -> tuple[tuple[int, int], set[tuple[int, int]]]:
+    candidates: list[tuple[int, tuple[int, int], set[tuple[int, int]]]] = []
+    for color in [int(v) for v in np.unique(g) if int(v) not in (bg, wall, fill)]:
+        for pts in components_mask(g == color, connectivity=4):
+            coords = [(int(r), int(c)) for r, c in pts]
+            if len(coords) != 2:
+                continue
+            (r1, c1), (r2, c2) = coords
+            if abs(r1 - r2) + abs(c1 - c2) != 1:
+                continue
+            d1 = min(abs(r1 - wr) + abs(c1 - wc) for wr, wc in wall_comp)
+            d2 = min(abs(r2 - wr) + abs(c2 - wc) for wr, wc in wall_comp)
+            if d1 == d2:
+                continue
+            tail, head = ((r1, c1), (r2, c2)) if d1 < d2 else ((r2, c2), (r1, c1))
+            rad = (_sgn(head[0] - tail[0]), _sgn(head[1] - tail[1]))
+            if abs(rad[0]) + abs(rad[1]) != 1:
+                continue
+            candidates.append((min(d1, d2), rad, {tail, head}))
+    assert len(candidates) == 1, "expected exactly one external direction marker"
+    _, rad, marker_cells = candidates[0]
+    return rad, marker_cells
+
+
+def _wall_side_info(
+    wall_comp: set[tuple[int, int]],
+    rad: tuple[int, int],
+) -> tuple[int, int, int]:
+    if rad == (-1, 0):
+        side_value = min(r for r, _ in wall_comp)
+    elif rad == (1, 0):
+        side_value = max(r for r, _ in wall_comp)
+    elif rad == (0, -1):
+        side_value = min(c for _, c in wall_comp)
+    else:
+        side_value = max(c for _, c in wall_comp)
+
+    local_pts = {_to_local(r, c, rad, side_value) for r, c in wall_comp}
+    side_vs = sorted(v for u, v in local_pts if u == 0)
+    assert side_vs, "expected capped side on the marked face"
+    v_lo, v_hi = side_vs[0], side_vs[-1]
+    for v in range(v_lo, v_hi + 1):
+        assert (0, v) in local_pts, "expected contiguous cap on marked face"
+    return side_value, v_lo, v_hi
+
+
+def _recover_open_wall(
+    shape: tuple[int, int],
+    wall_comp: set[tuple[int, int]],
+    rad: tuple[int, int],
+    side_value: int,
+    v_lo: int,
+    v_hi: int,
+) -> tuple[np.ndarray, set[tuple[int, int]], set[tuple[int, int]]]:
+    h, w = shape
+    breach_cells = {
+        _from_local(0, v, rad, side_value)
+        for v in range(v_lo + 1, v_hi)
+    }
+    open_wall = set(wall_comp) - breach_cells
+    open_mask = np.zeros((h, w), dtype=bool)
+    for r, c in open_wall:
+        open_mask[r, c] = True
+    return open_mask, open_wall, breach_cells
+
+
+def _endpoint_radiation(
+    open_wall: set[tuple[int, int]],
+    open_mask: np.ndarray,
+) -> tuple[list[tuple[int, int]], list[tuple[int, int]], list[bool], tuple[int, int]]:
+    h, w = open_mask.shape
+
+    def comp_neighbors(r: int, c: int) -> list[tuple[int, int]]:
+        out = []
+        for rr, cc in neighbors8(r, c):
+            if 0 <= rr < h and 0 <= cc < w and open_mask[rr, cc]:
+                out.append((rr, cc))
+        return out
+
+    endpoints = [(r, c) for r, c in open_wall if len(comp_neighbors(r, c)) == 1]
+    assert len(endpoints) == 2, "expected exactly two recovered mouth endpoints"
+
+    def outward_dir(ep: tuple[int, int]) -> tuple[tuple[int, int], bool]:
+        n1 = comp_neighbors(*ep)[0]
+        d1 = (_sgn(n1[0] - ep[0]), _sgn(n1[1] - ep[1]))
+        d_use = d1
+        is_12 = False
+        n2s = [p for p in comp_neighbors(*n1) if p != ep]
+        if n2s:
+            n2 = n2s[0]
+            d2 = (_sgn(n2[0] - n1[0]), _sgn(n2[1] - n1[1]))
+            if (d1[0] == 0) ^ (d1[1] == 0):
+                if d2[0] != 0 and d2[1] != 0:
+                    d_use = d2
+                    is_12 = True
+        return (-d_use[0], -d_use[1]), is_12
+
+    out_info = [outward_dir(ep) for ep in endpoints]
+    out_dirs = [d for d, _ in out_info]
+    tip_12 = [f for _, f in out_info]
+    rad = (_sgn(sum(d[0] for d in out_dirs)), _sgn(sum(d[1] for d in out_dirs)))
+    assert rad != (0, 0), "expected non-zero radiate direction from recovered mouth"
+    return endpoints, out_dirs, tip_12, rad
+
+
+def _add_rays(
+    barrier: np.ndarray,
+    endpoints: list[tuple[int, int]],
+    out_dirs: list[tuple[int, int]],
+    tip_12: list[bool],
+    rad: tuple[int, int],
+) -> None:
+    h, w = barrier.shape
+
+    def add_ray(start: tuple[int, int], d: tuple[int, int]) -> None:
+        rr, cc = start
+        while True:
+            rr += d[0]
+            cc += d[1]
+            if not (0 <= rr < h and 0 <= cc < w):
+                break
+            barrier[rr, cc] = True
+
+    def add_ray_12(start: tuple[int, int], d: tuple[int, int]) -> None:
+        rr, cc = start
+        step = 0
+        while True:
+            step += 1
+            if step % 2 == 1:
+                rr += d[0]
+                cc += d[1]
+            else:
+                if rad[0] != 0:
+                    rr += d[0]
+                else:
+                    cc += d[1]
+            if not (0 <= rr < h and 0 <= cc < w):
+                break
+            barrier[rr, cc] = True
+
+    for ep, d, is_12 in zip(endpoints, out_dirs, tip_12):
+        if is_12:
+            add_ray_12(ep, d)
+        else:
+            add_ray(ep, d)
+
+
+def _touches_border(mask: np.ndarray) -> bool:
+    return bool(mask[0, :].any() or mask[-1, :].any() or mask[:, 0].any() or mask[:, -1].any())
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Fill a sealed funnel from a border trigger and radiate through the side named by an external arrow.
+
+    Input structure:
+    - bg is the most common color. The dominant non-bg color is a capped funnel/U wall whose former mouth is
+      now sealed by wall pixels.
+    - One singleton marker of the fill color is embedded on the opposite border of the wall, while a detached
+      2-pixel arrow marker sits outside the capped side. Other sparse non-bg pixels are obstacles.
+
+    Rule:
+    - Treat the wall-touching singleton as a trigger, recover the wall by folding that pixel back into the
+      border, and use the external arrow to decide which capped side becomes the virtual opening.
+    - Start the flood from the trigger's inner neighbor, fill the interior with the trigger color, pass
+      through the virtual mouth, and keep obstacle shadows along the arrow-selected radiate direction.
+
+    Key insight: Two different marker roles coexist: the wall-attached singleton says which color spreads,
+    while the detached 2-pixel arrow says where the sealed wall should open and where the radiation proceeds.
+    """
+    g = np.array(grid, copy=True)
+    h, w = g.shape
+
+    bg = int(get_bg(g))
+    non_bg = [int(v) for v in np.unique(g) if int(v) != bg]
+    assert non_bg, "expected at least one non-background color"
+
+    wall = max(non_bg, key=lambda c: int((g == c).sum()))
+    trigger, fill = _find_trigger_marker(g, bg, wall)
+
+    wall_mask = g == wall
+    combined_wall = wall_mask.copy()
+    combined_wall[trigger] = True
+    comps = [
+        set((int(r), int(c)) for r, c in pts)
+        for pts in components_mask(combined_wall, connectivity=8)
+    ]
+    assert comps, "expected at least one wall connected component"
+    wall_comp = max(comps, key=len)
+
+    arrow_rad, arrow_cells = _find_direction_marker(g, bg, wall, fill, wall_comp)
+    side_value, v_lo, v_hi = _wall_side_info(wall_comp, arrow_rad)
+    open_mask, open_wall, breach_cells = _recover_open_wall((h, w), wall_comp, arrow_rad, side_value, v_lo, v_hi)
+
+    endpoints, out_dirs, tip_12, geom_rad = _endpoint_radiation(open_wall, open_mask)
+    assert geom_rad == arrow_rad, "external arrow must match the recovered wall orientation"
+
+    barrier = open_mask.copy()
+    _add_rays(barrier, endpoints, out_dirs, tip_12, arrow_rad)
+
+    breach_mask = np.zeros((h, w), dtype=bool)
+    for r, c in breach_cells:
+        breach_mask[r, c] = True
+
+    passable = (~barrier) & ((g == bg) | (g == fill) | breach_mask)
+
+    seed_candidates: list[tuple[int, int, int]] = []
+    for rr, cc in neighbors4(*trigger):
+        if 0 <= rr < h and 0 <= cc < w and passable[rr, cc]:
+            score = (rr - trigger[0]) * arrow_rad[0] + (cc - trigger[1]) * arrow_rad[1]
+            seed_candidates.append((score, int(rr), int(cc)))
+    assert seed_candidates, "expected a trigger-adjacent interior start cell"
+    best_score, seed_r, seed_c = max(seed_candidates)
+    assert best_score > 0, "trigger must point toward the interior/opening side"
+
+    seen = _seed_fill(passable, [(seed_r, seed_c)])
+    filled_mask = seen & ((g == bg) | breach_mask)
+
+    out = g.copy()
+    out[filled_mask] = fill
+
+    obstacles = (g != bg) & (g != fill) & (g != wall)
+    for r, c in arrow_cells:
+        obstacles[r, c] = False
+
+    def shadow_process(coords: list[tuple[int, int]]) -> None:
+        started = False
+        blocked = False
+        for r, c in coords:
+            if filled_mask[r, c]:
+                started = True
+            if started and obstacles[r, c]:
+                blocked = True
+                continue
+            if blocked and filled_mask[r, c]:
+                out[r, c] = bg
+                filled_mask[r, c] = False
+
+    dr, dc = arrow_rad
+    if dr != 0 and dc == 0:
+        for c in range(w):
+            rows = range(h) if dr > 0 else range(h - 1, -1, -1)
+            shadow_process([(r, c) for r in rows])
+    elif dc != 0 and dr == 0:
+        for r in range(h):
+            cols = range(w) if dc > 0 else range(w - 1, -1, -1)
+            shadow_process([(r, c) for c in cols])
+    else:
+        if dr == dc:
+            for k in range(-(w - 1), h):
+                coords = [(r, r - k) for r in range(h) if 0 <= r - k < w]
+                coords.sort(key=lambda rc: rc[0], reverse=(dr < 0))
+                shadow_process(coords)
+        else:
+            for k in range(h + w - 1):
+                coords = [(r, k - r) for r in range(h) if 0 <= k - r < w]
+                coords.sort(key=lambda rc: rc[0], reverse=(dr < 0))
+                shadow_process(coords)
+
+    return out
+
+
+# --------------- generator ---------------
+
+
+def _make_arm(depth, start_v, target_v, extra_steps, tip_12=False):
+    sign = 1 if target_v > start_v else -1
+    n_side_steps = abs(target_v - start_v)
+    chosen_rows = []
+    if n_side_steps:
+        if tip_12:
+            chosen_rows = [2 * (i + 1) for i in range(n_side_steps)]
+            extra_steps = 0
+        else:
+            chosen_rows = [1]
+            if n_side_steps > 1:
+                chosen_rows += random.sample(range(2, depth + 1), n_side_steps - 1)
+            chosen_rows.sort()
+
+    first_row = chosen_rows[0] if chosen_rows else 1
+    extra_rows = [r for r in chosen_rows if r != first_row]
+    random.shuffle(extra_rows)
+    orthogonal_rows = set(extra_rows[:extra_steps])
+
+    pts = [(0, start_v)]
+    u, v = 0, start_v
+    for row in range(1, depth + 1):
+        u += 1
+        if row in orthogonal_rows:
+            pts.append((u, v))
+            v += sign
+        elif row in chosen_rows:
+            v += sign
+        pts.append((u, v))
+    return pts
+
+
+def _build_local_wall(rad, h, w):
+    if rad[0]:
+        max_depth = min(DEPTH_VERT[1], h - 6)
+        if max_depth < DEPTH_VERT[0]:
+            return None
+        depth = random.randint(DEPTH_VERT[0], max_depth)
+        gap = random.randint(*GAP_VERT)
+    else:
+        max_depth = min(DEPTH_HORIZ[1], w - 6)
+        if max_depth < DEPTH_HORIZ[0]:
+            return None
+        depth = random.randint(DEPTH_HORIZ[0], max_depth)
+        gap = random.randint(GAP_HORIZ[0], min(GAP_HORIZ[1], h - 1))
+
+    if gap == 5:
+        left_bottom, right_bottom = 2, 3
+    elif gap == 6:
+        left_bottom, right_bottom = 2, 4
+    else:
+        left_bottom, right_bottom = random.choice([(2, 5), (3, 4)])
+
+    cap_extra = gap - 1
+    base_wall_min = WALL_PIXELS_MIN - cap_extra
+    base_wall_max = WALL_PIXELS_MAX - cap_extra
+    if base_wall_max < 11:
+        return None
+
+    bridge_extra = max(0, right_bottom - left_bottom - 1)
+    base_count = 2 * (depth + 1) + bridge_extra
+    max_extra_l = max(0, left_bottom - 1)
+    max_extra_r = max(0, gap - right_bottom - 1)
+    min_extra = max(0, base_wall_min - base_count)
+    max_extra = min(max_extra_l + max_extra_r, base_wall_max - base_count)
+    if min_extra > max_extra:
+        return None
+
+    extra = random.randint(min_extra, max_extra)
+    extra_l = random.randint(max(0, extra - max_extra_r), min(max_extra_l, extra))
+    extra_r = extra - extra_l
+
+    max_n_side = max(left_bottom, gap - right_bottom)
+    tip_12 = depth >= 2 * max_n_side and random.random() < TIP_12_PROB
+    left = _make_arm(depth, 0, left_bottom, extra_l, tip_12=tip_12)
+    right = _make_arm(depth, gap, right_bottom, extra_r, tip_12=tip_12)
+    pts = set(left) | set(right)
+    for v in range(left_bottom, right_bottom + 1):
+        pts.add((depth, v))
+
+    while len(pts) < base_wall_min:
+        candidates = [
+            (u, v)
+            for u in range(max(0, depth - 3), depth + 1)
+            for v in range(gap + 1)
+            if (u, v) not in pts
+            and sum(
+                (uu, vv) in pts
+                for uu in range(u - 1, u + 2)
+                for vv in range(v - 1, v + 2)
+                if (uu, vv) != (u, v)
+            ) >= 2
+        ]
+        random.shuffle(candidates)
+        added = False
+        for p in candidates:
+            trial = pts | {p}
+            if len(trial) <= base_wall_max and len(_degree1_pixels(trial)) == 2:
+                pts = trial
+                added = True
+                break
+        if not added:
+            return None
+
+    if not (base_wall_min <= len(pts) <= base_wall_max):
+        return None
+    if len(_degree1_pixels(pts)) != 2:
+        return None
+    return pts, depth, gap
+
+
+def _cap_local_wall(wall, gap):
+    pts = set(wall)
+    for v in range(gap + 1):
+        pts.add((0, v))
+    return pts
+
+
+def _map_local(u, v, rad, anchor):
+    r0, c0 = anchor
+    if rad == (-1, 0):
+        return r0 + u, c0 + v
+    if rad == (1, 0):
+        return r0 - u, c0 + v
+    if rad == (0, -1):
+        return r0 + v, c0 + u
+    return r0 + v, c0 - u
+
+
+def _place_anchor(rad, h, w, depth, gap):
+    if rad == (-1, 0):
+        return random.randint(OPEN_END_MARGIN, h - depth - 3), random.randint(0, w - gap - 1)
+    if rad == (1, 0):
+        return random.randint(depth + 2, h - 4), random.randint(0, w - gap - 1)
+    if rad == (0, -1):
+        return random.randint(0, h - gap - 1), random.randint(OPEN_END_MARGIN, w - depth - 3)
+    return random.randint(0, h - gap - 1), random.randint(depth + 2, w - 4)
+
+
+def _local_interior(wall, depth):
+    by_row = {}
+    for u, v in wall:
+        by_row.setdefault(u, []).append(v)
+    interior = []
+    for u in range(1, depth):
+        if u not in by_row or len(by_row[u]) < 2:
+            continue
+        lo, hi = min(by_row[u]), max(by_row[u])
+        for v in range(lo + 1, hi):
+            if (u, v) not in wall:
+                interior.append((u, v))
+    return interior
+
+
+def _obstacle_fits(pos, placed):
+    r, c = pos
+    return all(max(abs(r - rr), abs(c - cc)) >= OBSTACLE_MIN_SEP for rr, cc in placed)
+
+
+def _protect_mask(shape: tuple[int, int], points: list[tuple[int, int]], radius: int = 1) -> np.ndarray:
+    h, w = shape
+    mask = np.zeros((h, w), dtype=bool)
+    for r, c in points:
+        for rr in range(max(0, r - radius), min(h, r + radius + 1)):
+            for cc in range(max(0, c - radius), min(w, c + radius + 1)):
+                mask[rr, cc] = True
+    return mask
+
+
+def _find_obstacle_candidates(grid, bg, wall_color, nominal_fill_zone, protected):
+    wall_mask = grid == wall_color
+    dist = distance_transform_cdt(~wall_mask, metric="chessboard")
+    eligible = (grid == bg) & (dist > 1) & (~protected)
+    all_coords = list(zip(*np.where(eligible)))
+    fill_coords = [p for p in all_coords if nominal_fill_zone[p[0], p[1]]]
+    random.shuffle(all_coords)
+    random.shuffle(fill_coords)
+    return [(int(r), int(c)) for r, c in all_coords], [(int(r), int(c)) for r, c in fill_coords]
+
+
+def _place_obstacles(n_obstacles, candidates, fill_candidates, obstacle_colors, grid):
+    placed: list[tuple[int, int]] = []
+    n_fill = random.randint(0, min(n_obstacles, len(fill_candidates)))
+    if fill_candidates and random.random() < OBSTACLE_IN_FILL_PROB:
+        n_fill = max(1, n_fill)
+    for p in fill_candidates:
+        if len(placed) >= n_fill:
+            break
+        if _obstacle_fits(p, placed):
+            placed.append(p)
+    placed_set = set(placed)
+    for p in candidates:
+        if len(placed) >= n_obstacles:
+            break
+        if p not in placed_set and _obstacle_fits(p, placed):
+            placed.append(p)
+            placed_set.add(p)
+    for i, (r, c) in enumerate(placed):
