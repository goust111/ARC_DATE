+    except Exception:
+        orig_out = None
+    if orig_out is not None and np.array_equal(orig_out, out):
+        return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
