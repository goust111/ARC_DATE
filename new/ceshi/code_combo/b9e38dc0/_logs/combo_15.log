+    tail_c = wall_c + rad[1] * (MARKER_GAP + 1)
+    head_r = wall_r + rad[0] * (MARKER_GAP + MARKER_LEN)
+    head_c = wall_c + rad[1] * (MARKER_GAP + MARKER_LEN)
