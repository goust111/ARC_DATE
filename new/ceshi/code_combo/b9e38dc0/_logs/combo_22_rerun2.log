+# Combo variant of b9e38dc0 (index 22)
+# combo_spec: D1/0+D3/1+D14/2
+# Name: 仅辐射+间歇涂色+粗射线
+
+import random
+
+import numpy as np
+from scipy.ndimage import distance_transform_cdt
+
+from arc_utils import components_mask, get_bg, neighbors4, neighbors8
+
+# Design analysis
+# spec:
+#   concrete_behavior:
+#     - 保留原题的对象识别方式：背景色仍取众数，墙色仍取最多的非背景色，离墙最近的另一种颜色仍是种子色。
+#     - 保留“通过墙端点推断开口朝向”的核心几何线索，但移除原题的 BFS 腔体填充；半包围区域不再被实心染满。
+#     - 新规则改为：种子团块沿开口方向直接发射固定 3 像素宽的平行射线束。射线束从种子朝开口的一侧前缘开始，
+#       在腔体内部穿过空腔、经过开口继续延伸到边界。每前进 1 格只在奇数深度着色，因此视觉上是宽虚线。
+#     - 障碍像素不变，但不再用“先填满再做阴影”的扫描线逻辑；现在它们直接充当射线束各条通道的阻挡物，
+#       命中某一条通道后，该通道后方停止着色，其余并行通道可继续。
+#   behavior_trace:
+#     - 例：若开口朝下，端点中轴在第 8/9/10 列，种子位于腔体上部且对齐这三列。原题会把整个 U 形内部都填成 fill，
+#       然后在开口外形成连续实心辐射区。
+#     - 本融合版中，内部不会整块染满；只会在中轴三列上出现从种子直达边界的轨迹。深度 1、3、5... 的层着色，
+#       深度 2、4、6... 保持背景，因此内部与外部都能看到 3 像素宽的虚线束。
+#     - 与原题的关键差异有三处同时发生：腔体保持空心、轨迹变成间歇节律、辐射从单线/扇区变成固定 3 列粗束。
+#   complexity_calibration:
+#     - 虚线周期固定为 2（涂一格空一格），避免像 D3/1 单变体那样再引入“由开口宽度决定周期”的第二控制量；
+#       这样解题者只需识别一个稳定节律，宽度变化也不会和节律变化耦合。
+#     - 粗射线宽度固定为 3，且始终围绕开口中轴放置；不做多档宽度或偏移方案，防止样例过少时无法归纳。
+#     - 生成器将种子约束在中轴附近，并偏好 1-3 像素的小团块，避免“多源并发射线”导致输出宽度不稳定。
+#   implicit_assumptions_review:
+#     - 原 solver 中 `barrier`/BFS 依赖“端点射线构成封边”这个前提；融合后不再做区域可达性求解，因此整段逻辑必须移除。
+#     - 原 `shadow_process` 依赖 filled_mask 连续成片；融合后轨迹本来就是断续的，若继续沿用该扫描会把虚线空隙误当成遮挡终点，
+#       因此必须改成逐通道射线截断。
+#     - 新 solver 假设开口方向是轴对齐的四联通方向，这一点仍由原墙体构造保证；generator 继续沿用原墙体生成器来满足该假设。
+#     - 新 solver 还假设“以开口中轴为中心的 3 像素束能够穿过开口”。generator 通过把种子放在中轴带内、并用输出验证实际可见宽束，
+#       保证该假设成立。
+#   placement_legality:
+#     - 墙体仍由原有局部坐标构造，保持单个 8 连通分量、恰好 2 个端点、开口外侧至少有 3 格空间。
+#     - 种子只从合法 interior 背景格中选取，且限制在中轴 3 列/3 行内，因此不会与墙重叠，也能保证射线束能从开口穿出。
+#     - 障碍仍只放在背景格，并用距离变换和最小切比雪夫间隔过滤，避免贴墙或彼此重叠。
+#   visual_observability:
+#     - 解题者能在少量样例里稳定看到：墙内大面积空白仍保留，但有一束与开口方向一致的宽虚线穿过腔体并射出边界。
+#     - “宽度固定 3”由同一层同时出现的 3 个并排像素给出；“间歇”由层层断开给出；“不填充区域”由未被染满的腔体给出。
+#     - 这些线索都来自可见几何关系，不依赖颜色编号或隐藏排序。
+#   visual_cleanliness:
+#     - 输出只增加一种新形态：规则的 3 像素宽虚线束。没有再叠加区域填充，因此画面比原题更干净。
+#     - 障碍仍保持少量孤立点，最多只截断部分通道，不会把宽束打碎成难以辨认的噪声。
+#   color_inference:
+#     - 仍然只扩张种子色，不引入新颜色映射。颜色推断负担和原题相同，变化完全由轨迹形态承担。
+
+
+def _sgn(x: int) -> int:
+    return (x > 0) - (x < 0)
+
+
+def _degree1_pixels(points):
+    """Return degree-1 pixels (exactly one 8-neighbor in the set)."""
+    pts = set(points)
+    return [(r, c) for r, c in pts if sum((rr, cc) in pts for rr, cc in neighbors8(r, c)) == 1]
+
+
+def _analyze_scene(grid: np.ndarray) -> dict[str, object]:
+    """Recover the wall component, opening direction, and beam axis from the visible scene."""
+    g = np.array(grid, copy=False)
+    h, w = g.shape
+    bg = get_bg(g)
+    vals = [int(v) for v in np.unique(g) if int(v) != bg]
+    assert vals, "expected at least one non-background color"
+
+    wall = max(vals, key=lambda c: int((g == c).sum()))
+    wall_mask = g == wall
+    comps = [set((int(r), int(c)) for r, c in pts) for pts in components_mask(wall_mask, connectivity=8)]
+    assert comps, "expected at least one wall connected component"
+
+    other_colors = [c for c in vals if c != wall]
+    assert other_colors, "expected at least one non-wall color"
+
+    wall_points = [p for comp in comps for p in comp]
+
+    def min_dist_to_wall(color: int) -> tuple[int, int]:
+        pts = [(int(r), int(c)) for r, c in zip(*np.where(g == color))]
+        best_d = 10**9
+        for r, c in pts:
+            for wr, wc in wall_points:
+                d = abs(r - wr) + abs(c - wc)
+                if d < best_d:
+                    best_d = d
+                    if best_d == 0:
+                        return 0, len(pts)
+        return best_d, len(pts)
+
+    fill = min(other_colors, key=lambda c: (min_dist_to_wall(c)[0], min_dist_to_wall(c)[1]))
+    fill_pos = [(int(r), int(c)) for r, c in zip(*np.where(g == fill))]
+    assert fill_pos, "expected at least one seed pixel"
+
+    def comp_min_dist(comp: set[tuple[int, int]]) -> int:
+        best_d = 10**9
+        for r, c in fill_pos:
+            for wr, wc in comp:
+                d = abs(r - wr) + abs(c - wc)
+                if d < best_d:
+                    best_d = d
+                    if best_d == 0:
+                        return 0
+        return best_d
+
+    wall_comp = min(comps, key=lambda comp: (comp_min_dist(comp), -len(comp)))
+    comp_mask = np.zeros_like(wall_mask, dtype=bool)
+    for r, c in wall_comp:
+        comp_mask[r, c] = True
+
+    def comp_neighbors(r: int, c: int) -> list[tuple[int, int]]:
+        out = []
+        for rr, cc in neighbors8(r, c):
+            if 0 <= rr < h and 0 <= cc < w and comp_mask[rr, cc]:
+                out.append((rr, cc))
+        return out
+
+    endpoints = [(r, c) for r, c in wall_comp if len(comp_neighbors(r, c)) == 1]
+    assert len(endpoints) == 2, "expected exactly two wall endpoints"
+
+    def outward_dir(ep: tuple[int, int]) -> tuple[int, int]:
+        n1 = comp_neighbors(*ep)[0]
+        d1 = (_sgn(n1[0] - ep[0]), _sgn(n1[1] - ep[1]))
+        d_use = d1
+        n2s = [p for p in comp_neighbors(*n1) if p != ep]
+        if n2s:
+            n2 = n2s[0]
+            d2 = (_sgn(n2[0] - n1[0]), _sgn(n2[1] - n1[1]))
+            if (d1[0] == 0) ^ (d1[1] == 0):
+                if d2[0] != 0 and d2[1] != 0:
+                    d_use = d2
+        return -d_use[0], -d_use[1]
+
+    out_dirs = [outward_dir(ep) for ep in endpoints]
+    dr_sum = sum(d[0] for d in out_dirs)
+    dc_sum = sum(d[1] for d in out_dirs)
+    rad = (_sgn(dr_sum), _sgn(dc_sum))
+    assert rad in {(-1, 0), (1, 0), (0, -1), (0, 1)}, "expected cardinal radiate direction"
+
+    if rad[0] != 0:
+        beam_center = (min(c for _, c in endpoints) + max(c for _, c in endpoints)) // 2
+        start_face = max(r for r, _ in fill_pos) if rad == (1, 0) else min(r for r, _ in fill_pos)
+        opening_span = max(c for _, c in endpoints) - min(c for _, c in endpoints) + 1
+    else:
+        beam_center = (min(r for r, _ in endpoints) + max(r for r, _ in endpoints)) // 2
+        start_face = max(c for _, c in fill_pos) if rad == (0, 1) else min(c for _, c in fill_pos)
+        opening_span = max(r for r, _ in endpoints) - min(r for r, _ in endpoints) + 1
+
+    return {
+        "grid": g,
+        "h": int(h),
+        "w": int(w),
+        "bg": int(bg),
+        "wall": int(wall),
+        "fill": int(fill),
+        "fill_pos": fill_pos,
+        "endpoints": endpoints,
+        "rad": rad,
+        "beam_center": int(beam_center),
+        "start_face": int(start_face),
+        "opening_span": int(opening_span),
+    }
+
+
+def _cast_beam(grid: np.ndarray, *, dashed: bool, width: int) -> np.ndarray:
+    """Draw a direct beam from the seed front, preserving walls and stopping at obstacles."""
+    info = _analyze_scene(grid)
+    g = np.array(grid, copy=True)
+    h = int(info["h"])
+    w = int(info["w"])
+    bg = int(info["bg"])
+    wall = int(info["wall"])
+    fill = int(info["fill"])
+    rad = tuple(info["rad"])
+    center = int(info["beam_center"])
+    start_face = int(info["start_face"])
+
+    half = width // 2
+    out = g.copy()
+
+    if rad[0] != 0:
+        lane_vals = [c for c in range(center - half, center + half + 1) if 0 <= c < w]
+        step_sign = rad[0]
+        for c in lane_vals:
+            depth = 0
+            r = start_face
+            while True:
+                r += step_sign
+                depth += 1
+                if not (0 <= r < h):
+                    break
+                cell = int(g[r, c])
+                if cell == wall or (cell != bg and cell != fill):
+                    break
+                if dashed and depth % 2 == 0:
+                    continue
+                if cell == bg:
+                    out[r, c] = fill
+    else:
+        lane_vals = [r for r in range(center - half, center + half + 1) if 0 <= r < h]
+        step_sign = rad[1]
+        for r in lane_vals:
+            depth = 0
+            c = start_face
+            while True:
+                c += step_sign
+                depth += 1
+                if not (0 <= c < w):
+                    break
+                cell = int(g[r, c])
+                if cell == wall or (cell != bg and cell != fill):
+                    break
+                if dashed and depth % 2 == 0:
+                    continue
+                if cell == bg:
+                    out[r, c] = fill
+
+    return out
+
+
+def _new_fill_mask(inp: np.ndarray, out: np.ndarray, fill: int) -> np.ndarray:
+    return (out == fill) & (inp != fill)
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Keep the half-enclosed chamber hollow and shoot a wide dashed beam through its opening.
+
+    Input structure:
+    - The background is the most common color, and the most frequent non-background color forms a single wall component with one open side.
+    - A nearby non-wall color marks the source seed inside the chamber; any remaining non-background pixels are fixed obstacles.
+
+    Rule:
+    - Do not flood-fill the chamber. Instead, use the wall endpoints to infer the outward opening direction and launch a beam of the seed color straight along that axis.
+    - The beam is always 3 pixels wide, aligned to the opening's midpoint, colors every other step to form a dashed trail, and each lane stops independently when it hits a wall or obstacle.
+
+    Key insight:
+    - The solver must fuse three visible cues at once: the chamber stays hollow, the emitted trail is a 3-cell-thick stripe rather than a region fill, and that stripe follows a one-on/one-off dash rhythm along the opening direction.
+    """
+    return _cast_beam(grid, dashed=True, width=3)
+
+
+# --------------- generator (combo D1/0 + D3/1 + D14/2) ---------------
+
+GRID_H_VERT = (11, 18)
+GRID_H_HORIZ = (8, 18)
+GRID_W = (15, 19)
+
+WALL_PIXELS_MIN = 17
+WALL_PIXELS_MAX = 25
+DEPTH_VERT = (5, 10)
+DEPTH_HORIZ = (6, 8)
+GAP_VERT = (6, 7)
+GAP_HORIZ = (5, 7)
+TIP_12_PROB = 0.5
+
+OPEN_END_MARGIN = 3
+
+SEED_SIZE_WEIGHTS = [1, 1, 1, 2, 2, 3]
+SEED_DEPTH_LOOKBACK = 3
+
+MAX_OBSTACLES = 5
+OBSTACLE_IN_FILL_PROB = 0.65
+OBSTACLE_MIN_SEP = 2
+
+MIN_NEW_FILL = 10
+MIN_DASH_REMOVALS = 5
+MIN_THICKNESS_BONUS = 8
+MIN_VISIBLE_EXTERIOR = 6
+MIN_INTERIOR_EMPTY = 6
+PALETTE_SIZE = (3, 5)
+GEN_RETRIES = 400
+
+
+def _make_arm(depth, start_v, target_v, extra_steps, tip_12=False):
+    """Build one zigzag arm from (0, start_v) toward (depth, target_v)."""
+    sign = 1 if target_v > start_v else -1
+    n_side_steps = abs(target_v - start_v)
+    chosen_rows = []
+    if n_side_steps:
+        if tip_12:
+            chosen_rows = [2 * (i + 1) for i in range(n_side_steps)]
+            extra_steps = 0
+        else:
+            chosen_rows = [1]
+            if n_side_steps > 1:
+                chosen_rows += random.sample(range(2, depth + 1), n_side_steps - 1)
+            chosen_rows.sort()
+
+    first_row = chosen_rows[0] if chosen_rows else 1
+    extra_rows = [r for r in chosen_rows if r != first_row]
+    random.shuffle(extra_rows)
+    orthogonal_rows = set(extra_rows[:extra_steps])
+
+    pts = [(0, start_v)]
+    u, v = 0, start_v
+    for row in range(1, depth + 1):
+        u += 1
+        if row in orthogonal_rows:
+            pts.append((u, v))
+            v += sign
+        elif row in chosen_rows:
+            v += sign
+        pts.append((u, v))
+    return pts
+
+
+def _build_local_wall(rad, h, w):
+    """Construct wall shape in local (u, v) coordinates. Returns (pts, depth, gap) or None."""
+    if rad[0]:
+        max_depth = min(DEPTH_VERT[1], h - 6)
+        if max_depth < DEPTH_VERT[0]:
+            return None
+        depth = random.randint(DEPTH_VERT[0], max_depth)
+        gap = random.randint(*GAP_VERT)
+    else:
+        depth = random.randint(DEPTH_HORIZ[0], min(DEPTH_HORIZ[1], w - 6))
+        gap = random.randint(GAP_HORIZ[0], min(GAP_HORIZ[1], h - 1))
+
+    if gap == 5:
+        left_bottom, right_bottom = 2, 3
+    elif gap == 6:
+        left_bottom, right_bottom = 2, 4
+    else:
+        left_bottom, right_bottom = random.choice([(2, 5), (3, 4)])
+
+    bridge_extra = max(0, right_bottom - left_bottom - 1)
+    base_count = 2 * (depth + 1) + bridge_extra
+    max_extra_l = max(0, left_bottom - 1)
+    max_extra_r = max(0, gap - right_bottom - 1)
+    min_extra = max(0, WALL_PIXELS_MIN - base_count)
+    max_extra = min(max_extra_l + max_extra_r, WALL_PIXELS_MAX - base_count)
+    if min_extra > max_extra:
+        return None
+
+    extra = random.randint(min_extra, max_extra)
+    extra_l = random.randint(max(0, extra - max_extra_r), min(max_extra_l, extra))
+    extra_r = extra - extra_l
+
+    max_n_side = max(left_bottom, gap - right_bottom)
+    tip_12 = depth >= 2 * max_n_side and random.random() < TIP_12_PROB
+    left = _make_arm(depth, 0, left_bottom, extra_l, tip_12=tip_12)
+    right = _make_arm(depth, gap, right_bottom, extra_r, tip_12=tip_12)
+    pts = set(left) | set(right)
+    for v in range(left_bottom, right_bottom + 1):
+        pts.add((depth, v))
+
+    while len(pts) < WALL_PIXELS_MIN:
+        candidates = [
+            (u, v)
+            for u in range(max(0, depth - 3), depth + 1)
+            for v in range(gap + 1)
+            if (u, v) not in pts
+            and sum(
+                (uu, vv) in pts
+                for uu in range(u - 1, u + 2)
+                for vv in range(v - 1, v + 2)
+                if (uu, vv) != (u, v)
+            )
+            >= 2
+        ]
+        random.shuffle(candidates)
+        added = False
+        for p in candidates:
+            trial = pts | {p}
+            if len(trial) <= WALL_PIXELS_MAX and len(_degree1_pixels(trial)) == 2:
+                pts = trial
+                added = True
+                break
+        if not added:
+            return None
+
+    if not (WALL_PIXELS_MIN <= len(pts) <= WALL_PIXELS_MAX) or len(_degree1_pixels(pts)) != 2:
+        return None
+    return pts, depth, gap
+
+
+def _map_local(u, v, rad, anchor):
+    """Map local (u, v) to grid (r, c) given radiate direction and anchor."""
+    r0, c0 = anchor
+    if rad == (-1, 0):
+        return r0 + u, c0 + v
+    if rad == (1, 0):
+        return r0 - u, c0 + v
+    if rad == (0, -1):
+        return r0 + v, c0 + u
+    return r0 + v, c0 - u
+
+
+def _place_anchor(rad, h, w, depth, gap):
+    """Choose anchor so the wall fits within margins."""
+    if rad == (-1, 0):
+        return random.randint(OPEN_END_MARGIN, h - depth - 3), random.randint(0, w - gap - 1)
+    if rad == (1, 0):
+        return random.randint(depth + 2, h - 4), random.randint(0, w - gap - 1)
+    if rad == (0, -1):
+        return random.randint(0, h - gap - 1), random.randint(OPEN_END_MARGIN, w - depth - 3)
+    return random.randint(0, h - gap - 1), random.randint(depth + 2, w - 4)
+
+
+def _local_interior(wall, depth, gap):
+    """Return bg cells strictly between the two wall arms in local coords."""
+    by_row = {}
+    for u, v in wall:
+        by_row.setdefault(u, []).append(v)
+    interior = []
+    for u in range(1, depth):
+        if u not in by_row or len(by_row[u]) < 2:
+            continue
+        lo, hi = min(by_row[u]), max(by_row[u])
+        for v in range(lo + 1, hi):
+            if (u, v) not in wall:
+                interior.append((u, v))
+    return interior
+
+
+def _grow_seed_blob(seed, interior_set, beam_band):
+    """Grow a small 4-connected blob while keeping it inside the beam band."""
+    blob = {seed}
+    target_size = random.choice(SEED_SIZE_WEIGHTS)
+    frontier = [seed]
+    while len(blob) < target_size and frontier:
+        p = frontier.pop(random.randrange(len(frontier)))
+        u, v = p
+        for q in random.sample([(u - 1, v), (u + 1, v), (u, v - 1), (u, v + 1)], 4):
+            if q in interior_set and q not in blob and abs(q[1] - beam_band) <= 1:
+                blob.add(q)
+                frontier.append(q)
+                if len(blob) >= target_size:
+                    break
+    return blob
+
+
+def _obstacle_fits(pos, placed):
+    """Check that pos is at least Chebyshev OBSTACLE_MIN_SEP from all placed obstacles."""
+    r, c = pos
+    return all(max(abs(r - rr), abs(c - cc)) >= OBSTACLE_MIN_SEP for rr, cc in placed)
+
+
+def _find_obstacle_candidates(grid, bg, wall_color, nominal_fill_zone):
+    """Find background cells far enough from the wall, preferring cells on the beam path."""
+    wall_mask = grid == wall_color
+    dist = distance_transform_cdt(~wall_mask, metric="taxicab")
+    far_from_wall = dist > 1
+    eligible = (grid == bg) & far_from_wall
+    all_coords = list(zip(*np.where(eligible)))
+    fill_coords = [p for p in all_coords if nominal_fill_zone[p[0], p[1]]]
+    random.shuffle(all_coords)
+    random.shuffle(fill_coords)
+    return [(int(r), int(c)) for r, c in all_coords], [(int(r), int(c)) for r, c in fill_coords]
+
+
+def _place_obstacles(n_obstacles, candidates, fill_candidates, obstacle_colors, grid):
+    """Place up to n_obstacles on the grid, preferring some on the beam corridor."""
+    placed = []
+    n_fill = random.randint(0, min(n_obstacles, len(fill_candidates)))
+    if fill_candidates and random.random() < OBSTACLE_IN_FILL_PROB:
+        n_fill = max(1, n_fill)
+    for p in fill_candidates:
+        if len(placed) >= n_fill:
+            break
+        if _obstacle_fits(p, placed):
+            placed.append(p)
+    placed_set = set(placed)
+    for p in candidates:
+        if len(placed) >= n_obstacles:
+            break
+        if p not in placed_set and _obstacle_fits(p, placed):
+            placed.append(p)
+            placed_set.add(p)
+    for i, (r, c) in enumerate(placed):
+        grid[r, c] = obstacle_colors[i % len(obstacle_colors)]
+
+
+def _touches_border(mask):
+    """Check if any True cell in mask lies on the grid border."""
+    return bool(mask[0, :].any() or mask[-1, :].any() or mask[:, 0].any() or mask[:, -1].any())
+
+
+def _variant_metrics(grid: np.ndarray, interior_mask: np.ndarray) -> tuple[np.ndarray, dict[str, int]]:
+    wide_dash = _cast_beam(grid, dashed=True, width=3)
+    wide_cont = _cast_beam(grid, dashed=False, width=3)
+    thin_dash = _cast_beam(grid, dashed=True, width=1)
+    sig = _analyze_scene(grid)
+    fill = int(sig["fill"])
+    bg = int(sig["bg"])
+    dr, dc = sig["rad"]
+    endpoints = list(sig["endpoints"])
+    if dr != 0:
+        open_proj = max(r for r, _ in endpoints) if dr > 0 else min(r for r, _ in endpoints)
+    else:
+        open_proj = max(c for _, c in endpoints) if dc > 0 else min(c for _, c in endpoints)
+
+    rr, cc = np.indices(grid.shape)
+    if dr != 0:
+        depth = (rr - open_proj) * dr
+    else:
+        depth = (cc - open_proj) * dc
+    exterior = depth > 0
+
+    wide_dash_new = _new_fill_mask(grid, wide_dash, fill)
+    wide_cont_new = _new_fill_mask(grid, wide_cont, fill)
+    thin_dash_new = _new_fill_mask(grid, thin_dash, fill)
+
+    metrics = {
+        "variant_new_fill": int(wide_dash_new.sum()),
+        "dash_removed": int((wide_cont_new & ~wide_dash_new).sum()),
+        "thickness_bonus": int((wide_dash_new & ~thin_dash_new).sum()),
+        "visible_exterior": int((wide_dash_new & exterior).sum()),
+        "interior_new": int((wide_dash_new & interior_mask).sum()),
+        "interior_empty": int(interior_mask.sum() - (wide_dash_new & interior_mask).sum()),
+        "border_touch": int(_touches_border(wide_dash_new)),
+        "opening_span": int(sig["opening_span"]),
+        "beam_center": int(sig["beam_center"]),
+        "dash_layers": int((wide_dash_new & exterior).sum() // max(1, 3)),
+    }
+    return wide_dash, metrics
+
+
+def _gen_attempt():
+    """Single attempt to generate a valid input grid."""
+    rad = random.choice([(-1, 0), (1, 0), (0, -1), (0, 1)])
+    h = random.randint(*GRID_H_VERT) if rad[0] else random.randint(*GRID_H_HORIZ)
+    w = random.randint(*GRID_W)
+
+    built = _build_local_wall(rad, h, w)
+    if built is None:
+        return None
+    local_wall, depth, gap = built
+    anchor = _place_anchor(rad, h, w, depth, gap)
+
+    palette = random.sample(range(10), random.randint(*PALETTE_SIZE))
+    bg, wall_color, fill_color = palette[:3]
+    obstacle_colors = palette[3:]
+
+    grid = np.full((h, w), bg, dtype=int)
+    for u, v in local_wall:
+        r, c = _map_local(u, v, rad, anchor)
+        grid[r, c] = wall_color
+
+    interior = _local_interior(local_wall, depth, gap)
+    if len(interior) < 8:
+        return None
+
+    beam_center_local = gap // 2
+    wall_set = set(local_wall)
+    adjacent = [
+        p
+        for p in interior
+        if any((p[0] + dr, p[1] + dc) in wall_set for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)])
+    ]
+    seed_pool = [
+        p
+        for p in adjacent
+        if p[0] >= max(1, depth - SEED_DEPTH_LOOKBACK) and abs(p[1] - beam_center_local) <= 1
+    ]
+    if not seed_pool:
+        return None
+
+    blob = _grow_seed_blob(random.choice(seed_pool), set(interior), beam_center_local)
+    if not blob:
+        return None
+
+    interior_mask = np.zeros_like(grid, dtype=bool)
+    for u, v in interior:
+        r, c = _map_local(u, v, rad, anchor)
+        interior_mask[r, c] = True
+
+    for u, v in blob:
+        r, c = _map_local(u, v, rad, anchor)
+        if grid[r, c] != bg:
+            return None
+        grid[r, c] = fill_color
+
+    nominal_out = _cast_beam(grid, dashed=False, width=3)
+    nominal_fill_zone = (nominal_out == fill_color) & (grid == bg)
+
+    n_obstacles = random.randint(0, MAX_OBSTACLES)
+    if n_obstacles and not obstacle_colors:
+        available = [c for c in range(10) if c not in (bg, wall_color, fill_color)]
+        obstacle_colors = random.sample(available, random.randint(1, 2))
+    if n_obstacles:
+        candidates, fill_candidates = _find_obstacle_candidates(grid, bg, wall_color, nominal_fill_zone)
+        _place_obstacles(n_obstacles, candidates, fill_candidates, obstacle_colors, grid)
+
+    try:
+        out, metrics = _variant_metrics(grid, interior_mask)
+    except Exception:
+        return None
+
+    new_fill = (out == fill_color) & (grid == bg)
+    if int(new_fill.sum()) < MIN_NEW_FILL:
+        return None
+    if not _touches_border(new_fill):
+        return None
+    if metrics["dash_removed"] < MIN_DASH_REMOVALS:
+        return None
+    if metrics["thickness_bonus"] < MIN_THICKNESS_BONUS:
+        return None
+    if metrics["visible_exterior"] < MIN_VISIBLE_EXTERIOR:
+        return None
+    if metrics["interior_empty"] < MIN_INTERIOR_EMPTY:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate valid b9e38dc0 combo input")

