+def _select_chains(
+    present: set[int], stop_side: int, second_hits: int
+) -> dict[int, int] | None:
+    """Pick source->target pairs for planned second hits."""
+    if second_hits == 0:
+        return {}
+    turn_sides = present - {stop_side}
+    candidates = [
+        (side, nxt)
+        for side in turn_sides
+        for nxt in ((side - 1) % 4, (side + 1) % 4)
+        if nxt in present
