LEGEND_CELL_STARTS = [1, 7, 13, 19]           # col offsets for legend cells

# Teal square
TEAL_SZ2_PROB = 0.75                           # P(size=2); else size=3
SQUARE_EDGE_GAP = 5                            # min gap from square to grid edges

# Obstacles
OBS_COUNT_4_PROB = 0.65                        # P(4 obstacles); else 3
OBS_THICKNESS_RANGE = (2, 4)                   # obstacle shorter-dimension bounds
OBS_SINGLE_MARGIN = 6                          # margin subtracted when only one side present
OBS_BOTH_GAP = 2                               # gap subtracted when both sides present

# Span selection
SPAN_MIN_MULT = 3                              # min obstacle length = SPAN_MIN_MULT * sz
SPAN_MAX_MULT = 14                             # max obstacle length = SPAN_MAX_MULT * sz
SPAN_COMPACT_PROB = 0.4                        # P(bias toward compact spans)

# Retry budget
MAX_RETRIES = 300


def _rot(d: int, turn: str) -> int:
    """Rotate direction d by turn ('L' = CCW, 'R' = CW)."""
    return (d - 1) % 4 if turn == "L" else (d + 1) % 4


# ── Obstacle span selection ───────────────────────────────────────────

def _choose_span(
    axis_len: int,
    required: list[tuple[int, int]],
    excluded: list[tuple[int, int]],
    min_len: int,
    max_len: int,
) -> tuple[int, int] | None:
    """Pick a (start, end) span covering all *required* intervals, avoiding all *excluded*."""
    req0 = min(a for a, _ in required)
    req1 = max(b for _, b in required)
    lo = max(min_len, req1 - req0 + 1)
    hi = min(max_len, axis_len)
    choices: list[tuple[int, int, int]] = []
    for length in range(lo, hi + 1):
        start0 = max(0, req1 - length + 1)
        start1 = min(req0, axis_len - length)
        for start in range(start0, start1 + 1):
            end = start + length - 1
            if all(end < a or start > b for a, b in excluded):
                choices.append((length, start, end))
    if not choices:
        return None

    # Bias mildly toward compact side bars while still covering long-span cases.
    lengths = sorted({length for length, _, _ in choices})
    if random.random() < SPAN_COMPACT_PROB:
        cutoff = lengths[min(len(lengths) - 1, max(0, len(lengths) // 2))]
        pool = [(start, end) for length, start, end in choices if length <= cutoff]
    else:
        pool = [(start, end) for _, start, end in choices]
    return random.choice(pool)


