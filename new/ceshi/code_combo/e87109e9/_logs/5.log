+OBS_THICKNESS_RANGE = (2, 4)
+OBS_SINGLE_MARGIN = 6
+OBS_BOTH_GAP = 2
+SPAN_MIN_LEN = 5
+SPAN_MAX_LEN = 16
+SPAN_COMPACT_PROB = 0.4
+
+MAX_RETRIES = 300
