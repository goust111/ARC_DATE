+
+def _simulate_paths(
+    base: np.ndarray,
+    turns: dict[int, str],
+    bg: int,
+    *,
+    inherit_color: bool,
+    recolor_obstacle: bool,
+    enforce_clean: bool,
+) -> tuple[np.ndarray, list[list[tuple[int, int, int, int]]], list[dict[tuple[int, int], int]], list[dict[str, int]]]:
+    """
