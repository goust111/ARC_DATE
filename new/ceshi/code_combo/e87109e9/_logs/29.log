+            rows = cells[:, 0].astype(int)
+            cols = cells[:, 1].astype(int)
+            id_grid[rows, cols] = oid
+            rows_list.append(rows)
+            cols_list.append(cols)
+            colors.append(int(color))
+            oid += 1
+    return id_grid, rows_list, cols_list, colors
