+    def paint_block(rr: int, cc: int, color: int, beam_cells: dict[tuple[int, int], int]) -> None:
+        blk_base = base[rr : rr + sz, cc : cc + sz]
+        bg_rows, bg_cols = np.where(blk_base == bg)
