+    spans: dict[int, tuple[int, int]] = {}
+    for side in present:
+        axis_len = w if side in (_N, _S) else h
+        span = _choose_span(
+            axis_len,
+            required[side],
+            excluded[side],
+            SPAN_MIN_MULT * sz,
+            min(SPAN_MAX_MULT * sz, axis_len),
+        )
+        if span is None:
+            return None
+        spans[side] = span
