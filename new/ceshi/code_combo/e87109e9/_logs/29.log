+            events.append(
+                {
+                    "beam": int(d0),
+                    "dir_before": int(d),
+                    "row": int(nr),
+                    "col": int(nc),
+                    "obstacle_id": int(oid),
+                    "input_color": int(input_colors[oid]),
+                    "obstacle_before": int(obstacle_color),
+                    "incoming_color": int(incoming_color),
+                }
+            )
+
+            if recolor_obstacle:
