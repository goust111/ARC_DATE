+
+    req_cols = [(sc, sc + sz - 1)]
+    req_rows_E = [(sr, sr + sz - 1), (lane_N, lane_N + sz - 1)]
+    req_rows_W = [(sr, sr + sz - 1), (lane_S, lane_S + sz - 1)]
+
+    spans: dict[int, tuple[int, int]] = {}
+    spans[_N] = _choose_span(
