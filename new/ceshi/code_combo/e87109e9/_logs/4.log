+TEAL_SZ2_PROB = 0.75
+SQUARE_EDGE_GAP = 5
+OBS_THICKNESS_RANGE = (2, 4)
+OBS_BOTH_GAP = 2
+SPAN_MIN_MULT = 3
+SPAN_MAX_MULT = 14
+SPAN_COMPACT_PROB = 0.45
+TURN_CAP = 2
+MAX_RETRIES = 400
