   316	def main(grid: np.ndarray) -> np.ndarray:
   317	    """
   318	    Trace four teal square-beams using obstacle shape as the base spin and a local marker as the turn modifier.
   319	
   320	    Input structure:
   321	    - A single main grid with one solid teal source square, 3-4 solid edge-attached obstacle rectangles, and one grey marker pixel beside each obstacle.
   322	    - Wider-than-tall obstacles encode a clockwise base spin; taller-than-wide obstacles encode a counterclockwise base spin.
   323	    - Each marker sits at one endpoint of the obstacle's inward-facing adjacent line, choosing the short or long version of that base turn.
   324	
   325	    Rule:
   326	    - Marker pixels are instructional only and revert to background in the output.
   327	    - Launch one sz-by-sz teal beam from the source square in each cardinal direction.
   328	    - A beam paints teal only onto background cells.
   329	    - When the next beam footprint meets an obstacle, first read the obstacle shape for clockwise vs counterclockwise, then read the marker endpoint:
   330	      start endpoint means use the short 90-degree version, far endpoint means use the long 270-degree version. Continue after the turn.
   331	    - Beams stop when the next footprint would leave the board.
   332	
   333	    Key insight:
   334	    - Turn behavior is now distributed across two local cues. Shape supplies the base rotational sense, while the nearby marker says whether to keep that short turn or flip it via the long route; neither cue is sufficient by itself.
   335	    """
   336	    g = np.asarray(grid, dtype=int)
   337	    vals, counts = np.unique(g, return_counts=True)
   338	    bg = int(vals[counts.argmax()])
   339	    assert bg != MARKER, "marker color cannot be the board background"
   340	
   341	    turns = _parse_fused_turns(g, bg)
   342	    base = _clean_base(g, bg)
   343	    out, _hits = _simulate_paths(base, turns, bg)
   344	    return out
