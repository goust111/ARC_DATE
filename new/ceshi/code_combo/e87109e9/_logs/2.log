   386	    """Compute obstacle thicknesses for the two ends of one axis."""
   387	    lo, hi_cap = OBS_THICKNESS_RANGE
   388	    if a_present and b_present:
   389	        room = axis - sz - OBS_BOTH_GAP
   390	        if room < 2 * lo:
   391	            return None
   392	        a = random.randint(lo, min(hi_cap, room - lo))
   393	        b = _rand_thickness(lo, min(hi_cap, room - a))
   394	        return (a, b) if b is not None else None
   395	    if a_present:
   396	        t = _rand_thickness(lo, min(hi_cap, axis - sz - OBS_SINGLE_MARGIN))
   397	        return (t, None) if t is not None else None
   398	    if b_present:
   399	        t = _rand_thickness(lo, min(hi_cap, axis - sz - OBS_SINGLE_MARGIN))
   400	        return (None, t) if t is not None else None
