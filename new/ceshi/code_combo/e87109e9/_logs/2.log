+_DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+_N, _E, _S, _W = range(4)
+
+OBSTACLE_COLOR_POOL = [1, 2, 3, 4, 6]
+BG_COLOR_POOL = [1, 2, 3, 4, 6, 7, 9]
+MARKER = 5
+TEAL = 8
+
+GRID_H_RANGE = (19, 24)
+GRID_W = 24
+
+TEAL_SZ2_PROB = 0.75
+SQUARE_EDGE_GAP = 5
+
+OBS_COUNT_4_PROB = 0.65
+OBS_THICKNESS_RANGE = (2, 4)
+OBS_SINGLE_MARGIN = 6
+OBS_BOTH_GAP = 2
+
+SPAN_MIN_MULT = 3
+SPAN_MAX_MULT = 14
+SPAN_COMPACT_PROB = 0.4
+
+MAX_RETRIES = 300
