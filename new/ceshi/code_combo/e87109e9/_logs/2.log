   347	def _choose_span(
   348	    axis_len: int,
   349	    required: list[tuple[int, int]],
   350	    excluded: list[tuple[int, int]],
   351	    min_len: int,
   352	    max_len: int,
   353	) -> tuple[int, int] | None:
   354	    """Pick a span covering all required intervals and avoiding all excluded ones."""
   355	    req0 = min(a for a, _ in required)
   356	    req1 = max(b for _, b in required)
   357	    lo = max(min_len, req1 - req0 + 1)
   358	    hi = min(max_len, axis_len)
   359	    choices: list[tuple[int, int, int]] = []
   360	    for length in range(lo, hi + 1):
   361	        start0 = max(0, req1 - length + 1)
   362	        start1 = min(req0, axis_len - length)
   363	        for start in range(start0, start1 + 1):
   364	            end = start + length - 1
   365	            if all(end < a or start > b for a, b in excluded):
   366	                choices.append((length, start, end))
   367	    if not choices:
   368	        return None
   369	
   370	    lengths = sorted({length for length, _, _ in choices})
   371	    if random.random() < SPAN_COMPACT_PROB:
   372	        cutoff = lengths[min(len(lengths) - 1, max(0, len(lengths) // 2))]
   373	        pool = [(start, end) for length, start, end in choices if length <= cutoff]
   374	    else:
   375	        pool = [(start, end) for _, start, end in choices]
   376	    return random.choice(pool)
