    source_mask[sr : sr + sz, sc : sc + sz] = True

    def in_bounds(r: int, c: int) -> bool:
        return 0 <= r and 0 <= c and r + sz - 1 < h and c + sz - 1 < w

    def paint(r: int, c: int, beam_mask: np.ndarray) -> None:
