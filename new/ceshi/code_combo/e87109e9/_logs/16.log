+    sr, sc = random.randint(min_r, max_r), random.randint(min_c, max_c)
+
+    lane = _lane_positions(h, w, sz, thickness)
+    feasible_pairs: list[tuple[int, int, tuple[int, int]]] = []
+    for side in present:
+        target = _cw_side(side)
+        if target not in present:
+            continue
+        arrival = _arrival_interval(side, "D", lane, sr, sc, sz, h, w)
