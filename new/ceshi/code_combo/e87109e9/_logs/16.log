+    if side4 == _S4:
+        return h - thickness, h - 1, s0, s1
+    if side4 == _W4:
+        return s0, s1, 0, thickness - 1
+    return s0, s1, w - thickness, w - 1
+
+
+def _native_interval(side4: int, sr: int, sc: int, sz: int) -> tuple[int, int]:
