+def _lane_positions(h: int, w: int, sz: int, thickness: dict[int, int]) -> dict[int, int]:
+    lane: dict[int, int] = {}
+    if _N4 in thickness:
+        lane[_N4] = thickness[_N4]
+    if _S4 in thickness:
+        lane[_S4] = h - thickness[_S4] - sz
+    if _W4 in thickness:
+        lane[_W4] = thickness[_W4]
+    if _E4 in thickness:
+        lane[_E4] = w - thickness[_E4] - sz
+    return lane
+
+
+def _turn_anchor(side4: int, lane: dict[int, int], sr: int, sc: int) -> tuple[int, int]:
+    if side4 == _N4:
+        return lane[_N4], sc
+    if side4 == _E4:
+        return sr, lane[_E4]
+    if side4 == _S4:
+        return lane[_S4], sc
+    return sr, lane[_W4]
+
+
+def _arrival_interval(
+    side4: int,
+    action: str,
+    lane: dict[int, int],
+    sr: int,
+    sc: int,
+    sz: int,
+    h: int,
