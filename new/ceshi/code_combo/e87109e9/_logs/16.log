+    len_b = random.randint(2, 4)
+    len_c = random.randint(max(5, 2 * sz), min(10, h - 6))
+    gap_n = random.randint(3, 6)
+    gap_w = random.randint(max(3, sz), 6)
+    k = random.randint(3, 5)
