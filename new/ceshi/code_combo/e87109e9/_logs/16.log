+# Combo variant of e87109e9 (index 16)
+# combo_spec: D2/1+D19/0
+# Name: 可变转弯角度含45度
+
+import random
+import sys
+from pathlib import Path
+
+import numpy as np
+
+for _parent in Path(__file__).resolve().parents:
