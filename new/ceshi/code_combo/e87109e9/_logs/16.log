+    sides = [_N4, _E4, _S4, _W4]
+    d_source = random.choice(sides)
+    d_target = _cw_side(d_source)
+    present = {d_source, d_target}
+    others = [s for s in sides if s not in present]
+    need_more = obstacle_count - 2
+    if need_more > 0:
+        present.update(random.sample(others, need_more))
+
+    ns = _thickness_pair(h, sz, _N4 in present, _S4 in present)
+    ew = _thickness_pair(w, sz, _W4 in present, _E4 in present)
+    if ns is None or ew is None:
+        return None
+    thickness = {s: t for s, t in zip((_N4, _S4, _W4, _E4), (*ns, *ew)) if t is not None}
