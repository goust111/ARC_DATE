+        ((_E4, obstacle_colors[1], "D"), (br0, br1, bc0, bc0 + t_b - 1)),
+        ((_W4, obstacle_colors[2], "L"), (cr0, cr1, cc0, cc1)),
+    ]
+
+    side_action: dict[int, str] = {}
