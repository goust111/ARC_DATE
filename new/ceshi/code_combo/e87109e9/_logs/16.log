+def _turn_anchor(side4: int, lane: dict[int, int], sr: int, sc: int) -> tuple[int, int]:
+    if side4 == _N4:
+        return lane[_N4], sc
+    if side4 == _E4:
+        return sr, lane[_E4]
+    if side4 == _S4:
+        return lane[_S4], sc
+    return sr, lane[_W4]
