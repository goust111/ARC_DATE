+    vals, cnts = np.unique(base, return_counts=True)
+    if int(vals[cnts.argmax()]) != bg:
+        return None
+
+    actions = {side_color[s]: side_action[s] for s in present}
+    for color in legend_colors:
+        actions.setdefault(color, random.choice(["L", "D"]))
