+            return None
+        k = goal - c0 if dc > 0 else c0 - goal
+    else:
+        if dr == 0:
+            return None
+        k = goal - r0 if dr > 0 else r0 - goal
+    if k < 0:
+        return None
+    r = r0 + k * dr
+    c = c0 + k * dc
