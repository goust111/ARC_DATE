+    a_lane_min = max(t_a + 2, k + 2)
+    a_lane_max = min(11, h - gap_n - sz - 3)
+    if a_lane_min > a_lane_max:
+        return None
+    a_lane = random.randint(a_lane_min, a_lane_max)
+    sr = a_lane + gap_n
+    if sr + sz >= h - 2:
+        return None
+
+    ar0 = a_lane - t_a
+    ac1 = sc
+    ac0 = max(sc - len_a + 1, 1)
+    if ac0 <= sc - gap_w - 1:
+        return None
+
+    br_hit_r = a_lane - k
+    if br_hit_r < 1:
+        return None
+    bc0 = sc + k + sz
+    br0 = br_hit_r
+    br1 = br0 + len_b - 1
+
+    cc_lane = sc - gap_w
+    cc1 = cc_lane - 1
+    cc0 = cc1 - t_c + 1
+    if ar0 < 1 or cc0 < 1 or br1 >= h - 1 or bc0 + t_b - 1 >= w - 1:
+        return None
+
+    cr0_lo = max(a_lane + 1, 1)
+    cr0_hi = min(sr, h - len_c - 1)
+    if cr0_lo > cr0_hi:
+        return None
+    cr0 = random.randint(cr0_lo, cr0_hi)
+    cr1 = cr0 + len_c - 1
