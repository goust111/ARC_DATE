+    hit_counts = [len(beam["hits"]) for beam in beams]
+    hit_colors = {hit[1] for beam in beams for hit in beam["hits"]}
+    diagonal_steps = [int(beam["diagonal_steps"]) for beam in beams]
+    if any(c > 2 for c in hit_counts):
