+    dr, dc = _DIRS8[_dir_to_diag(side4)]
+    goal = lane[target]
+    if target in (_W4, _E4):
+        if dc == 0:
+            return None
+        k = goal - c0 if dc > 0 else c0 - goal
+    else:
+        if dr == 0:
+            return None
+        k = goal - r0 if dr > 0 else r0 - goal
+    if k < 0:
+        return None
+    r = r0 + k * dr
+    c = c0 + k * dc
+    interval = (r, r + sz - 1) if target in (_W4, _E4) else (c, c + sz - 1)
