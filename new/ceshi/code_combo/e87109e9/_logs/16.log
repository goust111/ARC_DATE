+    lane = _lane_positions(h, w, sz, thickness)
+
+    d_arrival = _arrival_interval(d_source, "D", lane, sr, sc, sz, h, w)
+    if d_arrival is None or d_arrival[0] != d_target:
+        return None
+
+    side_action: dict[int, str] = {side: random.choice(["L", "D"]) for side in present}
+    side_action[d_source] = "D"
+    side_action[d_target] = "D"
+
