+    for d0 in range(4):
+        r, c, d = int(sr), int(sc), d0
+        seen: set[tuple[int, int, int]] = set()
+        while True:
+            state = (r, c, d)
+            assert state not in seen
+            seen.add(state)
+            dr, dc = dirs4[d]
+            nr, nc = r + dr, c + dc
+            if not in_bounds(nr, nc):
+                break
+            obs = obstacle_at(nr, nc)
+            if obs is None:
+                r, c = nr, nc
+                paint(r, c)
+                continue
+            turn = actions[obs]
+            d = (d - 1) % 4 if turn == "L" else _legacy_rot_cw(d)
