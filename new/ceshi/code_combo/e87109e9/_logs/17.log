+
+
+def _build_beam(
+    base: np.ndarray,
+    sim: np.ndarray,
+    turns: dict[int, str],
+    colors: list[int],
+    bg: int,
+    src: tuple[int, int, int],
+    d0: int,
+    placements_goal: int,
+) -> bool:
+    sr, sc, sz = src
+    _paint_block.sz = sz
+    r, c, d = sr, sc, d0
+    straight = 0
+    placed = 0
+    hits = 0
+    budget = sim.shape[0] * sim.shape[1] * 12
+
+    while budget > 0:
+        budget -= 1
+        dr, dc = _DIRS[d]
+        nr, nc = r + dr, c + dc
+        if not _in_bounds(sim.shape, nr, nc, sz):
+            break
+
+        try:
+            info = _obstacle_info(sim, nr, nc, sz, bg)
+        except AssertionError:
