+                for dr, dc in _DIRS:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < H and 0 <= nc < W and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+    return count
+
+
+def _place_decoy(
+    base: np.ndarray,
+    sim: np.ndarray,
+    bg: int,
+    src: tuple[int, int, int],
+    colors: list[int],
+) -> bool:
