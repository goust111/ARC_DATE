import numpy as np, random
DIRS=[(-1,0),(0,1),(1,0),(0,-1)]
N,E,S,W=range(4)

def frontier_slice(r,c,sz,d):
    if d==N:return (slice(r,r+1),slice(c,c+sz))
    if d==S:return (slice(r+sz-1,r+sz),slice(c,c+sz))
    if d==W:return (slice(r,r+sz),slice(c,c+1))
    return (slice(r,r+sz),slice(c+sz-1,c+sz))

def reflect(mask,d,sz):
    if d in (N,S):
        cols=np.where(mask[0])[0]
        if cols[0]==0 and cols[-1]==sz-1:return d"'^2
        return E if cols.mean() < (sz-1)/2 else W
    rows=np.where(mask[:,0])[0]
    if rows[0]==0 and rows[-1]==sz-1:return d''^2
    return S if rows.mean() < (sz-1)/2 else N

def sim(base,src,bg=1,teal=8,max_steps=700,border_bounce=True):
    H,W=base.shape
    sr,sc,sz=src
    out=base.copy(); gt=np.zeros_like(base,dtype=bool); gt[sr:sr+sz,sc:sc+sz]=True; total={'"'edge':0,'obs':0,'turn90':0}
    for d0 in range(4):
        r,c,d=sr,sc,d0; seen=set(); pre=gt.copy()
        for _ in range(max_steps):
            if (r,c,d) in seen: break
            seen.add((r,c,d))
            dr,dc=DIRS[d]; nr,nc=r+dr,c+dc
            if not (0<=nr and 0<=nc and nr+sz<=H and nc+sz<=W):
                if not border_bounce: break
                nd=d"'^2
                total['"'edge']+=1
                if nd"'!=d''^2: pass
                d=nd
                continue
            fr=frontier_slice(nr,nc,sz,d); strip=base[fr]; obs=(strip!=bg)&(strip!=8)
            if obs.any():
                nd=reflect(obs,d,sz)
                total['"'obs']+=1
                if nd "'!= (d''^2): total['"'turn90']+=1
                d=nd
                continue
            if pre[fr].any(): break
            r,c=nr,nc; band=out[fr]; band[band==bg]=8; out[fr]=band
        gt |= (out==8)
    return out,total

def build(H,W,sz,sr,sc):
    bg=1;t=4
    base=np.full((H,W),bg,int); base[sr:sr+sz,sc:sc+sz]=8
    L=5; top_row=t; left_col=t; bottom_row=H-t-sz
