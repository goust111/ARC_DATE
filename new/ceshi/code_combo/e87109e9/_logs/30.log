+    assert len(candidates) == 1, "main grid must contain exactly one solid teal square"
+    return candidates[0]
+
+
+def _frontier_slice(r: int, c: int, sz: int, d: int) -> tuple[slice, slice]:
+    if d == _N:
+        return slice(r, r + 1), slice(c, c + sz)
+    if d == _S:
