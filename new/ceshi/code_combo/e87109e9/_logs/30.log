+    rows = np.where(mask[:, 0])[0]
+    assert rows.size
+    if int(rows[0]) == 0 and int(rows[-1]) == sz - 1:
+        return d ^ 2
+    return _S if float(rows.mean()) < (sz - 1) / 2 else _N
