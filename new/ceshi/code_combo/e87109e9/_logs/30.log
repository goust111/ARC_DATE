/bin/bash -lc "python - <<'PY'
import numpy as np

DIRS=[(-1,0),(0,1),(1,0),(0,-1)]
N,E,S,W=range(4)

def reflect_from_overlap(mask,d,sz):
    if d in (N,S):
        cols=np.where(mask.any(axis=0))[0]
        if len(cols)==0:return d"'^2
        if cols[0]==0 and cols[-1]==sz-1:
            return d''^2
        return E if cols.mean() < (sz-1)/2 else W
    rows=np.where(mask.any(axis=1))[0]
    if len(rows)==0:return d''^2
    if rows[0]==0 and rows[-1]==sz-1:
        return d''^2
    return S if rows.mean() < (sz-1)/2 else N

def sim(base,src,bg=1,teal=8,max_steps=200):
    H,W=base.shape
    sr,sc,sz=src
    out=base.copy()
    global_trail=np.zeros_like(base,dtype=bool)
    global_trail[sr:sr+sz,sc:sc+sz]=True
    def in_bounds(r,c):
        return 0<=r and 0<=c and r+sz<=H and c+sz<=W
    stats=[]
    for d0 in range(4):
        r,c,d=sr,sc,d0
        seen=set()
        pre=global_trail.copy()
        st={'"'edge':0,'obs':0,'steps':0,'dirs':[d0]}
        for _ in range(max_steps):
            state=(r,c,d)
            if state in seen: break
            seen.add(state)
            dr,dc=DIRS[d]
            nr,nc=r+dr,c+dc
            if not in_bounds(nr,nc):
                d"'^=2
                st['"'edge']+=1
                st['dirs'].append(d)
                continue
            blk=base[nr:nr+sz,nc:nc+sz]
            obs=(blk"'!=bg)&(blk!=teal)
            if obs.any():
                d=reflect_from_overlap(obs,d,sz)
                st['"'obs']+=1
                st['dirs'].append(d)
                continue
            if pre[nr:nr+sz,nc:nc+sz].any():
                break
            r,c=nr,nc
            out[r:r+sz,c:c+sz][out[r:r+sz,c:c+sz]==bg]=teal
            st['steps']+=1
        global_trail |= (out==teal)
        stats.append(st)
    return out,stats

H,W=22,24
bg=1
sz=2
sr,sc=9,10
base=np.full((H,W),bg,int)
base[sr:sr+sz,sc:sc+sz]=8
# obstacles
base[:3,9:11]=2 # top left-biased for north lane sc=10..11 overlap col0
base[7:9,:3]=3  # left top-biased for westbound at row7? maybe
base[-3:,1:3]=4 # bottom left
base[14:16,-3:]=6 # right lower
out,stats=sim(base,(sr,sc,sz),bg)
print(stats)
print(np.unique(out,return_counts=True))
print(out)
