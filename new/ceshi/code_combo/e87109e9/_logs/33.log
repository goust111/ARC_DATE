            beam_hits.append((d, oc, nr, nc))
            d = _rot(d, turns[oc])

        earlier_trail_mask |= beam_mask
        beam_stats.append(
            {
                "dir": d0,
                "trail_turns": trail_turns,
                "hits": beam_hits,
                "trail_cells": int(beam_mask.sum()),
            }
        )

