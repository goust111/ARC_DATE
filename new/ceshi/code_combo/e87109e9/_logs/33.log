+    vals, cnts = np.unique(base, return_counts=True)
+    if int(vals[cnts.argmax()]) != bg:
+        return None
+
+    try:
+        expected, stats, beam_paints = _simulate_variant(
+            base,
+            bg,
+            use_trails=True,
+            global_turns=True,
+            inherit_color=True,
