+            bg,
+            use_trails=False,
+            global_turns=True,
+            inherit_color=True,
+        )
+        reset_parity, _stats_reset, _ = _simulate_variant(
+            base,
+            bg,
+            use_trails=True,
+            global_turns=False,
+            inherit_color=True,
+        )
+        fixed_teal, _stats_fixed, _ = _simulate_variant(
+            base,
+            bg,
+            use_trails=True,
+            global_turns=True,
+            inherit_color=False,
+        )
+    except AssertionError:
+        return None
