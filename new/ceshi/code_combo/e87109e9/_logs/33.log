+    if hit_counts != [2, 1, 2, 0]:
+        return None
+    if total_hits != 5:
+        return None
+    if len(trail_hits) != 1 or len(nonteal_trail_hits) != 1:
+        return None
+    if len(visible_non_teal) < 2:
