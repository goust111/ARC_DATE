   195	
   196	    Key insight: each legend token fuses three visible controls at once, so the solver must read symbol geometry rather than a single left/right bar: facing chooses handedness, arm size chooses turn angle, and height chooses how many times that turn rule may still fire.
   197	    """
   198	    g = np.asarray(grid, dtype=int)
   199	
   200	    legend_bg = 5
   201	    rows_with_legend = np.where(np.any(g == legend_bg, axis=1))[0]
   202	    assert rows_with_legend.size, "legend rows must be present"
   203	    legend_h = int(rows_with_legend.max() + 1)
