+
+    angle_baseline = {
+        color: (hand, 90, quota)
+        for color, (hand, _angle, quota) in rules.items()
+    }
+    try:
+        angle_out, _angle_events, _angle_turns, _angle_passes = _simulate_paths(base, angle_baseline, bg)
+    except AssertionError:
+        return None
+    if np.array_equal(expected, angle_out):
