+    if used_small_hands != {"L", "R"}:
+        return None
+
+    saturated = set(random.sample(repeated_colors, random.randint(1, 2)))
+    rules: dict[int, tuple[str, int, int]] = {}
+    for side in present:
+        color = side_color[side]
+        hand, angle = side_rule[side]
