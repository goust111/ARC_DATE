   140	def _find_teal_square(g: np.ndarray, teal: int = 8) -> tuple[int, int, int]:
   141	    """Return (r0, c0, size) for the unique solid teal square component."""
   142	    candidates: list[tuple[int, int, int]] = []
   143	    for cells in components_mask(g == teal, connectivity=4):
   144	        r0, c0, r1, c1 = bbox_coords(cells)
   145	        hh = r1 - r0 + 1
   146	        ww = c1 - c0 + 1
   147	        if hh != ww:
   148	            continue
   149	        size = hh
   150	        if int(np.sum(g[r0 : r1 + 1, c0 : c1 + 1] == teal)) != size * size:
   151	            continue
   152	        candidates.append((int(r0), int(c0), int(size)))
   153	    assert len(candidates) == 1, "main grid must contain exactly one solid teal square"
   154	    return candidates[0]
