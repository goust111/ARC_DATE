   451	def _thickness_pair(axis: int, sz: int) -> tuple[int, int] | None:
   452	    """Compute obstacle thicknesses for both ends of an axis with both sides present."""
   453	    lo, hi_cap = OBS_THICKNESS_RANGE
   454	    room = axis - sz - OBS_BOTH_GAP
   455	    if room < 2 * lo:
   456	        return None
   457	    a = random.randint(lo, min(hi_cap, room - lo))
   458	    b = _rand_thickness(lo, min(hi_cap, room - a))
   459	    return (a, b) if b is not None else None
