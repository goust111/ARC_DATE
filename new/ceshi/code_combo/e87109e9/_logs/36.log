def _native_interval(side: int, sr: int, sc: int, sz: int) -> tuple[int, int]:
    return (sc, sc + sz - 1) if side in (_N, _S) else (sr, sr + sz - 1)


def _lane_interval(side: int, lane: dict[int, int], sz: int) -> tuple[int, int]:
