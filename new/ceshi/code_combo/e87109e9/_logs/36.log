   329	    req1 = max(b for _, b in required)
   330	    lo = max(min_len, req1 - req0 + 1)
   331	    hi = min(max_len, axis_len)
   332	    choices: list[tuple[int, int, int]] = []
   333	    for length in range(lo, hi + 1):
   334	        start0 = max(0, req1 - length + 1)
   335	        start1 = min(req0, axis_len - length)
   336	        for start in range(start0, start1 + 1):
   337	            end = start + length - 1
   338	            if all(end < a or start > b for a, b in excluded):
   339	                choices.append((length, start, end))
   340	    if not choices:
   341	        return None
   342	
   343	    lengths = sorted({length for length, _, _ in choices})
   344	    if random.random() < SPAN_COMPACT_PROB:
   345	        cutoff = lengths[min(len(lengths) - 1, max(0, len(lengths) // 2))]
   346	        pool = [(start, end) for length, start, end in choices if length <= cutoff]
   347	    else:
   348	        pool = [(start, end) for _, start, end in choices]
   349	    return random.choice(pool)
