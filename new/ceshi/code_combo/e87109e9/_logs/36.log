   352	def _simulate_paths(
   353	    base: np.ndarray,
   354	    rules: dict[int, tuple[str, int, int]],
   355	    bg: int,
   356	) -> tuple[np.ndarray, list[list[tuple[int, int, int, int, str]]], dict[int, int], int]:
   357	    """Simulate beams with handedness, variable turn angle, and per-color collision quotas."""
   358	    vals, counts = np.unique(base, return_counts=True)
   359	    assert int(vals[counts.argmax()]) == bg
   360	
   361	    sr, sc, sz = _find_teal_square(base, teal=TEAL)
   362	    out = base.copy()
   363	    h, w = out.shape
   364	    beam_events: list[list[tuple[int, int, int, int, str]]] = []
   365	    turn_used = {color: 0 for color in rules}
   366	    pass_events = 0
   367	
   368	    def in_bounds(r: int, c: int) -> bool:
   369	        return 0 <= r and 0 <= c and r + sz - 1 < h and c + sz - 1 < w
   370	
   371	    def paint(r: int, c: int) -> None:
   372	        blk = out[r : r + sz, c : c + sz]
   373	        blk[blk == bg] = TEAL
   374	        out[r : r + sz, c : c + sz] = blk
   375	
   376	    def obstacle_at(r: int, c: int) -> int | None:
   377	        cols = set(map(int, np.unique(out[r : r + sz, c : c + sz])))
   378	        cols.discard(bg)
   379	        cols.discard(TEAL)
   380	        if not cols:
   381	            return None
   382	        assert len(cols) == 1, "beam footprint must not hit mixed obstacle colors"
   383	        return int(next(iter(cols)))
   384	
   385	    for d0 in range(4):
   386	        r, c, d = int(sr), int(sc), d0
   387	        events: list[tuple[int, int, int, int, str]] = []
   388	        seen: set[tuple[int, int, int]] = set()
   389	        while True:
   390	            state = (r, c, d)
   391	            assert state not in seen, "beam path must not cycle"
   392	            seen.add(state)
   393	
   394	            dr, dc = _DIRS[d]
   395	            nr, nc = r + dr, c + dc
   396	            if not in_bounds(nr, nc):
   397	                break
   398	
   399	            current_obs = obstacle_at(r, c)
   400	            next_obs = obstacle_at(nr, nc)
   401	            if next_obs is None:
   402	                r, c = nr, nc
   403	                paint(r, c)
   404	                continue
   405	
   406	            if current_obs is not None:
   407	                assert current_obs == next_obs, "penetration cannot switch obstacle colors mid-crossing"
   408	                r, c = nr, nc
   409	                paint(r, c)
   410	                continue
   411	
   412	            assert next_obs in rules
   413	            hand, angle, quota = rules[next_obs]
   414	            if turn_used[next_obs] < quota:
   415	                turn_used[next_obs] += 1
   416	                events.append((d, next_obs, nr, nc, "turn"))
   417	                d = _rot(d, hand, angle)
   418	            else:
   419	                events.append((d, next_obs, nr, nc, "pass"))
   420	                pass_events += 1
   421	                r, c = nr, nc
   422	                paint(r, c)
   423	        beam_events.append(events)
   424	
   425	    return out, beam_events, turn_used, pass_events
