    77	def _parse_legend(grid: np.ndarray, legend_h: int) -> dict[int, tuple[str, int, int]]:
    78	    """
    79	    Legend is a top region with a background color (typically 5) and 4 symbol cells.
    80	    Each cell contains one bottom-aligned hook token:
    81	      - left-facing hook  -> handedness 'L'
    82	      - right-facing hook -> handedness 'R'
    83	      - top arm length 2  -> 90-degree turn
    84	      - top arm length 3  -> 180-degree turn
    85	      - stem height 1..4  -> max number of turning collisions for that color
    86	    """
    87	    legend = grid[:legend_h, :]
    88	    assert legend.size, "legend must be non-empty"
    89	    vals, cnts = np.unique(legend, return_counts=True)
    90	    bg = int(vals[cnts.argmax()])
    91	
    92	    sep_cols = [c for c in range(legend.shape[1]) if np.all(legend[:, c] == bg)]
    93	    assert len(sep_cols) >= 2, "legend separator columns must exist"
    94	
    95	    rules: dict[int, tuple[str, int, int]] = {}
    96	    for a, b in zip(sep_cols, sep_cols[1:], strict=False):
    97	        if b - a <= 2:
    98	            continue
    99	        interior = legend[1 : legend_h - 1, a + 1 : b]
   100	        assert interior.shape == (4, 4), "legend cell interior must be 4x4"
   101	        colors = set(map(int, np.unique(interior)))
   102	        colors.discard(bg)
   103	        colors.discard(0)
   104	        assert len(colors) == 1, "each legend cell must encode exactly one color"
   105	        color = int(next(iter(colors)))
   106	
   107	        ys, xs = np.where(interior == color)
   108	        assert ys.size >= 2, "each hook token must have at least two colored pixels"
   109	        min_y = int(ys.min())
   110	        max_y = int(ys.max())
   111	        assert max_y == interior.shape[0] - 1, "hook must be bottom-aligned"
   112	        quota = interior.shape[0] - min_y
   113	
   114	        top_cols = sorted(map(int, xs[ys == min_y]))
   115	        if top_cols == [0, 1]:
   116	            hand, angle, stem_x = "L", 90, 1
   117	        elif top_cols == [0, 1, 2]:
   118	            hand, angle, stem_x = "L", 180, 1
   119	        elif top_cols == [2, 3]:
   120	            hand, angle, stem_x = "R", 90, 2
   121	        elif top_cols == [1, 2, 3]:
   122	            hand, angle, stem_x = "R", 180, 2
   123	        else:
   124	            raise AssertionError("unknown hook pattern in legend cell")
   125	
   126	        expected_rows = np.arange(min_y, interior.shape[0])
   127	        stem_rows = sorted(map(int, ys[xs == stem_x]))
   128	        assert stem_rows == list(expected_rows), "hook stem must be contiguous and bottom-aligned"
   129	        for row in range(min_y + 1, interior.shape[0]):
   130	            row_cols = sorted(map(int, xs[ys == row]))
   131	            assert row_cols == [stem_x], "only the stem may continue below the top arm"
   132	
   133	        assert color not in rules, "legend colors must be distinct"
   134	        rules[color] = (hand, angle, quota)
   135	
   136	    assert len(rules) == 4, "legend must encode four colors"
   137	    return rules
