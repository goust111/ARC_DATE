   157	def _ccw(d: int) -> int:
   158	    return (d - 1) % 4
   159	
   160	
   161	def _cw(d: int) -> int:
   162	    return (d + 1) % 4
   163	
   164	
   165	def _opp(d: int) -> int:
   166	    return (d + 2) % 4
   167	
   168	
   169	def _rot(d: int, hand: str, angle: int) -> int:
   170	    if angle == 90:
   171	        return _ccw(d) if hand == "L" else _cw(d)
   172	    assert angle == 180, f"unsupported angle: {angle}"
   173	    return _opp(d)
   174	
   175	
   176	def _next_side(side: int, hand: str, angle: int) -> int:
   177	    return _rot(side, hand, angle)
