   428	def _make_legend(legend_colors: list[int], rules: dict[int, tuple[str, int, int]]) -> np.ndarray:
   429	    """Build the 6x24 legend band from 4 colors and their (hand, angle, quota) rules."""
   430	    legend = np.full((LEGEND_H, GRID_W), LEGEND_BG, dtype=int)
   431	    for start, color in zip(LEGEND_CELL_STARTS, legend_colors):
   432	        legend[1:5, start : start + 4] = 0
   433	        hand, angle, quota = rules[color]
   434	        assert 1 <= quota <= 4, "quota must fit inside the legend cell"
   435	        top_row = 5 - quota
   436	        if hand == "L":
   437	            cols = [0, 1] if angle == 90 else [0, 1, 2]
   438	        else:
   439	            cols = [2, 3] if angle == 90 else [1, 2, 3]
   440	        for col in cols:
   441	            legend[top_row, start + col] = color
   442	        stem_col = 1 if hand == "L" else 2
   443	        legend[top_row:5, start + stem_col] = color
   444	    return legend
