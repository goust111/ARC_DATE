   265	def _choose_span(
   266	    axis_len: int,
   267	    required: list[tuple[int, int]],
   268	    excluded: list[tuple[int, int]],
   269	    min_len: int,
   270	    max_len: int,
   271	) -> tuple[int, int] | None:
   272	    """Pick a (start, end) span covering all required intervals and avoiding excluded ones."""
   273	    req0 = min(a for a, _ in required)
   274	    req1 = max(b for _, b in required)
   275	    lo = max(min_len, req1 - req0 + 1)
   276	    hi = min(max_len, axis_len)
   277	    choices: list[tuple[int, int, int]] = []
   278	    for length in range(lo, hi + 1):
   279	        start0 = max(0, req1 - length + 1)
   280	        start1 = min(req0, axis_len - length)
   281	        for start in range(start0, start1 + 1):
   282	            end = start + length - 1
   283	            if all(end < a or start > b for a, b in excluded):
   284	                choices.append((length, start, end))
   285	    if not choices:
   286	        return None
   287	
   288	    lengths = sorted({length for length, _, _ in choices})
   289	    if random.random() < SPAN_COMPACT_PROB:
   290	        cutoff = lengths[min(len(lengths) - 1, max(0, len(lengths) // 2))]
   291	        pool = [(start, end) for length, start, end in choices if length <= cutoff]
   292	    else:
   293	        pool = [(start, end) for _, start, end in choices]
   294	    return random.choice(pool)
   295	
   296	
   297	def _rand_thickness(lo: int, hi: int) -> int | None:
   298	    return random.randint(lo, hi) if hi >= lo else None
   299	
   300	
   301	def _thickness_pair(axis: int, sz: int) -> tuple[int, int] | None:
   302	    """Compute obstacle thicknesses for both ends of an axis (N/S or W/E)."""
   303	    lo, hi_cap = OBS_THICKNESS_RANGE
   304	    room = axis - sz - OBS_BOTH_GAP
   305	    if room < 2 * lo:
   306	        return None
   307	    a = random.randint(lo, min(hi_cap, room - lo))
   308	    b = _rand_thickness(lo, min(hi_cap, room - a))
   309	    return (a, b) if b is not None else None
   310	
   311	
   312	def _obstacle_rect(side: int, thickness: int, span: tuple[int, int], h: int, w: int) -> tuple[int, int, int, int]:
   313	    """Return (r0, r1, c0, c1) for an edge-touching obstacle rectangle."""
   314	    s0, s1 = span
   315	    if side == _N:
   316	        return 0, thickness - 1, s0, s1
   317	    if side == _S:
   318	        return h - thickness, h - 1, s0, s1
   319	    if side == _W:
   320	        return s0, s1, 0, thickness - 1
   321	    return s0, s1, w - thickness, w - 1
   322	
