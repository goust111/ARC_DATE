   106	def _parse_legend(grid: np.ndarray, legend_h: int) -> dict[int, tuple[str, int]]:
   107	    """
   108	    Legend is a top region with a background color (typically 5) and 4 symbol cells.
   109	    Each cell contains one bottom-aligned vertical bar:
   110	      - bar on left  -> 'L' (turn counterclockwise)
   111	      - bar on right -> 'R' (turn clockwise)
   112	      - bar height   -> max number of turning collisions for that color
   113	    """
   114	    legend = grid[:legend_h, :]
   115	    assert legend.size, "legend must be non-empty"
   116	    vals, cnts = np.unique(legend, return_counts=True)
   117	    bg = int(vals[cnts.argmax()])
   118	
   119	    sep_cols = [c for c in range(legend.shape[1]) if np.all(legend[:, c] == bg)]
   120	    assert len(sep_cols) >= 2, "legend separator columns must exist"
   121	
   122	    rules: dict[int, tuple[str, int]] = {}
   123	    for a, b in zip(sep_cols, sep_cols[1:], strict=False):
   124	        if b - a <= 2:
   125	            continue
   126	        interior = legend[1 : legend_h - 1, a + 1 : b]
   127	        colors = set(map(int, np.unique(interior)))
   128	        colors.discard(bg)
   129	        colors.discard(0)
   130	        assert len(colors) == 1, "each legend cell must encode exactly one color"
   131	        color = int(next(iter(colors)))
   132	        ys, xs = np.where(interior == color)
   133	        assert ys.size >= 1, "legend bar must have positive height"
   134	        x = int(xs[0])
   135	        assert np.all(xs == x), "legend bar must be a single vertical strip"
   136	        quota = int(ys.size)
   137	        expect = np.arange(interior.shape[0] - quota, interior.shape[0])
   138	        assert np.array_equal(np.sort(ys), expect), "legend bar must be bottom-aligned and contiguous"
   139	        turn = "L" if x <= (interior.shape[1] - 1) // 2 else "R"
   140	        assert color not in rules, "legend colors must be distinct"
   141	        rules[color] = (turn, quota)
   142	    assert len(rules) == 4, "legend must encode four colors"
   143	    return rules
   144	
   145	
   146	def _find_teal_square(g: np.ndarray, teal: int = TEAL) -> tuple[int, int, int]:
   147	    """Return (r0,c0,size) for a solid square teal component."""
   148	    candidates: list[tuple[int, int, int]] = []
   149	    for cells in components_mask(g == teal, connectivity=4):
   150	        r0, c0, r1, c1 = bbox_coords(cells)
   151	        hh = r1 - r0 + 1
   152	        ww = c1 - c0 + 1
   153	        if hh != ww:
   154	            continue
   155	        if int(np.sum(g[r0 : r1 + 1, c0 : c1 + 1] == teal)) != hh * ww:
   156	            continue
   157	        candidates.append((int(r0), int(c0), int(hh)))
   158	    assert len(candidates) == 1, "main grid must contain exactly one solid teal square"
   159	    return candidates[0]
   160	
   161	
   162	def _rot(d: int, turn: str) -> int:
   163	    return (d - 1) % 4 if turn == "L" else (d + 1) % 4
   164	
   165	
   166	def main(grid: np.ndarray) -> np.ndarray:
   167	    """
   168	    Emit four teal beams from a square, with obstacle colors carrying finite collision quotas and beams carrying a finite turn budget.
   169	
   170	    Input structure:
   171	    - The top band is a grey legend split into four black cells, each holding one colored vertical bar.
   172	    - Bar side still tells whether that obstacle color turns beams left or right.
   173	    - Bar height now tells how many turning collisions that color permits before later hits become straight pass-throughs.
   174	    - Below the legend is the main area with one solid teal square, one uniform background color, and colored obstacle rectangles touching the borders.
   175	
   176	    Rule:
   177	    - Remove the legend from the output.
   178	    - Launch one square-shaped teal beam in each cardinal direction from the teal source.
   179	    - A beam paints teal only on background cells as it moves.
   180	    - When a beam reaches a fresh obstacle color, first check that color's remaining collision quota. If the quota is exhausted, the beam enters that obstacle and continues straight through it.
   181	    - If the quota is still available, the beam may turn only if it has used fewer than 2 turns already. A successful turn spends both one color collision and one beam turn. If the beam has already used 2 turns, it stops at that obstacle instead of turning.
   182	
   183	    Key insight: the solver must maintain two independent counters at once: a global per-beam turn count and a per-color turning-collision count decoded from legend bar height.
   184	    """
   185	    g = np.asarray(grid, dtype=int)
   186	
   187	    rows_with_legend = np.where(np.any(g == LEGEND_BG, axis=1))[0]
   188	    assert rows_with_legend.size, "legend rows must be present"
   189	    legend_h = int(rows_with_legend.max() + 1)
   190	    assert np.array_equal(rows_with_legend, np.arange(legend_h)), "legend color must be confined to the top band"
   191	
   192	    legend_rules = _parse_legend(g, legend_h)
   193	
   194	    base = g[legend_h:, :].copy()
   195	    assert base.size, "main grid must remain after legend crop"
   196	
   197	    vals, cnts = np.unique(base, return_counts=True)
   198	    bg = int(vals[cnts.argmax()])
   199	    sr, sc, sz = _find_teal_square(base, teal=TEAL)
   200	
   201	    out = base.copy()
   202	    turn_used_by_color = {color: 0 for color in legend_rules}
   203	
   204	    def in_bounds(r: int, c: int) -> bool:
   205	        return 0 <= r and 0 <= c and r + sz - 1 < out.shape[0] and c + sz - 1 < out.shape[1]
   206	
   207	    def paint_block(r: int, c: int) -> None:
   208	        blk = out[r : r + sz, c : c + sz]
   209	        blk[blk == bg] = TEAL
   210	        out[r : r + sz, c : c + sz] = blk
   211	
   212	    def obstacle_color_at(r: int, c: int) -> int | None:
   213	        blk = out[r : r + sz, c : c + sz]
   214	        cols = set(map(int, np.unique(blk)))
   215	        cols.discard(bg)
   216	        cols.discard(TEAL)
   217	        if not cols:
   218	            return None
   219	        assert len(cols) == 1, "beam footprint must not hit mixed obstacle colors"
   220	        return int(next(iter(cols)))
   221	
   222	    for d0 in range(4):
   223	        r, c, d = sr, sc, d0
   224	        turns_used = 0
   225	        seen: set[tuple[int, int, int, int]] = set()
   226	        while True:
   227	            state = (r, c, d, turns_used)
   228	            assert state not in seen, "beam path must not cycle"
   229	            seen.add(state)
   230	
   231	            dr, dc = _DIRS[d]
   232	            nr, nc = r + dr, c + dc
   233	            if not in_bounds(nr, nc):
   234	                break
   235	
   236	            current_obstacle = obstacle_color_at(r, c)
   237	            next_obstacle = obstacle_color_at(nr, nc)
   238	            if next_obstacle is None:
   239	                r, c = nr, nc
   240	                paint_block(r, c)
   241	                continue
   242	
   243	            if current_obstacle is not None:
   244	                assert current_obstacle == next_obstacle, "penetration cannot switch obstacle colors mid-crossing"
   245	                r, c = nr, nc
   246	                paint_block(r, c)
   247	                continue
   248	
   249	            assert next_obstacle in legend_rules, "obstacle color must be encoded by legend"
   250	            turn, quota = legend_rules[next_obstacle]
   251	            if turn_used_by_color[next_obstacle] >= quota:
   252	                r, c = nr, nc
   253	                paint_block(r, c)
   254	                continue
   255	            if turns_used >= MAX_TURNS_PER_BEAM:
   256	                break
   257	
   258	            turn_used_by_color[next_obstacle] += 1
   259	            turns_used += 1
   260	            d = _rot(d, turn)

