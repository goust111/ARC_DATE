   324	def _make_legend(legend_colors: list[int], rules: dict[int, tuple[str, int]]) -> np.ndarray:
   325	    """Build the 6x24 legend band from 4 colors and their (turn, quota) rules."""
   326	    legend = np.full((LEGEND_H, GRID_W), LEGEND_BG, dtype=int)
   327	    for start, color in zip(LEGEND_CELL_STARTS, legend_colors):
   328	        legend[1:5, start : start + 4] = 0
   329	        turn, quota = rules[color]
   330	        bar_col = start if turn == "L" else start + 3
   331	        legend[5 - quota : 5, bar_col] = color
   332	    return legend
