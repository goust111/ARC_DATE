        d13_out, d13_events, _, _, _ = mod._simulate_paths(base, rules, bg, use_quotas=True, max_turns=None)
        d6_out, d6_events, _, _, _ = mod._simulate_paths(base, rules, bg, use_quotas=False, max_turns=mod.MAX_TURNS_PER_BEAM)
        src_out, src_events, _, _, _ = mod._simulate_paths(base, rules, bg, use_quotas=False, max_turns=None)
    except AssertionError:
        continue
    if pass_events < 1 or stop_events < 1:
        continue
    if not (np.array_equal(combo_out, d13_out) and np.array_equal(combo_out, d6_out) and np.array_equal(combo_out, src_out)):
        continue
    print('equal all')
    print('shape', h, 'sz', sz, 'srsc', sr, sc, 'thick', thickness, 'lane', lane, 'spans', spans)
    print('combo', combo_events)
    print('d13', d13_events)
    print('d6', d6_events)
    print('src', src_events)
    break
else:
    print('none')
