            # Variant of e87109e9
# Dimension: D13 — 图例与障碍物的对应关系 (symbol_instructions)
# Change: 图例中每个颜色条目与主区域中同色障碍物一一对应——图例颜色即障碍物颜色，4个条目对应最多4种障碍物颜色... → 图例条目包含数量编码

"""
design_analysis:
  concrete_variant:
    legend_layout:
      keep: 6x24 top band, grey background, four 4-column cells, black cell interiors
      change:
        - each cell still contains exactly one colored vertical bar
        - bar side encodes turn direction: left = CCW, right = CW
        - bar height encodes the maximum number of turning collisions for that color
        - heights are 1..4 and are bottom-aligned so the count is visually legible
    obstacle_mapping:
      keep:
        - legend color still matches the obstacle color directly
        - obstacle rectangles remain solid, edge-touching, non-overlapping
      change:
        - the solver must extract two parameters per legend color: turn direction and collision quota
    beam_behavior:
      original_flow:
        - on every obstacle hit, the beam turns immediately and never enters the obstacle cells
      variant_flow:
        - the first `quota` encounters with a color behave like the original
        - later encounters with that same color no longer turn and instead move straight through the obstacle
        - beams still paint only background cells, so penetration does not erase obstacles
  trace_example:
    scenario:
      - east obstacle color is red
      - red legend bar is on the right and has height 1
      - two different beams would hit red under the old geometry
    original:
      - first red hit turns clockwise
      - second red hit also turns clockwise
    variant:
      - first red hit spends the only allowed red collision and turns clockwise
      - second red hit sees red quota exhausted, enters the red block, continues straight, and exits at the boundary
    visible_difference:
      - one output branch that existed in the original disappears
      - the beam now forms a straight teal trace up to the exhausted obstacle instead of a second corner
  complexity_calibration:
    - keep the same overall geometry so the task still looks like the source task
    - limit the new numeric parameter to four visible heights because the legend already offers four interior rows
    - force at least one repeated obstacle color encounter in every generated sample, otherwise the quota would be invisible and the sample would collapse back to the original task
  implicit_assumptions_review:
    original_assumptions_that_break:
      - `_parse_legend` assumed one parameter per color and treated the whole colored bar as a direction token
      - the hit handler assumed every obstacle encounter always triggers a turn
      - the oracle generator assumed unlimited repeated turning for the same color
    new_guards:
      - legend parsing now checks that each colored bar is a single vertical column with contiguous bottom-aligned pixels
      - collision handling distinguishes entering an obstacle from already passing through that same obstacle
      - generator validates that capped simulation differs from uncapped simulation on the same grid
  placement_legality:
    - obstacle rectangles are still generated by the original edge-touching span logic, so they remain non-overlapping and solver-friendly
    - penetration is only allowed after a quota is exhausted, and all obstacles touch an edge, so straight-through motion always terminates at the boundary instead of creating long interior ambiguity
    - every generated sample is checked by running the new solver and comparing with the capped oracle output
  visual_observability:
    - the new feature is encoded by visible bar height, not by hidden color ordering or id arithmetic
    - generator requires at least one pass-through event and at least one capped color, so the new behavior changes the output in every accepted sample
    - unused legend colors may still appear, but the main area continues to use 3-4 legend colors as in the source task
  neatness:
    - legend remains a clean four-cell strip with one token per cell
    - main area keeps the same sparse obstacle arrangement, so the added rule changes path logic without cluttering the image
"""

import random

import numpy as np

from arc_utils import bbox_coords, components_mask

_DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
_N, _E, _S, _W = range(4)


def _parse_legend(grid: np.ndarray, legend_h: int) -> dict[int, tuple[str, int]]:
    """
    Legend is a top region with a background color (typically 5) and 4 symbol cells.
    Each cell contains one bottom-aligned vertical bar:
      - bar on left  -> 'L' (turn counterclockwise)
      - bar on right -> 'R' (turn clockwise)
      - bar height   -> max number of turning collisions for that color
    """
    legend = grid[:legend_h, :]
    assert legend.size, "legend must be non-empty"
    vals, cnts = np.unique(legend, return_counts=True)
    bg = int(vals[cnts.argmax()])

    sep_cols = [c for c in range(legend.shape[1]) if np.all(legend[:, c] == bg)]
    assert len(sep_cols) >= 2, "legend separator columns must exist"

    rules: dict[int, tuple[str, int]] = {}
    for a, b in zip(sep_cols, sep_cols[1:], strict=False):
        if b - a <= 2:
            continue
        interior = legend[1 : legend_h - 1, a + 1 : b]
        colors = set(map(int, np.unique(interior)))
        colors.discard(bg)
        colors.discard(0)
        assert len(colors) == 1, "each legend cell must encode exactly one color"
        color = int(next(iter(colors)))
        ys, xs = np.where(interior == color)
        assert ys.size >= 1, "legend bar must have positive height"
        x = int(xs[0])
        assert np.all(xs == x), "legend bar must be a single vertical strip"
        quota = int(ys.size)
        expected_rows = np.arange(interior.shape[0] - quota, interior.shape[0])
        assert np.array_equal(np.sort(ys), expected_rows), "legend bar must be bottom-aligned and contiguous"
        turn = "L" if x <= (interior.shape[1] - 1) // 2 else "R"
        assert color not in rules, "legend colors must be distinct"
        rules[color] = (turn, quota)
    assert len(rules) == 4, "legend must encode four colors"
    return rules


def _find_teal_square(g: np.ndarray, teal: int = 8) -> tuple[int, int, int]:
    """Return (r0,c0,size) for a solid square teal component."""
    candidates: list[tuple[int, int, int]] = []
    for cells in components_mask(g == teal, connectivity=4):
        r0, c0, r1, c1 = bbox_coords(cells)
        hh = r1 - r0 + 1
        ww = c1 - c0 + 1
        if hh != ww:
            continue
        size = hh
        if int(np.sum(g[r0 : r1 + 1, c0 : c1 + 1] == teal)) != size * size:
            continue
        candidates.append((int(r0), int(c0), int(size)))
    assert len(candidates) == 1, "main grid must contain exactly one solid teal square"
    return candidates[0]


def _rot_ccw(d: int) -> int:
    return (d - 1) % 4


def _rot_cw(d: int) -> int:
    return (d + 1) % 4


def _rot(d: int, turn: str) -> int:
    return _rot_ccw(d) if turn == "L" else _rot_cw(d)


def main(grid: np.ndarray) -> np.ndarray:
    """
    Launch four teal beams from a square, with each obstacle color carrying both a turn rule and a finite turn budget.

    Input structure:
    - Top strip: a grey legend split into four black cells; each cell has one colored vertical bar.
    - The bar's left/right placement encodes whether that color turns beams counterclockwise or clockwise.
    - The same bar's height (1-4 pixels, bottom-aligned) encodes how many turning collisions that obstacle color allows in total.
    - Below the legend sits the main area with one solid teal square, a uniform background, and 3-4 colored obstacle rectangles.

    Rule:
    - Remove the legend from the output.
    - Fire one square-shaped teal beam in each cardinal direction from the teal source.
    - A beam paints teal only onto background cells as it slides.
    - When a beam first tries to enter an obstacle color whose remaining quota is still positive, spend one collision for that color and turn according to the legend without entering the obstacle.
    - Once that color's quota has been exhausted, later beams no longer turn there and instead continue straight through that obstacle until the boundary stops them.

    Key insight: every legend symbol now encodes two visible parameters at once: bar side gives the turn direction, and bar height gives the per-color number of turning collisions before penetration begins.
    """
    g = np.asarray(grid, dtype=int)

    legend_bg = 5
    rows_with_legend = np.where(np.any(g == legend_bg, axis=1))[0]
    assert rows_with_legend.size, "legend rows must be present"
    legend_h = int(rows_with_legend.max() + 1)
    assert np.array_equal(rows_with_legend, np.arange(legend_h)), "legend color must be confined to the top band"

    legend_rules = _parse_legend(g, legend_h)

    base = g[legend_h:, :].copy()
    assert base.size, "main grid must remain after legend crop"

    vals, cnts = np.unique(base, return_counts=True)
    bg = int(vals[cnts.argmax()])
    teal = 8
    sr, sc, sz = _find_teal_square(base, teal=teal)

    out = base.copy()
    turn_used = {color: 0 for color in legend_rules}

    def in_bounds(r: int, c: int) -> bool:
        return 0 <= r and 0 <= c and r + sz - 1 < out.shape[0] and c + sz - 1 < out.shape[1]

    def paint_block(r: int, c: int) -> None:
        blk = out[r : r + sz, c : c + sz]
        blk[blk == bg] = teal
        out[r : r + sz, c : c + sz] = blk

    def obstacle_color_at(r: int, c: int) -> int | None:
        blk = out[r : r + sz, c : c + sz]
        cols = set(map(int, np.unique(blk)))
        cols.discard(bg)
        cols.discard(teal)
        if not cols:
            return None
        assert len(cols) == 1, "beam footprint must not hit mixed obstacle colors"
        return int(next(iter(cols)))

    for d0 in range(4):
        r, c, d = sr, sc, d0
        seen: set[tuple[int, int, int]] = set()
        while True:
            state = (r, c, d)
            assert state not in seen, "beam path must not cycle"
            seen.add(state)

            dr, dc = _DIRS[d]
            nr, nc = r + dr, c + dc
            if not in_bounds(nr, nc):
                break

            current_obstacle = obstacle_color_at(r, c)
            next_obstacle = obstacle_color_at(nr, nc)
            if next_obstacle is None:
                r, c = nr, nc
                paint_block(r, c)
                continue

            if current_obstacle is not None:
                assert current_obstacle == next_obstacle, "penetration cannot switch obstacle colors mid-crossing"
                r, c = nr, nc
                paint_block(r, c)
                continue

            assert next_obstacle in legend_rules, "obstacle color must be encoded by legend"
            turn, quota = legend_rules[next_obstacle]
            if turn_used[next_obstacle] < quota:
                turn_used[next_obstacle] += 1
                d = _rot(d, turn)
            else:
                r, c = nr, nc
                paint_block(r, c)

    return out


# --------------- generator (o5x) ---------------

# Color palettes
LEGEND_COLOR_POOL = [1, 2, 3, 4, 6]
BG_COLOR_POOL = [1, 2, 3, 4, 6, 7, 9]
LEGEND_BG = 5
TEAL = 8

# Canvas dimensions
GRID_H_RANGE = (19, 24)
GRID_W = 24
LEGEND_H = 6
LEGEND_CELL_STARTS = [1, 7, 13, 19]

# Teal square
TEAL_SZ2_PROB = 0.75
SQUARE_EDGE_GAP = 5

# Obstacles
OBS_COUNT_4_PROB = 0.65
OBS_THICKNESS_RANGE = (2, 4)
OBS_SINGLE_MARGIN = 6
OBS_BOTH_GAP = 2

# Span selection
SPAN_MIN_MULT = 3
SPAN_MAX_MULT = 14
SPAN_COMPACT_PROB = 0.4

# Retry budget
MAX_RETRIES = 400


def _choose_span(
    axis_len: int,
    required: list[tuple[int, int]],
    excluded: list[tuple[int, int]],
    min_len: int,
    max_len: int,
) -> tuple[int, int] | None:
    """Pick a (start, end) span covering all required intervals and avoiding excluded ones."""
    req0 = min(a for a, _ in required)
    req1 = max(b for _, b in required)
    lo = max(min_len, req1 - req0 + 1)
    hi = min(max_len, axis_len)
    choices: list[tuple[int, int, int]] = []
    for length in range(lo, hi + 1):
        start0 = max(0, req1 - length + 1)
        start1 = min(req0, axis_len - length)
        for start in range(start0, start1 + 1):
            end = start + length - 1
            if all(end < a or start > b for a, b in excluded):
                choices.append((length, start, end))
    if not choices:
        return None

    lengths = sorted({length for length, _, _ in choices})
    if random.random() < SPAN_COMPACT_PROB:
        cutoff = lengths[min(len(lengths) - 1, max(0, len(lengths) // 2))]
        pool = [(start, end) for length, start, end in choices if length <= cutoff]
    else:
        pool = [(start, end) for _, start, end in choices]
    return random.choice(pool)


def _simulate_paths(
    base: np.ndarray, rules: dict[int, tuple[str, int]], bg: int
) -> tuple[np.ndarray, list[list[tuple[int, int, int, int, str]]], dict[int, int], int]:
    """Simulate beams with per-color collision quotas."""
    vals, counts = np.unique(base, return_counts=True)
    assert int(vals[counts.argmax()]) == bg

    teal_locs = np.argwhere(base == TEAL)
    assert teal_locs.size
    sr, sc = teal_locs.min(axis=0)
    r1, c1 = teal_locs.max(axis=0)
    sz = int(r1 - sr + 1)
    assert sz == int(c1 - sc + 1)

    out = base.copy()
    h, w = out.shape
    beam_events: list[list[tuple[int, int, int, int, str]]] = []
    turn_used = {color: 0 for color in rules}
    pass_events = 0

    def in_bounds(r: int, c: int) -> bool:
        return 0 <= r and 0 <= c and r + sz - 1 < h and c + sz - 1 < w

    def paint(r: int, c: int) -> None:
        blk = out[r : r + sz, c : c + sz]
        blk[blk == bg] = TEAL
        out[r : r + sz, c : c + sz] = blk

    def obstacle_at(r: int, c: int) -> int | None:
        colors = set(map(int, np.unique(out[r : r + sz, c : c + sz])))
        colors.discard(bg)
        colors.discard(TEAL)
        if not colors:
            return None
        assert len(colors) == 1
        return int(next(iter(colors)))

    for d0 in range(4):
        r, c, d = int(sr), int(sc), d0
        events: list[tuple[int, int, int, int, str]] = []
        seen: set[tuple[int, int, int]] = set()
        while True:
            state = (r, c, d)
            assert state not in seen
            seen.add(state)
            dr, dc = _DIRS[d]
            nr, nc = r + dr, c + dc
            if not in_bounds(nr, nc):
                break

            current_obs = obstacle_at(r, c)
            next_obs = obstacle_at(nr, nc)
            if next_obs is None:
                r, c = nr, nc
                paint(r, c)
                continue

            if current_obs is not None:
                assert current_obs == next_obs
                r, c = nr, nc
                paint(r, c)
                continue

            assert next_obs in rules
            turn, quota = rules[next_obs]
            if turn_used[next_obs] < quota:
                turn_used[next_obs] += 1
                events.append((d, next_obs, nr, nc, "turn"))
                d = _rot(d, turn)
            else:
                events.append((d, next_obs, nr, nc, "pass"))
                pass_events += 1
                r, c = nr, nc
                paint(r, c)
        beam_events.append(events)

    return out, beam_events, turn_used, pass_events


def _make_legend(legend_colors: list[int], rules: dict[int, tuple[str, int]]) -> np.ndarray:
    """Build the 6x24 legend band from 4 colors and their (turn, quota) rules."""
    legend = np.full((LEGEND_H, GRID_W), LEGEND_BG, dtype=int)
    for start, color in zip(LEGEND_CELL_STARTS, legend_colors):
        legend[1:5, start : start + 4] = 0
        turn, quota = rules[color]
        bar_col = start if turn == "L" else start + 3
        legend[5 - quota : 5, bar_col] = color
    return legend


def _rand_thickness(lo: int, hi: int) -> int | None:
    return random.randint(lo, hi) if hi >= lo else None


def _thickness_pair(
    axis: int, sz: int, a_present: bool, b_present: bool
) -> tuple[int | None, int | None] | None:
    """Compute obstacle thicknesses for the two ends of an axis (N/S or W/E)."""
    lo, hi_cap = OBS_THICKNESS_RANGE
    if a_present and b_present:
        room = axis - sz - OBS_BOTH_GAP
        if room < 2 * lo:
            return None
        a = random.randint(lo, min(hi_cap, room - lo))
        b = _rand_thickness(lo, min(hi_cap, room - a))
        return (a, b) if b is not None else None
    if a_present:
        t = _rand_thickness(lo, min(hi_cap, axis - sz - OBS_SINGLE_MARGIN))
        return (t, None) if t is not None else None
    if b_present:
        t = _rand_thickness(lo, min(hi_cap, axis - sz - OBS_SINGLE_MARGIN))
        return (None, t) if t is not None else None
    return None, None


def _obstacle_rect(
    side: int, thickness: int, span: tuple[int, int], h: int, w: int
) -> tuple[int, int, int, int]:
    """Return (r0, r1, c0, c1) for an edge-touching obstacle rectangle."""
    s0, s1 = span
    if side == _N:
        return 0, thickness - 1, s0, s1
    if side == _S:
        return h - thickness, h - 1, s0, s1
    if side == _W:
        return s0, s1, 0, thickness - 1
    return s0, s1, w - thickness, w - 1


def _select_chains(present: set[int], second_hits: int) -> dict[int, int] | None:
    """Pick non-overlapping (source -> adjacent target) pairs for multi-bounce beams."""
    candidates = [
        (side, nxt)
        for side in present
        for nxt in ((side - 1) % 4, (side + 1) % 4)
        if nxt in present
    ]
    random.shuffle(candidates)
    selected: list[tuple[int, int]] = []
    used: set[int] = set()
    for side, nxt in candidates:
        if len(selected) == second_hits:
            break
        if side in used or nxt in used:
            continue
        selected.append((side, nxt))
        used.update((side, nxt))
    return dict(selected) if len(selected) == second_hits else None


def _assign_turns(present: set[int], chains: dict[int, int]) -> dict[int, str]:
    """Assign L/R turn direction for each obstacle side."""
    side_turn: dict[int, str] = {}
    for side in present:
        if side in chains:
            nxt = chains[side]
            side_turn[side] = "L" if nxt == (side - 1) % 4 else "R"
        else:
            outward = [t for t in ("L", "R") if _rot(side, t) not in present]
            side_turn[side] = random.choice(outward if outward else ["L", "R"])
    return side_turn


def _compute_span_constraints(
    present: set[int],
    side_turn: dict[int, str],
    chains: dict[int, int],
    sr: int,
    sc: int,
    sz: int,
    lane: dict[int, int],
) -> tuple[dict[int, list[tuple[int, int]]], dict[int, list[tuple[int, int]]]]:
    """Build required/excluded intervals for each obstacle span selection."""
    required: dict[int, list[tuple[int, int]]] = {s: [] for s in present}
    excluded: dict[int, list[tuple[int, int]]] = {s: [] for s in present}

    for side in present:
        base_coord = sc if side in (_N, _S) else sr
        required[side].append((base_coord, base_coord + sz - 1))

    def lane_interval(s: int) -> tuple[int, int]:
        return lane[s], lane[s] + sz - 1

    for side in present:
        nxt = _rot(side, side_turn[side])
        if nxt not in present:
            continue
        if chains.get(side) == nxt:
            required[nxt].append(lane_interval(side))
            after = _rot(nxt, side_turn[nxt])
            if after in present:
                excluded[after].append(lane_interval(nxt))
        else:
            excluded[nxt].append(lane_interval(side))

    return required, excluded


def _gen_attempt() -> np.ndarray | None:
    h, w = random.randint(*GRID_H_RANGE), GRID_W
    sz = 2 if random.random() < TEAL_SZ2_PROB else 3
    obstacle_count = 4 if random.random() < OBS_COUNT_4_PROB else 3
    present = set(random.sample([_N, _E, _S, _W], obstacle_count))

    # Every accepted sample must have at least one repeated obstacle encounter,
    # otherwise the quota dimension would be invisible.
    target_hits = 5 if obstacle_count == 4 else random.choice([4, 5])
    second_hits = target_hits - obstacle_count
    if second_hits < 1 or second_hits > 2:
        return None

    ns = _thickness_pair(h, sz, _N in present, _S in present)
    ew = _thickness_pair(w, sz, _W in present, _E in present)
    if ns is None or ew is None:
        return None
    thickness = {s: t for s, t in zip((_N, _S, _W, _E), (*ns, *ew)) if t is not None}

    min_r, max_r = SQUARE_EDGE_GAP, h - sz - SQUARE_EDGE_GAP
    min_c, max_c = SQUARE_EDGE_GAP, w - sz - SQUARE_EDGE_GAP
    if _N in present:
        min_r = max(min_r, thickness[_N] + 1)
    if _S in present:
        max_r = min(max_r, h - thickness[_S] - sz - 1)
    if _W in present:
        min_c = max(min_c, thickness[_W] + 1)
    if _E in present:
        max_c = min(max_c, w - thickness[_E] - sz - 1)
    if min_r > max_r or min_c > max_c:
        return None
    sr, sc = random.randint(min_r, max_r), random.randint(min_c, max_c)

    lane: dict[int, int] = {}
    if _N in present:
        lane[_N] = thickness[_N] + 1
    if _S in present:
        lane[_S] = h - thickness[_S] - sz
    if _W in present:
        lane[_W] = thickness[_W] + 1
    if _E in present:
        lane[_E] = w - thickness[_E] - sz

    chains = _select_chains(present, second_hits)
    if chains is None:
        return None

    side_turn = _assign_turns(present, chains)
    required, excluded = _compute_span_constraints(present, side_turn, chains, sr, sc, sz, lane)

    spans: dict[int, tuple[int, int]] = {}
    for side in present:
        axis_len = w if side in (_N, _S) else h
        span = _choose_span(
            axis_len,
            required[side],
            excluded[side],
            SPAN_MIN_MULT * sz,
            min(SPAN_MAX_MULT * sz, axis_len),
        )
        if span is None:
            return None
        spans[side] = span

    legend_colors = random.sample(LEGEND_COLOR_POOL, 4)
    obstacle_colors = random.sample(legend_colors, obstacle_count)
    side_color = dict(zip(sorted(present), obstacle_colors))
    bg = random.choice([c for c in BG_COLOR_POOL if c not in legend_colors])

    base = np.full((h, w), bg, dtype=int)
    base[sr : sr + sz, sc : sc + sz] = TEAL
    occupied = np.zeros((h, w), dtype=bool)
    for side in present:
        r0, r1, c0, c1 = _obstacle_rect(side, thickness[side], spans[side], h, w)
        region = occupied[r0 : r1 + 1, c0 : c1 + 1]
        if region.any():
            return None
        if not (r1 < sr - 1 or r0 > sr + sz or c1 < sc - 1 or c0 > sc + sz):
            return None
        occupied[r0 : r1 + 1, c0 : c1 + 1] = True
        base[r0 : r1 + 1, c0 : c1 + 1] = side_color[side]

    vals, counts = np.unique(base, return_counts=True)
    if int(vals[counts.argmax()]) != bg:
        return None

    turns = {side_color[s]: side_turn[s] for s in present}
    for color in legend_colors:
        turns.setdefault(color, random.choice(["L", "R"]))

    uncapped_rules = {color: (turns[color], 4) for color in legend_colors}
    try:
        uncapped_out, uncapped_events, uncapped_turns, _ = _simulate_paths(base, uncapped_rules, bg)
    except AssertionError:
        return None

    uncapped_total = sum(len(beam) for beam in uncapped_events)
    used_colors = set(side_color.values())
    repeated_colors = [color for color in used_colors if uncapped_turns[color] >= 2]
    hit_colors = {color for beam in uncapped_events for _, color, _, _, kind in beam if kind == "turn"}
    if uncapped_total != target_hits:
        return None
    if used_colors - hit_colors:
        return None
    if not repeated_colors:
        return None

    saturated = set(random.sample(repeated_colors, random.randint(1, min(2, len(repeated_colors)))))
    limits: dict[int, int] = {}
    for color in legend_colors:
        if color in saturated:
            limits[color] = random.randint(1, uncapped_turns[color] - 1)
        elif color in used_colors:
            limits[color] = random.randint(uncapped_turns[color], 4)
        else:
            limits[color] = random.randint(1, 4)
    rules = {color: (turns[color], limits[color]) for color in legend_colors}

    try:
        expected, events, turn_used, pass_events = _simulate_paths(base, rules, bg)
    except AssertionError:
        return None
    if pass_events < 1:
        return None
    if np.array_equal(expected, uncapped_out):
        return None

    for color in saturated:
        if turn_used[color] != limits[color]:
            return None

    legend = _make_legend(legend_colors, rules)
    inp = np.vstack([legend, base])
    try:
        actual = main(inp)
    except AssertionError:
        return None
    if not np.array_equal(actual, expected):
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(MAX_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate e87109e9 D13 input")

