+        "combo_minus_source": int(np.count_nonzero(combo_out != src_out)),
+        "combo_minus_d13": int(np.count_nonzero(combo_out != d13_out)),
+        "combo_minus_d6": int(np.count_nonzero(combo_out != d6_out)),
+    }
+    return grid, metrics
