+            turn_used_by_color[next_obs] += 1
+            turns_used += 1
+            events.append((d, next_obs, nr, nc, "turn"))
+            d = _rot(d, turn)
+        beam_events.append(events)
+
+    return out, beam_events, turn_used_by_color, pass_events, stop_events
