+    sr, sc, sz = _find_teal_square(base, teal=TEAL)
+    out = base.copy()
+    h, w = out.shape
+    beam_events: list[list[tuple[int, int, int, int, str]]] = []
+    turn_used_by_color = {color: 0 for color in rules}
