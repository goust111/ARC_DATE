+        turns_used = 0
+        events: list[tuple[int, int, int, int, str]] = []
+        seen: set[tuple[int, int, int, int]] = set()
+        while True:
+            state = (r, c, d, turns_used)
+            assert state not in seen
+            seen.add(state)
+
+            dr, dc = _DIRS[d]
+            nr, nc = r + dr, c + dc
+            if not in_bounds(nr, nc):
+                break
+
+            current_obs = obstacle_at(r, c)
+            next_obs = obstacle_at(nr, nc)
+            if next_obs is None:
+                r, c = nr, nc
