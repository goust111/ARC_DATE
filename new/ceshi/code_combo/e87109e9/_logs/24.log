+    min_r = p + gap_t
+    max_r = h - p - sz - gap_b
+    min_c = p + gap_l
+    max_c = w - p - sz - gap_r
+    if min_r > max_r or min_c > max_c:
+        return None
+    sr = random.randint(min_r, max_r)
+    sc = random.randint(min_c, max_c)
+
+    src_rows = (sr, sr + sz - 1)
+    north_rows = (sr + gap_b, sr + gap_b + sz - 1)
+    south_rows = (sr - gap_t, sr - gap_t + sz - 1)
+
+    lane_choices: list[tuple[frozenset[int], int]] = []
