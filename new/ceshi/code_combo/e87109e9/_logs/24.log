+
+    metrics = _behavior_metrics_from_base(base, turns, bg)
+    if metrics["second_hits"] < 1:
+        return None
+    if metrics["total_hits"] < 5:
+        return None
+    if metrics["plain_diff"] <= 0:
+        return None
+    if metrics["teleport_distance"] <= 0:
+        return None
