+    left_c = sc - gap_l - p
+    right_c = sc + sz + gap_r
+
+    rects = {
+        "top": (top_r, ns_c, top_r + p - 1, ns_c + p - 1),
+        "bottom": (bot_r, ns_c, bot_r + p - 1, ns_c + p - 1),
+        "left": (we_r, left_c, we_r + p - 1, left_c + p - 1),
+        "right": (we_r, right_c, we_r + p - 1, right_c + p - 1),
+        "src": (sr, sc, sr + sz - 1, sc + sz - 1),
+    }
+
+    for name, rect in rects.items():
