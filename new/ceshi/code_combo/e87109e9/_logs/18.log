+    return None
+
+
+def _choose_columns(
+    template: dict[str, object],
+    lane_side: int,
+    n_sources: int,
+    w: int,
+) -> list[int] | None:
+    margin = SOURCE_EDGE_GAP
+    if template["side"] == _E:
+        anchor_lo = 8 if n_sources == 3 else margin
+        anchor_hi = lane_side - 10
+        if anchor_lo > anchor_hi:
