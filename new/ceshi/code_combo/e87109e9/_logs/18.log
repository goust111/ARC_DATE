+LEGEND_COLOR_POOL = [1, 2, 3, 4, 6]
+BG_COLOR_POOL = [1, 2, 3, 4, 6, 7, 9]
+LEGEND_BG = 5
+
+GRID_H_RANGE = (19, 24)
+GRID_W = 24
+LEGEND_H = 6
+LEGEND_CELL_STARTS = [1, 7, 13, 19]
+
+SOURCE_SIZE = 2
+SOURCE_COUNT_3_PROB = 0.35
+SOURCE_ROW_GAP = 4
+SOURCE_EDGE_GAP = 4
+
+OBS_THICKNESS_RANGE = (2, 4)
+TOP_SPAN_MIN = 6
+SIDE_SPAN_MIN = 5
+SIDE_SPAN_MAX = 8
+
+MAX_RETRIES = 400
