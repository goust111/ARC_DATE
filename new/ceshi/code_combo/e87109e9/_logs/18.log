+
+def _is_full_square(g: np.ndarray, r0: int, c0: int, r1: int, c1: int, color: int) -> bool:
+    hh = r1 - r0 + 1
+    ww = c1 - c0 + 1
+    return hh == ww and int(np.sum(g[r0 : r1 + 1, c0 : c1 + 1] == color)) == hh * ww
