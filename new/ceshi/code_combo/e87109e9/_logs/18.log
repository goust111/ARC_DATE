+            assert len(colors) == 1, "beam footprint must not hit mixed colors"
+            hit_color = int(next(iter(colors)))
+            owner_blk = frozen_owner[nr : nr + sz, nc : nc + sz][mask]
+            owners = set(map(int, np.unique(owner_blk)))
+            owners.discard(-1)
