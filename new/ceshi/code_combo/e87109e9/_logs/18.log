   310	
   311	def main(grid: np.ndarray) -> np.ndarray:
   312	    """
   313	    Paint several colored beam systems whose earlier trails steer later ones.
   314	
   315	    Input structure:
   316	    - Top strip: the original grey 6x24 legend with four colored bars, where each bar sits on the left or right side of its cell.
   317	    - Below it: one uniform-background playfield containing 2-3 isolated 2x2 source squares of different colors plus a few edge-touching obstacle rectangles.
   318	
   319	    Rule:
   320	    - Remove the legend strip in the output.
   321	    - Sort the source squares by position (top-to-bottom, then left-to-right). For each source in that order, emit four sz x sz beams in the sequence up, then right, then down, then left.
   322	    - A beam moves one cell at a time, painting only background cells with the source color. If its next footprint meets any previously existing colored block, look up that hit color in the legend and turn 90 degrees accordingly (left bar = counterclockwise, right bar = clockwise).
   323	    - After a beam finishes, its newly painted trail stays on the board and becomes a real obstacle for all later beams from the same source and from later sources.
   324	    - A beam stops only when its next step would leave the grid.
   325	
   326	    Key insight: The legend now governs both border obstacles and old beam trails, because every source trail keeps the source color. Solving the task therefore requires tracking visible source order as well as the per-color turn rule.
   327	    """
   328	    g = np.asarray(grid, dtype=int)
   329	
   330	    rows_with_legend = np.where(np.any(g == LEGEND_BG, axis=1))[0]
   331	    assert rows_with_legend.size, "legend rows must be present"
   332	    legend_h = int(rows_with_legend.max() + 1)
   333	    assert np.array_equal(rows_with_legend, np.arange(legend_h)), "legend color must be confined to the top band"
   334	
   335	    turns = _parse_legend(g, legend_h)
   336	    base = g[legend_h:, :].copy()
   337	    assert base.size, "main grid must remain after legend crop"
   338	
   339	    vals, counts = np.unique(base, return_counts=True)
   340	    bg = int(vals[counts.argmax()])

