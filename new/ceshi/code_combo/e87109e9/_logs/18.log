+
+
+def _top_span_for_sources(
+    template: dict[str, object],
+    source_cols: list[int],
+    w: int,
+    side_thickness: int,
+) -> tuple[int, int] | None:
+    sc0 = source_cols[0]
+    if template["side"] == _E:
+        upper = min(source_cols[1:]) - 2
+        start_lo = max(0, sc0 - 3)
+        start_hi = sc0
