    bars_on_left: bool,
    bars: list[tuple[int, int]],
) -> None:
    """Simulate the periodic extension onto the ext side (nearest-first, no overwrite)."""
    w = out.shape[1]
    for length, color in bars:
        if bars_on_left:
            positions = range(sep_col + 1, w, length)
        else:
            positions = range(sep_col - 1, -1, -length)
        for cc in positions:
            if out[row, cc] == 0:
                out[row, cc] = color


