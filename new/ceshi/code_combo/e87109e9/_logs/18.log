+
+        for d0 in range(4):
+            r, c, d = sr, sc, d0
+            seen: set[tuple[int, int, int]] = set()
+            beam_mask = np.zeros_like(base, dtype=bool)
+            while True:
+                state = (r, c, d)
+                assert state not in seen, "beam path must not cycle"
+                seen.add(state)
+
+                dr, dc = _DIRS[d]
+                nr, nc = r + dr, c + dc
+                if not in_bounds(nr, nc):
+                    break
+
+                hit = obstacle_at_next(nr, nc)
