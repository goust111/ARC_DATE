    base = np.full((h, w), bg, dtype=int)
    occupied = np.zeros((h, w), dtype=bool)
    bad=False
    for (sr, sc), color in zip(source_positions, source_colors):
        if occupied[sr:sr+mod.SOURCE_SIZE, sc:sc+mod.SOURCE_SIZE].any():
            bad=True; break
        occupied[sr:sr+mod.SOURCE_SIZE, sc:sc+mod.SOURCE_SIZE] = True
        base[sr:sr+mod.SOURCE_SIZE, sc:sc+mod.SOURCE_SIZE] = color
    if bad: continue
    r0,r1,c0,c1 = mod._edge_rect(mod._N, top_thickness, top_span, h, w)
    if occupied[r0:r1+1,c0:c1+1].any():
        continue
    base[r0:r1+1,c0:c1+1] = obstacle_color
    try:
        expected, stats = mod._simulate_sequential(base, turns, bg)
        baseline = mod._simulate_independent(base, turns, bg)
    except AssertionError:
        continue
    if sum(s['other_trail_hits'] for s in stats) < 1:
        continue
    if np.array_equal(expected, baseline):
        continue
    print('success', trial, template['name'], rows, cols, stats)
    break
else:
    print('no success')
