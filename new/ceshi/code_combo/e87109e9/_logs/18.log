+    right_neighbors = [c for c in source_cols[1:] if c > sc0]
+    left_guard = (max(left_neighbors) + 2) if left_neighbors else 0
+    right_guard = (min(right_neighbors) - 2) if right_neighbors else (w - side_thickness - 2)
