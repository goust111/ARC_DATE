+    occupied[h_src["r"] : h_src["r"] + h_src["h"], h_src["c"] : h_src["c"] + h_src["w"]] = True
+    occupied[v_src["r"] : v_src["r"] + v_src["h"], v_src["c"] : v_src["c"] + v_src["w"]] = True
