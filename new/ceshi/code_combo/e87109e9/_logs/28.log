+    first_side_h = _S if h_src["edge"] == _N else _N
+    first_side_v = _E if v_src["edge"] == _W else _W
+
+    thickness_h = random.randint(*OBS_THICKNESS_RANGE)
+    thickness_v = random.randint(*OBS_THICKNESS_RANGE)
+    span_h = _choose_span(
+        w,
+        [required_h],
