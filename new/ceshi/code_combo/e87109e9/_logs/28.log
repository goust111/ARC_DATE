+    """Simulate all source-pair beams and collect statistics used by generator checks."""
+    sources = _extract_sources(base)
+    out = base.copy()
+    H, W = out.shape
+    hits: list[list[tuple[int, int, int, int]]] = []
+    beam_slide_steps: list[int] = []
+    beam_slide_events: list[int] = []
