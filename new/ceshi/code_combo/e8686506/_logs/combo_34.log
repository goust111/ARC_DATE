+
+    meta = dict(meta)
+    meta["template_col"] = int(template_col)
+    meta["template_area"] = int(_VALID_TEMPLATE_BITMAPS[(H, W)].sum())
+    return (inp, meta) if return_meta else inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(_GEN_MAX_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
