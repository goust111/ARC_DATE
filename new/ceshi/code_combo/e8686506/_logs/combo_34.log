+        for r, c in chunk:
+            for nb in _neighbors4(r, c):
+                j = owner.get(nb)
+                if j is None or j == idx:
+                    continue
+                gj = group_ids[j]
+                if gi != gj:
+                    adj[gi].add(gj)
+                    adj[gj].add(gi)
+    return adj
+
+
+def _color_groups(
+    chunks: list[list[tuple[int, int]]],
+    group_ids: list[int],
+) -> list[int] | None:
+    n_groups = max(group_ids) + 1
+    adj = _group_adjacency(chunks, group_ids)
+    n_colors = min(_N_COLORS_MAX, n_groups)
+    if n_colors < _N_COLORS_MIN:
