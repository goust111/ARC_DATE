+        if ok and len(set(int(c) for c in colors if c is not None)) == n_colors:
+            return [int(colors[gi]) for gi in group_ids]
+    return None
+
+
+def _build_output() -> tuple[np.ndarray | None, int, dict[str, int] | None]:
+    H, W = random.choice(_OUTPUT_DIMS)
