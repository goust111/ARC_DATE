+    sig_by_group: list[tuple] = [tuple() for _ in range(n_groups)]
+    for gi in range(n_groups):
+        sigs = []
+        for idx, chunk in enumerate(chunks):
+            if group_ids[idx] != gi:
+                continue
+            arr = np.array(chunk, dtype=int)
+            r0, c0 = arr.min(axis=0)
