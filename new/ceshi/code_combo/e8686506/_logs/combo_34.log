+        "n_colors": int(n_colors),
+    }
+    return out, bg, meta
+
+
+def _extract_patches(out: np.ndarray, bg: int) -> list[np.ndarray]:
+    patches = []
+    for col in sorted(set(map(int, np.unique(out))) - {bg}):
