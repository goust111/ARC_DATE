+    # Top stem: self-symmetric U-shape plus a center singleton.
+    add([(0, mc - 1), (0, mc), (0, mc + 1), (1, mc - 1), (1, mc + 1)])
+    add([(1, mc)])
+
+    # Optional extra stem bars for 9-row crosses.
+    if H == 9:
+        add([(2, mc - 1), (2, mc), (2, mc + 1)])
+
