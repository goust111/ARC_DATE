+    # Bottom stem: center singleton plus inverted self-symmetric U-shape.
+    add([(H - 2, mc)])
+    add([(H - 1, mc - 1), (H - 1, mc), (H - 1, mc + 1), (H - 2, mc - 1), (H - 2, mc + 1)])
