+
+def _group_adjacency(
+    chunks: list[list[tuple[int, int]]],
+    group_ids: list[int],
+) -> list[set[int]]:
+    n_groups = max(group_ids) + 1
+    owner: dict[tuple[int, int], int] = {}
+    for idx, chunk in enumerate(chunks):
+        for cell in chunk:
