    def disjoint_batch(ti: int, places: list[tuple[int, int]]) -> bool:
        seen: set[tuple[int, int]] = set()
        coords = types[ti]["coords"]
        for r0, c0 in places:
            for dr, dc in coords:
                cell = (r0 + dr, c0 + dc)
                if cell in seen:
                    return False
                seen.add(cell)
