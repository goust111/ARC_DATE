+
+def _normalized_frame_bitmap(parts: list[tuple[int, np.ndarray]], n: int) -> np.ndarray:
+    all_pts = np.concatenate([pts for _, pts in parts])
+    r0, c0 = int(all_pts[:, 0].min()), int(all_pts[:, 1].min())
+    bmp = np.zeros((n, n), dtype=bool)
