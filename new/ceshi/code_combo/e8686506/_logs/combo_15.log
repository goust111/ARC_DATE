   418	def main(grid: np.ndarray) -> np.ndarray:
   419	    """
   420	    Assemble row-banded fragments into a left-right symmetric rectangle.
   421	
   422	    Input structure:
   423	    - The most common color is background; one or two 8-connected frame pieces still appear as an aligned HxW symmetric outline.
   424	    - Every other fragment is disconnected and placed in a separate ordered arrangement: pieces sharing a solved row are aligned on the same input row band, and their left/right order matches the solved picture.
   425	
   426	    Rule:
   427	    - Infer the output rectangle size from total non-background area.
   428	    - Lock the frame and any corner/bar/side-line anchor cells exactly as in the base task.
   429	    - Place each remaining piece so shape and color fit, the final rectangle stays LR-symmetric, same-color copies never 4-touch, and every pair of piece top-left coordinates preserves the input row-band and column-band relations.
   430	
   431	    Key insight:
   432	    - The non-frame region is already an exploded row-major sketch of the finished rectangle, so the input positions tell you which pieces belong on the same solved row and which ones belong further left or right; the frame then converts those positional hints into a unique dense packing.
   433	    """
   434	    g = np.asarray(grid, dtype=int)
   435	    bg = get_bg(g)
   436	
   437	    total_area_all = int(np.count_nonzero(g != bg))
   438	    dims = [(h, w) for h, w in _factors(total_area_all) if h >= w]
   439	    assert dims, "at least one portrait factor pair must exist for the total piece area"
   440	    best_gap = min(abs(h - w) for h, w in dims)
   441	    best_dims = [(h, w) for h, w in dims if abs(h - w) == best_gap]
   442	    assert len(best_dims) == 1, "closest-to-square portrait output shape must be unique"
   443	    H, W = best_dims[0]
   444	
   445	    frame_parts = _find_frame_parts(g, bg, H, W)
   446	    frame_req, frame_mask = _frame_req_and_mask(g.shape, H, W, frame_parts)
   447	
   448	    pieces, comps_by_color, color_piece_count, total_area = _extract_non_frame_pieces(g, bg, frame_mask)
   449	    assert total_area == total_area_all, "piece-area accounting must match non-background area"
   450	
   451	    req = _build_requirements(H, W, comps_by_color)
   452	    frame_cells = np.argwhere(frame_req != -1)
   453	    for r, c in frame_cells:
   454	        req[int(r), int(c)] = int(frame_req[int(r), int(c)])
   455	
   456	    fixed_board = np.full((H, W), -1, dtype=int)
   457	    for r, c in frame_cells:
   458	        fixed_board[int(r), int(c)] = int(frame_req[int(r), int(c)])
   459	
   460	    disallow_touch = {col for col, n in color_piece_count.items() if n > 1}
   461	    sol = _solve_with_layout(pieces, H, W, req, fixed_board, disallow_touch)
   462	    return sol.astype(int)
   463	
