   496	def _valid_dims() -> list[tuple[int, int]]:
   497	    results = []
   498	    for area in range(_AREA_MIN, _AREA_MAX + 1):
   499	        dims = [(area // w, w) for w in range(1, area + 1) if area % w == 0 and area // w >= w]
   500	        best_gap = min(abs(h - w) for h, w in dims)
   501	        best = [(h, w) for h, w in dims if abs(h - w) == best_gap]
   502	        if len(best) == 1:
   503	            h, w = best[0]
   504	            if w == _WIDTH_REQUIRED and h <= _HEIGHT_MAX:
   505	                results.append((h, w))
   506	    return results
   507	
   508	
   509	_VALID_DIMS = _valid_dims()
   510	_DIM_WEIGHTS = [h * w for h, w in _VALID_DIMS]
