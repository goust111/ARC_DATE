   202	def _frame_req_and_mask(
   203	    full_shape: tuple[int, int],
   204	    H: int,
   205	    W: int,
   206	    frame_parts: list[tuple[int, np.ndarray]],
   207	) -> tuple[np.ndarray, np.ndarray]:
