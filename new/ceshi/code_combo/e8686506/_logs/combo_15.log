   311	def _candidate_ok(
   312	    idx: int,
   313	    cand: dict,
   314	    pieces: list[dict],
   315	    board: np.ndarray,
   316	    placed: dict[int, dict],
   317	    row_rel: list[list[int]],
   318	    col_rel: list[list[int]],
   319	    disallow_touch: set[int],
   320	    W: int,
   321	) -> bool:
   322	    col = int(pieces[idx]["col"])
   323	    for j, other in placed.items():
   324	        if _sign(int(cand["r0"]) - int(other["r0"])) != row_rel[idx][j]:
   325	            return False
   326	        if _sign(int(cand["c0"]) - int(other["c0"])) != col_rel[idx][j]:
   327	            return False
   328	
   329	    for r, c in cand["cells"]:
   330	        if board[r, c] != -1:
   331	            return False
   332	        mc = W - 1 - c
   333	        mv = board[r, mc]
   334	        if mv != -1 and int(mv) != col:
   335	            return False
   336	        if col in disallow_touch:
   337	            for rr, cc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
   338	                if 0 <= rr < board.shape[0] and 0 <= cc < board.shape[1] and board[rr, cc] == col:
   339	                    return False
   340	    return True
   341	
   342	
   343	def _place(board: np.ndarray, cand: dict, col: int) -> list[tuple[int, int]]:
   344	    changed = []
   345	    for r, c in cand["cells"]:
   346	        board[r, c] = int(col)
   347	        changed.append((int(r), int(c)))
   348	    return changed
   349	
   350	
   351	def _unplace(board: np.ndarray, changed: list[tuple[int, int]]) -> None:
   352	    for r, c in changed:
   353	        board[r, c] = -1
   354	
   355	
   356	def _solve_with_layout(
   357	    pieces: list[dict],
   358	    H: int,
   359	    W: int,
   360	    req: np.ndarray,
   361	    fixed_board: np.ndarray,
   362	    disallow_touch: set[int],
   363	) -> np.ndarray:
   364	    n = len(pieces)
   365	    row_rel, col_rel = _relation_mats(pieces)
   366	    cand_lists = [
   367	        _static_candidates(piece, H, W, req, fixed_board, disallow_touch)
   368	        for piece in pieces
   369	    ]
   370	    assert all(cands for cands in cand_lists), "a piece has no valid placement under static constraints"
   371	
   372	    board = fixed_board.copy()
   373	    placed: dict[int, dict] = {}
   374	    remaining = set(range(n))
   375	
   376	    def feasible(i: int) -> list[dict]:
   377	        return [
   378	            cand
   379	            for cand in cand_lists[i]
   380	            if _candidate_ok(i, cand, pieces, board, placed, row_rel, col_rel, disallow_touch, W)
   381	        ]
   382	
   383	    def search() -> bool:
   384	        if not remaining:
   385	            return True
   386	
   387	        best_i = None
   388	        best_opts: list[dict] | None = None
   389	        for i in sorted(remaining):
   390	            opts = feasible(i)
   391	            if not opts:
   392	                return False
   393	            if best_opts is None or len(opts) < len(best_opts):
   394	                best_i = i
   395	                best_opts = opts
   396	                if len(best_opts) == 1:
   397	                    break
   398	
   399	        assert best_i is not None and best_opts is not None
   400	        remaining.remove(best_i)
   401	        try:
   402	            for cand in best_opts:
   403	                changed = _place(board, cand, int(pieces[best_i]["col"]))
   404	                placed[best_i] = cand
   405	                if all(feasible(j) for j in remaining) and search():
   406	                    return True
   407	                del placed[best_i]
   408	                _unplace(board, changed)
   409	            return False
   410	        finally:
   411	            remaining.add(best_i)
   412	
   413	    assert search(), "layout-constrained assembly failed"
   414	    assert np.array_equal(board, board[:, ::-1]), "assembled board must be LR-symmetric"
   415	    return board
