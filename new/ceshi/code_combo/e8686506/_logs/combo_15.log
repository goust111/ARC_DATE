   466	
   467	# Output dimensions
   468	_AREA_MIN = 25
   469	_AREA_MAX = 50
   470	_WIDTH_REQUIRED = 5
   471	_HEIGHT_MAX = 10
   472	
   473	# Colors
   474	_N_COLORS_MIN = 4
   475	_N_COLORS_MAX = 6
   476	_TWO_FRAME_MIN_H = 6
   477	_TWO_FRAME_MIN_COLORS = 5
   478	_TWO_FRAME_PROB = 0.35
   479	_CENTER_CAP_PROB = 0.5
   480	
   481	# Piece constraints
   482	_MAX_PIECE_AREA = 6
   483	_MAX_CHUNK_SIZE = 6
   484	_PIECE_COUNT_MIN = 9
   485	_PIECE_COUNT_MAX = 17
   486	
   487	# Ordered arrangement layout
   488	_BAND_GAP = 1
   489	_FRAME_LAYOUT_SEP = 3
   490	_CANVAS_MARGIN = 1
   491	
   492	# Retry
   493	_GEN_MAX_RETRIES = 300
