    occupied = board != -1
    has_seed = bool(occupied.any())
    for r0 in range(H - h + 1):
        for c0 in range(W - w + 1):
            abs_coords = [(r0 + int(dr), c0 + int(dc)) for dr, dc in piece["coords"]]
            if not _coords_lr_symmetric(abs_coords, W):
