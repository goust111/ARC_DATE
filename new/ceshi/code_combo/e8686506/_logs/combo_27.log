+def _build_output() -> tuple[np.ndarray, int]:
+    H = random.choice(sorted(_PATTERNS_BY_H))
+    W = 5
+    bg = random.choice(_BG_CHOICES)
+    pattern = _PATTERNS_BY_H[H]
