+        got = main(inp)
+        rev = _solve_with_order(inp, reverse_color_ties=True)
+    except Exception:
+        return None
+    if not np.array_equal(got, out):
+        return None
+    if np.array_equal(got, rev):
+        return None
+    return inp
+
