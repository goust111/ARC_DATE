+    paste(canvas, frame_patch, off_r, off_c, transparent=bg)
+    return canvas
+
+
+def _gen_attempt() -> np.ndarray | None:
+    out, bg = _build_output()
+    try:
+        inp = _scatter(out, bg)
+        got = main(inp)
+        rev = _solve_with_order(inp, reverse_color_ties=True)
