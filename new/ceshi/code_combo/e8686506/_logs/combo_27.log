+    max_r = rows - H - 2
+    max_c = cols - W - 2
+    if max_r < 1 or max_c < 1:
+        raise ValueError("frame patch does not fit on the canvas")
+    off_r = random.randint(1, max_r)
+    off_c = random.randint(1, max_c)
