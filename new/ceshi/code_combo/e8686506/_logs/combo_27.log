+            canvas,
+            patch,
+            transparent=bg,
+            padding=_SCATTER_PADDING,
+            padding_connectivity=8,
+        )
+        paste(canvas, patch, r, c, transparent=bg)
+
+    canvas[off_r : off_r + H, off_c : off_c + W] = bg
+    paste(canvas, frame_patch, off_r, off_c, transparent=bg)
+    return canvas
+
