+
+import numpy as np
+
+from arc_utils import bbox_coords, components_mask, get_bg, paste, random_free_location
+
+
+_ORDERABLE_COLORS = [1, 2, 3, 4, 6, 8, 9]
+_BG_CHOICES = [0, 5, 7]
+
+_CANVAS_MIN = 13
+_CANVAS_MAX = 15
+_SCATTER_PADDING = 1
+_GEN_MAX_RETRIES = 300
+
+_PATTERNS_BY_H = {
+    7: [2, 1, 1, 1],        # 6/3/3/3
+    8: [2, 2, 1, 1],        # 6/6/3/3
+    9: [2, 2, 1, 1, 1],     # 6/6/3/3/3
+    10: [2, 2, 2, 1, 1],    # 6/6/6/3/3
+}
