+    three_id = random.choice(can_three) if promote_three else None
+
+    chosen = {}
+    for comp_id in range(4):
+        k = 3 if comp_id == three_id else 2
+        chosen[comp_id] = random.choice(valid_by_id[comp_id][k])
+    return chosen
