+def _compositions(total: int, k: int, min_part: int = 1) -> list[tuple[int, ...]]:
+    out: list[tuple[int, ...]] = []
+
+    def rec(rem: int, left: int, acc: list[int]) -> None:
+        if left == 1:
+            if rem >= min_part:
+                out.append(tuple(acc + [rem]))
+            return
+        max_first = rem - min_part * (left - 1)
+        for first in range(min_part, max_first + 1):
