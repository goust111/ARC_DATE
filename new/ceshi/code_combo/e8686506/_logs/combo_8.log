+    fill_pool = palette[4:7]
+    if len(fill_pool) < 2:
+        return None, 0, None
+
+    fill_colors = []
+    prev = None
+    for _ in range(4):
+        opts = [c for c in fill_pool if c != prev]
+        col = random.choice(opts or fill_pool)
+        fill_colors.append(col)
+        prev = col
