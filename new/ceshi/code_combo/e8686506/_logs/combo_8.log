+        for comp_id in range(4)
+    }
+    valid_by_id: dict[int, dict[int, list[list[tuple[tuple[int, int], ...]]]]] = {}
+    for comp_id, coords_abs in coords_by_id.items():
+        valid_by_id[comp_id] = {}
