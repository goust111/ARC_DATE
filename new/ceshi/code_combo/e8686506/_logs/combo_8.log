+        "c0": int(c0),
+        "h": _shape_dims(norm)[0],
+        "w": _shape_dims(norm)[1],
+        "area": len(norm),
+        "fill_mode": fill_mode,
+        "border_color": int(border_color),
+        "fill_color": int(fill_color),
+    }
+
+
+def _make_output() -> tuple[np.ndarray | None, int, list[dict] | None]:
