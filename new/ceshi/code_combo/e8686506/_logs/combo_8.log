+    for piece in order:
+        patch = _patch_from_piece(out, piece, bg)
+        r, c = random_free_location(
+            canvas,
+            patch,
+            transparent=bg,
+            padding=_SCATTER_PADDING,
+            padding_connectivity=8,
+        )
