+
+
+def _paint_piece(
+    out: np.ndarray,
+    cells_abs: tuple[tuple[int, int], ...],
+    border_color: int,
+    fill_color: int,
+) -> dict:
+    norm = _norm_coords_from_iter(cells_abs)
+    fill_rel, fill_mode = _infer_fill_rel_coords(norm)
