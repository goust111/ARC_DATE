+            valid_by_id[comp_id][k] = _valid_band_partitions(coords_abs, k)
+        if not valid_by_id[comp_id][2]:
+            return None
+
+    can_three = [comp_id for comp_id in range(4) if valid_by_id[comp_id][3]]
