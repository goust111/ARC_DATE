+_OUTPUT_SIZE = 7
+_N_COLORS = 4
+_PIECE_COUNT_REQUIRED = 17
+_CANVAS_MIN = 13
+_CANVAS_MAX = 15
+_SCATTER_PADDING = 1
+_MIN_ROT90_VISIBLE = 2
+_MIN_QUARTER_TURN_CANDIDATES = 3
+_GEN_MAX_RETRIES = 400
