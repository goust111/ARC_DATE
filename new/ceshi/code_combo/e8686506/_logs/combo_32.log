+    def candidate_cells(ti: int, variant: dict, r0: int, c0: int) -> list[tuple[int, int]] | None:
+        col = int(types[ti]["col"])
+        cells = [(r0 + dr, c0 + dc) for dr, dc in variant["coords"]]
+        cellset = set(cells)
