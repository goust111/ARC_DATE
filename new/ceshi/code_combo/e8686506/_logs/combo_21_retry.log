    ```python
    import numpy as np

from arc_utils import bbox_coords, components_mask, get_bg, paste, random_free_location
import random


def _piece_sig(pts: np.ndarray) -> tuple[int, int, tuple[tuple[int, int], ...]]:
    r0, c0, r1, c1 = bbox_coords(pts)
    coords = tuple(sorted((int(r) - r0, int(c) - c0) for r, c in pts))
    return (r1 - r0 + 1), (c1 - c0 + 1), coords


def _factors(n: int) -> list[tuple[int, int]]:
    out = []
    for w in range(1, n + 1):
        if n % w == 0:
            h = n // w
            out.append((h, w))
    return out


def _build_requirements(
    H: int,
    W: int,
    comps_by_color: dict[int, list[list[tuple[int, int]]]],
) -> np.ndarray:
    """
    Build per-cell required color constraints (req[r,c] == -1 means unconstrained).

    Heuristics supported by training examples:
      - If there is a color with exactly 4 singleton components, those are the four corners.
      - If there are full horizontal bars of length W-2 in the input, use them as the top/bottom edges
        between the corners (ordered by their vertical position in the input).
      - If there is a color with exactly two full vertical line components (width=1) in the input,
        place them on the left/right edges centered vertically.
    """
    req = np.full((H, W), -1, dtype=int)

    # 4 singleton components -> corners
    corner_colors = [
        col
        for col, comps in comps_by_color.items()
        if len(comps) == 4 and all(len(p) == 1 for p in comps)
    ]
    assert len(corner_colors) <= 1, "corner singleton color must be unique when present"
    corner_color = corner_colors[0] if corner_colors else None
    if corner_color is not None:
        req[0, 0] = corner_color
        req[0, W - 1] = corner_color
        req[H - 1, 0] = corner_color
        req[H - 1, W - 1] = corner_color

    # Horizontal bar(s) of length W-2 (filled, height 1)
    bar_colors: list[tuple[int, int]] = []  # (min_input_row, color)
    if W >= 3 and corner_color is not None:
        for col, comps in comps_by_color.items():
            for pts in comps:
                r0, c0, r1, c1 = bbox_coords(pts)
                hh, ww = r1 - r0 + 1, c1 - c0 + 1
                if hh == 1 and ww == (W - 2) and len(pts) == ww:
                    bar_colors.append((r0, col))
                    break
        if bar_colors:
            assert len(bar_colors) <= 2, "horizontal edge bar colors must be top/bottom only"
            bar_colors.sort()
            top_col = bar_colors[0][1]
            bot_col = bar_colors[-1][1]
            req[0, 1 : W - 1] = top_col
            req[H - 1, 1 : W - 1] = bot_col

    # Two full vertical line components -> left/right edges, centered vertically
    vertical_line_candidates = []
    for col, comps in comps_by_color.items():
        if len(comps) != 2:
            continue
        sigs = [_piece_sig(pts) for pts in comps]
        (h0, w0, coords0), (h1, w1, coords1) = sigs[0], sigs[1]
        if w0 == 1 and w1 == 1 and h0 == h1 and coords0 == coords1 and h0 > 1:
            vertical_line_candidates.append((col, h0))
    assert len(vertical_line_candidates) <= 1, "paired vertical edge-line color must be unique when present"
    if vertical_line_candidates:
        col, L = vertical_line_candidates[0]
        top = (H - L) // 2
        assert 0 <= top and top + L <= H, "paired vertical edge lines must fit in the output height"
        req[top : top + L, 0] = col
        req[top : top + L, W - 1] = col

    return req


def _assemble(
    types: list[dict],
    H: int,
    W: int,
    req: np.ndarray,
    disallow_touch: set[int] | None = None,
) -> np.ndarray:
    board = np.full((H, W), -1, dtype=int)
    counts = [int(t["cnt"]) for t in types]

    def mirror_ok(r: int, c: int, col: int) -> bool:
        mc = W - 1 - c
        v = board[r, mc]
        return (v == -1) or (v == col)

    def can_place(ti: int, r0: int, c0: int) -> bool:
        t = types[ti]
        col = int(t["col"])
        is_singleton = len(t["coords"]) == 1
        for dr, dc in t["coords"]:
            r, c = r0 + dr, c0 + dc
            if board[r, c] != -1:
                return False
            if req[r, c] != -1 and int(req[r, c]) != col:
                return False
            if not mirror_ok(r, c, col):
                return False
            if is_singleton and not (r == 0 or r == H - 1 or c == 0 or c == W - 1):
                return False
            if disallow_touch and col in disallow_touch:
                for rr, cc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
                    if 0 <= rr < H and 0 <= cc < W and board[rr, cc] == col:
                        return False
        return True

    def place(ti: int, r0: int, c0: int) -> list[tuple[int, int]]:
        t = types[ti]
        col = int(t["col"])
        changed = []
        for dr, dc in t["coords"]:
            r, c = r0 + dr, c0 + dc
            board[r, c] = col
            changed.append((r, c))
        return changed

    def unplace(changed: list[tuple[int, int]]) -> None:
        for r, c in changed:
            board[r, c] = -1

    def placements_for(ti: int) -> list[tuple[int, int]]:
        t = types[ti]
        return [(r0, c0)
                for r0 in range(H - int(t["h"]) + 1)
                for c0 in range(W - int(t["w"]) + 1)
                if can_place(ti, r0, c0)]

    # Pure constraint propagation: each step, every type must be forced (1 position)
    # or batch-forced (positions == cnt). No backtracking. Asserts if stuck.
    changed = True
    while changed:
        changed = False
        for ti in range(len(types)):
            if counts[ti] <= 0:
                continue
            places = placements_for(ti)
            assert len(places) > 0, "assembly dead end: a piece has no valid placement"
            if len(places) == 1:
                counts[ti] -= 1
                place(ti, places[0][0], places[0][1])
                changed = True
            elif len(places) == counts[ti]:
                for r0, c0 in places:
                    counts[ti] -= 1
                    place(ti, r0, c0)
                changed = True
    assert all(c == 0 for c in counts), "assembly not purely propagation-solvable"
    assert np.array_equal(board, board[:, ::-1]), "assembled board must be LR-symmetric"
    return board


def main(grid: np.ndarray) -> np.ndarray:
    """
    Assemble scattered colored fragments into a left-right symmetric rectangle, jigsaw-style.

    Input structure:
    - bg = most common color; remaining colors form small sprite fragments.
    - Optional roles: 4 singleton pixels of one color mark corners; horizontal bars mark top/bottom edges; paired vertical lines mark left/right edges.

    Rule:
    - Collect all non-bg connected components as jigsaw pieces.
    - Determine output rectangle dimensions from total piece area.
    - Pack pieces into the rectangle so it is exactly mirror-symmetric (left-right) and same-color pieces never 4-touch.

    Key insight: Left-right symmetry plus the no-same-color-touching constraint make the assembly unique; corner/edge markers anchor it when present.
    """
    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)

    # Extract pieces (connected components per color)
    comps_by_color: dict[int, list[list[tuple[int, int]]]] = {}
    pieces = []
    color_piece_count: dict[int, int] = {}

    for col in sorted(set(map(int, np.unique(g)))):
        if col == bg:
            continue
        comps = components_mask(g == col, connectivity=4)
        comps_by_color[col] = comps
        color_piece_count[col] = len(comps)
        for pts in comps:
            _, _, coords = _piece_sig(pts)
            pieces.append((col, coords))

    # Group identical pieces into types
    from collections import Counter

    ctr = Counter(pieces)
    types = []
    for (col, coords), cnt in sorted(ctr.items(), key=lambda kv: (-len(kv[0][1]), kv[0][0], kv[0][1])):
        arr = np.array(coords, dtype=int)
        h = int(arr[:, 0].max() + 1)
        w = int(arr[:, 1].max() + 1)
        types.append({"col": int(col), "coords": coords, "h": h, "w": w, "cnt": int(cnt)})

    total_area = sum(int(t["cnt"]) * len(t["coords"]) for t in types)
    assert total_area > 0, "total_area must be positive: grid must contain non-background pieces"

    # Disallow 4-neigh touching between different pieces of same color (preserve component counts)
    # Eval inputs use the unique closest-to-square portrait factor pair as the output shape.
    dims = [(h, w) for (h, w) in _factors(total_area) if h >= w]
    assert dims, "at least one portrait factor pair must exist for the total piece area"
    best_gap = min(abs(h - w) for h, w in dims)
    best_dims = [(h, w) for h, w in dims if abs(h - w) == best_gap]
    assert len(best_dims) == 1, "closest-to-square portrait output shape must be unique"
    H, W = best_dims[0]

    # Frame constraint: under 8-connectivity, 1-2 pieces must exist whose union bbox
    # equals the output rectangle (H x W). Their relative positions are fixed in output.
    comps8_all = []
    for col in sorted(set(map(int, np.unique(g))) - {bg}):
        for pts in components_mask(g == col, connectivity=8):
            comps8_all.append((int(col), pts))
    def _is_lr_symmetric(parts, h, w):
        """Check if the union of frame parts forms an LR-symmetric bitmap."""
        all_pts = np.concatenate([p for _, p in parts])
        r0, c0 = int(all_pts[:, 0].min()), int(all_pts[:, 1].min())
        bmp = np.zeros((h, w), dtype=bool)
        for _, pts in parts:
            for r, c in pts:
                bmp[int(r) - r0, int(c) - c0] = True
        return np.array_equal(bmp, bmp[:, ::-1])

    frame_parts: list[tuple[int, np.ndarray]] = []
    for i, (c1, p1) in enumerate(comps8_all):
        r0, c0, r1, c1b = bbox_coords(p1)
        if r1 - r0 + 1 == H and c1b - c0 + 1 == W:
            if _is_lr_symmetric([(c1, p1)], H, W):
                frame_parts = [(c1, p1)]
                break
        for j in range(i + 1, len(comps8_all)):
            c2, p2 = comps8_all[j]
            union = np.concatenate([p1, p2])
            ur0, uc0, ur1, uc1 = bbox_coords(union)
            if ur1 - ur0 + 1 == H and uc1 - uc0 + 1 == W:
                if _is_lr_symmetric([(c1, p1), (c2, p2)], H, W):
                    frame_parts = [(c1, p1), (c2, p2)]
                    break
        if frame_parts:
            break
    assert frame_parts, "input must contain 1-2 LR-symmetric pieces (8-conn) whose union bbox equals output dims"

    req = _build_requirements(H, W, comps_by_color)

    # Lock frame cells into req: their output positions are determined by input-relative positions.
    all_frame_pts = np.concatenate([p for _, p in frame_parts])
    fr0, fc0 = int(all_frame_pts[:, 0].min()), int(all_frame_pts[:, 1].min())
    for col, pts in frame_parts:
        for r, c in pts:
            or_, oc = int(r) - fr0, int(c) - fc0
            if 0 <= or_ < H and 0 <= oc < W:
                req[or_, oc] = col

    disallow_touch = {col for col, n in color_piece_count.items() if n > 1}
    sol = _assemble(types, H, W, req, disallow_touch)
    return sol.astype(int)

# --------------- generator (o5x) ---------------

# === CFG: Output dimensions ===
_AREA_MIN = 25               # minimum total piece area
_AREA_MAX = 50               # maximum total piece area (exclusive upper in range)
_WIDTH_REQUIRED = 5           # all valid outputs have width 5
_HEIGHT_MAX = 10              # maximum output height

# === CFG: Color and palette ===
_N_COLORS_MIN = 4             # min distinct colors in abstract output
_N_COLORS_MAX = 6             # max distinct colors in abstract output
_TWO_FRAME_MIN_H = 6          # min height to allow 2-color frame
_TWO_FRAME_MIN_COLORS = 5     # min palette size to allow 2-color frame
_TWO_FRAME_PROB = 0.35         # probability of splitting frame into 2 colors
_CENTER_CAP_PROB = 0.5         # probability of capping center col at top/bottom

# === CFG: Piece constraints ===
_MAX_PIECE_AREA = 6           # maximum area of any single 4-conn piece
_MAX_CHUNK_SIZE = 6           # max cells per hole chunk when splitting large holes
_PIECE_COUNT_MIN = 9          # min total 4-conn components in output
_PIECE_COUNT_MAX = 17         # max total 4-conn components in output

# === CFG: Canvas / scatter ===
_CANVAS_MIN = 13              # min canvas dimension (rows and cols)
_CANVAS_MAX = 15              # max canvas dimension (rows and cols)
_SCATTER_PADDING = 1          # Chebyshev padding between scattered pieces

# === CFG: Retry ===
_GEN_MAX_RETRIES = 300        # max attempts in generate_input()


def _valid_dims():
    """Precompute valid (H, W) pairs: unique closest-to-square portrait factorization with W=5."""
    results = []
    for area in range(_AREA_MIN, _AREA_MAX + 1):
        dims = [(area // w, w) for w in range(1, area + 1) if area % w == 0 and area // w >= w]
        best_gap = min(abs(h - w) for h, w in dims)
        best = [(h, w) for h, w in dims if abs(h - w) == best_gap]
        if len(best) == 1:
            h, w = best[0]
            if w == _WIDTH_REQUIRED and h <= _HEIGHT_MAX:
                results.append((h, w))
    return results


_VALID_DIMS = _valid_dims()
_DIM_WEIGHTS = [h * w for h, w in _VALID_DIMS]


def _zigzag_frame(H):
    """Generate frame bitmap (Hx2 left-half) via zigzag path from top to bottom.
    Returns (cells, start_c, end_c) where start_c/end_c are the column at top/bottom."""
    cells = set()
    start_c = random.randint(0, 1)
    c = start_c
    for r in range(H):
        cells.add((r, c))
        if r == H - 1:
            break
        move = random.choice(['down', 'horiz', 'diag'])
        if move == 'down':
            pass
        elif move == 'horiz':
            cells.add((r, 1 - c))
            c = 1 - c
        else:
            c = 1 - c
    return cells, start_c, c


def _fill_holes(grid, H, W, half, frame1, frame2, split, fill_pool):
    """Fill non-frame cells by assigning colors to 4-conn hole regions.
    Large holes are split into chunks of <= _MAX_CHUNK_SIZE cells."""
    holes = components_mask(grid == -1, connectivity=4)
    prev_col = None
    for hole in holes:
        cells = sorted((int(r), int(c)) for r, c in hole)
        # Split into chunks of bounded size
        chunks = [cells[i:i + _MAX_CHUNK_SIZE] for i in range(0, len(cells), _MAX_CHUNK_SIZE)]
        for chunk in chunks:
            # Determine which frame colors are adjacent to this chunk
            fc_set = {frame1 if r < split else frame2 for r, _ in chunk}
            # Pick a fill color avoiding frame and previous neighbor
            avoid = fc_set | ({prev_col} if prev_col else set())
            opts = [f for f in fill_pool if f not in avoid]
            if not opts:
                opts = [f for f in fill_pool if f not in fc_set] or fill_pool
            col = random.choice(opts)
            for r, c in chunk:
                grid[r, c] = col
                grid[r, W - 1 - c] = col
            prev_col = col


def _build_output(H, W):
    """Build an abstract LR-symmetric output grid with zigzag frame and filled holes.
    Returns (grid, frame_colors_set) or (None, set()) on failure."""
    half = W // 2
    n_colors = random.randint(_N_COLORS_MIN, _N_COLORS_MAX)
    palette = list(range(n_colors))
    random.shuffle(palette)

    use_two_frames = (H >= _TWO_FRAME_MIN_H and n_colors >= _TWO_FRAME_MIN_COLORS
                      and random.random() < _TWO_FRAME_PROB)
    ci = 0
    frame1 = palette[ci]; ci += 1
    frame2 = frame1
    if use_two_frames:
        frame2 = palette[ci]; ci += 1
    fill_pool = palette[ci:]
    if not fill_pool:
        return None, set()

    frame_half, start_c, end_c = _zigzag_frame(H)
    split = H // 2 if frame1 != frame2 else H

    grid = np.full((H, W), -1, dtype=int)

    # Paint frame cells (mirror left half to right)
    for r, c in frame_half:
        fc = frame1 if r < split else frame2
        grid[r, c] = fc
        grid[r, W - 1 - c] = fc

    # Cap center column at top/bottom when zigzag endpoint is adjacent
    if start_c == 1 and random.random() < _CENTER_CAP_PROB:
        grid[0, half] = frame1
    if end_c == 1 and random.random() < _CENTER_CAP_PROB:
        grid[H - 1, half] = frame2

    _fill_holes(grid, H, W, half, frame1, frame2, split, fill_pool)

    if np.any(grid < 0):
        return None, set()
    frame_set = {frame1}
    if frame2 != frame1:
        frame_set.add(frame2)
    return grid, frame_set


def _make_output() -> tuple[np.ndarray | None, int, set[int]]:
    """Select dims, build abstract output, then remap to real ARC colors."""
    H, W = random.choices(_VALID_DIMS, weights=_DIM_WEIGHTS, k=1)[0]
    out, abstract_fcs = _build_output(H, W)
    if out is None:
        return None, 0, set()
    bg = random.randint(0, 9)
    abstract = sorted(np.unique(out))
    available = [c for c in range(10) if c != bg]
    random.shuffle(available)
    if len(available) < len(abstract):
        return None, 0, set()
    cmap = {int(a): available[i] for i, a in enumerate(abstract)}
    real_fcs = {cmap[a] for a in abstract_fcs}
    return np.vectorize(lambda x: cmap[int(x)])(out), bg, real_fcs


def _extract_non_frame_patches(out, bg, fcs):
    """Extract non-frame piece patches from the output grid, sorted largest-first."""
    patches = []
    for col in sorted(map(int, np.unique(out))):
        if col in fcs:
            continue
        for pts in components_mask(out == col, connectivity=4):
            r0, c0, r1, c1 = bbox_coords(pts)
            patch = np.full((r1 - r0 + 1, c1 - c0 + 1), bg, dtype=int)
            for r, c in pts:
                patch[int(r) - r0, int(c) - c0] = col
            patches.append(patch)
    random.shuffle(patches)
    patches.sort(key=lambda p: (-(p != bg).sum(), random.random()))
    return patches


def _scatter(out: np.ndarray, bg: int, fcs: set[int]) -> np.ndarray:
    """Place pieces onto a canvas: frame as a group, non-frame scattered with padding."""
    rows = random.randint(_CANVAS_MIN, _CANVAS_MAX)
    cols = random.randint(_CANVAS_MIN, _CANVAS_MAX)
    canvas = np.full((rows, cols), bg, dtype=int)
    oh, ow = out.shape

    max_r = rows - oh - 2
    max_c = cols - ow - 2
    if max_r < 1 or max_c < 1:
        raise ValueError
    off_r = random.randint(1, max_r)
    off_c = random.randint(1, max_c)

    # Block the entire frame bbox so fill pieces stay outside the outline
    canvas[off_r:off_r + oh, off_c:off_c + ow] = -1

    # Scatter non-frame pieces into the area OUTSIDE the blocked bbox
    for patch in _extract_non_frame_patches(out, bg, fcs):
        r, c = random_free_location(canvas, patch, transparent=bg,
                                    padding=_SCATTER_PADDING, padding_connectivity=8)
        paste(canvas, patch, r, c, transparent=bg)

    # Replace blocked bbox with frame cells (non-frame positions revert to bg)
    frame_mask = np.zeros((oh, ow), dtype=bool)
    for col in fcs:
        frame_mask |= (out == col)
    bbox_region = canvas[off_r:off_r + oh, off_c:off_c + ow]
    bbox_region[:] = bg
    bbox_region[frame_mask] = out[frame_mask]
    return canvas


def _piece_count(out: np.ndarray) -> int:
    return sum(len(components_mask(out == col, connectivity=4)) for col in np.unique(out))


def _gen_attempt() -> np.ndarray | None:
    """Single generation attempt: build output, validate constraints, scatter, oracle check."""
    out, bg, fcs = _make_output()
    if out is None:
        return None
    if not np.array_equal(out, out[:, ::-1]):
        return None
    if not (_N_COLORS_MIN <= len(np.unique(out)) <= _N_COLORS_MAX):
        return None
    pc = _piece_count(out)
    if not (_PIECE_COUNT_MIN <= pc <= _PIECE_COUNT_MAX):
        return None
    if any(len(pts) > _MAX_PIECE_AREA for col in np.unique(out)
           for pts in components_mask(out == col, connectivity=4)):
        return None
    try:
        inp = _scatter(out, bg, fcs)
        got = main(inp)
    except Exception:
        return None
    if np.array_equal(got, out):
        return inp
    return None


def generate_input() -> np.ndarray:
    for _ in range(_GEN_MAX_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid e8686506 input")

    ```

    ## 原始任务规格（Spec）

    以下是从原始 solver 代码和示例中提炼的完整任务规格，包含精确的数值约束和生成策略。
    Spec 本身就是原题代码生成时的参考文件，因此：
    - 在**设计分析**阶段，参考 spec 理解原始任务的完整设计细节（对象结构、空间关系、生成策略等），以此为基础思考融合变体的改动如何落实
    - 在**实现**阶段，参考 spec 中的数值约束（网格尺寸、对象数量/尺寸、颜色数等），确保融合变体在物理上可实现

    ```yaml
    spec:
  task: assemble scattered jigsaw pieces into a LR-symmetric dense rectangle
  input_grid: 13-15 rows x 13-15 cols, single bg color fills most cells
  output_grid: H x W dense rectangle, H >= W (portrait), dims = closest-to-square factor pair of total piece area
  output_dims_observed: 5x5 (area=25) or 8x5 (area=40)
  output_symmetry: exact left-right mirror; UD symmetry NOT required
  pieces:
    connectivity: each piece is a single-color 8-connected component (NOT 4-connected)
    total_count: 9-17
    distinct_colors: 4-6
    area_per_piece: 1-6
    total_area: 25-40 [observed]; must have unique closest-to-square portrait factor pair
    shapes: rectangles, L/C/zigzag fragments; no rotation applied
    mirror_pairing: asymmetric pieces come in LR-mirror pairs (same color); self-symmetric pieces may appear alone or in matched counts
  frame_constraint: |
    REQUIRED: 1-2 pieces (8-connected) whose union bounding box = output rectangle dims (H x W)
    and whose union bitmap is LR-symmetric. These "frame" pieces outline the assembled
    rectangle via a zigzag contour. In the input, frame pieces are placed as a group
    preserving their relative positions from the output, so the rectangular outline is
    visually recognizable. Non-frame pieces are scattered freely.
  uniqueness: REQUIRED — the assembly must be solvable by pure constraint propagation
    (each step, every remaining piece has exactly one valid placement, or a batch
    where positions = copies). No backtracking needed. Frame locks most cells;
    irregular hole shapes force remaining pieces into unique positions.
  singletons_on_border: 1x1 pieces only appear on the output rectangle border [observed 100%]
  optional_anchors:
    corner_markers: 0-1 colors with exactly 4 singleton pixels -> placed at 4 output corners [observed in 2/3]
    h_bar_edges: 0-2 horizontal bars of width W-2 -> top/bottom edges between corners, ordered by input row [observed in 2/3]
    v_line_pairs: 0-1 colors with 2 identical vertical lines -> left/right edges centered vertically [observed in 2/3]
  input_scatter: pieces placed on bg grid with min Chebyshev distance 1 between any two pieces; no overlaps

generation_strategy:
  approach: output-first
  steps:
    1. Choose output dims H x W (H >= W, W odd so center column exists, area has unique closest-to-square portrait factorization).
    2. Generate frame via zigzag path on the Hx2 left-half grid (top-to-bottom,
       3 moves: down/horiz+down/diag). Mirror to right half. Optionally cap
       top/bottom center col if endpoint is at col 1. Optionally split frame
       into 2 colors (top/bottom halves) for visual variety.
    3. Frame divides the rectangle into hole regions (4-conn components of
       non-frame cells). Fill each hole with one color (split if >6 cells).
       This produces irregular pieces whose shapes match the hole contours.
    4. Mirror left half to right half for LR symmetry.
    5. Extract each 4-conn component as a piece. Validate: 9-17 pieces,
       area 1-6 each, 4-6 distinct colors, 1x1 pieces on border only.
    6. Scatter pieces onto 13-15 x 13-15 input grid. Frame pieces placed as
       a group at output-relative positions (bbox blocked to keep interior clean).
       Non-frame pieces scattered in remaining space.
    7. Validate: solver recovers output via pure constraint propagation.
    ```

额外要求：原始代码的 `main()` 已包含四段式说明注释/文档字符串（开头概述 + `Input structure:` + `Rule:` + `Key insight:`）。
生成的新代码里也必须在 `main()` 上方保留这一结构，并根据**融合后的新规则**与**原注释提供的信息**重新编写；可以借鉴原注释的组织方式，但**不要照抄原文**，要让内容准确反映融合后的输入结构、规则和关键洞察。


## 已有单变体参考代码

以下组成项已有单变体实现，可作为融合时的参考：

            ### 参考代码: D1/1

            文件: `/home/lixinyu/snap/new/ceshi/code/e8686506/D1/1/code.py`

            ```python
            # Variant of e8686506
# Dimension: D1 — 匹配条件：边缘对齐拼合 vs 其他匹配逻辑 (match_cond)
# Change: s.edge.position aligns with d.adjacent_piece.edge — 碎片的边缘位置与... → 连接器标记匹配

import random
from collections import defaultdict

import numpy as np

from arc_utils import bbox_coords, components_mask, get_bg, paste, random_free_location


# ---------------------------------------------------------------------------
# Design analysis for the D1 variant
# ---------------------------------------------------------------------------
# variant_spec:
#   core_change:
#     old: pieces were effectively positioned by output-frame locks plus shape fitting.
#     new: each piece is now a multicolor 8-connected sprite; special connector pixels
#       on piece boundaries must meet an equal-colored connector on a neighboring piece.
#       Two pieces may touch in the final rectangle only when their shared boundary
#       contains at least one connector-to-connector contact.
#   concrete_visualization:
#     input:
#       - one anchored frame piece still appears as a grouped outline with its original
#         output-relative geometry preserved.
#       - the other pieces are scattered, but they are no longer monochrome; small
#         accent pixels of fixed connector colors sit on their edges.
#     output:
#       - the dense rectangle remains exact LR-symmetric.
#       - connector pixels remain visible in the assembled rectangle as small equal-
#         colored pairs straddling seams between neighboring pieces.
#   behavior_trace:
#     original_local_step:
#       - choose a piece placement because its outline is the only way to fit a hole
#         while respecting border/color heuristics.
#     variant_local_step:
#       - choose a piece placement because, once translated into the rectangle, one or
#         more of its connector pixels land directly beside equal-colored connector
#         pixels on already anchored pieces.
#       - mere edge contact is insufficient; touching a neighbor without a connector
#         match is rejected.
#   complexity_calibration:
#     - the frame anchor and LR symmetry are preserved so the task does not become an
#       unconstrained global search.
#     - connector colors are fixed and visually repeated across multiple seams so the
#       new rule is observable from a few examples.
#     - width stays 5 and height stays 8; this is an intentional adaptation so pieces
#       have enough interior contact structure for connector matching to be visible.
#   implicit_assumption_audit:
#     - original solver extracted pieces per color; that breaks once pieces are
#       multicolor, so the new solver extracts 8-connected non-bg components.
#     - original same-color-touch prohibition is no longer a reliable piece-boundary
#       cue, so it is removed from legality checks.
#     - original per-cell req-color anchors based on singleton/bar colors are tied to
#       monochrome pieces and are dropped; the frame piece now provides the main anchor.
#     - mirror checks remain valid, but now they apply to exact cell colors, including
#       connector colors.
#   placement_legality:
#     - generator keeps pieces non-overlapping when scattered and keeps the frame bbox
#       reserved, so input components stay separable.
#     - solver placements must fit in bounds, avoid overlap, preserve LR symmetry, and
#       touch the existing assembly through at least one connector-matched interface.
#   observability_and_cleanliness:
#     - connector colors are fixed, sparse, and only used for connectors, so the new
#       matching cue is visually isolated from ordinary body colors.
#     - the frame remains a single anchored outline, preventing the scene from looking
#       like arbitrary colored noise.


CONNECTOR_COLORS = (6, 7, 8)


def _piece_sig(pts: np.ndarray) -> tuple[int, int, tuple[tuple[int, int], ...]]:
    r0, c0, r1, c1 = bbox_coords(pts)
    coords = tuple(sorted((int(r) - r0, int(c) - c0) for r, c in pts))
    return (r1 - r0 + 1), (c1 - c0 + 1), coords


def _factors(n: int) -> list[tuple[int, int]]:
    out = []
    for w in range(1, n + 1):
        if n % w == 0:
            h = n // w
            out.append((h, w))
    return out


def _normalize_piece(pts: np.ndarray, grid: np.ndarray) -> dict:
    r0, c0, r1, c1 = bbox_coords(pts)
    cells = []
    for r, c in pts:
        dr = int(r) - int(r0)
        dc = int(c) - int(c0)
        cells.append((dr, dc, int(grid[int(r), int(c)])))
    cells.sort()
    coords = {(dr, dc) for dr, dc, _col in cells}
    connectors = {(dr, dc) for dr, dc, col in cells if col in CONNECTOR_COLORS}
    return {
        "cells": tuple(cells),
        "coords": coords,
        "connectors": connectors,
        "h": int(r1 - r0 + 1),
        "w": int(c1 - c0 + 1),
        "area": int(len(cells)),
        "src_bbox": (int(r0), int(c0), int(r1), int(c1)),
    }


def _is_lr_symmetric_mask(coords: set[tuple[int, int]], H: int, W: int) -> bool:
    bmp = np.zeros((H, W), dtype=bool)
    for r, c in coords:
        bmp[int(r), int(c)] = True
    return np.array_equal(bmp, bmp[:, ::-1])


def _find_frame_group(pieces: list[dict], H: int, W: int) -> list[tuple[int, int, int]]:
    def group_ok(idxs: list[int]) -> list[tuple[int, int, int]] | None:
        boxes = [pieces[i]["src_bbox"] for i in idxs]
        gr0 = min(int(b[0]) for b in boxes)
        gc0 = min(int(b[1]) for b in boxes)
        gr1 = max(int(b[2]) for b in boxes)
        gc1 = max(int(b[3]) for b in boxes)
        if int(gr1 - gr0 + 1) != H or int(gc1 - gc0 + 1) != W:
            return None
        coords = set()
        anchors = []
        for i in idxs:
            pr0, pc0, _pr1, _pc1 = pieces[i]["src_bbox"]
            anchors.append((int(i), int(pr0 - gr0), int(pc0 - gc0)))
            for dr, dc, _col in pieces[i]["cells"]:
                coords.add((int(pr0 - gr0 + dr), int(pc0 - gc0 + dc)))
        if not _is_lr_symmetric_mask(coords, H, W):
            return None
        return anchors

    found: list[tuple[int, list[tuple[int, int, int]]]] = []
    for i in range(len(pieces)):
        got = group_ok([i])
        if got is not None:
            area = sum(int(pieces[idx]["area"]) for idx in [i])
            found.append((area, got))
    for i in range(len(pieces)):
        for j in range(i + 1, len(pieces)):
            got = group_ok([i, j])
            if got is not None:
                area = int(pieces[i]["area"]) + int(pieces[j]["area"])
                found.append((area, got))
    assert found, "expected at least one 1-2 piece LR-symmetric frame group"
    best_area = min(area for area, _got in found)
    best = [got for area, got in found if area == best_area]
    assert len(best) == 1, "expected a unique minimum-area frame group"
    return best[0]


def _assemble(pieces: list[dict], H: int, W: int, frame_group: list[tuple[int, int, int]]) -> np.ndarray:
    board = np.full((H, W), -1, dtype=int)
    owner = np.full((H, W), -1, dtype=int)
    is_connector = np.zeros((H, W), dtype=bool)
    placed: dict[int, tuple[int, int]] = {}

    def can_place(pi: int, r0: int, c0: int, require_touch: bool) -> bool:
        piece = pieces[pi]
        local_cells = {}
        touched_neighbors: set[int] = set()
        matched_any = False
        connector_touch_ok: dict[tuple[int, int], bool] = {}
        connector_has_occupied_neighbor: dict[tuple[int, int], bool] = {}

        for dr, dc, col in piece["cells"]:
            r, c = int(r0 + dr), int(c0 + dc)
            if not (0 <= r < H and 0 <= c < W):
                return False
            if owner[r, c] != -1:
                return False
            local_cells[(r, c)] = int(col)

        for (r, c), col in local_cells.items():
            mc = W - 1 - int(c)
            if (r, mc) in local_cells and int(local_cells[(r, mc)]) != int(col):
                return False
            if owner[r, mc] != -1 and int(board[r, mc]) != int(col):
                return False

        for dr, dc, col in piece["cells"]:
            r, c = int(r0 + dr), int(c0 + dc)
            here_is_connector = (int(dr), int(dc)) in piece["connectors"]
            if here_is_connector:
                connector_touch_ok[(r, c)] = False
                connector_has_occupied_neighbor[(r, c)] = False
            for rr, cc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
                if not (0 <= rr < H and 0 <= cc < W):
                    continue
                if (rr, cc) in local_cells:
                    continue
                if owner[rr, cc] == -1:
                    continue
                nid = int(owner[rr, cc])
                touched_neighbors.add(nid)
                if here_is_connector:
                    connector_has_occupied_neighbor[(r, c)] = True
                if here_is_connector and bool(is_connector[rr, cc]) and int(board[rr, cc]) == int(col):
                    matched_any = True
                    connector_touch_ok[(r, c)] = True

        if require_touch and not touched_neighbors:
            return False
        if touched_neighbors and not matched_any:
            return False
        for pos, had_occ in connector_has_occupied_neighbor.items():
            if had_occ and not connector_touch_ok[pos]:
                return False
        return True

    def place(pi: int, r0: int, c0: int) -> list[tuple[int, int]]:
        piece = pieces[pi]
        changed = []
        for dr, dc, col in piece["cells"]:
            r, c = int(r0 + dr), int(c0 + dc)
            board[r, c] = int(col)
            owner[r, c] = int(pi)
            is_connector[r, c] = (int(dr), int(dc)) in piece["connectors"]
            changed.append((r, c))
        placed[int(pi)] = (int(r0), int(c0))
        return changed

    def unplace(pi: int, changed: list[tuple[int, int]]) -> None:
        for r, c in changed:
            board[r, c] = -1
            owner[r, c] = -1
            is_connector[r, c] = False
        placed.pop(int(pi), None)

    def placements_for(pi: int) -> list[tuple[int, int]]:
        piece = pieces[pi]
        require_touch = bool(placed)
        out = []
        for r0 in range(H - int(piece["h"]) + 1):
            for c0 in range(W - int(piece["w"]) + 1):
                if can_place(pi, r0, c0, require_touch):
                    out.append((int(r0), int(c0)))
        return out

    def final_ok() -> bool:
        if np.any(owner == -1):
            return False
        if not np.array_equal(board, board[:, ::-1]):
            return False
        for pi, (r0, c0) in placed.items():
            piece = pieces[pi]
            for dr, dc in piece["connectors"]:
                r, c = int(r0 + dr), int(c0 + dc)
                ok = False
                for rr, cc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
                    if 0 <= rr < H and 0 <= cc < W and owner[rr, cc] != pi:
                        if bool(is_connector[rr, cc]) and int(board[rr, cc]) == int(board[r, c]):
                            ok = True
                            break
                if not ok:
                    return False
        return True

    for pi, r0, c0 in frame_group:
        place(pi, r0, c0)

    def search() -> bool:
        remaining = [pi for pi in range(len(pieces)) if pi not in placed]
        if not remaining:
            return final_ok()

        while True:
            forced = None
            best_pi = None
            best_places = None
            for pi in remaining:
                places = placements_for(pi)
                if not places:
                    return False
                if len(places) == 1:
                    forced = (pi, places[0])
                    break
                if best_places is None or len(places) < len(best_places):
                    best_pi = pi
                    best_places = places
            if forced is None:
                break
            pi, (r0, c0) = forced
            place(pi, r0, c0)
            remaining = [idx for idx in remaining if idx != pi]
            if not remaining:
                return final_ok()

        assert best_pi is not None and best_places is not None
        for r0, c0 in best_places:
            changed = place(best_pi, r0, c0)
            if search():
                return True
            unplace(best_pi, changed)
        return False

    ok = search()
    assert ok, "connector assembly failed"
    return board.astype(int)


def main(grid: np.ndarray) -> np.ndarray:
    """
    Assemble scattered multicolor fragments into a left-right symmetric rectangle using connector pixels.

    Input structure:
    - The background is the most common color; each foreground piece is an 8-connected multicolor sprite.
    - One sprite is a pre-aligned LR-symmetric frame whose bbox already matches the output rectangle.
    - Small pixels of fixed connector colors appear on piece boundaries and act as docking markers.

    Rule:
    - Collect each non-background 8-connected component as one piece, preserving its full color pattern.
    - Infer the output rectangle size from total foreground area.
    - Place the frame at the output anchor, then pack the remaining pieces so the rectangle is exactly LR-symmetric and every inter-piece contact contains a matched connector pair.

    Key insight: shape fitting alone is no longer enough; the decisive cue is that adjacent pieces must meet through equal-colored connector pixels at the seam.
    """
    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)

    comps = components_mask(g != bg, connectivity=8)
    assert comps, "grid must contain foreground pieces"
    pieces = [_normalize_piece(pts, g) for pts in comps]

    total_area = int(sum(piece["area"] for piece in pieces))
    assert total_area > 0, "total area must be positive"
    dims = [(h, w) for h, w in _factors(total_area) if h >= w]
    assert dims, "at least one portrait factorization must exist"
    best_gap = min(abs(h - w) for h, w in dims)
    best_dims = [(h, w) for h, w in dims if abs(h - w) == best_gap]
    assert len(best_dims) == 1, "closest-to-square portrait output shape must be unique"
    H, W = best_dims[0]

    frame_group = _find_frame_group(pieces, H, W)
    sol = _assemble(pieces, H, W, frame_group)
    return sol.astype(int)


# ---------------------------------------------------------------------------
# Generator
# ---------------------------------------------------------------------------

_OUT_H = 10
_OUT_W = 5

_BODY_COLORS_MIN = 4
_BODY_COLORS_MAX = 5
_PIECE_COUNT_MIN = 7
_PIECE_COUNT_MAX = 14
_MAX_PIECE_AREA = 6

_CANVAS_MIN = 13
_CANVAS_MAX = 15
_SCATTER_PADDING = 1
_GEN_MAX_RETRIES = 400


def _zigzag_frame(H: int) -> tuple[set[tuple[int, int]], int, int]:
    cells = set()
    start_c = random.randint(0, 1)
    c = start_c
    for r in range(H):
        cells.add((r, c))
        if r == H - 1:
            break
        move = random.choice(["down", "horiz", "diag"])
        if move == "down":
            pass
        elif move == "horiz":
            cells.add((r, 1 - c))
            c = 1 - c
        else:
            c = 1 - c
    return cells, start_c, c


def _paint_chunk(grid: np.ndarray, chunk: list[tuple[int, int]], color: int) -> None:
    W = grid.shape[1]
    for r, c in chunk:
        grid[int(r), int(c)] = int(color)
        grid[int(r), W - 1 - int(c)] = int(color)


def _adjacent_colors(grid: np.ndarray, chunk: list[tuple[int, int]], bg_marker: int = -1) -> set[int]:
    H, W = grid.shape
    colors = set()
    full = set()
    for r, c in chunk:
        full.add((int(r), int(c)))
        full.add((int(r), int(W - 1 - int(c))))
    for r, c in full:
        for rr, cc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
            if 0 <= rr < H and 0 <= cc < W:
                val = int(grid[rr, cc])
                if val != bg_marker and (rr, cc) not in full:
                    colors.add(val)
    return colors


def _fill_interior(grid: np.ndarray, fill_pool: list[int]) -> None:
    half_cells = {(r, c) for r in range(1, _OUT_H - 1) for c in range(1, _OUT_W // 2 + 1)}
    previous_color = None

    while half_cells:
        target = random.randint(1, min(3, len(half_cells)))
        start = random.choice(sorted(half_cells))
        chunk = [start]
        half_cells.remove(start)
        frontier = [start]
        while len(chunk) < target and frontier:
            cr, cc = random.choice(frontier)
            nbrs = []
            for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
                if (nr, nc) in half_cells:
                    nbrs.append((nr, nc))
            if not nbrs:
                frontier.remove((cr, cc))
                continue
            nxt = random.choice(nbrs)
            half_cells.remove(nxt)
            chunk.append(nxt)
            frontier.append(nxt)

        avoid = _adjacent_colors(grid, chunk)
        if previous_color is not None:
            avoid.add(int(previous_color))
        opts = [col for col in fill_pool if col not in avoid]
        if not opts:
            opts = [col for col in fill_pool if col != previous_color] or fill_pool
        col = random.choice(opts)
        _paint_chunk(grid, chunk, int(col))
        previous_color = int(col)


def _build_body_output() -> tuple[np.ndarray, int] | tuple[None, None]:
    H, W = _OUT_H, _OUT_W
    n_body = random.randint(_BODY_COLORS_MIN, _BODY_COLORS_MAX)
    bg = random.choice([c for c in range(10) if c not in CONNECTOR_COLORS])
    pool = [c for c in range(10) if c not in CONNECTOR_COLORS and c != bg]
    random.shuffle(pool)
    if len(pool) < n_body:
        return None, None
    body_palette = pool[:n_body]
    frame_color = int(body_palette[0])
    fill_pool = [int(c) for c in body_palette[1:]]
    if not fill_pool:
        return None, None

    grid = np.full((H, W), -1, dtype=int)
    grid[0, :] = frame_color
    grid[H - 1, :] = frame_color
    grid[:, 0] = frame_color
    grid[:, W - 1] = frame_color
    _fill_interior(grid, fill_pool)
    if np.any(grid < 0):
        return None, None
    return grid.astype(int), int(bg)


def _build_structured_output() -> tuple[np.ndarray, int, np.ndarray, set[int]]:
    H, W = _OUT_H, _OUT_W
    bg = random.choice([c for c in range(10) if c not in CONNECTOR_COLORS])
    frame_color = random.choice([c for c in range(10) if c not in CONNECTOR_COLORS and c != bg])
    out = np.full((H, W), int(frame_color), dtype=int)
    pid_grid = np.zeros((H, W), dtype=int)

    # Border ring + two inner frame bars.
    bar_rows = {3, 6}
    for r in range(H):
        for c in range(W):
            if r in (0, H - 1) or c in (0, W - 1) or r in bar_rows:
                pid_grid[r, c] = 0
            else:
                out[r, c] = -1
                pid_grid[r, c] = -1

    chamber_starts = [1, 4, 7]
    palette = list(CONNECTOR_COLORS)
    random.shuffle(palette)
    next_pid = 1
    for i, r0 in enumerate(chamber_starts):
        top_col = int(palette[i % len(palette)])
        bot_col = int(palette[(i + 1) % len(palette)])

        out[r0 - 1, 1:4] = top_col
        out[r0 + 2, 1:4] = bot_col
        out[r0, 0] = top_col
        out[r0 + 1, 0] = bot_col
        out[r0, W - 1] = top_col
        out[r0 + 1, W - 1] = bot_col

        for c in range(1, 4):
            out[r0, c] = top_col
            out[r0 + 1, c] = bot_col
            pid_grid[r0, c] = int(next_pid)
            pid_grid[r0 + 1, c] = int(next_pid)
            next_pid += 1

    assert np.all(out >= 0)
    return out.astype(int), int(bg), pid_grid.astype(int), {0}


def _piece_partition(body_out: np.ndarray) -> tuple[list[dict], np.ndarray]:
    H, W = body_out.shape
    pid_grid = np.full((H, W), -1, dtype=int)
    pieces = []
    for col in sorted(set(map(int, np.unique(body_out)))):
        for pts in components_mask(body_out == int(col), connectivity=8):
            r0, c0, r1, c1 = bbox_coords(pts)
            coords = [(int(r), int(c)) for r, c in pts]
            pid = len(pieces)
            for r, c in coords:
                pid_grid[int(r), int(c)] = int(pid)
            pieces.append(
                {
                    "pid": int(pid),
                    "color": int(col),
                    "coords": coords,
                    "bbox": (int(r0), int(c0), int(r1), int(c1)),
                    "area": int(len(coords)),
                }
            )
    assert np.all(pid_grid >= 0)
    return pieces, pid_grid


def _find_frame_pids(pieces: list[dict], pid_grid: np.ndarray) -> list[int]:
    H, W = pid_grid.shape
    def group_ok(idxs: list[int]) -> bool:
        boxes = [pieces[i]["bbox"] for i in idxs]
        gr0 = min(int(b[0]) for b in boxes)
        gc0 = min(int(b[1]) for b in boxes)
        gr1 = max(int(b[2]) for b in boxes)
        gc1 = max(int(b[3]) for b in boxes)
        if int(gr1 - gr0 + 1) != H or int(gc1 - gc0 + 1) != W:
            return False
        coords = set()
        for i in idxs:
            for r, c in pieces[i]["coords"]:
                coords.add((int(r - gr0), int(c - gc0)))
        return _is_lr_symmetric_mask(coords, H, W)

    found: list[tuple[int, list[int]]] = []
    for i in range(len(pieces)):
        if group_ok([i]):
            found.append((int(pieces[i]["area"]), [int(i)]))
    for i in range(len(pieces)):
        for j in range(i + 1, len(pieces)):
            if group_ok([i, j]):
                area = int(pieces[i]["area"]) + int(pieces[j]["area"])
                found.append((area, [int(i), int(j)]))
    assert found, "generator expected at least one 1-2 piece frame group"
    best_area = min(area for area, _idxs in found)
    best = [idxs for area, idxs in found if area == best_area]
    assert len(best) == 1, "generator expected a unique minimum-area frame group"
    return best[0]


def _adjacency_map(pid_grid: np.ndarray) -> dict[tuple[int, int], list[tuple[tuple[int, int], tuple[int, int]]]]:
    H, W = pid_grid.shape
    adj: dict[tuple[int, int], list[tuple[tuple[int, int], tuple[int, int]]]] = defaultdict(list)
    for r in range(H):
        for c in range(W):
            p = int(pid_grid[r, c])
            if r + 1 < H and int(pid_grid[r + 1, c]) != p:
                q = int(pid_grid[r + 1, c])
                key = (min(p, q), max(p, q))
                a = (r, c) if p <= q else (r + 1, c)
                b = (r + 1, c) if p <= q else (r, c)
                adj[key].append((a, b))
            if c + 1 < W and int(pid_grid[r, c + 1]) != p:
                q = int(pid_grid[r, c + 1])
                key = (min(p, q), max(p, q))
                a = (r, c) if p <= q else (r, c + 1)
                b = (r, c + 1) if p <= q else (r, c)
                adj[key].append((a, b))
    return adj


def _mirror_coord(W: int, rc: tuple[int, int]) -> tuple[int, int]:
    r, c = rc
    return int(r), int(W - 1 - c)


def _apply_connectors(body_out: np.ndarray, pieces: list[dict], pid_grid: np.ndarray) -> tuple[np.ndarray | None, int]:
    H, W = body_out.shape
    out = np.array(body_out, copy=True)
    adj = _adjacency_map(pid_grid)
    used: set[tuple[int, int]] = set()
    visited: set[tuple[int, int]] = set()
    orbit_idx = 0

    for key in sorted(adj):
        if key in visited:
            continue
        pair = adj[key][0]
        mk = tuple(sorted((int(pid_grid[_mirror_coord(W, pair[0])]), int(pid_grid[_mirror_coord(W, pair[1])] ))))
        visited.add(key)
        visited.add(mk)

        candidates = []
        for a, b in adj[key]:
            leftness = min(int(a[1]), int(b[1]))
            candidates.append((leftness, int(a[0] + b[0]), a, b))
        candidates.sort()
        chosen = None
        for _leftness, _row_sum, a, b in candidates:
            if a not in used and b not in used:
                chosen = (a, b)
                break
        if chosen is None:
            chosen = (candidates[0][2], candidates[0][3])
        color = int(CONNECTOR_COLORS[orbit_idx % len(CONNECTOR_COLORS)])
        orbit_idx += 1

        coords_to_paint = [chosen[0], chosen[1]]
        ma = _mirror_coord(W, chosen[0])
        mb = _mirror_coord(W, chosen[1])
        coords_to_paint.extend([ma, mb])

        for r, c in coords_to_paint:
            out[int(r), int(c)] = color
            used.add((int(r), int(c)))

    # Every non-frame piece should have at least one connector; otherwise the connector
    # rule is visually weak and the sample is too close to the original task.
    frame_pids = set(_find_frame_pids(pieces, pid_grid))
    connector_counts = defaultdict(int)
    for piece in pieces:
        pid = int(piece["pid"])
        for r, c in piece["coords"]:
            if int(out[int(r), int(c)]) in CONNECTOR_COLORS:
                connector_counts[pid] += 1
    for piece in pieces:
        pid = int(piece["pid"])
        if pid in frame_pids:
            continue
        if connector_counts[pid] == 0:
            return None, 0
    return out.astype(int), int(len(adj))


def _build_patches(out: np.ndarray, pid_grid: np.ndarray, bg: int, frame_pids: set[int]) -> tuple[np.ndarray, list[np.ndarray]]:
    H, W = out.shape
    frame_mask = np.isin(pid_grid, sorted(frame_pids))
    frame_pts = np.argwhere(frame_mask)
    fr0, fc0, fr1, fc1 = bbox_coords(frame_pts)
    frame_patch = np.full((int(fr1 - fr0 + 1), int(fc1 - fc0 + 1)), int(bg), dtype=int)
    for r, c in frame_pts:
        frame_patch[int(r) - int(fr0), int(c) - int(fc0)] = int(out[int(r), int(c)])

    patches = []
    for pid in sorted(set(map(int, pid_grid.flatten()))):
        if pid in frame_pids:
            continue
        pts = np.argwhere(pid_grid == int(pid))
        r0, c0, r1, c1 = bbox_coords(pts)
        patch = np.full((int(r1 - r0 + 1), int(c1 - c0 + 1)), int(bg), dtype=int)
        for r, c in pts:
            patch[int(r) - int(r0), int(c) - int(c0)] = int(out[int(r), int(c)])
        patches.append(patch)
    random.shuffle(patches)
    patches.sort(key=lambda p: (-(p != bg).sum(), random.random()))
    return frame_patch, patches


def _scatter(out: np.ndarray, pid_grid: np.ndarray, bg: int, frame_pids: set[int]) -> np.ndarray:
    rows = random.randint(_CANVAS_MIN, _CANVAS_MAX)
    cols = random.randint(_CANVAS_MIN, _CANVAS_MAX)
    canvas = np.full((rows, cols), int(bg), dtype=int)
    oh, ow = out.shape

    max_r = rows - oh - 2
    max_c = cols - ow - 2
    if max_r < 1 or max_c < 1:
        raise ValueError("frame cannot fit on canvas")
    off_r = random.randint(1, max_r)
    off_c = random.randint(1, max_c)

    frame_patch, patches = _build_patches(out, pid_grid, bg, frame_pids)
    canvas[off_r : off_r + oh, off_c : off_c + ow] = -1
    for patch in patches:
        r, c = random_free_location(
            canvas,
            patch,
            transparent=bg,
            padding=_SCATTER_PADDING,
            padding_connectivity=8,
        )
        paste(canvas, patch, r, c, transparent=bg)
    canvas[off_r : off_r + oh, off_c : off_c + ow] = frame_patch
    return canvas.astype(int)


def _piece_count(body_out: np.ndarray) -> int:
    return sum(len(components_mask(body_out == int(col), connectivity=4)) for col in np.unique(body_out))


def _gen_attempt(return_meta: bool = False):
    out, bg, pid_grid, frame_pids = _build_structured_output()
    pieces = sorted(set(map(int, pid_grid.flatten())))
    pc = len([pid for pid in pieces if pid >= 0])
    if not (_PIECE_COUNT_MIN <= pc <= _PIECE_COUNT_MAX):
        return None
    if not np.array_equal(out, out[:, ::-1]):
        return None

    non_frame = [pid for pid in pieces if pid not in frame_pids and pid >= 0]
    if any(int((pid_grid == pid).sum()) > _MAX_PIECE_AREA for pid in non_frame):
        return None

    connector_cells = int(np.isin(out, CONNECTOR_COLORS).sum())
    pieces_with_connectors = len(non_frame)
    seam_count = len(non_frame) + 6

    try:
        inp = _scatter(out, pid_grid, bg, frame_pids)
        got = main(inp)
    except Exception:
        return None
    if not np.array_equal(got, out):
        return None

    if return_meta:
        return {
            "input": inp.astype(int),
            "output": out.astype(int),
            "connector_cells": connector_cells,
            "seam_count": int(seam_count),
            "piece_count": int(pc),
            "pieces_with_connectors": int(pieces_with_connectors),
        }
    return inp.astype(int)


def generate_input() -> np.ndarray:
    for _ in range(_GEN_MAX_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid connector-matching e8686506 input")

