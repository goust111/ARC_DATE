+        out.append(("cross", _shape_mask("cross", H, W)))
+    if H >= 5 and W >= 5:
+        for kind in ("L_bl", "L_br", "L_tl", "L_tr"):
+            out.append((kind, _shape_mask(kind, H, W)))
