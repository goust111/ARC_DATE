+            for ti in range(len(types)):
+                if counts[ti] <= 0:
+                    continue
+                places = placements_for(ti)
+                if not places:
+                    rollback_forced()
+                    fail_cache.add(key)
+                    return False
+                if len(places) == 1:
+                    counts[ti] -= 1
+                    changed = place(ti, places[0][0], places[0][1])
+                    forced.append((ti, changed))
+                    progress = True
+            if not progress:
+                break
+
+        if all(c == 0 for c in counts):
+            if np.any(board[shape_mask] == _EMPTY):
+                rollback_forced()
+                fail_cache.add(key)
+                return False
+            return True
+
+        choices = []
+        for ti in range(len(types)):
+            if counts[ti] <= 0:
+                continue
+            places = placements_for(ti)
+            if not places:
+                rollback_forced()
+                fail_cache.add(key)
+                return False
+            choices.append((len(places), -len(types[ti]["coords"]), ti, places))
+        choices.sort()
+        _, _, ti, places = choices[0]
+
+        for r0, c0 in places:
+            counts[ti] -= 1
+            changed = place(ti, r0, c0)
+            if search():
+                return True
+            unplace(changed)
+            counts[ti] += 1
+
+        rollback_forced()
+        fail_cache.add(key)
+        return False
+
+    assert search(), "assembly search failed"
+    return board
