+                rollback_forced()
+                fail_cache.add(key)
+                return False
+            return True
+
+        choices = []
+        for ti in range(len(types)):
+            if counts[ti] <= 0:
+                continue
+            places = placements_for(ti)
+            if not places:
+                rollback_forced()
+                fail_cache.add(key)
+                return False
+            choices.append((len(places), -len(types[ti]["coords"]), ti, places))
+        choices.sort()
+        _, _, ti, places = choices[0]
+
+        for r0, c0 in places:
+            counts[ti] -= 1
+            changed = place(ti, r0, c0)
+            if search():
+                return True
+            unplace(changed)
+            counts[ti] += 1
