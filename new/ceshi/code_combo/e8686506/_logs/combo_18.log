+def _assemble(
+    types: list[dict],
+    shape_mask: np.ndarray,
+    req: np.ndarray,
+    disallow_touch: set[int] | None = None,
+) -> np.ndarray:
+    H, W = shape_mask.shape
+    board = np.full((H, W), _OUTSIDE, dtype=int)
+    board[shape_mask] = _EMPTY
