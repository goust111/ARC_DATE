+                places = placements_for(ti)
+                if not places:
+                    rollback_forced()
+                    fail_cache.add(key)
+                    return False
+                if len(places) == 1:
+                    counts[ti] -= 1
+                    changed = place(ti, places[0][0], places[0][1])
