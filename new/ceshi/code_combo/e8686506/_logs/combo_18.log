+
+_OUTPUT_DIMS = [(7, 5), (7, 7), (9, 5), (9, 7)]
+_OUTPUT_KINDS = ["cross", "L_bl", "L_br", "L_tl", "L_tr"]
+_N_OUTPUT_COLORS_MIN = 4
+_N_OUTPUT_COLORS_MAX = 6
+_MAX_PIECE_AREA = 6
+_PIECE_COUNT_MIN = 9
+_PIECE_COUNT_MAX = 17
