+def _structured_cross_chunks(H: int, W: int) -> list[list[tuple[int, int]]]:
+    mr, mc = H // 2, W // 2
+    chunks: list[list[tuple[int, int]]] = []
+
+    for r in range(0, mr - 1):
+        chunks.append([(r, c) for c in range(mc - 1, mc + 2)])
+    for r in range(mr + 2, H):
+        chunks.append([(r, c) for c in range(mc - 1, mc + 2)])
+    for c in range(0, mc - 1):
+        chunks.append([(r, c) for r in range(mr - 1, mr + 2)])
+    for c in range(mc + 2, W):
+        chunks.append([(r, c) for r in range(mr - 1, mr + 2)])
+    for c in range(mc - 1, mc + 2):
+        chunks.append([(r, c) for r in range(mr - 1, mr + 2)])
