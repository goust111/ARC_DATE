+            return parent
+    raise RuntimeError("could not locate repo root containing solvers/arc_utils.py")
+
+
+_ROOT = _find_repo_root()
+_SOLVER_DIR = _ROOT / "solvers"
+if str(_SOLVER_DIR) not in sys.path:
