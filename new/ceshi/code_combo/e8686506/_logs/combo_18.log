+    assert _PIECE_COUNT_MIN <= len(chunks) <= _PIECE_COUNT_MAX
+    assert all(1 <= len(chunk) <= _MAX_PIECE_AREA for chunk in chunks)
+    return [sorted(chunk) for chunk in chunks]
