+            progress = False
+            for ti in range(len(types)):
+                if counts[ti] <= 0:
+                    continue
+                places = placements_for(ti)
+                if not places:
+                    rollback_forced()
+                    fail_cache.add(key)
+                    return False
+                if len(places) == 1:
+                    counts[ti] -= 1
+                    changed = place(ti, places[0][0], places[0][1])
+                    forced.append((ti, changed))
+                    progress = True
+            if not progress:
+                break
+
+        if all(c == 0 for c in counts):
