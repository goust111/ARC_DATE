+    if not (_PIECE_COUNT_MIN <= _piece_count(out, bg) <= _PIECE_COUNT_MAX):
+        return (None, None) if return_meta else None
+    if any(
+        len(pts) > _MAX_PIECE_AREA
+        for col in visible_colors
+        for pts in components_mask(out == col, connectivity=4)
+    ):
+        return (None, None) if return_meta else None
+
