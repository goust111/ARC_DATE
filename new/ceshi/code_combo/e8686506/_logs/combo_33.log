+            and pair_by_sig[sig][0] != pair_by_sig[_mirror_sig_ud(sig)][0]
+            and pair_by_sig[sig][1] != pair_by_sig[_mirror_sig_ud(sig)][1]
+        ),
+        "distinct_colors": len(np.unique(out)),
+    }
+    return pre, out, bg, pieces, meta
