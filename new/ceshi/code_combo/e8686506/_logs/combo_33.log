+    for i, p1 in enumerate(comps8):
+        r0, c0, r1, c1 = bbox_coords(p1)
+        if r1 - r0 + 1 == H and c1 - c0 + 1 == W and _is_ud_symmetric_bitmap([p1], H, W):
