+        "two_color_pieces": sum(1 for pts in comps if len({int(g[r, c]) for r, c in pts}) == 2),
+        "swap_families": swap_families,
+        "changed_cells": changed_cells,
+        "ud_symmetric_output": bool(np.array_equal(out, out[::-1, :])),
+    }
