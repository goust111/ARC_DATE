+    pair_by_sig = {sig: (int(border_by_sig[sig]), int(fill_by_sig[sig])) for sig in signatures}
+    swap_families = sum(
+        1
+        for sig, msig in asym_families
+        if pair_by_sig[sig][0] != pair_by_sig[msig][0] and pair_by_sig[sig][1] != pair_by_sig[msig][1]
