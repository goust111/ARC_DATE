+        "slot_groups": slot_groups,
+        "pair_by_sig": pair_by_sig,
+        "frame_mask": frame_mask,
+        "dims": (H, W),
+        "non_frame_piece_count": non_frame_piece_count,
+        "two_color_piece_count": two_color_piece_count,
+    }
+    return pre, meta
