+_VALID_DIMS = [(8, 5)]
+_H = 8
+_W = 5
+_CANVAS_MIN = 13
+_CANVAS_MAX = 15
+_SCATTER_PADDING = 1
+_GEN_MAX_RETRIES = 400
+_N_COLORS = 6
+_MIN_SWAP_FAMILIES = 2
+
+_TOP_SLOT_TEMPLATES = [
+    (
+        ((0, 0), (0, 1)),
+        ((0, 3), (0, 4)),
+        ((2, 0), (2, 1), (3, 0)),
+        ((2, 4), (3, 3), (3, 4)),
+    ),
+    (
+        ((0, 0), (0, 1)),
