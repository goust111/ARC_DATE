+def _slot_groups(slots: list[dict]) -> dict[tuple[int, int, tuple[tuple[int, int], ...]], list[list[tuple[int, int]]]]:
+    out: dict[tuple[int, int, tuple[tuple[int, int], ...]], list[list[tuple[int, int]]]] = {}
+    for slot in slots:
