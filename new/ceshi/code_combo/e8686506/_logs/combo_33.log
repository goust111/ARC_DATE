+    border_color, fill_color = map(int, pair)
+    fill_set = set(support["fill_rel"])
+    out: dict[tuple[int, int], int] = {}
+    r0 = int(support["r0"])
+    c0 = int(support["c0"])
+    for rr, cc in support["coords"]:
+        out[(r0 + rr, c0 + cc)] = fill_color if (rr, cc) in fill_set else border_color
