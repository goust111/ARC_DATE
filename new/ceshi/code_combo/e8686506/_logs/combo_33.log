+def _swap_board(pre: np.ndarray, slot_groups: dict, pair_by_sig: dict) -> np.ndarray:
+    out = pre.copy()
+    for sig, groups in slot_groups.items():
+        msig = _mirror_sig_ud(sig)
+        assert msig in pair_by_sig, "every slot signature must have a UD mirror partner"
+        target_pair = pair_by_sig[msig]
