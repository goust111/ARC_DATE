  asym=0
  seen=set()
  for s in sigs:
    m=msig(s)
    if s==m or s in seen or m in seen:
      continue
    seen.add(s); seen.add(m)
    asym += 1
  # need at least 2 top signatures that are not self-mirror and whose mirrors also appear among groups after reflection
  full_sigs=sigs | {msig(s) for s in sigs}
  fam=0; seen=set()
  for s in full_sigs:
    m=msig(s)
    if s==m or s in seen or m in seen or m not in full_sigs:
      continue
    fam += 1; seen.add(s); seen.add(m)
  if fam < 2:
    continue
  print('"'found', comb, 'fam', fam)
  for idx in comb:
    print(cands[idx], sig(cands[idx]), '->', msig(sig(cands[idx])))
  print(open_mask.astype(int))
  break
else:
  print('none')
