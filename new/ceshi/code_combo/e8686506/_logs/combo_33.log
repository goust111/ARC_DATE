+    piece["border_color"] = border_color
+    piece["fill_color"] = fill_color
+    piece["paint"] = tuple(
+        sorted(
+            (
+                rr,
+                cc,
+                fill_color if (rr, cc) in fill_set else border_color,
+            )
+            for rr, cc in rel_coords
+        )
+    )
+    return piece
