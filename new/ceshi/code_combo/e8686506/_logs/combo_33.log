+            return None, {}
+        if stats["changed_cells"] <= 0:
+            return None, {}
+        return inp, {**meta, **stats}
+    return None, {}
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(_GEN_MAX_RETRIES):
+        grid, _meta = _gen_attempt()
+        if grid is not None:
+            return grid
