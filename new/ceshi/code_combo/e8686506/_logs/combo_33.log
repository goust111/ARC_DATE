    print('iter',i,'frame_pair',frame_pair,'pair_by_sig is none?', pair_by_sig is None)
    if pair_by_sig is None:
        continue
    pre_abs=np.full((mod._H, mod._W), -1, dtype=int)
    frame_piece=next(piece for piece in pieces if piece['is_frame'])
    mod._paint_piece(pre_abs, frame_piece['cells'], frame_pair)
    for sig, groups in support_meta['slot_groups'].items():
        pair = pair_by_sig[sig]
        for cells in groups:
            mod._paint_piece(pre_abs, cells, pair)
    out_abs=mod._swap_board(pre_abs, support_meta['slot_pairs'], pair_by_sig)
    print('ud', np.array_equal(out_abs,out_abs[::-1,:]), 'lr', np.array_equal(out_abs,out_abs[:,::-1]), 'colors', np.unique(out_abs))
    print(out_abs)
    break
