+        ((0, 0), (0, 1)),
+        ((0, 3), (0, 4), (1, 3)),
+        ((2, 1), (3, 0), (3, 1)),
+        ((3, 3), (3, 4)),
+    ),
+    (
+        ((0, 0), (0, 1)),
+        ((0, 3), (0, 4), (1, 4)),
+        ((2, 0), (2, 1), (3, 0)),
+        ((3, 3), (3, 4)),
+    ),
+    (
+        ((0, 0), (0, 1)),
+        ((0, 3), (0, 4), (1, 4)),
+        ((2, 0), (3, 0)),
+        ((2, 2), (3, 2), (3, 3)),
