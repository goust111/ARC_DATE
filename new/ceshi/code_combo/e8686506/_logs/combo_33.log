+    adjacency: dict,
+    palette: list[int],
+    frame_pair: tuple[int, int],
+) -> dict | None:
+    signatures = sorted(slot_groups)
+    for sig in signatures:
+        msig = _mirror_sig_ud(sig)
+        if msig not in slot_groups:
+            return None
+        if len(slot_groups[sig]) != len(slot_groups[msig]):
