+    def choose_border():
+        cands = [sig for sig in signatures if sig not in border_by_sig]
+        if not cands:
+            return None
+        cands.sort(key=lambda sig: (len(border_domain(sig)), -len(adjacency.get(sig, set()))))
+        return cands[0]
