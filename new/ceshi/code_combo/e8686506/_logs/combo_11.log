+
+_OUTSIDE = -2
+_EMPTY = -1
+
+_OUTPUT_DIMS = [(7, 5), (7, 7), (9, 5), (9, 7), (11, 5)]
+_SHAPE_KINDS = ("cross", "tee")
+
+_N_COLORS_MIN = 4
+_N_COLORS_MAX = 6
+_MAX_PIECE_AREA = 4
+_PIECE_COUNT_MIN = 9
+_PIECE_COUNT_MAX = 17
+_CANVAS_MIN = 13
+_CANVAS_MAX = 15
+_SCATTER_PADDING = 1
+_GEN_MAX_RETRIES = 500
+_PARTITION_RETRIES = 140
+_COLOR_RETRIES = 120
