+    - The missing frame means the outline must be inferred indirectly: only a small family of
+      symmetric non-rectangular masks is possible, so the correct silhouette is the one for which
+      all scattered pieces can jointly satisfy both edge matching and color symmetry.
+    """
+    g = np.asarray(grid, dtype=int)
+    bg = get_bg(g)
