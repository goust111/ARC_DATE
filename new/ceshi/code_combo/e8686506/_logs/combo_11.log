+_ROOT = None
+for _parent in Path(__file__).resolve().parents:
+    if (_parent / "solvers").is_dir():
+        _ROOT = _parent
+        break
+if _ROOT is None:
+    raise RuntimeError("could not locate repository root containing solvers/")
+_SOLVER_DIR = _ROOT / "solvers"
+if str(_SOLVER_DIR) not in sys.path:
