+                fail_cache.add(key)
+                return False
+            return True
+
+        valid_places: dict[int, list[int]] = {}
+        for ti in range(len(types)):
+            if counts[ti] <= 0:
+                continue
+            places = placements_for(ti)
+            if not places:
+                rollback_forced()
+                fail_cache.add(key)
+                return False
+            valid_places[ti] = places
+
+        best_options = None
