+
+    meta = {
+        "kind": kind,
+        "dims": (H, W),
+        "piece_count": piece_count,
+        "max_piece_area": max(sizes),
+        "input_has_frame": False,
+    }
+    return out, bg, meta
+
+
+def _extract_patches(out: np.ndarray, bg: int) -> list[np.ndarray]:
+    patches = []
