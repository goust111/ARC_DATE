+    while i < len(rows):
+        remaining = len(rows) - i
+        size_choices = [s for s in (1, 2, 3) if s <= remaining]
+        if remaining == 4:
+            size = random.choice([2, 2, 1])
+        else:
+            size = random.choice(size_choices)
+        chunk_rows = rows[i : i + size]
+        chunks.append([(r, mid) for r in chunk_rows])
+        i += size
