+        col = int(t["col"])
+        changed = []
+        for r, c in static_cells[ti][pi]:
+            board[r, c] = col
+            changed.append((r, c))
+        return changed
+
+    def unplace(changed: list[tuple[int, int]]) -> None:
+        for r, c in changed:
+            board[r, c] = _EMPTY
