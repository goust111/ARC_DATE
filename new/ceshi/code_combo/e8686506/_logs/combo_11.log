+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Reassemble scattered small fragments into a cropped left-right symmetric non-rectangular picture.
+
+    Input structure:
+    - The background is the most frequent color.
+    - Every non-background component is a small translated fragment; unlike the original task, no
+      large grouped frame or border scaffold remains in place to reveal the target outline.
+
+    Rule:
+    - Collect all non-background fragments and compute their total occupied area.
+    - Enumerate the allowed LR-symmetric non-rectangular silhouettes whose area matches that total.
+    - Pack the fragments into one candidate silhouette so every occupied cell is filled exactly
+      once, the final coloring is left-right symmetric, and different components of the same color
+      never become 4-neighbor adjacent.
+
+    Key insight:
+    - The missing frame means the outline must be inferred indirectly: only a small family of
+      symmetric non-rectangular masks is possible, so the correct silhouette is the one for which
+      all scattered pieces can jointly satisfy both edge matching and color symmetry.
+    """
+    g = np.asarray(grid, dtype=int)
+    bg = get_bg(g)
