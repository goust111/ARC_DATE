+        return None, 0, None
+
+    group_colors = None
+    n_colors = None
+    for _ in range(_COLOR_RETRIES):
+        n_try = random.randint(_N_COLORS_MIN, max_colors)
+        colored = _color_groups(group_adj, n_try)
+        if colored is not None:
+            group_colors = colored
