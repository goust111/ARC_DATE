+            places = placements_for(ti)
+            if not places:
+                rollback_forced()
+                fail_cache.add(key)
+                return False
+            valid_places[ti] = places
+
+        best_options = None
+        for r in range(H):
+            for c in range(W):
+                if board[r, c] != _EMPTY:
+                    continue
+                options = []
+                for ti, places in valid_places.items():
+                    for pi in places:
