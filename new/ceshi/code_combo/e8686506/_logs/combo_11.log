+    fail_cache: set[tuple[bytes, tuple[int, ...]]] = set()
+
+    static_places: list[list[tuple[int, int]]] = []
+    for t in types:
+        t_places = []
+        for r0 in range(H - int(t["h"]) + 1):
+            for c0 in range(W - int(t["w"]) + 1):
+                ok = True
+                for dr, dc in t["coords"]:
+                    r, c = r0 + dr, c0 + dc
+                    if not shape_mask[r, c]:
+                        ok = False
+                        break
+                if ok:
+                    t_places.append((r0, c0))
+        static_places.append(t_places)
+
+    def mirror_ok(r: int, c: int, col: int) -> bool:
+        mc = W - 1 - c
+        if not shape_mask[r, mc]:
+            return False
+        v = board[r, mc]
+        return v in (_EMPTY, col)
+
+    def can_place(ti: int, r0: int, c0: int) -> bool:
+        t = types[ti]
+        col = int(t["col"])
+        piece_cells = {(r0 + dr, c0 + dc) for dr, dc in t["coords"]}
+        for r, c in piece_cells:
+            if board[r, c] != _EMPTY:
+                return False
+            if not mirror_ok(r, c, col):
+                return False
+        if col in disallow_touch:
+            for r, c in piece_cells:
+                for rr, cc in _neighbors4(r, c):
+                    if (rr, cc) in piece_cells:
+                        continue
+                    if 0 <= rr < H and 0 <= cc < W and board[rr, cc] == col:
+                        return False
+        return True
+
+    def placements_for(ti: int) -> list[tuple[int, int]]:
+        return [(r0, c0) for r0, c0 in static_places[ti] if can_place(ti, r0, c0)]
+
+    def place(ti: int, r0: int, c0: int) -> list[tuple[int, int]]:
+        t = types[ti]
+        col = int(t["col"])
+        changed = []
+        for dr, dc in t["coords"]:
+            r, c = r0 + dr, c0 + dc
+            board[r, c] = col
+            changed.append((r, c))
+        return changed
+
+    def unplace(changed: list[tuple[int, int]]) -> None:
+        for r, c in changed:
+            board[r, c] = _EMPTY
+
