+_N_COLORS_MIN = 4
+_N_COLORS_MAX = 6
+_MAX_PIECE_AREA = 4
+_PIECE_COUNT_MIN = 9
+_PIECE_COUNT_MAX = 17
+_CANVAS_MIN = 13
+_CANVAS_MAX = 15
