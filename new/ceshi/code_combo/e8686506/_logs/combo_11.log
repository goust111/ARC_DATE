+    def dfs(pos: int) -> bool:
+        if pos == len(order):
+            used = {int(c) for c in colors if c is not None}
+            return len(used) == n_colors
+        idx = order[pos]
+        forbidden = {colors[j] for j in group_adj[idx] if colors[j] is not None}
