+        H, W = int(cand["H"]), int(cand["W"])
+        target_area = H * W
+        dims = [(h, w) for (h, w) in _factors(target_area) if h >= w]
+        if not dims:
+            continue
+        best_gap = min(abs(h - w) for h, w in dims)
+        best_dims = [(h, w) for h, w in dims if abs(h - w) == best_gap]
+        if len(best_dims) != 1 or best_dims[0] != (H, W):
+            continue
