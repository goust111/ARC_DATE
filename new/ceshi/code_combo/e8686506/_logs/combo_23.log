+# --------------- generator ---------------
+
+# === CFG: Output dimensions ===
+_AREA_MIN = 25
+_AREA_MAX = 50
+_WIDTH_REQUIRED = 5
+_HEIGHT_MAX = 10
+
+# === CFG: Color and palette ===
+_N_COLORS_MIN = 4
+_N_COLORS_MAX = 6
+_TWO_FRAME_MIN_H = 6
+_TWO_FRAME_MIN_COLORS = 5
+_TWO_FRAME_PROB = 0.35
+_CENTER_CAP_PROB = 0.5
+
+# === CFG: Piece constraints ===
+_MAX_PIECE_AREA = 6
+_MAX_CHUNK_SIZE = 6
+_PIECE_COUNT_MIN = 9
+_PIECE_COUNT_MAX = 17
+
+# === CFG: Canvas / scatter ===
+_CANVAS_MIN = 13
+_CANVAS_MAX = 15
+_SCATTER_PADDING = 1
+_NOISE_MIN = 1
+_NOISE_MAX = 3
+_DISTRACTOR_MIN = 1
+_DISTRACTOR_MAX = 2
+
+# === CFG: Retry ===
+_GEN_MAX_RETRIES = 900
