+    moved_mask = g != int(bg)
+    out[moved_mask] = int(trail_color)
+
+    H, W = assembled.shape
+    tr, tc = _target_top_left(g.shape[0], g.shape[1], H, W)
+    out[tr : tr + H, tc : tc + W] = assembled
+    return out
