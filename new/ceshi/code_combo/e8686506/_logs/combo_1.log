+        got = main(inp)
+    except Exception:
+        return None
+    if np.array_equal(got, out):
+        return inp, out
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(_GEN_MAX_RETRIES):
+        result = _gen_attempt()
+        if result is not None:
+            return result[0]
