+            r0, c0, r1, c1 = bbox_coords(arr)
+            h = int(r1 - r0 + 1)
+            w = int(c1 - c0 + 1)
+            assert h == 1, "every fused-variant piece must occupy exactly one input row"
+            assert len(arr) == w, "every fused-variant piece must be a filled horizontal fragment"
+            raw_pieces.append(
+                {
+                    "col": int(col),
+                    "row_pos": int(r0),
+                    "mid_c": (int(c0) + int(c1)) / 2.0,
+                    "w": int(w),
