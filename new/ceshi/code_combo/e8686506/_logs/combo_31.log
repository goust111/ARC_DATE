+def _extract_input_pieces(grid: np.ndarray) -> tuple[int, list[dict], dict[int, int]]:
+    g = np.asarray(grid, dtype=int)
+    bg = get_bg(g)
+    raw_pieces: list[dict] = []
+    color_piece_count: dict[int, int] = {}
