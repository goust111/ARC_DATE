+def _factors(n: int) -> list[tuple[int, int]]:
+    out = []
+    for w in range(1, n + 1):
+        if n % w == 0:
+            out.append((n // w, w))
+    return out
+
+
+def _extract_input_pieces(grid: np.ndarray) -> tuple[int, list[dict]]:
