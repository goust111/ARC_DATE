+
+_INPUT_BAND_CUTS = (5, 11)
+_CANVAS_ROWS = 15
+_CANVAS_COLS = 15
+_GEN_MAX_RETRIES = 300
+
+_ROW_ANCHOR_OPTIONS = (
+    (1, 4, 7, 10, 13),
+    (0, 3, 6, 9, 12),
+)
