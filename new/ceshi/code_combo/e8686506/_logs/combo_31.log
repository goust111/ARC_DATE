+    (1, 0): [(0, 1), (4, 1)],
+    (1, 1): [(1, 3)],
+    (2, 0): [(0, 1), (4, 1)],
+    (2, 1): [(1, 1), (3, 1)],
+    (2, 2): [(2, 1)],
+    (3, 0): [(0, 1), (4, 1)],
+    (3, 1): [(1, 3)],
+    (4, 0): [(0, 5)],
