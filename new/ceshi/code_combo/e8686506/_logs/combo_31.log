+    {"row": 1, "layer": 0, "c0": 0, "w": 1},
+    {"row": 1, "layer": 0, "c0": 4, "w": 1},
+    {"row": 1, "layer": 1, "c0": 1, "w": 3},
+    {"row": 2, "layer": 0, "c0": 0, "w": 1},
+    {"row": 2, "layer": 0, "c0": 4, "w": 1},
+    {"row": 2, "layer": 1, "c0": 1, "w": 1},
+    {"row": 2, "layer": 2, "c0": 2, "w": 1},
