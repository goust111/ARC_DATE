   225	        for idx, row in enumerate(rows):
   226	            if (used_mask >> idx) & 1:
   227	                continue
   228	            for cand in row["candidates"]:
   229	                if int(cand["top"]) != current:
   230	                    continue
   231	                tail = dfs(step + 1, int(cand["bottom"]), used_mask | (1 << idx))
   232	                if tail is not None:
   233	                    return [{"row_index": idx, "body_color": int(row["body_color"]), "cand": cand}] + tail
   234	
   235	        memo.add(key)
