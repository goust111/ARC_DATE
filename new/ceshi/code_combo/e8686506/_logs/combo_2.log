    92	_OUTPUT_N_COLORS_MIN = 4
    93	_OUTPUT_N_COLORS_MAX = 6
    94	_CANVAS_MIN = 16
    95	_CANVAS_MAX = 18
    96	_SCATTER_PADDING = 1
    97	_MIN_ROT90_VISIBLE = 1
    98	_GEN_MAX_RETRIES = 500
    99	
   100	_LAST_GEN_INFO: dict | None = None
   101	
   102	
   103	def _is_border_ring(mask: np.ndarray) -> bool:
   104	    h, w = mask.shape
   105	    if h < 3 or w < 3:
   106	        return False
   107	    expected = np.zeros((h, w), dtype=bool)
   108	    expected[0, :] = True
   109	    expected[h - 1, :] = True
