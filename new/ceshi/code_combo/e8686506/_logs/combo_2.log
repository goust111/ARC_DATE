   166	            continue
   167	        other = [(int(r), int(c)) for r, c in np.argwhere((rp != bg) & (rp != body_color))]
   168	        if sorted(other) != [(0, 1), (2, 1)]:
   169	            continue
   170	        top = int(rp[0, 1])
   171	        bottom = int(rp[2, 1])
   172	        assert top != body_color and bottom != body_color, "hint colors must differ from the body color"
   173	        key = (top, bottom)
   174	        if key in seen:
   175	            continue
   176	        seen.add(key)
   177	        candidates.append({"top": top, "bottom": bottom, "rot_k": int(k)})
   178	
   179	    assert len(candidates) == 2, "each row piece must have exactly two horizontal candidate orientations"
   180	    return candidates
