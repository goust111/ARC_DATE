   210	def _solve_chain(frame: dict, rows: list[dict]) -> list[dict]:
   211	    target_len = int(frame["H"]) - 2
   212	    full_mask = (1 << len(rows)) - 1
   213	    memo: set[tuple[int, int, int]] = set()
   214	
   215	    def dfs(step: int, current: int, used_mask: int) -> list[dict] | None:
