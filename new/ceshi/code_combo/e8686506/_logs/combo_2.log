+    if W != _WIDTH or H not in _HEIGHTS:
+        return None
+    body_mask = patch == body_color
+    if not _is_border_ring(body_mask):
+        return None
+    hint_cells = [(int(r), int(c)) for r, c in np.argwhere((patch != bg) & (patch != body_color))]
+    if len(hint_cells) != 2:
+        return None
