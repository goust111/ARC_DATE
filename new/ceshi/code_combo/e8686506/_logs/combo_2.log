+    canvas[off_r : off_r + H, off_c : off_c + W] = bg
+    paste(canvas, frame_patch, off_r, off_c, transparent=bg)
+
+    meta = {
+        "rot90_visible_count": int(rot90_visible_count),
+        "quarter_turn_piece_count": int(quarter_turn_piece_count),
