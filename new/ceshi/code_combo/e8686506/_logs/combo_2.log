   189	    rows = []
   190	    for pts in comps:
   191	        info = _component_info(g, pts, bg)
   192	        maybe_frame = _frame_info(info, bg)
   193	        if maybe_frame is not None:
   194	            assert frame is None, "frame must be unique"
   195	            frame = maybe_frame
   196	            continue
   197	        assert int(info["body_count"]) == 3, "row-piece body must have area 3"
   198	        rows.append(
   199	            {
   200	                "body_color": int(info["body_color"]),
   201	                "candidates": _row_candidates(info, bg),
   202	            }
   203	        )
   204	
