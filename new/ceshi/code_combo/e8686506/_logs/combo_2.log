    counts = [int(t["cnt"]) for t in types]
    fail_cache: set[tuple[tuple[int, ...], bytes]] = set()

    def candidate_cells(ti: int, variant: dict, r0: int, c0: int) -> list[tuple[int, int]] | None:
        t = types[ti]
