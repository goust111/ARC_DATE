    ```python
    import numpy as np

from arc_utils import bbox_coords, components_mask, get_bg, paste, random_free_location
import random


def _piece_sig(pts: np.ndarray) -> tuple[int, int, tuple[tuple[int, int], ...]]:
    r0, c0, r1, c1 = bbox_coords(pts)
    coords = tuple(sorted((int(r) - r0, int(c) - c0) for r, c in pts))
    return (r1 - r0 + 1), (c1 - c0 + 1), coords


def _factors(n: int) -> list[tuple[int, int]]:
    out = []
    for w in range(1, n + 1):
        if n % w == 0:
            h = n // w
            out.append((h, w))
    return out


def _build_requirements(
    H: int,
    W: int,
    comps_by_color: dict[int, list[list[tuple[int, int]]]],
) -> np.ndarray:
    """
    Build per-cell required color constraints (req[r,c] == -1 means unconstrained).

    Heuristics supported by training examples:
      - If there is a color with exactly 4 singleton components, those are the four corners.
      - If there are full horizontal bars of length W-2 in the input, use them as the top/bottom edges
        between the corners (ordered by their vertical position in the input).
      - If there is a color with exactly two full vertical line components (width=1) in the input,
        place them on the left/right edges centered vertically.
    """
    req = np.full((H, W), -1, dtype=int)

    # 4 singleton components -> corners
    corner_colors = [
        col
        for col, comps in comps_by_color.items()
        if len(comps) == 4 and all(len(p) == 1 for p in comps)
    ]
    assert len(corner_colors) <= 1, "corner singleton color must be unique when present"
    corner_color = corner_colors[0] if corner_colors else None
    if corner_color is not None:
        req[0, 0] = corner_color
        req[0, W - 1] = corner_color
        req[H - 1, 0] = corner_color
        req[H - 1, W - 1] = corner_color

    # Horizontal bar(s) of length W-2 (filled, height 1)
    bar_colors: list[tuple[int, int]] = []  # (min_input_row, color)
    if W >= 3 and corner_color is not None:
        for col, comps in comps_by_color.items():
            for pts in comps:
                r0, c0, r1, c1 = bbox_coords(pts)
                hh, ww = r1 - r0 + 1, c1 - c0 + 1
                if hh == 1 and ww == (W - 2) and len(pts) == ww:
                    bar_colors.append((r0, col))
                    break
        if bar_colors:
            assert len(bar_colors) <= 2, "horizontal edge bar colors must be top/bottom only"
            bar_colors.sort()
            top_col = bar_colors[0][1]
            bot_col = bar_colors[-1][1]
            req[0, 1 : W - 1] = top_col
            req[H - 1, 1 : W - 1] = bot_col

    # Two full vertical line components -> left/right edges, centered vertically
    vertical_line_candidates = []
    for col, comps in comps_by_color.items():
        if len(comps) != 2:
            continue
        sigs = [_piece_sig(pts) for pts in comps]
        (h0, w0, coords0), (h1, w1, coords1) = sigs[0], sigs[1]
        if w0 == 1 and w1 == 1 and h0 == h1 and coords0 == coords1 and h0 > 1:
            vertical_line_candidates.append((col, h0))
    assert len(vertical_line_candidates) <= 1, "paired vertical edge-line color must be unique when present"
    if vertical_line_candidates:
        col, L = vertical_line_candidates[0]
        top = (H - L) // 2
        assert 0 <= top and top + L <= H, "paired vertical edge lines must fit in the output height"
        req[top : top + L, 0] = col
        req[top : top + L, W - 1] = col

    return req


def _assemble(
    types: list[dict],
    H: int,
    W: int,
    req: np.ndarray,
    disallow_touch: set[int] | None = None,
) -> np.ndarray:
    board = np.full((H, W), -1, dtype=int)
    counts = [int(t["cnt"]) for t in types]

    def mirror_ok(r: int, c: int, col: int) -> bool:
        mc = W - 1 - c
        v = board[r, mc]
        return (v == -1) or (v == col)

    def can_place(ti: int, r0: int, c0: int) -> bool:
        t = types[ti]
        col = int(t["col"])
        is_singleton = len(t["coords"]) == 1
        for dr, dc in t["coords"]:
            r, c = r0 + dr, c0 + dc
            if board[r, c] != -1:
                return False
            if req[r, c] != -1 and int(req[r, c]) != col:
                return False
            if not mirror_ok(r, c, col):
                return False
            if is_singleton and not (r == 0 or r == H - 1 or c == 0 or c == W - 1):
                return False
            if disallow_touch and col in disallow_touch:
                for rr, cc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
                    if 0 <= rr < H and 0 <= cc < W and board[rr, cc] == col:
                        return False
        return True

    def place(ti: int, r0: int, c0: int) -> list[tuple[int, int]]:
        t = types[ti]
        col = int(t["col"])
        changed = []
        for dr, dc in t["coords"]:
            r, c = r0 + dr, c0 + dc
            board[r, c] = col
            changed.append((r, c))
        return changed

    def unplace(changed: list[tuple[int, int]]) -> None:
        for r, c in changed:
            board[r, c] = -1

    def placements_for(ti: int) -> list[tuple[int, int]]:
        t = types[ti]
        return [(r0, c0)
                for r0 in range(H - int(t["h"]) + 1)
                for c0 in range(W - int(t["w"]) + 1)
                if can_place(ti, r0, c0)]

    # Pure constraint propagation: each step, every type must be forced (1 position)
    # or batch-forced (positions == cnt). No backtracking. Asserts if stuck.
    changed = True
    while changed:
        changed = False
        for ti in range(len(types)):
            if counts[ti] <= 0:
                continue
            places = placements_for(ti)
            assert len(places) > 0, "assembly dead end: a piece has no valid placement"
            if len(places) == 1:
                counts[ti] -= 1
                place(ti, places[0][0], places[0][1])
                changed = True
            elif len(places) == counts[ti]:
                for r0, c0 in places:
                    counts[ti] -= 1
                    place(ti, r0, c0)
                changed = True
    assert all(c == 0 for c in counts), "assembly not purely propagation-solvable"
    assert np.array_equal(board, board[:, ::-1]), "assembled board must be LR-symmetric"
    return board


def main(grid: np.ndarray) -> np.ndarray:
    """
    Assemble scattered colored fragments into a left-right symmetric rectangle, jigsaw-style.

    Input structure:
    - bg = most common color; remaining colors form small sprite fragments.
    - Optional roles: 4 singleton pixels of one color mark corners; horizontal bars mark top/bottom edges; paired vertical lines mark left/right edges.

    Rule:
    - Collect all non-bg connected components as jigsaw pieces.
    - Determine output rectangle dimensions from total piece area.
    - Pack pieces into the rectangle so it is exactly mirror-symmetric (left-right) and same-color pieces never 4-touch.

    Key insight: Left-right symmetry plus the no-same-color-touching constraint make the assembly unique; corner/edge markers anchor it when present.
    """
    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)

    # Extract pieces (connected components per color)
    comps_by_color: dict[int, list[list[tuple[int, int]]]] = {}
    pieces = []
    color_piece_count: dict[int, int] = {}

    for col in sorted(set(map(int, np.unique(g)))):
        if col == bg:
            continue
        comps = components_mask(g == col, connectivity=4)
        comps_by_color[col] = comps
        color_piece_count[col] = len(comps)
        for pts in comps:
            _, _, coords = _piece_sig(pts)
            pieces.append((col, coords))

    # Group identical pieces into types
    from collections import Counter

    ctr = Counter(pieces)
    types = []
    for (col, coords), cnt in sorted(ctr.items(), key=lambda kv: (-len(kv[0][1]), kv[0][0], kv[0][1])):
        arr = np.array(coords, dtype=int)
        h = int(arr[:, 0].max() + 1)
        w = int(arr[:, 1].max() + 1)
        types.append({"col": int(col), "coords": coords, "h": h, "w": w, "cnt": int(cnt)})

    total_area = sum(int(t["cnt"]) * len(t["coords"]) for t in types)
    assert total_area > 0, "total_area must be positive: grid must contain non-background pieces"

    # Disallow 4-neigh touching between different pieces of same color (preserve component counts)
    # Eval inputs use the unique closest-to-square portrait factor pair as the output shape.
    dims = [(h, w) for (h, w) in _factors(total_area) if h >= w]
    assert dims, "at least one portrait factor pair must exist for the total piece area"
    best_gap = min(abs(h - w) for h, w in dims)
    best_dims = [(h, w) for h, w in dims if abs(h - w) == best_gap]
    assert len(best_dims) == 1, "closest-to-square portrait output shape must be unique"
    H, W = best_dims[0]

    # Frame constraint: under 8-connectivity, 1-2 pieces must exist whose union bbox
    # equals the output rectangle (H x W). Their relative positions are fixed in output.
    comps8_all = []
    for col in sorted(set(map(int, np.unique(g))) - {bg}):
        for pts in components_mask(g == col, connectivity=8):
            comps8_all.append((int(col), pts))
    def _is_lr_symmetric(parts, h, w):
        """Check if the union of frame parts forms an LR-symmetric bitmap."""
        all_pts = np.concatenate([p for _, p in parts])
        r0, c0 = int(all_pts[:, 0].min()), int(all_pts[:, 1].min())
        bmp = np.zeros((h, w), dtype=bool)
        for _, pts in parts:
            for r, c in pts:
                bmp[int(r) - r0, int(c) - c0] = True
        return np.array_equal(bmp, bmp[:, ::-1])

    frame_parts: list[tuple[int, np.ndarray]] = []
    for i, (c1, p1) in enumerate(comps8_all):
        r0, c0, r1, c1b = bbox_coords(p1)
        if r1 - r0 + 1 == H and c1b - c0 + 1 == W:
            if _is_lr_symmetric([(c1, p1)], H, W):
                frame_parts = [(c1, p1)]
                break
        for j in range(i + 1, len(comps8_all)):
            c2, p2 = comps8_all[j]
            union = np.concatenate([p1, p2])
            ur0, uc0, ur1, uc1 = bbox_coords(union)
            if ur1 - ur0 + 1 == H and uc1 - uc0 + 1 == W:
                if _is_lr_symmetric([(c1, p1), (c2, p2)], H, W):
                    frame_parts = [(c1, p1), (c2, p2)]
                    break
        if frame_parts:
            break
    assert frame_parts, "input must contain 1-2 LR-symmetric pieces (8-conn) whose union bbox equals output dims"

    req = _build_requirements(H, W, comps_by_color)

    # Lock frame cells into req: their output positions are determined by input-relative positions.
    all_frame_pts = np.concatenate([p for _, p in frame_parts])
    fr0, fc0 = int(all_frame_pts[:, 0].min()), int(all_frame_pts[:, 1].min())
    for col, pts in frame_parts:
        for r, c in pts:
            or_, oc = int(r) - fr0, int(c) - fc0
            if 0 <= or_ < H and 0 <= oc < W:
                req[or_, oc] = col

    disallow_touch = {col for col, n in color_piece_count.items() if n > 1}
    sol = _assemble(types, H, W, req, disallow_touch)
    return sol.astype(int)

# --------------- generator (o5x) ---------------

# === CFG: Output dimensions ===
_AREA_MIN = 25               # minimum total piece area
_AREA_MAX = 50               # maximum total piece area (exclusive upper in range)
_WIDTH_REQUIRED = 5           # all valid outputs have width 5
_HEIGHT_MAX = 10              # maximum output height

# === CFG: Color and palette ===
_N_COLORS_MIN = 4             # min distinct colors in abstract output
_N_COLORS_MAX = 6             # max distinct colors in abstract output
_TWO_FRAME_MIN_H = 6          # min height to allow 2-color frame
_TWO_FRAME_MIN_COLORS = 5     # min palette size to allow 2-color frame
_TWO_FRAME_PROB = 0.35         # probability of splitting frame into 2 colors
_CENTER_CAP_PROB = 0.5         # probability of capping center col at top/bottom

# === CFG: Piece constraints ===
_MAX_PIECE_AREA = 6           # maximum area of any single 4-conn piece
_MAX_CHUNK_SIZE = 6           # max cells per hole chunk when splitting large holes
_PIECE_COUNT_MIN = 9          # min total 4-conn components in output
_PIECE_COUNT_MAX = 17         # max total 4-conn components in output

# === CFG: Canvas / scatter ===
_CANVAS_MIN = 13              # min canvas dimension (rows and cols)
_CANVAS_MAX = 15              # max canvas dimension (rows and cols)
_SCATTER_PADDING = 1          # Chebyshev padding between scattered pieces

# === CFG: Retry ===
_GEN_MAX_RETRIES = 300        # max attempts in generate_input()


def _valid_dims():
    """Precompute valid (H, W) pairs: unique closest-to-square portrait factorization with W=5."""
    results = []
    for area in range(_AREA_MIN, _AREA_MAX + 1):
        dims = [(area // w, w) for w in range(1, area + 1) if area % w == 0 and area // w >= w]
        best_gap = min(abs(h - w) for h, w in dims)
        best = [(h, w) for h, w in dims if abs(h - w) == best_gap]
        if len(best) == 1:
            h, w = best[0]
            if w == _WIDTH_REQUIRED and h <= _HEIGHT_MAX:
                results.append((h, w))
    return results


_VALID_DIMS = _valid_dims()
_DIM_WEIGHTS = [h * w for h, w in _VALID_DIMS]


def _zigzag_frame(H):
    """Generate frame bitmap (Hx2 left-half) via zigzag path from top to bottom.
    Returns (cells, start_c, end_c) where start_c/end_c are the column at top/bottom."""
    cells = set()
    start_c = random.randint(0, 1)
    c = start_c
    for r in range(H):
        cells.add((r, c))
        if r == H - 1:
            break
        move = random.choice(['down', 'horiz', 'diag'])
        if move == 'down':
            pass
        elif move == 'horiz':
            cells.add((r, 1 - c))
            c = 1 - c
        else:
            c = 1 - c
    return cells, start_c, c


def _fill_holes(grid, H, W, half, frame1, frame2, split, fill_pool):
    """Fill non-frame cells by assigning colors to 4-conn hole regions.
    Large holes are split into chunks of <= _MAX_CHUNK_SIZE cells."""
    holes = components_mask(grid == -1, connectivity=4)
    prev_col = None
    for hole in holes:
        cells = sorted((int(r), int(c)) for r, c in hole)
        # Split into chunks of bounded size
        chunks = [cells[i:i + _MAX_CHUNK_SIZE] for i in range(0, len(cells), _MAX_CHUNK_SIZE)]
        for chunk in chunks:
            # Determine which frame colors are adjacent to this chunk
            fc_set = {frame1 if r < split else frame2 for r, _ in chunk}
            # Pick a fill color avoiding frame and previous neighbor
            avoid = fc_set | ({prev_col} if prev_col else set())
            opts = [f for f in fill_pool if f not in avoid]
            if not opts:
                opts = [f for f in fill_pool if f not in fc_set] or fill_pool
            col = random.choice(opts)
            for r, c in chunk:
                grid[r, c] = col
                grid[r, W - 1 - c] = col
            prev_col = col


def _build_output(H, W):
    """Build an abstract LR-symmetric output grid with zigzag frame and filled holes.
    Returns (grid, frame_colors_set) or (None, set()) on failure."""
    half = W // 2
    n_colors = random.randint(_N_COLORS_MIN, _N_COLORS_MAX)
    palette = list(range(n_colors))
    random.shuffle(palette)

    use_two_frames = (H >= _TWO_FRAME_MIN_H and n_colors >= _TWO_FRAME_MIN_COLORS
                      and random.random() < _TWO_FRAME_PROB)
    ci = 0
    frame1 = palette[ci]; ci += 1
    frame2 = frame1
    if use_two_frames:
        frame2 = palette[ci]; ci += 1
    fill_pool = palette[ci:]
    if not fill_pool:
        return None, set()

    frame_half, start_c, end_c = _zigzag_frame(H)
    split = H // 2 if frame1 != frame2 else H

    grid = np.full((H, W), -1, dtype=int)

    # Paint frame cells (mirror left half to right)
    for r, c in frame_half:
        fc = frame1 if r < split else frame2
        grid[r, c] = fc
        grid[r, W - 1 - c] = fc

    # Cap center column at top/bottom when zigzag endpoint is adjacent
    if start_c == 1 and random.random() < _CENTER_CAP_PROB:
        grid[0, half] = frame1
    if end_c == 1 and random.random() < _CENTER_CAP_PROB:
        grid[H - 1, half] = frame2

    _fill_holes(grid, H, W, half, frame1, frame2, split, fill_pool)

    if np.any(grid < 0):
        return None, set()
    frame_set = {frame1}
    if frame2 != frame1:
        frame_set.add(frame2)
    return grid, frame_set


def _make_output() -> tuple[np.ndarray | None, int, set[int]]:
    """Select dims, build abstract output, then remap to real ARC colors."""
    H, W = random.choices(_VALID_DIMS, weights=_DIM_WEIGHTS, k=1)[0]
    out, abstract_fcs = _build_output(H, W)
    if out is None:
        return None, 0, set()
    bg = random.randint(0, 9)
    abstract = sorted(np.unique(out))
    available = [c for c in range(10) if c != bg]
    random.shuffle(available)
    if len(available) < len(abstract):
        return None, 0, set()
    cmap = {int(a): available[i] for i, a in enumerate(abstract)}
    real_fcs = {cmap[a] for a in abstract_fcs}
    return np.vectorize(lambda x: cmap[int(x)])(out), bg, real_fcs


def _extract_non_frame_patches(out, bg, fcs):
    """Extract non-frame piece patches from the output grid, sorted largest-first."""
    patches = []
    for col in sorted(map(int, np.unique(out))):
        if col in fcs:
            continue
        for pts in components_mask(out == col, connectivity=4):
            r0, c0, r1, c1 = bbox_coords(pts)
            patch = np.full((r1 - r0 + 1, c1 - c0 + 1), bg, dtype=int)
            for r, c in pts:
                patch[int(r) - r0, int(c) - c0] = col
            patches.append(patch)
    random.shuffle(patches)
    patches.sort(key=lambda p: (-(p != bg).sum(), random.random()))
    return patches


def _scatter(out: np.ndarray, bg: int, fcs: set[int]) -> np.ndarray:
    """Place pieces onto a canvas: frame as a group, non-frame scattered with padding."""
    rows = random.randint(_CANVAS_MIN, _CANVAS_MAX)
    cols = random.randint(_CANVAS_MIN, _CANVAS_MAX)
    canvas = np.full((rows, cols), bg, dtype=int)
    oh, ow = out.shape

    max_r = rows - oh - 2
    max_c = cols - ow - 2
    if max_r < 1 or max_c < 1:
        raise ValueError
    off_r = random.randint(1, max_r)
    off_c = random.randint(1, max_c)

    # Block the entire frame bbox so fill pieces stay outside the outline
    canvas[off_r:off_r + oh, off_c:off_c + ow] = -1

    # Scatter non-frame pieces into the area OUTSIDE the blocked bbox
    for patch in _extract_non_frame_patches(out, bg, fcs):
        r, c = random_free_location(canvas, patch, transparent=bg,
                                    padding=_SCATTER_PADDING, padding_connectivity=8)
        paste(canvas, patch, r, c, transparent=bg)

    # Replace blocked bbox with frame cells (non-frame positions revert to bg)
    frame_mask = np.zeros((oh, ow), dtype=bool)
    for col in fcs:
        frame_mask |= (out == col)
    bbox_region = canvas[off_r:off_r + oh, off_c:off_c + ow]
    bbox_region[:] = bg
    bbox_region[frame_mask] = out[frame_mask]
    return canvas


def _piece_count(out: np.ndarray) -> int:
    return sum(len(components_mask(out == col, connectivity=4)) for col in np.unique(out))


def _gen_attempt() -> np.ndarray | None:
    """Single generation attempt: build output, validate constraints, scatter, oracle check."""
    out, bg, fcs = _make_output()
    if out is None:
        return None
    if not np.array_equal(out, out[:, ::-1]):
        return None
    if not (_N_COLORS_MIN <= len(np.unique(out)) <= _N_COLORS_MAX):
        return None
    pc = _piece_count(out)
    if not (_PIECE_COUNT_MIN <= pc <= _PIECE_COUNT_MAX):
        return None
    if any(len(pts) > _MAX_PIECE_AREA for col in np.unique(out)
           for pts in components_mask(out == col, connectivity=4)):
        return None
    try:
        inp = _scatter(out, bg, fcs)
        got = main(inp)
    except Exception:
        return None
    if np.array_equal(got, out):
        return inp
    return None


def generate_input() -> np.ndarray:
    for _ in range(_GEN_MAX_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid e8686506 input")

    ```

    ## 原始任务规格（Spec）

    以下是从原始 solver 代码和示例中提炼的完整任务规格，包含精确的数值约束和生成策略。
    Spec 本身就是原题代码生成时的参考文件，因此：
    - 在**设计分析**阶段，参考 spec 理解原始任务的完整设计细节（对象结构、空间关系、生成策略等），以此为基础思考融合变体的改动如何落实
    - 在**实现**阶段，参考 spec 中的数值约束（网格尺寸、对象数量/尺寸、颜色数等），确保融合变体在物理上可实现

    ```yaml
    spec:
  task: assemble scattered jigsaw pieces into a LR-symmetric dense rectangle
  input_grid: 13-15 rows x 13-15 cols, single bg color fills most cells
  output_grid: H x W dense rectangle, H >= W (portrait), dims = closest-to-square factor pair of total piece area
  output_dims_observed: 5x5 (area=25) or 8x5 (area=40)
  output_symmetry: exact left-right mirror; UD symmetry NOT required
  pieces:
    connectivity: each piece is a single-color 8-connected component (NOT 4-connected)
    total_count: 9-17
    distinct_colors: 4-6
    area_per_piece: 1-6
    total_area: 25-40 [observed]; must have unique closest-to-square portrait factor pair
    shapes: rectangles, L/C/zigzag fragments; no rotation applied
    mirror_pairing: asymmetric pieces come in LR-mirror pairs (same color); self-symmetric pieces may appear alone or in matched counts
  frame_constraint: |
    REQUIRED: 1-2 pieces (8-connected) whose union bounding box = output rectangle dims (H x W)
    and whose union bitmap is LR-symmetric. These "frame" pieces outline the assembled
    rectangle via a zigzag contour. In the input, frame pieces are placed as a group
    preserving their relative positions from the output, so the rectangular outline is
    visually recognizable. Non-frame pieces are scattered freely.
  uniqueness: REQUIRED — the assembly must be solvable by pure constraint propagation
    (each step, every remaining piece has exactly one valid placement, or a batch
    where positions = copies). No backtracking needed. Frame locks most cells;
    irregular hole shapes force remaining pieces into unique positions.
  singletons_on_border: 1x1 pieces only appear on the output rectangle border [observed 100%]
  optional_anchors:
    corner_markers: 0-1 colors with exactly 4 singleton pixels -> placed at 4 output corners [observed in 2/3]
    h_bar_edges: 0-2 horizontal bars of width W-2 -> top/bottom edges between corners, ordered by input row [observed in 2/3]
    v_line_pairs: 0-1 colors with 2 identical vertical lines -> left/right edges centered vertically [observed in 2/3]
  input_scatter: pieces placed on bg grid with min Chebyshev distance 1 between any two pieces; no overlaps

generation_strategy:
  approach: output-first
  steps:
    1. Choose output dims H x W (H >= W, W odd so center column exists, area has unique closest-to-square portrait factorization).
    2. Generate frame via zigzag path on the Hx2 left-half grid (top-to-bottom,
       3 moves: down/horiz+down/diag). Mirror to right half. Optionally cap
       top/bottom center col if endpoint is at col 1. Optionally split frame
       into 2 colors (top/bottom halves) for visual variety.
    3. Frame divides the rectangle into hole regions (4-conn components of
       non-frame cells). Fill each hole with one color (split if >6 cells).
       This produces irregular pieces whose shapes match the hole contours.
    4. Mirror left half to right half for LR symmetry.
    5. Extract each 4-conn component as a piece. Validate: 9-17 pieces,
       area 1-6 each, 4-6 distinct colors, 1x1 pieces on border only.
    6. Scatter pieces onto 13-15 x 13-15 input grid. Frame pieces placed as
       a group at output-relative positions (bbox blocked to keep interior clean).
       Non-frame pieces scattered in remaining space.
    7. Validate: solver recovers output via pure constraint propagation.
    ```

额外要求：原始代码的 `main()` 已包含四段式说明注释/文档字符串（开头概述 + `Input structure:` + `Rule:` + `Key insight:`）。
生成的新代码里也必须在 `main()` 上方保留这一结构，并根据**融合后的新规则**与**原注释提供的信息**重新编写；可以借鉴原注释的组织方式，但**不要照抄原文**，要让内容准确反映融合后的输入结构、规则和关键洞察。


## 已有单变体参考代码

以下组成项已有单变体实现，可作为融合时的参考：

            ### 参考代码: D1/0

            文件: `/home/lixinyu/snap/new/ceshi/code/e8686506/D1/0/code.py`

            ```python
            # Variant of e8686506
# Dimension: D1 — 匹配条件：边缘对齐拼合 vs 其他匹配逻辑 (match_cond)
# Change: s.edge.position aligns with d.adjacent_piece.edge — 碎片的边缘位置与... → 颜色匹配决定相邻关系

"""
Design analysis for the D1 variant
==================================

variant_spec:
  core_change:
    from: 原题主要依赖碎片形状与洞轮廓的几何贴合来唯一确定相邻关系
    to: 碎片主体几何形状故意重复，真正决定上下相邻顺序的是边缘提示色

  a_concretization_and_trace:
    objects:
      - 输出仍是竖向矩形，保持严格左右镜像。
      - 输入中保留一个已经摆成输出外框位置的矩形边框碎片。
      - 内部碎片不再是不规则洞块，而是若干个相同主体形状的横条：
        主体恒为 1x3 纯色条；其上边中心和下边中心各外挂一个 1 像素提示色。
      - 外框碎片在其内侧顶部/底部中心也各有一个提示色像素，作为链的起点和终点。
    behavior_trace:
      original_local_step: |
        原题在某个内部块上，solver 会枚举它能塞进哪些洞；洞形状和边框锁定使唯一位置出现。
      variant_local_step: |
        现在所有内部块的主体都同形（1x3），几何上都能放进任意一行；
        solver 改为读取“上提示色/下提示色”，从外框顶部锚点开始沿颜色链逐行串下去。
      difference: |
        旧逻辑的关键信息来自“这个形状能卡进哪里”；新逻辑的关键信息来自
        “哪个碎片的上提示色等于当前需要的连接色”。

  b_complexity_calibration:
    - 若仍使用不规则洞形，颜色提示会沦为装饰，因此这里主动把内部主体统一成重复的 1x3 横条。
    - 为避免过度简化成纯颜色列表，仍保留可见的外框碎片和矩形装配场景。
    - 连接色使用一条长度为 interior_rows+1 的唯一链；每个样例里有 7-9 个连接关系，重复支撑“按颜色接龙”这条规则。

  c_implicit_assumption_audit:
    main_old_assumptions:
      - 非背景同色连通块就是一个 piece。
      - piece 只有单色，因此颜色本身就是 piece 身份。
      - placement validity 由目标矩形内的空位、镜像约束、边框锁定和同色不接触给出。
    why_broken_now:
      - 变体 piece 是“单色主体 + 异色提示像素”的多色连通块，不能再按同色提取 piece。
      - 内部横条几何完全重复，若继续按原先的 can_place/propagation，会得到大量等价位置。
      - “同色不 4 邻接”不再是核心，因为提示色像素只存在输入、输出中会被剥离。
    new_assumptions_and_guards:
      - 每个输入 component 都有唯一多数色，且该多数色就是主体色。generator 通过让主体面积 >=3、提示像素每色仅 1 个来保证。
      - 只有一个主体为矩形边框的 component。generator 固定只生成一个外框。
      - 每个内部条形 piece 的主体都恰为 1x3，提示像素位于主体上下中心。generator 固定用该模板生成。
      - 顶部锚点颜色唯一对应第一条，底部锚点颜色唯一对应最后一条。generator 生成一条无分叉链。

  d_placement_legality:
    - generator 先构造最终输出，再把外框放入输入画布的一个矩形 bbox。
    - 整个 bbox 会先被临时阻塞，内部横条只能散落在 bbox 外，避免和外框/其空腔重叠。
    - 横条 patch 都是 3x3，使用 random_free_location 且带 padding，保证互不重叠。
    - 输出时会剥离提示像素，只保留主体，因此 solver 的重建结果与设计输出一致。

  e_visual_observability:
    - 人类可直接看到：很多内部碎片主体完全同形，单靠“塞形状”无法决定顺序；
      同时每条横条上下都有一个小色点，外框内侧也有起止色点，颜色链很显眼。
    - 不使用任何基于颜色 id 的排序；solver 仅做“当前需要的色 -> 找上提示色相同的那条”。

  f_visual_cleanliness:
    - 提示像素只占主体上下中心单点，不覆盖主体大面积区域，输入易读。
    - 输出中提示像素全部消失，只留下整洁的边框 + 水平色带。
    - 外框固定、内部条形散落在外框外，不会在同一区域多层叠加。

  g_color_inference:
    - 输出颜色数控制在 4-6，和原题接近；提示色可多，但它们总以“小连接点”角色重复出现。
    - 连接逻辑是“相同提示色接到一起”，而不是隐藏映射或按颜色编号计算，因此 2-3 组样例足以归纳。
"""

from __future__ import annotations

from collections import Counter
import random

import numpy as np

from arc_utils import bbox_coords, components_mask, get_bg, paste, random_free_location


_WIDTH = 5
_HEIGHTS = (9, 10)
_OUTPUT_N_COLORS_MIN = 4
_OUTPUT_N_COLORS_MAX = 6
_CANVAS_MIN = 15
_CANVAS_MAX = 17
_SCATTER_PADDING = 1
_GEN_MAX_RETRIES = 200


def _normalize(pts: np.ndarray) -> tuple[int, int, tuple[tuple[int, int], ...]]:
    r0, c0, r1, c1 = bbox_coords(pts)
    coords = tuple(sorted((int(r) - r0, int(c) - c0) for r, c in pts))
    return int(r1 - r0 + 1), int(c1 - c0 + 1), coords


def _is_border_ring(coords: tuple[tuple[int, int], ...], h: int, w: int) -> bool:
    if h < 3 or w < 3:
        return False
    expected = {
        (r, c)
        for r in range(h)
        for c in range(w)
        if r in (0, h - 1) or c in (0, w - 1)
    }
    return set(coords) == expected


def _component_info(grid: np.ndarray, pts: np.ndarray) -> dict:
    pts_list = [(int(r), int(c)) for r, c in pts]
    vals = [int(grid[r, c]) for r, c in pts_list]
    counts = Counter(vals)
    body_color, body_count = counts.most_common(1)[0]
    assert body_count >= 3, "each component must have a visible majority body color"

    body_pts = np.array([(r, c) for r, c in pts_list if int(grid[r, c]) == int(body_color)], dtype=int)
    h, w, body_coords = _normalize(body_pts)
    br0, bc0, _, _ = bbox_coords(body_pts)

    hints = []
    for r, c in pts_list:
        col = int(grid[r, c])
        if col == int(body_color):
            continue
        hints.append({"r": int(r - br0), "c": int(c - bc0), "col": col})

    return {
        "body_color": int(body_color),
        "body_h": int(h),
        "body_w": int(w),
        "body_coords": body_coords,
        "hints": hints,
    }


def _parse_input(grid: np.ndarray) -> tuple[dict, list[dict]]:
    g = np.asarray(grid, dtype=int)
    bg = int(get_bg(g))
    comps = components_mask(g != bg, connectivity=4)
    infos = [_component_info(g, pts) for pts in comps]

    frame = None
    rows = []
    for info in infos:
        if _is_border_ring(info["body_coords"], info["body_h"], info["body_w"]):
            assert frame is None, "frame must be unique"
            frame = info
            continue

        assert info["body_h"] == 1 and info["body_w"] == 3, "internal pieces must be 1x3 body strips"
        assert set(info["body_coords"]) == {(0, 0), (0, 1), (0, 2)}
        hints = sorted(info["hints"], key=lambda x: (x["r"], x["c"]))
        assert len(hints) == 2, "each strip must expose exactly two hint pixels"
        assert (hints[0]["r"], hints[0]["c"]) == (-1, 1), "top hint must sit above strip center"
        assert (hints[1]["r"], hints[1]["c"]) == (1, 1), "bottom hint must sit below strip center"
        rows.append(
            {
                "body_color": int(info["body_color"]),
                "top": int(hints[0]["col"]),
                "bottom": int(hints[1]["col"]),
            }
        )

    assert frame is not None, "missing frame component"
    fh, fw = int(frame["body_h"]), int(frame["body_w"])
    assert fw == _WIDTH and fh in _HEIGHTS, "frame dimensions must define the output"
    frame_hints = sorted(frame["hints"], key=lambda x: (x["r"], x["c"]))
    assert len(frame_hints) == 2, "frame must expose top/bottom anchors"
    assert (frame_hints[0]["r"], frame_hints[0]["c"]) == (1, fw // 2)
    assert (frame_hints[1]["r"], frame_hints[1]["c"]) == (fh - 2, fw // 2)
    frame["top_anchor"] = int(frame_hints[0]["col"])
    frame["bottom_anchor"] = int(frame_hints[1]["col"])
    return frame, rows


def main(grid: np.ndarray) -> np.ndarray:
    """
    Reassemble scattered strip-fragments into a left-right symmetric rectangle by matching hint colors.

    Input structure:
    - bg is the dominant color.
    - One multicolor component already sketches the output border: its majority color is the frame body, and two minority pixels inside the frame mark the top/bottom chain anchors.
    - The remaining components are repeated 1x3 body strips; each has one colored hint pixel above its center and one below its center.

    Rule:
    - Treat each non-bg connected component as one piece; within a piece, the majority color is the body and minority pixels are edge hints.
    - The frame body gives the output size. Every 1x3 strip fills one interior row of that frame.
    - Start from the frame's top anchor color, repeatedly choose the strip whose upper hint matches the current color, place it on the next interior row, then continue with that strip's lower hint color.

    Key insight: The internal strips are geometrically interchangeable, so shape alone does not order them; the only reliable assembly signal is the color chain running from the frame's top hint to its bottom hint.
    """
    frame, rows = _parse_input(grid)
    H, W = int(frame["body_h"]), int(frame["body_w"])
    assert len(rows) == H - 2, "the number of strips must match the frame interior height"

    by_top = {}
    for row in rows:
        assert row["top"] not in by_top, "each incoming hint color must identify a unique strip"
        by_top[row["top"]] = row

    out = np.full((H, W), int(get_bg(np.asarray(grid, dtype=int))), dtype=int)
    frame_color = int(frame["body_color"])
    out[0, :] = frame_color
    out[H - 1, :] = frame_color
    out[:, 0] = frame_color
    out[:, W - 1] = frame_color

    current = int(frame["top_anchor"])
    used_tops = set()
    for r in range(1, H - 1):
        assert current in by_top, "broken color chain: no strip matches the current hint"
        row = by_top[current]
        assert row["top"] not in used_tops, "color chain revisited an already placed strip"
        out[r, 1 : W - 1] = int(row["body_color"])
        used_tops.add(int(row["top"]))
        current = int(row["bottom"])

    assert current == int(frame["bottom_anchor"]), "color chain must terminate at the frame bottom anchor"
    assert len(used_tops) == len(rows), "every strip must be used exactly once"
    assert np.array_equal(out, out[:, ::-1]), "output must remain left-right symmetric"
    return out.astype(int)


def _choose_body_colors(palette: list[int], n_rows: int, top_links: list[int], bottom_links: list[int]) -> tuple[int, list[int]]:
    k = random.randint(_OUTPUT_N_COLORS_MIN, _OUTPUT_N_COLORS_MAX)
    body_pool = random.sample(palette, k=k)
    frame_candidates = [c for c in body_pool if c not in {top_links[0], bottom_links[-1]}]
    if not frame_candidates:
        frame_candidates = [c for c in palette if c not in {top_links[0], bottom_links[-1]}]
    frame_color = random.choice(frame_candidates)

    row_colors = []
    prev = None
    for i in range(n_rows):
        forbid = {top_links[i], bottom_links[i]}
        if i == 0:
            forbid.add(frame_color)
        if i == n_rows - 1:
            forbid.add(frame_color)
        if prev is not None:
            forbid.add(prev)
        opts = [c for c in body_pool if c not in forbid]
        if not opts:
            opts = [c for c in palette if c not in forbid]
        row_col = random.choice(opts)
        row_colors.append(int(row_col))
        prev = int(row_col)

    used_colors = len(set([frame_color, *row_colors]))
    if used_colors < _OUTPUT_N_COLORS_MIN:
        unique_targets = [c for c in body_pool if c != frame_color]
        idxs = list(range(n_rows))
        random.shuffle(idxs)
        for idx in idxs:
            forbid = {top_links[idx], bottom_links[idx]}
            if idx == 0 or idx == n_rows - 1:
                forbid.add(frame_color)
            if idx > 0:
                forbid.add(row_colors[idx - 1])
            if idx + 1 < n_rows:
                forbid.add(row_colors[idx + 1])
            candidates = [c for c in unique_targets if c not in forbid and c != row_colors[idx]]
            if candidates:
                row_colors[idx] = random.choice(candidates)
                used_colors = len(set([frame_color, *row_colors]))
                if used_colors >= _OUTPUT_N_COLORS_MIN:
                    break

    assert _OUTPUT_N_COLORS_MIN <= len(set([frame_color, *row_colors])) <= _OUTPUT_N_COLORS_MAX
    return int(frame_color), row_colors


def _build_output_and_patches() -> tuple[np.ndarray, int, np.ndarray, list[np.ndarray]]:
    H = random.choice(_HEIGHTS)
    W = _WIDTH
    n_rows = H - 2

    bg = random.randint(0, 9)
    palette = [c for c in range(10) if c != bg]
    random.shuffle(palette)

    link_colors = palette[: n_rows + 1]
    top_links = link_colors[:-1]
    bottom_links = link_colors[1:]
    frame_color, row_colors = _choose_body_colors(palette, n_rows, top_links, bottom_links)

    out = np.full((H, W), bg, dtype=int)
    out[0, :] = frame_color
    out[H - 1, :] = frame_color
    out[:, 0] = frame_color
    out[:, W - 1] = frame_color
    for r in range(1, H - 1):
        out[r, 1 : W - 1] = row_colors[r - 1]

    frame_patch = np.full((H, W), bg, dtype=int)
    frame_patch[0, :] = frame_color
    frame_patch[H - 1, :] = frame_color
    frame_patch[:, 0] = frame_color
    frame_patch[:, W - 1] = frame_color
    frame_patch[1, W // 2] = top_links[0]
    frame_patch[H - 2, W // 2] = bottom_links[-1]

    row_patches = []
    for row_col, top_col, bot_col in zip(row_colors, top_links, bottom_links):
        patch = np.full((3, 3), bg, dtype=int)
        patch[1, :] = row_col
        patch[0, 1] = top_col
        patch[2, 1] = bot_col
        row_patches.append(patch)

    return out, bg, frame_patch, row_patches


def _scatter(frame_patch: np.ndarray, row_patches: list[np.ndarray], bg: int) -> np.ndarray:
    H, W = frame_patch.shape
    rows = random.randint(_CANVAS_MIN, _CANVAS_MAX)
    cols = random.randint(_CANVAS_MIN, _CANVAS_MAX)
    canvas = np.full((rows, cols), bg, dtype=int)

    max_r = rows - H - 2
    max_c = cols - W - 2
    if max_r < 1 or max_c < 1:
        raise ValueError("canvas too small for frame")
    off_r = random.randint(1, max_r)
    off_c = random.randint(1, max_c)

    canvas[off_r : off_r + H, off_c : off_c + W] = -1
    for patch in row_patches:
        r0, c0 = random_free_location(
            canvas,
            patch,
            transparent=bg,
            padding=_SCATTER_PADDING,
            padding_connectivity=8,
        )
        paste(canvas, patch, r0, c0, transparent=bg)

    canvas[off_r : off_r + H, off_c : off_c + W] = bg
    paste(canvas, frame_patch, off_r, off_c, transparent=bg)
    return canvas


def _gen_attempt() -> tuple[np.ndarray, np.ndarray] | None:
    out, bg, frame_patch, row_patches = _build_output_and_patches()
    try:
        inp = _scatter(frame_patch, row_patches, bg)
    except Exception:
        return None
    got = main(inp)
    if np.array_equal(got, out):
        return inp, out
    return None


def generate_input() -> np.ndarray:
    for _ in range(_GEN_MAX_RETRIES):
        result = _gen_attempt()
        if result is not None:
            return result[0]
    raise RuntimeError("failed to generate a valid D1 variant input for e8686506")

            ```

            ### 参考代码: D12/0

            文件: `/home/lixinyu/snap/new/ceshi/code/e8686506/D12/0/code.py`

            ```python
            # Variant of e8686506
# Dimension: D12 — 碎片的旋转/翻转约束 (meta)
# Change: 碎片不可旋转不可翻转，保持原始朝向直接拼合... → 允许90度旋转

import random
from collections import Counter

import numpy as np

from arc_utils import bbox_coords, components_mask, get_bg, paste, random_free_location


# Design analysis for D12 (rotation-only variant)
# spec_variant:
#   core_change:
#     original assembly treated every scattered piece as having a fixed observed orientation.
#     this variant keeps the same output target (a dense LR-symmetric rectangle) but allows each
#     scattered non-frame piece to be quarter-turned independently before assembly.
#   concrete_behavior:
#     frame cells still appear in-place as a recognizable LR-symmetric outline inside the input;
#     they are the stable anchor. The freely scattered fill pieces are now sometimes rotated by
#     90/180/270 degrees, so the solver must infer both destination and orientation.
#   behavior_trace:
#     original:
#       an L triomino seen as [(0,0),(1,0),(1,1)] could only be placed with that exact pose.
#     variant:
#       the same observed triomino may represent any of four rotations; if the output needs
#       [(0,0),(0,1),(1,0)], the solver must try a 90-degree turn before placement.
#     difference:
#       the old type signature and placement loop silently assumed coords were final; that is no
#       longer harmless once the input pose is decoupled from the output pose.
#   complexity_calibration:
#     only rotations are added, not reflections. That keeps the control set small (4 poses) and
#     visually learnable from a few examples while still making asymmetric pieces visibly move.
#   implicit_assumptions_audited:
#     - grouping by exact coords is invalid now, so types are grouped by rotation-canonical shape.
#     - input-orientation anchor heuristics (horizontal bars / vertical lines) are unsafe now,
#       because a rotated piece no longer reveals which output side it belongs to.
#     - frame locking remains valid because the generator keeps the frame group unrotated and in
#       output-relative position; only the scattered non-frame patches are rotated.
#   generator_guarantees:
#     - frame cells are pasted as one in-place outline and never overlap scattered pieces.
#     - scattered patches are placed with padding, no overlap, and at least one quarter-turn-visible
#       asymmetric patch is actually rotated by 90 or 270 degrees.
#     - non-frame pieces are extracted from the intended output first, then rotated in input, and
#       the new solver is used as an oracle before accepting the sample.
#   visual_observability:
#     the variant is not encoded by color ids. It is visible because some input fragments have
#     different bounding boxes / silhouettes from their output counterparts, while the frame stays
#     fixed and shows where those fragments must eventually fit.
#   cleanliness:
#     rotation is limited to scattered fill pieces, avoiding stacked cues inside the frame region.
#     this keeps the outline readable and the changed rule local to the fragments the user handles.


_LAST_GEN_INFO: dict | None = None


def _piece_sig(pts: np.ndarray) -> tuple[int, int, tuple[tuple[int, int], ...]]:
    r0, c0, r1, c1 = bbox_coords(pts)
    coords = tuple(sorted((int(r) - r0, int(c) - c0) for r, c in pts))
    return (r1 - r0 + 1), (c1 - c0 + 1), coords


def _factors(n: int) -> list[tuple[int, int]]:
    out = []
    for w in range(1, n + 1):
        if n % w == 0:
            out.append((n // w, w))
    return out


def _coords_to_bitmap(coords: tuple[tuple[int, int], ...]) -> np.ndarray:
    arr = np.array(coords, dtype=int)
    h = int(arr[:, 0].max() + 1)
    w = int(arr[:, 1].max() + 1)
    bmp = np.zeros((h, w), dtype=bool)
    for r, c in coords:
        bmp[int(r), int(c)] = True
    return bmp


def _bitmap_to_coords(mask: np.ndarray) -> tuple[tuple[int, int], ...]:
    return tuple(sorted((int(r), int(c)) for r, c in np.argwhere(mask)))


def _unique_rotations(coords: tuple[tuple[int, int], ...]) -> list[dict]:
    bmp = _coords_to_bitmap(coords)
    out = []
    seen = set()
    for k in range(4):
        rb = np.rot90(bmp, k)
        rc = _bitmap_to_coords(rb)
        if rc in seen:
            continue
        seen.add(rc)
        out.append(
            {
                "k": int(k),
                "coords": rc,
                "h": int(rb.shape[0]),
                "w": int(rb.shape[1]),
            }
        )
    return out


def _canonical_rot_key(coords: tuple[tuple[int, int], ...]) -> tuple[int, int, tuple[tuple[int, int], ...]]:
    rots = _unique_rotations(coords)
    return min((int(v["h"]), int(v["w"]), v["coords"]) for v in rots)


def _build_requirements(H: int, W: int) -> np.ndarray:
    """
    Build per-cell required color constraints (req[r,c] == -1 means unconstrained).

    In the rotation variant we intentionally avoid input-pose-dependent anchor inference:
    a scattered bar or line no longer tells us whether it belongs horizontally or vertically
    in the output. The only hard requirements come from the locked frame cells.
    """
    return np.full((H, W), -1, dtype=int)


def _find_frame_parts(g: np.ndarray, bg: int, H: int, W: int) -> list[tuple[int, np.ndarray]]:
    comps8_all = []
    for col in sorted(set(map(int, np.unique(g))) - {bg}):
        for pts in components_mask(g == col, connectivity=8):
            comps8_all.append((int(col), pts))

    def is_lr_symmetric(parts: list[tuple[int, np.ndarray]]) -> bool:
        all_pts = np.concatenate([p for _, p in parts])
        r0, c0 = int(all_pts[:, 0].min()), int(all_pts[:, 1].min())
        bmp = np.zeros((H, W), dtype=bool)
        for _, pts in parts:
            for r, c in pts:
                bmp[int(r) - r0, int(c) - c0] = True
        return np.array_equal(bmp, bmp[:, ::-1])

    frame_parts: list[tuple[int, np.ndarray]] = []
    for i, (c1, p1) in enumerate(comps8_all):
        r0, c0, r1, c1b = bbox_coords(p1)
        if r1 - r0 + 1 == H and c1b - c0 + 1 == W and is_lr_symmetric([(c1, p1)]):
            frame_parts = [(c1, p1)]
            break
        for j in range(i + 1, len(comps8_all)):
            c2, p2 = comps8_all[j]
            union = np.concatenate([p1, p2])
            ur0, uc0, ur1, uc1 = bbox_coords(union)
            if ur1 - ur0 + 1 == H and uc1 - uc0 + 1 == W and is_lr_symmetric([(c1, p1), (c2, p2)]):
                frame_parts = [(c1, p1), (c2, p2)]
                break
        if frame_parts:
            break
    assert frame_parts, "input must contain 1-2 LR-symmetric frame groups whose union bbox equals output dims"
    return frame_parts


def _assemble(
    types: list[dict],
    H: int,
    W: int,
    req: np.ndarray,
    prefilled: np.ndarray,
    disallow_touch: set[int] | None = None,
) -> np.ndarray:
    board = prefilled.copy()
    counts = [int(t["cnt"]) for t in types]
    fail_cache: set[tuple[tuple[int, ...], bytes]] = set()

    def candidate_cells(ti: int, variant: dict, r0: int, c0: int) -> list[tuple[int, int]] | None:
        t = types[ti]
        col = int(t["col"])
        coords = variant["coords"]
        is_singleton = len(coords) == 1
        cells = [(r0 + dr, c0 + dc) for dr, dc in coords]
        cellset = set(cells)

        for r, c in cells:
            if board[r, c] != -1:
                return None
            if req[r, c] != -1 and int(req[r, c]) != col:
                return None
            mc = W - 1 - c
            if req[r, mc] != -1 and int(req[r, mc]) != col:
                return None
            v = board[r, mc]
            if v != -1 and int(v) != col:
                return None
            if is_singleton and not (r == 0 or r == H - 1 or c == 0 or c == W - 1):
                return None

        if disallow_touch and col in disallow_touch:
            for r, c in cells:
                for rr, cc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
                    if 0 <= rr < H and 0 <= cc < W and board[rr, cc] == col and (rr, cc) not in cellset:
                        return None
        return cells

    def placements_for(ti: int) -> list[tuple[dict, int, int, list[tuple[int, int]]]]:
        t = types[ti]
        out = []
        for variant in t["rots"]:
            for r0 in range(H - int(variant["h"]) + 1):
                for c0 in range(W - int(variant["w"]) + 1):
                    cells = candidate_cells(ti, variant, r0, c0)
                    if cells is not None:
                        out.append((variant, r0, c0, cells))
        out.sort(key=lambda x: (x[1], x[2], x[0]["h"], x[0]["w"], x[0]["coords"]))
        return out

    def place(col: int, cells: list[tuple[int, int]]) -> list[tuple[int, int]]:
        changed = []
        for r, c in cells:
            board[r, c] = col
            changed.append((r, c))
        return changed

    def unplace(changed: list[tuple[int, int]]) -> None:
        for r, c in changed:
            board[r, c] = -1

    def search() -> bool:
        forced: list[tuple[int, list[tuple[int, int]]]] = []
        while True:
            progress = False
            for ti in range(len(types)):
                if counts[ti] <= 0:
                    continue
                cands = placements_for(ti)
                if len(cands) < counts[ti]:
                    for col, changed in reversed(forced):
                        unplace(changed)
                    return False
                if counts[ti] == 1 and len(cands) == 1:
                    counts[ti] -= 1
                    changed = place(int(types[ti]["col"]), cands[0][3])
                    forced.append((ti, changed))
                    progress = True
                    break
            if not progress:
                break

        key = (tuple(counts), board.tobytes())
        if key in fail_cache:
            for ti, changed in reversed(forced):
                unplace(changed)
                counts[ti] += 1
            return False

        if all(c == 0 for c in counts):
            ok = (not np.any(board == -1)) and np.array_equal(board, board[:, ::-1])
            if not ok:
                fail_cache.add(key)
                for ti, changed in reversed(forced):
                    unplace(changed)
                    counts[ti] += 1
            return ok

        best_ti = -1
        best_cands = None
        best_score = None
        for ti in range(len(types)):
            if counts[ti] <= 0:
                continue
            cands = placements_for(ti)
            if len(cands) < counts[ti]:
                fail_cache.add(key)
                for fti, changed in reversed(forced):
                    unplace(changed)
                    counts[fti] += 1
                return False
            score = (len(cands), -int(types[ti]["area"]), counts[ti], int(types[ti]["col"]))
            if best_score is None or score < best_score:
                best_score = score
                best_ti = ti
                best_cands = cands
        assert best_ti >= 0 and best_cands is not None

        col = int(types[best_ti]["col"])
        counts[best_ti] -= 1
        for _variant, _r0, _c0, cells in best_cands:
            changed = place(col, cells)
            if search():
                return True
            unplace(changed)
        counts[best_ti] += 1

        fail_cache.add(key)
        for ti, changed in reversed(forced):
            unplace(changed)
            counts[ti] += 1
        return False

    assert search(), "assembly failed under rotation-aware search"
    assert np.array_equal(board, board[:, ::-1]), "assembled board must be LR-symmetric"
    return board


def main(grid: np.ndarray) -> np.ndarray:
    """
    Reassemble scattered color fragments into a left-right symmetric rectangle, allowing quarter turns.

    Input structure:
    - The background is the dominant color; all other cells form small monochrome fragments.
    - One in-place LR-symmetric frame group already shows the output rectangle's outline.
    - The remaining fragments are scattered elsewhere, and some of them may be rotated by 0/90/180/270 degrees.

    Rule:
    - Use the total non-background area to infer the dense output rectangle dimensions.
    - Lock the frame group into its output-relative cells.
    - Place every other fragment into the rectangle, trying all quarter-turn rotations, so the final board is exactly LR-symmetric and same-color fragments do not 4-touch across piece boundaries.

    Key insight:
    - The frame fixes the rectangle and many boundary cells; after that, mirror symmetry plus no-same-color-touching prunes the search enough that each scattered fragment's location and rotation become determined together.
    """
    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)

    total_area = int((g != bg).sum())
    assert total_area > 0, "total_area must be positive: grid must contain non-background pieces"

    dims = [(h, w) for (h, w) in _factors(total_area) if h >= w]
    assert dims, "at least one portrait factor pair must exist for the total piece area"
    best_gap = min(abs(h - w) for h, w in dims)
    best_dims = [(h, w) for h, w in dims if abs(h - w) == best_gap]
    assert len(best_dims) == 1, "closest-to-square portrait output shape must be unique"
    H, W = best_dims[0]

    frame_parts = _find_frame_parts(g, bg, H, W)
    req = _build_requirements(H, W)
    board0 = np.full((H, W), -1, dtype=int)

    all_frame_pts = np.concatenate([p for _, p in frame_parts])
    fr0, fc0 = int(all_frame_pts[:, 0].min()), int(all_frame_pts[:, 1].min())
    frame_input_cells = {(int(r), int(c)) for r, c in all_frame_pts}
    for col, pts in frame_parts:
        for r, c in pts:
            or_, oc = int(r) - fr0, int(c) - fc0
            assert 0 <= or_ < H and 0 <= oc < W, "frame output coords must stay in bounds"
            if req[or_, oc] != -1:
                assert int(req[or_, oc]) == int(col), "frame constraints must not conflict"
            req[or_, oc] = int(col)
            board0[or_, oc] = int(col)
    assert np.array_equal(board0, board0[:, ::-1]), "locked frame must already be LR-symmetric"

    color_piece_count: dict[int, int] = {}
    type_counter: Counter = Counter()
    for col in sorted(set(map(int, np.unique(g))) - {bg}):
        comps = components_mask(g == col, connectivity=4)
        color_piece_count[int(col)] = len(comps)
        for pts in comps:
            coords = _piece_sig(pts)[2]
            if all((int(r), int(c)) in frame_input_cells for r, c in pts):
                continue
            type_counter[(int(col), _canonical_rot_key(coords))] += 1

    types = []
    for (col, canon_key), cnt in sorted(type_counter.items(), key=lambda kv: (-len(kv[0][1][2]), kv[0][0], kv[0][1])):
        _, _, canon_coords = canon_key
        rots = _unique_rotations(canon_coords)
        types.append(
            {
                "col": int(col),
                "rots": rots,
                "cnt": int(cnt),
                "area": int(len(canon_coords)),
            }
        )

    disallow_touch = {col for col, n in color_piece_count.items() if n > 1}
    sol = _assemble(types, H, W, req, board0, disallow_touch)
    return sol.astype(int)


# --------------- generator ---------------

_AREA_MIN = 25
_AREA_MAX = 50
_WIDTH_REQUIRED = 5
_HEIGHT_MAX = 10

_N_COLORS_MIN = 4
_N_COLORS_MAX = 6
_TWO_FRAME_MIN_H = 6
_TWO_FRAME_MIN_COLORS = 5
_TWO_FRAME_PROB = 0.35
_CENTER_CAP_PROB = 0.5

_MAX_PIECE_AREA = 6
_MAX_CHUNK_SIZE = 6
_PIECE_COUNT_MIN = 9
_PIECE_COUNT_MAX = 17

_CANVAS_MIN = 13
_CANVAS_MAX = 15
_SCATTER_PADDING = 1
_MIN_ROT90_VISIBLE = 1
_MIN_QUARTER_TURN_CANDIDATES = 2

_GEN_MAX_RETRIES = 400


def _valid_dims():
    results = []
    for area in range(_AREA_MIN, _AREA_MAX + 1):
        dims = [(area // w, w) for w in range(1, area + 1) if area % w == 0 and area // w >= w]
        best_gap = min(abs(h - w) for h, w in dims)
        best = [(h, w) for h, w in dims if abs(h - w) == best_gap]
        if len(best) == 1:
            h, w = best[0]
            if w == _WIDTH_REQUIRED and h <= _HEIGHT_MAX:
                results.append((h, w))
    return results


_VALID_DIMS = _valid_dims()
_DIM_WEIGHTS = [h * w for h, w in _VALID_DIMS]


def _zigzag_frame(H: int) -> tuple[set[tuple[int, int]], int, int]:
    cells = set()
    start_c = random.randint(0, 1)
    c = start_c
    for r in range(H):
        cells.add((r, c))
        if r == H - 1:
            break
        move = random.choice(["down", "horiz", "diag"])
        if move == "horiz":
            cells.add((r, 1 - c))
            c = 1 - c
        elif move == "diag":
            c = 1 - c
    return cells, start_c, c


def _fill_holes(grid: np.ndarray, H: int, W: int, frame1: int, frame2: int, split: int, fill_pool: list[int]) -> None:
    holes = components_mask(grid == -1, connectivity=4)
    prev_col = None
    for hole in holes:
        cells = sorted((int(r), int(c)) for r, c in hole)
        chunks = [cells[i : i + _MAX_CHUNK_SIZE] for i in range(0, len(cells), _MAX_CHUNK_SIZE)]
        for chunk in chunks:
            fc_set = {frame1 if r < split else frame2 for r, _ in chunk}
            avoid = fc_set | ({prev_col} if prev_col is not None else set())
            opts = [f for f in fill_pool if f not in avoid]
            if not opts:
                opts = [f for f in fill_pool if f not in fc_set] or fill_pool
            col = random.choice(opts)
            for r, c in chunk:
                grid[r, c] = col
                grid[r, W - 1 - c] = col
            prev_col = col


def _build_output(H: int, W: int) -> tuple[np.ndarray | None, set[int]]:
    half = W // 2
    n_colors = random.randint(_N_COLORS_MIN, _N_COLORS_MAX)
    palette = list(range(n_colors))
    random.shuffle(palette)

    use_two_frames = (
        H >= _TWO_FRAME_MIN_H
        and n_colors >= _TWO_FRAME_MIN_COLORS
        and random.random() < _TWO_FRAME_PROB
    )
    ci = 0
    frame1 = palette[ci]
    ci += 1
    frame2 = frame1
    if use_two_frames:
        frame2 = palette[ci]
        ci += 1
    fill_pool = palette[ci:]
    if not fill_pool:
        return None, set()

    frame_half, start_c, end_c = _zigzag_frame(H)
    split = H // 2 if frame1 != frame2 else H
    grid = np.full((H, W), -1, dtype=int)

    for r, c in frame_half:
        fc = frame1 if r < split else frame2
        grid[r, c] = fc
        grid[r, W - 1 - c] = fc

    if start_c == 1 and random.random() < _CENTER_CAP_PROB:
        grid[0, half] = frame1
    if end_c == 1 and random.random() < _CENTER_CAP_PROB:
        grid[H - 1, half] = frame2

    _fill_holes(grid, H, W, frame1, frame2, split, fill_pool)
    if np.any(grid < 0):
        return None, set()

    frame_set = {frame1}
    if frame2 != frame1:
        frame_set.add(frame2)
    return grid, frame_set


def _make_output() -> tuple[np.ndarray | None, int, set[int]]:
    H, W = random.choices(_VALID_DIMS, weights=_DIM_WEIGHTS, k=1)[0]
    out, abstract_fcs = _build_output(H, W)
    if out is None:
        return None, 0, set()
    bg = random.randint(0, 9)
    abstract = sorted(np.unique(out))
    available = [c for c in range(10) if c != bg]
    random.shuffle(available)
    if len(available) < len(abstract):
        return None, 0, set()
    cmap = {int(a): available[i] for i, a in enumerate(abstract)}
    real_fcs = {cmap[a] for a in abstract_fcs}
    return np.vectorize(lambda x: cmap[int(x)])(out), bg, real_fcs


def _shape_key_from_patch(patch: np.ndarray, bg: int) -> tuple[int, int, tuple[tuple[int, int], ...]]:
    coords = np.argwhere(patch != bg)
    assert coords.size > 0
    return _piece_sig(coords)


def _extract_non_frame_patches(out: np.ndarray, bg: int, fcs: set[int]) -> list[dict]:
    patches = []
    for col in sorted(map(int, np.unique(out))):
        if col in fcs:
            continue
        for pts in components_mask(out == col, connectivity=4):
            r0, c0, r1, c1 = bbox_coords(pts)
            patch = np.full((r1 - r0 + 1, c1 - c0 + 1), bg, dtype=int)
            for r, c in pts:
                patch[int(r) - r0, int(c) - c0] = col
            base_key = _shape_key_from_patch(patch, bg)
            rot_keys = [_shape_key_from_patch(np.rot90(patch, k), bg) for k in range(4)]
            patches.append(
                {
                    "patch": patch,
                    "base_key": base_key,
                    "unique_rotations": len(set(rot_keys)),
                    "quarter_turn_visible": rot_keys[1] != base_key or rot_keys[3] != base_key,
                }
            )
    random.shuffle(patches)
    patches.sort(key=lambda p: (-(p["patch"] != bg).sum(), random.random()))
    return patches


def _scatter(out: np.ndarray, bg: int, fcs: set[int]) -> tuple[np.ndarray, dict]:
    rows = random.randint(_CANVAS_MIN, _CANVAS_MAX)
    cols = random.randint(_CANVAS_MIN, _CANVAS_MAX)
    canvas = np.full((rows, cols), bg, dtype=int)
    oh, ow = out.shape

    max_r = rows - oh - 2
    max_c = cols - ow - 2
    if max_r < 1 or max_c < 1:
        raise ValueError
    off_r = random.randint(1, max_r)
    off_c = random.randint(1, max_c)

    canvas[off_r : off_r + oh, off_c : off_c + ow] = -1

    patches = _extract_non_frame_patches(out, bg, fcs)
    qturn_candidates = [i for i, p in enumerate(patches) if p["quarter_turn_visible"]]
    if len(qturn_candidates) < _MIN_QUARTER_TURN_CANDIDATES:
        raise ValueError("not enough quarter-turn-distinguishable patches")

    force_n = random.randint(_MIN_ROT90_VISIBLE, min(3, len(qturn_candidates)))
    forced = set(random.sample(qturn_candidates, force_n))
    rot90_visible_count = 0
    rotated_nontrivial_count = 0

    for i, info in enumerate(patches):
        patch = info["patch"]
        if i in forced:
            k = random.choice([1, 3])
        else:
            k = random.randrange(4)
        rotated = np.rot90(patch, k)
        rotated_key = _shape_key_from_patch(rotated, bg)
        if rotated_key != info["base_key"]:
            rotated_nontrivial_count += 1
        if k in (1, 3) and rotated_key != info["base_key"]:
            rot90_visible_count += 1
        r, c = random_free_location(
            canvas,
            rotated,
            transparent=bg,
            padding=_SCATTER_PADDING,
            padding_connectivity=8,
        )
        paste(canvas, rotated, r, c, transparent=bg)

    frame_mask = np.zeros((oh, ow), dtype=bool)
    for col in fcs:
        frame_mask |= out == col
    bbox_region = canvas[off_r : off_r + oh, off_c : off_c + ow]
    bbox_region[:] = bg
    bbox_region[frame_mask] = out[frame_mask]

    meta = {
        "rot90_visible_count": int(rot90_visible_count),
        "rotated_nontrivial_count": int(rotated_nontrivial_count),
        "quarter_turn_candidate_count": int(len(qturn_candidates)),
        "rotatable_piece_count": int(sum(p["unique_rotations"] > 1 for p in patches)),
        "non_frame_piece_count": int(len(patches)),
    }
    if meta["rot90_visible_count"] < _MIN_ROT90_VISIBLE:
        raise ValueError("rotation visibility requirement not met")
    return canvas, meta


def _piece_count(out: np.ndarray) -> int:
    return sum(len(components_mask(out == col, connectivity=4)) for col in np.unique(out))


def _gen_attempt() -> tuple[np.ndarray | None, dict | None]:
    out, bg, fcs = _make_output()
    if out is None:
        return None, None
    if not np.array_equal(out, out[:, ::-1]):
        return None, None
    if not (_N_COLORS_MIN <= len(np.unique(out)) <= _N_COLORS_MAX):
        return None, None

    pc = _piece_count(out)
    if not (_PIECE_COUNT_MIN <= pc <= _PIECE_COUNT_MAX):
        return None, None
    if any(len(pts) > _MAX_PIECE_AREA for col in np.unique(out) for pts in components_mask(out == col, connectivity=4)):
        return None, None

    try:
        inp, meta = _scatter(out, bg, fcs)
        got = main(inp)
    except Exception:
        return None, None

    if np.array_equal(got, out):
        return inp, meta
    return None, None


def generate_input() -> np.ndarray:
    global _LAST_GEN_INFO
    for _ in range(_GEN_MAX_RETRIES):
        grid, meta = _gen_attempt()
        if grid is not None:
            _LAST_GEN_INFO = dict(meta or {})
            return grid
    raise RuntimeError("failed to generate a valid e8686506 D12 input")

            ```

    ## 你的任务

    1. **理解原代码**: 弄清 `main()` 和 `generate_input()` 的逻辑。

