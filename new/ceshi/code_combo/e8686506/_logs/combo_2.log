   111	    expected[:, w - 1] = True
   112	    return np.array_equal(mask.astype(bool), expected)
   113	
   114	
   115	def _component_info(grid: np.ndarray, pts: np.ndarray, bg: int) -> dict:
   116	    vals = [int(grid[int(r), int(c)]) for r, c in pts]
   117	    counts = Counter(vals)
   118	    body_color, body_count = counts.most_common(1)[0]
   119	    r0, c0, r1, c1 = bbox_coords(pts)
   120	    patch = np.full((r1 - r0 + 1, c1 - c0 + 1), bg, dtype=int)
   121	    for r, c in pts:
