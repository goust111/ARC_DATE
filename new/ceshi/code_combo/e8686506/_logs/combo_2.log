   183	def _parse_input(grid: np.ndarray) -> tuple[dict, list[dict]]:
   184	    g = np.asarray(grid, dtype=int)
   185	    bg = int(get_bg(g))
   186	    comps = components_mask(g != bg, connectivity=4)
   187	
