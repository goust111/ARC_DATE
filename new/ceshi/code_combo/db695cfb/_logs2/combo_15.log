) -> tuple[tuple[int, int], set[tuple[int, int]], list[tuple[int, int]]] | None:
    dr, dc = direction
    r_lo = 0 if dr > 0 else 0
    r_hi = h - 1
    c_lo = 0 if dc > 0 else 0
