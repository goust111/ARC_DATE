import importlib.util
from collections import Counter
import numpy as np

spec = importlib.util.spec_from_file_location('variant', '/home/lixinyu/snap/new/ceshi/code_combo/db695cfb/15/code.py')
mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)

pair_counts = Counter()
direct_trigger_counts = Counter()
cross_trigger_counts = Counter()
no_cross_equal = 0
original_equal = 0
samples = 100

for _ in range(samples):
    inp = mod.generate_input()
    out = mod.main(inp)
    arrows = mod._find_arrow_sources(inp)
    bg = mod.get_bg(inp)

    marker_groups = {}
    for arrow in arrows:
        tip = arrow['tip']
        markers = []
        for nr, nc in mod._neighbors4(*tip):
            if 0 <= nr < inp.shape[0] and 0 <= nc < inp.shape[1]:
                v = int(inp[nr, nc])
                if v not in (bg, mod._LINE_COLOR, mod._TRIGGER_COLOR):
                    markers.append(v)
        marker_groups.setdefault(markers[0], []).append(arrow)

    pair_counts[len(marker_groups)] += 1
    direct_n = 0
    cross_n = 0
    for group in marker_groups.values():
        p, q = mod._ordered_pair(group[0], group[1])
        direct = set(mod._exclusive_interior(mod._diag_path(p, q), mod._cross_path(p, q)))
        cross = set(mod._exclusive_interior(mod._cross_path(p, q), mod._diag_path(p, q)))
        for r, c in zip(*np.where(inp == mod._TRIGGER_COLOR)):
            cell = (int(r), int(c))
            if cell in direct:
                direct_n += 1
            if cell in cross:
                cross_n += 1
    direct_trigger_counts[direct_n] += 1
    cross_trigger_counts[cross_n] += 1

    if np.array_equal(out, mod._no_cross_output(inp)):
        no_cross_equal += 1
    if np.array_equal(out, mod._original_output(inp)):
        original_equal += 1

print('pair_counts', dict(sorted(pair_counts.items())))
print('direct_trigger_counts', dict(sorted(direct_trigger_counts.items())))
print('cross_trigger_counts', dict(sorted(cross_trigger_counts.items())))
print('no_cross_equal', no_cross_equal)
print('original_equal', original_equal)
