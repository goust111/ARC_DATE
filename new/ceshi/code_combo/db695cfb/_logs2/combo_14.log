+    return {
+        "ep0": ep0,
+        "ep1": ep1,
+        "path": _diag_path(ep0, ep1),
+        "family": family,
+        "dr": 1,
+        "dc": dc,
+        "triggers": [],
+    }
+
+
+def _feasible_half_lengths(max_up: int, max_down: int) -> list[tuple[int, int]]:
+    pairs: list[tuple[int, int]] = []
+    for up in range(1, max_up + 1):
+        for down in range(1, max_down + 1):
