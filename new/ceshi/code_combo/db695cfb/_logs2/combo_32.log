+
+    expected, bbox, active_cells = _build_expected(inp, bg, segments)
+    if _bbox_is_full(bbox, H, W):
+        return None
+    if np.array_equal(result, expected):
+        return inp
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(_GEN_RETRIES):
