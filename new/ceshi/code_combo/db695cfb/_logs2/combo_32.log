+
+def _place_trigger_distractors(
+    inp: np.ndarray,
+    occupied: set[tuple[int, int]],
+    active_cells: set[tuple[int, int]],
+    bbox: tuple[int, int, int, int],
+    orient: str,
+    used_indices: set[int],
