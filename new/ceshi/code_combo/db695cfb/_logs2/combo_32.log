+_GEN_RETRIES = 400
+
+
+def _compute_ray_cells(
+    triggers: list[tuple[int, int]], perp_dirs: list[tuple[int, int]], H: int, W: int
+) -> set[tuple[int, int]]:
+    cells: set[tuple[int, int]] = set()
+    for tr, tc in triggers:
+        for ddr, ddc in perp_dirs:
+            r, c = tr + ddr, tc + ddc
+            while 0 <= r < H and 0 <= c < W:
+                cells.add((r, c))
+                r += ddr
+                c += ddc
