+# === CFG: canvas and structural bounds ===
+_H_RANGE = (8, 25)
+_W_RANGE = (9, 21)
+_LINE_COLOR = 1
+_TRIGGER_COLOR = 6
+_SEGMENT_COUNT = (2, 3)
+_SEG_LEN_RANGE = (5, 16)
