+                    r += ddr
+                    c += ddc
+    return expected
+
+
+def _build_perpendicular_two_sided_expected(inp: np.ndarray, bg: int, segments) -> np.ndarray:
+    H, W = inp.shape
+    expected = inp.copy()
+    for ep0, ep1, trigger_specs, path in segments:
