+# Combo variant of db695cfb (index 25)
+# combo_spec: D1/0+D2/0+D16/2
+# Name: 直线路径+平行延伸+单方向
+
+from __future__ import annotations
+
+import random
+import sys
+from pathlib import Path
+
+import numpy as np
+
+_SOLVER_DIR = Path("/home/lixinyu/snap/new/solvers")
+if str(_SOLVER_DIR) not in sys.path:
