+
+    row_groups: dict[int, list[tuple[int, int]]] = {}
+    col_groups: dict[int, list[tuple[int, int]]] = {}
+    for r, c in pts:
+        row_groups.setdefault(r, []).append((r, c))
+        col_groups.setdefault(c, []).append((r, c))
