def get_bg(grid):
    vals, counts = np.unique(grid, return_counts=True)
    return int(vals[np.argmax(counts)])

def extract_segments(grid):
    grid = np.asarray(grid, dtype=int)
    h, w = grid.shape
    bg = get_bg(grid)
    by_color = {}
    for r in range(h):
        for c in range(w):
            col = int(grid[r, c])
            if col == bg:
                continue
            by_color.setdefault(col, []).append((r, c))
    best = None
    for col, pts in by_color.items():
        if len(pts) < 2:
            continue
        for i in range(len(pts)):
            r0, c0 = pts[i]
            for j in range(i + 1, len(pts)):
                r1, c1 = pts[j]
                if (r0 == r1) == (c0 == c1):
                    continue
                cand = (abs(r1 - r0) + abs(c1 - c0), col)
                if best is None or cand > best:
                    best = cand
    _, line_color = best
    pts = by_color[line_color]
    segments = []
    row_groups = {}
    col_groups = {}
    for r, c in pts:
        row_groups.setdefault(r, []).append((r, c))
        col_groups.setdefault(c, []).append((r, c))
    for group in row_groups.values():
        if len(group) >= 2:
            group = sorted(group, key=lambda rc: rc[1])
            p, q = group[0], group[-1]
            path = mod._straight_path(p, q)
            triggers = [(r, c, int(grid[r, c])) for r, c in path if int(grid[r, c]) not in (bg, line_color)]
            segments.append((p, q, triggers, path))
    for group in col_groups.values():
        if len(group) >= 2:
            group = sorted(group, key=lambda rc: rc[0])
            p, q = group[0], group[-1]
            path = mod._straight_path(p, q)
            triggers = [(r, c, int(grid[r, c])) for r, c in path if int(grid[r, c]) not in (bg, line_color)]
            segments.append((p, q, triggers, path))
    return bg, line_color, segments

def baseline(grid):
    grid = np.asarray(grid, dtype=int)
    h, w = grid.shape
    out = grid.copy()
    bg, line_color, segments = extract_segments(grid)
    for p, q, triggers, path in segments:
        for r, c in path:
            if int(out[r, c]) == bg:
                out[r, c] = line_color
        dirs = [(0, -1), (0, 1)] if p[0] == q[0] else [(-1, 0), (1, 0)]
        for r0, c0, tcol in triggers:
            for dr, dc in dirs:
                r, c = r0 + dr, c0 + dc
                while 0 <= r < h and 0 <= c < w:
                    if int(out[r, c]) == bg:
                        out[r, c] = tcol
                    r += dr
                    c += dc
    return out

for trial in range(2000):
    inp = mod.generate_input()
    combo = mod.main(inp)
    para2 = baseline(inp)
    if np.array_equal(combo, para2):
        bg, line_color, segments = extract_segments(inp)
        print('found at trial', trial)
        print('shape', inp.shape, 'bg', bg)
        print('input')
        print(inp)
        print('segments')
        for p, q, triggers, path in segments:
            print('segment', p, q, 'triggers', triggers)
        print('combo output')
        print(combo)
        break
else:
    print('no equal sample found')
