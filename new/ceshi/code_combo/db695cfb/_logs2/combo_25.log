+def _build_parallel_two_sided_expected(inp: np.ndarray, bg: int, segments) -> np.ndarray:
+    H, W = inp.shape
+    expected = inp.copy()
+    for ep0, ep1, trigger_specs, path in segments:
+        for r, c in path:
+            if expected[r, c] == bg:
+                expected[r, c] = _LINE_COLOR
+        if ep0[0] == ep1[0]:
+            dirs = [(0, -1), (0, 1)]
+        else:
+            dirs = [(-1, 0), (1, 0)]
