   428	        if not neg_side or not pos_side:
   429	            continue
   430	
   431	        return path
   432	    return None
   433	
   434	
   435	def _choose_trigger_specs(path: list[tuple[int, int]]):
   436	    neg_side, pos_side = _visible_side_buckets(path)
   437	    sides = [neg_side, pos_side]
   438	    n_triggers = random.randint(_TRIGGERS_PER_SEG[0], _TRIGGERS_PER_SEG[1])
   439	    if n_triggers == 2:
   440	        picks = [random.choice(neg_side), random.choice(pos_side)]
   441	    else:
   442	        chosen_side = random.choice(sides)
   443	        picks = [random.choice(chosen_side)]
   444	    specs = [(pos, _single_parallel_dir(pos, path[0], path[-1])) for pos in picks]
   445	    return specs
   446	
   447	
   448	def _gen_attempt() -> np.ndarray | None:
   449	    H = random.randint(*_H_RANGE)
   450	    W = random.randint(*_W_RANGE)
   451	    bg = random.choice([c for c in range(10) if c not in (_LINE_COLOR, _TRIGGER_COLOR)])
   452	
   453	    max_seg_len = min(_SEG_LEN_RANGE[1], max(H - 3, 0), max(W - 3, 0))
   454	    if max_seg_len < _SEG_LEN_RANGE[0]:
   455	        return None
   456	
   457	    n_segments = random.randint(*_SEGMENT_COUNT)
   458	    occupied: set[tuple[int, int]] = set()
   459	    drawn: set[tuple[int, int]] = set()
   460	    line_positions: list[tuple[int, int]] = []
   461	    trigger_positions: list[tuple[int, int]] = []
   462	    segments = []
   463	    visible_dirs: set[tuple[int, int]] = set()
   464	    total_extra_cells = 0
   465	    has_single_trigger_segment = False
   466	
   467	    for _ in range(n_segments):
   468	        orient = random.choice(["h", "v"])
   469	        seg_len = random.randint(_SEG_LEN_RANGE[0], max_seg_len)
   470	
   471	        path = _try_place_segment(orient, seg_len, H, W, occupied, drawn, line_positions)
   472	        if path is None:
