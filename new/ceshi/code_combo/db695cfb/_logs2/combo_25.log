            for dr, dc in use_dirs:
                r, c = r0 + dr, c0 + dc
                while 0 <= r < h and 0 <= c < w:
                    if int(out[r, c]) == bg:
                        out[r, c] = tcol
                    r += dr
                    c += dc
    return out

