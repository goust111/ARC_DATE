+    all_trigger_positions = list(trigger_positions)
+    for _ in range(random.randint(*_OFF_SEG_TRIGGERS)):
+        for _ in range(_DISTRACTOR_RETRIES):
+            pos = (random.randint(0, H - 1), random.randint(0, W - 1))
