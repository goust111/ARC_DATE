+def _compute_single_ray_cells(
+    trigger_specs: list[tuple[tuple[int, int], tuple[int, int]]],
+    H: int,
+    W: int,
+) -> set[tuple[int, int]]:
+    cells: set[tuple[int, int]] = set()
+    for (tr, tc), (ddr, ddc) in trigger_specs:
+        r, c = tr + ddr, tc + ddc
+        while 0 <= r < H and 0 <= c < W:
+            cells.add((r, c))
+            r += ddr
+            c += ddc
+    return cells
