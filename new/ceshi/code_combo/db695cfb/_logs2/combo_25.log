   497	        return None
   498	
   499	    inp = np.full((H, W), bg, dtype=int)
   500	    for ep0, ep1, trigger_specs, _ in segments:
   501	        inp[ep0] = _LINE_COLOR
   502	        inp[ep1] = _LINE_COLOR
   503	        for pos, _ in trigger_specs:
   504	            inp[pos] = _TRIGGER_COLOR
   505	
