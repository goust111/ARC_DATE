            if int(out[r, c]) == bg:
                out[r, c] = line_color
        if p[0] == q[0]:
            dirs = {'perp2': [(-1, 0), (1, 0)], 'parallel2': [(0, -1), (0, 1)]}.get(mode)
        else:
