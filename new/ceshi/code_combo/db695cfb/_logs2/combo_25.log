            path = mod._straight_path(p, q)
            triggers = [(r, c, int(grid[r, c])) for r, c in path if int(grid[r, c]) not in (bg, line_color)]
            segments.append((p, q, triggers, path, line_color))
    return bg, line_color, segments


def baseline(grid, mode):
    grid = np.asarray(grid, dtype=int)
    h, w = grid.shape
    out = grid.copy()
    bg, line_color, segments = extract_segments(grid)
    for p, q, triggers, path, _ in segments:
        for r, c in path:
            if int(out[r, c]) == bg:
                out[r, c] = line_color
        if p[0] == q[0]:
            if mode == 'perp2':
                dirs = [(-1, 0), (1, 0)]
            elif mode == 'parallel2':
                dirs = [(0, -1), (0, 1)]
            else:
                dirs = None
        else:
            if mode == 'perp2':
                dirs = [(0, -1), (0, 1)]
            elif mode == 'parallel2':
                dirs = [(-1, 0), (1, 0)]
            else:
                dirs = None
        for r0, c0, tcol in triggers:
            if mode == 'single':
                use_dirs = [mod._single_parallel_dir((r0, c0), p, q)]
            else:
                use_dirs = dirs
            for dr, dc in use_dirs:
                r, c = r0 + dr, c0 + dc
                while 0 <= r < h and 0 <= c < w:
                    if int(out[r, c]) == bg:
                        out[r, c] = tcol
                    r += dr
                    c += dc
    return out


def visible_dir_count(grid):
    bg, line_color, segments = extract_segments(grid)
    dirs = set()
    for p, q, triggers, path, _ in segments:
        path_set = set(path)
        for r, c, _ in triggers:
            d = mod._single_parallel_dir((r, c), p, q)
            rr, cc = r + d[0], c + d[1]
            visible = False
            while 0 <= rr < grid.shape[0] and 0 <= cc < grid.shape[1]:
                if (rr, cc) not in path_set:
                    visible = True
                    break
                rr += d[0]
                cc += d[1]
            if visible:
                dirs.add(d)
    return len(dirs)

