+# g) 变化可推断性:
+#    颜色映射只有一个关键关系: “与触发点对角相邻的一格都变成 8”。更远的补线统一回到 1。
+
+# === CFG: colors ===
+_LINE_COLOR = 1
+_TRIGGER_COLOR = 6
+_BLEND_COLOR = 8
+
+# === CFG: canvas and structural bounds ===
+_H_RANGE = (8, 25)
+_W_RANGE = (9, 21)
+_SEGMENT_COUNT = (1, 3)
+_SEG_LEN_RANGE = (5, 16)
+_TRIGGERS_PER_SEG = (1, 1)
