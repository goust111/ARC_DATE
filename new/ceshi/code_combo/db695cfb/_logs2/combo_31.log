+    segments: list[tuple[list[tuple[int, int]], list[tuple[int, int]]]] = []
+    for g in groups_a.values():
+        if len(g) >= 2:
+            g = sorted(g)
+            p, q = g[0], g[-1]
+            path = _diag_path(p, q)
+            dr = 1 if q[0] > p[0] else -1
+            dc = 1 if q[1] > p[1] else -1
+            segments.append((path, [(dr, -dc), (-dr, dc)]))
+
+    for g in groups_b.values():
+        if len(g) >= 2:
+            g = sorted(g)
+            p, q = g[0], g[-1]
+            path = _diag_path(p, q)
+            dr = 1 if q[0] > p[0] else -1
+            dc = 1 if q[1] > p[1] else -1
