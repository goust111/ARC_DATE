   375	def main(grid: np.ndarray) -> np.ndarray:
   376	    """
   377	    Grow each blue diagonal inward from both endpoints, letting magenta blockers branch immediately and rays stop on impact.
   378	
   379	    Input structure:
   380	    - The background is the most common color. One non-background color provides endpoint pairs on shared diagonals, and magenta pixels may lie on those diagonal corridors between the endpoints.
   381	
   382	    Rule:
   383	    - For every diagonal owned by the line color, start one growth front from each blue endpoint and advance both fronts one cell per round toward the middle.
   384	    - A front paints a cell blue only if that cell is background. If it steps onto a magenta obstacle, it stops there instead of passing through, and that magenta cell immediately emits the two perpendicular diagonal rays.
   385	    - Each emitted ray paints background cells only and halts as soon as the next cell on that ray is already occupied by any non-background pixel. Growth also stops when the two inward-moving blue fronts meet in the middle.
   386	
   387	    Key insight: The same magenta cell now plays two roles at once: it cuts the blue connection and becomes the branching source, while the branch itself is constrained by nearby structure because collisions terminate the ray.
   388	    """
   389	
   390	    out, _ = _solve_with_policy(grid, growth_mode="dual", stop_rays_on_collision=True)
   391	    return out
   392	
   393	
   394	def _build_input(H: int, W: int, bg: int, segments: list[dict]) -> np.ndarray:
   395	    inp = np.full((H, W), bg, dtype=int)
   396	    for seg in segments:
   397	        path = seg["path"]
   398	        inp[path[0]] = _LINE_COLOR
   399	        inp[path[-1]] = _LINE_COLOR
   400	        for tp in seg["triggers"]:
   401	            inp[tp] = _TRIGGER_COLOR
   402	    return inp
   403	
   404	
   405	def _variant_metrics(inp: np.ndarray) -> dict:
   406	    combo_out, combo_info = _solve_with_policy(
   407	        inp, growth_mode="dual", stop_rays_on_collision=True
   408	    )
   409	    one_sided_out, one_sided_info = _solve_with_policy(
   410	        inp, growth_mode="one_sided", stop_rays_on_collision=True
   411	    )
   412	    no_collision_out, no_collision_info = _solve_with_policy(
   413	        inp, growth_mode="dual", stop_rays_on_collision=False
   414	    )
   415	
   416	    combo_map = {
   417	        (tuple(rec["trigger"]), tuple(rec["dir"])): rec for rec in combo_info["ray_records"]
   418	    }
   419	    no_collision_map = {
   420	        (tuple(rec["trigger"]), tuple(rec["dir"])): rec for rec in no_collision_info["ray_records"]
   421	    }
   422	    shortened_rays = sum(
   423	        1
   424	        for key, rec in combo_map.items()
   425	        if key in no_collision_map and rec["painted"] < no_collision_map[key]["painted"]
   426	    )
   427	
   428	    line_color = combo_info["line_color"]
   429	    extra_blue_vs_one_sided = int(
   430	        np.count_nonzero((combo_out == line_color) & (one_sided_out != line_color))
   431	    )
   432	
   433	    return {
   434	        "combo_out": combo_out,
   435	        "one_sided_out": one_sided_out,
   436	        "no_collision_out": no_collision_out,
   437	        "combo_info": combo_info,
   438	        "one_sided_info": one_sided_info,
   439	        "no_collision_info": no_collision_info,
   440	        "blocked_rays": sum(1 for r in combo_info["ray_records"] if r["blocked"]),
   441	        "blocked_by_line": sum(1 for r in combo_info["ray_records"] if r["block_kind"] == "line"),
   442	        "shortened_rays": shortened_rays,
   443	        "differs_from_one_sided": not np.array_equal(combo_out, one_sided_out),
   444	        "differs_from_no_collision": not np.array_equal(combo_out, no_collision_out),
   445	        "dual_contact_segments": sum(
   446	            1 for seg in combo_info["segment_records"] if seg["dual_contact_trigger"]
   447	        ),
   448	        "two_sided_blue_segments": sum(
   449	            1 for seg in combo_info["segment_records"] if seg["two_sided_blue"]
   450	        ),
   451	        "extra_blue_vs_one_sided": extra_blue_vs_one_sided,
   452	        "line_color": line_color,
   453	        "trigger_count": combo_info["trigger_count"],
   454	    }
   455	
   456	
   457	def _place_random_path(
   458	    H: int,
   459	    W: int,
   460	    seg_len: int,
   461	    *,
   462	    slope_type: str,
   463	) -> list[tuple[int, int]] | None:
   464	    if slope_type == "backslash":
   465	        if H - 1 - seg_len < 0 or W - 1 - seg_len < 0:
   466	            return None
   467	        r0 = random.randint(0, H - 1 - seg_len)
   468	        c0 = random.randint(0, W - 1 - seg_len)
   469	        return [(r0 + k, c0 + k) for k in range(seg_len + 1)]
   470	    if H - 1 - seg_len < 0 or seg_len > W - 1:
   471	        return None
   472	    r0 = random.randint(0, H - 1 - seg_len)
   473	    c0 = random.randint(seg_len, W - 1)
   474	    return [(r0 + k, c0 - k) for k in range(seg_len + 1)]
   475	
   476	
   477	def _place_free_segment(
   478	    H: int,
   479	    W: int,
   480	    reserved_cells: set[tuple[int, int]],
   481	    used_diagonals: set[tuple[str, int]],
   482	    *,
   483	    allowed_cells: set[tuple[int, int]] | None = None,
   484	    even_length_only: bool = False,
   485	    length_range: tuple[int, int] = _SEG_LEN_RANGE,
   486	) -> list[tuple[int, int]] | None:
   487	    max_seg_len = min(H - 1, W - 1, length_range[1])
   488	    min_seg_len = length_range[0]
   489	    if max_seg_len < min_seg_len:
   490	        return None
   491	
   492	    for _ in range(_SEGMENT_PLACE_RETRIES):
   493	        slope_type = random.choice(["backslash", "slash"])
   494	        seg_len = random.randint(min_seg_len, max_seg_len)
   495	        if even_length_only and seg_len % 2 == 1:
   496	            continue
   497	        path = _place_random_path(H, W, seg_len, slope_type=slope_type)
   498	        if path is None:
   499	            continue
   500	        diag_key = _segment_key(path)
   501	        if diag_key in used_diagonals:
   502	            continue
   503	        if any(rc in reserved_cells for rc in path):
   504	            continue
   505	        if allowed_cells is not None and any(rc not in allowed_cells for rc in path):
   506	            continue
   507	        return path
   508	    return None
   509	
   510	
   511	def _place_interacting_pair(H: int, W: int) -> list[dict] | None:
   512	    for _ in range(_PAIR_PLACE_RETRIES):
   513	        emitter_path = _place_free_segment(
   514	            H,
   515	            W,
   516	            set(),
   517	            set(),
   518	            even_length_only=True,
   519	            length_range=_MAIN_SEG_LEN_RANGE,
   520	        )

