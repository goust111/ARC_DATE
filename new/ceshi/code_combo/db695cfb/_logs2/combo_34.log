   322	        hop_2 = random.randint(2, 4)
   323	        b_len = random.randint(3, 6)
   324	
   325	        t1 = (random.randrange(h), random.randrange(w))
   326	        a0 = _step(t1, (-d_base[0], -d_base[1]), a_left)
   327	        a1 = _step(t1, d_base, a_right)
   328	        t2 = _step(t1, d_perp, hop_1)
   329	        endpoint = _step(t2, d_base, hop_2)
   330	        b0 = _step(endpoint, (-d_perp[0], -d_perp[1]), b_len)
   331	        free_side = _step(endpoint, d_perp, 1)
   332	
   333	        pts = [t1, a0, a1, t2, endpoint, b0, free_side]
   334	        if not all(_in_bounds(h, w, p) for p in pts):
   335	            continue
