+# Combo variant of db695cfb (index 34)
+# combo_spec: D3/2+D9/0+D14/2
+# Name: 迭代传播+遇线停止+交叉触发新延伸
+
+import random
+from collections import Counter, defaultdict
+
+import numpy as np
+
+from arc_utils import get_bg
+
+
+_BACKSLASH = 0
+_SLASH = 1
+_DIRS = {
+    _BACKSLASH: ((1, 1), (-1, -1)),
+    _SLASH: ((1, -1), (-1, 1)),
+}
+_PERP = {_BACKSLASH: _SLASH, _SLASH: _BACKSLASH}
+
+_LINE_COLOR = 1
+_TRIGGER_COLOR = 6
+_H_RANGE = (10, 22)
+_W_RANGE = (10, 22)
