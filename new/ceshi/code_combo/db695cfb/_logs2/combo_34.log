   356	
   357	        occupied = {a0, a1, b0, endpoint, t1, t2}
   358	        out, debug = _simulate(inp, want_debug=True)
   359	        legacy = _legacy_main(inp)
   360	
   361	        if debug["relay_hits"] < 1:
   362	            continue
