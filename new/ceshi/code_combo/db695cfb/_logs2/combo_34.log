+_BACKSLASH = 0
+_SLASH = 1
+_DIRS = {
+    _BACKSLASH: ((1, 1), (-1, -1)),
+    _SLASH: ((1, -1), (-1, 1)),
+}
+_PERP = {_BACKSLASH: _SLASH, _SLASH: _BACKSLASH}
+
+_LINE_COLOR = 1
+_TRIGGER_COLOR = 6
+_H_RANGE = (10, 22)
+_W_RANGE = (10, 22)
+_GEN_RETRIES = 400
+_PLACEMENT_RETRIES = 120
