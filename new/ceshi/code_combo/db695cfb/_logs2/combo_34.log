+        r, c, emit_orient, color = queue.pop(0)
+        key = (r, c, emit_orient)
+        queued.discard(key)
+        if key in processed:
+            continue
+        processed.add(key)
+        debug["processed_triggers"] += 1
+        for d in _DIRS[emit_orient]:
