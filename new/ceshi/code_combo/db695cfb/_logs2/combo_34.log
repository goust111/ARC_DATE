+        inp[a0] = _LINE_COLOR
+        inp[a1] = _LINE_COLOR
+        inp[b0] = _LINE_COLOR
+        inp[endpoint] = _LINE_COLOR
+        inp[t1] = _TRIGGER_COLOR
+        inp[t2] = _TRIGGER_COLOR
+
