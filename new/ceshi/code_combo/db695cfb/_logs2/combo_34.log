+
+
+def _try_place_distractors(inp: np.ndarray, occupied: set[tuple[int, int]], forbidden: set[tuple[int, int]]) -> None:
+    h, w = inp.shape
+    blue_points = [(int(r), int(c)) for r, c in np.argwhere(inp == _LINE_COLOR)]
+
+    if random.random() < 0.45:
