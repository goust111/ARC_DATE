+        if int(out[free_side]) != _TRIGGER_COLOR:
+            continue
+        if int(out[endpoint]) != _TRIGGER_COLOR:
+            continue
+
+        forbidden = {(int(r), int(c)) for r, c in np.argwhere(out != bg)}
+        _try_place_distractors(inp, occupied, forbidden)
+        return inp
+
+    return None
+
