+            pos = (r, c)
+            existing = cell_orients.get(pos, set())
+
+            if orient in existing:
+                debug["stopped_on_line"] += 1
+                return
+
+            if existing:
+                prev_orients = set(existing)
+                cell_orients[pos].add(orient)
