+        total_len = _ray_total_length(pos, perp_dirs, H, W)
+        out[pos] = _trigger_color_from_length(total_len)
+        for rr, cc in _dash_cells(pos, perp_dirs, order, H, W):
+            if int(out[rr, cc]) == bg:
+                out[rr, cc] = _INPUT_TRIGGER
