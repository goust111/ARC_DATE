+def _try_place_segment(
+    slope_type: str,
+    seg_len: int,
+    H: int,
+    W: int,
+    occupied: set[tuple[int, int]],
+    reserved: set[tuple[int, int]],
+) -> list[tuple[int, int]] | None:
