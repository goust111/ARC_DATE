+def _perp_dirs_from_path(path: list[tuple[int, int]]) -> list[tuple[int, int]]:
+    (r0, c0), (r1, c1) = path[0], path[-1]
+    dr = 1 if r1 > r0 else -1
+    dc = 1 if c1 > c0 else -1
+    return [(dr, -dc), (-dr, dc)]
