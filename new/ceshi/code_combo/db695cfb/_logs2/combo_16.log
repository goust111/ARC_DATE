+def _trigger_color_from_length(total_len: int) -> int:
+    if total_len <= _TRIGGER_BIN_LIMITS[0]:
+        return _SHORT_TRIGGER
+    if total_len <= _TRIGGER_BIN_LIMITS[1]:
+        return _MED_TRIGGER
+    return _LONG_TRIGGER
+
+
+def _trigger_bin_index(total_len: int) -> int:
+    if total_len <= _TRIGGER_BIN_LIMITS[0]:
+        return 0
+    if total_len <= _TRIGGER_BIN_LIMITS[1]:
+        return 1
+    return 2
+
+
+def _dash_cells(
+    start: tuple[int, int],
+    dirs: list[tuple[int, int]],
+    gap_size: int,
+    H: int,
+    W: int,
+) -> set[tuple[int, int]]:
+    cells = set()
+    period = gap_size + 1
+    r0, c0 = start
+    for ddr, ddc in dirs:
+        step = 1
+        r, c = r0 + ddr, c0 + ddc
+        while 0 <= r < H and 0 <= c < W:
+            if (step - 1) % period == 0:
+                cells.add((r, c))
+            r += ddr
+            c += ddc
+            step += 1
