   118	def _find_dividers(g: np.ndarray, bg: int) -> tuple[int, int]:
   119	    """Return the unique full-row/full-col divider crossing."""
   120	    h, w = g.shape
   121	    full_rows = [(r, int(g[r, 0])) for r in range(h) if np.all(g[r, :] == g[r, 0]) and int(g[r, 0]) != bg]
