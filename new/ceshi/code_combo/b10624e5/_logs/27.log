+def _anchor_center(r0: int, c0: int, size: int) -> tuple[int, int]:
+    """Choose a stable integer endpoint inside a square anchor."""
+    return int(r0 + min(size // 2, size - 1)), int(c0 + min(size // 2, size - 1))
