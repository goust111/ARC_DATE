   132	def _resize_nn(img: np.ndarray, new_h: int, new_w: int) -> np.ndarray:
   133	    """Nearest-neighbor resize supporting integer or fractional ratios."""
   134	    src_h, src_w = img.shape
   135	    if new_h <= 0 or new_w <= 0:
   136	        return img.copy()
   137	    rr = np.clip(np.floor(np.arange(new_h) * src_h / new_h).astype(int), 0, src_h - 1)
   138	    cc = np.clip(np.floor(np.arange(new_w) * src_w / new_w).astype(int), 0, src_w - 1)
   139	    return img[rr[:, None], cc[None, :]]
