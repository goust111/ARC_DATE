   147	def _line_cells(r0: int, c0: int, r1: int, c1: int) -> list[tuple[int, int]]:
   148	    """Return a continuous 8-connected integer line between two cells."""
   149	    dr = int(r1 - r0)
   150	    dc = int(c1 - c0)
   151	    steps = max(abs(dr), abs(dc))
   152	    if steps == 0:
   153	        return [(int(r0), int(c0))]
   154	    pts: list[tuple[int, int]] = []
   155	    last = None
   156	    for i in range(steps + 1):
   157	        rr = int(round(r0 + dr * i / steps))
   158	        cc = int(round(c0 + dc * i / steps))
   159	        cur = (rr, cc)
   160	        if cur != last:
   161	            pts.append(cur)
   162	            last = cur
   163	    return pts
