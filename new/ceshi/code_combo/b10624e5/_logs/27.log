   123	    matches = []
   124	    for r, vr in full_rows:
   125	        for c, vc in full_cols:
   126	            if vr == vc:
   127	                matches.append((int(r), int(c)))
   128	    assert len(matches) == 1, "grid must have exactly one matching full-row/full-col divider"
   129	    return matches[0]
