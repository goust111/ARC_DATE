    star = mod._propagate(inp, mod.STAR_EDGES)
    deltas.append(int(np.count_nonzero(combo "'!= star)))
    trails.append(int(np.count_nonzero(combo == mod.TRAIL)))
print('"'chain_delta min/avg/max:', min(deltas), round(statistics.mean(deltas), 2), max(deltas))
print('trail_cells min/avg/max:', min(trails), round(statistics.mean(trails), 2), max(trails))
print('delta>=8 count:', sum(d >= mod.MIN_CHAIN_DELTA for d in deltas), '/', len(deltas))
