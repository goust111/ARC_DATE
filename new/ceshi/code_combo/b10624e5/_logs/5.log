+    return states
+
+
+def _gen_attempt() -> np.ndarray | None:
+    logical = _make_logical_patch()
+    source_patch = _scale_logical(logical, SOURCE_ANCHOR_SIZE)
+    source_anchor_cell = (0, 0)
+    source_anchor_px = (0, 0)
