+        ar, ac = anchors[key]
+        paste(inp, np.full((size, size), RED, dtype=int), ar, ac)
+
+    return inp if np.array_equal(main(inp), out) else None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
