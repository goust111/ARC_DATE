+    states: dict[tuple[int, int], tuple[np.ndarray, tuple[int, int]]] = {}
+    current_logical = logical0
+    current_anchor = anchor0
+    current_quad = (0, 0)
+    for src_quad, dst_quad in CHAIN:
+        assert src_quad == current_quad
