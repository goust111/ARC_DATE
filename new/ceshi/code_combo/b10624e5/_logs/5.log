+BG = 4
+DIV = 1
+RED = 2
+GRID_SIZE = 27
+MID = 13
+SOURCE_ANCHOR_SIZE = 2
+TARGET_SIZE_CHOICES = [1, 2]
+MAX_RETRIES = 300
+ANCHOR_JITTER = 2
+COLOR_POOL = [0, 3, 5, 6, 7, 8, 9]
+QUADS = {
+    (0, 0): (0, 12, 0, 12),
+    (0, 1): (0, 12, 14, 26),
+    (1, 0): (14, 26, 0, 12),
+    (1, 1): (14, 26, 14, 26),
