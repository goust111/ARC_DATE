   284	) -> np.ndarray | None:
   285	    rows = {r for r, _ in filled}
   286	    cols = {c for _, c in filled}
   287	    if rows != set(range(h)) or cols != set(range(w)):
   288	        return None
   289	
   290	    non_red = [p for p in filled if p not in red_cells]
   291	    random.shuffle(non_red)
   292	    max_colors = min(MOTIF_COLORS_MAX, len(non_red) + 1)
   293	    if max_colors < MOTIF_COLORS_MIN:
