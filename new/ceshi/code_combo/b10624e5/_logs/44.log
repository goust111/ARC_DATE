   295	
   296	    n_colors = random.randint(MOTIF_COLORS_MIN, max_colors)
   297	    extras = random.sample(COLOR_POOL, n_colors - 1)
   298	    grid = np.full((h, w), BG, dtype=int)
   299	    for r, c in red_cells:
   300	        grid[r, c] = RED
   301	    for i, (r, c) in enumerate(non_red):
