   259	def _grow_4conn(h: int, w: int, seeds: set[tuple[int, int]], n_fill: int) -> set[tuple[int, int]]:
   260	    """Grow a 4-connected region from seeds until it has n_fill cells."""
   261	    filled = set(seeds)
   262	    frontier = set()
   263	    for r, c in seeds:
   264	        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
   265	            nr, nc = r + dr, c + dc
   266	            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in filled:
   267	                frontier.add((nr, nc))
   268	    while len(filled) < n_fill and frontier:
   269	        cell = random.choice(list(frontier))
   270	        frontier.discard(cell)
   271	        filled.add(cell)
   272	        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
   273	            nr, nc = cell[0] + dr, cell[1] + dc
   274	            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in filled:
   275	                frontier.add((nr, nc))
   276	    return filled
