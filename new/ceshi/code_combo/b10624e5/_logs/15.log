   107	    """Nearest-neighbor resize supporting fractional scale ratios."""
   108	    src_h, src_w = img.shape
   109	    if new_h <= 0 or new_w <= 0:
   110	        return img.copy()
   111	    rr = np.clip(np.floor(np.arange(new_h) * src_h / new_h).astype(int), 0, src_h - 1)
   112	    cc = np.clip(np.floor(np.arange(new_w) * src_w / new_w).astype(int), 0, src_w - 1)
   113	    return img[rr[:, None], cc[None, :]]
