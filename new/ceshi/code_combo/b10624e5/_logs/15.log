+        return None
+    if np.array_equal(combo, _render_variant(inp, recolor_targets=True, recolor_source=False)):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
