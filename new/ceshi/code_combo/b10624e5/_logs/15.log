+# --------------- generator (combo D6/1 + D10/1) ---------------
+
+BG = 4
+DIV = 1
+GRID_SIZE = 27
+MID = 13
+QUADS = {
+    (0, 0): (0, 12, 0, 12),
+    (0, 1): (0, 12, 14, 26),
+    (1, 0): (14, 26, 0, 12),
+    (1, 1): (14, 26, 14, 26),
+}
+
+SOURCE_ANCHOR_SIZE = 2
+TARGET_SIZE_RANGE = (1, 4)
+ANCHOR_COLOR_POOL = [0, 2, 3, 5, 6, 7, 8, 9]
+
+LOGICAL_DIMS = [(2, 3), (3, 2), (3, 3)]
+FILL_RATIO_MIN = 0.7
+FILL_RATIO_MAX = 1.0
+SOURCE_EXTRA_COLORS_MIN = 2
+SOURCE_EXTRA_COLORS_MAX = 4
+
+MAX_RETRIES = 500
