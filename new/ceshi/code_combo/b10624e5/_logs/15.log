+
+def _choose_anchor(
+    qb: int,
+    qr: int,
+    size: int,
+    patch_s: np.ndarray,
+    source_anchor_color: int,
+) -> tuple[int, int]:
+    """Pick an anchor position, preferring full-fit placements for the full scaled motif."""
+    q_r0, q_r1, q_c0, q_c1 = QUADS[(qb, qr)]
