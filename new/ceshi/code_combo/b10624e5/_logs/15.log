   327	
   328	def _assign_logical_colors(
   329	    filled: set[tuple[int, int]],
   330	    anchor_cell: tuple[int, int],
   331	    h: int,
   332	    w: int,
   333	    anchor_color: int,
   334	    extra_palette: list[int],
   335	) -> np.ndarray | None:
   336	    """Color a logical motif while avoiding accidental fake anchors."""
   337	    rows = {r for r, _ in filled}
   338	    cols = {c for _, c in filled}
   339	    if rows != set(range(h)) or cols != set(range(w)):
   340	        return None
   341	
   342	    non_anchor = [cell for cell in filled if cell != anchor_cell]
   343	    max_extra = min(SOURCE_EXTRA_COLORS_MAX, len(extra_palette), len(non_anchor) // 2)
   344	    if max_extra < SOURCE_EXTRA_COLORS_MIN:
   345	        return None
   346	
   347	    for _ in range(60):
   348	        n_extra = random.randint(SOURCE_EXTRA_COLORS_MIN, max_extra)
   349	        counts = [2] * n_extra
   350	        leftover = len(non_anchor) - 2 * n_extra
   351	        while leftover > 0:
   352	            counts[random.randrange(n_extra)] += 1
   353	            leftover -= 1
   354	
   355	        random.shuffle(non_anchor)
   356	        random.shuffle(extra_palette)
   357	        logical = np.full((h, w), BG, dtype=int)
   358	        logical[anchor_cell] = anchor_color
   359	
   360	        idx = 0
   361	        used_colors = extra_palette[:n_extra]
   362	        for color, count in zip(used_colors, counts, strict=False):
   363	            for cell in non_anchor[idx : idx + count]:
   364	                logical[cell] = color
   365	            idx += count
   366	
   367	        patch = np.repeat(np.repeat(logical, SOURCE_ANCHOR_SIZE, axis=0), SOURCE_ANCHOR_SIZE, axis=1)
   368	        if any(_is_square_component(patch, color) for color in used_colors):
