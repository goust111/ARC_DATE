   244	def main(grid: np.ndarray) -> np.ndarray:
   245	    """
   246	    Replicate the TL motif across quadrants, but make both source and targets follow anchor colors.
   247	
   248	    Input structure:
   249	    - The grid is split into four quadrants by one full-row/full-column divider of a
   250	      single non-background color.
   251	    - Each quadrant contains one solid square anchor block; anchor sizes vary and anchor
   252	      colors may differ across quadrants.
   253	    - The top-left quadrant also contains one multi-color motif attached to its 2x2 anchor.
