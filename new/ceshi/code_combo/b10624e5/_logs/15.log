   377	def _source_patch(anchor_color: int, forbidden_colors: set[int]) -> tuple[np.ndarray, int, int] | None:
   378	    """Build the TL motif as a 2x-upscaled logical pattern."""
   379	    extra_palette = [c for c in ANCHOR_COLOR_POOL if c not in forbidden_colors]
   380	    if len(extra_palette) < SOURCE_EXTRA_COLORS_MIN:
   381	        return None
   382	
   383	    lh, lw = random.choice(LOGICAL_DIMS)
   384	    n_cells = lh * lw
   385	    min_fill = max(5, int(np.ceil(FILL_RATIO_MIN * n_cells)))
   386	    max_fill = max(min_fill, int(np.floor(FILL_RATIO_MAX * n_cells)))
   387	    ar, ac = random.randrange(lh), random.randrange(lw)
   388	    filled = _grow_4conn(lh, lw, {(ar, ac)}, random.randint(min_fill, max_fill))
