   315	
   316	def _is_square_component(arr: np.ndarray, color: int) -> bool:
   317	    """True iff all pixels of `color` form one filled square component."""
   318	    comps = components_mask(arr == color, connectivity=4)
   319	    if len(comps) != 1:
   320	        return False
   321	    pts = comps[0]
   322	    r0, c0, r1, c1 = bbox_coords(pts)
   323	    h = r1 - r0 + 1
   324	    w = c1 - c0 + 1
   325	    return h == w and len(pts) == h * w
