+    anch_r1 = q_r1 - anchor_mask.shape[0] + 1 + mask_red_r0
+    anch_c0 = q_c0 + mask_red_c0
+    anch_c1 = q_c1 - anchor_mask.shape[1] + 1 + mask_red_c0
+    if anch_r0 > anch_r1 or anch_c0 > anch_c1:
