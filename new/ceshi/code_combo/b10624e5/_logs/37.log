+    coords = np.argwhere(patch != BG)
+    r0, c0, r1, c1 = bbox_coords(coords)
+    cropped = patch[r0 : r1 + 1, c0 : c1 + 1].copy()
+    red_r0, red_c0 = _red_bbox_topleft(cropped)
