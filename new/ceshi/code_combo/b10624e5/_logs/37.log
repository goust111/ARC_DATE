+
+def _extract_source_patch(
+    g: np.ndarray,
+    quads: dict[tuple[int, int], tuple[int, int, int, int]],
+    bg: int,
+) -> np.ndarray:
+    tl_r0, tl_r1, tl_c0, tl_c1 = quads[(0, 0)]
+    tl = g[tl_r0 : tl_r1 + 1, tl_c0 : tl_c1 + 1]
+    comps = components_mask(tl != bg, connectivity=4)
+    patch_bb = None
+    for pts in comps:
