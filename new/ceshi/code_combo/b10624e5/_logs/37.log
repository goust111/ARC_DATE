+    out: dict[tuple[int, int], tuple[int, int, int, int]] = {}
+    for key, pts in anchors.items():
+        arr = np.array(pts, dtype=int)
+        out[key] = bbox_coords(arr)
+    assert set(out) == set(quads), "each quadrant must contain red anchor pixels"
+    return out
