+    fit_r0 = q_r0 + patch_red_r0
+    fit_r1 = q_r1 - patch_s.shape[0] + 1 + patch_red_r0
+    fit_c0 = q_c0 + patch_red_c0
+    fit_c1 = q_c1 - patch_s.shape[1] + 1 + patch_red_c0
+
