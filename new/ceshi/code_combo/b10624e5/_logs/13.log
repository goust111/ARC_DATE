+    if metrics["diag_counterfactual_diff"] < 2:
+        return None
+    if metrics["source_crosses_hidden_axis"] != 1 or metrics["target_crosses_hidden_axis"] < 2:
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
