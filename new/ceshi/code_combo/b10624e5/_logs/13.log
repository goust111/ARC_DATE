+        ar, ac = anchors[region]
+        size = target_sizes[region]
+        paste(inp, np.full((size, size), RED, dtype=int), ar, ac)
+
+    try:
+        if not np.array_equal(main(inp), out):
+            return None
+        metrics = behavior_metrics(inp)
+    except Exception:
