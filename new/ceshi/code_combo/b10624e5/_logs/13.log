+
+BG = 4
+DIV = 1
+RED = 2
+GRID_SIZE = 27
+MID = GRID_SIZE // 2
+SOURCE_ANCHOR_SIZE = 2
+REGIONS = ("top", "right", "bottom", "left")
+TARGET_REGIONS = ("right", "bottom", "left")
+COLOR_POOL = [0, 3, 5, 6, 7, 8, 9]
+BLOCK_DIMS = [(2, 2), (2, 3), (3, 2), (3, 3)]
+BLOCK_PROB = 0.55
+FILL_RATIO_MIN = 0.5
+FILL_RATIO_MAX = 0.8
+FREEFORM_H_RANGE = (3, 6)
+FREEFORM_W_RANGE = (3, 6)
+MOTIF_COLORS_MIN = 3
+MOTIF_COLORS_MAX = 5
+TARGET_SIZE_RANGE = (1, 4)
