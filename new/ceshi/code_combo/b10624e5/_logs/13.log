+
+    inp = np.full((GRID_SIZE, GRID_SIZE), BG, dtype=int)
+    for i in range(GRID_SIZE):
+        inp[i, i] = DIV
+        inp[i, GRID_SIZE - 1 - i] = DIV
+    paste(inp, patch, src_top, src_left, transparent=BG)
