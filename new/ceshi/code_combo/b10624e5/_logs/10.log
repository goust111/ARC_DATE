+
+def _solve_full(grid: np.ndarray, *, erase_source: bool) -> np.ndarray:
+    """Construct the full 27x27 moved/cropped precursor before final cropping."""
+    g = np.asarray(grid, dtype=int)
+    out = g.copy()
