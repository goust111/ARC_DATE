+    for (qb, qr), (tr0, tc0, target_size) in anchors.items():
+        if (qb, qr) == (0, 0):
+            continue
+        patch_s = _transform_patch(patch, qb, qr, source_size, target_size)
+        _stamp_patch(out, patch_s, tr0, tc0, bg)
+
+    if erase_source:
+        _erase_source_nonred(out, patch, patch_bb, bg)
