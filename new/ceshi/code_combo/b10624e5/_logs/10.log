+        anchors[key] = chosen
+
+    full_out = _build_full_output(patch, target_sizes, anchors, tl_r0, tl_c0)
+    expected = full_out[MID + 1 :, MID + 1 :].copy()
+    if np.count_nonzero(expected != BG) <= target_sizes[TARGET_KEY] ** 2:
