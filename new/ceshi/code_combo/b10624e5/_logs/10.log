+def _choose_anchor(qb: int, qr: int, size: int, patch_s: np.ndarray) -> tuple[int, int] | None:
+    """Pick an anchor position whose transformed motif fully fits within its quadrant."""
+    q_r0, q_r1, q_c0, q_c1 = QUADS[(qb, qr)]
