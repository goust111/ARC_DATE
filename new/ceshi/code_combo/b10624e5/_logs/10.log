+    for rr0, cc0 in zip(rr_p.tolist(), cc_p.tolist(), strict=False):
+        rr_t = place_r0 + rr0
+        cc_t = place_c0 + cc0
+        if not (0 <= rr_t < dst.shape[0] and 0 <= cc_t < dst.shape[1]):
+            continue
+        if dst[rr_t, cc_t] == RED:
