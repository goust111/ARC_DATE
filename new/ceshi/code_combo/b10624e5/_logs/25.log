+    br_area_ratio = _quad_area(quads[(1, 1)]) / _quad_area(quads[(0, 0)])
+    br_shape = target_shapes[(1, 1)]
+    if not (abs(br_area_ratio - 1.0) < 1e-9 and br_shape != source_shape):
+        return None
