+def _grow_4conn(h: int, w: int, seeds: set[tuple[int, int]], n_fill: int) -> set[tuple[int, int]]:
+    """Grow a 4-connected region from seeds until it contains n_fill cells."""
+    filled = set(seeds)
+    frontier = set()
