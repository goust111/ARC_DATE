+    patch, anchor_r_in_patch, anchor_c_in_patch = source
+
+    scaled: dict[tuple[int, int], np.ndarray] = {}
+    target_shapes: dict[tuple[int, int], tuple[int, int]] = {(0, 0): source_shape}
+    for key, bounds in quads.items():
