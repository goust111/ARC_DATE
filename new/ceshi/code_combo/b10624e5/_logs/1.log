+
+    permuted_colors = random.sample(list(ANCHOR_COLORS), len(ANCHOR_COLORS))
+    target_colors = {key: color for key, color in zip(TARGET_KEYS, permuted_colors, strict=False)}
+    target_sizes = _target_sizes(target_colors)
