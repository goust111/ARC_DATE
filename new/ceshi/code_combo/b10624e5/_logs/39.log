+    if new_h <= 0 or new_w <= 0:
+        return img.copy()
+    rr = np.clip(np.floor(np.arange(new_h) * src_h / new_h).astype(int), 0, src_h - 1)
+    cc = np.clip(np.floor(np.arange(new_w) * src_w / new_w).astype(int), 0, src_w - 1)
+    return img[rr[:, None], cc[None, :]]
