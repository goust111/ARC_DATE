+    tgt_cc = src_cc + place_c0
+    valid = (
+        (tgt_rr >= 0)
+        & (tgt_rr < GRID_SIZE)
+        & (tgt_cc >= 0)
+        & (tgt_cc < GRID_SIZE)
+        & (tgt_rr != MID)
+        & (tgt_cc != MID)
