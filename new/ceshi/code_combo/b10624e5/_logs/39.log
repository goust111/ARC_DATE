+    ar0, ac0 = int(rr_red.min()), int(cc_red.min())
+    sig: dict[tuple[int, int], int] = {}
+    rr, cc = np.where((patch_s != bg) & (patch_s != red))
+    for r, c in zip(rr.tolist(), cc.tolist(), strict=False):
