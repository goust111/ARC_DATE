+def _build_output(
+    patch: np.ndarray,
+    tl_r0: int,
+    tl_c0: int,
+    target_sizes: dict[tuple[int, int], int],
+    anchors: dict[tuple[int, int], tuple[int, int]],
+    transformed: dict[tuple[int, int], np.ndarray],
+) -> np.ndarray:
+    out = np.full((GRID_SIZE, GRID_SIZE), BG, dtype=int)
+    out[MID, :] = DIV
+    out[:, MID] = DIV
