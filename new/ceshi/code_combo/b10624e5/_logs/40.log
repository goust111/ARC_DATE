+# Combo variant of b10624e5 (index 40)
+# combo_spec: D9/1+D13/3
+# Name: 图案位置由锚块朝向决定 + L形锚块
+
+import random
+
+import numpy as np
+
+from arc_utils import bbox_coords, components_mask, get_bg, paste
