+    assert patch_bb is not None, "top-left quadrant must contain a non-bg component with red pixels"
+    pr0, pc0, pr1, pc1 = patch_bb
+    patch = tl[pr0 : pr1 + 1, pc0 : pc1 + 1].copy()
+
+    for (qb, qr), target_pts in anchors.items():
+        if (qb, qr) == (0, 0):
