+    if motif.size == 0:
+        return False
+    red = np.argwhere(patch == RED)
+    ar0, ac0, ar1, ac1 = bbox_coords(red)
+    mr0, mc0, mr1, mc1 = bbox_coords(motif)
+    if key[0] == 0:
+        if mr0 >= ar0:
+            return False
+    else:
+        if mr1 <= ar1:
+            return False
+    if key[1] == 0:
+        if mc0 >= ac0:
+            return False
+    else:
+        if mc1 <= ac1:
+            return False
