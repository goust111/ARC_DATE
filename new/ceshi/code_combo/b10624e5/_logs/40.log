+        anchors[key] = pts
+
+    assert set(anchors) == {(0, 0), (0, 1), (1, 0), (1, 1)}, "expected one red anchor per quadrant"
+
+    tl = g[:mid_r, :mid_c]
+    patch_bb = None
+    for pts in components_mask(tl != bg, connectivity=4):
+        if any(tl[r, c] == 2 for r, c in pts):
+            patch_bb = bbox_coords(pts)
