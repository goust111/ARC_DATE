+# --------------- generator ---------------
+
+BG = 4
+DIV = 1
+RED = 2
+GRID_SIZE = 27
+MID = 13
+QUADS = {
+    (0, 0): (0, 12, 0, 12),
+    (0, 1): (0, 12, 14, 26),
+    (1, 0): (14, 26, 0, 12),
+    (1, 1): (14, 26, 14, 26),
+}
+
+SOURCE_NOMINAL_SIZE = 2
+ALLOWED_SIZES = (1, 2, 3, 4)
+GEN_TARGET_SIZES = (2, 3, 4)
+MOTIF_H_RANGE = (2, 4)
