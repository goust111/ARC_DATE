+            (0, 0): SOURCE_NOMINAL_SIZE,
+            (0, 1): random.choice(ALLOWED_SIZES),
+            (1, 0): random.choice(ALLOWED_SIZES),
+            (1, 1): random.choice(ALLOWED_SIZES),
