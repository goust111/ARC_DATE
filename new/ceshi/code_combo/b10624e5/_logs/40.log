+
+def _sample_target_sizes() -> dict[tuple[int, int], int]:
+    while True:
+        sizes = {
+            (0, 0): SOURCE_NOMINAL_SIZE,
+            (0, 1): random.choice(GEN_TARGET_SIZES),
+            (1, 0): random.choice(GEN_TARGET_SIZES),
+            (1, 1): random.choice(GEN_TARGET_SIZES),
+        }
+        non_tl = [sizes[(0, 1)], sizes[(1, 0)], sizes[(1, 1)]]
+        if len(set(non_tl)) >= 2 and any(s != SOURCE_NOMINAL_SIZE for s in non_tl):
