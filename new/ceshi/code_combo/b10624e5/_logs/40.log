+        target_r0, target_c0, _tr1, _tc1 = bbox_coords(target_pts)
+        matched_patch = None
+
+        for nominal_size in ALLOWED_SIZES:
+            patch_s = _transform_patch(patch, qb, qr, nominal_size, SOURCE_NOMINAL_SIZE)
+            red_pts = np.argwhere(patch_s == RED)
+            if red_pts.size == 0:
