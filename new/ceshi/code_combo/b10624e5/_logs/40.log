+    max_c0 = q_c1 - patch.shape[1] + 1
+    assert max_r0 >= q_r0 and max_c0 >= q_c0, "patch must fit inside the quadrant"
+    return random.randint(q_r0, max_r0), random.randint(q_c0, max_c0)
