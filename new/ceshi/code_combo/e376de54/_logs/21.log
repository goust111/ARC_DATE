85:
86:def _dot(p: tuple[int, int], d: tuple[int, int]) -> int:
87:    return p[0] * d[0] + p[1] * d[1]
88:
89:
90:def _perp_dot(p: tuple[int, int], d: tuple[int, int]) -> int:
91:    return p[0] * d[1] - p[1] * d[0]
92:
93:
94:def _step(d: tuple[int, int]) -> int:
95:    dr, dc = d
96:    return dr * dr + dc * dc
97:
98:
99:def _cell_from_ts(d: tuple[int, int], t: int, s: int) -> tuple[int, int] | None:
100:    if d == (0, 1):
101:        r, c = s, t
102:    elif d == (1, 0):
103:        r, c = t, -s
104:    elif d == (1, 1):
105:        if (t + s) % 2 or (t - s) % 2:
106:            return None
107:        r, c = (t + s) // 2, (t - s) // 2
108:    else:
109:        if (t - s) % 2 or (-s - t) % 2:
110:            return None
111:        r, c = (t - s) // 2, (-s - t) // 2
112:    if 0 <= r < _H and 0 <= c < _W:
113:        return r, c
114:    return None
115:
116:
117:def _segment_cells(d: tuple[int, int], t0: int, s: int, length: int) -> list[tuple[int, int]] | None:
118:    delta = _step(d)
119:    cells = []
120:    for k in range(length):
121:        cell = _cell_from_ts(d, t0 + k * delta, s)
122:        if cell is None:
123:            return None
124:        cells.append(cell)
125:    return cells
126:
127:
128:def _extract_segments(g: np.ndarray, d: tuple[int, int], bg: int) -> list[dict]:
129:    h, w = g.shape
130:    dr, dc = d
131:    segments = []
132:    colors = [int(c) for c in np.unique(g) if int(c) != bg]
133:    for col in colors:
134:        mask = g == col
135:        for r in range(h):
136:            for c in range(w):
137:                if not mask[r, c]:
138:                    continue
139:                pr, pc = r - dr, c - dc
140:                if 0 <= pr < h and 0 <= pc < w and mask[pr, pc]:
141:                    continue
142:                cells = []
143:                rr, cc = r, c
144:                while 0 <= rr < h and 0 <= cc < w and mask[rr, cc]:
145:                    cells.append((rr, cc))
146:                    rr += dr
147:                    cc += dc
148:                if len(cells) < 2:
149:                    continue
150:                start = cells[0]
151:                end = cells[-1]
152:                segments.append(
153:                    {
154:                        "color": col,
155:                        "cells": cells,
156:                        "start": start,
157:                        "end": end,
158:                        "t_start": _dot(start, d),
159:                        "t_end": _dot(end, d),
160:                        "s": _perp_dot(start, d),
161:                        "len": len(cells),
162:                    }
163:                )
164:    return segments
