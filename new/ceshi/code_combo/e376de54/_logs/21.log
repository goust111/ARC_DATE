167:def main(grid: np.ndarray) -> np.ndarray:
168:    """
169:    Normalize a band of parallel colored segments so they share one reference length and become evenly spaced.
170:
171:    Input structure:
172:    - The background is the most frequent color.
173:    - There are 3 or 5 multi-cell segments, all parallel and all lying on distinct perpendicular offsets.
174:    - Their perpendicular gaps are intentionally uneven in the input, while their lengths and aligned endpoint may vary.
175:
176:    Rule:
177:    - Detect the common direction and sort the segments by perpendicular offset.
178:    - Use the median-by-offset segment as the length reference: every output segment adopts that segment's start and end
179:      coordinates along the main direction.
180:    - Keep the ordered outer span of the segment band, but redistribute the offsets into equal spacing from the first
181:      line to the last line.
182:    - Redraw each segment at its new offset with the reference length; isolated single pixels stay unchanged.
183:
184:    Key insight: The central line still defines the shared extent, but the output is no longer obtained by sliding only
185:    along the segment direction; the whole stack is re-laid onto an evenly spaced arithmetic progression of offsets.
186:    """
187:    g = np.asarray(grid, dtype=int)
188:    h, w = g.shape
189:    bg = _get_bg(g)
190:
191:    d = _pick_main_dir(g, bg)
192:    delta_t = _step(d)
193:    segments = _extract_segments(g, d, bg)
194:    assert segments, "at least one multi-cell segment must exist"
195:
196:    segments = sorted(segments, key=lambda s: s["s"])
197:    s_vals = [s["s"] for s in segments]
198:    assert len(s_vals) % 2 == 1, "segment count must have a single median"
199:    assert len(s_vals) == len(set(s_vals)), "segment line coordinates must be unique"
200:
201:    span = s_vals[-1] - s_vals[0]
202:    assert span > 0, "need at least two distinct offsets"
203:    assert span % (len(s_vals) - 1) == 0, "outer span must support equal spacing"
204:    gap = span // (len(s_vals) - 1)
205:    if delta_t == 2:
206:        assert gap % 2 == 0, "diagonal equal gap must preserve parity"
207:
208:    ref = segments[len(segments) // 2]
209:    ref_t0, ref_t1 = ref["t_start"], ref["t_end"]
210:    assert ref_t1 >= ref_t0, "traced segment coordinates must increase"
211:    assert (ref_t1 - ref_t0) % delta_t == 0, "reference segment length must align with delta_t"
212:    target_len = (ref_t1 - ref_t0) // delta_t + 1
213:    target_s_vals = [s_vals[0] + i * gap for i in range(len(segments))]
214:
215:    out = g.copy()
216:    for s in segments:
217:        for r, c in s["cells"]:
218:            out[r, c] = bg
219:
220:    for seg, target_s in zip(segments, target_s_vals):
221:        t = ref_t0
222:        for _ in range(target_len):
223:            cell = _cell_from_ts(d, t, target_s)
224:            assert cell is not None, "equalized segment must stay in bounds"
225:            rr, cc = cell
226:            assert 0 <= rr < h and 0 <= cc < w
227:            out[rr, cc] = seg["color"]
228:            t += delta_t
229:
230:    return out
231:
232:
233:# --------------- generator (o5x) ---------------
234:
235:# --- Canvas ---
236:_H, _W = 16, 16
237:_BG = 7
238:
239:# --- Directions and colors ---
240:_DIRS = [(0, 1), (1, 0), (1, 1), (1, -1)]
241:_COLORS = [1, 2, 3, 5, 6, 8, 9]
242:
243:# --- Segment counts and reference length ---
244:_SEGMENT_COUNTS = [3, 5]
245:_REF_LEN_RANGE = (3, 8)
246:_MAX_SEG_LEN = 12
247:
248:# --- Equal output spacing choices ---
249:_ORTHO_EQUAL_GAPS = {3: [3, 4, 5, 6], 5: [3]}
250:_DIAG_EQUAL_GAPS = {3: [6], 5: [6]}
251:
252:# --- Input minimum gaps ---
253:_MIN_GAP_ORTHO = 2
254:_MIN_GAP_DIAG = 4
255:
256:# --- Color assignment ---
257:_MAX_DISTINCT_COLORS = 3
258:_SAME_LEN_AVOID_PROB = 0.75
259:
260:# --- Search / retry ---
261:_T_SCAN_RANGE = (-30, 31)
262:_GEN_RETRIES = 400
263:
264:
265:def _max_len_from(d: tuple[int, int], t0: int, s: int) -> int:
266:    length = 0
267:    while _cell_from_ts(d, t0 + length * _step(d), s) is not None:
268:        length += 1
269:    return length
270:
271:
272:def _max_len_to(d: tuple[int, int], t1: int, s: int) -> int:
273:    length = 0
274:    while _cell_from_ts(d, t1 - length * _step(d), s) is not None:
275:        length += 1
276:    return length
277:
278:
279:def _s_limits(d: tuple[int, int]) -> tuple[int, int]:
280:    if d == (0, 1):
281:        return 0, 15
282:    if d == (1, 0):
283:        return -15, 0
284:    if d == (1, 1):
285:        return -15, 15
286:    return -30, 0
287:
288:
289:def _equal_gap_choices(d: tuple[int, int], n: int) -> list[int]:
290:    if d in [(1, 1), (1, -1)]:
291:        return _DIAG_EQUAL_GAPS[n]
292:    return _ORTHO_EQUAL_GAPS[n]
293:
294:
295:def _min_gap(d: tuple[int, int]) -> int:
296:    return _MIN_GAP_DIAG if d in [(1, 1), (1, -1)] else _MIN_GAP_ORTHO
297:
298:
299:def _gap_unit(d: tuple[int, int]) -> int:
300:    return 2 if d in [(1, 1), (1, -1)] else 1
301:
302:
303:def _choose_output_offsets(d: tuple[int, int], n: int) -> tuple[int, ...]:
304:    lo, hi = _s_limits(d)
305:    gap = random.choice(_equal_gap_choices(d, n))
306:    span = (n - 1) * gap
307:    s0 = random.randint(lo, hi - span)
308:    return tuple(s0 + i * gap for i in range(n))
309:
310:
311:def _choose_irregular_gaps(d: tuple[int, int], n: int, equal_gap: int) -> list[int]:
312:    min_gap = _min_gap(d)
313:    unit = _gap_unit(d)
314:    base = [equal_gap] * (n - 1)
315:    for _ in range(200):
316:        gaps = base.copy()
317:        moves = 1 if n == 3 else random.randint(1, 3)
318:        for _ in range(moves):
319:            donors = [i for i, g in enumerate(gaps) if g - unit >= min_gap]
320:            if not donors:
321:                break
322:            donor = random.choice(donors)
323:            receiver_choices = [i for i in range(len(gaps)) if i != donor]
324:            receiver = random.choice(receiver_choices)
325:            gaps[donor] -= unit
326:            gaps[receiver] += unit
327:        if len(set(gaps)) > 1 and min(gaps) >= min_gap and sum(gaps) == (n - 1) * equal_gap:
328:            return gaps
329:    raise RuntimeError("failed to build irregular gaps")
330:
331:
332:def _choose_input_offsets(d: tuple[int, int], s_out: tuple[int, ...]) -> tuple[int, ...]:
333:    gaps = _choose_irregular_gaps(d, len(s_out), s_out[1] - s_out[0])
334:    s_vals = [s_out[0]]
335:    for gap in gaps:
336:        s_vals.append(s_vals[-1] + gap)
337:    assert s_vals[-1] == s_out[-1]
338:    assert tuple(s_vals) != tuple(s_out)
339:    return tuple(s_vals)
340:
341:
342:def _feasible_placements(
343:    d: tuple[int, int], input_s_vals: tuple[int, ...], output_s_vals: tuple[int, ...], ref_len: int
344:) -> list[tuple[int, str, list[int]]]:
345:    delta = _step(d)
346:    ref_idx = len(input_s_vals) // 2
347:    placements = []
348:    all_s_vals = sorted(set(input_s_vals) | set(output_s_vals))
349:    for t0 in range(*_T_SCAN_RANGE):
350:        if any(_segment_cells(d, t0, s, ref_len) is None for s in all_s_vals):
351:            continue
352:        t1 = t0 + (ref_len - 1) * delta
353:        start_caps = [_max_len_from(d, t0, s) for s in input_s_vals]
354:        if any(start_caps[i] > ref_len for i in range(len(input_s_vals)) if i != ref_idx):
355:            placements.append((t0, "start", start_caps))
356:        end_caps = [_max_len_to(d, t1, s) for s in input_s_vals]
357:        if any(end_caps[i] > ref_len for i in range(len(input_s_vals)) if i != ref_idx):
358:            placements.append((t0, "end", end_caps))
359:    return placements
360:
361:
362:def _choose_colors(n: int) -> tuple[int, ...]:
363:    n_colors = random.randint(1, min(_MAX_DISTINCT_COLORS, n))
364:    palette = random.sample(_COLORS, n_colors)
365:    colors = [random.choice(palette) for _ in range(n)]
366:    while len(set(colors)) < n_colors:
367:        colors[random.randrange(n)] = random.choice(palette)
368:    return tuple(colors)
369:
370:
371:def _choose_lengths(ref_len: int, caps: list[int], n: int) -> list[int] | None:
372:    ref_idx = n // 2
373:    lengths = [ref_len] * n
374:    nonrefs = [i for i in range(n) if i != ref_idx]
375:    longable = [i for i in nonrefs if caps[i] > ref_len]
376:    if not longable:
377:        return None
378:
379:    long_i = random.choice(longable)
380:    short_i = random.choice([i for i in nonrefs if i != long_i])
381:    lengths[long_i] = random.randint(ref_len + 1, min(_MAX_SEG_LEN, caps[long_i]))
382:    lengths[short_i] = random.randint(2, ref_len - 1)
383:
384:    for i in nonrefs:
385:        if i in (long_i, short_i):
386:            continue
387:        options = list(range(2, min(_MAX_SEG_LEN, caps[i]) + 1))
388:        if len(options) > 1 and ref_len in options and random.random() < _SAME_LEN_AVOID_PROB:
389:            options.remove(ref_len)
390:        lengths[i] = random.choice(options)
391:    return lengths
392:
393:
394:def _paint(
395:    grid: np.ndarray,
396:    d: tuple[int, int],
397:    s_vals: tuple[int, ...],
398:    starts: list[int],
399:    lengths: list[int],
400:    colors: tuple[int, ...],
401:) -> bool:
402:    for s, t0, length, color in zip(s_vals, starts, lengths, colors):
403:        cells = _segment_cells(d, t0, s, length)
404:        if cells is None:
405:            return False
406:        for r, c in cells:
407:            grid[r, c] = color
408:    return True
409:
410:
411:def _gen_attempt() -> np.ndarray | None:
412:    d = random.choice(_DIRS)
413:    n = random.choice(_SEGMENT_COUNTS)
414:    ref_len = random.randint(*_REF_LEN_RANGE)
415:
416:    s_out = _choose_output_offsets(d, n)
417:    s_in = _choose_input_offsets(d, s_out)
418:    placements = _feasible_placements(d, s_in, s_out, ref_len)
419:    if not placements:
420:        return None
421:
422:    t0, anchor, caps = random.choice(placements)
423:    colors = _choose_colors(n)
424:    lengths = _choose_lengths(ref_len, caps, n)
425:    if lengths is None:
426:        return None
427:
428:    out = np.full((_H, _W), _BG, dtype=int)
429:    if not _paint(out, d, s_out, [t0] * n, [ref_len] * n, colors):
430:        return None
431:
432:    delta = _step(d)
433:    t1 = t0 + (ref_len - 1) * delta
434:    if anchor == "start":
435:        starts = [t0] * n
436:    else:
437:        starts = [t1 - (length - 1) * delta for length in lengths]
438:
439:    inp = np.full((_H, _W), _BG, dtype=int)
440:    if not _paint(inp, d, s_in, starts, lengths, colors):
441:        return None
442:
443:    try:
444:        if np.array_equal(main(inp), out):
445:            return inp
446:    except Exception:
447:        return None
448:    return None
449:
450:
451:def generate_input() -> np.ndarray:
452:    for _ in range(_GEN_RETRIES):
453:        grid = _gen_attempt()
454:        if grid is not None:
455:            return grid
456:    raise RuntimeError("failed to generate valid input")

