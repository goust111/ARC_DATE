59:
60:def _get_bg(grid: np.ndarray) -> int:
61:    return int(Counter(map(int, grid.flatten())).most_common(1)[0][0])
62:
63:
64:def _pick_main_dir(g: np.ndarray, bg: int) -> tuple[int, int]:
65:    counts = []
66:    h, w = g.shape
67:    for dr, dc in _DIR_CANDIDATES:
68:        cnt = 0
69:        for r in range(h):
70:            for c in range(w):
71:                v = int(g[r, c])
72:                if v == bg:
73:                    continue
74:                rr, cc = r + dr, c + dc
75:                if 0 <= rr < h and 0 <= cc < w and int(g[rr, cc]) == v:
76:                    cnt += 1
77:        counts.append(((dr, dc), cnt))
78:
79:    best_cnt = max(cnt for _, cnt in counts)
80:    assert best_cnt > 0, "main direction must be detectable"
81:    best_dirs = [d for d, cnt in counts if cnt == best_cnt]
82:    assert len(best_dirs) == 1, "main direction must be unique"
83:    return best_dirs[0]
