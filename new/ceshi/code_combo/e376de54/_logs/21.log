44:    Input structure:
45:    - bg = most common color.
46:    - Several parallel line segments (diagonal, horizontal, or vertical), each a different color, running in the same direction but starting/ending at different positions.
47:
48:    Rule:
49:    - Detect the dominant direction shared by all segments.
50:    - Pick the median segment (by perpendicular offset) as the reference.
51:    - Shift every segment along the shared direction so its start aligns with the reference's start, then trim or extend it to match the reference's length.
52:    - Grid size stays the same; isolated single pixels are untouched.
53:
54:    Key insight: The reference is the median line, not the longest; all segments are snapped to its extent regardless of their original length.
55:    """
56:    g = np.asarray(grid, dtype=int)
57:    h, w = g.shape
58:    bg = get_bg(g)
59:
60:    d = _pick_main_dir(g, bg)
61:    dr, dc = d
62:    delta_t = dr * dr + dc * dc
63:
64:    segments = []
65:
66:    colors = [int(c) for c in np.unique(g) if int(c) != bg]
67:    for col in colors:
68:        mask = g == col
69:        for r in range(h):
70:            for c in range(w):
71:                if not mask[r, c]:
72:                    continue
73:                pr, pc = r - dr, c - dc
74:                if 0 <= pr < h and 0 <= pc < w and mask[pr, pc]:
75:                    continue  # not a segment start
76:                cells = []
77:                rr, cc = r, c
78:                while 0 <= rr < h and 0 <= cc < w and mask[rr, cc]:
79:                    cells.append((rr, cc))
80:                    rr += dr
81:                    cc += dc
82:                if len(cells) < 2:
83:                    continue
84:                start = cells[0]
85:                end = cells[-1]
86:                segments.append(
87:                    {
88:                        "color": col,
89:                        "cells": cells,
90:                        "start": start,
91:                        "end": end,
92:                        "t_start": _dot(start, d),
93:                        "t_end": _dot(end, d),
94:                        "s": _perp_dot(start, d),
95:                        "len": len(cells),
96:                    }
97:                )
98:
99:    assert segments, "at least one multi-cell segment must exist"
100:
101:    # Pick the reference segment as the one whose line coordinate (perpendicular dot) is the median.
102:    s_vals = sorted(s["s"] for s in segments)
103:    if delta_t == 2:  # diagonal direction
104:        for i in range(len(s_vals) - 1):
105:            assert s_vals[i + 1] - s_vals[i] >= 4
106:    assert len(s_vals) % 2 == 1, "segment count must have a single median"
107:    assert len(s_vals) == len(set(s_vals)), "segment line coordinates must be unique"
108:    s_ref = s_vals[len(s_vals) // 2]
109:    ref_cands = [s for s in segments if s["s"] == s_ref]
110:    assert len(ref_cands) == 1, "median reference segment must be unique"
111:    ref = ref_cands[0]
112:    ref_t0, ref_t1 = ref["t_start"], ref["t_end"]
113:    assert ref_t1 >= ref_t0, "traced segment coordinates must increase"
114:    assert (ref_t1 - ref_t0) % delta_t == 0, "reference segment length must align with delta_t"
115:    target_len = (ref_t1 - ref_t0) // delta_t + 1
116:
117:    out = g.copy()
118:
119:    # Clear only the original segment pixels (leave isolated pixels unchanged).
120:    for s in segments:
121:        for r, c in s["cells"]:
122:            out[r, c] = bg
123:
124:    for s in segments:
125:        col = s["color"]
126:        start = s["start"]
127:        # Shift the segment along the main direction so its start aligns to ref_t0,
128:        # then draw exactly target_len cells.
129:        dt = ref_t0 - s["t_start"]
130:        assert dt % delta_t == 0, "segment shift must be aligned to delta_t"
131:        k = dt // delta_t
132:        r0 = start[0] + k * dr
133:        c0 = start[1] + k * dc
134:        rr, cc = r0, c0
135:        for _ in range(target_len):
136:            assert 0 <= rr < h and 0 <= cc < w, "shifted segment must stay in bounds"
137:            out[rr, cc] = col
138:            rr += dr
139:            cc += dc
140:
141:    return out
142:
143:# --------------- generator (o5x) ---------------
144:
145:# --- Canvas ---
146:_H, _W = 16, 16
147:_BG = 7
148:
149:# --- Directions and colors ---
150:_DIRS = [(0, 1), (1, 0), (1, 1), (1, -1)]
151:_COLORS = [1, 2, 3, 5, 6, 8, 9]
152:
153:# --- Segment counts and reference length ---
154:_SEGMENT_COUNTS = [3, 5]           # must be odd for unique median
155:_REF_LEN_RANGE = (3, 8)            # inclusive bounds for reference segment length
156:_MAX_SEG_LEN = 12                  # upper bound for any individual segment
157:
158:# --- Perpendicular gap constraints ---
159:_PERP_GAP_ORTHO = [2, 3, 4, 5, 6]  # allowed gaps for orthogonal directions
160:_PERP_GAP_DIAG = [4, 6]             # allowed gaps for diagonal directions (spec: >= 4)
161:
162:# --- Color assignment ---
163:_MAX_DISTINCT_COLORS = 3            # upper bound on distinct non-bg colors per puzzle
164:_SAME_LEN_AVOID_PROB = 0.75         # probability of avoiding ref_len for remaining segments
165:
166:# --- Search / retry ---
167:_T_SCAN_RANGE = (-30, 31)           # range(lo, hi) for feasible t0 search
168:_GEN_RETRIES = 300                  # max attempts before raising
169:
170:
171:def _step(d):
172:    """Dot product of direction with itself (1 for ortho, 2 for diag)."""
173:    dr, dc = d
174:    return dr * dr + dc * dc
175:
176:
177:def _cell_from_ts(d, t, s):
178:    """Convert (t, s) coordinates back to (row, col) for direction d. Returns None if out of bounds."""
179:    if d == (0, 1):
180:        r, c = s, t
181:    elif d == (1, 0):
182:        r, c = t, -s
183:    elif d == (1, 1):
184:        if (t + s) % 2 or (t - s) % 2:
185:            return None
186:        r, c = (t + s) // 2, (t - s) // 2
187:    else:
188:        if (t - s) % 2 or (-s - t) % 2:
189:            return None
190:        r, c = (t - s) // 2, (-s - t) // 2
191:    if 0 <= r < _H and 0 <= c < _W:
192:        return r, c
193:    return None
194:
195:
196:def _segment_cells(d, t0, s, length):
197:    """Return list of (r, c) for a segment starting at t0 with given perpendicular offset s, or None if any cell is OOB."""
198:    delta = _step(d)
199:    cells = []
200:    for k in range(length):
201:        cell = _cell_from_ts(d, t0 + k * delta, s)
202:        if cell is None:
203:            return None
204:        cells.append(cell)
205:    return cells
206:
207:
208:def _max_len_from(d, t0, s):
209:    """Max segment length extending forward from t0 at perpendicular offset s."""
210:    delta = _step(d)
211:    length = 0
212:    while _cell_from_ts(d, t0 + length * delta, s) is not None:
213:        length += 1
214:    return length
215:
216:
217:def _max_len_to(d, t1, s):
218:    """Max segment length extending backward from t1 at perpendicular offset s."""
219:    delta = _step(d)
220:    length = 0
221:    while _cell_from_ts(d, t1 - length * delta, s) is not None:
222:        length += 1
223:    return length
224:
225:
226:def _s_limits(d):
227:    """Valid range (lo, hi) inclusive for perpendicular offset s given direction d."""
228:    if d == (0, 1):
229:        return 0, 15
230:    if d == (1, 0):
231:        return -15, 0
232:    if d == (1, 1):
233:        return -15, 15
234:    return -30, 0
235:
236:
237:def _gap_patterns(d, n):
238:    """Enumerate all valid perpendicular gap sequences of length n-1, ensuring irregular spacing."""
239:    allowed = _PERP_GAP_DIAG if d in [(1, 1), (1, -1)] else _PERP_GAP_ORTHO
240:    lo, hi = _s_limits(d)
241:    max_span = hi - lo
242:    patterns = [[]]
243:    for _ in range(n - 1):
244:        patterns = [p + [g] for p in patterns for g in allowed]
245:    return [
246:        p
247:        for p in patterns
248:        if sum(p) <= max_span and (n == 3 and p[0] != p[1] or n == 5 and len(set(p)) > 1)
249:    ]
250:
251:
252:def _choose_offsets(d, n):
253:    """Pick n distinct perpendicular offsets with irregular gaps."""
254:    lo, hi = _s_limits(d)
255:    gaps = random.choice(_gap_patterns(d, n))
256:    s0 = random.randint(lo, hi - sum(gaps))
257:    s_vals = [s0]
258:    for gap in gaps:
259:        s_vals.append(s_vals[-1] + gap)
260:    return tuple(s_vals)
261:
262:
263:def _feasible_placements(d, s_vals, ref_len):
264:    """Find all (t0, anchor_mode, capacity_list) where segments can be placed with room for length variation."""
265:    delta = _step(d)
266:    ref_idx = len(s_vals) // 2
267:    placements = []
268:    for t0 in range(*_T_SCAN_RANGE):
269:        if any(_segment_cells(d, t0, s, ref_len) is None for s in s_vals):
270:            continue
271:        t1 = t0 + (ref_len - 1) * delta
272:        start_caps = [_max_len_from(d, t0, s) for s in s_vals]
273:        if any(start_caps[i] > ref_len for i in range(len(s_vals)) if i != ref_idx):
274:            placements.append((t0, "start", start_caps))
275:        end_caps = [_max_len_to(d, t1, s) for s in s_vals]
276:        if any(end_caps[i] > ref_len for i in range(len(s_vals)) if i != ref_idx):
277:            placements.append((t0, "end", end_caps))
278:    return placements
279:
280:
281:def _choose_colors(s_vals):
282:    """Assign 1-3 distinct non-bg colors across segments, ensuring all chosen colors appear."""
283:    n_colors = random.randint(1, min(_MAX_DISTINCT_COLORS, len(s_vals)))
284:    palette = random.sample(_COLORS, n_colors)
285:    colors = [random.choice(palette) for _ in s_vals]
286:    while len(set(colors)) < n_colors:
287:        colors[random.randrange(len(colors))] = random.choice(palette)
288:    return tuple(colors)
289:
290:
291:def _choose_lengths(ref_len, caps, n):
292:    """Choose input segment lengths: at least one shorter and one longer than ref_len. Returns None if infeasible."""
293:    ref_idx = n // 2
294:    lengths = [ref_len] * n
295:    nonrefs = [i for i in range(n) if i != ref_idx]
296:    longable = [i for i in nonrefs if caps[i] > ref_len]
297:    if not longable:
298:        return None
299:
300:    long_i = random.choice(longable)
301:    short_i = random.choice([i for i in nonrefs if i != long_i])
302:    lengths[long_i] = random.randint(ref_len + 1, min(_MAX_SEG_LEN, caps[long_i]))
303:    lengths[short_i] = random.randint(2, ref_len - 1)
304:
305:    for i in nonrefs:
306:        if i in (long_i, short_i):
307:            continue
308:        options = list(range(2, min(_MAX_SEG_LEN, caps[i]) + 1))
309:        if len(options) > 1 and ref_len in options and random.random() < _SAME_LEN_AVOID_PROB:
310:            options.remove(ref_len)
311:        lengths[i] = random.choice(options)
312:    return lengths
313:
314:
315:def _paint(grid, d, s_vals, starts, lengths, colors):
316:    """Render segments onto grid. Returns False if any segment cell is OOB."""
317:    for s, t0, length, color in zip(s_vals, starts, lengths, colors):
318:        cells = _segment_cells(d, t0, s, length)
319:        if cells is None:
320:            return False
321:        for r, c in cells:
322:            grid[r, c] = color
323:    return True
324:
325:
326:def _gen_attempt():
327:    """Build one candidate (input, output) pair; returns input grid or None on failure."""
328:    d = random.choice(_DIRS)
329:    n = random.choice(_SEGMENT_COUNTS)
330:    ref_len = random.randint(*_REF_LEN_RANGE)
331:    s_vals = _choose_offsets(d, n)
332:    placements = _feasible_placements(d, s_vals, ref_len)
333:    if not placements:
334:        return None
335:
336:    t0, anchor, caps = random.choice(placements)
337:    colors = _choose_colors(s_vals)
338:    lengths = _choose_lengths(ref_len, caps, n)
339:    if lengths is None:
340:        return None
341:
342:    # Build expected output: all segments at ref_len starting at t0
343:    out = np.full((_H, _W), _BG, dtype=int)
344:    if not _paint(out, d, s_vals, [t0] * n, [ref_len] * n, colors):
345:        return None
346:
347:    # Build input: anchor one end, vary lengths
348:    delta = _step(d)
349:    t1 = t0 + (ref_len - 1) * delta
350:    if anchor == "start":
351:        starts = [t0] * n
352:    else:
353:        starts = [t1 - (length - 1) * delta for length in lengths]
354:
355:    inp = np.full((_H, _W), _BG, dtype=int)
356:    if not _paint(inp, d, s_vals, starts, lengths, colors):
357:        return None
358:
359:    try:
360:        if np.array_equal(main(inp), out):
361:            return inp
362:    except Exception:
363:        return None
364:    return None
365:
366:
367:def generate_input():
368:    for _ in range(_GEN_RETRIES):
369:        grid = _gen_attempt()
370:        if grid is not None:
371:            return grid
372:    raise RuntimeError("failed to generate valid input")

