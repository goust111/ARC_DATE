+# --------------- generator (o5x) ---------------
+
+# --- Canvas ---
+_H, _W = 16, 16
+_BG = 7
+
+# --- Directions and colors ---
+_DIRS = [(0, 1), (1, 0), (1, 1), (1, -1)]
+_COLORS = [1, 2, 3, 5, 6, 8, 9]
+
+# --- Segment counts and reference length ---
+_SEGMENT_COUNTS = [3, 5]
+_REF_LEN_RANGE = (3, 8)
+_MAX_SEG_LEN = 12
+
+# --- Perpendicular gap constraints ---
+_PERP_GAP_ORTHO = [2, 3, 4, 5, 6]
+_PERP_GAP_DIAG = [4, 6]
+
+# --- Staircase controls ---
+_START_GAP_OPTIONS = [1, 2, 3]
+
+# --- Color assignment ---
+_MAX_DISTINCT_COLORS = 3
+_SAME_LEN_AVOID_PROB = 0.75
+
+# --- Search / retry ---
+_T_SCAN_RANGE = (-30, 31)
+_GEN_RETRIES = 500
+
+
+def _step(d):
+    """Dot product of direction with itself (1 for ortho, 2 for diag)."""
+    dr, dc = d
+    return dr * dr + dc * dc
+
+
+def _cell_from_ts(d, t, s):
+    """Convert (t, s) coordinates back to (row, col) for direction d. Returns None if out of bounds."""
+    if d == (0, 1):
+        r, c = s, t
+    elif d == (1, 0):
+        r, c = t, -s
+    elif d == (1, 1):
+        if (t + s) % 2 or (t - s) % 2:
+            return None
+        r, c = (t + s) // 2, (t - s) // 2
+    else:
+        if (t - s) % 2 or (-s - t) % 2:
+            return None
+        r, c = (t - s) // 2, (-s - t) // 2
