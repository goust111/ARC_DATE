+def _extract_segments(g: np.ndarray, bg: int, d: tuple[int, int]) -> list[dict]:
+    h, w = g.shape
+    dr, dc = d
+    segments = []
+    colors = [int(c) for c in np.unique(g) if int(c) != bg]
+    for col in colors:
+        mask = g == col
+        for r in range(h):
+            for c in range(w):
+                if not mask[r, c]:
+                    continue
+                pr, pc = r - dr, c - dc
+                if 0 <= pr < h and 0 <= pc < w and mask[pr, pc]:
+                    continue
+                cells = []
+                rr, cc = r, c
+                while 0 <= rr < h and 0 <= cc < w and mask[rr, cc]:
+                    cells.append((rr, cc))
+                    rr += dr
+                    cc += dc
+                if len(cells) < 2:
+                    continue
+                start = cells[0]
+                end = cells[-1]
+                segments.append(
+                    {
+                        "color": col,
+                        "cells": cells,
+                        "start": start,
+                        "end": end,
+                        "t_start": _dot(start, d),
+                        "t_end": _dot(end, d),
+                        "s": _perp_dot(start, d),
+                        "len": len(cells),
+                    }
+                )
+    return segments
+
