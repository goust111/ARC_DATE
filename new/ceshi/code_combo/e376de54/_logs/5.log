+            for b in _START_GAP_OPTIONS:
+                if a == b:
+                    continue
+                patterns.append((-a, 0, b))
+    else:
+        for a in _START_GAP_OPTIONS:
+            for b in _START_GAP_OPTIONS:
+                for c in _START_GAP_OPTIONS:
+                    for d in _START_GAP_OPTIONS:
+                        gaps = [a, b, c, d]
+                        if len(set(gaps)) == 1:
+                            continue
