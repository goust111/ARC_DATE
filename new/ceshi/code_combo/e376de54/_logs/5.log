+
+
+def _stair_patterns(n):
+    """Relative input start offsets, in segment steps, with the reference fixed at 0."""
+    patterns = []
+    if n == 3:
+        for a in _START_GAP_OPTIONS:
+            for b in _START_GAP_OPTIONS:
+                if a == b:
+                    continue
+                patterns.append((-a, 0, b))
