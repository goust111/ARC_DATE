+            if not long_value_pairs:
+                continue
+
+            short_len = random.randint(2, mode_len - 1)
+            long_len_i, long_len_j = random.choice(long_value_pairs)
+
+            lengths = [None] * _SEGMENT_COUNT
+            for idx in mode_pair:
