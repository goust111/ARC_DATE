   176	def main(grid: np.ndarray) -> np.ndarray:
   177	    """
   178	    Re-align parallel colored segments to the shortest segment's span, trim only the excess, and return the tight cropped result.
   179	
   180	    Input structure:
   181	    - The background is the most frequent color.
   182	    - The foreground consists of several multi-cell monochrome segments on distinct parallel tracks.
   183	    - All segments share one dominant direction, and exactly one segment is the shortest.
   184	
   185	    Rule:
   186	    - Detect the common direction and trace every multi-cell segment along it.
   187	    - Use the unique shortest segment as the reference, taking its start as the shared aligned start and its length as the maximum allowed output length.
   188	    - Shift every segment so its start matches the reference start, then draw only `min(segment_length, reference_length)` cells.
   189	    - After redrawing, crop the canvas to the minimal rectangle containing the transformed segments.
   190	
   191	    Key insight: The deciding signal is the minimum length, and because the rule never extends shorter lines, the whole pattern contracts to a compact block framed only by the surviving clipped spans.
   192	    """
   193	    g = np.asarray(grid, dtype=int)
   194	    h, w = g.shape
   195	    bg = get_bg(g)
   196	
   197	    d = _pick_main_dir(g, bg)
   198	    dr, dc = d
   199	    delta_t = dr * dr + dc * dc
   200	    segments = _extract_segments(g, bg, d)
