   206	            assert s_vals[i + 1] - s_vals[i] >= 4
   207	    assert len(s_vals) == len(set(s_vals)), "segment line coordinates must be unique"
   208	
   209	    min_len = min(s["len"] for s in segments)
   210	    ref_cands = [s for s in segments if s["len"] == min_len]
   211	    assert len(ref_cands) == 1, "shortest reference segment must be unique"
   212	    ref = ref_cands[0]
   213	    ref_t0, ref_t1 = ref["t_start"], ref["t_end"]
   214	    assert ref_t1 >= ref_t0, "traced segment coordinates must increase"
   215	    assert (ref_t1 - ref_t0) % delta_t == 0, "reference segment length must align with delta_t"
   216	    target_len = (ref_t1 - ref_t0) // delta_t + 1
