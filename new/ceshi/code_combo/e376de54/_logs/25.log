   129	    return p[0] * d[1] - p[1] * d[0]
   130	
   131	
   132	def _bbox_from_cells(cells: list[tuple[int, int]]) -> tuple[int, int, int, int]:
   133	    rs = [r for r, _ in cells]
   134	    cs = [c for _, c in cells]
   135	    return min(rs), min(cs), max(rs), max(cs)
   136	
   137	
   138	def _extract_segments(g: np.ndarray, bg: int, d: tuple[int, int]) -> list[dict]:
   139	    h, w = g.shape
   140	    dr, dc = d
   141	    segments = []
   142	    for col in [int(c) for c in np.unique(g) if int(c) != bg]:
   143	        mask = g == col
   144	        for r in range(h):
   145	            for c in range(w):
   146	                if not mask[r, c]:
   147	                    continue
   148	                pr, pc = r - dr, c - dc
   149	                if 0 <= pr < h and 0 <= pc < w and mask[pr, pc]:
   150	                    continue
   151	                cells = []
   152	                rr, cc = r, c
   153	                while 0 <= rr < h and 0 <= cc < w and mask[rr, cc]:
   154	                    cells.append((rr, cc))
   155	                    rr += dr
   156	                    cc += dc
   157	                if len(cells) < 2:
   158	                    continue
   159	                start = cells[0]
   160	                end = cells[-1]
   161	                segments.append(
   162	                    {
   163	                        "color": col,
   164	                        "cells": cells,
   165	                        "start": start,
   166	                        "end": end,
   167	                        "t_start": _dot(start, d),
   168	                        "t_end": _dot(end, d),
   169	                        "s": _perp_dot(start, d),
   170	                        "len": len(cells),
   171	                    }
