   116	
   117	    best_cnt = max(cnt for _, cnt in counts)
   118	    assert best_cnt > 0, "main direction must be detectable"
   119	    best_dirs = [d for d, cnt in counts if cnt == best_cnt]
   120	    assert len(best_dirs) == 1, "main direction must be unique"
   121	    return best_dirs[0]
   122	
