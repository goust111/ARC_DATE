+    for length in lengths:
+        if anchor == "start":
+            starts.append(t0)
+        else:
+            starts.append(t1 - (length - 1) * delta)
+
+    inp = np.full((_H, _W), _BG, dtype=int)
+    if not _paint(inp, d, s_vals, starts, lengths, colors):
+        return None
+
+    try:
+        solved = main(inp)
+    except Exception:
+        return None
+
+    if not np.array_equal(solved, out):
+        return None
+
