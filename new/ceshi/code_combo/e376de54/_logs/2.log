+                    continue
+                start = cells[0]
+                end = cells[-1]
+                segments.append(
+                    {
+                        "color": col,
+                        "cells": cells,
+                        "start": start,
+                        "t_start": _dot(start, d),
+                        "t_end": _dot(end, d),
+                        "s": _perp_dot(start, d),
+                        "len": len(cells),
