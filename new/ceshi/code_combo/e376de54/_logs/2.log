+_H, _W = 16, 16
+_BG = 7
+
+_DIRS = [(0, 1), (1, 0), (1, 1), (1, -1)]
+_COLORS = [1, 2, 3, 5, 6, 8, 9]
+
+_SEGMENT_COUNTS = [3, 5]
+_REF_LEN_RANGE = (2, 6)
+_MAX_SEG_LEN = 12
+
+_PERP_GAP_ORTHO = [2, 3, 4, 5, 6]
+_PERP_GAP_DIAG = [4, 6]
+
