+                    rr += dr
+                    cc += dc
+                if len(cells) < 2:
+                    continue
+                start = cells[0]
+                end = cells[-1]
+                segments.append(
+                    {
+                        "color": col,
+                        "cells": cells,
+                        "start": start,
+                        "end": end,
