+def _cell_from_ts(d: tuple[int, int], t: int, s: int) -> tuple[int, int] | None:
+    if d == (0, 1):
+        r, c = s, t
+    elif d == (1, 0):
+        r, c = t, -s
+    elif d == (1, 1):
+        if (t + s) % 2 or (t - s) % 2:
+            return None
+        r, c = (t + s) // 2, (t - s) // 2
+    else:
+        if (t - s) % 2 or (-s - t) % 2:
+            return None
+        r, c = (t - s) // 2, (-s - t) // 2
+    if 0 <= r < _H and 0 <= c < _W:
+        return r, c
+    return None
+
+
+def _segment_cells(d: tuple[int, int], t0: int, s: int, length: int) -> list[tuple[int, int]] | None:
+    delta = _step(d)
+    cells = []
+    for k in range(length):
+        cell = _cell_from_ts(d, t0 + k * delta, s)
+        if cell is None:
+            return None
+        cells.append(cell)
+    return cells
