+    while _cell_from_ts(d, t1 - length * delta, s) is not None:
+        length += 1
+    return length
+
+
+def _s_limits(d: tuple[int, int]) -> tuple[int, int]:
+    if d == (0, 1):
+        return 0, 15
+    if d == (1, 0):
+        return -15, 0
+    if d == (1, 1):
+        return -15, 15
+    return -30, 0
+
+
+def _gap_patterns(d: tuple[int, int], n: int) -> list[list[int]]:
