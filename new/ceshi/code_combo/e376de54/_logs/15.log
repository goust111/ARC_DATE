+# --- Directions and colors ---
+_DIRS = [(0, 1), (1, 0), (1, 1), (1, -1)]
+_COLORS = [1, 2, 3, 5, 6, 8, 9]
+
+# --- Group shape ---
+_GROUP_COUNTS = [2, 3]
+_SEGMENT_COUNT = 3
+_REF_LEN_RANGES = {2: (3, 6), 3: (3, 5)}
+_MAX_SEG_LEN = 9
+
+# --- Perpendicular gap constraints ---
+_PERP_GAP_ORTHO = [2, 3, 4]
+_PERP_GAP_DIAG = [4, 6]
+
+# --- Color assignment ---
+_MAX_DISTINCT_COLORS = 3
