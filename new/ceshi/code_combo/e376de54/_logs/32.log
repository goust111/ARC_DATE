+                continue
+            if sum(length == ref_len for length in observed_lengths) != 1:
+                continue
+            return inp
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(_GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
