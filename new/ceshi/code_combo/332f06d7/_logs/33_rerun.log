+def _extend_to_dock(grid: np.ndarray, pr: int, pc: int, n: int, frame_edges: list[str]):
+    H, W = grid.shape
+    candidates = []
+    random.shuffle(frame_edges)
+    for edge in frame_edges:
+        if edge == "top":
+            dock_r, dock_c = 1, pc
+            strip = grid[min(pr, dock_r) : max(pr, dock_r) + n, pc : pc + n]
+        elif edge == "bottom":
+            dock_r, dock_c = H - n - 1, pc
