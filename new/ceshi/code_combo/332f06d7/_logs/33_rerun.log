+def _extend_path_to_dock(path, h2: int, w2: int, frame_edges: list[str]):
+    used = set(path)
+    r, c = path[-1]
+    candidates = []
+    for edge in frame_edges:
+        if edge == "top":
+            if not (1 <= c <= w2 - 2):
+                continue
+            target = (1, c)
+        elif edge == "bottom":
+            if not (1 <= c <= w2 - 2):
+                continue
+            target = (h2 - 2, c)
+        elif edge == "left":
+            if not (1 <= r <= h2 - 2):
+                continue
+            target = (r, 1)
+        else:
+            if not (1 <= r <= h2 - 2):
+                continue
+            target = (r, w2 - 2)
+        if target == (r, c):
+            continue
+        seq = []
+        rr, cc = r, c
+        ok = True
+        while (rr, cc) != target:
+            if rr < target[0]:
+                rr += 1
+            elif rr > target[0]:
+                rr -= 1
+            elif cc < target[1]:
+                cc += 1
+            else:
+                cc -= 1
+            pos = (int(rr), int(cc))
+            if pos in used:
+                ok = False
+                break
+            seq.append(pos)
+        if ok and seq:
+            candidates.append((len(seq), path + seq, edge))
+    if not candidates:
+        return None
+    candidates.sort(key=lambda x: x[0])
+    _dist, new_path, edge = candidates[0]
+    return new_path, edge
+
