+    m = n + 2
+    mask = np.zeros((m, m), dtype=bool)
+    mask[0, :] = True
+    mask[-1, :] = True
+    mask[:, 0] = True
+    mask[:, -1] = True
+    coord_set = set(coords)
+    for r in range(n):
