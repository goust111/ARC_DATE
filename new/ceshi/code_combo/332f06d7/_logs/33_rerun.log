+            if r == n - 1:
+                mask[m - 1, 1 + c] = False
+    elif mouth_side == "left":
+        for r, c in coord_set:
+            if c == 0:
+                mask[1 + r, 0] = False
+    else:
+        for r, c in coord_set:
+            if c == n - 1:
+                mask[1 + r, m - 1] = False
+    return mask
