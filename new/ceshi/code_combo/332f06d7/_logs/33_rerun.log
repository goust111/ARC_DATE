+    for edge in frame_edges:
+        if edge == "top":
+            dock_r, dock_c = 1, pc
+            strip = grid[min(pr, dock_r) : max(pr, dock_r) + n, pc : pc + n]
+        elif edge == "bottom":
+            dock_r, dock_c = H - n - 1, pc
+            strip = grid[min(pr, dock_r) : max(pr, dock_r) + n, pc : pc + n]
+        elif edge == "left":
+            dock_r, dock_c = pr, 1
+            strip = grid[pr : pr + n, min(pc, dock_c) : max(pc, dock_c) + n]
+        else:
+            dock_r, dock_c = pr, W - n - 1
+            strip = grid[pr : pr + n, min(pc, dock_c) : max(pc, dock_c) + n]
