+def _dock_anchor_for_edge(H: int, W: int, n: int, frame_edge: str) -> tuple[int, int]:
+    if frame_edge == "top":
+        return 1, -1
+    if frame_edge == "bottom":
+        return H - n - 1, -1
+    if frame_edge == "left":
+        return -1, 1
+    return -1, W - n - 1
