   286	def _hamiltonian_walk(rows: int, cols: int, start: tuple[int, int], end: tuple[int, int]) -> list[tuple[int, int]] | None:
   287	    total = rows * cols
   288	    best_path = None
   289	    best_len = 0
   290	    for _attempt in range(80):
   291	        visited = {start}
   292	        path = [start]
   293	        cur = start
   294	        while True:
   295	            if cur == end and len(path) >= total * 0.7:
   296	                if len(path) > best_len:
   297	                    best_path = list(path)
   298	                    best_len = len(path)
   299	                break
   300	            neighbors = []
   301	            for dr, dc in _DIR4:
   302	                nr, nc = cur[0] + dr, cur[1] + dc
   303	                if 0 <= nr < rows and 0 <= nc < cols and (nr, nc) not in visited:
   304	                    neighbors.append((nr, nc))
   305	            if not neighbors:
   306	                break
   307	            valid = []
   308	            for nb in neighbors:
   309	                if nb == end:
   310	                    valid.append(nb)
   311	                    continue
