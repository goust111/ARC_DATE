+def _render_channel(
+    grid: np.ndarray,
+    path: list[tuple[int, int]],
+    n: int,
+    offsets_r: list[int],
+    offsets_c: list[int],
+) -> list[tuple[int, int]]:
+    pixel_pos = []
+    for cr, cc in path:
+        pr, pc = offsets_r[cr], offsets_c[cc]
+        pixel_pos.append((pr, pc))
+        grid[pr : pr + n, pc : pc + n] = _RIVER
