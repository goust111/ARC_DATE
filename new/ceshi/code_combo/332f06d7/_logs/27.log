   286	def _count_components(mask: np.ndarray) -> int:
   287	    H, W = mask.shape
   288	    seen = np.zeros((H, W), dtype=bool)
   289	    count = 0
   290	    for r in range(H):
   291	        for c in range(W):
   292	            if seen[r, c] or not bool(mask[r, c]):
   293	                continue
   294	            count += 1
   295	            queue = deque([(r, c)])
   296	            seen[r, c] = True
   297	            while queue:
