+    dr, dc = int(state["dr"]), int(state["dc"])
+    river = int(state["river"])
+
+    trav_with = (g == river) | (g == int(state["mover"]["col"])) | (g == int(state["dest"]["col"]))
+    trav_without = trav_with | (g == _OBST)
