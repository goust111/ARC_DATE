+    squares: list[dict] = []
+    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict"):
+        col = int(comp["color"])
+        bbox = comp["bbox"]
+        if bbox_h(bbox) != bbox_w(bbox):
+            continue
+        patch = g[int(bbox[0]) : int(bbox[2]) + 1, int(bbox[1]) : int(bbox[3]) + 1]
