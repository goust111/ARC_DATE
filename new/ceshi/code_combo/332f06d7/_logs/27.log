+        "dest_without_obstacles": int(dist_without[dr, dc]) if feasible_without[dr, dc] else -1,
+        "farthest_with_obstacles": int(dist_with.max()),
+        "farthest_without_obstacles": int(dist_without.max()),
+        "obstacle_pixels": int((g == _OBST).sum()),
