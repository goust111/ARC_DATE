    ## 原始 solver + generator 代码

    文件: `/home/lixinyu/snap/new/arc2_solver_select/332f06d7.py`

    ```python
    from __future__ import annotations
from collections import Counter, defaultdict, deque
import random
import numpy as np
from scipy.ndimage import label as scipy_label
from arc_utils import bbox_h, bbox_w, find_components, in_bounds, neighbors4, paste

def main(grid: np.ndarray) -> np.ndarray:
    """
    Slide a solid square through a winding channel to reach a same-sized target square.

    Input structure:
    - bg (most common color). A river color forms a winding corridor.
    - Two same-sized NxN solid squares on the river: mover and destination, each a distinct color.

    Rule:
    - The mover square travels along the river toward the destination.
    - It can only pass through positions where the full NxN area is river.
    - If reachable, the mover replaces the destination; otherwise it stops at the farthest reachable point.
    - The mover's original position is filled with the river color.

    Key insight: Chokepoints narrower than N pixels block the square, forcing it to stop short.
    """
    g = np.array(grid, dtype=int)
    H, W = g.shape

    # Corner-majority background (more stable than global mode here).
    bg = int(Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0])

    # Detect solid square components (excluding bg).
    squares: list[dict] = []
    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict"):
        col = int(comp["color"])
        b = comp["bbox"]
        if bbox_h(b) != bbox_w(b):
            continue
        patch = g[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1]
        if not bool((patch == int(col)).all()):
            continue
        squares.append({"col": int(col), "r0": int(b[0]), "c0": int(b[1]), "n": int(bbox_h(b))})

    assert not (len(squares) < 2)

    # Choose the size that appears at least twice (most common size).
    by_n: dict[int, list[dict]] = defaultdict(list)
    for s in squares:
        by_n[int(s["n"])].append(s)
    nside = max(by_n.items(), key=lambda kv: (len(kv[1]), kv[0]))[0]
    cand = by_n[int(nside)]
    assert not (len(cand) < 2)

    cand.sort(key=lambda s: int(s["col"]))
    mover = cand[0]
    dest = cand[1]

    n = int(mover["n"])
    sr, sc = int(mover["r0"]), int(mover["c0"])
    dr, dc = int(dest["r0"]), int(dest["c0"])

    # River = most common remaining color (excluding bg and the two square colors).
    counts = Counter(map(int, g.flatten()))
    river = None
    for col, _ct in counts.most_common():
        if int(col) == int(bg):
            continue
        if int(col) in (int(mover["col"]), int(dest["col"])):
            continue
        river = int(col)
        break
    assert not (river is None)

    trav = (g == int(river)) | (g == int(mover["col"])) | (g == int(dest["col"]))

    # Feasible top-left placements: NxN window fully inside trav.
    h2 = int(H - n + 1)
    w2 = int(W - n + 1)
    assert not (h2 <= 0 or w2 <= 0)
    assert not (not (0 <= sr < h2 and 0 <= sc < w2))

    feasible = np.zeros((h2, w2), dtype=bool)
    for r in range(h2):
        for c in range(w2):
            if bool(trav[int(r) : int(r + n), int(c) : int(c + n)].all()):
                feasible[int(r), int(c)] = True
    assert not (not bool(feasible[int(sr), int(sc)]))

    # BFS on placement grid.
    dist = -np.ones((h2, w2), dtype=int)
    q = deque([(int(sr), int(sc))])
    dist[int(sr), int(sc)] = 0
    DIR4 = [(1, 0), (-1, 0), (0, 1), (0, -1)]
    while q:
        r, c = q.popleft()
        for dr2, dc2 in DIR4:
            rr = int(r + dr2)
            cc = int(c + dc2)
            if 0 <= rr < h2 and 0 <= cc < w2 and bool(feasible[rr, cc]) and int(dist[rr, cc]) == -1:
                dist[rr, cc] = int(dist[int(r), int(c)] + 1)
                q.append((int(rr), int(cc)))

    # Pick target.
    if 0 <= dr < h2 and 0 <= dc < w2 and bool(feasible[int(dr), int(dc)]) and int(dist[int(dr), int(dc)]) >= 0:
        tr, tc = int(dr), int(dc)
    else:
        best = -1
        tr, tc = int(sr), int(sc)
        for r in range(h2):
            for c in range(w2):
                if int(dist[int(r), int(c)]) > best:
                    best = int(dist[int(r), int(c)])
                    tr, tc = int(r), int(c)

    out = g.copy()
    out[int(sr) : int(sr + n), int(sc) : int(sc + n)] = int(river)
    out[int(tr) : int(tr + n), int(tc) : int(tc + n)] = int(mover["col"])
    return out


# --- Generator ---

_BG, _RIVER, _MOVER, _DEST = 3, 1, 0, 2


def _bfs_placement(feasible, sr, sc):
    h2, w2 = feasible.shape
    dist = -np.ones((h2, w2), dtype=int)
    dist[sr, sc] = 0
    q = deque([(sr, sc)])
    while q:
        r, c = q.popleft()
        for dr, dc in [(1, 0), (-1, 0), (0, 1), (0, -1)]:
            rr, cc = r + dr, c + dc
            if 0 <= rr < h2 and 0 <= cc < w2 and feasible[rr, cc] and dist[rr, cc] == -1:
                dist[rr, cc] = dist[r, c] + 1
                q.append((rr, cc))
    return dist


def _hamiltonian_walk(rows, cols, start, end):
    total = rows * cols
    best_path = None
    best_len = 0
    for _attempt in range(80):
        visited = {start}
        path = [start]
        cur = start
        while True:
            if cur == end and len(path) >= total * 0.7:
                if len(path) > best_len:
                    best_path = list(path)
                    best_len = len(path)
                break
            neighbors = []
            for dr, dc in [(1, 0), (-1, 0), (0, 1), (0, -1)]:
                nr, nc = cur[0] + dr, cur[1] + dc
                if 0 <= nr < rows and 0 <= nc < cols and (nr, nc) not in visited:
                    neighbors.append((nr, nc))
            if not neighbors:
                break
            valid = []
            for nb in neighbors:
                if nb == end:
                    valid.append(nb)
                    continue
                test_visited = visited | {nb}
                seen = {end}
                q = deque([end])
                while q:
                    cr, cc = q.popleft()
                    for dr2, dc2 in [(1, 0), (-1, 0), (0, 1), (0, -1)]:
                        nr2, nc2 = cr + dr2, cc + dc2
                        if (0 <= nr2 < rows and 0 <= nc2 < cols and
                                (nr2, nc2) not in test_visited and (nr2, nc2) not in seen):
                            seen.add((nr2, nc2))
                            q.append((nr2, nc2))
                for dr2, dc2 in [(1, 0), (-1, 0), (0, 1), (0, -1)]:
                    ar, ac = nb[0] + dr2, nb[1] + dc2
                    if (0 <= ar < rows and 0 <= ac < cols and
                            (ar, ac) not in test_visited and (ar, ac) in seen):
                        valid.append(nb)
                        break
            if not valid:
                break
            random.shuffle(valid)
            nxt = valid[0]
            visited.add(nxt)
            path.append(nxt)
            cur = nxt
        if best_path and best_len >= total * 0.85:
            break
    return best_path


def _render_channel(grid, path, n, offsets_r, offsets_c):
    pixel_pos = []
    for cr, cc in path:
        pr, pc = offsets_r[cr], offsets_c[cc]
        pixel_pos.append((pr, pc))
        grid[pr:pr + n, pc:pc + n] = _RIVER
    for i in range(len(path) - 1):
        pr1, pc1 = pixel_pos[i]
        pr2, pc2 = pixel_pos[i + 1]
        if pr1 == pr2:
            c_lo, c_hi = min(pc1, pc2), max(pc1, pc2) + n
            grid[pr1:pr1 + n, c_lo:c_hi] = _RIVER
        else:
            r_lo, r_hi = min(pr1, pr2), max(pr1, pr2) + n
            grid[r_lo:r_hi, pc1:pc1 + n] = _RIVER
    return pixel_pos


def _add_chokepoint(grid, pixel_pos_i, pixel_pos_j, n, direction):
    H, W = grid.shape
    pr1, pc1 = pixel_pos_i
    pr2, pc2 = pixel_pos_j
    narrow_w = random.randint(1, n - 1)
    remove = n - narrow_w
    side = random.randint(0, 1)

    if direction == 'h':
        c_lo = min(pc1, pc2) + n
        c_hi = max(pc1, pc2)
        if c_hi <= c_lo:
            c_lo, c_hi = min(pc1, pc2), max(pc1, pc2) + n
        hold_len = random.randint(1, min(6, max(1, c_hi - c_lo - 2 * remove)))
        if hold_len < 1:
            hold_len = 1
        total_len = 2 * remove + hold_len
        c_mid = (c_lo + c_hi) // 2
        c_start = max(c_lo, c_mid - total_len // 2)
        for step in range(total_len):
            c = c_start + step
            if c < 0 or c >= W:
                continue
            if step < remove:
                depth = step + 1
            elif step >= total_len - remove:
                depth = total_len - step
            else:
                depth = remove
            for k in range(depth):
                rr = pr1 + k if side == 0 else pr1 + n - 1 - k
                if 0 <= rr < H and 0 <= c < W:
                    grid[rr, c] = _BG
    else:
        r_lo = min(pr1, pr2) + n
        r_hi = max(pr1, pr2)
        if r_hi <= r_lo:
            r_lo, r_hi = min(pr1, pr2), max(pr1, pr2) + n
        hold_len = random.randint(1, min(6, max(1, r_hi - r_lo - 2 * remove)))
        if hold_len < 1:
            hold_len = 1
        total_len = 2 * remove + hold_len
        r_mid = (r_lo + r_hi) // 2
        r_start = max(r_lo, r_mid - total_len // 2)
        for step in range(total_len):
            r = r_start + step
            if r < 0 or r >= H:
                continue
            if step < remove:
                depth = step + 1
            elif step >= total_len - remove:
                depth = total_len - step
            else:
                depth = remove
            for k in range(depth):
                cc = pc1 + k if side == 0 else pc1 + n - 1 - k
                if 0 <= r < H and 0 <= cc < W:
                    grid[r, cc] = _BG


def _river_connected(grid):
    mask = (grid == _RIVER) | (grid == _MOVER) | (grid == _DEST)
    if not mask.any():
        return False
    labeled, num = scipy_label(mask.astype(int))
    return num == 1


def _compute_offsets(G, n, num_coarse):
    if num_coarse == 1:
        return [1]
    first = 1
    last = G - n - 1
    if last < first:
        return None
    step = (last - first) / (num_coarse - 1)
    return [int(round(first + i * step)) for i in range(num_coarse)]


def _gen_attempt():
    reached = random.random() < 0.5
    n = random.choice([1, 2, 3, 4]) if reached else random.choice([2, 3, 4])

    min_size = max(10, 5 * n)
    if min_size > 20:
        return None
    G = random.randint(min_size, 20)
    H = W = G

    min_spacing = n + 1
    max_coarse = max(3, (G - 2) // min_spacing)
    coarse_dim = random.randint(3, min(6, max_coarse))
    coarse_rows = coarse_cols = coarse_dim

    offsets_r = _compute_offsets(G, n, coarse_rows)
    offsets_c = _compute_offsets(G, n, coarse_cols)
    if offsets_r is None or offsets_c is None:
        return None
    for i in range(len(offsets_r) - 1):
        if offsets_r[i + 1] - offsets_r[i] < n:
            return None
    for i in range(len(offsets_c) - 1):
        if offsets_c[i + 1] - offsets_c[i] < n:
            return None

    edge_cells = set()
    for c in range(coarse_cols):
        edge_cells.add((0, c))
        edge_cells.add((coarse_rows - 1, c))
    for r in range(1, coarse_rows - 1):
        edge_cells.add((r, 0))
        edge_cells.add((r, coarse_cols - 1))
    edge_cells = list(edge_cells)
    random.shuffle(edge_cells)
    start_coarse = edge_cells[0]
    far = sorted(edge_cells, key=lambda e: -(abs(e[0] - start_coarse[0]) + abs(e[1] - start_coarse[1])))
    end_coarse = far[0] if far[0] != start_coarse else far[1]

    walk = _hamiltonian_walk(coarse_rows, coarse_cols, start_coarse, end_coarse)
    if walk is None or len(walk) < 4:
        return None
    if len(set(cr for cr, _ in walk)) < coarse_rows or len(set(cc for _, cc in walk)) < coarse_cols:
        return None

    grid = np.full((H, W), _BG, dtype=int)
    pixel_pos = _render_channel(grid, walk, n, offsets_r, offsets_c)

    mask = (grid != _BG)
    if np.any(mask, axis=1).sum() / H < 0.70 or np.any(mask, axis=0).sum() / W < 0.70:
        return None

    mover_r, mover_c = pixel_pos[0]
    dest_r, dest_c = pixel_pos[-1]

    # Extend dest to touch grid edge
    def _extend_to_edge(pr, pc):
        candidates = []
        for direction in ['top', 'bottom', 'left', 'right']:
            if direction == 'top':
                dist = pr
                if dist == 0:
                    candidates.append((0, pc, 0))
                    continue
                if all(grid[r, c] in (_BG, _RIVER) for r in range(pr) for c in range(pc, pc + n) if c < W):
                    candidates.append((0, pc, dist))
            elif direction == 'bottom':
                dist = H - (pr + n)
                if dist == 0:
                    candidates.append((pr, pc, 0))
                    continue
                if all(grid[r, c] in (_BG, _RIVER) for r in range(pr + n, H) for c in range(pc, pc + n) if c < W):
                    candidates.append((H - n, pc, dist))
            elif direction == 'left':
                dist = pc
                if dist == 0:
                    candidates.append((pr, 0, 0))
                    continue
                if all(grid[r, c] in (_BG, _RIVER) for r in range(pr, pr + n) for c in range(pc) if r < H):
                    candidates.append((pr, 0, dist))
            elif direction == 'right':
                dist = W - (pc + n)
                if dist == 0:
                    candidates.append((pr, pc, 0))
                    continue
                if all(grid[r, c] in (_BG, _RIVER) for r in range(pr, pr + n) for c in range(pc + n, W) if r < H):
                    candidates.append((pr, W - n, dist))
        if not candidates:
            return None
        candidates.sort(key=lambda x: x[2])
        return candidates[0][:2]

    result = _extend_to_edge(dest_r, dest_c)
    if result is None:
        return None
    new_dest_r, new_dest_c = result
    if new_dest_r != dest_r:
        r_lo, r_hi = min(new_dest_r, dest_r), max(new_dest_r, dest_r) + n
        grid[r_lo:r_hi, dest_c:dest_c + n] = _RIVER
    if new_dest_c != dest_c:
        c_lo, c_hi = min(new_dest_c, dest_c), max(new_dest_c, dest_c) + n
        grid[dest_r:dest_r + n, c_lo:c_hi] = _RIVER
    dest_r, dest_c = new_dest_r, new_dest_c
    if not (dest_r == 0 or dest_r + n == H or dest_c == 0 or dest_c + n == W):
        return None

    # Mover: near edge but not touching
    touching = (mover_r == 0 or mover_r + n == H or mover_c == 0 or mover_c + n == W)
    if touching:
        if mover_r == 0:
            grid[0, mover_c:mover_c + n] = _RIVER; mover_r = 1
        elif mover_r + n == H:
            grid[H - 1, mover_c:mover_c + n] = _RIVER; mover_r = H - n - 1
        elif mover_c == 0:
            grid[mover_r:mover_r + n, 0] = _RIVER; mover_c = 1
        elif mover_c + n == W:
            grid[mover_r:mover_r + n, W - 1] = _RIVER; mover_c = W - n - 1
    if mover_r == 0 or mover_r + n == H or mover_c == 0 or mover_c + n == W:
        return None
    if min(mover_r, H - (mover_r + n), mover_c, W - (mover_c + n)) > 2:
        return None

    grid[mover_r:mover_r + n, mover_c:mover_c + n] = _RIVER
    grid[dest_r:dest_r + n, dest_c:dest_c + n] = _RIVER

    # Chokepoints for stuck case
    if not reached and n >= 2:
        num_choke = random.randint(1, min(3, len(walk) - 2))
        min_seg = max(1, len(walk) // 4)
        available = list(range(min_seg, len(walk) - 1))
        random.shuffle(available)
        for seg_idx in available[:num_choke]:
            pr1, pc1 = pixel_pos[seg_idx]
            pr2, pc2 = pixel_pos[min(seg_idx + 1, len(pixel_pos) - 1)]
            direction = 'h' if pr1 == pr2 else 'v'
            _add_chokepoint(grid, (pr1, pc1), (pr2, pc2), n, direction)
        if not _river_connected(grid):
            return None

    grid[mover_r:mover_r + n, mover_c:mover_c + n] = _MOVER
    grid[dest_r:dest_r + n, dest_c:dest_c + n] = _DEST

    trav = (grid == _RIVER) | (grid == _MOVER) | (grid == _DEST)
    h2, w2 = H - n + 1, W - n + 1
    feasible = np.zeros((h2, w2), dtype=bool)
    for r in range(h2):
        for c in range(w2):
            if trav[r:r + n, c:c + n].all():
                feasible[r, c] = True
    if not feasible[mover_r, mover_c]:
        return None

    dist = _bfs_placement(feasible, mover_r, mover_c)
    dest_ok = (0 <= dest_r < h2 and 0 <= dest_c < w2 and
               feasible[dest_r, dest_c] and dist[dest_r, dest_c] >= 0)
    if reached and not dest_ok:
        return None
    if not reached and dest_ok:
        return None

    if dest_ok:
        tr, tc = dest_r, dest_c
    else:
        best_d = -1
        tr, tc = mover_r, mover_c
        for r in range(h2):
            for c in range(w2):
                if dist[r, c] > best_d:
                    best_d = dist[r, c]
                    tr, tc = r, c

    output = grid.copy()
    output[mover_r:mover_r + n, mover_c:mover_c + n] = _RIVER
    output[tr:tr + n, tc:tc + n] = _MOVER

    if not np.array_equal(main(grid), output):
        return None
    return grid


def generate_input():
    for _ in range(300):
        result = _gen_attempt()
        if result is not None:
            return result
    raise RuntimeError("Failed to generate valid input after 300 attempts")



    ```

    ## 原始任务规格（Spec）

    以下是从原始 solver 代码和示例中提炼的完整任务规格，包含精确的数值约束和生成策略。
    Spec 本身就是原题代码生成时的参考文件，因此：
    - 在**设计分析**阶段，参考 spec 理解原始任务的完整设计细节（对象结构、空间关系、生成策略等），以此为基础思考融合变体的改动如何落实
    - 在**实现**阶段，参考 spec 中的数值约束（网格尺寸、对象数量/尺寸、颜色数等），确保融合变体在物理上可实现

    ```yaml
    spec:
  grid: 10-20 rows × 10-20 cols, always square (H=W)
  background: color 3 (green), must dominate all 4 corners
  river: color 1 (blue), single connected channel of varying width, 20-57% of grid area
  mover: color 0 (black), solid n×n square
  destination: color 2 (red), solid n×n square, same size as mover
  square_size:
    n: 1-4
    grid_correlation: n=1→10-16, n=2→12-16, n=3→14-20, n=4→20
  color_ordering: mover color (0) < dest color (2); solver sorts by color ascending
  channel:
    structure: winding corridor of river pixels linking mover and dest regions
    width: ≥n in passable sections; 1 to n-1 at chokepoints (stuck only)
    turns: ≥3 direction changes [observed]
  scenarios:
    reachable: channel width ≥n everywhere along BFS path; mover slides to dest position and covers it
    stuck: chokepoint narrows channel to <n; mover stops at last feasible n×n placement before gate; dest remains uncovered
  transformation:
    1. Detect all solid squares of matching size n (excluding bg)
    2. Sort by color ascending → mover = first (color 0), dest = second (color 2)
    3. Traversable mask = {river ∪ mover ∪ dest} pixels
    4. BFS on feasible n×n placements (4-neighbor unit steps, entire window must lie in traversable)
    5. Reachable → move mover to dest; stuck → move to last feasible position before gate
    6. Original mover position filled with river color

generation_strategy:
  approach: output-first — build placement path first, then paint channel and place squares
  steps:
    1. Choose n∈{1,2,3,4} and H=W from correlated size ranges
    2. Decide reachable vs stuck (n=1 always reachable; n≥2 ~10-40% reachable)
    3. Sample random walk in placement-coordinate space with turn_bias≈0.2, avoiding self-adjacency
    4. Build path = winding prefix (7-13 steps, ≥3 turns) + straight tail
    5. Reachable: tail extends to boundary edge (not corner); place dest at tail end
    6. Stuck: tail ends interior; create chokepoint (1 to n-1 pixels wide) between upstream path and downstream straight corridor to dest at boundary
    7. Paint river: fill n×n block at each placement position along the full path
    8. Stuck: erase channel cross-section to <n at gate, keep 1..n-1 pixels open
    9. Place mover (color 0) at path start, dest (color 2) at path/corridor end
    10. Verify bg dominates all 4 corners
    11. Oracle: main(input)==expected; mover at correct final position (dest if reachable, gate-adjacent if stuck)
    ```


## 已有单变体参考代码

以下组成项已有单变体实现，可作为融合时的参考：

            ### 参考代码: D2/2

            文件: `/home/lixinyu/snap/new/ceshi/code/332f06d7/D2/2/code.py`

            ```python
            # Variant of 332f06d7
# Dimension: D2 — 宽度约束：通道窄化卡点机制 (path)
# Change: 通道宽度在卡点处收窄至1到n-1像素，NxN方块无法通过而被卡住... → 多级宽度门控

from __future__ import annotations

from collections import Counter, defaultdict, deque
import random

import numpy as np

from arc_utils import bbox_h, bbox_w, find_components


"""
Design analysis for this D2 variant
===================================

source_task:
  status: none

variant_spec:
  core_change:
    original: one black n×n square and one red n×n square share a single width threshold
    new: three black squares of sizes {1, 2, m} and three same-sized red targets share one
      winding river whose width descends by stages m -> 2 -> 1
    consequence: each square is solved independently on the same input, and each size reaches
      the deepest stage whose gate width is still >= that size
  visual_layout:
    river: one snake-like blue backbone with two turns and two gates
    movers: black solid squares in three side pockets near the entrance
    targets: red solid squares in three side pockets at three increasing depths
    widths:
      stage_0: width = m (m in {3,4})
      gate_1 / stage_1: width = 2
      gate_2 / stage_2: width = 1
  rule:
    - Detect all black solid squares and all red solid squares.
    - Match by visible size, not by color id ordering.
    - For each black size n, treat only blue river + that mover + red targets of size n as traversable.
    - Run the same n×n placement BFS as the original task.
    - Move that black square to the farthest reachable same-sized red square.
    - If no same-sized red square is reachable, fall back to the farthest reachable placement.
    - Replace every original black start square by blue.

  a_concretization_and_trace:
    example:
      sizes: [1, 2, 4]
      widths_along_backbone: [4, 2, 1]
      behavior:
        size_4: can leave its pocket and travel the width-4 hall, but cannot enter the width-2 gate,
          so its reachable red target is the one attached to stage 0
        size_2: can pass the width-2 gate and traverse stage 1, but cannot enter the width-1 gate,
          so it reaches the stage-1 red target
        size_1: can pass both gates and reaches the deepest red target
    old_logic_here:
      - original main() groups all squares by one most-common size and runs one BFS
    new_logic_here:
      - new main() must run one BFS per size class because different sizes see different feasible
        placement grids on the same river geometry
    difference:
      - the old single-size assumption would ignore two-thirds of the objects and miss the staged gates

  b_complexity_calibration:
    - Exactly three sizes are used, giving repeated structure without combinatorial explosion.
    - Gate widths are only three visible levels {m, 2, 1}; humans can compare square size against
      corridor thickness by eye.
    - Side pockets keep objects separated, so the scene is busy enough to show the new rule but not noisy.

  c_implicit_assumption_audit_of_original_main:
    - original "choose the size that appears at least twice" no longer holds; now several sizes each
      appear exactly twice (one black, one red), so grouping must be by color role then by size.
    - original single "n" and single BFS no longer holds; feasibility must be recomputed for each n.
    - original traversable mask included mover+dest colors globally; in this variant that would let one
      size illegally walk through unrelated target pockets. Traversability must be size-selective.
    - original final write only moved one square; now all black starts must be cleared and all final
      placements repainted.

  d_placement_legality:
    - All squares are placed in non-overlapping side pockets that share one full edge with the river.
    - Red/black pockets are off the shared backbone, so unrelated colored squares do not block another
      size's route.
    - The backbone is built from axis-aligned rectangles, and each turn keeps an overlap square large
      enough for every square that is supposed to pass that turn.

  e_visual_observability:
    - The new rule is visible from object sizes and corridor widths alone.
    - No hidden numeric ordering is used; size matching is literal pixel size matching.
    - Seeing three different final depths in one example makes the multi-gate rule inferable from very
      few samples.

  f_visual_cleanliness:
    - Only four colors are used: green bg, blue river, black movers, red targets.
    - The river backbone stays clear; colored pockets sit outside the travel lane.
    - The generator also applies random flips/rotations and padding for variety without adding clutter.

  g_color_inference:
    - Colors keep the original semantic roles and do not encode any hidden ranking.
    - Size is the discriminative feature; color only says mover vs target vs river vs background.

  new_main_assumptions_and_generator_guarantees:
    - Assumption: each used size has exactly one black mover and one red target.
      Guarantee: generator always places one pair for each of the three sizes.
    - Assumption: every mover is a solid square directly connected to the river by a full-width pocket.
      Guarantee: generator uses axis-aligned square pockets flush with the corridor edge.
    - Assumption: the most common non-background color besides black/red is the river color.
      Guarantee: the blue river dominates all non-square non-background pixels.
"""


_BG, _RIVER, _MOVER, _DEST = 3, 1, 0, 2


def _background_color(g: np.ndarray) -> int:
    corners = [int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]
    return int(Counter(corners).most_common(1)[0][0])


def _solid_square_components(g: np.ndarray, bg: int) -> list[dict]:
    squares: list[dict] = []
    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict"):
        col = int(comp["color"])
        b = comp["bbox"]
        if bbox_h(b) != bbox_w(b):
            continue
        patch = g[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1]
        if not bool((patch == col).all()):
            continue
        squares.append({"color": col, "r0": int(b[0]), "c0": int(b[1]), "n": int(bbox_h(b))})
    return squares


def _river_color(g: np.ndarray, bg: int) -> int:
    counts = Counter(map(int, g.flatten()))
    for col, _ct in counts.most_common():
        if int(col) not in (int(bg), _MOVER, _DEST):
            return int(col)
    raise AssertionError("river color not found")


def _feasible_placements(trav: np.ndarray, n: int) -> np.ndarray:
    H, W = trav.shape
    h2, w2 = H - n + 1, W - n + 1
    assert h2 > 0 and w2 > 0
    feasible = np.zeros((h2, w2), dtype=bool)
    for r in range(h2):
        for c in range(w2):
            feasible[r, c] = bool(trav[r : r + n, c : c + n].all())
    return feasible


def _bfs_placement(feasible: np.ndarray, sr: int, sc: int) -> np.ndarray:
    h2, w2 = feasible.shape
    dist = -np.ones((h2, w2), dtype=int)
    dist[sr, sc] = 0
    q = deque([(sr, sc)])
    while q:
        r, c = q.popleft()
        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
            rr, cc = r + dr, c + dc
            if 0 <= rr < h2 and 0 <= cc < w2 and feasible[rr, cc] and dist[rr, cc] == -1:
                dist[rr, cc] = dist[r, c] + 1
                q.append((rr, cc))
    return dist


def main(grid: np.ndarray) -> np.ndarray:
    """
    Variant rule:
    - Several black solid squares of different sizes sit in side pockets of one blue winding river.
    - Several red solid squares of matching sizes sit in deeper side pockets.
    - The river narrows in stages, so larger squares stop earlier and smaller squares pass more gates.
    - Each black square moves independently to the farthest reachable red square of the same size.
    """
    g = np.array(grid, dtype=int)
    bg = _background_color(g)
    river = _river_color(g, bg)

    squares = _solid_square_components(g, bg)
    movers = [s for s in squares if int(s["color"]) == _MOVER]
    dests = [s for s in squares if int(s["color"]) == _DEST]
    assert movers and dests

    movers_by_n: dict[int, list[dict]] = defaultdict(list)
    dests_by_n: dict[int, list[dict]] = defaultdict(list)
    for s in movers:
        movers_by_n[int(s["n"])].append(s)
    for s in dests:
        dests_by_n[int(s["n"])].append(s)

    placements: list[tuple[dict, tuple[int, int]]] = []
    for n in sorted(movers_by_n.keys(), reverse=True):
        mover_list = movers_by_n[n]
        dest_list = dests_by_n.get(n, [])
        assert len(mover_list) == 1 and len(dest_list) >= 1

        mover = mover_list[0]
        sr, sc = int(mover["r0"]), int(mover["c0"])

        trav = g == river
        trav[sr : sr + n, sc : sc + n] = True
        for d in dest_list:
            dr0, dc0 = int(d["r0"]), int(d["c0"])
            trav[dr0 : dr0 + n, dc0 : dc0 + n] = True

        feasible = _feasible_placements(trav, n)
        assert feasible[sr, sc]
        dist = _bfs_placement(feasible, sr, sc)

        best_d = -1
        target: tuple[int, int] | None = None
        for d in dest_list:
            dr0, dc0 = int(d["r0"]), int(d["c0"])
            if 0 <= dr0 < feasible.shape[0] and 0 <= dc0 < feasible.shape[1] and feasible[dr0, dc0]:
                dd = int(dist[dr0, dc0])
                if dd > best_d:
                    best_d = dd
                    target = (dr0, dc0)

        if target is None:
            farthest = -1
            tr, tc = sr, sc
            for r in range(feasible.shape[0]):
                for c in range(feasible.shape[1]):
                    if int(dist[r, c]) > farthest:
                        farthest = int(dist[r, c])
                        tr, tc = r, c
            target = (tr, tc)

        placements.append((mover, target))

    out = g.copy()
    for mover, _target in placements:
        r0, c0, n = int(mover["r0"]), int(mover["c0"]), int(mover["n"])
        out[r0 : r0 + n, c0 : c0 + n] = river
    for mover, (tr, tc) in placements:
        n = int(mover["n"])
        out[tr : tr + n, tc : tc + n] = _MOVER
    return out


def _paint_h(grid: np.ndarray, r: int, c0: int, c1: int, width: int) -> None:
    grid[r : r + width, c0 : c1 + 1] = _RIVER


def _paint_v(grid: np.ndarray, r0: int, r1: int, c: int, width: int) -> None:
    grid[r0 : r1 + 1, c : c + width] = _RIVER


def _apply_transform(arr: np.ndarray, code: int) -> np.ndarray:
    if code == 0:
        return arr.copy()
    if code == 1:
        return np.rot90(arr, 1)
    if code == 2:
        return np.rot90(arr, 2)
    if code == 3:
        return np.rot90(arr, 3)
    if code == 4:
        return np.fliplr(arr)
    if code == 5:
        return np.flipud(arr)
    if code == 6:
        return np.rot90(np.fliplr(arr), 1)
    if code == 7:
        return np.rot90(np.flipud(arr), 1)
    raise AssertionError("bad transform code")


def _build_case(max_n: int) -> tuple[np.ndarray, np.ndarray]:
    large = int(max_n)
    medium = 2
    small = 1
    assert large in (3, 4)

    y0 = large + 1
    y1 = y0 + large + 1
    y2 = y1 + 5

    c_large_start = 1
    c_medium_start = c_large_start + large + 1
    c_small_start = c_medium_start + medium + 1
    c_large_target = c_small_start + small + 1
    right0 = c_large_target + large - 1

    left1 = random.choice([1, 2])
    c_medium_target = min(right0 - 4, left1 + random.choice([3, 4]))
    right2 = right0 - random.choice([1, 2])
    c_small_target = right2 - random.choice([0, 1])

    min_h = y2 + 2
    min_w = right0 + 2
    G0 = max(min_h, min_w)
    G = random.randint(G0, min(20, G0 + 2))
    grid = np.full((G, G), _BG, dtype=int)

    row_off = random.randint(0, G - min_h)
    col_off = random.randint(0, G - min_w)
    y0 += row_off
    y1 += row_off
    y2 += row_off
    c_large_start += col_off
    c_medium_start += col_off
    c_small_start += col_off
    c_large_target += col_off
    c_medium_target += col_off
    c_small_target += col_off
    right0 += col_off
    left1 += col_off
    right2 += col_off

    _paint_h(grid, y0, col_off + 1, right0, large)
    _paint_v(grid, y0, y1 + 1, right0 - 1, medium)
    _paint_h(grid, y1, left1, right0, medium)
    _paint_v(grid, y1, y2, left1, small)
    _paint_h(grid, y2, left1, right2, small)

    starts = {
        large: (y0 - large, c_large_start),
        medium: (y0 - medium, c_medium_start),
        small: (y0 - small, c_small_start),
    }
    dests = {
        large: (y0 - large, c_large_target),
        medium: (y1 + medium, c_medium_target),
        small: (y2 - small, c_small_target),
    }

    for n, (r0, c0) in starts.items():
        grid[r0 : r0 + n, c0 : c0 + n] = _MOVER
    for n, (r0, c0) in dests.items():
        grid[r0 : r0 + n, c0 : c0 + n] = _DEST

    expected = grid.copy()
    for n, (r0, c0) in starts.items():
        expected[r0 : r0 + n, c0 : c0 + n] = _RIVER
    for n, (r0, c0) in dests.items():
        expected[r0 : r0 + n, c0 : c0 + n] = _MOVER

    code = random.randint(0, 7)
    return _apply_transform(grid, code), _apply_transform(expected, code)


def generate_input() -> np.ndarray:
    for _ in range(200):
        inp, expected = _build_case(random.choice([3, 4]))
        if np.array_equal(main(inp), expected):
            return inp
    raise RuntimeError("Failed to generate valid input after 200 attempts")

            ```

            ### 参考代码: D16/0

            文件: `/home/lixinyu/snap/new/ceshi/code/332f06d7/D16/0/code.py`

            ```python
            # Variant of 332f06d7
# Dimension: D16 — obstacle：通道中的障碍物 (obstacle)
# Change: 无显式障碍物，卡点通过通道自身变窄实现；背景色像素隐式充当'墙壁'... → 显式障碍色块

from __future__ import annotations

from collections import Counter, defaultdict, deque
import random

import numpy as np

from arc_utils import bbox_h, bbox_w, find_components


"""
design_analysis:
  variant_core:
    original: |
      蓝色河道本身会被挖窄到 < n，黑色 n×n 方块因此在几何卡口前停下。
      阻挡信息来自“哪里不是蓝色”，墙是隐式背景。
    new_variant: |
      河道主体仍然是蓝色，但卡口/绕行信息改由河道内部的显式障碍色块表达。
      障碍物直接占据河道中的一部分蓝色像素，方块只能在完整 n×n 窗口不碰障碍时移动。
      可达样例：河道在障碍旁额外扩出一个侧袋，净空 >= n，所以方块能侧移绕过障碍。
      不可达样例：仍然扩出侧袋，但净空故意只有 n-1，河水像素连通、人眼看得出“后面还有路”，
      但 n×n 方块过不去，因此会停在障碍前的最远可达位置。
  concrete_pixel_form:
    colors:
      background: 3
      river: 1
      mover: 0
      destination: 2
      obstacle: 8
    objects:
      mover: 黑色实心 n×n 正方形，靠近边缘但不接触边界
      destination: 红色实心 n×n 正方形，接触某一条边界
      river: 蓝色蜿蜒通道，基础宽度仍是 n
      obstacle: 青色矩形“舌头”，从通道一侧伸进河道内部，占据原本可走的蓝色区域
    local_mechanism_example: |
      设 n=3，原题在一段水平河道里通过把通道挖成宽度 2 来阻挡。
      现在改成：水平河道基础高度仍为 3，但在中段下方再扩出 2 或 4 行蓝色侧袋，
      然后把该段原本的 3×k 中央通路改涂成障碍色。
      - 侧袋高度为 4 时，3×3 方块可以先向下平移，再水平通过障碍，再向上回到主河道。
      - 侧袋高度为 2 时，蓝色像素对单像素观察者仍连通，但任何 3×3 窗口都会碰到障碍，所以卡住。
  complexity_calibration:
    why_not_too_simple: |
      若仅在 n 宽走廊里放障碍，所有障碍都会退化成“完全堵死”，无法出现“绕过”这一新行为。
      因此必须局部加宽河道形成侧袋，让“障碍导致绕行”和“障碍导致阻挡”都可见。
    controlled_freedom: |
      只引入一种新颜色（障碍色 8）和一种局部结构（单侧袋 + 障碍舌头），
      保持颜色数和对象类型都少，避免多种障碍形态混杂导致规则难以归纳。
  implicit_assumption_audit:
    original_solver_dependencies:
      - 原代码用颜色数值排序决定 mover/dest，这对原题“黑<红”恰好无害，但属于不可见数值规则。
      - 原代码把除背景/两方块外的最常见颜色视为 river；变体中会新增 obstacle 色，因此仍需区分两种剩余颜色。
      - 原代码把 traversable 定义为 river ∪ mover ∪ dest；变体里必须继续排除 obstacle，否则会把障碍当成可通行蓝河。
      - 原代码的“卡住”来源于蓝河自身变窄；变体下 solver 不能再假定所有非背景像素都可走。
    new_solver_choices:
      - mover/dest 通过可见空间关系识别：接触边界的是 destination，近边但不接触的是 mover。
      - river 取剩余颜色里像素数最多者，其他剩余颜色统统视为障碍。
      - BFS 仍在 n×n 可行 top-left 放置网格上做，核心运动逻辑不变，只是可行窗口会被障碍裁掉。
  placement_legality:
    generator_guarantees:
      - 只生成 10-20 的方形网格，且 n=1..4。
      - mover 和 destination 始终是两个同尺寸实心正方形，不与障碍重叠。
      - 障碍矩形宽高故意不等于 n，避免被 solver 误识别为第三个“候选方块”。
      - 侧袋扩展区域要求当前全为背景，避免与其他河段重叠造成杂乱。
      - 每个候选样例都用 main(input) 回算，并检查 reachable / stuck 分支是否符合预期。
  visual_observability:
    human_view: |
      从少量样例中，人类能直接看到：
      1. 黑方块沿蓝河移动；
      2. 青色障碍在河道内部，而不是外部墙壁；
      3. 有的样例方块绕过障碍，有的样例在障碍前停止。
      这些差异全部来自可见结构，不依赖颜色编号、遍历顺序或隐藏排序。
  cleanliness:
    notes:
      - 只在一段中段河道上制造一个局部障碍结构，避免全图到处散落障碍导致阅读负担。
      - 侧袋和障碍保持矩形、方向清晰，视觉上易于辨认“河道主体 / 绕行空间 / 阻挡舌头”。
  new_main_assumptions_to_match_generator:
    - 输入中恰有一组尺寸重复至少两次的实心正方形，其中一个接触边界、另一个不接触边界。
    - 除背景和这两个方块外，剩余颜色里像素数最多的是 river，其余颜色都是 obstacle。
    - mover 的起点是一个可行 n×n 放置位置；generator 会在返回前验证这一点。
"""


_BG, _RIVER, _MOVER, _DEST, _OBST = 3, 1, 0, 2, 8
_DIR4 = [(1, 0), (-1, 0), (0, 1), (0, -1)]
_NEXT_REACHED = False


def _solid_squares(g: np.ndarray, bg: int) -> list[dict]:
    squares: list[dict] = []
    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict"):
        col = int(comp["color"])
        b = comp["bbox"]
        if bbox_h(b) != bbox_w(b):
            continue
        patch = g[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1]
        if not bool((patch == col).all()):
            continue
        squares.append({"col": col, "r0": int(b[0]), "c0": int(b[1]), "n": int(bbox_h(b))})
    return squares


def _touches_edge(square: dict, H: int, W: int) -> bool:
    r0, c0, n = int(square["r0"]), int(square["c0"]), int(square["n"])
    return r0 == 0 or c0 == 0 or r0 + n == H or c0 + n == W


def _edge_gap(square: dict, H: int, W: int) -> int:
    r0, c0, n = int(square["r0"]), int(square["c0"]), int(square["n"])
    return min(r0, c0, H - (r0 + n), W - (c0 + n))


def _pick_roles(squares: list[dict], H: int, W: int) -> tuple[dict, dict]:
    by_n: dict[int, list[dict]] = defaultdict(list)
    for s in squares:
        by_n[int(s["n"])].append(s)
    nside = max((n for n, group in by_n.items() if len(group) >= 2), key=lambda n: (len(by_n[n]), n))
    cand = list(by_n[nside])

    edge_touching = [s for s in cand if _touches_edge(s, H, W)]
    interior = [s for s in cand if not _touches_edge(s, H, W)]
    assert edge_touching and interior

    dest = min(edge_touching, key=lambda s: _edge_gap(s, H, W))
    mover = min(interior, key=lambda s: _edge_gap(s, H, W))
    return mover, dest


def _remaining_colors(g: np.ndarray, excluded: set[int]) -> list[tuple[int, int]]:
    counts = Counter(map(int, g.flatten()))
    items = [(int(col), int(ct)) for col, ct in counts.items() if int(col) not in excluded]
    items.sort(key=lambda kv: (-kv[1], kv[0]))
    return items


def _feasible_mask(trav: np.ndarray, n: int) -> np.ndarray:
    H, W = trav.shape
    h2, w2 = H - n + 1, W - n + 1
    feasible = np.zeros((h2, w2), dtype=bool)
    for r in range(h2):
        for c in range(w2):
            feasible[r, c] = bool(trav[r : r + n, c : c + n].all())
    return feasible


def _bfs_placement(feasible: np.ndarray, sr: int, sc: int) -> np.ndarray:
    h2, w2 = feasible.shape
    dist = -np.ones((h2, w2), dtype=int)
    dist[sr, sc] = 0
    q = deque([(sr, sc)])
    while q:
        r, c = q.popleft()
        for dr, dc in _DIR4:
            rr, cc = r + dr, c + dc
            if 0 <= rr < h2 and 0 <= cc < w2 and feasible[rr, cc] and dist[rr, cc] == -1:
                dist[rr, cc] = dist[r, c] + 1
                q.append((rr, cc))
    return dist


def _pick_terminal(dist: np.ndarray, sr: int, sc: int, dr: int, dc: int, feasible: np.ndarray) -> tuple[int, int]:
    if 0 <= dr < feasible.shape[0] and 0 <= dc < feasible.shape[1] and feasible[dr, dc] and dist[dr, dc] >= 0:
        return dr, dc
    best = -1
    tr, tc = sr, sc
    for r in range(feasible.shape[0]):
        for c in range(feasible.shape[1]):
            if int(dist[r, c]) > best:
                best = int(dist[r, c])
                tr, tc = r, c
    return tr, tc


def main(grid: np.ndarray) -> np.ndarray:
    g = np.array(grid, dtype=int)
    H, W = g.shape

    bg = int(Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0])
    squares = _solid_squares(g, bg)
    assert len(squares) >= 2

    mover, dest = _pick_roles(squares, H, W)
    n = int(mover["n"])
    sr, sc = int(mover["r0"]), int(mover["c0"])
    dr, dc = int(dest["r0"]), int(dest["c0"])

    rem = _remaining_colors(g, {bg, int(mover["col"]), int(dest["col"])})
    assert rem
    river = int(rem[0][0])
    obstacle_colors = {int(col) for col, _ in rem[1:]}

    trav = (g == river) | (g == int(mover["col"])) | (g == int(dest["col"]))
    for obs in obstacle_colors:
        trav &= g != obs

    feasible = _feasible_mask(trav, n)
    assert feasible[sr, sc]
    dist = _bfs_placement(feasible, sr, sc)
    tr, tc = _pick_terminal(dist, sr, sc, dr, dc, feasible)

    out = g.copy()
    out[sr : sr + n, sc : sc + n] = river
    out[tr : tr + n, tc : tc + n] = int(mover["col"])
    return out


def _step_range(a: int, b: int) -> list[int]:
    step = 1 if b >= a else -1
    return list(range(a, b + step, step))


def _expand_waypoints(waypoints: list[tuple[int, int]]) -> list[tuple[int, int]]:
    path = [waypoints[0]]
    for (r0, c0), (r1, c1) in zip(waypoints, waypoints[1:]):
        if r0 == r1:
            for c in _step_range(c0, c1)[1:]:
                path.append((r0, c))
        else:
            for r in _step_range(r0, r1)[1:]:
                path.append((r, c0))
    return path


def _paint_path(grid: np.ndarray, path: list[tuple[int, int]], n: int) -> None:
    for r, c in path:
        grid[r : r + n, c : c + n] = _RIVER


def _choose_path_spec(H: int, n: int) -> tuple[list[tuple[int, int]], dict] | None:
    h2 = H - n + 1
    w2 = H - n + 1
    if h2 < 7 or w2 < 7:
        return None

    horizontal = random.random() < 0.5
    extra = n + 1

    if horizontal:
        c_left, c_mid_lo, c_mid_hi, c_right = 1, 1, w2 - 2, w2 - 1
        if not (c_left == c_mid_lo < c_mid_hi < c_right):
            return None
        rows = list(range(1, h2 - 1))
        if len(rows) < 3:
            return None
        bypass_side = random.choice(["up", "down"])
        if bypass_side == "up":
            special_rows = [r for r in rows if r >= extra]
        else:
            special_rows = [r for r in rows if H - (r + n) >= extra]
        if not special_rows:
            return None
        r_mid = random.choice(special_rows)
        others = [r for r in rows if r != r_mid]
        if len(others) < 2:
            return None
        r0, r2 = random.sample(others, 2)
        waypoints = [(r0, c_left), (r0, c_mid_hi), (r_mid, c_mid_hi), (r_mid, c_mid_lo), (r2, c_mid_lo), (r2, c_right)]
        segment = {"orientation": "h", "r": r_mid, "c0": c_mid_lo, "c1": c_mid_hi, "side": bypass_side}
    else:
        r_top, r_mid_lo, r_mid_hi, r_bottom = 1, 1, h2 - 2, h2 - 1
        if not (r_top == r_mid_lo < r_mid_hi < r_bottom):
            return None
        cols = list(range(1, w2 - 1))
        if len(cols) < 3:
            return None
        bypass_side = random.choice(["left", "right"])
        if bypass_side == "left":
            special_cols = [c for c in cols if c >= extra]
        else:
            special_cols = [c for c in cols if H - (c + n) >= extra]
        if not special_cols:
            return None
        c_mid = random.choice(special_cols)
        others = [c for c in cols if c != c_mid]
        if len(others) < 2:
            return None
        c0, c2 = random.sample(others, 2)
        waypoints = [(r_top, c0), (r_mid_hi, c0), (r_mid_hi, c_mid), (r_mid_lo, c_mid), (r_mid_lo, c2), (r_bottom, c2)]
        segment = {"orientation": "v", "c": c_mid, "r0": r_mid_lo, "r1": r_mid_hi, "side": bypass_side}

    path = _expand_waypoints(waypoints)
    return path, segment


def _obstacle_width(span: int, n: int) -> int:
    width = min(n + 1, max(2, span - 2))
    if width == n:
        if width + 1 <= span - 2:
            width += 1
        elif width - 1 >= 2:
            width -= 1
    return width


def _insert_horizontal_obstacle(grid: np.ndarray, n: int, r: int, c0: int, c1: int, side: str, reached: bool) -> bool:
    H, W = grid.shape
    extra = n + 1 if reached else n - 1
    if extra <= 0:
        return False

    px0 = min(c0, c1)
    px1 = max(c0, c1) + n
    chamber_left = px0 + n
    chamber_right = px1 - n
    span = chamber_right - chamber_left
    if span < 4:
        return False
    obs_w = _obstacle_width(span, n)
    if obs_w >= span:
        return False
    obs_left = chamber_left + (span - obs_w) // 2
    obs_right = obs_left + obs_w

    if side == "down":
        if r + n + extra > H:
            return False
        area = grid[r + n : r + n + extra, chamber_left:chamber_right]
        if area.size == 0 or np.any(area != _BG):
            return False
        grid[r + n : r + n + extra, chamber_left:chamber_right] = _RIVER
    else:
        if r - extra < 0:
            return False
        area = grid[r - extra : r, chamber_left:chamber_right]
        if area.size == 0 or np.any(area != _BG):
            return False
        grid[r - extra : r, chamber_left:chamber_right] = _RIVER

    obs = grid[r : r + n, obs_left:obs_right]
    if obs.size == 0 or np.any(obs != _RIVER):
        return False
    grid[r : r + n, obs_left:obs_right] = _OBST
    return True


def _insert_vertical_obstacle(grid: np.ndarray, n: int, c: int, r0: int, r1: int, side: str, reached: bool) -> bool:
    H, W = grid.shape
    extra = n + 1 if reached else n - 1
    if extra <= 0:
        return False

    py0 = min(r0, r1)
    py1 = max(r0, r1) + n
    chamber_top = py0 + n
    chamber_bottom = py1 - n
    span = chamber_bottom - chamber_top
    if span < 4:
        return False
    obs_h = _obstacle_width(span, n)
    if obs_h >= span:
        return False
    obs_top = chamber_top + (span - obs_h) // 2
    obs_bottom = obs_top + obs_h

    if side == "right":
        if c + n + extra > W:
            return False
        area = grid[chamber_top:chamber_bottom, c + n : c + n + extra]
        if area.size == 0 or np.any(area != _BG):
            return False
        grid[chamber_top:chamber_bottom, c + n : c + n + extra] = _RIVER
    else:
        if c - extra < 0:
            return False
        area = grid[chamber_top:chamber_bottom, c - extra : c]
        if area.size == 0 or np.any(area != _BG):
            return False
        grid[chamber_top:chamber_bottom, c - extra : c] = _RIVER

    obs = grid[obs_top:obs_bottom, c : c + n]
    if obs.size == 0 or np.any(obs != _RIVER):
        return False
    grid[obs_top:obs_bottom, c : c + n] = _OBST
    return True


def _variant_effect_stats(grid: np.ndarray) -> dict:
    g = np.array(grid, dtype=int)
    bg = int(Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0])
    mover, dest = _pick_roles(_solid_squares(g, bg), *g.shape)
    n = int(mover["n"])
    sr, sc = int(mover["r0"]), int(mover["c0"])
    dr, dc = int(dest["r0"]), int(dest["c0"])

    trav_with = (g == _RIVER) | (g == _MOVER) | (g == _DEST)
    trav_without = trav_with | (g == _OBST)
    feas_with = _feasible_mask(trav_with, n)
    feas_without = _feasible_mask(trav_without, n)
    dist_with = _bfs_placement(feas_with, sr, sc)
    dist_without = _bfs_placement(feas_without, sr, sc)
    return {
        "obstacle_pixels": int((g == _OBST).sum()),
        "feasible_loss": int(feas_without.sum() - feas_with.sum()),
        "dest_with": int(dist_with[dr, dc]) if feas_with[dr, dc] else -1,
        "dest_without": int(dist_without[dr, dc]) if feas_without[dr, dc] else -1,
    }


def _gen_attempt(reached: bool | None = None) -> np.ndarray | None:
    if reached is None:
        reached = random.random() < 0.5
    n = random.choice([1, 2, 3, 4]) if reached else random.choice([2, 3, 4])

    min_size = max(10, 3 * n + 4)
    if min_size > 20:
        return None
    H = W = random.randint(min_size, 20)

    spec = _choose_path_spec(H, n)
    if spec is None:
        return None
    path, segment = spec

    grid = np.full((H, W), _BG, dtype=int)
    _paint_path(grid, path, n)

    if segment["orientation"] == "h":
        ok = _insert_horizontal_obstacle(
            grid, n, int(segment["r"]), int(segment["c0"]), int(segment["c1"]), str(segment["side"]), reached
        )
    else:
        ok = _insert_vertical_obstacle(
            grid, n, int(segment["c"]), int(segment["r0"]), int(segment["r1"]), str(segment["side"]), reached
        )
    if not ok:
        return None

    sr, sc = path[0]
    dr, dc = path[-1]
    grid[sr : sr + n, sc : sc + n] = _MOVER
    grid[dr : dr + n, dc : dc + n] = _DEST

    out = main(grid)
    squares = _solid_squares(grid, _BG)
    mover, dest = _pick_roles(squares, H, W)
    n = int(mover["n"])
    sr, sc = int(mover["r0"]), int(mover["c0"])
    dr, dc = int(dest["r0"]), int(dest["c0"])

    trav = (grid == _RIVER) | (grid == _MOVER) | (grid == _DEST)
    feasible = _feasible_mask(trav, n)
    if not feasible[sr, sc]:
        return None
    dist = _bfs_placement(feasible, sr, sc)
    dest_ok = bool(feasible[dr, dc] and dist[dr, dc] >= 0)
    if reached != dest_ok:
        return None

    stats = _variant_effect_stats(grid)
    if stats["obstacle_pixels"] <= 0 or stats["feasible_loss"] <= 0:
        return None
    if reached:
        if stats["dest_with"] < 0 or stats["dest_without"] < 0:
            return None
    else:
        if not (stats["dest_with"] < 0 and stats["dest_without"] >= 0):
            return None

    if np.array_equal(out[sr : sr + n, sc : sc + n], _MOVER):
        return None
    return grid


def generate_input() -> np.ndarray:
    global _NEXT_REACHED

    target = _NEXT_REACHED
    _NEXT_REACHED = not _NEXT_REACHED

    for _ in range(350):
        result = _gen_attempt(target)
        if result is not None:
            return result
    for _ in range(150):
        result = _gen_attempt(None)
        if result is not None:
            return result
    raise RuntimeError("Failed to generate valid input after 400 attempts")

            ```

