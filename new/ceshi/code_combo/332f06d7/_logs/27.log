# Variant of 332f06d7
# Dimension: D16 — obstacle：通道中的障碍物 (obstacle)
# Change: 无显式障碍物，卡点通过通道自身变窄实现；背景色像素隐式充当'墙壁'... → 显式障碍色块

from __future__ import annotations

from collections import Counter, defaultdict, deque
import random

import numpy as np

from arc_utils import bbox_h, bbox_w, find_components


"""
design_analysis:
  variant_core:
    original: |
      蓝色河道本身会被挖窄到 < n，黑色 n×n 方块因此在几何卡口前停下。
      阻挡信息来自“哪里不是蓝色”，墙是隐式背景。
    new_variant: |
      河道主体仍然是蓝色，但卡口/绕行信息改由河道内部的显式障碍色块表达。
      障碍物直接占据河道中的一部分蓝色像素，方块只能在完整 n×n 窗口不碰障碍时移动。
      可达样例：河道在障碍旁额外扩出一个侧袋，净空 >= n，所以方块能侧移绕过障碍。
      不可达样例：仍然扩出侧袋，但净空故意只有 n-1，河水像素连通、人眼看得出“后面还有路”，
      但 n×n 方块过不去，因此会停在障碍前的最远可达位置。
  concrete_pixel_form:
    colors:
      background: 3
      river: 1
      mover: 0
      destination: 2
      obstacle: 8
    objects:
      mover: 黑色实心 n×n 正方形，靠近边缘但不接触边界
      destination: 红色实心 n×n 正方形，接触某一条边界
      river: 蓝色蜿蜒通道，基础宽度仍是 n
      obstacle: 青色矩形“舌头”，从通道一侧伸进河道内部，占据原本可走的蓝色区域
    local_mechanism_example: |
      设 n=3，原题在一段水平河道里通过把通道挖成宽度 2 来阻挡。
      现在改成：水平河道基础高度仍为 3，但在中段下方再扩出 2 或 4 行蓝色侧袋，
      然后把该段原本的 3×k 中央通路改涂成障碍色。
      - 侧袋高度为 4 时，3×3 方块可以先向下平移，再水平通过障碍，再向上回到主河道。
      - 侧袋高度为 2 时，蓝色像素对单像素观察者仍连通，但任何 3×3 窗口都会碰到障碍，所以卡住。
  complexity_calibration:
    why_not_too_simple: |
      若仅在 n 宽走廊里放障碍，所有障碍都会退化成“完全堵死”，无法出现“绕过”这一新行为。
      因此必须局部加宽河道形成侧袋，让“障碍导致绕行”和“障碍导致阻挡”都可见。
    controlled_freedom: |
      只引入一种新颜色（障碍色 8）和一种局部结构（单侧袋 + 障碍舌头），
      保持颜色数和对象类型都少，避免多种障碍形态混杂导致规则难以归纳。
  implicit_assumption_audit:
    original_solver_dependencies:
      - 原代码用颜色数值排序决定 mover/dest，这对原题“黑<红”恰好无害，但属于不可见数值规则。
      - 原代码把除背景/两方块外的最常见颜色视为 river；变体中会新增 obstacle 色，因此仍需区分两种剩余颜色。
      - 原代码把 traversable 定义为 river ∪ mover ∪ dest；变体里必须继续排除 obstacle，否则会把障碍当成可通行蓝河。
      - 原代码的“卡住”来源于蓝河自身变窄；变体下 solver 不能再假定所有非背景像素都可走。
    new_solver_choices:
      - mover/dest 通过可见空间关系识别：接触边界的是 destination，近边但不接触的是 mover。
      - river 取剩余颜色里像素数最多者，其他剩余颜色统统视为障碍。
      - BFS 仍在 n×n 可行 top-left 放置网格上做，核心运动逻辑不变，只是可行窗口会被障碍裁掉。
  placement_legality:
    generator_guarantees:
      - 只生成 10-20 的方形网格，且 n=1..4。
      - mover 和 destination 始终是两个同尺寸实心正方形，不与障碍重叠。
      - 障碍矩形宽高故意不等于 n，避免被 solver 误识别为第三个“候选方块”。
      - 侧袋扩展区域要求当前全为背景，避免与其他河段重叠造成杂乱。
      - 每个候选样例都用 main(input) 回算，并检查 reachable / stuck 分支是否符合预期。
  visual_observability:
    human_view: |
      从少量样例中，人类能直接看到：
      1. 黑方块沿蓝河移动；
      2. 青色障碍在河道内部，而不是外部墙壁；
      3. 有的样例方块绕过障碍，有的样例在障碍前停止。
      这些差异全部来自可见结构，不依赖颜色编号、遍历顺序或隐藏排序。
  cleanliness:
    notes:
      - 只在一段中段河道上制造一个局部障碍结构，避免全图到处散落障碍导致阅读负担。
      - 侧袋和障碍保持矩形、方向清晰，视觉上易于辨认“河道主体 / 绕行空间 / 阻挡舌头”。
  new_main_assumptions_to_match_generator:
    - 输入中恰有一组尺寸重复至少两次的实心正方形，其中一个接触边界、另一个不接触边界。
    - 除背景和这两个方块外，剩余颜色里像素数最多的是 river，其余颜色都是 obstacle。
    - mover 的起点是一个可行 n×n 放置位置；generator 会在返回前验证这一点。
"""


_BG, _RIVER, _MOVER, _DEST, _OBST = 3, 1, 0, 2, 8
_DIR4 = [(1, 0), (-1, 0), (0, 1), (0, -1)]
_NEXT_REACHED = False


def _solid_squares(g: np.ndarray, bg: int) -> list[dict]:
    squares: list[dict] = []
    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict"):
        col = int(comp["color"])
        b = comp["bbox"]
        if bbox_h(b) != bbox_w(b):
            continue
        patch = g[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1]
        if not bool((patch == col).all()):
            continue
        squares.append({"col": col, "r0": int(b[0]), "c0": int(b[1]), "n": int(bbox_h(b))})
    return squares


def _touches_edge(square: dict, H: int, W: int) -> bool:
    r0, c0, n = int(square["r0"]), int(square["c0"]), int(square["n"])
    return r0 == 0 or c0 == 0 or r0 + n == H or c0 + n == W


def _edge_gap(square: dict, H: int, W: int) -> int:
    r0, c0, n = int(square["r0"]), int(square["c0"]), int(square["n"])
    return min(r0, c0, H - (r0 + n), W - (c0 + n))


def _pick_roles(squares: list[dict], H: int, W: int) -> tuple[dict, dict]:
    by_n: dict[int, list[dict]] = defaultdict(list)
    for s in squares:
        by_n[int(s["n"])].append(s)
    nside = max((n for n, group in by_n.items() if len(group) >= 2), key=lambda n: (len(by_n[n]), n))
    cand = list(by_n[nside])

    edge_touching = [s for s in cand if _touches_edge(s, H, W)]
    interior = [s for s in cand if not _touches_edge(s, H, W)]
    assert edge_touching and interior

    dest = min(edge_touching, key=lambda s: _edge_gap(s, H, W))
    mover = min(interior, key=lambda s: _edge_gap(s, H, W))
    return mover, dest


def _remaining_colors(g: np.ndarray, excluded: set[int]) -> list[tuple[int, int]]:
    counts = Counter(map(int, g.flatten()))
    items = [(int(col), int(ct)) for col, ct in counts.items() if int(col) not in excluded]
    items.sort(key=lambda kv: (-kv[1], kv[0]))
    return items


def _feasible_mask(trav: np.ndarray, n: int) -> np.ndarray:
    H, W = trav.shape
    h2, w2 = H - n + 1, W - n + 1
    feasible = np.zeros((h2, w2), dtype=bool)
    for r in range(h2):
        for c in range(w2):
            feasible[r, c] = bool(trav[r : r + n, c : c + n].all())
    return feasible


def _bfs_placement(feasible: np.ndarray, sr: int, sc: int) -> np.ndarray:
    h2, w2 = feasible.shape
    dist = -np.ones((h2, w2), dtype=int)
    dist[sr, sc] = 0
    q = deque([(sr, sc)])
    while q:
        r, c = q.popleft()
        for dr, dc in _DIR4:
            rr, cc = r + dr, c + dc
            if 0 <= rr < h2 and 0 <= cc < w2 and feasible[rr, cc] and dist[rr, cc] == -1:
                dist[rr, cc] = dist[r, c] + 1
                q.append((rr, cc))
    return dist


def _pick_terminal(dist: np.ndarray, sr: int, sc: int, dr: int, dc: int, feasible: np.ndarray) -> tuple[int, int]:
    if 0 <= dr < feasible.shape[0] and 0 <= dc < feasible.shape[1] and feasible[dr, dc] and dist[dr, dc] >= 0:
        return dr, dc
    best = -1
    tr, tc = sr, sc
    for r in range(feasible.shape[0]):
        for c in range(feasible.shape[1]):
            if int(dist[r, c]) > best:
                best = int(dist[r, c])
                tr, tc = r, c
    return tr, tc


def main(grid: np.ndarray) -> np.ndarray:
    g = np.array(grid, dtype=int)
    H, W = g.shape

    bg = int(Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0])
    squares = _solid_squares(g, bg)
    assert len(squares) >= 2

    mover, dest = _pick_roles(squares, H, W)
    n = int(mover["n"])
    sr, sc = int(mover["r0"]), int(mover["c0"])
    dr, dc = int(dest["r0"]), int(dest["c0"])

    rem = _remaining_colors(g, {bg, int(mover["col"]), int(dest["col"])})
    assert rem
    river = int(rem[0][0])
    obstacle_colors = {int(col) for col, _ in rem[1:]}

    trav = (g == river) | (g == int(mover["col"])) | (g == int(dest["col"]))
    for obs in obstacle_colors:
        trav &= g != obs

    feasible = _feasible_mask(trav, n)
    assert feasible[sr, sc]
    dist = _bfs_placement(feasible, sr, sc)
    tr, tc = _pick_terminal(dist, sr, sc, dr, dc, feasible)

    out = g.copy()
    out[sr : sr + n, sc : sc + n] = river
    out[tr : tr + n, tc : tc + n] = int(mover["col"])
    return out


def _step_range(a: int, b: int) -> list[int]:
    step = 1 if b >= a else -1
    return list(range(a, b + step, step))


def _expand_waypoints(waypoints: list[tuple[int, int]]) -> list[tuple[int, int]]:
    path = [waypoints[0]]
    for (r0, c0), (r1, c1) in zip(waypoints, waypoints[1:]):
        if r0 == r1:
            for c in _step_range(c0, c1)[1:]:
                path.append((r0, c))
        else:
            for r in _step_range(r0, r1)[1:]:
                path.append((r, c0))
    return path


def _paint_path(grid: np.ndarray, path: list[tuple[int, int]], n: int) -> None:
    for r, c in path:
        grid[r : r + n, c : c + n] = _RIVER


def _choose_path_spec(H: int, n: int) -> tuple[list[tuple[int, int]], dict] | None:
    h2 = H - n + 1
    w2 = H - n + 1
    if h2 < 7 or w2 < 7:
        return None

    horizontal = random.random() < 0.5
    extra = n + 1

    if horizontal:
        c_left, c_mid_lo, c_mid_hi, c_right = 1, 1, w2 - 2, w2 - 1
        if not (c_left == c_mid_lo < c_mid_hi < c_right):
            return None
        rows = list(range(1, h2 - 1))
        if len(rows) < 3:
            return None
        bypass_side = random.choice(["up", "down"])
        if bypass_side == "up":
            special_rows = [r for r in rows if r >= extra]
        else:
            special_rows = [r for r in rows if H - (r + n) >= extra]
        if not special_rows:
            return None
        r_mid = random.choice(special_rows)
        others = [r for r in rows if r != r_mid]
        if len(others) < 2:
            return None
        r0, r2 = random.sample(others, 2)
        waypoints = [(r0, c_left), (r0, c_mid_hi), (r_mid, c_mid_hi), (r_mid, c_mid_lo), (r2, c_mid_lo), (r2, c_right)]
        segment = {"orientation": "h", "r": r_mid, "c0": c_mid_lo, "c1": c_mid_hi, "side": bypass_side}
    else:
        r_top, r_mid_lo, r_mid_hi, r_bottom = 1, 1, h2 - 2, h2 - 1
        if not (r_top == r_mid_lo < r_mid_hi < r_bottom):
            return None
        cols = list(range(1, w2 - 1))
        if len(cols) < 3:
            return None
        bypass_side = random.choice(["left", "right"])
        if bypass_side == "left":
            special_cols = [c for c in cols if c >= extra]
        else:
            special_cols = [c for c in cols if H - (c + n) >= extra]
        if not special_cols:
            return None
        c_mid = random.choice(special_cols)
        others = [c for c in cols if c != c_mid]
        if len(others) < 2:
            return None
        c0, c2 = random.sample(others, 2)
        waypoints = [(r_top, c0), (r_mid_hi, c0), (r_mid_hi, c_mid), (r_mid_lo, c_mid), (r_mid_lo, c2), (r_bottom, c2)]
        segment = {"orientation": "v", "c": c_mid, "r0": r_mid_lo, "r1": r_mid_hi, "side": bypass_side}

    path = _expand_waypoints(waypoints)
    return path, segment


def _obstacle_width(span: int, n: int) -> int:
    width = min(n + 1, max(2, span - 2))
    if width == n:
        if width + 1 <= span - 2:
            width += 1
        elif width - 1 >= 2:
            width -= 1
    return width


def _insert_horizontal_obstacle(grid: np.ndarray, n: int, r: int, c0: int, c1: int, side: str, reached: bool) -> bool:
    H, W = grid.shape
    extra = n + 1 if reached else n - 1
    if extra <= 0:
        return False

    px0 = min(c0, c1)
    px1 = max(c0, c1) + n
    chamber_left = px0 + n
    chamber_right = px1 - n
    span = chamber_right - chamber_left
    if span < 4:
        return False
    obs_w = _obstacle_width(span, n)
    if obs_w >= span:
        return False
    obs_left = chamber_left + (span - obs_w) // 2
    obs_right = obs_left + obs_w

    if side == "down":
        if r + n + extra > H:
            return False
        area = grid[r + n : r + n + extra, chamber_left:chamber_right]

