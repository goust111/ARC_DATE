+
+def _frame_mask_from_shape(shape_coords: tuple[tuple[int, int], ...], n: int, gap_side: str) -> np.ndarray:
+    m = n + 2
+    mask = np.zeros((m, m), dtype=bool)
+    mask[0, :] = True
+    mask[-1, :] = True
+    mask[:, 0] = True
+    mask[:, -1] = True
