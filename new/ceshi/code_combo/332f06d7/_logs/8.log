+
+def _hamiltonian_walk(rows: int, cols: int, start: tuple[int, int], end: tuple[int, int]):
+    total = rows * cols
+    best_path = None
+    best_len = 0
+    for _attempt in range(80):
+        visited = {start}
+        path = [start]
+        cur = start
+        while True:
+            if cur == end and len(path) >= total * 0.7:
+                if len(path) > best_len:
+                    best_path = list(path)
+                    best_len = len(path)
+                break
+            neighbors = []
+            for dr, dc in _DIR4:
+                nr = int(cur[0] + dr)
+                nc = int(cur[1] + dc)
+                if 0 <= nr < rows and 0 <= nc < cols and (nr, nc) not in visited:
+                    neighbors.append((nr, nc))
+            if not neighbors:
+                break
+            valid = []
+            for nb in neighbors:
+                if nb == end:
+                    valid.append(nb)
+                    continue
+                test_visited = visited | {nb}
+                seen = {end}
+                q = deque([end])
+                while q:
+                    cr, cc = q.popleft()
+                    for dr2, dc2 in _DIR4:
+                        nr2 = int(cr + dr2)
+                        nc2 = int(cc + dc2)
+                        if 0 <= nr2 < rows and 0 <= nc2 < cols and (nr2, nc2) not in test_visited and (nr2, nc2) not in seen:
+                            seen.add((nr2, nc2))
+                            q.append((nr2, nc2))
+                for dr2, dc2 in _DIR4:
+                    ar = int(nb[0] + dr2)
+                    ac = int(nb[1] + dc2)
+                    if 0 <= ar < rows and 0 <= ac < cols and (ar, ac) not in test_visited and (ar, ac) in seen:
+                        valid.append(nb)
+                        break
+            if not valid:
+                break
+            random.shuffle(valid)
+            nxt = valid[0]
+            visited.add(nxt)
+            path.append(nxt)
+            cur = nxt
+        if best_path and best_len >= total * 0.85:
+            break
+    return best_path
