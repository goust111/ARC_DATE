+def _expand_walk(walk, offsets_r, offsets_c):
+    path = [(int(offsets_r[walk[0][0]]), int(offsets_c[walk[0][1]]))]
+    for cr, cc in walk[1:]:
+        tr = int(offsets_r[cr])
+        tc = int(offsets_c[cc])
+        r, c = path[-1]
+        while (r, c) != (tr, tc):
+            if r < tr:
+                r += 1
+            elif r > tr:
+                r -= 1
+            elif c < tc:
+                c += 1
+            else:
+                c -= 1
+            path.append((int(r), int(c)))
+    return path
