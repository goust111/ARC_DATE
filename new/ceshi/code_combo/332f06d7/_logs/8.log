+    if dock_edge == "top" and dock_anchor[0] != 1:
+        return None
+    if dock_edge == "bottom" and dock_anchor[0] != h2 - 2:
+        return None
+    if dock_edge == "left" and dock_anchor[1] != 1:
+        return None
+    if dock_edge == "right" and dock_anchor[1] != w2 - 2:
