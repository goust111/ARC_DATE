+    c0 = int(frame["c0"])
+    patch = grid[r0 : int(frame["r1"]) + 1, c0 : int(frame["c1"]) + 1]
+    for gap_side in _SIDES:
+        if np.array_equal(patch == _DEST, _frame_mask_from_shape(shape_coords, n, gap_side)):
