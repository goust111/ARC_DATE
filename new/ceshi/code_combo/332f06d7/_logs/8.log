+
+def _expand_walk(walk, offsets_r, offsets_c):
+    path = [(int(offsets_r[walk[0][0]]), int(offsets_c[walk[0][1]]))]
+    for cr, cc in walk[1:]:
+        tr = int(offsets_r[cr])
+        tc = int(offsets_c[cc])
