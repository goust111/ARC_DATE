+
+def _compute_feasible(trav: np.ndarray, coords: tuple[tuple[int, int], ...], n: int) -> np.ndarray:
+    H, W = trav.shape
+    h2 = H - n + 1
+    w2 = W - n + 1
+    feasible = np.zeros((h2, w2), dtype=bool)
+    for r in range(h2):
+        for c in range(w2):
+            ok = True
+            for dr, dc in coords:
+                if not bool(trav[int(r + dr), int(c + dc)]):
+                    ok = False
+                    break
