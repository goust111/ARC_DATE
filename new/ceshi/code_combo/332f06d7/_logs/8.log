+            valid = []
+            for nb in neighbors:
+                if nb == end:
+                    valid.append(nb)
+                    continue
+                test_visited = visited | {nb}
+                seen = {end}
+                q = deque([end])
+                while q:
+                    cr, cc = q.popleft()
+                    for dr2, dc2 in _DIR4:
+                        nr2 = int(cr + dr2)
+                        nc2 = int(cc + dc2)
