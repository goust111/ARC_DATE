+def _extend_path_to_dock(path, h2: int, w2: int, shape_coords: tuple[tuple[int, int], ...], n: int):
+    used = set(path)
+    r, c = path[-1]
+    edges = _dock_edges_for_shape(shape_coords, n)
+    random.shuffle(edges)
+    candidates = []
+    for edge in edges:
+        rr, cc = int(r), int(c)
+        seq = []
+        while True:
+            if edge == "top":
+                if rr == 1:
+                    break
+                rr -= 1
+            elif edge == "bottom":
+                if rr == h2 - 2:
+                    break
+                rr += 1
+            elif edge == "left":
+                if cc == 1:
+                    break
+                cc -= 1
+            else:
