+    if "bottom" in sides:
+        edges.append("top")
+    if "top" in sides:
+        edges.append("bottom")
+    if "right" in sides:
+        edges.append("left")
+    if "left" in sides:
+        edges.append("right")
+    return [edge for edge in edges if _approach_works(coords, n, edge)]
