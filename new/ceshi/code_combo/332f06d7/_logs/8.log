+        visited = {start}
+        path = [start]
+        cur = start
+        while True:
+            if cur == end and len(path) >= total * 0.7:
+                if len(path) > best_len:
+                    best_path = list(path)
+                    best_len = len(path)
+                break
+            neighbors = []
+            for dr, dc in _DIR4:
+                nr = int(cur[0] + dr)
+                nc = int(cur[1] + dc)
+                if 0 <= nr < rows and 0 <= nc < cols and (nr, nc) not in visited:
+                    neighbors.append((nr, nc))
+            if not neighbors:
+                break
+            valid = []
+            for nb in neighbors:
+                if nb == end:
+                    valid.append(nb)
+                    continue
+                test_visited = visited | {nb}
+                seen = {end}
