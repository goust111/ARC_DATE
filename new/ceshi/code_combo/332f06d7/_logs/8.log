+def _count_turns(path) -> int:
+    turns = 0
+    for i in range(1, len(path) - 1):
+        a = path[i - 1]
+        b = path[i]
+        c = path[i + 1]
+        d1 = (int(b[0] - a[0]), int(b[1] - a[1]))
+        d2 = (int(c[0] - b[0]), int(c[1] - b[1]))
+        if d1 != d2:
