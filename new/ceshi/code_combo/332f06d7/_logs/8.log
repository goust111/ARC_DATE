+# Combo variant of 332f06d7 (index 8)
+# combo_spec: D4/1+D5/3
+# Name: L形移动体+对接停靠
+
+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+from scipy.ndimage import label as scipy_label
