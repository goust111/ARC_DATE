   121	def _legend_order(g: np.ndarray, bg: int, target_colors: set[int]) -> list[int]:
   122	    singles: list[tuple[int, int, int]] = []
   123	    for col in target_colors:
   124	        comps = [
   125	            comp
   126	            for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[col], return_format="dict")
   127	            if int(comp["area"]) == 1
   128	        ]
   129	        assert len(comps) == 1
   130	        r, c = map(int, comps[0]["coords"][0])
   131	        singles.append((r, c, int(col)))
   132	    same_row = len({r for r, _c, _col in singles}) == 1
   133	    same_col = len({c for _r, c, _col in singles}) == 1
   134	    assert same_row or same_col
   135	    if same_row:
   136	        singles.sort(key=lambda item: item[1])
   137	    else:
   138	        singles.sort(key=lambda item: item[0])
   139	    return [col for _r, _c, col in singles]
