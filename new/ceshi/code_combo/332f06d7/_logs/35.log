   157	        if any(len(parts) != 1 for parts in by_color.values()):
   158	            continue
   159	        target_colors: list[int] = []
   160	        mover_colors: list[int] = []
   161	        valid = True
   162	        for col in by_color:
   163	            singles = [
   164	                comp
   165	                for comp in find_components(
   166	                    g, bg=bg, connectivity=4, monochromatic=True, colors=[col], return_format="dict"
   167	                )
   168	                if int(comp["area"]) == 1
   169	            ]
   170	            if len(singles) == 1:
