   211	def _bfs_placement(feasible: np.ndarray, sr: int, sc: int) -> np.ndarray:
   212	    h2, w2 = feasible.shape
   213	    dist = -np.ones((h2, w2), dtype=int)
   214	    dist[sr, sc] = 0
   215	    q = deque([(sr, sc)])
   216	    while q:
   217	        r, c = q.popleft()
   218	        for dr, dc in _DIR4:
   219	            rr, cc = r + dr, c + dc
   220	            if 0 <= rr < h2 and 0 <= cc < w2 and feasible[rr, cc] and dist[rr, cc] == -1:
   221	                dist[rr, cc] = dist[r, c] + 1
   222	                q.append((rr, cc))
   223	    return dist
