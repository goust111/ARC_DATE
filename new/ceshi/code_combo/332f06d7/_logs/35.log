   142	def _infer_setup(g: np.ndarray) -> tuple[int, int, int, dict, list[dict]]:
   143	    bg = int(Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0])
   144	    squares = _solid_square_components(g, bg)
   145	    by_n: dict[int, list[dict]] = defaultdict(list)
   146	    for sq in squares:
