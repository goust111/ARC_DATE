   105	def _find_large_square(g: np.ndarray, bg: int, color: int, n: int) -> tuple[int, int, np.ndarray]:
   106	    matches: list[tuple[int, int, np.ndarray]] = []
   107	    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[color], return_format="dict"):
   108	        b = comp["bbox"]
   109	        if bbox_h(b) != n or bbox_w(b) != n or int(comp["area"]) != n * n:
   110	            continue
