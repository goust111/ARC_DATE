   200	def _compute_feasible(trav: np.ndarray, n: int) -> np.ndarray:
   201	    H, W = trav.shape
   202	    h2, w2 = H - n + 1, W - n + 1
   203	    assert h2 > 0 and w2 > 0
   204	    feasible = np.zeros((h2, w2), dtype=bool)
   205	    for r in range(h2):
   206	        for c in range(w2):
   207	            feasible[r, c] = bool(trav[r : r + n, c : c + n].all())
   208	    return feasible
