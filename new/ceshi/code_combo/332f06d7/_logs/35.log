+        if not np.array_equal(details["final_pos"], target_positions[-1]):
+            return None
+    else:
+        if metrics["ordered_reached_count"] != 1:
+            return None
+        if metrics["individually_reachable_count"] < 2:
+            return None
+        if not metrics["order_blocked_later_reachable"]:
+            return None
+    return grid
