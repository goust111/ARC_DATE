+            return None
+        if metrics["individually_reachable_count"] < 2:
+            return None
+        if not metrics["order_blocked_later_reachable"]:
+            return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
+        grid = _gen_attempt()
+        if grid is not None:
