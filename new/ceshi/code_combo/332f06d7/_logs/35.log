+        if any(offsets[i + 1] - offsets[i] <= n for i in range(4)):
+            continue
+        choices.append((G, offsets))
+    if not choices:
+        return None
+    G, offsets = random.choice(choices)
+    return G, offsets, list(offsets)
+
+
+def _gen_attempt() -> np.ndarray | None:
+    reachable = random.random() < 0.5
