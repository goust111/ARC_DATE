            ```python
            # Variant of 332f06d7
# Dimension: D12 — 通道拓扑：分支与环路 (path)
# Change: 通道为单一蜿蜒路径，无分支无环路，从起点到终点只有一条路... → 环形通道
#
# Design analysis
# - Concrete form:
#   The blue river is no longer a single chain. It is rendered as a thick rectangular loop,
#   with a black-square branch on one side and a red-square branch on the other side.
#   In reachable cases the mover can arrive at the red square by going around either side
#   of the loop, so shortest-path reasoning is now necessary. In stuck cases a chokepoint
#   narrower than N is carved only on the destination branch; the loop remains visible.
# - Behavior trace:
#   Original task: with one simple path, "stop at the farthest reachable placement" and
#   "stop at the last placement before the block" are the same thing.
#   Variant: once the reachable region contains a loop, "farthest from the start" can land
#   on a visually irrelevant opposite side of the ring. To keep the motion target-oriented,
#   the stuck fallback is changed to "among start-reachable placements, choose the one
#   closest to the destination top-left, tie-breaking by larger BFS distance from the start".
#   Reachable cases still end exactly on the red square.
# - Complexity calibration:
#   The topology change is visible without adding extra colors or extra object types.
#   Each sample still has exactly one mover square, one destination square, one river color,
#   and one background color. Freedom is limited to loop size, attachment rows, branch side
#   lengths (fixed to one outer coarse cell), square size N, and reachable/stuck branch state.
# - Implicit assumptions audited:
#   `main()` already works on a placement BFS graph, so cycles themselves are safe.
#   The only original assumption that breaks conceptually is the stuck fallback: it relied on
#   a path graph where max distance from the start was automatically "the last point before the
#   gate". The new fallback removes that hidden tree/path assumption.
# - Placement legality:
#   The generator builds a coarse graph first, renders it as an N-thick river, places mover and
#   destination at branch ends, and verifies the exact solver output with `main(input)`.
#   A loop must remain present in the start-reachable feasible-placement component.
# - Visual observability:
#   The ring is visible in the raw blue river pixels, and both the black and red squares sit on
#   side branches attached to that ring. Across examples, one can see that the mover may need to
#   travel around a cycle rather than along a single corridor.

from __future__ import annotations

from collections import Counter, defaultdict, deque
import random

import numpy as np

from arc_utils import bbox_h, bbox_w, find_components


def _bfs_placement(feasible: np.ndarray, sr: int, sc: int) -> np.ndarray:
    h2, w2 = feasible.shape
    dist = -np.ones((h2, w2), dtype=int)
    dist[sr, sc] = 0
    q = deque([(sr, sc)])
    while q:
        r, c = q.popleft()
        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
            rr, cc = r + dr, c + dc
            if 0 <= rr < h2 and 0 <= cc < w2 and feasible[rr, cc] and dist[rr, cc] == -1:
                dist[rr, cc] = dist[r, c] + 1
                q.append((rr, cc))
    return dist


def _choose_stuck_target(dist: np.ndarray, dr: int, dc: int) -> tuple[int, int]:
    best_key = None
    best_rc = None
    h2, w2 = dist.shape
    for r in range(h2):
        for c in range(w2):
            if dist[r, c] < 0:
                continue
            key = (abs(r - dr) + abs(c - dc), -int(dist[r, c]), abs(r - dr), abs(c - dc), r, c)
            if best_key is None or key < best_key:
                best_key = key
                best_rc = (r, c)
    assert best_rc is not None
    return best_rc


def _feasible_mask(trav: np.ndarray, n: int) -> np.ndarray:
    H, W = trav.shape
    h2, w2 = H - n + 1, W - n + 1
    feasible = np.zeros((h2, w2), dtype=bool)
    for r in range(h2):
        for c in range(w2):
            feasible[r, c] = bool(trav[r : r + n, c : c + n].all())
    return feasible


def main(grid: np.ndarray) -> np.ndarray:
    g = np.array(grid, dtype=int)
    H, W = g.shape

    bg = int(Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0])

    squares: list[dict] = []
    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict"):
        col = int(comp["color"])
        b = comp["bbox"]
        if bbox_h(b) != bbox_w(b):
            continue
        patch = g[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1]
        if not bool((patch == col).all()):
            continue
        squares.append({"col": col, "r0": int(b[0]), "c0": int(b[1]), "n": int(bbox_h(b))})
    assert len(squares) >= 2

    by_n: dict[int, list[dict]] = defaultdict(list)
    for sq in squares:
        by_n[int(sq["n"])].append(sq)
    nside = max(by_n.items(), key=lambda kv: (len(kv[1]), kv[0]))[0]
    cand = sorted(by_n[int(nside)], key=lambda s: int(s["col"]))
    assert len(cand) >= 2

    mover = cand[0]
    dest = cand[1]
    n = int(mover["n"])
    sr, sc = int(mover["r0"]), int(mover["c0"])
    dr, dc = int(dest["r0"]), int(dest["c0"])

    counts = Counter(map(int, g.flatten()))
    river = None
    for col, _ct in counts.most_common():
        if col == bg or col in (int(mover["col"]), int(dest["col"])):
            continue
        river = int(col)
        break
    assert river is not None

    trav = (g == river) | (g == int(mover["col"])) | (g == int(dest["col"]))
    feasible = _feasible_mask(trav, n)
    h2, w2 = feasible.shape
    assert 0 <= sr < h2 and 0 <= sc < w2
    assert feasible[sr, sc]

    dist = _bfs_placement(feasible, sr, sc)
    if 0 <= dr < h2 and 0 <= dc < w2 and feasible[dr, dc] and dist[dr, dc] >= 0:
        tr, tc = dr, dc
    else:
        tr, tc = _choose_stuck_target(dist, dr, dc)

    out = g.copy()
    out[sr : sr + n, sc : sc + n] = river
    out[tr : tr + n, tc : tc + n] = int(mover["col"])
    return out


_BG, _RIVER, _MOVER, _DEST = 3, 1, 0, 2


def _compute_offsets(G: int, n: int, count: int) -> list[int] | None:
    if count == 1:
        return [1]
    first = 1
    last = G - n - 1
    if last < first:
        return None
    step = (last - first) / (count - 1)
    return [int(round(first + i * step)) for i in range(count)]


def _rect_cycle(r0: int, c0: int, r1: int, c1: int) -> list[tuple[int, int]]:
    out: list[tuple[int, int]] = []
    for c in range(c0, c1 + 1):
        out.append((r0, c))
    for r in range(r0 + 1, r1 + 1):
        out.append((r, c1))
    for c in range(c1 - 1, c0 - 1, -1):
        out.append((r1, c))
    for r in range(r1 - 1, r0, -1):
        out.append((r, c0))
    return out


def _path_edges(path: list[tuple[int, int]], close_cycle: bool = False) -> list[tuple[tuple[int, int], tuple[int, int]]]:
    edges = [(path[i], path[i + 1]) for i in range(len(path) - 1)]
    if close_cycle and len(path) >= 2:
        edges.append((path[-1], path[0]))
    return edges


def _render_graph(
    grid: np.ndarray,
    nodes: set[tuple[int, int]],
    edges: list[tuple[tuple[int, int], tuple[int, int]]],
    n: int,
    offsets_r: list[int],
    offsets_c: list[int],
) -> dict[tuple[int, int], tuple[int, int]]:
    pixel_pos: dict[tuple[int, int], tuple[int, int]] = {}
    for cr, cc in nodes:
        pr, pc = offsets_r[cr], offsets_c[cc]
        pixel_pos[(cr, cc)] = (pr, pc)
        grid[pr : pr + n, pc : pc + n] = _RIVER
    for (a, b) in edges:
        pr1, pc1 = pixel_pos[a]
        pr2, pc2 = pixel_pos[b]
        if pr1 == pr2:
            c_lo, c_hi = min(pc1, pc2), max(pc1, pc2) + n
            grid[pr1 : pr1 + n, c_lo:c_hi] = _RIVER
        else:
            r_lo, r_hi = min(pr1, pr2), max(pr1, pr2) + n
            grid[r_lo:r_hi, pc1 : pc1 + n] = _RIVER
    return pixel_pos


def _add_chokepoint(grid: np.ndarray, pixel_pos_i: tuple[int, int], pixel_pos_j: tuple[int, int], n: int) -> None:
    H, W = grid.shape
    pr1, pc1 = pixel_pos_i
    pr2, pc2 = pixel_pos_j
    narrow_w = random.randint(1, n - 1)
    remove = n - narrow_w
    side = random.randint(0, 1)
    if pr1 == pr2:
        c_lo = min(pc1, pc2) + 1
        c_hi = max(pc1, pc2) + n - 1
        if c_hi < c_lo:
            c_lo, c_hi = min(pc1, pc2), max(pc1, pc2) + n - 1
        span = max(1, c_hi - c_lo + 1)
        cut_len = min(span, max(1, 2 * remove + 1))
        c_start = c_lo + (span - cut_len) // 2
        for c in range(c_start, c_start + cut_len):
            for k in range(remove):
                rr = pr1 + k if side == 0 else pr1 + n - 1 - k
                if 0 <= rr < H and 0 <= c < W:
                    grid[rr, c] = _BG
    else:
        r_lo = min(pr1, pr2) + 1
        r_hi = max(pr1, pr2) + n - 1
        if r_hi < r_lo:
            r_lo, r_hi = min(pr1, pr2), max(pr1, pr2) + n - 1
        span = max(1, r_hi - r_lo + 1)
        cut_len = min(span, max(1, 2 * remove + 1))
        r_start = r_lo + (span - cut_len) // 2
        for r in range(r_start, r_start + cut_len):
            for k in range(remove):
                cc = pc1 + k if side == 0 else pc1 + n - 1 - k
                if 0 <= r < H and 0 <= cc < W:
                    grid[r, cc] = _BG


def _component_has_cycle(feasible: np.ndarray, sr: int, sc: int) -> bool:
    seen = {(sr, sc)}
    q = deque([(sr, sc)])
    nodes = 0
    edges2 = 0
    h2, w2 = feasible.shape
    while q:
        r, c = q.popleft()
        nodes += 1
        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
            rr, cc = r + dr, c + dc
            if 0 <= rr < h2 and 0 <= cc < w2 and feasible[rr, cc]:
                edges2 += 1
                if (rr, cc) not in seen:
                    seen.add((rr, cc))
                    q.append((rr, cc))
    return (edges2 // 2) >= nodes


def _loop_route_stats(loop_path: list[tuple[int, int]], a: tuple[int, int], b: tuple[int, int]) -> tuple[int, int]:
    idx = {node: i for i, node in enumerate(loop_path)}
    L = len(loop_path)
    ia, ib = idx[a], idx[b]
    d1 = (ib - ia) % L
    d2 = (ia - ib) % L
    return min(d1, d2), max(d1, d2)


def _pick_attachments(rows: int, cols: int, loop_path: list[tuple[int, int]]) -> tuple[tuple[int, int], tuple[int, int]]:
    r0, c0 = 1, 1
    r1, c1 = rows - 2, cols - 2
    left = [(r, c0) for r in range(r0, r1 + 1)]
    right = [(r, c1) for r in range(r0, r1 + 1)]
    pairs = []
    for a in left:
        for b in right:
            short_arc, long_arc = _loop_route_stats(loop_path, a, b)
            pairs.append((abs(long_arc - short_arc), short_arc, -abs(a[0] - b[0]), a, b))
    pairs.sort(reverse=True)
    best = pairs[: max(1, min(4, len(pairs)))]
    _, _, _, start_attach, dest_attach = random.choice(best)
    return start_attach, dest_attach


def _expected_target(grid: np.ndarray, n: int, mover_r: int, mover_c: int, dest_r: int, dest_c: int) -> tuple[int, int, bool]:
    trav = (grid == _RIVER) | (grid == _MOVER) | (grid == _DEST)
    feasible = _feasible_mask(trav, n)
    if not feasible[mover_r, mover_c]:
        raise ValueError("mover placement is not feasible")
    if not _component_has_cycle(feasible, mover_r, mover_c):
        raise ValueError("reachable placement graph lost its loop")
    dist = _bfs_placement(feasible, mover_r, mover_c)
    dest_ok = 0 <= dest_r < feasible.shape[0] and 0 <= dest_c < feasible.shape[1] and feasible[dest_r, dest_c] and dist[dest_r, dest_c] >= 0
    if dest_ok:
        return dest_r, dest_c, True
    tr, tc = _choose_stuck_target(dist, dest_r, dest_c)
    return tr, tc, False


def _choose_layout(n: int) -> tuple[int, int, int, list[int], list[int]] | None:
    choices = []
    for G in range(max(12, 4 * n + 4), 21):
        for rows in range(6, 3, -1):
            for cols in range(6, 3, -1):
                offsets_r = _compute_offsets(G, n, rows)
                offsets_c = _compute_offsets(G, n, cols)
                if offsets_r is None or offsets_c is None:
                    continue
                if any(offsets_r[i + 1] - offsets_r[i] < n for i in range(rows - 1)):
                    continue
                if any(offsets_c[i + 1] - offsets_c[i] < n for i in range(cols - 1)):
                    continue
                area_score = (rows - 2) * (cols - 2)
                choices.append((area_score, G, rows, cols, offsets_r, offsets_c))
    if not choices:
        return None
    choices.sort(reverse=True)
    _, G, rows, cols, offsets_r, offsets_c = random.choice(choices[: max(1, min(18, len(choices)))])
    return G, rows, cols, offsets_r, offsets_c


def _gen_attempt() -> np.ndarray | None:
    reached = random.random() < 0.55
    n = random.choice([1, 2, 3, 4]) if reached else random.choice([2, 3, 4])
    layout = _choose_layout(n)
    if layout is None:
        return None
    G, rows, cols, offsets_r, offsets_c = layout

    grid = np.full((G, G), _BG, dtype=int)

    loop_path = _rect_cycle(1, 1, rows - 2, cols - 2)
    start_attach, dest_attach = _pick_attachments(rows, cols, loop_path)
    start_node = (start_attach[0], 0)
    dest_node = (dest_attach[0], cols - 1)

    loop_edges = _path_edges(loop_path, close_cycle=True)
    branch_edges = [(start_node, start_attach), (dest_attach, dest_node)]
    nodes = set(loop_path)
    nodes.add(start_node)
    nodes.add(dest_node)

    pixel_pos = _render_graph(grid, nodes, loop_edges + branch_edges, n, offsets_r, offsets_c)

    mover_r, mover_c = pixel_pos[start_node]
    dest_r, dest_c = pixel_pos[dest_node]

    if not reached:
        _add_chokepoint(grid, pixel_pos[dest_attach], pixel_pos[dest_node], n)

    grid[mover_r : mover_r + n, mover_c : mover_c + n] = _MOVER
    grid[dest_r : dest_r + n, dest_c : dest_c + n] = _DEST

    try:
        tr, tc, dest_ok = _expected_target(grid, n, mover_r, mover_c, dest_r, dest_c)
    except ValueError:
        return None

    if reached != dest_ok:
        return None

    out = grid.copy()
    out[mover_r : mover_r + n, mover_c : mover_c + n] = _RIVER
    out[tr : tr + n, tc : tc + n] = _MOVER

    if not np.array_equal(main(grid), out):
        return None
    return grid


def generate_input() -> np.ndarray:
    for _ in range(400):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("Failed to generate valid input after 400 attempts")

