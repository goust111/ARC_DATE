   241	def _build_traversable(
   242	    out: np.ndarray,
   243	    bg: int,
   244	    n: int,
   245	    river: int,
   246	    mover_col: int,
   247	    remaining_targets: list[dict],
   248	) -> tuple[int, int, np.ndarray, np.ndarray]:
   249	    sr, sc, mover_mask = _find_large_square(out, bg, mover_col, n)
   250	    trav = (out == int(river)) | mover_mask
   251	    for target in remaining_targets:
   252	        _rr, _cc, mask = _find_large_square(out, bg, int(target["col"]), n)
   253	        trav |= mask
   254	    feasible = _compute_feasible(trav, n)
   255	    assert bool(feasible[sr, sc])
   256	    return sr, sc, mover_mask, feasible
