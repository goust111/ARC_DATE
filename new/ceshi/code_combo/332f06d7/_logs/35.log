   226	def _choose_stuck_target(dist: np.ndarray, dr: int, dc: int) -> tuple[int, int]:
   227	    best_key = None
   228	    best_rc = None
   229	    for r in range(dist.shape[0]):
   230	        for c in range(dist.shape[1]):
   231	            if int(dist[r, c]) < 0:
   232	                continue
   233	            key = (abs(r - dr) + abs(c - dc), -int(dist[r, c]), abs(r - dr), abs(c - dc), r, c)
   234	            if best_key is None or key < best_key:
   235	                best_key = key
   236	                best_rc = (int(r), int(c))
   237	    assert best_rc is not None
   238	    return best_rc
