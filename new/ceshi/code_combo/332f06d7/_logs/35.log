+
+    counts = Counter(map(int, g.flatten()))
+    river = None
+    banned = {bg, int(mover_col)} | {int(t["col"]) for t in targets}
+    for col, _ct in counts.most_common():
+        if int(col) not in banned:
+            river = int(col)
