# Variant of 332f06d7
# Dimension: D16 — obstacle：通道中的障碍物 (obstacle)
# Change: 无显式障碍物，卡点通过通道自身变窄实现；背景色像素隐式充当'墙壁'... → 可推动障碍物

from __future__ import annotations

from collections import Counter, deque
import random
import numpy as np


# Design analysis for the D16 variant
# -----------------------------------
# a) Concrete behavior
#    - Keep the original visual frame: a blue winding channel on a green square grid,
#      a black mover, and a red destination.
#    - Compatibility adjustment: fix the square size to 1x1. This is deliberate, not
#      accidental. With larger NxN movers, "push the obstacle forward if there is space
#      behind it" becomes visually and algorithmically dominated by window geometry; the
#      obstacle mechanic becomes harder to see from 2-4 ARC examples. Using 1x1 keeps
#      D16 as the visible core change.
#    - Add yellow 1x1 obstacles on the channel. They sit on corner cells of the main
#      route. Past that corner, we optionally carve a short 1-2 cell dead-end pocket in
#      the mover's incoming direction. If the pocket still has one free river cell behind
#      the obstacle chain, the mover can push the whole chain one step into the pocket,
#      clear the corner, and then turn. If no free cell exists, the mover stops before
#      that corner.
#    - Small trace example:
#        original at a corner: river turns right, but the corner cell itself is open, so
#        BFS just walks through.
#        variant at the same corner: the corner cell holds a yellow obstacle; the mover
#        steps toward it. If a pocket cell exists beyond the obstacle chain, the chain is
#        shifted one cell, the mover enters the corner, and movement continues. Without
#        pocket space, the move is illegal and the mover cannot pass.
# b) Complexity calibration
#    - Obstacles are always the same color and size, and pockets are only 0-2 cells long.
#      This keeps the state space small and the rule learnable.
#    - Each sample contains at least one obstacle, and accepted samples must differ from a
#      "treat obstacles as static walls" baseline, so the generator cannot silently
#      collapse back to the original task.
# c) Old assumptions that no longer hold
#    - The original solver assumed a static traversable mask and did BFS only on mover
#      placements. That is invalid now because obstacle positions change.
#    - The original output only moved the black square; that would be wrong here because
#      pushed obstacles must appear in their new locations.
#    - The original "same-sized solid squares" detector sorted by color value. That hidden
#      ordering is unnecessary and undesirable for this variant. The generator fixes roles
#      by visible color semantics instead: black=mover, red=destination, yellow=obstacle.
# d) Placement legality
#    - The generator builds one self-avoiding orthogonal path plus optional dead-end
#      pockets. Obstacles are placed only on path or pocket cells, never outside the
#      carved channel.
#    - Pockets are checked against the path so they do not overlap the main route.
# e) Visual observability
#    - In input/output pairs, yellow boxes visibly move into nearby blue pockets. This is
#      the key cue humans can infer; it is not hidden in color ordering or in an unseen
#      numeric threshold.
# f) Visual cleanliness
#    - There are only five colors: bg green, river blue, mover black, destination red,
#      obstacle yellow. Pockets are short dead-ends rather than dense clutter.
# g) Color-rule inferability
#    - Colors have stable roles across all generated examples. No sample requires
#      inferring a latent permutation of colors.
# Main/generator contract after the change
#    - main() assumes exactly one black mover, exactly one red destination, and one or
#      more yellow obstacles, all on the non-background channel.
#    - generate_input() guarantees those conditions and also guarantees that at least one
#      obstacle push matters for the final output.


_BG = 3
_RIVER = 1
_MOVER = 0
_DEST = 2
_OBSTACLE = 4
_DIR4 = [(1, 0), (-1, 0), (0, 1), (0, -1)]


def _find_single(g: np.ndarray, color: int) -> tuple[int, int]:
    coords = np.argwhere(g == color)
    assert coords.shape[0] == 1
    return int(coords[0, 0]), int(coords[0, 1])


def _sorted_coords(mask: np.ndarray) -> tuple[tuple[int, int], ...]:
    return tuple(sorted((int(r), int(c)) for r, c in np.argwhere(mask)))


def _simulate_states(grid: np.ndarray):
    g = np.array(grid, dtype=int)
    bg = int(Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0])
    floor = {tuple(map(int, rc)) for rc in np.argwhere(g != bg)}
    mover = _find_single(g, _MOVER)
    dest = _find_single(g, _DEST)
    obstacles0 = _sorted_coords(g == _OBSTACLE)
    assert len(obstacles0) >= 1

    obstacle_floor = floor - {dest}
    start_state = (mover, obstacles0)
    q = deque([start_state])
    dist = {start_state: 0}
    best_state = start_state
    best_pos_dist = 0
    seen_pos = {mover: (0, start_state)}
    dest_state = None

    while q:
        state = q.popleft()
        (mr, mc), obstacles = state
        cur_dist = dist[state]
        if (mr, mc) == dest:
            dest_state = state
            break

        obs_set = set(obstacles)
        for dr, dc in _DIR4:
            nr, nc = mr + dr, mc + dc
            nxt = (nr, nc)
            if nxt not in floor:
                continue
            if nxt not in obs_set:
                new_state = (nxt, obstacles)
            else:
                chain = []
                cr, cc = nr, nc
                while (cr, cc) in obs_set:
                    chain.append((cr, cc))
                    cr += dr
                    cc += dc
                landing = (cr, cc)
                if landing not in obstacle_floor:
                    continue
                new_obs = set(obs_set)
                for cell in chain:
                    new_obs.remove(cell)
                for cell in chain:
                    new_obs.add((cell[0] + dr, cell[1] + dc))
                if dest in new_obs:
                    continue
                new_state = (nxt, tuple(sorted(new_obs)))
            if new_state not in dist:
                dist[new_state] = cur_dist + 1
                new_pos = new_state[0]
                if new_pos not in seen_pos:
                    seen_pos[new_pos] = (cur_dist + 1, new_state)
                    if cur_dist + 1 > best_pos_dist:
                        best_pos_dist = cur_dist + 1
                        best_state = new_state
                q.append(new_state)

    return {
        "start": start_state,
        "best": best_state,
        "best_pos_dist": best_pos_dist,
        "dest_state": dest_state,
        "dest": dest,
        "bg": bg,
    }


def _render_state(grid: np.ndarray, mover: tuple[int, int], obstacles: tuple[tuple[int, int], ...], reached: bool) -> np.ndarray:
    out = np.array(grid, dtype=int).copy()
    out[out == _MOVER] = _RIVER
    out[out == _OBSTACLE] = _RIVER
    if reached:
        out[out == _DEST] = _RIVER
    for r, c in obstacles:
        out[r, c] = _OBSTACLE
    out[mover[0], mover[1]] = _MOVER
    return out


def main(grid: np.ndarray) -> np.ndarray:
    """
    Move the black point through the blue channel toward the red goal.

    Yellow obstacle cells block motion, but a contiguous chain of yellow cells can be
    pushed forward by one step if the cell behind the chain is free river space. The
    mover keeps the old "move until the goal or stop at the farthest reachable point"
    behavior, but now the state includes obstacle positions.
    """
    sim = _simulate_states(grid)
    if sim["dest_state"] is not None:
        mover, obstacles = sim["dest_state"]
        return _render_state(grid, mover, obstacles, reached=True)
    mover, obstacles = sim["best"]
    return _render_state(grid, mover, obstacles, reached=False)


def _trace_segment(a: tuple[int, int], b: tuple[int, int]) -> list[tuple[int, int]]:
    ar, ac = a
    br, bc = b
    if ar == br:
        step = 1 if bc >= ac else -1
        return [(ar, c) for c in range(ac, bc + step, step)]
    assert ac == bc
    step = 1 if br >= ar else -1
    return [(r, ac) for r in range(ar, br + step, step)]


def _trace_polyline(vertices: list[tuple[int, int]]) -> list[tuple[int, int]]:
    cells: list[tuple[int, int]] = []
    for i in range(len(vertices) - 1):
        seg = _trace_segment(vertices[i], vertices[i + 1])
        if i:
            seg = seg[1:]
        cells.extend(seg)
    return cells


def _is_clean_path(path: list[tuple[int, int]]) -> bool:
    if len(path) != len(set(path)):
        return False
    neighbors_by_index = {}
    for idx, cell in enumerate(path):
        neighbors_by_index.setdefault(cell, set()).add(idx)
    path_set = set(path)
    for idx, (r, c) in enumerate(path):
        allowed = {idx - 1, idx + 1}
        for dr, dc in _DIR4:
            nb = (r + dr, c + dc)
            if nb not in path_set:
                continue
            for j in neighbors_by_index[nb]:
                if j not in allowed:
                    return False
    return True


def _sample_layout(size: int):
    for _ in range(200):
        rows = sorted(random.sample(range(1, size - 1), 4))
        if min(rows[i + 1] - rows[i] for i in range(3)) < 2:
            continue
        c1, c2 = sorted(random.sample(range(3, size - 2), 2))
        if c2 - c1 < 3:
            continue
        r0, r1, r2, r3 = rows[0], rows[3], rows[1], rows[2]
        vertices = [(r0, 1), (r1, 1), (r1, c1), (r2, c1), (r2, c2), (r3, c2), (r3, size - 1)]
        path = _trace_polyline(vertices)
        if _is_clean_path(path):
            return vertices, path
    return None, None


def _corner_specs(vertices: list[tuple[int, int]], path_set: set[tuple[int, int]], size: int):
    specs = []
    for i in range(1, len(vertices) - 1):
        gate = vertices[i]
        prev = vertices[i - 1]
        dr = gate[0] - prev[0]
        dc = gate[1] - prev[1]
        step = (0 if dr == 0 else dr // abs(dr), 0 if dc == 0 else dc // abs(dc))
        extras = []
        cur = gate
        while len(extras) < 2:
            cur = (cur[0] + step[0], cur[1] + step[1])
            if not (0 <= cur[0] < size and 0 <= cur[1] < size):
                break
            if cur in path_set:
                break
            extras.append(cur)
        specs.append({"gate": gate, "step": step, "extras": extras, "index": i})
    return specs


def _plan_gates(specs, reachable: bool):
    usable = [spec for spec in specs if len(spec["extras"]) >= 1]
    if reachable:
        if not usable:
            return None
        count = 1 if len(usable) == 1 else random.randint(1, 2)
        chosen = usable[:]
        random.shuffle(chosen)
        chosen = sorted(chosen[:count], key=lambda spec: spec["index"])
        plans = []
        for spec in chosen:
            chain_len = random.randint(1, min(2, len(spec["extras"])))
            plans.append(
                {
                    "gate": spec["gate"],
                    "step": spec["step"],
                    "chain_len": chain_len,
                    "pocket_len": chain_len,
                }
            )
        return plans

    if len(usable) < 2:
        return None
    usable = sorted(usable, key=lambda spec: spec["index"])
    first = random.choice(usable[:-1])
    later = [spec for spec in usable if spec["index"] > first["index"]]
    if not later:
        return None
    blocked = random.choice(later)
    first_chain = random.randint(1, min(2, len(first["extras"])))
    if len(blocked["extras"]) >= 1 and random.random() < 0.5:
        blocked_chain = min(2, len(blocked["extras"]) + 1)
    else:
        blocked_chain = 1
    return [
        {
            "gate": first["gate"],
            "step": first["step"],
            "chain_len": first_chain,
            "pocket_len": first_chain,
        },
        {
            "gate": blocked["gate"],
            "step": blocked["step"],
            "chain_len": blocked_chain,
            "pocket_len": blocked_chain - 1,
        },
    ]


def _build_grid(size: int, path: list[tuple[int, int]], plans):
    grid = np.full((size, size), _BG, dtype=int)
    path_set = set(path)

