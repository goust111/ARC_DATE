+    row_ratio = float(np.any(grid != bg, axis=1).sum()) / float(grid.shape[0])
+    col_ratio = float(np.any(grid != bg, axis=0).sum()) / float(grid.shape[1])
+    crop_area_ratio = float(crop.size) / float(grid.size)
