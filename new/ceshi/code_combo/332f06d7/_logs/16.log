+
+
+def _mask_connected(mask: np.ndarray) -> bool:
+    pts = np.argwhere(mask)
+    if len(pts) == 0:
+        return False
+    start = (int(pts[0, 0]), int(pts[0, 1]))
+    seen = {start}
+    q = deque([start])
+    while q:
+        r, c = q.popleft()
+        for dr, dc in _DIR4:
