# Dimension: D7 — 网格输出形式 (grid_shape)
# Change: 输出与输入相同尺寸，仅移动方块位置变化... → 紧凑裁剪

from __future__ import annotations

from collections import Counter, defaultdict, deque
import random

import numpy as np
from scipy.ndimage import label as scipy_label

from arc_utils import bbox_h, bbox_w, find_components


# Design analysis for the D7 variant
# ----------------------------------
# Reference task:
# - The prompt cites e87109e9 as the source-task inspiration for "tight_crop".
# - In this workspace the official JSON for e87109e9 is available, but no readable
#   solver .py exists, so the only reusable signal is the high-level crop idea plus
#   the observed fact that its outputs are smaller than inputs.
#
# a) Concretization and behavior trace
# - Input still shows one winding blue channel on a green background, with one black
#   n x n mover and one red n x n destination placed on that channel.
# - Full-output physics stay unchanged: remove the mover from its start, let it slide
#   across feasible n x n placements of the channel, either reaching the red square or
#   stopping at the farthest reachable placement before a choke.
# - New D7 change: after producing that full output, crop to the smallest axis-aligned
#   rectangle containing the whole channel region (river + mover + red square if it
#   remains). Example:
#   original full output:
#     green border around a central 12 x 14 river system
#   variant output:
#     only that 12 x 14 rectangle, with the mover already relocated inside it
# - Difference point in the pipeline:
#   original: full-grid movement result is returned directly
#   variant: full-grid movement result -> bbox(all non-bg cells) -> cropped return
#
# b) Complexity calibration
# - The movement rule is unchanged, so the task still requires understanding square
#   size, feasible-window motion, reachability, and chokepoints.
# - Tight cropping adds exactly one visible extra inference: the solver must infer the
#   relevant rectangle from the channel, not from the original grid frame.
# - To keep the crop observable, the generator always wraps the logical puzzle core in
#   at least one background cell on every side.
#
# c) Hidden-assumption audit for main()
# - Background-by-corners still holds because generated inputs keep all four outer
#   corners green after padding.
# - Square detection by monochromatic connected components still holds because mover
#   and destination remain solid monochrome squares.
# - River detection as the most common non-bg/non-square color still holds because
#   only one river color exists.
# - The old final `return out` assumed output shape equals input shape; this is the
#   only solver step that must change for D7. The movement computation itself does not
#   depend on the old shape convention.
# - New crop helper assumes the channel region is exactly the set of non-background
#   pixels in the final grid. The generator guarantees this by using only bg/river/
#   mover/dest colors and by keeping mover/dest on the river.
#
# d) Placement legality
# - The generator first creates a valid inner puzzle using the original placement and
#   chokepoint logic.
# - It then crops that inner puzzle to its own non-bg bbox and embeds it inside a
#   larger square background canvas with >= 1-cell padding on all four sides.
# - Embedding cannot create overlaps or alter reachability because it only adds pure
#   background outside the existing puzzle.
#
# e) Visual observability
# - Across examples, users can see two coupled changes:
#   1. the black square moves or gets stuck according to the river width
#   2. the surrounding green margin disappears in the output
# - No invisible property such as color index ordering is used for the new behavior.
#   Color ordering is only inherited from the base task for choosing mover vs. target.
#
# f) Visual cleanliness
# - The output contains only one cropped river system, so there is no extra legend or
#   overlay competing with the core objects.
# - Padding is outside the logical puzzle, so crop removal is visually crisp rather
#   than cluttered.
#
# g) Color-change inference
# - No new color mapping is introduced. The only color change remains the original
#   black-square movement and red-square coverage/staying behavior.
#
# h) Quantified variant check
# - The generator enforces top/bottom/left/right padding >= 1 in the final input, so
#   the returned output is always strictly smaller than the input in both dimensions.
# - This prevents silent regression to the original same-size-output task.
#
# i) New assumptions introduced by cropping
# - main() now assumes at least one non-bg pixel remains after motion. That is safe
#   because the river always exists and mover replacement never deletes the channel.
# - generate_input() ensures the cropped logical core fits inside a larger 10..20
#   square canvas with padding, so the solver always has something to crop away.


_BG, _RIVER, _MOVER, _DEST = 3, 1, 0, 2


def _detect_bg(grid: np.ndarray) -> int:
    corners = [int(grid[0, 0]), int(grid[0, -1]), int(grid[-1, 0]), int(grid[-1, -1])]
    return int(Counter(corners).most_common(1)[0][0])


def _tight_crop_non_bg(grid: np.ndarray, bg: int) -> np.ndarray:
    pts = np.argwhere(grid != int(bg))
    assert len(pts) > 0
    r0, c0 = pts.min(axis=0)
    r1, c1 = pts.max(axis=0)
    return grid[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1].copy()


