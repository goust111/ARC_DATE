# Variant of 332f06d7
# Dimension: D5 — 目标与停止条件 (dst)
# Change: 同尺寸红色(color 2)方块位于通道末端靠近网格边缘；可达时覆盖目标，不可达时停在最远可达位置
#   → 距离编码停止：黑色移动方块内部嵌入若干灰色(color 5)像素，灰色数量=最大移动步数。
#
# Design analysis
# spec:
#   kept_from_original:
#     grid: square, 12-20 on each side
#     background: color 3 dominates corners
#     river: blue winding corridor carrying one mover toward one red target
#     destination: same-size red n x n square at corridor end, touching one grid edge
#     movement_space: BFS over feasible n x n top-left placements on river/destination/mover pixels
#   D5_change_core:
#     old_stop_rule: stop came from geometry; a chokepoint narrower than n blocked the square
#     new_stop_rule: geometry never blocks; the corridor is always wide enough and the red target is
#       geometrically reachable. The mover stops after at most K placement-steps, where K is the number
#       of grey pixels inside the mover.
#   concrete_visualization:
#     mover: one n x n square whose cells are only black(0) and grey(5)
#     encoding: grey count is visible directly in the mover body; the pattern is a simple row-major
#       prefix of grey cells so humans can count it
#     channel: rendered as the union of all n x n windows along a simple self-avoiding placement path
#     output: the whole patterned mover translates intact; its old footprint becomes river blue
#   behavior_trace:
#     example:
#       n = 3, geometric path length from mover to target = 6, grey_count = 4
#       original task on the same fully wide corridor would reach the red square because no chokepoint
#       exists. In this variant the mover may only take 4 placement-steps, so it stops on the 5th path
#       position (distance 4 from the start) and the red target stays visible.
#   complexity_calibration:
#     - n is restricted to 3 or 4. This gives enough interior cells (8 or 15 usable grey counts) to make
#       the distance budget visually meaningful; n=1/2 would collapse the signal.
#     - The placement path has at least 3 turns, so the task still looks like the original winding-river
#       family rather than a trivial straight translation.
#     - The generator rejects paths that create extra feasible placements or alternate shortest routes.
#       Therefore the budget maps to one visually unambiguous stopping location.
#   implicit_assumption_audit_for_main:
#     - Original square detection assumed both special objects were solid monochrome squares. That is no
#       longer valid for the mover, so the solver now detects the red target separately and detects the
#       mover as a full square component on the {black, grey} mask.
#     - Original fallback "farthest reachable placement" depended on chokepoints and ignored the target.
#       That is no longer valid because all samples keep the target reachable. The solver now projects the
#       allowed step count onto the unique shortest path from mover to target.
#     - The solver assumes exactly one red solid square and exactly one black/grey filled square of the
#       same size. The generator guarantees this.
#   placement_legality:
#     - The generator builds a self-avoiding placement path inside the top-left placement grid, then paints
#       the river from that path. Start is near an edge but not touching; destination touches an edge.
#     - Path cells are prevented from non-consecutive 4-adjacency, which keeps the corridor clean and
#       stops accidental branches from appearing after n x n dilation.
#   observability_and_cleanliness:
#     - In stuck cases the target is still geometrically reachable through the blue corridor, so the stop
#       cannot be explained by width alone. The only changing cue is the grey count.
#     - Only five colors are used: green background, blue river, black+grey mover, red destination.
#       No hidden ordering by numeric color ids is used for any rule.

from __future__ import annotations

from collections import Counter, deque
import random

import numpy as np
from scipy.ndimage import label as scipy_label


_BG, _RIVER, _MOVER, _DEST, _GREY = 3, 1, 0, 2, 5
_DIR4 = [(1, 0), (-1, 0), (0, 1), (0, -1)]


def _bbox_of_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
    r0, c0 = coords.min(axis=0)
    r1, c1 = coords.max(axis=0)
    return int(r0), int(c0), int(r1), int(c1)


def _find_red_square(g: np.ndarray, bg: int) -> dict:
    dest_mask = g == _DEST
    lab, num = scipy_label(dest_mask.astype(int))
    squares: list[dict] = []
    for idx in range(1, int(num) + 1):
        coords = np.argwhere(lab == int(idx))
        if coords.size == 0:
            continue
        r0, c0, r1, c1 = _bbox_of_coords(coords)
        n = int(r1 - r0 + 1)
        if n != int(c1 - c0 + 1):
            continue
        patch = g[r0 : r1 + 1, c0 : c1 + 1]
        if not bool((patch == _DEST).all()):
            continue
        squares.append({"r0": r0, "c0": c0, "n": n})
    assert squares
    squares.sort(key=lambda s: (-int(s["n"]), int(s["r0"]), int(s["c0"])))
    return squares[0]


def _find_mover_square(g: np.ndarray, n: int) -> dict:
    mover_mask = (g == _MOVER) | (g == _GREY)
    lab, num = scipy_label(mover_mask.astype(int))
    cands: list[dict] = []
    for idx in range(1, int(num) + 1):
        coords = np.argwhere(lab == int(idx))
        if coords.size == 0:
            continue
        r0, c0, r1, c1 = _bbox_of_coords(coords)
        if int(r1 - r0 + 1) != int(c1 - c0 + 1):
            continue
        if int(r1 - r0 + 1) != int(n):
            continue
        patch_mask = mover_mask[r0 : r1 + 1, c0 : c1 + 1]
        if not bool(patch_mask.all()):
            continue
        patch = g[r0 : r1 + 1, c0 : c1 + 1]
        grey_count = int((patch == _GREY).sum())
        black_count = int((patch == _MOVER).sum())
        if grey_count <= 0 or black_count <= 0:
            continue
        cands.append({"r0": r0, "c0": c0, "n": n, "grey_count": grey_count, "patch": patch.copy()})
    assert cands
    cands.sort(key=lambda s: (int(s["r0"]), int(s["c0"])))
    return cands[0]


def _bfs(feasible: np.ndarray, start: tuple[int, int]) -> np.ndarray:
    h2, w2 = feasible.shape
    dist = -np.ones((h2, w2), dtype=int)
    sr, sc = start
    assert feasible[int(sr), int(sc)]
    dist[int(sr), int(sc)] = 0
    q = deque([(int(sr), int(sc))])
    while q:
        r, c = q.popleft()
        for dr, dc in _DIR4:
            rr, cc = int(r + dr), int(c + dc)
            if 0 <= rr < h2 and 0 <= cc < w2 and bool(feasible[rr, cc]) and int(dist[rr, cc]) == -1:
                dist[rr, cc] = int(dist[int(r), int(c)] + 1)
                q.append((rr, cc))
    return dist


def _choose_target(
    dist_from_start: np.ndarray,
    dist_to_dest: np.ndarray,
    dest_pos: tuple[int, int],
    budget: int,
) -> tuple[int, int]:
    dr, dc = dest_pos
    total = int(dist_from_start[int(dr), int(dc)])
    assert total >= 0
    steps = min(int(budget), total)
    cands = np.argwhere((dist_from_start == steps) & (dist_to_dest >= 0) & (dist_from_start + dist_to_dest == total))
    if cands.size:
        # Generator makes this unique; tie-breaker stays deterministic.
        best = min(
            ((int(r), int(c)) for r, c in cands),
            key=lambda p: (int(dist_to_dest[p[0], p[1]]), abs(int(p[0] - dr)) + abs(int(p[1] - dc)), int(p[0]), int(p[1])),
        )
        return best

    # Fallback for malformed inputs: move as far as possible within the budget.
    best = None
    for r, c in np.argwhere((dist_from_start >= 0) & (dist_from_start <= budget)):
        cand = (int(r), int(c))
        score = (int(dist_from_start[cand[0], cand[1]]), -int(dist_to_dest[cand[0], cand[1]] >= 0), int(cand[0]), int(cand[1]))
        if best is None or score > best[0]:
            best = (score, cand)
    assert best is not None
    return best[1]


def main(grid: np.ndarray) -> np.ndarray:
    g = np.array(grid, dtype=int)
    H, W = g.shape

    bg = int(Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0])

    dest = _find_red_square(g, bg)
    mover = _find_mover_square(g, int(dest["n"]))

    n = int(dest["n"])
    sr, sc = int(mover["r0"]), int(mover["c0"])
    dr, dc = int(dest["r0"]), int(dest["c0"])
    mover_patch = np.array(mover["patch"], dtype=int)
    budget = int(mover["grey_count"])

    counts = Counter(map(int, g.flatten()))
    river = None
    for col, _ct in counts.most_common():
        if int(col) in (int(bg), _MOVER, _GREY, _DEST):
            continue
        river = int(col)
        break
    assert river is not None

    trav = (g == int(river)) | (g == _MOVER) | (g == _GREY) | (g == _DEST)
    h2, w2 = int(H - n + 1), int(W - n + 1)
    assert h2 > 0 and w2 > 0
    assert 0 <= sr < h2 and 0 <= sc < w2 and 0 <= dr < h2 and 0 <= dc < w2

    feasible = np.zeros((h2, w2), dtype=bool)
    for r in range(h2):
        for c in range(w2):
            if bool(trav[r : r + n, c : c + n].all()):
                feasible[r, c] = True

    dist_from_start = _bfs(feasible, (sr, sc))
    assert int(dist_from_start[dr, dc]) >= 0
    dist_to_dest = _bfs(feasible, (dr, dc))

    tr, tc = _choose_target(dist_from_start, dist_to_dest, (dr, dc), budget)

    out = g.copy()
    out[sr : sr + n, sc : sc + n] = int(river)
    out[tr : tr + n, tc : tc + n] = mover_patch
    return out


def _turn_count(path: list[tuple[int, int]]) -> int:
    turns = 0
    for i in range(1, len(path) - 1):
        d1 = (int(path[i][0] - path[i - 1][0]), int(path[i][1] - path[i - 1][1]))
        d2 = (int(path[i + 1][0] - path[i][0]), int(path[i + 1][1] - path[i][1]))
        if d1 != d2:
            turns += 1
    return turns


def _make_mover_patch(n: int, grey_count: int) -> np.ndarray:
    patch = np.full((n, n), _MOVER, dtype=int)
    flat = patch.reshape(-1)
    flat[:grey_count] = _GREY
    return patch


def _render_channel(grid: np.ndarray, path: list[tuple[int, int]], n: int) -> None:
    for r, c in path:
        grid[int(r) : int(r + n), int(c) : int(c + n)] = _RIVER


def _candidate_positions(h2: int, w2: int, *, edge: bool) -> list[tuple[int, int]]:
    out = []
    if edge:
        for c in range(1, w2 - 1):
            out.append((0, c))
            out.append((h2 - 1, c))
        for r in range(1, h2 - 1):
            out.append((r, 0))
            out.append((r, w2 - 1))
    else:
        if h2 >= 3:
            for c in range(1, w2 - 1):
                out.append((1, c))
                out.append((h2 - 2, c))
        if w2 >= 3:
            for r in range(2, h2 - 2):
                out.append((r, 1))
                out.append((r, w2 - 2))
    uniq = sorted(set(out))
    random.shuffle(uniq)
    return uniq


def _can_step(
    nxt: tuple[int, int],
    cur: tuple[int, int],
    visited: set[tuple[int, int]],
    h2: int,
    w2: int,
    end: tuple[int, int],
    remaining_after: int,
) -> bool:
    nr, nc = nxt
    if not (0 <= nr < h2 and 0 <= nc < w2):
        return False
    if nxt in visited:
        return False
    for dr, dc in _DIR4:
        adj = (int(nr + dr), int(nc + dc))
        if adj in visited and adj != cur:
            return False
    dist = abs(int(nr - end[0])) + abs(int(nc - end[1]))
    if dist > remaining_after:
        return False
    if (remaining_after - dist) % 2 != 0:
        return False
    return True


def _find_path(h2: int, w2: int, start: tuple[int, int], end: tuple[int, int], total_steps: int) -> list[tuple[int, int]] | None:
    path = [start]
    visited = {start}

    def dfs(cur: tuple[int, int], remaining: int) -> bool:
        if remaining == 0:
            return cur == end

        neighbors = []
        for dr, dc in _DIR4:
            nxt = (int(cur[0] + dr), int(cur[1] + dc))
            if not _can_step(nxt, cur, visited, h2, w2, end, remaining - 1):
                continue
            neighbors.append(nxt)
        random.shuffle(neighbors)
        neighbors.sort(key=lambda p: abs(int(p[0] - end[0])) + abs(int(p[1] - end[1])))

        for nxt in neighbors:
            visited.add(nxt)
            path.append(nxt)
            if dfs(nxt, remaining - 1):
                return True
            path.pop()
            visited.remove(nxt)
        return False

    start_dist = abs(int(start[0] - end[0])) + abs(int(start[1] - end[1]))
    if start_dist > total_steps or (total_steps - start_dist) % 2 != 0:
        return None
    if dfs(start, total_steps):
        return list(path)

