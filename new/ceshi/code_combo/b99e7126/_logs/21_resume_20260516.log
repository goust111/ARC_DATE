+# Combo variant of b99e7126 (index 21)
+# combo_spec: D2/1+D11/2
+# Name: 三色源图案 + 多色分形差异化处理
+
+from functools import reduce
+from itertools import combinations
+from math import gcd
+
+import numpy as np
+import random
+
+from arc_utils import paste
+
+# Design analysis for this combo variant
+# --------------------------------------
+# source_task:
+# - Base task: b99e7126.
+# - Reference implementation consulted: D2/1 for the tricolor source-cell mechanism.
+# - The D11 part is fused as a true per-color transform rule: the three visible source colors do
+#   not all expand into literal copies. Instead they split into three grid-scale outcomes.
+#
+# a) Concrete behavior trace
+# - Original task:
+#   a 3x3 odd cell used two colors only. One color meant "paste the odd cell again" and the other
+#   color meant "leave the majority cell". The enlarged 3x3 block therefore had only two states.
+# - Fused task:
+#   the odd 3x3 source cell now contains three colors, and each color has a different cell-scale
+#   meaning inside the enlarged 3x3 block:
+#   1. main color   -> paste another copy of the tricolor source cell
+#   2. erase color  -> erase back to the ordinary majority cell
+#   3. fill color   -> paste an auxiliary two-color cell derived from the majority stencil
+# - Small trace:
+#   source row labels  = [main, erase, fill]
+#   original binary    = [odd,  majority, majority]
+#   fused transform    = [source, majority, auxiliary]
+#   difference         = the third source color is no longer collapsed into "inactive"; it causes
+#                        a visibly different repeated cell type, while the erase color explicitly
+#                        preserves the majority appearance.
+#
+# b) Complexity calibration
+# - The board geometry stays exactly the same as the original specification: 29x29 pixels,
+#   7x7 cell lattice, 3x3 interiors, 1-pixel dividers.
+# - The completed block uses only three cell types: majority, tricolor source, and auxiliary.
+#   That is enough to make the D11-style differentiated transform visible without making the task
+#   noisy or introducing too many unrelated object classes.
+# - The auxiliary cell reuses the majority cell's binary stencil with a different foreground color.
+#   This keeps the color mapping human-readable across 2-4 examples.
+#
+# c) Hidden assumption audit against the original main()
+# - Original assumption: the least frequent pattern is the only non-majority template.
+#   Broken here because the enlarged block can contain both source copies and auxiliary cells.
+#   New solver instead identifies the unique 3-color cell as the source legend.
+# - Original assumption: the odd cell can be binarized by picking its dominant color.
+#   Broken here because three source colors must stay distinguishable until the final mapping step.
+# - Original assumption: all non-active source pixels map to the same majority behavior.
+#   Broken here because one non-main source color now maps to auxiliary-fill, not to majority.
+# - Original assumption: placement search only needs boolean membership.
+#   Broken here because the visible clues include two different non-majority cell types. New
+#   placement logic matches absolute observed cells against exact source-cell colors.
+#
+# d) Placement legality
+# - The enlarged block is still exactly 3x3 cells, so the top-left offset remains in 0..4.
+# - Each cell slot holds exactly one full 3x3 interior pattern; there is no partial overlap.
+# - The generator only exposes a strict subset of the non-majority block positions and rejects any
+#   subset whose colored evidence allows more than one placement.
+#
+# e) Visual observability
+# - A human can see that the unique tricolor source cell acts as a legend. One source color reappears
+#   as full source copies; another source color reappears through an auxiliary recolor; the third
+#   source color corresponds to cells that remain ordinary majority cells.
+# - No numeric ordering on color ids is used. The inference comes only from repeated shapes and
+#   repeated color roles.
+#
+# f) Visual cleanliness
+# - The output is still one clean 3x3 overlay on a regular lattice. There is no stacking of
+#   unrelated objects in the same pixel region.
+# - The auxiliary cell is shape-compatible with the majority cell, so the completed block looks
+#   organized rather than chaotic.
+#
+# g) Color-change inferability
+# - Total palette size is 5: separator, majority background, erase/shared color, source-main color,
+#   and fill/auxiliary color.
+# - The fill color is meaningful because it appears in two linked places: inside the tricolor source
+#   cell and as the foreground of the auxiliary cells. The erase/shared color is meaningful because
+#   it appears inside both the source cell and the majority cell, signalling "keep majority here".
+#
+# h) Quantitative non-degeneration target
+# - Every generated source layout contains at least two fill-color positions and at least two
+#   source-main positions, so the enlarged block always contains both non-majority behaviors.
+# - Therefore the fused output differs from a degenerate binary-collapse interpretation on at least
+#   two cell slots in every sample.
+#
+# i) New solver assumptions and generator guarantees
+# - Solver assumes exactly one distinct 3-color cell pattern exists; generator guarantees this by
+#   using only one tricolor source pattern.
+# - Solver assumes the visible subset contains both source-copy and auxiliary-fill examples, leaving
+#   exactly one source color unmapped; generator enforces that.
+# - Solver assumes the remaining unmapped source color is the erase-to-majority behavior; generator
+#   constructs the data so only that color is absent from the visible non-majority subset.
+# - Solver assumes the majority pattern is still the most common cell pattern; generator guarantees
+#   that because the 3x3 overlay affects at most 9 of the 49 cells.
+
+CELL_GRID_N = 7
+CELL_INNER = 3
+CELL_STEP = 4
+GRID_SIZE = 29
+PLACEMENT_RANGE = CELL_GRID_N - CELL_INNER + 1
+GIVEN_CELL_SIZES = (4, 5)
+COLOR_POOL = 10
+MAX_RETRIES = 500
+
+LABEL_MAIN = 0
+LABEL_ERASE = 1
+LABEL_FILL = 2
+
+
+def _infer_cell_grid_params(g: np.ndarray) -> tuple[int, list[int], list[int]]:
+    """
+    Infer a regular cell grid separated by full rows/cols of the same line color.
+    Returns (step, row_divs, col_divs) where:
+      - row_divs/col_divs are divider indices
+      - step is the spacing between dividers (cell size including divider).
+    """
+    h, w = g.shape
+    line = int(g[0, 0])
+    row_divs = [r for r in range(h) if np.all(g[r, :] == line)]
+    col_divs = [c for c in range(w) if np.all(g[:, c] == line)]
+    assert len(row_divs) >= 2 and len(col_divs) >= 2, "need at least 2 row and 2 col dividers"
+    row_divs.sort()
+    col_divs.sort()
+    drs = [row_divs[i + 1] - row_divs[i] for i in range(len(row_divs) - 1) if row_divs[i + 1] > row_divs[i]]
+    dcs = [col_divs[i + 1] - col_divs[i] for i in range(len(col_divs) - 1) if col_divs[i + 1] > col_divs[i]]
+    step = reduce(gcd, drs + dcs)
+    assert step > 1, "divider step must be > 1"
+    assert row_divs[0] == 0 and col_divs[0] == 0, "first divider must be at index 0"
+    assert (h - 1) % step == 0 and (w - 1) % step == 0, "grid dimensions must be (k*step + 1)"
+    assert row_divs[-1] == h - 1 and col_divs[-1] == w - 1, "last divider must be at boundary"
+    return int(step), row_divs, col_divs
+
+
+def _pattern_key(arr: np.ndarray) -> tuple[int, ...]:
+    return tuple(int(v) for v in arr.ravel())
+
+
+def _extract_cells(g: np.ndarray, step: int) -> tuple[dict[tuple[int, ...], np.ndarray], list[list[tuple[int, ...]]]]:
+    n = (g.shape[0] - 1) // step
+    inner = step - 1
+    patterns: dict[tuple[int, ...], np.ndarray] = {}
+    cell_pat: list[list[tuple[int, ...]]] = []
+    for i in range(n):
+        row: list[tuple[int, ...]] = []
+        for j in range(n):
+            r0 = i * step + 1
+            c0 = j * step + 1
+            pat_arr = g[r0 : r0 + inner, c0 : c0 + inner].copy()
+            pat = _pattern_key(pat_arr)
+            if pat not in patterns:
+                patterns[pat] = pat_arr
+            row.append(pat)
+        cell_pat.append(row)
+    return patterns, cell_pat
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Complete a 3x3 fractal block by reading a tricolor source cell as a three-way action legend.
+
+    Input structure:
+    - The board is partitioned into equal 3x3 cell interiors separated by full divider rows and columns.
+    - Most cells share one majority pattern.
+    - A hidden 3x3 block contains a strict subset of visible non-majority cells, and one of those
+      visible patterns is a unique tricolor source cell.
+
+    Rule:
+    - Treat the tricolor source cell as a 3x3 legend whose three colors mean three different
+      cell-scale outcomes: copy the source cell, erase to the majority cell, or place an auxiliary
+      recolored cell.
+    - Use the already visible non-majority cells to find the unique placement of that 3x3 legend in
+      the 7x7 cell lattice and to infer which source color maps to which non-majority pattern.
+    - Complete all 9 positions of the block with the corresponding majority/source/auxiliary cell.
+
+    Key insight:
+    - The odd cell is no longer a binary mask. Its three colors are action labels, so solving the
+      task requires preserving color distinctions through placement and only then expanding them into
+      three different cell patterns.
+    """
+    g = np.asarray(grid, dtype=int)
+    step, _, _ = _infer_cell_grid_params(g)
+    n = (g.shape[0] - 1) // step
+    inner = step - 1
+
+    patterns, cell_pat = _extract_cells(g, step)
+
+    counts: dict[tuple[int, ...], int] = {}
+    for i in range(n):
+        for j in range(n):
+            p = cell_pat[i][j]
+            counts[p] = counts.get(p, 0) + 1
+
+    assert len(counts) >= 3, "variant expects majority, source, and auxiliary cell patterns"
+    majority_pat = max(counts.items(), key=lambda kv: kv[1])[0]
+
+    source_candidates = [pat for pat, arr in patterns.items() if len(np.unique(arr)) == 3]
+    assert len(source_candidates) == 1, "must have exactly one distinct tricolor source pattern"
+    source_pat = source_candidates[0]
+    source_arr = patterns[source_pat]
+    sh, sw = source_arr.shape
+    assert sh == inner and sw == inner, "source cell must match cell interior size"
+
+    existing: list[tuple[int, int, tuple[int, ...]]] = []
+    for i in range(n):
+        for j in range(n):
+            pat = cell_pat[i][j]
+            if pat != majority_pat:
+                existing.append((i, j, pat))
+    assert existing, "input must reveal non-majority cells"
+
+    observed_patterns = {pat for _, _, pat in existing}
+    assert source_pat in observed_patterns, "input must include at least one source-copy cell"
+    assert len(observed_patterns) == 2, "input should reveal exactly source-copy and auxiliary cells"
+
+    source_colors = {int(v) for v in np.unique(source_arr)}
+    assert len(source_colors) == 3, "source cell must contain exactly three colors"
+
+    candidates: list[tuple[int, int, dict[int, tuple[int, ...]]]] = []
+    for top in range(0, n - sh + 1):
+        for left in range(0, n - sw + 1):
+            color_to_pattern: dict[int, tuple[int, ...]] = {}
+            valid = True
+            for i, j, pat in existing:
+                if not (top <= i < top + sh and left <= j < left + sw):
+                    valid = False
+                    break
+                color = int(source_arr[i - top, j - left])
+                prev = color_to_pattern.get(color)
+                if prev is None:
+                    color_to_pattern[color] = pat
+                elif prev != pat:
+                    valid = False
+                    break
+            if not valid:
+                continue
+            if len(set(color_to_pattern.values())) != len(color_to_pattern):
+                continue
+            remaining_colors = [color for color in source_colors if color not in color_to_pattern]
+            if len(remaining_colors) != 1:
+                continue
+            erase_color = remaining_colors[0]
+            full_mapping = dict(color_to_pattern)
+            full_mapping[erase_color] = majority_pat
+            if len(set(full_mapping.values())) != 3:
+                continue
+            if full_mapping[int(source_arr[0, 0])] == majority_pat and np.all(source_arr == source_arr[0, 0]):
+                continue
+            candidates.append((int(top), int(left), full_mapping))
+
+    assert len(candidates) == 1, "must have a unique tricolor placement and mapping"
+    top, left, color_to_pattern = candidates[0]
+
+    out = g.copy()
+    for i in range(sh):
+        for j in range(sw):
+            pat = patterns[color_to_pattern[int(source_arr[i, j])]]
+            r0 = (top + i) * step + 1
+            c0 = (left + j) * step + 1
+            out[r0 : r0 + inner, c0 : c0 + inner] = pat
+    return out
+
+
+def _is_connected(mask: np.ndarray) -> bool:
+    coords = [tuple(coord) for coord in np.argwhere(mask)]
+    if not coords:
+        return False
+    seen = {coords[0]}
+    stack = [coords[0]]
+    while stack:
+        r, c = stack.pop()
+        for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+            if (nr, nc) in seen:
+                continue
+            if 0 <= nr < mask.shape[0] and 0 <= nc < mask.shape[1] and mask[nr, nc]:
+                seen.add((nr, nc))
+                stack.append((nr, nc))
+    return len(seen) == len(coords)
+
+
+def _precompute_majority_masks() -> list[np.ndarray]:
+    masks: list[np.ndarray] = []
+    for bits in range(1 << (CELL_INNER * CELL_INNER)):
+        mask = np.zeros((CELL_INNER, CELL_INNER), dtype=bool)
+        for idx in range(CELL_INNER * CELL_INNER):
+            if bits & (1 << idx):
+                mask[idx // CELL_INNER, idx % CELL_INNER] = True
+        count = int(mask.sum())
+        if count not in (4, 5):
+            continue
+        if not _is_connected(mask):
+            continue
+        if any(not mask[r, :].any() for r in range(CELL_INNER)):
+            continue
+        if any(not mask[:, c].any() for c in range(CELL_INNER)):
+            continue
+        if np.array_equal(mask, np.fliplr(mask)):
+            continue
+        if np.array_equal(mask, np.flipud(mask)):
+            continue
+        if np.array_equal(mask, np.rot90(mask)):
+            continue
+        masks.append(mask)
+    assert masks, "need majority mask catalog"
+    return masks
+
+
+def _precompute_source_layouts() -> list[np.ndarray]:
+    layouts: list[np.ndarray] = []
+    for bits in range(3 ** (CELL_INNER * CELL_INNER)):
+        x = bits
+        arr = np.empty((CELL_INNER, CELL_INNER), dtype=int)
+        counts = [0, 0, 0]
+        for idx in range(CELL_INNER * CELL_INNER):
+            label = x % 3
+            x //= 3
+            arr[idx // CELL_INNER, idx % CELL_INNER] = label
+            counts[label] += 1
+        if min(counts) < 2:
+            continue
+        if counts[LABEL_MAIN] not in (2, 3, 4):
+            continue
+        if counts[LABEL_ERASE] not in (2, 3, 4):
+            continue
+        if counts[LABEL_FILL] not in (2, 3, 4):
+            continue
+        if np.array_equal(arr, np.fliplr(arr)):
+            continue
+        if np.array_equal(arr, np.flipud(arr)):
+            continue
+        if np.array_equal(arr, np.rot90(arr)):
+            continue
+        if len({tuple(arr[r, :].tolist()) for r in range(CELL_INNER)}) < 3:
+            continue
+        if len({tuple(arr[:, c].tolist()) for c in range(CELL_INNER)}) < 2:
+            continue
+        layouts.append(arr)
+    assert layouts, "need source layout catalog"
+    return layouts
+
+
+_MAJORITY_MASKS = _precompute_majority_masks()
+_SOURCE_LAYOUTS = _precompute_source_layouts()
+
+
+def _random_majority_pattern(shared_color: int, majority_bg: int) -> np.ndarray:
+    mask = random.choice(_MAJORITY_MASKS)
+    return np.where(mask, shared_color, majority_bg).astype(int)
+
+
+def _random_source_layout() -> np.ndarray:
+    return random.choice(_SOURCE_LAYOUTS)
+
+
+def _source_pattern_from_layout(layout: np.ndarray, source_main: int, erase_color: int, fill_color: int) -> np.ndarray:
+    palette = np.array([source_main, erase_color, fill_color], dtype=int)
+    return palette[layout]
+
+
+def _cell_origin(i: int, j: int) -> tuple[int, int]:
+    return i * CELL_STEP + 1, j * CELL_STEP + 1
+
+
+def _build_grid(separator: int, majority: np.ndarray, cells: list[tuple[int, int, np.ndarray]]) -> np.ndarray:
+    grid = np.full((GRID_SIZE, GRID_SIZE), separator, dtype=int)
+    for i in range(CELL_GRID_N):
+        for j in range(CELL_GRID_N):
+            paste(grid, majority, *_cell_origin(i, j))
+    for i, j, pat in cells:
+        paste(grid, pat, *_cell_origin(i, j))
+    return grid
+
+
+def _placement_candidates(layout: np.ndarray, observed: list[tuple[int, int, int]]) -> list[tuple[int, int]]:
+    candidates: list[tuple[int, int]] = []
+    for top in range(PLACEMENT_RANGE):
+        for left in range(PLACEMENT_RANGE):
+            ok = True
+            for abs_r, abs_c, label in observed:
+                if not (top <= abs_r < top + CELL_INNER and left <= abs_c < left + CELL_INNER):
+                    ok = False
+                    break
+                if int(layout[abs_r - top, abs_c - left]) != label:
+                    ok = False
+                    break
+            if ok:
+                candidates.append((top, left))
+    return candidates
+
+
+def _choose_given_subset(layout: np.ndarray, top: int, left: int) -> list[tuple[int, int, int]] | None:
+    informative = [
+        (top + r, left + c, int(layout[r, c]))
+        for r in range(CELL_INNER)
+        for c in range(CELL_INNER)
+        if int(layout[r, c]) != LABEL_ERASE
+    ]
+    sizes = list(GIVEN_CELL_SIZES)
+    random.shuffle(sizes)
+    for size in sizes:
+        valid: list[list[tuple[int, int, int]]] = []
+        for subset in combinations(informative, size):
+            labels = {label for _, _, label in subset}
+            if labels != {LABEL_MAIN, LABEL_FILL}:
+                continue
+            if _placement_candidates(layout, list(subset)) == [(top, left)]:
+                valid.append(list(subset))
+        if valid:
+            return random.choice(valid)
+    return None
+
+
+def _collapsed_binary_output(separator: int, majority: np.ndarray, source: np.ndarray, layout: np.ndarray, top: int, left: int) -> np.ndarray:
+    cells: list[tuple[int, int, np.ndarray]] = []
+    for r in range(CELL_INNER):
+        for c in range(CELL_INNER):
+            if int(layout[r, c]) == LABEL_MAIN:
+                cells.append((top + r, left + c, source))
+    return _build_grid(separator, majority, cells)
+
+
+def _gen_attempt() -> tuple[np.ndarray, dict[str, int]] | None:
+    separator, majority_bg, erase_color, source_main, fill_color = random.sample(range(COLOR_POOL), 5)
+    majority = _random_majority_pattern(erase_color, majority_bg)
+    auxiliary = np.where(majority == erase_color, fill_color, majority_bg).astype(int)
+
+    layout = _random_source_layout()
+    source = _source_pattern_from_layout(layout, source_main, erase_color, fill_color)
+
+    top = random.randrange(PLACEMENT_RANGE)
+    left = random.randrange(PLACEMENT_RANGE)
+
+    full_cells: list[tuple[int, int, np.ndarray]] = []
+    main_count = 0
+    fill_count = 0
+    for r in range(CELL_INNER):
+        for c in range(CELL_INNER):
+            label = int(layout[r, c])
+            if label == LABEL_MAIN:
+                full_cells.append((top + r, left + c, source))
+                main_count += 1
+            elif label == LABEL_FILL:
+                full_cells.append((top + r, left + c, auxiliary))
+                fill_count += 1
+
+    if main_count < 2 or fill_count < 2:
+        return None
+
+    out = _build_grid(separator, majority, full_cells)
+
+    subset = _choose_given_subset(layout, top, left)
+    if subset is None:
+        return None
+
+    given_cells = [
+        (r, c, source if label == LABEL_MAIN else auxiliary)
+        for r, c, label in subset
+    ]
+    inp = _build_grid(separator, majority, given_cells)
+
+    try:
+        solved = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(solved, out):
+        return None
+
+    collapsed = _collapsed_binary_output(separator, majority, source, layout, top, left)
+    diff_cells = 0
+    for r in range(CELL_INNER):
+        for c in range(CELL_INNER):
+            if int(layout[r, c]) == LABEL_FILL:
+                rr = (top + r) * CELL_STEP + 1
+                cc = (left + c) * CELL_STEP + 1
+                if not np.array_equal(out[rr : rr + CELL_INNER, cc : cc + CELL_INNER], collapsed[rr : rr + CELL_INNER, cc : cc + CELL_INNER]):
+                    diff_cells += 1
+    if diff_cells < 2:
+        return None
+
+    metrics = {
+        "main_cells": main_count,
+        "fill_cells": fill_count,
+        "degeneracy_gap": diff_cells,
+    }
+    return inp, metrics
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_RETRIES):
+        result = _gen_attempt()
+        if result is not None:
+            grid, _ = result
+            return grid
+    raise RuntimeError("failed to generate a valid b99e7126 combo input")

diff --git a/ceshi/code_combo/b99e7126/21/code.py b/ceshi/code_combo/b99e7126/21/code.py
new file mode 100644
index 0000000000000000000000000000000000000000..5abe53fdd6b07477614360c44e12269502234842
--- /dev/null
+++ b/ceshi/code_combo/b99e7126/21/code.py
@@ -0,0 +1,500 @@
+# Combo variant of b99e7126 (index 21)
+# combo_spec: D2/1+D11/2
+# Name: 三色源图案 + 多色分形差异化处理
+
+from functools import reduce
+from itertools import combinations
+from math import gcd
+
+import numpy as np
+import random
+
+from arc_utils import paste
+
+# Design analysis for this combo variant
+# --------------------------------------
+# source_task:
+# - Base task: b99e7126.
+# - Reference implementation consulted: D2/1 for the tricolor source-cell mechanism.
+# - The D11 part is fused as a true per-color transform rule: the three visible source colors do
+#   not all expand into literal copies. Instead they split into three grid-scale outcomes.
+#
+# a) Concrete behavior trace
+# - Original task:
+#   a 3x3 odd cell used two colors only. One color meant "paste the odd cell again" and the other
+#   color meant "leave the majority cell". The enlarged 3x3 block therefore had only two states.
+# - Fused task:
+#   the odd 3x3 source cell now contains three colors, and each color has a different cell-scale
+#   meaning inside the enlarged 3x3 block:
+#   1. main color   -> paste another copy of the tricolor source cell
+#   2. erase color  -> erase back to the ordinary majority cell
+#   3. fill color   -> paste an auxiliary two-color cell derived from the majority stencil
+# - Small trace:
+#   source row labels  = [main, erase, fill]
+#   original binary    = [odd,  majority, majority]
+#   fused transform    = [source, majority, auxiliary]
+#   difference         = the third source color is no longer collapsed into "inactive"; it causes
+#                        a visibly different repeated cell type, while the erase color explicitly
+#                        preserves the majority appearance.
+#
+# b) Complexity calibration
+# - The board geometry stays exactly the same as the original specification: 29x29 pixels,
+#   7x7 cell lattice, 3x3 interiors, 1-pixel dividers.
+# - The completed block uses only three cell types: majority, tricolor source, and auxiliary.
+#   That is enough to make the D11-style differentiated transform visible without making the task
+#   noisy or introducing too many unrelated object classes.
+# - The auxiliary cell reuses the majority cell's binary stencil with a different foreground color.
+#   This keeps the color mapping human-readable across 2-4 examples.
+#
+# c) Hidden assumption audit against the original main()
+# - Original assumption: the least frequent pattern is the only non-majority template.
+#   Broken here because the enlarged block can contain both source copies and auxiliary cells.
+#   New solver instead identifies the unique 3-color cell as the source legend.
+# - Original assumption: the odd cell can be binarized by picking its dominant color.
+#   Broken here because three source colors must stay distinguishable until the final mapping step.
+# - Original assumption: all non-active source pixels map to the same majority behavior.
+#   Broken here because one non-main source color now maps to auxiliary-fill, not to majority.
+# - Original assumption: placement search only needs boolean membership.
+#   Broken here because the visible clues include two different non-majority cell types. New
+#   placement logic matches absolute observed cells against exact source-cell colors.
+#
+# d) Placement legality
+# - The enlarged block is still exactly 3x3 cells, so the top-left offset remains in 0..4.
+# - Each cell slot holds exactly one full 3x3 interior pattern; there is no partial overlap.
+# - The generator only exposes a strict subset of the non-majority block positions and rejects any
+#   subset whose colored evidence allows more than one placement.
+#
+# e) Visual observability
+# - A human can see that the unique tricolor source cell acts as a legend. One source color reappears
+#   as full source copies; another source color reappears through an auxiliary recolor; the third
+#   source color corresponds to cells that remain ordinary majority cells.
+# - No numeric ordering on color ids is used. The inference comes only from repeated shapes and
+#   repeated color roles.
+#
+# f) Visual cleanliness
+# - The output is still one clean 3x3 overlay on a regular lattice. There is no stacking of
+#   unrelated objects in the same pixel region.
+# - The auxiliary cell is shape-compatible with the majority cell, so the completed block looks
+#   organized rather than chaotic.
+#
+# g) Color-change inferability
+# - Total palette size is 5: separator, majority background, erase/shared color, source-main color,
+#   and fill/auxiliary color.
+# - The fill color is meaningful because it appears in two linked places: inside the tricolor source
+#   cell and as the foreground of the auxiliary cells. The erase/shared color is meaningful because
+#   it appears inside both the source cell and the majority cell, signalling "keep majority here".
+#
+# h) Quantitative non-degeneration target
+# - Every generated source layout contains at least two fill-color positions and at least two
+#   source-main positions, so the enlarged block always contains both non-majority behaviors.
+# - Therefore the fused output differs from a degenerate binary-collapse interpretation on at least
+#   two cell slots in every sample.
+#
+# i) New solver assumptions and generator guarantees
+# - Solver assumes exactly one distinct 3-color cell pattern exists; generator guarantees this by
+#   using only one tricolor source pattern.
+# - Solver assumes the visible subset contains both source-copy and auxiliary-fill examples, leaving
+#   exactly one source color unmapped; generator enforces that.
+# - Solver assumes the remaining unmapped source color is the erase-to-majority behavior; generator
+#   constructs the data so only that color is absent from the visible non-majority subset.
+# - Solver assumes the majority pattern is still the most common cell pattern; generator guarantees
+#   that because the 3x3 overlay affects at most 9 of the 49 cells.
+
+CELL_GRID_N = 7
+CELL_INNER = 3
+CELL_STEP = 4
+GRID_SIZE = 29
+PLACEMENT_RANGE = CELL_GRID_N - CELL_INNER + 1
+GIVEN_CELL_SIZES = (4, 5)
+COLOR_POOL = 10
+MAX_RETRIES = 500
+
+LABEL_MAIN = 0
+LABEL_ERASE = 1
+LABEL_FILL = 2
+
+
+def _infer_cell_grid_params(g: np.ndarray) -> tuple[int, list[int], list[int]]:
+    """
+    Infer a regular cell grid separated by full rows/cols of the same line color.
+    Returns (step, row_divs, col_divs) where:
+      - row_divs/col_divs are divider indices
+      - step is the spacing between dividers (cell size including divider).
+    """
+    h, w = g.shape
+    line = int(g[0, 0])
+    row_divs = [r for r in range(h) if np.all(g[r, :] == line)]
+    col_divs = [c for c in range(w) if np.all(g[:, c] == line)]
+    assert len(row_divs) >= 2 and len(col_divs) >= 2, "need at least 2 row and 2 col dividers"
+    row_divs.sort()
+    col_divs.sort()
+    drs = [row_divs[i + 1] - row_divs[i] for i in range(len(row_divs) - 1) if row_divs[i + 1] > row_divs[i]]
+    dcs = [col_divs[i + 1] - col_divs[i] for i in range(len(col_divs) - 1) if col_divs[i + 1] > col_divs[i]]
+    step = reduce(gcd, drs + dcs)
+    assert step > 1, "divider step must be > 1"
+    assert row_divs[0] == 0 and col_divs[0] == 0, "first divider must be at index 0"
+    assert (h - 1) % step == 0 and (w - 1) % step == 0, "grid dimensions must be (k*step + 1)"
+    assert row_divs[-1] == h - 1 and col_divs[-1] == w - 1, "last divider must be at boundary"
+    return int(step), row_divs, col_divs
+
+
+def _pattern_key(arr: np.ndarray) -> tuple[int, ...]:
+    return tuple(int(v) for v in arr.ravel())
+
+
+def _extract_cells(g: np.ndarray, step: int) -> tuple[dict[tuple[int, ...], np.ndarray], list[list[tuple[int, ...]]]]:
+    n = (g.shape[0] - 1) // step
+    inner = step - 1
+    patterns: dict[tuple[int, ...], np.ndarray] = {}
+    cell_pat: list[list[tuple[int, ...]]] = []
+    for i in range(n):
+        row: list[tuple[int, ...]] = []
+        for j in range(n):
+            r0 = i * step + 1
+            c0 = j * step + 1
+            pat_arr = g[r0 : r0 + inner, c0 : c0 + inner].copy()
+            pat = _pattern_key(pat_arr)
+            if pat not in patterns:
+                patterns[pat] = pat_arr
+            row.append(pat)
+        cell_pat.append(row)
+    return patterns, cell_pat
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Complete a 3x3 fractal block by reading a tricolor source cell as a three-way action legend.
+
+    Input structure:
+    - The board is partitioned into equal 3x3 cell interiors separated by full divider rows and columns.
+    - Most cells share one majority pattern.
+    - A hidden 3x3 block contains a strict subset of visible non-majority cells, and one of those
+      visible patterns is a unique tricolor source cell.
+
+    Rule:
+    - Treat the tricolor source cell as a 3x3 legend whose three colors mean three different
+      cell-scale outcomes: copy the source cell, erase to the majority cell, or place an auxiliary
+      recolored cell.
+    - Use the already visible non-majority cells to find the unique placement of that 3x3 legend in
+      the 7x7 cell lattice and to infer which source color maps to which non-majority pattern.
+    - Complete all 9 positions of the block with the corresponding majority/source/auxiliary cell.
+
+    Key insight:
+    - The odd cell is no longer a binary mask. Its three colors are action labels, so solving the
+      task requires preserving color distinctions through placement and only then expanding them into
+      three different cell patterns.
+    """
+    g = np.asarray(grid, dtype=int)
+    step, _, _ = _infer_cell_grid_params(g)
+    n = (g.shape[0] - 1) // step
+    inner = step - 1
+
+    patterns, cell_pat = _extract_cells(g, step)
+
+    counts: dict[tuple[int, ...], int] = {}
+    for i in range(n):
+        for j in range(n):
+            p = cell_pat[i][j]
+            counts[p] = counts.get(p, 0) + 1
+
+    assert len(counts) >= 3, "variant expects majority, source, and auxiliary cell patterns"
+    majority_pat = max(counts.items(), key=lambda kv: kv[1])[0]
+
+    source_candidates = [pat for pat, arr in patterns.items() if len(np.unique(arr)) == 3]
+    assert len(source_candidates) == 1, "must have exactly one distinct tricolor source pattern"
+    source_pat = source_candidates[0]
+    source_arr = patterns[source_pat]
+    sh, sw = source_arr.shape
+    assert sh == inner and sw == inner, "source cell must match cell interior size"
+
+    existing: list[tuple[int, int, tuple[int, ...]]] = []
+    for i in range(n):
+        for j in range(n):
+            pat = cell_pat[i][j]
+            if pat != majority_pat:
+                existing.append((i, j, pat))
+    assert existing, "input must reveal non-majority cells"
+
+    observed_patterns = {pat for _, _, pat in existing}
+    assert source_pat in observed_patterns, "input must include at least one source-copy cell"
+    assert len(observed_patterns) == 2, "input should reveal exactly source-copy and auxiliary cells"
+
+    source_colors = {int(v) for v in np.unique(source_arr)}
+    assert len(source_colors) == 3, "source cell must contain exactly three colors"
+
+    candidates: list[tuple[int, int, dict[int, tuple[int, ...]]]] = []
+    for top in range(0, n - sh + 1):
+        for left in range(0, n - sw + 1):
+            color_to_pattern: dict[int, tuple[int, ...]] = {}
+            valid = True
+            for i, j, pat in existing:
+                if not (top <= i < top + sh and left <= j < left + sw):
+                    valid = False
+                    break
+                color = int(source_arr[i - top, j - left])
+                prev = color_to_pattern.get(color)
+                if prev is None:
+                    color_to_pattern[color] = pat
+                elif prev != pat:
+                    valid = False
+                    break
+            if not valid:
+                continue
+            if len(set(color_to_pattern.values())) != len(color_to_pattern):
+                continue
+            remaining_colors = [color for color in source_colors if color not in color_to_pattern]
+            if len(remaining_colors) != 1:
+                continue
+            erase_color = remaining_colors[0]
+            full_mapping = dict(color_to_pattern)
+            full_mapping[erase_color] = majority_pat
+            if len(set(full_mapping.values())) != 3:
+                continue
+            if full_mapping[int(source_arr[0, 0])] == majority_pat and np.all(source_arr == source_arr[0, 0]):
+                continue
+            candidates.append((int(top), int(left), full_mapping))
+
+    assert len(candidates) == 1, "must have a unique tricolor placement and mapping"
+    top, left, color_to_pattern = candidates[0]
+
+    out = g.copy()
+    for i in range(sh):
+        for j in range(sw):
+            pat = patterns[color_to_pattern[int(source_arr[i, j])]]
+            r0 = (top + i) * step + 1
+            c0 = (left + j) * step + 1
+            out[r0 : r0 + inner, c0 : c0 + inner] = pat
+    return out
+
+
+def _is_connected(mask: np.ndarray) -> bool:
+    coords = [tuple(coord) for coord in np.argwhere(mask)]
+    if not coords:
+        return False
+    seen = {coords[0]}
+    stack = [coords[0]]
+    while stack:
+        r, c = stack.pop()
+        for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+            if (nr, nc) in seen:
+                continue
+            if 0 <= nr < mask.shape[0] and 0 <= nc < mask.shape[1] and mask[nr, nc]:
+                seen.add((nr, nc))
+                stack.append((nr, nc))
+    return len(seen) == len(coords)
+
+
+def _precompute_majority_masks() -> list[np.ndarray]:
+    masks: list[np.ndarray] = []
+    for bits in range(1 << (CELL_INNER * CELL_INNER)):
+        mask = np.zeros((CELL_INNER, CELL_INNER), dtype=bool)
+        for idx in range(CELL_INNER * CELL_INNER):
+            if bits & (1 << idx):
+                mask[idx // CELL_INNER, idx % CELL_INNER] = True
+        count = int(mask.sum())
+        if count not in (4, 5):
+            continue
+        if not _is_connected(mask):
+            continue
+        if any(not mask[r, :].any() for r in range(CELL_INNER)):
+            continue
+        if any(not mask[:, c].any() for c in range(CELL_INNER)):
+            continue
+        if np.array_equal(mask, np.fliplr(mask)):
+            continue
+        if np.array_equal(mask, np.flipud(mask)):
+            continue
+        if np.array_equal(mask, np.rot90(mask)):
+            continue
+        masks.append(mask)
+    assert masks, "need majority mask catalog"
+    return masks
+
+
+def _precompute_source_layouts() -> list[np.ndarray]:
+    layouts: list[np.ndarray] = []
+    for bits in range(3 ** (CELL_INNER * CELL_INNER)):
+        x = bits
+        arr = np.empty((CELL_INNER, CELL_INNER), dtype=int)
+        counts = [0, 0, 0]
+        for idx in range(CELL_INNER * CELL_INNER):
+            label = x % 3
+            x //= 3
+            arr[idx // CELL_INNER, idx % CELL_INNER] = label
+            counts[label] += 1
+        if min(counts) < 2:
+            continue
+        if counts[LABEL_MAIN] not in (2, 3, 4):
+            continue
+        if counts[LABEL_ERASE] not in (2, 3, 4):
+            continue
+        if counts[LABEL_FILL] not in (2, 3, 4):
+            continue
+        if np.array_equal(arr, np.fliplr(arr)):
+            continue
+        if np.array_equal(arr, np.flipud(arr)):
+            continue
+        if np.array_equal(arr, np.rot90(arr)):
+            continue
+        if len({tuple(arr[r, :].tolist()) for r in range(CELL_INNER)}) < 3:
+            continue
+        if len({tuple(arr[:, c].tolist()) for c in range(CELL_INNER)}) < 2:
+            continue
+        layouts.append(arr)
+    assert layouts, "need source layout catalog"
+    return layouts
+
+
+_MAJORITY_MASKS = _precompute_majority_masks()
+_SOURCE_LAYOUTS = _precompute_source_layouts()
+
+
+def _random_majority_pattern(shared_color: int, majority_bg: int) -> np.ndarray:
+    mask = random.choice(_MAJORITY_MASKS)
+    return np.where(mask, shared_color, majority_bg).astype(int)
+
+
+def _random_source_layout() -> np.ndarray:
+    return random.choice(_SOURCE_LAYOUTS)
+
+
+def _source_pattern_from_layout(layout: np.ndarray, source_main: int, erase_color: int, fill_color: int) -> np.ndarray:
+    palette = np.array([source_main, erase_color, fill_color], dtype=int)
+    return palette[layout]
+
+
+def _cell_origin(i: int, j: int) -> tuple[int, int]:
+    return i * CELL_STEP + 1, j * CELL_STEP + 1
+
+
+def _build_grid(separator: int, majority: np.ndarray, cells: list[tuple[int, int, np.ndarray]]) -> np.ndarray:
+    grid = np.full((GRID_SIZE, GRID_SIZE), separator, dtype=int)
+    for i in range(CELL_GRID_N):
+        for j in range(CELL_GRID_N):
+            paste(grid, majority, *_cell_origin(i, j))
+    for i, j, pat in cells:
+        paste(grid, pat, *_cell_origin(i, j))
+    return grid
+
+
+def _placement_candidates(layout: np.ndarray, observed: list[tuple[int, int, int]]) -> list[tuple[int, int]]:
+    candidates: list[tuple[int, int]] = []
+    for top in range(PLACEMENT_RANGE):
+        for left in range(PLACEMENT_RANGE):
+            ok = True
+            for abs_r, abs_c, label in observed:
+                if not (top <= abs_r < top + CELL_INNER and left <= abs_c < left + CELL_INNER):
+                    ok = False
+                    break
+                if int(layout[abs_r - top, abs_c - left]) != label:
+                    ok = False
+                    break
+            if ok:
+                candidates.append((top, left))
+    return candidates
+
+
+def _choose_given_subset(layout: np.ndarray, top: int, left: int) -> list[tuple[int, int, int]] | None:
+    informative = [
+        (top + r, left + c, int(layout[r, c]))
+        for r in range(CELL_INNER)
+        for c in range(CELL_INNER)
+        if int(layout[r, c]) != LABEL_ERASE
+    ]
+    sizes = list(GIVEN_CELL_SIZES)
+    random.shuffle(sizes)
+    for size in sizes:
+        valid: list[list[tuple[int, int, int]]] = []
+        for subset in combinations(informative, size):
+            labels = {label for _, _, label in subset}
+            if labels != {LABEL_MAIN, LABEL_FILL}:
+                continue
+            if _placement_candidates(layout, list(subset)) == [(top, left)]:
+                valid.append(list(subset))
+        if valid:
+            return random.choice(valid)
+    return None
+
+
+def _collapsed_binary_output(separator: int, majority: np.ndarray, source: np.ndarray, layout: np.ndarray, top: int, left: int) -> np.ndarray:
+    cells: list[tuple[int, int, np.ndarray]] = []
+    for r in range(CELL_INNER):
+        for c in range(CELL_INNER):
+            if int(layout[r, c]) == LABEL_MAIN:
+                cells.append((top + r, left + c, source))
+    return _build_grid(separator, majority, cells)
+
+
+def _gen_attempt() -> tuple[np.ndarray, dict[str, int]] | None:
+    separator, majority_bg, erase_color, source_main, fill_color = random.sample(range(COLOR_POOL), 5)
+    majority = _random_majority_pattern(erase_color, majority_bg)
+    auxiliary = np.where(majority == erase_color, fill_color, majority_bg).astype(int)
+
+    layout = _random_source_layout()
+    source = _source_pattern_from_layout(layout, source_main, erase_color, fill_color)
+
+    top = random.randrange(PLACEMENT_RANGE)
+    left = random.randrange(PLACEMENT_RANGE)
+
+    full_cells: list[tuple[int, int, np.ndarray]] = []
+    main_count = 0
+    fill_count = 0
+    for r in range(CELL_INNER):
+        for c in range(CELL_INNER):
+            label = int(layout[r, c])
+            if label == LABEL_MAIN:
+                full_cells.append((top + r, left + c, source))
+                main_count += 1
+            elif label == LABEL_FILL:
+                full_cells.append((top + r, left + c, auxiliary))
+                fill_count += 1
+
+    if main_count < 2 or fill_count < 2:
+        return None
+
+    out = _build_grid(separator, majority, full_cells)
+
+    subset = _choose_given_subset(layout, top, left)
+    if subset is None:
+        return None
+
+    given_cells = [
+        (r, c, source if label == LABEL_MAIN else auxiliary)
+        for r, c, label in subset
+    ]
+    inp = _build_grid(separator, majority, given_cells)
+
+    try:
+        solved = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(solved, out):
+        return None
+
+    collapsed = _collapsed_binary_output(separator, majority, source, layout, top, left)
+    diff_cells = 0
+    for r in range(CELL_INNER):
+        for c in range(CELL_INNER):
+            if int(layout[r, c]) == LABEL_FILL:
+                rr = (top + r) * CELL_STEP + 1
+                cc = (left + c) * CELL_STEP + 1
+                if not np.array_equal(out[rr : rr + CELL_INNER, cc : cc + CELL_INNER], collapsed[rr : rr + CELL_INNER, cc : cc + CELL_INNER]):
+                    diff_cells += 1
+    if diff_cells < 2:
+        return None
+
+    metrics = {
+        "main_cells": main_count,
+        "fill_cells": fill_count,
+        "degeneracy_gap": diff_cells,
+    }
+    return inp, metrics
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_RETRIES):
+        result = _gen_attempt()
+        if result is not None:
+            grid, _ = result
+            return grid
+    raise RuntimeError("failed to generate a valid b99e7126 combo input")

