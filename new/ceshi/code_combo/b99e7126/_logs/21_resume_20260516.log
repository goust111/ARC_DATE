# Dimension: D11 — 颜色映射：放大图案中的颜色处理 (transform)
# Change: 放大图案直接使用异常单元格内部的原始颜色，前景色区域用对应颜色填充整个单元格大小... → 颜色重映射：放大时使用不同于源的颜色

from functools import reduce
from itertools import combinations
from math import gcd

import numpy as np
