+
+def _centered_top_left(n: int, mask: np.ndarray) -> tuple[int, int]:
+    """Return the cell-grid offset that centers the enlarged mask."""
+    mh, mw = mask.shape
+    top = (n - mh) // 2
+    left = (n - mw) // 2
+    assert 0 <= top <= n - mh and 0 <= left <= n - mw
+    return int(top), int(left)
