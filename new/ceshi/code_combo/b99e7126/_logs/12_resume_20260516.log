+# Combo variant of b99e7126 (index 12)
+# combo_spec: D3/0+D9/0
+# Name: 输出紧凑裁剪 + 放大图案居中放置
+
+# Design analysis for the D3/0 + D9/0 combo
+# -------------------------------------------
+# spec:
+#   combo_goal:
+#     Keep the original "minority cell encodes a 3x3 mask" mechanic, but
+#     decouple the final enlarged placement from the shown minority cells.
+#     The enlarged block is always centered on the whole 7x7 cell lattice, and
+#     the returned answer is the tight self-contained crop of that centered
+#     block.
+#   concrete_behavior:
+#     - Input is still a 29x29 separator grid with 7x7 cells of size 3x3.
+#     - Majority/minority cell interiors are built exactly as in the seed:
+#       the minority interior uses one dominant color whose 3x3 support is the
+#       higher-level mask.
+#     - The input still shows only a strict subset of minority cells, but their
+#       absolute placement is now only a clue source, not the destination.
+#       They are intentionally drawn at a legal non-central offset.
+#     - Solver extracts the minority texture and its boolean mask, ignores the
+#       clue offset, centers the enlarged 3x3 cell block on the 7x7 lattice, and
+#       returns only that 3x3 block with its outer divider frame.
+#   trace_example:
+#     - Seed behavior:
+#       1. Read the odd cell texture.
+#       2. Treat its dominant-color pixels as a 3x3 stencil.
+#       3. Use the shown minority-cell coordinates to locate that stencil on the
+#          board.
+#       4. Fill the full board at that located block and return the whole board.
+#     - Combo behavior:
+#       1. Steps 1-2 are unchanged.
+#       2. The shown minority cells may sit at offset (0,4), (4,1), etc., but
+#          that offset is ignored when constructing the answer.
+#       3. The 3x3 enlarged block is rendered at the centered offset
+#          ((7-3)//2, (7-3)//2) = (2,2).
+#       4. Only the centered 3x3 block is returned, so the output is always the
+#          compact 13x13 mini-grid corresponding to the centered enlargement.
+#     - Difference:
+#       D3 removes the old anchoring assumption; D9 removes the untouched outer
+#       board. The user-visible effect is that off-center clues generate the
+#       same centered local answer.
+#   complexity_guardrails:
+#     - Preserve the original 4-color role system and LR-symmetric 3x3 pattern
+#       family so the task remains recognizably b99e7126.
+#     - Keep the minority active count at 6-7 and the shown clue count at 3-4,
+#       so the minority texture is visually rich and still clearly rarer than
+#       the majority texture.
+#     - Force the input clue placement to be non-central; otherwise D3 would be
+#       visually hard to distinguish from the seed once D9 crops away location.
+#   implicit_assumptions_review:
+#     - `_infer_cell_grid_params` still relies on full divider rows/cols on the
+#       input boundary. Generator keeps the full 29x29 separator frame.
+#     - Pattern counting still assumes one majority texture and one rarer
+#       minority texture. Generator draws 3-4 minority cells against 45-46
+#       majority cells, so the counts remain well-separated.
+#     - The seed solver's candidate-search assumption is deliberately broken:
+#       clue coordinates no longer determine destination. The combo solver must
+#       therefore never use the minority-cell coordinates to infer output
+#       placement; it computes the centered destination directly from grid size
+#       and mask size.
+#     - Returning a local rendered block, rather than mutating `g.copy()`, is
+#       required because D9 discards all untouched context.
+#   placement_legality:
+#     - Source clue placement is still a legal 3x3 block offset in 0..4, but it
+#       is sampled from the non-central offsets only.
+#     - The centered destination block always fits because mask size is fixed at
+#       3x3 and the board is fixed at 7x7 cells.
+#     - Rendering the output directly in local coordinates avoids any risk of
+#       clipping or overlap outside the crop.
+#   visual_observability:
+#     - Across examples, the minority clue cluster moves around the 29x29 input,
+#       while the output is always the same kind of compact 13x13 completed
+#       block. That contrast exposes the "ignore source offset, center the
+#       enlargement" rule.
+#     - The divider frame is retained in the output so humans see a readable
+#       mini-grid, not a bare 11x11 interior patch.
+#   cleanliness:
+#     - The output contains exactly one coherent object: the completed centered
+#       3x3 cell block.
+#     - The input never mixes extra markers or extra textures; only the original
+#       majority/minority cell vocabulary is used.
+#   color_reasoning:
+#     - No logic depends on raw color ids.
+#     - Colors keep their structural roles: separator, majority-exclusive,
+#       shared, minority-exclusive.
+#   new_solver_assumptions_to_match_in_generator:
+#     - There must still be at least one minority and one majority cell in the
+#       input so counts cleanly identify the two textures.
+#     - The minority interior's dominant color must remain unique as the active
+#       mask color; generator enforces 6-7 active pixels.
+#     - Because solver ignores clue placement, generator must make the clue
+#       placement visibly non-central often enough to showcase the D3 change.
+
+from functools import reduce
+from itertools import combinations
+from math import gcd
+
+import numpy as np
+import random
+
+from arc_utils import paste
+
+
+def _infer_cell_grid_params(g: np.ndarray) -> tuple[int, list[int], list[int]]:
+    """
+    Infer a regular cell grid separated by full rows/cols of the same line color.
+    Returns (step, row_divs, col_divs) where:
+      - row_divs/col_divs are divider indices
+      - step is the spacing between dividers (cell size including divider).
+    """
+    h, w = g.shape
+    line = int(g[0, 0])
+    row_divs = [r for r in range(h) if np.all(g[r, :] == line)]
+    col_divs = [c for c in range(w) if np.all(g[:, c] == line)]
+    assert len(row_divs) >= 2 and len(col_divs) >= 2, "need at least 2 row and 2 col dividers"
+    row_divs.sort()
+    col_divs.sort()
+    drs = [row_divs[i + 1] - row_divs[i] for i in range(len(row_divs) - 1) if row_divs[i + 1] > row_divs[i]]
+    dcs = [col_divs[i + 1] - col_divs[i] for i in range(len(col_divs) - 1) if col_divs[i + 1] > col_divs[i]]
+    step = reduce(gcd, drs + dcs)
+    assert step > 1, "divider step must be > 1"
+    assert row_divs[0] == 0 and col_divs[0] == 0, "first divider must be at index 0"
+    assert (h - 1) % step == 0 and (w - 1) % step == 0, "grid dimensions must be (k*step + 1)"
+    assert row_divs[-1] == h - 1 and col_divs[-1] == w - 1, "last divider must be at boundary"
+    return int(step), row_divs, col_divs
+
+
+def _cell_pattern_data(g: np.ndarray):
+    """Extract per-cell interior patterns and their multiplicities."""
+    step, _, _ = _infer_cell_grid_params(g)
+    n = (g.shape[0] - 1) // step
+    inner = step - 1
+
+    patterns: dict[tuple[int, ...], np.ndarray] = {}
+    cell_pat: list[list[tuple[int, ...]]] = []
+    counts: dict[tuple[int, ...], int] = {}
+    for i in range(n):
+        row: list[tuple[int, ...]] = []
+        for j in range(n):
+            r0 = i * step + 1
+            c0 = j * step + 1
+            pat_arr = g[r0 : r0 + inner, c0 : c0 + inner].copy()
+            pat = tuple(pat_arr.ravel().tolist())
+            if pat not in patterns:
+                patterns[pat] = pat_arr
+            counts[pat] = counts.get(pat, 0) + 1
+            row.append(pat)
+        cell_pat.append(row)
+    return step, n, inner, patterns, cell_pat, counts
+
+
+def _recover_patterns_and_mask(g: np.ndarray):
+    """Recover majority/minority cell interiors and the minority-derived mask."""
+    step, n, _inner, patterns, _cell_pat, counts = _cell_pattern_data(g)
+    assert len(counts) >= 2, "must have at least 2 distinct cell patterns (minority + majority)"
+
+    minority_pat = min(counts.items(), key=lambda kv: kv[1])[0]
+    majority_pat = max(counts.items(), key=lambda kv: kv[1])[0]
+    minority_arr = patterns[minority_pat]
+    majority_arr = patterns[majority_pat]
+
+    vals, cnts = np.unique(minority_arr, return_counts=True)
+    active_color = int(vals[cnts.argmax()])
+    mask = minority_arr == active_color
+    assert mask.any(), "minority mask must contain active pixels"
+
+    return step, n, majority_arr, minority_arr, mask
+
+
+def _render_completed_block(
+    line_color: int,
+    step: int,
+    majority_arr: np.ndarray,
+    minority_arr: np.ndarray,
+    mask: np.ndarray,
+) -> np.ndarray:
+    """Render the completed local cell block with its outer divider frame."""
+    mh, mw = mask.shape
+    inner = step - 1
+    out = np.full((mh * step + 1, mw * step + 1), int(line_color), dtype=int)
+    for i in range(mh):
+        for j in range(mw):
+            tile = minority_arr if mask[i, j] else majority_arr
+            r0 = i * step + 1
+            c0 = j * step + 1
+            out[r0 : r0 + inner, c0 : c0 + inner] = tile
+    return out
+
+
+def _render_full_board(
+    line_color: int,
+    n: int,
+    step: int,
+    majority_arr: np.ndarray,
+    minority_arr: np.ndarray,
+    mask: np.ndarray,
+    top: int,
+    left: int,
+) -> np.ndarray:
+    """Render the full cell board after placing the enlarged mask at a chosen offset."""
+    inner = step - 1
+    out = np.full((n * step + 1, n * step + 1), int(line_color), dtype=int)
+    for i in range(n):
+        for j in range(n):
+            r0 = i * step + 1
+            c0 = j * step + 1
+            out[r0 : r0 + inner, c0 : c0 + inner] = majority_arr
+
+    mh, mw = mask.shape
+    for i in range(mh):
+        for j in range(mw):
+            if not mask[i, j]:
+                continue
+            r0 = (top + i) * step + 1
+            c0 = (left + j) * step + 1
+            out[r0 : r0 + inner, c0 : c0 + inner] = minority_arr
+    return out
+
+
+def _centered_top_left(n: int, mask: np.ndarray) -> tuple[int, int]:
+    """Return the cell-grid offset that centers the enlarged mask."""
+    mh, mw = mask.shape
+    top = (n - mh) // 2
+    left = (n - mw) // 2
+    assert 0 <= top <= n - mh and 0 <= left <= n - mw
+    return int(top), int(left)
+
+
+def _crop_cell_block(g: np.ndarray, top: int, left: int, cells_h: int, cells_w: int, step: int) -> np.ndarray:
+    """Crop a cell-aligned block while preserving the outer divider frame."""
+    r0 = top * step
+    c0 = left * step
+    r1 = (top + cells_h) * step
+    c1 = (left + cells_w) * step
+    return g[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Recover the odd cell's 3x3 blueprint, center its enlargement, and return the compact crop.
+
+    Input structure:
+    - A full divider lattice splits the board into equal square cells.
+    - One interior pattern is common, while a few cells show a rarer interior pattern.
+    - The rare cell's dominant color still defines a 3x3 active/inactive mask.
+
+    Rule:
+    - Extract the majority texture, minority texture, and boolean mask from the two cell types.
+    - Ignore the absolute positions of the shown minority cells when deciding the destination.
+    - Place the enlarged 3x3 cell block at the center of the 7x7 cell lattice.
+    - Return only that completed centered block, cropped to its outer divider frame.
+
+    Key insight:
+    The odd cell still provides both the texture and the binary stencil, but the clue cells no longer anchor where the stencil should land; the destination is determined globally by centering, and the final answer is the centered block in isolation.
+    """
+    g = np.asarray(grid, dtype=int)
+    step, n, majority_arr, minority_arr, mask = _recover_patterns_and_mask(g)
+    top, left = _centered_top_left(n, mask)
+    mh, mw = mask.shape
+    centered = _render_full_board(int(g[0, 0]), n, step, majority_arr, minority_arr, mask, top, left)
+    return _crop_cell_block(centered, top, left, mh, mw, step)
+
+
+# --------------- generator (o5x) ---------------
+
+# --- CFG: tunable generation parameters ---
+CELL_GRID_N = 7
+CELL_INNER = 3
+CELL_STEP = 4
+GRID_SIZE = 29
+MASK_SIZE = 3
+PLACEMENT_RANGE = CELL_GRID_N - MASK_SIZE + 1
+CENTER_OFFSET = (CELL_GRID_N - MASK_SIZE) // 2
+ACTIVE_PIXEL_COUNTS = (6, 7)
+GIVEN_CELL_SIZES = (3, 4)
+COLOR_POOL = 10
+MAX_RETRIES = 300
+
+_LR_GROUPS = [
+    ((0, 0), (0, 2)),
+    ((1, 0), (1, 2)),
+    ((2, 0), (2, 2)),
+    ((0, 1),),
+    ((1, 1),),
+    ((2, 1),),
+]
+
+_NONCENTER_OFFSETS = [
+    (top, left)
+    for top in range(PLACEMENT_RANGE)
+    for left in range(PLACEMENT_RANGE)
+    if (top, left) != (CENTER_OFFSET, CENTER_OFFSET)
+]
+
+
+def _precompute_masks():
+    """Enumerate valid LR-symmetric 3x3 masks, keyed by active pixel count."""
+    weights = [len(group) for group in _LR_GROUPS]
+    by_count: dict[int, list[np.ndarray]] = {}
+    for active_count in ACTIVE_PIXEL_COUNTS:
+        inactive_count = MASK_SIZE * MASK_SIZE - active_count
+        masks: list[np.ndarray] = []
+        for k in range(1, len(_LR_GROUPS) + 1):
+            for combo in combinations(range(len(_LR_GROUPS)), k):
+                if sum(weights[idx] for idx in combo) != inactive_count:
+                    continue
+                mask = np.ones((MASK_SIZE, MASK_SIZE), dtype=bool)
+                for idx in combo:
+                    for r, c in _LR_GROUPS[idx]:
+                        mask[r, c] = False
+                if mask[0, :].any() and mask[2, :].any() and mask[:, 0].any() and mask[:, 2].any():
+                    masks.append(mask)
+        by_count[active_count] = masks
+    return by_count
+
+
+_MASKS_BY_COUNT = _precompute_masks()
+
+
+def _random_lr_pattern(color_a: int, color_b: int) -> np.ndarray:
+    """Generate a non-uniform LR-symmetric 3x3 pattern using two colors."""
+    arr = np.empty((MASK_SIZE, MASK_SIZE), dtype=int)
+    choices = [random.choice((color_a, color_b)) for _ in _LR_GROUPS]
+    if all(value == choices[0] for value in choices):
+        choices[random.randrange(len(choices))] = color_b if choices[0] == color_a else color_a
+    for group, color in zip(_LR_GROUPS, choices):
+        for r, c in group:
+            arr[r, c] = color
+    return arr
+
+
+def _random_minority_mask() -> np.ndarray:
+    """Pick a random valid minority mask."""
+    active_count = random.choice(ACTIVE_PIXEL_COUNTS)
+    return random.choice(_MASKS_BY_COUNT[active_count])
+
+
+def _cell_origin(i: int, j: int) -> tuple[int, int]:
+    """Pixel origin of cell (i, j) interior within the full grid."""
+    return i * CELL_STEP + 1, j * CELL_STEP + 1
+
+
+def _build_grid(separator: int, majority: np.ndarray, minority: np.ndarray, active_cells: list[tuple[int, int]]) -> np.ndarray:
+    """Construct the 29x29 input board from cell patterns."""
+    grid = np.full((GRID_SIZE, GRID_SIZE), int(separator), dtype=int)
+    for i in range(CELL_GRID_N):
+        for j in range(CELL_GRID_N):
+            paste(grid, majority, *_cell_origin(i, j))
+    for i, j in active_cells:
+        paste(grid, minority, *_cell_origin(i, j))
+    return grid
+
+
+def _choose_given_subset(mask: np.ndarray, source_top: int, source_left: int) -> list[tuple[int, int]] | None:
+    """Choose a shown subset with at least one clue outside the centered destination block."""
+    active = [tuple(coord) for coord in np.argwhere(mask)]
+    center_cells = {
+        (r, c)
+        for r in range(CENTER_OFFSET, CENTER_OFFSET + MASK_SIZE)
+        for c in range(CENTER_OFFSET, CENTER_OFFSET + MASK_SIZE)
+    }
+    sizes = list(GIVEN_CELL_SIZES)
+    random.shuffle(sizes)
+    for size in sizes:
+        candidates = []
+        for subset in combinations(active, size):
+            shown = [(source_top + r, source_left + c) for r, c in subset]
+            if any(cell not in center_cells for cell in shown):
+                candidates.append([tuple(coord) for coord in subset])
+        if candidates:
+            return random.choice(candidates)
+    return None
+
+
+def _gen_attempt() -> np.ndarray | None:
+    """Build an off-center input whose answer is the centered compact block."""
+    separator, maj_exclusive, shared, min_exclusive = random.sample(range(COLOR_POOL), 4)
+    majority = _random_lr_pattern(shared, maj_exclusive)
+    mask = _random_minority_mask()
+    minority = np.where(mask, min_exclusive, shared).astype(int)
+
+    source_top, source_left = random.choice(_NONCENTER_OFFSETS)
+    shown_subset = _choose_given_subset(mask, source_top, source_left)
+    if shown_subset is None:
+        return None
+    shown_cells = [(source_top + r, source_left + c) for r, c in shown_subset]
+    inp = _build_grid(separator, majority, minority, shown_cells)
+
+    try:
+        solved = main(inp)
+    except Exception:
+        return None
+
+    expected = _render_completed_block(separator, CELL_STEP, majority, minority, mask)
+    if not np.array_equal(solved, expected):
+        return None
+    return inp
+
+
+def generate_input():
+    for _ in range(MAX_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid b99e7126 combo input")

