            inside = top <= i < top + mh and left <= j < left + mw
            if inside and mask[i - top, j - left]:
                target = minority_arr
            else:
                target = expected_cells[i][j]
            r0 = i * step + 1
            c0 = j * step + 1
            out[r0 : r0 + inner, c0 : c0 + inner] = target
    return out


