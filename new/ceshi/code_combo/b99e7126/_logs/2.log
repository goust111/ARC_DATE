   344	def main(grid: np.ndarray) -> np.ndarray:
   345	    """
   346	    Complete a fractal cell overlay by reading one marker for the source pattern and a second marker for the placement anchor.
   347	
   348	    Input structure:
   349	    - The canvas is a regular NxN grid of 3x3 cell interiors separated by 1-pixel divider lines.
   350	    - Most cells share one majority interior pattern.
   351	    - One source cell replaces every active pixel of its 3x3 template with a dedicated source-marker
   352	      color, while a different anchor cell keeps the majority look except for a single center pixel
   353	      in a second dedicated marker color.
   354	    - A few ordinary minority cells are also shown with the same geometry as the source template but
   355	      with their normal active color.
   356	
   357	    Rule:
   358	    - Find the unique source-marker color and read that cell's marked pixels as a 3x3 boolean mask.
   359	    - Find the distinct anchor-marker cell and place the enlarged 3x3 block so the anchor cell is the
   360	      center of that block.
   361	    - Use the repeated ordinary minority pattern as the cell pattern for every mask-active position.
   362	    - Fill the whole anchored 3x3 block: active mask entries become ordinary minority cells and
   363	      inactive entries become majority cells.
   364	
   365	    Key insight:
   366	    - The two markers answer different questions and must not be conflated: the dense source marker
   367	      says "what shape to expand", while the single-pixel anchor marker says "where that expansion
   368	      belongs" on the larger cell grid.
   369	    """
   370	    g = np.asarray(grid, dtype=int)
   371	    step, n, inner, patterns, cell_pat, counts = _extract_cell_patterns(g)
   372	    assert len(counts) >= 4, "need majority, ordinary minority, source marker, and anchor marker patterns"
   373	
   374	    majority_pat = max(counts.items(), key=lambda kv: kv[1])[0]
   375	    majority_arr = patterns[majority_pat]
   376	    (source_color, (source_i, source_j), source_pat), (_, (anchor_i, anchor_j), anchor_pat) = _classify_special_roles(
   377	        patterns,
   378	        cell_pat,
   379	        majority_pat,
   380	    )
   381	
   382	    source_arr = patterns[source_pat]
   383	    anchor_arr = patterns[anchor_pat]
   384	    assert _hamming_distance(anchor_arr, majority_arr) == 1, "anchor pattern must differ from majority by one pixel"
   385	    assert int(anchor_arr[ANCHOR_REL]) != int(majority_arr[ANCHOR_REL]), "anchor marker must sit at the center"
   386	
   387	    ordinary_candidates = {
   388	        pat: cnt
   389	        for pat, cnt in counts.items()
   390	        if pat not in {majority_pat, source_pat, anchor_pat}
   391	    }
   392	    assert len(ordinary_candidates) == 1, "must have exactly one ordinary minority pattern"
   393	    ordinary_pat = next(iter(ordinary_candidates))
   394	    ordinary_arr = patterns[ordinary_pat]
   395	
   396	    mask = _validate_ordinary_against_source(source_arr, source_color, ordinary_arr)
   397	    assert mask.shape == (inner, inner), "source mask must match cell interior size"
   398	    assert bool(mask[ANCHOR_REL]), "anchor center must land on an active mask pixel"
   399	
   400	    top = anchor_i - ANCHOR_REL[0]
   401	    left = anchor_j - ANCHOR_REL[1]
   402	    assert 0 <= top <= n - mask.shape[0] and 0 <= left <= n - mask.shape[1], "anchor would place block out of bounds"
   403	
   404	    src_r = source_i - top
   405	    src_c = source_j - left
   406	    assert 0 <= src_r < mask.shape[0] and 0 <= src_c < mask.shape[1], "source cell must lie inside the anchored block"
   407	    assert bool(mask[src_r, src_c]), "source cell must correspond to an active mask position"
   408	    assert (source_i, source_j) != (anchor_i, anchor_j), "source and anchor cells must be distinct"
   409	
   410	    out = g.copy()
   411	    for i in range(mask.shape[0]):
   412	        for j in range(mask.shape[1]):
   413	            target_pat = ordinary_arr if mask[i, j] else majority_arr
   414	            r0 = (top + i) * step + 1
   415	            c0 = (left + j) * step + 1
   416	            out[r0 : r0 + inner, c0 : c0 + inner] = target_pat
   417	    return out
