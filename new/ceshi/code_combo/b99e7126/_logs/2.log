   119	def _infer_cell_grid_params(g: np.ndarray) -> tuple[int, list[int], list[int]]:
   120	    """
   121	    Infer a regular cell grid separated by full rows/cols of the same line color.
   122	    Returns (step, row_divs, col_divs) where:
   123	      - row_divs/col_divs are divider indices
   124	      - step is the spacing between dividers (cell size including divider).
   125	    """
   126	    h, w = g.shape
   127	    line = int(g[0, 0])
   128	    row_divs = [r for r in range(h) if np.all(g[r, :] == line)]
   129	    col_divs = [c for c in range(w) if np.all(g[:, c] == line)]
   130	    assert len(row_divs) >= 2 and len(col_divs) >= 2, "need at least 2 row and 2 col dividers"
   131	    row_divs.sort()
   132	    col_divs.sort()
   133	    drs = [row_divs[i + 1] - row_divs[i] for i in range(len(row_divs) - 1) if row_divs[i + 1] > row_divs[i]]
   134	    dcs = [col_divs[i + 1] - col_divs[i] for i in range(len(col_divs) - 1) if col_divs[i + 1] > col_divs[i]]
   135	    step = reduce(gcd, drs + dcs)
   136	    assert step > 1, "divider step must be > 1"
   137	    assert row_divs[0] == 0 and col_divs[0] == 0, "first divider must be at index 0"
   138	    assert (h - 1) % step == 0 and (w - 1) % step == 0, "grid dimensions must be (k*step + 1)"
   139	    assert row_divs[-1] == h - 1 and col_divs[-1] == w - 1, "last divider must be at boundary"
   140	    return int(step), row_divs, col_divs
