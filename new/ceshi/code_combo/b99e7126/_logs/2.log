# Variant of b99e7126
# Dimension: D1 — 匹配条件：异常单元格的识别方式 (match_cond)
# Change: 通过比较所有单元格的内部颜色图案，找到与多数单元格图案不同的那个唯一异常单元格... → 颜色匹配：异常单元格的特定颜色标记

from functools import reduce
from itertools import combinations
from math import gcd

import numpy as np
import random

