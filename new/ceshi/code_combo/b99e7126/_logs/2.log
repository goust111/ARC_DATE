# Combo variant of b99e7126 (index 2)
# combo_spec: D1/1+D3/2
# Name: 颜色标记识别 + 锚点由标记单元格确定

from functools import reduce
from itertools import combinations
from math import gcd

import numpy as np
import random

try:
    from arc_utils import paste
except ImportError:
    from arc2_solver_select.arc_utils import paste


# Design analysis
# a) Concrete behavior and trace
#    - The board is still a 29x29 pixel grid partitioned into a 7x7 lattice of 3x3 cell interiors.
#    - The output still completes a 3x3 cell-scale fractal block whose active footprint comes from a
#      3x3 cell interior mask.
#    - The fused change splits the old single "anomaly" role into two visible roles:
#      1) a source cell whose active pixels are recolored with a dedicated source-marker color,
#         telling us "which 3x3 pattern is the blueprint";
#      2) a distinct anchor cell that otherwise looks like the majority cell except for one center
#         pixel recolored with a second dedicated anchor-marker color, telling us "where to stamp".
#    - Example trace with mask
#          1 1 0
#          1 1 1
#          0 1 1
#      Old rule: find the odd cell pattern, read its dominant color as the mask, and place the
#      enlarged 3x3 block by fitting the shown minority cells uniquely.
#      Fused rule: find the source-marked cell, read its source-marker pixels as the mask, then
#      ignore global fitting and place the enlarged block so its center lands on the anchor cell.
#      The source cell may sit at any active position inside that block; it is not the anchor.
# b) Complexity calibration
#    - Only six colors are used: separator, majority-exclusive, shared, ordinary-active,
#      source-marker, anchor-marker. Each extra color has a single structural meaning.
#    - The source marker fills every active pixel of its 3x3 template, so it is visually legible
#      rather than a hidden metadata dot.
#    - The anchor marker is only a center dot inside an otherwise-majority cell, so humans can
#      separate the two marker types at a glance.
#    - Ordinary minority cells are still repeated 2-3 times in the input, preserving support for
#      the target pattern while avoiding a one-cell copy task.
# c) Implicit-assumption audit against the original solver
#    - "minority_pat = min(counts...)" no longer works: the rarest patterns are now source and
#      anchor markers, and neither should be propagated directly.
#    - "existing == minority_pat" no longer captures all informative cells: source and anchor are
#      both special, but they serve different roles and only the source counts as active evidence.
#    - The original placement search from shown minority positions must be removed because the
#      enlarged block is now positioned by the anchor marker, not by subset fitting.
#    - Deriving the mask from the ordinary minority cell is no longer the intended rule; the mask
#      is derived specifically from the source-marker color inside the marked source cell.
# d) Placement legality
#    - The enlarged block is still 3x3 cells, so placing the anchor at the block center keeps the
#      block in bounds whenever top/left are chosen in 0..4.
#    - The generator forces the center mask pixel to be active so the anchor cell is overwritten by
#      the ordinary minority pattern in the output, making the anchor's effect visible.
#    - The source cell is chosen from active positions excluding the center anchor position, so the
#      two special markers never overlap.
# e) Visual observability
#    - Across examples, one unique color appears as a whole 3x3 active shape inside one cell and
#      another unique color appears only as a center dot in a different cell. Their distinct roles
#      are visible from shape and from how each disappears in the output.
#    - The ordinary minority cells share the same geometry as the source mask, revealing that the
#      source marker selects a blueprint rather than introducing a separate object class.
# f) Visual cleanliness
#    - The scene still contains only tiled cells and divider lines; no free-floating legend object
#      is added.
#    - The two marker types are spatially separated and use different mark densities, so they do
#      not create clutter even though both are color-based.
# g) Color-change inferability
#    - Source-marker color means "read these pixels as the active mask".
#    - Anchor-marker color means "center the enlarged block here".
#    - Ordinary-active color means "this is the pattern that fills active output cells".
#      These meanings are supported by repeated ordinary cells and by the output overwriting both
#      markers with ordinary minority cells.
# h) Anti-degeneration target
#    - To ensure the combo does not collapse into D1/1, the generator requires that the shown
#      source+ordinary active cells admit multiple old-style placements when the anchor is ignored.
#    - To ensure the combo does not collapse into D3/2, the input always contains two non-majority,
#      non-anchor patterns: one repeated ordinary pattern and one unique source pattern.
# i) New solver assumptions and generator support
#    - Exactly one anchor marker exists and it differs from the majority by exactly one center
#      pixel; generator constructs that directly.
#    - Exactly one source marker color appears in exactly one cell and occupies every active pixel
#      of the source template; generator constructs that directly.
#    - The source mask center is active and the source cell is not the center; mask precomputation
#      and source selection enforce both.
#    - The ordinary minority pattern shares the source mask geometry and shared-color background;
#      generator constructs that and main() validates it before stamping the output.


CELL_GRID_N = 7
CELL_INNER = 3
CELL_STEP = 4
GRID_SIZE = 29
MASK_SIZE = 3
PLACEMENT_RANGE = CELL_GRID_N - MASK_SIZE + 1
ANCHOR_REL = (1, 1)

ACTIVE_PIXEL_COUNTS = (6, 7)
SHOWN_ACTIVE_SIZES = [3, 4]
COLOR_POOL = 10
MAX_RETRIES = 500
MIN_MINORITY_DISTANCE = 3

_LR_GROUPS = [
    ((0, 0), (0, 2)),
    ((1, 0), (1, 2)),
    ((2, 0), (2, 2)),
    ((0, 1),),
    ((1, 1),),
    ((2, 1),),
]


def _infer_cell_grid_params(g: np.ndarray) -> tuple[int, list[int], list[int]]:
    """
    Infer a regular cell grid separated by full rows/cols of the same line color.
    Returns (step, row_divs, col_divs) where:
      - row_divs/col_divs are divider indices
      - step is the spacing between dividers (cell size including divider).
    """
    h, w = g.shape
    line = int(g[0, 0])
    row_divs = [r for r in range(h) if np.all(g[r, :] == line)]
    col_divs = [c for c in range(w) if np.all(g[:, c] == line)]
    assert len(row_divs) >= 2 and len(col_divs) >= 2, "need at least 2 row and 2 col dividers"
    row_divs.sort()
    col_divs.sort()
    drs = [row_divs[i + 1] - row_divs[i] for i in range(len(row_divs) - 1) if row_divs[i + 1] > row_divs[i]]
    dcs = [col_divs[i + 1] - col_divs[i] for i in range(len(col_divs) - 1) if col_divs[i + 1] > col_divs[i]]
    step = reduce(gcd, drs + dcs)
    assert step > 1, "divider step must be > 1"
    assert row_divs[0] == 0 and col_divs[0] == 0, "first divider must be at index 0"
    assert (h - 1) % step == 0 and (w - 1) % step == 0, "grid dimensions must be (k*step + 1)"
    assert row_divs[-1] == h - 1 and col_divs[-1] == w - 1, "last divider must be at boundary"
    return int(step), row_divs, col_divs


def _extract_cell_patterns(
    g: np.ndarray,
) -> tuple[int, int, int, dict[tuple[int, ...], np.ndarray], list[list[tuple[int, ...]]], dict[tuple[int, ...], int]]:
    step, _, _ = _infer_cell_grid_params(g)
    n = (g.shape[0] - 1) // step
    inner = step - 1

    patterns: dict[tuple[int, ...], np.ndarray] = {}
    cell_pat: list[list[tuple[int, ...]]] = []
    counts: dict[tuple[int, ...], int] = {}
    for i in range(n):
        row: list[tuple[int, ...]] = []
        for j in range(n):
            r0 = i * step + 1
            c0 = j * step + 1
            pat_arr = g[r0 : r0 + inner, c0 : c0 + inner].copy()
            pat = tuple(pat_arr.ravel().tolist())
            if pat not in patterns:
                patterns[pat] = pat_arr
            counts[pat] = counts.get(pat, 0) + 1
            row.append(pat)
        cell_pat.append(row)
    return step, n, inner, patterns, cell_pat, counts


def _hamming_distance(a: np.ndarray, b: np.ndarray) -> int:
    return int(np.count_nonzero(a != b))


def _find_pattern_cells(cell_pat: list[list[tuple[int, ...]]], target: tuple[int, ...]) -> list[tuple[int, int]]:
    hits: list[tuple[int, int]] = []
    for i, row in enumerate(cell_pat):
        for j, pat in enumerate(row):
            if pat == target:
                hits.append((int(i), int(j)))
    return hits


def _color_to_cells(
    patterns: dict[tuple[int, ...], np.ndarray],
    cell_pat: list[list[tuple[int, ...]]],
) -> dict[int, set[tuple[int, int]]]:
    color_cells: dict[int, set[tuple[int, int]]] = {}
    for i, row in enumerate(cell_pat):
        for j, pat in enumerate(row):
            for color in np.unique(patterns[pat]):
                color_cells.setdefault(int(color), set()).add((int(i), int(j)))
    return color_cells


def _classify_special_roles(
    patterns: dict[tuple[int, ...], np.ndarray],
    cell_pat: list[list[tuple[int, ...]]],
    majority_pat: tuple[int, ...],
) -> tuple[tuple[int, tuple[int, int], tuple[int, ...]], tuple[int, tuple[int, int], tuple[int, ...]]]:
    majority_arr = patterns[majority_pat]
    source_roles: list[tuple[int, tuple[int, int], tuple[int, ...]]] = []
    anchor_roles: list[tuple[int, tuple[int, int], tuple[int, ...]]] = []
    for color, cells in _color_to_cells(patterns, cell_pat).items():
        if len(cells) != 1:
            continue
        cell = next(iter(cells))
        pat = cell_pat[cell[0]][cell[1]]
        arr = patterns[pat]
        if _hamming_distance(arr, majority_arr) == 1:
            anchor_roles.append((int(color), cell, pat))
        else:
            source_roles.append((int(color), cell, pat))

    assert len(anchor_roles) == 1, "must have exactly one anchor-marker color"
    assert len(source_roles) == 1, "must have exactly one source-marker color"
    return source_roles[0], anchor_roles[0]


def _validate_ordinary_against_source(
    source_arr: np.ndarray,
    source_color: int,
    ordinary_arr: np.ndarray,
) -> np.ndarray:
    mask = source_arr == source_color
    assert bool(mask.any()), "source template must contain source-marker pixels"
    inactive = ~mask
    source_bg_vals = np.unique(source_arr[inactive])
    ordinary_bg_vals = np.unique(ordinary_arr[inactive])
    ordinary_fg_vals = np.unique(ordinary_arr[mask])
    assert len(source_bg_vals) == 1, "source template must use one shared inactive color"
    assert len(ordinary_bg_vals) == 1, "ordinary pattern must use one inactive color"
    assert len(ordinary_fg_vals) == 1, "ordinary pattern must use one active color"
    assert int(source_bg_vals[0]) == int(ordinary_bg_vals[0]), "source and ordinary cells must share inactive color"
    assert int(ordinary_fg_vals[0]) != int(ordinary_bg_vals[0]), "ordinary active color must differ from inactive color"
    return mask


def _precompute_masks() -> dict[int, list[np.ndarray]]:
    """Enumerate valid LR-symmetric 3x3 masks with active center and edge support."""
    weights = [len(group) for group in _LR_GROUPS]
    by_count: dict[int, list[np.ndarray]] = {}
    for active_count in ACTIVE_PIXEL_COUNTS:
        inactive_count = MASK_SIZE * MASK_SIZE - active_count
        masks: list[np.ndarray] = []
        for k in range(1, len(_LR_GROUPS) + 1):
            for combo in combinations(range(len(_LR_GROUPS)), k):
                if sum(weights[i] for i in combo) != inactive_count:
                    continue
                mask = np.ones((MASK_SIZE, MASK_SIZE), dtype=bool)
                for idx in combo:
                    for r, c in _LR_GROUPS[idx]:
                        mask[r, c] = False
                if not mask[ANCHOR_REL]:
                    continue
                if mask[0, :].any() and mask[2, :].any() and mask[:, 0].any() and mask[:, 2].any():
                    masks.append(mask)
        by_count[active_count] = masks
    return by_count


_MASKS_BY_COUNT = _precompute_masks()


def _random_lr_pattern(color_a: int, color_b: int) -> np.ndarray:
    """Generate a random LR-symmetric 3x3 pattern using two colors."""
    arr = np.empty((MASK_SIZE, MASK_SIZE), dtype=int)
    choices = [random.choice((color_a, color_b)) for _ in _LR_GROUPS]
    if all(v == choices[0] for v in choices):
        choices[random.randrange(len(choices))] = color_b if choices[0] == color_a else color_a
    for group, color in zip(_LR_GROUPS, choices):
        for r, c in group:
            arr[r, c] = color
    return arr


def _random_minority_mask() -> np.ndarray:
    active_count = random.choice(ACTIVE_PIXEL_COUNTS)
    return random.choice(_MASKS_BY_COUNT[active_count]).copy()


def _cell_origin(i: int, j: int) -> tuple[int, int]:
    return i * CELL_STEP + 1, j * CELL_STEP + 1


def _build_grid(separator: int, majority: np.ndarray, overrides: dict[tuple[int, int], np.ndarray]) -> np.ndarray:
    grid = np.full((GRID_SIZE, GRID_SIZE), separator, dtype=int)
    for i in range(CELL_GRID_N):
        for j in range(CELL_GRID_N):
            paste(grid, majority, *_cell_origin(i, j))
    for (i, j), pat in overrides.items():
        paste(grid, pat, *_cell_origin(i, j))
    return grid


def _old_style_candidates(mask: np.ndarray, shown_cells: list[tuple[int, int]]) -> list[tuple[int, int]]:
    """Placement candidates under a D1-like rule that ignores the anchor cell."""
    existing = np.zeros((CELL_GRID_N, CELL_GRID_N), dtype=bool)
    for r, c in shown_cells:
        existing[r, c] = True

    candidates: list[tuple[int, int]] = []
    for top in range(PLACEMENT_RANGE):
        for left in range(PLACEMENT_RANGE):
            block = np.zeros((CELL_GRID_N, CELL_GRID_N), dtype=bool)
            block[top : top + MASK_SIZE, left : left + MASK_SIZE] = True
            if np.any(existing & ~block):
                continue
            ex_block = existing[top : top + MASK_SIZE, left : left + MASK_SIZE]
            if np.any(ex_block & ~mask):
                continue
            candidates.append((int(top), int(left)))
    return candidates


def _choose_shown_configuration(
    mask: np.ndarray,
    top: int,
    left: int,
) -> tuple[tuple[int, int], list[tuple[int, int]]] | None:
    """Pick a source cell plus ordinary hints that stay ambiguous without the anchor."""
    active_rels = [tuple(map(int, coord)) for coord in np.argwhere(mask)]
    non_anchor_rels = [coord for coord in active_rels if coord != ANCHOR_REL]
    size_order = list(SHOWN_ACTIVE_SIZES)
    random.shuffle(size_order)
    source_order = list(non_anchor_rels)
    random.shuffle(source_order)

    for shown_size in size_order:
        for source_rel in source_order:
            others = [coord for coord in non_anchor_rels if coord != source_rel]
            need = shown_size - 1
            if len(others) < need:
                continue
            valid: list[list[tuple[int, int]]] = []
            for ordinary_rels in combinations(others, need):
                shown_cells = [(top + source_rel[0], left + source_rel[1])]
                shown_cells.extend((top + r, left + c) for r, c in ordinary_rels)
                candidates = _old_style_candidates(mask, shown_cells)
                if len(candidates) > 1 and (top, left) in candidates:
                    valid.append(shown_cells)
            if valid:
                return source_rel, random.choice(valid)
    return None


def main(grid: np.ndarray) -> np.ndarray:
    """
    Complete a fractal cell overlay by reading one marker for the source pattern and a second marker for the placement anchor.

    Input structure:
    - The canvas is a regular NxN grid of 3x3 cell interiors separated by 1-pixel divider lines.
    - Most cells share one majority interior pattern.
    - One source cell replaces every active pixel of its 3x3 template with a dedicated source-marker
      color, while a different anchor cell keeps the majority look except for a single center pixel
      in a second dedicated marker color.
    - A few ordinary minority cells are also shown with the same geometry as the source template but
      with their normal active color.

    Rule:
    - Find the unique source-marker color and read that cell's marked pixels as a 3x3 boolean mask.
    - Find the distinct anchor-marker cell and place the enlarged 3x3 block so the anchor cell is the
      center of that block.

