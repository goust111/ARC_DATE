+
+def _serpentine_positions(rows: int, cols: int) -> list[tuple[int, int]]:
+    positions: list[tuple[int, int]] = []
+    for r in range(rows):
+        col_range = range(cols) if r % 2 == 0 else range(cols - 1, -1, -1)
+        for c in col_range:
+            positions.append((r, c))
