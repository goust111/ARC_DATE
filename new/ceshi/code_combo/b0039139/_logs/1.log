+    ordered: list[np.ndarray] = []
+    for row_idx in range(rows):
+        row = row_major[row_idx * cols : (row_idx + 1) * cols]
+        row = sorted(row, key=lambda coords: int(coords[:, 1].min()))
+        if row_idx % 2 == 1:
+            row = list(reversed(row))
+        ordered.extend(row)
+    return ordered
