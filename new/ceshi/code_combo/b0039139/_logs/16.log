+def _split_sections(grid: np.ndarray) -> tuple[str, list[np.ndarray]]:
+    h, w = grid.shape
+
+    sep_rows = [r for r in range(h) if bool(np.all(grid[r, :] == SEPARATOR_COLOR))]
