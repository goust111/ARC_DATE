+    # Guard against degeneration into the original task or a swap-only/no-D5 variant.
+    original_tile = np.where(shape != 0, section3_color, section4_color).astype(int)
+    original_output = _tile_repeat(original_tile, n_repeats, section4_color, horizontal)
