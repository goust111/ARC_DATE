+# Combo variant of b0039139 (index 22)
+# combo_spec: D1/0+D5/2
+# Name: 颜色互换配前景色分隔带
+
+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+from arc_utils import bbox, components_mask, crop_bbox, random_sprite
+
+
+# Design analysis for combo D1/0 + D5/2
+# a) Concretization and behavior trace
+#    - The input still has four ordered sections split by full blue separator rows/cols:
+#      template, stencil, section-3 swatch, section-4 swatch.
+#    - The template is still yellow(4) on black(0), and the stencil still stores only the repeat count
