   230	            continue
   231	
   232	        grid[r : r + br, c : c + bc] = STENCIL_COLOR
   233	        placed += 1
   234	
   235	    return grid if placed == n_blobs else None
   236	
   237	
   238	def _shape_has_cropped_background(shape: np.ndarray) -> bool:
   239	    """Require both shape cells and black cells inside the cropped bbox so the swapped mapping is visible."""
   240	    return bool(np.any(shape == TEMPLATE_COLOR) and np.any(shape == 0))
   241	
   242	
   243	def _gen_attempt() -> np.ndarray | None:
   244	    horizontal = random.choice([True, False])
   245	    n_repeats = random.randint(*REPEAT_COUNT_RANGE)
   246	
   247	    crop_h = random.randint(*CROP_SIZE_RANGE)
   248	    crop_w = random.randint(*CROP_SIZE_RANGE)
   249	    density = random.uniform(*DENSITY_RANGE)
   250	    shape = random_sprite(
   251	        crop_h,
   252	        crop_w,
   253	        density=density,
   254	        color_palette=[TEMPLATE_COLOR],
   255	        connectivity=4,
   256	        symmetry="not_symmetric",
   257	    )
   258	    if not _shape_has_cropped_background(shape):
   259	        return None
   260	
   261	    section3_color, section4_color = random.sample(COLOR_POOL, 2)
   262	
   263	    tile = np.where(shape != 0, section4_color, section3_color).astype(int)
   264	    output = _tile_repeat(tile, n_repeats, section3_color, horizontal)
   265	
   266	    # Guard against degeneration into the original task or a swap-only/no-D5 variant.
   267	    original_tile = np.where(shape != 0, section3_color, section4_color).astype(int)
   268	    original_output = _tile_repeat(original_tile, n_repeats, section4_color, horizontal)
   269	    swap_only_output = _tile_repeat(tile, n_repeats, section4_color, horizontal)
   270	    if np.array_equal(output, original_output) or np.array_equal(output, swap_only_output):
   271	        return None
   272	
   273	    template = np.zeros((crop_h + 2, crop_w + 2), dtype=int)
   274	    template[1 : crop_h + 1, 1 : crop_w + 1] = shape
   275	
   276	    shared_dim = (crop_h + 2) if horizontal else (crop_w + 2)
   277	    stencil = _build_stencil(n_repeats, shared_dim, horizontal)
   278	    if stencil is None:
   279	        return None
   280	
   281	    section3_swatch = _make_swatch(shared_dim, section3_color, horizontal)
   282	    section4_swatch = _make_swatch(shared_dim, section4_color, horizontal)
   283	    inp = _join_sections([template, stencil, section3_swatch, section4_swatch], shared_dim, horizontal)
   284	
   285	    try:
   286	        if np.array_equal(main(inp), output):
   287	            return inp
   288	    except Exception:
   289	        pass
   290	    return None
   291	
   292	
   293	def generate_input() -> np.ndarray:
