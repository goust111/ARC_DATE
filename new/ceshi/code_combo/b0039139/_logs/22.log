@@ -0,0 +1,298 @@
+# Combo variant of b0039139 (index 22)
+# combo_spec: D1/0+D5/2
+# Name: 颜色互换配前景色分隔带
+
+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+from arc_utils import bbox, components_mask, crop_bbox, random_sprite
+
+
+# Design analysis for combo D1/0 + D5/2
+# a) Concretization and behavior trace
+#    - The input still has four ordered sections split by full blue separator rows/cols:
+#      template, stencil, section-3 swatch, section-4 swatch.
+#    - The template is still yellow(4) on black(0), and the stencil still stores only the repeat count
+#      as the number of 4-connected green(3) 2-cell blobs.
+#    - The fusion changes two linked steps:
+#      1) D1/0 swaps the tile recoloring roles:
+#         original: template pixels -> section 3, cropped black pixels -> section 4
+#         combo:    template pixels -> section 4, cropped black pixels -> section 3
+#      2) D5/2 forces the spacer band between copies to use section 3 rather than section 4.
+#    - Small trace with a 2x2 crop:
+#      crop mask      = [[1, 1],
+#                        [1, 0]]
+#      section 3 color = 2, section 4 color = 9
+#      original tile   = [[2, 2],
+#                         [2, 9]], separators = 9
+#      swap-only tile  = [[9, 9],
+#                         [9, 2]], separators = 9
+#      combo tile      = [[9, 9],
+#                         [9, 2]], separators = 2
+#      So the fusion differs from the original in both the interior mapping and the inter-copy band,
+#      and it also differs from a pure color-swap variant because the separator is pulled back to section 3.
+#
+# b) Complexity calibration
+#    - The puzzle remains a compact 1D repetition task, but now the solver must infer two spatial roles for
+#      section 3: it colors the cropped template background and also the spacer band.
+#    - To keep the swap human-visible, the generator rejects full solid crops and keeps only shapes whose cropped
+#      bbox still contains at least one black cell. This guarantees both swatch colors appear inside every tile.
+#    - Repeat count stays in the original 2-6 range so spacer bands always exist and D5/2 is observable.
+#
+# c) Implicit-assumption audit of main()
+#    - _split_sections still assumes exactly four non-empty sections separated by full blue lines.
+#      The generator preserves that layout.
+#    - template_mask = template != 0 assumes all informative template cells are non-black.
+#      This still holds because the template drawing color remains fixed at 4.
+#    - bbox(template_mask) assumes the template contains at least one shape cell.
+#      random_sprite still provides a connected non-empty shape.
+#    - _solid_color assumes each swatch block is effectively uniform; the generator still makes solid swatches.
+#    - The old foreground/background variable names would be misleading after fusion, because section 3 is no longer
+#      "shape color". main() therefore treats section 3 as cropped-background + separator color, and section 4 as
+#      the visible template-shape color.
+#    - The repetition branch assumes the separator color is independent of the stencil contents except for count.
+#      That remains valid: the stencil encodes quantity only; the separator color is determined solely by D5/2.
+#
+# d) Placement legality
+#    - The template remains inside a (crop_h+2) x (crop_w+2) box with a 1-cell black border, so cropping is stable.
+#    - Stencil blobs are placed with a 1-cell black moat, preventing accidental component merging.
+#    - Swatches remain solid rectangles whose shared axis matches the other sections, so section joining stays
+#      rectangular and non-overlapping for both horizontal and vertical layouts.
+#
+# e) Visual observability
+#    - Human-visible evidence for D1/0 comes from the tile interior: yellow shape cells end up in section 4's color,
+#      while internal holes/negative space become section 3.
+#    - Human-visible evidence for D5/2 comes from the repeated output: the 1-cell gaps use section 3 as well.
+#      Because section 3 also fills the tile background after the swap, the gaps visually merge with that negative
+#      space, which is exactly the intended fused effect.
+#
+# f) Visual cleanliness
+#    - No extra markers or overlays are introduced; the scene is still four clean input bands and one repeated output.
+#    - The generator avoids degenerate solid tiles, so the two swatch colors remain separable by shape structure
+#      instead of producing noisy or ambiguous monochrome outputs.
+#
+# g) Change inferability
+#    - Only two swatch colors are active, and their roles are anchored by fixed section positions.
+#    - No rule depends on numeric color ids or hidden ordering. The inference is purely spatial:
+#      section 4 paints the template mass, section 3 paints the cropped holes and the between-copy band.
+#
+# Post-change solver assumption audit
+#    - main() now assumes section 3 is the separator color even though section 4 is still labeled as a background
+#      swatch by the original task family. generate_input() guarantees this by constructing oracle outputs with
+#      section 3 spacers.
+#    - main() also benefits from the crop containing both mask values so the swap is visible. This is not required
+#      for correctness, but the generator enforces it to prevent fused samples from collapsing into weak evidence.
+
+
+def _split_sections(grid: np.ndarray) -> tuple[str, list[np.ndarray]]:
+    h, w = grid.shape
+    sep = 1
+
+    sep_rows = [r for r in range(h) if bool(np.all(grid[r, :] == sep))]
+    if sep_rows:
+        cuts = [-1] + sep_rows + [h]
+        return "vertical", [grid[a + 1 : b, :] for a, b in zip(cuts, cuts[1:]) if b > a + 1]
+
+    sep_cols = [c for c in range(w) if bool(np.all(grid[:, c] == sep))]
+    cuts = [-1] + sep_cols + [w]
+    return "horizontal", [grid[:, a + 1 : b] for a, b in zip(cuts, cuts[1:]) if b > a + 1]
+
+
+def _solid_color(block: np.ndarray) -> int:
+    vals, counts = np.unique(block, return_counts=True)
+    return int(vals[int(np.argmax(counts))])
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Crop the template, swap the swatch roles inside it, and repeat the result with section-3 spacers.
+
+    Input structure:
+    - Full blue (1) separator rows or columns divide the input into four ordered sections.
+    - Section 1 is the yellow-on-black template and section 2 is the green component-count stencil.
+    - Sections 3 and 4 are solid color swatches; section 3 drives cropped background plus spacers, while section 4
+      colors the template shape itself.
+
+    Rule:
+    - Crop section 1 to the bbox of its non-black cells.
+    - Recolor that crop with swapped roles: template cells take section 4's color and cropped black cells take
+      section 3's color.
+    - Count 4-connected non-black components in section 2 and repeat the recolored crop that many times, inserting
+      a 1-cell separator row or column colored with section 3 between adjacent copies.
+
+    Key insight: The stencil still contributes only a repeat count, but the two color roles are fused:
+    section 3 is not the visible shape color anymore; it becomes the negative-space color inside the crop and the
+    separator-band color between copies, while section 4 paints the actual template mass.
+    """
+    g = np.asarray(grid, dtype=int)
+    orientation, sections = _split_sections(g)
+    template, repetition_pattern, section3_block, section4_block = sections[:4]
+
+    template_mask = template != 0
+    template_bbox = bbox(template_mask)
+    if template_bbox is None:
+        return np.empty((0, 0), dtype=int)
+
+    section3_color = _solid_color(section3_block)
+    section4_color = _solid_color(section4_block)
+    tile_mask = crop_bbox(template_mask, template_bbox)
+    tile = np.where(tile_mask, section4_color, section3_color).astype(int)
+
+    n_repeats = len(components_mask(repetition_pattern != 0, connectivity=4))
+    if n_repeats <= 1:
+        return tile
+
+    if orientation == "horizontal":
+        sep = np.full((tile.shape[0], 1), section3_color, dtype=int)
+        pieces = [tile] + [x for _ in range(n_repeats - 1) for x in (sep, tile)]
+        return np.hstack(pieces)
+
+    sep = np.full((1, tile.shape[1]), section3_color, dtype=int)
+    pieces = [tile] + [x for _ in range(n_repeats - 1) for x in (sep, tile)]
+    return np.vstack(pieces)
+
+
+# --------------- generator (c) ---------------
+
+# --- CFG: tunable generation parameters ---
+REPEAT_COUNT_RANGE = (2, 6)          # blob count N (= tile repetitions)
+CROP_SIZE_RANGE = (2, 5)             # crop height/width bounds
+DENSITY_RANGE = (0.55, 0.85)         # fill ratio of shape bounding box
+COLOR_POOL = list(range(2, 10))      # swatch colors (2-9 inclusive)
+TEMPLATE_COLOR = 4                   # shape drawn in yellow inside template
+STENCIL_COLOR = 3                    # blob color in stencil section
+SEPARATOR_COLOR = 1                  # blue separator rows/cols
+SWATCH_DIM_RANGE = (3, 8)            # varying-axis size for color swatches
+STENCIL_VARYING_EXTRA = 4            # max extra cells beyond minimum stencil size
+BLOB_PLACE_RETRIES = 200             # per-blob placement attempts in stencil
+GEN_RETRIES = 300                    # outer generate_input retry limit
+
+
+def _tile_repeat(tile: np.ndarray, n: int, sep_color: int, horizontal: bool) -> np.ndarray:
+    """Repeat `tile` n times along the given axis with 1-pixel sep_color separators."""
+    if horizontal:
+        sep = np.full((tile.shape[0], 1), sep_color, dtype=int)
+        pieces = [tile] + [x for _ in range(n - 1) for x in (sep, tile)]
+        return np.hstack(pieces)
+    sep = np.full((1, tile.shape[1]), sep_color, dtype=int)
+    pieces = [tile] + [x for _ in range(n - 1) for x in (sep, tile)]
+    return np.vstack(pieces)
+
+
+def _make_swatch(shared_dim: int, color: int, horizontal: bool) -> np.ndarray:
+    """Create a solid color swatch. shared_dim is the fixed axis; varying axis is random."""
+    varying = random.randint(*SWATCH_DIM_RANGE)
+    if horizontal:
+        return np.full((shared_dim, varying), color, dtype=int)
+    return np.full((varying, shared_dim), color, dtype=int)
+
+
+def _join_sections(sections: list[np.ndarray], shared_dim: int, horizontal: bool) -> np.ndarray:
+    """Join sections with single-pixel separator lines of SEPARATOR_COLOR."""
+    if horizontal:
+        sep = np.full((shared_dim, 1), SEPARATOR_COLOR, dtype=int)
+        parts = [sections[0]]
+        for s in sections[1:]:
+            parts.extend([sep, s])
+        return np.hstack(parts)
+    sep = np.full((1, shared_dim), SEPARATOR_COLOR, dtype=int)
+    parts = [sections[0]]
+    for s in sections[1:]:
+        parts.extend([sep, s])
+    return np.vstack(parts)
+
+
+def _build_stencil(n_blobs: int, shared_dim: int, horizontal: bool) -> np.ndarray | None:
+    """Place n_blobs 2-cell blobs of STENCIL_COLOR on a black grid with at least 1 black cell between blobs."""
+    min_varying = max(4, n_blobs * 2 + 2)
+    varying_dim = random.randint(min_varying, min_varying + STENCIL_VARYING_EXTRA)
+
+    h, w = (shared_dim, varying_dim) if horizontal else (varying_dim, shared_dim)
+    grid = np.zeros((h, w), dtype=int)
+
+    placed = 0
+    for _ in range(BLOB_PLACE_RETRIES):
+        if placed >= n_blobs:
+            break
+        br, bc = (1, 2) if random.choice([True, False]) else (2, 1)
+
+        if h - 1 - br < 1 or w - 1 - bc < 1:
+            continue
+        r = random.randint(1, h - 1 - br)
+        c = random.randint(1, w - 1 - bc)
+
+        r0, c0 = max(0, r - 1), max(0, c - 1)
+        r1, c1 = min(h, r + br + 1), min(w, c + bc + 1)
+        if np.any(grid[r0:r1, c0:c1] != 0):
+            continue
+
+        grid[r : r + br, c : c + bc] = STENCIL_COLOR
+        placed += 1
+
+    return grid if placed == n_blobs else None
+
+
+def _shape_has_cropped_background(shape: np.ndarray) -> bool:
+    """Require both shape cells and black cells inside the cropped bbox so the swapped mapping is visible."""
+    return bool(np.any(shape == TEMPLATE_COLOR) and np.any(shape == 0))
+
+
+def _gen_attempt() -> np.ndarray | None:
+    horizontal = random.choice([True, False])
+    n_repeats = random.randint(*REPEAT_COUNT_RANGE)
+
+    crop_h = random.randint(*CROP_SIZE_RANGE)
+    crop_w = random.randint(*CROP_SIZE_RANGE)
+    density = random.uniform(*DENSITY_RANGE)
+    shape = random_sprite(
+        crop_h,
+        crop_w,
+        density=density,
+        color_palette=[TEMPLATE_COLOR],
+        connectivity=4,
+        symmetry="not_symmetric",
+    )
+    if not _shape_has_cropped_background(shape):
+        return None
+
+    section3_color, section4_color = random.sample(COLOR_POOL, 2)
+
+    tile = np.where(shape != 0, section4_color, section3_color).astype(int)
+    output = _tile_repeat(tile, n_repeats, section3_color, horizontal)
+
+    # Guard against degeneration into the original task or a swap-only/no-D5 variant.
+    original_tile = np.where(shape != 0, section3_color, section4_color).astype(int)
+    original_output = _tile_repeat(original_tile, n_repeats, section4_color, horizontal)
+    swap_only_output = _tile_repeat(tile, n_repeats, section4_color, horizontal)
+    if np.array_equal(output, original_output) or np.array_equal(output, swap_only_output):
+        return None
+
+    template = np.zeros((crop_h + 2, crop_w + 2), dtype=int)
+    template[1 : crop_h + 1, 1 : crop_w + 1] = shape
+
+    shared_dim = (crop_h + 2) if horizontal else (crop_w + 2)
+    stencil = _build_stencil(n_repeats, shared_dim, horizontal)
+    if stencil is None:
+        return None
+
+    section3_swatch = _make_swatch(shared_dim, section3_color, horizontal)
+    section4_swatch = _make_swatch(shared_dim, section4_color, horizontal)
+    inp = _join_sections([template, stencil, section3_swatch, section4_swatch], shared_dim, horizontal)
+
+    try:
+        if np.array_equal(main(inp), output):
+            return inp
+    except Exception:
+        pass
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        result = _gen_attempt()
+        if result is not None:
+            return result
+    raise RuntimeError(f"Failed to generate valid input after {GEN_RETRIES} attempts")

