+    parts = [sections[0]]
+    for section in sections[1:]:
+        parts.extend([sep, section])
+    return np.vstack(parts)
+
+
+def _make_cluster(area: int, horizontal: bool) -> np.ndarray:
+    cluster = BASE_CLUSTER_BY_AREA[area].copy()
