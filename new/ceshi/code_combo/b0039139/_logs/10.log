+            c0 = random.randint(0, shared_dim - cw)
+            view = grid[cursor : cursor + ch, c0 : c0 + cw]
+            view[cluster] = STENCIL_COLOR
+            cursor += ch
+        if idx < len(clusters) - 1:
+            cursor += STENCIL_GAP
+
+    return grid
+
+
+def _gen_attempt() -> np.ndarray | None:
+    horizontal = random.choice([True, False])
+
