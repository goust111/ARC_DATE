+    mapping = {
+        seed[0]: seed[1],
+        seed[1]: seed[2],
+        seed[2]: seed[0],
+    }
+    for triple in triple_set:
+        for idx in range(3):
+            assert mapping[triple[idx]] == triple[(idx + 1) % 3], "cycle must be globally consistent"
+    return mapping
+
