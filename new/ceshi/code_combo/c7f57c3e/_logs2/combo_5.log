+        for rr, cc in s["pts"]:
+            out[rr, cc] = bg
+
+        r0, c0, r1, c1 = s["bbox"]
+        patch = out[r0 : r1 + 1, c0 : c1 + 1]
+        mask = repl != bg
+        patch[mask] = repl[mask]
