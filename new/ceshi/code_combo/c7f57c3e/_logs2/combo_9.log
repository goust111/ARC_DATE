+
+def _colorize(labels: np.ndarray, bg: int, accent: int) -> np.ndarray:
+    """Instantiate one logical sprite from structural labels."""
+    arr = np.full(labels.shape, bg, dtype=int)
+    arr[labels == 1] = 1
+    arr[labels == 2] = CORE_COLOR
+    arr[labels == 3] = accent
+    return arr
