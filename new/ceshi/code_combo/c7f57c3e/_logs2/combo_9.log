   350	        2: CORE_ROW_WEIGHTS,
   351	        3: ACCENT_ROW_WEIGHTS,
   352	    }
   353	    masks = []
   354	    for role in roles:
   355	        kinds, wts = zip(*weights_by_role[role])
   356	        masks.append(_row_mask(random.choices(kinds, weights=wts)[0], w))
   357	
   358	    if not any(mask[0] or mask[-1] for mask in masks):
   359	        idx = random.randrange(h)
   360	        if roles[idx] == 1 and random.random() < OUTER_FIXUP_PROB:

