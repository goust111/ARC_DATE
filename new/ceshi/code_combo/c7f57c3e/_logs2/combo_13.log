+    grid[bottom, left : right + 1] = int(color)
+    grid[top : bottom + 1, left] = int(color)
+    grid[top : bottom + 1, right] = int(color)
+    grid[top : bottom + 1, divider_c] = int(color)
+
+
+def _gen_attempt() -> np.ndarray | None:
+    bg = random.choice(BG_CHOICES)
