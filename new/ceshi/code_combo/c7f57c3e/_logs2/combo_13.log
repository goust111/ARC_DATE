+    legend = _build_legend(src_pairs, dst_pairs)
+
+    count = random.choice(SPRITE_COUNTS)
+    big_scale = random.choice(BIG_SCALES)
+    instances: list[tuple[int, int, str]] = [
+        (0, 1, "left"),
+        (1, 1, "right"),
+        (random.randrange(2), big_scale, random.choice(["left", "right"])),
