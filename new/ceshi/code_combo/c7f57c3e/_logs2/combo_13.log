+        marker,
+        transparent=bg,
+        border=0,
+        padding=PLACEMENT_PADDING,
+        padding_connectivity=PLACEMENT_CONNECTIVITY,
+    )
+    return r0 + sr, c0 + sc
+
+
+def _draw_separator(
+    grid: np.ndarray,
+    top: int,
+    bottom: int,
+    left: int,
+    right: int,
+    divider_c: int,
+    color: int,
+) -> None:
