+    n = random.randint(min_n, GRID_SIZE_MAX)
+
+    left = 1
+    right = n - 2
+    bottom = n - 2
+    divider_min = need_room_w + 4
+    divider_max = n - 5 - need_room_w
+    if divider_min > divider_max:
