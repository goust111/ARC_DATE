def _normalize_sprite(arr: np.ndarray, bg: int, source_pair: tuple[int, int]) -> np.ndarray:
    """Map a colored sprite back to canonical labels {0,1,2,3}."""
    allowed = {int(bg), 1, int(source_pair[0]), int(source_pair[1])}
