+    min_n = max(GRID_SIZE_MIN, LEGEND_SHAPE[1] + 2, need_room_h + top + 3, 2 * need_room_w + 5)
+    if min_n > GRID_SIZE_MAX:
+        return None
+    n = random.randint(min_n, GRID_SIZE_MAX)
+
+    left = 1
+    right = n - 2
+    bottom = n - 2
+    divider_min = need_room_w + 2
+    divider_max = n - 3 - need_room_w
+    if divider_min > divider_max:
+        return None
+    divider_c = random.randint(divider_min, divider_max)
+
+    left_room = (top + 1, left + 1, bottom - 1, divider_c - 1)
