+        best_score = -1
+        for idx, p in enumerate(protos):
+            sp = _scale_nn(p, scale)
+            pr0, pc0, _pr1, _pc1 = _pick_anchor_bbox(p, bg)
+            pr0 *= scale
+            pc0 *= scale
+            top = (r0 + ar0) - pr0
+            left = (c0 + ac0) - pc0
