   156	def main(grid: np.ndarray) -> np.ndarray:
   157	    """
   158	    Exchange group-level color patterns by size class, but only for sprites above the minimum-area threshold.
   159	
   160	    Input structure:
   161	    - The grid contains exactly four separated multicolor sprites built from two anchor-compatible prototypes.
   162	    - Their bbox areas occur in three levels: one smallest sprite, one medium sprite, and two largest sprites.
   163	    - The smallest and medium sprites form the small-size group; the two largest sprites form the large-size group.
   164	
   165	    Rule:
   166	    - Use bbox area to split sprites into the two size groups, but use a stricter condition for participation: only sprites with area greater than the minimum area are allowed to change.
   167	    - The minimum-area sprite stays fixed and reveals the small-group prototype.
   168	    - The medium sprite switches to that small-group prototype, while the largest sprites switch to the other prototype, always preserving each sprite's own scale and anchor alignment.
   169	
   170	    Key insight: Size drives two different decisions. Relative size class says which group a sprite belongs to, but the absolute minimum-area cutoff says whether that group member is frozen or swappable, so the medium sprite is the crucial case where those two rules diverge.
   171	    """
   172	    g = np.asarray(grid, dtype=int)
   173	    bg = get_bg(g)
   174	
   175	    comps = components_mask(g != bg, connectivity=8)
   176	    assert len(comps) == 4, "combo variant expects exactly 4 sprite components"
   177	
   178	    sprites = []
   179	    for pts in comps:
   180	        r0, c0, r1, c1 = bbox_coords(pts)
   181	        arr = g[r0 : r1 + 1, c0 : c1 + 1].copy()
   182	        sprites.append({"pts": pts, "bbox": (r0, c0, r1, c1), "arr": arr})
   183	
   184	    areas = [_bbox_area(s["bbox"]) for s in sprites]
   185	    area_levels = sorted(set(areas))
   186	    assert len(area_levels) == 3, "combo variant expects exactly 3 bbox-area levels"
   187	    min_area, mid_area, max_area = area_levels
   188	    assert areas.count(min_area) == 1, "must have exactly one minimum-area sprite"
