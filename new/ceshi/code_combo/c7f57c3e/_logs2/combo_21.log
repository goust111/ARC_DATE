+        classified.append(
+            {
+                "type": int(best_idx),
+                "scale": int(scale),
+                "output_bbox": (int(top), int(left), int(top + sp.shape[0] - 1), int(left + sp.shape[1] - 1)),
+            }
+        )
+
+    if decorate:
+        by_scale: dict[int, list[dict]] = {}
+        for rec in classified:
+            by_scale.setdefault(int(rec["scale"]), []).append(rec)
+
+        for scale, group in by_scale.items():
