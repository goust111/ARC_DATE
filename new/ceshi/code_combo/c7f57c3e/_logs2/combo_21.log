+# --------------- generator ---------------
+
+# --- CFG: canvas ---
+GRID_SIZE_MIN = 22
+GRID_SIZE_MAX = 28
+GRID_MARGIN_FOR_PAIRS = 4
+
+# --- CFG: prototypes ---
+BG_CHOICES = [0, 2, 3, 4, 5, 6, 7, 8, 9]
+LABEL_TEMPLATES = [
+    np.array(
+        [
+            [0, 2, 0],
+            [1, 1, 1],
+            [0, 2, 0],
+            [3, 3, 3],
+        ],
+        dtype=int,
+    ),
+    np.array(
+        [
+            [0, 2, 2, 0],
+            [1, 1, 1, 1],
+            [0, 2, 2, 0],
+            [3, 0, 0, 3],
+        ],
+        dtype=int,
+    ),
+    np.array(
+        [
+            [0, 2, 2, 0],
+            [1, 1, 1, 1],
+            [0, 2, 2, 0],
+            [0, 2, 2, 0],
+            [3, 0, 0, 3],
+        ],
+        dtype=int,
+    ),
+]
+
+# --- CFG: pairs ---
+SCALES = [1, 2]
+PAIR_GAP_BY_SCALE = {1: [5, 6, 7], 2: [6, 7]}
+ORIENTATIONS = ["h", "v"]
+
+# --- CFG: placement ---
+PLACEMENT_BORDER = 1
+PLACEMENT_PADDING = 2
+PLACEMENT_CONNECTIVITY = 8
+
+# --- CFG: generation retries ---
+MAX_RETRIES = 400
