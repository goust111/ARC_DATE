+    ha, wa = inp_a.shape
+    hb, wb = inp_b.shape
+
+    if orientation == "h":
+        in_top_a = max(0, anc_b[0] - anc_a[0])
+        in_top_b = max(0, anc_a[0] - anc_b[0])
+        in_left_a = 0
+        in_left_b = wa + gap
+    else:
+        in_left_a = max(0, anc_b[1] - anc_a[1])
+        in_left_b = max(0, anc_a[1] - anc_b[1])
+        in_top_a = 0
+        in_top_b = ha + gap
+
+    anchor_a = (in_top_a + anc_a[0], in_left_a + anc_a[1])
+    anchor_b = (in_top_b + anc_b[0], in_left_b + anc_b[1])
+    out_top_a = int(anchor_a[0] - anc_out_a[0])
+    out_left_a = int(anchor_a[1] - anc_out_a[1])
+    out_top_b = int(anchor_b[0] - anc_out_b[0])
+    out_left_b = int(anchor_b[1] - anc_out_b[1])
+
+    placements = [
+        (inp_a, in_top_a, in_left_a),
+        (inp_b, in_top_b, in_left_b),
+        (out_a, out_top_a, out_left_a),
+        (out_b, out_top_b, out_left_b),
+    ]
