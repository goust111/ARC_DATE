   398	    return np.repeat(np.repeat(arr, k, axis=0), k, axis=1)
   399	
   400	
   401	def _make_labels() -> np.ndarray:
   402	    h, w = random.choice(PROTO_SHAPES)
   403	
   404	    counts = {1: 1, 2: 1, 3: 1}
   405	    if h > 3:
   406	        counts[random.choice([1, 2, 3])] += h - 3
   407	    roles = []
   408	    for role in random.sample([1, 2, 3], 3):
   409	        roles.extend([role] * counts[role])
   410	
   411	    weights_by_role = {1: ANCHOR_ROW_WEIGHTS, 2: VARIABLE_ROW_WEIGHTS, 3: VARIABLE_ROW_WEIGHTS}
   412	    masks = []
   413	    for role in roles:
   414	        kinds, wts = zip(*weights_by_role[role])
   415	        masks.append(_row_mask(random.choices(kinds, weights=wts)[0], w))
   416	
   417	    if not any(mask[0] or mask[-1] for mask in masks):
   418	        i = random.randrange(h)
   419	        if roles[i] == 1 and random.random() < OUTER_FIXUP_PROB:
   420	            masks[i] = _row_mask("outer", w)
   421	        else:
   422	            masks[i] = _row_mask("full", w)
   423	
   424	    if all(all(mask) for mask in masks):
   425	        masks[random.randrange(h)] = _row_mask("center", w)
   426	
   427	    labels = np.zeros((h, w), dtype=int)
   428	    for r, (role, mask) in enumerate(zip(roles, masks)):
   429	        for c, bit in enumerate(mask):
   430	            if bit:
   431	                labels[r, c] = role
   432	    return labels
   433	
   434	
   435	def _make_prototypes(bg: int) -> tuple[np.ndarray, np.ndarray]:
   436	    labels = _make_labels()
   437	    pool = [c for c in range(10) if c not in (bg, 1)]
   438	    a_cols = random.sample(pool, 2)
   439	    remaining = [c for c in pool if c not in a_cols]
   440	    if random.random() < COLOR_SHARE_PROB:
   441	        b_cols = [random.choice(a_cols), random.choice(remaining)]
   442	        random.shuffle(b_cols)
   443	    else:
   444	        b_cols = random.sample(remaining, 2)
   445	
   446	    def _colorize(lab: np.ndarray, cols: list[int]) -> np.ndarray:
   447	        proto = np.full(lab.shape, bg, dtype=int)
   448	        proto[lab == 1] = 1
   449	        proto[lab == 2] = cols[0]
   450	        proto[lab == 3] = cols[1]
   451	        return proto
   452	
   453	    return _colorize(labels, a_cols), _colorize(np.flipud(labels), b_cols)
