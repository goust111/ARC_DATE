   460	def _bboxes_separated(bboxes: list[tuple[int, int, int, int]], padding: int) -> bool:
   461	    for i, (r0, c0, r1, c1) in enumerate(bboxes):
   462	        for rr0, cc0, rr1, cc1 in bboxes[i + 1 :]:
   463	            rows_hit = _intervals_overlap(r0, r1, rr0, rr1, padding)
   464	            cols_hit = _intervals_overlap(c0, c1, cc0, cc1, padding)
   465	            if rows_hit and cols_hit:
