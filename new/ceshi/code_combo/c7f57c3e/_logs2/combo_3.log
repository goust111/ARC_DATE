   109	def _infer_scale(arr: np.ndarray, base_anchor_hw: tuple[int, int], bg: int) -> int:
   110	    ar0, ac0, ar1, ac1 = _pick_anchor_bbox(arr, bg)
   111	    inst_h = ar1 - ar0 + 1
   112	    inst_w = ac1 - ac0 + 1
