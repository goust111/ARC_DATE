   277	        patch = item["patch"]
   278	        assert _can_place(out, patch, top, left, bg), "replacement patch must fit before gravity"
   279	        paste(out, patch, top, left, transparent=bg)
   280	    return out
   281	
   282	
   283	def _settle_replacements(
   284	    shape: tuple[int, int],
   285	    bg: int,
   286	    replacements: list[dict],
   287	) -> tuple[np.ndarray, list[dict]]:
   288	    h, _w = shape
   289	    board = np.full(shape, bg, dtype=int)
   290	    landed = []
   291	
   292	    order = sorted(
   293	        replacements,
   294	        key=lambda item: (
   295	            int(item["start_top"]) + int(item["patch"].shape[0]),
   296	            int(item["start_top"]),
   297	            -int(item["start_left"]),
   298	        ),
   299	        reverse=True,
   300	    )
   301	
   302	    for item in order:
   303	        patch = item["patch"]
   304	        ph, _pw = patch.shape
   305	        top = int(item["start_top"])
   306	        left = int(item["start_left"])
   307	        assert _can_place(board, patch, top, left, bg), "transformed patches must start non-overlapping"
   308	
   309	        while top + ph < h and _can_place(board, patch, top + 1, left, bg):
   310	            top += 1
   311	
   312	        paste(board, patch, top, left, transparent=bg)
   313	        landed.append(
   314	            {
   315	                "start_top": int(item["start_top"]),
   316	                "start_left": left,
   317	                "final_top": top,
   318	                "patch": patch,
   319	                "src_anchor": item["src_anchor"],
   320	                "dst_anchor": item["dst_anchor"],
   321	            }
   322	        )
   323	
   324	    return board, landed
   325	
   326	
   327	def main(grid: np.ndarray) -> np.ndarray:
   328	    """
   329	    Pair each nearby opposite-pattern sprite, send its swapped prototype to the partner position, then let the result fall.
   330	
   331	    Input structure:
   332	    - The background is the most frequent color, and exactly two multicolor sprite prototypes appear as disconnected components.
   333	    - The board contains four sprite instances total: two prototype-A copies and two prototype-B copies, with one small and one large scale for each family.
   334	
   335	    Rule:
   336	    - Recover the two scale-1 prototypes, classify every sprite by prototype and integer scale, and match A sprites with B sprites by nearest-anchor bipartite pairing.
   337	    - For each matched pair, keep each sprite's own scale, switch it to the opposite prototype, and place that swapped patch at the partner's anchor position.
   338	    - After all pairwise exchanges are prepared, drop every swapped patch straight downward until it hits the bottom edge or a previously settled patch.
   339	
   340	    Key insight:
   341	    - The task is not an in-place recoloring problem anymore: the color-1 anchor is used twice, first to recover which opposite-pattern sprites belong together and where their exchanged start positions are, and then as the fixed horizontal guide for the gravity phase that stacks the exchanged patches.
   342	    """
   343	    g = np.asarray(grid, dtype=int)
   344	    bg = get_bg(g)
   345	    replacements = _prepare_combo_replacements(g, bg)
   346	    out, _landed = _settle_replacements(g.shape, bg, replacements)
   347	    return out
   348	
