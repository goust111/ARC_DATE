   126	def _paste_aligned(
   127	    out: np.ndarray,
   128	    proto: np.ndarray,
   129	    bbox: tuple[int, int, int, int],
   130	    anc: tuple[int, int, int, int],
   131	    scale: int,
   132	    bg: int,
   133	) -> None:
   134	    h, w = out.shape
   135	    r0, c0, _r1, _c1 = bbox
   136	    ar0, ac0, _ar1, _ac1 = anc
   137	    scaled = _scale_nn(proto, scale)
   138	    pr0, pc0, _pr1, _pc1 = _pick_anchor_bbox(proto, bg)
   139	    top = (r0 + ar0) - (pr0 * scale)
   140	    left = (c0 + ac0) - (pc0 * scale)
   141	
   142	    ph, pw = scaled.shape
   143	    rr0 = max(0, top)
   144	    cc0 = max(0, left)
   145	    rr1 = min(h, top + ph)
   146	    cc1 = min(w, left + pw)
   147	    sub_p = scaled[(rr0 - top) : (rr1 - top), (cc0 - left) : (cc1 - left)]
   148	    m = sub_p != bg
   149	    out_slice = out[rr0:rr1, cc0:cc1]
   150	    out_slice[m] = sub_p[m]
   151	    out[rr0:rr1, cc0:cc1] = out_slice
   152	
   153	
   154	def main(grid: np.ndarray) -> np.ndarray:
   155	    """
   156	    Swap only the enlarged sprites, then recolor the whole background from the participating majority.
   157	
   158	    Input structure:
   159	    - The most common color is the input background. Separate components are scaled copies of exactly two prototype sprites.
   160	    - The smallest bbox-area sprites expose both prototypes directly, while any larger sprites are integer enlargements of one of them.
   161	
   162	    Rule:
   163	    - Recover the two prototypes from the minimum-area sprites and treat only larger sprites as swap participants.
   164	    - For every sprite, infer its prototype identity and integer scale from the color-1 anchor bbox. Non-participants keep their own prototype; participants switch to the opposite one at the same anchored placement.
   165	    - Count only the participating sprites by input prototype. If A-participants are the majority, rebuild the entire output on B's associated color; if B-participants are the majority, rebuild it on A's associated color. A tie leaves the background unchanged.
   166	
   167	    Key insight: The smallest sprites serve two jobs at once: they reveal the base prototypes and define who is exempt. Once that participation set is known, it controls both the local swaps and the global background color, so the output must be reconstructed from scratch rather than edited in place.
   168	    """
   169	    g = np.asarray(grid, dtype=int)
   170	    bg = get_bg(g)
   171	
   172	    comps = components_mask(g != bg, connectivity=8)
   173	    assert len(comps) >= 2, "grid must contain at least 2 sprite components"
   174	
   175	    sprites = []
   176	    for pts in comps:
   177	        r0, c0, r1, c1 = bbox_coords(pts)
   178	        arr = g[r0 : r1 + 1, c0 : c1 + 1].copy()
   179	        sprites.append({"pts": pts, "bbox": (r0, c0, r1, c1), "arr": arr})
   180	
   181	    areas = [_bbox_area(s["bbox"]) for s in sprites]
   182	    min_area = min(areas)
   183	    base = [s for s, area in zip(sprites, areas, strict=False) if area == min_area]
   184	    uniq: dict[tuple[int, ...], np.ndarray] = {}
   185	    for sprite in base:
   186	        key = tuple(sprite["arr"].ravel().tolist())
   187	        if key not in uniq:
   188	            uniq[key] = sprite["arr"]
   189	    assert len(uniq) == 2, "smallest-area sprites must yield exactly 2 distinct prototype patterns"
   190	
   191	    protos = list(uniq.values())[:2]
   192	    anc0 = _pick_anchor_bbox(protos[0], bg)
   193	    anc1 = _pick_anchor_bbox(protos[1], bg)
   194	    base_anc_h0 = anc0[2] - anc0[0] + 1
   195	    base_anc_w0 = anc0[3] - anc0[1] + 1
   196	    base_anc_h1 = anc1[2] - anc1[0] + 1
   197	    base_anc_w1 = anc1[3] - anc1[1] + 1
   198	    assert (base_anc_h0, base_anc_w0) == (base_anc_h1, base_anc_w1), "prototype anchors must share a size"
   199	
   200	    signature_colors = [_signature_color(proto, bg) for proto in protos]
   201	    classified = []
   202	    participant_counts = [0, 0]
   203	    for sprite, area in zip(sprites, areas, strict=False):
   204	        scale, anc = _infer_scale(sprite["arr"], base_anc_h0, base_anc_w0, bg)
   205	        proto_idx = _match_prototype(g, sprite["bbox"], protos, scale, anc, bg)
   206	        participates = area > min_area
   207	        if participates:
   208	            participant_counts[proto_idx] += 1
   209	        classified.append(
   210	            {
   211	                "bbox": sprite["bbox"],
   212	                "anc": anc,
   213	                "scale": scale,
   214	                "proto_idx": proto_idx,
   215	                "participates": participates,
   216	            }
   217	        )
   218	
   219	    if participant_counts[0] > participant_counts[1]:
   220	        out_bg = signature_colors[1]
   221	    elif participant_counts[1] > participant_counts[0]:
   222	        out_bg = signature_colors[0]
   223	    else:
   224	        out_bg = bg
   225	
   226	    out = np.full_like(g, out_bg)
   227	    for info in classified:
   228	        target_idx = 1 - info["proto_idx"] if info["participates"] else info["proto_idx"]
   229	        _paste_aligned(out, protos[target_idx], info["bbox"], info["anc"], info["scale"], bg)
   230	    return out
   231	
