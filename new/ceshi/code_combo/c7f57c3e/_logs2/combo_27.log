   246	BODY_ROW_WEIGHTS = [("center", 0.35), ("outer", 0.15), ("full", 0.50)]
   247	SIGNATURE_ROW_WEIGHTS = [("center", 0.80), ("outer", 0.20)]
   248	OUTER_FIXUP_PROB = 0.7
   249	
   250	# --- CFG: sprite instances ---
   251	BIG_SCALES = [2, 3]
   252	
   253	# --- CFG: placement ---
   254	PLACEMENT_BORDER = 1
   255	PLACEMENT_PADDING = 2
   256	PLACEMENT_CONNECTIVITY = 8
   257	
   258	# --- CFG: generation retries ---
   259	MAX_RETRIES = 300
   260	
   261	_ROW_MASKS = {
   262	    "center": {4: [0, 1, 1, 0], 5: [0, 1, 1, 1, 0]},
   263	    "outer": {4: [1, 0, 0, 1], 5: [1, 0, 0, 0, 1]},
   264	    "full": {4: [1, 1, 1, 1], 5: [1, 1, 1, 1, 1]},
   265	}
