    61	def _bbox_area(bbox: tuple[int, int, int, int]) -> int:
    62	    r0, c0, r1, c1 = bbox
    63	    return int((r1 - r0 + 1) * (c1 - c0 + 1))
    64	
    65	
    66	def _infer_scale(
    67	    arr: np.ndarray, base_anchor_h: int, base_anchor_w: int, bg: int
    68	) -> tuple[int, tuple[int, int, int, int]]:
    69	    anc = _pick_anchor_bbox(arr, bg)
    70	    ar0, ac0, ar1, ac1 = anc
    71	    inst_anc_h = ar1 - ar0 + 1
    72	    inst_anc_w = ac1 - ac0 + 1
    73	    scale_h = max(1, inst_anc_h // max(1, base_anchor_h))
    74	    scale_w = max(1, inst_anc_w // max(1, base_anchor_w))
    75	    return int(max(scale_h, scale_w)), anc
