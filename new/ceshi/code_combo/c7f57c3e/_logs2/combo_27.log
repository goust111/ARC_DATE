+_ROW_MASKS = {
+    "center": {4: [0, 1, 1, 0], 5: [0, 1, 1, 1, 0]},
+    "outer": {4: [1, 0, 0, 1], 5: [1, 0, 0, 0, 1]},
+    "full": {4: [1, 1, 1, 1], 5: [1, 1, 1, 1, 1]},
+}
+
+
+def _row_mask(kind: str, w: int) -> list[int]:
