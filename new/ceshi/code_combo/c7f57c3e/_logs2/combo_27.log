   272	def _anchor_bbox(arr: np.ndarray) -> tuple[int, int, int, int]:
   273	    rs, cs = np.where(arr == 1)
   274	    return int(rs.min()), int(cs.min()), int(rs.max()), int(cs.max())
   275	
