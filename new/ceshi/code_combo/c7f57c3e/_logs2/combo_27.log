    48	def _pick_anchor_bbox(arr: np.ndarray, bg: int) -> tuple[int, int, int, int]:
    49	    if np.any(arr == 1):
    50	        ys, xs = np.where(arr == 1)
    51	        return int(ys.min()), int(xs.min()), int(ys.max()), int(xs.max())
