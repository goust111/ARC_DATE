   283	def _make_labels() -> np.ndarray:
   284	    h, w = random.choice(PROTO_SHAPES)
   285	    roles = [1] + [2] * (h - 2) + [3]
   286	    random.shuffle(roles)
   287	
   288	    weights_by_role = {
   289	        1: ANCHOR_ROW_WEIGHTS,
   290	        2: BODY_ROW_WEIGHTS,
   291	        3: SIGNATURE_ROW_WEIGHTS,
   292	    }
   293	    masks = []
   294	    for role in roles:
   295	        kinds, weights = zip(*weights_by_role[role])
   296	        masks.append(_row_mask(random.choices(kinds, weights=weights)[0], w))
   297	
   298	    if not any(mask[0] or mask[-1] for mask in masks):
   299	        i = random.randrange(h)
   300	        if roles[i] == 1 and random.random() < OUTER_FIXUP_PROB:
   301	            masks[i] = _row_mask("outer", w)
   302	        else:
   303	            masks[i] = _row_mask("full", w)
   304	
   305	    if all(all(mask) for mask in masks):
   306	        candidates = [i for i, role in enumerate(roles) if role != 1]
   307	        i = random.choice(candidates)
   308	        masks[i] = _row_mask("center", w)
   309	
   310	    labels = np.zeros((h, w), dtype=int)
   311	    for r, (role, mask) in enumerate(zip(roles, masks, strict=False)):
   312	        for c, bit in enumerate(mask):
   313	            if bit:
   314	                labels[r, c] = role
   315	    return labels
   316	
   317	
   318	def _make_prototypes(bg: int) -> tuple[np.ndarray, np.ndarray]:
   319	    labels = _make_labels()
   320	    pool = [c for c in range(10) if c not in (bg, 1)]

