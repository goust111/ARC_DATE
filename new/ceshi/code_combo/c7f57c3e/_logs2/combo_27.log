    78	def _match_prototype(
    79	    g: np.ndarray,
    80	    bbox: tuple[int, int, int, int],
    81	    protos: list[np.ndarray],
    82	    scale: int,
    83	    anc: tuple[int, int, int, int],
    84	    bg: int,
    85	) -> int:
    86	    h, w = g.shape
    87	    r0, c0, _r1, _c1 = bbox
    88	    ar0, ac0, _ar1, _ac1 = anc
    89	    best_idx = 0
    90	    best_score = -1
    91	    for idx, proto in enumerate(protos):
    92	        scaled = _scale_nn(proto, scale)
    93	        pr0, pc0, _pr1, _pc1 = _pick_anchor_bbox(proto, bg)
    94	        top = (r0 + ar0) - (pr0 * scale)
    95	        left = (c0 + ac0) - (pc0 * scale)
    96	
    97	        ph, pw = scaled.shape
    98	        rr0 = max(0, top)
    99	        cc0 = max(0, left)
   100	        rr1 = min(h, top + ph)
   101	        cc1 = min(w, left + pw)
   102	        if rr0 >= rr1 or cc0 >= cc1:
   103	            continue
   104	        sub_g = g[rr0:rr1, cc0:cc1]
   105	        sub_p = scaled[(rr0 - top) : (rr1 - top), (cc0 - left) : (cc1 - left)]
   106	        m = sub_p != bg
   107	        score = int(np.sum(sub_g[m] == sub_p[m])) if np.any(m) else 0
   108	        if score > best_score:
   109	            best_score = score
   110	            best_idx = idx
   111	    return best_idx
