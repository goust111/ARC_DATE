+# --- CFG: row-mask weights ---
+ANCHOR_ROW_WEIGHTS = [("center", 0.45), ("outer", 0.30), ("full", 0.25)]
+BODY_ROW_WEIGHTS = [("center", 0.35), ("outer", 0.15), ("full", 0.50)]
+SIGNATURE_ROW_WEIGHTS = [("center", 0.80), ("outer", 0.20)]
