   114	def _signature_color(arr: np.ndarray, bg: int) -> int:
   115	    colors = [int(v) for v in arr.ravel().tolist() if v not in (bg, 1)]
   116	    counts = Counter(colors)
   117	    assert len(counts) == 2, "prototype must use exactly two variable colors"
   118	    min_count = min(counts.values())
   119	    for v in arr.ravel().tolist():
   120	        color = int(v)
   121	        if color in counts and counts[color] == min_count:
   122	            return color
   123	    assert False, "signature color lookup failed"
