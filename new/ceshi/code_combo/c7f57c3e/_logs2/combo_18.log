+            left = (c0 + bc0) - pbc0 * scale
+
+            ph, pw = scaled.shape
+            rr0 = max(0, top)
+            cc0 = max(0, left)
+            rr1 = min(h, top + ph)
+            cc1 = min(w, left + pw)
+            if rr0 >= rr1 or cc0 >= cc1:
+                continue
+
+            sub_g = g[rr0:rr1, cc0:cc1]
+            sub_p = scaled[(rr0 - top) : (rr1 - top), (cc0 - left) : (cc1 - left)]
+            m = sub_p != bg
+            if np.any(m):
+                score = int(np.sum(sub_g[m] == sub_p[m]))
+                if score > best_score:
+                    best_score = score
+                    best_idx = idx
