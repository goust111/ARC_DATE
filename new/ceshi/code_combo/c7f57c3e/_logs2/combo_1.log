+
+    return out
+
+
+# Shape family A: missing bottom corners. Shape family B: missing top-right and bottom-right corners.
+# In both families, the 2-hole member differs only by adding one extra enclosed bg cell.
+SHAPE_FAMILY_LABELS = {
+    "A": {
+        1: np.array(
+            [
+                [2, 2, 1, 3, 3],
+                [2, 0, 1, 3, 3],
+                [2, 2, 1, 3, 3],
+                [2, 2, 1, 3, 3],
+                [0, 2, 1, 3, 0],
+            ],
+            dtype=int,
