+                [2, 2, 1, 3, 3],
+                [2, 0, 1, 0, 3],
+                [2, 2, 1, 3, 3],
+                [2, 2, 1, 3, 3],
+                [0, 2, 1, 3, 0],
+            ],
+            dtype=int,
+        ),
+    },
+    "B": {
+        1: np.array(
+            [
+                [2, 2, 1, 3, 0],
+                [2, 2, 1, 3, 3],
+                [2, 2, 1, 0, 3],
+                [2, 2, 1, 3, 3],
+                [2, 2, 1, 3, 0],
+            ],
+            dtype=int,
