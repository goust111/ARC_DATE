+    filled = mask.copy()
+    for k in range(1, n + 1):
+        pts = np.argwhere(lab == k)
+        if np.any(pts[:, 0] == 0) or np.any(pts[:, 0] == h - 1) or np.any(pts[:, 1] == 0) or np.any(pts[:, 1] == w - 1):
