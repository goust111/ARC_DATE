+    try:
+        solved = main(inp)
+    except Exception:
+        return None
+    if np.array_equal(solved, out):
+        return inp
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
