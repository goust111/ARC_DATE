   198	def main(grid: np.ndarray) -> np.ndarray:
   199	    """
   200	    Pair opposite prototypes across rows, swap prototype+scale bundles, then lay the results out in scale order on an expanded grid.
   201	
   202	    Input structure:
   203	    - The background is uniform. Exactly four connected sprites appear, all built from the same two multicolor prototypes.
   204	    - Each prototype appears twice at integer scales, and the four sprites occupy a visible 2x2 pairing layout with one sprite of each prototype in each row.
   205	
   206	    Rule:
   207	    - Recover the two base prototypes from the smallest sprites, then infer every sprite's prototype type and integer scale from its color-1 anchor box.
   208	    - Within each prototype, sort sprites from top to bottom and pair the k-th sprite of one prototype with the k-th sprite of the other; each pair exchanges prototype and scale together.
   209	    - Take the four exchanged results, sort them globally by scale from small to large, break ties by the original visible slot order, and place them left to right on a newly sized output grid.
   210	
   211	    Key insight: Scale no longer belongs to the destination slot, and position no longer belongs to the original component; first the pair determines which prototype-scale bundle exists, then the bundle's scale determines where it lands in the expanded row.
   212	    """
   213	    g = np.asarray(grid, dtype=int)
   214	    bg = get_bg(g)
   215	
   216	    comps = components_mask(g != bg, connectivity=8)
   217	    assert len(comps) == 4, "combo variant expects exactly four sprite components"
   218	
   219	    sprites: list[dict[str, object]] = []
   220	    for idx, pts in enumerate(comps):
   221	        r0, c0, r1, c1 = bbox_coords(pts)
   222	        arr = g[r0 : r1 + 1, c0 : c1 + 1].copy()
   223	        sprites.append({"index": int(idx), "pts": pts, "bbox": (r0, c0, r1, c1), "arr": arr})
   224	
   225	    protos = _recover_prototypes(sprites)
   226	    _classify_sprites(sprites, protos, bg)
   227	    transformed = _transformed_records(sprites)
   228	    return _render_sorted_row(protos, bg, transformed, border=OUT_BORDER, gap=OUT_GAP)
