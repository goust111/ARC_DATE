+    protos = _recover_prototypes(sprites)
+    _classify_sprites(sprites, protos, bg)
+    transformed = _transformed_records(sprites)
+    return _render_sorted_row(protos, bg, transformed, border=OUT_BORDER, gap=OUT_GAP)
