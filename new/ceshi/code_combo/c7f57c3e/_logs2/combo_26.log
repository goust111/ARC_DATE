+        {"slot_rank": 1, "type": int(swapped[1][0]), "scale": int(swapped[1][1])},
+        {"slot_rank": 2, "type": int(swapped[2][0]), "scale": int(swapped[2][1])},
+        {"slot_rank": 3, "type": int(swapped[3][0]), "scale": int(swapped[3][1])},
