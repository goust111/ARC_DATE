+    arr = np.zeros((h, w), dtype=int)
+
+    core_h = 2 if h <= 5 else 3
+    core_w = 2 if w <= 6 else 3
+    core_r0 = random.randint(1, h - core_h - 1)
+    core_c0 = random.randint(1, w - core_w - 1)
