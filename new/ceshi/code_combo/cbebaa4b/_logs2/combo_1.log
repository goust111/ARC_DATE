   421	def _draw_path(arr, start, end, color, order):
   422	    r, c = start
   423	    er, ec = end
   424	    axes = (
   425	        [(r, er, c, True), (c, ec, er, False)]
   426	        if order == 0
   427	        else [(c, ec, r, False), (r, er, ec, True)]
   428	    )
   429	    for a_start, a_end, fixed, is_row in axes:
   430	        step = 1 if a_end >= a_start else -1
   431	        for v in range(a_start, a_end + step, step):
   432	            rr, cc = (v, fixed) if is_row else (fixed, v)
   433	            if arr[rr, cc] != 2:
   434	                arr[rr, cc] = color
