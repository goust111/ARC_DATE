   437	def _paint_bar(arr, side, color, used):
   438	    h, w = arr.shape
   439	    is_horizontal = side in ("top", "bottom")
   440	    fixed = 0 if side in ("top", "left") else (h - 1 if side == "bottom" else w - 1)
   441	    span = w if is_horizontal else h
   442	    lo_conflict = "left" if is_horizontal else "top"
   443	    hi_conflict = "right" if is_horizontal else "bottom"
   444	    for i in range(span):
   445	        if (i == 0 and lo_conflict in used) or (i == span - 1 and hi_conflict in used):
   446	            continue
   447	        if is_horizontal:
   448	            arr[fixed, i] = color
   449	        else:
   450	            arr[i, fixed] = color
