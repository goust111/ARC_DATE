+        dedup = sorted(
+            set(moves),
+            key=lambda x: (
+                -len(remaining[x[0]]["variants"][x[1]]["red_groups"]),
+                -remaining[x[0]]["area"],
+                x[2],
+                x[3],
+                x[0],
+                x[1],
+            ),
+        )
+        for idx, vidx, top, left in dedup:
