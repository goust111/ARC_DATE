   586	def _place_node_on_canvas(out, node, sr, sc):
   587	    arr = node["arr"]
   588	    top, left = node["top"] + sr, node["left"] + sc
   589	    node["pos"] = (top, left)
   590	    red_counts = {}
   591	    mask = arr != 0
   592	    rows, cols = np.nonzero(mask)
   593	    g_rows, g_cols = rows + top, cols + left
   594	    vals = arr[rows, cols]
   595	    cur_vals = out[g_rows, g_cols]
   596	    conflicts = (cur_vals != 0) & ~((cur_vals == 2) & (vals == 2))
   597	    if np.any(conflicts):
   598	        return None
   599	    red_mask = vals == 2
   600	    for gr, gc in zip(g_rows[red_mask], g_cols[red_mask]):
   601	        key = (int(gr), int(gc))
   602	        red_counts[key] = red_counts.get(key, 0) + 1
   603	    paint_mask = cur_vals == 0
   604	    out[g_rows[paint_mask], g_cols[paint_mask]] = vals[paint_mask]
   605	    return red_counts
