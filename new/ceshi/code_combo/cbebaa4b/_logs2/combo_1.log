+
+    _record_last_gen_info(nodes, rotation_required=rotation_required)
+    if not LAST_GEN_INFO["rotation_required"]:
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRY_LIMIT):
