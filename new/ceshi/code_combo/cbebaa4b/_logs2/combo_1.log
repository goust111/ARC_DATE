   608	def _assemble(nodes, h, w):
   609	    for node in nodes:
   610	        node["arr"] = _make_anchor(node) if node["kind"] == "anchor" else _make_piece(node)
   611	        if node["arr"] is None:
   612	            return None
   613	
   614	    r0, c0, r1, c1 = _union_bbox(nodes)
   615	    if (r1 - r0 + 1) > h or (c1 - c0 + 1) > w:
   616	        return None
   617	    sr = random.randint(-r0, h - 1 - r1)
   618	    sc = random.randint(-c0, w - 1 - c1)
   619	
   620	    out = np.zeros((h, w), dtype=int)
   621	    all_red_counts = {}
   622	    for node in nodes:
   623	        rc = _place_node_on_canvas(out, node, sr, sc)
   624	        if rc is None:
   625	            return None
   626	        for k, v in rc.items():
   627	            all_red_counts[k] = all_red_counts.get(k, 0) + v
   628	
   629	    total_ports = sum(int(np.sum(n["arr"] == 2)) for n in nodes)
   630	    if len(all_red_counts) * 2 != total_ports:
   631	        return None
   632	    if any(v != 2 for v in all_red_counts.values()):
   633	        return None
   634	    if len(components_mask(out != 0, connectivity=4)) != 1:
   635	        return None
   636	    return out
