+def _main_chain_no_reorient(grid: np.ndarray) -> np.ndarray:
+    solutions = _solve_chain(grid, allow_variants=False)
+    assert len(solutions) == 1, "translation-only chain assembly must be uniquely solvable"
+    return solutions[0]
