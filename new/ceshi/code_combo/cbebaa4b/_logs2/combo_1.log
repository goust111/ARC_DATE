+# --------------- generator (combo D1/2 + D7/2) ---------------
+
+GRID_H_RANGE = (22, 26)
+GRID_W_RANGE = (22, 26)
+MAX_ASSEMBLY_DIM = 24
+
+PIECE_COUNT_RANGE = (4, 6)
+PIECE_H_RANGE = (4, 7)
+PIECE_W_RANGE = (4, 8)
+PIECE_DIM_CANDIDATES = 12
+PIECE_COLORS = [1, 3, 5, 6, 7, 8, 9]
+PIECE_CAP = 2
+BAR_SKIP_PROB = 0.35
+MIN_UNIQUE_VARIANTS = 4
+
+ANCHOR_BLOCK_CHOICES = [(3, 3), (4, 5)]
+ANCHOR_CAP = 1
+
+SCATTER_PADDING = 2
+GEN_RETRY_LIMIT = 450
+
+SIDES = ("top", "right", "bottom", "left")
+OPPOSITE = {"top": "bottom", "bottom": "top", "left": "right", "right": "left"}
+INWARD = {"top": (1, 0), "bottom": (-1, 0), "left": (0, 1), "right": (0, -1)}
+TAG_CORNERS = {
+    "nw": lambda h, w: (1, 1),
+    "ne": lambda h, w: (1, w - 2),
+    "sw": lambda h, w: (h - 2, 1),
+    "se": lambda h, w: (h - 2, w - 2),
