   639	def _choose_scatter_variants(nodes):
   640	    piece_infos = []
   641	    for node in nodes[1:]:
   642	        variants = _variant_records(node["arr"], 0)
   643	        non_identity = [v for v in variants if not np.array_equal(v["arr"], node["arr"])]
   644	        flip_choices = [v for v in non_identity if v["is_flip"]]
   645	        if not non_identity:
   646	            return False
   647	        piece_infos.append((node, variants, non_identity, flip_choices))
   648	
   649	    if not piece_infos:
   650	        return False
   651	
   652	    for node, variants, non_identity, _flip_choices in piece_infos:
   653	        node["all_variants"] = variants
   654	        chosen = random.choice(non_identity)
   655	        node["scatter_arr"] = chosen["arr"]
   656	        node["scatter_variant"] = chosen["code"]
   657	        node["scatter_is_flip"] = bool(chosen["is_flip"])
   658	
   659	    if not any(node.get("scatter_is_flip") for node, _v, _n, _f in piece_infos):
   660	        candidates = [(node, flips) for node, _v, _n, flips in piece_infos if flips]
   661	        if not candidates:
   662	            return False
   663	        node, flips = random.choice(candidates)
   664	        chosen = random.choice(flips)
   665	        node["scatter_arr"] = chosen["arr"]
   666	        node["scatter_variant"] = chosen["code"]
   667	        node["scatter_is_flip"] = True
   668	
   669	    return True
