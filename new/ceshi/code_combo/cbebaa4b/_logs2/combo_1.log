   463	def _make_piece(node):
   464	    h, w = node["shape"]
   465	    color = node["color"]
   466	    used = set(node["sides"])
   467	    arr = np.zeros((h, w), dtype=int)
   468	
   469	    core_h = 2 if h <= 5 else 3
   470	    core_w = 2 if w <= 6 else 3
   471	    core_r0 = random.randint(1, h - core_h - 1)
   472	    core_c0 = random.randint(1, w - core_w - 1)
   473	    arr[core_r0 : core_r0 + core_h, core_c0 : core_c0 + core_w] = color
   474	    hub = (core_r0 + core_h // 2, core_c0 + core_w // 2)
   475	
   476	    bar_sides = [s for s in SIDES if s not in used]
   477	    for side in bar_sides:
   478	        _paint_bar(arr, side, color, used)
   479	
   480	    terminals = []
   481	    for side in used:
   482	        dr, dc = INWARD[side]
   483	        for r, c in _port_cells(node, side):
   484	            arr[r, c] = 2
   485	            rr, cc = r + dr, c + dc
   486	            arr[rr, cc] = color
   487	            terminals.append((rr, cc))
   488	
   489	    order = random.randint(0, 1)
   490	    for t in terminals:
   491	        _draw_path(arr, t, hub, color, order)
   492	    for side in bar_sides:
   493	        _draw_path(arr, hub, _bar_endpoint((h, w), side, hub), color, 1 - order)
   494	
   495	    corner_names = list(TAG_CORNERS)
   496	    random.shuffle(corner_names)
   497	    chosen = None
   498	    for name in corner_names:
   499	        trial = arr.copy()
   500	        tag = TAG_CORNERS[name](h, w)
   501	        trial[tag] = color
   502	        _draw_path(trial, hub, tag, color, random.randint(0, 1))
   503	        if len(components_mask(trial != 0, connectivity=4)) != 1:
   504	            continue
   505	        if int(np.sum(trial == 2)) != 2 * len(used):
   506	            continue
   507	        if len(_variant_records(trial, 0)) < MIN_UNIQUE_VARIANTS:
   508	            continue
   509	        arr = trial
   510	        chosen = name
   511	        break
   512	    if chosen is None:
   513	        return None
   514	
   515	    node["tag_corner"] = chosen
   516	    return arr
