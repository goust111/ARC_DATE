   453	def _bar_endpoint(shape, side, hub):
   454	    h, w = shape
   455	    hr, hc = hub
   456	    if side in ("top", "bottom"):
   457	        row = 0 if side == "top" else h - 1
   458	        return (row, min(max(hc, 1), w - 2))
   459	    col = 0 if side == "left" else w - 1
   460	    return (min(max(hr, 1), h - 2), col)
