   411	def _union_bbox(nodes):
   412	    boxes = [_bbox_of(n) for n in nodes]
   413	    return (
   414	        min(b[0] for b in boxes),
   415	        min(b[1] for b in boxes),
   416	        max(b[2] for b in boxes),
   417	        max(b[3] for b in boxes),
   418	    )
