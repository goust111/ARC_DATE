   306	def main(grid: np.ndarray) -> np.ndarray:
   307	    """
   308	    Reassemble scattered sprites into a relay chain by reorienting each piece before it passes the red connection onward.
   309	
   310	    Input structure:
   311	    - bg = black (0). One yellow-anchor sprite and several colored movable sprites are scattered apart.
   312	    - The anchor already sits at its final location and contains the yellow (4) block plus one 2-cell red connector pair.
   313	    - Every movable sprite has one or two 2-cell red connector pairs, and its scattered pose may be rotated or mirrored relative to the solved pose.
   314	
   315	    Rule:
   316	    - Keep the anchor fixed. The first movable sprite must cover the anchor's red pair.
   317	    - After that, only the red pair left open by the most recently attached sprite may be used next, so assembly advances as a chain rather than branching anywhere on the structure.
   318	    - Before placing any movable sprite, you may rotate it by 90/180/270 degrees or mirror it; choose the orientation that lets one of its red pairs match the current chain tail, and continue until every red cell is paired exactly once.
   319	
   320	    Key insight: The state is two-dimensional: you must infer both which sprite comes next in the relay chain and which dihedral orientation makes that sprite's connector pair line up with the single active tail.
   321	    """
   322	    global LAST_SOLUTION_COUNT
   323	    solutions = _solve_chain(grid, allow_variants=True)
   324	    LAST_SOLUTION_COUNT = len(solutions)
   325	    assert solutions, "combo chain assembly must have at least one valid solution"
   326	    return solutions[0]
