   385	def _port_cells(node, side):
   386	    h, w = node["shape"]
   387	    k = node["ports"][side]
   388	    if side == "top":
   389	        return [(0, k), (0, k + 1)]
   390	    if side == "bottom":
   391	        return [(h - 1, k), (h - 1, k + 1)]
   392	    if side == "left":
   393	        return [(k, 0), (k + 1, 0)]
   394	    return [(k, w - 1), (k + 1, w - 1)]
