+                arr,
+                transparent=0,
+                padding=SCATTER_PADDING,
+                padding_connectivity=8,
+            )
+        except ValueError:
+            return None
+        paste(inp, arr, r, c, transparent=0)
+    return inp
+
+
+def _record_last_gen_info(nodes, rotation_required: bool):
+    global LAST_GEN_INFO
+    piece_nodes = nodes[1:]
+    degrees = [len(n["sides"]) for n in nodes]
+    LAST_GEN_INFO = {
