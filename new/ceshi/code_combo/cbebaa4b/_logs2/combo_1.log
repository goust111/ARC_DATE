   542	def _grow_chain():
   543	    bh, bw = random.choice(ANCHOR_BLOCK_CHOICES)
   544	    anchor = _new_node("anchor", bh + 2, bw + 2, 4, cap=ANCHOR_CAP)
   545	    anchor["block"] = (bh, bw)
   546	    nodes = [anchor]
   547	    n_pieces = random.randint(*PIECE_COUNT_RANGE)
   548	    colors = random.sample(PIECE_COLORS, n_pieces)
   549	
   550	    parent_i = 0
   551	    for i in range(n_pieces):
   552	        parent = nodes[parent_i]
   553	        placed = False
   554	        dims = [
   555	            (random.randint(*PIECE_H_RANGE), random.randint(*PIECE_W_RANGE))
   556	            for _ in range(PIECE_DIM_CANDIDATES)
   557	        ]
   558	        random.shuffle(dims)
   559	        for ph, pw in dims:
   560	            sides = [s for s in SIDES if s not in parent["sides"]]
   561	            random.shuffle(sides)
   562	            for side in sides:
   563	                child = _new_node("piece", ph, pw, colors[i], cap=PIECE_CAP)
   564	                incoming = OPPOSITE[side]
   565	                _ensure_port(parent, side)
   566	                _ensure_port(child, incoming)
   567	                pr, pc = _global_port(parent, side)[0]
   568	                cr, cc = _port_cells(child, incoming)[0]
   569	                child["top"] = pr - cr
   570	                child["left"] = pc - cc
   571	                child["sides"].add(incoming)
   572	                if not _candidate_fits(nodes, parent_i, child):
   573	                    continue
   574	                parent["sides"].add(side)
   575	                nodes.append(child)
   576	                parent_i = len(nodes) - 1
   577	                placed = True
   578	                break
   579	            if placed:
   580	                break
   581	        if not placed:
   582	            return None
   583	    return nodes
