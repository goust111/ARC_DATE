+            continue
+        if any(v != bg for v in vals):
+            if side != matched_side:
+                return False
+            if not _match_sequences(piece["edges"][side], vals, mode):
+                return False
+            touches += 1
+        elif side == matched_side:
+            return False
+    return touches == 1
