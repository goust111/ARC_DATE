+        )
+        if leaf_side == "bottom":
+            left_leaf = _new_node("piece", leaf_h, branch_w, leaf_color, top=anchor["shape"][0], left=left_piece["left"])
+            right_leaf = _new_node(
+                "piece", leaf_h, branch_w, leaf_color, top=anchor["shape"][0], left=right_piece["left"]
+            )
+            anchor["sides"] = {"left", "right"}
+            left_piece["sides"] = {"right", "bottom"}
+            right_piece["sides"] = {"left", "bottom"}
+            left_leaf["sides"] = {"top"}
+            right_leaf["sides"] = {"top"}
+            nodes.extend([left_piece, right_piece, left_leaf, right_leaf])
+            edges = [
+                (0, "left", 1, "right"),
+                (0, "right", 2, "left"),
+                (1, "bottom", 3, "top"),
+                (2, "bottom", 4, "top"),
+            ]
+        else:
+            left_leaf = _new_node("piece", leaf_h, branch_w, leaf_color, top=-leaf_h, left=left_piece["left"])
+            right_leaf = _new_node(
+                "piece", leaf_h, branch_w, leaf_color, top=-leaf_h, left=right_piece["left"]
+            )
+            anchor["sides"] = {"left", "right"}
+            left_piece["sides"] = {"right", "top"}
+            right_piece["sides"] = {"left", "top"}
+            left_leaf["sides"] = {"bottom"}
+            right_leaf["sides"] = {"bottom"}
+            nodes.extend([left_piece, right_piece, left_leaf, right_leaf])
+            edges = [
+                (0, "left", 1, "right"),
+                (0, "right", 2, "left"),
+                (1, "top", 3, "bottom"),
+                (2, "top", 4, "bottom"),
+            ]
+
+    r0, c0, r1, c1 = _union_bbox(nodes)
+    if (r1 - r0 + 1) > MAX_ASSEMBLY_DIM or (c1 - c0 + 1) > MAX_ASSEMBLY_DIM:
+        return None
+
+    _assign_edge_sequences(nodes, edges)
+    return nodes
+
+
+def _place_node_on_canvas(out: np.ndarray, node: dict, sr: int, sc: int) -> bool:
+    arr = node["arr"]
+    top, left = node["top"] + sr, node["left"] + sc
+    node["pos"] = (top, left)
+    h, w = arr.shape
+    if top < 0 or left < 0 or top + h > out.shape[0] or left + w > out.shape[1]:
+        return False
+    sub = out[top : top + h, left : left + w]
+    mask = arr != 0
+    if np.any(mask & (sub != 0)):
+        return False
+    paste(out, arr, top, left, transparent=0)
+    return True
+
+
+def _assemble(nodes: list[dict], h: int, w: int) -> np.ndarray | None:
+    for node in nodes:
+        node["arr"] = _render_node(node)
+        if len(components_mask(node["arr"] != 0, connectivity=4)) != 1:
+            return None
+        for side, seq in node["edge_seq"].items():
+            if _red_count(seq) < 2:
+                return None
+
+    r0, c0, r1, c1 = _union_bbox(nodes)
+    if (r1 - r0 + 1) > h or (c1 - c0 + 1) > w:
+        return None
+    sr = random.randint(-r0, h - 1 - r1)
+    sc = random.randint(-c0, w - 1 - c1)
