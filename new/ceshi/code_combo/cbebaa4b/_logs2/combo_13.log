    99	    return out
   100	
   101	
   102	def _build_sequence(mask: tuple[bool, ...], accent: int) -> tuple[int, ...]:
   103	    return tuple(2 if is_red else int(accent) for is_red in mask)
   104	
   105	
   106	def _mask_pair_for_single_red_ablation(span: int) -> tuple[tuple[bool, ...], tuple[bool, ...]]:
   107	    templates = _mask_templates(span)
   108	    pairs = []
   109	    for i, a in enumerate(templates):
   110	        for b in templates[i + 1 :]:
