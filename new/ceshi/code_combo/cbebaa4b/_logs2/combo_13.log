   179	def _position_from_opening(opening: dict, piece: dict, side: str) -> tuple[int, int] | None:
   180	    target_side = opening["side"]
   181	    th, tw = opening["shape"]
   182	    ph, pw = piece["shape"]
   183	    if side != OPPOSITE[target_side]:
   184	        return None
   185	    if target_side in ("top", "bottom") and pw != tw:
   186	        return None
   187	    if target_side in ("left", "right") and ph != th:
   188	        return None
   189	    if target_side == "top":
