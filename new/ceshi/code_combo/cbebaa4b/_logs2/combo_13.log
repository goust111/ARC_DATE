+        if side == "top":
+            arr[0, 1:-1] = seq
+        elif side == "bottom":
+            arr[-1, 1:-1] = seq
+        elif side == "left":
+            arr[1:-1, 0] = seq
+        else:
+            arr[1:-1, -1] = seq
+    return arr
