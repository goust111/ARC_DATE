   160	        if r < 0:
   161	            return None
   162	        return tuple(int(v) for v in canvas[r, left + 1 : left + pw - 1])
   163	    if side == "bottom":
   164	        r = top + ph
   165	        if r >= canvas.shape[0]:
   166	            return None
   167	        return tuple(int(v) for v in canvas[r, left + 1 : left + pw - 1])
   168	    if side == "left":
   169	        c = left - 1
   170	        if c < 0:
   171	            return None
   172	        return tuple(int(v) for v in canvas[top + 1 : top + ph - 1, c])
   173	    c = left + pw
   174	    if c >= canvas.shape[1]:
   175	        return None
   176	    return tuple(int(v) for v in canvas[top + 1 : top + ph - 1, c])
   177	
