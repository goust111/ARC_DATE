+# --------------- generator (combo D1/1 + D16/1) ---------------
+
+GRID_H_RANGE = (22, 26)
+GRID_W_RANGE = (22, 26)
+MAX_ASSEMBLY_DIM = 24
+
+PIECE_H_RANGE = (5, 7)
+PIECE_W_RANGE = (5, 8)
+PIECE_COLORS = [1, 3, 5, 6, 7, 8, 9]
+
+ANCHOR_BLOCK_CHOICES = [(3, 3), (4, 5)]
+SCATTER_PADDING = 2
+GEN_RETRY_LIMIT = 600
