   121	        r0, c0, r1, c1 = bbox_coords(pts)
   122	        arr = g[r0 : r1 + 1, c0 : c1 + 1].copy()
   123	        edges = {side: _edge_sequence(arr, side) for side in SIDES}
   124	        conn_sides = [side for side in SIDES if _red_count(edges[side]) >= 2]
   125	        pieces.append(
   126	            {
   127	                "bbox": (int(r0), int(c0), int(r1), int(c1)),
   128	                "arr": arr,
   129	                "shape": (int(arr.shape[0]), int(arr.shape[1])),
   130	                "area": int(np.sum(arr != bg)),
   131	                "edges": edges,
   132	                "conn_sides": conn_sides,
   133	            }
   134	        )
   135	    return pieces
   136	
   137	
   138	def _try_place(canvas: np.ndarray, arr: np.ndarray, top: int, left: int, bg: int) -> np.ndarray | None:
   139	    h, w = canvas.shape
