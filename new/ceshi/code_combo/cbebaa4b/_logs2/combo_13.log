+
+def _new_node(kind: str, h: int, w: int, color: int, top: int = 0, left: int = 0) -> dict:
+    return {
+        "kind": kind,
+        "shape": (int(h), int(w)),
+        "color": int(color),
+        "top": int(top),
+        "left": int(left),
+        "sides": set(),
+        "edge_seq": {},
+    }
+
+
+def _bbox_of(node: dict) -> tuple[int, int, int, int]:
+    h, w = node["shape"]
+    return (node["top"], node["left"], node["top"] + h - 1, node["left"] + w - 1)
+
+
+def _union_bbox(nodes: list[dict]) -> tuple[int, int, int, int]:
+    boxes = [_bbox_of(n) for n in nodes]
+    return (
+        min(b[0] for b in boxes),
+        min(b[1] for b in boxes),
+        max(b[2] for b in boxes),
+        max(b[3] for b in boxes),
+    )
+
+
+def _render_node(node: dict) -> np.ndarray:
+    h, w = node["shape"]
+    fill = 4 if node["kind"] == "anchor" else node["color"]
+    arr = np.full((h, w), fill, dtype=int)
+    arr[0, 0] = 0
+    arr[0, -1] = 0
+    arr[-1, 0] = 0
+    arr[-1, -1] = 0
+    for side, seq in node["edge_seq"].items():
+        if side == "top":
+            arr[0, 1:-1] = seq
+        elif side == "bottom":
+            arr[-1, 1:-1] = seq
+        elif side == "left":
+            arr[1:-1, 0] = seq
+        else:
+            arr[1:-1, -1] = seq
+    return arr
+
+
+def _assign_edge_sequences(nodes: list[dict], edges: list[tuple[int, str, int, str]]) -> None:
+    assert len(edges) == 4, "this generator builds a fixed 4-edge tree"
+
+    branch_span = len(_edge_sequence(np.zeros(nodes[0]["shape"], dtype=int), edges[0][1]))
+    branch_mask = random.choice(_mask_templates(branch_span))
+
+    leaf_span = len(_edge_sequence(np.zeros(nodes[edges[2][0]]["shape"], dtype=int), edges[2][1]))
+    leaf_mask_a, leaf_mask_b = _mask_pair_for_single_red_ablation(leaf_span)
+
+    edge_masks = [branch_mask, branch_mask, leaf_mask_a, leaf_mask_b]
+    for edge_idx, (parent_i, parent_side, child_i, child_side) in enumerate(edges):
+        seq = _build_sequence(edge_masks[edge_idx], nodes[child_i]["color"])
+        nodes[parent_i]["edge_seq"][parent_side] = seq
+        nodes[child_i]["edge_seq"][child_side] = seq
+
+
+def _grow_layout() -> list[dict] | None:
+    bh, bw = random.choice(ANCHOR_BLOCK_CHOICES)
+    anchor = _new_node("anchor", bh + 2, bw + 2, 4)
+
+    branch_colors = random.sample(PIECE_COLORS, 2)
+    leaf_color_choices = [c for c in PIECE_COLORS if c not in branch_colors]
+    leaf_color = random.choice(leaf_color_choices)
+
+    nodes = [anchor]
+    edges: list[tuple[int, str, int, str]] = []
+
+    if random.random() < 0.5:
+        branch_h = random.randint(*PIECE_H_RANGE)
+        leaf_w = random.randint(*PIECE_W_RANGE)
+        leaf_side = random.choice(["left", "right"])
+
+        top_piece = _new_node("piece", branch_h, anchor["shape"][1], branch_colors[0], top=-branch_h, left=0)
+        bottom_piece = _new_node(
+            "piece", branch_h, anchor["shape"][1], branch_colors[1], top=anchor["shape"][0], left=0
+        )
+        if leaf_side == "right":
+            top_leaf = _new_node("piece", branch_h, leaf_w, leaf_color, top=top_piece["top"], left=anchor["shape"][1])
+            bottom_leaf = _new_node(
+                "piece", branch_h, leaf_w, leaf_color, top=bottom_piece["top"], left=anchor["shape"][1]
+            )
+            anchor["sides"] = {"top", "bottom"}
+            top_piece["sides"] = {"bottom", "right"}
+            bottom_piece["sides"] = {"top", "right"}
+            top_leaf["sides"] = {"left"}
+            bottom_leaf["sides"] = {"left"}
+            nodes.extend([top_piece, bottom_piece, top_leaf, bottom_leaf])
+            edges = [
+                (0, "top", 1, "bottom"),
+                (0, "bottom", 2, "top"),
+                (1, "right", 3, "left"),
+                (2, "right", 4, "left"),
+            ]
+        else:
+            top_leaf = _new_node("piece", branch_h, leaf_w, leaf_color, top=top_piece["top"], left=-leaf_w)
+            bottom_leaf = _new_node(
+                "piece", branch_h, leaf_w, leaf_color, top=bottom_piece["top"], left=-leaf_w
+            )
+            anchor["sides"] = {"top", "bottom"}
+            top_piece["sides"] = {"bottom", "left"}
+            bottom_piece["sides"] = {"top", "left"}
+            top_leaf["sides"] = {"right"}
+            bottom_leaf["sides"] = {"right"}
+            nodes.extend([top_piece, bottom_piece, top_leaf, bottom_leaf])
+            edges = [
+                (0, "top", 1, "bottom"),
+                (0, "bottom", 2, "top"),
+                (1, "left", 3, "right"),
+                (2, "left", 4, "right"),
+            ]
+    else:
+        branch_w = random.randint(*PIECE_W_RANGE)
+        leaf_h = random.randint(*PIECE_H_RANGE)
+        leaf_side = random.choice(["top", "bottom"])
+
+        left_piece = _new_node("piece", anchor["shape"][0], branch_w, branch_colors[0], top=0, left=-branch_w)
+        right_piece = _new_node(
+            "piece", anchor["shape"][0], branch_w, branch_colors[1], top=0, left=anchor["shape"][1]
+        )
+        if leaf_side == "bottom":
+            left_leaf = _new_node("piece", leaf_h, branch_w, leaf_color, top=anchor["shape"][0], left=left_piece["left"])
+            right_leaf = _new_node(
+                "piece", leaf_h, branch_w, leaf_color, top=anchor["shape"][0], left=right_piece["left"]
+            )
+            anchor["sides"] = {"left", "right"}
+            left_piece["sides"] = {"right", "bottom"}
+            right_piece["sides"] = {"left", "bottom"}
+            left_leaf["sides"] = {"top"}
+            right_leaf["sides"] = {"top"}
+            nodes.extend([left_piece, right_piece, left_leaf, right_leaf])
+            edges = [
+                (0, "left", 1, "right"),
+                (0, "right", 2, "left"),
+                (1, "bottom", 3, "top"),
+                (2, "bottom", 4, "top"),
+            ]
+        else:
+            left_leaf = _new_node("piece", leaf_h, branch_w, leaf_color, top=-leaf_h, left=left_piece["left"])
+            right_leaf = _new_node(
+                "piece", leaf_h, branch_w, leaf_color, top=-leaf_h, left=right_piece["left"]
+            )
+            anchor["sides"] = {"left", "right"}
+            left_piece["sides"] = {"right", "top"}
+            right_piece["sides"] = {"left", "top"}
+            left_leaf["sides"] = {"bottom"}
+            right_leaf["sides"] = {"bottom"}
+            nodes.extend([left_piece, right_piece, left_leaf, right_leaf])
+            edges = [
+                (0, "left", 1, "right"),
+                (0, "right", 2, "left"),
+                (1, "top", 3, "bottom"),
+                (2, "top", 4, "bottom"),
+            ]
+
+    r0, c0, r1, c1 = _union_bbox(nodes)
+    if (r1 - r0 + 1) > MAX_ASSEMBLY_DIM or (c1 - c0 + 1) > MAX_ASSEMBLY_DIM:
+        return None
+
+    _assign_edge_sequences(nodes, edges)
+    return nodes
+
+
+def _place_node_on_canvas(out: np.ndarray, node: dict, sr: int, sc: int) -> bool:
+    arr = node["arr"]
+    top, left = node["top"] + sr, node["left"] + sc
+    node["pos"] = (top, left)
+    h, w = arr.shape
+    if top < 0 or left < 0 or top + h > out.shape[0] or left + w > out.shape[1]:
+        return False
+    sub = out[top : top + h, left : left + w]
+    mask = arr != 0
+    if np.any(mask & (sub != 0)):
+        return False
+    paste(out, arr, top, left, transparent=0)
+    return True
+
+
+def _assemble(nodes: list[dict], h: int, w: int) -> np.ndarray | None:
+    for node in nodes:
+        node["arr"] = _render_node(node)
+        if len(components_mask(node["arr"] != 0, connectivity=4)) != 1:
+            return None
+        for side, seq in node["edge_seq"].items():
+            if _red_count(seq) < 2:
+                return None
+
+    r0, c0, r1, c1 = _union_bbox(nodes)
+    if (r1 - r0 + 1) > h or (c1 - c0 + 1) > w:
+        return None
+    sr = random.randint(-r0, h - 1 - r1)
+    sc = random.randint(-c0, w - 1 - c1)
+
+    out = np.zeros((h, w), dtype=int)
+    for node in nodes:
+        if not _place_node_on_canvas(out, node, sr, sc):
+            return None
+    if len(components_mask(out != 0, connectivity=4)) != 1:
+        return None
+    return out
+
+
+def _scatter(nodes: list[dict], h: int, w: int) -> np.ndarray | None:
+    inp = np.zeros((h, w), dtype=int)
+    anchor = nodes[0]
+    paste(inp, anchor["arr"], *anchor["pos"], transparent=0)
+    rest = nodes[1:]
+    random.shuffle(rest)
+    for node in rest:
+        try:
+            r, c = random_free_location(
+                inp,
+                node["arr"],
+                transparent=0,
+                padding=SCATTER_PADDING,
+                padding_connectivity=8,
+            )
+        except ValueError:
+            return None
+        paste(inp, node["arr"], r, c, transparent=0)
+    return inp
+
+
+def _gen_attempt() -> np.ndarray | None:
+    h = random.randint(*GRID_H_RANGE)
+    w = random.randint(*GRID_W_RANGE)
+    nodes = _grow_layout()
+    if nodes is None:
+        return None
+    out = _assemble(nodes, h, w)
+    if out is None:
+        return None
+    inp = _scatter(nodes, h, w)
+    if inp is None:
+        return None
+
+    try:
+        solved = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(solved, out):
+        return None
+
+    mask_only = _solve(inp, mode="mask_only")
+    if len(mask_only) == 1 and np.array_equal(mask_only[0], out):
+        return None
+
+    single_red = _solve(inp, mode="single_red")
+    if len(single_red) == 1 and np.array_equal(single_red[0], out):
+        return None
+
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRY_LIMIT):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid cbebaa4b combo D1/1+D16/1 input")

