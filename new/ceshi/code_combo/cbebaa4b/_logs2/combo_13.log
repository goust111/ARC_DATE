+def _edge_sequence(arr: np.ndarray, side: str) -> tuple[int, ...]:
+    if side == "top":
+        return tuple(int(v) for v in arr[0, 1:-1])
+    if side == "bottom":
+        return tuple(int(v) for v in arr[-1, 1:-1])
+    if side == "left":
+        return tuple(int(v) for v in arr[1:-1, 0])
