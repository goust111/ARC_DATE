+    out = dict(balance)
+    if side == "left":
+        out[sig] = out.get(sig, 0) + 1
+    elif side == "right":
+        out[sig] = out.get(sig, 0) - 1
+    else:
+        out.setdefault(sig, 0)
+    return out
