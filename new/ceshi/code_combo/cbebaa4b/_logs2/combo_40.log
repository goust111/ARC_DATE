   514	def _paint_bar(arr, side, color, used):
   515	    h, w = arr.shape
   516	    is_horizontal = side in ("top", "bottom")
   517	    fixed = 0 if side in ("top", "left") else (h - 1 if side == "bottom" else w - 1)
   518	    span = w if is_horizontal else h
   519	    lo_conflict = "left" if is_horizontal else "top"
   520	    hi_conflict = "right" if is_horizontal else "bottom"
   521	    for i in range(span):
   522	        if (i == 0 and lo_conflict in used) or (i == span - 1 and hi_conflict in used):
   523	            continue
   524	        if is_horizontal:
   525	            arr[fixed, i] = color
   526	        else:
   527	            arr[i, fixed] = color
