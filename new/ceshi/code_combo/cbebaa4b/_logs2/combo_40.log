   468	    if side == "bottom":
   469	        return [(h - 1, k), (h - 1, k + 1)]
   470	    if side == "left":
   471	        return [(k, 0), (k + 1, 0)]
   472	    return [(k, w - 1), (k + 1, w - 1)]
