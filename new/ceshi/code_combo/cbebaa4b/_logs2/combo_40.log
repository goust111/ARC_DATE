   499	def _draw_path(arr, start, end, color, order):
   500	    r, c = start
   501	    er, ec = end
   502	    axes = [(r, er, c, True), (c, ec, er, False)] if order == 0 else [
   503	        (c, ec, r, False),
   504	        (r, er, ec, True),
   505	    ]
   506	    for a_start, a_end, fixed, is_row in axes:
