+def _balance_feasible(balance: dict[tuple[int, ...], int], remaining_counts: dict[tuple[int, ...], int]) -> bool:
+    for sig, delta in balance.items():
+        rem = remaining_counts.get(sig, 0)
+        if rem < abs(delta):
+            return False
+        if (rem - abs(delta)) % 2 != 0:
+            return False
+    return True
+
