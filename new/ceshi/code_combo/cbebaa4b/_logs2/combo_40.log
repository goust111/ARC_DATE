   147	        for c in range(w):
   148	            mc = axis2 - c
   149	            v = int(canvas[r, c])
   150	            if mc < 0 or mc >= w:
   151	                if v != bg:
   152	                    return False
   153	                continue
   154	            if v != int(canvas[r, mc]):
   155	                return False
   156	    return True
