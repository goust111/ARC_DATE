   131	def _partial_vertical_symmetry_ok(canvas: np.ndarray, axis2: int, bg: int) -> bool:
   132	    h, w = canvas.shape
   133	    rows, cols = np.nonzero(canvas != bg)
   134	    for r, c in zip(rows, cols):
   135	        mc = axis2 - int(c)
   136	        if mc < 0 or mc >= w:
   137	            return False
   138	        mv = int(canvas[int(r), mc])
   139	        if mv != bg and mv != int(canvas[int(r), int(c)]):
   140	            return False
   141	    return True
