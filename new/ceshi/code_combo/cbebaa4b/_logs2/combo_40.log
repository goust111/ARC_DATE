   382	def main(grid: np.ndarray) -> np.ndarray:
   383	    """
   384	    Assemble the scattered sprites around the fixed yellow anchor while validating mirror feasibility after every connection.
   385	
   386	    Input structure:
   387	    - bg = black (0). Several colored sprites are scattered with gaps between them.
   388	    - One anchor sprite contains the yellow (4) block and stays fixed in place.
   389	    - Every sprite has red (2) connector pixels on its boundary; the non-anchor sprites come from left/right mirrored families.
   390	
   391	    Rule:
   392	    - Translate one non-anchor sprite at a time so one of its red pixels overlaps an unpaired red pixel of the growing assembly.
   393	    - After each tentative connection, keep it only if the partial assembly can still extend to a vertically symmetric figure about the anchor center column.
   394	    - When all red connectors are paired, the finished assembly must be that unique mirror-symmetric output.
   395	
   396	    Key insight:
   397	    - Red pixels still generate the local jigsaw moves, but local fit is no longer enough.
   398	    - The solver must backtrack whenever a move breaks global mirror feasibility, so symmetry acts as the validator that filters the red-port search.
   399	    """
   400	    sols = _collect_solutions(
   401	        np.asarray(grid, dtype=int),
   402	        require_symmetry=True,
   403	        enforce_global=True,
   404	        max_solutions=2,
   405	    )
   406	    assert len(sols) == 1, "jigsaw assembly must have exactly one globally symmetric valid solution"
   407	    return sols[0]
