+    bridge_colors = {MIX_PINK, MIX_TEAL}
+    if not bridge_colors.issubset(set(map(int, out.flatten()))):
+        return None
+    return out
+
+
+def _scatter(nodes, h, w):
+    inp = np.zeros((h, w), dtype=int)
+    anchor = nodes[0]
+    paste(inp, anchor["arr"], *anchor["pos"], transparent=0)
+    rest = nodes[1:]
+    random.shuffle(rest)
+    for node in rest:
+        try:
+            r, c = random_free_location(
+                inp,
+                node["arr"],
+                transparent=0,
+                padding=SCATTER_PADDING,
+                padding_connectivity=8,
+            )
+        except ValueError:
+            return None
+        paste(inp, node["arr"], r, c, transparent=0)
+    return inp
+
+
+def _gen_attempt():
+    h = random.randint(*GRID_H_RANGE)
+    w = random.randint(*GRID_W_RANGE)
+    nodes = _grow_tree()
+    if nodes is None:
+        return None
+    out = _assemble(nodes, h, w)
+    if out is None:
