+# --------------- generator (o5x) ---------------
+
+# ── Tunable configuration ──────────────────────────────────────────────
+# Canvas
+GRID_H_RANGE = (22, 26)
+GRID_W_RANGE = (22, 26)
+MAX_ASSEMBLY_DIM = 24
+
+# Pieces
+PIECE_COUNT_RANGE = (4, 6)
+PIECE_H_RANGE = (4, 7)
+PIECE_W_RANGE = (4, 8)
+PIECE_DIM_CANDIDATES = 12
+PIECE_CAP = 2
+BAR_SKIP_PROB = 0.35
+
+# Anchor
+ANCHOR_BLOCK_CHOICES = [(3, 3), (4, 5)]
+ANCHOR_CAP_CHOICES = [1, 2]
+
+# Scatter
+SCATTER_PADDING = 2
