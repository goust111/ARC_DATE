+        if node["kind"] == "piece":
+            order.append(node["uid"])
+    return _compose_output(assembled, pieces, placements, order, 0)
+
+
+def _gen_attempt():
+    h = random.randint(*GRID_H_RANGE)
+    w = random.randint(*GRID_W_RANGE)
+    nodes = _grow_tree()
+    if nodes is None:
