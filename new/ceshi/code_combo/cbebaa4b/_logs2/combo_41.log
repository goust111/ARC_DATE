+        if not remaining:
+            return cur_inp
+
+        choices = []
+        for idx, node in enumerate(remaining):
+            cands = _candidate_scatter_positions(cur_inp, assembled, cur_owner, node)
+            if not cands:
+                return None
+            choices.append((len(cands), -node["area"], idx, cands))
