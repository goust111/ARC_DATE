+        _, _, pick_idx, cands = min(choices, key=lambda x: (x[0], x[1], x[2]))
+        node = remaining[pick_idx]
+        cand_order = cands[:]
+        random.shuffle(cand_order)
+        cand_order.sort(reverse=True)
