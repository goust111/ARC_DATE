+def _trail_clear(inp, assembled, trail_owner, node, top, left, trail):
+    ph, pw = node["arr"].shape
+    mask = node["arr"] != 0
+    for r, c in trail:
+        own_source = (
+            top <= r < top + ph
+            and left <= c < left + pw
+            and bool(mask[r - top, c - left])
+        )
+        if inp[r, c] != 0 and not own_source:
+            return False
+        if trail_owner[r, c] not in (-1, node["uid"]):
+            return False
+        if assembled[r, c] != 0:
+            return False
