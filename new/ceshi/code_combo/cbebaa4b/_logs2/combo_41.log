+
+def _expected_output(nodes, assembled):
+    pieces = []
+    placements = {}
+    order = []
+    for node in nodes:
+        placements[node["uid"]] = node["pos"]
+        pieces.append(
+            {
+                "uid": node["uid"],
+                "arr": node["arr"],
+                "bbox": (
+                    node["scatter_pos"][0],
+                    node["scatter_pos"][1],
+                    node["scatter_pos"][0] + node["arr"].shape[0] - 1,
