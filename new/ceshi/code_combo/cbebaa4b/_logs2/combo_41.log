+    raise RuntimeError("failed to generate a valid cbebaa4b combo input")
+
+
+_SLOW_GENERATE_INPUT = generate_input
+_FAST_SEED_INPUTS: list[np.ndarray] = []
+
+
+def generate_input() -> np.ndarray:
