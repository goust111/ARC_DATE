+    out = np.zeros((h, w), dtype=int)
+    full_state: dict[tuple[int, int], tuple[int, int, int]] = {}
+    for node in nodes:
+        node_state = _place_node_on_canvas(out, node, sr, sc)
+        if node_state is None:
