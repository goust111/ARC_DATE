+        out_color = int(pair["out"])
+        in_color = int(pair["in"])
+        fam_merge = merge_mask & (
+            ((sub == out_color) & (arr == in_color))
+            | ((sub == in_color) & (arr == out_color))
+        )
+        sub[fam_merge] = out_color
