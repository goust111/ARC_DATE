    sub = canvas[top : top + ph, left : left + pw]
    mask = arr != bg
    if not np.any(mask):
        return None

    arr_conn = _is_connector(arr)
    sub_conn = _is_connector(sub)
    overlap_ok = arr_conn & sub_conn & (arr == sub)
    conflict = mask & (sub != bg) & ~overlap_ok
