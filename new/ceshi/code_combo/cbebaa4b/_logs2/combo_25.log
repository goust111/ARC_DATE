+                    break
+            if outline_bad:
+                continue
+
+            paste(inp, node["arr"], top, left, transparent=0)
+            node["scatter_bbox"] = rect
+            _mark_chebyshev_guard(input_guard, cells, SCATTER_PADDING)
+            _mark_outline_guard(outline_guard, outline_cells)
+            outline_rects.append(rect)
+            placed = True
+            break
+        if not placed:
