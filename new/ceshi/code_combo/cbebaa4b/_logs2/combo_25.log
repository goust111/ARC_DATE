+BG = 0
+RED = 2
+YELLOW = 4
+GREY = 5
+
+GRID_H_RANGE = (22, 26)
+GRID_W_RANGE = (22, 26)
+MAX_ASSEMBLY_DIM = 24
+
+PIECE_COUNT_VALUES = (4, 5, 6)
+PIECE_H_RANGE = (4, 7)
+PIECE_W_RANGE = (4, 8)
+PIECE_DIM_CANDIDATES = 12
+PIECE_COLORS = [1, 3, 6, 7, 8, 9]
+PIECE_CAP = 2
+BAR_SKIP_PROB = 0.35
