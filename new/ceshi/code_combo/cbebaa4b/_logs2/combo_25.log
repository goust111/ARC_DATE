+    outline_guard = _make_guard_mask(assembled != 0)
+    outline_rects = []
+    rest = nodes[1:]
+    rest.sort(key=lambda n: n["shape"][0] * n["shape"][1], reverse=True)
+
+    for node in rest:
+        ph, pw = node["shape"]
+        placed = False
+        for _ in range(SCATTER_ATTEMPTS):
+            top = random.randint(0, h - ph)
