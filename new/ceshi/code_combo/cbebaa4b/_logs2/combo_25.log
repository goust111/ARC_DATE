+def _mark_chebyshev_guard(guard: np.ndarray, cells: list[tuple[int, int]], pad: int) -> None:
+    h, w = guard.shape
+    for r, c in cells:
+        for dr in range(-pad, pad + 1):
+            rr = r + dr
+            if not (0 <= rr < h):
+                continue
+            for dc in range(-pad, pad + 1):
+                cc = c + dc
+                if 0 <= cc < w:
+                    guard[rr, cc] = True
+
