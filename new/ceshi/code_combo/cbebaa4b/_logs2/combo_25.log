+    assembled = _assemble(nodes, h, w)
+    if assembled is None:
+        return None
+    inp = _scatter(nodes, assembled)
+    if inp is None:
+        return None
+    expected = _expected_output(nodes, assembled)
+    try:
+        solved = main(inp)
+    except Exception:
+        return None
+    if np.array_equal(solved, expected):
+        return inp
+    return None
+
+
+def generate_input() -> np.ndarray:
