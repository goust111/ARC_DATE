+    total_ports = sum(int(np.sum(n["arr"] == RED)) for n in nodes)
+    if len(all_red_counts) * 2 != total_ports:
+        return None
+    if any(v != 2 for v in all_red_counts.values()):
+        return None
+    if len(components_mask(out != 0, connectivity=4)) != 1:
+        return None
+    return out
+
+
+def _make_guard_mask(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    guard = mask.copy()
+    pts = np.argwhere(mask)
+    for r, c in pts:
+        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+            rr, cc = int(r) + dr, int(c) + dc
+            if 0 <= rr < h and 0 <= cc < w:
+                guard[rr, cc] = True
+    return guard
+
+
+def _scatter(nodes, assembled):
+    h, w = assembled.shape
+    inp = np.zeros((h, w), dtype=int)
+    anchor = nodes[0]
+    paste(inp, anchor["arr"], *anchor["pos"], transparent=0)
+
+    guard = _make_guard_mask(assembled != 0)
+    ar, ac = anchor["pos"]
+    ah, aw = anchor["shape"]
+    anchor_rect = (ar, ac, ar + ah - 1, ac + aw - 1)
+    occupied_rects = [_expand_rect(anchor_rect, SCATTER_PADDING)]
+    rest = nodes[1:]
+    random.shuffle(rest)
+    rest.sort(key=lambda n: n["shape"][0] * n["shape"][1], reverse=True)
+
+    for node in rest:
+        ph, pw = node["shape"]
+        placed = False
+        for _ in range(SCATTER_ATTEMPTS):
+            top = random.randint(0, h - ph)
+            left = random.randint(0, w - pw)
+            rect = (top, left, top + ph - 1, left + pw - 1)
+            rect_pad = _expand_rect(rect, SCATTER_PADDING)
+            if any(_rects_overlap(rect_pad, other) for other in occupied_rects):
+                continue
+
+            if np.any(inp[top : top + ph, left : left + pw] & (node["arr"] != 0)):
+                continue
+
+            outline_bad = False
+            for r, c in _outline_cells(top, left, node["shape"]):
+                if guard[r, c]:
+                    outline_bad = True
+                    break
+            if outline_bad:
