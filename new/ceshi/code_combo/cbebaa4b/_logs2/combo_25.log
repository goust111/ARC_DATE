+    h, w = guard.shape
+    for r, c in cells:
+        guard[r, c] = True
+        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+            rr, cc = r + dr, c + dc
+            if 0 <= rr < h and 0 <= cc < w:
+                guard[rr, cc] = True
+
+
+def _scatter(nodes, assembled):
+    h, w = assembled.shape
+    inp = np.zeros((h, w), dtype=int)
+    anchor = nodes[0]
