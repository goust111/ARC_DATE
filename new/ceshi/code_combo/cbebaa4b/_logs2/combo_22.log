def _ownership_grid(
    top_h: int, left_w: int, anchor_h: int, anchor_w: int, right_w: int, bottom_h: int
) -> np.ndarray:
    H = top_h + anchor_h + bottom_h
    W = left_w + anchor_w + right_w
    own = np.full((H, W), -1, dtype=int)
    own[:top_h, :] = T
    own[top_h : top_h + anchor_h, :left_w] = L
