+import itertools
+import random
+
+import numpy as np
+
+from arc_utils import bbox_coords, components_mask, paste, random_free_location
+
+
+def _tight_crop_non_bg(g: np.ndarray, bg: int) -> np.ndarray:
+    pts = np.argwhere(g != bg)
+    if pts.size == 0:
+        return g[:0, :0].copy()
