--- /dev/null
+++ b/ceshi/code/de809cff/D6/1/code.py
@@ -0,0 +1,568 @@
+# Variant of de809cff
+# Dimension: D6 — 预清洁步骤：孤立色斑与边界突出的处理 (multi_step)
+# Change: 变换前先清洁前景区域：移除背景/边缘区域中的孤立前景色斑点（single-cell specks），将单像素边界突出（protrusion）重着色为周围区域色 → 清洁后保留色斑痕迹（teal标记）
+
+from __future__ import annotations
+
+from collections import Counter as _Counter
+from pathlib import Path
+import random
+import sys
+
+import numpy as np
+
+for _parent in Path(__file__).resolve().parents:
+    _solvers_dir = _parent / "solvers"
+    if (_solvers_dir / "arc_utils.py").exists():
+        if str(_solvers_dir) not in sys.path:
+            sys.path.append(str(_solvers_dir))
+        break
+
+from arc_utils import Color
+
+# Design analysis for the D6 variant
+# a) Concrete behavior and trace:
+#    - The input still contains two large foreground regions on black, black dents,
+#      and one-cell foreground noise.
+#    - The new difference appears only after cleanup:
+#      * old task: an isolated foreground speck in black simply vanished to black.
+#      * new task: that same cell is still removed during cleanup, but the output
+#        paints a lone teal marker at that coordinate.
+#      * dent centers remain teal too, but they sit inside a 3x3 opposite-color
+#        patch, whereas a removed speck leaves an isolated teal point in black.
+#    - Small example:
+#      input local patch      old output        new output
+#      000                    000               000
+#      020   (isolated red)   000               080
+#      000                    000               000
+#      For a dent inside a blue region, both old and new tasks still create the
+#      opposite-color 3x3 patch with a teal center.
+# b) Complexity calibration:
+#    - Only two teal semantics are allowed: dent-center teal and speck-trace teal.
+#    - To keep the visual rule inferable, generator forces several isolated traces
+#      per sample and keeps them outside dent-patch footprints.
+#    - Boundary protrusions still recolor to the host region without leaving teal;
+#      otherwise too many teal cases would blur the task.
+# c) Implicit-assumption audit of the original solver:
+#    - `_clean_foreground` previously assumed every foreground->background cleanup
+#      could be forgotten. That no longer holds.
+#    - `_dent_centers` already scans only original black cells, so teal traces do
+#      not interfere because traces originate from original foreground cells.
+#    - `out = clean.copy()` used to be final for cleaned specks; now we must add a
+#      second overlay step that restores those coordinates as teal after dent logic.
+#    - Stamping dent patches before teal centers is still safe; traces are added at
+#      the end, and generator prevents trace/patched-cell collisions.
+# d) Placement legality:
+#    - Background specks are placed only on clean black cells, far from each other,
+#      and outside every dent 3x3 footprint, so each one remains a single visible
+#      teal trace rather than being swallowed by a patch.
+#    - Boundary contamination remains inside foreground boundary zones and uses the
+#      old safety checks so cleanup returns it to the host color.
+# e) Visual observability:
+#    - Across examples, the solver now produces both isolated teal dots in black
+#      and teal centers embedded in opposite-color 3x3 patches. The contrast is
+#      visible without relying on color ids or hidden ordering.
+# f) Visual cleanliness:
+#    - Trace specks are separated from one another and from dent patches. This
+#      avoids ambiguous teal clusters and keeps output readable.
+# g) Color-change inferability:
+#    - No new color mapping is introduced. Teal only means "defect marker", but
+#      the local context distinguishes whether the marked defect was a dent or a
+#      removed isolated speck.
+# 9) New solver assumptions and generator guarantees:
+#    - Solver assumption: any original foreground cell that becomes black after the
+#      two cleanup sweeps should be shown as a teal trace.
+#    - Generator guarantee: placed trace specks are isolated enough to become black
+#      in `clean`, while genuine dents remain original black cells and therefore are
+#      the only positions eligible for opposite-color 3x3 dent stamping.
+
+
+def _main_colors(g: np.ndarray, bg: int) -> tuple[int, int]:
+    colors = [int(c) for c in np.unique(g) if int(c) != int(bg)]
+    colors.sort(key=lambda c: int(np.sum(g == c)), reverse=True)
+    assert len(colors) >= 2, "expected two foreground colors"
+    return int(colors[0]), int(colors[1])
+
+
+def _sub3x3(grid: np.ndarray, r: int, c: int) -> np.ndarray:
+    h, w = grid.shape
+    return grid[max(0, r - 1) : min(h, r + 2), max(0, c - 1) : min(w, c + 2)]
+
+
+def _has_same_2x2(g: np.ndarray, r: int, c: int, color: int) -> bool:
+    h, w = g.shape
+    for dr in (-1, 0):
+        for dc in (-1, 0):
+            rr = int(r) + dr
+            cc = int(c) + dc
+            if 0 <= rr < h - 1 and 0 <= cc < w - 1:
+                if bool(np.all(g[rr : rr + 2, cc : cc + 2] == int(color))):
+                    return True
+    return False
+
+
+def _clean_foreground(g: np.ndarray, colors: tuple[int, int], bg: int) -> np.ndarray:
+    """
+    Normalize one-cell noise before dent detection.
+
+    Like the base task, cleanup runs for two sweeps. The variant does not alter
+    which cells get cleaned; it only changes how cleaned-away specks reappear in
+    the final output.
+    """
+    h, w = g.shape
+    a, b = map(int, colors)
+    cur = g.copy()
+
+    for _ in range(2):
+        nxt = cur.copy()
+        for r in range(h):
+            for c in range(w):
+                v = int(cur[r, c])
+                if v not in colors:
+                    nxt[r, c] = bg
+                    continue
+
+                sub = _sub3x3(cur, r, c)
+                own = int(np.sum(sub == v))
+                other = b if v == a else a
+                other_count = int(np.sum(sub == other))
+                bg_count = int(np.sum(sub == bg))
+
+                if _has_same_2x2(cur, r, c, v):
+                    nxt[r, c] = v
+                elif other_count > own and other_count >= 5:
+                    nxt[r, c] = other
+                elif bg_count >= 5 and own <= 4:
+                    nxt[r, c] = bg
+                elif own <= 2:
+                    nxt[r, c] = bg
+                else:
+                    nxt[r, c] = v
+        cur = nxt
+
+    return cur
+
+
+def _removed_specks(
+    original: np.ndarray, clean: np.ndarray, colors: tuple[int, int], bg: int
+) -> list[tuple[int, int]]:
+    """Foreground cells erased to background become teal traces in the variant."""
+    color_mask = np.isin(original, list(map(int, colors)))
+    removed = color_mask & (clean == int(bg))
+    return [(int(r), int(c)) for r, c in zip(*np.where(removed), strict=False)]
+
+
+def _dent_centers(
+    original: np.ndarray, clean: np.ndarray, colors: tuple[int, int], bg: int
+) -> list[tuple[int, int, int]]:
+    h, w = original.shape
+    centers: list[tuple[int, int, int]] = []
+    for r, c in zip(*np.where(original == int(bg)), strict=False):
+        rr = int(r)
+        cc = int(c)
+        sub = clean[max(0, rr - 1) : min(h, rr + 2), max(0, cc - 1) : min(w, cc + 2)]
+        counts = {int(color): int(np.sum(sub == int(color))) for color in colors}
+        host = max(colors, key=lambda color: counts[int(color)])
+        other = colors[1] if int(host) == int(colors[0]) else colors[0]
+        if counts[int(host)] >= 5 and counts[int(host)] > counts[int(other)]:
+            centers.append((rr, cc, int(host)))
+    return centers
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Convert black dents into opposite-color patches while preserving cleaned speck traces.
+
+    Input structure:
+    - Black background with two large foreground-colored regions.
+    - Inside and around those regions are black dents, isolated one-cell foreground
+      specks in black space, and a few one-cell boundary protrusions of the wrong color.
+
+    Rule:
+    - First run the same local cleanup as the base task: isolated foreground specks
+      are removed to black, and one-cell cross-boundary protrusions are recolored to
+      the surrounding region color.
+    - Any original black cell whose cleaned 3x3 neighborhood is dominated by one
+      foreground color becomes the center of a 3x3 patch in the opposite color.
+    - Teal (8) is then used for two markers: the center of every dent patch, and
+      every original foreground speck that cleanup erased to black.
+
+    Key insight:
+    - Teal no longer has a single meaning. A teal cell inside an opposite-color 3x3
+      patch marks a dent, while an isolated teal cell in black records where a stray
+      foreground speck was cleaned away.
+    """
+    g = np.asarray(grid, dtype=int)
+    bg = Color.BLACK
+    colors = _main_colors(g, bg)
+    clean = _clean_foreground(g, colors, bg)
+    removed_specks = _removed_specks(g, clean, colors, bg)
+
+    out = clean.copy()
+    centers = _dent_centers(g, clean, colors, bg)
+    h, w = g.shape
+    for r, c, host in centers:
+        other = colors[1] if int(host) == int(colors[0]) else colors[0]
+        out[max(0, r - 1) : min(h, r + 2), max(0, c - 1) : min(w, c + 2)] = int(other)
+
+    for r, c, _host in centers:
+        out[r, c] = Color.TEAL
+    for r, c in removed_specks:
+        out[r, c] = Color.TEAL
+
+    return out
+
+
+# --------------- generator (cx) ---------------
+
+# --- CFG: canvas & region layout ---
+GRID_SIZE_MIN, GRID_SIZE_MAX = 20, 30
+RECT_SIZE_FRAC_MIN, RECT_SIZE_FRAC_MAX = 0.45, 0.75
+RECT_MARGIN_MAX = 3
+MIN_REGION_CELLS = 100
+COVERAGE_MIN, COVERAGE_MAX = 0.55, 0.85
+
+# --- CFG: dent placement ---
+DENT_COUNT_MIN, DENT_COUNT_MAX = 12, 22
+DENT_MIN_HOST_3x3 = 5
+DENT_PATCH_SEPARATION = 3
+DENT_PAIR_PROB = 0.13
+
+# --- CFG: noise ---
+NOISE_COUNT_MIN, NOISE_COUNT_MAX = 7, 22
+BG_NOISE_FRAC_MIN, BG_NOISE_FRAC_MAX = 0.65, 0.85
+BG_SPECK_MIN_BG_3x3 = 6
+BOUNDARY_MIN_HOST_3x3 = 6
+TRACE_SPECK_MIN = 4
+TRACE_SPECK_SEPARATION = 2
+
+# --- CFG: generation control ---
+MAX_GENERATION_ATTEMPTS = 400
+
+
+def _build_regions(N: int, color_a: int, color_b: int, rng: random.Random) -> np.ndarray | None:
+    """Paint 2-3 overlapping rectangles (simple occlusion, painter's algorithm)."""
+    n_rects = rng.choice([2, 3])
+    corners = ["TL", "TR", "BL", "BR"]
+    rng.shuffle(corners)
+    chosen_corners = corners[:n_rects]
+
+    if n_rects == 2:
+        rect_colors = [color_a, color_b]
+        rng.shuffle(rect_colors)
+    else:
+        first = rng.choice([color_a, color_b])
+        mid = color_b if first == color_a else color_a
+        rect_colors = [first, mid, first]
+
+    def _make_rect(corner: str) -> tuple[int, int, int, int]:
+        h = rng.randint(int(N * RECT_SIZE_FRAC_MIN), int(N * RECT_SIZE_FRAC_MAX))
+        w = rng.randint(int(N * RECT_SIZE_FRAC_MIN), int(N * RECT_SIZE_FRAC_MAX))
+        m = rng.randint(0, RECT_MARGIN_MAX)
+        r0 = m if corner[0] == "T" else max(0, N - h - m)
+        c0 = m if corner[1] == "L" else max(0, N - w - m)
+        return r0, c0, min(N, r0 + h), min(N, c0 + w)
+
+    grid = np.zeros((N, N), dtype=int)
+    for corner, color in zip(chosen_corners, rect_colors):
+        r0, c0, r1, c1 = _make_rect(corner)
+        grid[r0:r1, c0:c1] = color
+
+    cnt_a = int(np.sum(grid == color_a))
+    cnt_b = int(np.sum(grid == color_b))
+    if cnt_a < MIN_REGION_CELLS or cnt_b < MIN_REGION_CELLS:
+        return None
+    coverage = (cnt_a + cnt_b) / (N * N)
+    if not (COVERAGE_MIN <= coverage <= COVERAGE_MAX):
+        return None
+    if n_rects == 3:
+        from scipy.ndimage import label
+
+        _, n_components = label(grid == rect_colors[0])
+        if n_components < 2:
+            return None
+    return grid
+
+
+def _is_safe_dent_center(grid: np.ndarray, r: int, c: int, host: int, other: int) -> bool:
+    """After setting (r,c) to black, the solver must detect it as a dent in host region."""
+    if grid[r, c] != host:
+        return False
+    sub = _sub3x3(grid, r, c)
+    host_count = int(np.sum(sub == host)) - 1
+    return host_count >= DENT_MIN_HOST_3x3 and host_count > int(np.sum(sub == other))
+
+
+def _would_form_2x2(grid: np.ndarray, r: int, c: int, color: int) -> bool:
+    """Check whether placing `color` at (r,c) would complete a 2x2 block of that color."""
+    h, w = grid.shape
+    for dr in (-1, 0):
+        for dc in (-1, 0):
+            rr, cc = r + dr, c + dc
+            if 0 <= rr < h - 1 and 0 <= cc < w - 1:
+                block = grid[rr : rr + 2, cc : cc + 2].copy()
+                block[r - rr, c - cc] = color
+                if int(np.sum(block == color)) == 4:
+                    return True
+    return False
+
+
+def _pick_dent_centers(
+    candidates: list[tuple[int, int]], n: int, rng: random.Random
+) -> list[tuple[int, int]] | None:
+    """Select n dent centers from candidates with Chebyshev distance >= DENT_PATCH_SEPARATION."""
+    candidates = candidates.copy()
+    rng.shuffle(candidates)
+    chosen = []
+    for r, c in candidates:
+        if all(max(abs(r - rr), abs(c - cc)) >= DENT_PATCH_SEPARATION for rr, cc in chosen):
+            chosen.append((r, c))
+            if len(chosen) >= n:
+                return chosen
+    return None
+
+
+def _expand_to_pairs(
+    dents: list[tuple[int, int]],
+    host: int,
+    other: int,
+    clean: np.ndarray,
+    all_dents: list[tuple[int, int]],
+    rng: random.Random,
+) -> list[list[tuple[int, int]]]:
+    """Optionally expand single-cell dents into 2-cell adjacent pairs (~13% chance each)."""
+    h, w = clean.shape
+    result = []
+    for r, c in dents:
+        cells = [(r, c)]
+        if rng.random() < DENT_PAIR_PROB:
+            neighbors = [(r + 1, c), (r - 1, c), (r, c + 1), (r, c - 1)]
+            rng.shuffle(neighbors)
+            for nr, nc in neighbors:
+                if not (0 <= nr < h and 0 <= nc < w):
+                    continue
+                if clean[nr, nc] != host or not _is_safe_dent_center(clean, nr, nc, host, other):
+                    continue
+                if all(
+                    max(abs(nr - r2), abs(nc - c2)) >= DENT_PATCH_SEPARATION
+                    for r2, c2 in all_dents
+                    if (r2, c2) != (r, c)
+                ):
+                    cells.append((nr, nc))
+                    break
+        result.append(cells)
+    return result
+
+
+def _dent_footprint_mask(
+    shape: tuple[int, int],
+    dent_groups_a: list[list[tuple[int, int]]],
+    dent_groups_b: list[list[tuple[int, int]]],
+) -> np.ndarray:
+    h, w = shape
+    mask = np.zeros((h, w), dtype=bool)
+    for dent_groups in (dent_groups_a, dent_groups_b):
+        for cells in dent_groups:
+            for r, c in cells:
+                mask[max(0, r - 1) : min(h, r + 2), max(0, c - 1) : min(w, c + 2)] = True
+    return mask
+
+
+def _stamp_dents(
+    clean: np.ndarray,
+    dent_groups_a: list[list[tuple[int, int]]],
+    dent_groups_b: list[list[tuple[int, int]]],
+    color_a: int,
+    color_b: int,
+    trace_cells: list[tuple[int, int]],
+) -> np.ndarray:
+    """Build output by stamping dent patches and then restoring teal markers."""
+    h, w = clean.shape
+    output = clean.copy()
+    for dent_groups, stamp_color in [(dent_groups_a, color_b), (dent_groups_b, color_a)]:
+        for cells in dent_groups:
+            for r, c in cells:
+                output[max(0, r - 1) : min(h, r + 2), max(0, c - 1) : min(w, c + 2)] = stamp_color
+    for dent_groups in (dent_groups_a, dent_groups_b):
+        for cells in dent_groups:
+            for r, c in cells:
+                output[r, c] = Color.TEAL
+    for r, c in trace_cells:
+        output[r, c] = Color.TEAL
+    return output
+
+
+def _add_bg_noise(
+    inp: np.ndarray,
+    clean: np.ndarray,
+    n_in_bg: int,
+    color_a: int,
+    color_b: int,
+    forbidden: np.ndarray,
+    rng: random.Random,
+) -> list[tuple[int, int]]:
+    """Place isolated foreground specks in background area; these become teal traces."""
+    bg_candidates = list(zip(*np.where(clean == 0), strict=False))
+    rng.shuffle(bg_candidates)
+
+    placed_cells: list[tuple[int, int]] = []
+    for r_, c_ in bg_candidates:
+        if len(placed_cells) >= n_in_bg:
+            break
+        r, c = int(r_), int(c_)
+        if forbidden[r, c]:
+            continue
+        if any(
+            max(abs(r - rr), abs(c - cc)) < TRACE_SPECK_SEPARATION for rr, cc in placed_cells
+        ):
+            continue
+        sub = _sub3x3(inp, r, c)
+        if int(np.sum(sub == 0)) < BG_SPECK_MIN_BG_3x3:
+            continue
+        nearby = _sub3x3(clean, r, c)
+        nearby_fg = [int(x) for x in nearby.flat if int(x) != 0]
+        speck_color = (
+            _Counter(nearby_fg).most_common(1)[0][0] if nearby_fg else rng.choice([color_a, color_b])
+        )
+        if _would_form_2x2(inp, r, c, speck_color):
+            continue
+        inp[r, c] = speck_color
+        placed_cells.append((r, c))
+    return placed_cells
+
+
+def _neighbor_cleanup_safe(inp: np.ndarray, r: int, c: int, host: int, other: int) -> bool:
+    """Check that changing (r,c) to `other` won't cause the solver to misclassify any neighbor."""
+    h, w = inp.shape
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            nr, nc = r + dr, c + dc
+            if not (0 <= nr < h and 0 <= nc < w) or inp[nr, nc] != host:
+                continue
+            nsub = _sub3x3(inp, nr, nc).copy()
+            nr0, nc0 = max(0, nr - 1), max(0, nc - 1)
+            nsub[r - nr0, c - nc0] = other
+            own_n = int(np.sum(nsub == host))
+            other_n = int(np.sum(nsub == other))
+            bg_n = int(np.sum(nsub == 0))
+            if (other_n > own_n and other_n >= 5) or own_n <= 2 or (bg_n >= 5 and own_n <= 4):
+                return False
+    return True
+
+
+def _add_boundary_noise(
+    inp: np.ndarray,
+    clean: np.ndarray,
+    n_at_boundary: int,
+    color_a: int,
+    color_b: int,
+    rng: random.Random,
+) -> int:
+    """Place cross-color contamination at region-region boundaries."""
+    h, w = clean.shape
+    boundary_candidates = []
+    for r in range(h):
+        for c in range(w):
+            v = int(clean[r, c])
+            if v not in (color_a, color_b):
+                continue
+            other = color_b if v == color_a else color_a
+            if int(np.sum(_sub3x3(clean, r, c) == other)) >= 1:
+                boundary_candidates.append((r, c, v, other))
+    rng.shuffle(boundary_candidates)
+
+    placed = 0
+    for r, c, host, other in boundary_candidates:
+        if placed >= n_at_boundary:
+            break
+        if inp[r, c] != host:
+            continue
+        sub_now = _sub3x3(inp, r, c)
+        host_count = int(np.sum(sub_now == host))
+        other_count = int(np.sum(sub_now == other))
+        if host_count < BOUNDARY_MIN_HOST_3x3 or host_count - 1 <= other_count + 1:
+            continue
+        if _would_form_2x2(inp, r, c, other):
+            continue
+        if not _neighbor_cleanup_safe(inp, r, c, host, other):
+            continue
+        inp[r, c] = other
+        placed += 1
+    return placed
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    N = rng.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)
+    fg_pool = [c for c in Color.NOT_BLACK if c != Color.TEAL]
+    color_a, color_b = rng.sample(fg_pool, 2)
+
+    clean = _build_regions(N, color_a, color_b, rng)
+    if clean is None:
+        return None
+
+    n_total = rng.randint(DENT_COUNT_MIN, DENT_COUNT_MAX)
+    n_a, n_b = n_total // 2, n_total - n_total // 2
+    if rng.random() < 0.5:
+        n_a, n_b = n_b, n_a
+
+    h, w = clean.shape
+    valid = {color_a: [], color_b: []}
+    for r in range(h):
+        for c in range(w):
+            v = int(clean[r, c])
+            if v == color_a and _is_safe_dent_center(clean, r, c, color_a, color_b):
+                valid[color_a].append((r, c))
+            elif v == color_b and _is_safe_dent_center(clean, r, c, color_b, color_a):
+                valid[color_b].append((r, c))
+
+    if len(valid[color_a]) < n_a + 2 or len(valid[color_b]) < n_b + 2:
+        return None
+
+    dents_a = _pick_dent_centers(valid[color_a], n_a, rng)
+    dents_b = _pick_dent_centers(valid[color_b], n_b, rng)
+    if dents_a is None or dents_b is None:
+        return None
+
+    groups_a = _expand_to_pairs(dents_a, color_a, color_b, clean, dents_a, rng)
+    groups_b = _expand_to_pairs(dents_b, color_b, color_a, clean, dents_b, rng)
+    dent_forbidden = _dent_footprint_mask(clean.shape, groups_a, groups_b)
+
+    inp = clean.copy()
+    for cells in groups_a + groups_b:
+        for r, c in cells:
+            inp[r, c] = 0
+
+    n_noise = rng.randint(NOISE_COUNT_MIN, NOISE_COUNT_MAX)
+    n_in_bg = max(
+        TRACE_SPECK_MIN,
+        int(round(n_noise * rng.uniform(BG_NOISE_FRAC_MIN, BG_NOISE_FRAC_MAX))),
+    )
+    n_in_bg = min(n_in_bg, n_noise)
+    trace_cells = _add_bg_noise(inp, clean, n_in_bg, color_a, color_b, dent_forbidden, rng)
+    if len(trace_cells) < TRACE_SPECK_MIN:
+        return None
+
+    _add_boundary_noise(inp, clean, n_noise - len(trace_cells), color_a, color_b, rng)
+    output = _stamp_dents(clean, groups_a, groups_b, color_a, color_b, trace_cells)
+
+    try:
+        produced = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(produced, output):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        try:
+            grid = _gen_attempt(rng)
+        except Exception:
+            grid = None
+        if grid is not None:
+            return grid
+    raise RuntimeError("generate_input: failed after %d attempts" % MAX_GENERATION_ATTEMPTS)

diff --git a/ceshi/code/de809cff/D6/1/code.py b/ceshi/code/de809cff/D6/1/code.py
new file mode 100644
index 0000000000000000000000000000000000000000..b33b6d0ea2208e2b001aa024561989e4ed14a832
--- /dev/null
+++ b/ceshi/code/de809cff/D6/1/code.py
@@ -0,0 +1,568 @@
+# Variant of de809cff
+# Dimension: D6 — 预清洁步骤：孤立色斑与边界突出的处理 (multi_step)
+# Change: 变换前先清洁前景区域：移除背景/边缘区域中的孤立前景色斑点（single-cell specks），将单像素边界突出（protrusion）重着色为周围区域色 → 清洁后保留色斑痕迹（teal标记）
+
+from __future__ import annotations
+
+from collections import Counter as _Counter
+from pathlib import Path
+import random
+import sys
+
+import numpy as np
+
+for _parent in Path(__file__).resolve().parents:
+    _solvers_dir = _parent / "solvers"
+    if (_solvers_dir / "arc_utils.py").exists():
+        if str(_solvers_dir) not in sys.path:
+            sys.path.append(str(_solvers_dir))
+        break
+
+from arc_utils import Color
+
+# Design analysis for the D6 variant
+# a) Concrete behavior and trace:
+#    - The input still contains two large foreground regions on black, black dents,
+#      and one-cell foreground noise.
+#    - The new difference appears only after cleanup:
+#      * old task: an isolated foreground speck in black simply vanished to black.
+#      * new task: that same cell is still removed during cleanup, but the output
+#        paints a lone teal marker at that coordinate.
+#      * dent centers remain teal too, but they sit inside a 3x3 opposite-color
+#        patch, whereas a removed speck leaves an isolated teal point in black.
+#    - Small example:
+#      input local patch      old output        new output
+#      000                    000               000
+#      020   (isolated red)   000               080
+#      000                    000               000
+#      For a dent inside a blue region, both old and new tasks still create the
+#      opposite-color 3x3 patch with a teal center.
+# b) Complexity calibration:
+#    - Only two teal semantics are allowed: dent-center teal and speck-trace teal.
+#    - To keep the visual rule inferable, generator forces several isolated traces
+#      per sample and keeps them outside dent-patch footprints.
+#    - Boundary protrusions still recolor to the host region without leaving teal;
+#      otherwise too many teal cases would blur the task.
+# c) Implicit-assumption audit of the original solver:
+#    - `_clean_foreground` previously assumed every foreground->background cleanup
+#      could be forgotten. That no longer holds.
+#    - `_dent_centers` already scans only original black cells, so teal traces do
+#      not interfere because traces originate from original foreground cells.
+#    - `out = clean.copy()` used to be final for cleaned specks; now we must add a
+#      second overlay step that restores those coordinates as teal after dent logic.
+#    - Stamping dent patches before teal centers is still safe; traces are added at
+#      the end, and generator prevents trace/patched-cell collisions.
+# d) Placement legality:
+#    - Background specks are placed only on clean black cells, far from each other,
+#      and outside every dent 3x3 footprint, so each one remains a single visible
+#      teal trace rather than being swallowed by a patch.
+#    - Boundary contamination remains inside foreground boundary zones and uses the
+#      old safety checks so cleanup returns it to the host color.
+# e) Visual observability:
+#    - Across examples, the solver now produces both isolated teal dots in black
+#      and teal centers embedded in opposite-color 3x3 patches. The contrast is
+#      visible without relying on color ids or hidden ordering.
+# f) Visual cleanliness:
+#    - Trace specks are separated from one another and from dent patches. This
+#      avoids ambiguous teal clusters and keeps output readable.
+# g) Color-change inferability:
+#    - No new color mapping is introduced. Teal only means "defect marker", but
+#      the local context distinguishes whether the marked defect was a dent or a
+#      removed isolated speck.
+# 9) New solver assumptions and generator guarantees:
+#    - Solver assumption: any original foreground cell that becomes black after the
+#      two cleanup sweeps should be shown as a teal trace.
+#    - Generator guarantee: placed trace specks are isolated enough to become black
+#      in `clean`, while genuine dents remain original black cells and therefore are
+#      the only positions eligible for opposite-color 3x3 dent stamping.
+
+
+def _main_colors(g: np.ndarray, bg: int) -> tuple[int, int]:
+    colors = [int(c) for c in np.unique(g) if int(c) != int(bg)]
+    colors.sort(key=lambda c: int(np.sum(g == c)), reverse=True)
+    assert len(colors) >= 2, "expected two foreground colors"
+    return int(colors[0]), int(colors[1])
+
+
+def _sub3x3(grid: np.ndarray, r: int, c: int) -> np.ndarray:
+    h, w = grid.shape
+    return grid[max(0, r - 1) : min(h, r + 2), max(0, c - 1) : min(w, c + 2)]
+
+
+def _has_same_2x2(g: np.ndarray, r: int, c: int, color: int) -> bool:
+    h, w = g.shape
+    for dr in (-1, 0):
+        for dc in (-1, 0):
+            rr = int(r) + dr
+            cc = int(c) + dc
+            if 0 <= rr < h - 1 and 0 <= cc < w - 1:
+                if bool(np.all(g[rr : rr + 2, cc : cc + 2] == int(color))):
+                    return True
+    return False
+
+
+def _clean_foreground(g: np.ndarray, colors: tuple[int, int], bg: int) -> np.ndarray:
+    """
+    Normalize one-cell noise before dent detection.
+
+    Like the base task, cleanup runs for two sweeps. The variant does not alter
+    which cells get cleaned; it only changes how cleaned-away specks reappear in
+    the final output.
+    """
+    h, w = g.shape
+    a, b = map(int, colors)
+    cur = g.copy()
+
+    for _ in range(2):
+        nxt = cur.copy()
+        for r in range(h):
+            for c in range(w):
+                v = int(cur[r, c])
+                if v not in colors:
+                    nxt[r, c] = bg
+                    continue
+
+                sub = _sub3x3(cur, r, c)
+                own = int(np.sum(sub == v))
+                other = b if v == a else a
+                other_count = int(np.sum(sub == other))
+                bg_count = int(np.sum(sub == bg))
+
+                if _has_same_2x2(cur, r, c, v):
+                    nxt[r, c] = v
+                elif other_count > own and other_count >= 5:
+                    nxt[r, c] = other
+                elif bg_count >= 5 and own <= 4:
+                    nxt[r, c] = bg
+                elif own <= 2:
+                    nxt[r, c] = bg
+                else:
+                    nxt[r, c] = v
+        cur = nxt
+
+    return cur
+
+
+def _removed_specks(
+    original: np.ndarray, clean: np.ndarray, colors: tuple[int, int], bg: int
+) -> list[tuple[int, int]]:
+    """Foreground cells erased to background become teal traces in the variant."""
+    color_mask = np.isin(original, list(map(int, colors)))
+    removed = color_mask & (clean == int(bg))
+    return [(int(r), int(c)) for r, c in zip(*np.where(removed), strict=False)]
+
+
+def _dent_centers(
+    original: np.ndarray, clean: np.ndarray, colors: tuple[int, int], bg: int
+) -> list[tuple[int, int, int]]:
+    h, w = original.shape
+    centers: list[tuple[int, int, int]] = []
+    for r, c in zip(*np.where(original == int(bg)), strict=False):
+        rr = int(r)
+        cc = int(c)
+        sub = clean[max(0, rr - 1) : min(h, rr + 2), max(0, cc - 1) : min(w, cc + 2)]
+        counts = {int(color): int(np.sum(sub == int(color))) for color in colors}
+        host = max(colors, key=lambda color: counts[int(color)])
+        other = colors[1] if int(host) == int(colors[0]) else colors[0]
+        if counts[int(host)] >= 5 and counts[int(host)] > counts[int(other)]:
+            centers.append((rr, cc, int(host)))
+    return centers
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Convert black dents into opposite-color patches while preserving cleaned speck traces.
+
+    Input structure:
+    - Black background with two large foreground-colored regions.
+    - Inside and around those regions are black dents, isolated one-cell foreground
+      specks in black space, and a few one-cell boundary protrusions of the wrong color.
+
+    Rule:
+    - First run the same local cleanup as the base task: isolated foreground specks
+      are removed to black, and one-cell cross-boundary protrusions are recolored to
+      the surrounding region color.
+    - Any original black cell whose cleaned 3x3 neighborhood is dominated by one
+      foreground color becomes the center of a 3x3 patch in the opposite color.
+    - Teal (8) is then used for two markers: the center of every dent patch, and
+      every original foreground speck that cleanup erased to black.
+
+    Key insight:
+    - Teal no longer has a single meaning. A teal cell inside an opposite-color 3x3
+      patch marks a dent, while an isolated teal cell in black records where a stray
+      foreground speck was cleaned away.
+    """
+    g = np.asarray(grid, dtype=int)
+    bg = Color.BLACK
+    colors = _main_colors(g, bg)
+    clean = _clean_foreground(g, colors, bg)
+    removed_specks = _removed_specks(g, clean, colors, bg)
+
+    out = clean.copy()
+    centers = _dent_centers(g, clean, colors, bg)
+    h, w = g.shape
+    for r, c, host in centers:
+        other = colors[1] if int(host) == int(colors[0]) else colors[0]
+        out[max(0, r - 1) : min(h, r + 2), max(0, c - 1) : min(w, c + 2)] = int(other)
+
+    for r, c, _host in centers:
+        out[r, c] = Color.TEAL
+    for r, c in removed_specks:
+        out[r, c] = Color.TEAL
+
+    return out
+
+
+# --------------- generator (cx) ---------------
+
+# --- CFG: canvas & region layout ---
+GRID_SIZE_MIN, GRID_SIZE_MAX = 20, 30
+RECT_SIZE_FRAC_MIN, RECT_SIZE_FRAC_MAX = 0.45, 0.75
+RECT_MARGIN_MAX = 3
+MIN_REGION_CELLS = 100
+COVERAGE_MIN, COVERAGE_MAX = 0.55, 0.85
+
+# --- CFG: dent placement ---
+DENT_COUNT_MIN, DENT_COUNT_MAX = 12, 22
+DENT_MIN_HOST_3x3 = 5
+DENT_PATCH_SEPARATION = 3
+DENT_PAIR_PROB = 0.13
+
+# --- CFG: noise ---
+NOISE_COUNT_MIN, NOISE_COUNT_MAX = 7, 22
+BG_NOISE_FRAC_MIN, BG_NOISE_FRAC_MAX = 0.65, 0.85
+BG_SPECK_MIN_BG_3x3 = 6
+BOUNDARY_MIN_HOST_3x3 = 6
+TRACE_SPECK_MIN = 4
+TRACE_SPECK_SEPARATION = 2
+
+# --- CFG: generation control ---
+MAX_GENERATION_ATTEMPTS = 400
+
+
+def _build_regions(N: int, color_a: int, color_b: int, rng: random.Random) -> np.ndarray | None:
+    """Paint 2-3 overlapping rectangles (simple occlusion, painter's algorithm)."""
+    n_rects = rng.choice([2, 3])
+    corners = ["TL", "TR", "BL", "BR"]
+    rng.shuffle(corners)
+    chosen_corners = corners[:n_rects]
+
+    if n_rects == 2:
+        rect_colors = [color_a, color_b]
+        rng.shuffle(rect_colors)
+    else:
+        first = rng.choice([color_a, color_b])
+        mid = color_b if first == color_a else color_a
+        rect_colors = [first, mid, first]
+
+    def _make_rect(corner: str) -> tuple[int, int, int, int]:
+        h = rng.randint(int(N * RECT_SIZE_FRAC_MIN), int(N * RECT_SIZE_FRAC_MAX))
+        w = rng.randint(int(N * RECT_SIZE_FRAC_MIN), int(N * RECT_SIZE_FRAC_MAX))
+        m = rng.randint(0, RECT_MARGIN_MAX)
+        r0 = m if corner[0] == "T" else max(0, N - h - m)
+        c0 = m if corner[1] == "L" else max(0, N - w - m)
+        return r0, c0, min(N, r0 + h), min(N, c0 + w)
+
+    grid = np.zeros((N, N), dtype=int)
+    for corner, color in zip(chosen_corners, rect_colors):
+        r0, c0, r1, c1 = _make_rect(corner)
+        grid[r0:r1, c0:c1] = color
+
+    cnt_a = int(np.sum(grid == color_a))
+    cnt_b = int(np.sum(grid == color_b))
+    if cnt_a < MIN_REGION_CELLS or cnt_b < MIN_REGION_CELLS:
+        return None
+    coverage = (cnt_a + cnt_b) / (N * N)
+    if not (COVERAGE_MIN <= coverage <= COVERAGE_MAX):
+        return None
+    if n_rects == 3:
+        from scipy.ndimage import label
+
+        _, n_components = label(grid == rect_colors[0])
+        if n_components < 2:
+            return None
+    return grid
+
+
+def _is_safe_dent_center(grid: np.ndarray, r: int, c: int, host: int, other: int) -> bool:
+    """After setting (r,c) to black, the solver must detect it as a dent in host region."""
+    if grid[r, c] != host:
+        return False
+    sub = _sub3x3(grid, r, c)
+    host_count = int(np.sum(sub == host)) - 1
+    return host_count >= DENT_MIN_HOST_3x3 and host_count > int(np.sum(sub == other))
+
+
+def _would_form_2x2(grid: np.ndarray, r: int, c: int, color: int) -> bool:
+    """Check whether placing `color` at (r,c) would complete a 2x2 block of that color."""
+    h, w = grid.shape
+    for dr in (-1, 0):
+        for dc in (-1, 0):
+            rr, cc = r + dr, c + dc
+            if 0 <= rr < h - 1 and 0 <= cc < w - 1:
+                block = grid[rr : rr + 2, cc : cc + 2].copy()
+                block[r - rr, c - cc] = color
+                if int(np.sum(block == color)) == 4:
+                    return True
+    return False
+
+
+def _pick_dent_centers(
+    candidates: list[tuple[int, int]], n: int, rng: random.Random
+) -> list[tuple[int, int]] | None:
+    """Select n dent centers from candidates with Chebyshev distance >= DENT_PATCH_SEPARATION."""
+    candidates = candidates.copy()
+    rng.shuffle(candidates)
+    chosen = []
+    for r, c in candidates:
+        if all(max(abs(r - rr), abs(c - cc)) >= DENT_PATCH_SEPARATION for rr, cc in chosen):
+            chosen.append((r, c))
+            if len(chosen) >= n:
+                return chosen
+    return None
+
+
+def _expand_to_pairs(
+    dents: list[tuple[int, int]],
+    host: int,
+    other: int,
+    clean: np.ndarray,
+    all_dents: list[tuple[int, int]],
+    rng: random.Random,
+) -> list[list[tuple[int, int]]]:
+    """Optionally expand single-cell dents into 2-cell adjacent pairs (~13% chance each)."""
+    h, w = clean.shape
+    result = []
+    for r, c in dents:
+        cells = [(r, c)]
+        if rng.random() < DENT_PAIR_PROB:
+            neighbors = [(r + 1, c), (r - 1, c), (r, c + 1), (r, c - 1)]
+            rng.shuffle(neighbors)
+            for nr, nc in neighbors:
+                if not (0 <= nr < h and 0 <= nc < w):
+                    continue
+                if clean[nr, nc] != host or not _is_safe_dent_center(clean, nr, nc, host, other):
+                    continue
+                if all(
+                    max(abs(nr - r2), abs(nc - c2)) >= DENT_PATCH_SEPARATION
+                    for r2, c2 in all_dents
+                    if (r2, c2) != (r, c)
+                ):
+                    cells.append((nr, nc))
+                    break
+        result.append(cells)
+    return result
+
+
+def _dent_footprint_mask(
+    shape: tuple[int, int],
+    dent_groups_a: list[list[tuple[int, int]]],
+    dent_groups_b: list[list[tuple[int, int]]],
+) -> np.ndarray:
+    h, w = shape
+    mask = np.zeros((h, w), dtype=bool)
+    for dent_groups in (dent_groups_a, dent_groups_b):
+        for cells in dent_groups:
+            for r, c in cells:
+                mask[max(0, r - 1) : min(h, r + 2), max(0, c - 1) : min(w, c + 2)] = True
+    return mask
+
+
+def _stamp_dents(
+    clean: np.ndarray,
+    dent_groups_a: list[list[tuple[int, int]]],
+    dent_groups_b: list[list[tuple[int, int]]],
+    color_a: int,
+    color_b: int,
+    trace_cells: list[tuple[int, int]],
+) -> np.ndarray:
+    """Build output by stamping dent patches and then restoring teal markers."""
+    h, w = clean.shape
+    output = clean.copy()
+    for dent_groups, stamp_color in [(dent_groups_a, color_b), (dent_groups_b, color_a)]:
+        for cells in dent_groups:
+            for r, c in cells:
+                output[max(0, r - 1) : min(h, r + 2), max(0, c - 1) : min(w, c + 2)] = stamp_color
+    for dent_groups in (dent_groups_a, dent_groups_b):
+        for cells in dent_groups:
+            for r, c in cells:
+                output[r, c] = Color.TEAL
+    for r, c in trace_cells:
+        output[r, c] = Color.TEAL
+    return output
+
+
+def _add_bg_noise(
+    inp: np.ndarray,
+    clean: np.ndarray,
+    n_in_bg: int,
+    color_a: int,
+    color_b: int,
+    forbidden: np.ndarray,
+    rng: random.Random,
+) -> list[tuple[int, int]]:
+    """Place isolated foreground specks in background area; these become teal traces."""
+    bg_candidates = list(zip(*np.where(clean == 0), strict=False))
+    rng.shuffle(bg_candidates)
+
+    placed_cells: list[tuple[int, int]] = []
+    for r_, c_ in bg_candidates:
+        if len(placed_cells) >= n_in_bg:
+            break
+        r, c = int(r_), int(c_)
+        if forbidden[r, c]:
+            continue
+        if any(
+            max(abs(r - rr), abs(c - cc)) < TRACE_SPECK_SEPARATION for rr, cc in placed_cells
+        ):
+            continue
+        sub = _sub3x3(inp, r, c)
+        if int(np.sum(sub == 0)) < BG_SPECK_MIN_BG_3x3:
+            continue
+        nearby = _sub3x3(clean, r, c)
+        nearby_fg = [int(x) for x in nearby.flat if int(x) != 0]
+        speck_color = (
+            _Counter(nearby_fg).most_common(1)[0][0] if nearby_fg else rng.choice([color_a, color_b])
+        )
+        if _would_form_2x2(inp, r, c, speck_color):
+            continue
+        inp[r, c] = speck_color
+        placed_cells.append((r, c))
+    return placed_cells
+
+
+def _neighbor_cleanup_safe(inp: np.ndarray, r: int, c: int, host: int, other: int) -> bool:
+    """Check that changing (r,c) to `other` won't cause the solver to misclassify any neighbor."""
+    h, w = inp.shape
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            nr, nc = r + dr, c + dc
+            if not (0 <= nr < h and 0 <= nc < w) or inp[nr, nc] != host:
+                continue
+            nsub = _sub3x3(inp, nr, nc).copy()
+            nr0, nc0 = max(0, nr - 1), max(0, nc - 1)
+            nsub[r - nr0, c - nc0] = other
+            own_n = int(np.sum(nsub == host))
+            other_n = int(np.sum(nsub == other))
+            bg_n = int(np.sum(nsub == 0))
+            if (other_n > own_n and other_n >= 5) or own_n <= 2 or (bg_n >= 5 and own_n <= 4):
+                return False
+    return True
+
+
+def _add_boundary_noise(
+    inp: np.ndarray,
+    clean: np.ndarray,
+    n_at_boundary: int,
+    color_a: int,
+    color_b: int,
+    rng: random.Random,
+) -> int:
+    """Place cross-color contamination at region-region boundaries."""
+    h, w = clean.shape
+    boundary_candidates = []
+    for r in range(h):
+        for c in range(w):
+            v = int(clean[r, c])
+            if v not in (color_a, color_b):
+                continue
+            other = color_b if v == color_a else color_a
+            if int(np.sum(_sub3x3(clean, r, c) == other)) >= 1:
+                boundary_candidates.append((r, c, v, other))
+    rng.shuffle(boundary_candidates)
+
+    placed = 0
+    for r, c, host, other in boundary_candidates:
+        if placed >= n_at_boundary:
+            break
+        if inp[r, c] != host:
+            continue
+        sub_now = _sub3x3(inp, r, c)
+        host_count = int(np.sum(sub_now == host))
+        other_count = int(np.sum(sub_now == other))
+        if host_count < BOUNDARY_MIN_HOST_3x3 or host_count - 1 <= other_count + 1:
+            continue
+        if _would_form_2x2(inp, r, c, other):
+            continue
+        if not _neighbor_cleanup_safe(inp, r, c, host, other):
+            continue
+        inp[r, c] = other
+        placed += 1
+    return placed
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    N = rng.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)
+    fg_pool = [c for c in Color.NOT_BLACK if c != Color.TEAL]
+    color_a, color_b = rng.sample(fg_pool, 2)
+
+    clean = _build_regions(N, color_a, color_b, rng)
+    if clean is None:
+        return None
+
+    n_total = rng.randint(DENT_COUNT_MIN, DENT_COUNT_MAX)
+    n_a, n_b = n_total // 2, n_total - n_total // 2
+    if rng.random() < 0.5:
+        n_a, n_b = n_b, n_a
+
+    h, w = clean.shape
+    valid = {color_a: [], color_b: []}
+    for r in range(h):
+        for c in range(w):
+            v = int(clean[r, c])
+            if v == color_a and _is_safe_dent_center(clean, r, c, color_a, color_b):
+                valid[color_a].append((r, c))
+            elif v == color_b and _is_safe_dent_center(clean, r, c, color_b, color_a):
+                valid[color_b].append((r, c))
+
+    if len(valid[color_a]) < n_a + 2 or len(valid[color_b]) < n_b + 2:
+        return None
+
+    dents_a = _pick_dent_centers(valid[color_a], n_a, rng)
+    dents_b = _pick_dent_centers(valid[color_b], n_b, rng)
+    if dents_a is None or dents_b is None:
+        return None
+
+    groups_a = _expand_to_pairs(dents_a, color_a, color_b, clean, dents_a, rng)
+    groups_b = _expand_to_pairs(dents_b, color_b, color_a, clean, dents_b, rng)
+    dent_forbidden = _dent_footprint_mask(clean.shape, groups_a, groups_b)
+
+    inp = clean.copy()
+    for cells in groups_a + groups_b:
+        for r, c in cells:
+            inp[r, c] = 0
+
+    n_noise = rng.randint(NOISE_COUNT_MIN, NOISE_COUNT_MAX)
+    n_in_bg = max(
+        TRACE_SPECK_MIN,
+        int(round(n_noise * rng.uniform(BG_NOISE_FRAC_MIN, BG_NOISE_FRAC_MAX))),
+    )
+    n_in_bg = min(n_in_bg, n_noise)
+    trace_cells = _add_bg_noise(inp, clean, n_in_bg, color_a, color_b, dent_forbidden, rng)
+    if len(trace_cells) < TRACE_SPECK_MIN:
+        return None
+
+    _add_boundary_noise(inp, clean, n_noise - len(trace_cells), color_a, color_b, rng)
+    output = _stamp_dents(clean, groups_a, groups_b, color_a, color_b, trace_cells)
+
+    try:
+        produced = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(produced, output):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        try:
+            grid = _gen_attempt(rng)
+        except Exception:
+            grid = None
+        if grid is not None:
+            return grid
+    raise RuntimeError("generate_input: failed after %d attempts" % MAX_GENERATION_ATTEMPTS)

