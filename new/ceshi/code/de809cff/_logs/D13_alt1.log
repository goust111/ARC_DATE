import importlib.util
import numpy as np

base = '/home/lixinyu/snap/new'
var_path = f'{base}/ceshi/code/de809cff/D13/1/code.py'
orig_path = f'{base}/arc2_solver_select/de809cff.py'

spec = importlib.util.spec_from_file_location('variant', var_path)
variant = importlib.util.module_from_spec(spec)
spec.loader.exec_module(variant)

spec2 = importlib.util.spec_from_file_location('original', orig_path)
original = importlib.util.module_from_spec(spec2)
spec2.loader.exec_module(original)

samples = 30
all_dents = 0
mixed_patches = 0
corner_ok = 0
edge_ok = 0
clipped = 0
diff_samples = 0
diff_cells = []
dent_counts = []

for _ in range(samples):
    inp = variant.generate_input()
    out = variant.main(inp)
    old = original.main(inp)
    diff = int(np.sum(out "'!= old))
    diff_cells.append(diff)
    if diff > 0:
        diff_samples += 1

    colors = variant._main_colors(inp, variant.Color.BLACK)
    clean = variant._clean_foreground(inp, colors, variant.Color.BLACK)
    centers = variant._dent_centers(inp, clean, colors, variant.Color.BLACK)
    dent_counts.append(len(centers))
    for r, c, host in centers:
        all_dents += 1
        other = colors[1] if host == colors[0] else colors[0]
        ring_colors = set()
        local_clipped = False
        local_corner_ok = True
        local_edge_ok = True
        for rr in range(r - 1, r + 2):
            for cc in range(c - 1, c + 2):
                if rr == r and cc == c:
                    continue
                if not (0 <= rr < out.shape[0] and 0 <= cc < out.shape[1]):
                    local_clipped = True
                    continue
                val = int(out[rr, cc])
                ring_colors.add(val)
                expected = host if (abs(rr - r) + abs(cc - c)) % 2 == 0 else other
                if abs(rr - r) + abs(cc - c) == 2:
                    local_corner_ok &= val == expected
                else:
                    local_edge_ok &= val == expected
        mixed_patches += ring_colors == {int(colors[0]), int(colors[1])}
        corner_ok += local_corner_ok
        edge_ok += local_edge_ok
        clipped += local_clipped

print({
    '"'samples': samples,
    'dent_count_min': min(dent_counts),
    'dent_count_max': max(dent_counts),
    'dent_count_avg': round(sum(dent_counts) / len(dent_counts), 2),
    'total_dents': all_dents,
    'mixed_patch_fraction': round(mixed_patches / all_dents, 3),
    'corner_rule_fraction': round(corner_ok / all_dents, 3),
    'edge_rule_fraction': round(edge_ok / all_dents, 3),
    'clipped_patch_fraction': round(clipped / all_dents, 3),
    'changed_vs_original_samples': diff_samples,
    'min_diff_cells_vs_original': min(diff_cells),
    'max_diff_cells_vs_original': max(diff_cells),
    'avg_diff_cells_vs_original': round(sum(diff_cells) / len(diff_cells), 1),
})
