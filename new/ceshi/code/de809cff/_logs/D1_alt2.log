+def _stamp_dents_original_style(
+    clean: np.ndarray,
+    dent_groups_a: list[list[tuple[int, int]]],
+    dent_groups_b: list[list[tuple[int, int]]],
+    color_a: int,
+    color_b: int,
+) -> np.ndarray:
+    h, w = clean.shape
