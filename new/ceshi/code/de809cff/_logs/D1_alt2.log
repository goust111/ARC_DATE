+        for cells in pools.values():
+            rng.shuffle(cells)
+
+        order = [color for color, n in counts.items() for _ in range(n)]
+        rng.shuffle(order)
+
+        chosen = {color: [] for color in valid}
+        all_centers: list[tuple[int, int]] = []
