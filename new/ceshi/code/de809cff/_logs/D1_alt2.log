+def _is_boundaryish_cell(grid: np.ndarray, r: int, c: int, host: int) -> bool:
+    h, w = grid.shape
+    if not (0 <= r < h and 0 <= c < w):
+        return True
+    if r == 0 or c == 0 or r == h - 1 or c == w - 1:
+        return True
+    for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
