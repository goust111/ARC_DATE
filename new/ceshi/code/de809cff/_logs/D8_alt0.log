+# Variant of de809cff
+# Dimension: D8 — 背景区域的角色 (meta)
+# Change: 背景色（0）区域不参与变换，仅作为前景区域之间的分隔空间和网格边缘填充... → 背景区域也包含凹痕（前景色凹痕）
+
+from __future__ import annotations
+
+import random
+from collections import Counter as _Counter
+
+import numpy as np
+
+from arc_utils import Color
+
+# Design analysis
+# a) Concrete behavior + trace
+#    - Clean scene stays close to the original task: two large foreground regions
+#      sit on black background, and ordinary dents are black cells punched into a
+#      foreground region.
+#    - The D8 change adds a third host region: the black background can also have
+#      single foreground-colored "reverse dents". In the input they look like lone
+#      colored pixels sitting just outside a foreground edge or inside a black bay.
+#    - Solver flow now has two dent families after cleanup:
+#      1. original black cell inside fg -> host is that fg region -> stamp the
+#         opposite fg color on its 3x3 neighborhood, then recolor the center teal.
+#      2. original fg cell inside bg -> host is the background -> stamp black on
+#         its 3x3 neighborhood, then recolor the center teal.
+#    - Concrete local example:
+#      clean 3x3 near a region edge:
+#          0 0 0
+#          3 0 0
+#          3 3 0
+#      input after inserting a reverse dent:
+#          0 0 0
+#          3 4 0
+#          3 3 0
+#      Original solver would clean the 4 back to 0 and stop. Variant solver also
+#      records that center as a background dent, then outputs a black 3x3 patch
+#      with teal center, visibly carving a square notch into the nearby green edge.
+# b) Complexity calibration
+#    - Reverse dents are restricted to single cells. Keeping them single-cell makes
+#      the new symmetry legible without introducing too many subcases.
+#    - Each grid includes several reverse dents (3-7), always in addition to the
+#      original foreground dents (12-22 total). This prevents regression to the
+#      old task while keeping the output readable.
+#    - Reverse dents are placed where the clean 3x3 neighborhood is bg-majority
+#      but still touches foreground, so the black 3x3 patch is usually visible as
+#      more than a lone teal pixel.
+# c) Implicit assumptions audit against the original main()
+#    - `_main_colors` still assumes the two large visible fg colors dominate all
+#      stray fg cells. Generator preserves this with >=100 cells per region and
+#      only a handful of reverse dents/noise cells.
+#    - `_clean_foreground` previously treated every fg-in-bg cell as removable
+#      noise. That remains useful, but those cleaned-away cells are no longer
+#      discarded; a new detection pass must examine original fg cells whose clean
+#      value becomes bg.
+#    - Original `_dent_centers` only scanned original black cells and only compared
+#      the two fg colors. That assumption breaks for D8 because some real dents are
+#      original non-black cells hosted by background. The variant splits dent
+#      detection into fg-host dents and bg-host dents.
+#    - Original output stamping always used the opposite fg color. That would be
+#      wrong for background-host dents, which must stamp black instead.
+# d) Placement legality
+#    - All dent centers, including reverse dents, are selected with Chebyshev
+#      separation >= 3 so their 3x3 patches do not overlap.
+#    - Reverse dents are only generated on clean background cells whose 3x3
+#      neighborhood satisfies the exact bg-majority predicate used by the solver.
+#    - Boundary-noise cells are kept at least one cell away from every dent center
+#      so cleanup noise cannot perturb dent classification.
+# e) Visual observability
+#    - Every generated sample contains reverse dents, and the test metric later
+#      checks that the variant output differs from the original solver's output.
+#    - Reverse dents are biased toward bg cells adjacent to fg so humans can see
+#      a black 3x3 notch plus teal center, not merely a teal pixel in empty black.
+# f) Visual cleanliness
+#    - Former background speck noise is repurposed into actual reverse dents; the
+#      only remaining noise type is fg-vs-fg boundary contamination. This avoids a
+#      confusing mix of "some bg specks matter, some do not".
+#    - Separation rules keep teal markers and 3x3 patches from piling up.
+# g) Color inference
+#    - There are still only two non-black, non-teal foreground colors. The new
+#      background-host rule does not depend on color id ordering; it depends only
+#      on which region locally dominates after cleanup.
+# New solver assumptions to satisfy in generation
+#    - Reverse dents must be single fg cells that cleanup converts to black.
+#    - Their clean 3x3 neighborhood must have black count >= 5 and strictly exceed
+#      each fg count. Generator enforces this exactly.
+#    - To keep `_main_colors` stable, total reverse dents + boundary noise stays
+#      small relative to the large rectangles.
+
+
+def _main_colors(g: np.ndarray, bg: int) -> tuple[int, int]:
+    colors = [int(c) for c in np.unique(g) if int(c) != int(bg)]
+    colors.sort(key=lambda c: int(np.sum(g == c)), reverse=True)
+    assert len(colors) >= 2, "expected two foreground colors"
+    return int(colors[0]), int(colors[1])
+
+
+def _sub3x3(grid: np.ndarray, r: int, c: int) -> np.ndarray:
+    h, w = grid.shape
+    return grid[max(0, r - 1) : min(h, r + 2), max(0, c - 1) : min(w, c + 2)]
+
+
+def _has_same_2x2(g: np.ndarray, r: int, c: int, color: int) -> bool:
+    h, w = g.shape
+    for dr in (-1, 0):
+        for dc in (-1, 0):
+            rr = int(r) + dr
+            cc = int(c) + dc
+            if 0 <= rr < h - 1 and 0 <= cc < w - 1:
+                if bool(np.all(g[rr : rr + 2, cc : cc + 2] == int(color))):
+                    return True
+    return False
+
+
+def _clean_regions(g: np.ndarray, colors: tuple[int, int], bg: int) -> np.ndarray:
+    """
+    Restore the intended two foreground regions against the black background.
+
+    The cleanup logic is unchanged in spirit from the base task: single-cell
+    foreground specks in black disappear, and one-cell intrusions near the
+    boundary between the two large regions revert to their local majority.
+    """
+    h, w = g.shape
+    a, b = map(int, colors)
+    cur = g.copy()
+
+    for _ in range(2):
+        nxt = cur.copy()
+        for r in range(h):
+            for c in range(w):
+                v = int(cur[r, c])
+                if v not in colors:
+                    nxt[r, c] = bg
+                    continue
+
+                sub = _sub3x3(cur, r, c)
+                own = int(np.sum(sub == v))
+                other = b if v == a else a
+                other_count = int(np.sum(sub == other))
+                bg_count = int(np.sum(sub == bg))
+
+                if _has_same_2x2(cur, r, c, v):
+                    nxt[r, c] = v
+                elif other_count > own and other_count >= 5:
+                    nxt[r, c] = other
+                elif bg_count >= 5 and own <= 4:
+                    nxt[r, c] = bg
+                elif own <= 2:
+                    nxt[r, c] = bg
+                else:
+                    nxt[r, c] = v
+        cur = nxt
+
+    return cur
+
+
+def _foreground_dents(
+    original: np.ndarray, clean: np.ndarray, colors: tuple[int, int], bg: int
+) -> list[tuple[int, int, int]]:
+    centers: list[tuple[int, int, int]] = []
+    for r, c in zip(*np.where(original == int(bg)), strict=False):
+        rr = int(r)
+        cc = int(c)
+        sub = _sub3x3(clean, rr, cc)
+        counts = {int(color): int(np.sum(sub == int(color))) for color in colors}
+        host = max(colors, key=lambda color: counts[int(color)])
+        other = colors[1] if int(host) == int(colors[0]) else colors[0]
+        if counts[int(host)] >= 5 and counts[int(host)] > counts[int(other)]:
+            centers.append((rr, cc, int(other)))
+    return centers
+
+
+def _background_dents(
+    original: np.ndarray, clean: np.ndarray, colors: tuple[int, int], bg: int
+) -> list[tuple[int, int, int]]:
+    centers: list[tuple[int, int, int]] = []
+    for r in range(original.shape[0]):
+        for c in range(original.shape[1]):
+            if int(clean[r, c]) != int(bg):
+                continue
+            if int(original[r, c]) not in colors:
+                continue
+            sub = _sub3x3(clean, r, c)
+            bg_count = int(np.sum(sub == int(bg)))
+            fg_counts = [int(np.sum(sub == int(color))) for color in colors]
+            if bg_count >= 5 and bg_count > max(fg_counts):
+                centers.append((r, c, int(bg)))
+    return centers
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Convert dents in the two foreground regions and in the background into marked patches.
+
+    Input structure:
+    - Two large non-black regions occupy most of the board, separated by black background.
+    - The colored regions contain black dents, and the black background may also contain
+      isolated foreground-colored reverse dents near region edges.
+    - A few one-cell cross-color boundary contaminations may appear between the two
+      foreground regions.
+
+    Rule:
+    - First clean the scene back to its intended regions: isolated fg specks inside
+      black disappear, and one-cell fg-vs-fg protrusions revert to the local host color.
+    - Any original black cell whose cleaned 3x3 neighborhood is dominated by one
+      foreground color becomes the center of a 3x3 patch in the opposite foreground color.
+    - Any original foreground cell whose cleaned 3x3 neighborhood is dominated by black
+      background becomes the center of a 3x3 black patch. Every dent center is recolored teal.
+
+    Key insight:
+    The same local-majority test is applied after cleanup, but now there are three possible
+    host regions to inspect: foreground A, foreground B, and the black background.
+    """
+    g = np.asarray(grid, dtype=int)
+    bg = Color.BLACK
+    colors = _main_colors(g, bg)
+    clean = _clean_regions(g, colors, bg)
+
+    out = clean.copy()
+    centers = _foreground_dents(g, clean, colors, bg) + _background_dents(g, clean, colors, bg)
+    h, w = g.shape
+    for r, c, stamp_color in centers:
+        out[max(0, r - 1) : min(h, r + 2), max(0, c - 1) : min(w, c + 2)] = int(stamp_color)
+
+    for r, c, _stamp_color in centers:
+        out[r, c] = Color.TEAL
+
+    return out
+
+
+# --------------- generator (cx) ---------------
+
+# --- CFG: canvas & region layout ---
+GRID_SIZE_MIN, GRID_SIZE_MAX = 20, 30
+RECT_SIZE_FRAC_MIN, RECT_SIZE_FRAC_MAX = 0.45, 0.75
+RECT_MARGIN_MAX = 3
+MIN_REGION_CELLS = 100
+COVERAGE_MIN, COVERAGE_MAX = 0.55, 0.85
+
+# --- CFG: foreground dents ---
+FG_DENT_COUNT_MIN, FG_DENT_COUNT_MAX = 12, 22
+DENT_MIN_HOST_3X3 = 5
+DENT_PATCH_SEPARATION = 3
+DENT_PAIR_PROB = 0.13
+
+# --- CFG: background reverse dents ---
+BG_DENT_COUNT_MIN, BG_DENT_COUNT_MAX = 3, 7
+BG_DENT_MIN_BG_3X3 = 5
+BG_DENT_MIN_VISIBLE_FG_3X3 = 1
+
+# --- CFG: boundary noise ---
+BOUNDARY_NOISE_MIN, BOUNDARY_NOISE_MAX = 5, 14
+BOUNDARY_MIN_HOST_3X3 = 6
+
+# --- CFG: generation control ---
+MAX_GENERATION_ATTEMPTS = 300
+
+
+def _build_regions(N: int, color_a: int, color_b: int, rng: random.Random) -> np.ndarray | None:
+    """Paint 2-3 overlapping rectangles (simple occlusion, painter's algorithm)."""
+    n_rects = rng.choice([2, 3])
+    corners = ["TL", "TR", "BL", "BR"]
+    rng.shuffle(corners)
+    chosen_corners = corners[:n_rects]
+
+    if n_rects == 2:
+        rect_colors = [color_a, color_b]
+        rng.shuffle(rect_colors)
+    else:
+        first = rng.choice([color_a, color_b])
+        mid = color_b if first == color_a else color_a
+        rect_colors = [first, mid, first]
+
+    def _make_rect(corner: str) -> tuple[int, int, int, int]:
+        h = rng.randint(int(N * RECT_SIZE_FRAC_MIN), int(N * RECT_SIZE_FRAC_MAX))
+        w = rng.randint(int(N * RECT_SIZE_FRAC_MIN), int(N * RECT_SIZE_FRAC_MAX))
+        m = rng.randint(0, RECT_MARGIN_MAX)
+        r0 = m if corner[0] == "T" else max(0, N - h - m)
+        c0 = m if corner[1] == "L" else max(0, N - w - m)
+        return r0, c0, min(N, r0 + h), min(N, c0 + w)
+
+    grid = np.zeros((N, N), dtype=int)
+    for corner, color in zip(chosen_corners, rect_colors):
+        r0, c0, r1, c1 = _make_rect(corner)
+        grid[r0:r1, c0:c1] = color
+
+    cnt_a = int(np.sum(grid == color_a))
+    cnt_b = int(np.sum(grid == color_b))
+    if cnt_a < MIN_REGION_CELLS or cnt_b < MIN_REGION_CELLS:
+        return None
+    coverage = (cnt_a + cnt_b) / (N * N)
+    if not (COVERAGE_MIN <= coverage <= COVERAGE_MAX):
+        return None
+    if n_rects == 3:
+        from scipy.ndimage import label
+
+        _, n_components = label(grid == rect_colors[0])
+        if n_components < 2:
+            return None
+    return grid
+
+
+def _is_safe_fg_dent_center(grid: np.ndarray, r: int, c: int, host: int, other: int) -> bool:
+    if int(grid[r, c]) != int(host):
+        return False
+    sub = _sub3x3(grid, r, c)
+    host_count = int(np.sum(sub == int(host))) - 1
+    return host_count >= DENT_MIN_HOST_3X3 and host_count > int(np.sum(sub == int(other)))
+
+
+def _is_safe_bg_dent_center(
+    grid: np.ndarray, r: int, c: int, colors: tuple[int, int], require_visible: bool
+) -> bool:
+    if int(grid[r, c]) != Color.BLACK:
+        return False
+    sub = _sub3x3(grid, r, c)
+    bg_count = int(np.sum(sub == Color.BLACK))
+    fg_count = int(np.sum(np.isin(sub, list(colors))))
+    color_counts = [int(np.sum(sub == int(color))) for color in colors]
+    if bg_count < BG_DENT_MIN_BG_3X3 or bg_count <= max(color_counts):
+        return False
+    if require_visible and fg_count < BG_DENT_MIN_VISIBLE_FG_3X3:
+        return False
+    return True
+
+
+def _would_form_2x2(grid: np.ndarray, r: int, c: int, color: int) -> bool:
+    h, w = grid.shape
+    for dr in (-1, 0):
+        for dc in (-1, 0):
+            rr, cc = r + dr, c + dc
+            if 0 <= rr < h - 1 and 0 <= cc < w - 1:
+                block = grid[rr : rr + 2, cc : cc + 2].copy()
+                block[r - rr, c - cc] = color
+                if int(np.sum(block == color)) == 4:
+                    return True
+    return False
+
+
+def _too_close(r: int, c: int, others: list[tuple[int, int]], distance: int) -> bool:
+    return any(max(abs(r - rr), abs(c - cc)) < distance for rr, cc in others)
+
+
+def _pick_dent_centers(
+    candidates: list[tuple[int, int]],
+    n: int,
+    rng: random.Random,
+    blocked: list[tuple[int, int]] | None = None,
+) -> list[tuple[int, int]] | None:
+    rng.shuffle(candidates)
+    chosen: list[tuple[int, int]] = []
+    blocked = [] if blocked is None else list(blocked)
+    for r, c in candidates:
+        if _too_close(r, c, blocked, DENT_PATCH_SEPARATION):
+            continue
+        if _too_close(r, c, chosen, DENT_PATCH_SEPARATION):
+            continue
+        chosen.append((r, c))
+        if len(chosen) >= n:
+            return chosen
+    return None
+
+
+def _expand_to_pairs(
+    dents: list[tuple[int, int]],
+    host: int,
+    other: int,
+    clean: np.ndarray,
+    blocked: list[tuple[int, int]],
+    rng: random.Random,
+) -> list[list[tuple[int, int]]]:
+    h, w = clean.shape
+    extra: list[tuple[int, int]] = []
+    result: list[list[tuple[int, int]]] = []
+    for r, c in dents:
+        cells = [(r, c)]
+        if rng.random() < DENT_PAIR_PROB:
+            neighbors = [(r + 1, c), (r - 1, c), (r, c + 1), (r, c - 1)]
+            rng.shuffle(neighbors)
+            for nr, nc in neighbors:
+                if not (0 <= nr < h and 0 <= nc < w):
+                    continue
+                if int(clean[nr, nc]) != int(host):
+                    continue
+                if not _is_safe_fg_dent_center(clean, nr, nc, host, other):
+                    continue
+                if _too_close(nr, nc, blocked, DENT_PATCH_SEPARATION):
+                    continue
+                if _too_close(nr, nc, [p for p in dents if p != (r, c)], DENT_PATCH_SEPARATION):
+                    continue
+                if _too_close(nr, nc, extra, DENT_PATCH_SEPARATION):
+                    continue
+                cells.append((nr, nc))
+                extra.append((nr, nc))
+                break
+        result.append(cells)
+    return result
+
+
+def _flatten_groups(groups: list[list[tuple[int, int]]]) -> list[tuple[int, int]]:
+    return [cell for cells in groups for cell in cells]
+
+
+def _choose_bg_dent_color(
+    clean: np.ndarray, r: int, c: int, colors: tuple[int, int], rng: random.Random
+) -> int:
+    nearby = [int(x) for x in _sub3x3(clean, r, c).flat if int(x) in colors]
+    if nearby:
+        return int(_Counter(nearby).most_common(1)[0][0])
+    return int(rng.choice(list(colors)))
+
+
+def _stamp_dents(
+    clean: np.ndarray,
+    dent_groups_a: list[list[tuple[int, int]]],
+    dent_groups_b: list[list[tuple[int, int]]],
+    bg_dents: list[tuple[int, int]],
+    color_a: int,
+    color_b: int,
+) -> np.ndarray:
+    h, w = clean.shape
+    output = clean.copy()
+    for dent_groups, stamp_color in ((dent_groups_a, color_b), (dent_groups_b, color_a)):
+        for cells in dent_groups:
+            for r, c in cells:
+                output[max(0, r - 1) : min(h, r + 2), max(0, c - 1) : min(w, c + 2)] = stamp_color
+    for r, c in bg_dents:
+        output[max(0, r - 1) : min(h, r + 2), max(0, c - 1) : min(w, c + 2)] = Color.BLACK
+    for cells in dent_groups_a + dent_groups_b:
+        for r, c in cells:
+            output[r, c] = Color.TEAL
+    for r, c in bg_dents:
+        output[r, c] = Color.TEAL
+    return output
+
+
+def _neighbor_cleanup_safe(inp: np.ndarray, r: int, c: int, host: int, other: int) -> bool:
+    h, w = inp.shape
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            nr, nc = r + dr, c + dc
+            if not (0 <= nr < h and 0 <= nc < w) or int(inp[nr, nc]) != int(host):
+                continue
+            nsub = _sub3x3(inp, nr, nc).copy()
+            nr0, nc0 = max(0, nr - 1), max(0, nc - 1)
+            nsub[r - nr0, c - nc0] = other
+            own_n = int(np.sum(nsub == int(host)))
+            other_n = int(np.sum(nsub == int(other)))
+            bg_n = int(np.sum(nsub == Color.BLACK))
+            if (other_n > own_n and other_n >= 5) or own_n <= 2 or (bg_n >= 5 and own_n <= 4):
+                return False
+    return True
+
+
+def _near_any_center(r: int, c: int, centers: list[tuple[int, int]], radius: int = 1) -> bool:
+    return any(max(abs(r - rr), abs(c - cc)) <= radius for rr, cc in centers)
+
+
+def _add_boundary_noise(
+    inp: np.ndarray,
+    clean: np.ndarray,
+    n_at_boundary: int,
+    color_a: int,
+    color_b: int,
+    protected_centers: list[tuple[int, int]],
+    rng: random.Random,
+) -> None:
+    h, w = clean.shape
+    boundary_candidates: list[tuple[int, int, int, int]] = []
+    for r in range(h):
+        for c in range(w):
+            v = int(clean[r, c])
+            if v not in (color_a, color_b):
+                continue
+            if _near_any_center(r, c, protected_centers):
+                continue
+            other = color_b if v == color_a else color_a
+            if int(np.sum(_sub3x3(clean, r, c) == other)) >= 1:
+                boundary_candidates.append((r, c, v, other))
+    rng.shuffle(boundary_candidates)
+
+    placed = 0
+    for r, c, host, other in boundary_candidates:
+        if placed >= n_at_boundary:
+            break
+        if int(inp[r, c]) != int(host):
+            continue
+        sub_now = _sub3x3(inp, r, c)
+        host_count = int(np.sum(sub_now == int(host)))
+        other_count = int(np.sum(sub_now == int(other)))
+        if host_count < BOUNDARY_MIN_HOST_3X3 or host_count - 1 <= other_count + 1:
+            continue
+        if _would_form_2x2(inp, r, c, other):
+            continue
+        if not _neighbor_cleanup_safe(inp, r, c, host, other):
+            continue
+        inp[r, c] = other
+        placed += 1
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    N = rng.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)
+    fg_pool = [c for c in Color.NOT_BLACK if c != Color.TEAL]
+    color_a, color_b = rng.sample(fg_pool, 2)
+
+    clean = _build_regions(N, color_a, color_b, rng)
+    if clean is None:
+        return None
+
+    n_fg_total = rng.randint(FG_DENT_COUNT_MIN, FG_DENT_COUNT_MAX)
+    n_a, n_b = n_fg_total // 2, n_fg_total - n_fg_total // 2
+    if rng.random() < 0.5:
+        n_a, n_b = n_b, n_a
+    n_bg = rng.randint(BG_DENT_COUNT_MIN, BG_DENT_COUNT_MAX)
+
+    h, w = clean.shape
+    valid_fg = {color_a: [], color_b: []}
+    valid_bg: list[tuple[int, int]] = []
+    for r in range(h):
+        for c in range(w):
+            v = int(clean[r, c])
+            if v == color_a and _is_safe_fg_dent_center(clean, r, c, color_a, color_b):
+                valid_fg[color_a].append((r, c))
+            elif v == color_b and _is_safe_fg_dent_center(clean, r, c, color_b, color_a):
+                valid_fg[color_b].append((r, c))
+            elif v == Color.BLACK and _is_safe_bg_dent_center(clean, r, c, (color_a, color_b), True):
+                valid_bg.append((r, c))
+
+    if len(valid_fg[color_a]) < n_a + 2 or len(valid_fg[color_b]) < n_b + 2:
+        return None
+    if len(valid_bg) < n_bg:
+        return None
+
+    dents_a = _pick_dent_centers(valid_fg[color_a], n_a, rng)
+    if dents_a is None:
+        return None
+    dents_b = _pick_dent_centers(valid_fg[color_b], n_b, rng, blocked=dents_a)
+    if dents_b is None:
+        return None
+
+    groups_a = _expand_to_pairs(dents_a, color_a, color_b, clean, dents_b, rng)
+    actual_a = _flatten_groups(groups_a)
+    groups_b = _expand_to_pairs(dents_b, color_b, color_a, clean, actual_a, rng)
+    actual_fg = actual_a + _flatten_groups(groups_b)
+
+    bg_dents = _pick_dent_centers(valid_bg, n_bg, rng, blocked=actual_fg)
+    if bg_dents is None:
+        return None
+
+    output = _stamp_dents(clean, groups_a, groups_b, bg_dents, color_a, color_b)
+
+    inp = clean.copy()
+    for cells in groups_a + groups_b:
+        for r, c in cells:
+            inp[r, c] = Color.BLACK
+    for r, c in bg_dents:
+        inp[r, c] = _choose_bg_dent_color(clean, r, c, (color_a, color_b), rng)
+
+    protected_centers = actual_fg + bg_dents
+    n_boundary_noise = rng.randint(BOUNDARY_NOISE_MIN, BOUNDARY_NOISE_MAX)
+    _add_boundary_noise(inp, clean, n_boundary_noise, color_a, color_b, protected_centers, rng)
+
+    try:
+        produced = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(produced, output):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        try:
+            grid = _gen_attempt(rng)
+        except Exception:
+            grid = None
+        if grid is not None:
+            return grid
+    raise RuntimeError("generate_input: failed after %d attempts" % MAX_GENERATION_ATTEMPTS)

