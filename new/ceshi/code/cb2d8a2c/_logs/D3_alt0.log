+    forbidden = np.zeros((h, w), dtype=bool)
+    for comp in bar_comps:
+        red_count = sum(1 for r, c in comp if g[r, c] == RED)
+        radius = int(red_count)
+
+        dist = np.full((h, w), -1, dtype=np.int16)
+        q = deque()
+        for r, c in comp:
+            dist[r, c] = 0
+            q.append((r, c))
+
+        while q:
+            r, c = q.popleft()
+            d = int(dist[r, c])
+            forbidden[r, c] = True
+            if d == radius:
