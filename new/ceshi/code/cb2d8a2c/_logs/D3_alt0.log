+
+def _reaches_opposite_edge(out: np.ndarray, edge: str) -> bool:
+    """Check that the solved path reaches the side opposite the starting edge."""
+    if edge == "top":
+        return bool(np.any(out[-1, :] == GREEN))
+    if edge == "bottom":
+        return bool(np.any(out[0, :] == GREEN))
+    if edge == "left":
+        return bool(np.any(out[:, -1] == GREEN))
