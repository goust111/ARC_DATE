def min_main_len(blues):
    last=blues[0]+2
    for a,b in zip(blues,blues[1:]):
        last+=a+b+2
    return last+2

def length_bounds(cross,b):
    lo=max(BAR_LEN_MIN,2*b-1,(BAR_CROSS_PCT_LO*cross+99)//100)
    hi=min(BAR_LEN_MAX,cross-b-1,(BAR_CROSS_PCT_HI*cross)//100)
    return None if lo>hi else (lo,hi)

def cand_range(cross,b,side):
    bounds=length_bounds(cross,b)
    if bounds is None: return []
    lo,hi=bounds
    if side==0:
        return list(range(lo+b+1, hi+b+2))
    return list(range(cross-hi-b-1, cross-lo-b))

def choose_turns(cross,blues,first_side):
    sides=[(first_side+i)%2 for i in range(len(blues))]
    cands=[cand_range(cross,b,s) for b,s in zip(blues,sides)]
    if any(not c for c in cands): return None
    cands=[random.sample(c,len(c)) for c in cands]
    ans=[]
    def bt(i):
        if i==len(blues): return True
        for x in cands[i]:
            if i>=1:
                prev=ans[i-1]
                if sides[i]==0:
                    if x < prev + TURN_MARGIN: continue
                else:
                    if x > prev - TURN_MARGIN: continue
            if i>=2:
                prev2=ans[i-2]
                if sides[i]==0:
                    if x > prev2 - NEST_MARGIN: continue
                else:
                    if x < prev2 + NEST_MARGIN: continue
            ans.append(x)
            if bt(i+1): return True
            ans.pop()
        return False
    return ans if bt(0) else None

def paint_bar(grid,row,side,length,b):
    colors=np.full(length,RED,dtype=int)
    colors[:2*b-1:2]=BLUE
    if side==0:
        grid[row,:length]=colors
    else:
        grid[row,grid.shape[1]-length:]=colors[::-1]

def build(main_size,cross,blues,first_side):
    base=min_main_len(blues)
    if main_size<base: return None
    grid=np.full((main_size,cross),BG,dtype=int)
    extras=[0]*(len(blues)+1)
    slack=main_size-base
    # compact cluster: put slack before first and after last mostly small
    for _ in range(slack):
        extras[random.randrange(len(extras))]+=1 if random.random()<0.3 else 0
    row=blues[0]+2+extras[0]
    rows=[row]
    for i in range(1,len(blues)):
        row += blues[i-1]+blues[i]+2 + extras[i]
        rows.append(row)
    turns=choose_turns(cross,blues,first_side)
    if turns is None: return None
    lengths=[]
