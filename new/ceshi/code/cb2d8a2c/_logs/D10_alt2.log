def min_main_len(blues):
    last=blues[0]+2
    for a,b in zip(blues,blues[1:]):
        last+=a+b+2
    return last+2

def length_bounds(cross,b):
    lo=max(BAR_LEN_MIN,2*b-1,(BAR_CROSS_PCT_LO*cross+99)//100)
    hi=min(BAR_LEN_MAX,cross-b-1,(BAR_CROSS_PCT_HI*cross)//100)
    return None if lo>hi else (lo,hi)

def cand_range(cross,b,side):
    bounds=length_bounds(cross,b)
    if bounds is None: return []
    lo,hi=bounds
    if side==0:
        return list(range(lo+b+1, hi+b+2))
    return list(range(cross-hi-b-1, cross-lo-b))

def choose_turns(cross,blues,first_side):
    sides=[(first_side+i)%2 for i in range(len(blues))]
    cands=[cand_range(cross,b,s) for b,s in zip(blues,sides)]
    if any(not c for c in cands): return None
    cands=[random.sample(c,len(c)) for c in cands]
    ans=[]
    def bt(i):
