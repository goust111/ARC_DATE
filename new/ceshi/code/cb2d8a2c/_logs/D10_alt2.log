NEST_MARGIN=2

def length_bounds(w,b):
    lo=max(BAR_LEN_MIN,2*b-1,(BAR_CROSS_PCT_LO*w+99)//100)
    hi=min(BAR_LEN_MAX,w-b-1,(BAR_CROSS_PCT_HI*w)//100)
    return None if lo>hi else (lo,hi)

def cand_range(w,b,side):
    bounds=length_bounds(w,b)
    if not bounds: return []
    lo,hi=bounds
    if side==0:
        return list(range(lo+b+1, hi+b+2))
    else:
        return list(range(w-hi-b-1, w-lo-b))

def search(w,blues,first_side):
    sides=[(first_side+i)%2 for i in range(len(blues))]
    cands=[cand_range(w,b,s) for b,s in zip(blues,sides)]
    if any(not c for c in cands): return None
    order=[]
