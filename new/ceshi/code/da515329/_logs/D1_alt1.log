+        r, c = cr, cc
+        cells = []
+        while inb(r + dr, c + dc) and grid[r + dr, c + dc] == 8:
+            r += dr
+            c += dc
+            cells.append((r, c))
+        if cells:
+            arms.append((d, cells))
+
+    agents = []
+    for outward, cells in arms:
+        agents.append(
+            {
+                "cur": cells[-1],
+                "dir": launch_dir_for_outward(outward),
+                "out_dir": outward,
+                "phase": "out_first" if len(cells) == 1 else None,
+                "done": False,
+                "p": 0,
+            }
+        )
+
+    def step_agent(agent) -> bool:
+        if agent["done"]:
+            return False
+
+        if agent["phase"] == "out_first":
