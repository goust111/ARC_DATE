+def _build_input(arm: int, size: int, cr: int, cc: int, dirs: tuple[tuple[int, int], ...]) -> np.ndarray:
+    """Build a square grid with a single teal T/L source around a black hub at (cr, cc)."""
+    grid = np.zeros((size, size), dtype=int)
+    for dr, dc in dirs:
