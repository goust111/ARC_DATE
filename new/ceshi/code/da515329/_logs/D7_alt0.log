_DIRS_URDL = [(-1,0),(0,1),(1,0),(0,-1)]

def raw(grid):
    grid = np.asarray(grid, dtype=int)
    h, w = grid.shape
    out = grid.copy()
    row_counts = np.sum(grid == 8, axis=1)
    col_counts = np.sum(grid == 8, axis=0)
    cr = int(np.argmax(row_counts))
    cc = int(np.argmax(col_counts))
    def inb(r,c): return 0<=r<h and 0<=c<w
    def is_border(r,c): return r==0 or r==h-1 or c==0 or c==w-1
    def add(pos,d,k=1): return (pos[0]+d[0]*k,pos[1]+d[1]*k)
    def right(d): return _DIRS_URDL[(_DIRS_URDL.index(d)+1)%4]
    def left(d): return _DIRS_URDL[(_DIRS_URDL.index(d)+3)%4]
    def spacing_ok(cell, prev, start):
        r,c = cell
        for nr,nc in neighbors4(r,c):
            if inb(nr,nc) and out[nr,nc] "'!= 0 and (nr,nc)!=prev and (nr,nc)!=start:
                return False
        return True
    def can_move(cur,d,length):
        prev = cur
        for t in range(1,length+1):
            rr,cc2 = add(cur,d,t)
            if not inb(rr,cc2) or out[rr,cc2] != 0: return False
            if not spacing_ok((rr,cc2), prev, cur): return False
            prev = (rr,cc2)
        return True
    def do_move(agent,d,length):
        r0,c0 = agent['"'cur']
        for t in range(1,length+1):
            rr,cc2 = r0 + d[0]*t, c0 + d[1]*t
            out[rr,cc2] = 8
        agent['cur'] = (r0 + d[0]*length, c0 + d[1]*length)
    arms=[]
    for d in _DIRS_URDL:
        dr,dc=d;r,c=cr,cc;cells=[]
        while inb(r+dr,c+dc) and grid[r+dr,c+dc]==8:
            r += dr; c += dc; cells.append((r,c))
        if cells: arms.append((d,cells))
    agents=[]
    for outward,cells in arms:
        agents.append({'cur': cells[-1], 'dir': right(outward), 'out_dir': outward, 'phase':'out_first' if len(cells)==1 else None, 'done':False, 'p':0})
    def step_agent(agent):
        if agent['done']: return False
        if agent['phase']=='out_first':
            if can_move(agent['cur'], agent['out_dir'], 1):
                do_move(agent, agent['out_dir'], 1)
            agent['phase']=None; agent['dir']=right(agent['out_dir']); agent['p']=0
            return True
        cur=agent['cur']; dirs=[right(agent['dir']), agent['dir']]
        if not is_border(*cur): dirs.append(left(agent['dir']))
        for nd in dirs:
            turned = nd "'!= agent['"'dir']
            length = 1 if turned else (2 if agent['p']==0 else 1)
            if can_move(agent['cur'], nd, length):
                do_move(agent, nd, length); agent['p'] = 1 if (agent['p']==0 and turned) else 0; agent['dir']=nd; return True
            if not turned and length==2 and can_move(agent['cur'], nd, 1):
                do_move(agent, nd, 1); agent['p']=0; return True
        agent['done']=True; return False
    changed=True; guard=0
    while changed and guard<200000:
        changed=False; guard+=1
        for ag in agents:
            if step_agent(ag): changed=True
        if all(ag['done'] for ag in agents): break
    return out

for arm in [1,2,3,4]:
    size = 4*arm + 2*((arm+1)//2) + 6
    cr=cc=(2*arm+2 + size - 2*arm - 2 -1)//2
    inp = mod._build_input(arm,size,cr,cc)
    out = raw(inp)
    print('arm',arm,'fill',np.mean(out==8))
    print(out)
    print()
