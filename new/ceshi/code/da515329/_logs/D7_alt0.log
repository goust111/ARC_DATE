+        + np.sum(out[-1] == CROSS_COLOR)
+        + np.sum(out[1:-1, 0] == CROSS_COLOR)
+        + np.sum(out[1:-1, -1] == CROSS_COLOR)
+    )
+    return float(np.mean(out == CROSS_COLOR)), used_radius, border_ink
