+        return 0 <= r < h and 0 <= c < w
+
+    def is_border(r: int, c: int) -> bool:
+        return r == 0 or r == h - 1 or c == 0 or c == w - 1
+
+    def add(pos, d, k=1):
+        return (pos[0] + d[0] * k, pos[1] + d[1] * k)
+
+    arms = []
+    for d in _DIRS_URDL:
+        dr, dc = d
+        r, c = cr, cc
+        cells = []
+        while inb(r + dr, c + dc) and grid[r + dr, c + dc] == 8:
+            r += dr
+            c += dc
+            cells.append((r, c))
+        if cells:
