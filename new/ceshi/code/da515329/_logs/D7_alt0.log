+    ring_count = _rings_from_arm(arm_len)
+    limit_radius = arm_len + 2 * ring_count
+    limit_r0 = cr - limit_radius
+    limit_r1 = cr + limit_radius
+    limit_c0 = cc - limit_radius
+    limit_c1 = cc + limit_radius
