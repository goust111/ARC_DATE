+def _output_metrics(inp: np.ndarray, out: np.ndarray) -> tuple[float, int, int]:
+    cr = int(np.argmax(np.sum(inp == CROSS_COLOR, axis=1)))
+    cc = int(np.argmax(np.sum(inp == CROSS_COLOR, axis=0)))
