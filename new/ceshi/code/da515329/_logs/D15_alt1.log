import numpy as np, math
from arc_utils import neighbors4
_DIRS=[(-1,0),(0,1),(1,0),(0,-1)]
LEFT_COLOR=2
RIGHT_COLOR=4

def right(d): return _DIRS[(_DIRS.index(d)+1)%4]
def left(d): return _DIRS[(_DIRS.index(d)+3)%4]
def add(pos,d,k=1): return (pos[0]+d[0]*k,pos[1]+d[1]*k)

def build_input(arm,size,cr,cc):
    g=np.zeros((size,size),dtype=int)
    offs=np.arange(1,arm+1)
    g[cr-offs,cc]=8; g[cr+offs,cc]=8; g[cr,cc-offs]=8; g[cr,cc+offs]=8
    return g

def plan(inp):
    grid=np.asarray(inp,dtype=int)
    h,w=grid.shape
    inp2=grid.copy()
    out=grid.copy()
    row_counts=np.sum(grid==8,axis=1); col_counts=np.sum(grid==8,axis=0)
    cr=int(np.argmax(row_counts)); cc=int(np.argmax(col_counts))
    def inb(r,c): return 0<=r<h and 0<=c<w
    def is_border(r,c): return r==0 or r==h-1 or c==0 or c==w-1
    def occupied(r,c): return out[r,c]==8
    def spacing_ok(cell, prev, start, extra_allowed=()):
        r,c=cell; allow=set(extra_allowed)
        for nr,nc in neighbors4(r,c):
            if (nr,nc) in allow:
                continue
            if inb(nr,nc) and occupied(nr,nc) and (nr,nc)"'!=prev and (nr,nc)!=start:
                return False
        return True
    def can_move(cur,d,length):
        prev=cur
        for t in range(1,length+1):
            rr,cc2=add(cur,d,t)
            if not inb(rr,cc2) or occupied(rr,cc2):
                return False
            if not spacing_ok((rr,cc2), prev, cur):
                return False
            prev=(rr,cc2)
        return True
    def can_turn(cur,d,turn_dir):
        mid=add(cur,d,1)
        nd=right(d) if turn_dir=='"'R' else left(d)
        fin=add(mid,nd,1)
        if not inb(*mid) or not inb(*fin):
            return False
        if occupied(*mid) or occupied(*fin):
            return False
        # marker cell only needs to avoid existing teal, aside from current/final chain
        if not spacing_ok(mid, cur, cur, extra_allowed=(fin,)):
            return False
        if not spacing_ok(fin, mid, cur):
            return False
        return True
    def paint(cells):
        for r,c in cells: out[r,c]=8
    arms=[]
    for d in _DIRS:
        dr,dc=d; r,c=cr,cc; cells=[]
        while inb(r+dr,c+dc) and grid[r+dr,c+dc]==8:
            r+=dr;c+=dc;cells.append((r,c))
        if cells: arms.append((d,cells))
    agents=[]
    for outward,cells in arms:
        agents.append({'cur':cells[-1],'dir':right(outward),'out_dir':outward,'phase':'out_first' if len(cells)==1 else None,'done':False,'p':0})
    counts={'L':0,'R':0}
    def step_agent(agent):
        if agent['done']: return False
        if agent['phase']=='out_first':
            if can_move(agent['cur'],agent['out_dir'],1):
                pos=add(agent['cur'],agent['out_dir'],1); paint([pos]); agent['cur']=pos
            agent['phase']=None; agent['dir']=right(agent['out_dir']); agent['p']=0; return True
        cur=agent['cur']; d=agent['dir']
        if can_turn(cur,d,'R'):
            mid=add(cur,d,1); fin=add(mid,right(d),1)
            inp2[mid]=RIGHT_COLOR; paint([mid,fin]); agent['cur']=fin; agent['dir']=right(d); agent['p']=1 if agent['p']==0 else 0; counts['R']+=1; return True
        straight_len=2 if agent['p']==0 else 1
        if can_move(cur,d,straight_len):
            cells=[add(cur,d,t) for t in range(1,straight_len+1)]; paint(cells); agent['cur']=cells[-1]; agent['p']=0; return True
        if (not is_border(*cur)) and can_turn(cur,d,'L'):
            mid=add(cur,d,1); fin=add(mid,left(d),1)
            inp2[mid]=LEFT_COLOR; paint([mid,fin]); agent['cur']=fin; agent['dir']=left(d); agent['p']=1 if agent['p']==0 else 0; counts['L']+=1; return True
        if straight_len==2 and can_move(cur,d,1):
            pos=add(cur,d,1); paint([pos]); agent['cur']=pos; agent['p']=0; return True
        agent['done']=True; return False
    changed=True; guard=0
    while changed and guard<200000:
        guard+=1; changed=False
        for ag in agents:
            if step_agent(ag): changed=True
        if all(ag['done'] for ag in agents): break
    return inp2,out,counts

for arm in [1,2,3,4]:
    size=4*arm+2*math.ceil(arm/2)+6
    lo=2*arm+2; hi=size-2*arm-2-1
    vals=[]
    for cr in range(lo, hi+1):
        for cc in range(lo, hi+1):
            inp,out,c=plan(build_input(arm,size,cr,cc))
            vals.append((np.mean(out==8),c['L'],c['R'],cr,cc,np.mean(inp"'!=0)))
    both=[v for v in vals if v[1]>0 and v[2]>0]
    both.sort(key=lambda x:(abs(x[0]-0.47), -x[1]-x[2]))
    print('"'arm',arm,'both',len(both),'best',both[:5])
