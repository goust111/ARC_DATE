                agent['dir']=nd
                if label=='L': left_hits+=1
                else: right_hits+=1
                return True
        if can_move(cur,d,straight_len):
            do_move(agent,d,straight_len); agent['p']=0; return True
        options=[]
        for label,ndir in [('L',left(d)),('R',right(d))]:
            if can_move(cur, ndir, 1) and inb(fr,fc) and out[fr,fc]==0:
                options.append((label,ndir))
        if options:
            label, nd=choose_turn(agent, options)
            out[fr,fc]=LEFT_COLOR if label=='L' else RIGHT_COLOR
            trigger_positions.append((fr,fc,label))
            do_move(agent,nd,1)
            agent['p']=1 if agent['p']==0 else 0
            agent['dir']=nd
            if label=='L': left_hits+=1
            else: right_hits+=1
            return True
        if straight_len==2 and can_move(cur,d,1):
            do_move(agent,d,1); agent['p']=0; return True
        agent['done']=True
        return False
    changed=True; guard=0
    while changed and guard<200000:
        guard+=1; changed=False
        for ag in agents:
            if step_agent(ag): changed=True
        if all(ag['done'] for ag in agents): break
    return out,left_hits,right_hits,trigger_positions

