+    def spacing_ok(cell, prev, start) -> bool:
+        r, c = cell
+        for nr, nc in neighbors4(r, c):
+            if _inb(h, w, nr, nc) and occ[nr, nc] and (nr, nc) != prev and (nr, nc) != start:
+                return False
+        return True
