+
+def _inb(h: int, w: int, r: int, c: int) -> bool:
+    return 0 <= r < h and 0 <= c < w
+
+
+def _right(d):
+    return _DIRS_URDL[(_DIRS_URDL.index(d) + 1) % 4]
+
+
+def _left(d):
