+    def can_move(cur, d, length: int) -> bool:
+        prev = cur
+        for t in range(1, length + 1):
+            rr, cc2 = _add(cur, d, t)
+            if not _inb(h, w, rr, cc2) or occ[rr, cc2]:
+                return False
+            if not spacing_ok((rr, cc2), prev, cur):
+                return False
+            prev = (rr, cc2)
+        return True
