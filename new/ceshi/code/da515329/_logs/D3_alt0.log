+                "center": (cr, cc),
+                "color": color,
+                "arms": arms,
+                "arm_len": arm_len,
+            }
+            if best is None or arm_len > best["arm_len"]:
+                best = cand
+
+    if best is None:
+        raise ValueError("failed to detect hollow cross")
+    return best
+
