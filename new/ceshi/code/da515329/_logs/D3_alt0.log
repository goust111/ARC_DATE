+
+def _solve_geometry(grid: np.ndarray, cross: dict) -> np.ndarray:
+    h, w = grid.shape
+    cr, cc = cross["center"]
+    arm_len = cross["arm_len"]
+    arms = cross["arms"]
+    even_center = (cr + cc) % 2 == 0
