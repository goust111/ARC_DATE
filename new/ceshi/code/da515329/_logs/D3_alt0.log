+    def do_move(agent, d, length: int) -> None:
+        r0, c0 = agent["cur"]
+        agent["trail_len"] += length
+        for t in range(1, length + 1):
+            rr, cc2 = r0 + d[0] * t, c0 + d[1] * t
+            occ[rr, cc2] = True
+        agent["cur"] = (r0 + d[0] * length, c0 + d[1] * length)
+
