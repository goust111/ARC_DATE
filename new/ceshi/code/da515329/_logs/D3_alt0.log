+# --- CFG ---------------------------------------------------------------
+ARM_LEN_MIN, ARM_LEN_MAX = 1, 4
+GRID_SIZE_BASE = 6
+TIP_GAP_MIN = 2
+FILL_LO, FILL_HI = 0.48, 0.52
+MAX_OUTER_RETRIES = 300
+CROSS_COLOR = 8
+SECONDARY_COLORS = (1, 2, 3, 4, 6, 7)
+LEGEND_TOP = 0
+LEGEND_LEFT = 0
+LEGEND_GAP = 1
+MIN_SECONDARY_PIXELS = 10
+# --- end CFG -----------------------------------------------------------
