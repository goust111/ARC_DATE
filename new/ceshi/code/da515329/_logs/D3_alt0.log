+                "cur": cells[-1],
+                "dir": _right(outward),
+                "out_dir": outward,
+                "phase": "out_first" if len(cells) == 1 else None,
+                "done": False,
+                "p": 0,
+                "trail_len": 0,
+            }
+        )
+
+    def step_agent(agent) -> bool:
+        if agent["done"]:
+            return False
