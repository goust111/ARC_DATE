+        for idx, (r, c) in enumerate(path):
+            out[r, c] = cycle[idx % len(cycle)]
+
+    leftover = np.argwhere(occ & (out == 0))
+    if leftover.size:
+        for r, c in leftover:
+            out[r, c] = cycle[0]
+
+    return out
