from collections import Counter

_DIRS_URDL=[(-1,0),(0,1),(1,0),(0,-1)]

def neighbors4(r,c):
    yield r-1,c; yield r+1,c; yield r,c-1; yield r,c+1

def right(d): return _DIRS_URDL[(_DIRS_URDL.index(d)+1)%4]
def left(d): return _DIRS_URDL[(_DIRS_URDL.index(d)+3)%4]

def find_crosses(grid):
    h,w=grid.shape
    out=[]
    seen=set()
    for r in range(1,h-1):
        for c in range(1,w-1):
            if grid[r,c]"'!=0: continue
            lens=[]; arms=[]
            ok=True
            for dr,dc in _DIRS_URDL:
                rr,cc=r+dr,c+dc
                if grid[rr,cc]!=8:
                    ok=False; break
                cells=[]
                while 0<=rr<h and 0<=cc<w and grid[rr,cc]==8:
                    cells.append((rr,cc))
                    rr+=dr; cc+=dc
                lens.append(len(cells)); arms.append(cells)
            if not ok or min(lens)<=0 or len(set(lens))!=1:
                continue
            sig=(r,c,tuple(lens))
            if sig in seen: continue
            seen.add(sig)
            out.append({'"'center':(r,c),'arm_len':lens[0],'arms':dict(zip(_DIRS_URDL,arms))})
    out.sort(key=lambda x:x['center'])
    return out

def solve(grid, want_meta=False):
    grid=np.asarray(grid,int)
    h,w=grid.shape
    out=grid.copy()
