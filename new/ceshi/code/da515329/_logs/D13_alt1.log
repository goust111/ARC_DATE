+        if occ != -1:
+            if occ != src:
+                return "occupied_other"
+            if (r, c) != prev and (r, c) != start:
+                return "occupied_self"
+        for nr, nc in neighbors4(r, c):
+            if not inb(nr, nc) or (nr, nc) == prev or (nr, nc) == start:
+                continue
+            occ2 = owner[nr, nc]
+            if occ2 != -1:
+                return "adj_other" if occ2 != src else "adj_self"
