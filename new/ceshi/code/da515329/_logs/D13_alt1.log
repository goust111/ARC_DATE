    size=choose_size(arm)
    num=2 if arm==4 else random.choice([2,3])
    lo,hi=arm+1,size-arm-2
    if lo>hi: return None
    candidates=[(r,c) for r in range(lo,hi+1) for c in range(lo,hi+1)]
    random.shuffle(candidates)
