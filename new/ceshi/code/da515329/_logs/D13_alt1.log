    crosses=find_crosses(grid)
    for idx,c in enumerate(crosses):
        for cells in c['arms'].values():
            for r,cc in cells:
                owner[r,cc]=idx
    def inb(r,c): return 0<=r<h and 0<=c<w
    def is_border(r,c): return r==0 or r==h-1 or c==0 or c==w-1
    def add(pos,d,k=1): return (pos[0]+d[0]*k,pos[1]+d[1]*k)
    def conflict(cell, prev, start, src):
        r,c=cell
        occ=owner[r,c]
        if occ"'!=-1 and occ!=src: return '"'occupied_other'
        if occ==src and (r,c)"'!=prev and (r,c)!=start: return '"'occupied_self'
        for nr,nc in neighbors4(r,c):
            if inb(nr,nc) and (nr,nc)"'!=prev and (nr,nc)!=start:
                occ2=owner[nr,nc]
                if occ2!=-1:
                    return '"'adj_other' if occ2"'!=src else '"'adj_self'
        return None
    events=Counter()
    agents=[]
    for idx,cross in enumerate(crosses):
        for outward in _DIRS_URDL:
            cells=cross['arms'][outward]
            agents.append({'src':idx,'cur':cells[-1],'dir':right(outward),'out_dir':outward,'phase':'out_first' if len(cells)==1 else None,'done':False,'p':0})
    def can_move(agent,d,length):
        prev=agent['cur']
        saw_other=False
        for t in range(1,length+1):
            rr,cc=add(agent['cur'],d,t)
            if not inb(rr,cc): return False,'border'
            reason=conflict((rr,cc),prev,agent['cur'],agent['src'])
            if reason:
                return False,reason
            prev=(rr,cc)
        return True,None
    def do_move(agent,d,length):
        r0,c0=agent['cur']
        for t in range(1,length+1):
            rr,cc=r0+d[0]*t,c0+d[1]*t
            out[rr,cc]=8; owner[rr,cc]=agent['src']
        agent['cur']=(r0+d[0]*length,c0+d[1]*length)
    def step_agent(agent):
        if agent['done']: return False
        if agent['phase']=='out_first':
            ok,reason=can_move(agent,agent['out_dir'],1)
            if ok: do_move(agent,agent['out_dir'],1)
            elif reason and 'other' in reason: events['phase_block_other']+=1
            agent['phase']=None; agent['dir']=right(agent['out_dir']); agent['p']=0
