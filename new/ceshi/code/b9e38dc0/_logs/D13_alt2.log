+    v_lo, v_hi = side_vs[0], side_vs[-1]
+    for v in range(v_lo, v_hi + 1):
+        assert (0, v) in local_pts, "expected contiguous cap across marked side"
+    return side_value, local_pts, v_lo, v_hi
+
+
+def main(grid: np.ndarray) -> np.ndarray:
