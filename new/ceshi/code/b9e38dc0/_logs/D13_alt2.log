+def _cap_local_wall(wall, gap):
+    pts = set(wall)
+    for v in range(gap + 1):
+        pts.add((0, v))
+    return pts
+
+
+def _map_local(u, v, rad, anchor):
+    r0, c0 = anchor
+    if rad == (-1, 0):
+        return r0 + u, c0 + v
+    if rad == (1, 0):
+        return r0 - u, c0 + v
+    if rad == (0, -1):
+        return r0 + v, c0 + u
+    return r0 + v, c0 - u
