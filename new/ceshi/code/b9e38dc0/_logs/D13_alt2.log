+    for r, c in wall_comp:
+        comp_mask[r, c] = True
+
+    rad, marker_cells = _find_marker_direction(g, bg, wall, fill, wall_comp)
+    side_value, local_pts, v_lo, v_hi = _wall_side_info(wall_comp, rad)
+    tip_12 = (1, v_lo) in local_pts and (1, v_hi) in local_pts
+
+    barrier = comp_mask.copy()
+    virtual_opening = np.zeros_like(comp_mask, dtype=bool)
+    for v in range(v_lo + 1, v_hi):
+        if rad == (-1, 0):
+            rr, cc = side_value, v
+        elif rad == (1, 0):
+            rr, cc = side_value, v
+        elif rad == (0, -1):
+            rr, cc = v, side_value
+        else:
+            rr, cc = v, side_value
+        barrier[rr, cc] = False
+        virtual_opening[rr, cc] = True
