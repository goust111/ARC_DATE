+# -- Configuration constants --------------------------------------------------
+# Canvas size bounds
+GRID_H_VERT = (11, 18)
+GRID_H_HORIZ = (8, 18)
+GRID_W = (15, 19)
+
+# Final wall size after capping the former mouth
+WALL_PIXELS_MIN = 17
+WALL_PIXELS_MAX = 25
+DEPTH_VERT = (5, 8)
+DEPTH_HORIZ = (5, 8)
+GAP_VERT = (6, 7)
+GAP_HORIZ = (5, 7)
