+        return None
+    if _variant_delta(grid) < MIN_VARIANT_DELTA:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
