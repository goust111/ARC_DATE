+
+def _find_obstacle_candidates(grid: np.ndarray, bg: int, wall_mask: np.ndarray, nominal_fill_zone: np.ndarray) -> tuple[list[tuple[int, int]], list[tuple[int, int]]]:
+    dist = distance_transform_cdt(~wall_mask, metric="taxicab")
