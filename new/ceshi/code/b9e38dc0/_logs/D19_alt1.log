+            comp = {(int(r), int(c)) for r, c in pts}
+            if len(comp) < WALL_COMPONENT_MIN:
+                continue
+            if len(_degree1_pixels(comp)) != 2:
+                continue
+            comps.append({"color": color, "points": comp})
+    return comps
