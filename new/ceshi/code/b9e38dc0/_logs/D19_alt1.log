+def _min_pair_dist(a: list[tuple[int, int]], b: set[tuple[int, int]]) -> int:
+    best = 10**9
+    for r, c in a:
+        for rr, cc in b:
+            d = abs(r - rr) + abs(c - cc)
+            if d < best:
+                best = d
+                if best == 0:
