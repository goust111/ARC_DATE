+        return None
+
+    metrics = analyze_primary_fence(grid)
+    if metrics["opening_count"] < 2:
+        return None
+
+    new_fill = (out == fill_color) & (grid == bg)
+    if int(new_fill.sum()) < MIN_NEW_FILL:
+        return None
+    if not _expected_borders_hit(new_fill, opening_info["expected_borders"]):
+        return None
+    if _border_fill_count(new_fill) < 2:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
