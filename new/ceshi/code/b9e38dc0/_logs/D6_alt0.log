+def _border_fill_count(mask: np.ndarray) -> int:
+    count = 0
+    count += int(mask[0, :].any())
+    count += int(mask[-1, :].any())
+    count += int(mask[:, 0].any())
+    count += int(mask[:, -1].any())
+    return count
+
