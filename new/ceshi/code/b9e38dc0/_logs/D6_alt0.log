+    def comp_min_dist(comp: set[tuple[int, int]]) -> int:
+        best = 10**9
+        for r, c in fill_pos:
+            for wr, wc in comp:
+                d = abs(r - wr) + abs(c - wc)
+                if d < best:
+                    best = d
+                    if best == 0:
+                        return 0
+        return best
