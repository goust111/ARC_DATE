+def _false_runs(values: list[bool]) -> list[tuple[int, int]]:
+    runs: list[tuple[int, int]] = []
+    i = 0
+    while i < len(values):
+        if values[i]:
+            i += 1
+            continue
+        j = i
+        while j + 1 < len(values) and not values[j + 1]:
+            j += 1
+        runs.append((i, j))
+        i = j + 1
