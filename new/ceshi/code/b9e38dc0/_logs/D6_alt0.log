+    for _ in range(80):
+        len_a = random.randint(*OPEN_LEN)
+        len_b = random.randint(*OPEN_LEN)
+        a0 = random.randint(1, length - len_a - 2)
+        b0 = random.randint(1, length - len_b - 2)
+        a1 = a0 + len_a - 1
+        b1 = b0 + len_b - 1
+        if max(a0, b0) <= min(a1, b1):
