+        )
+
+    bottom = [bool(comp_mask[r1, c]) for c in range(c0, c1 + 1)]
+    for a, b in _false_runs(bottom):
+        if a == 0 or b == len(bottom) - 1:
+            continue
+        openings.append(
+            {
+                "side": "bottom",
+                "rad": (1, 0),
+                "span": (c0 + a, c0 + b),
