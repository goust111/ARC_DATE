+SEED_DEPTH_LOOKBACK = 3
+
+# Movers (formerly static obstacles)
+MAX_MOVERS = 4
+MOVER_MIN_TRAVEL = 3
+MOVER_MIN_WALL_DIST = 3
+REFLECT_REQUIRED = 1
