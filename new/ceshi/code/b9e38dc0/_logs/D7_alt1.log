+def _turn_on_reflection(
+    cur: tuple[int, int],
+    hit: tuple[int, int],
+    d: tuple[int, int],
+    sprite_mask: np.ndarray,
+) -> tuple[int, int] | None:
+    h, w = sprite_mask.shape
