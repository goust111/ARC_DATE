+    rows = np.where(sprite_mask[:, hit[1]])[0]
+    if len(rows) == 0:
+        return None
+    mid = (int(rows[0]) + int(rows[-1])) / 2.0
+    pref = -1 if hit[0] <= mid else 1
+    for dr in (pref, -pref):
+        nr, nc = cur[0] + dr, cur[1]
+        if 0 <= nr < h and 0 <= nc < w and not sprite_mask[nr, nc]:
+            return int(dr), 0
+    return None
