+    n_reflect_target = 1 + (1 if len(reflect) > 1 and random.random() < 0.45 else 0)
+    if try_take(reflect, n_reflect_target) < REFLECT_REQUIRED:
+        return None
+
+    if straight and random.random() < STRAIGHT_BONUS_PROB:
