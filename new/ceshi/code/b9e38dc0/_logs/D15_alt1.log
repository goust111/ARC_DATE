+# --------------- generator ---------------
+
+# Canvas size bounds
+GRID_H_VERT = (11, 18)
+GRID_H_HORIZ = (8, 18)
+GRID_W = (15, 19)
+
+# Wall geometry
+WALL_PIXELS_MIN = 17
+WALL_PIXELS_MAX = 25
+DEPTH_VERT = (5, 10)
+DEPTH_HORIZ = (6, 8)
+GAP_VERT = (6, 7)
+GAP_HORIZ = (5, 7)
+TIP_12_PROB = 0.5
+
+# Placement margins
+OPEN_END_MARGIN = 3
+
+# Fill seed
+SEED_SIZE_WEIGHTS = [1]  # singleton seeds keep checkerboard phase visible
+SEED_DEPTH_LOOKBACK = 3
+
+# Obstacles
+MAX_OBSTACLES = 5
+OBSTACLE_IN_FILL_PROB = 0.65
+OBSTACLE_MIN_SEP = 2
+
+# Validation
+MIN_TOTAL_FILLED = 20
+MIN_VISIBLE_FILL = 12
+MIN_INTERIOR_CELLS = 10
+MIN_CHECKER_FILL = 4
+MIN_CHECKER_BG = 4
+MIN_RAY_FILL = 6
+PALETTE_SIZE = (3, 5)
+GEN_RETRIES = 300
