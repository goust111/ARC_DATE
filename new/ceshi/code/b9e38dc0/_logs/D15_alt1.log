+    if int(checker_fill_visible.sum()) < MIN_CHECKER_FILL:
+        return None
+    if int(checker_bg_visible.sum()) < MIN_CHECKER_BG:
+        return None
+    if int(ray_fill_visible.sum()) < MIN_RAY_FILL:
