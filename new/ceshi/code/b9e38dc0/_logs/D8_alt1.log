import numpy as np

from arc_utils import neighbors4, neighbors8, components_mask, get_bg
import random

def main(grid: np.ndarray) -> np.ndarray:
    """
    Swap the colors of the filled plume and its enclosing border after the usual flood-fill geometry is found.

    Input structure:
    - bg = most common color. The dominant non-bg color is a partial wall that forms a funnel-like border.
    - A smaller seed-colored blob sits inside that border near the closed end; other non-bg pixels are obstacles.
    Rule:
    - Find the same reachable interior + radiated region as in the base task, with the same obstacle shadows.
    - Then swap the border/fill roles in the output: the reachable region becomes wall-colored, and the chosen wall border becomes seed-colored.

    Key insight: The geometry is still determined entirely by the wall endpoints and obstacle shadows; the variant only changes which of the two salient colors paints the border versus the filled plume.
    """
    g = np.array(grid, copy=True)
    h, w = g.shape

    vals = np.unique(g)
    bg = get_bg(g)

    non_bg = [int(v) for v in vals if int(v) != bg]
    assert non_bg, "expected at least one non-background color"

    # Wall: most frequent non-background color.
    wall = max(non_bg, key=lambda c: int((g == c).sum()))

    wall_mask = g == wall

    # Wall connected components (8-neigh).
    comps = [set((int(r), int(c)) for r, c in pts) for pts in components_mask(wall_mask, connectivity=8)]
    assert comps, "expected at least one wall connected component"

    def sgn(x: int) -> int:
        return (x > 0) - (x < 0)

    other_colors = [c for c in non_bg if c != wall]
    assert other_colors, "expected at least one non-wall color (fill color)"

    # Pick fill color as the non-wall color closest (Manhattan distance) to the wall pixels.

