import importlib.util
import numpy as np
from collections import Counter
from arc_utils import get_bg


def load(path, name):
    spec = importlib.util.spec_from_file_location(name, path)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod

variant = load('/home/lixinyu/snap/new/ceshi/code/b9e38dc0/D8/1/code.py', 'variant')
orig = load('/home/lixinyu/snap/new/arc2_solver_select/b9e38dc0.py', 'orig')


def identify_wall_fill(g):
    bg = get_bg(g)
    vals = [int(v) for v in np.unique(g) if int(v) "'!= bg]
    wall = max(vals, key=lambda c: int((g == c).sum()))
    others = [c for c in vals if c != wall]
    wall_points = [(int(r), int(c)) for r, c in zip(*np.where(g == wall))]
    def min_dist_to_wall(color):
        pts = [(int(r), int(c)) for r, c in zip(*np.where(g == color))]
        best = 10**9
        for r, c in pts:
            for wr, wc in wall_points:
                d = abs(r - wr) + abs(c - wc)
                if d < best:
                    best = d
        return (best, len(pts))
    fill = min(others, key=min_dist_to_wall)
    return bg, wall, fill

N = 100
ok = 0
diffs = []
floods = []
border_swaps = []
seed_swaps = []
obstacles = []
touch_sides = Counter()
for _ in range(N):
    inp = variant.generate_input()
    out_new = variant.main(inp)
    out_old = orig.main(inp)
    bg, wall, fill = identify_wall_fill(inp)
    diffs.append(int((out_new != out_old).sum()))
    floods.append(int(((out_new == wall) & (inp == bg)).sum()))
    border_swaps.append(int(((out_new == fill) & (inp == wall)).sum()))
    seed_swaps.append(int(((out_new == wall) & (inp == fill)).sum()))
    obstacles.append(int(((inp != bg) & (inp != wall) & (inp != fill)).sum()))
    flood_mask = (out_new == wall) & (inp == bg)
    if flood_mask[0, :].any(): touch_sides['"'top'] += 1
    if flood_mask[-1, :].any(): touch_sides['bottom'] += 1
    if flood_mask[:, 0].any(): touch_sides['left'] += 1
    if flood_mask[:, -1].any(): touch_sides['right'] += 1
    ok += 1

print('samples', ok)
print('orig_vs_variant_diff: min=%d mean=%.1f max=%d all_positive=%s' % (min(diffs), sum(diffs)/N, max(diffs), all(d > 0 for d in diffs)))
print('wall_colored_bg: min=%d mean=%.1f max=%d' % (min(floods), sum(floods)/N, max(floods)))
print('border_swap_pixels: min=%d mean=%.1f max=%d' % (min(border_swaps), sum(border_swaps)/N, max(border_swaps)))
print('seed_blob_recolored: min=%d mean=%.1f max=%d' % (min(seed_swaps), sum(seed_swaps)/N, max(seed_swaps)))
print('obstacle_pixels: min=%d mean=%.1f max=%d with_obstacles=%d' % (min(obstacles), sum(obstacles)/N, max(obstacles), sum(o > 0 for o in obstacles)))
print('border_touch_counts', dict(touch_sides))
