+
+    for group in groups_b.values():
+        if len(group) >= 2:
+            group = sorted(group)
+            draw_segment(group[0], group[-1])
+
+    for (r0, c0, tcol), dirs in triggers.items():
+        for ddr, ddc in dirs:
+            r, c = r0 + ddr, c0 + ddc
