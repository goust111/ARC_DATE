   152	            if not (0 <= r < h and 0 <= c < w):
   153	                return True
   154	    return False
   155	
   156	
   157	def main(grid: np.ndarray) -> np.ndarray:
   158	    """
   159	    Connect blue diagonal endpoint pairs and complete trigger rays on an expanded canvas.
   160	
   161	    Input structure:
   162	    - The background is the most common color. One non-background color forms endpoint pairs on 45-degree diagonals, and differently-colored trigger pixels may lie on those same diagonals.
   163	
   164	    Rule:
   165	    - Fill each diagonal segment between the extreme same-color endpoints.
   166	    - Whenever such a segment passes through a trigger pixel, emit the perpendicular diagonal rays in the trigger color.
   167	    - Each perpendicular ray runs for as many steps as the blue segment length; if those completed rays leave the input rectangle, enlarge the output grid with background padding so the full result fits.
   168	
   169	    Key insight:
   170	    - The trigger does not use the current border as its stopping signal anymore; its full reach is determined by the visible length of the segment that activates it, and the canvas expands afterward to hold that completed geometry.
   171	    """
   172	
   173	    grid = np.asarray(grid, dtype=int)
   174	    h, w = grid.shape
   175	    bg = get_bg(grid)
   176	
   177	    non_bg = [(r, c, int(grid[r, c])) for r in range(h) for c in range(w) if int(grid[r, c]) != bg]
   178	    assert non_bg, "grid must contain at least one non-background pixel"
   179	
   180	    by_color: dict[int, list[tuple[int, int]]] = {}
   181	    seed_cells: dict[tuple[int, int], int] = {}
   182	    for r, c, col in non_bg:
   183	        by_color.setdefault(col, []).append((r, c))
