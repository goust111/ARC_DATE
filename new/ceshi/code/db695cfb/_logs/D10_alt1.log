   208	    groups_b: dict[int, list[tuple[int, int]]] = {}
   209	    for r, c in pts:
   210	        groups_a.setdefault(r - c, []).append((r, c))
   211	        groups_b.setdefault(r + c, []).append((r, c))
   212	
   213	    segment_paths: list[list[tuple[int, int]]] = []
   214	    trigger_reaches: dict[tuple[int, int, int], dict[tuple[int, int], int]] = {}
   215	
