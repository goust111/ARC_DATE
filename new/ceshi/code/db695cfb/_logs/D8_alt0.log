+
+
+def _try_place_segment(
+    slope_type: str,
+    seg_len: int,
+    h: int,
+    w: int,
+    occupied: set[tuple[int, int]],
+    drawn: set[tuple[int, int]],
+    used_diag_keys: set[tuple[str, int]],
