+def _build_expected(inp: np.ndarray, bg: int, segments: list[dict], *, activate_all: bool) -> np.ndarray:
+    h, w = inp.shape
+    expected = inp.copy()
+    for segment in segments:
+        for r, c in segment["path"]:
+            if expected[r, c] == bg:
+                expected[r, c] = _LINE_COLOR
