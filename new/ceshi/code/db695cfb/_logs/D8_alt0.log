+        if not later_candidates:
+            continue
+        second = random.choice(later_candidates)
+        return [first, second]
+    return None
+
+
+def _line_color_is_selected(inp: np.ndarray, bg: int) -> bool:
+    by_color: dict[int, list[tuple[int, int]]] = {}
+    h, w = inp.shape
