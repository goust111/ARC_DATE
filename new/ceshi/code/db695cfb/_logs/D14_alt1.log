+
+    _, line_color = best
+    blue_paths, triggers, blue_candidate_cells = _collect_geometry(grid, bg, line_color)
+    out, _, _ = _resolve_variant(grid, bg, line_color, blue_paths, triggers, blue_candidate_cells)
+    return out
