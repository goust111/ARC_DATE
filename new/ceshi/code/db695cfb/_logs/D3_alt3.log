+    inp = np.full((H, W), bg, dtype=int)
+    for ep0, ep1, trigger_infos, _, _ in segments:
+        inp[ep0] = _LINE_COLOR
+        inp[ep1] = _LINE_COLOR
+        for tr, tc, _ in trigger_infos:
+            inp[tr, tc] = _TRIGGER_COLOR
