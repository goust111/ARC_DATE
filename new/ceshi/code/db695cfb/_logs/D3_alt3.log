+# --------------- generator (c) ---------------
+
+# === CFG: canvas and structural bounds ===
+_H_RANGE = (8, 25)
+_W_RANGE = (9, 21)
+_LINE_COLOR = 1
+_TRIGGER_COLOR = 6
+_SEGMENT_COUNT = (1, 4)
+_SEG_LEN_RANGE = (5, 16)
+_TRIGGERS_PER_SEG = (1, 3)
+
+# === CFG: distractor counts ===
+_UNPAIRED_LINE_PIXELS = (0, 2)
+_OFF_DIAG_TRIGGERS = (0, 4)
+
+# === CFG: retry limits ===
+_SEGMENT_PLACE_RETRIES = 80
+_DISTRACTOR_RETRIES = 50
+_GEN_RETRIES = 300
