+def _boundary_steps(r: int, c: int, ddr: int, ddc: int, H: int, W: int) -> int:
+    """Count how many cells the original boundary-reaching ray would traverse."""
+    steps = 0
+    r += ddr
+    c += ddc
+    while 0 <= r < H and 0 <= c < W:
+        steps += 1
+        r += ddr
+        c += ddc
