+
+        endpoints: list[Coord] = []
+        cluster_segments = []
+        cluster_path_cells: set[Coord] = set()
+        cluster_ray_cells: set[Coord] = set()
+        perp_dirs = [(1, -dc), (-1, dc)]
+
+        valid = True
+        for start_offset, end_offset in offsets:
+            ep0 = point_at(start_offset)
+            ep1 = point_at(end_offset)
+            endpoints.extend([ep0, ep1])
