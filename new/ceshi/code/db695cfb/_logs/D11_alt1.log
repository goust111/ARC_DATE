+    if len(blue_points) < 4 or len(blue_points) % 2 != 0:
+        return None
+
+    inp = np.full((H, W), bg, dtype=int)
+    for ep0, ep1, trigger_positions, _, _ in segments:
+        inp[ep0] = _LINE_COLOR
