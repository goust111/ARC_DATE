+        best_key = None
+        best_pairs = None
+        for i in range(1, len(remaining)):
+            other = remaining[i]
+            if not _is_diag_pair(first, other):
+                continue
+            rest = solve(remaining[1:i] + remaining[i + 1 :])
+            if rest is None:
+                continue
+            pairs = tuple(sorted((_canonical_pair(first, other),) + rest))
