+
+def _segment_to_path(start: Coord, end: Coord) -> list[Coord]:
+    return _diag_path(start, end)
+
+
+def _try_place_cluster(
+    pair_count: int,
+    H: int,
+    W: int,
+    occupied: set[Coord],
+    drawn: set[Coord],
