+# --------------- generator (c) ---------------
+
+# === CFG: canvas and structural bounds ===
+_H_RANGE = (8, 25)
+_W_RANGE = (9, 21)
+_LINE_COLOR = 1
+_TRIGGER_COLOR = 6
