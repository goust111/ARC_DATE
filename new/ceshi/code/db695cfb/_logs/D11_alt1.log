import collections
import importlib.util
import numpy as np

new_path = '/home/lixinyu/snap/new/ceshi/code/db695cfb/D11/1/code.py'
old_path = '/home/lixinyu/snap/new/arc2_solver_select/db695cfb.py'

def load(path, name):
    spec = importlib.util.spec_from_file_location(name, path)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod

new = load(new_path, 'new_variant')
old = load(old_path, 'old_variant')

blue_counts = collections.Counter()
cluster_max_counts = collections.Counter()
pattern_hits = collections.Counter()
diff_count = 0
samples = 200
for _ in range(samples):
    inp = new.generate_input()
    blue = [(r, c) for r, c in zip(*np.where(inp == 1))]
    blue_counts[len(blue)] += 1
    max_same_diag = 0
    for key in {r - c for r, c in blue}:
        max_same_diag = max(max_same_diag, sum(1 for r, c in blue if r - c == key))
    for key in {r + c for r, c in blue}:
        max_same_diag = max(max_same_diag, sum(1 for r, c in blue if r + c == key))
    cluster_max_counts[max_same_diag] += 1
    if len(blue) == 4 and max_same_diag == 4:
        pattern_hits['(2,)'] += 1
    elif len(blue) == 6 and max_same_diag == 6:
        pattern_hits['(3,)'] += 1
    elif len(blue) == 6 and max_same_diag == 4:
        pattern_hits['(2,1)'] += 1
    else:
        pattern_hits['other'] += 1
    if not np.array_equal(new.main(inp), old.main(inp)):
        diff_count += 1

print('blue_counts', dict(sorted(blue_counts.items())))
print('max_same_diag', dict(sorted(cluster_max_counts.items())))
print('pattern_hits', dict(pattern_hits))
print('old_vs_new_diff', diff_count, '/', samples)
