+
+def _is_diag_pair(p: Coord, q: Coord) -> bool:
+    return p != q and abs(p[0] - q[0]) == abs(p[1] - q[1]) and p[0] != q[0]
+
+
+def _pair_distance(p: Coord, q: Coord) -> int:
+    return abs(p[0] - q[0])
+
+
+def _canonical_pair(p: Coord, q: Coord) -> Pair:
+    return (p, q) if p <= q else (q, p)
