def detect_metrics(grid):
    grid = np.asarray(grid)
    h, w = grid.shape
    bg = variant.get_bg(grid)
    non_bg = [(r, c, int(grid[r, c])) for r in range(h) for c in range(w) if int(grid[r, c]) "'!= bg]
    by_color = {}
    for r, c, col in non_bg:
        by_color.setdefault(col, []).append((r, c))
    best = None
    for col, pts in by_color.items():
        if len(pts) < 2:
            continue
        for i in range(len(pts)):
            r0, c0 = pts[i]
            for j in range(i + 1, len(pts)):
                r1, c1 = pts[j]
                dr = r1 - r0
                dc = c1 - c0
                if dr == 0 or abs(dr) != abs(dc):
                    continue
                cand = (abs(dr), col)
                if best is None or cand > best:
                    best = cand
    _, line_color = best
    pts = by_color[line_color]
    groups_a, groups_b = {}, {}
    for r, c in pts:
        groups_a.setdefault(r - c, []).append((r, c))
        groups_b.setdefault(r + c, []).append((r, c))
    adjacent_triggers = set()
    on_path_triggers = set()
    side_counts = {'"'backslash': 0, 'slash': 0}
    def add_segment(p, q):
        path = variant._diag_path(p, q)
        dr = 1 if q[0] > p[0] else -1
        dc = 1 if q[1] > p[1] else -1
        perp_dirs = [(dr, -dc), (-dr, dc)]
        slope = 'backslash' if dc == 1 else 'slash'
        for r, c in path[1:-1]:
            v = int(grid[r, c])
            if v "'!= bg and v != line_color:
                on_path_triggers.add((r, c))
            for ddr, ddc in perp_dirs:
                nr, nc = r + ddr, c + ddc
                if 0 <= nr < h and 0 <= nc < w:
                    v = int(grid[nr, nc])
                    if v != bg and v != line_color:
                        adjacent_triggers.add((nr, nc))
                        side_counts[slope] += 1
    for g in groups_a.values():
        if len(g) >= 2:
            g = sorted(g)
            add_segment(g[0], g[-1])
    for g in groups_b.values():
        if len(g) >= 2:
            g = sorted(g)
            add_segment(g[0], g[-1])
    return len(adjacent_triggers), len(on_path_triggers), side_counts, not np.array_equal(variant.main(grid), orig.main(grid))

