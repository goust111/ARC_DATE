# load original solver
spec2 = importlib.util.spec_from_file_location('orig', '/home/lixinyu/snap/new/arc2_solver_select/db695cfb.py')
orig = importlib.util.module_from_spec(spec2)
spec2.loader.exec_module(orig)

samples = 100
stats = {
    'h_only': 0,
