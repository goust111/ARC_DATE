import importlib.util
import numpy as np
import sys
from pathlib import Path

sys.path.append('/home/lixinyu/snap/new/solvers')

# load variant
spec = importlib.util.spec_from_file_location('variant', '/home/lixinyu/snap/new/ceshi/code/db695cfb/D1/0/code.py')
