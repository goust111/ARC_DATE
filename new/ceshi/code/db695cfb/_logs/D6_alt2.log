+    for (r0, c0, tcol), dirs in triggers.items():
+        for ddr, ddc in dirs:
+            r, c = r0 + ddr, c0 + ddc
+            while 0 <= r < h and 0 <= c < w:
+                if int(out[r, c]) == bg:
+                    out[r, c] = tcol
+                r += ddr
+                c += ddc
+
+    return out
+
+
+def _compute_ray_cells(triggers: list[tuple[int, int]], perp_dirs: list[tuple[int, int]], h: int, w: int) -> set[tuple[int, int]]:
+    cells = set()
