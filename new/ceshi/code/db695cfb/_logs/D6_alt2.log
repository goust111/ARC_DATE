+
+
+def _build_expected(inp: np.ndarray, bg: int, segments: list[tuple[tuple[int, int], tuple[int, int], list[tuple[int, int]], list[tuple[int, int]], list[tuple[int, int]]]]) -> np.ndarray:
+    h, w = inp.shape
+    expected = inp.copy()
