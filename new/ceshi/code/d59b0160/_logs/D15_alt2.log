+    if not np.array_equal(main(inp), out):
+        return None
+
+    witnesses = _variant_witness_counts(inp)
+    if witnesses["deleted_missing_legend"] < 1:
+        return None
+    if witnesses["kept_with_all_legend"] < 1:
