+    deleted_count = component_count - NUM_KEPT
+    roles = [("kept", k) for k in random.sample([0, 1, 2], NUM_KEPT)]
+    roles += [("deleted", NUM_TARGETS)] * deleted_count
+    random.shuffle(roles)
+
