+    cands = _candidate_locations(
+        canvas,
+        patch,
+        row_lo=row_lo,
+        row_hi=row_hi,
+        col_lo=col_lo,
+        col_hi=col_hi,
+        padding=padding,
+        predicate=predicate,
+    )
+    if not cands:
+        raise ValueError("no legal location")
+    r, c = random.choice(cands)
+    paste(canvas, patch, r, c)
+    return r, c
