+def _candidate_locations(
+    canvas: np.ndarray,
+    patch: np.ndarray,
+    *,
+    row_lo: int = 0,
+    row_hi: int | None = None,
+    col_lo: int = 0,
+    col_hi: int | None = None,
+    padding: int = PADDING,
