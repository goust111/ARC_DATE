+    if input_bbox is None:
+        return None
+    if input_bbox == expected_bbox:
+        return None
+
+    if np.array_equal(main(inp), expected):
+        return inp
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
