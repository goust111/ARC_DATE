+        patch = _component_patch(h, w, targets, deleted=False)
+        try:
+            r, c = _place_patch(
+                inp,
+                patch,
+                row_hi=SURVIVOR_ZONE_H - h,
+                col_hi=SURVIVOR_ZONE_W - w,
+            )
+        except ValueError:
