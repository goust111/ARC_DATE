+
+    component_count = random.choices(COMP_COUNTS, weights=COMP_WEIGHTS)[0]
+    num_deleted = component_count - NUM_KEPT
+
+    anchor_deleted = False
+    for idx in range(num_deleted):
+        h, w = _component_dims()
+        patch = _component_patch(h, w, targets, deleted=True)
