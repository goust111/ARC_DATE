+    if expected_bbox is None:
+        return None
+    expected = crop_bbox(survivor, expected_bbox)
+    if expected.shape == inp.shape:
+        return None
+
+    input_bbox = bbox(inp != BG)
+    if input_bbox is None:
+        return None
+    if input_bbox == expected_bbox:
+        return None
+
+    if np.array_equal(main(inp), expected):
+        return inp
+    return None
+
