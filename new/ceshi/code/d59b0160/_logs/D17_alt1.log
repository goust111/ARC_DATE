+# Variant of d59b0160
+# Dimension: D17 — 分量面积对匹配的影响 (meta)
+# Change: 不考虑分量面积，任何大小的匹配分量都被删除... → 仅删除面积最大的匹配分量
+
+import math
+import random
+
+import numpy as np
+
+from arc_utils import components_mask, paste, random_free_location
