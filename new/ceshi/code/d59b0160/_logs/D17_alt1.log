+DENSITY_HI = 0.55
+
+# -- Variant-specific component mix --
+NONMATCH_COUNT = 3
+MATCH_COUNTS = [2, 3]
+MATCH_WEIGHTS = [4, 1]
+MIN_DELETE_AREA = 18
+MAX_DELETE_AREA = 36
+MIN_OTHER_MATCH_AREA = 6
+MIN_MATCH_AREA_GAP = 4
+NONMATCH_MAX_AREA = 30
+
