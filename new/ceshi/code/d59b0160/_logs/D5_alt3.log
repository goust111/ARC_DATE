   170	# --------------- generator (D5 pair-legend variant) ---------------
   171	
   172	GRID_H, GRID_W = 16, 16
   173	BG = 7
   174	BORDER = 3
   175	LEGEND_SIZE = 4
   176	PALETTE = [1, 2, 4, 5, 6, 8, 9]
   177	NUM_PAIRS = 3
   178	NUM_KEPT = 3
   179	
   180	SHAPE_WEIGHTS = [4, 3, 3]  # medium, tall, wide
   181	TALL_H = (6, 10)
   182	TALL_W = (3, 5)
   183	WIDE_H = (3, 5)
   184	WIDE_W = (6, 9)
   185	MED_H = (4, 7)
   186	MED_W = (4, 7)
   187	
   188	DENSITY_LO = 0.10
   189	DENSITY_HI = 0.45
   190	
   191	COMP_COUNTS = [4, 5]
   192	COMP_WEIGHTS = [4, 1]
   193	
   194	PATCH_LAYOUT_RETRIES = 80
   195	MAX_RETRIES = 400
   196	
