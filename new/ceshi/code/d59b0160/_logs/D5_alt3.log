   223	    for r, c in cell_group:
   224	        blocked.add((r, c))
   225	        blocked.add((r - 1, c))
   226	        blocked.add((r + 1, c))
   227	        blocked.add((r, c - 1))
   228	        blocked.add((r, c + 1))
   229	    return blocked
