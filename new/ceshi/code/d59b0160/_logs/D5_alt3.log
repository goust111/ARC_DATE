   115	def _component_has_pair(g: np.ndarray, pts_set: set[tuple[int, int]], a: int, b: int) -> bool:
   116	    """Return True iff this component contains a 4-neighbor adjacency between colors a and b."""
   117	    for r, c in pts_set:
   118	        col = int(g[r, c])
   119	        if col != a:
   120	            continue
   121	        if (r - 1, c) in pts_set and int(g[r - 1, c]) == b:
   122	            return True
   123	        if (r + 1, c) in pts_set and int(g[r + 1, c]) == b:
   124	            return True
   125	        if (r, c - 1) in pts_set and int(g[r, c - 1]) == b:
   126	            return True
   127	        if (r, c + 1) in pts_set and int(g[r, c + 1]) == b:
   128	            return True
