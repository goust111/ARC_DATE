   198	def _place_legend(inp: np.ndarray, out: np.ndarray, pairs: list[tuple[int, int]]) -> None:
   199	    """Draw the 4x4 legend box and encode the 3 column-wise source->target pairs."""
   200	    s = LEGEND_SIZE
   201	    for g in (inp, out):
   202	        g[:s, :s] = BG
   203	        g[s - 1, :s] = BORDER
   204	        g[:s, s - 1] = BORDER
