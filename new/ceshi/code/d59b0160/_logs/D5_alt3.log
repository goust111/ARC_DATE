   210	def _component_dims() -> tuple[int, int]:
   211	    """Sample component dimensions adapted to hold several separated pair markers."""
   212	    mode = random.choices(["medium", "tall", "wide"], weights=SHAPE_WEIGHTS)[0]
   213	    if mode == "tall":
   214	        return random.randint(*TALL_H), random.randint(*TALL_W)
   215	    if mode == "wide":
   216	        return random.randint(*WIDE_H), random.randint(*WIDE_W)
   217	    return random.randint(*MED_H), random.randint(*MED_W)
   218	
   219	
   220	def _group_cells(cell_group: tuple[tuple[int, int], ...]) -> set[tuple[int, int]]:
   221	    """Cells in a group plus their 4-neighbor buffer, used to prevent accidental pair creation."""
