   132	def main(grid: np.ndarray) -> np.ndarray:
   133	    """
   134	    Delete connected components whose local adjacent color pairs realize every legend mapping.
   135	
   136	    Input structure:
   137	    - Background (bg) fills most of the grid.
   138	    - Top-left corner: a small square legend bordered on its bottom and right edges by one color.
   139	    - Inside that legend, the first interior row lists source colors and the second interior row lists matching target colors; same-column entries form the required pairs.
   140	    - Elsewhere: multicolored 4-connected objects built on the bg.
   141	
   142	    Rule:
   143	    - Read the legend column pairs from the first two interior rows.
   144	    - Ignore the legend square itself when scanning components; the legend is only an instruction area.
   145	    - For each other connected component, test every legend pair and ask whether those two colors ever touch by a 4-neighbor edge inside that component.
   146	    - Erase (fill with bg) every component that realizes all legend pairs; leave all others unchanged.
   147	
   148	    Key insight: The legend no longer gives a palette to collect globally; it specifies which colors must show up as touching pairs inside the same object.
   149	    """
   150	    g = np.asarray(grid, dtype=int)
   151	    bg = _bg_boundary(g)
   152	
   153	    sz, _border, legend_pairs = _find_legend(g, bg)
   154	    assert legend_pairs, "legend contains no color pairs"
   155	
   156	    out = g.copy()
   157	    obj_mask = (g != bg).copy()
   158	    obj_mask[:sz, :sz] = False
   159	
   160	    comps = components_mask(obj_mask, connectivity=4)
   161	    for pts in comps:
   162	        pts_set = set(map(tuple, pts))
   163	        if all(_component_has_pair(g, pts_set, src, dst) or _component_has_pair(g, pts_set, dst, src)
   164	               for src, dst in legend_pairs):
   165	            for r, c in pts:
   166	                out[r, c] = bg
   167	    return out
