+    if matched:
+        lo = max(lo, NUM_TARGETS)
+        hi = min(hi, max(lo, math.floor(area * MATCHED_DENSITY_HI)))
+        hi = min(hi, area - NUM_TARGETS)
+        n_colored = random.randint(lo, hi)
