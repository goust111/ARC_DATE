+#
+# Design analysis
+# ===============
+# spec_variant:
+#   preserved_structure:
+#     grid: 16x16, background color 7
+#     legend: fixed 4x4 block in the top-left corner
+#     legend_border: bottom row and right column are color 3
+#     legend_payload: exactly 3 target colors placed once in the 3x3 interior
