+            r, c = random_free_location(
+                inp,
+                np.zeros_like(patch),
+                transparent=BG,
+                padding=1,
+                padding_connectivity=8,
+            )
+        except ValueError:
+            return None
+
+        paste(inp, patch, r, c)
+        if matched:
+            mr, mc, color = _patch_marker(patch)
+            out[r + mr, c + mc] = color
+        else:
+            paste(out, patch, r, c)
+
+    if np.array_equal(main(inp), out):
+        return inp
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate valid input")

