+    component_count = random.choices(COMP_COUNTS, weights=COMP_WEIGHTS)[0]
+    matched_count = component_count - NUM_KEPT
+    roles = [True] * matched_count + [False] * NUM_KEPT
+    random.shuffle(roles)
