+import math
+import random
+import sys
+from pathlib import Path
+
+import numpy as np
+
+for _parent in Path(__file__).resolve().parents:
+    if (_parent / "arc_utils.py").exists():
+        sys.path.insert(0, str(_parent))
+        break
+
+from arc_utils import components_mask, paste, random_free_location
