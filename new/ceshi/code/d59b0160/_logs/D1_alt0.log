+    out = g.copy()
+    mask = (g != bg).copy()
+    mask[:sz, :sz] = False
+    comps = components_mask(mask, connectivity=4)
+    for pts in comps:
+        cols = {int(g[r, c]) for r, c in pts}
+        if cols & legend_colors:
+            for r, c in pts:
+                out[r, c] = bg
