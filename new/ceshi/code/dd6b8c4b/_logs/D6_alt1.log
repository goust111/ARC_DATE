+GRID_H, GRID_W = 11, 11
+FLOOR_COLOR, WALL_COLOR = 7, 6
+DEST_COLOR, RED_CENTER = 3, 2
+MAROON = 9
+
+CENTER_OPTIONS = [(2, 2), (2, 8), (8, 2), (8, 8)]
+NUM_CONTAINERS = 2
