import importlib.util
from collections import Counter
import numpy as np

spec = importlib.util.spec_from_file_location('variant', '/home/lixinyu/snap/new/ceshi/code/dd6b8c4b/D6/1/code.py')
mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)

pair_counter = Counter()
wall_counter = Counter()
centers_counter = Counter()
shared_floor_counts = []
contested_moved_counts = []
fill_splits = Counter()

for _ in range(100):
    grid = mod.generate_input()
    centers = sorted((int(r), int(c)) for r, c in np.argwhere(grid == mod.RED_CENTER))
    centers_counter[len(centers)] += 1
    pair_counter[tuple(centers)] += 1
    wall_counter['with_walls' if (grid == mod.WALL_COLOR).any() else 'no_walls'] += 1

    dists = [mod._bfs_distance(grid, set(mod._dest_cells(center)), {mod._infer_floor(grid), mod.MAROON}) for center in centers]
    shared_floor = 0
    contested_sources = 0
    fill_counts = []
    for r in range(mod.GRID_H):
        for c in range(mod.GRID_W):
            if grid[r, c] == mod.FLOOR_COLOR:
                reach = sum(int(dist[r, c]) < mod.INF for dist in dists)
                if reach >= 2:
                    shared_floor += 1
            if grid[r, c] == mod.MAROON:
                ds = [int(dist[r, c]) for dist in dists]
                if sum(d < mod.INF for d in ds) >= 2:
                    contested_sources += 1
    shared_floor_counts.append(shared_floor)
    contested_moved_counts.append(contested_sources)

    out = mod.main(grid)
    for center in centers:
        block = mod._dest_cells(center)
        count = sum(int(out[r, c] == mod.MAROON) for r, c in block)
        fill_counts.append(count)
    fill_splits[tuple(fill_counts)] += 1

print('center_count_distribution', dict(centers_counter))
print('pair_distribution', dict(pair_counter))
print('wall_distribution', dict(wall_counter))
print('shared_floor_min_avg_max', min(shared_floor_counts), round(sum(shared_floor_counts)/len(shared_floor_counts), 2), max(shared_floor_counts))
print('contested_maroons_min_avg_max', min(contested_moved_counts), round(sum(contested_moved_counts)/len(contested_moved_counts), 2), max(contested_moved_counts))
print('sample_fill_splits', dict(fill_splits.most_common(10)))
