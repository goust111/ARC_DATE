+        out[r, c] = MAROON
+
+    try:
+        result = main(inp)
+    except Exception:
+        return None
+    if np.array_equal(result, out):
+        return inp
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError(f"Failed to generate valid input after {GEN_RETRIES} attempts")

