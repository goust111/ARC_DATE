+
+    if any(len(bucket) < FILL_RANGE_PER_CONTAINER[0] for bucket in owner_buckets):
+        return None
+
+    shared_total = sum(len(bucket) for bucket in contested_buckets)
+    if shared_total < MIN_SHARED_REACHABLE:
+        return None
