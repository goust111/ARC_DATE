+# ---- CFG: tunable generation parameters ----
+GRID_H, GRID_W = 11, 11
+CENTER_R, CENTER_C = 5, 5
+FLOOR_COLOR, WALL_COLOR = 7, 6
+DEST_COLOR, RED_CENTER = 3, 2
+MAROON = 9
