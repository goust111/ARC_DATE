    97	def _destination_cells(center_r: int, center_c: int, h: int, w: int) -> list[tuple[int, int]]:
    98	    cells = []
    99	    for r in range(center_r - 1, center_r + 2):
   100	        for c in range(center_c - 1, center_c + 2):
   101	            if 0 <= r < h and 0 <= c < w:
   102	                cells.append((r, c))
   103	    cells.sort()
   104	    return cells
   105	
   106	
   107	def _infer_floor_color(grid: np.ndarray, dest_cells: list[tuple[int, int]]) -> int:
   108	    h, w = grid.shape
   109	    dest_set = set(dest_cells)
   110	    ring_colors: list[int] = []
   111	    for r, c in dest_cells:
   112	        for rr, cc in neighbors4(r, c):
   113	            if 0 <= rr < h and 0 <= cc < w and (rr, cc) not in dest_set:
   114	                ring_colors.append(int(grid[rr, cc]))
   115	
   116	    cand_ring = [x for x in ring_colors if x not in (RED_CENTER, DEST_COLOR, MAROON)]
   117	    assert cand_ring, "ring around destination must contain at least one visible non-maroon passable color"
   118	    vals, cnts = np.unique(cand_ring, return_counts=True)
   119	    ring_major = int(vals[cnts.argmax()])
   120	    other = [int(x) for x in np.unique(grid) if int(x) not in (RED_CENTER, DEST_COLOR, MAROON, ring_major)]
   121	    floor = other[0] if len(other) == 1 else (max(other, key=lambda c: int((grid == c).sum())) if other else None)
   122	    if floor is None:
   123	        floor = ring_major
   124	    return floor
   125	
   126	
   127	def _distance_map(grid: np.ndarray, dest_cells: list[tuple[int, int]], passable: set[int]) -> np.ndarray:
   128	    h, w = grid.shape
   129	    dest_set = set(dest_cells)
   130	    starts: list[tuple[int, int]] = []
   131	    seen = set()
   132	    for r, c in dest_cells:
   133	        for rr, cc in neighbors4(r, c):
   134	            if 0 <= rr < h and 0 <= cc < w and (rr, cc) not in dest_set and int(grid[rr, cc]) in passable:
   135	                if (rr, cc) not in seen:
   136	                    seen.add((rr, cc))
   137	                    starts.append((rr, cc))
   138	    assert starts, "there must be at least one passable cell adjacent to the destination block"
   139	
   140	    dist = np.full((h, w), INF, dtype=int)
   141	    q = deque(starts)
   142	    for r, c in starts:
   143	        dist[r, c] = 0
   144	
   145	    while q:
   146	        r, c = q.popleft()
   147	        d = int(dist[r, c])
   148	        for rr, cc in neighbors4(r, c):
   149	            if 0 <= rr < h and 0 <= cc < w and int(grid[rr, cc]) in passable and dist[rr, cc] == INF:
   150	                dist[rr, cc] = d + 1
   151	                q.append((rr, cc))
   152	    return dist
   153	
   154	
   155	def _solve_with_rank(grid: np.ndarray, rank_mode: str) -> tuple[np.ndarray, set[tuple[int, int]]]:
   156	    grid = np.asarray(grid, dtype=int)
   157	    h, w = grid.shape
   158	    out = grid.copy()
   159	
   160	    centers = np.argwhere(grid == RED_CENTER)
   161	    assert len(centers) == 1, "grid must have exactly one red (2) center pixel"
   162	    cr, cc = map(int, centers[0])
   163	    dest_cells = _destination_cells(cr, cc, h, w)
   164	    floor = _infer_floor_color(grid, dest_cells)
   165	    dist = _distance_map(grid, dest_cells, {floor, MAROON})
   166	
   167	    maroons = [(int(r), int(c), int(dist[r, c])) for r, c in np.argwhere(grid == MAROON) if int(dist[r, c]) < INF]
   168	    if rank_mode == "scan":
   169	        maroons.sort(key=lambda t: (t[0], t[1]))
   170	    elif rank_mode == "distance":
   171	        maroons.sort(key=lambda t: (t[2], t[0], t[1]))
   172	    else:
   173	        raise ValueError(f"unknown rank_mode: {rank_mode}")
   174	
   175	    k = min(len(dest_cells), len(maroons))
   176	    chosen = {(r, c) for r, c, _ in maroons[:k]}
   177	
   178	    for r, c in chosen:
   179	        out[r, c] = floor
   180	    for r, c in dest_cells[:k]:
   181	        out[r, c] = MAROON
   182	    return out, chosen
   183	
   184	
   185	def main(grid: np.ndarray) -> np.ndarray:
   186	    """
   187	    Move reachable maroon pixels into the 3×3 target around the unique red center, using scan order among reachable tokens.
   188	
   189	    Input structure:
   190	    - Orange floor surrounds a fixed green 3×3 destination with one red center, and magenta walls may carve corridors.
   191	    - Maroon pixels sit on floor cells; some are connected to the destination through open corridors and some may be trapped elsewhere.
   192	
   193	    Rule:
   194	    - Flood-fill from passable cells touching the destination, traversing only floor or maroon cells to find the reachable maroon pixels.
   195	    - Sort those reachable maroons by spatial position only: top-to-bottom, then left-to-right, and move up to nine of them into the destination in destination row-major order.
   196	    - Clear the chosen source cells back to floor, while unreachable maroons remain where they are.
   197	
   198	    Key insight:
   199	    - Walls still decide which maroons are eligible, but once reachability is known the selection is no longer based on path length; it is based purely on visible scan order.
   200	    """
   201	
   202	    out, _chosen = _solve_with_rank(grid, "scan")
   203	    return out
   204	
   205	
   206	def _distance_ranked_output(grid: np.ndarray) -> tuple[np.ndarray, set[tuple[int, int]]]:
   207	    return _solve_with_rank(grid, "distance")
   208	
   209	
   210	def _bfs_reachable_floor(grid: np.ndarray, dest_set: set[tuple[int, int]]) -> tuple[set[tuple[int, int]], np.ndarray, set[tuple[int, int]]]:
   211	    visited: set[tuple[int, int]] = set()
   212	    starts: set[tuple[int, int]] = set()
   213	    dist = np.full((GRID_H, GRID_W), INF, dtype=int)
   214	    q = deque()
   215	
   216	    for dr, dc in dest_set:
   217	        for nr, nc in neighbors4(dr, dc):
   218	            if 0 <= nr < GRID_H and 0 <= nc < GRID_W and (nr, nc) not in dest_set and grid[nr, nc] == FLOOR_COLOR:
   219	                if (nr, nc) not in visited:
   220	                    visited.add((nr, nc))
   221	                    starts.add((nr, nc))
   222	                    dist[nr, nc] = 0
   223	                    q.append((nr, nc))
   224	
   225	    while q:
   226	        r, c = q.popleft()
   227	        for nr, nc in neighbors4(r, c):
   228	            if 0 <= nr < GRID_H and 0 <= nc < GRID_W and (nr, nc) not in visited:
   229	                if grid[nr, nc] == FLOOR_COLOR and (nr, nc) not in dest_set:
   230	                    visited.add((nr, nc))
   231	                    dist[nr, nc] = int(dist[r, c]) + 1
   232	                    q.append((nr, nc))
   233	    return visited, dist, starts
   234	
   235	
   236	def _outward_dirs(r: int, c: int) -> list[tuple[int, int]]:
   237	    dirs = []
   238	    if r < CENTER_R:
   239	        dirs.append((-1, 0))
   240	    if r > CENTER_R:
   241	        dirs.append((1, 0))
   242	    if c < CENTER_C:
   243	        dirs.append((0, -1))
   244	    if c > CENTER_C:
   245	        dirs.append((0, 1))
   246	    return dirs
   247	
   248	
   249	def _extend_arm(wall_cells: set[tuple[int, int]], dest_set: set[tuple[int, int]], r: int, c: int, max_len: int) -> None:
   250	    dirs = _outward_dirs(r, c)
   251	    if not dirs:
   252	        return
   253	    dr, dc = random.choice(dirs)
   254	    nr, nc = r, c
   255	    for _ in range(random.randint(1, max_len)):
   256	        nr, nc = nr + dr, nc + dc
   257	        if 0 <= nr < GRID_H and 0 <= nc < GRID_W and (nr, nc) not in dest_set:
   258	            wall_cells.add((nr, nc))
   259	        else:
   260	            break

