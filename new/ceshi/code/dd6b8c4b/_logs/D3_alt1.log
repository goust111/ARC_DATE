+ARM_EXTEND_PROB = 0.5
+ARM_LENGTH_RANGE = (1, 5)
+FRAME_DIST_RANGE = (3, 4)
+FRAME_CONNECT_PROB = 0.4
+FRAME_GAP_REMOVE_PROB = 0.3
+MIXED_EXTEND_PROB = 0.6
