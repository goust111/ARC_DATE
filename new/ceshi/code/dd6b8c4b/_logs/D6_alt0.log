+                    if r in (r0, r1) or c in (c0, c1):
+                        wall_cells.add((r, c))
+        for r, c in wall_ring:
+            dirs = _outward_dirs(r, c, size)
+            if dirs and random.random() < FRAME_CONNECT_PROB:
+                dr, dc = random.choice(dirs)
