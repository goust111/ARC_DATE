+    assert len(coords) > 0, "grid must contain a red/green destination square"
+
+    red_coords = np.argwhere(grid == RED_ANCHOR)
+    assert len(red_coords) == 1, "grid must contain exactly one red anchor"
+    rr, rc = map(int, red_coords[0])
