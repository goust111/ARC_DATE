+    ranked_sources = sorted((dist[(r, c)], r, c) for r, c in source_cells)
+    moved_sources = {(r, c) for _, r, c in ranked_sources[:capacity]}
+    leftover_sources = set(source_cells) - moved_sources
+
+    inp = base.copy()
+    for r, c in source_cells:
