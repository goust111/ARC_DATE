+    elif style == "frame":
+        margin = random.randint(*FRAME_MARGIN_RANGE)
+        r0 = DEST_TOP - margin
+        c0 = DEST_LEFT - margin
+        r1 = DEST_TOP + size - 1 + margin
+        c1 = DEST_LEFT + size - 1 + margin
+        for r in range(r0, r1 + 1):
