+
+def _outward_dirs(r: int, c: int, size: int) -> list[tuple[int, int]]:
+    center_r = DEST_TOP + (size - 1) / 2.0
+    center_c = DEST_LEFT + (size - 1) / 2.0
+    dirs = []
+    if r < center_r:
+        dirs.append((-1, 0))
+    if r > center_r:
+        dirs.append((1, 0))
+    if c < center_c:
+        dirs.append((0, -1))
+    if c > center_c:
+        dirs.append((0, 1))
