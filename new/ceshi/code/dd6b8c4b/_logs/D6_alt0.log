+
+def _reachable_distances(grid: np.ndarray, dest_cells: list[tuple[int, int]], passable: set[int]):
+    h, w = grid.shape
+    dest_set = set(dest_cells)
+
+    starts: list[tuple[int, int]] = []
+    seen = set()
+    for r, c in dest_cells:
