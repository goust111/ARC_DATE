+def _extend_arm(wall_cells: set[tuple[int, int]], dest_set: set[tuple[int, int]], r: int, c: int, max_len: int) -> None:
+    """Extend a wall arm outward from (r,c)."""
+    dr, dc = random.choice(_outward_dirs(r, c))
