+    if r < ANCHOR_R:
+        dirs.append((-1, 0))
+    if r > ANCHOR_R:
+        dirs.append((1, 0))
+    if c < ANCHOR_C:
+        dirs.append((0, -1))
+    if c > ANCHOR_C:
+        dirs.append((0, 1))
+    if not dirs:
