+    for r, c in wall_cells:
+        grid[r, c] = WALL_COLOR
+
+
+def _expected_output(base_grid: np.ndarray, dest_cells: list[tuple[int, int]], source_cells: list[tuple[int, int]], distractor_cells: list[tuple[int, int]]) -> np.ndarray:
+    out = base_grid.copy()
+    k = len(source_cells)
+    for r, c in dest_cells[:k]:
