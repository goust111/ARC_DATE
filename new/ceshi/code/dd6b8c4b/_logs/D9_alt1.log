    """
    Place markers into grid (in place). Returns the set of colors used, or
    None if any marker would land outside its rect or overwrite non-bg.
    """
    used = set()
    for rect in rects:
        for _d, col, rr, cc in _place_markers(rect, marker_pool, rng):
