+    grid[CENTER_R, CENTER_C] = RED_CENTER
+
+    template = _choose_template()
+    boxes = list(template["boxes"])
+    openings = _choose_openings(template)
+    opening_set = set(openings)
+
+    wall_cells = set()
+    for box in boxes:
+        wall_cells |= _frame_cells(box)
+    for rc in openings:
