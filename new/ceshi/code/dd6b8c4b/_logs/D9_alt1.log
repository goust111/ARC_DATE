import importlib.util

spec = importlib.util.spec_from_file_location('variant', '/home/lixinyu/snap/new/ceshi/code/dd6b8c4b/D9/1/code.py')
mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)

def try_template(name, trials=100):
    t = next(t for t in mod.FRAME_TEMPLATES if t['name']==name)
    ok = 0
    for _ in range(trials):
        boxes = list(t['boxes'])
        openings = mod._choose_openings(t)
        dest = set(mod._dest_cells())
        grid = mod.np.full((mod.GRID_H, mod.GRID_W), mod.FLOOR_COLOR, dtype=int)
        for r,c in mod._dest_cells(): grid[r,c]=mod.DEST_COLOR
        grid[mod.CENTER_R, mod.CENTER_C]=mod.RED_CENTER
        wall=set()
        for box in boxes: wall |= mod._frame_cells(box)
        for rc in openings: wall.discard(rc)
        for r,c in wall: grid[r,c]=mod.WALL_COLOR
        reach = mod._bfs_reachable(grid, dest)
        groups={d:[] for d in range(1,len(boxes)+1)}
        for cell in sorted(rc for rc in reach if rc not in set(openings)):
            d = mod._depth_outside_boxes(cell, boxes)
            if d in groups: groups[d].append(cell)
        if all(groups[d] for d in groups):
            ok += 1
    print(name, ok, '/', trials)

for name in [t['name'] for t in mod.FRAME_TEMPLATES]:
    try_template(name)
