+        "weight": 1,
+    },
+    {
+        "name": "two_wide",
+        "boxes": [(3, 3, 7, 7), (1, 0, 9, 10)],
+        "outer_sides": ("top", "bottom"),
+        "weight": 2,
+    },
+    {
+        "name": "two_tall",
+        "boxes": [(3, 3, 7, 7), (0, 1, 10, 9)],
+        "outer_sides": ("left", "right"),
+        "weight": 2,
+    },
+    {
+        "name": "three_wide",
+        "boxes": [(3, 3, 7, 7), (3, 1, 7, 9), (1, 1, 9, 9)],
+        "outer_sides": ("top", "bottom", "left", "right"),
+        "weight": 4,
+    },
+    {
+        "name": "three_tall",
+        "boxes": [(3, 3, 7, 7), (1, 3, 9, 7), (1, 1, 9, 9)],
+        "outer_sides": ("top", "bottom", "left", "right"),
+        "weight": 4,
+    },
