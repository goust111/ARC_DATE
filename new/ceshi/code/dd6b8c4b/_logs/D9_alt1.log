+        "dest_cells": dest_cells,
+        "dest_set": dest_set,
+        "boxes": boxes,
+        "openings": openings,
+        "layer_count": layer_count,
+        "reachable_floor": reachable_source_floor,
+        "unreachable_floor": unreachable_floor,
+        "depth_groups": depth_groups,
