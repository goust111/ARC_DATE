+    for r, c in distractor_cells:
+        out[r, c] = MAROON
+    return out
+
+
+def _gen_attempt():
+    layout = _build_layout()
+    if layout is None:
+        return None
+
+    source_cells = _pick_sources(layout)
+    if source_cells is None:
+        return None
+
