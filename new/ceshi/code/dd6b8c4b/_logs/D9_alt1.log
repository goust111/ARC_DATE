+
+
+def _dest_cells():
+    cells = []
+    for r in range(CENTER_R - 1, CENTER_R + 2):
+        for c in range(CENTER_C - 1, CENTER_C + 2):
+            cells.append((r, c))
+    return cells
+
+
+def _frame_cells(box):
+    r0, c0, r1, c1 = box
+    cells = set()
+    for c in range(c0, c1 + 1):
+        cells.add((r0, c))
+        cells.add((r1, c))
+    for r in range(r0, r1 + 1):
+        cells.add((r, c0))
+        cells.add((r, c1))
+    return cells
+
+
+def _side_positions(box, side):
+    r0, c0, r1, c1 = box
+    if side == "top":
+        return [(r0, c) for c in range(c0 + 1, c1)]
+    if side == "bottom":
+        return [(r1, c) for c in range(c0 + 1, c1)]
+    if side == "left":
+        return [(r, c0) for r in range(r0 + 1, r1)]
+    if side == "right":
+        return [(r, c1) for r in range(r0 + 1, r1)]
+    raise ValueError(f"bad side: {side}")
+
+
+def _choose_template():
+    templates = FRAME_TEMPLATES
+    return random.choices(templates, weights=[t["weight"] for t in templates], k=1)[0]
+
+
+def _choose_openings(template):
+    openings = []
+    prev_side = None
+    boxes = template["boxes"]
+    for i, box in enumerate(boxes):
+        allowed = list(template["outer_sides"]) if i == len(boxes) - 1 else ["top", "bottom", "left", "right"]
+        if prev_side in allowed and len(allowed) > 1:
+            allowed = [side for side in allowed if side != prev_side]
+        side = random.choice(allowed)
+        positions = _side_positions(box, side)
+        opening = random.choice(positions)
+        openings.append(opening)
+        prev_side = side
+    return openings
+
+
+def _bfs_reachable(grid, dest_set):
+    visited = set()
+    queue = deque()
+    for dr, dc in dest_set:
+        for nr, nc in neighbors4(dr, dc):
+            if 0 <= nr < GRID_H and 0 <= nc < GRID_W and (nr, nc) not in dest_set:
+                if grid[nr, nc] == FLOOR_COLOR and (nr, nc) not in visited:
+                    visited.add((nr, nc))
+                    queue.append((nr, nc))
