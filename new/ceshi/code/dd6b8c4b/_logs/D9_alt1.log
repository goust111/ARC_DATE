    """Pick bg, wall, and the remaining 8-color marker pool (all distinct)."""
    colors = list(range(10))
    bg = rng.choice(colors)
    colors.remove(bg)
    wall = rng.choice(colors)
    colors.remove(wall)
    return bg, wall, colors


