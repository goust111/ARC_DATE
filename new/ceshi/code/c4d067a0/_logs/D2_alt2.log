+
+def _bbox_gap_ok(
+    base1: tuple[int, int],
+    bbox1: tuple[int, int, int, int],
+    base2: tuple[int, int],
+    bbox2: tuple[int, int, int, int],
+) -> bool:
+    a_r0, a_c0, a_r1, a_c1 = bbox1
+    b_r0, b_c0, b_r1, b_c1 = bbox2
+    a_r0 += base1[0]
+    a_r1 += base1[0]
+    a_c0 += base1[1]
+    a_c1 += base1[1]
+    b_r0 += base2[0]
+    b_r1 += base2[0]
+    b_c0 += base2[1]
+    b_c1 += base2[1]
