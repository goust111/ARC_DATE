+    region_bases = _find_region_bases(size, block_size, step, legend_shapes)
+    if region_bases is None:
+        return None
+
+    out = np.full((size, size), bg, dtype=int)
+
+    for placed_pts, colors in zip(placed_legends, legend_colors_list):
