import importlib.util
import numpy as np
from collections import Counter

spec = importlib.util.spec_from_file_location('variant', '/home/lixinyu/snap/new/ceshi/code/dbff022c/D5/1/code.py')
mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)

side_counter = Counter()
diff_vs_solid = 0
samples = 100
painted_total = 0
kept_bg_total = 0
fillable_regions = 0

for _ in range(samples):
    inp = mod.generate_input()
    out = mod.main(inp)
    bg = mod._bg_boundary(inp)
    mapping, pal_mask = mod._palette_mapping(inp, bg)
    side, _, _ = mod._best_palette(inp, bg)
    side_counter[side] += 1

    solid = inp.copy()
    bg_mask = (solid == bg) & (~pal_mask)
    for pts in mod.components_mask(bg_mask, connectivity=4):
        if any(r == 0 or c == 0 or r == solid.shape[0] - 1 or c == solid.shape[1] - 1 for r, c in pts):
            continue
        adj_counts = {}
        for r, c in pts:
            for rr, cc in mod.neighbors4(int(r), int(c)):
                if 0 <= rr < solid.shape[0] and 0 <= cc < solid.shape[1] and not pal_mask[rr, cc]:
                    v = int(solid[rr, cc])
                    if v == bg:
                        continue
                    adj_counts[v] = adj_counts.get(v, 0) + 1
        border = None
        best = -1
        for col, cnt in adj_counts.items():
            if col in mapping and cnt > best:
                best = cnt
                border = col
        if border is None:
            continue
        fillable_regions += 1
        fill = int(mapping[border])
        for r, c in pts:
            solid[int(r), int(c)] = fill
            if (int(r) + int(c)) % 2 == 0:
                painted_total += 1
            else:
                kept_bg_total += 1
    if not np.array_equal(out, solid):
        diff_vs_solid += 1

print('samples', samples)
print('palette_sides', dict(side_counter))
print('fillable_regions', fillable_regions)
print('checker_painted_cells', painted_total)
print('checker_bg_cells', kept_bg_total)
print('different_from_solid_fill', diff_vs_solid)
