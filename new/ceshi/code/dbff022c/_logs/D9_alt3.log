-#   concretization_and_trace:
+# ---
+# spec_variant:
+#   core_change:
+#     original: 调色板在输出中保留，solver 只做“查表后填洞”。
+#     variant: 必须先利用调色板完成所有匹配洞的填充，再把整块调色板擦成背景色。
+#   concrete_pixel_behavior:
