import importlib.util
import numpy as np
from collections import Counter

spec = importlib.util.spec_from_file_location('variant', '/home/lixinyu/snap/new/ceshi/code/dbff022c/D3/3/code.py')
mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)


def single_palette_output(inp, mapping, union_mask):
    out = inp.copy()
    mod._fill_enclosed_bg_regions(out, mod._bg_boundary(inp), mapping, union_mask)
    return out

samples = 100
both_used = 0
single_palette_insufficient = 0
side_pairs = Counter()
for _ in range(samples):
    inp = mod.generate_input()
    bg = mod._bg_boundary(inp)
    palettes = mod._find_palettes(inp, bg)
    palette_maps, _, union_mask = mod._palette_mappings(inp, bg)
    out = mod.main(inp)
    side_pairs[tuple(sorted(side for side, _, _ in palettes))] += 1

    used_here = 0
    for mapping in palette_maps:
        solo = single_palette_output(inp, mapping, union_mask)
        if not np.array_equal(solo, inp):
            used_here += 1
    if used_here == 2:
        both_used += 1

    if all(not np.array_equal(single_palette_output(inp, mapping, union_mask), out) for mapping in palette_maps):
        single_palette_insufficient += 1

print('both_palettes_used', both_used, '/', samples)
print('no_single_palette_can_solve', single_palette_insufficient, '/', samples)
print('side_pair_distribution', dict(side_pairs))
