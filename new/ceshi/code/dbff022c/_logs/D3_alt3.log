def single_palette_output(inp, mapping, pal_mask):
    out = inp.copy()
    mod._fill_enclosed_bg_regions(out, mod._bg_boundary(inp), mapping, pal_mask)
    return out

samples = 100
both_used = 0
single_palette_fails = 0
side_pairs = Counter()
used_hole_counts = []
for _ in range(samples):
    inp = mod.generate_input()
    bg = mod._bg_boundary(inp)
    palettes = mod._find_palettes(inp, bg)
    palette_maps, merged, union_mask = mod._palette_mappings(inp, bg)
    out = mod.main(inp)

    sides = tuple(sorted(side for side, _, _ in palettes))
    side_pairs[sides] += 1

    used_count = 0
    for (side, start, end), mapping in zip(palettes, palette_maps, strict=False):
        pal_mask = mod._palette_mask(inp.shape, side, start, end)
        solo = single_palette_output(inp, mapping, pal_mask)
        if not np.array_equal(solo, inp):
            used_count += 1
    used_hole_counts.append(used_count)
    if used_count == 2:
        both_used += 1

    solo_matches = []
    for (side, start, end), mapping in zip(palettes, palette_maps, strict=False):
        pal_mask = mod._palette_mask(inp.shape, side, start, end)
        solo = single_palette_output(inp, mapping, union_mask)
        solo_matches.append(np.array_equal(solo, out))
    if not any(solo_matches):
