# Variant of dbff022c
# Dimension: D3 — 调色板阅读方向的推断规则 (symbol_instructions)
# Change: 阅读方向由调色板所在边缘决定：上边缘→从上到下，下边缘→从下到上，左边缘→从左到右；第一行/列始终是边框颜色... → 同一网格中多个调色板使用不同阅读方向

import random

import numpy as np

from arc_utils import components_mask, neighbors4


# Design analysis for the D3 variant
# a) Concrete behavior:
#    The input now contains two separate palette blocks on two different edges.
#    One palette is horizontal on the top or bottom edge; the other is vertical on
#    the left or right edge. Each palette still uses the old edge-dependent
#    reading direction locally, but the solver must detect and read both in the
#    same grid. Example trace:
#      - Original task: one top palette [border row / fill row] explains every
#        fillable sprite in the grid.
#      - Variant: a top palette may map 2->7 and 4->6, while a left palette maps
#        8->3 and 5->1. A hollow sprite bordered by color 4 must use the top
#        palette; another bordered by color 8 must use the left palette.
#      - Difference: the old "find one best palette and apply it globally"
#        behavior leaves one whole sprite group unresolved.
# b) Complexity calibration:
#    Exactly two palettes are generated, with disjoint border-key colors. Each
#    palette has 2-3 entries and contributes at least one actually used sprite,
#    so both legends matter visually. One distractor sprite whose border color is
#    in neither palette is retained from the original task.
# c) Implicit-assumption review:
#    The original _best_palette/_palette_mapping pipeline assumes there is a
#    single maximal candidate. That is no longer safe: selecting only one palette
#    would silently drop valid border->fill pairs for the second sprite group.
#    The new solver therefore enumerates all edge runs that look like palettes,
#    expects exactly two isolated legends, reads them separately, and only then
#    merges their mappings.
# d) Placement legality:
#    The generator reserves one horizontal edge and one vertical edge, keeps a
#    one-cell bg gap from the shared corner area, and places sprites with the same
#    non-overlap / non-boundary-hole checks as the original task. This guarantees
#    both palettes remain isolated and that no sprite is mistaken for a palette.
# e) Visual observability:
#    The two legends are visible in different orientations on different edges, so
#    the need for two reading rules is directly observable from a few examples.
#    Border colors, not numeric ids, determine which legend applies to each
#    sprite; no hidden ordering or numeric-color trick is used.
# f) Visual cleanliness:
#    Objects remain separated by at least one bg cell, palettes do not touch each
#    other, and only one distractor sprite is added. The grid still reads as
#    "two legends + several hollow sprites" rather than as overlapping clutter.
# g) Color-change inferability:
#    Total border keys are capped at 4-5 across both palettes, and each palette
#    has repeated support via at least one sprite. Fill colors are chosen so a
#    used key never maps to itself, ensuring the transformation is visible.


def _bg_boundary(g: np.ndarray) -> int:
    """Most common color along the 1-cell outer border."""
    border = np.concatenate([g[0, :], g[-1, :], g[1:-1, 0], g[1:-1, -1]])
    vals, cnts = np.unique(border, return_counts=True)
    return int(vals[cnts.argmax()])


def _runs(mask: np.ndarray) -> list[tuple[int, int]]:
    """Half-open contiguous True runs."""
    runs: list[tuple[int, int]] = []
    start = None
    for i, v in enumerate(mask.tolist()):
        if v and start is None:
            start = i
        elif not v and start is not None:
            runs.append((start, i))
            start = None
    if start is not None:
        runs.append((start, len(mask)))
    return runs


def _palette_mask(shape: tuple[int, int], side: str, start: int, end: int) -> np.ndarray:
    h, w = shape
    pal_mask = np.zeros((h, w), dtype=bool)
    if side == "top":
        pal_mask[0:2, start:end] = True
    elif side == "bottom":
        pal_mask[h - 2 : h, start:end] = True
    elif side == "left":
        pal_mask[start:end, 0:2] = True
    else:
        pal_mask[start:end, w - 2 : w] = True
    return pal_mask


def _palette_lines(g: np.ndarray, side: str, start: int, end: int) -> tuple[np.ndarray, np.ndarray]:
    h, w = g.shape
    if side == "top":
        return g[0, start:end], g[1, start:end]
    if side == "bottom":
        return g[h - 1, start:end], g[h - 2, start:end]
    if side == "left":
        return g[start:end, 0], g[start:end, 1]
    return g[start:end, w - 1], g[start:end, w - 2]


def _isolated_palette(g: np.ndarray, bg: int, side: str, start: int, end: int) -> bool:
    """
    Palette colors must not 4-touch same-colored cells outside the palette block.
    """
    h, w = g.shape
    pal = _palette_mask((h, w), side, start, end)
    for r, c in zip(*np.where(pal), strict=False):
        v = int(g[int(r), int(c)])
        if v == bg:
            continue
        for rr, cc in neighbors4(int(r), int(c)):
            if 0 <= rr < h and 0 <= cc < w and not pal[rr, cc]:
                if int(g[rr, cc]) == v:
                    return False
    return True


def _find_palettes(g: np.ndarray, bg: int) -> list[tuple[str, int, int]]:
    """
    Detect the two palette blocks placed on different grid edges.
    """
    h, w = g.shape
    candidates: list[tuple[str, int, int]] = []

    def consider(side: str, mask: np.ndarray) -> None:
        for start, end in _runs(mask):
            if end - start < 2:
                continue
            outer, inner = _palette_lines(g, side, start, end)
            outer_vals = [int(x) for x in outer.tolist()]
            inner_vals = [int(x) for x in inner.tolist()]
            if any(v == bg for v in outer_vals + inner_vals):
                continue
            if len(set(outer_vals)) != len(outer_vals):
                continue
            if len(set(inner_vals)) < 2:
                continue
            if len(set(outer_vals) | set(inner_vals)) < 3:
                continue
            if not _isolated_palette(g, bg, side, start, end):
                continue
            candidates.append((side, int(start), int(end)))

    if h >= 2:
        consider("top", (g[0, :] != bg) & (g[1, :] != bg))
        consider("bottom", (g[h - 1, :] != bg) & (g[h - 2, :] != bg))
    if w >= 2:
        consider("left", (g[:, 0] != bg) & (g[:, 1] != bg))
        consider("right", (g[:, w - 1] != bg) & (g[:, w - 2] != bg))

    assert len(candidates) == 2, "_find_palettes expects exactly two palette blocks"
    return candidates


def _palette_mappings(g: np.ndarray, bg: int) -> tuple[list[dict[int, int]], dict[int, int], np.ndarray]:
    """
    Returns (palette_mappings, merged_mapping, union_palette_mask).
    """
    h, w = g.shape
    merged_mask = np.zeros((h, w), dtype=bool)
    palette_maps: list[dict[int, int]] = []
    merged_mapping: dict[int, int] = {}

    for side, start, end in _find_palettes(g, bg):
        outer, inner = _palette_lines(g, side, start, end)
        mapping: dict[int, int] = {}
        for b, f in zip(outer.tolist(), inner.tolist(), strict=False):
            b = int(b)
            f = int(f)
            if b in merged_mapping:
                raise AssertionError("palette border keys must be unique across palettes")
            mapping[b] = f
            merged_mapping[b] = f
        palette_maps.append(mapping)
        merged_mask |= _palette_mask((h, w), side, start, end)

    assert merged_mapping, "_palette_mappings must produce a non-empty mapping"
    return palette_maps, merged_mapping, merged_mask


def _fill_enclosed_bg_regions(out: np.ndarray, bg: int, mapping: dict[int, int], pal_mask: np.ndarray) -> None:
    """
    Fill each enclosed bg region by the dominant adjacent border color if that
    border color appears in either palette.
    """
    h, w = out.shape
    bg_mask = (out == bg) & (~pal_mask)
    comps = components_mask(bg_mask, connectivity=4)
    for pts in comps:
        touches_boundary = any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)
        if touches_boundary:
            continue

        adj_counts: dict[int, int] = {}
        for r, c in pts:
            for rr, cc in neighbors4(int(r), int(c)):
                if 0 <= rr < h and 0 <= cc < w and not pal_mask[rr, cc]:
                    v = int(out[rr, cc])
                    if v != bg:
                        adj_counts[v] = adj_counts.get(v, 0) + 1
        if not adj_counts:
            continue

        border = None
        best = -1
        for col, cnt in adj_counts.items():
            if col in mapping and cnt > best:
                border = col
                best = cnt
        if border is None:
            continue

        fill = int(mapping[border])
        for r, c in pts:
            out[r, c] = fill


def main(grid: np.ndarray) -> np.ndarray:
    """
    Fill hollow sprites' interiors using two separate edge legends in one grid.

    Input structure:
    - bg is the dominant outer-border color. Several hollow single-color sprites sit on the canvas.
    - Exactly two small 2×N or N×2 palette blocks appear on two different edges; each block lists border colors on the edge-facing line and fill colors on the adjacent inner line.

    Rule:
    - Detect both palette legends and read each one with the direction implied by its own edge: top/bottom use paired rows, left/right use paired columns.
    - Merge the two border→fill mappings while excluding both palette areas from hole detection.
    - For every enclosed bg region inside a sprite, find its dominant adjacent border color and fill that region with the value from the palette that contains that border color.

    Key insight: The grid is no longer explained by a single legend. You must parse two edge palettes with different reading directions and route each sprite to the correct mapping by matching its border color.
    """
    g = np.asarray(grid, dtype=int)
    bg = _bg_boundary(g)

    _, mapping, pal_mask = _palette_mappings(g, bg)

    out = g.copy()
    _fill_enclosed_bg_regions(out, bg, mapping, pal_mask)
    return out


# --------------- generator (c) ---------------

# -- Configuration constants --------------------------------------------------
# Grid dimensions: slightly enlarged so two edge palettes can coexist cleanly.
_GRID_H_MIN, _GRID_H_MAX = 9, 14
_GRID_W_MIN, _GRID_W_MAX = 12, 16

# Palette sizes
_PALETTE_N_MIN, _PALETTE_N_MAX = 2, 3

# Sprite geometry
_SPRITE_H_MAX = 6
_SPRITE_W_MAX = 6
_SPRITE_DIM_SUM_CAP = 10
_SPRITE_CELL_MAX = 16

# Sprite mutation probabilities
_P_HORIZ_WALL = 0.3
_P_VERT_WALL = 0.3
_P_BORDER_REMOVAL = 0.4
_P_DIAMOND = 0.2

# Generation
_MAX_RETRIES = 800
# -- End configuration --------------------------------------------------------


def _get_enclosed_holes(sprite: np.ndarray) -> list[np.ndarray]:
    """Return bg components inside a sprite that do not touch the sprite bbox boundary."""
    h, w = sprite.shape
    return [
        pts
        for pts in components_mask(~sprite, connectivity=4)
        if not any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)
    ]


def _make_diamond() -> np.ndarray:
    """Return a 3x3 diamond-shaped boolean mask."""
    s = np.zeros((3, 3), dtype=bool)
    s[0, 1] = s[1, 0] = s[1, 2] = s[2, 1] = True
    return s


def _make_hollow_sprite(h: int, w: int, rng: random.Random) -> np.ndarray | None:
    """Create a hollow sprite with at least one enclosed hole."""
    sprite = np.ones((h, w), dtype=bool)
    if h >= 3 and w >= 3:
        sprite[1:-1, 1:-1] = False
    if h >= 5 and w >= 4 and rng.random() < _P_HORIZ_WALL:
        br = rng.randint(2, h - 2)
        n = rng.randint(1, w - 2)
        s = rng.randint(1, w - n - 1)
        sprite[br, s : s + n] = True
    if h >= 4 and w >= 5 and rng.random() < _P_VERT_WALL:
        bc = rng.randint(2, w - 2)
        n = rng.randint(1, h - 2)
        s = rng.randint(1, h - n - 1)
        sprite[s : s + n, bc] = True
    if rng.random() < _P_BORDER_REMOVAL:
        bcells = [
            (r, c)
            for r in range(h)
            for c in range(w)
            if sprite[r, c] and (r in (0, h - 1) or c in (0, w - 1))
        ]
        rng.shuffle(bcells)
        for cr, cc in bcells[: rng.randint(1, min(4, len(bcells)))]:
            test = sprite.copy()
            test[cr, cc] = False
            if _get_enclosed_holes(test):
                sprite = test
    if not _get_enclosed_holes(sprite) or int(sprite.sum()) > _SPRITE_CELL_MAX:
        return None

