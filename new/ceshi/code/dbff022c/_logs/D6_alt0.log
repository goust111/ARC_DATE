/bin/bash -lc "python - <<'PY'
import importlib.util, numpy as np, collections

def load(path, name):
    spec = importlib.util.spec_from_file_location(name, path)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod

new = load('/home/lixinyu/snap/new/ceshi/code/dbff022c/D6/0/code.py', 'newmod')
old = load('/home/lixinyu/snap/new/arc2_solver_select/dbff022c.py', 'oldmod')

side_counts = collections.Counter()
delta_counts = collections.Counter()
shape_same_as_input = 0
same_as_old = 0
cropped_matches_old_crop = 0
for _ in range(100):
    inp = new.generate_input()
    out_new = new.main(inp)
    out_old = old.main(inp)
    side = new._best_palette(inp, new._bg_boundary(inp))[0]
    side_counts[side] += 1
    delta = (inp.shape[0] - out_new.shape[0], inp.shape[1] - out_new.shape[1])
    delta_counts[delta] += 1
    if inp.shape == out_new.shape:
        shape_same_as_input += 1
    if out_new.shape == out_old.shape and np.array_equal(out_new, out_old):
        same_as_old += 1
    if side == 'top':
        cropped = out_old[2:, :]
    elif side == 'bottom':
        cropped = out_old[:-2, :]
    elif side == 'left':
        cropped = out_old[:, 2:]
    else:
        cropped = out_old[:, :-2]
    if np.array_equal(out_new, cropped):
        cropped_matches_old_crop += 1

print('side_counts', dict(side_counts))
print('delta_counts', dict(delta_counts))
print('shape_same_as_input', shape_same_as_input)
print('same_as_old', same_as_old)
print('cropped_matches_old_crop', cropped_matches_old_crop)
