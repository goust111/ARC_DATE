/bin/bash -lc "python - <<'PY'
import importlib.util
import numpy as np
from collections import Counter

path='/home/lixinyu/snap/new/ceshi/code/dbff022c/D1/4/code.py'
spec=importlib.util.spec_from_file_location('variant', path)
mod=importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)

samples=100
side_counts=Counter()
len_counts=Counter()
misaligned_entry_counts=[]
used_misaligned_counts=[]
for _ in range(samples):
    inp=mod.generate_input()
    bg=mod._bg_boundary(inp)
    side,start,end=mod._best_palette(inp,bg)
    side_counts[side]+=1
    pal_mask=mod._palette_mask(inp.shape, side, start, end)
    h,w=inp.shape
    if side=='top':
        outer=inp[0,start:end]
        inner=inp[1,start:end]
    elif side=='bottom':
        outer=inp[h-1,start:end]
        inner=inp[h-2,start:end]
    elif side=='left':
        outer=inp[start:end,0]
        inner=inp[start:end,1]
    else:
        outer=inp[start:end,w-1]
        inner=inp[start:end,w-2]
    border_seq=[int(x) for x in outer.tolist() if int(x)"'!=bg]
    fill_seq=[int(x) for x in inner.tolist() if int(x)!=bg]
    len_counts[len(border_seq)] += 1
    if outer.ndim != 1 or inner.ndim != 1:
        raise SystemExit('"'bad dim')
    misaligned=[i for i,(a,b) in enumerate(zip(outer.tolist(), inner.tolist(), strict=False)) if int(a)"'!=bg or int(b)!=bg]
    aligned_nonbg=sum(1 for a,b in zip(outer.tolist(), inner.tolist(), strict=False) if int(a)!=bg and int(b)!=bg)
    misaligned_entry_counts.append(len(border_seq) - aligned_nonbg)

    out=mod.main(inp)
    used=0
    for color in border_seq:
        changed=np.count_nonzero((inp==bg) & (out==mod._palette_mapping(inp,bg)[0][color]))
        # count whether this palette key is actually used by at least one filled hole
        used_here=False
        for pts in mod.components_mask((inp==bg) & (~pal_mask), connectivity=4):
            if any(r==0 or c==0 or r==inp.shape[0]-1 or c==inp.shape[1]-1 for r,c in pts):
                continue
            adj=set()
            for r,c in pts:
                for rr,cc in mod.neighbors4(int(r), int(c)):
                    if 0<=rr<inp.shape[0] and 0<=cc<inp.shape[1] and not pal_mask[rr,cc] and int(inp[rr,cc])!=bg:
                        adj.add(int(inp[rr,cc]))
            if color in adj and np.any(out[[r for r,c in pts],[c for r,c in pts]] != bg):
                used_here=True
                break
        if used_here:
            used += 1
    used_misaligned_counts.append(used)

print('"'side_counts', dict(side_counts))
print('palette_length_counts', dict(len_counts))
print('misaligned_entries_min_max', min(misaligned_entry_counts), max(misaligned_entry_counts))
print('used_filled_sprite_count_min_max', min(used_misaligned_counts), max(used_misaligned_counts))
