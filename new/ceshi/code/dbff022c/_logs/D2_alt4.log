    96	def _start_cols(w: int, length: int, kind: str) -> range:
    97	    """All edge start columns that keep the diagonal of `length` cells in-bounds."""
    98	    if kind in ("top_dr", "bottom_ur"):
    99	        hi = w - length
   100	        if hi < 0:
   101	            return range(0)
   102	        return range(0, hi + 1)
   103	    lo = length - 1
   104	    if lo > w - 1:
   105	        return range(0)
   106	    return range(lo, w)
