   237	def main(grid: np.ndarray) -> np.ndarray:
   238	    """
   239	    Fill hollow sprites by reading a diagonal color legend that starts on the outer border.
   240	
   241	    Input structure:
   242	    - Background is the dominant border color. Several hollow sprites sit on that background.
   243	    - A sparse palette legend appears as a single diagonal chain of colored cells beginning on
   244	      the top or bottom edge; consecutive diagonal cell pairs encode (border color, fill color).
   245	
   246	    Rule:
   247	    - Detect the diagonal legend, read it from the boundary inward, and interpret every two
   248	      successive diagonal cells as one border→fill mapping.
   249	    - Find enclosed background regions that do not touch the global grid boundary.
   250	    - For each such region, measure the most common adjacent border color; if that color is a
   251	      palette key, fill the region with the mapped palette value.
   252	
   253	    Key insight:
   254	    - The legend is no longer a horizontal or vertical block. The crucial cue is the visible
   255	      diagonal ordering: parity along the inward diagonal determines which color is the key and
   256	      which is the fill value.
   257	    """
   258	    g = np.asarray(grid, dtype=int)
   259	    bg = _bg_boundary(g)
   260	
   261	    mapping, pal_mask = _palette_mapping(g, bg)
   262	    assert mapping, "main: palette mapping must be non-empty"
   263	
   264	    out = g.copy()
   265	    _fill_enclosed_bg_regions(out, bg, mapping, pal_mask)
   266	    return out
