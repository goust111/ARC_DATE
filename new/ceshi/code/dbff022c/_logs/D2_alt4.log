   109	def _isolated_points(g: np.ndarray, bg: int, pts: list[tuple[int, int]]) -> bool:
   110	    """
   111	    Palette cells should not be 4-neigh adjacent to same-colored non-palette cells.
   112	    The diagonal palette itself has no internal 4-neigh contacts, so this check focuses
   113	    entirely on keeping the legend separate from sprites.
   114	    """
   115	    h, w = g.shape
   116	    pal = np.zeros((h, w), dtype=bool)
   117	    for r, c in pts:
   118	        pal[r, c] = True
   119	
   120	    for r, c in pts:
   121	        v = int(g[r, c])
   122	        if v == bg:
   123	            return False
   124	        for rr, cc in neighbors4(r, c):
   125	            if 0 <= rr < h and 0 <= cc < w and not pal[rr, cc]:
   126	                if int(g[rr, cc]) == v:
   127	                    return False
   128	    return True
   129	
   130	
   131	def _best_palette(g: np.ndarray, bg: int) -> tuple[str, int, int]:
   132	    """
   133	    Find the diagonal palette legend.
   134	
   135	    Returns `(kind, start_col, num_pairs)` where `kind` determines the edge and diagonal
   136	    direction, `start_col` is the boundary column of the first palette cell, and
   137	    `num_pairs` is the number of (border, fill) pairs along that diagonal.
   138	    """
   139	    h, w = g.shape
   140	    max_pairs = min(4, h // 2, w // 2)
   141	    best = None  # (score, kind, start_col, num_pairs)
   142	
   143	    for kind in _PALETTE_KINDS:
   144	        for num_pairs in range(2, max_pairs + 1):
   145	            length = 2 * num_pairs
   146	            for start_col in _start_cols(w, length, kind):
   147	                pts = _diag_positions(g.shape, kind, start_col, length)
   148	                if pts is None:
   149	                    continue
   150	                vals = [int(g[r, c]) for r, c in pts]
   151	                if any(v == bg for v in vals):
   152	                    continue
   153	                border_keys = vals[0::2]
   154	                fill_values = vals[1::2]
   155	                if len(set(border_keys)) != num_pairs:
   156	                    continue
   157	                if len(set(fill_values)) != num_pairs:
   158	                    continue
   159	                if len(set(vals)) < 3:
   160	                    continue
   161	                if not _isolated_points(g, bg, pts):
   162	                    continue
   163	                score = (num_pairs, len(set(vals)))
   164	                cand = (score, kind, int(start_col), int(num_pairs))
   165	                if best is None or cand[0] > best[0]:
   166	                    best = cand
   167	
   168	    assert best is not None, "_best_palette must find a valid diagonal palette"
   169	    _, kind, start_col, num_pairs = best
   170	    return kind, start_col, num_pairs
   171	
   172	
   173	def _palette_mapping(g: np.ndarray, bg: int) -> tuple[dict[int, int], np.ndarray]:
   174	    """
   175	    Returns (mapping border->fill, palette_mask).
   176	    """
   177	    h, w = g.shape
   178	    kind, start_col, num_pairs = _best_palette(g, bg)
   179	    pts = _diag_positions(g.shape, kind, start_col, 2 * num_pairs)
   180	    assert pts is not None
   181	
   182	    pal_mask = np.zeros((h, w), dtype=bool)
   183	    mapping: dict[int, int] = {}
   184	    vals = []
   185	    for r, c in pts:
   186	        pal_mask[r, c] = True
   187	        vals.append(int(g[r, c]))
   188	
   189	    for border, fill in zip(vals[0::2], vals[1::2], strict=False):
   190	        mapping[int(border)] = int(fill)
   191	
   192	    return mapping, pal_mask
   193	
   194	
   195	def _fill_enclosed_bg_regions(out: np.ndarray, bg: int, mapping: dict[int, int], pal_mask: np.ndarray) -> None:
   196	    """
   197	    Find background regions (excluding the palette area) that do NOT touch the grid boundary,
   198	    and fill each region based on the most common adjacent border color (mapped via palette).
   199	    """
   200	    h, w = out.shape
   201	    bg_mask = (out == bg) & (~pal_mask)
   202	    comps = components_mask(bg_mask, connectivity=4)
   203	    for pts in comps:
   204	        touches_boundary = any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)
   205	        if touches_boundary:
   206	            continue
   207	
   208	        adj_counts: dict[int, int] = {}
   209	        for r, c in pts:
   210	            for rr, cc in neighbors4(int(r), int(c)):
   211	                if 0 <= rr < h and 0 <= cc < w:
   212	                    if pal_mask[rr, cc]:
   213	                        continue
   214	                    v = int(out[rr, cc])
   215	                    if v == bg:
   216	                        continue
   217	                    adj_counts[v] = adj_counts.get(v, 0) + 1
   218	        if not adj_counts:
   219	            continue
