new file mode 100644
index 0000000000000000000000000000000000000000..c4840187d5ade10b87012f8d121272acfedce8be
--- /dev/null
+++ b/ceshi/code/dbff022c/D2/1/code.py
@@ -0,0 +1,501 @@
+# Variant of dbff022c
+# Dimension: D2 — 调色板图例的位置与朝向 (symbol_instructions)
+# Change: 调色板为2xN或Nx2色块，位于网格边缘（上/下/左），根据所在边缘确定阅读方向：上边缘从上到下读，下边缘从下到上读，左... → 调色板为分散的颜色对而非连续色块
+
+"""
+Design analysis for the D2 variant
+==================================
+
+a) Concretization and behavior trace
+YAML-like summary:
+  variant_palette:
+    form: each legend entry is an isolated 2-cell domino on one chosen grid edge
+    side: exactly one of top/bottom/left/right per sample
+    reading:
+      top: outer row 0 is border color, row 1 is fill color
+      bottom: outer row H-1 is border color, row H-2 is fill color
+      left: outer col 0 is border color, col 1 is fill color
+      right: outer col W-1 is border color, col W-2 is fill color
+    spacing: dominoes are separated by at least one bg gap, so the legend is visibly
+      scattered instead of forming one compact 2xN or Nx2 block
+  preserved_parts:
+    sprites: hollow one-color sprites with enclosed bg holes
+    action: fill each hole according to its border color via the legend mapping
+
+Concrete trace:
+  Original top-edge case:
+    row0=[2,4,6,8], row1=[7,5,1,3] as one continuous 2x4 block.
+    Solver reads columns directly to form {2:7, 4:5, 6:1, 8:3}.
+  Variant top-edge case:
+    the same four pairs appear at columns 0,3,6,9 as isolated vertical dominoes
+    [(2 over 7), (4 over 5), (6 over 1), (8 over 3)].
+    Solver must first discover all isolated edge dominoes, then merge them into the same
+    mapping before it can fill the sprite interiors.
+
+b) Complexity calibration
+  The task still uses only 2-5 legend entries and 1-3 fillable sprites, so the mapping
+  remains learnable. The key change is geometric: the legend is disconnected. Keeping all
+  dominoes on one side prevents the rule from exploding into too many cases.
+
+c) Implicit-assumption audit of the original main()
+  _best_palette():
+    assumes one continuous 2xN/Nx2 palette slab. This is invalid now.
+  _palette_mapping():
+    assumes there is one contiguous border line and one contiguous fill line. Also invalid.
+  _fill_enclosed_bg_regions():
+    only needs a correct palette mask and a correct mapping, so it remains usable.
+  main():
+    still works if the new legend detector supplies a non-empty mapping and precise mask.
+
+d) Placement legality
+  Generator guarantees:
+    - every legend entry is a 2-cell 4-connected component
+    - each legend cell has no non-bg 4-neighbor except its partner, so sprites cannot be
+      mistaken for legend pieces
+    - all legend entries lie on the same side and are separated by at least one bg gap
+    - sprites keep at least one cell of padding from the legend occupancy mask
+
+e) Visual observability
+  A human can see repeated edge-anchored dominoes across examples, infer that each domino
+  is a color pair, and then connect sprite border colors to fill colors. No color-id order
+  is used; the rule is purely spatial.
+
+f) Visual cleanliness
+  The palette is not layered over sprites and does not form tangled composites. Each domino
+  is small, isolated, and aligned with the chosen edge, so the legend reads cleanly.
+
+g) Color-change inferability
+  The number of colors is still small. Exactly one distractor sprite has a border color not
+  present among the legend keys, so examples show both "fill" and "do not fill" behavior.
+
+Post-change solver assumptions that the generator must satisfy:
+  - all legend dominoes are on one side
+  - there are at least two legend dominoes
+  - border-key colors are unique
+  - every legend domino is an isolated 2-cell non-bg component
+"""
+
+import random
+
+import numpy as np
+
+from arc_utils import components_mask, neighbors4
+
+
+def _bg_boundary(g: np.ndarray) -> int:
+    """Most common color along the 1-cell outer border."""
+    border = np.concatenate([g[0, :], g[-1, :], g[1:-1, 0], g[1:-1, -1]])
+    vals, cnts = np.unique(border, return_counts=True)
+    return int(vals[cnts.argmax()])
+
+
+def _edge_pair_cells(side: str, idx: int, h: int, w: int) -> tuple[tuple[int, int], tuple[int, int]]:
+    if side == "top":
+        return (0, idx), (1, idx)
+    if side == "bottom":
+        return (h - 1, idx), (h - 2, idx)
+    if side == "left":
+        return (idx, 0), (idx, 1)
+    return (idx, w - 1), (idx, w - 2)
+
+
+def _is_isolated_domino(
+    g: np.ndarray, bg: int, a: tuple[int, int], b: tuple[int, int]
+) -> bool:
+    """True iff a,b are the only non-bg 4-neighbors of each other."""
+    h, w = g.shape
+    for (r, c), other in ((a, b), (b, a)):
+        if int(g[r, c]) == bg:
+            return False
+        for rr, cc in neighbors4(r, c):
+            if 0 <= rr < h and 0 <= cc < w and (rr, cc) != other and int(g[rr, cc]) != bg:
+                return False
+    return True
+
+
+def _collect_side_pairs(
+    g: np.ndarray, bg: int, side: str
+) -> list[tuple[tuple[int, int], tuple[int, int], int, int]]:
+    """Collect isolated edge dominoes for one side."""
+    h, w = g.shape
+    edge_len = w if side in ("top", "bottom") else h
+    pairs = []
+    for idx in range(edge_len):
+        outer, inner = _edge_pair_cells(side, idx, h, w)
+        if _is_isolated_domino(g, bg, outer, inner):
+            pairs.append((outer, inner, int(g[outer]), int(g[inner])))
+    return pairs
+
+
+def _palette_mapping(g: np.ndarray, bg: int) -> tuple[dict[int, int], np.ndarray]:
+    """
+    Returns (mapping border->fill, palette_mask) for scattered 2-cell legend entries.
+    """
+    h, w = g.shape
+    best = None
+
+    for side in ("top", "bottom", "left", "right"):
+        pairs = _collect_side_pairs(g, bg, side)
+        if len(pairs) < 2:
+            continue
+        border_keys = [border for _, _, border, _ in pairs]
+        if len(border_keys) != len(set(border_keys)):
+            continue
+        total_colors = len({col for _, _, border, fill in pairs for col in (border, fill)})
+        cand = ((len(pairs), total_colors), side, pairs)
+        if best is None or cand[0] > best[0]:
+            best = cand
+
+    assert best is not None, "_palette_mapping must find scattered edge legend pairs"
+    _, _, pairs = best
+
+    pal_mask = np.zeros((h, w), dtype=bool)
+    mapping: dict[int, int] = {}
+    for outer, inner, border, fill in pairs:
+        pal_mask[outer] = True
+        pal_mask[inner] = True
+        mapping[border] = fill
+
+    return mapping, pal_mask
+
+
+def _fill_enclosed_bg_regions(
+    out: np.ndarray, bg: int, mapping: dict[int, int], pal_mask: np.ndarray
+) -> None:
+    """
+    Find background regions (excluding the palette area) that do NOT touch the grid boundary,
+    and fill each region based on the most common adjacent border color (mapped via palette).
+    """
+    h, w = out.shape
+    bg_mask = (out == bg) & (~pal_mask)
+    comps = components_mask(bg_mask, connectivity=4)
+    for pts in comps:
+        touches_boundary = any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)
+        if touches_boundary:
+            continue
+
+        adj_counts: dict[int, int] = {}
+        for r, c in pts:
+            for rr, cc in neighbors4(int(r), int(c)):
+                if 0 <= rr < h and 0 <= cc < w:
+                    if pal_mask[rr, cc]:
+                        continue
+                    v = int(out[rr, cc])
+                    if v == bg:
+                        continue
+                    adj_counts[v] = adj_counts.get(v, 0) + 1
+        if not adj_counts:
+            continue
+
+        border = None
+        best = -1
+        for col, cnt in adj_counts.items():
+            if col not in mapping:
+                continue
+            if cnt > best:
+                best = cnt
+                border = col
+        if border is None:
+            continue
+
+        fill = int(mapping[border])
+        for r, c in pts:
+            out[r, c] = fill
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Fill hollow sprites' interiors using a scattered edge legend of color pairs.
+
+    Input structure:
+    - bg is the dominant boundary color, and the main objects are hollow single-color sprites.
+    - Instead of one compact 2xN or Nx2 palette block, the border->fill legend is split into
+      several isolated 2-cell dominoes scattered along one grid edge.
+
+    Rule:
+    - Detect all isolated 2-cell dominoes anchored on the same edge and read each one using
+      that edge's orientation: outer boundary cell = border color, inner cell = fill color.
+    - Assemble those dominoes into a border->fill mapping, then fill each enclosed bg hole by
+      looking up its dominant adjacent border color in that mapping.
+
+    Key insight:
+    - The legend is no longer a single connected palette region; the repeated edge-anchored
+      domino pattern is the cue that individual pieces must be collected and merged first.
+    """
+    g = np.asarray(grid, dtype=int)
+    bg = _bg_boundary(g)
+
+    mapping, pal_mask = _palette_mapping(g, bg)
+    assert mapping, "main: palette mapping must be non-empty"
+
+    out = g.copy()
+    _fill_enclosed_bg_regions(out, bg, mapping, pal_mask)
+    return out
+
+
+# --------------- generator (c) ---------------
+
+# -- Configuration constants --------------------------------------------------
+_GRID_H_MIN, _GRID_H_MAX = 4, 13
+_GRID_W_MIN, _GRID_W_MAX = 10, 15
+_SMALL_H_THRESHOLD = 6
+_SMALL_H_PALETTE_FLIP = 0.7
+_TINY_H_THRESHOLD = 5
+
+_PALETTE_N_MIN, _PALETTE_N_MAX = 2, 5
+
+_SPRITE_H_MAX = 7
+_SPRITE_W_MAX = 6
+_SPRITE_DIM_SUM_CAP = 10
+_SPRITE_CELL_MAX = 16
+_FILLED_SPRITE_MAX = 3
+
+_P_HORIZ_WALL = 0.3
+_P_VERT_WALL = 0.3
+_P_BORDER_REMOVAL = 0.4
+_P_DIAMOND = 0.2
+
+_MAX_RETRIES = 400
+# -- End configuration --------------------------------------------------------
+
+
+def _get_enclosed_holes(sprite: np.ndarray) -> list[np.ndarray]:
+    """Return bg components inside sprite bbox that do not touch the bbox boundary."""
+    h, w = sprite.shape
+    return [
+        pts
+        for pts in components_mask(~sprite, connectivity=4)
+        if not any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)
+    ]
+
+
+def _make_diamond() -> np.ndarray:
+    s = np.zeros((3, 3), dtype=bool)
+    s[0, 1] = s[1, 0] = s[1, 2] = s[2, 1] = True
+    return s
+
+
+def _make_hollow_sprite(h: int, w: int, rng: random.Random) -> np.ndarray | None:
+    """Create a hollow sprite with at least one enclosed hole and limited cell count."""
+    sprite = np.ones((h, w), dtype=bool)
+    if h >= 3 and w >= 3:
+        sprite[1:-1, 1:-1] = False
+
+    if h >= 5 and w >= 4 and rng.random() < _P_HORIZ_WALL:
+        br = rng.randint(2, h - 2)
+        n = rng.randint(1, w - 2)
+        s = rng.randint(1, w - n)
+        sprite[br, s : s + n] = True
+    if h >= 4 and w >= 5 and rng.random() < _P_VERT_WALL:
+        bc = rng.randint(2, w - 2)
+        n = rng.randint(1, h - 2)
+        s = rng.randint(1, h - n)
+        sprite[s : s + n, bc] = True
+
+    if rng.random() < _P_BORDER_REMOVAL:
+        bcells = [
+            (r, c)
+            for r in range(h)
+            for c in range(w)
+            if sprite[r, c] and (r in (0, h - 1) or c in (0, w - 1))
+        ]
+        rng.shuffle(bcells)
+        for cr, cc in bcells[: rng.randint(1, min(4, len(bcells)))]:
+            test = sprite.copy()
+            test[cr, cc] = False
+            if _get_enclosed_holes(test):
+                sprite = test
+
+    if not _get_enclosed_holes(sprite) or int(sprite.sum()) > _SPRITE_CELL_MAX:
+        return None
+    return sprite
+
+
+def _choose_colors(
+    rng: random.Random, n: int, num_filled: int
+) -> tuple[list[int], list[int], int, dict[int, int], list[int]]:
+    """Pick border/fill colors while avoiding identity maps for visibility."""
+    all_c = list(range(1, 10))
+    border_keys = rng.sample(all_c, n)
+
+    fill_values = None
+    for _ in range(60):
+        cand = rng.sample(all_c, n)
+        if all(b != f for b, f in zip(border_keys, cand, strict=False)):
+            fill_values = cand
+            break
+    if fill_values is None:
+        fill_values = rng.sample(all_c, n)
+
+    distractor_color = rng.choice([c for c in all_c if c not in border_keys])
+    mapping = dict(zip(border_keys, fill_values, strict=False))
+    filled_keys = rng.sample(border_keys, num_filled)
+    return border_keys, fill_values, distractor_color, mapping, filled_keys
+
+
+def _side_capacity(side: str, h: int, w: int) -> int:
+    edge_len = w if side in ("top", "bottom") else h
+    return (edge_len + 1) // 2
+
+
+def _sample_spaced_indices(edge_len: int, n: int, rng: random.Random) -> list[int]:
+    """Sample positions with at least one bg cell between consecutive picks."""
+    base = sorted(rng.sample(range(edge_len - n + 1), n))
+    return [v + i for i, v in enumerate(base)]
+
+
+def _place_scattered_palette(
+    grid: np.ndarray,
+    occ: np.ndarray,
+    side: str,
+    border_keys: list[int],
+    fill_values: list[int],
+    rng: random.Random,
+) -> None:
+    """Place isolated 2-cell legend dominoes on one chosen side."""
+    h, w = grid.shape
+    edge_len = w if side in ("top", "bottom") else h
+    positions = _sample_spaced_indices(edge_len, len(border_keys), rng)
+
+    for idx, border, fill in zip(positions, border_keys, fill_values, strict=False):
+        outer, inner = _edge_pair_cells(side, idx, h, w)
+        grid[outer] = border
+        grid[inner] = fill
+        rs = [outer[0], inner[0]]
+        cs = [outer[1], inner[1]]
+        occ[max(0, min(rs) - 1) : min(h, max(rs) + 2), max(0, min(cs) - 1) : min(w, max(cs) + 2)] = True
+
+
+def _find_valid_positions(
+    h: int, w: int, occ: np.ndarray, mask: np.ndarray, holes: list[np.ndarray]
+) -> list[tuple[int, int]]:
+    """Find sprite placements that preserve padding and keep holes away from the border."""
+    sh, sw = mask.shape
+    positions = []
+    for r0 in range(h - sh + 1):
+        for c0 in range(w - sw + 1):
+            if occ[max(0, r0 - 1) : min(h, r0 + sh + 1), max(0, c0 - 1) : min(w, c0 + sw + 1)].any():
+                continue
+            if any(
+                r0 + hr == 0 or c0 + hc == 0 or r0 + hr == h - 1 or c0 + hc == w - 1
+                for hpts in holes
+                for hr, hc in hpts
+            ):
+                continue
+            positions.append((r0, c0))
+    return positions
+
+
+def _paint_sprite(
+    grid: np.ndarray,
+    r0: int,
+    c0: int,
+    mask: np.ndarray,
+    color: int,
+    fill: int | None,
+    holes: list[np.ndarray],
+) -> None:
+    """Render border cells in color and hole cells in fill when requested."""
+    grid[r0 : r0 + mask.shape[0], c0 : c0 + mask.shape[1]][mask] = color
+    if fill is not None:
+        for hpts in holes:
+            for hr, hc in hpts:
+                grid[r0 + hr, c0 + hc] = fill
+
+
+def _choose_side(rng: random.Random, h: int, w: int) -> str:
+    feasible = [s for s in ("top", "bottom", "left", "right") if _side_capacity(s, h, w) >= _PALETTE_N_MIN]
+    if h <= _SMALL_H_THRESHOLD:
+        lr = [s for s in feasible if s in ("left", "right")]
+        tb = [s for s in feasible if s in ("top", "bottom")]
+        if lr and tb and rng.random() < _SMALL_H_PALETTE_FLIP:
+            return rng.choice(lr)
+    return rng.choice(feasible)
+
+
+def _gen_attempt() -> np.ndarray | None:
+    rng = random.Random()
+    bg = 0
+
+    h = rng.randint(_GRID_H_MIN, _GRID_H_MAX)
+    w = rng.randint(_GRID_W_MIN, _GRID_W_MAX)
+    side = _choose_side(rng, h, w)
+    n = rng.randint(_PALETTE_N_MIN, min(_PALETTE_N_MAX, _side_capacity(side, h, w)))
+
+    max_sh = min(_SPRITE_H_MAX, h)
+    max_sw = min(_SPRITE_W_MAX, w)
+    if h <= _TINY_H_THRESHOLD:
+        max_sh = 3
+
+    num_filled = rng.randint(1, min(_FILLED_SPRITE_MAX, n))
+    total_sprites = num_filled + 1
+
+    shapes = []
+    for _ in range(total_sprites):
+        sh = rng.randint(3, max_sh)
+        sw = rng.randint(3, max_sw)
+        if sh + sw > _SPRITE_DIM_SUM_CAP:
+            sw = max(3, _SPRITE_DIM_SUM_CAP - sh)
+        if sh == 3 and sw == 3 and rng.random() < _P_DIAMOND:
+            mask = _make_diamond()
+        else:
+            mask = _make_hollow_sprite(sh, sw, rng)
+        if mask is None:
+            return None
+        shapes.append(mask)
+
+    border_keys, fill_values, distractor_color, mapping, filled_keys = _choose_colors(rng, n, num_filled)
+
+    grid = np.full((h, w), bg, dtype=int)
+    occ = np.zeros((h, w), dtype=bool)
+    _place_scattered_palette(grid, occ, side, border_keys, fill_values, rng)
+
+    infos = []
+    for i, mask in enumerate(shapes):
+        if i < num_filled:
+            color = filled_keys[i]
+            fill = mapping[color]
+        else:
+            color = distractor_color
+            fill = None
+        infos.append((mask, color, fill))
+
+    placed = []
+    for mask, color, fill in infos:
+        holes = _get_enclosed_holes(mask)
+        positions = _find_valid_positions(h, w, occ, mask, holes)
+        if not positions:
+            return None
+        r0, c0 = rng.choice(positions)
+        _paint_sprite(grid, r0, c0, mask, color, fill, holes)
+        placed.append((r0, c0, mask, fill))
+        sh, sw = mask.shape
+        occ[max(0, r0 - 1) : min(h, r0 + sh + 1), max(0, c0 - 1) : min(w, c0 + sw + 1)] = True
+
+    output = grid.copy()
+    inp = grid.copy()
+    for r0, c0, mask, fill in placed:
+        if fill is not None:
+            for hpts in _get_enclosed_holes(mask):
+                for hr, hc in hpts:
+                    inp[r0 + hr, c0 + hc] = bg
+
+    border = np.concatenate([inp[0], inp[-1], inp[1:-1, 0], inp[1:-1, -1]])
+    vals, cnts = np.unique(border, return_counts=True)
+    if int(vals[cnts.argmax()]) != bg:
+        return None
+
+    try:
+        if np.array_equal(main(inp), output):
+            return inp
+    except Exception:
+        pass
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(_MAX_RETRIES):
+        result = _gen_attempt()
+        if result is not None:
+            return result
+    raise RuntimeError(f"Failed to generate input after {_MAX_RETRIES} attempts")

