from collections import Counter

new_path = '/home/lixinyu/snap/new/ceshi/code/dbff022c/D2/1/code.py'
old_path = '/home/lixinyu/snap/new/arc2_solver_select/dbff022c.py'

def load(path, name):
    spec = importlib.util.spec_from_file_location(name, path)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod

new = load(new_path, 'new_variant')
old = load(old_path, 'old_variant')

side_counts = Counter()
pair_counts = []
gap_counts = []
old_same = 0
old_fail = 0
samples = 100

for _ in range(samples):
    inp = new.generate_input()
    bg = new._bg_boundary(inp)
    best_side = None
    best_pairs = None
    best_score = None
    for side in ('top', 'bottom', 'left', 'right'):
        pairs = new._collect_side_pairs(inp, bg, side)
        keys = [b for _, _, b, _ in pairs]
        if len(pairs) >= 2 and len(keys) == len(set(keys)):
            score = (len(pairs), len(set(keys)))
            if best_score is None or score > best_score:
                best_score = score
                best_side = side
                best_pairs = pairs
    assert best_side is not None
    side_counts[best_side] += 1
    pair_counts.append(len(best_pairs))
    axis = [outer[1] if best_side in ('top', 'bottom') else outer[0] for outer, _, _, _ in best_pairs]
    gap_counts.append((max(axis) - min(axis) + 1) - len(axis))
