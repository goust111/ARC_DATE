@@ -0,0 +1,533 @@
+# Variant of dbff022c
+# Dimension: D2 — 调色板图例的位置与朝向 (symbol_instructions)
+# Change: 调色板为2xN或Nx2色块，位于网格边缘（上/下/左），根据所在边缘确定阅读方向：上边缘从上到下读，下边缘从下到上读，左... → 调色板为分散的颜色对而非连续色块
+
+"""
+Design analysis for the D2 variant
+==================================
+
+a) Concretization and behavior trace
+YAML-like summary:
+  variant_palette:
+    form: each legend entry is an isolated 2-cell domino anchored on the boundary
+    sides: entries are distributed across exactly two opposite edges per sample
+    reading:
+      top: outer row 0 is border color, row 1 is fill color
+      bottom: outer row H-1 is border color, row H-2 is fill color
+      left: outer col 0 is border color, col 1 is fill color
+      right: outer col W-1 is border color, col W-2 is fill color
+    spacing: dominoes on the same edge are separated by at least one bg gap
+  preserved_parts:
+    sprites: hollow one-color sprites with enclosed bg holes
+    action: fill each hole according to its border color via the legend mapping
+
+Concrete trace:
+  Original top-edge case:
+    one continuous 2x4 palette block gives {2:7, 4:5, 6:1, 8:3}.
+  Variant case:
+    two dominoes may sit on the top edge and two more on the bottom edge.
+    Solver must find all four isolated edge dominoes, read each by its local edge
+    orientation, then merge them into one mapping before filling sprite interiors.
+
+b) Complexity calibration
+  The task still uses only 2-5 legend entries and 2-3 fillable sprites. Splitting the
+  legend across exactly two opposite edges makes the D2 change clearly visible while keeping
+  the hypothesis space small enough for ARC-style inference.
+
+c) Implicit-assumption audit of the original main()
+  _best_palette():
+    assumes one continuous 2xN/Nx2 slab on one side. Invalid now.
+  _palette_mapping():
+    assumes one contiguous border line and one contiguous fill line. Invalid now.
+  _fill_enclosed_bg_regions():
+    only needs a correct palette mask and mapping, so it remains reusable.
+  main():
+    stays valid once legend detection is replaced by collecting many small edge dominoes.
+
+d) Placement legality
+  Generator guarantees:
+    - every legend entry is a 2-cell 4-connected component
+    - each legend cell has no non-bg 4-neighbor except its partner cell
+    - legend entries occupy exactly two opposite edges
+    - both used edges contribute to actually filled sprites
+    - sprites keep at least one cell of padding from legend occupancy
+
+e) Visual observability
+  Humans can see repeated boundary dominoes on two opposite sides and infer that each tiny
+  motif is a color pair. No ordering by color id is used; only visible edge location matters.
+
+f) Visual cleanliness
+  The palette never overlaps sprites. Each domino is isolated and aligned to an edge, so the
+  boundary legend remains tidy even though it is disconnected.
+
+g) Color-change inferability
+  The number of pairs is small, and one distractor sprite still lacks any legend key. Examples
+  therefore show both positive and negative cases for the same fill rule.
+
+Post-change solver assumptions that the generator must satisfy:
+  - legend dominoes are split across exactly two opposite sides
+  - there are at least two legend dominoes total
+  - border-key colors are unique
+  - every legend domino is an isolated 2-cell non-bg component
+  - both used sides supply at least one filled sprite
+"""
+
+import random
+
+import numpy as np
+
+from arc_utils import components_mask, neighbors4
+
+
+def _bg_boundary(g: np.ndarray) -> int:
+    """Most common color along the 1-cell outer border."""
+    border = np.concatenate([g[0, :], g[-1, :], g[1:-1, 0], g[1:-1, -1]])
+    vals, cnts = np.unique(border, return_counts=True)
+    return int(vals[cnts.argmax()])
+
+
+def _edge_pair_cells(side: str, idx: int, h: int, w: int) -> tuple[tuple[int, int], tuple[int, int]]:
+    if side == "top":
+        return (0, idx), (1, idx)
+    if side == "bottom":
+        return (h - 1, idx), (h - 2, idx)
+    if side == "left":
+        return (idx, 0), (idx, 1)
+    return (idx, w - 1), (idx, w - 2)
+
+
+def _is_isolated_domino(
+    g: np.ndarray, bg: int, a: tuple[int, int], b: tuple[int, int]
+) -> bool:
+    """True iff a,b are the only non-bg 4-neighbors of each other."""
+    h, w = g.shape
+    for (r, c), other in ((a, b), (b, a)):
+        if int(g[r, c]) == bg:
+            return False
+        for rr, cc in neighbors4(r, c):
+            if 0 <= rr < h and 0 <= cc < w and (rr, cc) != other and int(g[rr, cc]) != bg:
+                return False
+    return True
+
+
+def _collect_side_pairs(
+    g: np.ndarray, bg: int, side: str
+) -> list[tuple[str, tuple[int, int], tuple[int, int], int, int]]:
+    """Collect isolated legend dominoes on one specific edge."""
+    h, w = g.shape
+    edge_len = w if side in ("top", "bottom") else h
+    pairs = []
+    for idx in range(edge_len):
+        outer, inner = _edge_pair_cells(side, idx, h, w)
+        if _is_isolated_domino(g, bg, outer, inner):
+            pairs.append((side, outer, inner, int(g[outer]), int(g[inner])))
+    return pairs
+
+
+def _palette_mapping(g: np.ndarray, bg: int) -> tuple[dict[int, int], np.ndarray]:
+    """
+    Returns (mapping border->fill, palette_mask) for scattered 2-cell edge legend entries.
+    """
+    h, w = g.shape
+    pairs = []
+    used_sides = []
+    for side in ("top", "bottom", "left", "right"):
+        side_pairs = _collect_side_pairs(g, bg, side)
+        if side_pairs:
+            pairs.extend(side_pairs)
+            used_sides.append(side)
+
+    assert len(pairs) >= 2, "_palette_mapping must find at least two legend dominoes"
+    assert len(used_sides) == 2, "_palette_mapping expects legend dominoes on exactly two sides"
+    assert set(used_sides) in ({"top", "bottom"}, {"left", "right"}), "_palette_mapping expects opposite sides"
+
+    border_keys = [border for _, _, _, border, _ in pairs]
+    assert len(border_keys) == len(set(border_keys)), "_palette_mapping requires unique border keys"
+
+    pal_mask = np.zeros((h, w), dtype=bool)
+    mapping: dict[int, int] = {}
+    for _side, outer, inner, border, fill in pairs:
+        pal_mask[outer] = True
+        pal_mask[inner] = True
+        mapping[border] = fill
+
+    return mapping, pal_mask
+
+
+def _fill_enclosed_bg_regions(
+    out: np.ndarray, bg: int, mapping: dict[int, int], pal_mask: np.ndarray
+) -> None:
+    """
+    Find background regions (excluding the palette area) that do NOT touch the grid boundary,
+    and fill each region based on the most common adjacent border color (mapped via palette).
+    """
+    h, w = out.shape
+    bg_mask = (out == bg) & (~pal_mask)
+    comps = components_mask(bg_mask, connectivity=4)
+    for pts in comps:
+        touches_boundary = any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)
+        if touches_boundary:
+            continue
+
+        adj_counts: dict[int, int] = {}
+        for r, c in pts:
+            for rr, cc in neighbors4(int(r), int(c)):
+                if 0 <= rr < h and 0 <= cc < w:
+                    if pal_mask[rr, cc]:
+                        continue
+                    v = int(out[rr, cc])
+                    if v == bg:
+                        continue
+                    adj_counts[v] = adj_counts.get(v, 0) + 1
+        if not adj_counts:
+            continue
+
+        border = None
+        best = -1
+        for col, cnt in adj_counts.items():
+            if col not in mapping:
+                continue
+            if cnt > best:
+                best = cnt
+                border = col
+        if border is None:
+            continue
+
+        fill = int(mapping[border])
+        for r, c in pts:
+            out[r, c] = fill
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Fill hollow sprites' interiors using a scattered edge legend of color pairs.
+
+    Input structure:
+    - bg is the dominant boundary color, and the main objects are hollow single-color sprites.
+    - Instead of one compact 2xN or Nx2 palette block, the border->fill legend is split into
+      several isolated 2-cell dominoes scattered across two opposite grid edges.
+
+    Rule:
+    - Detect all isolated 2-cell dominoes on the boundary and read each one using its local
+      edge orientation: outer boundary cell = border color, inner cell = fill color.
+    - Merge the dominoes from both used edges into one border->fill mapping, then fill each
+      enclosed bg hole by looking up its dominant adjacent border color in that mapping.
+
+    Key insight:
+    - The legend is no longer a single connected palette region, or even confined to one side;
+      the repeated edge-anchored domino pattern is the cue to collect and merge all pieces.
+    """
+    g = np.asarray(grid, dtype=int)
+    bg = _bg_boundary(g)
+
+    mapping, pal_mask = _palette_mapping(g, bg)
+    assert mapping, "main: palette mapping must be non-empty"
+
+    out = g.copy()
+    _fill_enclosed_bg_regions(out, bg, mapping, pal_mask)
+    return out
+
+
+# --------------- generator (c) ---------------
+
+# -- Configuration constants --------------------------------------------------
+_GRID_H_MIN, _GRID_H_MAX = 4, 13
+_GRID_W_MIN, _GRID_W_MAX = 10, 15
+_SMALL_H_THRESHOLD = 6
+_SMALL_H_PALETTE_FLIP = 0.7
+_TINY_H_THRESHOLD = 5
+
+_PALETTE_N_MIN, _PALETTE_N_MAX = 2, 5
+
+_SPRITE_H_MAX = 7
+_SPRITE_W_MAX = 6
+_SPRITE_DIM_SUM_CAP = 10
+_SPRITE_CELL_MAX = 16
+_FILLED_SPRITE_MAX = 3
+
+_P_HORIZ_WALL = 0.3
+_P_VERT_WALL = 0.3
+_P_BORDER_REMOVAL = 0.4
+_P_DIAMOND = 0.2
+
+_MAX_RETRIES = 500
+# -- End configuration --------------------------------------------------------
+
+
+def _get_enclosed_holes(sprite: np.ndarray) -> list[np.ndarray]:
+    """Return bg components inside sprite bbox that do not touch the bbox boundary."""
+    h, w = sprite.shape
+    return [
+        pts
+        for pts in components_mask(~sprite, connectivity=4)
+        if not any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)
+    ]
+
+
+def _make_diamond() -> np.ndarray:
+    s = np.zeros((3, 3), dtype=bool)
+    s[0, 1] = s[1, 0] = s[1, 2] = s[2, 1] = True
+    return s
+
+
+def _make_hollow_sprite(h: int, w: int, rng: random.Random) -> np.ndarray | None:
+    """Create a hollow sprite with at least one enclosed hole and limited cell count."""
+    sprite = np.ones((h, w), dtype=bool)
+    if h >= 3 and w >= 3:
+        sprite[1:-1, 1:-1] = False
+
+    if h >= 5 and w >= 4 and rng.random() < _P_HORIZ_WALL:
+        br = rng.randint(2, h - 2)
+        n = rng.randint(1, w - 2)
+        s = rng.randint(1, w - n)
+        sprite[br, s : s + n] = True
+    if h >= 4 and w >= 5 and rng.random() < _P_VERT_WALL:
+        bc = rng.randint(2, w - 2)
+        n = rng.randint(1, h - 2)
+        s = rng.randint(1, h - n)
+        sprite[s : s + n, bc] = True
+
+    if rng.random() < _P_BORDER_REMOVAL:
+        bcells = [
+            (r, c)
+            for r in range(h)
+            for c in range(w)
+            if sprite[r, c] and (r in (0, h - 1) or c in (0, w - 1))
+        ]
+        rng.shuffle(bcells)
+        for cr, cc in bcells[: rng.randint(1, min(4, len(bcells)))]:
+            test = sprite.copy()
+            test[cr, cc] = False
+            if _get_enclosed_holes(test):
+                sprite = test
+
+    if not _get_enclosed_holes(sprite) or int(sprite.sum()) > _SPRITE_CELL_MAX:
+        return None
+    return sprite
+
+
+def _choose_colors(
+    rng: random.Random, n: int
+) -> tuple[list[int], list[int], int, dict[int, int]]:
+    """Pick border/fill colors and a distractor border color."""
+    all_c = list(range(1, 10))
+    border_keys = rng.sample(all_c, n)
+
+    fill_values = None
+    for _ in range(60):
+        cand = rng.sample(all_c, n)
+        if all(b != f for b, f in zip(border_keys, cand, strict=False)):
+            fill_values = cand
+            break
+    if fill_values is None:
+        fill_values = rng.sample(all_c, n)
+
+    distractor_color = rng.choice([c for c in all_c if c not in border_keys])
+    mapping = dict(zip(border_keys, fill_values, strict=False))
+    return border_keys, fill_values, distractor_color, mapping
+
+
+def _side_capacity(side: str, h: int, w: int) -> int:
+    edge_len = w if side in ("top", "bottom") else h
+    return (edge_len + 1) // 2
+
+
+def _sample_spaced_indices(edge_len: int, n: int, rng: random.Random) -> list[int]:
+    """Sample edge positions with at least one bg gap between consecutive picks."""
+    base = sorted(rng.sample(range(edge_len - n + 1), n))
+    return [v + i for i, v in enumerate(base)]
+
+
+def _choose_side_pair(rng: random.Random, h: int, w: int, n: int) -> tuple[str, str]:
+    options = []
+    if _side_capacity("top", h, w) + _side_capacity("bottom", h, w) >= n:
+        options.append(("top", "bottom"))
+    if _side_capacity("left", h, w) + _side_capacity("right", h, w) >= n:
+        options.append(("left", "right"))
+    assert options, "_choose_side_pair requires a feasible opposite-edge pair"
+
+    if h <= _SMALL_H_THRESHOLD:
+        if ("left", "right") in options and ("top", "bottom") in options and rng.random() < _SMALL_H_PALETTE_FLIP:
+            return ("left", "right")
+    return rng.choice(options)
+
+
+def _split_pair_count(
+    rng: random.Random, n: int, side_a: str, side_b: str, h: int, w: int
+) -> tuple[int, int]:
+    cap_a = _side_capacity(side_a, h, w)
+    cap_b = _side_capacity(side_b, h, w)
+    lo_a = max(1, n - cap_b)
+    hi_a = min(cap_a, n - 1)
+    count_a = rng.randint(lo_a, hi_a)
+    return count_a, n - count_a
+
+
+def _place_scattered_palette(
+    grid: np.ndarray,
+    occ: np.ndarray,
+    side: str,
+    entries: list[tuple[int, int]],
+    rng: random.Random,
+) -> list[int]:
+    """Place isolated legend dominoes on one chosen edge and return their slots."""
+    h, w = grid.shape
+    edge_len = w if side in ("top", "bottom") else h
+    positions = _sample_spaced_indices(edge_len, len(entries), rng)
+
+    for idx, (border, fill) in zip(positions, entries, strict=False):
+        outer, inner = _edge_pair_cells(side, idx, h, w)
+        grid[outer] = border
+        grid[inner] = fill
+        rs = [outer[0], inner[0]]
+        cs = [outer[1], inner[1]]
+        occ[max(0, min(rs) - 1) : min(h, max(rs) + 2), max(0, min(cs) - 1) : min(w, max(cs) + 2)] = True
+    return positions
+
+
+def _choose_filled_keys(
+    rng: random.Random, side_to_keys: dict[str, list[int]], num_filled: int
+) -> list[int]:
+    """Ensure each used side contributes at least one fillable sprite."""
+    filled = [rng.choice(keys) for keys in side_to_keys.values()]
+    remaining = num_filled - len(filled)
+    if remaining > 0:
+        pool = [key for keys in side_to_keys.values() for key in keys if key not in filled]
+        filled.extend(rng.sample(pool, remaining))
+    rng.shuffle(filled)
+    return filled
+
+
+def _find_valid_positions(
+    h: int, w: int, occ: np.ndarray, mask: np.ndarray, holes: list[np.ndarray]
+) -> list[tuple[int, int]]:
+    """Find sprite placements that preserve padding and keep holes away from the border."""
+    sh, sw = mask.shape
+    positions = []
+    for r0 in range(h - sh + 1):
+        for c0 in range(w - sw + 1):
+            if occ[max(0, r0 - 1) : min(h, r0 + sh + 1), max(0, c0 - 1) : min(w, c0 + sw + 1)].any():
+                continue
+            if any(
+                r0 + hr == 0 or c0 + hc == 0 or r0 + hr == h - 1 or c0 + hc == w - 1
+                for hpts in holes
+                for hr, hc in hpts
+            ):
+                continue
+            positions.append((r0, c0))
+    return positions
+
+
+def _paint_sprite(
+    grid: np.ndarray,
+    r0: int,
+    c0: int,
+    mask: np.ndarray,
+    color: int,
+    fill: int | None,
+    holes: list[np.ndarray],
+) -> None:
+    """Render border cells in color and hole cells in fill when requested."""
+    grid[r0 : r0 + mask.shape[0], c0 : c0 + mask.shape[1]][mask] = color
+    if fill is not None:
+        for hpts in holes:
+            for hr, hc in hpts:
+                grid[r0 + hr, c0 + hc] = fill
+
+
+def _gen_attempt() -> np.ndarray | None:
+    rng = random.Random()
+    bg = 0
+
+    h = rng.randint(_GRID_H_MIN, _GRID_H_MAX)
+    w = rng.randint(_GRID_W_MIN, _GRID_W_MAX)
+    n = rng.randint(_PALETTE_N_MIN, _PALETTE_N_MAX)
+    side_a, side_b = _choose_side_pair(rng, h, w, n)
+    count_a, count_b = _split_pair_count(rng, n, side_a, side_b, h, w)
+
+    max_sh = min(_SPRITE_H_MAX, h)
+    max_sw = min(_SPRITE_W_MAX, w)
+    if h <= _TINY_H_THRESHOLD:
+        max_sh = 3
+
+    num_filled = rng.randint(2, min(_FILLED_SPRITE_MAX, n))
+    total_sprites = num_filled + 1
+
+    shapes = []
+    for _ in range(total_sprites):
+        sh = rng.randint(3, max_sh)
+        sw = rng.randint(3, max_sw)
+        if sh + sw > _SPRITE_DIM_SUM_CAP:
+            sw = max(3, _SPRITE_DIM_SUM_CAP - sh)
+        if sh == 3 and sw == 3 and rng.random() < _P_DIAMOND:
+            mask = _make_diamond()
+        else:
+            mask = _make_hollow_sprite(sh, sw, rng)
+        if mask is None:
+            return None
+        shapes.append(mask)
+
+    border_keys, fill_values, distractor_color, mapping = _choose_colors(rng, n)
+    entries_a = list(zip(border_keys[:count_a], fill_values[:count_a], strict=False))
+    entries_b = list(zip(border_keys[count_a:], fill_values[count_a:], strict=False))
+
+    grid = np.full((h, w), bg, dtype=int)
+    occ = np.zeros((h, w), dtype=bool)
+    _place_scattered_palette(grid, occ, side_a, entries_a, rng)
+    _place_scattered_palette(grid, occ, side_b, entries_b, rng)
+
+    side_to_keys = {
+        side_a: [border for border, _ in entries_a],
+        side_b: [border for border, _ in entries_b],
+    }
+    filled_keys = _choose_filled_keys(rng, side_to_keys, num_filled)
+
+    infos = []
+    for i, mask in enumerate(shapes):
+        if i < num_filled:
+            color = filled_keys[i]
+            fill = mapping[color]
+        else:
+            color = distractor_color
+            fill = None
+        infos.append((mask, color, fill))
+
+    placed = []
+    for mask, color, fill in infos:
+        holes = _get_enclosed_holes(mask)
+        positions = _find_valid_positions(h, w, occ, mask, holes)
+        if not positions:
+            return None
+        r0, c0 = rng.choice(positions)
+        _paint_sprite(grid, r0, c0, mask, color, fill, holes)
+        placed.append((r0, c0, mask, fill))
+        sh, sw = mask.shape
+        occ[max(0, r0 - 1) : min(h, r0 + sh + 1), max(0, c0 - 1) : min(w, c0 + sw + 1)] = True
+
+    output = grid.copy()
+    inp = grid.copy()
+    for r0, c0, mask, fill in placed:
+        if fill is not None:
+            for hpts in _get_enclosed_holes(mask):
+                for hr, hc in hpts:
+                    inp[r0 + hr, c0 + hc] = bg
+
+    border = np.concatenate([inp[0], inp[-1], inp[1:-1, 0], inp[1:-1, -1]])
+    vals, cnts = np.unique(border, return_counts=True)
+    if int(vals[cnts.argmax()]) != bg:
+        return None
+
+    try:
+        if np.array_equal(main(inp), output):
+            return inp
+    except Exception:
+        pass
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(_MAX_RETRIES):
+        result = _gen_attempt()
+        if result is not None:
+            return result
+    raise RuntimeError(f"Failed to generate input after {_MAX_RETRIES} attempts")

