-#     - "The cells between outer and inner borders form a bg annulus in the input."
-#     - "The cavity inside the inner border stays bg in both input and output."
-#   behavior_trace:
-#     input_example:
-#       - "palette says red->yellow"
-#       - "sprite has red outer frame, blue inner frame, black annulus, black inner cavity"
-#     old_solver_behavior:
-#       - "collect every enclosed bg component"
-#       - "fill the component adjacent to a palette color"
-#       - "this is unsafe now because the annulus touches two frame colors and the innermost cavity must remain bg"
-#     new_solver_behavior:
