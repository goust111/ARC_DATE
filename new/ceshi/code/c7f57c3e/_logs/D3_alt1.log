+
+def _anchor_union_layout(patch_a: np.ndarray, patch_b: np.ndarray) -> tuple[int, int, int, int]:
+    """Reserve box around a shared anchor top-left that can host either patch."""
+    a0r, a0c, _a1r, _a1c = _anchor_bbox(patch_a)
