   128	
   129	def _place_by_anchor(out: np.ndarray, arr: np.ndarray, anchor_pos: tuple[int, int], bg: int) -> None:
   130	    """Place a sprite so that its anchor top-left lands on anchor_pos."""
   131	    ar0, ac0, _ar1, _ac1 = _pick_anchor_bbox(arr, bg)
   132	    top = int(anchor_pos[0] - ar0)
   133	    left = int(anchor_pos[1] - ac0)
   134	    paste(out, arr, top, left, transparent=bg)
