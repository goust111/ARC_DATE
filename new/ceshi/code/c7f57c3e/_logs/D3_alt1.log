   155	def main(grid: np.ndarray) -> np.ndarray:
   156	    """
   157	    Swap paired sprites by moving each whole sprite to its nearby opposite prototype's position.
   158	
   159	    Input structure:
   160	    - bg is the most common color. Two distinct multicolor sprite prototypes appear at two integer scales.
   161	    - The board contains four sprites total: two proto_A instances and two proto_B instances, arranged as two local A/B pairs.
   162	
   163	    Rule:
   164	    - Recover the two base prototypes from the smallest sprites, then classify every placed sprite by prototype and scale.
   165	    - Pair proto_A sprites with proto_B sprites by minimum total anchor-distance matching, then exchange the matched anchor locations.
   166	
   167	    Key insight:
   168	    - This variant no longer redraws sprites in place. The stable object identity is the whole observed sprite array, and the stable location descriptor is the color-1 anchor; solving the task means recovering which opposite-pattern sprites are local partners and then swapping those anchor positions.
   169	    """
   170	    g = np.asarray(grid, dtype=int)
   171	    bg = get_bg(g)
   172	
   173	    comps = components_mask(g != bg, connectivity=8)
   174	    assert len(comps) >= 2, "grid must contain at least 2 sprite components"
   175	
   176	    sprites = []
   177	    for pts in comps:
   178	        r0, c0, r1, c1 = bbox_coords(pts)
   179	        arr = g[r0 : r1 + 1, c0 : c1 + 1].copy()
   180	        sprites.append({"pts": pts, "bbox": (r0, c0, r1, c1), "arr": arr})
   181	    sprites.sort(key=lambda s: (s["bbox"][0], s["bbox"][1]))
   182	
   183	    areas = [int((s["bbox"][2] - s["bbox"][0] + 1) * (s["bbox"][3] - s["bbox"][1] + 1)) for s in sprites]
   184	    min_area = min(areas)
   185	    base = [s for s, a in zip(sprites, areas, strict=False) if a == min_area]
   186	    uniq: dict[tuple[int, ...], np.ndarray] = {}
   187	    for s in base:
   188	        key = tuple(s["arr"].ravel().tolist())
   189	        if key not in uniq:
   190	            uniq[key] = s["arr"]
   191	    assert len(uniq) == 2, "smallest-area sprites must yield exactly 2 distinct prototype patterns"
   192	
   193	    proto_keys = list(uniq.keys())[:2]
   194	    protos = [uniq[proto_keys[0]], uniq[proto_keys[1]]]
   195	
   196	    anc0 = _pick_anchor_bbox(protos[0], bg)
   197	    anc1 = _pick_anchor_bbox(protos[1], bg)
   198	    base_anchor_hw0 = (anc0[2] - anc0[0] + 1, anc0[3] - anc0[1] + 1)
   199	    base_anchor_hw1 = (anc1[2] - anc1[0] + 1, anc1[3] - anc1[1] + 1)
   200	    assert base_anchor_hw0 == base_anchor_hw1, "prototypes must share the same anchor bbox size"
   201	
   202	    by_type: dict[int, list[dict]] = defaultdict(list)
   203	    for sprite in sprites:
   204	        scale = _infer_scale(sprite["arr"], base_anchor_hw0, bg)
   205	        type_idx = _match_prototype(g, sprite, protos, scale, bg)
   206	        sprite["scale"] = scale
   207	        sprite["type_idx"] = type_idx
   208	        sprite["anchor_pos"] = _anchor_top_left_global(sprite["bbox"], sprite["arr"], bg)
   209	        by_type[type_idx].append(sprite)
   210	
   211	    out = g.copy()
   212	    for sprite in sprites:
   213	        for rr, cc in sprite["pts"]:
   214	            out[rr, cc] = bg
   215	
   216	    group_a = sorted(by_type.get(0, []), key=lambda s: s["anchor_pos"])
   217	    group_b = sorted(by_type.get(1, []), key=lambda s: s["anchor_pos"])
   218	    assert len(group_a) == len(group_b) and len(group_a) > 0, "grid must contain balanced A/B sprites"
   219	    for sa, sb in _best_opposite_pairing(group_a, group_b):
   220	        _place_by_anchor(out, sa["arr"], sb["anchor_pos"], bg)
   221	        _place_by_anchor(out, sb["arr"], sa["anchor_pos"], bg)
   222	
   223	    return out
   224	
