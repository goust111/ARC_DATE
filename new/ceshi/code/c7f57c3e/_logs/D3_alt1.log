    88	
    89	def _match_prototype(
    90	    grid: np.ndarray,
    91	    sprite: dict,
    92	    protos: list[np.ndarray],
    93	    scale: int,
    94	    bg: int,
    95	) -> int:
    96	    """Score which prototype matches the observed sprite when anchor-aligned."""
    97	    h, w = grid.shape
    98	    r0, c0, _r1, _c1 = sprite["bbox"]
    99	    arr = sprite["arr"]
   100	    ar0, ac0, _ar1, _ac1 = _pick_anchor_bbox(arr, bg)
   101	
   102	    best_idx = 0
   103	    best_score = -1
   104	    for idx, proto in enumerate(protos):
   105	        sp = _scale_nn(proto, scale)
   106	        pr0, pc0, _pr1, _pc1 = _pick_anchor_bbox(proto, bg)
   107	        pr0 *= scale
   108	        pc0 *= scale
   109	        top = (r0 + ar0) - pr0
   110	        left = (c0 + ac0) - pc0
   111	
   112	        rr0 = max(0, top)
   113	        cc0 = max(0, left)
   114	        rr1 = min(h, top + sp.shape[0])
   115	        cc1 = min(w, left + sp.shape[1])
   116	        if rr0 >= rr1 or cc0 >= cc1:
   117	            continue
   118	
   119	        sub_g = grid[rr0:rr1, cc0:cc1]
   120	        sub_p = sp[(rr0 - top) : (rr1 - top), (cc0 - left) : (cc1 - left)]
   121	        mask = sub_p != bg
   122	        score = int(np.sum(sub_g[mask] == sub_p[mask])) if np.any(mask) else 0
   123	        if score > best_score:
   124	            best_score = score
   125	            best_idx = idx
   126	    return best_idx
