+    best_score = None
+    for perm in itertools.permutations(range(len(group_b))):
+        score = 0
+        for ia, ib in enumerate(perm):
+            ra, ca = group_a[ia]["anchor_pos"]
+            rb, cb = group_b[ib]["anchor_pos"]
+            score += abs(ra - rb) + abs(ca - cb)
