   136	
   137	def _best_opposite_pairing(group_a: list[dict], group_b: list[dict]) -> list[tuple[dict, dict]]:
   138	    """Minimum-total-distance bipartite pairing between A and B sprites."""
   139	    assert len(group_a) == len(group_b) and len(group_a) > 0
   140	    best_perm = None
   141	    best_score = None
   142	    for perm in itertools.permutations(range(len(group_b))):
   143	        score = 0
   144	        for ia, ib in enumerate(perm):
   145	            ra, ca = group_a[ia]["anchor_pos"]
   146	            rb, cb = group_b[ib]["anchor_pos"]
   147	            score += abs(ra - rb) + abs(ca - cb)
   148	        if best_score is None or score < best_score:
   149	            best_score = score
   150	            best_perm = perm
   151	    assert best_perm is not None
   152	    return [(group_a[i], group_b[j]) for i, j in enumerate(best_perm)]
