+        output_types = input_types[::-1]
+
+        for anchor_pos, type_idx in zip(anchors, input_types, strict=True):
+            _paste_at_anchor(inp, _scale(protos[type_idx], scale), anchor_pos, bg)
+        for anchor_pos, type_idx in zip(anchors, output_types, strict=True):
+            _paste_at_anchor(out, _scale(protos[type_idx], scale), anchor_pos, bg)
+
+    try:
+        if np.array_equal(main(inp), out):
+            return inp
+    except Exception:
+        return None
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
