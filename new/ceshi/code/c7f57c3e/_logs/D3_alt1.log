+    """Place a sprite so that its anchor top-left lands on anchor_pos."""
+    ar0, ac0, _ar1, _ac1 = _pick_anchor_bbox(arr, bg)
+    top = int(anchor_pos[0] - ar0)
+    left = int(anchor_pos[1] - ac0)
