+def _best_opposite_pairing(group_a: list[dict], group_b: list[dict]) -> list[tuple[dict, dict]]:
+    """Minimum-total-distance bipartite pairing between A and B sprites."""
+    assert len(group_a) == len(group_b) and len(group_a) > 0
