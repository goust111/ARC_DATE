    82	    assert inst_h % base_h == 0 and inst_w % base_w == 0, "anchor bbox must scale integrally"
    83	    scale_h = inst_h // base_h
    84	    scale_w = inst_w // base_w
    85	    assert scale_h == scale_w and scale_h >= 1, "sprite scale must be a positive integer"
    86	    return int(scale_h)
