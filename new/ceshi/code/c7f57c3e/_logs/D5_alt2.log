   342	    a_cols = random.sample(pool, 2)
   343	    remaining = [c for c in pool if c not in a_cols]
   344	    if random.random() < COLOR_SHARE_PROB:
   345	        b_cols = [random.choice(a_cols), random.choice(remaining)]
   346	        random.shuffle(b_cols)
   347	    else:
   348	        b_cols = random.sample(remaining, 2)
   349	
   350	    def _colorize(lab: np.ndarray, cols: list[int]) -> np.ndarray:
