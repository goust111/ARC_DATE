   364	def _bboxes_separated(bboxes: list[tuple[int, int, int, int]], padding: int) -> bool:
   365	    for i, (r0, c0, r1, c1) in enumerate(bboxes):
   366	        for rr0, cc0, rr1, cc1 in bboxes[i + 1 :]:
   367	            rows_hit = _intervals_overlap(r0, r1, rr0, rr1, padding)
   368	            cols_hit = _intervals_overlap(c0, c1, cc0, cc1, padding)
