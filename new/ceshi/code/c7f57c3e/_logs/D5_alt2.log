   378	def _distribute_lane_lefts(n: int, widths: list[int]) -> list[int] | None:
   379	    total = sum(widths) + LANE_GAP * (len(widths) - 1) + 2 * INPUT_BORDER
   380	    if total > n:
   381	        return None
   382	    slack = n - total
   383	    extras = np.random.multinomial(slack, np.ones(len(widths) + 1) / (len(widths) + 1))
   384	    lefts = []
   385	    c = INPUT_BORDER + int(extras[0])
   386	    for i, width in enumerate(widths):
   387	        lefts.append(c)
   388	        c += int(width)
   389	        if i < len(widths) - 1:
   390	            c += LANE_GAP + int(extras[i + 1])
   391	    return lefts
