   352	        proto[lab == 1] = 1
   353	        proto[lab == 2] = cols[0]
   354	        proto[lab == 3] = cols[1]
   355	        return proto
   356	
   357	    return _colorize(labels, a_cols), _colorize(np.flipud(labels), b_cols)
