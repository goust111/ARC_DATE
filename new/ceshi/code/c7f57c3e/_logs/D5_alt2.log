+    )
+    lane_width_floor = sum(
+        max(max(inst["input_patch"].shape[1]), max(inst["output_patch"].shape[1]))
+        for inst in sorted(instances, key=lambda d: d["scale"], reverse=True)[:2]
+    )
+    min_n = max(
+        GRID_SIZE_MIN,
+        max_dim + GRID_MARGIN_FOR_SPRITES,
