   233	def main(grid: np.ndarray) -> np.ndarray:
   234	    """
   235	    Swap every sprite to the opposite prototype, then let the swapped sprite fall straight down.
   236	
   237	    Input structure:
   238	    - bg = most common color. Two distinct small sprite patterns (prototypes) appear at various scales.
   239	    - Each connected sprite instance is a scaled copy of one prototype and contains a color-1 anchor region.
   240	
   241	    Rule:
   242	    - Recover the two prototype patterns from the smallest sprites, then identify each instance's prototype and integer scale.
   243	    - Replace each instance with the other prototype at the same scale, aligned by the color-1 anchor bbox just as in the original task.
   244	    - After swapping, drop every replacement vertically until it hits the bottom edge or an already settled replacement.
   245	
   246	    Key insight: The anchor still determines which swapped patch belongs to each sprite and where that patch starts, but the final destination is no longer "stay near the old sprite" — gravity reorders the vertical layout into stable bottom-up stacks.
   247	    """
   248	    g = np.asarray(grid, dtype=int)
   249	    bg = get_bg(g)
   250	    replacements = _prepare_replacements(g, bg)
   251	    out, _landed = _settle_replacements(g.shape, bg, replacements)
   252	    return out
