+    if _count_supported_replacements(landed, bg, inp.shape) < 1:
+        return None
+
+    try:
+        if np.array_equal(main(inp), expected_out):
+            return inp
+    except Exception:
+        return None
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
