+def _can_place(board: np.ndarray, patch: np.ndarray, top: int, left: int, bg: int) -> bool:
+    H, W = board.shape
+    ph, pw = patch.shape
+    if top < 0 or left < 0 or top + ph > H or left + pw > W:
+        return False
+    sub = board[top : top + ph, left : left + pw]
+    return not bool(((patch != bg) & (sub != bg)).any())
