   308	def _make_labels() -> np.ndarray:
   309	    h, w = random.choice(PROTO_SHAPES)
   310	
   311	    counts = {1: 1, 2: 1, 3: 1}
   312	    if h > 3:
   313	        counts[random.choice([1, 2, 3])] += h - 3
   314	    roles = []
   315	    for role in random.sample([1, 2, 3], 3):
   316	        roles.extend([role] * counts[role])
   317	
   318	    weights_by_role = {1: ANCHOR_ROW_WEIGHTS, 2: VARIABLE_ROW_WEIGHTS, 3: VARIABLE_ROW_WEIGHTS}
   319	    masks = []
   320	    for role in roles:
   321	        kinds, wts = zip(*weights_by_role[role])
   322	        masks.append(_row_mask(random.choices(kinds, weights=wts)[0], w))
   323	
   324	    if not any(mask[0] or mask[-1] for mask in masks):
   325	        i = random.randrange(h)
   326	        masks[i] = _row_mask("outer", w) if roles[i] == 1 and random.random() < OUTER_FIXUP_PROB else _row_mask("full", w)
   327	
   328	    if all(all(mask) for mask in masks):
   329	        masks[random.randrange(h)] = _row_mask("center", w)
   330	
   331	    labels = np.zeros((h, w), dtype=int)
   332	    for r, (role, mask) in enumerate(zip(roles, masks)):
   333	        for c, bit in enumerate(mask):
