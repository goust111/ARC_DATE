+# --------------- generator (o5x) ---------------
+
+# --- CFG: canvas ---
+GRID_SIZE_MIN = 18
+GRID_SIZE_MAX = 28
+GRID_MARGIN_FOR_SPRITES = 7
+
+# --- CFG: prototypes ---
+PROTO_SHAPES = [(4, 3), (3, 4), (4, 4)]
+BG_CHOICES = [2, 3, 4, 5, 6, 7, 8, 9]
+
+# --- CFG: row-mask weights ---
