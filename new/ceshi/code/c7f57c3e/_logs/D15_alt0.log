+            pr0 *= scale
+            pc0 *= scale
+            top = (r0 + ar0) - pr0
+            left = (c0 + ac0) - pc0
+
+            rr0 = max(0, top)
+            cc0 = max(0, left)
+            rr1 = min(h, top + sp.shape[0])
+            cc1 = min(w, left + sp.shape[1])
+            if rr0 >= rr1 or cc0 >= cc1:
+                continue
+            sub_g = body[rr0:rr1, cc0:cc1]
+            sub_p = sp[(rr0 - top) : (rr1 - top), (cc0 - left) : (cc1 - left)]
+            m = sub_p != bg
+            if np.any(m):
