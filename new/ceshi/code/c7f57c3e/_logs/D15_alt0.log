+    for curr_type, scale in instances:
+        input_patch = _scale(_colorize_labels(structs[curr_type], bg, src_pairs[curr_type]), scale)
+        output_patch = _scale(_colorize_labels(structs[1 - curr_type], bg, dst_pairs[curr_type]), scale)
