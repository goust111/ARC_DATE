+
+        sp = _scale_nn(repl, scale)
+        pr0, pc0, _pr1, _pc1 = _pick_anchor_bbox(repl, bg)
+        pr0 *= scale
+        pc0 *= scale
+        top = (r0 + ar0) - pr0
+        left = (c0 + ac0) - pc0
+
+        rr0 = max(0, top)
+        cc0 = max(0, left)
+        rr1 = min(h, top + sp.shape[0])
+        cc1 = min(w, left + sp.shape[1])
+        sub_p = sp[(rr0 - top) : (rr1 - top), (cc0 - left) : (cc1 - left)]
+        m = sub_p != bg
+        out_slice = out[rr0:rr1, cc0:cc1]
+        out_slice[m] = sub_p[m]
