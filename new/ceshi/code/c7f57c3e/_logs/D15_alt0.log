+    out = np.full(arr.shape, int(bg), dtype=int)
+    out[arr == 1] = 1
+    out[arr == int(source_pair[0])] = 2
+    out[arr == int(source_pair[1])] = 3
+    return out
+
+
+def main(grid: np.ndarray) -> np.ndarray:
