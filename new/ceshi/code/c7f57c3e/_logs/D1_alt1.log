   111	def main(grid: np.ndarray) -> np.ndarray:
   112	    """
   113	    Swap the prototype assignment between the small-sprite group and the large-sprite group.
   114	
   115	    Input structure:
   116	    - bg = most common color. Two distinct multicolor prototypes appear as separated sprite components.
   117	    - Sprites come in exactly two visible size levels (small vs large), and all sprites of the same size share one prototype pattern.
   118	
   119	    Rule:
   120	    - Split sprites into the small group and the large group by bounding-box area.
   121	    - Read which prototype pattern the small group currently uses and which prototype pattern the large group currently uses.
   122	    - Replace every small sprite with the large-group prototype and every large sprite with the small-group prototype, preserving each sprite's own scale and anchor alignment.
   123	
   124	    Key insight: Prototype identity is no longer attached to each sprite individually; it is attached to a size class, so the solver must measure size first and then exchange the two group-level patterns.
   125	    """
   126	    g = np.asarray(grid, dtype=int)
   127	    h, w = g.shape
   128	    bg = get_bg(g)
   129	
   130	    comps = components_mask(g != bg, connectivity=8)
   131	    assert len(comps) >= 4, "grid must contain multiple sprites from both size groups"
   132	
   133	    sprites = []
   134	    for pts in comps:
   135	        r0, c0, r1, c1 = bbox_coords(pts)
   136	        arr = g[r0 : r1 + 1, c0 : c1 + 1].copy()
   137	        sprites.append({"pts": pts, "bbox": (r0, c0, r1, c1), "arr": arr})
   138	
   139	    areas = [_bbox_area(s["bbox"]) for s in sprites]
   140	    area_levels = sorted(set(areas))
   141	    assert len(area_levels) == 2, "variant expects exactly two bbox-area levels"
   142	    small_area, large_area = area_levels
   143	
   144	    small_sprites = [s for s, area in zip(sprites, areas, strict=False) if area == small_area]
   145	    large_sprites = [s for s, area in zip(sprites, areas, strict=False) if area == large_area]
   146	    assert len(small_sprites) >= 2 and len(large_sprites) >= 2, "both size groups must have repeated support"
   147	
   148	    small_proto = small_sprites[0]["arr"].copy()
   149	    base_h, base_w = small_proto.shape
   150	
   151	    large_h, large_w = large_sprites[0]["arr"].shape
   152	    scale_h = large_h // base_h
   153	    scale_w = large_w // base_w
   154	    assert scale_h == scale_w and scale_h >= 2, "large sprite must be an integer upscale of the small prototype size"
   155	    large_scale = int(scale_h)
   156	    large_proto = _downscale_nn(large_sprites[0]["arr"], large_scale)
   157	
   158	    for s in small_sprites[1:]:
   159	        assert np.array_equal(s["arr"], small_proto), "all small sprites must share one prototype"
   160	    for s in large_sprites:
   161	        norm = _downscale_nn(s["arr"], large_scale)
   162	        assert np.array_equal(norm, large_proto), "all large sprites must share one normalized prototype"
   163	    assert not np.array_equal(small_proto, large_proto), "the two size groups must show different patterns"
   164	
   165	    out = g.copy()
   166	
   167	    for s, area in zip(sprites, areas, strict=False):
   168	        r0, c0, _r1, _c1 = s["bbox"]
   169	        arr = s["arr"]
   170	        target_proto = large_proto if area == small_area else small_proto
   171	        scale = int(arr.shape[0] // base_h)
   172	        assert arr.shape[1] == base_w * scale, "sprite width must follow the same integer scale"
   173	
   174	        anc = _pick_anchor_bbox(arr, bg)
   175	        ar0, ac0, _ar1, _ac1 = anc
   176	
   177	        for rr, cc in s["pts"]:
   178	            out[int(rr), int(cc)] = bg
   179	
   180	        scaled_target = _scale_nn(target_proto, scale)
   181	        target_anchor = _pick_anchor_bbox(target_proto, bg)
   182	        pr0, pc0, _pr1, _pc1 = target_anchor
   183	        pr0 *= scale
   184	        pc0 *= scale
   185	        top = (r0 + ar0) - pr0
   186	        left = (c0 + ac0) - pc0
   187	
   188	        ph, pw = scaled_target.shape
   189	        rr0 = max(0, top)
   190	        cc0 = max(0, left)
   191	        rr1 = min(h, top + ph)
   192	        cc1 = min(w, left + pw)
   193	        sub_p = scaled_target[(rr0 - top) : (rr1 - top), (cc0 - left) : (cc1 - left)]
   194	        mask = sub_p != bg
   195	        out_slice = out[rr0:rr1, cc0:cc1]
   196	        out_slice[mask] = sub_p[mask]
   197	        out[rr0:rr1, cc0:cc1] = out_slice
   198	
   199	    return out
