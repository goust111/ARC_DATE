+    """Return union size and top-left offsets when anchor-aligning target to source."""
+    sa0, sb0, _sa1, _sb1 = _pick_anchor_bbox(source_patch, bg)
+    ta0, tb0, _ta1, _tb1 = _pick_anchor_bbox(target_patch, bg)
+    dr = int(sa0 - ta0)
+    dc = int(sb0 - tb0)
