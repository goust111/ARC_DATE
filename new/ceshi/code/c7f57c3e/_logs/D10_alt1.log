    67	def _reduce_nn(arr: np.ndarray, scale: int) -> np.ndarray:
    68	    """Inverse of nearest-neighbor scaling for perfectly replicated blocks."""
    69	    if scale <= 1:
    70	        return arr.copy()
    71	    h, w = arr.shape
    72	    assert h % scale == 0 and w % scale == 0, "scaled sprite must divide evenly by its scale"
    73	    reduced = arr[::scale, ::scale].copy()
    74	    for r in range(reduced.shape[0]):
    75	        for c in range(reduced.shape[1]):
    76	            block = arr[r * scale : (r + 1) * scale, c * scale : (c + 1) * scale]
    77	            assert np.all(block == reduced[r, c]), "sprite blocks must be constant under NN scaling"
    78	    return reduced
