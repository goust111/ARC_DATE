   136	def main(grid: np.ndarray) -> np.ndarray:
   137	    """
   138	    Copy the singleton group's pattern onto every majority sprite, and send the majority pattern back to the singleton.
   139	
   140	    Input structure:
   141	    - bg is the dominant color. Exactly two sprite prototypes are present, but their counts are asymmetric: one prototype appears 2-3 times and the other appears exactly once.
   142	    - Every sprite is an integer-scaled nearest-neighbor copy of one prototype and contains a color-1 anchor region. Only the majority prototype is guaranteed to appear at the smallest scale.
   143	
   144	    Rule:
   145	    - Infer the common base anchor size from the smallest anchor bbox, recover each sprite's scale, and shrink every sprite back to its base prototype.
   146	    - Group identical reduced prototypes, identify the majority group and the singleton group by occurrence count, then swap the two group patterns.
   147	    - Repaint every sprite with the opposite group's prototype at its own original scale, aligned so the color-1 anchor stays fixed in place.
   148	
   149	    Key insight:
   150	    - The variant is no longer solved by reading both prototypes directly from the smallest whole sprites, because only the majority group appears there.
   151	    - The stable color-1 anchor reveals each sprite's scale, so even the lone minority sprite can be reduced to its base form and then broadcast to all majority copies.
   152	    """
   153	    g = np.asarray(grid, dtype=int)
   154	    h, w = g.shape
   155	    bg = get_bg(g)
   156	
   157	    sprites = _extract_sprites(g, bg)
   158	    records, groups, _base_anchor = _prepare_records(sprites, bg)
   159	    assert len(groups) == 2, "grid must contain exactly 2 prototype families"
   160	
   161	    ordered = sorted(groups.items(), key=lambda item: len(item[1]["records"]))
   162	    singleton_key, singleton_group = ordered[0]
   163	    majority_key, majority_group = ordered[1]
   164	    assert len(singleton_group["records"]) == 1, "one prototype family must be the singleton donor"
   165	    assert len(majority_group["records"]) >= 2, "the other prototype family must be the majority recipient"
   166	
   167	    replacement_by_key = {
   168	        majority_key: singleton_group["proto"],
   169	        singleton_key: majority_group["proto"],
   170	    }
   171	
   172	    out = g.copy()
   173	    for rec in records:
   174	        for rr, cc in rec["pts"]:
   175	            out[rr, cc] = bg
   176	
   177	    for rec in records:
   178	        r0, c0, _r1, _c1 = rec["bbox"]
   179	        ar0, ac0, _ar1, _ac1 = rec["anchor"]
   180	        scale = rec["scale"]
   181	        proto = replacement_by_key[rec["key"]]
   182	        scaled_proto = _scale_nn(proto, scale)
   183	        pr0, pc0, _pr1, _pc1 = _pick_anchor_bbox(proto, bg)
   184	        top = (r0 + ar0) - pr0 * scale
   185	        left = (c0 + ac0) - pc0 * scale
   186	
   187	        ph, pw = scaled_proto.shape
   188	        rr0 = max(0, top)
   189	        cc0 = max(0, left)
   190	        rr1 = min(h, top + ph)
   191	        cc1 = min(w, left + pw)
   192	        sub_p = scaled_proto[(rr0 - top) : (rr1 - top), (cc0 - left) : (cc1 - left)]
   193	        mask = sub_p != bg
   194	        out_slice = out[rr0:rr1, cc0:cc1]
   195	        out_slice[mask] = sub_p[mask]
   196	        out[rr0:rr1, cc0:cc1] = out_slice
   197	
   198	    return out
