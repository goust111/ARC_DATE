+
+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+from arc_utils import bbox_coords, components_mask, get_bg, paste, random_free_location
+
+
+# Design analysis for the D10 variant
+# -----------------------------------
+# a) 具体化与行为追踪
