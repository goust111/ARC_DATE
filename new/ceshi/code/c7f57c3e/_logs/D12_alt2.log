+            out_dom = int(target_family["dom_color"])
+            out_sec = int(s["sec_color"])
+        else:
+            out_dom = int(s["dom_color"])
+            out_sec = int(families[0]["sec_color"])
+
+        replacement = _colorize_role_map(target_family["role_map"], bg, out_dom, out_sec)
