+# --------------- generator (D3 variant) ---------------
+
+# --- CFG: canvas ---
+GRID_SIZE_MIN = 18
+GRID_SIZE_MAX = 28
+GRID_BORDER = 1
+SLOT_GAP = 1
+MAX_RETRIES = 300
