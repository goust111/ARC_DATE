+    base = [s for s, a in zip(sprites, areas, strict=False) if a == min_area]
+    uniq: dict[tuple[int, ...], np.ndarray] = {}
+    for s in base:
+        key = tuple(np.asarray(s["arr"]).ravel().tolist())
+        if key not in uniq:
+            uniq[key] = np.asarray(s["arr"]).copy()
