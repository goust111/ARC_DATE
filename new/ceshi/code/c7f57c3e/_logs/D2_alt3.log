    inp, expected = placed
    try:
        solved = mod.main(inp)
        if np.array_equal(solved, expected):
            continue
        print('mismatch', i, 'diff', int(np.sum(solved "'!= expected)))
        print('"'input\\n', inp)
        print('solved\\n', solved)
        print('expected\\n', expected)
    except Exception as e:
        print('error', i, type(e).__name__, e)
        print('input\\n', inp)
    shown += 1
    if shown >= 3:
        break
