import importlib.util
spec = importlib.util.spec_from_file_location('variant', '/home/lixinyu/snap/new/ceshi/code/c7f57c3e/D2/3/code.py')
mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)

ok=0
place_fail=0
solve_fail=0
for i in range(200):
    bg = mod.random.choice(mod.BG_CHOICES)
    inp_sprites, out_sprites = mod._build_patches(bg)
    placed = mod._place_sprites(inp_sprites, out_sprites, bg)
    if placed is None:
        place_fail += 1
        continue
    inp, expected = placed
    try:
        solved = mod.main(inp)
    except Exception:
        solve_fail += 1
        continue
    if (solved == expected).all():
        ok += 1
    else:
        solve_fail += 1
print('ok',ok,'place_fail',place_fail,'solve_fail',solve_fail)
