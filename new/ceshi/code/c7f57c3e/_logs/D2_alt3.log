+    assert len(ys) > 0, "sprite must contain anchor color 1"
+    return int(ys.min()), int(xs.min()), int(ys.max()), int(xs.max())
+
+
+def _infer_scale(arr: np.ndarray) -> int:
+    r0, c0, r1, c1 = _pick_anchor_bbox(arr)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
