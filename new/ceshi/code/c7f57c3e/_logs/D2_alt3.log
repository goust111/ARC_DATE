+# --------------- generator ---------------
+
+PROTO_TEMPLATES = (
+    np.array(
+        [
+            [0, 1, 0, 0],
+            [2, 2, 3, 0],
+            [0, 3, 3, 0],
+            [0, 0, 3, 0],
+        ],
+        dtype=int,
+    ),
+    np.array(
+        [
+            [0, 1, 0, 0, 0],
+            [0, 2, 0, 3, 0],
+            [0, 2, 3, 3, 0],
+            [0, 0, 0, 3, 0],
+        ],
+        dtype=int,
+    ),
+    np.array(
+        [
+            [0, 0, 1, 0],
+            [0, 2, 2, 0],
+            [3, 0, 0, 0],
+            [0, 3, 3, 0],
+            [0, 0, 3, 0],
+        ],
+        dtype=int,
+    ),
+    np.array(
+        [
+            [0, 1, 0, 0, 0],
+            [0, 2, 2, 0, 0],
+            [0, 0, 3, 3, 0],
+            [0, 0, 0, 3, 3],
+        ],
+        dtype=int,
+    ),
+    np.array(
+        [
+            [0, 0, 1, 0, 0],
+            [0, 2, 2, 0, 0],
+            [0, 0, 3, 0, 0],
+            [0, 0, 3, 3, 0],
+            [0, 0, 0, 3, 0],
+        ],
+        dtype=int,
+    ),
+    np.array(
+        [
+            [0, 1, 0, 0],
+            [0, 2, 0, 0],
+            [0, 2, 3, 0],
+            [0, 0, 3, 3],
+            [0, 0, 0, 3],
+        ],
+        dtype=int,
+    ),
+)
+
