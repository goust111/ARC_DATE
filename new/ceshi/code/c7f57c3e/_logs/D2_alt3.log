new file mode 100644
index 0000000000000000000000000000000000000000..9db49f5aee84896fa6d15c0202e323fe211db437
--- /dev/null
+++ b/ceshi/code/c7f57c3e/D2/3/code.py
@@ -0,0 +1,427 @@
+# Variant of c7f57c3e
+# Dimension: D2 — 配对匹配策略 (match_cond)
+# Change: 跨组配对时要求尺度相同（s.scale == d.scale）且位置重叠最大化... → 按对称性匹配
+
+import random
+
+import numpy as np
+
+from arc_utils import bbox_coords, components_mask, get_bg, paste, random_free_location
+
