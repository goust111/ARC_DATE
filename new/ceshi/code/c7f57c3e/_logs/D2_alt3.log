+
+def _mirror(arr: np.ndarray, kind: str) -> np.ndarray:
+    if kind == "id":
+        return arr.copy()
+    if kind == "h":
+        return np.flipud(arr)
+    if kind == "v":
+        return np.fliplr(arr)
+    if kind == "d":
+        return arr.T
+    if kind == "ad":
+        return _anti_diag(arr)
+    raise ValueError(f"unknown mirror kind: {kind}")
