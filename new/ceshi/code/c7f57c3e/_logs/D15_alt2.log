+        assert pos.size > 0, "top legend must contain colored cells"
+        assert np.all(np.diff(pos) == 1), "top legend must be contiguous"
+        band_colors = _compress_runs(g[0, pos])
+        g[0, :] = bg
+    elif np.any(g[1:, 0] != bg):
