+                break
+        if not ok:
+            continue
+        ordered = sorted(picks, key=lambda item: SNAKE_INDEX[item["port"]])
+        path_len = SNAKE_INDEX[ordered[-1]["port"]] - SNAKE_INDEX[ordered[0]["port"]] + 1
+        if PATH_LEN_MIN <= path_len <= PATH_LEN_MAX:
