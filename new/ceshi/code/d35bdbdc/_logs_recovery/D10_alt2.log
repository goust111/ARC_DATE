+    return False
+
+
+def _side_candidates(side: str) -> list[dict]:
+    cands: list[dict] = []
+    if side == "top":
+        for c in SNAKE_COLS:
+            cands.append({"side": side, "r0": 0, "c0": c - 1, "port": (3, c), "center_pos": (1, c)})
+    elif side == "bottom":
