+    backward = sorted(
+        connected, key=lambda sp: (-int(sp["port_hi"]), int(sp["center_pos"][0]), int(sp["center_pos"][1]))
+    )
+    chain = forward if _sequence_score(forward) >= _sequence_score(backward) else backward
