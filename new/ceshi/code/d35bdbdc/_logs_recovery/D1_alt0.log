/bin/bash -lc "python - <<'PY'
import importlib.util
from collections import Counter
import numpy as np

new_spec = importlib.util.spec_from_file_location('variant', '/home/lixinyu/snap/new/ceshi/code/d35bdbdc/D1/0/code.py')
new_mod = importlib.util.module_from_spec(new_spec)
new_spec.loader.exec_module(new_mod)
old_spec = importlib.util.spec_from_file_location('orig', '/home/lixinyu/snap/new/arc2_solver_select/d35bdbdc.py')
old_mod = importlib.util.module_from_spec(old_spec)
old_spec.loader.exec_module(old_mod)

branch = Counter()
diverged = 0
same = 0
key_absent_from_borders = 0
samples = 200
for _ in range(samples):
    inp = new_mod.generate_input()
    new_out = new_mod.main(inp)
    old_out = old_mod.main(inp)
    if np.array_equal(new_out, old_out):
        same += 1
    else:
        diverged += 1

    g = np.asarray(inp, dtype=int)
    bg = new_mod._bg_boundary(g)
    sprites = new_mod._detect_bordered_sprites(g, bg, new_mod.GREY)
    te1, te2 = new_mod._find_trail_endpoints(g, new_mod.GREY, sprites)
    eps_pair = [te1, te2]
    trail_eps = {te1, te2}
    opts = {ep: [sp for sp in sprites if ep in new_mod._ports_for_sprite(sp, g, trail_eps)] for ep in eps_pair}
    dest = [None, None]
    order = [0, 1] if len(opts[te1]) <= len(opts[te2]) else [1, 0]
    used = set()
    for i in order:
        ep = eps_pair[i]
        other = eps_pair[1 - i]
        cands = [sp for sp in opts[ep] if id(sp) not in used]
        best = max(cands, key=lambda sp: abs(sp['center_pos'][0] - other[0]) + abs(sp['center_pos'][1] - other[1]))
        dest[i] = best
        used.add(id(best))
    dest_ids = {id(sp) for sp in dest}
    non_dest = [sp for sp in sprites if id(sp) not in dest_ids]
    by_center = {}
    by_border = {}
    for sp in non_dest:
        by_center.setdefault(int(sp['center']), []).append(sp)
        by_border.setdefault(int(sp['border']), []).append(sp)
    matched_ids = []
    for d in dest:
        matched_ids.append(id(by_center[int(d['center'])][0]))
    branch[len(set(matched_ids))] += 1
    if all(int(d['center']) not in by_border for d in dest):
        key_absent_from_borders += 1

print('samples', samples)
print('branch_distinct_sources', dict(branch))
print('new_vs_old_diverged', diverged)
print('new_vs_old_same', same)
print('dest_keys_absent_from_non_dest_borders', key_absent_from_borders)
