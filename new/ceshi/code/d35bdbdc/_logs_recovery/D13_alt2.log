+    for sp in sprites:
+        if id(sp) in dest_ids:
+            continue
+        for r, c in sp["pts"]:
+            out[r, c] = bg
+
+    keep = np.zeros(out.shape, dtype=bool)
+    q: list[tuple[int, int]] = []
+    for d in dest:
+        for r, c in d["pts"]:
+            if out[r, c] != bg and out[r, c] != grey and not keep[r, c]:
+                keep[r, c] = True
+                q.append((r, c))
+    while q:
+        r, c = q.pop()
