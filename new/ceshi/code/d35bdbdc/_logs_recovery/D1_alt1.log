    74	    for r, c in cells:
    75	        adj[(r, c)] = [(nr, nc) for nr, nc in neighbors8(r, c) if (nr, nc) in cells]
    76	
    77	    deg1 = [cell for cell, nbs in adj.items() if len(nbs) == 1]
