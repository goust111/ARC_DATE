   169	def main(grid: np.ndarray) -> np.ndarray:
   170	    """
   171	    Transfer center colors between bordered sprites matched by border color, keeping only path-connected ones.
   172	
   173	    Input structure:
   174	    - The grid contains background, a grey (5) one-stroke trail, and several small bordered sprites with one center pixel each.
   175	    - Exactly two sprites touch the trail endpoints through valid ports; those are the destinations.
   176	    - Other sprites may reuse a destination's border color even though they are not connected to the trail.
   177	
   178	    Rule:
   179	    - Identify the two destination sprites from the grey trail endpoints.
   180	    - For each destination, find the non-destination sprite whose border color equals that destination's border color.
   181	    - Replace the destination center with that matched source's center color.
   182	    - Remove every non-destination sprite; keep the grey trail and the two destinations.
   183	
   184	    Key insight:
   185	    - The lookup key is now the outline color itself: the path tells which sprites survive, and the surviving sprites copy from disconnected sprites that share the same border color.
   186	    """
   187	    g = np.asarray(grid, dtype=int)
   188	    bg = _bg_boundary(g)
   189	    grey = 5
   190	
   191	    sprites = _detect_bordered_sprites(g, bg, grey)
   192	    assert sprites, "expected at least one bordered sprite in the grid"
   193	
   194	    te1, te2 = _find_trail_endpoints(g, grey, sprites)
   195	    trail_eps = {te1, te2}
   196	
   197	    eps_pair = [te1, te2]
   198	    opts = {
   199	        ep: [sp for sp in sprites if ep in _ports_for_sprite(sp, g, trail_eps)]
   200	        for ep in eps_pair
   201	    }
   202	
   203	    dest: list[dict] = [None, None]  # type: ignore[list-item]
   204	    order = [0, 1] if len(opts[te1]) <= len(opts[te2]) else [1, 0]
   205	    used: set[int] = set()
   206	    for i in order:
   207	        ep = eps_pair[i]
   208	        other = eps_pair[1 - i]
   209	        cands = [sp for sp in opts[ep] if id(sp) not in used]
   210	        best = max(
   211	            cands,
   212	            key=lambda sp: abs(sp["center_pos"][0] - other[0]) + abs(sp["center_pos"][1] - other[1]),
   213	        )
   214	        dest[i] = best
   215	        used.add(id(best))
   216	    assert all(d is not None for d in dest), "expected exactly 2 dest sprites from trail endpoints"
   217	    dest_ids = {id(sp) for sp in dest}
   218	
   219	    by_border: dict[int, list[dict]] = {}
   220	    for sp in sprites:
   221	        if id(sp) in dest_ids:
   222	            continue
   223	        by_border.setdefault(int(sp["border"]), []).append(sp)
   224	
   225	    out = g.copy()
   226	
   227	    for sp in sprites:
   228	        if id(sp) in dest_ids:
   229	            continue
   230	        for r, c in sp["pts"]:
   231	            out[r, c] = bg
   232	
   233	    keep = np.zeros(out.shape, dtype=bool)
   234	    q: list[tuple[int, int]] = []
   235	    for d in dest:
   236	        for r, c in d["pts"]:
   237	            if out[r, c] != bg and out[r, c] != grey and not keep[r, c]:
   238	                keep[r, c] = True
   239	                q.append((r, c))
