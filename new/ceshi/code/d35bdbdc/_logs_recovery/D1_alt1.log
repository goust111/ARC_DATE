   278	def _make_sprite_patch(shape_type: str, border_color: int, center_color: int) -> np.ndarray:
   279	    """Return 3x3 patch for a box or plus. Center is at (1,1)."""
   280	    if shape_type == "box":
   281	        patch = np.full((3, 3), border_color, dtype=int)
   282	    else:
   283	        patch = np.zeros((3, 3), dtype=int)
   284	        for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
   285	            patch[1 + dr, 1 + dc] = border_color
