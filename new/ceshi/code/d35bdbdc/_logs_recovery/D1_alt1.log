   244	                if keep[nr, nc]:
   245	                    continue
   246	                if out[nr, nc] == bg or out[nr, nc] == grey:
   247	                    continue
   248	                keep[nr, nc] = True
   249	                q.append((nr, nc))
   250	    drop = (out != bg) & (out != grey) & (~keep)
   251	    out[drop] = bg
   252	
   253	    for d in dest:
   254	        srcs = by_border.get(int(d["border"]), [])
   255	        if not srcs:
   256	            continue
   257	        assert len(srcs) == 1, "each destination border should match exactly one non-destination source border"
   258	        src = srcs[0]
   259	        dr, dc = d["center_pos"]
   260	        out[dr, dc] = int(src["center"])
   261	
   262	    return out
