   267	SPRITE_COUNTS = [4, 5]
   268	INTERIOR_DEST_WEIGHTS = [3, 1]
   269	PATH_LEN_MIN, PATH_LEN_MAX = 10, 24
   270	MIN_PORT_DIST_FRAC = 3
