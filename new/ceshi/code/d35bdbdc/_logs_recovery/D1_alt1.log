    60	def _bg_boundary(g: np.ndarray) -> int:
    61	    """Most common color along the 1-cell outer border."""
    62	    border = np.concatenate([g[0, :], g[-1, :], g[1:-1, 0], g[1:-1, -1]])
    63	    vals, cnts = np.unique(border, return_counts=True)
    64	    return int(vals[cnts.argmax()])
