   150	def _ports_for_sprite(sprite: dict, g: np.ndarray, eps: set[tuple[int, int]]) -> list[tuple[int, int]]:
   151	    """
   152	    A grey endpoint (er,ec) is a port for this sprite if:
   153	      - it's exactly 2 steps away from the sprite center (Manhattan distance 2),
   154	      - the intermediate cell (1 step away from center toward endpoint) is the sprite border color.
   155	    """
   156	    cr, cc = sprite["center_pos"]
   157	    b = int(sprite["border"])
   158	    ports: list[tuple[int, int]] = []
   159	    for ir, ic in neighbors4(cr, cc):
   160	        dr, dc = ir - cr, ic - cc
   161	        er, ec = cr + 2 * dr, cc + 2 * dc
   162	        if (er, ec) not in eps:
   163	            continue
   164	        if 0 <= ir < g.shape[0] and 0 <= ic < g.shape[1] and int(g[ir, ic]) == b:
   165	            ports.append((er, ec))
   166	    return ports
