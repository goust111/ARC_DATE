   109	def _detect_bordered_sprites(g: np.ndarray, bg: int, grey: int) -> list[dict]:
   110	    """
   111	    Bordered sprite = a 4-connected component (excluding bg/grey) with exactly 2 colors:
   112	      - border color appears multiple times
   113	      - center color appears exactly once (its location is the 'center')
   114	    This also handles clipped/partial borders (e.g., near the grid edge).
   115	    """
   116	    mask = (g != bg) & (g != grey)
   117	    comps = components_mask(mask, connectivity=4)
   118	    sprites: list[dict] = []
   119	    for pts in comps:
   120	        cols = [int(g[r, c]) for r, c in pts]
   121	        uniq = sorted(set(cols))
   122	        if len(uniq) != 2:
   123	            continue
   124	        counts = {c: cols.count(c) for c in uniq}
   125	        center_color = min(counts, key=lambda c: counts[c])
   126	        if counts[center_color] != 1:
   127	            continue
   128	        border_color = [c for c in uniq if c != center_color][0]
   129	        if border_color == bg or border_color == grey or center_color == grey:
   130	            continue
   131	
   132	        center_pos = None
   133	        for r, c in pts:
   134	            if int(g[r, c]) == center_color:
   135	                center_pos = (int(r), int(c))
   136	                break
   137	        if center_pos is None:
   138	            continue
   139	        sprites.append(
   140	            {
   141	                "pts": pts,
   142	                "border": int(border_color),
   143	                "center": int(center_color),
   144	                "center_pos": center_pos,
   145	            }
   146	        )
   147	    return sprites
