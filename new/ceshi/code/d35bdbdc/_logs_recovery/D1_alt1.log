+            cr, cc = r0 + 1, c0 + 1
+            if trail_eps & _ports_from_center(input_grid, cr, cc, bc):
+                _erase_sprite(input_grid, patch, r0, c0)
+                continue
+            placed = True
+            break
+        if not placed:
+            return False
+    return True
+
+
+def _gen_attempt() -> np.ndarray | None:
