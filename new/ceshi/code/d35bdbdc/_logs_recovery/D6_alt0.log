   403	def _is_8_connected(cells: list[tuple[int, int]]) -> bool:
   404	    """Check 8-connectivity of a set of cells via BFS."""
   405	    if len(cells) <= 1:
   406	        return True
   407	    cell_set = set(cells)
   408	    start = next(iter(cell_set))
   409	    visited = {start}
   410	    queue = deque([start])
   411	    while queue:
   412	        r, c = queue.popleft()
   413	        for dr in (-1, 0, 1):
   414	            for dc in (-1, 0, 1):
   415	                if dr == 0 and dc == 0:
   416	                    continue
   417	                nb = (r + dr, c + dc)
   418	                if nb in cell_set and nb not in visited:
   419	                    visited.add(nb)
   420	                    queue.append(nb)
   421	    return len(visited) == len(cell_set)
