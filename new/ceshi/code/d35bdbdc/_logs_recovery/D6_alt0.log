   167	def main(grid: np.ndarray) -> np.ndarray:
   168	    """
   169	    Transfer center colors between trail-connected bordered sprites while keeping bystanders intact.
   170	
   171	    Input structure:
   172	    - The grid contains background, one grey (5) one-stroke trail, and several small bordered sprites.
   173	    - Each sprite uses exactly two colors: a repeated border color and one center pixel of a different color.
   174	    - Only the two sprites touched by the grey trail's endpoints through valid ports are trail-connected destinations.
   175	
   176	    Rule:
   177	    - Determine the two destination sprites from the trail endpoints.
   178	    - For each destination, treat its original center color as a lookup key for a source sprite whose border matches that color.
   179	    - Replace the destination center with the matched source center color.
   180	    - Leave every non-destination sprite exactly as it was; only the connected destinations change.
   181	
   182	    Key insight:
   183	    - The grey trail does not mark sprites to delete anymore; it marks the only sprites allowed to transform.
   184	      Unconnected sprites remain as evidence that endpoint connectivity, not mere sprite existence, controls the update.
   185	    """
   186	    g = np.asarray(grid, dtype=int)
   187	    bg = _bg_boundary(g)
   188	    grey = 5
   189	
   190	    sprites = _detect_bordered_sprites(g, bg, grey)
   191	    assert sprites, "expected at least one bordered sprite in the grid"
   192	
   193	    te1, te2 = _find_trail_endpoints(g, grey, sprites)
   194	    trail_eps = {te1, te2}
   195	
   196	    eps_pair = [te1, te2]
   197	    opts = {ep: [sp for sp in sprites if ep in _ports_for_sprite(sp, g, trail_eps)] for ep in eps_pair}
   198	
   199	    dest: list[dict] = [None, None]  # type: ignore[list-item]
   200	    order = [0, 1] if len(opts[te1]) <= len(opts[te2]) else [1, 0]
   201	    used: set[int] = set()
   202	    for i in order:
   203	        ep = eps_pair[i]
   204	        other = eps_pair[1 - i]
   205	        cands = [sp for sp in opts[ep] if id(sp) not in used]
   206	        best = max(
   207	            cands,
   208	            key=lambda sp: abs(sp["center_pos"][0] - other[0]) + abs(sp["center_pos"][1] - other[1]),
   209	        )
   210	        dest[i] = best
   211	        used.add(id(best))
   212	    assert all(d is not None for d in dest), "expected exactly 2 dest sprites from trail endpoints"
   213	
   214	    by_border: dict[int, list[dict]] = {}
   215	    for sp in sprites:
   216	        by_border.setdefault(int(sp["border"]), []).append(sp)
   217	
   218	    out = g.copy()
   219	
   220	    for d in dest:
   221	        want_border = int(d["center"])
   222	        srcs = by_border.get(want_border, [])
   223	        if not srcs:
   224	            continue
   225	        assert len(srcs) == 1, "each destination color should match at most one source border"
   226	        src = srcs[0]
   227	        dr, dc = d["center_pos"]
   228	        out[dr, dc] = int(src["center"])
   229	
   230	    return out
