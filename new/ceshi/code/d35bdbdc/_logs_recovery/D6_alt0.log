   362	        if not moves:
   363	            return None
   364	
   365	        dist = abs(cr - end[0]) + abs(cc - end[1])
   366	        budget = target_len - len(path)
   367	        diag = [move for move in moves if move[2]]
   368	        away = [move for move in moves if score(move) > dist]
   369	
   370	        if budget > dist + 4:
   371	            if away and random.random() < PATH_WANDER_AWAY_P:
   372	                pool = away
   373	            elif diag and random.random() < PATH_WANDER_DIAG_P:
   374	                pool = diag
   375	            else:
   376	                pool = moves
   377	            chosen = random.choice(pool)
   378	        elif budget > dist + 1:
   379	            pool = diag if diag and random.random() < PATH_WANDER_DIAG_P else moves
   380	            if random.random() < PATH_MODERATE_RANDOM_P:
   381	                chosen = random.choice(pool)
   382	            else:
   383	                chosen = min(pool, key=score)
   384	        else:
   385	            best = sorted(moves, key=score)
   386	            top = [move for move in best if score(move) <= score(best[0]) + 1]
   387	            dtop = [move for move in top if move[2]]
   388	            chosen = random.choice(dtop) if dtop else best[0]
   389	
   390	        cr, cc = chosen[0], chosen[1]
   391	        path.append((cr, cc))
   392	        visited.add((cr, cc))
