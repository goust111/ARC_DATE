   148	def _ports_for_sprite(sprite: dict, g: np.ndarray, eps: set[tuple[int, int]]) -> list[tuple[int, int]]:
   149	    """
   150	    A grey endpoint (er,ec) is a port for this sprite if:
   151	      - it's exactly 2 steps away from the sprite center (Manhattan distance 2),
   152	      - the intermediate cell (1 step away from center toward endpoint) is the sprite border color.
   153	    """
   154	    cr, cc = sprite["center_pos"]
   155	    border = int(sprite["border"])
   156	    ports: list[tuple[int, int]] = []
   157	    for ir, ic in neighbors4(cr, cc):
   158	        dr, dc = ir - cr, ic - cc
   159	        er, ec = cr + 2 * dr, cc + 2 * dc
   160	        if (er, ec) not in eps:
   161	            continue
   162	        if 0 <= ir < g.shape[0] and 0 <= ic < g.shape[1] and int(g[ir, ic]) == border:
   163	            ports.append((er, ec))
   164	    return ports
