   107	def _detect_bordered_sprites(g: np.ndarray, bg: int, grey: int) -> list[dict]:
   108	    """
   109	    Bordered sprite = a 4-connected component (excluding bg/grey) with exactly 2 colors:
   110	      - border color appears multiple times
   111	      - center color appears exactly once (its location is the 'center')
   112	    This also handles clipped/partial borders (e.g., near the grid edge).
   113	    """
   114	    mask = (g != bg) & (g != grey)
   115	    comps = components_mask(mask, connectivity=4)
   116	    sprites: list[dict] = []
   117	    for pts in comps:
   118	        cols = [int(g[r, c]) for r, c in pts]
   119	        uniq = sorted(set(cols))
   120	        if len(uniq) != 2:
   121	            continue
   122	        counts = {c: cols.count(c) for c in uniq}
   123	        center_color = min(counts, key=lambda c: counts[c])
   124	        if counts[center_color] != 1:
   125	            continue
   126	        border_color = [c for c in uniq if c != center_color][0]
   127	        if border_color == bg or border_color == grey or center_color == grey:
   128	            continue
   129	
   130	        center_pos = None
   131	        for r, c in pts:
   132	            if int(g[r, c]) == center_color:
   133	                center_pos = (int(r), int(c))
   134	                break
   135	        if center_pos is None:
   136	            continue
   137	        sprites.append(
   138	            {
   139	                "pts": pts,
   140	                "border": int(border_color),
   141	                "center": int(center_color),
   142	                "center_pos": center_pos,
   143	            }
   144	        )
   145	    return sprites
