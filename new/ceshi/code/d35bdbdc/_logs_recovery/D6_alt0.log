   332	def _gen_winding_path(
   333	    grid: np.ndarray, start: tuple[int, int], end: tuple[int, int], target_len: int
   334	) -> list[tuple[int, int]] | None:
   335	    """Generate a winding 8-connected grey path with no 2x2 blocks."""
