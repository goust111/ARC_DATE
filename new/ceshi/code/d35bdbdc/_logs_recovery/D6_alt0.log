   450	def _assign_colors(border_colors: list[int], num_sprites: int) -> dict | None:
   451	    """Assign roles (dest/source/distractor) and pick center colors for all sprites."""
   452	    remaining = list(range(2, num_sprites))
   453	    num_sources = random.choice(SOURCE_COUNTS) if len(remaining) >= 2 else max(1, len(remaining))
   454	    if num_sources == 0:
   455	        return None
   456	    source_indices = remaining[:num_sources]
   457	    distractor_indices = remaining[num_sources:]
   458	
   459	    if num_sources == 1:
   460	        dest_center_colors = [border_colors[source_indices[0]]] * 2
   461	    else:
   462	        dest_center_colors = [border_colors[si] for si in source_indices]
   463	
   464	    source_center_colors = []
   465	    for j, si in enumerate(source_indices):
   466	        forbidden = {BG, GREY, border_colors[si]}
   467	        if num_sources == 1:
   468	            forbidden.update([border_colors[0], border_colors[1]])
   469	        else:
   470	            forbidden.add(border_colors[j])
   471	        candidates = [c for c in range(1, 10) if c not in forbidden]
   472	        if not candidates:
   473	            return None
   474	        source_center_colors.append(random.choice(candidates))
   475	
   476	    distractor_center_colors = [
   477	        random.choice([c for c in range(1, 10) if c not in {GREY, border_colors[di]}])
   478	        for di in distractor_indices
   479	    ]
   480	
   481	    output_dest_centers = (source_center_colors * 2)[:2] if num_sources == 1 else source_center_colors
   482	
   483	    return {
   484	        "source_indices": source_indices,
   485	        "distractor_indices": distractor_indices,
   486	        "dest_center_colors": dest_center_colors,
   487	        "source_center_colors": source_center_colors,
   488	        "distractor_center_colors": distractor_center_colors,
   489	        "output_dest_centers": output_dest_centers,
   490	    }
   491	
   492	
   493	def _place_dests(
   494	    grid: np.ndarray, shape_type: str, border_colors: list[int], output_dest_centers: list[int], min_port_dist: int
   495	) -> list[tuple[int, int]] | None:
   496	    """Place 2 destination sprites on the grid. Returns their center positions."""
   497	    all_pos = _sprite_positions()
   498	    edge_pos = [pos for pos in all_pos if _is_edge(pos[0], pos[1])]
   499	    int_pos = [pos for pos in all_pos if not _is_edge(pos[0], pos[1])]
   500	    num_interior_dest = random.choices([0, 1], weights=INTERIOR_DEST_WEIGHTS)[0]
   501	
   502	    dest_center_positions: list[tuple[int, int]] = []
