   129	def _detect_bordered_sprites(g: np.ndarray, bg: int, path_colors: set[int]) -> list[dict]:
   130	    """
   131	    A bordered sprite is a 4-connected non-path component with exactly two colors:
   132	    one unique center pixel and one border color repeated around it.
   133	    """
   134	    mask = (g != bg)
   135	    for pc in path_colors:
   136	        mask &= (g != pc)
   137	    comps = components_mask(mask, connectivity=4)
   138	
   139	    sprites: list[dict] = []
   140	    for pts in comps:
   141	        cols = [int(g[r, c]) for r, c in pts]
   142	        uniq = sorted(set(cols))
   143	        if len(uniq) != 2:
   144	            continue
   145	        counts = {c: cols.count(c) for c in uniq}
   146	        center_color = min(counts, key=lambda c: counts[c])
   147	        if counts[center_color] != 1:
   148	            continue
   149	        border_color = [c for c in uniq if c != center_color][0]
   150	        if border_color == bg or border_color in path_colors or center_color in path_colors:
   151	            continue
   152	
   153	        center_pos = None
   154	        for r, c in pts:
   155	            if int(g[r, c]) == center_color:
   156	                center_pos = (int(r), int(c))
   157	                break
   158	        if center_pos is None:
   159	            continue
   160	        sprites.append(
   161	            {
