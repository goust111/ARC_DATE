+                break
+        if matched is None:
+            return None
+        group_for_color[color] = matched
+
+    for slot_name, (r0, c0) in layout["dest_slots"].items():
+        group_color = None
+        for color, group in group_for_color.items():
+            if slot_name in group["members"]:
