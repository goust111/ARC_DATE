   230	def _destinations_for_path_component(
   231	    g: np.ndarray, sprites: list[dict], cells: set[tuple[int, int]],
   232	) -> list[dict]:
   233	    """Resolve the 2 destination sprites attached to one colored path component."""
   234	    ep1, ep2 = _find_component_endpoints(cells, g, sprites)
   235	    endpoints = [ep1, ep2]
   236	    endpoint_set = set(endpoints)
