   171	def _ports_for_sprite(sprite: dict, g: np.ndarray, eps: set[tuple[int, int]]) -> list[tuple[int, int]]:
   172	    """
   173	    A path endpoint is a port for this sprite if it is 2 Manhattan steps from the center
   174	    and the intermediate cell in that direction uses the sprite border color.
   175	    """
   176	    cr, cc = sprite["center_pos"]
   177	    border = int(sprite["border"])
   178	    ports: list[tuple[int, int]] = []
   179	    for ir, ic in neighbors4(cr, cc):
   180	        dr, dc = ir - cr, ic - cc
   181	        er, ec = cr + 2 * dr, cc + 2 * dc
   182	        if (er, ec) not in eps:
   183	            continue
   184	        if 0 <= ir < g.shape[0] and 0 <= ic < g.shape[1] and int(g[ir, ic]) == border:
   185	            ports.append((er, ec))
   186	    return ports
