   110	def _bg_boundary(g: np.ndarray) -> int:
   111	    """Most common color along the outer border."""
   112	    border = np.concatenate([g[0, :], g[-1, :], g[1:-1, 0], g[1:-1, -1]])
   113	    vals, cnts = np.unique(border, return_counts=True)
   114	    return int(vals[cnts.argmax()])
