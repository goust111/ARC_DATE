+        [(r, col) for r in range(top, bot + 1)],
+        [start] + [(r, inner) for r in range(top + 1, bot)] + [end],
+        [
+            start,
+            (top, inner),
+            *[(r, outer) for r in range(top + 1, bot)],
+            (bot, inner),
+            end,
