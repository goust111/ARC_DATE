   117	def _make_sprite_patch(shape_type: str, border_color: int, center_color: int) -> np.ndarray:
   118	    """Return a 3x3 box or plus sprite with the center at (1,1)."""
   119	    if shape_type == "box":
   120	        patch = np.full((3, 3), border_color, dtype=int)
   121	    else:
   122	        patch = np.zeros((3, 3), dtype=int)
   123	        for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
   124	            patch[1 + dr, 1 + dc] = border_color
   125	    patch[1, 1] = center_color
