+    "vertical": {
+        "dest_slots": {
+            "tl": (0, 0),
+            "tr": (0, 7),
+            "bl": (7, 0),
+            "br": (7, 7),
+        },
+        "groups": [
+            {"members": ("tl", "bl"), "ports": ((3, 1), (6, 1))},
+            {"members": ("tr", "br"), "ports": ((3, 8), (6, 8))},
+        ],
+        "source_slots": [(1, 3), (1, 4), (2, 3), (2, 4), (5, 3), (5, 4), (6, 3), (6, 4)],
