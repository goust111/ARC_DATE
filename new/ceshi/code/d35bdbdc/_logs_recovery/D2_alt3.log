+            _place_sprite(input_grid, patch, r0, c0)
+            placed = True
+            break
+        if not placed:
+            return None
+
+    try:
+        out = main(input_grid)
+    except Exception:
+        return None
+    if np.array_equal(out, output_grid):
+        return input_grid
+    return None
+
