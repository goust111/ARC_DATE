+            {"members": ("bl", "br"), "ports": ((8, 3), (8, 6))},
+        ],
+        "source_slots": [(3, 0), (3, 7)],
+    },
+    "vertical": {
+        "dest_slots": {
+            "tl": (0, 0),
+            "tr": (0, 7),
+            "bl": (7, 0),
+            "br": (7, 7),
+        },
+        "groups": [
+            {"members": ("tl", "bl"), "ports": ((3, 1), (6, 1))},
+            {"members": ("tr", "br"), "ports": ((3, 8), (6, 8))},
+        ],
+        "source_slots": [(0, 3), (7, 3)],
