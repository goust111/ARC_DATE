   195	    for r, c in cells:
   196	        adj[(r, c)] = [(nr, nc) for nr, nc in neighbors8(r, c) if (nr, nc) in cells]
   197	
   198	    deg1 = [cell for cell, nbs in adj.items() if len(nbs) == 1]
   199	    if len(deg1) >= 2:
   200	        return deg1[0], deg1[1]
   201	
   202	    port_cells: set[tuple[int, int]] = set()
   203	    for sp in sprites:
   204	        cr, cc = sp["center_pos"]
   205	        border = int(sp["border"])
   206	        for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
   207	            ir, ic = cr + dr, cc + dc
   208	            er, ec = cr + 2 * dr, cc + 2 * dc
   209	            if (er, ec) in cells and 0 <= ir < h and 0 <= ic < w and int(g[ir, ic]) == border:
   210	                port_cells.add((er, ec))
   211	
   212	    start = deg1[0] if deg1 else next(iter(cells))
   213	    total = len(cells)
   214	
   215	    def dfs(cur: tuple[int, int], visited: frozenset[tuple[int, int]]) -> list[tuple[int, int]] | None:
   216	        if len(visited) == total:
   217	            return [cur] if cur in port_cells else None
   218	        for nb in adj[cur]:
   219	            if nb not in visited:
   220	                result = dfs(nb, visited | {nb})
   221	                if result is not None:
