+
+    out = g.copy()
+
+    for sp in sprites:
+        if id(sp) in dest_ids:
+            continue
+        for r, c in sp["pts"]:
+            out[r, c] = bg
+
+    keep = np.zeros(out.shape, dtype=bool)
