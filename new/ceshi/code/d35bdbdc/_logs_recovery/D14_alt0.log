+# Variant of d35bdbdc
+# Dimension: D14 — 匹配失败的处理 (meta)
+# Change: 每个目标精灵都能找到匹配的源精灵（隐含假设无匹配失败）... → 未匹配的目标精灵保持不变
+
+import random
+from collections import deque
+
+import numpy as np
+
+from arc_utils import components_mask, neighbors4, neighbors8, paste
+
+# Design analysis for the D14 variant
+# -----------------------------------
+# spec_delta:
+#   preserved_structure:
+#     - 10x10 grid, bg=0, grey trail=5.
+#     - 4-5 bordered sprites, all 3x3 box or plus within one example.
+#     - Exactly 2 destination sprites are identified by the two grey trail endpoints.
+#     - Non-destination sprites are deleted in the output; grey trail is preserved.
+#   changed_behavior:
+#     - The original generator always made both destination center colors equal to some
+#       non-destination border color, so every destination was rewritten.
+#     - This variant forces partial matching: exactly one destination has a matching
+#       source border, and the other destination's center color is absent from every
+#       sprite border color, so that destination must stay unchanged.
+#   concrete_trace:
+#     - Example roles: dest A border=2 center=7, dest B border=4 center=9.
+#     - Non-dest sprites include one source with border=7 center=3 and distractors
+#       with unrelated borders. No sprite border is 9.
+#     - Output: dest A center changes 7->3 because border 7 exists on the source.
+#       dest B center stays 9 because no non-destination border 9 exists.
+#   hidden_assumption_review:
+#     - Original `main()` used a border->sprite lookup over all sprites. That was
+#       harmless only because generated destination centers never equaled a destination
+#       border color. In this variant, an "unmatched" destination must not be
+#       accidentally matched through the other destination, so lookup is restricted to
+#       non-destination sprites only.
+#     - The `if not srcs: continue` branch already encodes the desired D14 behavior and
+#       is retained as the no-match case.
+#   legality_constraints:
+#     - Unmatched destination center colors are chosen from palette colors not used as
+#       any sprite border, making the no-match state explicit and solver-safe.
+#     - One matched destination remains required, so examples still expose the original
+#       transfer mechanism alongside the new keep-as-is branch.
+#     - Source centers avoid both destination border colors and the unmatched color so
+#       the changed target and unchanged target are visually distinguishable.
+#   observability:
+#     - Every generated puzzle contains one changed destination and one unchanged
+#       destination after pruning, so the new branch is visible in every sample instead
+#       of appearing only rarely.
+#     - The rule remains inferable from a few examples because the unchanged center is
+#       always the only destination lookup color with no corresponding non-destination
+#       border anywhere in the input.
+
+
+def _bg_boundary(g: np.ndarray) -> int:
+    """Most common color along the 1-cell outer border."""
+    border = np.concatenate([g[0, :], g[-1, :], g[1:-1, 0], g[1:-1, -1]])
+    vals, cnts = np.unique(border, return_counts=True)
+    return int(vals[cnts.argmax()])
+
+
+def _find_trail_endpoints(
+    g: np.ndarray, grey: int, sprites: list[dict],
+) -> tuple[tuple[int, int], tuple[int, int]]:
+    """Find the 2 endpoints of the grey one-stroke trail under 8-connectivity."""
+    h, w = g.shape
+    cells = set((int(r), int(c)) for r, c in zip(*np.where(g == grey), strict=False))
+    adj: dict[tuple[int, int], list[tuple[int, int]]] = {}
+    for r, c in cells:
+        adj[(r, c)] = [(nr, nc) for nr, nc in neighbors8(r, c) if (nr, nc) in cells]
+
+    deg1 = [c for c, nbs in adj.items() if len(nbs) == 1]
+    if len(deg1) >= 2:
+        return deg1[0], deg1[1]
+
+    port_cells: set[tuple[int, int]] = set()
+    for sp in sprites:
+        cr, cc = sp["center_pos"]
+        b = int(sp["border"])
+        for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
+            ir, ic = cr + dr, cc + dc
+            er, ec = cr + 2 * dr, cc + 2 * dc
+            if (er, ec) in cells and 0 <= ir < h and 0 <= ic < w and int(g[ir, ic]) == b:
+                port_cells.add((er, ec))
+
+    start = deg1[0] if deg1 else next(iter(cells))
+    n = len(cells)
+
+    def dfs(cur: tuple[int, int], visited: frozenset) -> list | None:
+        if len(visited) == n:
+            return [cur] if cur in port_cells else None
+        for nb in adj[cur]:
+            if nb not in visited:
+                result = dfs(nb, visited | {nb})
+                if result is not None:
+                    return [cur] + result
+        return None
+
+    path = dfs(start, frozenset({start}))
+    assert path, "could not trace grey cells as one-stroke trail"
+    return path[0], path[-1]
+
+
+def _detect_bordered_sprites(g: np.ndarray, bg: int, grey: int) -> list[dict]:
+    """
+    Bordered sprite = a 4-connected component (excluding bg/grey) with exactly 2 colors:
+      - border color appears multiple times
+      - center color appears exactly once (its location is the 'center')
+    This also handles clipped/partial borders (e.g., near the grid edge).
+    """
+    mask = (g != bg) & (g != grey)
+    comps = components_mask(mask, connectivity=4)
+    sprites: list[dict] = []
+    for pts in comps:
+        cols = [int(g[r, c]) for r, c in pts]
+        uniq = sorted(set(cols))
+        if len(uniq) != 2:
+            continue
+        counts = {c: cols.count(c) for c in uniq}
+        center_color = min(counts, key=lambda c: counts[c])
+        if counts[center_color] != 1:
+            continue
+        border_color = [c for c in uniq if c != center_color][0]
+        if border_color == bg or border_color == grey or center_color == grey:
+            continue
+
+        center_pos = None
+        for r, c in pts:
+            if int(g[r, c]) == center_color:
+                center_pos = (int(r), int(c))
+                break
+        if center_pos is None:
+            continue
+        sprites.append(
+            {
+                "pts": pts,
+                "border": int(border_color),
+                "center": int(center_color),
+                "center_pos": center_pos,
+            }
+        )
+    return sprites
+
+
+def _ports_for_sprite(sprite: dict, g: np.ndarray, eps: set[tuple[int, int]]) -> list[tuple[int, int]]:
+    """
+    A grey endpoint (er,ec) is a port for this sprite if:
+      - it's exactly 2 steps away from the sprite center (Manhattan distance 2),
+      - the intermediate cell (1 step away from center toward endpoint) is the sprite border color.
+    """
+    cr, cc = sprite["center_pos"]
+    b = int(sprite["border"])
+    ports: list[tuple[int, int]] = []
+    for ir, ic in neighbors4(cr, cc):
+        dr, dc = ir - cr, ic - cc
+        er, ec = cr + 2 * dr, cc + 2 * dc
+        if (er, ec) not in eps:
+            continue
+        if 0 <= ir < g.shape[0] and 0 <= ic < g.shape[1] and int(g[ir, ic]) == b:
+            ports.append((er, ec))
+    return ports
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Rewrite only the grey-connected destination sprites, but leave unmatched ones unchanged.
+
+    Input structure:
+    - The grid contains background, a grey one-stroke trail, and several tiny bordered sprites.
+    - Each sprite has one border color and a single center pixel of another color; the trail's two endpoints touch the two destination sprites through valid ports.
+
+    Rule:
+    - Identify the two destinations from the trail endpoints and delete every other sprite/component.
+    - For each destination, treat its original center color as a lookup key among non-destination sprite border colors.
+    - If a source sprite with that border exists, copy the source center color into the destination center; if no such source exists, keep that destination center as-is.
+
+    Key insight:
+    - The trail only says which two sprites survive; the actual repainting depends on whether each surviving center color can find a matching non-destination border elsewhere in the input.
+    """
+    g = np.asarray(grid, dtype=int)
+    bg = _bg_boundary(g)
+    grey = 5
+
+    sprites = _detect_bordered_sprites(g, bg, grey)
+    assert sprites, "expected at least one bordered sprite in the grid"
+
+    te1, te2 = _find_trail_endpoints(g, grey, sprites)
+    trail_eps = {te1, te2}
+
+    eps_pair = [te1, te2]
+    opts = {ep: [sp for sp in sprites if ep in _ports_for_sprite(sp, g, trail_eps)] for ep in eps_pair}
+
+    dest: list[dict] = [None, None]  # type: ignore[list-item]
+    order = [0, 1] if len(opts[te1]) <= len(opts[te2]) else [1, 0]
+    used: set[int] = set()
+    for i in order:
+        ep = eps_pair[i]
+        other = eps_pair[1 - i]
+        cands = [sp for sp in opts[ep] if id(sp) not in used]
+        assert cands, "expected a destination sprite for each trail endpoint"
+        best = max(
+            cands,
+            key=lambda sp: abs(sp["center_pos"][0] - other[0]) + abs(sp["center_pos"][1] - other[1]),
+        )
+        dest[i] = best
+        used.add(id(best))
+    assert all(d is not None for d in dest), "expected exactly 2 dest sprites from trail endpoints"
+    dest_ids = {id(sp) for sp in dest}
+
+    by_border: dict[int, list[dict]] = {}
+    for sp in sprites:
+        if id(sp) in dest_ids:
+            continue
+        by_border.setdefault(int(sp["border"]), []).append(sp)
+
+    out = g.copy()
+
+    for sp in sprites:
+        if id(sp) in dest_ids:
+            continue
+        for r, c in sp["pts"]:
+            out[r, c] = bg
+
+    keep = np.zeros(out.shape, dtype=bool)
+    q: list[tuple[int, int]] = []
+    for d in dest:
+        for r, c in d["pts"]:
+            if out[r, c] != bg and out[r, c] != grey and not keep[r, c]:
+                keep[r, c] = True
+                q.append((r, c))
+    while q:
+        r, c = q.pop()
+        for nr, nc in neighbors4(r, c):
+            if 0 <= nr < out.shape[0] and 0 <= nc < out.shape[1]:
+                if keep[nr, nc]:
+                    continue
+                if out[nr, nc] == bg or out[nr, nc] == grey:
+                    continue
+                keep[nr, nc] = True
+                q.append((nr, nc))
+    drop = (out != bg) & (out != grey) & (~keep)
+    out[drop] = bg
+
+    for d in dest:
+        want_border = int(d["center"])
+        srcs = by_border.get(want_border, [])
+        if not srcs:
+            continue
+        assert len(srcs) == 1, "each destination color should match at most one non-destination border"
+        src = srcs[0]
+        dr, dc = d["center_pos"]
+        out[dr, dc] = int(src["center"])
+
+    return out
+
+
+GRID_H, GRID_W = 10, 10
+BG, GREY = 0, 5
+SPRITE_COUNTS = [4, 5]
+SOURCE_COUNTS = [1, 2]
+INTERIOR_DEST_WEIGHTS = [3, 1]
+PATH_LEN_MIN, PATH_LEN_MAX = 10, 24
+MIN_PORT_DIST_FRAC = 3
+MAX_THICKNESS = 3
+PATH_WANDER_AWAY_P = 0.5
+PATH_WANDER_DIAG_P = 0.6
+PATH_MODERATE_RANDOM_P = 0.3
+GEN_RETRIES = 300
+
+
+def _make_sprite_patch(shape_type, border_color, center_color):
+    """Return 3x3 patch for a box or plus. Center is at (1,1)."""
+    if shape_type == "box":
+        p = np.full((3, 3), border_color, dtype=int)
+    else:
+        p = np.zeros((3, 3), dtype=int)
+        for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
+            p[1 + dr, 1 + dc] = border_color
+    p[1, 1] = center_color
+    return p
+
+
+def _place_sprite(grid, patch, r0, c0):
+    """Place patch cells on grid, skipping transparent (0) and out-of-bounds."""
+    paste(grid, patch, r0, c0, transparent=BG, clip=True)
+
+
+def _erase_sprite(grid, patch, r0, c0):
+    """Undo a _place_sprite by zeroing non-transparent patch cells."""
+    h, w = grid.shape
+    for dr in range(3):
+        for dc in range(3):
+            rr, cc = r0 + dr, c0 + dc
+            if 0 <= rr < h and 0 <= cc < w and patch[dr, dc] != 0:
+                grid[rr, cc] = BG
+
+
+def _overlaps(grid, patch, r0, c0):
+    """Check if placing patch at (r0,c0) would overlap or 4-touch non-bg, non-grey cells."""
+    h, w = grid.shape
+    patch_cells = set()
+    for dr in range(3):
+        for dc in range(3):
+            if patch[dr, dc] != 0:
+                rr, cc = r0 + dr, c0 + dc
+                if 0 <= rr < h and 0 <= cc < w:
+                    if grid[rr, cc] != 0:
+                        return True
+                    patch_cells.add((rr, cc))
+    for rr, cc in patch_cells:
+        for nr, nc in [(rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)]:
+            if (nr, nc) not in patch_cells and 0 <= nr < h and 0 <= nc < w:
+                if int(grid[nr, nc]) not in (BG, GREY):
+                    return True
+    return False
+
+
+def _sprite_positions():
+    """All valid (r0,c0) for a 3x3 patch where center stays on grid."""
+    return [
+        (r0, c0)
+        for r0 in range(-1, GRID_H)
+        for c0 in range(-1, GRID_W)
+        if 0 <= r0 + 1 < GRID_H and 0 <= c0 + 1 < GRID_W
