   655	        [(border_colors[si], colors["source_center_colors"][j], True)
   656	         for j, si in enumerate(colors["source_indices"])]
   657	        + [(border_colors[di], colors["distractor_center_colors"][j], False)
   658	           for j, di in enumerate(colors["distractor_indices"])]
   659	    )
   660	    all_pos = _sprite_positions()
   661	    full_pos = _full_sprite_positions()
   662	    for bc, cc_color, must_be_full in sprites_to_place:
   663	        patch = _make_sprite_patch(shape_type, bc, cc_color)
   664	        pool = list(full_pos if must_be_full else all_pos)
   665	        random.shuffle(pool)
   666	        placed = False
   667	        for r0, c0 in pool:
   668	            if not _overlaps(input_grid, patch, r0, c0):
   669	                _place_sprite(input_grid, patch, r0, c0)
   670	                placed = True
   671	                break
   672	        if not placed:
   673	            return None
   674	
   675	    try:
   676	        out = main(input_grid)
   677	        if np.array_equal(out, output_grid):
   678	            return input_grid
   679	    except Exception:
   680	        pass
   681	    return None
   682	
   683	
   684	def generate_input():
   685	    for _ in range(GEN_RETRIES):
   686	        result = _gen_attempt()
   687	        if result is not None:
   688	            return result
   689	    raise RuntimeError(f"Failed to generate input after {GEN_RETRIES} attempts")

diff --git a/ceshi/code/d35bdbdc/D13/0/code.py b/ceshi/code/d35bdbdc/D13/0/code.py
new file mode 100644
index 0000000000000000000000000000000000000000..72644ca8839959507c6f2eade4fe859830977914
--- /dev/null
+++ b/ceshi/code/d35bdbdc/D13/0/code.py
@@ -0,0 +1,689 @@
+# Variant of d35bdbdc
+# Dimension: D13 — 属性转移的范围 (transform)
+# Change: 仅转移中心色（单像素或小区域的颜色替换）... → 整体精灵复制到目标位置
+
+import numpy as np
+
+from arc_utils import neighbors4, neighbors8, components_mask, paste
+import random
+from collections import deque
+
+
+# Design analysis for the D13 variant
+# ==================================
+# spec_variant:
+#   preserved_structure:
+#     - grid remains 10x10 with bg=0 and grey path color 5
+#     - sprites are still 3x3 box/plus bordered sprites with one distinct center cell
+#     - grey endpoints still choose exactly two destination sprites through the same port rule
+#     - destination.center still acts as the lookup key into source.border
+#   d13_change:
+#     - original behavior: only overwrite the destination center pixel with source.center
+#     - variant behavior: erase the destination sprite and redraw the entire matched source
+#       sprite at the destination center, aligned by center position and clipped by bounds
+#   concrete_trace:
+#     - example input:
+#         destination = box(border=3, center=8)
+#         source      = box(border=8, center=2)
+#     - original output:
+#         destination stays box(border=3) and only center becomes 2
+#     - variant output:
+#         destination becomes the whole source appearance, i.e. box(border=8, center=2)
+#     - difference:
+#         the lookup chain is unchanged, but the transferred payload grows from one pixel
+#         to the entire observed sprite footprint
+#   complexity_calibration:
+#     - keep only the original two shape families (box/plus); no new geometry categories
+#     - all sprites in one example still share one shape, so the only new inference is
+#       "copy whole matched sprite", not unrelated shape-mixing logic
+#     - to make the object-level replacement visible, generators place source sprites fully
+#       in-bounds, so the copied object is a complete sprite rather than an edge fragment
+#   implicit_assumption_audit:
+#     - endpoint detection, destination matching, and border->source lookup do not depend on
+#       center-only transfer, so they remain valid
+#     - the old final write `out[dr, dc] = src["center"]` relied on destination borders
+#       being preserved; that assumption is now false and must be replaced with full redraw
+#     - redrawing must clear destination-only cells first, otherwise a smaller copied sprite
+#       could leave stale pixels behind
+#   placement_legality:
+#     - output-first generation now places the output destinations using the matched source
+#       colors, then reconstructs the input destinations with their original border/lookup
+#       center colors at the same locations
+#     - source and distractor sprites are placed without overlap; sources are constrained to
+#       full 3x3 placements so the copied object is well-defined
+#   visual_observability:
+#     - the variant differs from the original on multiple border pixels, not just one center
+#       pixel, so the effect is directly visible across 2-3 examples
+#     - with one source, both destinations become the same copied sprite; with two sources,
+#       each destination copies a different sprite, giving repeated evidence for the rule
+
+
+def _bg_boundary(g: np.ndarray) -> int:
+    """Most common color along the 1-cell outer border."""
+    border = np.concatenate([g[0, :], g[-1, :], g[1:-1, 0], g[1:-1, -1]])
+    vals, cnts = np.unique(border, return_counts=True)
+    return int(vals[cnts.argmax()])
+
+
+def _find_trail_endpoints(
+    g: np.ndarray, grey: int, sprites: list[dict],
+) -> tuple[tuple[int, int], tuple[int, int]]:
+    """Find the 2 endpoints of the grey one-stroke trail under 8-connectivity."""
+    h, w = g.shape
+    cells = set((int(r), int(c)) for r, c in zip(*np.where(g == grey), strict=False))
+    adj: dict[tuple[int, int], list[tuple[int, int]]] = {}
+    for r, c in cells:
+        adj[(r, c)] = [(nr, nc) for nr, nc in neighbors8(r, c) if (nr, nc) in cells]
+
+    deg1 = [c for c, nbs in adj.items() if len(nbs) == 1]
+    if len(deg1) >= 2:
+        return deg1[0], deg1[1]
+
+    port_cells: set[tuple[int, int]] = set()
+    for sp in sprites:
+        cr, cc = sp["center_pos"]
+        b = int(sp["border"])
+        for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
+            ir, ic = cr + dr, cc + dc
+            er, ec = cr + 2 * dr, cc + 2 * dc
+            if (er, ec) in cells and 0 <= ir < h and 0 <= ic < w and int(g[ir, ic]) == b:
+                port_cells.add((er, ec))
+
+    start = deg1[0] if deg1 else next(iter(cells))
+    n = len(cells)
+
+    def dfs(cur: tuple[int, int], visited: frozenset) -> list | None:
+        if len(visited) == n:
+            return [cur] if cur in port_cells else None
+        for nb in adj[cur]:
+            if nb not in visited:
+                result = dfs(nb, visited | {nb})
+                if result is not None:
+                    return [cur] + result
+        return None
+
+    path = dfs(start, frozenset({start}))
+    assert path, "could not trace grey cells as one-stroke trail"
+    return path[0], path[-1]
+
+
+def _detect_bordered_sprites(g: np.ndarray, bg: int, grey: int) -> list[dict]:
+    """
+    Bordered sprite = a 4-connected component (excluding bg/grey) with exactly 2 colors:
+      - border color appears multiple times
+      - center color appears exactly once (its location is the 'center')
+    This also handles clipped/partial borders (e.g., near the grid edge).
+    """
+    mask = (g != bg) & (g != grey)
+    comps = components_mask(mask, connectivity=4)
+    sprites: list[dict] = []
+    for pts in comps:
+        cols = [int(g[r, c]) for r, c in pts]
+        uniq = sorted(set(cols))
+        if len(uniq) != 2:
+            continue
+        counts = {c: cols.count(c) for c in uniq}
+        center_color = min(counts, key=lambda c: counts[c])
+        if counts[center_color] != 1:
+            continue
+        border_color = [c for c in uniq if c != center_color][0]
+        if border_color == bg or border_color == grey or center_color == grey:
+            continue
+
+        center_pos = None
+        for r, c in pts:
+            if int(g[r, c]) == center_color:
+                center_pos = (int(r), int(c))
+                break
+        if center_pos is None:
+            continue
+        sprites.append(
+            {
+                "pts": pts,
+                "border": int(border_color),
+                "center": int(center_color),
+                "center_pos": center_pos,
+            }
+        )
+    return sprites
+
+
+def _ports_for_sprite(sprite: dict, g: np.ndarray, eps: set[tuple[int, int]]) -> list[tuple[int, int]]:
+    """
+    A grey endpoint (er,ec) is a port for this sprite if:
+      - it's exactly 2 steps away from the sprite center (Manhattan distance 2),
+      - the intermediate cell (1 step away from center toward endpoint) is the sprite border color.
+    """
+    cr, cc = sprite["center_pos"]
+    b = int(sprite["border"])
+    ports: list[tuple[int, int]] = []
+    for ir, ic in neighbors4(cr, cc):
+        dr, dc = ir - cr, ic - cc
+        er, ec = cr + 2 * dr, cc + 2 * dc
+        if (er, ec) not in eps:
+            continue
+        if 0 <= ir < g.shape[0] and 0 <= ic < g.shape[1] and int(g[ir, ic]) == b:
+            ports.append((er, ec))
+    return ports
+
+
+def _translated_sprite_cells(sprite: dict, dst_center: tuple[int, int]) -> list[tuple[int, int, int]]:
+    """Translate an observed sprite so that its center lands at dst_center."""
+    src_r, src_c = sprite["center_pos"]
+    dst_r, dst_c = dst_center
+    cells: list[tuple[int, int, int]] = []
+    for r, c in sprite["pts"]:
+        rr = int(dst_r + (int(r) - src_r))
+        cc = int(dst_c + (int(c) - src_c))
+        color = int(sprite["center"]) if (int(r), int(c)) == (src_r, src_c) else int(sprite["border"])
+        cells.append((rr, cc, color))
+    return cells
+
+
+def _redraw_destination_as_source(out: np.ndarray, dest: dict, src: dict, bg: int) -> None:
+    """Replace the destination component with the translated source component."""
+    for r, c in dest["pts"]:
+        out[int(r), int(c)] = bg
+    for rr, cc, color in _translated_sprite_cells(src, dest["center_pos"]):
+        if 0 <= rr < out.shape[0] and 0 <= cc < out.shape[1]:
+            out[rr, cc] = color
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Replace path-selected destination sprites with whole matched source sprites, keeping only path-connected ones.
+
+    Input structure:
+    - The grid contains bg, a grey (5) one-stroke trail, and several small bordered sprites.
+    - Each sprite is a two-color box/plus component with one unique center cell; the trail's two endpoints connect to exactly two destination sprites through the original port rule.
+
+    Rule:
+    - Use the grey trail endpoints to identify the two destinations.
+    - For each destination, read its center color and find the source sprite whose border color matches that lookup color.
+    - Delete every non-destination sprite, then replace each destination sprite by the entire matched source sprite translated onto the destination center.
+
+    Key insight:
+    - The destination center color is still only a lookup key; the transferred payload is no longer a single center value but the whole source object, aligned by center and clipped by the target location.
+    """
+    g = np.asarray(grid, dtype=int)
+    bg = _bg_boundary(g)
+    grey = 5
+
+    sprites = _detect_bordered_sprites(g, bg, grey)
+    assert sprites, "expected at least one bordered sprite in the grid"
+
+    te1, te2 = _find_trail_endpoints(g, grey, sprites)
+    trail_eps = {te1, te2}
+
+    eps_pair = [te1, te2]
+    opts = {
+        ep: [sp for sp in sprites if ep in _ports_for_sprite(sp, g, trail_eps)]
+        for ep in eps_pair
+    }
+
+    dest: list[dict] = [None, None]  # type: ignore[list-item]
+    order = [0, 1] if len(opts[te1]) <= len(opts[te2]) else [1, 0]
+    used: set[int] = set()
+    for i in order:
+        ep = eps_pair[i]
+        other = eps_pair[1 - i]
+        cands = [sp for sp in opts[ep] if id(sp) not in used]
+        best = max(
+            cands,
+            key=lambda sp: abs(sp["center_pos"][0] - other[0]) + abs(sp["center_pos"][1] - other[1]),
+        )
+        dest[i] = best
+        used.add(id(best))
+    assert all(d is not None for d in dest), "expected exactly 2 dest sprites from trail endpoints"
+    dest_ids = {id(sp) for sp in dest}
+
+    by_border: dict[int, list[dict]] = {}
+    for sp in sprites:
+        by_border.setdefault(int(sp["border"]), []).append(sp)
+
+    out = g.copy()
+
+    for sp in sprites:
+        if id(sp) in dest_ids:
+            continue
+        for r, c in sp["pts"]:
+            out[int(r), int(c)] = bg
+
+    keep = np.zeros(out.shape, dtype=bool)
+    q: list[tuple[int, int]] = []
+    for d in dest:
+        for r, c in d["pts"]:
+            if out[int(r), int(c)] != bg and out[int(r), int(c)] != grey and not keep[int(r), int(c)]:
+                keep[int(r), int(c)] = True
+                q.append((int(r), int(c)))
+    while q:
+        r, c = q.pop()
+        for nr, nc in neighbors4(r, c):
+            if 0 <= nr < out.shape[0] and 0 <= nc < out.shape[1]:
+                if keep[nr, nc]:
+                    continue
+                if out[nr, nc] == bg or out[nr, nc] == grey:
+                    continue
+                keep[nr, nc] = True
+                q.append((nr, nc))
+    drop = (out != bg) & (out != grey) & (~keep)
+    out[drop] = bg
+
+    for d in dest:
+        want_border = int(d["center"])
+        srcs = by_border.get(want_border, [])
+        if not srcs:
+            continue
+        assert len(srcs) == 1, "each destination color should match at most one source border"
+        _redraw_destination_as_source(out, d, srcs[0], bg)
+
+    return out
+
+
+# --------------- generator (c) ---------------
+
+# ── CFG: tunable generation parameters ──────────────────────────────
+GRID_H, GRID_W = 10, 10                    # canvas size
+BG, GREY = 0, 5                            # background and path colors
+SPRITE_COUNTS = [4, 5]                     # number of sprites per example
+SOURCE_COUNTS = [1, 2]                     # possible number of source sprites
+INTERIOR_DEST_WEIGHTS = [3, 1]             # weights for [0, 1] interior dests
+PATH_LEN_MIN, PATH_LEN_MAX = 10, 24        # grey trail length bounds
+MIN_PORT_DIST_FRAC = 3                     # min_port_dist = max(3, target_len // this)
+MAX_THICKNESS = 3                          # max 8-neighbor degree for path cells
+PATH_WANDER_AWAY_P = 0.5                   # P(choose away-moves) when budget is large
+PATH_WANDER_DIAG_P = 0.6                   # P(prefer diagonal) in wander/moderate phases
+PATH_MODERATE_RANDOM_P = 0.3               # P(random move) in moderate-budget phase
+GEN_RETRIES = 300                          # outer retry limit
+
+
+def _make_sprite_patch(shape_type, border_color, center_color):
+    """Return 3x3 patch for a box or plus. Center is at (1,1)."""
+    if shape_type == "box":
+        p = np.full((3, 3), border_color, dtype=int)
+    else:
+        p = np.zeros((3, 3), dtype=int)
+        for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
+            p[1 + dr, 1 + dc] = border_color
+    p[1, 1] = center_color
+    return p
+
+
+def _place_sprite(grid, patch, r0, c0):
+    """Place patch cells on grid, skipping transparent (0) and out-of-bounds."""
+    paste(grid, patch, r0, c0, transparent=BG, clip=True)
+
+
+def _erase_sprite(grid, patch, r0, c0):
+    """Undo a _place_sprite by zeroing non-transparent patch cells."""
+    h, w = grid.shape
+    for dr in range(3):
+        for dc in range(3):
+            rr, cc = r0 + dr, c0 + dc
+            if 0 <= rr < h and 0 <= cc < w and int(patch[dr, dc]) != BG:
+                grid[rr, cc] = BG
+
+
+def _overlaps(grid, patch, r0, c0):
+    """Check if placing patch at (r0,c0) would overlap or 4-touch non-bg, non-grey cells."""
+    h, w = grid.shape
+    patch_cells = set()
+    for dr in range(3):
+        for dc in range(3):
+            if int(patch[dr, dc]) != BG:
+                rr, cc = r0 + dr, c0 + dc
+                if 0 <= rr < h and 0 <= cc < w:
+                    if int(grid[rr, cc]) != BG:
+                        return True
+                    patch_cells.add((rr, cc))
+    for rr, cc in patch_cells:
+        for nr, nc in [(rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)]:
+            if (nr, nc) not in patch_cells and 0 <= nr < h and 0 <= nc < w:
+                if int(grid[nr, nc]) not in (BG, GREY):
+                    return True
+    return False
+
+
+def _sprite_positions():
+    """All valid (r0,c0) for a 3x3 patch where center stays on grid."""
+    return [
+        (r0, c0)
+        for r0 in range(-1, GRID_H)
+        for c0 in range(-1, GRID_W)
+        if 0 <= r0 + 1 < GRID_H and 0 <= c0 + 1 < GRID_W
+    ]
+
+
+def _full_sprite_positions():
+    """Placements where the full 3x3 patch stays in-bounds."""
+    return [(r0, c0) for r0 in range(0, GRID_H - 2) for c0 in range(0, GRID_W - 2)]
+
+
+def _is_edge(r0, c0):
+    return r0 <= 0 or r0 + 3 >= GRID_H or c0 <= 0 or c0 + 3 >= GRID_W
+
+
+def _too_thick(r, c, occupied):
+    """Check if adding (r,c) would push any cell's 8-degree above MAX_THICKNESS."""
+    nbs = [
+        (r + dr, c + dc)
+        for dr in (-1, 0, 1)
+        for dc in (-1, 0, 1)
+        if (dr or dc) and (r + dr, c + dc) in occupied
+    ]
+    if len(nbs) > MAX_THICKNESS:
+        return True
+    for nr, nc in nbs:
+        deg = sum(
+            1
+            for dr in (-1, 0, 1)
+            for dc in (-1, 0, 1)
+            if (dr or dc) and (nr + dr, nc + dc) in occupied
+        )
+        if deg + 1 > MAX_THICKNESS:
+            return True
+    return False
+
+
+def _gen_winding_path(grid, start, end, target_len):
+    """Generate a winding 8-connected grey path with no 2x2 blocks."""
+    path = [start]
+    visited = {start}
+    cr, cc = start
+
+    def score(m):
+        return abs(m[0] - end[0]) + abs(m[1] - end[1])
+
+    for _ in range(target_len + 20):
+        if max(abs(cr - end[0]), abs(cc - end[1])) <= 1:
+            break
+
+        moves = []
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                if dr == 0 and dc == 0:
+                    continue
+                nr, nc = cr + dr, cc + dc
+                if (
+                    0 <= nr < GRID_H
+                    and 0 <= nc < GRID_W
+                    and (nr, nc) not in visited
+                    and int(grid[nr, nc]) == BG
+                    and not _too_thick(nr, nc, visited)
+                ):
+                    moves.append((nr, nc, dr != 0 and dc != 0))
+
+        if not moves:
+            return None
+
+        dist = abs(cr - end[0]) + abs(cc - end[1])
+        budget = target_len - len(path)
+        diag = [m for m in moves if m[2]]
+        away = [m for m in moves if score(m) > dist]
+
+        if budget > dist + 4:
+            if away and random.random() < PATH_WANDER_AWAY_P:
+                pool = away
+            elif diag and random.random() < PATH_WANDER_DIAG_P:
+                pool = diag
+            else:
+                pool = moves
+            chosen = random.choice(pool)
+        elif budget > dist + 1:
+            pool = diag if diag and random.random() < PATH_WANDER_DIAG_P else moves
+            if random.random() < PATH_MODERATE_RANDOM_P:
+                chosen = random.choice(pool)
+            else:
+                chosen = min(pool, key=score)
+        else:
+            best = sorted(moves, key=score)
+            top = [m for m in best if score(m) <= score(best[0]) + 1]
+            dtop = [m for m in top if m[2]]
+            chosen = random.choice(dtop) if dtop else best[0]
+
+        cr, cc = chosen[0], chosen[1]
+        path.append((cr, cc))
+        visited.add((cr, cc))
+
+    if end not in visited:
+        if not _too_thick(end[0], end[1], visited):
+            path.append(end)
+        else:
+            return None
+
+    return path
+
+
+def _is_8_connected(cells):
+    """Check 8-connectivity of a set of cells via BFS."""
+    if len(cells) <= 1:
+        return True
+    cell_set = set(cells)
+    start = next(iter(cell_set))
+    visited = {start}
+    queue = deque([start])
+    while queue:
+        r, c = queue.popleft()
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                if dr == 0 and dc == 0:
+                    continue
+                nb = (r + dr, c + dc)
+                if nb in cell_set and nb not in visited:
+                    visited.add(nb)
+                    queue.append(nb)
+    return len(visited) == len(cell_set)
+
+
+def _find_port_dir(grid, cr, cc, bc):
+    """Find a valid port direction for a sprite centered at (cr,cc) with border color bc."""
+    dirs = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+    random.shuffle(dirs)
+    for dr, dc in dirs:
+        ir, ic = cr + dr, cc + dc
+        er, ec = cr + 2 * dr, cc + 2 * dc
+        if not (
+            0 <= ir < GRID_H
+            and 0 <= ic < GRID_W
+            and 0 <= er < GRID_H
+            and 0 <= ec < GRID_W
+        ):
+            continue
+        if int(grid[ir, ic]) == bc and int(grid[er, ec]) == BG:
+            return (er, ec)
+    return None
+
+
+def _assign_colors(border_colors, num_sprites):
+    """Assign roles (dest/source/distractor) and pick center colors for all sprites."""
+    remaining = list(range(2, num_sprites))
+    num_sources = random.choice(SOURCE_COUNTS) if len(remaining) >= 2 else max(1, len(remaining))
+    if num_sources == 0:
+        return None
+    source_indices = remaining[:num_sources]
+    distractor_indices = remaining[num_sources:]
+
+    if num_sources == 1:
+        matched_sources = [source_indices[0], source_indices[0]]
+    else:
+        matched_sources = source_indices[:2]
+
+    dest_center_colors = [border_colors[si] for si in matched_sources]
+
+    source_center_colors = []
+    for j, si in enumerate(source_indices):
+        forbidden = {BG, GREY, border_colors[si]}
+        if num_sources == 1:
+            forbidden.update([border_colors[0], border_colors[1]])
+        else:
+            forbidden.add(border_colors[j])
+        candidates = [c for c in range(1, 10) if c not in forbidden]
+        if not candidates:
+            return None
+        source_center_colors.append(random.choice(candidates))
+
+    distractor_center_colors = [
+        random.choice([c for c in range(1, 10) if c != GREY and c != border_colors[di]])
+        for di in distractor_indices
+    ]
+
+    source_center_by_index = {
+        si: source_center_colors[j] for j, si in enumerate(source_indices)
+    }
+    output_dest_specs = [
+        (border_colors[si], source_center_by_index[si]) for si in matched_sources
+    ]
+
+    return dict(
+        source_indices=source_indices,
+        distractor_indices=distractor_indices,
+        matched_sources=matched_sources,
+        dest_center_colors=dest_center_colors,
+        source_center_colors=source_center_colors,
+        distractor_center_colors=distractor_center_colors,
+        output_dest_specs=output_dest_specs,
+    )
+
+
+def _place_dests(output_grid, shape_type, output_dest_specs, min_port_dist):
+    """Place 2 destination sprites on the output grid. Returns center positions or None."""
+    all_pos = _sprite_positions()
+    edge_pos = [p for p in all_pos if _is_edge(p[0], p[1])]
+    int_pos = [p for p in all_pos if not _is_edge(p[0], p[1])]
+    num_interior_dest = random.choices([0, 1], weights=INTERIOR_DEST_WEIGHTS)[0]
+
+    dest_center_positions = []
+    first_port = None
+
+    for i in range(2):
+        bc, cc_color = output_dest_specs[i]
+        patch = _make_sprite_patch(shape_type, bc, cc_color)
+        pool = list(int_pos if i < num_interior_dest else edge_pos)
+        random.shuffle(pool)
+
+        placed = False
+        for r0, c0 in pool:
+            if _overlaps(output_grid, patch, r0, c0):
+                continue
+            cr, cc_pos = r0 + 1, c0 + 1
+
+            _place_sprite(output_grid, patch, r0, c0)
+            port = _find_port_dir(output_grid, cr, cc_pos, bc)
+            if port is None:
+                _erase_sprite(output_grid, patch, r0, c0)
+                continue
+
+            if i == 1:
+                dist = abs(port[0] - first_port[0]) + abs(port[1] - first_port[1])
+                if dist < min_port_dist:
+                    _erase_sprite(output_grid, patch, r0, c0)
+                    continue
+
+            dest_center_positions.append((cr, cc_pos))
+            if i == 0:
+                first_port = port
+            placed = True
+            break
+
+        if not placed:
+            return None
+
+    return dest_center_positions
+
+
+def _gen_attempt():
+    shape_type = random.choice(["box", "plus"])
+    palette = [c for c in range(1, 10) if c != GREY]
+    num_sprites = random.choice(SPRITE_COUNTS)
+    border_colors = random.sample(palette, num_sprites)
+
+    colors = _assign_colors(border_colors, num_sprites)
+    if colors is None:
+        return None
+
+    target_len = random.randint(PATH_LEN_MIN, PATH_LEN_MAX)
+    min_port_dist = max(3, target_len // MIN_PORT_DIST_FRAC)
+
+    output_grid = np.zeros((GRID_H, GRID_W), dtype=int)
+    result = _place_dests(output_grid, shape_type, colors["output_dest_specs"], min_port_dist)
+    if result is None:
+        return None
+    dest_center_positions = result
+
+    port_cells = []
+    for i in range(2):
+        cr, cc_pos = dest_center_positions[i]
+        out_border, _out_center = colors["output_dest_specs"][i]
+        port = _find_port_dir(output_grid, cr, cc_pos, out_border)
+        if port is None:
+            return None
+        port_cells.append(port)
+
+    path_cells = _gen_winding_path(output_grid, port_cells[0], port_cells[1], target_len)
+    if path_cells is None or not (PATH_LEN_MIN <= len(path_cells) <= PATH_LEN_MAX):
+        return None
+    if not _is_8_connected(path_cells):
+        return None
+
+    for r, c in path_cells:
+        if int(output_grid[r, c]) != BG:
+            return None
+        output_grid[r, c] = GREY
+
+    for pr, pc in port_cells:
+        deg = sum(
+            1
+            for nr, nc in [(pr - 1, pc), (pr + 1, pc), (pr, pc - 1), (pr, pc + 1)]
+            if 0 <= nr < GRID_H and 0 <= nc < GRID_W and int(output_grid[nr, nc]) == GREY
+        )
+        if deg > 1:
+            return None
+
+    input_grid = output_grid.copy()
+    for i in range(2):
+        cr, cc_pos = dest_center_positions[i]
+        r0, c0 = cr - 1, cc_pos - 1
