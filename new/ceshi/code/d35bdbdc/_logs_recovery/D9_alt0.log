+
+def _gen_winding_path(grid, start, end, target_len):
+    """Generate an 8-connected grey trail constrained to the inner frame."""
+    if not (_in_path_frame(*start) and _in_path_frame(*end)):
+        return None
+
+    path = [start]
+    visited = {start}
+    cr, cc = start
