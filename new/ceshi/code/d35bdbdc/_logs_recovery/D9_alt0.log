+            1
+            for nr, nc in [(pr - 1, pc), (pr + 1, pc), (pr, pc - 1), (pr, pc + 1)]
+            if 0 <= nr < GRID_H and 0 <= nc < GRID_W and full_output[nr, nc] == GREY
+        )
+        if deg > 1:
