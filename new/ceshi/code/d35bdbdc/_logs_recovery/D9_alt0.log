+        (r + dr, c + dc)
+        for dr in (-1, 0, 1)
+        for dc in (-1, 0, 1)
+        if (dr or dc) and (r + dr, c + dc) in occupied
+    ]
+    if len(nbs) > MAX_THICKNESS:
+        return True
+    for nr, nc in nbs:
+        deg = sum(
+            1
+            for dr in (-1, 0, 1)
+            for dc in (-1, 0, 1)
+            if (dr or dc) and (nr + dr, nc + dc) in occupied
+        )
