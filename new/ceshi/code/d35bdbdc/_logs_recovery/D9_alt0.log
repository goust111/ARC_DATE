+                placed = True
+                break
+        if not placed:
+            return None
+
+    try:
+        out = main(input_grid)
+        if np.array_equal(out, expected_output):
+            return input_grid
+    except Exception:
+        pass
+    return None
+
+
+def generate_input():
+    for _ in range(GEN_RETRIES):
+        result = _gen_attempt()
+        if result is not None:
+            return result
+    raise RuntimeError(f"Failed to generate input after {GEN_RETRIES} attempts")

