+# Variant of e87109e9
+# Dimension: D4 — 轨迹涂色模式 (trajectory)
+# Change: 沿路径连续涂青色(8)，从源到障碍物或网格边缘形成连续实线轨迹... → 按图例条目顺序循环涂色
+
+# Design analysis for this variant
+# ---
+# concretization:
+#   input:
+#     - legend remains a 6x24 top band with 4 left-to-right entries.
+#     - each entry still contains one colored vertical bar whose left/right placement encodes turn direction.
+#     - the entry order now also matters: those 4 colors form the trajectory palette cycle.
+#     - the cropped main grid still contains one solid teal source square and 3-4 edge-touching obstacle rectangles.
+#   output:
+#     - legend is removed exactly as before.
+#     - the source square stays teal.
+#     - each of the 4 emitted rays is split into straight segments by obstacle hits.
+#     - segment 0 uses legend entry 0's color, segment 1 uses legend entry 1's color, segment 2 uses legend entry 2's color,
+#       then the sequence cycles if needed.
+#   traced example:
+#     - old behavior: ray from the square goes upward, paints teal until obstacle color C, turns, then keeps painting teal.
+#     - new behavior: the same upward segment paints with legend color A; after hitting C and turning, the next segment paints with
+#       legend color B; after a second hit it paints with legend color C2.
+#     - the geometric route is unchanged; only the per-segment paint state changes.
+# complexity_calibration:
+#   - keep the original square/obstacle geometry so the task is still recognized as e87109e9.
+#   - require generated examples to show at least 3 distinct trajectory colors, so the new rule is visible and not reducible to
+#     "replace teal with one constant color".
+#   - keep exactly 4 legend entries and distinct legend colors; this is a small, human-readable cycle.
+# implicit_assumptions_review:
+#   - original _parse_legend only returned color->turn and ignored entry order; that is no longer sufficient.
+#   - original obstacle detection read from the already-painted output and discarded only bg+teal; once paths are multi-colored,
+#     painted cells would be misread as obstacles. The solver must therefore detect obstacles from the unpainted base grid.
+#   - original painting with a constant teal made beam overlaps harmless. In the variant, overlaps would become order-dependent, so
+#     the generator must reject overlapping trajectory footprints.
+# placement_legality:
+#   - obstacle rectangles still must be non-overlapping, edge-touching, and separated from the source square.
+#   - the generator reuses the original span/thickness constraints, then validates the full multi-color oracle path and rejects any
+#     sample with cycles, mixed-color obstacle footprints, or beam-beam overlap on background cells.
+# visual_observability:
+#   - the color order is purely the visible left-to-right legend order; no hidden ordering by numeric color id is used.
+#   - the generator requires at least one 2-hit beam so the first three legend entries affect the output.
+# visual_cleanliness:
+#   - legend remains spatially isolated and is cropped away.
+#   - path overlap is forbidden, so the final image has clean colored corridors instead of ambiguous overpainting.
+# color_inference:
+#   - only four legend colors participate, and they are already highlighted in a dedicated top band.
+#   - because outputs contain at least three segment colors, the examples expose that legend order controls the path palette rather
+#     than obstacle color identity alone.
+
+from __future__ import annotations
+
+from pathlib import Path
+import random
+import sys
+
+import numpy as np
+
+for _parent in Path(__file__).resolve().parents:
+    _solver_dir = _parent / "solvers"
+    if (_solver_dir / "arc_utils.py").exists():
+        if str(_solver_dir) not in sys.path:
+            sys.path.append(str(_solver_dir))
+        break
+
+from arc_utils import bbox_coords, components_mask
+
+_DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+_N, _E, _S, _W = range(4)
+
+
+def _parse_legend(grid: np.ndarray, legend_h: int) -> tuple[list[int], dict[int, str]]:
+    """
+    Legend is a top region with a background color (typically 5) and 4 vertical bars.
+    Each bar's horizontal position inside its cell encodes turn direction:
+      - bar on left  -> 'L' (turn counterclockwise)
+      - bar on right -> 'R' (turn clockwise)
+    The left-to-right cell order is the beam color cycle.
+    """
+    legend = grid[:legend_h, :]
+    assert legend.size, "legend must be non-empty"
+    vals, counts = np.unique(legend, return_counts=True)
+    bg = int(vals[counts.argmax()])
+
+    sep_cols = [c for c in range(legend.shape[1]) if np.all(legend[:, c] == bg)]
+    assert len(sep_cols) >= 2, "legend separator columns must exist"
+
+    order: list[int] = []
+    turn: dict[int, str] = {}
+    for a, b in zip(sep_cols, sep_cols[1:], strict=False):
+        if b - a <= 2:
+            continue
+        interior = legend[1 : legend_h - 1, a + 1 : b]
+        colors = set(map(int, np.unique(interior)))
+        colors.discard(bg)
+        colors.discard(0)
+        assert len(colors) == 1, "each legend cell must encode exactly one color"
+        col = int(next(iter(colors)))
+        xs = np.where(interior == col)[1]
+        x = int(xs[0])
+        order.append(col)
+        turn[col] = "L" if x <= (interior.shape[1] - 1) // 2 else "R"
+    assert len(order) == 4 and len(turn) == 4, "legend must encode four turn colors"
+    assert len(set(order)) == 4, "legend colors must be distinct"
+    return order, turn
+
+
+def _find_teal_square(g: np.ndarray, teal: int = 8) -> tuple[int, int, int]:
+    """Return (r0,c0,size) for a solid square teal component."""
+    candidates: list[tuple[int, int, int]] = []
+    for cells in components_mask(g == teal, connectivity=4):
+        r0, c0, r1, c1 = bbox_coords(cells)
+        hh = r1 - r0 + 1
+        ww = c1 - c0 + 1
+        if hh != ww:
+            continue
+        size = hh
+        if int(np.sum(g[r0 : r1 + 1, c0 : c1 + 1] == teal)) != size * size:
+            continue
+        candidates.append((int(r0), int(c0), int(size)))
+    assert len(candidates) == 1, "main grid must contain exactly one solid teal square"
+    return candidates[0]
+
+
+def _rot_ccw(d: int) -> int:
+    return (d - 1) % 4
+
+
+def _rot_cw(d: int) -> int:
+    return (d + 1) % 4
+
+
+def _rot(d: int, turn: str) -> int:
+    return _rot_ccw(d) if turn == "L" else _rot_cw(d)
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Emit four rays from a teal square, turning at colored obstacles and cycling segment colors by legend order.
+
+    Input structure:
+    - Top band: a grey (5) legend with four colored vertical bars; each bar's left/right placement still encodes the turn direction.
+    - The same four legend entries, read left-to-right, also define the repeating trajectory color sequence.
+    - Below the legend: the main grid with a background color, one solid teal (8) square, and colored obstacle blocks.
+
+    Rule:
+    - Remove the legend from the output.
+    - Launch one sz-wide ray in each cardinal direction from the teal square.
+    - A ray paints only background cells. Its first straight segment uses the first legend color; after each obstacle-triggered turn it
+      advances to the next legend color in the left-to-right cycle.
+    - On hitting an obstacle of color C, consult that legend entry's bar position: left means turn counterclockwise, right means turn
+      clockwise. Continue tracing from the same location in the new direction.
+    - Rays stop at grid edges.
+
+    Key insight: the legend now carries two independent signals at once: each entry's color participates in the segment-color cycle,
+    while that same entry's bar placement still determines the turn direction for obstacles of that color.
+    """
+    g = np.asarray(grid, dtype=int)
+
+    legend_bg = 5
+    rows_with_legend = np.where(np.any(g == legend_bg, axis=1))[0]
+    assert rows_with_legend.size, "legend rows must be present"
+    legend_h = int(rows_with_legend.max() + 1)
+    assert np.array_equal(rows_with_legend, np.arange(legend_h)), "legend color must be confined to the top band"
+
+    legend_order, legend_turn = _parse_legend(g, legend_h)
+
+    base = g[legend_h:, :].copy()
+    assert base.size, "main grid must remain after legend crop"
+
+    vals, counts = np.unique(base, return_counts=True)
+    bg = int(vals[counts.argmax()])
+    teal = 8
+    sr, sc, sz = _find_teal_square(base, teal=teal)
+
+    out = base.copy()
+
+    def in_bounds(r: int, c: int) -> bool:
+        return 0 <= r and 0 <= c and r + sz - 1 < out.shape[0] and c + sz - 1 < out.shape[1]
+
+    def paint_block(r: int, c: int, color: int) -> None:
+        blk = out[r : r + sz, c : c + sz]
+        blk[blk == bg] = color
+        out[r : r + sz, c : c + sz] = blk
+
+    def obstacle_color_at_next(nr: int, nc: int) -> int | None:
+        blk = base[nr : nr + sz, nc : nc + sz]
+        cols = set(map(int, np.unique(blk)))
+        cols.discard(bg)
+        cols.discard(teal)
+        if not cols:
+            return None
+        assert len(cols) == 1, "beam footprint must not hit mixed obstacle colors"
+        return int(next(iter(cols)))
+
+    for d0 in range(4):
+        r, c, d = sr, sc, d0
+        seg_idx = 0
+        seen: set[tuple[int, int, int, int]] = set()
+        while True:
+            state = (r, c, d, seg_idx)
+            assert state not in seen, "beam path must not cycle"
+            seen.add(state)
+
+            dr, dc = _DIRS[d]
+            nr, nc = r + dr, c + dc
+            if not in_bounds(nr, nc):
+                break
+
+            oc = obstacle_color_at_next(nr, nc)
+            if oc is None:
+                r, c = nr, nc
+                paint_block(r, c, legend_order[seg_idx])
+                continue
+
+            assert oc in legend_turn, "obstacle color must be encoded by legend"
+            d = _rot(d, legend_turn[oc])
+            seg_idx = (seg_idx + 1) % len(legend_order)
+
+    return out
+
+
+# --------------- generator ---------------
+
+# Color palettes
+LEGEND_COLOR_POOL = [1, 2, 3, 4, 6]
+BG_COLOR_POOL = [1, 2, 3, 4, 6, 7, 9]
+LEGEND_BG = 5
+TEAL = 8
+
+# Canvas dimensions
+GRID_H_RANGE = (19, 24)
+GRID_W = 24
+LEGEND_H = 6
+LEGEND_CELL_STARTS = [1, 7, 13, 19]
+
+# Teal square
+TEAL_SZ2_PROB = 0.75
+SQUARE_EDGE_GAP = 5
+
+# Obstacles
+OBS_COUNT_4_PROB = 0.65
+OBS_THICKNESS_RANGE = (2, 4)
+OBS_SINGLE_MARGIN = 6
+OBS_BOTH_GAP = 2
+
+# Span selection
+SPAN_MIN_MULT = 3
+SPAN_MAX_MULT = 14
+SPAN_COMPACT_PROB = 0.4
+
+# Retry budget
+MAX_RETRIES = 400
+
+
+def _choose_span(
+    axis_len: int,
+    required: list[tuple[int, int]],
+    excluded: list[tuple[int, int]],
+    min_len: int,
+    max_len: int,
+) -> tuple[int, int] | None:
+    """Pick a (start, end) span covering all required intervals and avoiding all excluded ones."""
+    req0 = min(a for a, _ in required)
+    req1 = max(b for _, b in required)
+    lo = max(min_len, req1 - req0 + 1)
+    hi = min(max_len, axis_len)
+    choices: list[tuple[int, int, int]] = []
+    for length in range(lo, hi + 1):
+        start0 = max(0, req1 - length + 1)
+        start1 = min(req0, axis_len - length)
+        for start in range(start0, start1 + 1):
+            end = start + length - 1
+            if all(end < a or start > b for a, b in excluded):
+                choices.append((length, start, end))
+    if not choices:
+        return None
+
+    lengths = sorted({length for length, _, _ in choices})
+    if random.random() < SPAN_COMPACT_PROB:
+        cutoff = lengths[min(len(lengths) - 1, max(0, len(lengths) // 2))]
+        pool = [(start, end) for length, start, end in choices if length <= cutoff]
+    else:
+        pool = [(start, end) for _, start, end in choices]
+    return random.choice(pool)
+
+
+def _simulate_paths(
+    base: np.ndarray, turns: dict[int, str], color_cycle: list[int], bg: int
+) -> tuple[np.ndarray, list[list[tuple[int, int, int, int]]], list[set[tuple[int, int]]], set[int]]:
+    """Simulate 4 beams from the teal square with per-segment color cycling."""
+    vals, counts = np.unique(base, return_counts=True)
+    assert int(vals[counts.argmax()]) == bg
+
+    sr, sc, sz = _find_teal_square(base, teal=TEAL)
+    out = base.copy()
+    H, W = out.shape
+    hits: list[list[tuple[int, int, int, int]]] = []
+    per_beam_cells: list[set[tuple[int, int]]] = []
+    owner = np.full((H, W), -1, dtype=int)
+    used_colors: set[int] = set()
+
+    def in_bounds(r: int, c: int) -> bool:
+        return 0 <= r and 0 <= c and r + sz - 1 < H and c + sz - 1 < W
+
+    def paint(beam_idx: int, r: int, c: int, color: int, cells: set[tuple[int, int]]) -> None:
+        base_blk = base[r : r + sz, c : c + sz]
+        out_blk = out[r : r + sz, c : c + sz]
+        for rr in range(sz):
+            for cc in range(sz):
+                if int(base_blk[rr, cc]) != bg:
+                    continue
+                gr, gc = r + rr, c + cc
+                prev = int(owner[gr, gc])
+                assert prev in (-1, beam_idx), "trajectory footprints must be disjoint on background"
+                owner[gr, gc] = beam_idx
+                out_blk[rr, cc] = color
+                cells.add((gr, gc))
+        out[r : r + sz, c : c + sz] = out_blk
+        if cells:
+            used_colors.add(color)
+
+    def obstacle_at(r: int, c: int) -> int | None:
+        colors = set(map(int, np.unique(base[r : r + sz, c : c + sz])))
+        colors.discard(bg)
+        colors.discard(TEAL)
+        if not colors:
+            return None
+        assert len(colors) == 1, "beam footprint must not hit mixed obstacle colors"
+        return int(next(iter(colors)))
+
+    for beam_idx, d0 in enumerate(range(4)):
+        r, c, d = int(sr), int(sc), d0
+        seg_idx = 0
+        beam_hits: list[tuple[int, int, int, int]] = []
+        beam_cells: set[tuple[int, int]] = set()
+        seen: set[tuple[int, int, int, int]] = set()
+        while True:
+            state = (r, c, d, seg_idx)
+            assert state not in seen, "beam path must not cycle"
+            seen.add(state)
+            dr, dc = _DIRS[d]
+            nr, nc = r + dr, c + dc
+            if not in_bounds(nr, nc):
+                break
+            obs = obstacle_at(nr, nc)
+            if obs is None:
+                r, c = nr, nc
+                paint(beam_idx, r, c, color_cycle[seg_idx], beam_cells)
+                continue
+            assert obs in turns
+            beam_hits.append((d, obs, nr, nc))
+            d = _rot(d, turns[obs])
+            seg_idx = (seg_idx + 1) % len(color_cycle)
+            assert len(beam_hits) <= 2
+        hits.append(beam_hits)
+        per_beam_cells.append(beam_cells)
+
+    return out, hits, per_beam_cells, used_colors
+
+
+def _make_legend(legend_colors: list[int], turns: dict[int, str]) -> np.ndarray:
+    """Build the 6x24 legend band from 4 ordered colors and their turn assignments."""
+    legend = np.full((LEGEND_H, GRID_W), LEGEND_BG, dtype=int)
+    for start, color in zip(LEGEND_CELL_STARTS, legend_colors):
+        legend[1:5, start : start + 4] = 0
+        bar_col = start if turns[color] == "L" else start + 3
+        legend[1:5, bar_col] = color
+    return legend
+
+
+def _rand_thickness(lo: int, hi: int) -> int | None:
+    return random.randint(lo, hi) if hi >= lo else None
+
+
+def _thickness_pair(
+    axis: int, sz: int, a_present: bool, b_present: bool
+) -> tuple[int | None, int | None] | None:
+    """Compute obstacle thicknesses for the two ends of an axis (N/S or W/E)."""
+    lo, hi_cap = OBS_THICKNESS_RANGE
+    if a_present and b_present:
+        room = axis - sz - OBS_BOTH_GAP
+        if room < 2 * lo:
+            return None
+        a = random.randint(lo, min(hi_cap, room - lo))
+        b = _rand_thickness(lo, min(hi_cap, room - a))
+        return (a, b) if b is not None else None
+    if a_present:
+        t = _rand_thickness(lo, min(hi_cap, axis - sz - OBS_SINGLE_MARGIN))
+        return (t, None) if t is not None else None
+    if b_present:
+        t = _rand_thickness(lo, min(hi_cap, axis - sz - OBS_SINGLE_MARGIN))
+        return (None, t) if t is not None else None
+    return None, None
+
+
+def _obstacle_rect(
+    side: int, thickness: int, span: tuple[int, int], h: int, w: int
+) -> tuple[int, int, int, int]:
+    """Return (r0, r1, c0, c1) for an edge-touching obstacle rectangle."""
+    s0, s1 = span
+    if side == _N:
+        return 0, thickness - 1, s0, s1
+    if side == _S:
+        return h - thickness, h - 1, s0, s1
+    if side == _W:
+        return s0, s1, 0, thickness - 1
+    return s0, s1, w - thickness, w - 1
+
+
+def _select_chains(present: set[int], second_hits: int) -> dict[int, int] | None:
+    """Pick non-overlapping (source -> adjacent target) pairs for multi-bounce beams."""
+    candidates = [
+        (side, nxt)
+        for side in present
+        for nxt in ((side - 1) % 4, (side + 1) % 4)
+        if nxt in present
+    ]
+    random.shuffle(candidates)
+    selected: list[tuple[int, int]] = []
+    used: set[int] = set()
+    for side, nxt in candidates:
+        if len(selected) == second_hits:
+            break
+        if side in used or nxt in used:
+            continue
+        selected.append((side, nxt))
+        used.update((side, nxt))
+    return dict(selected) if len(selected) == second_hits else None
+
+
+def _assign_turns(present: set[int], chains: dict[int, int]) -> dict[int, str]:
+    """Assign L/R turn direction for each obstacle side."""
+    side_turn: dict[int, str] = {}
+    for side in present:
+        if side in chains:
+            nxt = chains[side]
+            side_turn[side] = "L" if nxt == (side - 1) % 4 else "R"
+        else:
+            outward = [t for t in ("L", "R") if _rot(side, t) not in present]
+            side_turn[side] = random.choice(outward if outward else ["L", "R"])
+    return side_turn
+
+
+def _compute_span_constraints(
+    present: set[int],
+    side_turn: dict[int, str],
+    chains: dict[int, int],
+    sr: int,
+    sc: int,
+    sz: int,
+    lane: dict[int, int],
+) -> tuple[dict[int, list[tuple[int, int]]], dict[int, list[tuple[int, int]]]]:
+    """Build required/excluded intervals for each obstacle's span selection."""
+    required: dict[int, list[tuple[int, int]]] = {s: [] for s in present}
+    excluded: dict[int, list[tuple[int, int]]] = {s: [] for s in present}
+
+    for side in present:
+        base_coord = sc if side in (_N, _S) else sr
+        required[side].append((base_coord, base_coord + sz - 1))
+
+    def lane_interval(side: int) -> tuple[int, int]:
+        return lane[side], lane[side] + sz - 1
+
+    for side in present:
+        nxt = _rot(side, side_turn[side])
+        if nxt not in present:
+            continue
+        if chains.get(side) == nxt:
+            required[nxt].append(lane_interval(side))
+            after = _rot(nxt, side_turn[nxt])
+            if after in present:
+                excluded[after].append(lane_interval(nxt))
+        else:
+            excluded[nxt].append(lane_interval(side))
+
+    return required, excluded
+
+
+def _legacy_solid_output(base: np.ndarray, turns: dict[int, str], bg: int) -> np.ndarray:
+    """Old e87109e9 behavior, used only to reject degenerate variant samples."""
+    sr, sc, sz = _find_teal_square(base, teal=TEAL)
+    out = base.copy()
+    H, W = out.shape
+
+    def in_bounds(r: int, c: int) -> bool:
+        return 0 <= r and 0 <= c and r + sz - 1 < H and c + sz - 1 < W
+
+    def paint(r: int, c: int) -> None:
+        blk = out[r : r + sz, c : c + sz]
+        blk[blk == bg] = TEAL
+        out[r : r + sz, c : c + sz] = blk
+
+    def obstacle_at(r: int, c: int) -> int | None:
+        colors = set(map(int, np.unique(base[r : r + sz, c : c + sz])))
+        colors.discard(bg)
+        colors.discard(TEAL)
+        if not colors:
+            return None
+        assert len(colors) == 1
+        return int(next(iter(colors)))
+
+    for d0 in range(4):
+        r, c, d = int(sr), int(sc), d0
+        seen: set[tuple[int, int, int]] = set()
+        while True:
+            state = (r, c, d)
+            assert state not in seen
+            seen.add(state)
+            dr, dc = _DIRS[d]
+            nr, nc = r + dr, c + dc
+            if not in_bounds(nr, nc):
+                break
+            obs = obstacle_at(nr, nc)
+            if obs is None:
+                r, c = nr, nc
+                paint(r, c)
+                continue
+            d = _rot(d, turns[obs])
+    return out
+
+
+def _gen_attempt() -> np.ndarray | None:
+    h, w = random.randint(*GRID_H_RANGE), GRID_W
+    sz = 2 if random.random() < TEAL_SZ2_PROB else 3
+    obstacle_count = 4 if random.random() < OBS_COUNT_4_PROB else 3
+    present = set(random.sample([_N, _E, _S, _W], obstacle_count))
+    target_hits = random.choice([4, 5])
+    second_hits = target_hits - obstacle_count
+    if second_hits < 0 or second_hits > 2:
+        return None
+
+    ns = _thickness_pair(h, sz, _N in present, _S in present)
+    ew = _thickness_pair(w, sz, _W in present, _E in present)
+    if ns is None or ew is None:
+        return None
+    thickness = {s: t for s, t in zip((_N, _S, _W, _E), (*ns, *ew)) if t is not None}
+
+    min_r, max_r = SQUARE_EDGE_GAP, h - sz - SQUARE_EDGE_GAP
+    min_c, max_c = SQUARE_EDGE_GAP, w - sz - SQUARE_EDGE_GAP
+    if _N in present:
+        min_r = max(min_r, thickness[_N] + 1)
+    if _S in present:
+        max_r = min(max_r, h - thickness[_S] - sz - 1)
+    if _W in present:
+        min_c = max(min_c, thickness[_W] + 1)
+    if _E in present:
+        max_c = min(max_c, w - thickness[_E] - sz - 1)
+    if min_r > max_r or min_c > max_c:
+        return None
+    sr, sc = random.randint(min_r, max_r), random.randint(min_c, max_c)
+
+    lane: dict[int, int] = {}
+    if _N in present:
+        lane[_N] = thickness[_N] + 1
+    if _S in present:
+        lane[_S] = h - thickness[_S] - sz
+    if _W in present:
+        lane[_W] = thickness[_W] + 1
+    if _E in present:
+        lane[_E] = w - thickness[_E] - sz
+
+    chains = _select_chains(present, second_hits)
+    if chains is None:
+        return None
+
+    side_turn = _assign_turns(present, chains)
