+
+    return out, hits
+
+
+def _lane_interval(side: int, lane: dict[int, int], sz: int) -> tuple[int, int]:
+    return lane[side], lane[side] + sz - 1
+
+
+def _build_constraints(
+    pairs: list[tuple[int, int]], common_turn: str, sr: int, sc: int, sz: int, lane: dict[int, int]
+) -> tuple[dict[int, list[tuple[int, int]]], dict[int, list[tuple[int, int]]]]:
+    required: dict[int, list[tuple[int, int]]] = {side: [] for side in (_N, _E, _S, _W)}
+    excluded: dict[int, list[tuple[int, int]]] = {side: [] for side in (_N, _E, _S, _W)}
+
+    for side in (_N, _S):
+        required[side].append((sc, sc + sz - 1))
+    for side in (_E, _W):
+        required[side].append((sr, sr + sz - 1))
+
+    for first, second in pairs:
+        required[second].append(_lane_interval(first, lane, sz))
+        after = _rot(second, common_turn)
+        excluded[after].append(_lane_interval(second, lane, sz))
+
+    return required, excluded
+
+
+def _gen_attempt() -> np.ndarray | None:
+    h, w = random.randint(*GRID_H_RANGE), GRID_W
+    sz = 2 if random.random() < TEAL_SZ2_PROB else 3
+
+    ns = _thickness_pair(h, sz, True, True)
+    ew = _thickness_pair(w, sz, True, True)
+    if ns is None or ew is None:
+        return None
+    thickness = {_N: ns[0], _S: ns[1], _W: ew[0], _E: ew[1]}
+    assert all(t is not None for t in thickness.values())
+
+    min_r, max_r = SQUARE_EDGE_GAP, h - sz - SQUARE_EDGE_GAP
+    min_c, max_c = SQUARE_EDGE_GAP, w - sz - SQUARE_EDGE_GAP
+    min_r = max(min_r, int(thickness[_N]) + 1)
+    max_r = min(max_r, h - int(thickness[_S]) - sz - 1)
+    min_c = max(min_c, int(thickness[_W]) + 1)
+    max_c = min(max_c, w - int(thickness[_E]) - sz - 1)
+    if min_r > max_r or min_c > max_c:
+        return None
+    sr, sc = random.randint(min_r, max_r), random.randint(min_c, max_c)
+
+    lane = {
+        _N: int(thickness[_N]) + 1,
+        _S: h - int(thickness[_S]) - sz,
+        _W: int(thickness[_W]) + 1,
+        _E: w - int(thickness[_E]) - sz,
+    }
+
+    pattern = random.choice(PAIR_PATTERNS)
+    common_turn = str(pattern["turn"])
+    pairs = list(pattern["pairs"])
+    required, excluded = _build_constraints(pairs, common_turn, sr, sc, sz, lane)
+
+    spans: dict[int, tuple[int, int]] = {}
+    for side in (_N, _E, _S, _W):
+        axis_len = w if side in (_N, _S) else h
+        span = _choose_span(
+            axis_len,
+            required[side],
+            excluded[side],
+            SPAN_MIN_MULT * sz,
+            min(SPAN_MAX_MULT * sz, axis_len),
+        )
+        if span is None:
+            return None
+        spans[side] = span
+
+    legend_colors = random.sample(LEGEND_COLOR_POOL, 4)
+    pair_colors = random.sample(legend_colors, 2)
+    pair_limits = [1, 2]
+    random.shuffle(pair_limits)
+
+    side_color: dict[int, int] = {}
+    side_rule: dict[int, tuple[str, int]] = {}
+    for (a, b), color, limit in zip(pairs, pair_colors, pair_limits, strict=False):
+        side_color[a] = color
+        side_color[b] = color
+        side_rule[a] = (common_turn, limit)
+        side_rule[b] = (common_turn, limit)
+
+    bg_choices = [c for c in BG_COLOR_POOL if c not in legend_colors]
+    bg = random.choice(bg_choices)
+
+    base = np.full((h, w), bg, dtype=int)
+    base[sr : sr + sz, sc : sc + sz] = TEAL
+    occupied = np.zeros((h, w), dtype=bool)
+    for side in (_N, _E, _S, _W):
+        r0, r1, c0, c1 = _obstacle_rect(side, int(thickness[side]), spans[side], h, w)
