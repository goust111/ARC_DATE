+_DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+_N, _E, _S, _W = range(4)
+
+
+def _parse_legend(grid: np.ndarray, legend_h: int) -> dict[int, tuple[str, int]]:
+    """
+    Legend is a top region with a background color (typically 5) and 4 vertical bars.
+    Each bar encodes two parameters:
+      - left or right placement -> turn direction ('L' or 'R')
+      - bottom-aligned height   -> max turning count for that color (2 px => 1, 4 px => 2)
+    """
+    legend = grid[:legend_h, :]
+    assert legend.size, "legend must be non-empty"
+    vals, cnts = np.unique(legend, return_counts=True)
+    bg = int(vals[cnts.argmax()])
+
+    sep_cols = [c for c in range(legend.shape[1]) if np.all(legend[:, c] == bg)]
+    assert len(sep_cols) >= 2, "legend separator columns must exist"
+
+    info: dict[int, tuple[str, int]] = {}
+    for a, b in zip(sep_cols, sep_cols[1:], strict=False):
+        if b - a <= 2:
+            continue
+        interior = legend[1 : legend_h - 1, a + 1 : b]
+        colors = set(map(int, np.unique(interior)))
+        colors.discard(bg)
+        colors.discard(0)
+        assert len(colors) == 1, "each legend cell must encode exactly one color"
+        color = int(next(iter(colors)))
+        ys, xs = np.where(interior == color)
+        assert len(set(xs.tolist())) == 1, "legend bar must occupy one column"
+        x = int(xs[0])
+        turn = "L" if x <= (interior.shape[1] - 1) // 2 else "R"
+
+        rows = sorted(set(map(int, ys.tolist())))
+        height = len(rows)
+        assert rows == list(range(interior.shape[0] - height, interior.shape[0])), "legend bar must be bottom-aligned"
+        assert height in (2, 4), "legend bar height must encode 1 or 2 turns"
+        info[color] = (turn, height // 2)
+
+    assert len(info) == 4, "legend must encode four colors"
+    return info
+
