+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Emit four teal beams from a square, consulting a legend that encodes both turning and durability.
+
+    Input structure:
+    - Top band: a grey legend split into four cells. In each cell, a colored vertical bar sits on the left or right and is either half-height or full-height.
+    - Below: the main grid contains a solid teal square, background cells, and colored obstacle rectangles. Obstacles of the same color share the same legend rule.
+
+    Rule:
+    - Remove the legend in the output.
+    - Launch one sz-by-sz teal beam in each cardinal direction from the teal square.
+    - A beam paints teal only onto background cells as it moves.
+    - When a beam meets color C, first read its turn direction from the bar's left/right placement, then read its per-beam turning allowance from the bar's height.
+    - If this beam has collided with color C fewer than the allowed number of times, it turns and stays in place; once that allowance is exhausted, later collisions with color C become transparent and the beam passes straight through that obstacle until it emerges on the far side.
+    - Beams stop at the grid boundary.
+
+    Key insight: Each legend bar now carries two visible parameters at once: horizontal side gives the turning sense, while vertical extent gives how many times the same color may deflect a single beam before becoming pass-through.
+    """
+    g = np.asarray(grid, dtype=int)
+
+    legend_bg = 5
+    rows_with_legend = np.where(np.any(g == legend_bg, axis=1))[0]
+    assert rows_with_legend.size, "legend rows must be present"
+    legend_h = int(rows_with_legend.max() + 1)
+    assert np.array_equal(rows_with_legend, np.arange(legend_h)), "legend color must be confined to the top band"
+
+    legend_info = _parse_legend(g, legend_h)
+    legend_colors = tuple(sorted(legend_info))
+
+    base = g[legend_h:, :].copy()
+    assert base.size, "main grid must remain after legend crop"
+
+    vals, cnts = np.unique(base, return_counts=True)
+    bg = int(vals[cnts.argmax()])
+    teal = 8
+    sr, sc, sz = _find_teal_square(base, teal=teal)
+
+    out = base.copy()
+
+    def in_bounds(r: int, c: int) -> bool:
+        return 0 <= r and 0 <= c and r + sz - 1 < out.shape[0] and c + sz - 1 < out.shape[1]
+
+    def paint_block(r: int, c: int) -> None:
+        blk = out[r : r + sz, c : c + sz]
+        blk[blk == bg] = teal
+        out[r : r + sz, c : c + sz] = blk
+
+    def obstacle_colors_at(r: int, c: int) -> set[int]:
+        blk = out[r : r + sz, c : c + sz]
+        cols = set(map(int, np.unique(blk)))
+        cols.discard(bg)
+        cols.discard(teal)
+        assert len(cols) <= 1, "beam footprint must not hit mixed obstacle colors"
+        return cols
+
+    def advance_through(nr: int, nc: int, d: int, color: int) -> tuple[int, int]:
+        dr, dc = _DIRS[d]
+        r, c = nr, nc
+        while in_bounds(r, c) and color in obstacle_colors_at(r, c):
+            r += dr
+            c += dc
+        return r, c
+
+    for d0 in range(4):
+        r, c, d = sr, sc, d0
+        used = {color: 0 for color in legend_colors}
+        seen: set[tuple[int, int, int, tuple[int, ...]]] = set()
+        while True:
+            state = (r, c, d, tuple(used[color] for color in legend_colors))
+            assert state not in seen, "beam path must not cycle"
+            seen.add(state)
+
+            dr, dc = _DIRS[d]
+            nr, nc = r + dr, c + dc
+            if not in_bounds(nr, nc):
+                break
+
+            cols = obstacle_colors_at(nr, nc)
+            if not cols:
+                r, c = nr, nc
+                paint_block(r, c)
+                continue
+
+            color = int(next(iter(cols)))
+            assert color in legend_info, "obstacle color must be encoded by legend"
+            turn, limit = legend_info[color]
+            if used[color] < limit:
+                used[color] += 1
+                d = _rot(d, turn)
+                continue
+
+            pr, pc = advance_through(nr, nc, d, color)
+            if not in_bounds(pr, pc):
+                break
+            r, c = pr, pc
+            paint_block(r, c)
+
+    return out
+
+
+# --------------- generator ---------------
+
+LEGEND_COLOR_POOL = [1, 2, 3, 4, 6]
+BG_COLOR_POOL = [1, 2, 3, 4, 6, 7, 9]
+LEGEND_BG = 5
+TEAL = 8
+
+GRID_H_RANGE = (19, 24)
+GRID_W = 24
+LEGEND_H = 6
+LEGEND_CELL_STARTS = [1, 7, 13, 19]
+
+TEAL_SZ2_PROB = 0.75
+SQUARE_EDGE_GAP = 5
+
+OBS_THICKNESS_RANGE = (2, 4)
+OBS_SINGLE_MARGIN = 6
+OBS_BOTH_GAP = 2
+
+SPAN_MIN_MULT = 3
+SPAN_MAX_MULT = 14
+SPAN_COMPACT_PROB = 0.4
+
+MAX_RETRIES = 300
+
+PAIR_PATTERNS = [
+    {"turn": "R", "pairs": [(_N, _E), (_S, _W)]},
+    {"turn": "L", "pairs": [(_N, _W), (_S, _E)]},
+]
+
+
+def _choose_span(
+    axis_len: int,
+    required: list[tuple[int, int]],
+    excluded: list[tuple[int, int]],
+    min_len: int,
+    max_len: int,
+) -> tuple[int, int] | None:
+    """Pick a span that covers all required intervals and avoids all excluded intervals."""
+    req0 = min(a for a, _ in required)
+    req1 = max(b for _, b in required)
+    lo = max(min_len, req1 - req0 + 1)
+    hi = min(max_len, axis_len)
+    choices: list[tuple[int, int, int]] = []
+    for length in range(lo, hi + 1):
+        start0 = max(0, req1 - length + 1)
+        start1 = min(req0, axis_len - length)
+        for start in range(start0, start1 + 1):
+            end = start + length - 1
+            if all(end < a or start > b for a, b in excluded):
+                choices.append((length, start, end))
+    if not choices:
+        return None
+
+    lengths = sorted({length for length, _, _ in choices})
+    if random.random() < SPAN_COMPACT_PROB:
+        cutoff = lengths[min(len(lengths) - 1, max(0, len(lengths) // 2))]
+        pool = [(start, end) for length, start, end in choices if length <= cutoff]
+    else:
+        pool = [(start, end) for _, start, end in choices]
+    return random.choice(pool)
+
+
+def _rand_thickness(lo: int, hi: int) -> int | None:
+    return random.randint(lo, hi) if hi >= lo else None
+
+
+def _thickness_pair(
+    axis: int, sz: int, a_present: bool, b_present: bool
+) -> tuple[int | None, int | None] | None:
+    lo, hi_cap = OBS_THICKNESS_RANGE
+    if a_present and b_present:
+        room = axis - sz - OBS_BOTH_GAP
+        if room < 2 * lo:
+            return None
+        a = random.randint(lo, min(hi_cap, room - lo))
+        b = _rand_thickness(lo, min(hi_cap, room - a))
+        return (a, b) if b is not None else None
+    if a_present:
+        t = _rand_thickness(lo, min(hi_cap, axis - sz - OBS_SINGLE_MARGIN))
+        return (t, None) if t is not None else None
+    if b_present:
+        t = _rand_thickness(lo, min(hi_cap, axis - sz - OBS_SINGLE_MARGIN))
+        return (None, t) if t is not None else None
+    return None, None
+
+
+def _obstacle_rect(
+    side: int, thickness: int, span: tuple[int, int], h: int, w: int
+) -> tuple[int, int, int, int]:
+    s0, s1 = span
+    if side == _N:
+        return 0, thickness - 1, s0, s1
+    if side == _S:
+        return h - thickness, h - 1, s0, s1
+    if side == _W:
+        return s0, s1, 0, thickness - 1
+    return s0, s1, w - thickness, w - 1
+
+
+def _make_legend(legend_colors: list[int], rules: dict[int, tuple[str, int]]) -> np.ndarray:
+    """Build the 6x24 legend with left/right direction and half/full-height counts."""
+    legend = np.full((LEGEND_H, GRID_W), LEGEND_BG, dtype=int)
+    for start, color in zip(LEGEND_CELL_STARTS, legend_colors):
+        legend[1:5, start : start + 4] = 0
+        turn, limit = rules[color]
+        bar_col = start if turn == "L" else start + 3
+        bar_rows = slice(3, 5) if limit == 1 else slice(1, 5)
+        legend[bar_rows, bar_col] = color
+    return legend
+
+
+def _simulate_paths(
+    base: np.ndarray, rules: dict[int, tuple[str, int]], bg: int
+) -> tuple[np.ndarray, list[list[tuple[int, int, int, int, bool]]]]:
+    """Oracle simulation for the variant; logs (dir,color,row,col,turned) per hit."""
+    teal_locs = np.argwhere(base == TEAL)
+    assert teal_locs.size
+    sr, sc = teal_locs.min(axis=0)
+    r1, c1 = teal_locs.max(axis=0)
+    sz = int(r1 - sr + 1)
+    assert sz == int(c1 - sc + 1)
+
+    out = base.copy()
+    H, W = out.shape
+    legend_colors = tuple(sorted(rules))
+    hits: list[list[tuple[int, int, int, int, bool]]] = []
+
+    def in_bounds(r: int, c: int) -> bool:
+        return 0 <= r and 0 <= c and r + sz - 1 < H and c + sz - 1 < W
+
+    def paint(r: int, c: int) -> None:
+        blk = out[r : r + sz, c : c + sz]
+        blk[blk == bg] = TEAL
+        out[r : r + sz, c : c + sz] = blk
+
+    def obstacle_colors_at(r: int, c: int) -> set[int]:
+        cols = set(map(int, np.unique(out[r : r + sz, c : c + sz])))
+        cols.discard(bg)
+        cols.discard(TEAL)
+        assert len(cols) <= 1
+        return cols
+
+    def advance_through(nr: int, nc: int, d: int, color: int) -> tuple[int, int]:
+        dr, dc = _DIRS[d]
+        r, c = nr, nc
+        while in_bounds(r, c) and color in obstacle_colors_at(r, c):
+            r += dr
+            c += dc
+        return r, c
+
+    for d0 in range(4):
+        r, c, d = int(sr), int(sc), d0
+        used = {color: 0 for color in legend_colors}
+        beam_hits: list[tuple[int, int, int, int, bool]] = []
+        seen: set[tuple[int, int, int, tuple[int, ...]]] = set()
+        while True:
+            state = (r, c, d, tuple(used[color] for color in legend_colors))
+            assert state not in seen
+            seen.add(state)
+            dr, dc = _DIRS[d]
+            nr, nc = r + dr, c + dc
+            if not in_bounds(nr, nc):
+                break
+            cols = obstacle_colors_at(nr, nc)
+            if not cols:
+                r, c = nr, nc
+                paint(r, c)
+                continue
+            color = int(next(iter(cols)))
+            turn, limit = rules[color]
+            if used[color] < limit:
+                used[color] += 1
+                beam_hits.append((d, color, nr, nc, True))
+                d = _rot(d, turn)
+                continue
+            beam_hits.append((d, color, nr, nc, False))
+            pr, pc = advance_through(nr, nc, d, color)
+            if not in_bounds(pr, pc):
+                break
+            r, c = pr, pc
+            paint(r, c)
+        hits.append(beam_hits)
+
+    return out, hits
+
+
+def _lane_interval(side: int, lane: dict[int, int], sz: int) -> tuple[int, int]:
+    return lane[side], lane[side] + sz - 1
+
+
+def _build_constraints(
+    pairs: list[tuple[int, int]], common_turn: str, sr: int, sc: int, sz: int, lane: dict[int, int]
+) -> tuple[dict[int, list[tuple[int, int]]], dict[int, list[tuple[int, int]]]]:
+    required: dict[int, list[tuple[int, int]]] = {side: [] for side in (_N, _E, _S, _W)}
+    excluded: dict[int, list[tuple[int, int]]] = {side: [] for side in (_N, _E, _S, _W)}
+
+    for side in (_N, _S):
+        required[side].append((sc, sc + sz - 1))
+    for side in (_E, _W):
+        required[side].append((sr, sr + sz - 1))
+
+    for first, second in pairs:
+        required[second].append(_lane_interval(first, lane, sz))
+        after = _rot(second, common_turn)
+        excluded[after].append(_lane_interval(second, lane, sz))
+
+    return required, excluded
+
+
+def _gen_attempt() -> np.ndarray | None:
+    h, w = random.randint(*GRID_H_RANGE), GRID_W
+    sz = 2 if random.random() < TEAL_SZ2_PROB else 3
+
+    ns = _thickness_pair(h, sz, True, True)
+    ew = _thickness_pair(w, sz, True, True)
+    if ns is None or ew is None:
+        return None
+    thickness = {_N: ns[0], _S: ns[1], _W: ew[0], _E: ew[1]}
+    assert all(t is not None for t in thickness.values())
+
+    min_r, max_r = SQUARE_EDGE_GAP, h - sz - SQUARE_EDGE_GAP
+    min_c, max_c = SQUARE_EDGE_GAP, w - sz - SQUARE_EDGE_GAP
+    min_r = max(min_r, int(thickness[_N]) + 1)
+    max_r = min(max_r, h - int(thickness[_S]) - sz - 1)
+    min_c = max(min_c, int(thickness[_W]) + 1)
+    max_c = min(max_c, w - int(thickness[_E]) - sz - 1)
+    if min_r > max_r or min_c > max_c:
+        return None
+    sr, sc = random.randint(min_r, max_r), random.randint(min_c, max_c)
+
+    lane = {
+        _N: int(thickness[_N]) + 1,
+        _S: h - int(thickness[_S]) - sz,
+        _W: int(thickness[_W]) + 1,
+        _E: w - int(thickness[_E]) - sz,
+    }
+
+    pattern = random.choice(PAIR_PATTERNS)
+    common_turn = str(pattern["turn"])
+    pairs = list(pattern["pairs"])
+    required, excluded = _build_constraints(pairs, common_turn, sr, sc, sz, lane)
+
+    spans: dict[int, tuple[int, int]] = {}
+    for side in (_N, _E, _S, _W):
+        axis_len = w if side in (_N, _S) else h
+        span = _choose_span(
+            axis_len,
+            required[side],
+            excluded[side],
+            SPAN_MIN_MULT * sz,
+            min(SPAN_MAX_MULT * sz, axis_len),
+        )
+        if span is None:
+            return None
+        spans[side] = span
+
+    legend_colors = random.sample(LEGEND_COLOR_POOL, 4)
+    pair_colors = random.sample(legend_colors, 2)
+    pair_limits = [1, 2]
+    random.shuffle(pair_limits)
+
+    side_color: dict[int, int] = {}
+    side_rule: dict[int, tuple[str, int]] = {}
+    for (a, b), color, limit in zip(pairs, pair_colors, pair_limits, strict=False):
+        side_color[a] = color
+        side_color[b] = color
+        side_rule[a] = (common_turn, limit)
+        side_rule[b] = (common_turn, limit)
+
+    bg_choices = [c for c in BG_COLOR_POOL if c not in legend_colors]
+    bg = random.choice(bg_choices)
+
+    base = np.full((h, w), bg, dtype=int)
+    base[sr : sr + sz, sc : sc + sz] = TEAL
+    occupied = np.zeros((h, w), dtype=bool)
+    for side in (_N, _E, _S, _W):
+        r0, r1, c0, c1 = _obstacle_rect(side, int(thickness[side]), spans[side], h, w)
+        region = occupied[r0 : r1 + 1, c0 : c1 + 1]
+        if region.any():
+            return None
+        if not (r1 < sr - 1 or r0 > sr + sz or c1 < sc - 1 or c0 > sc + sz):
+            return None
+        occupied[r0 : r1 + 1, c0 : c1 + 1] = True
+        base[r0 : r1 + 1, c0 : c1 + 1] = side_color[side]
+
+    rules: dict[int, tuple[str, int]] = {}
+    for color in legend_colors:
+        rules[color] = (random.choice(["L", "R"]), random.choice([1, 2]))
