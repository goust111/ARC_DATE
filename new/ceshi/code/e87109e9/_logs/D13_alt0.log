# Variant of e87109e9
# Dimension: D13 — 图例与障碍物的对应关系 (symbol_instructions)
# Change: 图例中每个颜色条目与主区域中同色障碍物一一对应——图例颜色即障碍物颜色，4个条目对应最多4种障碍物颜色... → 图例颜色与障碍物颜色不同（间接映射）
#
# Design analysis
# a) Concrete form and behavior trace:
#    - Keep the original 6x24 legend scaffold and the original beam physics.
#    - Each 4x4 legend cell now contains two colored elements on black:
#      a full-height edge bar and a central 2x2 swatch.
#    - The swatch color names the obstacle color in the main grid.
#    - The bar color is a different "symbol" color; only its left/right position
#      encodes L/R turn direction.
#    - Example: a cell with red center swatch and blue right bar means
#      "red obstacles turn right". In the original task the blue bar itself would
#      have named the obstacle; here that would be wrong.
# b) Complexity calibration:
#    - The indirect mapping is visible in every legend cell, not a one-off clue.
#    - There are still only 4 legend entries and at most 4 obstacle colors, so the
#      mapping load stays small enough for ARC.
#    - Symbol colors are a derangement of the swatch colors, so every cell is
#      visibly indirect and no cell collapses back to the old same-color regime.
# c) Old assumptions that must change:
#    - The original _parse_legend assumed exactly one non-black color per cell.
#      That is no longer valid because each cell now legitimately has two colors.
#    - The original solver keyed turns by bar color; that would mis-address
#      obstacles in the variant.
#    - The generator originally chose obstacle colors directly from legend-bar
#      colors; now it must choose obstacle colors from swatches and a separate
#      per-cell bar color pairing.
# d) Placement legality:
#    - The main-grid obstacle placement logic is unchanged, so all non-overlap,
#      edge-touching, and beam-lane guarantees are preserved.
#    - The legend layout is fixed-width, so the swatch is always in the 2x2 center
#      and the bar always occupies exactly the leftmost or rightmost interior column.
# e) Visual observability:
#    - A human sees repeated paired glyphs: "center sample color + side bar".
#      This gives a stable local cue for decoding the mapping from few examples.
#    - The rule never depends on numeric color ids or hidden ordering.
# f) Visual cleanliness:
#    - Each legend cell uses only black, one 2x2 swatch, and one edge bar.
#      Nothing overlaps, and the two roles are spatially separated.
# g) Color-change inferability:
#    - Only 4 swatch colors are involved, and each pairing is explicit inside one
#      cell. The generator rejects degenerate samples where using the old direct
#      color assumption would accidentally produce the same beam output.

import random

import numpy as np

from arc_utils import bbox_coords, components_mask

_DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]


def _parse_legend(grid: np.ndarray, legend_h: int) -> dict[int, str]:
    """
    Parse a paired legend where the center swatch names the obstacle color and
    a differently colored edge bar contributes only the L/R turn instruction.
    """
    legend = grid[:legend_h, :]
    assert legend.size, "legend must be non-empty"
    vals, cnts = np.unique(legend, return_counts=True)
    bg = int(vals[cnts.argmax()])

    sep_cols = [c for c in range(legend.shape[1]) if np.all(legend[:, c] == bg)]
    assert len(sep_cols) >= 2, "legend separator columns must exist"

    turn_by_obstacle: dict[int, str] = {}
    for a, b in zip(sep_cols, sep_cols[1:], strict=False):
        if b - a <= 2:
            continue
        interior = legend[1 : legend_h - 1, a + 1 : b]
        assert interior.shape == (4, 4), "legend cell interior must be 4x4"

        left = set(map(int, np.unique(interior[:, 0])))
        right = set(map(int, np.unique(interior[:, -1])))
        left.discard(0)
        left.discard(bg)
        right.discard(0)
        right.discard(bg)

        assert bool(left) ^ bool(right), "each legend cell needs exactly one edge bar"
        if left:
            symbol_color = int(next(iter(left)))
            assert np.all(interior[:, 0] == symbol_color), "left bar must span full height"
            turn = "L"
        else:
            symbol_color = int(next(iter(right)))
            assert np.all(interior[:, -1] == symbol_color), "right bar must span full height"
            turn = "R"

        swatch = interior[1:3, 1:3]
        swatch_colors = set(map(int, np.unique(swatch)))
        swatch_colors.discard(0)
        swatch_colors.discard(bg)
        assert len(swatch_colors) == 1, "legend swatch must be a single 2x2 color"
        obstacle_color = int(next(iter(swatch_colors)))
        assert obstacle_color != symbol_color, "legend pairing must be indirect"

        cell_colors = set(map(int, np.unique(interior)))
        cell_colors.discard(0)
        cell_colors.discard(bg)
        assert cell_colors == {symbol_color, obstacle_color}, "legend cell has unexpected colors"
        assert obstacle_color not in turn_by_obstacle, "obstacle colors must map uniquely"
        turn_by_obstacle[obstacle_color] = turn

    assert len(turn_by_obstacle) == 4, "legend must encode four obstacle instructions"
    return turn_by_obstacle


def _find_teal_square(g: np.ndarray, teal: int = 8) -> tuple[int, int, int]:
    """Return (r0,c0,size) for a solid square teal component."""
    candidates: list[tuple[int, int, int]] = []
    for cells in components_mask(g == teal, connectivity=4):
        r0, c0, r1, c1 = bbox_coords(cells)
        hh = r1 - r0 + 1
        ww = c1 - c0 + 1
        if hh != ww:
            continue
        size = hh
        if int(np.sum(g[r0 : r1 + 1, c0 : c1 + 1] == teal)) != size * size:
            continue
        candidates.append((int(r0), int(c0), int(size)))
    assert len(candidates) == 1, "main grid must contain exactly one solid teal square"
    return candidates[0]


def _rot_ccw(d: int) -> int:
    return (d - 1) % 4


def _rot_cw(d: int) -> int:
    return (d + 1) % 4


def main(grid: np.ndarray) -> np.ndarray:
    """
    Project four teal square-beams, using a legend that pairs obstacle samples
    with differently colored turn bars.

    Input structure:
    - The top band is a grey legend split into four black-backed cells.
    - Inside each cell, the middle 2x2 swatch gives an obstacle color from the
      main area, while a full-height bar on the left or right edge is a separate
      symbol color whose position carries the turn instruction.
    - Below the legend sits the main field: one solid teal square, a single bg
      color, and 3-4 obstacle rectangles touching outer edges.

    Rule:
    - Remove the legend from the output.
    - Launch one sz-by-sz teal beam from the square in each cardinal direction.
    - A beam paints only bg cells as it slides.
    - When the next footprint meets an obstacle, first identify that obstacle's
      color, then find the legend cell whose center swatch matches it; the bar's
      side decides whether the beam turns left or right.
    - Beams stop when the next step would leave the main grid.

    Key insight: the bar color is no longer the obstacle key; the obstacle is
    named by the swatch sitting in the same legend cell as the left/right bar.
    """
    g = np.asarray(grid, dtype=int)

    legend_bg = 5
    rows_with_legend = np.where(np.any(g == legend_bg, axis=1))[0]
    assert rows_with_legend.size, "legend rows must be present"
    legend_h = int(rows_with_legend.max() + 1)
    assert np.array_equal(rows_with_legend, np.arange(legend_h)), "legend color must be confined to the top band"

    legend_turn = _parse_legend(g, legend_h)

    base = g[legend_h:, :].copy()
    assert base.size, "main grid must remain after legend crop"

    vals, cnts = np.unique(base, return_counts=True)
    bg = int(vals[cnts.argmax()])
    teal = 8
    sr, sc, sz = _find_teal_square(base, teal=teal)

    out = base.copy()

    def in_bounds(r: int, c: int) -> bool:
        return 0 <= r and 0 <= c and r + sz - 1 < out.shape[0] and c + sz - 1 < out.shape[1]

    def paint_block(r: int, c: int) -> None:
        blk = out[r : r + sz, c : c + sz]
        blk[blk == bg] = teal
        out[r : r + sz, c : c + sz] = blk

    def obstacle_color_at_next(nr: int, nc: int) -> int | None:
        blk = out[nr : nr + sz, nc : nc + sz]
        cols = set(map(int, np.unique(blk)))
        cols.discard(bg)
        cols.discard(teal)
        if not cols:
            return None
        assert len(cols) == 1, "beam footprint must not hit mixed obstacle colors"
        return int(next(iter(cols)))

    for d0 in range(4):
        r, c, d = sr, sc, d0
        seen: set[tuple[int, int, int]] = set()
        while True:
            state = (r, c, d)
            assert state not in seen, "beam path must not cycle"
            seen.add(state)

            dr, dc = _DIRS[d]
            nr, nc = r + dr, c + dc
            if not in_bounds(nr, nc):
                break

            oc = obstacle_color_at_next(nr, nc)
            if oc is None:
                r, c = nr, nc
                paint_block(r, c)
                continue

            assert oc in legend_turn, "obstacle color must be represented by a legend swatch"
            turn = legend_turn[oc]
            d = _rot_ccw(d) if turn == "L" else _rot_cw(d)

    return out


# --------------- generator (o5x, D13 variant) ---------------

# ── Configuration ──────────────────────────────────────────────────────
_DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
_N, _E, _S, _W = range(4)

LEGEND_COLOR_POOL = [1, 2, 3, 4, 6]
BG_COLOR_POOL = [1, 2, 3, 4, 6, 7, 9]
LEGEND_BG = 5
TEAL = 8

GRID_H_RANGE = (19, 24)
GRID_W = 24
LEGEND_H = 6
LEGEND_CELL_STARTS = [1, 7, 13, 19]

TEAL_SZ2_PROB = 0.75
SQUARE_EDGE_GAP = 5

OBS_COUNT_4_PROB = 0.65
OBS_THICKNESS_RANGE = (2, 4)
OBS_SINGLE_MARGIN = 6
OBS_BOTH_GAP = 2

SPAN_MIN_MULT = 3
SPAN_MAX_MULT = 14
SPAN_COMPACT_PROB = 0.4

MAX_RETRIES = 300


def _rot(d: int, turn: str) -> int:
    """Rotate direction d by turn ('L' = CCW, 'R' = CW)."""
    return (d - 1) % 4 if turn == "L" else (d + 1) % 4


