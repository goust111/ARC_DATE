def legend_h(grid):
    rows = np.where(np.any(grid == mod.LEGEND_BG, axis=1))[0]
    return int(rows.max() + 1)


def extract_pairs(grid):
    h = legend_h(grid)
    legend = grid[:h, :]
    pairs = []
    for start in mod.LEGEND_CELL_STARTS:
        interior = legend[1:5, start:start+4]
        left = set(map(int, np.unique(interior[:, 0]))) - {0, mod.LEGEND_BG}
        right = set(map(int, np.unique(interior[:, 3]))) - {0, mod.LEGEND_BG}
        if left:
            bar_color = next(iter(left))
            turn = 'L'
        else:
            bar_color = next(iter(right))
            turn = 'R'
        swatch_color = int(interior[1, 1])
        pairs.append((swatch_color, bar_color, turn))
    return pairs

