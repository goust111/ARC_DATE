+# Variant of e87109e9
+# Dimension: D6 — 射线终止条件 (dst)
+# Change: 射线遇到障碍物时转弯继续，最终在到达网格边缘时终止... → 遇到特定颜色障碍物时终止（不转弯）
+
+# Design analysis
+# ----------------
+# spec:
+#   concretization:
+#     legend:
+#       - 仍然是顶部 6x24 的图例带，4 个颜色单元，背景仍为 5。
+#       - 普通转弯颜色沿用原题编码：单元内只有 1 根整列色条，靠左表示 L，靠右表示 R。
+#       - 终止颜色使用“额外标记”：同色双竖条，同时占据单元左右两侧。这样人眼能直接看出它不是普通左/右条。
+#     main_grid:
+#       - 仍然有 1 个青色实心 2x2/3x3 方块，从四个基方向发射 sz 宽光束。
+#       - 障碍物仍然是贴边的纯色长方形，颜色来自图例中的 4 种颜色。
+#     output:
+#       - 仍然裁掉图例，只保留主网格。
+#       - 光束经过背景色时涂成青色；撞到普通障碍物时按图例转弯；撞到终止色障碍物时立即停止，障碍物本体不被覆盖。
+#   behavior_trace:
+#     - 原逻辑：东向光束下一步撞到颜色 C，若 C 在图例里是右条，则方向改为顺时针，继续移动直到边界。
+#     - 新逻辑：若 C 是“双竖条”终止色，则同一个碰撞点不会转弯，光束直接结束；只保留撞击前已经涂出的路径。
+#     - 差异落点：solver 的“命中障碍物”分支，generator 的“路径仿真 / 约束构造 / 图例渲染”三处都必须同步修改。
+#   complexity_calibration:
+#     - 终止类别只保留 1 种，避免规则空间过大。
+#     - 每个样例保证至少 1 次终止碰撞，且至少还有若干普通转弯碰撞，便于解题者对比两类障碍物。
+#     - 保留 3-4 个贴边障碍与 0-2 次二次碰撞，避免退化成过于简单的“只看一条直线”。
+#   implicit_assumption_review:
+#     - 原 `_parse_legend()` 假设每个单元只有 1 根色条；变体下不成立，必须显式识别“双边条 = stop”。
+#     - 原 `main()` 在任何碰撞后都查 turn map；变体下 stop 色没有转向值，因此必须先判 stop 再判 turn。
+#     - 原 generator 的 second-hit 约束默认第二次碰撞后还可继续转弯；若第二次碰撞是 stop 色，则不能再生成第三段约束。
+#   placement_legality:
+#     - 仍使用原题的贴边矩形、跨度约束、中心方块留白和 oracle 校验，保证无遮挡重叠、无遮挡越界。
+#     - stop 色必须属于实际障碍物颜色，并且至少被 1 条光束命中；否则图例新增信息不可观察。
+#   visual_observability:
+#     - 终止色通过“双边条”这一纯视觉结构标记，不依赖颜色 id 排序或隐藏元信息。
+#     - 样例中同时出现“普通转弯命中”和“终止命中”，解题者能从 2-3 组样例归纳出哪一格代表“碰到就停”。
+#   cleanliness:
+#     - 只在图例单元内部增加第二根同色条，不引入额外区域或重叠标注；主网格仍是中心方块 + 边缘障碍 + 青色轨迹。
+#   new_solver_assumptions_and_generator_guarantees:
+#     - solver 假设图例中恰有 1 个 stop 单元、其余 3 个为单条转弯单元；generator 按此构造。
+#     - solver 假设 stop 色障碍 footprint 不会与其他颜色混杂；generator 仍维持障碍矩形互不重叠。
+#     - solver 允许某条光束在第一或第二次碰撞时终止；generator 用路径仿真验证这一点且限制每束最多 2 次碰撞。
+
+from __future__ import annotations
+
+import random
+import sys
+from pathlib import Path
+
+import numpy as np
+
+ROOT = Path(__file__).resolve().parents[5]
+SOLVERS_DIR = ROOT / "solvers"
+if str(SOLVERS_DIR) not in sys.path:
+    sys.path.append(str(SOLVERS_DIR))
+
+from arc_utils import bbox_coords, components_mask
+
+_DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+_N, _E, _S, _W = range(4)
+
+
+def _parse_legend(grid: np.ndarray, legend_h: int) -> tuple[dict[int, str], int]:
+    """
+    Legend is a top region with a background color (typically 5) and 4 vertical-bar cells.
+    Regular cells encode turn direction:
+      - bar on left  -> 'L' (turn counterclockwise)
+      - bar on right -> 'R' (turn clockwise)
+    One special cell has bars on both sides, marking the stop color.
+    """
+    legend = grid[:legend_h, :]
+    assert legend.size, "legend must be non-empty"
+    vals, cnts = np.unique(legend, return_counts=True)
+    bg = int(vals[cnts.argmax()])
+
+    sep_cols = [c for c in range(legend.shape[1]) if np.all(legend[:, c] == bg)]
+    assert len(sep_cols) >= 2, "legend separator columns must exist"
+
+    turn: dict[int, str] = {}
+    stop_colors: list[int] = []
+    for a, b in zip(sep_cols, sep_cols[1:], strict=False):
+        if b - a <= 2:
+            continue
+        interior = legend[1 : legend_h - 1, a + 1 : b]
+        colors = set(map(int, np.unique(interior)))
+        colors.discard(bg)
+        colors.discard(0)
+        assert len(colors) == 1, "each legend cell must encode exactly one color"
+        col = int(next(iter(colors)))
+        xs = sorted(set(map(int, np.where(interior == col)[1])))
+        if xs == [0, interior.shape[1] - 1]:
+            stop_colors.append(col)
+            continue
+        assert len(xs) == 1, "regular legend cells must contain exactly one bar column"
+        turn[col] = "L" if xs[0] <= (interior.shape[1] - 1) // 2 else "R"
+
+    assert len(turn) == 3, "legend must encode three turning colors"
+    assert len(stop_colors) == 1, "legend must encode exactly one stop color"
+    return turn, int(stop_colors[0])
+
+
+def _find_teal_square(g: np.ndarray, teal: int = 8) -> tuple[int, int, int]:
+    """Return (r0,c0,size) for a solid square teal component."""
+    candidates: list[tuple[int, int, int]] = []
+    for cells in components_mask(g == teal, connectivity=4):
+        r0, c0, r1, c1 = bbox_coords(cells)
+        hh = r1 - r0 + 1
+        ww = c1 - c0 + 1
+        if hh != ww:
+            continue
+        size = hh
+        if int(np.sum(g[r0 : r1 + 1, c0 : c1 + 1] == teal)) != size * size:
+            continue
+        candidates.append((int(r0), int(c0), int(size)))
+    assert len(candidates) == 1, "main grid must contain exactly one solid teal square"
+    return candidates[0]
+
+
+def _rot_ccw(d: int) -> int:
+    return (d - 1) % 4
+
+
+def _rot_cw(d: int) -> int:
+    return (d + 1) % 4
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Emit four teal beams from a square, with one legend-marked obstacle color acting as a stopper.
+
+    Input structure:
+    - Top band: grey (5) legend with four colored cells. A single left/right bar still means turn direction, while a double-sided bar marks the unique stop color.
+    - Below: main grid with bg, a solid teal (8) square, and colored obstacle blocks whose colors all appear in the legend.
+
+    Rule:
+    - Remove the legend from the output.
+    - From the teal square, shoot a sz-by-sz beam footprint in each cardinal direction.
+    - Each beam paints teal over background cells as it advances.
+    - If the next footprint hits a regular obstacle color, use that color's legend cell to turn left or right and continue.
+    - If the next footprint hits the legend's stop color, the beam terminates immediately instead of turning; beams also stop when the next step would leave the grid.
+
+    Key insight: The legend now separates obstacle roles visually: single-edge bars still encode turning, but the one cell with bars on both sides designates a color that ends the beam on contact.
+    """
+    g = np.asarray(grid, dtype=int)
+
+    legend_bg = 5
+    rows_with_legend = np.where(np.any(g == legend_bg, axis=1))[0]
+    assert rows_with_legend.size, "legend rows must be present"
+    legend_h = int(rows_with_legend.max() + 1)
+    assert np.array_equal(rows_with_legend, np.arange(legend_h)), "legend color must be confined to the top band"
+
+    legend_turn, stop_color = _parse_legend(g, legend_h)
+
+    base = g[legend_h:, :].copy()
+    assert base.size, "main grid must remain after legend crop"
+
+    vals, cnts = np.unique(base, return_counts=True)
+    bg = int(vals[cnts.argmax()])
+    teal = 8
+    sr, sc, sz = _find_teal_square(base, teal=teal)
+
+    out = base.copy()
+
+    def in_bounds(r: int, c: int) -> bool:
+        return 0 <= r and 0 <= c and r + sz - 1 < out.shape[0] and c + sz - 1 < out.shape[1]
+
+    def paint_block(r: int, c: int) -> None:
+        blk = out[r : r + sz, c : c + sz]
+        blk[blk == bg] = teal
+        out[r : r + sz, c : c + sz] = blk
+
+    def obstacle_color_at_next(nr: int, nc: int) -> int | None:
+        blk = out[nr : nr + sz, nc : nc + sz]
+        cols = set(map(int, np.unique(blk)))
+        cols.discard(bg)
+        cols.discard(teal)
+        if not cols:
+            return None
+        assert len(cols) == 1, "beam footprint must not hit mixed obstacle colors"
+        return int(next(iter(cols)))
+
+    for d0 in range(4):
+        r, c, d = sr, sc, d0
+        seen: set[tuple[int, int, int]] = set()
+        while True:
+            state = (r, c, d)
+            assert state not in seen, "beam path must not cycle"
+            seen.add(state)
+
+            dr, dc = _DIRS[d]
+            nr, nc = r + dr, c + dc
+            if not in_bounds(nr, nc):
+                break
+
+            oc = obstacle_color_at_next(nr, nc)
+            if oc is None:
+                r, c = nr, nc
+                paint_block(r, c)
+                continue
+
+            if oc == stop_color:
+                break
+
+            assert oc in legend_turn, "non-stop obstacle color must be encoded by a turning legend cell"
+            turn = legend_turn[oc]
+            d = _rot_ccw(d) if turn == "L" else _rot_cw(d)
+
+    return out
+
+
+# --------------- generator ---------------
+
+# Color palettes
+LEGEND_COLOR_POOL = [1, 2, 3, 4, 6]
+BG_COLOR_POOL = [1, 2, 3, 4, 6, 7, 9]
+LEGEND_BG = 5
+TEAL = 8
+
+# Canvas dimensions
+GRID_H_RANGE = (19, 24)
+GRID_W = 24
+LEGEND_H = 6
+LEGEND_CELL_STARTS = [1, 7, 13, 19]
+
+# Teal square
+TEAL_SZ2_PROB = 0.75
+SQUARE_EDGE_GAP = 5
+
+# Obstacles
+OBS_COUNT_4_PROB = 0.65
+OBS_THICKNESS_RANGE = (2, 4)
+OBS_SINGLE_MARGIN = 6
+OBS_BOTH_GAP = 2
+
+# Span selection
+SPAN_MIN_MULT = 3
+SPAN_MAX_MULT = 14
+SPAN_COMPACT_PROB = 0.4
+
+# Retry budget
+MAX_RETRIES = 400
+
+
+def _rot(d: int, turn: str) -> int:
+    return (d - 1) % 4 if turn == "L" else (d + 1) % 4
+
+
+def _choose_span(
+    axis_len: int,
+    required: list[tuple[int, int]],
+    excluded: list[tuple[int, int]],
+    min_len: int,
+    max_len: int,
+) -> tuple[int, int] | None:
+    """Pick a (start, end) span covering all required intervals and avoiding all excluded ones."""
+    req0 = min(a for a, _ in required)
+    req1 = max(b for _, b in required)
+    lo = max(min_len, req1 - req0 + 1)
+    hi = min(max_len, axis_len)
+    choices: list[tuple[int, int, int]] = []
+    for length in range(lo, hi + 1):
+        start0 = max(0, req1 - length + 1)
+        start1 = min(req0, axis_len - length)
+        for start in range(start0, start1 + 1):
+            end = start + length - 1
+            if all(end < a or start > b for a, b in excluded):
+                choices.append((length, start, end))
+    if not choices:
+        return None
+
+    lengths = sorted({length for length, _, _ in choices})
+    if random.random() < SPAN_COMPACT_PROB:
+        cutoff = lengths[min(len(lengths) - 1, max(0, len(lengths) // 2))]
+        pool = [(start, end) for length, start, end in choices if length <= cutoff]
+    else:
+        pool = [(start, end) for _, start, end in choices]
+    return random.choice(pool)
+
+
+def _simulate_paths(
+    base: np.ndarray, turns: dict[int, str], stop_color: int, bg: int
+) -> tuple[np.ndarray, list[list[tuple[int, int, int, int, str]]]]:
+    """Simulate 4 beams from the teal square, returning painted grid and per-beam hit lists."""
+    vals, counts = np.unique(base, return_counts=True)
+    assert int(vals[counts.argmax()]) == bg
+
+    teal_locs = np.argwhere(base == TEAL)
+    assert teal_locs.size
+    sr, sc = teal_locs.min(axis=0)
+    r1, c1 = teal_locs.max(axis=0)
+    sz = int(r1 - sr + 1)
+    assert sz == int(c1 - sc + 1)
+
+    out = base.copy()
+    h, w = out.shape
+    hits: list[list[tuple[int, int, int, int, str]]] = []
+
+    def in_bounds(r: int, c: int) -> bool:
+        return 0 <= r and 0 <= c and r + sz - 1 < h and c + sz - 1 < w
+
+    def paint(r: int, c: int) -> None:
+        blk = out[r : r + sz, c : c + sz]
+        blk[blk == bg] = TEAL
+        out[r : r + sz, c : c + sz] = blk
+
+    def obstacle_at(r: int, c: int) -> int | None:
+        colors = set(map(int, np.unique(out[r : r + sz, c : c + sz])))
+        colors.discard(bg)
+        colors.discard(TEAL)
+        if not colors:
+            return None
+        assert len(colors) == 1
+        return int(next(iter(colors)))
+
+    for d0 in range(4):
+        r, c, d = int(sr), int(sc), d0
+        beam_hits: list[tuple[int, int, int, int, str]] = []
+        seen: set[tuple[int, int, int]] = set()
+        while True:
+            state = (r, c, d)
+            assert state not in seen
+            seen.add(state)
+            dr, dc = _DIRS[d]
+            nr, nc = r + dr, c + dc
+            if not in_bounds(nr, nc):
+                break
+            obs = obstacle_at(nr, nc)
+            if obs is None:
+                r, c = nr, nc
+                paint(r, c)
+                continue
+            if obs == stop_color:
+                beam_hits.append((d, obs, nr, nc, "S"))
+                assert len(beam_hits) <= 2
+                break
+            assert obs in turns
+            beam_hits.append((d, obs, nr, nc, turns[obs]))
+            d = _rot(d, turns[obs])
+            assert len(beam_hits) <= 2
+        hits.append(beam_hits)
+
+    return out, hits
+
+
+def _make_legend(legend_colors: list[int], turns: dict[int, str], stop_color: int) -> np.ndarray:
+    """Build the 6x24 legend band from 4 colors, 3 turn cells, and 1 stop cell."""
+    legend = np.full((LEGEND_H, GRID_W), LEGEND_BG, dtype=int)
+    for start, color in zip(LEGEND_CELL_STARTS, legend_colors):
+        legend[1:5, start : start + 4] = 0
+        if color == stop_color:
+            legend[1:5, start] = color
+            legend[1:5, start + 3] = color
+        else:
+            bar_col = start if turns[color] == "L" else start + 3
+            legend[1:5, bar_col] = color
+    return legend
+
+
+def _rand_thickness(lo: int, hi: int) -> int | None:
+    return random.randint(lo, hi) if hi >= lo else None
+
+
+def _thickness_pair(
+    axis: int, sz: int, a_present: bool, b_present: bool
+) -> tuple[int | None, int | None] | None:
+    """Compute obstacle thicknesses for the two ends of an axis (N/S or W/E)."""
+    lo, hi_cap = OBS_THICKNESS_RANGE
+    if a_present and b_present:
+        room = axis - sz - OBS_BOTH_GAP
+        if room < 2 * lo:
+            return None
+        a = random.randint(lo, min(hi_cap, room - lo))
+        b = _rand_thickness(lo, min(hi_cap, room - a))
+        return (a, b) if b is not None else None
+    if a_present:
+        t = _rand_thickness(lo, min(hi_cap, axis - sz - OBS_SINGLE_MARGIN))
+        return (t, None) if t is not None else None
+    if b_present:
+        t = _rand_thickness(lo, min(hi_cap, axis - sz - OBS_SINGLE_MARGIN))
+        return (None, t) if t is not None else None
+    return None, None
+
+
+def _obstacle_rect(
+    side: int, thickness: int, span: tuple[int, int], h: int, w: int
+) -> tuple[int, int, int, int]:
+    """Return (r0, r1, c0, c1) for an edge-touching obstacle rectangle."""
+    s0, s1 = span
+    if side == _N:
+        return 0, thickness - 1, s0, s1
+    if side == _S:
+        return h - thickness, h - 1, s0, s1
+    if side == _W:
+        return s0, s1, 0, thickness - 1
+    return s0, s1, w - thickness, w - 1
+
+
+def _select_chains(present: set[int], second_hits: int, stop_side: int) -> dict[int, int] | None:
+    """Pick non-overlapping (source -> adjacent target) pairs for second hits."""
+    candidates = [
+        (side, nxt)
+        for side in present
+        if side != stop_side
+        for nxt in ((side - 1) % 4, (side + 1) % 4)
+        if nxt in present
+    ]
+    if second_hits == 0:
+        return {}
+    if len(candidates) < second_hits:
+        return None
+
+    stop_target = [pair for pair in candidates if pair[1] == stop_side]
+    other = [pair for pair in candidates if pair[1] != stop_side]
+    random.shuffle(stop_target)
+    random.shuffle(other)
+    if stop_target and random.random() < 0.7:
+        ordered = stop_target + other
+    else:
+        ordered = candidates[:]
+        random.shuffle(ordered)
+
+    selected: list[tuple[int, int]] = []
+    used: set[int] = set()
+    for side, nxt in ordered:
+        if len(selected) == second_hits:
+            break
+        if side in used or nxt in used:
+            continue
+        selected.append((side, nxt))
+        used.update((side, nxt))
+    return dict(selected) if len(selected) == second_hits else None
+
+
+def _assign_turns(present: set[int], chains: dict[int, int], stop_side: int) -> dict[int, str]:
+    """Assign L/R turn direction for each non-stop obstacle side."""
+    side_turn: dict[int, str] = {}
+    for side in present:
+        if side == stop_side:
+            continue
+        if side in chains:
+            nxt = chains[side]
+            side_turn[side] = "L" if nxt == (side - 1) % 4 else "R"
+        else:
+            outward = [t for t in ("L", "R") if _rot(side, t) not in present]
+            side_turn[side] = random.choice(outward if outward else ["L", "R"])
+    return side_turn
+
+
+def _compute_span_constraints(
+    present: set[int],
+    side_turn: dict[int, str],
+    chains: dict[int, int],
+    stop_side: int,
+    sr: int,
+    sc: int,
+    sz: int,
+    lane: dict[int, int],
+) -> tuple[dict[int, list[tuple[int, int]]], dict[int, list[tuple[int, int]]]]:
+    """Build required/excluded intervals for each obstacle's span selection."""
+    required: dict[int, list[tuple[int, int]]] = {s: [] for s in present}
+    excluded: dict[int, list[tuple[int, int]]] = {s: [] for s in present}
+
+    for side in present:
+        base_coord = sc if side in (_N, _S) else sr
+        required[side].append((base_coord, base_coord + sz - 1))
+
+    def lane_interval(s: int) -> tuple[int, int]:
+        return lane[s], lane[s] + sz - 1
+
+    for side in present:
+        if side == stop_side:
+            continue
+        nxt = _rot(side, side_turn[side])
+        if nxt not in present:
+            continue
+        if chains.get(side) == nxt:
+            required[nxt].append(lane_interval(side))
+            if nxt != stop_side:
+                after = _rot(nxt, side_turn[nxt])
+                if after in present:
+                    excluded[after].append(lane_interval(nxt))
+        else:
+            excluded[nxt].append(lane_interval(side))
+
+    return required, excluded
+
+
+def _gen_attempt() -> np.ndarray | None:
+    h, w = random.randint(*GRID_H_RANGE), GRID_W
+    sz = 2 if random.random() < TEAL_SZ2_PROB else 3
+    obstacle_count = 4 if random.random() < OBS_COUNT_4_PROB else 3
+    present = set(random.sample([_N, _E, _S, _W], obstacle_count))
+    stop_side = random.choice(sorted(present))
+    target_hits = random.choice([obstacle_count, obstacle_count + 1])
+    second_hits = target_hits - obstacle_count
+    if second_hits < 0 or second_hits > 2:
+        return None
+
+    ns = _thickness_pair(h, sz, _N in present, _S in present)
+    ew = _thickness_pair(w, sz, _W in present, _E in present)
+    if ns is None or ew is None:
+        return None
+    thickness = {s: t for s, t in zip((_N, _S, _W, _E), (*ns, *ew)) if t is not None}
+
+    min_r, max_r = SQUARE_EDGE_GAP, h - sz - SQUARE_EDGE_GAP
+    min_c, max_c = SQUARE_EDGE_GAP, w - sz - SQUARE_EDGE_GAP
+    if _N in present:
+        min_r = max(min_r, thickness[_N] + 1)
+    if _S in present:
+        max_r = min(max_r, h - thickness[_S] - sz - 1)
+    if _W in present:
+        min_c = max(min_c, thickness[_W] + 1)
+    if _E in present:
+        max_c = min(max_c, w - thickness[_E] - sz - 1)
+    if min_r > max_r or min_c > max_c:
+        return None
+    sr, sc = random.randint(min_r, max_r), random.randint(min_c, max_c)
+
+    lane: dict[int, int] = {}
+    if _N in present:
+        lane[_N] = thickness[_N] + 1
+    if _S in present:
+        lane[_S] = h - thickness[_S] - sz
+    if _W in present:
+        lane[_W] = thickness[_W] + 1
+    if _E in present:
+        lane[_E] = w - thickness[_E] - sz
+
+    chains = _select_chains(present, second_hits, stop_side)
+    if chains is None:
+        return None
+
+    side_turn = _assign_turns(present, chains, stop_side)
+    required, excluded = _compute_span_constraints(
+        present, side_turn, chains, stop_side, sr, sc, sz, lane
