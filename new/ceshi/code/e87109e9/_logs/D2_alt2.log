+
+    # Prevent visual regression into the original geometry: require at least one obstacle whose
+    # side and aspect ratio disagree with the old "top/bottom horizontal, left/right vertical" pattern.
+    noncanonical = any(
+        (side in (_N, _S) and side_turn[side] == "L") or
+        (side in (_W, _E) and side_turn[side] == "R")
+        for side in present
+    )
+    if not noncanonical:
+        return None
+
+    ns = _choose_depth_pair(
+        h, sz, _N, _N in present, side_turn.get(_N), _S, _S in present, side_turn.get(_S)
+    )
+    ew = _choose_depth_pair(
+        w, sz, _W, _W in present, side_turn.get(_W), _E, _E in present, side_turn.get(_E)
+    )
+    if ns is None or ew is None:
+        return None
+    thickness = {
+        side: depth
+        for side, depth in zip((_N, _S, _W, _E), (*ns, *ew))
+        if depth is not None
+    }
+
+    min_r, max_r = SQUARE_EDGE_GAP, h - sz - SQUARE_EDGE_GAP
+    min_c, max_c = SQUARE_EDGE_GAP, w - sz - SQUARE_EDGE_GAP
+    if _N in present:
+        min_r = max(min_r, thickness[_N] + 1)
+    if _S in present:
+        max_r = min(max_r, h - thickness[_S] - sz - 1)
+    if _W in present:
+        min_c = max(min_c, thickness[_W] + 1)
+    if _E in present:
+        max_c = min(max_c, w - thickness[_E] - sz - 1)
+    if min_r > max_r or min_c > max_c:
+        return None
+    sr, sc = random.randint(min_r, max_r), random.randint(min_c, max_c)
+
+    lane: dict[int, int] = {}
+    if _N in present:
+        lane[_N] = thickness[_N]
+    if _S in present:
+        lane[_S] = h - thickness[_S] - sz
+    if _W in present:
+        lane[_W] = thickness[_W]
+    if _E in present:
+        lane[_E] = w - thickness[_E] - sz
+
+    required, excluded = _compute_span_constraints(present, side_turn, chains, sr, sc, sz, lane)
+
+    spans: dict[int, tuple[int, int]] = {}
+    for side in present:
+        axis_len = w if side in (_N, _S) else h
+        min_len, max_len = _len_bounds(_span_profile(side, side_turn[side]), axis_len, sz)
+        span = _choose_span(axis_len, required[side], excluded[side], min_len, max_len)
+        if span is None:
+            return None
+        spans[side] = span
+
+    side_color = dict(zip(sorted(present), random.sample(OBSTACLE_COLOR_POOL, obstacle_count)))
+    bg_choices = [c for c in BG_COLOR_POOL if c not in side_color.values()]
+    bg = random.choice(bg_choices)
+
+    base = np.full((h, w), bg, dtype=int)
+    base[sr : sr + sz, sc : sc + sz] = TEAL
+    occupied = np.zeros((h, w), dtype=bool)
+    for side in present:
+        r0, r1, c0, c1 = _obstacle_rect(side, thickness[side], spans[side], h, w)
+        region = occupied[r0 : r1 + 1, c0 : c1 + 1]
+        if region.any():
+            return None
+        if not (r1 < sr - 1 or r0 > sr + sz or c1 < sc - 1 or c0 > sc + sz):
+            return None
+        occupied[r0 : r1 + 1, c0 : c1 + 1] = True
+        base[r0 : r1 + 1, c0 : c1 + 1] = side_color[side]
+
+    vals, counts = np.unique(base, return_counts=True)
+    if int(vals[counts.argmax()]) != bg:
+        return None
+
+    try:
+        expected, hits = _simulate_paths(base, bg)
+    except AssertionError:
+        return None
+
+    hit_counts = [len(beam) for beam in hits]
+    hit_colors = {color for beam in hits for _, color, _, _ in beam}
+    if sum(hit_counts) != target_hits or any(c > 2 for c in hit_counts):
+        return None
+    if set(side_color.values()) - hit_colors:
+        return None
+
+    try:
+        actual = main(base)
+    except AssertionError:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    return base
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate e87109e9 D2 variant input")

