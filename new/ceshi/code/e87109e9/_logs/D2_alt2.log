   170	    def in_bounds(r: int, c: int) -> bool:
   171	        return 0 <= r and 0 <= c and r + sz - 1 < out.shape[0] and c + sz - 1 < out.shape[1]
   172	
   173	    def paint_block(r: int, c: int) -> None:
