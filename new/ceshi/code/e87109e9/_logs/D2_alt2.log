+# Variant of e87109e9
+# Dimension: D2 — 转弯规则 (path)
+# Change: 遇到障碍物时根据图例查找该颜色——图例中颜色条在左侧表示逆时针转弯，在右侧表示顺时针转弯... → 障碍物形状编码转弯方向
+
+import random
+
+import numpy as np
+
+from arc_utils import bbox_coords, components_mask
+
+# Design analysis for the D2 variant
+# ----------------------------------
+# variant_spec:
+#   preserved_core:
+#     - input still contains one teal source square, 3-4 rectangular obstacles, and one uniform background
+#     - four sz-by-sz teal beams still launch in the four cardinal directions
+#     - a beam still paints only background cells, turns in place when its next footprint would hit an obstacle,
+#       and stops at the grid boundary
+#     - generator still targets 4-5 total obstacle hits and at most 2 hits per beam
+#   changed_dimension:
+#     - the legend band is removed entirely
+#     - turn direction is now encoded by the obstacle's own aspect ratio:
+#       width > height => clockwise
+#       height > width => counterclockwise
+#   concrete_visualization:
+#     - wide top/bottom bars are clockwise obstacles
+#     - tall top/bottom pillars are counterclockwise obstacles
+#     - tall left/right pillars are counterclockwise obstacles
+#     - wide left/right tongues are clockwise obstacles
+#     - all obstacles remain solid, single-color, edge-touching rectangles so the scene still reads like the
+#       original task, but the codebook is now geometric instead of being separated into a legend
+#   behavior_trace:
+#     - original logic:
+#       a north-going beam reaches a red obstacle, looks up red in the legend, then turns left/right
+#     - new logic:
+#       the same north-going beam reaches a red obstacle, inspects only that obstacle's bbox, and turns
+#       clockwise if the rectangle is wider than tall, else counterclockwise if taller than wide
+#     - key difference:
+#       color is no longer the source of control; the same color would be irrelevant without the obstacle shape
+#   complexity_calibration:
+#     - the task keeps only two turn categories (wide vs tall), which is enough for repeated evidence
+#     - generator rejects samples where all obstacles encode the same turn, so each grid typically displays both
+#       wide and tall cases
+#     - generator also enforces at least one "non-canonical" obstacle orientation
+#       (top/bottom tall or left/right wide), preventing degeneration back to the original side-bar look
+#   hidden_assumptions_review:
+#     - old main() assumed a dedicated legend color 5 exists in a top band; that assumption is invalid now, so
+#       all legend parsing and cropping must be removed
+#     - old main() used obstacle color -> turn lookup; that is invalid now, so the solver must recover each
+#       obstacle component and derive turn from geometry
+#     - the old obstacle hit test assumed the next beam footprint intersects at most one obstacle color;
+#       this remains safe only if the generator avoids mixed-footprint contacts, so the new generator validates
+#       every sample with the same simulation used by the solver
+#   placement_legality:
+#     - each obstacle touches exactly one outer edge
+#     - rectangles do not overlap the source square and do not overlap one another
+#     - obstacle interval constraints are still chosen path-first so first hits and optional second hits are
+#       guaranteed by construction
+#   visual_observability:
+#     - the variant is visible even without reading colors: wide rectangles and tall rectangles appear in the
+#       input, and their resulting bend direction differs in the output
+#     - the generator keeps short dimensions in 2-4 cells and long dimensions in 6+ cells, making the aspect
+#       ratio obvious rather than subtle
+#   cleanliness:
+#     - no legend means less clutter
+#     - only one object layer occupies each region in the input: source square, background, or one solid obstacle
+#   new_solver_assumptions_and_generator_guarantees:
+#     - every obstacle is a solid non-square rectangle
+#     - every obstacle color forms exactly one 4-connected component
+#     - every beam footprint that hits an obstacle overlaps exactly one obstacle component
+#     - generate_input() enforces these conditions and oracle-checks the produced grid with main()
+
+_DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+_N, _E, _S, _W = range(4)
+
+
+def _find_teal_square(g: np.ndarray, teal: int = 8) -> tuple[int, int, int]:
+    """Return (r0, c0, size) for the unique solid teal square."""
+    candidates: list[tuple[int, int, int]] = []
+    for cells in components_mask(g == teal, connectivity=4):
+        r0, c0, r1, c1 = bbox_coords(cells)
+        hh = r1 - r0 + 1
+        ww = c1 - c0 + 1
+        if hh != ww:
+            continue
+        if int(np.sum(g[r0 : r1 + 1, c0 : c1 + 1] == teal)) != hh * ww:
+            continue
+        candidates.append((int(r0), int(c0), int(hh)))
+    assert len(candidates) == 1, "grid must contain exactly one solid teal square"
+    return candidates[0]
+
+
+def _rot_ccw(d: int) -> int:
+    return (d - 1) % 4
+
+
+def _rot_cw(d: int) -> int:
+    return (d + 1) % 4
+
+
+def _rot(d: int, turn: str) -> int:
+    return _rot_ccw(d) if turn == "L" else _rot_cw(d)
+
+
+def _turn_from_dims(hh: int, ww: int) -> str:
+    assert hh != ww, "shape-encoded obstacles must be non-square"
+    return "R" if ww > hh else "L"
+
+
+def _build_obstacle_maps(
+    g: np.ndarray, bg: int, teal: int
+) -> tuple[np.ndarray, dict[int, str], dict[int, int]]:
+    """Return component id grid, component->turn map, and component->color map."""
+    comp_ids = np.full(g.shape, -1, dtype=int)
+    comp_turn: dict[int, str] = {}
+    comp_color: dict[int, int] = {}
+    next_id = 0
+
+    colors = sorted(set(map(int, np.unique(g))) - {bg, teal})
+    for color in colors:
+        comps = list(components_mask(g == color, connectivity=4))
+        assert len(comps) == 1, "each obstacle color must form exactly one component"
+        cells = comps[0]
+        r0, c0, r1, c1 = bbox_coords(cells)
+        hh = r1 - r0 + 1
+        ww = c1 - c0 + 1
+        assert int(cells.shape[0]) == hh * ww, "obstacles must be solid rectangles"
+        turn = _turn_from_dims(hh, ww)
+        for r, c in cells:
+            comp_ids[int(r), int(c)] = next_id
+        comp_turn[next_id] = turn
+        comp_color[next_id] = int(color)
+        next_id += 1
+
+    return comp_ids, comp_turn, comp_color
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Launch four teal square beams across the board, bending at obstacles by shape.
+
+    Input structure:
+    - A single main grid only; this variant removes the legend band entirely.
+    - The grid contains one solid teal (8) square, a uniform background, and 3-4 colored obstacle rectangles.
+    - Each obstacle is deliberately non-square, so its geometry visibly encodes a turn direction.
+
+    Rule:
+    - Keep the full grid size; nothing is cropped away in the output.
+    - Emit four cardinal beams from the teal square, treating the beam as a sliding sz-by-sz copy of the square.
+    - As the beam advances, it paints teal onto background cells only.
+    - If the next beam footprint would hit an obstacle, turn in place instead of entering it:
+    - wide obstacle (width > height) => clockwise turn; tall obstacle (height > width) => counterclockwise turn.
+    - Continue until the beam would leave the grid.
+
+    Key insight: The removed legend is replaced by the obstacle rectangles themselves; their aspect ratio is the
+    only signal that determines whether a beam bends clockwise or counterclockwise.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.size, "grid must be non-empty"
+
+    vals, counts = np.unique(g, return_counts=True)
+    bg = int(vals[counts.argmax()])
+    teal = 8
+    sr, sc, sz = _find_teal_square(g, teal=teal)
+    obstacle_ids, obstacle_turn, _ = _build_obstacle_maps(g, bg, teal)
+    assert 3 <= len(obstacle_turn) <= 4, "variant expects 3-4 obstacles"
+
+    out = g.copy()
+
+    def in_bounds(r: int, c: int) -> bool:
+        return 0 <= r and 0 <= c and r + sz - 1 < out.shape[0] and c + sz - 1 < out.shape[1]
+
+    def paint_block(r: int, c: int) -> None:
+        blk = out[r : r + sz, c : c + sz]
+        blk[blk == bg] = teal
+        out[r : r + sz, c : c + sz] = blk
+
+    def obstacle_turn_at_next(nr: int, nc: int) -> str | None:
+        blk = obstacle_ids[nr : nr + sz, nc : nc + sz]
+        ids = set(map(int, np.unique(blk)))
+        ids.discard(-1)
+        if not ids:
+            return None
+        assert len(ids) == 1, "beam footprint must not hit multiple obstacles at once"
+        return obstacle_turn[int(next(iter(ids)))]
+
+    for d0 in range(4):
+        r, c, d = sr, sc, d0
+        seen: set[tuple[int, int, int]] = set()
+        while True:
+            state = (r, c, d)
+            assert state not in seen, "beam path must not cycle"
+            seen.add(state)
+
+            dr, dc = _DIRS[d]
+            nr, nc = r + dr, c + dc
+            if not in_bounds(nr, nc):
+                break
+
+            turn = obstacle_turn_at_next(nr, nc)
+            if turn is None:
+                r, c = nr, nc
+                paint_block(r, c)
+                continue
+
+            d = _rot(d, turn)
+
+    return out
+
+
+# --------------- generator ---------------
+
+OBSTACLE_COLOR_POOL = [1, 2, 3, 4, 5, 6, 7, 9]
+BG_COLOR_POOL = [1, 2, 3, 4, 5, 6, 7, 9]
+TEAL = 8
+
+GRID_H_RANGE = (19, 24)
+GRID_W = 24
+
+TEAL_SZ2_PROB = 0.75
+SQUARE_EDGE_GAP = 5
+
+OBS_COUNT_4_PROB = 0.65
+SHORT_DIM_RANGE = (2, 4)
+LONG_DEPTH_RANGE = (6, 8)
+LONG_SPAN_MIN = 6
+LONG_SPAN_MAX = 13
+
+MAX_RETRIES = 400
+
+
+def _choose_span(
+    axis_len: int,
+    required: list[tuple[int, int]],
+    excluded: list[tuple[int, int]],
+    min_len: int,
+    max_len: int,
+) -> tuple[int, int] | None:
+    """Pick an interval that covers all required spans and avoids all excluded spans."""
+    req0 = min(a for a, _ in required)
+    req1 = max(b for _, b in required)
+    lo = max(min_len, req1 - req0 + 1)
+    hi = min(max_len, axis_len)
+    choices: list[tuple[int, int]] = []
+    for length in range(lo, hi + 1):
+        start0 = max(0, req1 - length + 1)
+        start1 = min(req0, axis_len - length)
+        for start in range(start0, start1 + 1):
+            end = start + length - 1
+            if all(end < a or start > b for a, b in excluded):
+                choices.append((start, end))
+    return random.choice(choices) if choices else None
+
+
+def _depth_profile(side: int, turn: str) -> str:
+    if side in (_N, _S):
+        return "long" if turn == "L" else "short"
+    return "long" if turn == "R" else "short"
+
+
+def _span_profile(side: int, turn: str) -> str:
+    return "short" if _depth_profile(side, turn) == "long" else "long"
+
+
+def _len_bounds(profile: str, axis_len: int, sz: int) -> tuple[int, int]:
+    if profile == "short":
+        lo = sz
+        hi = min(SHORT_DIM_RANGE[1], axis_len)
+    else:
+        lo = LONG_SPAN_MIN
+        hi = min(LONG_SPAN_MAX, axis_len)
+    return lo, hi
+
+
+def _candidate_depths(side: int, turn: str, axis_len: int, sz: int) -> list[int]:
+    profile = _depth_profile(side, turn)
+    if profile == "short":
+        lo, hi = SHORT_DIM_RANGE
+    else:
+        lo, hi = LONG_DEPTH_RANGE
+    hi = min(hi, axis_len - sz - 1)
+    lo = min(lo, hi) if hi >= lo else lo
+    return list(range(lo, hi + 1)) if hi >= lo else []
+
+
+def _choose_depth_pair(
+    axis_len: int,
+    sz: int,
+    side_a: int,
+    present_a: bool,
+    turn_a: str | None,
+    side_b: int,
+    present_b: bool,
+    turn_b: str | None,
+) -> tuple[int | None, int | None] | None:
+    """Choose edge depths while preserving at least one legal source position."""
+    vals_a = _candidate_depths(side_a, turn_a, axis_len, sz) if present_a and turn_a is not None else [None]
+    vals_b = _candidate_depths(side_b, turn_b, axis_len, sz) if present_b and turn_b is not None else [None]
+    choices: list[tuple[int | None, int | None]] = []
+    for da in vals_a:
+        for db in vals_b:
+            min_pos = SQUARE_EDGE_GAP
+            max_pos = axis_len - sz - SQUARE_EDGE_GAP
+            if da is not None:
+                min_pos = max(min_pos, da + 1)
+            if db is not None:
+                max_pos = min(max_pos, axis_len - db - sz - 1)
+            if min_pos <= max_pos:
+                choices.append((da, db))
+    return random.choice(choices) if choices else None
+
+
+def _obstacle_rect(
+    side: int, depth: int, span: tuple[int, int], h: int, w: int
+) -> tuple[int, int, int, int]:
+    """Return (r0, r1, c0, c1) for an edge-touching obstacle rectangle."""
+    s0, s1 = span
+    if side == _N:
+        return 0, depth - 1, s0, s1
+    if side == _S:
+        return h - depth, h - 1, s0, s1
+    if side == _W:
+        return s0, s1, 0, depth - 1
+    return s0, s1, w - depth, w - 1
+
+
+def _select_chains(present: set[int], second_hits: int) -> dict[int, int] | None:
+    """Pick non-overlapping source->adjacent-target pairs for beams with a second hit."""
+    candidates = [
+        (side, nxt)
+        for side in present
+        for nxt in ((side - 1) % 4, (side + 1) % 4)
+        if nxt in present
+    ]
+    random.shuffle(candidates)
+    selected: list[tuple[int, int]] = []
+    used: set[int] = set()
+    for side, nxt in candidates:
+        if len(selected) == second_hits:
+            break
+        if side in used or nxt in used:
+            continue
+        selected.append((side, nxt))
+        used.update((side, nxt))
+    return dict(selected) if len(selected) == second_hits else None
+
+
+def _assign_turns(present: set[int], chains: dict[int, int]) -> dict[int, str]:
+    """Assign the needed turn direction on each obstacle side."""
+    side_turn: dict[int, str] = {}
+    for side in present:
+        if side in chains:
+            nxt = chains[side]
+            side_turn[side] = "L" if nxt == (side - 1) % 4 else "R"
+        else:
+            outward = [t for t in ("L", "R") if _rot(side, t) not in present]
+            side_turn[side] = random.choice(outward if outward else ["L", "R"])
+    return side_turn
+
+
+def _compute_span_constraints(
+    present: set[int],
+    side_turn: dict[int, str],
+    chains: dict[int, int],
+    sr: int,
+    sc: int,
+    sz: int,
+    lane: dict[int, int],
+) -> tuple[dict[int, list[tuple[int, int]]], dict[int, list[tuple[int, int]]]]:
+    """Build required/excluded intervals for obstacle spans along their edge axis."""
+    required: dict[int, list[tuple[int, int]]] = {s: [] for s in present}
+    excluded: dict[int, list[tuple[int, int]]] = {s: [] for s in present}
+
+    for side in present:
+        base_coord = sc if side in (_N, _S) else sr
+        required[side].append((base_coord, base_coord + sz - 1))
+
+    def lane_interval(s: int) -> tuple[int, int]:
+        return lane[s], lane[s] + sz - 1
+
+    for side in present:
+        nxt = _rot(side, side_turn[side])
+        if nxt not in present:
+            continue
+        if chains.get(side) == nxt:
+            required[nxt].append(lane_interval(side))
+            after = _rot(nxt, side_turn[nxt])
+            if after in present:
+                excluded[after].append(lane_interval(nxt))
+        else:
+            excluded[nxt].append(lane_interval(side))
+
+    return required, excluded
+
+
+def _simulate_paths(
+    base: np.ndarray, bg: int
+) -> tuple[np.ndarray, list[list[tuple[int, int, int, int]]]]:
+    """Simulate the shape-based beams, returning the painted output and per-beam hit traces."""
+    sr, sc, sz = _find_teal_square(base, teal=TEAL)
+    obstacle_ids, obstacle_turn, obstacle_color = _build_obstacle_maps(base, bg, TEAL)
+
+    out = base.copy()
+    H, W = out.shape
+    hits: list[list[tuple[int, int, int, int]]] = []
+
+    def in_bounds(r: int, c: int) -> bool:
+        return 0 <= r and 0 <= c and r + sz - 1 < H and c + sz - 1 < W
+
+    def paint(r: int, c: int) -> None:
+        blk = out[r : r + sz, c : c + sz]
+        blk[blk == bg] = TEAL
+
+    def obstacle_at(r: int, c: int) -> tuple[int, str] | None:
+        ids = set(map(int, np.unique(obstacle_ids[r : r + sz, c : c + sz])))
+        ids.discard(-1)
+        if not ids:
+            return None
+        assert len(ids) == 1
+        oid = int(next(iter(ids)))
+        return obstacle_color[oid], obstacle_turn[oid]
+
+    for d0 in range(4):
+        r, c, d = int(sr), int(sc), d0
+        beam_hits: list[tuple[int, int, int, int]] = []
+        seen: set[tuple[int, int, int]] = set()
+        while True:
+            state = (r, c, d)
+            assert state not in seen
+            seen.add(state)
+            dr, dc = _DIRS[d]
+            nr, nc = r + dr, c + dc
+            if not in_bounds(nr, nc):
+                break
+            obs = obstacle_at(nr, nc)
+            if obs is None:
+                r, c = nr, nc
+                paint(r, c)
+                continue
+            color, turn = obs
+            beam_hits.append((d, color, nr, nc))
+            d = _rot(d, turn)
+            assert len(beam_hits) <= 2
+        hits.append(beam_hits)
+
+    return out, hits
+
+
+def _gen_attempt() -> np.ndarray | None:
+    h, w = random.randint(*GRID_H_RANGE), GRID_W
+    sz = 2 if random.random() < TEAL_SZ2_PROB else 3
+    obstacle_count = 4 if random.random() < OBS_COUNT_4_PROB else 3
+    present = set(random.sample([_N, _E, _S, _W], obstacle_count))
+    target_hits = random.choice([4, 5])
+    second_hits = target_hits - obstacle_count
+    if second_hits < 0 or second_hits > 2:
+        return None
+
+    chains = _select_chains(present, second_hits)
+    if chains is None:
+        return None
+    side_turn = _assign_turns(present, chains)
+    if len(set(side_turn.values())) != 2:
+        return None
+
+    # Prevent visual regression into the original geometry: require at least one obstacle whose
+    # side and aspect ratio disagree with the old "top/bottom horizontal, left/right vertical" pattern.
+    noncanonical = any(
+        (side in (_N, _S) and side_turn[side] == "L") or
+        (side in (_W, _E) and side_turn[side] == "R")
+        for side in present
+    )
+    if not noncanonical:
+        return None
+
+    ns = _choose_depth_pair(
+        h, sz, _N, _N in present, side_turn.get(_N), _S, _S in present, side_turn.get(_S)
+    )
+    ew = _choose_depth_pair(
+        w, sz, _W, _W in present, side_turn.get(_W), _E, _E in present, side_turn.get(_E)
+    )
+    if ns is None or ew is None:
+        return None
+    thickness = {
+        side: depth
+        for side, depth in zip((_N, _S, _W, _E), (*ns, *ew))
+        if depth is not None
+    }
+
+    min_r, max_r = SQUARE_EDGE_GAP, h - sz - SQUARE_EDGE_GAP
+    min_c, max_c = SQUARE_EDGE_GAP, w - sz - SQUARE_EDGE_GAP
+    if _N in present:
+        min_r = max(min_r, thickness[_N] + 1)
+    if _S in present:
+        max_r = min(max_r, h - thickness[_S] - sz - 1)
+    if _W in present:
+        min_c = max(min_c, thickness[_W] + 1)
+    if _E in present:
+        max_c = min(max_c, w - thickness[_E] - sz - 1)
+    if min_r > max_r or min_c > max_c:
+        return None
+    sr, sc = random.randint(min_r, max_r), random.randint(min_c, max_c)
+
+    lane: dict[int, int] = {}
+    if _N in present:
+        lane[_N] = thickness[_N]
+    if _S in present:
+        lane[_S] = h - thickness[_S] - sz
+    if _W in present:
+        lane[_W] = thickness[_W]
+    if _E in present:
+        lane[_E] = w - thickness[_E] - sz
+
+    required, excluded = _compute_span_constraints(present, side_turn, chains, sr, sc, sz, lane)
+
+    spans: dict[int, tuple[int, int]] = {}
+    for side in present:
+        axis_len = w if side in (_N, _S) else h
+        min_len, max_len = _len_bounds(_span_profile(side, side_turn[side]), axis_len, sz)
+        span = _choose_span(axis_len, required[side], excluded[side], min_len, max_len)
+        if span is None:
+            return None
+        spans[side] = span
+
+    side_color = dict(zip(sorted(present), random.sample(OBSTACLE_COLOR_POOL, obstacle_count)))
+    bg_choices = [c for c in BG_COLOR_POOL if c not in side_color.values()]
+    bg = random.choice(bg_choices)
+
+    base = np.full((h, w), bg, dtype=int)
+    base[sr : sr + sz, sc : sc + sz] = TEAL
+    occupied = np.zeros((h, w), dtype=bool)
+    for side in present:
+        r0, r1, c0, c1 = _obstacle_rect(side, thickness[side], spans[side], h, w)
+        region = occupied[r0 : r1 + 1, c0 : c1 + 1]
+        if region.any():
+            return None
+        if not (r1 < sr - 1 or r0 > sr + sz or c1 < sc - 1 or c0 > sc + sz):
+            return None
+        occupied[r0 : r1 + 1, c0 : c1 + 1] = True
+        base[r0 : r1 + 1, c0 : c1 + 1] = side_color[side]
+
+    vals, counts = np.unique(base, return_counts=True)
+    if int(vals[counts.argmax()]) != bg:
+        return None
+
+    try:
+        expected, hits = _simulate_paths(base, bg)
+    except AssertionError:
+        return None
+
+    hit_counts = [len(beam) for beam in hits]
+    hit_colors = {color for beam in hits for _, color, _, _ in beam}
+    if sum(hit_counts) != target_hits or any(c > 2 for c in hit_counts):
+        return None
+    if set(side_color.values()) - hit_colors:
+        return None
+
+    try:
+        actual = main(base)
+    except AssertionError:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    return base
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate e87109e9 D2 variant input")

