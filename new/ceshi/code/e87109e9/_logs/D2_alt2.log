   165	    obstacle_ids, obstacle_turn, _ = _build_obstacle_maps(g, bg, teal)
   166	    assert 3 <= len(obstacle_turn) <= 4, "variant expects 3-4 obstacles"
   167	
   168	    out = g.copy()
