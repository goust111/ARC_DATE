    77	def _find_teal_square(g: np.ndarray, teal: int = 8) -> tuple[int, int, int]:
    78	    """Return (r0, c0, size) for the unique solid teal square."""
    79	    candidates: list[tuple[int, int, int]] = []
    80	    for cells in components_mask(g == teal, connectivity=4):
