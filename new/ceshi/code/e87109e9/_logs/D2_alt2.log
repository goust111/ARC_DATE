+def _depth_profile(side: int, turn: str) -> str:
+    if side in (_N, _S):
+        return "long" if turn == "L" else "short"
+    return "long" if turn == "R" else "short"
+
+
+def _span_profile(side: int, turn: str) -> str:
+    return "short" if _depth_profile(side, turn) == "long" else "long"
+
+
+def _len_bounds(profile: str, axis_len: int, sz: int) -> tuple[int, int]:
+    if profile == "short":
+        lo = sz
+        hi = min(SHORT_DIM_RANGE[1], axis_len)
+    else:
+        lo = LONG_SPAN_MIN
+        hi = min(LONG_SPAN_MAX, axis_len)
+    return lo, hi
+
+
+def _candidate_depths(side: int, turn: str, axis_len: int, sz: int) -> list[int]:
+    profile = _depth_profile(side, turn)
+    if profile == "short":
+        lo, hi = SHORT_DIM_RANGE
+    else:
+        lo, hi = LONG_DEPTH_RANGE
+    hi = min(hi, axis_len - sz - 1)
+    lo = min(lo, hi) if hi >= lo else lo
+    return list(range(lo, hi + 1)) if hi >= lo else []
+
+
+def _choose_depth_pair(
+    axis_len: int,
+    sz: int,
+    side_a: int,
+    present_a: bool,
+    turn_a: str | None,
+    side_b: int,
+    present_b: bool,
+    turn_b: str | None,
+) -> tuple[int | None, int | None] | None:
+    """Choose edge depths while preserving at least one legal source position."""
+    vals_a = _candidate_depths(side_a, turn_a, axis_len, sz) if present_a and turn_a is not None else [None]
+    vals_b = _candidate_depths(side_b, turn_b, axis_len, sz) if present_b and turn_b is not None else [None]
+    choices: list[tuple[int | None, int | None]] = []
+    for da in vals_a:
+        for db in vals_b:
+            min_pos = SQUARE_EDGE_GAP
+            max_pos = axis_len - sz - SQUARE_EDGE_GAP
