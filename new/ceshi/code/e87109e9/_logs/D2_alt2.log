+# Variant of e87109e9
+# Dimension: D2 — 转弯规则 (path)
+# Change: 遇到障碍物时根据图例查找该颜色——图例中颜色条在左侧表示逆时针转弯，在右侧表示顺时针转弯... → 障碍物形状编码转弯方向
+
+import random
+
+import numpy as np
+
+from arc_utils import bbox_coords, components_mask
+
+# Design analysis for the D2 variant
+# ----------------------------------
+# variant_spec:
+#   preserved_core:
+#     - input still contains one teal source square, 3-4 rectangular obstacles, and one uniform background
+#     - four sz-by-sz teal beams still launch in the four cardinal directions
+#     - a beam still paints only background cells, turns in place when its next footprint would hit an obstacle,
+#       and stops at the grid boundary
+#     - generator still targets 4-5 total obstacle hits and at most 2 hits per beam
+#   changed_dimension:
+#     - the legend band is removed entirely
+#     - turn direction is now encoded by the obstacle's own aspect ratio:
+#       width > height => clockwise
+#       height > width => counterclockwise
+#   concrete_visualization:
+#     - wide top/bottom bars are clockwise obstacles
+#     - tall top/bottom pillars are counterclockwise obstacles
+#     - tall left/right pillars are counterclockwise obstacles
+#     - wide left/right tongues are clockwise obstacles
+#     - all obstacles remain solid, single-color, edge-touching rectangles so the scene still reads like the
+#       original task, but the codebook is now geometric instead of being separated into a legend
+#   behavior_trace:
+#     - original logic:
+#       a north-going beam reaches a red obstacle, looks up red in the legend, then turns left/right
+#     - new logic:
+#       the same north-going beam reaches a red obstacle, inspects only that obstacle's bbox, and turns
+#       clockwise if the rectangle is wider than tall, else counterclockwise if taller than wide
+#     - key difference:
+#       color is no longer the source of control; the same color would be irrelevant without the obstacle shape
+#   complexity_calibration:
+#     - the task keeps only two turn categories (wide vs tall), which is enough for repeated evidence
+#     - generator rejects samples where all obstacles encode the same turn, so each grid typically displays both
+#       wide and tall cases
+#     - generator also enforces at least one "non-canonical" obstacle orientation
+#       (top/bottom tall or left/right wide), preventing degeneration back to the original side-bar look
+#   hidden_assumptions_review:
+#     - old main() assumed a dedicated legend color 5 exists in a top band; that assumption is invalid now, so
+#       all legend parsing and cropping must be removed
+#     - old main() used obstacle color -> turn lookup; that is invalid now, so the solver must recover each
+#       obstacle component and derive turn from geometry
+#     - the old obstacle hit test assumed the next beam footprint intersects at most one obstacle color;
+#       this remains safe only if the generator avoids mixed-footprint contacts, so the new generator validates
+#       every sample with the same simulation used by the solver
+#   placement_legality:
+#     - each obstacle touches exactly one outer edge
+#     - rectangles do not overlap the source square and do not overlap one another
+#     - obstacle interval constraints are still chosen path-first so first hits and optional second hits are
+#       guaranteed by construction
+#   visual_observability:
+#     - the variant is visible even without reading colors: wide rectangles and tall rectangles appear in the
+#       input, and their resulting bend direction differs in the output
+#     - the generator keeps short dimensions in 2-4 cells and long dimensions in 6+ cells, making the aspect
+#       ratio obvious rather than subtle
+#   cleanliness:
+#     - no legend means less clutter
+#     - only one object layer occupies each region in the input: source square, background, or one solid obstacle
+#   new_solver_assumptions_and_generator_guarantees:
+#     - every obstacle is a solid non-square rectangle
+#     - every obstacle color forms exactly one 4-connected component
+#     - every beam footprint that hits an obstacle overlaps exactly one obstacle component
+#     - generate_input() enforces these conditions and oracle-checks the produced grid with main()
+
+_DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+_N, _E, _S, _W = range(4)
+
+
+def _find_teal_square(g: np.ndarray, teal: int = 8) -> tuple[int, int, int]:
+    """Return (r0, c0, size) for the unique solid teal square."""
+    candidates: list[tuple[int, int, int]] = []
+    for cells in components_mask(g == teal, connectivity=4):
+        r0, c0, r1, c1 = bbox_coords(cells)
+        hh = r1 - r0 + 1
+        ww = c1 - c0 + 1
+        if hh != ww:
+            continue
+        if int(np.sum(g[r0 : r1 + 1, c0 : c1 + 1] == teal)) != hh * ww:
+            continue
+        candidates.append((int(r0), int(c0), int(hh)))
