   343	def _obstacle_rect(
   344	    side: int, thickness: int, span: tuple[int, int], h: int, w: int
   345	) -> tuple[int, int, int, int]:
   346	    """Return (r0, r1, c0, c1) for an edge-touching obstacle rectangle."""
   347	    s0, s1 = span
   348	    if side == _N:
   349	        return 0, thickness - 1, s0, s1
   350	    if side == _S:
   351	        return h - thickness, h - 1, s0, s1
   352	    if side == _W:
   353	        return s0, s1, 0, thickness - 1
   354	    return s0, s1, w - thickness, w - 1
   355	
   356	
   357	def _select_chains(
   358	    present: set[int], second_hits: int
   359	) -> dict[int, int] | None:
   360	    """Pick non-overlapping (source -> adjacent target) pairs for multi-bounce beams."""
   361	    candidates = [
   362	        (side, nxt)
   363	        for side in present
   364	        for nxt in ((side - 1) % 4, (side + 1) % 4)
   365	        if nxt in present
   366	    ]
   367	    random.shuffle(candidates)
   368	    selected: list[tuple[int, int]] = []
   369	    used: set[int] = set()
   370	    for side, nxt in candidates:
   371	        if len(selected) == second_hits:
   372	            break
   373	        if side in used or nxt in used:
   374	            continue
   375	        selected.append((side, nxt))
   376	        used.update((side, nxt))
   377	    return dict(selected) if len(selected) == second_hits else None
   378	
   379	
   380	def _assign_turns(
   381	    present: set[int], chains: dict[int, int]
   382	) -> dict[int, str]:
   383	    """Assign L/R turn direction for each obstacle side."""
   384	    side_turn: dict[int, str] = {}
   385	    for side in present:
   386	        if side in chains:
   387	            nxt = chains[side]
   388	            side_turn[side] = "L" if nxt == (side - 1) % 4 else "R"
   389	        else:
   390	            outward = [t for t in ("L", "R") if _rot(side, t) not in present]
   391	            side_turn[side] = random.choice(outward if outward else ["L", "R"])
   392	    return side_turn
