/bin/bash -lc "python - <<'PY'
import importlib.util, numpy as np, statistics
spec = importlib.util.spec_from_file_location('variant', '/home/lixinyu/snap/new/ceshi/code/e87109e9/D6/0/code.py')
mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)

term_hist = {}
other_counts = []
collision_counts = []
diff_cells = []
obstacle_hits_new = []
obstacle_hits_old = []
for i in range(100):
    g = mod.generate_input()
    rows = np.where(np.any(g == mod.LEGEND_BG, axis=1))[0]
    legend_h = int(rows.max() + 1)
    turns = mod._parse_legend(g, legend_h)
    base = g[legend_h:, :].copy()
    vals, cnts = np.unique(base, return_counts=True)
    bg = int(vals[cnts.argmax()])
    old_out, old_hits, _ = mod._simulate_paths(base, turns, bg, stop_on_collision=False)
    new_out, new_hits, terms = mod._simulate_paths(base, turns, bg, stop_on_collision=True)
    diff = int(np.count_nonzero(old_out "'!= new_out))
    diff_cells.append(diff)
    other_counts.append(sum(t == '"'other' for t in terms))
    collision_counts.append(sum(t in {'self', 'other'} for t in terms))
    obstacle_hits_new.append(sum(len(b) for b in new_hits))
    obstacle_hits_old.append(sum(len(b) for b in old_hits))
    key = tuple(terms)
    term_hist[key] = term_hist.get(key, 0) + 1
print('avg diff_cells', round(statistics.mean(diff_cells), 2), 'min', min(diff_cells), 'max', max(diff_cells))
print('avg other collisions', round(statistics.mean(other_counts), 2), 'counts', {k: other_counts.count(k) for k in sorted(set(other_counts))})
print('avg total collisions', round(statistics.mean(collision_counts), 2), 'counts', {k: collision_counts.count(k) for k in sorted(set(collision_counts))})
print('avg old hits', round(statistics.mean(obstacle_hits_old), 2), 'avg new hits', round(statistics.mean(obstacle_hits_new), 2))
print('top term patterns:')
for key, cnt in sorted(term_hist.items(), key=lambda kv: (-kv[1], kv[0]))[:10]:
    print(cnt, key)
