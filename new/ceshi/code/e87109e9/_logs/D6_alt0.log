   430	def _make_legend(legend_colors: list[int], turns: dict[int, str]) -> np.ndarray:
   431	    """Build the 6x24 legend band from 4 colors and their turn assignments."""
   432	    legend = np.full((LEGEND_H, GRID_W), LEGEND_BG, dtype=int)
   433	    for start, color in zip(LEGEND_CELL_STARTS, legend_colors):
   434	        legend[1:5, start : start + 4] = 0
   435	        bar_col = start if turns[color] == "L" else start + 3
   436	        legend[1:5, bar_col] = color
   437	    return legend
