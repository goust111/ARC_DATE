   395	def _compute_span_constraints(
   396	    present: set[int],
   397	    side_turn: dict[int, str],
   398	    chains: dict[int, int],
   399	    sr: int,
   400	    sc: int,
   401	    sz: int,
   402	    lane: dict[int, int],
   403	) -> tuple[dict[int, list[tuple[int, int]]], dict[int, list[tuple[int, int]]]]:
   404	    """Build required/excluded intervals for each obstacle's span selection."""
   405	    required: dict[int, list[tuple[int, int]]] = {s: [] for s in present}
   406	    excluded: dict[int, list[tuple[int, int]]] = {s: [] for s in present}
   407	
   408	    for side in present:
   409	        base_coord = sc if side in (_N, _S) else sr
   410	        required[side].append((base_coord, base_coord + sz - 1))
   411	
   412	    def lane_interval(s: int) -> tuple[int, int]:
   413	        return lane[s], lane[s] + sz - 1
   414	
   415	    for side in present:
   416	        nxt = _rot(side, side_turn[side])
   417	        if nxt not in present:
   418	            continue
   419	        if chains.get(side) == nxt:
   420	            required[nxt].append(lane_interval(side))
   421	            after = _rot(nxt, side_turn[nxt])
   422	            if after in present:
   423	                excluded[after].append(lane_interval(nxt))
   424	        else:
   425	            excluded[nxt].append(lane_interval(side))
   426	
   427	    return required, excluded
   428	
