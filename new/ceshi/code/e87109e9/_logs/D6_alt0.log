    92	def _parse_legend(grid: np.ndarray, legend_h: int) -> dict[int, str]:
    93	    """
    94	    Legend is a top region with a background color (typically 5) and 4 vertical bars.
    95	    Each bar's horizontal position inside its cell encodes turn direction:
    96	      - bar on left  -> 'L' (turn counterclockwise)
    97	      - bar on right -> 'R' (turn clockwise)
    98	    """
    99	    legend = grid[:legend_h, :]
   100	    assert legend.size, "legend must be non-empty"
   101	    vals, cnts = np.unique(legend, return_counts=True)
   102	    bg = int(vals[cnts.argmax()])
   103	
   104	    sep_cols = [c for c in range(legend.shape[1]) if np.all(legend[:, c] == bg)]
   105	    assert len(sep_cols) >= 2, "legend separator columns must exist"
   106	
   107	    turn: dict[int, str] = {}
   108	    for a, b in zip(sep_cols, sep_cols[1:], strict=False):
   109	        if b - a <= 2:
   110	            continue
   111	        interior = legend[1 : legend_h - 1, a + 1 : b]
   112	        colors = set(map(int, np.unique(interior)))
   113	        colors.discard(bg)
   114	        colors.discard(0)
   115	        assert len(colors) == 1, "each legend cell must encode exactly one color"
   116	        col = int(next(iter(colors)))
   117	        xs = np.where(interior == col)[1]
   118	        x = int(xs[0])
   119	        turn[col] = "L" if x <= (interior.shape[1] - 1) // 2 else "R"
   120	    assert len(turn) == 4, "legend must encode four turn colors"
   121	    return turn
   122	
   123	
   124	def _find_teal_square(g: np.ndarray, teal: int = TEAL) -> tuple[int, int, int]:
   125	    """Return (r0,c0,size) for a solid square teal component."""
   126	    candidates: list[tuple[int, int, int]] = []
   127	    for cells in components_mask(g == teal, connectivity=4):
   128	        r0, c0, r1, c1 = bbox_coords(cells)
   129	        hh = r1 - r0 + 1
   130	        ww = c1 - c0 + 1
   131	        if hh != ww:
   132	            continue
   133	        size = hh
   134	        if int(np.sum(g[r0 : r1 + 1, c0 : c1 + 1] == teal)) != size * size:
   135	            continue
   136	        candidates.append((int(r0), int(c0), int(size)))
   137	    assert len(candidates) == 1, "main grid must contain exactly one solid teal square"
   138	    return candidates[0]
   139	
