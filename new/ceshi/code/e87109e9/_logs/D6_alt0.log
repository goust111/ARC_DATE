   156	def _simulate_paths(
   157	    base: np.ndarray,
   158	    turns: dict[int, str],
   159	    bg: int,
   160	    *,
   161	    stop_on_collision: bool,
   162	) -> tuple[np.ndarray, list[list[tuple[int, int, int, int]]], list[str]]:
   163	    """
   164	    Simulate 4 beams from the teal square.
   165	
   166	    `stop_on_collision=False` matches the original edge-stop task.
   167	    `stop_on_collision=True` implements the D6 variant: the beam halts when the
   168	    next step's front strip would enter already-teal cells.
   169	    """
   170	    teal_locs = np.argwhere(base == TEAL)
   171	    assert teal_locs.size
   172	    sr, sc = teal_locs.min(axis=0)
   173	    r1, c1 = teal_locs.max(axis=0)
   174	    sz = int(r1 - sr + 1)
   175	    assert sz == int(c1 - sc + 1)
   176	
   177	    out = base.copy()
   178	    owner = np.full(out.shape, -2, dtype=int)
   179	    owner[out == TEAL] = -1  # starting square
   180	    H, W = out.shape
   181	    hits: list[list[tuple[int, int, int, int]]] = []
   182	    terminations: list[str] = []
   183	
   184	    def in_bounds(r: int, c: int) -> bool:
   185	        return 0 <= r and 0 <= c and r + sz - 1 < H and c + sz - 1 < W
   186	
   187	    def paint(r: int, c: int, beam_idx: int) -> None:
   188	        blk = out[r : r + sz, c : c + sz]
   189	        bg_mask = blk == bg
   190	        blk[bg_mask] = TEAL
   191	        owner_blk = owner[r : r + sz, c : c + sz]
   192	        owner_blk[bg_mask] = beam_idx
   193	
   194	    def obstacle_at(r: int, c: int) -> int | None:
   195	        colors = set(map(int, np.unique(out[r : r + sz, c : c + sz])))
   196	        colors.discard(bg)
   197	        colors.discard(TEAL)
   198	        if not colors:
   199	            return None
   200	        assert len(colors) == 1, "beam footprint must not hit mixed obstacle colors"
   201	        return int(next(iter(colors)))
   202	
   203	    for beam_idx, d0 in enumerate(range(4)):
   204	        r, c, d = int(sr), int(sc), d0
   205	        beam_hits: list[tuple[int, int, int, int]] = []
   206	        seen: set[tuple[int, int, int]] = set()
   207	        term = "edge"
   208	        while True:
   209	            state = (r, c, d)
   210	            assert state not in seen, "beam path must not cycle"
   211	            seen.add(state)
   212	
   213	            dr, dc = _DIRS[d]
   214	            nr, nc = r + dr, c + dc
   215	            if not in_bounds(nr, nc):
   216	                term = "edge"
   217	                break
   218	
   219	            if stop_on_collision:
   220	                front = _leading_strip(out, nr, nc, sz, d)
   221	                if np.any(front == TEAL):
   222	                    front_owner = _leading_strip(owner, nr, nc, sz, d)
   223	                    owners = set(map(int, front_owner[front == TEAL].tolist()))
   224	                    if any(o >= 0 and o != beam_idx for o in owners):
   225	                        term = "other"
   226	                    elif beam_idx in owners:
   227	                        term = "self"
   228	                    else:
   229	                        term = "source"
   230	                    break
   231	
   232	            obs = obstacle_at(nr, nc)
   233	            if obs is None:
   234	                r, c = nr, nc
   235	                paint(r, c, beam_idx)
   236	                continue
   237	
   238	            assert obs in turns, "obstacle color must be encoded by legend"
   239	            beam_hits.append((d, obs, nr, nc))
   240	            d = _rot(d, turns[obs])

