   249	def main(grid: np.ndarray) -> np.ndarray:
   250	    """
   251	    Emit four teal beams from a square, turning at colored obstacles per a legend.
   252	
   253	    Input structure:
   254	    - The top band is a grey legend whose 4 cells each contain one colored vertical bar.
   255	    - The bar color names an obstacle color below, and its left/right placement encodes the turn direction.
   256	    - The main area contains one solid teal square plus several solid obstacle rectangles on the borders.
   257	
   258	    Rule:
   259	    - Remove the legend band in the output.
   260	    - Launch one sz-wide beam from the teal square in each cardinal direction, in fixed order N, E, S, W.
   261	    - A beam paints teal only onto background cells; when its next footprint meets an obstacle color, it rotates per the legend and continues.
   262	    - A beam stops as soon as the next step's newly entered front strip would land on teal that was already painted by an earlier step or earlier beam.
   263	
   264	    Key insight: The legend still tells you how obstacle colors cause left/right turns, but now beam order matters because existing teal trail acts like a barrier.
   265	    """
   266	    g = np.asarray(grid, dtype=int)
   267	
   268	    legend_bg = LEGEND_BG
   269	    rows_with_legend = np.where(np.any(g == legend_bg, axis=1))[0]
   270	    assert rows_with_legend.size, "legend rows must be present"
   271	    legend_h = int(rows_with_legend.max() + 1)
   272	    assert np.array_equal(rows_with_legend, np.arange(legend_h)), "legend color must be confined to the top band"
   273	
   274	    legend_turn = _parse_legend(g, legend_h)
   275	
   276	    base = g[legend_h:, :].copy()
   277	    assert base.size, "main grid must remain after legend crop"
   278	
   279	    vals, cnts = np.unique(base, return_counts=True)
   280	    bg = int(vals[cnts.argmax()])
   281	    _ = _find_teal_square(base, teal=TEAL)
   282	    out, _, _ = _simulate_paths(base, legend_turn, bg, stop_on_collision=True)
   283	    return out
