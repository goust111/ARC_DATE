     4	
     5	import random
     6	
     7	import numpy as np
     8	
     9	from arc_utils import bbox_coords, components_mask
    10	
    11	# Design analysis for the D6 variant.
    12	# design:
    13	#   concretization:
    14	#     preserved_structure:
    15	#       - 输入仍由顶部 6x24 图例和下方主网格组成。
    16	#       - 主体仍是一个青色实心方块，外加 3-4 个贴边单色障碍矩形。
    17	#       - 输出仍然裁掉图例，只在主网格里画出青色射线路径。
    18	#     changed_mechanism:
    19	#       - 原题的“移动方块”每次平移 1 格，因此下一位置会和当前 footprint 重叠；
    20	#         所以不能把“下一块里出现任何青色”直接当作碰撞，否则射线首步就会停。
    21	#       - 这里把碰撞具体化为：检查“下一步新进入的前沿条带”是否已经是青色。
    22	#         连续直行时允许和自己当前 footprint 的重叠；只有当前沿会进入旧轨迹时才终止。
    23	#     small_trace:
    24	#       - 设 sz=2，北向射线先上行再右转，在顶边留下横向轨迹。
    25	#       - 之后东向射线碰到右侧障碍后向上，其前沿条带若触到北向留下的横轨，就立刻停止。
    26	#       - 原规则下它会继续到边界；新规则下它会被先前射线截断，差异直接体现在输出长度上。
    27	#   complexity_calibration:
    28	#     - 保留原题的 legend 编码、障碍厚度/跨度、3-4 障碍和 0-2 次转弯框架，避免把任务改成另一题。
    29	#     - 生成器仍先构造“原题可行”的障碍布局，再筛出确实发生 collision-stop 的样本。
    30	#     - 为了让顺序依赖可见，拒绝那些新旧规则输出相同、或只有边界停止而没有射线互撞的样本。
    31	#   implicit_assumption_review:
    32	#     - 原 `main()` 的 `obstacle_color_at_next()` 默认忽略 teal，因为原题允许穿过旧轨迹直到边界。
    33	#       变体下这不再安全，所以必须在读障碍前先检查前沿条带是否已有 teal。
    34	#     - 原 `paint_block()` 只把 bg 改成 teal，这一点仍成立；障碍色不能被覆盖。
    35	#     - 原 `for d0 in range(4)` 的顺序在边界终止版里无关紧要，变体下变成关键语义。
    36	#       因此 solver 明确保留固定顺序 N,E,S,W，generator 也按同顺序做 oracle。
    37	#     - 原题把“越界”当唯一自然终点；变体后越界仍是物理终点，但样本构造应尽量让终止更早地由轨迹碰撞触发。
    38	#   placement_legality:
    39	#     - 障碍仍只放在四边，互不重叠，也不与中心青色方块接触。
    40	#     - 生成器保留原来的跨度 required/excluded 约束，保证转向后的通道和障碍对齐可解。
    41	#     - 另外过滤掉“撞到起始方块才停”的布局；保留的样本里碰撞都来自已画出的射线轨迹。
    42	#   observability:
    43	#     - 颜色本身不参与排序或时序；顺序只由固定发射方向 N,E,S,W 决定，能从多组样例归纳。
    44	#     - 生成器要求至少两次 `other` 碰撞，且新旧规则输出要有明显像素差异，确保 D6 变化肉眼可见。
    45	#   visual_cleanliness:
    46	#     - 碰撞检测只看前沿条带，避免把正常滑动时的重叠误判成碰撞。
    47	#     - 仍要求每个障碍颜色在新规则下都至少被实际命中一次，避免出现“纯装饰障碍”导致画面杂乱。
    48	#   color_inference:
