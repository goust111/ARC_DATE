   145	def _leading_strip(arr: np.ndarray, r: int, c: int, sz: int, d: int) -> np.ndarray:
   146	    """View of the newly entered 1-cell-thick strip when the sz×sz block moves one step."""
   147	    if d == _N:
   148	        return arr[r : r + 1, c : c + sz]
   149	    if d == _E:
   150	        return arr[r : r + sz, c + sz - 1 : c + sz]
   151	    if d == _S:
   152	        return arr[r + sz - 1 : r + sz, c : c + sz]
   153	    return arr[r : r + sz, c : c + 1]
