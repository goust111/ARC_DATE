   286	def _choose_span(
   287	    axis_len: int,
   288	    required: list[tuple[int, int]],
   289	    excluded: list[tuple[int, int]],
   290	    min_len: int,
   291	    max_len: int,
   292	) -> tuple[int, int] | None:
   293	    """Pick a (start, end) span covering all required intervals, avoiding all excluded intervals."""
   294	    req0 = min(a for a, _ in required)
   295	    req1 = max(b for _, b in required)
   296	    lo = max(min_len, req1 - req0 + 1)
   297	    hi = min(max_len, axis_len)
   298	    choices: list[tuple[int, int, int]] = []
   299	    for length in range(lo, hi + 1):
   300	        start0 = max(0, req1 - length + 1)
   301	        start1 = min(req0, axis_len - length)
   302	        for start in range(start0, start1 + 1):
   303	            end = start + length - 1
   304	            if all(end < a or start > b for a, b in excluded):
   305	                choices.append((length, start, end))
   306	    if not choices:
   307	        return None
   308	
   309	    lengths = sorted({length for length, _, _ in choices})
   310	    if random.random() < SPAN_COMPACT_PROB:
   311	        cutoff = lengths[min(len(lengths) - 1, max(0, len(lengths) // 2))]
   312	        pool = [(start, end) for length, start, end in choices if length <= cutoff]
   313	    else:
   314	        pool = [(start, end) for _, start, end in choices]
   315	    return random.choice(pool)
   316	
   317	
   318	def _rand_thickness(lo: int, hi: int) -> int | None:
   319	    return random.randint(lo, hi) if hi >= lo else None
   320	
   321	
   322	def _thickness_pair(
   323	    axis: int, sz: int, a_present: bool, b_present: bool
   324	) -> tuple[int | None, int | None] | None:
   325	    """Compute obstacle thicknesses for the two ends of an axis (N/S or W/E)."""
   326	    lo, hi_cap = OBS_THICKNESS_RANGE
   327	    if a_present and b_present:
   328	        room = axis - sz - OBS_BOTH_GAP
   329	        if room < 2 * lo:
   330	            return None
   331	        a = random.randint(lo, min(hi_cap, room - lo))
   332	        b = _rand_thickness(lo, min(hi_cap, room - a))
   333	        return (a, b) if b is not None else None
   334	    if a_present:
   335	        t = _rand_thickness(lo, min(hi_cap, axis - sz - OBS_SINGLE_MARGIN))
   336	        return (t, None) if t is not None else None
   337	    if b_present:
   338	        t = _rand_thickness(lo, min(hi_cap, axis - sz - OBS_SINGLE_MARGIN))
   339	        return (None, t) if t is not None else None
   340	    return None, None
   341	
