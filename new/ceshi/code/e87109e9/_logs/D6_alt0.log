   440	def _gen_attempt() -> np.ndarray | None:
   441	    h, w = random.randint(*GRID_H_RANGE), GRID_W
   442	    sz = 2 if random.random() < TEAL_SZ2_PROB else 3
   443	    obstacle_count = 4 if random.random() < OBS_COUNT_4_PROB else 3
   444	    present = set(random.sample([_N, _E, _S, _W], obstacle_count))
   445	    target_hits = random.choice([4, 5])
   446	    second_hits = target_hits - obstacle_count
   447	    if second_hits < 0 or second_hits > 2:
   448	        return None
   449	
   450	    ns = _thickness_pair(h, sz, _N in present, _S in present)
   451	    ew = _thickness_pair(w, sz, _W in present, _E in present)
   452	    if ns is None or ew is None:
   453	        return None
   454	    thickness = {s: t for s, t in zip((_N, _S, _W, _E), (*ns, *ew)) if t is not None}
   455	
   456	    min_r, max_r = SQUARE_EDGE_GAP, h - sz - SQUARE_EDGE_GAP
   457	    min_c, max_c = SQUARE_EDGE_GAP, w - sz - SQUARE_EDGE_GAP
   458	    if _N in present:
   459	        min_r = max(min_r, thickness[_N] + 1)
   460	    if _S in present:
   461	        max_r = min(max_r, h - thickness[_S] - sz - 1)
   462	    if _W in present:
   463	        min_c = max(min_c, thickness[_W] + 1)
   464	    if _E in present:
   465	        max_c = min(max_c, w - thickness[_E] - sz - 1)
   466	    if min_r > max_r or min_c > max_c:
   467	        return None
   468	    sr, sc = random.randint(min_r, max_r), random.randint(min_c, max_c)
   469	
   470	    lane: dict[int, int] = {}
   471	    if _N in present:
   472	        lane[_N] = thickness[_N] + 1
   473	    if _S in present:
   474	        lane[_S] = h - thickness[_S] - sz
   475	    if _W in present:
   476	        lane[_W] = thickness[_W] + 1
   477	    if _E in present:
   478	        lane[_E] = w - thickness[_E] - sz
   479	
   480	    chains = _select_chains(present, second_hits)
   481	    if chains is None:
   482	        return None
   483	
   484	    side_turn = _assign_turns(present, chains)
   485	    required, excluded = _compute_span_constraints(
   486	        present, side_turn, chains, sr, sc, sz, lane
   487	    )
   488	
   489	    spans: dict[int, tuple[int, int]] = {}
   490	    for side in present:
   491	        axis_len = w if side in (_N, _S) else h
   492	        span = _choose_span(
   493	            axis_len,
   494	            required[side],
   495	            excluded[side],
   496	            SPAN_MIN_MULT * sz,
   497	            min(SPAN_MAX_MULT * sz, axis_len),
   498	        )
   499	        if span is None:
   500	            return None
   501	        spans[side] = span
   502	
   503	    legend_colors = random.sample(LEGEND_COLOR_POOL, 4)
   504	    obstacle_colors = random.sample(legend_colors, obstacle_count)
   505	    side_color = dict(zip(sorted(present), obstacle_colors))
   506	    bg = random.choice([c for c in BG_COLOR_POOL if c not in legend_colors])
   507	
   508	    base = np.full((h, w), bg, dtype=int)
   509	    base[sr : sr + sz, sc : sc + sz] = TEAL
   510	    occupied = np.zeros((h, w), dtype=bool)
   511	    for side in present:
   512	        r0, r1, c0, c1 = _obstacle_rect(side, thickness[side], spans[side], h, w)
   513	        region = occupied[r0 : r1 + 1, c0 : c1 + 1]
   514	        if region.any():
   515	            return None
   516	        if not (r1 < sr - 1 or r0 > sr + sz or c1 < sc - 1 or c0 > sc + sz):
   517	            return None
   518	        occupied[r0 : r1 + 1, c0 : c1 + 1] = True
   519	        base[r0 : r1 + 1, c0 : c1 + 1] = side_color[side]
   520	

diff --git a/ceshi/code/e87109e9/D6/0/code.py b/ceshi/code/e87109e9/D6/0/code.py
new file mode 100644
index 0000000000000000000000000000000000000000..92bc10f7d6d631ea35451ca2b18bce74620465cd
--- /dev/null
+++ b/ceshi/code/e87109e9/D6/0/code.py
@@ -0,0 +1,579 @@
+# Variant of e87109e9
+# Dimension: D6 — 射线终止条件 (dst)
+# Change: 射线遇到障碍物时转弯继续，最终在到达网格边缘时终止... → 遇到另一条射线轨迹时终止
+
+import random
+
+import numpy as np
+
+from arc_utils import bbox_coords, components_mask
+
+# Design analysis for the D6 variant.
+# design:
+#   concretization:
+#     preserved_structure:
+#       - 输入仍由顶部 6x24 图例和下方主网格组成。
+#       - 主体仍是一个青色实心方块，外加 3-4 个贴边单色障碍矩形。
+#       - 输出仍然裁掉图例，只在主网格里画出青色射线路径。
+#     changed_mechanism:
+#       - 原题的“移动方块”每次平移 1 格，因此下一位置会和当前 footprint 重叠；
+#         所以不能把“下一块里出现任何青色”直接当作碰撞，否则射线首步就会停。
+#       - 这里把碰撞具体化为：检查“下一步新进入的前沿条带”是否已经是青色。
+#         连续直行时允许和自己当前 footprint 的重叠；只有当前沿会进入旧轨迹时才终止。
+#     small_trace:
+#       - 设 sz=2，北向射线先上行再右转，在顶边留下横向轨迹。
+#       - 之后东向射线碰到右侧障碍后向上，其前沿条带若触到北向留下的横轨，就立刻停止。
+#       - 原规则下它会继续到边界；新规则下它会被先前射线截断，差异直接体现在输出长度上。
+#   complexity_calibration:
+#     - 保留原题的 legend 编码、障碍厚度/跨度、3-4 障碍和 0-2 次转弯框架，避免把任务改成另一题。
+#     - 生成器仍先构造“原题可行”的障碍布局，再筛出确实发生 collision-stop 的样本。
+#     - 为了让顺序依赖可见，拒绝那些新旧规则输出相同、或只有边界停止而没有射线互撞的样本。
+#   implicit_assumption_review:
+#     - 原 `main()` 的 `obstacle_color_at_next()` 默认忽略 teal，因为原题允许穿过旧轨迹直到边界。
+#       变体下这不再安全，所以必须在读障碍前先检查前沿条带是否已有 teal。
+#     - 原 `paint_block()` 只把 bg 改成 teal，这一点仍成立；障碍色不能被覆盖。
+#     - 原 `for d0 in range(4)` 的顺序在边界终止版里无关紧要，变体下变成关键语义。
+#       因此 solver 明确保留固定顺序 N,E,S,W，generator 也按同顺序做 oracle。
+#     - 原题把“越界”当唯一自然终点；变体后越界仍是物理终点，但样本构造应尽量让终止更早地由轨迹碰撞触发。
+#   placement_legality:
+#     - 障碍仍只放在四边，互不重叠，也不与中心青色方块接触。
+#     - 生成器保留原来的跨度 required/excluded 约束，保证转向后的通道和障碍对齐可解。
+#     - 另外过滤掉“撞到起始方块才停”的布局；保留的样本里碰撞都来自已画出的射线轨迹。
+#   observability:
+#     - 颜色本身不参与排序或时序；顺序只由固定发射方向 N,E,S,W 决定，能从多组样例归纳。
+#     - 生成器要求至少两次 `other` 碰撞，且新旧规则输出要有明显像素差异，确保 D6 变化肉眼可见。
+#   visual_cleanliness:
+#     - 碰撞检测只看前沿条带，避免把正常滑动时的重叠误判成碰撞。
+#     - 仍要求每个障碍颜色在新规则下都至少被实际命中一次，避免出现“纯装饰障碍”导致画面杂乱。
+#   color_inference:
+#     - 颜色规则未变：颜色只编码左/右转。变体不引入新的颜色映射，避免额外不可见自由度。
+#   solver_generator_contract:
+#     - solver 假设图例背景色 5 只出现在顶部连续 band，generator 按原题保证。
+#     - solver 假设每次命中障碍的 footprint 里至多出现一种非 bg/teal 障碍色，generator 继续保证。
+#     - solver 现在还假设“真正有效的碰撞都发生在前沿条带上”；generator 用 rejection 维持该性质。
+
+_DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+_N, _E, _S, _W = range(4)
+
+# Color palettes
+LEGEND_COLOR_POOL = [1, 2, 3, 4, 6]
+BG_COLOR_POOL = [1, 2, 3, 4, 6, 7, 9]
+LEGEND_BG = 5
+TEAL = 8
+
+# Canvas dimensions
+GRID_H_RANGE = (19, 24)
+GRID_W = 24
+LEGEND_H = 6
+LEGEND_CELL_STARTS = [1, 7, 13, 19]
+
+# Teal square
+TEAL_SZ2_PROB = 0.75
+SQUARE_EDGE_GAP = 5
+
+# Obstacles
+OBS_COUNT_4_PROB = 0.65
+OBS_THICKNESS_RANGE = (2, 4)
+OBS_SINGLE_MARGIN = 6
+OBS_BOTH_GAP = 2
+
+# Span selection
+SPAN_MIN_MULT = 3
+SPAN_MAX_MULT = 14
+SPAN_COMPACT_PROB = 0.4
+
+# Variant filtering
+MIN_OTHER_COLLISIONS = 2
+MIN_TOTAL_COLLISIONS = 2
+MIN_DIFF_CELLS = 6
+MAX_RETRIES = 1200
+
+
+def _parse_legend(grid: np.ndarray, legend_h: int) -> dict[int, str]:
+    """
+    Legend is a top region with a background color (typically 5) and 4 vertical bars.
+    Each bar's horizontal position inside its cell encodes turn direction:
+      - bar on left  -> 'L' (turn counterclockwise)
+      - bar on right -> 'R' (turn clockwise)
+    """
+    legend = grid[:legend_h, :]
+    assert legend.size, "legend must be non-empty"
+    vals, cnts = np.unique(legend, return_counts=True)
+    bg = int(vals[cnts.argmax()])
+
+    sep_cols = [c for c in range(legend.shape[1]) if np.all(legend[:, c] == bg)]
+    assert len(sep_cols) >= 2, "legend separator columns must exist"
+
+    turn: dict[int, str] = {}
+    for a, b in zip(sep_cols, sep_cols[1:], strict=False):
+        if b - a <= 2:
+            continue
+        interior = legend[1 : legend_h - 1, a + 1 : b]
+        colors = set(map(int, np.unique(interior)))
+        colors.discard(bg)
+        colors.discard(0)
+        assert len(colors) == 1, "each legend cell must encode exactly one color"
+        col = int(next(iter(colors)))
+        xs = np.where(interior == col)[1]
+        x = int(xs[0])
+        turn[col] = "L" if x <= (interior.shape[1] - 1) // 2 else "R"
+    assert len(turn) == 4, "legend must encode four turn colors"
+    return turn
+
+
+def _find_teal_square(g: np.ndarray, teal: int = TEAL) -> tuple[int, int, int]:
+    """Return (r0,c0,size) for a solid square teal component."""
+    candidates: list[tuple[int, int, int]] = []
+    for cells in components_mask(g == teal, connectivity=4):
+        r0, c0, r1, c1 = bbox_coords(cells)
+        hh = r1 - r0 + 1
+        ww = c1 - c0 + 1
+        if hh != ww:
+            continue
+        size = hh
+        if int(np.sum(g[r0 : r1 + 1, c0 : c1 + 1] == teal)) != size * size:
+            continue
+        candidates.append((int(r0), int(c0), int(size)))
+    assert len(candidates) == 1, "main grid must contain exactly one solid teal square"
+    return candidates[0]
+
+
+def _rot(d: int, turn: str) -> int:
+    return (d - 1) % 4 if turn == "L" else (d + 1) % 4
+
+
+def _leading_strip(arr: np.ndarray, r: int, c: int, sz: int, d: int) -> np.ndarray:
+    """View of the newly entered 1-cell-thick strip when the sz×sz block moves one step."""
+    if d == _N:
+        return arr[r : r + 1, c : c + sz]
+    if d == _E:
+        return arr[r : r + sz, c + sz - 1 : c + sz]
+    if d == _S:
+        return arr[r + sz - 1 : r + sz, c : c + sz]
+    return arr[r : r + sz, c : c + 1]
+
+
+def _simulate_paths(
+    base: np.ndarray,
+    turns: dict[int, str],
+    bg: int,
+    *,
+    stop_on_collision: bool,
+) -> tuple[np.ndarray, list[list[tuple[int, int, int, int]]], list[str]]:
+    """
+    Simulate 4 beams from the teal square.
+
+    `stop_on_collision=False` matches the original edge-stop task.
+    `stop_on_collision=True` implements the D6 variant: the beam halts when the
+    next step's front strip would enter already-teal cells.
+    """
+    teal_locs = np.argwhere(base == TEAL)
+    assert teal_locs.size
+    sr, sc = teal_locs.min(axis=0)
+    r1, c1 = teal_locs.max(axis=0)
+    sz = int(r1 - sr + 1)
+    assert sz == int(c1 - sc + 1)
+
+    out = base.copy()
+    owner = np.full(out.shape, -2, dtype=int)
+    owner[out == TEAL] = -1  # starting square
+    H, W = out.shape
+    hits: list[list[tuple[int, int, int, int]]] = []
+    terminations: list[str] = []
+
+    def in_bounds(r: int, c: int) -> bool:
+        return 0 <= r and 0 <= c and r + sz - 1 < H and c + sz - 1 < W
+
+    def paint(r: int, c: int, beam_idx: int) -> None:
+        blk = out[r : r + sz, c : c + sz]
+        bg_mask = blk == bg
+        blk[bg_mask] = TEAL
+        owner_blk = owner[r : r + sz, c : c + sz]
+        owner_blk[bg_mask] = beam_idx
+
+    def obstacle_at(r: int, c: int) -> int | None:
+        colors = set(map(int, np.unique(out[r : r + sz, c : c + sz])))
+        colors.discard(bg)
+        colors.discard(TEAL)
+        if not colors:
+            return None
+        assert len(colors) == 1, "beam footprint must not hit mixed obstacle colors"
+        return int(next(iter(colors)))
+
+    for beam_idx, d0 in enumerate(range(4)):
+        r, c, d = int(sr), int(sc), d0
+        beam_hits: list[tuple[int, int, int, int]] = []
+        seen: set[tuple[int, int, int]] = set()
+        term = "edge"
+        while True:
+            state = (r, c, d)
+            assert state not in seen, "beam path must not cycle"
+            seen.add(state)
+
+            dr, dc = _DIRS[d]
+            nr, nc = r + dr, c + dc
+            if not in_bounds(nr, nc):
+                term = "edge"
+                break
+
+            if stop_on_collision:
+                front = _leading_strip(out, nr, nc, sz, d)
+                if np.any(front == TEAL):
+                    front_owner = _leading_strip(owner, nr, nc, sz, d)
+                    owners = set(map(int, front_owner[front == TEAL].tolist()))
+                    if any(o >= 0 and o != beam_idx for o in owners):
+                        term = "other"
+                    elif beam_idx in owners:
+                        term = "self"
+                    else:
+                        term = "source"
+                    break
+
+            obs = obstacle_at(nr, nc)
+            if obs is None:
+                r, c = nr, nc
+                paint(r, c, beam_idx)
+                continue
+
+            assert obs in turns, "obstacle color must be encoded by legend"
+            beam_hits.append((d, obs, nr, nc))
+            d = _rot(d, turns[obs])
+            assert len(beam_hits) <= 2
+
+        hits.append(beam_hits)
+        terminations.append(term)
+
+    return out, hits, terminations
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Emit four teal beams from a square, turning at colored obstacles per a legend.
+
+    Input structure:
+    - The top band is a grey legend whose 4 cells each contain one colored vertical bar.
+    - The bar color names an obstacle color below, and its left/right placement encodes the turn direction.
+    - The main area contains one solid teal square plus several solid obstacle rectangles on the borders.
+
+    Rule:
+    - Remove the legend band in the output.
+    - Launch one sz-wide beam from the teal square in each cardinal direction, in fixed order N, E, S, W.
+    - A beam paints teal only onto background cells; when its next footprint meets an obstacle color, it rotates per the legend and continues.
+    - A beam stops as soon as the next step's newly entered front strip would land on teal that was already painted by an earlier step or earlier beam.
+
+    Key insight: The legend still tells you how obstacle colors cause left/right turns, but now beam order matters because existing teal trail acts like a barrier.
+    """
+    g = np.asarray(grid, dtype=int)
+
+    legend_bg = LEGEND_BG
+    rows_with_legend = np.where(np.any(g == legend_bg, axis=1))[0]
+    assert rows_with_legend.size, "legend rows must be present"
+    legend_h = int(rows_with_legend.max() + 1)
+    assert np.array_equal(rows_with_legend, np.arange(legend_h)), "legend color must be confined to the top band"
+
+    legend_turn = _parse_legend(g, legend_h)
+
+    base = g[legend_h:, :].copy()
+    assert base.size, "main grid must remain after legend crop"
+
+    vals, cnts = np.unique(base, return_counts=True)
+    bg = int(vals[cnts.argmax()])
+    _ = _find_teal_square(base, teal=TEAL)
+    out, _, _ = _simulate_paths(base, legend_turn, bg, stop_on_collision=True)
+    return out
+
+
+def _choose_span(
+    axis_len: int,
+    required: list[tuple[int, int]],
+    excluded: list[tuple[int, int]],
+    min_len: int,
+    max_len: int,
+) -> tuple[int, int] | None:
+    """Pick a (start, end) span covering all required intervals, avoiding all excluded intervals."""
+    req0 = min(a for a, _ in required)
+    req1 = max(b for _, b in required)
+    lo = max(min_len, req1 - req0 + 1)
+    hi = min(max_len, axis_len)
+    choices: list[tuple[int, int, int]] = []
+    for length in range(lo, hi + 1):
+        start0 = max(0, req1 - length + 1)
+        start1 = min(req0, axis_len - length)
+        for start in range(start0, start1 + 1):
+            end = start + length - 1
+            if all(end < a or start > b for a, b in excluded):
+                choices.append((length, start, end))
+    if not choices:
+        return None
+
+    lengths = sorted({length for length, _, _ in choices})
+    if random.random() < SPAN_COMPACT_PROB:
+        cutoff = lengths[min(len(lengths) - 1, max(0, len(lengths) // 2))]
+        pool = [(start, end) for length, start, end in choices if length <= cutoff]
+    else:
+        pool = [(start, end) for _, start, end in choices]
+    return random.choice(pool)
+
+
+def _rand_thickness(lo: int, hi: int) -> int | None:
+    return random.randint(lo, hi) if hi >= lo else None
+
+
+def _thickness_pair(
+    axis: int, sz: int, a_present: bool, b_present: bool
+) -> tuple[int | None, int | None] | None:
+    """Compute obstacle thicknesses for the two ends of an axis (N/S or W/E)."""
+    lo, hi_cap = OBS_THICKNESS_RANGE
+    if a_present and b_present:
+        room = axis - sz - OBS_BOTH_GAP
+        if room < 2 * lo:
+            return None
+        a = random.randint(lo, min(hi_cap, room - lo))
+        b = _rand_thickness(lo, min(hi_cap, room - a))
+        return (a, b) if b is not None else None
+    if a_present:
+        t = _rand_thickness(lo, min(hi_cap, axis - sz - OBS_SINGLE_MARGIN))
+        return (t, None) if t is not None else None
+    if b_present:
+        t = _rand_thickness(lo, min(hi_cap, axis - sz - OBS_SINGLE_MARGIN))
+        return (None, t) if t is not None else None
+    return None, None
+
+
+def _obstacle_rect(
+    side: int, thickness: int, span: tuple[int, int], h: int, w: int
+) -> tuple[int, int, int, int]:
+    """Return (r0, r1, c0, c1) for an edge-touching obstacle rectangle."""
+    s0, s1 = span
+    if side == _N:
+        return 0, thickness - 1, s0, s1
+    if side == _S:
+        return h - thickness, h - 1, s0, s1
+    if side == _W:
+        return s0, s1, 0, thickness - 1
+    return s0, s1, w - thickness, w - 1
+
+
+def _select_chains(
+    present: set[int], second_hits: int
+) -> dict[int, int] | None:
+    """Pick non-overlapping (source -> adjacent target) pairs for multi-bounce beams."""
+    candidates = [
+        (side, nxt)
+        for side in present
+        for nxt in ((side - 1) % 4, (side + 1) % 4)
+        if nxt in present
+    ]
+    random.shuffle(candidates)
+    selected: list[tuple[int, int]] = []
+    used: set[int] = set()
+    for side, nxt in candidates:
+        if len(selected) == second_hits:
+            break
+        if side in used or nxt in used:
+            continue
+        selected.append((side, nxt))
+        used.update((side, nxt))
+    return dict(selected) if len(selected) == second_hits else None
+
+
+def _assign_turns(
+    present: set[int], chains: dict[int, int]
+) -> dict[int, str]:
+    """Assign L/R turn direction for each obstacle side."""
+    side_turn: dict[int, str] = {}
+    for side in present:
+        if side in chains:
+            nxt = chains[side]
+            side_turn[side] = "L" if nxt == (side - 1) % 4 else "R"
+        else:
+            outward = [t for t in ("L", "R") if _rot(side, t) not in present]
+            side_turn[side] = random.choice(outward if outward else ["L", "R"])
+    return side_turn
+
+
+def _compute_span_constraints(
+    present: set[int],
+    side_turn: dict[int, str],
+    chains: dict[int, int],
+    sr: int,
+    sc: int,
+    sz: int,
+    lane: dict[int, int],
+) -> tuple[dict[int, list[tuple[int, int]]], dict[int, list[tuple[int, int]]]]:
+    """Build required/excluded intervals for each obstacle's span selection."""
+    required: dict[int, list[tuple[int, int]]] = {s: [] for s in present}
+    excluded: dict[int, list[tuple[int, int]]] = {s: [] for s in present}
+
+    for side in present:
+        base_coord = sc if side in (_N, _S) else sr
+        required[side].append((base_coord, base_coord + sz - 1))
+
+    def lane_interval(s: int) -> tuple[int, int]:
+        return lane[s], lane[s] + sz - 1
+
+    for side in present:
+        nxt = _rot(side, side_turn[side])
+        if nxt not in present:
+            continue
+        if chains.get(side) == nxt:
+            required[nxt].append(lane_interval(side))
+            after = _rot(nxt, side_turn[nxt])
+            if after in present:
+                excluded[after].append(lane_interval(nxt))
+        else:
+            excluded[nxt].append(lane_interval(side))
+
+    return required, excluded
+
+
+def _make_legend(legend_colors: list[int], turns: dict[int, str]) -> np.ndarray:
+    """Build the 6x24 legend band from 4 colors and their turn assignments."""
+    legend = np.full((LEGEND_H, GRID_W), LEGEND_BG, dtype=int)
+    for start, color in zip(LEGEND_CELL_STARTS, legend_colors):
+        legend[1:5, start : start + 4] = 0
+        bar_col = start if turns[color] == "L" else start + 3
+        legend[1:5, bar_col] = color
+    return legend
+
+
+def _gen_attempt() -> np.ndarray | None:
+    h, w = random.randint(*GRID_H_RANGE), GRID_W
+    sz = 2 if random.random() < TEAL_SZ2_PROB else 3
+    obstacle_count = 4 if random.random() < OBS_COUNT_4_PROB else 3
+    present = set(random.sample([_N, _E, _S, _W], obstacle_count))
+    target_hits = random.choice([4, 5])
+    second_hits = target_hits - obstacle_count
+    if second_hits < 0 or second_hits > 2:
+        return None
+
+    ns = _thickness_pair(h, sz, _N in present, _S in present)
+    ew = _thickness_pair(w, sz, _W in present, _E in present)
+    if ns is None or ew is None:
+        return None
+    thickness = {s: t for s, t in zip((_N, _S, _W, _E), (*ns, *ew)) if t is not None}
+
+    min_r, max_r = SQUARE_EDGE_GAP, h - sz - SQUARE_EDGE_GAP
+    min_c, max_c = SQUARE_EDGE_GAP, w - sz - SQUARE_EDGE_GAP
+    if _N in present:
+        min_r = max(min_r, thickness[_N] + 1)
+    if _S in present:
+        max_r = min(max_r, h - thickness[_S] - sz - 1)
+    if _W in present:
+        min_c = max(min_c, thickness[_W] + 1)
+    if _E in present:
+        max_c = min(max_c, w - thickness[_E] - sz - 1)
+    if min_r > max_r or min_c > max_c:
+        return None
+    sr, sc = random.randint(min_r, max_r), random.randint(min_c, max_c)
+
+    lane: dict[int, int] = {}
+    if _N in present:
+        lane[_N] = thickness[_N] + 1
+    if _S in present:
+        lane[_S] = h - thickness[_S] - sz
+    if _W in present:
+        lane[_W] = thickness[_W] + 1
+    if _E in present:
+        lane[_E] = w - thickness[_E] - sz
+
+    chains = _select_chains(present, second_hits)
+    if chains is None:
+        return None
+
+    side_turn = _assign_turns(present, chains)
+    required, excluded = _compute_span_constraints(
+        present, side_turn, chains, sr, sc, sz, lane
+    )
+
+    spans: dict[int, tuple[int, int]] = {}
+    for side in present:
+        axis_len = w if side in (_N, _S) else h
+        span = _choose_span(
+            axis_len,
+            required[side],
+            excluded[side],
+            SPAN_MIN_MULT * sz,
+            min(SPAN_MAX_MULT * sz, axis_len),
+        )
+        if span is None:
+            return None
+        spans[side] = span
+
+    legend_colors = random.sample(LEGEND_COLOR_POOL, 4)
+    obstacle_colors = random.sample(legend_colors, obstacle_count)
+    side_color = dict(zip(sorted(present), obstacle_colors))
+    bg = random.choice([c for c in BG_COLOR_POOL if c not in legend_colors])
+
+    base = np.full((h, w), bg, dtype=int)
+    base[sr : sr + sz, sc : sc + sz] = TEAL
+    occupied = np.zeros((h, w), dtype=bool)
+    for side in present:
+        r0, r1, c0, c1 = _obstacle_rect(side, thickness[side], spans[side], h, w)
+        region = occupied[r0 : r1 + 1, c0 : c1 + 1]
+        if region.any():
+            return None
+        if not (r1 < sr - 1 or r0 > sr + sz or c1 < sc - 1 or c0 > sc + sz):
+            return None
+        occupied[r0 : r1 + 1, c0 : c1 + 1] = True
+        base[r0 : r1 + 1, c0 : c1 + 1] = side_color[side]
+
+    vals, counts = np.unique(base, return_counts=True)
+    if int(vals[counts.argmax()]) != bg:
+        return None
+
+    turns = {side_color[s]: side_turn[s] for s in present}
+    for color in legend_colors:
+        turns.setdefault(color, random.choice(["L", "R"]))
+
+    try:
+        original_expected, original_hits, _ = _simulate_paths(
+            base, turns, bg, stop_on_collision=False
+        )
+        expected, hits, terms = _simulate_paths(
+            base, turns, bg, stop_on_collision=True
+        )
+    except AssertionError:
+        return None
+
+    original_hit_counts = [len(beam) for beam in original_hits]
+    if sum(original_hit_counts) != target_hits or any(c > 2 for c in original_hit_counts):
+        return None
+
+    hit_colors = {color for beam in hits for _, color, _, _ in beam}
+    if set(side_color.values()) - hit_colors:
+        return None
+
+    if any(term == "source" for term in terms):
+        return None
+
+    total_collisions = sum(term in {"self", "other"} for term in terms)
+    other_collisions = sum(term == "other" for term in terms)
+    diff_cells = int(np.count_nonzero(expected != original_expected))
+    if total_collisions < MIN_TOTAL_COLLISIONS:
+        return None
+    if other_collisions < MIN_OTHER_COLLISIONS:
+        return None
+    if diff_cells < max(MIN_DIFF_CELLS, 2 * sz):
+        return None
+
+    if sum(len(beam) for beam in hits) < obstacle_count:
+        return None
+
+    legend = _make_legend(legend_colors, turns)
+    inp = np.vstack([legend, base])
+    try:
+        actual = main(inp)
+    except AssertionError:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
