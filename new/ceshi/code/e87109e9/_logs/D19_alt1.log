+# Variant of e87109e9
+# Dimension: D19 — 转弯后射线方向的确定 (path)
+# Change: 转弯严格为90度——遇到障碍物后射线方向精确转动90度（顺时针或逆时针）... → 转弯角度由碰撞位置决定
+
+import random
+import sys
+
+import numpy as np
+
+if "/home/lixinyu/snap/new/solvers" not in sys.path:
+    sys.path.append("/home/lixinyu/snap/new/solvers")
+
+from arc_utils import bbox_coords, components_mask
+
+
+# ---------------------------------------------------------------------------
+# Design analysis for the D19 variant
+#
+# variant_spec:
+#   core_change:
+#     old: every collision uses the legend to rotate exactly 90 degrees
+#     new: collision height adds a second decision
+#       upper-half hit -> rotate 90 degrees using the legend
+#       lower-half hit -> reverse 180 degrees, ignoring left/right for that step
+#   concretization:
+#     grid_objects:
+#       legend: unchanged 6x24 band with 4 colored bars
+#       source: one solid teal square of size 2 or 3
+#       obstacles: solid rectangles on the left, right, and bottom edges
+#     visible_effect:
+#       the same obstacle can react differently when hit at two vertical levels
+#       in generated samples, one vertical obstacle is hit once near its upper half
+#       and once near its lower half, so the output visibly differs
+#   behavior_trace:
+#     example:
+#       before:
+#         east beam hits right obstacle -> always turns left/right by legend
+#       after:
+#         east beam hits the lower half of the right obstacle -> reverses and travels back
+#         south beam later hits the other vertical obstacle in its upper half -> that hit still uses the legend
+#       difference:
+#         the legend is no longer sufficient by itself; the row of the contact matters
+#   complexity_calibration:
+#     why_not_simpler:
+#       if only top/bottom obstacles were used, humans could misread the rule as
+#       "top means reverse, bottom means turn". The generator therefore uses both
+#       left and right vertical obstacles and forces one of them to be hit in both halves.
+#     controlled_freedom:
+#       only two turn angles exist (90 / 180), and the legend still has the same
+#       left/right meaning for the 90-degree branch.
+#   implicit_assumption_review:
+#     old_main_dependencies:
+#       obstacle collision logic assumed "color -> unique 90-degree action"
+#       this is no longer valid, so the solver now also needs each obstacle bbox
+#       to classify the hit row against the obstacle's vertical midpoint.
+#     safe_updates:
+#       obstacle detection now reads from the uncropped base grid instead of the
+#       painted output, so previously painted teal trails do not corrupt collision tests.
+#   placement_legality:
+#     guarantees:
+#       left/right obstacles stop above the bottom obstacle, so rectangles never overlap
+#       the source square keeps a gap from every obstacle and from the grid border
+#       the "upper-hit" vertical obstacle covers both the source lane and the low lane
+#       above the bottom obstacle, enabling two different hit classifications on one shape
+#   observability:
+#     human_signal:
+#       across samples, either the left or the right obstacle plays the dual-role,
+#       so the rule is readable from geometry rather than from color ids.
+#   visual_cleanliness:
+#     layout:
+#       only three obstacles are used, paths are long and axis-aligned, and there is
+#       no corner overlap between rectangles.
+#   color_inference:
+#     unchanged:
+#       colors still only encode clockwise/counterclockwise for the 90-degree case;
+#       no hidden ordering by numeric color id is introduced.
+#   post_edit_assumptions:
+#     solver_requires:
+#       each obstacle color in the main grid is one solid rectangle
+#       vertical hit classification uses the overlap row center against obstacle bbox center
+#     generator_enforces:
+#       exactly three obstacle rectangles are created
+#       every used color appears in the legend
+#       one beam performs a lower-half 180 then reaches an upper-half 90 on the opposite side
+#       one vertical obstacle is hit once as upper-half and once as lower-half
+# ---------------------------------------------------------------------------
+
+_DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+_N, _E, _S, _W = range(4)
+
+
+def _parse_legend(grid: np.ndarray, legend_h: int) -> dict[int, str]:
+    """Decode left/right bar placement inside the legend cells."""
+    legend = grid[:legend_h, :]
+    assert legend.size, "legend must be non-empty"
+    vals, cnts = np.unique(legend, return_counts=True)
+    bg = int(vals[cnts.argmax()])
+
+    sep_cols = [c for c in range(legend.shape[1]) if np.all(legend[:, c] == bg)]
+    assert len(sep_cols) >= 2, "legend separator columns must exist"
+
+    turn: dict[int, str] = {}
+    for a, b in zip(sep_cols, sep_cols[1:], strict=False):
+        if b - a <= 2:
+            continue
+        interior = legend[1 : legend_h - 1, a + 1 : b]
+        colors = set(map(int, np.unique(interior)))
+        colors.discard(bg)
+        colors.discard(0)
+        assert len(colors) == 1, "each legend cell must encode exactly one color"
+        color = int(next(iter(colors)))
+        xs = np.where(interior == color)[1]
+        turn[color] = "L" if int(xs[0]) <= (interior.shape[1] - 1) // 2 else "R"
+    assert len(turn) == 4, "legend must encode four turn colors"
+    return turn
+
+
+def _find_teal_square(g: np.ndarray, teal: int = 8) -> tuple[int, int, int]:
+    """Return (r0, c0, size) for the unique solid teal square."""
+    candidates: list[tuple[int, int, int]] = []
+    for cells in components_mask(g == teal, connectivity=4):
+        r0, c0, r1, c1 = bbox_coords(cells)
+        hh = r1 - r0 + 1
+        ww = c1 - c0 + 1
+        if hh != ww:
+            continue
+        if int(np.sum(g[r0 : r1 + 1, c0 : c1 + 1] == teal)) != hh * ww:
+            continue
+        candidates.append((int(r0), int(c0), int(hh)))
+    assert len(candidates) == 1, "main grid must contain exactly one solid teal square"
+    return candidates[0]
+
+
+def _collect_obstacle_boxes(base: np.ndarray, bg: int, teal: int) -> dict[int, tuple[int, int, int, int]]:
+    """Map each obstacle color to its rectangular bbox."""
+    boxes: dict[int, tuple[int, int, int, int]] = {}
+    for color in map(int, np.unique(base)):
+        if color in (bg, teal):
+            continue
+        coords = np.argwhere(base == color)
+        assert coords.size, "obstacle color must appear"
+        r0, c0, r1, c1 = bbox_coords(coords)
+        area = (r1 - r0 + 1) * (c1 - c0 + 1)
+        assert int(np.sum(base[r0 : r1 + 1, c0 : c1 + 1] == color)) == area
+        boxes[color] = (int(r0), int(c0), int(r1), int(c1))
+    return boxes
+
+
+def _rot_ccw(d: int) -> int:
+    return (d - 1) % 4
+
+
+def _rot_cw(d: int) -> int:
+    return (d + 1) % 4
+
+
+def _rot(d: int, turn: str) -> int:
+    return _rot_ccw(d) if turn == "L" else _rot_cw(d)
+
+
+def _reverse(d: int) -> int:
+    return (d + 2) % 4
+
+
+def _hit_mode(box: tuple[int, int, int, int], nr: int, sz: int) -> str:
+    """
+    Classify the collision as upper/lower using the overlap row center.
+
+    The obstacle's vertical midpoint is compared to the center row of the
+    overlapping slice between the next beam footprint and the obstacle bbox.
+    """
+    r0, _c0, r1, _c1 = box
+    ov0 = max(nr, r0)
+    ov1 = min(nr + sz - 1, r1)
+    assert ov0 <= ov1, "collision footprint must overlap the obstacle vertically"
+    return "upper" if ov0 + ov1 < r0 + r1 else "lower"
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Launch four teal beams from the source square, with collisions decided by both legend and hit height.
+
+    Input structure:
+    - A top legend band encodes four obstacle colors; the colored bar in each cell sits on the left or right.
+    - Below the legend is the main board with one teal square, a uniform background, and solid colored obstacle rectangles.
+
+    Rule:
+    - Remove the legend band from the output.
+    - Emit one sz-by-sz teal beam in each cardinal direction, painting only background cells.
+    - When a beam would enter an obstacle, first inspect where it hits that obstacle vertically:
+      upper half -> turn 90 degrees according to the legend for that color;
+      lower half -> reverse 180 degrees and continue back along the path.
+    - Beams stop when the next sz-by-sz step would leave the main board.
+
+    Key insight:
+    - The legend still tells you the left-vs-right choice for 90-degree turns, but it no longer fully determines the motion.
+    - You must also locate the collision point within the obstacle's upper or lower half.
+    """
+    g = np.asarray(grid, dtype=int)
+
+    legend_bg = 5
+    rows_with_legend = np.where(np.any(g == legend_bg, axis=1))[0]
+    assert rows_with_legend.size, "legend rows must be present"
+    legend_h = int(rows_with_legend.max() + 1)
+    assert np.array_equal(rows_with_legend, np.arange(legend_h)), "legend color must be confined to the top band"
+
+    legend_turn = _parse_legend(g, legend_h)
+
+    base = g[legend_h:, :].copy()
+    assert base.size, "main grid must remain after legend crop"
+
+    vals, cnts = np.unique(base, return_counts=True)
+    bg = int(vals[cnts.argmax()])
+    teal = 8
+    sr, sc, sz = _find_teal_square(base, teal=teal)
+    boxes = _collect_obstacle_boxes(base, bg, teal)
+
+    out = base.copy()
+
+    def in_bounds(r: int, c: int) -> bool:
+        return 0 <= r and 0 <= c and r + sz - 1 < out.shape[0] and c + sz - 1 < out.shape[1]
+
+    def paint_block(r: int, c: int) -> None:
+        blk = out[r : r + sz, c : c + sz]
+        blk[blk == bg] = teal
+        out[r : r + sz, c : c + sz] = blk
+
+    def obstacle_color_at_next(nr: int, nc: int) -> int | None:
+        blk = base[nr : nr + sz, nc : nc + sz]
+        cols = set(map(int, np.unique(blk)))
+        cols.discard(bg)
+        cols.discard(teal)
+        if not cols:
+            return None
+        assert len(cols) == 1, "beam footprint must not hit mixed obstacle colors"
+        return int(next(iter(cols)))
+
+    for d0 in range(4):
+        r, c, d = sr, sc, d0
+        seen: set[tuple[int, int, int]] = set()
+        while True:
+            state = (r, c, d)
+            assert state not in seen, "beam path must not cycle"
+            seen.add(state)
+
+            dr, dc = _DIRS[d]
+            nr, nc = r + dr, c + dc
+            if not in_bounds(nr, nc):
+                break
+
+            oc = obstacle_color_at_next(nr, nc)
+            if oc is None:
+                r, c = nr, nc
+                paint_block(r, c)
+                continue
+
+            assert oc in legend_turn, "obstacle color must be encoded by legend"
+            if _hit_mode(boxes[oc], nr, sz) == "upper":
+                d = _rot(d, legend_turn[oc])
+            else:
+                d = _reverse(d)
+
+    return out
+
+
+# --------------- generator ---------------
+
+LEGEND_COLOR_POOL = [1, 2, 3, 4, 6]
+BG_COLOR_POOL = [1, 2, 3, 4, 6, 7, 9]
+LEGEND_BG = 5
+TEAL = 8
+
+GRID_H_RANGE = (19, 24)
+GRID_W = 24
+LEGEND_H = 6
+LEGEND_CELL_STARTS = [1, 7, 13, 19]
+
+TEAL_SZ2_PROB = 0.75
+SQUARE_EDGE_GAP = 5
+
+OBS_THICKNESS_RANGE = (2, 4)
+SPAN_MIN_MULT = 3
+SPAN_MAX_MULT = 14
+SPAN_COMPACT_PROB = 0.4
+
+MAX_RETRIES = 400
+
+
+def _interval_disjoint(a: tuple[int, int], b: tuple[int, int]) -> bool:
+    return a[1] < b[0] or b[1] < a[0]
+
+
+def _choose_span(
+    axis_len: int,
+    required: list[tuple[int, int]],
+    excluded: list[tuple[int, int]],
+    min_len: int,
+    max_len: int,
+) -> tuple[int, int] | None:
+    """Pick an axis-aligned span covering required intervals and missing excluded ones."""
+    req0 = min(a for a, _ in required)
+    req1 = max(b for _, b in required)
+    lo = max(min_len, req1 - req0 + 1)
+    hi = min(max_len, axis_len)
+    choices: list[tuple[int, int, int]] = []
+    for length in range(lo, hi + 1):
+        start0 = max(0, req1 - length + 1)
+        start1 = min(req0, axis_len - length)
+        for start in range(start0, start1 + 1):
+            end = start + length - 1
+            if all(_interval_disjoint((start, end), exc) for exc in excluded):
+                choices.append((length, start, end))
+    if not choices:
+        return None
+
+    lengths = sorted({length for length, _a, _b in choices})
+    if random.random() < SPAN_COMPACT_PROB:
+        cutoff = lengths[min(len(lengths) - 1, max(0, len(lengths) // 2))]
+        pool = [(start, end) for length, start, end in choices if length <= cutoff]
+    else:
+        pool = [(start, end) for _length, start, end in choices]
+    return random.choice(pool)
+
+
+def _choose_vertical_span(
+    axis_len: int,
+    required: list[tuple[int, int]],
+    excluded: list[tuple[int, int]],
+    hit_rules: list[tuple[tuple[int, int], str]],
+    min_len: int,
+    max_len: int,
+    stop_before: int,
+) -> tuple[int, int] | None:
+    """
+    Search for a vertical obstacle span satisfying cover/exclude and upper/lower hit rules.
+
+    stop_before is the first forbidden row, used to keep vertical obstacles above the south bar.
+    """
+    req0 = min(a for a, _ in required)
+    req1 = max(b for _, b in required)
+    lo = max(min_len, req1 - req0 + 1)
+    hi = min(max_len, stop_before)
+    choices: list[tuple[int, int, int]] = []
+    for length in range(lo, hi + 1):
+        start0 = max(0, req1 - length + 1)
+        start1 = min(req0, stop_before - length)
+        for start in range(start0, start1 + 1):
+            end = start + length - 1
+            span = (start, end)
+            if any(not _interval_disjoint(span, exc) for exc in excluded):
+                continue
+            ok = True
+            center_sum = start + end
+            for interval, kind in hit_rules:
+                a, b = interval
+                if not (start <= a and b <= end):
+                    ok = False
+                    break
+                hit_sum = a + b
+                if kind == "upper" and not (hit_sum < center_sum):
+                    ok = False
+                    break
+                if kind == "lower" and not (hit_sum >= center_sum):
+                    ok = False
+                    break
+            if ok:
+                choices.append((length, start, end))
+    if not choices:
+        return None
+
+    lengths = sorted({length for length, _a, _b in choices})
+    if random.random() < SPAN_COMPACT_PROB:
+        cutoff = lengths[min(len(lengths) - 1, max(0, len(lengths) // 2))]
+        pool = [(start, end) for length, start, end in choices if length <= cutoff]
+    else:
+        pool = [(start, end) for _length, start, end in choices]
+    return random.choice(pool)
+
+
+def _obstacle_rect(
+    side: int, thickness: int, span: tuple[int, int], h: int, w: int
+) -> tuple[int, int, int, int]:
+    """Return (r0, r1, c0, c1) for one edge-touching rectangle."""
+    s0, s1 = span
+    if side == _S:
+        return h - thickness, h - 1, s0, s1
+    if side == _W:
+        return s0, s1, 0, thickness - 1
+    if side == _E:
+        return s0, s1, w - thickness, w - 1
+    raise AssertionError("generator only uses south/west/east obstacles")
+
+
+def _make_legend(legend_colors: list[int], turns: dict[int, str]) -> np.ndarray:
+    """Build the unchanged 6x24 legend band."""
+    legend = np.full((LEGEND_H, GRID_W), LEGEND_BG, dtype=int)
+    for start, color in zip(LEGEND_CELL_STARTS, legend_colors):
+        legend[1:5, start : start + 4] = 0
+        bar_col = start if turns[color] == "L" else start + 3
+        legend[1:5, bar_col] = color
+    return legend
+
+
+def _simulate_paths(
+    base: np.ndarray, turns: dict[int, str], bg: int
+) -> tuple[np.ndarray, list[list[tuple[int, int, int, int, str]]]]:
+    """Oracle simulation for the variant rule."""
+    vals, counts = np.unique(base, return_counts=True)
+    assert int(vals[counts.argmax()]) == bg
+
+    sr, sc, sz = _find_teal_square(base, TEAL)
+    out = base.copy()
+    h, w = out.shape
+    boxes = _collect_obstacle_boxes(base, bg, TEAL)
+    hits: list[list[tuple[int, int, int, int, str]]] = []
+
+    def in_bounds(r: int, c: int) -> bool:
+        return 0 <= r and 0 <= c and r + sz - 1 < h and c + sz - 1 < w
+
+    def paint(r: int, c: int) -> None:
+        blk = out[r : r + sz, c : c + sz]
+        blk[blk == bg] = TEAL
+        out[r : r + sz, c : c + sz] = blk
+
+    def obstacle_at(r: int, c: int) -> int | None:
+        colors = set(map(int, np.unique(base[r : r + sz, c : c + sz])))
+        colors.discard(bg)
+        colors.discard(TEAL)
+        if not colors:
+            return None
+        assert len(colors) == 1
+        return int(next(iter(colors)))
+
+    for d0 in range(4):
+        r, c, d = sr, sc, d0
+        beam_hits: list[tuple[int, int, int, int, str]] = []
+        seen: set[tuple[int, int, int]] = set()
+        while True:
+            state = (r, c, d)
+            assert state not in seen
+            seen.add(state)
+            dr, dc = _DIRS[d]
+            nr, nc = r + dr, c + dc
+            if not in_bounds(nr, nc):
+                break
+            obs = obstacle_at(nr, nc)
+            if obs is None:
+                r, c = nr, nc
+                paint(r, c)
+                continue
+            mode = _hit_mode(boxes[obs], nr, sz)
+            beam_hits.append((d, obs, nr, nc, mode))
+            d = _rot(d, turns[obs]) if mode == "upper" else _reverse(d)
+            assert len(beam_hits) <= 3
+        hits.append(beam_hits)
+
+    return out, hits
+
+
+def _rand_thickness() -> int:
+    return random.randint(*OBS_THICKNESS_RANGE)
+
+
+def _gen_attempt() -> np.ndarray | None:
+    h, w = random.randint(*GRID_H_RANGE), GRID_W
+    sz = 2 if random.random() < TEAL_SZ2_PROB else 3
+
+    t_s = _rand_thickness()
+    t_w = _rand_thickness()
+    t_e = _rand_thickness()
+
+    min_r = SQUARE_EDGE_GAP
+    max_r = min(h - sz - SQUARE_EDGE_GAP, h - t_s - (2 * sz) - 1)
+    min_c = max(SQUARE_EDGE_GAP, t_w + 1)
+    max_c = min(w - sz - SQUARE_EDGE_GAP, w - t_e - sz - 1)
+    if min_r > max_r or min_c > max_c:
+        return None
+
+    sr = random.randint(min_r, max_r)
+    sc = random.randint(min_c, max_c)
+
+    src_rows = (sr, sr + sz - 1)
+    src_cols = (sc, sc + sz - 1)
+    south_rows = (h - t_s - sz, h - t_s - 1)
+    if src_rows[1] >= south_rows[0]:
+        return None
+
+    upper_side = random.choice([_W, _E])
+    lower_side = _E if upper_side == _W else _W
+
+    stop_before = h - t_s
+    min_len = SPAN_MIN_MULT * sz
+    max_len = min(SPAN_MAX_MULT * sz, stop_before)
+
+    upper_span = _choose_vertical_span(
+        h,
+        [src_rows, south_rows],
+        [],
+        [(src_rows, "upper"), (south_rows, "lower")],
+        min_len,
+        max_len,
+        stop_before,
+    )
+    if upper_span is None:
+        return None
+
+    lower_span = _choose_vertical_span(
+        h,
+        [src_rows],
+        [south_rows],
+        [(src_rows, "lower")],
+        min_len,
+        max_len,
+        stop_before,
+    )
+    if lower_span is None:
+        return None
+
+    south_span = _choose_span(w, [src_cols], [], min_len, min(SPAN_MAX_MULT * sz, w))
+    if south_span is None:
+        return None
+
+    legend_colors = random.sample(LEGEND_COLOR_POOL, 4)
+    side_colors = random.sample(legend_colors, 3)
+    side_color = {_S: side_colors[0], _W: side_colors[1], _E: side_colors[2]}
+    bg = random.choice([c for c in BG_COLOR_POOL if c not in legend_colors])
+
+    base = np.full((h, w), bg, dtype=int)
+    base[sr : sr + sz, sc : sc + sz] = TEAL
+
+    spans = {
+        _S: south_span,
+        _W: upper_span if upper_side == _W else lower_span,
+        _E: upper_span if upper_side == _E else lower_span,
+    }
+    thickness = {_S: t_s, _W: t_w, _E: t_e}
+
+    occupied = np.zeros((h, w), dtype=bool)
+    occupied[sr : sr + sz, sc : sc + sz] = True
+    for side in (_S, _W, _E):
+        r0, r1, c0, c1 = _obstacle_rect(side, thickness[side], spans[side], h, w)
+        region = occupied[r0 : r1 + 1, c0 : c1 + 1]
+        if region.any():
+            return None
+        occupied[r0 : r1 + 1, c0 : c1 + 1] = True
+        base[r0 : r1 + 1, c0 : c1 + 1] = side_color[side]
+
+    vals, counts = np.unique(base, return_counts=True)
+    if int(vals[counts.argmax()]) != bg:
+        return None
+
+    turns: dict[int, str] = {}
+    upper_color = side_color[upper_side]
+    lower_color = side_color[lower_side]
+    south_color = side_color[_S]
+
+    turns[upper_color] = "R" if upper_side == _W else "L"
+    turns[south_color] = "R" if upper_side == _W else "L"
+    turns[lower_color] = random.choice(["L", "R"])
+    for color in legend_colors:
+        turns.setdefault(color, random.choice(["L", "R"]))
+
+    try:
+        expected, hits = _simulate_paths(base, turns, bg)
+    except AssertionError:
+        return None
+
+    hit_counts = [len(beam) for beam in hits]
+    if hit_counts != [0, 2 if lower_side == _E else 1, 2, 1 if lower_side == _E else 2]:
+        # Direction order is N, E, S, W. This enforces the intended path template.
+        return None
+
+    per_color_modes: dict[int, list[str]] = {}
+    for beam in hits:
+        for _d, color, _nr, _nc, mode in beam:
+            per_color_modes.setdefault(color, []).append(mode)
+
+    if not {"upper", "lower"} <= {mode for beam in hits for _d, _c, _nr, _nc, mode in beam}:
+        return None
+    if sorted(per_color_modes.get(upper_color, [])) != ["lower", "upper"]:
+        return None
+    if per_color_modes.get(lower_color) != ["lower"]:
+        return None
+    if per_color_modes.get(south_color) != ["upper"]:
+        return None
+
+    legend = _make_legend(legend_colors, turns)
+    inp = np.vstack([legend, base])
+    try:
+        actual = main(inp)
+    except AssertionError:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate e87109e9 D19 input")

diff --git a/ceshi/code/e87109e9/D19/1/code.py b/ceshi/code/e87109e9/D19/1/code.py
new file mode 100644
index 0000000000000000000000000000000000000000..3239b0369c3eaf0c75a79cc56e9971d7f20f12f6
--- /dev/null
+++ b/ceshi/code/e87109e9/D19/1/code.py
@@ -0,0 +1,603 @@
+# Variant of e87109e9
+# Dimension: D19 — 转弯后射线方向的确定 (path)
+# Change: 转弯严格为90度——遇到障碍物后射线方向精确转动90度（顺时针或逆时针）... → 转弯角度由碰撞位置决定
+
+import random
+import sys
+
+import numpy as np
+
+if "/home/lixinyu/snap/new/solvers" not in sys.path:
+    sys.path.append("/home/lixinyu/snap/new/solvers")
+
+from arc_utils import bbox_coords, components_mask
+
+
+# ---------------------------------------------------------------------------
+# Design analysis for the D19 variant
+#
+# variant_spec:
+#   core_change:
+#     old: every collision uses the legend to rotate exactly 90 degrees
+#     new: collision height adds a second decision
+#       upper-half hit -> rotate 90 degrees using the legend
+#       lower-half hit -> reverse 180 degrees, ignoring left/right for that step
+#   concretization:
+#     grid_objects:
+#       legend: unchanged 6x24 band with 4 colored bars
+#       source: one solid teal square of size 2 or 3
+#       obstacles: solid rectangles on the left, right, and bottom edges
+#     visible_effect:
+#       the same obstacle can react differently when hit at two vertical levels
+#       in generated samples, one vertical obstacle is hit once near its upper half
+#       and once near its lower half, so the output visibly differs
+#   behavior_trace:
+#     example:
+#       before:
+#         east beam hits right obstacle -> always turns left/right by legend
+#       after:
+#         east beam hits the lower half of the right obstacle -> reverses and travels back
+#         south beam later hits the other vertical obstacle in its upper half -> that hit still uses the legend
+#       difference:
+#         the legend is no longer sufficient by itself; the row of the contact matters
+#   complexity_calibration:
+#     why_not_simpler:
+#       if only top/bottom obstacles were used, humans could misread the rule as
+#       "top means reverse, bottom means turn". The generator therefore uses both
+#       left and right vertical obstacles and forces one of them to be hit in both halves.
+#     controlled_freedom:
+#       only two turn angles exist (90 / 180), and the legend still has the same
+#       left/right meaning for the 90-degree branch.
+#   implicit_assumption_review:
+#     old_main_dependencies:
+#       obstacle collision logic assumed "color -> unique 90-degree action"
+#       this is no longer valid, so the solver now also needs each obstacle bbox
+#       to classify the hit row against the obstacle's vertical midpoint.
+#     safe_updates:
+#       obstacle detection now reads from the uncropped base grid instead of the
+#       painted output, so previously painted teal trails do not corrupt collision tests.
+#   placement_legality:
+#     guarantees:
+#       left/right obstacles stop above the bottom obstacle, so rectangles never overlap
+#       the source square keeps a gap from every obstacle and from the grid border
+#       the "upper-hit" vertical obstacle covers both the source lane and the low lane
+#       above the bottom obstacle, enabling two different hit classifications on one shape
+#   observability:
+#     human_signal:
+#       across samples, either the left or the right obstacle plays the dual-role,
+#       so the rule is readable from geometry rather than from color ids.
+#   visual_cleanliness:
+#     layout:
+#       only three obstacles are used, paths are long and axis-aligned, and there is
+#       no corner overlap between rectangles.
+#   color_inference:
+#     unchanged:
+#       colors still only encode clockwise/counterclockwise for the 90-degree case;
+#       no hidden ordering by numeric color id is introduced.
+#   post_edit_assumptions:
+#     solver_requires:
+#       each obstacle color in the main grid is one solid rectangle
+#       vertical hit classification uses the overlap row center against obstacle bbox center
+#     generator_enforces:
+#       exactly three obstacle rectangles are created
+#       every used color appears in the legend
+#       one beam performs a lower-half 180 then reaches an upper-half 90 on the opposite side
+#       one vertical obstacle is hit once as upper-half and once as lower-half
+# ---------------------------------------------------------------------------
+
+_DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+_N, _E, _S, _W = range(4)
+
+
+def _parse_legend(grid: np.ndarray, legend_h: int) -> dict[int, str]:
+    """Decode left/right bar placement inside the legend cells."""
+    legend = grid[:legend_h, :]
+    assert legend.size, "legend must be non-empty"
+    vals, cnts = np.unique(legend, return_counts=True)
+    bg = int(vals[cnts.argmax()])
+
+    sep_cols = [c for c in range(legend.shape[1]) if np.all(legend[:, c] == bg)]
+    assert len(sep_cols) >= 2, "legend separator columns must exist"
+
+    turn: dict[int, str] = {}
+    for a, b in zip(sep_cols, sep_cols[1:], strict=False):
+        if b - a <= 2:
+            continue
+        interior = legend[1 : legend_h - 1, a + 1 : b]
+        colors = set(map(int, np.unique(interior)))
+        colors.discard(bg)
+        colors.discard(0)
+        assert len(colors) == 1, "each legend cell must encode exactly one color"
+        color = int(next(iter(colors)))
+        xs = np.where(interior == color)[1]
+        turn[color] = "L" if int(xs[0]) <= (interior.shape[1] - 1) // 2 else "R"
+    assert len(turn) == 4, "legend must encode four turn colors"
+    return turn
+
+
+def _find_teal_square(g: np.ndarray, teal: int = 8) -> tuple[int, int, int]:
+    """Return (r0, c0, size) for the unique solid teal square."""
+    candidates: list[tuple[int, int, int]] = []
+    for cells in components_mask(g == teal, connectivity=4):
+        r0, c0, r1, c1 = bbox_coords(cells)
+        hh = r1 - r0 + 1
+        ww = c1 - c0 + 1
+        if hh != ww:
+            continue
+        if int(np.sum(g[r0 : r1 + 1, c0 : c1 + 1] == teal)) != hh * ww:
+            continue
+        candidates.append((int(r0), int(c0), int(hh)))
+    assert len(candidates) == 1, "main grid must contain exactly one solid teal square"
+    return candidates[0]
+
+
+def _collect_obstacle_boxes(base: np.ndarray, bg: int, teal: int) -> dict[int, tuple[int, int, int, int]]:
+    """Map each obstacle color to its rectangular bbox."""
+    boxes: dict[int, tuple[int, int, int, int]] = {}
+    for color in map(int, np.unique(base)):
+        if color in (bg, teal):
+            continue
+        coords = np.argwhere(base == color)
+        assert coords.size, "obstacle color must appear"
+        r0, c0, r1, c1 = bbox_coords(coords)
+        area = (r1 - r0 + 1) * (c1 - c0 + 1)
+        assert int(np.sum(base[r0 : r1 + 1, c0 : c1 + 1] == color)) == area
+        boxes[color] = (int(r0), int(c0), int(r1), int(c1))
+    return boxes
+
+
+def _rot_ccw(d: int) -> int:
+    return (d - 1) % 4
+
+
+def _rot_cw(d: int) -> int:
+    return (d + 1) % 4
+
+
+def _rot(d: int, turn: str) -> int:
+    return _rot_ccw(d) if turn == "L" else _rot_cw(d)
+
+
+def _reverse(d: int) -> int:
+    return (d + 2) % 4
+
+
+def _hit_mode(box: tuple[int, int, int, int], nr: int, sz: int) -> str:
+    """
+    Classify the collision as upper/lower using the overlap row center.
+
+    The obstacle's vertical midpoint is compared to the center row of the
+    overlapping slice between the next beam footprint and the obstacle bbox.
+    """
+    r0, _c0, r1, _c1 = box
+    ov0 = max(nr, r0)
+    ov1 = min(nr + sz - 1, r1)
+    assert ov0 <= ov1, "collision footprint must overlap the obstacle vertically"
+    return "upper" if ov0 + ov1 < r0 + r1 else "lower"
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Launch four teal beams from the source square, with collisions decided by both legend and hit height.
+
+    Input structure:
+    - A top legend band encodes four obstacle colors; the colored bar in each cell sits on the left or right.
+    - Below the legend is the main board with one teal square, a uniform background, and solid colored obstacle rectangles.
+
+    Rule:
+    - Remove the legend band from the output.
+    - Emit one sz-by-sz teal beam in each cardinal direction, painting only background cells.
+    - When a beam would enter an obstacle, first inspect where it hits that obstacle vertically:
+      upper half -> turn 90 degrees according to the legend for that color;
+      lower half -> reverse 180 degrees and continue back along the path.
+    - Beams stop when the next sz-by-sz step would leave the main board.
+
+    Key insight:
+    - The legend still tells you the left-vs-right choice for 90-degree turns, but it no longer fully determines the motion.
+    - You must also locate the collision point within the obstacle's upper or lower half.
+    """
+    g = np.asarray(grid, dtype=int)
+
+    legend_bg = 5
+    rows_with_legend = np.where(np.any(g == legend_bg, axis=1))[0]
+    assert rows_with_legend.size, "legend rows must be present"
+    legend_h = int(rows_with_legend.max() + 1)
+    assert np.array_equal(rows_with_legend, np.arange(legend_h)), "legend color must be confined to the top band"
+
+    legend_turn = _parse_legend(g, legend_h)
+
+    base = g[legend_h:, :].copy()
+    assert base.size, "main grid must remain after legend crop"
+
+    vals, cnts = np.unique(base, return_counts=True)
+    bg = int(vals[cnts.argmax()])
+    teal = 8
+    sr, sc, sz = _find_teal_square(base, teal=teal)
+    boxes = _collect_obstacle_boxes(base, bg, teal)
+
+    out = base.copy()
+
+    def in_bounds(r: int, c: int) -> bool:
+        return 0 <= r and 0 <= c and r + sz - 1 < out.shape[0] and c + sz - 1 < out.shape[1]
+
+    def paint_block(r: int, c: int) -> None:
+        blk = out[r : r + sz, c : c + sz]
+        blk[blk == bg] = teal
+        out[r : r + sz, c : c + sz] = blk
+
+    def obstacle_color_at_next(nr: int, nc: int) -> int | None:
+        blk = base[nr : nr + sz, nc : nc + sz]
+        cols = set(map(int, np.unique(blk)))
+        cols.discard(bg)
+        cols.discard(teal)
+        if not cols:
+            return None
+        assert len(cols) == 1, "beam footprint must not hit mixed obstacle colors"
+        return int(next(iter(cols)))
+
+    for d0 in range(4):
+        r, c, d = sr, sc, d0
+        seen: set[tuple[int, int, int]] = set()
+        while True:
+            state = (r, c, d)
+            assert state not in seen, "beam path must not cycle"
+            seen.add(state)
+
+            dr, dc = _DIRS[d]
+            nr, nc = r + dr, c + dc
+            if not in_bounds(nr, nc):
+                break
+
+            oc = obstacle_color_at_next(nr, nc)
+            if oc is None:
+                r, c = nr, nc
+                paint_block(r, c)
+                continue
+
+            assert oc in legend_turn, "obstacle color must be encoded by legend"
+            if _hit_mode(boxes[oc], nr, sz) == "upper":
+                d = _rot(d, legend_turn[oc])
+            else:
+                d = _reverse(d)
+
+    return out
+
+
+# --------------- generator ---------------
+
+LEGEND_COLOR_POOL = [1, 2, 3, 4, 6]
+BG_COLOR_POOL = [1, 2, 3, 4, 6, 7, 9]
+LEGEND_BG = 5
+TEAL = 8
+
+GRID_H_RANGE = (19, 24)
+GRID_W = 24
+LEGEND_H = 6
+LEGEND_CELL_STARTS = [1, 7, 13, 19]
+
+TEAL_SZ2_PROB = 0.75
+SQUARE_EDGE_GAP = 5
+
+OBS_THICKNESS_RANGE = (2, 4)
+SPAN_MIN_MULT = 3
+SPAN_MAX_MULT = 14
+SPAN_COMPACT_PROB = 0.4
+
+MAX_RETRIES = 400
+
+
+def _interval_disjoint(a: tuple[int, int], b: tuple[int, int]) -> bool:
+    return a[1] < b[0] or b[1] < a[0]
+
+
+def _choose_span(
+    axis_len: int,
+    required: list[tuple[int, int]],
+    excluded: list[tuple[int, int]],
+    min_len: int,
+    max_len: int,
+) -> tuple[int, int] | None:
+    """Pick an axis-aligned span covering required intervals and missing excluded ones."""
+    req0 = min(a for a, _ in required)
+    req1 = max(b for _, b in required)
+    lo = max(min_len, req1 - req0 + 1)
+    hi = min(max_len, axis_len)
+    choices: list[tuple[int, int, int]] = []
+    for length in range(lo, hi + 1):
+        start0 = max(0, req1 - length + 1)
+        start1 = min(req0, axis_len - length)
+        for start in range(start0, start1 + 1):
+            end = start + length - 1
+            if all(_interval_disjoint((start, end), exc) for exc in excluded):
+                choices.append((length, start, end))
+    if not choices:
+        return None
+
+    lengths = sorted({length for length, _a, _b in choices})
+    if random.random() < SPAN_COMPACT_PROB:
+        cutoff = lengths[min(len(lengths) - 1, max(0, len(lengths) // 2))]
+        pool = [(start, end) for length, start, end in choices if length <= cutoff]
+    else:
+        pool = [(start, end) for _length, start, end in choices]
+    return random.choice(pool)
+
+
+def _choose_vertical_span(
+    axis_len: int,
+    required: list[tuple[int, int]],
+    excluded: list[tuple[int, int]],
+    hit_rules: list[tuple[tuple[int, int], str]],
+    min_len: int,
+    max_len: int,
+    stop_before: int,
+) -> tuple[int, int] | None:
+    """
+    Search for a vertical obstacle span satisfying cover/exclude and upper/lower hit rules.
+
+    stop_before is the first forbidden row, used to keep vertical obstacles above the south bar.
+    """
+    req0 = min(a for a, _ in required)
+    req1 = max(b for _, b in required)
+    lo = max(min_len, req1 - req0 + 1)
+    hi = min(max_len, stop_before)
+    choices: list[tuple[int, int, int]] = []
+    for length in range(lo, hi + 1):
+        start0 = max(0, req1 - length + 1)
+        start1 = min(req0, stop_before - length)
+        for start in range(start0, start1 + 1):
+            end = start + length - 1
+            span = (start, end)
+            if any(not _interval_disjoint(span, exc) for exc in excluded):
+                continue
+            ok = True
+            center_sum = start + end
+            for interval, kind in hit_rules:
+                a, b = interval
+                if not (start <= a and b <= end):
+                    ok = False
+                    break
+                hit_sum = a + b
+                if kind == "upper" and not (hit_sum < center_sum):
+                    ok = False
+                    break
+                if kind == "lower" and not (hit_sum >= center_sum):
+                    ok = False
+                    break
+            if ok:
+                choices.append((length, start, end))
+    if not choices:
+        return None
+
+    lengths = sorted({length for length, _a, _b in choices})
+    if random.random() < SPAN_COMPACT_PROB:
+        cutoff = lengths[min(len(lengths) - 1, max(0, len(lengths) // 2))]
+        pool = [(start, end) for length, start, end in choices if length <= cutoff]
+    else:
+        pool = [(start, end) for _length, start, end in choices]
+    return random.choice(pool)
+
+
+def _obstacle_rect(
+    side: int, thickness: int, span: tuple[int, int], h: int, w: int
+) -> tuple[int, int, int, int]:
+    """Return (r0, r1, c0, c1) for one edge-touching rectangle."""
+    s0, s1 = span
+    if side == _S:
+        return h - thickness, h - 1, s0, s1
+    if side == _W:
+        return s0, s1, 0, thickness - 1
+    if side == _E:
+        return s0, s1, w - thickness, w - 1
+    raise AssertionError("generator only uses south/west/east obstacles")
+
+
+def _make_legend(legend_colors: list[int], turns: dict[int, str]) -> np.ndarray:
+    """Build the unchanged 6x24 legend band."""
+    legend = np.full((LEGEND_H, GRID_W), LEGEND_BG, dtype=int)
+    for start, color in zip(LEGEND_CELL_STARTS, legend_colors):
+        legend[1:5, start : start + 4] = 0
+        bar_col = start if turns[color] == "L" else start + 3
+        legend[1:5, bar_col] = color
+    return legend
+
+
+def _simulate_paths(
+    base: np.ndarray, turns: dict[int, str], bg: int
+) -> tuple[np.ndarray, list[list[tuple[int, int, int, int, str]]]]:
+    """Oracle simulation for the variant rule."""
+    vals, counts = np.unique(base, return_counts=True)
+    assert int(vals[counts.argmax()]) == bg
+
+    sr, sc, sz = _find_teal_square(base, TEAL)
+    out = base.copy()
+    h, w = out.shape
+    boxes = _collect_obstacle_boxes(base, bg, TEAL)
+    hits: list[list[tuple[int, int, int, int, str]]] = []
+
+    def in_bounds(r: int, c: int) -> bool:
+        return 0 <= r and 0 <= c and r + sz - 1 < h and c + sz - 1 < w
+
+    def paint(r: int, c: int) -> None:
+        blk = out[r : r + sz, c : c + sz]
+        blk[blk == bg] = TEAL
+        out[r : r + sz, c : c + sz] = blk
+
+    def obstacle_at(r: int, c: int) -> int | None:
+        colors = set(map(int, np.unique(base[r : r + sz, c : c + sz])))
+        colors.discard(bg)
+        colors.discard(TEAL)
+        if not colors:
+            return None
+        assert len(colors) == 1
+        return int(next(iter(colors)))
+
+    for d0 in range(4):
+        r, c, d = sr, sc, d0
+        beam_hits: list[tuple[int, int, int, int, str]] = []
+        seen: set[tuple[int, int, int]] = set()
+        while True:
+            state = (r, c, d)
+            assert state not in seen
+            seen.add(state)
+            dr, dc = _DIRS[d]
+            nr, nc = r + dr, c + dc
+            if not in_bounds(nr, nc):
+                break
+            obs = obstacle_at(nr, nc)
+            if obs is None:
+                r, c = nr, nc
+                paint(r, c)
+                continue
+            mode = _hit_mode(boxes[obs], nr, sz)
+            beam_hits.append((d, obs, nr, nc, mode))
+            d = _rot(d, turns[obs]) if mode == "upper" else _reverse(d)
+            assert len(beam_hits) <= 3
+        hits.append(beam_hits)
+
+    return out, hits
+
+
+def _rand_thickness() -> int:
+    return random.randint(*OBS_THICKNESS_RANGE)
+
+
+def _gen_attempt() -> np.ndarray | None:
+    h, w = random.randint(*GRID_H_RANGE), GRID_W
+    sz = 2 if random.random() < TEAL_SZ2_PROB else 3
+
+    t_s = _rand_thickness()
+    t_w = _rand_thickness()
+    t_e = _rand_thickness()
+
+    min_r = SQUARE_EDGE_GAP
+    max_r = min(h - sz - SQUARE_EDGE_GAP, h - t_s - (2 * sz) - 1)
+    min_c = max(SQUARE_EDGE_GAP, t_w + 1)
+    max_c = min(w - sz - SQUARE_EDGE_GAP, w - t_e - sz - 1)
+    if min_r > max_r or min_c > max_c:
+        return None
+
+    sr = random.randint(min_r, max_r)
+    sc = random.randint(min_c, max_c)
+
+    src_rows = (sr, sr + sz - 1)
+    src_cols = (sc, sc + sz - 1)
+    south_rows = (h - t_s - sz, h - t_s - 1)
+    if src_rows[1] >= south_rows[0]:
+        return None
+
+    upper_side = random.choice([_W, _E])
+    lower_side = _E if upper_side == _W else _W
+
+    stop_before = h - t_s
+    min_len = SPAN_MIN_MULT * sz
+    max_len = min(SPAN_MAX_MULT * sz, stop_before)
+
+    upper_span = _choose_vertical_span(
+        h,
+        [src_rows, south_rows],
+        [],
+        [(src_rows, "upper"), (south_rows, "lower")],
+        min_len,
+        max_len,
+        stop_before,
+    )
+    if upper_span is None:
+        return None
+
+    lower_span = _choose_vertical_span(
+        h,
+        [src_rows],
+        [south_rows],
+        [(src_rows, "lower")],
+        min_len,
+        max_len,
+        stop_before,
+    )
+    if lower_span is None:
+        return None
+
+    south_span = _choose_span(w, [src_cols], [], min_len, min(SPAN_MAX_MULT * sz, w))
+    if south_span is None:
+        return None
+
+    legend_colors = random.sample(LEGEND_COLOR_POOL, 4)
+    side_colors = random.sample(legend_colors, 3)
+    side_color = {_S: side_colors[0], _W: side_colors[1], _E: side_colors[2]}
+    bg = random.choice([c for c in BG_COLOR_POOL if c not in legend_colors])
+
+    base = np.full((h, w), bg, dtype=int)
+    base[sr : sr + sz, sc : sc + sz] = TEAL
+
+    spans = {
+        _S: south_span,
+        _W: upper_span if upper_side == _W else lower_span,
+        _E: upper_span if upper_side == _E else lower_span,
+    }
+    thickness = {_S: t_s, _W: t_w, _E: t_e}
+
+    occupied = np.zeros((h, w), dtype=bool)
+    occupied[sr : sr + sz, sc : sc + sz] = True
+    for side in (_S, _W, _E):
+        r0, r1, c0, c1 = _obstacle_rect(side, thickness[side], spans[side], h, w)
+        region = occupied[r0 : r1 + 1, c0 : c1 + 1]
+        if region.any():
+            return None
+        occupied[r0 : r1 + 1, c0 : c1 + 1] = True
+        base[r0 : r1 + 1, c0 : c1 + 1] = side_color[side]
+
+    vals, counts = np.unique(base, return_counts=True)
+    if int(vals[counts.argmax()]) != bg:
+        return None
+
+    turns: dict[int, str] = {}
+    upper_color = side_color[upper_side]
+    lower_color = side_color[lower_side]
+    south_color = side_color[_S]
+
+    turns[upper_color] = "R" if upper_side == _W else "L"
+    turns[south_color] = "R" if upper_side == _W else "L"
+    turns[lower_color] = random.choice(["L", "R"])
+    for color in legend_colors:
+        turns.setdefault(color, random.choice(["L", "R"]))
+
+    try:
+        expected, hits = _simulate_paths(base, turns, bg)
+    except AssertionError:
+        return None
+
+    hit_counts = [len(beam) for beam in hits]
+    if hit_counts != [0, 2 if lower_side == _E else 1, 2, 1 if lower_side == _E else 2]:
+        # Direction order is N, E, S, W. This enforces the intended path template.
+        return None
+
+    per_color_modes: dict[int, list[str]] = {}
+    for beam in hits:
+        for _d, color, _nr, _nc, mode in beam:
+            per_color_modes.setdefault(color, []).append(mode)
+
+    if not {"upper", "lower"} <= {mode for beam in hits for _d, _c, _nr, _nc, mode in beam}:
+        return None
+    if sorted(per_color_modes.get(upper_color, [])) != ["lower", "upper"]:
+        return None
+    if per_color_modes.get(lower_color) != ["lower"]:
+        return None
+    if per_color_modes.get(south_color) != ["upper"]:
+        return None
+
+    legend = _make_legend(legend_colors, turns)
+    inp = np.vstack([legend, base])
+    try:
+        actual = main(inp)
+    except AssertionError:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate e87109e9 D19 input")

diff --git a/ceshi/code/e87109e9/D19/1/code.py b/ceshi/code/e87109e9/D19/1/code.py
new file mode 100644
index 0000000000000000000000000000000000000000..3239b0369c3eaf0c75a79cc56e9971d7f20f12f6
--- /dev/null
+++ b/ceshi/code/e87109e9/D19/1/code.py
@@ -0,0 +1,603 @@
+# Variant of e87109e9
+# Dimension: D19 — 转弯后射线方向的确定 (path)
+# Change: 转弯严格为90度——遇到障碍物后射线方向精确转动90度（顺时针或逆时针）... → 转弯角度由碰撞位置决定
+
+import random
+import sys
+
+import numpy as np
+
+if "/home/lixinyu/snap/new/solvers" not in sys.path:
+    sys.path.append("/home/lixinyu/snap/new/solvers")
+
+from arc_utils import bbox_coords, components_mask
+
+
+# ---------------------------------------------------------------------------
+# Design analysis for the D19 variant
+#
+# variant_spec:
+#   core_change:
+#     old: every collision uses the legend to rotate exactly 90 degrees
+#     new: collision height adds a second decision
+#       upper-half hit -> rotate 90 degrees using the legend
+#       lower-half hit -> reverse 180 degrees, ignoring left/right for that step
+#   concretization:
+#     grid_objects:
+#       legend: unchanged 6x24 band with 4 colored bars
+#       source: one solid teal square of size 2 or 3
+#       obstacles: solid rectangles on the left, right, and bottom edges
+#     visible_effect:
+#       the same obstacle can react differently when hit at two vertical levels
+#       in generated samples, one vertical obstacle is hit once near its upper half
+#       and once near its lower half, so the output visibly differs
+#   behavior_trace:
+#     example:
+#       before:
+#         east beam hits right obstacle -> always turns left/right by legend
+#       after:
+#         east beam hits the lower half of the right obstacle -> reverses and travels back
+#         south beam later hits the other vertical obstacle in its upper half -> that hit still uses the legend
+#       difference:
+#         the legend is no longer sufficient by itself; the row of the contact matters
+#   complexity_calibration:
+#     why_not_simpler:
+#       if only top/bottom obstacles were used, humans could misread the rule as
+#       "top means reverse, bottom means turn". The generator therefore uses both
+#       left and right vertical obstacles and forces one of them to be hit in both halves.
+#     controlled_freedom:
+#       only two turn angles exist (90 / 180), and the legend still has the same
+#       left/right meaning for the 90-degree branch.
+#   implicit_assumption_review:
+#     old_main_dependencies:
+#       obstacle collision logic assumed "color -> unique 90-degree action"
+#       this is no longer valid, so the solver now also needs each obstacle bbox
+#       to classify the hit row against the obstacle's vertical midpoint.
+#     safe_updates:
+#       obstacle detection now reads from the uncropped base grid instead of the
+#       painted output, so previously painted teal trails do not corrupt collision tests.
+#   placement_legality:
+#     guarantees:
+#       left/right obstacles stop above the bottom obstacle, so rectangles never overlap
+#       the source square keeps a gap from every obstacle and from the grid border
+#       the "upper-hit" vertical obstacle covers both the source lane and the low lane
+#       above the bottom obstacle, enabling two different hit classifications on one shape
+#   observability:
+#     human_signal:
+#       across samples, either the left or the right obstacle plays the dual-role,
+#       so the rule is readable from geometry rather than from color ids.
+#   visual_cleanliness:
+#     layout:
+#       only three obstacles are used, paths are long and axis-aligned, and there is
+#       no corner overlap between rectangles.
+#   color_inference:
+#     unchanged:
+#       colors still only encode clockwise/counterclockwise for the 90-degree case;
+#       no hidden ordering by numeric color id is introduced.
+#   post_edit_assumptions:
+#     solver_requires:
+#       each obstacle color in the main grid is one solid rectangle
+#       vertical hit classification uses the overlap row center against obstacle bbox center
+#     generator_enforces:
+#       exactly three obstacle rectangles are created
+#       every used color appears in the legend
+#       one beam performs a lower-half 180 then reaches an upper-half 90 on the opposite side
+#       one vertical obstacle is hit once as upper-half and once as lower-half
+# ---------------------------------------------------------------------------
+
+_DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+_N, _E, _S, _W = range(4)
+
+
+def _parse_legend(grid: np.ndarray, legend_h: int) -> dict[int, str]:
+    """Decode left/right bar placement inside the legend cells."""
+    legend = grid[:legend_h, :]
+    assert legend.size, "legend must be non-empty"
+    vals, cnts = np.unique(legend, return_counts=True)
+    bg = int(vals[cnts.argmax()])
+
+    sep_cols = [c for c in range(legend.shape[1]) if np.all(legend[:, c] == bg)]
+    assert len(sep_cols) >= 2, "legend separator columns must exist"
+
+    turn: dict[int, str] = {}
+    for a, b in zip(sep_cols, sep_cols[1:], strict=False):
+        if b - a <= 2:
+            continue
+        interior = legend[1 : legend_h - 1, a + 1 : b]
+        colors = set(map(int, np.unique(interior)))
+        colors.discard(bg)
+        colors.discard(0)
+        assert len(colors) == 1, "each legend cell must encode exactly one color"
+        color = int(next(iter(colors)))
+        xs = np.where(interior == color)[1]
+        turn[color] = "L" if int(xs[0]) <= (interior.shape[1] - 1) // 2 else "R"
+    assert len(turn) == 4, "legend must encode four turn colors"
+    return turn
+
+
+def _find_teal_square(g: np.ndarray, teal: int = 8) -> tuple[int, int, int]:
+    """Return (r0, c0, size) for the unique solid teal square."""
+    candidates: list[tuple[int, int, int]] = []
+    for cells in components_mask(g == teal, connectivity=4):
+        r0, c0, r1, c1 = bbox_coords(cells)
+        hh = r1 - r0 + 1
+        ww = c1 - c0 + 1
+        if hh != ww:
+            continue
+        if int(np.sum(g[r0 : r1 + 1, c0 : c1 + 1] == teal)) != hh * ww:
+            continue
+        candidates.append((int(r0), int(c0), int(hh)))
+    assert len(candidates) == 1, "main grid must contain exactly one solid teal square"
+    return candidates[0]
+
+
+def _collect_obstacle_boxes(base: np.ndarray, bg: int, teal: int) -> dict[int, tuple[int, int, int, int]]:
+    """Map each obstacle color to its rectangular bbox."""
+    boxes: dict[int, tuple[int, int, int, int]] = {}
+    for color in map(int, np.unique(base)):
+        if color in (bg, teal):
+            continue
+        coords = np.argwhere(base == color)
+        assert coords.size, "obstacle color must appear"
+        r0, c0, r1, c1 = bbox_coords(coords)
+        area = (r1 - r0 + 1) * (c1 - c0 + 1)
+        assert int(np.sum(base[r0 : r1 + 1, c0 : c1 + 1] == color)) == area
+        boxes[color] = (int(r0), int(c0), int(r1), int(c1))
+    return boxes
+
+
+def _rot_ccw(d: int) -> int:
+    return (d - 1) % 4
+
+
+def _rot_cw(d: int) -> int:
+    return (d + 1) % 4
+
+
+def _rot(d: int, turn: str) -> int:
+    return _rot_ccw(d) if turn == "L" else _rot_cw(d)
+
+
+def _reverse(d: int) -> int:
+    return (d + 2) % 4
+
+
+def _hit_mode(box: tuple[int, int, int, int], nr: int, sz: int) -> str:
+    """
+    Classify the collision as upper/lower using the overlap row center.
+
+    The obstacle's vertical midpoint is compared to the center row of the
+    overlapping slice between the next beam footprint and the obstacle bbox.
+    """
+    r0, _c0, r1, _c1 = box
+    ov0 = max(nr, r0)
+    ov1 = min(nr + sz - 1, r1)
+    assert ov0 <= ov1, "collision footprint must overlap the obstacle vertically"
+    return "upper" if ov0 + ov1 < r0 + r1 else "lower"
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Launch four teal beams from the source square, with collisions decided by both legend and hit height.
+
+    Input structure:
+    - A top legend band encodes four obstacle colors; the colored bar in each cell sits on the left or right.
+    - Below the legend is the main board with one teal square, a uniform background, and solid colored obstacle rectangles.
+
+    Rule:
+    - Remove the legend band from the output.
+    - Emit one sz-by-sz teal beam in each cardinal direction, painting only background cells.
+    - When a beam would enter an obstacle, first inspect where it hits that obstacle vertically:
+      upper half -> turn 90 degrees according to the legend for that color;
+      lower half -> reverse 180 degrees and continue back along the path.
+    - Beams stop when the next sz-by-sz step would leave the main board.
+
+    Key insight:
+    - The legend still tells you the left-vs-right choice for 90-degree turns, but it no longer fully determines the motion.
+    - You must also locate the collision point within the obstacle's upper or lower half.
+    """
+    g = np.asarray(grid, dtype=int)
+
+    legend_bg = 5
+    rows_with_legend = np.where(np.any(g == legend_bg, axis=1))[0]
+    assert rows_with_legend.size, "legend rows must be present"
+    legend_h = int(rows_with_legend.max() + 1)
+    assert np.array_equal(rows_with_legend, np.arange(legend_h)), "legend color must be confined to the top band"
+
+    legend_turn = _parse_legend(g, legend_h)
+
+    base = g[legend_h:, :].copy()
+    assert base.size, "main grid must remain after legend crop"
+
+    vals, cnts = np.unique(base, return_counts=True)
+    bg = int(vals[cnts.argmax()])
+    teal = 8
+    sr, sc, sz = _find_teal_square(base, teal=teal)
+    boxes = _collect_obstacle_boxes(base, bg, teal)
+
+    out = base.copy()
+
+    def in_bounds(r: int, c: int) -> bool:
+        return 0 <= r and 0 <= c and r + sz - 1 < out.shape[0] and c + sz - 1 < out.shape[1]
+
+    def paint_block(r: int, c: int) -> None:
+        blk = out[r : r + sz, c : c + sz]
+        blk[blk == bg] = teal
+        out[r : r + sz, c : c + sz] = blk
+
+    def obstacle_color_at_next(nr: int, nc: int) -> int | None:
+        blk = base[nr : nr + sz, nc : nc + sz]
+        cols = set(map(int, np.unique(blk)))
+        cols.discard(bg)
+        cols.discard(teal)
+        if not cols:
+            return None
+        assert len(cols) == 1, "beam footprint must not hit mixed obstacle colors"
+        return int(next(iter(cols)))
+
+    for d0 in range(4):
+        r, c, d = sr, sc, d0
+        seen: set[tuple[int, int, int]] = set()
+        while True:
+            state = (r, c, d)
+            assert state not in seen, "beam path must not cycle"
+            seen.add(state)
+
+            dr, dc = _DIRS[d]
+            nr, nc = r + dr, c + dc
+            if not in_bounds(nr, nc):
+                break
+
+            oc = obstacle_color_at_next(nr, nc)
+            if oc is None:
+                r, c = nr, nc
+                paint_block(r, c)
+                continue
+
+            assert oc in legend_turn, "obstacle color must be encoded by legend"
+            if _hit_mode(boxes[oc], nr, sz) == "upper":
+                d = _rot(d, legend_turn[oc])
+            else:
+                d = _reverse(d)
+
+    return out
+
+
+# --------------- generator ---------------
+
+LEGEND_COLOR_POOL = [1, 2, 3, 4, 6]
+BG_COLOR_POOL = [1, 2, 3, 4, 6, 7, 9]
+LEGEND_BG = 5
+TEAL = 8
+
+GRID_H_RANGE = (19, 24)
+GRID_W = 24
+LEGEND_H = 6
+LEGEND_CELL_STARTS = [1, 7, 13, 19]
+
+TEAL_SZ2_PROB = 0.75
+SQUARE_EDGE_GAP = 5
+
+OBS_THICKNESS_RANGE = (2, 4)
+SPAN_MIN_MULT = 3
+SPAN_MAX_MULT = 14
+SPAN_COMPACT_PROB = 0.4
+
+MAX_RETRIES = 400
+
+
+def _interval_disjoint(a: tuple[int, int], b: tuple[int, int]) -> bool:
+    return a[1] < b[0] or b[1] < a[0]
+
+
+def _choose_span(
+    axis_len: int,
+    required: list[tuple[int, int]],
+    excluded: list[tuple[int, int]],
+    min_len: int,
+    max_len: int,
+) -> tuple[int, int] | None:
+    """Pick an axis-aligned span covering required intervals and missing excluded ones."""
+    req0 = min(a for a, _ in required)
+    req1 = max(b for _, b in required)
+    lo = max(min_len, req1 - req0 + 1)
+    hi = min(max_len, axis_len)
+    choices: list[tuple[int, int, int]] = []
+    for length in range(lo, hi + 1):
+        start0 = max(0, req1 - length + 1)
+        start1 = min(req0, axis_len - length)
+        for start in range(start0, start1 + 1):
+            end = start + length - 1
+            if all(_interval_disjoint((start, end), exc) for exc in excluded):
+                choices.append((length, start, end))
+    if not choices:
+        return None
+
+    lengths = sorted({length for length, _a, _b in choices})
+    if random.random() < SPAN_COMPACT_PROB:
+        cutoff = lengths[min(len(lengths) - 1, max(0, len(lengths) // 2))]
+        pool = [(start, end) for length, start, end in choices if length <= cutoff]
+    else:
+        pool = [(start, end) for _length, start, end in choices]
+    return random.choice(pool)
+
+
+def _choose_vertical_span(
+    axis_len: int,
+    required: list[tuple[int, int]],
+    excluded: list[tuple[int, int]],
+    hit_rules: list[tuple[tuple[int, int], str]],
+    min_len: int,
+    max_len: int,
+    stop_before: int,
+) -> tuple[int, int] | None:
+    """
+    Search for a vertical obstacle span satisfying cover/exclude and upper/lower hit rules.
+
+    stop_before is the first forbidden row, used to keep vertical obstacles above the south bar.
+    """
+    req0 = min(a for a, _ in required)
+    req1 = max(b for _, b in required)
+    lo = max(min_len, req1 - req0 + 1)
+    hi = min(max_len, stop_before)
+    choices: list[tuple[int, int, int]] = []
+    for length in range(lo, hi + 1):
+        start0 = max(0, req1 - length + 1)
+        start1 = min(req0, stop_before - length)
+        for start in range(start0, start1 + 1):
+            end = start + length - 1
+            span = (start, end)
+            if any(not _interval_disjoint(span, exc) for exc in excluded):
+                continue
+            ok = True
+            center_sum = start + end
+            for interval, kind in hit_rules:
+                a, b = interval
+                if not (start <= a and b <= end):
+                    ok = False
+                    break
+                hit_sum = a + b
+                if kind == "upper" and not (hit_sum < center_sum):
+                    ok = False
+                    break
+                if kind == "lower" and not (hit_sum >= center_sum):
+                    ok = False
+                    break
+            if ok:
+                choices.append((length, start, end))
+    if not choices:
+        return None
+
+    lengths = sorted({length for length, _a, _b in choices})
+    if random.random() < SPAN_COMPACT_PROB:
+        cutoff = lengths[min(len(lengths) - 1, max(0, len(lengths) // 2))]
+        pool = [(start, end) for length, start, end in choices if length <= cutoff]
+    else:
+        pool = [(start, end) for _length, start, end in choices]
+    return random.choice(pool)
+
+
+def _obstacle_rect(
+    side: int, thickness: int, span: tuple[int, int], h: int, w: int
+) -> tuple[int, int, int, int]:
+    """Return (r0, r1, c0, c1) for one edge-touching rectangle."""
+    s0, s1 = span
+    if side == _S:
+        return h - thickness, h - 1, s0, s1
+    if side == _W:
+        return s0, s1, 0, thickness - 1
+    if side == _E:
+        return s0, s1, w - thickness, w - 1
+    raise AssertionError("generator only uses south/west/east obstacles")
+
+
+def _make_legend(legend_colors: list[int], turns: dict[int, str]) -> np.ndarray:
+    """Build the unchanged 6x24 legend band."""
+    legend = np.full((LEGEND_H, GRID_W), LEGEND_BG, dtype=int)
+    for start, color in zip(LEGEND_CELL_STARTS, legend_colors):
+        legend[1:5, start : start + 4] = 0
+        bar_col = start if turns[color] == "L" else start + 3
+        legend[1:5, bar_col] = color
+    return legend
+
+
+def _simulate_paths(
+    base: np.ndarray, turns: dict[int, str], bg: int
+) -> tuple[np.ndarray, list[list[tuple[int, int, int, int, str]]]]:
+    """Oracle simulation for the variant rule."""
+    vals, counts = np.unique(base, return_counts=True)
+    assert int(vals[counts.argmax()]) == bg
+
+    sr, sc, sz = _find_teal_square(base, TEAL)
+    out = base.copy()
+    h, w = out.shape
+    boxes = _collect_obstacle_boxes(base, bg, TEAL)
+    hits: list[list[tuple[int, int, int, int, str]]] = []
+
+    def in_bounds(r: int, c: int) -> bool:
+        return 0 <= r and 0 <= c and r + sz - 1 < h and c + sz - 1 < w
+
+    def paint(r: int, c: int) -> None:
+        blk = out[r : r + sz, c : c + sz]
+        blk[blk == bg] = TEAL
+        out[r : r + sz, c : c + sz] = blk
+
+    def obstacle_at(r: int, c: int) -> int | None:
+        colors = set(map(int, np.unique(base[r : r + sz, c : c + sz])))
+        colors.discard(bg)
+        colors.discard(TEAL)
+        if not colors:
+            return None
+        assert len(colors) == 1
+        return int(next(iter(colors)))
+
+    for d0 in range(4):
+        r, c, d = sr, sc, d0
+        beam_hits: list[tuple[int, int, int, int, str]] = []
+        seen: set[tuple[int, int, int]] = set()
+        while True:
+            state = (r, c, d)
+            assert state not in seen
+            seen.add(state)
+            dr, dc = _DIRS[d]
+            nr, nc = r + dr, c + dc
+            if not in_bounds(nr, nc):
+                break
+            obs = obstacle_at(nr, nc)
+            if obs is None:
+                r, c = nr, nc
+                paint(r, c)
+                continue
+            mode = _hit_mode(boxes[obs], nr, sz)
+            beam_hits.append((d, obs, nr, nc, mode))
+            d = _rot(d, turns[obs]) if mode == "upper" else _reverse(d)
+            assert len(beam_hits) <= 3
+        hits.append(beam_hits)
+
+    return out, hits
+
+
+def _rand_thickness() -> int:
+    return random.randint(*OBS_THICKNESS_RANGE)
+
+
+def _gen_attempt() -> np.ndarray | None:
+    h, w = random.randint(*GRID_H_RANGE), GRID_W
+    sz = 2 if random.random() < TEAL_SZ2_PROB else 3
+
+    t_s = _rand_thickness()
+    t_w = _rand_thickness()
+    t_e = _rand_thickness()
+
+    min_r = SQUARE_EDGE_GAP
+    max_r = min(h - sz - SQUARE_EDGE_GAP, h - t_s - (2 * sz) - 1)
+    min_c = max(SQUARE_EDGE_GAP, t_w + 1)
+    max_c = min(w - sz - SQUARE_EDGE_GAP, w - t_e - sz - 1)
+    if min_r > max_r or min_c > max_c:
+        return None
+
+    sr = random.randint(min_r, max_r)
+    sc = random.randint(min_c, max_c)
+
+    src_rows = (sr, sr + sz - 1)
+    src_cols = (sc, sc + sz - 1)
+    south_rows = (h - t_s - sz, h - t_s - 1)
+    if src_rows[1] >= south_rows[0]:
+        return None
+
+    upper_side = random.choice([_W, _E])
+    lower_side = _E if upper_side == _W else _W
+
+    stop_before = h - t_s
+    min_len = SPAN_MIN_MULT * sz
+    max_len = min(SPAN_MAX_MULT * sz, stop_before)
+
+    upper_span = _choose_vertical_span(
+        h,
+        [src_rows, south_rows],
+        [],
+        [(src_rows, "upper"), (south_rows, "lower")],
+        min_len,
+        max_len,
+        stop_before,
+    )
+    if upper_span is None:
+        return None
+
+    lower_span = _choose_vertical_span(
+        h,
+        [src_rows],
+        [south_rows],
+        [(src_rows, "lower")],
+        min_len,
+        max_len,
+        stop_before,
+    )
+    if lower_span is None:
+        return None
+
+    south_span = _choose_span(w, [src_cols], [], min_len, min(SPAN_MAX_MULT * sz, w))
+    if south_span is None:
+        return None
+
+    legend_colors = random.sample(LEGEND_COLOR_POOL, 4)
+    side_colors = random.sample(legend_colors, 3)
+    side_color = {_S: side_colors[0], _W: side_colors[1], _E: side_colors[2]}
+    bg = random.choice([c for c in BG_COLOR_POOL if c not in legend_colors])
+
+    base = np.full((h, w), bg, dtype=int)
+    base[sr : sr + sz, sc : sc + sz] = TEAL
+
+    spans = {
+        _S: south_span,
+        _W: upper_span if upper_side == _W else lower_span,
+        _E: upper_span if upper_side == _E else lower_span,
+    }
+    thickness = {_S: t_s, _W: t_w, _E: t_e}
+
+    occupied = np.zeros((h, w), dtype=bool)
+    occupied[sr : sr + sz, sc : sc + sz] = True
+    for side in (_S, _W, _E):
+        r0, r1, c0, c1 = _obstacle_rect(side, thickness[side], spans[side], h, w)
+        region = occupied[r0 : r1 + 1, c0 : c1 + 1]
+        if region.any():
+            return None
+        occupied[r0 : r1 + 1, c0 : c1 + 1] = True
+        base[r0 : r1 + 1, c0 : c1 + 1] = side_color[side]
+
+    vals, counts = np.unique(base, return_counts=True)
+    if int(vals[counts.argmax()]) != bg:
+        return None
+
+    turns: dict[int, str] = {}
+    upper_color = side_color[upper_side]
+    lower_color = side_color[lower_side]
+    south_color = side_color[_S]
+
+    turns[upper_color] = "R" if upper_side == _W else "L"
+    turns[south_color] = "R" if upper_side == _W else "L"
+    turns[lower_color] = random.choice(["L", "R"])
+    for color in legend_colors:
+        turns.setdefault(color, random.choice(["L", "R"]))
+
+    try:
+        expected, hits = _simulate_paths(base, turns, bg)
+    except AssertionError:
+        return None
+
+    hit_counts = [len(beam) for beam in hits]
+    if hit_counts != [0, 2 if lower_side == _E else 1, 2, 1 if lower_side == _E else 2]:
+        # Direction order is N, E, S, W. This enforces the intended path template.
+        return None
+
+    per_color_modes: dict[int, list[str]] = {}
+    for beam in hits:
+        for _d, color, _nr, _nc, mode in beam:
+            per_color_modes.setdefault(color, []).append(mode)
+
+    if not {"upper", "lower"} <= {mode for beam in hits for _d, _c, _nr, _nc, mode in beam}:
+        return None
+    if sorted(per_color_modes.get(upper_color, [])) != ["lower", "upper"]:
+        return None
+    if per_color_modes.get(lower_color) != ["lower"]:
+        return None
+    if per_color_modes.get(south_color) != ["upper"]:
+        return None
+
+    legend = _make_legend(legend_colors, turns)
+    inp = np.vstack([legend, base])
+    try:
+        actual = main(inp)
+    except AssertionError:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate e87109e9 D19 input")

