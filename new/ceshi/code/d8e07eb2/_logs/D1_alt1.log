+# --------------- generator ---------------
+
+# -- Grid layout --
+GRID_H, GRID_W = 30, 22
+TOP_SEP_ROW = 5
+BOTTOM_SEP_ROW = 27
+QUERY_BAND_H = 5
+VERDICT_ROW = 28
+
+# -- Colors --
+BG = 8
+GREEN = 3
+RED = 2
+SEP = 6
+GLYPH_COLORS = (0, 1, 2, 4, 5, 6, 7, 9)
+
+# -- Table geometry --
+TABLE_DIM = 4
+CELL = 5
+ROWS = (7, 12, 17, 22)
+COLS = (1, 6, 11, 16)
+
+# -- Glyph shape --
+FILL_MIN, FILL_MAX = 5, 9
+SHAPE_PAIR_COUNTS = {5: 2, 6: 2, 7: 2, 8: 1, 9: 1}
+
+# -- Outcome probabilities --
+P_SUCCESS = 0.4
+P_QUERY_3 = 0.35
+FAIL_MODES = ("two_family_non_line", "three_family", "four_family")
+
+# -- Generation --
+MAX_RETRIES = 300
