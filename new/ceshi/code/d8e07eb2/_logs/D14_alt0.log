+
+
+def _gen_attempt() -> np.ndarray | None:
+    """Generate one valid instance and reject it if the solver oracle disagrees."""
+    grid = np.full((GRID_H, GRID_W), BG, dtype=int)
+    grid[TOP_SEP_ROW, :] = SEP
+    grid[BOTTOM_SEP_ROW, :] = SEP
