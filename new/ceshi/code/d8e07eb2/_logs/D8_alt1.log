+def _has_full_bbox(mask: int) -> bool:
+    bits = np.array([(mask >> i) & 1 for i in range(9)], dtype=int).reshape(3, 3)
+    return (
+        bool(bits[0, :].any())
+        and bool(bits[2, :].any())
+        and bool(bits[:, 0].any())
+        and bool(bits[:, 2].any())
