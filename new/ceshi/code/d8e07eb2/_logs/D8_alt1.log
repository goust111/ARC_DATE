+    ]
+    query_set = set(query_mats)
+    assert len(query_mats) == len(query_set), "query glyphs should be distinct"
+
+    out = g.copy()
+    selected: list[tuple[int, int]] = []
+    for ri, r in enumerate(row_starts):
+        for ci, c in enumerate(col_starts):
