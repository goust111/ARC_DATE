+    cell = np.asarray(g[int(r0) : int(r0) + int(size), int(c0) : int(c0) + int(size)], dtype=int)
+    if not bool(np.any(cell != int(bg))):
+        return None
+    return tuple(tuple(int(v) for v in row) for row in cell)
