+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+from arc_utils import get_bg, paste
+
+
+# Design analysis for the D8 variant
+# ----------------------------------
+# a) Concrete behavior
+#    - The canvas geometry stays the same: query band, separator, 4x4 reference
