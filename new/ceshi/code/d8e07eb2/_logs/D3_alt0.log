+    expected = _expected_output(
+        grid,
+        row_starts,
+        col_starts,
+        int(geom["top_sep"]),
+        int(geom["bottom_sep"]),
+        query_cells,
+        success,
+    )
+    if not np.array_equal(main(grid), expected):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid d8e07eb2 input")

