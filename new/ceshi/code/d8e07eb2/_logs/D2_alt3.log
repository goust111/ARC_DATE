+
+def _normalized_signature(patch: np.ndarray, bg: int) -> tuple[tuple[int, int, int], ...] | None:
+    mask = patch != int(bg)
+    if not bool(mask.any()):
+        return None
+    coords = np.argwhere(mask)
+    r0, c0 = coords.min(axis=0)
+    return tuple(
+        (int(r - r0), int(c - c0), int(patch[r, c]))
+        for r, c in coords
+    )
+
