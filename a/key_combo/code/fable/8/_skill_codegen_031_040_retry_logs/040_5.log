+
+def _trace_ray(grid: np.ndarray, bg: int, marker: dict[str, int]) -> dict[str, object]:
+    h, w = grid.shape
+    color = int(marker["color"])
+    cells: list[tuple[int, int]] = []
+    same_color_walls: list[tuple[int, int]] = []
