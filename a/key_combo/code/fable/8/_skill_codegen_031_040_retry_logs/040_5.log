+        else:
+            coords = [(r, c) for r in range(h - 2, 0, -1)]
+
+    for r, c in coords:
+        value = int(grid[r, c])
+        if value == bg:
+            cells.append((r, c))
+            continue
+        if value == color:
+            cells.append((r, c))
+            same_color_walls.append((r, c))
