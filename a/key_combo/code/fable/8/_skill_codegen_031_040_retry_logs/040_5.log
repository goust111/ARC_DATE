+            )
+    for r in range(1, h - 1):
+        color = int(grid[r, 0])
+        if color != bg:
+            markers.append({"orientation": "H", "side": "left", "fixed": r, "color": color, "r": r, "c": 0})
+    for r in range(1, h - 1):
+        color = int(grid[r, w - 1])
+        if color != bg:
+            markers.append(
+                {"orientation": "H", "side": "right", "fixed": r, "color": color, "r": r, "c": w - 1}
+            )
+    return markers
