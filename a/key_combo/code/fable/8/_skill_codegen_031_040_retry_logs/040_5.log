+def _sample_spaced_positions(count: int, low: int, high: int, gap: int) -> list[int] | None:
+    if count == 0:
+        return []
+    positions = list(range(low, high + 1))
+    for _ in range(200):
+        chosen = sorted(random.sample(positions, count))
+        if all(b - a >= gap for a, b in zip(chosen, chosen[1:])):
