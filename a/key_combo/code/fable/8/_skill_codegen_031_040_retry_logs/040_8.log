    max_w = max(w for _, w, _ in rect_specs)
    grid_choices = [
        (h, w)
        for h in range(max(GRID_ROW_MIN, max_h), GRID_ROW_MAX + 1)
        for w in range(max(GRID_COL_MIN, max_w), GRID_COL_MAX + 1)
