                padding=RECT_PADDING,
                padding_connectivity=PADDING_CONNECTIVITY,
            )
        except ValueError:
            return None
        paste(grid, patches[i], r, c)

    try:
        actual = main(grid)
    except Exception:
        return None
    if not np.array_equal(actual, expected):
        return None
    return grid


def generate_input() -> np.ndarray:
    for _ in range(MAX_GENERATION_ATTEMPTS):
