+INPUT_COLORS = (2, 3, 4, 5, 6, 7, 8, 9)
+DIAGONALS = ((1, 1), (1, -1), (-1, 1), (-1, -1))
+MAX_TARGET_BOUNCES = 5
+MAX_GENERATION_ATTEMPTS = 600
+
+_GEN_COUNTER = 0
+_GEN_TARGET_ORDER = list(range(MAX_TARGET_BOUNCES + 1))
