# Canvas bounds and packing density.
GRID_ROW_MIN, GRID_ROW_MAX = 12, 22
GRID_COL_MIN, GRID_COL_MAX = 11, 25
MIN_CANVAS_AREA_FACTOR, BACKGROUND_COLOR = 2, 0
