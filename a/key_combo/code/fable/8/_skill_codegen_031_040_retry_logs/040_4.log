+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BG = 0
+FRAME = 5
+SEPARATOR = 4
+MOVE_COLORS = (1, 2, 3, 6, 7, 8, 9)
+DIRS = ("up", "down", "left", "right")
