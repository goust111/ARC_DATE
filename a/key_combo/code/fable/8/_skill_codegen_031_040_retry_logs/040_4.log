+        "bg": bg,
+        "separator_c": int(sep_c),
+        "arena_side": int(arena_side),
+        "frame_bbox": frame_bbox,
+        "interior_bbox": interior_bbox,
+        "order": [int(c) for c in order],
+        "direction_by_color": direction_by_color,
+    }
