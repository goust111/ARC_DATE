+def _simulate_interior(
+    shape: tuple[int, int],
+    sources_by_color: dict[int, list[tuple[int, int]]],
+    order: list[int],
+    direction_by_color: dict[int, str],
+) -> np.ndarray:
+    h, w = shape
+    out = np.zeros((h, w), dtype=int)
+    occupied = np.zeros((h, w), dtype=bool)
