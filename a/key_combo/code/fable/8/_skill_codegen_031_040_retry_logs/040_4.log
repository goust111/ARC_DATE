def _gen_attempt() -> np.ndarray | None:
    base = np.full(GEN_GRID_SHAPE, GEN_BG, dtype=int)
    doors = []

    for r, c in _gen_choose_centers():
        direction = GEN_DIRECTIONS[_gen_randint(0, len(GEN_DIRECTIONS) - 1)]
