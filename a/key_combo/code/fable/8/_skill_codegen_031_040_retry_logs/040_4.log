+        ]
+        assert len(marker_coords) == 1, f"expected one marker for color {color}, got {marker_coords}"
+        mr, mc = marker_coords[0]
+        if mr == r0:
+            direction = "up"
+        elif mr == r1:
+            direction = "down"
+        elif mc == c0:
+            direction = "left"
+        elif mc == c1:
+            direction = "right"
