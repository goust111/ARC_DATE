+def _add_source(
+    sources: dict[int, list[tuple[int, int]]],
+    occupied: set[tuple[int, int]],
+    color: int,
+    coord: tuple[int, int],
+) -> bool:
+    if coord in occupied:
+        return False
+    occupied.add(coord)
+    sources.setdefault(int(color), []).append((int(coord[0]), int(coord[1])))
