+    h, w = grid.shape
+    matches: list[tuple[int, int, tuple[int, int, int, int], list[int]]] = []
+    for c in range(w):
+        col = grid[:, c]
+        if int(col[0]) == bg or not np.all(col == col[0]):
+            continue
