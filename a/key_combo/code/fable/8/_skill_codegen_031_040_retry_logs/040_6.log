0117:         ]
0118: 
0119:         assert len({r for r, _, _ in ref_pixels}) == 1
0120:         assert len({r for r, _, _ in source_pixels}) == 1
0121:         ref_by_col = {c: color for _, c, color in ref_pixels}
0122:         source_by_col = {c: (r, color) for r, c, color in source_pixels}
0123:         assert len(ref_by_col) == len(ref_pixels)
0124:         assert len(source_by_col) == len(source_pixels)
0125:         assert set(ref_by_col) == set(source_by_col)
