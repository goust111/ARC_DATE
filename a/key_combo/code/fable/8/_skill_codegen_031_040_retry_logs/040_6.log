0042: def main(grid: np.ndarray) -> np.ndarray:
0043:     """
0044:     Fill black holes by restoring the diagonal cyclic color pattern they interrupt.
0045: 
0046:     Input structure
0047:     - The grid is a rectangular cyclic pattern of non-black colors with some
0048:       black pixels removed.
0049:     - All non-black colors in the cycle remain visible somewhere in the input.
0050:     - Each diagonal residue modulo the number of non-black colors has one color.
0051: 
0052:     Rule
0053:     - Infer the diagonal direction and residue-to-color cycle from the visible
0054:       non-black pixels.
0055:     - Replace every black pixel with the color assigned to its diagonal residue.
0056:     - Preserve every non-black pixel.
0057: 
0058:     Key insight
0059:     - The blanks are not objects; they are missing cells in a global repeating
0060:       diagonal tile, so their colors are determined by row + column modulo the
0061:       cycle length.
0062:     """
0063:     g = np.asarray(grid, dtype=int)
0064:     assert g.ndim == 2, "expected a 2D grid"
0065: 
0066:     mode, residue_to_color = _diagonal_cycle(g)
0067:     period = len(residue_to_color)
0068: 
0069:     out = g.copy()
0070:     for r, c in np.argwhere(out == Color.BLACK):
0071:         key = _residue(int(r), int(c), period, mode)
0072:         out[r, c] = residue_to_color[key]
0073:     return out
0074: 
