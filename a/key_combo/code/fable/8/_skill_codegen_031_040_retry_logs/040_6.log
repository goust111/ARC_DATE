0005: def main(grid: np.ndarray) -> np.ndarray:
0006:     """
0007:     Trace diagonal rays from triangular arrows, reflecting off colored wall pixels.
0008: 
0009:     Input structure:
0010:     - bg grid with monochrome 3-pixel L-shaped "arrows" (2x2 bbox missing one corner) and scattered colored wall pixels.
0011: 
0012:     Rule:
0013:     - Each arrow fires a ray diagonally away from its missing corner, painting bg cells in its color.
0014:     - A head-on wall hit reverses both axes; a side-touch wall hit flips the touched axis only.
0015:     - On any bounce the ray adopts the wall's color and recolors the contact cell.
0016:     - Ray stops when it exits the grid or reaches another arrow.
0017: 
0018:     Key insight: Two distinct reflection types (corner vs side-touch) plus color inheritance at each bounce drive the path geometry.
0019:     """
0020:     g = np.array(grid, dtype=int)
0021:     H, W = g.shape
0022:     bg = int(get_bg(g))
0023: 
0024:     def is_arrow_pts(pts: list[tuple[int, int]]) -> bool:
0025:         if len(pts) != 3:
0026:             return False
0027:         rs = [r for r, _c in pts]
0028:         cs = [c for _r, c in pts]
0029:         return (max(rs) - min(rs) == 1) and (max(cs) - min(cs) == 1)
0030: 
0031:     def arrow_dir_and_start(pts: list[tuple[int, int]]):
0032:         rs = [r for r, _c in pts]
0033:         cs = [c for _r, c in pts]
0034:         r0, r1 = min(rs), max(rs)
0035:         c0, c1 = min(cs), max(cs)
0036:         corners = [(r0, c0), (r0, c1), (r1, c0), (r1, c1)]
0037:         miss = [p for p in corners if p not in set(pts)]
0038:         if len(miss) != 1:
0039:             return None
0040:         mr, mc = miss[0]
0041:         # direction away from missing corner
0042:         dr = 1 if mr == r0 else -1
0043:         dc = 1 if mc == c0 else -1
0044: 
0045:         pts_set = set(pts)
0046:         deg = {p: 0 for p in pts}
0047:         for r, c in pts:
0048:             for rr, cc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
0049:                 if (rr, cc) in pts_set:
0050:                     deg[(r, c)] += 1
0051:         start = max(deg, key=lambda p: deg[p])  # right-angle corner
0052:         return (int(dr), int(dc)), (int(start[0]), int(start[1]))
0053: 
0054:     # Detect arrows per-color (cannot rely on global non-bg connectivity).
0055:     arrow_cells: set[tuple[int, int]] = set()
0056:     arrows: list[tuple[int, list[tuple[int, int]]]] = []
0057:     for col in colors_present(g, exclude={bg}):
0058:         for coords in components_mask(g == int(col), connectivity=4):
0059:             pts = [(int(r), int(c)) for r, c in coords]
0060:             if is_arrow_pts(pts):
0061:                 arrows.append((int(col), pts))
0062:                 arrow_cells |= set(pts)
0063: 
0064:     wall_cells: set[tuple[int, int]] = {
0065:         (int(r), int(c)) for r, c in np.argwhere(g != int(bg)) if (int(r), int(c)) not in arrow_cells
0066:     }
0067: 
0068:     out = g.copy()
