0017: def main(grid: np.ndarray) -> np.ndarray:
0018:     """
0019:     Copy the solid foreground rectangle that has the fewest internal marker pixels.
0020: 
0021:     Input structure
0022:     - The input has a background and several separated 4-connected foreground rectangles.
0023:     - Each rectangle is mostly one fill color, with marker pixels of other foreground colors.
0024: 
0025:     Rule
0026:     - Crop every solid foreground rectangle.
0027:     - Count a rectangle's markers as the pixels that differ from its unique dominant fill color.
0028:     - Return the crop of the single rectangle with the smallest marker count.
0029: 
0030:     Key insight
0031:     - The wanted object is selected by marker sparsity, not by size, position, or marker color.
0032:     """
0033:     g = np.asarray(grid, dtype=int)
0034:     assert g.ndim == 2, "expected a 2D grid"
0035: 
0036:     bg = get_bg(g)
0037:     objects = find_components(g, bg=bg, connectivity=4, monochromatic=False)
0038:     assert objects, "expected at least one foreground rectangle"
0039: 
0040:     scored: list[tuple[int, np.ndarray]] = []
0041:     for obj in objects:
0042:         crop = crop_bbox(g, obj["bbox"])
0043:         assert int(obj["area"]) == int(crop.size), "expected each foreground object to fill its bbox"
0044: 
0045:         fill, fill_count = _unique_dominant_color(crop)
0046:         assert fill != bg, "object fill must be foreground"
0047:         marker_count = int(crop.size) - fill_count
0048:         scored.append((marker_count, crop))
0049: 
0050:     min_markers = min(marker_count for marker_count, _ in scored)
0051:     winners = [crop for marker_count, crop in scored if marker_count == min_markers]
0052:     assert len(winners) == 1, "expected a unique rectangle with the fewest markers"
0053:     return winners[0]
0054: 
