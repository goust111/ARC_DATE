+def _inject_defects(perfect: np.ndarray, tile: np.ndarray, defect_count: int) -> np.ndarray:
+    pr, pc = tile.shape
+    noisy = perfect.copy()
+    palette = tuple(sorted(set(int(v) for v in tile.ravel())))
+    assert len(palette) >= 2
+
