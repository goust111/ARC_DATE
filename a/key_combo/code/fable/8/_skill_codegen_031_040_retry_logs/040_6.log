+    r0, c0, r1, c1 = b0
+    rr0, cc0, rr1, cc1 = b1
+    return (
+        r1 + pad < rr0
+        or rr1 + pad < r0
+        or c1 + pad < cc0
+        or cc1 + pad < c0
+    )
+
