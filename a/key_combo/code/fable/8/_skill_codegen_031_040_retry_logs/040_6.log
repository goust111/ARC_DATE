0015: def main(input_grid):
0016:     """
0017:     Count red 2x2 squares and mark that count in a fixed blue 3x3 pattern.
0018: 
0019:     Input structure:
0020:     - The input is a square black grid containing separated 2x2 red squares.
0021:     - Up to five red squares may be present.
0022:     - The output is always a 3x3 black grid.
0023: 
0024:     Rule:
0025:     - Detect all connected red square objects.
0026:     - Count how many red squares are present.
0027:     - Fill that many positions in the fixed blue order: corners by alternating columns with the center between them.
0028: 
0029:     Key insight:
0030:     - The output ignores the locations of the red squares and encodes only their count
0031:       along a predetermined sparse 3x3 sequence.
0032:     """
0033:     # Detect all the 2 x 2 red squares on the grid.
0034:     red_square = detect_objects(grid=input_grid, colors=[Color.RED], monochromatic=True, connectivity=4, background=Color.BLACK)
0035: 
0036:     # Count the number of 2 x 2 red squares.
0037:     num_red_square = len(red_square)
0038: 
0039:     # Output grid is always 3 x 3.
0040:     output_grid = np.zeros((3, 3), dtype=int)
0041: 
0042:     # Fill the output grid with red square number follow specific pattern sequence:
0043:     # 1. Fill the top row, then the next row, but skip every other column.
0044:     # 2. Begin the first/third/fifth/etc row in the first column, but begin the second/forth/etc row in the second column.
0045:     # Fill order inferred from training pairs:
0046:     # (0,0), (0,2), (1,1), (2,0), (2,2)
0047:     pos_list = [(0, 0), (0, 2), (1, 1), (2, 0), (2, 2)]
0048: 
0049:     # Place the same number of 1 x 1 blue squares on the output grid follow the specific pattern sequence.
0050:     for i in range(num_red_square):
0051:         r, c = pos_list[i]
0052:         output_grid[r, c] = Color.BLUE
0053:         
0054:     return  output_grid
0055: 
