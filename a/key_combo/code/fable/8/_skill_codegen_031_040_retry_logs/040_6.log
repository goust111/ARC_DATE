+            r0 = random.randint(1, H - h - 1)
+            c0 = random.randint(1, W - w - 1)
+            box = (int(r0), int(c0), int(r0 + h - 1), int(c0 + w - 1))
+            if all(_boxes_are_separated(box, other, pad=1) for other in placed_boxes):
