0024: def main(grid: np.ndarray) -> np.ndarray:
0025:     """
0026:     Draw a polyline by decoding 3x3 glyph instructions read across a divided grid.
0027: 
0028:     Input structure:
0029:     - Left of a full-height vertical divider: 3x3 colored glyphs on bg.
0030:     - Right of divider: a single gray (5) start pixel.
0031: 
0032:     Rule:
0033:     - Remove the divider; shift the gray start into the left canvas.
0034:     - Read glyphs in column-major order (left→right, top→bottom).
0035:     - Each glyph's shape (pixel area) encodes a segment: area 4 → down 2, area 5 → right 3, area 6 → left 4, area 7 → left 2.
0036:     - Append segments sequentially, stepping down one cell between each.
0037: 
0038:     Key insight: Glyph pixel count (area) uniquely determines both segment length and direction — the shape itself is the instruction.
0039:     """
0040:     g = np.array(grid, dtype=int)
0041:     H, W = g.shape
0042:     bg = int(get_bg(g))
0043: 
0044:     # Divider is a full-height constant non-bg column.
0045:     div_c, div_color = find_full_height_constant_col(g, bg=bg)
0046:     assert div_c is not None
0047: 
0048:     out = np.zeros((H, int(div_c)), dtype=int)
0049: 
0050:     # Move gray start from right side into left canvas (remove divider col too).
0051:     gray = np.argwhere(g == 5)
0052:     if gray.size == 0:
0053:         return out
0054:     r_cur, c_cur = map(int, gray[0])
0055:     c_cur = int(c_cur - (int(div_c) + 1))
0056:     if not (0 <= c_cur < int(div_c)):
0057:         return out
0058:     out[int(r_cur), int(c_cur)] = 5
0059: 
0060:     # Collect 3x3 glyph components on the left.
0061:     left = g[:, : int(div_c)]
0062:     ignore = {int(bg), 5}
0063:     if div_color is not None:
0064:         ignore.add(int(div_color))
0065: 
