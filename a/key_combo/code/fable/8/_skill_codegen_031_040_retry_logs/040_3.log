+        inp, _expected = pair
+        sig = hashlib.md5(inp.tobytes() + str(inp.shape).encode()).hexdigest()
+        if sig in _SEEN_INPUT_SIGNATURES:
+            continue
+        _SEEN_INPUT_SIGNATURES.add(sig)
+        return inp
