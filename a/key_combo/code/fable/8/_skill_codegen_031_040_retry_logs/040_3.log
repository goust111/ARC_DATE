+        b = comp["bbox"]
+        assert b is not None
+        r0, c0, r1, c1 = map(int, b)
+        assert (r1 - r0 + 1, c1 - c0 + 1) == (3, 3), "glyphs must occupy a 3x3 bbox"
+        patch = crop_bbox(g, b)
+        direction = _decode_direction(patch, bg)
+        length = int(comp["area"])
+        glyphs.append(
+            {
+                "bbox": b,
+                "coords": comp["coords"].astype(int),
+                "direction": direction,
+                "length": length,
+                "color": color,
+            }
