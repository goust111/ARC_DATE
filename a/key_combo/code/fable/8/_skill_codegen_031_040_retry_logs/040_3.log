        elif n_rects == MID_RECT_COUNT and random.random() < MID_RECT_PROB:
            side_limit = MID_RECT_SIDE_MAX
        h, w = _gen_dims_for_markers(marker_count, side_limit)
        rect_specs.append((h, w, marker_count))
