+        glyph = glyphs[scores[0][1]]
+        if glyph["direction"] != direction or glyph["length"] != length:
+            return False
+        dr, dc = DIRS[direction]
+        current = (int(current[0] + dr * length), int(current[1] + dc * length))
+        used.add(scores[0][1])
