+
+    built = _build_grid_from_layout(H, W, pair_layouts)
+    if built is None:
+        return None
+    grid, doors = built
+
+    if not _validate_instance(grid, doors, require_red):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
