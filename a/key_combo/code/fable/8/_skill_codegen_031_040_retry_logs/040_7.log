+
+            dr, dc, gap_r, gap_c = bg_neighbors[0]
+            ext_r, ext_c = int(r + 2 * dr), int(c + 2 * dc)
+            if not in_bounds(g.shape, ext_r, ext_c) or int(g[ext_r, ext_c]) != bg:
+                continue
+
+            ok = True
+            frame_cells: list[tuple[int, int]] = []
+            for rr in range(r - 1, r + 2):
