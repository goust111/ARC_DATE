+            continue
+        seen[r, c] = True
+        for dr, dc in moves:
+            nr, nc = int(r + dr), int(c + dc)
+            if in_bounds(grid.shape, nr, nc) and not seen[nr, nc]:
+                stack.append((nr, nc))
+    return seen
