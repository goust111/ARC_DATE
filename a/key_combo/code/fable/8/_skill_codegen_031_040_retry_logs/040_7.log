+        return [[]]
+    first = indices[0]
+    out: list[list[tuple[int, int]]] = []
+    for i in range(1, len(indices)):
+        second = indices[i]
+        rest = indices[1:i] + indices[i + 1 :]
+        for tail in _pairings(rest):
+            out.append([(int(first), int(second)), *tail])
+    return out
+
