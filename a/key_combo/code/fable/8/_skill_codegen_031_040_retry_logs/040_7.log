+                else:
+                    fg_neighbors.append(value)
+
+            if len(bg_neighbors) != 1 or len(fg_neighbors) != 3:
+                continue
+            if len(set(fg_neighbors)) != 1:
+                continue
+
+            frame_color = int(fg_neighbors[0])
+            if frame_color == core_color:
