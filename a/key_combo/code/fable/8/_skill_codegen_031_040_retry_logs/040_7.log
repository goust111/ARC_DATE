+def _sign(value: int) -> int:
+    if value > 0:
+        return 1
+    if value < 0:
+        return -1
+    return 0
+
+
+def _randint_or_none(lo: int, hi: int) -> int | None:
+    lo = int(lo)
+    hi = int(hi)
+    if lo > hi:
+        return None
+    return int(random.randint(lo, hi))
