+def _corridor_mask(grid: np.ndarray, start: tuple[int, int], end: tuple[int, int], bg: int) -> np.ndarray:
+    if start == end:
+        out = np.zeros_like(grid, dtype=bool)
+        out[start] = True
+        return out
