+def _render_output(grid: np.ndarray, pairs: list[tuple[dict, dict]]) -> tuple[np.ndarray, list[np.ndarray], np.ndarray]:
+    g = np.asarray(grid, dtype=int)
+    bg = int(get_bg(g))
+    counts = np.zeros_like(g, dtype=int)
+    full_masks: list[np.ndarray] = []
