+    row_step = _sign(int(end[0]) - int(start[0]))
+    col_step = _sign(int(end[1]) - int(start[1]))
+    moves: list[tuple[int, int]] = []
+    if row_step:
+        moves.append((int(row_step), 0))
+    if col_step:
+        moves.append((0, int(col_step)))
+    assert moves, "start and end must differ"
