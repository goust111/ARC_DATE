+
+    pairs = [
+        [((r1, c1), (1, 0)), ((r3, c3), (0, -1))],
+        [((r2, c0), (0, 1)), ((r4, c2), (-1, 0))],
+    ]
+    return pairs, True
+
+
+def _scenario_rect_plus_line_separate(H: int, W: int) -> tuple[list[list[tuple[tuple[int, int], tuple[int, int]]]], bool] | None:
+    if H < 16 or W < 16:
+        return None
+
+    r1 = _randint_or_none(3, H // 3)
+    if r1 is None:
+        return None
+    r2 = _randint_or_none(r1 + 3, H // 2 + 1)
+    if r2 is None:
+        return None
+    c1 = _randint_or_none(3, W // 3)
