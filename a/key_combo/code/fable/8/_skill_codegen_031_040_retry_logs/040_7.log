+        "gap": gap,
+        "ext": (int(ext_r), int(ext_c)),
+        "dir": (int(dr), int(dc)),
+        "core_color": int(core_color),
+        "frame_color": int(frame_color),
+        "frame_cells": tuple(footprint),
+    }
