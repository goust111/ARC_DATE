+def _reachable(grid: np.ndarray, bg: int, start: tuple[int, int], moves: list[tuple[int, int]], bounds: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = bounds
+    seen = np.zeros_like(grid, dtype=bool)
+    stack = [start]
+    while stack:
+        r, c = stack.pop()
+        if seen[r, c]:
+            continue
+        if not (r0 <= r <= r1 and c0 <= c <= c1):
+            continue
