+            occupied |= block
+            forbidden = _expand8(occupied)
+            placed = True
+            break
+        if not placed:
+            return None
+    return grid
+
+
+def _semantic_checks(inp: np.ndarray) -> bool:
+    if inp.ndim != 2 or max(inp.shape) > 30:
+        return False
+    if set(map(int, np.unique(inp))) != {BLACK, GREY}:
+        return False
