+def _patch_from_coords(coords: list[tuple[int, int]]) -> np.ndarray:
+    arr = np.array(coords, dtype=int)
+    arr -= arr.min(axis=0)
+    h, w = arr.max(axis=0) + 1
+    patch = np.zeros((int(h), int(w)), dtype=bool)
+    patch[arr[:, 0], arr[:, 1]] = True
+    return patch
