{
  "type": "move_to_match",
  "src": "small colored template region s",
  "dst": "large monochrome mask region d",
  "match_cond": "d.mask == block-scaled 90-degree-clockwise rotation of s.foreground_mask",
  "transform": "replace each mask-color pixel in d with the corresponding color from the rotated, block-scaled s; preserve all other pixels"
}
</annotation>
<generation_spec>
