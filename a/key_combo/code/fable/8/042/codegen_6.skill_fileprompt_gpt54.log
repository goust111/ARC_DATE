+        grid = _place_components(patches, shape)
+        if grid is not None:
+            return grid
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
+        inp = _build_candidate()
+        if inp is not None and _semantic_checks(inp):
