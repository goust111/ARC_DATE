+def _gray_components(grid: np.ndarray) -> list[np.ndarray]:
+    g = np.asarray(grid, dtype=int)
+    mask = g == GREY
+    visited = np.zeros(mask.shape, dtype=bool)
+    components: list[np.ndarray] = []
+    for r, c in np.argwhere(mask):
