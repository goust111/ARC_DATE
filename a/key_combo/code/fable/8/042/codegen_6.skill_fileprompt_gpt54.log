+def _place_components(patches: list[np.ndarray], shape: tuple[int, int]) -> np.ndarray | None:
+    h, w = shape
+    grid = np.full((h, w), BLACK, dtype=int)
+    occupied = np.zeros((h, w), dtype=bool)
+    forbidden = np.zeros((h, w), dtype=bool)
+    for patch in patches:
