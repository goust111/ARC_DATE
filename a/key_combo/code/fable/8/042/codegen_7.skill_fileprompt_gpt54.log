+    bar_order = [
+        color
+        for color, _bar in sorted(scene["bars"].items(), key=lambda item: (item[1]["col"], item[1]["cells"][0][0]))
+    ]
+    if path_order == bar_order:
+        return False
+
+    changed = np.argwhere(grid != out)
+    if changed.size == 0:
+        return False
+    return True
+
