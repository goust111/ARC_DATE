        second_col = random.randint(first_col + first_size + _GEN_HORIZONTAL_GAP, w - second_size - _GEN_EDGE_PADDING)
        first_row = random.randint(_GEN_EDGE_PADDING, h - first_size - _GEN_EDGE_PADDING)
