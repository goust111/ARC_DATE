+        out_hash = hashlib.md5(expected.tobytes() + str(expected.shape).encode()).digest()
+        _SEEN_OUTPUTS.add(out_hash)
+        return grid
+    raise RuntimeError("failed to generate a valid dock-and-tile puzzle")

