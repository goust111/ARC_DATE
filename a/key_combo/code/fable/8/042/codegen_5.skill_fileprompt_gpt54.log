+
+def _random_composition(total: int, count: int, minimum: int) -> list[int] | None:
+    if total < count * minimum:
+        return None
+    extras = total - count * minimum
+    cuts = sorted(random.sample(range(extras + count - 1), count - 1)) if count > 1 else []
+    parts = []
+    prev = -1
+    for cut in cuts + [extras + count - 1]:
+        parts.append(cut - prev)
+        prev = cut
+    return [part + minimum - 1 for part in parts]
+
+
+def _pick_seeds(h: int, w: int, count: int) -> list[tuple[int, int]] | None:
+    cells = [(r, c) for r in range(h) for c in range(w)]
+    random.shuffle(cells)
+    seeds: list[tuple[int, int]] = []
+    min_dist = 3 if min(h, w) >= 10 else 2
+    for r, c in cells:
+        if all(abs(r - rr) + abs(c - cc) >= min_dist for rr, cc in seeds):
+            seeds.append((r, c))
+            if len(seeds) == count:
+                return seeds
+    return None
+
+
+def _grow_partition(h: int, w: int, count: int) -> np.ndarray | None:
+    total = h * w
+    min_area = max(8, total // (count * 3))
+    targets = _random_composition(total, count, min_area)
+    if targets is None:
+        return None
+    random.shuffle(targets)
+    seeds = _pick_seeds(h, w, count)
+    if seeds is None:
+        return None
+
+    assign = np.full((h, w), -1, dtype=int)
+    areas = [0] * count
+    for idx, (r, c) in enumerate(seeds):
+        assign[r, c] = idx
+        areas[idx] = 1
+
+    while np.any(assign == -1):
+        region_frontiers: list[list[tuple[int, int]]] = [[] for _ in range(count)]
+        for r, c in np.argwhere(assign == -1):
+            region_ids = set()
+            for nr, nc in _neighbors4(int(r), int(c)):
+                if 0 <= nr < h and 0 <= nc < w and assign[nr, nc] >= 0:
+                    region_ids.add(int(assign[nr, nc]))
+            for region_id in region_ids:
+                region_frontiers[region_id].append((int(r), int(c)))
+        active = [idx for idx, frontier in enumerate(region_frontiers) if frontier]
+        if not active:
+            return None
+        weights = []
+        for idx in active:
+            deficit = max(1, targets[idx] - areas[idx])
+            weights.append(deficit)
+        region_id = random.choices(active, weights=weights, k=1)[0]
+        rr, cc = random.choice(region_frontiers[region_id])
+        assign[rr, cc] = region_id
+        areas[region_id] += 1
+    return assign
+
+
+def _region_mask(assign: np.ndarray, region_id: int) -> np.ndarray:
+    return assign == region_id
+
+
+def _mutate_partition(assign: np.ndarray, steps: int) -> None:
+    h, w = assign.shape
+    region_ids = sorted(set(map(int, assign.ravel())))
+    sizes = {rid: int(np.sum(assign == rid)) for rid in region_ids}
+    min_keep = max(6, min(sizes.values()) // 2)
+    for _ in range(steps):
+        boundary = []
+        for r in range(h):
+            for c in range(w):
+                src = int(assign[r, c])
+                nbrs = {int(assign[nr, nc]) for nr, nc in _neighbors4(r, c) if 0 <= nr < h and 0 <= nc < w and int(assign[nr, nc]) != src}
+                if nbrs:
+                    boundary.append((r, c, src, random.choice(sorted(nbrs))))
+        if not boundary:
+            return
+        r, c, src, dst = random.choice(boundary)
+        if sizes[src] <= min_keep:
+            continue
+        src_mask = assign == src
+        src_mask[r, c] = False
+        if not _is_connected(src_mask):
+            continue
+        assign[r, c] = dst
+        sizes[src] -= 1
+        sizes[dst] += 1
+
+
+def _removable_options(mask: np.ndarray) -> list[tuple[int, int]]:
+    coords = np.argwhere(mask)
+    r0, c0, r1, c1 = _bbox(coords)
+    options: list[tuple[int, int]] = []
+    for r, c in coords:
+        r = int(r)
+        c = int(c)
+        if r in (r0, r1) or c in (c0, c1):
+            continue
+        count = 0
+        vertical = False
+        horizontal = False
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < mask.shape[0] and 0 <= nc < mask.shape[1] and mask[nr, nc]:
+                count += 1
+                if nr != r:
+                    vertical = True
+                if nc != c:
+                    horizontal = True
+        if count < 3 or not vertical or not horizontal:
+            continue
+        shrunk = mask.copy()
+        shrunk[r, c] = False
+        if not _is_connected(shrunk):
+            continue
+        options.append((r, c))
+    return options
+
+
+def _build_output_partition() -> tuple[np.ndarray, list[np.ndarray], list[int], list[tuple[int, int]]] | None:
+    for _ in range(120):
+        interior_h = random.randint(8, 14)
+        interior_w = random.randint(9, 16)
+        count = random.choice((2, 3, 3, 4))
+        assign = _grow_partition(interior_h, interior_w, count)
+        if assign is None:
+            continue
+        _mutate_partition(assign, steps=random.randint(20, 45))
+
+        regions = [_region_mask(assign, rid) for rid in range(count)]
+        if any(np.sum(mask) < 8 for mask in regions):
+            continue
+        if any(not _is_connected(mask) for mask in regions):
+            continue
+        if len({_normalize_shape(np.argwhere(mask)) for mask in regions}) != count:
+            continue
+
+        hole_choices = [_removable_options(mask) for mask in regions]
+        if any(not opts for opts in hole_choices):
