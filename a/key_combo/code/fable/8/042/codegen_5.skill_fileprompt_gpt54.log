+from __future__ import annotations
+
+import hashlib
+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+PALETTE = (1, 2, 3, 4, 5, 6, 7, 8, 9)
+MAX_GENERATION_ATTEMPTS = 500
+_SEEN_OUTPUTS: set[bytes] = set()
