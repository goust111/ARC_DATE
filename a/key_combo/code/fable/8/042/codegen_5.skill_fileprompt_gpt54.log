+
+def _is_rectangular_frame(comp: np.ndarray) -> tuple[int, int, int, int] | None:
+    r0, c0, r1, c1 = _bbox(comp)
+    if r1 - r0 < 2 or c1 - c0 < 2:
+        return None
+    coords = {tuple(map(int, rc)) for rc in comp}
+    expected = set()
+    for r in range(r0, r1 + 1):
+        expected.add((r, c0))
+        expected.add((r, c1))
+    for c in range(c0, c1 + 1):
+        expected.add((r0, c))
+        expected.add((r1, c))
