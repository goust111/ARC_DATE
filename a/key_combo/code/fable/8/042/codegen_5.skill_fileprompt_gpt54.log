+def _place_bboxes(canvas_h: int, canvas_w: int, frame_box: tuple[int, int, int, int], sizes: list[tuple[int, int]]) -> list[tuple[int, int]] | None:
+    blocked = np.zeros((canvas_h, canvas_w), dtype=bool)
