+def _pick_seeds(h: int, w: int, count: int) -> list[tuple[int, int]] | None:
+    cells = [(r, c) for r in range(h) for c in range(w)]
+    random.shuffle(cells)
+    seeds: list[tuple[int, int]] = []
+    min_dist = 3 if min(h, w) >= 10 else 2
+    for r, c in cells:
+        if all(abs(r - rr) + abs(c - cc) >= min_dist for rr, cc in seeds):
+            seeds.append((r, c))
+            if len(seeds) == count:
+                return seeds
+    return None
+
