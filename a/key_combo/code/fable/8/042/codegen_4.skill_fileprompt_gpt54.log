+    if _mask_signature(base_mask) != meta["target_mask_sig"]:
+        return False
+    if (small["bbox"][0], small["bbox"][1]) != meta["small_pos"]:
+        return False
+    if (big["bbox"][0], big["bbox"][1]) != meta["big_pos"]:
+        return False
