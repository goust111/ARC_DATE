  21: def main(grid: np.ndarray) -> np.ndarray:
  22:     """
  23:     Recolor the enlarged mask with the small colored template rotated 90 degrees clockwise.
  24: 
  25:     Input structure
  26:     - A background grid contains one small multicolor template and one much larger monochrome mask.
  27:     - The monochrome mask is an integer block scale of the template foreground mask after a 90-degree clockwise rotation.
  28: 
  29:     Rule
  30:     - Rotate the template bbox 90 degrees clockwise, scale each template pixel to the matching block size, and use that scaled template to recolor the large mask pixels.
  31:     - Preserve the original template and all background pixels.
  32: 
  33:     Key insight
  34:     - The large mask gives only the silhouette; the small template supplies the colors once it is rotated and scaled to that silhouette.
  35:     """
  36:     g = np.asarray(grid, dtype=int)
  37:     bg = int(get_bg(g))
  38:     mask_color = _unique_large_foreground_color(g, bg)
  39: 
  40:     target_mask = g == mask_color
  41:     template_mask = (g != bg) & (g != mask_color)
  42:     template_bbox = bbox(template_mask)
  43:     target_bbox = bbox(target_mask)
  44:     assert template_bbox is not None, "expected a colored template"
  45:     assert target_bbox is not None, "expected a large fill mask"
  46: 
  47:     tr0, tc0, tr1, tc1 = template_bbox
  48:     dr0, dc0, dr1, dc1 = target_bbox
  49:     template = g[tr0 : tr1 + 1, tc0 : tc1 + 1]
  50:     assert not np.any(template == mask_color), "template must not use the mask color"
  51: 
  52:     rotated = np.rot90(template, k=-1)
  53:     rot_h, rot_w = rotated.shape
  54:     dest_h, dest_w = bbox_h(target_bbox), bbox_w(target_bbox)
  55:     assert dest_h % rot_h == 0, "target height must be a scaled rotated-template height"
  56:     assert dest_w % rot_w == 0, "target width must be a scaled rotated-template width"
  57:     scale_h = dest_h // rot_h
  58:     scale_w = dest_w // rot_w
  59:     assert scale_h == scale_w and scale_h >= 1, "target must use one square block scale"
  60: 
  61:     scaled = np.kron(rotated, np.ones((scale_h, scale_w), dtype=int))
  62:     expected_mask = scaled != bg
  63:     actual_mask = target_mask[dr0 : dr1 + 1, dc0 : dc1 + 1]
  64:     assert expected_mask.shape == actual_mask.shape
  65:     assert np.array_equal(expected_mask, actual_mask), "target mask must match the rotated scaled template"
  66: 
  67:     out = g.copy()
  68:     out_region = out[dr0 : dr1 + 1, dc0 : dc1 + 1]
  69:     out_region[actual_mask] = scaled[actual_mask]
