+    out = g.copy()
+    region = out[target_r : target_r + th, target_c : target_c + tw]
+    assert not np.any((region != bg) & scaled3), "target 3x placement must be empty in valid inputs"
+    region[scaled3] = int(small["color"])
+    return out
