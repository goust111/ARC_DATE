{
  "type": "move_to_match",
  "src": "small colored template region s",
  "dst": "large monochrome mask region d",
  "match_cond": "d.mask == block-scaled 90-degree-clockwise rotation of s.foreground_mask",
  "transform": "replace each mask-color pixel in d with the corresponding color from the rotated, block-scaled s; preserve all other pixels"
}
</annotation>
<generation_spec>
```yaml
spec:
  grid: 16-24 rows x 12-26 cols
  background: 0
  template:
    shape: square NxN, N in 3-4
    contains_bg: true, fg fill ratio 0.5-0.7 (some cells are bg=0)
    colors: 3-4 distinct non-bg, non-mask colors; colors may repeat within template
    connected_components: 2 fg components [observed]
    no_mask_color: template bbox must not contain the mask color
  mask:
    color: 8 [observed]; must be the most-frequent non-bg color in grid
    shape: block-scaled 90-CW rotation of template; scale S in 2-4, so mask bbox is (S*N)x(S*N)
    structure: each template cell maps to an SxS block; fg cells become mask-color blocks, bg cells stay bg
    connected_components: 2 (inherited from template fg structure) [observed]
  layout:
    template and mask bboxes do not overlap
    both have >=1 cell padding from all grid edges
    separated by >=4 rows or >=7 cols of bg between their bboxes
  output_rule: >
    Rotate template 90-CW, block-scale by S, and replace each mask-color pixel
    with the corresponding color from the scaled rotated template.
    Template and all bg pixels are preserved unchanged.

generation_strategy:
  approach: output-first
  steps:
    1. Pick N in {3,4}, scale S in {2,3,4}. Grid must fit mask (S*N)x(S*N) plus template NxN plus gaps plus padding.
    2. Build template NxN with 3-4 random non-bg, non-8 colors. Place colors so fg ratio is 0.5-0.7 (rest bg). Ensure >=2 fg connected components.
    3. Rotate template 90-CW, block-scale by S to get the mask shape. Record which cells are fg.
    4. Choose grid size large enough for both objects plus padding. Place mask and template in non-overlapping positions with >=1 edge padding each.
    5. Fill mask fg positions with color 8 to build the input grid. Template is placed as-is.
    6. Output is derived by replacing mask-color pixels with colors from the scaled rotated template.
