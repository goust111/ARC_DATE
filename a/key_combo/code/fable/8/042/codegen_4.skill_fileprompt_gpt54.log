+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(g[r, c]) == bg:
+                continue
+            color = int(g[r, c])
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(g[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
