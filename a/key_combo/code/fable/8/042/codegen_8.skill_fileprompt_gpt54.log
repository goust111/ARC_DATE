+    left = random.randint(0, min(OUTER_MARGIN_MAX, 30 - core_w))
+    bottom = random.randint(0, min(OUTER_MARGIN_MAX, 30 - core_h - top))
+    right = random.randint(0, min(OUTER_MARGIN_MAX, 30 - core_w - left))
