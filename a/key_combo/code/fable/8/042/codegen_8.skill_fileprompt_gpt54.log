spec:
  grid: 11-14 rows x 22-26 cols; output same size as input
  frame: 1-cell-wide border of frame_color on all 4 edges + 1 full-height interior divider column
  panels:
    left: between col 1 and divider-1; 1-col bg margin on each side; active area width 4-6 (must be >=4)
    right: between divider+1 and W-2; 1-col bg margin on each side; active area width 11-13 (>=4); entirely bg in input
    right_active_width: >= 2x left_active_width [observed]
  colors:
    frame_color, left_bg, right_bg all distinct; left_bg = 1 [observed]
    run colors distinct from left_bg and right_bg; may equal frame_color
  active_groups: 3-4 groups of 1-2 consecutive identical rows separated by 1-2 blank rows
  runs_per_row: |
    each active row contains 1-2 horizontal runs in the left active area, each of 3 types:
      LEFT  - occupies exactly the 2 leftmost active columns
      RIGHT - occupies exactly the 2 rightmost active columns
      FULL  - spans all active columns (left slot through right slot)
    a row may have LEFT+RIGHT simultaneously (different colors, bg gap between)
  transform: |
    copy each run to the right panel's active area:
      LEFT  -> 2 leftmost cols of right active
      RIGHT -> 2 rightmost cols of right active
      FULL  -> entire right active width (stretched)
    left panel and frame unchanged
generation_strategy:
  approach: output-first
  steps:
    1. Pick 4 distinct colors for frame_color, left_bg(=1), right_bg, plus 1-4 run colors (distinct from left_bg and right_bg).
    2. Choose left_active_width W_L in 4-6; right_active_width W_R in 11-13 (W_R >= 2*W_L).
