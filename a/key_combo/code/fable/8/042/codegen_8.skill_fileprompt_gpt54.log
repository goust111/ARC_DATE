+            continue
+        if any(all(bool(vis[i, pos]) for pos in mismatch_list) for i in range(honest_count)):
+            continue
+        witness_sets = {tuple(np.flatnonzero(vis[:, pos]).tolist()) for pos in mismatch_list}
+        if len(witness_sets) == 1:
+            continue
+        return vis
+    return None
