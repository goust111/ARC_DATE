LEFT_BG = 1
COLOR_IDS = tuple(range(10))
FRAME_COLORS = (0, 2, 3, 4, 5, 6, 7, 8, 9)
MAX_RUN_COLORS = 4
GENERATION_RETRIES = 300

# Canvas, group, and row layout bounds.
LEFT_ACTIVE_WIDTHS = range(4, 7)
RIGHT_ACTIVE_WIDTHS = range(11, 14)
TOTAL_HEIGHTS = (11, 15)
RIGHT_TO_LEFT_MIN_RATIO = 2
FIXED_WIDTH_CELLS = 7
NON_GROUP_ROWS = 4
