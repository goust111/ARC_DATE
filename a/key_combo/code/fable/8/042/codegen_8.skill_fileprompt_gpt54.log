+def _sample_honest_visibility(
+    honest_count: int,
+    area: int,
+    mismatch_positions: set[int],
+) -> np.ndarray | None:
+    min_visible = max(2, honest_count - 2)
+    max_greys_per_copy = max(2, math.ceil(area * 0.45))
+    mismatch_list = sorted(mismatch_positions)
