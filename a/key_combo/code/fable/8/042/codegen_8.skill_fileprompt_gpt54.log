+def _make_sprite(height: int, width: int, colors: list[int]) -> np.ndarray | None:
+    area = height * width
+    assert len(colors) <= area
+    for _ in range(MAX_SPRITE_ATTEMPTS):
+        flat = colors[:] + [random.choice(colors) for _ in range(area - len(colors))]
+        random.shuffle(flat)
