+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid, expected, spec = _build_candidate()
+        sig = hashlib.md5(expected.tobytes() + str(expected.shape).encode()).digest()
