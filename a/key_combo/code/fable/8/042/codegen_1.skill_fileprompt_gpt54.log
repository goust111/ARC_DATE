+    min_h = max_height + 2
+    max_h = min(30, max_height + 8)
+    for _ in range(100):
+        h = random.randint(min_h, max_h)
+        w_min = max(18, 4 * count + 3)
+        w = random.randint(w_min, 30)
+        if _sample_spaced_columns(w, count, gap=4) is not None:
+            return h, w
