+        comp = comps[0]
+        br0, bc0, br1, bc1 = _bbox(comp)
+        assert bc0 == bc1, "bars must be one cell wide"
+        assert int(comp.shape[0]) == br1 - br0 + 1, "bars must be solid vertical segments"
+        bars.append(
+            {
+                "color": int(color),
+                "top": int(br0),
+                "col": int(bc0),
+                "bottom": int(br1),
+                "visible_height": int(br1 - br0 + 1),
+            }
+        )
