+        if _sample_spaced_columns(w, count, gap=4) is not None:
+            return h, w
+    raise RuntimeError("failed to pick canvas dimensions")
+
+
+def _build_candidate() -> tuple[np.ndarray, np.ndarray, dict[str, object]]:
