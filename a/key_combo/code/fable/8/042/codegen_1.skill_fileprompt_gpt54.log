+        "heights": dict(height_by_color),
+        "hidden_color": colors[hidden_idx],
+        "hidden_visible_height": visible_hidden_height,
+        "heights_in_x_order": [height_by_color[colors[i]] for i in np.argsort(x_positions)],
+        "occluder": occ,
