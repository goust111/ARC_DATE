    h, w = occupied.shape
    locs: list[tuple[int, int]] = []
    max_r = h - oh - GEN_FRAME_MARGIN + 1
    max_c = w - ow - GEN_FRAME_MARGIN + 1
    for r in range(GEN_FRAME_MARGIN, max_r):
        for c in range(GEN_FRAME_MARGIN, max_c):
            if not occupied[r : r + oh, c : c + ow].any():
