  "type": "symmetry/pattern",
  "src": "regular block grid separated by black lines; each block is either a two-color sprite or a uniform blank block, with grey pixels as erasures",
  "dst": "same block grid with the two block states swapped",
  "transform": "infer the sprite from fully visible mixed-color blocks; sprite-coded blocks become solid majority-color blocks, blank blocks become the sprite, and separator/erasure pixels become black"
}
</annotation>
<generation_spec>
