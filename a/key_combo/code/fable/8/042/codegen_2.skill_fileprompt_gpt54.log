    counts: list[int] = []
    remaining = int(total)
    for i, cap in enumerate(caps):
        rest = caps[i + 1 :]
        lo = max(1, remaining - sum(rest))
        hi = min(int(cap), remaining - len(rest))
        if lo > hi:
            return None
        count = random.randint(lo, hi)
        counts.append(count)
        remaining -= count
    return counts if remaining == 0 else None


