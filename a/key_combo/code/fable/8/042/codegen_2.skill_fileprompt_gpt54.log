+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+RED = 2
+BLOCK_SIZE = 3
+
+DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+DIR_TO_OFFSET = {
+    0: (0, 1),
+    1: (1, 2),
+    2: (2, 1),
+    3: (1, 0),
+}
+OFFSET_TO_DIR = {offset: direction for direction, offset in DIR_TO_OFFSET.items()}
