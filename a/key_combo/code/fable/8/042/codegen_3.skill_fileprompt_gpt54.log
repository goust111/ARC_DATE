0007: def main(grid: np.ndarray) -> np.ndarray:
0008:     """Move the diagonal foreground segment to the next longer run along the same up-right diagonal.
0009: 
0010:     Input structure
0011:     The grid has one background color and one foreground color. The foreground pixels form a
0012:     contiguous one-pixel-wide segment on a single anti-diagonal.
0013: 
0014:     Rule
0015:     Erase the current segment. If its columns are c0..c1 and its length is L, draw the same
0016:     color on columns c1+1..c1+L+1 along the same anti-diagonal.
0017: 
0018:     Key insight
0019:     The segment advances past its current upper-right end by one whole segment position, and
0020:     the next segment is one pixel longer than the current one.
0021:     """
0022:     g = np.asarray(grid, dtype=int)
0023:     bg = get_bg(g)
0024:     fg_colors = colors_present(g, exclude={bg})
0025:     assert len(fg_colors) == 1
0026:     fg = fg_colors[0]
0027: 
0028:     coords = np.argwhere(g == fg)
0029:     assert coords.size > 0
0030:     diag_sums = {int(r + c) for r, c in coords}
0031:     assert len(diag_sums) == 1
0032:     diag_sum = next(iter(diag_sums))
0033: 
0034:     cols = sorted(int(c) for _r, c in coords)
0035:     assert cols == list(range(cols[0], cols[-1] + 1))
0036:     length = len(cols)
0037:     out_cols = range(cols[-1] + 1, cols[-1] + length + 2)
0038: 
0039:     out = np.full_like(g, bg)
0040:     for c in out_cols:
0041:         r = diag_sum - c
0042:         assert in_bounds(g.shape, r, c)
0043:         out[r, c] = fg
0044:     return out
