    grid = _build_canonical_scene()
    if grid is None:
        return None
    grid = _apply_random_symmetry(grid)
    return grid if _validate_scene(grid) else None


def generate_input() -> np.ndarray:
    for _ in range(RETRY_LIMIT):
        grid = _gen_attempt()

