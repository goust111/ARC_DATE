        return False

    if np.array_equal(g, solved):
        return False

    changed_markers = 0
    for frame in frames:
        if solved[frame.marker] != g[frame.marker]:
            changed_markers += 1
    if changed_markers != len(frames):
        return False

    wall_cells = {
        cell
        for frame in frames
        for cell in (_border_cells(frame) - {frame.gap})
    }
    for ray in rays:
        if len(ray.path) < 2:
            return False
        if any(cell in wall_cells for cell in ray.path):
            return False
    return True


