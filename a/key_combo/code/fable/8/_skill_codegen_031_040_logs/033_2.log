+def _segments(indices: list[int]) -> list[tuple[int, int]]:
+    if not indices:
+        return []
+    indices = sorted(int(i) for i in indices)
+    spans: list[tuple[int, int]] = []
+    start = end = indices[0]
+    for idx in indices[1:]:
+        if idx == end + 1:
+            end = idx
+        else:
+            spans.append((start, end))
+            start = end = idx
