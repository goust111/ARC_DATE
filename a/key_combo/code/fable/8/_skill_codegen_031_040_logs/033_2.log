+    legend_starts = []
+    if vr0 - legend_len - 1 >= 1:
+        legend_starts.extend(range(1, vr0 - legend_len))
+    if vr1 + legend_len + 2 <= h - 1:
+        legend_starts.extend(range(vr1 + 2, h - legend_len))
+    if not legend_starts:
+        return None
