+def _render_instance(spec: dict) -> tuple[np.ndarray, np.ndarray, dict]:
+    h, w = spec["shape"]
+    bg = int(spec["bg"])
+    barrier = int(spec["barrier"])
+    cycle = list(spec["cycle"])
