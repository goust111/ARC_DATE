+    top = random.randint(0, min(2, h - sh))
+    left = random.randint(0, min(2, w - sw))
+    bottom = h - sh - random.randint(0, min(2, h - sh))
+    right = w - sw - random.randint(0, min(2, w - sw))
+    return [(top, left), (top, right), (bottom, left), (bottom, right)]
+
