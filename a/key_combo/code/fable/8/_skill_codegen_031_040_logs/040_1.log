+        "frame_color": frame_color,
+        "frame_bbox": (r0, c0, r1, c1),
+        "sprite": sprite,
+        "top_view": top_view,
+        "left_view": left_view,
+        "both": both,
+        "top_only": top_only,
+        "left_only": left_only,
+    }
