+    raise RuntimeError("failed to build a nondegenerate sprite")
+
+
+def _rectangles_separated(a: tuple[int, int, int, int], b: tuple[int, int, int, int], gap: int = 0) -> bool:
+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
+    return (
+        ar1 + gap < br0
+        or br1 + gap < ar0
