+                    canvas = np.full(interior_shape, int(bg), dtype=int)
+                    paste(canvas, scaled, y, x, transparent=bg)
+                    top_match = np.array_equal(_top_projection(canvas, bg), top_view)
+                    left_match = np.array_equal(_left_projection(canvas, bg), left_view)
+                    if not top_match and not left_match:
