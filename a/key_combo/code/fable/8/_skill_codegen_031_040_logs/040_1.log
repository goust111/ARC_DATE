+                    if left_match:
+                        left_only.append(cand)
+                    if top_match and left_match:
+                        both.append(cand)
+    return both, top_only, left_only
+
+
+def _is_ring_component(grid: np.ndarray, comp: dict) -> bool:
+    r0, c0, r1, c1 = map(int, comp["bbox"])
+    color = int(comp["color"])
