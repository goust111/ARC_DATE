+        return False
+    if int(comp["area"]) != 2 * (h + w) - 4:
+        return False
+    patch = crop_bbox(grid, comp["bbox"])
+    border = np.zeros_like(patch, dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
