+                if not all(_fits((h, w), pos, size) for pos in positions):
+                    continue
+                left_count = _extension_count((h, w), positions[0], (-step[0], -step[1]), size)
+                right_count = _extension_count((h, w), positions[2], step, size)
+                if left_count + right_count == 0:
