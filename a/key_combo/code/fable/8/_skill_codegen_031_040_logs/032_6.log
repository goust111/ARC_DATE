    for sprite, (r0, c0, h, w) in zip(sprites, quadrants):
        rr = int(rng.integers(r0, r0 + h - SPRITE_SIZE + 1))
        cc = int(rng.integers(c0, c0 + w - SPRITE_SIZE + 1))
        paste(grid, sprite, rr, cc, transparent=BACKGROUND_COLOR)


