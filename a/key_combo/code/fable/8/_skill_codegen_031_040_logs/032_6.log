def _gen_paint_rectangles(grid, rects, *, at_origin):
    for rect in sorted(rects, key=lambda item: item["area"], reverse=True):
        patch = np.full((rect["h"], rect["w"]), rect["color"], dtype=int)
        pos = (0, 0) if at_origin else rect["pos"]
