    r0, c0, r1, c1 = region
    max_height = min(_GEN_MAX_RECT_SIDE, r1 - r0 + 1)
    max_width = min(_GEN_MAX_RECT_SIDE, c1 - c0 + 1)
    return [
        (height, width)
        for height in range(_GEN_MIN_RECT_SIDE, max_height + 1)
        for width in range(_GEN_MIN_RECT_SIDE, max_width + 1)
