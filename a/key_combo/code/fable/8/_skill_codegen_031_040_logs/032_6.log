        (ra, ca, ba), (rb, cb, bb) = _gen_choice(rng, pairs)
        rects[idx_a]["pos"] = (ra, ca)
        rects[idx_a]["bbox"] = ba
        rects[idx_b]["pos"] = (rb, cb)
