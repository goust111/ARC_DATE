+
+_GEN_BG = Color.BLACK
+_GEN_COLORS = tuple(Color.NOT_BLACK)
+_GEN_RECT_COUNTS = (3, 3, 3, 4, 4, 5, 5)
+_GEN_STEP = 6
+_GEN_LATTICE = 3
+_GEN_SIDE_RANGE = (7, 8)
+_GEN_PAD = (1, 2)
+_GEN_MAX_ATTEMPTS = 2000
