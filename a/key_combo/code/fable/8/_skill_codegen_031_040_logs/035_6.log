+def _coords_in_bbox(coords: np.ndarray, box: BBox) -> bool:
+    r0, c0, r1, c1 = map(int, box)
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    return bool(np.any((r0 <= rows) & (rows <= r1) & (c0 <= cols) & (cols <= c1)))
