+    except AssertionError:
+        return False
+    if list(map(int, out[:, 0])) != list(map(int, truth_order)):
+        return False
+
+    if not _heuristics_are_misleading(rects, truth_order):
+        return False
+    return True
+
+
+def _generate_attempt(count: int) -> np.ndarray | None:
+    path = _generate_path(count)
