+    if not _validate_semantics(inp, expected, specs, axis_row, anchor_col, tuple(pattern)):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _attempt_generate()
+        if grid is not None:
