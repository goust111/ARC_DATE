    g = np.asarray(grid, dtype=int)
    h, w = g.shape
    bg = get_bg(g)
    yellow = 4

    arm_counts: Counter[int] = Counter()
    for r, c in np.argwhere(g == yellow):
        r, c = int(r), int(c)
        assert 0 < r < h - 1 and 0 < c < w - 1
        arms = [
            int(g[r - 1, c]),
            int(g[r + 1, c]),
            int(g[r, c - 1]),
            int(g[r, c + 1]),
