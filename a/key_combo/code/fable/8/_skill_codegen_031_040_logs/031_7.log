+        specs.append(spec)
+        blocked_input.update(_expanded(_coords_from_spec(spec, axis_row, corrected=False), (grid_h, grid_w)))
+        blocked_output.update(_expanded(_coords_from_spec(spec, axis_row, corrected=True), (grid_h, grid_w)))
