+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            rr = int(r) + dr
+            cc = int(c) + dc
+            if 0 <= rr < shape[0] and 0 <= cc < shape[1]:
+                out.append((rr, cc))
