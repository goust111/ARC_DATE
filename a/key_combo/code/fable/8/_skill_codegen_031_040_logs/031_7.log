        arm_color = arms[0]
        assert arm_color not in (0, yellow, bg)
        arm_counts[arm_color] += 1

    repeated = [color for color, count in arm_counts.items() if count > 1]
    assert len(repeated) == 1
    return np.array([[repeated[0]]], dtype=int)

