_GEN_MARKER_COLORS = tuple(c for c in _GEN_COLORS if c != _GEN_BRACKET_COLOR)

# Scatter layout: sparse singletons plus a small number of adjacent pairs.
_GEN_SCATTER_TOTAL_RANGE = (16, 32)
_GEN_PAIR_COUNT_RANGE = (2, 6)
_GEN_DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
_GEN_PAIR_DIRS = ((1, 0), (0, 1))

# Scatter color multiplicities.
_GEN_MARKER_SCATTER_COUNT_RANGE = (3, 5)
_GEN_INCLUDE_BRACKET_COLOR_PROB = 0.18
_GEN_MAX_OTHER_COLOR_COUNT = 8

# Generation retry bound.
_GEN_MAX_ATTEMPTS = 300

_GEN_BRACKET_CELLS = frozenset(
    {(r, _GEN_BRACKET_EDGE) for r in range(_GEN_BRACKET_SIZE)}
    | {(_GEN_BRACKET_EDGE, c) for c in range(_GEN_BRACKET_SIZE)}
)
_GEN_SCATTER_CELLS = tuple(
    (r, c)
    for r in range(_GEN_H)
    for c in range(_GEN_W)
    if not (r < _GEN_BRACKET_SIZE and c < _GEN_BRACKET_SIZE)
)
_GEN_SCATTER_SET = frozenset(_GEN_SCATTER_CELLS)
_GEN_BRACKET_TOUCH_CELLS = frozenset(
    (r + dr, c + dc)
    for r, c in _GEN_BRACKET_CELLS
    for dr, dc in _GEN_DIRS4
    if 0 <= r + dr < _GEN_H
    and 0 <= c + dc < _GEN_W
    and (r + dr, c + dc) in _GEN_SCATTER_SET
)


def _gen_neighbors4(cell: tuple[int, int]) -> list[tuple[int, int]]:
    r, c = cell
    return [
        (r + dr, c + dc)
        for dr, dc in _GEN_DIRS4
        if 0 <= r + dr < _GEN_H and 0 <= c + dc < _GEN_W
    ]


def _gen_is_clear_scatter_cell(
    cell: tuple[int, int],
    occupied: set[tuple[int, int]],
) -> bool:
    return cell not in occupied and all(n not in occupied for n in _gen_neighbors4(cell))


def _gen_pair_candidates(
    occupied: set[tuple[int, int]],
) -> list[tuple[tuple[int, int], tuple[int, int]]]:
    candidates = []
    for a in _GEN_SCATTER_CELLS:
        ar, ac = a
        for dr, dc in _GEN_PAIR_DIRS:
            b = (ar + dr, ac + dc)
            if b not in _GEN_SCATTER_SET:
                continue
            if not _gen_is_clear_scatter_cell(a, occupied):
                continue
            if not _gen_is_clear_scatter_cell(b, occupied):
                continue
            candidates.append((a, b))
    return candidates


def _gen_single_candidates(
    occupied: set[tuple[int, int]],
) -> list[tuple[int, int]]:
    return [
        cell
        for cell in _GEN_SCATTER_CELLS
        if _gen_is_clear_scatter_cell(cell, occupied)
    ]


def _gen_scatter_cells(total_pixels: int) -> list[tuple[int, int]] | None:
    min_pairs, max_pairs = _GEN_PAIR_COUNT_RANGE
    pair_count = random.randint(min_pairs, min(max_pairs, total_pixels // 2))
    occupied: set[tuple[int, int]] = set()
    cells: list[tuple[int, int]] = []

    for _ in range(pair_count):
        candidates = _gen_pair_candidates(occupied)
        if not candidates:
            return None
        pair = random.choice(candidates)
        occupied.update(pair)
        cells.extend(pair)

    for _ in range(total_pixels - 2 * pair_count):
        candidates = _gen_single_candidates(occupied)
        if not candidates:
            return None
        cell = random.choice(candidates)
        occupied.add(cell)
        cells.append(cell)

    random.shuffle(cells)
    return cells


def _gen_color_counts(total_pixels: int, marker_color: int) -> dict[int, int]:
    marker_count = random.randint(*_GEN_MARKER_SCATTER_COUNT_RANGE)
    other_colors = [c for c in _GEN_COLORS if c not in (marker_color, _GEN_BRACKET_COLOR)]
    include_bracket_color = random.random() < _GEN_INCLUDE_BRACKET_COLOR_PROB

    counts = {marker_color: marker_count}
    for color in other_colors:
        counts[color] = 1
    if include_bracket_color:
        counts[_GEN_BRACKET_COLOR] = 1

    remaining = total_pixels - sum(counts.values())
    recipients = other_colors + ([_GEN_BRACKET_COLOR] if include_bracket_color else [])
    while remaining > 0:
        eligible = [color for color in recipients if counts[color] < _GEN_MAX_OTHER_COLOR_COUNT]
        color = random.choice(eligible)
        counts[color] += 1
        remaining -= 1
    return counts


def _gen_assign_colors(
    cells: list[tuple[int, int]],
    counts: dict[int, int],
) -> dict[tuple[int, int], int] | None:
    assignments: dict[tuple[int, int], int] = {}
    remaining_cells = list(cells)

    if _GEN_BRACKET_COLOR in counts:
        safe_cells = [
            cell for cell in remaining_cells if cell not in _GEN_BRACKET_TOUCH_CELLS
        ]
        if len(safe_cells) < counts[_GEN_BRACKET_COLOR]:
            return None
        chosen = set(random.sample(safe_cells, counts[_GEN_BRACKET_COLOR]))
        for cell in chosen:
            assignments[cell] = _GEN_BRACKET_COLOR
        remaining_cells = [cell for cell in remaining_cells if cell not in chosen]

    non_bracket_colors = [c for c in counts if c != _GEN_BRACKET_COLOR]
    for color in random.sample(non_bracket_colors, len(non_bracket_colors)):
        chosen = set(random.sample(remaining_cells, counts[color]))
        for cell in chosen:
            assignments[cell] = color
        remaining_cells = [cell for cell in remaining_cells if cell not in chosen]

    return assignments


def _gen_base_grid(marker_color: int) -> np.ndarray:
    grid = np.full(_GEN_SHAPE, _GEN_BG, dtype=int)
    for r, c in _GEN_BRACKET_CELLS:
        grid[r, c] = _GEN_BRACKET_COLOR
    grid[_GEN_MARKER_POS] = marker_color
    return grid


def _gen_expected_output(grid: np.ndarray, marker_color: int) -> np.ndarray:
    expected = grid.copy()
    expected[expected == marker_color] = _GEN_BG
    expected[_GEN_MARKER_POS] = marker_color
    return expected


def _gen_attempt() -> np.ndarray | None:
    marker_color = random.choice(_GEN_MARKER_COLORS)
    grid = _gen_base_grid(marker_color)
    total_pixels = random.randint(*_GEN_SCATTER_TOTAL_RANGE)
    counts = _gen_color_counts(total_pixels, marker_color)
    cells = _gen_scatter_cells(total_pixels)
    if cells is None:
        return None

    assignments = _gen_assign_colors(cells, counts)
from __future__ import annotations
from collections import Counter
import numpy as np
import random
from arc_utils import paste, random_sprite


def main(grid: np.ndarray) -> np.ndarray:
    """
    Decode a stamp map: read templates, markers, and palette from a tiled grid, then render stamps.

    Input structure:
    - Grid divided into K tile columns (each N wide) separated by 1-col dashed separators.
    - Top band (rows 0..N-1): K template masks, one per tile column.
    - Middle band (rows N+1..2N): marker pixels whose color picks a template.
    - Bottom band (rows 2N+2..): K palette swatches giving the output color per template.
    - Separator rows at rows N and 2N+1 (dashed pattern of sep color).

    Rule:
    - Each marker's local position (lr, lc) within its tile column determines which N×N output block to stamp.
    - The marker's color identifies which template to use; the palette recolors the template.

    Key insight: Marker color encodes template index; local position within tile column encodes stamp block.
    """
    g = np.array(grid, dtype=int)
    H, W = g.shape
    counts = Counter(map(int, g.flatten()))
    bg = int(counts.most_common(1)[0][0])
    sep = int(max((cnt, col) for col, cnt in counts.items() if col != bg)[1])

    sep_cols = [c for c in range(W) if (g[:, c] == sep).sum() >= H // 2]
    sep_rows = [r for r in range(H) if (g[r, :] == sep).sum() >= W // 2]
    assert sep_cols and sep_rows

    N = sep_cols[0]
    starts = [0] + [c + 1 for c in sep_cols]
    K = len(starts)

    # Read K templates from the top band
    tcols = []
    tmasks = []
    for st in starts:
        sub = g[0:N, st:st + N]
        vals = {int(v) for v in sub.flat} - {bg, sep}
        assert len(vals) == 1
        col = vals.pop()
        tcols.append(col)
        tmasks.append(sub == col)
    assert len(set(tcols)) == K
    tcol_to_j = {col: j for j, col in enumerate(tcols)}

    # Read palette colors from the bottom band
    pal_r0 = sep_rows[-1] + 1
    pcols = []
    for st in starts:
        sub = g[pal_r0:H, st:st + N]
        vals = {int(v) for v in sub.flat} - {bg, sep}
        assert len(vals) == 1
        pcols.append(vals.pop())

    # Read markers from the middle band and build stamp placements
    mid_r0 = N + 1
    out = np.full((N * N, N * N), bg, dtype=int)
    slot_owner = {}

    for st in starts:
        tile_color = None
        for lr in range(N):
            for lc in range(N):
                v = int(g[mid_r0 + lr, st + lc])
                if v == bg or v == sep:
                    continue
                assert tile_color is None or v == tile_color, "tile column must have uniform marker color"
                tile_color = v
                j = tcol_to_j[v]
                assert (lr, lc) not in slot_owner or slot_owner[(lr, lc)] == j, "different templates must occupy different slots"
                slot_owner[(lr, lc)] = j
                tile = np.where(tmasks[j], pcols[j], bg)
                out[lr * N:(lr + 1) * N, lc * N:(lc + 1) * N] = tile

    return out

# --------------- generator (att2) ---------------

# -- CFG: colors --
_BG = 0
_SEP = 5
_AVAILABLE_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]  # all non-bg, non-sep

# -- CFG: grid dimensions --
_N_RANGE = (3, 5)          # tile size
_K_RANGE = (3, 4)          # number of templates
_PAL_H_CHOICES = [2, 3, 4]       # palette band height options
_PAL_H_WEIGHTS = [8, 1, 1]       # probability weights for palette height
_MAX_ROW_PAD = 2           # max trailing bg row padding
_MAX_COL_PAD = 7           # max trailing bg col padding

# -- CFG: template generation --
_DENSITY_RANGE = (0.55, 0.92)    # template pixel density
_SYMMETRY_OPTIONS = [None, "horizontal", "vertical", "mirror", "not_symmetric"]
_TEMPLATE_CONNECTIVITY = 8

# -- CFG: marker placement --
_MIN_SLOT_COVERAGE = 0.60  # minimum fraction of NxN slots filled with markers

# -- CFG: palette swatch --
_SWATCH_DOUBLE_PROB = 0.35  # probability of 2-pixel swatch (vs 1-pixel)

# -- CFG: retry --
_MAX_RETRIES = 300


def _dash_cell(pos: int, n: int) -> bool:
    """True if position `pos` gets a separator pip in the dashed pattern for tile size `n`."""
    k = pos % (n + 1)
    return k == n or k % 2 == 0


def _sep_count(length: int, n: int) -> int:
    """Count how many separator pips appear in a span of `length` cells."""
    return sum(1 for x in range(length) if _dash_cell(x, n))


def _raw_col(tile_col: int, local_c: int, n: int) -> int:
    """Map (tile column index, local column) to absolute grid column."""
    return tile_col * (n + 1) + local_c


def _sample_template(n: int, color: int) -> np.ndarray:
    """Generate a random NxN boolean template mask via random_sprite."""
    sprite = random_sprite(
        n, n,
        density=random.uniform(*_DENSITY_RANGE),
        symmetry=random.choice(_SYMMETRY_OPTIONS),
        color_palette=[color],
        connectivity=_TEMPLATE_CONNECTIVITY,
        background=_BG,
    )
    return sprite == color


def _build_expected(n: int, templates: list[np.ndarray], pcols: list[int],
                    placements: list[tuple[int, int, int]]) -> np.ndarray:
    """Render the expected output grid from stamp placements."""
    expected = np.full((n * n, n * n), _BG, dtype=int)
    for j, rr, cc in placements:
        tile = np.where(templates[j], pcols[j], _BG)
        paste(expected, tile, rr * n, cc * n)
    return expected


def _draw_separators(grid: np.ndarray, n: int, k: int, core_h: int, core_w: int) -> None:
    """Draw dashed horizontal and vertical separator lines in-place."""
    for r in (n, 2 * n + 1):
        for c in range(core_w):
            if _dash_cell(c, n):
                grid[r, c] = _SEP
    for i in range(k - 1):
        c = n + i * (n + 1)
        for r in range(core_h):
            if _dash_cell(r, n):
                grid[r, c] = _SEP


def _gen_attempt() -> np.ndarray | None:
    n = random.randint(*_N_RANGE)
    k = random.randint(*_K_RANGE)
    tcols = random.sample(_AVAILABLE_COLORS, k)
    pcols = random.sample(_AVAILABLE_COLORS, k)

    # Grid dimensions with optional bg padding
    pal_h = random.choices(_PAL_H_CHOICES, weights=_PAL_H_WEIGHTS)[0]
    core_h = 2 * n + 2 + pal_h
    core_w = k * n + (k - 1)
    max_rpad = max(0, min(_MAX_ROW_PAD, 2 * _sep_count(core_h, n) + 1 - core_h))
    max_cpad = max(0, min(_MAX_COL_PAD, 2 * _sep_count(core_w, n) + 1 - core_w))
    h = core_h + random.randint(0, max_rpad)
    w = core_w + random.randint(0, max_cpad)

    templates = [_sample_template(n, col) for col in tcols]

    # Assign random slots to templates for marker placement
    all_slots = [(rr, cc) for rr in range(n) for cc in range(n)]
    random.shuffle(all_slots)
    min_marks = int(np.ceil(_MIN_SLOT_COVERAGE * n * n))
    mark_count = random.randint(min_marks, n * n)
    used_slots = all_slots[:mark_count]
    assign_pool = (list(range(k)) * ((mark_count + k - 1) // k))[:mark_count]
    random.shuffle(assign_pool)
    placements = [(j, rr, cc) for (rr, cc), j in zip(used_slots, assign_pool)]

    expected = _build_expected(n, templates, pcols, placements)

    # Assemble input grid
    grid = np.full((h, w), _BG, dtype=int)
    _draw_separators(grid, n, k, core_h, core_w)

    # Top band: templates
    for j, mask in enumerate(templates):
        paste(grid, np.where(mask, tcols[j], _BG), 0, j * (n + 1))

    # Middle band: markers (shuffled tile-column assignment)
    tile_assign = list(range(k))
    random.shuffle(tile_assign)
    for j, rr, cc in placements:
        grid[n + 1 + rr, _raw_col(tile_assign[j], cc, n)] = tcols[j]

    # Bottom band: palette swatches
    swatch_r = 2 * n + 2 + pal_h - 1
    for j, col in enumerate(pcols):
        start = j * (n + 1)
        size = 2 if random.random() < _SWATCH_DOUBLE_PROB else 1
        c0 = start + max(0, (n - size) // 2)
        grid[swatch_r, c0:c0 + size] = col

    # Oracle check
    try:
        if np.array_equal(main(grid), expected):
            return grid
    except Exception:
        return None
    return None


def generate_input() -> np.ndarray:
    for _ in range(_MAX_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid 65b59efc input")

import numpy as np
from typing import *
from arc_utils import Color, bbox, crop_bbox, draw_line, find_components, first_free_location, paste, random_sprite
import random

# concepts:
# symmetries, objects

# description:
# In the input you will see one or two medium-sized multicolor objects, and some multicolor pixels sprinkled around in one or two clusters
# To make the output, take each of the medium-sized object and move it so that it perfectly covers some of the pixels sprinkled around, matching colors wherever they overlap.
# You can rotate and flip the objects in order to make them fit the pixels, but they have to match colors wherever they overlap.

def main(input_grid):
    """
    Place each large multicolor object over the sparse matching pixels after trying rotations and flips.

    Input structure:
    - The input contains one or two larger multicolor objects on a black background.
    - It also contains small clusters of colored pixels that are partial views of those objects.
    - Objects may need rotation or reflection to align with their pixel guides.

    Rule:
    - Separate large objects from small pixel clusters.
    - Generate rotated and flipped variants of each large object.
    - Choose the placement and variant that covers the most guide pixels without any color mismatch.

    Key insight:
    - The sparse pixels are anchors for transformed copies: color-consistent overlap identifies both
      the orientation and the position of each object.
    """
    # Plan:
    # 1. Break the input into 1-2 big object(s) and a mask containing the remaining pixels
    # 2. For each object, create rotations and flips of it
    # 3. For each object, find the best way to place one of its rotations/flips so that it covers the most number of the pixels (remember the pixel has to match object color)

    # Extract the objects from the input and categorize them into objects and pixels
    # Objects can be multicolored
    connected_components = find_components(input_grid, bg=Color.BLACK, connectivity=4, monochromatic=False, return_format="objects")
    objects = [ cc for cc in connected_components if np.count_nonzero(cc != Color.BLACK) > 4 ]
    pixels = [ cc for cc in connected_components if np.count_nonzero(cc != Color.BLACK) <= 4 ]

    # Make the pixel mask, which shows where the pixels are. These guide the placement of objects.
    pixel_mask = np.full(input_grid.shape, Color.BLACK)
    for pixel_object in pixels:
        paste(pixel_mask, pixel_object, 0, 0, transparent=Color.BLACK, clip=True)
    
    output_grid = np.full(input_grid.shape, Color.BLACK)
    
    # For each object, find the best way to place it so that it covers the most number of the pixels
    for obj in objects:
        # The object can be rotated and flipped to match the pixels
        # First, convert it to a sprite before transforming, because these operations are independent of position
        _b = bbox(obj != Color.BLACK)
        assert _b is not None
        sprite = crop_bbox(obj, _b)
        sprite_variations = [sprite, np.rot90(sprite), np.rot90(sprite, 2), np.rot90(sprite, 3), np.flipud(sprite), np.fliplr(sprite), np.flipud(np.rot90(sprite)), np.fliplr(np.rot90(sprite))]

        # We are going to optimize the position and variation, so we need to keep track of the best placement so far
        best_output, best_pixels_covered = None, 0
        for r, c, sprite_variation in [(r, c, variant) for r in range(input_grid.shape[0]) for c in range(input_grid.shape[1]) for variant in sprite_variations]:
            test_grid = np.copy(output_grid)
            paste(test_grid, sprite_variation, r, c, transparent=Color.BLACK, clip=True)
            # Check if there was any color mismatch: A colored pixel in the mask which is different from what we just made
            # If there is a mismatch, we can't place the object here
            if np.any((pixel_mask != Color.BLACK) & (test_grid != Color.BLACK) & (pixel_mask != test_grid)):
                continue
            num_covered_pixels = np.count_nonzero((pixel_mask != Color.BLACK) & (test_grid != Color.BLACK))
            if num_covered_pixels > best_pixels_covered:
                best_output, best_pixels_covered = test_grid, num_covered_pixels
        output_grid = best_output

    return output_grid


def generate_input():
    # to make the input, we make random objects
    # we need to make sure that the objects can match with the "sprinkled" pixels, so we make the pixels by placing some objects and then removing some parts of them

    n, m = np.random.randint(10, 20), np.random.randint(10, 20)
    grid = np.full((m, n), Color.BLACK)

    num_objects = np.random.randint(1, 3)
    sprites = [ random_sprite(np.random.randint(3, 6), np.random.randint(3, 6), color_palette=Color.NOT_BLACK, density=0.5)
                for _ in range(num_objects) ]
    sprite_variations = [ [sprite, np.rot90(sprite, k=-1), np.rot90(sprite,-(2)), np.rot90(sprite,-(3)), np.fliplr(sprite), np.flipud(sprite), np.fliplr(np.rot90(sprite, k=-1)), np.flipud(np.rot90(sprite, k=-1))]
                          for sprite in sprites ]
    # Pick a variation for each sprite
    sprite_variations = [ random.choice(variations) for variations in sprite_variations ]
    
    # Remove parts of the sprite to create the "sprinkled" pixels
    # We remove enough of the sprite so that there are only 3 pixels remaining
    # We do this to the variation, which is what is going to be put on the canvas to be matched with
    occluded_sprites = []
    for sprite in sprite_variations:
        occluded_sprite = np.copy(sprite)
        could_be_removed = np.argwhere(occluded_sprite != Color.BLACK)
        np.random.shuffle(could_be_removed)
        for i in range(len(could_be_removed) - 3):
            r, c = could_be_removed[i]
            occluded_sprite[r, c] = Color.BLACK

        occluded_sprites.append(occluded_sprite)

    # place everything on the canvas but make sure that nothing overlaps
    for sprite in sprites + occluded_sprites:
        _loc = first_free_location(grid, sprite, transparent=Color.BLACK, border=2, padding=2, padding_connectivity=8)
        if _loc is None:
            # Retry generation (placement can fail due to padding constraints).
            return generate_input()
        r, c = _loc
        paste(grid, sprite, r, c, transparent=Color.BLACK, clip=True)
    
    return grid     

