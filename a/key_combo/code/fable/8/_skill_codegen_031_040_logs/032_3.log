        return (r0, c0, r0 + span - 1, c1), (r0 + span + gap, c0, r1, c1)
    return (r0, c0, r1, c0 + span - 1), (r0, c0 + span + gap, r1, c1)


def _gen_partition_region(region: tuple[int, int, int, int], count: int) -> list[tuple[int, int, int, int]] | None:
