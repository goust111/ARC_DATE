+
+def _render(specs: list[dict[str, int]]) -> np.ndarray:
+    height = max(spec["r0"] + spec["h"] for spec in specs) + MIN_MARGIN
+    width = max(spec["c0"] + spec["w"] for spec in specs) + MIN_MARGIN
+    grid = np.zeros((height, width), dtype=int)
