+COLOR_POOL = tuple(range(1, 10))
+AREA_TO_DIMS = {
+    9: ((3, 3),),
+    15: ((3, 5), (5, 3)),
+    21: ((3, 7), (7, 3)),
+    25: ((5, 5),),
+    35: ((5, 7), (7, 5)),
