+        row_widths = [sum(spec["w"] for spec in row) + MIN_GAP * (len(row) - 1) for row in rows]
+        min_height = 2 * MIN_MARGIN + sum(row_heights) + MIN_GAP * (row_count - 1)
+        min_width = 2 * MIN_MARGIN + max(row_widths)
