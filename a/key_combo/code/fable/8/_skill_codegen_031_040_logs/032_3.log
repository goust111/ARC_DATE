+
+def _row_composition(total: int, parts: int) -> list[int]:
+    """Random positive composition for assigning rectangles to rows."""
+    if parts == 1:
+        return [int(total)]
+    cuts = sorted(random.sample(range(1, total), parts - 1))
+    out = []
+    prev = 0
+    for cut in cuts + [total]:
