+
+def _render_panel(passable: np.ndarray, bg: int, wall: int, flood: int, flooded: np.ndarray) -> np.ndarray:
+    panel = np.full(passable.shape, wall, dtype=int)
+    panel[passable] = bg
+    panel[flooded] = flood
