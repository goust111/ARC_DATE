+def _assemble_input(panels: list[np.ndarray], separator: int, axis: int) -> np.ndarray:
+    panel_h, panel_w = panels[0].shape
+    count = len(panels)
+    if axis == 1:
+        out = np.full((panel_h, count * panel_w + count - 1), separator, dtype=int)
+        for i, panel in enumerate(panels):
