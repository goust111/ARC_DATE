def _gen_expand_q(q: np.ndarray) -> np.ndarray:
    top = np.concatenate([q, np.fliplr(q)], axis=1)
    return np.concatenate([top, np.flipud(top)], axis=0)


def _gen_set_q_orbit(q: np.ndarray, r: int, c: int, color: int) -> None:
    q[r, c] = color
    q[c, r] = color


