        changed = False
        for r0 in range(_GEN_GRID_SIZE - _GEN_OCCLUDER_SIZE + 1):
            for c0 in range(_GEN_GRID_SIZE - _GEN_OCCLUDER_SIZE + 1):
                patch = scene[r0 : r0 + _GEN_OCCLUDER_SIZE, c0 : c0 + _GEN_OCCLUDER_SIZE]
                color = int(patch[0, 0])
                if np.all(patch == color):
