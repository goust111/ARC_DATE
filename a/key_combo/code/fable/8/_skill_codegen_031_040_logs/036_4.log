        coords = [(int(r), int(c)) for r, c in np.argwhere(q == color) if counts[color] > _GEN_MIN_COLOR_CELLS_TO_REPAINT]
        if not coords:
            return
        r, c = random.choice(coords)
        _gen_set_q_orbit(q, r, c, bg)


