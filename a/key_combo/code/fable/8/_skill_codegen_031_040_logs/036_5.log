+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _full_perimeter(bbox: BBox) -> list[Coord]:
+    r0, c0, r1, c1 = bbox
+    cells: list[Coord] = []
+    for c in range(c0, c1 + 1):
+        cells.append((r0, c))
+        cells.append((r1, c))
+    for r in range(r0 + 1, r1):
+        cells.append((r, c0))
+        cells.append((r, c1))
+    return cells
+
+
+def _side_of_gap(bbox: BBox, rc: Coord) -> str:
+    r0, c0, r1, c1 = bbox
+    r, c = rc
+    if r == r0:
+        return "top"
+    if r == r1:
+        return "bottom"
+    if c == c0:
+        return "left"
+    if c == c1:
+        return "right"
