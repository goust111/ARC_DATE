+    outside_non_bg[r1 + 1 :, :] = g[r1 + 1 :, :] != bg
+    outside_non_bg[r0 : r1 + 1, :c0] = g[r0 : r1 + 1, :c0] != bg
+    outside_non_bg[r0 : r1 + 1, c1 + 1 :] = g[r0 : r1 + 1, c1 + 1 :] != bg
