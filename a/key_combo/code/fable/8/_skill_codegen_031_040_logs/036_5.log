+        assert pixel[0] not in {gap[0] for gap in filler_gaps if _side_of_gap(bbox, gap) in ("left", "right")}
+        assert pixel[1] not in {gap[1] for gap in filler_gaps if _side_of_gap(bbox, gap) in ("top", "bottom")}
