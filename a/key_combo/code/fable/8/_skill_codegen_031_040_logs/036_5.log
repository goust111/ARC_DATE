+        coord_set = {tuple(map(int, rc)) for rc in coords}
+        if not coord_set <= perim:
+            continue
+        if any((corner not in coord_set) for corner in ((r0, c0), (r0, c1), (r1, c0), (r1, c1))):
+            continue
+        missing = len(perim) - len(coord_set)
