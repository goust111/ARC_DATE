+    reserved_outside: set[Coord] = set()
+    blocked_subset = random.sample(aligned_gaps, k=random.randint(1, len(aligned_gaps)))
+    if len(aligned_gaps) >= 2 and len(blocked_subset) == len(aligned_gaps):
