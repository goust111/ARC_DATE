+        "bg": bg,
+        "frame_color": frame_color,
+        "bbox": bbox,
+        "aligned_gaps": [gap for _side, gap in aligned_gaps],
+        "filler_gaps": [gap for _side, gap in filler_gaps],
+        "exit_pixels": exit_pixels,
+        "stray_pixels": stray_pixels,
+        "blocked_gaps": set(blockers),
