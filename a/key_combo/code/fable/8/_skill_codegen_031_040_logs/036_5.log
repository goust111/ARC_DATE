+
+MIN_GRID = 16
+MAX_GRID = 30
+MIN_FRAME_H = 7
+MAX_FRAME_H = 15
+MIN_FRAME_W = 7
+MAX_FRAME_W = 15
+MAX_ATTEMPTS = 500
+
+
+def _render_frame(grid: np.ndarray, bbox: BBox, color: int) -> None:
+    r0, c0, r1, c1 = bbox
