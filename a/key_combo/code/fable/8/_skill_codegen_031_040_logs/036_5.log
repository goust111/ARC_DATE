+    stray_count = random.randint(1, min(3, max(1, (fh - 2) * (fw - 2) - len(occupied))))
+    stray_pixels: list[tuple[Coord, int]] = []
+    for pixel in _candidate_stray_cells(bbox, gap_rows, gap_cols, occupied)[:stray_count]:
