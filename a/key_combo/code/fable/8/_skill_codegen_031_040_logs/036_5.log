+    frame_color = random.choice(list(range(1, 10)))
+
+    fh = random.randint(MIN_FRAME_H, min(MAX_FRAME_H, h - 4))
+    fw = random.randint(MIN_FRAME_W, min(MAX_FRAME_W, w - 4))
