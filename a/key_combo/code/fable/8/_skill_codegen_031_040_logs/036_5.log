+
+def _available_side_positions(start: int, stop: int, used: set[int]) -> list[int]:
+    vals = [v for v in range(start, stop + 1) if v not in used]
+    random.shuffle(vals)
+    return vals
+
+
+def _pick_gap_set(bbox: BBox) -> tuple[list[tuple[str, Coord]], list[tuple[str, Coord]]]:
+    r0, c0, r1, c1 = bbox
+    used_rows: set[int] = set()
+    used_cols: set[int] = set()
+
+    row_sides = ["left", "right"]
+    col_sides = ["top", "bottom"]
+    aligned_count = random.randint(2, 4)
+    filler_count = random.randint(1, 3)
+    total = aligned_count + filler_count
+
+    choices: list[tuple[str, Coord]] = []
+    for _ in range(total):
+        horizontal_possible = len(_available_side_positions(r0 + 1, r1 - 1, used_rows)) > 0
+        vertical_possible = len(_available_side_positions(c0 + 1, c1 - 1, used_cols)) > 0
+        assert horizontal_possible or vertical_possible
+        if horizontal_possible and vertical_possible:
+            use_row = random.random() < 0.5
+        else:
+            use_row = horizontal_possible
+        if use_row:
+            row = _available_side_positions(r0 + 1, r1 - 1, used_rows)[0]
+            used_rows.add(row)
+            side = random.choice(row_sides)
+            coord = (row, c0 if side == "left" else c1)
+        else:
+            col = _available_side_positions(c0 + 1, c1 - 1, used_cols)[0]
+            used_cols.add(col)
+            side = random.choice(col_sides)
+            coord = (r0 if side == "top" else r1, col)
+        choices.append((side, coord))
+
+    random.shuffle(choices)
+    aligned_gaps = choices[:aligned_count]
+    filler_gaps = choices[aligned_count:]
+    return aligned_gaps, filler_gaps
+
+
+def _candidate_cells_for_gap(
+    bbox: BBox,
+    gap: Coord,
+    forbidden_rows: set[int],
+    forbidden_cols: set[int],
+    occupied: set[Coord],
+) -> list[Coord]:
+    r0, c0, r1, c1 = bbox
+    side = _side_of_gap(bbox, gap)
+    cells: list[Coord] = []
+    if side in ("left", "right"):
+        row = gap[0]
+        for c in range(c0 + 1, c1):
+            rc = (row, c)
+            if rc in occupied or c in forbidden_cols:
+                continue
+            cells.append(rc)
+    else:
+        col = gap[1]
+        for r in range(r0 + 1, r1):
+            rc = (r, col)
+            if rc in occupied or r in forbidden_rows:
+                continue
+            cells.append(rc)
+    random.shuffle(cells)
+    return cells
+
+
+def _candidate_stray_cells(
+    bbox: BBox, forbidden_rows: set[int], forbidden_cols: set[int], occupied: set[Coord]
+) -> list[Coord]:
+    r0, c0, r1, c1 = bbox
+    cells = [
+        (r, c)
+        for r in range(r0 + 1, r1)
+        for c in range(c0 + 1, c1)
+        if (r, c) not in occupied and r not in forbidden_rows and c not in forbidden_cols
+    ]
+    random.shuffle(cells)
+    return cells
+
+
+def _place_blocker(
+    grid: np.ndarray,
+    bbox: BBox,
+    gap: Coord,
+    color: int,
+    reserved: set[Coord],
+) -> tuple[int, int, int, int] | None:
+    h, w = grid.shape
+    (sr, sc), (dr, dc) = _ray_start_and_step(bbox, gap)
+    path: list[Coord] = []
+    rr, cc = sr, sc
+    while _in_bounds(grid.shape, rr, cc):
+        path.append((rr, cc))
+        rr += dr
+        cc += dc
+    if len(path) < 2:
+        return None
+
+    anchors = path[1:].copy()
+    random.shuffle(anchors)
+    for blocker_anchor in anchors:
+        for _ in range(12):
+            bh = random.randint(1, 3)
+            bw = random.randint(1, 3)
+            if dr == 0:
+                row_lo = max(0, blocker_anchor[0] - bh + 1)
+                row_hi = min(blocker_anchor[0], h - bh)
+                if row_lo > row_hi:
+                    continue
+                br0 = random.randint(row_lo, row_hi)
+                br1 = br0 + bh - 1
+                if dc < 0:
+                    bc1 = blocker_anchor[1]
+                    bc0 = bc1 - bw + 1
+                else:
+                    bc0 = blocker_anchor[1]
+                    bc1 = bc0 + bw - 1
+            else:
+                col_lo = max(0, blocker_anchor[1] - bw + 1)
+                col_hi = min(blocker_anchor[1], w - bw)
+                if col_lo > col_hi:
+                    continue
+                bc0 = random.randint(col_lo, col_hi)
+                bc1 = bc0 + bw - 1
+                if dr < 0:
+                    br1 = blocker_anchor[0]
+                    br0 = br1 - bh + 1
+                else:
+                    br0 = blocker_anchor[0]
+                    br1 = br0 + bh - 1
+
+            if br0 < 0 or bc0 < 0 or br1 >= h or bc1 >= w:
+                continue
+            cells = {(r, c) for r in range(br0, br1 + 1) for c in range(bc0, bc1 + 1)}
