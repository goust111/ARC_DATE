   8: def main(grid: np.ndarray) -> np.ndarray:
   9:     """Return the color that appears as the arm color of the repeated yellow-centered plus marker.
  10: 
  11:     Input structure
  12:     A noisy grid contains several plus-shaped markers: a yellow center pixel
  13:     with four orthogonally adjacent pixels of one shared non-background color.
  14: 
  15:     Rule
  16:     Count the arm color of each yellow-centered plus marker and output the
  17:     unique color that occurs on more than one marker as a 1x1 grid.
  18: 
  19:     Key insight
  20:     The surrounding noise is irrelevant; the duplicated marked plus motif
  21:     identifies the answer color.
  22:     """
  23:     g = np.asarray(grid, dtype=int)
  24:     h, w = g.shape
  25:     bg = get_bg(g)
  26:     yellow = 4
  27: 
  28:     arm_counts: Counter[int] = Counter()
  29:     for r, c in np.argwhere(g == yellow):
  30:         r, c = int(r), int(c)
  31:         assert 0 < r < h - 1 and 0 < c < w - 1
  32:         arms = [
  33:             int(g[r - 1, c]),
  34:             int(g[r + 1, c]),
  35:             int(g[r, c - 1]),
  36:             int(g[r, c + 1]),
  37:         ]
  38:         assert len(set(arms)) == 1
  39:         arm_color = arms[0]
  40:         assert arm_color not in (0, yellow, bg)
  41:         arm_counts[arm_color] += 1
  42: 
  43:     repeated = [color for color, count in arm_counts.items() if count > 1]
  44:     assert len(repeated) == 1
