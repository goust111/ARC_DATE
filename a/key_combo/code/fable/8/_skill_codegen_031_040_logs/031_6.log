 350:     vertical = random.random() < 0.5
 351:     thick = random.randint(THICK_MIN, THICK_MAX)
 352:     if vertical:
 353:         H = random.randint(GRID_MIN, GRID_MAX)
 354:         W = random.randint(max(GRID_MIN, thick + OUTER_GAP), GRID_MAX)
 355:         dh, dw = H, thick
