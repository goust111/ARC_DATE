 357:     else:
 358:         H = random.randint(max(GRID_MIN, thick + OUTER_GAP), GRID_MAX)
 359:         W = random.randint(GRID_MIN, GRID_MAX)
 360:         dh, dw = thick, W
 361:         tr0, tc0 = (0 if random.random() < 0.5 else H - thick), 0
 362:     long = dh if vertical else dw
