/bin/bash -lc "python - <<'PY'
from importlib.machinery import SourceFileLoader
from pathlib import Path
import numpy as np

p = Path('/home/lixinyu/snap/a/key_combo/code/fable/8/031/6.py')
mod = SourceFileLoader('new_arc_task_extra', str(p)).load_module()
edge = 0
internal = 0
for _ in range(120):
    grid = mod.generate_input()
    info = mod._solve_instance(grid)
    cavity = info['cavity_mask']
    touches = bool(cavity[0,:].any() or cavity[-1,:].any() or cavity[:,0].any() or cavity[:,-1].any())
    if touches:
        edge += 1
    else:
        internal += 1
    assert len(info['fragments']) == 5
    assert len([f for f in info['fragments'] if int(f['area']) == int(info['cavity_area'])]) == 1
print('edge', edge, 'internal', internal)
assert edge > 0 and internal > 0
