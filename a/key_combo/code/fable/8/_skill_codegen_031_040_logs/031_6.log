   1: from __future__ import annotations
   2: 
   3: import numpy as np
   4: 
   5: from arc_utils import bbox_coords, colors_present, components_mask, crop_bbox, find_components, get_bg, paste, random_free_location
   6: import math
   7: import random
   8: 
   9: def main(grid: np.ndarray) -> np.ndarray:
  10:     """
  11:     Fill rectangular cavities in a template shape by placing source sprites into matching holes.
  12: 
  13:     Input structure:
  14:     - bg = most common color. A dominant "base" color forms a large frame/template with rectangular gaps.
  15:     - Small colored sprites sit outside the template region.
  16: 
  17:     Rule:
  18:     - The base color (largest connected component excluding bg) defines the template bbox.
  19:     - Each rectangular hole inside the template matches exactly one outside sprite by size.
  20:     - Place each sprite into its matching cavity; output is the filled template bbox.
  21: 
  22:     Key insight: Sprite bounding boxes match cavity dimensions exactly — it's a jigsaw-fit puzzle where each piece has a unique slot.
  23:     """
  24:     g = np.array(grid, dtype=int)
  25:     bg = int(get_bg(g))
  26: 
  27:     # --- pick base color by largest CC size (excluding bg) ---
  28:     base_candidates: list[tuple[int, int]] = []
  29:     for col in colors_present(g, exclude={bg}):
  30:         max_area = 0
  31:         for coords in components_mask(g == int(col), connectivity=8):
  32:             max_area = max(int(max_area), int(coords.shape[0]))
  33:         base_candidates.append((int(max_area), int(col)))
  34: 
  35:     assert base_candidates
  36:     base_candidates.sort(reverse=True)
  37:     if len(base_candidates) > 1:
  38:         assert base_candidates[0][0] > base_candidates[1][0]
  39:     base_col = int(base_candidates[0][1])
  40: 
  41:     # --- destination bbox = bbox of all base-color pixels ---
  42:     base_coords = np.argwhere(g == int(base_col))
  43:     assert not (base_coords.size == 0)
  44:     r0, c0, r1, c1 = bbox_coords(base_coords)
  45:     dst_bbox = (int(r0), int(c0), int(r1), int(c1))
  46: 
  47:     dst = crop_bbox(g, dst_bbox)
  48:     dh, dw = map(int, dst.shape)
  49:     hole_mask = dst != int(base_col)
  50: 
  51:     out = np.full((dh, dw), int(base_col), dtype=int)
  52: 
  53:     # --- source sprites = connected components of non-bg pixels outside dst_bbox ---
  54:     masked = g.copy()
  55:     masked[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1] = int(bg)
  56:     sprite_comps = find_components(masked, bg=bg, connectivity=8, monochromatic=False, return_format="dict")
  57: 
  58:     sprites: list[dict] = []
  59:     for comp in sprite_comps:
  60:         b = tuple(map(int, comp["bbox"]))
  61:         pr0, pc0, pr1, pc1 = b
  62:         patch = crop_bbox(g, b)
  63:         ph, pw = map(int, patch.shape)
  64:         m = np.zeros((ph, pw), dtype=bool)
  65:         coords = comp["coords"]
  66:         m[coords[:, 0] - pr0, coords[:, 1] - pc0] = True
  67:         sprites.append({"h": int(ph), "w": int(pw), "mask": m, "patch": patch})
  68: 
  69:     # Larger sprites first; search for a non-overlapping packing.
  70:     sprites.sort(key=lambda s: (-int(s["h"] * s["w"]), -int(s["mask"].sum())))
  71: 
  72:     # --- candidate placements per sprite: any all-hole rectangle of same bbox ---
  73:     candidates: list[list[tuple[int, int]]] = []
  74:     areas = [int(s["h"] * s["w"]) for s in sprites]
  75:     assert sum(areas) == int(hole_mask.sum())
  76:     for sp in sprites:
  77:         h, w = int(sp["h"]), int(sp["w"])
  78:         pos: list[tuple[int, int]] = []
  79:         if h <= dh and w <= dw:
  80:             for rr0 in range(int(dh - h + 1)):
  81:                 for cc0 in range(int(dw - w + 1)):
  82:                     if bool(hole_mask[rr0 : rr0 + h, cc0 : cc0 + w].all()):
  83:                         pos.append((int(rr0), int(cc0)))
  84:         candidates.append(pos)
  85: 
  86:     assert all(candidates)
  87:     used = ~hole_mask  # base pixels are treated as already occupied
  88:     placement: list[tuple[int, int] | None] = [None] * len(sprites)
  89: 
  90:     def dfs(i: int) -> bool:
  91:         if i == len(sprites):
  92:             return True
  93: 
  94:         h, w = int(sprites[i]["h"]), int(sprites[i]["w"])
  95:         for rr0, cc0 in candidates[i]:
  96:             if bool(used[rr0 : rr0 + h, cc0 : cc0 + w].any()):
  97:                 continue
  98:             used[rr0 : rr0 + h, cc0 : cc0 + w] = True
  99:             placement[i] = (int(rr0), int(cc0))
 100:             if dfs(i + 1):
 101:                 return True
 102:             placement[i] = None
 103:             used[rr0 : rr0 + h, cc0 : cc0 + w] = False
 104:         return False
 105: 
 106:     assert dfs(0)
 107: 
 108:     # --- paste according to the exact cover placement ---
 109:     for i, pos in enumerate(placement):
 110:         assert pos is not None
 111:         rr0, cc0 = map(int, pos)
 112:         sp = sprites[i]
 113:         paste(out, sp["patch"], rr0, cc0, mask=sp["mask"], overwrite=True)
 114: 
 115:     return out
 116: 
 117: # --------------- generator (att2) ---------------
 118: 
 119: # ── Configuration ────────────────────────────────────────────────────────
 120: GRID_MIN, GRID_MAX = 15, 25           # grid dimension range
 121: THICK_MIN, THICK_MAX = 7, 10          # template strip thickness
 122: OUTER_GAP = 8                         # min outer-region width for sprite placement
 123: SPRITE_COUNT_MIN, SPRITE_COUNT_MAX = 7, 15
 124: DOT_MIN, DOT_MAX = 1, 4               # 1x1 black marker sprites
 125: DOT_NON_DOT_BUFFER = 6                # total - dots >= this
 126: DOT_LONG_BUFFER = 4                   # total - dots <= long - this
 127: HOLE_FRAC_LO, HOLE_FRAC_HI = 0.39, 0.50  # hole area as fraction of template
 128: CORRIDOR_COVERAGE = 0.78              # min fraction of long dim covered by holes
 129: MAX_RECT_LEN = 8                      # max single rect dimension along long axis
 130: MAX_RECT_WIDTH = 6                    # max rect width (cross axis)
 131: MIN_SHAPE_GROUPS = 3                  # reject if fewer distinct (h,w) groups
 132: MIN_PALETTE_SIZE = 5                  # min sprite colors (excluding bg, base)
 133: BICHROMATIC_FRAC = 0.3                # fraction of shape-groups with 2 colors
 134: WIDTH_TOLERANCE = 2                   # near-optimal tolerance for width selection
 135: MAX_RETRIES = 300                     # outer retry limit
 136: 
