 138: def _split_lengths(total: int, count: int) -> list[int] | None:
 139:     """Partition *total* into *count* positive integers, each <= MAX_RECT_LEN."""
 140:     if count <= 0 or count > total or count * MAX_RECT_LEN < total:
 141:         return None
 142:     lengths = [1] * count
 143:     remaining = total - count
 144:     while remaining:
 145:         choices = [i for i, v in enumerate(lengths) if v < MAX_RECT_LEN]
 146:         if not choices:
 147:             return None
 148:         i = random.choice(choices)
 149:         add = random.randint(1, min(remaining, MAX_RECT_LEN - lengths[i]))


