+    col_min_total = sum(2 if color in shared_set else 1 for color in top_order) + len(top_order) - 1
+
+    field_h_lo = max(9, row_min_total)
+    field_w_lo = max(9, col_min_total)
+    field_h_hi = min(29, max(field_h_lo, row_min_total + 10))
