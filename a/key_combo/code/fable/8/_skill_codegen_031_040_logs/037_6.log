+    if not np.all(out[0, :] == grid[0, :]):
+        return False
+    if not np.all(out[:, 0] == grid[:, 0]):
+        return False
+    if not np.all(out[1:, 1:][grid[1:, 1:] != bg] == grid[1:, 1:][grid[1:, 1:] != bg]):
+        return False
+    return True
+
