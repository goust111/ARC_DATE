+            outputs.append(
+                _render_from_placements(
+                    shape,
+                    bg,
+                    sprite,
+                    shortcut_placements,
+                    axis_is_horizontal,
+                    **kwargs,
+                )
+            )
+        except AssertionError:
+            continue
