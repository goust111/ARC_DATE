+    )
+    if any(np.array_equal(out, wrong) for wrong in shortcuts):
+        return None
+
+    marker_pair = _place_markers_on_bg(out, (diag[0] + axis[0], diag[1] + axis[1]), marker_color)
+    if marker_pair is None:
+        return None
+    p, q = marker_pair
