+    except AssertionError:
+        return None
+    if not np.array_equal(actual, out):
+        return None
+
+    if details["diag"] != diag or details["axis"] != axis:
+        return None
+    if details["origin"] != origin:
+        return None
+    if not any(m == 1 for m, _, _, _ in details["placements"]):
+        return None
+    if not any(n != 0 for _, n, _, _ in details["placements"]):
+        return None
+    return inp, out
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(_MAX_ATTEMPTS):
+        case = _build_case()
+        if case is not None:
+            return case[0]
