+        rest_mask = (grid != bg) & (grid != color)
+        if len(_components(rest_mask, connectivity=8)) != 1:
+            continue
+        dr = int(coords[1, 0] - coords[0, 0])
+        dc = int(coords[1, 1] - coords[0, 1])
+        if dr == 0 or dc == 0 or abs(dr) == abs(dc):
