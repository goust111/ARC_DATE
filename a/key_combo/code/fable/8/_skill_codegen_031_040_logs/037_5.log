+
+def _render_shortcuts(
+    shape: tuple[int, int],
+    bg: int,
+    sprite: np.ndarray,
+    origin: Coord,
+    diag: Coord,
+    axis: Coord,
+    axis_is_horizontal: bool,
+    placements: list[tuple[int, int, int, int]],
