+    placements = _enumerate_lattice((grid_h, grid_w), origin, sprite.shape, diag, axis)
+    placement_pairs = {(m, n) for m, n, _, _ in placements}
+    if not all(pair in placement_pairs for pair in template):
+        return None
+    if len(placements) < 5:
