+    r_hi = min(h_lim - sr for sr, _ in shifts)
+    c_lo = max(-sc for _, sc in shifts)
+    c_hi = min(w_lim - sc for _, sc in shifts)
+    if r_lo > r_hi or c_lo > c_hi:
