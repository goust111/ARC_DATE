+
+def _all_bg_neighborhood(grid: np.ndarray, r: int, c: int) -> bool:
+    r0 = max(0, r - 1)
+    r1 = min(grid.shape[0], r + 2)
+    c0 = max(0, c - 1)
+    c1 = min(grid.shape[1], c + 2)
