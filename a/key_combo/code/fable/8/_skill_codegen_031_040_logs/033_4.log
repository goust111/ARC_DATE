+    boxes = []
+    for out_r0 in range(out_r0_min, out_r0_max + 1):
+        for out_c0 in range(out_c0_min, out_c0_max + 1):
+            out_bbox = (out_r0, out_c0, out_r0 + h - 1, out_c0 + w - 1)
+            in_bbox = (
+                out_r0 - k * dr,
+                out_c0 - k * dc,
+                out_r0 - k * dr + h - 1,
+                out_c0 - k * dc + w - 1,
+            )
+            boxes.append((out_bbox, in_bbox))
