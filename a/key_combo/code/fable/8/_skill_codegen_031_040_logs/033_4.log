+def _expand_bbox(b: _BBox, gap: int, shape: tuple[int, int]) -> _BBox:
+    h, w = shape
+    return (
+        max(0, b[0] - gap),
+        max(0, b[1] - gap),
+        min(h - 1, b[2] + gap),
+        min(w - 1, b[3] + gap),
+    )
