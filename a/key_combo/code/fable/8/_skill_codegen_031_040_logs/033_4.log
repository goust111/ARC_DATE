+        r0, c0, r1, c1 = map(int, spec["in_bbox"])
+        color = int(spec["color"])
+        patch = np.full((r1 - r0 + 1, c1 - c0 + 1), color, dtype=int)
+        mark_r = 0 if int(spec["dr"]) == -1 else patch.shape[0] - 1
+        mark_c = 0 if int(spec["dc"]) == -1 else patch.shape[1] - 1
