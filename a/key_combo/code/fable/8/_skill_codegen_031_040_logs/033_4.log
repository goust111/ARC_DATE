    return (a0, a1), (b0, b0 + b_len - 1)


def _color_sequence(count: int, palette: list[int]) -> list[int]:
    if len(palette) == 1:
        return [palette[0]] * count
    seq = palette[:]
    random.shuffle(seq)
    while len(seq) < count:
        seq.append(random.choice(palette))
    random.shuffle(seq)
    return seq


