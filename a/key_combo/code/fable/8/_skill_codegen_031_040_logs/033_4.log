GEN_COLORS = np.array([1, 2, 3, 4, 5, 6, 7, 9], dtype=int)
BACKGROUND_COLOR, MARKER_COLOR, ARC_COLOR_COUNT = 0, 8, 10

# Canvas and paired-marker layout bounds.
