+    out_r0_max = rows - h - k if dr == -1 else rows - h
+    out_c0_min = 0 if dc == -1 else k
+    out_c0_max = cols - w - k if dc == -1 else cols - w
+    if out_r0_min > out_r0_max or out_c0_min > out_c0_max:
+        return []
