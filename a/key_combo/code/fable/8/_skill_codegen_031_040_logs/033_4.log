    spine = random.randint(V_SPINE_MIN, w - V_SPINE_RIGHT_MARGIN)
    max_extra = min(VERTICAL_EXTRA_MAX, 2 * h)
    extra = random.randint(BARRIER_EXTRA_MIN, max_extra)
