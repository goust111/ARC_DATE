 108:     # Fill the other regions with corrupted versions that have pixels randomly set to black
 109:     for i in range(0, m, square_len + 1):
 110:         for j in range(0, n, square_len + 1):
 111:             # are we the top-left region?
 112:             if i == 0 and j == 0:
 113:                 paste(grid, template_sprite, i + 1, j + 1, transparent=Color.BLACK, clip=True)
 114:                 continue
 115: 
 116:             # otherwise: Create a corrupted version of the pattern; randomly set some pixels to black
 117:             corrupted_sprite = template_sprite.copy()
 118:             for r, c in np.argwhere(corrupted_sprite != Color.BLACK):
 119:                 if random.choice([0, 1]) == 0:
 120:                     corrupted_sprite[r, c] = Color.BLACK
 121:             # Place the sprite on the grid, remain a black border around the sprite
 122:             paste(grid, corrupted_sprite, i + 1, j + 1, transparent=Color.BLACK, clip=True)
 123:     
 124:     return grid
