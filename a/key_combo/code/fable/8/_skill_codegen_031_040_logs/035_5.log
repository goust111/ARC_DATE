+    full = bool(np.all(sprite != bg))
+    mask_local = np.zeros(block.shape, dtype=bool)
+    mask_local[r0 : r1 + 1, c0 : c1 + 1] = block[r0 : r1 + 1, c0 : c1 + 1] != bg
+
+    if len(colors) == 1 and full:
