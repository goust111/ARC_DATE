  69:             hits.append((r, c))
  70:             break
  71:         r += ray_dr
  72:         c += ray_dc
  73:     assert len(hits) == 1
  74: 
  75:     out = g.copy()
  76:     hit_r, hit_c = hits[0]
  77:     out[hit_r, hit_c] = bg
  78:     return out
