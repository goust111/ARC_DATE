+
+
+BG = 0
+PALETTE = tuple(range(1, 10))
+RNG = np.random.default_rng()
+USED_SIGNATURES: set[bytes] = set()
+
+
+def _classify_block(block: np.ndarray, bg: int) -> dict:
+    mask = block != bg
+    b = bbox(mask)
