+def _draw_rect(block_h: int, block_w: int) -> np.ndarray:
+    rect_h_lo = 2 if block_h >= 4 else 1
+    rect_w_lo = 2 if block_w >= 4 else 1
+    rect_h = int(RNG.integers(rect_h_lo, block_h + 1))
+    rect_w = int(RNG.integers(rect_w_lo, block_w + 1))
