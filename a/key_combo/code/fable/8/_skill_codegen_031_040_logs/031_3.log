+                arm_color = center_color
+            elif random.random() < 0.65:
+                arm_color = random.choice(rect_colors)
+            else:
+                arm_color = random.choice(arm_palette)
+            placed = _place_marker(grid, center_color, arm_color, PLUS_DIRS)
+            if placed is None:
+                return None
+            markers.append(placed)
