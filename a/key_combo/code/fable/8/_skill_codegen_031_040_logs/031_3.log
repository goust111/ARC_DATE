        connectivity=4,
        monochromatic=True,
        return_format="dict",
    )
    assert objects, "expected at least one foreground object"

    out = g.copy()
    for obj in objects:
        coords = obj["coords"]
        mask = np.zeros(g.shape, dtype=bool)
        mask[coords[:, 0], coords[:, 1]] = True
