+    return candidates
+
+
+def _build_scene() -> dict | None:
+    h = random.randint(GRID_MIN, GRID_MAX)
+    w = random.randint(GRID_MIN, GRID_MAX)
+    n_rect = random.choice([3, 4])
+
+    core_h = random.randint(*CORE_SIZE_RANGE)
+    core_w = random.randint(*CORE_SIZE_RANGE)
