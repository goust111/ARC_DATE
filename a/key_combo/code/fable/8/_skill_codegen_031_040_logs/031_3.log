+    if np.array_equal(rect_input, expected):
+        return False
+    if scene["input_order"] == scene["output_order"]:
+        return False
+    if len({int(rect["votes"]) for rect in rects}) != len(rects):
+        return False
+    if not any(marker["complete"] for marker in markers):
