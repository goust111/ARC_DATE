+from __future__ import annotations
+
+from collections import Counter
+import itertools
+import random
+
+import numpy as np
+
+
+ORTH4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+PLUS_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+RECT_COLORS = tuple(range(1, 10))
