+            bbox = tuple(rect["bbox"])
+            full_area = (bbox[2] - bbox[0] + 1) * (bbox[3] - bbox[1] + 1)
+            visible_mask = rect_input == color
+            if not _visible_bbox_matches(visible_mask, bbox):
+                ok = False
