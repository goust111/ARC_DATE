+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in ORTH4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
