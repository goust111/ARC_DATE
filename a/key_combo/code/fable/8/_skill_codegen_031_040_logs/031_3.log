+    core_h = random.randint(*CORE_SIZE_RANGE)
+    core_w = random.randint(*CORE_SIZE_RANGE)
+    core_r0 = random.randint(8, h - core_h - 9)
+    core_c0 = random.randint(8, w - core_w - 9)
