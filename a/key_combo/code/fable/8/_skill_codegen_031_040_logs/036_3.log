+    crop = _crop_bbox(g, box)
+    crop_mask = _crop_bbox(noise_mask.astype(int), box).astype(bool)
+    out = np.zeros_like(crop)
+    out[crop_mask] = crop[crop_mask]
+    return out, noise_mask
