+def _launcher_cells(
+    bend_r: int,
+    bend_c: int,
+    direction: int,
+    vertical_dir: int,
+    long_len: int,
+    short_len: int,
+) -> list[tuple[int, int]]:
+    cells = {(bend_r, bend_c)}
+    for i in range(1, long_len + 1):
+        cells.add((bend_r, bend_c + direction * i))
+    for i in range(1, short_len + 1):
+        cells.add((bend_r + vertical_dir * i, bend_c))
+    return sorted(cells)
