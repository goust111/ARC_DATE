+        return False
+
+    if "boundary" not in stop_reasons or "obstacle" not in stop_reasons:
+        return False
+
+    total_ray = sum(len(item["ray"]) for item in launchers)
+    if total_ray < 12:
+        return False
+
+    expected_out = _render_output(inp, launchers)
+    actual_out = main(inp)
