+) -> tuple[list[dict], np.ndarray] | None:
+    occupied = grid != 0
+    platforms: list[dict] = []
+    target = random.randint(*PLATFORM_COUNT_RANGE)
+    attempts = 0
+    while len(platforms) < target and attempts < 240:
