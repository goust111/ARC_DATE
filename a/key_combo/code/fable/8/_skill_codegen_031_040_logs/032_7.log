+    return np.rot90(np.asarray(grid, dtype=int), -turns)
+
+
+def find_components(mask: np.ndarray) -> list[dict]:
+    seen = np.zeros(mask.shape, dtype=bool)
+    components: list[dict] = []
+    height, width = mask.shape
+    for r in range(height):
+        for c in range(width):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if 0 <= nr < height and 0 <= nc < width and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            coords_arr = np.asarray(coords, dtype=int)
+            components.append(
+                {
+                    "coords": coords_arr,
+                    "area": int(len(coords)),
+                    "bbox": bbox(coords_arr[:, 0] * 0 + 1 if False else _coords_to_mask_bbox(coords_arr)),
+                }
+            )
+    return components
