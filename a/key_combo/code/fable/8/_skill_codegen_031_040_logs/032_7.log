+    for r in range(0, h, factor):
+        for c in range(0, w, factor):
+            block = patch[r : r + factor, c : c + factor]
+            color = int(block[0, 0])
+            assert np.all(block == color), "scaled sprite blocks must be uniform"
+            out[r // factor, c // factor] = color
