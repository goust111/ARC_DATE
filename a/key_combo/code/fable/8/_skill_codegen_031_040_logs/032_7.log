+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
+    return ar1 + gap < br0 or br1 + gap < ar0 or ac1 + gap < bc0 or bc1 + gap < ac0
+
+
+def _place_patches(
+    rng: np.random.Generator, grid_shape: tuple[int, int], patches: list[np.ndarray]
+) -> np.ndarray | None:
+    height, width = map(int, grid_shape)
