+    w = random.randint(*GRID_W_RANGE)
+    bg = random.choice([color for color in PALETTE if color != GREY])
+    seed_colors = random.sample([color for color in PALETTE if color not in {bg, GREY}], 2)
+
+    grid = np.full((h, w), bg, dtype=int)
