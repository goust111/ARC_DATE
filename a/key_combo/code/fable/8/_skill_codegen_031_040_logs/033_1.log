+        else:
+            col_lo, col_hi = right_min, w - 2
+        if col_lo > col_hi:
+            continue
+        if vertical:
+            row_lo, row_hi = 1, h - length - 1
+            if row_lo > row_hi:
+                continue
+            r0 = random.randint(row_lo, row_hi)
+            c0_seg = random.randint(col_lo, col_hi)
+            cells = _segment_cells(r0, c0_seg, 1, 0, length)
