+def _paint_from_distances(
+    grid: np.ndarray,
+    bg: int,
+    seed_cells: list[tuple[int, int, int]],
+    dist_a: np.ndarray,
+    dist_b: np.ndarray,
+) -> tuple[np.ndarray, dict[str, np.ndarray]]:
+    out = np.array(grid, copy=True)
+    bg_mask = grid == bg
