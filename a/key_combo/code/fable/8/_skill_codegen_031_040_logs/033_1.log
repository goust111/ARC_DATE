+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _build_candidate()
+        if _valid_candidate(grid):
+            return grid
+    raise RuntimeError("failed to generate a valid ripple-with-walls input")

