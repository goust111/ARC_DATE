+            col_missing[c].remove(color)
+            search()
+            col_missing[c].add(color)
+            row_missing[r].add(color)
+            board[r, c] = MASK
+            if len(solutions) >= 2:
+                return
+
+    search()
+    return len(solutions), (solutions[0] if len(solutions) == 1 else None)
