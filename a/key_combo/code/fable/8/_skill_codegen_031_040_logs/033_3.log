 129:     plus_lab, pn = label_mask(g == int(plus_col), connectivity=4)
 130:     non_mask = (g != int(bg)) & (g != int(plus_col))
 131:     mark_lab, _mn = label_mask(non_mask, connectivity=4)
 132: 
 133:     for pk in range(1, int(pn) + 1):
 134:         plus_mask = (plus_lab == int(pk))
