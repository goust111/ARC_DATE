+        base_r = margin_a - rr_min * step
+        base_c = margin_b - cc_min * step
+    elif corner == "tr":
+        base_r = margin_a - rr_min * step
+        base_c = (w - margin_b - block_size) - cc_max * step
+    elif corner == "bl":
