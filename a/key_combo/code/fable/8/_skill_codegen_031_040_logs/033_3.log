+        pc = int(legend_base[1] + cc * legend_step)
+        tr0 = int(block_base[0] + rr * block_step)
+        tc0 = int(block_base[1] + cc * block_step)
+        out[pr, pc] = int(color)
+        out[tr0 : tr0 + block_size, tc0 : tc0 + block_size] = int(color)
+    return out
