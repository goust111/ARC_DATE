+def _lattice_step(row_values: list[int], col_values: list[int]) -> int:
+    diffs: list[int] = []
+    for values in (row_values, col_values):
+        uniq = sorted(set(int(v) for v in values))
+        diffs.extend(b - a for a, b in zip(uniq, uniq[1:]) if b > a)
