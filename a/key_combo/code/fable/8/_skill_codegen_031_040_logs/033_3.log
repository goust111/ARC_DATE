+        base_c = margin_b - cc_min * step
+    else:
+        base_r = (h - 1 - margin_a) - rr_max * step
+        base_c = (w - 1 - margin_b) - cc_max * step
+    return int(base_r), int(base_c)
+
+
+def _place_block_base(
+    corner: str,
+    shape: tuple[int, int],
+    rr_min: int,
+    rr_max: int,
+    cc_min: int,
+    cc_max: int,
+    step: int,
+    block_size: int,
+) -> Coord:
+    h, w = map(int, shape)
+    margin_a = random.randint(1, 2)
+    margin_b = random.randint(1, 2)
