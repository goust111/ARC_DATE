+
+def _paint_input(
+    shape: tuple[int, int],
+    bg: int,
+    colors: dict[Coord, int],
+    legend_coords: set[Coord],
+    block_coords: set[Coord],
+    legend_base: Coord,
+    legend_step: int,
+    block_base: Coord,
+    block_step: int,
+    block_size: int,
+) -> np.ndarray:
