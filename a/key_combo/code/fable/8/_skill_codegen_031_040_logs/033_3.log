 104: def main(grid: np.ndarray) -> np.ndarray:
 105:     """
 106:     Extend marker tiles outward from '+' shapes by repeating them to the grid edge.
 107: 
 108:     Input structure:
 109:     - bg = most common color.
 110:     - A dominant non-bg color forms several '+'-shaped objects.
 111:     - Small colored patches (1–few cells) sit adjacent to each arm of a '+'.
 112: 
 113:     Rule:
 114:     - For each marker tile touching a '+', determine which side of the '+' it sits on.
 115:     - Project the tile away from the '+' in that direction, repeating the tile pattern periodically until the grid boundary.
 116:     - '+' pixels are never overwritten.
 117: 
 118:     Key insight: Each marker's attachment side determines its extension direction; the pattern repeats periodically, not as a single copy.
 119:     """
 120:     g = np.array(grid, dtype=int)
 121:     out = g.copy()
 122:     H, W = g.shape
 123: 
 124:     bg = int(get_bg(g))
 125:     plus_col = detect_dominant_big_component_color(g, bg=bg, min_h=3, min_w=3, connectivity=4)
 126:     if plus_col is None:
