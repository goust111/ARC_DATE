 114: def _gen_output(rng: np.random.Generator, num_pairs: int, gap_width: int) -> np.ndarray:
 115:     """Sample the stacked stripe payload later copied between marker pairs."""
 116:     out = np.zeros((MARKER_SIZE * num_pairs, gap_width), dtype=int)
 117:     area = out.size
 118:     density = float(rng.uniform(STRIPE_DENSITY_MIN, STRIPE_DENSITY_MAX))
 119:     count = int(round(area * density))
 120:     count = max(1, min(area, count))
 121:     locs = rng.choice(area, size=count, replace=False)
 122:     out.flat[locs] = rng.choice(GEN_COLORS, size=count, replace=True)
 123:     return out
