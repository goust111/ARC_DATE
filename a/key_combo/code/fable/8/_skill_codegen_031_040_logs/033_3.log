  97: def _gen_row_starts(rng: np.random.Generator, height: int, num_pairs: int) -> list[int] | None:
  98:     """Return top rows for 2-row marker spans with sampled vertical gaps."""
  99:     if num_pairs == 1:
 100:         return [int(rng.integers(0, height - MARKER_SIZE + 1))]
 101:     gaps = rng.integers(ROW_GAP_MIN, ROW_GAP_HIGH, size=num_pairs - 1)
 102:     used_height = MARKER_SIZE * num_pairs + int(gaps.sum())
 103:     extra = height - used_height
 104:     if extra < 0:
 105:         return None
 106: 
 107:     row = int(rng.integers(0, extra + 1))
 108:     starts = [row]
 109:     for gap in gaps:
 110:         row += MARKER_SIZE + int(gap)
 111:         starts.append(row)
 112:     return starts
