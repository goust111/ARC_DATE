 137:     left_options = np.arange(0, width - LEFT_COL_HIGH_MARGIN)
 138:     if len(left_options) < num_pairs:
 139:         return None
 140:     left_cols = rng.choice(left_options, size=num_pairs, replace=False)
 141:     return height, width, num_pairs, gap_width, row_starts, left_cols
