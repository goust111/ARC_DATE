 146:         strip = expected[MARKER_SIZE * i : MARKER_SIZE * i + MARKER_SIZE]
 147:         right_col = col + MARKER_SIZE + gap_width
 148:         grid[row : row + MARKER_SIZE, col : col + MARKER_SIZE] = MARKER_COLOR
 149:         grid[row : row + MARKER_SIZE, col + MARKER_SIZE : right_col] = strip
 150:         grid[row : row + MARKER_SIZE, right_col : right_col + MARKER_SIZE] = MARKER_COLOR
 151:         protected[row : row + MARKER_SIZE, col : right_col + MARKER_SIZE] = True
