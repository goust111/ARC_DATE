 125: def _choose_layout(rng: np.random.Generator):
 126:     """Sample canvas dimensions and pair anchors, or return None if impossible."""
 127:     num_pairs = int(rng.integers(NUM_PAIRS_MIN, NUM_PAIRS_HIGH))
 128:     gap_width = int(rng.integers(GAP_WIDTH_MIN, GAP_WIDTH_HIGH))
 129:     height = int(rng.integers(GRID_HEIGHT_MIN, GRID_HEIGHT_HIGH))
 130:     min_width = max(MIN_GRID_WIDTH, gap_width + MIN_WIDTH_GAP_PADDING, num_pairs + LEFT_COL_HIGH_MARGIN)
 131:     if min_width >= GRID_WIDTH_HIGH:
 132:         return None
 133:     width = int(rng.integers(min_width, GRID_WIDTH_HIGH))
 134:     row_starts = _gen_row_starts(rng, height, num_pairs)
 135:     if row_starts is None:
