+                if mm < 0 or mm >= w or cc > mm:
+                    continue
+                if _in_bbox(rr, cc, occluder_bbox) or _in_bbox(rr, mm, occluder_bbox):
+                    continue
+                if scene[rr, cc] == scene[rr, mm]:
