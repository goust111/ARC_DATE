+
+    if np.array_equal(meta["scene_meta"]["key_mask"], np.fliplr(meta["scene_meta"]["key_mask"])):
+        return False
+
+    cand = meta["candidates"]
+    if not np.array_equal(cand["decoy"]["mask"], np.fliplr(cand["true"]["mask"])):
+        return False
