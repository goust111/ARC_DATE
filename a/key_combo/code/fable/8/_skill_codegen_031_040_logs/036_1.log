+
+def _random_connected_mask(
+    h_range: tuple[int, int],
+    w_range: tuple[int, int],
+    *,
+    min_cells: int,
+    max_cells: int | None = None,
+) -> np.ndarray:
+    for _ in range(300):
+        h = random.randint(*h_range)
+        w = random.randint(*w_range)
+        cap = h * w
+        cell_hi = cap - 1
+        if max_cells is not None:
+            cell_hi = min(cell_hi, max_cells)
+        target = random.randint(min_cells, max(min_cells, cell_hi))
+
+        mask = np.zeros((h, w), dtype=bool)
+        start = (random.randrange(h), random.randrange(w))
+        mask[start] = True
+        cells = {start}
+        frontier = set()
+
+        def add_frontier(r: int, c: int) -> None:
+            for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
+                nr = r + dr
+                nc = c + dc
+                if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc]:
+                    frontier.add((nr, nc))
+
+        add_frontier(*start)
+        while len(cells) < target and frontier:
+            cell = random.choice(tuple(frontier))
+            frontier.remove(cell)
+            mask[cell] = True
+            cells.add(cell)
+            add_frontier(*cell)
+
+        if len(cells) != target:
+            continue
+        if not _mask_connected(mask):
+            continue
+        if not (mask[0].any() and mask[-1].any() and mask[:, 0].any() and mask[:, -1].any()):
+            continue
+        return mask
+    raise RuntimeError("failed to generate a connected mask")
+
