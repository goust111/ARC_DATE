+def _recover_hidden_patch(scene: np.ndarray, occluder_bbox: BBox, axis_k: int) -> np.ndarray:
+    r0, c0, r1, c1 = occluder_bbox
+    mc0 = axis_k - c1
+    mc1 = axis_k - c0
