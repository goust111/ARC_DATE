+    for k in range(0, 2 * (w - 1) + 1):
+        mc0 = k - c1
+        mc1 = k - c0
+        if not (0 <= mc0 <= mc1 < w):
+            continue
+        patch = scene[r0 : r1 + 1, mc0 : mc1 + 1]
+        if np.any(patch == occluder_color):
+            continue
