+
+    placements: dict[int, dict] = {}
+    for idx, mask_idx in enumerate(order):
+        mask = masks[mask_idx]
+        mh, mw = mask.shape
+        color = candidate_colors[idx]
+        placed = False
+        for _ in range(250):
+            r0 = random.randint(0, region_h - mh)
+            c0 = random.randint(0, w - mw)
+            if not _can_place(occupied, mh, mw, r0, c0, pad=1):
