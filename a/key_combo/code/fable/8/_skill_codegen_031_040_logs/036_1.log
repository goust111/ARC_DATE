+    assert b is not None
+    return crop_bbox(mask.astype(bool), b)
+
+
+def _in_bbox(r: int, c: int, b: BBox) -> bool:
+    r0, c0, r1, c1 = b
+    return r0 <= r <= r1 and c0 <= c <= c1
