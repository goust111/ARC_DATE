+def _random_filler_mask() -> np.ndarray:
+    if random.random() < 0.5:
+        h = random.randint(1, 2)
+        w = random.randint(1, 3)
+        return np.ones((h, w), dtype=bool)
+    return _random_connected_mask((2, 3), (2, 4), min_cells=3, max_cells=6)
