+def _random_key_mask() -> np.ndarray:
+    for _ in range(300):
+        mask = _random_connected_mask((3, 5), (3, 6), min_cells=4)
+        if np.array_equal(mask, np.fliplr(mask)):
+            continue
+        return mask
+    raise RuntimeError("failed to generate a non-symmetric key mask")
