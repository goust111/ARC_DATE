+
+    if not _validate_case(inp, out, row_masks, col_colors, row_missing, col_missing, body_present):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
