+
+def _place_brackets(
+    grid: np.ndarray,
+    directions: list[str],
+    marker_colors: list[int],
+) -> list[dict] | None:
+    h, w = grid.shape
+    boxes: list[tuple[int, int, int, int]] = []
+    out: list[dict] = []
+    for direction, marker_color in zip(directions, marker_colors):
+        candidates = []
+        for _ in range(80):
