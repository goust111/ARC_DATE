            missing.append((r, c))
            paste(out, TEAL_PATCH, r, c, transparent=BACKGROUND_COLOR)
    return out, missing


def _gen_attempt() -> "np.ndarray | None":
    lattice = _sample_lattice()
    if lattice is None:
        return None
    out, missing = _build_solved_grid(*lattice)
    if not missing:
