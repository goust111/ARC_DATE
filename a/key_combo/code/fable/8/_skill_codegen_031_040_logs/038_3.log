+    bh = random.randint(4, 6)
+    bw = random.randint(4, 6)
+    r0 = min(r0, h - bh - 2)
+    c0 = min(c0, w - bw - 2)
+    return r0, c0, r0 + bh - 1, c0 + bw - 1
