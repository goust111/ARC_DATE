            paste(out, BLUE_PATCH, r, c, transparent=BACKGROUND_COLOR)

    complete_row = rows[0] if int(np.random.randint(2)) == 0 else rows[-1]
    complete_col = cols[0]
    missing = []
    for r in rows:
        for c in cols:
            if r == complete_row or c == complete_col:
