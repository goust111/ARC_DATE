    no_repeated_colors: bool = False,
) -> np.ndarray:
    """Generate a contiguous sprite of shape (m,n) with random symmetry and palette (for puzzle generation)."""
    if isinstance(m, range):
        m = list(m)
    if isinstance(n, range):
        n = list(n)
