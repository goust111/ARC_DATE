+def _paint_u(grid: np.ndarray, box: tuple[int, int, int, int], direction: str, color: int) -> set[tuple[int, int]]:
+    cells = _u_cells(box, direction)
+    for r, c in cells:
+        grid[r, c] = color
+    return cells
