    row_axis = _gen_axis(n_rows, ROW_GAP_BOUNDS, HEIGHT_BOUNDS)
    col_axis = _gen_axis(n_cols, COL_GAP_BOUNDS, WIDTH_BOUNDS)
    if row_axis is None or col_axis is None:
        return None
    height, rows = row_axis
    width, cols = col_axis
    return height, width, rows, cols


