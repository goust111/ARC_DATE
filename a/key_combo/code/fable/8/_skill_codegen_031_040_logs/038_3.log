+        initials = list(zip(starts, [axis_value] * count))
+    elif direction == "down":
+        finals = [(stop - count + i, axis_value) for i in range(count)]
+        initials = list(zip(starts, [axis_value] * count))
+    elif direction == "left":
+        finals = [(axis_value, stop + 1 + i) for i in range(count)]
+        initials = list(zip([axis_value] * count, starts))
+    else:
