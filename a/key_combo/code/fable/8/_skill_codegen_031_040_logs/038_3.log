+def _lane_candidate_cells(
+    shape: tuple[int, int],
+    direction: str,
+    axis_value: int,
+    stop: int,
+    count: int,
+    starts: list[int],
+) -> tuple[list[tuple[int, int]], list[tuple[int, int]], list[tuple[int, int]]]:
+    h, w = shape
