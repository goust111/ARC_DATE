+                    continue
+                if not (mask[r - 1, c] and mask[r + 1, c] and mask[r, c - 1] and mask[r, c + 1]):
+                    continue
+                trial = mask.copy()
+                trial[r, c] = False
+                if _mask_connected(trial):
+                    removable.append((r, c))
+        if removable:
+            rr, cc = removable[int(rng.integers(len(removable)))]
+            mask[rr, cc] = False
