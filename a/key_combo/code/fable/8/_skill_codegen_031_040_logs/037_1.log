+
+def _solve(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    bg = int(get_bg(g))
+    sprite, sprite_bbox, seed_tile = _locate_sprite(g)
+    tile_h, tile_w = sprite.shape
+    rows, cols = g.shape[0] // tile_h, g.shape[1] // tile_w
