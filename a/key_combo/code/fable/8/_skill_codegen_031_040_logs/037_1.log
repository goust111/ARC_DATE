+    blocked: set[tuple[int, int]] = set()
+    for tr in range(rows):
+        for tc in range(cols):
+            if (tr, tc) == seed_tile:
+                continue
+            tile = g[tr * tile_h : (tr + 1) * tile_h, tc * tile_w : (tc + 1) * tile_w]
+            if np.any(tile != bg):
