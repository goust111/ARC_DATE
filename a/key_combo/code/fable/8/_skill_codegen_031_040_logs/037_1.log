+        candidates = [tile for tile in all_tiles if tile not in base_blocked and tile != seed]
+        extra_cap = min(len(candidates), rows + cols - 3)
+        extra_count = int(rng.integers(0, extra_cap + 1))
+        extra_tiles = set()
+        if extra_count:
