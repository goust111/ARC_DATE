_GEN_MISSING_CELLS = tuple(_GEN_MISSING_TO_COLOR)
_GEN_MARKER_SHAPE = (2, 2)
_GEN_L_TRIOMINO_AREA = 3

# Object mask size, area, and disconnected-4c weighting.
_GEN_OBJECT_DIMS = ((3, 4), (3, 3), (4, 4))
