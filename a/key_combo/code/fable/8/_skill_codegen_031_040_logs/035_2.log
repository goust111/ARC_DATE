# Palette and marker orientation codes.
_GEN_BG = 0
_GEN_OBJECT_COLOR = 1
_GEN_MARKER_COLOR = 7
_GEN_REQUIRED_INPUT_COLORS = {_GEN_BG, _GEN_OBJECT_COLOR, _GEN_MARKER_COLOR}
