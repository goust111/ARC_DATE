_GEN_AREA_RANGE_BY_DIMS = {(3, 3): (6, 6), (3, 4): (7, 9), (4, 4): (9, 10)}
_GEN_C4_WEIGHTS = {2: 5, 3: 5, 4: 2}
_GEN_OTHER_C4_WEIGHT = 1

# Group assembly offsets: 2x2 marker directly above the object.
_GEN_MARKER_COL_OFFSET = 1
_GEN_OBJECT_TOP = 2

