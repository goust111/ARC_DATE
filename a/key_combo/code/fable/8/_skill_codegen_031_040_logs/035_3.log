+            left_lo = max(1, target.left - w + 1)
+            left_hi = min(w_lim - w - 2, target.right)
+            if top < 1 or left_lo > left_hi:
+                continue
+            left = random.randint(left_lo, left_hi)
+        else:
+            top = target.bottom + gap + 1
+            left_lo = max(1, target.left - w + 1)
+            left_hi = min(w_lim - w - 2, target.right)
+            if top + h > h_lim - 1 or left_lo > left_hi:
