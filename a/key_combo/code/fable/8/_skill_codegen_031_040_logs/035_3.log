+def _paint_rect(canvas: np.ndarray, rect: Rect) -> None:
+    canvas[rect.top : rect.top + rect.h, rect.left : rect.left + rect.w] = rect.body
+    mr, mc = rect.marker_pos()
+    canvas[mr, mc] = rect.marker
