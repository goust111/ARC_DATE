+def _parse_scene(grid: np.ndarray) -> tuple[int, tuple[int, int, int], list[Rect]]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    bg = _get_bg(g)
+    components = _find_components(g != bg)
+    start: tuple[int, int, int] | None = None
+    rects: list[Rect] = []
+    for coords in components:
