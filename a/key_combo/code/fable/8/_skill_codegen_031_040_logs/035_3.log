+
+
+def _simulate_relay(
+    rects: list[Rect],
+    start_rc: tuple[int, int],
+    shape: tuple[int, int],
+) -> tuple[list[Rect], list[int], list[dict[str, int | tuple[int, int] | None]]]:
+    work = [rect.copy() for rect in rects]
+    order: list[int] = []
+    trace: list[dict[str, int | tuple[int, int] | None]] = []
+    current = _ray_hit_rect(work, start_rc, shape)
