+    h, w = random.choice(RECT_SIZES)
+    dr, dc = direction
+    h_lim, w_lim = shape
+    for _ in range(500):
+        gap = random.randint(2, 7)
+        if (dr, dc) == (0, 1):
+            left = target.left - gap - w
+            top_lo = max(1, target.top - h + 1)
+            top_hi = min(h_lim - h - 2, target.bottom)
+            if left < 1 or top_lo > top_hi:
+                continue
+            top = random.randint(top_lo, top_hi)
+        elif (dr, dc) == (0, -1):
