+    if (mr, mc) == (r0, mid_c):
+        dr, dc = -1, 0
+    elif (mr, mc) == (r1, mid_c):
+        dr, dc = 1, 0
+    elif (mr, mc) == (mid_r, c0):
+        dr, dc = 0, -1
+    elif (mr, mc) == (mid_r, c1):
