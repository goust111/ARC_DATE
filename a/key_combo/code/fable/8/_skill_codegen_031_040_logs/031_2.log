+    cells = []
+    for i in range(3):
+        row = []
+        for j in range(3):
+            color = MAROON if bool(mask[i, j]) else BLACK
+            row.append(np.full((cell_size, cell_size), color, dtype=int))
+        cells.append(row)
+    return _render_with_cells(cells, frame_color)
+
