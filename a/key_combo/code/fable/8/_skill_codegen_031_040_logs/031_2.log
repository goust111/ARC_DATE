+            cell = cells[i][j]
+            colors = set(map(int, np.unique(cell)))
+            assert colors <= {BLACK, MAROON}, "mask cells must be black or maroon"
+            mask[i, j] = bool(np.any(cell == MAROON))
+    return mask
