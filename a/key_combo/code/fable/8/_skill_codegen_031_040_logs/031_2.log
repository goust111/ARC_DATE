+    return True
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GRID_RETRY_LIMIT):
+        try:
+            inp, expected = _build_instance()
+        except RuntimeError:
+            continue
+        if _validate_instance(inp, expected):
+            return inp
+    raise RuntimeError("failed to generate a valid mask-lattice instance")

