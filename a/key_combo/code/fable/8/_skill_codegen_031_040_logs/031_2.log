+
+def _make_tile(size: int, color: int, seen: set[bytes]) -> np.ndarray:
+    min_count = max(3, size)
+    max_count = min(size * size - 2, size + 3)
+    for _ in range(200):
+        count = random.randint(min_count, max_count)
