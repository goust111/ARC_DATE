+
+def _render_lattice(tiles: list[list[np.ndarray]], frame_color: int) -> np.ndarray:
+    return _render_with_cells(tiles, frame_color)
+
+
+def _render_mask(mask: np.ndarray, cell_size: int, frame_color: int) -> np.ndarray:
