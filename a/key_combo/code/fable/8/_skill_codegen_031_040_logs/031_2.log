+def _full_line_positions(region: np.ndarray, color: int, axis: int) -> list[int]:
+    if axis == 0:
+        return [r for r in range(region.shape[0]) if np.all(region[r, :] == color)]
+    return [c for c in range(region.shape[1]) if np.all(region[:, c] == color)]
