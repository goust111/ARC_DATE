+    for i in range(3):
+        row_out = []
+        for j in range(3):
+            both = bool(mask_a[i, j]) and bool(mask_b[i, j])
+            xor = bool(mask_a[i, j]) ^ bool(mask_b[i, j])
+            action = ROT180 if both else MIRROR if xor else KEEP
+            row_out.append(_apply_action(tile_cells[i][j], action))
