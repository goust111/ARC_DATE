+
+    r0, c0, r1, c1 = _bbox(non_bg)
+    bbox_corners = {
+        "tl": (r0, c0),
+        "tr": (r0, c1),
+        "br": (r1, c1),
+        "bl": (r1, c0),
+    }
+    labels = [name for name, rc in bbox_corners.items() if rc == (pin_r, pin_c)]
+    assert len(labels) == 1, "pin must lie on exactly one corner of the template bbox"
