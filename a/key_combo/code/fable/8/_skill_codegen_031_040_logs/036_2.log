+def _rotated_mask(mask: np.ndarray, from_corner: str, to_corner: str) -> np.ndarray:
+    steps_cw = (CORNER_TO_INDEX[to_corner] - CORNER_TO_INDEX[from_corner]) % 4
+    return np.rot90(mask, -steps_cw)
