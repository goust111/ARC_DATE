+        if h == w:
+            continue
+        pin_corner = random.choice(CORNER_ORDER)
+        crop = _shape_with_pin_bbox(h, w, pin_corner)
+        panel = np.full((n, n), bg, dtype=int)
+        top = random.randint(0, n - h)
+        left = random.randint(0, n - w)
