GAP_RANGE = range(1, 4)               # gap between adjacent blocks
STEP_MIN, STEP_MAX = 3, 5             # block_size + gap bounds
BASE_C_MIN = 8                         # minimum block-area column (separates from legend)
BASE_R_MIN = 1                         # minimum block-area row

