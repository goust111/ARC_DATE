+def _rand_tile(rng: random.Random, palette: list[int]) -> np.ndarray:
+    while True:
+        colors = rng.sample(palette, rng.randint(2, min(4, len(palette))))
+        vals = [rng.choice(colors) for _ in range(4)]
+        if len(set(vals)) < 2:
+            continue
+        tile = np.array(vals, dtype=int).reshape(2, 2)
