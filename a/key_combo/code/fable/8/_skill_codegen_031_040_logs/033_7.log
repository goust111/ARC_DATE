+    return markers
+
+
+def simulate_marker(
+    inp: np.ndarray,
+    out: np.ndarray,
+    tile: np.ndarray,
+    start_bbox: tuple[int, int, int, int],
+    direction: tuple[int, int],
+    mirrors: np.ndarray,
+    protect: np.ndarray,
+    bg: int,
+) -> None:
+    h, w = tile.shape
+    r0, c0, _r1, _c1 = start_bbox
+    dr, dc = direction
+    mask = tile != bg
+    while True:
+        nr0 = r0 + dr * h
+        nc0 = c0 + dc * w
+        if nr0 < 0 or nc0 < 0 or nr0 + h > out.shape[0] or nc0 + w > out.shape[1]:
