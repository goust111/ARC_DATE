+            ):
+                chosen = (kind, new_dir)
+        elif not pending and random_turns < extra_turn_budget and drawn >= 1 and since_turn >= 1 and rng.random() < 0.2:
+            kinds = ["/", "\\"]
+            rng.shuffle(kinds)
+            for kind in kinds:
