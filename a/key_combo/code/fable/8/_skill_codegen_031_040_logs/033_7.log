+
+
+def simulate_marker(
+    inp: np.ndarray,
+    out: np.ndarray,
+    tile: np.ndarray,
+    start_bbox: tuple[int, int, int, int],
+    direction: tuple[int, int],
+    mirrors: np.ndarray,
+    protect: np.ndarray,
+    bg: int,
+) -> None:
