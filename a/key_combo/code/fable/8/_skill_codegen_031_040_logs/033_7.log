+        return out
+    plus_lab, _pluses = plus_labels(g, plus_color)
+    mirrors = mirror_map(g)
+    protect = g != bg
+    for marker in extract_markers(g, bg, plus_color, plus_lab):
+        simulate_marker(
+            g,
+            out,
+            marker["tile"],
+            marker["bbox"],
+            marker["direction"],
+            mirrors,
+            protect,
+            bg,
