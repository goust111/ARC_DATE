+        return None
+    return {"turns": turns, "drawn": drawn}
+
+
+def _choose_plus_positions(h: int, w: int, n_plus: int, rng: random.Random) -> list[tuple[int, int]] | None:
+    if n_plus == 2:
+        top_rows = list(range(6, max(7, h // 2 - 3)))
+        bot_rows = list(range(max(6, h // 2 + 1), h - 8))
+        left_cols = list(range(6, max(7, w // 2 - 3)))
+        right_cols = list(range(max(6, w // 2 + 1), w - 8))
+        if not top_rows or not bot_rows or not left_cols or not right_cols:
+            return None
+        if rng.random() < 0.5:
