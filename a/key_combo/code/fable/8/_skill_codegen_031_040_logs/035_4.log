+        ok = True
+        for idx in order:
+            patch = patches[idx]
+            h, w = map(int, patch.shape)
+            positions = [(r, c) for r in range(rows - h + 1) for c in range(cols - w + 1)]
+            random.shuffle(positions)
+            placed = False
+            for r0, c0 in positions:
+                rr0 = max(0, r0 - 1)
+                cc0 = max(0, c0 - 1)
+                rr1 = min(rows, r0 + h + 1)
