+TRANSFORMS = (
+    "rot90",
+    "rot180",
+    "rot270",
+    "flip_lr",
+    "flip_ud",
+    "transpose",
+    "anti_transpose",
+)
+
+
+def _recolor(sprite: np.ndarray, mapping: dict[int, int]) -> np.ndarray | None:
+    out = sprite.copy()
+    colors = set(map(int, np.unique(sprite))) - {BG}
+    if not colors.issubset(mapping):
+        return None
+    for src, dst in mapping.items():
+        out[sprite == src] = dst
