+    if geom == "flip_lr":
+        return np.fliplr(sprite)
+    if geom == "flip_ud":
+        return np.flipud(sprite)
+    if geom == "transpose":
+        return sprite.T.copy()
+    if geom == "anti_transpose":
+        return np.fliplr(np.rot90(sprite, 1))
+    raise ValueError(f"unknown geometry: {geom}")
+
