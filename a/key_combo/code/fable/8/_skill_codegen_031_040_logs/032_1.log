+        if len(set(matched_shadow_indices)) != len(matched_shadow_indices):
+            continue
+        if any(not _is_pure_shadow(shadows[idx]) for idx in matched_shadow_indices):
+            continue
+        unmatched = set(range(len(shadows))) - set(matched_shadow_indices)
+        if len(unmatched) != 1:
