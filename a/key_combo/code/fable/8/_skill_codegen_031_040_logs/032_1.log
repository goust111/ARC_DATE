+    h, w = blocked.shape
+    for r, c in cells:
+        r0 = max(0, r - pad)
+        r1 = min(h, r + pad + 1)
+        c0 = max(0, c - pad)
+        c1 = min(w, c + pad + 1)
+        blocked[r0:r1, c0:c1] = True
