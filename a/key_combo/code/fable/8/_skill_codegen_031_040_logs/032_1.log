+    assert len(valid_offsets) == 1, "expected a unique global sprite-to-shadow offset"
+    (dr, dc), orphan_idx = valid_offsets[0]
+    orphan = shadows[orphan_idx]
+
+    target_top = orphan["bbox"][0] - dr
+    target_left = orphan["bbox"][1] - dc
