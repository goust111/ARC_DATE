+def _cells_clear(blocked: np.ndarray, cells: list[tuple[int, int]], pad: int = 1) -> bool:
+    h, w = blocked.shape
+    for r, c in cells:
+        if not (0 <= r < h and 0 <= c < w):
+            return False
+        r0 = max(0, r - pad)
+        r1 = min(h, r + pad + 1)
+        c0 = max(0, c - pad)
+        c1 = min(w, c + pad + 1)
+        if blocked[r0:r1, c0:c1].any():
