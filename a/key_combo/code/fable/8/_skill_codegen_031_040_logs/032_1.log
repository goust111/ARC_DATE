+def _random_connected_shape(rng: np.random.Generator) -> np.ndarray:
+    for _ in range(200):
+        h = int(rng.integers(2, 5))
+        w = int(rng.integers(2, 5))
+        target_area = int(rng.integers(3, min(8, h * w) + 1))
