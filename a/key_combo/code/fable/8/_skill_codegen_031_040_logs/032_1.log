+    for idx in range(shadow_count):
+        reuse_existing = idx > 0 and duplicate_budget > 0 and rng.random() < 0.4
+        if reuse_existing:
+            shapes.append(shapes[int(rng.integers(len(shapes)))].copy())
+            duplicate_budget -= 1
+            continue
