+    palette = rng.choice(NON_GREY_COLORS, size=needed_colors, replace=False).tolist()
+    stain_color = int(palette[-1])
+    sprite_colors = [int(color) for color in palette[:-1]]
+    rng.shuffle(sprite_colors)
