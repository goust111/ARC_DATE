+) -> list[dict] | None:
+    h, w = grid_shape
+    dr, dc = offset
+    blocked = np.zeros((h, w), dtype=bool)
+    order = sorted(range(len(shapes)), key=lambda idx: int(shapes[idx].sum()), reverse=True)
+    placements: list[dict | None] = [None] * len(shapes)
