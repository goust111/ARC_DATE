8:def main(grid: np.ndarray) -> np.ndarray:
9:    """
10:    Expand the left-edge 2x2 motif into rightward copies scaled by powers of two.
11:
12:    Input structure
13:    - The background is the most common color.
14:    - The only foreground pixels form a filled 2x2 motif in columns 0 and 1.
15:    Rule
16:    - Start with a background-filled output of the same shape.
17:    - For scales 1, 2, 4, ... that fit horizontally, stamp the motif scaled by that factor.
18:    - Place each scaled stamp at column 2 * (scale - 1), with its top row band ending on the
19:      original motif's top row and its bottom row band starting on the original motif's bottom row.
20:    Key insight
21:    - The original 2x2 motif is the smallest copy in a dyadic sequence: each next copy doubles
22:      both dimensions, starts immediately to the right, and grows away from the seam between
23:      the motif's two rows.
24:    """
25:    g = np.asarray(grid, dtype=int)
26:    assert g.ndim == 2, "expected a 2D grid"
27:
28:    bg = get_bg(g)
29:    box = bbox(g != bg)
30:    assert box is not None, "expected foreground motif"
31:    r0, c0, r1, c1 = box
32:    assert c0 == 0 and c1 == 1, "motif must occupy the first two columns"
33:    assert r1 == r0 + 1, "motif must be exactly two rows tall"
34:
35:    motif = g[r0 : r1 + 1, c0 : c1 + 1]
36:    assert motif.shape == (2, 2)
37:    assert np.all(motif != bg), "motif must be a filled 2x2 foreground block"
38:
39:    height, width = g.shape
40:    out = np.full_like(g, bg)
41:
42:    scale = 1
43:    while 2 * (scale - 1) + 2 * scale <= width:
44:        top = r0 - scale + 1
45:        left = 2 * (scale - 1)
46:        assert top >= 0 and top + 2 * scale <= height, "scaled motif must fit vertically"
47:
48:        stamp = scale_sprite(motif, scale)
49:        out[top : top + 2 * scale, left : left + 2 * scale] = stamp
50:        scale *= 2
51:
52:    assert scale > 1, "expected at least the original 2x2 motif to fit"
53:    return out
