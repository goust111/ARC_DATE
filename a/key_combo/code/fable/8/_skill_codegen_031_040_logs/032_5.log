53:def main(grid: np.ndarray) -> np.ndarray:
54:    """
55:    Crop the four sprites separated by a solid cross and pack them into a 2x2 montage.
56:
57:    Input structure
58:    - The background is the dominant color.
59:    - One non-background color forms a full solid row and a full solid column,
60:      splitting the grid into four nonempty quadrants.
61:    - Each quadrant contains exactly one single-color sprite on the background;
62:      each sprite has a 3x3 tight bounding box.
63:
64:    Rule
65:    - Remove the separator row and column.
66:    - In each quadrant, crop the sprite to its tight bounding box, preserving
67:      background holes inside the crop.
68:    - Concatenate the four crops in quadrant order: upper-left, upper-right,
69:      lower-left, lower-right.
70:
71:    Key insight
72:    - The cross is only a layout divider; the output is a compact atlas of the
73:      four local sprites in their original relative quadrant positions.
74:    """
75:    g = np.asarray(grid, dtype=int)
76:    assert g.ndim == 2, "expected a 2D grid"
77:    height, width = map(int, g.shape)
78:
79:    bg = get_bg(g)
80:    cross_row, cross_col, separator = _find_separator_cross(g, bg)
81:
82:    regions = [
83:        g[:cross_row, :cross_col],
84:        g[:cross_row, cross_col + 1 : width],
85:        g[cross_row + 1 : height, :cross_col],
86:        g[cross_row + 1 : height, cross_col + 1 : width],
87:    ]
88:    crops = [_sprite_crop(region, bg, separator) for region in regions]
89:
90:    top = np.hstack(crops[:2])
91:    bottom = np.hstack(crops[2:])
92:    return np.vstack([top, bottom]).astype(int)
