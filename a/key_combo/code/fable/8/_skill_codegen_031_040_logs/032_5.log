+
+def get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, np.asarray(grid).ravel())).most_common(1)[0][0])
+
+
+def colors_present(grid: np.ndarray, *, exclude: set[int] | None = None) -> list[int]:
+    colors = set(map(int, np.unique(grid)))
+    if exclude is not None:
+        colors -= set(map(int, exclude))
+    return sorted(colors)
+
+
+def in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = map(int, shape)
+    return 0 <= int(r) < h and 0 <= int(c) < w
+
+
+def neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def bbox(mask: np.ndarray) -> tuple[int, int, int, int] | None:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return None
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _is_connected(coords: set[tuple[int, int]]) -> bool:
+    if not coords:
+        return False
+    start = next(iter(coords))
+    seen = {start}
+    stack = [start]
+    while stack:
+        r, c = stack.pop()
+        for nr, nc in neighbors4(r, c):
+            if (nr, nc) in coords and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                stack.append((nr, nc))
+    return len(seen) == len(coords)
+
+
+def _frame_dict(r0: int, c0: int, h: int, w: int, side: str, offset: int, color: int) -> dict:
+    r1 = r0 + h - 1
+    c1 = c0 + w - 1
+    if side == "up":
+        gap = (r0, c0 + offset)
+    elif side == "down":
+        gap = (r1, c0 + offset)
+    elif side == "left":
+        gap = (r0 + offset, c0)
+    else:
+        gap = (r0 + offset, c1)
+    dr, dc = DIRS[side]
+    border = set()
+    for rr in range(r0, r1 + 1):
+        border.add((rr, c0))
+        border.add((rr, c1))
+    for cc in range(c0, c1 + 1):
+        border.add((r0, cc))
+        border.add((r1, cc))
+    border.remove(gap)
+    return {
+        "color": int(color),
+        "bbox": (int(r0), int(c0), int(r1), int(c1)),
+        "side": side,
+        "gap": gap,
+        "dir": (dr, dc),
+        "inside": (gap[0] - dr, gap[1] - dc),
+        "solid": border,
+    }
+
+
+def _draw_frame(grid: np.ndarray, frame: dict) -> None:
+    color = int(frame["color"])
+    for r, c in frame["solid"]:
+        grid[r, c] = color
+
+
+def _expanded_boxes_overlap(a: tuple[int, int, int, int], b: tuple[int, int, int, int], pad: int = 1) -> bool:
+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
+    return not (ar1 + pad < br0 or br1 + pad < ar0 or ac1 + pad < bc0 or bc1 + pad < ac0)
