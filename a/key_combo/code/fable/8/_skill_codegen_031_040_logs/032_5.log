+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+DIRS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+
+OPPOSITE = {
+    "up": "down",
+    "down": "up",
+    "left": "right",
+    "right": "left",
+}
+
+FRAME_SIDE_MIN = 4
+FRAME_SIDE_MAX = 7
+GRID_MIN = 20
+GRID_MAX = 29
+PAIR_SEP_MIN = 3
+PAIR_SEP_MAX = 7
+GEN_RETRIES = 500
