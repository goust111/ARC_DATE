7:def main(grid: np.ndarray) -> np.ndarray:
8:    """
9:    Replace a corner L with a same-color right-triangle outline in the corresponding corner of an enlarged canvas.
10:
11:    Input structure:
12:    - The input is a square grid with one background color and one foreground color.
13:    - The foreground is a one-pixel-thick L inside a square bbox.
14:    - The L touches exactly one horizontal grid edge and one vertical grid edge, identifying a corner.
15:
16:    Rule:
17:    - Fill a square output canvas of side 3n-2, where n is the input side length, with the background color.
18:    - Double the L leg length to get the triangle side length.
19:    - Draw the two perpendicular triangle legs on the same output corner edges and connect their free endpoints with the diagonal.
20:
21:    Key insight:
22:    - The input L encodes the corner, color, and side length of the triangle outline; the missing side is the diagonal between the L's two free endpoints.
23:    """
24:    g = np.asarray(grid, dtype=int)
25:    assert g.ndim == 2, "expected a 2D grid"
26:    height, width = map(int, g.shape)
27:    assert height == width, "expected a square input grid"
28:
29:    bg = get_bg(g)
30:    fg_colors = colors_present(g, exclude={bg})
31:    assert len(fg_colors) == 1, "expected exactly one foreground color"
32:    fg = fg_colors[0]
33:
34:    mask = g == fg
35:    coords = np.argwhere(mask)
36:    assert coords.size > 0, "expected a foreground L"
37:    r0, c0 = map(int, coords.min(axis=0))
38:    r1, c1 = map(int, coords.max(axis=0))
39:    leg_len = r1 - r0 + 1
40:    assert leg_len == c1 - c0 + 1, "expected the L bbox to be square"
41:    assert leg_len > 1, "expected a nontrivial L"
42:
43:    touches_top = r0 == 0
44:    touches_bottom = r1 == height - 1
45:    touches_left = c0 == 0
46:    touches_right = c1 == width - 1
47:    assert sum((touches_top, touches_bottom)) == 1, "expected the L to touch one horizontal grid edge"
48:    assert sum((touches_left, touches_right)) == 1, "expected the L to touch one vertical grid edge"
49:
50:    expected = np.zeros_like(mask, dtype=bool)
51:    edge_row = r0 if touches_top else r1
52:    edge_col = c0 if touches_left else c1
53:    expected[edge_row, c0 : c1 + 1] = True
54:    expected[r0 : r1 + 1, edge_col] = True
55:    assert np.array_equal(mask, expected), "expected foreground to be exactly a corner L"
56:
57:    out_size = 3 * height - 2
58:    side = 2 * leg_len
59:    out = np.full((out_size, out_size), bg, dtype=int)
60:    top = touches_top
61:    left = touches_left
62:    rr0 = 0 if top else out_size - side
63:    cc0 = 0 if left else out_size - side
64:    out_edge_row = rr0 if top else rr0 + side - 1
65:    out_edge_col = cc0 if left else cc0 + side - 1
66:
67:    for i in range(side):
68:        out[out_edge_row, cc0 + i] = fg
69:        out[rr0 + i, out_edge_col] = fg
70:        diag_col = side - 1 - i if top == left else i
71:        out[rr0 + i, cc0 + diag_col] = fg
72:
73:    return out
