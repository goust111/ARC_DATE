53:        assert np.all((region == color) | (region == marker)), (
54:            "expected a rectangular region with only its own color and markers"
55:        )
56:
57:        height = r1 - r0 + 1
58:        width = c1 - c0 + 1
59:        assert height != width, "expected each colored region to be non-square"
60:
61:        markers = np.argwhere(region == marker)
62:        for rr, cc in markers:
63:            r = int(r0 + rr)
64:            c = int(c0 + cc)
65:            assigned_markers[r, c] = True
66:            if width > height:
67:                out[r0 : r1 + 1, c] = marker
68:            else:
69:                out[r, c0 : c1 + 1] = marker
70:
71:    assert np.array_equal(assigned_markers, g == marker), (
