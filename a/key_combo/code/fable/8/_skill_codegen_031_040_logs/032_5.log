+    reserved |= corridor
+    planned_hits[0] = 1
+    planned_hits[1] = 0
+
+    color_ptr = 2
+    if frame_count == 6:
+        pair2_orientation = "vertical" if pair1_orientation == "horizontal" else "horizontal"
+        pair2 = _try_hit_pair(rng, shape, frames, reserved, colors[color_ptr : color_ptr + 2], pair2_orientation)
