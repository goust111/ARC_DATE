+    return out
+
+
+def _generate_attempt(rng: random.Random) -> np.ndarray | None:
+    shape = (rng.randint(GRID_MIN, GRID_MAX), rng.randint(GRID_MIN, GRID_MAX))
+    frame_count = 4 + 2 * int(rng.random() < 0.55)
