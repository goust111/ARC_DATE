0032: def main(grid: np.ndarray) -> np.ndarray:
0033:     """Recover the pattern hidden by the unique solid square occluder using mirror symmetry.
0034: 
0035:     Input structure
0036:     - The input is a square scene with one unique largest solid monochrome square occluder.
0037:     - The occluder's color appears only in that square, and the rest of the scene is mirror-symmetric.
0038: 
0039:     Rule
0040:     - Reflect the occluder's bbox across the vertical axis, horizontal axis, and both axes.
0041:     - Ignore reflected regions that still contain the occluder color because they overlap the hidden square.
0042:     - Transform each usable reflected region back into the occluder orientation and return that recovered square.
0043: 
0044:     Key insight
0045:     - The task asks for only the occluded square, not the full repaired scene; every unoccluded mirror counterpart yields the same patch.
0046:     """
0047:     g = np.asarray(grid, dtype=int)
0048:     H, W = g.shape
0049:     assert H == W, "expected a square input grid"
0050: 
0051:     occluder = _largest_solid_square(g)
0052:     color = int(occluder["color"])
0053:     r0, c0, r1, c1 = occluder["bbox"]
0054:     h = bbox_h(occluder["bbox"])
0055:     w = bbox_w(occluder["bbox"])
0056:     assert np.count_nonzero(g == color) == h * w, "occluder color must occur only in the occluder"
0057: 
0058:     reflections = [
0059:         (r0, W - 1 - c1, r1, W - 1 - c0, np.fliplr),
0060:         (H - 1 - r1, c0, H - 1 - r0, c1, np.flipud),
0061:         (H - 1 - r1, W - 1 - c1, H - 1 - r0, W - 1 - c0, lambda a: np.rot90(a, 2)),
0062:     ]
0063: 
0064:     recovered = []
0065:     for rr0, cc0, rr1, cc1, transform in reflections:
0066:         assert 0 <= rr0 <= rr1 < H and 0 <= cc0 <= cc1 < W
0067:         patch = g[rr0 : rr1 + 1, cc0 : cc1 + 1]
0068:         assert patch.shape == (h, w)
0069:         if not np.any(patch == color):
0070:             recovered.append(transform(patch))
0071: 
0072:     assert recovered, "expected at least one unoccluded mirror counterpart"
0073:     assert all(np.array_equal(recovered[0], patch) for patch in recovered[1:]), "mirror counterparts must agree"
0074:     return recovered[0].copy()
