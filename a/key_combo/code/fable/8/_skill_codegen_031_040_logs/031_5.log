+    if policy == "cw":
+        return _rotate_cw(direction)
+    if policy == "ccw":
+        return _rotate_ccw(direction)
+    raise ValueError(f"unknown turn policy: {policy}")
+
+
+def _detect_notched_square(grid: np.ndarray) -> tuple[int, dict]:
