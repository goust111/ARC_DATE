  "transform": "discard the smaller same-color object from each panel; when a later object overlaps earlier objects, slide it by the nearest in-bounds non-overlapping offset",
  "grid_shape": "5x17 input with separator columns -> 5x5 output"
}
</annotation>
</reference_puzzle>

