+    try:
+        actual = main(canvas)
+    except AssertionError:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    if len({_apply_op(src, op_by_key[key]).tobytes() for _r, _c, key, src in task_anchors}) < 3:
