+SEP = 1
+FRAME = 5
+BOX = 5
+INNER = 3
+UNIT = 6
+PAIR_W = 12
+GAP = 1
+KEY_POOL = (2, 3, 4, 6, 7, 8, 9)
+ALL_OPS = ("flip_lr", "flip_ud", "rot_cw", "swap_colors")
