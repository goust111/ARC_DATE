+    object_palette = [c for c in KEY_POOL if c not in key_colors]
+    if len(object_palette) < 2:
+        return None
+
+    used_patterns: set[bytes] = set()
+    demo_src: dict[int, np.ndarray] = {}
+    demo_dst: dict[int, np.ndarray] = {}
+    for key, op in op_by_key.items():
