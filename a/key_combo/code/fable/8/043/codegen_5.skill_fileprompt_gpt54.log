+        main_left = random.randint(0, 2)
+        right_pad = random.randint(0, 2)
+        width = max(legend_left + legend_w, main_left + main_w) + right_pad
+        height = main_top + main_h + bottom_pad
+        if height <= 30 and width <= 30:
