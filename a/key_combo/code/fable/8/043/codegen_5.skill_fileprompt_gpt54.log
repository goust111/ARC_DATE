+    min_c = min(c0 - 1 for _r0, c0, _r1, _c1 in task_boxes)
+    max_r = max(r1 for _r0, _c0, r1, _c1 in task_boxes)
+    max_c = max(c1 for _r0, _c0, _r1, c1 in task_boxes)
