+    counts, start_region, initial_dir = _extract_regions(grid)
+    path, _move_dirs = _trace_path(counts, start_region, initial_dir)
+
+    out = np.full(counts.shape, BACKGROUND, dtype=int)
+    for r, c in path:
+        out[int(r), int(c)] = VISITED_COLOR
+    return out
