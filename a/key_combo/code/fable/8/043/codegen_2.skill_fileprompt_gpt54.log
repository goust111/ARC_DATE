+def _outside_dirs(cell: tuple[int, int], rows: int, cols: int) -> list[int]:
+    r, c = map(int, cell)
+    out = []
+    if r == 0:
+        out.append(UP)
+    if c == cols - 1:
+        out.append(RIGHT)
+    if r == rows - 1:
+        out.append(DOWN)
+    if c == 0:
