+    pts[:, 0] -= int(pts[:, 0].min())
+    pts[:, 1] -= int(pts[:, 1].min())
+    h = int(pts[:, 0].max()) + 1
+    w = int(pts[:, 1].max()) + 1
+    mask = np.zeros((h, w), dtype=bool)
+    mask[pts[:, 0], pts[:, 1]] = True
+
+    rot = random.randint(0, 3)
+    mask = np.rot90(mask, rot)
+    if random.random() < 0.5:
+        mask = np.fliplr(mask)
+    return mask
+
+
+def _can_place(coords: np.ndarray, occupied: np.ndarray) -> bool:
+    h, w = occupied.shape
+    for r, c in coords:
+        r = int(r)
+        c = int(c)
+        if not (1 <= r < h - 1 and 1 <= c < w - 1):
+            return False
+        r0 = max(0, r - 1)
+        r1 = min(h, r + 2)
+        c0 = max(0, c - 1)
+        c1 = min(w, c + 2)
