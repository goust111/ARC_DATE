+            random.shuffle(candidates)
+            candidates.sort(key=lambda item: item[1])
+            for (nr, nc), _straight in candidates:
+                seen.add((nr, nc))
+                path.append((nr, nc))
+                if dfs():
+                    return True
+                path.pop()
+                seen.remove((nr, nc))
+            return False
