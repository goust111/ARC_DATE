+    mh, mw = mask.shape
+    rel = np.argwhere(mask)
+    if h - mh - 1 < 1 or w - mw - 1 < 1:
+        return None
+    for _ in range(300):
+        r0 = random.randint(1, h - mh - 1)
+        c0 = random.randint(1, w - mw - 1)
+        coords = rel + np.array([r0, c0], dtype=int)
+        if not _can_place(coords, occupied):
+            continue
