+            cur = path[-1]
+            prev = path[-2] if len(path) >= 2 else None
+            candidates = []
+            for nr, nc in _neighbors4(*cur):
+                if not (1 <= nr < h - 1 and 1 <= nc < w - 1):
+                    continue
+                if (nr, nc) in seen:
+                    continue
+                visited_neighbors = [(ar, ac) for ar, ac in _neighbors4(nr, nc) if (ar, ac) in seen]
