+                "marker0": marker0,
+                "marker1": marker1,
+                "bar0": bar0,
+                "bar1": bar1,
+                "cross_cols": sorted(interior & v_cols),
+            }
+        )
+    random.shuffle(candidates)
+    return candidates
+
+
+def _vertical_candidates(
+    height: int,
+    h_rows: set[int],
+    gap: int,
+    charge: int,
+    side: str,
+) -> list[dict]:
+    candidates: list[dict] = []
+    max_start = height - gap - charge - 3
+    for start in range(max_start + 1):
+        if side == "top":
+            bar0 = start
+            bar1 = start + charge - 1
+            marker0 = bar1 + 2
+            marker1 = marker0 + gap + 1
+        else:
+            marker0 = start
+            marker1 = marker0 + gap + 1
+            bar0 = marker1 + 2
+            bar1 = bar0 + charge - 1
