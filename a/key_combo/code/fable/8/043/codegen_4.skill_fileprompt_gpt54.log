+            marker1 = marker0 + gap + 1
+            bar0 = marker1 + 2
+            bar1 = bar0 + charge - 1
+        occupied_cols = {marker0, marker1, *range(bar0, bar1 + 1)}
+        if occupied_cols & v_cols:
+            continue
+        interior = set(range(marker0 + 1, marker1))
+        candidates.append(
