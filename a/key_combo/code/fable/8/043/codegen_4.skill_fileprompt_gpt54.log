+            return chosen
+    return None
+
+
+def _sample_success_flags(count: int) -> list[bool]:
+    flags = [True, False] + [bool(random.getrandbits(1)) for _ in range(count - 2)]
+    random.shuffle(flags)
+    return flags
+
+
+def _sample_sides(axis: str, count: int) -> list[str]:
+    if axis == "row":
+        pool = ["left", "right"]
