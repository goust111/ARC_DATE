+
+
+def _sample_gap_and_charge(success: bool) -> tuple[int, int]:
+    gap = random.randint(MIN_GAP, MAX_GAP)
+    if success:
+        charge = random.randint(gap, min(MAX_CHARGE, gap + 3))
