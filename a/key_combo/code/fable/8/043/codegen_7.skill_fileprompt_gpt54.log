+
+def _place_holes(frame_h: int, frame_w: int, hole_specs: list[dict]) -> list[dict] | None:
+    blocked = np.zeros((frame_h, frame_w), dtype=bool)
+    blocked[0, :] = True
+    blocked[-1, :] = True
+    blocked[:, 0] = True
+    blocked[:, -1] = True
