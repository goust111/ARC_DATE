+    if bg is None:
+        bg = get_bg(g)
+    if colors is None:
+        colors_iter = sorted(set(map(int, g.ravel())) - {int(bg)})
+    else:
+        colors_iter = [int(c) for c in colors if int(c) != int(bg)]
+
+    out = []
+    for color in colors_iter:
