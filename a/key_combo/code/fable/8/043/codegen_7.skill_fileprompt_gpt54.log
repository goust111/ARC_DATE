+def paste(
+    dst: np.ndarray,
+    patch: np.ndarray,
+    r0: int,
+    c0: int,
+    *,
+    transparent: int | None = None,
+    mask: np.ndarray | None = None,
+) -> None:
+    r0 = int(r0)
+    c0 = int(c0)
+    h, w = patch.shape
+    view = dst[r0 : r0 + h, c0 : c0 + w]
+    use = np.ones((h, w), dtype=bool)
+    if mask is not None:
+        use &= mask.astype(bool)
+    if transparent is not None:
+        use &= patch != int(transparent)
+    view[use] = patch[use]
+
