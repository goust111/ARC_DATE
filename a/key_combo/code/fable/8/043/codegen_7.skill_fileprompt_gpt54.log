+        if np.count_nonzero(grid == bg) <= max(np.count_nonzero(grid == frame_color), frame_h * frame_w):
+            continue
+        if not _semantic_checks(grid, expected, placed, count_by_color, sprite_groups):
+            continue
+        return grid
+    return None
+
+
+def generate_input() -> np.ndarray:
