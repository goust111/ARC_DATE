+    multi = 0
+    single_hits = set()
+    for comp in grey_components:
+        comp_set = {tuple(int(x) for x in rc) for rc in comp}
+        if comp_set & endpoint_forbidden:
+            return False
+        hits = _line_hit_ids(comp_set, line_lookup)
