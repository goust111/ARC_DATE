+def _diag_cells(a: tuple[int, int], b: tuple[int, int]) -> list[tuple[int, int]]:
+    r0, c0 = a
+    r1, c1 = b
+    dr = r1 - r0
+    dc = c1 - c0
+    assert dr != 0 and abs(dr) == abs(dc), "endpoint pair must define a strict diagonal"
+    sr = _sign(dr)
+    sc = _sign(dc)
+    return [(r0 + k * sr, c0 + k * sc) for k in range(abs(dr) + 1)]
