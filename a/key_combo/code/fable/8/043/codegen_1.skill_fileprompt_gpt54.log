+def _place_single_component(
+    line_idx: int,
+    lines: list[dict],
+    shape: tuple[int, int],
+    line_lookup: dict[tuple[int, int], set[int]],
+    used_grey: set[tuple[int, int]],
+    endpoint_forbidden: set[tuple[int, int]],
+) -> set[tuple[int, int]] | None:
+    anchors = lines[line_idx]["interior"][:]
