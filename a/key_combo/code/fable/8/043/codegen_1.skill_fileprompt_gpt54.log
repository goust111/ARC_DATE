  "transform": "replace each lower slot with d.mask recolored to s.color in the compact output lattice; slots without a control pixel become background",
  "grid_shape": "lower R x C slot array -> (2R+R-1) x (2C+C-1) output with one background separator row/column",
  "symbol_instructions": "top legend maps each colored marker to the adjacent 2x2 template mask"
}
</annotation>
