+def _path_cells(a: tuple[int, int], b: tuple[int, int], row_first: bool) -> list[tuple[int, int]]:
+    r1, c1 = a
+    r2, c2 = b
+    cells = [(r1, c1)]
+    if row_first:
+        step_c = _sign(c2 - c1)
+        for c in range(c1 + step_c, c2 + step_c, step_c or 1):
+            cells.append((r1, c))
+        step_r = _sign(r2 - r1)
+        for r in range(r1 + step_r, r2 + step_r, step_r or 1):
+            cells.append((r, c2))
+    else:
