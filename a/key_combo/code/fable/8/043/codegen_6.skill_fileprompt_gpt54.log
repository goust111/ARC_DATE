+        tile = np.array([rng.choice(palette) for _ in range(row_period * col_period)], dtype=int).reshape(row_period, col_period)
+        if len(set(map(int, tile.ravel()))) < 3:
+            continue
+        if not _has_exact_period(tile, row_period, col_period):
