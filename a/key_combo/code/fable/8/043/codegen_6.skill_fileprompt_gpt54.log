+        for c in range(top.shape[1]):
+            if int(top[r, c]) == BLACK and (r % row_period, c % col_period) not in phase_colors:
+                return True
+    return False
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
