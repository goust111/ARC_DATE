+
+    protected_bottom = {(recover_cell[0] + dr, recover_cell[1] + dc)}
+    if not uses_out_of_overlap:
+        br = remain_cell[0] + dr
+        bc = remain_cell[1] + dc
+        bottom[br, bc] = BLACK
+        protected_bottom.add((br, bc))
