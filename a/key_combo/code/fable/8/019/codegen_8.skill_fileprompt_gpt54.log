+def _tile_origin(tile_r: int, tile_c: int, tile_h: int, tile_w: int) -> tuple[int, int]:
+    step_r = tile_h + SEPARATOR_WIDTH
+    step_c = tile_w + SEPARATOR_WIDTH
+    return tile_r * step_r, tile_c * step_c
