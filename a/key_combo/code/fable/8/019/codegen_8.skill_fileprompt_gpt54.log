+def _spans(length: int, separators: list[int]) -> list[tuple[int, int]]:
+    spans: list[tuple[int, int]] = []
+    prev = -1
+    for idx in separators:
+        if idx <= prev + 1:
+            return []
+        spans.append((prev + 1, idx - 1))
+        prev = idx
+    if prev >= length - 1:
+        return []
+    spans.append((prev + 1, length - 1))
+    return spans
+
