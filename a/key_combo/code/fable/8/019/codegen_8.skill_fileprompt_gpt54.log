+                colors = set(map(int, np.unique(tile)))
+                motif_colors = colors - {bg, separator}
+                has_marker = separator in colors
+                if motif_colors:
+                    source_count += 1
+                elif has_marker:
+                    if not colors <= {bg, separator}:
+                        valid = False
+                        break
+                    marked_count += 1
+                else:
