+        row_heights = {r1 - r0 + 1 for r0, r1 in row_spans}
+        col_widths = {c1 - c0 + 1 for c0, c1 in col_spans}
+        if len(row_heights) != 1 or len(col_widths) != 1:
+            continue
+
+        non_sep = grid[grid != separator]
+        if non_sep.size == 0:
+            continue
+        bg = _mode_color(non_sep)
+
