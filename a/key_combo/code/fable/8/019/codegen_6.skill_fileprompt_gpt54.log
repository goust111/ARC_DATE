+    if cur % target != 0:
+        raise ValueError("non-integer shrink")
+    factor = cur // target
+    pieces = np.split(mask, target, axis=axis)
+    reduced = []
+    for piece in pieces:
+        ref = np.take(piece, 0, axis=axis)
+        if not np.all(piece == np.expand_dims(ref, axis=axis)):
