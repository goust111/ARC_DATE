+        and comp["area"] == c1 - c0 + 1
+        and (r0 == 0 or r0 == h - 1)
+    )
+
+
+def _is_vertical_bar(comp: dict, shape: tuple[int, int]) -> bool:
+    h, w = shape
+    r0, c0, r1, c1 = comp["bbox"]
+    return (
