119:             start = min(seed_idxs, key=lambda i: (cycle[i][0], cycle[i][1]))
120:         else:
121:             start = min(range(len(cycle)), key=lambda i: (cycle[i][0], cycle[i][1]))
122: 
123:         cycle = cycle[start:] + cycle[:start]
124: 
125:         # Carry neighbor offsets/colors from the chosen start vertex.
