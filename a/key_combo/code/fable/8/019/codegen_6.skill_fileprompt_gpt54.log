+def _scale_axis(mask: np.ndarray, target: int, axis: int) -> np.ndarray:
+    cur = mask.shape[axis]
+    if cur == target:
+        return mask.copy()
+    if target > cur:
+        if target % cur != 0:
+            raise ValueError("non-integer enlargement")
+        factor = target // cur
+        return np.repeat(mask, factor, axis=axis)
