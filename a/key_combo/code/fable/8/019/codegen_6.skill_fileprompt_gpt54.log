24: def main(grid: np.ndarray) -> np.ndarray:
25:     """
26:     Paint the empty gutters of a rectangular lattice of grey 2x2 blocks.
27: 
28:     Input structure:
29:     - The background is the most common color.
30:     - The only foreground color forms a complete rectangular array of separated 2x2 blocks.
31:     - Blank row bands and column bands between adjacent block bands are the lattice gutters.
32: 
33:     Rule:
34:     - Keep the grey blocks unchanged.
35:     - Paint gutter background pixels red inside the foreground bounding rectangle.
36:     - Paint gutter background pixels blue where the same gutter rows or columns extend outside that bounding rectangle.
37: 
38:     Key insight:
39:     - The grey blocks define row bands and column bands; their intervening blank bands are the lines to color, and the block-array bbox separates internal gutters from exterior extensions.
40:     """
41:     g = np.asarray(grid, dtype=int)
42: 
