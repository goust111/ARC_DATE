+    hbars: dict[int, int] = {}
+    vbars: dict[int, int] = {}
+    objects: list[dict] = []
+    for comp in comps:
+        color = int(comp["color"])
+        r0, c0, r1, c1 = comp["bbox"]
+        if _is_horizontal_bar(comp, g.shape):
+            hbars[color] = c1 - c0 + 1
+        elif _is_vertical_bar(comp, g.shape):
+            vbars[color] = r1 - r0 + 1
+        else:
