+    - Each bar is not a multiplier token but a ruler giving the final size on its own axis, so the same mechanism handles both upscaling and downscaling.
+    """
+    g = np.asarray(grid, dtype=int)
+    bg = _get_bg(g)
+    comps = _find_components(g, bg)
