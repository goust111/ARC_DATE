81: def generate_input():
82:     # create a 10-20x10-20 black grid
83:     # to make it possible to place rectangles that go offscreen,
84:     n = np.random.randint(10, 21)
85:     m = np.random.randint(10, 21)
86:     n, m = 8, 8
87:     # add a pixel of padding, which we will remove later
88:     m += 1
89:     n += 1
90:     grid = np.full((m, n), Color.BLACK)
91: 
92:     # add 2-4 grey rectangles with hollow insides
93:     # each rectangle can be 3-7x3-7
94:     # if we can't find a space, just stop adding new rectangles
95:     # num_rectangles = np.random.randint(2, 5)
96:     num_rectangles = 1
97: 
98:     # store the rectangles so we can add lines to them later
99:     rectangles = []
100:     for _ in range(num_rectangles):
101:         r_n = np.random.randint(3, 8)
102:         r_m = np.random.randint(3, 8)
103:         rectangle = np.full((r_n, r_m), Color.GREY)
104:         try:
105:             _loc = first_free_location(grid, rectangle, transparent=Color.BLACK, border=0, padding=1, padding_connectivity=8)
106:             if _loc is None:
107:                 raise ValueError("no placement")
108:             r, c = _loc
109:         except ValueError:
110:             break
111: 
112:         # make the rectangle hollow, but mark it yellow, so we don't place another rectangle inside of it.
113:         # later we will convert yellow back to black
114:         rectangle[1:-1, 1:-1] = Color.YELLOW
115:         paste(grid, rectangle, r, c, clip=True)
116:         rectangles.append((rectangle, (r, c)))
117: 
118:     # now draw 1-3 lines emanating from the rectangles
119:     # a line from another rectangle might emanate into the rectangle, so check for existing lines before adding one
120:     for rectangle, (r, c) in rectangles:
121:         # num_lines = np.random.randint(1, 4)
122:         num_lines = 0
123:         directions = [(1, 0), (-1, 0), (0, 1), (0, -1)]
124:         indices = np.random.choice(len(directions), num_lines, replace=False)
125:         directions = [directions[i] for i in indices]
126: 
127:         for direction in directions:
128:             # if there's already a line here, don't draw another one
129:             # to check, look for grey pixel within 1 pixel of the rectangle
130:             w, h = rectangle.shape
131: 
132:             bordering_pixels = find_bordering_pixels_in_direction(r, c, w, h, direction)
133:             bordering_pixels = np.array([(r, c) for r, c in bordering_pixels if 0 <= r < m and 0 <= c < n])
134:             if len(bordering_pixels) == 0:
135:                 continue
136: 
137:             if any(grid[r, c] == Color.GREY for r, c in bordering_pixels):
138:                 continue
139: 
140:             # now draw a line emanating outwards at a random bordering pixel
141:             # ignore the extreme most bordering pixels (assumes they are returned in order)
142:             bordering_pixels = bordering_pixels[1:-1]
143: 
144:             ix = np.random.choice(range(len(bordering_pixels)))
145:             start_pixel = bordering_pixels[ix]
146:             draw_line(grid, start_pixel[0], start_pixel[1], direction=direction, color=Color.GREY, stop_at=[Color.GREY])
147: 
148:     # convert yellow back to black
149:     grid[grid == Color.YELLOW] = Color.BLACK
150: 
151:     # remove the pixel of padding
152:     grid = grid[1:-1, 1:-1]
153: 
154:     return grid
155: 
156: 
157: def find_bordering_pixels_in_direction(r, c, w, h, direction):
158:     dr, dc = direction
159:     if dr == 1:  # right
160:         bordering_pixels = [(r + w, c + i) for i in range(h)]
161:     elif dr == -1:  # left
162:         bordering_pixels = [(r - 1, c + i) for i in range(h)]
163:     elif dc == 1:  # down
164:         bordering_pixels = [(r + i, c + h) for i in range(w)]
165:     elif dc == -1:  # up
166:         bordering_pixels = [(r + i, c - 1) for i in range(w)]
167: 
168:     return np.array(bordering_pixels)
