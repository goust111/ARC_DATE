14: def main(input_grid):
15:     """
16:     Fill hollow gray rectangles with yellow while preserving gray outlines and lines.
17: 
18:     Input structure:
19:     - The input has black regions bounded by gray rectangle outlines.
20:     - Gray lines may emanate from rectangle sides.
21:     - The desired fill affects only true hollow rectangle interiors.
22: 
23:     Rule:
24:     - Treat gray as the background for separating black interior regions.
25:     - Identify regions whose cropped area is entirely black and whose border is not part of a line.
26:     - Recolor accepted black interiors yellow and paste all regions back over a gray canvas.
27: 
28:     Key insight:
29:     - Rectangle interiors are found as black holes inside gray structure, while extra
30:       gray line contacts are filtered out before filling.
31:     """
32:     # extract objects using grey as background
33:     objects = find_components(input_grid, bg=Color.GREY, connectivity=4, monochromatic=True, return_format="objects")
34: 
35:     # create an output grid to store the result
36:     output_grid = np.full(input_grid.shape, Color.GREY)
37: 
38:     # for each object, fill it in if it is a rectangle
39:     for obj in objects:
40:         # to check if the object is a rectangle,
41:         # we can check if the cropped object is entirely black
42:         _b = bbox(obj != Color.GREY)
43:         assert _b is not None
44:         sprite = crop_bbox(obj, _b)
45:         is_rectangle = np.all(sprite == Color.BLACK)
46: 
47:         if is_rectangle:
48:             # we also need to make sure the rectangle isn't caused from an emanating line.
49:             # to do so, check for grey pixels around the border of the grey
50:             # border adjacent to a corner (aka the x/y value is one less than the max)
51:             border = object_neighbors(obj, background=Color.GREY, connectivity=8)
52:             # to get the border of the border, make a copy,
53:             # add yellow where the border is,
54:             # then find the border of this new object
55:             obj2 = obj.copy()
56:             obj2[border] = Color.YELLOW
57:             border2 = object_neighbors(obj2, background=Color.GREY, connectivity=8)
58:             _b = bbox(obj2 != Color.GREY)
59:             assert _b is not None
60:             r, c, _r1, _c1 = _b
61:             w = _r1 - r + 1
62:             h = _c1 - c + 1
63: 
64:             pixels_to_check = [
65:                 (x2, y2) for x2 in range(obj.shape[0]) for y2 in range(obj.shape[1])
66:                 if (border2[x2, y2]
67:                     # check if pixel is adjacent to a corner
68:                     and (x2 in [r, r + w-1] or y2 in [c, c + h-1]))
69:             ]
70: 
71:             if not any(input_grid[r, c] == Color.GREY for r, c in pixels_to_check):
72:                 # good rectangle!
73:                 # fill in the original object with yellow
74:                 obj[obj == Color.BLACK] = Color.YELLOW
75: 
76:         paste(output_grid, obj, 0, 0, transparent=Color.GREY, clip=True)
77: 
78:     return output_grid
79: 
