+def _find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == bg or seen[r, c]:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            cells = [(r, c)]
+            while q:
+                cr, cc = q.popleft()
+                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+                        cells.append((nr, nc))
+            box = _bbox(cells)
+            comps.append(
+                {
+                    "color": color,
+                    "cells": cells,
+                    "bbox": box,
+                    "area": len(cells),
+                }
+            )
+    return comps
