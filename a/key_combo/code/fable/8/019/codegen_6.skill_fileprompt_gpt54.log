95:     colors = sorted(set(int(v) for v in np.unique(g)) - {bg})
96:     for col in colors:
97:         pts_rc = [tuple(map(int, p)) for p in np.argwhere(g == col)]
98:         if len(pts_rc) < 2:
99:             continue
100: 
101:         cycle = _angle_cycle(pts_rc)
102:         if len(cycle) < 2:
103:             continue
104: 
105:         # Choose a start vertex that has a non-bg, different-color neighbor in the original input.
106:         seed_idxs = []
107:         for i, (r, c) in enumerate(cycle):
108:             for drn, dcn in DIR8:
109:                 rr = r + drn
110:                 cc = c + dcn
111:                 if 0 <= rr < h and 0 <= cc < w:
