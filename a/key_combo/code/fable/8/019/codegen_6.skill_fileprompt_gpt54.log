+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+                        cells.append((nr, nc))
+            box = _bbox(cells)
+            comps.append(
+                {
+                    "color": color,
+                    "cells": cells,
+                    "bbox": box,
+                    "area": len(cells),
