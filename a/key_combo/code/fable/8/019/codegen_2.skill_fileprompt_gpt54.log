+    assert len(endpoints) == 2, "wire must be a simple path with two endpoints"
+    assert start in endpoints, "ordered traversal must start from an endpoint"
+
+    path = [start]
+    prev: tuple[int, int] | None = None
+    cur = start
+    while True:
