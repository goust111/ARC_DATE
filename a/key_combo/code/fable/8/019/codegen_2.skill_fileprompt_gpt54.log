    if np.array_equal(patch, np.rot90(patch, 2)):
        return None
    if len(set(colored.values())) < 2:
        return None
    return colored


def _boundary_contact(
    sprite: dict[tuple[int, int], int], direction: tuple[int, int]
) -> tuple[int, int]:
    rows = [r for r, _ in sprite]
    cols = [c for _, c in sprite]
