+    span_w = c1 - c0 + 1
+    if span_h > 24 or span_w > 24:
+        return None
+
+    h = random.randint(max(span_h + 2, 14), min(30, span_h + 7))
+    w = random.randint(max(span_w + 2, 14), min(30, span_w + 7))
+    shift_r = random.randint(1 - r0, h - 2 - r1)
+    shift_c = random.randint(1 - c0, w - 2 - c1)
