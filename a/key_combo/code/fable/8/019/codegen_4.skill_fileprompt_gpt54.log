+    line_rows: list[int],
+    line_cols: list[int],
+    row_spans: list[tuple[int, int]],
+    col_spans: list[tuple[int, int]],
+    marker_cells: dict[tuple[int, int], int],
+    mask_cells: set[tuple[int, int]],
+) -> np.ndarray:
