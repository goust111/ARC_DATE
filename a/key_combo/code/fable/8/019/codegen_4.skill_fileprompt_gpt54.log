+
+def _cell_contents(
+    grid: np.ndarray,
+    bg: int,
+    line_color: int,
+    row_spans: list[tuple[int, int]],
+    col_spans: list[tuple[int, int]],
+) -> tuple[dict[tuple[int, int], int], list[tuple[int, int, np.ndarray]]]:
