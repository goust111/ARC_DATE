+        line_mask = np.zeros_like(g, dtype=bool)
+        line_mask[row_lines, :] = True
+        line_mask[:, col_lines] = True
+
+        if np.any(mask & ~line_mask):
+            continue
+        if np.any((g != bg) & line_mask & (g != color)):
+            continue
+
+        candidates.append((color, row_lines, col_lines))
