+
+    marked_rows = sorted(rng.choice(n_cell_rows, size=marker_count, replace=False).tolist())
+    marked_cols = sorted(rng.choice(n_cell_cols, size=marker_count, replace=False).tolist())
+    marked_row_set = set(marked_rows)
