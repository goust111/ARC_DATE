+    masks: list[tuple[int, int, np.ndarray]] = []
+
+    for ri, (r0, r1) in enumerate(row_spans):
+        for cj, (c0, c1) in enumerate(col_spans):
+            tile = grid[r0 : r1 + 1, c0 : c1 + 1]
+            active = (tile != bg) & (tile != line_color)
+            active_count = int(active.sum())
+            if active_count == 0:
