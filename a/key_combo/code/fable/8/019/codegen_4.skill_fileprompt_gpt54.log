+    c0, c1 = col_span
+    width = c1 - c0 + 1
+    length = int(rng.integers(2, min(3, width) + 1))
+    rr = int(rng.integers(r0, r1 + 1))
+    cc = int(rng.integers(c0, c1 - length + 2))
+    return rr, cc, length
+
+
