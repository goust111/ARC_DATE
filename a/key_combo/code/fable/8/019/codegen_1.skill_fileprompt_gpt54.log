148:
149:        # Phase 1: draw all main hull edges (avoids parallel lines blocking main lines).
150:        for (r0, c0), (r1, c1) in drawable_edges:
151:            _draw_line_bg_only(out, r0, c0, r1, c1, col, bg)
152:
153:        # Phase 2: draw parallel edges for the carried neighbors.
154:        for (r0, c0), (r1, c1) in drawable_edges:
155:            drs, dcs = _step_dir(r0, c0, r1, c1)
156:            for drn, dcn, ncol in carried:
