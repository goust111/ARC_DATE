72:def main(grid: np.ndarray) -> np.ndarray:
73:    """
74:    Complete outlined shapes and carry attached shadow pixels along their edges.
75:
76:    Input structure:
77:    - bg = background. Each active color marks vertices of an 8-direction aligned outline.
78:    - A start vertex can have adjacent non-bg, different-colored shadow pixels.
79:    - Other colored pixels may be distractors unless they lie on valid drawable edges.
80:
81:    Rule:
82:    - For each color, order its pixels by polar angle around their centroid to form a cycle.
83:    - Draw only horizontal, vertical, or 45-degree edges whose interiors are clear.
84:    - From the chosen start vertex, copy adjacent shadow offsets along each drawable edge
85:      when the parallel path is in bounds and clear.
86:
87:    Key insight: The main outline is reconstructed first, then the start vertex's neighbor offsets define parallel shadow strokes.
88:    """
89:    g = np.asarray(grid, dtype=int)
90:    h, w = g.shape
91:    bg = _bg_color(g)
92:
93:    out = g.copy()
94:
95:    colors = sorted(set(int(v) for v in np.unique(g)) - {bg})
96:    for col in colors:
97:        pts_rc = [tuple(map(int, p)) for p in np.argwhere(g == col)]
98:        if len(pts_rc) < 2:
99:            continue
100:
101:        cycle = _angle_cycle(pts_rc)
102:        if len(cycle) < 2:
103:            continue
104:
105:        # Choose a start vertex that has a non-bg, different-color neighbor in the original input.
106:        seed_idxs = []
107:        for i, (r, c) in enumerate(cycle):
108:            for drn, dcn in DIR8:
109:                rr = r + drn
110:                cc = c + dcn
111:                if 0 <= rr < h and 0 <= cc < w:
112:                    v = int(g[rr, cc])
113:                    if v != bg and v != col:
114:                        seed_idxs.append(i)
115:                        break
116:
117:        if seed_idxs:
118:            # Stable: pick the seed vertex with smallest (r,c).
119:            start = min(seed_idxs, key=lambda i: (cycle[i][0], cycle[i][1]))
120:        else:
121:            start = min(range(len(cycle)), key=lambda i: (cycle[i][0], cycle[i][1]))
122:
123:        cycle = cycle[start:] + cycle[:start]
124:
125:        # Carry neighbor offsets/colors from the chosen start vertex.
126:        carried: list[tuple[int, int, int]] = []
127:        sr0, sc0 = cycle[0]
128:        for drn, dcn in DIR8:
129:            rr = sr0 + drn
130:            cc = sc0 + dcn
131:            if 0 <= rr < h and 0 <= cc < w:
132:                v = int(g[rr, cc])
133:                if v != bg and v != col:
134:                    carried.append((drn, dcn, v))
135:
136:        if len(cycle) == 2:
