9:def main(grid: np.ndarray) -> np.ndarray:
10:    """
11:    Stamp the compact upper template into every marked lower mask cell as an expanded block image.
12:
13:    Input structure
14:    - The grid has one solid grey separator row.
15:    - Above it is a template region made of monochrome 2x2 blocks.
16:    - Below it is a same-size mask containing only background and red marker pixels.
17:
18:    Rule
19:    - Compress each 2x2 block in the upper region to one color, giving a small tile.
20:    - Build a blank output whose coarse cell grid is the lower mask and whose cell size is the tile size.
21:    - For every red marker pixel in the lower mask, paste the tile into the corresponding output block.
22:
23:    Key insight
24:    The top half encodes the motif at half resolution, while the lower red mask encodes which coarse cells receive that motif.
25:    """
26:    g = np.asarray(grid, dtype=int)
27:    assert g.ndim == 2 and g.size > 0, "expected a non-empty 2D grid"
28:
29:    bg = get_bg(g)
30:    separator_rows = np.flatnonzero(np.all(g == Color.GREY, axis=1))
31:    assert len(separator_rows) == 1, "expected exactly one solid grey separator row"
32:    sep = int(separator_rows[0])
33:
34:    top = g[:sep]
35:    mask = g[sep + 1 :]
36:    assert top.shape == mask.shape, "template and marker mask must have the same shape"
37:    assert top.shape[0] > 0 and top.shape[1] > 0, "template region must be non-empty"
38:    assert top.shape[0] % 2 == 0 and top.shape[1] % 2 == 0, "template must split into 2x2 blocks"
39:
40:    mask_colors = set(map(int, np.unique(mask)))
41:    assert mask_colors <= {int(bg), Color.RED}, "marker mask must contain only background and red"
42:    assert Color.RED in mask_colors, "expected at least one red marker"
43:
44:    tile_h, tile_w = top.shape[0] // 2, top.shape[1] // 2
45:    tile = np.empty((tile_h, tile_w), dtype=int)
46:    for tr in range(tile_h):
47:        for tc in range(tile_w):
48:            block = top[2 * tr : 2 * tr + 2, 2 * tc : 2 * tc + 2]
49:            color = int(block[0, 0])
50:            assert np.all(block == color), "each template block must be monochrome"
51:            tile[tr, tc] = color
52:
53:    out = np.full((mask.shape[0] * tile_h, mask.shape[1] * tile_w), int(bg), dtype=int)
54:    for mr, mc in np.argwhere(mask == Color.RED):
55:        r0 = int(mr) * tile_h
56:        c0 = int(mc) * tile_w
57:        out[r0 : r0 + tile_h, c0 : c0 + tile_w] = tile
58:
59:    return out
