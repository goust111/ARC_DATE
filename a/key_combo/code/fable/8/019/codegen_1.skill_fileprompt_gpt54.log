161:                cc0 = c0 + dcn
162:                rr1 = r1 + drn
163:                cc1 = c1 + dcn
164:                if not (0 <= rr0 < h and 0 <= cc0 < w and 0 <= rr1 < h and 0 <= cc1 < w):
