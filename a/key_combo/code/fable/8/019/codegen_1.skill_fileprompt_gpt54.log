157:def find_bordering_pixels_in_direction(r, c, w, h, direction):
158:    dr, dc = direction
159:    if dr == 1:  # right
160:        bordering_pixels = [(r + w, c + i) for i in range(h)]
161:    elif dr == -1:  # left
162:        bordering_pixels = [(r - 1, c + i) for i in range(h)]
163:    elif dc == 1:  # down
164:        bordering_pixels = [(r + i, c + h) for i in range(w)]
165:    elif dc == -1:  # up
166:        bordering_pixels = [(r + i, c - 1) for i in range(w)]
167:
168:    return np.array(bordering_pixels)
