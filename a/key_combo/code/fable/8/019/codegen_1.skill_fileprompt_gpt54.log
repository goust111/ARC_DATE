14:def main(input_grid: np.ndarray) -> np.ndarray:
15:    """
16:    Extract the framed central pattern, recolor it to the corner-marker color, and remove the frame.
17:
18:    Input structure:
19:    - A single non-black cluster sits on a black background.
20:    - Four matching corner pixels mark a one-cell frame around the central pattern.
21:    - The central pattern uses a different non-black color from the corner markers.
22:
23:    Rule:
24:    - Crop to the bounding box of all non-black pixels.
25:    - Use the corner color to recolor every non-black pixel in the crop.
26:    - Remove the outer one-cell frame and return only the recolored interior pattern.
27:
28:    Key insight:
29:    - The corner pixels encode both the extraction boundary and the final color for the
30:      interior shape.
31:    """
32:    # Extract the central pattern by the four corner squares
33:    output_grid = np.copy(input_grid)
34:
35:    # Crop the pattern out
36:    b = bbox(output_grid != Color.BLACK)
37:    assert b is not None
38:    output_grid = crop_bbox(output_grid, b)
39:
40:    # Get the color of the corner squares
41:    corner_color = output_grid[0, 0]
42:
43:    # Change the color of the central pattern to match the corner squares
44:    output_grid[output_grid != Color.BLACK] = corner_color
45:
46:    # Remove the one pixel border around the central pattern
47:    output_grid = output_grid[1:-1, 1:-1]
48:    return output_grid
