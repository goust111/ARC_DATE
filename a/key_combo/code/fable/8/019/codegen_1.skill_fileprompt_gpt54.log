118:    positions = random.sample([(r, c) for r in range(TILE_SHAPE[0]) for c in range(TILE_SHAPE[1])], filled)
119:    assignments = []
120:    for color, count in zip(colors, _gen_color_counts(filled, distinct)):
121:        assignments.extend([color] * count)
122:    random.shuffle(assignments)
123:    for (r, c), color in zip(positions, assignments):
124:        tile[r, c] = color
125:    return tile
