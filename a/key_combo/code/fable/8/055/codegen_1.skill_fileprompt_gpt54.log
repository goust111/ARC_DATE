+
+def _transform_between(mask: np.ndarray, src: tuple[int, int], dst: tuple[int, int]) -> np.ndarray:
+    out = np.asarray(mask, dtype=bool)
+    if src[0] != dst[0]:
+        out = np.flipud(out)
+    if src[1] != dst[1]:
