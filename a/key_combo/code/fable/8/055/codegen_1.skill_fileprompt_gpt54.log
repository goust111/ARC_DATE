+    col_ranges = []
+    cursor = 0
+    for r in range(rows):
+        row_ranges.append((cursor, cursor + cell_h - 1))
+        cursor += cell_h
+        if r != rows - 1:
+            canvas[cursor, :] = divider
+            cursor += 1
