+    seen = {tuple(map(int, coords[0]))}
+    stack = [tuple(map(int, coords[0]))]
+    cells = {tuple(map(int, pt)) for pt in coords}
+    while stack:
+        r, c = stack.pop()
+        for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+            nxt = (nr, nc)
+            if nxt in cells and nxt not in seen:
