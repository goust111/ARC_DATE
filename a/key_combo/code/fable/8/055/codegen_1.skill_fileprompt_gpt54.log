+def _find_blocks(cell_colors: np.ndarray) -> tuple[list[dict], set[tuple[int, int]]]:
+    blocks = []
+    used_present: set[tuple[int, int]] = set()
+    rows, cols = cell_colors.shape
+    for r in range(rows - 1):
+        for c in range(cols - 1):
