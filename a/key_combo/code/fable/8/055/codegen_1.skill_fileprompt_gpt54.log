+        sr0, sr1 = row_ranges[source["pos"][0]]
+        sc0, sc1 = col_ranges[source["pos"][1]]
+        out[sr0 : sr1 + 1, sc0 : sc1 + 1] = bg
+
+        tr0, tr1 = row_ranges[missing[0]]
+        tc0, tc1 = col_ranges[missing[1]]
+        out[tr0 : tr1 + 1, tc0 : tc1 + 1] = bg
