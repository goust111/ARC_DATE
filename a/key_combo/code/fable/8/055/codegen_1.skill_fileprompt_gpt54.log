+
+def _paint_cell(
+    grid: np.ndarray,
+    row_ranges: list[tuple[int, int]],
+    col_ranges: list[tuple[int, int]],
+    cell: tuple[int, int],
+    mask: np.ndarray,
+    color: int,
+) -> None:
+    r0, r1 = row_ranges[cell[0]]
+    c0, c1 = col_ranges[cell[1]]
