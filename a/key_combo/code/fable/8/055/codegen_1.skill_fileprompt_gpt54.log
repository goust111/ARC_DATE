+
+def _build_canvas(
+    rows: int,
+    cols: int,
+    cell_h: int,
+    cell_w: int,
+    bg: int,
+    divider: int,
+) -> tuple[np.ndarray, list[tuple[int, int]], list[tuple[int, int]]]:
+    height = rows * cell_h + (rows - 1)
+    width = cols * cell_w + (cols - 1)
