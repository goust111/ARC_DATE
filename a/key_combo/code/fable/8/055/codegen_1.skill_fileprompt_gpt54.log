+    for rr, (r0, r1) in enumerate(row_ranges):
+        for cc, (c0, c1) in enumerate(col_ranges):
+            cell = grid[r0 : r1 + 1, c0 : c1 + 1]
+            colors = sorted(set(map(int, np.unique(cell))) - {bg, divider})
+            if not colors:
