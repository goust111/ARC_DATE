+            if marker_cells.shape != (1, 2):
+                raise AssertionError("each rectangle must contain exactly one interior marker pixel")
+            mr = int(marker_cells[0, 0]) + r0 + 1
+            mc = int(marker_cells[0, 1]) + c0 + 1
+            center = ((r0 + r1) // 2, (c0 + c1) // 2)
+            rectangles.append(
