+    35: ((5, 7), (7, 5)),
+    45: ((5, 9), (9, 5)),
+    49: ((7, 7),),
+    63: ((7, 9), (9, 7)),
+    81: ((9, 9),),
+}
+MIN_RECT_GAP = 1
+MIN_VISIBLE_INTERSECTIONS = 4
