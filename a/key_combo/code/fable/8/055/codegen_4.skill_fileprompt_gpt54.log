+from __future__ import annotations
+
+from dataclasses import dataclass
+
+import numpy as np
+
+
+PALETTE = tuple(range(10))
+GEN_RETRIES = 500
+GRID_MIN = 18
+GRID_MAX = 30
+RECT_COUNT_OPTIONS = (3, 4, 5)
+AREA_OPTIONS = (25, 35, 45, 49, 63, 81)
+AREA_TO_SHAPES = {
