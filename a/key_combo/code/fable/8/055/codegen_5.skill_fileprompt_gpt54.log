+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords_arr,
+                    "area": int(coords_arr.shape[0]),
+                }
+            )
+    return comps
+
+
+def _output_signature(grid: np.ndarray) -> bytes:
+    return grid.shape[0].to_bytes(1, "little") + grid.shape[1].to_bytes(1, "little") + grid.tobytes()
