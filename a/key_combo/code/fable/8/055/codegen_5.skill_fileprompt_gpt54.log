  77: def main(grid: np.ndarray) -> np.ndarray:
  78:     """
  79:     Complete each 2-by-2 lattice-cell quartet by adding its missing reflected sprite.
  80: 
  81:     Input structure:
  82:     - The background is the most common color.
  83:     - One non-background color forms complete horizontal and vertical divider
  84:       lines, partitioning the grid into rectangular cells.
  85:     - Every occupied cell away from the dividers contains pixels of exactly one
  86:       non-background, non-divider color.
  87:     - For each sprite color, occupied cells occur as connected three-cell groups
  88:       inside a 2-by-2 block of equal-sized cells.
  89: 
  90:     Rule:
  91:     - Split the grid at the divider rows and columns.
  92:     - For each three-cell monochrome group in a 2-by-2 cell block, find the one
  93:       empty cell in that block.
  94:     - Reflect each of the three present cell-local sprites vertically and/or
  95:       horizontally according to its relative position to the missing cell; all
  96:       three reflections must produce the same mask.
  97:     - Paint that agreed reflected sprite into the missing cell, leaving dividers
  98:       and all existing cells unchanged.
  99: 
 100:     Key insight:
 101:     - The sprites are mirror variants around the center of a 2-by-2 block of
 102:       lattice cells, so any three visible variants uniquely determine the fourth.
 103:     """
 104:     g = np.asarray(grid, dtype=int)
 105:     bg = get_bg(g)
 106:     divider, divider_rows, divider_cols = _divider_grid(g, bg)
 107:     row_ranges = _ranges_between(g.shape[0], divider_rows)
 108:     col_ranges = _ranges_between(g.shape[1], divider_cols)
 109:     assert len(row_ranges) >= 2 and len(col_ranges) >= 2, "expected at least one 2-by-2 cell block"
 110: 
 111:     cells = _cell_colors(g, row_ranges, col_ranges, bg, divider)
 112:     out = g.copy()
 113: 
 114:     for color in colors_present(g, exclude={bg, divider}):
 115:         for comp in components_mask(cells == color, connectivity=4):
 116:             assert comp.shape[0] == 3, "each sprite-color group must contain three occupied cells"
 117:             group_r0, group_c0 = map(int, comp.min(axis=0))
 118:             group_r1, group_c1 = map(int, comp.max(axis=0))
 119:             assert group_r1 - group_r0 == 1 and group_c1 - group_c0 == 1, (
 120:                 "each sprite-color group must fit one 2-by-2 cell block"
 121:             )
 122: 
 123:             block = {
 124:                 (r, c)
 125:                 for r in (group_r0, group_r1)
 126:                 for c in (group_c0, group_c1)
 127:             }
 128:             have = {(int(r), int(c)) for r, c in comp}
 129:             missing_cells = block - have
 130:             assert len(missing_cells) == 1, "expected one missing cell in the 2-by-2 block"
 131:             missing = next(iter(missing_cells))
 132:             missing_r, missing_c = missing
 133:             assert cells[missing_r, missing_c] == -1, "missing quartet cell must be empty"
 134: 
 135:             heights = {row_ranges[r][1] - row_ranges[r][0] + 1 for r, _ in block}
 136:             widths = {col_ranges[c][1] - col_ranges[c][0] + 1 for _, c in block}
 137:             assert len(heights) == 1 and len(widths) == 1, "quartet cells must be equal-sized"
 138: 
 139:             pred = _reflected_to_missing(g, row_ranges, col_ranges, have, missing)
 140:             assert set(map(int, pred.ravel())) <= {bg, int(color)}, (
 141:                 "reflected sprite must contain only background and its color"
 142:             )
 143: 
 144:             r0, r1 = row_ranges[missing_r]
 145:             c0, c1 = col_ranges[missing_c]
 146:             assert np.all(out[r0 : r1 + 1, c0 : c1 + 1] == bg), "target cell must be empty"
 147:             out[r0 : r1 + 1, c0 : c1 + 1] = pred
 148: 
