+    out = main(grid)
+    out_sig = _output_signature(out)
+    inp_sig = _output_signature(grid)
+    if out_sig in _SEEN_OUTPUT_SIGS or inp_sig in _SEEN_INPUT_SIGS:
+        return None
+    _SEEN_OUTPUT_SIGS.add(out_sig)
+    _SEEN_INPUT_SIGS.add(inp_sig)
+    return grid
