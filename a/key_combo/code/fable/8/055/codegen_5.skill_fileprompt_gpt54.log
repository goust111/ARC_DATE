   144	    total_area = sum(area_by_color.values())
   145	    out_side = math.isqrt(total_area)
   146	    assert out_side * out_side == total_area and out_side % 2 == 1, "total area must be an odd square"
   147	
   148	    out = np.full((out_side, out_side), bg, dtype=int)
   149	    out_coords = _spiral_coords(out_side)
