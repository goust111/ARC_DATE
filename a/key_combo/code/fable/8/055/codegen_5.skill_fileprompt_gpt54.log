spec:
  grid: square, even side length 12-26; size = 4*arm + 2*ceil(arm/2) + 6 [observed]
  background: black (0)
  cross:
    color: 8 (teal)
    shape: plus sign with center hole (center cell = 0)
    arms: 4 cardinal, all equal length 1-4
    total_8_cells: 4 * arm_len
    center_position: not grid-center; placed so all tip-to-border gaps >= arm_len + 2
  output:
    transformation: four clockwise spirals grow from arm tips, filling ~50% of grid
    spiral_rules: |
      each arm tip launches a turtle heading 90-deg clockwise from its outward direction;
      priority: turn right > go straight > turn left (left only if not on border);
      normal step = 2 cells, step immediately after a turn = 1 cell;
      each new cell must have 1-cell orthogonal gap from all existing walls except predecessor
    post_processing: parity-based cleanup and border corrections depend on (cr+cc)%2 and arm_len%2
    fill_fraction: 0.48-0.52
    connectivity: each 8-cell has at most 2 orthogonal 8-neighbors (path-like)

generation_strategy:
