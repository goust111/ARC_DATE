+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_RETRY_LIMIT):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid concentric counting-frame input")

