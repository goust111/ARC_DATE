+    if mode == "compact":
+        products = [
+            h * w
+            for h in range(1, min(area, 6) + 1)
+            for w in range(1, min(area, 6) + 1)
+            if h * w >= area
+        ]
+        min_product = min(products)
+        candidates = [
+            (h, w)
+            for h in range(1, min(area, 6) + 1)
+            for w in range(1, min(area, 6) + 1)
+            if min_product <= h * w <= min_product + 1 and h * w >= area
+        ]
+        random.shuffle(candidates)
+        for h, w in candidates:
