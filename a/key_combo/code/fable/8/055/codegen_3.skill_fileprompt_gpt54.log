+
+    adjacent = [i for i in range(color_count - 1) if 3 <= areas[i] and areas[i + 1] - areas[i] <= 3]
+    if not adjacent:
+        return None
+    target = random.choice(adjacent)
+
+    counts = random.sample(COUNT_POOL, color_count)
+    while counts == sorted(counts):
+        random.shuffle(counts)
+
