+def _monotone_path_bbox(area: int, h: int, w: int) -> np.ndarray:
+    if random.random() < 0.5:
+        r, c = 0, 0
+        steps = [(1, 0)] * (h - 1) + [(0, 1)] * (w - 1)
+    else:
+        r, c = 0, w - 1
+        steps = [(1, 0)] * (h - 1) + [(0, -1)] * (w - 1)
+    random.shuffle(steps)
