+
+    if not _semantic_checks(grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_RETRY_LIMIT):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
