+BACKGROUND = 0
+PALETTE = tuple(range(1, 10))
+
+COLOR_COUNT_CHOICES = (2, 3, 4)
+COUNT_POOL = (2, 3, 4, 5)
+AREA_POOL = tuple(range(2, 9))
