+        "missed_counts": dict(missed_counts),
+        "sand_positions": sand_positions,
+        "need_overflow": need_overflow,
+        "need_missed": need_missed,
+        "need_zero": need_zero,
+    }
+    return grid, meta
+
+
+def _validate_instance(grid: np.ndarray, meta: dict) -> bool:
+    parsed = _find_cups(grid)
