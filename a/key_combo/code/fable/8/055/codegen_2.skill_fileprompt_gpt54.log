+def _gen_attempt() -> tuple[np.ndarray, dict] | None:
+    h = random.randint(20, 29)
+    w = random.randint(18, 29)
+    n_cups = random.choices([1, 2, 3], weights=[1, 5, 4])[0]
+    band_h = random.randint(7, 10)
