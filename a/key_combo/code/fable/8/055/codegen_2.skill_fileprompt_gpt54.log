+        edges = [cols[0], cols[-1]]
+        random.shuffle(edges)
+        take = min(2, count)
+        out.extend(edges[:take])
+    while len(out) < count:
+        pool = cols.copy()
+        random.shuffle(pool)
+        out.extend(pool)
+    return out[:count]
