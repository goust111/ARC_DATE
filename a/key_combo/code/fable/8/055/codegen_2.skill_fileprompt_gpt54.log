+    for idx, cup in enumerate(cups):
+        total = per_cup[idx] + 1
+        positions = _stack_positions(cup, h)
+        assert total <= len(positions), "overflow exceeds the canvas top"
+        for r, c in positions[:total]:
+            assert out[r, c] == BG
+            out[r, c] = cup["marker_color"]
