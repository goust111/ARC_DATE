+def _place_sands(shape: tuple[int, int], band_h: int, jobs: list[int]) -> list[tuple[int, int]] | None:
+    h, _w = shape
+    assert band_h < h
+    target = list(jobs)
+    for _ in range(120):
+        random.shuffle(target)
+        target.sort(key=lambda c: (target.count(c), random.random()), reverse=True)
+        placed: list[tuple[int, int]] = []
+        used = set()
+        ok = True
+        for col in target:
+            rows = list(range(band_h))
+            random.shuffle(rows)
+            rows.sort(reverse=True)
+            pick = None
+            for row in rows:
+                if (row, col) in used:
+                    continue
+                blocked = False
+                for rr, cc in placed:
+                    if max(abs(rr - row), abs(cc - col)) <= 1:
+                        blocked = True
+                        break
