+    if meta["need_missed"] and not meta["missed_counts"]:
+        return False
+    if meta["need_zero"] and not any(cup["claimed"] == 0 for cup in meta["cups"]):
+        return False
+    if not any(cup["claimed"] > 0 for cup in meta["cups"]):
