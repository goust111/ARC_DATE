+def _draw_cup(grid: np.ndarray, cup: dict) -> None:
+    r0, c0, r1, c1 = cup["bbox"]
+    color = cup["wall_color"]
+    grid[r0:r1 + 1, c0] = color
+    grid[r0:r1 + 1, c1] = color
+    grid[r1, c0:c1 + 1] = color
