+def _claim_columns(mouth_cols: tuple[int, ...], count: int) -> list[int]:
+    if count <= 0:
+        return []
+    cols = list(mouth_cols)
+    out: list[int] = []
+    if len(cols) >= 2 and count >= 2:
+        edges = [cols[0], cols[-1]]
+        random.shuffle(edges)
+        take = min(2, count)
+        out.extend(edges[:take])
+    while len(out) < count:
+        pool = cols.copy()
+        random.shuffle(pool)
+        out.extend(pool)
+    return out[:count]
