+                    continue
+                blocked = False
+                for rr, cc in placed:
+                    if max(abs(rr - row), abs(cc - col)) <= 1:
+                        blocked = True
+                        break
+                if not blocked:
+                    pick = (row, col)
+                    break
+            if pick is None:
+                ok = False
+                break
+            placed.append(pick)
+            used.add(pick)
+        if ok:
