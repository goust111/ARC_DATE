+                "wall_color": colors[2 * idx],
+                "marker_color": colors[2 * idx + 1],
+                "marker_pos": marker_pos,
+                "mouth_cols": tuple(range(c0 + 1, c1)),
+                "inner_w": bw - 2,
+                "inner_h": bh - 2,
+                "capacity": (bw - 2) * (bh - 2),
+            }
+        )
+    return cups
+
