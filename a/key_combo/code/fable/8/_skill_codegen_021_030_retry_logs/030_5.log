+DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+PATH_COLORS = [Color.BLUE, Color.RED, Color.GREEN, Color.YELLOW, Color.PINK, Color.ORANGE, Color.TEAL, Color.MAROON]
+GEN_ATTEMPTS = 1200
+SELF_CHECK_ATTEMPTS = 200
