        cols = np.arange(c0, c1 + 1)[None, :]
        depth = np.minimum(
            np.minimum(rows - r0, r1 - rows),
            np.minimum(cols - c0, c1 - cols),
        )
        region = out[r0 : r1 + 1, c0 : c1 + 1]
        region[(depth > 0) & (depth % 2 == 1)] = ODD_DEPTH_COLOR
        region[(depth > 0) & (depth % 2 == 0)] = EVEN_DEPTH_COLOR
    return out

