+    chosen_holes: dict[tuple[tuple[int, int], ...], list[tuple[int, int]]] = {}
+    for orb in hole_orbits:
+        key = tuple(sorted(orb))
+        hole_count = rng.randint(1, 3)
+        holes = rng.sample(orb, hole_count)
