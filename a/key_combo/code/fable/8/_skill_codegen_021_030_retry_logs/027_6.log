+def _find_structures(grid: np.ndarray) -> tuple[tuple[int, int, int, int], tuple[int, int, int, int]]:
+    g = np.asarray(grid, dtype=int)
+    bg = get_bg(g)
+    comps = components_mask((g != bg) & (g != BLACK), connectivity=4)
+    if len(comps) < 2:
