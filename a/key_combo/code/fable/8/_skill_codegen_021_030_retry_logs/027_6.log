+    rows = [(int(g[r, lc0]), int(g[r, lc0 + 1])) for r in range(lr0, lr1 + 1)]
+    out = g.copy()
+    active = (~legend_mask) & (out != bg) & (out != BLACK)
+    for src, dst in rows:
+        hit = active & (out == src)
+        out[hit] = dst
