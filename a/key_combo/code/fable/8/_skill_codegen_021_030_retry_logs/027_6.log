+    patch = out[or0 : or1 + 1, oc0 : oc1 + 1]
+    visited: set[tuple[tuple[int, int], ...]] = set()
+    for r in range(n):
+        for c in range(n):
+            orbit = tuple(sorted(_orbit_local((r, c), n)))
+            if orbit in visited:
+                continue
+            visited.add(orbit)
+            colors = {int(patch[rr, cc]) for rr, cc in orbit if int(patch[rr, cc]) not in (bg, BLACK)}
+            if len(colors) != 1:
