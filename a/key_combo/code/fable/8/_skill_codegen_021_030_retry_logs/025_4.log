+            local_c = int(c - left)
+            if occ_side == "right" and not (local_c > axis):
+                return False
+            if occ_side == "left" and not (local_c < axis):
+                return False
+            mirror_c = w - 1 - local_c
+            if not local_visible[local_r, mirror_c]:
+                return False
+    return True
+
