+            assert len(seen) == 1, "pair overlap must reveal a unique front color"
+            top_color = next(iter(seen))
+            if top_color == a["color"]:
+                edges.add((b["color"], a["color"]))
+            else:
+                edges.add((a["color"], b["color"]))
+    return edges
