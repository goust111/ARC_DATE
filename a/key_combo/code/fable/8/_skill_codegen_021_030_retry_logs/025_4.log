+            mask_a = a["full"][r0 - a_r0 : r1 - a_r0 + 1, c0 - a_c0 : c1 - a_c0 + 1]
+            mask_b = b["full"][r0 - b_r0 : r1 - b_r0 + 1, c0 - b_c0 : c1 - b_c0 + 1]
+            overlap = mask_a & mask_b
