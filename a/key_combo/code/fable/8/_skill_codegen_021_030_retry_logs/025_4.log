+            if occ_side == "left" and not (local_c < axis):
+                return False
+            mirror_c = w - 1 - local_c
+            if not local_visible[local_r, mirror_c]:
+                return False
+    return True
+
+
+def _generate_case(*, return_meta: bool = False):
+    rng = random.Random()
+    for _ in range(GEN_RETRIES):
