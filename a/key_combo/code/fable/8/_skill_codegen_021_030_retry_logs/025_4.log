MATCH_COUNT_MIN = 1
MATCH_COUNT_MAX_EXCL = 6
DISTRACTOR_COUNT_MIN = 11
DISTRACTOR_COUNT_MAX_EXCL = 36
GEN_RETRY_LIMIT = 300


def _gen_mask_from_cells(shape: tuple[int, int], cells) -> np.ndarray:
    mask = np.zeros(shape, dtype=bool)
    for r, c in cells:
        mask[r, c] = True
