+    shapes[0]["top"] = 0
+    shapes[0]["left"] = 0
+    for i in range(1, len(shapes)):
+        prev = shapes[i - 1]
+        cur = shapes[i]
+        h0 = prev["mask"].shape[0]
+        h1 = cur["mask"].shape[0]
+        delta_top = rng.randint(2, min(4, h0 - 1, h1 - 1))
