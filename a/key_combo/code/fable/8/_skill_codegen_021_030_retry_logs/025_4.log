+            {
+                "color": int(shape["color"]),
+                "bbox": (0, 0, h - 1, w - 1),
+                "visible": shape["mask"].copy(),
+                "full": shape["mask"].copy(),
+            }
+        )
+    order = [int(shape["color"]) for shape in shapes]
+    return _render_output(objects, order)
+
