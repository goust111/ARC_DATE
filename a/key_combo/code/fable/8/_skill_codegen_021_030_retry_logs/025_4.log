GRID_SIZE = 23
BG_COLOR = 0
FILL_COLOR = 1
MARKER_COLOR = 4

# Source rectangle and interior marker constraints.
SOURCE_H_MIN = 3
SOURCE_H_MAX_EXCL = 6
SOURCE_W_MIN = 4
SOURCE_W_MAX_EXCL = 6
SOURCE_MARK_MIN = 2
SOURCE_MARK_MAX = 3
SOURCE_MIN_UNIQUE_TRANSFORMS = 2

