+
+def _expand_bbox(bbox: BBox, pad: int, shape: tuple[int, int]) -> BBox:
+    h, w = shape
+    return (
+        max(0, bbox[0] - pad),
+        max(0, bbox[1] - pad),
+        min(h - 1, bbox[2] + pad),
+        min(w - 1, bbox[3] + pad),
+    )
+
+
+def _strictly_inside(inner: BBox, outer: BBox) -> bool:
+    return outer[0] < inner[0] and outer[1] < inner[1] and inner[2] < outer[2] and inner[3] < outer[3]
