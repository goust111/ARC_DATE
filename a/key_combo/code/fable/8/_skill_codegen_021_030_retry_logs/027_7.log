+
+        truths = [True, False] + [random.choice([True, False]) for _ in range(frame_count - 2)]
+        random.shuffle(truths)
+        modes = ["single", "multi"] + [random.choice(["single", "multi"]) for _ in range(frame_count - 2)]
+        random.shuffle(modes)
+
+        all_forbidden = [spec["forbidden"] for spec in specs]
+        valid = True
