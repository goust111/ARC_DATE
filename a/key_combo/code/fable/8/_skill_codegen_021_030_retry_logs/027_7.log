+    while len(cells) < area:
+        frontier = []
+        for r, c in cells:
+            for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                nxt = (r + dr, c + dc)
+                if nxt not in cells:
+                    frontier.append(nxt)
+        cells.add(random.choice(frontier))
