+    random.shuffle(parts)
+    return parts
+
+
+def _dot_columns(interior_width: int, claim: int) -> list[int]:
+    candidates = list(range(2, interior_width, 2))
+    assert claim <= len(candidates)
+    cols = sorted(random.sample(candidates, claim))
+    return cols
+
