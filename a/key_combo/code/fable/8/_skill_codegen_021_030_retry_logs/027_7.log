+    width = _bbox_w(component["bbox"])
+    if height < 3 or width < 3:
+        return False
+    rel = component["coords"] - np.array([r0, c0], dtype=int)
+    mask = np.zeros((height, width), dtype=bool)
+    mask[rel[:, 0], rel[:, 1]] = True
