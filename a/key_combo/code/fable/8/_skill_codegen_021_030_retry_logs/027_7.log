+    for n_parts in range(1, max_parts + 1):
+        parts = [1] * n_parts
+        remain = total - n_parts
+        while remain > 0:
+            i = random.randrange(n_parts)
+            parts[i] += 1
+            remain -= 1
+        if any(part > 1 for part in parts):
