+    cursor = base_left
+    for color, (fh, fw) in zip(colors, sizes):
+        max_top = height - fh - 1
+        if max_top < 1:
+            return None
+        top = random.randint(1, max_top)
+        left = cursor
+        cursor += fw + 2
