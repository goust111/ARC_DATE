from importlib.machinery import SourceFileLoader
from pathlib import Path
import hashlib
import numpy as np

p = Path('/home/lixinyu/snap/a/key_combo/code/fable/8/027/7.py')
mod = SourceFileLoader('new_arc_task', str(p)).load_module()

sigs = set()
true_seen = false_seen = False
single_seen = multi_seen = False
for i in range(120):
    inp = mod.generate_input()
    out = mod.main(inp)
    assert isinstance(inp, np.ndarray)
    assert isinstance(out, np.ndarray)
    assert inp.ndim == 2 and max(inp.shape) <= 30, f'input grid exceeds 30x30: {inp.shape}'
    assert out.ndim == 2 and max(out.shape) <= 30, f'output grid exceeds 30x30: {out.shape}'
    sigs.add(hashlib.md5(inp.tobytes() + str(inp.shape).encode()).hexdigest())
    parsed = mod._parse_case(inp)
    assert parsed is not None
    true_seen |= any(item['truth'] for item in parsed)
    false_seen |= any(not item['truth'] for item in parsed)
    single_seen |= any(all(area == 1 for area in item['outer_areas']) for item in parsed)
    multi_seen |= any(any(area > 1 for area in item['outer_areas']) for item in parsed)

for i in range(80):
    inp2, expected, specs = mod._generate_case(return_spec=True)
    assert isinstance(inp2, np.ndarray)
    real = mod.main(inp2)
    assert np.array_equal(real, expected)

    wrong1 = inp2.copy()
    bg = mod.get_bg(inp2)
    for spec in specs:
        object_count = len(spec['pattern_parts'])
        if spec['claim'] == object_count:
            for r, c in spec['pattern_coords']:
                wrong1[r, c] = bg
        else:
            for r, c in spec['frame_coords'] | spec['dot_coords']:
                wrong1[r, c] = bg

    wrong2 = inp2.copy()
    for spec in specs:
        if spec['claim'] == spec['actual']:
            for r, c in spec['frame_coords'] | spec['dot_coords']:
                wrong2[r, c] = bg
        else:
            for r, c in spec['pattern_coords']:
                wrong2[r, c] = bg

    assert not np.array_equal(real, wrong1)
    assert not np.array_equal(real, wrong2)

print('variants', len(sigs))
print('truth branches', true_seen, false_seen)
