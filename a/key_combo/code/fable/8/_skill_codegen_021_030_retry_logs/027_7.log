+def _bbox_w(bbox: BBox) -> int:
+    return int(bbox[3] - bbox[1] + 1)
+
+
+def _rect_overlap(a: BBox, b: BBox) -> bool:
+    return not (a[2] < b[0] or b[2] < a[0] or a[3] < b[1] or b[3] < a[1])
