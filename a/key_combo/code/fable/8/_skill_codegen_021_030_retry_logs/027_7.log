+
+
+def _generate_case(return_spec: bool = False):
+    for _ in range(MAX_GEN_ATTEMPTS):
+        frame_count = random.choices([2, 3, 4], weights=[1, 4, 3])[0]
+        bg = random.choice(PALETTE)
