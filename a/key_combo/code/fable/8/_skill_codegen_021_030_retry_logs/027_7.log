+
+        truths = [True, False] + [random.choice([True, False]) for _ in range(frame_count - 2)]
+        random.shuffle(truths)
+        modes = ["single", "multi"] + [random.choice(["single", "multi"]) for _ in range(frame_count - 2)]
+        random.shuffle(modes)
+
+        all_forbidden = [spec["forbidden"] for spec in specs]
+        valid = True
+        saw_single = False
+        saw_multi = False
+        for spec, truth, mode in zip(specs, truths, modes):
+            bbox = spec["bbox"]
+            interior_width = _bbox_w(bbox) - 2
+            capacity = len(range(2, interior_width, 2))
+            max_area = min(5, capacity)
+            min_area = 2 if mode == "multi" else 1
+            if min_area > max_area:
+                valid = False
+                break
+            actual = random.randint(min_area, max_area)
+            if mode == "single":
+                parts = [1] * actual
+                saw_single = True
+            else:
+                parts = _partition_area(actual, require_multi=True)
+                saw_multi = True
+            if truth:
