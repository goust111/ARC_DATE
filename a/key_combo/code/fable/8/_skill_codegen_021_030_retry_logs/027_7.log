+def _choose_frame_sizes(frame_count: int) -> list[tuple[int, int]]:
+    while True:
+        sizes = []
+        for _ in range(frame_count):
+            height = random.choice([5, 6, 7, 8])
+            width = random.choice([7, 9, 11])
+            sizes.append((height, width))
