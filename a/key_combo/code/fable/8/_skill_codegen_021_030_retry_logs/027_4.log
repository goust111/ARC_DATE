+        prev_cell = (contour_start[0], contour_start[1] - 1)
+        if canvas[contour_start] != 0 or canvas[prev_cell] != 0:
+            continue
+
+        mask = canvas == 1
+        contour = _best_contour_path(canvas, mask, contour_start, (0, 1), 0)
