+def _turn_options(entry_dir: tuple[int, int]) -> tuple[tuple[int, int], tuple[int, int]]:
+    dr, dc = entry_dir
+    if dr:
+        return (dr, -1), (dr, 1)
+    return (-1, dc), (1, dc)
