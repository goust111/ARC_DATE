+    return g, bg, marker, obstacle, marker_pos, comps, comp_masks, comp_index
+
+
+def _sightline_candidates(
+    g: np.ndarray,
+    start: tuple[int, int],
+    bg: int,
+    comp_index: np.ndarray,
+    remaining: set[int],
+) -> list[dict]:
+    sr, sc = start
+    candidates: list[dict] = []
+    for direction in DIRS4:
+        dr, dc = direction
+        r, c = sr + dr, sc + dc
