+    route_set = {current}
+
+    for _ in range(obstacle_count):
+        placed = False
+        for _ in range(PLACEMENT_RETRIES):
+            spec = _random_obstacle_spec(rng)
+            gap = rng.randint(GAP_RANGE[0], GAP_RANGE[1])
+            dr, dc = spec["entry_dir"]
