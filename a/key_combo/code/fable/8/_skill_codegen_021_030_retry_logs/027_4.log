+try:
+    from arc_utils import find_components, get_bg, in_bounds, neighbors4
+except Exception:
+    def get_bg(grid: np.ndarray) -> int:
+        return int(Counter(map(int, np.asarray(grid).ravel())).most_common(1)[0][0])
+
+    def in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+        h, w = map(int, shape)
+        return 0 <= int(r) < h and 0 <= int(c) < w
+
+    def neighbors4(r: int, c: int):
+        yield int(r) - 1, int(c)
+        yield int(r) + 1, int(c)
+        yield int(r), int(c) - 1
+        yield int(r), int(c) + 1
+
+    def find_components(
+        grid: np.ndarray,
+        *,
+        bg: int | None = None,
+        connectivity: int = 4,
+        monochromatic: bool = True,
+        colors: list[int] | None = None,
+        return_format: str = "dict",
+    ):
+        assert connectivity == 4 and monochromatic and return_format == "dict"
+        g = np.asarray(grid, dtype=int)
+        if bg is None:
+            bg = get_bg(g)
+        allowed = {int(c) for c in colors} if colors is not None else set(map(int, np.unique(g))) - {int(bg)}
+        seen: set[tuple[int, int]] = set()
+        out: list[dict] = []
+        for r in range(g.shape[0]):
+            for c in range(g.shape[1]):
+                if (r, c) in seen or int(g[r, c]) == int(bg) or int(g[r, c]) not in allowed:
+                    continue
+                color = int(g[r, c])
+                stack = [(r, c)]
+                coords: list[tuple[int, int]] = []
+                seen.add((r, c))
+                while stack:
+                    rr, cc = stack.pop()
+                    coords.append((rr, cc))
+                    for nr, nc in neighbors4(rr, cc):
+                        if not in_bounds(g.shape, nr, nc):
+                            continue
+                        if (nr, nc) in seen or int(g[nr, nc]) != color:
+                            continue
+                        seen.add((nr, nc))
+                        stack.append((nr, nc))
+                arr = np.asarray(coords, dtype=int)
+                r0 = int(arr[:, 0].min())
+                c0 = int(arr[:, 1].min())
+                r1 = int(arr[:, 0].max())
+                c1 = int(arr[:, 1].max())
+                out.append({"color": color, "coords": arr, "bbox": (r0, c0, r1, c1), "area": int(arr.shape[0])})
+        return out
