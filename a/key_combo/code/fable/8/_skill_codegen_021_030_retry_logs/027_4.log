+
+def _line_cells(start: tuple[int, int], direction: tuple[int, int], steps: int) -> list[tuple[int, int]]:
+    sr, sc = start
+    dr, dc = direction
+    return [(int(sr + dr * i), int(sc + dc * i)) for i in range(int(steps) + 1)]
