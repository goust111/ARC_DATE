    return [(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)]


def trace(shape, start):
    h, w = shape
    r, c = start
    dr = 1 if r == 0 else -1
    dc = 1 if c == 0 else -1
    path = [(r, c, 0)]
    b = 0
    for _ in range(4 * max(1, (h - 1) * (w - 1) + 1)):
        rf = not (0 <= r + dr < h)
        cf = not (0 <= c + dc < w)
        if rf:
            dr *= -1
        if cf:
            dc *= -1
        b += int(rf) + int(cf)
        r += dr
        c += dc
        path.append((r, c, b))
        if (r in (0, h - 1)) and (c in (0, w - 1)):
            return path
    raise AssertionError('non-terminating path')


for i in range(140):
    inp = mod.generate_input()
    out = mod.main(inp)
    assert isinstance(inp, np.ndarray)
    assert isinstance(out, np.ndarray)
    assert inp.ndim == 2 and max(inp.shape) <= 30, f'input grid exceeds 30x30: {inp.shape}'
    assert out.ndim == 2 and max(out.shape) <= 30, f'output grid exceeds 30x30: {out.shape}'
    sigs.add(hashlib.md5(inp.tobytes() + str(inp.shape).encode()).hexdigest())

    seeds = []
    for corner in corners(inp.shape):
        v = int(inp[corner])
        if v not in (0, 5):
            seeds.append((corner, v))
    assert 1 <= len(seeds) <= 2
    seed_counts.add(len(seeds))

    expected = inp.copy()
    seen_cells = []
    recolored_here = 0
    hit_after_bounce_here = False
    sample_direct = False
    for corner, color in seeds:
        path = trace(inp.shape, corner)
        cells = {(r, c) for r, c, _ in path}
        for prev in seen_cells:
            assert cells.isdisjoint(prev), 'overlapping seed paths'
        seen_cells.append(cells)
        interior = path[1:-1]
        if not any(b > 0 for _r, _c, b in interior):
            sample_direct = True
        for r, c, b in interior:
            if expected[r, c] == 5:
                expected[r, c] = color
                recolored_here += 1
                if b > 0:
                    hit_after_bounce_here = True
    assert np.array_equal(out, expected), 'semantic oracle mismatch'
    recolor_counts.append(recolored_here)
    if hit_after_bounce_here:
        after_bounce_hits += 1
    if sample_direct:
        direct_samples += 1

    grey_in = set(map(tuple, np.argwhere(inp == 5)))
    changed = set(map(tuple, np.argwhere((inp == 5) & (out "'!= 5))))
    unchanged = set(map(tuple, np.argwhere((inp == 5) & (out == 5))))
    assert changed and unchanged, '"'need both hit and lure grey obstacles'
    assert changed | unchanged == grey_in
    for corner, color in seeds:
        assert out[corner] == color

print('variants', len(sigs))
print('seed_counts', sorted(seed_counts))
print('recolor_range', min(recolor_counts), max(recolor_counts))
print('after_bounce_samples', after_bounce_hits)
print('direct_samples', direct_samples)
assert len(sigs) >= 20
assert seed_counts == {1, 2}
assert after_bounce_hits >= 40
assert direct_samples >= 10
