    height, width, slot_cols, slot_h, slot_w, row_gap, col_gap, left_margin = layout
    row_starts = [TOP_MARGIN + i * (slot_h + row_gap) for i in range(SLOT_ROWS)]
    col_starts = [left_margin + i * (slot_w + col_gap) for i in range(slot_cols)]
