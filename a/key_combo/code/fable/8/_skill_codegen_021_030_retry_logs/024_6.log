+        g,
+        bg=bg,
+        colors=[GREY],
+        connectivity=4,
+        monochromatic=True,
+        return_format="dict",
+    )
+    assert all(int(comp["area"]) == 1 for comp in grey_components), "gray obstacles must be singleton pixels"
