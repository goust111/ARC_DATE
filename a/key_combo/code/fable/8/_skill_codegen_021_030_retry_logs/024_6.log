+    assert bg == BG, "expected a black background"
+
+    h, w = map(int, g.shape)
+    corner_set = set(_corners((h, w)))
+    seeds: list[tuple[tuple[int, int], int]] = []
+    for corner in corner_set:
+        color = int(g[corner])
+        if color not in (bg, GREY):
+            seeds.append((corner, color))
