+def _oracle_output(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    out = g.copy()
+    h, w = map(int, g.shape)
+    seeds = []
+    for corner in _corners((h, w)):
+        color = int(g[corner])
+        if color not in (BG, GREY):
