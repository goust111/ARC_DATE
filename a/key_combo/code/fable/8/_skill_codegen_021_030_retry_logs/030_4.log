+from __future__ import annotations
+
+from collections import Counter
+import random
+
+import numpy as np
+
+
+Coord = tuple[int, int]
+BBox = tuple[int, int, int, int]
+
+GRID_MIN = 14
+GRID_MAX = 30
+LAYER_MIN = 2
+LAYER_MAX = 5
+INNER_MIN = 1
+INNER_MAX = 6
+SEED_MIN = 2
+SEED_MAX = 5
+GEN_ATTEMPTS = 500
+SELF_CHECK_VARIANTS = 60
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _bbox_from_coords(coords: np.ndarray) -> BBox:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _component_coords(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[Coord] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.asarray(coords, dtype=int))
+    return comps
+
+
+def _distance_to_bbox(r: int, c: int, bbox: BBox) -> int:
+    r0, c0, r1, c1 = bbox
+    dr = max(r0 - r, 0, r - r1)
+    dc = max(c0 - c, 0, c - c1)
+    return int(max(dr, dc))
+
+
+def _make_depth_grid(height: int, width: int) -> np.ndarray:
+    rows = np.arange(height)[:, None]
+    cols = np.arange(width)[None, :]
+    return np.minimum(
+        np.minimum(rows, height - 1 - rows),
+        np.minimum(cols, width - 1 - cols),
+    )
+
+
+def _make_nested_patch(palette: list[int], inner_h: int, inner_w: int) -> np.ndarray:
+    layers = len(palette)
+    height = inner_h + 2 * (layers - 1)
+    width = inner_w + 2 * (layers - 1)
+    depth = _make_depth_grid(height, width)
+    return np.asarray(palette, dtype=int)[depth]
+
+
+def _extract_rectangle(grid: np.ndarray, coords: np.ndarray, bg: int) -> dict | None:
+    bbox = _bbox_from_coords(coords)
+    r0, c0, r1, c1 = bbox
+    patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+    if np.any(patch == bg):
+        return None
+    if coords.shape[0] != patch.size:
+        return None
+
+    depth = _make_depth_grid(*patch.shape)
+    max_depth = int(depth.max())
+    palette: list[int] = []
+    seen: set[int] = set()
+    for d in range(max_depth + 1):
+        values = np.unique(patch[depth == d])
+        if values.size != 1:
+            return None
+        color = int(values[0])
+        if color == bg or color in seen:
+            return None
+        seen.add(color)
+        palette.append(color)
+
+    return {
+        "bbox": bbox,
+        "coords": coords,
+        "palette": palette,
+        "patch": patch.copy(),
+    }
+
+
+def _analyze_grid(grid: np.ndarray) -> dict:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+    assert max(g.shape) <= 30, "ARC grids must be at most 30x30"
+    bg = _get_bg(g)
+
+    comps = _component_coords(g != bg)
