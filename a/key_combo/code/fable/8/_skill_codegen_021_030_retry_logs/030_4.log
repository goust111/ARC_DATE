+
+def _oracle_from_spec(spec: dict) -> np.ndarray:
+    patch = _make_nested_patch(spec["palette"], spec["inner_h"], spec["inner_w"])
+    info = {
+        "bg": spec["bg"],
+        "rectangle": {
