+
+def _render_output_from_analysis(shape: tuple[int, int], info: dict) -> np.ndarray:
+    out = np.full(shape, int(info["bg"]), dtype=int)
+    rect = info["rectangle"]
+    r0, c0, r1, c1 = rect["bbox"]
