    color_slots.extend(rng.choice(colors, size=len(fg_coords) - len(colors)).tolist())
    rng.shuffle(color_slots)

    for (r, c), color in zip(fg_coords, color_slots):
        patch[r, c] = int(color)

    return patch


def _gen_attempt():
