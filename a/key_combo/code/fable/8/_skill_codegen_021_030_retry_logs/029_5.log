+            assert (r0, r1) == (band0, band1)
+            start, end = c0, c1
+        else:
+            assert (c0, c1) == (band0, band1)
+            start, end = r0, r1
+        f0, f1 = _to_forward_interval(start, end, line_len, direction)
+        blocks.append(
+            {
+                "color": int(rect["color"]),
+                "band0": band0,
+                "band1": band1,
+                "f0": int(f0),
+                "f1": int(f1),
