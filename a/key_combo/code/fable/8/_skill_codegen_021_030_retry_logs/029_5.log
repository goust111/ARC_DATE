+                next_quota = 0
+                continue_chain = False
+                border_contact = True
+        else:
+            if next_exists:
+                gap = int(final_blocks[idx + 1]["f0"]) - old1 - 1
+                if gap < quota:
+                    step = gap
+                    next_quota = quota - gap
+                    continue_chain = next_quota > 0
+                    border_contact = False
+                else:
