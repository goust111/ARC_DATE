+    idx = int(selected_idx)
+    quota: int | None = None
+
+    while True:
+        block = final_blocks[idx]
+        old0 = int(block["f0"])
+        old1 = int(block["f1"])
+        next_exists = idx + 1 < len(final_blocks)
+
+        if quota is None:
+            if next_exists:
+                step = int(final_blocks[idx + 1]["f0"]) - old1 - 1
+                next_quota = step
+                continue_chain = next_quota > 0
