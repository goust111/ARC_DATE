+    axis = _axis_key(coords)
+    lo, hi = _rail_interval(coords, axis)
+    front_local = hi if sign == 1 else lo
+    r0, c0, r1, c1 = _bbox_coords(coords)
+    if kind == "H":
+        top = -axis[1]
+        left = front_scalar - front_local
+    elif kind == "V":
+        top = front_scalar - front_local
+        left = -axis[1]
+    elif kind == "D1":
