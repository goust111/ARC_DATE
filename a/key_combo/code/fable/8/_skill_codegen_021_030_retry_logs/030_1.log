+        return None
+    if int(np.count_nonzero(out == RED)) <= int(np.count_nonzero(grid == RED) // 3):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input")

