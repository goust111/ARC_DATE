+def _add_gray_distractors(grid: np.ndarray, axes: list[tuple[str, int]], count: int) -> bool:
+    bg = get_bg(grid)
+    h, w = grid.shape
+    cells = [(r, c) for r in range(h) for c in range(w)]
+    random.shuffle(cells)
