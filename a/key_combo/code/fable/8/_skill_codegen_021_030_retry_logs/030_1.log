+        if any(_coords_hit_axis(flat, old_axis) for old_axis in axes):
+            continue
+        if existing_red.size and _coords_hit_axis(existing_red, axis):
+            continue
+        return {"dock": dock, "axis": axis, "objects": abs_objects}
+    return None
