+
+def _add_singletons(grid: np.ndarray, axes: list[tuple[str, int]], count: int) -> bool:
+    h, w = grid.shape
+    cells = [(r, c) for r in range(h) for c in range(w)]
+    random.shuffle(cells)
+    added = 0
+    for r, c in cells:
