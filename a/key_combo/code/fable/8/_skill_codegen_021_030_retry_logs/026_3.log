+    orbits: list[tuple[tuple[int, int], ...]],
+    orbit_index: dict[tuple[int, int], int],
+) -> np.ndarray:
+    palette = random.sample(PALETTE, random.randint(4, 6))
+    grid = np.zeros((size, size), dtype=int)
+    colored: dict[int, int] = {}
