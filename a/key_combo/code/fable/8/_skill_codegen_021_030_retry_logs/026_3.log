+    pair_reps = []
+    seen = set()
+    for idx, orbit in enumerate(orbits):
+        if idx in seen:
+            continue
+        mirrors = {(r, size - 1 - c) for r, c in orbit}
+        if all(rc in orbit_index for rc in mirrors):
