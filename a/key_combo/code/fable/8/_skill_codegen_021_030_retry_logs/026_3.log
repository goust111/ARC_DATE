+    for rect in rects[:40]:
+        occ_color = _pick_occluder_color(base, rect)
+        if occ_color is None:
+            continue
+        grid = _occlude(base, rect, occ_color)
+        if not _axes_decoy_ok(grid, rect):
+            continue
+        try:
+            found_rect, found_axes, recovered = _solve_with_details(grid)
+        except AssertionError:
