+def _visible_lr_mismatches(grid: np.ndarray, rect: tuple[int, int, int, int], bg: int) -> int:
+    n = grid.shape[1]
+    r0, c0, r1, c1 = rect
+    hidden = np.zeros_like(grid, dtype=bool)
+    hidden[r0 : r1 + 1, c0 : c1 + 1] = True
