+
+def _gen_attempt() -> np.ndarray | None:
+    size = random.randint(15, 23)
+    cr = random.randint(4, size - 5)
+    cc_choices = [c for c in range(4, size - 4) if c != cr and c != size - 1 - cr]
+    if not cc_choices:
