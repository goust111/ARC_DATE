+
+def _component_dfs(
+    grid: np.ndarray,
+    start: tuple[int, int],
+    seen: np.ndarray,
+) -> dict:
+    color = int(grid[start])
+    stack = [start]
+    coords = []
+    seen[start] = True
+    while stack:
+        r, c = stack.pop()
+        coords.append((r, c))
+        for dr, dc in ORTHO4:
+            nr, nc = r + dr, c + dc
+            if _inside(grid.shape, nr, nc) and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                seen[nr, nc] = True
