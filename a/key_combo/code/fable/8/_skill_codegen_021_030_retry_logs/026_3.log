+    orbit_index = _orbit_id_map(orbits)
+    base = _assign_pattern_colors(size, orbits, orbit_index)
+
+    rects = _find_valid_rectangles(base, d, s)
+    for rect in rects[:60]:
+        occ_color = _pick_occluder_color(base, rect)
+        if occ_color is None:
+            continue
+        grid = _occlude(base, rect, occ_color)
+        if not _axes_decoy_ok(grid, rect):
+            continue
+        try:
+            found_rect, found_axes, recovered = _solve_with_details(grid)
+        except AssertionError:
+            continue
+        if found_rect != rect or found_axes != (d, s):
+            continue
+        expected = base[rect[0] : rect[2] + 1, rect[1] : rect[3] + 1]
+        if not np.array_equal(recovered, expected):
+            continue
+        return grid
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_MAX_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None and grid.ndim == 2 and max(grid.shape) <= 30:
