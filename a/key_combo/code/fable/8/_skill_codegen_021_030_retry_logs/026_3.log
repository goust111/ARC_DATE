+    return valid
+
+
+def _pick_occluder_color(base: np.ndarray, rect: tuple[int, int, int, int]) -> int | None:
+    r0, c0, r1, c1 = rect
+    border_neighbors = set()
+    for r in range(r0 - 1, r1 + 2):
+        for c in range(c0 - 1, c1 + 2):
+            if not _inside(base.shape, r, c):
+                continue
+            if r0 <= r <= r1 and c0 <= c <= c1:
+                continue
