+def _rect_metrics(
+    rect: tuple[int, int, int, int],
+    d: int,
+    s: int,
+    shape: tuple[int, int],
+) -> tuple[int, int]:
+    r0, c0, r1, c1 = rect
+    hidden = {(r, c) for r in range(r0, r1 + 1) for c in range(c0, c1 + 1)}
+    full_orbit_needed = 0
+    hidden_count = 0
+    for rc in sorted(hidden):
+        orbit = _orbit_for(rc, d, s, shape)
+        if orbit is None:
+            return -1, -1
+        dr = _reflect_diff(rc, d)
+        sr = _reflect_sum(rc, s)
