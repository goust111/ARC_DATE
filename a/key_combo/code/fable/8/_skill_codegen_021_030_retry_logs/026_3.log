+        try:
+            found_rect, found_axes, recovered = _solve_with_details(grid)
+        except AssertionError:
+            continue
+        if found_rect != rect or found_axes != (d, s):
+            continue
+        expected = base[rect[0] : rect[2] + 1, rect[1] : rect[3] + 1]
+        if not np.array_equal(recovered, expected):
+            continue
+        return grid
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_MAX_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None and grid.ndim == 2 and max(grid.shape) <= 30:
+            return grid
+    raise RuntimeError("failed to generate a valid shifted-diagonal occlusion instance")

