+def _build_orbits(size: int, d: int, s: int) -> list[tuple[tuple[int, int], ...]]:
+    seen: set[tuple[int, int]] = set()
+    orbits = []
+    for r in range(size):
+        for c in range(size):
+            if (r, c) in seen:
+                continue
+            orbit = _orbit_for((r, c), d, s, (size, size))
+            if orbit is None:
+                continue
+            orbits.append(orbit)
+            seen.update(orbit)
+    return orbits
+
+
+def _seed_orbits(size: int, cr: int, cc: int) -> list[tuple[tuple[int, int], ...]] | None:
+    reach = min(cr, cc, size - 1 - cr, size - 1 - cc) - 1
+    if reach < 4:
+        return None
+    max_x = random.randint(3, reach)
+    max_y = random.randint(3, reach)
+    seeds = []
+    for x in range(max_x + 1):
+        for y in range(x, max_y + 1):
+            if x == 0 and y == 0:
+                continue
+            if y >= max_x - 1 or random.random() < 0.84:
+                seeds.append((x, y))
+    if len(seeds) < 12:
+        return None
+
+    orbits = []
+    seen = set()
+    for x, y in seeds:
+        rel = {(x, y), (y, x), (-y, -x), (-x, -y)}
+        orbit = tuple(sorted((cr + rx, cc + ry) for rx, ry in rel))
+        if any(not _inside((size, size), r, c) for r, c in orbit):
+            return None
+        if orbit in seen:
+            continue
+        seen.add(orbit)
+        orbits.append(orbit)
