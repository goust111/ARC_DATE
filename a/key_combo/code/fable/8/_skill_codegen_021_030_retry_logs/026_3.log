+
+
+def _rect_metrics(
+    rect: tuple[int, int, int, int],
+    d: int,
+    s: int,
+    shape: tuple[int, int],
+) -> tuple[int, int]:
+    r0, c0, r1, c1 = rect
+    hidden = {(r, c) for r in range(r0, r1 + 1) for c in range(c0, c1 + 1)}
+    full_orbit_needed = 0
+    hidden_count = 0
+    for rc in sorted(hidden):
+        orbit = _orbit_for(rc, d, s, shape)
+        if orbit is None:
+            return -1, -1
+        dr = _reflect_diff(rc, d)
+        sr = _reflect_sum(rc, s)
+        visible = [pt for pt in orbit if pt not in hidden]
+        if not visible:
+            return -1, -1
+        hidden_count += len(visible) < len(orbit)
+        if dr in hidden and sr in hidden and any(pt not in hidden for pt in orbit if pt not in {rc, dr, sr}):
+            full_orbit_needed += 1
+    return full_orbit_needed, hidden_count
+
+
+def _visible_lr_mismatches(grid: np.ndarray, rect: tuple[int, int, int, int], bg: int) -> int:
+    n = grid.shape[1]
+    r0, c0, r1, c1 = rect
+    hidden = np.zeros_like(grid, dtype=bool)
+    hidden[r0 : r1 + 1, c0 : c1 + 1] = True
+    mismatches = 0
+    checked = set()
+    for r in range(grid.shape[0]):
+        for c in range(grid.shape[1]):
+            mc = n - 1 - c
+            if (r, c) in checked or not _inside(grid.shape, r, mc):
+                continue
+            checked.add((r, c))
+            checked.add((r, mc))
+            if hidden[r, c] or hidden[r, mc]:
