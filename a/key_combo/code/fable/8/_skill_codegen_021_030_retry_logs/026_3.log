+def _solve_with_details(grid: np.ndarray) -> tuple[tuple[int, int, int, int], tuple[int, int], np.ndarray]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    bg = _get_bg(g)
