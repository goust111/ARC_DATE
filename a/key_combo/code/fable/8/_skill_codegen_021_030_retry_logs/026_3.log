+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+ORTHO4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+GEN_MAX_ATTEMPTS = 600
+PALETTE = tuple(range(1, 10))
