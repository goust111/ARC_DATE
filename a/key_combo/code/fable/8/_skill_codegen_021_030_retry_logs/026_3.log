+    hidden_count = 0
+    for rc in sorted(hidden):
+        orbit = _orbit_for(rc, d, s, shape)
+        if orbit is None:
+            return -1, -1
+        dr = _reflect_diff(rc, d)
+        sr = _reflect_sum(rc, s)
+        visible = [pt for pt in orbit if pt not in hidden]
+        if not visible:
+            return -1, -1
+        hidden_count += len(visible) < len(orbit)
