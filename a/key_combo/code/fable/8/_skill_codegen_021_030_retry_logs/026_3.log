+                    colors = {int(base[r, c]) for r, c in cells}
+                    if len(colors) < 2:
+                        continue
+                    full_orbit_needed, hidden_count = _rect_metrics(rect, d, s, base.shape)
+                    if full_orbit_needed < 1 or hidden_count < 2:
+                        continue
+                    valid.append(rect)
