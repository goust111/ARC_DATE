+    for a, b in pair_reps:
+        left_cells = set(orbits[a])
+        right_cells = set(orbits[b])
+        forbid_a = {
+            int(grid[nr, nc])
+            for r, c in left_cells
+            for dr, dc in ORTHO4
+            if _inside(grid.shape, (nr := r + dr), (nc := c + dc)) and int(grid[nr, nc]) != 0
