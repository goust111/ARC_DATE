+def _global_coord(local_r: int, local_c: int, sep_r: int, sep_c: int, q: int) -> tuple[int, int]:
+    if q == 0:
+        return int(local_r), int(local_c)
+    if q == 1:
+        return int(local_r), int(sep_c + 1 + local_c)
+    if q == 2:
+        return int(sep_r + 1 + local_r), int(local_c)
+    if q == 3:
