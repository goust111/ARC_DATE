+    if not all(missing_by_quadrant):
+        return False
+
+    return True
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
+        inp, expected, meta = _build_case()
+        if _case_is_valid(inp, expected, meta):
+            return inp
+    raise RuntimeError("failed to generate a valid input")

