+        _ = ref_q
+        for q in range(4):
+            lr, lc = _base_to_quad_coord(int(br), int(bc), quad_h, quad_w, q)
+            gr, gc = _global_coord(lr, lc, sep_r, sep_c, q)
+            if out[gr, gc] == bg:
