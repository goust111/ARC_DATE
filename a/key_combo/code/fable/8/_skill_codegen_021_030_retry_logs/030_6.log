+        inp[:sep_r, :sep_c] = input_quads[0]
+        inp[:sep_r, sep_c + 1 :] = input_quads[1]
+        inp[sep_r + 1 :, :sep_c] = input_quads[2]
+        inp[sep_r + 1 :, sep_c + 1 :] = input_quads[3]
+
+        out[:sep_r, :sep_c] = full_quads[0]
+        out[:sep_r, sep_c + 1 :] = full_quads[1]
