+def _base_to_quad_coord(r: int, c: int, h: int, w: int, q: int) -> tuple[int, int]:
+    if q == 0:
+        return int(r), int(c)
+    if q == 1:
+        return int(r), int(w - 1 - c)
+    if q == 2:
+        return int(h - 1 - r), int(c)
+    if q == 3:
+        return int(h - 1 - r), int(w - 1 - c)
+    raise ValueError("invalid quadrant index")
