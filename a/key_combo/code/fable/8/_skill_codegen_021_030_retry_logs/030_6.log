+    out[:sep_r, :sep_c] = full_quads[0]
+    out[:sep_r, sep_c + 1 :] = full_quads[1]
+    out[sep_r + 1 :, :sep_c] = full_quads[2]
+    out[sep_r + 1 :, sep_c + 1 :] = full_quads[3]
