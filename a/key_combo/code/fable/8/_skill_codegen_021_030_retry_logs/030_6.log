+
+def _naive_copy_fill(grid: np.ndarray) -> np.ndarray:
+    sep_r, sep_c, bg, observations, shape = _extract_observations(grid)
+    out = np.asarray(grid, dtype=int).copy()
+    quad_h, quad_w = shape.shape
+    for br, bc in np.argwhere(shape):
