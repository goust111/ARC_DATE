+def _filled_output(grid: np.ndarray, cycle: tuple[int, ...], observations: dict[tuple[int, int], list[tuple[int, int]]], shape: np.ndarray) -> np.ndarray:
+    out = np.asarray(grid, dtype=int).copy()
+    sep_r, sep_c, bg = _find_separator(out)
