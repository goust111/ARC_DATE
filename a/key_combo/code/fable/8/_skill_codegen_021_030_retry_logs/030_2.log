    n_single = random.choice(feasible)
    n_pair = (count - n_single) // 2
    chosen = random.sample(singles, n_single) + random.sample(pairs, n_pair)
    coords = [cell for orbit in chosen for cell in orbit]
    random.shuffle(coords)
    return coords


