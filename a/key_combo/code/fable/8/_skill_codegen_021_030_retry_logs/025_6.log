        if isinstance(c, np.ndarray):
            c = c.astype(int)
        if isinstance(r, float):
            r = int(round(r))
        if isinstance(c, float):
            c = int(round(c))
        return r, c

    def __repr__(self):
        return f"TranslationalSymmetry(dr={self.dr}, dc={self.dc})"

    def __str__(self):
        return self.__repr__()

    def _iter_range(self, grid_shape: tuple[int, int]):
