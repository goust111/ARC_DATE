+
+def _perimeter_mask(shape: tuple[int, int]) -> np.ndarray:
+    h, w = shape
+    out = np.zeros((h, w), dtype=bool)
+    out[0, :] = True
+    out[-1, :] = True
+    out[:, 0] = True
+    out[:, -1] = True
+    return out
