+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+TRANSFORMS = (
+    "id",
+    "rot90",
+    "rot180",
+    "rot270",
+    "flip_h",
+    "flip_v",
+    "transpose",
+    "anti_transpose",
+)
