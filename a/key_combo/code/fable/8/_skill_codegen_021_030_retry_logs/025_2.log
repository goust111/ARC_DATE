    """Return cells blocked by occupied pixels plus their 8-neighborhood."""
    blocked = occupied.copy()
    blocked[1:, :] |= occupied[:-1, :]
    blocked[:-1, :] |= occupied[1:, :]
    blocked[:, 1:] |= occupied[:, :-1]
    blocked[:, :-1] |= occupied[:, 1:]
    blocked[1:, 1:] |= occupied[:-1, :-1]
    blocked[:-1, :-1] |= occupied[1:, 1:]
    blocked[1:, :-1] |= occupied[:-1, 1:]
    blocked[:-1, 1:] |= occupied[1:, :-1]
    return blocked


