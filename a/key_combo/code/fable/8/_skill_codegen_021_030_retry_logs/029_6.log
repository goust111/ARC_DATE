13:def main(input_grid: np.ndarray) -> np.ndarray:
14:    """
15:    Find the largest all-black rectangle of area at least 2 by 2 and fill it pink.
16:
17:    Input structure:
18:    - The grid contains non-black cells surrounding or interrupting black empty space.
19:    - Candidate empty regions are axis-aligned rectangles with both dimensions at least 2.
20:    - At least one all-black candidate rectangle is present.
21:
22:    Rule:
23:    - Enumerate every axis-aligned rectangle with height and width at least 2.
24:    - Keep only rectangles whose cells are all black.
25:    - Fill the maximum-area remaining rectangle with pink.
26:
27:    Key insight:
28:    - The target is the maximal empty rectangle by area, not necessarily a connected
29:      component of black cells.
30:    """
31:    # Plan:
32:    # 1. Enumerate all rectangular regions
33:    # 2. For each region, filter it out if it isn't all black
34:    # 3. Find the biggest region remaining by area
35:    # 4. Turn the biggest region into pink
36:
37:    # 1. Enumerate all rectangular regions
38:    regions = { (r, c, w, h) for r in range(len(input_grid)) for c in range(len(input_grid[0])) for w in range(2, len(input_grid) - r + 1) for h in range(2, len(input_grid[0]) - c + 1) }
39:
40:    # 2. For each region, filter it out if it isn't all black
41:    regions = { (r, c, w, h) for r, c, w, h in regions if np.all(input_grid[r:r+w, c:c+h] == Color.BLACK) }
42:
43:    # 3. Find the biggest region remaining by area
44:    largest_region = max(regions, key=lambda region: region[2] * region[3])
45:    r, c, w, h = largest_region
46:
47:    # 4. Turn the biggest region into pink
48:    output_grid = np.copy(input_grid)
49:    output_grid[r:r+w, c:c+h] = Color.PINK
50:    
51:    return output_grid
