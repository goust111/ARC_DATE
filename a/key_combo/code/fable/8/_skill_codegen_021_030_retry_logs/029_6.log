+        assert coord_set.issubset(border_set)
+        assert coord_set == {pos for pos in border if int(grid[pos]) != bg}
+
+        missing = [pos for pos in border if int(grid[pos]) == bg]
+        assert len(missing) in (0, 1)
+        if missing:
