+    return max(0, (min(r1 - r0 + 1, c1 - c0 + 1) - 1) // 2)
+
+
+def _minimal_period(seq):
+    seq = [int(x) for x in seq]
+    for p in range(1, len(seq) + 1):
+        if all(seq[i] == seq[i % p] for i in range(len(seq))):
+            return seq[:p]
+    return seq
