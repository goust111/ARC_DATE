71:def main(grid: np.ndarray) -> np.ndarray:
72:    """
73:    Draw orange corridors along a nearest-visible-block walk from the red 2x2 block through teal 2x2 blocks.
74:
75:    Input structure
76:    - The background contains one red 2x2 start block and multiple teal 2x2 target blocks.
77:    - Blocks may align in shared two-row or two-column bands; non-background pixels between aligned blocks block visibility.
78:
79:    Rule
80:    - Start at the red block.
81:    - Among unvisited teal blocks visible in the same horizontal or vertical band, choose the unique nearest one.
82:    - Paint the background gap between the current block and that teal block orange, then continue from that teal block.
83:    - Stop when no unvisited teal block is visible from the current block.
84:
85:    Key insight
86:    - The output is not the full alignment graph; it is a greedy nearest-neighbor walk whose line of sight is blocked by any existing colored block.
87:    """
88:    g = np.asarray(grid, dtype=int)
89:    bg = int(get_bg(g))
90:    current, unvisited = _blocks(g, bg)
91:    out = g.copy()
92:
93:    while True:
94:        candidates = []
95:        for block in unvisited:
96:            step = _visible_step(g, bg, current, block)
97:            if step is None:
98:                continue
99:            axis, distance = step
100:            candidates.append((distance, axis, block))
101:
102:        if not candidates:
103:            break
104:
105:        min_distance = min(distance for distance, _axis, _block in candidates)
106:        nearest = [candidate for candidate in candidates if candidate[0] == min_distance]
107:        assert len(nearest) == 1, "expected a unique nearest visible teal block"
108:
109:        _distance, axis, block = nearest[0]
110:        _paint_corridor(out, current, block, axis)
111:        unvisited = [candidate for candidate in unvisited if candidate is not block]
112:        current = block
113:
114:    return out
