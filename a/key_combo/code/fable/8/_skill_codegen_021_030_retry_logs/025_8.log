+
+GRID_H_RANGE = (16, 28)
+GRID_W_RANGE = (16, 28)
+PALETTE_LENGTHS = (3, 4, 5, 6)
+PALETTE_COLORS = [Color.BLUE, Color.RED, Color.GREEN, Color.YELLOW, Color.PINK, Color.ORANGE, Color.TEAL, Color.MAROON]
+GEN_ATTEMPTS = 400
