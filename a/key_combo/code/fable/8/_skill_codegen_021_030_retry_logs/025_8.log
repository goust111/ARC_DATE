+
+def _detour_strength(dist: np.ndarray, seed: tuple[int, int]) -> int:
+    best = 0
+    sr, sc = seed
+    for r, c in np.argwhere(dist >= 0):
+        manhattan = abs(int(r) - sr) + abs(int(c) - sc)
+        best = max(best, int(dist[r, c]) - manhattan)
+    return best
