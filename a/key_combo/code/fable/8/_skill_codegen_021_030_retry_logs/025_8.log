+def _geodesic_distances(shape: tuple[int, int], blocked: np.ndarray, seed: tuple[int, int]) -> np.ndarray:
+    dist = np.full(shape, -1, dtype=int)
+    queue = deque([seed])
+    dist[seed] = 0
+    while queue:
