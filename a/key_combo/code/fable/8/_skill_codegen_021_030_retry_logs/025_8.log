+            if not _reserve_clear(reserved, r0, c0, r1, c1, pad=1):
+                continue
+            grid[r0 : r1 + 1, c0 : c1 + 1] = Color.GREY
+            _reserve_box(reserved, r0, c0, r1, c1, pad=1)
