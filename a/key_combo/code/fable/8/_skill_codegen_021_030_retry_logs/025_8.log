+    grid[seed] = palette[0]
+    _reserve_box(reserved, seed[0], seed[1], seed[0], seed[1], pad=1)
+
+    if not _place_unreachable_frames(grid, reserved, play_r0, play_r1, play_c0, play_c1, seed):
