+    bg = scene["bg"]
+    palette = scene["palette"]
+    reachable_background = 0
+    unreachable_background = 0
+    for r in range(inp.shape[0]):
+        for c in range(inp.shape[1]):
+            if scene["wall_mask"][r, c] or scene["palette_mask"][r, c]:
