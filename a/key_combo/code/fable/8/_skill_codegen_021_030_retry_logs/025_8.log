+    if palette_row <= 2:
+        play_r0, play_r1 = palette_row + 2, h - 2
+    else:
+        play_r0, play_r1 = 1, palette_row - 2
+    play_c0, play_c1 = 1, w - 2
+    if play_r1 - play_r0 < 7 or play_c1 - play_c0 < 7:
+        return None
+
+    try:
+        orientation, barrier, gap, seed, seed_side = _place_gate_wall(
+            grid,
+            reserved,
+            play_r0,
+            play_r1,
+            play_c0,
+            play_c1,
+        )
+    except ValueError:
