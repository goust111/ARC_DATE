+    if orientation == "vertical":
+        gap_line = slice(gap[0], gap[1] + 1)
+        if not np.all(grid[gap_line, barrier] == Color.BLACK):
+            return None
+    else:
+        gap_line = slice(gap[0], gap[1] + 1)
+        if not np.all(grid[barrier, gap_line] == Color.BLACK):
+            return None
