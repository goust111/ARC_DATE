+        return None
+    if np.array_equal(grid, out):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_MAX_ATTEMPTS):
+        grid = _generate_attempt()
+        if grid is not None:
+            return grid
