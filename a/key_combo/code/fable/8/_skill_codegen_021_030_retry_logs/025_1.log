+
+
+@dataclass(frozen=True)
+class MarkerCandidate:
+    orientation: str
+    anchor: Coord
+    cells: tuple[Coord, Coord]
+    hits: tuple[HitSpec, ...]
+    stripe_cells: tuple[Coord, ...]
+    corridor_cells: tuple[Coord, ...]
+
+    @property
+    def dead_sides(self) -> int:
