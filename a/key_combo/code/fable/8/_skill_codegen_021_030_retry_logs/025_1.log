+
+@dataclass(frozen=True)
+class Container:
+    idx: int
+    r0: int
+    c0: int
+    r1: int
+    c1: int
+
+    @property
+    def height(self) -> int:
+        return int(self.r1 - self.r0 + 1)
+
+    @property
+    def width(self) -> int:
+        return int(self.c1 - self.c0 + 1)
+
+
+@dataclass(frozen=True)
+class HitSpec:
+    container_idx: int
+    entry_side: str
+    distance: int
+    stripe_cells: tuple[Coord, ...]
+    corridor_cells: tuple[Coord, ...]
+
+
+@dataclass(frozen=True)
+class MarkerCandidate:
