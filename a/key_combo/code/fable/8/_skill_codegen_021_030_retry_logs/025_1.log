+    for r in range(shape[0]):
+        for c in range(shape[1] - 1):
+            cells = ((r, c), (r, c + 1))
+            if any(blocked[rr, cc] for rr, cc in cells):
+                continue
+            hits = []
+            hit_left = trace_for_candidate((r, c - 1), (0, -1), "h")
+            hit_right = trace_for_candidate((r, c + 2), (0, 1), "h")
+            if hit_left is invalid or hit_right is invalid:
+                continue
+            if hit_left is not None:
+                hits.append(hit_left)
+            if hit_right is not None:
+                hits.append(hit_right)
+            if not hits:
+                continue
+            stripe_cells = tuple(sorted({cell for hit in hits for cell in hit.stripe_cells}))
+            corridor_cells = tuple(sorted({cell for hit in hits for cell in hit.corridor_cells}))
+            candidates.append(
+                MarkerCandidate(
+                    orientation="h",
+                    anchor=(r, c),
+                    cells=cells,
+                    hits=tuple(hits),
+                    stripe_cells=stripe_cells,
+                    corridor_cells=corridor_cells,
+                )
+            )
+
+    for r in range(shape[0] - 1):
+        for c in range(shape[1]):
+            cells = ((r, c), (r + 1, c))
+            if any(blocked[rr, cc] for rr, cc in cells):
+                continue
+            hits = []
+            hit_up = trace_for_candidate((r - 1, c), (-1, 0), "v")
+            hit_down = trace_for_candidate((r + 2, c), (1, 0), "v")
+            if hit_up is invalid or hit_down is invalid:
+                continue
+            if hit_up is not None:
+                hits.append(hit_up)
+            if hit_down is not None:
+                hits.append(hit_down)
+            if not hits:
+                continue
+            stripe_cells = tuple(sorted({cell for hit in hits for cell in hit.stripe_cells}))
+            corridor_cells = tuple(sorted({cell for hit in hits for cell in hit.corridor_cells}))
+            candidates.append(
+                MarkerCandidate(
+                    orientation="v",
+                    anchor=(r, c),
+                    cells=cells,
+                    hits=tuple(hits),
+                    stripe_cells=stripe_cells,
+                    corridor_cells=corridor_cells,
