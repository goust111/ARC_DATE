BLACK = 0
ORANGE = 7
DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]

def get_bg(grid):
    return Counter(map(int, grid.ravel())).most_common(1)[0][0]


def components(grid, color):
    h, w = grid.shape
    seen = np.zeros((h, w), dtype=bool)
    out = []
    for r in range(h):
        for c in range(w):
            if seen[r, c] or int(grid[r, c]) "'!= color:
                continue
            q = deque([(r, c)])
            seen[r, c] = True
            cells = []
            while q:
                rr, cc = q.popleft()
                cells.append((rr, cc))
                for dr, dc in DIR4:
                    nr, nc = rr + dr, cc + dc
                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
                        seen[nr, nc] = True
                        q.append((nr, nc))
            out.append(cells)
    return out


def parse(grid):
    bg = get_bg(grid)
    orange_comps = components(grid, ORANGE)
    containers = []
    lookup = np.full(grid.shape, -1, dtype=int)
    for idx, cells in enumerate(sorted(orange_comps, key=lambda cs: (min(r for r, _ in cs), min(c for _, c in cs)))):
        rs = [r for r, _ in cells]
        cs = [c for _, c in cells]
        r0, r1 = min(rs), max(rs)
        c0, c1 = min(cs), max(cs)
        assert len(cells) == (r1 - r0 + 1) * (c1 - c0 + 1)
        assert np.all(grid[r0:r1+1, c0:c1+1] == ORANGE)
        containers.append((r0, c0, r1, c1))
        lookup[r0:r1+1, c0:c1+1] = idx

    markers = []
    seen = np.zeros(grid.shape, dtype=bool)
    for r in range(grid.shape[0]):
        for c in range(grid.shape[1]):
            color = int(grid[r, c])
            if color in (bg, ORANGE) or seen[r, c]:
                continue
            q = deque([(r, c)])
            seen[r, c] = True
            cells = []
            while q:
                rr, cc = q.popleft()
                cells.append((rr, cc))
                for dr, dc in DIR4:
                    nr, nc = rr + dr, cc + dc
                    if 0 <= nr < grid.shape[0] and 0 <= nc < grid.shape[1] and not seen[nr, nc] and int(grid[nr, nc]) == color:
                        seen[nr, nc] = True
                        q.append((nr, nc))
            assert len(cells) == 2
            cells = sorted(cells)
            if cells[0][0] == cells[1][0] and abs(cells[0][1] - cells[1][1]) == 1:
                orientation = '"'h'
                left = min(cells, key=lambda x: x[1])
                right = max(cells, key=lambda x: x[1])
                cells = [left, right]
            elif cells[0][1] == cells[1][1] and abs(cells[0][0] - cells[1][0]) == 1:
                orientation = 'v'
                top = min(cells, key=lambda x: x[0])
                bottom = max(cells, key=lambda x: x[0])
                cells = [top, bottom]
            else:
                raise AssertionError('invalid marker')
            markers.append((orientation, tuple(cells), color))
    assert containers and markers
    return bg, containers, lookup, markers


def stripe_cells(container, orientation, side, d):
    r0, c0, r1, c1 = container
    if orientation == 'h':
        assert 1 <= d <= (c1 - c0 + 1)
        cols = range(c0, c0 + d) if side == 'left' else range(c1 - d + 1, c1 + 1)
        return [(r, c) for r in range(r0, r1 + 1) for c in cols]
    assert 1 <= d <= (r1 - r0 + 1)
    rows = range(r0, r0 + d) if side == 'top' else range(r1 - d + 1, r1 + 1)
    return [(r, c) for r in rows for c in range(c0, c1 + 1)]


def trace(grid, bg, containers, lookup, start, direction, orientation):
    dr, dc = direction
    r, c = start
    d = 0
    if (dr, dc) == (0, 1):
        side = 'left'
    elif (dr, dc) == (0, -1):
        side = 'right'
    elif (dr, dc) == (1, 0):
        side = 'top'
    else:
        side = 'bottom'
    while 0 <= r < grid.shape[0] and 0 <= c < grid.shape[1]:
        value = int(grid[r, c])
        if value == bg:
            d += 1
            r += dr
            c += dc
            continue
        if value == ORANGE:
            idx = int(lookup[r, c])
            return idx, side, d, stripe_cells(containers[idx], orientation, side, d)
        raise AssertionError('non-background on active corridor')
    return None


def oracle(grid):
    bg, containers, lookup, markers = parse(grid)
    out = grid.copy()
    for _orientation, cells, _color in markers:
        for cell in cells:
            out[cell] = bg

    h_layer = {}
    v_layer = {}
    dead_sides = 0
    dual_hits = 0
    h_targets = set()
    v_targets = set()
    affected = set()
    orientations = set()

    for orientation, cells, color in markers:
        orientations.add(orientation)
        if orientation == 'h':
            starts = [((cells[0][0], cells[0][1] - 1), (0, -1)), ((cells[1][0], cells[1][1] + 1), (0, 1))]
        else:
            starts = [((cells[0][0] - 1, cells[0][1]), (-1, 0)), ((cells[1][0] + 1, cells[1][1]), (1, 0))]
        hits = []
        for start, direction in starts:
            hit = trace(grid, bg, containers, lookup, start, direction, orientation)
            if hit is None:
                dead_sides += 1
            else:
                hits.append(hit)
        assert hits
        if len(hits) == 2:
            dual_hits += 1
        for idx, _side, _d, cells2 in hits:
            affected.add(idx)
            if orientation == 'h':
                h_targets.add(idx)
                layer = h_layer
            else:
                v_targets.add(idx)
                layer = v_layer
            for cell in cells2:
                prev = layer.get(cell)
                assert prev in (None, color)
                layer[cell] = color

    for cell, color in h_layer.items():
        out[cell] = color
    for cell, color in v_layer.items():
        out[cell] = color

    return out, {
        'dead_sides': dead_sides,
        'dual_hits': dual_hits,
        'cross': bool(h_targets & v_targets),
        'untouched': len(containers) - len(affected),
        'orientations': orientations,
    }

sigs = set()
branch = Counter()
for i in range(120):
    inp = mod.generate_input()
    out = mod.main(inp)
    exp, feats = oracle(inp)
    assert isinstance(inp, np.ndarray)
    assert isinstance(out, np.ndarray)
    assert inp.ndim == 2 and max(inp.shape) <= 30, f'input grid exceeds 30x30: {inp.shape}'
    assert out.ndim == 2 and max(out.shape) <= 30, f'output grid exceeds 30x30: {out.shape}'
    assert np.array_equal(out, exp), f'oracle mismatch on sample {i}'
    sigs.add(hashlib.md5(inp.tobytes() + str(inp.shape).encode()).hexdigest())
    branch['both_orient'] += feats['orientations'] == {'h', 'v'}
    branch['dead_side'] += feats['dead_sides'] >= 1
    branch['dual'] += feats['dual_hits'] >= 1
    branch['cross'] += feats['cross']
    branch['untouched'] += feats['untouched'] >= 1
print('variants', len(sigs))
print('branch_counts', dict(branch))
assert len(sigs) >= 20
assert branch['both_orient'] == 120
assert branch['dead_side'] == 120
assert branch['dual'] > 0
assert branch['cross'] > 0
assert branch['untouched'] > 0
