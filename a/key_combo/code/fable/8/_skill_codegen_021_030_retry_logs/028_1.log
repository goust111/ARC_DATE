    # stack stop
    g[2, 5] = GREY
    g[6, 5] = GREY
    g[2, 11] = 2
    g[2, 1] = GREY
    # fall to floor
    g[1, 8] = GREY
    g[1, 11] = 3
    g[1, 4] = GREY
