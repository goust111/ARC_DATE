+            return None
+        for support_r in support_rows:
+            greys.add((support_r, int(evt["target_col"])))
+        evt["supports"] = support_rows
+
+    extra_hit_rows = 0
+    for evt in events:
+        placed = _add_left_distractors(
+            greys=greys,
+            height=height,
+            width=width,
+            row=int(evt["row"]),
+            target_col=int(evt["target_col"]),
+            count_range=(0, 2),
