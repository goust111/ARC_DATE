        below = np.flatnonzero(static[r + 1 :, target] == GREY)
        landing = h - 1 if below.size == 0 else r + int(below[0])
        if r == h - 1 and landing == r:
            branch_seen['stay'] += 1
        elif landing == h - 1:
            branch_seen['floor'] += 1
        else:
            branch_seen['stack'] += 1

    sigs.add(hashlib.md5(inp.tobytes() + str(inp.shape).encode()).hexdigest())

print('variants', len(sigs))
print('branches', branch_seen)
assert len(sigs) >= 20
assert min(branch_seen.values()) > 0
