from importlib.machinery import SourceFileLoader
from pathlib import Path
import hashlib
import numpy as np

p = Path('/home/lixinyu/snap/a/key_combo/code/fable/8/028/1.py')
mod = SourceFileLoader('new_arc_task', str(p)).load_module()
BG = mod.BG
GREY = mod.GREY


def semantic_expected(inp: np.ndarray) -> np.ndarray:
    g = np.asarray(inp, dtype=int)
    h, w = g.shape
    events = []
    for r in range(h):
        color = int(g[r, w - 1])
        if color in (BG, GREY):
            continue
        target = None
        for c in range(w - 2, -1, -1):
            if int(g[r, c]) == GREY:
                target = c
                break
        assert target is not None
        events.append((r, target, color))
    assert len({c for _, c, _ in events}) == len(events), 'target columns must be distinct'

    out = g.copy()
    for r, c, _ in events:
        out[r, w - 1] = BG
        out[r, c] = BG
    for r, c, color in events:
        below = np.flatnonzero(out[r + 1 :, c] == GREY)
        landing = h - 1 if below.size == 0 else r + int(below[0])
        assert int(out[landing, c]) == BG
        out[landing, c] = color
    return out


def manual_case() -> np.ndarray:
    g = np.zeros((10, 12), dtype=int)
    # stay on floor
    g[9, 2] = GREY
    g[9, 11] = 1
    g[9, 0] = GREY
    # stack stop
    g[2, 5] = GREY
    g[6, 5] = GREY
    g[2, 11] = 2
    g[2, 1] = GREY
    # fall to floor
    g[1, 8] = GREY
    g[1, 11] = 3
    g[1, 4] = GREY
    # distractors
    g[4, 1] = GREY
    g[7, 9] = GREY
    return g

# explicit non-generator checks
manual = manual_case()
manual_out = mod.main(manual)
assert np.array_equal(manual_out, semantic_expected(manual))
assert manual_out[9, 2] == 1  # bottom recolor in place
assert manual_out[5, 5] == 2 and manual_out[6, 5] == GREY  # stop above support
assert manual_out[9, 8] == 3  # fall to floor

sigs = set()
branch_seen = {'stay': 0, 'stack': 0, 'floor': 0}
for i in range(100):
    inp = mod.generate_input()
    out = mod.main(inp)
    assert isinstance(inp, np.ndarray)
    assert isinstance(out, np.ndarray)
    assert inp.ndim == 2 and max(inp.shape) <= 30, f'input grid exceeds 30x30: {inp.shape}'
    assert out.ndim == 2 and max(out.shape) <= 30, f'output grid exceeds 30x30: {out.shape}'
    exp = semantic_expected(inp)
    assert np.array_equal(out, exp), 'semantic mismatch'
    assert not np.array_equal(inp, out), 'degenerate unchanged sample'

    h, w = inp.shape
    for r in range(h):
        color = int(inp[r, w - 1])
        if color in (BG, GREY):
            continue
        target = max(c for c in range(w - 1) if int(inp[r, c]) == GREY)
        static = inp.copy()
        static[r, w - 1] = BG
        static[r, target] = BG
        below = np.flatnonzero(static[r + 1 :, target] == GREY)
        landing = h - 1 if below.size == 0 else r + int(below[0])
        if r == h - 1 and landing == r:
            branch_seen['stay'] += 1
        elif landing == h - 1:
            branch_seen['floor'] += 1
        else:
            branch_seen['stack'] += 1

    sigs.add(hashlib.md5(inp.tobytes() + str(inp.shape).encode()).hexdigest())

print('variants', len(sigs))
print('branches', branch_seen)
assert len(sigs) >= 20
assert min(branch_seen.values()) > 0
