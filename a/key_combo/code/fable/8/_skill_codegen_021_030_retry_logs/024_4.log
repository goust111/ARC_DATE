+
+
+def _isolated_rows(strip: np.ndarray, bg: int) -> tuple[int, ...]:
+    rows = []
+    for r in range(1, strip.shape[0] - 1):
+        for c in range(1, strip.shape[1] - 1):
+            if int(strip[r, c]) == bg:
+                continue
+            if _non_bg_neighbors4(strip, r, c, bg) == 0:
+                rows.append(r)
+    return tuple(sorted(rows))
