+        if extra_col < spine_col:
+            strip[r0 : r1 + 1, extra_col] = rng.choice(POLYLINE_COLORS)
+            strip[a, extra_col : spine_col + 1] = rng.choice(POLYLINE_COLORS)
+        else:
