+
+    hole_order = [idx for idx, _ in sorted(enumerate(objects), key=lambda item: item[1]["holes"])]
+    area_order = [idx for idx, _ in sorted(enumerate(objects), key=lambda item: item[1]["area"])]
+    if hole_order == area_order:
