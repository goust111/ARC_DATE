+def _place_objects(objects: list[dict]) -> np.ndarray | None:
+    for _ in range(LAYOUT_ATTEMPTS):
+        shuffled = objects[:]
+        random.shuffle(shuffled)
+        row_count = 1 if random.random() < 0.4 else 2
+        if row_count == 1:
+            rows = [shuffled]
+        else:
