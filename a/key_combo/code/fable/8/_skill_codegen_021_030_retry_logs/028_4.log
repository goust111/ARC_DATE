+def _sample_hole_positions(outer_h: int, outer_w: int, hole_count: int) -> list[Coord]:
+    if hole_count == 0:
+        return []
+    options = []
+    for parity in (0, 1):
+        cells = [
+            (r, c)
+            for r in range(1, outer_h - 1)
+            for c in range(1, outer_w - 1)
+            if (r + c) % 2 == parity
