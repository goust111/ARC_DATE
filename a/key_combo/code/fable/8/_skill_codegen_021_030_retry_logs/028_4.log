+                if np.any((region != BG) & (patch != BG)):
+                    break
+                region[patch != BG] = patch[patch != BG]
+                c_cursor += pw
+                if i < len(gaps):
+                    c_cursor += gaps[i]
+            else:
+                r_cursor += row_h
+                if row_idx < len(rows) - 1:
+                    r_cursor += row_gaps[row_idx]
