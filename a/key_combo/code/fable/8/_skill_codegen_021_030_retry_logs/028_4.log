+
+    sorted_by_holes = [obj["color"] for obj in sorted(analyzed, key=lambda obj: obj["holes"])]
+    sorted_by_area = [obj["color"] for obj in sorted(analyzed, key=lambda obj: obj["area"])]
+    if sorted_by_holes == sorted_by_area:
