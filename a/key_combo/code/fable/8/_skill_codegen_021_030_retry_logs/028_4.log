+            break
+        else:
+            analyzed = _analyze_objects(grid)
+            bg_cells = int(np.sum(grid == BG))
+            max_area = max(int(obj["area"]) for obj in analyzed) if analyzed else -1
+            if len(analyzed) == len(objects) and bg_cells > max_area:
+                return grid
+    return None
