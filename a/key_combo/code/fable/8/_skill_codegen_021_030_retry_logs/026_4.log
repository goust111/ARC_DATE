+
+
+def _semantic_summary(grid: np.ndarray) -> dict:
+    g = np.asarray(grid, dtype=int)
+    bg = int(get_bg(g))
+    pair_specs = _parse_pair_specs(g, bg)
+    checkpoints = frozenset(tuple(map(int, cell)) for cell in np.argwhere(g == CHECKPOINT_COLOR))
