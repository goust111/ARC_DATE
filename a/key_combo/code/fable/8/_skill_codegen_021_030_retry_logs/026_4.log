+
+def _sample_endpoint_pair(height: int, width: int, used_endpoints: set[Coord]) -> tuple[Coord, Coord] | None:
+    row_candidates = list(range(height))
+    col_candidates = list(range(width))
+    for _ in range(PAIR_PLACEMENT_RETRIES):
