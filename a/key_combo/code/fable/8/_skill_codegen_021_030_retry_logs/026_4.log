+    if int(orientation) == 0:
+        bend = (r0, c1)
+    else:
+        bend = (r1, c0)
+    cells = set(_segment_cells((r0, c0), bend))
+    cells.update(_segment_cells(bend, (r1, c1)))
+    return frozenset(cells)
