+                if len(summary["disjoint_reports"]) < 2 or len(summary["cover_reports"]) < 2:
+                    continue
+                if not summary["disjoint_variety"] or not summary["cover_variety"]:
+                    continue
+                if not summary["all_checkpoint_essential"]:
