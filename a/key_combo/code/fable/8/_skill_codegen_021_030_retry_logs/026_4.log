+def _parse_pair_specs(grid: np.ndarray, bg: int) -> list[dict]:
+    colors = [int(c) for c in np.unique(grid) if int(c) not in {int(bg), CHECKPOINT_COLOR}]
+    assert colors, "expected at least one endpoint pair"
+
+    pair_specs = []
+    for color in colors:
