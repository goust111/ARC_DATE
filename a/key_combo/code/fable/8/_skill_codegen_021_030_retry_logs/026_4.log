+                checkpoints = frozenset(random.sample(useful, size))
+                summary = _semantic_summary_from_reports(pair_specs, checkpoints, all_reports)
+                if summary["solution_bits"] != target_bits:
+                    continue
+                if len(summary["valid_reports"]) != 1:
