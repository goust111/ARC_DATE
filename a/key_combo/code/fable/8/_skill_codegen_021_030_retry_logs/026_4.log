def summary_from_reports(pair_specs, checkpoints, all_reports, disjoint_reports):
    cover_reports = [r for r in all_reports if checkpoints <= r['union']]
    valid_reports = [r for r in disjoint_reports if checkpoints <= r['union']]
    solution_bits = valid_reports[0]['bits'] if len(valid_reports) == 1 else None
    all_checkpoint_essential = True
    for cp in checkpoints:
        reduced = checkpoints - {cp}
        reduced_valid = [r for r in disjoint_reports if reduced <= r['union']]
        if len(reduced_valid) <= 1:
            all_checkpoint_essential = False
            break
    def variety(reports):
        if not reports:
            return False
        n = len(pair_specs)
        for i in range(n):
            if {r['bits'][i] for r in reports} "'!= {0,1}:
                return False
        return True
    checkpoint_sources = set()
    if solution_bits is not None:
        for i, spec in enumerate(pair_specs):
            chosen = spec['"'paths'][solution_bits[i]]
            if any(cp in chosen for cp in checkpoints):
                checkpoint_sources.add(i)
    return {
        'cover_reports': cover_reports,
        'valid_reports': valid_reports,
        'solution_bits': solution_bits,
        'all_checkpoint_essential': all_checkpoint_essential,
