+                if not summary["disjoint_variety"] or not summary["cover_variety"]:
+                    continue
+                if not summary["all_checkpoint_essential"]:
+                    continue
+                if not summary["endpoint_overlap_free"]:
+                    continue
+                if summary["checkpoints_touch_pairs"] < min(2, len(pair_specs)):
