+def _l_path(end_a: Coord, end_b: Coord, orientation: int) -> frozenset[Coord]:
+    (r0, c0), (r1, c1) = end_a, end_b
+    if int(orientation) == 0:
+        bend = (r0, c1)
+    else:
+        bend = (r1, c0)
+    cells = set(_segment_cells((r0, c0), bend))
+    cells.update(_segment_cells(bend, (r1, c1)))
