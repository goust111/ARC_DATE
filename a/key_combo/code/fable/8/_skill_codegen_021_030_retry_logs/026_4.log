+                "bits": tuple(bits),
+                "disjoint": disjoint,
+                "union": frozenset(union),
+            }
+        )
+    return reports
+
+
+def _render_solution(shape: tuple[int, int], pair_specs: list[dict], bits: tuple[int, ...], bg: int) -> np.ndarray:
+    out = np.full(shape, int(bg), dtype=int)
