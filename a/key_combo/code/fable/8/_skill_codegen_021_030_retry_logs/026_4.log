+def _enumerate_reports(pair_specs: list[dict]) -> list[dict]:
+    reports = []
+    for bits in itertools.product((0, 1), repeat=len(pair_specs)):
+        union: set[Coord] = set()
+        disjoint = True
+        for spec, bit in zip(pair_specs, bits):
+            path = spec["paths"][bit]
+            if union & path:
+                disjoint = False
+            union.update(path)
+        reports.append(
