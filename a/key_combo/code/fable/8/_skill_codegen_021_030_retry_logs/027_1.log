+_GEN_ATTEMPTS = 500
+_GEN_HEIGHTS = tuple(range(8, 15))
+_GEN_INTERIOR_WIDTHS = (4, 5, 6)
+_GEN_NUM_PANELS = (3, 4)
+_GEN_SPRITE_HEIGHTS = (2, 3, 4)
+_GEN_SPRITE_WIDTHS = (2, 3, 4)
