+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    seen = np.zeros_like(mask, dtype=bool)
+    pieces: list[np.ndarray] = []
+    h, w = mask.shape
+    for r, c in np.argwhere(mask):
+        r = int(r)
+        c = int(c)
+        if seen[r, c]:
+            continue
+        stack = [(r, c)]
+        seen[r, c] = True
+        coords: list[Coord] = []
+        while stack:
+            cr, cc = stack.pop()
+            coords.append((cr, cc))
+            for nr, nc in _neighbors4(cr, cc):
