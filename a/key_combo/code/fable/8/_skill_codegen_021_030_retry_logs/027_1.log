+
+def _infer_panel_layout(grid: np.ndarray) -> tuple[int, int, int, list[np.ndarray]]:
+    frame = int(grid[0, 0])
+    h, w = grid.shape
+    assert h >= 5 and w >= 5
+    assert np.all(grid[0, :] == frame) and np.all(grid[-1, :] == frame)
