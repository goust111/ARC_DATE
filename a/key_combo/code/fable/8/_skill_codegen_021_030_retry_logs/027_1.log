+    deltas = [b - a for a, b in zip(top_rows, top_rows[1:])]
+    assert deltas and len(set(deltas)) == 1, "top-row motion must be constant"
+    delta = int(deltas[0])
+    assert delta != 0, "movement must be nonzero"
