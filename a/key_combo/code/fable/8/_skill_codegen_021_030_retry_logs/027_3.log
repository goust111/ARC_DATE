+    for rotations in range(4):
+        for reflect in (False, True):
+            mask = _apply_transform(base, rotations, reflect)
+            norm = _normalize_coords(np.argwhere(mask))
+            if norm in seen:
+                continue
+            seen.add(norm)
+            out.append(
