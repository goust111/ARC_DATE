+    assert np.any(inp != expected)
+    for cavity, match in zip(cavities, matches):
+        assert cavity["area"] == int(np.sum(match["patch"] != bg))
+        unique_colors = {int(v) for v in match["patch"].flatten() if int(v) != bg}
+        assert len(unique_colors) >= 2
