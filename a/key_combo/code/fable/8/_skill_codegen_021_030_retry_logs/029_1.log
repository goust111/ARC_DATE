+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+class Color:
+    BLACK = 0
+    BLUE = 1
+    TEAL = 8
+
+
+SIDE_TO_VEC = {
+    "top": (-1, 0),
+    "bottom": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
