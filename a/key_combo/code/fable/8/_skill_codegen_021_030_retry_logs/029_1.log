+def _draw_frame(grid: np.ndarray, bbox: tuple[int, int, int, int], gaps: tuple[tuple[int, int], ...]) -> None:
+    gap_set = set(gaps)
+    for cell in _border_cells(bbox):
+        if cell not in gap_set:
