+                    if c1 - c0 < 2:
+                        continue
+                    if (r0, c1) not in blue_set or (r1, c1) not in blue_set:
+                        continue
+                    bbox = (r0, c0, r1, c1)
+                    if bbox in candidates_by_bbox:
+                        continue
+                    candidate = candidate_from_bbox(bbox)
+                    if candidate is not None:
+                        candidates_by_bbox[bbox] = candidate
