+                                "painted": tuple(_segment_cells(exit_gap, direction, steps)),
+                                "stop": "frame",
+                                "target_bbox": bbox,
+                            }
+                            reserved_added = set(segment["painted"])
+                            chain.append(
+                                {
+                                    "bbox": bbox,
+                                    "gaps": (entry_cell, exit_gap2),
+                                    "role": "chain",
+                                    "entry_gap": entry_cell,
+                                    "exit_gap": exit_gap2,
+                                    "exit_side": exit_side2,
+                                }
