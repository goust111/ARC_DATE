+                                gap_side2 = random.choice([side for side in SIDES if side != gap_side1])
+                                gaps = []
+                                for gap_side in (gap_side1, gap_side2):
+                                    offsets = _shuffle(_valid_offsets(gap_side, dh, dw))
+                                    chosen_gap = None
+                                    for off in offsets:
+                                        gap = _frame_gap_coord(decoy_bbox, gap_side, off)
+                                        if gap != hit_cell:
+                                            chosen_gap = gap
