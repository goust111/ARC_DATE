+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+class Color:
+    BLACK = 0
+    BLUE = 1
+    TEAL = 8
+
+
+SIDE_TO_VEC = {
+    "top": (-1, 0),
+    "bottom": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+OPPOSITE_SIDE = {
+    "top": "bottom",
+    "bottom": "top",
+    "left": "right",
+    "right": "left",
+}
+SIDES = ("top", "bottom", "left", "right")
+
+GRID_MIN = 18
+GRID_MAX = 30
+CHAIN_LEN_RANGE = (2, 5)
+FRAME_H_RANGE = (4, 7)
+FRAME_W_RANGE = (4, 7)
+SEGMENT_LEN_RANGE = (1, 8)
+EXTRA_FRAME_RANGE = (0, 2)
+TERMINAL_WALL_PROB = 0.65
+MAX_GENERATE_ATTEMPTS = 500
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= int(r) < int(shape[0]) and 0 <= int(c) < int(shape[1])
+
+
+def _neighbors4(r: int, c: int) -> list[tuple[int, int]]:
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def _bbox_coords(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _components_mask(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                comp.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _border_cells(bbox: tuple[int, int, int, int]) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    cells: list[tuple[int, int]] = []
+    for c in range(c0, c1 + 1):
+        cells.append((r0, c))
+        cells.append((r1, c))
+    for r in range(r0 + 1, r1):
+        cells.append((r, c0))
+        cells.append((r, c1))
+    return cells
+
+
+def _gap_side(gap: tuple[int, int], bbox: tuple[int, int, int, int]) -> str:
+    r, c = gap
+    r0, c0, r1, c1 = bbox
+    if r == r0:
+        return "top"
+    if r == r1:
+        return "bottom"
+    if c == c0:
+        return "left"
+    if c == c1:
