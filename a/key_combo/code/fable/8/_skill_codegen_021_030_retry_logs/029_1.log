+                    hit_side = OPPOSITE_SIDE[exit_side]
+                    for steps in lengths:
+                        if not _segment_clear(exit_gap, direction, steps, frames, reserved_cells):
+                            continue
+                        hit_cell = (exit_gap[0] + direction[0] * steps, exit_gap[1] + direction[1] * steps)
+                        for _ in range(20):
