+                        last["gaps"] = (entry_gap, exit_gap) if entry_gap is not None else (exit_gap,)
+                        last["exit_gap"] = exit_gap
+                        last["exit_side"] = exit_side
+                        frames[-1]["gaps"] = last["gaps"]
