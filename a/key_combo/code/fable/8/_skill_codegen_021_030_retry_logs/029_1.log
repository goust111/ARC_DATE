+
+def _segment_clear(
+    start: tuple[int, int],
+    direction: tuple[int, int],
+    steps: int,
+    frames: list[dict],
+    reserved_cells: set[tuple[int, int]],
+) -> bool:
+    if steps < 1:
+        return False
+    for cell in _segment_cells(start, direction, steps, include_start=False, include_end=False):
