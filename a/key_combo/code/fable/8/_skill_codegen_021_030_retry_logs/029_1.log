+            out[r, c] = Color.TEAL
+            painted.append((r, c))
+            r += dr
+            c += dc
+        else:
+            segments.append({"stop": "boundary", "painted": tuple(painted)})
+            return (out, {"visited_bboxes": visited_bboxes, "segments": segments}) if return_trace else out
