+    source_id = source_ids[0]
+    for idx, frame in enumerate(frames):
+        if idx == source_id:
+            continue
+        if len(frame["gaps"]) != 2:
+            raise AssertionError("non-source frames must have exactly two gaps")
+        if frame["interior"].size and not np.all(frame["interior"] == Color.BLACK):
