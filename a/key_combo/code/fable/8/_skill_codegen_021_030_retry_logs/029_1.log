+                return False
+    return True
+
+
+def _sample_dims() -> tuple[int, int]:
+    return random.randint(*FRAME_H_RANGE), random.randint(*FRAME_W_RANGE)
+
+
+def _shuffle(seq):
+    seq = list(seq)
+    random.shuffle(seq)
+    return seq
+
+
+def _candidate_exit_sides(entry_side: str) -> list[str]:
