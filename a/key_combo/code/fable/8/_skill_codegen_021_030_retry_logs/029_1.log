+def _candidate_exit_sides(entry_side: str) -> list[str]:
+    adjacent = [side for side in SIDES if side not in (entry_side, OPPOSITE_SIDE[entry_side])]
+    opposite = [OPPOSITE_SIDE[entry_side]]
