+        candidate_sides = [side for side in SIDES if side != entry_side]
+        candidate_sides = _shuffle(candidate_sides)
+        for exit_side in candidate_sides:
+            for exit_offset in _shuffle(_valid_offsets(exit_side, h, w)):
