+
+def _can_place_bbox(
+    bbox: tuple[int, int, int, int],
+    shape: tuple[int, int],
+    frames: list[dict],
+    reserved_cells: set[tuple[int, int]],
+) -> bool:
+    if not _bbox_in_bounds(bbox, shape):
+        return False
+    for frame in frames:
+        if _boxes_overlap(bbox, frame["bbox"], pad=1):
