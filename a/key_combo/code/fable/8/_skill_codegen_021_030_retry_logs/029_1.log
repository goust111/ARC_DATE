+
+class Color:
+    BLACK = 0
+    BLUE = 1
+    TEAL = 8
+
+
+SIDE_TO_VEC = {
+    "top": (-1, 0),
+    "bottom": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+OPPOSITE_SIDE = {
+    "top": "bottom",
+    "bottom": "top",
+    "left": "right",
+    "right": "left",
+}
+SIDES = ("top", "bottom", "left", "right")
+
+GRID_MIN = 18
+GRID_MAX = 30
+CHAIN_LEN_RANGE = (2, 5)
