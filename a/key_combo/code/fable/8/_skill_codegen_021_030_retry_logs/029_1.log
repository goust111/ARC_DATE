+FRAME_W_RANGE = (4, 7)
+SEGMENT_LEN_RANGE = (1, 8)
+EXTRA_FRAME_RANGE = (0, 2)
+TERMINAL_WALL_PROB = 0.65
+MAX_GENERATE_ATTEMPTS = 500
