+    h, w = grid.shape
+    for r in range(h - SAMPLE_SIZE + 1):
+        for c in range(w - SAMPLE_SIZE + 1):
+            if (r, c) == source:
+                continue
+            patch = grid[r : r + SAMPLE_SIZE, c : c + SAMPLE_SIZE]
