+    rr0 = max(0, r0 - 1)
+    cc0 = max(0, c0 - 1)
+    rr1 = min(grid.shape[0], r0 + h + 1)
+    cc1 = min(grid.shape[1], c0 + w + 1)
+    halo = grid[rr0:rr1, cc0:cc1].copy()
+    halo[r0 - rr0 : r0 - rr0 + h, c0 - cc0 : c0 - cc0 + w] = bg
+    return bool(np.all(halo == bg))
+
