+def _rigid_transform(patch: np.ndarray, transform_id: int) -> np.ndarray:
+    x = np.asarray(patch, dtype=int)
+    t = int(transform_id)
+    if t >= 4:
+        x = np.fliplr(x)
+        t -= 4
+    return np.rot90(x, k=t).copy()
