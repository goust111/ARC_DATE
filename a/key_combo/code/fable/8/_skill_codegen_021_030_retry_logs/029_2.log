+    return prototype_patch, prototype, residue_cells
+
+
+def _pair_candidates(
+    grid: np.ndarray,
+    prototype_patch: np.ndarray,
+    cluster: list[tuple[int, int, int]],
+    all_foreground: set[tuple[int, int]],
