+            eligible_pairs.append(((r1, c1), (r2, c2)))
+        if len(eligible_pairs) < 3:
+            continue
+        colors = random.sample(PALETTE, len(coords))
+        patch = np.zeros(mask.shape, dtype=int)
+        for (r, c), color in zip(coords, colors):
+            patch[r, c] = int(color)
+        return patch, eligible_pairs
