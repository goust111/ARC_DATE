+def _residue_clusters(residue_cells: list[tuple[int, int, int]], max_dist_sq: int) -> list[list[tuple[int, int, int]]]:
+    n = len(residue_cells)
+    clusters = []
+    seen = [False] * n
+    for i in range(n):
