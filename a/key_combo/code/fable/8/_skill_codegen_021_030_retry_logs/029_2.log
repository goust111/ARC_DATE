+TRANSFORM_IDS = tuple(range(8))
+BG = Color.BLACK
+PALETTE = tuple(range(1, 10))
+GRID_SIDE_RANGE = (18, 28)
+PROTO_HEIGHT_RANGE = (3, 5)
+PROTO_WIDTH_RANGE = (3, 5)
+PROTO_AREA_RANGE = (5, 8)
+PAIR_COUNT_RANGE = (2, 4)
+GEN_RETRIES = 400
