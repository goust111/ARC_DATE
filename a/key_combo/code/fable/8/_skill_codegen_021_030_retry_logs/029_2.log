+def _scene_parts(grid: np.ndarray):
+    comps = find_components(grid, bg=BG, connectivity=4, monochromatic=False, return_format="dict")
+    assert comps, "expected foreground"
+    areas = [int(comp["area"]) for comp in comps]
+    max_area = max(areas)
