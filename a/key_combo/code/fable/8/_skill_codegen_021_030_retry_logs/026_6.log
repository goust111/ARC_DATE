+    pair_choices = _candidate_pairs(shape)
+    max_pairs = min(6, len(pair_choices))
+    n_pairs = random.randint(2, max_pairs)
+    chosen_pairs = random.sample(pair_choices, n_pairs)
+
+    mismatch_count = random.randint(1, max(1, n_pairs - 1))
