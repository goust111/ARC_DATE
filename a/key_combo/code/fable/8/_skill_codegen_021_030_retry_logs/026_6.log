+    h, w = shape
+    r0, c0, r1, c1 = box
+    opts = []
+    if r0 - 1 >= 0:
+        opts.extend((r0 - 1, c) for c in range(c0, c1 + 1))
+    if r1 + 1 < h:
+        opts.extend((r1 + 1, c) for c in range(c0, c1 + 1))
+    if c0 - 1 >= 0:
+        opts.extend((r, c0 - 1) for r in range(r0, r1 + 1))
+    if c1 + 1 < w:
