+def _candidate_pairs(shape: tuple[int, int]) -> list[tuple[tuple[int, int, int, int], tuple[int, int, int, int]]]:
+    h, w = shape
+    rows = list(range(1, h - 2, 5))
+    cols = list(range(1, w - 2, 5))
+    pairs = []
+    for r0 in rows:
