+
+    return comps
+
+
+def _symmetric_bbox(box: tuple[int, int, int, int], shape: tuple[int, int]) -> tuple[int, int, int, int]:
+    h, w = shape
+    r0, c0, r1, c1 = box
+    return h - 1 - r1, w - 1 - c1, h - 1 - r0, w - 1 - c0
+
+
+def _extract_objects(grid: np.ndarray) -> list[dict]:
+    comps = _components_mask(grid != BG)
+    objects: list[dict] = []
+
+    for coords in comps:
