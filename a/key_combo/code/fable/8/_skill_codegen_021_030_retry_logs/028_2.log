+    bg, sep, source = _infer_palette(grid)
+    sep_rows, sep_cols = _separator_indices(grid, sep)
+    row_spans = _spans_from_cuts(grid.shape[0], sep_rows)
+    col_spans = _spans_from_cuts(grid.shape[1], sep_cols)
