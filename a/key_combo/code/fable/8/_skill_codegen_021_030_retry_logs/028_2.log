+        for j in range(cols - 1):
+            if v_doors[i, j]:
+                a = (i, j)
+                b = (i, j + 1)
+                graph[a].add(b)
+                graph[b].add(a)
+    return graph
+
+
+def _door_layout_is_rich(
+    rows: int,
+    cols: int,
