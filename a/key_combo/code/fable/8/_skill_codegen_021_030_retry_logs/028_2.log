+            "bg": bg,
+            "sep": sep,
+            "source": source,
+            "noise": noise,
+            "row_sizes": row_sizes,
+            "col_sizes": col_sizes,
+            "source_room": source_room,
+            "reachable": reachable,
+            "expected": expected,
+        }
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(_MAX_TRIES):
+        grid, meta = _build_case(return_meta=True)
+        try:
+            out = main(grid)
+        except AssertionError:
