  "type": "move_to_match",
  "src": "corner-anchored monochromatic object s",
  "dst": "next clockwise grid-corner slot d",
  "match_cond": "d.corner is the next clockwise corner after s.corner",
  "transform": "stamp s.mask with s.color aligned to d.corner, preserving orientation and leaving source pixels unless overwritten"
}
</annotation>
</reference_puzzle>

