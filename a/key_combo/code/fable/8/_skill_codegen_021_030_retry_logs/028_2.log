+
+    row_sizes = _random_room_sizes(rows)
+    col_sizes = _random_room_sizes(cols)
+    h = sum(row_sizes) + rows - 1
+    w = sum(col_sizes) + cols - 1
+    assert h <= 30 and w <= 30
+
