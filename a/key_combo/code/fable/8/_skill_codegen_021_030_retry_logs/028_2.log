+    h_doors: np.ndarray,
+    v_doors: np.ndarray,
+) -> tuple[bool, set[tuple[int, int]]]:
+    graph = _graph_from_doors(rows, cols, h_doors, v_doors)
+    reachable = _reachable_rooms(graph, source_room)
