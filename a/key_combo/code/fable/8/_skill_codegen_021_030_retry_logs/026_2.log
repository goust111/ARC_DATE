+    parity_sets = {0: [], 1: []}
+    for r in range(1, size - 1):
+        for c in range(1, size - 1):
+            parity_sets[(r + c) % 2].append((r, c))
+    return [coords for coords in parity_sets.values() if coords]
+
+
+def _make_template(size: int, hole_count: int) -> np.ndarray:
+    template = np.full((size, size), GEN_TEMPLATE, dtype=int)
+    candidate_sets = [coords for coords in _hole_candidate_sets(size) if len(coords) >= hole_count]
+    holes = random.sample(random.choice(candidate_sets), hole_count)
+    for r, c in holes:
