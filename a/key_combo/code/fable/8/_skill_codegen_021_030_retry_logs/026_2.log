0138: def _touch_graph(centers: list[tuple[int, int]]) -> list[set[int]]:
0139:     """Connect square indices whose rendered 3x3 blocks share an edge."""
0140:     neighbors = [set() for _ in centers]
0141:     for i, (r1, c1) in enumerate(centers):
0142:         for j, (r2, c2) in enumerate(centers[i + 1 :], start=i + 1):
