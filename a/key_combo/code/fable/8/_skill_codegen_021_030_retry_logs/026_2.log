+def _pattern_from_counts(colors: list[int], counts: dict[int, int], shape: tuple[int, int]) -> np.ndarray:
+    total = shape[0] * shape[1]
+    flat = []
+    for color in colors:
+        flat.extend([color] * counts[color])
