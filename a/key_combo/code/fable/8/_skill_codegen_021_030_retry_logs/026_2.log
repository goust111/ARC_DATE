+        if len(comps) < 2:
+            continue
+        boxes = [comp["bbox"] for comp in comps]
+        side = boxes[0][2] - boxes[0][0] + 1
+        if side < 3:
+            continue
+        if all(
+            box[2] - box[0] + 1 == side and box[3] - box[1] + 1 == side
+            for box in boxes
