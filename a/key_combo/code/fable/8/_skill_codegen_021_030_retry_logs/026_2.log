+def _separator_row(grid: np.ndarray) -> int:
+    rows = [r for r in range(grid.shape[0]) if np.all(grid[r] == grid[r, 0])]
+    assert len(rows) == 1, "expected exactly one solid separator row"
+    return int(rows[0])
