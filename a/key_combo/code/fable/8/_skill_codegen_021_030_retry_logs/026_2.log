+def _max_holes_for_size(size: int) -> int:
+    return {5: 4, 6: 6}[size]
+
+
+def _sample_counts_and_shape(size: int) -> tuple[list[int], tuple[int, int]]:
+    max_side = 30 // size
+    max_holes = _max_holes_for_size(size)
+    candidates = []
+    for n_templates in range(2, min(4, max_holes) + 1):
