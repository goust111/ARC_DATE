0022: def main(grid: np.ndarray) -> np.ndarray:
0023:     """
0024:     Draw the straight segment between the two red markers, turning crossed blue pixels green and crossed empty pixels red.
0025: 
0026:     Input structure
0027:     - The input contains only black background, blue foreground pixels, and exactly two red marker pixels.
0028:     - The two red markers lie on one horizontal, vertical, or 45-degree diagonal line.
0029: 
0030:     Rule
0031:     - Copy the input grid.
0032:     - Walk the inclusive straight segment from one red marker to the other.
0033:     - Each path cell that was blue becomes green; each path cell that was black or red becomes red.
0034: 
0035:     Key insight
0036:     - The red marker pair defines a queen-move path, and the output records which original cells on that path were blue versus not blue.
0037:     """
0038:     g = np.asarray(grid, dtype=int)
0039:     assert set(map(int, np.unique(g))) <= {0, 1, 2}, "expected only black, blue, and red in the input"
