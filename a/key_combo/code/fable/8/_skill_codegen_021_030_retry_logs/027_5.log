+def _compose_scene(rng: np.random.Generator, entities: list[EntityBundle]) -> tuple[np.ndarray, np.ndarray]:
+    sizes = [entity.input_patch.shape for entity in entities]
+    need_h = max(h for h, _ in sizes)
