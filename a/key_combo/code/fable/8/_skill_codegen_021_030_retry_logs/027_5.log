  59:           sprite.shape[0] == sprite.shape[1] and np.array_equal(sprite, np.rot90(sprite, 2).T)
  60:       ):
  61:         symmetric_sprite = sprite
  62:         break
  63: 
  64:     return symmetric_sprite
