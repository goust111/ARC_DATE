+    dest_r = rr0 + (bbox_h(root_bbox) - group_h) // 2
+    dest_c = rc0 + (bbox_w(root_bbox) - group_w) // 2
+    assert rr0 <= dest_r and dest_r + group_h - 1 <= rr1
+    assert rc0 <= dest_c and dest_c + group_w - 1 <= rc1
