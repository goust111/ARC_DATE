+            for r, c in cells:
+                frontier.update(_neighbors8(r, c, h, w))
+            frontier.difference_update(cells)
+            if not frontier:
+                break
+
+            def _score(cell: tuple[int, int]) -> tuple[int, float]:
+                r, c = cell
