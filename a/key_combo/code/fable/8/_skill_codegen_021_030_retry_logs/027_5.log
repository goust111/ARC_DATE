+    raise RuntimeError("failed to build nested branch")
+
+
+def _place_boxes(
+    rng: np.random.Generator,
+    patches: list[np.ndarray],
+    *,
+    min_h: int = 1,
+    max_h: int = 30,
+    min_w: int = 1,
