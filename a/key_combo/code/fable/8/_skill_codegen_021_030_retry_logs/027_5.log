+def _generate_case(rng: np.random.Generator) -> tuple[np.ndarray, np.ndarray]:
+    for _ in range(150):
+        tree_count = int(rng.choice([1, 2, 3], p=[0.45, 0.4, 0.15]))
+        standalone_count = int(rng.choice([0, 1, 2, 3], p=[0.2, 0.35, 0.3, 0.15]))
