 139: def _gen_bfs_dist(track_set, start):
 140:     """BFS distances from start over track_set."""
 141:     dist = {start: 0}
 142:     q = deque([start])
 143:     while q:
 144:         r, c = q.popleft()
 145:         for dr, dc in _GEN_DIRS4:
 146:             nr, nc = r+dr, c+dc
 147:             if (nr, nc) in track_set and (nr, nc) not in dist:
 148:                 dist[(nr, nc)] = dist[(r, c)] + 1
 149:                 q.append((nr, nc))
 150:     return dist
