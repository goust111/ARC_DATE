  20: def main(grid: np.ndarray) -> np.ndarray:
  21:     """
  22:     Extract the unique smallest solid monochrome rectangle as the entire output grid.
  23: 
  24:     Input structure
  25:     - The empty canvas color is the unique most common color on the grid boundary.
  26:     - Non-background pixels form one or more 4-connected monochrome objects.
  27:     - At least one non-background object is a filled axis-aligned rectangle.
  28: 
  29:     Rule
  30:     - Find every monochrome non-background object whose pixels exactly fill its bounding box.
  31:     - Select the unique filled rectangle with the smallest area.
  32:     - Return a solid grid with the selected rectangle's height, width, and color.
  33: 
  34:     Key insight
  35:     - Other objects are distractor rectangles or partial rectangles; the output is the
  36:       smallest complete rectangular object, detached from its original position.
  37:     """
  38:     g = np.asarray(grid, dtype=int)
  39:     assert g.ndim == 2, "expected a 2D grid"
  40:     assert min(g.shape) > 0, "expected a nonempty grid"
  41: 
  42:     bg = _boundary_background(g)
  43:     objects = find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict")
  44:     assert objects, "expected at least one non-background object"
  45: 
  46:     rectangles = []
  47:     for obj in objects:
  48:         box = obj["bbox"]
  49:         height = bbox_h(box)
  50:         width = bbox_w(box)
  51:         if int(obj["area"]) == height * width:
  52:             rectangles.append((int(obj["area"]), int(obj["color"]), height, width))
  53: 
  54:     assert rectangles, "expected at least one filled rectangle"
  55:     min_area = min(area for area, _color, _height, _width in rectangles)
  56:     smallest = [rect for rect in rectangles if rect[0] == min_area]
  57:     assert len(smallest) == 1, "expected a unique smallest filled rectangle"
  58: 
  59:     _area, color, height, width = smallest[0]
  60:     return np.full((height, width), color, dtype=int)
