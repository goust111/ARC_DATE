 119:         for h in range(GEN_DISTRACTOR_RECT_MIN_DIM, max_h + 1)
 120:         for w in range(GEN_DISTRACTOR_RECT_MIN_DIM, max_w + 1)
 121:         if lo <= h * w <= hi
