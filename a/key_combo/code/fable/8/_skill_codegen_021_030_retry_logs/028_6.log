 347: def _gen_add_and_validate_endpoints(track, best_pair, H, W):
 348:     """Add stems and return endpoint cells if they satisfy degree/border checks."""
 349:     ep1_info, ep2_info = best_pair
 350:     att1, pos1, side1, _ = ep1_info
 351:     att2, pos2, side2, _ = ep2_info
 352:     _gen_add_stem(track, att1, side1, H, W)
 353:     _gen_add_stem(track, att2, side2, H, W)
 354:     endpoint_cells = [pos1, pos2]
 355: 
 356:     for ep in endpoint_cells:
 357:         deg = sum(1 for dr, dc in _GEN_DIRS4
 358:                   if (ep[0]+dr, ep[1]+dc) in track)
 359:         if deg != 1:
 360:             return None
 361: 
 362:     for ep in endpoint_cells:
 363:         if not (ep[0] == 0 or ep[0] == H - 1 or ep[1] == 0 or ep[1] == W - 1):
 364:             return None
 365:     return endpoint_cells
 366: 
 367: 
 368: def _gen_blocker_candidates(track, endpoint_cells, H, W):
 369:     """Find interior track cells that can act as orange blockers."""
 370:     blocker_candidates = []
 371:     for (r, c) in track:
 372:         if (r, c) in endpoint_cells:
 373:             continue
 374:         if r <= 0 or r >= H - 1 or c <= 0 or c >= W - 1:
 375:             continue
 376:         nbr8 = [(r+dr, c+dc) for dr in [-1,0,1] for dc in [-1,0,1] if (dr,dc) != (0,0)]
 377:         if any(n in endpoint_cells for n in nbr8):
 378:             continue
 379:         adj_track = sum(1 for dr, dc in _GEN_DIRS4 if (r+dr, c+dc) in track)
 380:         if adj_track < _GEN_MIN_BLOCKER_ADJACENCY:
 381:             continue
 382:         blocker_candidates.append((r, c))
 383:     return blocker_candidates
 384: 
 385: 
 386: def _gen_forbidden(blockers):
 387:     forbidden = set()
 388:     for br, bc in blockers:
 389:         for dr in [-1, 0, 1]:
 390:             for dc in [-1, 0, 1]:
 391:                 forbidden.add((br + dr, bc + dc))
 392:     return forbidden
 393: 
 394: 
 395: def _gen_choose_blockers(n_blockers, blocker_candidates, attempt):
 396:     if n_blockers == 1:
 397:         idx = attempt % len(blocker_candidates)
 398:         return [blocker_candidates[idx]]
 399: 
 400:     idx1 = random.randint(0, len(blocker_candidates) - 1)
 401:     idx2 = random.randint(0, len(blocker_candidates) - 1)
 402:     if idx1 == idx2:
 403:         return None
 404:     blockers = [blocker_candidates[idx1], blocker_candidates[idx2]]
 405:     r1, c1 = blockers[0]
 406:     r2, c2 = blockers[1]
 407:     if (
 408:         abs(r1-r2) <= _GEN_BLOCKER_SEPARATION
 409:         and abs(c1-c2) <= _GEN_BLOCKER_SEPARATION
 410:     ):
 411:         return None
 412:     return blockers
 413: 
