 331: def _gen_add_stem(track, attachment, side, H, W):
 332:     r, c = attachment
 333:     if side == 'top':
 334:         for sr in range(0, r):
 335:             track.add((sr, c))
 336:     elif side == 'bot':
 337:         for sr in range(r + 1, H):
 338:             track.add((sr, c))
 339:     elif side == 'left':
 340:         for sc in range(0, c):
 341:             track.add((r, sc))
 342:     elif side == 'right':
 343:         for sc in range(c + 1, W):
 344:             track.add((r, sc))
 345: 
