 153: def _gen_path_cells(track_set, start, end):
 154:     """Return (set of cells on ALL shortest paths, path_length) for uniqueness check."""
 155:     dist_s = _gen_bfs_dist(track_set, start)
 156:     if end not in dist_s:
 157:         return None, None
 158:     dist_e = _gen_bfs_dist(track_set, end)
 159:     length = dist_s[end]
 160:     cells = {p for p in dist_s if p in dist_e and dist_s[p] + dist_e[p] == length}
 161:     return cells, length
