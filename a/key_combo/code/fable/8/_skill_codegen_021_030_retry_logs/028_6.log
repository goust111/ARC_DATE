 160:     elif side == "bottom":
 161:         patch[h - depth :, start : start + length] = GEN_BACKGROUND
 162:     elif side == "left":
 163:         patch[start : start + length, :depth] = GEN_BACKGROUND
 164:     else:
 165:         patch[start : start + length, w - depth :] = GEN_BACKGROUND
