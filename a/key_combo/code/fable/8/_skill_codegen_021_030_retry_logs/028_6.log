 164: def _gen_has_unique_simple_path(track_set, start, end):
 165:     """Return True iff exactly one simple path connects start to end."""
 166:     stack = [(start, {start})]
 167:     count = 0
 168:     while stack:
 169:         cell, seen = stack.pop()
 170:         if cell == end:
 171:             count += 1
 172:             if count > 1:
 173:                 return False
 174:             continue
 175:         r, c = cell
 176:         for dr, dc in _GEN_DIRS4:
 177:             nxt = (r + dr, c + dc)
 178:             if nxt in track_set and nxt not in seen:
 179:                 stack.append((nxt, seen | {nxt}))
 180:     return count == 1
