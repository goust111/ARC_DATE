  47: def main(grid: np.ndarray) -> np.ndarray:
  48:     """
  49:     Copy each foreground object anchored in a true grid corner clockwise into the next corner.
  50: 
  51:     Input structure
  52:     - The dominant color is the background.
  53:     - Foreground objects are monochromatic 4-connected components.
  54:     - Relevant objects are exactly those whose bounding box touches two adjacent borders at one grid corner.
  55: 
  56:     Rule
  57:     - Start from the input unchanged.
  58:     - For each corner object, copy its pixel mask and color to the next corner clockwise: top-left to top-right, top-right to bottom-right, bottom-right to bottom-left, and bottom-left to top-left.
  59:     - Preserve each object's orientation by aligning its bounding box to the destination corner; stamps may overwrite existing pixels at the destination, but source pixels are not cleared.
  60: 
  61:     Key insight
  62:     - Interior and side-only objects are distractors; only components actually anchored to a corner participate in the clockwise perimeter copy.
  63:     """
  64:     g = np.asarray(grid, dtype=int)
  65:     assert g.ndim == 2, "expected a 2D grid"
  66:     height, width = map(int, g.shape)
  67:     bg = get_bg(g)
  68: 
  69:     by_corner: dict[Corner, dict] = {}
  70:     for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True):
  71:         corner = _bbox_corner(comp["bbox"], height, width)
  72:         if corner is None:
  73:             continue
  74:         assert corner not in by_corner, "expected at most one source object per corner"
  75:         by_corner[corner] = comp
  76: 
  77:     assert by_corner, "expected at least one corner-anchored object"
  78: 
  79:     out = g.copy()
  80:     planned: dict[tuple[int, int], int] = {}
  81:     for src_corner, comp in by_corner.items():
  82:         r0, c0, r1, c1 = comp["bbox"]
  83:         obj_h = int(r1 - r0 + 1)
  84:         obj_w = int(c1 - c0 + 1)
  85:         dst_corner = _NEXT_CORNER[src_corner]
  86:         dst_r0, dst_c0 = _corner_anchor(dst_corner, height, width, obj_h, obj_w)
  87:         color = int(comp["color"])
  88: 
  89:         for r_raw, c_raw in comp["coords"]:
  90:             r = int(dst_r0 + int(r_raw) - r0)
  91:             c = int(dst_c0 + int(c_raw) - c0)
  92:             assert 0 <= r < height and 0 <= c < width, "corner stamp must remain in bounds"
  93:             assert (r, c) not in planned, "expected non-overlapping corner stamps"
  94:             planned[(r, c)] = color
  95: 
  96:     for (r, c), color in planned.items():
  97:         out[r, c] = color
  98: 
