  96: def main(grid: np.ndarray) -> np.ndarray:
  97:     """Recolor each framed interior mask with the color from the next red frame clockwise around the blue connector cycle.
  98: 
  99:     Input structure
 100:     - The grid contains hollow red square frames connected pairwise by blue line components.
 101:     - The blue components connect the frames into one cycle, with every frame touching exactly two blue components.
 102:     - Each frame interior contains background plus exactly one non-background color mask.
 103: 
 104:     Rule
 105:     - Sort the red frames clockwise by their centers around the cycle.
 106:     - Keep each frame's interior mask shape in place, but recolor it with the interior color from the next clockwise frame.
 107:     - Leave the red frames, blue connectors, background, and interior background holes unchanged.
 108: 
 109:     Key insight
 110:     - The colored masks do not move; the blue cycle gives the order in which their colors rotate.
 111:     """
 112:     g = np.asarray(grid, dtype=int)
 113:     bg = get_bg(g)
 114:     frames, red_components = _extract_frames(g, bg)
 115:     edges = _blue_cycle_edges(g, red_components)
 116:     order = _clockwise_order(frames, edges)
 117: 
 118:     out = g.copy()
 119:     for k, frame_id in enumerate(order):
 120:         next_id = order[(k + 1) % len(order)]
 121:         r0, c0, r1, c1 = frames[frame_id]["bbox"]
 122:         interior = out[r0 + 1 : r1, c0 + 1 : c1]
 123:         interior[frames[frame_id]["mask"]] = frames[next_id]["color"]
 124:     return out
