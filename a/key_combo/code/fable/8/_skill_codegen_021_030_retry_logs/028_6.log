  14: def main(input_grid):
  15:     """
  16:     Draw same-colored straight lines from aligned pixels to the largest rectangle on a non-black background.
  17: 
  18:     Input structure:
  19:     - The background is the most common non-black color.
  20:     - One large monochromatic rectangle and several single colored pixels are present.
  21:     - Some pixels share a row or column with the rectangle.
  22: 
  23:     Rule:
  24:     - Identify the background, the largest object as the rectangle, and all other objects as pixels.
  25:     - For each pixel, slide in cardinal directions until it contacts the rectangle and the next step would overlap.
  26:     - Draw a line from the pixel to that contact point using the pixel color.
  27: 
  28:     Key insight:
  29:     - A pixel connects only when row or column alignment lets it reach the rectangle by straight motion.
  30:     """
  31:     # Plan:
  32:     # 1. Find the background color
  33:     # 2. Extract objects, separating the pixels from the rectangle
  34:     # 3. For each pixel, draw a line to the rectangle
  35: 
  36:     # The background is the most common color
  37:     background = np.bincount(input_grid.flatten()).argmax()
  38: 
  39:     objects = find_components(input_grid, bg=background, connectivity=4, monochromatic=True, return_format="objects")
  40:     # The rectangle is the largest object
  41:     rectangle_object = max(objects, key=lambda obj: np.sum(obj != background))
  42:     # The pixels are the rest
  43:     pixel_objects = [obj for obj in objects if obj is not rectangle_object]
  44: 
  45:     for pixel_object in pixel_objects:
  46:         for r, c in np.argwhere(pixel_object != background):
  47:             pixel_color = pixel_object[r, c]
  48: 
  49:             # Check if the pixel is on a horizontal or vertical line with the rectangle
  50:             # Do this by trying to move the pixel up/down/left/right by different amounts until there is contact
  51:             # After finding contact, double check that going one step further would lead to overlap (collision) to avoid glancing contact
  52:             for dr, dc in [(0, 1), (1, 0), (0, -1), (-1, 0)]: # up, right, down, left
  53:                 for distance in range(max(input_grid.shape)):
  54:                     translated_pixel = translate(pixel_object, distance * dr, distance * dc, background=background)
  55:                     if contact(object1=translated_pixel, object2=rectangle_object, background=background) and\
  56:                         collision(object1=translate(pixel_object, (distance + 1) * dr, (distance + 1) * dc, background=background), object2=rectangle_object, background=background):
  57:                         # Draw the line
  58:                         end_r, end_c = r + distance * dr, c + distance * dc
  59:                         draw_line(input_grid, r, c, end_r=end_r, end_c=end_c, color=pixel_color)
  60:                         break
  61:     
  62:     return input_grid
  63:                 
  64: 
  65: 
  66: def generate_input():
  67:     # Plan:
  68:     # 1. Pick different colors for the background, rectangle, and pixels
  69:     # 2. Randomly place the rectangle
  70:     # 3. Randomly place the pixels
  71:     # 4. Check that at least one pixel will make a line to the rectangle
  72: 
  73:     background_color, rectangle_color, pixel_color = np.random.choice(Color.NOT_BLACK, size=3, replace=False)
  74:     width, height = np.random.randint(7, 20, size=2)
  75: 
  76:     input_grid = np.full((width, height), fill_value=background_color)
  77: 
  78:     rectangle_width, rectangle_height = np.random.randint(2, width//2), np.random.randint(2, height//2)
  79:     rectangle_sprite = random_sprite(rectangle_width, rectangle_height, color_palette=[rectangle_color], density=1)
  80:     rectangle_r, rectangle_c = random_free_location(
  81:         input_grid,
  82:         rectangle_sprite,
  83:         transparent=background_color,
  84:         border=1,
  85:         padding=1,
  86:         padding_connectivity=8,
  87:     )
  88:     paste(input_grid, rectangle_sprite, rectangle_r, rectangle_c, transparent=background_color, clip=True)
  89: 
  90:     n_pixels = np.random.randint(2, 8)
  91:     for _ in range(n_pixels):
  92:         pixel_sprite = random_sprite(1, 1, color_palette=[pixel_color], density=1)
  93:         try:
  94:             pixel_r, pixel_c = random_free_location(
  95:                 input_grid,
  96:                 pixel_sprite,
  97:                 transparent=background_color,
  98:                 border=1,
  99:                 padding=1,
 100:                 padding_connectivity=8,
 101:             )
 102:         except ValueError:
 103:             break
 104:         paste(input_grid, pixel_sprite, pixel_r, pixel_c, transparent=background_color, clip=True)
 105:     
 106:     # Check that at least one pixel shares an X or Y coordinate with the rectangle
 107:     rectangle_coordinates = np.argwhere(input_grid == rectangle_color)
 108:     pixel_coordinates = np.argwhere(input_grid == pixel_color)
 109:     rectangle_xs, rectangle_ys = set(rectangle_coordinates[:, 0]), set(rectangle_coordinates[:, 1])
 110:     pixel_xs, pixel_ys = set(pixel_coordinates[:, 0]), set(pixel_coordinates[:, 1])
 111:     if not (rectangle_xs & pixel_xs) and not (rectangle_ys & pixel_ys):
 112:         return generate_input()
 113:     
 114:     return input_grid

