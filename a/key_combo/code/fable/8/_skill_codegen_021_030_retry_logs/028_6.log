 129: def _gen_notched_nonrect_patch(grid_h: int, grid_w: int, target_area: int, color: int, size_cap: int) -> np.ndarray | None:
 130:     max_h, max_w = min(int(grid_h) - 1, int(size_cap)), min(int(grid_w) - 1, int(size_cap))
 131:     fill_min, fill_max = GEN_NONRECT_FILL_RANGE
 132:     candidates: list[tuple[int, int, str, int, int, int]] = []
 133:     for h in range(GEN_NONRECT_MIN_DIM, max_h + 1):
 134:         for w in range(GEN_NONRECT_MIN_DIM, max_w + 1):
 135:             area = h * w
 136:             for side in ("top", "bottom"):
 137:                 for length in range(1, w - 1):
 138:                     for start in range(1, w - length):
 139:                         for depth in range(1, h):
 140:                             removed = length * depth
 141:                             fill = (area - removed) / area
 142:                             if fill_min <= fill <= fill_max and area - removed > target_area:
 143:                                 candidates.append((h, w, side, start, length, depth))
 144:             for side in ("left", "right"):
 145:                 for length in range(1, h - 1):
 146:                     for start in range(1, h - length):
 147:                         for depth in range(1, w):
 148:                             removed = length * depth
 149:                             fill = (area - removed) / area
 150:                             if fill_min <= fill <= fill_max and area - removed > target_area:
 151:                                 candidates.append((h, w, side, start, length, depth))
 152: 
 153:     if not candidates:
 154:         return None
