 223: def _gen_build_lattice(bar_rows, bar_cols):
 224:     """Build connected horizontal bars plus vertical connectors."""
 225:     track = set()
 226:     for i, row in enumerate(bar_rows):
 227:         for c in bar_cols[i]:
 228:             track.add((row, c))
 229: 
 230:     for i in range(len(bar_rows) - 1):
 231:         top_row = bar_rows[i]
 232:         bot_row = bar_rows[i + 1]
 233:         shared_cols = sorted(bar_cols[i] & bar_cols[i + 1])
 234:         if len(shared_cols) < _GEN_MIN_CONNECTORS:
 235:             return None
 236:         n_conn = random.randint(
 237:             _GEN_MIN_CONNECTORS, min(_GEN_MAX_CONNECTORS, len(shared_cols))
 238:         )
 239:         if len(shared_cols) >= 3 and n_conn >= _GEN_MIN_CONNECTORS:
 240:             chosen = [shared_cols[0], shared_cols[-1]]
 241:             mid = shared_cols[1:-1]
 242:             random.shuffle(mid)
 243:             chosen += mid[:n_conn - 2]
 244:         else:
 245:             chosen = random.sample(shared_cols, n_conn)
 246: 
 247:         for c in chosen:
 248:             for r in range(top_row, bot_row + 1):
 249:                 track.add((r, c))
 250: 
 251:     if not track:
 252:         return None
 253:     start_cell = next(iter(track))
 254:     visited = _gen_bfs_dist(track, start_cell)
 255:     if len(visited) != len(track):
 256:         return None
 257:     return track
