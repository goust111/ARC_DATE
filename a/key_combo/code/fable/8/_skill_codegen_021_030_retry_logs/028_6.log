 183: def _gen_choose_layout():
 184:     """Choose grid size and horizontal bar columns."""
 185:     H = random.choice(_GEN_HEIGHT_CHOICES)
 186:     W = _GEN_WIDTH
 187:     if H == 7:
 188:         n_bars = _GEN_BAR_COUNT_BY_HEIGHT[H][0]
 189:     else:
 190:         n_bars = random.choice(_GEN_BAR_COUNT_BY_HEIGHT[H])
 191:     bar_rows = [
 192:         _GEN_BAR_ROW_START + _GEN_BAR_ROW_STEP * i for i in range(n_bars)
 193:     ]
 194:     if bar_rows[-1] >= H:
 195:         return None
 196: 
 197:     bar_cols = []
 198:     for _ in range(n_bars):
 199:         c_start = random.randint(*_GEN_BAR_START_COL_RANGE)
 200:         c_end = random.randint(
 201:             W - _GEN_BAR_END_OFFSET_RANGE[0],
 202:             W - _GEN_BAR_END_OFFSET_RANGE[1],
 203:         )
 204:         cols = list(range(c_start, c_end + 1))
 205:         n_gaps = random.randint(0, _GEN_MAX_BAR_GAPS)
 206:         interior = [c for c in cols if c != c_start and c != c_end]
 207:         if n_gaps > 0 and len(interior) >= n_gaps * 2:
 208:             gap_candidates = interior[:]
 209:             random.shuffle(gap_candidates)
 210:             gaps_chosen = []
 211:             for gc in gap_candidates:
 212:                 if len(gaps_chosen) >= n_gaps:
 213:                     break
 214:                 if all(abs(gc - g) > 1 for g in gaps_chosen):
 215:                     gaps_chosen.append(gc)
 216:             for gc in gaps_chosen:
 217:                 cols.remove(gc)
 218:         bar_cols.append(set(cols))
 219: 
 220:     return H, W, bar_rows, bar_cols
