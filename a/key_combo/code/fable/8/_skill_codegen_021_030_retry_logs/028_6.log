  17: def main(input_grid):
  18:     """
  19:     Expand a vertical colored line into a centered alternating-color pyramid.
  20: 
  21:     Input structure:
  22:     - The input contains one non-black line segment on a black background.
  23:     - The line's dominant column gives the pyramid center column.
  24:     - The line length determines the pyramid height and widest row.
  25: 
  26:     Rule:
  27:     - Identify the line color, center column, and lowest occupied row.
  28:     - Build a black output grid of the same size.
  29:     - For each row above the line base, draw a centered run whose colors alternate by distance from the center.
  30: 
  31:     Key insight:
  32:     - The original line is the pyramid axis; moving upward shortens the run, while
  33:       horizontal parity controls the alternating colors.
  34:     """
  35:     # Plan (from the original seed solver):
  36:     # 1. Parse the input
  37:     # 2. Draw the left side of the pyramid
  38:     # 3. Draw the right side of the pyramid
  39:     #
  40:     # Note: the legacy seed version ran under a transpose wrapper. This migrated solver
  41:     # runs canonical `(r,c)`, so some low-level details differ, but the intent is the same.
  42: 
  43:     coords = np.argwhere(input_grid != Color.BLACK)
  44:     if coords.size == 0:
  45:         return input_grid.copy()
  46: 
  47:     # Line parameters
  48:     r_max = int(coords[:, 0].max())
  49:     cols, counts = np.unique(coords[:, 1], return_counts=True)
  50:     c0 = int(cols[int(np.argmax(counts))])
  51:     line_color = int(input_grid[int(coords[0, 0]), int(coords[0, 1])])
  52: 
  53:     if line_color == Color.ORANGE:
  54:         alt_color = Color.TEAL
  55:     elif line_color == Color.TEAL:
  56:         alt_color = Color.ORANGE
  57:     else:
  58:         alt_color = Color.TEAL
  59: 
  60:     H, W = input_grid.shape
  61:     out = np.full((H, W), Color.BLACK, dtype=int)
  62: 
  63:     # For each row of the line, draw a centered run with alternating colors.
  64:     for r in range(r_max + 1):
  65:         half = r_max - r
  66:         for dc in range(-half, half + 1):
  67:             c = c0 + int(dc)
  68:             if 0 <= c < W:
  69:                 out[r, c] = int(line_color) if (abs(int(dc)) % 2 == 0) else int(alt_color)
  70: 
  71:     return out
  72: 
  73: def generate_input():
  74:     # Generate the background grid
  75:     width, height = np.random.randint(5, 10, size=2)
  76:     grid = np.full((width, height), Color.BLACK)
  77: 
  78:     # Randomly generate one orange line connecting to the top
  79:     # The line should be at least 4 cells long
  80:     length = np.random.randint(3, height - 1)
  81: 
  82:     # Randomly choose one position to start the line
  83:     r = np.random.randint(0, width)
  84:     line_color = Color.ORANGE
  85:     draw_line(grid=grid, r=r, c=0, direction=(0, 1), length=length, color=line_color)
  86: 
  87:     return grid

