 415: def _gen_ordered_path(passable, start, end, path_cells):
 416:     """Order a unique shortest path from end back to start using BFS ranks."""
 417:     dist_s = _gen_bfs_dist(passable, start)
 418:     path_ordered = [end]
 419:     current = end
 420:     ok = True
 421:     while current != start:
 422:         found = False
 423:         for dr, dc in _GEN_DIRS4:
 424:             nxt = (current[0]+dr, current[1]+dc)
 425:             if nxt in path_cells and dist_s.get(nxt, -1) == dist_s[current] - 1:
 426:                 path_ordered.append(nxt)
 427:                 current = nxt
 428:                 found = True
 429:                 break
 430:         if not found:
 431:             ok = False
 432:             break
 433:     return path_ordered if ok else None
 434: 
 435: 
 436: def _gen_turn_count(path_ordered):
 437:     turns = 0
 438:     for k in range(1, len(path_ordered) - 1):
 439:         d1 = (path_ordered[k][0] - path_ordered[k-1][0], path_ordered[k][1] - path_ordered[k-1][1])
 440:         d2 = (path_ordered[k+1][0] - path_ordered[k][0], path_ordered[k+1][1] - path_ordered[k][1])
 441:         if d1 != d2:
 442:             turns += 1
 443:     return turns
 444: 
 445: 
 446: def _gen_validate_blocked_path(track, endpoint_cells, forbidden):
 447:     passable = track - forbidden
 448: 
 449:     if endpoint_cells[0] not in passable or endpoint_cells[1] not in passable:
 450:         return False
 451: 
 452:     if not _gen_has_unique_simple_path(passable, endpoint_cells[0], endpoint_cells[1]):
 453:         return False
 454: 
 455:     path_cells, path_length = _gen_path_cells(passable, endpoint_cells[0], endpoint_cells[1])
 456:     if path_cells is None:
 457:         return False
 458: 
 459:     if len(path_cells) != path_length + 1:
 460:         return False
 461: 
 462:     if path_length < _GEN_TARGET_PATH_RANGE[0] or path_length > _GEN_TARGET_PATH_RANGE[1]:
 463:         return False
 464: 
 465:     coverage = len(path_cells) / len(track)
 466:     if coverage < _GEN_COVERAGE_RANGE[0] or coverage > _GEN_COVERAGE_RANGE[1]:
 467:         return False
 468: 
 469:     path_ordered = _gen_ordered_path(
 470:         passable, endpoint_cells[0], endpoint_cells[1], path_cells
 471:     )
 472:     if path_ordered is None or len(path_ordered) != path_length + 1:
 473:         return False
 474: 
 475:     turns = _gen_turn_count(path_ordered)
 476:     return _GEN_TURN_RANGE[0] <= turns <= _GEN_TURN_RANGE[1]
 477: 
 478: 
 479: def _gen_render_grid(track, endpoint_cells, blockers, H, W):
 480:     grid = np.zeros((H, W), dtype=int)
 481:     blocker_set = set(blockers)
 482:     for (r, c) in track:
 483:         if (r, c) in endpoint_cells:
 484:             grid[r, c] = Color.MAROON
 485:         elif (r, c) in blocker_set:
 486:             grid[r, c] = Color.ORANGE
 487:         else:
 488:             grid[r, c] = Color.TEAL
 489:     return grid
 490: 
 491: 
 492: def _gen_try_blockers(track, endpoint_cells, H, W):
 493:     """Place blockers, validate the unique route, and return a rendered grid."""
 494:     n_blockers = random.choice(_GEN_BLOCKER_CHOICES)
 495:     blocker_candidates = _gen_blocker_candidates(track, endpoint_cells, H, W)
 496:     if len(blocker_candidates) < n_blockers:
 497:         return None
 498: 
 499:     random.shuffle(blocker_candidates)
 500: 
 501:     for attempt in range(
 502:         min(
 503:             _GEN_MAX_BLOCKER_TRIES,
 504:             len(blocker_candidates) * _GEN_BLOCKER_TRIES_FACTOR,
 505:         )
 506:     ):
 507:         blockers = _gen_choose_blockers(n_blockers, blocker_candidates, attempt)
 508:         if blockers is None:
 509:             continue
 510: 
 511:         forbidden = _gen_forbidden(blockers)
 512:         if any(ep in forbidden for ep in endpoint_cells):
 513:             continue
 514: 
 515:         if not _gen_validate_blocked_path(track, endpoint_cells, forbidden):
 516:             continue
 517: 
 518:         grid = _gen_render_grid(track, endpoint_cells, blockers, H, W)
 519:         try:
 520:             out = main(grid)
 521:             if out is None:
 522:                 continue
 523:         except (AssertionError, Exception):
 524:             continue
 525:         return grid
 526: 
 527:     return None
 528: 
 529: 
 530: def _gen_attempt():
 531:     """Single attempt to generate a valid input grid."""
 532:     layout = _gen_choose_layout()
 533:     if layout is None:
 534:         return None
 535:     H, W, bar_rows, bar_cols = layout
 536: 
 537:     track = _gen_build_lattice(bar_rows, bar_cols)
 538:     if track is None:
 539:         return None
 540: 
 541:     border_candidates = _gen_border_candidates(track, H, W, bar_rows, bar_cols)
 542:     best_pair = _gen_choose_endpoints(track, border_candidates)
 543:     if best_pair is None:
 544:         return None
 545: 
 546:     endpoint_cells = _gen_add_and_validate_endpoints(track, best_pair, H, W)
 547:     if endpoint_cells is None:
 548:         return None
 549: 
 550:     if len(track) < _GEN_TRACK_SIZE_RANGE[0] or len(track) > _GEN_TRACK_SIZE_RANGE[1]:
 551:         return None
 552: 
 553:     return _gen_try_blockers(track, endpoint_cells, H, W)
 554: 
 555: 
 556: def generate_input() -> np.ndarray:
 557:     """Generate a valid input grid for the maze shortest-path task."""
 558:     for _ in range(_GEN_MAX_ATTEMPTS):
 559:         result = _gen_attempt()
 560:         if result is not None:
 561:             return result
 562:     raise RuntimeError(f"Failed to generate valid input after {_GEN_MAX_ATTEMPTS} attempts")

