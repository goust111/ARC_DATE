 281: def _gen_pair_distance(track, c1, c2):
 282:     att1, _, _, stem_len1 = c1
 283:     att2, _, _, stem_len2 = c2
 284:     d = _gen_bfs_dist(track, att1)
 285:     if att2 not in d:
 286:         return None
 287:     return d[att2] + stem_len1 + stem_len2
