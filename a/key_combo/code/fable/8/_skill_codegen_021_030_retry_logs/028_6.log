 290: def _gen_choose_endpoints(track, border_candidates):
 291:     """Pick two border endpoints whose stem-adjusted distance is task-like."""
 292:     if len(border_candidates) < 2:
 293:         return None
 294:     random.shuffle(border_candidates)
 295: 
 296:     best_pair = None
 297:     best_dist = 0
 298:     for i in range(min(_GEN_ENDPOINT_PRIMARY_LIMIT, len(border_candidates))):
 299:         for j in range(
 300:             i + 1, min(_GEN_ENDPOINT_SECONDARY_LIMIT, len(border_candidates))
 301:         ):
 302:             c1 = border_candidates[i]
 303:             c2 = border_candidates[j]
 304:             total_d = _gen_pair_distance(track, c1, c2)
 305:             if total_d is None:
 306:                 continue
 307:             if (
 308:                 _GEN_TARGET_PATH_RANGE[0] <= total_d <= _GEN_TARGET_PATH_RANGE[1]
 309:                 and total_d > best_dist
 310:             ):
 311:                 best_dist = total_d
 312:                 best_pair = (c1, c2)
 313: 
 314:     if best_pair is None:
 315:         for i in range(len(border_candidates)):
 316:             for j in range(i + 1, len(border_candidates)):
 317:                 c1 = border_candidates[i]
 318:                 c2 = border_candidates[j]
 319:                 total_d = _gen_pair_distance(track, c1, c2)
 320:                 if total_d is None:
 321:                     continue
 322:                 if total_d >= _GEN_FALLBACK_MIN_DISTANCE:
 323:                     best_pair = (c1, c2)
 324:                     best_dist = total_d
 325:                     break
 326:             if best_pair:
 327:                 break
 328:     return best_pair
