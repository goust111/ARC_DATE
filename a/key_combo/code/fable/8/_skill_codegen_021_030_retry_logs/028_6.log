   8: def main(grid: np.ndarray) -> np.ndarray:
   9:     """Use the red divider as a wall: fill the 4-connected lower-left side with the single payload color and clear the other side to black.
  10: 
  11:     Input structure
  12:     - The grid contains black cells, red divider pixels, and exactly one other payload color.
  13:     - Treating red as blocked, all non-red pixels form exactly two 4-connected regions.
  14:     - The lower-left corner is part of the region to fill.
  15: 
  16:     Rule
  17:     - Preserve every red pixel.
  18:     - Fill every non-red pixel in the same 4-connected region as the lower-left corner with the payload color.
  19:     - Recolor the other non-red region to black.
  20: 
  21:     Key insight
  22:     The noisy black/payload pattern in each region is irrelevant; the red wall partitions the canvas, and the side anchored at the lower-left corner is the solid foreground side.
  23:     """
  24:     g = np.asarray(grid, dtype=int)
  25:     h, w = g.shape
  26: 
  27:     payload_colors = colors_present(g, exclude={Color.BLACK, Color.RED})
  28:     assert len(payload_colors) == 1
  29:     payload = payload_colors[0]
  30:     assert g[h - 1, 0] != Color.RED
  31: 
  32:     regions = components_mask(g != Color.RED, connectivity=4)
  33:     assert len(regions) == 2
  34: 
  35:     lower_left = np.array([h - 1, 0])
  36:     fill_regions = [coords for coords in regions if np.any(np.all(coords == lower_left, axis=1))]
  37:     assert len(fill_regions) == 1
  38:     fill_region = fill_regions[0]
  39: 
  40:     out = np.full_like(g, Color.BLACK)
  41:     out[g == Color.RED] = Color.RED
  42:     out[fill_region[:, 0], fill_region[:, 1]] = payload
  43:     return out
  44: 
  45: # --------------- generator (o5x) ---------------
  46: 
  47: # Canvas anchors and size.
  48: GRID_SIZE = 10
  49: GRID_SHAPE = (GRID_SIZE, GRID_SIZE)
  50: LAST_IDX = GRID_SIZE - 1
  51: LOWER_LEFT, TOP_RIGHT = (LAST_IDX, 0), (0, LAST_IDX)
  52: 
  53: # Divider constraints.
  54: WALL_COUNT_MIN, WALL_COUNT_MAX = 10, 17
  55: MAX_RED_PER_COLUMN = 2
  56: MIN_WALL_ROW = 1
  57: SMALLER_FRACTION_MIN, SMALLER_FRACTION_MAX = 0.33, 0.49
  58: 
  59: # Left-to-right divider sampling.
  60: LR_FLAT_PROB = 0.30
  61: LR_FLAT_ROWS = (3, 4, 5, 6)
  62: LR_FLAT_SPANS = (1, 2, 3)
  63: LR_WALK_SPANS = (2, 3)
  64: LR_WALK_LOW_ROWS = {2: (3, 4, 5), 3: (3, 4)}
  65: MAX_ROW_STEP = 1
  66: 
  67: # Diagonal divider sampling.
  68: DIAGONAL_PROB = 0.35
  69: DIAGONAL_LONG_PROB = 0.80
  70: DIAGONAL_START_ROW = 1
  71: DIAGONAL_LONG_END_COL, DIAGONAL_SHORT_END_COL = 8, 7
  72: 
  73: # Region noise and retry controls.
  74: NOISE_DENSITY_MIN, NOISE_DENSITY_MAX = 0.40, 0.59
  75: MAX_ATTEMPTS = 300
  76: PAYLOAD_COLORS = tuple(c for c in Color.ALL_COLORS if c not in (Color.BLACK, Color.RED))
  77: 
  78: 
  79: def _gen_lr_wall() -> np.ndarray:
  80:     red = np.zeros(GRID_SHAPE, dtype=bool)
  81: 
  82:     if random.random() < LR_FLAT_PROB:
  83:         row = random.choice(LR_FLAT_ROWS)
  84:         rows = [row] * GRID_SIZE
  85:         span = random.choice(LR_FLAT_SPANS)
  86:         low = min(max(row - random.randint(0, span - 1), MIN_WALL_ROW), LAST_IDX - span)
  87:         allowed_rows = list(range(low, low + span))
  88:     else:
  89:         span = random.choice(LR_WALK_SPANS)
  90:         low = random.choice(LR_WALK_LOW_ROWS[span])
  91:         allowed_rows = list(range(low, low + span))
