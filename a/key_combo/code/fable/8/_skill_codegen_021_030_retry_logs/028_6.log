 172: def _gen_embedded_nonrect(
 173:     canvas: np.ndarray, target_r: int, target_c: int, target_h: int, target_w: int, color: int, size_cap: int
 174: ) -> bool:
 175:     grid_h, grid_w = canvas.shape
 176:     target_area = int(target_h) * int(target_w)
 177:     fill_min, fill_max = GEN_NONRECT_FILL_RANGE
 178:     candidates: list[tuple[int, int, int, int]] = []
 179:     for top in range(1, int(target_r) + 1):
 180:         for bottom in range(1, int(grid_h) - int(target_r) - int(target_h) + 1):
 181:             for left in range(1, int(target_c) + 1):
 182:                 for right in range(1, int(grid_w) - int(target_c) - int(target_w) + 1):
 183:                     full_h = int(target_h) + top + bottom
 184:                     full_w = int(target_w) + left + right
 185:                     if full_h > int(size_cap) or full_w > int(size_cap):
 186:                         continue
 187:                     full_area = full_h * full_w
 188:                     fill = (full_area - target_area) / full_area
 189:                     if fill_min <= fill <= fill_max and full_area - target_area > target_area:
 190:                         candidates.append((top, bottom, left, right))
 191:     if not candidates:
 192:         return False
 193: 
 194:     top, bottom, left, right = _gen_random.choice(candidates)
 195:     full_h = int(target_h) + top + bottom
 196:     full_w = int(target_w) + left + right
 197:     patch = np.full((full_h, full_w), int(color), dtype=int)
 198:     patch[top : top + int(target_h), left : left + int(target_w)] = GEN_BACKGROUND
 199:     if not _gen_is_contiguous(patch, background=GEN_BACKGROUND, connectivity=GEN_CONNECTIVITY):
 200:         return False
 201: 
 202:     r0 = int(target_r) - top
 203:     c0 = int(target_c) - left
 204:     if np.any((canvas[r0 : r0 + full_h, c0 : c0 + full_w] != GEN_BACKGROUND) & (patch != GEN_BACKGROUND)):
 205:         return False
 206:     _gen_paste(canvas, patch, r0, c0, transparent=GEN_BACKGROUND)
