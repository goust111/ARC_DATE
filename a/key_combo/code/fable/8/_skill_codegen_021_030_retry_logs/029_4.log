PROTO_COLORS = (Color.BLUE, Color.RED, Color.GREEN)
PROTO_STRUCTURE_PAIRS = ((1, 2), (1, 3), (2, 1), (2, 2), (2, 3))
PROTO_LINE_STEP = 2

# Skeleton anchors and composed input bounds.
SKELETON_TARGET_COL_MIN, SKELETON_TARGET_COL_MAX_EXCLUSIVE = 7, 12
