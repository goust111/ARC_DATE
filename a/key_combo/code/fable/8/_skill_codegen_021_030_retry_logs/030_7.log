COLOR_PALETTE = tuple(range(1, 10))
CANVAS_ROW_RANGE, CANVAS_COL_RANGE = (16, 28), (16, 26)
MIN_CANVAS_BY_FRAME_COUNT = {2: (18, 18), 3: (22, 21)}
