+        w = random.randint(*PATCH_SIDE_RANGE)
+        target = random.randint(
+            max(5, int(np.ceil(h * w * PATCH_DENSITY_RANGE[0]))),
+            max(5, int(np.floor(h * w * PATCH_DENSITY_RANGE[1]))),
