+def _mirror_patch(patch: np.ndarray, axis: str) -> np.ndarray:
+    if axis == "lr":
+        return patch[:, ::-1].copy()
+    if axis == "ud":
+        return patch[::-1, :].copy()
+    raise ValueError(f"unknown axis: {axis}")
