+def _dihedral_variants(mask: np.ndarray) -> list[Shape]:
+    seen: set[Shape] = set()
+    out: list[Shape] = []
+    for k in range(4):
+        rotated = np.rot90(mask, k)
+        for candidate in (rotated, np.fliplr(rotated)):
