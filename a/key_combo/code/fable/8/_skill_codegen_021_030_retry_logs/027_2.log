+def _extract_layout(grid: np.ndarray) -> tuple[int, int, np.ndarray, np.ndarray, np.ndarray]:
+    g = np.asarray(grid, dtype=int)
+    H, W = g.shape
+    divider_rows = [r for r in range(H) if np.all(g[r, :] == GREY)]
+    assert len(divider_rows) == 1
+    hdiv = divider_rows[0]
+    top = g[:hdiv, :]
+    bottom = g[hdiv + 1 :, :]
