38:         panel = g[:, start : start + 4]
39:         colors = set(map(int, np.unique(panel))) - {0}
40:         assert len(colors) == 1, "each panel must have exactly one foreground color"
41:         color = colors.pop()
42:         assert color != separator_color, "panel colors must differ from the separator color"
43:         panels.append(panel)
