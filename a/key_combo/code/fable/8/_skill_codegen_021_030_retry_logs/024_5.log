45:     assert len(set(panel_colors)) == len(panel_colors), "panel colors must be distinct"
46: 
47:     out = np.zeros((4, 4), dtype=int)
48:     filled = np.zeros((4, 4), dtype=bool)
49:     for panel_index in VISIBLE_ORDER:
50:         panel = panels[panel_index]
51:         mask = (panel != 0) & (~filled)
52:         out[mask] = panel[mask]
53:         filled |= mask
