+
+DIRS = {
+    "top": (-1, 0),
+    "bottom": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+
+FRAME_ORDER = ("right", "bottom", "left", "top")
+PALETTE = tuple(range(10))
+
+FRAME_H_RANGE = (4, 6)
+FRAME_W_RANGE = (4, 6)
+CORRIDOR_MIN = 1
+CORRIDOR_MAX = 3
+PAD_MIN = 1
+PAD_MAX = 2
+HCOUNT_CHOICES = (1, 2)
+VCOUNT_CHOICES = (1, 2)
+GEN_ATTEMPTS = 500
