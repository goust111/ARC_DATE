+def _neighbors4(r: int, c: int, height: int, width: int) -> list[tuple[int, int]]:
+    out = []
+    for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+        nr, nc = r + dr, c + dc
+        if 0 <= nr < height and 0 <= nc < width:
+            out.append((nr, nc))
+    return out
