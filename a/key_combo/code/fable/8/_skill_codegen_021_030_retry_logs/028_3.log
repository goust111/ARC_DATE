+
+def _side_from_gap(local_r: int, local_c: int, height: int, width: int) -> str | None:
+    on_top = local_r == 0
+    on_bottom = local_r == height - 1
+    on_left = local_c == 0
+    on_right = local_c == width - 1
+    if (on_top or on_bottom) and (on_left or on_right):
+        return None
+    if on_top:
+        return "top"
+    if on_bottom:
+        return "bottom"
+    if on_left:
+        return "left"
+    if on_right:
