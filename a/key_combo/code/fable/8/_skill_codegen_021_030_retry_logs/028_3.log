+def _border_mask(height: int, width: int) -> np.ndarray:
+    border = np.zeros((height, width), dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+    return border
+
+
+def _side_from_gap(local_r: int, local_c: int, height: int, width: int) -> str | None:
+    on_top = local_r == 0
+    on_bottom = local_r == height - 1
+    on_left = local_c == 0
+    on_right = local_c == width - 1
+    if (on_top or on_bottom) and (on_left or on_right):
+        return None
+    if on_top:
+        return "top"
+    if on_bottom:
+        return "bottom"
+    if on_left:
+        return "left"
+    if on_right:
+        return "right"
+    return None
+
+
+def _parse_frame_component(grid: np.ndarray, obj: dict, bg: int) -> ParsedFrame | None:
+    color = int(obj["color"])
+    bbox = tuple(map(int, obj["bbox"]))
+    r0, c0, r1, c1 = bbox
+    height = r1 - r0 + 1
+    width = c1 - c0 + 1
+    if height < 3 or width < 3:
+        return None
