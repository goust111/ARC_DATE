+def _extract_frames(grid: np.ndarray) -> tuple[int, int, list[ParsedFrame]]:
+    bg = int(get_bg(grid))
+    colors = sorted(set(map(int, grid.ravel())) - {bg})
+    candidates: list[tuple[int, list[ParsedFrame]]] = []
+
