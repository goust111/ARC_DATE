+                side="bottom",
+                gap_local=gap_local,
+                interior_color=next(color_iter),
+                interior_mask=_random_mask(frame_h - 2, frame_w - 2),
+            )
+        )
+
+    for col in bottom_cols:
+        gap_local = (random.randint(1, frame_h - 2), 0)
+        specs.append(
+            FrameSpec(
+                bbox=(bottom_row, col, bottom_row + frame_h - 1, col + frame_w - 1),
+                side="left",
+                gap_local=gap_local,
+                interior_color=next(color_iter),
