+
+def _place_passive_rect(
+    shape: tuple[int, int],
+    occupied: np.ndarray,
+    active_rows: set[int],
+    active_cols: set[int],
+) -> RectSpec | None:
+    h, w = shape
+    for _ in range(160):
+        height = random.randint(4, 7)
+        width = random.randint(4, 7)
+        r0 = random.randint(1, h - height - 1)
+        c0 = random.randint(1, w - width - 1)
+        rect = RectSpec(r0, c0, r0 + height - 1, c0 + width - 1, ())
