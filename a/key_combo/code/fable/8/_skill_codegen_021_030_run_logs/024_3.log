+def _parse_rectangles(grid: np.ndarray) -> list[RectSpec]:
+    h, w = grid.shape
+    rects = []
+    seen = set()
+    for r0 in range(1, h - 3):
+        for r1 in range(r0 + 3, h - 1):
+            for c0 in range(1, w - 3):
+                for c1 in range(c0 + 3, w - 1):
