+                r, c = exit_gap
+                continue
+        if (nr, nc) in wall_cells:
+            return hits, "wall"
+        r, c = nr, nc
+
+
+def _expected_output(shape: tuple[int, int], rects: list[RectSpec], seeds: list[SeedSpec]) -> tuple[np.ndarray, dict]:
+    grid = _render_scene(shape, rects, seeds)
+    out = grid.copy()
