            visible = []
            for rr, cc in _symmetry_coords(r, c, h):
                color = int(g[rr, cc])
                if color != 3:
                    visible.append(color)
            assert visible
            unique = set(visible)
            assert len(unique) == 1
            out[r - r0, c - c0] = unique.pop()

    return out

