+
+
+def _trace_seed_on_specs(
+    shape: tuple[int, int],
+    rects: list[RectSpec],
+    seed: SeedSpec,
+) -> tuple[list[int], str]:
+    wall_cells = set()
+    gap_lookup: dict[tuple[int, int], int] = {}
+    for idx, rect in enumerate(rects):
+        wall_cells |= _rect_border_cells(rect) - set(rect.gaps)
+        for gap in rect.gaps:
