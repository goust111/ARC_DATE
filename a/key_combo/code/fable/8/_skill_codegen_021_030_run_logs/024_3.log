+            decoy = _find_blocked_decoy_seed(shape, rects, used_boundary, color)
+            if decoy is None:
+                break
+            seeds.append(decoy)
+            used_boundary.add((decoy.r, decoy.c))
+
+        expected, meta = _expected_output(shape, rects, seeds)
+        if meta["hit_rect_count"] < 1:
