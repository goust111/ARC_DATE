+        nc = c + direction[1]
+        if not _in_bounds(shape, nr, nc):
+            return hits, "edge"
+        rect_idx = gap_lookup.get((nr, nc))
+        if rect_idx is not None:
+            entered, exit_gap = _entry_result(rects[rect_idx], (nr, nc), direction)
+            if entered:
+                hits.append(rect_idx)
+                if exit_gap is None:
+                    return hits, "inner_wall"
+                r, c = exit_gap
+                continue
