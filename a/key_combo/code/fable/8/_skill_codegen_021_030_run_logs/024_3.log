+def _gap_side(rect: RectSpec, gap: tuple[int, int]) -> str:
+    r, c = gap
+    if r == rect.r0 and rect.c0 < c < rect.c1:
+        return "T"
+    if r == rect.r1 and rect.c0 < c < rect.c1:
+        return "B"
+    if c == rect.c0 and rect.r0 < r < rect.r1:
