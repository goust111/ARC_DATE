def _random_side_cell(rect: RectSpec, side: str) -> tuple[int, int]:
    if side == "L":
        return random.randint(rect.r0 + 1, rect.r1 - 1), rect.c0
    if side == "R":
        return random.randint(rect.r0 + 1, rect.r1 - 1), rect.c1
    if side == "T":
        return rect.r0, random.randint(rect.c0 + 1, rect.c1 - 1)
    return rect.r1, random.randint(rect.c0 + 1, rect.c1 - 1)


def _isolates_corner(rect: RectSpec, side_a: str, gap_a: tuple[int, int], side_b: str, gap_b: tuple[int, int]) -> bool:
    pairs = {side_a, side_b}
    if pairs == {"L", "T"}:
        return gap_a[0] == rect.r0 + 1 or gap_b[0] == rect.r0 + 1 if False else (
            (side_a == "L" and gap_a[0] == rect.r0 + 1 and side_b == "T" and gap_b[1] == rect.c0 + 1)
            or (side_b == "L" and gap_b[0] == rect.r0 + 1 and side_a == "T" and gap_a[1] == rect.c0 + 1)
        )
    if pairs == {"L", "B"}:
        return (
            (side_a == "L" and gap_a[0] == rect.r1 - 1 and side_b == "B" and gap_b[1] == rect.c0 + 1)
            or (side_b == "L" and gap_b[0] == rect.r1 - 1 and side_a == "B" and gap_a[1] == rect.c0 + 1)
        )
    if pairs == {"R", "T"}:
        return (
            (side_a == "R" and gap_a[0] == rect.r0 + 1 and side_b == "T" and gap_b[1] == rect.c1 - 1)
            or (side_b == "R" and gap_b[0] == rect.r0 + 1 and side_a == "T" and gap_a[1] == rect.c1 - 1)
        )
    if pairs == {"R", "B"}:
        return (
            (side_a == "R" and gap_a[0] == rect.r1 - 1 and side_b == "B" and gap_b[1] == rect.c1 - 1)
            or (side_b == "R" and gap_b[0] == rect.r1 - 1 and side_a == "B" and gap_a[1] == rect.c1 - 1)
        )
    return False


