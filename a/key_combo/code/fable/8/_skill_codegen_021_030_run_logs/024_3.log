+        r1 = r0 + height - 1
+        if side == "L":
+            c0 = cursor
+            c1 = c0 + width - 1
+        else:
+            c1 = cursor
+            c0 = c1 - width + 1
+        if not (1 <= r0 < r1 <= h - 2 and 1 <= c0 < c1 <= w - 2):
+            return None
+        gaps = ((lane, c0), (lane, c1))
+        return RectSpec(r0, c0, r1, c1, gaps)
+
+    offset = random.randint(1, width - 2)
+    c0 = lane - offset
+    c1 = c0 + width - 1
+    if side == "T":
+        r0 = cursor
+        r1 = r0 + height - 1
+    else:
+        r1 = cursor
+        r0 = r1 - height + 1
+    if not (1 <= r0 < r1 <= h - 2 and 1 <= c0 < c1 <= w - 2):
+        return None
+    gaps = ((r0, lane), (r1, lane))
+    return RectSpec(r0, c0, r1, c1, gaps)
+
+
+def _place_chain(
+    shape: tuple[int, int],
+    occupied: np.ndarray,
+    used_rows: set[int],
+    used_cols: set[int],
+    orientation: str,
+    side: str,
+    length: int,
+) -> tuple[list[RectSpec], tuple[int, int]] | None:
+    h, w = shape
+    for _ in range(120):
+        if orientation == "H":
+            candidates = [r for r in range(2, h - 2) if r not in used_rows]
+            if not candidates:
+                return None
+            lane = random.choice(candidates)
+            cursor = random.randint(3, 6) if side == "L" else random.randint(w - 7, w - 4)
+        else:
