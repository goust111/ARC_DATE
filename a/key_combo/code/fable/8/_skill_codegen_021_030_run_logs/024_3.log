+DIR_BY_SIDE = {"L": (0, 1), "R": (0, -1), "T": (1, 0), "B": (-1, 0)}
+OPPOSITE_SIDE = {"L": "R", "R": "L", "T": "B", "B": "T"}
+TURN_PAIRS = (("L", "T"), ("L", "B"), ("R", "T"), ("R", "B"))
