+) -> tuple[RectSpec, SeedSpec] | None:
+    h, w = shape
+    entry_to_exits = {"L": ["T", "B"], "R": ["T", "B"], "T": ["L", "R"], "B": ["L", "R"]}
+    for _ in range(240):
+        height = random.randint(4, 7)
+        width = random.randint(4, 7)
+        r0 = random.randint(1, h - height - 1)
