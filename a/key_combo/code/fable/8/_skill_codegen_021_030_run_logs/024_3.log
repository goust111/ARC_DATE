+def _rect_border_cells(rect: RectSpec) -> set[tuple[int, int]]:
+    cells = set()
+    for c in range(rect.c0, rect.c1 + 1):
+        cells.add((rect.r0, c))
+        cells.add((rect.r1, c))
+    for r in range(rect.r0, rect.r1 + 1):
+        cells.add((r, rect.c0))
+        cells.add((r, rect.c1))
+    return cells
