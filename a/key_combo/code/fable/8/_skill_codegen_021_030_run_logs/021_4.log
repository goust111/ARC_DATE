+
+    @property
+    def width(self) -> int:
+        return len(self.body_mask[0])
+
+    @property
+    def final_r0(self) -> int:
+        dr, _dc = DIRS[self.direction]
+        return self.input_r0 + dr * self.shift
+
+    @property
+    def final_c0(self) -> int:
+        _dr, dc = DIRS[self.direction]
+        return self.input_c0 + dc * self.shift
