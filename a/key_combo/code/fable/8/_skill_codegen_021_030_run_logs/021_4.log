+            if corridor_clear & blocked_now:
+                continue
+            if corridor_clear & occupied_input:
+                continue
+            if corridor_clear & reserved_input_space:
+                continue
+            if out_bbox & reserved_output_space:
+                continue
+            if out_bbox & existing_pegs:
