+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+
+
+@dataclass(frozen=True)
+class PlacedSprite:
+    color: int
+    peg_color: int
+    direction: str
+    input_r0: int
+    input_c0: int
+    shift: int
+    anchor: tuple[int, int]
