+    if r == 0:
+        on.append("up")
+    if r == h - 1:
+        on.append("down")
+    if c == 0:
+        on.append("left")
+    if c == w - 1:
+        on.append("right")
+    if len(on) != 1:
+        return None
+    return on[0]
