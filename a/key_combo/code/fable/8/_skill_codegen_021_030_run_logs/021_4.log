    # shelf segments (from original grid g)
    shelf_segs: list[list[tuple[int, int]]] = [[] for _ in range(H)]
    for r in range(H):
        c = 0
        while c < W:
            if int(g[int(r), int(c)]) != int(shelf):
                c += 1
