+            anchors = _candidate_anchors(
+                shape,
+                direction,
+                blocked_now | reserved_input_space,
+                reserved_clear | corridor_clear,
+            )
+            if not anchors:
+                continue
+            anchor = random.choice(anchors)
+            guard = _anchor_guard(anchor, shape)
