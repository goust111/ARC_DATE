GEN_AXIS_DIM_MIN, GEN_BAR_LENGTH_MAX = 1, 8
GEN_CROSS_DIM_MIN, GEN_CROSS_DIM_MIN_WHEN_AXIS_ONE, GEN_CROSS_DIM_MAX = 1, 2, 6
GEN_MOTIF_COLOR_MIN, GEN_MOTIF_COLOR_MAX = 2, 3

