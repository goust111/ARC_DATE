from importlib.machinery import SourceFileLoader
from pathlib import Path
import hashlib
import numpy as np

p = Path('/home/lixinyu/snap/a/key_combo/code/fable/8/023/4.py')
mod = SourceFileLoader('new_arc_task', str(p)).load_module()

Color = mod.Color


def parse_regions(grid):
    regions = mod._sorted_regions(grid)
    return regions


def parse_period(grid):
    k, _ = mod._parse_ruler(grid)
    return k


def parse_marker_region(grid):
    marker = tuple(map(int, np.argwhere(grid == Color.YELLOW)[0]))
    return mod._region_index_for_point(parse_regions(grid), marker)


sigs = set()
periods = set()
marker_regions = set()
region_counts = set()
changed_marker_cases = 0
changed_period_cases = 0

for i in range(100):
    inp = mod.generate_input()
    out = mod.main(inp)
    assert isinstance(inp, np.ndarray)
    assert isinstance(out, np.ndarray)
    assert inp.ndim == 2 and max(inp.shape) <= 30, f'input grid exceeds 30x30: {inp.shape}'
    assert out.ndim == 2 and max(out.shape) <= 30, f'output grid exceeds 30x30: {out.shape}'

    regions = parse_regions(inp)
    k = parse_period(inp)
    s = parse_marker_region(inp)
    region_counts.add(len(regions))
    periods.add(k)
    marker_regions.add(s)
    members = [idx for idx in range(len(regions)) if idx % k == s % k]
    assert 2 <= len(members) <= len(regions) - 2

    expected = mod._apply_period_fill(inp, s, k)
    assert np.array_equal(out, expected), 'main output disagrees with independent semantic params'

    selected = set(members)
    for idx, region in enumerate(regions):
        coords = region['coords']
        black_before = inp[coords[:, 0], coords[:, 1]] == Color.BLACK
        yellow_after = out[coords[:, 0], coords[:, 1]] == Color.YELLOW
        if idx in selected:
            assert np.array_equal(yellow_after, black_before | (inp[coords[:, 0], coords[:, 1]] == Color.YELLOW))
        else:
            assert not np.any(yellow_after & black_before)

    sigs.add(hashlib.md5(inp.tobytes() + str(inp.shape).encode()).hexdigest())

    other_regions = [idx for idx in range(len(regions)) if idx "'!= s]
    if other_regions:
        alt_s = other_regions[0]
        alt_out = mod._apply_period_fill(inp, alt_s, k)
        if not np.array_equal(alt_out, out):
            changed_marker_cases += 1

    alt_periods = [kk for kk in range(2, min(5, len(regions) - 1) + 1) if kk != k]
    for alt_k in alt_periods:
        if any((idx % alt_k == s % alt_k) != (idx % k == s % k) for idx in range(len(regions))):
            alt_out = mod._apply_period_fill(inp, s, alt_k)
            if not np.array_equal(alt_out, out):
                changed_period_cases += 1
                break

print('"'variants', len(sigs))
print('periods', sorted(periods))
print('marker_regions', sorted(marker_regions))
print('region_counts', sorted(region_counts))
print('changed_marker_cases', changed_marker_cases)
print('changed_period_cases', changed_period_cases)
assert len(sigs) >= 20
assert changed_marker_cases >= 80
assert changed_period_cases >= 80
