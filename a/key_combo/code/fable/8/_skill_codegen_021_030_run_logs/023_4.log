    out = mod.main(inp)
    assert isinstance(inp, np.ndarray)
    assert isinstance(out, np.ndarray)
    assert inp.ndim == 2 and max(inp.shape) <= 30, f'input grid exceeds 30x30: {inp.shape}'
    assert out.ndim == 2 and max(out.shape) <= 30, f'output grid exceeds 30x30: {out.shape}'

    regions = mod._sorted_regions(inp)
    k, _ = mod._parse_ruler(inp)
    marker = tuple(map(int, np.argwhere(inp == Color.YELLOW)[0]))
    s = mod._region_index_for_point(regions, marker)

    sigs.add(hashlib.md5(inp.tobytes() + str(inp.shape).encode()).hexdigest())
    periods.add(k)
    marker_regions.add(s)
    region_counts.add(len(regions))

    selected = {idx for idx in range(len(regions)) if idx % k == s % k}
    assert 2 <= len(selected) <= len(regions) - 2

    expected = mod._apply_period_fill(inp, s, k)
    assert np.array_equal(out, expected)

    for idx, region in enumerate(regions):
        coords = region['coords']
        before = inp[coords[:, 0], coords[:, 1]]
        after = out[coords[:, 0], coords[:, 1]]
        black_before = before == Color.BLACK
        yellow_before = before == Color.YELLOW
        if idx in selected:
            assert np.all(after[black_before] == Color.YELLOW)
            assert np.all(after[yellow_before] == Color.YELLOW)
        else:
            assert np.array_equal(after[black_before], before[black_before])

    alt_s_choices = [idx for idx in range(len(regions)) if idx % k "'!= s % k]
    assert alt_s_choices
    alt_s = alt_s_choices[0]
    alt_marker_out = mod._apply_period_fill(inp, alt_s, k)
    if not np.array_equal(alt_marker_out, out):
        changed_marker_cases += 1

    alt_periods = [kk for kk in range(2, min(5, len(regions) - 1) + 1) if kk != k]
    assert alt_periods
    found_period_change = False
    for alt_k in alt_periods:
        alt_period_out = mod._apply_period_fill(inp, s, alt_k)
        if not np.array_equal(alt_period_out, out):
            changed_period_cases += 1
            found_period_change = True
            break
    assert found_period_change

print('"'variants', len(sigs))
print('periods', sorted(periods))
print('marker_regions', sorted(marker_regions))
print('region_counts', sorted(region_counts))
print('changed_marker_cases', changed_marker_cases)
print('changed_period_cases', changed_period_cases)
assert len(sigs) >= 20
assert changed_marker_cases == 100
assert changed_period_cases == 100
