+            anchor_offset[0] + ar0,
+            anchor_offset[1] + ac0,
+            anchor_offset[0] + ar1,
+            anchor_offset[1] + ac1,
+        )
+        if anchor_a is not None:
+            anchor_panel = panel_a
+        anchor_panel_bbox = (
+            anchor_offset[0],
+            anchor_offset[1],
+            anchor_offset[0] + anchor_panel.shape[0] - 1,
