+
+
+def _choose_case_dimensions(orientation: str) -> tuple[int, int, int, int]:
+    if orientation == "v":
+        height = random.choice(range(8, 23, 2))
+        data_w = random.choice(range(6, 15, 2))
+        max_anchor_w = min(14, 30 - data_w - 1)
