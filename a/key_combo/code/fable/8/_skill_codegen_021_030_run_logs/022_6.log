+    anchor_bbox_local = anchor_meta["anchor_bbox_local"]
+    anchor_bbox = (
+        anchor_offset[0] + anchor_bbox_local[0],
+        anchor_offset[1] + anchor_bbox_local[1],
+        anchor_offset[0] + anchor_bbox_local[2],
+        anchor_offset[1] + anchor_bbox_local[3],
