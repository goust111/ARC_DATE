+    for orientation, start, end, divider_color in _stripe_candidates(g, bg):
+        if orientation == "v":
+            panel_a = g[:, :start]
+            panel_b = g[:, end + 1 :]
+            offset_a = (0, 0)
+            offset_b = (0, end + 1)
+        else:
+            panel_a = g[:start, :]
+            panel_b = g[end + 1 :, :]
