+        (r0, c0),
+        (r0, c1),
+        (r1, c0),
+        (r1, c1),
+    )
+
+    legend = np.zeros((2, 2), dtype=int)
+    hits: dict[tuple[int, int], tuple[int, int]] = {}
+    ray_cells: set[tuple[int, int]] = set()
+
+    for (qr, qc), (dr, dc) in RAY_SPECS:
+        sr, sc = starts[qr * 2 + qc]
+        r = sr + dr
+        c = sc + dc
