+        data_w = random.choice(range(6, 15, 2))
+        max_anchor_w = min(14, 30 - data_w - 1)
+        anchor_w = random.randint(7, max_anchor_w)
+        max_divider_t = min(3, 30 - data_w - anchor_w)
+        divider_t = random.randint(1, max_divider_t)
