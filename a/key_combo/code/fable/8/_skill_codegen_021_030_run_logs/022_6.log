    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "expected a 2D grid"

    bg = get_bg(g)
    foreground_colors = set(map(int, np.unique(g))) - {bg}
    assert len(foreground_colors) == 1, "expected one lattice color"

