+from arc_utils import Color, bbox_coords, components_mask, crop_bbox, get_bg
+
+
+BG_COLOR = Color.BLACK
+ANCHOR_COLOR = Color.GREY
+ALL_PALETTE = [1, 2, 3, 4, 5, 6, 7, 8, 9]
+GEN_RETRIES = 400
+
+RAY_SPECS = (
+    ((0, 0), (-1, -1)),
+    ((0, 1), (-1, 1)),
+    ((1, 0), (1, -1)),
+    ((1, 1), (1, 1)),
+)
