+        color = int(grid[r, 0])
+        if color == bg or not np.all(grid[r, :] == color):
+            r += 1
+            continue
+        start = r
+        while r + 1 < h and int(grid[r + 1, 0]) == color and np.all(grid[r + 1, :] == color):
+            r += 1
+        candidates.append(("h", start, r, color))
+        r += 1
+
+    return candidates
+
+
