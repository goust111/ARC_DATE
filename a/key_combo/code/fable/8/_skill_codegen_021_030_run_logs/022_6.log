+        if int(coords.shape[0]) != 4:
+            continue
+        r0, c0, r1, c1 = bbox_coords(coords)
+        if (r1 - r0 + 1, c1 - c0 + 1) == (2, 2):
+            anchor_boxes.append((r0, c0, r1, c1))
+    if len(anchor_boxes) != 1:
+        return None
+    return anchor_boxes[0]
