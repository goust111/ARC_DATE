+                "data_bbox": data_bbox,
+                "data_panel": crop_bbox(g, data_bbox),
+                "data_color": data_colors[0],
+                "legend": legend,
+                "ray_hits": ray_hits,
+                "ray_cells": ray_cells,
+            }
