+        data_colors = _non_bg_colors(data_panel, bg)
+        if len(data_colors) != 1 or data_colors[0] == ANCHOR_COLOR:
+            continue
+        if data_panel.shape[0] % 2 or data_panel.shape[1] % 2:
+            continue
