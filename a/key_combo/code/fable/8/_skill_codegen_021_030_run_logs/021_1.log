+    if row_max - row_min + 1 < box_h or col_max - col_min + 1 < box_w:
+        return None
+    for _ in range(tries):
+        r0 = random.randint(row_min, row_max - box_h + 1)
+        c0 = random.randint(col_min, col_max - box_w + 1)
+        rr0 = max(0, r0 - 1)
+        cc0 = max(0, c0 - 1)
