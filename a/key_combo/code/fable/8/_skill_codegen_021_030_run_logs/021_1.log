0115:     while True:
0116:         state = (r, c, dr, dc)
0117:         assert state not in seen, "ray path must not loop"
0118:         seen.add(state)
0119: 
0120:         nr, nc = r + dr, c + dc
0121:         if not in_bounds(g.shape, nr, nc):
0122:             break
0123: 
0124:         if int(g[nr, nc]) == Color.RED:
0125:             orientation = mirrors.get((nr, nc))
0126:             assert orientation is not None, "red cell must belong to a mirror segment"
0127:             if orientation == "horizontal":
0128:                 dr = -dr
0129:             else:
0130:                 assert orientation == "vertical"
0131:                 dc = -dc
0132:             continue
0133: 
0134:         out[nr, nc] = ray_color
0135:         r, c = nr, nc
0136: 
