+    out = np.array(base, copy=True)
+    h, w = out.shape
+    q = deque((int(r), int(c)) for r, c in source_starts)
+    seen: set[tuple[int, int]] = set()
+    stats = {
+        "drops": 0,
+        "impacts": 0,
+        "hole_branches": 0,
+        "overflow_branches": 0,
+        "spread_cells": 0,
+    }
