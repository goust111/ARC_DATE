+        through_cols = [
+            int(c)
+            for c in range(int(shelf["c0"]), int(shelf["c1"]) + 1)
+            if bool((base[int(shelf["r0"]) : int(shelf["r1"]) + 1, int(c)] == int(bg)).all())
