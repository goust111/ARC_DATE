+            "r0": int(current_top),
+            "c0": int(c0),
+            "r1": int(current_top + shelf_h - 1),
+            "c1": int(c0 + shelf_w - 1),
+            "h": int(shelf_h),
+            "w": int(shelf_w),
+        }
+        shelves.append(shelf)
+        gap = random.randint(3, 5)
+        current_top = int(shelf["r1"] + gap + 1)
+
+    if shelves[-1]["r1"] >= h - 2:
+        return None
+    return shelves
+
+
+def _attach_motifs(shelves: list[dict]) -> bool:
+    for idx, shelf in enumerate(shelves):
+        shelf_h = int(shelf["h"])
