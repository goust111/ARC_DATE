+def _mask_from_coords(coords: np.ndarray, shape: tuple[int, int]) -> np.ndarray:
+    mask = np.zeros(shape, dtype=bool)
+    if coords.size == 0:
+        return mask
+    mask[coords[:, 0], coords[:, 1]] = True
+    return mask
