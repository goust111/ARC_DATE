+    """All shelf segments causing a unique left/right roll within one lane."""
+    choices: list[tuple[int, int, int]] = []
+    c = int(local_col)
+    w = int(lane_width)
+    if int(direction) < 0:
+        for near in range(1, c + 1):
+            overflow = c - near - 1
+            if overflow < 0:
+                continue
+            for far in range(near + 1, w - c):
+                c0 = c - near
+                c1 = c + far
+                length = c1 - c0 + 1
+                if 3 <= length <= 5:
+                    choices.append((int(c0), int(c1), int(overflow)))
+    else:
