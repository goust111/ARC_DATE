/bin/bash -lc "python - <<'PY'
from importlib.machinery import SourceFileLoader
from pathlib import Path
import hashlib
import numpy as np

p = Path('/home/lixinyu/snap/a/key_combo/code/fable/8/021/5.py')
mod = SourceFileLoader('new_arc_task', str(p)).load_module()

sigs = set()
out_sigs = set()
branches_seen = set()
current_color_diff = 0
far_roll_diff = 0

for i in range(100):
    inp = mod.generate_input()
    out = mod.main(inp)
    assert isinstance(inp, np.ndarray)
    assert isinstance(out, np.ndarray)
    assert inp.ndim == 2 and max(inp.shape) <= 30, f'input grid exceeds 30x30: {inp.shape}'
    assert out.ndim == 2 and max(out.shape) <= 30, f'output grid exceeds 30x30: {out.shape}'
    sigs.add(hashlib.md5(inp.tobytes() + str(inp.shape).encode()).hexdigest())
    out_sigs.add(hashlib.md5(out.tobytes() + str(out.shape).encode()).hexdigest())

    inp2, meta = mod._generate_case(return_meta=True)
    assert np.array_equal(inp2, inp2.astype(int))
    exp = meta['expected']
    got = mod.main(inp2)
    assert np.array_equal(got, exp), 'oracle mismatch against recorded semantics'
    for lane in meta['lanes']:
        branches_seen.add(lane['branch'])

    bg = mod._get_bg(inp2)
    shelves = mod._extract_shelves(inp2, bg)
    wrong_initial = np.full_like(inp2, bg)
    wrong_far = np.full_like(inp2, bg)
    for c in range(inp2.shape[1]):
        if int(inp2[0, c]) == int(bg):
            continue
        r1, c1, col1 = mod._simulate_stone(shelves, inp2.shape, c, int(inp2[0, c]), match_mode='initial', roll_mode='near')
        wrong_initial[r1, c1] = col1
        r2, c2, col2 = mod._simulate_stone(shelves, inp2.shape, c, int(inp2[0, c]), match_mode='current', roll_mode='far')
        wrong_far[r2, c2] = col2
    if not np.array_equal(wrong_initial, got):
        current_color_diff += 1
    if not np.array_equal(wrong_far, got):
        far_roll_diff += 1

assert len(sigs) >= 20, len(sigs)
assert len(out_sigs) >= 20, len(out_sigs)
assert branches_seen == {'immediate', 'cascade', 'bottom'}, branches_seen
assert current_color_diff >= 20, current_color_diff
assert far_roll_diff >= 20, far_roll_diff
print('variants', len(sigs), 'outputs', len(out_sigs), 'current_color_diff', current_color_diff, 'far_roll_diff', far_roll_diff)
