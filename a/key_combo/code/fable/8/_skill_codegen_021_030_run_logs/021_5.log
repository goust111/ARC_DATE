+
+
+def _event_rows(height: int, count: int) -> list[int] | None:
+    """Sample strictly increasing shelf rows with clear vertical gaps."""
+    rows: list[int] = []
+    row = random.randint(2, 5)
+    for idx in range(int(count)):
+        rows.append(int(row))
+        if idx != int(count) - 1:
+            row += random.randint(2, 4)
