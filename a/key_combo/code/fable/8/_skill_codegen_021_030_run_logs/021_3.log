    expected, layers, bbox = oracle(inp)
    out = mod.main(inp)
    assert np.array_equal(out, expected), f'"'mismatch on case {i}'
    assert max(inp.shape) <= 30 and max(out.shape) <= 30
    assert any(t > 1 for _d, t, _color, _pts in layers)
    count_gt1_cases += 1
    if any(len({dist_to_bbox(r, c, bbox) for r, c in pts}) > 1 for _d, _t, _color, pts in layers if len(pts) > 1):
        mixed_distance_cases += 1

print('checked', 200)
print('count_gt1_cases', count_gt1_cases)
print('mixed_distance_cases', mixed_distance_cases)
assert mixed_distance_cases >= 80
