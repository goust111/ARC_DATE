def bg_color(grid):
    vals, counts = np.unique(grid, return_counts=True)
    return int(vals[np.argmax(counts)])


def frame_mask(h, w):
    m = np.zeros((h, w), dtype=bool)
    m[0, :] = True
    m[-1, :] = True
    m[:, 0] = True
    m[:, -1] = True
    return m


def find_frame_independent(grid):
    h, w = grid.shape
    bg = bg_color(grid)
    candidates = []
    colors = [int(v) for v in np.unique(grid) if int(v) "'!= bg]
    for color in colors:
        pts = np.argwhere(grid == color)
        if pts.size == 0:
            continue
        rows = sorted(set(int(r) for r, _ in pts))
        cols = sorted(set(int(c) for _, c in pts))
        # Try every bbox implied by same-color points; only the true frame is a perfect border.
        r0, r1 = rows[0], rows[-1]
        c0, c1 = cols[0], cols[-1]
        if r1 - r0 + 1 < 3 or c1 - c0 + 1 < 3:
            continue
        patch = grid[r0:r1+1, c0:c1+1]
        mask = patch == color
        border = frame_mask(r1-r0+1, c1-c0+1)
        if np.array_equal(mask, border):
            candidates.append((color, (r0, c0, r1, c1)))
    assert len(candidates) == 1, candidates
    color, bbox = candidates[0]
    return color, bbox


def dist_to_bbox(r, c, bbox):
    r0, c0, r1, c1 = bbox
    return max(max(r0-r, 0, r-r1), max(c0-c, 0, c-c1))


def oracle(grid):
    grid = np.asarray(grid, dtype=int)
    bg = bg_color(grid)
    frame_color, bbox = find_frame_independent(grid)
    r0, c0, r1, c1 = bbox

    frame_cells = {(rr, cc) for rr in range(r0, r1 + 1) for cc in range(c0, c1 + 1) if rr in (r0, r1) or cc in (c0, c1)}
    by_color = {}
    for rr, cc in np.argwhere(grid != bg):
        rr = int(rr)
        cc = int(cc)
        if (rr, cc) in frame_cells:
            continue
        by_color.setdefault(int(grid[rr, cc]), []).append((rr, cc))

    layers = []
    for color, pts in by_color.items():
        ds = [dist_to_bbox(rr, cc, bbox) for rr, cc in pts]
        assert all(not (r0 < rr < r1 and c0 < cc < c1) for rr, cc in pts)
        layers.append((min(ds), len(pts), color, pts))
    mins = [d for d, *_ in layers]
    assert len(mins) == len(set(mins))
    layers.sort()

    out = np.full_like(grid, bg)
    out[r0:r1+1, c0:c1+1][frame_mask(r1-r0+1, c1-c0+1)] = frame_color
    ir0, ic0, ir1, ic1 = r0 + 1, c0 + 1, r1 - 1, c1 - 1
    for _d, t, color, _pts in layers:
        out[ir0:ir0+t, ic0:ic1+1] = color
        out[ir1-t+1:ir1+1, ic0:ic1+1] = color
        out[ir0+t:ir1-t+1, ic0:ic0+t] = color
        out[ir0+t:ir1-t+1, ic1-t+1:ic1+1] = color
        ir0 += t
        ic0 += t
        ir1 -= t
        ic1 -= t
    return out, layers, bbox


mixed_distance_cases = 0
count_gt1_cases = 0
for i in range(200):
