+def _render_output(shape: tuple[int, int], frame: dict, layers: list[dict]) -> np.ndarray:
+    out = np.full(shape, BACKGROUND, dtype=int)
+    r0, c0, r1, c1 = map(int, frame["bbox"])
+    border = _frame_mask(r1 - r0 + 1, c1 - c0 + 1)
