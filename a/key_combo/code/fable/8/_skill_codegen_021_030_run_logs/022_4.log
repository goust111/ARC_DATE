+    if not np.array_equal(actual, oracle):
+        return None
+    if max(inp.shape) > MAX_SIDE or max(actual.shape) > MAX_SIDE:
+        return None
+    if len({tuple(sig) for sig in signatures}) != count:
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
