+def _candidate_separators(grid: np.ndarray, bg: int) -> list[int]:
+    candidates: list[int] = []
+    height, width = map(int, grid.shape)
+    for r in range(height):
+        value = int(grid[r, 0])
+        if value != bg and np.all(grid[r, :] == value):
+            candidates.append(value)
+    for c in range(width):
+        value = int(grid[0, c])
