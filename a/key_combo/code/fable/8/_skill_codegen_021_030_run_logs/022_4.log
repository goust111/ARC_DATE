+            if len(cell_colors) != 1:
+                return None
+            color = int(cell_colors[0])
+            if color == sep:
+                return None
+            mask = cell == color
+            if not np.any(mask) or not np.any(cell == bg):
+                return None
+
+            left_sig = tuple(bool(v) for v in mask[:, 0])
+            right_sig = tuple(bool(v) for v in mask[:, -1])
+            if not (any(left_sig) and any(right_sig)):
+                return None
