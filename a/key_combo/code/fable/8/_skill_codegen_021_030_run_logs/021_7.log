+def _build_case() -> tuple[np.ndarray, np.ndarray, dict]:
+    sides = random.choice(SIDE_PAIRS)
+    colors = random.sample(SOURCE_COLORS, len(sides))
+    local_cases = {}
+    rotated = {}
