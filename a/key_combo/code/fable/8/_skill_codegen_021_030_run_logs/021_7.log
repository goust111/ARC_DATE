+    leaf_cols = [int(layout["left_col"]), int(layout["right_col"])]
+    for leaf_col in leaf_cols:
+        out[split_row, leaf_col] = int(source_color)
+        for r in range(split_row + 1, h):
+            out[r, leaf_col] = int(source_color)
