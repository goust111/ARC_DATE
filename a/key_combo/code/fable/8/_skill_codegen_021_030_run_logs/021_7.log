+                inp,
+                out,
+                source_color=int(source_color),
+                corridor_col=int(plan["corridor_col"]),
+                room_cols=tuple(plan["room_cols"]),
+                doorway_col=int(plan["doorway_col"]),
+                top_row=int(room_top),
