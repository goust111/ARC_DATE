+def _fill_labeled_cavities(traced: np.ndarray, bg: int, wall: int) -> np.ndarray:
+    out = traced.copy()
+    h, w = traced.shape
+    for comp in components_mask(traced == int(bg), connectivity=4):
+        if comp.size == 0:
