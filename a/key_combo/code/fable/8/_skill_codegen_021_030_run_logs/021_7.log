+                if not in_bounds(traced.shape, nr, nc):
+                    continue
+                value = int(traced[nr, nc])
+                if value not in (int(bg), int(wall)):
+                    adjacent_colors.add(value)
+
+        if len(adjacent_colors) == 1:
+            color = next(iter(adjacent_colors))
+            out[comp[:, 0], comp[:, 1]] = int(color)
+
+    return out
