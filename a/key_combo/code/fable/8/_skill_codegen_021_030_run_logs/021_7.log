+    seen: set[tuple[int, int, int, int, int]] = set()
+    while stack:
+        r, c, dr, dc, color = stack.pop()
+        state = (int(r), int(c), int(dr), int(dc), int(color))
+        if state in seen:
+            continue
+        seen.add(state)
+
+        cur_r = int(r)
+        cur_c = int(c)
+        while True:
+            nr = cur_r + dr
+            nc = cur_c + dc
+            if not in_bounds(g.shape, nr, nc):
