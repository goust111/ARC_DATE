+    h, w = inp.shape
+    wall = _wall_color(inp, BG)
+    source_cells = []
+    for r in range(h):
+        for c in range(w):
+            if r not in (0, h - 1) and c not in (0, w - 1):
+                continue
+            value = int(inp[r, c])
+            if value not in (BG, wall):
+                source_cells.append((int(r), int(c), value))
