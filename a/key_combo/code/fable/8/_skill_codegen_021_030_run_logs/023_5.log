+        for r in range(1, grid.shape[0])
+        if int(grid[r, 0]) != BG
+    }
+    col_emitters = {
+        int(c): int(grid[0, c])
+        for c in range(1, grid.shape[1])
+        if int(grid[0, c]) != BG
+    }
+    return row_emitters, col_emitters
+
+
+def _analyze_grid(grid: np.ndarray) -> dict[str, object]:
+    g = np.asarray(grid, dtype=int)
