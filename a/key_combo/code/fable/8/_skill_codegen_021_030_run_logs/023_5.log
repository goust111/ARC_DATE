+    if not np.array_equal(expected, out):
+        return False
+    if not _scene_is_rich(inp):
+        return False
+
+    row_gate_pos = _find_critical_gate(info, "row")
+    col_gate_pos = _find_critical_gate(info, "col")
+    if row_gate_pos is None or col_gate_pos is None:
+        return False
+
+    mutated = inp.copy()
+    mutated[row_gate_pos] = BG
+    if np.array_equal(main(mutated), out):
+        return False
+
+    mutated = inp.copy()
+    mutated[col_gate_pos] = BG
+    if np.array_equal(main(mutated), out):
