+def _scene_is_rich(grid: np.ndarray) -> bool:
+    info = _analyze_grid(grid)
+    row_open = info["row_open"]
+    col_open = info["col_open"]
+    row_gate = info["row_gate"]
+    col_gate = info["col_gate"]
