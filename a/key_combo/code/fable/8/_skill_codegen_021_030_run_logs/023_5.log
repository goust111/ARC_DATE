+def _find_critical_gate(info: dict[str, object], prefer: str) -> tuple[int, int] | None:
+    if prefer == "row":
+        gate_mask = info["row_gate"]
+        open_mask = info["row_open"] | info["col_open"]
+    else:
+        gate_mask = info["col_gate"]
+        open_mask = info["row_open"] | info["col_open"]
+    coords = np.argwhere(gate_mask)
+    random.shuffle(coords.tolist())
+    for r, c in coords:
+        if open_mask[r].any() if prefer == "row" else open_mask[:, c].any():
+            return int(r), int(c)
+    if coords.size == 0:
+        return None
+    r, c = coords[0]
+    return int(r), int(c)
+
+
+def _find_active_emitter(info: dict[str, object], prefer: str) -> tuple[int, int] | None:
+    if prefer == "row":
+        for r, color in info["row_emitters"].items():
+            if info["row_open"][r, 1:].any():
+                return int(r), int(color)
+    else:
+        for c, color in info["col_emitters"].items():
+            if info["col_open"][1:, c].any():
+                return int(c), int(color)
+    return None
+
+
+def _validate_generated_example(inp: np.ndarray, out: np.ndarray) -> bool:
+    if not isinstance(inp, np.ndarray) or not isinstance(out, np.ndarray):
+        return False
+    if inp.ndim != 2 or out.ndim != 2:
+        return False
+    if max(inp.shape) > 30 or max(out.shape) > 30:
+        return False
+
+    info = _analyze_grid(inp)
+    row_emitters = info["row_emitters"]
+    col_emitters = info["col_emitters"]
+    row_open = info["row_open"]
+    col_open = info["col_open"]
+    row_gate = info["row_gate"]
+    col_gate = info["col_gate"]
+    gate_union = row_gate | col_gate
+
+    expected = inp.copy()
+    for r in range(1, inp.shape[0]):
+        for c in range(1, inp.shape[1]):
+            if row_open[r, c] and col_open[r, c]:
+                expected[r, c] = BG
+            elif col_open[r, c]:
+                expected[r, c] = int(col_emitters[c])
+            elif row_open[r, c]:
+                expected[r, c] = int(row_emitters[r])
+    if not np.array_equal(expected, out):
+        return False
+    if not _scene_is_rich(inp):
+        return False
+
+    row_gate_pos = _find_critical_gate(info, "row")
+    col_gate_pos = _find_critical_gate(info, "col")
+    if row_gate_pos is None or col_gate_pos is None:
+        return False
+
+    mutated = inp.copy()
+    mutated[row_gate_pos] = BG
+    if np.array_equal(main(mutated), out):
+        return False
+
+    mutated = inp.copy()
+    mutated[col_gate_pos] = BG
+    if np.array_equal(main(mutated), out):
+        return False
+
+    active_row = _find_active_emitter(info, "row")
+    active_col = _find_active_emitter(info, "col")
+    if active_row is None or active_col is None:
+        return False
+
+    row_idx, row_color = active_row
+    alt_row = next(color for color in PALETTE if color != row_color)
+    mutated = inp.copy()
+    mutated[row_idx, 0] = alt_row
+    if np.array_equal(main(mutated), out):
+        return False
+
+    col_idx, col_color = active_col
+    alt_col = next(color for color in PALETTE if color != col_color)
+    mutated = inp.copy()
+    mutated[0, col_idx] = alt_col
+    if np.array_equal(main(mutated), out):
+        return False
+    return True

