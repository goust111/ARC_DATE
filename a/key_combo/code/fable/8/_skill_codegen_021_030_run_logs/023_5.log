+import random
+import sys
+from pathlib import Path
+
+import numpy as np
+
+
+for _arc_utils_dir in (Path("/home/lixinyu/snap/new/solvers"),):
+    if _arc_utils_dir.is_dir():
+        sys.path.append(str(_arc_utils_dir))
+
+try:
