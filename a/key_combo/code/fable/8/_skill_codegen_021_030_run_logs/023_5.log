+    if not _has_influential_gate(inp, out, col_gate):
+        return False
+    if not _has_influential_emitter(inp, out, row_emitters, "row"):
+        return False
+    if not _has_influential_emitter(inp, out, col_emitters, "col"):
+        return False
+    return True

