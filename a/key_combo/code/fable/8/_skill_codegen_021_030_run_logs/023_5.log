+
+    row_idx, row_color = active_row
+    alt_row = next(color for color in PALETTE if color != row_color)
+    mutated = inp.copy()
+    mutated[row_idx, 0] = alt_row
+    if np.array_equal(main(mutated), out):
+        return False
+
+    col_idx, col_color = active_col
+    alt_col = next(color for color in PALETTE if color != col_color)
+    mutated = inp.copy()
+    mutated[0, col_idx] = alt_col
+    if np.array_equal(main(mutated), out):
+        return False
+    return True

