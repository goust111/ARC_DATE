+            if cell != BG and cell in emitter_colors:
+                return True
+    return False
+
+
+def _sample_scene() -> np.ndarray | None:
+    main_h = random.randint(MIN_MAIN_H, MAX_MAIN_H)
+    main_w = random.randint(MIN_MAIN_W, MAX_MAIN_W)
