+import numpy as np
+
+
+for _arc_utils_dir in (Path("/home/lixinyu/snap/new/solvers"),):
+    if _arc_utils_dir.is_dir():
+        sys.path.append(str(_arc_utils_dir))
+
+try:
+    from arc_utils import Color
+except Exception:
+    class Color:
+        BLACK = 0
+        BLUE = 1
+        RED = 2
+        GREEN = 3
+        YELLOW = 4
+        GREY = 5
+        GRAY = 5
+        PINK = 6
+        ORANGE = 7
+        TEAL = 8
+        MAROON = 9
+        NOT_BLACK = [1, 2, 3, 4, 5, 6, 7, 8, 9]
+
+
+BG = Color.BLACK
+PALETTE = tuple(int(c) for c in Color.NOT_BLACK)
+
+MIN_MAIN_H = 8
+MAX_MAIN_H = 16
+MIN_MAIN_W = 8
+MAX_MAIN_W = 16
+MIN_EMITTERS = 2
+MAX_EMITTERS = 4
+MAX_GATES_PER_RAY = 4
+MAX_DISTRACTORS = 8
+MAX_ATTEMPTS = 500
