+    row_gate = info["row_gate"]
+    col_gate = info["col_gate"]
+    gate_union = row_gate | col_gate
+
+    expected = inp.copy()
+    for r in range(1, inp.shape[0]):
+        for c in range(1, inp.shape[1]):
+            if row_open[r, c] and col_open[r, c]:
