+    positive = [count for count in gate_counts if count > 0]
+    if not positive:
+        return False
+    if not any(count % 2 == 1 for count in positive):
+        return False
+    if not any(count % 2 == 0 for count in positive):
+        return False
+    if not any(count >= 3 for count in positive):
+        return False
+
+    return True
