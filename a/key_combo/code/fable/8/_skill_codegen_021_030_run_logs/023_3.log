+
+def _slot_centers(h: int, w: int) -> list[tuple[int, int]]:
+    top = 5
+    bottom = h - 6
+    left = 5
+    right = w - 6
+    return [(top, left), (top, right), (bottom, left), (bottom, right)]
+
+
+def _sample_centers(h: int, w: int, n: int) -> list[tuple[int, int]]:
