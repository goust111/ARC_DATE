+            local_allowed = (~_dilate4(occupied)).copy()
+            local_allowed[start] = False
+            local_allowed[anchor] = True
+            blob = _grow_blob(local_allowed, anchor, vote_area)
+            if blob is None:
+                continue
+            blob_mask = np.zeros(shape, dtype=bool)
+            for cell in blob:
+                blob_mask[cell] = True
+
+            contact_options = []
+            for br, bc in blob:
+                for nr, nc in neighbors4(br, bc):
