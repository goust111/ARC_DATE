+def _grey_distance_summary(objects: list[dict], grey_components: list[dict]) -> list[tuple[int, int, int]]:
+    pairs = []
+    for obj in objects:
+        cr, cc = map(int, obj["center"])
+        true_dist = -1
+        best_dist = 10**9
+        best_id = -1
