+    if slot == "tl":
+        rows = range(max(1, r0 - 3), r0)
+        cols = range(max(1, c0 - 3), c0)
+    elif slot == "tr":
+        rows = range(max(1, r0 - 3), r0)
+        cols = range(c1 + 1, min(w - 1, c1 + 4))
