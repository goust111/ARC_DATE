+                square_local[sr : sr + side, sc : sc + side] = True
+                line_local = crop & ~square_local
+                if not line_local.any():
+                    continue
+
+                line_parts = components_mask(line_local, connectivity=4)
+                if len(line_parts) != 1:
+                    continue
+
