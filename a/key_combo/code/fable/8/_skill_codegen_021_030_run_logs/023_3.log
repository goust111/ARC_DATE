+    for blob in true_clusters + decoy_blobs:
+        for r, c in blob:
+            grid[r, c] = Color.GREY
+
+    out = main(grid)
+    _validate_instance(grid, out)
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_MAX_ATTEMPTS):
+        grid = _generate_once()
+        if grid is not None:
+            return grid
