+
+
+def _square_mask_for_generation(shape: tuple[int, int], center: tuple[int, int], side: int) -> np.ndarray:
+    mask = np.zeros(shape, dtype=bool)
+    r0, c0, r1, c1 = _square_bounds(center, side)
+    mask[r0 : r1 + 1, c0 : c1 + 1] = True
