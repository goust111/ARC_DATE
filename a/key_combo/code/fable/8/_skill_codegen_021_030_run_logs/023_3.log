+
+
+def _grey_distance_summary(objects: list[dict], grey_components: list[dict]) -> list[tuple[int, int]]:
+    pairs = []
+    for obj in objects:
+        cr, cc = map(int, obj["center"])
+        true_dist = -1
+        best_dist = 10**9
+        best_id = -1
+        for grey_id, grey in enumerate(grey_components):
+            rr = grey["coords"][:, 0]
+            cc2 = grey["coords"][:, 1]
+            dist = int(np.min(np.abs(rr - cr) + np.abs(cc2 - cc)))
+            if dist < best_dist:
+                best_dist = dist
+                best_id = int(grey_id)
