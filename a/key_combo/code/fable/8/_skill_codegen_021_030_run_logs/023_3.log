+
+                square_global = np.zeros(shape, dtype=bool)
+                square_global[r0 + sr : r0 + sr + side, c0 + sc : c0 + sc + side] = True
+                line_global = np.zeros(shape, dtype=bool)
+                for rr, cc in line_coords:
+                    line_global[r0 + rr, c0 + cc] = True
+
+                candidates.append(
