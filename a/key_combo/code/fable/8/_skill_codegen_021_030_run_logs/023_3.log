+            cc2 = grey["coords"][:, 1]
+            dist = int(np.min(np.abs(rr - cr) + np.abs(cc2 - cc)))
+            if dist < best_dist:
+                best_dist = dist
+                best_id = int(grey_id)
+            if int(grey_id) == int(obj["grey_id"]):
