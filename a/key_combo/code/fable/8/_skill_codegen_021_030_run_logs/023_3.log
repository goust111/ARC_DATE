+def _named_slot_centers(h: int, w: int) -> dict[str, tuple[int, int]]:
+    return {
+        "tl": (7, 7),
+        "tr": (7, w - 8),
+        "bl": (h - 8, 7),
+        "br": (h - 8, w - 8),
+    }
