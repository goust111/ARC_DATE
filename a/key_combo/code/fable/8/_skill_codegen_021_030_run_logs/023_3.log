+    decoy_blobs = []
+    for center, side in zip(centers, sizes):
+        decoy = _place_decoy_blob((h, w), occupied, center, side, random.choice(DECOY_AREA_CHOICES))
+        if decoy is None:
+            continue
+        decoy_mask = np.zeros((h, w), dtype=bool)
+        for cell in decoy:
+            decoy_mask[cell] = True
+        if np.any(decoy_mask & occupied):
