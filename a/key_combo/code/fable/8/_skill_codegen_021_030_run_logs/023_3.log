+def _grow_blob_in_zone(
+    zone_cells: list[tuple[int, int]],
+    anchor: tuple[int, int],
+    area: int,
+) -> list[tuple[int, int]] | None:
+    allowed = set(zone_cells)
+    if anchor not in allowed or len(allowed) < int(area):
+        return None
+    blob = {anchor}
+    while len(blob) < int(area):
