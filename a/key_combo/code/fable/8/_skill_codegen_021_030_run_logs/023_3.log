+        if r0 < 0 or c0 < 0 or r1 >= h or c1 >= w:
+            return None
+        square_mask = _square_mask_for_generation((h, w), center, side)
+        if any(np.any(square_mask & other) for other in square_masks):
+            return None
+        square_masks.append(square_mask)
