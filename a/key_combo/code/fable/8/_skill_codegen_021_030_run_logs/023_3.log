+    r0 = max(0, r0 - 1)
+    c0 = max(0, c0 - 1)
+    r1 = min(shape[0] - 1, r1 + 1)
+    c1 = min(shape[1] - 1, c1 + 1)
+    mask[r0 : r1 + 1, c0 : c1 + 1] = True
+    return mask
