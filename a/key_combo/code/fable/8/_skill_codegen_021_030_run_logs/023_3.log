+        occupied |= decoy_mask
+        decoy_blobs.append(decoy)
+
+    if not decoy_blobs:
+        return None
+
+    for spec in specs:
+        _paint_square(grid, spec["center"], spec["side"], spec["color"])
+    for path, spec in zip(paths, specs):
+        for r, c in path:
+            grid[r, c] = spec["color"]
+    for blob in true_clusters + decoy_blobs:
+        for r, c in blob:
+            grid[r, c] = Color.GREY
