def _reachable_path(
    shape: tuple[int, int],
    start: tuple[int, int],
    goal: tuple[int, int],
    blocked: np.ndarray,
) -> list[tuple[int, int]] | None:
    if not in_bounds(shape, *start) or not in_bounds(shape, *goal):
        return None
    if blocked[start] or blocked[goal]:
        return None

    q = deque([start])
    prev = {start: None}
    while q:
        cell = q.popleft()
        if cell == goal:
            break
        for nr, nc in neighbors4(*cell):
            nxt = (int(nr), int(nc))
            if not in_bounds(shape, *nxt) or blocked[nxt] or nxt in prev:
                continue
            prev[nxt] = cell
            q.append(nxt)
    if goal not in prev:
        return None

    path = []
    cur = goal
    while cur is not None:
        path.append(cur)
        cur = prev[cur]
    path.reverse()
    return path


def _grow_blob(
    allowed: np.ndarray,
    seed: tuple[int, int],
    area: int,
) -> list[tuple[int, int]] | None:
    if not allowed[seed]:
        return None
    blob = {seed}
    frontier = {seed}
    while len(blob) < int(area):
        candidates = []
        for r, c in frontier:
            for dr, dc in DIR8:
                nr, nc = r + dr, c + dc
                if in_bounds(allowed.shape, nr, nc) and allowed[nr, nc] and (nr, nc) not in blob:
                    candidates.append((nr, nc))
        if not candidates:
            return None
        nxt = random.choice(candidates)
        blob.add(nxt)
        frontier.add(nxt)
    return list(blob)


def _free_cells(mask: np.ndarray) -> list[tuple[int, int]]:
    coords = np.argwhere(mask)
    random.shuffle(coords)
    return [tuple(map(int, rc)) for rc in coords]


def _place_true_cluster_and_path(
    shape: tuple[int, int],
    square_masks: list[np.ndarray],
    occupied: np.ndarray,
    center: tuple[int, int],
    side: int,
    vote_area: int,
) -> tuple[list[tuple[int, int]], list[tuple[int, int]]] | None:
    shape_mask = np.zeros(shape, dtype=bool)
    for sq in square_masks:
        shape_mask |= sq

    starts = _start_cells(center, side)
    random.shuffle(starts)
    free = ~occupied
    other_halo = np.zeros(shape, dtype=bool)
    for sq_center, sq_side in []:
        _ = (sq_center, sq_side)

    for start, _name in starts:
        if not in_bounds(shape, *start) or not free[start]:
            continue

        own_halo = _expanded_square_halo(shape, center, side)
        own_halo[start] = False
        blocked_for_line = occupied | own_halo

        anchor_candidates = _free_cells(free.copy())
        for anchor in anchor_candidates:
            if anchor == start:
                continue
            if abs(anchor[0] - center[0]) + abs(anchor[1] - center[1]) < 8:
                continue
            if sum(abs(anchor[k] - start[k]) for k in (0, 1)) < 7:
                continue
            if _touches_mask(shape_mask, *anchor):
                continue

            local_allowed = (~occupied).copy()
            local_allowed[start] = False
            local_allowed[anchor] = True
            blob = _grow_blob(local_allowed, anchor, vote_area)
            if blob is None:
                continue
            blob_mask = np.zeros(shape, dtype=bool)
            for cell in blob:
                blob_mask[cell] = True

            contact_options = []
            for br, bc in blob:
                for nr, nc in neighbors4(br, bc):
                    cell = (int(nr), int(nc))
                    if not in_bounds(shape, *cell) or occupied[cell] or blob_mask[cell] or cell == start:
                        continue
                    if _touches_mask(shape_mask, *cell):
                        continue
                    contact_options.append(cell)
            random.shuffle(contact_options)
            for contact in contact_options[:24]:
                path = _reachable_path(shape, start, contact, blocked_for_line | blob_mask)
                if path is None or len(path) < 3:
                    continue
                return blob, path
    return None


def _place_decoy_blob(
    shape: tuple[int, int],
    occupied: np.ndarray,
    center: tuple[int, int],
    side: int,
    area: int,
) -> list[tuple[int, int]] | None:
    cr, cc = center
    r0, c0, r1, c1 = _square_bounds(center, side)
    ring = []
    for r in range(max(1, r0 - 4), min(shape[0] - 1, r1 + 5)):
        for c in range(max(1, c0 - 4), min(shape[1] - 1, c1 + 5)):
            if occupied[r, c]:
                continue
            dist = min(abs(r - r0), abs(r - r1), abs(c - c0), abs(c - c1))
            manhattan = abs(r - cr) + abs(c - cc)
            if 2 <= dist <= 4 and manhattan <= 7:
                ring.append((r, c))
    random.shuffle(ring)
    for seed in ring:
        allowed = (~occupied).copy()
        blob = _grow_blob(allowed, seed, area)
        if blob is not None:
            return blob
    return None


def _nearest_grey_distance(objects: list[dict], grey_components: list[dict]) -> list[tuple[int, int]]:
    pairs = []
    for obj in objects:
        cr, cc = obj["center"]
        dists = []
        for grey in grey_components:
            rr, cc2 = grey["coords"][:, 0], grey["coords"][:, 1]
            dist = int(np.min(np.abs(rr - cr) + np.abs(cc2 - cc)))
            dists.append(dist)
        pairs.append((obj["grey_id"], int(min(dists))))
    return pairs


def _validate_instance(inp: np.ndarray, out: np.ndarray) -> None:
    assert isinstance(inp, np.ndarray) and isinstance(out, np.ndarray)
    assert inp.ndim == 2 and out.ndim == 2
    assert max(inp.shape) <= 30 and max(out.shape) <= 30

    bg, grey_components, objects, decoys = _parse_grid(inp)
    assert len(objects) in COUNT_CHOICES
    assert decoys, "generator must include detached grey decoys"
    assert len({obj["color"] for obj in objects}) == len(objects)
    assert len({obj["side"] for obj in objects}) >= 2
    assert any(obj["votes"] != obj["side"] for obj in objects)

    ranked = sorted(objects, key=lambda obj: -obj["votes"])
    size_order = sorted((obj["side"] for obj in objects), reverse=True)
    assigned = {
        (obj["center"], obj["color"]): side for obj, side in zip(ranked, size_order)
    }
    assert any(assigned[(obj["center"], obj["color"])] != obj["side"] for obj in objects), "size ranking must cause a real reshuffle"

    nearest_pairs = _nearest_grey_distance(objects, grey_components)
    assert any(
        nearest < min(
            int(np.min(np.abs(grey_components[obj["grey_id"]]["coords"][:, 0] - obj["center"][0]) + np.abs(grey_components[obj["grey_id"]]["coords"][:, 1] - obj["center"][1])))
            for obj in [objects[i]]
        )
        for i, (_grey_id, nearest) in enumerate(nearest_pairs)
    ), "at least one object should have a closer grey decoy than its true cluster"

    out_bg = int(get_bg(out))
    out_components = find_components(
        out,
        bg=out_bg,
        colors=[c for c in np.unique(out) if int(c) != out_bg],
        connectivity=4,
        monochromatic=True,
        return_format="dict",
    )
    assert len(out_components) == len(objects)
    seen = set()
    for comp in out_components:
        color = int(comp["color"])
        r0, c0, r1, c1 = map(int, comp["bbox"])
        side = int(r1 - r0 + 1)
        assert side == int(c1 - c0 + 1) and side % 2 == 1
        assert int(comp["area"]) == side * side
        center = (r0 + side // 2, c0 + side // 2)
        key = (center, color)
        assert key in assigned
        assert assigned[key] == side
        seen.add(key)
    assert len(seen) == len(objects)
    assert np.array_equal(out, main(inp))
    assert int(np.count_nonzero(out == Color.GREY)) == 0
    assert int(np.count_nonzero(out == bg)) < out.size


def _generate_once() -> np.ndarray | None:
    h = random.randint(*GRID_SIDE_RANGE)
    w = random.randint(*GRID_SIDE_RANGE)
    n = random.choice(COUNT_CHOICES)
    bg = Color.BLACK
    grid = np.full((h, w), bg, dtype=int)

    sizes = sorted(random.sample(SIDE_CHOICES, n), reverse=True)
    votes = random.sample(TRUE_VOTE_CHOICES, n)
    colors = random.sample([c for c in range(1, 10) if c != Color.GREY], n)
    centers = _sample_centers(h, w, n)

    square_masks = []
    for center, side in zip(centers, sizes):
        r0, c0, r1, c1 = _square_bounds(center, side)
        if r0 < 0 or c0 < 0 or r1 >= h or c1 >= w:
            return None
        square_mask = _square_mask_for_generation((h, w), center, side)
        if any(np.any(square_mask & other) for other in square_masks):
            return None
        square_masks.append(square_mask)

    occupied = np.zeros((h, w), dtype=bool)
    for square_mask in square_masks:
        occupied |= square_mask

    true_clusters = []
    paths = []
    for i in range(n):
        placed = _place_true_cluster_and_path((h, w), square_masks, occupied, centers[i], sizes[i], votes[i])
        if placed is None:
            return None
        blob, path = placed
        blob_mask = np.zeros((h, w), dtype=bool)
        for cell in blob:
            blob_mask[cell] = True
        path_mask = np.zeros((h, w), dtype=bool)
        for cell in path:
            path_mask[cell] = True
        if np.any(blob_mask & occupied) or np.any(path_mask & occupied):
            return None
        occupied |= blob_mask | path_mask
        true_clusters.append(blob)
        paths.append(path)

    decoy_blobs = []
    for center, side in zip(centers, sizes):
        decoy = _place_decoy_blob((h, w), occupied, center, side, random.choice(DECOY_AREA_CHOICES))
        if decoy is None:
            continue
        decoy_mask = np.zeros((h, w), dtype=bool)
        for cell in decoy:
            decoy_mask[cell] = True
        if np.any(decoy_mask & occupied):
            continue
        occupied |= decoy_mask
        decoy_blobs.append(decoy)

    if not decoy_blobs:
        return None

    for center, side, color in zip(centers, sizes, colors):
        _paint_square(grid, center, side, color)
    for path, color in zip(paths, colors):
        for r, c in path:
            grid[r, c] = color
    for blob in true_clusters + decoy_blobs:
        for r, c in blob:
            grid[r, c] = Color.GREY

    out = main(grid)
    _validate_instance(grid, out)
    return grid


def generate_input() -> np.ndarray:
    for _ in range(GEN_MAX_ATTEMPTS):
        grid = _generate_once()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid non-degenerate puzzle instance")

