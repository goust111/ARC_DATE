+def _place_true_cluster_and_path(
+    shape: tuple[int, int],
+    square_masks: list[np.ndarray],
+    occupied: np.ndarray,
+    center: tuple[int, int],
+    side: int,
+    vote_area: int,
+) -> tuple[list[tuple[int, int]], list[tuple[int, int]]] | None:
+    shape_mask = np.zeros(shape, dtype=bool)
+    for sq in square_masks:
+        shape_mask |= sq
