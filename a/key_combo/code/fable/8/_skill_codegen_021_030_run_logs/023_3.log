+        start,
+        (mid_rows[slot], start[1]),
+        (mid_rows[slot], route_cols[slot]),
+        (end_rows[slot], route_cols[slot]),
+    ]
+    path = _polyline_cells(points)
+    zone_cols = range(max(1, route_cols[slot] - 1), min(w - 1, route_cols[slot] + 2))
+    zone_cells = [(r, c) for r in zone_rows for c in zone_cols]
+    return path, anchor, zone_cells
