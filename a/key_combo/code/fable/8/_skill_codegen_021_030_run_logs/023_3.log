+def _line_degree(mask: np.ndarray, r: int, c: int) -> int:
+    deg = 0
+    for nr, nc in neighbors4(r, c):
+        if in_bounds(mask.shape, nr, nc) and mask[nr, nc]:
+            deg += 1
+    return deg
+
+
+def _touches_mask(mask: np.ndarray, r: int, c: int) -> bool:
+    for nr, nc in neighbors4(r, c):
