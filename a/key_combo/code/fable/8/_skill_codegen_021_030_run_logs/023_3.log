+def _route_plan(slot: str, center: tuple[int, int], side: int, h: int, w: int) -> tuple[list[tuple[int, int]], tuple[int, int], list[tuple[int, int]]]:
+    r0, c0, r1, c1 = _square_bounds(center, side)
+    mid_rows = {"tl": h // 2 - 2, "tr": h // 2 - 1, "bl": h // 2 + 1, "br": h // 2 + 2}
+    route_cols = {"tl": w // 2 - 2, "bl": w // 2 - 1, "br": w // 2 + 1, "tr": w // 2 + 2}
+    end_rows = {"tl": h - 6, "tr": h - 5, "bl": 5, "br": 4}
+
+    if slot in {"tl", "tr"}:
+        start = (r1 + 1, center[1])
+        anchor = (end_rows[slot] + 1, route_cols[slot])
+        zone_rows = range(anchor[0], min(h - 1, anchor[0] + 3))
+    else:
+        start = (r0 - 1, center[1])
+        anchor = (end_rows[slot] - 1, route_cols[slot])
+        zone_rows = range(max(1, anchor[0] - 2), anchor[0] + 1)
