+    for path, color in zip(paths, colors):
+        for r, c in path:
+            grid[r, c] = color
+    for blob in true_clusters + decoy_blobs:
+        for r, c in blob:
+            grid[r, c] = Color.GREY
+
+    out = main(grid)
+    _validate_instance(grid, out)
+    return grid
