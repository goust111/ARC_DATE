+    sizes = sorted((int(obj["side"]) for obj in objects), reverse=True)
+
+    out = np.full(g.shape, bg, dtype=int)
+    for obj, side in zip(ranked, sizes):
+        _paint_square(out, obj["center"], int(side), int(obj["color"]))
+    return out
