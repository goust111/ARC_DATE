+
+    nearest_pairs = _nearest_grey_distance(objects, grey_components)
+    assert any(
+        nearest < min(
+            int(np.min(np.abs(grey_components[obj["grey_id"]]["coords"][:, 0] - obj["center"][0]) + np.abs(grey_components[obj["grey_id"]]["coords"][:, 1] - obj["center"][1])))
+            for obj in [objects[i]]
+        )
+        for i, (_grey_id, nearest) in enumerate(nearest_pairs)
+    ), "at least one object should have a closer grey decoy than its true cluster"
+
+    out_bg = int(get_bg(out))
+    out_components = find_components(
+        out,
