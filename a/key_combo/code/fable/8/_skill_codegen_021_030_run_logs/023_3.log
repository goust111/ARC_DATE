+def _touches_line(line_mask: np.ndarray, coords: np.ndarray) -> bool:
+    for r, c in coords:
+        rr, cc = int(r), int(c)
+        for nr, nc in neighbors4(rr, cc):
+            if in_bounds(line_mask.shape, nr, nc) and line_mask[nr, nc]:
+                return True
+    return False
