+                continue
+            if abs(anchor[0] - center[0]) + abs(anchor[1] - center[1]) < 8:
+                continue
+            if sum(abs(anchor[k] - start[k]) for k in (0, 1)) < 7:
+                continue
+            if _touches_mask(shape_mask, *anchor):
