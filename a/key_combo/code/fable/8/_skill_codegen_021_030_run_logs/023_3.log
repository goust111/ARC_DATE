+        colors=[c for c in np.unique(out) if int(c) != out_bg],
+        connectivity=4,
+        monochromatic=True,
+        return_format="dict",
+    )
+    assert len(out_components) == len(objects)
+    seen = set()
+    for comp in out_components:
