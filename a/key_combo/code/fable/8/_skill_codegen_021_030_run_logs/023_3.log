+def _polyline_cells(points: list[tuple[int, int]]) -> list[tuple[int, int]]:
+    cells = []
+    for i in range(len(points) - 1):
+        seg = _segment_cells(points[i], points[i + 1])
+        cells.extend(seg if i == 0 else seg[1:])
+    return cells
