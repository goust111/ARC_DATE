+COUNT_CHOICES = (3, 4)
+GRID_SIDE_RANGE = (24, 30)
+TRUE_VOTE_CHOICES = tuple(range(1, 8))
+DECOY_AREA_CHOICES = (1, 2, 3, 4)
+GEN_MAX_ATTEMPTS = 1000
+ANCHOR_CANDIDATE_LIMIT = 120
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
