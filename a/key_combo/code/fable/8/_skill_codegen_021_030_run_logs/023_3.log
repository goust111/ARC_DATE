+            if dist < best_dist:
+                best_dist = dist
+                best_id = int(grey_id)
+            if int(grey_id) == int(obj["grey_id"]):
+                true_dist = dist
+        pairs.append((best_id, best_dist, true_dist))
+    return pairs
