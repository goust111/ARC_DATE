+        attached = [i for i, grey in enumerate(grey_components) if _touches_line(spec["line_mask"], grey["coords"])]
+        assert len(attached) == 1, "each line must identify exactly one grey vote cluster"
+        grey_id = attached[0]
+        grey = grey_components[grey_id]
