+def _reachable_path(
+    shape: tuple[int, int],
+    start: tuple[int, int],
+    goal: tuple[int, int],
+    blocked: np.ndarray,
+) -> list[tuple[int, int]] | None:
+    if not in_bounds(shape, *start) or not in_bounds(shape, *goal):
+        return None
+    if blocked[start] or blocked[goal]:
+        return None
+
+    q = deque([start])
+    prev = {start: None}
+    while q:
+        cell = q.popleft()
+        if cell == goal:
+            break
+        for nr, nc in neighbors4(*cell):
+            nxt = (int(nr), int(nc))
+            if not in_bounds(shape, *nxt) or blocked[nxt] or nxt in prev:
+                continue
+            prev[nxt] = cell
+            q.append(nxt)
+    if goal not in prev:
+        return None
+
+    path = []
+    cur = goal
+    while cur is not None:
+        path.append(cur)
+        cur = prev[cur]
+    path.reverse()
+    return path
