+
+
+def _place_decoy_blob(
+    shape: tuple[int, int],
+    occupied: np.ndarray,
+    center: tuple[int, int],
+    side: int,
+    area: int,
+) -> list[tuple[int, int]] | None:
+    cr, cc = center
