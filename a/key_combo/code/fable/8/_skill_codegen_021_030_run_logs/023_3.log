+def _reachable_path(
+    shape: tuple[int, int],
+    start: tuple[int, int],
+    goal: tuple[int, int],
+    blocked: np.ndarray,
+) -> list[tuple[int, int]] | None:
+    if not in_bounds(shape, *start) or not in_bounds(shape, *goal):
+        return None
+    if blocked[start] or blocked[goal]:
+        return None
+
+    q = deque([start])
+    prev = {start: None}
+    while q:
+        cell = q.popleft()
+        if cell == goal:
+            break
+        for nr, nc in neighbors4(*cell):
+            nxt = (int(nr), int(nc))
+            if not in_bounds(shape, *nxt) or blocked[nxt] or nxt in prev:
+                continue
+            prev[nxt] = cell
+            q.append(nxt)
+    if goal not in prev:
+        return None
+
+    path = []
+    cur = goal
+    while cur is not None:
+        path.append(cur)
+        cur = prev[cur]
+    path.reverse()
+    return path
+
+
+def _grow_blob(
+    allowed: np.ndarray,
+    seed: tuple[int, int],
+    area: int,
+) -> list[tuple[int, int]] | None:
+    if not allowed[seed]:
+        return None
+    blob = {seed}
+    frontier = {seed}
+    while len(blob) < int(area):
+        candidates = []
+        for r, c in frontier:
+            for dr, dc in DIR8:
+                nr, nc = r + dr, c + dc
+                if in_bounds(allowed.shape, nr, nc) and allowed[nr, nc] and (nr, nc) not in blob:
+                    candidates.append((nr, nc))
+        if not candidates:
+            return None
+        nxt = random.choice(candidates)
+        blob.add(nxt)
+        frontier.add(nxt)
+    return list(blob)
+
+
+def _free_cells(mask: np.ndarray) -> list[tuple[int, int]]:
+    coords = np.argwhere(mask)
+    random.shuffle(coords)
+    return [tuple(map(int, rc)) for rc in coords]
