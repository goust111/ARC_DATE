+def _parse_grid(grid: np.ndarray) -> tuple[int, list[dict], list[dict], list[dict]]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+    bg = int(get_bg(g))
