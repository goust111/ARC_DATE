+def generate_input() -> np.ndarray:
+    for _ in range(GEN_MAX_ATTEMPTS):
+        grid = _generate_once()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid non-degenerate puzzle instance")

