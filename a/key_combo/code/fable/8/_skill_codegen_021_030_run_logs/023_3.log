+
+def _square_bounds(center: tuple[int, int], side: int) -> tuple[int, int, int, int]:
+    r, c = map(int, center)
+    d = int(side) // 2
+    return r - d, c - d, r + d, c + d
+
+
+def _paint_square(grid: np.ndarray, center: tuple[int, int], side: int, color: int) -> None:
