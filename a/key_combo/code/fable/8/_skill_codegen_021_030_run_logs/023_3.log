+    r0, c0, r1, c1 = map(int, component["bbox"])
+    crop = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    local = coords - np.array([[r0, c0]])
+    crop[local[:, 0], local[:, 1]] = True
