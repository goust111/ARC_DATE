+        end_row = h - 6
+        start = (r1 + 1, center[1])
+        turn_row = start[0] + 1
+        points = [start, (turn_row, start[1]), (turn_row, route_col), (end_row, route_col)]
+        anchor = (end_row + 1, route_col)
+        zone_rows = range(anchor[0], min(h - 1, anchor[0] + 3))
