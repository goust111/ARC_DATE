+def _nearest_grey_distance(objects: list[dict], grey_components: list[dict]) -> list[tuple[int, int]]:
+    pairs = []
+    for obj in objects:
+        cr, cc = obj["center"]
+        dists = []
+        for grey in grey_components:
+            rr, cc2 = grey["coords"][:, 0], grey["coords"][:, 1]
+            dist = int(np.min(np.abs(rr - cr) + np.abs(cc2 - cc)))
+            dists.append(dist)
+        pairs.append((obj["grey_id"], int(min(dists))))
