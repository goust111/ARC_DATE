+def _square_mask_for_generation(shape: tuple[int, int], center: tuple[int, int], side: int) -> np.ndarray:
+    mask = np.zeros(shape, dtype=bool)
+    r0, c0, r1, c1 = _square_bounds(center, side)
+    mask[r0 : r1 + 1, c0 : c1 + 1] = True
+    return mask
+
+
+def _expanded_square_halo(shape: tuple[int, int], center: tuple[int, int], side: int) -> np.ndarray:
+    mask = np.zeros(shape, dtype=bool)
+    r0, c0, r1, c1 = _square_bounds(center, side)
+    r0 = max(0, r0 - 1)
+    c0 = max(0, c0 - 1)
+    r1 = min(shape[0] - 1, r1 + 1)
+    c1 = min(shape[1] - 1, c1 + 1)
+    mask[r0 : r1 + 1, c0 : c1 + 1] = True
+    return mask
+
+
+def _start_cells(center: tuple[int, int], side: int) -> list[tuple[tuple[int, int], str]]:
+    r0, c0, r1, c1 = _square_bounds(center, side)
+    cr, cc = center
+    return [
+        ((r0 - 1, cc), "up"),
+        ((r1 + 1, cc), "down"),
+        ((cr, c0 - 1), "left"),
+        ((cr, c1 + 1), "right"),
+    ]
+
+
+def _reachable_path(
+    shape: tuple[int, int],
+    start: tuple[int, int],
+    goal: tuple[int, int],
+    blocked: np.ndarray,
+) -> list[tuple[int, int]] | None:
+    if not in_bounds(shape, *start) or not in_bounds(shape, *goal):
+        return None
+    if blocked[start] or blocked[goal]:
+        return None
+
+    q = deque([start])
+    prev = {start: None}
+    while q:
+        cell = q.popleft()
+        if cell == goal:
+            break
+        for nr, nc in neighbors4(*cell):
+            nxt = (int(nr), int(nc))
+            if not in_bounds(shape, *nxt) or blocked[nxt] or nxt in prev:
+                continue
+            prev[nxt] = cell
+            q.append(nxt)
+    if goal not in prev:
+        return None
+
+    path = []
+    cur = goal
+    while cur is not None:
+        path.append(cur)
+        cur = prev[cur]
+    path.reverse()
+    return path
+
+
+def _grow_blob(
+    allowed: np.ndarray,
+    seed: tuple[int, int],
+    area: int,
+) -> list[tuple[int, int]] | None:
+    if not allowed[seed]:
+        return None
+    blob = {seed}
+    frontier = {seed}
+    while len(blob) < int(area):
+        candidates = []
+        for r, c in frontier:
+            for dr, dc in DIR8:
+                nr, nc = r + dr, c + dc
+                if in_bounds(allowed.shape, nr, nc) and allowed[nr, nc] and (nr, nc) not in blob:
+                    candidates.append((nr, nc))
+        if not candidates:
+            return None
+        nxt = random.choice(candidates)
+        blob.add(nxt)
+        frontier.add(nxt)
+    return list(blob)
