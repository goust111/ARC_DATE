+        for c in range(max(1, c0 - 4), min(shape[1] - 1, c1 + 5)):
+            if occupied[r, c]:
+                continue
+            dist = min(abs(r - r0), abs(r - r1), abs(c - c0), abs(c - c1))
+            manhattan = abs(r - cr) + abs(c - cc)
