+        r0, c0, r1, c1 = bbox_coords(np.argwhere(mask))
+        mask = mask[r0 : r1 + 1, c0 : c1 + 1]
+        if require_irregular and mask.all():
+            continue
+        if len(_enclosed_holes(mask)) != 0:
+            continue
+        return mask
+    raise RuntimeError("failed to sample a connected mask")
