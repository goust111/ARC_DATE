+def _center_distance(box_a: tuple[int, int, int, int], box_b: tuple[int, int, int, int]) -> float:
+    ra, ca = _bbox_center(box_a)
+    rb, cb = _bbox_center(box_b)
+    return abs(ra - rb) + abs(ca - cb)
