+    sprite[mask] = int(color)
+    return sprite
+
+
+def _build_shell_around(hole_mask: np.ndarray, color: int, reserved_sigs: set[tuple[tuple[int, int], bytes]]) -> tuple[np.ndarray, np.ndarray]:
