+        paste(next_sprite, current_sprite, hole_r0, hole_c0, transparent=BG)
+        current_sprite = next_sprite
+        current_mask = filled_mask
+        reserved_sigs.add(_mask_signature(filled_mask))
+    return components, current_sprite
