+    colors = _random_frame_colors(total_colors)
+    color_i = 0
+
+    chain: list[Frame] = []
+    receiver_side = SIDE_FROM_DIR[(-direction[0], -direction[1])]
+    source_side = SIDE_FROM_DIR[direction]
+    axis_span = height if horizontal else width
+
+    for i in range(active_count):
