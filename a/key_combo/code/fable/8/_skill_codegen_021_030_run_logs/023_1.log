+        if idx in emitted:
+            continue
+        emitted.add(idx)
+        _fill_interior(out, frames[idx], RAY)
+        target = _trace_from_frame(
+            g,
+            out,
+            frames,
+            opening_map,
+            idx,
+            direction,
+            use_entry_port=use_entry_port,
+        )
+        if target is not None and target not in active:
+            active.add(target)
+            queue.append((target, direction, False))
