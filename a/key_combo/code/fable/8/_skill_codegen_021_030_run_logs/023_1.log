+        side_hits = [
+            ("U", orow == r0),
+            ("D", orow == r1),
+            ("L", ocol == c0),
+            ("R", ocol == c1),
+        ]
+        side_names = [name for name, ok in side_hits if ok]
+        if len(side_names) != 1:
+            raise AssertionError("opening must be on exactly one non-corner side")
+        side = side_names[0]
+        if side in {"U", "D"}:
+            offset = ocol - c0
