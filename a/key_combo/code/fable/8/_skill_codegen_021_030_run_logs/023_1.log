+def _trace_from_frame(
+    input_grid: np.ndarray,
+    out: np.ndarray,
+    frames: list[Frame],
+    opening_map: dict[tuple[int, int], int],
+    idx: int,
+    direction: tuple[int, int],
+) -> int | None:
+    dr, dc = direction
+    orow, ocol = frames[idx].opening
+    out[orow, ocol] = RAY
+    rr, cc = orow + dr, ocol + dc
+    while in_bounds(input_grid.shape, rr, cc):
+        target = opening_map.get((rr, cc))
+        if target is not None and target != idx and frames[target].opening_dir == (-dr, -dc):
+            out[rr, cc] = RAY
+            return target
+        if int(input_grid[rr, cc]) != BG:
+            return None
+        out[rr, cc] = RAY
+        rr += dr
+        cc += dc
+    return None
+
+
+def _parse_frames(grid: np.ndarray, bg: int) -> list[Frame]:
+    comps = find_components(
+        grid,
+        bg=bg,
+        connectivity=4,
+        monochromatic=True,
+        return_format="dict",
+    )
+    frames: list[Frame] = []
+    for comp in comps:
+        color = int(comp["color"])
+        if color in {bg, RAY}:
+            continue
+        coords = {tuple(map(int, rc)) for rc in comp["coords"]}
+        r0, c0, r1, c1 = map(int, comp["bbox"])
+        h = r1 - r0 + 1
+        w = c1 - c0 + 1
+        if h < 3 or w < 3:
+            raise AssertionError("frame bbox must have non-empty interior")
+        border = set()
+        for c in range(c0, c1 + 1):
+            border.add((r0, c))
+            border.add((r1, c))
+        for r in range(r0, r1 + 1):
+            border.add((r, c0))
+            border.add((r, c1))
+        if any(coord not in border for coord in coords):
+            raise AssertionError("frame component must lie on its bbox border")
+        missing = sorted(border - coords)
+        if len(missing) != 1:
+            raise AssertionError("expected exactly one opening cell")
+        orow, ocol = missing[0]
+        side_hits = [
+            ("U", orow == r0),
+            ("D", orow == r1),
+            ("L", ocol == c0),
+            ("R", ocol == c1),
+        ]
+        side_names = [name for name, ok in side_hits if ok]
+        if len(side_names) != 1:
+            raise AssertionError("opening must be on exactly one non-corner side")
+        side = side_names[0]
+        if side in {"U", "D"}:
+            offset = ocol - c0
+            if offset in {0, w - 1}:
+                raise AssertionError("opening may not be on a corner")
+        else:
+            offset = orow - r0
+            if offset in {0, h - 1}:
+                raise AssertionError("opening may not be on a corner")
+        expected_area = len(border) - 1
+        if int(comp["area"]) != expected_area:
+            raise AssertionError("component must be a 1-cell-thick hollow rectangle with one opening")
+        frames.append(Frame(r0, c0, h, w, color, side, offset))
+    if not frames:
+        raise AssertionError("expected at least one frame")
+    return frames
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Light the seed frame and every frame reached through a chain of aligned one-cell ports.
+
+    Input structure:
+    - The background is black and contains several separated monochrome hollow rectangular frames.
+    - Each frame is one cell thick and has exactly one one-cell opening on one side.
+    - Exactly one frame contains a single yellow seed pixel in its interior; every other frame interior is empty.
+
+    Rule:
+    - The seed frame activates first, fills its interior yellow, and emits a yellow ray through its opening in that opening's outward direction.
+    - A ray paints every background cell it crosses; if it reaches another frame exactly at that frame's opening from the outside, that frame activates, fills yellow, and relays the signal forward along the same straight direction.
+    - If the ray would hit a wall before reaching a usable opening, it stops there; unactivated frames stay unchanged.
+
+    Key insight:
+    - This is a directed reachability task on openings: geometric alignment alone is insufficient because the first wall on the ray blocks anything farther away.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+    bg = int(get_bg(g))
+
+    seed_coords = np.argwhere(g == RAY)
+    if seed_coords.shape != (1, 2):
+        raise AssertionError("expected exactly one yellow seed pixel")
+    seed = tuple(map(int, seed_coords[0]))
+
+    frames = _parse_frames(g, bg)
+    source_indices = [i for i, frame in enumerate(frames) if _interior_contains(frame, seed)]
+    if len(source_indices) != 1:
+        raise AssertionError("seed must lie inside exactly one frame interior")
+    source = source_indices[0]
+
+    out = g.copy()
+    opening_map = {frame.opening: i for i, frame in enumerate(frames)}
+    if len(opening_map) != len(frames):
+        raise AssertionError("frame openings must be distinct")
+
+    active = {source}
+    emitted: set[int] = set()
+    queue: deque[tuple[int, tuple[int, int]]] = deque([(source, frames[source].opening_dir)])
+
+    while queue:
+        idx, direction = queue.popleft()
+        if idx in emitted:
+            continue
+        emitted.add(idx)
+        _fill_interior(out, frames[idx], RAY)
+        target = _trace_from_frame(g, out, frames, opening_map, idx, direction)
+        if target is not None and target not in active:
+            active.add(target)
+            queue.append((target, direction))
+
+    return out
+
+
+def _random_frame_colors(count: int) -> list[int]:
+    if count <= len(FRAME_COLORS):
+        return random.sample(FRAME_COLORS, count)
+    return [random.choice(FRAME_COLORS) for _ in range(count)]
+
+
+def _build_linear_case() -> tuple[np.ndarray, np.ndarray, dict] | None:
+    direction = random.choice(DIRS)
+    horizontal = direction in {LEFT, RIGHT}
+    active_count = _weighted_active_count()
+    if active_count >= 4:
+        stop_mode = "edge"
+        add_shadow_target = False
+        extra_frames = random.randint(0, 1)
+    elif active_count == 3:
+        stop_mode = random.choice(["edge", "wall"])
+        add_shadow_target = stop_mode == "wall" and random.random() < 0.4
+        extra_frames = random.randint(0, 1)
+    else:
+        stop_mode = random.choice(["edge", "wall"])
+        add_shadow_target = stop_mode == "wall" and random.random() < 0.6
+        extra_frames = random.randint(0, 2)
+
+    height = random.randint(*GEN_SIZE_RANGE)
+    width = random.randint(*GEN_SIZE_RANGE)
+    cross_line = random.randint(4, (height - 5) if horizontal else (width - 5))
+    total_colors = active_count + 1 + extra_frames + int(add_shadow_target)
+    colors = _random_frame_colors(total_colors)
+    color_i = 0
+
+    chain: list[Frame] = []
+    receiver_side = SIDE_FROM_DIR[(-direction[0], -direction[1])]
+    source_side = SIDE_FROM_DIR[direction]
+    axis_span = height if horizontal else width
+
+    for i in range(active_count):
+        side = source_side if i == 0 else receiver_side
+        frame = _sample_axis_frame(cross_line, axis_span, horizontal, side, colors[color_i])
+        color_i += 1
+        if frame is None:
+            return None
+        chain.append(frame)
+
+    stopper_side_choices = [side for side in "UDLR" if side != receiver_side]
+    stopper = _sample_axis_frame(
+        cross_line,
+        axis_span,
+        horizontal,
+        random.choice(stopper_side_choices),
+        colors[color_i],
+    )
+    color_i += 1
+    if stopper is None:
+        return None
+
+    shadow = None
+    if add_shadow_target:
+        shadow = _sample_axis_frame(cross_line, axis_span, horizontal, receiver_side, colors[color_i])
+        color_i += 1
+        if shadow is None:
+            return None
+
+    if horizontal:
+        left_margin = random.randint(*GEN_MARGIN_RANGE)
+        gaps = [random.randint(*GEN_GAP_RANGE) for _ in range(max(0, active_count - 1))]
+        end_gap = random.randint(*GEN_GAP_RANGE)
+        shadow_gap = random.randint(*GEN_GAP_RANGE) if shadow is not None else 0
+        right_tail = random.randint(*GEN_MARGIN_RANGE)
+
+        pieces = [frame.w for frame in chain]
+        total_w = left_margin + sum(pieces) + sum(gaps) + right_tail
+        if stop_mode == "wall":
+            total_w += end_gap + stopper.w
+            if shadow is not None:
+                total_w += shadow_gap + shadow.w
+        if total_w > 30:
+            return None
+
+        frames: list[Frame] = []
+        if direction == RIGHT:
+            cursor = left_margin
+            for i, frame in enumerate(chain):
+                placed = _shift_frame(frame, 0, cursor)
+                frames.append(placed)
+                cursor = placed.c1 + 1
+                if i < len(gaps):
+                    cursor += gaps[i]
+            placed_stopper = None
+            placed_shadow = None
+            if stop_mode == "wall":
+                placed_stopper = _shift_frame(stopper, 0, cursor + end_gap)
+                frames.append(placed_stopper)
+                cursor = placed_stopper.c1 + 1
+                if shadow is not None:
+                    placed_shadow = _shift_frame(shadow, 0, cursor + shadow_gap)
+                    frames.append(placed_shadow)
+        else:
+            cursor = width - right_tail
+            rev_chain: list[Frame] = []
+            rev_gaps = list(reversed(gaps))
+            for i, frame in enumerate(chain):
+                cursor -= frame.w
+                placed = _shift_frame(frame, 0, cursor)
+                rev_chain.append(placed)
+                if i < len(rev_gaps):
+                    cursor -= rev_gaps[i]
+            rev_chain.reverse()
+            frames.extend(rev_chain)
+            placed_stopper = None
+            placed_shadow = None
+            if stop_mode == "wall":
+                cursor = rev_chain[-1].c0
+                stopper_c1 = cursor - end_gap - 1
+                placed_stopper = _shift_frame(stopper, 0, stopper_c1 - stopper.w + 1)
+                frames.append(placed_stopper)
+                if shadow is not None:
+                    shadow_c1 = placed_stopper.c0 - shadow_gap - 1
+                    placed_shadow = _shift_frame(shadow, 0, shadow_c1 - shadow.w + 1)
+                    frames.append(placed_shadow)
+        max_c = max(frame.c1 for frame in frames)
+        min_c = min(frame.c0 for frame in frames)
+        if min_c < 0 or max_c >= width:
+            return None
+    else:
+        top_margin = random.randint(*GEN_MARGIN_RANGE)
+        gaps = [random.randint(*GEN_GAP_RANGE) for _ in range(max(0, active_count - 1))]
+        end_gap = random.randint(*GEN_GAP_RANGE)
+        shadow_gap = random.randint(*GEN_GAP_RANGE) if shadow is not None else 0
+        bottom_tail = random.randint(*GEN_MARGIN_RANGE)
+
+        pieces = [frame.h for frame in chain]
+        total_h = top_margin + sum(pieces) + sum(gaps) + bottom_tail
+        if stop_mode == "wall":
+            total_h += end_gap + stopper.h
+            if shadow is not None:
+                total_h += shadow_gap + shadow.h
+        if total_h > 30:
+            return None
+
+        frames = []
+        if direction == DOWN:
+            cursor = top_margin
+            for i, frame in enumerate(chain):
+                placed = _shift_frame(frame, cursor, 0)
+                frames.append(placed)
+                cursor = placed.r1 + 1
+                if i < len(gaps):
+                    cursor += gaps[i]
+            placed_stopper = None
+            placed_shadow = None
+            if stop_mode == "wall":
+                placed_stopper = _shift_frame(stopper, cursor + end_gap, 0)
+                frames.append(placed_stopper)
+                cursor = placed_stopper.r1 + 1
+                if shadow is not None:
+                    placed_shadow = _shift_frame(shadow, cursor + shadow_gap, 0)
+                    frames.append(placed_shadow)
+        else:
+            cursor = height - bottom_tail
+            rev_chain = []
+            rev_gaps = list(reversed(gaps))
+            for i, frame in enumerate(chain):
+                cursor -= frame.h
+                placed = _shift_frame(frame, cursor, 0)
+                rev_chain.append(placed)
+                if i < len(rev_gaps):
+                    cursor -= rev_gaps[i]
+            rev_chain.reverse()
+            frames.extend(rev_chain)
+            placed_stopper = None
+            placed_shadow = None
+            if stop_mode == "wall":
+                cursor = rev_chain[-1].r0
+                stopper_r1 = cursor - end_gap - 1
+                placed_stopper = _shift_frame(stopper, stopper_r1 - stopper.h + 1, 0)
+                frames.append(placed_stopper)
+                if shadow is not None:
+                    shadow_r1 = placed_stopper.r0 - shadow_gap - 1
+                    placed_shadow = _shift_frame(shadow, shadow_r1 - shadow.h + 1, 0)
+                    frames.append(placed_shadow)
+        max_r = max(frame.r1 for frame in frames)
+        min_r = min(frame.r0 for frame in frames)
+        if min_r < 0 or max_r >= height:
+            return None
+
+    grid = np.full((height, width), BG, dtype=int)
+    reserved = np.zeros((height, width), dtype=bool)
+    for frame in frames:
+        if not (0 <= frame.r0 and frame.r1 < height and 0 <= frame.c0 and frame.c1 < width):
+            return None
+        expanded = np.zeros_like(reserved)
+        _reserve_bbox(expanded, frame.bbox, pad=1)
+        if np.any(expanded & reserved):
+            return None
+        _reserve_bbox(reserved, frame.bbox, pad=1)
+        _paint_frame(grid, frame)
+
+    active_frames = frames[:active_count]
+    source = active_frames[0]
+    ir0, ic0, ir1, ic1 = source.interior_bbox
+    seed_r = random.randint(ir0, ir1)
+    seed_c = random.randint(ic0, ic1)
+    grid[seed_r, seed_c] = RAY
+
+    corridor_mask = np.zeros((height, width), dtype=bool)
+    if horizontal:
+        row = source.opening[0]
+        start = min(frame.opening[1] for frame in active_frames)
+        stop = max(frame.opening[1] for frame in active_frames)
+        corridor_mask[row, start : stop + 1] = True
+        tail_start = stop + 1 if direction == RIGHT else 0
+        tail_stop = width - 1 if direction == RIGHT else start - 1
+        if direction == LEFT:
+            corridor_mask[row, tail_start : start + 1] = True
+        else:
+            corridor_mask[row, stop: width] = True
+    else:
+        col = source.opening[1]
+        start = min(frame.opening[0] for frame in active_frames)
+        stop = max(frame.opening[0] for frame in active_frames)
+        corridor_mask[start : stop + 1, col] = True
+        if direction == UP:
+            corridor_mask[: start + 1, col] = True
+        else:
+            corridor_mask[stop:, col] = True
+
+    distractors: list[Frame] = []
+    for _ in range(extra_frames):
+        placed = None
+        for _ in range(80):
+            side = random.choice(list(DIR_FROM_SIDE))
+            h = random.choice(GEN_FRAME_HEIGHTS)
+            w = random.choice(GEN_FRAME_WIDTHS)
+            if side in {"L", "R"}:
+                offset = random.randint(1, h - 2)
+            else:
+                offset = random.randint(1, w - 2)
+            r0 = random.randint(1, height - h - 1)
+            c0 = random.randint(1, width - w - 1)
+            frame = Frame(r0, c0, h, w, colors[color_i], side, offset)
+            expanded = np.zeros_like(reserved)
+            _reserve_bbox(expanded, frame.bbox, pad=1)
+            if np.any(expanded & reserved):
+                continue
+            footprint = np.zeros_like(reserved)
+            r0e, c0e, r1e, c1e = frame.bbox
+            footprint[r0e : r1e + 1, c0e : c1e + 1] = True
+            if np.any(footprint & corridor_mask):
+                continue
+            placed = frame
+            break
+        if placed is None:
+            return None
+        distractors.append(placed)
+        _reserve_bbox(reserved, placed.bbox, pad=1)
+        _paint_frame(grid, placed)
+        color_i += 1
+
+    all_frames = active_frames + frames[active_count:] + distractors
+    expected = grid.copy()
+    opening_map = {frame.opening: i for i, frame in enumerate(all_frames)}
+    for idx, frame in enumerate(active_frames):
+        _fill_interior(expected, frame, RAY)
+        next_idx = _trace_from_frame(grid, expected, all_frames, opening_map, idx, direction)
+        if idx < active_count - 1:
+            if next_idx != idx + 1:
+                return None
+        else:
+            if stop_mode == "wall" and next_idx is not None and next_idx == active_count:
+                pass
+
+    meta = {
+        "direction": direction,
+        "active_count": active_count,
+        "stop_mode": stop_mode,
+        "shadow": shadow is not None,
+        "frame_count": len(all_frames),
+    }
+    return grid, expected, meta
+
+
+def _generate_case() -> tuple[np.ndarray, np.ndarray, dict]:
+    for _ in range(GEN_MAX_ATTEMPTS):
+        built = _build_linear_case()
+        if built is None:
+            continue
+        grid, expected, meta = built
+        if max(grid.shape) > 30 or max(expected.shape) > 30:
+            continue
+        try:
+            actual = main(grid)
+        except Exception:
+            continue
+        if not np.array_equal(actual, expected):
+            continue
+        return grid, expected, meta
+    raise RuntimeError("failed to generate a valid input")
+
+
+def generate_input() -> np.ndarray:
+    return _generate_case()[0]

diff --git a//home/lixinyu/snap/a/key_combo/code/fable/8/023/1.py b//home/lixinyu/snap/a/key_combo/code/fable/8/023/1.py
new file mode 100644
