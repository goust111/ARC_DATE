+    grid = np.full((height, width), BG, dtype=int)
+    reserved = np.zeros((height, width), dtype=bool)
+    for frame in frames:
+        expanded = np.zeros_like(reserved)
+        _reserve_bbox(expanded, frame.bbox, pad=1)
+        if np.any(expanded & reserved):
