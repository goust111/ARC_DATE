+
+def _parse_frames(grid: np.ndarray, bg: int) -> list[Frame]:
+    comps = find_components(
+        grid,
+        bg=bg,
+        connectivity=4,
+        monochromatic=True,
+        return_format="dict",
+    )
+    frames: list[Frame] = []
+    for comp in comps:
+        color = int(comp["color"])
+        if color in {bg, RAY}:
