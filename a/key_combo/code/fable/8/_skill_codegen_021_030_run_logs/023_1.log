+    active_frames = frames[:active_count]
+    source = active_frames[0]
+    ir0, ic0, ir1, ic1 = source.interior_bbox
+    grid[random.randint(ir0, ir1), random.randint(ic0, ic1)] = RAY
+
+    corridor_mask = np.zeros((height, width), dtype=bool)
+    if horizontal:
