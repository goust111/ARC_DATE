from importlib.machinery import SourceFileLoader
from pathlib import Path
import random
import numpy as np

p = Path('/home/lixinyu/snap/a/key_combo/code/fable/8/022/3.py')
mod = SourceFileLoader('new_arc_task', str(p)).load_module()


def lattice_color(grid, bg):
    vals, counts = np.unique(grid, return_counts=True)
    pairs = sorted([(int(cnt), int(val)) for val, cnt in zip(vals, counts) if int(val) "'!= int(bg)], reverse=True)
    return pairs[0][1]


def frame_bbox(mask):
    coords = np.argwhere(mask)
    r0, c0 = coords.min(axis=0)
    r1, c1 = coords.max(axis=0)
    return int(r0), int(c0), int(r1), int(c1)


def cell_bounds(box, cell_h, cell_w, i, j):
    r0, c0, _r1, _c1 = box
    rs = r0 + 1 + i * (cell_h + 1)
    cs = c0 + 1 + j * (cell_w + 1)
    return rs, cs, rs + cell_h - 1, cs + cell_w - 1


def expected_with_new_color(expected, intact_mask, bg, i, j, new_color):
    out = expected.copy()
    block_rows = slice(i * 3, (i + 1) * 3)
    block_cols = slice(j * 3, (j + 1) * 3)
    block = np.full((3, 3), bg, dtype=int)
    block[intact_mask] = new_color
    out[block_rows, block_cols] = block
    return out

for seed in range(80):
    grid, expected, intact_mask, bg = mod._make_instance(random.Random(seed))
    actual = mod.main(grid)
    assert np.array_equal(actual, expected)
    assert grid.ndim == 2 and actual.ndim == 2
    assert max(grid.shape) <= 30 and max(actual.shape) <= 30

    lattice = lattice_color(grid, bg)
    box = frame_bbox(grid == lattice)
    r0, c0, r1, c1 = box
    cell_h = (r1 - r0 + 1 - 4) // 3
    cell_w = (c1 - c0 + 1 - 4) // 3

    changed_broken = False
    broken_variant = grid.copy()
    for i in range(3):
        for j in range(3):
            rs, cs, re, ce = cell_bounds(box, cell_h, cell_w, i, j)
            interior = broken_variant[rs:re + 1, cs:ce + 1]
            if intact_mask[i, j]:
                continue
            pts = np.argwhere((interior != bg) & (interior != lattice))
            for dr, dc in pts:
                old = int(interior[dr, dc])
                choices = [c for c in range(10) if c not in {bg, lattice, old}]
                interior[dr, dc] = choices[(seed + int(dr) + int(dc)) % len(choices)]
                changed_broken = True
    assert changed_broken
    assert np.array_equal(mod.main(broken_variant), expected)

    intact_cells = [(i, j) for i in range(3) for j in range(3) if intact_mask[i, j]]
    i, j = intact_cells[seed % len(intact_cells)]
    rs, cs, re, ce = cell_bounds(box, cell_h, cell_w, i, j)
    variant = grid.copy()
    interior = variant[rs:re + 1, cs:ce + 1]
    pts = np.argwhere((interior != bg) & (interior != lattice))
    assert pts.shape[0] == 1
    dr, dc = map(int, pts[0])
    old = int(interior[dr, dc])
    new_color = [c for c in range(10) if c not in {bg, lattice, old}][0]
    interior[dr, dc] = new_color
    expected2 = expected_with_new_color(expected, intact_mask, bg, i, j, new_color)
    assert np.array_equal(mod.main(variant), expected2)

print('"'semantic checks passed')
