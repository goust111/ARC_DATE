+    width = GRID_CELLS * cell_w + GRID_CELLS + 1
+    bottom = top + height - 1
+    right = left + width - 1
+
+    row_lines = [top + k * (cell_h + 1) for k in range(GRID_CELLS + 1)]
+    col_lines = [left + k * (cell_w + 1) for k in range(GRID_CELLS + 1)]
+    for rr in row_lines:
+        grid[rr, left : right + 1] = lattice
+    for cc in col_lines:
