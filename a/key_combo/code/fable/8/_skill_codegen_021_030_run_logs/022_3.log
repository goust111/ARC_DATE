+
+def _open_wall(
+    grid: np.ndarray,
+    top: int,
+    left: int,
+    cell_h: int,
+    cell_w: int,
+    a: tuple[int, int],
+    b: tuple[int, int],
+    bg: int,
+    rng: random.Random,
+) -> None:
+    (r1, c1), (r2, c2) = a, b
