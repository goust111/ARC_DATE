+
+
+def _place_singletons(
+    grid: np.ndarray,
+    frame_bbox: tuple[int, int, int, int],
+    cell_h: int,
+    cell_w: int,
+    intact_mask: np.ndarray,
+    colors: np.ndarray,
+    rng: random.Random,
+) -> None:
+    for i in range(GRID_CELLS):
