+        wall_r = top + (min(r1, r2) + 1) * (cell_h + 1)
+        gap_len = rng.randint(1, max(1, min(3, cell_w)))
+        offset = rng.randint(0, cell_w - gap_len)
+        grid[wall_r, col0 + offset : col0 + offset + gap_len] = bg
+
