+    mapping: dict[int, int] = {}
+    for src in colors_present(left, exclude={bg}):
+        vals = np.unique(right[left == src])
+        vals = [int(v) for v in vals if int(v) != bg]
+        assert len(vals) == 1, "each source color must map consistently"
