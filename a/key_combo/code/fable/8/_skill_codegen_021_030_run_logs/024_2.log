_GEN_GRID_ROWS, _GEN_GRID_COLS, _GEN_COLOR_COUNTS = (3, 9), (3, 8), [3, 4]

# Foreground density and background dominance.
_GEN_PERCENT, _GEN_MIN_FG_CELLS = 100, 5
