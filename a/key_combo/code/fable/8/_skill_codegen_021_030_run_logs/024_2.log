+    queue = deque([next(iter(coords))])
+    seen.add(queue[0])
+    while queue:
+        r, c = queue.popleft()
+        for nr, nc in neighbors4(r, c):
+            p = (int(nr), int(nc))
+            if p in coords and p not in seen:
+                seen.add(p)
+                queue.append(p)
+    return seen == coords
