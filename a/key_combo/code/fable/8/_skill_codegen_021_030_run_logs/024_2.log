+        return None
+    return sprite
+
+
+def _sample_shift(panel_w: int, sprite_w: int) -> int | None:
+    max_step = min(3, (panel_w - sprite_w) // PANEL_COUNT)
+    if max_step < 1:
+        return None
+    step = random.randint(1, max_step)
