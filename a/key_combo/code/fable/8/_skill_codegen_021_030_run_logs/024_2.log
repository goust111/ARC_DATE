+    max_area = min(bbox_h * bbox_w, 12)
+    if max_area < 8:
+        return None
+    area = random.randint(8, max_area)
+    shape = _random_connected_shape(bbox_h, bbox_w, area)
+    if shape is None or not _coords_connected(shape):
+        return None
