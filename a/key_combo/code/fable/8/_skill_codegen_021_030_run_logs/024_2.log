+    gaps = [b - a for a, b in zip(sep_rows, sep_rows[1:])]
+    assert len(set(gaps)) == 1, "separator rows must be equally spaced"
+    panel_h = gaps[0] - 1
+    assert panel_h >= 1, "panel height must be positive"
