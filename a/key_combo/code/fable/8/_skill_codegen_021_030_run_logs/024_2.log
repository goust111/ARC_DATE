+        cells.add(random.choice(frontier))
+    return _normalize_cells(cells)
+
+
+def _make_sprite(panel_h: int, panel_w: int) -> dict[tuple[int, int], int] | None:
+    bbox_h = random.randint(2, min(panel_h, 4))
