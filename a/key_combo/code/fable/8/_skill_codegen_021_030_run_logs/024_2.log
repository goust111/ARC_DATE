+        counts = [random.choice((0, 1, 2)) for _ in range(PANEL_COUNT)]
+        counts[-1] = random.choice((1, 2))
+        if 0 not in counts:
+            counts[random.randrange(PANEL_COUNT - 1)] = 0
+        if 2 not in counts:
+            counts[random.randrange(PANEL_COUNT)] = 2
