+
+
+def _assemble_input(panels: list[np.ndarray], sep_color: int) -> np.ndarray:
+    panel_h, panel_w = map(int, panels[0].shape)
+    grid = np.zeros((PANEL_COUNT * panel_h + SEPARATOR_COUNT, panel_w), dtype=int)
