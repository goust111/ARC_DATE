+
+
+def _apply_noise(
+    clean_panel: np.ndarray,
+    sprite_abs: dict[tuple[int, int], int],
+    rel_corruptions: list[tuple[int, int]],
+    wrong_palette: list[int],
+) -> tuple[np.ndarray, list[str]]:
