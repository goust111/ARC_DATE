                            break
                    if not ok:
                        break
                if ok:
                    options.append((shape, r0, c0))
    return options


def _gen_paste_shape(grid, shape, r0, c0, color):
    h, w = _gen_shape_size(shape)
    patch = np.zeros((h, w), dtype=int)
    patch[shape[:, 0], shape[:, 1]] = int(color)
    paste(grid, patch, int(r0), int(c0), transparent=0)

