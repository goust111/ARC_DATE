+
+def _segments(length: int, separators: list[int]) -> list[tuple[int, int]]:
+    parts: list[tuple[int, int]] = []
+    start = 0
+    for idx in separators + [length]:
+        if idx > start:
+            parts.append((start, idx))
+        start = idx + 1
+    return parts
