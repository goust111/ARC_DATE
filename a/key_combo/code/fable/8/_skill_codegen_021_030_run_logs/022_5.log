+    block_ws = {c1 - c0 for c0, c1 in col_parts}
+    assert len(block_hs) == 1 and len(block_ws) == 1, "blocks must have equal size"
+    block_h = next(iter(block_hs))
+    block_w = next(iter(block_ws))
