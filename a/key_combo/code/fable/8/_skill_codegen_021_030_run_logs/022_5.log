+def _apply_transform(tile: np.ndarray, transform_id: int) -> np.ndarray:
+    transform_id = int(transform_id)
+    if transform_id == 0:
+        return tile.copy()
+    if transform_id == 1:
+        return np.fliplr(tile)
+    if transform_id == 2:
+        return np.flipud(tile)
+    if transform_id == 3:
