+    counts = np.stack([(aligned == color).sum(axis=0) for color in colors], axis=0)
+    best_idx = counts.argmax(axis=0)
+    consensus = colors[best_idx].astype(int)
+    score = int(counts.max(axis=0).sum())
+    return consensus, score
