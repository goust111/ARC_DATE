+            "damaged_index": int(winner["damaged_index"]),
+            "assignment": tuple(int(x) for x in winner["assignment"]),
+            "consensus": winner["consensus"].copy(),
+            "repaired_mask": winner["repaired_mask"].copy(),
+            "blocks": [block.copy() for block in blocks],
