+    for i, (r, c) in enumerate(selected):
+        if i < color_count:
+            pattern[r, c] = fg_colors[i]
+        else:
+            pattern[r, c] = fg_colors[int(rng.integers(color_count))]
+
+    if np.count_nonzero(pattern != bg) != fg_total:
+        return None
+    if len({int(x) for x in pattern.ravel()}) < 3:
