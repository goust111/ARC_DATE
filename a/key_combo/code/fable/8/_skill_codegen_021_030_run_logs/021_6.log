+                if (nr - nc) in used_diagonals:
+                    continue
+                future_degree = 0
+                for fdr, fdc in PATH_STEPS:
+                    rr, cc = nr + fdr, nc + fdc
+                    if not (0 <= rr < TEMP_PATH_SIZE and 0 <= cc < TEMP_PATH_SIZE):
+                        continue
+                    if (rr, cc) in used_cells or (rr - cc) in used_diagonals:
+                        continue
+                    future_degree += 1
