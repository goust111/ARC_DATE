+        interior = out[ir0 : ir1 + 1, ic0 : ic1 + 1]
+        painted = interior[interior != BACKGROUND]
+        if painted.size < 4:
+            continue
+        if painted.size >= interior.size:
+            continue
+        if len(set(map(int, painted.tolist()))) < 2:
+            continue
+        hit_diagonals = 0
+        miss_diagonals = 0
+        for r, c, _color in motif_cells:
+            hit = False
+            for k in range(0, max(height, width)):
+                rr = r + k
+                cc = c + k
+                if rr > ir1 or cc > ic1:
+                    break
+                if ir0 <= rr <= ir1 and ic0 <= cc <= ic1:
+                    hit = True
+                    break
+            if hit:
+                hit_diagonals += 1
+            else:
+                miss_diagonals += 1
+        if hit_diagonals < 2:
+            continue
+        if miss_diagonals < 1:
+            continue
+        return spec
+    return None
+
+
+def generate_input() -> np.ndarray:
+    global _LAST_SPEC
+    rng = random.Random()
+    for _ in range(GENERATION_RETRIES):
+        spec = _sample_spec(rng)
+        if spec is None:
