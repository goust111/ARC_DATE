+def _frame_border_cells(frame_bbox: tuple[int, int, int, int]) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = map(int, frame_bbox)
+    cells = []
+    for c in range(c0, c1 + 1):
+        cells.append((r0, c))
+        cells.append((r1, c))
+    for r in range(r0 + 1, r1):
+        cells.append((r, c0))
+        cells.append((r, c1))
+    return cells
