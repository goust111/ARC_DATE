+import random
+from collections import Counter
+
+import numpy as np
+
+
+BACKGROUND = 0
+ALL_FOREGROUND_COLORS = list(range(1, 10))
+GENERATION_RETRIES = 500
+PATH_ATTEMPTS = 200
+LAYOUT_ATTEMPTS = 200
+TEMP_PATH_SIZE = 9
+PATH_STEPS = [(-1, 0), (1, 0), (0, -1), (0, 1), (-1, 1), (1, -1)]
+_LAST_SPEC = None
+
+
+def get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, np.asarray(grid).flatten())).most_common(1)[0][0])
+
+
+def neighbors(r: int, c: int, connectivity: int) -> list[tuple[int, int]]:
+    if int(connectivity) == 4:
+        return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+    return [
+        (r - 1, c - 1),
+        (r - 1, c),
+        (r - 1, c + 1),
+        (r, c - 1),
+        (r, c + 1),
+        (r + 1, c - 1),
+        (r + 1, c),
+        (r + 1, c + 1),
+    ]
+
+
+def bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def crop_bbox(grid: np.ndarray, bbox: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = map(int, bbox)
+    return np.asarray(grid)[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def find_components(
+    grid: np.ndarray,
+    *,
+    bg: int | None = None,
+    connectivity: int = 4,
+    monochromatic: bool = True,
+) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    if bg is None:
+        bg = get_bg(g)
+    bg = int(bg)
+    h, w = g.shape
+    dirs = neighbors(0, 0, connectivity)
+    out: list[dict] = []
+
+    if monochromatic:
+        for color in sorted(set(map(int, g.flatten())) - {bg}):
+            seen = np.zeros((h, w), dtype=bool)
+            for r in range(h):
+                for c in range(w):
+                    if seen[r, c] or int(g[r, c]) != color:
+                        continue
+                    stack = [(r, c)]
+                    seen[r, c] = True
+                    coords = []
+                    while stack:
+                        rr, cc = stack.pop()
+                        coords.append((rr, cc))
+                        for dr, dc in dirs:
+                            nr, nc = rr + dr, cc + dc
+                            if not (0 <= nr < h and 0 <= nc < w):
+                                continue
+                            if seen[nr, nc] or int(g[nr, nc]) != color:
+                                continue
+                            seen[nr, nc] = True
+                            stack.append((nr, nc))
+                    arr = np.array(coords, dtype=int)
+                    out.append(
+                        {
+                            "color": int(color),
+                            "coords": arr,
+                            "bbox": bbox_coords(arr),
+                            "area": int(arr.shape[0]),
+                        }
+                    )
+        return out
+
+    seen = np.zeros((h, w), dtype=bool)
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(g[r, c]) == bg:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in dirs:
+                    nr, nc = rr + dr, cc + dc
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if seen[nr, nc] or int(g[nr, nc]) == bg:
+                        continue
+                    seen[nr, nc] = True
+                    stack.append((nr, nc))
+            arr = np.array(coords, dtype=int)
+            out.append({"color": None, "coords": arr, "bbox": bbox_coords(arr), "area": int(arr.shape[0])})
+    return out
+
