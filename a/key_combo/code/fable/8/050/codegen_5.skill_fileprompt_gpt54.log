   9: def main(grid: np.ndarray) -> np.ndarray:
  10:     """
  11:     Count the two upper quadrant control regions to size an output made from the lower quadrant pattern.
  12: 
  13:     Input structure:
  14:     - The grid is an even square split into four equal quadrants.
  15:     - Black is the background.
  16:     - The upper-left and upper-right quadrants are control regions.
  17:     - The lower-left quadrant is a color source tile; the lower-right quadrant is either a stencil tile or empty.
  18: 
  19:     Rule:
  20:     - Output height is the number of non-background pixels in the upper-left quadrant.
  21:     - Output width is the number of non-background pixels in the upper-right quadrant.
  22:     - If the lower-right stencil has foreground pixels, tile it over the output; each stencil background pixel is filled from the lower-left quadrant cell at the corresponding coarse tile position.
  23:     - If the lower-right stencil is empty, tile the lower-left quadrant directly over the output.
  24: 
  25:     Key insight:
  26:     - The top quadrants specify only dimensions, while the bottom quadrants specify a two-level repeated pattern: a fine stencil and coarse fill colors.
  27:     """
  28:     g = np.asarray(grid, dtype=int)
  29:     assert g.ndim == 2
  30:     h, w = g.shape
  31:     assert h == w and h % 2 == 0 and w % 2 == 0
  32: 
  33:     bg = int(Color.BLACK)
  34:     qh, qw = h // 2, w // 2
  35:     upper_left = g[:qh, :qw]
  36:     upper_right = g[:qh, qw:]
  37:     fill_tile = g[qh:, :qw]
  38:     stencil = g[qh:, qw:]
  39: 
  40:     out_h = int(np.count_nonzero(upper_left != bg))
  41:     out_w = int(np.count_nonzero(upper_right != bg))
  42:     assert out_h > 0 and out_w > 0
  43: 
  44:     out = np.empty((out_h, out_w), dtype=int)
  45:     if not np.any(stencil != bg):
  46:         for r in range(out_h):
  47:             for c in range(out_w):
  48:                 value = int(fill_tile[r % qh, c % qw])
  49:                 assert value != bg
  50:                 out[r, c] = value
  51:         return out
  52: 
  53:     for r in range(out_h):
  54:         for c in range(out_w):
  55:             value = int(stencil[r % qh, c % qw])
  56:             if value == bg:
  57:                 fill_r = r // qh
  58:                 fill_c = c // qw
  59:                 assert fill_r < qh and fill_c < qw
  60:                 value = int(fill_tile[fill_r, fill_c])
  61:                 assert value != bg
  62:             out[r, c] = value
