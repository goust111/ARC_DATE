+
+        moved_fast, info_fast = _simulate_segments(inp.shape[1], pusher_len, segments)
+        moved_step, info_step = _step_oracle(inp.shape[1], pusher_len, segments)
+        fast_row = _render_row(inp.shape[1], pusher_len, moved_fast)
