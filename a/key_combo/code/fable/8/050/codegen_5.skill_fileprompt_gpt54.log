+            gap = next_start - seg["end"] - 1
+            assert gap >= 1, "sliders must be strictly separated in the input"
+            if momentum > gap:
+                seg["start"] += gap
+                seg["end"] += gap
+                info["moved_distances"][current] += gap
+                momentum -= gap
+                info["transfers"] += 1
+                current += 1
+                continue
+
+            seg["start"] += momentum
+            seg["end"] += momentum
+            info["moved_distances"][current] += momentum
+            if momentum == gap:
