+SLIDER_COLORS = [1, 3, 4, 5, 6, 7, 8, 9]
+
+MIN_WIDTH = 22
+MAX_WIDTH = 30
+MIN_ACTIVE_ROWS = 4
+MAX_ACTIVE_ROWS = 6
+MAX_GENERATION_ATTEMPTS = 400
