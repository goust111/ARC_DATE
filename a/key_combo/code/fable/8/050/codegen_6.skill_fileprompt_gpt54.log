+def _extract_keys(
+    grid: np.ndarray, bg: int
+) -> tuple[dict[int, tuple[str, int]], dict[int, tuple[str, int]]]:
+    h, w = grid.shape
+    row_keys: dict[int, tuple[str, int]] = {}
+    col_keys: dict[int, tuple[str, int]] = {}
+
+    edge_mask = np.zeros_like(grid, dtype=bool)
+    edge_mask[0, :] = True
+    edge_mask[-1, :] = True
+    edge_mask[:, 0] = True
+    edge_mask[:, -1] = True
