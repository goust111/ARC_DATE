+    for r_raw, c_raw in np.argwhere(g == PLACEHOLDER):
+        r = int(r_raw)
+        c = int(c_raw)
+        stats["grey"] += 1
+        row_key = row_keys.get(r)
+        col_key = col_keys.get(c)
+        assert row_key or col_key
+        if row_key and not col_key:
+            stats["row_only"] += 1
+            continue
+        if col_key and not row_key:
+            stats["col_only"] += 1
