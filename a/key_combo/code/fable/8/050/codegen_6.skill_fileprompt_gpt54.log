+
+
+def _build_mask(
+    h: int,
+    w: int,
+    core_rows: list[int],
+    core_cols: list[int],
+    row_ext_cols: list[int],
+    row_ext_rows: list[int],
+    col_ext_rows: list[int],
+    col_ext_cols: list[int],
+    tie_cell: tuple[int, int],
