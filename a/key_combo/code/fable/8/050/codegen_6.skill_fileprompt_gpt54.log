+        assert row_key is not None and col_key is not None
+        stats["both"] += 1
+        row_d = _row_distance(row_key[0], c, w)
+        col_d = _col_distance(col_key[0], r, h)
+        if row_d < col_d:
+            stats["row_win"] += 1
+        elif col_d < row_d:
+            stats["col_win"] += 1
+        else:
+            stats["tie"] += 1
