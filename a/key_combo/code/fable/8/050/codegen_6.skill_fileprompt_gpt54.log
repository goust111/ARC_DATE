+        if int(grid[r, w - 1]) not in (bg, PLACEHOLDER):
+            found.append(("right", int(grid[r, w - 1])))
+        assert len(found) <= 1, "a row may have at most one edge key"
+        if found:
+            row_keys[r] = found[0]
+
+    for c in range(w):
+        found = []
+        if int(grid[0, c]) not in (bg, PLACEHOLDER):
