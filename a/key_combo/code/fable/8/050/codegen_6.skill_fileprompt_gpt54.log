+        "grey": 0,
+        "row_only": 0,
+        "col_only": 0,
+        "both": 0,
+        "row_win": 0,
+        "col_win": 0,
+        "tie": 0,
+        "left_rows": 0,
+        "right_rows": 0,
+        "top_cols": 0,
+        "bottom_cols": 0,
