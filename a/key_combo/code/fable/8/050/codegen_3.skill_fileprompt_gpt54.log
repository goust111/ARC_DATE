+    parsed_glyphs = {
+        (r, c): tuple(cells[r, c]["instr"])
+        for r in range(cells.shape[0])
+        for c in range(cells.shape[1])
+        if cells[r, c]["kind"] == "glyph" and cells[r, c]["color"] == CYAN
