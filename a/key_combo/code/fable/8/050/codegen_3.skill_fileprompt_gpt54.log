+
+
+def _paint_cell(out: np.ndarray, row_spans: list[tuple[int, int]], col_spans: list[tuple[int, int]], r: int, c: int, color: int) -> None:
+    r0, r1 = row_spans[r]
+    c0, c1 = col_spans[c]
