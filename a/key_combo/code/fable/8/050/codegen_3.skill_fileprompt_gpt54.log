def _gen_spaced_positions(_gen_limit: int, _gen_count: int, _gen_min_gap: int) -> list[int]:
    _gen_options = [
        _gen_combo
        for _gen_combo in itertools.combinations(
            range(_GEN_BORDER_CLEARANCE, _gen_limit - _GEN_BORDER_CLEARANCE),
