+        patch = _make_glyph_patch(cell_size, direction, step, CYAN)
+        r0 = pos[0] * (cell_size + 1)
+        c0 = pos[1] * (cell_size + 1)
+        grid[r0 : r0 + cell_size, c0 : c0 + cell_size] = patch
+
