+def _render_abstract(
+    n_cells: int,
+    cell_size: int,
+    positions: list[tuple[int, int]],
+    instrs: list[tuple[tuple[int, int], int]],
+    decoys: dict[tuple[int, int], tuple[tuple[int, int], int]],
