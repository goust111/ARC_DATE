    return placements


def _gen_far_enough(
    region: set[tuple[int, int]],
    used: set[tuple[int, int]],
    gap: int = GEN_MIN_REGION_GAP,
) -> bool:
    for r1, c1 in region:
        for r2, c2 in used:
