+def _groups(indices: list[int]) -> list[tuple[int, int]]:
+    assert indices, "expected separator lines"
+    spans: list[tuple[int, int]] = []
+    start = prev = int(indices[0])
+    for idx in indices[1:]:
+        idx = int(idx)
+        if idx == prev + 1:
+            prev = idx
+        else:
+            spans.append((start, prev))
+            start = prev = idx
+    spans.append((start, prev))
+    return spans
