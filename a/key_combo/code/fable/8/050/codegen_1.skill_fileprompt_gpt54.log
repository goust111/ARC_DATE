+    cells = np.full((n, n), bg, dtype=int)
+    for _source, target, color in instructions:
+        tr, tc = target
+        prev = int(cells[tr, tc])
+        assert prev in (bg, color), "two instructions cannot assign different colors to one target"
+        cells[tr, tc] = color
+    return cells
+
