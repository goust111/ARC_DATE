+GEN_ATTEMPTS = 500
+N_RANGE = (3, 5)
+BG = 0
+NON_BG_COLORS = list(range(1, 10))
+
+
+def _cell_origin(n: int, cell: Cell) -> tuple[int, int]:
+    r, c = cell
+    return r * (n + 1), c * (n + 1)
+
+
+def _empty_lattice(n: int, separator: int, fill: int) -> np.ndarray:
+    side = n * n + (n - 1)
+    grid = np.full((side, side), separator, dtype=int)
+    for r in range(n):
+        for c in range(n):
