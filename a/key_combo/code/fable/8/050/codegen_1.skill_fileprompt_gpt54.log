+    col_colors = {
+        int(grid[0, c])
+        for c in range(grid.shape[1])
+        if np.all(grid[:, c] == grid[0, c])
+    }
+    candidates = row_colors & col_colors
+    assert len(candidates) == 1, "expected one separator color"
+    return candidates.pop()
