+def _gen_shape(panel_shape: tuple[int, int], head: tuple[int, int], tail: tuple[int, int],
+               rng: random.Random) -> np.ndarray | None:
+    H, W = panel_shape
+    anchor_cells = {tuple(map(int, head)), tuple(map(int, tail))}
+    boxes = []
