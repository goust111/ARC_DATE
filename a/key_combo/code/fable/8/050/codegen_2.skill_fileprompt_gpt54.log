+        upper_tail,
+        upper_fg,
+        lower_head,
+        lower_fg,
+        aligned_lower,
+        k,
+        want_overlap,
+    ):
+        return None
+
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    global _GEN_CALLS
+    call_index = _GEN_CALLS
