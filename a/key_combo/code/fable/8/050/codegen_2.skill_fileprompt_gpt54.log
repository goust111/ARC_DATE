+        if (not want_overlap) and overlap:
+            continue
+        if len({tuple(map(int, rc)) for rc in upper_fg} - overlap) < 2:
+            continue
+        if len({tuple(map(int, rc)) for rc in candidate} - overlap) < 2:
+            continue
+        aligned_lower = candidate.astype(int)
+        break
