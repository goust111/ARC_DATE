+    return True
+
+
+def _gen_attempt(rng: random.Random, call_index: int) -> np.ndarray | None:
+    H = rng.randint(*PANEL_HEIGHT_RANGE)
+    W = rng.randint(*PANEL_WIDTH_RANGE)
