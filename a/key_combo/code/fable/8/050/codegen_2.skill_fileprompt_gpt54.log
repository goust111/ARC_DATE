+    transformed = _rotate_rel(lower_rel, k) + upper_head
+    h, w = upper.shape
+    assert np.all((0 <= transformed[:, 0]) & (transformed[:, 0] < h))
+    assert np.all((0 <= transformed[:, 1]) & (transformed[:, 1] < w))
