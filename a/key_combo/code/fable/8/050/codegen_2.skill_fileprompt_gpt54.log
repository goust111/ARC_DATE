+def _bbox_min_anchor_distance(r0: int, c0: int, bh: int, bw: int,
+                              anchor_cells: set[tuple[int, int]]) -> int:
+    best = 10 ** 9
+    for rr in range(r0, r0 + bh):
+        for cc in range(c0, c0 + bw):
+            for ar, ac in anchor_cells:
+                best = min(best, abs(rr - ar) + abs(cc - ac))
+    return int(best)
+
