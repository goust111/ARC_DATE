+        hi = min(SHAPE_AREA_RANGE[1], bh * bw - 1 if bh * bw > 4 else bh * bw)
+        if lo > hi:
+            continue
+        area = rng.randint(lo, hi)
+        local = _build_connected_mask(bh, bw, area, rng)
+        if local is None:
