+    aligned_lower_rel = aligned_lower - upper_head
+    inv_k = (-k) % 4
+    lower_input_rel = _rotate_rel(aligned_lower_rel, inv_k)
+    lower_tail_rel = _rotate_rel((upper_tail - upper_head)[None, :], inv_k)[0]
