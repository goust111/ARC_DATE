+
+
+def _topological_order(bar_ids: list[str], edges: dict[str, set[str]]) -> list[str]:
+    remaining = set(bar_ids)
+    indeg = {bar_id: 0 for bar_id in bar_ids}
+    for src in bar_ids:
+        for dst in edges[src]:
+            if dst in remaining:
+                indeg[dst] += 1
