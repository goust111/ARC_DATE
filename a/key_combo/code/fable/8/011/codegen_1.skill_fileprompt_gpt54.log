+    while frontier:
+        current = frontier.pop(0)
+        if current not in remaining:
+            continue
+        remaining.remove(current)
+        order.append(current)
+        for dst in sorted(edges[current]):
+            if dst in remaining:
+                indeg[dst] -= 1
