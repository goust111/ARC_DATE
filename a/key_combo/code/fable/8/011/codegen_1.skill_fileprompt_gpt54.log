+            top = support - height
+            if top < 0:
+                continue
+            for seg0, seg1 in segments:
+                seg_width = seg1 - seg0 + 1
+                for width in range(1, min(3, seg_width) + 1):
+                    for left in range(seg0, seg1 - width + 2):
+                        right = left + width - 1
+                        if any(not (right + 1 < u0 or left - 1 > u1) for u0, u1 in used_ranges):
+                            continue
