        first.append(H - 1 if h == H else max(0, h - 1))
    return np.array(first, dtype=int)


def _pocket_count(heights):
    min_h = min(heights)
    count = 0
    in_run = False
    for h in heights:
        if h > min_h:
            if not in_run:
                count += 1
                in_run = True
        else:
            in_run = False

