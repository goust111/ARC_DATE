+
+
+def _rotated_pair() -> tuple[np.ndarray, np.ndarray]:
+    shape, specs = _canonical_specs()
+    inp, out = _render_canonical_pair(shape, specs)
+    k = random.randint(0, 3)
+    return np.rot90(inp, k=k), np.rot90(out, k=k)
