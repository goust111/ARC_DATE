+
+_DIR_RIGHT = "right"
+_DIR_DOWN = "down"
+_DIR_LEFT = "left"
+_DIR_UP = "up"
+_DIRECTIONS = (_DIR_RIGHT, _DIR_DOWN, _DIR_LEFT, _DIR_UP)
