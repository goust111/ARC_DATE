+        if max(inp.shape) > 30 or max(expected.shape) > 30:
+            continue
+        try:
+            actual = main(inp)
+        except AssertionError:
+            continue
+        if np.array_equal(actual, expected):
+            return inp
+    raise RuntimeError(f"failed to generate valid input after {_GEN_RETRIES} attempts")

