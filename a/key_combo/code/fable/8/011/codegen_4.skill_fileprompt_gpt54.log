11:# In the input you will see a red object overlaid on a track of green dots.
12:# To make the output, move the red object one green dot to the right (if the track is horizontal) or one green dot down (if the track is vertical).
13:
14:def main(input_grid):
15:    """
16:    Move the red object forward one slot along the green-dot track.
17:
18:    Input structure:
19:    - A red object overlaps one position on a straight track of green dots.
20:    - The green dots are evenly spaced in a row or column.
21:    - The background is black.
22:
23:    Rule:
24:    - Detect the red object and all green dot objects.
25:    - Determine the track direction from the green dot centers.
26:    - Redraw the green dots, then translate the red object along the track to the next non-colliding slot.
27:
28:    Key insight:
29:    - The green dots are discrete alignment slots, and the first collision-free translation
30:      places the red object one step forward on that track.
31:    """
32:    # Plan:
33:    # 1. Detect the objects
34:    # 2. Determine the orientation of the track of green dots
35:    # 3. Move in the appropriate direction until it perfectly fits over the next green dot, meaning there are no collisions
36:
37:    objects = find_components(input_grid, bg=Color.BLACK, connectivity=8, monochromatic=True, return_format="objects")
38:
39:    red_objects = [ obj for obj in objects if Color.RED in colors_present(obj, exclude={ Color.BLACK }) ]
40:    green_objects = [ obj for obj in objects if Color.GREEN in colors_present(obj, exclude={ Color.BLACK }) ]
41:
42:    assert len(red_objects) == 1, "There should be exactly one red object"
43:    assert len(green_objects) >= 1, "There should be at least one green object"
44:
45:    red_object = red_objects[0]
46:
47:    # Determine the orientation of the track of green dots by comparing the positions of two dots
48:    x1, y1 = min(bbox_anchor(bbox(obj != Color.BLACK), anchor="center") for obj in green_objects)
49:    x2, y2 = max(bbox_anchor(bbox(obj != Color.BLACK), anchor="center") for obj in green_objects)
50:    if x1 == x2:
51:        # vertical track
52:        dr, dc = 0, 1
53:    elif y1 == y2:
54:        # horizontal track
55:        dr, dc = 1, 0
56:    
57:    # Make the output grid: Start with all the greens, then put the red in the right spot by moving it one-by-one
58:    output_grid = np.full_like(input_grid, Color.BLACK)
59:    for green_object in green_objects:
60:        paste(output_grid, green_object, 0, 0, transparent=Color.BLACK, clip=True)
61:
62:    for distance in range(1, 100):
63:        translated_red_object = translate(red_object, dr*distance, dc*distance)
64:        if not collision(object1=translated_red_object, object2=output_grid):
65:            paste(output_grid, translated_red_object, 0, 0, transparent=Color.BLACK, clip=True)
66:            break
67:
68:    return output_grid
