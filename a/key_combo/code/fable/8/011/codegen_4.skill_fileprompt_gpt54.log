+import numpy as np
+
+
+PRODUCTIVE_BRANCHES = ((1, 1), (1, 2), (2, 1), (2, 2))
+VANISH_BRANCHES = ((0, 1), (1, 0), (0, 2), (2, 0))
+ALL_BRANCHES = PRODUCTIVE_BRANCHES + VANISH_BRANCHES
+MAX_GENERATION_ATTEMPTS = 400
