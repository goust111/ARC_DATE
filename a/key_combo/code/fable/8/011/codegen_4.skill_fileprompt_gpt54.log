+    bottom_header = g[-1, :-1]
+
+    out = g.copy()
+    out[:-1, :-1] = bg
+
+    for r, c in np.argwhere(interior != bg):
+        color = int(interior[r, c])
+        rows = np.flatnonzero(right_header == color)
+        cols = np.flatnonzero(bottom_header == color)
+        if rows.size and cols.size:
