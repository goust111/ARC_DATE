+    colors = sorted(set(map(int, grid.ravel())) - {BG, terrain_color})
+    blocks: list[Block] = []
+    for color in colors:
+        for coords in _components_of_color(grid, color):
+            row, col, mask = _mask_from_coords(coords)
+            cells = np.argwhere(mask)
+            blocks.append(
