+    gaps = [random.randint(*STACK_GAP_RANGE) for _ in range(max(0, chain_len - 1))]
+    stack_height = sum(mask.shape[0] for mask in chain_masks) + sum(gaps)
+    max_stack_top = min(profiles[-1]) - stack_height - 1
