                cur_r0 = coords[:,0].min(); cur_c0 = coords[:,1].min()
                for br, bc in b['bottoms']:
                    rr = cur_r0 + br + d
                    cc = cur_c0 + bc
                    if rr == H-1:
                        continue
                    if not support[rr+1, cc]:
                        ok=False; break
                if ok:
                    d_found=d; break
            if d_found is not None:
                moves.append((idx,d_found,int(coords[:,0].min()),int(coords[:,1].min())))
        if not moves:
            break
        if len(moves)"'!=1:
            return None, moves, out
        idx,d,cur_r0,cur_c0=moves[0]
        mask=blocks[idx]['"'mask']
        color=blocks[idx]['color']
        coords=np.argwhere(mask)
        out[cur_r0+coords[:,0], cur_c0+coords[:,1]] = bg
        out[cur_r0+d+coords[:,0], cur_c0+coords[:,1]] = color
        support[cur_r0+d+coords[:,0], cur_c0+coords[:,1]] = True
        moved.append(idx)
        remaining.remove(idx)
    return moved, [], out


def build_mask(prev, nxt):
    top = min(nxt)
    h = max(prev)-top
    w = len(prev)
    m = np.zeros((h,w), dtype=bool)
    for j in range(w):
        m[nxt[j]-top:prev[j]-top, j] = True
    return m


def connected(mask):
    pts=np.argwhere(mask)
    seen={tuple(pts[0])}
    q=deque([tuple(pts[0])])
    S=set(map(tuple,pts))
    while q:
        r,c=q.popleft()
        for nb in ((r-1,c),(r+1,c),(r,c-1),(r,c+1)):
            if nb in S and nb not in seen:
                seen.add(nb); q.append(nb)
    return len(seen)==len(pts)


