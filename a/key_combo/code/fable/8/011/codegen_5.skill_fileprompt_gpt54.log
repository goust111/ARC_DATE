    return bg, terrain_color, blocks


def settle_trace(grid):
    bg, terrain_color, blocks = parse_blocks(grid)
    out = grid.copy()
    H,W = out.shape
    support = out == terrain_color
    remaining = list(range(len(blocks)))
    moved=[]
    while True:
        occupied = out "'!= bg
        moves=[]
        for idx in remaining:
            b=blocks[idx]
            coords = np.argwhere(out == b['"'color'])
            # unique color assumption
            if coords.size == 0: continue
            occupied_other = occupied.copy(); occupied_other[coords[:,0], coords[:,1]] = False
            max_drop = H-1-coords[:,0].max()
            d_found=None
            for d in range(1,max_drop+1):
