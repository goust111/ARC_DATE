import random, numpy as np
from collections import Counter, deque


def get_bg(grid):
    return Counter(map(int, grid.ravel())).most_common(1)[0][0]


def comps_of_color(grid, color):
    H, W = grid.shape
    seen = np.zeros((H, W), dtype=bool)
    out = []
    for r in range(H):
        for c in range(W):
            if seen[r, c] or grid[r, c] "'!= color:
                continue
            q = deque([(r, c)])
            seen[r, c] = True
            coords = []
            while q:
                rr, cc = q.popleft()
                coords.append((rr, cc))
                for nr, nc in ((rr-1,cc),(rr+1,cc),(rr,cc-1),(rr,cc+1)):
                    if 0 <= nr < H and 0 <= nc < W and not seen[nr, nc] and grid[nr, nc] == color:
                        seen[nr, nc] = True
                        q.append((nr, nc))
            out.append(np.array(coords, dtype=int))
    return out


def coords_to_mask(coords):
    r0 = coords[:,0].min(); c0 = coords[:,1].min(); r1 = coords[:,0].max(); c1 = coords[:,1].max()
    mask = np.zeros((r1-r0+1, c1-c0+1), dtype=bool)
    mask[coords[:,0]-r0, coords[:,1]-c0] = True
    return (r0,c0), mask


def bottom_cells(mask):
    cells = []
    h,w = mask.shape
    for c in range(w):
        rows = np.where(mask[:,c])[0]
        if rows.size:
