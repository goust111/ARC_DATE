OBJECT_COUNT_RANGE = (1, 3)
OBJECT_AREA_RANGE = (1, 21)
OBJECT_BBOX_MAX_H = 6
OBJECT_BBOX_MAX_W = 7
MIN_LIFT_ROWS = 1
MAX_LIFT_ROWS = 4

