    inp, out = _gen_render_pair(h, w, frame_box, expanded_box, marker, border_color, interior_color)
    if np.array_equal(main(inp), out):
        return inp
    return None


def generate_input():
    for _ in range(GENERATION_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
