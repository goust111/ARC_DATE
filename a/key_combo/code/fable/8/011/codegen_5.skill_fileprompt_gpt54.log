+import random
+from collections import deque
+from dataclasses import dataclass
+
+import numpy as np
+
+
+BG = 0
+GEN_RETRIES = 500
+GRID_H_RANGE = (16, 24)
+GRID_W_RANGE = (15, 26)
+CHAIN_LEN_RANGE = (2, 4)
+SPAN_W_RANGE = (4, 7)
+TERRAIN_HEIGHT_RANGE = (2, 6)
+STACK_GAP_RANGE = (1, 2)
+TOP_MARGIN = 2
