+import random
+from collections import deque
+from dataclasses import dataclass
+
+import numpy as np
+
+
+BG = 0
+GEN_RETRIES = 500
+GRID_H_RANGE = (16, 24)
+GRID_W_RANGE = (15, 26)
+CHAIN_LEN_RANGE = (2, 4)
+SPAN_W_RANGE = (4, 7)
+TERRAIN_HEIGHT_RANGE = (2, 6)
+STACK_GAP_RANGE = (1, 2)
+TOP_MARGIN = 2
+
+
+@dataclass
+class Block:
+    color: int
+    row: int
+    col: int
+    mask: np.ndarray
+    cells: np.ndarray
+    bottoms: np.ndarray
+
+
+def _components_of_color(grid: np.ndarray, color: int) -> list[np.ndarray]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) != color:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            components.append(np.array(coords, dtype=int))
+    return components
+
+
+def _mask_from_coords(coords: np.ndarray) -> tuple[int, int, np.ndarray]:
+    r0 = int(coords[:, 0].min())
+    c0 = int(coords[:, 1].min())
+    r1 = int(coords[:, 0].max())
+    c1 = int(coords[:, 1].max())
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    mask[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    return r0, c0, mask
+
+
+def _bottom_cells(mask: np.ndarray) -> np.ndarray:
+    cells = []
+    for c in range(mask.shape[1]):
+        rows = np.where(mask[:, c])[0]
+        if rows.size:
+            cells.append((int(rows.max()), c))
+    return np.array(cells, dtype=int)
+
+
+def _infer_terrain_color(grid: np.ndarray) -> int:
+    bottom_colors = {int(v) for v in grid[-1] if int(v) != BG}
+    assert len(bottom_colors) == 1, "expected exactly one terrain color touching the bottom edge"
+    return next(iter(bottom_colors))
+
