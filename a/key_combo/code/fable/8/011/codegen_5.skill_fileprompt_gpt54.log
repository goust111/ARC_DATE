        if int(obj["color"]) == Color.GREEN and area == 4:
            green_blocks += 1

    assert 0 <= green_blocks <= 3, "green block count must fit the 3x3 diagonal"
    out = np.full((3, 3), bg, dtype=int)
    for i in range(green_blocks):
        out[i, i] = Color.BLUE
    return out

