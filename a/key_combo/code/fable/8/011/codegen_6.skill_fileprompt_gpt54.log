+    c_min = 2
+    r_max = box_h - content_h - 2
+    c_max = box_w - content_w - 2
+    if r_max < r_min or c_max < c_min:
+        return None
+    cr = random.randint(r_min, r_max)
+    cc = random.randint(c_min, c_max)
