0110: def main(grid: np.ndarray) -> np.ndarray:
0111:     """
0112:     Drop the moving-color objects downward until they rest above a one-row cushion before the obstacle or bottom edge.
0113: 
0114:     Input structure:
0115:     - The grid has exactly three colors: empty background, a stationary obstacle/floor color, and a moving object color.
0116:     - The obstacle color is the unique non-background role that touches the bottom edge.
0117:     - Moving pixels start outside the obstacle cells, outside the row directly above each obstacle pixel, and outside the bottom row.
0118: 
0119:     Rule:
0120:     - Keep the background and obstacle pixels fixed.
0121:     - Treat obstacle pixels, cells directly above obstacle pixels, and the bottom row as blocked.
0122:     - Repeatedly move every 4-connected moving-color object one row down when its translated shape does not hit blocked cells or another moving object.
0123: 
0124:     Key insight: The visible floor has an invisible one-row cushion above it, so the objects fall under gravity but stop with one empty row before the floor or the grid bottom.
0125:     """
0126:     g = np.asarray(grid, dtype=int)
0127:     bg, obstacle, moving = _infer_roles(g)
0128:     _assert_obstacle_profile(g, obstacle)
0129:     blocked = _blocked_mask(g, obstacle)
0130:     assert not np.any(blocked & (g == moving)), "moving pixels must start in free cells"
0131: 
0132:     out = g.copy()
0133:     while True:
0134:         moves = _movable_components(out, bg, moving, blocked)
0135:         if not moves:
0136:             break
0137:         for coords, _ in moves:
0138:             out[coords[:, 0], coords[:, 1]] = bg
0139:         for _, shifted in moves:
0140:             out[shifted[:, 0], shifted[:, 1]] = moving
0141: 
0142:     _assert_output_separated(out, obstacle, moving)
0143:     return out
0144: 
