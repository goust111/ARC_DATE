0007: def main(grid: np.ndarray) -> np.ndarray:
0008:     """
0009:     Fill the empty interior of each colored rectangular frame, using grey for a one-pixel interior and orange for a larger interior.
0010: 
0011:     Input structure:
0012:     - The background is the dominant color.
0013:     - Every foreground object is a monochrome one-cell-thick rectangular frame.
0014:     - Each frame has a background-colored rectangular interior.
0015: 
0016:     Rule:
0017:     - Preserve the frame pixels.
0018:     - Fill a frame's interior with grey when the interior has exactly one pixel.
0019:     - Fill a frame's interior with orange when the interior has more than one pixel.
0020: 
0021:     Key insight:
0022:     - The output color is determined by the size of the enclosed background region, not by the frame color.
0023:     """
0024:     g = np.asarray(grid, dtype=int)
0025:     assert g.ndim == 2, "expected a 2D grid"
0026: 
0027:     bg = get_bg(g)
0028:     objects = find_components(g, bg=bg, connectivity=4, monochromatic=True)
0029:     assert objects, "expected at least one foreground frame"
0030: 
0031:     out = g.copy()
0032:     for obj in objects:
0033:         color = int(obj["color"])
0034:         r0, c0, r1, c1 = obj["bbox"]
0035:         height = bbox_h(obj["bbox"])
0036:         width = bbox_w(obj["bbox"])
0037:         assert height >= 3 and width >= 3, "frames must enclose a nonempty interior"
0038: 
0039:         patch = g[r0 : r1 + 1, c0 : c1 + 1]
0040:         border = np.zeros((height, width), dtype=bool)
0041:         border[0, :] = True
0042:         border[-1, :] = True
0043:         border[:, 0] = True
0044:         border[:, -1] = True
0045: 
0046:         assert np.all(patch[border] == color), "expected a solid monochrome frame border"
0047:         assert np.all(patch[~border] == bg), "expected an empty frame interior"
0048:         interior_area = int((~border).sum())
0049:         assert interior_area >= 1, "expected a nonempty interior"
0050: 
0051:         fill = Color.GREY if interior_area == 1 else Color.ORANGE
0052:         out[r0 + 1 : r1, c0 + 1 : c1] = fill
0053: 
0054:     return out
0055: 
0056: # --------------- generator (o5x) ---------------
0057: 
0058: # Canvas and frame sampling.
0059: _GEN_BACKGROUND = Color.BLACK
0060: _GEN_ROWS_RANGE, _GEN_COLS_RANGE = (6, 16), (6, 13)
0061: _GEN_FRAME_COUNT_RANGE, _GEN_FRAME_SIZES = (1, 5), ((3, 3), (3, 4), (4, 3))
0062: _GEN_FRAME_COLORS = (1, 2, 3, 4, 6, 8, 9)
0063: 
0064: # Placement, fill, and retry controls.
0065: _GEN_FRAME_BORDER = 1
0066: _GEN_FRAME_PADDING, _GEN_PADDING_CONNECTIVITY = 1, 8
0067: _GEN_MAX_ATTEMPTS, _GEN_SINGLE_FILL, _GEN_MULTI_FILL = 300, Color.GREY, Color.ORANGE
0068: 
0069: def _gen_frame_patch(height: int, width: int, color: int) -> np.ndarray:
0070:     """Render a black-interior rectangular frame patch."""
0071:     patch = np.full((height, width), _GEN_BACKGROUND, dtype=int)
0072:     patch[0, :] = color
0073:     patch[-1, :] = color
0074:     patch[:, 0] = color
