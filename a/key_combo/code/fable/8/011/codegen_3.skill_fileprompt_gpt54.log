0014: def main(input_grid):
0015:     """
0016:     Move the red object forward one slot along the green-dot track.
0017: 
0018:     Input structure:
0019:     - A red object overlaps one position on a straight track of green dots.
0020:     - The green dots are evenly spaced in a row or column.
0021:     - The background is black.
0022: 
0023:     Rule:
0024:     - Detect the red object and all green dot objects.
0025:     - Determine the track direction from the green dot centers.
0026:     - Redraw the green dots, then translate the red object along the track to the next non-colliding slot.
0027: 
0028:     Key insight:
0029:     - The green dots are discrete alignment slots, and the first collision-free translation
0030:       places the red object one step forward on that track.
0031:     """
0032:     # Plan:
0033:     # 1. Detect the objects
0034:     # 2. Determine the orientation of the track of green dots
0035:     # 3. Move in the appropriate direction until it perfectly fits over the next green dot, meaning there are no collisions
0036: 
0037:     objects = find_components(input_grid, bg=Color.BLACK, connectivity=8, monochromatic=True, return_format="objects")
0038: 
0039:     red_objects = [ obj for obj in objects if Color.RED in colors_present(obj, exclude={ Color.BLACK }) ]
0040:     green_objects = [ obj for obj in objects if Color.GREEN in colors_present(obj, exclude={ Color.BLACK }) ]
0041: 
0042:     assert len(red_objects) == 1, "There should be exactly one red object"
0043:     assert len(green_objects) >= 1, "There should be at least one green object"
0044: 
0045:     red_object = red_objects[0]
0046: 
0047:     # Determine the orientation of the track of green dots by comparing the positions of two dots
0048:     x1, y1 = min(bbox_anchor(bbox(obj != Color.BLACK), anchor="center") for obj in green_objects)
0049:     x2, y2 = max(bbox_anchor(bbox(obj != Color.BLACK), anchor="center") for obj in green_objects)
0050:     if x1 == x2:
0051:         # vertical track
0052:         dr, dc = 0, 1
0053:     elif y1 == y2:
0054:         # horizontal track
0055:         dr, dc = 1, 0
0056:     
0057:     # Make the output grid: Start with all the greens, then put the red in the right spot by moving it one-by-one
0058:     output_grid = np.full_like(input_grid, Color.BLACK)
0059:     for green_object in green_objects:
0060:         paste(output_grid, green_object, 0, 0, transparent=Color.BLACK, clip=True)
0061: 
0062:     for distance in range(1, 100):
0063:         translated_red_object = translate(red_object, dr*distance, dc*distance)
0064:         if not collision(object1=translated_red_object, object2=output_grid):
0065:             paste(output_grid, translated_red_object, 0, 0, transparent=Color.BLACK, clip=True)
0066:             break
0067: 
0068:     return output_grid
