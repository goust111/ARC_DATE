0007: def main(grid: np.ndarray) -> np.ndarray:
0008:     """
0009:     Count the full green 2x2 blocks and show that count as blue cells on the main diagonal of a 3x3 grid.
0010: 
0011:     Input structure:
0012:     - The background is black.
0013:     - The only foreground colors are red and green.
0014:     - Each monochromatic 4-connected foreground object is either a single pixel or a solid 2x2 block.
0015: 
0016:     Rule:
0017:     - Count the green objects whose bounding box is exactly 2x2 and whose area is four.
0018:     - Return a black 3x3 grid with that many blue cells filled from the top-left along the main diagonal.
0019: 
0020:     Key insight:
0021:     - Red objects and isolated green pixels are distractors; the output encodes only the number of complete green squares.
0022:     """
0023:     g = np.asarray(grid, dtype=int)
