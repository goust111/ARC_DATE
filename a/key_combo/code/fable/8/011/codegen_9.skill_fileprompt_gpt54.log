+    out = g.copy()
+    for blob in blobs:
+        out[blob["coords"][:, 0], blob["coords"][:, 1]] = bg
+
+    for blob in blobs:
+        basin = area_to_basin[blob["area"]]
+        out[basin["coords"][:, 0], basin["coords"][:, 1]] = blob["color"]
+
+    return out
