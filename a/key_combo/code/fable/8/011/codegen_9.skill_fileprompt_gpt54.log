+def _basins(grid: np.ndarray, terrain: int) -> list[dict]:
+    h = int(grid.shape[0])
+    heights = _terrain_heights(grid, terrain)
+    water = _water_mask_from_heights(heights, h)
+    basins = []
+    for coords in _component_coords(water):
+        basins.append(
