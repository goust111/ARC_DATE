+def _front_indicator(
+    bbox: tuple[int, int, int, int], direction: str
+) -> tuple[int, int]:
+    r0, c0, r1, c1 = bbox
+    if direction == "up":
+        return r0, (c0 + c1) // 2
+    if direction == "down":
+        return r1, (c0 + c1) // 2
+    if direction == "left":
