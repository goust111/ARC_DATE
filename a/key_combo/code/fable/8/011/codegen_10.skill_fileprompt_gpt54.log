+    reserved: np.ndarray, direction: str, bbox: tuple[int, int, int, int]
+) -> tuple[int, int] | None:
+    h, w = reserved.shape
+    r0, c0, r1, c1 = bbox
+    if direction in ("up", "down"):
+        dot_r = r0 if direction == "up" else r1
+        cols = list(range(w))
+        random.shuffle(cols)
+        for dot_c in cols:
+            if c0 - 1 <= dot_c <= c1 + 1:
+                continue
+            if _region_is_free(reserved, dot_r, dot_c, dot_r, dot_c, pad=1):
+                return dot_r, dot_c
+        return None
+
+    dot_c = c0 if direction == "left" else c1
+    rows = list(range(h))
+    random.shuffle(rows)
+    for dot_r in rows:
