+    dot_r, dot_c = dot
+    if direction == "up":
+        assert dot_r < r0
+        return dot_r, c0, r1, c1
+    if direction == "down":
+        assert dot_r > r1
+        return r0, c0, dot_r, c1
+    if direction == "left":
+        assert dot_c < c0
+        return r0, dot_c, r1, c1
+    assert direction == "right"
+    assert dot_c > c1
+    return r0, c0, r1, dot_c
