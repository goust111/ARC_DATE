            and r1 - r0 + 1 <= OBJECT_BBOX_MAX_H
            and c1 - c0 + 1 <= OBJECT_BBOX_MAX_W
        ):
            return False
    return True


def _validate_generated_pair(base, inp, out, bg, obstacle, moving):
    blocked = _blocked_mask(base, obstacle)
