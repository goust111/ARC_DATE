+def _can_place(grid: np.ndarray, patch: np.ndarray, r0: int, c0: int, bg: int, padding: int = 1) -> bool:
+    gh, gw = map(int, grid.shape)
+    ph, pw = map(int, patch.shape)
+    if r0 < 0 or c0 < 0 or r0 + ph > gh or c0 + pw > gw:
