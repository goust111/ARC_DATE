+    return True
+
+
+def _single_cell_is_clean(cell: tuple[int, int], color_cells: dict[tuple[int, int], int]) -> bool:
+    if cell in color_cells:
+        return False
+    return all(nbr not in color_cells for nbr in _neighbors4(cell))
