    return _GAP_OFFSET_BY_SIDE[side]


def _gen_frame_bbox(frame):
    r0, c0, h, _side = frame
    return r0, c0, r0 + h - 1, c0 + _FRAME_RIGHT_OFFSET


def _gen_frame_cells(frame):
    r0, c0, h, side = frame
    r1 = r0 + h - 1
    c1 = c0 + _FRAME_RIGHT_OFFSET
    gap_off = _gen_gap_offset(side)
