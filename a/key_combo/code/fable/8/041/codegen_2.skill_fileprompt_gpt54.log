+def _render_expected(inp: np.ndarray, traversed: list[tuple[int, int]]) -> np.ndarray:
+    out = np.array(inp, copy=True)
+    for cell in traversed[1:]:
+        if int(out[cell]) == BLACK:
+            out[cell] = CYAN
+    return out
