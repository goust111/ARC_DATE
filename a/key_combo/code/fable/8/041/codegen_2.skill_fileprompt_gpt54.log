+
+def _segment_cells(
+    start: tuple[int, int], direction: tuple[int, int], length: int
+) -> list[tuple[int, int]]:
+    return [_step(start, direction, k) for k in range(1, length + 1)]
+
+
+def _choose_start(shape: tuple[int, int]) -> tuple[tuple[int, int], tuple[int, int]]:
