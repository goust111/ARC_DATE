+    comps: list[list[tuple[int, int]]] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            comp: list[tuple[int, int]] = []
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            while queue:
+                rr, cc = queue.popleft()
+                comp.append((rr, cc))
+                for nr, nc in _neighbors4((rr, cc)):
