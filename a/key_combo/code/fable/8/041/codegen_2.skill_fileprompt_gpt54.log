+
+def _distance_to_boundary(shape: tuple[int, int], cell: tuple[int, int], direction: tuple[int, int]) -> int:
+    h, w = shape
+    r, c = cell
+    dr, dc = direction
+    if dr == -1:
+        return r
+    if dr == 1:
+        return h - 1 - r
+    if dc == -1:
+        return c
+    return w - 1 - c
+
+
+def _red_green_components(grid: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = grid.shape
+    mask = (grid == RED) | (grid == GREEN)
