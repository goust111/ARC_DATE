+def _semantic_scene_ok(inp: np.ndarray, expected: np.ndarray, placements: list[dict]) -> bool:
+    if int(np.count_nonzero(inp == BG)) <= inp.size // 2:
+        return False
+    if not np.array_equal(main(inp), expected):
