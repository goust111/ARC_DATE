+        r0, c0, r1, c1 = spec["bbox"]
+        dr, dc = spec["direction"]
+        for j, other in enumerate(placements):
+            if i == j:
+                continue
+            or0, oc0, or1, oc1 = other["bbox"]
+            if dr == 0 and _projections_overlap(r0, r1, or0, or1):
+                return True
+            if dc == 0 and _projections_overlap(c0, c1, oc0, oc1):
+                return True
