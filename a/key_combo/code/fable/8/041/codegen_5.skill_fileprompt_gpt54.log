+GRID_ROWS = (18, 28)
+GRID_COLS = (18, 28)
+OBJECT_COUNT_OPTIONS = (3, 4)
+MAX_GENERATION_ATTEMPTS = 400
+MAX_OBJECT_PLACEMENT_TRIES = 500
+MAX_OBJECT_SHAPE_TRIES = 120
+
