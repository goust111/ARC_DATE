+def _far_enough(existing: list[tuple[int, int]], candidate: list[tuple[int, int]], gap: int = 1) -> bool:
+    for r0, c0 in existing:
+        for r1, c1 in candidate:
+            if max(abs(r0 - r1), abs(c0 - c1)) <= gap:
+                return False
+    return True
+
