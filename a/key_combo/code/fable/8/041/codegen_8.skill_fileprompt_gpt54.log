+    h, w = shape
+    candidates: list[tuple[int, int]] = []
+    for r in range(top + 1, bottom):
+        for c in (left - 1, right + 1):
+            if 0 <= r < h and 0 <= c < w and (r, c) not in occupied:
+                candidates.append((r, c))
+    for c in range(left + 1, right):
+        for r in (top - 1, bottom + 1):
