+    if len(rel1 - rel2) == 0 or len(rel2 - rel1) == 0:
+        return None
+    if _hole_count(_coords_to_mask(rel1)) != 0:
+        return None
+    if _hole_count(_coords_to_mask(rel2)) != 0:
+        return None
+    if _hole_count(_coords_to_mask(rel1 | rel2)) == 0:
+        return None
+
+    return rel1, rel2
