  grid:
    input: H rows x (2*W+1) cols where H=3-7, W=4-8 [observed H=5, W=6]
    output: H rows x W cols
  separator:
    single full-height column of red at column W, dividing grid into equal left and right masks
  masks:
    colors: each half uses only black(0) and orange(7)
    left_density: 30-60% orange
    right_density: 30-60% orange
    overlap: >=1 cell where both masks are orange
    each_unique: >=1 cell where only one mask is orange (both left-only>0 and right-only>0)
    union_density: 65-80% of cells are orange in at least one mask [observed]
  transform:
    pixelwise OR of left and right masks; orange in either -> blue(1) in output, else black(0)

generation_strategy:
