+
+    for r in range(h):
+        for c in (0, w - 1):
+            if not mask[r, c] and not exterior[r, c]:
+                exterior[r, c] = True
+                q.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if not mask[r, c] and not exterior[r, c]:
+                exterior[r, c] = True
+                q.append((r, c))
+
+    while q:
+        r, c = q.popleft()
+        for dr, dc in DIRS4:
