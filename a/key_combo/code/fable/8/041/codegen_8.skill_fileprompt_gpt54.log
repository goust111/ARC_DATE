+        only2, root2 = _bar_cells("bottom", top, left, bottom, right, bottom_margin)
+
+    gap1 = _gap_cells(random.choice(["top", "bottom", "left", "right"]), top, left, bottom, right, root1)
+    if gap1 is None:
