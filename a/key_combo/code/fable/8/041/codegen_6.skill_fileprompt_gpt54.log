+
+    repeated_side = random.choice(["top", "bottom", "left", "right"])
+    sides = [repeated_side, repeated_side]
+    if matched_count == 3:
+        extra_options = [side for side in ["top", "bottom", "left", "right"] if side != repeated_side]
+        sides.append(random.choice(extra_options))
