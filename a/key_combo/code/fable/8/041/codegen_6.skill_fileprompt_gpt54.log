+def _piece_matches_spec(piece: dict) -> bool:
+    try:
+        parsed = _parse_piece(piece["patch"] == piece["color"], piece["color"], [])
+    except AssertionError:
+        return False
+    return parsed["side"] == piece["side"] and parsed["tab_width"] == piece["tab_width"]
