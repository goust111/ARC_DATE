+    for r in range(h):
+        for c in range(w):
+            if visited[r, c] or not mask[r, c]:
+                continue
+            q = deque([(r, c)])
+            visited[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for dr, dc in DIRS4:
