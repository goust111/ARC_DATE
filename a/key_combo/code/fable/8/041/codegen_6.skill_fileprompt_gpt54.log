+        pieces_meta.append(
+            {
+                "matched": True,
+                "tab_width": piece["tab_width"],
+                "target_notch": target_notch,
+                "wrong_notch": wrong_notch,
+                "input_bbox": _piece_input_bbox(piece, top_left),
+                "area": len(piece["cells"]),
