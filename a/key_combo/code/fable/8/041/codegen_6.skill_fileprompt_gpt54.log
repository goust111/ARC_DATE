+def _components_for_color(grid: np.ndarray, color: int) -> list[dict]:
+    h, w = grid.shape
+    mask = grid == int(color)
+    visited = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            if visited[r, c] or not mask[r, c]:
+                continue
+            q = deque([(r, c)])
+            visited[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for dr, dc in DIRS4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not visited[nr, nc] and mask[nr, nc]:
+                        visited[nr, nc] = True
+                        q.append((nr, nc))
+            r0, c0, r1, c1 = _bbox(coords)
+            crop = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+            for rr, cc in coords:
+                crop[rr - r0, cc - c0] = True
+            comps.append(
+                {
+                    "color": int(color),
+                    "coords": coords,
+                    "bbox": (r0, c0, r1, c1),
+                    "mask": crop,
+                }
+            )
+    return comps
+
+
+def _detect_notches(
