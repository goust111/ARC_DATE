+                }
+            )
+        else:
+            c += 1
+
+    c = c0 + 1
+    while c <= c1 - 1:
+        if grid[r1, c] == bg and grid[r1 - 1, c] == rect_color:
+            start = c
+            while c <= c1 - 1 and grid[r1, c] == bg and grid[r1 - 1, c] == rect_color:
+                c += 1
+            end = c - 1
+            notches.append(
+                {
+                    "side": "bottom",
+                    "width": end - start + 1,
+                    "axis_start": start,
+                    "axis_end": end,
