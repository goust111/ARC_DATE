+
+    r = r0 + 1
+    while r <= r1 - 1:
+        if grid[r, c1] == bg and grid[r, c1 - 1] == rect_color:
+            start = r
+            while r <= r1 - 1 and grid[r, c1] == bg and grid[r, c1 - 1] == rect_color:
