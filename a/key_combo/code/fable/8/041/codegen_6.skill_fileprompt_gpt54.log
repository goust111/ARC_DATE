+        if len(runs) == 1:
+            start, end = runs[0]
+            width = end - start + 1
+            if 1 <= width < h:
+                candidates.append(
+                    {
+                        "side": "right",
+                        "tab_width": width,
+                        "tab_offset": start,
+                        "body_h": h,
+                        "body_w": w - 1,
+                    }
