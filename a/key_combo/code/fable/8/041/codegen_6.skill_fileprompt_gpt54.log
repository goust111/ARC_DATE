+            start = r
+            while r <= r1 - 1 and grid[r, c1] == bg and grid[r, c1 - 1] == rect_color:
+                r += 1
+            end = r - 1
+            notches.append(
+                {
+                    "side": "right",
+                    "width": end - start + 1,
+                    "axis_start": start,
+                    "axis_end": end,
+                    "cells": {(rr, c1) for rr in range(start, end + 1)},
+                }
+            )
+        else:
