+def _parse_piece(mask: np.ndarray, color: int, coords: list[tuple[int, int]]) -> dict:
+    h, w = mask.shape
+    candidates: list[dict] = []
+
+    if h >= 3 and np.all(mask[1:, :]):
+        runs = _true_runs_1d(mask[0, :])
+        if len(runs) == 1:
+            start, end = runs[0]
+            width = end - start + 1
+            if 1 <= width < w:
+                candidates.append(
+                    {
+                        "side": "top",
+                        "tab_width": width,
+                        "tab_offset": start,
+                        "body_h": h - 1,
+                        "body_w": w,
+                    }
+                )
