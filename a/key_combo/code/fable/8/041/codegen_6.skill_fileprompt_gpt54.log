+def _preferred_band(side: str, rect_bbox: tuple[int, int, int, int], bbox: tuple[int, int, int, int]) -> bool:
+    r0, c0, r1, c1 = rect_bbox
+    br0, bc0, br1, bc1 = bbox
+    if side == "top":
+        return br0 >= r1 + 3
+    if side == "bottom":
+        return br1 <= r0 - 3
+    if side == "left":
+        return bc0 >= c1 + 3
+    return bc1 <= c0 - 3
