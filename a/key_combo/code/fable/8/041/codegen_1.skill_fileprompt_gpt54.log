+    for piece, (pr, pc) in zip(pieces, positions):
+        _paste(out, piece["patch"], r0 + 1 + pr, c0 + 1 + pc, transparent=bg)
+    return out
+
+
+# --------------- generator ---------------
+
+GEN_INTERIOR_H = (6, 8)
+GEN_INTERIOR_W = (6, 9)
+GEN_HOLE_COMPONENTS = (1, 3)
+GEN_HOLE_CELLS_PER_COMPONENT = (1, 3)
+GEN_GRID_H = (16, 26)
+GEN_GRID_W = (16, 26)
+GEN_RETRIES = 600
