+def _solve_variant(grid: np.ndarray, *, drop_clipped: bool = False, ignore_wall: bool = False) -> np.ndarray:
+    parsed = _parse_scene(grid)
+    out = parsed["grid"].copy()
+    out[out == GRAY] = parsed["body_color"]
+    out[out == ORANGE] = parsed["body_color"]
