+    scaled = sign * values
+    jump = abs(delta)
+    clip_step = full_copies + 1
+    prev_max = int(np.max(scaled + full_copies * jump))
+    clip_min = int(np.min(scaled + clip_step * jump))
+    clip_max = int(np.max(scaled + clip_step * jump))
+    lo = max(prev_max, clip_min) + 1
+    hi = clip_max
