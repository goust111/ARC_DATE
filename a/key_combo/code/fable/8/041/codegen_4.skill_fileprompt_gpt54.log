+                    random.shuffle(wall_options)
+                    for wall_local_index in wall_options:
+                        clip_vals = coords[:, axis] + (full_copies + 1) * delta
+                        if delta > 0:
+                            kept = int(np.sum(clip_vals < wall_local_index))
+                        else:
+                            kept = int(np.sum(clip_vals > wall_local_index))
