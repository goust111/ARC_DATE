+    vector = parsed["vector"]
+    axis = parsed["axis"]
+    wall_index = parsed["wall_index"]
+    side = parsed["side"]
+    h, w = grid.shape
+
+    assert 0 < wall_index < (w - 1 if axis == 1 else h - 1)
+
+    saw_clip = False
+    saw_full = 0
