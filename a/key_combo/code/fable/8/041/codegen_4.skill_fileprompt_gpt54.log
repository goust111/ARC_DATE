+def _random_shape() -> np.ndarray:
+    for _ in range(200):
+        h = random.randint(5, 7)
+        w = random.randint(5, 7)
+        target_area = random.randint(8, 12)
+        start = (random.randrange(h), random.randrange(w))
+        cells = {start}
+        frontier = {start}
+
+        while len(cells) < target_area and frontier:
