+            neighbors = []
+            for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
+                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in cells:
+                    neighbors.append((nr, nc))
+            if not neighbors:
+                frontier.discard((cr, cc))
+                continue
+            nxt = random.choice(neighbors)
+            cells.add(nxt)
+            frontier.add(nxt)
