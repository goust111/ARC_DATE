+
+def _random_shape() -> np.ndarray:
+    for _ in range(200):
+        h = random.randint(4, 6)
+        w = random.randint(4, 6)
+        mask = np.ones((h, w), dtype=bool)
+        target_area = random.randint(max(8, (h * w * 2) // 3), h * w)
+        cells = [(r, c) for r in range(h) for c in range(w)]
+        random.shuffle(cells)
+        for r, c in cells:
+            if int(mask.sum()) <= target_area:
+                break
+            trial = mask.copy()
+            trial[r, c] = False
+            if _is_connected(trial):
+                mask = trial
+        mask = _crop_mask(mask)
+        if min(mask.shape) < 4 or int(mask.sum()) < 8:
+            continue
+        return mask
+    raise RuntimeError("failed to generate a connected sprite shape")
+
+
+def _cell_degrees(mask: np.ndarray) -> dict[tuple[int, int], int]:
+    degrees: dict[tuple[int, int], int] = {}
+    h, w = mask.shape
+    for r, c in np.argwhere(mask):
