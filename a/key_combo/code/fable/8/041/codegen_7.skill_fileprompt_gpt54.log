+        fill_all = bool(np.all((partial != BG) | (transformed != BG)))
+        merged = partial.copy()
+        merged[merged == BG] = transformed[merged == BG]
+        stats[name] = {
+            "conflict_free": conflict_free,
+            "fill_all": fill_all,
+            "merged": merged,
+        }
