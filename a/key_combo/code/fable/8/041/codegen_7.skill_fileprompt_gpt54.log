+
+def _paste(dst: np.ndarray, patch: np.ndarray, r0: int, c0: int, *, transparent: int | None = None) -> None:
+    h, w = patch.shape
+    view = dst[r0 : r0 + h, c0 : c0 + w]
+    if transparent is None:
+        view[:] = patch
+        return
+    mask = patch != int(transparent)
+    view[mask] = patch[mask]
+
+
+def _transform(arr: np.ndarray, name: str) -> np.ndarray:
+    if name == "id":
+        return arr.copy()
+    if name == "rot90":
+        return np.rot90(arr, 1).copy()
+    if name == "rot180":
+        return np.rot90(arr, 2).copy()
+    if name == "rot270":
+        return np.rot90(arr, 3).copy()
+    if name == "flip_lr":
+        return np.fliplr(arr).copy()
+    if name == "flip_ud":
+        return np.flipud(arr).copy()
+    if name == "transpose":
+        return arr.T.copy()
+    if name == "anti_transpose":
+        return np.fliplr(np.flipud(arr).T).copy()
+    raise ValueError(f"unknown transform: {name}")
+
+
+def _map_coord(r: int, c: int, n: int, name: str) -> tuple[int, int]:
+    if name == "id":
+        return r, c
+    if name == "rot90":
+        return n - 1 - c, r
+    if name == "rot180":
+        return n - 1 - r, n - 1 - c
+    if name == "rot270":
+        return c, n - 1 - r
+    if name == "flip_lr":
+        return r, n - 1 - c
+    if name == "flip_ud":
+        return n - 1 - r, c
+    if name == "transpose":
+        return c, r
+    if name == "anti_transpose":
+        return n - 1 - c, n - 1 - r
+    raise ValueError(f"unknown transform: {name}")
