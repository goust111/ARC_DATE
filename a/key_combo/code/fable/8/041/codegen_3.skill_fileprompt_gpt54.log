+        r1, c1 = bars[i]["center"]
+        for j in range(i + 1, len(bars)):
+            r2, c2 = bars[j]["center"]
+            dist = abs(r1 - r2) + abs(c1 - c2)
+            data.append((i, j, bool(_background_overlap_cells(bars, i, j)), dist))
+    return data
