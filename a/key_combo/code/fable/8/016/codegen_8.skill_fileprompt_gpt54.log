            reflected = True
        if nc < 0 or nc >= w:
            dc = -dc
            reflected = True
        if reflected:
            bounces += 1
            nr, nc = r + dr, c + dc

        if grey_mask[nr, nc]:
            return bounces
        r, c = nr, nc


def _render_legend(box_shape: tuple[int, int], key_col: int, keys: list[tuple[int, int]], counts: list[int]) -> np.ndarray:
    out = np.zeros(box_shape, dtype=int)
