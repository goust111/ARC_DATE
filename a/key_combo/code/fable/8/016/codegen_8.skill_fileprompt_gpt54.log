+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+DIRS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]
+COLOR_POOL = [1, 2, 3, 4, 6, 7, 8, 9]
+
+MAX_BOUNCES = 6
+GEN_RETRIES = 300
+
