+    return None
+
+
+def _candidate_cell_orbits(n: int) -> list[tuple[tuple[int, int], ...]]:
+    seen: set[tuple[tuple[int, int], ...]] = set()
+    out: list[tuple[tuple[int, int], ...]] = []
+    for r in range(1, n - 1):
+        for c in range(1, n - 1):
