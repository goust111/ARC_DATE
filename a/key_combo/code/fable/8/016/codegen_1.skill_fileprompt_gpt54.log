+    for tl in orbit:
+        tr, tc = tl
+        if hidden_dir == "R":
+            if rr not in {tr, tr + 1} or tc + 1 >= rc - 1:
+                continue
+            path = [(rr, cc) for cc in range(tc + 2, rc)]
+        elif hidden_dir == "L":
+            if rr not in {tr, tr + 1} or tc <= rc + 1:
+                continue
+            path = [(rr, cc) for cc in range(rc + 1, tc)]
+        elif hidden_dir == "D":
