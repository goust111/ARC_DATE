+def _all_square_orbits(n: int) -> list[tuple[tuple[int, int], ...]]:
+    seen: set[tuple[tuple[int, int], ...]] = set()
+    out: list[tuple[tuple[int, int], ...]] = []
+    for r in range(1, n - 2):
+        for c in range(1, n - 2):
+            orbit = _square_orbit_toplefts(n, r, c)
+            if len(orbit) != 4:
+                continue
+            if orbit in seen:
