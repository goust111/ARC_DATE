+
+            expected = completed.copy()
+            expected[red_pos] = BG
+            for r, c in placed_red:
+                expected[r, c] = RED
+            if np.array_equal(out, expected):
+                return inp
+        if random.random() < 0.7:
+            break
+    return None
+
+
+def generate_input() -> np.ndarray:
