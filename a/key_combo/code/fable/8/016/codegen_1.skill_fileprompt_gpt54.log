+            reserved_bg = set(reserved)
+            reserved_bg.add(red_pos)
+            if hidden_cells_all & reserved_bg:
+                continue
+            occupied = set(hidden_cells_all)
+
+            decoy_orbit = None
+            decoy_path: list[tuple[int, int]] | None = None
+            for orbit in square_orbits:
