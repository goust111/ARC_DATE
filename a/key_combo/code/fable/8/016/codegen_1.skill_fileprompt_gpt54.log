+            if np.array_equal(out, expected):
+                return inp
+        if random.random() < 0.7:
+            break
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
