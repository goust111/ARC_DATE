+            cells.add((r, c))
+    return cells
+
+
+def _paint_cell_orbit(grid: np.ndarray, orbit: tuple[tuple[int, int], ...], color: int) -> set[tuple[int, int]]:
+    cells = set(orbit)
+    for r, c in cells:
+        grid[r, c] = int(color)
+    return cells
+
+
+def _orbit_cells_for_square_orbit(orbit: tuple[tuple[int, int], ...]) -> set[tuple[int, int]]:
