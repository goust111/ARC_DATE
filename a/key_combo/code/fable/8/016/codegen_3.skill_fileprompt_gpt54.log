        layer_colors = _layer_order(rect)
        color_map = dict(zip(layer_colors, reversed(layer_colors)))

        out_rect = out[r0 : r1 + 1, c0 : c1 + 1]
        for src, dst in color_map.items():
            out_rect[rect == src] = dst

    return out

