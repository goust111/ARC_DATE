+    grid[r1, c0 : c1 + 1] = color
+    grid[r0 : r1 + 1, c0] = color
+    grid[r0 : r1 + 1, c1] = color
+
+
+def _paint_layer(
+    grid: np.ndarray,
+    layer: tuple[int, int, int, int, int, int],
