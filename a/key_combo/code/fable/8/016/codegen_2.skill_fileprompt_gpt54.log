+        layers.append((r0, c0, r1, c1, thickness, color))
+        r0 += thickness
+        c0 += thickness
+        r1 -= thickness
+        c1 -= thickness
+
+    return layers
+
+
+def _count_corner_markers(grid: np.ndarray, bbox: tuple[int, int, int, int]) -> int:
+    r0, c0, r1, c1 = map(int, bbox)
