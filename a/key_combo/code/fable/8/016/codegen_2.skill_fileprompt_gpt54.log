+        color = int(grid[r0, c0])
+        thickness = 0
+        while True:
+            rr0 = r0 + thickness
+            cc0 = c0 + thickness
+            rr1 = r1 - thickness
+            cc1 = c1 - thickness
+            if rr0 > rr1 or cc0 > cc1:
+                break
+            if not _border_is_color(grid, rr0, cc0, rr1, cc1, color):
+                break
