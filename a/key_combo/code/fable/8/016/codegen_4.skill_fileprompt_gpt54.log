+) -> bool:
+    lane_kind = str(record["lane_kind"])
+    side = _row_side(corner) if lane_kind == "row" else _col_side(corner)
+    lane = int(record["lane_value"])
+    visible = bool(record["visible"])
+    color = int(record["color"])
