+
+def _translate(shape: list[tuple[int, int]], anchor: tuple[int, int]) -> list[tuple[int, int]]:
+    ar, ac = anchor
+    return [(ar + dr, ac + dc) for dr, dc in shape]
+
+
+def _cells_fit(
+    shape: tuple[int, int],
+    cells: list[tuple[int, int]],
+    occupied: np.ndarray,
+) -> bool:
