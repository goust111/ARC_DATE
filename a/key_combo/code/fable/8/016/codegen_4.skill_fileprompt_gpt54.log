+        if counts[int(color)] > slots:
+            return None
+        if object_totals[int(color)] == 0:
+            return None
+
+    hidden_total = sum(object_totals[color] - counts[color] for color in key_colors)
+    if hidden_total == 0:
+        return None
+    if not np.any(grid == GREY):
+        return None
+    return grid
