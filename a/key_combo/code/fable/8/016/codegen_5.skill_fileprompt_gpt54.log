+    keep_count = int(_RNG.integers(keep_min, keep_max + 1))
+    keep_idx = set(map(int, _RNG.choice(len(fg_coords), size=keep_count, replace=False)))
+    kept_colors = {int(patch[fg_coords[i]]) for i in keep_idx}
