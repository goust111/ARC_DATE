+def _random_partition(size: int, target_parts: int) -> list[tuple[int, int, int, int]]:
+    rects = [(0, 0, size, size)]
+    while len(rects) < target_parts:
+        candidates = []
+        for idx, (_r, _c, h, w) in enumerate(rects):
+            if h >= 4:
+                candidates.append((idx, "h"))
+            if w >= 4:
