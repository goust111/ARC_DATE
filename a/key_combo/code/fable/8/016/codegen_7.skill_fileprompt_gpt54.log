+def _build_orbits(size: int) -> tuple[np.ndarray, list[tuple[tuple[int, int], ...]]]:
+    orbit_index = np.full((size, size), -1, dtype=int)
+    orbits: list[tuple[tuple[int, int], ...]] = []
+    lookup: dict[tuple[tuple[int, int], ...], int] = {}
