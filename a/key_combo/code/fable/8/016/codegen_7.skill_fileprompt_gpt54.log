+def _find_pieces(grid: np.ndarray, bg: int) -> list[np.ndarray]:
+    g = np.asarray(grid, dtype=int)
+    mask = g != int(bg)
+    h, w = map(int, g.shape)
+    seen = np.zeros((h, w), dtype=bool)
+    pieces: list[np.ndarray] = []
+
