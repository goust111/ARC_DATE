    arr = np.full((height, width), BG, dtype=int)
    for i in range(height):
        length = width - i
        row = i if corner in ("tl", "tr") else height - 1 - i
        if corner in ("tl", "bl"):
            arr[row, :length] = color
        else:
            arr[row, width - length :] = color
    return arr


