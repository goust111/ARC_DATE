+def _make_symmetric_solution(size: int, palette: list[int]) -> np.ndarray:
+    seed_h = (size + 1) // 2
+    seed_w = (size + 1) // 2
+    seed = np.full((seed_h, seed_w), random.choice(palette), dtype=int)
+
