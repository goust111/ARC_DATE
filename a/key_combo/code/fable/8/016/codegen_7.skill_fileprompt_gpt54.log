+            cs = [cc for _, cc in cells]
+            r0, r1 = min(rs), max(rs)
+            c0, c1 = min(cs), max(cs)
+            submask = mask[r0 : r1 + 1, c0 : c1 + 1]
+            assert bool(submask.all()), "each fragment must occupy a full rectangle"
+            pieces.append(g[r0 : r1 + 1, c0 : c1 + 1].copy())
