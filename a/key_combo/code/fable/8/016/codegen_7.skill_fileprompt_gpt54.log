+) -> np.ndarray | None:
+    max_piece_h = max(int(piece.shape[0]) for piece in pieces)
+    max_piece_w = max(int(piece.shape[1]) for piece in pieces)
+    min_h = max(16, max_piece_h + 4)
+    min_w = max(16, max_piece_w + 4)
