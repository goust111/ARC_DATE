+                        (r, c),
+                        (size - 1 - r, c),
+                        (r, size - 1 - c),
+                        (size - 1 - r, size - 1 - c),
+                    }
+                )
+            )
+            oid = lookup.get(cells)
+            if oid is None:
+                oid = len(orbits)
+                lookup[cells] = oid
+                orbits.append(cells)
+            orbit_index[r, c] = int(oid)
+
