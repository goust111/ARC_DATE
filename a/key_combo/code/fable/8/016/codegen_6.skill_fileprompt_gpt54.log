+    sprite = np.full((tile_h, tile_w), BG, dtype=int)
+    top = random.randint(1, tile_h - bbox_h - 1)
+    left = random.randint(1, tile_w - bbox_w - 1)
+    sprite[top : top + bbox_h, left : left + bbox_w][mask] = color
