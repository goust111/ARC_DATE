+    block_w = tile_w // 3
+    thumb = np.zeros((3, 3), dtype=int)
+    for r in range(3):
+        for c in range(3):
+            block = tile[r * block_h : (r + 1) * block_h, c * block_w : (c + 1) * block_w]
