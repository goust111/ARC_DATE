+def _sample_thumbnail_colors() -> np.ndarray:
+    while True:
+        palette = random.sample(PALETTE, k=random.randint(3, min(6, len(PALETTE))))
+        colors = np.array([random.choice(palette) for _ in range(8)], dtype=int)
+        if len(set(map(int, colors))) >= 3:
+            return colors
+
