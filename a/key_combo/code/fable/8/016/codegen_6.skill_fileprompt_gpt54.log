+    tile_h = row_lines[0]
+    tile_w = col_lines[0]
+    return {
+        (tr, tc): (slice(row_starts[tr], row_starts[tr] + tile_h), slice(col_starts[tc], col_starts[tc] + tile_w))
+        for tr in range(3)
+        for tc in range(3)
+    }
