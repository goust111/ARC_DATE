+    m = np.asarray(mask, dtype=np.uint8)
+    diff = np.zeros((m.shape[0] + 1, m.shape[1] + 1), dtype=np.uint8)
+    diff[:-1, :-1] ^= m
+    diff[1:, :-1] ^= m
+    diff[:-1, 1:] ^= m
+    diff[1:, 1:] ^= m
