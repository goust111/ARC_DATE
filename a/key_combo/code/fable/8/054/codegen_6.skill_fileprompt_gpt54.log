+
+def _rect_mask(shape: tuple[int, int], p: tuple[int, int], q: tuple[int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = _rect_bounds(p, q)
+    mask = np.zeros(shape, dtype=np.uint8)
+    mask[r0 : r1 + 1, c0 : c1 + 1] = 1
+    return mask
