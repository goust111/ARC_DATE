+    c0 = max(ac0, bc0)
+    r1 = min(ar1, br1)
+    c1 = min(ac1, bc1)
+    if r0 > r1 or c0 > c1:
+        return 0
+    return int((r1 - r0 + 1) * (c1 - c0 + 1))
