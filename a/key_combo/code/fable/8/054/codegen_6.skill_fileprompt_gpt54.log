+    r1, c1 = coords.max(axis=0)
+    bbox_area = int((r1 - r0 + 1) * (c1 - c0 + 1))
+    if int(mask.sum()) < bbox_area:
+        return True
+    return _row_or_col_has_multiple_spans(mask) or _row_or_col_has_multiple_spans(mask.T)
