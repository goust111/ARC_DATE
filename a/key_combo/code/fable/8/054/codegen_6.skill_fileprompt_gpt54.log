    return _solve_details(np.asarray(grid, dtype=int))["output"]


def _random_full_pattern(height: int, width: int, palette: tuple[int, ...]) -> np.ndarray:
    while True:
        arr = np.random.choice(palette, size=(height, width))
        if len(np.unique(arr)) < 3:
