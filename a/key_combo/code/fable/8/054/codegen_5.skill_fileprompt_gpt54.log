+        except RuntimeError:
+            continue
+
+        # Rebuild expected on the same placement by using the solved output.
+        expected = main(inp)
+        pair_infos = []
+        bg = _get_bg(inp)
+        for comp in _components(inp != bg):
+            box = _bbox(comp)
