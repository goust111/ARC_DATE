    if kind == 'H':
        return {(value, c) for c in range(S)}
    if kind == 'V':
        return {(r, value) for r in range(S)}
    if kind == 'D':  # diag_down: r - c = value
        return {(r, r - value) for r in range(S) if 0 <= r - value < S}
    if kind == 'U':  # diag_up: r + c = value
