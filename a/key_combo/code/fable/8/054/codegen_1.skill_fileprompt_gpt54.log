14: def main(input_grid):
15:     """
16:     Use a downscaled monochrome pattern as a mask on the multicolor square.
17: 
18:     Input structure:
19:     - The input is a black grid with one large single-color pattern object.
20:     - A smaller dense multicolor square appears elsewhere.
21:     - The pattern is an integer scale-up of a square mask.
22: 
23:     Rule:
24:     - Separate the monochrome pattern from the multicolor square.
25:     - Crop both objects and downsample the pattern to the square's size.
26:     - Keep square pixels where the downsampled pattern is non-black and set the rest to black.
27: 
28:     Key insight:
29:     - The large object is a binary stencil that aligns with the square after integer downscaling.
30:     """
31:     # find all the objects in the input grid
32:     objects = find_components(input_grid, bg=Color.BLACK, connectivity=8, monochromatic=False, return_format="objects")
33: 
34:     # figure out which object is the pattern and which object is the multi-colored square
35:     pattern = square = None
36:     for obj in objects:
37:         # if the object has only one color and black, it is the pattern. Otherwise, it is the multi-colored square.
38:         if len(set(obj.flatten())) == 2:
39:             pattern = obj
40:         else:
41:             square = obj
42:     
43:     # get the square location and cut out the bounding box
44:     _b = bbox(square != Color.BLACK)
45:     assert _b is not None
46:     r, c, _r1, _c1 = _b
47:     width = _r1 - r + 1
48:     height = _c1 - c + 1
49:     square_sprite = square[r:r+width, c:c+height]
50: 
51:     # cut out the bounding box of the pattern
52:     _b = bbox(pattern != Color.BLACK)
53:     assert _b is not None
54:     x2, y2, _r1, _c1 = _b
55:     width2 = _r1 - x2 + 1
56:     height2 = _c1 - y2 + 1
57:     # make sure the pattern is square
58:     if width2 != height2:
59:         width2 = height2 = max(width2, height2)
60:     pattern_sprite = pattern[x2:x2+width2, y2:y2+height2]
61: 
62:     # figure out how much bigger the pattern is than the square
63:     scale = width2 // width
64: 
65:     # scale down the pattern to fit the square
66:     scaled_pattern = np.zeros_like(square_sprite) 
67:     for i in range(width):
68:         for j in range(height):
69:             scaled_pattern[i,j] = pattern_sprite[i * scale, j * scale]
70:     
71:     # if the pixel is in the pattern, keep the color from the square otherwise make it black in the output grid
72:     output_grid = np.where(scaled_pattern, square_sprite, Color.BLACK)
73: 
74:     return output_grid
75: 
