+
+LINE_KINDS = ("H", "V", "D", "U")
+MIN_RAW_LINE_LEN = 7
+MIN_VISIBLE_LINE_PIXELS = 3
+MIN_GRID_SIZE = 12
+MAX_GRID_SIZE = 18
+MIN_LINE_COUNT = 3
+MAX_LINE_COUNT = 5
+GENERATION_RETRIES = 400
