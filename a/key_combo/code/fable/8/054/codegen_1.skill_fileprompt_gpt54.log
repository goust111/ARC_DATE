146: def _gen_dihedral_arrays(arr: np.ndarray) -> list[np.ndarray]:
147:     variants = [
148:         arr,
149:         np.fliplr(arr),
150:         np.flipud(arr),
151:         np.flipud(np.fliplr(arr)),
152:         arr.T,
153:         np.fliplr(arr.T),
154:         np.flipud(arr.T),
155:         np.flipud(np.fliplr(arr.T)),
156:     ]
157:     out: list[np.ndarray] = []
158:     seen: set[tuple[int, ...]] = set()
159:     for variant in variants:
160:         key = tuple(map(int, variant.ravel()))
161:         if key not in seen:
162:             seen.add(key)
163:             out.append(np.array(variant, dtype=int, copy=True))
164:     return out
