36: def main(grid: np.ndarray) -> np.ndarray:
37:     """
38:     Fill black gaps by reconstructing the cyclic symmetric coordinate table visible in the non-black cells.
39: 
40:     Input structure:
41:     - The grid is square, with black pixels marking missing cells in an otherwise complete symmetric table.
42:     - The first row is complete: it shows the diagonal color, the previous cycle color, then paired runs of the palette cycle.
43:     - Every non-black input pixel already agrees with the hidden table.
44: 
45:     Rule:
46:     - Read the palette cycle from every other first-row cell starting at column 2, stopping when the diagonal color repeats.
47:     - For a cell, let near = min(row, column) and dist = abs(row - column).
48:     - Use the diagonal color when dist is 0, the previous cycle color when dist <= near + 1, otherwise cycle through blocks of width near + 2.
49: 
50:     Key insight:
51:     The missing pixels are not locally interpolated; they are entries of a global symmetric table indexed by distance from the main diagonal.
52:     """
53:     g = np.asarray(grid, dtype=int)
54:     cycle = _palette_cycle(g)
55: 
56:     out = np.empty_like(g)
57:     h, w = g.shape
58:     for r in range(h):
59:         for c in range(w):
60:             out[r, c] = _table_value(r, c, cycle)
61: 
62:     assert np.all((g == 0) | (g == out)), "nonzero input cells must already match the reconstructed table"
63:     return out
