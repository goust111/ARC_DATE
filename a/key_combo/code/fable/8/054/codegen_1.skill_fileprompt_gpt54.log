46:         g,
47:         bg=bg,
48:         connectivity=4,
49:         monochromatic=True,
50:         colors=[foreground],
51:         return_format="dict",
52:     )
53:     assert len(objects) >= 2, "expected multiple foreground rectangles"
54: 
55:     boxes = []
56:     for obj in objects:
57:         r0, c0, r1, c1 = obj["bbox"]
58:         expected_area = (r1 - r0 + 1) * (c1 - c0 + 1)
59:         assert obj["area"] == expected_area, "foreground objects must be solid rectangles"
60:         boxes.append((r0, c0, r1, c1))
