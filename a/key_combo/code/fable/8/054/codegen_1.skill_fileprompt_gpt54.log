57: def main(grid: np.ndarray) -> np.ndarray:
58:     """List the colors of overlaid straight lines in their only possible bottom-to-top crossing order.
59: 
60:     Input structure
61:     The background is the dominant color. Every foreground color is the visible part
62:     of one full one-cell-thick horizontal, vertical, or 45-degree diagonal line.
63:     Higher lines may hide pixels of lower lines at crossings.
64: 
65:     Rule
66:     Recover each full line from its visible collinear pixels. At any cell where
67:     multiple recovered lines cross, the visible color is above every other line
68:     through that cell. Return the unique ordering of all line colors that respects
69:     those above/below constraints and whose consecutive colors are lines that
70:     geometrically cross.
71: 
72:     Key insight
73:     The visible crossing colors give a partial layer order, and the intended answer
74:     is the unique Hamiltonian chain through the line-intersection graph from the
75:     bottom layer to the top layer.
76:     """
77:     g = np.asarray(grid, dtype=int)
78:     assert g.ndim == 2
79: 
80:     bg = get_bg(g)
81:     lines = _infer_lines(g, bg)
82:     colors = list(lines)
83:     below_edges: set[tuple[int, int]] = set()
84:     intersects: dict[int, set[int]] = {color: set() for color in colors}
85: 
86:     for r in range(g.shape[0]):
