18: def main(grid: np.ndarray) -> np.ndarray:
19:     """Render the filled-square object counts as compact nested stacks ordered by count rank.
20: 
21:     Input structure
22:     A large noisy grid has a dominant background, scattered non-square noise, and
23:     filled monochrome square objects. Each square side length has exactly one
24:     object color, and side lengths form consecutive sizes.
25: 
26:     Rule
27:     Ignore non-square components. If the lowest square in the scene is of the
28:     smallest side length, treat that one smallest square as a distractor and do
29:     not count it. For count rank k from left to right, create one block from all
30:     square sizes with at least k remaining objects; draw larger squares first and
31:     smaller squares over their upper-left corner, then append one background
32:     separator column.
33: 
34:     Key insight
35:     The output is a count histogram of square side lengths, but each histogram
36:     slot is rendered as nested upper-left square masks using the side colors.
37:     """
38:     g = np.asarray(grid, dtype=int)
39:     assert g.ndim == 2, "expected a 2D grid"
40: 
41:     bg = get_bg(g)
42:     objects = _square_objects(g, bg)
43:     assert objects, "expected filled square objects"
44: 
45:     sides = sorted({obj["side"] for obj in objects})
46:     assert sides == list(range(sides[0], sides[-1] + 1)), "expected consecutive square side lengths"
47: 
48:     by_side = {side: [obj for obj in objects if obj["side"] == side] for side in sides}
49:     colors = {}
50:     for side, side_objects in by_side.items():
51:         side_colors = {obj["color"] for obj in side_objects}
52:         assert len(side_colors) == 1, "each side length should have one color"
53:         colors[side] = side_colors.pop()
54: 
55:     smallest = sides[0]
56:     lowest_row = max(obj["bbox"][2] for obj in objects)
57:     lowest_smallest = [obj for obj in by_side[smallest] if obj["bbox"][2] == lowest_row]
58:     if lowest_smallest:
59:         assert len(lowest_smallest) == 1, "expected at most one lowest smallest distractor"
60:         drop_bbox = lowest_smallest[0]["bbox"]
61:         by_side[smallest] = [obj for obj in by_side[smallest] if obj["bbox"] != drop_bbox]
62: 
63:     counts = {side: len(side_objects) for side, side_objects in by_side.items()}
64:     assert all(count > 0 for count in counts.values()), "each square size should remain represented"
65: 
66:     out_h = sides[-1] + 1
67:     groups = []
68:     for rank in range(max(counts.values())):
69:         present_sides = [side for side in sides if counts[side] > rank]
70:         assert present_sides, "rank should contain at least one square size"
71: 
72:         group_w = max(present_sides)
73:         group = np.full((out_h, group_w), bg, dtype=int)
74:         for side in sorted(present_sides, reverse=True):
75:             group[:side, :side] = colors[side]
76:         groups.append(group)
77: 
78:     out_w = sum(group.shape[1] + 1 for group in groups)
79:     out = np.full((out_h, out_w), bg, dtype=int)
80:     c = 0
81:     for group in groups:
82:         w = group.shape[1]
83:         out[:, c : c + w] = group
84:         c += w + 1
85: 
86:     return out
87: 
