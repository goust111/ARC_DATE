+                if any(cover_counts[cell] >= 2 for cell in cand["cells"]):
+                    continue
+                pool.append(cand)
+            if not pool:
+                break
+            random.shuffle(pool)
+            chosen = pool[0]
+            order.append(chosen)
+            used.add((chosen["kind"], chosen["value"]))
