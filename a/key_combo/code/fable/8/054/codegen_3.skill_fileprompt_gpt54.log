  "path": "diagonal ray from the center through the quadrant containing the same-color pixels",
  "trajectory": "paint every pixel on the ray with the center color",
  "transform": "clear all other foreground pixels to the dominant background color"
}
</annotation>
<generation_spec>
```yaml
spec:
  grid: odd square, side 7-13 (i.e. n=3-6 where side=2n+1)
  background: single dominant color (~63-69% of cells), center row and center col are all bg except center pixel
  colors: exactly 4 non-bg distinct colors (including center color); all 5 colors distinct
  center_pixel: foreground color at grid center (n,n)
  quadrants: |
    grid divided into 4 diagonal quadrants by center row/col (each n x n cells).
    Each quadrant filled with exactly one non-bg color (scattered randomly).
    No foreground pixels on center row or center col except center pixel.
  quadrant_fill: 33-56% of quadrant cells filled (rest bg) [observed]
  rule: |
    Identify center color. Its marker pixels (in one quadrant) indicate a diagonal direction.
    Output: bg everywhere + diagonal ray of center color from center to the indicated corner.
    Ray length = n+1 pixels (center to edge inclusive).
  distractors: 3 non-center colors, one per remaining quadrant; same scatter style

generation_strategy:
  approach: direct construction (structure is simple enough)
  steps:
    1. Pick n in 3-6, side = 2n+1. Pick 5 distinct colors for bg + 4 quadrant colors.
    2. Fill grid with bg. Pick one of 4 diagonal directions as the answer direction.
    3. Assign center color to that quadrant, 3 distractor colors to the other 3 quadrants.
    4. Set center pixel to center color.
    5. For each quadrant, scatter its color into 33-56% of the n*n cells randomly.
    6. Ensure center row and center col remain pure bg (except center pixel).
    7. Output = bg grid + diagonal ray of center color from center toward chosen corner.
