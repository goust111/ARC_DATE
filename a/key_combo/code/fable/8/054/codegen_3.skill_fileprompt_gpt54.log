+    min_c = min(c for _, c in cells)
+    shifted = {(r - min_r, c - min_c) for r, c in cells}
+    max_r = max(r for r, _ in shifted)
+    max_c = max(c for _, c in shifted)
+    mask = np.zeros((max_r + 1, max_c + 1), dtype=bool)
+    for r, c in shifted:
