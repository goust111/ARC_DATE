+    start = degrees.index(1)
+    order = [start]
+    used = {start}
+    prev = -1
+    while True:
+        cur = order[-1]
+        nxt_edges = [edge for edge in adjacency[cur] if edge["to"] != prev]
+        if not nxt_edges:
+            break
+        assert len(nxt_edges) == 1, "path order must be unique"
+        edge = nxt_edges[0]
+        nxt = int(edge["to"])
+        assert nxt not in used, "connector graph must not cycle"
+        used.add(nxt)
+        order.append(nxt)
