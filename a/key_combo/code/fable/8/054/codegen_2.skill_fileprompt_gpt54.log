+    optional = [(r, c) for r in range(1, 4) for c in range(1, 4) if (r, c) not in body]
+    random.shuffle(optional)
+    extra_count = random.randint(0, min(5, len(optional)))
+    for cell in optional[:extra_count]:
+        body.add(cell)
