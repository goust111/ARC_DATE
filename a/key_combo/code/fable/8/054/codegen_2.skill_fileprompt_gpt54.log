+        target_r = base_r + int(cur_conn["pos"][0]) + int(dr0)
+        target_c = base_c + int(cur_conn["pos"][1]) + int(dc0)
+        placements[nxt] = (target_r - int(nxt_conn["pos"][0]), target_c - int(nxt_conn["pos"][1]))
