+from __future__ import annotations
+
+import random
+from collections import Counter, defaultdict, deque
+
+import numpy as np
+
+
+BG = 0
+BODY = 5
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+CONNECTOR_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+CELL = 5
+GEN_ATTEMPTS = 400
+
+
+def _bbox_of_cells(cells: set[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in cells]
+    cols = [c for _, c in cells]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _crop_non_bg(grid: np.ndarray) -> np.ndarray:
+    coords = np.argwhere(grid != BG)
+    if coords.size == 0:
+        return np.zeros((0, 0), dtype=int)
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return grid[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1]
+
+
+def _components8(mask: np.ndarray) -> list[set[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[set[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            queue = deque([(r, c)])
+            comp: set[tuple[int, int]] = {(r, c)}
+            while queue:
+                cr, cc = queue.popleft()
+                for dr in (-1, 0, 1):
+                    for dc in (-1, 0, 1):
+                        if dr == 0 and dc == 0:
+                            continue
+                        nr, nc = cr + dr, cc + dc
+                        if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                            seen[nr, nc] = True
+                            queue.append((nr, nc))
+                            comp.add((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _is_connected4(cells: set[tuple[int, int]]) -> bool:
+    if not cells:
+        return False
+    start = next(iter(cells))
+    seen = {start}
+    queue = deque([start])
+    while queue:
+        r, c = queue.popleft()
+        for dr, dc in DIRS4:
+            nxt = (r + dr, c + dc)
+            if nxt in cells and nxt not in seen:
+                seen.add(nxt)
+                queue.append(nxt)
+    return len(seen) == len(cells)
+
+
+def _analyze_component(sprite: np.ndarray) -> dict:
+    coords = {(int(r), int(c)) for r, c in np.argwhere(sprite != BG)}
+    body = {(r, c) for r, c in coords if int(sprite[r, c]) == BODY}
+    connectors = []
+    for r, c in sorted(coords):
+        color = int(sprite[r, c])
+        if color in (BG, BODY):
