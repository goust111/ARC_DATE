+        assert a != b, "paired connectors must belong to different components"
+        adjacency[a].append({"to": b, "self_idx": ia, "other_idx": ib, "color": color})
+        adjacency[b].append({"to": a, "self_idx": ib, "other_idx": ia, "color": color})
