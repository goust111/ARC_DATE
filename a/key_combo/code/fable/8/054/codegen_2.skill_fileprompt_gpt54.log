+def _is_connected4(cells: set[tuple[int, int]]) -> bool:
+    if not cells:
+        return False
+    start = next(iter(cells))
+    seen = {start}
+    queue = deque([start])
+    while queue:
+        r, c = queue.popleft()
+        for dr, dc in DIRS4:
+            nxt = (r + dr, c + dc)
+            if nxt in cells and nxt not in seen:
