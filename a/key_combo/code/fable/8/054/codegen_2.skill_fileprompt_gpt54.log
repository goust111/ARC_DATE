+def _validate_instance(inp: np.ndarray, expected: np.ndarray) -> bool:
+    if inp.ndim != 2 or expected.ndim != 2:
+        return False
+    if max(inp.shape) > 30 or max(expected.shape) > 30:
+        return False
+    try:
