+def _components8(mask: np.ndarray) -> list[set[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[set[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            queue = deque([(r, c)])
+            comp: set[tuple[int, int]] = {(r, c)}
+            while queue:
+                cr, cc = queue.popleft()
+                for dr in (-1, 0, 1):
+                    for dc in (-1, 0, 1):
