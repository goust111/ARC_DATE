+    point_count = 0
+
+    for coords in objects:
+        rows = coords[:, 0]
+        cols = coords[:, 1]
+        color = int(g[rows[0], cols[0]])
+        assert np.all(g[rows, cols] == color), "each segment must be monochrome"
+
+        r0, r1 = int(rows.min()), int(rows.max())
+        c0, c1 = int(cols.min()), int(cols.max())
