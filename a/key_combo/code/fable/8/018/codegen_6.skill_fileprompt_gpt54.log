72:         c = cc + 2 * dc
73:         k = 0
74:         while in_bounds(g.shape, r, c):
75:             assert int(out[r, c]) == bg, "cardinal ray must cross only background"
76:             out[r, c] = cardinal_pattern[k % len(cardinal_pattern)]
77:             k += 1
78:             r += dr
79:             c += dc
80: 
