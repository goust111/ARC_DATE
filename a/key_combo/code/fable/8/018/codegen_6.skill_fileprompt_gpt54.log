5: def main(grid: np.ndarray) -> np.ndarray:
6:     """
7:     Build a 3x3 mosaic of whole-grid mirror reflections around the original tile.
8: 
9:     Input structure
10:     - The input is a 3x3 color grid; every cell belongs to the source tile.
11: 
12:     Rule
13:     - Produce a 9x9 grid split into nine 3x3 tile slots.
14:     - The center slot is the original tile.
15:     - Slots above or below the center reverse source rows.
16:     - Slots left or right of the center reverse source columns.
17:     - Corner slots reverse both rows and columns.
18: 
19:     Key insight
20:     The output is reflection wallpaper of the entire small grid, not per-pixel scaling or color-specific processing.
21:     """
22:     g = np.asarray(grid, dtype=int)
23:     assert g.ndim == 2, "expected a 2D grid"
24:     assert g.shape == (3, 3), "expected the 3x3 source tile"
25: 
26:     rows = np.arange(g.shape[0])
27:     cols = np.arange(g.shape[1])
28:     row_order = np.concatenate((rows[::-1], rows, rows[::-1]))
29:     col_order = np.concatenate((cols[::-1], cols, cols[::-1]))
30:     return g[row_order[:, None], col_order[None, :]]
31: 
