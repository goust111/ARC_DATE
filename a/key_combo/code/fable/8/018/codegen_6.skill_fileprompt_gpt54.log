58: GEN_L_MISSING_CELLS = 1
59: GEN_L_FILLED_CELLS = len(GEN_L_OFFSETS) - GEN_L_MISSING_CELLS
60: GEN_ANCHORS = tuple((r, c) for r in range(GEN_GRID_SHAPE[0] - GEN_L_SIZE + 1)
61:                     for c in range(GEN_GRID_SHAPE[1] - GEN_L_SIZE + 1))
62: 
63: # Object count, placement spacing, and retry limits.
64: GEN_COUNT_MIN = 2
65: GEN_COUNT_MAX = 4
66: GEN_ADJACENCY_GAP = 1
67: GEN_RETRY_LIMIT = 300
68: 
69: # Generator colors.
70: GEN_BG = int(Color.BLACK)
71: GEN_FG = int(Color.TEAL)
72: GEN_FILL = int(Color.BLUE)
73: 
74: def _gen_l_box(anchor: tuple[int, int]) -> tuple[int, int, int, int]:
75:     return anchor[0], anchor[1], anchor[0] + GEN_L_SIZE - 1, anchor[1] + GEN_L_SIZE - 1
76: 
77: def _gen_boxes_compatible(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:
78:     """Return whether two inclusive 2x2 boxes avoid overlap and 4-adjacency."""
79:     ar0, ac0, ar1, ac1 = a
80:     br0, bc0, br1, bc1 = b
81:     rows_overlap = ar0 <= br1 and br0 <= ar1
82:     cols_overlap = ac0 <= bc1 and bc0 <= ac1
83:     side_touch = (
84:         rows_overlap and (ac1 + GEN_ADJACENCY_GAP == bc0 or bc1 + GEN_ADJACENCY_GAP == ac0)
85:         or cols_overlap and (ar1 + GEN_ADJACENCY_GAP == br0 or br1 + GEN_ADJACENCY_GAP == ar0)
86:     )
87:     return not (rows_overlap and cols_overlap or side_touch)
88: 
89: def _gen_choose_anchors(count: int) -> list[tuple[int, int]] | None:
90:     """Pick count anchors whose 2x2 boxes do not overlap or touch by edge."""
91:     anchors = list(GEN_ANCHORS)
92: 
93:     def search(chosen: list[tuple[int, int]], candidates: list[tuple[int, int]]) -> list[tuple[int, int]] | None:
94:         if len(chosen) == count:
95:             return chosen
96:         if len(candidates) < count - len(chosen):
97:             return None
98: 
99:         for idx in np.random.permutation(len(candidates)):
100:             anchor = candidates[int(idx)]
101:             box = _gen_l_box(anchor)
102:             if not all(_gen_boxes_compatible(box, _gen_l_box(prev)) for prev in chosen):
103:                 continue
104:             remaining = [
105:                 cand
106:                 for j, cand in enumerate(candidates)
107:                 if j != int(idx) and _gen_boxes_compatible(box, _gen_l_box(cand))
108:             ]
109:             result = search(chosen + [anchor], remaining)
110:             if result is not None:
111:                 return result
112:         return None
113: 
114:     return search([], anchors)
115: 
116: def _gen_expected_output(grid: np.ndarray) -> np.ndarray:
117:     """Compute the oracle output by filling each detected L missing corner."""
118:     out = grid.copy()
119:     for r, c in GEN_ANCHORS:
120:         patch = grid[r : r + GEN_L_SIZE, c : c + GEN_L_SIZE]
121:         if (
122:             np.count_nonzero(patch == GEN_FG) == GEN_L_FILLED_CELLS
123:             and np.count_nonzero(patch == GEN_BG) == GEN_L_MISSING_CELLS
124:         ):
125:             dr, dc = np.argwhere(patch == GEN_BG)[0]
126:             out[r + int(dr), c + int(dc)] = GEN_FILL
127:     return out

