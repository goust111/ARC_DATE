+BG_COLOR = 0
+DIAGONAL_COLOR = 5
+GEN_OBJECT_COLORS = [1, 2, 4, 6, 7, 8, 9]
+GEN_GRID_MIN = 12
+GEN_GRID_MAX = 20
+GEN_RETRIES = 400
