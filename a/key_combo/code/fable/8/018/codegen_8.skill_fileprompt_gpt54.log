+        return (1, -1) if inward else (-1, 1)
+    return (-1, 1) if inward else (1, -1)
+
+
+def _shift_cells(cells: tuple[tuple[int, int], ...] | set[tuple[int, int]], dr: int, dc: int) -> tuple[tuple[int, int], ...]:
+    return tuple(sorted((int(r + dr), int(c + dc)) for r, c in cells))
