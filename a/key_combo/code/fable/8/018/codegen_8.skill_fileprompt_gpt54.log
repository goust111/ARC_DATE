+def _shape_variants(shape: tuple[tuple[int, int], ...]) -> list[tuple[tuple[int, int], ...]]:
+    h = max(r for r, _ in shape) + 1
+    w = max(c for _, c in shape) + 1
+    mask = np.zeros((h, w), dtype=bool)
+    for r, c in shape:
