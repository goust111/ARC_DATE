+    paired = set()
+    for idx, obj in enumerate(objects):
+        if obj["side"] != UPPER:
+            continue
+        mirrored = frozenset((c, r) for r, c in obj["cells"])
+        mate = lower_lookup.get(mirrored)
+        if mate is not None:
