+
+def _side_distance(cells: tuple[tuple[int, int], ...], side: str) -> int:
+    if side == UPPER:
+        return min(c - r for r, c in cells)
+    return min(r - c for r, c in cells)
+
+
+def _step(side: str, inward: bool) -> tuple[int, int]:
