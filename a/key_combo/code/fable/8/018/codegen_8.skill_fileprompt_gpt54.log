+    occupied_lower: set[tuple[int, int]],
+) -> tuple[tuple[tuple[int, int], ...], tuple[tuple[int, int], ...]] | None:
+    for _ in range(250):
+        shape = random.choice(ALL_SHAPES)
+        h = max(r for r, _ in shape) + 1
+        w = max(c for _, c in shape) + 1
