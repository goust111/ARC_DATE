+    original_sets = sorted((obj["side"], tuple(sorted(obj["cells"]))) for obj in objects)
+    settled_sets = sorted((obj["side"], tuple(sorted(obj["cells"]))) for obj in settled)
+    if original_sets != settled_sets:
