+
+
+def _paired_indices(objects: list[dict]) -> set[int]:
+    lower_lookup = {
+        frozenset(obj["cells"]): idx
+        for idx, obj in enumerate(objects)
+        if obj["side"] == LOWER
+    }
+    paired = set()
+    for idx, obj in enumerate(objects):
+        if obj["side"] != UPPER:
+            continue
