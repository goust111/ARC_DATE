+        return all(c > r for r, c in cells)
+    return all(r > c for r, c in cells)
+
+
+def _extract_objects(grid: np.ndarray, bg: int, diagonal_color: int) -> list[dict]:
+    n = grid.shape[0]
+    visited = np.zeros_like(grid, dtype=bool)
+    objects = []
+    for r in range(n):
+        for c in range(n):
