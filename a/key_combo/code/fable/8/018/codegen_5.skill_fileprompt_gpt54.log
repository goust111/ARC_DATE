+
+    total_height = 1 + sum(outer_heights) + sum(gaps) + 1
+    if total_height > 30:
+        return None
+
+    min_width = max(max(outer_widths) + 8, 18)
+    width = random.randint(min_width, 30)
+    left_color, right_color = random.sample(BAR_COLORS, 2)
+
