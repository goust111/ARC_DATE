+            marker_col = random.choice(marker_cols)
+
+            _draw_container(grid, r, c0, outer_h, outer_w, liquid_height)
+            if grid[marker_row, marker_col] != BG:
+                grid[r : r + outer_h, c0 : c1 + 1] = BG
+                continue
+
+            if side == "left":
