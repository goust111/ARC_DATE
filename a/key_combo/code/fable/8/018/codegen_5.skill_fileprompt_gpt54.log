+def _gen_attempt() -> np.ndarray | None:
+    num_containers = random.randint(2, 4)
+    outer_heights = [random.randint(4, 7) for _ in range(num_containers)]
+    outer_widths = [random.randint(4, 7) for _ in range(num_containers)]
