+            assert np.all(g[r, target_c:c] == BG), "leftward path must be clear"
+            out[r, c] = BG
+            out[r, target_c] = left_color
+        else:
+            target_c = c + headspace
+            assert target_c <= w - 2
+            assert np.all(g[r, c + 1 : target_c + 1] == BG), "rightward path must be clear"
+            out[r, c] = BG
+            out[r, target_c] = right_color
