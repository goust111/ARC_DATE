+        missing = list(box_cells - present)
+        if len(missing) != 1:
+            raise AssertionError("each L must have exactly one missing corner")
+        mr, mc = missing[0]
+        direction = (-1 if mr == r0 else 1, -1 if mc == c0 else 1)
