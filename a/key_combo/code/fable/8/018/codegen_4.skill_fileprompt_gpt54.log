+                    if int(grid[nr, nc]) != color:
+                        continue
+                    visited[nr, nc] = True
+                    q.append((nr, nc))
+            coords = np.array(cells, dtype=int)
+            components.append({"color": color, "coords": coords})
+    return components
+
+
+def _parse_scene(grid: np.ndarray) -> tuple[int, list[dict], dict[tuple[int, int], int]]:
