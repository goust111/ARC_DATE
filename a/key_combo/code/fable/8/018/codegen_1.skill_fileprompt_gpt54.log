    shape: tuple[int, int],
    reserved: list[tuple[int, int, int, int]],
) -> bool:
    r0, c0, r1, c1 = box
    if r0 < 0 or c0 < 0 or r1 >= shape[0] or c1 >= shape[1]:
        return False
    return all(not _boxes_too_close(box, other) for other in reserved)


