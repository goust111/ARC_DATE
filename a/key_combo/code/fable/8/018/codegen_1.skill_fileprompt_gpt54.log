from __future__ import annotations

import random
from dataclasses import dataclass

import numpy as np


BG = 0
BLUE = 1
RED = 2
GREY = 5

DIRS = {
    "up": (-1, 0),
    "down": (1, 0),
    "left": (0, -1),
    "right": (0, 1),
}

ROOM_SIZES = (3, 5, 7)
