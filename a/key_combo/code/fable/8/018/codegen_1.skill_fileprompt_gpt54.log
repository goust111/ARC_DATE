+    cells = [(r, c) for r in range(grid.shape[0]) for c in range(grid.shape[1]) if r != center_r and c != center_c]
+    random.shuffle(cells)
+    placed = 0
+    target = random.randint(1, 4)
+    for r, c in cells:
