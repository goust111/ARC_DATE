            for c in range(room.c0, room.c1 + 1):
                if r in (room.r0, room.r1) or c in (room.c0, room.c1):
                    lookup[(r, c)] = room
    return lookup


def _trace_ray(
    grid: np.ndarray,
    out: np.ndarray,
    start: tuple[int, int],
    direction: str,
