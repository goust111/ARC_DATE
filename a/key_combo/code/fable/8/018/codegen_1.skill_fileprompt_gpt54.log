+def _boxes_too_close(a: tuple[int, int, int, int], b: tuple[int, int, int, int], gap: int = CLEARANCE) -> bool:
+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
+    separated = ar1 + gap < br0 or br1 + gap < ar0 or ac1 + gap < bc0 or bc1 + gap < ac0
