+GEN_ATTEMPTS = 500
+PLACEMENT_ATTEMPTS = 120
+
+
+def get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.flat)).most_common(1)[0][0])
+
+
+def bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def bbox_h(box: tuple[int, int, int, int]) -> int:
+    return int(box[2] - box[0] + 1)
+
+
+def bbox_w(box: tuple[int, int, int, int]) -> int:
+    return int(box[3] - box[1] + 1)
+
+
+def find_components(
+    grid: np.ndarray,
+    *,
+    bg: int | None = None,
+    colors: set[int] | None = None,
+) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    if bg is None:
+        bg = get_bg(g)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if seen[r, c] or color == bg:
+                continue
+            if colors is not None and color not in colors:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                coords.append((cr, cc))
+                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(g[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            coords_arr = np.array(coords, dtype=int)
+            out.append(
+                {
+                    "color": color,
+                    "coords": coords_arr,
+                    "bbox": bbox_coords(coords_arr),
+                    "area": int(coords_arr.shape[0]),
+                }
+            )
+    return out
