+            return len(solutions) < 2
+        pivot = min(uncovered)
+        for box, corners in point_to_candidates.get(pivot, []):
+            if corners.issubset(uncovered):
+                chosen.append(box)
+                if not search(uncovered - set(corners), chosen):
+                    return False
+                chosen.pop()
