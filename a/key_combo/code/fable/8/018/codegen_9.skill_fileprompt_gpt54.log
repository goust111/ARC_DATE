+import random
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+BORDER_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+
+GRID_SIDE_RANGE = (10, 24)
+FRAME_MARGIN = 2
+FRAME_OUTER_MIN = 5
+FRAME_OUTER_MAX = 14
+KEY_LENGTH_MAX = 9
+GEN_RETRIES = 400
