+                rw = random.randint(RECT_SIDE_MIN, max_rect_w)
+                r0 = random.randint(0, h - rh)
+                c0 = random.randint(0, w - rw)
+                if np.any(covered[r0 : r0 + rh, c0 : c0 + rw]):
+                    continue
+                covered[r0 : r0 + rh, c0 : c0 + rw] = True
