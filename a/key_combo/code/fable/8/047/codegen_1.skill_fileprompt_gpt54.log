+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+        out.append(np.array(pts, dtype=int))
+    return out
+
+
+def orbit_keys(mask: np.ndarray) -> set[tuple[tuple[int, int], bytes]]:
