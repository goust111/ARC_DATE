+        q = deque([(r, c)])
+        seen[r, c] = True
+        pts = []
+        while q:
+            rr, cc = q.popleft()
+            pts.append((rr, cc))
+            for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
