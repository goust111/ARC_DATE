        assert r1 - r0 + 1 == 2
        assert c1 - c0 + 1 == 2
        assert np.all(g[r0 : r1 + 1, c0 : c1 + 1] == Color.GREY)

        markers = [
            (r0 - 1, c0 - 1, Color.BLUE),
            (r0 - 1, c1 + 1, Color.RED),
            (r1 + 1, c0 - 1, Color.GREEN),
            (r1 + 1, c1 + 1, Color.YELLOW),
        ]
        for r, c, color in markers:
            assert in_bounds(g.shape, r, c)
            assert g[r, c] == bg
            assert out[r, c] == bg
            out[r, c] = color

    return out

