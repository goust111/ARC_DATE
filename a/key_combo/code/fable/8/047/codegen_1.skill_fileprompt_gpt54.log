+def validate_generated_grid(grid: np.ndarray) -> None:
+    parsed = parse_grid(grid)
+    assert len(orbit_keys(parsed["glyph_tiles"]["tl"])) == 8
+    assert len(orbit_keys(parsed["source_pattern"])) == 8
