+REFLECTION_NAMES = {"flip_lr", "flip_ud", "transpose", "anti_transpose"}
+QUADRANT_NAMES = ("tl", "tr", "bl", "br")
+NAIVE_BY_QUADRANT = {"tr": "flip_lr", "bl": "flip_ud", "br": "rot180"}
