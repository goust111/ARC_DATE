+        seen.add(cur)
+        order.append(cur)
+        cur = outgoing[cur]
+    assert len(order) == 4, "the chain must visit all four panels"
+    assert len(seen) == 4
+    return order
+
+
+def _composite(infos: list[dict], order: list[int]) -> np.ndarray:
