    selector = np.full((GEN_SELECTOR_SIZE, GEN_SELECTOR_SIZE), GEN_SELECTOR_COLOR, dtype=int)
    for (r, c), color in zip(GEN_MARKER_POSITIONS, marker_colors):
        selector[r, c] = int(color)
