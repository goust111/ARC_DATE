+        "bottom_right": (r1 + 1, c1 - 2, r1 + 3, c1),
+        "left_top": (r0, c0 - 3, r0 + 2, c0 - 1),
+        "left_bottom": (r1 - 2, c0 - 3, r1, c0 - 1),
+        "right_top": (r0, c1 + 1, r0 + 2, c1 + 3),
+        "right_bottom": (r1 - 2, c1 + 1, r1, c1 + 3),
