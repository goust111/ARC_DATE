                        min_hole_area = 0
                        max_hole_area = 0
                        ok = True
                        for idx in selected_set:
                            r = idx // cols
                            c = idx % cols
                            cell_area = row_heights[r] * col_widths[c]
                            if cell_area < _GEN_HOLE_AREA_MIN:
