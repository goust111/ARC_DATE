+_NEIGHBORS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+_BG = 0
+_SLOT_NAMES = (
+    "top_left",
+    "top_right",
+    "bottom_left",
+    "bottom_right",
+    "left_top",
+    "left_bottom",
+    "right_top",
+    "right_bottom",
