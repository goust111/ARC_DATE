    order = sorted(range(n_rects), key=lambda i: sizes[i][0] * sizes[i][1], reverse=True)

    total_area = sum(h * w for h, w in sizes)
    max_area = max(h * w for h, w in sizes)
    if H * W - total_area <= max_area:
