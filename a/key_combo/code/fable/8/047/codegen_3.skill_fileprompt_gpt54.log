                    for col_widths in itertools.product(range(_GEN_CELL_W_MIN, _GEN_CELL_W_MAX + 1), repeat=cols):
                        sprite_w = sum(col_widths) + cols + 1
                        if not (_GEN_SPRITE_W_MIN <= sprite_w <= _GEN_SPRITE_W_MAX):
