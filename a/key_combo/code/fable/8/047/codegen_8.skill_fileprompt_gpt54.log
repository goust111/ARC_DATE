+            r0 = i * (cell_h + bar_h)
+            c0 = j * (cell_w + bar_w)
+            grid[r0 : r0 + cell_h, c0 : c0 + cell_w] = int(compact[i, j])
+    return grid
+
+
+def _validate_generated_instance(
