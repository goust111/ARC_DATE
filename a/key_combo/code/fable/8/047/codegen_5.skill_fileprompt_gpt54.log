    distractor_count = random.randint(*GEN_DISTRACTOR_COUNT_RANGE)
    colors = random.sample(GEN_COLOR_POOL, GEN_MARKER_COUNT + distractor_count)
    return colors[:GEN_MARKER_COUNT], colors[GEN_MARKER_COUNT:]


