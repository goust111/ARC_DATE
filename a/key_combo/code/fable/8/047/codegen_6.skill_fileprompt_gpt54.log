+def _add_arm(canvas: np.ndarray, base_h: int, base_w: int, edge: str, bias: str) -> None:
+    base_r0 = 2
+    base_c0 = 2
+    if edge in {"top", "bottom"}:
+        span = base_w
+        length = random.randint(1, min(2, span))
+        depth = random.randint(1, 2)
+        start = _biased_start(span, length, bias)
+        c0 = base_c0 + start
+        c1 = c0 + length
