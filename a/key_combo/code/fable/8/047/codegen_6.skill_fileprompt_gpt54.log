+
+def _place_patches(patches: list[np.ndarray]) -> np.ndarray | None:
+    gap = 2
+    border = 1
+    areas = [int(np.count_nonzero(patch)) for patch in patches]
+    total_area = sum((patch.shape[0] + gap) * (patch.shape[1] + gap) for patch in patches)
+    side_floor = max(18, min(30, int(math.ceil(total_area ** 0.5)) + 3))
+
+    for _ in range(150):
+        h = random.randint(side_floor, 30)
+        w = random.randint(side_floor, 30)
+        blocked = np.zeros((h, w), dtype=bool)
+        grid = np.zeros((h, w), dtype=int)
+
+        order = list(range(len(patches)))
+        order.sort(key=lambda idx: (-areas[idx], patches[idx].shape[0] * patches[idx].shape[1], random.random()))
+
+        ok = True
+        for idx in order:
+            patch = patches[idx]
+            ph, pw = patch.shape
+            choices = []
+            for r in range(border, h - ph - border + 1):
+                for c in range(border, w - pw - border + 1):
+                    rr0 = max(0, r - gap)
+                    cc0 = max(0, c - gap)
