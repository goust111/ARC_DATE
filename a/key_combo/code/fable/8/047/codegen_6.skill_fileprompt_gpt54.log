+    if max_start <= 0:
+        return 0
+    if max_start >= 2:
+        low = 1
+        high = max_start - 1
+    else:
+        low = 0
+        high = max_start
+    if low > high:
+        low = 0
+        high = max_start
+    if bias == "start":
+        return random.randint(low, min(high, low + 1))
+    if bias == "end":
