+
+
+def _rotation_key(mask: np.ndarray) -> tuple[int, int, bytes]:
+    return min(_mask_signature(np.rot90(mask, k)) for k in range(4))
+
+
+def _same_up_to_rotation(a: np.ndarray, b: np.ndarray) -> bool:
