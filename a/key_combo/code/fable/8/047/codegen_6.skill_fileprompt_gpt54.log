+    return True
+
+
+def generate_input() -> np.ndarray:
+    global _GEN_CALL_COUNT
+    mode = _GEN_CALL_COUNT % 3
+    _GEN_CALL_COUNT += 1
+
+    for _ in range(300):
+        grid = _render_scene(mode)
+        if grid is not None and _validate_scene(grid, mode):
+            return grid
