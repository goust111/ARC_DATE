+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+
+VALID_MARKER_COLORS = (BLUE, RED, GREEN, YELLOW)
+CORNER_LAYOUT = (
+    ((0, 0), BLUE),
+    ((0, 1), RED),
+    ((1, 0), GREEN),
+    ((1, 1), YELLOW),
+)
