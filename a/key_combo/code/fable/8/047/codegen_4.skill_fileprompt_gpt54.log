+        c0, c1 = col_ranges[c]
+        out[r0 : r1 + 1, c0 : c1 + 1] = marker_color
+    return out
+
+
+def _validate_scene(
+    grid: np.ndarray,
+    tree_edges: set[Edge],
+    true_path: list[Coord],
+    decoy_path: list[Coord],
+    marker_color: int,
