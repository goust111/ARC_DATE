  grid: 16-18 rows x 13-17 cols; bg=0
  selector_block:
    shape: 7x7 filled with color 1 (45 pixels of color 1 + 4 marker pixels)
    placement: flush against one corner/edge of the grid [observed]
    markers: exactly 4 pixels at positions (1,1), (1,5), (5,1), (5,5) within the block
    marker_colors: 4 distinct colors, each different from bg(0) and selector(1)
  sprites:
    count: 4 marker-matched + 0-2 distractors; total 4-6
