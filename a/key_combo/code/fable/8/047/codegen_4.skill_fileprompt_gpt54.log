+def _gap_graph(
+    grid: np.ndarray,
+    sep_color: int,
+    sep_rows: list[int],
+    sep_cols: list[int],
+    row_ranges: list[tuple[int, int]],
+    col_ranges: list[tuple[int, int]],
+    index_map: dict[Coord, int],
