+
+
+def _path_in_gap_graph(adj: dict[int, set[int]], start: int, end: int) -> list[int]:
+    assert _component_is_tree(adj, start, end), "marker component must be a tree"
+    queue = deque([start])
+    parent = {start: None}
+    while queue:
+        cur = queue.popleft()
+        if cur == end:
+            break
+        for nxt in sorted(adj[cur]):
+            if nxt in parent:
+                continue
+            parent[nxt] = cur
+            queue.append(nxt)
+    assert end in parent, "marker regions must be connected by gaps"
+    path: list[int] = []
+    cur: int | None = end
+    while cur is not None:
+        path.append(cur)
+        cur = parent[cur]
+    path.reverse()
+    return path
