+            colors = np.unique(block)
+            assert len(colors) == 1, "each region must be uniform"
+            idx = len(regions)
+            index_map[(i, j)] = idx
+            regions.append(
+                {
+                    "index": idx,
+                    "cell": (i, j),
+                    "bbox": (r0, r1, c0, c1),
+                    "color": int(colors[0]),
+                    "edge": i == 0 or j == 0 or i == len(row_ranges) - 1 or j == len(col_ranges) - 1,
+                }
+            )
