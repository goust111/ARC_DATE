+        col_range = range(2, w - obj_w - 1)
+    elif side == "bottom":
+        row_range = range(2, min(h // 2, h - obj_h - 1))
+        col_range = range(2, w - obj_w - 1)
+    elif side == "left":
+        row_range = range(2, h - obj_h - 1)
+        col_range = range(max(3, w // 2 - 1), w - obj_w - 1)
+    else:
+        row_range = range(2, h - obj_h - 1)
+        col_range = range(2, min(w // 2, w - obj_w - 1))
