    if int(values[np.argmax(counts)]) != BG_COLOR:
        return None
    if not np.array_equal(main(inp), out):
        return None
    return inp


def generate_input():
    for _ in range(GEN_ATTEMPT_LIMIT):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid input")

