+    out[row_marker] = BG
+    out[col_marker] = BG
+
+    r0, c0, r1, c1 = frame_box
+    mr, mc = inner_marker
+    pr, pc = col_marker[0], row_marker[1]
+    wr0, wr1 = sorted((mr, pr))
+    wc0, wc1 = sorted((mc, pc))
