    dr, dc = _copy_delta(missing, src_color)
    dst_color = COPY_COLOR_BY_SOURCE[src_color]
    copy_occ = copy_by_color[GREEN] | copy_by_color[YELLOW]
    same_sources = source_by_color[src_color]
    candidates = []

