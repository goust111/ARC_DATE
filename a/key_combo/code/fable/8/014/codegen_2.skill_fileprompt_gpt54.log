  53: def main(grid: np.ndarray) -> np.ndarray:
  54:     """Recolor each query sprite by matching its shape, up to rotation/reflection, to a colored legend sprite.
  55: 
  56:     Input structure
  57:     A background grid contains a one-color L-shaped divider from the top edge to the left edge.  The upper-left
  58:     region inside that divider holds monochrome colored template sprites.  Elsewhere, all query sprites share one
  59:     non-template color.
  60: 
  61:     Rule
  62:     Read the upper-left templates as a shape-to-color legend.  For each query sprite, compare its connected-cell
  63:     shape to the legend shapes under all rotations and reflections, then recolor that sprite to the matched
  64:     template color.  Leave the divider, background, and legend pixels unchanged.
  65: 
  66:     Key insight
  67:     The divider marks a dictionary of sprite shapes; the query color is only a placeholder, and orientation does
  68:     not matter for the lookup.
  69:     """
  70:     g = np.asarray(grid, dtype=int)
  71:     bg = get_bg(g)
  72:     divider_color, divider_r, divider_c = _find_legend_divider(g, bg)
  73: 
  74:     legend = g[:divider_r, :divider_c]
  75:     template_by_shape: dict[tuple[tuple[int, int], ...], int] = {}
  76:     template_colors: set[int] = set()
  77:     for comp in find_components(legend, bg=bg, connectivity=4, monochromatic=True):
  78:         color = int(comp["color"])
  79:         assert color != divider_color, "divider color must not appear inside the legend interior"
  80:         key = _canonical_shape(comp["coords"])
  81:         assert key not in template_by_shape, "each legend shape must map to exactly one color"
  82:         template_by_shape[key] = color
  83:         template_colors.add(color)
  84:     assert template_by_shape, "legend must contain at least one template sprite"
  85: 
  86:     role_colors = set(colors_present(g, exclude={bg, divider_color}))
  87:     query_colors = role_colors - template_colors
  88:     assert len(query_colors) == 1, "expected exactly one non-template query color"
  89:     query_color = next(iter(query_colors))
  90: 
  91:     out = g.copy()
  92:     for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[query_color]):
  93:         key = _canonical_shape(comp["coords"])
  94:         assert key in template_by_shape, "query sprite shape must occur in the legend"
  95:         coords = comp["coords"]
  96:         out[coords[:, 0], coords[:, 1]] = template_by_shape[key]
  97: 
  98:     return out
