   9: def main(grid: np.ndarray) -> np.ndarray:
  10:     """Flood-fill each marked chamber bounded by walls with its marker color.
  11: 
  12:     Input structure
  13:     A same-size grid has a dominant background/open color, one repeated wall color,
  14:     and one-cell colored markers sitting inside some wall-bounded open chambers.
  15: 
  16:     Rule
  17:     Infer the wall as the unique non-background color that appears more than once.
  18:     Treat wall pixels as barriers. For every 4-connected non-wall component, leave
  19:     it unchanged if it has no marker; otherwise assert it has exactly one marker and
  20:     recolor the whole component with that marker's color.
  21: 
  22:     Key insight
  23:     The repeated color is a maze wall that partitions the background into chambers;
  24:     the singleton marker inside a chamber supplies the fill color for that chamber.
  25:     """
  26:     g = np.asarray(grid, dtype=int)
  27:     out = g.copy()
  28:     bg = get_bg(g)
  29: 
  30:     counts = Counter(map(int, g.ravel()))
  31:     wall_colors = [color for color, count in counts.items() if color != bg and count > 1]
  32:     assert len(wall_colors) == 1
  33:     wall = wall_colors[0]
  34: 
  35:     marker_colors = [color for color in counts if color not in (bg, wall)]
  36:     assert all(counts[color] == 1 for color in marker_colors)
  37: 
  38:     h, w = g.shape
  39:     seen = np.zeros(g.shape, dtype=bool)
  40:     for sr in range(h):
  41:         for sc in range(w):
  42:             if seen[sr, sc] or g[sr, sc] == wall:
  43:                 continue
  44: 
  45:             component = []
  46:             markers = []
  47:             queue = deque([(sr, sc)])
  48:             seen[sr, sc] = True
  49:             while queue:
  50:                 r, c = queue.popleft()
  51:                 component.append((r, c))
  52:                 if g[r, c] != bg:
  53:                     markers.append((r, c))
  54:                 for nr, nc in neighbors4(r, c):
  55:                     if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and g[nr, nc] != wall:
  56:                         seen[nr, nc] = True
  57:                         queue.append((nr, nc))
  58: 
  59:             if markers:
  60:                 assert len(markers) == 1
  61:                 color = int(g[markers[0]])
  62:                 for r, c in component:
  63:                     out[r, c] = color
  64: 
  65:     return out
  66: 
  67: # --------------- generator (o5x) ---------------
  68: 
  69: # Neighborhood and sentinel values.
  70: _GEN_DIRS = ((1, 0), (-1, 0), (0, 1), (0, -1))
  71: _GEN_EMPTY_LABEL, _GEN_BG_COLOR, _GEN_WALL_COLOR = -1, 0, 5
  72: # Canvas, component counts, and wall budgets.
  73: _GEN_GRID_SIZES = [7, 9]
  74: _GEN_MARKED_COUNTS = [2, 3]
  75: _GEN_UNMARKED_COUNTS_7 = [5, 5, 6, 6, 7, 8]
  76: _GEN_UNMARKED_COUNT_RANGE_9 = (5, 8)
  77: _GEN_WALL_COUNTS_7 = [19, 20, 21]
  78: _GEN_WALL_COUNTS_9 = [32, 33, 34, 35, 36]
  79: _GEN_MAX_WALL_COMPONENT_7, _GEN_MAX_WALL_COMPONENT_9 = 9, 12
  80: # Chamber size ranges.
  81: _GEN_MARKED_SIZE_RANGE, _GEN_UNMARKED_SIZE_RANGE = (3, 13), (1, 10)
  82: # Validation thresholds.
  83: _GEN_MIN_WALL_4_COMPONENTS = 5
  84: _GEN_WALL_8_COMPONENT_MIN_FRACTION = 0.75
  85: _GEN_BORDER_WALL_RANGE = (8, 12)
