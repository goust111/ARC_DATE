  15: def main(grid: np.ndarray) -> np.ndarray:
  16:     """Erase the control bars and tile each matched sprite toward its bar.
  17: 
  18:     Input structure
  19:     - The background contains colored non-line sprites plus one-cell-thick control
  20:       bars.
  21:     - A horizontal bar has the same column span as a sprite; a vertical bar has
  22:       the same row span as a sprite.
  23: 
  24:     Rule
  25:     - Remove every control bar.
  26:     - For each bar, find the nearest sprite aligned with the bar's span on the
  27:       perpendicular axis.
  28:     - Repeat that sprite periodically from its original position toward the bar,
  29:       clipping at the grid boundary and leaving sprite-background cells empty.
  30: 
  31:     Key insight
  32:     - The bar is not copied itself; it gives the direction and terminal line for
  33:       repeating the aligned sprite motif.
  34:     """
  35:     g = np.asarray(grid, dtype=int)
  36:     bg = get_bg(g)
  37:     components = find_components(g, bg=bg, connectivity=4, monochromatic=True)
  38: 
  39:     sprites = []
  40:     bars = []
  41:     for component in components:
  42:         r0, c0, r1, c1 = component["bbox"]
  43:         height = r1 - r0 + 1
  44:         width = c1 - c0 + 1
  45:         if (height == 1) ^ (width == 1):
  46:             assert component["area"] == height * width
  47:             bars.append(component)
  48:         else:
  49:             assert height > 1 and width > 1
  50:             sprites.append(component)
  51: 
  52:     assert sprites
  53:     assert bars
  54: 
  55:     out = g.copy()
  56:     for bar in bars:
  57:         coords = bar["coords"]
  58:         out[coords[:, 0], coords[:, 1]] = bg
  59: 
  60:     for bar in bars:
  61:         br0, bc0, br1, bc1 = bar["bbox"]
  62:         bar_h = br1 - br0 + 1
  63:         bar_w = bc1 - bc0 + 1
  64: 
  65:         if bar_h == 1:
  66:             aligned = [
  67:                 sprite
  68:                 for sprite in sprites
  69:                 if sprite["bbox"][1] == bc0 and sprite["bbox"][3] == bc1
  70:             ]
  71:             above = [sprite for sprite in aligned if br0 < sprite["bbox"][0]]
  72:             below = [sprite for sprite in aligned if br0 > sprite["bbox"][2]]
  73:             assert bool(above) ^ bool(below)
  74:             if above:
  75:                 sprite = _nearest_unique(above, lambda s: s["bbox"][0] - br0)
  76:             else:
  77:                 sprite = _nearest_unique(below, lambda s: br0 - s["bbox"][2])
  78: 
  79:             sr0, sc0, _sr1, _sc1 = sprite["bbox"]
  80:             motif = crop_bbox(g, sprite["bbox"])
  81:             motif_h, motif_w = motif.shape
  82:             assert motif_w == bar_w
  83: 
  84:             if br0 < sr0:
  85:                 r = sr0
  86:                 while r + motif_h - 1 >= br0:
  87:                     paste(out, motif, r, sc0, transparent=bg, clip=True)
  88:                     r -= motif_h
  89:             else:
  90:                 r = sr0
  91:                 while r <= br0:
  92:                     paste(out, motif, r, sc0, transparent=bg, clip=True)
  93:                     r += motif_h
  94:         else:
  95:             aligned = [
  96:                 sprite
  97:                 for sprite in sprites
  98:                 if sprite["bbox"][0] == br0 and sprite["bbox"][2] == br1
  99:             ]
 100:             left = [sprite for sprite in aligned if bc0 < sprite["bbox"][1]]
 101:             right = [sprite for sprite in aligned if bc0 > sprite["bbox"][3]]
 102:             assert bool(left) ^ bool(right)
 103:             if left:
 104:                 sprite = _nearest_unique(left, lambda s: s["bbox"][1] - bc0)
