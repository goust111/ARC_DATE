+            current_silhouette,
+            (
+                (offset[0], patch.shape[0] - offset[0] - current_silhouette.shape[0]),
+                (offset[1], patch.shape[1] - offset[1] - current_silhouette.shape[1]),
+            ),
+            constant_values=False,
