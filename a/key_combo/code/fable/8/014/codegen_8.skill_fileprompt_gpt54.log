+    offsets: list[tuple[int, int] | None],
+    positions: list[tuple[int, int]],
+) -> np.ndarray:
+    out = np.full((GEN_MAX_CANVAS, GEN_MAX_CANVAS), GEN_BG, dtype=int)
+
