+    outer_r0, outer_c0 = positions[outer]
+    place(outer, outer_r0, outer_c0)
+    return out
+
+
+def _gen_attempt() -> np.ndarray | None:
+    chain = _make_chain()
+    if chain is None:
+        return None
+    masks, offsets = chain
