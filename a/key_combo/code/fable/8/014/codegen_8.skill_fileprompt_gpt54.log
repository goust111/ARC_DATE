+        rr0 = max(0, r0 - GEN_PLACEMENT_GAP)
+        cc0 = max(0, c0 - GEN_PLACEMENT_GAP)
+        rr1 = min(GEN_MAX_CANVAS, r0 + ph + GEN_PLACEMENT_GAP)
+        cc1 = min(GEN_MAX_CANVAS, c0 + pw + GEN_PLACEMENT_GAP)
