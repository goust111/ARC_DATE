+def _make_chain() -> tuple[list[np.ndarray], list[tuple[int, int] | None]] | None:
+    count = random.randint(2, 5)
+    tail = _random_connected_shape()
+    if tail is None:
+        return None
+
+    patches = [tail]
+    offsets: list[tuple[int, int] | None] = [None]
+    current_silhouette = tail
+
+    for _ in range(1, count):
