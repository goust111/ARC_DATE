+
+GEN_BG = 0
+GEN_MAX_CANVAS = 30
+GEN_PLACEMENT_GAP = 2
+GEN_RETRIES = 400
+
+
+def _random_connected_shape(min_cells: int = 3, max_cells: int = 7) -> np.ndarray | None:
