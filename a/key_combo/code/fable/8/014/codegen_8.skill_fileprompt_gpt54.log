+def _connected_components(mask: np.ndarray, connectivity: int) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    neigh = _neighbors4 if connectivity == 4 else _neighbors8
+    components: list[np.ndarray] = []
+
