COL_CHOICES = range(4, 16)
MIN_CANVAS_AREA = 20
AREA_PER_T = 8
AREA_EXTRA = 1

# Tetromino rendering.
UP_KIND = "up"
DOWN_KIND = "down"
PATCH_SHAPE = (2, 3)
T_COORDS = {UP_KIND: UP_T, DOWN_KIND: DOWN_T}

