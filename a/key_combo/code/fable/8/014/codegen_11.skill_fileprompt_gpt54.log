+        r, c = pos
+        grid[r, c] = int(color)
+        markers.append((int(color), int(r), int(c)))
+        occupied_boxes.append((r, c, r, c))
+
+    bonus_objects = random.randint(1, 2)
+    focus_order = list(range(len(markers)))
+    random.shuffle(focus_order)
