+    band_w = random.randint(3, min(7, w - 4))
+    spans = [span for span in (8, 10, 12, 14) if span <= h - 4]
+    if not spans:
+        return None
+    span = random.choice(spans)
+    c0 = random.randint(2, w - band_w - 3)
+    mid_c = c0 + band_w // 2
+    r1 = random.randint(1, h - span - 2)
+    r2 = r1 + span
+    obj_r0 = r1 + 2
+    obj_r1 = r2 - 2
