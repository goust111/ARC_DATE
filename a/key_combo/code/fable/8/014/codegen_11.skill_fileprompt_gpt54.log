+    boxes.extend((r, c, r, c) for r, c in markers)
+    return patch, [(obj_r0, c0)] + markers, boxes
+
+
+def _place_single_marker(
+    grid: np.ndarray,
+    occupied_boxes: list[tuple[int, int, int, int]],
+    min_gap: int,
+) -> tuple[int, int] | None:
+    h, w = grid.shape
