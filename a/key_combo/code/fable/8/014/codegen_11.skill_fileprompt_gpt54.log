    selected.add(bottom)
    selected.add(side)

    final_min, final_max = _gen_pixel_count_bounds(h * w, ASYMMETRIC_MAX_FILL_RATIO)
    base_min = max(final_min - ASYMMETRY_BREAK_PIXELS, _gen_count_units(w, selected))
