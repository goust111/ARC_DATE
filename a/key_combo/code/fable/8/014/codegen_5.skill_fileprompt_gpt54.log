+def _unique_unmatched_index(adj: list[list[bool]]) -> int:
+    n = len(adj)
+    used = [False] * n
+    solutions: list[tuple[int, tuple[tuple[int, int], ...]]] = []
+
+    def dfs(unmatched: int | None, pairs: list[tuple[int, int]]) -> None:
+        if len(solutions) > 1:
+            return
