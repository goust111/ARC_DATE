+def _compatibility_matrix(shapes: list[Shape]) -> list[list[bool]]:
+    n = len(shapes)
+    adj = [[False] * n for _ in range(n)]
+    for i in range(n):
+        for j in range(i + 1, n):
+            ok = _can_form_rectangle(shapes[i], shapes[j])
+            adj[i][j] = ok
+            adj[j][i] = ok
+    return adj
