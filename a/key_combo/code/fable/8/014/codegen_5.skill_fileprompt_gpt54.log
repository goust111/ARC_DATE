+
+def _component_crop(grid: np.ndarray, component: dict, bg: int) -> np.ndarray:
+    r0, c0, r1, c1 = component["bbox"]
+    out = np.full((r1 - r0 + 1, c1 - c0 + 1), int(bg), dtype=int)
+    coords = component["coords"]
