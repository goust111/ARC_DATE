+        for r, cut in enumerate(cuts):
+            left[r, : cut + 1] = True
+        right = ~left
+
+        shape_a = _mask_to_shape(left)
+        shape_b = _mask_to_shape(right)
+        if min(len(shape_a), len(shape_b)) < 3:
+            continue
