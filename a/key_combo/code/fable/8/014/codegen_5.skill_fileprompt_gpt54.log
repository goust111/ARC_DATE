+
+def generate_input() -> np.ndarray:
+    for _ in range(RETRY_LIMIT):
+        built = _build_candidate()
+        if built is None:
+            continue
+        grid, expected = built
+        if _valid_generated(grid, expected):
+            return grid
+    raise RuntimeError("failed to generate valid input for puzzle 5")

