+GEN_HEIGHT_RANGE = (14, 26)
+GEN_RIGHT_WIDTH_RANGE = (10, 18)
+GEN_LEGEND_GAP_CHOICES = (1, 2)
+GEN_TEMPLATE_SIZE_RANGE = (3, 5)
+GEN_TEMPLATE_MAX_SPAN = 4
+GEN_QUERY_BBOX_GAP = 2
+GEN_TOP_MARGIN_CHOICES = (0, 1, 2)
+GEN_RIGHT_MARGIN = 1
