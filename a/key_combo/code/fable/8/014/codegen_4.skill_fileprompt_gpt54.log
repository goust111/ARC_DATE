SYMMETRIC_HEIGHT_RANGE, SYMMETRIC_WIDTH_CHOICES = (3, 6), (5, 7, 9)
SYMMETRIC_MAX_FILL_RATIO = (55, 100)
# Asymmetric distractor mask bounds.
ASYMMETRIC_HEIGHT_RANGE, ASYMMETRIC_WIDTH_RANGE = (2, 8), (4, 9)
