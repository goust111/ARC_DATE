+def _paste(dst: np.ndarray, patch: np.ndarray, r0: int, c0: int, *, transparent: int) -> None:
+    mask = patch != int(transparent)
+    h, w = patch.shape
+    dst[r0 : r0 + h, c0 : c0 + w][mask] = patch[mask]
