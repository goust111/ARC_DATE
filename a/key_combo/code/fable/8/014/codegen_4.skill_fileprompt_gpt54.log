+        return None
+
+    if _bg_color(grid) != bg:
+        return None
+
+    expected = _expected_output(template_colors, counts)
+    try:
+        actual = main(grid)
+    except Exception:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _attempt()
+        if grid is not None:
