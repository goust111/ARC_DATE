+            if c0 + w + GEN_RIGHT_MARGIN > grid_w:
+                continue
+            bbox = (r0, c0, r0 + h - 1, c0 + w - 1)
+            if any(not _bbox_far_enough(bbox, other, GEN_QUERY_BBOX_GAP) for other in existing):
