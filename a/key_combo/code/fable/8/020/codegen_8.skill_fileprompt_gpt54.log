        else:
            raise AssertionError("trace segments must be horizontal or vertical")

    paint_cell(r, c)
    while True:
        rr, cc = r + dr, c + dc
        hit = None
        while in_bounds(g.shape, rr, cc):
            val = int(g[rr, cc])
            if val in (blue, green):
                hit = (rr, cc)
                break
            assert val in (bg, red)
