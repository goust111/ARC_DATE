    r0, c0, r1, c1 = map(int, rect["bbox"])
    h = bbox_h(rect["bbox"])
    w = bbox_w(rect["bbox"])

    out = np.full_like(g, bg)
    out[r0 : r1 + 1, c0 : c1 + 1] = Color.RED

    destinations = []
    marker_entries: list[tuple[int, tuple[int, int], bool]] = []
    for comp in markers:
