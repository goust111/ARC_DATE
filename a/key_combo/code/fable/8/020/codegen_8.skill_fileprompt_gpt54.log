        if dr:
            assert r0 == r1
        else:
            assert c0 == c1
        for rr, cc in comp["coords"]:
            key = (int(rr), int(cc))
            assert key not in component_at
            component_at[key] = comp

    out = g.copy()

    def paint_cell(rr: int, cc: int) -> None:
