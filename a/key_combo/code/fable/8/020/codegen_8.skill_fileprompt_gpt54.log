+            for rr in range(row_step):
+                for cc in range(col_step):
+                    patch = g[rr::row_step, cc::col_step]
+                    if np.unique(patch).size > 1:
+                        variable.append((rr, cc, patch))
+
+            if len(variable) != 1:
+                continue
+
