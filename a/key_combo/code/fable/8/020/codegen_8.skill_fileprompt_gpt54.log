    def paint_line(a: tuple[int, int], b: tuple[int, int]) -> None:
        ar, ac = a
        br, bc = b
        if ar == br:
            step = 1 if bc >= ac else -1
            for cc in range(ac, bc + step, step):
                paint_cell(ar, cc)
        elif ac == bc:
            step = 1 if br >= ar else -1
            for rr in range(ar, br + step, step):
