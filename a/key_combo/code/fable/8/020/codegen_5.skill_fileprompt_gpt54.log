+def _choose_distinct(colors: list[int], count: int) -> list[int]:
+    if count <= 0:
+        return []
+    if count <= len(colors):
+        picked = random.sample(colors, count)
+    else:
+        picked = []
+        while len(picked) < count:
+            pool = colors.copy()
+            random.shuffle(pool)
+            for color in pool:
+                if not picked or color != picked[-1]:
+                    picked.append(color)
+                if len(picked) == count:
+                    break
