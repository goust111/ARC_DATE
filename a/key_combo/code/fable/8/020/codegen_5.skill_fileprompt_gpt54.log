+        for r, c in interior:
+            distances = [abs(r - ar) + abs(c - ac) for ar, ac in anchors]
+            best = min(distances)
+            choices = [i for i, d in enumerate(distances) if d == best]
+            owner = random.choice(choices)
+            parts[owner].append((r, c))
