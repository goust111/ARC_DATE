+FIXED_RUN_WIDTHS = (1, 2)
+STRETCH_RUN_WIDTHS = (2, 3, 4)
+PALETTE = tuple(range(1, 10))
+COPY_COUNTS = (2, 3)
+TARGET_COUNT_OPTIONS = (1, 2, 3)
