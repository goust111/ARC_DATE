+def _build_exemplar() -> tuple[np.ndarray, int]:
+    palette = random.sample(PALETTE, 5)
+    outer = int(palette[0])
+    non_outer = [int(c) for c in palette[1:]]
+    base = int(non_outer[0])
+    center = int(non_outer[1])
