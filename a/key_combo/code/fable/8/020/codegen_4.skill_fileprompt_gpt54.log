+    count: int,
+    taken: set[tuple[int, int]],
+) -> list[tuple[int, int]]:
+    chosen: list[tuple[int, int]] = []
+    for pos in candidates:
+        if pos in taken:
+            continue
+        if any(abs(pos[0] - rr) <= 1 and abs(pos[1] - cc) <= 1 for rr, cc in chosen):
+            continue
+        if any(abs(pos[0] - rr) <= 1 and abs(pos[1] - cc) <= 1 for rr, cc in taken):
