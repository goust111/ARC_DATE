                assert in_bounds(out.shape, rr, cc), "stamped sprite must stay inside the grid"
                assert int(out[rr, cc]) in (bg, int(sprite_color)), "stamped sprites must not collide"
                out[rr, cc] = int(sprite_color)

    return out

