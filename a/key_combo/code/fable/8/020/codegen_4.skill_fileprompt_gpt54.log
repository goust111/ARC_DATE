+
+def _sample_lanes(width: int, n_hits: int) -> list[int] | None:
+    for _ in range(120):
+        lane = random.randint(3, width - 4)
+        lanes = [lane]
+        shifts: list[int] = []
+        ok = True
+        for idx in range(n_hits):
