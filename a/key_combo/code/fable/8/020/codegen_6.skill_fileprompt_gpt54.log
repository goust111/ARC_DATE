+            side = random.choice(("top", "bottom", "left", "right"))
+            if side in ("top", "bottom"):
+                span = random.randint(1, base_w)
+                start = left + random.randint(0, base_w - span)
+                depth = random.randint(1, 2)
+                if side == "top":
+                    canvas[top - depth : top, start : start + span] = True
+                else:
