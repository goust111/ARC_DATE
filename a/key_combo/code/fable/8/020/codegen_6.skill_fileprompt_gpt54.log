+def scatter_patches(patches: list[np.ndarray]) -> np.ndarray:
+    order = sorted(range(len(patches)), key=lambda i: -(patches[i] != 0).sum())
+    max_h = max(p.shape[0] for p in patches)
+    max_w = max(p.shape[1] for p in patches)
+
+    for padding in (2, 1):
