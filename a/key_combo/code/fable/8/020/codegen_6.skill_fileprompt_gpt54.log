+    raise RuntimeError("failed to scatter patches")
+
+
+def build_chain():
+    n_pieces = random.randint(2, 4)
+    silhouettes = []
+    occupied_masks = []
+    signatures = set()
+
+    inner = random_silhouette(min_side=2, max_side=4, max_dim=7)
