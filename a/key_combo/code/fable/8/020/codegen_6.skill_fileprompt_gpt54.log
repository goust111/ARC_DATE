+            width = random.randint(max(max_w + 2, 18), 30)
+            grid = np.zeros((height, width), dtype=int)
+            boxes = []
+            ok = True
+            for idx in order:
+                patch = patches[idx]
+                ph, pw = patch.shape
+                spots = []
+                row_min = 1
+                row_max = height - ph - 1
+                col_min = 1
+                col_max = width - pw - 1
+                if row_max < row_min or col_max < col_min:
+                    ok = False
+                    break
+                for _ in range(250):
+                    r = random.randint(row_min, row_max)
+                    c = random.randint(col_min, col_max)
