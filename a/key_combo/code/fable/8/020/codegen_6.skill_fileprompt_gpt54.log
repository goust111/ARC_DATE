+def enclosed_background(object_mask: np.ndarray) -> np.ndarray:
+    h, w = object_mask.shape
+    bg_mask = ~object_mask
+    outside = np.zeros((h, w), dtype=bool)
+    q = deque()
+
+    for r in range(h):
+        for c in (0, w - 1):
