+    components: list[list[tuple[int, int]]] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not open_mask[r, c] or labels[r, c] != -1:
+                continue
+            label = len(components)
+            cells: list[tuple[int, int]] = []
+            queue = deque([(r, c)])
+            labels[r, c] = label
+            while queue:
