spec:
  grid: 19-30 rows x 19-30 cols, square [observed]
  colors: exactly 2 input colors; one lattice color fills entire outer border, the other is the cell color
  lattice_color: blue(1) [observed]; solver allows any color that fills entire border
  cell_color: black(0) [observed]; solver allows any non-lattice color
  lattice:
    structure: separates rectangular 4-connected cell regions into a complete NxN array
    interior_gap: 1-2 pixels, uniform within grid [observed]; row gap == col gap [observed]
    border_top_left: 1 pixel [observed]
    border_bottom_right: 1 or equal to interior_gap [observed]
  cell_regions:
    array_size: 3-11 rows x 3-11 cols (>= 3x3 required); rows == cols [observed]
    cell_size: 1-4 pixels, uniform and square within grid [observed]
    every slot in the NxN array must be filled (complete rectangular array)
  output:
    same dimensions as input; lattice pixels preserved
    perimeter cell regions (first/last row or first/last column of array) -> red(2)
    strictly interior cell regions -> green(3)
generation_strategy:
  approach: direct construction (simple parameterized grid, no inversion needed)
  steps:
    1. pick N = array_size (3-11), cell_size (1-4), gap (1-2)
    2. pick border_top_left = 1, border_bottom_right in {1, gap}
    3. compute grid_dim = border_top_left + N * cell_size + (N-1) * gap + border_bottom_right
    4. reject if grid_dim < 19 or > 30
    5. fill grid with lattice_color (e.g. blue)
    6. for each (i, j) in NxN array, compute top-left corner and fill cell_size x cell_size block with cell_color (e.g. black)
