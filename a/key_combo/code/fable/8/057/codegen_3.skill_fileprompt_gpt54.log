+                if overlap <= 0:
+                    continue
+                union_h = max(anchor.shape[0], dr + mh) - min(0, dr)
+                union_w = max(anchor.shape[1], dc + mw) - min(0, dc)
+                score = (overlap, -(union_h * union_w))
+                candidate = {
+                    "variant": variant,
+                    "dr": dr,
+                    "dc": dc,
+                    "overlap": overlap,
+                    "score": score,
+                    "mover": mover,
+                }
