+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        rng = np.random.default_rng()
+        built = _build_case(rng)
+        if built is not None:
+            return built[0]
+    raise RuntimeError(f"generate_input failed after {GEN_RETRIES} attempts")

