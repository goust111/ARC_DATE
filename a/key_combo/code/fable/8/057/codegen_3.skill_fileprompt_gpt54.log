+
+
+def _search_alignment(anchor: np.ndarray, mover_input: np.ndarray) -> dict:
+    best = None
+    best_overlap = -1
+    second_overlap = -1
+    tie_count = 0
+
+    for variant in range(len(D4_VARIANTS)):
+        mover = _transform(mover_input, variant)
