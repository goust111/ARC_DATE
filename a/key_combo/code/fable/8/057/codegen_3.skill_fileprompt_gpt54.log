  sprites:
    count_per_color: one color has 1 copy, the other has 1-5 copies; total 3-6 sprites
    bbox_size: both colors share identical bbox size; 2x2, 2x3, or 3x3
    mask: each color has a single 8-connected template mask; the two masks differ
    mask_density: 50-75% of bbox cells filled
    area: 2-6 cells per sprite
    all_copies_identical: all copies of the same color use the exact same mask
  placement:
