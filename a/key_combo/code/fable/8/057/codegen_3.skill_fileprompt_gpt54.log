+        sub = g[r0 : r1 + 1, c0 : c1 + 1]
+        colors = [int(x) for x in np.unique(sub[sub != bg])]
+        if len(colors) != 1:
+            raise AssertionError("each remnant must be monochromatic")
+        mask = sub == colors[0]
+        remnants.append(
