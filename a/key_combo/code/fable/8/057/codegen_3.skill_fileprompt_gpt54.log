+                candidate = {
+                    "variant": variant,
+                    "dr": dr,
+                    "dc": dc,
+                    "overlap": overlap,
+                    "score": score,
+                    "mover": mover,
+                }
+                if overlap > best_overlap:
+                    second_overlap = best_overlap
+                    best_overlap = overlap
