+from __future__ import annotations
+
+from collections import Counter, deque
+
+import numpy as np
+
+
+BG = 0
+OVERLAP_COLOR = 5
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+
+D4_VARIANTS = tuple((rot, flip) for rot in range(4) for flip in (False, True))
+
+GEN_RETRIES = 500
+CANVAS_MIN = 18
+CANVAS_MAX = 28
+LOCAL_SIDE_MIN = 9
+LOCAL_SIDE_MAX = 13
