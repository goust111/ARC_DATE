+
+
+def _pick_distinct_frontier_seeds(
+    rng: np.random.Generator, core: np.ndarray
+) -> tuple[tuple[int, int], tuple[int, int]] | None:
+    cells = _frontier(core)
+    if len(cells) < 2:
+        return None
+    best_dist = -1
+    pairs = []
+    for i, a in enumerate(cells):
+        for b in cells[i + 1 :]:
+            dist = abs(a[0] - b[0]) + abs(a[1] - b[1])
+            if dist > best_dist:
+                best_dist = dist
+                pairs = [(a, b)]
+            elif dist == best_dist:
+                pairs.append((a, b))
