+
+    anchor_crop, _anchor_box = _crop_mask(anchor_aligned)
+    mover_crop_aligned, _mover_box = _crop_mask(mover_aligned)
+
+    variant_pool = np.array([0, 1, 2, 3, 4, 5, 6, 7, 1, 3, 5, 7], dtype=int)
