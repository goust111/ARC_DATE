+    ah, aw = anchor.shape
+    mh, mw = mover.shape
+    top = min(0, dr)
+    left = min(0, dc)
+    bottom = max(ah, dr + mh)
+    right = max(aw, dc + mw)
+    out = np.zeros((bottom - top, right - left), dtype=int)
