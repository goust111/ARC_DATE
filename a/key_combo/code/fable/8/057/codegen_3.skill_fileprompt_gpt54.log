+import numpy as np
+
+
+BG = 0
+OVERLAP_COLOR = 5
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+
+D4_VARIANTS = tuple((rot, flip) for rot in range(4) for flip in (False, True))
+
+GEN_RETRIES = 500
+CANVAS_MIN = 18
+CANVAS_MAX = 28
+LOCAL_SIDE_MIN = 10
+LOCAL_SIDE_MAX = 14
+CORE_AREA_RANGE = (10, 16)
+ANCHOR_EXTRA_RANGE = (4, 7)
+MOVER_EXTRA_RANGE = (3, 5)
+MIN_OVERLAP = 6
+MIN_EXCLUSIVE = 3
