+
+
+def _transform(mask: np.ndarray, variant: int) -> np.ndarray:
+    rot, flip = D4_VARIANTS[int(variant)]
+    out = np.rot90(np.asarray(mask, dtype=bool), k=rot)
+    if flip:
+        out = np.fliplr(out)
