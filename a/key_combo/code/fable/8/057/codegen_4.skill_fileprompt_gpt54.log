+def _extract_rings(grid: np.ndarray, bg: int) -> list[dict]:
+    rings: list[dict] = []
+    for component in _find_monochrome_components(grid, bg):
+        ring = _ring_signature(grid, component, bg)
+        if ring is not None:
+            rings.append(ring)
+    return rings
