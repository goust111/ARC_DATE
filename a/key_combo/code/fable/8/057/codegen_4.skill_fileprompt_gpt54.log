+
+def _sample_chain_specs() -> list[dict] | None:
+    length = random.randint(*CHAIN_LEN_RANGE)
+    tail_outer = random.randint(*TAIL_OUTER_RANGE)
+    tail_thickness_max = min(4, (tail_outer - 1) // 2)
