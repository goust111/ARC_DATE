+def _between_links(spec: dict, chain_specs: list[dict]) -> bool:
+    outer = int(spec["outer"])
+    for idx in range(len(chain_specs) - 1):
+        if int(chain_specs[idx]["outer"]) > outer > int(chain_specs[idx + 1]["outer"]):
+            return True
+    return False
