+    for color in sorted(set(map(int, grid.ravel())) - {int(bg)}):
+        seen = np.zeros((h, w), dtype=bool)
+        mask = grid == int(color)
+        for r in range(h):
+            for c in range(w):
+                if not mask[r, c] or seen[r, c]:
+                    continue
+                queue: deque[tuple[int, int]] = deque([(r, c)])
+                seen[r, c] = True
+                coords: list[tuple[int, int]] = []
+                while queue:
+                    rr, cc = queue.popleft()
+                    coords.append((rr, cc))
+                    for nr, nc in _neighbors4(rr, cc):
