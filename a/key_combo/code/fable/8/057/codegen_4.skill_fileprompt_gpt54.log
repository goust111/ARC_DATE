+    rings = _extract_rings(grid, BG)
+    if len(rings) != len(chain_specs) + len(distractor_specs):
+        return False
+
+    try:
+        chain = _find_chain_indices(rings)
+        out = main(grid)
+    except AssertionError:
+        return False
