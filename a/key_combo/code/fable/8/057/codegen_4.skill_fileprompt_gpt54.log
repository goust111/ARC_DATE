+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 0
+PALETTE = list(range(1, 10))
+
+CHAIN_LEN_RANGE = (3, 5)
+CHAIN_HEAD_OUTER_RANGE = (9, 18)
+TAIL_OUTER_RANGE = (3, 10)
+THICKNESS_CHOICES = (1, 1, 2, 2, 3, 3, 4)
+
+GRID_RANGE = (22, 30)
+PLACEMENT_GAP = 1
+GEN_RETRIES = 500
+PLACE_RETRIES = 40
+POSITION_SAMPLES = 240
