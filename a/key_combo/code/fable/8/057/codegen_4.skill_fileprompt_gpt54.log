+    seen: set[int] = set()
+    cur = heads[0]
+    while True:
+        assert cur not in seen, "chain must not cycle"
+        chain.append(cur)
+        seen.add(cur)
+        if not children[cur]:
+            break
+        cur = children[cur][0]
