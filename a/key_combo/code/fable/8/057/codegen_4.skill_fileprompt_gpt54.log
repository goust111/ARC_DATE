+        expected = np.ones((outer, outer), dtype=bool)
+        expected[thickness : thickness + hole, thickness : thickness + hole] = False
+        if np.array_equal(mask, expected):
+            return {
+                "color": color,
+                "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                "outer": outer,
+                "thickness": int(thickness),
