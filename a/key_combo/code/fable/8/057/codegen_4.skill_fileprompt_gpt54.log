+def _make_ring(outer: int, thickness: int, color: int, bg: int = BG) -> np.ndarray:
+    patch = np.full((outer, outer), int(color), dtype=int)
+    hole = outer - 2 * thickness
+    patch[thickness : thickness + hole, thickness : thickness + hole] = int(bg)
+    return patch
