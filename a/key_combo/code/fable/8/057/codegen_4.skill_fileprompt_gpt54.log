+        if not candidates:
+            return None
+        weighted = [spec for spec in candidates if _between_links(spec, chain_specs)]
+        moderate = [spec for spec in (weighted or candidates) if int(spec["outer"]) <= head_outer + 3]
+        selected.append(random.choice(moderate or weighted or candidates))
+
+    return selected
+
