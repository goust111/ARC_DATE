+BG = 0
+PALETTE = list(range(1, 10))
+
+CHAIN_LEN_RANGE = (3, 5)
+CHAIN_HEAD_OUTER_RANGE = (9, 14)
+TAIL_OUTER_RANGE = (3, 8)
+THICKNESS_CHOICES = (1, 1, 2, 2, 3)
