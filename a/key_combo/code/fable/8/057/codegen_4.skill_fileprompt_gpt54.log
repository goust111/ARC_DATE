+    h, w = grid.shape
+    components: list[dict] = []
+    for color in sorted(set(map(int, grid.ravel())) - {int(bg)}):
+        seen = np.zeros((h, w), dtype=bool)
+        mask = grid == int(color)
+        for r in range(h):
+            for c in range(w):
