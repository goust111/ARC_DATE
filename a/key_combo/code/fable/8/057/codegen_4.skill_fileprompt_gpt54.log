+    return _render_chain(chain_specs, list(range(len(chain_specs))), BG)
+
+
+def _validate_generated(grid: np.ndarray, chain_specs: list[dict], distractor_specs: list[dict]) -> bool:
+    rings = _extract_rings(grid, BG)
