+def _ring_signature(grid: np.ndarray, component: dict, bg: int) -> dict | None:
+    r0, c0, r1, c1 = component["bbox"]
+    patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+    color = int(component["color"])
