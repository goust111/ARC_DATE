+def _orbit(shape: tuple[int, int], r: int, c: int) -> list[tuple[int, int]]:
+    h, w = shape
+    mr = h - 1 - r
+    mc = w - 1 - c
+    coords = [(r, c), (r, mc), (mr, c), (mr, mc)]
