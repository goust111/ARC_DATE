+
+def _separated_from_existing(
+    cells: set[tuple[int, int]],
+    occupied: set[tuple[int, int]],
+    forbidden: set[tuple[int, int]],
+) -> bool:
+    if cells & forbidden:
+        return False
+    for r, c in cells:
+        for rr in range(r - 1, r + 2):
+            for cc in range(c - 1, c + 2):
+                if (rr, cc) in occupied:
+                    return False
