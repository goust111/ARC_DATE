+    return None
+
+
+def _paint_object(grid: np.ndarray, obj: dict[str, object]) -> None:
+    for r, c in obj["grey"]:
+        grid[r, c] = GREY
+    for (r, c), color in obj["seeds"]:
+        grid[r, c] = color
+
+
+def _validate_case(grid: np.ndarray) -> tuple[bool, str]:
