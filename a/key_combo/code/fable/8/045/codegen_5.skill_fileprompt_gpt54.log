  "transform": "crop the unique rectangle whose 4-connected marker-color mask has the most five-pixel objects; preserve the rectangle unchanged",
  "grid_shape": "bbox of the selected rectangle"
}
</annotation>
<generation_spec>
```yaml
spec:
  grid: 22-24 rows x 20-24 cols
  colors:
    bg: 0 (black) [observed]
    fill: 8 (azure) [observed]
    marker: 3 (green) [observed]
    exactly 2 foreground colors; marker is the rarer one globally
  regions:
    count: 3-4 solid rectangles on bg, non-overlapping, separated by >=1 bg gap
    dimensions: 5-10 rows x 7-11 cols per rectangle
    each rectangle is fully filled (no bg inside), containing fill + marker pixels
  marker_objects:
    shape: all area-5 marker components are plus-signs (3x3 cross) [observed]
    plus_centers: >=1 cell from rectangle border (arms fit inside)
    min_manhattan_distance_between_centers: >=4
    distractors: 1-9 additional marker components per region, each size 1 or 2
  selection_rule:
    count area-5 (plus-sign) marker components per region
    winner: unique region with the most plus-signs (1-5 per region; winner has 3-5)
    all other regions have strictly fewer
  output: the winning rectangle cropped unchanged

generation_strategy:
  approach: direct construction with winner guarantee
  steps:
    1. pick N=3-4, choose grid size ~22-24 x 20-24
    2. for each region, pick dimensions 5-10 x 7-11
    3. assign plus-sign counts so exactly one region has the unique max (e.g. counts [2,1,4,3])
    4. for each region, fill with fill color, then place plus-signs (3x3 cross) at random
       non-overlapping positions with centers >=1 from border and mutual manhattan dist >=4
    5. scatter 1-9 size-1/2 marker distractors on remaining fill pixels per region
    6. place all regions on a bg grid with >=1 bg gap between any two regions
    7. output = the winning region (the one with the most plus-signs)
