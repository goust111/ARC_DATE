+
+
+def _translate_cells(cells: list[tuple[int, int]], dr: int, dc: int) -> list[tuple[int, int]]:
+    return [(r + dr, c + dc) for r, c in cells]
+
+
+def _translated_object(
+    obj: dict[str, object],
+    dr: int,
+    dc: int,
+) -> dict[str, object]:
