+    for info in non_pure_infos:
+        for r, c in info["coords"]:
+            if out[r, c] != GREY:
+                return False, "non_pure_changed"
+        endpoints = []
+        if info.get("endpoints") is not None:
+            endpoints = list(info["endpoints"])
+        else:
