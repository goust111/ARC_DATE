+        nxt, direction, hit_grey, hit_edge = _step_after_reflection(out.shape, grey_mask, current, direction)
+        if hit_grey:
+            grey_hits += 1
+            if toggle_rewind:
+                idx_step *= -1
+        if hit_edge:
+            edge_hits += 1
+        current = nxt
+        out[current] = seq[idx]
+        path.append(current)
+        reverse_steps += int(idx_step == -1)
+        idx = (idx + idx_step) % len(seq)
