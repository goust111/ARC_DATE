0007: def main(grid: np.ndarray) -> np.ndarray:
0008:     """Continue the grey-bracketed top motif downward through the empty suffix.
0009: 
0010:     Input structure
0011:     The grid has a black background. A contiguous run of grey pixels begins at
0012:     the top of the leftmost column; those grey pixels mark the rows of a colored
0013:     motif. Below the marked rows there may be other foreground rows, followed by
0014:     an all-background suffix.
0015: 
0016:     Rule
0017:     Copy the marked rows as a motif after changing the grey marker cells to
0018:     background. Starting just below the lowest existing foreground row, write
0019:     those motif rows cyclically into the empty suffix, preserving the original
0020:     grid everywhere else.
0021: 
0022:     Key insight
0023:     The grey segment is a bracket for the motif height; the fill below the
0024:     existing drawing restarts from the first marked row rather than continuing
0025:     from any unmarked foreground row.
0026:     """
0027:     g = np.asarray(grid, dtype=int)
0028:     assert g.ndim == 2, "expected a 2D grid"
0029:     assert min(g.shape) > 0, "expected a nonempty grid"
0030: 
0031:     bg = get_bg(g)
0032:     assert bg == Color.BLACK, "expected black background"
0033: 
0034:     marker_rows = np.flatnonzero(g[:, 0] == Color.GREY)
0035:     assert marker_rows.size > 0, "expected grey marker rows"
0036:     assert np.array_equal(marker_rows, np.arange(marker_rows.size)), "grey marker must be a top-left run"
0037:     assert np.count_nonzero(g == Color.GREY) == marker_rows.size, "grey pixels are only the row markers"
0038: 
0039:     motif = g[: marker_rows.size].copy()
0040:     motif[:, 0] = bg
0041:     assert np.all(np.any(motif != bg, axis=1)), "each marked row must contain motif pixels"
0042: 
0043:     foreground_rows = np.flatnonzero(np.any(g != bg, axis=1))
0044:     assert foreground_rows.size > 0, "expected foreground"
0045:     start = int(foreground_rows[-1]) + 1
0046:     assert np.all(g[start:] == bg), "suffix below the drawing must be empty"
0047: 
0048:     out = g.copy()
0049:     for r in range(start, g.shape[0]):
0050:         motif_row = motif[(r - start) % motif.shape[0]]
0051:         paint = motif_row != bg
0052:         out[r, paint] = motif_row[paint]
0053:     return out
