0038: def main(grid: np.ndarray) -> np.ndarray:
0039:     """
0040:     Crop out the rectangle whose marker-color mask contains the most five-pixel connected objects.
0041: 
0042:     Input structure:
0043:     - A boundary-colored background separates several solid rectangular foreground regions.
0044:     - Each region is made from two foreground colors: a dominant fill color and a rarer marker color.
0045:     - The marker-color pixels form 4-connected objects of several sizes.
0046: 
0047:     Rule:
0048:     - Infer the background as the unique dominant boundary color and the marker color as the unique rarer non-background color.
0049:     - For each foreground rectangle, count 4-connected marker-color objects with area exactly five pixels.
0050:     - Return the unique rectangle with the largest count, unchanged.
0051: 
0052:     Key insight:
0053:     - The desired crop is not determined by position or size; it is the region containing the most complete five-pixel marker objects.
0054:     """
0055:     g = np.asarray(grid, dtype=int)
0056:     bg = _boundary_bg(g)
0057:     marker = _marker_color(g, bg)
0058: 
0059:     regions = find_components(g, bg=bg, connectivity=4, monochromatic=False)
0060:     assert len(regions) >= 2, "expected multiple candidate foreground rectangles"
0061: 
0062:     scored_regions: list[tuple[int, np.ndarray]] = []
0063:     for region in regions:
0064:         rect = crop_bbox(g, region["bbox"])
0065:         assert np.all(rect != bg), "each foreground component must fill its rectangular bbox"
0066:         scored_regions.append((_area_five_marker_count(rect, marker), rect))
0067: 
0068:     best_score = max(score for score, _rect in scored_regions)
0069:     winners = [rect for score, rect in scored_regions if score == best_score]
0070:     assert len(winners) == 1, "expected a unique rectangle with the most area-five marker objects"
0071:     return winners[0]
