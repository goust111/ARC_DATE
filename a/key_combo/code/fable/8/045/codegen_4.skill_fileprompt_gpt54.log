0137: def main(grid: np.ndarray) -> np.ndarray:
0138:     """Recolor the grey diagonal-chain regions in an orange field to teal.
0139: 
0140:     Input structure
0141:     The input contains only grey pixels and orange pixels.  Grey pixels form
0142:     several 8-connected regions embedded in the orange field.
0143: 
0144:     Rule
0145:     Decompose each grey 8-connected region into 4-connected lobes.  Recolor the
0146:     whole region teal only when it contains a straight diagonal run of at least
0147:     three pixels and those lobes meet only by diagonal corner contacts in a
0148:     non-branching diagonal chain or cycle; a single 4-connected region is
0149:     recolored only when it is a square diagonal staircase.
0150: 
0151:     Key insight
0152:     The teal regions are not selected by size or position; they are the grey
0153:     regions whose internal connectivity depends on diagonal corner joins, while
0154:     same-edge cracks, rectangles, bars, and branching/noisy regions remain grey.
0155:     """
0156:     g = np.asarray(grid, dtype=int)
0157:     assert g.ndim == 2
0158:     assert set(np.unique(g)) == {Color.GREY, Color.ORANGE}
0159: 
0160:     out = g.copy()
0161:     lab8, n8 = label_mask(g == Color.GREY, connectivity=8)
0162:     assert n8 >= 1
0163: 
0164:     for k in range(1, n8 + 1):
0165:         mask = lab8 == k
0166:         if _is_target_region(mask):
0167:             out[mask] = Color.TEAL
0168: 
0169:     return out
