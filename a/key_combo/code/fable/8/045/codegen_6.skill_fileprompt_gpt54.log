84:     # We are going to generate a grid with a symmetric pattern and a non-symmetric object in one of its quadrants
85:     
86:     # Generate the symmetric pattern
87:     symmetric_sprite = random_sprite(range(3, 6), range(3, 6),
88:                                      color_palette=[random.choice(Color.NOT_BLACK)], connectivity=8, 
