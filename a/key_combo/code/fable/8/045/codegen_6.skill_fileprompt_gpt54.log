6: def main(grid: np.ndarray) -> np.ndarray:
7:     """
8:     Recolor the smallest black region orange and the largest black region teal.
9: 
10:     Input structure:
11:     - The grid contains only black background regions and grey one-cell-wide walls.
12:     - The grey walls partition the black pixels into multiple 4-connected regions.
13:     - The smallest and largest black regions are each unique.
14: 
15:     Rule:
16:     - Find all 4-connected black regions.
17:     - Recolor every pixel of the unique smallest black region orange.
18:     - Recolor every pixel of the unique largest black region teal.
19:     - Preserve all grey pixels and all other black regions.
20: 
21:     Key insight:
22:     - The colors mark extreme region size among the black cells; the region location
23:       and shape do not otherwise determine the output.
24:     """
25:     g = np.asarray(grid, dtype=int)
26:     colors = set(map(int, g.ravel()))
27:     assert Color.BLACK in colors
28:     assert Color.GREY in colors
29:     assert colors <= {Color.BLACK, Color.GREY}
30: 
31:     regions = components_mask(g == Color.BLACK, connectivity=4)
32:     assert len(regions) >= 2
33: 
34:     areas = np.array([int(region.shape[0]) for region in regions], dtype=int)
35:     small_indices = np.flatnonzero(areas == areas.min())
36:     large_indices = np.flatnonzero(areas == areas.max())
37:     assert small_indices.size == 1
38:     assert large_indices.size == 1
39:     assert int(small_indices[0]) != int(large_indices[0])
40: 
41:     out = g.copy()
42:     small_region = regions[int(small_indices[0])]
43:     large_region = regions[int(large_indices[0])]
44:     out[small_region[:, 0], small_region[:, 1]] = Color.ORANGE
45:     out[large_region[:, 0], large_region[:, 1]] = Color.TEAL
46:     return out
47: 
