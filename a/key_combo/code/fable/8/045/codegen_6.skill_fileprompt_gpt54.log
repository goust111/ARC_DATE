8: 
9: def _boundary_bg(g: np.ndarray) -> int:
10:     assert g.ndim == 2, "expected a 2D grid"
11:     height, width = map(int, g.shape)
12:     assert height >= 2 and width >= 2, "expected a grid with a boundary"
13: 
14:     boundary = np.concatenate((g[0, :], g[-1, :], g[1:-1, 0], g[1:-1, -1]))
15:     colors, counts = np.unique(boundary, return_counts=True)
16:     max_count = int(counts.max())
17:     winners = colors[counts == max_count]
18:     assert winners.size == 1, "expected a unique dominant boundary background color"
19:     return int(winners[0])
20: 
21: 
22: def _marker_color(g: np.ndarray, bg: int) -> int:
23:     colors = colors_present(g, exclude={bg})
24:     assert len(colors) == 2, "expected exactly two foreground colors"
25: 
26:     counts = {color: int(np.sum(g == color)) for color in colors}
27:     min_count = min(counts.values())
28:     markers = [color for color, count in counts.items() if count == min_count]
29:     assert len(markers) == 1, "expected a unique rarer foreground marker color"
30:     return int(markers[0])
31: 
32: 
33: def _area_five_marker_count(rect: np.ndarray, marker: int) -> int:
34:     marker_components = components_mask(rect == int(marker), connectivity=4)
35:     return sum(1 for coords in marker_components if int(coords.shape[0]) == 5)
36: 
37: 
38: def main(grid: np.ndarray) -> np.ndarray:
39:     """
40:     Crop out the rectangle whose marker-color mask contains the most five-pixel connected objects.
41: 
42:     Input structure:
43:     - A boundary-colored background separates several solid rectangular foreground regions.
44:     - Each region is made from two foreground colors: a dominant fill color and a rarer marker color.
45:     - The marker-color pixels form 4-connected objects of several sizes.
46: 
47:     Rule:
48:     - Infer the background as the unique dominant boundary color and the marker color as the unique rarer non-background color.
49:     - For each foreground rectangle, count 4-connected marker-color objects with area exactly five pixels.
50:     - Return the unique rectangle with the largest count, unchanged.
51: 
52:     Key insight:
53:     - The desired crop is not determined by position or size; it is the region containing the most complete five-pixel marker objects.
54:     """
55:     g = np.asarray(grid, dtype=int)
56:     bg = _boundary_bg(g)
57:     marker = _marker_color(g, bg)
58: 
59:     regions = find_components(g, bg=bg, connectivity=4, monochromatic=False)
60:     assert len(regions) >= 2, "expected multiple candidate foreground rectangles"
61: 
62:     scored_regions: list[tuple[int, np.ndarray]] = []
63:     for region in regions:
64:         rect = crop_bbox(g, region["bbox"])
65:         assert np.all(rect != bg), "each foreground component must fill its rectangular bbox"
66:         scored_regions.append((_area_five_marker_count(rect, marker), rect))
67: 
68:     best_score = max(score for score, _rect in scored_regions)
69:     winners = [rect for score, rect in scored_regions if score == best_score]
70:     assert len(winners) == 1, "expected a unique rectangle with the most area-five marker objects"
71:     return winners[0]
72: 
73: # --------------- generator (o5x) ---------------
74: 
75: # Colors used by all generated grids.
