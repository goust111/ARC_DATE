278: def _gen_choose_route_plan(
279:     height: int,
280:     width: int,
281:     lane: tuple[int, int],
282:     want_notch: bool,
283: ) -> dict[str, object] | None:
284:     """Choose a lane-local route skeleton; the grid is not mutated here."""
285:     lane_lo, lane_hi = lane
286:     effective_hi = lane_hi
287:     if want_notch:
288:         effective_hi = min(effective_hi - _GEN_NOTCH_SIDE_MARGIN, width - 1 - _GEN_NOTCH_SIDE_MARGIN)
289:     if effective_hi - lane_lo < _GEN_MIN_ROUTE_HITS:
290:         return None
291: 
292:     max_hits = min(_GEN_MAX_ROUTE_HITS, effective_hi - lane_lo)
293:     hit_count = random.randint(_GEN_MIN_ROUTE_HITS, max_hits)
294:     start_c = random.randint(lane_lo, effective_hi - hit_count)
295: 
296:     if height - (_GEN_HIT_ROW_TOP_MARGIN + _GEN_HIT_ROW_BOTTOM_MARGIN) < hit_count:
297:         return None
298:     hit_rows = sorted(
299:         random.sample(range(_GEN_HIT_ROW_TOP_MARGIN, height - _GEN_HIT_ROW_BOTTOM_MARGIN), hit_count),
300:         reverse=True,
301:     )
302:     notch_row = None
303:     if want_notch:
304:         roof_choices = list(range(0, hit_rows[-1]))
305:         if not roof_choices:
306:             return None
307:         notch_row = random.choice(roof_choices)
308: 
309:     runs: list[tuple[int, int, int, int]] = []
310:     c = start_c
311:     for i, r in enumerate(hit_rows):
312:         remaining_hits = hit_count - i - 1
313:         max_adv = min(_GEN_MAX_ORANGE_RUN, effective_hi - c - remaining_hits)
314:         if max_adv < _GEN_MIN_ORANGE_RUN:
315:             return None
316:         advance = random.randint(_GEN_MIN_ORANGE_RUN, max_adv)
317:         run_end = c + advance - 1
318:         back_limit = min(c - lane_lo, _GEN_MAX_ORANGE_RUN - advance)
319:         back = random.randint(0, back_limit)
320:         run_left = c - back
321:         runs.append((r, c, run_left, run_end))
322:         c = run_end + 1
323: 
324:     return {
325:         "start_c": start_c,
326:         "runs": runs,
327:         "notch_row": notch_row,
328:         "final_c": c,
329:     }
