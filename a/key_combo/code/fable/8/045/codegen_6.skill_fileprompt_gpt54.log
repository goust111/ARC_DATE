+
+
+def _branch_counts(inp: np.ndarray, out: np.ndarray) -> dict[int, int]:
+    counts = {Color.RED: 0, Color.YELLOW: 0, Color.TEAL: 0, Color.GREY: 0}
+    for r, c in np.argwhere(inp == Color.BLUE):
+        counts[int(out[r, c])] += 1
