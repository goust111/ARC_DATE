137: def _gen_component_touches_marker(rect: np.ndarray, cells: tuple[tuple[int, int], ...]) -> bool:
138:     own = set(cells)
139:     height, width = rect.shape
140:     for r, c in cells:
141:         for dr, dc in NEIGHBOR4_OFFSETS:
142:             nr, nc = r + dr, c + dc
143:             if (nr, nc) in own:
144:                 continue
145:             if 0 <= nr < height and 0 <= nc < width and int(rect[nr, nc]) == MARKER_COLOR:
146:                 return True
147:     return False
