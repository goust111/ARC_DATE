76: def _gen_bounded_composition(total, parts, max_each):
77:     if parts <= 0 or max_each < 1 or total < parts or total > parts * max_each:
78:         return None
79: 
80:     vals = []
81:     remaining = total
82:     for i in range(parts):
83:         left = parts - i - 1
84:         lo = max(1, remaining - left * max_each)
85:         hi = min(max_each, remaining - left)
86:         if lo > hi:
87:             return None
88:         val = int(np.random.randint(lo, hi + 1))
89:         vals.append(val)
90:         remaining -= val
91: 
92:     return [int(v) for v in np.random.permutation(vals)]
