+
+
+def _instantiate_pattern(kind: str) -> list[int]:
+    if kind == "full":
+        return [0, 1, 2, 3]
+    if kind == "vertical":
+        return random.choice([[0, 1], [2, 3]])
+    if kind == "horizontal":
+        return random.choice([[0, 2], [1, 3]])
+    if kind == "diagonal":
