253: def _grow_blob_constrained(seed: tuple[int, int], size: int, all_pts: set,
254:                            existing_lobes: list[set]) -> set[tuple[int, int]]:
255:     blob = {seed}
256:     for _ in range(size - 1):
257:         frontier = []
258:         for r, c in blob:
