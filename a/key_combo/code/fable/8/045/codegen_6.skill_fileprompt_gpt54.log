17: def main(grid: np.ndarray) -> np.ndarray:
18:     """Fill a hollow grey square frame with nested square shells cycling grey, red, grey, and black.
19: 
20:     Input structure
21:     - The grid contains black background and one complete one-cell-thick grey square frame.
22:     - The frame interior and any exterior padding are black.
23: 
24:     Rule
25:     - Preserve the frame bbox and recolor every cell in it by its distance from the frame border.
26:     - Shell depths repeat the color cycle grey, red, grey, black while moving inward.
27:     - In the 9x9 small-frame case, the lone center cell remains in the black center left by the first blank shell.
28: 
29:     Key insight
30:     - The output is a distance-shell rewrite of the single square frame, not a movement or matching task.
31:     """
32:     g = np.asarray(grid, dtype=int)
33:     bg = Color.BLACK
34:     present = set(map(int, g.ravel()))
35:     assert bg in present
36:     frame_colors = present - {bg}
37:     assert frame_colors == {Color.GREY}
38:     frame_color = Color.GREY
39: 
40:     frame_box = bbox(g == frame_color)
41:     assert frame_box is not None
