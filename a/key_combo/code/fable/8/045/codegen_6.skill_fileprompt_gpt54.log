+        hr, hc = 2 * axis_r - r, c
+        has_v = _in_bounds((h, w), vr, vc) and blue[vr, vc]
+        has_h = _in_bounds((h, w), hr, hc) and blue[hr, hc]
+        if has_v and has_h:
+            out[r, c] = Color.RED
+        elif has_v:
+            out[r, c] = Color.YELLOW
+        elif has_h:
+            out[r, c] = Color.TEAL
+        else:
+            out[r, c] = Color.GREY
+    return out
