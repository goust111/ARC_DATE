137: def main(grid: np.ndarray) -> np.ndarray:
138:     """Recolor the grey diagonal-chain regions in an orange field to teal.
139: 
140:     Input structure
141:     The input contains only grey pixels and orange pixels.  Grey pixels form
142:     several 8-connected regions embedded in the orange field.
143: 
144:     Rule
145:     Decompose each grey 8-connected region into 4-connected lobes.  Recolor the
146:     whole region teal only when it contains a straight diagonal run of at least
147:     three pixels and those lobes meet only by diagonal corner contacts in a
148:     non-branching diagonal chain or cycle; a single 4-connected region is
149:     recolored only when it is a square diagonal staircase.
150: 
151:     Key insight
152:     The teal regions are not selected by size or position; they are the grey
153:     regions whose internal connectivity depends on diagonal corner joins, while
154:     same-edge cracks, rectangles, bars, and branching/noisy regions remain grey.
155:     """
156:     g = np.asarray(grid, dtype=int)
157:     assert g.ndim == 2
158:     assert set(np.unique(g)) == {Color.GREY, Color.ORANGE}
159: 
160:     out = g.copy()
161:     lab8, n8 = label_mask(g == Color.GREY, connectivity=8)
162:     assert n8 >= 1
163: 
164:     for k in range(1, n8 + 1):
165:         mask = lab8 == k
166:         if _is_target_region(mask):
167:             out[mask] = Color.TEAL
168: 
169:     return out
