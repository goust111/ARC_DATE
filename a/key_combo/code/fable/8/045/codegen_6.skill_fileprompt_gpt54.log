201: def _gen_max_straight_diagonal_run(pts: set[tuple[int, int]]) -> int:
202:     best = 0
203:     for dr, dc in ((1, 1), (1, -1)):
204:         for r, c in pts:
205:             if (r - dr, c - dc) in pts:
206:                 continue
207:             length = 0
208:             while (r, c) in pts:
209:                 length += 1
210:                 r += dr
211:                 c += dc
212:             best = max(best, length)
213:     return best
