359: def _gen_apply_route(
360:     grid: np.ndarray,
361:     expected: np.ndarray,
362:     no_orange: np.ndarray,
363:     route_used: set[tuple[int, int]],
364:     plan: dict[str, object],
365: ) -> bool:
366:     H, W = grid.shape
367:     start_c = int(plan["start_c"])
368:     runs = list(plan["runs"])
369:     notch_row = plan["notch_row"]
370:     cursor_r = H - 1
371:     c = start_c
372: 
373:     if int(grid[H - 1, c]) != _GEN_BG:
374:         return False
375:     grid[H - 1, c] = _GEN_MARKER
376:     expected[H - 1, c] = _GEN_MARKER
377:     no_orange[H - 1, c] = True
378: 
379:     touched_rows: set[int] = set()
380:     for r, hit_c, run_left, run_end in runs:
381:         if hit_c != c or not (run_left <= c <= run_end) or run_end + 1 >= W:
382:             return False
383:         exit_c = run_end + 1
384: 
385:         for cc in range(run_left, run_end + 1):
386:             if not _gen_set_obstacle(grid, expected, route_used, r, cc):
387:                 return False
388:         touched_rows.add(r)
389:         _gen_mark_no_orange(no_orange, r, run_left - 1)
390:         _gen_mark_no_orange(no_orange, r, exit_c)
391: 
392:         for rr in range(r + 2, cursor_r):
393:             if not _gen_paint_bg(grid, expected, no_orange, route_used, rr, c, _GEN_RED):
394:                 return False
395:         if not _gen_paint_hit(grid, expected, route_used, r, c):
396:             return False
397:         if not _gen_paint_bg(grid, expected, no_orange, route_used, r + 1, c, _GEN_YELLOW):
398:             return False
399:         for cc in range(c + 1, exit_c):
400:             if not _gen_paint_bg(grid, expected, no_orange, route_used, r + 1, cc, _GEN_RED):
401:                 return False
402:         if not _gen_paint_bg(grid, expected, no_orange, route_used, r + 1, exit_c, _GEN_GREEN):
403:             return False
404: 
405:         cursor_r = r + 1
406:         c = exit_c
407: 
408:     if notch_row is None:
409:         for rr in range(1, cursor_r):
410:             if not _gen_paint_bg(grid, expected, no_orange, route_used, rr, c, _GEN_RED):
411:                 return False
412:         if not _gen_paint_bg(grid, expected, no_orange, route_used, 0, c, _GEN_MARKER):
413:             return False
414:     else:
415:         r = int(notch_row)
416:         if not (0 <= r < cursor_r - 1 and 0 < c < W - 1):
417:             return False
418:         for rr in range(r + 2, cursor_r):
419:             if not _gen_paint_bg(grid, expected, no_orange, route_used, rr, c, _GEN_RED):
420:                 return False
421:         for rr, cc in ((r, c), (r + 1, c - 1), (r + 1, c + 1)):
422:             if not _gen_set_obstacle(grid, expected, route_used, rr, cc):
423:                 return False
424:             touched_rows.add(rr)
425:         if not _gen_paint_bg(grid, expected, no_orange, route_used, r + 1, c, _GEN_MARKER):
426:             return False
427:         _gen_mark_no_orange(no_orange, r, c - 1)
428:         _gen_mark_no_orange(no_orange, r, c + 1)
429: 
430:     return _gen_rows_run_ok(grid, touched_rows)
