232:         while r < n - 1 or c > 0:
233:             if r == n - 1: c -= 1
234:             elif c == 0: r += 1
235:             elif random.random() < 0.5: r += 1
236:             else: c -= 1
237:             path.append((r, c))
238:     return set(path)
