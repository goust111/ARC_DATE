260:                 nr, nc = r + dr, c + dc
261:                 if (nr, nc) in blob or (nr, nc) in all_pts:
262:                     continue
263:                 if any((nr + ddr, nc + ddc) in lobe
264:                        for lobe in existing_lobes for ddr, ddc in CARDINAL_STEPS):
265:                     continue
266:                 frontier.append((nr, nc))
267:         if not frontier:
268:             break
