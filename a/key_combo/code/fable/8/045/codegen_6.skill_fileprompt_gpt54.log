79: def _gen_expected_output(grid: np.ndarray, r0: int, c0: int, side: int) -> np.ndarray:
80:     out = grid.copy()
81:     rows = np.arange(side)[:, None]
82:     cols = np.arange(side)[None, :]
83:     edge_dist = np.minimum(
84:         np.minimum(rows, side - 1 - rows),
85:         np.minimum(cols, side - 1 - cols),
86:     )
87:     phase = edge_dist % SHELL_PERIOD
88:     patch = np.full((side, side), GEN_FRAME, dtype=int)
89:     patch[phase == RED_PHASE] = GEN_RED
90:     patch[phase == BG_PHASE] = GEN_BG
91:     max_depth = side // 2
92:     if max_depth == SPECIAL_CENTER_DEPTH:
93:         patch[edge_dist == max_depth] = GEN_BG
94:     out[r0 : r0 + side, c0 : c0 + side] = patch
