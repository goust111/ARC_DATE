469: def _gen_add_filler(
470:     grid: np.ndarray,
471:     expected: np.ndarray,
472:     no_orange: np.ndarray,
473:     target_count: int,
474:     notch_limit: int,
475: ) -> bool:
476:     H, W = grid.shape
477:     current = int(np.count_nonzero(grid == _GEN_ORANGE))
478:     attempts = 0
479:     while current < target_count and attempts < _GEN_FILLER_ATTEMPTS:
480:         attempts += 1
481:         remaining = target_count - current
482:         run_len = random.randint(_GEN_MIN_ORANGE_RUN, min(_GEN_MAX_ORANGE_RUN, remaining, W))
483:         r = random.randrange(H)
484:         c0 = random.randrange(W - run_len + 1)
485:         cells = [(r, c) for c in range(c0, c0 + run_len)]
486:         if not _gen_can_add_orange(grid, no_orange, cells, notch_limit):
487:             continue
488:         for r2, c2 in cells:
489:             grid[r2, c2] = _GEN_ORANGE
490:             expected[r2, c2] = _GEN_ORANGE
491:         current += run_len
492: 
493:     if current == target_count:
494:         return True
495: 
496:     free_cells = [
497:         (r, c)
498:         for r in range(H)
499:         for c in range(W)
500:         if int(grid[r, c]) == _GEN_BG and not bool(no_orange[r, c])
501:     ]
502:     random.shuffle(free_cells)
503:     for r, c in free_cells:
504:         if current >= target_count:
505:             break
506:         cells = [(r, c)]
507:         if not _gen_can_add_orange(grid, no_orange, cells, notch_limit):
508:             continue
509:         grid[r, c] = _GEN_ORANGE
510:         expected[r, c] = _GEN_ORANGE
511:         current += 1
512:     return current == target_count
