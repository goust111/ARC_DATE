+    for coords in _components(grid == Color.GREY, connectivity=8):
+        r0, c0, r1, c1 = _bbox(coords)
+        patch = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+        patch[coords[:, 0] - r0, coords[:, 1] - c0] = True
+        hsym, vsym = _symmetry_flags(patch)
