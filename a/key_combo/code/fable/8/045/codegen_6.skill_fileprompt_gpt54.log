104: def _gen_choose_plus_centers(height: int, width: int, count: int) -> list[tuple[int, int]] | None:
105:     """Choose non-overlapping plus centers with the required Manhattan spacing."""
106:     candidates = [
107:         (r, c)
108:         for r in range(PLUS_CENTER_MARGIN, height - PLUS_CENTER_MARGIN)
109:         for c in range(PLUS_CENTER_MARGIN, width - PLUS_CENTER_MARGIN)
110:     ]
111:     random.shuffle(candidates)
112:     chosen: list[tuple[int, int]] = []
113: 
114:     def search(pool: list[tuple[int, int]]) -> bool:
115:         if len(chosen) == count:
116:             return True
117:         if len(pool) < count - len(chosen):
118:             return False
119:         random.shuffle(pool)
120:         for i, pos in enumerate(pool):
121:             rest = [
122:                 other
123:                 for other in pool[i + 1 :]
124:                 if abs(int(other[0]) - int(pos[0])) + abs(int(other[1]) - int(pos[1])) >= PLUS_MIN_MANHATTAN
125:             ]
126:             chosen.append(pos)
127:             if search(rest):
128:                 return True
129:             chosen.pop()
130:         return False
131: 
132:     if search(candidates):
133:         return chosen.copy()
134:     return None
