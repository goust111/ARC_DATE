8: def main(grid: np.ndarray) -> np.ndarray:
9:     """
10:     Recolor each foreground pixel by whether its horizontally reflected counterpart is also foreground.
11: 
12:     Input structure:
13:     - The grid has black background pixels and exactly one non-black foreground color.
14:     - Foreground pixels may or may not have a matching foreground pixel in the reflected row at the same column.
15: 
16:     Rule:
17:     - Preserve black background pixels.
18:     - Recolor a foreground pixel red if the pixel at the same column in the opposite row is also foreground.
19:     - Recolor every other foreground pixel grey.
20: 
21:     Key insight:
22:     - The red pixels are the horizontally symmetric intersection of the foreground mask with its top-bottom reflection.
23:     """
24:     g = np.asarray(grid, dtype=int)
25:     assert g.ndim == 2, "expected a 2D grid"
26:     assert np.any(g == Color.BLACK), "expected black background pixels"
27: 
28:     foreground_colors = colors_present(g, exclude={Color.BLACK})
29:     assert len(foreground_colors) == 1, "expected exactly one non-black foreground color"
30:     foreground_color = foreground_colors[0]
31:     assert foreground_color not in (Color.RED, Color.GREY), "input foreground must be replaced by red/grey"
32: 
33:     foreground = g == foreground_color
34:     assert np.any(foreground), "expected at least one foreground pixel"
35: 
36:     reflected_foreground = foreground[::-1, :]
37:     symmetric_foreground = foreground & reflected_foreground
38: 
39:     out = g.copy()
40:     out[symmetric_foreground] = Color.RED
41:     out[foreground & ~symmetric_foreground] = Color.GREY
42:     return out
