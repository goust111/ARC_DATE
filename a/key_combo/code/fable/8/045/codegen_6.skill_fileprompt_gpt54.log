177: def _gen_add_distractors(rect: np.ndarray, count: int) -> bool:
178:     area = int(rect.size)
179:     max_marker = (area - 1) // 2
180:     for placed in range(count):
181:         remaining_after = count - placed - 1
182:         marker_now = int(np.sum(rect == MARKER_COLOR))
183:         allowed_sizes = [s for s in DISTRACTOR_SIZES if marker_now + s + remaining_after <= max_marker]
184:         random.shuffle(allowed_sizes)
185:         picked: tuple[tuple[int, int], ...] | None = None
186:         for size in allowed_sizes:
187:             candidates = _gen_distractor_candidates(rect, size)
188:             if candidates:
189:                 picked = random.choice(candidates)
190:                 break
191:         if picked is None:
192:             return False
193:         for r, c in picked:
194:             rect[r, c] = MARKER_COLOR
195:     return True
