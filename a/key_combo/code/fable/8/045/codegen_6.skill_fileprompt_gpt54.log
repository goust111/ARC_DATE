+            rs0 = max(0, -dr)
+            rs1 = min(h, h - dr) if dr >= 0 else h
+            cs0 = max(0, -dc)
+            cs1 = min(w, w - dc) if dc >= 0 else w
+            rd0 = max(0, dr)
+            rd1 = rd0 + (rs1 - rs0)
+            cd0 = max(0, dc)
+            cd1 = cd0 + (cs1 - cs0)
+            out[rd0:rd1, cd0:cd1] |= mask[rs0:rs1, cs0:cs1]
