15: def main(input_grid):
16:     """
17:     Reflect the non-symmetric object across the horizontal and vertical symmetry axes of the separate symmetric marker.
18: 
19:     Input structure:
20:     - The grid contains exactly two monochromatic non-black objects.
21:     - One object has both horizontal and vertical mirror symmetry.
22:     - The other object sits in one quadrant relative to those symmetry axes.
23: 
24:     Rule:
25:     - Detect both objects and identify the one with both mirror axes.
26:     - Use those axes as symmetries for the whole output grid.
27:     - For every pixel of the other object, paint all reflected orbit positions with its color.
28: 
29:     Key insight:
30:     - The symmetric object defines the reflection axes; the non-symmetric object supplies
31:       the pixels to replicate.
32:     """
33:     # Plan:
34:     # 1. Detect the pair of objects and divide them by whether or not they are already symmetric
35:     # 2. Reflect the non-symmetric object across the axes of symmetry of the symmetric object
36: 
37:     # 1. Object detection and setup
38:     objects = find_components(input_grid, bg=Color.BLACK, connectivity=8, monochromatic=True, return_format="objects")
39:     assert len(objects) == 2
40: 
41:     # Find the object that is symmetric.
42:     #
43:     # Important: the *other* object can sometimes have >=2 detected mirror symmetries
44:     # (e.g. if it happens to be symmetric about one axis), so we specifically look for
45:     # an object that has BOTH a horizontal-only and a vertical-only mirror symmetry.
46:     best_obj = None
47:     best_syms = None
48:     best_score = (-1, -1)  # (has_both_axes, symmetry_count)
49:     for obj in objects:
50:         syms = detect_mirror_symmetry(obj, ignore_colors=[], background=Color.BLACK)
51:         has_r = any(getattr(s, "mirror_r", None) is not None and getattr(s, "mirror_c", None) is None for s in syms)
52:         has_c = any(getattr(s, "mirror_r", None) is None and getattr(s, "mirror_c", None) is not None for s in syms)
53:         score = (1 if (has_r and has_c) else 0, len(syms))
54:         if score > best_score:
55:             best_score = score
56:             best_obj = obj
57:             best_syms = syms
58: 
59:     assert best_obj is not None and best_syms is not None, "There should be a symmetric object"
60:     symmetric_object = best_obj
61:     symmetries = best_syms
62: 
63:     # Find the object that is not symmetric
64:     non_symmetric_object = next(obj for obj in objects if obj is not symmetric_object)
65: 
66:     # 2. Reflect the non-symmetric object across the axes of symmetry of the symmetric object
67:     output_grid = input_grid.copy()
68: 
69:     for r, c in np.argwhere(non_symmetric_object != Color.BLACK):
70:         original_color = non_symmetric_object[r, c]
71:         for transformed_r, transformed_c in orbit(output_grid, r, c, symmetries=symmetries):
72:             output_grid[transformed_r, transformed_c] = original_color
73:     
74:     return output_grid
