150: def _gen_distractor_candidates(rect: np.ndarray, size: int) -> list[tuple[tuple[int, int], ...]]:
151:     height, width = rect.shape
152:     out: list[tuple[tuple[int, int], ...]] = []
153:     if size == 1:
154:         for r in range(height):
155:             for c in range(width):
156:                 cells = ((r, c),)
157:                 if int(rect[r, c]) == FILL_COLOR and not _gen_component_touches_marker(rect, cells):
158:                     out.append(cells)
159:     else:
160:         for r in range(height):
161:             for c in range(width):
162:                 for dr, dc in DISTRACTOR_OFFSETS:
163:                     nr, nc = r + dr, c + dc
164:                     if nr >= height or nc >= width:
165:                         continue
166:                     cells = ((r, c), (nr, nc))
167:                     if (
168:                         int(rect[r, c]) == FILL_COLOR
169:                         and int(rect[nr, nc]) == FILL_COLOR
170:                         and not _gen_component_touches_marker(rect, cells)
171:                     ):
172:                         out.append(cells)
173:     random.shuffle(out)
174:     return out
