450: def _gen_can_add_orange(
451:     grid: np.ndarray,
452:     no_orange: np.ndarray,
453:     cells: list[tuple[int, int]],
454:     notch_limit: int,
455: ) -> bool:
456:     for r, c in cells:
457:         if int(grid[r, c]) != _GEN_BG or bool(no_orange[r, c]):
458:             return False
459:     rows = {r for r, _c in cells}
460:     old_vals = [int(grid[r, c]) for r, c in cells]
461:     for r, c in cells:
462:         grid[r, c] = _GEN_ORANGE
463:     ok = _gen_rows_run_ok(grid, rows) and _gen_count_notches(grid) <= notch_limit
464:     for (r, c), old in zip(cells, old_vals):
