67: FRAME_SIDE_MAX = 25
68: MAX_SIDE_PADDING = 4
69: MAX_TOTAL_PADDING = 2 * MAX_SIDE_PADDING
70: 
71: # Shell color cycle and retry budget.
72: GEN_BG, GEN_FRAME, GEN_RED = Color.BLACK, Color.GREY, Color.RED
73: SHELL_PERIOD = 4
74: RED_PHASE, BG_PHASE = 1, 3
75: SPECIAL_CENTER_DEPTH = 4
76: GENERATION_RETRIES = 300
