251: def _gen_try_row_groups(canvas: np.ndarray, regions: list[np.ndarray], groups: list[list[int]]) -> np.ndarray | None:
252:     grid_h, grid_w = canvas.shape
253:     row_heights = [max(int(regions[idx].shape[0]) for idx in group) for group in groups]
254:     row_widths = [
255:         sum(int(regions[idx].shape[1]) for idx in group) + REGION_GAP * (len(group) - 1)
256:         for group in groups
257:     ]
258:     total_h = sum(row_heights) + REGION_GAP * (len(groups) - 1)
259:     if total_h > grid_h or any(width > grid_w for width in row_widths):
260:         return None
261: 
262:     out = canvas.copy()
263:     vertical_parts = _gen_split_slack(grid_h - total_h, len(groups) + 1)
264:     top = vertical_parts[0]
265:     for group_i, group in enumerate(groups):
266:         band_h = row_heights[group_i]
267:         horizontal_parts = _gen_split_slack(grid_w - row_widths[group_i], len(group) + 1)
268:         left = horizontal_parts[0]
269:         for item_i, idx in enumerate(group):
270:             rect = regions[idx]
271:             rect_h, rect_w = rect.shape
272:             r = top + random.randint(0, band_h - rect_h)
273:             c = left
274:             if not _gen_region_fits(out, rect, r, c):
275:                 return None
276:             paste(out, rect, r, c)
277:             left += rect_w + REGION_GAP + horizontal_parts[item_i + 1]
278:         top += band_h + REGION_GAP + vertical_parts[group_i + 1]
279:     return out
