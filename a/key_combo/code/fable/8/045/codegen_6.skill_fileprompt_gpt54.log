241: def _grow_blob(size: int, seed: tuple[int, int], forbidden: set) -> set[tuple[int, int]]:
242:     blob = {seed}
243:     for _ in range(size - 1):
244:         frontier = [(r + dr, c + dc)
245:                      for r, c in blob for dr, dc in CARDINAL_STEPS
246:                      if (r + dr, c + dc) not in blob and (r + dr, c + dc) not in forbidden]
247:         if not frontier:
