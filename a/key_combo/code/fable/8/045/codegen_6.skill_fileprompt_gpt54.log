332: def _gen_choose_route_plans(
333:     height: int,
334:     width: int,
335:     lanes: list[tuple[int, int]],
336: ) -> tuple[list[dict[str, object]], int] | None:
337:     """Choose one route plan per lane and return the intended notch count."""
338:     marker_count = len(lanes)
339:     use_notch = random.random() < _GEN_NOTCH_PROB
340:     notch_route = random.randrange(marker_count) if use_notch else -1
341:     plans: list[dict[str, object]] = []
342:     actual_notches = 0
343: 
344:     for i, lane in enumerate(lanes):
345:         want_notch = i == notch_route
346:         plan = _gen_choose_route_plan(height, width, lane, want_notch)
347:         if plan is None and want_notch:
348:             plan = _gen_choose_route_plan(height, width, lane, False)
349:             want_notch = False
350:         if plan is None:
351:             return None
352:         if want_notch:
353:             actual_notches = 1
354:         plans.append(plan)
355: 
356:     return plans, actual_notches
