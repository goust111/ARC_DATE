+    backtrack(all_ids, [])
+    assert len(solutions) == 1, "remnants must determine a unique rectangle grouping"
+    rects = [tuple(map(int, candidates[idx]["rect"])) for idx in solutions[0]]  # type: ignore[arg-type]
+    rects.sort()
