+        ROLE_TR: {(r0, c1), (r0, c1 - 1), (r0 + 1, c1)},
+        ROLE_BL: {(r1, c0), (r1, c0 + 1), (r1 - 1, c0)},
+        ROLE_BR: {(r1, c1), (r1, c1 - 1), (r1 - 1, c1)},
