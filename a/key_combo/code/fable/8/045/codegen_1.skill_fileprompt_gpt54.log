+        if not (GEN_EDGE_MARGIN <= c0 < c1 <= width - 1 - GEN_EDGE_MARGIN):
+            return False
+        if r1 - r0 < GEN_MIN_CORNER_SPAN or c1 - c0 < GEN_MIN_CORNER_SPAN:
