+def _can_place(coords: np.ndarray, shape: tuple[int, int], occupied: np.ndarray) -> bool:
+    h, w = shape
+    if np.any(coords[:, 0] < 0) or np.any(coords[:, 0] >= h) or np.any(coords[:, 1] < 0) or np.any(coords[:, 1] >= w):
