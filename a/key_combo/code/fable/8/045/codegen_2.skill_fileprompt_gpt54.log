+
+def _occupied(shape: tuple[int, int], objs: list[Obj]) -> np.ndarray:
+    occ = np.zeros(shape, dtype=bool)
+    for obj in objs:
+        cells = _coords(obj)
+        occ[cells[:, 0], cells[:, 1]] = True
+    return occ
+
+
+def _settle_key(obj: Obj, side: str) -> tuple[int, int, int, int]:
+    r0, c0, r1, c1 = _bbox(_coords(obj))
