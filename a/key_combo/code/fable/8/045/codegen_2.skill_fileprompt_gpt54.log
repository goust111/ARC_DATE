+        pseudo_obj, filler_obj, active_side = activation
+        fixed_frames = fixed_frames + [_promote_to_fixed(pseudo_obj)]
+        moving = [obj for obj in settled if obj.obj_id not in {pseudo_obj.obj_id, filler_obj.obj_id}]
