+            singletons[(cell, int(obj.colors[0]))] = obj
+
+    candidates = []
+    for obj in settled:
+        if obj.kind != "pseudo_frame":
+            continue
+        assert obj.center_color in color_to_side, "pseudo-frame center must match some marker color"
