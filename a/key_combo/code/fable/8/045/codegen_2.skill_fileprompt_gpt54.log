+        anchor=obj.anchor if anchor is None else anchor,
+        rels=obj.rels,
+        colors=obj.colors,
+        obj_id=obj.obj_id,
+        ring_color=obj.ring_color,
+        center_color=obj.center_color,
+        missing_rel=obj.missing_rel,
