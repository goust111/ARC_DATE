spec:
  grid: 17-28 rows x 10-29 cols
  colors: bg=BLACK(0), obstacle=ORANGE(7), marker=MAGENTA(6)
  markers:
    count: 1-3, placed on bottom row (row H-1), no obstacle at same cell
    columns must be distinct
  obstacles:
    scattered ORANGE pixels throughout grid (density 6-15% of total cells)
    horizontal run lengths: 1-7 pixels; multiple runs may share a row
    rows with obstacles: 3-26 rows occupied [observed]
  route_per_marker:
    algorithm: climb upward from marker column; at each ORANGE hit, exit right past the contiguous run on that row, then continue upward from exit column
    hits_per_route: 1-6 (turns/direction changes)
    termination: top-edge (marker at row 0) OR notch (cell flanked left+right by ORANGE with ORANGE roof above)
    notches_in_grid: 0-1 [observed]
  output_transform:
    vertical_approach cells (bg between segments) -> RED(2)
    hit ORANGE pixel -> TEAL(8); cell below hit -> YELLOW(4)
    horizontal under-run cells -> RED(2); right-exit cell -> GREEN(3)
    terminal cell -> MAGENTA(6) marker (row 0 or notch)
  constraints:
    routes must not overlap (no shared painted cells)
    right-exit column must be in-bounds and on bg
    all cells painted by route must be bg in original input
    notch structure: ORANGE at (r,c), bg at (r+1,c), ORANGE at (r+1,c-1) and (r+1,c+1)

generation_strategy:
  approach: path-first
  steps:
    1. Pick grid size H x W in allowed ranges.
    2. Pick 1-3 marker start columns on bottom row; place MAGENTA markers.
    3. For each marker, build a complete route upward by construction:
       a. Start at (H-1, col). Choose 1-6 hit rows above, each with a horizontal ORANGE run of length 1-7 whose leftmost pixel is at or left of the current column, ensuring the right-exit (run_end+1) is in-bounds.
       b. For each hit, place the ORANGE run, record the teal/yellow/red/green cells.
       c. Final segment: either place a notch structure (0-1 total) or let route reach row 0.
       d. Verify all route cells (vertical RED, horizontal RED, YELLOW, GREEN, terminal MARKER) land on bg.
    4. After all routes are built, scatter additional ORANGE pixels on bg cells (not on any route cell) to reach target density 6-15%. Avoid creating unintended notch structures over route columns.
    5. Verify no route overlap and all right-exits in-bounds.
    6. Strip route coloring (RED/TEAL/YELLOW/GREEN/terminal MARKER) to produce input; keep only bg, ORANGE obstacles, and bottom-row markers.
