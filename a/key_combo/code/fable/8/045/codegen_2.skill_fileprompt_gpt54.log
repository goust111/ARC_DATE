+                        ring_color=ring_color,
+                        center_color=center,
+                    )
+                )
+            else:
+                pseudo_frames.append(
+                    Obj(
+                        "pseudo_frame",
+                        (r0, c0),
+                        tuple(coords),
+                        tuple(colors),
+                        f"pseudo_{frame_idx}",
+                        ring_color=ring_color,
+                        center_color=center,
+                        missing_rel=missing_rel,
