def _normalized_shape(coords: np.ndarray) -> tuple[tuple[int, int], ...]:
    r0, c0 = coords.min(axis=0)
    shifted = coords - np.array([r0, c0])
    return tuple(sorted((int(r), int(c)) for r, c in shifted))


