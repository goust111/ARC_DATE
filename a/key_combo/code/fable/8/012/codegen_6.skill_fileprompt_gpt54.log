# Colors used by the task.
GEN_BG_COLOR, GEN_SOURCE_COLOR, GEN_OBSTACLE_COLOR = 0, 8, 2

# Canvas and vertical layout bounds.
GEN_HEIGHT_MIN, GEN_HEIGHT_MAX = 9, 10
