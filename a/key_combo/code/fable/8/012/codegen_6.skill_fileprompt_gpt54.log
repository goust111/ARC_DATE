GEN_OBSTACLE_ROW_MIN, GEN_OBSTACLE_ROW_MAX_DIVISOR = 3, 2
GEN_SOURCE_CLEAR_GAP_MIN, GEN_SOURCE_CLEAR_GAP_MAX = 0, 1

