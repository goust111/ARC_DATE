    return random.choice(_gen_vector_pairs())


def _gen_lattice_key(r, c, v1, v2):
    a, b = v1
    p, q = v2
    det = a * q - b * p
    area = abs(det)
    return ((q * r - p * c) % area, (-b * r + a * c) % area)


