    cols = [c for _r, c in odd_centers]
    marker_is_in_center_field = (
        min(rows) <= marker_center[0] <= max(rows)
        and min(cols) <= marker_center[1] <= max(cols)
    )

    if not marker_is_in_center_field:
        for r, c in marker["coords"]:
            out[int(r), int(c)] = bg

    return out

