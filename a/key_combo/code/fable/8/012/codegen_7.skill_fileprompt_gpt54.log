+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+GEN_RETRIES = 400
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _neighbors8(r: int, c: int):
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            yield r + dr, c + dc
+
+
+def _find_components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _bbox_from_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _crop_true(mask: np.ndarray) -> np.ndarray:
+    coords = np.argwhere(mask)
+    assert coords.size > 0
+    r0, c0, r1, c1 = _bbox_from_coords(coords)
+    return mask[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _mask_signature(mask: np.ndarray) -> tuple[tuple[int, int], bytes]:
+    cropped = _crop_true(mask)
+    packed = np.ascontiguousarray(cropped.astype(np.uint8))
+    return tuple(map(int, packed.shape)), packed.tobytes()
+
+
+def _extract_hole(local_mask: np.ndarray) -> np.ndarray:
+    h, w = local_mask.shape
+    seen = np.zeros_like(local_mask, dtype=bool)
+    holes = []
+    for r in range(h):
+        for c in range(w):
+            if local_mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            touches_border = False
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                if rr in (0, h - 1) or cc in (0, w - 1):
+                    touches_border = True
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not local_mask[nr, nc] and not seen[nr, nc]:
