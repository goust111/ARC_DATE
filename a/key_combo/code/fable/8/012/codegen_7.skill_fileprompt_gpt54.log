+
+def _normalize_shape(mask: np.ndarray) -> np.ndarray:
+    return _crop_true(mask)
+
+
+def _random_polyomino(area: int, max_h: int = 4, max_w: int = 4) -> np.ndarray | None:
+    cells = {(0, 0)}
+    while len(cells) < area:
+        frontier = set()
+        for r, c in cells:
+            for nr, nc in _neighbors4(r, c):
+                if (nr, nc) not in cells:
+                    trial = cells | {(nr, nc)}
+                    rows = [x for x, _ in trial]
+                    cols = [y for _, y in trial]
+                    if max(rows) - min(rows) + 1 <= max_h and max(cols) - min(cols) + 1 <= max_w:
+                        frontier.add((nr, nc))
+        if not frontier:
+            return None
+        cells.add(random.choice(tuple(frontier)))
+    rs = [r for r, _ in cells]
+    cs = [c for _, c in cells]
+    h = max(rs) - min(rs) + 1
+    w = max(cs) - min(cs) + 1
+    out = np.zeros((h, w), dtype=bool)
+    r0 = min(rs)
+    c0 = min(cs)
+    for r, c in cells:
+        out[r - r0, c - c0] = True
+    return out
+
+
+def _dilate4(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    out = mask.copy()
+    for r, c in np.argwhere(mask):
+        for nr, nc in _neighbors4(int(r), int(c)):
+            if 0 <= nr < h and 0 <= nc < w:
+                out[nr, nc] = True
+    return out
+
+
+def _grow_slab_from_inner(inner_shape: np.ndarray) -> tuple[np.ndarray, np.ndarray] | None:
+    inner = _normalize_shape(inner_shape)
+    ih, iw = inner.shape
+    pad_t = random.randint(1, 2)
+    pad_b = random.randint(1, 2)
+    pad_l = random.randint(1, 2)
+    pad_r = random.randint(1, 2)
+    canvas = np.zeros((ih + pad_t + pad_b, iw + pad_l + pad_r), dtype=bool)
+    hole = np.zeros_like(canvas)
+    hole[pad_t : pad_t + ih, pad_l : pad_l + iw] = inner
+    outline = _dilate4(hole)
+    extra_steps = random.randint(0, max(2, (ih + iw) // 2))
+    for _ in range(extra_steps):
+        frontier = set()
+        for r, c in np.argwhere(outline):
+            for nr, nc in _neighbors4(int(r), int(c)):
+                if 0 <= nr < canvas.shape[0] and 0 <= nc < canvas.shape[1] and not outline[nr, nc]:
+                    frontier.add((nr, nc))
+        if not frontier:
+            break
+        nr, nc = random.choice(tuple(frontier))
+        outline[nr, nc] = True
+
+    colored = outline & ~hole
+    if not np.any(colored):
+        return None
+    if len(_find_components(colored)) != 1:
+        return None
+
+    coords = np.argwhere(outline)
+    r0, c0, r1, c1 = _bbox_from_coords(coords)
+    outline = outline[r0 : r1 + 1, c0 : c1 + 1].copy()
+    hole_local = hole[r0 : r1 + 1, c0 : c1 + 1].copy()
+    if len(_find_components(outline & ~hole_local)) != 1:
+        return None
+    if np.any(hole_local[0]) or np.any(hole_local[-1]) or np.any(hole_local[:, 0]) or np.any(hole_local[:, -1]):
+        return None
