+    seen = np.zeros_like(local_mask, dtype=bool)
+    holes = []
+    for r in range(h):
+        for c in range(w):
+            if local_mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            touches_border = False
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                if rr in (0, h - 1) or cc in (0, w - 1):
+                    touches_border = True
+                for nr, nc in _neighbors4(rr, cc):
