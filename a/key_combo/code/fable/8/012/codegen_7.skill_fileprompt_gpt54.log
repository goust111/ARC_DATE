+    total_slab_count = 1 + chain_len + decoy_count
+    colors = random.sample(PALETTE, total_slab_count)
+    template_color = colors[0]
+    chain_colors = colors[1 : 1 + chain_len]
+    decoy_colors = colors[1 + chain_len :]
