+        "coords": coords,
+        "bbox": (r0, c0, r1, c1),
+        "local_mask": local,
+        "hole_mask": hole,
+        "outline_mask": outline,
+        "hole_sig": _mask_signature(hole),
+        "outline_sig": _mask_signature(outline),
+    }
+
+
+def _adjacent_grey_dirs(grid: np.ndarray, coords: np.ndarray) -> set[tuple[int, int]]:
+    h, w = grid.shape
+    dirs = set()
+    for r, c in coords:
