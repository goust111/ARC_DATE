+                        frontier.add((nr, nc))
+        if not frontier:
+            return None
+        cells.add(random.choice(tuple(frontier)))
+    rs = [r for r, _ in cells]
+    cs = [c for _, c in cells]
+    h = max(rs) - min(rs) + 1
+    w = max(cs) - min(cs) + 1
+    out = np.zeros((h, w), dtype=bool)
