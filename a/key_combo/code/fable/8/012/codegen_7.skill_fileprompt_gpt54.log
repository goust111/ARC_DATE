            if source_options:
                entries.append((dest, run_i, tuple(source_options)))
    return entries


def _gen_sources_well_spaced(source_cols):
    cols = sorted(source_cols)
    return all(
        GEN_SOURCE_SPACING_MIN <= cols[i + 1] - cols[i] <= GEN_SOURCE_SPACING_MAX
        for i in range(len(cols) - 1)
