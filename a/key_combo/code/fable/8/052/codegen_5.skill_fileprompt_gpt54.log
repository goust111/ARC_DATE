+
+
+GRID_RANGE = (14, 24)
+BAR_MARGIN = 3
+TARGET_ORBITS = (5, 11)
+RECT_SIDE_RANGE = (2, 4)
+RECT_COUNT_RANGE = (1, 3)
+MAX_GENERATION_ATTEMPTS = 500
