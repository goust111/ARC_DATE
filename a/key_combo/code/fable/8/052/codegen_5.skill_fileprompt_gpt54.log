  "type": "transform_in_place",
  "src": "a vertical marker segment occupying the top or bottom half of one bar, plus all-bar-color vertical bars of even heights",
  "transform": "erase the current marker to the bar color, then recolor the same half of the unique all-bar-color bar whose height is two pixels greater than the source bar"
}
</annotation>
<generation_spec>
```yaml
spec:
  grid: 16x16, bg=7 [observed]
  colors: exactly 2 foreground colors — bar_color (8 [observed]) and marker_color (9 [observed])
  bars:
    structure: solid 1-cell-wide vertical segments (no gaps)
    progression_bars: exactly 5 bars with heights 2, 4, 6, 8, 10 — one bar per height
    distractor_bars: 5-11 additional height-2 pure bar_color bars scattered on the grid
    column_sharing: multiple bars may share a column if separated by >=1 bg row
    column_spacing: bars on different columns separated by >=1 bg column [observed]
  marker:
    location: exactly one progression bar (source) has its top or bottom half recolored to marker_color
    source_height: any even height in {2,4,6,8} (not the tallest bar)
    marker_cells: source_height / 2, occupying exactly the top or bottom half
  transform:
    erase: recolor source marker cells back to bar_color
    target: the unique progression bar with height = source_height + 2
    paint: recolor the same half (top or bottom) of target to marker_color

generation_strategy:
  approach: output-first — build the output state, then derive input by moving marker back
  steps:
    1. Choose grid 16x16, bg, bar_color, marker_color (3 distinct colors).
    2. Pick 5 distinct even heights {2,4,6,8,10} for progression bars. Choose a source_height from {2,4,6,8} and half (top or bottom). The target is source_height + 2.
    3. Place all 5 progression bars in the OUTPUT state — target bar has marker_color on the chosen half, all others are pure bar_color. Each bar is a solid 1-wide vertical segment; assign random columns/rows ensuring bars don't touch horizontally or vertically (>=1 bg gap).
    4. Place 5-11 distractor bars (height 2, pure bar_color) on the grid, ensuring no overlap or adjacency conflicts with existing bars.
    5. Derive INPUT from output — swap marker on target back to bar_color, then paint the same half of the source bar with marker_color.
