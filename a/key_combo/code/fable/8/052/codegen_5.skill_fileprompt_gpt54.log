+    full_rows = [r for r in range(grid.shape[0]) if np.all(grid[r] == bar_color)]
+    full_cols = [c for c in range(grid.shape[1]) if np.all(grid[:, c] == bar_color)]
+    return len(full_rows) == 1 and len(full_cols) == 1
+
