spec:
  grid: 4-12 rows x 4-12 cols, always square [observed]
  background: BLACK (always 0)
  bars:
    count: exactly 2 (one full row, one full column)
    colors: 2 distinct non-BLACK colors (color_A for one bar, color_B for the other)
    crossing: the intersection cell takes the color of one bar; the other bar uses its own color uniformly
    no_stray_pixels: all foreground pixels lie on the full row or full column
  crossing_position:
    row: 1 to H-2 (not on border)
    col: 1 to W-2 (not on border)
  transform:
    paint the 8 cells around the crossing YELLOW (4)
    preserve the crossing cell itself (its original color)
    all other cells unchanged

generation_strategy:
  approach: direct (input is simple enough)
  steps:
    1. Pick grid size N x N, N in [4..12]
    2. Pick two distinct non-BLACK, non-YELLOW foreground colors A and B
    3. Pick crossing position (r, c) with 1 <= r <= N-2, 1 <= c <= N-2
    4. Fill grid with BLACK
    5. Fill row r with color A; fill column c with color B (or vice versa)
    6. The crossing cell (r,c) takes whichever bar was painted second (natural overwrite)
    7. Verify exactly one full foreground row and one full foreground column exist
