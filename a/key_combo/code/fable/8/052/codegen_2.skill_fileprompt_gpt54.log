+        "marker_cols": marker_cols,
+        "marker_colors": marker_colors,
+        "target_col": target_col,
+        "source_col": source_col,
+        "grid_h": grid_h,
+        "grid_w": source_col + 1,
+        "marker_row": marker_row,
+        "bar_rows": bar_rows,
+        "target_color": target_color,
