spec:
  grid: 10x10 [observed]
  colors: black background, blue, red only
  blue_shape:
    structure: contiguous block of blue spanning a contiguous range of 5-9 columns
    each_column: fills rows 0..h-1 (top-contiguous, no internal gaps)
    column_heights: vary per column, range 1-5; jagged bottom edge
    connectivity: single connected component
    margins: 0-3 empty columns on each side [observed]
  red_bars:
    count: 1-5 vertical bars, each in a distinct column within the blue column range
    each_bar: contiguous vertical segment of height 1-6, bottom-aligned to grid row 9
    column_constraint: each red column must also contain blue (blue_h >= 1 in that column)
