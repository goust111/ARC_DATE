spec:
  grid: 4-12 rows x 4-12 cols, always square [observed]
  background: BLACK (always 0)
  bars:
    count: exactly 2 (one full row, one full column)
    colors: 2 distinct non-BLACK colors (color_A for one bar, color_B for the other)
    crossing: the intersection cell takes the color of one bar; the other bar uses its own color uniformly
    no_stray_pixels: all foreground pixels lie on the full row or full column
  crossing_position:
    row: 1 to H-2 (not on border)
    col: 1 to W-2 (not on border)
  transform:
