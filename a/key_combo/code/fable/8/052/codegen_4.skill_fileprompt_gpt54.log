    bar_col_ranks = _ranks([bar["height"] for bar in sorted(bars, key=lambda bar: bar["col"])])
    if seg_pos_ranks == list(range(len(segments))):
        return False
    if bar_col_ranks == list(range(len(bars))):
        return False
    if seg_pos_ranks == bar_col_ranks:
        return False

