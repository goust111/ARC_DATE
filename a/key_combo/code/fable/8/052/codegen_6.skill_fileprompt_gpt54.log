+            for out_c in range(w - mw + 1):
+                in_c = out_c - rank * dc
+                if in_c < 0 or in_c + mw > w:
+                    continue
+                if not _bbox_free(out_forbidden, out_r, out_c, mh, mw):
+                    continue
+                if not _bbox_free(in_forbidden, in_r, in_c, mh, mw):
