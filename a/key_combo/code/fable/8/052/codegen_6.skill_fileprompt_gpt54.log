+def _render_scene(shape: tuple[int, int], specs: list[dict], placements: dict[int, tuple[int, int, int, int]], *, use_output: bool) -> np.ndarray:
+    grid = np.zeros(shape, dtype=int)
+    for idx, spec in enumerate(specs):
