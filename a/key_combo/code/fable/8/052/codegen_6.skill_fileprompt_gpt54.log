+def _place_specs(specs: list[dict], shape: tuple[int, int]) -> dict[int, tuple[int, int, int, int]] | None:
+    h, w = shape
+    out_forbidden = np.zeros(shape, dtype=bool)
+    in_forbidden = np.zeros(shape, dtype=bool)
