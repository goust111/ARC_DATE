+    solid_areas = [spec["solid_area"] for spec in specs]
+    if len(set(solid_areas)) != len(solid_areas):
+        return None
+
+    visible_areas = [spec["visible_area"] for spec in specs]
+    if len(set(visible_areas)) != len(visible_areas):
