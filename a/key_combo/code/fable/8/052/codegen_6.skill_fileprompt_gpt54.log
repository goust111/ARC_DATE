+def _generate_specs() -> list[dict] | None:
+    count = random.randint(*OBJECT_COUNT_RANGE)
+    hollow_count = random.choices([0, 1, 2], weights=[1, 5, 4], k=1)[0]
+    hollow_count = min(hollow_count, count - 1)
