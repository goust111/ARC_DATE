+def _mark_forbidden(forbidden: np.ndarray, r0: int, c0: int, h: int, w: int) -> None:
+    rr0 = max(0, r0 - 1)
+    cc0 = max(0, c0 - 1)
+    rr1 = min(forbidden.shape[0], r0 + h + 1)
+    cc1 = min(forbidden.shape[1], c0 + w + 1)
+    forbidden[rr0:rr1, cc0:cc1] = True
