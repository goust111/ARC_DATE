  grid: 9x9 [observed]
  background: BLACK
  bars:
    color: GREY (single foreground color)
    count: 4-5
    width: 1 cell each
    orientation: vertical, bottom-aligned to last row
    column_spacing: every 2 columns (gap of 1 empty column between bars)
    first_column: any even or odd start; all bars on same parity [observed]
    heights: all distinct within example, range 1 to grid_height
  transform:
    clear: remove all bars
    tallest: repaint at original position in BLUE (unique tallest height required)
    shortest: repaint at original position in RED (unique shortest height required)
