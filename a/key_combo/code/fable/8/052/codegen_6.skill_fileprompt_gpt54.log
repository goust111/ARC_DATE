+        touches_edge = np.any(
+            (comp[:, 0] == 0)
+            | (comp[:, 1] == 0)
+            | (comp[:, 0] == mask.shape[0] - 1)
+            | (comp[:, 1] == mask.shape[1] - 1)
+        )
+        if not bool(touches_edge):
+            holes.append(comp)
+    return holes
+
