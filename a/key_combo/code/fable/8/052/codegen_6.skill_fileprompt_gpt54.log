+        top_r, top_c = (out_r, out_c) if use_output else (r0, c0)
+        patch = _render_patch(spec["mask"], spec["color"])
+        h, w = patch.shape
+        region = grid[top_r : top_r + h, top_c : top_c + w]
+        region[patch != 0] = patch[patch != 0]
+    return grid
