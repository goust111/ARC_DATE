+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+    bg = get_bg(g)
+    legend = _parse_legend(g, bg)
+    scale_by_color = {color: idx + 1 for idx, color in enumerate(legend)}
