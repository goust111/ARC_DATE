+    for idx in range(3):
+        colors = {int(base[r, c]) for r, c in visible[idx]}
+        if len(visible[idx]) < 6 or len(colors) < 2:
+            return None
+        if len(visible[idx]) >= len(fg_coords) - 1:
+            return None
+
