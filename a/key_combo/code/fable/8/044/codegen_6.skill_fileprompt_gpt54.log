+        if local_mask is None or int(local_mask.sum()) < 14:
+            continue
+
+        cells = [tuple(map(int, coord)) for coord in np.argwhere(local_mask)]
+        if len(cells) < 14:
+            continue
+
+        quad = np.full((quadrant_size, quadrant_size), bg, dtype=int)
