+    q = base.shape[0]
+    grid = np.full((2 * q + 1, 2 * q + 1), sep, dtype=int)
+    grid[:q, :q] = placed[0]
+    grid[:q, q + 1 :] = placed[1]
+    grid[q + 1 :, :q] = placed[2]
+    grid[q + 1 :, q + 1 :] = placed[3]
+    return grid, actual_angles
