+    if not np.array_equal(outputs[0], expected):
+        return False
+    if not np.array_equal(main(grid), expected):
+        return False
+    if any(np.array_equal(np.rot90(base, angle), expected) for angle in ALL_ANGLES if angle != sols[0]["missing_angle"]):
