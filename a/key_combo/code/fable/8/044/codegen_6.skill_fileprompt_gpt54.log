+    seed = (random.randrange(h), random.randrange(w))
+    mask[seed] = True
+    while int(mask.sum()) < area:
+        frontier = []
+        for r, c in np.argwhere(mask):
+            for dr, dc in DIR4:
+                nr, nc = int(r + dr), int(c + dc)
+                if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc]:
