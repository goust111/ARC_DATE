+        bg = random.choice(palette)
+        palette.remove(bg)
+        sep = random.choice(palette)
+        palette.remove(sep)
+        random.shuffle(palette)
+        body, marker1, marker2, marker3, accent = palette[:5]
+
+        base, marker_positions = _generate_base(
+            quadrant_size,
+            bg,
+            body,
+            (marker1, marker2, marker3),
+            accent,
