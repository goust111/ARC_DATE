+        return None
+    for a, b in ((0, 1), (0, 2), (1, 2)):
+        overlap = visible[a] & visible[b]
+        overlap_colors = {int(base[r, c]) for r, c in overlap}
+        if len(overlap) < 2 or len(overlap_colors) < 2:
+            return None
+
+    masks = []
+    for idx in range(3):
+        mask = np.zeros_like(base, dtype=bool)
+        for r, c in visible[idx]:
+            mask[r, c] = True
+        masks.append(mask)
+    return masks
+
