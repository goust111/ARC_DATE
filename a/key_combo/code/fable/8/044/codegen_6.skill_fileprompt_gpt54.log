+            continue
+        if len(set(int(x) for x in quad.ravel() if int(x) != bg)) < 4:
+            continue
+        return quad, marker_positions
+    return None, None
+
+
+def _visibility_masks(base: np.ndarray, bg: int, marker_positions):
