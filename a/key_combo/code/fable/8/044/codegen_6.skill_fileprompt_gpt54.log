+        aligned = [np.rot90(quadrants[idx], -angle) for idx, angle in zip(occupied, angles)]
+        base = _color_union(aligned, bg)
+        if base is None:
+            continue
+        pair_ok = True
+        for a, b in ((0, 1), (0, 2), (1, 2)):
