+        return None
+    base_sprite = np.full((sprite_size, sprite_size), bg, dtype=int)
+    base_sprite[base_mask] = sprite_color
+
+    observed_dots: dict[int, list[tuple[int, int]]] = {}
+    for count in (0, 1, 2, 3):
+        dots = _sample_dots(frame_h, frame_w, bbox, count)
+        if dots is None:
