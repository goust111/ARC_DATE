+    sizes: list[int] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            size = 0
+            while stack:
+                rr, cc = stack.pop()
+                size += 1
+                for dr in (-1, 0, 1):
