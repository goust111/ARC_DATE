spec:
  grid: 3x3 fixed
  input:
    colors: 1, 2, or 3 distinct non-black, non-grey colors (from palette 1-4,6-9)
    no_black_or_grey: black (0) and grey (5) never appear in input [observed]
    arrangement: any spatial arrangement of the chosen colors across 9 cells
  output:
    grid: 3x3, black background with exactly 3 grey (5) cells forming a line
    mapping:
      1 distinct color -> grey top row (cells (0,0),(0,1),(0,2))
      2 distinct colors -> grey main diagonal (cells (0,0),(1,1),(2,2))
      3 distinct colors -> grey anti-diagonal (cells (0,2),(1,1),(2,0))

generation_strategy:
