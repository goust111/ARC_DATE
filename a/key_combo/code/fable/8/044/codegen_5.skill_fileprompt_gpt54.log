+                anchor = candidate
+                break
+        if anchor is None:
+            raise AssertionError("not enough side slots for markers")
+        used[side].add(anchor)
+        if side == "left":
+            coords.append((anchor, c0 - dist))
+        elif side == "right":
+            coords.append((anchor, c1 + dist))
+        elif side == "up":
+            coords.append((r0 - dist, anchor))
+        else:
