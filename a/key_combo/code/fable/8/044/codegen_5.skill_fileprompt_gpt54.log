+    grid = np.full((grid_h, grid_w), bg, dtype=int)
+    _build_frame(grid, frame_bbox, frame_color)
+
+    instructions = []
+    for idx, color in enumerate(colors):
+        for r, c in placements[color]:
+            grid[r, c] = color
+        mr, mc = markers[idx]
+        if int(grid[mr, mc]) != int(bg):
