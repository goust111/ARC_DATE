+def _slide_color(out: np.ndarray, color: int, frame_bbox: tuple[int, int, int, int], direction: str, bg: int) -> None:
+    r0, c0, r1, c1 = frame_bbox
+    ir0, ic0, ir1, ic1 = r0 + 1, c0 + 1, r1 - 1, c1 - 1
