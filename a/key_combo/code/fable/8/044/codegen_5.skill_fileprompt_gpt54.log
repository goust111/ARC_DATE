+
+def _choose_extra_cell(
+    direction: str,
+    occupied: set[tuple[int, int]],
+    pool: list[tuple[int, int]],
+    seed: tuple[int, int],
+) -> tuple[int, int] | None:
+    preferred = []
+    sr, sc = seed
+    for cell in pool:
+        if cell in occupied:
