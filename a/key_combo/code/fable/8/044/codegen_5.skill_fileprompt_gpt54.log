+
+DIR_VECS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+
+OPPOSITE_DIR = {
+    "up": "down",
+    "down": "up",
+    "left": "right",
+    "right": "left",
+}
+
