            grid[r, c] = color
        mr, mc = markers[idx]
        if int(grid[mr, mc]) != int(bg):
            return None
        grid[mr, mc] = color
        instructions.append(
            {
                "color": int(color),
                "direction": directions[idx],
                "distance": distances[idx],
                "marker": (mr, mc),
            }
