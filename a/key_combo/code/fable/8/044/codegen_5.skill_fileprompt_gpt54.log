+        for c in range(w):
+            if visited[r, c] or int(grid[r, c]) != int(color):
+                continue
+            stack = [(r, c)]
+            visited[r, c] = True
+            coords = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
