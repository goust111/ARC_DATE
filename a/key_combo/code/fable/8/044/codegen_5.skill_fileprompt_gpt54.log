+
+    counts = {color: random.randint(2, 4) for color in colors}
+    placements = {colors[0]: [a_seed], colors[1]: [b_seed]}
+    occupied = {a_seed, b_seed}
+
+    for idx, color in enumerate(colors[2:], start=2):
+        if not pool:
+            return None
+        cell = pool.pop()
+        placements[color] = [cell]
