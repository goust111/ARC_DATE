+    dr, dc = DIR_VECS[direction]
+    for r, c in coords:
+        cr, cc = r, c
+        while True:
+            nr = cr + dr
+            nc = cc + dc
+            if not (ir0 <= nr <= ir1 and ic0 <= nc <= ic1):
+                break
+            if int(out[nr, nc]) != int(bg):
