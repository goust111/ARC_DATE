    if count == 0:
        return []
    if count == 1:
        return [int(rng.choice(vals))]
    pairs = [(a, b) for i, a in enumerate(vals) for b in vals[i + 1 :] if b - a >= MIN_LINE_SPACING]
    if not pairs:
        return None
    return list(pairs[int(rng.integers(len(pairs)))])


