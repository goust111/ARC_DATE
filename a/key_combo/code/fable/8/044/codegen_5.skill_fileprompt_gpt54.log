+    if direction == "left":
+        coords.sort(key=lambda p: (p[1], p[0]))
+    elif direction == "right":
+        coords.sort(key=lambda p: (-p[1], p[0]))
+    elif direction == "up":
+        coords.sort(key=lambda p: (p[0], p[1]))
+    elif direction == "down":
+        coords.sort(key=lambda p: (-p[0], p[1]))
+    else:
+        raise AssertionError("unknown direction")
