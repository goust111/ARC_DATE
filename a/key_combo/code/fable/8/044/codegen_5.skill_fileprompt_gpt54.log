    r, c = marker
    r0, c0, r1, c1 = frame_bbox
    if r0 <= r <= r1 and c < c0:
        return "left", c0 - c
    if r0 <= r <= r1 and c > c1:
        return "right", c - c1
    if c0 <= c <= c1 and r < r0:
        return "up", r0 - r
    if c0 <= c <= c1 and r > r1:
        return "down", r - r1
    raise AssertionError("marker must lie unambiguously outside one frame side")


def _extract_state(grid: np.ndarray) -> tuple[int, dict, list[dict]]:
    g = np.asarray(grid, dtype=int)
