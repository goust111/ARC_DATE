+        if not _touches_all_sides(mask):
+            continue
+        if not _is_connected(mask):
+            continue
+        if _is_lr_symmetric(mask):
+            continue
+        sym = _symmetrized_mask(mask)
+        if not _is_connected(sym):
+            continue
+        return mask
+    return None
