+            DIRS["U"]: DIRS["R"],
+            DIRS["R"]: DIRS["U"],
+            DIRS["D"]: DIRS["L"],
+            DIRS["L"]: DIRS["D"],
+        }
+    else:
+        mapping = {
+            DIRS["U"]: DIRS["L"],
+            DIRS["L"]: DIRS["U"],
+            DIRS["D"]: DIRS["R"],
+            DIRS["R"]: DIRS["D"],
+        }
