+MIN_FIRST_CENTER_DIST = 3
+MIN_CENTER_DIST = 4
+MAX_HIT_COUNT = 4
+MAX_DECOY_COUNT = 3
+
+DIRS = {
+    "U": (-1, 0),
+    "D": (1, 0),
+    "L": (0, -1),
+    "R": (0, 1),
+}
+CORNER_OFFSETS = {
+    "NW": (-1, -1),
+    "NE": (-1, 1),
+    "SW": (1, -1),
+    "SE": (1, 1),
+}
+MIRROR_CORNERS = {
+    "/": ("NE", "SW"),
+    "\\": ("NW", "SE"),
