0007: def main(grid: np.ndarray) -> np.ndarray:
0008:     """Shift monochromatic foreground objects one column left/right in alternating top-to-bottom order.
0009: 
0010:     Input structure
0011:     - The grid has a dominant background color.
0012:     - Every foreground shape is a single-color 4-connected object.
0013:     - The objects have distinct top bbox rows, giving a unique top-to-bottom order.
0014: 
0015:     Rule
0016:     - Sort the objects by their top bbox row.
0017:     - Shift the 1st, 3rd, 5th, ... objects one column left.
0018:     - Shift the 2nd, 4th, 6th, ... objects one column right.
0019:     - Vacated cells become background, and colors/shapes are preserved.
0020: 
0021:     Key insight
0022:     - The movement direction is not tied to color or shape; it is the object's rank in the vertical order.
0023:     """
0024:     g = np.asarray(grid, dtype=int)
0025:     bg = get_bg(g)
0026:     objects = find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict")
0027:     assert objects, "expected at least one foreground object"
0028: 
0029:     top_rows = [int(obj["bbox"][0]) for obj in objects]
0030:     assert len(set(top_rows)) == len(top_rows), "foreground objects must have distinct top rows"
0031:     ordered = sorted(objects, key=lambda obj: int(obj["bbox"][0]))
0032: 
0033:     out = np.full_like(g, bg)
0034:     occupied = np.zeros(g.shape, dtype=bool)
0035:     height, width = g.shape
0036: 
