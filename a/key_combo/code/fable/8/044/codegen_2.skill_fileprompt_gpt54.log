+
+
+def _turn_left(direction: tuple[int, int]) -> tuple[int, int]:
+    dr, dc = direction
+    return -dc, dr
+
+
+def _turn_right(direction: tuple[int, int]) -> tuple[int, int]:
+    dr, dc = direction
+    return dc, -dr
+
+
+def _reflect(direction: tuple[int, int], mirror_kind: str) -> tuple[int, int]:
+    if mirror_kind == "/":
