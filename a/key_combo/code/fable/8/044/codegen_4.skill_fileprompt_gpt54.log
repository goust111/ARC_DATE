+    occupied = b0 + b1 + s0 + s1
+    halo = _halo(occupied, (h, w))
+    parity = (i00[0] - i00[1]) % 2
+    s2 = _place_skip_slash((h, w), halo, 1 - parity, {i00[0] + i00[1], i01[0] + i01[1]})
