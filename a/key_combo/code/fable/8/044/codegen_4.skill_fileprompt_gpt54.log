+def _place_skip_slash(
+    shape: tuple[int, int],
+    forbidden_halo: set[tuple[int, int]],
+    parity: int,
+    existing_slash_keys: set[int],
+) -> list[tuple[int, int]] | None:
+    h, w = shape
+    for _ in range(200):
+        length = random.randint(2, 5)
+        r0 = random.randint(0, h - length)
+        c0 = random.randint(length - 1, w - 1)
