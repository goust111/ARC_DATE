+            if 1 <= cc <= w - 2:
+                coords.add((rr, cc))
+        if gap_rows and random.random() < 0.35:
+            rr = random.choice(gap_rows)
+            side = random.choice([-1, 1])
+            cc = anchor + side
+            if 1 <= cc <= w - 2:
+                coords.add((rr, cc))
+        return coords
+    return None
+
+
+def _make_gap_object(w: int, rows: list[int]) -> set[tuple[int, int]] | None:
+    if not rows:
+        return None
