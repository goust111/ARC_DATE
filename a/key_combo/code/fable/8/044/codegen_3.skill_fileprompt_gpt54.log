+
+def _aligned_union(masks: list[np.ndarray]) -> np.ndarray:
+    h = max(int(mask.shape[0]) for mask in masks)
+    w = max(int(mask.shape[1]) for mask in masks)
+    union = np.zeros((h, w), dtype=bool)
+    for mask in masks:
+        mh, mw = map(int, mask.shape)
+        union[:mh, :mw] |= mask
