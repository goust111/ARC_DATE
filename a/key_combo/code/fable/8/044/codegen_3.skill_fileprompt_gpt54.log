+                    return None
+                parent[(nr, nc)] = nbrs[0]
+                mask[nr, nc] = True
+            r, c = nr, nc
+
+    target_area = random.randint(max(min_area, int(mask.sum())), max_area)
+    while int(mask.sum()) < target_area:
+        candidates = []
+        for r in range(h):
+            for c in range(w):
+                if mask[r, c]:
+                    continue
+                nbrs = [(rr, cc) for rr, cc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)) if 0 <= rr < h and 0 <= cc < w and mask[rr, cc]]
+                if len(nbrs) == 1:
+                    candidates.append((r, c, nbrs[0]))
+        if not candidates:
+            return None
+        r, c, p = random.choice(candidates)
+        mask[r, c] = True
+        parent[(r, c)] = p
+
+    if not (mask[0, :].any() and mask[-1, :].any() and mask[:, 0].any() and mask[:, -1].any()):
+        return None
+    if np.array_equal(mask, np.ones_like(mask, dtype=bool)):
+        return None
+
+    children = {node: 0 for node in parent}
+    for node, p in parent.items():
+        if p is not None:
+            children[p] += 1
+    leaves = [node for node, count in children.items() if count == 0 and node != (0, 0)]
+    if len(leaves) < 3:
+        return None
+    return mask, parent
