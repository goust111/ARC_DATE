+    for frag in fragments:
+        union |= frag
+    if not np.array_equal(union, mask):
+        return None
+    if any(np.array_equal(frag, mask) for frag in fragments):
+        return None
+    if len({_mask_key(frag) for frag in fragments}) != len(fragments):
