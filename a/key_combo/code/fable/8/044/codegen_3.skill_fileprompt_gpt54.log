+def _fragments_from_shape(mask: np.ndarray, parent: dict[tuple[int, int], tuple[int, int] | None], count: int) -> list[np.ndarray] | None:
+    leaves = _tree_leaves(parent)
+    if len(leaves) < count:
+        return None
