+def _coords_key(coords: np.ndarray) -> tuple[tuple[int, int], tuple[tuple[int, int], ...]]:
+    r0, c0, r1, c1 = bbox_coords(coords)
+    local = coords - np.array([r0, c0], dtype=int)
