+    assert g.ndim == 2
+    h, w = map(int, g.shape)
+    bg = get_bg(g)
+
+    sep_cols = [
+        c
+        for c in range(1, w - 1)
+        if int(g[0, c]) != bg and np.all(g[:, c] == g[0, c])
+    ]
+    assert len(sep_cols) == 1
+    sep = sep_cols[0]
+
+    left = g[:, :sep]
+    right = g[:, sep + 1 :]
