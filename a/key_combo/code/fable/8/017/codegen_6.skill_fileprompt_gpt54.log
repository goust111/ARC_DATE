+    r0, c0, r1, c1 = box
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    return (
+        np.any(rows == r0)
+        and np.any(rows == r1)
+        and np.any(cols == c0)
+        and np.any(cols == c1)
+    )
+
