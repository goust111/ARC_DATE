+_GRID_SIDE_RANGE = (18, 27)
+_RECT_COUNT_RANGE = (3, 5)
+_RECT_HEIGHT_RANGE = (4, 10)
+_RECT_WIDTH_RANGE = (4, 10)
+_WITNESS_RADIUS = 4
+_BORDER_PAD = 1
