+        for axis in ("h", "v"):
+            report = _symmetry_report(mask, axis)
+            if report["mismatch"] == 2 and report.get("valid", False):
+                vr, vc = report["vacancy"]
+                candidates.append((axis, r0 + int(vr), c0 + int(vc)))
