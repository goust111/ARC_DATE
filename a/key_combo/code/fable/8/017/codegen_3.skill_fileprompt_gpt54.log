+    assert sum(item["row"] == top["row"] for item in broken) == 1
+    assert sum(item["row"] == bottom["row"] for item in broken) == 1
+    assert sum(item["col"] == left["col"] for item in broken) == 1
+    assert sum(item["col"] == right["col"] for item in broken) == 1
