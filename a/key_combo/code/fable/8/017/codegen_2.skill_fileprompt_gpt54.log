+def _find_components(grid: np.ndarray, bg: int) -> tuple[list[dict], dict[tuple[int, int], int]]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[dict] = []
