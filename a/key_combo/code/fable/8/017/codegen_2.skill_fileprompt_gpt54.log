32:        assert len(coords) > 0
33:        r0, _c0, r1, _c1 = bbox_coords(coords)
34:
35:        rr = r0 + r1 - coords[:, 0]
36:        cc = coords[:, 1]
37:        assert np.all(out[rr, cc] == bg)
38:        out[rr, cc] = color
