+    return {
+        "height": height,
+        "width": width,
+        "offset": (offset_r, offset_c),
+        "start": (offset_r, offset_c),
+        "blobs": blobs,
+        "colors": colors,
+        "turns": turns,
+        "areas": areas,
+        "path_cells": path_cells,
+    }
+
+
+def _render_plan(plan: dict) -> np.ndarray:
+    grid = np.full((plan["height"], plan["width"]), Color.BLACK, dtype=int)
+    start_r, start_c = plan["start"]
