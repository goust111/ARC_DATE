7:def main(grid: np.ndarray) -> np.ndarray:
8:    """Reflect each foreground color mask vertically inside its own bounding box.
9:
10:    Input structure
11:    - A dominant background contains several monochrome foreground masks.
12:    - Each foreground color is a glyph-like mask; it may be split under
13:      4-connectivity but is treated as one mask by color.
14:
15:    Rule
16:    - For each non-background color independently, find the mask's bounding box.
17:    - Keep every pixel's column and replace its row r by r0 + r1 - r, where
18:      r0 and r1 are the top and bottom rows of that color mask's bounding box.
19:
20:    Key insight
21:    - The scene is not globally flipped; each colored mask is mirrored within its
22:      own vertical extent, so one-row and vertically symmetric masks stay fixed.
23:    """
24:    g = np.asarray(grid, dtype=int)
25:    assert g.ndim == 2
