+
+    patches: list[tuple[np.ndarray, int]] = []
+    for idx, (hole_mask, _group) in enumerate(hole_groups):
+        patch = _gen_ring_patch(rng, hole_mask, int(colors[idx]))
+        if patch is None:
+            return None
+        patches.append((patch, idx))
