+        try:
+            r0, c0 = random_free_location(
+                blocked,
+                block_patch,
+                transparent=0,
+                border=1,
+                padding=_GEN_CLEARANCE,
+                padding_connectivity=8,
+            )
+        except ValueError:
+            return None
+        paste(grid, patch, r0, c0, transparent=Color.BLACK)
+        paste(blocked, block_patch, r0, c0, transparent=0)
