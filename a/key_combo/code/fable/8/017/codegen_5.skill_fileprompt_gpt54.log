+            c0 = int(rng.integers(base_c0, base_c0 + base_w - span + 1))
+            if side == 0:
+                outer[base_r0 - thick : base_r0, c0 : c0 + span] = True
+            else:
+                outer[base_r0 + base_h : base_r0 + base_h + thick, c0 : c0 + span] = True
+        else:
