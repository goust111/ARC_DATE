+                    (r + dr, c + dc)
+                    for r, c in cells
+                    for dr, dc in _DIRS4
+                    if 0 <= r + dr < h and 0 <= c + dc < w and (r + dr, c + dc) not in cells
+                }
+            )
+            if not frontier:
+                break
+            cells.add(frontier[int(rng.integers(0, len(frontier)))])
+        if len(cells) != target_area:
