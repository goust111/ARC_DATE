+    out = g.copy()
+    by_id = {int(info["id"]): info for info in infos}
+    for left_id, right_id in pairs:
+        left = by_id[left_id]
+        right = by_id[right_id]
+        out[left["obj_mask"]] = int(right["color"])
+        out[right["obj_mask"]] = int(left["color"])
+    return out
