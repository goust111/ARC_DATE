+    shape = _gen_canvas_shape(rng, [patch for patch, _idx in patches])
+    if shape is None:
+        return None
+    height, width = shape
+    grid = np.full((height, width), Color.BLACK, dtype=int)
+    blocked = np.zeros((height, width), dtype=int)
