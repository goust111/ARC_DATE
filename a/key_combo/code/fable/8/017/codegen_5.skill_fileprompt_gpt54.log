+_GEN_MAX_ATTEMPTS = 400
+_GEN_HOLE_ATTEMPTS = 80
+_GEN_PAIR_COUNT_CHOICES = (1, 1, 2, 2, 3)
+_GEN_SINGLE_COUNT_CHOICES = (0, 1, 1, 2, 2, 3)
