+
+    sep_r = _find_separator_row(g)
+    top = g[:sep_r, :]
+    bottom = g[sep_r + 1 :, :]
+    assert top.shape == bottom.shape and top.size > 0, "top and bottom halves must match"
+
+    common_colors = set(map(int, np.unique(top))) & set(map(int, np.unique(bottom)))
