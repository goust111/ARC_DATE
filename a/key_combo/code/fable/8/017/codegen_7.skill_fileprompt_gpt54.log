+def _expected_output(diff: np.ndarray) -> np.ndarray:
+    h, w = map(int, diff.shape)
+    stamp = np.where(diff, OUTPUT_STAMP_COLOR, OUTPUT_BACKGROUND)
+    out = np.full((h * h, w * w), OUTPUT_BACKGROUND, dtype=int)
+    for r, c in np.argwhere(diff):
