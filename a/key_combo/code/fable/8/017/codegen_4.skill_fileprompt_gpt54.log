+    h, w = map(int, tile.shape)
+    for dr in range(h):
+        for dc in range(w):
+            if dr == 0 and dc == 0:
+                continue
+            if np.array_equal(tile, np.roll(tile, shift=(-dr, -dc), axis=(0, 1))):
+                return False
+    return True
+
