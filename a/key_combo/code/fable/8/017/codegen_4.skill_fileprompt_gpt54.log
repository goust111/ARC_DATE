+
+    if (got_p, got_q) != (p, q):
+        return None
+    if got_phase != (bad_r % p, bad_c % q):
+        return None
+    if not np.array_equal(got_tile, tile):
+        return None
+
+    out = _render_output(tile, got_phase)
+    if max(grid.shape) > 30 or max(out.shape) > 30:
