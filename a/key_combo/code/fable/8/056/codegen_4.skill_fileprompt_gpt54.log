+
+def _canonical_row_groups(mask: np.ndarray) -> dict[int, list[int]]:
+    groups: dict[int, list[int]] = {}
+    for r in range(mask.shape[0]):
+        cols = [int(c) for c in np.where(mask[r])[0]]
+        if cols:
