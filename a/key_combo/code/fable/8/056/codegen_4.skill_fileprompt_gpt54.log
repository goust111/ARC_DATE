+        candidates.append((1, 1))
+    if ac1 < sc0 and _intervals_overlap(sr0, sr1, ar0, ar1):
+        candidates.append((1, -1))
+    if sr1 < ar0 and _intervals_overlap(sc0, sc1, ac0, ac1):
