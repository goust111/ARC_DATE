+    if not stackable:
+        return False
+
+    try:
+        solved = main(inp)
+    except Exception:
+        return False
+    if not np.array_equal(solved, expected):
+        return False
+
+    return True
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(_GEN_RETRIES):
+        pair = _generate_canonical_pair()
+        if pair is None:
