+_GEN_RETRIES = 400
+_LOCAL_H_RANGE = (3, 5)
+_LOCAL_W_RANGE = (4, 7)
+_GATE_GAP_RANGE = (2, 4)
+_GATE_SEG_LEN_CHOICES = (1, 2)
