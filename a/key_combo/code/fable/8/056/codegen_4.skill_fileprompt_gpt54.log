+    inp = np.full((H, W), bg, dtype=int)
+    out = np.full((H, W), bg, dtype=int)
+    paste(inp, tinp, extra_top, extra_left, transparent=bg)
+    paste(out, tout, extra_top, extra_left, transparent=bg)
+    return inp, out
