+def _canonical_expected(sprite: np.ndarray, bg: int, anchor_color: int, gate_specs: list[dict], anchor_top: int, anchor_left: int) -> np.ndarray:
+    h, w = sprite.shape
+    top_margin = 2
+    local_h = top_margin + h + 2
+    local_w = anchor_left + 2
