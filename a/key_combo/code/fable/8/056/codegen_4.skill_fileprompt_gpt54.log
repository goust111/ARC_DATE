+        line_lengths = [int(mask[r, :].sum()) for r in range(h)]
+        if max(line_lengths) < 2 or sum(length > 0 for length in line_lengths) < 2:
+            continue
+        if not is_contiguous(mask, background=False, connectivity=8):
+            continue
