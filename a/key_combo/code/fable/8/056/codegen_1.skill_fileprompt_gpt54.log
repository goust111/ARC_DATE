+        return grid.copy()
+    if mode == "fliplr":
+        return np.fliplr(grid).copy()
+    if mode == "transpose":
+        return grid.T.copy()
+    if mode == "transpose_flipud":
+        return np.flipud(grid.T).copy()
+    raise ValueError(f"unknown transform mode: {mode}")
