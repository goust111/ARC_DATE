+    rows = [np.flatnonzero(crop[:, int(c)]) for c in tail_cols]
+    if any(rr.size != 1 for rr in rows):
+        return None
+    tail_r = int(rows[0][0])
+    if tail_r <= 0 or tail_r >= h - 1:
+        return None
+    if any(int(rr[0]) != tail_r for rr in rows):
