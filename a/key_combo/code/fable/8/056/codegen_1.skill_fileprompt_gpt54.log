+
+    if not np.array_equal(rebuilt, expected):
+        return None
+    if not np.array_equal(main(inp), expected):
+        return None
+    if base["relays"] > 0 and np.array_equal(expected, naive):
+        return None
+    if len(np.unique(inp)) < 4:
+        return None
+    return inp
+
