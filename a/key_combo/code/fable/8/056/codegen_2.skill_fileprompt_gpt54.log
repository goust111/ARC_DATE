+            "center": center,
+            "visible": visible,
+            "ray_counts": ray_counts,
+            "input_rays": input_rays,
+        }
+    return None
+
+
+def validate_instance(inp: np.ndarray, out: np.ndarray, specs: list[dict], bg: int) -> bool:
+    if np.array_equal(inp, out):
+        return False
+    if get_bg(inp) != bg or get_bg(out) != bg:
+        return False
