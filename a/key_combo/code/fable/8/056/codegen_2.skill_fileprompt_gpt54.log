+
+
+def choose_directions(center: Coord, shape: tuple[int, int]) -> dict[Step, int] | None:
+    feasible = [step for step in DIRS if max_distance_to_edge(center, step, shape) >= 3]
+    by_family: dict[str, list[Step]] = {}
