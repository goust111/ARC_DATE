+    mask = np.zeros((h, w), dtype=bool)
+    start = (random.randrange(h), random.randrange(w))
+    mask[start] = True
+    while int(mask.sum()) < area:
+        frontier = set()
+        for r, c in np.argwhere(mask):
+            for dr in (-1, 0, 1):
+                for dc in (-1, 0, 1):
+                    if dr == 0 and dc == 0:
+                        continue
+                    nr = int(r) + dr
+                    nc = int(c) + dc
+                    if 0 <= nr < h and 0 <= nc < w and not bool(mask[nr, nc]):
