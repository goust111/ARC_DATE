+def _random_template_mask() -> np.ndarray | None:
+    h = random.randint(*TEMPLATE_H_RANGE)
+    w = random.randint(*TEMPLATE_W_RANGE)
+    area = random.randint(max(TEMPLATE_AREA_RANGE[0], h + w - 1), min(TEMPLATE_AREA_RANGE[1], h * w - 1))
