spec:
  grid: 8-11 rows x 8-11 cols (square or near-square) [observed]
  background: single color (always 8 in eval) [observed]; most-frequent color
  objects:
    count: 4 [observed], each a monochromatic 4-connected foreground component
    colors: each object has a distinct non-bg color
    bbox_width: 2-6 columns; must be >= 2 (solver asserts)
    bbox_height: 2-5 rows
    pixel_count: 4-14
