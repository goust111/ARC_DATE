+    h, w = masks[0].shape
+    grid = np.zeros((h * BAND_COUNT, w), dtype=int)
+    for band_index, (mask, color) in enumerate(zip(masks, colors)):
+        band = grid[band_index * h : (band_index + 1) * h]
+        band[mask] = int(color)
+    return grid
