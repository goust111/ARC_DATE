+def _pick_anchor_cells(h: int, w: int) -> list[tuple[int, int]]:
+    cells = [(r, c) for r in range(h) for c in range(w)]
+    random.shuffle(cells)
+    return cells[: len(ANCHOR_PATTERNS)]
