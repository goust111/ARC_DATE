+    red_dist = _bfs(red, nodes)
+    blue_dist = _bfs(blue, nodes)
+
+    out = g.copy()
+    tie_cells: set[tuple[int, int]] = set()
+    unreachable_conductive: set[tuple[int, int]] = set()
+    recolored_red = 0
+    recolored_blue = 0
+    inf = 10**9
+
+    for cell in conductive:
