+        branch = _extend_logical_path(seed, length - 1, occupied | {seed}, LOGICAL_RADIUS)
+        if branch is None:
+            continue
+        return [seed] + branch
+
+    return None
+
+
+def _shifted_grid(
+    regular_cells: set[tuple[int, int]],
+    red_actual: tuple[int, int],
+    blue_actual: tuple[int, int],
+    breakers: set[tuple[int, int]],
