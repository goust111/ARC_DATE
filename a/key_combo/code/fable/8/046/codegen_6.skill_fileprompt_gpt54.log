+        "red": red,
+        "blue": blue,
+        "grey_cells": grey_cells,
+        "insulators": insulators,
+        "conductive": conductive,
+        "red_dist": red_dist,
+        "blue_dist": blue_dist,
+        "tie_cells": tie_cells,
+        "unreachable_conductive": unreachable_conductive,
+        "recolored_red": recolored_red,
+        "recolored_blue": recolored_blue,
