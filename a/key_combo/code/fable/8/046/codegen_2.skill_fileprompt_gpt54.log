+        cur += h + 1
+    cur = 1
+    for w in widths:
+        col_starts.append(cur)
+        cur += w + 1
+
+    for i in range(rows - 1):
+        split_r = row_starts[i] + heights[i]
+        wall[split_r, :] = True
+    for j in range(cols - 1):
+        split_c = col_starts[j] + widths[j]
+        wall[:, split_c] = True
+
+    for i in range(rows):
+        for j in range(cols):
+            r0 = row_starts[i]
+            r1 = r0 + heights[i] - 1
+            c0 = col_starts[j]
+            c1 = c0 + widths[j] - 1
+            rooms.append((r0, r1, c0, c1))
+
+    return wall, rooms
+
+
+def _build_split_geometry(room_count: int) -> tuple[np.ndarray, list[tuple[int, int, int, int]]] | None:
+    for _ in range(80):
+        inner_h = random.randint(6, 10)
+        inner_w = random.randint(6, 10)
+        wall = np.zeros((inner_h + 2, inner_w + 2), dtype=bool)
+        wall[0, :] = True
+        wall[-1, :] = True
+        wall[:, 0] = True
+        wall[:, -1] = True
+
+        rooms = [(1, inner_h, 1, inner_w)]
+        used_rows: set[int] = set()
+        used_cols: set[int] = set()
+        ok = True
+
+        for _split_idx in range(room_count - 1):
+            candidates = []
+            for idx, room in enumerate(rooms):
+                r0, r1, c0, c1 = room
+                options = []
+                if c1 - c0 + 1 >= 5:
+                    options.append("v")
+                if r1 - r0 + 1 >= 5:
+                    options.append("h")
+                if options:
