+                {
+                    "color": color,
+                    "coords": np.array(cells, dtype=int),
+                    "bbox": bbox,
+                    "area": len(cells),
+                }
+            )
+    return comps
+
+
+def _is_line_bar(comp: dict) -> bool:
+    r0, c0, r1, c1 = comp["bbox"]
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    return comp["area"] > 1 and ((h == 1 and comp["area"] == w) or (w == 1 and comp["area"] == h))
+
