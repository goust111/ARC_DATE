+    target = matches[0]
+    target_area = target["interior"].shape[0] * target["interior"].shape[1]
+    frame_areas = [frame["interior"].shape[0] * frame["interior"].shape[1] for frame in frames]
+    if not (min(frame_areas) < target_area < max(frame_areas)):
+        return False
+
+    return True
