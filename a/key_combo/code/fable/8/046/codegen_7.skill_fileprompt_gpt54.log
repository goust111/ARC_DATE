+    info = _parse_scene(np.asarray(grid, dtype=int))
+    out = np.array(grid, copy=True)
+    r0, c0, r1, c1 = info["ruined"]["bbox"]
+    out[r0 : r1 + 1, c0 : c1 + 1] = info["donor_patch"]
