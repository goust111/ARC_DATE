+        for rec in info["block_records"]
+        if rec is not info["ruined"]
+    }
+    if len(intact_majorities) < 2:
+        return False
+
+    target_texture = textures[int(category_grid[ruined_index])]
+    if len({int(x) for x in target_texture.reshape(-1)}) < 2:
+        return False
+
+    return True
