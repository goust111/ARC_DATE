+# --------------- generator ---------------
+
+_COLORS = tuple(range(10))
+_MIN_BLOCK_ROWS = 2
+_MAX_BLOCK_ROWS = 4
+_MIN_BLOCK_COLS = 2
+_MAX_BLOCK_COLS = 4
+_MIN_BLOCK_H = 3
+_MAX_BLOCK_H = 4
+_MIN_BLOCK_W = 3
+_MAX_BLOCK_W = 4
+_SEP_CHOICES = (1, 2)
+_GUIDE_GAP_CHOICES = (1, 2)
