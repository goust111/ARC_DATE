    socket_width: 3-5 (= back_wall_width - 2*side_wall - 2*gap)
    teeth_count: 1-3 contiguous cells between side walls in row 1
    gap_count: always 2 gaps (one on each side of teeth block), each 1-2 cells wide
  red_components:
    all_rectangular: true
    matched: 1 per structure (0 if no red in line-of-sight); shape = min(teeth,2) x teeth in normalized coords
    distractors: 2-8 per grid, sizes 1x1 to 3x2, scattered; must NOT be on clear line-of-sight from any socket through opening
    total: 5-11
  output_rule: |
    Each matched red slides from opening side into socket, docking below/beside teeth block.
    Trail (black) painted over all intermediate positions. Unmatched reds erased to bg.
  trail:
    slide_distance: 4-8 cells from original red to docked position
    shape: red_shape extruded along slide direction

generation_strategy:
  approach: output-first (build docked state, then extract input)
  steps:
    1. Pick grid size, bg color, structure color.
    2. For each structure (2-3), pick back_wall_direction and normalized width (7-9).
       Build normalized pattern with 1-3 teeth. Rotate to chosen direction. Place non-overlapping.
    3. For each structure, compute matching red shape from teeth (min(teeth,2) x teeth rotated).
       Pick a slide distance (4-8). Place the matching red that many cells away on the opening side,
       ensuring clear bg line-of-sight to socket. This is the INPUT red position.
    4. Optionally leave 0-1 structures unmatched (no red placed for them).
    5. Scatter 2-8 distractor red rectangles (1x1 to 3x2) on bg cells, ensuring none is on
       clear line-of-sight from any socket through its opening direction.
    6. Input = grid with structures + all reds at original positions. Output = docked reds + black trails + distractors erased.
