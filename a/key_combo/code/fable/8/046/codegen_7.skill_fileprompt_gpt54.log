+    return {
+        "bg": bg,
+        "rows": rows,
+        "cols": cols,
+        "block_shape": block_shape,
+        "guide": guide,
+        "guide_colors": guide_colors,
+        "block_records": block_records,
+        "ruined": ruined,
+        "ruined_index": (ruined_r, ruined_c),
