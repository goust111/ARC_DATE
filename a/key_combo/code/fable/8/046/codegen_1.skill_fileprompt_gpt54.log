+    r0 = random.randint(r_lo, r_hi)
+    c0 = random.randint(c_lo, c_hi)
+    r1 = r0 + fh - 1
+    c1 = c0 + fw - 1
+    if side in ("top", "bottom"):
+        gap = (r0 if side == "top" else r1, random.randint(c0 + 1, c1 - 1))
+    else:
+        gap = (random.randint(r0 + 1, r1 - 1), c0 if side == "left" else c1)
