def main(grid: np.ndarray) -> np.ndarray:
    """
    Move aligned singleton markers along straight sightlines until they touch the nearest 2x2 block, leaving non-sightline and lower-left distractor markers fixed.

    Input structure
    - The background is the dominant color.
    - One foreground color forms filled 2x2 blocks.
    - The other foreground color forms singleton marker pixels.

    Rule
    - For each marker, find clear horizontal or vertical sightlines to any 2x2 block and choose the unique nearest block by travel distance.
    - Move that marker to the adjacent ring cell on the same row or column of the chosen block.
    - Markers with no clear sightline stay in place; a lower-row marker to the left of a block also stays fixed when that block already has chosen vertical markers both above and below it.

    Key insight
    - The red 2x2 blocks act as magnets, so each direct marker ray is compressed to the one-cell ring around its nearest block while unrelated singleton markers remain noise.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "expected a 2D grid"

    bg = get_bg(g)
    marker_color, block_color, blocks = _infer_roles(g, bg)

    marker_coords = [tuple(map(int, coord)) for coord in np.argwhere(g == marker_color)]
    assert marker_coords, "expected at least one marker"
    assert all(int(g[r, c]) == marker_color for r, c in marker_coords)
    assert np.count_nonzero(g == block_color) == 4 * len(blocks)

    best_by_marker: dict[Coord, Candidate] = {}
    for marker in marker_coords:
        candidate = _best_candidate(g, bg, marker, blocks)
        if candidate is not None:
            best_by_marker[marker] = candidate

    vertical_sides: dict[int, set[str]] = {}
    for marker, candidate in best_by_marker.items():
        _distance, block_index, _dst, direction = candidate
        if direction in {"down", "up"}:
            side = "above" if direction == "down" else "below"
            vertical_sides.setdefault(block_index, set()).add(side)

    moves: list[tuple[Coord, Coord]] = []
    destinations: set[Coord] = set()
    for marker, candidate in best_by_marker.items():
        if _skip_lower_left_distractor(marker, candidate, blocks, vertical_sides):
            continue

        _distance, _block_index, dst, _direction = candidate
        assert dst not in destinations, "marker destinations must be unique"
        destinations.add(dst)
        moves.append((marker, dst))

    out = g.copy()
    for src, _dst in moves:
        out[src] = bg
    for _src, dst in moves:
        assert int(out[dst]) == bg, "marker destination must be background after clearing"
        out[dst] = marker_color

    return out

# --------------- generator (o5x) ---------------

# Colors used by the observed task.
_GEN_BG, _GEN_MARKER, _GEN_BLOCK = 0, 1, 2
# Canvas and background constraints.
_CANVAS_MIN_H, _CANVAS_MIN_W = 10, 13
_CANVAS_MAX_H = _CANVAS_MAX_W = 30
_MIN_BG_FRACTION = 0.92
# Block layout constraints.
_BLOCK_SIZE, _BLOCK_EDGE_MARGIN = 2, 1
_BLOCK_COUNT_MIN, _BLOCK_COUNT_MAX = 2, 4
_BLOCK_SLOT_MAX, _BLOCK_SLOT_BASE_DIM, _BLOCK_TOPLEFT_MIN_SEP = 4, 4, 8
_RING_EDGE_ROOM = 2
# Marker movement and noise constraints.
_MARKER_MAX_COUNT, _MOVED_MAX_TOTAL = 15, 12
_MOVED_PER_BLOCK_MIN, _MOVED_PER_BLOCK_MAX = 1, 4
_SOURCE_DISTANCE_MIN, _SOURCE_DISTANCE_MAX = 1, 8
_NOISE_MIN_COUNT, _NOISE_MAX_COUNT = 1, 5
_DISTRACTOR_PROB = 0.55
# Retry budget for rejection sampling.
_GENERATE_ATTEMPTS = 300

GenMove = tuple[int, Coord, str, Coord]
RingOption = tuple[Coord, str, Coord]
SourceOption = tuple[Coord, list[Coord], int]


def _gen_min_dim(canvas_min: int, slot_count: int) -> int:
    return max(canvas_min, _BLOCK_SLOT_BASE_DIM + _BLOCK_TOPLEFT_MIN_SEP * (slot_count - 1))

def _gen_pick_spaced_positions(lo: int, hi: int, count: int, sep: int) -> list[int] | None:
    if count <= 0:
        return []
    max_base = hi - (sep - 1) * (count - 1)
    if max_base < lo:
        return None
    bases = sorted(random.sample(range(lo, max_base + 1), count))
    return [base + i * (sep - 1) for i, base in enumerate(bases)]

def _gen_slot_pairs(block_count: int) -> list[tuple[int, int]]:
    pairs: list[tuple[int, int]] = []
    for row_slots in range(1, _BLOCK_SLOT_MAX + 1):
        for col_slots in range(1, _BLOCK_SLOT_MAX + 1):
            if row_slots * col_slots >= block_count:
                min_h = _gen_min_dim(_CANVAS_MIN_H, row_slots)
                min_w = _gen_min_dim(_CANVAS_MIN_W, col_slots)
                if min_h <= _CANVAS_MAX_H and min_w <= _CANVAS_MAX_W:
                    pairs.append((row_slots, col_slots))
    return pairs

def _gen_place_blocks(
    h: int, w: int, block_count: int, row_slots: int, col_slots: int
) -> list[Coord]:
    lo = _BLOCK_EDGE_MARGIN
    max_r = h - (_BLOCK_SIZE + _BLOCK_EDGE_MARGIN)
    max_c = w - (_BLOCK_SIZE + _BLOCK_EDGE_MARGIN)
    rows = _gen_pick_spaced_positions(lo, max_r, row_slots, _BLOCK_TOPLEFT_MIN_SEP)
    cols = _gen_pick_spaced_positions(lo, max_c, col_slots, _BLOCK_TOPLEFT_MIN_SEP)
    if rows is None or cols is None:
        return []
    cells = [(r, c) for r in rows for c in cols]
    return random.sample(cells, block_count)

def _gen_marker_clear(inp: np.ndarray, cell: Coord) -> bool:
    h, w = inp.shape
    r, c = cell
    if int(inp[r, c]) != _GEN_BG:
        return False
    for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
        if 0 <= nr < h and 0 <= nc < w and int(inp[nr, nc]) == _GEN_MARKER:
            return False
    return True

def _gen_ring_options(block: Coord, h: int, w: int) -> list[RingOption]:
    r0, c0 = block
    r1, c1 = r0 + _BLOCK_SIZE - 1, c0 + _BLOCK_SIZE - 1
    options: list[RingOption] = []
    if r0 >= _RING_EDGE_ROOM:
        options.extend([((r0 - 1, c0), "top", (-1, 0)), ((r0 - 1, c1), "top", (-1, 0))])
    if r1 <= h - (_RING_EDGE_ROOM + 1):
        options.extend([((r1 + 1, c0), "bottom", (1, 0)), ((r1 + 1, c1), "bottom", (1, 0))])
    if c0 >= _RING_EDGE_ROOM:
        options.extend([((r0, c0 - 1), "left", (0, -1)), ((r1, c0 - 1), "left", (0, -1))])
    if c1 <= w - (_RING_EDGE_ROOM + 1):
        options.extend([((r0, c1 + 1), "right", (0, 1)), ((r1, c1 + 1), "right", (0, 1))])
    return options

def _gen_counts(block_count: int, moved_total: int) -> list[int]:
    counts = [_MOVED_PER_BLOCK_MIN] * block_count
    remaining = moved_total - _MOVED_PER_BLOCK_MIN * block_count
    order = list(range(block_count))
    random.shuffle(order)
    for idx, block_i in enumerate(order):
        rest = len(order) - idx - 1
        extra_max = _MOVED_PER_BLOCK_MAX - _MOVED_PER_BLOCK_MIN
        add_max = min(extra_max, remaining)
        add_min = max(0, remaining - extra_max * rest)
        add = random.randint(add_min, add_max)
        counts[block_i] += add
        remaining -= add
    return counts

def _gen_path_cells(src: Coord, dst: Coord) -> list[Coord]:
    r, c = src
    tr, tc = dst
    dr = int(np.sign(tr - r))
    dc = int(np.sign(tc - c))
    cells: list[Coord] = []
    while (r, c) != (tr, tc):
        r += dr
        c += dc
        cells.append((r, c))
    return cells

def _gen_source_options(
    inp: np.ndarray, dst: Coord, outward: Coord, reserved_bg: set[Coord]
) -> list[SourceOption]:
    h, w = inp.shape
    dr, dc = outward
    r, c = dst
    options: list[SourceOption] = []
    for dist in range(_SOURCE_DISTANCE_MIN, _SOURCE_DISTANCE_MAX + 1):
        src = (r + dr * dist, c + dc * dist)
        sr, sc = src
        if not (0 <= sr < h and 0 <= sc < w):
            continue
        if src in reserved_bg or not _gen_marker_clear(inp, src):
            continue
        path = _gen_path_cells(src, dst)
        if all(int(inp[pr, pc]) == _GEN_BG for pr, pc in path):
            options.append((src, path, dist))
    return options

def _gen_noise_cells(inp: np.ndarray, blocks: list[Coord]) -> list[Coord]:
    """Return background cells not row/column-aligned with any 2x2 block."""
    h, w = inp.shape
    cells: list[Coord] = []
    for r in range(h):
        for c in range(w):
            if int(inp[r, c]) != _GEN_BG:
                continue
            aligned = False
            for br, bc in blocks:
                if br <= r < br + _BLOCK_SIZE or bc <= c < bc + _BLOCK_SIZE:
                    aligned = True
                    break
            if not aligned:
                cells.append((r, c))
    return cells

def _gen_add_distractor(inp: np.ndarray, out: np.ndarray, block: Coord, reserved_bg: set[Coord]) -> bool:
    r0, c0 = block
    dst = (r0 + 1, c0 - 1)
    if c0 < _RING_EDGE_ROOM or dst in reserved_bg:
        return False
    candidates = _gen_source_options(inp, dst, (0, -1), reserved_bg)
    if not candidates:
        return False
    src, path, _dist = random.choice(candidates)
    sr, sc = src
    inp[sr, sc] = _GEN_MARKER
    out[sr, sc] = _GEN_MARKER
    reserved_bg.update(path)
    return True

def _gen_layout() -> tuple[int, int, list[Coord]] | None:
    """Choose canvas dimensions and separated 2x2 block anchors."""
    block_count = random.randint(_BLOCK_COUNT_MIN, _BLOCK_COUNT_MAX)
    row_slots, col_slots = random.choice(_gen_slot_pairs(block_count))
    h = random.randint(_gen_min_dim(_CANVAS_MIN_H, row_slots), _CANVAS_MAX_H)
    w = random.randint(_gen_min_dim(_CANVAS_MIN_W, col_slots), _CANVAS_MAX_W)

    blocks = _gen_place_blocks(h, w, block_count, row_slots, col_slots)
    if len(blocks) != block_count:
        return None
    return h, w, blocks

def _gen_plan_moves(
    blocks: list[Coord], counts: list[int], h: int, w: int
) -> tuple[list[GenMove], dict[int, list[RingOption]]] | None:
    """Choose unique ring destinations for all moved markers."""
    all_moves: list[GenMove] = []
    selected_by_block: dict[int, list[RingOption]] = {}
    for block_i, (block, count) in enumerate(zip(blocks, counts, strict=True)):
        options = _gen_ring_options(block, h, w)
        if len(options) < count:
            return None
        chosen = random.sample(options, count)
        selected_by_block[block_i] = chosen
        for dst, side, outward in chosen:
            all_moves.append((block_i, dst, side, outward))
    return all_moves, selected_by_block

def _gen_pick_distractor_block(
    blocks: list[Coord], selected_by_block: dict[int, list[RingOption]], all_moves: list[GenMove], want_distractor: bool
) -> int | None:
    """Pick a block eligible for the lower-left distractor rule."""
    if not want_distractor:
        return None

    move_dsts = {dst for _bi, dst, _side, _outward in all_moves}
    eligible: list[int] = []
    for block_i, block in enumerate(blocks):
        sides = {side for _dst, side, _outward in selected_by_block[block_i]}
        r0, c0 = block
        left_bottom = (r0 + _BLOCK_SIZE - 1, c0 - 1)
        if "top" in sides and "bottom" in sides and c0 >= _RING_EDGE_ROOM and left_bottom not in move_dsts:
            eligible.append(block_i)
    if eligible:
        return random.choice(eligible)
    return None

def _gen_place_moved_markers(
    inp: np.ndarray, out: np.ndarray, all_moves: list[GenMove], reserved_bg: set[Coord]
) -> bool:
    """Place source markers whose solver destinations are already reserved."""
    random.shuffle(all_moves)
    for _block_i, dst, _side, outward in all_moves:
        options = _gen_source_options(inp, dst, outward, reserved_bg)
        if not options:
            return False
        src, path, _dist = random.choice(options)
        sr, sc = src
        inp[sr, sc] = _GEN_MARKER
        dr, dc = dst
        out[dr, dc] = _GEN_MARKER
        reserved_bg.update(path)
    return True

def _gen_add_noise_markers(
    inp: np.ndarray, out: np.ndarray, blocks: list[Coord], reserved_bg: set[Coord], moved_total: int, has_distractor: bool
) -> bool:
    noise_max = min(_NOISE_MAX_COUNT, _MARKER_MAX_COUNT - moved_total - int(has_distractor))
    if noise_max < _NOISE_MIN_COUNT:
        return False
    noise_count = random.randint(_NOISE_MIN_COUNT, noise_max)
    noise_options = [cell for cell in _gen_noise_cells(inp, blocks) if _gen_marker_clear(inp, cell)]
    noise_options = [cell for cell in noise_options if cell not in reserved_bg]
    if len(noise_options) < noise_count:
        return False
    for r, c in random.sample(noise_options, noise_count):
        inp[r, c] = _GEN_MARKER
        out[r, c] = _GEN_MARKER
    return True

def _gen_attempt() -> np.ndarray | None:
    layout = _gen_layout()
    if layout is None:
        return None
    h, w, blocks = layout
    inp = np.zeros((h, w), dtype=int)
    out = np.zeros((h, w), dtype=int)
    for r, c in blocks:
        inp[r : r + _BLOCK_SIZE, c : c + _BLOCK_SIZE] = _GEN_BLOCK
        out[r : r + _BLOCK_SIZE, c : c + _BLOCK_SIZE] = _GEN_BLOCK

    block_count = len(blocks)
    max_moved = min(_MOVED_MAX_TOTAL, _MOVED_PER_BLOCK_MAX * block_count)
    moved_total = random.randint(block_count, max_moved)
    counts = _gen_counts(block_count, moved_total)
    want_distractor = random.random() < _DISTRACTOR_PROB

    move_plan = _gen_plan_moves(blocks, counts, h, w)
    if move_plan is None:
        return None
    all_moves, selected_by_block = move_plan

    distractor_block_i = _gen_pick_distractor_block(
        blocks, selected_by_block, all_moves, want_distractor
    )
    reserved_bg = {dst for _block_i, dst, _side, _outward in all_moves}
    if not _gen_place_moved_markers(inp, out, all_moves, reserved_bg):
        return None

    has_distractor = False
    if distractor_block_i is not None:
        has_distractor = _gen_add_distractor(
            inp, out, blocks[distractor_block_i], reserved_bg
        )

    if not _gen_add_noise_markers(
        inp, out, blocks, reserved_bg, moved_total, has_distractor
    ):
        return None

    if np.count_nonzero(inp == _GEN_BG) / inp.size < _MIN_BG_FRACTION:
        return None
    try:
        solved = main(inp)
    except Exception:
        return None
    if np.array_equal(solved, out):
        return inp
    return None

def generate_input() -> np.ndarray:
    for _ in range(_GENERATE_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError(f"generate_input: failed after {_GENERATE_ATTEMPTS} attempts")
def main(grid: np.ndarray) -> np.ndarray:
    """
    Slide closed foreground objects upward and open foreground objects downward, keeping their columns and stacking on collision.

    Input structure
    - The grid has a single background color and several monochromatic 4-connected foreground objects.
    - Some objects are closed frames with at least one enclosed background hole inside their bounding box.
    - The remaining objects are open line-like sprites with no enclosed hole.

    Rule
    - Redraw every object on an empty background canvas without changing its color, shape, or horizontal position.
    - Closed frame objects slide vertically upward to the first non-colliding position.
    - Open objects slide vertically downward to the first non-colliding position.
    - Within each direction, preserve the original vertical order so overlapping columns stack instead of crossing.

    Key insight
    - The only role distinction is whether an object encloses a hole: hole objects pack against the top edge, while non-hole objects pack against the bottom edge.
    """
    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)
    out = np.full_like(g, bg)
    objects = _objects(g, bg)

    closed = [obj for obj in objects if obj.closed]
    open_objects = [obj for obj in objects if not obj.closed]
    assert closed, "expected at least one closed object"
    assert open_objects, "expected at least one open object"

    for obj in sorted(closed, key=lambda o: (o.bbox[0], o.bbox[1], o.bbox[2], o.bbox[3])):
        _slide_into_place(out, obj, bg, upward=True)

    for obj in sorted(open_objects, key=lambda o: (-o.bbox[2], o.bbox[1], -o.bbox[0], o.bbox[3])):
        _slide_into_place(out, obj, bg, upward=False)

    return out

# --------------- generator (o5x) ---------------

# Canvas and object size bounds.
GRID_SIZE_MIN = 13
GRID_SIZE_MAX = 17
SPRITE_SIZE_MIN = 3
SPRITE_SIZE_MAX = 5

# Object count ranges.
CLOSED_COUNT_MIN = 2
CLOSED_COUNT_MAX = 3
OPEN_COUNT_MIN = 2
OPEN_COUNT_MAX = 4

# Palette constraints.
COLOR_MIN = 1
COLOR_MAX = 9
DISTINCT_COLOR_MIN = 3
DISTINCT_COLOR_MAX = 4
MAX_OBJECTS_PER_COLOR = 2

# Layout constraints.
MIN_ZONE_GAP = 3
LANE_GAP = 1
SCATTER_EDGE_MARGIN = 1
SCATTER_MIDDLE_FIRST_PROB = 0.8

# Retry limit.
GENERATION_ATTEMPTS = 300


def _gen_frame_mask(h: int, w: int) -> np.ndarray:
    mask = np.zeros((h, w), dtype=bool)
    mask[0, :] = True
    mask[-1, :] = True
    mask[:, 0] = True
    mask[:, -1] = True
    return mask


def _gen_cross_mask() -> np.ndarray:
    h = random.randint(SPRITE_SIZE_MIN, SPRITE_SIZE_MAX)
    w = random.randint(SPRITE_SIZE_MIN, SPRITE_SIZE_MAX)
    r = random.randint(1, h - 2)
    c = random.randint(1, w - 2)
    mask = np.zeros((h, w), dtype=bool)
    mask[r, :] = True
    mask[:, c] = True
    return mask


def _gen_color_labels(n: int) -> list[int]:
    min_k = max(DISTINCT_COLOR_MIN, (n + 1) // MAX_OBJECTS_PER_COLOR)
    k = random.randint(min_k, min(DISTINCT_COLOR_MAX, n))
    colors = random.sample(range(COLOR_MIN, COLOR_MAX + 1), k)
    counts = [1] * k
    for _ in range(n - k):
        choices = [i for i, count in enumerate(counts) if count < MAX_OBJECTS_PER_COLOR]
        counts[random.choice(choices)] += 1

    labels: list[int] = []
    for color, count in zip(colors, counts):
        labels.extend([color] * count)
    random.shuffle(labels)
    return labels


def _gen_patch(mask: np.ndarray, color: int) -> np.ndarray:
    patch = np.zeros(mask.shape, dtype=int)
    patch[mask] = color
    return patch


def _gen_partition_lanes(heights: list[int], capacity: int, n_lanes: int) -> list[list[int]] | None:
    order = list(range(len(heights)))
    random.shuffle(order)
    order.sort(key=lambda i: heights[i], reverse=True)
    lanes: list[list[int]] = [[] for _ in range(n_lanes)]
    sums = [0] * n_lanes

    def rec(pos: int) -> bool:
        if pos == len(order):
            return all(lane for lane in lanes)

        idx = order[pos]
        lane_order = list(range(n_lanes))
        random.shuffle(lane_order)
        for lane_i in lane_order:
            if sums[lane_i] + heights[idx] > capacity:
                continue
            if not lanes[lane_i]:
                empty_before = sum(1 for lane in lanes if not lane)
                items_left = len(order) - pos
                if empty_before > items_left:
                    continue
            lanes[lane_i].append(idx)
            sums[lane_i] += heights[idx]
            if rec(pos + 1):
                return True
            sums[lane_i] -= heights[idx]
            lanes[lane_i].pop()
        return False

    return lanes if rec(0) else None


def _gen_random_gaps(total: int, parts: int) -> list[int]:
    gaps = [0] * parts
    for _ in range(total):
        gaps[random.randrange(parts)] += 1
    return gaps


def _gen_assign_columns(objs: list[dict], width: int, capacity: int) -> bool:
    heights = [int(obj["patch"].shape[0]) for obj in objs]
    min_lanes = max(1, (sum(heights) + capacity - 1) // capacity)
    lane_counts = list(range(min_lanes, len(objs) + 1))
    random.shuffle(lane_counts)

    for n_lanes in lane_counts:
        lanes = _gen_partition_lanes(heights, capacity, n_lanes)
        if lanes is None:
            continue
        random.shuffle(lanes)
        lane_widths = [max(int(objs[i]["patch"].shape[1]) for i in lane) for lane in lanes]
        required = sum(lane_widths) + LANE_GAP * (n_lanes - 1)
        if required > width:
            continue

        gaps = _gen_random_gaps(width - required, n_lanes + 1)
        col = gaps[0]
        for lane_i, lane in enumerate(lanes):
            lane_w = lane_widths[lane_i]
            for obj_i in lane:
                obj_w = int(objs[obj_i]["patch"].shape[1])
                objs[obj_i]["c"] = col + random.randint(0, lane_w - obj_w)
            col += lane_w + LANE_GAP + gaps[lane_i + 1]
        return True
    return False


def _gen_can_place_pixels(canvas: np.ndarray, obj: dict, row: int) -> bool:
    patch = obj["patch"]
    c = int(obj["c"])
    h, w = patch.shape
    region = canvas[row : row + h, c : c + w]
    return bool(np.all(region[patch != 0] == 0))


def _gen_pack_group(canvas: np.ndarray, objs: list[dict], upward: bool) -> bool:
    height = int(canvas.shape[0])
    for obj in objs:
        h = int(obj["patch"].shape[0])
        if upward:
            rows = range(0, height - h + 1)
        else:
            rows = range(height - h, -1, -1)
        for row in rows:
            if _gen_can_place_pixels(canvas, obj, row):
                paste(canvas, obj["patch"], row, int(obj["c"]), transparent=0)
                obj["out_r"] = row
                break
        else:
            return False
    return True


def _gen_zone_gap(closed: list[dict], open_objs: list[dict]) -> int:
    closed_bottom = max(int(obj["out_r"]) + int(obj["patch"].shape[0]) - 1 for obj in closed)
    open_top = min(int(obj["out_r"]) for obj in open_objs)
    return open_top - closed_bottom - 1


def _gen_same_color_touch(objs: list[dict]) -> bool:
    placed = []
    for obj in objs:
        coords = np.argwhere(obj["patch"] != 0)
        coords = coords + np.array([int(obj["out_r"]), int(obj["c"])])
        placed.append((int(obj["color"]), coords))

    for i in range(len(placed)):
        color_i, coords_i = placed[i]
        for j in range(i + 1, len(placed)):
            color_j, coords_j = placed[j]
            if color_i != color_j:
                continue
            distances = np.abs(coords_i[:, None, :] - coords_j[None, :, :]).sum(axis=2)
            if np.any(distances <= 1):
                return True
    return False


def _gen_can_scatter(canvas: np.ndarray, obj: dict, row: int) -> bool:
    patch = obj["patch"]
    c = int(obj["c"])
    h, w = patch.shape
    if row < 0 or row + h > canvas.shape[0] or c < 0 or c + w > canvas.shape[1]:
        return False
    mask = patch != 0
    if np.any(canvas[row : row + h, c : c + w][mask] != 0):
        return False

    coords = np.argwhere(mask)
    for rr, cc in coords:
        ar = row + int(rr)
        ac = c + int(cc)
        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
            nr = ar + dr
            nc = ac + dc
            if 0 <= nr < canvas.shape[0] and 0 <= nc < canvas.shape[1] and canvas[nr, nc] != 0:
                return False
    return True


def _gen_row_candidates(height: int, obj_h: int) -> list[int]:
    rows = list(range(0, height - obj_h + 1))
    middle = [r for r in rows if SCATTER_EDGE_MARGIN <= r <= height - obj_h - SCATTER_EDGE_MARGIN]
    edge = [r for r in rows if r not in middle]
    random.shuffle(middle)
    random.shuffle(edge)
    if random.random() < SCATTER_MIDDLE_FIRST_PROB:
        return middle + edge
    return edge + middle


def _gen_scatter_input(height: int, width: int, closed: list[dict], open_objs: list[dict]) -> np.ndarray | None:
    """Place input objects in solver order while preserving same-group vertical order."""
    canvas = np.zeros((height, width), dtype=int)

    def rec(ci: int, oi: int, prev_closed_top: int, prev_open_bottom: int) -> bool:
        if ci == len(closed) and oi == len(open_objs):
            return True

        choices: list[str] = []
        if ci < len(closed):
            choices.append("closed")
        if oi < len(open_objs):
            choices.append("open")
        random.shuffle(choices)

        for choice in choices:
            if choice == "closed":
                obj = closed[ci]
                h = int(obj["patch"].shape[0])
                for row in _gen_row_candidates(height, h):
                    if row <= prev_closed_top or not _gen_can_scatter(canvas, obj, row):
                        continue
                    paste(canvas, obj["patch"], row, int(obj["c"]), transparent=0)
                    if rec(ci + 1, oi, row, prev_open_bottom):
                        return True
                    canvas[row : row + h, int(obj["c"]) : int(obj["c"]) + obj["patch"].shape[1]][obj["patch"] != 0] = 0
            else:
                obj = open_objs[oi]
                h = int(obj["patch"].shape[0])
                for row in _gen_row_candidates(height, h):
                    bottom = row + h - 1
                    if bottom >= prev_open_bottom or not _gen_can_scatter(canvas, obj, row):
                        continue
                    paste(canvas, obj["patch"], row, int(obj["c"]), transparent=0)
                    if rec(ci, oi + 1, prev_closed_top, bottom):
                        return True
                    canvas[row : row + h, int(obj["c"]) : int(obj["c"]) + obj["patch"].shape[1]][obj["patch"] != 0] = 0
        return False

    return canvas if rec(0, 0, -1, height) else None


def _gen_canvas_shape() -> tuple[int, int]:
    return random.randint(GRID_SIZE_MIN, GRID_SIZE_MAX), random.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)


def _gen_objects() -> tuple[list[dict], list[dict], list[dict]]:
    """Build colored closed and open sprites, then randomize each solver group order."""
    n_closed = random.randint(CLOSED_COUNT_MIN, CLOSED_COUNT_MAX)
    n_open = random.randint(OPEN_COUNT_MIN, OPEN_COUNT_MAX)
    closed: list[dict] = []
    for _ in range(n_closed):
        h = random.randint(SPRITE_SIZE_MIN, SPRITE_SIZE_MAX)
        w = random.randint(SPRITE_SIZE_MIN, SPRITE_SIZE_MAX)
        closed.append({"kind": "closed", "mask": _gen_frame_mask(h, w)})

    open_objs: list[dict] = []
    for _ in range(n_open):
        open_objs.append({"kind": "open", "mask": _gen_cross_mask()})

    all_objs = closed + open_objs
    for obj, color in zip(all_objs, _gen_color_labels(len(all_objs))):
        obj["color"] = color
        obj["patch"] = _gen_patch(obj["mask"], color)

    random.shuffle(closed)
    random.shuffle(open_objs)

    return closed, open_objs, all_objs


def _gen_capacity_split(height: int, closed: list[dict], open_objs: list[dict]) -> tuple[int, int] | None:
    max_closed_h = max(int(obj["patch"].shape[0]) for obj in closed)
    max_open_h = max(int(obj["patch"].shape[0]) for obj in open_objs)
    available = height - MIN_ZONE_GAP
    if max_closed_h + max_open_h > available:
        return None
    closed_capacity = random.randint(max_closed_h, available - max_open_h)
    open_capacity = available - closed_capacity
    return closed_capacity, open_capacity


def _gen_assign_layout(height: int, width: int, closed: list[dict], open_objs: list[dict]) -> bool:
    capacities = _gen_capacity_split(height, closed, open_objs)
    if capacities is None:
        return False
    closed_capacity, open_capacity = capacities

    if not _gen_assign_columns(closed, width, closed_capacity):
        return False
    if not _gen_assign_columns(open_objs, width, open_capacity):
        return False
    return True


def _gen_pack_output(height: int, width: int, closed: list[dict], open_objs: list[dict]) -> np.ndarray | None:
    """Render the packed target grid and reject invalid zone separation."""
    output = np.zeros((height, width), dtype=int)
    if not _gen_pack_group(output, closed, upward=True):
        return None
    if not _gen_pack_group(output, open_objs, upward=False):
        return None
    if _gen_zone_gap(closed, open_objs) < MIN_ZONE_GAP:
        return None
    return output


def _gen_checked_input(height: int, width: int, closed: list[dict], open_objs: list[dict], output: np.ndarray) -> np.ndarray | None:
    """Scatter objects into an input grid and keep only examples accepted by the solver oracle."""
    inp = _gen_scatter_input(height, width, closed, open_objs)
    if inp is None or np.array_equal(inp, output):
        return None
    if not np.array_equal(main(inp), output):
        return None
    return inp


def _gen_attempt() -> np.ndarray | None:
    height, width = _gen_canvas_shape()
    closed, open_objs, all_objs = _gen_objects()

    if not _gen_assign_layout(height, width, closed, open_objs):
        return None

    output = _gen_pack_output(height, width, closed, open_objs)
    if output is None or _gen_same_color_touch(all_objs):
        return None

    return _gen_checked_input(height, width, closed, open_objs, output)


def generate_input() -> np.ndarray:
    for _ in range(GENERATION_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate ac2e8ecf input")
def main(grid: np.ndarray) -> np.ndarray:
    """
    Output a 2x2 block colored like the hollow rectangular frame with the largest interior.

    Input structure
    - The background is the most common color.
    - The foreground consists of exactly two 4-connected monochrome hollow rectangular frames.
    - Each frame is one cell thick and has a background-colored interior.

    Rule
    - Measure each frame by the area strictly inside its border.
    - Select the unique frame with the largest interior area.
    - Return a 2x2 grid filled with that frame's color.

    Key insight
    - The task compares the size of the empty regions enclosed by the frames; the
      output is only the winning frame color, normalized to a small solid block.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "expected a 2D grid"
    assert min(g.shape) > 0, "expected a nonempty grid"

    bg = get_bg(g)
    objects = find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict")
    assert len(objects) == 2, "expected exactly two foreground frames"

    frames = [_frame_interior_area(g, bg, obj) for obj in objects]
    largest_area = max(area for area, _color in frames)
    largest = [(area, color) for area, color in frames if area == largest_area]
    assert len(largest) == 1, "expected a unique largest frame interior"

    _area, color = largest[0]
    return np.full((2, 2), color, dtype=int)

