+def _bbox_gap_ok(a: tuple[int, int, int, int], b: tuple[int, int, int, int], gap: int) -> bool:
+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
+    row_sep = ar1 + gap < br0 or br1 + gap < ar0
+    col_sep = ac1 + gap < bc0 or bc1 + gap < ac0
+    return row_sep or col_sep
