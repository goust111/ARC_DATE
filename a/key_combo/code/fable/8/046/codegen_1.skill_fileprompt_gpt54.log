+        expected,
+        frames,
+        planned_moves,
+        fixed_markers,
+        queue_expected,
+        blocked_expected,
+    ):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
