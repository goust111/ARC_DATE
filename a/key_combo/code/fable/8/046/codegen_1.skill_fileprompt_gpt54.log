+        moved_count = move_counts[color]
+        need_blocked = color == blocked_color
+        total_slots = moved_count + (2 if need_blocked else 0)
+        slots = _slot_positions(ray_lengths[color], total_slots)
+        if total_slots > 0 and slots is None:
