+import random
+from dataclasses import dataclass
+from typing import Iterable
+
+import numpy as np
+
+
+Coord = tuple[int, int]
+
+
+@dataclass(frozen=True)
+class Frame:
+    color: int
+    bbox: tuple[int, int, int, int]
+    gap: Coord
+    side: str
+
+
+SIDES = ("top", "bottom", "left", "right")
+SIDE_TO_OUTWARD = {
+    "top": (-1, 0),
+    "bottom": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(np.asarray(grid, dtype=int), return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _neighbors4(r: int, c: int) -> Iterable[Coord]:
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if color == bg or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            cells: list[Coord] = []
+            while stack:
+                cr, cc = stack.pop()
+                cells.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if (
+                        _in_bounds(g.shape, nr, nc)
+                        and not seen[nr, nc]
+                        and int(g[nr, nc]) == color
+                    ):
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+
+            coords = np.array(cells, dtype=int)
+            r0, c0 = coords.min(axis=0)
+            r1, c1 = coords.max(axis=0)
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "area": len(cells),
+                    "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                }
+            )
+    return comps
+
+
+def _frame_from_component(grid: np.ndarray, bg: int, comp: dict) -> Frame | None:
+    coords = comp["coords"]
+    color = int(comp["color"])
+    r0, c0, r1, c1 = comp["bbox"]
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return None
+
+    coord_set = {tuple(map(int, coord)) for coord in coords}
+    for r, c in coord_set:
+        if r not in (r0, r1) and c not in (c0, c1):
+            return None
+
+    missing: list[Coord] = []
+    for r in range(r0, r1 + 1):
+        for c in range(c0, c1 + 1):
+            if r in (r0, r1) or c in (c0, c1):
+                if (r, c) not in coord_set:
+                    missing.append((r, c))
+
+    if len(missing) != 1:
+        return None
+
+    gap = missing[0]
+    gr, gc = gap
+    if (gr in (r0, r1)) and (gc in (c0, c1)):
+        return None
+    if len(coord_set) != 2 * h + 2 * w - 5:
+        return None
+
+    if gr == r0:
+        side = "top"
+    elif gr == r1:
+        side = "bottom"
+    elif gc == c0:
+        side = "left"
+    else:
+        side = "right"
+    return Frame(color=color, bbox=(r0, c0, r1, c1), gap=gap, side=side)
+
+
+def _detect_frames_and_markers(grid: np.ndarray) -> tuple[list[Frame], dict[Coord, int]]:
+    g = np.asarray(grid, dtype=int)
+    bg = _get_bg(g)
+    frames: list[Frame] = []
+    markers: dict[Coord, int] = {}
+
+    for comp in _find_components(g, bg):
+        if comp["area"] == 1:
+            r, c = map(int, comp["coords"][0])
+            markers[(r, c)] = int(comp["color"])
+            continue
+        frame = _frame_from_component(g, bg, comp)
+        assert frame is not None, "expected every non-singleton component to be a gapped hollow rectangle"
+        frames.append(frame)
