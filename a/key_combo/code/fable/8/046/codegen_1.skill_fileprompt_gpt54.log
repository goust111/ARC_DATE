+            return False
+
+    for src, dst, color in planned_moves:
+        if int(inp[src]) != color or int(expected[src]) != GEN_BG or int(expected[dst]) != color:
+            return False
+    for pos, color in fixed_markers:
+        if int(inp[pos]) != color or int(expected[pos]) != color:
+            return False
