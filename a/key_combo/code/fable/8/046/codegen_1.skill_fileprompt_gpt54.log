+GEN_BG = 0
+GEN_GRID_MIN = 16
+GEN_GRID_MAX = 28
+GEN_FRAME_COUNT = (2, 4)
+GEN_FRAME_H = (4, 8)
+GEN_FRAME_W = (4, 8)
+GEN_EDGE_MARGIN = 1
+GEN_MIN_BBOX_GAP = 2
+GEN_MIN_RAY_LEN = 3
+GEN_MAX_MOVERS_PER_FRAME = 3
+GEN_EXTRA_NOISE = (1, 4)
