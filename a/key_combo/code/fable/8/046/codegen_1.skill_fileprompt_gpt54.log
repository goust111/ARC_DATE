+            if any(not _bbox_gap_ok(frame.bbox, other.bbox, GEN_MIN_BBOX_GAP) for other in frames):
+                continue
+            if any(corridor & {
+                (r, c)
+                for r in range(other.bbox[0], other.bbox[2] + 1)
+                for c in range(other.bbox[1], other.bbox[3] + 1)
+            } for other in frames):
