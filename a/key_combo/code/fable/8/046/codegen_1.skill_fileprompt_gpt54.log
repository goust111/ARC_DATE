+            blocked = _ray_distance_to_cell(frame, blocked_dist)
+            blocker_color = random.choice(free_noise_colors)
+            if not _marker_clear(inp, blocker) or not _marker_clear(inp, blocked):
+                return None
+            inp[blocker] = blocker_color
+            inp[blocked] = color
