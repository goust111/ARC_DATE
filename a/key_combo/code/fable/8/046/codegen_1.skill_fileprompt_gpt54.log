+    slots = random.choice(choices)
+    return sorted(random.sample(slots, needed))
+
+
+def _free_noise_cell(grid: np.ndarray, forbidden: set[Coord], predicate) -> Coord | None:
+    cells = [
+        (r, c)
+        for r in range(grid.shape[0])
+        for c in range(grid.shape[1])
