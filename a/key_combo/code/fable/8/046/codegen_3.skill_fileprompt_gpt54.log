+
+def _copy_is_matched(
+    coords: np.ndarray,
+    orient: str,
+    axis: int,
+    red_idx: np.ndarray,
+    red_sets: list[set[tuple[int, int]]],
+) -> bool:
+    mirrored = _mirror_coords(coords, orient, axis)
+    h, w = red_idx.shape
+    if np.any(mirrored[:, 0] < 0) or np.any(mirrored[:, 0] >= h):
+        return False
+    if np.any(mirrored[:, 1] < 0) or np.any(mirrored[:, 1] >= w):
+        return False
