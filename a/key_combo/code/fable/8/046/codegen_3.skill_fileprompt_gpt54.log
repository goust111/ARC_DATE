+    if len(gray_rows) == 1 and len(gray_cols) == 0:
+        return "h", int(gray_rows[0])
+    if len(gray_cols) == 1 and len(gray_rows) == 0:
+        return "v", int(gray_cols[0])
+    raise AssertionError("expected exactly one full gray symmetry axis")
