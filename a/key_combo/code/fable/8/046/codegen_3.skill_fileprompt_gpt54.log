_GEN_MAX_STEP = 8
_GEN_STEP_VALUES = tuple(range(_GEN_MIN_STEP, _GEN_MAX_STEP + 1))
_GEN_MIN_GAP = 1
_GEN_MAX_GAP = 5
_GEN_GAP_START_OFFSET = 2
_GEN_GAP_STOP_OFFSET = 1

