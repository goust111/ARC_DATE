def _slide_into_place(out: np.ndarray, obj: _Object, bg: int, upward: bool) -> None:
    H = out.shape[0]
    if upward:
        rows = range(0, H - obj.height + 1)
    else:
        rows = range(H - obj.height, -1, -1)

