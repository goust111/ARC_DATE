    red_comps = components_mask(g == int(RED), connectivity=4)
    assert not (not red_comps)

    red_coords: list[list[tuple[int, int]]] = []
    red_bbox: list[tuple[int, int, int, int]] = []
    red_at: dict[tuple[int, int], int] = {}

