+        cp = rec["copy"]
+        side = rec["side"]
+        source_bg = side_bgs[side]
+        target_bg = side_bgs[1 - side]
+        if not np.all(out[src[:, 0], src[:, 1]] == RED):
+            return False
+        if not np.all(out[cp[:, 0], cp[:, 1]] == source_bg):
+            return False
+
+        if rec["status"] == "missing":
