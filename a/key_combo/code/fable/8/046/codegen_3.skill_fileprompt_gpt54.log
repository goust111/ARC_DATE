+
+
+def _validate_case(
+    inp: np.ndarray,
+    out: np.ndarray,
+    real_records: list[dict],
+    orphan_records: list[dict],
+    orient: str,
+    axis: int,
+    side_bgs: tuple[int, int],
+) -> bool:
