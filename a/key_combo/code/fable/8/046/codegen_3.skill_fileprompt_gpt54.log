+
+    inp = output.copy()
+    for rec in records:
+        side = rec["side"]
+        source_bg = side_bgs[side]
+        target_bg = side_bgs[1 - side]
+        src = rec["source"]
+        cp = rec["copy"]
+        if rec["status"] == "missing":
+            inp[cp[:, 0], cp[:, 1]] = target_bg
+        elif rec["status"] == "orphan":
+            inp[src[:, 0], src[:, 1]] = source_bg
+
+    if not _validate_case(inp, output, records, orient, axis, side_bgs):
+        return None
+    return inp, output
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATE_ATTEMPTS):
+        case = _generate_case()
+        if case is not None:
+            return case[0]
+    raise RuntimeError("failed to generate a valid mirror-maintenance puzzle")

