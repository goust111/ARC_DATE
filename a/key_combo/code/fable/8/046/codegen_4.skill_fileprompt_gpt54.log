+        left, right = _beam_bounds(grid[next_row], col)
+        dist_left = col - left
+        dist_right = right - col
+        if dist_left < dist_right or (tie_left and dist_left == dist_right):
+            new_col = left - 1
+            relation = "T" if dist_left == dist_right else "L"
+        else:
