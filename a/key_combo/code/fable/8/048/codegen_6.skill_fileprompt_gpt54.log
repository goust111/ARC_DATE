+    rb, cb = _random_room_cell(rooms[room_b])
+    grid[ra, ca] = seed_color_a
+    grid[rb, cb] = seed_color_b
+    return grid
+
+
+def _distance_signature(grid: np.ndarray):
+    seeds = _seed_data(grid)
