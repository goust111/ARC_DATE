+
+BG = 0
+WALL = 5
+SEED_PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+
+ROOM_SIZE_MIN = 5
+ROOM_SIZE_MAX = 6
+CORE_GAP_MIN = 2
+CORE_GAP_MAX = 4
+BRANCH_GAP_MIN = 2
+BRANCH_GAP_MAX = 3
+GEN_ATTEMPTS = 500
