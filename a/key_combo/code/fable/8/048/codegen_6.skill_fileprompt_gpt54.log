        up, down = r, n - 1 - r
        if up == down:
            return None
        return (0, fixed_sign), ((-1, 0) if up > down else (1, 0))

    left, right = c, n - 1 - c
    if left == right:
        return None
    return (fixed_sign, 0), ((0, -1) if left > right else (0, 1))


