+        return False
+
+    unreachable_black = (grid == BG) & ~reachable
+    if int(np.count_nonzero(unreachable_black)) == 0:
+        return False
+
+    tie_cells = (grid == BG) & (dist0 == dist1) & (dist0 >= 0)
+    if require_tie and int(np.count_nonzero(tie_cells)) == 0:
