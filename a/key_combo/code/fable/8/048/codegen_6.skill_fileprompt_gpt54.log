+        _hr0, hc0, hr1, hc1 = rooms[host]
+        room = (hr1 + gap + 1, hc0, hr1 + gap + branch_h, hc0 + branch_w - 1)
+        overlap_left = max(room[1] + 1, hc0 + 1)
+        overlap_right = min(room[3] - 1, hc1 - 1)
+        col = random.randint(overlap_left, overlap_right)
