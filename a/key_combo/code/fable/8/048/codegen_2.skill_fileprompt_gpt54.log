+        if end < h and not np.all(grid[end:, c] == BG):
+            continue
+        height = end - 1
+        if height in used_heights:
+            raise AssertionError("duplicate key height")
+        used_heights.add(height)
+        entries.append({"col": c, "height": height, "value": value})
