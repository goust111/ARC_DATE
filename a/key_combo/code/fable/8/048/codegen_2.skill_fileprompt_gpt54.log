+            seen[r, c] = True
+            touches_boundary = False
+            while q:
+                rr, cc = q.popleft()
+                if rr == 0 or rr == h - 1 or cc == 0 or cc == w - 1:
+                    touches_boundary = True
+                for nr, nc in _neighbors4(rr, cc):
