+    h, w = occ.shape
+    mh, mw = mask.shape
+    for rr, cc in np.argwhere(mask):
+        ar = int(r0 + rr)
+        ac = int(c0 + cc)
+        if not (0 <= ar < h and 0 <= ac < w):
+            return False
+        for nr in range(ar - pad, ar + pad + 1):
+            for nc in range(ac - pad, ac + pad + 1):
