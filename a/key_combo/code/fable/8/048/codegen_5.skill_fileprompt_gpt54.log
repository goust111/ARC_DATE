+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _crop_mask(coords: np.ndarray, box: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = box
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    rel = coords - np.array([r0, c0])
+    mask[rel[:, 0], rel[:, 1]] = True
+    return mask
+
+
+def _shape_key(mask: np.ndarray) -> tuple[tuple[int, ...], ...]:
+    return tuple(tuple(int(v) for v in row) for row in mask.astype(int))
+
+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == bg or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                cells.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            coords = np.array(cells, dtype=int)
+            box = _bbox(coords)
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": box,
+                    "area": int(coords.shape[0]),
+                    "mask": _crop_mask(coords, box),
+                }
+            )
+    return comps
+
+
