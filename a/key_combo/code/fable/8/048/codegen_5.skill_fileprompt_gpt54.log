spec:
  grid: 22-28 rows x 22-28 cols, square or near-square [observed]
  background: 0 (black) [observed]; most frequent color
  frame_color: single non-bg color with highest pixel count; 1 per grid
  frames:
    count: 4-6 rectangular lattice frames, non-overlapping, >=1 bg gap between any two
    slot_layout: all frames share the same RxC logical grid; always 2x2 [observed]
    structure: 1px-thick lines forming a complete rectangular lattice (border + inner dividers)
    slot_sizes: vary independently per frame; each slot dimension 1-8 cells
    frame_sizes: all distinct within an example; range 5x5 to 18x14
  slot_colors:
    count: exactly R*C = 4 distinct non-bg non-frame colors
    assignment: each logical slot position (sr, sc) has exactly one color, determined by hints
    hints: across all frames, each slot position is filled in exactly one frame (total hints = R*C)
    distribution: 0-3 hints per frame; some frames have 0 hints [observed]
    fill: colored slots are completely filled with a single solid color
  transform: fill every empty slot in every frame with the color assigned to its (sr, sc) position

generation_strategy:
  approach: output-first
  steps:
    1. Choose grid size 22-28, bg=0, pick frame_color and 4 distinct slot colors (all different)
    2. Choose number of frames F in [4,6]; all share 2x2 slot layout
    3. Assign each of the 4 slot positions to a different color
    4. Assign each slot position to exactly one frame as its hint provider (every position covered once)
    5. For each frame, pick independent slot heights (h0, h1 in [1,8]) and widths (w0, w1 in [1,8]);
       compute total frame size = (h0+h1+3) x (w0+w1+3); ensure all frame sizes are distinct
    6. Place frames on grid with >=1 bg gap between bounding boxes and >=1 from grid edges;
