+    assert g.ndim == 2 and g.size > 0, "expected a non-empty 2D grid"
+
+    bg = _get_bg(g)
+    assert bg == BG, "expected black background"
+    comps = _find_components(g, bg)
+    assert len(comps) >= 4, "expected one blueprint and multiple stamps"
