spec:
  grid: 7-11 rows x 9 cols (fixed width)
  background: BLACK
  bars:
    count: 4 (always)
    columns: 1, 3, 5, 7 (odd columns, 1-gap between each) [observed]
    width: 1 column each
    anchor: every bar extends to the bottom row
    height: 2 to H-1, all 4 heights distinct
    color: RED (only foreground color)
    contiguous: each bar is a solid vertical segment, no gaps
  border: top row, col 0, col 8 are always BLACK [observed]
  transform:
    per bar, upper ceil(H/2) cells stay RED, lower floor(H/2) cells become TEAL
    background unchanged
  output_colors: RED + TEAL on BLACK

generation_strategy:
  approach: direct (simple enough — no tight coupling)
  steps:
    1. pick H in 7-11
    2. create 9-wide BLACK grid
    3. for each bar column in [1,3,5,7], pick a distinct height from 2..H-1
    4. fill each column from row (H - height) to row (H-1) with RED
    5. verify top row is all BLACK (height <= H-1 guarantees this)

