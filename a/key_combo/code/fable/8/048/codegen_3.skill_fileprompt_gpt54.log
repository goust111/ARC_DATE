{
  "type": "transform_in_place",
  "src": "one-pixel and two-pixel marker bars in lanes perpendicular to a complete edge bar",
  "transform": "extend one-pixel markers one cell inward; clear two-pixel markers to bg and write a two-pixel edge-color mark at the opposite side of the same lane"
}
</annotation>
<generation_spec>
