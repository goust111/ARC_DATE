spec:
  grid: 8-16 rows x 8-16 cols; aspect ratio ~2:1 [observed]; perpendicular dimension >=5 (solver asserts)
  colors: exactly 3 — bg (dominant), edge_color, marker_color; all distinct
  edge_bar:
    position: one of top/bottom/left/right; exactly one full-width/height bar of edge_color on that edge
    thickness: 1 cell
    exclusivity: edge_color appears ONLY on that edge row/col
  lanes: each row (if edge=left/right) or col (if edge=top/bottom) is an independent lane
  markers:
    color: marker_color, appears ONLY in the first 2 inward cells from the edge bar
    per-lane state: empty (both bg), single (cell-1 = marker, cell-2 = bg), or double (both marker)
    counts: 3-7 non-empty lanes (25-44% of lanes); mix of 1-4 singles and 1-4 doubles; at least 1 of each
    constraint: for double lanes, the 2 opposite-side cells must be bg in input
  interior: all cells beyond the first 2 inward cells are bg (except edge bar)
  transform:
    single -> extend to double (cell-2 becomes marker)
    double -> clear both to bg, write 2 edge_color cells at opposite end of same lane

generation_strategy:
  approach: direct construction (constraints are easy to satisfy constructively)
  steps:
    1. Pick grid dims (one 8-16, other 8-16, ensure perp >= 5) and 3 distinct colors for bg, edge, marker
    2. Fill grid with bg; pick an edge (top/bottom/left/right) and fill that row/col with edge_color
    3. For each lane, assign state — empty/single/double — ensuring 1-4 singles, 1-4 doubles, rest empty
    4. Place markers in the first 2 inward cells per assigned state
    5. Verify opposite-side cells for double lanes are bg (guaranteed since interior is all bg)
