  grid: 16x16 [observed]
  colors:
    background: 7 [observed]
    bg_marker: 8 [observed] -- pixel value in marker column on background rows
    src_marker: 1 [observed] -- pixel value in marker column on source bar rows
    bar_colors: 2-3 distinct, from palette minus {bg, bg_marker, src_marker}
  marker_column: single column at any position (observed range 3-8)
  source_bars:
    count: 2-4 full-width horizontal bars
    each row is monochrome (bar_color) except marker column (src_marker)
    never on row 0 or last row; gap to each edge >= 1
