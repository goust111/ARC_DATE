+from __future__ import annotations
+
+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BG = 0
+FRAME = 5
+HINGE = 6
+ANCHOR = 8
+LINE_COLORS = (1, 2, 3, 4, 7, 9)
+SIDES = ("top", "bottom", "left", "right")
+HORIZONTAL_SIDES = ("top", "bottom")
+VERTICAL_SIDES = ("left", "right")
+
+MIN_GRID = 20
+MAX_GRID = 30
+MIN_PAIRS = 2
+MAX_PAIRS = 4
+FRAME_SIZES = (5, 7, 9)
+TAIL_RANGE = (2, 6)
+FIXED_RANGE = (1, 4)
+GEN_RETRIES = 600
+
+
+def get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, np.asarray(grid).ravel())).most_common(1)[0][0])
+
+
+def in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = map(int, shape)
+    return 0 <= int(r) < h and 0 <= int(c) < w
+
+
+def neighbors4(r: int, c: int):
+    yield int(r) - 1, int(c)
+    yield int(r) + 1, int(c)
+    yield int(r), int(c) - 1
+    yield int(r), int(c) + 1
+
+
+def _components_from_mask(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((int(rr), int(cc)))
+                for nr, nc in neighbors4(rr, cc):
+                    if in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _expand(cells: set[tuple[int, int]], radius: int = 1) -> set[tuple[int, int]]:
+    out = set()
+    for r, c in cells:
+        for dr in range(-radius, radius + 1):
+            for dc in range(-radius, radius + 1):
+                out.add((int(r) + dr, int(c) + dc))
+    return out
+
+
+def _frame_border_cells(bbox: tuple[int, int, int, int]) -> set[tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    cells = set()
+    for r in range(r0, r1 + 1):
+        cells.add((r, c0))
+        cells.add((r, c1))
+    for c in range(c0, c1 + 1):
+        cells.add((r0, c))
+        cells.add((r1, c))
+    return cells
+
+
+def _frame_interior_cells(bbox: tuple[int, int, int, int]) -> set[tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    return {(r, c) for r in range(r0 + 1, r1) for c in range(c0 + 1, c1)}
+
+
+def _parse_frames(grid: np.ndarray, bg: int) -> list[dict]:
+    frames = []
+    for idx, comp in enumerate(_components_from_mask(grid == FRAME)):
+        bbox = _bbox(comp)
+        r0, c0, r1, c1 = bbox
