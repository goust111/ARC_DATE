+def _fill_frame(out: np.ndarray, frame: dict, color: int) -> None:
+    r0, c0, r1, c1 = frame["bbox"]
+    out[r0 + 1 : r1, c0 + 1 : c1] = int(color)
+    out[frame["opening"]] = int(color)
+
