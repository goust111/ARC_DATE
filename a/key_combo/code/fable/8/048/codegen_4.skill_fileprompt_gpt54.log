+def _solve_exact_cover(
+    mask_cells: frozenset[tuple[int, int]],
+    shape: tuple[int, int],
+    tiles: list[dict],
+    *,
+    stop_after: int = 2,
+) -> list[list[tuple[int, frozenset[tuple[int, int]]]]]:
