+    for r, c in cells:
+        for nr, nc in _neighbors4(r, c):
+            if (nr, nc) in occupied:
+                return True
+    return False
+
+
+def _touch_count(cells: frozenset[tuple[int, int]], occupied: frozenset[tuple[int, int]]) -> int:
