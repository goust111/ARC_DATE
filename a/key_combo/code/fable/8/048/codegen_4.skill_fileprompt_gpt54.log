import random


def _palette_columns(g: np.ndarray, bg: int) -> tuple[list[int], list[int]]:
    h, w = g.shape
    assert h > 0 and w > 0
    cols: list[int] = []
    colors: list[int] = []
    for c in range(w):
        color = int(g[0, c])
        if color != bg and np.all(g[:, c] == color):
            cols.append(c)
            colors.append(color)

