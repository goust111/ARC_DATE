+BG = 0
+MASK_COLOR = 5
+MAX_GENERATION_ATTEMPTS = 400
+
+TILE_LIBRARY = (
+    frozenset({(0, 0), (1, 0), (1, 1)}),
+    frozenset({(0, 1), (1, 0), (1, 1)}),
+    frozenset({(0, 0), (0, 1), (0, 2), (1, 1)}),
+    frozenset({(0, 1), (0, 2), (1, 0), (1, 1)}),
+    frozenset({(0, 0), (1, 0), (2, 0), (2, 1)}),
