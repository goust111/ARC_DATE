+    ac0 = min(c for _, c in a)
+    ar1 = max(r for r, _ in a)
+    ac1 = max(c for _, c in a)
+    br0 = min(r for r, _ in b)
+    bc0 = min(c for _, c in b)
+    br1 = max(r for r, _ in b)
+    bc1 = max(c for _, c in b)
