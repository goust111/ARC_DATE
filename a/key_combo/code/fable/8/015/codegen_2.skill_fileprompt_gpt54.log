+
+
+def _rotation_signatures(coords: tuple[tuple[int, int], ...]) -> set[tuple[tuple[int, int], ...]]:
+    mask = _coords_to_mask(coords)
+    signatures = set()
+    for k in range(4):
+        rot = np.rot90(mask, k=k)
+        signatures.add(_normalize_coords(np.argwhere(rot)))
+    return signatures
