COLOR_VALUES = tuple(range(1, 10))
CONNECTIVITY = 4

# Sprite and chain structure.
SPRITE_SIDES = (2, 3, 5)
CHAIN_COUNT_OPTIONS, CHAIN_SIZE_OPTIONS = (2, 3), (1, 2, 3)
TOTAL_SPRITES_MIN, TOTAL_SPRITES_MAX = 4, 6
CHAIN_GAP_ROWS = 1
