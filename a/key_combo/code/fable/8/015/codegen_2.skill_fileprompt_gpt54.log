+    canonical = min(_rotation_signatures(_shape))
+    if canonical not in CANONICAL_LIBRARY:
+        CANONICAL_LIBRARY += (canonical,)
+        AREA_GROUPS.setdefault(len(canonical), []).append(canonical)
