+def _coords_to_mask(coords: tuple[tuple[int, int], ...]) -> np.ndarray:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    mask = np.zeros((max(rows) + 1, max(cols) + 1), dtype=bool)
+    for r, c in coords:
+        mask[r, c] = True
