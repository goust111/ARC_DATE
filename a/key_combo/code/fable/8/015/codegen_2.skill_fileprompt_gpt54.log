+def _dent_signature(grid: np.ndarray, bbox: tuple[int, int, int, int]) -> tuple[tuple[int, int], ...]:
+    r0, c0, r1, c1 = bbox
+    patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+    dents = np.argwhere(patch == BACKGROUND)
+    return _normalize_coords(dents)
