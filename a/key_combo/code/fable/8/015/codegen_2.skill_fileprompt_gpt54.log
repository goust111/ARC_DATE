+
+def _choose_templates(rng: random.Random) -> list[dict]:
+    same_area = rng.choice([area for area, shapes in AREA_GROUPS.items() if len(shapes) >= 2])
+    first_pair = rng.sample(AREA_GROUPS[same_area], 2)
