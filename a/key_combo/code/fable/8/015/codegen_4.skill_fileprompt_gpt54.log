+    h, w = grid.shape
+    dist = np.full((h, w), -1, dtype=int)
+    q = deque([start])
+    dist[start] = 0
+    while q:
+        r, c = q.popleft()
+        base = int(dist[r, c]) + 1
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and dist[nr, nc] == -1 and int(grid[nr, nc]) == BLACK:
+                dist[nr, nc] = base
+                q.append((nr, nc))
+    return dist
+
+
+def _black_components(grid: np.ndarray) -> list[list[tuple[int, int]]]:
