+        grid[2 * r + 1 + dr, 2 * c + 1 + dc] = BLACK
+        grid[2 * nr + 1, 2 * nc + 1] = BLACK
+        visited[nr, nc] = True
+        stack.append((nr, nc))
+
+    extra_links = int(rng.integers(max(1, (mh * mw) // 10), max(2, (mh * mw) // 5) + 1))
+    for _ in range(extra_links):
