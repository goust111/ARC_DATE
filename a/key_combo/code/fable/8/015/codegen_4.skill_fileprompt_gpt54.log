+
+def _carve_maze(h: int, w: int, rng: np.random.Generator) -> np.ndarray:
+    grid = np.full((h, w), TEAL, dtype=int)
+    mh = (h - 1) // 2
+    mw = (w - 1) // 2
+    visited = np.zeros((mh, mw), dtype=bool)
+    start = (int(rng.integers(mh)), int(rng.integers(mw)))
