+        spike_abs = (int(r0 + spike_local[0]), int(c0 + spike_local[1]))
+        mouth_abs = {(int(r0 + r), int(c0 + c)) for r, c in mouth_local}
+        ray = _ray_cells(shape, spike_abs, direction)
+        if not ray:
