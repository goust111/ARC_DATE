+            "anchor": anchor,
+            "spike": spike_abs,
+            "mouth": mouth_abs,
+            "direction": direction,
+            "bbox": _anchor_bbox(anchor, patch),
+            "ray": ray,
+            "incoming_cells": incoming_cells,
