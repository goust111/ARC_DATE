+    bg = _get_bg(g)
+    row_ticks: dict[int, int] = {}
+    col_ticks: dict[int, int] = {}
+    for r in range(h - 1):
+        color = int(g[r, 0])
+        if color != bg:
+            assert color not in row_ticks, "left-edge tick colors must be unique"
+            row_ticks[color] = r
+    for c in range(1, w):
+        color = int(g[h - 1, c])
+        if color != bg:
+            assert color not in col_ticks, "bottom-edge tick colors must be unique"
+            col_ticks[color] = c
