+            chosen = top
+            break
+        if chosen is None:
+            return None
+        tops.append(chosen)
+        occupied |= _occupied_cells(patch, chosen)
+    return tops
+
+
+def _stamp(grid: np.ndarray, patch: np.ndarray, top: tuple[int, int]) -> None:
+    tr, tc = top
+    for r, c in np.argwhere(patch != BG):
+        grid[tr + int(r), tc + int(c)] = int(patch[r, c])
+
+
