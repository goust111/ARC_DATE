+        candidates = _candidate_tops(h, w, patch)
+        rng.shuffle(candidates)
+        chosen = None
+        for top in candidates:
+            if top == target["top"]:
+                continue
+            cells = _occupied_cells(patch, top)
+            if cells & occupied:
