+    free_cols = [c for c in range(1, w) if c not in used_cols]
+    if not free_rows or not free_cols:
+        return None
+    extra_row = (int(rng.choice(free_rows)), int(marker_colors[-2]))
+    extra_col = (int(rng.choice(free_cols)), int(marker_colors[-1]))
+
