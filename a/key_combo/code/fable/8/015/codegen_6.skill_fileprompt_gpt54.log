+    interior_mask = g != bg
+    interior_mask[:, 0] = False
+    interior_mask[h - 1, :] = False
+    parts = _components(interior_mask)
+    assert parts, "expected interior sprites"
+
+    out = g.copy()
+    out[interior_mask] = bg
+
+    for coords in parts:
+        body_color, markers = _body_and_markers(g, coords)
+        _ = body_color
+
