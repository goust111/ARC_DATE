    )


def _gen_sprite_box(r: int, c: int) -> _GenBox:
    return (r, c, r + _GEN_SPRITE_SIZE - 1, c + _GEN_SPRITE_SIZE - 1)


def _gen_valid_outside_sprite_boxes(
    h: int, w: int, guide_box: _GenBox
