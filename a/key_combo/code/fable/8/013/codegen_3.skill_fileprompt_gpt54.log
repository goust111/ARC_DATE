def generate_code(task_id: str, combos: list[dict], batch_size: int) -> dict[int, int]:
    task_dir = BASE / "ceshi" / "code_combo" / task_id
    log_dir = task_dir / "_logs"
    log_dir.mkdir(parents=True, exist_ok=True)

    statuses: dict[int, int] = {}
    indices = [int(combo["index"]) for combo in combos]
    for start in range(0, len(indices), batch_size):
        batch = indices[start : start + batch_size]
        procs: list[tuple[int, subprocess.Popen[str]]] = []
        print(f"[code] launch batch {batch}", flush=True)
        for idx in batch:
            procs.append((idx, launch_one(task_id, idx, log_dir)))

        for idx, proc in procs:
            rc = proc.wait()
            statuses[idx] = rc
            code_path = task_dir / str(idx) / "code.py"
            state = "ok" if rc == 0 and code_path.exists() else f"failed rc={rc}"
            print(f"[code] {task_id} #{idx} -> {state}", flush=True)
    return statuses


def rerun_failures(task_id: str, statuses: dict[int, int]) -> dict[int, int]:
    task_dir = BASE / "ceshi" / "code_combo" / task_id
    log_dir = task_dir / "_logs"
    retry_statuses = dict(statuses)
    failed = []
    for idx, rc in sorted(statuses.items()):
        code_path = task_dir / str(idx) / "code.py"
        if rc != 0 or not code_path.exists():
            failed.append(idx)
    if not failed:
        return retry_statuses

    print(f"[retry] serial rerun for {failed}", flush=True)
    for idx in failed:
        proc = launch_one(task_id, idx, log_dir)
        rc = proc.wait()
        retry_statuses[idx] = rc
        code_path = task_dir / str(idx) / "code.py"
        state = "ok" if rc == 0 and code_path.exists() else f"failed rc={rc}"
        print(f"[retry] {task_id} #{idx} -> {state}", flush=True)
    return retry_statuses


def run_parent_tests(task_id: str) -> list[dict]:
    cmd = [sys.executable, "tem/run_combo_tests.py", task_id]
    proc = subprocess.run(cmd, cwd=BASE, check=True, capture_output=True, text=True)
    rows = json.loads(proc.stdout)
    out_path = BASE / "ceshi" / "code_combo" / task_id / "_parent_test_round1.json"
    out_path.write_text(json.dumps(rows, ensure_ascii=False, indent=2) + "\n")
    return rows


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("task_id")
    parser.add_argument("--batch-size", type=int, default=4)
    args = parser.parse_args()

    combos = load_combos(args.task_id)
    removed_prompts, removed_codes = clean_and_build_prompts(args.task_id, combos)
    print(
        f"[summary] prompts={len(combos)} removed_prompts={removed_prompts} removed_codes={removed_codes}",
        flush=True,
    )

    statuses = generate_code(args.task_id, combos, args.batch_size)
    statuses = rerun_failures(args.task_id, statuses)

    rows = run_parent_tests(args.task_id)
    ok = sum(1 for row in rows if row.get("status") == "ok")
    partial = sum(1 for row in rows if row.get("status") == "partial")
    missing = sum(1 for row in rows if row.get("status") == "missing")
    error = sum(1 for row in rows if row.get("status") == "error")
    print(
        f"[tests] ok={ok} partial={partial} missing={missing} error={error} total={len(rows)}",
        flush=True,
    )
    for row in rows:
        if row.get("status") != "ok":
            print(
                f"[tests] bad index={row['index']} status={row.get('status')} "
                f"test={row.get('test', {}).get('ok', 0)}/{row.get('test', {}).get('trials', 0)} "
                f"error={row.get('error', '')}",
                flush=True,
            )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

