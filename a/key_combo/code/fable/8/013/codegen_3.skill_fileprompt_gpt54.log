+
+
+def _path_in_shape(shape_cells: frozenset[Coord], start: Coord, goal: Coord) -> list[Coord]:
+    q = deque([start])
+    parent = {start: None}
+    while q:
+        cell = q.popleft()
+        if cell == goal:
+            break
