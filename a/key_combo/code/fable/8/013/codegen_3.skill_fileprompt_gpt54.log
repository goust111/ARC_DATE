+    grid = canvas[top : bottom + 1, left : right + 1].copy()
+
+    out = main(grid)
+    if np.array_equal(grid, out):
+        return None
+    if max(grid.shape) > 30 or max(out.shape) > 30:
+        return None
+    return grid
