#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import subprocess
import sys
from pathlib import Path

import yaml


BASE = Path("/home/lixinyu/snap/new")
MODEL_CFG = 'model="gpt-5.4"'
EFFORT_CFG = 'reasoning.effort="high"'


def load_combos(task_id: str) -> list[dict]:
    yaml_path = BASE / "ceshi" / "des_combo" / f"{task_id}.yaml"
    data = yaml.safe_load(yaml_path.read_text())
    return list(data["combos"])


def normalize_prompt(text: str) -> str:
    replacements = {
        "Claude subagent": "Codex subprocess",
        "Claude 专属": "Codex 专属",
        "Claude": "Codex",
        "claude": "codex",
    }
    for old, new in replacements.items():
        text = text.replace(old, new)
    return text


def run_checked(cmd: list[str], *, cwd: Path = BASE) -> None:
    subprocess.run(cmd, cwd=cwd, check=True)


def clean_and_build_prompts(task_id: str, combos: list[dict]) -> tuple[int, int]:
    prompt_dir = BASE / "ceshi" / "tem3"
    prompt_dir.mkdir(parents=True, exist_ok=True)

    removed_prompts = 0
    removed_codes = 0
    for combo in combos:
        idx = int(combo["index"])
        prompt_path = prompt_dir / f"combo_prompt_{task_id}_{idx}.txt"
        code_path = BASE / "ceshi" / "code_combo" / task_id / str(idx) / "code.py"
        if prompt_path.exists():
            prompt_path.unlink()
            removed_prompts += 1
        if code_path.exists():
            code_path.unlink()
            removed_codes += 1

    for combo in combos:
        idx = int(combo["index"])
        print(f"[prompt] {task_id} #{idx}", flush=True)
        run_checked([sys.executable, "combo_prompt_builder.py", task_id, str(idx)])

    return removed_prompts, removed_codes


def launch_one(task_id: str, idx: int, log_dir: Path) -> subprocess.Popen[str]:
    prompt_path = BASE / "ceshi" / "tem3" / f"combo_prompt_{task_id}_{idx}.txt"
    prompt_text = normalize_prompt(prompt_path.read_text())
    log_path = log_dir / f"{idx}.log"
    log_handle = open(log_path, "w", encoding="utf-8")
    cmd = [
