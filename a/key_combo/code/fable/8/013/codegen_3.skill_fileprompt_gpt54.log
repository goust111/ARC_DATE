+
+GREY = 5
+BLACK = 0
+COLOR_POOL = [1, 2, 3, 4, 6, 7, 8, 9]
+
+TEMPLATE_RETRIES = 300
+FRAGMENT_RETRIES = 300
+PLACEMENT_RETRIES = 400
+GENERATION_RETRIES = 300
+WORK_SHAPE = (30, 30)
