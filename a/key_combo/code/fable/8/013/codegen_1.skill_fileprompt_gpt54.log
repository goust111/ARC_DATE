            nr = r + dr
            nc = c + dc
            assert in_bounds(g.shape, nr, nc), "marker extension must stay on the grid"
            assert int(g[nr, nc]) == int(bg), "marker extension target must be background"
            out[nr, nc] = marker_color

    return out

