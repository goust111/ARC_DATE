+        "bg": int(bg),
+        "top_color": int(top_color),
+        "bottom_color": int(bottom_color),
+        "top_h": int(top_h),
+        "bottom_r0": int(bottom_r0),
+        "field": field,
+        "notches": notches,
+        "components": comps,
