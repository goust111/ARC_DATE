+def _recover_solutions(grid: np.ndarray, max_solutions: int = SEARCH_LIMIT) -> tuple[dict, list[list[dict]]]:
+    parsed = _parse_puzzle(grid)
+    field = parsed["field"]
+    comps = parsed["components"]
+    shapes = parsed["notches"]
+    bg = parsed["bg"]
