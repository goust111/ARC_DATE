+                    continue
+                if not coords.issubset(placed):
+                    continue
+                hidden_ok = True
+                for r, c in placed:
+                    if (r, c) in coords:
+                        continue
+                    val = int(field[r, c])
+                    if val == int(bg) or val == color:
+                        hidden_ok = False
+                        break
+                if not hidden_ok:
+                    continue
+                key = (shape_idx, dr, dc)
+                out[key] = {
+                    "shape_idx": int(shape_idx),
+                    "origin": (int(dr), int(dc)),
+                    "cells": placed,
+                    "color": color,
+                }
