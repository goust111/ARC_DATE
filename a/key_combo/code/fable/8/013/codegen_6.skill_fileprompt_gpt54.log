+
+
+def _generate_layout() -> np.ndarray | None:
+    count = random.choice([3, 4])
+    shapes = _make_shape_set(count)
+    if shapes is None:
+        return None
+    max_h = max(_shape_dims(shape)[0] for shape in shapes)
+    max_w = max(_shape_dims(shape)[1] for shape in shapes)
