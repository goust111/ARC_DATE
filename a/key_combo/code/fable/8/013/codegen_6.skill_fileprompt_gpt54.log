    field = _build_observed_field(fh, fw, bg, objects, order)

    comps = _color_components(field, bg)
    if len(comps) != count:
        return None
    hidden_color = colors[hidden_idx]
    hidden_comp_sizes = [len(comp["coords"]) for comp in comps if comp["color"] == hidden_color]
    if min(hidden_comp_sizes) < 2:
        return None

    grid[top_h : top_h + fh, :] = field
    return grid


def generate_input() -> np.ndarray:
    for _ in range(GEN_RETRIES):
        grid = _generate_layout()
        if grid is None:
            continue
        try:
            parsed, solutions = _recover_solutions(grid, max_solutions=2)
            if len(solutions) != 1:
                continue
            out = main(grid)
        except AssertionError:
            continue

        if out.shape != grid.shape:
            continue
        if max(grid.shape) > 30 or max(out.shape) > 30:
            continue
        if len(np.unique(parsed["field"])) < 3:
            continue
        return grid
    raise RuntimeError("failed to generate a valid puzzle-6 input")

diff --git a/a/key_combo/code/fable/8/013/6.py b/a/key_combo/code/fable/8/013/6.py
new file mode 100644
