+from __future__ import annotations
+
+import itertools
+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+Coord = tuple[int, int]
+Shape = frozenset[Coord]
+
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+GEN_RETRIES = 400
+SEARCH_LIMIT = 2
