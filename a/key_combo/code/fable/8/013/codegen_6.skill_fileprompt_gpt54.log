+def _paint_field(shape_hw: tuple[int, int], bg: int, objects: list[dict], order: tuple[int, ...]) -> np.ndarray:
+    field = np.full(shape_hw, int(bg), dtype=int)
+    for idx in order:
+        obj = objects[idx]
+        for r, c in obj["cells"]:
+            field[r, c] = int(obj["color"])
+    return field
