+def _has_valid_overlay(field: np.ndarray, bg: int, objects: list[dict]) -> bool:
+    for i, j in itertools.combinations(range(len(objects)), 2):
+        if objects[i]["color"] == objects[j]["color"] and objects[i]["cells"] & objects[j]["cells"]:
+            return False
