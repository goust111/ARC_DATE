+    g = parsed["grid"]
+    out = np.full_like(g, parsed["bg"])
+    out[: parsed["top_h"], :] = parsed["top_color"]
+    out[parsed["bottom_r0"] :, :] = parsed["bottom_color"]
+
+    for obj in objects:
+        notch = parsed["notches"][int(obj["shape_idx"])]
+        for r, c in notch["cells"]:
+            out[r, c] = int(obj["color"])
+    return out
