+        "top": top_color,
+        "bottom": bottom_color,
+    }
+    if all(colors[i] == side_match[notches[i]["side"]] for i in range(len(notches))):
+        flip_idx = random.randrange(len(notches))
+        colors[flip_idx] = bottom_color if side_match[notches[flip_idx]["side"]] == top_color else top_color
