import random, numpy as np

def rot_tl(r,c,s,shape,k):
    H,W=shape; k%=4
    if k==0:return r,c
    if k==1:return W-(c+s), r
    if k==2:return H-(r+s), W-(c+s)
    return c, H-(r+s)

def detect_square(mask):
    coords=np.argwhere(mask)
    if coords.size==0:return None
    r0,c0=coords.min(axis=0); r1,c1=coords.max(axis=0)
    h=int(r1-r0+1); w=int(c1-c0+1)
    if h"'!=w or coords.shape[0]!=h*w:return None
    return int(r0),int(c0),h

def gen():
    bg=0
    river,mover=random.sample(range(1,10),2)
    N=random.randint(4,7)
    seg_count=random.randint(3,5)
    final=random.randint(max(2,N-3), N)
    widths=[N]
    for _ in range(seg_count-2):
        widths.append(random.randint(final, N))
    widths.append(final)
    if final < N and min(widths)==N:
        widths[random.randint(1, len(widths)-1)] = random.randint(final, N-1)
        widths[-1]=final
    lens=[random.randint(2,5) for _ in widths]
    lens[0]=random.randint(N+1, N+5)
    spur_len=random.randint(0,3)
    spur_w=random.randint(1,N-1) if spur_len else 0
    total_cols=sum(lens)
    H=max(12, max(widths+[spur_w])+4)
    W=max(12, 2+spur_len+total_cols+2)
    if H>30 or W>30:return None
    sr=2; sc=2+spur_len
    g=np.zeros((H,W),dtype=int)
    for i in range(spur_len):
        col=sc-spur_len+i
        g[sr:sr+spur_w, col]=river
    c=sc
    for w,ln in zip(widths,lens):
        for _ in range(ln):
            g[sr:sr+w, c]=river
            c+=1
    g[sr:sr+N, sc:sc+N]=mover
    end_col=c-1
    start=(sr,sc,N)
    end=(sr,end_col-final+1,final)
    rot=random.randint(0,3)
    g2=np.rot90(g,rot)
    sr2,sc2=rot_tl(sr,sc,N,g.shape,rot)
    er2,ec2=rot_tl(end[0], end[1], final, g.shape, rot)
    return g2,(sr2,sc2,N),(er2,ec2,final)

def solve_one(g):
    bg=0 if np.count_nonzero(g==0)==np.max(np.unique(g, return_counts=True)[1]) else int(np.bincount(g.ravel()).argmax())
    vals=np.unique(g)
    colors=[int(v) for v in vals if int(v)!=bg]
    if len(colors)!=2:return None
    mover=river=None; start=None
    for col in colors:
        sq=detect_square(g==col)
        if sq is not None:
            mover=col; start=sq; river=colors[0] if colors[1]==col else colors[1]; break
    if start is None:return None
    sr,sc,N=start
    mask=(g==mover)|(g==river)
    if sr>0 and np.any(mask[:sr, sc:sc+N]):
        return None
    if sc+N>=g.shape[1] or not mask[sr, sc+N]:
        return None
    c=sc
    widths=[]
    while c<g.shape[1] and mask[sr,c]:
        h=0
        while sr+h<g.shape[0] and mask[sr+h,c]:
            h+=1
        if h<=0:return None
        if np.any(mask[:sr,c]) or np.any(mask[sr+h:,c]):
            return None
        widths.append(h)
        c+=1
    end_col=sc+len(widths)-1
    if len(widths)<N+1:
        return None
    if min(widths[:N])<N:
        return None
    final=min(widths)
    return mover,river,start,(sr,end_col-final+1,final)

def solve(g):
    for k in range(4):
        rot=np.rot90(g,k)
        parsed=solve_one(rot)
        if parsed is None: continue
        mover,river,start,end=parsed
        out=rot.copy()
        sr,sc,N=start; er,ec,s=end
        out[sr:sr+N, sc:sc+N]=river
        out[er:er+s, ec:ec+s]=mover
        return np.rot90(out,-k)
    return None

for i in range(5000):
    item=gen()
    if item is None: continue
    g,start,end=item
    out=solve(g)
    if out is None:
        print('"'no solve',i,start,end)
        print(g)
        break
    bg=int(np.bincount(g.ravel()).argmax())
    colors=[int(v) for v in np.unique(g) if int(v)"'!=bg]
    mover=next(col for col in colors if detect_square(g==col) is not None)
    river=next(col for col in colors if col!=mover)
    exp=g.copy(); sr,sc,N=start; er,ec,s=end
    exp[sr:sr+N, sc:sc+N]=river
    exp[er:er+s, ec:ec+s]=mover
    if not np.array_equal(out, exp):
        print('"'bad',i,start,end)
        print(g)
        print(out)
        print(exp)
        break
else:
    print('all ok')
