import random
import heapq
from collections import deque
import numpy as np


def build_profile(L, N):
    min_w = random.randint(2, N)
    num_events = random.randint(1, 3)
    points = sorted(random.sample(range(1, L), num_events))
    widths = [N] * (L + 1)
    curr_min = N
    for idx, pt in enumerate(points):
        if idx == num_events - 1:
            w = min_w
        else:
            w = random.randint(max(2, min_w), curr_min)
        curr_min = min(curr_min, w)
        span = random.randint(1, max(1, (L - pt + 1) // (num_events - idx)))
        for i in range(pt, min(L + 1, pt + span)):
            widths[i] = w
    widths[-1] = min_w
    for i in range(L - 1, -1, -1):
        if widths[i] == N and any(w < N for w in widths[i+1:]):
            if random.random() < 0.35:
                widths[i] = random.randint(curr_min, N)
    # add random widenings after first choke
    first_drop = next((i for i,w in enumerate(widths) if w < N), None)
    if first_drop is not None:
        for i in range(first_drop+1, L):
            if random.random() < 0.15:
                widths[i] = random.randint(min_w, N)
        widths[-1] = min_w
    return widths


def gen():
    bg = 0
    river, mover = random.sample(range(1, 10), 2)
    N = random.randint(4, 6)
    seg_count = random.choice([2, 3])
    if seg_count == 2:
        dirs = [random.choice([(0,1),(0,-1),(1,0),(-1,0)])]
        d = dirs[0]
        dirs.append(random.choice([(1,0),(-1,0)] if d[0]==0 else [(0,1),(0,-1)]))
    else:
        first = random.choice([(0,1),(0,-1),(1,0),(-1,0)])
        second = random.choice([(1,0),(-1,0)] if first[0]==0 else [(0,1),(0,-1)])
        third = first
        dirs = [first, second, third]
    lens = [random.randint(3, 7) for _ in range(seg_count)]
    pts = [(0,0)]
    for (dr,dc), ln in zip(dirs, lens):
        for _ in range(ln):
            r,c = pts[-1]
            pts.append((r+dr,c+dc))
    widths = build_profile(len(pts)-1, N)
    back = []
    if random.random() < 0.5:
        bdir = (-dirs[0][0], -dirs[0][1])
        bw = random.randint(1, N-1)
        blen = random.randint(1, 3)
        cur = pts[0]
        for _ in range(blen):
            cur = (cur[0]+bdir[0], cur[1]+bdir[1])
            back.append(cur)
        back_widths = [bw] * len(back)
    else:
        back_widths = []
    all_pts = back[::-1] + pts
    all_widths = back_widths[::-1] + widths
    rs = [r for r,c in all_pts]
    cs = [c for r,c in all_pts]
    minr, maxr = min(rs), max(rs)
    minc, maxc = min(cs), max(cs)
    maxw = max(all_widths)
    shift_r = 2 - minr
    shift_c = 2 - minc
    pts2 = [(r+shift_r, c+shift_c) for r,c in pts]
    back2 = [(r+shift_r, c+shift_c) for r,c in back]
    all_pts2 = back2[::-1] + pts2
    H = max(r+w for (r,c),w in zip(all_pts2, all_widths)) + 2
    W = max(c+w for (r,c),w in zip(all_pts2, all_widths)) + 2
    if H > 30 or W > 30:
        return None
    grid = np.full((H,W), bg, dtype=int)
    for (r,c), w in zip(all_pts2, all_widths):
        grid[r:r+w, c:c+w] = river
    sr,sc = pts2[0]
    grid[sr:sr+N, sc:sc+N] = mover
    end_r,end_c = pts2[-1]
    m = widths[-1]
    # ensure mover area not equal end area maybe enough
    return grid, (sr,sc,N), (end_r,end_c,m), river, mover


def largest_square_starts(mask):
    H,W = mask.shape
    dp = np.zeros((H+1,W+1), dtype=int)
    M = np.zeros((H,W), dtype=int)
    for r in range(H-1,-1,-1):
        for c in range(W-1,-1,-1):
            if mask[r,c]:
                dp[r,c] = 1 + min(dp[r+1,c], dp[r,c+1], dp[r+1,c+1])
                M[r,c] = dp[r,c]
    return M


def solve(grid):
    g = grid.copy()
    vals, counts = np.unique(g, return_counts=True)
    bg = int(vals[np.argmax(counts)])
    colors = [int(v) for v in vals if int(v) "'!= bg]
    # pick solid square component color as mover: assume unique color whose bbox is full square and area=bbox area smaller count maybe
    mover = None; sr=sc=N=None
    for col in colors:
        coords = np.argwhere(g==col)
        r0,c0 = coords.min(axis=0); r1,c1 = coords.max(axis=0)
        if r1-r0 == c1-c0 and coords.shape[0] == (r1-r0+1)*(c1-c0+1):
            mover = col; sr=int(r0); sc=int(c0); N=int(r1-r0+1); break
    river = [c for c in colors if c != mover][0]
    mask = (g == river) | (g == mover)
    M = largest_square_starts(mask)
    H,W = g.shape
    INF = -1
    best = np.full((H,W), -1, dtype=int)
    dist = np.full((H,W), -1, dtype=int)
    pq = [(-int(M[sr,sc]), 0, sr, sc)]
    best[sr,sc] = int(M[sr,sc])
    dist[sr,sc] = 0
    while pq:
