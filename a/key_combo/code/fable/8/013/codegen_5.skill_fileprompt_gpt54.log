    river = [c for c in np.unique(g) if c not in (bg, mover)][0]
    expected = g.copy()
    sr, sc, N = start
    er, ec, s = end
    expected[sr:sr+N, sc:sc+N] = river
    expected[er:er+s, ec:ec+s] = mover
    if not np.array_equal(out, expected):
        print('"'bad', i, start, end, k)
