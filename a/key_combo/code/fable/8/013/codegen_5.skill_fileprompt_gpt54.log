import random, numpy as np


def rot_top_left(r, c, s, shape, k):
    H, W = shape
    k %= 4
    if k == 0:
        return r, c
    if k == 1:
        return W - (c + s), r
    if k == 2:
        return H - (r + s), W - (c + s)
    return c, H - (r + s)

def detect_square(mask):
    coords = np.argwhere(mask)
    if coords.size == 0:
        return None
    r0, c0 = coords.min(axis=0)
    r1, c1 = coords.max(axis=0)
    h = int(r1 - r0 + 1)
    w = int(c1 - c0 + 1)
    if h "'!= w or coords.shape[0] != h * w:
        return None
    return int(r0), int(c0), h

def build_profile(N):
    segs = random.randint(3, 5)
    final = random.randint(max(2, N - 3), N)
    widths = [N]
    seen_drop = False
    for i in range(1, segs):
        if i == segs - 1:
            widths.append(final)
            continue
        low = final if seen_drop else max(final, N - 2)
        high = N
        w = random.randint(low, high)
        if w < N:
            seen_drop = True
        widths.append(w)
    if final < N and not seen_drop:
        j = random.randint(1, segs - 2)
        widths[j] = random.randint(final, N - 1)
    widths[-1] = final
    if final < N and min(widths) == N:
        widths[-1] = final
    return widths

def gen():
    bg = 0
    river, mover = random.sample(range(1,10), 2)
    N = random.randint(4, 7)
    widths = build_profile(N)
    lens = [random.randint(2, 6) for _ in widths]
    spur_len = random.randint(0, 3)
    spur_width = random.randint(1, N - 1) if spur_len else 0
    forward_len = sum(lens)
    max_w = max(widths + ([spur_width] if spur_len else []))
    H = max(12, max_w + 4)
    W = max(12, spur_len + N + forward_len + 4)
    if H > 30 or W > 30:
        return None
    sr = 2
    sc = 2 + spur_len
    g = np.full((H, W), bg, dtype=int)
    # optional irrelevant back spur
    for x in range(spur_len):
        col = sc - spur_len + x
        g[sr:sr + spur_width, col:col + 1] = river
    # forward varying-width corridor as per-column strip heights
    col = sc
    for width, length in zip(widths, lens):
        for _ in range(length):
            g[sr:sr + width, col] = river
            col += 1
    end_col = col - 1
    # ensure the initial square fully sits on the corridor
    g[sr:sr + N, sc:sc + N] = mover
    final = min(widths)
    end = (sr, end_col - final + 1, final)
    start = (sr, sc, N)
    rot = random.randint(0, 3)
    g = np.rot90(g, rot)
    start = (*rot_top_left(*start, (H, W), rot), N)
    end = (*rot_top_left(*end, (H, W), rot), final)
    return g, start, end

def solve_canonical(g):
    vals, cts = np.unique(g, return_counts=True)
    bg = int(vals[np.argmax(cts)])
    colors = [int(v) for v in vals if int(v) != bg]
    if len(colors) != 2:
        return None
    starts = []
    for col in colors:
        sq = detect_square(g == col)
        if sq is not None:
            starts.append((col, sq))
    if len(starts) != 1:
        return None
    mover, (sr, sc, N) = starts[0]
    river = colors[0] if colors[1] == mover else colors[1]
    mask = (g == mover) | (g == river)
    # must continue to the right beyond the square
    if sc + N >= g.shape[1] or not bool(mask[sr, sc + N]):
        return None
    # no forward corridor cells above start row
    for c in range(sc, g.shape[1]):
        if bool(mask[sr, c]):
            if sr > 0 and bool(mask[sr - 1, c]):
                return None
    # measure contiguous forward columns starting at sc
    end_col = sc + N - 1
    c = sc
    while c < g.shape[1] and bool(mask[sr, c]):
        end_col = c
        c += 1
    # require dead-end after end_col
    if end_col + 1 < g.shape[1] and bool(mask[sr, end_col + 1]):
        return None
    widths = []
    for c in range(sc, end_col + 1):
        h = 0
        while sr + h < g.shape[0] and bool(mask[sr + h, c]):
            h += 1
        if h <= 0:
            return None
        if np.any(mask[:sr, c]) or np.any(mask[sr + h :, c]):
            return None
        widths.append(h)
    if max(widths[:N]) < N:
        return None
    final = min(widths)
    return mover, river, (sr, sc, N), (sr, end_col - final + 1, final)

def solve(g):
    for k in range(4):
        rot = np.rot90(g, k)
        parsed = solve_canonical(rot)
        if parsed is None:
            continue
        mover, river, start, end = parsed
        out = rot.copy()
        sr, sc, N = start
        er, ec, s = end
        out[sr:sr + N, sc:sc + N] = river
        out[er:er + s, ec:ec + s] = mover
        return np.rot90(out, -k)
    return None

for i in range(5000):
    item = gen()
    if item is None:
        continue
    g, start, end = item
    out = solve(g)
    if out is None:
        print('"'no solve', i, start, end)
        print(g)
        break
    vals, cts = np.unique(g, return_counts=True)
    bg = int(vals[np.argmax(cts)])
    colors = [int(v) for v in vals if int(v) "'!= bg]
    mover = next(col for col in colors if detect_square(g == col) is not None)
    river = next(col for col in colors if col != mover)
    exp = g.copy()
    sr, sc, N = start
    er, ec, s = end
    exp[sr:sr + N, sc:sc + N] = river
    exp[er:er + s, ec:ec + s] = mover
    if not np.array_equal(out, exp):
        print('"'bad', i, start, end)
        print(g)
        print(out)
        print(exp)
        break
else:
    print('all ok')
