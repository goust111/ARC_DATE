import random, numpy as np

def rot_top_left(r, c, s, shape, k):
    H, W = shape
    k %= 4
    if k == 0:
        return r, c
    if k == 1:
        return W - (c + s), r
    if k == 2:
        return H - (r + s), W - (c + s)
    return c, H - (r + s)

def detect_solid_square(mask):
    coords = np.argwhere(mask)
    if coords.size == 0:
        return None
    r0, c0 = coords.min(axis=0)
    r1, c1 = coords.max(axis=0)
    h = int(r1 - r0 + 1)
    w = int(c1 - c0 + 1)
    if h "'!= w:
        return None
    if coords.shape[0] != h * w:
        return None
    return int(r0), int(c0), h

def capacity(mask):
    H, W = mask.shape
    dp = np.zeros((H + 1, W + 1), dtype=int)
    out = np.zeros((H, W), dtype=int)
    for r in range(H - 1, -1, -1):
        for c in range(W - 1, -1, -1):
            if mask[r, c]:
                dp[r, c] = 1 + min(dp[r + 1, c], dp[r, c + 1], dp[r + 1, c + 1])
                out[r, c] = dp[r, c]
    return out

def gen():
    bg = 0
    river, mover = random.sample(range(1, 10), 2)
    N = random.randint(4, 7)
    final = random.randint(max(2, N - 3), N)
    run_right = random.randint(5, 10)
    run_down = random.randint(5, 10)
    spur_len = random.randint(0, 3)
    spur_w = random.randint(1, N - 1) if spur_len else 0
    H = max(12, 2 + N + run_down + 2)
    W = max(12, 2 + spur_len + N + run_right + 2)
    if H > 30 or W > 30:
        return None
    sr = 2
    sc = 2 + spur_len
    g = np.full((H, W), bg, dtype=int)
    if spur_len:
        for step in range(spur_len):
            c = sc - spur_len + step
            g[sr:sr + spur_w, c:c + spur_w] = river
    for step in range(run_right + 1):
        c = sc + step
        g[sr:sr + N, c:c + N] = river
    bend_c = sc + run_right
    for step in range(1, run_down + 1):
        r = sr + step
        g[r:r + final, bend_c:bend_c + final] = river
    g[sr:sr + N, sc:sc + N] = mover
    end = (sr + run_down, bend_c, final)
    start = (sr, sc, N)
    rot = random.randint(0, 3)
    g = np.rot90(g, rot)
    start = (*rot_top_left(*start, (H, W), rot), N)
    end = (*rot_top_left(*end, (H, W), rot), final)
    return g, start, end

def solve_rotated(g):
    vals, cts = np.unique(g, return_counts=True)
    bg = int(vals[np.argmax(cts)])
    colors = [int(v) for v in vals if int(v) != bg]
    if len(colors) != 2:
        return None
    mover = river = None
    start = None
    for col in colors:
        sq = detect_solid_square(g == col)
        if sq is not None:
            mover = col
            start = sq
            river = colors[0] if colors[1] == col else colors[1]
            break
    if start is None:
        return None
    sr, sc, N = start
    mask = (g == mover) | (g == river)
    M = capacity(mask)
    if int(M[sr, sc]) != N:
        return None
    if sc + 1 >= g.shape[1] or int(M[sr, sc + 1]) != N:
        return None
    # Disallow downward start in canonical orientation.
    if sr + 1 < g.shape[0] and int(M[sr + 1, sc]) >= N:
        return None
    r, c = sr, sc
    while c + 1 < g.shape[1] and int(M[r, c + 1]) == N:
        c += 1
    # Need a downward continuation from the bend.
    if r + 1 >= g.shape[0] or int(M[r + 1, c]) <= 0 or int(M[r + 1, c]) > N:
        return None
    s = int(M[r + 1, c])
    r += 1
    while r + 1 < g.shape[0] and int(M[r + 1, c]) == s:
        r += 1
    return mover, river, start, (r, c, s)

def solve(g):
    for k in range(4):
        rot = np.rot90(g, k)
        parsed = solve_rotated(rot)
        if parsed is None:
            continue
        mover, river, start, end = parsed
        out = rot.copy()
        sr, sc, N = start
        er, ec, s = end
        out[sr:sr + N, sc:sc + N] = river
        out[er:er + s, ec:ec + s] = mover
        return np.rot90(out, -k)
    return None

for i in range(5000):
    item = gen()
    if item is None:
        continue
    g, start, end = item
    out = solve(g)
    if out is None:
        print('"'no solve', i, start, end)
        print(g)
        break
    vals, cts = np.unique(g, return_counts=True)
    bg = int(vals[np.argmax(cts)])
    colors = [int(v) for v in vals if int(v) "'!= bg]
    mover = next(col for col in colors if detect_solid_square(g == col) is not None)
    river = next(col for col in colors if col != mover)
    exp = g.copy()
    sr, sc, N = start
    er, ec, s = end
    exp[sr:sr + N, sc:sc + N] = river
    exp[er:er + s, ec:ec + s] = mover
    if not np.array_equal(out, exp):
        print('"'bad', i, start, end)
        print(g)
        print(out)
        print(exp)
        break
else:
    print('all ok')
