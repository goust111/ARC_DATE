/bin/bash -lc "python - <<'PY'
import random, numpy as np

def rotate_pos(r, c, s, shape, k):
    H, W = shape
    if k % 4 == 0:
        return r, c
    if k % 4 == 1:
        return W - (c + s), r
    if k % 4 == 2:
        return H - (r + s), W - (c + s)
    return c, H - (r + s)

def gen():
    bg = 0
    river, mover = random.sample(range(1,10),2)
    N = random.randint(4,7)
    final = random.randint(max(2, N-3), N)
    L1 = random.randint(4, 10)
    L2 = random.randint(4, 10)
    spur_len = random.randint(1, 3) if random.random() < 0.5 else 0
    spur_w = random.randint(1, max(1, N-1)) if spur_len else 0
    H = max(N + L2 + 4, 12)
    W = max(N + L1 + spur_len + 4, 12)
    sr = 2; sc = 2 + spur_len
    g = np.zeros((H,W), dtype=int)
    if spur_len:
        for x in range(spur_len):
            c = sc - spur_len + x
            g[sr:sr+spur_w, c:c+spur_w] = river
    for step in range(L1 + 1):
        c = sc + step
        g[sr:sr+N, c:c+N] = river
    bend_r = sr; bend_c = sc + L1
    for step in range(1, L2 + 1):
        r = bend_r + step
        g[r:r+final, bend_c:bend_c+final] = river
    g[sr:sr+N, sc:sc+N] = mover
    out_pos = (bend_r + L2, bend_c, final)
    k = random.randint(0,3)
    g2 = np.rot90(g, k)
    rr, cc = rotate_pos(*out_pos, g.shape, k)
    sr2, sc2 = rotate_pos(sr, sc, N, g.shape, k)
    return g2, (sr2, sc2, N), (rr, cc, final)

def detect_square(g, color):
    coords = np.argwhere(g == color)
    if coords.size == 0:
        return None
    r0, c0 = coords.min(axis=0)
    r1, c1 = coords.max(axis=0)
    side = int(r1 - r0 + 1)
    if side "'!= int(c1 - c0 + 1):
        return None
    if coords.shape[0] != side * side:
        return None
    return int(r0), int(c0), side

def cap(mask):
    H, W = mask.shape
    dp = np.zeros((H+1, W+1), dtype=int)
    M = np.zeros((H, W), dtype=int)
    for r in range(H-1, -1, -1):
        for c in range(W-1, -1, -1):
            if mask[r, c]:
                dp[r, c] = 1 + min(dp[r+1, c], dp[r, c+1], dp[r+1, c+1])
                M[r, c] = dp[r, c]
    return M

def solve_canonical(g):
    vals, cts = np.unique(g, return_counts=True)
    bg = int(vals[np.argmax(cts)])
    colors = [int(v) for v in vals if int(v) != bg]
    starts = []
    for color in colors:
        sq = detect_square(g, color)
        if sq is not None:
            starts.append((color, sq))
    if len(starts) != 1:
        return None
    mover, (sr, sc, N) = starts[0]
    river = colors[0] if colors[1] == mover else colors[1]
    M = cap((g == river) | (g == mover))
    if int(M[sr, sc]) != N:
        return None
    if sc + 1 >= g.shape[1] or int(M[sr, sc + 1]) != N:
        return None
    r, c, s = sr, sc, N
    while c + 1 < g.shape[1] and int(M[r, c + 1]) == s:
        c += 1
    if r + 1 < g.shape[0] and 0 < int(M[r + 1, c]) <= s:
        s = int(M[r + 1, c])
        r += 1
        while r + 1 < g.shape[0] and int(M[r + 1, c]) == s:
            r += 1
    if c + 1 < g.shape[1] and int(M[r, c + 1]) == s:
        return None
    return mover, river, (sr, sc, N), (r, c, s)

def solve(g):
    for k in range(4):
        rot = np.rot90(g, k)
        solved = solve_canonical(rot)
        if solved is None:
            continue
        mover, river, start, end = solved
        out = rot.copy()
        sr, sc, N = start
        er, ec, s = end
        out[sr:sr+N, sc:sc+N] = river
        out[er:er+s, ec:ec+s] = mover
        return np.rot90(out, -k)
    return None

for i in range(5000):
    item = gen()
    if item is None: continue
    g, start, end = item
    out = solve(g)
    if out is None:
        print('"'no solve', i, start, end)
        print(g)
        break
    vals,cts=np.unique(g,return_counts=True)
    bg=int(vals[np.argmax(cts)])
    colors=[int(v) for v in vals if int(v)"'!=bg]
    mover=[c for c in colors if detect_square(g,c) is not None][0]
    river=[c for c in colors if c!=mover][0]
    exp=g.copy()
    sr,sc,N=start
    er,ec,s=end
    exp[sr:sr+N,sc:sc+N]=river
    exp[er:er+s,ec:ec+s]=mover
    if not np.array_equal(out,exp):
        print('"'bad',i,start,end)
        print(g)
        print(out)
        print(exp)
        break
else:
    print('all ok')
