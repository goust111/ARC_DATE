+def _specs() -> list[dict]:
+    count = random.choice([3, 4])
+    colors = random.sample(list(range(1, 10)), count)
+
+    directions = ["left", "right", "up", "down"]
+    random.shuffle(directions)
+    directions = directions[:count]
+
+    gaps = [1, 2, 3]
+    if count == 4:
