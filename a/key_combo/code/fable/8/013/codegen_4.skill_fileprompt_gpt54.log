+    center_r = (r0 + r1) // 2
+    center_c = (c0 + c1) // 2
+
+    if r == center_r:
+        if c < c0:
+            gap = c0 - c - 1
+            if 1 <= gap <= 3 and np.all(grid[r, c + 1 : c0] == 0):
+                return gap, True
+        if c > c1:
+            gap = c - c1 - 1
+            if 1 <= gap <= 3 and np.all(grid[r, c1 + 1 : c] == 0):
