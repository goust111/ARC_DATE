+
+
+def _sample_occurrence_positions(branch: str, main_h: int, main_w: int, kh: int, kw: int) -> list[tuple[int, int]] | None:
+    if branch == "row":
+        max_count = min(4, (main_w + 1) // (kw + 1))
+        if max_count < 2:
+            return None
+        count = random.randint(2, max_count)
