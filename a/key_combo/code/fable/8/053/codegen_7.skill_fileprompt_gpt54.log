spec:
  grid: 15x15, background black (0)
  rectangles:
    count: 3 [observed]
    colors: 3 distinct non-black colors [observed: always {1, 2, 4}]
    shape: solid axis-aligned rectangles, height 1-7, width 1-5
    placement: all rectangles have bottom edge at the last row (row 14)
    column_separation: column ranges are non-overlapping with gaps of 1-3 cols between adjacent rects
    height_constraint: each rect height h satisfies 2*h <= grid_rows (dest must fit above)
  clearance: the h rows immediately above each rect (its destination) must be all-background
  no_overlap_after_shift: shifted rects (each moved up by its own height) must not overlap each other
  output: erase each rect from original position, paste it h rows higher (new bottom = old top - 1)

generation_strategy:
