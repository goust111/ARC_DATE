+
+
+def _choose_sprite_set() -> tuple[list[np.ndarray], int]:
+    for _ in range(200):
+        count = random.randint(*SPRITE_COUNT_RANGE)
+        masks: list[np.ndarray] = []
+        sigs: set[tuple] = set()
+        while len(masks) < count:
+            mask = _random_connected_mask()
+            sig = _mask_signature(mask)
+            if sig in sigs:
+                continue
+            sigs.add(sig)
+            masks.append(mask)
