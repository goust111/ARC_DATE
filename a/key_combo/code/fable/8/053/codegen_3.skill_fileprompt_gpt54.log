    hit_rows = {br for br,_ in winner['block_hits']}
    hit_cols = {bc for _,bc in winner['block_hits']}
    if len(winner['block_hits']) < 2 or len(hit_rows) < 2 or len(hit_cols) < 2:
        ctr['bad_block_spread'] += 1
        continue
