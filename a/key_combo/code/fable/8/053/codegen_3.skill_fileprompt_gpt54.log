+    if style == "near_full":
+        residue = set(full_scaled)
+        max_remove = min(len(residue) - 1, max(2, len(residue) // 4))
+        remove_count = random.randint(1, max_remove)
+        for cell in random.sample(tuple(residue), remove_count):
+            residue.remove(cell)
