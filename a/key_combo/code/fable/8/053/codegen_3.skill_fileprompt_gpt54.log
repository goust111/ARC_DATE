+        sigs: set[tuple] = set()
+        while len(masks) < count:
+            mask = _random_connected_mask()
+            sig = _mask_signature(mask)
+            if sig in sigs:
+                continue
+            sigs.add(sig)
+            masks.append(mask)
+
+        candidates = []
+        for i, mask_i in enumerate(masks):
