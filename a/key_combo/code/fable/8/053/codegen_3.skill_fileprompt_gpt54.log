+COLOR_IDS = tuple(range(10))
+GRID_RANGE = (18, 28)
+SPRITE_COUNT_RANGE = (3, 5)
+SPRITE_BBOX_RANGE = (2, 4)
+SPRITE_AREA_RANGE = (4, 7)
+PLACEMENT_RETRIES = 120
+GENERATION_RETRIES = 500
