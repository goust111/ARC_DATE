+    if style == "structured":
+        block_count = random.randint(max(2, min(3, len(cells))), len(cells))
+    elif style == "sparse":
+        block_count = random.randint(2, min(len(cells), 3))
+    else:
+        raise ValueError(f"unknown residue style: {style}")
