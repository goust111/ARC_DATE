        ctr['no_essential'] += 1
        continue
    bps = mod._best_partial_support(input_grid, mod._candidate_key(expected))
    if bps < 2:
        ctr[f'partial_{bps}'] += 1
        continue
    if not np.array_equal(mod.main(input_grid), grid_out):
        ctr['main_mismatch'] += 1
        continue
    ctr['ok'] += 1
