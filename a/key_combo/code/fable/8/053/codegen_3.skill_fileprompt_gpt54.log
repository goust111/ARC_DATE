+    chosen_blocks = set(random.sample(cells, block_count))
+    residue: set[tuple[int, int]] = set()
+    for br, bc in chosen_blocks:
+        for dr, dc in _sample_block_subset(scale):
+            residue.add((br * scale + dr, bc * scale + dc))
