+        for nr, nc in _neighbors8(int(r), int(c)):
+            if 0 <= nr < h and 0 <= nc < w:
+                out[nr, nc] = True
+    return out
+
+
+def _place_mask(
+    grid: np.ndarray,
+    blocked: np.ndarray,
+    mask: np.ndarray,
+    color: int,
+    *,
+    prefer_edge: bool = False,
+) -> tuple[int, int] | None:
+    h, w = grid.shape
+    mh, mw = mask.shape
+    coords = np.argwhere(mask)
+
+    edge_positions = []
+    inner_positions = []
+    for top in range(h - mh + 1):
+        for left in range(w - mw + 1):
+            rr = coords[:, 0] + top
+            cc = coords[:, 1] + left
+            if np.any(blocked[rr, cc]):
+                continue
