+        start = (random.randrange(h), random.randrange(w))
+        cells = {start}
+        frontier = set()
+        for nbr in _neighbors8(*start):
+            if 0 <= nbr[0] < h and 0 <= nbr[1] < w:
+                frontier.add(nbr)
