+                                "residue_color": residue_color,
+                                "sprite_sig": sprite_sig,
+                                "sprite_mask": sprite_mask,
+                                "sprite_index": sprite_index,
+                                "scale": scale,
+                                "top": int(top),
+                                "left": int(left),
+                                "scaled_coords": scaled_coords,
+                                "scaled_shape": (sh, sw),
+                                "residue_coords": residue_coords.copy(),
+                                "block_hits": block_hits,
