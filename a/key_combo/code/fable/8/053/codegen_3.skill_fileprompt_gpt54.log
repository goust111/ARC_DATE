# === CFG: Canvas & layout ===
GRID_SIZE = 30                     # fixed 30x30 canvas
WALLPAPER_COLORS = (4, 5)         # number of wallpaper stripe colors (chosen per n_types)
TOTAL_COLORS_TARGET = (7, 8, 9)   # total distinct color count targets
GAP_RANGE = (1, 4)                # gap between rectangles during dimension selection

# === CFG: Rectangle size bounds ===
