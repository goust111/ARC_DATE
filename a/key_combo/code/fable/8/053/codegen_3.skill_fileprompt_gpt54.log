+            "top": int(target_top),
+            "left": int(target_left),
+            "scaled_coords": np.argwhere(scaled_target),
+            "residue_coords": np.array(sorted(residue_abs), dtype=int),
+            "block_hits": chosen_blocks,
+            "full_area": int(scaled_target.sum()),
