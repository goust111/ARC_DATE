    for idx in chosen[:BLUE_COUNT]:
        grid[idx // GRID_SIZE, idx % GRID_SIZE] = Color.BLUE
    for idx in chosen[BLUE_COUNT:]:
        grid[idx // GRID_SIZE, idx % GRID_SIZE] = Color.RED
    return grid


def generate_input() -> np.ndarray:
