+BLACK = 0
+GREY = 5
+VISIBLE_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+MAX_GENERATION_ATTEMPTS = 400
+
+
+def _infer_block_shape(grid: np.ndarray) -> tuple[int, int]:
