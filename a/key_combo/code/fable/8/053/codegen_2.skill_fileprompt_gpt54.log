+
+
+def _erase_halos(grid: np.ndarray, halos: list[dict], bg: int) -> np.ndarray:
+    out = grid.copy()
+    for halo in halos:
+        cr, cc = halo["center"]
+        out[cr, cc] = bg
+        for rr, cc2 in halo["ring"]:
