 391: def label_mask(mask: np.ndarray, connectivity: int = 4) -> tuple[np.ndarray, int]:
 392:     """Connected-components labeling for a boolean mask."""
 393:     struct = STRUCT4 if int(connectivity) == 4 else STRUCT8
 394:     lab, n = label(mask.astype(bool), structure=struct)
 395:     return lab, int(n)
