+
+
+def _validate_fake_local(blue: set[tuple[int, int]], occluders: dict[tuple[int, int], int]) -> bool:
+    grid = np.zeros((9, 9), dtype=int)
+    for rr, cc in blue:
+        grid[rr, cc] = BLUE
