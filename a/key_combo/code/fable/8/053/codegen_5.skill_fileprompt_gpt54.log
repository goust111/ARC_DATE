   8: def main(grid: np.ndarray) -> np.ndarray:
   9:     """
  10:     Erase all distractor pixels and expand the single red control pixel into the grid quadrant that contains it.
  11: 
  12:     Input structure:
  13:     - The grid has one dominant background color.
  14:     - Exactly one red pixel is the control pixel.
  15:     - Other non-background pixels are distractors.
  16: 
  17:     Rule:
  18:     - Clear the canvas to the background color.
  19:     - Split the grid into equal top/bottom and left/right halves.
  20:     - Fill the quadrant containing the red control pixel with red.
  21: 
  22:     Key insight:
  23:     - The red control pixel selects a whole half-grid quadrant by its row half and column half; all other foreground pixels are noise.
  24:     """
  25:     g = np.asarray(grid, dtype=int)
  26:     H, W = g.shape
  27:     assert H % 2 == 0 and W % 2 == 0, "grid must split into equal quadrants"
  28: 
  29:     bg = get_bg(g)
  30:     marker_color = Color.RED
  31:     marker_coords = coords_where(g == marker_color)
  32:     assert len(marker_coords) == 1, "expected exactly one red control pixel"
  33: 
  34:     half_h = H // 2
  35:     half_w = W // 2
  36:     marker_r, marker_c = map(int, marker_coords[0])
  37:     r0 = 0 if marker_r < half_h else half_h
  38:     c0 = 0 if marker_c < half_w else half_w
  39: 
  40:     out = np.full_like(g, bg)
  41:     out[r0 : r0 + half_h, c0 : c0 + half_w] = marker_color
  42:     return out
  43: 
  44: # --------------- generator (att2) ---------------
