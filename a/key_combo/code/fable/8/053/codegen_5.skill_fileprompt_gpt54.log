+                border_cells.append((r, c))
+    random.shuffle(border_cells)
+    return border_cells
+
+
+def _build_true_object(shape: tuple[int, int], mode: str) -> dict | None:
+    centers = _candidate_true_centers(shape, mode)
+    for center in centers:
+        r, c = center
