  85:     allocation = {q: 1 for q in chosen_quadrants}
  86:     for _ in range(distractor_count - spread_count):
  87:         expandable = [q for q in chosen_quadrants if allocation[q] < len(free_by_quadrant[q])]
  88:         q = expandable[int(np.random.randint(len(expandable)))]
  89:         allocation[q] += 1
  90: 
  91:     distractor_cells: list[tuple[int, int]] = []
  92:     for q, count in allocation.items():
  93:         cells = free_by_quadrant[q]
  94:         picked = np.random.choice(len(cells), size=count, replace=False)
  95:         distractor_cells.extend(cells[int(i)] for i in picked)
  96:     return distractor_cells
