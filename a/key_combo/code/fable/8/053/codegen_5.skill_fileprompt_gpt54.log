   9: def main(grid: np.ndarray) -> np.ndarray:
  10:     """
  11:     Erase the top palette row and redraw it below as a widening wedge centered on its missing cell.
  12: 
  13:     Input structure
  14:     - The top row is a palette row with exactly one background gap.
  15:     - Below it, the only foreground is one vertical marker bar of a single color.
  16:     - The marker bar is either in the gap column or immediately beside it.
  17: 
  18:     Rule
  19:     - Clear the grid to background.
  20:     - Starting at the top of the marker bar, each next row copies one more
  21:       column of the top-row palette on both sides of the gap.
  22:     - Fill the gap column with the marker color, and keep the vertical marker bar.
  23: 
  24:     Key insight
  25:     - The lone background cell in the top row is the center of the expanding
  26:       copy; the lower vertical bar provides the center color and the row where
  27:       the expansion begins.
  28:     """
  29:     g = np.asarray(grid, dtype=int)
  30:     assert g.ndim == 2
  31:     height, width = g.shape
  32: 
  33:     bg = get_bg(g)
  34:     top = g[0, :]
  35:     gap_cols = np.flatnonzero(top == bg)
  36:     assert gap_cols.size == 1, "expected exactly one background gap in the top row"
  37:     gap_col = int(gap_cols[0])
  38: 
  39:     lower_coords = np.argwhere(g[1:, :] != bg)
  40:     assert lower_coords.size > 0, "expected a lower marker bar"
  41:     lower_coords[:, 0] += 1
  42: 
  43:     marker_colors = {int(g[r, c]) for r, c in lower_coords}
  44:     marker_cols = {int(c) for _r, c in lower_coords}
  45:     assert len(marker_colors) == 1, "expected one lower marker color"
  46:     assert len(marker_cols) == 1, "expected one lower marker column"
  47:     marker = marker_colors.pop()
  48:     line_col = marker_cols.pop()
  49:     line_start = int(lower_coords[:, 0].min())
  50: 
  51:     assert np.all(g[1:line_start, :] == bg), "rows before the marker bar must be background"
  52:     assert np.all(g[line_start:, line_col] == marker), "marker bar must be solid"
  53:     assert lower_coords.shape[0] == height - line_start, "marker bar must be the only lower foreground"
  54:     assert line_col == gap_col or abs(line_col - gap_col) == 1
  55:     if line_col != gap_col:
  56:         assert top[line_col] == marker
  57:     assert np.all(top[np.arange(width) != gap_col] != bg), "only the gap may be background in the palette row"
  58: 
  59:     out = np.full_like(g, bg)
  60:     out[line_start:, line_col] = marker
  61: 
  62:     for r in range(line_start, height):
  63:         radius = r - line_start
  64:         c0 = max(0, gap_col - radius)
  65:         c1 = min(width - 1, gap_col + radius)
  66:         for c in range(c0, c1 + 1):
  67:             if radius == 0 and c == gap_col and line_col != gap_col:
  68:                 continue
  69:             out[r, c] = marker if c == gap_col else int(top[c])
  70:         out[r, line_col] = marker
  71: 
  72:     return out
  73: 
