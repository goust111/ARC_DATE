+    for dr, dc in offsets:
+        patch[dr + 1, dc + 1] = BLUE
+    comps = find_components(
+        patch,
+        bg=BG,
+        connectivity=4,
+        monochromatic=True,
+        colors=[BLUE],
+        return_format="dict",
