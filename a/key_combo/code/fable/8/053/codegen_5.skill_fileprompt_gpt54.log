+
+def _is_valid_halo_center(grid: np.ndarray, comp_coords: set[tuple[int, int]], center_r: int, center_c: int) -> bool:
+    for rr, cc in comp_coords:
+        if max(abs(int(rr) - int(center_r)), abs(int(cc) - int(center_c))) != 1:
+            return False
