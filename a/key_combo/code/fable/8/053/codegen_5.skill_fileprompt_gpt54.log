  51: QUADRANT_SIZE = 2
  52: QUADRANT_AXIS_COUNT = 2
  53: QUADRANTS = tuple((r, c) for r in range(QUADRANT_AXIS_COUNT) for c in range(QUADRANT_AXIS_COUNT))
  54: 
  55: # Distractor count and quadrant-spread settings.
