+                continue
+            occluded = set(in_bounds_offsets) - visible
+            if not occluded:
+                continue
+        elif mode == "edge":
+            if out_of_bounds_count == 0:
+                continue
+            visible = set(in_bounds_offsets)
+            occluded = set()
+            if len(visible) < 2 or not _connected_offsets(visible):
