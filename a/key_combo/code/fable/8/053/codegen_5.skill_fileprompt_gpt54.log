+    out = g.copy()
+    blue_components = find_components(
+        g,
+        bg=BG,
+        connectivity=4,
+        monochromatic=True,
+        colors=[BLUE],
+        return_format="dict",
+    )
+
+    for comp in blue_components:
+        coords = {tuple(map(int, rc)) for rc in np.asarray(comp["coords"], dtype=int)}
+        candidates = _component_candidates(g, coords)
