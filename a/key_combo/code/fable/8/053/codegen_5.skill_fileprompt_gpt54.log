+    for dr, dc in HALO_OFFSETS:
+        rr = int(center_r) + dr
+        cc = int(center_c) + dc
+        if not _in_bounds(grid.shape, rr, cc):
+            continue
+        value = int(grid[rr, cc])
+        if value == BLUE:
+            if (rr, cc) not in comp_coords:
