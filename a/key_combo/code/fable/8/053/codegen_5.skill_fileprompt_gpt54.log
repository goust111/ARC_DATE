spec:
  grid: square, odd side length 9-13 (i.e. NxN where N in {9,11,13})
  background: 5
  palette_row:
    position: row 0
    content: W-1 non-bg colors filling every cell except one central gap
    gap: exactly 1 cell at center column (col W//2), filled with bg
    colors: any from 0-9 except bg; repeats allowed; need not be symmetric
  marker_bar:
    color: 8 [observed]
    column: same as gap column (center) [observed]
    extent: solid vertical bar from line_start to bottom row
    line_start: row 2-5; must satisfy bar_length >= W//2 + 1
    rows_above_bar: 1 to W//2 - 2 empty bg rows between palette row and bar top
  constraint: bar_length = H - line_start; must be >= W//2 + 1 so wedge fully expands to edges
  output:
    clear grid to bg; draw expanding wedge centered on gap_col starting at line_start
    each row r adds radius = r - line_start columns on each side of center
    gap column filled with marker color; marker bar column also marker color
    bottom rows (after full expansion) repeat the fully-expanded row

generation_strategy:
