  62: 
  63: def _quadrant_cells(qr, qc):
  64:     r0, c0 = qr * QUADRANT_SIZE, qc * QUADRANT_SIZE
  65:     return [(r, c) for r in range(r0, r0 + QUADRANT_SIZE) for c in range(c0, c0 + QUADRANT_SIZE)]
  66: 
  67: 
  68: def _place_marker(grid):
  69:     """Place the red control pixel; return ((qr, qc), (r, c))."""
  70:     quadrant = (int(np.random.randint(QUADRANT_AXIS_COUNT)), int(np.random.randint(QUADRANT_AXIS_COUNT)))
  71:     marker_cells = _quadrant_cells(*quadrant)
  72:     marker_cell = marker_cells[int(np.random.randint(len(marker_cells)))]
  73:     grid[marker_cell] = RED
