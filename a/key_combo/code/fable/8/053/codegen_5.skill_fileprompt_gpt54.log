+            return False
+    for (rr, cc), _color in occluders.items():
+        if grid[rr, cc] != BG:
+            return False
+    for rr, cc in blue:
+        grid[rr, cc] = BLUE
+    for (rr, cc), color in occluders.items():
+        grid[rr, cc] = int(color)
+    for rr, cc in reserve_zone:
+        reserved[rr, cc] = True
+    return True
