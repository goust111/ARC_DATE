+        if mode == "occlusion":
+            if out_of_bounds_count != 0 or len(in_bounds_offsets) < 4:
+                continue
+            visible = _sample_connected_subset(
+                in_bounds_offsets,
+                min_size=3,
+                max_size=len(in_bounds_offsets) - 1,
