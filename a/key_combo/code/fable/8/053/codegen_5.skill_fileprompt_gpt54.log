  77: def _sample_distractor_cells(marker_cell, distractor_count):
  78:     """Sample cells with at least one distractor in each chosen quadrant."""
  79:     free_by_quadrant = {q: [cell for cell in _quadrant_cells(*q) if cell != marker_cell] for q in QUADRANTS}
  80:     spread_min, spread_max = SPREAD_QUADRANT_RANGE
  81:     spread_count = int(np.random.randint(spread_min, min(spread_max, distractor_count) + 1))
  82:     chosen_ids = np.random.choice(len(QUADRANTS), size=spread_count, replace=False)
  83:     chosen_quadrants = [QUADRANTS[int(i)] for i in chosen_ids]
