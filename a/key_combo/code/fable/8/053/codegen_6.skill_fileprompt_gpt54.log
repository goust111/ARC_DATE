+        (mr - 1, mc),
+        (mr - 1, mc + 1),
+        (mr, mc - 1),
+        (mr, mc),
+        (mr, mc + 1),
+        (mr + 1, mc - 1),
+        (mr + 1, mc),
+        (mr + 1, mc + 1),
+    }:
+        return False
+
+    return True
+
