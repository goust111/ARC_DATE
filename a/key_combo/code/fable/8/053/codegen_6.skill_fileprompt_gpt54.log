+        cluster = sub[:, c0a : c1a + 1]
+        glyph = sub[:, c0b : c1b + 1]
+        assert glyph.shape == (3, 3), "glyph must be 3x3"
+
+        count = int(np.count_nonzero(cluster != bg))
+        assert count not in mapping, "cluster counts must be unique across dictionary entries"
