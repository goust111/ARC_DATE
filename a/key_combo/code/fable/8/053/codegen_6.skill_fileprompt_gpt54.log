+        (mr - 1, mc),
+        (mr - 1, mc + 1),
+        (mr, mc - 1),
+        (mr, mc),
+        (mr, mc + 1),
+        (mr + 1, mc - 1),
+        (mr + 1, mc),
+        (mr + 1, mc + 1),
+    }:
+        return False
+
+    return True
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GEN_ATTEMPTS):
+        inp, expected = _build_case()
+        if _semantic_checks(inp, expected):
