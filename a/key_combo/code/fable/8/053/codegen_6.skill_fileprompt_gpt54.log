+    out = main_zone
+    patch = out[r0 : r0 + 3, c0 : c0 + 3]
+    mask = glyph != bg
+    patch[mask] = glyph[mask]
+    return out
+
+
+def _expected_from_case(
+    height: int,
+    main_w: int,
+    marker_color: int,
+    present_corners: list[tuple[int, int]],
+    missing_corner: tuple[int, int],
+    glyph: np.ndarray,
