+    missing = list(all_corners - present)
+    assert len(missing) == 1, "expected exactly one missing corner"
+    return side, missing[0], coords
+
+
+def _parse_dictionary(dict_zone: np.ndarray, bg: int) -> dict[int, np.ndarray]:
