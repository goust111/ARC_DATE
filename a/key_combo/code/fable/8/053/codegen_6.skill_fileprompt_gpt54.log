+
+def _semantic_checks(inp: np.ndarray, expected: np.ndarray) -> bool:
+    bg = get_bg(inp)
+    sep_cols = [
+        c
+        for c in range(inp.shape[1])
+        if int(inp[0, c]) != bg and bool(np.all(inp[:, c] == inp[0, c]))
+    ]
+    if len(sep_cols) != 1:
+        return False
+
+    sep_c = int(sep_cols[0])
+    main_zone = inp[:, :sep_c]
+    dict_zone = inp[:, sep_c + 1 :]
