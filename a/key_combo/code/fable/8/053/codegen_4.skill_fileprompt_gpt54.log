+            seen[r, c] = True
+            cells = []
+            while queue:
+                rr, cc = queue.popleft()
+                cells.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
