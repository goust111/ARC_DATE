+                clear_initial = _clear_rows(coords, initial_surface)
+                shift_initial = min(area, clear_initial)
+                merged_initial = clear_initial <= area
+                if shift_initial == shift and merged_initial == (gap <= area):
+                    continue
+                delta = shift_initial - shift
+            else:
+                delta = 0
