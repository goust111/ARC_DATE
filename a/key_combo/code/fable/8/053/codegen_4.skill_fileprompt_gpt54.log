+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_SCENE_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid chain-settling input")

