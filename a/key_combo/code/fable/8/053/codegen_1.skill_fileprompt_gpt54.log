+_SHAPE_ROWS = [
+    ("11",),
+    ("1", "1"),
+    ("111",),
+    ("1", "1", "1"),
+    ("11", "10"),
+    ("11", "01"),
+    ("10", "11"),
+    ("01", "11"),
+    ("11", "11"),
+    ("111", "100"),
+    ("111", "001"),
+    ("100", "111"),
+    ("001", "111"),
