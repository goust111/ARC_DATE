+    object_patch = _draw_object(object_h, object_w, object_color, bg, placed_holes)
+    expected_holes = []
+    color_cursor = 0
+    for idx, hole in enumerate(placed_holes):
+        spec = dict(hole)
+        if idx in paired_indices:
