+    ext_shape_to_colors: defaultdict[tuple[tuple[int, int], ...], list[int]] = defaultdict(list)
+    for comp in comps:
+        if comp is target:
+            continue
+        sig = normalize_shape(comp["coords"])
+        ext_shape_to_colors[sig].append(int(comp["color"]))
