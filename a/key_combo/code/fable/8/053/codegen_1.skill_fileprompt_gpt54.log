+    for hole in hole_components(out, bg):
+        sig = normalize_shape(hole)
+        colors = set(ext_shape_to_colors.get(sig, []))
+        assert len(colors) <= 1, "hole match must be color-unique"
+        if not colors:
+            continue
+        fill = colors.pop()
+        for rr, cc in hole:
