+from __future__ import annotations
+
+from collections import Counter, defaultdict
+import random
+
+import numpy as np
+
+
+NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+MAX_GEN_ATTEMPTS = 400
+
+
+def get_bg(grid: np.ndarray) -> int:
