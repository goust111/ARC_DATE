+    cc0 = max(0, int(c0) - int(pad))
+    rr1 = min(hh, int(r0) + int(h) + int(pad))
+    cc1 = min(ww, int(c0) + int(w) + int(pad))
+    reserved[rr0:rr1, cc0:cc1] = True
