+    ("010", "111"),
+    ("110", "011"),
+    ("011", "110"),
+    ("10", "11", "01"),
+    ("01", "11", "10"),
+    ("10", "11", "10"),
+    ("01", "11", "01"),
+    ("11", "10", "10"),
+    ("11", "01", "01"),
+    ("111", "110"),
+    ("111", "011"),
+    ("110", "111"),
+    ("011", "111"),
+    ("111", "101"),
+    ("101", "111"),
+    ("10", "11", "11"),
+    ("01", "11", "11"),
+    ("11", "11", "10"),
+    ("11", "11", "01"),
