+def shape_patch(sig: tuple[tuple[int, int], ...], color: int, bg: int) -> np.ndarray:
+    h, w = sig_bbox(sig)
+    patch = np.full((h, w), int(bg), dtype=int)
+    for r, c in sig:
+        patch[int(r), int(c)] = int(color)
+    return patch
