+
+def components_mask(mask: np.ndarray, connectivity: int = 4) -> list[np.ndarray]:
+    if int(connectivity) != 4:
+        raise ValueError("only 4-connectivity is used in this task")
+    mask = np.asarray(mask, dtype=bool)
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    h, w = mask.shape
+
+    for r, c in np.argwhere(mask):
+        rr = int(r)
+        cc = int(c)
+        if seen[rr, cc]:
+            continue
+        stack = [(rr, cc)]
+        seen[rr, cc] = True
+        coords: list[tuple[int, int]] = []
+        while stack:
+            cr, cc2 = stack.pop()
+            coords.append((cr, cc2))
+            for dr, dc in NEIGHBORS4:
+                nr, nc = cr + dr, cc2 + dc
+                if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    stack.append((nr, nc))
+        comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    comps: list[dict] = []
+    for color in sorted(set(map(int, g.reshape(-1))) - {int(bg)}):
+        for coords in components_mask(g == color, connectivity=4):
+            comps.append(
+                {
+                    "color": int(color),
+                    "coords": coords,
+                    "area": int(coords.shape[0]),
+                    "bbox": bbox_coords(coords),
+                }
+            )
+    return comps
