+def _build_expected(object_patch: np.ndarray, bg: int, holes: list[dict]) -> np.ndarray:
+    out = object_patch.copy()
+    for hole in holes:
+        if "fill_color" not in hole:
+            continue
+        fill = int(hole["fill_color"])
+        for dr, dc in hole["shape"]["sig"]:
