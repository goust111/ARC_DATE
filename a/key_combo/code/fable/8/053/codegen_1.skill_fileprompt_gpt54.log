+_SHAPE_ROWS = [
+    ("11",),
+    ("1", "1"),
+    ("111",),
+    ("1", "1", "1"),
+    ("11", "10"),
+    ("11", "01"),
+    ("10", "11"),
+    ("01", "11"),
+    ("11", "11"),
+    ("111", "100"),
+    ("111", "001"),
+    ("100", "111"),
+    ("001", "111"),
+    ("1111",),
+    ("1", "1", "1", "1"),
+    ("111", "010"),
+    ("010", "111"),
+    ("110", "011"),
+    ("011", "110"),
+    ("10", "11", "01"),
+    ("01", "11", "10"),
+    ("10", "11", "10"),
+    ("01", "11", "01"),
+    ("11", "10", "10"),
+    ("11", "01", "01"),
+    ("111", "110"),
+    ("111", "011"),
+    ("110", "111"),
+    ("011", "111"),
+    ("111", "101"),
+    ("101", "111"),
+    ("10", "11", "11"),
+    ("01", "11", "11"),
+    ("11", "11", "10"),
+    ("11", "11", "01"),
+]
+
+
+def _sig_from_rows(rows: tuple[str, ...]) -> tuple[tuple[int, int], ...]:
+    coords = []
+    for r, row in enumerate(rows):
+        for c, ch in enumerate(row):
+            if ch == "1":
+                coords.append((r, c))
+    return tuple(coords)
+
+
+SHAPES = []
+_seen_sigs = set()
+for rows in _SHAPE_ROWS:
+    sig = _sig_from_rows(rows)
+    if sig in _seen_sigs:
+        continue
+    _seen_sigs.add(sig)
+    SHAPES.append({"sig": sig, "area": sig_area(sig), "bbox": sig_bbox(sig)})
+
+
+def _shape_group_ok(shapes: list[dict]) -> bool:
+    return any(
+        s1["area"] == s2["area"] or s1["bbox"] == s2["bbox"]
+        for i, s1 in enumerate(shapes)
+        for s2 in shapes[i + 1 :]
+    )
+
