BACKGROUND = 7
OBJECT_COLORS = [2, 5, 9]
OBJECT_COUNT = 3
AREA_MIN, AREA_MAX = 1, 5
ROTATION_COUNT = 4
MIRROR_PROB = 0.5
MAX_CLIPPED_OBJECTS = 2
NEIGHBORS_4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
MAX_ATTEMPTS = 300



def generate_input():
    for _ in range(MAX_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid 8e301a54 input")



