    content: W-1 non-bg colors filling every cell except one central gap
    gap: exactly 1 cell at center column (col W//2), filled with bg
    colors: any from 0-9 except bg; repeats allowed; need not be symmetric
  marker_bar:
    color: 8 [observed]
    column: same as gap column (center) [observed]
