+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+MAX_ATTEMPTS = 400
+PALETTE = tuple(range(10))
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.flatten())).most_common(1)[0][0])
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == bg or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            arr = np.array(coords, dtype=int)
+            comps.append(
+                {
+                    "color": color,
+                    "coords": arr,
+                    "bbox": _bbox(arr),
+                    "area": int(arr.shape[0]),
+                }
+            )
+    return comps
+
+
+def _cyclic_from_gap(colors: list[int], gap_idx: int) -> list[int]:
+    return colors[gap_idx:] + colors[:gap_idx]
+
+
+def _build_output(
+    shape: tuple[int, int],
+    bg: int,
+    span_left: int,
+    completed_palette: list[int],
+    gap_idx: int,
+    width_by_color: dict[int, int],
+) -> np.ndarray:
+    h, w = map(int, shape)
+    out = np.full((h, w), bg, dtype=int)
+    span_right = span_left + len(completed_palette) - 1
+    gap_col = span_left + gap_idx
+    out[h - 1, span_left : span_right + 1] = np.array(completed_palette, dtype=int)
+    for level, color in enumerate(_cyclic_from_gap(completed_palette, gap_idx)):
+        row = h - 2 - level
+        width = int(width_by_color[color])
+        half = width // 2
+        out[row, gap_col - half : gap_col + half + 1] = color
+    return out
+
+
+def _build_output_from_order(
+    shape: tuple[int, int],
+    bg: int,
+    span_left: int,
+    completed_palette: list[int],
+    gap_idx: int,
+    width_by_color: dict[int, int],
+    order: list[int],
+) -> np.ndarray:
+    h, w = map(int, shape)
+    out = np.full((h, w), bg, dtype=int)
+    span_right = span_left + len(completed_palette) - 1
+    gap_col = span_left + gap_idx
+    out[h - 1, span_left : span_right + 1] = np.array(completed_palette, dtype=int)
+    for level, color in enumerate(order):
+        row = h - 2 - level
+        width = int(width_by_color[color])
+        half = width // 2
+        out[row, gap_col - half : gap_col + half + 1] = color
+    return out
+
+
+def _analyze_input(grid: np.ndarray) -> dict:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2 and g.size > 0
+    h, w = g.shape
+    bg = _get_bg(g)
