+    max_w = min(30, min_w + 8)
+    if min_w > max_w:
+        return None
+    width = random.randint(min_w, max_w)
+
+    candidate_lefts = [
+        left
+        for left in range(width - palette_len + 1)
+        if max_half <= left + gap_idx <= width - 1 - max_half
