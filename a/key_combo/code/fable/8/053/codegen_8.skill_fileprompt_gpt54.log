  "src": "top palette row with one bg gap and a lower single-color marker bar",
  "dst": "widening wedge rows below the marker bar, centered on the top-row gap",
  "transform": "erase the top row; in each row from the marker top downward, copy the top-row colors within the current centered interval, replace the gap column with the marker color, and keep the marker bar"
}
</annotation>
