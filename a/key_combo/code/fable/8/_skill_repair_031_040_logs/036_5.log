/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:2910:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:4885:        "path2": "move(c, direction='up') such that c.projections align vertically with s.projections and s.bottom_edge is 1 cell above slot.bottom_edge",
