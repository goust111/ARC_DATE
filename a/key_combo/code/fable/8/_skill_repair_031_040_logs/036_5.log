/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3007:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:10879:        "multi_step": "Step 1: identify red and green marker pixels; Step 2: move sprite above red marker to position above green marker; Step 3: recolor moved sprite to match original sprite color at destination; Step 4: turn original source sprite location to grey; Step 5: remove both marker pixels",
