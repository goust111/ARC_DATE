/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:2980:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:8607:        "catalog:marker_axis",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:2981:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:8608:        "catalog:marker_pixels",
