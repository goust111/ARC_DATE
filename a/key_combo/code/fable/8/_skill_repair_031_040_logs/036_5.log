/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:2998:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:10513:        "marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:2999:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:10514:        "marker_color",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3000:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:10515:        "markers",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3001:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:10867:      "docstring": "Transfer sprites from red-marked lanes to green-marked lanes, recoloring and stacking.\n\nInput structure:\n- bg = most common color. Red (2) and green (3) thin bars define vertical lanes.\n- Each lane contains repeated identical monochrome sprites in an evenly spaced vertical grid.\n\nRule:\n- Each red lane's sprites turn grey (5); their count transfers to the nearest green lane.\n- New sprites fill empty lattice slots bottom-up, using the source shape recolored to the destination lane's sprite color.\n- All marker bars are removed.\n\nKey insight: Sprite count is conserved across lanes — red sprites become grey, and equally many new sprites stack into the green lane's regular grid.",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3002:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:10870:        "summary": "Move sprite from red marker region to green marker region, recoloring it to match the green region's original sprite color, while turning the source sprite location grey and removing both markers.",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3003:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:10872:        "src": "sprite sitting on red marker pixel region s",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3004:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:10873:        "dst": "position of sprite sitting on green marker pixel region d",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3005:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:10874:        "match_cond": "s.marker_color == red && d.marker_color == green",
