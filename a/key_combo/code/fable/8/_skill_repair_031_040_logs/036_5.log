/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3309:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:31512:        "marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3310:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:31513:        "markers",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3311:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:31665:        "object:marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3312:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:31756:      "docstring": "Repair markers embedded in the main object and copy the remaining markers one pixel toward the solid edge.\n\nInput structure:\n- A mostly background grid contains one solid non-background edge line.\n- Apart from that edge and the background, there is one large main object\n  color and a smaller marker color.\n- Each marker is either embedded in the main object, touching it on at\n  least three 4-neighbor sides, or isolated on the background.\n\nRule:\n- Embedded markers are recolored to the main object color.\n- Isolated background markers remain in place and also paint the adjacent\n  background pixel in the direction of the solid edge line.\n- All other pixels are unchanged.\n\nKey insight:\nThe full edge line is a direction cue: it tells which way the background\nmarkers extend, while markers surrounded by the main object are simply\ndefects to be filled.",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3313:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:31760:        "src": "one main foreground object, marker pixels, and a full non-background edge line",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3314:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:31761:        "transform": "use the edge line as the direction cue; recolor markers embedded in the main object to the object color, and copy each isolated background marker one pixel toward the edge line"
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3315:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:31765:        "catalog:marker_pixels",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3316:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:31774:        "object:marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3317:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:31822:        "marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3318:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:31823:        "markers",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3319:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:31898:        "object:marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3320:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:32636:      "docstring": "Extend each colored domino marker into a full row or column bar, with horizontal bars covering vertical bars at crossings.\n\nInput structure:\n- The background is the dominant color.\n- Every foreground object is a 4-connected same-color domino of exactly two pixels.\n- A horizontal domino marks a row to paint; a vertical domino marks a column to paint.\n\nRule:\n- Paint each marked column entirely with the color of its vertical domino marker.\n- Paint each marked row entirely with the color of its horizontal domino marker.\n- Rows are painted after columns, so row bars overwrite column bars at intersections.\n\nKey insight:\n- The two-pixel orientation is the instruction: horizontal markers emit row bars, vertical markers emit column bars, and the only layering cue is row-over-column.",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3321:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:32640:        "src": "same-color two-pixel domino markers",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3322:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:32641:        "path": "horizontal markers extend across their entire row; vertical markers extend across their entire column to both grid edges",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3323:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:32642:        "trajectory": "paint every pixel along the row or column with the marker color",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3324:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:32653:        "object:marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3325:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:32709:        "marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3326:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:32710:        "markers",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3327:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:32755:      "docstring": "Recolor the sparse foreground pixels in scan order along their longer spread, cycling red, teal, and grey.\n\nInput structure:\n- The dominant color is the background.\n- Every foreground object is a single isolated 4-connected pixel.\n- The foreground pixel set has a rectangular bbox whose row or column extent defines the scan direction.\n\nRule:\n- Keep the background unchanged.\n- If the foreground bbox is at least as tall as it is wide, order foreground pixels row-major; otherwise order them column-major.\n- Recolor the ordered pixels by repeating red, teal, grey from the first pixel onward.\n\nKey insight:\n- The original foreground colors are only markers; the output color depends on each marker's ordinal position in the dominant scan direction.",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3328:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:32759:        "src": "isolated foreground marker pixels on the background",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3329:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:32760:        "dst": "same marker locations",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3330:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:32761:        "transform": "ignore the original marker colors and recolor the ordered markers by repeating red, teal, grey",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3331:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:32766:        "catalog:marker_pixels",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3332:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:32772:        "object:marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3333:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:32825:        "marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3334:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:32826:        "markers",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3335:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:32880:      "docstring": "Paint straight rays from colored side markers into the hollow diamond frame until an interior foreground pixel blocks each ray.\n\nInput structure\n- The background contains one complete one-pixel-thick diamond frame.\n- Colored marker pixels outside the diamond sit on the top, bottom, left, or right side of the frame's bounding box.\n- Any non-background, non-frame pixels inside the diamond are blockers that remain unchanged.\n\nRule\n- Each outside marker emits inward perpendicular to its side of the diamond bounding box.\n- Along that row or column, paint only background pixels strictly inside the diamond with the marker color.\n- Stop a ray when it reaches an existing interior foreground pixel; keep the frame and all original colored pixels unchanged.\n\nKey insight\n- The diamond frame defines a strict interior, while the side markers are column or row emitters whose color fills the visible interior interval until blocked.",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3336:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:32884:        "src": "colored marker pixels outside the diamond frame on the frame bbox sides",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3337:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:32885:        "path": "straight inward ray along the marker's column from a top/bottom side or along its row from a left/right side, stopping at an existing interior foreground pixel",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3338:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:32886:        "trajectory": "paint every background pixel strictly inside the diamond along the ray with the marker color",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3339:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:32887:        "transform": "keep the diamond frame, outside markers, and existing interior foreground blockers unchanged"
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3340:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:32891:        "catalog:marker_pixels",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3341:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:32897:        "object:marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3342:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:32953:        "marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3343:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:32954:        "markers",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3344:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:33012:      "docstring": "Drop the columns of the top marker downward, stopping blue-ended columns on grey obstacles and letting maroon-ended columns pass to the bottom.\n\nInput structure\n- The background is the dominant color.\n- The most numerous non-background color forms stationary grey obstacle pixels.\n- The other two colors form a single 3x3 top-edge marker whose top two rows\n  are maroon and whose bottom row contains maroon or blue control pixels.\n\nRule\n- Erase the top marker.\n- Treat each marker column as a vertical drop retaining its three colors.\n- A column whose bottom control pixel is blue stops immediately above the\n  first grey pixel below that column, or bottom-aligns if none exists.\n- Contiguous maroon-ended columns pass through obstacles and bottom-align;\n  if such a run has a clear down-right slide from a grey ledge, shift the\n  run one column right before bottom-aligning.\n- When a maroon-ended drop lands through a grey bar on the bottom edge, clear\n  the rest of the marker-width gap in that bottom bar.\n\nKey insight\n- The bottom row of the top marker is a control strip: blue cells mean\n  \"stick to the first obstacle,\" while maroon cells mean \"fall through.\"",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3345:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:33016:        "src": "columns of the 3x3 maroon/blue marker on the top edge; the bottom cell of each column is the control pixel",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3346:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:33017:        "path": "vertical drop in each marker column; blue-ended columns stop above the first grey obstacle below, while maroon-ended runs pass through to the bottom with a one-column right slide from a clear grey ledge",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3347:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:33018:        "trajectory": "copy each three-pixel marker column intact; contiguous maroon-ended columns are tested as one run for the slide",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3348:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:33019:        "dst": "settled positions on the same canvas after erasing the top marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3349:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:33020:        "transform": "if a maroon-ended drop lands through a grey bar on the bottom edge, clear the rest of the marker-width gap in that bar; leave other grey obstacles fixed"
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3350:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:33032:        "object:marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3351:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:33103:        "marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3352:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:33386:      "docstring": "Move the single marker to the endpoint reached by sliding along the obstacle contour.\n\nInput structure:\n- A dominant background color fills the canvas.\n- One single-pixel marker sits away from a connected obstacle region of the\n  remaining color.\n- The marker has exactly one horizontal or vertical sightline to the obstacle.\n\nRule:\n- Find the last background pixel before the obstacle along that sightline.\n- From that pixel, try the two diagonal turns that continue around the\n  obstacle boundary.\n- Move the marker to the endpoint of the turn that remains 4-adjacent to the\n  obstacle for the longest distance.\n\nKey insight:\nThe marker is not placed by distance to the obstacle; it first points to the\nobstacle, then follows the visible outside contour until that contour segment ends.",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3353:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:33390:        "src": "single marker pixel",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3354:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:33391:        "path": "cardinal sightline from the marker to the obstacle region, then diagonal slide along the 4-adjacent outside contour",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3355:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:33393:        "trajectory": "move only the marker to dst",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3356:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:33394:        "transform": "old marker pixel becomes background; keep the obstacle and all other background pixels unchanged"
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3357:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:33406:        "object:marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3358:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:33459:        "marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3359:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:33635:      "docstring": "Expand the colored runs from the left reference panel into the blank right panel.\n\nInput structure:\n- A uniform rectangular frame surrounds the grid.\n- One full-height divider of the frame color splits a left reference panel\n  from a blank right panel.\n- Both panels have one background margin column on each side of their active\n  columns; the left active columns contain two-column endpoint slots, possibly\n  connected by same-color horizontal runs.\n\nRule:\n- Keep the original grid and paint only in the right panel's active columns.\n- A source run exactly matching the left endpoint slot is copied to the left\n  two columns of the right active span.\n- A source run exactly matching the right endpoint slot is copied to the right\n  two columns of the right active span.\n- A source run connecting the endpoint slots is stretched across the entire\n  right active span.\n\nKey insight:\nThe left panel is a compressed legend for the right panel: endpoint markers\nstay two pixels wide, while connectors between endpoints expand to fill the\ndistance between them.",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3360:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:33652:        "object:marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3361:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:33715:        "markers",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3362:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:34021:      "docstring": "Erase the complete interior glyph and expand each endpoint marker pair into its color's full glyph.\n\nInput structure\n- The grid is 20x20 with background inside two same-color full-height vertical frame bars.\n- Inside the frame there is one complete color glyph and one or more other colors appearing only as two endpoint markers in the same row.\n- Marker endpoints are always in the first and last interior columns.\n\nRule\n- Keep the vertical frame unchanged.\n- Erase any complete interior glyph.\n- For each endpoint marker pair, use that marker color's learned glyph template and anchor its horizontal bar on the marker row.\n\nKey insight\n- Color identifies which glyph shape to draw; the two endpoint pixels are not copied objects, they are anchors for reconstructing that color's full symbol.",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3363:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:34025:        "src": "vertical frame containing one complete color glyph and one or more same-row two-pixel endpoint markers of other colors",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3364:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:34026:        "transform": "erase the complete glyph; expand each endpoint marker pair into that marker color's learned glyph template anchored on the marker row"
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3365:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:34037:        "object:marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3366:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:34094:        "marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3367:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:34095:        "markers",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3368:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:34362:      "docstring": "Move each marked cross object away from its marker to the grid edge while rotating the colored cross 180 degrees.\n\nInput structure:\n- The background is the dominant color.\n- Each 8-connected foreground object has nine pixels: a 4-pixel marker-color\n  sprite attached to a 5-pixel non-marker colored cross.\n- Each object bbox is either 3x6 or 6x3, so the marker sprite is on exactly\n  one side of the cross.\n\nRule:\n- Move the whole object straight away from its marker side until the object\n  bbox touches the corresponding grid edge.\n- Keep the marker sprite unchanged within the object.\n- Rotate the 3x3 colored cross block by 180 degrees before placing it.\n\nKey insight:\nThe marker sprite is a directional tail; the cross is the leading payload,\nand only that payload turns around during the slide to the edge.",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3369:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:34366:        "src": "each 8-connected composite object made of a 4-pixel blue marker sprite attached to a 5-pixel colored cross",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3370:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:34367:        "path": "straight away from the marker sprite until the composite bbox reaches the grid edge",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3371:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:34369:        "transform": "rotate the 3x3 colored cross 180 degrees within the composite; keep the marker sprite unchanged"
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3372:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:34381:        "object:marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3373:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:34437:        "marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3374:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:35342:      "docstring": "Erase the first border pixel hit by extending the red marker away from its pink trail.\n\nInput structure\n- The dominant background surrounds a unique red marker and a four-pixel\n  pink trail.\n- The pink pixels form one straight 8-connected ray starting next to the\n  red marker.\n- In the opposite direction from that trail, the red marker faces a\n  non-background border or obstacle pixel beyond background cells.\n\nRule\n- Keep the whole grid fixed except for the first non-background pixel on\n  the ray from the red marker away from the pink trail.\n- Recolor that one hit pixel to the background color.\n\nKey insight\n- The pink trail marks where the red marker came from, so the edit is found\n  by ray-casting from the red marker in the opposite direction.",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3375:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:35346:        "src": "red marker with a four-pixel pink trail",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3376:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:35347:        "path": "ray from the red marker away from the pink trail until the first non-background pixel",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3377:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:35362:        "object:marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3378:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:35412:        "marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3379:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:35588:        "multi_step": "top-to-bottom order breaks equal marker-center distances",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3380:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:35598:        "object:marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3381:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:35671:        "marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3382:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:35745:      "docstring": "Extend each solid foreground rectangle toward its same-color isolated pixels with capped one-cell paths, clearing each original marker pixel.\n\nInput structure\n- The background is the dominant color.\n- Each foreground color has exactly one solid rectangular object and one or more isolated same-color marker pixels.\n- Every marker is horizontally or vertically aligned with the rectangle bbox and lies outside it.\nRule\n- For each marker, draw a one-cell-wide straight path from the adjacent side of the rectangle through one cell beyond the marker.\n- Add a three-pixel perpendicular cap at the rectangle end and around the marker endpoint.\n- Recolor the original marker pixel to background.\nKey insight\n- The isolated pixels are not copied; they mark the hollow endpoints of capped protrusions grown from their matching rectangle.",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3383:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:35749:        "src": "solid foreground rectangles and same-color isolated marker pixels",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3384:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:35750:        "path": "straight horizontal or vertical path from the aligned rectangle side to one cell beyond each marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3385:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:35751:        "trajectory": "paint a one-cell-wide path with three-pixel perpendicular caps at the rectangle side and marker endpoint",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3386:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:35752:        "transform": "clear each original marker pixel to background; keep the rectangles unchanged"
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3387:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:35757:        "catalog:marker_pixels",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3388:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:35764:        "object:marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3389:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:35822:        "marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3390:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:35897:        "object:marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3391:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:36018:      "docstring": "Extract the lattice subregion bounded by the four background-colored corner holes.\n\nInput structure:\n- A regular one-cell-thick lattice has one line color, one background color,\n  and sparse marker pixels.\n- Exactly four lattice-line intersections are background-colored holes instead\n  of line-color pixels.\n\nRule:\n- Find the unique non-background color that forms regular horizontal and\n  vertical lattice lines.\n- Use the four background-colored lattice intersections as the corners of one\n  rectangle.\n- Return the inclusive crop between those corner rows and columns.\n\nKey insight:\n- The crop is marked by the missing lattice intersections, not by the marker\n  pixels inside the cells.",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3392:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:36029:        "catalog:marker_pixels",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3393:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:36034:        "object:marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3394:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:36085:        "marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3395:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:36370:      "docstring": "Replace the outlined object with the outside contour of that outline in the marker color.\n\nInput structure:\n- A dominant background surrounds one 8-connected foreground outline.\n- The outline is the unique largest foreground color.\n- One or more smaller interior colors are inside the outline; the marker color\n  is the unique smallest non-outline color.\n\nRule:\n- Erase all original foreground pixels to background.\n- Paint every background pixel that is 4-adjacent to the outline with the\n  marker color.\n- Keep the grid shape unchanged.\n\nKey insight: The colored interior marker supplies the paint color, while the\nlargest outline supplies only the contour whose outside edge is traced.",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3396:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:36374:        "src": "one 8-connected largest foreground outline object and smaller interior marker colors on a dominant background",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3397:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:36375:        "transform": "erase all original foreground pixels; repaint the background pixels 4-adjacent to the outline with the unique smallest non-outline marker color"
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3398:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:36388:        "object:marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3399:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:36423:        "marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3400:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:36600:      "docstring": "Replace an orange canvas with concentric Manhattan-distance color rings centered on the lone marker pixel.\n\nInput structure:\n- The grid is an orange background with exactly one non-orange marker pixel.\n- The marker color is one of the colors in the fixed non-orange ring cycle.\n\nRule:\n- The marker location is distance 0 and keeps the marker color.\n- Each step of Manhattan distance away from the marker advances one position\n  through the cycle green, yellow, black, grey, red, teal, maroon, pink, blue.\n- Fill every pixel of the original grid by this distance-indexed cycle.\n\nKey insight: The output is not copied from existing objects; it is the\ndistance field around the single marker, colored by a cyclic palette that\nexcludes the orange background.",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3401:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:36604:        "src": "single non-orange marker pixel on an orange background",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3402:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:36605:        "dst": "entire grid as concentric Manhattan-distance rings centered on the marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3403:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:36606:        "transform": "use the marker color at distance 0, then advance one step per Manhattan distance through the fixed cycle green, yellow, black, grey, red, teal, maroon, pink, blue"
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3404:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:36612:        "object:marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3405:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:36666:        "marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3406:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:36845:      "docstring": "Fill each centered square ring with the color of the marker at that ring distance.\n\nInput structure\nThe input is an odd square grid with a dominant background color and one\nnon-background marker for every Chebyshev distance from the grid center.\nRule\nThe output replaces the background with concentric square rings centered on\nthe middle cell; every cell at distance d from the center takes the color of\nthe unique marker whose distance from the center is d.\nKey insight\nThe scattered markers are not objects to move; their Chebyshev distances\nform a palette for the centered square rings.",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3407:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:36849:        "src": "non-background marker pixel s",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3408:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:36859:        "object:marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3409:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:36896:        "marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3410:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:36897:        "markers",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3411:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:37099:        "object:marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3412:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:37454:        "object:marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3413:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:37563:      "docstring": "Convert each hollow 3x3 symbol to one pixel and slide the pixels clockwise from the marked edge.\n\nInput structure\n- The grid has a background, one full-edge marker line, and monochrome hollow 3x3 foreground symbols.\n- The symbols lie on a coarse row/column lattice; fully empty lattice rows or columns are absent from the output.\n\nRule\n- Replace each hollow 3x3 symbol with one pixel of its color in the corresponding coarse-grid cell.\n- The marker edge gives the compaction direction by clockwise border travel: top -> right, right -> down, bottom -> left, left -> up.\n- Preserve the order of non-background pixels while sliding them as far as possible in that direction.\n\nKey insight\n- The large picture is a scaled symbolic grid, and the blue edge marker acts as a gravity direction rather than as output content.",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3414:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:37567:        "src": "hollow 3x3 foreground symbols collapsed to one coarse-grid pixel each; the full-edge blue marker selects the path direction",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3415:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:37568:        "path": "straight along each coarse row or column in clockwise border direction from the marker edge: top->right, right->down, bottom->left, left->up; stop when packed against the boundary or previous pixel",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3416:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:37570:        "transform": "discard the blue marker and fully empty coarse rows or columns; replace each hollow 3x3 symbol by its color",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3417:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:37582:        "object:marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3418:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:37651:        "marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3419:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:38348:      "docstring": "Transfer each colored marker to its adjacent neutral mask component, then erase the markers.\n\nInput structure\n- The background is the most common color.\n- The neutral mask color is the unique most frequent foreground color.\n- Other foreground colors are marker pixels that may touch neutral 4-connected mask components.\nRule\n- Remove every marker pixel by recoloring it to the background.\n- For each 4-connected neutral mask component, find marker colors touching it by edge adjacency.\n- If a component touches one marker color, recolor the whole neutral component to that marker color.\n- If a component touches no marker color, leave it neutral.\nKey insight\n- Marker pixels label neighboring neutral regions but are not part of the final colored objects.",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3420:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:38352:        "src": "neutral 4-connected mask components plus non-neutral marker pixels on the background",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3421:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:38353:        "transform": "erase all marker pixels to bg; recolor each neutral component by the unique marker color touching it by edge adjacency; preserve unlabeled neutral components"
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3422:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:38358:        "catalog:marker_pixels",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3423:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:38366:        "object:marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3424:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:38408:        "marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3425:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:38409:        "markers",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3426:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:38461:      "docstring": "Expand each 3-pixel L marker into a same-color corner L on an empty background.\n\nInput structure\n- The grid is an odd square with one dominant background color.\n- Every foreground object is a monochromatic 4-connected 3-pixel L inside a\n  2x2 box.\n\nRule\n- Clear the grid to the background.\n- For each marker, map its L orientation to the corresponding outer corner\n  and draw that corner L in the marker color with arm length half the grid.\n\nKey insight\n- The small marker is a miniature corner; its orientation, not its position,\n  chooses which outer corner receives the expanded L.",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3427:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:38465:        "src": "3-pixel L marker object s in a 2x2 bbox",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3428:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:38476:        "object:marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3429:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:38523:        "marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3430:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:38565:      "docstring": "Swap each 5x5 sprite with its corner marker color and stamp same-marker composite masks into the matching corner.\n\nInput structure:\n- A 30x30 grid has one dominant background color.\n- Non-background corner pixels are marker labels.\n- Every other foreground color is the body of one 5x5 sprite containing exactly one pixel of a corner marker color.\n\nRule:\n- For each sprite, recolor body pixels to the sprite marker color and recolor the marker pixel back to its body color.\n- If a marker lies on the side facing its matching corner and another same-marker sprite has a body pixel at that same local cell, use that visible body color for the marker pixel.\n- For each corner marker, overlay the masks of all sprites with that marker color into the corner 5x5 block and paint the visible composite with the marker color.\n\nKey insight:\nThe corner pixels are labels that group 5x5 sprites by their embedded marker color; each labeled corner shows the grouped sprite silhouette.",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3431:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:38569:        "src": "5x5 sprite s with one body color and one corner-marker control pixel",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3432:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:38571:        "match_cond": "s.control_color == d.corner_marker_color",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3433:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:38572:        "transform": "swap s.body_color and s.control_color in place; paint d with the visible overlay of all matched s.foreground masks using d.marker_color",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3434:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:38583:        "object:marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3435:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:38615:        "corner_marker_color",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3436:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:38644:        "marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3437:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:38645:        "marker_color",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3438:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:38958:      "docstring": "Erase the top palette row and redraw it below as a widening wedge centered on its missing cell.\n\nInput structure\n- The top row is a palette row with exactly one background gap.\n- Below it, the only foreground is one vertical marker bar of a single color.\n- The marker bar is either in the gap column or immediately beside it.\n\nRule\n- Clear the grid to background.\n- Starting at the top of the marker bar, each next row copies one more\n  column of the top-row palette on both sides of the gap.\n- Fill the gap column with the marker color, and keep the vertical marker bar.\n\nKey insight\n- The lone background cell in the top row is the center of the expanding\n  copy; the lower vertical bar provides the center color and the row where\n  the expansion begins.",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3439:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:38962:        "src": "top palette row with one bg gap and a lower single-color marker bar",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3440:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:38963:        "dst": "widening wedge rows below the marker bar, centered on the top-row gap",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3441:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:38964:        "transform": "erase the top row; in each row from the marker top downward, copy the top-row colors within the current centered interval, replace the gap column with the marker color, and keep the marker bar"
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3442:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:38974:        "object:marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3443:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:39028:        "marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3444:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:39089:        "object:marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3445:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:39449:      "docstring": "Recolor each side-marked multicolor object embedded in a monochrome panel to its marker color.\n\nInput structure:\n- Same-color 4-connected components form monochrome panel regions.\n- The bounding box of a panel may contain 4-connected non-panel-color objects.\n- A target object touches exactly one side of its panel bbox, and all of its\n  pixels on that side have one marker color.\n\nRule:\n- For every target object, fill any panel-colored holes enclosed by the object.\n- Recolor the object and filled holes to the side marker color.\n- Leave all other pixels unchanged.\n\nKey insight:\n- A multicolor object's single contact side identifies both which object should\n  be normalized and which color should replace it.",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3446:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:39453:        "src": "4-connected multicolor objects inside a monochrome panel bbox that touch exactly one bbox side with a single marker color",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3447:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:39454:        "transform": "fill any holes in each such object and recolor the object to its side marker color; preserve all other pixels"
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3448:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:39465:        "object:marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3449:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:39511:        "marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3450:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:39687:      "docstring": "Swap a connector segment with repeated marker sprites by connecting the marker anchors and stamping the sprite at the segment endpoints.\n\nInput structure\nThe grid has one background color and exactly two foreground colors. One foreground color forms a single straight 8-connected segment. The other foreground color forms two or more identical centered sprites.\n\nRule\nBuild a background canvas of the same size. Draw straight connector-color segments between every pair of original sprite anchors. Then stamp the marker sprite, using its centered anchor, onto the two endpoints of the original connector segment.\n\nKey insight\nThe original segment endpoints are the destinations for the repeated sprite, while the original sprite centers become the vertices of the new connector-color complete graph.",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3451:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:39691:        "src": "single straight connector segment c and repeated centered marker sprites s",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3452:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:39704:        "object:marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3453:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:39759:        "marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3454:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:40221:      "docstring": "Move each mirrored bottom source pixel to the far end of its trail and redraw the top half as its reflection.\n\nInput structure\n- A solid non-background row separates equal-height top and bottom halves.\n- The top half has one marker color on the background.\n- In the bottom half, exactly one color has positions that mirror the top markers across the separator, and the other color forms trails touching those source pixels.\n\nRule\n- Identify the bottom source color by reflecting each bottom color into the top half and matching the top marker set.\n- For every bottom source pixel, follow its unique 4-connected trail of the other bottom color to the trail endpoint.\n- Clear the old top markers, bottom sources, and trails; place the source color at each endpoint and place the top marker color at the reflected endpoint.\n\nKey insight\n- The top half is only a mirror display of the bottom moving sources; the actual motion is encoded by the trail attached to each bottom source pixel.",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3455:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:40225:        "src": "bottom-half source pixels s, identified as the color whose positions reflect to the top marker mask across the separator row",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3456:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:40228:        "transform": "redraw the top marker color at the reflection of each moved source endpoint; keep the separator and background unchanged"
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3457:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:40237:        "object:marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3458:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:40289:        "marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3459:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:40290:        "markers",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3460:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:40487:        "object:marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3461:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:40576:      "docstring": "Move the patterned edge band to the opposite edge along every row or column whose band slice contains the trail color.\n\nInput structure\n- The dominant color is the background.\n- The two foreground colors are a frequent trail color and a rarer marker color.\n- All marker pixels lie nearest to one grid edge, and that edge contains trail-color runs that define the source-band thickness.\n\nRule\n- Choose the source edge identified by the marker pixels.\n- A row or column perpendicular to that edge moves if its source-band slice contains the trail color.\n- Copy that slice unchanged to the opposite edge, erase the remaining trail cells to background, and keep marker-only lines fixed.\n\nKey insight\n- The marker color identifies the active edge, while the trail color identifies which parallel rows or columns carry an edge-band slice across the grid.",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3462:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:40580:        "src": "source-edge band on the side containing all marker pixels; moving slices are rows/columns where the band contains the trail color",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3463:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:40583:        "transform": "clear the old trail cells to background; rows/columns whose source slice has only marker/background remain unchanged"
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3464:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:40588:        "catalog:marker_pixels",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3465:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:40592:        "object:marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3466:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:40648:        "marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3467:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:40706:      "docstring": "Complete each partial marker mask by stamping the matching multicolor sprite over it.\n\nInput structure\n- A dominant background contains one or more 8-connected multicolor sprites.\n- Separate target masks use colors that already occur inside one of those sprites.\n- A target mask may contain only one marker pixel or several same-alignment marker pixels.\n\nRule\n- For each multicolor sprite, test every translation that aligns a target pixel with a\n  same-color sprite pixel.\n- Keep the translations with maximal exact overlap against the existing target pixels,\n  rejecting translations that conflict with other foreground or overlap a source sprite.\n- Stamp the whole sprite at those translations; if a non-marker sprite color occurs as\n  a single source pixel, consume that source-only marker back to background.\n\nKey insight\nThe scattered target pixels are partial copies: their same-color overlap with a sprite\ndetermines where the full sprite must be completed.",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3468:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:40711:        "dst": "partial target mask d of same-color marker pixels outside source sprites",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3469:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:40713:        "transform": "stamp full s onto d; erase any single-pixel source color not used by the matched marker mask"
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3470:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:40719:        "catalog:marker_pixels",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3471:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:40724:        "object:marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3472:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:40774:        "marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3473:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:40844:      "docstring": "Move each maroon marker toward the blue rectangle and recolor the rectangle red.\n\nInput structure\nA background canvas contains one solid blue rectangular object and several isolated\nmaroon marker pixels. Each marker is horizontally or vertically aligned with the\nrectangle and lies outside it.\n\nRule\nStart with a background canvas, repaint the blue rectangle red, and move each\nmaroon marker straight toward the rectangle along its row or column. Exactly one\nmarker is strictly closer to the rectangle than all others and enters the\nrectangle boundary; every other marker lands in the adjacent exterior cell just\noutside its aligned side.\n\nKey insight\nThe single entering marker is the unique global nearest marker to the rectangle,\nnot the nearest marker on each of the four sides.",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3474:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:40848:        "src": "isolated maroon marker pixels aligned by row or column with the solid blue rectangle",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3475:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:40849:        "path": "straight cardinal path from each marker toward its aligned rectangle side; stop on the side cell if the marker is closer than that side's span, otherwise stop in the adjacent exterior cell",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3476:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:40850:        "trajectory": "move only the marker pixel to the path endpoint",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3477:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:40852:        "transform": "erase the original markers and recolor the blue rectangle red"
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3478:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:40857:        "catalog:marker_pixels",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3479:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:40865:        "object:marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3480:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:40919:        "marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3481:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:40920:        "markers",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3482:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:41392:      "docstring": "Extend each of two aligned rectangular marker objects toward the other, filling half of the gap across the full perpendicular span.\n\nInput structure\n- A dominant background contains exactly two solid, same-sized monochromatic rectangles.\n- The rectangles share either the same row span or the same column span, with a background gap between their facing edges.\n\nRule\n- If the rectangles are side-by-side, color the left half of the inter-object gap across every row with the left object's color, and the right half with the right object's color.\n- If one rectangle is above the other, color the upper half of the gap across every column with the upper object's color, and the lower half with the lower object's color.\n- When the gap length is odd, leave the center row/column as background.\n\nKey insight\n- The marker objects are endpoints of an axial corridor; their own size identifies the facing edge, while the filled corridor spans the whole grid perpendicular to that axis.",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3483:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:41396:        "src": "two solid same-sized rectangular marker objects s sharing either a row span or a column span",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3484:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:41397:        "path": "straight cardinal ray from each s facing edge toward the other marker, stopping after half of the background gap; an odd middle line stays background",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3485:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:41399:        "transform": "keep the original marker rectangles and unpainted background cells unchanged"
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3486:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:41410:        "object:marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3487:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:41477:        "marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3488:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:41544:      "docstring": "Extract the central object from the marker cluster whose markers have the same color.\n\nInput structure\nThe grid has a dominant background and several clusters; each cluster has four\nsame-color corner marker objects around one central monochromatic object.\nRule\nFind every central object enclosed by four aligned corner markers of one color,\nthen choose the unique one whose object color equals the marker color.\nKey insight\nThe answer is not the largest or most frequent object; it is the center of the\nself-colored cluster, cropped to that object's bounding box with background kept.",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3489:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:41549:        "dst": "cluster d of four aligned same-color corner marker objects",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3490:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:41550:        "match_cond": "s is centered inside d and s.color == d.marker_color",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3491:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:41564:        "object:marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3492:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:41619:        "marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3493:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:41620:        "marker_color",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3494:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:41621:        "markers",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3495:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:41920:      "docstring": "Drop the singleton marker into the matching red U-shaped container, or make a bottom-row puddle if no closed container is hit.\n\nInput structure\n- The grid has a dominant background, one singleton marker pixel on the top row,\n  and one other foreground color forming vertical bars and bottom segments.\n- A closed container is a U shape: two vertical side bars with a continuous\n  bottom segment between them and an empty rectangular interior above the bottom.\n\nRule\n- Remove the top marker from its original cell.\n- If exactly one closed U-shaped container has the marker column within its\n  horizontal footprint, fill that container's empty interior with the marker color.\n- If no closed container is under the marker column, fill the whole bottom row\n  with the marker color.\n\nKey insight\n- The marker does not identify a color by value; it identifies a vertical drop\n  column, and only a structurally closed U shape can catch and contain the fill.",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3496:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:41924:        "src": "singleton top-row marker pixel",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3497:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:41925:        "path": "vertical drop down the marker column; a closed U-shaped wall container catches the drop when the marker column lies within its horizontal footprint, otherwise the path reaches the bottom edge",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3498:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:41927:        "trajectory": "fill the caught container's background interior with the marker color; if uncaught, fill the whole bottom row",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3499:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:41928:        "transform": "erase the original marker pixel and keep all wall pixels unchanged"
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3500:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:41940:        "object:marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3501:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:42006:        "marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3502:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:42067:      "docstring": "Move the lower sprite and its pink guide into the upper panel, aligning the sprite to the guide's lower-left branch.\n\nInput structure\n- The grid has one dominant background color and one full-width separator row.\n- Below the separator are exactly two foreground roles: a five-pixel guide marker and one monochrome sprite.\n- The guide marker has normalized shape {(0,2), (1,2), (2,0), (2,2), (3,1)} and starts immediately below the separator.\n\nRule\n- Clear the canvas to the background, preserving the separator row.\n- Translate the guide marker upward so its top row becomes row 0.\n- Move the sprite, preserving its color and shape, so the sprite bbox bottom-right aligns to the translated guide's lower-left branch.\n\nKey insight\n- The marker supplies the destination anchor: its lower-left branch cell is where the moved sprite's bbox bottom-right must land.",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3503:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:42072:        "dst": "translated guide marker branch anchor d in the upper panel",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3504:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:42073:        "match_cond": "s.bbox bottom-right aligns to d, the guide marker's lower-left branch after the marker shifts upward",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3505:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:42074:        "transform": "clear the lower panel; shift the five-pixel guide marker to the top; stamp s without rotation or recolor",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3506:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:42075:        "multi_step": "paint the shifted guide marker first, then stamp s so sprite pixels overwrite guide pixels on overlap"
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3507:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:42086:        "object:marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3508:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:42136:        "marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3509:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:42543:      "docstring": "Add a quantity-color label in the top marker column for each horizontal bar.\n\nInput structure\n- The grid has a black background and one non-background marker pixel in the top row.\n- Below the marker row, every non-empty source row contains one solid monochrome horizontal bar to the left of the marker column.\n- Source rows are staggered every other row.\n\nRule\n- Copy the input grid.\n- For each source bar, read its quantity as the bar length.\n- Paint the quantity color in the marker column on the same row as the bar:\n  2->1, 3->4, 4->9, 5->6.\n\nKey insight\n- The grey marker supplies the result column, while each bar supplies a small quantity with a fixed color code.",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3510:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:42547:        "src": "grey top-row marker column and lower monochrome horizontal bars on black background",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3511:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:42548:        "transform": "for each bar row, add one pixel in the marker column; its color is (n*n) mod 10 where n = min(bar length minus one, first bar row plus zero-based order among the every-other source rows)"
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3512:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:42556:        "object:marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3513:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:42601:        "marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3514:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:42650:      "docstring": "Project maroon markers into adjacent grey or pink 3x3 squares, erasing grey squares afterward.\n\nInput structure\nThe grid has a dominant background, solid 3x3 grey and/or pink squares, and maroon marker pixels or segments directly touching one side of exactly one square.\nRule\nGrey squares are erased; their adjacent maroon markers stay in place and stamp the nearest edge cell inside the grey square. Pink squares stay pink; their adjacent maroon markers disappear and stamp the corresponding cell on the square's middle row or middle column.\nKey insight\nThe side touched by a marker determines the projection: grey uses the near edge, while pink uses the centerline, preserving the marker's coordinate along that side.",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3515:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:42654:        "src": "maroon marker pixels or segments adjacent to solid grey or pink 3x3 square objects",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3516:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:42655:        "transform": "erase grey squares after stamping maroon into each touched near-edge cell; keep grey-adjacent markers in place; keep pink squares, remove pink-adjacent markers, and stamp their maroon cells onto the matching middle row or column of the pink square"
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3517:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:42660:        "catalog:marker_pixels",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3518:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:42661:        "catalog:projection",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3519:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:42668:        "object:marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3520:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:42715:        "marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3521:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:42716:        "markers",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3522:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:42733:        "projection",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3523:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:42883:      "docstring": "Fill the one blank in each corner region so all four regions have the same color multiset.\n\nInput structure:\n- The dominant background color forms one solid separator row and one solid\n  separator column.\n- The separator cross splits the grid into four equal rectangular corner regions.\n- Each corner region contains exactly one background-colored blank pixel.\n\nRule:\n- Count the non-background colors in each corner region.\n- The completed region multiset is defined by the maximum observed count of\n  each color across the four regions.\n- Replace each region's blank pixel with the single color needed to match that\n  completed multiset.\n\nKey insight:\n- The separator color inside a corner region is a missing value marker; comparing\n  the four regions reveals the shared multiset without using numeric color order.",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3524:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:42897:        "object:marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3525:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:42942:        "marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3526:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:43253:      "docstring": "Move red into teal's top marker position, then move teal to the bottom outside corner of the grey rectangle.\n\nInput structure\n- The dominant background surrounds one filled rectangular non-background block.\n- There is exactly one red marker and one teal marker, both in the row immediately above the rectangle.\n- Both markers are horizontally aligned over columns inside the rectangle.\n\nRule\n- Clear the original red marker.\n- Recolor the original teal marker cell red.\n- Place the teal marker beside the rectangle's bottom row, on the side indicated by the horizontal direction from red to teal.\n\nKey insight\n- The red-to-teal horizontal order chooses the rectangle side where teal exits at the bottom.",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3527:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:43257:        "src": "teal marker s above a filled rectangle, with a red marker on the same row",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3528:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:43258:        "path": "from s toward the rectangle side away from the red marker, then down to the background cell beside the rectangle's bottom row",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3529:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:43261:        "transform": "clear the original red marker to background; recolor s.old cell red; keep the rectangle and other background unchanged"
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3530:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:43270:        "object:marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3531:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:43323:        "marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3532:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:43324:        "markers",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3533:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:43378:      "docstring": "Complete the scene by adding the point-reflected copy of the colored object across the central marker.\n\nInput structure\n- The grid has odd dimensions, a dominant background, and a center-row marker color appearing only at the left edge, center, and right edge.\n- A single divider color fills the center column except for the center marker.\n- All remaining foreground pixels form the object to copy, entirely on the left side of the divider.\nRule\n- Keep the input unchanged.\n- For every object pixel, paint the pixel rotated 180 degrees around the center marker with the same color.\nKey insight\n- The center marker is the rotation center; the yellow-looking divider is not mirrored, it only separates the source from the empty target side.",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3534:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:43382:        "src": "colored foreground object pixels excluding the center-column divider and center-row markers",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3535:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:43383:        "transform": "copy each source pixel to its 180-degree point-reflection through the center marker, preserving the original pixels, divider, and markers"
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3536:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:43394:        "object:marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3537:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:43450:        "marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3538:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:43451:        "markers",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3539:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:43504:      "docstring": "Copy the unique colored sprite tile into every tiled cell marked by an internal separator-colored pixel.\n\nInput structure\n- Full same-color separator rows and columns partition the grid into equal rectangular tiles.\n- One tile contains the only non-background, non-separator colored sprite.\n- Target tiles are otherwise background-colored but contain at least one internal pixel of the separator color.\n\nRule\n- Keep the separator lines and the source sprite tile unchanged.\n- Replace each marked target tile with an exact copy of the source tile.\n- Unmarked background-only tiles remain unchanged.\n\nKey insight\n- The internal separator-colored pixels are placement markers; the single colored tile is the template to stamp into those marked cells.",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3540:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:43509:        "dst": "marked background tile d containing an internal separator-colored marker pixel",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3541:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:43511:        "transform": "replace d with an exact copy of s, erasing the marker"
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3542:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:43523:        "object:marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3543:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:43568:        "marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3544:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:43569:        "markers",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3545:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:43623:      "docstring": "Reconstruct the repeated tile from its separated copies and mark the missing pixels in the damaged copy blue.\n\nInput structure:\n- The input is a lattice of equal-size blocks separated by one-cell solid rows\n  and columns of the same separator color.\n- All blocks are copies of one motif except exactly one block, where some\n  motif pixels have been overwritten by the motif background color.\n- Blue is absent from the input and is reserved as the output marker color.\n\nRule:\n- Recover the motif by taking the unique majority color at each local block\n  coordinate across all block copies.\n- Find the single block that differs from this consensus motif.\n- Return the consensus motif, recoloring the differing local coordinates blue.\n\nKey insight:\n- The repeated copies provide redundancy: the damaged positions are exactly\n  the coordinates where the lone nonconforming copy has background instead of\n  the consensus motif color.",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3546:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:43640:        "object:marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3547:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:43694:        "marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3548:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:43754:      "docstring": "Assemble the foreground objects by docking equal-colored boundary markers edge-to-edge.\n\nInput structure\nThe grid has a dominant background color and several 4-connected multicolor foreground\nobjects.  One foreground color is the body color; the less frequent foreground colors are\nboundary connector markers, and each marker color appears once as a free end or twice as a\nmatched docking pair.\n\nRule\nCrop each foreground object to its bounding box and translate the objects so that the two\noccurrences of every paired connector color touch on their exposed boundary sides.  Preserve\neach object's orientation and colors, then return the tight crop around the assembled\nforeground on the original background color.\n\nKey insight\nThe colored marker pixels are ports: matching colors specify which objects must touch, and\nthe marker's side of its object determines the direction of the translation.",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3549:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:43758:        "src": "4-connected foreground object sprite s with boundary connector markers",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3550:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:43759:        "dst": "matching boundary connector marker d on another sprite",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3551:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:43760:        "match_cond": "s.marker.color == d.marker.color and the two marker pixels have opposite exposed sides",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3552:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:43761:        "transform": "translate sprites so each paired marker touches edge-to-edge; preserve sprite colors and orientation",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3553:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:43768:        "catalog:marker_pixels",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3554:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:43777:        "object:marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3555:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:43832:        "marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3556:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:43833:        "markers",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3557:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:44017:      "docstring": "Keep only the lower-panel colors named by the top markers and expand each marker into an object-count bar.\n\nInput structure\nA black instruction strip sits above a non-black rectangular scene panel.  The strip contains one-cell markers\nin the first column, and each marker color is a candidate object color in the lower panel.  The lower panel has\na unique dominant background color and scattered 4-connected foreground objects.\n\nRule\nIn the lower panel, preserve objects whose colors appear as top markers and recolor every other foreground\nobject to the panel background.  In the instruction strip, replace each marker by a horizontal run from column 0\nwhose length is the number of 4-connected lower-panel objects of that marker color; erase markers with count 0.\n\nKey insight\nThe top strip is a color filter plus a compact count summary: marker colors select which lower-panel objects\nsurvive, and their bars report the number of surviving objects by color.",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3558:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:44022:        "dst": "top-strip pixel d in the same-color marker row",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3559:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:44023:        "match_cond": "s.color == d.row_marker_color",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3560:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:44036:        "object:marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3561:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:44088:        "marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3562:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:44089:        "markers",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3563:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:44110:        "row_marker_color",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3564:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:44421:      "docstring": "Reorder the vertical color-major blocks while preserving every block's internal pixels.\n\nInput structure\nThe grid is divided into vertical blocks, each with a unique dominant color.\nSmall marker pixels from other block colors may appear inside the blocks.\n\nRule\nIf adjacent shared-color marker rows read exactly as the current block order\nfrom right to left, reverse the blocks. Otherwise move the leftmost block to\nthe far right and shift the remaining blocks left.\n\nKey insight\nThe transformation acts on whole vertical blocks, so marker pixels move with\ntheir source block instead of being recolored or independently rearranged.",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3565:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:44425:        "src": "vertical color-major blocks s, including their internal marker pixels",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3566:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:44429:        "multi_step": "default order is a one-block left shift; if adjacent shared-color marker rows read the current block colors right-to-left, use reverse order"
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3567:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:44433:        "catalog:marker_pixels",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3568:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:44440:        "object:marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3569:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:44493:        "marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3570:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:44821:      "docstring": "Reorient each two-pixel blue/pink segment so it reads pink then blue when viewed from its border marker.\n\nInput structure\n- The background is dominant, with one border-only marker color and blue/pink foreground segments.\n- Every marker lies on the outer border and points inward along its row or column.\n- Along exactly one inward ray from each marker is a single adjacent two-pixel blue/pink segment.\n\nRule\n- For each marker, look inward perpendicular to the border side containing the marker.\n- Rewrite the two blue/pink pixels on that ray so the nearer one is pink and the farther one is blue.\n- Keep marker pixels, background pixels, and all other pixels unchanged.\n\nKey insight\n- The marker gives a local viewing direction; the segment's required order is relative to that marker, not to global row or column order.",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3571:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:44825:        "src": "border marker pixel s",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3572:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:44832:        "catalog:marker_pixels",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3573:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:44838:        "object:marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3574:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:44884:        "marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3575:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:44940:      "docstring": "Build the woven rectangle determined by the two marked cells on each crossed bar.\n\nInput structure\nA black-background grid contains one long horizontal bar and one long vertical bar.\nEach bar has a dominant base color and exactly two same-colored marker pixels.\n\nRule\nThe horizontal marker pair gives the output column span.  From the horizontal bar\nrow, walk toward the farther vertical marker; rows and columns alternate every\nother cell.  Even step/even offset cells use the horizontal marker color until\nthe nearer vertical marker is reached, then use the vertical marker color.\nOdd row steps use the horizontal base on marker columns and the original\ncrossing color on spacer columns.  Spacer columns on even row steps use the\nvertical base, except at the switch row where they use the crossing color.\n\nKey insight\nThe original cross cell records which base color wins at base/base lattice\ncrossings; the nearer vertical marker is the color-switch boundary.",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3576:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:44944:        "src": "one horizontal bar and one vertical bar crossing on the background; each bar has a dominant base color and exactly two same-colored marker pixels",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3577:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:44945:        "transform": "replace the scene with the woven rectangle whose columns span the horizontal marker pair and whose rows run from the horizontal bar to the farther vertical marker; alternate rows and columns every other cell, switch marker color at the nearer vertical marker, and use the original crossing color at base/base lattice intersections"
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3578:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:44949:        "catalog:marker_pixels",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3579:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:44955:        "object:marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3580:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:45005:        "marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3581:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:45352:      "docstring": "Crop out the grid half containing the two aligned marker pixels, then erase the markers to background.\n\nInput structure\n- The grid has a dominant background color and one non-background marker color\n  that appears as exactly two cells.\n- The marker cells are aligned either in one row or one column and both lie\n  in the same half along that direction.\n- Other non-background pixels are content inside one or both halves.\n\nRule\n- If the markers share a row, keep the left or right half whose columns\n  contain them.\n- If the markers share a column, keep the top or bottom half whose rows\n  contain them.\n- In the kept half, recolor the marker pixels to the background color.\n\nKey insight\n- The two marker pixels are not part of the picture; their alignment and\n  half-position identify which half of the doubled canvas is the answer.",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3582:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:45356:        "src": "half-grid region containing the two aligned marker pixels",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3583:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:45357:        "transform": "crop to that half; use row-aligned markers to choose left/right and column-aligned markers to choose top/bottom, then recolor marker pixels to bg",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3584:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:45358:        "grid_shape": "same height and half width for row-aligned markers; half height and same width for column-aligned markers"
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3585:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:45365:        "catalog:marker_pixels",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3586:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:45371:        "object:marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3587:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:45431:        "marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3588:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:45432:        "markers",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3589:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:45754:      "docstring": "Replace each colored corner marker with its corner-specific inward stencil in the same color.\n\nInput structure\n- The grid is 8x8 with a single dominant background color.\n- Foreground pixels are marker pixels, each located at one of the four corners.\n- A marker's color is carried to the stencil selected by its corner position.\n\nRule\n- Erase each corner marker back to the background.\n- Top corner markers become an inward 2x2 block one cell away from the top and side edges.\n- Bottom corner markers become the mirrored three-pixel inward bent stencil shown by the bottom-corner examples.\n\nKey insight\n- The marker position selects the fixed stencil; the marker color only supplies the paint color, so multiple corners apply independently.",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3590:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:45758:        "src": "colored marker pixels at the four corners of the 8x8 grid",
