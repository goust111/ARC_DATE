/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3012:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:10962:        "marker_color",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3013:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:10963:        "markers",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3014:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:11166:      "docstring": "Stamp source sprites into a destination frame via color-matched singleton markers.\n\nInput structure:\n- Two bordered rectangles: source (multi-cell sprites) and destination (singleton markers).\n- Each sprite has an anchor pixel — its least-frequent color. Markers share these colors.\n\nRule:\n- Match each destination marker to the source sprite with the same anchor color.\n- Translate the sprite so its anchor overlaps the marker position.\n- Output is the destination rectangle, interior cleared before stamping.\n\nKey insight: The rarest color per sprite doubles as a template key and positioning anchor.",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3015:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:11171:        "dst": "anchored on singleton marker pixel d inside the destination framed rectangle",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3016:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:11186:        "object:marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3017:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:11230:        "marker",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3018:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:11231:        "markers",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3019:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:11417:      "docstring": "Assemble and place enlarged sprites on a canvas using legend-panel instructions.\n\nInput structure:\n- Color-6 separators divide the grid into a left legend column and a main canvas.\n- Each legend panel has (top to bottom): a unit sprite, a frame template, a 5x5 bordered square with a position-marker pixel, and a 3x3 rotation clock-hand.\n\nRule:\n- Tile the unit sprite into each active cell of the frame to build an enlarged composite.\n- Rotate the composite per the clock-hand direction (up=0, right=90, down=180, left=270 degrees).\n- Place it on the canvas anchored at the position encoded by the marker pixel's row/col in the bordered square's 3x3 inner grid.\n\nKey insight: The marker pixel's position in a 3x3 grid jointly encodes vertical and horizontal anchor alignment (start/middle/end).",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3020:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:11420:        "summary": "Use four legend icons on the left to construct a large sprite by combining unit sprite with frame shape, then place it on background at position and rotation indicated by position marker and rotation marker.",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3021:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:11428:        "symbol_instructions": "legend row 1: unit sprite pattern; legend row 2: frame shape template; legend row 3: position marker (pixel location in small square indicates anchor on background); legend row 4: rotation indicator (clock-hand style determines rotation angle)",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3022:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:11429:        "multi_step": "Step 1: read four legend icons from left column; Step 2: construct enlarged sprite by tiling unit sprite into frame shape; Step 3: determine placement position from position marker; Step 4: determine rotation from rotation marker; Step 5: place rotated enlarged sprite at indicated position on background",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3023:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:11441:        "match_cond2": "s2.anchor == position indicated by marker pixel in legend row 3 square; s2.rotation == rotation indicated by clock-hand marker in legend row 4",
/home/lixinyu/snap/a/key_combo/code/fable/2/015/codegen_5.skill_011_020.log:3024:/home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/arc_reference_index.json:11462:        "object:marker",
