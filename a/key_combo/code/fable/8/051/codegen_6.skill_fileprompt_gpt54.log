+def _segment_cells(shape: tuple[int, int], anchor: tuple[int, int], orientation: str, length: int) -> list[tuple[int, int]] | None:
+    h, w = shape
+    r, c = anchor
+    if orientation == "H":
+        for start in range(c - length + 1, c + 1):
+            cells = [(r, start + k) for k in range(length)]
