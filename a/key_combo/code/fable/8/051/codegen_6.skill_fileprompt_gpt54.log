diff --git a/key_combo/code/fable/8/051/6.py b/key_combo/code/fable/8/051/6.py
new file mode 100644
index 0000000000000000000000000000000000000000..6f3af7496decd428c320c85f6e823fb24e5dd5a6
--- /dev/null
+++ b/key_combo/code/fable/8/051/6.py
@@ -0,0 +1,638 @@
+import numpy as np
+
+
+BG_COLOR = 0
+SPRITE_COLOR = 2
+WALL_COLOR = 5
+MARKER_COLOR = 8
+
+DIRS = {
+    "U": (-1, 0),
+    "R": (0, 1),
+    "D": (1, 0),
+    "L": (0, -1),
+}
+
+OPPOSITE = {"U": "D", "D": "U", "L": "R", "R": "L"}
+
+GRID_H_RANGE = (12, 19)
+GRID_W_RANGE = (12, 19)
+STEP_COUNT_RANGE = (3, 7)
+STEP_DISTANCE_RANGE = (2, 7)
+MAX_ATTEMPTS = 500
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    out: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            out.append(np.array(coords, dtype=int))
+    return out
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _parse_objects(grid: np.ndarray) -> dict:
+    g = np.asarray(grid, dtype=int)
+    bg = _get_bg(g)
+    colors = [int(x) for x in np.unique(g) if int(x) != bg]
+    assert colors, "expected foreground objects"
+
+    sprite_candidates = []
+    marker_candidates = []
+    wall_candidates = []
+    for color in colors:
+        comps = _components(g == color)
+        sizes = [len(comp) for comp in comps]
+        if len(comps) == 1 and sizes == [4]:
+            r0, c0, r1, c1 = _bbox(comps[0])
+            if (r1 - r0 + 1, c1 - c0 + 1) == (2, 2):
+                sprite_candidates.append((color, r0, c0))
+                continue
+        if comps and all(size == 1 for size in sizes):
+            marker_candidates.append(color)
+            continue
