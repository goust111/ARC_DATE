+                        if direction in ("U", "D"):
+                            block_cell = (wall_coord, line)
+                            marker_cell = (marker_coord, line)
+                            orientations = ("H", "V")
+                        else:
+                            block_cell = (line, wall_coord)
+                            marker_cell = (line, marker_coord)
+                            orientations = ("V", "H")
+                        if grid[marker_cell] != BG_COLOR or grid[block_cell] != BG_COLOR:
+                            continue
+                        for orientation in orientations:
