+def _search_trail_leftover(
+    rng: np.random.Generator,
+    grid: np.ndarray,
+    base_sequence: list[tuple[int, int]],
+    *,
+    require_multi_visible: bool,
+) -> np.ndarray | None:
+    h, w = grid.shape
+    empties = [(r, c) for r in range(h) for c in range(w) if grid[r, c] == BG_COLOR]
