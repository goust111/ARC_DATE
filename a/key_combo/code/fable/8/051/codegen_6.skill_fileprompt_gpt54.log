+import numpy as np
+
+
+BG_COLOR = 0
+SPRITE_COLOR = 2
+WALL_COLOR = 5
+MARKER_COLOR = 8
+
+DIRS = {
+    "U": (-1, 0),
+    "R": (0, 1),
+    "D": (1, 0),
+    "L": (0, -1),
+}
+
+OPPOSITE = {"U": "D", "D": "U", "L": "R", "R": "L"}
