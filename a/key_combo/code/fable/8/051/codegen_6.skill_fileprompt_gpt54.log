0006: def main(grid: np.ndarray) -> np.ndarray:
0007:     """
0008:     Draw a foreground-color rectangular frame just inside the four marker pixels.
0009: 
0010:     Input structure:
0011:     - The grid has a dominant background color, one foreground drawing color, and one marker color.
0012:     - The marker color appears exactly four times, with unique top, bottom, left, and right extrema.
0013:     - The foreground drawing color is the only non-background, non-marker color.
0014: 
0015:     Rule:
0016:     - Use the min/max marker rows and columns as outside guides.
0017:     - Paint the rectangle border from one row/column inside those marker extrema in the foreground color.
0018:     - Preserve all existing pixels, including the markers and the original foreground object.
0019: 
0020:     Key insight:
0021:     - The four markers are control pixels for the frame sides; the existing foreground object supplies the color to draw with.
0022:     """
0023:     g = np.asarray(grid, dtype=int)
0024:     assert g.ndim == 2, "expected a 2D grid"
0025: 
0026:     bg = get_bg(g)
0027:     colors = colors_present(g, exclude={bg})
0028:     counts = {color: int(np.sum(g == color)) for color in colors}
0029:     marker_candidates = [color for color, count in counts.items() if count == 4]
0030:     assert len(marker_candidates) == 1, "expected exactly one four-pixel marker color"
0031:     marker = marker_candidates[0]
0032: 
0033:     draw_colors = [color for color in colors if color != marker]
0034:     assert len(draw_colors) == 1, "expected exactly one foreground drawing color"
0035:     draw_color = draw_colors[0]
0036: 
0037:     marker_coords = np.argwhere(g == marker)
0038:     assert marker_coords.shape == (4, 2), "expected four marker pixels"
0039:     rows = marker_coords[:, 0]
0040:     cols = marker_coords[:, 1]
0041:     assert np.sum(rows == rows.min()) == 1, "expected a unique top marker"
0042:     assert np.sum(rows == rows.max()) == 1, "expected a unique bottom marker"
0043:     assert np.sum(cols == cols.min()) == 1, "expected a unique left marker"
0044:     assert np.sum(cols == cols.max()) == 1, "expected a unique right marker"
0045: 
0046:     r0 = int(rows.min()) + 1
0047:     r1 = int(rows.max()) - 1
0048:     c0 = int(cols.min()) + 1
0049:     c1 = int(cols.max()) - 1
0050:     height, width = map(int, g.shape)
0051:     assert 0 <= r0 < r1 < height, "marker rows must enclose a nonempty frame"
0052:     assert 0 <= c0 < c1 < width, "marker columns must enclose a nonempty frame"
0053: 
0054:     frame_mask = np.zeros_like(g, dtype=bool)
0055:     frame_mask[r0, c0 : c1 + 1] = True
0056:     frame_mask[r1, c0 : c1 + 1] = True
0057:     frame_mask[r0 : r1 + 1, c0] = True
0058:     frame_mask[r0 : r1 + 1, c1] = True
0059:     assert not np.any(g[frame_mask] == marker), "frame must not overwrite markers"
0060: 
0061:     out = g.copy()
0062:     out[frame_mask] = draw_color
0063:     return out
