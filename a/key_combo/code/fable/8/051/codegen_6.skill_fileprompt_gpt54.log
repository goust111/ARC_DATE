0007: def main(grid: np.ndarray) -> np.ndarray:
0008:     """Paint every background cell on the same row/column parity lattice as the single colored marker.
0009: 
0010:     Input structure
0011:     - A 2D grid containing black background pixels, grey fixed pixels, and exactly one non-grey/non-black colored marker pixel.
0012: 
0013:     Rule
0014:     - The marker's row parity and column parity define the selected lattice.
0015:     - Recolor each black background pixel with the marker color iff both its row parity and column parity match the marker.
0016:     - Leave grey pixels and all background pixels on the other three parity lattices unchanged.
0017: 
0018:     Key insight
0019:     - The marker is copied by coordinate parity, not by connectivity through the grey layout.
0020:     """
0021:     g = np.asarray(grid, dtype=int)
0022:     assert g.ndim == 2
0023: 
0024:     colors = set(colors_present(g))
0025:     assert Color.BLACK in colors
0026:     assert Color.GREY in colors
0027:     marker_colors = colors - {Color.BLACK, Color.GREY}
0028:     assert len(marker_colors) == 1
0029:     marker_color = marker_colors.pop()
0030: 
0031:     marker_coords = np.argwhere(g == marker_color)
0032:     assert marker_coords.shape[0] == 1
0033:     marker_r, marker_c = marker_coords[0]
0034: 
0035:     rr, cc = np.indices(g.shape)
0036:     same_parity = (rr % 2 == marker_r % 2) & (cc % 2 == marker_c % 2)
0037: 
0038:     out = g.copy()
0039:     out[(g == Color.BLACK) & same_parity] = marker_color
0040:     return out
