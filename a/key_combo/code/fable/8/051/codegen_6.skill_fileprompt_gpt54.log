+
+def _sprite_mask(shape: tuple[int, int], pos: tuple[int, int]) -> np.ndarray:
+    r, c = pos
+    mask = np.zeros(shape, dtype=bool)
+    mask[r : r + 2, c : c + 2] = True
+    return mask
+
+
+def _sweep_mask(shape: tuple[int, int], pos0: tuple[int, int], pos1: tuple[int, int]) -> np.ndarray:
+    r0, c0 = pos0
+    r1, c1 = pos1
+    mask = np.zeros(shape, dtype=bool)
+    if r0 == r1:
+        lo = min(c0, c1)
+        hi = max(c0, c1)
+        mask[r0 : r0 + 2, lo : hi + 2] = True
+    else:
+        lo = min(r0, r1)
+        hi = max(r0, r1)
+        mask[lo : hi + 2, c0 : c0 + 2] = True
+    return mask
+
+
+def _landing_pos(sprite_pos: tuple[int, int], direction: str, marker: tuple[int, int]) -> tuple[int, int]:
+    r, c = sprite_pos
+    mr, mc = marker
+    if direction == "U":
+        return mr, c
+    if direction == "D":
+        return mr - 1, c
+    if direction == "L":
+        return r, mc
+    return r, mc - 1
+
+
+def _visible_candidates(
+    shape: tuple[int, int],
+    sprite_pos: tuple[int, int],
+    walls: np.ndarray,
+    trail: np.ndarray,
+    markers: set[tuple[int, int]],
+    use_walls: bool,
+    use_trail: bool,
+) -> list[dict]:
+    h, w = shape
+    r, c = sprite_pos
+    blockers = np.zeros(shape, dtype=bool)
+    if use_walls:
+        blockers |= walls
+    if use_trail:
+        blockers |= trail
+
+    candidates: list[dict] = []
+
+    for cc in (c, c + 1):
+        rr = r - 1
+        while rr >= 0:
+            cell = (rr, cc)
+            if blockers[cell]:
+                break
+            if cell in markers:
+                candidates.append({"marker": cell, "direction": "U", "distance": r - rr})
+                break
+            rr -= 1
+
+    for cc in (c, c + 1):
+        rr = r + 2
+        while rr < h:
+            cell = (rr, cc)
+            if blockers[cell]:
+                break
+            if cell in markers:
+                candidates.append({"marker": cell, "direction": "D", "distance": rr - (r + 1)})
+                break
+            rr += 1
+
+    for rr in (r, r + 1):
+        cc = c - 1
+        while cc >= 0:
+            cell = (rr, cc)
+            if blockers[cell]:
+                break
+            if cell in markers:
+                candidates.append({"marker": cell, "direction": "L", "distance": c - cc})
+                break
+            cc -= 1
+
+    for rr in (r, r + 1):
+        cc = c + 2
+        while cc < w:
+            cell = (rr, cc)
+            if blockers[cell]:
