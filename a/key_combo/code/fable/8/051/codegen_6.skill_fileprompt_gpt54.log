+            if cell in markers:
+                candidates.append({"marker": cell, "direction": "R", "distance": cc - (c + 1)})
+                break
+            cc += 1
+
+    dedup: dict[tuple[int, int], dict] = {}
+    for candidate in candidates:
+        dedup[candidate["marker"]] = candidate
+    return list(dedup.values())
