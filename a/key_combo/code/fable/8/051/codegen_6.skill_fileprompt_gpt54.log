+        r, c = sprite_pos
+        rays = [
+            ("U", (c, c + 1), range(r - 1, -1, -1)),
+            ("D", (c, c + 1), range(r + 2, h)),
+            ("L", (r, r + 1), range(c - 1, -1, -1)),
+            ("R", (r, r + 1), range(c + 2, w)),
+        ]
+        rng.shuffle(rays)
