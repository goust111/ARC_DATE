+    out[sr : sr + 2, sc : sc + 2] = info["sprite_color"]
+
+    return {
+        "valid": True,
+        "output": out,
+        "states": states,
+        "steps": steps,
+        "consumed": consumed,
+        "remaining": markers,
+        "trail": trail,
+        "walls": walls,
+        "sprite_color": info["sprite_color"],
+        "marker_color": info["marker_color"],
+        "wall_color": info["wall_color"],
