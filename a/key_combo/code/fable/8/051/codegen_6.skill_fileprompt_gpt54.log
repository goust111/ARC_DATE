+                            return trial
+    return None
+
+
+def _search_filler_wall(rng: np.random.Generator, grid: np.ndarray) -> np.ndarray | None:
+    h, w = grid.shape
+    empties = [(r, c) for r in range(h) for c in range(w) if grid[r, c] == BG_COLOR]
