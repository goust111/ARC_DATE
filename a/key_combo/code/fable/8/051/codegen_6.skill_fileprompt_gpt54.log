+
+
+def _simulate(grid: np.ndarray, *, use_trail: bool = True, use_walls: bool = True) -> dict:
+    g = np.asarray(grid, dtype=int)
+    info = _parse_objects(g)
+    h, w = g.shape
+    sprite_pos = info["sprite_pos"]
+    walls = info["walls"]
+    markers = set(info["markers"])
