+    analysis = _simulate(grid)
+    if not analysis["valid"]:
+        return None
+    if analysis["consumed"] != markers:
+        return None
+    dirs = {step["direction"] for step in analysis["steps"]}
+    dists = {step["distance"] for step in analysis["steps"]}
+    if len(dirs) < 2 or len(dists) < 2:
+        return None
+    return grid
