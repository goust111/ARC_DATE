+    else:
+        for start in range(r - length + 1, r + 1):
+            cells = [(start + k, c) for k in range(length)]
+            if cells[0][0] <= r <= cells[-1][0] and all(0 <= rr < h and 0 <= cc < w for rr, cc in cells):
+                return cells
+    return None
+
