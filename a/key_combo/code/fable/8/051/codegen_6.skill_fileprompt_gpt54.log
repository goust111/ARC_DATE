+            if cell in markers:
+                candidates.append({"marker": cell, "direction": "L", "distance": c - cc})
+                break
+            cc -= 1
+
+    for rr in (r, r + 1):
+        cc = c + 2
+        while cc < w:
+            cell = (rr, cc)
+            if blockers[cell]:
