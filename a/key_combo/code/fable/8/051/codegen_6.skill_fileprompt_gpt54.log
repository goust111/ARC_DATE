+                            for cell in segment:
+                                without_walls[cell] = BG_COLOR
+                            changed = _simulate(without_walls)
+                            if not changed["valid"]:
+                                continue
+                            if marker_cell not in changed["consumed"] and np.array_equal(changed["output"], analysis["output"]):
