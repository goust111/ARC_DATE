+    assert g.ndim == 2, "expected a 2D grid"
+    assert set(map(int, np.unique(g))) <= {BG, IN_COLOR}, "expected only black and red input pixels"
+    coords = np.argwhere(g != BG)
+    assert len(coords) > 0, "expected foreground sprites"
