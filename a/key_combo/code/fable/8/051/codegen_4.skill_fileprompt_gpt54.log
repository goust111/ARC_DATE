+
+def _axis_partitions(indices: np.ndarray, axis_len: int, band_count: int) -> list[tuple[int, ...]]:
+    if indices.size == 0:
+        return []
+    used = sorted(set(int(x) for x in indices.tolist()))
+    out: list[tuple[int, ...]] = []
