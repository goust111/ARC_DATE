        reflected = np.fliplr(mask)
        top = int(r0)
        left = c1 + GEN_REFLECTION_GAP + 1 if side == "left" else int(c0) - w - GEN_REFLECTION_GAP
        return reflected, top, left, int(Color.BLUE)

