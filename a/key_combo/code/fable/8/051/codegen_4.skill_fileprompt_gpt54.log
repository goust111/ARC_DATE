  grid: 13-15 rows x 13-17 cols
  colors: exactly 3 — black (background), grey (obstacle), one marker color (any non-black non-grey)
  grey_pixels:
    density: 30-45% of grid
    structure: 2-5 connected blobs (8-conn), forming irregular thick clusters concentrated toward edges/corners
    border_density: 55-67% of perimeter cells are grey [observed]
    no_full_rows_or_cols: no row or column is entirely grey [observed]
  marker:
    count: exactly 1 pixel of the marker color
    placement: on a black cell with all 4 cardinal neighbors also black; Manhattan distance >= 3 to nearest grey
    must_be_in_main_open_component: the largest 4-connected non-grey region (55-85 cells for 13x13 up to ~150 for 15x17)
  open_region:
