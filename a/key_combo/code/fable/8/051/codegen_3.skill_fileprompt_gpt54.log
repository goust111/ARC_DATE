  "dst": "reference color column d established by the topmost row bar",
  "match_cond": "s.left_color == d.color",
  "transform": "translate s horizontally so its left color lands in d; clear vacated cells to background"
}
</annotation>
<generation_spec>
```yaml
spec:
  grid: 4-6 rows x 4-6 cols, W >= bar_col + 3 (room for shifted bar)
  background: single color filling all non-bar cells
  bars:
    count: 3-6 contiguous rows, each containing exactly one 2-pixel horizontal bar
    colors: exactly 2 distinct foreground colors, same pair on every row
    position: all bars start at the same column (bar_col) in input
    orientation: strictly alternating - odd-indexed bars are reversed (colors swapped)
    first_bar_row: 0-1 (top padding 0-1 rows) [observed]
    last_bar_row: H-1 minus 0-1 (bottom padding 0-1 rows) [observed]
    top_pad == bottom_pad [observed]
  output_transform:
    reference: topmost bar defines color-to-column mapping (colorA at bar_col, colorB at bar_col+1)
    action: reversed bars shift right by 1 so each color aligns with its reference column
    result: reversed bars occupy (bar_col+1, bar_col+2); same-orientation bars stay put
    vacated cell becomes background

generation_strategy:
  approach: output-first
  steps:
    1. Pick H in [4..6], W in [4..6]; pick bg color and 2 distinct fg colors (colorA, colorB)
    2. Pick bar_count in [3..6] such that bar_count <= H; center bars vertically with equal padding (0-1 rows)
    3. Pick bar_col in [0..W-3] (need bar_col+2 < W for the shifted bar)
    4. Build output grid filled with bg; for each bar row i (0-indexed among bars):
       - if i even: place [colorA, colorB] at (bar_col, bar_col+1)
       - if i odd:  place [colorB, colorA] at (bar_col+1, bar_col+2) -- the shifted position
    5. Derive input by moving all odd-indexed bars back to (bar_col, bar_col+1), keeping their reversed color order [colorB, colorA]
