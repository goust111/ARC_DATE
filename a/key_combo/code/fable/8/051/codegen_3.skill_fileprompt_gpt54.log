+def _row_blocks(mask: np.ndarray) -> list[tuple[int, int]]:
+    rows = np.flatnonzero(mask)
+    if rows.size == 0:
+        return []
+    blocks: list[tuple[int, int]] = []
+    start = prev = int(rows[0])
+    for value in rows[1:]:
+        row = int(value)
+        if row == prev + 1:
+            prev = row
+            continue
+        blocks.append((start, prev))
+        start = prev = row
+    blocks.append((start, prev))
+    return blocks
