  grid: 12-15 rows x 13-15 cols
  colors:
    bg: 0 (black)
    marker: 5 (gray), always exactly 4 pixels [observed]
    draw: one non-bg, non-marker color (any except 0 and 5)
  markers:
    count: exactly 4 pixels of marker color
    extrema: unique top-most, bottom-most, left-most, right-most pixel
    each marker col/row falls strictly inside the opposite axis's frame range
    grid_margin: >=0 cells from grid edge (usually >=1) [observed]
  frame:
    bounds: 1 cell inside marker row/col extrema on each side
    size: 9-11 rows x 8-10 cols [observed]
    must not overlap any marker pixel
  foreground_object:
