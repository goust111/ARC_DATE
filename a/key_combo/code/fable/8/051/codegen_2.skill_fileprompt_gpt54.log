  78:                         lo, hi = sorted((c, cc))
  79:                         out[r, lo : hi + 1] = control_color
  80:                         hits.add((r, cc))
  81:                         break
  82:                     cc += dc
  83: 
  84:     assert hits
  85:     for r, c in hits:
  86:         assert 0 < r < H - 1
  87:         assert 0 < c < W - 1
  88:         out[r - 1 : r + 2, c - 1 : c + 2] = bar_color
  89:         out[r, c] = control_color
