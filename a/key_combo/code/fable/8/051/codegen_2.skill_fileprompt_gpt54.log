+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BG = 0
+FRAME = 5
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+GEN_MAX_ATTEMPTS = 500
+GEN_CANVAS_RANGE = (18, 26)
+GEN_PIECE_COUNT_CHOICES = (3, 4)
+GEN_INTERIOR_SHAPES = {
+    3: ((4, 5), (5, 4), (5, 5), (4, 6), (6, 4)),
+    4: ((4, 4), (4, 5), (5, 4), (4, 6), (6, 4)),
+}
+GEN_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
