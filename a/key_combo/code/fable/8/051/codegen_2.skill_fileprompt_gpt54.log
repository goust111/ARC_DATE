  transform:
    sort_fragments: by decreasing area, ties broken left-to-right in input
    packing: for each fragment try all 8 orientations (identity/rot/reflect), scan placements top-left to bottom-right; backtrack until rectangle is filled
    colors_preserved: each fragment keeps its original color

generation_strategy:
  approach: output-first
