+
+def _side_rows(height: int, vertical_side: str) -> list[int]:
+    rows = [r for r in range(1, height - 1) if 2 * r != height - 1]
+    if vertical_side == "U":
+        return [r for r in rows if 2 * r < height - 1]
+    return [r for r in rows if 2 * r > height - 1]
+
