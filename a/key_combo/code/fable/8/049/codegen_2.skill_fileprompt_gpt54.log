+    a: tuple[int, int, int],
+    b: tuple[int, int, int],
+    shape: tuple[int, int],
+) -> tuple[bool, bool]:
+    ra, ca, _ = a
+    rb, cb, _ = b
+    height, width = map(int, shape)
+    h_ok = cb < ca if _horizontal_dir(ca, width) < 0 else cb > ca
+    v_ok = ra < rb if _vertical_dir(rb, height) < 0 else ra > rb
+    return bool(h_ok), bool(v_ok)
