+    dims = [(h, w) for h in range(2, 6) for w in range(2, 6) if 4 <= h * w <= 16]
+    h1, w1 = random.choice(dims)
+    h2, w2 = random.choice(dims)
+    if (h1, w1) == (h2, w2):
+        return _choose_sizes()
+    return int(h1), int(w1), int(h2), int(w2)
