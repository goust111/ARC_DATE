  legends:
    count: 1-3 contiguous horizontal color runs on top/bottom edge rows
    length: 3-6 distinct non-bg colors per legend
    placement: each on row 0 or row H-1; multiple legends on same edge separated by >=7 bg cells
    colors: all unique within each legend; legends MAY share colors across legends
    total_legend_colors: 6-12 across all legends = all non-bg colors in grid
  markers:
    count: 3-6 isolated single-pixel foreground cells on interior rows (not on legend edge rows)
    color: each marker color appears in exactly one legend at exactly one position
    rows: each marker on a distinct row, or at most 2 markers share a row if from different legends [observed]
    no_overlap: when expanded, legend copies on same row must not collide
    clipping: 0-1 markers may expand beyond grid boundary (clipped) [observed]
  output:
