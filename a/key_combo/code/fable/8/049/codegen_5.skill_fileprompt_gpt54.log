+
+def _direction_toward(rect: dict[str, int], other: dict[str, int]) -> tuple[int, int]:
+    dr = 1 if int(other["r0"]) > int(rect["r1"]) else -1
+    dc = 1 if int(other["c0"]) > int(rect["c1"]) else -1
+    return int(dr), int(dc)
