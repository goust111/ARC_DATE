+def _trajectory_traces(
+    shape: tuple[int, int], rect: dict[str, int], dr: int, dc: int
+) -> tuple[list[np.ndarray], int]:
+    height, width = map(int, shape)
+    r = int(rect["r0"])
+    c = int(rect["c0"])
+    h = int(rect["h"])
+    w = int(rect["w"])
