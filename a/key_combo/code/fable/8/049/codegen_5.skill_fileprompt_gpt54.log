+    a, b = rects
+    rows_disjoint = int(a["r1"]) < int(b["r0"]) or int(b["r1"]) < int(a["r0"])
+    cols_disjoint = int(a["c1"]) < int(b["c0"]) or int(b["c1"]) < int(a["c0"])
+    assert rows_disjoint and cols_disjoint, "rectangle row and column intervals must both be disjoint"
