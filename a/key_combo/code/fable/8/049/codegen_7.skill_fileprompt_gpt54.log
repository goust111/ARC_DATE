+def _fill_frame_interior(out: np.ndarray, frame: dict, legend: tuple[int, ...]) -> None:
+    left = int(frame["c0"]) + 1
+    right = int(frame["c1"])
+    top = int(frame["r0"]) + 1
+    bottom = int(frame["r1"])
+    marker_c = int(frame["marker_c"])
+    anchor = int(frame["legend_idx"])
+    period = len(legend)
