 132: def _gen_columns(width: int, n_cols: int) -> list[int]:
 133:     parity = random.randint(0, 1)
 134:     track = list(range(parity, width, 2))
 135:     if n_cols >= len(track):
 136:         return track
 137: 
 138:     for _ in range(COLUMN_SPAN_TRIES):
 139:         n_spans = random.randint(1, min(MAX_COLUMN_SPANS, n_cols))
 140:         cuts = sorted(random.sample(range(1, n_cols), n_spans - 1))
 141:         lengths = [b - a for a, b in zip([0] + cuts, cuts + [n_cols])]
 142:         spans: list[tuple[int, int]] = []
 143:         used: set[int] = set()
 144:         ok = True
 145:         for length in lengths:
 146:             possible = [i for i in range(0, len(track) - length + 1)
 147:                         if not any(j in used for j in range(i, i + length))]
 148:             if not possible:
 149:                 ok = False
 150:                 break
 151:             start = random.choice(possible)
 152:             spans.append((start, length))
 153:             used.update(range(start, start + length))
 154:         if ok:
 155:             cols = [track[i] for start, length in spans for i in range(start, start + length)]
 156:             return sorted(cols)
 157:     return sorted(random.sample(track, n_cols))
