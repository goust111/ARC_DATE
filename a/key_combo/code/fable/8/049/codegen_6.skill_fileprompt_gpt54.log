   9: def find_solid_squares(
  10:     grid: np.ndarray,
  11:     *,
  12:     bg: int | None = None,
  13:     min_size: int = 2,
  14:     connectivity: int = 8,
  15: ) -> list[dict]:
  16:     """
  17:     Local helper (only used by this solver): find solid monochrome NxN squares (N>=min_size).
  18: 
  19:     Returns list of dicts:
  20:     - color: int
  21:     - size: int (N)
  22:     - bbox: (r0,c0,r1,c1)
