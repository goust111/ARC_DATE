   1: import numpy as np
   2: 
   3: from arc_utils import Color, bbox_coords, colors_present, components_mask, get_bg, paste, random_free_location
   4: import random
   5: 
   6: 
   7: def main(grid: np.ndarray) -> np.ndarray:
   8:     """
   9:     Erase the red rectangular outlines and recolor each enclosed black interior green.
  10: 
  11:     Input structure
  12:     - The grid has a black background and one foreground color, red.
  13:     - Red foreground components are 4-connected axis-aligned rectangles.
  14:     - A component is either a one-cell-thick hollow rectangular frame or a solid rectangle with no black interior.
  15: 
  16:     Rule
  17:     - Start from an all-background output grid of the same shape.
  18:     - For each hollow red rectangular frame, fill its strict bbox interior with green.
  19:     - Solid red rectangles and all red frame borders are erased to background.
  20: 
  21:     Key insight
  22:     - The red pixels only mark rectangular boundaries; the retained output is the background region enclosed by each boundary, recolored green.
  23:     """
  24:     g = np.asarray(grid, dtype=int)
  25:     assert g.ndim == 2, "expected a 2D grid"
  26: 
  27:     bg = get_bg(g)
  28:     assert bg == Color.BLACK, "expected black background"
  29:     foreground_colors = colors_present(g, exclude={bg})
  30:     assert foreground_colors == [Color.RED], "expected red to be the only foreground color"
  31: 
  32:     out = np.full_like(g, bg)
  33:     frame_count = 0
  34: 
  35:     for coords in components_mask(g == Color.RED, connectivity=4):
  36:         r0, c0, r1, c1 = bbox_coords(coords)
  37:         sub = g[r0 : r1 + 1, c0 : c1 + 1]
  38:         mask = sub == Color.RED
  39:         height, width = mask.shape
  40: 
  41:         if height >= 3 and width >= 3:
  42:             border = np.zeros_like(mask, dtype=bool)
  43:             border[0, :] = True
  44:             border[-1, :] = True
  45:             border[:, 0] = True
  46:             border[:, -1] = True
  47:             if np.array_equal(mask, border):
  48:                 out[r0 + 1 : r1, c0 + 1 : c1] = Color.GREEN
  49:                 frame_count += 1
  50:                 continue
  51: 
  52:         assert np.all(mask), "non-frame red components must be solid rectangles"
  53: 
  54:     assert frame_count > 0, "expected at least one hollow rectangular frame"
  55:     return out
  56: 
  57: # --------------- generator (o5x) ---------------
  58: # Canvas, component count, and component size bounds.
  59: GRID_SIZE_RANGE = (10, 25)
  60: FRAME_COUNT_RANGE, SOLID_COUNT_RANGE = (1, 3), (0, 1)
  61: FRAME_HEIGHT_RANGE, FRAME_WIDTH_RANGE = (3, 6), (3, 9)
  62: SOLID_SIZE = (2, 2)
  63: 
  64: # Placement policy and retry limit.
  65: FOOTPRINT_COLOR = 1
  66: PLACEMENT_OPTIONS = {"border": 0, "padding": 1, "padding_connectivity": 8}
  67: GENERATION_ATTEMPTS = 300
  68: 
  69: 
  70: def _gen_frame_patch(height: int, width: int) -> np.ndarray:
  71:     patch = np.full((height, width), Color.BLACK, dtype=int)
  72:     patch[0, :] = Color.RED
  73:     patch[-1, :] = Color.RED
  74:     patch[:, 0] = Color.RED
  75:     patch[:, -1] = Color.RED
  76:     return patch
  77: 
  78: 
  79: def _gen_expected_output(size: int, frame_boxes: list[tuple[int, int, int, int]]) -> np.ndarray:
  80:     out = np.full((size, size), Color.BLACK, dtype=int)
  81:     for r0, c0, height, width in frame_boxes:
  82:         out[r0 + 1 : r0 + height - 1, c0 + 1 : c0 + width - 1] = Color.GREEN
  83:     return out
  84: 
  85: 
  86: def _gen_component_specs() -> list[tuple[str, int, int]]:
  87:     """Return shuffled component specs while preserving the original draw order."""
  88:     frame_count = random.randint(*FRAME_COUNT_RANGE)
  89:     solid_count = random.randint(*SOLID_COUNT_RANGE)
  90:     components = [
  91:         ("frame", random.randint(*FRAME_HEIGHT_RANGE), random.randint(*FRAME_WIDTH_RANGE))
  92:         for _ in range(frame_count)
  93:     ]
  94:     components.extend(("solid", SOLID_SIZE[0], SOLID_SIZE[1]) for _ in range(solid_count))
  95:     random.shuffle(components)
  96:     return components
  97: 
  98: 
  99: def _gen_attempt() -> np.ndarray | None:
 100:     size = random.randint(*GRID_SIZE_RANGE)
