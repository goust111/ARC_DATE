 115: def _gen_content_rows(size: int, n_rows: int) -> list[int]:
 116:     gaps: list[int] = []
 117:     remaining_span = size - 1
 118:     for i in range(n_rows - 1):
 119:         remaining_gaps = n_rows - 2 - i
 120:         hi = min(ROW_GAP_MAX, remaining_span - remaining_gaps)
 121:         gap = random.randint(ROW_GAP_MIN, hi)
 122:         gaps.append(gap)
 123:         remaining_span -= gap
 124:     span = sum(gaps)
 125:     start = random.randint(0, size - 1 - span)
 126:     rows = [start]
 127:     for gap in gaps:
 128:         rows.append(rows[-1] + gap)
 129:     return rows
