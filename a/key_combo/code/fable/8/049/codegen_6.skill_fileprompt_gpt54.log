  56:     # horizontal line?
  57:     elif len(c_coordinates) == 1:
  58:         possible_orientations = [(1, 0), (-1, 0)]
  59:     else:
  60:         assert False, "Start object is not horizontal/vertical"
  61:     
  62:     # 2. Define the state space, initial state(s), successor function, and goal test
  63:     # A state is a tuple of (x, y, orientation)
  64:     # orientation is a tuple of (dx, dy)
  65:         
  66:     # Initially we begin at a point on the line, along the orientation of the line
  67:     initial_states = [(r, c, orientation)
  68:                       for r, c in np.argwhere(start_object == Color.GREEN)
  69:                       for orientation in possible_orientations]
