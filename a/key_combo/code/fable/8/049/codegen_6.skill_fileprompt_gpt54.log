  32:             if coords.size == 0:
  33:                 continue
  34:             r0, c0 = coords.min(axis=0)
  35:             r1, c1 = coords.max(axis=0)
  36:             h = int(r1 - r0 + 1)
  37:             w = int(c1 - c0 + 1)
  38:             if h < int(min_size) or h != w:
  39:                 continue
  40:             if int(coords.shape[0]) != int(h * w):
  41:                 continue
  42:             out.append(
  43:                 {
  44:                     "color": int(col),
  45:                     "size": int(h),
  46:                     "bbox": (int(r0), int(c0), int(r1), int(c1)),
  47:                     "coords": coords,
  48:                 }
  49:             )
  50:     return out
