+def _generate_case() -> Tuple[np.ndarray, np.ndarray, Tuple[int, int]]:
+    pr = random.randint(2, 5)
+    pc = random.randint(2, 5)
+    vr = random.randint(2, min(5, 30 // pr))
+    vc = random.randint(2, min(5, 30 // pc))
