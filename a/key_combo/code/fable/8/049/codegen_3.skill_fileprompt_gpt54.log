+def _sample_bar_columns(width: int, n_colors: int) -> list[int]:
+    for _ in range(200):
+        cols = sorted(random.sample(range(1, width - 1), n_colors))
+        if all(b - a >= 3 for a, b in zip(cols, cols[1:])):
+            return cols
