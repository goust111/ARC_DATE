+def _place_patch(
+    grid: np.ndarray,
+    blocked: np.ndarray,
+    patch: np.ndarray,
+    color: int,
+    field_bottom: int,
+) -> tuple[int, int] | None:
+    h, w = patch.shape
+    h_lim, w_lim = grid.shape
+    for _ in range(400):
+        r0 = random.randint(1, field_bottom - h + 1)
+        c0 = random.randint(1, w_lim - w - 1)
+        rr0 = max(0, r0 - 1)
+        cc0 = max(0, c0 - 1)
+        rr1 = min(h_lim, r0 + h + 1)
+        cc1 = min(w_lim, c0 + w + 1)
