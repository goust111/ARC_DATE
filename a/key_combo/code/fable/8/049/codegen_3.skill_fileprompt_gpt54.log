+                "area": int(spec["area"]),
+                "coords": coords,
+                "bbox": _bbox(coords),
+                "keep": bool(spec["keep"]),
+                "bar_rank": int(spec["bar_rank"]),
+                "bar_col": int(spec["bar_col"]),
+            }
