+            return None
+        r0, c0 = placed
+        coords = np.argwhere(patch == 1) + np.array([r0, c0])
+        placed_specs.append(
+            {
+                "color": int(spec["color"]),
+                "area": int(spec["area"]),
+                "coords": coords,
+                "bbox": _bbox(coords),
+                "keep": bool(spec["keep"]),
+                "bar_rank": int(spec["bar_rank"]),
+                "bar_col": int(spec["bar_col"]),
