+            )
+        result[color] = {"components": objs}
+    return result
+
+
+def _split_roles(color_scene: dict[str, object]) -> tuple[dict[str, object], list[dict[str, object]]]:
+    comps = list(color_scene["components"])
+    bars = [comp for comp in comps if comp["touches_bottom"]]
