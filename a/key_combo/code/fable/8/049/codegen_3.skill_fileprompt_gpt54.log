  "type": "move_in_order",
  "src": "foreground color masks s ordered by decreasing bounding-box height",
  "dst": "top-aligned histogram columns d ordered left to right",
  "match_cond": "rank(s) == rank(d)",
  "transform": "fill each column with s.color for s.bbox.height cells from the top, leaving the rest as background",
  "grid_shape": "height is the largest foreground color bbox height; width is the number of foreground colors"
}
</annotation>
<generation_spec>
```yaml
spec:
  grid:
    input: 10-19 rows x 15-18 cols
    background: 0 (black)
  foreground_masks:
    count: 3-5 distinct non-background colors
    bbox_heights: all mutually distinct, each 1-6
    bbox_widths: 4-12 each
    fill_ratio: 0.57-1.0 (pixels / bbox area); not necessarily solid rectangles
    connectivity: each mask is 1-2 connected components [observed]
    placement: scattered across the grid; bounding boxes may overlap between colors
    total_fg_ratio: ~0.2-0.4 of grid cells are foreground [observed]
  output:
    rows: max(bbox_heights), cols: count(foreground_colors)
    columns sorted left-to-right by decreasing bbox_height
    each column filled top-aligned with its color for bbox_height cells, rest background

generation_strategy:
  approach: output-first
  steps:
    1. Pick N=3-5 foreground colors (distinct, non-zero).
    2. Pick N distinct bbox_heights in 1-6 (these define the output histogram).
    3. Build output grid (max_h x N) with columns sorted by decreasing height.
    4. Choose input grid size (10-19 rows x 15-18 cols, both >= max_h+4 and >= N+8).
    5. For each color, pick a random bbox_width (4-12, fitting in grid).
    6. Place each color mask in the input grid with the chosen bbox_height and bbox_width
       at a random position. Fill 55-100% of bbox cells with the color (rest stays background).
       Allow bounding boxes to overlap between different colors but ensure each color's
       bbox_height is exactly as chosen (min/max occupied rows span the full height).
    7. Verify all bbox_heights remain distinct after placement (overlaps can occlude pixels
       but each color must still span its intended height).
