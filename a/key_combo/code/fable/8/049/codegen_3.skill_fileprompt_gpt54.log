+        return False
+
+    wrong_strategies = [
+        "largest_only",
+        "smallest_only",
+        "bbox_height_rank",
+        "bbox_area_rank",
+        "top_rank",
+        "left_rank",
+        "nearest_bar_rank",
+    ]
+    for strategy in wrong_strategies:
+        if np.array_equal(_solve_with_strategy(grid, strategy), expected):
+            return False
+
+    return True
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(600):
+        built = _build_attempt()
+        if built is None:
+            continue
+        grid, expected = built
+        if _semantic_checks(grid, expected):
+            return grid
