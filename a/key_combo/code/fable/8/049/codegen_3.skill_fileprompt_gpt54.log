+    for color in colors:
+        count = counts[color]
+        rank = ranks[color]
+        areas = random.sample(range(4, 12), count)
+        target_area = sorted(areas, reverse=True)[rank - 1]
+        for area in areas:
+            object_specs.append(
+                {
+                    "color": color,
+                    "area": area,
+                    "patch": _random_connected_patch(area),
+                    "keep": area == target_area,
+                    "bar_rank": rank,
+                    "bar_col": color_to_bar_col[color],
+                }
+            )
