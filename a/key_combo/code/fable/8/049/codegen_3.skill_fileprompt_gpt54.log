+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r, c in np.argwhere(mask):
+        if seen[r, c]:
+            continue
+        q = deque([(int(r), int(c))])
+        seen[r, c] = True
+        pts = []
+        while q:
+            cr, cc = q.popleft()
+            pts.append((cr, cc))
+            for dr, dc in DIR4:
+                nr, nc = cr + dr, cc + dc
+                if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
