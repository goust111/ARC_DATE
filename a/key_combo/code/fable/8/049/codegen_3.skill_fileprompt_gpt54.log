+        return min(field, key=lambda obj: (int(obj["area"]), obj["bbox"][0], obj["bbox"][1]))
+    if strategy == "bbox_height_rank":
+        ordered = sorted(
+            field,
+            key=lambda obj: (-_bbox_h(obj["bbox"]), -int(obj["area"]), obj["bbox"][0], obj["bbox"][1]),
