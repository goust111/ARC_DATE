0088: def main(grid: np.ndarray) -> np.ndarray:
0089:     """
0090:     Move each gray marker along its green path until it reaches the cell next to a black-green-black gate, erasing the path behind it.
0091: 
0092:     Input structure:
0093:     - The background is the dominant color.
0094:     - Foreground components are made from a path color, a paired gate-end color, and single marker pixels.
0095:     - A gate is a straight end-center-end motif whose center has the path color and whose two ends share the gate-end color.
0096: 
0097:     Rule:
0098:     - In every 4-connected foreground component with exactly one marker and one gate, erase the marker and all path-color pixels except the gate center.
0099:     - Place the marker on the unique path-color pixel adjacent to the gate center but not between the two gate ends.
0100:     - Components without both a marker and a gate stay unchanged.
0101: 
0102:     Key insight: The black-green-black motif marks the stopping gate; the gray marker consumes the connected green path until it rests on the path cell immediately beside that gate.
0103:     """
0104:     g = np.asarray(grid, dtype=int)
0105:     bg = int(get_bg(g))
0106:     path_color, end_color, marker_color = _role_colors(g, bg)
0107:     out = g.copy()
0108: 
0109:     for comp in find_components(g, bg=bg, connectivity=4, monochromatic=False):
0110:         coords = comp["coords"]
0111:         marker_coords = [
0112:             tuple(map(int, coord)) for coord in coords if int(g[tuple(coord)]) == marker_color
0113:         ]
0114:         gates = _component_gates(g, coords, path_color, end_color)
0115:         if not marker_coords or not gates:
0116:             continue
0117: 
0118:         assert len(marker_coords) == 1
0119:         assert len(gates) == 1
0120:         gate_r, gate_c, dr, dc = gates[0]
0121:         gate = (gate_r, gate_c)
0122:         gate_ends = {(gate_r - dr, gate_c - dc), (gate_r + dr, gate_c + dc)}
0123:         coords_set = {tuple(map(int, coord)) for coord in coords}
0124: 
0125:         parking = []
0126:         for nr, nc in neighbors4(gate_r, gate_c):
0127:             candidate = (int(nr), int(nc))
0128:             if candidate in gate_ends:
0129:                 continue
0130:             if candidate in coords_set and int(g[candidate]) == path_color:
0131:                 parking.append(candidate)
0132:         assert len(parking) == 1
0133: 
0134:         marker = marker_coords[0]
0135:         assert _path_reaches_marker(g, parking[0], marker, path_color, {gate})
0136: 
0137:         for r, c in coords:
0138:             if int(g[r, c]) in (path_color, marker_color):
0139:                 out[r, c] = bg
0140:         out[gate] = path_color
0141:         out[parking[0]] = marker_color
0142: 
0143:     return out
