+    tr, tc = map(int, dst)
+
+    cells: list[tuple[int, int]] = []
+    if sc <= tc:
+        cols = range(sc, tc + 1)
+    else:
+        cols = range(sc, tc - 1, -1)
+    for cc in cols:
+        cells.append((sr, int(cc)))
+
+    if sr == tr:
+        return cells
+
+    if sr < tr:
+        rows = range(sr + 1, tr + 1)
+    else:
+        rows = range(sr - 1, tr - 1, -1)
+    for rr in rows:
+        cells.append((int(rr), tc))
+    return cells
+
