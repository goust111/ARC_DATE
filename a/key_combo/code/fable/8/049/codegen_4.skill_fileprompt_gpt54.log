+    candidates: list[tuple[int, int, int]] = []
+
+    for divider_c in range(1, width - 1):
+        column = g[:, divider_c]
+        if not bool(np.all(column == column[0])):
+            continue
+
+        left = g[:, :divider_c]
+        right = g[:, divider_c + 1 :]
+        if left.size == 0 or right.size == 0:
