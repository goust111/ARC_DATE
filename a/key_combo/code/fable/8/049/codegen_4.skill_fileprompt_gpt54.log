0014: def main(input_grid):
0015:     """
0016:     Compress uniform horizontal or vertical color stripes into a one-pixel-wide color sequence.
0017: 
0018:     Input structure:
0019:     - The input is made of full-width horizontal stripes or full-height vertical stripes.
0020:     - Stripes may have thickness greater than one cell.
0021:     - Stripe colors appear in order across rows or columns.
0022: 
0023:     Rule:
0024:     - Detect whether rows or columns are constant.
0025:     - Collapse consecutive duplicate row or column colors into one entry per stripe.
0026:     - Return a column for horizontal stripes or a row for vertical stripes.
0027: 
0028:     Key insight:
0029:     - Stripe thickness is redundant; only orientation and ordered colors remain.
0030:     """
0031:     H, W = input_grid.shape
0032: 
0033:     rows_constant = all(np.all(input_grid[r, :] == input_grid[r, 0]) for r in range(H))
0034:     cols_constant = all(np.all(input_grid[:, c] == input_grid[0, c]) for c in range(W))
