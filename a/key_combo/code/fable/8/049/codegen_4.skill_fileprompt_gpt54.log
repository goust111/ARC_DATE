0016: def main(input_grid):
0017:     """
0018:     Convert marked divider-grid cells into pixels colored by matching corner markers.
0019: 
0020:     Input structure:
0021:     - The input has divider bars of one color forming rectangular regions.
0022:     - Some region vertices are single pixels in colors different from the divider.
0023:     - A valid marked region has all four diagonal corner markers in the same color.
0024: 
0025:     Rule:
0026:     - Identify the divider color and crop to the area spanned by special vertex pixels.
0027:     - Find black regions bounded by the divider color.
0028:     - Emit the shared corner color for regions with four matching non-divider markers, otherwise black.
0029: 
0030:     Key insight:
0031:     - Colored vertices label regions, while the divider color only defines the grid structure.
0032:     """
0033:     # Plan:
0034:     # 1. Parse the input into  dividers, regions, and vertices
0035:     # 2. Extract the regions colored differently from the divider on all vertices
0036:     # 3. Produce the output grid by representing each region with a single pixel of the color of its vertices, as long as its color is not the divider
0037: 
0038:     # 1. Parse the input
0039:     # Detect the objects
0040:     objects = find_components(input_grid, bg=Color.BLACK, connectivity=4, monochromatic=True, return_format="objects")
0041:     
0042:     # The divider color is the most frequent non-background color, and the background is black
0043:     divider_color = max(Color.NOT_BLACK, key=lambda color: np.sum(input_grid == color))
0044: 
0045:     # Detect the single pixels that form the vertices of the regions (non-divider, non-background).
0046:     pixels: list[tuple[int, int]] = []
0047:     for obj in objects:
0048:         _b = bbox(obj != Color.BLACK)
0049:         if _b is None:
0050:             continue
0051:         r0, c0, r1, c1 = _b
0052:         if r0 == r1 and c0 == c1:
0053:             col = int(input_grid[r0, c0])
0054:             if col != int(Color.BLACK) and col != int(divider_color):
0055:                 pixels.append((r0, c0))
