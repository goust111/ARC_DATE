0058: 
0059:     # Ignore regions that are not part of those special pixels
0060:     r_min, r_max = min(r_positions), max(r_positions)
0061:     c_min, c_max = min(c_positions), max(c_positions)
0062:     input_grid = input_grid[r_min:r_max+1, c_min:c_max+1]
0063: 
0064:     # Extract just the black regions delimited by the divider color
0065:     regions = find_components(input_grid, bg=divider_color, connectivity=4, monochromatic=True, return_format="objects")
0066:     regions = [region for region in regions if colors_present(region, exclude={ divider_color }) == [Color.BLACK]]
0067: 
0068:     # 2. Analyze vertices, which live on the diagonal corners of the regions, to find the color of the regions
0069:     # Determine their colors by the colors of their vertices, so we are going to have to look at the corners
0070:     def diagonal_corners(obj, background):
0071:         _b = bbox(obj != background)
0072:         assert _b is not None
0073:         r, c, _r1, _c1 = _b
0074:         w = _r1 - r + 1
0075:         h = _c1 - c + 1
0076:         return [(r-1, c-1), (r + w, c-1), (r-1, c + h), (r + w, c + h)]
0077:     
0078:     region_colors = []
0079:     for region in regions:
0080:         corners = [
0081:             (rr, cc)
