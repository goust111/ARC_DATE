0122: def generate_input():
0123:     # We want to first generate a successful path and add some noise teal pixels.
0124:     # Finally, we will remove the intermediate pixels in the path.
0125:     # Because the problem never uses the color 42, we will draw the path in that color, but finally erase it before returning the grid.
0126: 
0127:     # Initialize grid
0128:     n = random.randint(14, 20)
0129:     grid = np.zeros((n, n), dtype=int)
0130: 
0131:     # Start sprite: a 1x2 green line (we rotate the final grid for variety).
0132:     start_sprite = np.full((1, 2), Color.GREEN, dtype=int)
0133: 
0134:     # Draw start sprite
0135:     start_r, start_c = random_free_location(grid, start_sprite, transparent=Color.BLACK, border=4, padding=0, padding_connectivity=8)
0136:     paste(grid, start_sprite, start_r, start_c, transparent=Color.BLACK, clip=True)
0137: 
0138:     # Make a random path from the start to the end, leaving color 42 along the path, and leaving teal pixels at each turn
0139:     r,c = start_r, start_c-1
0140:     orientation = (0, -1)
0141:     target_length = random.randint(10, 20)
0142:     for _ in range(target_length):
0143:         # Draw the path
0144:         if grid[r, c] != Color.BLACK:
0145:             return generate_input()
0146:         grid[r, c] = 42        
0147: 
0148:         if random.random() < 0.2:
0149:             # right angle turn
0150:             dr, dc = orientation
0151:             new_orientation = random.choice([(dc, dr), (-dc, -dr)])
0152:             rr = r + dr
0153:             cc = c + dc
0154:             if rr < 0 or rr >= n or cc < 0 or cc >= n:
0155:                 return generate_input()
0156:             if grid[rr, cc] != Color.BLACK:
0157:                 return generate_input()
0158:             grid[rr, cc] = Color.TEAL
0159:             orientation = new_orientation
0160:         
0161:         dr, dc = orientation
0162:         r += dr
0163:         c += dc
0164: 
0165:         if r < 0 or r >= n or c < 0 or c >= n: return generate_input()
0166:     
0167:     # Color the ending red
0168:     grid[r, c] = Color.RED
0169:     grid[r-dr, c-dc] = Color.RED
0170: 
0171:     # randomly sprinkle teal in unoccupied locations
0172:     for r, c in np.argwhere(grid == Color.BLACK):
0173:         if random.random() < 0.3:
0174:             grid[r, c] = Color.TEAL
0175: 
0176:     # Replace the path with black
0177:     grid[grid == 42] = Color.BLACK
0178: 
0179:     # Randomly rotate
0180:     grid = np.rot90(grid, k=-(random.randint(0, 3)))
0181: 
0182:     return grid

