0007: def main(grid: np.ndarray) -> np.ndarray:
0008:     """
0009:     Extend each non-background pixel into an L reaching the nearest vertical and horizontal grid edges.
0010: 
0011:     Input structure
0012:     A mostly background grid contains one or more isolated foreground marker pixels.
0013:     Each marker is closer to one vertical edge and one horizontal edge, with no midpoint ties.
0014: 
0015:     Rule
0016:     For every marker at (r, c), draw its color along column c from the marker to the nearer
0017:     top or bottom edge, and along row r from the marker to the nearer left or right edge.
0018: 
0019:     Key insight
0020:     Each single pixel is the corner of an edge-facing L; its directions are chosen by nearest
0021:     grid-boundary distance rather than by color identity.
0022:     """
0023:     g = np.asarray(grid, dtype=int)
0024:     assert g.ndim == 2
0025:     h, w = g.shape
0026:     bg = get_bg(g)
0027:     markers = np.argwhere(g != bg)
0028:     assert len(markers) > 0
0029: 
0030:     for r, c in markers:
0031:         r = int(r)
0032:         c = int(c)
0033:         for rr in range(max(0, r - 1), min(h, r + 2)):
0034:             for cc in range(max(0, c - 1), min(w, c + 2)):
0035:                 if (rr, cc) != (r, c):
0036:                     assert g[rr, cc] == bg
0037: 
0038:     out = g.copy()
0039:     claimed = np.full(g.shape, -1, dtype=int)
0040: 
0041:     for r, c in markers:
0042:         r = int(r)
0043:         c = int(c)
0044:         color = int(g[r, c])
0045: 
0046:         up = r
0047:         down = h - 1 - r
0048:         left = c
0049:         right = w - 1 - c
0050:         assert up != down
0051:         assert left != right
0052: 
0053:         r_edge = 0 if up < down else h - 1
0054:         c_edge = 0 if left < right else w - 1
0055: 
0056:         mask = np.zeros(g.shape, dtype=bool)
0057:         mask[min(r, r_edge) : max(r, r_edge) + 1, c] = True
0058:         mask[r, min(c, c_edge) : max(c, c_edge) + 1] = True
0059: 
0060:         assert np.all((g[mask] == bg) | (g[mask] == color))
0061:         assert np.all((claimed[mask] == -1) | (claimed[mask] == color))
