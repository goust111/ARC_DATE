+        rr0 = max(0, r0 - 1)
+        cc0 = max(0, c0 - 1)
+        rr1 = min(h - 1, r0 + 2)
+        cc1 = min(w - 1, c0 + 2)
+        ok = True
+        for rr in range(rr0, rr1 + 1):
+            for cc in range(cc0, cc1 + 1):
+                if r0 <= rr <= r0 + 1 and c0 <= cc <= c0 + 1:
+                    continue
+                if int(grid[rr, cc]) != bg:
