+def _legend_mask(shape: tuple[int, int], bbox: tuple[int, int, int, int]) -> np.ndarray:
+    mask = np.zeros(shape, dtype=bool)
+    r0, c0, r1, c1 = bbox
+    mask[r0 : r1 + 1, c0 : c1 + 1] = True
+    return mask
