) -> None:
    rel_perim = _perimeter_coords((0, 0, h - 1, w - 1))
    for idx, (rr, cc) in enumerate(rel_perim):
        r = top + rr
        c = left + cc
        if tl_seq[idx]:
            grid[r, c] = color
    ar, ac = rel_perim[anchor_idx]
    grid[top + ar, left + ac] = YELLOW


