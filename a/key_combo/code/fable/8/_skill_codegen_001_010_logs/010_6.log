+    out: list[tuple[int, int, int, int]] = []
+    for i in range(chamber_rows):
+        for j in range(chamber_cols):
+            r0 = top + 1 + i * (chamber_h + 1)
+            c0 = left + 1 + j * (chamber_w + 1)
+            out.append((r0, c0, r0 + chamber_h - 1, c0 + chamber_w - 1))
+    return out
+
