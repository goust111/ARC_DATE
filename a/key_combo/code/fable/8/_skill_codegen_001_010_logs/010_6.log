+    if len(set(result.values())) != len(result):
+        return None
+    residues = {((n - 1) % chamber_count) for n in result.values()}
+    if len(residues) != len(result):
+        return None
+    if max(result.values()) <= chamber_count:
+        return None
+    if result[frame_color] <= 0:
