+def _count_map(
+    chamber_count: int,
+    colors: list[int],
+    frame_color: int,
+) -> dict[int, int] | None:
+    if chamber_count < len(colors):
+        return None
+
+    targets = {chamber_count}
+    while len(targets) < len(colors):
+        targets.add(random.randint(1, chamber_count))
+    targets_list = list(targets)
+    random.shuffle(targets_list)
