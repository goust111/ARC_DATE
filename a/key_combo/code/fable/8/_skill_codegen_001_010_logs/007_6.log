+        b_r0, b_c0, b_r1, b_c1 = bbox_coords(np.array(sorted(block_b), dtype=int))
+        if a_r0 == b_r0:
+            horizontal_count += 1
+        elif a_c0 == b_c0:
+            vertical_count += 1
+        else:
+            return False
+
+        bridge_mask = mask.copy()
+        for r, c in block_a | block_b:
