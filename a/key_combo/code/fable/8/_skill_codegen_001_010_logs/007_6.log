+    return {
+        "cells": cells,
+        "kind": "vertical-cross" if must_cross else "vertical-safe",
+        "survive": bool(survive_cross if must_cross else True),
+    }
+
+
+def _try_horizontal_cross(
+    h: int,
+    w: int,
+    marker_r: int,
+    marker_c: int,
