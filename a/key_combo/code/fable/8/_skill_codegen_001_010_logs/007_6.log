+            obj = _build_vertical(sc, top_r, bottom_r, bridge_col, marker_rows, True, rng, must_cross=False)
+        if not obj:
+            continue
+        if any(r in marker_rows or c in marker_cols for r, c in obj["cells"]):
+            continue
+        if all(not blocked[r, c] for r, c in obj["cells"]):
+            return obj
+    return None
