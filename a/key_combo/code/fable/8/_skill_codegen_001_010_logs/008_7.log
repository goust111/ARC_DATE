+def _components_mask(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            out.append(np.array(coords, dtype=int))
+    return out
+
+
+def _find_components(grid: np.ndarray, bg: int = BG) -> list[dict]:
+    comps: list[dict] = []
+    for color in sorted(int(v) for v in np.unique(grid) if int(v) != bg):
+        for coords in _components_mask(grid == color):
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": _bbox_coords(coords),
+                    "area": int(coords.shape[0]),
+                }
+            )
+    return comps
+
+
+def _border_mask(h: int, w: int) -> np.ndarray:
+    mask = np.zeros((h, w), dtype=bool)
+    mask[0, :] = True
+    mask[-1, :] = True
+    mask[:, 0] = True
+    mask[:, -1] = True
+    return mask
+
+
+def _analyze_frame(grid: np.ndarray, component: dict, bg: int = BG) -> dict | None:
+    color = int(component["color"])
+    r0, c0, r1, c1 = component["bbox"]
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return None
+
+    expected_border_area = 2 * h + 2 * w - 4
+    if int(component["area"]) != expected_border_area:
+        return None
