+        h, w = patch.shape
+        candidates = []
+        for r0 in range(border, rows - h - border + 1):
+            for c0 in range(border, cols - w - border + 1):
+                rect = (r0, c0, r0 + h - 1, c0 + w - 1)
+                if all(_rect_separated(rect, other, padding) for other in placed_rects):
