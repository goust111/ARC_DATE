+            return None
+        r0, c0 = random.choice(candidates)
+        _paste(grid, patch, r0, c0)
+        item["placed_bbox"] = (r0, c0, r0 + h - 1, c0 + w - 1)
+        placed_rects.append(item["placed_bbox"])
