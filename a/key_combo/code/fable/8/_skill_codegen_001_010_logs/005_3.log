+
+    return {
+        "frame_box": (r0, c0, r1, c1),
+        "frame_color": frame_color,
+        "marker_color": marker_color,
+        "marker_local": (mr, mc),
+        "side": side,
+        "object_color": obj_color,
+        "object_top": r0 + 1 + or0,
+        "object_left": c0 + 1 + oc0,
+        "object_mask": obj_mask,
