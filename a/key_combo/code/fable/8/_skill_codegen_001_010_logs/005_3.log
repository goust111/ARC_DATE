+            if not choices:
+                continue
+            marker_r = int(rng.choice(choices))
+            marker_c = 0 if side == "left" else frame_w - 1
+            shift = gap_left if side == "left" else gap_right
+
+        patch = np.zeros((frame_h, frame_w), dtype=int)
+        patch[0, :] = frame_color
+        patch[-1, :] = frame_color
+        patch[:, 0] = frame_color
+        patch[:, -1] = frame_color
