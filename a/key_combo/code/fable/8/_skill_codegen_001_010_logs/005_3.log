+        right_margin = int(rng.integers(0, min(WORK_CANVAS - 1 - bc1, 2) + 1))
+        crop = (br0 - top_margin, bc0 - left_margin, br1 + bottom_margin, bc1 + right_margin)
+
+        inp = _crop_bbox(canvas, crop)
