+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+PALETTE = tuple(range(1, 10))
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+SIDES = ("top", "bottom", "left", "right")
+MAX_ATTEMPTS = 400
+WORK_CANVAS = 30
