+
+def _place_patches(specs: list[dict[str, object]], rng: np.random.Generator) -> tuple[np.ndarray, list[dict[str, object]]] | None:
+    canvas = np.zeros((WORK_CANVAS, WORK_CANVAS), dtype=int)
