   219	        obj_mask = np.asarray(spec["object_mask"], dtype=bool)
   220	        hole_mask = np.asarray(spec["hole_mask"], dtype=bool)
   221	        obj_h, obj_w = obj_mask.shape
   222	        obj_top = int(spec["object_top"]) - int(r0)
   223	        obj_left = int(spec["object_left"]) - int(c0)
   224	        dr, dc = _shift_for_side(str(spec["side"]), obj_top, obj_left, obj_h, obj_w, frame_h, frame_w)
   225	
   226	        obj_cells = np.argwhere(obj_mask)
   227	        abs_rows = int(r0) + obj_top + obj_cells[:, 0]
