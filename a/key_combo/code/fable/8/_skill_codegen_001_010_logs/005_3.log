+            "frame_h": frame_h,
+            "frame_w": frame_w,
+            "frame_color": frame_color,
+            "object_color": object_color,
+            "marker_color": marker_color,
+            "side": side,
+            "marker_r": marker_r,
+            "marker_c": marker_c,
+            "obj_top": obj_top,
