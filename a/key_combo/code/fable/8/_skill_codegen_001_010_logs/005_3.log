+    return True
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_ATTEMPTS):
+        rng = np.random.default_rng()
+        frame_count = 3 if rng.random() < 0.6 else 2
+        max_h = 12 if frame_count == 3 else 14
+        max_w = 12 if frame_count == 3 else 14
+
