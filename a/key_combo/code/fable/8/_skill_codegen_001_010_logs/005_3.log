+def _adjust_specs(specs: list[dict[str, object]], crop: tuple[int, int, int, int]) -> list[dict[str, object]]:
+    r0, c0, _, _ = crop
+    adjusted = []
+    for spec in specs:
+        new_spec = dict(spec)
+        top, left = spec["origin"]
+        new_spec["origin"] = (int(top) - int(r0), int(left) - int(c0))
+        adjusted.append(new_spec)
+    return adjusted
