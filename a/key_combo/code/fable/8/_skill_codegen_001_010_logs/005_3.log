+        obj_left = 1 + gap_left
+        obj_mask = _make_holed_mask(obj_h, obj_w, rng)
+        hole_mask = _hole_mask(obj_mask)
+
+        colors = list(map(int, rng.choice(PALETTE, size=3, replace=False)))
+        frame_color, object_color, marker_color = colors
