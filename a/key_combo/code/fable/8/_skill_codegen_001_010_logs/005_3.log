+            ok = True
+            for rr, cc, oh, ow in chosen:
+                if not (r0 + hh < rr - 1 or rr + oh < r0 - 1 or c0 + hw < cc - 1 or cc + ow < c0 - 1):
+                    ok = False
+                    break
+            if ok:
+                chosen.append(cand)
+                break
