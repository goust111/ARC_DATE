+def _bfs_distances(passable: np.ndarray, sources: list[tuple[int, int]]) -> np.ndarray:
+    h, w = passable.shape
+    dist = np.full((h, w), -1, dtype=int)
+    q: deque[tuple[int, int]] = deque()
