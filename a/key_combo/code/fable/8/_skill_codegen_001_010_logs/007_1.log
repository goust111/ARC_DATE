+        q.append((r, c))
+    while q:
+        r, c = q.popleft()
+        nd = dist[r, c] + 1
+        for nr, nc in _neighbors4(r, c):
+            if _in_bounds((h, w), nr, nc) and passable[nr, nc] and dist[nr, nc] < 0:
