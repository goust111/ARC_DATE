+    if go_down_first:
+        r0 = int(rng.integers(2, h - 4))
+        r2 = int(rng.integers(r0 + 2, h - 2))
+        g[r0, 0] = BLACK
+        g[r0, c1 + 1] = RED
+        g[r2 + 1, c1] = BLUE
+        g[r2, c1 + 2] = BLUE
+    else:
+        r0 = int(rng.integers(4, h - 2))
+        r2 = int(rng.integers(2, r0 - 1))
+        g[r0, 0] = BLACK
+        g[r0, c1 + 1] = BLUE
+        g[r2 - 1, c1] = RED
+        g[r2, c1 + 2] = RED
