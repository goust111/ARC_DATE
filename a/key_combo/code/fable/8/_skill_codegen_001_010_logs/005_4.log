+    assert len(gaps) == 1, "expected exactly one wall gap"
+    gap = gaps[0]
+    r, c = gap
+    assert gap not in {(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)}, "gap cannot be a corner"
+    assert int(grid[r, c]) == BLACK, "the unique entry gap must be black"
