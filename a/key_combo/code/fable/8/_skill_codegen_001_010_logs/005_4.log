+def _perimeter_cells(shape: tuple[int, int]) -> list[tuple[int, int]]:
+    h, w = shape
+    cells = [(0, c) for c in range(w)]
+    cells += [(r, w - 1) for r in range(1, h - 1)]
+    cells += [(h - 1, c) for c in range(w - 1, -1, -1)]
+    cells += [(r, 0) for r in range(h - 2, 0, -1)]
+    return cells
