+        visible = int(np.count_nonzero(g == int(color)))
+        full_area = _bbox_area(bbox)
+        hidden = full_area - visible
+        assert hidden >= 0
+        assert _visible_diagonal_pair(g, color, bbox), "each rectangle must expose one diagonal pair of corners"
