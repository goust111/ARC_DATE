+    c0 = max(int(a[1]), int(b[1]))
+    r1 = min(int(a[2]), int(b[2]))
+    c1 = min(int(a[3]), int(b[3]))
+    if r0 > r1 or c0 > c1:
+        return 0
+    return int(r1 - r0 + 1) * int(c1 - c0 + 1)
