+                if r_lo > r_hi or c_lo > c_hi:
+                    continue
+                r0 = random.randint(r_lo, r_hi)
+                c0 = random.randint(c_lo, c_hi)
+
+            bbox = (r0, c0, r0 + rect_h - 1, c0 + rect_w - 1)
+            if bbox in seen or _bbox_area(bbox) > 96:
