+def _visible_diagonal_pair(grid: np.ndarray, color: int, bbox: tuple[int, int, int, int]) -> bool:
+    r0, c0, r1, c1 = bbox
+    return (
+        int(grid[r0, c0]) == int(color) and int(grid[r1, c1]) == int(color)
+    ) or (
+        int(grid[r0, c1]) == int(color) and int(grid[r1, c0]) == int(color)
+    )
