+        out[r, c] = spec["source_color"]
+    return out
+
+
+def _validate_spec(spec: dict, inp: np.ndarray, expected: np.ndarray, require_turn: bool) -> bool:
+    if not np.array_equal(main(inp), expected):
+        return False
+
+    if len(spec["distractors"]) < 1:
