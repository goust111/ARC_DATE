+def _rect_sum(integral: np.ndarray, r0: int, c0: int, r1: int, c1: int) -> int:
+    if r0 > r1 or c0 > c1:
+        return 0
+    return int(
+        integral[r1 + 1, c1 + 1]
+        - integral[r0, c1 + 1]
+        - integral[r1 + 1, c0]
+        + integral[r0, c0]
+    )
