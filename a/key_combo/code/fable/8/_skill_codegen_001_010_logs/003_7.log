+def _path_dirs(nodes: list[tuple[int, int]]) -> list[str]:
+    dirs = []
+    for (r0, c0), (r1, c1) in zip(nodes, nodes[1:]):
+        dr = r1 - r0
+        dc = c1 - c0
+        for side, (sdr, sdc) in DIRS.items():
+            if (dr, dc) == (sdr, sdc):
+                dirs.append(side)
+                break
+        else:
+            raise AssertionError("nodes must be adjacent on the lattice")
+    return dirs
+
