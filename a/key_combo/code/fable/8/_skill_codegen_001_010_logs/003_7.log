+
+def _segment_cells(start: tuple[int, int], direction: str, stop: tuple[int, int] | None, shape: tuple[int, int]):
+    dr, dc = DIRS[direction]
+    r, c = start
+    cells = []
+    while 0 <= r < shape[0] and 0 <= c < shape[1]:
+        cells.append((r, c))
+        if stop is not None and (r, c) == stop:
+            break
+        r += dr
+        c += dc
