+def _gen_attempt() -> np.ndarray | None:
+    source_color = random.choice(SOURCE_COLOR_CHOICES)
+    terminal_mode = "ring" if random.random() < 0.5 else "edge"
+    room_count = random.choices([2, 3, 4, 5], weights=[1, 3, 3, 2], k=1)[0]
