+    if inp.ndim != 2 or max(inp.shape) > 30 or max(expected.shape) > 30:
+        return None
+    if not _validate_spec(spec, inp, expected, require_turn):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _gen_attempt()
