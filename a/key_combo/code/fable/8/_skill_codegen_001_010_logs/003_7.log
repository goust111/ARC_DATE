+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+WALL = 5
+CHAIN_PITCH = 8
+LATTICE_SIZE = 3
+ROOM_SIDE_CHOICES = (5, 7)
+SOURCE_COLOR_CHOICES = (1, 2, 3, 4, 6, 7, 8, 9)
+DIRS = {
+    "N": (-1, 0),
+    "S": (1, 0),
+    "W": (0, -1),
+    "E": (0, 1),
+}
+OPPOSITE = {"N": "S", "S": "N", "W": "E", "E": "W"}
+MAX_GENERATION_ATTEMPTS = 400
