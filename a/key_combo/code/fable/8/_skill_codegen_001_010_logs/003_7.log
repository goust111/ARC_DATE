+
+def _raw_bbox(rooms: list[dict]) -> tuple[int, int, int, int]:
+    r0 = min(room["bbox"][0] for room in rooms)
+    c0 = min(room["bbox"][1] for room in rooms)
+    r1 = max(room["bbox"][2] for room in rooms)
+    c1 = max(room["bbox"][3] for room in rooms)
+    return r0, c0, r1, c1
