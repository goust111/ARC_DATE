+def _room_from_node(node: tuple[int, int], gap_sides: list[str], role: str) -> dict:
+    center = (node[0] * CHAIN_PITCH, node[1] * CHAIN_PITCH)
+    h, w = _choose_room_size()
+    bbox = _room_bbox(center, h, w)
+    return {
+        "node": node,
+        "center": center,
+        "bbox": bbox,
+        "gap_sides": list(gap_sides),
+        "role": role,
+    }
