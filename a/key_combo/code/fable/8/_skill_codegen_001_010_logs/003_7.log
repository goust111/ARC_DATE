+    gap_lookup: dict[tuple[int, int], tuple[int, int]] = {}
+    for ring_id, ring in enumerate(rings):
+        for gap_idx, gap in enumerate(ring["gaps"]):
+            gap_lookup[tuple(gap["cell"])] = (ring_id, gap_idx)
