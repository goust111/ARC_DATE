+    if len(spec["distractors"]) < 1:
+        return False
+    if np.array_equal(_wrong_fill_all_rings(inp, spec["source_color"]), expected):
+        return False
+    if np.array_equal(_wrong_source_only(spec, inp.shape), expected):
+        return False
