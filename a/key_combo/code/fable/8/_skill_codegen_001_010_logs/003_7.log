+def _trace_rooms_from_spec(spec: dict, shape: tuple[int, int]) -> set[int] | None:
+    gap_lookup = {}
+    for idx, room in enumerate(spec["rooms"]):
+        for side in room["gap_sides"]:
+            gap_lookup[_room_gap_cell(room, side)] = idx
+
+    visited = {0}
