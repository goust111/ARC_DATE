+                    perim_len = 2 * ((r1 - r0 + 1) + (c1 - c0 + 1)) - 4
+                    total_walls = _rect_sum(integral, r0, c0, r1, c1)
+                    inner_walls = _rect_sum(integral, r0 + 1, c0 + 1, r1 - 1, c1 - 1)
+                    if inner_walls != 0:
+                        continue
+                    wall_on_perim = total_walls - inner_walls
+                    gap_count = perim_len - wall_on_perim
