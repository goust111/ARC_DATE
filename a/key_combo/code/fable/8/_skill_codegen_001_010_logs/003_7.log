+    dirs = _path_dirs([room["node"] for room in spec["chain_rooms"]])
+    has_turn = any(dirs[i] != dirs[i - 1] for i in range(1, len(dirs)))
+    if require_turn and len(dirs) >= 2 and not has_turn:
+        return False
