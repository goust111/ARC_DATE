+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BACKGROUND = 0
+FOREGROUND_COLORS = list(range(1, 10))
+GEN_ATTEMPTS = 500
+GEN_SHAPE_ATTEMPTS = 200
+GRID_BOUNDS = (18, 30)
+PAIR_COUNT_OPTIONS = (1, 2, 3)  # total objects: 5, 7, 9
+AREA_BOUNDS = (5, 8)
+BBOX_SIDE_BOUNDS = (3, 5)
