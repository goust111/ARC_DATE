+
+def _random_corner_path(h: int, w: int) -> np.ndarray:
+    starts = [(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)]
+    sr, sc = random.choice(starts)
+    er, ec = h - 1 - sr, w - 1 - sc
+    steps = [(1 if er > sr else -1, 0)] * abs(er - sr)
+    steps += [(0, 1 if ec > sc else -1)] * abs(ec - sc)
+    random.shuffle(steps)
+
+    mask = np.zeros((h, w), dtype=bool)
+    r, c = sr, sc
+    mask[r, c] = True
+    for dr, dc in steps:
+        r += dr
+        c += dc
+        mask[r, c] = True
+    return mask
+
+
+def _growth_candidates(mask: np.ndarray) -> list[tuple[int, int]]:
+    h, w = mask.shape
+    choices: list[tuple[int, int]] = []
+    for r in range(h):
+        for c in range(w):
+            if mask[r, c]:
+                continue
+            touches = 0
+            for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                nr, nc = r + dr, c + dc
+                if 0 <= nr < h and 0 <= nc < w and mask[nr, nc]:
+                    touches += 1
+            if touches in (1, 2):
+                choices.append((r, c))
+    random.shuffle(choices)
+    return choices
