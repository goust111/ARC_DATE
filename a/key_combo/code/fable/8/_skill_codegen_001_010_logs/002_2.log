+def _mark_blocked(blocked: np.ndarray, coords: list[tuple[int, int]]) -> None:
+    h, w = blocked.shape
+    for r, c in coords:
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                nr, nc = r + dr, c + dc
+                if 0 <= nr < h and 0 <= nc < w:
+                    blocked[nr, nc] = True
+
