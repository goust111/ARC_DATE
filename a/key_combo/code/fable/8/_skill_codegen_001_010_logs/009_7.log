+        assert np.all(patch != bg), "rectangle bbox must be fully occupied"
+        cols = set(map(int, patch.ravel()))
+        assert 1 <= len(cols) <= 2, "rectangle must use one fill color and optional marker color"
+        rect_palette |= cols
