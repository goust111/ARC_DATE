    for blue_r, blue_c in _gen_corner_candidates(ray_len):
        blue_rows, blue_cols = _gen_square_axes(blue_r, blue_c)
        blue_square = _gen_square_cells(blue_r, blue_c)
        blue_ray = set(_gen_line_cells((blue_r, blue_c), GEN_BLUE_DIR))

