+    legend_rows = range(0, legend_len) if legend_vertical == "top" else range(h - legend_len, h)
+    col = 0 if legend_side == "left" else w - 1
+    for rr, color in zip(legend_rows, legend_colors):
+        grid[rr, col] = int(color)
+    return grid
