+
+def _separated(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:
+    ar, ac, ah, aw = a
+    br, bc, bh, bw = b
+    return ar + ah + 1 <= br or br + bh + 1 <= ar or ac + aw + 1 <= bc or bc + bw + 1 <= ac
