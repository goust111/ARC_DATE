  97:     def seg_exit(r: int, seg: tuple[int, int]) -> int | None:
  98:         """Return the single exit column, or None. Assert if >1 exit."""
  99:         a, b = seg
 100:         if r + 2 >= H: return None
 101:         drops = [c for c in range(a, b + 1)
 102:                  if int(out[r + 1, c]) == int(bg) and int(out[r + 2, c]) == int(bg)]
 103:         assert len(drops) <= 1, f"segment ({a},{b}) at row {r} has {len(drops)} exits: {drops}"
 104:         return drops[0] if drops else None
 105: 
 106:     def entry_from_above(r: int, seg: tuple[int, int]) -> int | None:
 107:         """Return the single entry column from the wall above, or None. Assert if >1."""
 108:         a, b = seg
 109:         if r < 2: return None
 110:         entries = [c for c in range(a, b + 1)
 111:                    if int(out[r - 1, c]) == int(bg) and int(out[r - 2, c]) == int(bg)]
 112:         assert len(entries) <= 1, f"segment ({a},{b}) at row {r} has {len(entries)} entries from above: {entries}"
 113:         return entries[0] if entries else None
