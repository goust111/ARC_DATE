  37:     # for each object, find the direction the arrowhead is pointing in by finding the relative mean position of colored and black pixels in the bounding box of the object
  38:     for obj in objects:
  39:         # find the bounding box of the object
  40:         _b = bbox(obj != Color.BLACK)
  41:         assert _b is not None
  42:         r, c, _r1, _c1 = _b
  43:         w = _r1 - r + 1
  44:         h = _c1 - c + 1
  45: 
  46:         # crop the object to extract the sprite
  47:         _b = bbox(obj != Color.BLACK)
  48:         assert _b is not None
  49:         sprite = crop_bbox(obj, _b)
  50: 
  51:         # find the color of the object
  52:         color = np.unique(obj[obj != Color.BLACK])[0]
  53: 
  54:         # find the mean position of the colored pixels
  55:         mean_pos = np.mean(np.argwhere(sprite != Color.BLACK), axis=0)
  56: 
  57:         # find the mean position of all the black pixels
  58:         mean_black_pos = np.mean(np.argwhere(sprite == Color.BLACK), axis=0)
  59: 
  60:         # find the direction the arrowhead is pointing in, it is from the mean position of the colored pixels to the mean position of the black pixels
  61:         direction = np.sign(mean_black_pos - mean_pos).astype(int)
  62: 
  63:         # draw a line in the direction the arrowhead is pointing in from the corresponding corner of the bounding box
  64:         # list the corners of the bounding box
  65:         corners = [(r - 1, c - 1), (r + w, c - 1), (r - 1, c + h), (r + w, c + h)]
  66:         # compute the center of the object
  67:         center = (r + w / 2, c + h / 2)
  68:         # if the direction of the corner from the center of the object matches the direction we want to draw a line in, then draw a line
  69:         for corner in corners:
  70:             # check if the corner is in the direction that the arrowhead is pointing
  71:             vector_to_corner = np.array(corner) - np.array(center)
  72:             if np.all(np.sign(vector_to_corner) == direction):
  73:                 draw_line(output_grid, corner[0], corner[1], length=None, color=color, direction=direction)
  74: 
  75:     return output_grid
