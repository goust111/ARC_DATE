 117:     out[out == int(token)] = int(bg)
 118: 
 119:     # Phase 1: each token drops through single exits until stuck.
 120:     finals: list[tuple[int, int]] = []  # (row, col) of final position
 121:     for r, c in token_pts:
 122:         cur_r, cur_c = r, c
 123:         if int(out[cur_r, cur_c]) != int(bg):
 124:             finals.append((cur_r, cur_c)); continue
 125:         while True:
 126:             seg = find_seg(segments_in_row(cur_r), cur_c)
 127:             if seg is None: break
 128:             ex = seg_exit(cur_r, seg)
 129:             if ex is None: break
 130:             cur_r += 2; cur_c = ex
 131:             if cur_r >= H: break
 132:         finals.append((cur_r, cur_c))
 133: 
 134:     # Phase 2: pack tokens at opposite end from entry.
 135:     buckets: dict[tuple[int, tuple[int, int], int], int] = defaultdict(int)
 136:     for r, c in finals:
 137:         segs = segments_in_row(r)
 138:         seg = find_seg(segs, c)
 139:         if seg is None: continue
 140:         a, b = seg
 141:         entry = entry_from_above(r, seg)
 142:         if entry is not None:
 143:             # Pack to opposite end from entry
 144:             pack_end = b if (entry - a) <= (b - entry) else a
 145:         else:
 146:             # No entry from above: token at starting position (grid edge), stay put
 147:             pack_end = a if c <= a else b
 148:         buckets[(r, seg, pack_end)] += 1
 149: 
 150:     for (r, (a, b), pack_end), k in buckets.items():
 151:         if pack_end == a:
 152:             for i in range(k):
 153:                 if a + i <= b: out[r, a + i] = int(token)
 154:         else:
 155:             for i in range(k):
 156:                 if b - i >= a: out[r, b - i] = int(token)
 157: 
 158:     return out
