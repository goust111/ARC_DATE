+    order = _unique_topological_order(list(map(int, key_colors)), edges)
+    if order is None:
+        return None
+    if not _all_pairs_comparable(order, edges):
+        return None
+
+    return {"blank": blank, "order": order, "edges": edges, "fragments": fragments}
