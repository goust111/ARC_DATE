+    edges: set[tuple[int, int]] = set()
+    overlap_pairs = 0
+    for i, a in enumerate(key_colors):
+        for b in key_colors[i + 1 :]:
+            intersection = fragments[a]["full_border"] & fragments[b]["full_border"]
+            if not intersection:
