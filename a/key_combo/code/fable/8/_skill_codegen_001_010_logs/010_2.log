+
+def _assemble_input(
+    rows: int,
+    cols: int,
+    ph: int,
+    pw: int,
+    margins: tuple[int, int, int, int],
+    separator: int,
+    panels: list[np.ndarray],
+) -> np.ndarray:
+    top, bottom, left, right = margins
+    H, W = _panel_canvas_shape(rows, cols, ph, pw, margins)
