+        available = sorted(color for color in remaining if indegree[color] == 0)
+        if len(available) != 1:
+            return None
+        color = available[0]
+        order.append(color)
+        remaining.remove(color)
+        for nxt in outgoing[color]:
+            indegree[nxt] -= 1
+    return order
