+    conflict_colors: dict[tuple[int, int], list[int]] = {}
+
+    conflict_count = random.randint(2, min(4, ph * pw // 8))
+    all_positions = [(r, c) for r in range(ph) for c in range(pw)]
+    random.shuffle(all_positions)
