+            extra = set()
+            for nxt in tuple(reach[color]):
+                extra |= reach[nxt]
+            if not extra <= reach[color]:
+                reach[color] |= extra
+                changed = True
+
+    for i, a in enumerate(order):
+        for b in order[i + 1 :]:
+            if b not in reach[a]:
