+def _overlay_in_sequence(patches: list[np.ndarray], blank: int) -> np.ndarray:
+    out = np.full_like(patches[0], blank)
+    for patch in patches:
+        mask = patch != blank
+        out[mask] = patch[mask]
+    return out
