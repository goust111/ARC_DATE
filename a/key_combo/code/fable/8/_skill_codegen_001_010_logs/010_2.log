+    full_border = _rect_border_cells(box)
+    cells = {tuple(map(int, rc)) for rc in coords}
+    if not cells <= full_border:
+        return None
+
+    if not any(r == r0 for r, _ in cells):
+        return None
+    if not any(r == r1 for r, _ in cells):
+        return None
+    if not any(c == c0 for _, c in cells):
