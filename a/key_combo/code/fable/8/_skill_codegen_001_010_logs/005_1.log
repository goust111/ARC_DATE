+        max_h = random.randint(4, 7)
+        max_w = random.randint(4, 7)
+
+        placed: list[dict[str, object]] = []
+        occupied: set[tuple[int, int]] = set()
+        failed = False
+
+        for index, (size, axis) in enumerate(specs):
