@@ -0,0 +1,391 @@
+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+PALETTE = tuple(range(1, 10))
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+
+def _bbox(mask: np.ndarray) -> tuple[int, int, int, int] | None:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return None
+    r0, c0 = coords.min(axis=0)
