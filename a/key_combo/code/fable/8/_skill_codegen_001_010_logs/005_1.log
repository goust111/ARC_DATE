+        a = (int(coords[0, 0]), int(coords[0, 1]))
+        b = (int(coords[1, 0]), int(coords[1, 1]))
+        assert a[0] == b[0] or a[1] == b[1], "same-color pixels must share a row or a column"
+        inner = _line_cells(a, b, include_ends=False)
