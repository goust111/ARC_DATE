_GEN_LEAF_DEGENERATE_PROB, _GEN_LEAF_DEGENERATE_AXIS_PROB = 0.28, 0.5
_GEN_LEAF_LINE_LENGTH_RANGE, _GEN_LEAF_HEIGHT_RANGE, _GEN_LEAF_WIDTH_RANGE = (2, 5), (2, 5), (2, 7)
