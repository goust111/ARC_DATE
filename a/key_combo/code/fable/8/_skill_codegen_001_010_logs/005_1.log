+def _line_cells(a: tuple[int, int], b: tuple[int, int], *, include_ends: bool) -> list[tuple[int, int]]:
+    (r0, c0), (r1, c1) = a, b
+    if r0 == r1:
+        lo, hi = sorted((c0, c1))
+        start = lo if include_ends else lo + 1
+        stop = hi + 1 if include_ends else hi
+        return [(int(r0), int(c)) for c in range(start, stop)]
+    if c0 == c1:
+        lo, hi = sorted((r0, r1))
+        start = lo if include_ends else lo + 1
+        stop = hi + 1 if include_ends else hi
