+            top = max_arm + random.randint(1, 3)
+            left = max_arm + random.randint(1, 3)
+            height = top + sprite_h + max_arm + random.randint(1, 3)
+            width = left + sprite_w + max_arm + random.randint(1, 3)
+            if max(height, width) > 30:
