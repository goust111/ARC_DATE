+def _meeting_cells(a: tuple[int, int], b: tuple[int, int]) -> list[tuple[int, int]]:
+    (r0, c0), (r1, c1) = a, b
+    if r0 == r1:
+        lo, hi = sorted((c0, c1))
+        gap = hi - lo - 1
+        if gap % 2 == 1:
+            return [(int(r0), int((lo + hi) // 2))]
+        mid = (lo + hi - 1) // 2
+        return [(int(r0), int(mid)), (int(r0), int(mid + 1))]
