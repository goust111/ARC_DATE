+        return (r - arm, c), (r + arm, c)
+    if axis == "h":
+        left = min(c for _, c in cells)
+        right = max(c for _, c in cells)
+        row = cells[0][0]
+        return (row, left - arm), (row, right + arm)
+    top = min(r for r, _ in cells)
+    bottom = max(r for r, _ in cells)
+    col = cells[0][1]
+    return (top - arm, col), (bottom + arm, col)
