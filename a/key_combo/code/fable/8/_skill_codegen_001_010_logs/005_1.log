+
+            offset = (top, left)
+            pairs = _search_pairs(segments, offset, (height, width), max_arm)
+            if pairs is None:
+                continue
+
+            inp = np.zeros((height, width), dtype=int)
+            for seg, (a, b) in zip(segments, pairs):
