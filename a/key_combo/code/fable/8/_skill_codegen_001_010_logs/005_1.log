+    (r0, c0), (r1, c1) = a, b
+    if r0 == r1:
+        lo, hi = sorted((c0, c1))
+        gap = hi - lo - 1
+        if gap % 2 == 1:
+            return [(int(r0), int((lo + hi) // 2))]
+        mid = (lo + hi - 1) // 2
+        return [(int(r0), int(mid)), (int(r0), int(mid + 1))]
+    if c0 == c1:
+        lo, hi = sorted((r0, r1))
+        gap = hi - lo - 1
+        if gap % 2 == 1:
+            return [(int((lo + hi) // 2), int(c0))]
+        mid = (lo + hi - 1) // 2
+        return [(int(mid), int(c0)), (int(mid + 1), int(c0))]
