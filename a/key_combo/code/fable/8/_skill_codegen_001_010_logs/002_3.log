 250: def _unique_canonical_masks(class_count: int) -> list[np.ndarray] | None:
 251:     canonical_masks: list[np.ndarray] = []
 252:     signatures: set[tuple[str, ...]] = set()
 253:     for _ in range(class_count):
 254:         for _ in range(GEN_UNIQUE_MASK_RETRIES):
 255:             mask = _random_mask()
 256:             if mask is None:
 257:                 continue
 258:             sig = _gen_shape_signature(mask)
 259:             if sig in signatures:
 260:                 continue
 261:             signatures.add(sig)
 262:             canonical_masks.append(mask)
 263:             break
 264:         else:
 265:             return None
 266:     return canonical_masks
