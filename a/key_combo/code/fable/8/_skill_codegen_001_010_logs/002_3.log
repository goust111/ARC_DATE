 276: def _build_output(colors: list[int], class_ids: list[int]) -> np.ndarray:
 277:     n = len(colors)
 278:     out_size = GEN_TABLE_STEP * n + GEN_TABLE_BLOCK
 279:     out = np.zeros((out_size, out_size), dtype=int)
 280:     for i, color in enumerate(colors):
 281:         band = GEN_TABLE_STEP + GEN_TABLE_STEP * i
 282:         out[0:GEN_TABLE_BLOCK, band : band + GEN_TABLE_BLOCK] = color
 283:         out[band : band + GEN_TABLE_BLOCK, 0:GEN_TABLE_BLOCK] = color
 284: 
 285:     for i in range(n):
 286:         for j in range(n):
 287:             if i == j:
 288:                 continue
 289:             r = GEN_TABLE_STEP + GEN_TABLE_STEP * i
 290:             c = GEN_TABLE_STEP + GEN_TABLE_STEP * j
 291:             cell_color = GEN_SAME_SHAPE_COLOR if class_ids[i] == class_ids[j] else GEN_DIFFERENT_SHAPE_COLOR
 292:             out[r : r + GEN_TABLE_BLOCK, c : c + GEN_TABLE_BLOCK] = cell_color
 293:     return out
