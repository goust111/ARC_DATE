 269: def _dihedral(mask: np.ndarray) -> np.ndarray:
 270:     out = np.rot90(mask, random.randrange(4))
 271:     if random.random() < GEN_DIHEDRAL_FLIP_PROB:
 272:         out = np.fliplr(out)
 273:     return out.astype(bool).copy()
