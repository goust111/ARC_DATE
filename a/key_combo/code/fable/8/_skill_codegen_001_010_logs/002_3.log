 219: def _random_mask() -> np.ndarray | None:
 220:     area = random.randint(*GEN_OBJECT_AREA_RANGE)
 221:     pairs = [
 222:         (h, w)
 223:         for h in range(GEN_OBJECT_BBOX_RANGE[0], GEN_OBJECT_BBOX_RANGE[1] + 1)
 224:         for w in range(GEN_OBJECT_BBOX_RANGE[0], GEN_OBJECT_BBOX_RANGE[1] + 1)
 225:         if h + w - 1 <= area <= h * w
 226:         and area - (h + w - 1) <= GEN_OBJECT_MAX_EXTRA_CELLS
 227:     ]
 228:     h, w = random.choice(pairs)
 229:     mask = _random_corner_path(h, w)
 230: 
 231:     while int(mask.sum()) < area:
 232:         choices = _growth_candidates(mask)
 233:         if not choices:
 234:             return None
 235:         r, c = random.choice(choices)
 236:         mask[r, c] = True
 237:     return mask
