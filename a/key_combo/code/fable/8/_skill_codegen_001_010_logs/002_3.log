  13: def main(input_grid):
  14:     """
  15:     Place a green 3x3 cross centered halfway between two blue pixels.
  16: 
  17:     Input structure:
  18:     - The grid has a black background with exactly two blue pixels.
  19:     - The blue pixels are aligned horizontally or vertically with room between them.
  20:     - Their midpoint can hold a centered 3x3 pattern.
  21: 
  22:     Rule:
  23:     - Locate the two blue pixels and compute their midpoint.
  24:     - Build a 3x3 green plus-sign sprite.
  25:     - Paste the sprite centered at the midpoint while preserving the blue pixels.
  26: 
  27:     Key insight:
  28:     - The two blue pixels define only the center location; the inserted object is always
  29:       the same green cross pattern.
  30:     """
  31:     # Locate the two blue pixels.
  32:     coords = np.argwhere(input_grid == Color.BLUE)
  33:     assert coords.shape[0] == 2
  34:     r1, c1 = map(int, coords[0])
  35:     r2, c2 = map(int, coords[1])
  36:     mid_r, mid_c = int((r1 + r2) / 2), int((c1 + c2) / 2)
  37: 
  38:     # Generate the 3x3 green cross pattern between the two blue pixels.
  39:     green_cross_sprite = np.array( [[Color.BLACK, Color.GREEN, Color.BLACK],
  40:                                 [Color.GREEN, Color.GREEN, Color.GREEN],
  41:                                 [Color.BLACK, Color.GREEN, Color.BLACK]])
  42:     output_grid = input_grid.copy()
  43:     # Put the cross centered at the midpoint.
  44:     upper_left_r = mid_r - 1
  45:     upper_left_c = mid_c - 1
  46:     output_grid = paste(output_grid, green_cross_sprite, upper_left_r, upper_left_c, transparent=Color.BLACK, clip=True)
  47: 
  48:     return output_grid
  49: 
