 132: def _gen_tight_mask(mask: np.ndarray) -> np.ndarray:
 133:     coords = np.argwhere(mask)
 134:     r0, c0, r1, c1 = bbox_coords(coords)
 135:     return mask[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1].astype(bool)
 136: 
 137: 
 138: def _gen_mask_key(mask: np.ndarray) -> tuple[str, ...]:
 139:     return tuple("".join("1" if cell else "0" for cell in row) for row in mask)
 140: 
 141: 
 142: def _gen_shape_signature(mask: np.ndarray) -> tuple[str, ...]:
 143:     base = _gen_tight_mask(mask)
 144:     variants = []
 145:     for k in range(4):
 146:         rotated = np.rot90(base, k)
 147:         variants.append(_gen_mask_key(_gen_tight_mask(rotated)))
 148:         variants.append(_gen_mask_key(_gen_tight_mask(np.fliplr(rotated))))
 149:     return min(variants)
