 296: def _sample_design() -> tuple[list[int], list[np.ndarray], np.ndarray] | None:
 297:     n = random.randint(*GEN_OBJECT_COUNT_RANGE)
 298:     colors = random.sample(GEN_OBJECT_COLORS, n)
 299:     sizes = _class_sizes(n)
 300:     class_ids = [class_i for class_i, size in enumerate(sizes) for _ in range(size)]
 301:     random.shuffle(class_ids)
 302:     canonical_masks = _unique_canonical_masks(len(sizes))
 303:     if canonical_masks is None:
 304:         return None
 305:     oriented_masks = [_dihedral(canonical_masks[class_i]) for class_i in class_ids]
 306:     expected = _build_output(colors, class_ids)
 307:     return colors, oriented_masks, expected
