 181: def _random_corner_path(h: int, w: int) -> np.ndarray:
 182:     starts = [(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)]
 183:     sr, sc = random.choice(starts)
 184:     er, ec = h - 1 - sr, w - 1 - sc
 185:     moves = [(1 if er > sr else -1, 0)] * (h - 1)
 186:     moves += [(0, 1 if ec > sc else -1)] * (w - 1)
 187:     random.shuffle(moves)
 188: 
 189:     mask = np.zeros((h, w), dtype=bool)
 190:     r, c = sr, sc
 191:     mask[r, c] = True
 192:     for dr, dc in moves:
 193:         r += dr
 194:         c += dc
 195:         mask[r, c] = True
 196:     return mask
 197: 
 198: 
 199: def _growth_candidates(mask: np.ndarray) -> list[tuple[int, int]]:
 200:     h, w = mask.shape
 201:     choices = []
 202:     for r in range(h):
 203:         for c in range(w):
 204:             if mask[r, c]:
 205:                 continue
 206:             touches = sum(
 207:                 0 <= r + dr < h and 0 <= c + dc < w and mask[r + dr, c + dc]
 208:                 for dr, dc in GEN_NEIGHBORS_4
 209:             )
 210:             if touches != 1:
 211:                 continue
 212:             trial = mask.copy()
 213:             trial[r, c] = True
 214:             if not _has_hole(trial):
 215:                 choices.append((r, c))
 216:     return choices
 217: 
