   6: def main(grid: np.ndarray) -> np.ndarray:
   7:     """Repeat the foreground row band vertically to fill the whole grid.
   8: 
   9:     Input structure
  10:     - The input is a 2D grid with a background color and one contiguous horizontal
  11:       band of rows containing all non-background pixels.
  12:     - Rows outside that band are entirely background.
  13: 
  14:     Rule
  15:     - Use the full-width foreground band as a vertical tile.
  16:     - Repeat that tile upward and downward over the original canvas, keeping the
  17:       original band row aligned with its input row position.
  18: 
  19:     Key insight
  20:     - The sparse input is a phase marker for a vertical row pattern, not a set of
  21:       separate objects to move or recolor.
  22:     """
  23:     g = np.asarray(grid, dtype=int)
  24:     assert g.ndim == 2, "input must be a 2D grid"
  25: 
  26:     bg = int(get_bg(g))
  27:     active_rows = np.any(g != bg, axis=1)
  28:     rows = np.flatnonzero(active_rows)
  29:     assert rows.size > 0, "grid must contain a foreground row band"
  30: 
  31:     r0 = int(rows[0])
  32:     r1 = int(rows[-1])
  33:     assert np.array_equal(rows, np.arange(r0, r1 + 1)), "foreground rows must form one contiguous band"
  34:     assert np.all(g[:r0] == bg) and np.all(g[r1 + 1 :] == bg), "rows outside the band must be background"
  35: 
  36:     tile = g[r0 : r1 + 1, :]
  37:     tile_h = tile.shape[0]
  38:     row_indices = (np.arange(g.shape[0]) - r0) % tile_h
  39:     return tile[row_indices].copy()
  40: 
  41: # --------------- generator (o5x) ---------------
  42: 
  43: # Canvas/band geometry; randint high values are exclusive.
  44: HEIGHT_BOUNDS = (10, 16)
  45: WIDTH_BOUNDS = (12, 20)
  46: TILE_HEIGHT = 3
  47: BAND_TOP_PAD = 3
  48: BAND_BOTTOM_PAD = 3
  49: 
  50: # Motif, color, and accepted foreground-count bounds.
  51: BACKGROUND_COLOR = 0
  52: COLOR_BOUNDS = (1, 10)
  53: PERIOD_BOUNDS = (2, 7)
  54: FG_TOTAL_MIN_NUM = 12
  55: FG_TOTAL_MAX_NUM = 21
  56: FG_TOTAL_DEN = 10
  57: 
  58: # Oracle-checked retry limit.
  59: MAX_ATTEMPTS = 300
  60: 
  61: def _gen_row_count(bits: int, period: int, width: int) -> int:
  62:     base = width // period
  63:     rem = width % period
  64:     return sum(base + (1 if j < rem else 0) for j in range(period) if (bits >> j) & 1)
  65: 
  66: 
  67: def _gen_has_period(bits_rows: tuple[int, int, int], period: int, shift: int) -> bool:
  68:     for bits in bits_rows:
  69:         for j in range(period):
  70:             if ((bits >> j) & 1) != ((bits >> ((j + shift) % period)) & 1):
  71:                 return False
  72:     return True
  73: 
  74: 
  75: def _gen_min_period(bits_rows: tuple[int, int, int], period: int) -> int:
  76:     for shift in range(1, period):
  77:         if _gen_has_period(bits_rows, period, shift):
  78:             return shift
  79:     return period
  80: 
  81: 
  82: def _gen_tile(width: int, color: int, period: int) -> np.ndarray:
  83:     row_options = [(bits, _gen_row_count(bits, period, width)) for bits in range(1, 1 << period)]
  84:     lo = (FG_TOTAL_MIN_NUM * width + FG_TOTAL_DEN - 1) // FG_TOTAL_DEN
  85:     hi = (FG_TOTAL_MAX_NUM * width) // FG_TOTAL_DEN
  86:     by_total: dict[int, list[tuple[int, int, int]]] = {}
  87: 
  88:     for bits0, count0 in row_options:
  89:         for bits1, count1 in row_options:
  90:             partial = count0 + count1
  91:             for bits2, count2 in row_options:
  92:                 total = partial + count2
  93:                 bits_rows = (bits0, bits1, bits2)
  94:                 if lo <= total <= hi and _gen_min_period(bits_rows, period) == period:
  95:                     by_total.setdefault(total, []).append(bits_rows)
  96: 
  97:     if not by_total:
  98:         raise ValueError("no periodic tile choices")
  99: 
 100:     totals = sorted(by_total)
 101:     target = totals[int(np.random.randint(0, len(totals)))]
 102:     bits_rows = by_total[target][int(np.random.randint(0, len(by_total[target])))]
 103:     cols = np.arange(width) % period
 104:     mask = ((np.asarray(bits_rows)[:, None] >> cols) & 1).astype(bool)
 105:     tile = np.zeros((TILE_HEIGHT, width), dtype=int)
 106:     tile[mask] = color
 107:     return tile
 108: 
