  13: def main(grid: np.ndarray) -> np.ndarray:
  14:     """Bend the single foreground lattice into a one-pixel horizontal wave anchored at its bottom row.
  15: 
  16:     Input structure
  17:     - The grid has a dominant background and exactly one foreground color.
  18:     - All foreground pixels form one 4-connected lattice-like object.
  19:     - Each row inside the foreground object's bounding box contains foreground pixels.
  20: 
  21:     Rule
  22:     - Keep the bottom row of the object's bounding box fixed.
  23:     - Moving upward from that bottom row, leave every other row fixed.
  24:     - Shift the intervening rows by one pixel, alternating left, right, left, right.
  25: 
  26:     Key insight
  27:     - The phase of the wave is determined from the bottom of the object, not from the top.
  28:     """
  29:     g = np.asarray(grid, dtype=int)
  30:     bg = get_bg(g)
  31:     fg_colors = colors_present(g, exclude={bg})
  32:     assert len(fg_colors) == 1
  33:     fg = fg_colors[0]
  34: 
  35:     mask = g != bg
  36:     assert len(components_mask(mask, connectivity=4)) == 1
  37:     box = bbox(mask)
  38:     assert box is not None
  39:     r0, _, r1, _ = box
  40: 
  41:     out = g.copy()
  42:     for r in range(r0, r1 + 1):
  43:         cols = np.flatnonzero(mask[r])
  44:         assert cols.size > 0
  45:         shift = _wave_shift(r1 - r)
  46:         if shift == 0:
  47:             continue
  48: 
  49:         new_cols = cols + shift
  50:         assert int(new_cols.min()) >= 0
  51:         assert int(new_cols.max()) < g.shape[1]
  52:         out[r, cols] = bg
  53:         assert bool(np.all(out[r, new_cols] == bg))
  54:         out[r, new_cols] = fg
  55: 
  56:     return out
  57: 
