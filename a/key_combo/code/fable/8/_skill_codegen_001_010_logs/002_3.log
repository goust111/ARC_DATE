 152: def _has_hole(mask: np.ndarray) -> bool:
 153:     bg = ~mask.astype(bool)
 154:     if not bool(bg.any()):
 155:         return False
 156: 
 157:     H, W = bg.shape
 158:     seen = np.zeros_like(bg, dtype=bool)
 159:     stack: list[tuple[int, int]] = []
 160:     for r in range(H):
 161:         for c in (0, W - 1):
 162:             if bg[r, c] and not seen[r, c]:
 163:                 seen[r, c] = True
 164:                 stack.append((r, c))
 165:     for c in range(W):
 166:         for r in (0, H - 1):
 167:             if bg[r, c] and not seen[r, c]:
 168:                 seen[r, c] = True
 169:                 stack.append((r, c))
 170: 
 171:     while stack:
 172:         r, c = stack.pop()
 173:         for dr, dc in GEN_NEIGHBORS_4:
 174:             nr, nc = r + dr, c + dc
 175:             if 0 <= nr < H and 0 <= nc < W and bg[nr, nc] and not seen[nr, nc]:
 176:                 seen[nr, nc] = True
 177:                 stack.append((nr, nc))
 178:     return bool((bg & ~seen).any())
