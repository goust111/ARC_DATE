  73: def main(grid: np.ndarray) -> np.ndarray:
  74:     """
  75:     Build a color-labeled shape-equivalence table from the objects listed on the right edge.
  76: 
  77:     Input structure:
  78:     - The background contains one main 4-connected object for each foreground color.
  79:     - The rightmost column has one singleton pixel of each foreground color, listed top-to-bottom.
  80:     - Those singleton pixels define the row and column order of the output table.
  81: 
  82:     Rule:
  83:     - Normalize each main object to its tight mask and compare masks up to rotation or reflection.
  84:     - Draw 2x2 color labels across the top and down the left, separated by one background row/column.
  85:     - For each off-diagonal table cell, paint a 2x2 red block when the two labeled objects have the same shape under rotation/reflection, otherwise paint a 2x2 grey block.
  86:     - Leave diagonal cells and all separators as background.
  87: 
  88:     Key insight:
  89:     - Object positions and original orientations are distractors; the relation is dihedral shape equivalence, while the right-edge legend fixes the table order.
  90:     """
  91:     g = np.asarray(grid, dtype=int)
  92:     bg = get_bg(g)
  93:     order = _legend_order(g, bg)
  94:     signatures = {color: _shape_signature(_main_object_mask(g, bg, color)) for color in order}
  95: 
  96:     n = len(order)
  97:     out = np.full((3 * n + 2, 3 * n + 2), int(bg), dtype=int)
  98: 
  99:     for i, color in enumerate(order):
 100:         band = 3 + 3 * i
 101:         out[0:2, band : band + 2] = int(color)
 102:         out[band : band + 2, 0:2] = int(color)
 103: 
 104:     for i, row_color in enumerate(order):
 105:         for j, col_color in enumerate(order):
 106:             if i == j:
 107:                 continue
 108:             cell_color = Color.RED if signatures[row_color] == signatures[col_color] else Color.GREY
 109:             r = 3 + 3 * i
 110:             c = 3 + 3 * j
 111:             out[r : r + 2, c : c + 2] = int(cell_color)
 112: 
 113:     return out
 114: 
