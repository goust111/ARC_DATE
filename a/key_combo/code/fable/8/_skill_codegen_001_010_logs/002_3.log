  30: def main(grid: np.ndarray) -> np.ndarray:
  31:     """
  32:     Swap the two colored fills inside the unique rectangular frame while preserving black gaps.
  33: 
  34:     Input structure:
  35:     - The grid contains one one-cell-thick rectangular frame.
  36:     - The frame interior contains black pixels and exactly two non-black, non-frame colors.
  37:     - Pixels outside the frame may use the same colors but are not part of the editable region.
  38: 
  39:     Rule:
  40:     - Find the unique rectangular frame and take the region strictly inside it.
  41:     - Within that interior, exchange the two non-black, non-frame colors.
  42:     - Preserve black interior pixels, the frame, and all pixels outside the frame.
  43: 
  44:     Key insight:
  45:     - The frame, not the outer scattered pixels, selects the only region where the color swap applies.
  46:     """
  47:     g = np.asarray(grid, dtype=int)
  48:     frame_color, (r0, c0, r1, c1) = _find_rectangular_frame(g)
  49: 
  50:     interior = g[r0 + 1 : r1, c0 + 1 : c1]
  51:     interior_colors = set(map(int, np.unique(interior)))
  52:     assert Color.BLACK in interior_colors
  53:     assert frame_color not in interior_colors
  54:     swap_colors = [color for color in interior_colors if color != Color.BLACK]
  55:     assert len(swap_colors) == 2
  56: 
  57:     first, second = swap_colors
  58:     out = g.copy()
  59:     out_region = out[r0 + 1 : r1, c0 + 1 : c1]
  60:     out_region[interior == first] = second
  61:     out_region[interior == second] = first
  62:     return out
  63: 
  64: # --------------- generator (o5x) ---------------
  65: 
  66: # Canvas, palette, frame geometry, fill densities, and retry budget.
  67: GRID_SIZE, FRAME_COLOR = 10, 5
  68: SWAP_COLOR_POOL = [1, 2, 3, 4, 6, 7, 8, 9]
  69: FRAME_SIZE_RANGE = (6, 9)
  70: FRAME_MARGIN = 1
  71: OUTSIDE_BLACK_FRAC_RANGE = (0.25, 0.40)
  72: INTERIOR_BLACK_FRAC_RANGE = (0.15, 0.50)
  73: MAX_GENERATION_ATTEMPTS = 300
  74: 
  75: 
  76: def _gen_fill_values(n_cells, colors, black_frac_range):
  77:     black_min_frac, black_max_frac = black_frac_range
  78:     lo = int(np.ceil(black_min_frac * n_cells))
  79:     hi = int(np.floor(black_max_frac * n_cells))
  80:     black_count = int(np.random.randint(lo, hi + 1))
  81:     colored_count = n_cells - black_count
  82:     first_count = int(np.random.randint(1, colored_count))
  83:     vals = [Color.BLACK] * black_count + [colors[0]] * first_count
  84:     vals += [colors[1]] * (colored_count - first_count)
  85:     vals = np.array(vals, dtype=int)
  86:     np.random.shuffle(vals)
  87:     return vals
  88: 
  89: 
  90: def _sample_frame_box():
  91:     """Return inclusive frame bounds plus size using the original RNG order."""
  92:     h = int(np.random.randint(*FRAME_SIZE_RANGE))
  93:     w = int(np.random.randint(*FRAME_SIZE_RANGE))
  94:     r0 = int(np.random.randint(FRAME_MARGIN, GRID_SIZE - h))
  95:     c0 = int(np.random.randint(FRAME_MARGIN, GRID_SIZE - w))
  96:     return r0, c0, r0 + h - 1, c0 + w - 1, h, w
  97: 
