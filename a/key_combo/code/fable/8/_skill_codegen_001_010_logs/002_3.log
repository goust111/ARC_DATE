 112:     width = int(np.random.randint(*WIDTH_BOUNDS))
 113:     color = int(np.random.randint(*COLOR_BOUNDS))
 114:     period = int(np.random.randint(*PERIOD_BOUNDS))
 115:     r0 = int(np.random.randint(BAND_TOP_PAD, height - TILE_HEIGHT - BAND_BOTTOM_PAD + 1))
 116: 
 117:     tile = _gen_tile(width, color, period)
 118:     row_indices = (np.arange(height) - r0) % tile.shape[0]
 119:     expected = tile[row_indices].copy()
