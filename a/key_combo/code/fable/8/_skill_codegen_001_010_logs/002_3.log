 240: def _class_sizes(n: int) -> list[int]:
 241:     k = random.choice([k for k in GEN_CLASS_OPTIONS if k <= n <= GEN_MAX_CLASS_SIZE * k])
 242:     sizes = [1] * k
 243:     for _ in range(n - k):
 244:         open_slots = [i for i, size in enumerate(sizes) if size < GEN_MAX_CLASS_SIZE]
 245:         sizes[random.choice(open_slots)] += 1
 246:     random.shuffle(sizes)
 247:     return sizes
 248: 
