+            assert len(blockers) <= 1, "next step may not collide with multiple sprites"
+            blocker = next(iter(blockers)) if blockers else None
+            return (cur_r, cur_c), blocker, steps
+        cur_r, cur_c = next_r, next_c
+        steps += 1
+
+
+def _simulate(
+    sprites: list[Sprite],
+    start_idx: int,
+    shape: tuple[int, int],
