+
+@dataclass(frozen=True)
+class Sprite:
+    cells: tuple[tuple[int, int, int], ...]
+    occupied: frozenset[tuple[int, int]]
+    anchor: tuple[int, int]
+    direction: tuple[int, int]
+    marker_color: int
+    body_color: int
