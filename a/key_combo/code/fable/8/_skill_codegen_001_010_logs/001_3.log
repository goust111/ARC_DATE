+        _sprite_with_anchor(base[1], (0, w_d + g3 + w_a + g1)),
+        _sprite_with_anchor(base[2], (row_cd, w_d + g3 + w_a + g1)),
+        _sprite_with_anchor(base[3], (row_cd, 0)),
