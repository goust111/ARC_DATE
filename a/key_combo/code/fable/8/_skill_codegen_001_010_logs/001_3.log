+        cells = {(r - r0, c - c0) for r, c in cells}
+        h2 = r1 - r0 + 1
+        w2 = c1 - c0 + 1
+        sides = []
+        if any((0, c) in cells for c in range(1, w2 - 1)):
+            sides.append("up")
+        if any((h2 - 1, c) in cells for c in range(1, w2 - 1)):
+            sides.append("down")
+        if any((r, 0) in cells for r in range(1, h2 - 1)):
