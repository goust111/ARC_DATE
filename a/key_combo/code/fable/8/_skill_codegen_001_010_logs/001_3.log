+        for anchor in _candidate_anchors(base_sprites[idx], placed, shape):
+            trial = placed + [_sprite_with_anchor(base_sprites[idx], anchor)]
+            try:
+                _trial_positions, order, events = _simulate(trial, 0, shape)
+            except AssertionError:
+                continue
+            if order == final_order and events == final_events:
+                found = _sprite_with_anchor(base_sprites[idx], anchor)
+                break
+        if found is None:
+            return None
+        placed.append(found)
+
+    grid = _render(shape, bg, placed, [sprite.anchor for sprite in placed])
+    if not _semantic_check(grid, expected_chain=chain_len, terminal_mode=terminal_mode):
+        return None
+    return grid
+
