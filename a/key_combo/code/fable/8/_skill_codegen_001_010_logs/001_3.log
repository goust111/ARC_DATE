+    sprite = sprites[idx]
+    dr, dc = sprite.direction
+    cur_r, cur_c = positions[idx]
+    occupied_by_other = [
+        _occupied_at(other, positions[j]) if j != idx else set()
+        for j, other in enumerate(sprites)
+    ]
+
+    steps = 0
+    while True:
+        next_r = cur_r + dr
+        next_c = cur_c + dc
+        blockers: set[int] = set()
+        out_of_bounds = False
+        for rr, cc in sprite.occupied:
+            nr = next_r + rr
+            nc = next_c + cc
+            if not (0 <= nr < h and 0 <= nc < w):
+                out_of_bounds = True
+                break
