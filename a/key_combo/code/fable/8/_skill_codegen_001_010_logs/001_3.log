+import random
+from collections import Counter
+from dataclasses import dataclass
+
+import numpy as np
+
+
+DIR_BY_SIDE = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+ALL_COLORS = tuple(range(10))
