+
+def _get_bg(grid: np.ndarray) -> int:
+    flat = list(map(int, np.asarray(grid, dtype=int).ravel()))
+    return Counter(flat).most_common(1)[0][0]
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
