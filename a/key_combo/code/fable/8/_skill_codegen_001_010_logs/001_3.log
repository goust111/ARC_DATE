+        order.append(active)
+        events.append(
+            {
+                "sprite": active,
+                "blocker": blocker,
+                "steps": steps,
+            }
+        )
+        if blocker is None or blocker in moved:
+            active = None
+        else:
+            active = blocker
+    return positions, order, events
+
+
+def _render(shape: tuple[int, int], bg: int, sprites: list[Sprite], positions: list[tuple[int, int]]) -> np.ndarray:
+    out = np.full(shape, bg, dtype=int)
