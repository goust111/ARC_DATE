+def mask_from_cells(shape: tuple[int, int], cells: set[tuple[int, int]]) -> np.ndarray:
+    mask = np.zeros(shape, dtype=bool)
+    if cells:
+        rows, cols = zip(*sorted(cells))
+        mask[list(rows), list(cols)] = True
+    return mask
