+    for i in range(1, len(queue)):
+        pr, pc = queue[i - 1]
+        r, c = queue[i]
+        assert (pr - r, pc - c) == (dr, dc)
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_MAX_ATTEMPTS):
+        bare = _build_bare_grid()
+        if bare is None:
+            continue
+        grid = _place_marbles(bare)
+        if grid is None:
+            continue
+        try:
+            out = main(grid)
+            _semantic_check(grid, out)
+        except AssertionError:
