+    for (r, c), color in zip(queue, moved_colors):
+        assert int(out[r, c]) == color
+    for i in range(1, len(queue)):
+        pr, pc = queue[i - 1]
+        r, c = queue[i]
+        assert (pr - r, pc - c) == (dr, dc)
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_MAX_ATTEMPTS):
+        bare = _build_bare_grid()
+        if bare is None:
