    queue = info["queue"]
    dr, dc = info["exit_dir"]
    assert len(queue) == len(moved_colors)
    assert np.array_equal(out == PATH, inp == PATH)
    assert not np.any((out != BG) & (out != PATH) & (inp != BG) & (inp != PATH)), "original marbles must be cleared"
