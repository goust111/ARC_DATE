+            placed.pop()
+        return False
+
+    if not search(0):
+        return None
+
+    out = grid.copy()
+    colors = random.sample(MARBLE_COLORS, marble_count)
+    for (r, c), color in zip(placed, colors):
+        out[r, c] = color
+
+    try:
+        analyzed = _analyze(out)
+    except AssertionError:
