+
+
+def _wall_sets(path: list[tuple[int, int]]) -> tuple[set[tuple[int, int]], set[tuple[int, int]]]:
+    channel = set(path)
+    left: set[tuple[int, int]] = set()
+    right: set[tuple[int, int]] = set()
