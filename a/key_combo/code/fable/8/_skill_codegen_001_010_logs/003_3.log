+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+PATH = 5
+MARBLE_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIR8 = [
