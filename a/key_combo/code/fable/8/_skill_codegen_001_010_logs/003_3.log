+                continue
+            if int(grid[r, c]) != BG:
+                continue
+            if chebyshev((r, c), entrance) != target_distance:
+                continue
+            if chebyshev((r, c), entrance) >= chebyshev((r, c), exit_cell):
+                continue
+            candidates.append((r, c))
+    random.shuffle(candidates)
+    return candidates
+
+
+def _place_marbles(grid: np.ndarray) -> np.ndarray | None:
