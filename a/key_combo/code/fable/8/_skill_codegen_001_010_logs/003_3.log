+        mask[list(rows), list(cols)] = True
+    return mask
+
+
+def dilate8(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    out = np.zeros_like(mask, dtype=bool)
+    for r, c in np.argwhere(mask):
+        rr = int(r)
+        cc = int(c)
+        out[rr, cc] = True
+        for dr, dc in DIR8:
+            nr = rr + dr
+            nc = cc + dc
+            if 0 <= nr < h and 0 <= nc < w:
+                out[nr, nc] = True
