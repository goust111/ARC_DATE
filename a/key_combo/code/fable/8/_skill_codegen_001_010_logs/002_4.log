+) -> list[tuple[int, int]]:
+    blocked = np.zeros((H, W), dtype=bool)
+    for r, c in chosen:
+        blocked[r, c] = True
+
+    coords = [(r, c) for r in range(H) for c in range(W)]
+    random.shuffle(coords)
+    extra_budget = random.randint(max(1, len(chosen) // 4), max(1, len(chosen) // 2))
+
+    for r, c in coords:
+        if extra_budget == 0:
+            break
+        if blocked[r, c]:
+            continue
+        if not _is_isolated(blocked, r, c):
