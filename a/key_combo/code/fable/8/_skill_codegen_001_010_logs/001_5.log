+    count = 0
+    for r, c in np.argwhere(mask):
+        r = int(r)
+        c = int(c)
+        if seen[r, c]:
+            continue
+        count += 1
+        q = deque([(r, c)])
+        seen[r, c] = True
+        while q:
+            rr, cc = q.popleft()
+            for nr, nc in _neighbors4(rr, cc):
