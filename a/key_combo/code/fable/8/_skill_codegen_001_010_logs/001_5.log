        for w in range(RECT_SIDE_MIN, RECT_SIDE_MAX + 1):
            area = h * w
            if RECT_AREA_MIN <= area <= RECT_AREA_MAX:
                area_to_dims.setdefault(area, []).append((h, w))

    rects: list[tuple[int, int]] = []
    remaining = total_area
