+def _paste(
+    dst: np.ndarray,
+    patch: np.ndarray,
+    r0: int,
+    c0: int,
+    *,
+    transparent: int | None = None,
+) -> np.ndarray:
+    r0 = int(r0)
+    c0 = int(c0)
+    h, w = patch.shape
+    if r0 < 0 or c0 < 0 or r0 + h > dst.shape[0] or c0 + w > dst.shape[1]:
+        raise ValueError("paste out of bounds")
