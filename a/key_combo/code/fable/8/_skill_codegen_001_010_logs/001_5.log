+        for rb in rows:
+            if rb - rt < 2:
+                continue
+            for cl in cols:
+                for cr in cols:
+                    if cr - cl < 2:
+                        continue
+                    markers = ((rt, cl), (rt, cr), (rb, cl), (rb, cr))
+                    if not all(p in point_set for p in markers):
+                        continue
+
+                    r0, c0 = rt + 1, cl + 1
+                    r1, c1 = rb - 1, cr - 1
+                    anchor_cells = [
+                        p for p in points if r0 <= p[0] <= r1 and c0 <= p[1] <= c1
