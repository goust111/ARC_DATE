+        dr = tr - ar
+        dc = tc - ac
+        nr0 = r0 + dr
+        nc0 = c0 + dc
+        assert 0 <= nr0 and 0 <= nc0 and nr0 + h <= g.shape[0] and nc0 + w <= g.shape[1]
