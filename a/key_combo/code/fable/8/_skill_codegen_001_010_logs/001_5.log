+                    if len(anchor_cells) != 1:
+                        continue
+                    anchor = anchor_cells[0]
+
+                    used = set(markers)
+                    used.add(anchor)
+                    leftovers = [p for p in points if p not in used]
+                    if len(leftovers) != 1:
+                        continue
+                    target = leftovers[0]
+                    if not _is_isolated_foreground(grid, target):
