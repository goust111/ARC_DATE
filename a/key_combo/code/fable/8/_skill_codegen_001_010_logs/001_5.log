+def _make_pattern(h: int, w: int, anchor_color: int, fill_colors: list[int]) -> tuple[np.ndarray, tuple[int, int]]:
+    cells = [(r, c) for r in range(h) for c in range(w) if (r, c) not in {(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)}]
