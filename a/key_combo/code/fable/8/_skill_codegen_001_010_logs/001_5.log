+def _find_group_for_color(grid: np.ndarray, color: int) -> dict | None:
+    points = [tuple(map(int, rc)) for rc in np.argwhere(grid == color)]
+    if len(points) < 6:
+        return None
+    point_set = set(points)
+    rows = sorted({r for r, _ in points})
+    cols = sorted({c for _, c in points})
+    candidates = []
+
