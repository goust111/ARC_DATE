+                            "window": (r0, c0, r1, c1),
+                            "markers": tuple(markers),
+                            "anchor": anchor,
+                            "anchor_offset": (anchor[0] - r0, anchor[1] - c0),
+                            "target": target,
+                            "pattern": pattern,
+                        }
+                    )
