+        for pr, pc in np.argwhere(pattern != BLACK):
+            rr = nr0 + int(pr)
+            cc = nc0 + int(pc)
+            assert out[rr, cc] == BLACK, "translated pattern must land on cleared background"
+            assert (rr, cc) not in occupied, "translated patterns must not overlap"
