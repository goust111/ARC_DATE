+        cc = idx % cell_cols
+        r0 = row_runs[rr][1]
+        r1 = row_runs[rr + 1][0]
+        c0 = col_runs[cc][1]
+        c1 = col_runs[cc + 1][0]
+        out[r0:r1, c0:c1] = residues[idx % period]
+    return out
