+) -> tuple[list[np.ndarray], int, int]:
+    cells: list[np.ndarray] = []
+    n_rows = len(row_runs) - 1
+    n_cols = len(col_runs) - 1
+    for rr in range(n_rows):
+        r0 = row_runs[rr][1]
+        r1 = row_runs[rr + 1][0]
+        for cc in range(n_cols):
+            c0 = col_runs[cc][1]
+            c1 = col_runs[cc + 1][0]
