+    if len(pool) < GEN_MIN_PROTOTYPES:
+        return None
+
+    prototype_count = int(rng.integers(GEN_MIN_PROTOTYPES, min(GEN_MAX_PROTOTYPES, len(pool)) + 1))
+    selected = rng.choice(len(pool), size=prototype_count, replace=False)
