+GEN_MAX_ATTEMPTS = 600
+GEN_BG = 0
+GEN_MOTIFS = (
+    "diag",
+    "anti",
+    "border",
+    "vstripe",
+    "hstripe",
+    "plus",
+    "elbow",
+    "xshape",
+    "corners",
+)
+GEN_MIN_CELL = 3
+GEN_MAX_CELL = 5
+GEN_MIN_ROWS = 2
+GEN_MAX_ROWS = 4
+GEN_MIN_COLS = 4
+GEN_MAX_COLS = 6
+GEN_MIN_PERIOD = 3
+GEN_MAX_PERIOD = 7
+GEN_MIN_PROTOTYPES = 2
+GEN_MAX_PROTOTYPES = 4
