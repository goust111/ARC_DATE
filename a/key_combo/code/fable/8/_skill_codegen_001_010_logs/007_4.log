+        tile[:, -1] = color
+    elif motif == "vstripe":
+        tile[:, mid_c] = color
+    elif motif == "hstripe":
+        tile[mid_r, :] = color
+    elif motif == "plus":
+        tile[mid_r, :] = color
+        tile[:, mid_c] = color
+    elif motif == "elbow":
