+def _most_common_color(grid: np.ndarray, exclude: tuple[int, ...] = ()) -> int:
+    values = grid.ravel()
+    if exclude:
+        values = values[~np.isin(values, np.array(exclude, dtype=int))]
+    counts = np.bincount(values.astype(int))
+    return int(np.argmax(counts))
+
