+def _render_motif(motif: str, shape: tuple[int, int], color: int, bg: int) -> np.ndarray:
+    h, w = shape
+    tile = np.full((h, w), bg, dtype=int)
+    mid_r = h // 2
+    mid_c = w // 2
+
+    if motif == "diag":
+        for r in range(h):
+            c = int(round(r * (w - 1) / max(1, h - 1)))
+            tile[r, c] = color
+    elif motif == "anti":
+        for r in range(h):
+            c = int(round((h - 1 - r) * (w - 1) / max(1, h - 1)))
+            tile[r, c] = color
+    elif motif == "border":
+        tile[0, :] = color
+        tile[-1, :] = color
+        tile[:, 0] = color
+        tile[:, -1] = color
+    elif motif == "vstripe":
+        tile[:, mid_c] = color
+    elif motif == "hstripe":
+        tile[mid_r, :] = color
+    elif motif == "plus":
+        tile[mid_r, :] = color
+        tile[:, mid_c] = color
+    elif motif == "elbow":
+        tile[0, :] = color
+        tile[:, 0] = color
+    elif motif == "xshape":
+        for r in range(h):
+            c0 = int(round(r * (w - 1) / max(1, h - 1)))
+            c1 = int(round((h - 1 - r) * (w - 1) / max(1, h - 1)))
+            tile[r, c0] = color
+            tile[r, c1] = color
+    elif motif == "corners":
+        tile[0, 0] = color
+        tile[0, -1] = color
+        tile[-1, 0] = color
+        tile[mid_r, mid_c] = color
+    else:
+        raise AssertionError("unknown motif")
+    return tile
+
+
+def _prototype_pool(cell_shape: tuple[int, int], bg: int, colors: list[int]) -> list[np.ndarray]:
+    seen: set[bytes] = set()
+    pool: list[np.ndarray] = []
+    for motif in GEN_MOTIFS:
+        for color in colors:
+            tile = _render_motif(motif, cell_shape, color, bg)
+            key = tile.tobytes()
+            if np.all(tile == bg) or key in seen:
