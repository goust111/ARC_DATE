+    elif motif == "hstripe":
+        tile[mid_r, :] = color
+    elif motif == "plus":
+        tile[mid_r, :] = color
+        tile[:, mid_c] = color
+    elif motif == "elbow":
+        tile[0, :] = color
+        tile[:, 0] = color
