        _gen_paste(inp, raw, top, inp_c, transparent=_GEN_BG)
        inp_c += raw.shape[1] + _GEN_INPUT_GAP
    return inp


def _gen_attempt() -> np.ndarray | None:
    layout = _gen_layout()
    if layout is None:
        return None
    n_sprites, widths, heights, tops, left_marker_rows, right_marker_rows = layout
