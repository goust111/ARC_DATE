+            next_label += 1
+            stack = [(r, c)]
+            labels[r, c] = next_label
+            while stack:
+                rr, cc = stack.pop()
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr = rr + dr
+                    nc = cc + dc
