                interior_r, interior_c, _r1, _c1 = _b
                interior_width = _r1 - interior_r + 1
                interior_height = _c1 - interior_c + 1
                paste(output_grid, sprite, interior_r, interior_c, transparent=Color.BLACK, clip=True)
                break

    return output_grid            
    
    


