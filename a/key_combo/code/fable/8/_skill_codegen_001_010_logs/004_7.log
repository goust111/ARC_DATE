+
+def _corner_markers(grid: np.ndarray) -> list[tuple[int, int, int]]:
+    markers: list[tuple[int, int, int]] = []
+    seen_colors: set[int] = set()
+    for name in CORNER_NAMES:
+        r, c = _corner_positions(grid.shape)[name]
+        color = int(grid[r, c])
+        if color in (BLACK, OBSTACLE):
