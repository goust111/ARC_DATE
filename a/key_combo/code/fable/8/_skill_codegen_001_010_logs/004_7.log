+def _square_area(prefix: np.ndarray, r0: int, c0: int, size: int) -> int:
+    r1 = r0 + size
+    c1 = c0 + size
+    return int(prefix[r1, c1] - prefix[r0, c1] - prefix[r1, c0] + prefix[r0, c0])
