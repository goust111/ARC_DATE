+    for r, c in extras:
+        rr, cc = r, c
+        if "n" in decoy_orientation:
+            rr = size - 1 - rr
+        if "w" in decoy_orientation:
+            cc = size - 1 - cc
+        cells.add((rr, cc))
+    return cells
