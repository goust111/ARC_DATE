+    for r, c in extras:
+        rr, cc = r, c
+        if "n" in decoy_orientation:
+            rr = size - 1 - rr
+        if "w" in decoy_orientation:
+            cc = size - 1 - cc
+        cells.add((rr, cc))
+    return cells
+
+
+def _bounds(cells: set[Coord]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in cells]
+    cols = [c for _, c in cells]
+    return min(rows), min(cols), max(rows), max(cols)
