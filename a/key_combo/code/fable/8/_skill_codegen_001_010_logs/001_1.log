def _orbit(r: int, c: int, symmetry_sum: int, n: int) -> tuple[tuple[int, int], ...]:
    pts = {
        (r, c),
        (c, r),
        (symmetry_sum - r, c),
        (r, symmetry_sum - c),
        (symmetry_sum - r, symmetry_sum - c),
        (symmetry_sum - c, symmetry_sum - r),
        (c, symmetry_sum - r),
        (symmetry_sum - c, r),
    }
