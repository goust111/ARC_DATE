GRID_SIZE = 10
GRID_SHAPE = (GRID_SIZE, GRID_SIZE)
RECTANGLE_COLOR = Color.YELLOW
INTERIOR_COLORS_BY_AREA = (Color.BLUE, Color.RED)

# Rectangle sampling.
MIN_RECT_SIDE, MAX_RECT_SIDE, MIN_RECT_GAP = 3, 6, 1
RECT_DIMENSIONS = tuple(
