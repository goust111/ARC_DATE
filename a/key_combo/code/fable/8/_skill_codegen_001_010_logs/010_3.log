+def _naive_no_swap_output(
+    H: int,
+    W: int,
+    bg: int,
+    body: int,
+    source_variant: dict[str, object],
+    targets: list[dict[str, object]],
+    placements: dict[str, tuple[int, int]],
+    decorations: list[tuple[int, int, int]],
