+def _dihedral_variants(arr: np.ndarray) -> list[dict[str, object]]:
+    variants: list[dict[str, object]] = []
+    for k in range(4):
+        rotated = np.rot90(arr, k)
+        variants.append({"name": f"rot{k}", "mirrored": False, "array": rotated})
+        flipped = np.fliplr(rotated)
