+        assert connectivity == 4
+        assert return_format == "dict"
+        if bg is None:
+            bg = get_bg(grid)
+        bg = int(bg)
+        out: list[dict] = []
+        if monochromatic:
+            for color in sorted(set(map(int, grid.flatten())) - {bg}):
+                for coords in _components_from_mask(grid == color):
+                    r0, c0 = coords.min(axis=0)
+                    r1, c1 = coords.max(axis=0)
+                    out.append(
