+
+
+MAX_RETRIES = 400
+COLOR_POOL = list(range(10))
+
+
+def _randint(rng: np.random.Generator, lo: int, hi: int) -> int:
+    return int(rng.integers(lo, hi + 1))
+
+
+def _random_partition(total: int, parts: int, rng: np.random.Generator) -> list[int]:
+    if parts == 1:
+        return [total]
