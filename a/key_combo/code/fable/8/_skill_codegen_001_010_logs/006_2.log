+def _inverse_aligned_quadrants(motif: np.ndarray) -> list[np.ndarray]:
+    side = motif.shape[0]
+    half = side // 2
+    tl = motif[:half, :half]
+    tr = motif[:half, half:]
+    bl = motif[half:, :half]
+    br = motif[half:, half:]
+    return [
+        tl.copy(),
+        np.rot90(tr, 1),
+        np.rot90(br, 2),
+        np.rot90(bl, -1),
+    ]
+
