+def _make_base_tile(rng: np.random.Generator, n: int, palette: list[int]) -> np.ndarray:
+    for _ in range(200):
+        row_parts = _randint(rng, 2, min(4, n))
+        col_parts = _randint(rng, 2, min(4, n))
