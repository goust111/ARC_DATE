+        if clusters is None:
+            continue
+
+        masks = [np.zeros((h, w), dtype=bool) for _ in range(4)]
+        for name, ranks in _PATTERN_TO_RANKS.items():
+            for r, c in clusters[name]:
+                for rank in ranks:
