+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(_MAX_GEN_ATTEMPTS):
+        grid = _gen_attempt(rng)
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid layered-overlay ARC input")

