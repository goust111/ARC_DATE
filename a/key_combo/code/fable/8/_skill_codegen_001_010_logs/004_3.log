  14: def main(grid: np.ndarray) -> np.ndarray:
  15:     """Extend each of two aligned rectangular marker objects toward the other, filling half of the gap across the full perpendicular span.
  16: 
  17:     Input structure
  18:     - A dominant background contains exactly two solid, same-sized monochromatic rectangles.
  19:     - The rectangles share either the same row span or the same column span, with a background gap between their facing edges.
  20: 
  21:     Rule
  22:     - If the rectangles are side-by-side, color the left half of the inter-object gap across every row with the left object's color, and the right half with the right object's color.
  23:     - If one rectangle is above the other, color the upper half of the gap across every column with the upper object's color, and the lower half with the lower object's color.
  24:     - When the gap length is odd, leave the center row/column as background.
  25: 
  26:     Key insight
  27:     - The marker objects are endpoints of an axial corridor; their own size identifies the facing edge, while the filled corridor spans the whole grid perpendicular to that axis.
  28:     """
  29:     g = np.asarray(grid, dtype=int)
  30:     bg = int(get_bg(g))
  31:     comps = find_components(g, bg=bg, connectivity=4, monochromatic=True)
  32:     assert len(comps) == 2
  33:     assert all(_is_solid_rect(g, comp) for comp in comps)
  34: 
  35:     a, b = comps
  36:     ar0, ac0, ar1, ac1 = a["bbox"]
  37:     br0, bc0, br1, bc1 = b["bbox"]
  38:     assert (ar1 - ar0, ac1 - ac0) == (br1 - br0, bc1 - bc0)
  39: 
  40:     same_rows = (ar0, ar1) == (br0, br1)
  41:     same_cols = (ac0, ac1) == (bc0, bc1)
  42:     assert same_rows != same_cols
  43: 
  44:     out = g.copy()
  45:     if same_rows:
  46:         left, right = sorted(comps, key=lambda comp: comp["bbox"][1])
  47:         _lr0, _lc0, _lr1, lc1 = left["bbox"]
  48:         _rr0, rc0, _rr1, _rc1 = right["bbox"]
  49:         gap = rc0 - lc1 - 1
  50:         assert gap >= 1
  51:         span = gap // 2
  52:         out[:, lc1 + 1 : lc1 + 1 + span] = left["color"]
  53:         out[:, rc0 - span : rc0] = right["color"]
  54:     else:
  55:         top, bottom = sorted(comps, key=lambda comp: comp["bbox"][0])
  56:         _tr0, _tc0, tr1, _tc1 = top["bbox"]
  57:         br0, _bc0, _br1, _bc1 = bottom["bbox"]
  58:         gap = br0 - tr1 - 1
  59:         assert gap >= 1
  60:         span = gap // 2
  61:         out[tr1 + 1 : tr1 + 1 + span, :] = top["color"]
  62:         out[br0 - span : br0, :] = bottom["color"]
