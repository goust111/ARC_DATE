+def _gen_attempt(rng: np.random.Generator) -> np.ndarray | None:
+    qh = int(rng.integers(5, 15))
+    qw = int(rng.integers(5, 15))
+
+    rank_masks = _make_rank_masks(qh, qw, rng)
