7:def main(grid: np.ndarray) -> np.ndarray:
8:    """
9:    Composite three stacked same-size panels into one panel, with the bottom panel painted last.
10:
11:    Input structure
12:    - The input is three equal-height panels stacked vertically on a common background.
13:    - Each panel contains exactly one foreground color.
14:    - Corresponding cells across the three panels occupy the same output position.
15:
16:    Rule
17:    - Start with the middle panel as the base.
18:    - Copy every non-background pixel from the top panel onto the same position.
19:    - Copy every non-background pixel from the bottom panel onto the same position, overwriting both earlier layers.
20:
21:    Key insight
22:    - Cell conflicts are resolved by panel position/layer role: middle first, then top, then bottom, not by numeric color order.
23:    """
24:    g = np.asarray(grid, dtype=int)
25:    assert g.ndim == 2
26:    H, W = g.shape
27:    assert H % 3 == 0
28:    panel_h = H // 3
29:    assert panel_h > 0 and W > 0
30:
31:    bg = get_bg(g)
32:    top = g[:panel_h, :]
33:    middle = g[panel_h : 2 * panel_h, :]
34:    bottom = g[2 * panel_h :, :]
