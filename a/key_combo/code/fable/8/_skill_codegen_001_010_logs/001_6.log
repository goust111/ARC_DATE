9:def main(grid: np.ndarray) -> np.ndarray:
10:    """
11:    Recolor the interior of the smaller yellow rectangle blue and the larger yellow rectangle red.
12:
13:    Input structure:
14:    - The grid is a black canvas containing exactly two solid rectangles of one
15:      non-black foreground color.
16:    - Each rectangle is at least 3 cells tall and 3 cells wide, so it has a
17:      one-cell border and a nonempty interior.
18:    - The two rectangles have different areas.
19:
20:    Rule:
21:    - Leave the black background and each foreground rectangle's one-cell border
22:      unchanged.
23:    - Fill the smaller rectangle's interior with blue.
24:    - Fill the larger rectangle's interior with red.
25:
26:    Key insight:
27:    - The output colors are assigned by rectangle area rank, while the rewritten
28:      region is simply each rectangle's bbox interior.
29:    """
30:    g = np.asarray(grid, dtype=int)
31:    colors = set(map(int, np.unique(g)))
32:    assert Color.BLACK in colors, "expected a black background"
33:
34:    foreground_colors = colors - {Color.BLACK}
35:    assert len(foreground_colors) == 1, "expected one foreground rectangle color"
36:    foreground = next(iter(foreground_colors))
37:
38:    rects = []
39:    for coords in components_mask(g == foreground, connectivity=4):
40:        assert coords.ndim == 2 and coords.shape[1] == 2, "component coords must be (N,2)"
41:        r0, c0, r1, c1 = bbox_coords(coords)
42:        h = int(r1 - r0 + 1)
43:        w = int(c1 - c0 + 1)
44:        area = int(coords.shape[0])
45:        assert h >= 3 and w >= 3, "rectangles must have nonempty interiors"
46:        assert area == h * w, "foreground components must be solid rectangles"
47:        rects.append((area, r0, c0, r1, c1))
48:
49:    assert len(rects) == 2, "expected exactly two foreground rectangles"
50:    assert len({area for area, *_ in rects}) == 2, "rectangle areas must be distinct"
51:
52:    out = g.copy()
53:    for fill_color, (_area, r0, c0, r1, c1) in zip(
54:        (Color.BLUE, Color.RED),
55:        sorted(rects, key=lambda x: x[0]),
56:    ):
57:        out[r0 + 1 : r1, c0 + 1 : c1] = fill_color
58:    return out
