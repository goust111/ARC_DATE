def _majority_period_info(
    grid: np.ndarray, period_r: int, period_c: int
) -> tuple[np.ndarray, list[tuple[int, int, int]]] | None:
    height, width = grid.shape
    tile = np.zeros((period_r, period_c), dtype=int)
