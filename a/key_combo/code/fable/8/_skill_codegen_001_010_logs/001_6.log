    assert len(seen) > 0

    for p in range(1, min(h, w) + 1):
        tile = np.full((p, p), -1, dtype=int)
        ok = True
        for r, c in seen:
            rr, cc = r % p, c % p
            v = g[r, c]
            if tile[rr, cc] == -1:
                tile[rr, cc] = v
            elif tile[rr, cc] != v:
                ok = False
