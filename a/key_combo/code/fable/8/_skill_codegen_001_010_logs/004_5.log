+
+
+def _render_output(info: dict) -> np.ndarray:
+    g = info["grid"]
+    bg = int(info["bg"])
+    r0, c0, _r1, _c1 = info["bbox"]
+    template = info["template"]
+    body_color = int(info["body_color"])
+    marker_color = int(info["marker_color"])
+    dr, dc = info["step"]
