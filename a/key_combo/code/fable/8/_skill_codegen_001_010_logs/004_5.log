+        "bg": int(bg),
+        "bbox": tuple(map(int, box)),
+        "template": patch,
+        "body_color": body_color,
+        "marker_color": marker_color,
+        "marker_rel": marker_rel,
+        "step": (int(dr), int(dc)),
