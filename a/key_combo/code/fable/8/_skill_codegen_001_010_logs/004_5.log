+def _max_copy_count(h: int, w: int, dr: int, dc: int) -> int:
+    limits = []
+    if dr != 0:
+        limits.append((30 - h) // abs(dr))
+    if dc != 0:
+        limits.append((30 - w) // abs(dc))
+    return max(0, min(limits)) if limits else 0
