+    if mode == "row":
+        return choose_mag(hr), 0
+    if mode == "col":
+        return 0, choose_mag(hc)
+    return choose_mag(hr), choose_mag(hc)
+
+
+def _is_nonzero_multiple(drow: int, dcol: int, dr: int, dc: int) -> bool:
+    if drow == 0 and dcol == 0:
