+        return None
+    if not _mask_is_connected(mask):
+        return None
+    if mask.all():
+        return None
+    if not mask[0, :].any() or not mask[-1, :].any() or not mask[:, 0].any() or not mask[:, -1].any():
+        return None
+    if not _no_shift_overlap(mask, dr, dc):
+        return None
+    return mask
