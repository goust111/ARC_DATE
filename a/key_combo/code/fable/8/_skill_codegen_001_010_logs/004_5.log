+        for row in candidates:
+            if prev is not None and abs(row - prev) > 1:
+                continue
+            ok = True
+            for cc in range(col):
+                if rows[cc] == -1:
+                    continue
+                if _is_nonzero_multiple(row - rows[cc], col - cc, dr, dc):
+                    ok = False
+                    break
