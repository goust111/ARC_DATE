+        stamped = template if copy_index % 2 == 0 else _swap_template_colors(template, body_color, marker_color)
+        window = out[nr0 : nr0 + h, nc0 : nc0 + w]
+        window[template_mask] = stamped[template_mask]
+        out[nr0 : nr0 + h, nc0 : nc0 + w] = window
+        copy_index += 1
+    return out
