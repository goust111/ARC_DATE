+    h, w = map(int, template.shape)
+
+    out = g.copy()
+    template_mask = template != bg
+    copy_index = 1
+    while True:
+        nr0 = r0 + copy_index * dr
+        nc0 = c0 + copy_index * dc
+        if not _copy_fits(out.shape, (nr0, nc0), (h, w)):
+            break
