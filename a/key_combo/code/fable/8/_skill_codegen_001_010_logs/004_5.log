+    seen = np.zeros_like(mask, dtype=bool)
+    components: list[np.ndarray] = []
+    if connectivity == 8:
+        deltas = [(dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if (dr, dc) != (0, 0)]
+    elif connectivity == 4:
