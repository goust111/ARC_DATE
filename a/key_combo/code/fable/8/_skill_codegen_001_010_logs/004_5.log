+                continue
+            rows[col] = row
+            if backtrack(col + 1):
+                return True
+            rows[col] = -1
+        return False
+
+    if not backtrack(0):
+        return None
+
+    mask = np.zeros((h, w), dtype=bool)
+    for col, row in enumerate(rows):
+        mask[row, col] = True
+    return mask
+
