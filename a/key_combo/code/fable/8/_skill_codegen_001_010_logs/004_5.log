+def _no_shift_overlap(mask: np.ndarray, dr: int, dc: int) -> bool:
+    coords = {tuple(map(int, rc)) for rc in np.argwhere(mask)}
+    span = max(mask.shape)
+    for k in range(1, span + 1):
+        if not any(
+            0 <= r + k * dr < mask.shape[0] and 0 <= c + k * dc < mask.shape[1]
+            for r, c in coords
