+        return 1
+    choices = np.arange(1, min(max_copies, 5) + 1)
+    weights = np.ones(len(choices), dtype=float)
+    if len(choices) >= 2:
+        weights[1:] *= 2.5
+    weights = weights / weights.sum()
+    return int(rng.choice(choices, p=weights))
