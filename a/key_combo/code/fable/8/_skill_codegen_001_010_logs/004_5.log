    colors = rng.choice(mod.np.arange(10), size=3, replace=False)
    grid = mod._build_grid(mask, marker_rel, tuple(map(int, colors)), copies, (dr, dc), rng)
    if mod._semantic_check(grid):
        counts['ok'] += 1
    else:
        counts['semantic_fail'] += 1
print(counts)
