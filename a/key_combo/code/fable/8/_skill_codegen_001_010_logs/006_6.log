+            if primitive_id[cr, cc2] != -1 or bool(special[cr, cc2]):
+                continue
+            if _straight_axis(mask, cr, cc2) != axis:
+                continue
+            primitive_id[cr, cc2] = pid
+            coords.append((cr, cc2))
+            if axis == "h":
