+    return out, winners, infos, primitive_id
+
+
+def _solve_core(grid: np.ndarray, *, do_stitch: bool) -> tuple[np.ndarray, np.ndarray, list[dict], dict[int, int], np.ndarray]:
+    g = np.asarray(grid, dtype=int)
