+def _bfs_distances(adjacency: list[set[int]], start: int) -> list[int | None]:
+    dist: list[int | None] = [None] * len(adjacency)
+    dist[start] = 0
+    queue = deque([start])
+    while queue:
+        cur = queue.popleft()
+        for nxt in adjacency[cur]:
+            if dist[nxt] is None:
+                dist[nxt] = dist[cur] + 1
+                queue.append(nxt)
+    return dist
