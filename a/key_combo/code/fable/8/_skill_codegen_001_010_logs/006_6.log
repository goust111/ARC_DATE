+def _straight_axis(mask: np.ndarray, r: int, c: int) -> str:
+    nbs = _line_neighbors(mask, r, c)
+    assert len(nbs) == 2 and _same_axis(nbs[0], nbs[1], (r, c))
+    return "h" if nbs[0][0] == r else "v"
