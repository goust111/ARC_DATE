+
+
+def _endpoint_directions(mask: np.ndarray) -> dict[tuple[int, int], tuple[int, int]]:
+    dirs = {}
+    for r, c in np.argwhere(mask):
+        rr = int(r)
+        cc = int(c)
+        nbs = _line_neighbors(mask, rr, cc)
+        if len(nbs) != 1:
