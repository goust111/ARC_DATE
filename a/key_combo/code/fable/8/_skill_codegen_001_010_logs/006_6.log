# Canvas and component layout bounds.
GEN_CANVAS_MIN = 18
GEN_CANVAS_MAX = 30
GEN_COMPONENT_COUNTS = (2, 3)
GEN_ZONE_GAP = 2
GEN_ZONE_MIN_SIZE = 7
