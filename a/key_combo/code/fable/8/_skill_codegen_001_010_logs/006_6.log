+def _rotate_case(mask: np.ndarray, markers: list[tuple[tuple[int, int], int]], cut_mask: np.ndarray, k: int):
+    rot_mask = np.rot90(mask, k)
+    rot_cut = np.rot90(cut_mask, k)
