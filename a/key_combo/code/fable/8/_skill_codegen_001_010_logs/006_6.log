+    all_distances = [_bfs_distances(adjacency, int(info["seed"])) for info in markers]
+    winners: dict[int, int] = {}
+    for pid in range(len(adjacency)):
+        best_dist = None
+        best_color = None
+        for info, dist in zip(markers, all_distances):
+            d = dist[pid]
+            if d is None:
