+def _paint_segment(mask: np.ndarray, r0: int, c0: int, r1: int, c1: int) -> None:
+    if r0 == r1:
+        lo, hi = sorted((c0, c1))
+        mask[r0, lo : hi + 1] = True
+    else:
+        lo, hi = sorted((r0, r1))
+        mask[lo : hi + 1, c0] = True
