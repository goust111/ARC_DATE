def _can_grow_into(r, c, ph, pw, side, blob, available_mask):
    return (
        0 <= r < ph
        and 0 <= c < pw
        and (r, c) not in blob
        and not _on_other_side(r, c, ph, pw, side)
        and not _on_side(r, c, ph, pw, side)
        and available_mask[r, c]
