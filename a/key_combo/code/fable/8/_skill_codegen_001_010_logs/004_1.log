+        out = []
+        for r in range(g.shape[0]):
+            for c in range(g.shape[1]):
+                if seen[r, c] or int(g[r, c]) == bg:
+                    continue
+                color = int(g[r, c])
+                stack = [(r, c)]
+                coords = []
+                seen[r, c] = True
+                while stack:
+                    rr, cc = stack.pop()
+                    coords.append((rr, cc))
+                    for dr, dc in neighbors:
