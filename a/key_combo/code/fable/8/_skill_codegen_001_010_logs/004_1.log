+                int(spec["rect_b_c0"]),
+                int(spec["rect_r0"] + spec["rect_h"] - 1),
+                int(spec["rect_b_c0"] + spec["rect_w"] - 1),
+            ),
+            "b_color": int(spec["b_color"]),
+            "relay_map": dict(spec["relay_map"]),
+            "gap": int(spec["gap"]),
