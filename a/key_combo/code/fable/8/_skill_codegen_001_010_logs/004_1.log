+    def get_bg(grid: np.ndarray) -> int:
+        colors, counts = np.unique(np.asarray(grid, dtype=int), return_counts=True)
+        return int(colors[int(np.argmax(counts))])
+
+    def find_components(
+        grid: np.ndarray,
