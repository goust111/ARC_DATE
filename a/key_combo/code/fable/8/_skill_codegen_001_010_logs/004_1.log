+def _paint_sequence(
+    out: np.ndarray,
+    original: np.ndarray,
+    coords: list[tuple[int, int]],
+    base_color: int,
+    relay_map: dict[tuple[int, int], int],
+    *,
+    mode: str,
+) -> None:
+    if not coords:
+        return
+
+    if mode == "plain":
+        for r, c in coords:
+            out[r, c] = int(base_color)
+        return
+
+    if mode == "stop":
+        for r, c in coords:
+            if (r, c) in relay_map:
+                break
+            out[r, c] = int(base_color)
+        return
+
+    if mode == "outward":
+        current = int(base_color)
+        start = 0
+        relay_positions = [(idx, relay_map[coord]) for idx, coord in enumerate(coords) if coord in relay_map]
+        if not relay_positions:
+            for r, c in coords:
+                out[r, c] = current
+            return
+        for idx, color in relay_positions:
+            current = int(color)
+            for r, c in coords[start : idx + 1]:
+                out[r, c] = current
+            start = idx + 1
+        for r, c in coords[start:]:
+            out[r, c] = int(base_color)
+        return
+
+    assert mode == "correct"
+    current = int(base_color)
+    for r, c in coords:
+        if (r, c) in relay_map:
+            current = int(relay_map[(r, c)])
+        out[r, c] = current
+
