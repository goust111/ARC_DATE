+
+
+def _spec_to_layout(spec: dict) -> dict:
+    if spec["orientation"] == "H":
+        return {
+            "bg": int(spec["bg"]),
+            "orientation": "H",
+            "a_bbox": (
+                int(spec["rect_r0"]),
