        shape = (pad_top + rect_h + pad_bottom, pad_left + rect_w + gap + rect_w + pad_right)
        spec = {
            "shape": shape,
            "bg": bg,
            "orientation": "H",
            "rect_h": rect_h,
            "rect_w": rect_w,
            "gap": gap,
            "rect_r0": pad_top,
            "rect_a_c0": pad_left,
            "rect_b_c0": pad_left + rect_w + gap,
            "a_color": a_color,
            "b_color": b_color,
        }
    else:
        shape = (pad_top + rect_h + gap + rect_h + pad_bottom, pad_left + rect_w + pad_right)
        spec = {
            "shape": shape,
            "bg": bg,
            "orientation": "V",
            "rect_h": rect_h,
            "rect_w": rect_w,
            "gap": gap,
            "rect_a_r0": pad_top,
            "rect_b_r0": pad_top + rect_h + gap,
            "rect_c0": pad_left,
