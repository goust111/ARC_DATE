+def _visible_interior_mask(rect: Rect, shape: tuple[int, int]) -> np.ndarray:
+    mask = np.zeros(shape, dtype=bool)
+    r0, c0, r1, c1 = rect
+    mask[r0 : r1 + 1, c0 : c1 + 1] = True
+    mask[0, :] = False
+    mask[:, 0] = False
