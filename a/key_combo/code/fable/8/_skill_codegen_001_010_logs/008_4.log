            try:
                r0, c0 = random_free_location(
                    canvas, patch, transparent=0,
                    border=DECOR_BORDER, padding=DECOR_PADDING, padding_connectivity=8,
                )
            except ValueError:
                continue
            placed[r0:r0 + ph, c0:c0 + pw] = True
            break
        else:
            return None
    return placed


