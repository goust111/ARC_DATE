+        overlaps: list[tuple[int, int]] = []
+        for ca, cb in itertools.combinations(sorted(rects), 2):
+            if _intersection(rects[ca], rects[cb]) is not None:
+                overlaps.append((ca, cb))
+        if not overlaps:
+            return False
