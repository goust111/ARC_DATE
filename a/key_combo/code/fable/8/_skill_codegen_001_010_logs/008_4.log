def _find_colored_run(line: np.ndarray, frame_color: int) -> tuple[int, int]:
    runs: list[tuple[int, int]] = []
    i = 1
    while i < len(line) - 1:
        value = int(line[i])
        if value in (BACKGROUND, frame_color):
            i += 1
            continue
        j = i
        while j + 1 < len(line) - 1 and int(line[j + 1]) == value:
            j += 1
        runs.append((int(i), int(j)))
        i = j + 1
