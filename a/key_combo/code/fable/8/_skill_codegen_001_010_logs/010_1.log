+def _touching(b1: tuple[int, int, int, int], b2: tuple[int, int, int, int]) -> bool:
+    r0a, c0a, r1a, c1a = b1
+    r0b, c0b, r1b, c1b = b2
+    return not (r1a < r0b - 1 or r1b < r0a - 1 or c1a < c0b - 1 or c1b < c0a - 1)
