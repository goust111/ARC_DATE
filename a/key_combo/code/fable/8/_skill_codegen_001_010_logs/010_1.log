+        W = min_w + int(rng.integers(0, min(30 - min_w, 6) + 1))
+        extra = H - min_h
+        top_extra = int(rng.integers(extra + 1))
+        mid_extra = int(rng.integers(extra - top_extra + 1))
+        gap = gap_min + mid_extra
