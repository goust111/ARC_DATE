+    if bool(rng.integers(2)):
+        pair1 = (pair1[1], pair1[0])
+    if bool(rng.integers(2)):
+        pair2 = (pair2[1], pair2[0])
+    return pair1, pair2
+
+
+def _place_bboxes(
+    h1: int,
+    w1: int,
+    h2: int,
+    w2: int,
+    rng: np.random.Generator,
+) -> tuple[tuple[int, int], tuple[int, int], tuple[int, int]]:
