+            if rect1["nonblack_coords"] & rect2["nonblack_coords"]:
+                continue
+            if rect1["nonblack_coords"] | rect2["nonblack_coords"] != all_nonblack:
+                continue
+            if _touching(rect1["bbox"], rect2["bbox"]):
