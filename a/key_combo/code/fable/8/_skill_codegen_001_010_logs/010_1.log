+    out_sig = hashlib.md5(out.tobytes() + str(out.shape).encode()).hexdigest()
+    if out_sig in _SEEN_OUTPUT_SIGS:
+        return None
+    _SEEN_OUTPUT_SIGS.add(out_sig)
