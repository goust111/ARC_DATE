+        "anchor_idx": anchor_idx,
+        "frame_color": frame_color,
+        "perim_len": len(perim),
+        "tl_seq": tl_seq,
+        "anchor_seq": _rotate(tl_seq, anchor_idx),
+        "nonblack_coords": {tuple(map(int, coord)) for coord in np.argwhere(nonblack_mask) + np.array([r0, c0])},
