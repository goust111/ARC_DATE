+        unique_pairs = []
+        for h in range(3, total - 2):
+            w = total - h
+            if h > w:
+                continue
+            unique_pairs.append((h, w))
+        for i in range(len(unique_pairs)):
+            for j in range(i + 1, len(unique_pairs)):
+                options.append((unique_pairs[i], unique_pairs[j]))
