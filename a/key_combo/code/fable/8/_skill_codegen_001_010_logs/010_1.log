+def _xor_row(seq1: list[int], seq2: list[int]) -> np.ndarray:
+    assert len(seq1) == len(seq2)
+    return np.array([[GREEN if a ^ b else BLACK for a, b in zip(seq1, seq2)]], dtype=int)
