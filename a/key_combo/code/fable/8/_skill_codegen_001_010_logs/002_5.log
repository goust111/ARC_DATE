+                frontier.discard((rr, cc))
+                continue
+            cell = random.choice(choices)
+            cells.add(cell)
+            frontier.add(cell)
+        mask = np.zeros((h, w), dtype=bool)
+        for rr, cc in cells:
+            mask[rr, cc] = True
+        box = _bbox(mask)
