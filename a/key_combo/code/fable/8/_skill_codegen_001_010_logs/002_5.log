+    inner_w = max_c - min_c + 3
+    patch = np.zeros((inner_h + 2, inner_w + 2), dtype=int)
+    patch[0, :] = FRAME
+    patch[-1, :] = FRAME
+    patch[:, 0] = FRAME
+    patch[:, -1] = FRAME
+    for r, c, color in pair_coords:
+        patch[r - min_r + 2, c - min_c + 2] = color
