+        if r0 == 0 or r1 == grid.shape[0] - 1:
+            if h == 2 and w >= 2:
+                side = "horizontal"
+        elif c0 == 0 or c1 == grid.shape[1] - 1:
+            if w == 2 and h >= 2:
+                side = "vertical"
+        if side is None:
