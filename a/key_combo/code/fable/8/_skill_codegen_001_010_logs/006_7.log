+    if len(mapping) >= len(placements):
+        return False
+    if not any(donor in mapping for donor in mapping.values()):
+        return False
+    if not any(
+        placements[a]["input_shape"].shape != placements[b]["input_shape"].shape
+        for a, b in mapping.items()
