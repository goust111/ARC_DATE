+    actual = main(grid)
+    if not np.array_equal(expected, actual):
+        return False
+    if np.array_equal(grid, actual):
+        return False
+    if len(mapping) >= len(placements):
+        return False
+    if not any(donor in mapping for donor in mapping.values()):
+        return False
+    if not any(
