+                center_c = c0 + in_w // 2
+                out_r0 = center_r - out_h // 2
+                out_c0 = center_c - out_w // 2
+                if out_r0 < _MARGIN or out_c0 < _MARGIN:
+                    continue
+                if out_r0 + out_h > grid_shape[0] - _MARGIN or out_c0 + out_w > grid_shape[1] - _MARGIN:
+                    continue
