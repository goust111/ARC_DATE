+            in_patch = np.zeros(grid_shape, dtype=bool)
+            out_patch = np.zeros(grid_shape, dtype=bool)
+            for r, c in _abs_coords(in_shape, r0, c0):
+                in_patch[r, c] = True
+            for r, c in _abs_coords(out_shape, out_r0, out_c0):
