+    if len(mapping) >= len(colors):
+        return None
+    if not any(donor in mapping for donor in mapping.values()):
+        return None
+    if not any(shapes_by_color[a].shape != shapes_by_color[b].shape for a, b in mapping.items()):
+        return None
+    return mapping
