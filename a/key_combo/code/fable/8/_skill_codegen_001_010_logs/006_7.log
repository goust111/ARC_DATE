+        random.shuffle(candidates)
+        if not candidates:
+            return None
+
+        placed = False
+        for r0, c0 in candidates:
+            center_r = r0 + in_h // 2
+            center_c = c0 + in_w // 2
+            out_r0 = center_r - out_h // 2
+            out_c0 = center_c - out_w // 2
