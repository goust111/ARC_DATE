+        out_shape = placements[donor]["input_shape"]
+        center_r = info["r0"] + info["input_shape"].shape[0] // 2
+        center_c = info["c0"] + info["input_shape"].shape[1] // 2
+        out_r0 = center_r - out_shape.shape[0] // 2
+        out_c0 = center_c - out_shape.shape[1] // 2
