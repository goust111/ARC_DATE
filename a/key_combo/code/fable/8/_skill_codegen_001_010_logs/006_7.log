+def _place_objects(
+    shapes_by_color: dict[int, np.ndarray],
+    mapping: dict[int, int],
+    grid_shape: tuple[int, int],
+    reserved: np.ndarray,
+) -> dict[int, dict] | None:
+    input_forbidden = _dilate(reserved, _PLACEMENT_GAP)
+    output_forbidden = _dilate(reserved, _PLACEMENT_GAP)
