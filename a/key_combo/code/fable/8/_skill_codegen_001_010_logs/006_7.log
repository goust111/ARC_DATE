+    else:
+        for r in range(sub.shape[0]):
+            pairs.append((int(sub[r, 0]), int(sub[r, 1])))
+
+    lefts = [a for a, _b in pairs]
+    assert len(lefts) == len(set(lefts)), "legend source colors must be unique"
+    return legend_mask, pairs, box
