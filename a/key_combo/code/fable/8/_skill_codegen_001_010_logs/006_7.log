+                "output_shape": out_shape,
+                "r0": int(r0),
+                "c0": int(c0),
+                "out_r0": int(out_r0),
+                "out_c0": int(out_c0),
+            }
+            input_forbidden |= _dilate(in_patch, _PLACEMENT_GAP)
+            output_forbidden |= _dilate(out_patch, _PLACEMENT_GAP)
+            placed = True
+            break
+        if not placed:
+            return None
