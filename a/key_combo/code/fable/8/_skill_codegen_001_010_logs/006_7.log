+def _legend_start(grid_shape: tuple[int, int], pair_count: int, side: str) -> int | None:
+    h, w = grid_shape
+    if side in {"top", "bottom"}:
+        if w < pair_count + 2:
+            return None
+        return random.randint(1, w - pair_count - 1)
