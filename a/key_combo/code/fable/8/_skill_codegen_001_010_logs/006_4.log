+
+    out_sig = _block_signature(details["output"])
+    if out_sig in _SEEN_OUTPUT_SIGS:
+        return None
+    _SEEN_OUTPUT_SIGS.add(out_sig)
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(500):
+        grid = _gen_attempt(rng)
+        if grid is not None:
