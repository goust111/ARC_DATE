+    free = total - (sum(lengths) + (len(lengths) - 1))
+    if free < 2:
+        return None
+    extras = free - 2
+    buckets = [1] + [0] * (gaps - 2) + [1]
+    for _ in range(extras):
+        buckets[int(rng.integers(gaps))] += 1
