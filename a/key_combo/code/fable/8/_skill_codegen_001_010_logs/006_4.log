+
+def _block_signature(block: np.ndarray) -> str:
+    arr = np.asarray(block, dtype=int)
+    return hashlib.md5(arr.tobytes() + str(arr.shape).encode()).hexdigest()
+
+
+def _validate_semantics(grid: np.ndarray) -> bool:
