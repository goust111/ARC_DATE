+                if 0 <= nr < rows and 0 <= nc < cols and not mask[nr, nc]:
+                    candidates.append((nr, nc))
+            if not candidates:
+                continue
+            nr, nc = candidates[int(rng.integers(len(candidates)))]
+            mask[nr, nc] = True
+            frontier.add((rr, cc))
+            frontier.add((nr, nc))
