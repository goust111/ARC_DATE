    max_extra = RECT_HEIGHT_MAX - RECT_HEIGHT_MIN
    min_threes = max(0, extra - mid_extra * n)
    max_threes = extra // max_extra
    three_choices = np.arange(min_threes, max_threes + 1)
    if three_choices.size == 1:
