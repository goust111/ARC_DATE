    # Generate the background grid with size of n x m.
    n, m = 5, 3
    grid = np.zeros((m, n), dtype=int)

    # Randomly select the position of the red pixel and draw it.
    r, c = np.random.randint(0, m - 1), np.random.randint(0, n - 1)
    grid[r, c] = Color.RED
    return grid
