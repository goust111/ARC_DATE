+        hr0, hc0 = _dir_to_hole_top(frag["target_dir"])
+        out[
+            row_off + hr0 : row_off + hr0 + SLOT,
+            col_off + hc0 : col_off + hc0 + SLOT,
+        ][meta["holes"][frag["target_dir"]]] = frag["main_color"]
+    return out
+
