+
+
+def _deranged_targets(targets: list[tuple[int, int]], pool: list[tuple[int, int]], rng: random.Random) -> list[tuple[int, int]]:
+    assert len(targets) == len(pool) and len(targets) >= 2
+    for _ in range(200):
