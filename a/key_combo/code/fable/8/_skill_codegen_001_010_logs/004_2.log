+        hr0, hc0, hr1, hc1 = map(int, comp["bbox"])
+        direction = _direction_from_point((hr0 + hr1) / 2.0, (hc0 + hc1) / 2.0, rect_center_r, rect_center_c)
+        assert direction not in holes, "hole directions must be unique"
