+    (-1, 0): (0, OUTER_CENTER_LEFT),
+    (-1, 1): (0, BASE_SIZE - SLOT),
+    (0, -1): (OUTER_CENTER_TOP, 0),
+    (0, 1): (OUTER_CENTER_TOP, BASE_SIZE - SLOT),
+    (1, -1): (BASE_SIZE - SLOT, 0),
