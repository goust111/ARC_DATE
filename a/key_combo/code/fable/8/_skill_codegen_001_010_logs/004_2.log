+def _render_fragment(mask: np.ndarray, direction: tuple[int, int], main_color: int, marker_color: int, rng: random.Random) -> np.ndarray:
+    patch = np.zeros((SLOT, SLOT), dtype=int)
+    patch[mask] = int(main_color)
