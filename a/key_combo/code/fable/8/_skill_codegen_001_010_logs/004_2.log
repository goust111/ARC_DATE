+def _embed_with_padding(base: np.ndarray, rng: random.Random) -> np.ndarray:
+    top = rng.randint(0, 1)
+    bottom = rng.randint(0, 1)
+    left = rng.randint(0, 1)
+    right = rng.randint(0, 1)
+    grid = np.zeros((base.shape[0] + top + bottom, base.shape[1] + left + right), dtype=int)
+    grid[top : top + base.shape[0], left : left + base.shape[1]] = base
+    return grid
