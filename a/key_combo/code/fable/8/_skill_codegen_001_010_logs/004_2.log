def _gen_attempt() -> np.ndarray | None:
    fill_color, marker_color = random.sample(_GEN_COLOR_RANGE, 2)
    corner_seed = _gen_corner_seed()
    edge_seed = _gen_edge_seed()
    slot_masks = _gen_slot_masks(corner_seed, edge_seed)
