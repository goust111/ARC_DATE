+def _render_base_input(meta: dict) -> np.ndarray:
+    grid = np.zeros((BASE_SIZE, BASE_SIZE), dtype=int)
+    grid[RECT_TOP : RECT_TOP + RECT_SIZE, RECT_LEFT : RECT_LEFT + RECT_SIZE] = RECT
+
