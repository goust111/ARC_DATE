def _sgn(value: float) -> int:
    if value < 0:
        return -1
    if value > 0:
        return 1
    return 0


def _direction_from_point(point_r: float, point_c: float, center_r: float, center_c: float) -> tuple[int, int]:
    direction = (_sgn(point_r - center_r), _sgn(point_c - center_c))
