+    hole_grid = (rect_patch == bg).astype(int)
+    hole_comps = find_components(hole_grid, bg=0, connectivity=4, monochromatic=True)
+    rect_center_r = (rect_patch.shape[0] - 1) / 2.0
+    rect_center_c = (rect_patch.shape[1] - 1) / 2.0
