+    return None
+
+
+def _dot_candidates(
+    shape: tuple[int, int],
+    forbidden: set[tuple[int, int]],
+    protected: set[tuple[int, int]],
+) -> list[tuple[int, int]]:
+    h, w = map(int, shape)
+    candidates = []
+    for r in range(h):
+        for c in range(w):
+            cell = (r, c)
+            if cell in forbidden:
+                continue
+            if any(_chebyshev_distance(cell, other) <= 1 for other in protected):
+                continue
+            candidates.append(cell)
+    random.shuffle(candidates)
+    return candidates
+
