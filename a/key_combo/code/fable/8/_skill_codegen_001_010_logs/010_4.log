import numpy as np, random

DIV_TOL = 0.08
GAP = 0.12

def tile_fill(shape, tile):
    H,W = shape
    h,w = tile.shape
    out = np.empty((H,W), dtype=int)
    for r in range(H):
        for c in range(W):
            out[r,c] = tile[r%h, c%w]
    return out

def scores_1d(g, axis):
    n = g.shape[axis]
    limit = max(1, n//2)
    vals=[]
    for s in range(1, limit+1):
        eq = (g[:-s,:] == g[s:,:]) if axis==0 else (g[:,:-s] == g[:,s:])
        vals.append(eq.mean())
    return vals

def infer(g, axis):
    vals = scores_1d(g, axis)
    best = max(range(1,len(vals)+1), key=lambda s: vals[s-1])
    cur = best
    while True:
        divisors = [d for d in range(1, cur) if cur % d == 0]
        downs = [d for d in divisors if vals[d-1] >= vals[cur-1] - DIV_TOL]
        if not downs:
            return cur, vals
        cur = min(downs)

def primitive(tile):
    pr,pc = tile.shape
    for s in range(1,pr):
        if np.array_equal(tile[:-s,:], tile[s:,:]): return False
    for s in range(1,pc):
        if np.array_equal(tile[:,:-s], tile[:,s:]): return False
    return True

def separated(wall, p, axis):
    vals = scores_1d(wall, axis)
    true = vals[p-1]
    ok = True
    for s,v in enumerate(vals, start=1):
        if s == p or (s % p == 0):
            continue
        if true < v + GAP:
            ok = False
    # divisor gap stronger
    for s,v in enumerate(vals, start=1):
        if s < p and p % s == 0:
            if true < v + GAP:
                ok = False
    return ok, vals

success=0
for _ in range(500):
    pr = random.randint(2,5)
    pc = random.randint(2,5)
    H = random.randint(pr*3, min(24, pr*5))
    W = random.randint(pc*3, min(24, pc*5))
    colors = random.sample(range(1,10), random.randint(3,5))
    for _j in range(200):
        tile = np.array([[random.choice(colors) for _ in range(pc)] for _ in range(pr)])
        if not primitive(tile):
            continue
        wall = tile_fill((H,W), tile)
        okr, rv = separated(wall, pr, 0)
        okc, cv = separated(wall, pc, 1)
        if okr and okc:
            break
    else:
        continue
    # rough stamp disturbance
    g=wall.copy()
    h,w=random.randint(4, min(8,H-1)), random.randint(4, min(8,W-1))
    r0=random.randint(0,H-h); c0=random.randint(0,W-w)
    # color patch from palette
    block=np.array([[random.choice(colors) for _ in range(w)] for _ in range(h)])
    g[r0:r0+h,c0:c0+w]=block
    ir,_=infer(g,0); ic,_=infer(g,1)
    if (ir,ic)==(pr,pc):
        success+=1
    else:
        print('fail', (pr,pc),'->',(ir,ic),'row scores top',sorted([(i+1,v) for i,v in enumerate(scores_1d(g,0))], key=lambda x:x[1], reverse=True)[:5], 'col', sorted([(i+1,v) for i,v in enumerate(scores_1d(g,1))], key=lambda x:x[1], reverse=True)[:5])
        break
print('success',success)
