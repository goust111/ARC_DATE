+    pr, pc = tile.shape
+    for shift in range(1, pr):
+        if np.array_equal(tile[:-shift, :], tile[shift:, :]):
+            return False
+    for shift in range(1, pc):
+        if np.array_equal(tile[:, :-shift], tile[:, shift:]):
+            return False
+    return True
