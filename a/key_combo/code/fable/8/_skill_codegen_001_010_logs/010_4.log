def tile_fill(shape, tile):
    H,W = shape
    h,w = tile.shape
    out = np.empty((H,W), dtype=int)
    for r in range(H):
        for c in range(W):
            out[r,c] = tile[r%h, c%w]
    return out


def infer_period_1d(g, axis):
    n = g.shape[axis]
    scores=[]
    for s in range(1,n):
        if axis==0:
            eq = g[:-s,:] == g[s:,:]
        else:
            eq = g[:,:-s] == g[:,s:]
        scores.append(eq.mean())
    best = max(scores)
    cands=[i+1 for i,v in enumerate(scores) if v >= best - 0.03]
    return min(cands), best, sorted(((i+1,v) for i,v in enumerate(scores)), key=lambda x:x[1], reverse=True)[:5]


def rebuild(g, pr, pc):
