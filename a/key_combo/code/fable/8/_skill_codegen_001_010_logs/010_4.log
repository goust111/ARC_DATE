import numpy as np, random

def tile_fill(shape, tile):
    H,W=shape; h,w=tile.shape
    out=np.empty((H,W),int)
    for r in range(H):
        for c in range(W):
            out[r,c]=tile[r%h,c%w]
    return out

def rebuild(g, pr, pc):
    H,W=g.shape; wall=np.zeros_like(g)
    maj_margin=999
    for rr in range(pr):
        rs=np.arange(rr,H,pr)
        for cc in range(pc):
            cs=np.arange(cc,W,pc)
            vals=g[np.ix_(rs,cs)].ravel()
            uniq,cnts=np.unique(vals, return_counts=True)
            order=np.argsort(-cnts)
            col=uniq[order[0]]
            wall[np.ix_(rs,cs)] = col
            if len(cnts)>1:
                maj_margin=min(maj_margin, cnts[order[0]]-cnts[order[1]])
            else:
                maj_margin=min(maj_margin, cnts[order[0]])
    mis=np.count_nonzero(wall"'!=g)
    return wall, mis, maj_margin

def choose(g):
    H,W=g.shape
    best=None
    maxp=min(8,H//2,W//2)
    for pr in range(1,min(8,H//2)+1):
      for pc in range(1,min(8,W//2)+1):
        wall, mis, marg = rebuild(g,pr,pc)
        score=(mis, -(marg), pr*pc, pr+pc)  # smaller mis, larger margin, smaller period
        if best is None or score<best[0]:
          best=(score,(pr,pc),wall)
    return best

def gen_stamp(h,w,wall_window,palette):
    hw=w//2
    ext=[]
    cur=random.randint(max(1,hw//2),hw)
    for r in range(h):
        if r==0 or r==h-1:
            cur=max(1, min(hw, cur + random.choice([-1,0,1])))
        else:
            cur=max(1, min(hw, cur + random.choice([-1,0,1])))
        ext.append(cur)
    if max(ext)<hw:
        ext[random.randrange(h)]=hw
    mask=np.zeros((h,w),bool)
    for r,e in enumerate(ext):
        l=hw-e
        mask[r,l:w-l]=True
    # colors context-based
    stamp=np.zeros((h,w),int)
    asym=0
    hidden=0
    vis=0
    for r in range(h):
        for c in range((w+1)//2):
            mc=w-1-c
            if not mask[r,c] and not mask[r,mc]:
                continue
            if c==mc:
                ww=wall_window[r,c]
                choices=[p for p in palette if p!=ww]
                col=random.choice(choices)
                stamp[r,c]=col; vis+=1
            else:
                lw=wall_window[r,c]; rw=wall_window[r,mc]
                if lw!=rw and random.random()<0.55:
                    col=random.choice([lw,rw])
                else:
                    choices=[p for p in palette if p!=lw or p!=rw]
                    col=random.choice(choices)
                stamp[r,c]=stamp[r,mc]=col
                lv=col!=lw; rv=col!=rw
                hidden += (not lv)+(not rv)
                vis += lv+rv
                asym += (lv != rv)
    return mask, stamp, hidden, vis, asym

success=0
for t in range(200):
    pr=random.randint(2,5); pc=random.randint(2,5)
    H=random.randint(max(15,pr*3), min(24, pr*5))
    W=random.randint(max(15,pc*3), min(24, pc*5))
    palette=random.sample(range(1,10), random.randint(4,6))
    for _ in range(100):
        tile=np.array([[random.choice(palette) for _ in range(pc)] for _ in range(pr)])
        # primitive
        ok=True
        for s in range(1,pr):
            if np.array_equal(tile[:-s,:], tile[s:,:]): ok=False
        for s in range(1,pc):
            if np.array_equal(tile[:,:-s], tile[:,s:]): ok=False
        if ok: break
    wall=tile_fill((H,W), tile)
    good=False
    for _ in range(200):
        h=random.randint(4,min(9,H-2)); w=random.randint(4,min(9,W-2))
        r0=random.randint(0,H-h); c0=random.randint(0,W-w)
        mask, stamp, hidden, vis, asym = gen_stamp(h,w,wall[r0:r0+h,c0:c0+w], palette)
        g=wall.copy()
        sub=g[r0:r0+h,c0:c0+w]
        sub[mask]=stamp[mask]
        visible = mask & (stamp != wall[r0:r0+h,c0:c0+w])
        if hidden<=0 or asym<=0: continue
        coords=np.argwhere(visible)
        if len(coords)==0: continue
        rmin,cmin=coords.min(0); rmax,cmax=coords.max(0)
        if (rmin,cmin,rmax,cmax)!=(0,0,h-1,w-1): continue
        # every pair at least one visible
        ok=True
        for r in range(h):
            for c in range((w+1)//2):
                mc=w-1-c
                if not mask[r,c] and not mask[r,mc]:
                    continue
                if c==mc:
                    if not visible[r,c]: ok=False
                else:
                    if not (visible[r,c] or visible[r,mc]): ok=False
        if not ok: continue
        best=choose(g)
        pred=best[1]
        if pred==(pr,pc):
            good=True; success+=1; break
    if not good:
        print('"'failed instance true', (pr,pc), 'chosen', pred, 'score', best[0], 'shape', g.shape)
        break
print('success', success)
