        return [(r, c, r + rh - 1, c + rw - 1)]

    pos1 = [(r, c) for r in range(h - dims[1][0] + 1) for c in range(w - dims[1][1] + 1)]
    valid: list[tuple[tuple[int, int], tuple[int, int]]] = []
    rh0, rw0 = dims[0]
