+    current_length = int(length)
+    for idx, row in enumerate(blocker_rows):
+        if current_length == 1:
+            return 1, int(row - 1), blocker_rows[idx:]
+        current_length -= 1
+
+    top = height - current_length
+    return current_length, int(top), []
+
+
