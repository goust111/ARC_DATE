GENERATION_RETRIES = 300


def _gen_attempt() -> np.ndarray:
    h, w = GRID_SHAPE
    lo, hi = FILL_COLOR_RANGE
    g = np.random.randint(lo, hi, size=GRID_SHAPE, dtype=int)

