+    h, w = g.shape
+    out = np.full_like(g, BLACK)
+    for c in range(w):
+        length, color, blockers = _parse_column(g, c)
+        for row in blockers:
+            out[row, c] = GREY
+        if length == 0:
+            continue
+        if blockers:
+            top = blockers[0] - length
+        else:
+            top = h - length
+        out[top : top + length, c] = color
+    return out
+
