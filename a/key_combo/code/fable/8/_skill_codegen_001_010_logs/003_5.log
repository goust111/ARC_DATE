+    column_mains = [_dominant_color(g[:, c]) for c in range(w)]
+    runs: list[tuple[int, int, int]] = []
+    c0 = 0
+    while c0 < w:
+        main = int(column_mains[c0])
+        c1 = c0 + 1
+        while c1 < w and int(column_mains[c1]) == main:
