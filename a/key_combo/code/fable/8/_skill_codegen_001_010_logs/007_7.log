+    left_cols: list[tuple[int, ...]] = []
+    right_cols: list[tuple[int, ...]] = []
+
+    for idx, piece in enumerate(pieces):
+        left_fp = _fingerprint(piece[:, 0])
+        right_fp = _fingerprint(piece[:, -1])
+        left_cols.append(left_fp)
+        right_cols.append(right_fp)
