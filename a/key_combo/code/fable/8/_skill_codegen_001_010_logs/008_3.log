+    return grown
+
+
+def _build_offset_mask(h: int, w: int) -> np.ndarray | None:
+    for _ in range(40):
+        box_h = random.randint(2, h - 1)
+        box_w = random.randint(2, w - 1)
+        r0 = random.randint(0, h - box_h)
+        c0 = random.randint(0, w - box_w)
+        r1 = r0 + box_h - 1
+        c1 = c0 + box_w - 1
