+        start = (random.randrange(box_h), random.randrange(box_w))
+        local[start] = True
+        target = random.randint(3, max(3, min(box_h * box_w - 1, box_h * box_w)))
+        grown = _grow_mask(local, target)
+        if grown is None:
+            continue
