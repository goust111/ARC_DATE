+            return None
+        mask = _build_full_span_mask(h, w)
+    if mask is None:
+        return None
+
+    grid = _paint_grid(mask)
+    if grid is None:
+        return None
+    return grid if _validate_semantics(grid, require_padding=require_padding) else None
