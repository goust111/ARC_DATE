+    bg = int(np.count_nonzero(grid == BACKGROUND))
+    majority = int(np.count_nonzero(grid == majority_color))
+    minority = int(np.count_nonzero(grid == minority_color))
+    if not (bg > majority > minority >= 1):
+        return None
+    return grid
+
