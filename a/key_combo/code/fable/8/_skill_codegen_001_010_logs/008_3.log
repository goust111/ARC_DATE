+def _choose_minority(mask: np.ndarray, count: int) -> set[Coord] | None:
+    cells = [tuple(map(int, rc)) for rc in np.argwhere(mask)]
+    mode = random.choice(("cluster", "scatter", "double_cluster"))
+
