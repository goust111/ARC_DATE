+    area = h * w
+    base_count = int(mask.sum())
+    minority_floor = max(1, 2 * base_count - area + 1)
+    if minority_floor > base_count // 2:
+        return None
+
+    extra = random.randint(0, max(0, min(area - 1, base_count + 4) - base_count))
+    grown = _grow_mask(mask, base_count + extra)
+    if grown is None:
+        return None
+    box = _bbox(grown)
+    if box != (0, 0, h - 1, w - 1):
