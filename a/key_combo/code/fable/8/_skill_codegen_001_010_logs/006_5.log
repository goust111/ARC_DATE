+def _components_mask_local(mask: np.ndarray, connectivity: int = 4) -> list[np.ndarray]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    if int(connectivity) == 4:
+        steps = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+    else:
