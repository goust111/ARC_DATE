        area = (int(r1) - int(r0) + 1) * (int(c1) - int(c0) + 1)
        mins.append(GEN_ZONE_MIN_TARGET)
        caps.append(max(GEN_ZONE_MIN_TARGET, int(area * GEN_ZONE_CAP_RATIO)))
    if total < sum(mins) or total > sum(caps):
        return None

