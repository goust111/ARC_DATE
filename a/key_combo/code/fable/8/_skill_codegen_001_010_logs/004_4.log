    sprite_h, sprite_w = map(int, mask.shape)
    assert sprite_h > 0 and sprite_w > 0, "sprite bbox must be nonempty"

    out = np.full(g.shape, int(bg), dtype=int)
    for row_slot, rr in enumerate(range(r0, g.shape[0], sprite_h + 1)):
