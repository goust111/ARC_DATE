+def _attempt_generate(rng: random.Random) -> np.ndarray | None:
+    h = rng.randint(_GRID_MIN, _GRID_MAX)
+    w = rng.randint(_GRID_MIN, _GRID_MAX)
+    rows = _slot_coords(h)
+    cols = _slot_coords(w)
