+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in neighbors4(rr, cc):
+                    if not in_bounds(g.shape, nr, nc) or seen[nr, nc] or int(g[nr, nc]) != color:
