+
+
+def _translate(cells: set[tuple[int, int]], origin: tuple[int, int]) -> set[tuple[int, int]]:
+    r0, c0 = origin
+    return {(r0 + r, c0 + c) for r, c in cells}
+
+
+def _paint_blob(grid: np.ndarray, cells: set[tuple[int, int]], color: int) -> None:
