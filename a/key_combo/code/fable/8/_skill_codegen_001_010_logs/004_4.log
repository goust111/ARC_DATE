+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                out.add((r + dr, c + dc))
+    return out
+
+
+def _oracle_output(grid: np.ndarray, centers: list[tuple[int, int, int]]) -> np.ndarray:
+    out = grid.copy()
