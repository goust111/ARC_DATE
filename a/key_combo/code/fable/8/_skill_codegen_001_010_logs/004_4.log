+    center_specs = [
+        ((r_mid, c_left), color_row),
+        ((r_mid, c_mid), color_mid),
+        ((r_mid, c_right), color_row),
+        ((r_top, c_mid), color_col),
+        ((r_bot, c_mid), color_col),
+    ]
+
+    grid = np.zeros((h, w), dtype=int)
+    reserved = set()
