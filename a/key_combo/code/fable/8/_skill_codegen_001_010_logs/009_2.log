+    return tiles if _semantic_instance_ok(tiles, color_a, color_b) else None
+
+
+def _render_grid(
+    rows: int,
+    cols: int,
+    h: int,
+    w: int,
+    tiles: list[np.ndarray],
+    separator: int,
+) -> np.ndarray:
+    grid = np.full((rows * h + rows + 1, cols * w + cols + 1), int(separator), dtype=int)
+    idx = 0
+    for tile_r in range(rows):
