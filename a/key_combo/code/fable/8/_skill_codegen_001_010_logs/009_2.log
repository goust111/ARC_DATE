+        return None
+
+    if not np.array_equal(actual, expected):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_MAX_ATTEMPTS):
+        grid = _generate_one()
+        if grid is not None:
+            return grid
