+    if count < 1 or len(pool) < count:
+        return None
+
+    seed = random.choice(tuple(pool))
+    chosen = {seed}
+    frontier = {nbr for nbr in _neighbors4(seed, h, w) if nbr in pool}
+    while len(chosen) < count:
