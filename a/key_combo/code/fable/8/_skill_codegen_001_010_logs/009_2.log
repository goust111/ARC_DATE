+
+
+def _build_tile_set(h: int, w: int, color_a: int, color_b: int, pair_count: int) -> list[np.ndarray] | None:
+    used: set[bytes] = set()
+    seeds: list[np.ndarray] = []
+
+    area = h * w
+    for _ in range(80):
+        occ = random.randint(max(8, area // 2), area - 1)
+        count_a = random.randint(2, occ - 2)
+        count_b = occ - count_a
+        if count_a == count_b:
