+) -> np.ndarray | None:
+    area = h * w
+    for _ in range(120):
+        if counts is None:
+            occ = random.randint(max(6, area // 2), area - 1)
+            count_a = random.randint(2, occ - 2)
+            count_b = occ - count_a
+        else:
+            count_a, count_b = counts
+            occ = count_a + count_b
+        if min(count_a, count_b) < 2 or occ >= area:
