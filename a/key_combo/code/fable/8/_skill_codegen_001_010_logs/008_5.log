    horizontal = [(l, r) for l in range(lo, hi + 1) for r in range(lo, hi + 1) if l + hole_w + r <= MAX_PATCH_DIM]
    top, bottom = random.choice(vertical)
    left, right = random.choice(horizontal)

    h = top + hole_h + bottom
    w = left + hole_w + right
    patch = np.full((h, w), int(color), dtype=int)
