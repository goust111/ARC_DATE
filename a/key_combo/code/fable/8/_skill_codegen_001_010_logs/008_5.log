+from __future__ import annotations
+
+from collections import Counter
+import random
+
+import numpy as np
+
+
+GREY = 5
+PALETTE = list(range(10))
+DIAGONALS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]
+MAX_ATTEMPTS = 500
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
