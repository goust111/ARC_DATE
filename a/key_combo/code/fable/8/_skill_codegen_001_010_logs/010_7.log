+
+def _random_marker(top: int, left: int, h: int, w: int, *, forbid_left: bool) -> tuple[int, int] | None:
+    choices = []
+    if top >= 1:
+        choices.extend((top - 1, c) for c in range(left, left + w))
+    choices.extend((top + h, c) for c in range(left, left + w))
