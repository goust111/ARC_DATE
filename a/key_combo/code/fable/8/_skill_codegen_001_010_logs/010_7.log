+def _can_place(candidate: set[tuple[int, int]], occupied: set[tuple[int, int]]) -> bool:
+    if candidate & occupied:
+        return False
+    for r, c in candidate:
+        for nr, nc in _neighbors4(r, c):
+            if (nr, nc) in occupied:
+                return False
+    return True
