+        body = comp["coords"].astype(int, copy=True)
+        body_set = {tuple(map(int, cell)) for cell in body.tolist()}
+        adjacent_markers = []
+        for mr, mc in marker_set:
+            for br, bc in body_set:
+                if abs(mr - br) + abs(mc - bc) == 1:
+                    adjacent_markers.append((mr, mc))
+                    break
