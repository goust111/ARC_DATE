+    stack = [0]
+    while stack:
+        cur = stack.pop()
+        for nxt, hit in enumerate(overlap[cur]):
+            if hit and nxt not in seen:
+                seen.add(nxt)
+                stack.append(nxt)
+    return len(seen) == n
+
+
