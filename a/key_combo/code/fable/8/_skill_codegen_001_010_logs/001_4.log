+    seq = [counts[idx] for idx in order]
+    has_rise = any(seq[i] < seq[i + 1] for i in range(len(seq) - 1))
+    has_fall = any(seq[i] > seq[i + 1] for i in range(len(seq) - 1))
+    if not (has_rise and has_fall):
+        return False
