        area = random.choice(possible)
        rects.append(random.choice(area_to_dims[area]))
        remaining -= area

    if remaining != 0:
        return []
    random.shuffle(rects)
    return sorted(rects, key=lambda hw: hw[0] * hw[1], reverse=True)


