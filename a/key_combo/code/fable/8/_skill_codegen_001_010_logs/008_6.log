+        while int(mask.sum()) < target_area:
+            frontier = _mask_frontier(mask)
+            mask[random.choice(frontier)] = True
+
+        if _bbox_coords(np.argwhere(mask)) != (0, 0, h - 1, w - 1):
+            continue
+        if np.array_equal(mask, np.fliplr(mask)):
