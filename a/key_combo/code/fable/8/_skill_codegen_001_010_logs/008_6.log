            if _loc is None:
                raise ValueError("no placement")
            r, c = _loc
        except:
            continue

        paste(grid, obj, r, c, transparent=Color.BLACK, clip=True)

    # Make sure that we actually generated something
    if np.all(grid == Color.BLACK):
        return generate_input()
    
    return grid
