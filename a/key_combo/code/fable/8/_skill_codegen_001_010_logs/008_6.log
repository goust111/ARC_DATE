+
+def _random_object_mask() -> np.ndarray:
+    for _ in range(400):
+        h = random.randint(4, 7)
+        w = random.randint(4, 7)
+        area_lo = max(6, h + w - 2)
+        area_hi = min(h * w - 2, (3 * h * w) // 4)
+        if area_lo > area_hi:
+            continue
+
+        mask = np.zeros((h, w), dtype=bool)
