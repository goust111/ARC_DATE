+BACKGROUND = Color.BLACK
+GRID_RANGE = (12, 24)
+BOX_SIDE_RANGE = (6, 13)
+VALID_PIXEL_RANGE = (4, 8)
+DECOY_PIXEL_RANGE = (1, 4)
