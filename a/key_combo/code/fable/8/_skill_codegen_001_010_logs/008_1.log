+def _border_coords(box: BBox) -> set[Coord]:
+    r0, c0, r1, c1 = box
+    coords: set[Coord] = set()
+    for c in range(c0, c1 + 1):
+        coords.add((r0, c))
+        coords.add((r1, c))
+    for r in range(r0, r1 + 1):
+        coords.add((r, c0))
+        coords.add((r, c1))
+    return coords
+
