+        if src in box_cells:
+            continue
+        assert not _strictly_inside(box, src), "box interior must be empty in the input"
+        target = _axis_reflect(box, gap, src) if use_axis_reflection else _point_reflect(gap, src)
+        if _strictly_inside(box, target):
