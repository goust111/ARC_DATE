    lab, n = label_mask(mask, connectivity=connectivity)
    return [np.argwhere(lab == k) for k in range(1, n + 1)]


def find_components(
    grid: np.ndarray,
    *,
    bg: int | None = None,
    connectivity: int = 4,
    monochromatic: bool = True,
    colors: Sequence[int] | None = None,
