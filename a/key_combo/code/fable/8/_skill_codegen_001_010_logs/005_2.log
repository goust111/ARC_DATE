+    valid_counts = [n for n in range(min_parts, max_parts + 1) if lo * n <= total <= hi * n]
+    if not valid_counts:
+        return None
+    parts = int(rng.choice(valid_counts))
+    values: list[int] = []
+    remaining = int(total)
+    for i in range(parts):
+        slots = parts - i - 1
+        low = max(lo, remaining - hi * slots)
+        high = min(hi, remaining - lo * slots)
