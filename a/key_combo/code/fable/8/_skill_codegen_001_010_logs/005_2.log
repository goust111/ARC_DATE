            return 1, _gen_randint(_GEN_LEAF_LINE_LENGTH_RANGE)
        return _gen_randint(_GEN_LEAF_LINE_LENGTH_RANGE), 1
    return _gen_randint(_GEN_LEAF_HEIGHT_RANGE), _gen_randint(_GEN_LEAF_WIDTH_RANGE)


