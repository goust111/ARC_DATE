+            seed = tuple(map(int, overlap_seeds[int(rng.integers(len(overlap_seeds)))]))
+        b = _random_rectilinear_mask(h, w, rng, seed=seed)
+
+        cats = _truth_categories(a, b)
+        if all(len(cats[name]) > 0 for name in ("00", "10", "01", "11")):
+            return a, b
