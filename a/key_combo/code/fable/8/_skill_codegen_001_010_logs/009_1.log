+def _neighbors(r: int, c: int, shape: tuple[int, int], connectivity: int) -> list[Coord]:
+    h, w = shape
+    offsets = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+    if connectivity == 8:
+        offsets += [(-1, -1), (-1, 1), (1, -1), (1, 1)]
+    out = []
+    for dr, dc in offsets:
