+        if len(_top_left_candidates_from_next(cell_h, cell_w, sprite_mask, positions[missing_idx + 1])) <= 1:
+            return False
+        if len(_indicator_slots(cell_h, cell_w, sprite_mask, positions[missing_idx])) <= 1:
+            return False
+    else:
+        if vectors[-1] == vectors[-2]:
+            return False
+
