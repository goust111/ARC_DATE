_GEN_PERIOD_MIN, _GEN_PERIOD_MAX = 1, 3
_GEN_SHIFT_MIN, _GEN_SHIFT_MAX = 0, 2
_GEN_INPUT_HEIGHT_MIN, _GEN_INPUT_HEIGHT_MAX = 5, 8

