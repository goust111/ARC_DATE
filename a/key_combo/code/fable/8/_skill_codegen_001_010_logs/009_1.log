+    inp, out = _render_sequence(
+        orientation=orientation,
+        bg=bg,
+        sep=sep,
+        sprite_color=sprite_color,
+        indicator_color=indicator_color,
+        sprite_mask=sprite_mask,
+        positions=positions,
+        missing_idx=missing_idx,
+        cell_h=cell_h,
+        cell_w=cell_w,
