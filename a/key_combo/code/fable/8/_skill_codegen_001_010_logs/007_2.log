  10: # In the input image you will see several teal pixels and two 2x2 red squares on the black background.
  11: # If the 2x2 red squares are connected by a path of teal pixels, then output a 1x1 teal grid, otherwise, output a 1x1 black grid. 
  12: 
  13: def main(input_grid):
  14:     """
  15:     Output teal if the two red squares belong to one non-black connected component, otherwise black.
  16: 
  17:     Input structure:
  18:     - The grid has a black background.
  19:     - Two separated 2 by 2 red squares are present.
  20:     - Teal pixels may form a 4-connected path between the red squares.
  21: 
  22:     Rule:
  23:     - Build connected components over all non-black cells, ignoring color differences.
  24:     - Check whether any component contains every red-square cell.
  25:     - Return a 1 by 1 teal grid if connected, or a 1 by 1 black grid if not.
  26: 
  27:     Key insight:
  28:     - The task is a connectivity test where teal pixels can bridge the two red objects.
  29:     """
  30:     # make output grid
  31:     output_grid = np.zeros((1,1), dtype=int)
  32: 
  33:     # get just the red squares
  34:     red_squares = np.zeros_like(input_grid)
  35:     red_squares[input_grid == Color.RED] = Color.RED
  36: 
  37:     # get all components that are connected, regardless of color
  38:     connected_components = find_components(
  39:         input_grid,
  40:         bg=Color.BLACK,
  41:         connectivity=4,
  42:         monochromatic=False,
  43:         return_format="objects",
  44:     )
  45: 
  46:     # check each connected component to see if it contains both red squares
  47:     for connected_component in connected_components:
  48:         # if it contains both red squares, output teal grid
  49:         if np.all(connected_component[red_squares == Color.RED] == Color.RED):         
  50:             output_grid[:,:] = Color.TEAL
  51:             return output_grid
  52: 
  53:     # if none of the connected components contain both red squares, output black grid
  54:     output_grid[:,:] = Color.BLACK
  55:     return output_grid
  56: 
