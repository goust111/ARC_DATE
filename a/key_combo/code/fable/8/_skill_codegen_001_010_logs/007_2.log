+def _plus_shield(center: tuple[int, int], shape: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = center
+    shield = []
+    for rr in range(r - 4, r + 5):
+        for cc in range(c - 4, c + 5):
+            if _in_bounds(shape, rr, cc):
+                shield.append((rr, cc))
+    return shield
+
