+        if _in_bounds(top.shape, rr, cc):
+            if top[rr, cc] or bottom[rr, cc]:
+                return False
+    return True
+
+
+def _add_shared_points(
+    rng: np.random.Generator,
+    output_blocked: np.ndarray,
+    top: np.ndarray,
+    bottom: np.ndarray,
+) -> int:
