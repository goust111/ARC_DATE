+    count = 0
+    candidates = [(r, c) for r in range(top.shape[0]) for c in range(top.shape[1])]
+    rng.shuffle(candidates)
+    target = int(rng.integers(1, min(7, len(candidates)) + 1))
+    for r, c in candidates:
+        if count >= target:
