+
+
+def _add_shared_points(
+    rng: np.random.Generator,
+    output_blocked: np.ndarray,
+    top: np.ndarray,
+    bottom: np.ndarray,
+) -> int:
+    shared_blocked = output_blocked.copy()
+    count = 0
+    candidates = [(r, c) for r in range(top.shape[0]) for c in range(top.shape[1])]
+    rng.shuffle(candidates)
