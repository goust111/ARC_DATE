+        )
+
+    for coords, color in pending_moves:
+        out[coords[:, 0], coords[:, 1]] = int(color)
+    return out
+
+
+def _draw_frame(grid: np.ndarray, bbox: tuple[int, int, int, int], color: int) -> None:
+    r0, c0, r1, c1 = bbox
