+        return ir0 + row_gap, ic0 + col_gap
+    if anchor == "ur":
+        return ir0 + row_gap, ic1 - pw + 1 - col_gap
+    if anchor == "ll":
+        return ir1 - ph + 1 - row_gap, ic0 + col_gap
+    return ir1 - ph + 1 - row_gap, ic1 - pw + 1 - col_gap
