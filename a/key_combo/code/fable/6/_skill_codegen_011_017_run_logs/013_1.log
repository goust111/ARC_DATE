+    ir0, ic0, ir1, ic1 = interior_bbox
+    return {
+        "ul": int(sr0 - ir0 + sc0 - ic0),
+        "ur": int(sr0 - ir0 + ic1 - sc1),
+        "ll": int(ir1 - sr1 + sc0 - ic0),
+        "lr": int(ir1 - sr1 + ic1 - sc1),
