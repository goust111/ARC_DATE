+                "parent": None,
+                "anchor": rng.choice(high_anchor_choices),
+                "z": 2,
+            },
+        ]
+        low_bbox = _place_relative_box(
+            root_bbox,
+            rng.randint(*FRAME_SIZE_RANGE),
+            rng.randint(*FRAME_SIZE_RANGE),
+            low_corner,
+            shape,
+            rng,
+        )
+        high_bbox = _place_relative_box(
+            root_bbox,
+            rng.randint(*FRAME_SIZE_RANGE),
+            rng.randint(*FRAME_SIZE_RANGE),
+            high_corner,
+            shape,
+            rng,
