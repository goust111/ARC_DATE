+    if anchor == "ul":
+        new_r0 = nr0 + (sr0 - ir0)
+        new_c0 = nc0 + (sc0 - ic0)
+    elif anchor == "ur":
+        new_r0 = nr0 + (sr0 - ir0)
+        new_c0 = nc1 - (ic1 - sc1) - w + 1
+    elif anchor == "ll":
+        new_r0 = nr1 - (ir1 - sr1) - h + 1
+        new_c0 = nc0 + (sc0 - ic0)
+    else:
+        new_r0 = nr1 - (ir1 - sr1) - h + 1
+        new_c0 = nc1 - (ic1 - sc1) - w + 1
+
+    delta = np.array([new_r0 - sr0, new_c0 - sc0], dtype=int)
+    moved = coords + delta
+    assert _coords_inside_bbox(moved, new_interior), "moved sprite must fit in destination interior"
+    return moved
