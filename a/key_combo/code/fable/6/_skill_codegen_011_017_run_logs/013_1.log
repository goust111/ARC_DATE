+        for _ in range(80):
+            h = rng.randint(*FRAME_SIZE_RANGE)
+            w = rng.randint(*FRAME_SIZE_RANGE)
+            r0 = rng.randint(0, shape[0] - h)
+            c0 = rng.randint(0, shape[1] - w)
