+                rng.randint(*FRAME_SIZE_RANGE),
+                corner,
+                shape,
+                rng,
+            )
+            if child_bbox is None:
+                return None
+            frames.append(
+                {
+                    "bbox": child_bbox,
+                    "color": int(colors[index]),
+                    "parent": 0,
+                    "anchor": corner,
+                    "z": 0,
