+
+
+GEN_MAX_ATTEMPTS = 600
+GRID_MIN = 20
+GRID_MAX = 24
+FRAME_SIZE_RANGE = (6, 8)
+CORNERS = ("ul", "ur", "ll", "lr")
+OPPOSITE = {"ul": "lr", "ur": "ll", "ll": "ur", "lr": "ul"}
