+
+def _transfer_edges(grid: np.ndarray, frames: list[dict]) -> dict[int, int]:
+    edges: dict[int, int] = {}
+    for i in range(len(frames)):
+        for j in range(i + 1, len(frames)):
+            inter = frames[i]["border_mask"] & frames[j]["border_mask"]
+            if not inter.any():
