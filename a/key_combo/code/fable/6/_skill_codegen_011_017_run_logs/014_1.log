+        monochromatic=True,
+        colors=[int(Color.BLUE)],
+        return_format="dict",
+    )
+    seeds = []
+    for comp in comps:
+        coords = _coord_tuples(comp["coords"])
+        if _is_diagonal_domino(coords):
