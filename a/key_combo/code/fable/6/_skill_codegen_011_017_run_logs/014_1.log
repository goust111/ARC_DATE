    g = np.array(grid, dtype=int)
    bg = int(get_bg(g))
    seed = find_seed(g, bg)
    lookup, freq = parse_bars(g, bg, seed)
    assert any(v >= 2 for v in freq.values())
    assert any(v == 1 for v in freq.values())
    r, c, dr, dc = initial_state(g.shape, seed)
    out = g.copy()
    reflective_hits = 0
    transparent_hits = 0
    seen = set()
