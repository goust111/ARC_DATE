def coord_tuples(coords):
    return [tuple(map(int, rc)) for rc in coords]


def find_seed(grid, bg):
    comps = find_components(grid, bg=bg, connectivity=8, monochromatic=True, colors=[int(Color.BLUE)], return_format='dict')
    seeds = []
    for comp in comps:
        coords = coord_tuples(comp['coords'])
        if len(coords) == 2 and abs(coords[0][0] - coords[1][0]) == 1 and abs(coords[0][1] - coords[1][1]) == 1:
            seeds.append(coords)
    assert len(seeds) == 1
    return seeds[0]


def initial_state(shape, seed):
    if len({r - c for r, c in seed}) == 1:
        endpoints = ((min(seed), (-1, -1)), (max(seed), (1, 1)))
    else:
        endpoints = ((min(seed), (-1, 1)), (max(seed), (1, -1)))
    states = []
    for (r, c), (dr, dc) in endpoints:
        if in_bounds(shape, r + dr, c + dc):
            states.append((r, c, dr, dc))
    assert len(states) == 1
    return states[0]


def parse_bars(grid, bg, seed):
    g = np.array(grid, dtype=int, copy=True)
    for r, c in seed:
        g[r, c] = bg
    comps = find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format='dict')
    bars = []
    for comp in comps:
        coords = coord_tuples(comp['coords'])
        if len(coords) < 2:
            continue
        rows = sorted({r for r, _ in coords})
        cols = sorted({c for _, c in coords})
        if len(rows) == 1:
            assert sorted(c for _, c in coords) == list(range(min(cols), max(cols) + 1))
            orientation = 'h'
        else:
            assert len(cols) == 1
            assert sorted(r for r, _ in coords) == list(range(min(rows), max(rows) + 1))
            orientation = 'v'
        bars.append({'coords': coords, 'orientation': orientation, 'length': len(coords)})
    freq = Counter(bar['length'] for bar in bars)
    lookup = {}
    for bar in bars:
        bar['reflective'] = freq[bar['length']] >= 2
        for cell in bar['coords']:
            lookup[cell] = bar
    return bars, lookup, freq


def simulate(grid):
    g = np.array(grid, dtype=int)
    bg = int(get_bg(g))
    seed = find_seed(g, bg)
    bars, lookup, freq = parse_bars(g, bg, seed)
    assert any(v >= 2 for v in freq.values())
    assert any(v == 1 for v in freq.values())
    r, c, dr, dc = initial_state(g.shape, seed)
    out = g.copy()
    seen = set()
    reflective_hits = 0
    transparent_hits = 0
    while True:
        state = (r, c, dr, dc)
        assert state not in seen
        seen.add(state)
        nr, nc = r + dr, c + dc
        if not in_bounds(g.shape, nr, nc):
            break
        bar = lookup.get((nr, nc))
        if bar and bar['reflective']:
            reflective_hits += 1
            if bar['orientation'] == 'h':
                dr = -dr
            else:
                dc = -dc
            continue
        if bar:
            transparent_hits += 1
        out[nr, nc] = int(Color.BLUE)
        r, c = nr, nc
    assert reflective_hits >= 1
    assert transparent_hits >= 1
    return out

for i in range(30):
    grid = mod.generate_input()
    assert isinstance(grid, np.ndarray)
    assert grid.ndim == 2
    assert grid.shape[0] <= 30 and grid.shape[1] <= 30
    out = mod.main(grid)
    assert isinstance(out, np.ndarray)
    assert out.ndim == 2
    assert out.shape[0] <= 30 and out.shape[1] <= 30
    expected = simulate(grid)
    assert np.array_equal(out, expected), f'mismatch on iteration {i}'

