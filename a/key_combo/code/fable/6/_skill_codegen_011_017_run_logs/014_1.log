+            placed = False
+            lengths = [length for length in LENGTH_POOL if length <= max(shape)]
+            random.shuffle(lengths)
+            for length in lengths:
+                if int(length) in used_lengths:
+                    continue
+                orientations = ["h", "v"]
+                random.shuffle(orientations)
+                for orientation in orientations:
