+def _choose_palette() -> tuple[int, int, int, int, list[int]]:
+    colors = random.sample(Color.ALL_COLORS, k=7)
+    bg, sep, occ, marker = map(int, colors[:4])
+    fg = [int(color) for color in colors[4:]]
+    return bg, sep, occ, marker, fg
