+
+    objects: list[dict] = []
+    for color, color_comps in sorted(by_color.items()):
+        singletons = [comp for comp in color_comps if int(comp["area"]) == 1]
+        sprites = [comp for comp in color_comps if int(comp["area"]) > 1]
