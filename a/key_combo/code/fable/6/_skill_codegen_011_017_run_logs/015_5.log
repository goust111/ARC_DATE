+            out[r, c] = int(obj["color"])
+    return out
+
+
+def _choose_kinds(count: int) -> list[str]:
+    kinds = list(KINDS[: min(count, len(KINDS))])
+    random.shuffle(kinds)
+    while len(kinds) < count:
+        kinds.append(random.choice(KINDS))
+    random.shuffle(kinds)
+    return kinds
