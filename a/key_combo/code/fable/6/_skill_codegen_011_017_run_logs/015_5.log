+
+def _marker_rule(markers: tuple[tuple[int, int], tuple[int, int]]) -> tuple[str, int | tuple[int, int]]:
+    (r0, c0), (r1, c1) = markers
+    if r0 == r1:
+        assert c0 != c1 and abs(c0 - c1) % 2 == 0
+        return "vertical", (c0 + c1) // 2
+    if c0 == c1:
