+def _sample_spaced_lanes(length: int, count: int) -> list[int] | None:
+    for _ in range(200):
+        lanes = sorted(random.sample(range(length), count))
+        if all(b - a >= 2 for a, b in zip(lanes, lanes[1:])):
+            return lanes
+    return None
