+
+        return {
+            "head": head,
+            "dr": dr,
+            "dc": dc,
+            "tail_len": tail_len,
+            "path": path,
+            "wall": wall,
+            "wrapped": wrapped,
+            "cells": self_cells,
+        }
+    return None
+
+
+def _place_extra_wall(
+    grid: np.ndarray,
+    occupied: set[tuple[int, int]],
+    blocked_lanes: set[int],
+    orientation: str,
+    wall_colors: list[int],
+) -> bool:
+    h, w = grid.shape
+    for _ in range(200):
+        ph = random.randint(1, 2)
+        pw = random.randint(1, 2)
+        r0 = random.randint(0, h - ph)
