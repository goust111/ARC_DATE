+
+            candidates: list[tuple[tuple[int, int], tuple[int, int], list[tuple[int, int]]]] = []
+            for delta in direction_choices:
+                max_steps = 0
+                probe = _add(current, delta)
+                while _in_bounds(shape, probe[0], probe[1]):
+                    max_steps += 1
