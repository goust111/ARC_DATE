        outer_w = random.randint(2, 5)
        inner_h = random.randint(2, 5)
        inner_w = random.randint(2, 5)
        if outer_h * inner_h > MAX_OUTPUT_SIZE or outer_w * inner_w > MAX_OUTPUT_SIZE:
            continue

        outer_mask = _random_hole_mask(outer_h, outer_w)
