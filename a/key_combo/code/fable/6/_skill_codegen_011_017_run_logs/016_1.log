+            rows = {r for r, _c in coords}
+            cols = {c for _r, c in coords}
+            downs = {r - c for r, c in coords}
+            ups = {r + c for r, c in coords}
+            if len(rows) == 1 or len(cols) == 1 or len(downs) == 1 or len(ups) == 1:
