+            for idx, color in enumerate(line_colors)
+        }
+        order = tuple(line_colors)
+        visible = _simulate_hidden_input(clean, bg_phase, lines, order)
+        ok = True
+        for color in line_colors:
+            count = int(np.count_nonzero(visible == int(color)))
+            if count < 2:
+                ok = False
