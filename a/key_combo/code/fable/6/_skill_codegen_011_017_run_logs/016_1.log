+def _is_exact_period(tile: np.ndarray, ph: int, pw: int) -> bool:
+    h, w = map(int, tile.shape)
+    if h % int(ph) != 0 or w % int(pw) != 0:
+        return False
+    base = tile[:ph, :pw]
+    return np.array_equal(tile, _tile_grid(base, (h, w)))
