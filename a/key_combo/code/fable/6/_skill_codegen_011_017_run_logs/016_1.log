+    valid = []
+    for line in candidates:
+        if len(line["cells"]) < 2:
+            continue
+        if coord_set.issubset(line["bg_cell_set"]):
+            valid.append(line)
+    if len(valid) != 1:
+        return None
+    return valid[0]
