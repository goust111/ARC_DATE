+def _tile_grid(tile: np.ndarray, shape: tuple[int, int]) -> np.ndarray:
+    h, w = map(int, tile.shape)
+    H, W = map(int, shape)
+    reps_r = (H + h - 1) // h
+    reps_c = (W + w - 1) // w
+    return np.tile(tile, (reps_r, reps_c))[:H, :W]
+
