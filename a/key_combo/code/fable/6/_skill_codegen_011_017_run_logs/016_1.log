+            return coords
+    return None
+
+
+def _generate_case() -> tuple[np.ndarray, np.ndarray]:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        ph = random.randint(1, 4)
+        pw = random.randint(1, 4)
