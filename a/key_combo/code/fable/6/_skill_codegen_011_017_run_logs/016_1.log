+
+
+def _sample_noise_coords(
+    clean: np.ndarray,
+    bg_phase: int,
+    occupied: set[tuple[int, int]],
+) -> list[tuple[int, int]] | None:
+    candidates = [
+        (int(r), int(c))
+        for r, c in np.argwhere(clean == int(bg_phase))
+        if (int(r), int(c)) not in occupied
+    ]
+    random.shuffle(candidates)
+    for size in (3, 4, 2):
