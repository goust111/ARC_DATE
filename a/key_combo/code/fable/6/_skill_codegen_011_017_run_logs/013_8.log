+MAX_GENERATION_ATTEMPTS = 500
+TICK_HEIGHT = 2
+LAYER_COUNT_RANGE = (3, 5)
+BODY_HEIGHT_RANGE = (4, 8)
+MAX_BODY_WIDTH = 9
