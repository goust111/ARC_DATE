+    cols = 2
+    height = rows * (obj_h + 2) + 2 + int(rng.integers(0, 3))
+    width = cols * (obj_w + 2) + 2 + int(rng.integers(0, 5))
+    assert layer_count <= rows * cols
+    assert height <= 30 and width <= 30
+    return int(height), int(width)
