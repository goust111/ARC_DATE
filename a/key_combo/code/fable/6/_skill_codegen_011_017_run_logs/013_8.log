RECT_COUNT_OPTIONS = (2, 3, 4)
GRID_SIDE_OPTIONS = tuple(range(14, 19))

# Palette and marker construction.
PALETTE = range(10)
NON_MARKER_COLOR_COUNT = 2
MIN_BLOB_SIZE = 1
MAX_BLOB_SIZE = 4
INTERIOR_MARGIN = 1
MIN_MARKER_COVERAGE = 0.25
MAX_MARKER_COVERAGE = 0.32
