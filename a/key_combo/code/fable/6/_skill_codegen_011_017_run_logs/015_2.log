+    if not candidates:
+        return None
+
+    candidates.sort(key=lambda item: item[0], reverse=True)
+    top_band = candidates[: min(6, len(candidates))]
+    return random.choice(top_band)
+
+
+def _plan_exit(
+    shape: tuple[int, int],
+    pos: tuple[int, int],
+    direction: tuple[int, int],
+    occupied: set[tuple[int, int]],
+    reserved: set[tuple[int, int]],
