+    try:
+        task = _extract_task(grid)
+        out, stats = _simulate_task(task)
+    except Exception:
+        return None
+
+    if stats["turns"] < 1:
+        return None
+    if stats["trail_count"] < 6:
+        return None
+    if stats["wall_hits"] < 1:
+        return None
+    if out.shape[0] > 30 or out.shape[1] > 30:
+        return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _try_generate()
+        if grid is not None:
