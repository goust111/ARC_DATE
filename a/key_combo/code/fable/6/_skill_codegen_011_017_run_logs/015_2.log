+    legend_colors = colors[:3]
+    start_color = colors[3]
+    wall_colors = colors[4:]
+    total_rects = len(extra_rects) + len(find_components(np.array([[0]]), bg=0))  # dummy-free shape to keep typing simple
+    del total_rects
+
+    rectangles: list[list[tuple[int, int]]] = []
+    seen_wall_cells: set[tuple[int, int]] = set()
+    for cell in sorted(wall_cells):
