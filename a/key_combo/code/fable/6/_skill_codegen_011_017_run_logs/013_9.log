+def _component_first_key(component: dict) -> tuple[int, int]:
+    coords = np.asarray(component["coords"], dtype=int)
+    top_row = int(coords[:, 0].min())
+    left_col = int(coords[coords[:, 0] == top_row][:, 1].min())
+    return top_row, left_col
