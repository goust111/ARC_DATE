+    grid[r0 : r1 + 1, c1] = color
+    grid[r0, c0 : c1 + 1] = color
+    grid[r1, c0 : c1 + 1] = color
+
+
+def _random_derangement(values: list[int], rng: np.random.Generator) -> list[int]:
