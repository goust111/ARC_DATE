+    r, c = start
+    dr, dc = direction
+    cells: list[tuple[int, int]] = []
+    for step in range(1, steps + 1):
+        cells.append((r + dr * step, c + dc * step))
+    if not include_hit:
+        cells = cells[:-1]
+    return cells
+
+
+def _ray_parameter(
+    start: tuple[int, int],
+    direction: tuple[int, int],
+    cell: tuple[int, int],
+) -> int | None:
+    sr, sc = start
+    dr, dc = direction
+    rr = cell[0] - sr
+    cc = cell[1] - sc
+    if dr == 0 or dc == 0:
+        return None
+    if rr == 0 or cc == 0:
+        return None
+    if rr % dr != 0 or cc % dc != 0:
+        return None
+    step_r = rr // dr
+    step_c = cc // dc
+    if step_r != step_c or step_r <= 0:
+        return None
+    return int(step_r)
+
+
+def _sample_red_start(shape: tuple[int, int]) -> dict | None:
+    H, W = shape
+    for _ in range(120):
+        missing = random.choice(tuple(L_CORNERS))
