+def _object_color(grid: np.ndarray, comp: dict) -> int | None:
+    colors = {int(grid[int(r), int(c)]) for r, c in comp["coords"]}
+    if len(colors) != 1:
+        return None
+    return next(iter(colors))
+
+
+def _l_info(comp: dict) -> tuple[tuple[int, int], tuple[int, int]]:
