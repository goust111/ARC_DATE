+    pieces: list[dict] = []
+    expected = grid.copy()
+
+    for notch in realized_notches:
+        color = palette.pop()
+        shape = np.asarray(notch["shape"], dtype=int)
+        sh, sw = _shape_dims(shape)
+        placed_piece = None
+        for _ in range(PLACE_TRIES):
