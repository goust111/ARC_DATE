+    """
+    return _solve_scene(np.asarray(input_grid, dtype=int))
+
+
+def _make_profile_shape(width: int, max_height: int) -> CoordArray:
+    for _ in range(PLACE_TRIES):
+        depths = [random.randint(1, max_height) for _ in range(width)]
+        if max(depths) < 2:
+            continue
+        if len(set(depths)) == 1:
+            continue
