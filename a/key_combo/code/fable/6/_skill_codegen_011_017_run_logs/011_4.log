+def _normalize_coords(coords: CoordArray) -> CoordArray:
+    arr = np.asarray(coords, dtype=int)
+    r0, c0 = arr.min(axis=0)
+    out = arr.copy()
+    out[:, 0] -= int(r0)
+    out[:, 1] -= int(c0)
+    order = np.lexsort((out[:, 1], out[:, 0]))
+    return out[order]
