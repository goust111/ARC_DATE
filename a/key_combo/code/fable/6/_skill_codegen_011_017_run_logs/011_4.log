+    c0 = max(0, int(coords[:, 1].min()) - padding)
+    r1 = min(h - 1, int(coords[:, 0].max()) + padding)
+    c1 = min(w - 1, int(coords[:, 1].max()) + padding)
+    occupied[r0 : r1 + 1, c0 : c1 + 1] = True
