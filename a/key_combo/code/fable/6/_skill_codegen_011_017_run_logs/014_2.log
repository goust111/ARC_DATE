+def _add(a: tuple[int, int], b: tuple[int, int], k: int = 1) -> tuple[int, int]:
+    return int(a[0] + k * b[0]), int(a[1] + k * b[1])
+
+
+def _left(d: tuple[int, int]) -> tuple[int, int]:
+    dr, dc = d
