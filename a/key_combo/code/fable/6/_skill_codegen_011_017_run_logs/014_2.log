+    assert len(cells) == 4
+
+    centers = [rc for rc in cells if _neighbor_degree(cells, rc) == 3]
+    assert len(centers) == 1
+    center = centers[0]
+
+    offsets = [(r - center[0], c - center[1]) for r, c in cells if (r, c) != center]
+    bar_pair = None
+    control_offset = None
