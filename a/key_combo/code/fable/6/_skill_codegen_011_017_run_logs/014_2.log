        pr0 = rr0 - r0
        pc0 = cc0 - c0

    pr1 = pr0 + (rr1 - rr0)
    pc1 = pc0 + (cc1 - cc0)

    dst_view = dst[rr0:rr1, cc0:cc1]
    patch_view = patch[pr0:pr1, pc0:pc1]

    m = np.ones(patch_view.shape, dtype=bool)
    if mask is not None:
        m &= mask[pr0:pr1, pc0:pc1].astype(bool)
