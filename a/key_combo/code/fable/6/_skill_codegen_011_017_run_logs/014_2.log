+def _launcher_cells(center: tuple[int, int], emit_dir: tuple[int, int]) -> set[tuple[int, int]]:
+    perp = _left(emit_dir)
+    return {
+        center,
+        _add(center, perp),
+        _add(center, perp, -1),
+        _add(center, emit_dir, -1),
+    }
+
+
+def _object_cells(center: tuple[int, int], emit_dir: tuple[int, int]) -> set[tuple[int, int]]:
