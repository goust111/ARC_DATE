+        wall_index = 1
+        while wall_index < len(row_lines) - 1 and int(grid[row_lines[wall_index], c]) == int(bg):
+            wall_index += 1
+        stop_row = wall_index - 1
+
+        r0 = row_lines[stop_row] + 1
+        r1 = row_lines[stop_row + 1]
+        c0 = col_lines[chamber_index] + 1
+        c1 = col_lines[chamber_index + 1]
