import importlib.util
from collections import deque
import numpy as np

path = '/home/lixinyu/snap/a/key_combo/code/fable/6/014/4.py'
spec = importlib.util.spec_from_file_location('arc_task_4', path)
mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)


def get_bg(grid):
    vals, counts = np.unique(grid, return_counts=True)
    return int(vals[counts.argmax()])


def find_blocks(grid):
    h, w = grid.shape
    bg = get_bg(grid)
    seen = set()
    blocks = []
    for r in range(h):
        for c in range(w):
            if (r, c) in seen or int(grid[r, c]) == bg:
                continue
            color = int(grid[r, c])
            q = deque([(r, c)])
            seen.add((r, c))
            cells = []
            while q:
                rr, cc = q.popleft()
                cells.append((rr, cc))
                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
                    if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in seen and int(grid[nr, nc]) == color:
                        seen.add((nr, nc))
                        q.append((nr, nc))
            rows = [rr for rr, _ in cells]
            cols = [cc for _, cc in cells]
            bbox = (min(rows), min(cols), max(rows), max(cols))
            r0, c0, r1, c1 = bbox
            assert len(cells) == 4
            assert (r1 - r0 + 1, c1 - c0 + 1) == (2, 2)
            assert np.all(grid[r0:r1 + 1, c0:c1 + 1] == color)
            blocks.append({'color': color, 'bbox': bbox})
    return bg, blocks


def dist(bbox, r, c):
    r0, c0, r1, c1 = bbox
    return max(r0 - r, 0, r - r1) + max(c0 - c, 0, c - c1)


def expected(grid):
    bg, blocks = find_blocks(grid)
    pairs = []
    for i, a in enumerate(blocks):
        ar0, ac0, ar1, ac1 = a['bbox']
        for b in blocks[i + 1:]:
            if a['color'] == b['color']:
                continue
            br0, bc0, br1, bc1 = b['bbox']
            if (ar0, ar1) == (br0, br1):
                left, right = sorted((a, b), key=lambda block: block['bbox'][1])
                gap0 = left['bbox'][3] + 1
                gap1 = right['bbox'][1] - 1
                if gap0 <= gap1 and np.all(grid[ar0:ar1 + 1, gap0:gap1 + 1] == bg):
                    pairs.append((left, right, (ar0, gap0, ar1, gap1)))
            if (ac0, ac1) == (bc0, bc1):
                top, bottom = sorted((a, b), key=lambda block: block['bbox'][0])
                gap0 = top['bbox'][2] + 1
                gap1 = bottom['bbox'][0] - 1
                if gap0 <= gap1 and np.all(grid[gap0:gap1 + 1, ac0:ac1 + 1] == bg):
                    pairs.append((top, bottom, (gap0, ac0, gap1, ac1)))
    assert pairs
    out = grid.copy()
    claims = {}
    for a, b, (r0, c0, r1, c1) in pairs:
        for r in range(r0, r1 + 1):
            for c in range(c0, c1 + 1):
                claims.setdefault((r, c), []).append((dist(a['bbox'], r, c), a['color']))
                claims[(r, c)].append((dist(b['bbox'], r, c), b['color']))
    for (r, c), entries in claims.items():
        best = min(d for d, _ in entries)
        winners = [color for d, color in entries if d == best]
        out[r, c] = winners[0] if len(winners) == 1 else bg
    return out


for idx in range(60):
    grid = mod.generate_input()
    out = mod.main(grid)
    exp = expected(grid)
    assert isinstance(grid, np.ndarray) and isinstance(out, np.ndarray)
    assert grid.ndim == 2 and out.ndim == 2
    assert out.shape[0] <= 30 and out.shape[1] <= 30
    assert np.array_equal(out, exp), idx

print('self-check passed: 60 cases')
