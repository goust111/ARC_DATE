+                _lr0, _lc0, lr1, lc1 = left["bbox"]
+                rr0, rc0, _rr1, _rc1 = right["bbox"]
+                if lc1 + 1 <= rc0 - 1 and np.all(grid[rr0 : lr1 + 1, lc1 + 1 : rc0] == bg):
