+def _gen_wall_sets(path: list[tuple[int, int]]) -> tuple[set[tuple[int, int]], set[tuple[int, int]]]:
+    left = set()
+    right = set()
+    channel = set(path)
+    for i, (r, c) in enumerate(path):
+        dirs = []
+        if i > 0:
