+            if (r + lr, c + lc) not in channel:
+                left.add((r + lr, c + lc))
+            if (r - lr, c - lc) not in channel:
+                right.add((r - lr, c - lc))
+
+        if len(dirs) == 2 and dirs[0] != dirs[1]:
+            for side in (1, -1):
+                offsets = []
+                for dr, dc in dirs:
