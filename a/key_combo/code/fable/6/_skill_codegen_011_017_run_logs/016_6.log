def shortest(mask, start, goal):
    q = deque([start])
    parent = {start: None}
    while q:
        cur = q.popleft()
        if cur == goal:
            break
        r, c = cur
        for rr, cc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
            nxt = (rr, cc)
            if not in_bounds(mask.shape, rr, cc) or not mask[nxt] or nxt in parent:
                continue
            parent[nxt] = cur
            q.append(nxt)
    assert goal in parent
    out = []
    cur = goal
    while cur is not None:
        out.append(cur)
        cur = parent[cur]
    return list(reversed(out))


