+def _shortest_path(mask: np.ndarray, start: tuple[int, int], goal: tuple[int, int]) -> list[tuple[int, int]]:
+    queue = deque([start])
+    parent = {start: None}
+    while queue:
+        cur = queue.popleft()
+        if cur == goal:
+            break
+        for nxt in neighbors4(*cur):
