+def _find_plug(grid: np.ndarray) -> tuple[int, int]:
+    coords = np.argwhere(grid == PLUG_COLOR)
+    assert len(coords) == 1, "expected exactly one plug pixel"
+    return int(coords[0, 0]), int(coords[0, 1])
