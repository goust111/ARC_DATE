def token_mask(grid):
    return (grid != Color.BLACK) & (grid != Color.GREY) & (grid != Color.TEAL)


def token_edge(grid, coords):
    if all(r == 0 for r, _ in coords):
        return '"'top'
    if all(r == grid.shape[0] - 1 for r, _ in coords):
        return 'bottom'
    if all(c == 0 for _, c in coords):
        return 'left'
