+def _gen_partition_total(total: int, count: int, minimum: int, maximum: int) -> list[int] | None:
+    parts = []
+    remaining = total
+    for i in range(count - 1):
+        rest = count - i - 1
+        lo = max(minimum, remaining - maximum * rest)
+        hi = min(maximum, remaining - minimum * rest)
