+def _gen_token_positions(grid: np.ndarray, opening_col: int, capacity: int) -> list[tuple[int, int]] | None:
+    left_slots = [c for c in range(opening_col - 1, 0, -1) if grid[GEN_TOP_ROW, c] == Color.BLACK]
