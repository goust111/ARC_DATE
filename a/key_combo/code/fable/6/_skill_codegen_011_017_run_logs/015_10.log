GREEN = Color.GREEN
YELLOW = Color.YELLOW
GREY = Color.GREY
COPY_COLOR_BY_SOURCE = {RED: GREEN, GREY: YELLOW}
COPY_PAINT_ORDER = (GREY, RED)

