+    right = [obj for obj in horizontal_objects if int(obj["bbox"][1]) > wall_c]
+    top = [obj for obj in vertical_objects if int(obj["bbox"][2]) < wall_r]
+    bottom = [obj for obj in vertical_objects if int(obj["bbox"][0]) > wall_r]
