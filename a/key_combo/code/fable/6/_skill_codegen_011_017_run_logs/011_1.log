+def _solve_from_objects(
+    shape: tuple[int, int],
+    bg: int,
+    wall_r: int,
+    wall_c: int,
+    horizontal_colors: set[int],
+    vertical_colors: set[int],
+    objects: list[dict],
+) -> np.ndarray:
+    allowed_colors = set(horizontal_colors) | set(vertical_colors)
+    assert all(int(obj["color"]) in allowed_colors for obj in objects)
