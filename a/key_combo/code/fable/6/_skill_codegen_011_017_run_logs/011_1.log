+    for color, coords in by_color.items():
+        orientation, axis = _classify_singleton_color(coords)
+        if orientation == "h":
+            horizontal_colors.add(color)
+            if wall_c is None:
+                wall_c = axis
+            else:
+                assert wall_c == axis
+        else:
+            vertical_colors.add(color)
+            if wall_r is None:
+                wall_r = axis
+            else:
