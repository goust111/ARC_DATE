+    return _solve_from_objects(g.shape, bg, wall_r, wall_c, horizontal_colors, vertical_colors, objects)
+
+
+def _cells_free(occupied: set[tuple[int, int]], coords: CoordArray) -> bool:
+    return all((int(r), int(c)) not in occupied for r, c in coords)
+
+
+def _same_color_isolated(grid: np.ndarray, color: int, cell: tuple[int, int]) -> bool:
+    h, w = grid.shape
+    r, c = map(int, cell)
+    if grid[r, c] != 0 and grid[r, c] != int(get_bg(grid)):
+        return False
+    for rr, cc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+        if 0 <= rr < h and 0 <= cc < w and int(grid[rr, cc]) == int(color):
+            return False
+    return True
+
+
+def _try_add_horizontal_pairs(grid: np.ndarray, color: int, wall_c: int, used_rows: set[int]) -> bool:
+    h, w = grid.shape
+    pair_count = random.randint(1, 3)
+    for _ in range(pair_count):
+        placed = False
+        for _ in range(PLACE_TRIES):
+            row = random.randrange(h)
+            dist_max = min(wall_c, w - 1 - wall_c)
+            dist = random.randint(1, dist_max)
+            left = (row, wall_c - dist)
+            right = (row, wall_c + dist)
+            if row in used_rows:
+                continue
+            if not (_same_color_isolated(grid, color, left) and _same_color_isolated(grid, color, right)):
+                continue
+            grid[left] = int(color)
+            grid[right] = int(color)
+            used_rows.add(row)
+            placed = True
+            break
+        if not placed:
+            return False
+    return True
+
+
+def _try_add_vertical_pairs(grid: np.ndarray, color: int, wall_r: int, used_cols: set[int]) -> bool:
+    h, w = grid.shape
+    pair_count = random.randint(1, 3)
+    for _ in range(pair_count):
+        placed = False
+        for _ in range(PLACE_TRIES):
+            col = random.randrange(w)
+            dist_max = min(wall_r, h - 1 - wall_r)
+            dist = random.randint(1, dist_max)
+            top = (wall_r - dist, col)
+            bottom = (wall_r + dist, col)
