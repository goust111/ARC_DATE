+            if local in ORIENTATION_BY_LOCAL:
+                orient = ORIENTATION_BY_LOCAL[local]
+                corner_local = orient["corner_local"]
+                corner = (r0 + int(corner_local[0]), c0 + int(corner_local[1]))
+                cells = {tuple(map(int, rc)) for rc in coords.tolist()}
