+    if not trail_cells - {tuple(details["final_pos"])} <= black_cells:
+        return False
+    if len(details["used_deflectors"]) < 1:
+        return False
+
+    return True
+
+
+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(MAX_GENERATION_ATTEMPTS):
