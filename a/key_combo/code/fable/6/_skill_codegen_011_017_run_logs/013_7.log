+def _steps_to_edge(shape: tuple[int, int], start: tuple[int, int], direction: tuple[int, int]) -> int:
+    h, w = shape
+    r, c = start
+    dr, dc = direction
+    steps = 0
+    while True:
+        nr = r + dr
+        nc = c + dc
+        if not (0 <= nr < h and 0 <= nc < w):
+            return steps
+        r, c = nr, nc
+        steps += 1
