+    tile_size = random.randint(3, max_tile)
+
+    bg, sep_color = _choose_distinct(list(PALETTE), 2)
+    fg_pool = [color for color in PALETTE if color not in {bg, sep_color}]
+    fg_count = random.randint(1, min(4, len(fg_pool)))
