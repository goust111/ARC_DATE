+            rolled = _roll_for_lattice(tile, row_index, col_index)
+            r0 = row_index * (tile_size + 1)
+            c0 = col_index * (tile_size + 1)
+            grid[r0 : r0 + tile_size, c0 : c0 + tile_size] = rolled
+
+    expected = base.copy()
+    expected[damage_mask] = BLUE
+
+    if np.any(grid == BLUE):
