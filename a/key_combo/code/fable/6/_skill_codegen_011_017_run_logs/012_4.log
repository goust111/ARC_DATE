+    boxes: dict[int, tuple[int, int, int, int]],
+) -> list[int] | None:
+    colors = sorted(boxes)
+    above_to_below = {color: set() for color in colors}
+    indegree = {color: 0 for color in colors}
+    edges: set[tuple[int, int]] = set()
