+def generate_input() -> np.ndarray:
+    for _ in range(_GEN_ATTEMPTS):
+        grid, _order = _generate_one()
+        if grid.ndim != 2:
+            continue
+        if grid.shape[0] > _GRID_LIMIT or grid.shape[1] > _GRID_LIMIT:
+            continue
+        return grid
+    raise AssertionError("failed to generate a valid ARC input grid")

