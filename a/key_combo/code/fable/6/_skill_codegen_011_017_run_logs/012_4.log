+    def backtrack(idx: int):
+        if idx == len(colors):
+            order = _infer_order(g, bg, chosen)
+            if order is None:
+                return None
+            return chosen.copy(), order
+
+        color = colors[idx]
+        for box in candidate_map[color]:
+            chosen[color] = box
+            solved = backtrack(idx + 1)
