+    spark_cells = [
+        tuple(map(int, comp["coords"][0]))
+        for comp in comps
+        if int(comp["color"]) == SPARK_COLOR and int(comp["area"]) == 1
+    ]
+    if len(spark_cells) != 1:
+        raise ValueError("expected exactly one yellow spark pixel")
+    spark = spark_cells[0]
