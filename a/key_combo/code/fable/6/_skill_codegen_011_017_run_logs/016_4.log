+    arrows: list[dict] = []
+    for comp in comps:
+        color = int(comp["color"])
+        area = int(comp["area"])
+        if color == SPARK_COLOR and area == 1:
+            continue
+        if area != 6:
+            raise ValueError("expected every non-spark foreground component to be a 6-cell arrow")
+        coords = np.asarray(comp["coords"], dtype=int)
