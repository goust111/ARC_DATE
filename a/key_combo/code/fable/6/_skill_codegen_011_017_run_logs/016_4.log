+    coords = np.asarray(coords, dtype=int)
+    if direction == "up":
+        return int(coords[:, 0].min())
+    if direction == "down":
+        return int(height - 1 - coords[:, 0].max())
+    if direction == "left":
+        return int(coords[:, 1].min())
+    if direction == "right":
