+def _simulate_chain(shape: tuple[int, int], arrows: list[dict], spark: tuple[int, int]) -> tuple[list[dict], list[int]]:
+    state = [
+        {
+            "color": int(arrow["color"]),
+            "direction": str(arrow["direction"]),
+            "coords": np.asarray(arrow["coords"], dtype=int).copy(),
+        }
+        for arrow in arrows
