+CHAIN_LEN_CHOICES = (2, 3, 4)
+DISTRACTOR_CHOICES = (1, 2, 3)
+MOVE_STEPS = (1, 2, 3, 4, 5, 6)
+DIRS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
