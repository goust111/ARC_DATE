+    "up": np.array([(0, 1), (1, 0), (1, 1), (1, 2), (2, 1), (3, 1)], dtype=int),
+    "down": np.array([(0, 1), (1, 1), (2, 0), (2, 1), (2, 2), (3, 1)], dtype=int),
+    "left": np.array([(1, 0), (0, 1), (1, 1), (2, 1), (1, 2), (1, 3)], dtype=int),
+    "right": np.array([(1, 0), (1, 1), (0, 2), (1, 2), (2, 2), (1, 3)], dtype=int),
