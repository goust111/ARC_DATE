+    coords[:, 0] -= r0
+    coords[:, 1] -= c0
+    mask[coords[:, 0], coords[:, 1]] = True
+
+    border = np.zeros((h, w), dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+    return bool(mask[border].all() and not mask[~border].any())
