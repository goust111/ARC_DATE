+    order = objects[:]
+    rng.shuffle(order)
+    for obj in order:
+        placed = False
+        trials = list(range(160))
+        for _ in trials:
+            x = rng.randint(0, width - int(obj["width"]))
+            max_y = int(max(0, terrain_surface.min() - obj["height"] - 2))
+            y = rng.randint(0, max_y) if max_y > 0 else 0
+            if not _can_place_floating(occupied, obj, x, y, terrain_surface):
+                continue
+            _place_object(grid, occupied, obj, x, y)
+            placed = True
+            break
+        if not placed:
+            return None
+    return grid
+
+
+def _generate_case(rng: random.Random) -> tuple[np.ndarray, np.ndarray]:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        height = rng.randint(16, 22)
+        width = rng.randint(14, 20)
+        terrain_surface = _random_walk_surface(rng, height, width)
+        colors = rng.sample(MOVABLE_COLORS, 5)
+
+        first_pick = _pick_unique_irregular_object(rng, terrain_surface, colors[0])
+        if first_pick is None:
+            continue
+        obj1, x1 = first_pick
+        fit1 = _fit_positions(terrain_surface, obj1)
+        if len(fit1) != 1:
+            continue
+        surface1 = _surface_after_place(terrain_surface, obj1, fit1[0][0], fit1[0][1])
+
+        obj2 = _pick_flat_shelf_object(terrain_surface, surface1, int(obj1["width"]), x1, colors[1])
+        if obj2 is None:
+            continue
+        fit2 = _fit_positions(surface1, obj2)
+        if len(fit2) != 1:
