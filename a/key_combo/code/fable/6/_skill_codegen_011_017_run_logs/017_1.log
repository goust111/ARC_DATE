+def _surface_from_solid(solid: np.ndarray) -> np.ndarray:
+    h, w = solid.shape
+    surface = np.full(w, h, dtype=int)
+    for c in range(w):
+        rows = np.flatnonzero(solid[:, c])
+        if rows.size:
