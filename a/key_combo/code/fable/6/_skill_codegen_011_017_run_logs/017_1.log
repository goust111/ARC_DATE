+    bottom = obj["bottom"]
+    width = int(obj["width"])
+    fits: list[tuple[int, int]] = []
+    for x in range(surface.size - width + 1):
+        segment = surface[x : x + width]
+        offsets = segment - bottom
+        if np.all(offsets == offsets[0]):
+            y = int(offsets[0]) - 1
+            if y >= 0:
+                fits.append((int(x), y))
+    return fits
+
+
