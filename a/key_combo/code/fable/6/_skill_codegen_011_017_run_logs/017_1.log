+    return fits
+
+
+def _surface_after_place(surface: np.ndarray, obj: dict, x: int, y: int) -> np.ndarray:
+    updated = surface.copy()
+    width = int(obj["width"])
+    updated[x : x + width] = np.minimum(updated[x : x + width], y + obj["top"])
+    return updated
+
+
+def _place_object(grid: np.ndarray, solid: np.ndarray, obj: dict, x: int, y: int) -> None:
+    color = int(obj["color"])
+    mask = obj["mask"]
+    h, w = mask.shape
+    view = grid[y : y + h, x : x + w]
+    view[mask] = color
+    solid[y : y + h, x : x + w] |= mask
+
+
+def _extract_components(grid: np.ndarray, color: int) -> list[dict]:
+    mask = grid == int(color)
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    components: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while queue:
+                rr, cc = queue.popleft()
+                cells.append((rr, cc))
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    nr = rr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+            rows = [rr for rr, _ in cells]
+            cols = [cc for _, cc in cells]
+            r0 = min(rows)
+            r1 = max(rows)
+            c0 = min(cols)
+            c1 = max(cols)
+            local = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+            for rr, cc in cells:
+                local[rr - r0, cc - c0] = True
+            top = []
+            bottom = []
+            for lc in range(local.shape[1]):
+                rows_here = np.flatnonzero(local[:, lc])
+                if rows_here.size == 0:
+                    raise ValueError("object columns must be contiguous without internal gaps")
+                top.append(int(rows_here[0]))
+                bottom.append(int(rows_here[-1]))
+            components.append(_make_object(color, top, bottom))
+    return components
+
+
+def _terrain_grid(surface: np.ndarray, height: int, bg: int = Color.BLACK) -> np.ndarray:
+    grid = np.full((height, surface.size), int(bg), dtype=int)
+    for c, top in enumerate(surface):
+        grid[int(top) :, c] = int(Color.GREY)
+    return grid
+
+
+def _apply_hidden_sequence(surface: np.ndarray, placements: list[tuple[dict, int]]) -> tuple[np.ndarray, list[np.ndarray]]:
+    states = [surface.copy()]
+    current = surface.copy()
+    for obj, x in placements:
+        fit = _fit_positions(current, obj)
+        if fit != [(int(x), int(fit[0][1]))] and (len(fit) != 1 or fit[0][0] != int(x)):
+            raise ValueError("hidden construction produced a non-unique placement")
+        px, py = fit[0]
+        current = _surface_after_place(current, obj, px, py)
+        states.append(current.copy())
+    return current, states
+
+
+def _build_expected_grid(height: int, width: int, surface0: np.ndarray, placements: list[tuple[dict, int]]) -> np.ndarray:
+    grid = _terrain_grid(surface0, height)
+    solid = grid != Color.BLACK
+    current_surface = _surface_from_solid(solid)
+    for obj, _x in placements:
+        fits = _fit_positions(current_surface, obj)
+        if len(fits) != 1:
+            raise ValueError("expected exactly one fit while building output")
+        x, y = fits[0]
+        _place_object(grid, solid, obj, x, y)
+        current_surface = _surface_from_solid(solid)
+    return grid
+
+
+def _random_walk_surface(rng: random.Random, height: int, width: int) -> np.ndarray:
+    low = max(7, height // 2)
+    high = height - 4
+    values = [rng.randint(low, high)]
+    for _ in range(1, width):
+        step = rng.choice([-1, 0, 1])
+        values.append(min(high, max(low, values[-1] + step)))
+    return np.asarray(values, dtype=int)
+
+
+def _pick_unique_irregular_object(rng: random.Random, surface: np.ndarray, color: int) -> tuple[dict, int] | None:
+    width_limit = min(6, surface.size - 2)
+    widths = list(range(4, width_limit + 1))
+    rng.shuffle(widths)
+    for width in widths:
+        xs = list(range(1, surface.size - width))
+        rng.shuffle(xs)
+        for x in xs:
+            segment = surface[x : x + width]
+            k = int(segment.min())
+            bottom = (segment - k).astype(int)
+            if np.all(bottom == bottom[0]):
+                continue
+            obj = _make_object(color, np.zeros(width, dtype=int), bottom)
+            if len(_fit_positions(surface, obj)) == 1:
+                return obj, int(x)
+    return None
+
+
+def _pick_flat_shelf_object(
+    surface0: np.ndarray,
+    surface1: np.ndarray,
+    width: int,
+    x: int,
+    color: int,
+) -> dict | None:
+    shelf_height = int(surface1[x])
+    for base in (2, 1, 3):
+        if shelf_height - base - 1 < 0:
+            continue
+        obj = _make_object(color, np.zeros(width, dtype=int), np.full(width, base, dtype=int))
+        if len(_fit_positions(surface0, obj)) == 0 and _fit_positions(surface1, obj) == [(x, shelf_height - base - 1)]:
+            return obj
+    return None
+
+
+def _pick_irregular_top_object(
+    rng: random.Random,
+    surface0: np.ndarray,
+    surface1: np.ndarray,
+    surface2: np.ndarray,
+    width: int,
+    x: int,
+    color: int,
+) -> dict | None:
+    for _ in range(200):
+        base = rng.choice([2, 3])
+        top = np.asarray([rng.randint(0, base) for _ in range(width)], dtype=int)
+        if top.min() != 0 or np.all(top == top[0]):
+            continue
+        obj = _make_object(color, top, np.full(width, base, dtype=int))
+        fits0 = _fit_positions(surface0, obj)
+        fits1 = _fit_positions(surface1, obj)
+        fits2 = _fit_positions(surface2, obj)
+        if fits0 or fits2:
+            continue
+        if len(fits1) == 1 and fits1[0][0] == x:
+            return obj
+    return None
+
+
+def _pick_distractor(rng: random.Random, surfaces: list[np.ndarray], color: int) -> dict | None:
+    width_options = [2, 3, 4, 5]
