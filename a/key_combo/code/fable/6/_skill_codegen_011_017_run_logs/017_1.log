+            cols = [cc for _, cc in cells]
+            r0 = min(rows)
+            r1 = max(rows)
+            c0 = min(cols)
+            c1 = max(cols)
+            local = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
