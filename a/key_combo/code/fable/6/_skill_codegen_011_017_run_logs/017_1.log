+def _pick_unique_irregular_object(rng: random.Random, surface: np.ndarray, color: int) -> tuple[dict, int] | None:
+    width_limit = min(6, surface.size - 2)
+    widths = list(range(4, width_limit + 1))
+    rng.shuffle(widths)
+    for width in widths:
+        xs = list(range(1, surface.size - width))
+        rng.shuffle(xs)
+        for x in xs:
+            segment = surface[x : x + width]
+            k = int(segment.min())
+            bottom = (segment - k).astype(int)
+            if np.all(bottom == bottom[0]):
+                continue
+            obj = _make_object(color, np.zeros(width, dtype=int), bottom)
+            if len(_fit_positions(surface, obj)) == 1:
+                return obj, int(x)
+    return None
