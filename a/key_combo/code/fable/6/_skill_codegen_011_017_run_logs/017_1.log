+    for base in (2, 1, 3):
+        if shelf_height - base - 1 < 0:
+            continue
+        obj = _make_object(color, np.zeros(width, dtype=int), np.full(width, base, dtype=int))
+        if len(_fit_positions(surface0, obj)) == 0 and _fit_positions(surface1, obj) == [(x, shelf_height - base - 1)]:
+            return obj
+    return None
+
+
+def _pick_irregular_top_object(
+    rng: random.Random,
+    surface0: np.ndarray,
+    surface1: np.ndarray,
+    surface2: np.ndarray,
+    width: int,
+    x: int,
+    color: int,
+) -> dict | None:
+    for _ in range(200):
+        base = rng.choice([2, 3])
+        top = np.asarray([rng.randint(0, base) for _ in range(width)], dtype=int)
+        if top.min() != 0 or np.all(top == top[0]):
+            continue
+        obj = _make_object(color, top, np.full(width, base, dtype=int))
+        fits0 = _fit_positions(surface0, obj)
+        fits1 = _fit_positions(surface1, obj)
+        fits2 = _fit_positions(surface2, obj)
+        if fits0 or fits2:
+            continue
+        if len(fits1) == 1 and fits1[0][0] == x:
+            return obj
+    return None
+
+
+def _pick_distractor(rng: random.Random, surfaces: list[np.ndarray], color: int) -> dict | None:
+    width_options = [2, 3, 4, 5]
+    rng.shuffle(width_options)
+    for width in width_options:
+        for _ in range(120):
+            if rng.random() < 0.5:
+                base = rng.choice([1, 2, 3])
+                top = np.asarray([rng.randint(0, base) for _ in range(width)], dtype=int)
+                bottom = np.full(width, base, dtype=int)
+            else:
+                top = np.zeros(width, dtype=int)
+                bottom = np.asarray([rng.randint(0, 3) for _ in range(width)], dtype=int)
+            if np.all(bottom == bottom[0]) and np.all(top == top[0]):
+                continue
+            obj = _make_object(color, top, bottom)
+            if all(len(_fit_positions(surface, obj)) == 0 for surface in surfaces):
+                return obj
+    return None
+
+
+def _can_place_floating(occupied: np.ndarray, obj: dict, x: int, y: int, terrain_surface: np.ndarray) -> bool:
+    mask = obj["mask"]
+    h, w = mask.shape
+    if y < 0 or x < 0 or y + h > occupied.shape[0] or x + w > occupied.shape[1]:
+        return False
+    for c in range(w):
+        rows = np.flatnonzero(mask[:, c])
+        if rows.size and y + int(rows[-1]) >= int(terrain_surface[x + c]) - 1:
+            return False
+    if np.any(occupied[y : y + h, x : x + w] & mask):
+        return False
+    for rr in range(h):
+        for cc in range(w):
+            if not mask[rr, cc]:
+                continue
+            gr = y + rr
+            gc = x + cc
+            for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                nr = gr + dr
+                nc = gc + dc
+                if 0 <= nr < occupied.shape[0] and 0 <= nc < occupied.shape[1] and occupied[nr, nc]:
+                    return False
+    return True
+
+
+def _place_floating_objects(
+    rng: random.Random,
+    height: int,
+    width: int,
+    terrain_surface: np.ndarray,
+    objects: list[dict],
+) -> np.ndarray | None:
