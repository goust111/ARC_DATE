+def _random_walk_surface(rng: random.Random, height: int, width: int) -> np.ndarray:
+    low = max(7, height // 2)
+    high = height - 4
+    values = [rng.randint(low, high)]
+    for _ in range(1, width):
+        step = rng.choice([-1, 0, 1])
+        values.append(min(high, max(low, values[-1] + step)))
+    return np.asarray(values, dtype=int)
+
