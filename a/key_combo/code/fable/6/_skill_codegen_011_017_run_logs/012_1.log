+
+def _mask_from_coords(coords: np.ndarray) -> np.ndarray:
+    r0, c0, r1, c1 = _bbox_from_coords(coords)
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for rr, cc in coords:
+        mask[int(rr) - r0, int(cc) - c0] = True
+    return mask
