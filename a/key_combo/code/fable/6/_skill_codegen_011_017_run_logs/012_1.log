+
+
+def _sample_pair(kind: str, max_h: int, max_w: int) -> tuple[np.ndarray, np.ndarray]:
+    if kind == "pass":
+        return _make_pass_pair(max_h, max_w)
+    if kind == "plug":
+        return _make_plug_pair(max_h, max_w)
+    if kind == "stop":
