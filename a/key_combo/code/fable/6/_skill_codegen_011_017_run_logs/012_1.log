+            sprite_top = random.randint(0, max_sprite_top)
+            sprite_patch = _mask_patch(sprite_mask, sprite_colors[index], bg=Color.BLACK)
+            paste(grid, sprite_patch, sprite_top, sprite_left, transparent=Color.BLACK)
