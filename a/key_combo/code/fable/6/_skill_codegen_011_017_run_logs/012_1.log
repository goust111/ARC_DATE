+    if coords.size == 0:
+        return np.zeros((0, 0), dtype=bool), (0, 0)
+    r0, c0, r1, c1 = _bbox_from_coords(coords)
+    return mask[r0 : r1 + 1, c0 : c1 + 1].copy(), (r0, c0)
+
+
+def _binary_components(mask: np.ndarray) -> list[dict]:
