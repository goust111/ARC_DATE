+        starts.append(cursor)
+        cursor += width
+        if index < len(widths) - 1:
+            cursor += gap + gaps[index + 1]
+    return starts
+
+
+def generate_input() -> np.ndarray:
+    for _attempt in range(_MAX_ATTEMPTS):
