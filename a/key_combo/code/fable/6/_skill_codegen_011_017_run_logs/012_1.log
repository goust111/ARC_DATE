from pathlib import Path

path = Path('/home/lixinyu/snap/a/key_combo/code/fable/6/012/1.py')
spec = importlib.util.spec_from_file_location('arc_target_60121', path)
mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)

for trial in range(40):
    inp = mod.generate_input()
    out = mod.main(inp)
    assert isinstance(inp, np.ndarray) and isinstance(out, np.ndarray)
    assert inp.ndim == 2 and out.ndim == 2
    assert inp.shape == out.shape
    assert inp.shape[0] <= 30 and inp.shape[1] <= 30

    bg, wall, wall_top, holes, sprites = mod._extract_scene(inp)
    matched = mod._match_holes_to_sprites(holes, sprites)
    out_sprites = mod.find_components(
        out,
        bg=bg,
        colors=[int(sprite['color']) for sprite in sprites],
        connectivity=4,
        monochromatic=True,
    )
    by_color = {int(comp['color']): comp for comp in out_sprites}

    relations = []
    for sprite, hole in zip(sprites, matched):
        relation, target_top = mod._classify_relation(sprite, hole)
        relations.append(relation)
        color = int(sprite['color'])
        assert color in by_color
        moved = by_color[color]

        sprite_mask = mod._sprite_mask(sprite)
        moved_mask = mod._sprite_mask(moved)
        assert np.array_equal(sprite_mask, moved_mask)

        sr0, sc0, sr1, sc1 = map(int, sprite['bbox'])
        mr0, mc0, mr1, mc1 = map(int, moved['bbox'])
        hr0, hc0, hr1, hc1 = map(int, hole['bbox'])

        hole_in = inp[hr0:hr1+1, hc0:hc1+1]
        hole_out = out[hr0:hr1+1, hc0:hc1+1]
        hole_mask = mod._hole_mask(hole)

        if relation == 'pass':
            assert mr1 == out.shape[0] - 1
            assert mc0 == sc0
            assert np.all(hole_out[hole_mask] == wall)
        elif relation == 'plug':
            assert mr0 == target_top
            assert mc0 == sc0
            assert np.all(hole_out[hole_mask] == wall)
        else:
            assert mr1 == wall_top - 1
            assert mc0 == sc0
            assert np.array_equal(hole_in, hole_out)

    assert {'pass', 'plug', 'stop'}.issubset(set(relations))

print('self-check passed')
