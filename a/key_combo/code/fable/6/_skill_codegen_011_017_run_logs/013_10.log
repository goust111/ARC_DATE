+def _path_between(start: tuple[int, int], end: tuple[int, int], rng: np.random.Generator) -> list[tuple[int, int]]:
+    r, c = map(int, start)
+    tr, tc = map(int, end)
+    path = [(r, c)]
+    while (r, c) != (tr, tc):
+        options: list[tuple[int, int]] = []
+        if r != tr:
+            options.append((r + (1 if tr > r else -1), c))
+        if c != tc:
