+    if coords.size == 0:
+        return False
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(mask[r0 : r1 + 1, c0 : c1 + 1].sum()) == (int(r1 - r0 + 1) * int(c1 - c0 + 1))
