+        if r != tr:
+            options.append((r + (1 if tr > r else -1), c))
+        if c != tc:
+            options.append((r, c + (1 if tc > c else -1)))
+        r, c = options[int(rng.integers(0, len(options)))]
+        path.append((r, c))
