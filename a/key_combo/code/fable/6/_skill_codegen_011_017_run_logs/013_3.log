+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BG = 0
+SEPARATOR = 9
+PALETTE = [1, 2, 3, 4, 5, 6, 7, 8]
+MAX_GENERATION_ATTEMPTS = 600
+SELF_CHECK_TRIALS = 12
