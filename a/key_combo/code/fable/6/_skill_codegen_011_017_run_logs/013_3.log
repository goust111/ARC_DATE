+    top[r0 : r1 + 1, c0 : c1 + 1] = matches[0]
+    return top
+
+
+def _repeat_tile(tile: np.ndarray, shape: tuple[int, int]) -> np.ndarray:
+    h, w = shape
+    tr, tc = tile.shape
+    reps_r = (int(h) + int(tr) - 1) // int(tr)
+    reps_c = (int(w) + int(tc) - 1) // int(tc)
+    return np.tile(tile, (reps_r, reps_c))[:h, :w].copy()
