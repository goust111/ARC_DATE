+    broken = top.copy()
+    r0, c0, r1, c1 = hole_box
+    broken[r0 : r1 + 1, c0 : c1 + 1] = BG
+
+    bottom_h = len(bottom_patches) * hh + len(bottom_patches) + 1
+    bottom = np.full((bottom_h, w), BG, dtype=int)
+    for idx, patch in enumerate(bottom_patches):
+        rr = 1 + idx * (hh + 1)
+        cc = rng.randint(0, w - ww)
