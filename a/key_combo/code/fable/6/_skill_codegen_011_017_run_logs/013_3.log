+
+        truth = top[r0 : r0 + hole_h, c0 : c0 + hole_w].copy()
+        allowed_show_rots = [0, 1, 2, 3] if hole_h == hole_w else [0, 2]
+        shown_options = []
+        for show_k in allowed_show_rots:
