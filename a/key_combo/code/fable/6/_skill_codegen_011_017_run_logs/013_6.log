+def _move_direction(coords: tuple[tuple[int, int], ...], axis2: int) -> int:
+    cols2 = [2 * int(c) for _r, c in coords]
+    if max(cols2) < int(axis2):
+        return 1
+    if min(cols2) > int(axis2):
