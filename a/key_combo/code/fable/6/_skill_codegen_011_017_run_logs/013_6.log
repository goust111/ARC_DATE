0055: def main(grid: np.ndarray) -> np.ndarray:
0056:     """
0057:     Recover the repeating background pattern hidden under the largest solid rectangle.
0058: 
0059:     Input structure:
0060:     - The grid is covered by a small row/column periodic pattern.
0061:     - Several non-pattern colors form solid rectangular foreground objects that
0062:       overwrite the pattern.
0063:     - The requested output region is the largest of those solid rectangles.
0064: 
0065:     Rule:
0066:     - Find every 4-connected monochromatic object whose bounding box is a filled
0067:       rectangle with both dimensions greater than one.
0068:     - Treat those rectangles as masks, infer the smallest repeating tile that is
0069:       consistent with all remaining visible pixels, and repaint the largest
0070:       rectangle's coordinates with that tile.
0071: 
0072:     Key insight: The rectangle colors are occluders; the visible pixels outside
0073:     them are enough to reconstruct the original periodic background underneath.
0074:     """
0075:     g = np.asarray(grid, dtype=int)
0076:     rects = _solid_rectangles(g)
0077:     assert rects, "expected at least one solid rectangular occluder"
0078: 
0079:     max_area = max(area for area, *_ in rects)
0080:     targets = [rect for rect in rects if rect[0] == max_area]
0081:     assert len(targets) == 1, "largest rectangle must be unique"
0082:     target = targets[0]
0083: 
0084:     blocked = np.zeros(g.shape, dtype=bool)
0085:     for _, _, r0, c0, r1, c1 in rects:
0086:         blocked[r0 : r1 + 1, c0 : c1 + 1] = True
0087: 
0088:     h, w = g.shape
0089:     period_candidates: list[tuple[int, int, dict[tuple[int, int], int]]] = []
0090:     for row_period in range(1, h + 1):
0091:         for col_period in range(1, w + 1):
0092:             values = _period_values(g, blocked, row_period, col_period)
0093:             if values is not None:
0094:                 period_candidates.append((row_period, col_period, values))
0095:     assert period_candidates, "visible pixels must define a periodic pattern"
0096: 
0097:     min_period_area = min(rp * cp for rp, cp, _ in period_candidates)
0098:     outputs = [
0099:         _reconstruct_rect(values, row_period, col_period, target)
0100:         for row_period, col_period, values in period_candidates
0101:         if row_period * col_period == min_period_area
0102:     ]
0103:     assert outputs, "expected at least one minimal period"
0104:     first = outputs[0]
0105:     assert all(np.array_equal(first, out) for out in outputs), "minimal periods must agree"
0106:     return first
