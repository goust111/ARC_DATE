0106: def _border_mask(r0, c0, sz, shape):
0107:     """Return a boolean mask with True on the border cells of a square."""
0108:     mask = np.zeros(shape, dtype=bool)
0109:     r1, c1 = r0 + sz - 1, c0 + sz - 1
0110:     mask[r0, c0:c1+1] = True
0111:     mask[r1, c0:c1+1] = True
0112:     mask[r0:r1+1, c0] = True
0113:     mask[r0:r1+1, c1] = True
0114:     return mask
