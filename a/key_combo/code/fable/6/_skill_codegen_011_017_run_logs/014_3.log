+        start_col = int(rng.integers(1, max_start_col + 1))
+        start = (0, start_col)
+
+        if turn_count % 2 == 0:
+            total_vertical = h - 1
+            max_horizontal = (w - 1) - start_col
+            if max_horizontal < sum(min_horizontals):
+                continue
+            total_horizontal = int(rng.integers(sum(min_horizontals), max_horizontal + 1))
+        else:
