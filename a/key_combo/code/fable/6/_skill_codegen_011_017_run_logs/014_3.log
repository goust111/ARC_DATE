    actual = mod.main(grid)
    assert isinstance(actual, np.ndarray)
    assert actual.ndim == 2
    assert actual.shape == grid.shape
    assert actual.shape[0] <= 30 and actual.shape[1] <= 30
    assert np.array_equal(actual, expected)

# Public generate_input checks with independent validation.
for idx in range(25):
    grid = mod.generate_input()
    actual = mod.main(grid)
    expected = independent_apply(grid)
    assert isinstance(grid, np.ndarray) and grid.ndim == 2
    assert isinstance(actual, np.ndarray) and actual.ndim == 2
    assert actual.shape == grid.shape
    assert actual.shape[0] <= 30 and actual.shape[1] <= 30
    assert np.array_equal(actual, expected)

