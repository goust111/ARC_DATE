def independent_trace(grid: np.ndarray):
    grid = np.asarray(grid, dtype=int)
    h, w = grid.shape
    starts = [tuple(map(int, rc)) for rc in np.argwhere(grid == GREY) if rc[0] in {0, h - 1} or rc[1] in {0, w - 1}]
    assert len(starts) == 1
    start = starts[0]
    if start[0] == 0:
        direction = (1, 0)
    elif start[0] == h - 1:
        direction = (-1, 0)
    elif start[1] == 0:
        direction = (0, 1)
    else:
        direction = (0, -1)

    reds = [tuple(map(int, rc)) for rc in np.argwhere(grid == RED)]
    redset = set(reds)
    elbows = {}
    visited = set()
    for cell in reds:
        if cell in visited:
            continue
        comp = []
        stack = [cell]
        visited.add(cell)
        while stack:
            cur = stack.pop()
            comp.append(cur)
            r, c = cur
            for nxt in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
                if nxt in redset and nxt not in visited:
                    visited.add(nxt)
                    stack.append(nxt)
        assert len(comp) == 3
        nbrs = {
            cell: [other for other in comp if other "'!= cell and abs(cell[0] - other[0]) + abs(cell[1] - other[1]) == 1]
            for cell in comp
        }
        corner = [cell for cell, linked in nbrs.items() if len(linked) == 2]
        arms = [cell for cell, linked in nbrs.items() if len(linked) == 1]
        assert len(corner) == 1 and len(arms) == 2
        corner = corner[0]
        for arm in arms:
            other = arms[0] if arms[1] == arm else arms[1]
            elbows[arm] = (corner, other, (corner[0] - arm[0], corner[1] - arm[1]), (other[0] - corner[0], other[1] - corner[1]))

    path = []
    current = start
    seen = set()
    while True:
        state = (current, direction)
        assert state not in seen
        seen.add(state)
        nxt = (current[0] + direction[0], current[1] + direction[1])
        if not (0 <= nxt[0] < h and 0 <= nxt[1] < w):
            break
        if nxt in elbows:
            corner, exit_arm, incoming, outgoing = elbows[nxt]
            assert incoming == direction
            path.extend([nxt, corner, exit_arm])
            current = exit_arm
            direction = outgoing
        else:
            path.append(nxt)
            current = nxt
    return start, path, redset


def independent_apply(grid: np.ndarray) -> np.ndarray:
    grid = np.asarray(grid, dtype=int)
    _start, path, redset = independent_trace(grid)
    out = grid.copy()
    movable = [cell for cell in path if cell not in redset]
    beads = []
    occupied = []
    for cell in movable:
        val = int(out[cell])
        if val != BLACK:
            beads.append(val)
            occupied.append(cell)
    for cell in occupied:
        out[cell] = BLACK
    tail = []
    for cell in reversed(path):
        if cell in redset:
            break
        tail.append(cell)
    tail.reverse()
    if beads:
        assert len(tail) >= len(beads)
        for cell, color in zip(tail[-len(beads):], beads):
            out[cell] = int(color)
    return out

