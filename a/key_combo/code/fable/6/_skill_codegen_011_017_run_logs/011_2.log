+    if not candidates:
+        return None
+    order = rng.permutation(len(candidates))
+    for idx in order:
+        straight_cells, turn_cell, new_direction = candidates[int(idx)]
+        added = list(straight_cells) + [turn_cell]
+        new_occupied = set(occupied)
+        new_occupied.update(added)
+        tail = _grow_path(
+            rng,
+            turn_cell,
+            new_direction,
+            new_occupied,
+            shape,
+            segments_used + 1,
+            max_segments,
+        )
