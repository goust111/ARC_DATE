+def _build_blockers(path: list[Coord], shape: tuple[int, int]) -> set[Coord]:
+    path_set = set(path)
+    blockers: set[Coord] = set()
+    for index, cell in enumerate(path):
+        used: set[Coord] = set()
+        if index > 0:
+            prev = path[index - 1]
+            used.add((prev[0] - cell[0], prev[1] - cell[1]))
+        if index + 1 < len(path):
+            nxt = path[index + 1]
+            used.add((nxt[0] - cell[0], nxt[1] - cell[1]))
