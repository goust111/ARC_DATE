+    colors.append(-1)
+    return lengths, colors
+
+
+def _gen_attempt(rng: np.random.Generator) -> np.ndarray | None:
+    shape = (
+        int(rng.integers(GRID_H_RANGE[0], GRID_H_RANGE[1] + 1)),
+        int(rng.integers(GRID_W_RANGE[0], GRID_W_RANGE[1] + 1)),
