+def _path_segment_lengths(path: list[Coord]) -> tuple[list[int], list[int]]:
+    directions = [
+        (path[i + 1][0] - path[i][0], path[i + 1][1] - path[i][1])
+        for i in range(len(path) - 1)
+    ]
+    lengths: list[int] = []
+    colors: list[int] = []
+    start = 0
+    for i in range(1, len(directions)):
