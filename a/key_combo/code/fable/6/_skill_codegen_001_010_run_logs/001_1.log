+    dist = abs(dr) + abs(dc)
+    assert dist >= 4, "rings must be separated by at least one rod pixel"
+    step_r = 0 if dr == 0 else (1 if dr > 0 else -1)
+    step_c = 0 if dc == 0 else (1 if dc > 0 else -1)
