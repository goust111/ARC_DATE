+        base = random.sample(range(4), 3)
+        rots = base + [int(random.choice(base))]
+    else:
+        rots = [0, 1, 2, 3, int(random.randrange(4))]
+    random.shuffle(rots)
+    return [int(rot) for rot in rots]
