+def _planned_moves(grid: np.ndarray) -> tuple[int, int, list[dict], list[tuple[int, int]], list[dict]]:
+    g = np.asarray(grid, dtype=int)
+    bg = _get_bg(g)
+    barrier = _find_barrier_color(g, bg)
+    segments = _extract_segments(g, barrier)
