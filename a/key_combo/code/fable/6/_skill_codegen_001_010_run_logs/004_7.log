+def _marker_spec_list(segments: list[dict]) -> list[dict]:
+    specs = [
+        {"segment_idx": 0, "force_mid": False, "require_non_mid": True, "require_far": True},
+        {"segment_idx": 1, "force_mid": True, "require_non_mid": False, "require_far": False},
