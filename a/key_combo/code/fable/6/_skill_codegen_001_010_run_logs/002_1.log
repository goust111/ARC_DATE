+        return False
+    if int(np.count_nonzero(out == OBSTACLE_COLOR)) != int(np.count_nonzero(grid == OBSTACLE_COLOR)):
+        return False
+    if int(np.count_nonzero(out == CENTER_COLOR)) != 1:
+        return False
