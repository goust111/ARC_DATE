+            mid_r = center[0] + dr * radius + random.randint(-1, 1)
+            mid_c = center[1] + dc * radius + random.randint(-1, 1)
+            if dr == 0:
+                mid_r += random.randint(-2, 2)
+            if dc == 0:
+                mid_c += random.randint(-2, 2)
