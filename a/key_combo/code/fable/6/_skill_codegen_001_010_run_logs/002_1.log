+    for r, c, color in _extract_markers(g, bg):
+        d = int(dist[r, c])
+        assert d > 0, "markers must lie on reachable non-center cells"
+        if d in by_distance:
+            assert by_distance[d] == color, "markers on the same distance contour must agree"
