+def _distance_field(shape: tuple[int, int], start: tuple[int, int], blocked: np.ndarray) -> np.ndarray:
+    """8-connected shortest-path distances through all non-blocked cells."""
+    h, w = map(int, shape)
+    dist = np.full((h, w), -1, dtype=int)
