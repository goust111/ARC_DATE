+    obstacle_count = random.choices(OBSTACLE_COUNT_CHOICES, weights=OBSTACLE_COUNT_WEIGHTS, k=1)[0]
+    blocked = np.zeros((h, w), dtype=bool)
+    if obstacle_count:
+        placed = _place_obstacles((h, w), center, obstacle_count)
