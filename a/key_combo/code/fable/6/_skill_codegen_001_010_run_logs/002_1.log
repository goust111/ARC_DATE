+    out[blocked] = OBSTACLE_COLOR
+    out[center] = CENTER_COLOR
+    for d, color in sorted(by_distance.items()):
+        out[dist == int(d)] = int(color)
+    out[blocked] = OBSTACLE_COLOR
+    out[center] = CENTER_COLOR
+    return out
