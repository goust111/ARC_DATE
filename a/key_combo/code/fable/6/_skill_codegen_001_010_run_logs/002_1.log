+    reachable = dist >= 0
+    max_d = int(dist[reachable].max())
+    usable: list[int] = []
+    impacted: list[int] = []
+    changed_sizes: dict[int, int] = {}
+    cells_by_layer: dict[int, list[tuple[int, int]]] = {}
+
+    for d in range(2, max_d):
+        mask = dist == d
