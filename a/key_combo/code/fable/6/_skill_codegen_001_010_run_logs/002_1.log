+    h, w = map(int, shape)
+    dist = np.full((h, w), -1, dtype=int)
+    sr, sc = map(int, start)
+    if blocked[sr, sc]:
+        return dist
+    dist[sr, sc] = 0
+    q: deque[tuple[int, int]] = deque([(sr, sc)])
+    while q:
+        r, c = q.popleft()
+        nd = int(dist[r, c] + 1)
+        for nr, nc in neighbors8(r, c):
+            if not in_bounds((h, w), nr, nc):
+                continue
+            if blocked[nr, nc] or dist[nr, nc] != -1:
+                continue
+            dist[nr, nc] = nd
+            q.append((nr, nc))
+    return dist
+
