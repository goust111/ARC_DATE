+            min_sep = min((_chebyshev(cell, other) for other in chosen), default=99)
+            edge_clearance = min(cell[0], cell[1], h - 1 - cell[0], w - 1 - cell[1])
+            return (1 if cell in changed else 0, min_sep, edge_clearance)
