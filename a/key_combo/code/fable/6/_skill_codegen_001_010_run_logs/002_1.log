+        no_obstacle_out = np.full_like(grid, bg)
+        no_obstacle_out[grid == CENTER_COLOR] = CENTER_COLOR
+        no_obstacle_out[grid == OBSTACLE_COLOR] = OBSTACLE_COLOR
+        for r, c, color in markers:
