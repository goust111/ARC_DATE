    """Decompose permutation into sequential crossover moves using bypass for cycles.
    Returns list of (src_slot, dst_slot) where -1 means bypass column."""
    N = len(perm)
    visited = [False] * N
    crossovers = []
    for start in range(N):
        if visited[start] or perm[start] == start:
            visited[start] = True
            continue
        cycle = []
        i = start
        while not visited[i]:
            visited[i] = True
            cycle.append(i)

