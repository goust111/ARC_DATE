+
+    spec = {
+        "legend_bbox": legend_bbox,
+        "program": program,
+        "tip": tip,
+        "direction": direction,
+        "arrow_cells": arrow_cells_abs,
+    }
+    if not _validate_instance(grid, spec):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
