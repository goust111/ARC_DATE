+def _components(mask: np.ndarray) -> list[list[Coord]]:
+    h, w = mask.shape
+    seen: set[Coord] = set()
+    out: list[list[Coord]] = []
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or (r, c) in seen:
+                continue
+            stack = [(r, c)]
+            seen.add((r, c))
+            comp: list[Coord] = []
+            while stack:
+                rr, cc = stack.pop()
+                comp.append((rr, cc))
+                for nr, nc in neighbors4(rr, cc):
+                    if in_bounds(mask.shape, nr, nc) and bool(mask[nr, nc]) and (nr, nc) not in seen:
+                        seen.add((nr, nc))
+                        stack.append((nr, nc))
+            out.append(comp)
+    return out
