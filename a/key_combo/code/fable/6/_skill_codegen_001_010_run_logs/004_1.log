def build():
    bg,obstacle,marker,dot=random.sample(range(10),4)
    Llong=random.randint(3,7)
    Lshort=random.randint(0,min(3,Llong-2))
    start_row=Lshort+1
    h=Lshort+Llong+3
    base_left=random.randint(1,4)
    lefts=[None]*h
    for i in range(Lshort+1):
      lefts[start_row-i]=base_left+i
    lefts[0]=random.randint(0,lefts[1])
    for i in range(Llong+1):
      lefts[start_row+i]=base_left+i
    lefts[-1]=random.randint(0,lefts[-2])
    # fill any None (only possible if h small? not really)
    for i,v in enumerate(lefts):
      if v is None:
        lefts[i]=lefts[i-1]
    if max(lefts)-min(lefts) < 1:
      return None
    if max(lefts)+3>10:
      return None
    cs=random.randint(max(2,base_left),6)
    obst_c0=cs+1-base_left
    w=random.randint(max(lefts)+3, max(lefts)+7)
    rows=h+2
    cols=obst_c0+w+3
    if rows>30 or cols>30:
      return None
    g=np.full((rows,cols),bg,dtype=int)
    r0=1
    for rr,left in enumerate(lefts):
      g[r0+rr, obst_c0+left:obst_c0+w]=obstacle
    marker_pos=(r0+start_row,0)
    if g[marker_pos]!=bg: return None
    g[marker_pos]=marker
    # safe cells for dots
    _,start=sightline(g,marker_pos,obstacle,bg)
    paths=walk_paths(g,start,(0,1),obstacle,bg)
    lens=sorted(len(p) for _,p in paths)
    if lens[1]<2 or lens[0]>=lens[1]:
      pass
    low=max(2,lens[0]+1)
    if low>lens[1]: return None
    if lens[1]-1>=low and random.random()<0.75:
      k=random.randint(low,lens[1]-1)
    else:
      k=random.randint(low,lens[1])
    path_cells={start}
    for _,p in paths:
      path_cells.update(p)
    safe=[]
    for r in range(rows):
      for c in range(cols):
        if g[r,c]!=bg: continue
        if abs(r-marker_pos[0])+abs(c-marker_pos[1])<=1: continue
        if r==marker_pos[0] and c<=start[1]: continue
        if (r,c) in path_cells: continue
        if any(in_bounds(g.shape,nr,nc) and g[nr,nc]==obstacle for nr,nc in neighbors4(r,c)): continue
        if min(abs(r-pr)+abs(c-pc) for pr,pc in path_cells)<=1: continue
        safe.append((r,c))
    random.shuffle(safe)
    dots=[]
    for cell in safe:
      if all(abs(cell[0]-r)+abs(cell[1]-c)>1 for r,c in dots):
        dots.append(cell)
        if len(dots)==k: break
    if len(dots)!=k: return None
    for r,c in dots: g[r,c]=dot
    return g

for i in range(500):
    x=build()
    if x is None: continue
    y=main(x)
    print('"'ok',i,x.shape,np.unique(x,return_counts=True)[1].tolist())
    print(x)
    print(y)
    break
else:
    print('none')
