+    for i in range(long_len + 1):
+        lefts[start_row + i] = base_left + i
+    lefts[-1] = random.randint(0, lefts[-2])
+    return lefts
+
+
+def _reserve_safe_dots(
+    grid: np.ndarray,
+    marker_pos: Coord,
+    contour_start: Coord,
+    obstacle: int,
