+        return random.randint(low, long_len - 1)
+    return random.randint(low, long_len)
+
+
+def _make_left_boundary(short_len: int, long_len: int, base_left: int) -> list[int]:
+    start_row = short_len + 1
+    height = short_len + long_len + 3
+    lefts = [0] * height
