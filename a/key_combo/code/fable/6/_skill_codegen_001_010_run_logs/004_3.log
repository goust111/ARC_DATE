  "type": "move_to_match",
  "src": "4-connected foreground object sprite s with boundary connector markers",
  "dst": "matching boundary connector marker d on another sprite",
  "match_cond": "s.marker.color == d.marker.color and the two marker pixels have opposite exposed sides",
  "transform": "translate sprites so each paired marker touches edge-to-edge; preserve sprite colors and orientation",
  "grid_shape": "tight crop of the assembled foreground on the original background color"
}
</annotation>
</reference_puzzle>

