+    sys.path.append(str(_UTILS_DIR))
+
+from arc_utils import crop_bbox, find_components, get_bg, paste, random_free_location
+
+
+MAX_ATTEMPTS = 400
+FRAME_COUNT_CHOICES = (2, 3, 4)
