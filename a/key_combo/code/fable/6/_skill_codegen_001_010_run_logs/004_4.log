+    sys.path.append(str(_UTILS_DIR))
+
+from arc_utils import find_components, get_bg, paint_coords
+
+
+POS_COLOR = 8  # teal / cyan bars
+NEG_COLOR = 2  # red bars
+BAR_COLORS = {POS_COLOR, NEG_COLOR}
+GEN_ATTEMPTS = 400
+GRID_H_RANGE = (18, 24)
+GRID_W_RANGE = (20, 28)
+MAX_BAR_HEIGHT = 7
+TARGET_N_RANGE = (6, 11)
+BAR_COUNT_RANGE = (4, 7)
+OUTLINE_GAP = 1
