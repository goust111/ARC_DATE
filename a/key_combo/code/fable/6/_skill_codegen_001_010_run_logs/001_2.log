+    sr, sc = center_sum
+    pairs: list[tuple[tuple[int, int], tuple[int, int]]] = []
+    for r in range(h):
+        if abs(2 * r - sr) > 2 * radius:
+            continue
+        for c in range(w):
+            if abs(2 * c - sc) > 2 * radius:
+                continue
+            other = _reflect(center_sum, (r, c))
+            if not _in_bounds(shape, *other) or other == (r, c):
+                continue
+            if (r, c) < other:
+                pairs.append(((r, c), other))
