+PLAN_TRIES_PER_CYCLE = 20
+GENERATION_ATTEMPTS = 400
+
+
+def _build_output_attempt() -> dict[str, object] | None:
+    h = random.randint(*GRID_H_RANGE)
+    w = random.randint(*GRID_W_RANGE)
