+    colors = random.sample(PALETTE, n_colors)
+
+    shape = (h, w)
+    occupied: dict[tuple[int, int], int] = {}
+    blocked: set[tuple[int, int]] = set()
+    centers_in_use: list[tuple[int, int]] = []
+    centers: dict[int, tuple[int, int]] = {}
+    groups: dict[int, set[tuple[int, int]]] = {}
+
+    for color in colors:
