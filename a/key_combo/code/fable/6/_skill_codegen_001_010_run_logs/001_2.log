+
+# --------------- generator (output-first, semantic-checked) ---------------
+
+BG_COLOR = 0
+PALETTE = (1, 2, 3, 4, 5, 6, 7, 8, 9)
+
+GRID_H_RANGE = (20, 28)
+GRID_W_RANGE = (20, 28)
+COLOR_COUNT_OPTIONS = (2, 3, 4, 5)
+COLOR_COUNT_WEIGHTS = (2, 4, 4, 2)
