+
+def _enumerate_intervals(edge: np.ndarray, side: str, body: int) -> list[PortInterval]:
+    n = len(edge)
+    out: list[PortInterval] = []
+    for start in range(n):
+        if np.any(edge[:start] != body):
+            continue
+        for end in range(start + 2, n + 1):
+            if np.any(edge[end:] != body):
+                continue
