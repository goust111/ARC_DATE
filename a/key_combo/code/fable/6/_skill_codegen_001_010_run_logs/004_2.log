+        paste(grid, sprite_b, r2, c2, transparent=bg)
+        if get_bg(grid) != bg:
+            continue
+        return grid
+    return None
+
+
+def _build_case() -> tuple[np.ndarray, np.ndarray, bool] | None:
+    bg = random.choice(SEQ_COLORS)
+    bodies = random.sample([c for c in SEQ_COLORS if c != bg], 2)
