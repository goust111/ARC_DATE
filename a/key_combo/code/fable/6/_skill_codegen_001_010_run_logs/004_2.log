+def _side_coord(shape: tuple[int, int], side: str, idx: int) -> tuple[int, int]:
+    h, w = shape
+    idx = int(idx)
+    if side == "T":
+        return 0, idx
+    if side == "B":
+        return h - 1, idx
+    if side == "L":
+        return idx, 0
+    if side == "R":
+        return idx, w - 1
+    raise ValueError(f"bad side: {side}")
