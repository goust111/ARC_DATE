+            seq[0] = body_a
+            if length >= 4 and random.random() < 0.7:
+                seq[-1] = body_a
+        elif hide_mode == "B":
+            seq[-1] = body_b
+            if length >= 4 and random.random() < 0.7:
+                seq[0] = body_b
