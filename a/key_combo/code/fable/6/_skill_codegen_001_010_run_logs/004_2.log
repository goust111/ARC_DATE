+    "T": {"normal": (-1, 0), "opposite": "B"},
+    "B": {"normal": (1, 0), "opposite": "T"},
+    "L": {"normal": (0, -1), "opposite": "R"},
+    "R": {"normal": (0, 1), "opposite": "L"},
