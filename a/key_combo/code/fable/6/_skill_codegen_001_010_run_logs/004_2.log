+    expected = _actual_pair_output(sprite_a, side_a, start_a, seq, sprite_b, side_b, start_b, bg)
+    if max(expected.shape) > 30:
+        return None
+    inp = _scatter_input(sprite_a, sprite_b, bg)
+    if inp is None:
+        return None
+    return inp, expected, hide_mode != "none"
