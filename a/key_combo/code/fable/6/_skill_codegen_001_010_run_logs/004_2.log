+        r2, c2 = _random_rect_position(sprite_b.shape[0], sprite_b.shape[1], out_h, out_w)
+        b1 = (r1, c1, r1 + sprite_a.shape[0] - 1, c1 + sprite_a.shape[1] - 1)
+        b2 = (r2, c2, r2 + sprite_b.shape[0] - 1, c2 + sprite_b.shape[1] - 1)
