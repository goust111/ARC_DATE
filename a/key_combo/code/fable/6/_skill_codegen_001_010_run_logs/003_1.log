+def _is_horizontal_segment_component(coords: np.ndarray) -> bool:
+    rows = sorted({int(r) for r, _c in coords})
+    cols = sorted(int(c) for _r, c in coords)
+    if len(rows) != 1:
+        return False
+    return cols == list(range(cols[0], cols[-1] + 1))
