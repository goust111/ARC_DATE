+
+    basin_source_color = int(basin_paths[0]["source_color"])
+    if basin_source_color != int(palette["sources"][0]):
+        return None
+
+    if len(scene["shelf_rows"]) < 3:
+        return None
+    if len(scene["sources"]) < 2:
+        return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
