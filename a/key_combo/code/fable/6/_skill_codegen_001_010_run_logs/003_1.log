+    for shelf_row, segs in shelf_rows.items():
+        s = int(shelf_row)
+        if s >= int(end_row) or s < 1:
+            continue
+        if not np.all(g[s : int(end_row) + 1, int(col)] == int(bg)):
+            continue
+        for a, b in segs:
+            if int(col) == int(a - 1) or int(col) == int(b + 1):
+                for impact_col in range(int(a), int(b) + 1):
