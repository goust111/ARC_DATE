+            rng,
+            grid,
+            int(palette["bg"]),
+            int(palette["shelf"]),
+            used_rows,
+            int(source_col),
+            int(zone[0]),
+            int(zone[-1]),
+            basin,
+            min_depth=min_depth,
+            max_depth=max_depth,
