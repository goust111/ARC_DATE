+        "match_indices": ordered_match_indices,
+        "expected": expected,
+    }
+    return grid, meta
+
+
+def _validate_instance(grid: np.ndarray, meta: dict) -> bool:
+    if not isinstance(grid, np.ndarray) or grid.ndim != 2:
+        return False
+    if max(grid.shape) > 30:
