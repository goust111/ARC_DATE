+    if name == "rot270":
+        return np.rot90(arr, 3).copy()
+    if name == "flip_lr":
+        return np.fliplr(arr).copy()
+    if name == "flip_ud":
+        return np.flipud(arr).copy()
+    if name == "transpose":
+        return arr.T.copy()
+    if name == "anti_transpose":
+        return np.flipud(np.fliplr(arr)).T.copy()
