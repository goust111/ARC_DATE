+    meta = {
+        "row_colors": row_colors,
+        "row_transforms": row_transforms,
+        "query_color": query_color,
+        "query_mask": query_mask,
+        "query_sprite": query_sprite,
+        "match_indices": ordered_match_indices,
+        "expected": expected,
