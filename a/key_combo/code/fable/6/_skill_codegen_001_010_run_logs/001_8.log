+        grid[top : top + left_sprite.shape[0], row_left_cs[idx] : row_left_cs[idx] + left_sprite.shape[1]] = left_sprite
+        grid[top : top + right_sprite.shape[0], row_right_cs[idx] : row_right_cs[idx] + right_sprite.shape[1]] = right_sprite
