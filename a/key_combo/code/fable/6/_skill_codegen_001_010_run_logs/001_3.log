+    attempts: int = 500,
+) -> list[Coord] | None:
+    h, w = shape
+    blocked = set() if blocked is None else set(blocked)
+    starts = [
+        (r, c)
+        for r in range(margin, h - margin)
+        for c in range(margin, w - margin)
