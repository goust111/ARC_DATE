+def _sample_segment_lengths(segment_count: int) -> list[int]:
+    lengths = [random.randint(1, 3) for _ in range(segment_count)]
+    if segment_count <= 4 and random.random() < 0.45:
+        idx = random.randrange(segment_count)
+        lengths[idx] += 1
+    return lengths
