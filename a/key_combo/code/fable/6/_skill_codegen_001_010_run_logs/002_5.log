+def _is_connected(mask: np.ndarray) -> bool:
+    coords = [tuple(map(int, rc)) for rc in np.argwhere(mask)]
+    if not coords:
+        return False
+    seen = {coords[0]}
+    stack = [coords[0]]
+    coord_set = set(coords)
+    while stack:
+        r, c = stack.pop()
+        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+            nxt = (r + dr, c + dc)
