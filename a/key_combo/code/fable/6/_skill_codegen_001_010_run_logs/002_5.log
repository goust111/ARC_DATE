+def _frame_info(grid: np.ndarray, bg: int) -> tuple[tuple[int, int, int, int], int]:
+    candidates = []
+    for comp in find_components(
+        grid,
+        bg=bg,
+        connectivity=4,
+        monochromatic=True,
+        return_format="dict",
+    ):
+        color = int(comp["color"])
+        r0, c0, r1, c1 = map(int, comp["bbox"])
+        side_h = r1 - r0 + 1
+        side_w = c1 - c0 + 1
+        if side_h != side_w or side_h < FRAME_SIDE_RANGE[0]:
