+    return None
+
+
+def _sample_slot_fuel_counts(shifts: list[int]) -> list[int] | None:
+    n_bars = len(shifts)
+    for _ in range(800):
+        counts = _RNG.integers(0, 4, size=n_bars).astype(int).tolist()
