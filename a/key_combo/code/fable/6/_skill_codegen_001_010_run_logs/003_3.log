+        return sum(int(slot_fuel_counts[(start_idx + t) % n]) for t in range(1, steps))
+    if mode == "binary":
+        return sum(1 for t in range(1, steps) if int(slot_fuel_counts[(start_idx + t) % n]) > 0)
+    if mode == "inclusive":
