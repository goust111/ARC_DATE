+    distractor_dicts = [
+        {"color": len(used_shapes) + idx + 1, "shape": shape, "shape_h": _shape_dims(shape)[0], "shape_w": _shape_dims(shape)[1], "area": len(shape), "coords": shape}
+        for idx, shape in enumerate(distractor_shapes)
