+from __future__ import annotations
+
+import random
+import sys
+from functools import lru_cache
+from pathlib import Path
+
+import numpy as np
+
+_UTILS_DIR = Path("/home/lixinyu/snap/new/solvers")
+if str(_UTILS_DIR) not in sys.path:
