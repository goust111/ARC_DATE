+def _solve_unique_tiling(
+    pieces: list[dict], inner_h: int, inner_w: int, max_solutions: int = 2
+) -> list[list[dict]]:
+    n = len(pieces)
+    total_cells = inner_h * inner_w
+    target_mask = (1 << total_cells) - 1
+    piece_areas = [int(piece["area"]) for piece in pieces]
