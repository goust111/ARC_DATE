+    for piece_idx in range(n_pieces):
+        shape = _normalize_coords([cell for cell, idx in owner.items() if idx == piece_idx])
+        if len(shape) < 2 or not _is_connected(shape) or _has_hole(shape) or _is_hollow_frame_shape(shape):
+            return None
+        pieces.append(shape)
