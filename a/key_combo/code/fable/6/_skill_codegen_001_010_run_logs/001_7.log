+def _is_frame_component(grid: np.ndarray, component: dict, bg: int) -> bool:
+    color = int(component["color"])
+    r0, c0, r1, c1 = map(int, component["bbox"])
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
