+def _random_partition(inner_h: int, inner_w: int, n_pieces: int) -> list[tuple[tuple[int, int], ...]] | None:
+    cells = [(r, c) for r in range(inner_h) for c in range(inner_w)]
+    if len(cells) < 2 * n_pieces:
+        return None
