+def _placement_options(piece: dict, inner_h: int, inner_w: int) -> list[dict]:
+    h = int(piece["shape_h"])
+    w = int(piece["shape_w"])
+    if h > inner_h or w > inner_w:
+        return []
+    options = []
+    for r0 in range(inner_h - h + 1):
+        for c0 in range(inner_w - w + 1):
