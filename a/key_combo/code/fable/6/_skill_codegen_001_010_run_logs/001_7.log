+        option_counts.append(len(options))
+        for option in options:
+            oid = len(flat_options)
+            flat_options.append(
+                {
+                    "piece_idx": piece_idx,
+                    "mask": int(option["mask"]),
+                    "cells": option["cells"],
+                    "origin": option["origin"],
