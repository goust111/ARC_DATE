+def _shape_dims(shape: tuple[tuple[int, int], ...]) -> tuple[int, int]:
+    return max(r for r, _ in shape) + 1, max(c for _, c in shape) + 1
+
+
+def _shape_mask(shape: tuple[tuple[int, int], ...]) -> np.ndarray:
+    h, w = _shape_dims(shape)
+    mask = np.zeros((h, w), dtype=bool)
+    for r, c in shape:
+        mask[r, c] = True
+    return mask
+
+
+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _is_connected(shape: tuple[tuple[int, int], ...]) -> bool:
+    cells = set(shape)
+    start = next(iter(cells))
+    stack = [start]
+    seen = {start}
+    while stack:
+        r, c = stack.pop()
+        for nr, nc in _neighbors4(r, c):
+            if (nr, nc) in cells and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                stack.append((nr, nc))
+    return len(seen) == len(cells)
+
+
+def _has_hole(shape: tuple[tuple[int, int], ...]) -> bool:
+    mask = _shape_mask(shape)
+    h, w = mask.shape
+    visited = np.zeros_like(mask, dtype=bool)
+    stack: list[tuple[int, int]] = []
+    for r in range(h):
+        for c in range(w):
+            if r not in (0, h - 1) and c not in (0, w - 1):
+                continue
+            if mask[r, c] or visited[r, c]:
+                continue
+            visited[r, c] = True
+            stack.append((r, c))
+    while stack:
+        r, c = stack.pop()
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc] and not visited[nr, nc]:
+                visited[nr, nc] = True
+                stack.append((nr, nc))
+    return bool((~mask & ~visited).any())
