+def _has_alternative_area_subset(all_areas: list[int], target_area: int, used_count: int) -> bool:
+    n = len(all_areas)
+    used_mask = (1 << used_count) - 1
+    for subset in range(1, 1 << n):
+        if subset == used_mask:
+            continue
+        area = 0
+        for idx in range(n):
+            if (subset >> idx) & 1:
+                area += all_areas[idx]
+        if area == target_area:
