+def _shape_to_patch(shape: tuple[tuple[int, int], ...], color: int, bg: int = BG) -> np.ndarray:
+    mask = _shape_mask(shape)
+    patch = np.full(mask.shape, bg, dtype=int)
+    patch[mask] = int(color)
+    return patch
