+            visited[r, c] = True
+            stack.append((r, c))
+    while stack:
+        r, c = stack.pop()
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc] and not visited[nr, nc]:
+                visited[nr, nc] = True
+                stack.append((nr, nc))
