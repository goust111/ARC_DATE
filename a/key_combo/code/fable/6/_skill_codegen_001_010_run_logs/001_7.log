+
+        uncovered_mask = target_mask ^ filled_mask
+        best_options: list[int] | None = None
+        bits = uncovered_mask
+        while bits:
+            lsb = bits & -bits
+            cell = lsb.bit_length() - 1
+            viable = []
+            for oid in by_cell[cell]:
