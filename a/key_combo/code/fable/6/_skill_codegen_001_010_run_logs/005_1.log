+    H, W = g.shape
+    seen = np.zeros((H, W), dtype=bool)
+    if connectivity == 4:
+        deltas = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+    else:
+        deltas = [(dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if (dr, dc) != (0, 0)]
+
+    out: list[dict] = []
+    for r in range(H):
+        for c in range(W):
+            if seen[r, c]:
+                continue
+            if int(g[r, c]) == int(bg):
+                seen[r, c] = True
