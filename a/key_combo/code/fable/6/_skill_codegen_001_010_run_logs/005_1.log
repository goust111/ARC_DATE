+    g = np.asarray(grid, dtype=int)
+    H, W = g.shape
+    seen = np.zeros((H, W), dtype=bool)
+    if connectivity == 4:
+        deltas = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+    else:
+        deltas = [(dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if (dr, dc) != (0, 0)]
+
+    out: list[dict] = []
+    for r in range(H):
+        for c in range(W):
+            if seen[r, c]:
+                continue
+            if int(g[r, c]) == int(bg):
+                seen[r, c] = True
+                continue
+            color = int(g[r, c])
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((int(rr), int(cc)))
+                for dr, dc in deltas:
+                    nr = int(rr + dr)
+                    nc = int(cc + dc)
+                    if not (0 <= nr < H and 0 <= nc < W):
+                        continue
+                    if seen[nr, nc]:
+                        continue
+                    if monochromatic:
+                        good = int(g[nr, nc]) == color
+                    else:
+                        good = int(g[nr, nc]) != int(bg)
+                    if good:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            arr = np.asarray(coords, dtype=int)
+            out.append(
+                {
+                    "color": color if monochromatic else None,
+                    "coords": arr,
+                    "bbox": bbox_coords(arr),
+                    "area": int(arr.shape[0]),
+                }
+            )
