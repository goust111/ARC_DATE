+    solid_rects = []
+    for comp in comps:
+        box = comp["bbox"]
+        h = bbox_h(box)
+        w = bbox_w(box)
+        if h == w:
+            continue
+        r0, c0, r1, c1 = box
+        patch = g[r0 : r1 + 1, c0 : c1 + 1]
+        color = int(comp["color"])
+        if int(comp["area"]) == int(h * w) and bool((patch == color).all()):
+            solid_rects.append(
+                {
+                    "color": color,
+                    "bbox": box,
+                    "r0": int(r0),
+                    "c0": int(c0),
+                    "h": int(h),
+                    "w": int(w),
+                }
+            )
