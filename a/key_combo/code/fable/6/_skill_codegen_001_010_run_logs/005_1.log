+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+def get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.reshape(-1))).most_common(1)[0][0])
+
+
+def neighbors4(r: int, c: int):
+    yield int(r - 1), int(c)
+    yield int(r + 1), int(c)
+    yield int(r), int(c - 1)
+    yield int(r), int(c + 1)
+
+
+def bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def bbox_h(box: tuple[int, int, int, int]) -> int:
+    return int(box[2] - box[0] + 1)
+
+
+def bbox_w(box: tuple[int, int, int, int]) -> int:
+    return int(box[3] - box[1] + 1)
+
+
+def find_components(
+    grid: np.ndarray,
+    *,
+    bg: int,
+    connectivity: int = 4,
+    monochromatic: bool = True,
+) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    H, W = g.shape
+    seen = np.zeros((H, W), dtype=bool)
+    if connectivity == 4:
+        deltas = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+    else:
+        deltas = [(dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if (dr, dc) != (0, 0)]
+
+    out: list[dict] = []
+    for r in range(H):
+        for c in range(W):
+            if seen[r, c]:
+                continue
+            if int(g[r, c]) == int(bg):
+                seen[r, c] = True
+                continue
+            color = int(g[r, c])
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((int(rr), int(cc)))
+                for dr, dc in deltas:
+                    nr = int(rr + dr)
+                    nc = int(cc + dc)
+                    if not (0 <= nr < H and 0 <= nc < W):
+                        continue
+                    if seen[nr, nc]:
+                        continue
+                    if monochromatic:
+                        good = int(g[nr, nc]) == color
+                    else:
+                        good = int(g[nr, nc]) != int(bg)
+                    if good:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            arr = np.asarray(coords, dtype=int)
+            out.append(
+                {
+                    "color": color if monochromatic else None,
+                    "coords": arr,
+                    "bbox": bbox_coords(arr),
+                    "area": int(arr.shape[0]),
+                }
+            )
+    return out
+
+
+def _window_all_true(mask: np.ndarray, h: int, w: int) -> np.ndarray:
+    H, W = mask.shape
+    if H < h or W < w:
+        return np.zeros((0, 0), dtype=bool)
+    ii = np.pad(mask.astype(np.int16), ((1, 0), (1, 0))).cumsum(axis=0).cumsum(axis=1)
+    sums = ii[h:, w:] - ii[:-h, w:] - ii[h:, :-w] + ii[:-h, :-w]
+    return sums == int(h * w)
+
+
+def _bfs_mask(mask: np.ndarray, start: tuple[int, int]) -> np.ndarray:
+    H, W = mask.shape
+    sr, sc = start
+    seen = np.zeros_like(mask, dtype=bool)
+    if not (0 <= sr < H and 0 <= sc < W) or not bool(mask[sr, sc]):
+        return seen
+    q = deque([(int(sr), int(sc))])
+    seen[sr, sc] = True
+    while q:
+        r, c = q.popleft()
+        for nr, nc in neighbors4(r, c):
+            if 0 <= nr < H and 0 <= nc < W and bool(mask[nr, nc]) and not bool(seen[nr, nc]):
+                seen[nr, nc] = True
+                q.append((int(nr), int(nc)))
+    return seen
+
+
+def _degree_grid(mask: np.ndarray) -> np.ndarray:
+    H, W = mask.shape
+    deg = np.zeros((H, W), dtype=int)
+    for r in range(H):
+        for c in range(W):
+            if not bool(mask[r, c]):
+                continue
+            count = 0
+            for nr, nc in neighbors4(r, c):
+                if 0 <= nr < H and 0 <= nc < W and bool(mask[nr, nc]):
+                    count += 1
+            deg[r, c] = int(count)
+    return deg
+
+
+def _analyze_grid(grid: np.ndarray) -> dict:
+    g = np.asarray(grid, dtype=int)
+    bg = int(get_bg(g))
+    comps = find_components(g, bg=bg, connectivity=4, monochromatic=True)
