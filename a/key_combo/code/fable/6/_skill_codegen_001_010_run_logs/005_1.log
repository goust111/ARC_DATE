            out[0, :] = int(color)
        elif direction == (1, 0):
            assert np.all(g[H - 1, :] == bg)
            out[H - 1, :] = int(color)
        elif direction == (0, -1):
            assert np.all(g[:, 0] == bg)
            out[:, 0] = int(color)
        elif direction == (0, 1):
