+            if int(g[r, c]) == int(bg):
+                seen[r, c] = True
+                continue
+            color = int(g[r, c])
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((int(rr), int(cc)))
+                for dr, dc in deltas:
+                    nr = int(rr + dr)
+                    nc = int(cc + dc)
+                    if not (0 <= nr < H and 0 <= nc < W):
