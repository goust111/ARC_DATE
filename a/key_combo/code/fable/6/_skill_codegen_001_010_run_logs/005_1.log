+    branches = [
+        {"name": "up", "target": shift_pt(up_target), "segs": [(axis, [shift_pt(p) for p in seg]) for axis, seg in up_segments]},
+        {"name": "dn", "target": shift_pt(dn_target), "segs": [(axis, [shift_pt(p) for p in seg]) for axis, seg in dn_segments]},
