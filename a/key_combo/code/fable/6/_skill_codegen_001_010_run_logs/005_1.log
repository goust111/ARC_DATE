+    groups: dict[tuple[int, int], list[dict]] = {}
+    for rect in solid_rects:
+        groups.setdefault((int(rect["h"]), int(rect["w"])), []).append(rect)
+    rect_groups = [items for items in groups.values() if len(items) == 3]
+    assert len(rect_groups) == 1
+    rects = rect_groups[0]
+    h = int(rects[0]["h"])
+    w = int(rects[0]["w"])
