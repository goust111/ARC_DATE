+                    "coords": arr,
+                    "bbox": bbox_coords(arr),
+                    "area": int(arr.shape[0]),
+                }
+            )
+    return out
+
+
+def _window_all_true(mask: np.ndarray, h: int, w: int) -> np.ndarray:
+    H, W = mask.shape
+    if H < h or W < w:
+        return np.zeros((0, 0), dtype=bool)
