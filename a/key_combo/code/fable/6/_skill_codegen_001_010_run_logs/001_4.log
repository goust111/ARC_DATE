+
+def _all_matches(grid: np.ndarray) -> tuple[np.ndarray, list[Match]]:
+    g, bg, big_color, _big_visible, original_mask, hole_components, templates = _parse_scene(grid)
+
+    matches: list[Match] = []
+    planned: dict[tuple[int, int], int] = {}
