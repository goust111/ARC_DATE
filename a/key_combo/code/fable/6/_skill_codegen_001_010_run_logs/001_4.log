+    grid_w = random.randint(max(GRID_W_RANGE[0], big_w + 7), GRID_W_RANGE[1])
+    big_top = random.randint(2, grid_h - big_h - 2)
+    big_left = random.randint(2, grid_w - big_w - 2)
