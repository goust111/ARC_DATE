+            idx = random.randrange(len(frontier))
+            cell = frontier.pop(idx)
+            if cell in chosen:
+                continue
+            chosen.add(cell)
+            for nbr in neighbors4(*cell):
+                if nbr in cell_set and nbr not in chosen:
+                    frontier.append(nbr)
