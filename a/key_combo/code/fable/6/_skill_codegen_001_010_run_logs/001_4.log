+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        pair = _gen_attempt()
+        if pair is not None:
+            return pair[0]
+    raise RuntimeError("failed to generate valid input for puzzle 4")

