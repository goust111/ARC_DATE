+    planned_matches: list[tuple[int, frozenset[tuple[int, int]], frozenset[tuple[int, int]], bool]] = []
+    for idx, (template_mask, (ttop, tleft), color, record) in enumerate(
+        zip(template_masks, outside, template_colors, hole_records)
