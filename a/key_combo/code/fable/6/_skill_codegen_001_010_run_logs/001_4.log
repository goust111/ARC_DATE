+        exacts = [p for p in placements if p["all_interior"]]
+        partials = [p for p in placements if p["groups"]]
+        boundary_partials = [p for p in partials if not p["all_interior"]]
+        template_infos.append(
+            {
+                "mask": mask,
+                "placements": placements,
+                "exacts": exacts,
+                "partials": partials,
