+def _placement_groups(
+    big_mask: np.ndarray,
+    strict: np.ndarray,
+    template_mask: np.ndarray,
+) -> list[dict[str, object]]:
+    big_h, big_w = big_mask.shape
+    th, tw = template_mask.shape
