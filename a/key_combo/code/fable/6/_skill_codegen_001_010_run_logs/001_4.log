+    def rec(pos: int, blocked: set[tuple[int, int]]) -> bool:
+        if pos == len(order):
+            return True
+        idx = order[pos]
+        for placement in pools[idx]:
+            cells = tuple(placement["cells"])
+            if any(cell in blocked for cell in cells):
