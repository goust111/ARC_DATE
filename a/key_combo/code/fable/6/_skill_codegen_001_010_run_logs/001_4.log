+    for r in range(1, h - 1):
+        for c in range(1, w - 1):
+            if (
+                mask[r, c]
+                and mask[r - 1, c]
+                and mask[r + 1, c]
+                and mask[r, c - 1]
+                and mask[r, c + 1]
+            ):
+                out[r, c] = True
+    return out
+
+
+def _expand_cells(cells: tuple[tuple[int, int], ...], shape: tuple[int, int]) -> set[tuple[int, int]]:
+    h, w = map(int, shape)
+    out: set[tuple[int, int]] = set()
+    for r, c in cells:
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                rr, cc = int(r + dr), int(c + dc)
+                if 0 <= rr < h and 0 <= cc < w:
+                    out.add((rr, cc))
