+    out: list[dict[str, object]] = []
+
+    for top in range(big_h - th + 1):
+        for left in range(big_w - tw + 1):
+            cells = tuple((int(top + r), int(left + c)) for r, c in rel_cells)
+            if any(not big_mask[r, c] for r, c in cells):
+                continue
