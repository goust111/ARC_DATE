+            groups: list[tuple[tuple[int, int], ...]] = []
+            for comp in components_mask(local_interior, connectivity=4):
+                group = tuple((int(top + r), int(left + c)) for r, c in comp)
+                if len(group) >= 2:
+                    groups.append(group)
