+        candidates = []
+        for top in range(h - th + 1):
+            for left in range(w - tw + 1):
+                r0 = max(0, top - 1)
+                r1 = min(h, top + th + 1)
+                c0 = max(0, left - 1)
+                c1 = min(w, left + tw + 1)
+                if blocked[r0:r1, c0:c1].any():
+                    continue
+                candidates.append((top, left))
+        if not candidates:
+            return None
+        top, left = random.choice(candidates)
+        placements.append((int(top), int(left)))
+        r0 = max(0, top - 1)
+        r1 = min(h, top + th + 1)
+        c0 = max(0, left - 1)
+        c1 = min(w, left + tw + 1)
+        blocked[r0:r1, c0:c1] = True
+    return placements
