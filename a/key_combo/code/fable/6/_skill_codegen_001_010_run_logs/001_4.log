+    if not rec(0, set()):
+        return None
+
+    result = []
+    for i in range(count):
+        result.append(
+            {
+                "placement": chosen[i],
+                "kind": kinds[i],
+                "force_boundary_growth": i == growth_idx and bool(template_infos[i]["boundary_partials"]),
+            }
+        )
