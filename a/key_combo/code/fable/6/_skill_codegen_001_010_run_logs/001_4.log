+        matches.append(
+            Match(
+                hole_index=int(hole_index),
+                hole_cells=hole_cells,
+                template_index=int(chosen.template_index),
+                color=int(chosen.color),
+                top=int(chosen.top),
+                left=int(chosen.left),
+                footprint=chosen.cells,
