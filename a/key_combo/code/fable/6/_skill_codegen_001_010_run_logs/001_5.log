def _paint(records: list[Record], n: int) -> tuple[np.ndarray, np.ndarray]:
    inp = np.full((n, n), BG, dtype=int)
    out = np.full((n, n), BG, dtype=int)
    for rec in records:
        hinge = rec["hinge"]
        endpoint = rec["endpoint"]
        inp[hinge] = HINGE
        out[hinge] = HINGE
        inp[endpoint] = END
        out[endpoint] = END
        for p in rec["fixed_red"]:
            inp[p] = RED
            out[p] = RED
        for p in rec["tail"]:
            inp[p] = RED
        for p in rec["folded"]:
            out[p] = RED
    return inp, out


def _place_records(n: int, rod_count: int) -> list[Record] | None:
    """Sample non-touching rods and their fold envelopes for one grid."""
    blocked: set[tuple[int, int]] = set()
    records: list[Record] = []
    red_total = 0

