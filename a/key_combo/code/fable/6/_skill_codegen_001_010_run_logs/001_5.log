+def _ray_cells(origin: tuple[int, int], step: tuple[int, int], count: int) -> list[tuple[int, int]]:
+    r, c = map(int, origin)
+    dr, dc = map(int, step)
+    return [(int(r + dr * k), int(c + dc * k)) for k in range(1, int(count) + 1)]
