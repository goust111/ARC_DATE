+
+def get_bg(grid: np.ndarray) -> int:
+    """Return the most common color, matching arc_utils conventions."""
+    return int(Counter(map(int, grid.flatten())).most_common(1)[0][0])
+
+
+def in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = map(int, shape)
+    return 0 <= int(r) < h and 0 <= int(c) < w
+
+
+def neighbors4(r: int, c: int):
+    yield int(r - 1), int(c)
+    yield int(r + 1), int(c)
+    yield int(r), int(c - 1)
+    yield int(r), int(c + 1)
+
+
+def components_mask(mask: np.ndarray) -> list[np.ndarray]:
+    """4-connected components of a boolean mask as (N,2) coord arrays."""
+    m = np.asarray(mask, dtype=bool)
+    h, w = m.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not bool(m[r, c]) or bool(seen[r, c]):
+                continue
+            stack = [(int(r), int(c))]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((int(rr), int(cc)))
+                for nr, nc in neighbors4(rr, cc):
+                    if not in_bounds(m.shape, nr, nc):
+                        continue
+                    if not bool(m[nr, nc]) or bool(seen[nr, nc]):
+                        continue
+                    seen[nr, nc] = True
+                    stack.append((int(nr), int(nc)))
+            comps.append(np.array(coords, dtype=int))
+    return comps
