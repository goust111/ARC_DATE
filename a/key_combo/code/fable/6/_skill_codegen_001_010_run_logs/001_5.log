+import numpy as np
+
+
+BG = 0
+RED = 2
+SPARK = 3
+HINGE = 4
+ENDPOINT = 5
+
+ROD_COLORS = {RED, HINGE, ENDPOINT}
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+GRID_MIN = 16
+GRID_MAX = 28
+CHAIN_CHOICES = [2, 3, 3, 4]
+DISTRACTOR_CHOICES = [1, 1, 2, 2, 3]
+FIXED_LEN_RANGE = (2, 6)
+TAIL_LEN_RANGE = (2, 5)
+MAX_GENERATE_ATTEMPTS = 400
+MAX_PLACE_TRIES = 600
