+    return {
+        "orient": orient,
+        "hinge": tuple(map(int, hinge)),
+        "endpoint": tuple(map(int, endpoint)),
+        "fixed_red": list(fixed_red),
+        "tail": list(tail),
+        "folded": list(folded),
+        "tail_set": set(tail),
+        "input_set": input_cells,
+        "non_tail_set": input_cells - set(tail),
+        "envelope": envelope,
+        "fixed_len": fixed_len,
+        "tail_len": tail_len,
+    }
+
+
+def _parse_rod(grid: np.ndarray, coords: np.ndarray) -> dict[str, object]:
