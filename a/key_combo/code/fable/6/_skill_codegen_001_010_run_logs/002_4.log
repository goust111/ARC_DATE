+    q: deque[tuple[int, int]] = deque()
+
+    for r in range(h):
+        for c in (0, w - 1):
+            if void[r, c] and not exterior[r, c]:
+                exterior[r, c] = True
+                q.append((int(r), int(c)))
+    for c in range(w):
+        for r in (0, h - 1):
+            if void[r, c] and not exterior[r, c]:
+                exterior[r, c] = True
+                q.append((int(r), int(c)))
