+    """Paste a patch into dst at top-left (r0,c0)."""
+    r0 = int(r0)
+    c0 = int(c0)
+    h, w = map(int, patch.shape)
+    dst_view = dst[r0 : r0 + h, c0 : c0 + w]
+    if transparent is None:
+        dst_view[:, :] = patch
+    else:
+        mask = patch != int(transparent)
+        dst_view[mask] = patch[mask]
