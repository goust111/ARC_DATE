+
+_DIR4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+_ALL_COLORS = tuple(range(10))
+_SLOT_GRIDS = ((1, 1), (1, 2), (2, 1), (2, 2))
+
+_HOLE_SIZE = 2
+_GRID_MIN = 20
+_GRID_MAX = 30
