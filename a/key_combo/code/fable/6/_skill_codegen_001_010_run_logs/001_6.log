+def _assemble_grid(candidates: list[np.ndarray], top_seq: tuple[int, ...], left_seq: tuple[int, ...]) -> np.ndarray:
+    height, width = map(int, candidates[0].shape)
+    n_candidates = len(candidates)
+    if n_candidates == 4:
