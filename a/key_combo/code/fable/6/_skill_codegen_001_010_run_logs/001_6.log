+def _sample_mask(height: int, width: int) -> tuple[np.ndarray, tuple[int, ...], tuple[int, ...], list[int], list[int]] | None:
+    area_min = int(np.ceil(0.48 * int(height) * int(width)))
+    area_max = int(np.floor(0.82 * int(height) * int(width)))
+
