+NODE_SIZE_CHOICES = (2, 3)
+GAP_CHOICES = (2, 3, 4)
+BACKGROUND_CHOICES = (0, 4, 6, 7, 8, 9)
+PATH_NODE_COUNT_RANGE = (4, 6)
+MAX_GENERATION_ATTEMPTS = 500
+NON_TERMINAL_COLORS = [c for c in range(10) if c not in {int(Color.BLUE), int(Color.RED), TRACK_COLOR}]
