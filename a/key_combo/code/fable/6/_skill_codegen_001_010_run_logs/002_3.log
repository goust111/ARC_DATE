+    bg = int(get_bg(g))
+    out = g.copy()
+    comps = find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format="dict")
+    for comp in comps:
+        info = _parse_component(g, comp["coords"])
+        _apply_component_transform(out, info, bg)
