+Coord = tuple[int, int]
+DIR4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+COLOR_POOL = tuple(range(10))
+
+GRID_HEIGHT_RANGE = (20, 30)
+GRID_WIDTH_RANGE = (20, 30)
