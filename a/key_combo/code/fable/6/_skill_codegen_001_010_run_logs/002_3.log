+    for comp in comps:
+        info = _parse_component(grid, comp["coords"])
+        near_seen |= int(info["target_distance"]) < int(info["other_distance"])
+        far_seen |= int(info["target_distance"]) > int(info["other_distance"])
+        turn_seen |= int(info["turn_count"]) > 0
