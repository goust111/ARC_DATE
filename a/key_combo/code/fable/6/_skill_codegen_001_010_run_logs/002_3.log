+        if any((int(nr), int(nc)) in used and (int(nr), int(nc)) != tail for nr, nc in neighbors4(*nxt)):
+            continue
+        path.append(nxt)
+        used.add(nxt)
+        if _grow_walk(path, used, target_len):
+            return True
+        used.remove(nxt)
+        path.pop()
+    return False
+
+
