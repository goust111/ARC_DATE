+        chain = info["chain"]
+        marker_idx = int(info["marker_idx"])
+        parking_idx = int(info["target_gate"]["parking_idx"])
+        if marker_idx in {0, len(chain) - 1} or parking_idx in {0, len(chain) - 1}:
+            return False
