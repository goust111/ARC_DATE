+        path = [(0, 0)]
+        used = {path[0]}
+        if not _grow_walk(path, used, int(length)):
+            continue
+        if require_turn and _turn_count(path) == 0:
+            continue
+        if not _walk_has_valid_gates(path):
+            continue
+        return path
+    raise RuntimeError("failed to build a valid path walk")
