+def _scan_capture(
+    grid: np.ndarray,
+    singletons: set[tuple[int, int]],
+    start: tuple[int, int],
+    step: tuple[int, int],
+) -> tuple[int, int] | None:
+    h, w = grid.shape
+    r, c = map(int, start)
+    dr, dc = map(int, step)
+    while 0 <= r < h and 0 <= c < w:
+        if (r, c) in singletons:
+            return (r, c)
+        r += dr
+        c += dc
+    return None
