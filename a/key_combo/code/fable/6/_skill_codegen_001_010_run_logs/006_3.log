+                out.append(
+                    {
+                        "side": "top",
+                        "notch": (r0, c),
+                        "ray_step": (-1, 0),
+                        "scan_start": (r0 - 1, c),
+                        "landing": (r1 + 1, c),
+                    }
+                )
+            if int(grid[r1, c]) == int(bg) and int(grid[r1 - 1, c]) == body_color:
+                out.append(
