+    bg = int(spec["bg"])
+    body_color = int(spec["body_color"])
+    for rec in spec["captures"]:
+        rr, cc = map(int, rec["capture"])
+        nr, nc = map(int, rec["notch"])
+        lr, lc = map(int, rec["landing"])
+        if int(inp[rr, cc]) != int(rec["color"]) or int(out[rr, cc]) != bg:
