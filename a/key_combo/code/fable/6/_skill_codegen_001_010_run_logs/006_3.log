+def _notches(grid: np.ndarray, bg: int, body: dict) -> list[dict]:
+    r0, c0, r1, c1 = map(int, body["bbox"])
+    body_color = int(body["color"])
+    out: list[dict] = []
+    orientation = _body_orientation(body)
+
+    if orientation == "horizontal":
