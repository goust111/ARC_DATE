+def _validate_scene(inp: np.ndarray, spec: dict) -> bool:
+    out = main(inp)
+    expected = _expected_from_spec(inp, spec)
+    if not np.array_equal(out, expected):
+        return False
+    if np.array_equal(inp, out):
+        return False
