+    perimeter = len(border)
+    max_len = h + w - 1
+    raw: list[tuple[tuple[tuple[int, int], ...], tuple[str, ...]]] = []
+
+    for start in range(perimeter):
+        for lengths in _compositions(perimeter, count, 2, max_len):
+            pos = start
+            arcs: list[tuple[tuple[int, int], ...]] = []
+            kinds: list[str] = []
+            for length in lengths:
