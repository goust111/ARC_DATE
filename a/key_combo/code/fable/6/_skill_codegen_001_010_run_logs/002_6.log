+    def search(
+        depth: int,
+        used: frozenset[tuple[int, int]],
+        chosen: list[tuple[int, frozenset[tuple[int, int]]]],
+    ) -> None:
+        if len(solutions) > 1:
+            return
+        if depth == len(order):
+            if used == border_set:
+                build_solution(chosen)
+            return
