+    assert h_grid >= h + 2 * side_margin_r + 1
+    r0 = random.randint(side_margin_r, h_grid - h - side_margin_r)
+    if side == "left":
+        marker_c = random.randint(1, min(2, w - 2))
+        c0 = marker_c
+    else:
