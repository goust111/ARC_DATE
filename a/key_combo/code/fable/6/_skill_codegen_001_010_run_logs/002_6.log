+    cc0 = max(0, c0 - FRAME_KEEP_OUT)
+    rr1 = min(h_grid, r1 + FRAME_KEEP_OUT + 1)
+    cc1 = min(w_grid, c1 + FRAME_KEEP_OUT + 1)
