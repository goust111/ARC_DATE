+GRID_SIDE_MIN = 12
+GRID_SIDE_MAX = 28
+FRAME_SIDE_MIN = 4
+FRAME_SIDE_MAX = 7
+OBJECT_COUNT_CHOICES = (4, 5, 6)
+PLACEMENT_BORDER = 1
+PLACEMENT_PADDING = 1
+FRAME_KEEP_OUT = 1
+GEN_RETRIES = 400
