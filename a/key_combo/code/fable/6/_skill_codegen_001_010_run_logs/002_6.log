+    assert len(outputs) == 1, "frame assembly must determine a unique output"
+
+    solved = next(iter(outputs.values()))
+    solved["candidate_frames"] = candidate_frames
+    solved["bg"] = bg
+    solved["neutral"] = neutral
+    solved["markers"] = markers
