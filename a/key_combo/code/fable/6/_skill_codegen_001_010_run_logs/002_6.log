+    dedup: dict[tuple[tuple[tuple[int, int], ...], ...], tuple[tuple[tuple[int, int], ...], tuple[str, ...]]] = {}
+    for plan, kinds in raw:
+        key = tuple(sorted(plan))
+        dedup.setdefault(key, (plan, kinds))
+    return tuple(dedup.values())
