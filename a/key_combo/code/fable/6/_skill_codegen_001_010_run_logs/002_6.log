+            arcs, kinds = random.choice(plans)
+            h_grid = random.randint(max(GRID_SIDE_MIN, h + 8), min(GRID_SIDE_MAX, h + 14))
+            w_grid = random.randint(max(GRID_SIDE_MIN, w + 8), min(GRID_SIDE_MAX, w + 14))
