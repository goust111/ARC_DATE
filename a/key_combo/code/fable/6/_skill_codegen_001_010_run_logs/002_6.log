+                kind = _arc_kind(coords)
+                if kind is None:
+                    break
+                arcs.append(tuple(sorted(coords)))
+                kinds.append(kind)
+                pos = (pos + length) % perimeter
+            else:
+                plan = tuple(arcs)
+                raw.append((plan, tuple(kinds)))
