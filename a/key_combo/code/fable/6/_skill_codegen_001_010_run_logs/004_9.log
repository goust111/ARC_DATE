+def _destination(side: str, bbox: tuple[int, int, int, int], grid_shape: tuple[int, int]) -> tuple[int, int]:
+    h = int(bbox[2] - bbox[0] + 1)
+    w = int(bbox[3] - bbox[1] + 1)
