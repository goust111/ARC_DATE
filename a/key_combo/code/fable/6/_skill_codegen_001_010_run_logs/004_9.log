+    if side == "down":
+        return int(H - h), int(bbox[1])
+    if side == "left":
+        return int(bbox[0]), 0
+    assert side == "right"
+    return int(bbox[0]), int(W - w)
+
+
+def _solve(grid: np.ndarray) -> tuple[np.ndarray, list[dict]]:
