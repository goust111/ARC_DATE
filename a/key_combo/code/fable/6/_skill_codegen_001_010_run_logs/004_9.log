+
+def _target_distance(side: str, pos: tuple[int, int], h: int, w: int, H: int, W: int) -> int:
+    top, left = pos
+    bottom_gap = H - h - top
+    right_gap = W - w - left
+    if side == "up":
+        return int(top)
+    if side == "down":
+        return int(bottom_gap)
+    if side == "left":
+        return int(left)
+    return int(right_gap)
