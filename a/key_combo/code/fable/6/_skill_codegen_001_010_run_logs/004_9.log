+
+
+def _make_fragment_patch(spec: dict, bg: int) -> np.ndarray:
+    frag = np.full(spec["fragment_shape"], bg, dtype=int)
+    for r, c in spec["fragment_cells"]:
+        frag[r, c] = int(spec["color"])
+    return frag
