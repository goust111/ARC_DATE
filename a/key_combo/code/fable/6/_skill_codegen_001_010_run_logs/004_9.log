0008: def main(grid: np.ndarray) -> np.ndarray:
0009:     """Repeat the bottom foreground motif upward until it fills the whole grid.
0010: 
0011:     Input structure
0012:     - The background is the dominant color.
0013:     - The only foreground pixels occupy a contiguous block of rows at the bottom.
0014:     - That bottom block is the complete vertical motif, including its background cells.
0015: 
0016:     Rule
0017:     - Copy the bottom motif rows repeatedly upward across the full grid.
0018:     - Preserve horizontal alignment and vertical phase: the original first motif row remains at its input row.
0019:     - The output shape is unchanged.
0020: 
0021:     Key insight
0022:     The blank rows above the bottom foreground block are missing repetitions of the same row motif, not empty space.
0023:     """
0024:     g = np.asarray(grid, dtype=int)
0025:     bg = int(get_bg(g))
