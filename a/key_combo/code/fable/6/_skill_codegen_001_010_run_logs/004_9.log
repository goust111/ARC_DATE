+def _bbox_from_norm(shape: tuple[tuple[int, int], ...]) -> tuple[int, int]:
+    if not shape:
+        return 0, 0
+    rows = [r for r, _ in shape]
+    cols = [c for _, c in shape]
+    return max(rows) + 1, max(cols) + 1
