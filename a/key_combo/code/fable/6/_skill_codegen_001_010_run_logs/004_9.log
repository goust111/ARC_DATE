+
+def _nearest_edge(side: str, pos: tuple[int, int], h: int, w: int, H: int, W: int) -> str:
+    top, left = pos
+    dists = {
+        "up": int(top),
+        "down": int(H - h - top),
+        "left": int(left),
+        "right": int(W - w - left),
+    }
+    return min(DIRS, key=lambda name: (dists[name], DIRS.index(name)))
