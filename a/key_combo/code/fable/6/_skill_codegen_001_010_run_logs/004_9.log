+def _candidate_fragment_locations(
+    canvas: np.ndarray,
+    patch: np.ndarray,
+    receiver_bbox: tuple[int, int, int, int],
+    lure_side: str,
+    bg: int,
+) -> list[tuple[int, int]]:
+    H, W = canvas.shape
+    h, w = patch.shape
+    occ = canvas != bg
+    mask = patch != bg
+    candidates = []
+    for top in range(0, H - h + 1):
