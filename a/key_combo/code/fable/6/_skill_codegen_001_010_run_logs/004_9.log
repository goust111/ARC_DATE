+
+def _solve(grid: np.ndarray) -> tuple[np.ndarray, list[dict]]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    bg, infos = _component_infos(g)
+    pairing = _unique_pairing(infos)
