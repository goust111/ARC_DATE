+    out = np.full_like(g, bg)
+    placements: list[dict] = []
+    for receiver_idx, fragment_idx in pairing:
+        receiver = infos[receiver_idx]
+        fragment = infos[fragment_idx]
+        side = receiver["side"]
+        assert side in DIRS
+        top, left = _destination(side, receiver["bbox"], g.shape)
