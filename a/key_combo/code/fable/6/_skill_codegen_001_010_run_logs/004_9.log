+def _sample_notch(rect_h: int, rect_w: int, side: str, *, require_self_notched: bool) -> tuple[tuple[int, int], ...] | None:
+    if side in {"up", "down"}:
+        shape_h = random.randint(1, min(3, rect_h - 1))
+        shape_w = random.randint(1, rect_w)
+        top = 0 if side == "up" else rect_h - shape_h
+        left = random.randint(0, rect_w - shape_w)
+    else:
+        shape_h = random.randint(1, rect_h)
+        shape_w = random.randint(1, min(3, rect_w - 1))
+        top = random.randint(0, rect_h - shape_h)
+        left = 0 if side == "left" else rect_w - shape_w
+    local = _grow_connected(shape_h, shape_w, side, require_self_notched=require_self_notched)
+    if local is None:
+        return None
+    shifted = tuple(sorted((int(r + top), int(c + left)) for r, c in local))
+    assert len(shifted) < rect_h * rect_w
+    return shifted
