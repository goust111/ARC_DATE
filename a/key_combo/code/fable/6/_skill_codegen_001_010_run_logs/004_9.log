+
+def _grow_connected(shape_h: int, shape_w: int, side: str, *, require_self_notched: bool) -> tuple[tuple[int, int], ...] | None:
+    area_max = shape_h * shape_w
+    min_area = 2 if area_max >= 2 else 1
+    area_choices = list(range(min_area, area_max + 1))
+    random.shuffle(area_choices)
+    side_cells = []
+    for r in range(shape_h):
+        for c in range(shape_w):
+            if side == "up" and r == 0:
+                side_cells.append((r, c))
+            elif side == "down" and r == shape_h - 1:
+                side_cells.append((r, c))
+            elif side == "left" and c == 0:
+                side_cells.append((r, c))
+            elif side == "right" and c == shape_w - 1:
+                side_cells.append((r, c))
+    for area in area_choices:
+        for _ in range(80):
+            cells = {random.choice(side_cells)}
+            while len(cells) < area:
+                frontier = []
+                for r, c in cells:
+                    for nr, nc in neighbors4(r, c):
+                        if 0 <= nr < shape_h and 0 <= nc < shape_w and (nr, nc) not in cells:
+                            frontier.append((int(nr), int(nc)))
+                if not frontier:
+                    break
+                cells.add(random.choice(frontier))
+            if len(cells) != area:
+                continue
+            raw = tuple(sorted((int(r), int(c)) for r, c in cells))
+            norm = _normalize_coords(raw)
+            if require_self_notched:
+                hh, ww = _bbox_from_norm(norm)
+                patch = np.zeros((hh, ww), dtype=int)
+                for r, c in norm:
+                    patch[r, c] = 1
+                side2 = _touch_side(patch == 0)
+                if side2 is None:
+                    continue
+            return raw
+    return None
+
+
+def _sample_notch(rect_h: int, rect_w: int, side: str, *, require_self_notched: bool) -> tuple[tuple[int, int], ...] | None:
+    if side in {"up", "down"}:
+        shape_h = random.randint(1, min(3, rect_h - 1))
+        shape_w = random.randint(1, max(1, rect_w - 1))
+        top = 0 if side == "up" else rect_h - shape_h
+        left_lo = 1 if rect_w - shape_w >= 2 else 0
+        left_hi = rect_w - shape_w - 1 if rect_w - shape_w >= 2 else rect_w - shape_w
+        left = random.randint(left_lo, left_hi)
+    else:
+        shape_h = random.randint(1, max(1, rect_h - 1))
+        shape_w = random.randint(1, min(3, rect_w - 1))
+        top_lo = 1 if rect_h - shape_h >= 2 else 0
+        top_hi = rect_h - shape_h - 1 if rect_h - shape_h >= 2 else rect_h - shape_h
+        top = random.randint(top_lo, top_hi)
+        left = 0 if side == "left" else rect_w - shape_w
+    local = _grow_connected(shape_h, shape_w, side, require_self_notched=require_self_notched)
+    if local is None:
+        return None
+    shifted = tuple(sorted((int(r + top), int(c + left)) for r, c in local))
+    assert len(shifted) < rect_h * rect_w
+    return shifted
+
+
+def _make_receiver_patch(spec: dict, bg: int) -> np.ndarray:
+    patch = np.full((spec["h"], spec["w"]), spec["color"], dtype=int)
+    for r, c in spec["notch"]:
+        patch[r, c] = int(bg)
