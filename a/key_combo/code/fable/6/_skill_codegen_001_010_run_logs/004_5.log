+    start = min(endpoints, key=lambda rc: (rc[0], rc[1]))
+    path: list[Coord] = []
+    prev: Coord | None = None
+    cur = start
+    while True:
+        path.append(cur)
+        next_cells = [
+            nbr
+            for nbr in neighbors4(*cur)
+            if nbr in cells and nbr != prev
