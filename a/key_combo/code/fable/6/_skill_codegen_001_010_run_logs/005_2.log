+
+def reserve_rect(reserved: np.ndarray, r0: int, c0: int, h: int, w: int, pad: int = 0) -> None:
+    hh, ww = reserved.shape
+    rr0 = max(0, r0 - pad)
+    cc0 = max(0, c0 - pad)
+    rr1 = min(hh, r0 + h + pad)
+    cc1 = min(ww, c0 + w + pad)
+    reserved[rr0:rr1, cc0:cc1] = True
