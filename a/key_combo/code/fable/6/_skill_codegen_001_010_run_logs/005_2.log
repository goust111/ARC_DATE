+from __future__ import annotations
+
+from collections import Counter
+import random
+
+import numpy as np
+
+
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIRS8 = [
+    (-1, -1), (-1, 0), (-1, 1),
