+def components_mask(mask: np.ndarray, connectivity: int = 4) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    dirs = DIRS4 if int(connectivity) == 4 else DIRS8
