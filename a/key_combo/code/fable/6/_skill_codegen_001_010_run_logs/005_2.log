+    "down": (-1, 0),
+    "left": (0, 1),
+    "right": (0, -1),
+}
+CANONICAL_BODY = [
+    [(1, 0), (1, -1), (1, 1), (2, 0)],
+    [(1, 0), (2, 0), (2, -1), (2, 1)],
+    [(1, -1), (1, 0), (2, 0), (2, 1), (3, 0)],
