+    success_count = 0
+    miss_count = 0
+    wall_miss_found = False
+    for sprite in scene["sprites"]:
+        spec = specs_by_color.get(int(sprite["marker_color"]))
+        if spec is None:
+            return False
+        if tuple(sprite["ray_dir"]) != tuple(spec["ray_dir"]):
