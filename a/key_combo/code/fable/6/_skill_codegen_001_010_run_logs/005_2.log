+
+
+def candidate_wall_misses(grid: np.ndarray, reserved: np.ndarray, line_reserved: np.ndarray, container: dict, marker_color: int, body_color: int) -> list[dict]:
+    r0, c0, r1, c1 = container["bbox"]
