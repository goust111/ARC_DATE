+                    "marker": marker,
+                    "body_offsets": body_offsets,
+                    "marker_color": marker_color,
+                    "body_color": body_color,
+                    "ray_dir": ray_dir,
+                    "target_bbox": container["bbox"],
+                    "path": trace["path"],
+                }
+            )
