+
+def rect_is_free(reserved: np.ndarray, r0: int, c0: int, h: int, w: int, pad: int = 0) -> bool:
+    hh, ww = reserved.shape
+    if r0 < 0 or c0 < 0 or r0 + h > hh or c0 + w > ww:
+        return False
+    rr0 = max(0, r0 - pad)
+    cc0 = max(0, c0 - pad)
+    rr1 = min(hh, r0 + h + pad)
+    cc1 = min(ww, c0 + w + pad)
+    return not bool(reserved[rr0:rr1, cc0:cc1].any())
