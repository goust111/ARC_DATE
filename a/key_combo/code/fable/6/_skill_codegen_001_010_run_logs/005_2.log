+
+def candidate_successes(grid: np.ndarray, reserved: np.ndarray, line_reserved: np.ndarray, container: dict, ray_dir: tuple[int, int], marker_color: int, body_color: int) -> list[dict]:
+    r0, c0, r1, c1 = container["bbox"]
