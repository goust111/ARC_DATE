+def _touches_all_edges(mask: np.ndarray) -> bool:
+    return (
+        bool(mask[0, :].any())
+        and bool(mask[-1, :].any())
+        and bool(mask[:, 0].any())
+        and bool(mask[:, -1].any())
+    )
