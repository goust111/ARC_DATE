+        if scene["source_side"] == "left":
+            assert np.array_equal(out[:, : axis + 1], g[:, : axis + 1])
+        else:
+            assert np.array_equal(out[:, axis:], g[:, axis:])
+    else:
+        assert bool(np.all(out[axis, :] == sep_color))
+        if scene["source_side"] == "top":
+            assert np.array_equal(out[: axis + 1, :], g[: axis + 1, :])
+        else:
+            assert np.array_equal(out[axis:, :], g[axis:, :])
