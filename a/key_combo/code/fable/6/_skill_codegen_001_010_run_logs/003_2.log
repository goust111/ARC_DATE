+        mask[0, random.randrange(w)] = True
+        mask[h - 1, random.randrange(w)] = True
+        mask[random.randrange(h), 0] = True
+        mask[random.randrange(h), w - 1] = True
+        area = int(mask.sum())
+        if area < min_area or area >= h * w:
+            continue
+        if not _touches_all_edges(mask):
