+
+def _random_boxes(area_h: int, area_w: int, box_h: int, box_w: int, count: int) -> list[tuple[int, int, int, int]] | None:
+    candidates = [(r, c) for r in range(area_h - box_h + 1) for c in range(area_w - box_w + 1)]
+    for _ in range(250):
