+                    assert bool(np.all(coords[:, 1] < axis))
+                else:
+                    assert bool(np.all(coords[:, 1] > axis))
+            else:
+                if source_side == "top":
+                    assert bool(np.all(coords[:, 0] < axis))
+                else:
+                    assert bool(np.all(coords[:, 0] > axis))
+            bbox = _bbox_coords(coords)
+            r0, c0, r1, c1 = bbox
+            mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+            local = coords - np.array([r0, c0], dtype=int)
+            mask[local[:, 0], local[:, 1]] = True
