+    # 1) ignoring the inner blocker must fail;
+    # 2) clipping by rectangles instead of diamonds must fail.
+    if np.array_equal(
+        expected,
+        _paint_wrong_ignore_inner(
+            grid,
+            center_r=center_r,
+            center_c=center_c,
+            outer_radius=outer_radius,
+            markers=markers,
