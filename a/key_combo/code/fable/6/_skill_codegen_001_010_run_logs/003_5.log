+    if np.array_equal(
+        expected,
+        _paint_wrong_rectangles(
+            grid,
+            center_r=center_r,
+            center_c=center_c,
+            inner_radius=inner_radius,
+            outer_radius=outer_radius,
+            markers=markers,
+        ),
