+        inner_radius=inner_radius,
+        outer_radius=outer_radius,
+        markers=markers,
+    )
+    if not np.array_equal(correct_from_specs, expected):
+        return False
+    if any(len(cells) == 0 for cells in painted_by_marker):
+        return False
+
+    union: set[Coord] = set()
+    for cells in painted_by_marker:
