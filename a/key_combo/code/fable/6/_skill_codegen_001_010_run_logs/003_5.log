+
+# --------------- generator ---------------
+
+_RNG = random.Random()
+
+MAX_GENERATION_ATTEMPTS = 400
+OUTER_RADIUS_RANGE = (5, 8)
+GRID_EXTRA_RANGE = (3, 11)
+MARKER_COUNT_RANGE = (4, 7)
