+        center_r=center_r,
+        center_c=center_c,
+        inner_radius=inner_radius,
+        outer_radius=outer_radius,
+        markers=markers,
+    )
+    if not _validate_generated(spec, grid, expected):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
