+    spec: dict[str, object] = {
+        "shape": (height, width),
+        "bg": bg,
+        "center": (center_r, center_c),
+        "outer_radius": outer_radius,
+        "inner_radius": inner_radius,
+        "outer_color": outer_color,
+        "inner_color": inner_color,
+        "markers": markers,
+    }
