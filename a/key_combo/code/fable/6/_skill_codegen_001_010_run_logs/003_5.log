+    marker_count = int(_RNG.randint(*MARKER_COUNT_RANGE))
+    palette = _RNG.sample(list(range(10)), 3 + marker_count)
+    bg = int(palette[0])
+    outer_color = int(palette[1])
+    inner_color = int(palette[2])
+    marker_colors = [int(color) for color in palette[3:]]
