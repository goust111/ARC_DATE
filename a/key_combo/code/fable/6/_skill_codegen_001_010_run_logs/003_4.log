+                "kind": "rim",
+                "side": "right",
+                "row": int(right_seg["row"]) - 1,
+                "dest": int(basin["idx"]) + 1 if int(basin["idx"]) + 1 < len(basins) else None,
+                "cells": [],
+                "barrier": int(basin["right_barrier"]),
