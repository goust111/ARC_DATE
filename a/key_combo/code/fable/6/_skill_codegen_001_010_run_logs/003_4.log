+
+    return {
+        "grid": g,
+        "shape": (int(h), int(w)),
+        "bg": int(bg),
+        "terrain": int(terrain),
+        "cloud_color": int(cloud_color),
+        "cloud_col": int(cloud_col),
+        "surface": surface,
+        "segments": segments,
+        "basins": basins,
+        "source_basin": int(source_basin),
+        "void_components": void_components,
+    }
