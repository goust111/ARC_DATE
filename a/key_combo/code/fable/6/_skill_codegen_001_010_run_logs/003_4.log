+        else:
+            outgoing_type[int(basin_idx)] = rng.choices(
+                ["rim", "breach", "tunnel"],
+                weights=[4, 3, 3],
+                k=1,
+            )[0]
+
+    def barrier_cap(j: int) -> int:
+        if j == 0:
