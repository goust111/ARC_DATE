+    basin_widths = [rng.randint(2, 4) for _ in range(n_basins)]
+    barrier_widths = [rng.randint(1, 3) for _ in range(n_basins + 1)]
+    barrier_tops = [0] * (n_basins + 1)
+    barrier_kind: list[str | None] = [None] * (n_basins + 1)
