+BG_COLOR = 0
+CLOUD_COLOR = 2
+TERRAIN_COLOR = 6
+WATER_COLOR = 8
+
+MAX_ATTEMPTS = 400
+FORCED_BRANCHES = ("rim", "breach", "tunnel")
+_GEN_COUNTER = 0
+
