+            "seg_idx": int(seg_idx),
+            "c0": int(seg["c0"]),
+            "c1": int(seg["c1"]),
+            "floor": int(seg["row"]),
+            "left_barrier": int(seg_idx - 1),
+            "right_barrier": int(seg_idx + 1),
+            "candidates": [],
