+
+    closed_interior = _try_place_closed_room(grid, rng)
+    if closed_interior is None:
+        return None
+
+    extra_components = int(rng.integers(0, 3))
+    for _ in range(extra_components):
+        _try_place_extra_wall(grid, rng)
