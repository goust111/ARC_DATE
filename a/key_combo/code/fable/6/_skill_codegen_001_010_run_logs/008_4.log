+    true_red = out == RED
+    detour_mask = np.zeros_like(grid, dtype=bool)
+    closed_mask = np.zeros_like(grid, dtype=bool)
+    for r, c in detour_interior:
+        detour_mask[r, c] = True
+    for r, c in closed_interior:
