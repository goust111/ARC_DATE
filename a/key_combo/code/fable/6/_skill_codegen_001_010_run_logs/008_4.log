+
+def _draw_room(
+    grid: np.ndarray,
+    r0: int,
+    c0: int,
+    r1: int,
+    c1: int,
+    *,
+    door_side: str | None = None,
+    door_cells: list[tuple[int, int]] | None = None,
+) -> tuple[set[tuple[int, int]], set[tuple[int, int]], set[tuple[int, int]]]:
+    wall = set()
+    for c in range(c0, c1 + 1):
