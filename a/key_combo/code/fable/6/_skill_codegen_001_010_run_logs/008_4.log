+def _rect_is_clear(grid: np.ndarray, r0: int, c0: int, r1: int, c1: int, pad: int = 1) -> bool:
+    rr0 = max(0, r0 - pad)
+    cc0 = max(0, c0 - pad)
+    rr1 = min(grid.shape[0] - 1, r1 + pad)
+    cc1 = min(grid.shape[1] - 1, c1 + pad)
+    return bool(np.all(grid[rr0 : rr1 + 1, cc0 : cc1 + 1] == BLACK))
