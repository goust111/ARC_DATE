N_BLOB_SHAPES = 6
LINE_LENGTH_RANGE = (2, 5)
SMALL_DIM_RANGE = (2, 4)
GROWN_BLOB_MIN_SIZE = 3
PLUS_SHAPE_SIZE = 3

