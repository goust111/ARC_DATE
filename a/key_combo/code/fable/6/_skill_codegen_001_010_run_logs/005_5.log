+                        continue
+                    if grid[nr, nc] == bg and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+                    elif grid[nr, nc] != bg:
+                        boundary_colors.add(int(grid[nr, nc]))
+            if not touches_border and boundary_colors == {int(body_color)}:
+                holes.append(
+                    {
+                        "coords": tuple(comp),
+                        "bbox": _bbox_coords(comp),
+                        "area": len(comp),
+                    }
+                )
