+        if cand is None:
+            continue
+        if any(_complements_to_rectangle(h, cand) for h in hole_shapes):
+            continue
+        decoys.append(cand)
+        break
+
+    return decoys
+
+
+def _semantic_checks(inp: np.ndarray, expected: np.ndarray) -> bool:
