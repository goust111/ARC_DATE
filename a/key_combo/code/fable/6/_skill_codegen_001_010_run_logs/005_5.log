+    for _ in range(PARTITION_ATTEMPTS):
+        h, w = random.choice(size_choices)
+        area = h * w
+        lo = max(4, area // 3)
+        hi = min(area - 4, (2 * area) // 3)
+        if lo > hi:
+            continue
+        target = random.randint(lo, hi)
