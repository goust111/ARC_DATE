+    mask = np.zeros((h, w), dtype=bool)
+    for r, c in norm:
+        mask[r, c] = True
+    return mask
+
+
+def _mask_to_coords(mask: np.ndarray) -> tuple[Coord, ...]:
+    return tuple(sorted((int(r), int(c)) for r, c in np.argwhere(mask)))
+
+
+def _components_mask(mask: np.ndarray) -> list[list[Coord]]:
