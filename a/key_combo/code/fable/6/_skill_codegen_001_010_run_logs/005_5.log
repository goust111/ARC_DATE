+        for r0 in range(1, body_h - h):
+            for c0 in range(1, body_w - w):
+                if _can_place_rect(boxes, r0, c0, h, w, gap=1):
+                    candidates.append((r0, c0))
+        if not candidates:
+            return None
+        pos = random.choice(candidates)
+        placed.append(pos)
+        boxes.append((pos[0], pos[1], pos[0] + h - 1, pos[1] + w - 1))
