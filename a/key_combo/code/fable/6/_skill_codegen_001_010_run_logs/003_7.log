+
+    panels: list[dict] = []
+    marked_panel = None
+    for idx, (c0, c1) in enumerate(bounds):
+        panel = g[:, int(c0) : int(c1)].copy()
+        color = _terrain_color(panel, bg)
+        heights = tuple(_column_height(panel, color, local_c) for local_c in range(panel.shape[1]))
+        panels.append(
