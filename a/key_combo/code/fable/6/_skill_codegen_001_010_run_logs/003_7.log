+    candidates: list[tuple[int, list[int], int]] = []
+    for color, cols in full_cols.items():
+        if len(cols) < 2:
+            continue
+        widths = [cols[0], *[b - a - 1 for a, b in zip(cols, cols[1:])], w - cols[-1] - 1]
