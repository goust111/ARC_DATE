53:def main(grid: np.ndarray) -> np.ndarray:
54:    """
55:    Recolor the shortest path between two terminal squares in a square-and-track graph.
57:    Input structure:
58:    - bg = most common color.
59:    - Two non-bg colors form solid NxN squares (N>=2): one color marks exactly 2 terminals, the other marks stations.
60:    - A third non-bg color forms 1-cell-wide track segments connecting pairs of squares (graph edges).
62:    Rule:
63:    - Find the shortest path (fewest edges) between the two terminal squares.
64:    - Recolor every station square on that path to green.
65:    - Recolor every track segment along that path to grey.
66:    - Everything else unchanged.
68:    Key insight: The grid encodes a graph where squares are nodes and tracks are edges; the task is graph shortest-path, not spatial proximity.
69:    """
70:    g = np.array(grid, dtype=int)
71:    bg = int(get_bg(g))
73:    # --- detect solid squares (nodes) and infer the dominant size N ---
74:    square_cands = find_solid_squares(g, bg=bg, min_size=2, connectivity=8)
75:    assert not (not square_cands)
77:    size_counts = Counter([int(d["size"]) for d in square_cands])
78:    N = int(max(size_counts.items(), key=lambda kv: (int(kv[1]), int(kv[0])))[0])
79:    nodes_raw = [d for d in square_cands if int(d["size"]) == int(N)]
81:    nodes: list[dict] = []
82:    for i, d in enumerate(nodes_raw):
83:        pts = {(int(r), int(c)) for r, c in d["coords"]}
84:        nodes.append({"id": int(i), "color": int(d["color"]), "pts": pts})
86:    nodes_by_color: dict[int, list[int]] = defaultdict(list)
87:    for nd in nodes:
88:        nodes_by_color[int(nd["color"])].append(int(nd["id"]))
90:    node_colors = sorted(nodes_by_color.keys())
91:    assert not (len(node_colors) < 2)
93:    terminal_color = None
94:    station_color = None
95:    for col in node_colors:
96:        if len(nodes_by_color[int(col)]) == 2:
97:            terminal_color = int(col)
98:        else:
99:            station_color = int(col)
100:    assert not (terminal_color is None or station_color is None)
101:    term_ids = list(map(int, nodes_by_color[int(terminal_color)]))
103:    # Track color is the remaining non-bg color (not a node color).
104:    non_bg_colors = colors_present(g, exclude={bg})
105:    track_candidates = [c for c in non_bg_colors if int(c) not in (int(terminal_color), int(station_color))]
106:    assert not (not track_candidates)
107:    track_color = int(max(track_candidates, key=lambda c: int((g == int(c)).sum())))
109:    # --- build node lookup ---
110:    pix2node: dict[tuple[int, int], int] = {}
111:    id2pts: dict[int, set[tuple[int, int]]] = {}
112:    for nd in nodes:
113:        nid = int(nd["id"])
114:        pts = set(nd["pts"])
115:        id2pts[nid] = pts
116:        for p in pts:
117:            pix2node[p] = nid
119:    # --- build edges from track components that touch exactly 2 nodes (8-adjacency) ---
120:    track_comps = components_mask(g == int(track_color), connectivity=8)
121:    track_comp_pts: dict[int, list[tuple[int, int]]] = {}
122:    adj: dict[int, list[tuple[int, int]]] = defaultdict(list)  # node -> [(neighbor, edge_id)]
124:    for edge_id, coords in enumerate(track_comps, start=1):
125:        pts = [(int(r), int(c)) for r, c in coords]
126:        if not pts:
127:            continue
128:        touched: set[int] = set()
129:        for r, c in pts:
130:            for rr, cc in neighbors8(int(r), int(c)):
131:                nid = pix2node.get((int(rr), int(cc)))
132:                if nid is not None:
