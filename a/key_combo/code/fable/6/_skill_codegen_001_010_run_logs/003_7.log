+BG = 0
+MAX_GENERATION_ATTEMPTS = 500
+PANEL_COUNT_RANGE = (3, 5)
+GRID_HEIGHT_RANGE = (8, 14)
+PANEL_WIDTH_RANGE = (3, 5)
+SEPARATOR_WIDTH = 1
+PALETTE = tuple(range(1, 10))
