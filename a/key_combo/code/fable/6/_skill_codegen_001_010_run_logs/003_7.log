+    for sep_c in separator_cols:
+        out[:, int(sep_c)] = int(sep_color)
+    for slot_idx, panel_idx in enumerate(order):
+        c0, c1 = bounds[slot_idx]
+        out[:, int(c0) : int(c1)] = panels[int(panel_idx)]["grid"]
