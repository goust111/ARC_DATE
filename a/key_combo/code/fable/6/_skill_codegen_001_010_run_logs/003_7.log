+def _terrain_color(panel: np.ndarray, bg: int) -> int:
+    vals = panel[panel != int(bg)]
+    assert vals.size > 0, "panel must contain foreground pixels"
+    return int(Counter(map(int, vals.reshape(-1))).most_common(1)[0][0])
