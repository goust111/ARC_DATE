+                "index": int(idx),
+                "grid": panel,
+                "color": int(color),
+                "heights": heights,
+                "left": int(heights[0]),
+                "right": int(heights[-1]),
+                "peak": int(max(heights)),
+                "area": int(sum(heights)),
