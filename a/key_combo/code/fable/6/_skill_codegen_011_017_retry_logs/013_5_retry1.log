+    for color in map(int, np.unique(grid)):
+        for coords in components_mask(grid == color, connectivity=4):
+            bbox = bbox_coords(coords)
+            h = bbox_h(bbox)
+            w = bbox_w(bbox)
+            area = int(coords.shape[0])
+            if h > 1 and w > 1 and area == h * w:
+                rects.append((area, color, bbox))
