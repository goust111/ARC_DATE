+def _parse_task(grid: np.ndarray) -> tuple[np.ndarray, list[tuple[tuple[tuple[int, int], ...], tuple[tuple[int, int], ...], tuple[int, int]]]]:
+    g = np.asarray(grid, dtype=int)
