+        _render_shape(grid, src, top, cur_c, RULE)
+        cur_c += w + 1
+        _render_shape(grid, dst, top, cur_c, RULE)
+        cur_c += w
+        if idx != len(rule_pairs) - 1:
+            cur_c += between_gap
