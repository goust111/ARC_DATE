+    occupied = np.zeros(scene.shape, dtype=bool)
+    scene_meta = []
+    for shape, is_source in scene_specs:
+        dims = (max(r for r, _ in shape) + 1, max(c for _, c in shape) + 1)
+        for _ in range(120):
