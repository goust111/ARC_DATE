+    out = np.asarray(grid, dtype=int).copy()
+    empty = out == BG
+    out[empty & red_reach & ~blue_reach] = RED
+    out[empty & blue_reach & ~red_reach] = BLUE
+    out[empty & red_reach & blue_reach] = YELLOW
+    return out, red_reach, blue_reach
