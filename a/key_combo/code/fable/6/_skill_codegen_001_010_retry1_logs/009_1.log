+def _flood_reach(grid: np.ndarray, start: tuple[int, int], source: str, mode: str) -> np.ndarray:
+    h, w = grid.shape
+    reach = np.zeros((h, w), dtype=bool)
+    q: deque[tuple[int, int]] = deque([start])
+    reach[start] = True
+    while q:
