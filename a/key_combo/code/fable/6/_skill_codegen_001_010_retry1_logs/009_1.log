+        slab = (door_r - 2, c1 + 1, door_r + 2, ac0 - 1)
+        carve = [(door_r, c) for c in range(c1 - 1, c1 + 1)]
+        interior = (r0 + 2, c0 + 2, r1 - 2, c1 - 2)
+    elif side == "right":
