    out=sim(g)
    print('basin water', ((out==1)[basin[0]:basin[1]+1, basin[2]:basin[3]+1]).sum())
    print('shaft water', ((out==1)[shaft[0]:shaft[1]+1, shaft[2]:shaft[2]+1]).sum())
    for row in out:
        print(''.join(str(x) for x in row))
    print()
