def settle(g,r,c):
    H,W=g.shape; start_c=c
    def look(sr,sc,depth):
        rr,cc=sr,sc
        for _ in range(H*W*4):
            if rr+1 < H and g[rr+1,cc]==0:
                rr += 1; continue
            diag=[]
            if rr+1<H and cc-1>=0 and g[rr,cc-1]==0 and g[rr+1,cc-1]==0: diag.append((rr+1,cc-1))
            if rr+1<H and cc+1<W and g[rr,cc+1]==0 and g[rr+1,cc+1]==0: diag.append((rr+1,cc+1))
            if diag:
                if len(diag)==1 or depth<=0:
                    rr,cc=sorted(diag,key=lambda x:(abs(x[1]-cc),abs(x[1]-start_c),x[1]))[0]; continue
                scored=[]
                for nr,nc in diag:
                    tr,tc=look(nr,nc,depth-1)
                    scored.append(((-tr, abs(nc-cc), abs(nc-start_c), nc),(nr,nc)))
                rr,cc=min(scored)[1]; continue
            if rr+1<H and g[rr+1,cc]"'!=0:
                L=cc
                while L-1>=0 and g[rr,L-1]==0: L-=1
                R=cc
