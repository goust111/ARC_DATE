import numpy as np
from collections import deque

def settle(g, start):
    H,W=g.shape
    sr,sc=start
    q=deque([(sr,sc)])
    dist={(sr,sc):0}
    mins=[]
    while q:
        r,c=q.popleft(); d=dist[(r,c)]
        if r+1 < H and g[r+1,c]==0:
            nxt=(r+1,c)
            if nxt not in dist:
                dist[nxt]=d+1; q.append(nxt)
            continue
        moved=False
        for nc in (c-1,c+1):
            if 0<=nc<W and g[r,nc]==0:
                nxt=(r,nc)
                if nxt not in dist:
                    dist[nxt]=d+1; q.append(nxt)
                moved=True
        if not moved:
            mins.append((r,c,d))
    if not mins: return start
    mins.sort(key=lambda t:(-t[0], t[2], abs(t[1]-sc), t[1]))
