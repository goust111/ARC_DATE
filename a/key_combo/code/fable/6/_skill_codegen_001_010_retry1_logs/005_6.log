# deterministic settle similar to planned main

def settle(g,r,c):
    H,W=g.shape
    start_c=c
    def look(sr,sc,depth):
        rr,cc=sr,sc
        for _ in range(H*W*4):
            if rr+1 < H and g[rr+1,cc]==0:
                rr += 1; continue
            diag=[]
            if rr+1<H and cc-1>=0 and g[rr,cc-1]==0 and g[rr+1,cc-1]==0:
                diag.append((rr+1,cc-1))
            if rr+1<H and cc+1<W and g[rr,cc+1]==0 and g[rr+1,cc+1]==0:
                diag.append((rr+1,cc+1))
            if diag:
                if len(diag)==1 or depth<=0:
                    if len(diag)==1:
                        rr,cc=diag[0]; continue
                    diag = sorted(diag, key=lambda x:(abs(x[1]-cc), abs(x[1]-start_c), x[1]))
                    rr,cc=diag[0]; continue
                scored=[]
                for nr,nc in diag:
                    tr,tc = look(nr,nc,depth-1)
                    scored.append(((-tr, abs(nc-cc), abs(nc-start_c), nc), (nr,nc)))
                rr,cc=min(scored)[1]; continue
            if rr+1<H and g[rr+1,cc]"'!=0:
                L=cc
                while L-1>=0 and g[rr,L-1]==0: L-=1
                R=cc
                while R+1<W and g[rr,R+1]==0: R+=1
                drops=[x for x in range(L,R+1) if rr+1<H and g[rr+1,x]==0]
                if not drops: break
                scored=[]
                for x in drops:
                    if depth<=0:
                        tr,tc=rr,x
                    else:
                        tr,tc=look(rr,x,depth-1)
                    scored.append(((-tr, abs(x-cc), abs(x-start_c), x), x))
                bestx=min(scored)[1]
                if bestx==cc:
                    break
                cc += -1 if bestx<cc else 1
                continue
            break
        return rr,cc
    return look(r,c,2)

def sim(grid):
    g=np.array(grid,dtype=int)
    pts=sorted([(int(r),int(c)) for r,c in np.argwhere(g==1)], reverse=True)
    g=g.copy()
    g[g==1]=0
    for r,c in pts:
        rr,cc=settle(g,r,c)
        g[rr,cc]=1
    return g

def build(leaky=False, H=18, W=22, left=3, top=6, depth=5, width=5, source_n=12):
    g=np.zeros((H,W),int)
    col=2
    # main basin
    b=top+depth
    right=left+width+1
    g[b, left:right+1]=col
    g[top:b+1, left]=col
    # spill/leak wall on right
    if leaky:
        seam = top + depth//2
        g[top:seam, right]=col
        g[seam+1:b+1, right-1]=col
        # close exterior guide roof one row above lower segment to look near-closed
        # opposite high wall slightly above seam
    else:
        g[top:b+1, right]=col
    # catch shaft to right of main basin
    shaft_c = right + 4
    shaft_top = top + 2
    g[shaft_top:H, shaft_c]=col
    g[shaft_top:H, shaft_c+2]=col
    g[H-1, shaft_c:shaft_c+3]=col
    # full floor
    g[H-1,:]=col
    # water source above left-inside side
    src_c = left + 1
    for r in range(source_n):
        if r < top-1:
            g[r, src_c]=1
    return g, (top+1,b-1,left+1,right-1), (shaft_top, H-2, shaft_c+1)

for leaky in [False, True]:
    print('"'LEAKY',leaky)
