+def _semantic_checks(inp: np.ndarray, meta: Dict[str, int]) -> bool:
+    top = int(meta["top"])
+    floor = int(meta["floor"])
+    left_x = int(meta["left_x"])
+    right_x = int(meta["right_x"])
