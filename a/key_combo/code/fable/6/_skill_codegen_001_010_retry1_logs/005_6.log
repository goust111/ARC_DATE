+        key = (int(r), int(c), int(depth))
+        if key in memo:
+            return memo[key]
+
+        rr, cc = int(r), int(c)
+        for _ in range(H * W * 4):
+            if rr + 1 < H and int(g[rr + 1, cc]) == 0:
+                rr += 1
+                continue
+
