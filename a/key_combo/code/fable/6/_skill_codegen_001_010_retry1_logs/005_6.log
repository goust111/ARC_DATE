+from __future__ import annotations
+
+import random
+from typing import Dict, Tuple
+
+import numpy as np
+
+
+Coord = Tuple[int, int]
+
+
+def _settle_particle(grid: np.ndarray, start: Coord, lookahead: int = 2) -> Coord:
