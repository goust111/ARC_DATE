+    g[top : floor + 1, right_x] = color
+    g[top + 3 : floor + 1, right_x + 5] = color
+    g[floor, right_x : right_x + 6] = color
+    for r in range(spill_n):
+        g[r, right_x + 1] = 1
+
+    meta = {
+        "H": H,
+        "W": W,
+        "top": top,
+        "floor": floor,
+        "left_x": left_x,
+        "right_x": right_x,
+        "leak_n": leak_n,
+        "spill_n": spill_n,
+        "color": color,
+    }
+    return g, meta
