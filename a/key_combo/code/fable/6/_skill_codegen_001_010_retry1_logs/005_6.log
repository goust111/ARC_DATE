                drops=[x for x in range(L,R+1) if g[rr+1,x]==0]
                if not drops: break
                scored=[]
                for x in drops:
                    tr,tc=(rr,x) if depth<=0 else look(rr,x,depth-1)
                    scored.append(((-tr, abs(x-cc), abs(x-start_c), x),x))
                best=min(scored)[1]
                if best==cc: break
                cc += -1 if best<cc else 1
                continue
            break
        return rr,cc
    return look(r,c,2)

def sim(grid):
    g=np.array(grid,dtype=int).copy(); pts=sorted([(int(r),int(c)) for r,c in np.argwhere(g==1)], reverse=True); g[g==1]=0
    for r,c in pts:
        rr,cc=settle(g,r,c); g[rr,cc]=1
    return g

