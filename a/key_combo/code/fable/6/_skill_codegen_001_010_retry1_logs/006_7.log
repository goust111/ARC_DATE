+    g = scene["grid"]
+    bg = int(scene["bg"])
+    fg = int(scene["fg"])
+    boxes = scene["boxes"]
+    tiles = scene["tiles"]
+    neg_idx = int(scene["negative_index"])
+    hole_mask = np.asarray(scene["hole_mask"], dtype=bool)
