+    if len(lines) < 3 or int(lines[0]) != 0 or int(lines[-1]) != int(limit - 1):
+        return None
+    diffs = np.diff(lines)
+    if np.any(diffs < 2):
+        return None
+    if len(set(map(int, diffs))) != 1:
+        return None
