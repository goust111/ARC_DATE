from __future__ import annotations

from collections import defaultdict

import numpy as np

from arc_utils import find_components, get_bg, paste
import random


def main(grid: np.ndarray) -> np.ndarray:
    """
    Move the repeated boundary color's rectangles one block inward while leaving singleton boundary rectangles in place.

    Input structure:
    - The background is the most common color.
    - Foreground objects are solid monochrome rectangles touching a grid corner.
    - Exactly one foreground color appears as multiple separate 4-connected objects; other colors appear once.

    Rule:
    - Clear the multiple objects of the repeated color from their original positions.
    - For each cleared rectangle, translate it away from the row and column border it touches by exactly its height and width.
    - Keep singleton-color objects unchanged; overlapping translated rectangles of the same color merge.

    Key insight:
    - Multiplicity selects the moving color, and each boundary rectangle's touched edges determine its inward diagonal translation.
    """
    g = np.asarray(grid, dtype=int)
    H, W = g.shape
    bg = int(get_bg(g))

    by_color: dict[int, list[dict]] = defaultdict(list)
    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict"):
        by_color[int(comp["color"])].append(comp)

    moving_colors = [color for color, comps in by_color.items() if len(comps) > 1]
    assert len(moving_colors) == 1
    moving_color = int(moving_colors[0])
    moving_objects = by_color[moving_color]

    out = g.copy()
    for comp in moving_objects:
        coords = comp["coords"]
        out[coords[:, 0], coords[:, 1]] = bg

    for comp in moving_objects:
        coords = comp["coords"]
        r0, c0, r1, c1 = map(int, comp["bbox"])
        height = int(r1 - r0 + 1)
        width = int(c1 - c0 + 1)
        assert int(comp["area"]) == height * width

        touches_top = r0 == 0
        touches_bottom = r1 == H - 1
        touches_left = c0 == 0
        touches_right = c1 == W - 1
        assert touches_top != touches_bottom
        assert touches_left != touches_right

        dr = height if touches_top else -height
        dc = width if touches_left else -width
        shifted = coords + np.array([dr, dc], dtype=int)
        assert bool(
            np.all(
                (0 <= shifted[:, 0])
                & (shifted[:, 0] < H)
                & (0 <= shifted[:, 1])
                & (shifted[:, 1] < W)
            )
        )

        target = out[shifted[:, 0], shifted[:, 1]]
        assert bool(np.all((target == bg) | (target == moving_color)))
        out[shifted[:, 0], shifted[:, 1]] = moving_color

    return out

# --------------- generator (o5x) ---------------

# Corner and movement model.
CORNERS = ("TL", "TR", "BL", "BR")
DIAGONAL_PAIRS = ({"TL", "BR"}, {"TR", "BL"})
INWARD_STEP_FACTOR = 2
COMPACT_CANVAS_FACTOR = 3

# Canvas, object count, and retry bounds.
GRID_ROW_BOUNDS = (7, 22)
GRID_COL_BOUNDS = (7, 30)
SQUARE_SIZE_BOUNDS = (1, 4)
MOVING_COUNT_BOUNDS = (2, 4)
GENERATION_RETRIES = 300

# Color palette.
COLOR_VALUES = tuple(range(10))

def _corner_pos(corner: str, H: int, W: int, s: int) -> tuple[int, int]:
    row = 0 if corner[0] == "T" else H - s
    col = 0 if corner[1] == "L" else W - s
    return row, col


def _shifted_pos(corner: str, H: int, W: int, s: int) -> tuple[int, int]:
    row = s if corner[0] == "T" else H - INWARD_STEP_FACTOR * s
    col = s if corner[1] == "L" else W - INWARD_STEP_FACTOR * s
    return row, col


def _valid_sizes(s: int, moving_count: int) -> list[tuple[int, int]]:
    sizes = []
    min_h = max(GRID_ROW_BOUNDS[0], INWARD_STEP_FACTOR * s + 1)
    min_w = max(GRID_COL_BOUNDS[0], INWARD_STEP_FACTOR * s + 1)
    for H in range(min_h, GRID_ROW_BOUNDS[1] + 1):
        for W in range(min_w, GRID_COL_BOUNDS[1] + 1):
            bg_area = H * W - len(CORNERS) * s * s
            if bg_area <= moving_count * s * s:
                continue
            compact = H < COMPACT_CANVAS_FACTOR * s and W < COMPACT_CANVAS_FACTOR * s
            if moving_count == MOVING_COUNT_BOUNDS[1] - 1 and compact:
                continue
            sizes.append((H, W))
    return sizes


def _pick_moving_corners(H: int, W: int, s: int, moving_count: int) -> set[str]:
    if moving_count == len(CORNERS):
        return set(CORNERS)
    compact = H < COMPACT_CANVAS_FACTOR * s and W < COMPACT_CANVAS_FACTOR * s
    if moving_count == MOVING_COUNT_BOUNDS[0] and compact:
        return set(random.choice(DIAGONAL_PAIRS))
    return set(random.sample(CORNERS, moving_count))


def _overlaps(a: tuple[int, int], b: tuple[int, int], s: int) -> bool:
    ar, ac = a
    br, bc = b
    return ar < br + s and br < ar + s and ac < bc + s and bc < ac + s


def _sample_layout():
    """Return a collision-free layout tuple, or None when the sampled size cannot work."""
    s = random.randint(*SQUARE_SIZE_BOUNDS)
    moving_count = random.randint(*MOVING_COUNT_BOUNDS)
    sizes = _valid_sizes(s, moving_count)
    if not sizes:
        return None
    H, W = random.choice(sizes)

    moving = _pick_moving_corners(H, W, s, moving_count)
    singletons = [corner for corner in CORNERS if corner not in moving]

    shifted = {corner: _shifted_pos(corner, H, W, s) for corner in moving}
    singleton_pos = {corner: _corner_pos(corner, H, W, s) for corner in singletons}
    for moved_pos in shifted.values():
        for kept_pos in singleton_pos.values():
            if _overlaps(moved_pos, kept_pos, s):
                return None
    return H, W, s, moving, singletons, shifted, singleton_pos


def _sample_colors(singleton_count: int) -> tuple[int, int, list[int]]:
    colors = list(COLOR_VALUES)
    bg = random.choice(colors)
    colors.remove(bg)
    moving_color = random.choice(colors)
    colors.remove(moving_color)
    singleton_colors = random.sample(colors, singleton_count)
    return bg, moving_color, singleton_colors


def _render_pair(H, W, s, bg, moving_color, moving, singletons, shifted, singleton_pos, singleton_colors):
    """Render the matching input/output grids for an accepted layout and palette."""
    rect = np.full((s, s), moving_color, dtype=int)
    out = np.full((H, W), bg, dtype=int)
    for corner in moving:
        paste(out, rect, *shifted[corner])
    for corner, color in zip(singletons, singleton_colors):
        patch = np.full((s, s), color, dtype=int)
        paste(out, patch, *singleton_pos[corner])

    inp = out.copy()
    for corner in moving:
        r, c = shifted[corner]
        inp[r : r + s, c : c + s] = bg
    for corner in moving:
        paste(inp, rect, *_corner_pos(corner, H, W, s))
    return inp, out


def _gen_attempt() -> np.ndarray | None:
    layout = _sample_layout()
    if layout is None:
        return None
    H, W, s, moving, singletons, shifted, singleton_pos = layout
    bg, moving_color, singleton_colors = _sample_colors(len(singletons))
    inp, out = _render_pair(H, W, s, bg, moving_color, moving, singletons, shifted, singleton_pos, singleton_colors)
    try:
        return inp if np.array_equal(main(inp), out) else None
    except AssertionError:
        return None


def generate_input() -> np.ndarray:
    for _ in range(GENERATION_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid 22208ba4 input")
from __future__ import annotations

import numpy as np

from arc_utils import bbox_h, bbox_w, find_components, get_bg
import random


def _is_solid_rect(g: np.ndarray, comp: dict) -> bool:
    r0, c0, r1, c1 = comp["bbox"]
    area = int((r1 - r0 + 1) * (c1 - c0 + 1))
    return int(comp["area"]) == area and bool(np.all(g[r0 : r1 + 1, c0 : c1 + 1] == int(comp["color"])))


def _find_structure(g: np.ndarray, bg: int) -> tuple[dict, dict, list[dict], list[dict]]:
    comps = find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict")
    rects = [comp for comp in comps if _is_solid_rect(g, comp)]

    candidates: list[tuple[dict, dict, list[dict], list[dict]]] = []
    for color in {int(comp["color"]) for comp in rects}:
        same_color = [comp for comp in rects if int(comp["color"]) == color]
        for i, a in enumerate(same_color):
            for b in same_color[i + 1 :]:
                if bbox_h(a["bbox"]) != bbox_h(b["bbox"]) or bbox_w(a["bbox"]) != bbox_w(b["bbox"]):
                    continue

                ar0, ac0, _ar1, _ac1 = a["bbox"]
                br0, bc0, _br1, _bc1 = b["bbox"]
                if ar0 < br0 and ac0 < bc0:
                    source, dest = a, b
                elif br0 < ar0 and bc0 < ac0:
                    source, dest = b, a
                else:
                    continue

                sr0, sc0, sr1, sc1 = source["bbox"]
                dr0, dc0, _dr1, _dc1 = dest["bbox"]
                right = [
                    comp
                    for comp in rects
                    if int(comp["color"]) != color
                    and comp["bbox"][0] == sr0
                    and comp["bbox"][2] == sr1
                    and comp["bbox"][1] == comp["bbox"][3]
                    and sc1 < comp["bbox"][1] < dc0
                ]
                below = [
                    comp
                    for comp in rects
                    if int(comp["color"]) != color
                    and comp["bbox"][1] == sc0
                    and comp["bbox"][3] == sc1
                    and comp["bbox"][0] == comp["bbox"][2]
                    and sr1 < comp["bbox"][0] < dr0
                ]

                right_with_offsets = sorted(
                    ((int(comp["bbox"][1] - sc1), comp) for comp in right),
                    key=lambda item: item[0],
                )
                below_with_offsets = sorted(
                    ((int(comp["bbox"][0] - sr1), comp) for comp in below),
                    key=lambda item: item[0],
                )
                if len(right_with_offsets) == 2 and len(below_with_offsets) == 2:
                    right_offsets = [offset for offset, _comp in right_with_offsets]
                    below_offsets = [offset for offset, _comp in below_with_offsets]
                    if right_offsets == below_offsets and right_offsets[0] == 1:
                        candidates.append(
                            (
                                source,
                                dest,
                                [comp for _offset, comp in right_with_offsets],
                                [comp for _offset, comp in below_with_offsets],
                            )
                        )

    assert len(candidates) == 1, "expected one anchor pair with matching right and below controls"
    return candidates[0]


def _paint(out: np.ndarray, bg: int, r: int, c: int, color: int) -> None:
    assert int(out[r, c]) in {int(bg), int(color)}, "paint target must be empty or already matching"
    out[r, c] = int(color)


def _paint_rect(out: np.ndarray, bg: int, r0: int, c0: int, r1: int, c1: int, color: int) -> None:
    for r in range(int(r0), int(r1) + 1):
        for c in range(int(c0), int(c1) + 1):
            _paint(out, bg, r, c, color)


def main(grid: np.ndarray) -> np.ndarray:
    """
    Complete a four-corner framed rectangle from one decorated anchor rectangle and its diagonal mate.

    Input structure:
    - The background is the dominant color.
    - Two same-color solid rectangular anchors of the same size sit on opposite
      diagonal corners, with the first anchor above-left of the second.
    - The upper-left anchor has two one-cell-thick vertical control bars to its
      right and two one-cell-thick horizontal control bars below it.

    Rule:
    - Copy the anchor rectangle into the two missing corners of the implied
      larger rectangle.
    - Repeat the right-side control bars horizontally between the left and right
      anchors, using their spacing as the period, and draw the outer top and
      bottom borders in the first right-control color.
    - Repeat the below-side control bars vertically between the top and bottom
      anchors, using the same period, and draw the outer left and right borders
      in the first below-control color.

    Key insight: The small control bars are the first two ticks of two periodic
    frame patterns; the diagonal anchor supplies the opposite corner and the
    missing two anchor copies.
    """
    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)
    source, dest, right_controls, below_controls = _find_structure(g, bg)

    sr0, sc0, sr1, sc1 = source["bbox"]
    dr0, dc0, dr1, dc1 = dest["bbox"]
    anchor_color = int(source["color"])
    assert int(dest["color"]) == anchor_color, "anchor colors must match"
    assert bbox_h(source["bbox"]) == bbox_h(dest["bbox"]), "anchor heights must match"
    assert bbox_w(source["bbox"]) == bbox_w(dest["bbox"]), "anchor widths must match"
    assert sr0 > 0 and sc0 > 0, "upper-left anchor must have space for outer frame"
    assert dr1 + 1 < g.shape[0] and dc1 + 1 < g.shape[1], "lower-right anchor must have space for outer frame"

    right_offsets = [int(comp["bbox"][1] - sc1) for comp in right_controls]
    below_offsets = [int(comp["bbox"][0] - sr1) for comp in below_controls]
    assert right_offsets == below_offsets and right_offsets[0] == 1, "control offsets must match from the anchor edge"
    step = int(right_offsets[1] - right_offsets[0])
    assert step > 0, "control bars must be separated"
    period = 2 * step
    assert (dc0 - 1 - sc1 - right_offsets[0]) % period == 0, "right frame must close next to the destination anchor"
    assert (dr0 - 1 - sr1 - below_offsets[0]) % period == 0, "below frame must close next to the destination anchor"

    right_colors = [int(comp["color"]) for comp in right_controls]
    below_colors = [int(comp["color"]) for comp in below_controls]
    out = g.copy()

    _paint_rect(out, bg, sr0, dc0, sr1, dc1, anchor_color)
    _paint_rect(out, bg, dr0, sc0, dr1, sc1, anchor_color)

    first_c = int(sc1 + right_offsets[0])
    last_c = int(dc0 - 1)
    for c in range(first_c, last_c + 1):
        offset = int(c - sc1)
        if (offset - right_offsets[0]) % period == 0:
            color = right_colors[0]
        elif (offset - right_offsets[1]) % period == 0:
            color = right_colors[1]
        else:
            continue
        _paint_rect(out, bg, sr0, c, sr1, c, color)
        _paint_rect(out, bg, dr0, c, dr1, c, color)

    _paint_rect(out, bg, sr0 - 1, first_c, sr0 - 1, last_c, right_colors[0])
    _paint_rect(out, bg, dr1 + 1, first_c, dr1 + 1, last_c, right_colors[0])

    first_r = int(sr1 + below_offsets[0])
    last_r = int(dr0 - 1)
    left_c = int(sc0 - 1)
    right_c = int(dc1 + 1)
    for r in range(first_r, last_r + 1):
        _paint(out, bg, r, left_c, below_colors[0])
        _paint(out, bg, r, right_c, below_colors[0])

        offset = int(r - sr1)
        if (offset - below_offsets[0]) % period == 0:
            _paint_rect(out, bg, r, left_c, r, sc1, below_colors[0])
            _paint_rect(out, bg, r, dc0, r, right_c, below_colors[0])
        elif (offset - below_offsets[1]) % period == 0:
            _paint_rect(out, bg, r, sc0, r, sc1, below_colors[1])
            _paint_rect(out, bg, r, dc0, r, dc1, below_colors[1])

    return out

