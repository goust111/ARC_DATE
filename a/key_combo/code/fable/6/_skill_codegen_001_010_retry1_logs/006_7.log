+
+
+def _embed_sprite(tile_shape: tuple[int, int], sprite: np.ndarray, top: int, left: int) -> np.ndarray:
+    tile = np.zeros(tile_shape, dtype=bool)
+    h, w = sprite.shape
+    tile[int(top) : int(top) + h, int(left) : int(left) + w] = sprite
