+    if not cells:
+        return []
+    if bbox is not None:
+        r0, c0, r1, c1 = bbox
+        use_shape = (r1 - r0 + 1, c1 - c0 + 1)
+        local_map = {cell: (cell[0] - r0, cell[1] - c0) for cell in cells}
+    else:
+        assert shape is not None
+        use_shape = shape
+        local_map = {cell: cell for cell in cells}
