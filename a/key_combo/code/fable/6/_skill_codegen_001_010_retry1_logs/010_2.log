+    h, w = patch.shape
+    sr, sc = spike
+    if direction == "U":
+        return patch.copy(), (sr, sc), list(cells)
+    if direction == "D":
+        return np.flipud(patch).copy(), (h - 1 - sr, sc), [(h - 1 - r, c) for (r, c) in cells]
