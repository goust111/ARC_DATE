+def _validate_generated_case(inp: np.ndarray, expected: np.ndarray, cup_count: int) -> bool:
+    try:
+        got = main(inp)
+    except Exception:
+        return False
+    if not np.array_equal(got, expected):
+        return False
+    cups = _extract_cups(inp)
+    if len(cups) != cup_count:
