+                    "stack_slots": _fill_order(interior, direction, from_mouth=False, bbox=bbox),
+                    "content_slots": _fill_order(interior, direction, from_mouth=True, bbox=bbox),
+                    "content_color": content_color,
+                    "content_cells": content_cells,
