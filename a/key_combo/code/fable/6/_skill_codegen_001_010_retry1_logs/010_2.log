+        use_shape = shape
+        local_map = {cell: cell for cell in cells}
+
+    def key(cell: tuple[int, int]) -> tuple[int, int]:
+        rr, cc = _canonical_coord(local_map[cell], use_shape, direction)
+        return (cc, rr) if from_mouth else (-cc, rr)
+
