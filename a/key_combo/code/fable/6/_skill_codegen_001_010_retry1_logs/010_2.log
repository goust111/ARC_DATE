+
+
+def _rotate_to_direction(
+    patch: np.ndarray,
+    spike: tuple[int, int],
+    cells: list[tuple[int, int]],
+    direction: str,
+) -> tuple[np.ndarray, tuple[int, int], list[tuple[int, int]]]:
+    h, w = patch.shape
+    sr, sc = spike
+    if direction == "U":
+        return patch.copy(), (sr, sc), list(cells)
+    if direction == "D":
+        return np.flipud(patch).copy(), (h - 1 - sr, sc), [(h - 1 - r, c) for (r, c) in cells]
