+ARM_LEN_RANGE = (1, 2)
+WALL_EXT_RANGE = (0, 2)
+CHAIN_LEN_CHOICES = (2, 3)
+GAP_RANGE = (2, 4)
+MAX_CONTENT = 4
+GEN_RETRIES = 500
