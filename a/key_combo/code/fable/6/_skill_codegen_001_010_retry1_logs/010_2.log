+from __future__ import annotations
+
+from collections import Counter
+from typing import Iterable
+
+import numpy as np
+
+
+DIR4 = {
+    "U": (-1, 0),
+    "D": (1, 0),
+    "L": (0, -1),
+    "R": (0, 1),
+}
+OPPOSITE = {"U": "D", "D": "U", "L": "R", "R": "L"}
+
+ARM_LEN_RANGE = (1, 2)
+WALL_EXT_RANGE = (0, 2)
+CHAIN_LEN_CHOICES = (2, 3)
+GAP_RANGE = (2, 4)
+MAX_CONTENT = 4
+GEN_RETRIES = 500
+
+
+def get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def colors_present(grid: np.ndarray, *, exclude: Iterable[int] | None = None) -> list[int]:
+    vals = set(map(int, grid.ravel()))
+    if exclude is not None:
+        vals -= set(map(int, exclude))
+    return sorted(vals)
+
+
+def bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def components_mask(mask: np.ndarray, connectivity: int = 8) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    if connectivity == 4:
+        steps = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+    else:
+        steps = [(dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if dr or dc]
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                cells.append((rr, cc))
+                for dr, dc in steps:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(cells, dtype=int))
+    return comps
+
+
+def _flood_from_bbox_side(border_set: set[tuple[int, int]], bbox: tuple[int, int, int, int], side: str) -> set[tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    if side == "U":
+        seeds = [(r0, c) for c in range(c0, c1 + 1) if (r0, c) not in border_set]
+    elif side == "D":
+        seeds = [(r1, c) for c in range(c0, c1 + 1) if (r1, c) not in border_set]
+    elif side == "L":
+        seeds = [(r, c0) for r in range(r0, r1 + 1) if (r, c0) not in border_set]
+    else:
+        seeds = [(r, c1) for r in range(r0, r1 + 1) if (r, c1) not in border_set]
+
+    seen = set(seeds)
+    stack = list(seeds)
+    while stack:
+        r, c = stack.pop()
+        for dr, dc in DIR4.values():
+            nr, nc = r + dr, c + dc
+            if not (r0 <= nr <= r1 and c0 <= nc <= c1):
+                continue
