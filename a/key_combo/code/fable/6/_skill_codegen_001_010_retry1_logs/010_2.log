+def _extract_cups(grid: np.ndarray) -> list[dict]:
+    g = np.array(grid, dtype=int)
+    bg = get_bg(g)
+    cups: list[dict] = []
+    for border_color in colors_present(g, exclude={bg}):
+        for comp in components_mask(g == border_color, connectivity=8):
+            if comp.shape[0] < 5:
