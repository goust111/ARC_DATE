+            elif np.array_equal(block, false_sprite["sprite"]):
+                dst[:, :] = BLACK
+            else:
+                color = int(block[0, 0])
+                assert np.all(block == color)
+                if color == int(true_sprite["minority"]):
+                    dst[:, :] = true_sprite["sprite"]
+                else:
+                    assert color == int(false_sprite["minority"])
+                    dst[:, :] = BLACK
+
