+        if not frontier:
+            return np.zeros((0, 0), dtype=bool)
+        cell = random.choice(tuple(frontier))
+        frontier.remove(cell)
+        chosen.add(cell)
+        add_frontier(*cell)
+
+    mask = np.zeros((size, size), dtype=bool)
+    for r, c in chosen:
+        mask[r, c] = True
