+    H = sum(panel.shape[0] for panel in panels) + len(panels) - 1
+    W = panels[0].shape[1]
+    grid = np.full((H, W), divider_color, dtype=int)
+    r0 = 0
+    for i, panel in enumerate(panels):
+        grid[r0 : r0 + panel.shape[0], :] = panel
+        r0 += panel.shape[0]
+        if i != len(panels) - 1:
