+    step = (shifts[1][0] - shifts[0][0], shifts[1][1] - shifts[0][1])
+    assert step != (0, 0), "motion step must be non-zero"
+    for prev, curr in zip(shifts, shifts[1:]):
+        assert (curr[0] - prev[0], curr[1] - prev[1]) == step, "motion step must be constant"
