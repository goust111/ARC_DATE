+        block[:, -1] = seam_b
+        block[-1, 0] = fill_b
+    else:
+        block[0, :] = seam_a
+        block[:, 0] = seam_b
+        block[-1, -1] = fill_b
+    return block
+
+
+def _build_template(bg: int) -> tuple[np.ndarray, dict]:
