+
+    if kind == "tl":
+        block[:, -1] = seam_a
+        block[-1, :] = seam_b
+        block[0, 0] = fill_b
+    elif kind == "tr":
+        block[:, 0] = seam_a
+        block[-1, :] = seam_b
+        block[0, -1] = fill_b
+    elif kind == "bl":
