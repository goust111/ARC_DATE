def _draw_local(
    intervals0: list[list[tuple[int, int]]],
    growth: int,
    max_back: int,
    back: int,
    direction: int,
    axis: int,
) -> np.ndarray:
    grown = max_back - back
    width = max(end for row in intervals0 for _start, end in row) + max_back * growth + 1
