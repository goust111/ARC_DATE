+def _transform_signature(spec: tuple[str, object]) -> tuple:
+    kind, payload = spec
+    if kind == "geom":
+        return ("geom", str(payload))
+    assert kind == "recolor"
+    return ("recolor", tuple(sorted((int(k), int(v)) for k, v in payload.items())))
