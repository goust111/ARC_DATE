+def _compress_body(grid: np.ndarray, panel_boxes: list[tuple[int, int, int, int]], bg: int) -> np.ndarray:
+    allowed = np.ones(grid.shape, dtype=bool)
+    for r0, c0, r1, c1 in panel_boxes:
