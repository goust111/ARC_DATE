+    for r in range(h):
+        cells.add((r, random.randrange(w)))
+    for c in range(w):
+        if not any(cc == c for _rr, cc in cells):
+            cells.add((random.randrange(h), c))
+    remaining = [(r, c) for r in range(h) for c in range(w) if (r, c) not in cells]
+    random.shuffle(remaining)
