+
+def _make_training_pair(transform_name: str, body_palette: list[int]) -> tuple[np.ndarray, np.ndarray, tuple[str, object]]:
+    for _ in range(400):
+        if transform_name in {"rot90", "rot270", "transpose"}:
+            h = random.randint(3, 5)
+            w = random.randint(3, 5)
