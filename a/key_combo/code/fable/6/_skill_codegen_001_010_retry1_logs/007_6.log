+def _infer_transform(src: np.ndarray, dst: np.ndarray, bg: int) -> tuple[str, object]:
+    matches = _candidate_specs(src, dst, bg)
+    assert len(matches) == 1, "training pair must determine a unique transform"
+    return matches[0]
