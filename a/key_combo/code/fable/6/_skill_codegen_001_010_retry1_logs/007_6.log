+GEOM_TRANSFORMS = {
+    "flip_h": lambda x: np.fliplr(x),
+    "flip_v": lambda x: np.flipud(x),
+    "rot90": lambda x: np.rot90(x, 1),
+    "rot180": lambda x: np.rot90(x, 2),
+    "rot270": lambda x: np.rot90(x, 3),
+    "transpose": lambda x: x.T,
