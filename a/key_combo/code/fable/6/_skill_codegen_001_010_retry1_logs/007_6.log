+    for color in sorted(int(v) for v in np.unique(grid) if int(v) != int(bg)):
+        mask = grid == color
+        if allowed_mask is not None:
+            mask &= allowed_mask
+        for coords in _components(mask, connectivity=connectivity):
+            comps.append(
