+        "inner_h": inner_h,
+        "inner_w": inner_w,
+        "water_rows": int(water_rows),
+        "top_open_abs": top_open_abs,
+        "top_open_rel": None if not top_open else int(top_open[0]),
+        "side": side,
+        "notch_row_abs": notch_row_abs,
+        "retain_rows": int(retain_rows),
+        "exit_col": exit_col,
