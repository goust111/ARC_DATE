+        amount = (rows[cid] - retain_rows) * int(container["inner_w"])
+        rows[cid] = retain_rows
+        queue.append(
+            {
+                "source": cid,
+                "start_row": int(container["notch_row_abs"]),
+                "col": int(container["exit_col"]),
