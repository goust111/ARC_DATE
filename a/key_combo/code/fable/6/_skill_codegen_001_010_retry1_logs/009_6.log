+        if water_rows <= 0:
+            continue
+        inner = out[r0 + 1 : r1, c0 + 1 : c1]
+        inner[-water_rows:, :] = WATER
+    for pile in trace["pile_events"]:
+        out[int(pile["top"]) : int(pile["support"]) + 1, int(pile["col"])] = WATER
