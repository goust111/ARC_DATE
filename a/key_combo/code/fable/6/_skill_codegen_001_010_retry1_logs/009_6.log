+            if info is None:
+                continue
+            cid = len(containers)
+            info["id"] = cid
+            containers.append(info)
+            wall_mask[info["coords"][:, 0], info["coords"][:, 1]] = True
+            if info["top_open_abs"] is not None:
+                key = (info["bbox"][0], int(info["top_open_abs"]))
+                assert key not in top_open_map
+                top_open_map[key] = cid
+
