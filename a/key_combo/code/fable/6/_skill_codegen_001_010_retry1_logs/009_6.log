+def _parse_container(grid: np.ndarray, component: dict, bg: int) -> dict | None:
+    color = int(component["color"])
+    r0, c0, r1, c1 = map(int, component["bbox"])
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 4 or w < 4:
+        return None
