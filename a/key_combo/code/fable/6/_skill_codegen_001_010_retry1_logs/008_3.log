+
+def _histogram(bg: int, counts: list[int]) -> np.ndarray:
+    out = np.full((max(counts), len(counts)), int(bg), dtype=int)
+    for c, count in enumerate(counts):
+        if count:
+            out[-count:, c] = RED
+    return out
