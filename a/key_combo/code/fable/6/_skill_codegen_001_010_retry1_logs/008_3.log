+        node.add_back_edge = (not node.children) or (random.random() < 0.45)
+    return nodes, waves
+
+
+def _place_child(
+    parent: Node,
+    child: Node,
+    direction: tuple[int, int],
+    occupied_blue: set[tuple[int, int]],
