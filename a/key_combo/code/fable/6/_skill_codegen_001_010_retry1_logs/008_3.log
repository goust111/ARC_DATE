+def _wave_layers(adj: dict[int, set[int]], start: int) -> list[list[int]]:
+    seen = {int(start)}
+    wave = [int(start)]
+    layers: list[list[int]] = [wave]
+    while True:
+        nxt = sorted({
+            int(dst)
+            for src in wave
+            for dst in adj[src]
+            if int(dst) not in seen
+        })
+        if not nxt:
+            return layers
+        seen.update(nxt)
+        layers.append(nxt)
+        wave = nxt
