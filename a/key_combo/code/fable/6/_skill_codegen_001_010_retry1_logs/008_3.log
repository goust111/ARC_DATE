+    parent_side = _node_side_cells(parent, direction)[:]
+    child_side = _node_side_cells(child, OPP[direction])[:]
+    random.shuffle(parent_side)
+    random.shuffle(child_side)
+    gaps = [2, 3, 4, 5]
+    random.shuffle(gaps)
