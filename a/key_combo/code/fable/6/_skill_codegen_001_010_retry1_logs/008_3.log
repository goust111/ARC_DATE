+def _semantic_checks(grid: np.ndarray, expected: dict) -> bool:
+    try:
+        scene = _extract_scene(grid)
+    except Exception:
+        return False
+
+    parsed_blobs = set(scene["blobs"])
+    if parsed_blobs != expected["blob_sets"]:
+        return False
+    if scene["blobs"][scene["start"]] != expected["start_blob"]:
+        return False
