+    bg = random.choice(BG_CHOICES)
+    rendered = _render_scene(nodes, bg)
+    if rendered is None:
+        return None
+    grid, expected = rendered
+    if not _semantic_checks(grid, expected):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GRID_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
