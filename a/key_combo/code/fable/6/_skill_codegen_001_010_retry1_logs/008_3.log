+    start_neighbors = {
+        cell_to_blob[(nr, nc)]
+        for nr, nc in ((yr - 1, yc), (yr + 1, yc), (yr, yc - 1), (yr, yc + 1))
+        if (nr, nc) in cell_to_blob
+    }
+    assert len(start_neighbors) == 1, "yellow must touch exactly one blue blob"
+    start = next(iter(start_neighbors))
