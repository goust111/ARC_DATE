+    if random.random() < DISTRACTOR_PROB and len(nodes) <= MAX_BLOBS - 2:
+        distractor = _build_distractor_pair(len(nodes))
+        if distractor is None:
+            return None
+        d_nodes, _d_waves = distractor
+        if not _place_distractor_pair(d_nodes, nodes):
