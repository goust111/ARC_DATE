+def _build_reachable_graph() -> tuple[list[Node], list[list[int]]] | None:
+    depth = random.choices([2, 3, 4, 5], weights=[1, 3, 3, 2])[0]
+    max_blobs = random.randint(depth, MAX_BLOBS)
