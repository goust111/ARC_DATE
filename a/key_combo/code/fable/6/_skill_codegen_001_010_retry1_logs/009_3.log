+    colors = random.sample(ALL_COLORS, pair_count + n_balls)
+    pair_colors = colors[:pair_count]
+    ball_colors = colors[pair_count:]
+    pair_cursor = 0
+
+    plans = []
+    for idx in range(n_balls):
