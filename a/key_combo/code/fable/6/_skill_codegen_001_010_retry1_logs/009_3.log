+    teleport_pairs = []
+    blocker_pairs = []
+    balls = []
+    for idx in range(n_balls):
+        lanes = ball_lanes[idx]
+        plan = plans[idx]
+        balls.append({"color": ball_colors[idx], "pos": (plan["start_row"], lanes[0])})
+        for step, entrance_row in enumerate(plan["entrances"]):
