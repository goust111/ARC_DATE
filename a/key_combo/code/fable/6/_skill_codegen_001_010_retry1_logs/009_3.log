+
+def _build_spec() -> dict | None:
+    n_balls = random.randint(1, 3)
+    chain_lengths = _sample_chain_lengths(n_balls)
+    blocker_flags = [random.random() < 0.45 for _ in range(n_balls)]
+    if not any(blocker_flags) and random.random() < 0.5:
