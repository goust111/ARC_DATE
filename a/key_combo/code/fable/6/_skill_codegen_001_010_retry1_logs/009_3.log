+
+    pairs: dict[int, dict] = {}
+    bracket_mask = np.zeros_like(g, dtype=bool)
+    for color, parts in by_color.items():
+        ups = [part for part in parts if part["kind"] == "up"]
+        downs = [part for part in parts if part["kind"] == "down"]
