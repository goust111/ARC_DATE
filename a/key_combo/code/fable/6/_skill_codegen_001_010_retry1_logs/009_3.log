+    pair_colors = set(scene["pairs"])
+    ball_colors = {int(ball["color"]) for ball in scene["balls"]}
+    if pair_colors & ball_colors:
+        return False
+
+    if len(scene["pairs"]) <= len(used_colors) and random.random() < 0.6:
+        return False
+
+    return True
