+    out = g.copy()
+    for ball in scene["balls"]:
+        rr, cc = ball["pos"]
+        out[rr, cc] = scene["bg"]
+    for ball, detail in zip(scene["balls"], details):
+        rr, cc = detail["final"]
+        out[rr, cc] = int(ball["color"])
+    return out, details, scene
