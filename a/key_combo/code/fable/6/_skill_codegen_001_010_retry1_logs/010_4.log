+        return None
+    if {
+        (r, c) for (r, c) in right_strip if mask[r, c]
+    } != (right_witness | (corner_witness & right_strip)):
+        return None
+    for removed in (
+        bottom_witness | corner_witness,
+        right_witness | corner_witness,
+        right_witness | bottom_witness,
