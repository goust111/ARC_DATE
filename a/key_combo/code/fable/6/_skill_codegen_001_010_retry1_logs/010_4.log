+        assert full_r1 <= out.shape[0] and full_c1 <= out.shape[1]
+        region = out[full_r0:full_r1, full_c0:full_c1]
+        assert np.all((region == bg) | (region == int(piece["color"]))), "completed fragments must not overlap"
