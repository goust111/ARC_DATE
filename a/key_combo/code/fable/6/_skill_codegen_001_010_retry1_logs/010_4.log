+
+def _rotate_canonical_to_current(mask: np.ndarray, orientation: int) -> np.ndarray:
+    return np.rot90(mask, k=(4 - int(orientation)) % 4)
+
+
+def _rotate_current_to_canonical(mask: np.ndarray, orientation: int) -> np.ndarray:
