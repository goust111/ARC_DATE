+    assert inp.ndim == 2 and oracle.ndim == 2
+    assert max(inp.shape) <= 30 and max(oracle.shape) <= 30
+    assert len(partials) >= 2
+    assert len(set(orientations)) >= 2 and any(v != 0 for v in orientations)
