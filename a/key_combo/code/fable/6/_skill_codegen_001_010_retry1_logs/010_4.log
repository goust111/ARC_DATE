+def _box_clear(used: np.ndarray, r0: int, c0: int, h: int, w: int, margin: int = 1) -> bool:
+    rr0 = max(0, r0 - margin)
+    cc0 = max(0, c0 - margin)
+    rr1 = min(used.shape[0], r0 + h + margin)
+    cc1 = min(used.shape[1], c0 + w + margin)
+    return not bool(used[rr0:rr1, cc0:cc1].any())
