+def _random_connected_template(shape: tuple[int, int]) -> np.ndarray | None:
+    h, w = map(int, shape)
+    right_witness = (h // 2, w - 1)
+    bottom_witness = (h - 1, w // 2)
+    corner_witness = (h - 1, w - 1)
+    protected = {
+        (0, 0),
+        (0, w // 2),
+        (h // 2, 0),
+        bottom_witness,
+        right_witness,
+        corner_witness,
+    }
+    forbidden = {
+        (h - 1, c) for c in range(w) if (h - 1, c) not in {bottom_witness, corner_witness}
+    } | {
+        (r, w - 1) for r in range(h) if (r, w - 1) not in {right_witness, corner_witness}
+    }
+    target = random.randint(max(9, (h * w) // 3), max(12, (2 * h * w) // 3))
+    mask = np.zeros((h, w), dtype=bool)
+    for r, c in protected:
+        mask[r, c] = True
+
+    frontier = set()
+    for r, c in protected:
+        for dr, dc in FOUR_NEIGHBORS:
+            nr = r + dr
+            nc = c + dc
+            if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc] and (nr, nc) not in forbidden:
+                frontier.add((nr, nc))
+
