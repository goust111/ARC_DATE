+            inp[mr, mc] = GREY
+            oracle[full_r0 : full_r0 + fh, full_c0 : full_c0 + fw][completed_mask] = int(item["color"])
+            _reserve_box(used, full_r0, full_c0, fh, fw, marker)
+            item["placement"] = {
+                "full_r0": full_r0,
+                "full_c0": full_c0,
+                "vis_r0": vis_r0,
+                "vis_c0": vis_c0,
+                "marker": marker,
+            }
+            placed = True
+            break
