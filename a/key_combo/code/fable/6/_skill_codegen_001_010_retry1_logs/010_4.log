+    markers = []
+    for comp in _components(g == GREY):
+        assert len(comp) == 1, "grey markers must be isolated singleton pixels"
+        markers.append(tuple(map(int, comp[0])))
+    assert len(markers) >= 2, "expected multiple marked fragments"
