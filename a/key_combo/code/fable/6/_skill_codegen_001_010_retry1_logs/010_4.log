+    th, tw = map(int, template_shape)
+    orientation = int(orientation)
+    if orientation == 0:
+        return 0, 0
+    if orientation == 1:
+        return 0, th - ph
+    if orientation == 2:
+        return th - ph, tw - pw
+    if orientation == 3:
+        return tw - pw, 0
+    raise ValueError("invalid orientation")
+
+
+def _marker_side_for_bbox(
+    marker: tuple[int, int], bbox: tuple[int, int, int, int]
