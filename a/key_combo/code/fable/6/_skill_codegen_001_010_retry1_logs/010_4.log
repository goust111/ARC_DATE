+def _marker_position(bbox: tuple[int, int, int, int], side: str) -> tuple[int, int]:
+    r0, c0, r1, c1 = map(int, bbox)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if side == "U":
+        return r0 - 1, c0 + w // 2
+    if side == "R":
+        return r0 + h // 2, c1 + 1
+    if side == "D":
+        return r1 + 1, c0 + w // 2
+    return r0 + h // 2, c0 - 1
