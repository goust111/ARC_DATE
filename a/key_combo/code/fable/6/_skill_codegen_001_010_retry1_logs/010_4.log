+    pieces: list[dict] = []
+    for color in sorted(int(v) for v in np.unique(g) if int(v) not in (bg, GREY)):
+        comps = _components(g == color)
+        for comp in comps:
+            mask = np.zeros(g.shape, dtype=bool)
+            mask[comp[:, 0], comp[:, 1]] = True
