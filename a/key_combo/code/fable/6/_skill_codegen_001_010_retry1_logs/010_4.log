+    r0, c0, r1, c1 = map(int, bbox)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h % 2 == 0 or w % 2 == 0:
+        return None
+    centers = {
+        "U": (r0 - 1, c0 + w // 2),
+        "R": (r0 + h // 2, c1 + 1),
+        "D": (r1 + 1, c0 + w // 2),
+        "L": (r0 + h // 2, c0 - 1),
