+    for r, c in np.argwhere(mask):
+        rr = int(r)
+        cc = int(c)
+        if seen[rr, cc]:
+            continue
+        stack = [(rr, cc)]
+        seen[rr, cc] = True
+        pts = []
+        while stack:
+            pr, pc = stack.pop()
+            pts.append((pr, pc))
+            for dr, dc in FOUR_NEIGHBORS:
