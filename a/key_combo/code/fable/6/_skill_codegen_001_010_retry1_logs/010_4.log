+def _render_completed_output(grid: np.ndarray, bg: int, pieces: list[dict], template: np.ndarray) -> np.ndarray:
+    out = np.asarray(grid, dtype=int).copy()
+    out[out == GREY] = bg
+    th, tw = map(int, template.shape)
