+def _random_connected_template(shape: tuple[int, int]) -> np.ndarray | None:
+    h, w = map(int, shape)
+    protected = {
+        (0, 0),
+        (0, w // 2),
+        (h // 2, 0),
+        (h - 1, w // 2),
+        (h // 2, w - 1),
+        (h - 1, w - 1),
+    }
+    target = random.randint(max(9, (h * w) // 3), max(12, (2 * h * w) // 3))
+    mask = np.zeros((h, w), dtype=bool)
+    for r, c in protected:
+        mask[r, c] = True
+
+    frontier = set()
+    for r, c in protected:
+        for dr, dc in FOUR_NEIGHBORS:
+            nr = r + dr
+            nc = c + dc
+            if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc]:
+                frontier.add((nr, nc))
+
+    while int(mask.sum()) < target and frontier:
+        nr, nc = random.choice(sorted(frontier))
+        frontier.remove((nr, nc))
+        mask[nr, nc] = True
+        for dr, dc in FOUR_NEIGHBORS:
+            rr = nr + dr
+            cc = nc + dc
+            if 0 <= rr < h and 0 <= cc < w and not mask[rr, cc]:
+                frontier.add((rr, cc))
