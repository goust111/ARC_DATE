+    for r, c in np.argwhere(mask):
+        rr = int(r)
+        cc = int(c)
+        if seen[rr, cc]:
+            continue
+        stack = [(rr, cc)]
+        seen[rr, cc] = True
+        pts = []
+        while stack:
+            pr, pc = stack.pop()
+            pts.append((pr, pc))
+            for dr, dc in FOUR_NEIGHBORS:
+                nr = pr + dr
+                nc = pc + dc
+                if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    stack.append((nr, nc))
