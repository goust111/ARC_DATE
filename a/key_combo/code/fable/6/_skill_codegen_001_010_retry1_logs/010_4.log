+        return None
+    if not mask[0, 0]:
+        return None
+    if {
+        (h - 1, c) for c in range(w) if mask[h - 1, c]
+    } != {bottom_witness, corner_witness}:
+        return None
+    if {
+        (r, w - 1) for r in range(h) if mask[r, w - 1]
+    } != {right_witness, corner_witness}:
+        return None
+    for removed in ({bottom_witness, corner_witness}, {right_witness, corner_witness}, {right_witness, bottom_witness}):
