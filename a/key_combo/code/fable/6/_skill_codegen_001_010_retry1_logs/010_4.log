+def _make_partial_without(template: np.ndarray, removed: set[tuple[int, int]]) -> np.ndarray | None:
+    partial = template.copy()
+    for r, c in removed:
+        partial[r, c] = False
+    if not partial[0, 0] or np.array_equal(partial, template):
+        return None
+    if not _is_connected(partial):
+        return None
+    return partial
