+    used = np.zeros((grid_h, grid_w), dtype=bool)
+
+    for item in items:
+        completed = item["completed"]
+        current = item["current"]
+        fh, fw = completed.shape
+        ch, cw = current.shape
+        off_r, off_c = item["offset"]
+        placed = False
+        candidates = [
+            (r0, c0)
+            for r0 in range(grid_h - fh + 1)
+            for c0 in range(grid_w - fw + 1)
