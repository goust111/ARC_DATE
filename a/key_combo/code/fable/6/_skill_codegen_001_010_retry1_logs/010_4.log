+    mask = np.zeros((h, w), dtype=bool)
+    mask[0, : w // 2 + 1] = True
+    mask[: h // 2 + 1, 0] = True
+    mask[:, w // 2] = True
+    mask[h // 2, : w - 1] = True
+    mask[h - 3, w // 2 : w - 2] = True
+    for r, c in corner_witness:
+        mask[r, c] = True
+    for r, c in right_witness:
+        mask[r, c] = True
+    for r, c in bottom_witness:
+        mask[r, c] = True
+    for r, c in forbidden:
+        mask[r, c] = False
