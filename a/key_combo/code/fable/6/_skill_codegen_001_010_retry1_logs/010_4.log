+        full_c0 = c0 - off_c
+        full_r1 = full_r0 + completed.shape[0]
+        full_c1 = full_c0 + completed.shape[1]
+        assert 0 <= full_r0 and 0 <= full_c0
+        assert full_r1 <= out.shape[0] and full_c1 <= out.shape[1]
