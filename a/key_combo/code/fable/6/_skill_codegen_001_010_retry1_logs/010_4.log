+    if not _is_connected(mask):
+        return None
+    if not mask[0, 0]:
+        return None
+    if not mask[-1].any() or not mask[:, -1].any():
+        return None
+    if h == w:
+        if np.array_equal(mask, np.rot90(mask, 1)):
+            return None
+        if np.array_equal(mask, np.rot90(mask, 2)):
+            return None
