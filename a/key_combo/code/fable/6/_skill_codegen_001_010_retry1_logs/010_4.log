+
+def _edge_cells(mask: np.ndarray) -> set[tuple[int, int]]:
+    h, w = mask.shape
+    out = set()
+    for c in range(w):
+        if mask[h - 1, c]:
+            out.add((h - 1, c))
+        if mask[0, c]:
+            out.add((0, c))
+    for r in range(h):
+        if mask[r, w - 1]:
+            out.add((r, w - 1))
+        if mask[r, 0]:
+            out.add((r, 0))
+    return out
+
+
+def _sample_partial(template: np.ndarray, force_missing_edges: bool) -> np.ndarray | None:
+    h, w = template.shape
+    partial = template.copy()
+    protected = {(0, 0)}
+    if force_missing_edges:
+        protected |= _edge_cells(template)
+
+    all_cells = [tuple(map(int, rc)) for rc in np.argwhere(template)]
+    removable = [cell for cell in all_cells if cell not in protected]
+    if not removable:
+        return None
+
+    target_remove = random.randint(max(1, len(all_cells) // 8), max(2, len(all_cells) // 3))
+    removed = 0
+    attempts = 0
+    while removed < target_remove and attempts < 200:
+        attempts += 1
+        candidates = []
+        for r, c in removable:
+            if not partial[r, c]:
+                continue
+            score = (r + c) + random.random() * 1.5
+            if force_missing_edges and (r == h - 1 or c == w - 1):
+                score += 4.0
+            candidates.append((score, r, c))
+        if not candidates:
+            break
+        candidates.sort(reverse=True)
+        _score, r, c = candidates[0]
+        trial = partial.copy()
+        trial[r, c] = False
+        if trial[0, 0] and _is_connected(trial):
+            partial = trial
+            removed += 1
+    if np.array_equal(partial, template):
+        return None
+    if not partial[0, 0] or not _is_connected(partial):
+        return None
+    return partial
+
+
+def _build_partials(template: np.ndarray, count: int) -> list[np.ndarray] | None:
+    area = int(template.sum())
+    if count < 2 or area < count + 4:
+        return None
+    for _ in range(200):
+        partials = []
+        for i in range(count):
+            force_edges = i == 0 or (i == 1 and random.random() < 0.8)
+            partial = _sample_partial(template, force_edges)
+            if partial is None:
+                break
+            partials.append(partial)
+        if len(partials) != count:
+            continue
+        union = np.zeros_like(template)
+        for partial in partials:
+            union |= partial
+        if not np.array_equal(union, template):
+            continue
+        if any(np.array_equal(partial, template) for partial in partials):
+            continue
+        contribution_ok = True
+        for i, partial in enumerate(partials):
+            others = np.zeros_like(template)
+            for j, other in enumerate(partials):
+                if i != j:
+                    others |= other
+            if not np.any(partial & ~others):
+                contribution_ok = False
+                break
+        if not contribution_ok:
+            continue
+        if len({tuple(np.argwhere(partial).max(axis=0)) for partial in partials}) == 1:
+            continue
+        return partials
+    return None
