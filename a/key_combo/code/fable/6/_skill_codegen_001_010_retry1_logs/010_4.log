+from __future__ import annotations
+
+from collections import Counter
+import random
+
+import numpy as np
+
+
+GREY = 5
+FOUR_NEIGHBORS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+ORIENTATION_TO_SIDE = {0: "U", 1: "R", 2: "D", 3: "L"}
+SIDE_TO_ORIENTATION = {side: orient for orient, side in ORIENTATION_TO_SIDE.items()}
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.flat)).most_common(1)[0][0])
+
+
+def _coords(mask: np.ndarray) -> np.ndarray:
+    return np.argwhere(mask)
+
+
+def _bbox_from_mask(mask: np.ndarray) -> tuple[int, int, int, int] | None:
+    pts = _coords(mask)
+    if pts.size == 0:
+        return None
+    r0, c0 = pts.min(axis=0)
+    r1, c1 = pts.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _crop_bbox(mask: np.ndarray) -> np.ndarray:
+    box = _bbox_from_mask(mask)
+    assert box is not None
+    r0, c0, r1, c1 = box
+    return mask[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r, c in np.argwhere(mask):
+        rr = int(r)
+        cc = int(c)
+        if seen[rr, cc]:
+            continue
+        stack = [(rr, cc)]
+        seen[rr, cc] = True
+        pts = []
+        while stack:
+            pr, pc = stack.pop()
+            pts.append((pr, pc))
+            for dr, dc in FOUR_NEIGHBORS:
+                nr = pr + dr
+                nc = pc + dc
+                if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    stack.append((nr, nc))
