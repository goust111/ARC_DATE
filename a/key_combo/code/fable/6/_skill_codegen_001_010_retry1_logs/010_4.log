+            partial = _sample_partial(template, force_edges)
+            if partial is None:
+                break
+            partials.append(partial)
+        if len(partials) != count:
+            continue
+        union = np.zeros_like(template)
+        for partial in partials:
+            union |= partial
+        if not np.array_equal(union, template):
+            continue
+        if any(np.array_equal(partial, template) for partial in partials):
+            continue
+        contribution_ok = True
+        for i, partial in enumerate(partials):
+            others = np.zeros_like(template)
+            for j, other in enumerate(partials):
+                if i != j:
+                    others |= other
+            if not np.any(partial & ~others):
+                contribution_ok = False
+                break
+        if not contribution_ok:
