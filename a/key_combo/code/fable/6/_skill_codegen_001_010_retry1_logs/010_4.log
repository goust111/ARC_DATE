+def _assemble_instance() -> tuple[np.ndarray, np.ndarray]:
+    template_shape = random.choice(TEMPLATE_SHAPES)
+    template = _random_connected_template(template_shape)
+    if template is None:
+        raise ValueError("template generation failed")
+
