+def _reserve_box(used: np.ndarray, r0: int, c0: int, h: int, w: int, marker: tuple[int, int]) -> None:
+    used[r0 : r0 + h, c0 : c0 + w] = True
+    mr, mc = marker
+    used[mr, mc] = True
