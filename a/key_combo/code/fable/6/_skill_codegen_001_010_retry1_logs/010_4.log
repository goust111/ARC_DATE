+
+TEMPLATE_SHAPES = [(5, 7), (7, 5), (7, 7)]
+GRID_SHAPE_CHOICES = [
+    (17, 19),
+    (18, 22),
+    (19, 25),
+    (20, 20),
+    (21, 24),
+    (22, 28),
+    (24, 24),
+    (25, 29),
+]
