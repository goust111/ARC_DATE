+        frontier.remove((nr, nc))
+        mask[nr, nc] = True
+        for dr, dc in FOUR_NEIGHBORS:
+            rr = nr + dr
+            cc = nc + dc
+            if 0 <= rr < h and 0 <= cc < w and not mask[rr, cc] and (rr, cc) not in forbidden:
