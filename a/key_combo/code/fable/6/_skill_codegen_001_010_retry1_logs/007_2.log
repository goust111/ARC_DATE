+        r0 = cr - next_radius
+        c0 = cc - next_radius
+        r1 = cr + next_radius
+        c1 = cc + next_radius
+        if r0 < 0 or c0 < 0 or r1 >= room_mask.shape[0] or c1 >= room_mask.shape[1]:
