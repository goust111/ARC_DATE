+def _boundary_exit_count(room_mask: np.ndarray) -> int:
+    boundary = np.zeros_like(room_mask, dtype=bool)
+    boundary[0, :] = True
+    boundary[-1, :] = True
+    boundary[:, 0] = True
+    boundary[:, -1] = True
+    return len(components_mask(room_mask & boundary, connectivity=4))
+
