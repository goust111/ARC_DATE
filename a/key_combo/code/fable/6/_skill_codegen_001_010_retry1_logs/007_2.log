+            assert np.all(grid[r0 : r1 + 1, c0 : c1 + 1] == color), "foreground square must fill its bbox"
+            squares.append(
+                {
+                    "color": int(color),
+                    "coords": coords,
+                    "side": int(side_r),
+                    "center": (int((r0 + r1) // 2), int((c0 + c1) // 2)),
+                }
