+    grid[-1, :] = WALL_COLOR
+    grid[:, 0] = WALL_COLOR
+    grid[:, -1] = WALL_COLOR
+
+    split_r = top_h + 1
+    split_c = left_w + 1
+    grid[split_r, :] = WALL_COLOR
+    grid[:, split_c] = WALL_COLOR
