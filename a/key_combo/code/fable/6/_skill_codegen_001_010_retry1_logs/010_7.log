    return out

def fully_point_symmetric(grid, center):
    H,W=grid.shape; sr,sc=center
    for r,c in np.argwhere(grid!=BG):
        r2=sr-int(r); c2=sc-int(c)
        if not (0<=r2<H and 0<=c2<W): return False
        if grid[r2,c2]!=grid[r,c]: return False
    return True

def solve(grid):
    g=np.array(grid,int)
