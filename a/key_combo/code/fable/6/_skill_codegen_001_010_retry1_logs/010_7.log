            if not place([cell], color, allow_on_ring=True):
                return None
            used_colors.append(color)
    if len(set(used_colors))<3:
        return None

    # 2) mirror-decoy pairs inside frame interior
    interior_pairs=[]
    for r in range(r0+1,r1):
        for c in range(c0+1,c1):
            cm=sc-c
            if not (c0+1<=cm<=c1-1):
