                pts.append(p)
        if len(set(pts))"'!=len(pts):
            return False
        for p in pts:
            if p in occ and g[p]!=color: return False
        return True

    def place(cells,color,allow_on_ring=False):
        if not can_place(cells,color,allow_on_ring): return False
        for cell in cells:
            for p in (cell, mate(cell)):
                g[p]=color; occ.add(p)
        return True

