+def _mate(cell: tuple[int, int], center: tuple[int, int]) -> tuple[int, int]:
+    sr, sc = center
+    r, c = cell
+    return sr - r, sc - c
+
+
+def _make_generator(
+    h: int,
+    w: int,
+    bg: int,
+    center: tuple[int, int],
+    frame_box: tuple[int, int, int, int],
+    frame_color: int,
