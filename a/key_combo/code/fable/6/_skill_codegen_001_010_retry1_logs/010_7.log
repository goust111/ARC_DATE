from __future__ import annotations
import random, numpy as np
from collections import Counter

BG=0
PALETTE=[1,2,3,4,5,6,7,8,9]

def border_set(b):
    r0,c0,r1,c1=b
    s=[]
    for c in range(c0,c1+1): s.append((r0,c)); s.append((r1,c))
    for r in range(r0+1,r1): s.append((r,c0)); s.append((r,c1))
    return set(s)

def bbox_of_pts(pts):
    rs=[p[0] for p in pts]; cs=[p[1] for p in pts]
    return min(rs),min(cs),max(rs),max(cs)

def components(grid,color):
    H,W=grid.shape
    seen=np.zeros((H,W),bool)
    out=[]
    for r in range(H):
        for c in range(W):
            if seen[r,c] or grid[r,c]"'!=color: continue
            st=[(r,c)]; seen[r,c]=True; pts=[]
            while st:
                rr,cc=st.pop(); pts.append((rr,cc))
                for nr,nc in ((rr-1,cc),(rr+1,cc),(rr,cc-1),(rr,cc+1)):
                    if 0<=nr<H and 0<=nc<W and not seen[nr,nc] and grid[nr,nc]==color:
                        seen[nr,nc]=True; st.append((nr,nc))
            out.append(pts)
    return out

def ring_candidates(grid):
    out=[]
    colors=sorted(set(map(int,grid.flat))-{BG})
    for color in colors:
