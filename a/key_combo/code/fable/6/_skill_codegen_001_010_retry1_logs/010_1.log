+    for color, box in zip(colors, boxes):
+        r0, c0, r1, c1 = map(int, box)
+        need = random.choice(NOISE_COUNT_CHOICES)
+        candidates = [
+            (r, c)
+            for r in range(h)
+            for c in range(w)
+            if can_place_noise(g, r, c, bg, boxes)
+            and not (r0 <= r <= r1 and c0 <= c <= c1)
+            and r not in (r0, r1)
+            and c not in (c0, c1)
