+    return edges
+
+
+def validate_semantics(
+    inp: np.ndarray,
+    expected: np.ndarray,
+    true_order: list[int],
+    true_boxes: list[tuple[int, int, int, int]],
+    noises: dict[int, list[tuple[int, int]]],
