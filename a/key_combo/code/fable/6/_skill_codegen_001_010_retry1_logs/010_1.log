+        return True
+    except Exception:
+        return False
+
+
+def gen_attempt() -> np.ndarray | None:
+    """Generate one valid puzzle instance."""
+    h = random.randint(*GRID_H_RANGE)
+    w = random.randint(*GRID_W_RANGE)
