+def neighbors8(shape: tuple[int, int], r: int, c: int) -> list[tuple[int, int]]:
+    """Return the in-bounds 8-neighborhood of a cell."""
+    out: list[tuple[int, int]] = []
+    h, w = map(int, shape)
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
