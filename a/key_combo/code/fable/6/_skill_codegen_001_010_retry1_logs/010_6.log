+        mask[-1, :] = True
+        mask[:, 0] = True
+        mask[:, -1] = True
+    else:
+        raise AssertionError("unknown motif kind")
+
+    assert mask.any()
+    return mask
+
+
+def _sample_motif(block_side: int, color: int, bg: int) -> tuple[np.ndarray, np.ndarray]:
+    for _ in range(50):
