+    if mh % 2 == 1 and mw % 2 == 1 and mh > 1 and mw > 1:
+        kinds.append("cross")
+    if mh > 2 and mw > 2:
+        kinds.append("border")
+    kind = random.choice(kinds)
+
+    if kind == "full":
+        mask[:, :] = True
+    elif kind == "l_tl":
+        mask[0, :] = True
+        mask[:, 0] = True
+    elif kind == "l_br":
+        mask[-1, :] = True
+        mask[:, -1] = True
+    elif kind == "tee_top":
+        mask[0, :] = True
+        mask[:, mw // 2] = True
+    elif kind == "tee_bottom":
+        mask[-1, :] = True
+        mask[:, mw // 2] = True
+    elif kind == "cross":
+        mask[mh // 2, :] = True
+        mask[:, mw // 2] = True
+    elif kind == "border":
