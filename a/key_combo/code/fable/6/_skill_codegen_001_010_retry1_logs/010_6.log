+    comps = find_components(
+        g,
+        bg=bg,
+        connectivity=8,
+        monochromatic=False,
+        return_format="dict",
+    )
+    records: list[dict] = []
+    for comp in comps:
+        box = comp["bbox"]
+        patch = crop_bbox(g, box)
+        fg = patch != bg
+        colors = sorted(int(v) for v in np.unique(patch[fg]))
+        records.append(
+            {
+                "bbox": box,
+                "patch": patch,
+                "fg": fg,
+                "colors": colors,
+                "h": int(bbox_h(box)),
+                "w": int(bbox_w(box)),
+                "area": int(fg.sum()),
+            }
+        )
