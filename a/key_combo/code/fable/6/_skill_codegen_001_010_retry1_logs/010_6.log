FRAME_HEIGHT_RANGE = (2, 15)
FRAME_WIDTH_RANGE = (3, 16)
REQUIRED_PREV_OVERLAPS = (2, 4)
ALLOWED_PRIOR_OVERLAPS = (0, 2, 4)

# Retry limits.
