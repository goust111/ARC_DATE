+def _choose_block_and_tile_size() -> tuple[int, int]:
+    block_side = random.randint(*BLOCK_SIDE_RANGE)
+    tile_max = min(5, 30 // block_side)
+    tile_side = random.randint(2, tile_max)
+    return int(block_side), int(tile_side)
