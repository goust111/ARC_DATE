+        order = patches[:]
+        random.shuffle(order)
+        ok = True
+
+        for name, patch in order:
+            box = np.ones(patch.shape, dtype=int)
+            try:
+                r0, c0 = random_free_location(
+                    occupancy,
+                    box,
+                    transparent=0,
+                    border=1,
