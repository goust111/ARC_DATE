+    elif kind == "l_tl":
+        mask[0, :] = True
+        mask[:, 0] = True
+    elif kind == "l_br":
+        mask[-1, :] = True
+        mask[:, -1] = True
+    elif kind == "tee_top":
+        mask[0, :] = True
+        mask[:, mw // 2] = True
+    elif kind == "tee_bottom":
+        mask[-1, :] = True
+        mask[:, mw // 2] = True
+    elif kind == "cross":
+        mask[mh // 2, :] = True
+        mask[:, mw // 2] = True
