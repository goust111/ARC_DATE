+    sprites = []
+    for comp in _find_components(work, bg=bg, connectivity=4):
+        mask, bbox = _mask_from_coords(comp["coords"])
+        sprites.append(
+            {
+                "color": int(comp["color"]),
+                "bbox": bbox,
+                "mask": mask,
+                "key": _mask_key(mask),
+            }
+        )
