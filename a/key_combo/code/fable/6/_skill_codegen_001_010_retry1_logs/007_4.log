+    wall_a = remain.pop()
+    if random.random() < 0.35:
+        wall_b = wall_a
+    else:
+        wall_b = remain.pop()
+    sprite_cols = remain[:n_groups]
+    return bg, wall_a, wall_b, sprite_cols
