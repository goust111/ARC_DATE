+_BASE_SHAPES = [
+    _shape(("##",)),
+    _shape(("###",)),
+    _shape(("##", "#.")),
+    _shape((".#", "##")),
+    _shape(("###", ".#.")),
+    _shape(("##.", ".##")),
+    _shape(("#..", "###")),
+    _shape(("###", "..#")),
+    _shape((".#.", "###")),
+    _shape(("##", ".#", ".#")),
+    _shape(("#.", "#.", "##")),
+    _shape(("####",)),
+    _shape(("###", "##.")),
+    _shape(("###", ".##")),
+]
+
+
+def _build_shape_library() -> list[np.ndarray]:
+    seen: set[tuple[tuple[int, int], bytes]] = set()
+    result: list[np.ndarray] = []
+    for shape in _BASE_SHAPES:
+        key = _mask_key(shape)
+        if key not in seen:
