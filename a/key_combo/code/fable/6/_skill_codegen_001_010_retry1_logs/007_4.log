+                "side": wall["side"],
+                "wall_color": int(wall["color"]),
+                "bbox": (r0 + lr0, c0 + lc0, r0 + local_bbox[2], c0 + local_bbox[3]),
+                "mask": hmask,
+                "key": _mask_key(hmask),
+                "top_left": (r0 + lr0, c0 + lc0),
