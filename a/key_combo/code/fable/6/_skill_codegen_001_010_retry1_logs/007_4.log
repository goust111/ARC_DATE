 135: H = W = 16                                        # fixed grid size
 136: BG = 7                                            # fixed background color
 137: HIT_COLOR = 9                                     # recolor for hit sprites and lone-hit bg cells
 138: COLLISION_COLOR = 1                               # bg cells hit by >=2 projectiles
 139: SPRITE_COLORS = [0, 1, 2, 3, 4, 5, 6, 8, 9]       # any color != BG
 140: 
