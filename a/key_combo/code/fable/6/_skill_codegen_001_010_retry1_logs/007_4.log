+        return False
+    for dr, dc in np.argwhere(shape):
+        rr, cc = r0 + int(dr), c0 + int(dc)
+        for nr in range(rr - 1, rr + 2):
+            for nc in range(cc - 1, cc + 2):
+                if 0 <= nr < occupied.shape[0] and 0 <= nc < occupied.shape[1] and occupied[nr, nc]:
