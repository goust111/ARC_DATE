 142: PROJECTILE_DIST = 5                               # apex + 5*dir = landing cell
 143: DIAG_DIRS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]  # L-shape fires diagonally
 144: AXIS_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]    # V-shape fires axis-aligned
