+
+
+_BASE_SHAPES = [
+    _shape(("##",)),
+    _shape(("###",)),
+    _shape(("##", "#.")),
+    _shape((".#", "##")),
+    _shape(("###", ".#.")),
+    _shape(("##.", ".##")),
+    _shape(("#..", "###")),
+    _shape(("###", "..#")),
+    _shape((".#.", "###")),
+    _shape(("##", ".#", ".#")),
+    _shape(("#.", "#.", "##")),
+    _shape(("####",)),
+    _shape(("###", "##.")),
+    _shape(("###", ".##")),
+]
+
+
