+def _extract_sprites(grid: np.ndarray, bg: int, walls: list[dict]) -> list[dict]:
+    work = np.asarray(grid, dtype=int).copy()
+    for wall in walls:
+        r0, c0, r1, c1 = wall["bbox"]
+        work[r0 : r1 + 1, c0 : c1 + 1] = int(bg)
