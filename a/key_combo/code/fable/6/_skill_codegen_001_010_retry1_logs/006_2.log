+
+def _segment_cells(
+    hit: tuple[int, int], orientation: str, arm_a: int, arm_b: int
+) -> set[tuple[int, int]]:
+    if orientation == "\\":
+        step_a, step_b = (-1, -1), (1, 1)
+    else:
+        assert orientation == "/"
+        step_a, step_b = (-1, 1), (1, -1)
