+def _is_inner_ring(coord: tuple[int, int], h: int, w: int) -> bool:
+    r, c = coord
+    return r in {1, h - 2} or c in {1, w - 2}
+
+
+def _in_core(coord: tuple[int, int], h: int, w: int) -> bool:
+    r, c = coord
+    return 2 <= r <= h - 3 and 2 <= c <= w - 3
