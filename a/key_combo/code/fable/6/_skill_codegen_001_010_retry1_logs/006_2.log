+        choices.append(cells)
+    return choices
+
+
+def _mark_forbidden(cells: set[tuple[int, int]], forbidden: set[tuple[int, int]]) -> None:
+    for cell in cells:
+        forbidden.add(cell)
+        forbidden.update(_neighbor8(cell))
