+def _line_from(coord: tuple[int, int], direction: tuple[int, int], h: int, w: int) -> list[tuple[int, int]]:
+    cells: list[tuple[int, int]] = []
+    r, c = coord
+    dr, dc = direction
+    while True:
+        r += dr
+        c += dc
+        if not (0 <= r < h and 0 <= c < w):
+            break
+        if _is_border_cell((r, c), h, w):
+            break
+        cells.append((r, c))
+    return cells
