+def _border_positions(h: int, w: int) -> list[tuple[int, int]]:
+    cells: list[tuple[int, int]] = []
+    for c in range(w):
+        cells.append((0, c))
+        cells.append((h - 1, c))
+    for r in range(1, h - 1):
+        cells.append((r, 0))
+        cells.append((r, w - 1))
