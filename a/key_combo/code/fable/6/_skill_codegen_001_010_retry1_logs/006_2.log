+        "mirror_color": mirror_color,
+        "absorber_color": absorber_color,
+        "lamp_color": lamp_color,
+        "lamp_coord": lamp_coord,
+        "start_dir": START_DIR_BY_SIDE[sides[0]],
+        "segment_by_cell": segment_by_cell,
