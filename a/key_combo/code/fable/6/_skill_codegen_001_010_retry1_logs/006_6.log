+    right_trigger = items[-1]["h"] == 1 and items[-1]["c"] - items[-2]["c"] == 1
+    assert left_trigger ^ right_trigger, "trigger must be a unique outer singleton"
+
+    if left_trigger:
+        trigger = items[0]
+        bars = items[1:]
+        direction = 1
+        trigger_side = "left"
+    else:
+        trigger = items[-1]
+        bars = items[:-1]
+        direction = -1
+        trigger_side = "right"
