+DROP_COUNT_RANGE = (4, 6)
+GRID_SIDE_RANGE = (18, 30)
+SPRITE_SIDE_RANGE = (4, 6)
+SPRITE_EXTRA_PIXELS = (3, 7)
+PATH_WIDTH_RANGE = (6, 11)
+PATH_ROWS_RANGE = (3, 5)
+DROP_GAP_RANGE = (1, 3)
