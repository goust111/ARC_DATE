+def _traverse_path(grid: np.ndarray, path_comp: list[Coord]) -> list[tuple[Coord, int]]:
+    path_set = set(path_comp)
+    adjacency: dict[Coord, list[Coord]] = {}
+    endpoints: list[Coord] = []
