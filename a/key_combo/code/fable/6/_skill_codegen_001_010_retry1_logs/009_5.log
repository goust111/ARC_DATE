+
+
+def _render_input(
+    shape: tuple[int, int],
+    sprite: np.ndarray,
+    sprite_top: int,
+    sprite_left: int,
+    path_order: list[Coord],
+    drops: list[tuple[Coord, int]],
+) -> np.ndarray:
+    h, w = shape
+    grid = np.full((h, w), BG, dtype=int)
