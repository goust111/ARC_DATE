+
+def _simulate_stamps(shape: tuple[int, int], sprite: np.ndarray, drops: list[tuple[Coord, int]], bg: int) -> np.ndarray:
+    out = np.full(shape, bg, dtype=int)
+    for (r, c), color in drops:
