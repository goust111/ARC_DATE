+
+    start = min(endpoints)
+    ordered: list[Coord] = []
+    prev = None
+    cur = start
+    while True:
+        ordered.append(cur)
+        nxt = [nbr for nbr in adjacency[cur] if nbr != prev]
+        if not nxt:
+            break
+        assert len(nxt) == 1
+        prev, cur = cur, nxt[0]
+    assert len(ordered) == len(path_comp), "path traversal must cover every cell exactly once"
