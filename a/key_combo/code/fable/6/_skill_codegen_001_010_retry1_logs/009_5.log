+    for comp in comps:
+        colors = {int(grid[r, c]) for r, c in comp}
+        if PATH_COLOR in colors:
+            assert path_comp is None
+            path_comp = comp
+        else:
+            assert sprite_comp is None
+            sprite_comp = comp
+
+    assert path_comp is not None and sprite_comp is not None
