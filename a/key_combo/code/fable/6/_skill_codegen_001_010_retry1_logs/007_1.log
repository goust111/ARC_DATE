+def _solve(grid: np.ndarray) -> dict:
+    parsed = _parse_panels(grid)
+    solutions = _find_solutions(parsed["visible_masks"], parsed["occluder_mask"])
+    assert len(solutions) == 1
+    solution = solutions[0]
+    parsed.update(solution)
+    return parsed
