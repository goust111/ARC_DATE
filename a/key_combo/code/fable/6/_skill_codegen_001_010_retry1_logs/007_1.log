+def _shift_mask(mask: np.ndarray, dr: int, dc: int, *, strict: bool = False) -> np.ndarray | None:
+    h, w = mask.shape
+    out = np.zeros_like(mask, dtype=bool)
+
+    if dr >= 0:
+        src_r = slice(0, h - dr)
+        dst_r = slice(dr, h)
+    else:
