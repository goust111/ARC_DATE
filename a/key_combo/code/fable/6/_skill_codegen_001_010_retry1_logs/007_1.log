+    aligned_union = np.zeros_like(sprite_mask, dtype=bool)
+    for i, fragment in enumerate(visible):
+        back = _shift_mask(fragment, -i * motion[0], -i * motion[1], strict=True)
+        if back is None:
+            return False
+        aligned_union |= back
