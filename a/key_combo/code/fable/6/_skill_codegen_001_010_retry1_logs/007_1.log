+        solved = _solve(inp)
+        if solved["motion"] != motion:
+            continue
+        if not np.array_equal(solved["sprite_mask"], sprite):
+            continue
+        if not np.array_equal(main(inp), out):
+            continue
+        return inp, out
+    return None
+
