+    r0, c0, r1, c1 = box
+    return bool(np.all(mask[r0 : r1 + 1, c0 : c1 + 1]))
+
+
+def _make_panel(
+    visible_mask: np.ndarray,
+    occluder_mask: np.ndarray,
+    *,
+    frame: int,
+    fill: int,
+    sprite_color: int,
+    occluder_color: int,
+) -> np.ndarray:
