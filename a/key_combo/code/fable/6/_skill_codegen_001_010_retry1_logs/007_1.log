+    ih, iw = visible_mask.shape
+    panel = np.full((ih + 2, iw + 2), int(fill), dtype=int)
+    panel[0, :] = int(frame)
+    panel[-1, :] = int(frame)
+    panel[:, 0] = int(frame)
+    panel[:, -1] = int(frame)
+    interior = panel[1:-1, 1:-1]
+    interior[visible_mask] = int(sprite_color)
+    interior[occluder_mask] = int(occluder_color)
+    return panel
