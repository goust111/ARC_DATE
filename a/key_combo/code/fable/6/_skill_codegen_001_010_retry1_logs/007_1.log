+    for occ in candidates:
+        if _spec_semantics_ok(sprite_mask, occ, motion, panel_count):
+            return occ
+    return None
+
+
+def _sample_sprite(interior_shape: tuple[int, int], motion: tuple[int, int], panel_count: int) -> np.ndarray | None:
+    ih, iw = interior_shape
