+is_contiguous = _ARC_UTILS.is_contiguous
+paste = _ARC_UTILS.paste
+
+
+GEN_ATTEMPTS = 500
+PANEL_COUNTS = (3, 4)
+INTERIOR_HEIGHTS = (7, 8, 9, 10, 11, 12)
+INTERIOR_WIDTHS = (5, 6)
+SPRITE_HEIGHTS = (3, 4)
+SPRITE_WIDTHS = (3, 4)
+OCCLUDER_SIZES = ((2, 2), (2, 3), (3, 2))
+MOTIONS = [
+    (-2, 0),
+    (-1, -1),
+    (-1, 0),
+    (-1, 1),
+    (0, -1),
+    (0, 1),
+    (1, -1),
