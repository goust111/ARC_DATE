+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        pair = _build_candidate()
+        if pair is not None:
+            return pair[0]
+    raise RuntimeError("failed to generate valid occluded-frame extrapolation input")

