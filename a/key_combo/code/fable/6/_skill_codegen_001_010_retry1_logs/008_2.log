+    donor_quad = rng.choice(donor_quad_choices)
+
+    donor_sub = (rng.randrange(2), rng.randrange(2))
+    red_sub_choices = [sub for sub in ((0, 0), (0, 1), (1, 0), (1, 1)) if sub != donor_sub]
