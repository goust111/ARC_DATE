+    del r1, c1
+    quarter_h, quarter_w = shape[0] // 4, shape[1] // 4
+    sub_r = 0 if int(r) < r0 + quarter_h else 1
+    sub_c = 0 if int(c) < c0 + quarter_w else 1
+    return sub_r, sub_c
