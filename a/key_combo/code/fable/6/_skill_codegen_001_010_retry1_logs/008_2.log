+def _pick_red_and_donor(
+    rng: random.Random,
+    shape: tuple[int, int],
+    red_quad: tuple[int, int],
+    red_sub: tuple[int, int],
+    donor_quad: tuple[int, int],
+    donor_sub: tuple[int, int],
