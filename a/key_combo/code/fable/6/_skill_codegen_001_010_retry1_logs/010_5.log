def _gen_path(mask: np.ndarray, a: tuple[int, int], b: tuple[int, int]) -> None:
    r, c = a
    tr, tc = b
    if random.random() < PATH_VERTICAL_FIRST_PROBABILITY:
        while r != tr:
            mask[r, c] = True
            r += 1 if tr > r else -1
        while c != tc:
            mask[r, c] = True
            c += 1 if tc > c else -1
    else:
        while c != tc:
            mask[r, c] = True
            c += 1 if tc > c else -1
        while r != tr:
            mask[r, c] = True
            r += 1 if tr > r else -1
    mask[tr, tc] = True


def _gen_orbit(side: int, r: int, c: int) -> set[tuple[int, int]]:
    last = side - 1
    return {
        (r, c),
        (c, r),
        (last - r, c),
        (r, last - c),
        (last - r, last - c),
        (last - c, last - r),
        (c, last - r),
        (last - c, r),
    }


