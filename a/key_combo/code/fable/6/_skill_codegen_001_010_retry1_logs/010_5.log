+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+HOLE = 0
+PALETTE = tuple(range(1, 10))
+GRID_HEIGHT_RANGE = (5, 10)
+GRID_WIDTH_RANGE = (6, 12)
+PERIOD_RANGE = (4, 9)
+HOLE_COUNT_RANGE = (3, 7)
+GENERATION_RETRIES = 500
+
