+import random
+from collections import Counter
+
+import numpy as np
+
+
+BACKGROUND = 0
+MAX_GEN_ATTEMPTS = 400
+COPY_COUNT_RANGE = (3, 5)
+SPRITE_H_RANGE = (4, 6)
+SPRITE_W_RANGE = (4, 6)
+CANVAS_H_RANGE = (18, 30)
+CANVAS_W_RANGE = (18, 30)
+FRAME_PAD = 1
+FRAME_INNER_GAP = 1
+PLACEMENT_MARGIN = 1
+CORNERS = ("tl", "tr", "bl", "br")
+PALETTE = [1, 2, 3, 4, 5, 6, 7, 8, 9]
+
