+    sprite_h = random.randint(*SPRITE_H_RANGE)
+    sprite_w = random.randint(*SPRITE_W_RANGE)
+    if sprite_h == sprite_w:
+        return None
+    sprite = _random_sprite(sprite_h, sprite_w, sprite_colors)
