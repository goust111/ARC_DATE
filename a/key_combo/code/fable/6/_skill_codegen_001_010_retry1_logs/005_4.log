+        patch = rendered_patches[idx]
+        box = _try_place_box(H, W, patch.shape[0], patch.shape[1], used_boxes)
+        if box is None:
+            return None
+        used_boxes.append(box)
+        _paint_rect_patch(grid, box, patch)
