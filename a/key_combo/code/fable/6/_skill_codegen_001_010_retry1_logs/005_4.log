+    for _ in range(160):
+        hidden = [np.zeros((h, w), dtype=bool) for _ in range(copy_count)]
+        for i in range(copy_count):
+            for j in range(copy_count):
+                if i != j:
+                    hidden[j] |= anchors[i]
+        for j in range(copy_count):
