+            patch = None
+            for _room_try in range(40):
+                ih = rng.randint(min_side, max_side)
+                iw = rng.randint(min_side, max_side)
+                patch = room_patch(ih, iw, wall_color, marker_colors[i], obstacle_flags[i], rng)
+                if patch is not None:
