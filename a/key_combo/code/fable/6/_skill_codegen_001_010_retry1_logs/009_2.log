+from __future__ import annotations
+
+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+GENERATE_ATTEMPTS = 400
