+            top, left = rng.choice(positions)
+            place_patch(grid, patch, top, left)
+            occupied[max(0, top - 1) : min(h, top + ph + 1), max(0, left - 1) : min(w, left + pw + 1)] = True
+            placed += 1
+
+        if placed != room_count:
+            continue
+        if validate_generated(grid):
+            return grid
