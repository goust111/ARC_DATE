+
+def _validate_scene(scene: dict[str, Any]) -> tuple[np.ndarray, np.ndarray]:
+    grid = _render_scene(scene)
+    bg = int(scene["bg"])
+    frames = _detect_frames(grid, bg)
+    markers = _detect_markers(grid, bg, frames)
+    assert len(frames) == 3
+    assert len(markers) == 4
