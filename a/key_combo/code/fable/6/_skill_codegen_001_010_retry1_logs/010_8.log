+    bboxes = []
+    c = left_margin
+    for idx, width in enumerate(widths):
+        bboxes.append((r0, c, r0 + h - 1, c + width - 1))
+        c += width
+        if idx == 0:
+            c += gap_ab
+        elif idx == 1:
+            c += gap_bc
+
+    rows = list(range(r0 + 1, r0 + h - 1))
+    if len(rows) < 5:
+        return None
+    rng.shuffle(rows)
+    role_rows = {
+        "fill_a": rows[0],
+        "spill_to_b": rows[1],
+        "drop_left": rows[2],
+        "fill_b": rows[3],
+        "fill_c": rows[4],
+    }
+
+    a = bboxes[0]
+    b = bboxes[1]
+    cbox = bboxes[2]
+
+    gap_ab_cols = list(range(a[3] + 1, b[1]))
+    gap_bc_cols = list(range(b[3] + 1, cbox[1]))
+    left_cols = list(range(0, a[1]))
+    right_cols = list(range(cbox[3] + 1, W))
+    if len(gap_ab_cols) < 2 or not gap_bc_cols or not left_cols or not right_cols:
+        return None
+
+    rng.shuffle(gap_ab_cols)
+    rng.shuffle(gap_bc_cols)
+    rng.shuffle(left_cols)
+    rng.shuffle(right_cols)
+
+    for x0 in gap_ab_cols:
+        for x1 in gap_ab_cols:
+            if x0 == x1:
+                continue
+            marker_positions = {
+                "fill_a": (role_rows["fill_a"], x0),
+                "spill_to_b": (role_rows["spill_to_b"], x1),
+            }
+            for xl in left_cols:
+                marker_positions["drop_left"] = (role_rows["drop_left"], xl)
+                for xb in gap_bc_cols:
+                    marker_positions["fill_b"] = (role_rows["fill_b"], xb)
+                    for xr in right_cols:
+                        marker_positions["fill_c"] = (role_rows["fill_c"], xr)
+                        temp_scene = _marker_roles_to_scene(
+                            H=H,
+                            W=W,
+                            bg=bg,
+                            frame_colors=frame_colors,
+                            dot_color=dot_color,
+                            marker_color=marker_color,
+                            bboxes=bboxes,
+                            marker_positions=marker_positions,
+                            dot_positions=[[], [], []],
+                        )
+                        temp_grid = _render_scene(temp_scene)
+                        frames = _detect_frames(temp_grid, bg)
+                        markers = _detect_markers(temp_grid, bg, frames)
+                        candidates = _all_candidates(temp_grid, bg, frames, markers)
+                        if len(markers) != 5 or len(candidates) != 7:
+                            continue
+                        dists = [int(cand["distance"]) for cand in candidates]
+                        if len(set(dists)) != len(dists):
+                            continue
+
+                        marker_names = [marker["name"] for marker in temp_scene["markers"]]
+                        name_to_idx = {name: idx for idx, name in enumerate(marker_names)}
+                        frame_names = [frame["name"] for frame in temp_scene["frames"]]
+                        frame_to_idx = {name: idx for idx, name in enumerate(frame_names)}
+
+                        blocked_inside: dict[int, set[tuple[int, int]]] = {0: set(), 1: set(), 2: set()}
+                        for cand in candidates:
+                            blocked_inside[int(cand["frame_idx"])].add(tuple(cand["inside"]))
+
+                        try:
+                            dot_positions = _choose_dot_positions(rng, bboxes, blocked_inside, quotas)
+                        except ValueError:
+                            continue
+
+                        scene = _marker_roles_to_scene(
+                            H=H,
+                            W=W,
+                            bg=bg,
+                            frame_colors=frame_colors,
+                            dot_color=dot_color,
+                            marker_color=marker_color,
+                            bboxes=bboxes,
+                            marker_positions=marker_positions,
+                            dot_positions=dot_positions,
+                        )
+                        grid = _render_scene(scene)
+                        frames = _detect_frames(grid, bg)
+                        markers = _detect_markers(grid, bg, frames)
+                        candidates = _all_candidates(grid, bg, frames, markers)
+                        if len(candidates) != 7:
+                            continue
+                        out, placements = _simulate_assignment(grid, frames, markers, candidates)
+
+                        marker_idx_to_name = {idx: marker["name"] for idx, marker in enumerate(scene["markers"])}
+                        frame_idx_to_name = {idx: frame["name"] for idx, frame in enumerate(scene["frames"])}
+                        named = {
+                            marker_idx_to_name[idx]: {
+                                **info,
+                                "frame": frame_idx_to_name[int(info["frame_idx"])],
+                            }
+                            for idx, info in placements.items()
+                        }
+
+                        if named["fill_a"]["frame"] != "A" or named["fill_a"]["mode"] != "inside":
+                            continue
+                        if named["spill_to_b"]["frame"] != "B" or named["spill_to_b"]["mode"] != "inside":
+                            continue
+                        if named["fill_b"]["frame"] != "B" or named["fill_b"]["mode"] != "inside":
+                            continue
+                        if named["fill_c"]["frame"] != "C" or named["fill_c"]["mode"] != "inside":
+                            continue
+                        if named["drop_left"]["mode"] != "dock" or named["drop_left"]["frame"] != "A":
+                            continue
+                        if named["spill_to_b"]["distance"] <= named["spill_to_b"]["nearest_distance"]:
+                            continue
+
+                        simple = _naive_nearest_only_output(grid, frames, markers, candidates)
+                        if np.array_equal(simple, out):
+                            continue
+
+                        all_dock_or_inside = [tuple(info["pos"]) for info in placements.values()]
+                        if len(set(all_dock_or_inside)) != len(all_dock_or_inside):
+                            continue
+
+                        return scene
+    return None
+
+
+def _validate_scene(scene: dict[str, Any]) -> tuple[np.ndarray, np.ndarray]:
+    grid = _render_scene(scene)
+    bg = int(scene["bg"])
+    frames = _detect_frames(grid, bg)
+    markers = _detect_markers(grid, bg, frames)
+    assert len(frames) >= 2
+    assert len(markers) == 5
+    assert sum(int(frame["quota"]) for frame in frames) == 4
+
+    candidates = _all_candidates(grid, bg, frames, markers)
+    assert all(np.max(grid.shape) <= 30 for _ in [0])
+    assert len(candidates) == 7
+    dists = [int(cand["distance"]) for cand in candidates]
+    assert len(set(dists)) == len(dists)
+
+    per_marker: dict[int, list[dict[str, Any]]] = {i: [] for i in range(len(markers))}
+    for cand in candidates:
+        per_marker[int(cand["marker_idx"])].append(cand)
+    assert any(len(v) > 1 for v in per_marker.values())
+
+    out, placements = _simulate_assignment(grid, frames, markers, candidates)
+    assert out.ndim == 2 and max(out.shape) <= 30
+
+    reassigned = [
+        info
+        for info in placements.values()
+        if info["mode"] == "inside" and info["distance"] > info["nearest_distance"]
+    ]
+    parked = [info for info in placements.values() if info["mode"] == "dock"]
+    assert reassigned, "must contain at least one farther-frame absorption"
+    assert parked, "must contain at least one unassigned parked marker"
+
+    naive = _naive_nearest_only_output(grid, frames, markers, candidates)
+    assert not np.array_equal(naive, out), "quota-skipping retry step must matter"
+
+    solved = main(grid)
+    assert np.array_equal(solved, out)
+    return grid, out
+
+
+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(600):
+        scene = _search_canonical_scene(rng)
+        if scene is None:
+            continue
+        grid, out = _validate_scene(scene)
+        k = int(rng.integers(0, 4))
+        if k:
+            grid = np.rot90(grid, k)
+            out = np.rot90(out, k)
+        assert np.array_equal(main(grid), out)
+        return grid
+    raise RuntimeError("failed to generate a valid scene")

