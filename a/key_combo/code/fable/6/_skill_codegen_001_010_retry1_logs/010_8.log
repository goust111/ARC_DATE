+
+def _all_candidates(
+    grid: np.ndarray,
+    bg: int,
+    frames: list[dict[str, Any]],
+    markers: list[dict[str, Any]],
+) -> list[dict[str, Any]]:
+    out: list[dict[str, Any]] = []
+    for mi, marker in enumerate(markers):
+        for fi, frame in enumerate(frames):
+            cand = _candidate_for_pair(grid, bg, marker, frame)
