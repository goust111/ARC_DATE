+
+    candidates = _all_candidates(grid, bg, frames, markers)
+    assert max(grid.shape) <= 30
+    assert len(candidates) == 6
+    dists = [int(cand["distance"]) for cand in candidates]
+    assert len(set(dists)) == len(dists)
