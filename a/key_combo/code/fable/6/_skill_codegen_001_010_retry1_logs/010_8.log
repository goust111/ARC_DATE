+        r, c = marker["pos"]
+        grid[r, c] = int(scene["marker_color"])
+    return grid
+
+
+def _marker_roles_to_scene(
+    H: int,
+    W: int,
+    bg: int,
+    frame_colors: list[int],
+    dot_color: int,
+    marker_color: int,
+    bboxes: list[tuple[int, int, int, int]],
