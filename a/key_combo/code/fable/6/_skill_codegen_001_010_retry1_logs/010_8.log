+def _detect_markers(grid: np.ndarray, bg: int, frames: list[dict[str, Any]]) -> list[dict[str, Any]]:
+    markers: list[dict[str, Any]] = []
+    for r, c in np.argwhere(grid != bg):
+        rr = int(r)
+        cc = int(c)
+        if _outside_all_bboxes((rr, cc), frames):
