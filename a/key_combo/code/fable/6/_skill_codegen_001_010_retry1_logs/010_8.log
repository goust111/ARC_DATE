+        distance = int(r0 + 1 - r)
+    elif c0 < c < c1 and r > r1 and np.all(grid[r1 + 1 : r, c] == bg):
+        inside = (r1 - 1, c)
+        dock = (r1 + 1, c)
+        side = "D"
+        distance = int(r - (r1 - 1))
