+        "fill_a": rows[0],
+        "spill_to_b": rows[1],
+        "drop_left": rows[2],
+        "fill_b": rows[3],
+        "fill_c": rows[4],
+    }
+
+    a = bboxes[0]
+    b = bboxes[1]
+    cbox = bboxes[2]
+
+    gap_ab_cols = list(range(a[3] + 1, b[1]))
+    gap_bc_cols = list(range(b[3] + 1, cbox[1]))
+    left_cols = list(range(0, a[1]))
+    right_cols = list(range(cbox[3] + 1, W))
+    if len(gap_ab_cols) < 2 or not gap_bc_cols or not left_cols or not right_cols:
+        return None
+
+    rng.shuffle(gap_ab_cols)
+    rng.shuffle(gap_bc_cols)
+    rng.shuffle(left_cols)
+    rng.shuffle(right_cols)
+
+    for x0 in gap_ab_cols:
+        for x1 in gap_ab_cols:
+            if x0 == x1:
+                continue
+            marker_positions = {
+                "fill_a": (role_rows["fill_a"], x0),
+                "spill_to_b": (role_rows["spill_to_b"], x1),
+            }
+            for xl in left_cols:
+                marker_positions["drop_left"] = (role_rows["drop_left"], xl)
+                for xb in gap_bc_cols:
+                    marker_positions["fill_b"] = (role_rows["fill_b"], xb)
+                    for xr in right_cols:
+                        marker_positions["fill_c"] = (role_rows["fill_c"], xr)
+                        temp_scene = _marker_roles_to_scene(
+                            H=H,
+                            W=W,
+                            bg=bg,
+                            frame_colors=frame_colors,
+                            dot_color=dot_color,
+                            marker_color=marker_color,
+                            bboxes=bboxes,
+                            marker_positions=marker_positions,
+                            dot_positions=[[], [], []],
+                        )
+                        temp_grid = _render_scene(temp_scene)
+                        frames = _detect_frames(temp_grid, bg)
+                        markers = _detect_markers(temp_grid, bg, frames)
+                        candidates = _all_candidates(temp_grid, bg, frames, markers)
+                        if len(markers) != 5 or len(candidates) != 7:
+                            continue
+                        dists = [int(cand["distance"]) for cand in candidates]
+                        if len(set(dists)) != len(dists):
+                            continue
+
+                        blocked_inside: dict[int, set[tuple[int, int]]] = {0: set(), 1: set(), 2: set()}
+                        for cand in candidates:
+                            blocked_inside[int(cand["frame_idx"])].add(tuple(cand["inside"]))
+
+                        try:
+                            dot_positions = _choose_dot_positions(rng, bboxes, blocked_inside, quotas)
+                        except ValueError:
+                            continue
+
+                        scene = _marker_roles_to_scene(
+                            H=H,
+                            W=W,
