+
+def _choose_dot_positions(
+    rng: np.random.Generator,
+    bboxes: list[tuple[int, int, int, int]],
+    blocked_inside: dict[int, set[tuple[int, int]]],
+    quotas: list[int],
+) -> list[list[tuple[int, int]]]:
