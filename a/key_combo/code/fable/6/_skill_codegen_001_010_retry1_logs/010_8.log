+    for mi, marker in enumerate(markers):
+        for fi, frame in enumerate(frames):
+            cand = _candidate_for_pair(grid, bg, marker, frame)
+            if cand is None:
+                continue
+            cand["marker_idx"] = mi
+            cand["frame_idx"] = fi
+            out.append(cand)
+    out.sort(key=lambda cand: (cand["distance"], cand["marker_idx"], cand["frame_idx"]))
+    return out
