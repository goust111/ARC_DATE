+        "W": W,
+        "bg": int(bg),
+        "dot_color": int(dot_color),
+        "marker_color": int(marker_color),
+        "frames": frames,
+        "markers": markers,
+    }
+
+
+def _naive_nearest_only_output(
+    grid: np.ndarray,
+    frames: list[dict[str, Any]],
+    markers: list[dict[str, Any]],
+    candidates: list[dict[str, Any]],
+) -> np.ndarray:
