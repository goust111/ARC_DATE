+    per_marker: dict[int, list[dict[str, Any]]] = {i: [] for i in range(len(markers))}
+    for cand in candidates:
+        per_marker[int(cand["marker_idx"])].append(cand)
+    assert any(len(v) > 1 for v in per_marker.values())
