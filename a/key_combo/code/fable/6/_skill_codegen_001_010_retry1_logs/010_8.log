+    g = np.asarray(grid, dtype=int)
+    bg = int(get_bg(g))
+    frames = _detect_frames(g, bg)
+    markers = _detect_markers(g, bg, frames)
+    candidates = _all_candidates(g, bg, frames, markers)
+    out, _placements = _simulate_assignment(g, frames, markers, candidates)
+    return out
