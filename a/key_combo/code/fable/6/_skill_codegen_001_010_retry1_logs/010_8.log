+    frames = _detect_frames(temp_grid, bg)
+    markers = _detect_markers(temp_grid, bg, frames)
+    candidates = _all_candidates(temp_grid, bg, frames, markers)
+    if len(markers) != 4 or len(candidates) != 6:
