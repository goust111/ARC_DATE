+        distance = int(c - (c1 - 1))
+    elif c0 < c < c1 and r < r0 and np.all(grid[r + 1 : r0, c] == bg):
+        inside = (r0 + 1, c)
+        dock = (r0 - 1, c)
+        side = "U"
+        distance = int(r0 + 1 - r)
+    elif c0 < c < c1 and r > r1 and np.all(grid[r1 + 1 : r, c] == bg):
+        inside = (r1 - 1, c)
+        dock = (r1 + 1, c)
+        side = "D"
+        distance = int(r - (r1 - 1))
+    else:
+        return None
+
+    H, W = grid.shape
+    ir, ic = inside
+    dr, dc = dock
+    if not (0 <= ir < H and 0 <= ic < W and 0 <= dr < H and 0 <= dc < W):
+        return None
+    if int(grid[ir, ic]) != int(bg):
+        return None
+    if (dr, dc) != (r, c) and int(grid[dr, dc]) != int(bg):
+        return None
+    return {
+        "distance": distance,
+        "inside": inside,
+        "dock": dock,
+        "side": side,
+    }
