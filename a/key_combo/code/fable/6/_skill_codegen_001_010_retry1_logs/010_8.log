+
+
+def _search_canonical_scene(rng: np.random.Generator) -> dict[str, Any] | None:
+    bg = 0
+    palette = list(range(1, 10))
+    rng.shuffle(palette)
+    frame_colors = palette[:3]
+    dot_color = palette[3]
+    marker_color = palette[4]
+    quotas = [1, 1, 1]
+
+    h = int(rng.integers(6, 9))
+    widths = [4, 4, 4]
+    left_margin = 2
+    right_margin = int(rng.integers(1, 3))
