+
+    r0 = top_margin
+    a = (r0, left_margin, r0 + h - 1, left_margin + widths[0] - 1)
+    b = (r0, a[3] + 1 + gap_ab, r0 + h - 1, a[3] + gap_ab + widths[1])
+    cbox = (r0, b[3] + 1 + gap_bc, r0 + h - 1, b[3] + gap_bc + widths[2])
