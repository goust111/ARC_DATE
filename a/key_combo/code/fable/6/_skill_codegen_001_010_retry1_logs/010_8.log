+    r, c = marker["pos"]
+    r0, c0, r1, c1 = frame["bbox"]
+    inside: tuple[int, int]
+    dock: tuple[int, int]
+    side: str
+    distance: int
+
+    if r0 < r < r1 and c < c0 and np.all(grid[r, c + 1 : c0] == bg):
+        inside = (r, c0 + 1)
+        dock = (r, c0 - 1)
