+        distance = int(c0 + 1 - c)
+    elif r0 < r < r1 and c > c1 and np.all(grid[r, c1 + 1 : c] == bg):
+        inside = (r, c1 - 1)
+        dock = (r, c1 + 1)
+        side = "R"
+        distance = int(c - (c1 - 1))
+    elif c0 < c < c1 and r < r0 and np.all(grid[r + 1 : r0, c] == bg):
