+        remaining[fi] -= 1
+        placements[mi] = {
+            "mode": "inside",
+            "pos": tuple(cand["inside"]),
+            "color": int(frames[fi]["color"]),
+            "frame_idx": fi,
+            "distance": int(cand["distance"]),
+            "nearest_distance": int(per_marker[mi][0]["distance"]),
