+        inside = (r, c0 + 1)
+        dock = (r, c0 - 1)
+        side = "L"
+        distance = int(c0 + 1 - c)
+    elif r0 < r < r1 and c > c1 and np.all(grid[r, c1 + 1 : c] == bg):
