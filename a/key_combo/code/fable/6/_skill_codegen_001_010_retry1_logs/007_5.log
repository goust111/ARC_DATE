+def _placement_data(piece: dict, H: int, W: int) -> list[dict]:
+    data = []
+    for r0 in range(H - int(piece["h"]) + 1):
+        for c0 in range(W - int(piece["w"]) + 1):
+            cells = tuple((r0 + dr, c0 + dc) for dr, dc in piece["coords"])
