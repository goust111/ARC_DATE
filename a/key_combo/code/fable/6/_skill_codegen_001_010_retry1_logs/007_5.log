+        *_extract_state(canvas),
+        enforce_symmetry=True,
+        enforce_no_touch=False,
+        limit=2,
+    )
+    if len(relaxed_solutions) < 2:
+        return None
+
+    return canvas.astype(int), out.astype(int)
+
