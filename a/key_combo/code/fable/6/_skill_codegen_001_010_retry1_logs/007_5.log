+        def place(pi: int, placement: dict) -> tuple[list[tuple[int, int]], list[tuple[int, int]]]:
+            piece = pieces[pi]
+            col = int(piece["color"])
+            changed: list[tuple[int, int]] = []
+            used: list[tuple[int, int]] = []
+            for r, c in placement["cells"]:
+                if board[r, c] == -1:
+                    board[r, c] = col
+                    changed.append((r, c))
+                occupied[r, c] = True
+                used.append((r, c))
