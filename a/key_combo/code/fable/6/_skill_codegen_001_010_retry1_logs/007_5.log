+def _assign_group_colors(groups: list[int], graph: dict[int, set[int]], n_colors: int) -> dict[int, int] | None:
+    order = sorted(groups, key=lambda g: (-len(graph[g]), int(g)))
+    color_of: dict[int, int] = {}
+    use_count = Counter()
