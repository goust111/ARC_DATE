+
+def _factor_pairs(area: int) -> list[tuple[int, int]]:
+    dims = []
+    for h in range(1, min(area, 30) + 1):
+        if area % h != 0:
+            continue
+        w = area // h
+        if w <= 30:
+            dims.append((h, w))
+    dims.sort(key=lambda hw: (abs(hw[0] - hw[1]), hw[0], hw[1]))
+    return dims
