+            for r, c in full:
+                owner[r, c] = piece_id
+            pieces.append(
+                {
+                    "id": piece_id,
+                    "group": int(lab),
+                    "side": "center",
+                    "coords": tuple(sorted(full)),
+                }
+            )
+        else:
+            left_id = len(pieces)
+            right_id = left_id + 1
+            right_cells = {(r, W - 1 - c) for r, c in left_cells}
+            for r, c in left_cells:
+                owner[r, c] = left_id
+            for r, c in right_cells:
+                owner[r, c] = right_id
+            pieces.append(
