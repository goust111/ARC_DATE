+def _normalize(coords: list[tuple[int, int]] | set[tuple[int, int]] | tuple[tuple[int, int], ...]) -> tuple[int, int, tuple[tuple[int, int], ...]]:
+    pts = np.array(sorted((int(r), int(c)) for r, c in coords), dtype=int)
