+    pieces: list[dict] = []
+    multicolor_count = 0
+
+    for comp_id, comp in enumerate(comps):
+        coords = comp["coords"]
+        vals = [int(g[int(r), int(c)]) for r, c in coords]
+        counts = Counter(vals)
+        colors = sorted(counts)
+        r0, c0, r1, c1 = map(int, comp["bbox"])
+        rel_all = tuple(sorted((int(r) - r0, int(c) - c0) for r, c in coords))
