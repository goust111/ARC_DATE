+        return False
+    if any(np.array_equal(template, np.rot90(template, k)) for k in (1, 2, 3)):
+        return False
+
+    ref_rot = int(rotations[marker_idx])
+    aligned_tiles = []
+    for mask in masks:
+        fragment = np.where(mask, template, int(bg))
+        aligned_tiles.append(np.rot90(fragment, ref_rot))
