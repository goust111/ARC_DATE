+
+def _semantic_checks(
+    template: np.ndarray,
+    masks: list[np.ndarray],
+    rotations: list[int],
+    marker_idx: int,
+    expected: np.ndarray,
+    bg: int,
+) -> bool:
+    if len(set(map(int, rotations))) < 2:
+        return False
+    if any(np.array_equal(template, np.rot90(template, k)) for k in (1, 2, 3)):
+        return False
+
+    aligned_tiles = []
+    for idx, mask in enumerate(masks):
+        fragment = np.where(mask, template, int(bg))
+        aligned_tiles.append(np.rot90(np.rot90(fragment, int(rotations[idx])), -int(rotations[marker_idx])))
