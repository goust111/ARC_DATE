+        [i for i in range(len(tiles)) if i != int(marker_idx)],
+        key=lambda i: -int(np.count_nonzero(tiles[i] != int(bg))),
+    )
+    states: dict[bytes, np.ndarray] = {tiles[int(marker_idx)].tobytes(): tiles[int(marker_idx)].copy()}
