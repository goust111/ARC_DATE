+
+    return None
+
+
+def _build_input(
+    template: np.ndarray,
+    bg: int,
+    sep: int,
+    tile_rows: int,
+    tile_cols: int,
+    rotations: list[int],
+    marker_idx: int,
+    marker_corner: tuple[int, int],
+    masks: list[np.ndarray],
+) -> tuple[np.ndarray, list[np.ndarray]]:
