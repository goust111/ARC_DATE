+def _place_template(
+    grid: np.ndarray, template: np.ndarray, blocked_boxes: list[tuple[int, int, int, int]]
+) -> tuple[int, int] | None:
+    h, w = grid.shape
+    th, tw = template.shape
+    candidates = []
+    for r0 in range(1, h - th):
+        for c0 in range(1, w - tw):
