+def _render_border(
+    shape: tuple[int, int], colors: tuple[int, int], pattern_bits: tuple[int, ...]
+) -> tuple[np.ndarray, list[tuple[int, int]], list[int]]:
+    h, w = shape
+    grid = np.zeros((h, w), dtype=int)
+    coords = _border_coords(h, w)
+    seq = []
+    for i, (r, c) in enumerate(coords):
