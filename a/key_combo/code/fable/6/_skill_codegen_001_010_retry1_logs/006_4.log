+        w = random.choice([3, 5])
+        target_area = random.randint(max(5, (h + w) // 2), min(h * w - 1, 10))
+        coords = {(h // 2, w // 2)}
+        while len(coords) < target_area:
+            frontier = []
+            for r, c in coords:
