+from __future__ import annotations
+
+import random
+from collections import Counter
+from typing import Iterable
+
+import numpy as np
+
+
+DIRS = {
+    "U": (-1, 0),
+    "D": (1, 0),
+    "L": (0, -1),
+    "R": (0, 1),
+}
+DIR_FROM_DELTA = {v: k for k, v in DIRS.items()}
+SIDES = ("U", "D", "L", "R")
+PALETTE = list(range(10))
+GEN_RETRIES = 400
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.flat)).most_common(1)[0][0])
+
+
+def _bbox(coords: Iterable[tuple[int, int]]) -> tuple[int, int, int, int]:
+    pts = list(coords)
+    rs = [r for r, _ in pts]
+    cs = [c for _, c in pts]
+    return min(rs), min(cs), max(rs), max(cs)
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _components_of_color(grid: np.ndarray, color: int, region: tuple[int, int, int, int] | None = None) -> list[list[tuple[int, int]]]:
+    if region is None:
+        r0, c0, r1, c1 = 0, 0, grid.shape[0] - 1, grid.shape[1] - 1
+    else:
+        r0, c0, r1, c1 = region
+    seen: set[tuple[int, int]] = set()
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(r0, r1 + 1):
+        for c in range(c0, c1 + 1):
+            if int(grid[r, c]) != int(color) or (r, c) in seen:
+                continue
+            stack = [(r, c)]
+            seen.add((r, c))
+            comp: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                comp.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if not (r0 <= nr <= r1 and c0 <= nc <= c1):
+                        continue
+                    if (nr, nc) in seen or int(grid[nr, nc]) != int(color):
+                        continue
+                    seen.add((nr, nc))
+                    stack.append((nr, nc))
+            comps.append(comp)
+    return comps
