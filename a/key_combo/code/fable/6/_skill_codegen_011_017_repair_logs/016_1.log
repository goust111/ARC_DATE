   146	    if any(int(clean[r, c]) != int(bg_phase) for r, c in coord_set):
   147	        return None
   148	
   149	    rows = {r for r, _c in coord_set}
   150	    cols = {c for _r, c in coord_set}
   151	    downs = {r - c for r, c in coord_set}
   152	    ups = {r + c for r, c in coord_set}
   153	
   154	    candidates: list[dict] = []
   155	    if len(rows) == 1:
   156	        candidates.append(_build_line(clean.shape, "row", next(iter(rows)), color, bg_phase, clean))
   157	    if len(cols) == 1:
   158	        candidates.append(_build_line(clean.shape, "col", next(iter(cols)), color, bg_phase, clean))
   159	    if len(downs) == 1:
   160	        candidates.append(_build_line(clean.shape, "diag_down", next(iter(downs)), color, bg_phase, clean))
   161	    if len(ups) == 1:
   162	        candidates.append(_build_line(clean.shape, "diag_up", next(iter(ups)), color, bg_phase, clean))
   163	
   164	    valid = []
   165	    for line in candidates:
   166	        if len(line["cells"]) < 2:
   167	            continue
   168	        if coord_set.issubset(line["bg_cell_set"]):
