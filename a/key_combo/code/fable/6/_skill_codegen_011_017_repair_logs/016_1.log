   201	
   202	def _solve_case(grid: np.ndarray) -> tuple[np.ndarray, dict[int, dict], tuple[int, ...]]:
   203	    g = np.asarray(grid, dtype=int)
   204	    assert g.ndim == 2, "expected a 2D ARC grid"
   205	
   206	    clean, texture_colors, bg_phase = _infer_texture(g)
   207	    non_texture_colors = colors_present(g, exclude=texture_colors)
   208	    assert non_texture_colors, "expected at least one non-texture color"
   209	
   210	    coords_by_color = {
   211	        int(color): [tuple(map(int, rc)) for rc in np.argwhere(g == int(color))]
   212	        for color in non_texture_colors
   213	    }
   214	    line_guess = {
   215	        int(color): _infer_line_for_color(coords, clean, bg_phase, int(color))
   216	        for color, coords in coords_by_color.items()
   217	    }
   218	
   219	    best_solution: tuple[tuple[int, int, int], np.ndarray, dict[int, dict], tuple[int, ...]] | None = None
   220	
   221	    noise_options: list[int | None] = [None, *non_texture_colors]
   222	    for noise_color in noise_options:
   223	        active_colors = [int(c) for c in non_texture_colors if int(c) != int(noise_color or -1)]
   224	        if not active_colors:
   225	            continue
   226	        if any(line_guess[c] is None for c in active_colors):
   227	            continue
   228	
   229	        lines = {c: line_guess[c] for c in active_colors}
   230	        assert all(line is not None for line in lines.values())
   231	        lines = {c: line for c, line in lines.items() if line is not None}
   232	
   233	        edge_set: set[tuple[int, int]] = set()
   234	        valid = True
   235	        for r, c in np.argwhere(clean == int(bg_phase)):
   236	            rr = int(r)
   237	            cc = int(c)
   238	            covering = [color for color, line in lines.items() if (rr, cc) in line["bg_cell_set"]]
   239	            if len(covering) < 2:
   240	                continue
   241	            observed = int(g[rr, cc])
   242	            if observed not in covering:
   243	                valid = False
   244	                break
   245	            for lower in covering:
   246	                if int(lower) != int(observed):
   247	                    edge_set.add((int(lower), int(observed)))
   248	        if not valid:
   249	            continue
   250	
   251	        accepted_order: tuple[int, ...] | None = None
   252	        for order in itertools.permutations(active_colors):
   253	            order_index = {int(color): idx for idx, color in enumerate(order)}
   254	            if any(order_index[a] >= order_index[b] for a, b in edge_set):
   255	                continue
   256	
   257	            simulated = _simulate_hidden_input(clean, bg_phase, lines, order)
   258	            if noise_color is None:
   259	                if np.array_equal(simulated, g):
   260	                    accepted_order = tuple(map(int, order))
   261	                    break
   262	                continue
   263	
   264	            noise_mask = g == int(noise_color)
   265	            if not noise_mask.any():
   266	                continue
   267	            if not np.all(clean[noise_mask] == int(bg_phase)):
   268	                continue
   269	            if not np.array_equal(simulated[~noise_mask], g[~noise_mask]):
   270	                continue
   271	            if not np.all(simulated[noise_mask] == clean[noise_mask]):
   272	                continue
   273	            accepted_order = tuple(map(int, order))
   274	            break
   275	
   276	        if accepted_order is None:
   277	            continue
   278	
   279	        output = _render_output(clean, lines, accepted_order)
   280	        score = (-len(active_colors), 0 if noise_color is None else 1, -len(edge_set))
   281	        if best_solution is None or score < best_solution[0]:
   282	            best_solution = (score, output, lines, accepted_order)
   283	
   284	    assert best_solution is not None, "failed to reconstruct a valid line configuration"
   285	    _score, output, lines, order = best_solution
   286	    return output, lines, order
   287	
   288	
   289	def main(input_grid: np.ndarray) -> np.ndarray:
   290	    """
   291	    Recover complete hidden straight lines from periodic-texture samples.
   292	
   293	    Input structure:
   294	    - A full grid is tiled by a small two-color periodic texture.
   295	    - Non-texture colors appear only on one texture phase, mostly as visible samples of hidden full lines.
   296	    - Each true line color belongs to exactly one horizontal, vertical, or 45-degree full-grid line.
   297	
   298	    Rule:
   299	    - Infer the clean minimal-period texture.
   300	    - Treat a non-texture color as a hidden line iff all of its visible pixels fit one valid full line.
   301	    - Restore any remaining non-line color as texture noise.
   302	    - Draw the recovered full lines on top of the clean texture, using visible intersections to determine stacking order.
   303	
   304	    Key insight:
   305	    - The texture is a visibility mask: the observed colored dots are not arbitrary noise, but samples of longer lines seen only through one periodic phase.
   306	    """
   307	    output, _lines, _order = _solve_case(np.asarray(input_grid, dtype=int))
   308	    return output
   309	
   310	
   311	def _is_exact_period(tile: np.ndarray, ph: int, pw: int) -> bool:
   312	    h, w = map(int, tile.shape)
   313	    if h % int(ph) != 0 or w % int(pw) != 0:
   314	        return False
   315	    base = tile[:ph, :pw]
   316	    return np.array_equal(tile, _tile_grid(base, (h, w)))
   317	
   318	
   319	def _minimal_period(tile: np.ndarray) -> tuple[int, int]:
   320	    h, w = map(int, tile.shape)
   321	    for ph in range(1, h + 1):
   322	        if h % ph != 0:
   323	            continue
   324	        for pw in range(1, w + 1):
   325	            if w % pw != 0:
   326	                continue
   327	            if _is_exact_period(tile, ph, pw):
   328	                return int(ph), int(pw)
   329	    raise AssertionError("unreachable")
   330	
   331	
   332	def _sample_texture_tile(ph: int, pw: int, hole_color: int, solid_color: int) -> np.ndarray:
   333	    area = int(ph * pw)
   334	    min_holes = max(1, area // 3)
   335	    max_holes = min(area - 1, area - area // 3)
   336	    for _ in range(200):
   337	        tile = np.full((ph, pw), int(solid_color), dtype=int)
   338	        hole_count = random.randint(min_holes, max_holes)
   339	        indices = random.sample(range(area), k=hole_count)
   340	        for idx in indices:
   341	            tile.flat[int(idx)] = int(hole_color)
   342	        if len(set(map(int, tile.flatten()))) != 2:
   343	            continue
   344	        if _minimal_period(tile) != (int(ph), int(pw)):
   345	            continue
   346	        return tile
   347	    raise RuntimeError("failed to sample a minimal-period texture tile")
   348	
   349	
   350	def _candidate_generator_lines(clean: np.ndarray, bg_phase: int) -> list[dict]:
   351	    H, W = map(int, clean.shape)
   352	    candidates: list[dict] = []
   353	    for r in range(H):
   354	        line = _build_line(clean.shape, "row", r, -1, bg_phase, clean)
   355	        if len(line["bg_cells"]) >= 4:
   356	            candidates.append(line)
   357	    for c in range(W):
   358	        line = _build_line(clean.shape, "col", c, -1, bg_phase, clean)
   359	        if len(line["bg_cells"]) >= 4:
   360	            candidates.append(line)
   361	    for d in range(-(W - 1), H):
   362	        line = _build_line(clean.shape, "diag_down", d, -1, bg_phase, clean)
   363	        if len(line["bg_cells"]) >= 4:
   364	            candidates.append(line)
   365	    for s in range(H + W - 1):
   366	        line = _build_line(clean.shape, "diag_up", s, -1, bg_phase, clean)
   367	        if len(line["bg_cells"]) >= 4:
   368	            candidates.append(line)
   369	    return candidates
   370	
   371	
   372	def _pairwise_intersection(a: dict, b: dict) -> tuple[int, int] | None:
   373	    inter = a["cell_set"] & b["cell_set"]
   374	    if len(inter) != 1:
   375	        return None
   376	    return next(iter(inter))
   377	
   378	
   379	def _valid_line_combo(clean: np.ndarray, bg_phase: int, lines: list[dict]) -> bool:
   380	    intersections: list[tuple[int, int]] = []
   381	    for a, b in itertools.combinations(lines, 2):
   382	        inter = _pairwise_intersection(a, b)
   383	        if inter is None:
   384	            return False
   385	        if int(clean[inter]) != int(bg_phase):
   386	            return False
   387	        intersections.append(inter)
   388	    return len(intersections) == len(set(intersections))
   389	
   390	
   391	def _visible_counts(clean: np.ndarray, bg_phase: int, lines: dict[int, dict], order: tuple[int, ...]) -> Counter:
   392	    sim = _simulate_hidden_input(clean, bg_phase, lines, order)
   393	    counts: Counter = Counter()
   394	    for color in order:
   395	        counts[int(color)] = int(np.count_nonzero(sim == int(color)))
   396	    for color in order:
   397	        counts[int(color)] -= int(np.count_nonzero(clean == int(color)))
   398	    return counts
   399	
   400	
   401	def _choose_line_combo(clean: np.ndarray, bg_phase: int, line_colors: list[int]) -> dict[int, dict] | None:
   402	    candidates = _candidate_generator_lines(clean, bg_phase)
   403	    random.shuffle(candidates)
   404	    target_size = len(line_colors)
   405	    for combo in itertools.combinations(candidates, target_size):
   406	        if not _valid_line_combo(clean, bg_phase, list(combo)):
   407	            continue
   408	        lines = {
   409	            int(color): _build_line(clean.shape, combo[idx]["kind"], combo[idx]["key"], color, bg_phase, clean)
   410	            for idx, color in enumerate(line_colors)
   411	        }
   412	        order = tuple(line_colors)
   413	        visible = _simulate_hidden_input(clean, bg_phase, lines, order)
   414	        ok = True
   415	        for color in line_colors:
   416	            count = int(np.count_nonzero(visible == int(color)))
   417	            if count < 2:
   418	                ok = False
   419	                break
   420	        if ok:
   421	            return lines
   422	    return None
