   174	
   175	def _simulate_hidden_input(
   176	    clean: np.ndarray,
   177	    bg_phase: int,
   178	    lines: dict[int, dict],
   179	    order: tuple[int, ...],
   180	) -> np.ndarray:
   181	    out = clean.copy()
   182	    order_index = {int(color): idx for idx, color in enumerate(order)}
   183	    visible: dict[tuple[int, int], int] = {}
   184	    for color, line in lines.items():
   185	        for cell in line["bg_cells"]:
   186	            prev = visible.get(cell)
   187	            if prev is None or order_index[int(color)] > order_index[int(prev)]:
   188	                visible[cell] = int(color)
   189	    for (r, c), color in visible.items():
   190	        out[r, c] = int(color)
   191	    return out
   192	
   193	
   194	def _render_output(clean: np.ndarray, lines: dict[int, dict], order: tuple[int, ...]) -> np.ndarray:
   195	    out = clean.copy()
   196	    for color in order:
   197	        for r, c in lines[int(color)]["cells"]:
   198	            out[r, c] = int(color)
   199	    return out
