+
+def _neighbors4(r: int, c: int):
+    for dr, dc in DIRS4:
+        yield r + dr, c + dc
+
+
+def _component_cells(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            comp = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(cells: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in cells]
+    cols = [c for _, c in cells]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _perimeter_cells(r0: int, c0: int, r1: int, c1: int) -> set[tuple[int, int]]:
+    cells = set()
+    for r in range(r0, r1 + 1):
+        cells.add((r, c0))
+        cells.add((r, c1))
+    for c in range(c0, c1 + 1):
+        cells.add((r0, c))
+        cells.add((r1, c))
+    return cells
+
+
+def _interior_cells(r0: int, c0: int, r1: int, c1: int) -> list[tuple[int, int]]:
+    return [(r, c) for r in range(r0 + 1, r1) for c in range(c0 + 1, c1)]
+
+
+def _gap_info(
+    r0: int,
+    c0: int,
+    r1: int,
+    c1: int,
+    missing: tuple[int, int] | None,
+) -> tuple[tuple[int, int], tuple[int, int]] | tuple[None, None]:
+    if missing is None:
+        return None, None
+    r, c = missing
+    if r == r0:
+        return missing, (-1, 0)
+    if r == r1:
+        return missing, (1, 0)
+    if c == c0:
+        return missing, (0, -1)
+    if c == c1:
+        return missing, (0, 1)
+    return None, None
+
+
+def _stack_cells(container: dict) -> list[tuple[int, int]]:
