        src_r1 = min(height, height - dr)
        dst_r0 = max(0, dr)
        dst_r1 = min(height, height + dr)
        for dc in range(-radius, radius + 1):
            src_c0 = max(0, -dc)
            src_c1 = min(width, width - dc)
            dst_c0 = max(0, dc)
            dst_c1 = min(width, width + dc)
            out[dst_r0:dst_r1, dst_c0:dst_c1] |= mask[src_r0:src_r1, src_c0:src_c1]
    return out


