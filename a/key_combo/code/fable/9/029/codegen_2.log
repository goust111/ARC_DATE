+    gap_dir = container["gap_dir"]
+    cells: list[tuple[int, int]] = []
+    if gap_dir == (-1, 0):
+        for r in range(r1 - 1, r0, -1):
+            for c in range(c0 + 1, c1):
+                cells.append((r, c))
+    elif gap_dir == (1, 0):
+        for r in range(r0 + 1, r1):
+            for c in range(c0 + 1, c1):
+                cells.append((r, c))
+    elif gap_dir == (0, -1):
