        return False
    if not (blue[0, :].any() and blue[-1, :].any() and blue[:, 0].any() and blue[:, -1].any()):
        return False
    return _gen_patch_is_connected(patch) and len(_gen_nonedge_bg_components(patch)) == 1


def _gen_distractor_patch_ok(patch):
