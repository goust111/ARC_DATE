+            return None
+        made = _make_leak_source(reserved, palette[color_idx])
+        color = palette[color_idx]
+        color_idx += 1
+        if made is None:
+            return None
+        item, _trail = made
+        items.append(item)
+        source_roles[color] = "leak"
+
+    for _ in range(closed_count):
+        if color_idx >= len(palette):
+            break
+        item = _make_closed_source(reserved, palette[color_idx])
+        color = palette[color_idx]
+        color_idx += 1
+        if item is None:
+            return None
+        items.append(item)
