        both=a&b; only_a=a&~b; only_b=(~a)&b; lit=(~a)&(~b)
        if min(map(np.count_nonzero,[both,only_a,only_b,lit])) < 2:
            continue
        # blocker diversity / visible structure
        if np.count_nonzero((top"'!=0)&(top!=YELLOW)) < 2 or np.count_nonzero((bottom!=0)&(bottom!=YELLOW)) < 2:
            continue
        out=np.where(both, TEAL, BLACK)
        if np.array_equal(out,a.astype(int)*TEAL) or np.array_equal(out,b.astype(int)*TEAL):
            continue
        g=np.vstack([top, np.full((1,w), sep, dtype=int), bottom])
        if not np.array_equal(main(g), out):
            continue
        return g,out
    return None,None

for i in range(100):
    g,o=choose_grid()
    assert g is not None
    out=main(g)
    assert np.array_equal(out,o)
