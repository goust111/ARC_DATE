        h_lengths=sample_lengths(h,w-2)
        if v_lengths is None or h_lengths is None:
            continue
        p_vert=render_panel(h,w,v_edge,c1,v_lengths)
        p_hori=render_panel(h,w,h_edge,c2,h_lengths)
        if vertical_panel==0:
