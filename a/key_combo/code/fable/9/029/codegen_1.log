    elif edge=='bottom':
        p[-1,:]=YELLOW
        for c,s in enumerate(lengths):
            if s>0:
                p[s,c]=color
    elif edge=='left':
        p[:,0]=YELLOW
        for r,s in enumerate(lengths):
            if s>0:
                p[r,w-s-1]=color
    else:
        p[:,-1]=YELLOW
        for r,s in enumerate(lengths):
            if s>0:
                p[r,s]=color
    return p


def choose_grid():
