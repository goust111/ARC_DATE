        else:
            options=[0]+list(range(1,max_shadow+1))
            val=random.choice(options)
        lengths[a:b]=val
        vals.append(val)
        positive_used|=val>0
        zero_used|=val==0
    if not positive_used or not zero_used:
        return None
    # ensure not all positive segments same if enough room
    if max_shadow >= 2 and len(set(v for v in vals if v>0)) < 2:
        pos_idx=[i for i,v in enumerate(vals) if v>0]
        if pos_idx:
            j=random.choice(pos_idx)
