+
+    if mode == _MODE_MERGE and all(dst not in source_set or src == dst for src, dst in mapping.items()):
+        return None
+
+    return mapping
+
+
+def _make_mapping(tile: np.ndarray) -> dict[int, int] | None:
+    source_colors = sorted(map(int, np.unique(tile)))
