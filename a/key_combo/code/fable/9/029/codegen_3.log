GEN_CELL_WIDTH_MIN, GEN_CELL_WIDTH_MAX = 2, 3
GEN_LATTICE_GAP_WIDTH = 1

# Cell symbols and weighted within-cell patterns.
GEN_LATTICE_TYPE = "L"
GEN_MIXED_TYPE = "m"
GEN_SOURCE_TYPE = "s"
GEN_PATTERN_WEIGHTS = {
    2: ((("m", "m"), 3), (("m", "s"), 4), (("s", "m"), 4), (("s", "s"), 1)),
    3: ((("m", "m", "m"), 3), (("m", "m", "s"), 5), (("m", "s", "m"), 4),
        (("s", "m", "m"), 5), (("m", "s", "s"), 2), (("s", "m", "s"), 1),
