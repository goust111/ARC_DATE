    arr = np.array(list(coords), dtype=int)
    shifted = arr - arr.min(axis=0)
    height, width = shifted.max(axis=0) + 1
    mask = np.zeros((height, width), dtype=bool)
    mask[shifted[:, 0], shifted[:, 1]] = True
