+def _template_offsets(fragments: list[dict]) -> set[tuple[int, int]]:
+    union: set[tuple[int, int]] = set()
+    for fragment in fragments:
+        union.update(fragment["offsets"])
+    assert union, "template union cannot be empty"
+    return union
