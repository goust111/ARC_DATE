def _gen_line_cells(
    start: tuple[int, int],
    direction: tuple[int, int],
) -> list[tuple[int, int]]:
    r, c = start
    dr, dc = direction
    height, width = GEN_SHAPE
    cells = []
    while 0 <= r < height and 0 <= c < width:
