+def _corner_offset(direction: tuple[int, int], size: int) -> tuple[int, int]:
+    dr, dc = direction
+    return (0 if dr < 0 else size - 1), (0 if dc < 0 else size - 1)
+
+
+def _notch_coord(top: int, left: int, size: int, direction: tuple[int, int]) -> tuple[int, int]:
