+def _ray_targets(obj_idx: int, objects: list[dict], shape: tuple[int, int]) -> list[int]:
+    h, w = shape
+    dr, dc = objects[obj_idx]["direction"]
+    r, c = objects[obj_idx]["notch"]
+    hits: list[tuple[int, int]] = []
+    while True:
+        nr, nc = r + dr, c + dc
+        if not (0 <= nr < h and 0 <= nc < w):
