+        border_pool = [
+            (0, c) for c in range(1, w - 1)
+        ] + [
+            (h - 1, c) for c in range(1, w - 1)
+        ] + [
+            (r, 0) for r in range(1, h - 1)
+        ] + [
+            (r, w - 1) for r in range(1, h - 1)
+        ]
+        random.shuffle(border_pool)
