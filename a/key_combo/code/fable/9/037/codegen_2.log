    bg = get_bg(g)

    pivot_coords = np.argwhere(g == PIVOT_COLOR)
    assert len(pivot_coords) == 1, "expected exactly one red pivot pixel"
    pivot_r, pivot_c = map(int, pivot_coords[0])

