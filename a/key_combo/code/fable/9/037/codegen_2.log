+        assert len(payload_colors) <= 1, "each compartment may contain at most one payload color"
+        if not payload_colors:
+            continue
+        fill = next(iter(payload_colors))
+        for r, c in region:
+            rr = int(r)
+            cc = int(c)
+            if not preserve[rr, cc]:
+                out[rr, cc] = fill
+
+    return out
