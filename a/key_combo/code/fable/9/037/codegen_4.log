+def _find_roster_frame(grid: np.ndarray, frames: list[Frame]) -> tuple[Frame, int]:
+    by_color = {frame.color: frame for frame in frames}
+    frame_colors = set(by_color)
+    candidates: list[tuple[Frame, int]] = []
+    for frame in frames:
