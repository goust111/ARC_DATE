+    patch = np.zeros((h, w), dtype=int)
+    used_colors = random.sample(colors, random.randint(1, min(3, len(colors))))
+    order = list(cells)
+    random.shuffle(order)
+    assigned = used_colors[:]
+    while len(assigned) < len(order):
