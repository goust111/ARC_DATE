+        if not color_set <= frame_colors:
+            continue
+        if frame.color not in color_set:
+            continue
+        missing = list(frame_colors - color_set)
+        if len(missing) != 1:
+            continue
+        if missing[0] == frame.color:
+            continue
+        if not _matches_relative_layout(frame, roster_pixels, by_color):
+            continue
