+def _color_components(grid: np.ndarray, color: int) -> list[list[tuple[int, int]]]:
+    mask = grid == color
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    h, w = grid.shape
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                comp.append((rr, cc))
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _is_hollow_rect_component(comp: list[tuple[int, int]]) -> tuple[int, int, int, int] | None:
+    rows = [r for r, _ in comp]
+    cols = [c for _, c in comp]
+    r0, r1 = min(rows), max(rows)
+    c0, c1 = min(cols), max(cols)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return None
+    need = 2 * (h + w) - 4
+    if len(comp) != need:
+        return None
+    cells = set(comp)
+    for rr in range(r0, r1 + 1):
+        for cc in range(c0, c1 + 1):
+            on_border = rr in (r0, r1) or cc in (c0, c1)
+            if on_border != ((rr, cc) in cells):
+                return None
+    return (r0, c0, r1, c1)
+
