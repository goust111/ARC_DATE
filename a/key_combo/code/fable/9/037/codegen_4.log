+def _isolated_roster_pixels(inner: np.ndarray) -> list[tuple[int, int, int]] | None:
+    coords = np.argwhere(inner != 0)
+    if len(coords) == 0:
+        return None
+    pixels: list[tuple[int, int, int]] = []
+    for r, c in coords:
+        rr = int(r)
+        cc = int(c)
+        for nr in range(max(0, rr - 1), min(inner.shape[0], rr + 2)):
