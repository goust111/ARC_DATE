spec:
  grid: 15x15 always
  background: 0 (black), ~57-63% of cells
  l_stencil:
    position: always top-left corner (row 0, col 0)
    shape: grey(5) right-column (col 3, rows 0-2) + bottom-row (row 3, cols 0-3) = 7 cells forming an L
    sample: the 3x3 region at [0:3, 0:3] inside the L; 4-5 nonzero cells, 3-4 distinct nonzero colors, never contains grey(5)
  duplicate:
    content: exact copy of the 3x3 sample placed elsewhere in the grid
    count: exactly 1 duplicate (total 2 occurrences of the pattern)
    position: row >= 2, col >= 2, row+3 <= 13, col+3 <= 13 (1-cell margin on all sides for frame)
    non_overlap: 5x5 frame region must not overlap the 4x4 L-stencil region [0:4, 0:4]
  noise: remaining cells filled with random colors 1-9 (including 5/grey) at ~37-41% density
  uniqueness: the 3x3 sample must not accidentally appear at any other location in the grid
  output:
    same as input except a 5x5 grey(5) rectangular frame is painted around the duplicate 3x3
    interior (the duplicate itself) is preserved; frame overwrites whatever was there

generation_strategy:
  approach: output-first
  steps:
    1. Create 15x15 grid of zeros
    2. Choose 3x3 sample with 4-5 nonzero cells using 3-4 colors from {1,2,3,4,6,7,8,9} (no grey)
    3. Place L-stencil at (0,0) -- write sample at [0:3,0:3], grey at col 3 rows 0-2 and row 3 cols 0-3
