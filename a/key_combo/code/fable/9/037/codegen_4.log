+    if len(comp) != need:
+        return None
+    cells = set(comp)
+    for rr in range(r0, r1 + 1):
+        for cc in range(c0, c1 + 1):
+            on_border = rr in (r0, r1) or cc in (c0, c1)
+            if on_border != ((rr, cc) in cells):
