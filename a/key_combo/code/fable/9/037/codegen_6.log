+        rng.shuffle(cands)
+
+        def score(cand: tuple[int, int]) -> tuple[int, int, float]:
+            wobble_now = sign * (cand[0] - current[0]) < 0 or sign * (cand[1] - current[1]) < 0
+            width_now = (cand[1] - cand[0]) != (current[1] - current[0])
