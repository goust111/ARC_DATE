   5: def main(grid: np.ndarray) -> np.ndarray:
   6:     """Return the single repeated tile from a grid made of two identical adjacent copies.
   7: 
   8:     Input structure
   9:     - The grid is a rectangular pattern duplicated exactly once, either side-by-side
  10:       or top-to-bottom.
  11:     - The two copies occupy equal-sized halves along the duplication axis.
  12: 
  13:     Rule
  14:     - Find the only axis whose two equal halves are identical.
  15:     - Output the first half along that axis.
  16: 
  17:     Key insight
  18:     - The output is not recolored or otherwise transformed; it is the source tile
  19:       before the duplicate copy was appended.
  20:     """
  21:     g = np.asarray(grid, dtype=int)
  22:     h, w = g.shape
  23: 
  24:     candidates: list[np.ndarray] = []
  25:     if w % 2 == 0:
  26:         left = g[:, : w // 2]
  27:         right = g[:, w // 2 :]
  28:         if np.array_equal(left, right):
  29:             candidates.append(left)
  30: 
  31:     if h % 2 == 0:
  32:         top = g[: h // 2, :]
  33:         bottom = g[h // 2 :, :]
  34:         if np.array_equal(top, bottom):
  35:             candidates.append(top)
  36: 
  37:     assert len(candidates) == 1
  38:     return candidates[0].copy()
