+    starts = [
+        (left, right)
+        for left in range(1, width - 2)
+        for right in range(left + GEN_BAND_WIDTH[0] - 1, min(width - 1, left + GEN_BAND_WIDTH[1]))
+    ]
+    rng.shuffle(starts)
