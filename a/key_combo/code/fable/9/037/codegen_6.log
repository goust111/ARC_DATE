+                continue
+            if left == cur_l and right == cur_r:
+                continue
+            cands.append((left, right))
+    return cands
+
+
+def _render_strip(
+    top_interval: tuple[int, int],
+    bottom_interval: tuple[int, int],
+    strip_h: int,
+    width: int,
+    bg: int,
+    band_color: int,
