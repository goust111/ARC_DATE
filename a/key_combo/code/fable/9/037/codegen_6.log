  25: def main(grid: np.ndarray) -> np.ndarray:
  26:     """
  27:     Extend the blue square up-left and the red square down-right along their diagonals to the grid edge.
  28: 
  29:     Input structure
  30:     - The grid has a black background.
  31:     - There is exactly one blue 2x2 square and exactly one red 2x2 square.
  32:     - The diagonal ray beyond each active corner is clear background until it leaves the grid.
  33: 
  34:     Rule
  35:     - Keep the input pixels unchanged.
  36:     - From the blue square's top-left corner, paint a blue diagonal ray in the up-left direction.
  37:     - From the red square's bottom-right corner, paint a red diagonal ray in the down-right direction.
  38:     - Each ray stops only when the next step would leave the grid.
  39: 
  40:     Key insight
  41:     - The colored 2x2 squares are fixed emitters: blue uses its northwest corner and red uses its southeast corner, so the missing pixels are the two outward diagonal continuations.
  42:     """
  43:     g = np.asarray(grid, dtype=int)
  44:     assert g.ndim == 2, "expected a 2D grid"
  45:     bg = get_bg(g)
  46:     assert bg == Color.BLACK, "expected black background"
  47: 
  48:     comps = find_components(g, bg=bg, connectivity=4, monochromatic=True)
  49:     assert len(comps) == 2, "expected exactly two foreground components"
  50: 
  51:     by_color: dict[int, dict] = {}
  52:     for comp in comps:
