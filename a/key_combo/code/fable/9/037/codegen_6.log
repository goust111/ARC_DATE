+@dataclass(frozen=True)
+class StripInfo:
+    grid: np.ndarray
+    top_sig: tuple[int, ...]
+    bottom_sig: tuple[int, ...]
+    sign: int
+    flipped: bool
+
+
+GEN_RETRY_LIMIT = 400
+GEN_STRIP_COUNT = (3, 6)
+GEN_STRIP_HEIGHT = (3, 5)
+GEN_WIDTH = (12, 20)
+GEN_BAND_WIDTH = (2, 4)
+GEN_CENTER_SHIFT = (1, 4)
