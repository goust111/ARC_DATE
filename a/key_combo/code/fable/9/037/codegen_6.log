    start_left = int(rng.integers(1, width - start_w - 1))
    intervals = [(start_left, start_left + start_w - 1)]
    edge_wobble = False
    width_changed = False

    for _ in range(strip_count):
        current = intervals[-1]
        cands = _band_candidates(width, strip_h, current, sign)
        if not cands:
            return None

        wobblers = [
            cand
            for cand in cands
            if sign * (cand[0] - current[0]) < 0 or sign * (cand[1] - current[1]) < 0
