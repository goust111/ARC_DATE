+    for global_sign in (-1, 1):
+        oriented: list[StripInfo] = []
+        valid = True
+        for i in range(len(strips)):
+            choices = [info for info in (original[i], mirrored[i]) if info.sign == global_sign]
+            if len(choices) != 1:
+                valid = False
+                break
+            oriented.append(choices[0])
+        if not valid:
+            continue
