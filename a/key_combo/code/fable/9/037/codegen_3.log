+from __future__ import annotations
+
+import random
+from collections import defaultdict
+
+import numpy as np
+
+
+def _solid_rect_candidate(grid: np.ndarray) -> tuple[int, tuple[int, int, int, int]]:
+    candidates: list[tuple[int, tuple[int, int, int, int]]] = []
