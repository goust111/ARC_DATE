+        solved = main(inp)
+    except Exception:
+        return False
+    if not np.array_equal(solved, out):
+        return False
+
+    mid = inp.shape[0] // 2
+    visible = inp.copy()
+    r0, c0, r1, c1 = bbox
+    visible[r0 : r1 + 1, c0 : c1 + 1] = 0
+
+    hidden_seed_count = 0
+    for row, col, color in zip(top_rows, cols, colors):
+        if visible[row, col] != color:
+            return False
+        mirror_row = inp.shape[0] - 1 - row
+        if r0 <= mirror_row <= r1 and c0 <= col <= c1:
+            hidden_seed_count += 1
