+    bbox = _pick_occluder(height, width, top_rows, cols)
+    if bbox is None:
+        return None
+    r0, c0, r1, c1 = bbox
+
+    inp = out.copy()
+    inp[r0 : r1 + 1, c0 : c1 + 1] = occluder_color
+
+    if not _validate_instance(inp, out, bbox, top_rows, cols, colors):
+        return None
+    return inp
