                    qr = rr if rr < _GEN_QUAD_SIZE else _GEN_GRID_SIZE - 1 - rr
                    qc = cc if cc < _GEN_QUAD_SIZE else _GEN_GRID_SIZE - 1 - cc
                    choices = [x for x in colors if x != color]
