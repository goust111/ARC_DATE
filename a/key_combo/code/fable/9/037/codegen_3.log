+    out = inp.copy()
+    out[r0 : r1 + 1, c0 : c1 + 1] = 0
+    for r in range(r0, r1 + 1):
+        mr = h - 1 - r
+        out[r, c0 : c1 + 1] = out[mr, c0 : c1 + 1]
+    return out
+
+
+def _restore_hidden_seeds_only(
+    inp: np.ndarray,
+    bbox: tuple[int, int, int, int],
+    top_rows: list[int],
+    cols: list[int],
+    colors: list[int],
