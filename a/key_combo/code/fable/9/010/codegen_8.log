+    out = main(grid)
+    if out.shape != (height, axis):
+        return None
+    if len(set(map(int, np.unique(grid))) - {BG}) < 3:
+        return None
+    if np.count_nonzero(out != BG) < 8:
+        return None
+    return grid
+
