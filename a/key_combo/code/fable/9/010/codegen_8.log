+def _candidate_axes(grid: np.ndarray, bg: int) -> list[dict[str, object]]:
+    g = np.asarray(grid, dtype=int)
+    return [info for c in range(g.shape[1]) if (info := _evaluate_axis(g, c, bg))["status"] != "not_candidate"]
