spec:
  task: Complete a two-color rectangular crop into the full 20x20 binary motif
  motif:
    shape: 20x20 fixed binary pattern (hard-coded in solver as _BASE_PATTERN)
    fg_density: 42.2% (169/400 cells)
    dihedral_variants: 8 distinct orientations (rot0/90/180/270 x flip), none identical or complementary
  input:
    grid: rectangular sub-window of one dihedral variant, painted with 2 colors
    rows: 8-16
    cols: 8-12
    area: 80-156 cells
    colors: exactly 2 distinct ARC colors; any pair [observed]
    uniqueness: crop must uniquely identify (variant, offset, fg/bg polarity) -- solver asserts exactly 1 match
    uniqueness_guarantee: 100% for min(H,W)>=11 or max(H,W)>=12; ~95-99% for smaller crops
  output:
