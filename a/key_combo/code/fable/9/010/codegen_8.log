+    candidates = _candidate_axes(g, bg)
+    valid = [info for info in candidates if info["status"] == "valid"]
+    assert len(valid) == 1, "expected exactly one self-consistent fold axis"
+    return np.asarray(valid[0]["out"], dtype=int)
