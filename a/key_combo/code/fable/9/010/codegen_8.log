+            if np.all(right[:, out_col - align_start] == BG):
+                rows = _safe_rows_for_right(left, right, left_blocked, right_blocked, out_col, align_start)
+                if not rows:
+                    return None
+                _set_right(right, rng.choice(rows), out_col, align_start, _rand_color(rng, palette))
