  frame:
    width: always 4 columns
    height: 3-5 rows (interior height 1-3)
    structure: solid left/right walls, solid bottom, 3-of-4 top cells grey with 1 bg gap
    top_row_pattern: gap at offset 1 -> [G,_,G,G] (cap right, ray right) OR gap at offset 2 -> [G,G,_,G] (cap left, ray left)
    interior: all background (2x1 to 2x3 region)
