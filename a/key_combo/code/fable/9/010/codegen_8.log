  colors:
    border: any color, must differ from tile_bg
    tile_bg: any color; shared by all 4 tiles as majority color
    cue_color, t1_color, t2_color: each a single distinct non-bg color; all 3 mutually distinct and distinct from tile_bg
  tile0_cue:
    total_pixels: 6 (single cue_color) [observed]
    wall: 5 cue pixels forming an 8-connected path through center (2,2), touching >=2 sides of the 5x5 grid
    indicator: 1 cue pixel, 8-isolated (no 8-neighbor is also cue), marks the "inside" region for tile1
