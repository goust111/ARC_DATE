spec:
  grid: 14-22 rows x 3-5 cols, tall and narrow
  background: BLACK
  foreground_colors: exactly BLUE and TEAL
  objects:
    type: solid rectangles (fully filled, no holes)
    count: 8-16 per grid
    height: 1-3 rows each (mostly 1-2)
    width: 2 to grid_width cols (>=2, never 1)
    stacking: objects tile all rows top-to-bottom with no gaps and no overlaps; sum of heights == grid height
    color_alternation: strictly alternating BLUE/TEAL in top-to-bottom order; first color is either
    left_offset: each rect has arbitrary column offset; rect does not need to touch left or right edge
