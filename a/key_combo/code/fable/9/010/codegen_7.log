  "type": "move_along_path",
  "src": "grey 4-connected open-top rectangular frame s with a one-cell top gap and a two-pixel top cap on one side",
  "path": "from the column of s.top_gap on the row above s, travel horizontally toward the side with the two-pixel top cap until the grid edge",
  "trajectory": "paint every background pixel on that row segment red",
  "transform": "preserve the grey frame; also recolor background pixels inside the frame and the top gap red"
}
</annotation>
<generation_spec>
```yaml
spec:
  grid: 10x10 [observed]
  background: black(0)
  colors: only grey(5) on black background; output adds red(2)
  frame_count: 1-2
  frame:
    width: always 4 columns
    height: 3-5 rows (interior height 1-3)
    structure: solid left/right walls, solid bottom, 3-of-4 top cells grey with 1 bg gap
    top_row_pattern: gap at offset 1 -> [G,_,G,G] (cap right, ray right) OR gap at offset 2 -> [G,G,_,G] (cap left, ray left)
    interior: all background (2x1 to 2x3 region)
    top_row >= 1 (must have at least 1 row above for the ray)
  ray:
    row: immediately above frame top (r0 - 1)
    extends from gap column to grid edge in the direction of the 2-pixel cap
    must be entirely background (no obstructions)
    length: 4-8 cells [observed]
  constraints:
    frames do not overlap or touch (separation >= 1 row and >= 1 col)
    ray rows are distinct and unobstructed by other frames
  output_transform: |
    1. Fill interior bg pixels and top gap with red
    2. Draw red ray on row above frame from gap column to grid edge in cap direction

generation_strategy:
  approach: direct construction (frames are simple, constraints easy to satisfy)
  steps:
    1. Choose frame count (1 or 2) and for each frame choose height (3-5), gap side (left or right)
    2. Place frames on 10x10 black grid with random positions, ensuring top_row >= 1, no overlap, no adjacency, and ray rows clear
    3. For each frame draw the 4-wide grey rectangle with open top (gap at offset 1 for right-ray, offset 2 for left-ray)
    4. Validate that each ray row (r0-1) from gap to grid edge is entirely background (reject or retry if not)
