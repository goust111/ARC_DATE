  band_structure:
    matched_pair: exactly 2 of 3 tiles share the same equality pattern but use different color pairs
    odd_tile: the third tile has a different equality pattern and uses the same color pair as one of the matched pair (the "src")
    color_mapping: bijective map from src colors to dst colors; may overlap (3 or 4 distinct colors per band)
    which_tile_is_odd: varies freely among positions 0, 1, 2 across bands
  output:
