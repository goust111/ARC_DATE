0037:     # --- Indicator = the unique 8-isolated cue pixel ---
0038:     indicator = None
0039:     for r, c in cue_set:
0040:         if not any((nr, nc) in cue_set for nr, nc in neighbors8(r, c)):
0041:             assert indicator is None, "multiple 8-isolated cue pixels"
0042:             indicator = (r, c)
0043:     assert indicator is not None, "no 8-isolated cue pixel found"
0044: 
0045:     # Indicator must sit at a tile corner or edge midpoint
0046:     valid_pos = {(0,0),(0,4),(4,0),(4,4),(0,2),(2,0),(2,4),(4,2)}
0047:     assert indicator in valid_pos, f"indicator {indicator} not at corner/edge-midpoint"
0048: 
