0001: import numpy as np
0002: 
0003: from arc_utils import Color, bbox_coords, colors_present, components_mask, get_bg
0004: import random
0005: 
0006: 
0007: def main(grid: np.ndarray) -> np.ndarray:
0008:     """
0009:     Fill each grey open-top frame with red and extend a red spill line above it toward its doubled top cap.
0010: 
0011:     Input structure
0012:     - The background is the dominant empty color.
0013:     - The only foreground color is grey.
0014:     - The grey pixels form one or more 4-connected rectangular frames with solid left, right, and bottom sides.
0015:     - Each frame's top side has exactly one background gap and a two-pixel grey cap on one side of that gap.
0016: 
0017:     Rule
0018:     - Preserve all grey pixels.
0019:     - For each frame, color the background pixels inside the frame and the missing top pixel red.
0020:     - On the row just above the frame, draw red from the top gap to the grid edge in the direction of the two-pixel cap.
0021: 
0022:     Key insight
0023:     - The asymmetric two-pixel cap on the top edge marks the horizontal direction of the red spill ray.
0024:     """
0025:     g = np.asarray(grid, dtype=int)
0026:     bg = get_bg(g)
0027:     W = g.shape[1]
0028:     assert bg != Color.GREY
0029:     assert colors_present(g, exclude={bg}) == [Color.GREY]
0030: 
0031:     out = g.copy()
0032:     components = components_mask(g == Color.GREY, connectivity=4)
0033:     assert components
0034: 
0035:     for coords in components:
0036:         r0, c0, r1, c1 = bbox_coords(coords)
0037:         assert r0 > 0
0038:         assert r1 - r0 + 1 >= 3
0039:         assert c1 - c0 + 1 == 4
0040: 
0041:         assert np.all(g[r0 + 1 : r1, c0] == Color.GREY)
0042:         assert np.all(g[r0 + 1 : r1, c1] == Color.GREY)
0043:         assert np.all(g[r1, c0 : c1 + 1] == Color.GREY)
0044:         assert np.all(g[r0 + 1 : r1, c0 + 1 : c1] == bg)
0045: 
0046:         top = g[r0, c0 : c1 + 1]
0047:         assert np.count_nonzero(top == Color.GREY) == 3
0048:         gap_offsets = np.flatnonzero(top == bg)
0049:         assert len(gap_offsets) == 1
0050:         gap = c0 + int(gap_offsets[0])
0051: 
0052:         left_cap = gap - 2 >= c0 and np.all(g[r0, gap - 2 : gap] == Color.GREY)
0053:         right_cap = gap + 2 <= c1 and np.all(g[r0, gap + 1 : gap + 3] == Color.GREY)
0054:         assert left_cap != right_cap
0055: 
0056:         fill_region = out[r0:r1, c0 + 1 : c1]
0057:         fill_region[g[r0:r1, c0 + 1 : c1] == bg] = Color.RED
0058: 
0059:         if left_cap:
0060:             ray_cols = slice(0, gap + 1)
0061:         else:
0062:             ray_cols = slice(gap, W)
0063:         assert np.all(g[r0 - 1, ray_cols] == bg)
0064:         out[r0 - 1, ray_cols] = Color.RED
0065: 
0066:     return out
0067: 
