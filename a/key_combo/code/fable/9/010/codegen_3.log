import random
import numpy as np

OCC=5; BG=0; PALETTE=[1,2,3,4,6,7,8,9]


def candidates(shape):
    h,w=shape
    out=['vm','hm','r180']
    if h==w: out+=['dmain','danti']
    return out

def map_coord(sym, r,c,h,w):
    if sym=='vm': return (r, w-1-c)
    if sym=='hm': return (h-1-r, c)
    if sym=='r180': return (h-1-r, w-1-c)
    if sym=='dmain': return (c,r)
    if sym=='danti': return (h-1-c, w-1-r)
    raise ValueError(sym)

def orbits(shape,sym):
    h,w=shape
    seen=set(); out=[]
    for r in range(h):
        for c in range(w):
            if (r,c) in seen: continue
            stack=[(r,c)]
            orb=set()
            while stack:
                x=stack.pop()
                if x in orb: continue
                orb.add(x)
                y=map_coord(sym, x[0], x[1], h,w)
                if y not in orb: stack.append(y)
            seen |= orb
            out.append(tuple(sorted(orb)))
    return out

def sat(grid,sym):
    h,w=grid.shape
    for r in range(h):
        for c in range(w):
            rr,cc=map_coord(sym,r,c,h,w)
            if grid[r,c]"'!=grid[rr,cc]: return False
    return True

def consistent(merged,unknown,sym):
    for orb in orbits(merged.shape,sym):
        vals={int(merged[r,c]) for r,c in orb if not unknown[r,c]}
        if len(vals)>1: return False
        if any(unknown[r,c] for r,c in orb) and not vals: return False
    return True

def reconstruct(merged,unknown,sym):
    out=merged.copy()
    for orb in orbits(out.shape,sym):
        vals={int(out[r,c]) for r,c in orb if not unknown[r,c]}
        if len(vals)!=1:
            raise AssertionError
        color=next(iter(vals))
        for r,c in orb: out[r,c]=color
    return out

def infer(merged,unknown):
    good=[]
    for sym in candidates(merged.shape):
        if consistent(merged,unknown,sym):
            full=reconstruct(merged,unknown,sym)
            sats=[s for s in candidates(merged.shape) if sat(full,s)]
            if sym in sats:
                good.append((sym,full,sats))
    return good

def gen_pattern(sym):
    for _ in range(500):
        if sym in {'"'dmain','danti'}:
            h=w=random.randint(5,8)
        else:
            h=random.randint(5,8); w=random.randint(5,8)
            if random.random()<0.65:
                while h==w:
                    w=random.randint(5,8)
        cols=random.sample(PALETTE, random.randint(3,5))
        grid=np.zeros((h,w),dtype=int)
        for orb in orbits((h,w),sym):
            color=random.choice(cols)
            for r,c in orb: grid[r,c]=color
        sats=[s for s in candidates((h,w)) if sat(grid,s)]
        if sats==[sym] and len(set(map(int,grid.flat)))>=3:
            return grid
    raise RuntimeError

def need_ok(sym,lmask,rmask,shape):
    left_essential=right_essential=sym_essential=False
    for orb in orbits(shape,sym):
        if len(orb)<2: continue
        lvis=sum(not lmask[r,c] for r,c in orb)
        rvis=sum(not rmask[r,c] for r,c in orb)
        both=sum(lmask[r,c] and rmask[r,c] for r,c in orb)
        if lvis==0 and rvis>0: left_essential=True
        if rvis==0 and lvis>0: right_essential=True
        if both>0 and (lvis+rvis-both)>0: sym_essential=True
    return left_essential and right_essential and sym_essential

def merge(pattern,lmask,rmask):
    left=pattern.copy(); right=pattern.copy(); left[lmask]=OCC; right[rmask]=OCC
    merged=np.full(pattern.shape,-1,dtype=int)
    unknown=np.zeros(pattern.shape,dtype=bool)
    for r in range(pattern.shape[0]):
        for c in range(pattern.shape[1]):
            lv,rv=left[r,c],right[r,c]
            if lv"'!=OCC and rv!=OCC:
                if lv!=rv: raise AssertionError
                merged[r,c]=lv
            elif lv!=OCC: merged[r,c]=lv
            elif rv!=OCC: merged[r,c]=rv
            else: unknown[r,c]=True
    return left,right,merged,unknown

def gen_masks(pattern,sym):
    h,w=pattern.shape
    pair_orbits=[o for o in orbits(pattern.shape,sym) if len(o)==2]
    if len(pair_orbits)<3: return None
    for _ in range(3000):
        lmask=np.zeros((h,w),dtype=bool)
        rmask=np.zeros((h,w),dtype=bool)
        both,leftonly,rightonly = random.sample(pair_orbits, 3)
        a,b=random.choice([both, both[::-1]])
        lmask[a]=True; rmask[a]=True
        for cell in leftonly: lmask[cell]=True
        for cell in rightonly: rmask[cell]=True
        # make sure the mate of doubly hidden cell is visible somewhere
        if lmask[b] and rmask[b]:
            (lmask if random.random()<0.5 else rmask)[b]=False
        for mask in (lmask,rmask):
            for _ in range(random.randint(2,5)):
                rh=random.randint(1, max(1,h//2))
                rw=random.randint(1, max(1,w//2))
                r0=random.randint(0,h-rh)
                c0=random.randint(0,w-rw)
                mask[r0:r0+rh, c0:c0+rw]=True
        left,right,merged,unknown=merge(pattern,lmask,rmask)
        if not unknown.any() or unknown.sum()>max(6, (h*w)//4):
            continue
        if lmask.mean()<0.12 or rmask.mean()<0.12 or lmask.mean()>0.58 or rmask.mean()>0.58:
            continue
        if np.count_nonzero(lmask & ~rmask)==0 or np.count_nonzero(rmask & ~lmask)==0:
            continue
        if np.count_nonzero(lmask & rmask)==0:
            continue
        if not need_ok(sym,lmask,rmask,pattern.shape):
            continue
        goods=infer(merged,unknown)
        if len(goods)!=1 or goods[0][0]!=sym:
            continue
        if not np.array_equal(goods[0][1], pattern):
            continue
        return left,right,unknown.sum(),goods[0][2]
    return None

for i in range(200):
    sym=random.choice(['"'vm','hm','r180','dmain','danti'])
    if sym in {'dmain','danti'} or random.random()<1:
        pass
    pat=gen_pattern(sym)
    res=gen_masks(pat,sym)
    if res is None:
        print('fail', i, sym, pat.shape)
        break
else:
    print('200 ok')
