+def _satisfies_symmetry(grid: np.ndarray, symmetry: str) -> bool:
+    h, w = map(int, grid.shape)
+    for r in range(h):
+        for c in range(w):
+            rr, cc = _map_coord(symmetry, r, c, grid.shape)
+            if int(grid[r, c]) != int(grid[rr, cc]):
