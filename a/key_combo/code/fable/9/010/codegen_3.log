  "transform": "remove the separator, mirror the right region horizontally, and overlay non-background pixels onto the left region, requiring same-color agreement on overlaps",
  "grid_shape": "same height as input and width of one side region"
}
</annotation>
<generation_spec>
```yaml
spec:
  grid: 8-14 rows x (2W+1) cols where W=3-6, so width is always odd
  background: 0
  separator:
    a single full-height column of uniform non-bg color (always 5 [observed])
    positioned at center column W, splitting grid into equal-width left and right regions
    separator color must not appear in either region
  regions:
    left and right each W cols wide
    exactly 2 distinct non-bg colors shared across both sides
    primary color 7-11 pixels in output, secondary color 3-5 pixels in output
    each side has 5-13 fg pixels; total fg fills 25-40% of one region
  fold_constraint:
    where both left[r,c] and flipped_right[r,c] are non-bg, colors must agree
