        if unknown.sum()>max(5, (h*w)//4): continue
        if cands!=[sym]: continue
        if not need_ok(sym,lmask,rmask,pattern.shape): continue
        if lmask.mean()>0.55 or rmask.mean()>0.55: continue
        if lmask.mean()<0.1 or rmask.mean()<0.1: continue
        return lmask,rmask,unknown.sum(),cands
    return None

for i in range(200):
    sym=random.choice(SYM_NAMES)
    if sym in {'"'dmain','danti'}:
        pass
    pat=gen_pattern(sym)
    res=gen_masks(pat,sym)
    if res is None:
        print('fail', i, sym, pat.shape)
        break
else:
    print('all ok')
