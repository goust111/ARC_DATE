0143: def _sample_symmetric_pattern(bg: int, fg: int, rng: random.Random, *,
0144:                               min_px: int, max_px: int) -> np.ndarray | None:
0145:     """Sample a 5x5 grid symmetric under both diagonals, with fg pixel count in
