0008: def main(grid: np.ndarray) -> np.ndarray:
0009:     """
0010:     Composite two pattern tiles into a fourth panel using flood-fill from an indicator pixel.
0011: 
0012:     Input structure:
0013:     - Four 5×5 panels in one row, border-separated.
0014:     - Panel 0: cue pixels = wall boundary (8-connected, edge-to-edge, through center)
0015:                + one 8-isolated indicator pixel.
0016:     - Panels 1–2: source patterns. Panel 3: blank (to fill).
0017: 
0018:     Rule:
0019:     - Flood-fill (4-conn) from indicator, blocked by wall → inside region.
0020:     - Inside → non-bg from panel 1; outside → non-bg from panel 2.
0021:     - Wall → panel 1 if non-bg; panel 2 fallback when wall is 4-connected.
0022: 
0023:     Key insight: The cue panel's isolated indicator and wall partition the tile into inside/outside masks that select between the two source panels.
0024:     """
0025:     g = np.array(grid, dtype=int)
0026: 
0027:     border = int(g[0, 0])
0028:     tiles = [g[1:6, 1 + 6 * j : 1 + 6 * j + 5].copy() for j in range(4)]
0029:     t0, t1, t2, _t3 = tiles
0030:     b = int(Counter(t1.flatten()).most_common(1)[0][0])
0031:     assert border != b, "border color must differ from tile background"
0032: 
0033:     t0_bg = int(Counter(t0.flatten()).most_common(1)[0][0])
0034:     cue_set = {(int(r), int(c)) for r in range(5) for c in range(5) if int(t0[r, c]) != t0_bg}
0035:     assert cue_set, "no cue pixels found"
