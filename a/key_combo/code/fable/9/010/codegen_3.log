0854: def random_free_location(
0855:     canvas: np.ndarray,
0856:     patch: np.ndarray,
0857:     *,
0858:     transparent: int,
0859:     border: int = 0,
0860:     padding: int = 0,
0861:     padding_connectivity: int = 8,
0862: ) -> Coord:
0863:     """
0864:     Return a random (r,c) top-left location where `patch` fits without overlap.
0865: 

0855:     canvas: np.ndarray,
0856:     patch: np.ndarray,
0857:     *,
0858:     transparent: int,
0859:     border: int = 0,
0860:     padding: int = 0,
0861:     padding_connectivity: int = 8,
0862: ) -> Coord:
0863:     """
0864:     Return a random (r,c) top-left location where `patch` fits without overlap.
0865: 
0866:     This is the generator-friendly counterpart of `first_free_location` and mirrors the
0867:     legacy seeds' `random_free_location_for_sprite` behavior.
0868: 
0869:     Raises:
0870:         ValueError: if no free location exists.
0871:     """
0872:     H, W = canvas.shape
0873:     h, w = patch.shape
0874:     border = int(border)
0875:     padding = int(padding)
0876:     pad_conn = int(padding_connectivity)
0877:     bg = int(transparent)
0878: 
0879:     if h <= 0 or w <= 0:
0880:         raise ValueError("random_free_location: patch must be non-empty")
0881:     if H <= 0 or W <= 0:
0882:         raise ValueError("random_free_location: canvas must be non-empty")
0883: 
0884:     if border < 0:
0885:         raise ValueError("random_free_location: border must be >= 0")
0886:     if padding < 0:
0887:         raise ValueError("random_free_location: padding must be >= 0")
0888:     if pad_conn not in (4, 8):
0889:         raise ValueError("random_free_location: padding_connectivity must be 4 or 8")
0890: 
0891:     r_min = border
0892:     c_min = border
0893:     r_max = H - border - h
0894:     c_max = W - border - w
0895:     if r_max < r_min or c_max < c_min:
0896:         raise ValueError("random_free_location: patch cannot fit (border too large or patch too big)")
0897: 
0898:     occ = (canvas != bg)
0899:     if padding > 0:
0900:         struct = STRUCT4 if pad_conn == 4 else STRUCT8
0901:         occ = ndimage.binary_dilation(occ, structure=struct, iterations=padding)
0902: 
0903:     m = (patch != bg)
0904: 
0905:     candidates: list[Coord] = []
0906:     for r0 in range(r_min, r_max + 1):
0907:         for c0 in range(c_min, c_max + 1):
0908:             if not bool((occ[r0 : r0 + h, c0 : c0 + w] & m).any()):
0909:                 candidates.append((int(r0), int(c0)))
0910: 
0911:     if not candidates:
0912:         raise ValueError("random_free_location: no free location")
0913:     return random.choice(candidates)
