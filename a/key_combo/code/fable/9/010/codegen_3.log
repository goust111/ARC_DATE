+def _map_coord(symmetry: str, r: int, c: int, shape: tuple[int, int]) -> tuple[int, int]:
+    h, w = map(int, shape)
+    if symmetry == "vm":
+        return r, w - 1 - c
+    if symmetry == "hm":
+        return h - 1 - r, c
+    if symmetry == "r180":
+        return h - 1 - r, w - 1 - c
+    if symmetry == "dmain":
+        return c, r
+    if symmetry == "danti":
+        return h - 1 - c, w - 1 - r
+    raise ValueError(f"unknown symmetry: {symmetry}")
