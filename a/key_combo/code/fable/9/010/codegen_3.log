0001: import numpy as np
0002: 
0003: from arc_utils import Color, colors_present, get_bg
0004: 
0005: 
0006: def main(grid: np.ndarray) -> np.ndarray:
0007:     """
0008:     Split two side-by-side masks and mark the cells that are empty in both.
0009: 
0010:     Input structure
0011:     - The input is a 2D grid with black background.
0012:     - The grid has even width and splits into two equal-size panels.
0013:     - The left panel contains a pink mask and the right panel contains a grey mask.
0014:     Rule
0015:     - Align the two panels cell by cell.
0016:     - Output one panel-sized black grid.
0017:     - Paint a yellow pixel wherever both aligned input cells are background.
0018:     Key insight
0019:     - The output is the intersection of the two background masks after horizontal alignment.
0020:     """
0021:     g = np.asarray(grid, dtype=int)
0022:     assert g.ndim == 2, "expected a 2D grid"
0023:     height, width = map(int, g.shape)
0024:     assert height > 0 and width > 0, "expected a nonempty grid"
0025:     assert width % 2 == 0, "expected two equal-width panels"
0026: 
0027:     bg = get_bg(g)
0028:     assert bg == Color.BLACK, "expected black background"
0029: 
0030:     half = width // 2
0031:     left = g[:, :half]
0032:     right = g[:, half:]
0033:     assert left.shape == right.shape, "expected aligned left and right panels"
0034: 
0035:     left_colors = set(colors_present(left, exclude={bg}))
0036:     right_colors = set(colors_present(right, exclude={bg}))
0037:     assert left_colors == {Color.PINK}, "expected a pink mask in the left panel"
0038:     assert right_colors == {Color.GREY}, "expected a grey mask in the right panel"
0039: 
0040:     out = np.full(left.shape, Color.BLACK, dtype=int)
0041:     out[(left == bg) & (right == bg)] = Color.YELLOW
0042:     return out
0043: 
0044: # --------------- generator (o5x) ---------------
0045: # Canvas and panel bounds.
0046: MIN_HEIGHT, MAX_HEIGHT, MIN_PANEL_WIDTH, MAX_PANEL_WIDTH = 3, 6, 3, 6
0047: # Output and foreground density bounds, expressed as integer percentages.
0048: MIN_YELLOW_PCT, MAX_YELLOW_PCT, MIN_FOREGROUND_PCT, MAX_FOREGROUND_PCT = 15, 45, 30, 70
0049: PCT_DENOMINATOR = 100
0050: # Retry budget.
0051: MAX_GENERATION_ATTEMPTS = 300
0052: 
0053: 
0054: def _ceil_pct(total: int, pct: int) -> int:
0055:     return (pct * total + PCT_DENOMINATOR - 1) // PCT_DENOMINATOR
0056: 
0057: 
0058: def _feasible_foreground_counts(total: int, active_count: int) -> list[tuple[int, int]]:
0059:     """Return all left/right foreground counts that satisfy panel density bounds."""
0060:     min_fg = _ceil_pct(total, MIN_FOREGROUND_PCT)
0061:     max_fg = min((MAX_FOREGROUND_PCT * total) // PCT_DENOMINATOR, active_count)
0062:     return [
0063:         (left_count, right_count)
0064:         for left_count in range(min_fg, max_fg + 1)
0065:         for right_count in range(min_fg, max_fg + 1)
0066:         if left_count + right_count >= active_count
0067:         and 2 * total - left_count - right_count > max(left_count, right_count)
0068:     ]
0069: 
0070: 
0071: def _gen_attempt() -> np.ndarray | None:
0072:     height = int(np.random.randint(MIN_HEIGHT, MAX_HEIGHT + 1))
0073:     width = int(np.random.randint(MIN_PANEL_WIDTH, MAX_PANEL_WIDTH + 1))
0074:     total = height * width
0075: 
0076:     min_yellow = max(1, _ceil_pct(total, MIN_YELLOW_PCT))
0077:     max_yellow = max(min_yellow, (MAX_YELLOW_PCT * total) // PCT_DENOMINATOR)
0078:     yellow_count = int(np.random.randint(min_yellow, max_yellow + 1))
0079: 
0080:     order = np.arange(total)
0081:     np.random.shuffle(order)
0082:     yellow_cells = order[:yellow_count]
0083:     active_cells = order[yellow_count:]
0084:     active_count = total - yellow_count
0085: 
0086:     feasible_counts = _feasible_foreground_counts(total, active_count)

