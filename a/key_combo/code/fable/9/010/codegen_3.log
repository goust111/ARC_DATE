+def _semantic_checks(pattern: np.ndarray, left_mask: np.ndarray, right_mask: np.ndarray, symmetry: str) -> bool:
+    if np.count_nonzero(left_mask & ~right_mask) == 0:
+        return False
+    if np.count_nonzero(right_mask & ~left_mask) == 0:
