0156:                 continue
0157:             if rng.random() < ORBIT_INCLUDE_PROB:
0158:                 for r, c in orbit:
0159:                     p[r, c] = fg
0160:                 count += len(orbit)
0161:         if min_px <= count <= max_px:
0162:             return p
0163:     return None
