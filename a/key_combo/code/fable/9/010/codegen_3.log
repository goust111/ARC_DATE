0020: def main(grid: np.ndarray) -> np.ndarray:
0021:     """Rotate the colors around every 3x3 foreground ring, with corners and side-centers cycling in opposite directions.
0022: 
0023:     Input structure
0024:     - The grid has a dominant background color.
0025:     - Each 4-connected foreground object is a complete 3x3 ring: eight foreground pixels around a background center.
0026: 
0027:     Rule
0028:     - For each ring, move corner colors one step around the four corners.
0029:     - Move side-center colors one step around the four side centers in the opposite direction.
0030:     - Leave the background center and all other background pixels unchanged.
0031: 
0032:     Key insight
0033:     - Corners and side centers form two separate four-cycles on the same 3x3 ring.
0034:     """
0035:     g = np.asarray(grid, dtype=int)
0036:     bg = get_bg(g)
0037:     out = g.copy()
0038: 
0039:     components = find_components(g, bg=bg, connectivity=4, monochromatic=False)
0040:     assert components
0041: 
0042:     for comp in components:
0043:         bbox = comp["bbox"]
0044:         r0, c0, r1, c1 = map(int, bbox)
0045:         assert bbox_h(bbox) == 3
0046:         assert bbox_w(bbox) == 3
0047:         assert int(comp["area"]) == 8
0048:         assert g[r0 + 1, c0 + 1] == bg
0049: 
0050:         ring_coords = {
0051:             (r0 + dr, c0 + dc)
0052:             for dr in range(3)
0053:             for dc in range(3)
0054:             if (dr, dc) != (1, 1)
0055:         }
0056:         component_coords = {tuple(map(int, coord)) for coord in comp["coords"]}
0057:         assert component_coords == ring_coords
0058:         assert r1 == r0 + 2
0059:         assert c1 == c0 + 2
