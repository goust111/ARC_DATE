/bin/bash -lc "python - <<'PY'
import random
import numpy as np

SYM_NAMES = ['vm','hm','r180','dmain','danti']
PALETTE = [1,2,3,4,6,7,8,9]
OCC = 5
BG = 0


def candidates(shape):
    h,w = shape
    out = ['vm','hm','r180']
    if h==w:
        out += ['dmain','danti']
    return out

def map_coord(sym, r,c,h,w):
    if sym=='vm': return (r, w-1-c)
    if sym=='hm': return (h-1-r, c)
    if sym=='r180': return (h-1-r, w-1-c)
    if sym=='dmain': return (c,r)
    if sym=='danti': return (h-1-c, w-1-r)
    raise ValueError(sym)

def orbits(shape,sym):
    h,w=shape
    seen=set(); out=[]
    for r in range(h):
        for c in range(w):
            if (r,c) in seen: continue
            mate=map_coord(sym,r,c,h,w)
            orb=sorted({(r,c),mate})
            for x in orb: seen.add(x)
            out.append(tuple(orb))
    return out

def sat(pattern,sym):
    h,w=pattern.shape
    for r in range(h):
        for c in range(w):
            rr,cc=map_coord(sym,r,c,h,w)
            if pattern[r,c]"'!=pattern[rr,cc]: return False
    return True

def gen_pattern(sym):
    for _ in range(1000):
        if sym in {'"'dmain','danti'}:
            h=w=random.randint(5,8)
        else:
            h=random.randint(5,8); w=random.randint(5,8)
            if random.random()<0.6:
                while h==w:
                    w=random.randint(5,8)
        cols=random.sample(PALETTE, random.randint(3,5))
        grid=np.zeros((h,w),dtype=int)
        obs=orbits((h,w),sym)
        random.shuffle(obs)
        for orb in obs:
            color=random.choice(cols)
            for r,c in orb: grid[r,c]=color
        sats=[s for s in candidates((h,w)) if sat(grid,s)]
        if sats"'!=[sym]:
            continue
        if len(set(grid.flat))<3:
            continue
        return grid
    raise RuntimeError('"'no pattern')

def merged_and_candidates(pattern,lmask,rmask):
    left=pattern.copy(); right=pattern.copy(); left[lmask]=OCC; right[rmask]=OCC
    merged=np.full(pattern.shape,-1,dtype=int)
    unknown=np.zeros(pattern.shape,dtype=bool)
    h,w=pattern.shape
    for r in range(h):
        for c in range(w):
            lv,rv=left[r,c],right[r,c]
            if lv"'!=OCC and rv!=OCC:
                assert lv==rv
                merged[r,c]=lv
