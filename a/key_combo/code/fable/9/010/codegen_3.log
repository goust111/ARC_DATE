0653: def collision(
0654:     *,
0655:     object1: np.ndarray,
0656:     object2: np.ndarray,
0657:     r1: int = 0,
0658:     c1: int = 0,
0659:     r2: int = 0,
0660:     c2: int = 0,
0661:     background: int = Color.BLACK,
0662: ) -> bool:
0663:     """Return True iff non-background pixels overlap with object2 placed at (r2,c2) relative to object1 at (r1,c1)."""
0664:     bg = int(background)
0665:     a = object1
0666:     b = object2
0667:     H1, W1 = a.shape
0668:     H2, W2 = b.shape
0669: 
0670:     dr = int(r2) - int(r1)
0671:     dc = int(c2) - int(c1)
0672: 
0673:     ra0 = max(0, dr)
0674:     ca0 = max(0, dc)
0675:     ra1 = min(H1, dr + H2)
0676:     ca1 = min(W1, dc + W2)
0677:     if ra0 >= ra1 or ca0 >= ca1:
0678:         return False
0679: 
0680:     rb0 = ra0 - dr
0681:     cb0 = ca0 - dc
0682:     rb1 = rb0 + (ra1 - ra0)
0683:     cb1 = cb0 + (ca1 - ca0)
0684:     return bool(((a[ra0:ra1, ca0:ca1] != bg) & (b[rb0:rb1, cb0:cb1] != bg)).any())
0685: 
