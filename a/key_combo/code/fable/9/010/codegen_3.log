+import random
+
+import numpy as np
+
+
+BACKGROUND = 0
+OCCLUDER = 5
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+GEN_RETRIES = 800
+SYMMETRY_NAMES = ("vm", "hm", "r180", "dmain", "danti")
+
+
+def _valid_symmetries(shape: tuple[int, int]) -> list[str]:
+    h, w = map(int, shape)
+    out = ["vm", "hm", "r180"]
+    if h == w:
+        out.extend(["dmain", "danti"])
+    return out
+
+
+def _map_coord(symmetry: str, r: int, c: int, shape: tuple[int, int]) -> tuple[int, int]:
+    h, w = map(int, shape)
+    if symmetry == "vm":
+        return r, w - 1 - c
+    if symmetry == "hm":
+        return h - 1 - r, c
+    if symmetry == "r180":
+        return h - 1 - r, w - 1 - c
+    if symmetry == "dmain":
+        return c, r
+    if symmetry == "danti":
+        return h - 1 - c, w - 1 - r
+    raise ValueError(f"unknown symmetry: {symmetry}")
+
+
+def _orbits(shape: tuple[int, int], symmetry: str) -> list[tuple[tuple[int, int], ...]]:
+    h, w = map(int, shape)
+    seen: set[tuple[int, int]] = set()
+    out: list[tuple[tuple[int, int], ...]] = []
+    for r in range(h):
+        for c in range(w):
+            if (r, c) in seen:
+                continue
+            orbit = {(r, c)}
+            mate = _map_coord(symmetry, r, c, shape)
+            orbit.add(mate)
+            canon = tuple(sorted(orbit))
+            seen.update(canon)
+            out.append(canon)
+    return out
+
+
+def _satisfies_symmetry(grid: np.ndarray, symmetry: str) -> bool:
+    h, w = map(int, grid.shape)
+    for r in range(h):
+        for c in range(w):
+            rr, cc = _map_coord(symmetry, r, c, grid.shape)
+            if int(grid[r, c]) != int(grid[rr, cc]):
+                return False
+    return True
+
+
+def _merge_panels(left: np.ndarray, right: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
+    assert left.shape == right.shape
+    h, w = map(int, left.shape)
+    merged = np.full((h, w), -1, dtype=int)
+    unknown = np.zeros((h, w), dtype=bool)
+    for r in range(h):
+        for c in range(w):
+            lv = int(left[r, c])
+            rv = int(right[r, c])
+            if lv != OCCLUDER and rv != OCCLUDER:
+                assert lv == rv
+                merged[r, c] = lv
+            elif lv != OCCLUDER:
+                merged[r, c] = lv
+            elif rv != OCCLUDER:
+                merged[r, c] = rv
+            else:
+                unknown[r, c] = True
+    return merged, unknown
+
