+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    h, total_w = map(int, g.shape)
+    assert total_w % 2 == 1
+    mid = total_w // 2
+    sep_col = g[:, mid]
+    assert np.all(sep_col == sep_col[0])
+    bg = int(sep_col[0])
