+
+def _render_input(grid_h: int, grid_w: int, cups: list[dict[str, int]], budget: int, control_color: int) -> np.ndarray:
+    grid = np.full((grid_h, grid_w), BG, dtype=int)
+    grid[0, :budget] = control_color
+
