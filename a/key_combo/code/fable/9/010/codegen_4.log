+    profile = _budget_profile(cups, order, budget)
+    if profile["partial_pos"] is not None and profile["visible_partial"]:
+        if np.array_equal(
+            expected,
+            _apply_budget(inp, cups, budget, order, row_order="bottom_up", col_order="right_to_left"),
+        ):
