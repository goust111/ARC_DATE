+    cap_desc = sorted(range(CUP_COUNT), key=lambda idx: -cups[idx]["capacity"])
+    high_first = sorted(range(CUP_COUNT), key=lambda idx: (cups[idx]["bottom"], cups[idx]["left"]))
+    if order == left_order or order == cap_desc or order == high_first:
+        return False
