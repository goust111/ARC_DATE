+        grid[top, right] = WALL
+        grid[top + 1 : bottom, left] = WALL
+        grid[top + 1 : bottom, right] = WALL
+        grid[bottom, left : right + 1] = WALL
+    return grid
+
+
+def _validate_semantics(inp: np.ndarray, cups: list[dict[str, int]], order: list[int], budget: int) -> bool:
