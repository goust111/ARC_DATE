+                    tied_pairs = [(i, j) for i in range(CUP_COUNT) for j in range(i + 1, CUP_COUNT) if bottoms[i] == bottoms[j]]
+                    if len(tied_pairs) != 1 or tied_pairs[0][1] - tied_pairs[0][0] != 1:
