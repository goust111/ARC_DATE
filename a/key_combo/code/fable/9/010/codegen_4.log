        gap_offsets = np.flatnonzero(top == bg)
        assert len(gap_offsets) == 1
        gap = c0 + int(gap_offsets[0])

        left_cap = gap - 2 >= c0 and np.all(g[r0, gap - 2 : gap] == Color.GREY)
