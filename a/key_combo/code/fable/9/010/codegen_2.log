+def _crossings(segments: list[dict]) -> list[tuple[tuple[int, int], dict, dict]]:
+    found: list[tuple[tuple[int, int], dict, dict]] = []
+    for i, first in enumerate(segments):
+        for second in segments[i + 1 :]:
