    grid[r0, c0 : c0 + gap_off] = _GEN_GREY
    grid[r0, c0 + gap_off + 1 : c0 + _FRAME_WIDTH] = _GEN_GREY
    grid[r0 + 1 : r1, c0] = _GEN_GREY
    grid[r0 + 1 : r1, c1] = _GEN_GREY
