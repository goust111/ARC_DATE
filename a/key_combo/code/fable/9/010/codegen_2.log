+    for seg in sorted(segments, key=lambda item: int(item["hole_count"])):
+        draw_line(
+            out,
+            int(seg["r0"]),
+            int(seg["c0"]),
+            end_r=int(seg["r1"]),
+            end_c=int(seg["c1"]),
+            color=int(seg["color"]),
+        )
+    return out
