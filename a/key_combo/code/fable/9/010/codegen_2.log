+    for (rr, cc), seg_a, seg_b in crossings:
+        winner = seg_a if int(seg_a["hole_count"]) > int(seg_b["hole_count"]) else seg_b
+        if int(expected[rr, cc]) != int(winner["color"]):
+            return False
+
+    for seg in segments:
+        if seg["orient"] == "h":
+            if np.any(inp[int(seg["r0"]), int(seg["c0"]) : int(seg["c1"]) + 1] != BG):
