+        if not roomy:
+            return None
+        r0, c0, hh, ww = random.choice(roomy)
+        choices = [(r, c) for r in range(r0, r0 + hh) for c in range(c0, c0 + ww)]
+        mr, mc = random.choice(choices)
+        sprite[mr, mc] = int(marker_color)
