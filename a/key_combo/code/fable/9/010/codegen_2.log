spec:
  grid: 9-15 rows x 11-17 cols, black background
  objects:
    count: 3-4 per grid, all teal (color 8), 4-connected
    bbox: 3-8 rows x 3-10 cols
    walls: 1px thick [observed], forming closed outlines with 1-4 enclosed holes
    holes: 4-connected black regions fully inside object; each hole 1-8 pixels
    pixel_count: 8-28 per object
  placement:
    min_chebyshev_gap: >=2 pixels between any two objects
    objects may touch grid border [observed]
    teal_fill_ratio: 0.28-0.37 [observed]
  transform:
    recolor each object by its hole count, 1->blue 2->green 3->red 4->yellow
    background unchanged; output same size as input

generation_strategy:
  approach: direct construction (transform is trivial recoloring)
  steps:
    1. Pick grid size H in [9,15], W in [11,17]
    2. For each of 3-4 objects, pick a target hole count (1-4)
    3. Build each object as a 1px-thick teal boundary enclosing the desired
       number of 4-connected black holes; vary shape irregularly (L-shapes,
       T-shapes, rectangles with internal walls) within bbox 3-8 x 3-10
    4. Place objects on the grid with >=2 Chebyshev gap between any pair
    5. Validate each object has exactly the intended hole count via flood-fill
