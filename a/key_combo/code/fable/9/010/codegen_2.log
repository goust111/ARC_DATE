_FRAME_RIGHT_OFFSET = _FRAME_WIDTH - 1
_FRAME_TOP_ROW_MIN, _FRAME_COL_MIN = 1, 0
_FRAME_COUNT_RANGE, _FRAME_HEIGHT_RANGE = (1, 2), (3, 5)
