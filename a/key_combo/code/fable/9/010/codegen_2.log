+
+
+def _validate_scene(inp: np.ndarray, pair_defs: list[dict], segments: list[dict]) -> bool:
+    if max(inp.shape) > 30:
+        return False
+
+    expected = _draw_expected(inp, segments)
+    actual = main(inp)
+    if not np.array_equal(actual, expected):
