+            v_seg = second if first["orient"] == "h" else first
+            if h_seg["c0"] <= v_seg["c0"] <= h_seg["c1"] and v_seg["r0"] <= h_seg["r0"] <= v_seg["r1"]:
+                found.append(((int(h_seg["r0"]), int(v_seg["c0"])), h_seg, v_seg))
