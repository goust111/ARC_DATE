+BG = 0
+GRID_MIN = 20
+GRID_MAX = 29
+PAIR_COUNT_CHOICES = (2, 3)
+GEN_ATTEMPTS = 400
+OBJECT_COLORS = (1, 2, 3, 5, 6, 7, 8, 9)
+MARKER_COLORS = (1, 2, 3, 4, 5, 6, 7, 8, 9)
+CELL_SIZES = (1, 3)
