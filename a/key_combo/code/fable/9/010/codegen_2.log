+def _extra_pair_candidates(
+    pair_def: dict,
+    grid_h: int,
+    grid_w: int,
+    used_boxes: list[tuple[int, int, int, int]],
+    cross_row: int,
+    cross_col: int,
+) -> list[dict]:
+    candidates: list[dict] = []
+    sprite_a = pair_def["placements"][0]["sprite"]
