+    first_seq = ordered_rings[0]["seq"]
+    grey_idx = int(np.flatnonzero(first_seq == GREY)[0])
+    target_idx = MARKER_TARGET_INDEX[marker_dir]
+    cw_steps = (target_idx - grey_idx) % 8
+    ccw_steps = (grey_idx - target_idx) % 8
