    r1 = r0 + h - 1
    c1 = c0 + _FRAME_RIGHT_OFFSET
    gap_off = _gen_gap_offset(side)
    cells = [(r0, c0 + dc) for dc in range(_FRAME_WIDTH) if dc != gap_off]

    for r in range(r0 + 1, r1):
