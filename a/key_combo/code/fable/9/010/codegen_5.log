    if len(solutions) != 1:
        return False
    if solutions[0][0] != symmetry:
        return False
    if not np.array_equal(solutions[0][1], pattern):
        return False

    rendered = _render_input(pattern, left_mask, right_mask)
    if not np.array_equal(main(rendered), pattern):
        return False
    return True


