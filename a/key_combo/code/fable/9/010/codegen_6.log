+        return (0, 0, top_h, w), (h - bottom_h, 0, h, w)
+    left_w = int(rng.integers(1, w))
+    right_w = int(rng.integers(1, w - left_w + 1))
+    while left_w + right_w > w:
+        left_w = int(rng.integers(1, w))
