+
+def _infer_sprite_shape(shape: tuple[int, int]) -> tuple[int, int]:
+    rows, cols = map(int, shape)
+    h = math.isqrt(rows)
+    w = math.isqrt(cols)
+    assert h * h == rows and w * w == cols, "input must be h^2 by w^2"
+    return h, w
