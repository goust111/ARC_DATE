def _gen_expected_output(inp, frames):
    out = inp.copy()
    for frame in frames:
        r0, c0, h, _side = frame
        r1 = r0 + h - 1
        c1 = c0 + _FRAME_RIGHT_OFFSET
        fill = out[r0:r1, c0 + 1 : c1]
