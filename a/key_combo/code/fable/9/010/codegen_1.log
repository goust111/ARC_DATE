+    if needed >= len(coords):
+        return None
+
+    cursor = 0
+    direct_cells = coords[cursor : cursor + direct_count]
+    cursor += direct_count
+    indirect_cells = coords[cursor : cursor + indirect_count]
+    cursor += indirect_count
+    same_cells = coords[cursor : cursor + same_count]
