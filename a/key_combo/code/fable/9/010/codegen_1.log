+    out = np.full(left.shape, bg, dtype=int)
+    for r in range(left.shape[0]):
+        for c in range(left.shape[1]):
+            a = int(left[r, c])
+            b = int(right[r, c])
+            if a == bg:
+                out[r, c] = b
+            elif b == bg or a == b:
+                out[r, c] = a
+            else:
+                out[r, c] = a if rank[a] < rank[b] else b
