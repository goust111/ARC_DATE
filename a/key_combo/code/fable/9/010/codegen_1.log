+
+def _side_pair_starts(pair_count: int, side_width: int, rng: random.Random) -> list[int]:
+    if pair_count == 0:
+        return []
+    extra = side_width - _side_min_width(pair_count)
+    assert extra >= 0
+    extras = _random_composition(extra, pair_count + 1, rng)
+    starts = []
+    cursor = extras[0]
+    for idx in range(pair_count):
