+
+
+def _has_unique_separator(main_region: np.ndarray, sep: int, sep_color: int) -> bool:
+    for c in range(main_region.shape[1]):
+        col = main_region[:, c]
+        if c == sep:
+            if not (np.all(col == sep_color) and sep_color != BG):
+                return False
+            continue
+        if col[0] != BG and np.all(col == col[0]):
