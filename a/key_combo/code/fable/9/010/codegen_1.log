{
  "type": "move_along_path",
  "src": "grey 4-connected open-top rectangular frame s with a one-cell top gap and a two-pixel top cap on one side",
  "path": "from the column of s.top_gap on the row above s, travel horizontally toward the side with the two-pixel top cap until the grid edge",
  "trajectory": "paint every background pixel on that row segment red",
  "transform": "preserve the grey frame; also recolor background pixels inside the frame and the top gap red"
}
</annotation>
<generation_spec>
