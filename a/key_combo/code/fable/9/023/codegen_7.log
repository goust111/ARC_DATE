spec:
  task: pack scattered polyomino fragments into a solid 3x4 rectangle
  output:
    shape: 3x4 (always)
    content: fully filled with 3 distinct non-zero colors, no background
    each_color_region: one or more 4-connected polyomino pieces that together tile the rectangle
  input:
    grid: 10 rows x 10-13 cols
    background: 0
    border: all background [observed]
    fragments: 3-5 monochromatic 4-connected polyominoes, exactly 3 distinct non-zero colors
    total_area: 12 (= 3x4)
    individual_areas: range 1-7; largest fragment 5-7 cells [observed]
