  "src": "foreground seed colors on the middle row at the first triangular columns 0, 1, 3, ...",
  "dst": "all triangular columns on the same row within the grid width",
  "transform": "repeat the seed colors cyclically at those columns and leave every other pixel as background"
}
</annotation>
<generation_spec>
```yaml
spec:
  grid: 3 rows x 19-29 cols, background color 0
  active_row: always row 1 (middle row); rows 0 and 2 are entirely background
  triangular_columns: positions 0, 1, 3, 6, 10, 15, 21, 28, ... (gaps increase by 1 each step)
  seed:
    colors: 2-3 distinct non-zero colors placed at the first 2-3 triangular columns
    all_distinct: true [observed]
  output:
    same grid dimensions; fill ALL triangular columns within grid width with the seed colors repeated cyclically
    total_tri_cols: 6-8 (determined by width)
    new_cols_added: 3-6 (total_tri_cols minus seed count)
  width_constraint: must yield >=4 total triangular cols AND at least 2 more than seed count

generation_strategy:
  approach: direct construction (simple task, no inversion needed)
  steps:
    1. Pick width W from range 15-30 such that total triangular columns T >= 4
    2. Pick cycle_len K from {2, 3}
    3. Ensure T > K (output extends beyond seed)
    4. Choose K distinct non-zero colors (1-9)
    5. Build 3xW grid of zeros; place colors at first K triangular columns on row 1 => input
    6. Build output by placing cycled colors at ALL T triangular columns on row 1
```
