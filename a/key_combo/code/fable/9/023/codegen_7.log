  "dst": "compact 3x4 rectangle packed from top-left to bottom-right",
  "transform": "discard background spacing; preserve each fragment color; rotate or reflect fragments as needed so all foreground cells tile the rectangle without overlap",
  "multi_step": "for each ordered fragment, try identity/reflected/rotated orientations and top-left scan positions; keep the first complete tiling",
  "grid_shape": "3x4"
}
</annotation>
<generation_spec>
