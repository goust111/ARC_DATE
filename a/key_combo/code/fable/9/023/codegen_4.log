+
+    return {
+        "bg": bg,
+        "bar_color": bar_color,
+        "source_cols": source_cols,
+        "source_colors": source_colors,
+        "target_col": target_col,
+        "bars_by_row": bars_by_row,
+        "traces": traces,
+        "winner_idx": winners[0],
