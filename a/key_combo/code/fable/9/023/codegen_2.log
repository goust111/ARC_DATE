+    tile_mask = seed_mask[sr0 : sr1 + 1, sc0 : sc1 + 1]
+    assert tile_mask.shape[0] >= 1 and tile_mask.shape[1] >= 1
+    assert _bbox_mask(tile_mask) == (0, 0, tile_mask.shape[0] - 1, tile_mask.shape[1] - 1)
