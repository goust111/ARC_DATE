+
+
+MAX_ATTEMPTS = 500
+GRID_MIN = 18
+GRID_MAX = 30
+GAP = 2
+BORDER = 1
+ALL_COLORS = tuple(range(10))
+WALL_COLORS = tuple(range(1, 10))
+
+
+def _rect_separated(a: BBox, b: BBox, gap: int) -> bool:
