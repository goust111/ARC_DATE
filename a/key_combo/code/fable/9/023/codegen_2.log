    no_background: no black (0) cells [observed]
  output:
    grid: exactly 9x9 (3x3 mosaic of tiles)
    layout: |
      The 9x9 output is a 3x3 arrangement of reflected copies of the input tile T:
        [T[::-1,::-1]  T[::-1,:]  T[::-1,::-1]]
        [T[:,::-1]     T          T[:,::-1]    ]
        [T[::-1,::-1]  T[::-1,:]  T[::-1,::-1]]
      Center = original. Vertical neighbors = row-reversed.
      Horizontal neighbors = col-reversed. Corners = both reversed.
      This creates seamless mirror-reflection wallpaper.

