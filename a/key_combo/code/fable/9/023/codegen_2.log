+    for block_r in range(cavity_h // tile_h):
+        for block_c in range(cavity_w // tile_w):
+            color = legend[(p + block_r - seed_block_r + block_c - seed_block_c) % len(legend)]
+            r0 = block_r * tile_h
+            c0 = block_c * tile_w
+            patch = out[r0 : r0 + tile_h, c0 : c0 + tile_w]
