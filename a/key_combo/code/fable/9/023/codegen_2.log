+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+
+    wall = _get_bg(g)
+    components = _components_mask(g != wall)
+    legend_coords, legend = _find_legend_component(g, components)
+    legend_set = {tuple(map(int, rc)) for rc in legend_coords}
