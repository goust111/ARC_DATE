+def _rect_separated(a: BBox, b: BBox, gap: int) -> bool:
+    return (
+        a[2] + gap < b[0]
+        or b[2] + gap < a[0]
+        or a[3] + gap < b[1]
+        or b[3] + gap < a[1]
+    )
