+    elif idx == 1:
+        out = np.stack([r, -c], axis=1)
+    elif idx == 2:
+        out = np.stack([-r, c], axis=1)
+    elif idx == 3:
+        out = np.stack([-r, -c], axis=1)
+    elif idx == 4:
+        out = np.stack([c, r], axis=1)
+    elif idx == 5:
