+    max_h = max(v["box"][2] + 1 for v in variants)
+    max_w = max(v["box"][3] + 1 for v in variants)
+    min_h = max(16, max_h + 4)
+    min_w = max(16, max_w + 4)
+    if min_h > 30 or min_w > 30:
