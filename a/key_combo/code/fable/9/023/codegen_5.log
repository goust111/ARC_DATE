+def _normalize_coords(coords: np.ndarray) -> tuple[tuple[tuple[int, int], ...], np.ndarray, np.ndarray]:
+    arr = np.asarray(coords, dtype=int)
+    mins = arr.min(axis=0)
+    shifted = arr - mins
+    key = tuple(sorted((int(r), int(c)) for r, c in shifted))
