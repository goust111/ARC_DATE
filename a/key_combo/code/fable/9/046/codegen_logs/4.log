+def _gen_attempt() -> np.ndarray | None:
+    rows = random.randint(*GRID_ROWS_RANGE)
+    cols = random.randint(*GRID_COLS_RANGE)
+    roles = _sample_role_colors()
+    legend = _build_legend(roles)
