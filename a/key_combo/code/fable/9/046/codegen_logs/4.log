+    return out
+
+
+def _wrong_tiled_output(grid: np.ndarray, object_bboxes: list[tuple[int, int, int, int]], legend: np.ndarray) -> np.ndarray:
+    out = grid.copy()
+    for r0, c0, r1, c1 in object_bboxes:
