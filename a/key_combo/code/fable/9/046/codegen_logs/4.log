def random_sprite(
    m,
    n,
    *,
    density: float = 0.5,
    symmetry: str | None = None,
    color_palette: list[int] | None = None,
    connectivity: int = 4,
    background: int = Color.BLACK,
    no_repeated_colors: bool = False,
