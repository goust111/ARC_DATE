+def _neighbors8(r: int, c: int, h: int, w: int):
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            rr = r + dr
+            cc = c + dc
+            if 0 <= rr < h and 0 <= cc < w:
+                yield rr, cc
