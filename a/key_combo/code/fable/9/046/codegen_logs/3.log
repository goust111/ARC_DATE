+    cols = []
+    for rect in rects:
+        r0, c0, r1, c1 = _rect_bounds(rect)
+        rows.extend([r0, r1])
+        cols.extend([c0, c1])
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _place_spark(rects: list[tuple[int, int, int, int]], root_idx: int) -> tuple[int, int] | None:
+    root = rects[root_idx]
+    r0, c0, r1, c1 = _rect_bounds(root)
