+        r0 = random.randint(ar0 - h + 1, ar1)
+    elif direction == "L":
+        c1 = ac0 - gap
+        c0 = c1 - w + 1
+        r0 = random.randint(ar0 - h + 1, ar1)
+    elif direction == "D":
+        r0 = ar1 + gap
+        c0 = random.randint(ac0 - w + 1, ac1)
+    else:
+        r1 = ar0 - gap
+        r0 = r1 - h + 1
