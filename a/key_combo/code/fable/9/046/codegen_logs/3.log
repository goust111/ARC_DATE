+        return None
+
+    spark = _place_spark(rects, root_idx=0)
+    if spark is None:
+        return None
+
+    grid = _render_scene(rects, spark)
+    if grid is None:
+        return None
+    if not _validate_generated_input(grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
