+def _point_rect_distance(point: tuple[int, int], rect: tuple[int, int, int, int]) -> int:
+    pr, pc = point
+    r0, c0, r1, c1 = _rect_bounds(rect)
+    if pr < r0:
+        row_gap = r0 - pr
+    elif pr > r1:
+        row_gap = pr - r1
+    else:
+        row_gap = 0
+    if pc < c0:
+        col_gap = c0 - pc
+    elif pc > c1:
+        col_gap = pc - c1
+    else:
+        col_gap = 0
+    return int(max(row_gap, col_gap))
+
