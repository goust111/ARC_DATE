+            c1 = c0 + ow - 1
+            rr0, cc0, rr1, cc1 = _expand_bounds(r0, c0, r1, c1, shape, PLACEMENT_PADDING)
+            if bool(reserved[rr0 : rr1 + 1, cc0 : cc1 + 1].any()):
+                continue
