+def _place_objects(shape: tuple[int, int], objects: list[dict]) -> tuple[np.ndarray, np.ndarray] | None:
+    h, w = shape
+    inp = np.zeros((h, w), dtype=int)
+    expected = np.zeros((h, w), dtype=int)
+    reserved = np.zeros((h, w), dtype=bool)
