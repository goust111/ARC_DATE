+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+KINDS = ("H", "V", "D", "A")
+COLOR_POOL = tuple(range(1, 10))
+GRID_ROWS = (18, 28)
+GRID_COLS = (18, 28)
+EXTRA_OBJECTS = (0, 1, 2)
+NOISE_COUNT = (2, 6)
+PLACEMENT_PADDING = 1
+GEN_RETRIES = 400
