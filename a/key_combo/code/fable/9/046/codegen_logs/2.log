+    options = _shape_options(kind)
+    for _ in range(MASK_RETRIES):
+        h, w = random.choice(options)
+        mask = _base_mask(kind, h, w)
+        lower, upper = _area_target(kind, h, w, int(mask.sum()))
+        target = random.randint(lower, upper)
