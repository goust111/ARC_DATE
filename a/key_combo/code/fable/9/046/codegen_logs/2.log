+
+def _orbit(kind: str, shape: tuple[int, int], r: int, c: int) -> tuple[tuple[int, int], ...]:
+    h, w = shape
+    if kind == "H":
+        cells = {(r, c), (h - 1 - r, c)}
+    elif kind == "V":
