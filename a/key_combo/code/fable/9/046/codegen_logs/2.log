    for idx, coords in enumerate(yellow_objects):
        if idx in used_yellow:
            continue

        cols = coords[:, 1]
        if np.all(cols < axis_col):
            side = -1
        elif np.all(cols > axis_col):
            side = 1
        else:
            continue

        touches_axis = any(
            int(r) in axis_rows and int(c) - side == axis_col
            for r, c in coords
        )
        if touches_axis:
            candidates.append((idx, coords))

