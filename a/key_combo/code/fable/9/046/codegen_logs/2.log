  "type": "symmetry/pattern",
  "src": "8-connected yellow object s touching one side of a contiguous red vertical mirror segment, plus the lone marker pixel in s's reflected footprint",
  "dst": "opposite-side mirror footprint of s across the red segment",
  "transform": "paint every pixel of dst with the marker color; preserve the original yellow object, red segment, and marker"
}
</annotation>
<generation_spec>
```yaml
spec:
  grid: 14-16 rows x 16-18 cols, background BLACK
  num_segments: 2-4 red vertical mirror-axis segments per grid
  red_segment:
    shape: contiguous vertical line in a single column, length 3-6
  yellow_object:
    connectivity: 8-connected, one per red segment, touching axis on one side (left or right)
    row_span: identical to its red segment's row span
    width: 2-5 cols, density 40-75% within bounding box
    shape: irregular blob, not necessarily adjacent on every segment row
  marker:
    count: exactly 1 per segment, located in the reflected footprint of the yellow object
    color: unique non-{BLACK, RED, YELLOW} color per segment; all markers use distinct colors
    position: distance 2-4 cols from axis; rest of reflected footprint is BLACK
  isolation: full extents (yellow + red + reflected) of all segments are non-overlapping
  transform: reflect yellow object across red axis column, paint reflected copy with marker color

generation_strategy:
  approach: output-first
  steps:
    1. Choose grid size 14-16 x 16-18 and N=2-4 segments
    2. For each segment, build the complete unit (yellow + red axis + reflected colored copy):
       a. Pick red axis column and row range (length 3-6)
       b. Generate a random 8-connected yellow blob spanning exactly that row range, width 2-5, density 40-75%
       c. Assign side (left or right of axis) for yellow; place yellow adjacent to axis on that side
       d. Compute reflected copy across axis; pick a unique marker color, place one marker pixel among reflected cells
    3. Place all units on grid ensuring bounding boxes (yellow + axis + reflected) do not overlap and fit within grid
    4. Derive input by keeping yellow, red, and single marker pixel; erase the rest of reflected copy
