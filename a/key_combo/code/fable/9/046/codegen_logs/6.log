            for h2 in RECT_HEIGHT_OPTIONS:
                for w2 in RECT_WIDTH_OPTIONS:
                    if h1 + h2 + MIN_EMPTY_GAP <= GRID_SIZE or w1 + w2 + MIN_EMPTY_GAP <= GRID_SIZE:
