+        dr = 0 if target[0] == r else (1 if target[0] > r else -1)
+        dc = 0 if target[1] == c else (1 if target[1] > c else -1)
+        if dr != 0 and dc != 0 and random.random() < 0.45:
+            if random.random() < 0.5:
+                dc = 0
+            else:
