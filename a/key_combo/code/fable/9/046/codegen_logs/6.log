+        return False
+    if not np.all(sprite[-1, :] == FRAME_COLOR):
+        return False
+    if not np.all(sprite[:, 0] == FRAME_COLOR):
+        return False
+    if not np.all(sprite[:, -1] == FRAME_COLOR):
+        return False
+    if not np.all(sprite[1:-1, 1:-1] == BG_COLOR):
