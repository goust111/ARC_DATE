+    assert g.ndim == 2 and g.size > 0, "expected a non-empty 2D grid"
+
+    bg = _get_bg(g)
+    colors = sorted(int(v) for v in np.unique(g) if int(v) != bg)
+    assert len(colors) == 1, "expected exactly one foreground color"
+    fg = colors[0]
