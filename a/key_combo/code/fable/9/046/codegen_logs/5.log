+    norm -= norm.min(axis=0)
+    norm += 1
+    h = int(norm[:, 0].max()) + 2
+    w = int(norm[:, 1].max()) + 2
+    mask = np.zeros((h, w), dtype=bool)
+    center_list = []
+    for r, c in norm:
+        rr = int(r)
+        cc = int(c)
