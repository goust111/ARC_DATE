                cov=frozenset(idx[(rr,cc)] for rr in range(r-1,r+2) for cc in range(c-1,c+2))
                cands.append((r,c)); covers.append(cov)
    by=[[] for _ in cells]
    for i,cov in enumerate(covers):
        for x in cov: by[x].append(i)
    best=[10**9]; count=[0]
    rem0=frozenset(range(len(cells)))
    def rec(rem, chosen):
