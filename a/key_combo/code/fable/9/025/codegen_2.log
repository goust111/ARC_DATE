+MIN_BBOX_HEIGHT = 3
+MIN_BBOX_WIDTH = 5
+MAX_BBOX_HEIGHT = 8
+MAX_BBOX_WIDTH = 11
+MAX_GENERATION_ATTEMPTS = 500
