spec:
  grid: 5-10 rows x 5-10 cols, black background
  colors: input uses only BLACK and BLUE; output adds RED
  bars:
    count: 2-5 horizontal dashed bars per grid
    structure: each bar is a sequence of BLUE pixels at every-other column on a single row (cols spaced by 2), creating 1-cell BLACK gaps between consecutive BLUE pixels
    blue_pixels_per_bar: 2-4
    span: 2*blue_count - 1 columns (3, 5, or 7)
    placement: at most 1 bar per row; bar must fit within grid width
