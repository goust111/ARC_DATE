def _gen_marker_patch(color):
    patch = np.full((3, 3), GEN_TRANSPARENT, dtype=int)
    patch[1, 1] = GEN_YELLOW
    patch[(0, 2, 1, 1), (1, 1, 0, 2)] = color
    return patch


