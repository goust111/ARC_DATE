+        if period != int(spec["period"]) or phase != int(spec["phase"]):
+            return None
+        if sorted(missing) != sorted(spec["missing"]):
+            return None
+
+    periods = {int(spec["period"]) for spec in row_payloads.values()}
+    if len(periods) < 2:
+        return None
+    return grid
+
