        span = DASH_STEP * blue_count - 1
        start_col = random.randint(0, width - span)
        grid[row, start_col : start_col + span : DASH_STEP] = Color.BLUE
    fill_mask = np.zeros((height, width), dtype=bool)
    fill_mask[:, 1:-1] = (
        (grid[:, 1:-1] == Color.BLACK)
        & (grid[:, :-2] == Color.BLUE)
        & (grid[:, 2:] == Color.BLUE)
