    for size in _gen_component_sizes(target):
        comp = _gen_place_component(blocked, noise, size)
        if comp is None:
            return None
        for r, c in comp:
            noise[r, c] = True

    return noise


def _gen_add_singletons(blocked, noise, target):
    candidates = np.argwhere(~blocked & ~noise)
