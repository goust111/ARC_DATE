+    usable_w = width - 2
+    return ((usable_h + GEN_CENTER_GAP - 1) // GEN_CENTER_GAP) * ((usable_w + GEN_CENTER_GAP - 1) // GEN_CENTER_GAP)
+
+
+def _sample_templates() -> list[dict[str, object]]:
