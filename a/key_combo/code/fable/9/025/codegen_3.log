    noise_mask = _gen_add_singletons(marker_mask, noise_mask, singleton_n)
    if noise_mask is None:
        return None

    _gen_paint_noise(grid, noise_mask, noise_n, arm_assignments)
    return grid if _gen_passes_oracle(grid, answer) else None


def generate_input():
