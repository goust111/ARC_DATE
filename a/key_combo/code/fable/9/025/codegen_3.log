        r, c = random.choice(pool)
        inp[r, c] = color
        occupied_controls[r, c] = True
    return True


def _gen_attempt():
    H, W, side, colors, fill_color, motif_color = _gen_choose_scene()
    motif_result = _gen_symmetric_motif_patch(H, W)
    if motif_result is None:
