+def _complete_signature(grid: np.ndarray, r: int, c: int, bg: int) -> tuple[int, int, tuple[tuple[int, int], ...]] | None:
+    if not in_bounds(grid.shape, r, c):
+        return None
+    center = int(grid[r, c])
+    if center == bg:
+        return None
