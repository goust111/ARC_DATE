+
+def _paint_full(out: np.ndarray, r: int, c: int, center: int, shell: int, offsets: tuple[tuple[int, int], ...]) -> None:
+    out[r, c] = int(center)
+    for dr, dc in offsets:
+        out[r + dr, c + dc] = int(shell)
