+GEN_TRUE_TEMPLATE_RANGE = (1, 2)
+GEN_FALSE_TEMPLATE_RANGE = (1, 2)
+GEN_TRUE_COMPLETE_RANGE = (2, 3)
+GEN_EXTRA_PARTIAL_RANGE = (0, 1)
