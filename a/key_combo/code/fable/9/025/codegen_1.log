        er, ec = records[color]["endpoint"]
        out[er, ec] = color
    for r, c in yellow_cells:
        out[r, c] = YELLOW

    return inp, out


def _gen_attempt() -> np.ndarray | None:
    n = int(np.random.randint(*GRID_SIZE_RANGE))
    count = int(np.random.randint(*MARKER_COUNT_RANGE))
