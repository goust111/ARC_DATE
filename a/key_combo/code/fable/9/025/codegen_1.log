  "path": "Chebyshev-shortest path from s toward d: diagonal steps first, then a straight run along the longer axis, with the final step diagonal into d",
  "trajectory": "paint intermediate background pixels green",
  "transform": "preserve the blue/red markers and all other input pixels"
}
</annotation>
<generation_spec>
