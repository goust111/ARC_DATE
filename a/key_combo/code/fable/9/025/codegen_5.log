    """
    cols = set(map(int, grid.flatten()))
    if exclude is not None:
        cols -= set(map(int, exclude))
    return sorted(cols)


def in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
    """Return True iff (r,c) is within a grid of shape (H,W)."""
    H, W = map(int, shape)
