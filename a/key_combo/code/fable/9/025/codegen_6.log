+    row_hi = min(pr0, H - 2)
+    col_lo = max(0, pc1 - 1)
+    col_hi = min(pc0, W - 2)
+    candidates: list[tuple[float, int, int, int, int]] = []
+    for r0 in range(row_lo, row_hi + 1):
+        for c0 in range(col_lo, col_hi + 1):
+            if r0 + 2 >= lr0:
