+        raise AssertionError("pink cells must fit inside one 2x2 legend")
+
+    H, W = g.shape
+    pair_center = (lc0 + rc1) / 2.0
+    row_lo = max(0, pr1 - 1)
+    row_hi = min(pr0, H - 2)
+    col_lo = max(0, pc1 - 1)
+    col_hi = min(pc0, W - 2)
+    candidates: list[tuple[float, int, int, int, int]] = []
+    for r0 in range(row_lo, row_hi + 1):
