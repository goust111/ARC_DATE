+    np.array([[0, 1], [1, 1]], dtype=bool),  # nand
+    np.array([[1, 0], [1, 1]], dtype=bool),  # everything except left-only
+    np.array([[1, 1], [0, 1]], dtype=bool),  # everything except right-only
+    np.array([[1, 1], [1, 0]], dtype=bool),  # or
