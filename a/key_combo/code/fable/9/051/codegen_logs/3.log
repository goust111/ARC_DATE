+    forbid = set() if forbid is None else set(forbid)
+    random.shuffle(candidates)
+    chosen: list[tuple[int, int]] = []
+    for cell in candidates:
+        if cell in forbid:
+            continue
+        if any(abs(cell[0] - r) + abs(cell[1] - c) == 1 for r, c in chosen):
+            continue
+        chosen.append(cell)
+        if len(chosen) == count:
+            return chosen
+    return None
