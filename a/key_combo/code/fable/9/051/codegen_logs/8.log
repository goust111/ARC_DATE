+    grid_rooms: list[list[dict | None]] = [[None for _ in col_starts] for _ in row_starts]
+    row_index = {value: i for i, value in enumerate(row_starts)}
+    col_index = {value: j for j, value in enumerate(col_starts)}
+    for room in rooms:
