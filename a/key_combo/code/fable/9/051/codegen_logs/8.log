+    r0, c0, r1, c1 = room["bbox"]
+    side = room["side"]
+    if side == "top":
+        out[r0 + 1 : r0 + 1 + count, c0 + 1 : c1] = color
+    elif side == "bottom":
+        out[r1 - count : r1, c0 + 1 : c1] = color
+    elif side == "left":
