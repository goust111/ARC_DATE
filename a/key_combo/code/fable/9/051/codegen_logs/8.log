    max_w = blueprint_w + board_gap + rooms_w
    if max_h > 30 or max_w > 30:
        return None

    bp_top = random.randint(0, 2)
    room_top = random.randint(0, 2)
    height = max(bp_top + blueprint_h, room_top + rooms_h)
