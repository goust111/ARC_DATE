+def _bands_from_separator(subgrid: np.ndarray) -> tuple[list[tuple[int, int]], list[tuple[int, int]]]:
+    sep_rows = [r for r in range(subgrid.shape[0]) if np.all(subgrid[r, :] == SEPARATOR)]
