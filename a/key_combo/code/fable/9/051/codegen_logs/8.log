+def _choose_layout() -> dict | None:
+    p, q = random.choice(PQ_CHOICES)
+    cell_h = random.randint(2, 3)
+    cell_w = random.randint(2, 3)
+    room_h = random.randint(cell_h + 1, 5)
+    room_w = random.randint(cell_w + 1, 5)
