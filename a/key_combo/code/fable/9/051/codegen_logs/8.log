+
+BG = Color.BLACK
+SEPARATOR = Color.GREY
+WALL = Color.RED
+MARKER_COLORS = (
+    Color.BLUE,
+    Color.GREEN,
+    Color.YELLOW,
+    Color.PINK,
+    Color.ORANGE,
+    Color.TEAL,
+    Color.MAROON,
+)
+DOOR_SIDES = ("top", "bottom", "left", "right")
+PQ_CHOICES = ((2, 2), (2, 3), (3, 2), (3, 3))
+MAX_ATTEMPTS = 500
