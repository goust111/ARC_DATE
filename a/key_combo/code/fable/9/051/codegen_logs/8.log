+BG = Color.BLACK
+SEPARATOR = Color.GREY
+WALL = Color.RED
+MARKER_COLORS = (
+    Color.BLUE,
+    Color.GREEN,
+    Color.YELLOW,
+    Color.PINK,
+    Color.ORANGE,
+    Color.TEAL,
+    Color.MAROON,
