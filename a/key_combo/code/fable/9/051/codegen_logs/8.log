+    row_mask[sep_rows] = True
+    col_mask[sep_cols] = True
+    expected_sep = row_mask[:, None] | col_mask[None, :]
+    assert np.array_equal(subgrid == SEPARATOR, expected_sep), "separator board must be a clean line grid"
