+    cells: list[list[tuple[int, int, int, int]]] = []
+    for i in range(p):
+        row_cells = []
+        for j in range(q):
+            r0 = top + 1 + i * (cell_h + 1)
+            c0 = left + 1 + j * (cell_w + 1)
+            row_cells.append((r0, c0, r0 + cell_h - 1, c0 + cell_w - 1))
+        cells.append(row_cells)
