+        for j, bbox in enumerate(row):
+            color, count = instructions[i][j]
+            if count == 0:
+                continue
+            r0, c0, r1, c1 = bbox
+            coords = [(r, c) for r in range(r0, r1 + 1) for c in range(c0, c1 + 1)]
+            positions = random.sample(coords, count)
+            for r, c in positions:
+                grid[r, c] = int(color)
