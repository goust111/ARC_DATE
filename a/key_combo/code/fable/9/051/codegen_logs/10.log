                pairs.append([first, second])
    return random.choice(pairs) if pairs else []


def _gen_color_options(
    cell_count: int,
    marker_count: int,
    max_colors: int,
    want_erasure: bool,
) -> list[tuple[int, int | None, list[int]]]:
