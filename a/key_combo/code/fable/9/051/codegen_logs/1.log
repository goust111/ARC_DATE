+
+def mode_ok(mode: str, kmin: int, kmax: int) -> bool:
+    if mode == "twin":
+        return kmin <= -1 and kmax >= 2 and (kmax - kmin + 1) >= 4
+    if mode == "center":
+        return kmin <= -1 and kmax >= 1 and (kmax - kmin + 1) >= 3
+    if mode == "positive":
