+                -(sprites[idx].shape[0] * sprites[idx].shape[1]),
+            ),
+        )
+
+        occupied = np.zeros((h, w), dtype=bool)
+        lanes: list[dict | None] = [None] * lane_count
+        ok = True
+        for idx in order:
+            placement = find_lane_placement((h, w), sprites[idx], v, modes[idx], occupied)
+            if placement is None:
