+
+def can_add_cells(cells: list[tuple[int, int, int]], occupied: np.ndarray) -> bool:
+    for r, c, _color in cells:
+        if occupied[r, c]:
+            return False
+        for nr, nc in neighbors4(r, c):
+            if 0 <= nr < occupied.shape[0] and 0 <= nc < occupied.shape[1] and occupied[nr, nc]:
+                return False
