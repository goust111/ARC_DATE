+            np.any(rel[:, 0] == 0)
+            or np.any(rel[:, 0] == expected.shape[0] - 1)
+            or np.any(rel[:, 1] == 0)
+            or np.any(rel[:, 1] == expected.shape[1] - 1)
+        )
+    assert hit_boundary
