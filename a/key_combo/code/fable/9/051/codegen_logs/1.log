+def generate_input() -> np.ndarray:
+    for _ in range(MAX_ATTEMPTS):
+        h = random.randint(18, 27)
+        w = random.randint(18, 27)
+        v = random.choice(VECTOR_CHOICES)
+
+        lane_count = random.randint(3, 5)
