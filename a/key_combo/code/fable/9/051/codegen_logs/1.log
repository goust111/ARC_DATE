+            unique_modes.append(random.choice(["center", "positive", "negative"]))
+        random.shuffle(unique_modes)
+        modes = ["twin", *unique_modes]
+
+        forbidden: set[tuple[tuple[int, int], tuple[int, ...]]] = set()
+        sprites: list[np.ndarray] = []
+        try:
