+        slots = range(lane["kmin"], lane["kmax"] + 1) if full_output else lane["seed_slots"]
+        for k in slots:
+            rr = rel[:, 0] + lane["anchor"][0] + k * lane["v"][0]
+            cc = rel[:, 1] + lane["anchor"][1] + k * lane["v"][1]
