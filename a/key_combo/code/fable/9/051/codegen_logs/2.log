+        full_prefixes = [sum(containers[k]["area"] for k in range(i + 1)) for i in range(n)]
+        candidates = []
+        for amount in feasible:
+            if amount in full_prefixes[:-1]:
+                score = 3
+            elif amount > containers[0]["area"]:
+                score = 2
+            else:
