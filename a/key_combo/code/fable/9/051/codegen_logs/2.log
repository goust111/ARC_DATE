+        prev, cur = cur, edge["neighbor"]
+        order.append(cur)
+    assert len(order) == len(containers)
+
+    entry_sides = {order[0]: source_side}
+    for i in range(1, len(order)):
+        cur = order[i]
+        prev_c = order[i - 1]
