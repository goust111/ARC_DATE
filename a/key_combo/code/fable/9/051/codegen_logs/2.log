+SIDES = ("top", "bottom", "left", "right")
+OPPOSITE = {"top": "bottom", "bottom": "top", "left": "right", "right": "left"}
+DIR_TO_SIDE = {(-1, 0): "top", (1, 0): "bottom", (0, -1): "left", (0, 1): "right"}
+LATTICE = (4, 11, 18, 25)
+GEN_RETRIES = 400
