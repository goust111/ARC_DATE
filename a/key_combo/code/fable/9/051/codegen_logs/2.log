    opposite = [(r, c) for r, c in fill_coords if r != mr and c != mc]
    assert len(opposite) == 1, "expected one fill pixel diagonally opposite the marker"
    orow, ocol = opposite[0]
    dr = 1 if orow > mr else -1
    dc = 1 if ocol > mc else -1

