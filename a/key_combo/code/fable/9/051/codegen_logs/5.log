--- _gen_frontier 132-162 ---
 132: def _gen_frontier(labels, blob_id, core_box, band_width):
 133:     h, w = labels.shape
 134:     coords = np.argwhere(labels == blob_id)
 135:     seen = set()
 136:     frontier = []
 137:     for r, c in coords:
 138:         for dr in (-1, 0, 1):
 139:             for dc in (-1, 0, 1):
 140:                 if dr == 0 and dc == 0:
 141:                     continue
 142:                 rr, cc = int(r + dr), int(c + dc)
 143:                 if not (0 <= rr < h and 0 <= cc < w):
 144:                     continue
 145:                 if (rr, cc) in seen or _gen_in_bbox(rr, cc, core_box):
 146:                     continue
 147:                 seen.add((rr, cc))
 148:                 if _gen_edge_dist(rr, cc, h, w) > band_width:
 149:                     continue
 150:                 if _gen_can_add(labels, blob_id, rr, cc):
 151:                     same_neighbors = 0
 152:                     for nr in range(max(0, rr - 1), min(h, rr + 2)):
 153:                         for nc in range(max(0, cc - 1), min(w, cc + 2)):
 154:                             same_neighbors += int(labels[nr, nc] == blob_id)
 155:                     edge_weight = band_width + 1 - _gen_edge_dist(rr, cc, h, w)
 156:                     weight = (
 157:                         FRONTIER_BASE_WEIGHT
 158:                         + FRONTIER_SAME_NEIGHBOR_WEIGHT * same_neighbors
 159:                         + FRONTIER_EDGE_WEIGHT * edge_weight
 160:                     )
 161:                     frontier.append((blob_id, rr, cc, weight))
 162:     return frontier
