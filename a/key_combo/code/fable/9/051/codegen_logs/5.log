  83: def main(grid: np.ndarray) -> np.ndarray:
  84:     """
  85:     Move each gray bar into its adjacent orange rectangle as full stripes from the contacted edge.
  86: 
  87:     Input structure
  88:     - The scene uses black outside space, yellow fill, gray one-cell-thick bars, and solid orange rectangles.
  89:     - Each gray bar 4-touches exactly one orange rectangle; some orange rectangles have no touching gray bar.
  90:     - Gray bars touching the same orange rectangle all have the same orientation.
  91: 
  92:     Rule
  93:     - Recolor every original gray cell to yellow.
  94:     - For each orange rectangle touched by gray bars, count the gray cells assigned to that rectangle.
  95:     - Horizontal gray bars repaint that many cells as complete orange rows starting from the contacted top or bottom row.
  96:     - Vertical gray bars repaint that many cells as complete orange columns starting from the contacted left or right column.
  97:     - Orange rectangles with no touching gray bar remain unchanged.
  98: 
  99:     Key insight
 100:     - The gray pixels are not copied by shape; their count is transferred into the neighboring orange rectangle as edge-aligned row or column stripes.
 101:     """
 102:     g = np.asarray(grid, dtype=int)
 103:     assert g.ndim == 2, "expected a 2D grid"
 104:     assert set(map(int, np.unique(g))) <= {Color.BLACK, Color.YELLOW, Color.GRAY, Color.ORANGE}
 105: 
 106:     orange = find_components(g, bg=Color.YELLOW, colors=[Color.ORANGE], connectivity=4)
 107:     gray = find_components(g, bg=Color.YELLOW, colors=[Color.GRAY], connectivity=4)
 108:     assert orange and gray, "expected orange rectangles and gray source bars"
 109: 
 110:     orange_index: dict[tuple[int, int], int] = {}
 111:     orange_bboxes: list[tuple[int, int, int, int]] = []
 112:     for i, obj in enumerate(orange):
 113:         r0, c0, r1, c1 = obj["bbox"]
 114:         assert obj["area"] == bbox_h(obj["bbox"]) * bbox_w(obj["bbox"])
 115:         assert np.all(g[r0 : r1 + 1, c0 : c1 + 1] == Color.ORANGE)
 116:         orange_bboxes.append((int(r0), int(c0), int(r1), int(c1)))
 117:         for r, c in obj["coords"]:
 118:             orange_index[(int(r), int(c))] = i
 119: 
 120:     source_by_target: dict[int, list[tuple[dict, list[tuple[int, int, int, int]]]]] = {}
 121:     for src in gray:
 122:         touched: dict[int, list[tuple[int, int, int, int]]] = {}
 123:         for sr_raw, sc_raw in src["coords"]:
 124:             sr = int(sr_raw)
 125:             sc = int(sc_raw)
 126:             for tr, tc in neighbors4(sr, sc):
 127:                 target_i = orange_index.get((int(tr), int(tc)))
 128:                 if target_i is not None:
 129:                     touched.setdefault(target_i, []).append((int(tr), int(tc), sr, sc))
 130: 
 131:         assert len(touched) == 1, "each gray bar must touch exactly one orange rectangle"
 132:         target_i = next(iter(touched))
 133:         source_by_target.setdefault(target_i, []).append((src, touched[target_i]))
 134: 
 135:     out = g.copy()
 136:     out[g == Color.GRAY] = Color.YELLOW
 137: 
 138:     for target_i, sources in source_by_target.items():
 139:         r0, c0, r1, c1 = orange_bboxes[target_i]
 140:         orientations = {_orientation(src["coords"], contacts) for src, contacts in sources}
 141:         assert len(orientations) == 1, "all gray bars for one orange rectangle must share orientation"
 142:         count = sum(int(src["area"]) for src, _contacts in sources)
 143:         contacts = [contact for _src, src_contacts in sources for contact in src_contacts]
 144: 
 145:         if orientations == {"horizontal"}:
 146:             contact_rows = {tr for tr, _tc, _sr, _sc in contacts}
 147:             assert contact_rows <= {r0, r1}
 148:             _fill_rows(out, r0, c0, r1, c1, count, contact_rows)
 149:         else:
 150:             assert orientations == {"vertical"}
 151:             contact_cols = {tc for _tr, tc, _sr, _sc in contacts}
 152:             assert contact_cols <= {c0, c1}
 153:             _fill_cols(out, r0, c0, r1, c1, count, contact_cols)
 154: 
 155:     return out
 156: 
 157: # --------------- generator (att1) ---------------
 158: 
 159: GRID_H_RANGE, GRID_W_RANGE = (10, 18), (14, 18)
 160: CONTENT_H_RANGE, CONTENT_W_RANGE = (6, 13), (12, 15)
 161: BORDER_RANGE = (0, 4)
 162: 
 163: EDGES, HORIZONTAL_EDGES = ("top", "bottom", "left", "right"), ("top", "bottom")
-----
 394:     return grid
 395: 
