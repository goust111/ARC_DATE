  35:                 output_grid[max(0, i-1):min(len(input_grid), i+2), max(0, j-1):min(len(input_grid[i]), j+2)] = Color.BLUE
  36: 
  37:     # but we need to keep the gray center: so copy over all the gray pixels
  38:     output_grid[input_grid == Color.GRAY] = Color.GRAY
  39:             
  40:     return output_grid
