  73: 
  74: # Grid layout.
  75: GRID_SHAPE = (10, 10)
  76: MARKER_ROW, SEPARATOR_ROW, CODE_ROW = 0, 6, 8
  77: BACKGROUND_COLOR, SEPARATOR_COLOR, MARKER_COLOR = 0, 5, 8
  78: CODE_WIDTH = GRID_SHAPE[1]
  79: 
  80: # Sampling bounds and retry policy.
  81: MARKER_LEN_RANGE, COLOR_COUNT_RANGE, COLOR_VALUE_RANGE = (1, 5), (2, 6), (1, 10)
  82: MAX_MATCHING_COLORS, MAX_SELECTED_COLUMNS, RETRY_LIMIT = 3, 6, 300
  83: CODE_PALETTE = tuple(c for c in range(*COLOR_VALUE_RANGE) if c != SEPARATOR_COLOR)
  84: 
  85: @lru_cache(maxsize=None)
  86: def _gen_count_options(marker_len: int, color_count: int, matching_count: int) -> list[tuple[int, ...]]:
  87:     """Return ordered non-matching color counts that fill the code row."""
  88:     other_count = color_count - matching_count
  89:     other_total = CODE_WIDTH - marker_len * matching_count
  90:     return [
  91:         counts
  92:         for counts in product(range(1, other_total + 1), repeat=other_count)
  93:         if sum(counts) == other_total and marker_len not in counts
  94:     ]
  95: 
  96: 
  97: def _count_plans(marker_len: int) -> list[tuple[int, int, list[tuple[int, ...]]]]:
  98:     """Return feasible color-count plans with cached non-matching counts."""
  99:     plans = []
 100:     for color_count in range(*COLOR_COUNT_RANGE):
 101:         max_matching = min(MAX_MATCHING_COLORS, color_count, MAX_SELECTED_COLUMNS // marker_len)
 102:         for matching_count in range(1, max_matching + 1):
 103:             options = _gen_count_options(marker_len, color_count, matching_count)
 104:             if options:
 105:                 plans.append((color_count, matching_count, options))
 106:     return plans
 107: 
 108: 
 109: def _sample_code_values(marker_len, color_count, matching_count, options):
 110:     """Sample a shuffled code row and the colors expected to trigger bars."""
 111:     other_counts = list(options[int(np.random.randint(len(options)))])
 112:     colors = list(np.random.choice(CODE_PALETTE, size=color_count, replace=False))
 113:     matching_colors = colors[:matching_count]
 114:     counts = [marker_len] * matching_count + other_counts
 115:     code_values = [int(color) for color, count in zip(colors, counts) for _ in range(int(count))]
 116:     np.random.shuffle(code_values)
 117:     return code_values, matching_colors
 118: 
 119: 
 120: def _render_case(marker_len, code_values, matching_colors):
 121:     """Build the input grid and its oracle output for the sampled code row."""
 122:     code_row = np.array(code_values, dtype=int)
 123:     grid = np.full(GRID_SHAPE, BACKGROUND_COLOR, dtype=int)
 124:     grid[MARKER_ROW, :marker_len] = MARKER_COLOR
 125:     grid[SEPARATOR_ROW, :] = SEPARATOR_COLOR
 126:     grid[CODE_ROW, :] = code_row
 127:     expected = grid.copy()
 128:     matching_mask = np.isin(code_row, matching_colors)
 129:     expected[SEPARATOR_ROW - marker_len : SEPARATOR_ROW, matching_mask] = code_row[matching_mask]
 130:     return grid, expected
 131: 
 132: 
 133: def _gen_attempt() -> np.ndarray | None:
 134:     marker_len = int(np.random.randint(*MARKER_LEN_RANGE))
 135: 
 136:     plans = _count_plans(marker_len)
 137:     if not plans:
 138:         return None
 139: 
 140:     color_count, matching_count, options = plans[int(np.random.randint(len(plans)))]
 141:     code_values, matching_colors = _sample_code_values(marker_len, color_count, matching_count, options)
 142:     grid, expected = _render_case(marker_len, code_values, matching_colors)
 143: 
 144:     if not np.array_equal(main(grid), expected):
 145:         return None
 146:     return grid
 147: 
 148: 
 149: def generate_input() -> np.ndarray:
 150:     for _ in range(RETRY_LIMIT):
 151:         grid = _gen_attempt()
