  34:         for r in range(height)
  35:         if np.all(g[r, :] == int(g[r, 0])) and int(g[r, 0]) != bg
  36:     ]
  37:     assert len(separator_rows) == 1, "expected one solid non-background separator row"
  38:     separator_row = separator_rows[0]
  39: 
  40:     marker_mask = g[:separator_row, :] != bg
  41:     assert marker_mask.any(), "expected marker pixels above the separator"
  42:     marker_rows = np.flatnonzero(marker_mask.any(axis=1))
  43:     assert len(marker_rows) == 1, "marker pixels must occupy one row"
  44:     marker_row = int(marker_rows[0])
  45:     marker_cols = np.flatnonzero(marker_mask[marker_row])
  46:     assert len(marker_cols) == int(marker_mask.sum()), "expected no other foreground above the separator"
  47:     assert len(set(map(int, g[marker_row, marker_cols]))) == 1, "marker run must be monochromatic"
  48:     assert np.all(np.diff(marker_cols) == 1), "marker pixels must form a contiguous run"
  49:     marker_count = len(marker_cols)
  50: 
  51:     code_rows = [r for r in range(separator_row + 1, height) if np.all(g[r, :] != bg)]
  52:     assert len(code_rows) == 1, "expected one non-background code row below the separator"
  53:     code = g[code_rows[0], :]
  54: 
