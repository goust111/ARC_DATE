  16: def main(grid: np.ndarray) -> np.ndarray:
  17:     """
  18:     Convert the separator-delimited board into a summary grid marking cells with two marker pixels.
  19: 
  20:     Input structure
  21:     - The dominant color is the empty background.
  22:     - One non-background color forms all full separator rows and all full
  23:       separator columns.
  24:     - The remaining non-background color is the marker color; every separated
  25:       region contains either one or two marker pixels.
  26: 
  27:     Rule
  28:     - Find the separator rows and columns, and use them to partition the input
  29:       into rectangular regions.
  30:     - For each region, output blue if it contains two marker pixels; otherwise
  31:       output the background color.
  32: 
  33:     Key insight
  34:     - The large grid is a 3x3 table of tiny marker counts, and the output records
  35:       only which table cells have the doubled marker.
  36:     """
  37:     g = np.asarray(grid, dtype=int)
  38:     assert g.ndim == 2, "expected a 2D grid"
  39:     height, width = map(int, g.shape)
  40: 
  41:     bg = get_bg(g)
  42:     foreground_colors = colors_present(g, exclude={bg})
  43:     separator_candidates = []
  44:     for color in foreground_colors:
  45:         sep_rows = [r for r in range(height) if np.all(g[r, :] == color)]
  46:         sep_cols = [c for c in range(width) if np.all(g[:, c] == color)]
  47:         if sep_rows and sep_cols:
  48:             separator_candidates.append((color, sep_rows, sep_cols))
  49:     assert len(separator_candidates) == 1, "expected one separator color with full rows and columns"
  50: 
  51:     separator, sep_rows, sep_cols = separator_candidates[0]
  52:     marker_colors = [color for color in foreground_colors if color != separator]
  53:     assert len(marker_colors) == 1, "expected one marker color besides the separators"
  54:     marker = marker_colors[0]
  55: 
  56:     row_bands = _bands(height, sep_rows)
  57:     col_bands = _bands(width, sep_cols)
  58:     assert len(row_bands) == 3 and len(col_bands) == 3, "expected a 3x3 separated table"
  59:     out = np.full((len(row_bands), len(col_bands)), bg, dtype=int)
  60: 
  61:     allowed = {bg, marker}
  62:     for out_r, (r0, r1) in enumerate(row_bands):
  63:         for out_c, (c0, c1) in enumerate(col_bands):
  64:             region = g[r0:r1, c0:c1]
  65:             assert set(map(int, region.reshape(-1))) <= allowed, "regions may contain only background and markers"
  66:             marker_count = int(np.sum(region == marker))
  67:             assert marker_count in (1, 2), "each region must contain one or two markers"
  68:             if marker_count == 2:
  69:                 out[out_r, out_c] = Color.BLUE
  70: 
  71:     return out
