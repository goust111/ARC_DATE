   7: def main(grid: np.ndarray) -> np.ndarray:
   8:     """Paint every background cell on the same row/column parity lattice as the single colored marker.
   9: 
  10:     Input structure
  11:     - A 2D grid containing black background pixels, grey fixed pixels, and exactly one non-grey/non-black colored marker pixel.
  12: 
  13:     Rule
  14:     - The marker's row parity and column parity define the selected lattice.
  15:     - Recolor each black background pixel with the marker color iff both its row parity and column parity match the marker.
  16:     - Leave grey pixels and all background pixels on the other three parity lattices unchanged.
  17: 
  18:     Key insight
  19:     - The marker is copied by coordinate parity, not by connectivity through the grey layout.
  20:     """
  21:     g = np.asarray(grid, dtype=int)
  22:     assert g.ndim == 2
  23: 
  24:     colors = set(colors_present(g))
  25:     assert Color.BLACK in colors
  26:     assert Color.GREY in colors
  27:     marker_colors = colors - {Color.BLACK, Color.GREY}
  28:     assert len(marker_colors) == 1
  29:     marker_color = marker_colors.pop()
  30: 
  31:     marker_coords = np.argwhere(g == marker_color)
  32:     assert marker_coords.shape[0] == 1
  33:     marker_r, marker_c = marker_coords[0]
  34: 
  35:     rr, cc = np.indices(g.shape)
  36:     same_parity = (rr % 2 == marker_r % 2) & (cc % 2 == marker_c % 2)
  37: 
  38:     out = g.copy()
  39:     out[(g == Color.BLACK) & same_parity] = marker_color
  40:     return out
