  37:     r0: int,
  38:     c0: int,
  39:     r1: int,
  40:     c1: int,
  41:     count: int,
  42:     contact_rows: set[int],
  43: ) -> None:
  44:     width = int(c1 - c0 + 1)
  45:     height = int(r1 - r0 + 1)
  46:     assert count % width == 0, "gray count must make complete orange rows"
  47:     stripe_count = int(count // width)
  48:     assert 0 < stripe_count <= height, "row fill must fit inside the orange rectangle"
  49: 
  50:     assert contact_rows in ({r0}, {r1}), "horizontal bars must touch exactly one extreme row"
  51:     if contact_rows == {r0}:
  52:         rows = list(range(r0, r0 + stripe_count))
  53:     else:
  54:         rows = list(range(r1 - stripe_count + 1, r1 + 1))
  55: 
  56:     out[rows, c0 : c1 + 1] = Color.GRAY
