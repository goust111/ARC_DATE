 463: 
 464:     # Find valid cell-grid dimensions
 465:     KrKc_options = []
 466:     for Kr in CELL_GRID_DIMS:
 467:         for Kc in CELL_GRID_DIMS:
 468:             if Kr * Kc < V:
 469:                 continue
 470:             min_S = max(Kr, Kc) * cell_size + 2
 471:             if min_S > GRID_SIZE_RANGE[1]:
 472:                 continue
 473:             KrKc_options.append((Kr, Kc, min_S))
 474:     if not KrKc_options:
 475:         return None
 476:     Kr, Kc, min_S = rng.choice(KrKc_options)
 477:     S = rng.randint(max(GRID_SIZE_RANGE[0], min_S), GRID_SIZE_RANGE[1])
 478: 
 479:     # Pick connected cells (cardinal adjacency + skip-2)
 480:     use_diagonal = False
 481:     allow_skip = True
 482:     picked = _pick_cells(Kr, Kc, V, rng, use_diagonal=use_diagonal, allow_skip=allow_skip)
 483:     if picked is None:
 484:         return None
 485: 
 486:     picked_list = list(picked); rng.shuffle(picked_list)
 487:     cell_to_id = {cell: i for i, cell in enumerate(picked_list)}
 488: 
