 111:                 continue
 112:             used.add((r, c))
 113:             if all(max(abs(r - rr), abs(c - cc)) >= min_sep for rr, cc in seeds):
 114:                 seeds.append((r, c))
 115:                 if len(seeds) == count:
 116:                     return seeds
