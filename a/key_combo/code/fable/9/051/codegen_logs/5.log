  grid: 10x10
  background: 0 (black)
  layout: |
    row 0:    marker run (contiguous horizontal, starts at col 0, color 8/azure)
    rows 1-5: empty (all background)
    row 6:    full-width separator (solid color 5/gray)
    row 7:    empty (all background)
    row 8:    code row (every cell non-background)
    row 9:    empty (all background)
  marker:
    color: 8 (azure) [observed]
    length: 1-4 (contiguous run starting at col 0)
    row: 0 [observed]
  separator:
    color: 5 (gray), distinct from bg, marker, and all code colors [observed]
    row: 6 [observed]
