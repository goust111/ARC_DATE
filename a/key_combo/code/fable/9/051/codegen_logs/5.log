  12: def main(input_grid):
  13:     """
  14:     Surround every gray pixel with a blue one-cell neighborhood while keeping the gray centers.
  15: 
  16:     Input structure:
  17:     - The grid is mostly black.
  18:     - Gray pixels are sparse markers to expand.
  19:     - Markers may lie near the grid edge.
  20: 
  21:     Rule:
  22:     - For each gray pixel, paint its clipped 3 by 3 neighborhood blue.
  23:     - Combine overlapping neighborhoods normally.
  24:     - Restore all original gray marker cells after painting blue.
  25: 
  26:     Key insight:
  27:     - Each gray pixel seeds a local halo, while the marker itself remains gray in the output.
  28:     """
  29:     output_grid = np.zeros_like(input_grid)
  30: 
  31:     for i in range(len(input_grid)):
  32:         for j in range(len(input_grid[i])):
  33:             if input_grid[i, j] == Color.GRAY:
  34:                 # if the current pixel is gray, then we need to surround it with blue
  35:                 output_grid[max(0, i-1):min(len(input_grid), i+2), max(0, j-1):min(len(input_grid[i]), j+2)] = Color.BLUE
  36: 
  37:     # but we need to keep the gray center: so copy over all the gray pixels
  38:     output_grid[input_grid == Color.GRAY] = Color.GRAY
  39:             
  40:     return output_grid
