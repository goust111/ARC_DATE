 104: def _gen_sample_component_sizes(total_open, marked_count, unmarked_count):
 105:     marked_min, marked_max = _GEN_MARKED_SIZE_RANGE
 106:     unmarked_min, unmarked_max = _GEN_UNMARKED_SIZE_RANGE
