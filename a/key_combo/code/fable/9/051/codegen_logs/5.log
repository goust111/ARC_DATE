  61: 
  62:     out = g.copy()
  63:     for col in selected_cols:
  64:         color = int(code[col])
  65:         assert np.all(out[start_row:separator_row, col] == bg), "bar target cells must be background"
  66:         out[start_row:separator_row, col] = color
  67: 
