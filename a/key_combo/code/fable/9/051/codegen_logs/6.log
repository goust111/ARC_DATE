+
+def _paint_case(
+    nodes: dict[int, dict],
+    shape: tuple[int, int],
+    edge_cells: dict[tuple[int, int], list[tuple[int, int]]],
+    weights: dict[tuple[int, int], int],
+    rng: random.Random,
