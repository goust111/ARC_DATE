+TARGET_NODE_PATH = (0, 4, 5, 6, 7, 3)
+TARGET_EDGE_PATH = tuple(tuple(sorted(edge)) for edge in ((0, 4), (4, 5), (5, 6), (6, 7), (3, 7)))
