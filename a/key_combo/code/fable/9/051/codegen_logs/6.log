+    node_path: list[int] = []
+    edge_path: list[int] = []
+    cur = goal
+    while cur is not None:
+        node_path.append(cur)
+        edge_id = prev_edge[cur]
+        if edge_id is not None:
+            edge_path.append(edge_id)
+        cur = prev_node[cur]
