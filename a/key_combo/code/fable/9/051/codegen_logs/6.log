+        node = nodes[node_id]
+        r0 = node["r0"]
+        c0 = node["c0"]
+        size = node["size"]
+        out[r0 : r0 + size, c0 : c0 + size] = GREEN
+    for edge in TARGET_EDGE_PATH:
+        for r, c in edge_cells[edge]:
