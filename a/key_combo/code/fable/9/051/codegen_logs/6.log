+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+
+TERMINAL_COLOR = RED
+STATION_COLOR = BLUE
+TRACK_COLOR = GREY
+BEAD_COLOR = YELLOW
+
+NODE_LOGICAL_POS = {
+    0: (0, 0),  # left terminal
+    1: (0, 1),
+    2: (0, 2),
+    3: (0, 3),  # right terminal
+    4: (1, 0),
+    5: (1, 1),
+    6: (1, 2),
+    7: (1, 3),
