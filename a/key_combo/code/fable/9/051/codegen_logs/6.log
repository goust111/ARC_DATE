+
+def _solid_square_components(grid: np.ndarray, color: int) -> list[dict]:
+    comps = components_mask(grid == color, connectivity=4)
+    out: list[dict] = []
+    for coords in comps:
+        r0, c0, r1, c1 = _bbox(coords)
+        h = r1 - r0 + 1
+        w = c1 - c0 + 1
+        if h < 2 or h != w or coords.shape[0] != h * w:
