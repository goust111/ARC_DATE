+def _weighted_shortest(scene: dict) -> tuple[list[int], list[int]]:
+    start, goal = scene["terminals"]
+    pq = [(0, start)]
+    dist = {start: 0}
+    prev_node = {start: None}
+    prev_edge = {start: None}
