+    out: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for dr, dc in nbrs:
+                    nr, nc = rr + dr, cc + dc
+                    if in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
