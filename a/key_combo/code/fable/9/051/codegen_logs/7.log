+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+RED = 2
+TEAL = 8
+OBSTACLE_COLORS = (1, 3, 4, 5, 6, 7, 9)
+DIAGONALS = ((-1, -1), (-1, 1), (1, -1), (1, 1))
+MAX_GENERATION_ATTEMPTS = 400
