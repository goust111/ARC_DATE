+    seen: set[tuple[int, int]] = set()
+    obstacles = []
+    obstacle_map: dict[tuple[int, int], int] = {}
+    for r in range(H):
+        for c in range(W):
+            if (r, c) in launcher_cells or grid[r, c] == BLACK or (r, c) in seen:
+                continue
