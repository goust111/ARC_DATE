+        flip_r = not (0 <= r + dr < H)
+        flip_c = not (0 <= c + dc < W)
+        if flip_r:
+            dr = -dr
+            row_bounces += 1
+        if flip_c:
+            dc = -dc
+            col_bounces += 1
+        if flip_r and flip_c:
+            corner_bounces += 1
+
+        nr, nc = r + dr, c + dc
+        hit = obstacle_map.get((nr, nc))
+        if hit is not None:
+            return {
+                "painted": painted,
+                "path_len": len(painted),
+                "hit_cell": (nr, nc),
+                "hit_obstacle": hit,
+                "row_bounces": row_bounces,
+                "col_bounces": col_bounces,
+                "corner_bounces": corner_bounces,
+                "start": (launcher["start"][0], launcher["start"][1]),
+                "marker": (marker_r, marker_c),
+            }
+        assert (nr, nc) not in launcher["cells"], "trajectory may not re-enter the launcher on valid inputs"
+        r, c = nr, nc
+
+
+def _empty_path_candidates(shape: tuple[int, int], launcher: dict) -> list[dict]:
+    H, W = shape
+    r, c = launcher["start"]
+    dr, dc = launcher["direction"]
+    path = [launcher["start"]]
+    states = set()
+    row_bounces = 0
+    col_bounces = 0
+    corner_bounces = 0
+    candidates = []
+
+    while True:
+        state = (r, c, dr, dc)
+        if state in states:
+            break
+        states.add(state)
+
+        flip_r = not (0 <= r + dr < H)
+        flip_c = not (0 <= c + dc < W)
+        if flip_r:
+            dr = -dr
+            row_bounces += 1
+        if flip_c:
+            dc = -dc
+            col_bounces += 1
+        if flip_r and flip_c:
+            corner_bounces += 1
+
+        nr, nc = r + dr, c + dc
+        if (nr, nc) in launcher["cells"]:
+            break
+        candidates.append(
+            {
+                "hit_cell": (nr, nc),
+                "painted": tuple(path),
+                "path_len": len(path),
+                "row_bounces": row_bounces,
+                "col_bounces": col_bounces,
+                "corner_bounces": corner_bounces,
+                "last_flip_r": flip_r,
+                "last_flip_c": flip_c,
+            }
+        )
+        path.append((nr, nc))
+        r, c = nr, nc
+    return candidates
+
+
+def _scenario_match(kind: str, cand: dict) -> bool:
+    if cand["path_len"] < 2:
+        return False
+    row = cand["row_bounces"]
+    col = cand["col_bounces"]
+    corner = cand["corner_bounces"]
+    if kind == "direct":
+        return row == 0 and col == 0
+    if kind == "row":
+        return row > 0 and col == 0
+    if kind == "col":
+        return row == 0 and col > 0
+    if kind == "both":
+        return row > 0 and col > 0 and corner == 0
+    if kind == "corner":
+        return corner > 0
