+def _random_rect_options(
+    shape: tuple[int, int],
+    launcher: dict,
+    forbidden: set[tuple[int, int]],
+    placed_rects: list[tuple[int, int, int, int]],
+) -> list[tuple[int, int, int, int]]:
+    H, W = shape
+    sizes = [(1, 2), (2, 1), (2, 2), (2, 3), (3, 2), (1, 3), (3, 1), (3, 3)]
+    options = []
+    for h, w in sizes:
