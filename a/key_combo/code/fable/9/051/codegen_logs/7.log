+    row = cand["row_bounces"]
+    col = cand["col_bounces"]
+    corner = cand["corner_bounces"]
+    if kind == "direct":
+        return row == 0 and col == 0
+    if kind == "row":
+        return row > 0 and col == 0
+    if kind == "col":
+        return row == 0 and col > 0
+    if kind == "both":
+        return row > 0 and col > 0 and corner == 0
