+def _find_launcher(grid: np.ndarray) -> dict:
+    H, W = grid.shape
+    candidates = []
+    for r0 in range(H - 1):
+        for c0 in range(W - 1):
+            block = grid[r0 : r0 + 2, c0 : c0 + 2]
+            if int(np.count_nonzero(block == RED)) != 1 or int(np.count_nonzero(block == TEAL)) != 3:
+                continue
