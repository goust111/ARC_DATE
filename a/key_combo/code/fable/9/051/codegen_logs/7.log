+
+def _empty_path_candidates(shape: tuple[int, int], launcher: dict) -> list[dict]:
+    H, W = shape
+    r, c = launcher["start"]
+    dr, dc = launcher["direction"]
+    path = [launcher["start"]]
+    states = set()
+    row_bounces = 0
+    col_bounces = 0
+    corner_bounces = 0
+    candidates = []
+
+    while True:
+        state = (r, c, dr, dc)
+        if state in states:
+            break
+        states.add(state)
+
+        flip_r = not (0 <= r + dr < H)
+        flip_c = not (0 <= c + dc < W)
+        if flip_r:
+            dr = -dr
+            row_bounces += 1
+        if flip_c:
+            dc = -dc
+            col_bounces += 1
+        if flip_r and flip_c:
+            corner_bounces += 1
+
+        nr, nc = r + dr, c + dc
+        if (nr, nc) in launcher["cells"]:
+            break
