+            mr, mc = map(int, local_marker[0])
+            dr = -1 if mr == 0 else 1
+            dc = -1 if mc == 0 else 1
+            marker = (r0 + mr, c0 + mc)
+            cells = {(r0 + rr, c0 + cc) for rr in range(2) for cc in range(2)}
