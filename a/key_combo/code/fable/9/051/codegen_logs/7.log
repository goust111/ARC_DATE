+def _component_cells(mask: np.ndarray, start: tuple[int, int]) -> set[tuple[int, int]]:
+    H, W = mask.shape
+    q = deque([start])
+    seen = {start}
+    while q:
+        r, c = q.popleft()
+        for rr, cc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+            if 0 <= rr < H and 0 <= cc < W and mask[rr, cc] and (rr, cc) not in seen:
