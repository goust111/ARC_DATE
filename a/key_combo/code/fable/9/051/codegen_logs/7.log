+        r, c = nr, nc
+    return candidates
+
+
+def _scenario_match(kind: str, cand: dict) -> bool:
+    if cand["path_len"] < 2:
+        return False
+    row = cand["row_bounces"]
+    col = cand["col_bounces"]
+    corner = cand["corner_bounces"]
+    if kind == "direct":
+        return row == 0 and col == 0
+    if kind == "row":
+        return row > 0 and col == 0
+    if kind == "col":
+        return row == 0 and col > 0
+    if kind == "both":
+        return row > 0 and col > 0 and corner == 0
+    if kind == "corner":
+        return corner > 0
+    raise ValueError(kind)
+
