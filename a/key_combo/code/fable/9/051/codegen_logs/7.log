+
+
+def _choose_launcher(rng: random.Random, H: int, W: int) -> dict | None:
+    dr, dc = rng.choice(DIAGONALS)
+    mr = 0 if dr < 0 else 1
+    mc = 0 if dc < 0 else 1
+    r_lo = 1 if dr < 0 else 0
