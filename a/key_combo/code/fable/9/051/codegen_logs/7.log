+    for r, c in trace["painted"]:
+        out[r, c] = RED
+    for r, c in obstacles[trace["hit_obstacle"]]["cells"]:
+        out[r, c] = RED
+    return out, trace
+
+
+def _semantic_checks(grid: np.ndarray, scenario: str) -> bool:
+    try:
+        out, trace = _oracle_output(grid)
+    except AssertionError:
