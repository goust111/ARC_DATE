+            if not _in_bounds(grid.shape, start[0], start[1]):
+                continue
+            candidates.append(
+                {
+                    "bbox": (r0, c0, r0 + 1, c0 + 1),
+                    "marker": marker,
+                    "direction": (dr, dc),
+                    "cells": cells,
+                    "start": start,
+                }
