+    candidate: dict,
+    placed_rects: list[tuple[int, int, int, int]],
+) -> list[tuple[int, int, int, int]]:
+    H, W = shape
+    hit_r, hit_c = candidate["hit_cell"]
+    painted = set(candidate["painted"])
+    options = []
+    sizes = [(1, 2), (2, 1), (2, 2), (2, 3), (3, 2), (3, 3), (2, 4), (4, 2)]
+    for h, w in sizes:
