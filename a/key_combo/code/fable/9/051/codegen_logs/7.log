+            {
+                "hit_cell": (nr, nc),
+                "painted": tuple(path),
+                "path_len": len(path),
+                "row_bounces": row_bounces,
+                "col_bounces": col_bounces,
+                "corner_bounces": corner_bounces,
+                "last_flip_r": flip_r,
+                "last_flip_c": flip_c,
