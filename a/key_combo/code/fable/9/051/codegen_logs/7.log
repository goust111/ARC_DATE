+    obstacles = _find_obstacles(grid, launcher["cells"])
+    trace = _trace_ball(grid.shape, launcher, obstacles)
+    out = grid.copy()
+    for r, c in trace["painted"]:
+        out[r, c] = RED
+    for r, c in obstacles[trace["hit_obstacle"]]["cells"]:
+        out[r, c] = RED
+    return out, trace
