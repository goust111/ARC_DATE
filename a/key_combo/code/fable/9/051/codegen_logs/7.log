+            assert color not in (RED, TEAL), "obstacle colors must not reuse launcher colors"
+            mask = grid == color
+            cells = _component_cells(mask, (r, c))
+            seen |= cells
+            rows = [rr for rr, _ in cells]
+            cols = [cc for _, cc in cells]
