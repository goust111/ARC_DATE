+
+def _find_obstacles(grid: np.ndarray, launcher_cells: set[tuple[int, int]]) -> list[dict]:
+    H, W = grid.shape
+    seen: set[tuple[int, int]] = set()
+    obstacles = []
+    obstacle_map: dict[tuple[int, int], int] = {}
+    for r in range(H):
