+    states = set()
+    row_bounces = 0
+    col_bounces = 0
+    corner_bounces = 0
+
+    while True:
+        state = (r, c, dr, dc)
+        assert state not in states, "ball repeated a state before hitting an obstacle"
+        states.add(state)
+        painted.append((r, c))
