0108: def neighbors4(r: int, c: int) -> Iterator[Coord]:
0109:     """4-neighborhood of (r,c)."""
0110:     r = int(r)
0111:     c = int(c)
0112:     yield r - 1, c
0113:     yield r + 1, c
0114:     yield r, c - 1
0115:     yield r, c + 1
0116: 
0117: 
0118: def neighbors8(r: int, c: int) -> Iterator[Coord]:
0119:     """8-neighborhood of (r,c)."""
0120:     r = int(r)
0121:     c = int(c)
0122:     for dr in (-1, 0, 1):
0123:         for dc in (-1, 0, 1):
0124:             if dr == 0 and dc == 0:
0125:                 continue
0126:             yield r + dr, c + dc
