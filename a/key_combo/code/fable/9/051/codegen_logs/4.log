0138: def scale_sprite(sprite: np.ndarray, factor: int) -> np.ndarray:
0139:     """
0140:     Scale a sprite by an integer factor using nearest-neighbor replication.
0141: 
0142:     Returns an array of shape (h*factor, w*factor).
0143:     """
0144:     k = int(factor)
0145:     if k <= 0:
0146:         raise ValueError("scale_sprite: factor must be >= 1")
0147:     return np.kron(sprite, np.ones((k, k), dtype=sprite.dtype))
