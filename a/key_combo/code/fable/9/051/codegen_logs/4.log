+import random
+from collections import Counter
+
+import numpy as np
+
+
+BACKGROUND = 0
+SOURCE = 2
+SEPARATOR = 4
+MARKER = 8
+
+_GRID_RANGE = (14, 23)
+_AXIS_MARGIN = 5
+_SHAPE_COUNT_CHOICES = (1, 2, 2, 3, 3)
