+_SHAPE_COUNT_CHOICES = (1, 2, 2, 3, 3)
+_SHAPE_HEIGHT_RANGE = (2, 5)
+_SHAPE_WIDTH_RANGE = (2, 5)
+_MAX_GEN_ATTEMPTS = 400
+
