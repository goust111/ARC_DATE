0004: def main(grid: np.ndarray) -> np.ndarray:
0005:     """
0006:     Create a horizontally mirrored two-block pattern by repeating each row as reversed-then-original twice.
0007: 
0008:     Input structure
0009:     - A non-empty 2D color grid.
0010: 
0011:     Rule
0012:     - Mirror the whole grid left-to-right.
0013:     - Concatenate the mirrored grid, the original grid, the mirrored grid, and the original grid.
0014: 
0015:     Key insight
0016:     - The output is a horizontal periodic pattern whose tile is the input preceded by its left-right reflection.
0017:     """
0018:     g = np.asarray(grid, dtype=int)
0019:     assert g.ndim == 2, "input must be a 2D grid"
0020:     assert g.size > 0, "input grid must be non-empty"
0021: 
0022:     tile = np.concatenate((np.fliplr(g), g), axis=1)
0023:     out = np.concatenate((tile, tile), axis=1)
0024:     assert out.shape == (g.shape[0], g.shape[1] * 4)
0025:     return out
0026: 
