+        max_h = max(_group_bbox(group["blocks"])[0] for group in groups)
+        max_w = max(_group_bbox(group["blocks"])[1] for group in groups)
+        height_low = max(14, max_h + 3)
+        width_low = max(14, max_w + 3)
