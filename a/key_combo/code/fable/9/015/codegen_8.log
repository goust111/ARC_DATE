+        port_colors.add(port_color)
+        blocks.append(
+            Block(
+                r=r0,
+                c=c0,
+                h=patch.shape[0],
+                w=patch.shape[1],
+                body_color=body_color,
+                port_color=port_color,
+                port_offset=(pr, pc),
+                direction=direction,
+            )
