+        if pr == 0:
+            side_dirs.append((-1, 0))
+            assert 0 < pc < patch.shape[1] - 1
+        if pr == patch.shape[0] - 1:
+            side_dirs.append((1, 0))
+            assert 0 < pc < patch.shape[1] - 1
+        if pc == 0:
+            side_dirs.append((0, -1))
+            assert 0 < pr < patch.shape[0] - 1
+        if pc == patch.shape[1] - 1:
+            side_dirs.append((0, 1))
+            assert 0 < pr < patch.shape[0] - 1
