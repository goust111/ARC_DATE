+    for quadrant in quadrants:
+        if np.array_equal(quadrant, template_mask):
+            return False
+        if not np.any(template_mask & ~quadrant):
+            return False
+        if not np.any(~template_mask & quadrant):
+            return False
+        quadrant_keys.add(quadrant.tobytes())
+    if len(quadrant_keys) < 4:
