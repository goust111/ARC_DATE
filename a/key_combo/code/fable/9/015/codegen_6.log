+def _find_separator_cross(grid: np.ndarray, bg: int) -> tuple[int, int, int]:
+    h, w = grid.shape
+    row_candidates = [
+        r for r in range(h) if int(grid[r, 0]) != bg and np.all(grid[r, :] == grid[r, 0])
+    ]
