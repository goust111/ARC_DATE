+        elif r > tr:
+            moves.append((-1, 0))
+        if c < tc:
+            moves.append((0, 1))
+        elif c > tc:
+            moves.append((0, -1))
+        dr, dc = moves[int(_RNG.integers(len(moves)))]
+        r += dr
+        c += dc
+        mask[r, c] = True
+
+
+def _grow_template(height: int, width: int) -> np.ndarray:
+    total = height * width
+    target = int(_RNG.integers(max(8, total // 4), max(9, (total * 11) // 20) + 1))
+
+    for _ in range(200):
