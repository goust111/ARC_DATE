14: def main(input_grid: np.ndarray) -> np.ndarray:
15:     """
16:     Complete each divided square by comparing it with the top-left template pattern.
17: 
18:     Input structure:
19:     - A 3 by 3 layout of equal squares is separated by full divider lines of one color.
20:     - The top-left square contains the complete pattern.
21:     - Other squares contain black omissions from that same pattern.
22: 
23:     Rule:
24:     - Detect the divider color and split the grid into square regions.
25:     - Use the top-left region as the template.
26:     - In every other region, fill template cells that are missing or different with the divider color.
27: 
28:     Key insight:
29:     - The first region supplies the reference mask, and missing pattern cells are marked with
30:       the separator color instead of recreating the original pattern color.
31:     """
32:     # Create a copy of the input grid to avoid modifying the original
33:     output_grid = np.copy(input_grid)  
34: 
35:     # Detect the color of the lines
36:     for r, row in enumerate(output_grid):
37:         # Find the line
38:         all_equal = np.unique(row).size == 1
39:         if all_equal:
40:             line_color = row[0]
41:             break
42:     
43:     # Get all the squares seperated by lines in the grid
44:     squares = find_components(output_grid, bg=line_color, connectivity=4, monochromatic=False, return_format="objects")
45: 
46:     # Get all squares' bounding box and cropped pattern
47:     cropped_squares  = []
48:     for obj in squares:
49:         _b = bbox(obj != line_color)
50:         assert _b is not None
51:         r, c, _r1, _c1 = _b
52:         width = _r1 - r + 1
53:         height = _c1 - c + 1
54:         _b = bbox(obj != line_color)
55:         assert _b is not None
56:         square = crop_bbox(obj, _b)
57:         cropped_squares.append({'x': r, 'y': c, 'len': width, 'pattern': square})
58: 
59:     # Sort the squares by their position
60:     cropped_squares = sorted(cropped_squares, key=lambda r: (r['x'], r['y']))
61: 
62:     # The top-left square contains the original pattern
63:     template_pattern = cropped_squares[0]['pattern']
64:     other_patterns = cropped_squares[1:]
65: 
66:     # Fill the missing pattern compared to template square with line color
67:     for square in other_patterns:
68:         r, c = square['x'], square['y']
69:         square_pattern = square['pattern']
70: 
71:         # Fill the missing pattern compared to template square with line color
72:         for i, j in np.argwhere(template_pattern != Color.BLACK):
73:             if template_pattern[i, j] != square_pattern[i, j]:
74:                 square_pattern[i, j] = line_color
75: 
76:         # Place the reconstructed pattern on the output grid
77:         output_grid = paste(output_grid, square_pattern, r, c, transparent=Color.BLACK, clip=True)
78: 
79:     return output_grid
80: 
