spec:
  grid: 10x10, black background
  grey_object:
    shape: single 4-connected grey (5) object, LR- and UD-symmetric [observed]
    pixels: 4-13
    position: centered near grid middle (centroid within 1 cell of center) [observed]
    examples: horizontal bar, vertical bar, rectangle, diamond, plus-shaped cross
  markers:
    color_count: 2-3 distinct non-grey non-black colors
    per_color_pixels: 1-6 isolated single pixels (no two same-color pixels 4-adjacent)
    total_pixels: 2-14
    placement: scattered across grid, never on or 4-adjacent to grey object
  distance_rule:
    metric: minimum squared Euclidean distance from any marker pixel of that color to any grey pixel
    winner: unique color with smallest distance; gap to second-best >= 2
  output: black grid with grey object repainted in winning color; all markers erased

generation_strategy:
