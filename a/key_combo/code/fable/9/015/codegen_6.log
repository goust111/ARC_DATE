+def _border_anchor(height: int, width: int, side: str) -> tuple[int, int]:
+    if side == "top":
+        return 0, int(_RNG.integers(1, width - 1))
+    if side == "bottom":
+        return height - 1, int(_RNG.integers(1, width - 1))
+    if side == "left":
+        return int(_RNG.integers(1, height - 1)), 0
