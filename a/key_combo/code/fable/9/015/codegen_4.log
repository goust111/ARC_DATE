        col += w - CHAIN_OVERLAP

    inp = np.full((GRID_SIZE, GRID_SIZE), BACKGROUND_COLOR, dtype=int)
    left = 0
    for h, w, color in zip(heights, widths, colors):
        patch = np.full((h, w), color, dtype=int)
        paste(inp, patch, GRID_SIZE - h, left)
