+    if high - low + 1 < count:
+        return None
+    for _ in range(200):
+        positions = sorted(random.sample(range(low, high + 1), count))
+        if all(b - a >= min_gap for a, b in zip(positions, positions[1:])):
+            return positions
+    return None
+
