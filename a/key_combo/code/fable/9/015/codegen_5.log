+        return False
+    if len(active_colors) < 1:
+        return False
+
+    for i, (box_a, _, _, _) in enumerate(active_boxes):
+        if _boxes_overlap(box_a, template_bbox):
+            return False
+        for box_b, _, _, _ in active_boxes[i + 1 :]:
