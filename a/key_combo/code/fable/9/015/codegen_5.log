+def _stamp_bbox(anchor_r: int, anchor_c: int, hole: tuple[int, int], shape: tuple[int, int]) -> tuple[int, int, int, int]:
+    hr, hc = hole
+    h, w = shape
+    r0 = anchor_r - hr
+    c0 = anchor_c - hc
+    return r0, c0, r0 + h - 1, c0 + w - 1
