+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+TEMPLATE_COLOR = 5
+PALETTE = [0, 1, 2, 3, 4, 6, 7, 8, 9]
+MARKER_PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+GENERATION_RETRIES = 600
+TEMPLATE_GAP = 1
