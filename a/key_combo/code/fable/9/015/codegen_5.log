+    return candidates[0]
+
+
+def _stamp(out: np.ndarray, patch: np.ndarray, anchor: tuple[int, int], color: int, bg: int) -> None:
+    hole_r, hole_c = anchor
+    h, w = patch.shape
+    target_r = int(anchor[0])
+    target_c = int(anchor[1])
