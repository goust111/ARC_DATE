  frames:
    count: 2-3 non-overlapping, non-nested rectangular 1px-thick hollow frames, all frame_color
    frame_color forms ONLY complete rectangular frames (no stray pixels)
    sizes: 3-8 per side; largest frame is unique by area (area gap >=12)
    largest: 6-8 rows x 7-8 cols [observed]
    smaller: 3-5 rows x 3-6 cols [observed]
  marker_pixels:
    scattered small components (mostly 1px, some 2-3px) of marker_color
    total count: 9-23; component count: 9-19
