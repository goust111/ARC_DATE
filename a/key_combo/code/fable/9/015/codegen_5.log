+        hole_coords = np.argwhere(patch == bg)
+        if hole_coords.shape[0] != 1:
+            continue
+        hr, hc = map(int, hole_coords[0])
+        if hr in (0, patch.shape[0] - 1) or hc in (0, patch.shape[1] - 1):
+            continue
