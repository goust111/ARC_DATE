+            continue
+        return row_colors, col_colors
+    return None
+
+
+def _paint_template(grid: np.ndarray, patch: np.ndarray, origin: tuple[int, int], bg: int) -> None:
+    r0, c0 = origin
+    h, w = patch.shape
+    region = grid[r0 : r0 + h, c0 : c0 + w]
