+
+
+def _extract_bars(grid: np.ndarray, sep_col: int, bars_on_left: bool, bg: int = BACKGROUND) -> dict[int, list[dict]]:
+    h, w = grid.shape
+    bars_by_row: dict[int, list[dict]] = {}
+    for r in range(h):
+        if bars_on_left:
+            runs = list(_iter_runs(grid[r], 0, sep_col, bg))
+        else:
