+                {
+                    "sep_col": c,
+                    "sep_color": int(vals[0]),
+                    "bars_on_left": True,
+                    "bar_info": left_bars,
+                    "block_info": right_blocks,
+                }
+            )
+
+        left_blocks = _analyze_block_side(left, bg)
+        right_bars = _analyze_bar_side(right, bg)
+        if left_blocks is not None and right_bars is not None:
+            candidates.append(
+                {
+                    "sep_col": c,
+                    "sep_color": int(vals[0]),
+                    "bars_on_left": False,
+                    "bar_info": right_bars,
+                    "block_info": left_blocks,
+                }
+            )
