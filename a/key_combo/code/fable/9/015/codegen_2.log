+
+def _apply_rule(
+    grid: np.ndarray,
+    sep_col: int,
+    bars_on_left: bool,
+    bars_by_row: dict[int, list[dict]],
+    *,
+    paint_on_blank: bool = True,
+    carve_in_solid: bool = True,
+    start_mode: str = "length",
