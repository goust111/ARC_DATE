def _find_sep_col(g, bg):
    h, w = g.shape
    for c in range(w):
        col = g[:, c]
        vals = col[col != bg]
        if vals.size >= h - 1 and (vals == vals[0]).all():
            return c, int(vals[0])
    return None, None

def _iter_runs_1d(row, c_lo, c_hi, bg):
    c = c_lo
