+def _iter_runs(row: np.ndarray, c0: int, c1: int, bg: int = BACKGROUND):
+    c = int(c0)
+    while c < int(c1):
+        if int(row[c]) == bg:
+            c += 1
+            continue
+        color = int(row[c])
+        start = c
+        while c < int(c1) and int(row[c]) == color:
+            c += 1
+        yield start, c - 1, color
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _components_monochrome(grid: np.ndarray, bg: int = BACKGROUND) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == bg or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            b = _bbox(coords)
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": b,
+                    "area": len(coords),
+                }
+            )
+    return comps
+
+
+def _analyze_bar_side(side: np.ndarray, bg: int = BACKGROUND) -> dict | None:
+    h, _ = side.shape
+    rows: dict[int, list[dict]] = {}
+    for r in range(h):
+        runs = [
+            {
+                "c0": c0,
+                "c1": c1,
+                "color": color,
+                "length": c1 - c0 + 1,
+            }
+            for c0, c1, color in _iter_runs(side[r], 0, side.shape[1], bg)
+        ]
+        if len(runs) > 2:
+            return None
+        if runs:
+            rows[r] = runs
+    if not rows:
+        return None
+    return {"rows": rows, "mass": int(np.count_nonzero(side != bg))}
+
+
+def _analyze_block_side(side: np.ndarray, bg: int = BACKGROUND) -> dict | None:
+    comps = _components_monochrome(side, bg)
+    if not comps:
+        return None
+    for comp in comps:
+        r0, c0, r1, c1 = comp["bbox"]
+        height = r1 - r0 + 1
+        width = c1 - c0 + 1
+        if height < 2 or width < 2:
+            return None
+        if comp["area"] != height * width:
+            return None
