+import random
+from collections import Counter, deque
+from typing import Dict, List, Sequence, Tuple
+
+import numpy as np
+
+
+Coord = Tuple[int, int]
+DIRS: Sequence[Coord] = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+PALETTE: Sequence[int] = tuple(range(1, 10))
+MAX_GENERATION_ATTEMPTS = 600
+
+
+def _bg_color(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.flatten())).most_common(1)[0][0])
+
+
+def _in_bounds(shape: Tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def _components(grid: np.ndarray, bg: int) -> List[dict]:
+    h, w = map(int, grid.shape)
+    seen = np.zeros((h, w), dtype=bool)
+    comps: List[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == bg or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: List[Coord] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for dr, dc in DIRS:
+                    nr, nc = rr + dr, cc + dc
+                    if not _in_bounds((h, w), nr, nc) or seen[nr, nc]:
+                        continue
+                    if int(grid[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+            rows = [p[0] for p in coords]
+            cols = [p[1] for p in coords]
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "area": len(coords),
+                    "bbox": (min(rows), min(cols), max(rows), max(cols)),
+                }
+            )
+    return comps
+
+
+def _touching_edges(shape: Tuple[int, int], cell: Coord) -> List[str]:
+    h, w = shape
+    r, c = cell
+    edges: List[str] = []
+    if r == 0:
+        edges.append("top")
+    if r == h - 1:
+        edges.append("bottom")
+    if c == 0:
+        edges.append("left")
+    if c == w - 1:
+        edges.append("right")
+    return edges
+
+
+def _initial_dir(shape: Tuple[int, int], start: Coord) -> int:
+    edges = _touching_edges(shape, start)
+    assert len(edges) == 1, "start marker must touch exactly one edge"
+    edge = edges[0]
+    if edge == "top":
+        return 2
+    if edge == "bottom":
+        return 0
+    if edge == "left":
+        return 1
+    return 3
+
+
+def _turn(dir_idx: int, go_left: bool) -> int:
+    return (dir_idx - 1) % 4 if go_left else (dir_idx + 1) % 4
+
+
+def _extract_layout(grid: np.ndarray) -> dict:
+    g = np.asarray(grid, dtype=int)
+    bg = _bg_color(g)
+    h, w = g.shape
+    comps = _components(g, bg)
+    assert comps, "expected legend bars and start markers"
+
+    legend = []
+    starts: Dict[int, Coord] = {}
+    for comp in comps:
+        color = int(comp["color"])
+        coords = comp["coords"]
+        r0, c0, r1, c1 = map(int, comp["bbox"])
+        if int(comp["area"]) == 1:
+            cell = coords[0]
+            edges = _touching_edges((h, w), cell)
+            assert len(edges) == 1, "start marker must not sit on a corner"
+            assert color not in starts, "generator guarantees one start per legend color"
+            starts[color] = cell
+            continue
