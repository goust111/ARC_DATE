  "dst": "diagonal chain slots d starting at the upper-left; each next slot begins at the previous rectangle's lower-right corner",
  "match_cond": "rank(s by left edge) == rank(d along the chain)",
  "transform": "copy each rectangle into its slot on a background canvas; later rectangles overwrite the shared corner pixel"
}
</annotation>
