+        canvas[nr, nc] = color
+        r, c = nr, nc
+        path.append((r, c))
+        progress += 1
+
+    return {
+        "path": path,
+        "path_set": set(path),
+        "turns": turns,
+        "stop_reason": stop_reason,
+        "blocker": blocker,
+        "stop_cell": stop_cell,
+    }
+
+
+def _simulate_actual(layout: dict) -> Tuple[np.ndarray, Dict[int, dict]]:
+    g = np.array(layout["grid"], dtype=int, copy=True)
