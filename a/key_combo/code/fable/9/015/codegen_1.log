+import random
+from collections import Counter, deque
+from typing import Dict, List, Sequence, Tuple
+
+import numpy as np
+
+
+Coord = Tuple[int, int]
+DIRS: Sequence[Coord] = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+PALETTE: Sequence[int] = tuple(range(1, 10))
+MAX_GENERATION_ATTEMPTS = 600
