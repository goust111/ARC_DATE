+                return pair, {"top": (0, top_c), "right": (right_r, w - 1)}
+
+        if pair == ("bottom", "left"):
+            pr = random.randint(max(min_side_row - 2, h // 2), h - 4)
+            pc_low = max(3, pr - (h - 2) + 1)
