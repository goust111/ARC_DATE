+
+def _coarse_components(
+    n_rows: int,
+    n_cols: int,
+    blocked_h: set[tuple[int, int]],
+    blocked_v: set[tuple[int, int]],
+) -> list[set[Cell]]:
+    unseen = {(r, c) for r in range(n_rows) for c in range(n_cols)}
+    comps: list[set[Cell]] = []
+    while unseen:
+        start = unseen.pop()
+        comp = {start}
