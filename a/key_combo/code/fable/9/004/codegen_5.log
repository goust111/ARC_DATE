spec:
  grid: 10x10 [observed]
  background: BLACK
  foreground: single non-BLACK, non-GREY color
  strokes:
    definition: each stroke draws 2-3 sides of its bounding box (L-shape for 2, U-shape for 3)
    side_set: same for all strokes; 2-side combos must be adjacent (share a corner); 3-side = any 3 of 4
    all_strokes_identical_sides: true
  arithmetic_sequence:
    bbox_corners: (r0, c0, r1, c1) form an arithmetic sequence with constant step delta
    step_rule: step[j] != 0 iff the corresponding edge is in the side set; all nonzero step components have equal absolute magnitude
    growth: boxes grow outward (top->up, bottom->down, left->left, right->right)
    fixed_edges: edges NOT in side set are pinned to grid boundary (r0=0 or c0=0 or r1=H-1 or c1=W-1)
    step_magnitude: 2-3 [observed]; equals min(h,w) of smallest box [observed]
  input_strokes: 2-3 consecutive members of the sequence, fully visible within the grid
