    return candidates


def _gen_f8c80d96_render(
    boxes: list[BBox],
    sides: tuple[str, ...],
    color: int,
    background: int,
) -> np.ndarray:
    grid = np.full(_GEN_F8C80D96_SHAPE, background, dtype=int)
    for box in boxes:
