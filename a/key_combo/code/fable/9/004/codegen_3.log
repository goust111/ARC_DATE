+from __future__ import annotations
+
+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+Coord = tuple[int, int]
+BBox = tuple[int, int, int, int]
+
+
+BG = 0
+GRAY = 5
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+DIRECTIONS = ("left", "right", "top", "bottom")
