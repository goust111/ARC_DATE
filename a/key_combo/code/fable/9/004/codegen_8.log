0012: def main(grid: np.ndarray) -> np.ndarray:
0013:     """Stamp the whole input pattern into output block slots marked by its unique most frequent color.
0014: 
0015:     Input structure
0016:     - The input is a 3x3 grid of non-black colors.
0017:     - Exactly one color appears more often than every other color.
0018: 
0019:     Rule
0020:     - Treat the input as both a source sprite and a 3x3 placement mask.
0021:     - Create a 9x9 black output divided into 3x3 block slots.
0022:     - For each input cell whose color is the unique most frequent color, copy
0023:       the entire input grid into the corresponding output block slot.
0024: 
0025:     Key insight
0026:     - The dominant color does not get expanded by itself; its positions select
0027:       where full copies of the original 3x3 pattern are stamped.
0028:     """
0029:     g = np.asarray(grid, dtype=int)
0030:     assert g.ndim == 2, "expected a 2D grid"
0031:     h, w = map(int, g.shape)
0032:     assert (h, w) == (3, 3), "expected a 3x3 input grid"
0033:     assert not np.any(g == 0), "input pattern should not contain black"
0034: 
0035:     marker_color = _unique_most_frequent_color(g)
0036:     out = np.zeros((h * h, w * w), dtype=int)
0037:     for r in range(h):
0038:         for c in range(w):
0039:             if int(g[r, c]) == marker_color:
0040:                 out[r * h : (r + 1) * h, c * w : (c + 1) * w] = g
0041:     return out
