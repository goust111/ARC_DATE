+    bg = _get_bg(g)
+    components = _find_components(g, bg)
+    assert len(components) >= 3
+
+    max_area = max(comp["area"] for comp in components)
+    full = [comp for comp in components if comp["area"] == max_area]
+    assert len(full) >= 3
+
