+    h, w = patch.shape
+    rr0 = max(0, int(r0))
+    cc0 = max(0, int(c0))
+    rr1 = min(dst.shape[0], int(r0) + h)
+    cc1 = min(dst.shape[1], int(c0) + w)
+    if rr0 >= rr1 or cc0 >= cc1:
+        return
+    pr0 = rr0 - int(r0)
+    pc0 = cc0 - int(c0)
+    dst[rr0:rr1, cc0:cc1] = patch[pr0 : pr0 + (rr1 - rr0), pc0 : pc0 + (cc1 - cc0)]
