+            continue
+        left_patch = records[i]["patch"]
+        right_patch = records[i + 1]["patch"]
+        if np.array_equal(_rot_cw(left_patch), right_patch):
+            phase_sign = 1
+            break
+        if np.array_equal(_rot_cw(right_patch), left_patch):
+            phase_sign = -1
