+    ar0, ac0, ar1, ac1 = comp_a["bbox"]
+    br0, bc0, br1, bc1 = comp_b["bbox"]
+    out[ar0 : ar1 + 1, ac0 : ac1 + 1] = repaired_a
+    out[br0 : br1 + 1, bc0 : bc1 + 1] = repaired_b
+    return out
+
