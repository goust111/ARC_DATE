+        cols = np.flatnonzero(mask.any(axis=0))
+        if len(rows) == 0 or len(cols) == 0:
+            continue
+        if rows[0] != 0 or rows[-1] != h - 1 or cols[0] != 0 or cols[-1] != w - 1:
