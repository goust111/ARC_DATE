+    if orientation == "right":
+        return inp, out
+    if orientation == "left":
+        return np.fliplr(inp), np.fliplr(out)
+    if orientation == "down":
+        return inp.T, out.T
+    if orientation == "up":
+        return np.flipud(inp.T), np.flipud(out.T)
+    raise ValueError(f"unknown orientation {orientation}")
+
