+
+def _is_solid_rectangle(coords: np.ndarray) -> tuple[bool, BBox]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    box = (int(r0), int(c0), int(r1), int(c1))
+    return coords.shape[0] == _box_area(box), box
