+
+BBox = tuple[int, int, int, int]
+Direction = tuple[int, int]
+
+BG = 0
+CARDINALS: tuple[Direction, ...] = ((0, 1), (0, -1), (1, 0), (-1, 0))
+GEN_ATTEMPTS = 400
