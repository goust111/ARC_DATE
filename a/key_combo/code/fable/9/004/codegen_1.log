+GEN_ATTEMPTS = 400
+
+
+def _shift_box(box: BBox, dr: int, dc: int) -> BBox:
+    r0, c0, r1, c1 = box
+    return r0 + dr, c0 + dc, r1 + dr, c1 + dc
