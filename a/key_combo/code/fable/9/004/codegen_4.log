spec:
  grid: 3x3 input, 9x9 output
  colors: all 9 cells non-black (colors 1-9 only)
  distinct_colors: 3-5
  dominant_color:
    count: 3-4 out of 9 cells, strictly more than any other single color
    uniqueness: exactly one color has the highest frequency (no ties)
  non_dominant_colors: each appears 1-2 times
  transform: |
    Create 9x9 black output divided into a 3x3 grid of 3x3 block slots.
    For each cell in the input whose color equals the dominant color,
    stamp the entire 3x3 input pattern into the corresponding block slot.
    All other block slots remain black.

generation_strategy:
