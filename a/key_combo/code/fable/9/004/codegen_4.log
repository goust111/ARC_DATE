+    outer_h = inner_h + 2
+    outer_w = inner_w + 2
+    grid[r0, c0 : c0 + outer_w] = color
+    grid[r0 + outer_h - 1, c0 : c0 + outer_w] = color
+    grid[r0 : r0 + outer_h, c0] = color
+    grid[r0 : r0 + outer_h, c0 + outer_w - 1] = color
