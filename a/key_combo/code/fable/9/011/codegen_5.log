+        assignment = (0,) + tuple(int(x) for x in rest)
+        normalized = [variants[i][assignment[i]] for i in range(len(tiles))]
+        out, strict, majority_total = _consensus_output(normalized)
+        score = 0
+        for i in range(len(tiles)):
+            for j in range(i + 1, len(tiles)):
+                score += int(pair_lookup[i, j][assignment[i], assignment[j]])
+        result = {
+            "assignment": assignment,
+            "score": score,
+            "strict": strict,
+            "majority_total": majority_total,
+            "output": out,
+        }
+        all_results.append(result)
+        key = (result["score"], int(result["strict"]), result["majority_total"])
+        if best is None or key > (
+            best["score"],
+            int(best["strict"]),
