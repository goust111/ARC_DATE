+            int(cand["strict"]),
+            -cand["ambiguous_tiles"],
+            cand["majority_frac"],
+            cand["tile_score_frac"],
+        )
+        for cand in candidates
+    )
+    winners = [
+        cand
+        for cand in candidates
+        if (
+            cand["score_frac"],
+            int(cand["strict"]),
+            -cand["ambiguous_tiles"],
+            cand["majority_frac"],
+            cand["tile_score_frac"],
+        )
