+
+    solved = main(grid)
+    return np.array_equal(solved, base_tile)
+
+
+def _generate_attempt() -> np.ndarray | None:
+    h = random.randint(5, 7)
+    w = random.randint(5, 7)
+    max_tiles = min(5, 30 // w)
+    if max_tiles < 4:
