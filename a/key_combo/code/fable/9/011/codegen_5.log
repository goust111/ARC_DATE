+        key = (result["score"], int(result["strict"]), result["majority_total"])
+        if best is None or key > (
+            best["score"],
+            int(best["strict"]),
+            best["majority_total"],
+        ):
+            best = result
+
+    assert best is not None
+    best_key = (best["score"], int(best["strict"]), best["majority_total"])
+    peers = [
+        result
+        for result in all_results
+        if (result["score"], int(result["strict"]), result["majority_total"]) == best_key
+    ]
+    best = dict(best)
+    best["peer_count"] = len(peers)
+    best["score_peer_count"] = sum(result["score"] == best["score"] for result in all_results)
+    best["all_results"] = all_results
+    return best
+
+
+def _best_period_solution(grid: np.ndarray) -> dict:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2 and g.shape[1] >= 4, "expected horizontally concatenated tiles"
+
+    candidates = []
+    for block_width in _valid_block_widths(g.shape[1]):
+        tiles = _split_tiles(g, block_width)
+        result = _best_assignment_for_tiles(tiles)
+        result = dict(result)
+        result["block_width"] = block_width
+        result["tile_count"] = len(tiles)
+        candidates.append(result)
+
+    assert candidates, "grid width must admit at least four equal blocks"
+    best_key = max(
+        (cand["score"], int(cand["strict"]), cand["majority_total"])
+        for cand in candidates
+    )
+    winners = [
+        cand
+        for cand in candidates
+        if (cand["score"], int(cand["strict"]), cand["majority_total"]) == best_key
+    ]
