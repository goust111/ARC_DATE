+def _valid_block_widths(total_width: int) -> list[int]:
+    return [w for w in range(1, total_width + 1) if total_width % w == 0 and total_width // w >= 4]
+
+
+def _split_tiles(grid: np.ndarray, block_width: int) -> list[np.ndarray]:
+    return [grid[:, c0 : c0 + block_width].copy() for c0 in range(0, grid.shape[1], block_width)]
+
+
+def _consensus_output(tiles: list[np.ndarray]) -> tuple[np.ndarray, bool, int]:
+    h, w = tiles[0].shape
+    k = len(tiles)
+    out = np.empty((h, w), dtype=int)
+    strict = True
+    majority_total = 0
+    for r in range(h):
+        for c in range(w):
+            counts = Counter(int(tile[r, c]) for tile in tiles)
+            color, count = max(counts.items(), key=lambda kv: (kv[1], -kv[0]))
+            out[r, c] = color
+            majority_total += count
+            strict &= count > k // 2
+    return out, strict, majority_total
+
+
+def _pairwise_score(tiles: list[np.ndarray]) -> int:
+    score = 0
+    for i in range(len(tiles)):
+        for j in range(i + 1, len(tiles)):
+            score += int(np.count_nonzero(tiles[i] == tiles[j]))
+    return score
+
+
+def _best_assignment_for_tiles(tiles: list[np.ndarray]) -> dict:
+    variants = [[_apply_transform(tile, t) for t in range(TRANSFORM_COUNT)] for tile in tiles]
+    pair_lookup = {}
+    for i in range(len(tiles)):
+        for j in range(i + 1, len(tiles)):
+            pair_lookup[i, j] = np.zeros((TRANSFORM_COUNT, TRANSFORM_COUNT), dtype=int)
+            for ti in range(TRANSFORM_COUNT):
+                for tj in range(TRANSFORM_COUNT):
+                    pair_lookup[i, j][ti, tj] = int(np.count_nonzero(variants[i][ti] == variants[j][tj]))
+    best: dict | None = None
+    all_results = []
+    for rest in itertools.product(range(TRANSFORM_COUNT), repeat=len(tiles) - 1):
+        assignment = (0,) + tuple(int(x) for x in rest)
+        normalized = [variants[i][assignment[i]] for i in range(len(tiles))]
+        out, strict, majority_total = _consensus_output(normalized)
+        score = 0
+        for i in range(len(tiles)):
+            for j in range(i + 1, len(tiles)):
+                score += int(pair_lookup[i, j][assignment[i], assignment[j]])
+        result = {
+            "assignment": assignment,
+            "score": score,
+            "strict": strict,
+            "majority_total": majority_total,
+            "output": out,
+        }
+        all_results.append(result)
+        key = (result["score"], int(result["strict"]), result["majority_total"])
+        if best is None or key > (
+            best["score"],
+            int(best["strict"]),
+            best["majority_total"],
+        ):
+            best = result
+
+    assert best is not None
+    best_key = (best["score"], int(best["strict"]), best["majority_total"])
+    peers = [
+        result
+        for result in all_results
+        if (result["score"], int(result["strict"]), result["majority_total"]) == best_key
+    ]
+    best = dict(best)
+    best["peer_count"] = len(peers)
+    best["score_peer_count"] = sum(result["score"] == best["score"] for result in all_results)
+    best["all_results"] = all_results
+    return best
+
+
+def _best_period_solution(grid: np.ndarray) -> dict:
+    g = np.asarray(grid, dtype=int)
