+    if len(set(transforms)) < 2 or all(t == 0 for t in transforms[1:]):
+        return False
+
+    aligned = [_apply_transform(noisy_tiles[i], transforms[i]) for i in range(tile_count)]
+    restored, strict, _majority_total = _consensus_output(aligned)
