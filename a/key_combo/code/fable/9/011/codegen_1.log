+        while stack:
+            cr, cc2 = stack.pop()
+            coords.append((cr, cc2))
+            for nr, nc in _neighbors4(cr, cc2):
+                if _in_bounds(grid.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
