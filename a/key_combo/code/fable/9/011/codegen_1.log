+    r1 = r0 + h - 1
+    c1 = c0 + w - 1
+    if gap_side == "top":
+        if gap_line is None:
+            gap_line = random.randint(c0 + 1, c1 - 1)
+        gap = (r0, gap_line)
+    elif gap_side == "bottom":
+        if gap_line is None:
+            gap_line = random.randint(c0 + 1, c1 - 1)
+        gap = (r1, gap_line)
+    elif gap_side == "left":
+        if gap_line is None:
+            gap_line = random.randint(r0 + 1, r1 - 1)
+        gap = (gap_line, c0)
+    else:
+        if gap_line is None:
+            gap_line = random.randint(r0 + 1, r1 - 1)
+        gap = (gap_line, c1)
