+    return components
+
+
+def _rect_from_component(coords: list[tuple[int, int]]) -> dict:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    bbox = (min(rows), min(cols), max(rows), max(cols))
+    r0, c0, r1, c1 = bbox
+    assert r1 - r0 + 1 >= 3 and c1 - c0 + 1 >= 3
