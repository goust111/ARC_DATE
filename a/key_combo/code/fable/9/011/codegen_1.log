+def _perimeter_cells(bbox: tuple[int, int, int, int]) -> set[tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    cells = {(r0, c) for c in range(c0, c1 + 1)}
+    cells |= {(r1, c) for c in range(c0, c1 + 1)}
+    cells |= {(r, c0) for r in range(r0, r1 + 1)}
+    cells |= {(r, c1) for r in range(r0, r1 + 1)}
+    return cells
+
+
+def _make_rect(
+    r0: int,
+    c0: int,
+    h: int,
+    w: int,
+    gap_side: str,
+    gap_line: int | None = None,
+) -> dict:
+    r1 = r0 + h - 1
+    c1 = c0 + w - 1
+    if gap_side == "top":
+        if gap_line is None:
+            gap_line = random.randint(c0 + 1, c1 - 1)
+        gap = (r0, gap_line)
+    elif gap_side == "bottom":
+        if gap_line is None:
+            gap_line = random.randint(c0 + 1, c1 - 1)
+        gap = (r1, gap_line)
+    elif gap_side == "left":
+        if gap_line is None:
+            gap_line = random.randint(r0 + 1, r1 - 1)
+        gap = (gap_line, c0)
+    else:
+        if gap_line is None:
+            gap_line = random.randint(r0 + 1, r1 - 1)
+        gap = (gap_line, c1)
