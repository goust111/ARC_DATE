+    line: int,
+    dist: int,
+    *,
+    gap_side: str | None = None,
+) -> dict | None:
+    grid_h, grid_w = shape
+    if side in ("left", "right"):
+        row_range = _choose_anchor_range(line, h, grid_h)
+        if row_range is None:
+            return None
+        r0 = random.randint(*row_range)
+        if side == "left":
