+    return "miss", None
+
+
+def _trace_marker_verbose(
+    grid: np.ndarray,
+    marker_pos: tuple[int, int],
+    side: str,
+    gap_entries: dict[tuple[int, int, int, int], int],
+    wall_owner: dict[tuple[int, int], int],
+) -> dict:
