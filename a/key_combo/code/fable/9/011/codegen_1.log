+
+
+def _trace_marker(
+    grid: np.ndarray,
+    marker: dict,
+    gap_entries: dict[tuple[int, int, int, int], int],
+) -> tuple[str, int | None]:
+    (r, c) = marker["pos"]
+    dr, dc = DIR_BY_SIDE[marker["side"]]
+    rr = r + dr
+    cc = c + dc
+    while _in_bounds(grid.shape, rr, cc):
+        val = int(grid[rr, cc])
+        if val == BG:
+            hit = gap_entries.get((rr, cc, dr, dc))
+            if hit is not None:
+                return "hit", hit
+            rr += dr
+            cc += dc
+            continue
