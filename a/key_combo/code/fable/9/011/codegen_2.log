+
+
+def _paint_output(
+    orient: str,
+    axis: int,
+    grid_shape: tuple[int, int],
+    sign_coords: list[tuple[int, int]],
+    sign_colors: tuple[int, int],
+    winner: int,
+    blocks: list[dict],
