+            if (r, c) in sign_coords or int(grid[r, c]) in (BG, YELLOW):
+                continue
+            counts[int(grid[r, c])] = counts.get(int(grid[r, c]), 0) + 1
+    return counts
+
+
+def _validate_attempt(inp: np.ndarray, meta: dict) -> bool:
+    out = meta["out"]
+    orient = meta["orient"]
+    axis = meta["axis"]
+    winner = meta["winner"]
+    loser = meta["loser"]
