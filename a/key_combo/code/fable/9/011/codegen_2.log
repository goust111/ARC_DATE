+
+
+def _next_branch() -> tuple[str, int, int]:
+    global _BRANCH_BAG
+    if not _BRANCH_BAG:
+        _BRANCH_BAG = [
+            (orient, winner_idx, sign_side)
+            for orient in ("h", "v")
+            for winner_idx in (0, 1)
+            for sign_side in (-1, 1)
