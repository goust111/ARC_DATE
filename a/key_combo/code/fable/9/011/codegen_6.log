from __future__ import annotations

from collections import Counter
import random

import numpy as np


BG = 0
WALL = 5
MARKER_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
SIDES = ("top", "bottom", "left", "right")
DIR_BY_SIDE = {
    "top": (1, 0),
    "bottom": (-1, 0),
    "left": (0, 1),
    "right": (0, -1),
}

GRID_MIN = 20
GRID_MAX = 28
RECT_SIDE_MIN = 5
RECT_SIDE_MAX = 8
GEN_ATTEMPTS = 400


def _get_bg(grid: np.ndarray) -> int:
    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])


def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
    h, w = shape
    return 0 <= r < h and 0 <= c < w


def _neighbors4(r: int, c: int):
    yield r - 1, c
    yield r + 1, c
    yield r, c - 1
    yield r, c + 1


def _boxes_touch(a: tuple[int, int, int, int], b: tuple[int, int, int, int], pad: int = 1) -> bool:
    ar0, ac0, ar1, ac1 = a
    br0, bc0, br1, bc1 = b
    return not (
        ar1 + pad < br0
        or br1 + pad < ar0
        or ac1 + pad < bc0
        or bc1 + pad < ac0
    )


def _perimeter_cells(bbox: tuple[int, int, int, int]) -> set[tuple[int, int]]:
    r0, c0, r1, c1 = bbox
    cells = {(r0, c) for c in range(c0, c1 + 1)}
    cells |= {(r1, c) for c in range(c0, c1 + 1)}
    cells |= {(r, c0) for r in range(r0, r1 + 1)}
    cells |= {(r, c1) for r in range(r0, r1 + 1)}
    return cells


def _make_rect(
    r0: int,
    c0: int,
    h: int,
    w: int,
    gap_side: str,
    gap_line: int | None = None,
) -> dict:
    r1 = r0 + h - 1
    c1 = c0 + w - 1
    if gap_side == "top":
        if gap_line is None:
            gap_line = random.randint(c0 + 1, c1 - 1)
        gap = (r0, gap_line)
    elif gap_side == "bottom":
        if gap_line is None:
            gap_line = random.randint(c0 + 1, c1 - 1)
        gap = (r1, gap_line)
    elif gap_side == "left":
        if gap_line is None:
            gap_line = random.randint(r0 + 1, r1 - 1)
        gap = (gap_line, c0)
    else:
        if gap_line is None:
            gap_line = random.randint(r0 + 1, r1 - 1)
        gap = (gap_line, c1)
    return {
        "bbox": (r0, c0, r1, c1),
        "gap": gap,
        "gap_side": gap_side,
    }


def _draw_rect(grid: np.ndarray, rect: dict) -> None:
    r0, c0, r1, c1 = rect["bbox"]
    grid[r0, c0 : c1 + 1] = WALL
    grid[r1, c0 : c1 + 1] = WALL
    grid[r0 : r1 + 1, c0] = WALL
    grid[r0 : r1 + 1, c1] = WALL
    gr, gc = rect["gap"]
    grid[gr, gc] = BG


def _extract_grey_components(grid: np.ndarray) -> list[list[tuple[int, int]]]:
    mask = grid == WALL
    seen = np.zeros(grid.shape, dtype=bool)
    components: list[list[tuple[int, int]]] = []
    for r, c in np.argwhere(mask):
        rr = int(r)
        cc = int(c)
        if seen[rr, cc]:
            continue
        stack = [(rr, cc)]
        seen[rr, cc] = True
        coords: list[tuple[int, int]] = []
        while stack:
            cr, cc2 = stack.pop()
            coords.append((cr, cc2))
            for nr, nc in _neighbors4(cr, cc2):
