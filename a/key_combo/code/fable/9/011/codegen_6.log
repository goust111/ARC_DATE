+                "d": d,
+                "col": col,
+                "base": base,
+                "carry_in": carry,
+                "target": target,
+                "obstacle_row": obstacle_row,
+                "actual": actual,
+                "carry_out": new_carry,
+                "reason": reason,
+            }
+        )
+        carry = new_carry
+
+    carry = 0
