+    right_pad = random.randint(1, free_w - left_pad)
+    grid_h = span_h + top_pad + bottom_pad
+    grid_w = span_w + left_pad + right_pad
+    origin = (-min_r + top_pad, -min_c + left_pad)
+
+    color = random.choice(TEMPLATE_COLORS)
