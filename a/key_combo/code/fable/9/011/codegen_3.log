+def _multiple_of(diff: tuple[int, int], base: tuple[int, int]) -> int | None:
+    dr, dc = diff
+    br, bc = base
+    if br == 0 and bc == 0:
+        return None
+    if br == 0:
+        if dr != 0 or bc == 0 or dc % bc != 0:
