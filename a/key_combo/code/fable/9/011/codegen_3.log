+def _naive_bbox_shrink(mask: np.ndarray, steps: int) -> np.ndarray:
+    h, w = mask.shape
+    out = np.zeros_like(mask, dtype=bool)
+    if 2 * steps >= h or 2 * steps >= w:
+        return out
+    out[steps : h - steps, steps : w - steps] = mask[steps : h - steps, steps : w - steps]
+    return out
+
