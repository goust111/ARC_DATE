+    for k in range(1, marker_count + 1):
+        mr = origin[0] + k * vr
+        mc = origin[1] + k * vc
+        grid[mr, mc] = MARKER
+
+    if not _semantic_checks(grid, template_mask, origin, vector, marker_count, color):
+        return None
+    return grid
