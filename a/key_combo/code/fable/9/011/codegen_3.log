+    min_c = min(0, *(k * vc for k in range(1, marker_count + 1)))
+    max_c = max(w - 1, *(k * vc + w - 1 for k in range(1, marker_count + 1)))
+    span_h = max_r - min_r + 1
+    span_w = max_c - min_c + 1
+
+    free_h = 30 - span_h
+    free_w = 30 - span_w
+    if free_h < 2 or free_w < 2:
