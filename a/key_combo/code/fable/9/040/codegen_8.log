+    unsafe = set(occupied)
+    for group in groups:
+        r0, c0, r1, c1 = group["bbox"]
+        for r in range(r0, r1 + 1):
+            for c in range(c0, c1 + 1):
+                unsafe.add((r, c))
+        for r, c in group["planned_path"]:
+            unsafe.add((r, c))
+            if r > 0:
+                unsafe.add((r - 1, c))
+            if c > 0:
+                unsafe.add((r, c - 1))
+            if c + 1 < w:
+                unsafe.add((r, c + 1))
+
+    cells = [(r, c) for r in range(h) for c in range(w) if (r, c) not in unsafe]
+    random.shuffle(cells)
+    return cells
