+
+def _render_group_markers(group: dict) -> set[tuple[int, int]]:
+    r0, c0, r1, c1 = group["bbox"]
+    missing = tuple(group["missing"])
+    markers = {(r0, c0), (r0, c1), (r1, c0), (r1, c1)}
+    markers.remove(missing)
