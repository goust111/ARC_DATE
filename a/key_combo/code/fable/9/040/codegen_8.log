_GEN_TURN_WEIGHT_BASE, _GEN_TURN_WEIGHT_SLOPE = 1.0, 0.2
_GEN_BLOCKED_PATH_COUNT_CHOICES = (0, 1, 1, 2)

# Obstacle density and row fill.
