+
+def _split_turns(total: int) -> list[int]:
+    if total <= 1:
+        return [total]
+    if total == 2:
+        return random.choice([[2], [1, 1]])
+    return random.choice([[3], [1, 2], [2, 1], [1, 1, 1]])
