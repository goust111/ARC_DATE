_GEN_DENSITY_PERCENT_RANGE, _GEN_PERCENT_DENOMINATOR = (16, 27), 100
_GEN_ROW_OBSTACLE_MAX = 6

# Retry budget.
_GEN_ATTEMPT_LIMIT = 300


def _gen_choose_columns(width, rng):
    choices = []
    for c0 in range(width):
