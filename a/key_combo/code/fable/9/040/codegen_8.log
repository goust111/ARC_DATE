+    for i in range(len(boxes)):
+        for j in range(i + 1, len(boxes)):
+            a = boxes[i]
+            b = boxes[j]
+            if not (a[2] < b[0] or b[2] < a[0] or a[3] < b[1] or b[3] < a[1]):
