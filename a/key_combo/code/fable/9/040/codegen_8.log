spec:
  grid: 8x8 [observed]
  background: orange (7)
  markers:
    color: grey (5) [observed]; any color except teal and background works per solver
    count: exactly 4
    bounding_box: square with side length 3-7
    layout: 3 of 4 bbox corners occupied; 4th marker is 1 diagonal step inward from the missing corner toward the opposite corner
    missing_corner: any of TL/TR/BL/BR (all four seen across examples)
  output:
    triangle_color: teal (8)
    triangle: right isosceles triangle inscribed in the marker bbox
    right_angle_vertex: the missing corner
    legs: two axis-aligned edges of the bbox adjacent to the missing corner
    hypotenuse: diagonal from one adjacent corner to the other
    rule: paint all outline pixels teal except where a grey marker already sits
    pixel_count: 3*(side+1) - 3 total outline pixels, minus 2 markers on outline = teal pixels

generation_strategy:
  approach: direct construction (constraints are simple enough)
  steps:
    1. Choose grid size (8x8 observed, may vary 7-12 for diversity).
    2. Pick background color (orange observed) and marker color (grey observed); ensure neither is teal.
    3. Pick square side length S in [3, grid_size-1]. Pick top-left corner (r0,c0) so bbox fits in grid.
    4. Choose which corner to omit (TL/TR/BL/BR uniformly).
    5. Place markers at the 3 present bbox corners.
    6. Place 4th marker 1 diagonal step from missing corner toward opposite corner.
    7. Fill rest of grid with background. Verify exactly 4 non-bg pixels.
