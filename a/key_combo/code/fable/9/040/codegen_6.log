+    for r0 in range(h):
+        for c0 in range(w):
+            if seen[r0, c0] or int(grid[r0, c0]) == bg:
+                continue
+            stack = [(r0, c0)]
+            seen[r0, c0] = True
+            coords: list[tuple[int, int]] = []
+            colors: set[int] = set()
+            while stack:
+                r, c = stack.pop()
+                coords.append((r, c))
+                colors.add(int(grid[r, c]))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
