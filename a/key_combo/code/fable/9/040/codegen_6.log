+            full = np.array(full_perm, dtype=int).reshape(2, 2)
+            if np.array_equal(full, true_legend):
+                continue
+            visible = broken != bg
+            if not np.any(full[visible] != broken[visible]):
+                continue
+            if _diag_map(full) == _diag_map(true_legend):
+                continue
+            return true_legend, broken, full
+    return None
