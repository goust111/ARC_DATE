+def _separated(box_a: tuple[int, int, int, int], box_b: tuple[int, int, int, int], gap: int) -> bool:
+    return (
+        box_a[2] + gap < box_b[0]
+        or box_b[2] + gap < box_a[0]
+        or box_a[3] + gap < box_b[1]
+        or box_b[3] + gap < box_a[1]
+    )
