129:     sprite = np.where(g[r0 : r1 + 1, c0 : c1 + 1] == sprite_color, sprite_color, bg)
130:     sprite_h, sprite_w = sprite.shape
131:     assert sprite_h == sprite_w
132: 
133:     source_controls = [
134:         control
135:         for control in _three_corner_squares(g, marker_color)
136:         if _corner_matches_bbox(control["missing_kind"], control["missing"], sprite_box)
137:     ]
138:     assert len(source_controls) == 1
139:     source = source_controls[0]
140: 
141:     controls = _three_corner_squares(g, marker_color, side=source["side"])
142:     marker_coords = [tuple(map(int, p)) for p in np.argwhere(g == marker_color)]
143:     used_markers = [marker for control in controls for marker in control["markers"]]
144:     assert sorted(used_markers) == sorted(marker_coords)
145: 
