120:     marker_color = singleton_colors[0]
121:     sprite_colors = [color for color in colors if color != marker_color]
122:     assert len(sprite_colors) == 1
123:     sprite_color = sprite_colors[0]
124: 
125:     sprite_coords = np.argwhere(g == sprite_color)
126:     assert len(sprite_coords) > 0
127:     sprite_box = bbox_coords(sprite_coords)
