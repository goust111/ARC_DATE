7: def main(grid: np.ndarray) -> np.ndarray:
8:     """
9:     Repeat the input tile across the output band indicated by the input's single solid row or column.
10: 
11:     Input structure
12:     The input is an n x n tile with exactly one full row or full column made of
13:     one repeated color.
14: 
15:     Rule
16:     Create an n-by-n block canvas of black n x n blocks. If the solid guide is
17:     row r, copy the input tile into every block of block row r. If the guide is
18:     column c, copy the input tile into every block of block column c.
19: 
20:     Key insight
21:     The solid row or column is a control line: its orientation and index select
22:     the row-band or column-band of the enlarged tiled canvas that remains visible.
23:     """
24:     g = np.asarray(grid, dtype=int)
25:     assert g.ndim == 2, "expected a 2D grid"
26:     height, width = map(int, g.shape)
27:     assert height == width, "expected a square tile"
28:     assert height > 0, "expected a nonempty tile"
29: 
30:     n = height
31:     solid_rows = [r for r in range(n) if np.all(g[r, :] == int(g[r, 0]))]
32:     solid_cols = [c for c in range(n) if np.all(g[:, c] == int(g[0, c]))]
33:     assert len(solid_rows) + len(solid_cols) == 1, "expected exactly one solid guide line"
34: 
35:     out = np.zeros((n * n, n * n), dtype=int)
36:     if solid_rows:
37:         row = solid_rows[0]
38:         out[row * n : (row + 1) * n, :] = np.tile(g, (1, n))
39:     else:
40:         col = solid_cols[0]
41:         out[:, col * n : (col + 1) * n] = np.tile(g, (n, 1))
