69: def main(grid: np.ndarray) -> np.ndarray:
70:     """Extract the central object from the marker cluster whose markers have the same color.
71: 
72:     Input structure
73:     The grid has a dominant background and several clusters; each cluster has four
74:     same-color corner marker objects around one central monochromatic object.
75:     Rule
76:     Find every central object enclosed by four aligned corner markers of one color,
77:     then choose the unique one whose object color equals the marker color.
78:     Key insight
79:     The answer is not the largest or most frequent object; it is the center of the
80:     self-colored cluster, cropped to that object's bounding box with background kept.
81:     """
82:     g = np.asarray(grid, dtype=int)
83:     bg = get_bg(g)
84:     comps = _record_components(g, bg)
85: 
86:     targets = {}
87:     for center in comps:
88:         by_marker_role = defaultdict(lambda: defaultdict(list))
89:         for marker in comps:
90:             if marker["id"] == center["id"]:
91:                 continue
92:             if marker["cr2"] == center["cr2"] or marker["cc2"] == center["cc2"]:
93:                 continue
94:             quad = (
95:                 0 if marker["cr2"] < center["cr2"] else 1,
96:                 0 if marker["cc2"] < center["cc2"] else 1,
97:             )
98:             key = (marker["color"], marker["area"], marker["h"], marker["w"])
99:             by_marker_role[key][quad].append(marker)
100: 
101:         for key, markers_by_quad in by_marker_role.items():
102:             if not all(quad in markers_by_quad for quad in QUADS):
103:                 continue
104:             for markers in product(*(markers_by_quad[quad] for quad in QUADS)):
105:                 if len({marker["id"] for marker in markers}) != 4:
106:                     continue
107:                 if _is_cluster(center, markers) and center["color"] == key[0]:
108:                     targets[center["id"]] = center
109: 
110:     assert len(targets) == 1
111:     target = next(iter(targets.values()))
112:     r0, c0, r1, c1 = _bbox(target)
113:     out = g[r0 : r1 + 1, c0 : c1 + 1].copy()
114:     assert np.all((out == bg) | (out == target["color"]))
