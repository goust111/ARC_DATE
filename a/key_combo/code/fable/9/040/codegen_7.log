18: def main(grid: np.ndarray) -> np.ndarray:
19:     """Swap each non-legend foreground color with its row-mate in the 2x2 upper-left legend.
20: 
21:     Input structure
22:     - A dominant background separates a full 2x2 foreground legend in the
23:       upper-left corner from the main multicolor foreground object.
24:     - The main object uses exactly the four colors shown in the legend.
25: 
26:     Rule
27:     - Leave the legend and background unchanged.
28:     - Treat each legend row as a bidirectional color pair.
29:     - Recolor every foreground pixel outside the legend to the other color in
30:       its legend row, using the original input colors for a simultaneous swap.
31: 
32:     Key insight
33:     - The small 2x2 block is a symbol instruction, not part of the object: its
34:       rows define the pairwise color substitutions for the separate object.
35:     """
36:     g = np.asarray(grid, dtype=int)
37:     assert g.ndim == 2
38: 
39:     bg = get_bg(g)
40:     r0, c0, r1, c1 = _find_legend(g, bg)
41:     legend = g[r0 : r1 + 1, c0 : c1 + 1]
42:     legend_colors = set(map(int, legend.ravel()))
43:     assert legend.shape == (2, 2)
44:     assert bg not in legend_colors, "legend must be foreground"
45:     assert len(legend_colors) == 4, "legend colors must be distinct"
46: 
47:     target_mask = g != bg
48:     target_mask[r0 : r1 + 1, c0 : c1 + 1] = False
49:     assert target_mask.any(), "expected a foreground object outside the legend"
50:     assert set(map(int, g[target_mask])) == legend_colors, "target object must use the legend colors"
51: 
52:     out = g.copy()
53:     for row in range(2):
54:         left = int(legend[row, 0])
55:         right = int(legend[row, 1])
56:         assert left != right
57:         out[(g == left) & target_mask] = right
58:         out[(g == right) & target_mask] = left
