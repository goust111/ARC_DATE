15: def main(input_grid):
16:     """
17:     Grow a periodic vertical-bar pattern rightward from the lone colored pixel and add alternating gray markers.
18: 
19:     Input structure:
20:     - The input is a black grid with exactly one non-black pixel.
21:     - The lone pixel supplies the bar color and starting column.
22:     - Gray is reserved for the alternating marker pixels.
23: 
24:     Rule:
25:     - Draw vertical bars upward from the seed row every two columns to the right.
26:     - Place gray pixels in the intervening columns.
27:     - Alternate the gray marker row between the top and bottom edge.
28: 
29:     Key insight:
30:     - The seed pixel determines the color and phase of a periodic pattern across the remaining columns.
31:     """
32:     # Output grid is the same size as the input grid
33:     output_grid = np.zeros_like(input_grid)
34: 
35:     # Detect the single non-black pixel.
36:     coords = np.argwhere(input_grid != Color.BLACK)
37:     assert coords.shape[0] == 1
38:     pixel_r, pixel_c = map(int, coords[0])
39:     pixel_color = int(input_grid[pixel_r, pixel_c])
40: 
41:     # Get the color of the pattern pixel by observation
42:     pattern_pixel_color = Color.GRAY
43:     
44:     # STEP 1: Draw vertical bar from bottom to top starting from the pixel and going to the right, horizontal period of 2
45:     horizontal_period = 2
46:     L = max(output_grid.shape) * 3
47:     for c in range(pixel_c, output_grid.shape[1], horizontal_period):
48:         # go up from (pixel_r,c)
49:         draw_line(output_grid, pixel_r, c, direction=(-1, 0), length=L, color=pixel_color, clip=True)
50:     
51:     # STEP 2: put a grey pixel in between the vertical bars alternating between the top / bottom.
52:     cur_r = output_grid.shape[0] - 1 if pixel_r == 0 else 0
53:     for c in range(pixel_c + 1, output_grid.shape[1], horizontal_period):
54:         output_grid[cur_r, c] = pattern_pixel_color
55:         # alternate between top and bottom
56:         cur_r = 0 if cur_r == output_grid.shape[0] - 1 else output_grid.shape[0] - 1
