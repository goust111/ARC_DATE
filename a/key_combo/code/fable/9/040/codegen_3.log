+            present = set(frame["present"])
+            if not present <= unused:
+                continue
+            if any(_bboxes_overlap(frame["bbox"], candidates[other]["bbox"]) for other in chosen):
+                continue
+            chosen.append(idx)
+            search(unused - present, chosen)
+            chosen.pop()
