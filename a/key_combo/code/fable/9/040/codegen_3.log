+    search(all_markers, [])
+    assert len(solutions) == 1, "expected a unique frame decomposition"
+    return [candidates[idx] for idx in solutions[0]]
+
+
+def _find_marker_color(grid: np.ndarray, bg: int) -> int:
+    colors = sorted(set(map(int, grid.ravel())) - {bg})
+    candidates = []
+    for color in colors:
