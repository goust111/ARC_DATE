+        return "tl"
+    if (sr1, sc0) == (r0 - 1, c1 + 1):
+        return "tr"
+    if (sr0, sc1) == (r1 + 1, c0 - 1):
+        return "bl"
+    if (sr0, sc0) == (r1 + 1, c1 + 1):
