+                    "tl": (r0, c0),
+                    "tr": (r0, c1),
+                    "bl": (r1, c0),
+                    "br": (r1, c1),
+                }
+                present = {name: pos for name, pos in corners.items() if pos in coord_set}
+                if len(present) not in (3, 4):
