+
+
+def _object_bounds(spec: dict) -> tuple[int, int, int, int]:
+    side = int(spec["side"])
+    min_r = 0
+    min_c = 0
+    max_r = side
+    max_c = side
+    patch = spec.get("patch")
+    if patch is None:
+        return min_r, min_c, max_r, max_c
+    h, w = patch.shape
+    top, left = _outside_top_left((0, 0, side, side), spec["corner"], (h, w))
