        return None

    out = _gen_build_output(h, frames, output_sprite, source_sign)
    inp = _gen_build_input(out, frames[source_i], source_sprite)
    try:
        if np.array_equal(main(inp), out):
            return inp
    except Exception:
        pass
    return None



