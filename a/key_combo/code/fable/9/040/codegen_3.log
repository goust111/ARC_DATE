+def _build_grids(specs: list[dict], bg: int, marker_color: int, shape: tuple[int, int]) -> tuple[np.ndarray, np.ndarray]:
+    inp = np.full(shape, bg, dtype=int)
+    out = np.full(shape, bg, dtype=int)
+
+    for spec in specs:
+        top = int(spec["top"])
+        left = int(spec["left"])
+        side = int(spec["side"])
+        bbox = (top, left, top + side, left + side)
