+    same_corner = anchor_info["corner"]
+    different_corners = [corner for corner in CORNER_NAMES if corner != same_corner]
+    specs.append(
+        {
+            "type": "missing",
+            "side": anchor_info["side"],
+            "corner": same_corner,
+            "patch": anchor_info["patch"],
+            "source_corner": anchor_info["corner"],
