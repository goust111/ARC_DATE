+def _paste(dst: np.ndarray, patch: np.ndarray, top: int, left: int, bg: int) -> None:
+    h, w = patch.shape
+    assert 0 <= top and 0 <= left
+    assert top + h <= dst.shape[0] and left + w <= dst.shape[1]
