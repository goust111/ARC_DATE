+
+def _outside_top_left(frame_bbox: tuple[int, int, int, int], corner: str, shape: tuple[int, int]) -> tuple[int, int]:
+    r0, c0, r1, c1 = frame_bbox
+    h, w = shape
+    if corner == "tl":
+        return r0 - h, c0 - w
+    if corner == "tr":
+        return r0 - h, c1 + 1
+    if corner == "bl":
