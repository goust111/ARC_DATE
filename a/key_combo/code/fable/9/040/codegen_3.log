+    cells = {start}
+    frontier = {start}
+    while len(cells) < size and frontier:
+        rr, cc = rng.choice(tuple(frontier))
+        options = []
+        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+            nr = rr + dr
+            nc = cc + dc
+            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in cells:
+                options.append((nr, nc))
+        if not options:
+            frontier.remove((rr, cc))
