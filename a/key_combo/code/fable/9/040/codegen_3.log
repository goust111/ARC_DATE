+                cc0 = left + min_c
+                rr1 = top + max_r
+                cc1 = left + max_c
+                pr0 = max(0, rr0 - 1)
+                pc0 = max(0, cc0 - 1)
+                pr1 = min(h - 1, rr1 + 1)
+                pc1 = min(w - 1, cc1 + 1)
