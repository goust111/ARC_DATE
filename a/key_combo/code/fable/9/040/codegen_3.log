+
+def _find_frames(marker_coords: list[tuple[int, int]]) -> list[dict]:
+    coord_set = set(marker_coords)
+    rows = sorted({r for r, _ in marker_coords})
+    cols = sorted({c for _, c in marker_coords})
+    frames = []
+
+    for r0 in rows:
+        for r1 in rows:
