+        side = int(frame["side"])
+        bbox = frame["bbox"]
+        r0, c0, r1, c1 = bbox
+        if not np.array_equal(inp[r0 : r1 + 1, c0 : c1 + 1], out[r0 : r1 + 1, c0 : c1 + 1]):
+            return False
