+                if inside != set(present.values()):
+                    continue
+                missing_kind = None
+                if len(present) == 3:
+                    missing_kind = next(name for name in CORNER_NAMES if name not in present)
+                frames.append(
+                    {
+                        "bbox": (r0, c0, r1, c1),
+                        "side": side,
+                        "present": tuple(sorted(present.values())),
+                        "missing_kind": missing_kind,
+                        "kind": "full" if len(present) == 4 else "missing",
