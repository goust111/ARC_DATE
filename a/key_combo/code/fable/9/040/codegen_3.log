+
+def _draw_frame(grid: np.ndarray, bbox: tuple[int, int, int, int], marker_color: int, missing_kind: str | None) -> None:
+    r0, c0, r1, c1 = bbox
+    corners = {
+        "tl": (r0, c0),
+        "tr": (r0, c1),
+        "bl": (r1, c0),
+        "br": (r1, c1),
