+def _attached_corner(frame_bbox: tuple[int, int, int, int], sprite_bbox: tuple[int, int, int, int]) -> str | None:
+    r0, c0, r1, c1 = frame_bbox
+    sr0, sc0, sr1, sc1 = sprite_bbox
