+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+CORNER_SIGNS = {
+    "tl": (-1, -1),
+    "tr": (-1, 1),
+    "bl": (1, -1),
+    "br": (1, 1),
+}
+CORNER_NAMES = tuple(CORNER_SIGNS)
+PALETTE = tuple(range(1, 10))
+GEN_ATTEMPTS = 400
