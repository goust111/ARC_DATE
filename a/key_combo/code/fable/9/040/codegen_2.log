+        "ne": np.zeros((h, h), dtype=bool),
+        "sw": np.zeros((h, h), dtype=bool),
+        "se": np.zeros((h, h), dtype=bool),
+    }
+    masks["nw"][0, :] = True
+    masks["nw"][:, 0] = True
+    masks["ne"][0, :] = True
+    masks["ne"][:, -1] = True
+    masks["sw"][-1, :] = True
+    masks["sw"][:, 0] = True
+    masks["se"][-1, :] = True
