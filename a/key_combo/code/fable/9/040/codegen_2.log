+
+def _marker_patch(size: int, color: int, orientation: str, bg: int) -> np.ndarray:
+    patch = np.full((size, size), bg, dtype=int)
+    if orientation == "nw":
+        patch[0, :] = color
+        patch[:, 0] = color
+    elif orientation == "ne":
+        patch[0, :] = color
+        patch[:, -1] = color
+    elif orientation == "sw":
+        patch[-1, :] = color
+        patch[:, 0] = color
+    else:
+        patch[-1, :] = color
+        patch[:, -1] = color
