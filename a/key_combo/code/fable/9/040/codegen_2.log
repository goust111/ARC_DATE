+
+def _cluster_patch(marker_size: int, marker_color: int, center_patch: np.ndarray, bg: int) -> np.ndarray:
+    h, w = center_patch.shape
+    overlap = marker_size - 2
+    center_r0 = 2
+    center_c0 = 2
+    bottom_r0 = center_r0 + h - overlap
+    right_c0 = center_c0 + w - overlap
