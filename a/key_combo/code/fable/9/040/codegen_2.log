+def _semantic_checks(
+    grid: np.ndarray,
+    expected: np.ndarray,
+    self_pos: tuple[int, int],
+    target_pos: tuple[int, int],
+    center_patches: dict[tuple[int, int], np.ndarray],
+) -> bool:
+    if self_pos == target_pos:
