+                "coords": coords,
+                "bbox": box,
+                "area": int(len(coords)),
+                "color_counts": counts,
+                "colors": tuple(sorted(counts)),
+                "h": int(r1 - r0 + 1),
+                "w": int(c1 - c0 + 1),
+                "cr2": int(r0 + r1),
+                "cc2": int(c0 + c1),
