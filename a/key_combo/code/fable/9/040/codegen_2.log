+def _aligned(markers: tuple[dict, dict, dict, dict]) -> bool:
+    nw, ne, sw, se = [m["bbox"] for m in markers]
+    return (
+        (nw[0], nw[2]) == (ne[0], ne[2])
+        and (sw[0], sw[2]) == (se[0], se[2])
+        and (nw[1], nw[3]) == (sw[1], sw[3])
+        and (ne[1], ne[3]) == (se[1], se[3])
+        and nw[3] < ne[1]
+        and sw[3] < se[1]
+        and nw[2] < sw[0]
+        and ne[2] < se[0]
