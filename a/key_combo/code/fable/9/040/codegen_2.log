+    _paste(patch, _marker_patch(marker_size, marker_color, "sw", bg), bottom_r0, 0, transparent=bg)
+    _paste(patch, _marker_patch(marker_size, marker_color, "se", bg), bottom_r0, right_c0, transparent=bg)
