+    masks = []
+    for bits in range(1, 1 << total):
+        flat = np.array([(bits >> i) & 1 for i in range(total)], dtype=bool)
+        mask = flat.reshape(h, w)
+        if not mask[0, :].any() or not mask[-1, :].any() or not mask[:, 0].any() or not mask[:, -1].any():
