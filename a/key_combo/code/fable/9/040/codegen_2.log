+    masks["nw"][:, 0] = True
+    masks["ne"][0, :] = True
+    masks["ne"][:, -1] = True
+    masks["sw"][-1, :] = True
+    masks["sw"][:, 0] = True
+    masks["se"][-1, :] = True
