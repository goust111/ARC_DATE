+            markers = [("T", a), ("B", b)]
+            cancelled = _forbidden_targets(frame_bbox, markers, row_targets, col_targets)
+            if 0 < len(cancelled) < total:
+                out.append(markers)
+
+    for side_row in ("L", "R"):
+        for side_col in ("T", "B"):
+            for r in free_rows:
+                for c in free_cols:
+                    markers = [(side_row, r), (side_col, c)]
+                    cancelled = _forbidden_targets(frame_bbox, markers, row_targets, col_targets)
+                    if 0 < len(cancelled) < total:
