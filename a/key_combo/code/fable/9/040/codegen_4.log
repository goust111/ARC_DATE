+                    cancelled = _forbidden_targets(frame_bbox, markers, row_targets, col_targets)
+                    if 0 < len(cancelled) < total:
+                        out.append(markers)
+
+    for a in free_cols:
+        for b in free_cols:
+            if a > b:
+                continue
+            for side in ("L", "R"):
+                for r in free_rows:
+                    markers = [("T", a), ("B", b), (side, r)]
+                    cancelled = _forbidden_targets(frame_bbox, markers, row_targets, col_targets)
+                    if 0 < len(cancelled) < total:
+                        out.append(markers)
+
+    random.shuffle(out)
+    uniq = []
+    seen = set()
