  source_columns:
    count: 3-6 distinct columns in row 0
    extent: contiguous vertical stripe from row 0 down to obs_row-2 or obs_row-1 (gap 0-1 to obstacle)
    spacing: gaps of 2-4 between adjacent source cols [observed]
  obstacle:
    single_row: one row, position at roughly 40-50% of grid height (row 4-5)
    segments: 1-2 contiguous horizontal runs, each length 2-4
    no_edge_touch: segments never occupy col 0 or col W-1
    gap_between_segments: >=1 col when multiple segments
  detours:
