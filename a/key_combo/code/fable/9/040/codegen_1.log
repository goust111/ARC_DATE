    out = []
    rest_min = len(caps) - 1
    rest_max = sum(caps[1:])
    for first in range(1, caps[0] + 1):
        remaining = total - first
        if rest_min <= remaining <= rest_max:
            for tail in _gen_d6e50e54_count_allocations(remaining, caps[1:]):
                out.append((first,) + tail)
