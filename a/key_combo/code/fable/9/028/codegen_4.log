+    return [out[idx] for idx in segment_ids]
+
+
+def _is_isolated(grid: np.ndarray, bg: int) -> bool:
+    for r, c in np.argwhere(grid != bg):
+        rr = int(r)
+        cc = int(c)
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                if dr == 0 and dc == 0:
+                    continue
+                nr, nc = rr + dr, cc + dc
+                if _in_bounds(grid.shape, nr, nc) and int(grid[nr, nc]) != bg:
+                    return False
+    return True
+
