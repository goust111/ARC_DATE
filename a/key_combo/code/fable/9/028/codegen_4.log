+        for pos_arr in np.argwhere(inp == color):
+            pos = tuple(map(int, pos_arr))
+            if pos not in model["cell_segment"]:
+                return False
+            seg_id = model["cell_segment"][pos]
+            remnant_segment_ids.add(seg_id)
+            by_orientation[orientation].add(seg_id)
