+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+    candidates = _solve_candidates(g)
+    assert len(candidates) == 1, "expected a unique compatible spiral"
+    return candidates[0]["output"]
+
