spec:
  grid: 11-13 rows x 11-13 cols, always square
  background: 0
  palette:
    position: (0,0) and (0,1), always present
    h_color: grid[0,0], horizontal segment color; any color in 2-9
    v_color: grid[0,1], vertical segment color; any color in 2-9
    constraint: h_color != v_color, both != bg(0), both != marker_color
  marker:
    count: exactly 1 pixel, the only other non-bg pixel
    color: 1 [observed]; must differ from bg, h_color, v_color
    position: not at (0,0)/(0,1); col >= 2 (first segment goes left 2)
    min_edge_distance: >= 3 [observed], ensures >= 4 complete spiral segments
  output:
    palette pixels cleared to bg; marker preserved
    spiral drawn from marker: left, down, right, up cycling
    segment lengths: 2, 3, 4, 5, ... incrementing by 1
    horizontal segments painted h_color, vertical segments painted v_color
    stops at first step that would leave grid bounds
  spiral_stats:
    complete_segments: 4-11
    total_segments_including_partial: 5-12

generation_strategy:
  approach: output-first (build spiral, then extract input)
  steps:
    1. Pick grid size N x N, N in [11..15].
    2. Pick 3 distinct non-bg colors for h_color, v_color, marker_color.
    3. Simulate spiral from a candidate marker position (mr, mc) with mc >= 2
       and min distance to any edge >= 3. Require >= 4 complete segments.
       If fewer, re-pick position or grid size.
    4. Build output grid with spiral painted and marker placed.
    5. Build input grid as all-bg + palette at (0,0)/(0,1) + marker pixel.
