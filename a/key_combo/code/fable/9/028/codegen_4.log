+    if len(remnant_segment_ids) < MIN_REMAINT_SEGMENTS:
+        return False
+    if len(by_orientation["h"]) < 2 or len(by_orientation["v"]) < 2:
+        return False
+    if by_stage < len(buckets):
+        return False
+    if not any(seg_id >= len(model["segments"]) - 2 for seg_id in remnant_segment_ids):
+        return False
+    return True
+
+
