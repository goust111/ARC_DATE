def _gen_slice_cells(r, c, axis, order):
    if axis == "h":
        cols = [c - 1, c, c + 1]
        if order == "desc":
            cols.reverse()
        return [(r, cc) for cc in cols]

    rows = [r - 1, r, r + 1]
    if order == "desc":
        rows.reverse()
    return [(rr, c) for rr in rows]


