+    pair_count = random.randint(3, min(5, len(accents) + 1))
+
+    for i in range(pair_count):
+        color = accents[i % len(accents)]
+        placed = False
+        for _ in range(120):
+            rh = random.choice(PAIR_RECT_SIDES)
+            rw = random.choice(PAIR_RECT_SIDES)
+            if rh > h or rw > w:
