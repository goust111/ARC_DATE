+def _find_separator(grid: np.ndarray) -> int:
+    h, w = grid.shape
+    candidates = []
+    for c in range(1, w - 1):
+        if 2 * c + 1 != w:
+            continue
+        if not np.all(grid[:, c] == grid[0, c]):
+            continue
+        color = int(grid[0, c])
+        if int(np.count_nonzero(grid == color)) != h:
+            continue
+        candidates.append(c)
+    assert len(candidates) == 1, "expected exactly one separator column"
+    return candidates[0]
