    r = start[0] + direction[0] * step
    c = start[1] + direction[1] * step
    if step % 2 == 0:
        return [(r, c)]
    return _gen_slice_cells(r, c, odd_axis, odd_order)


def _gen_max_ray_len(shape, start, direction):
