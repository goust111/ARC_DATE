def _gen_interior_area(h: int, w: int) -> int:
    return (h - 2) * (w - 2)


def _gen_dimension_candidates(layout: str) -> list[tuple[tuple[int, int], tuple[int, int]]]:
    candidates = []
    for h1 in FRAME_DIMENSIONS:
        for w1 in FRAME_DIMENSIONS:
