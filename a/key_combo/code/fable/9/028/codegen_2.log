+
+def _bbox(coords: np.ndarray) -> BBox:
+    r0 = int(coords[:, 0].min())
+    c0 = int(coords[:, 1].min())
+    r1 = int(coords[:, 0].max())
+    c1 = int(coords[:, 1].max())
+    return r0, c0, r1, c1
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[Coord] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            out.append(np.array(coords, dtype=int))
+    return out
+
+
+def _ring_mask(h: int, w: int) -> np.ndarray:
+    ring = np.zeros((h, w), dtype=bool)
+    ring[0, :] = True
+    ring[-1, :] = True
+    ring[:, 0] = True
+    ring[:, -1] = True
+    return ring
+
+
+def _frame_from_component(grid: np.ndarray, color: int, coords: np.ndarray, bg: int) -> dict | None:
+    if int(coords.shape[0]) < 8:
+        return None
+    r0, c0, r1, c1 = _bbox(coords)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return None
+
+    sub = grid[r0 : r1 + 1, c0 : c1 + 1]
+    patch = np.zeros((h, w), dtype=bool)
+    for r, c in coords:
+        patch[int(r) - r0, int(c) - c0] = True
+
+    ring = _ring_mask(h, w)
+    if np.any(patch & ~ring):
+        return None
+    if np.any(sub[1:-1, 1:-1] != bg):
+        return None
+
+    missing = np.argwhere(ring & ~patch)
+    if len(missing) > 1:
+        return None
+    if int(patch.sum()) != int(ring.sum()) - len(missing):
+        return None
+
+    opening: Coord | None = None
+    inner_start: Coord | None = None
+    if len(missing) == 1:
+        mr, mc = map(int, missing[0])
+        is_corner = (mr in (0, h - 1)) and (mc in (0, w - 1))
+        if is_corner:
+            return None
+        opening = (r0 + mr, c0 + mc)
+        if mr == 0:
+            inner_start = (r0 + 1, c0 + mc)
+        elif mr == h - 1:
+            inner_start = (r1 - 1, c0 + mc)
+        elif mc == 0:
