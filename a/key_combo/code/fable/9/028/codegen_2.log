+        "color": int(color),
+        "bbox": (r0, c0, r1, c1),
+        "opening": opening,
+        "inner_start": inner_start,
+        "capacity": max(0, (h - 2) * (w - 2)),
+        "interior": interior,
+        "border_coords": {tuple(map(int, xy)) for xy in coords.tolist()},
