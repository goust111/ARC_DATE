+        return dist
+    allowed = None if restrict_to is None else set(restrict_to)
+    q = deque([start])
+    dist[start] = 0
+    while q:
+        r, c = q.popleft()
+        nd = int(dist[r, c]) + 1
+        for nr, nc in _neighbors4(r, c):
+            if not _in_bounds(passable.shape, nr, nc) or not passable[nr, nc]:
+                continue
+            if allowed is not None and (nr, nc) not in allowed:
+                continue
+            if dist[nr, nc] != INF:
+                continue
+            dist[nr, nc] = nd
+            q.append((nr, nc))
+    return dist
+
