+    for frame in frames:
+        r0, c0, r1, c1 = frame["bbox"]
+        patch = _frame_patch(r1 - r0 + 1, c1 - c0 + 1, frame["color"], frame["opening_side"], frame["opening_pos"])
+        canvas[r0 : r1 + 1, c0 : c1 + 1] = patch
