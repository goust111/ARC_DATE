   222	    open_frames = [frame for frame in scene["frames"] if frame["opening"] is not None]
   223	    if not open_frames or not scene["tokens"]:
   224	        return out
   225	
   226	    openings = [frame["opening"] for frame in open_frames]
   227	    assert all(opening is not None for opening in openings)
   228	    dists = [_bfs_dist(scene["passable"], opening) for opening in openings]  # type: ignore[arg-type]
   229	
   230	    assigned: dict[int, list[tuple[int, int, int]]] = {i: [] for i in range(len(open_frames))}
   231	    for r, c in scene["tokens"]:
   232	        finite = [(int(dist[r, c]), idx) for idx, dist in enumerate(dists) if int(dist[r, c]) < INF]
   233	        if not finite:
   234	            continue
   235	        best = min(d for d, _ in finite)
   236	        winners = [idx for d, idx in finite if d == best]
   237	        assert len(winners) == 1, "each grain must have a unique nearest reachable opening"
   238	        assigned[winners[0]].append((best, r, c))
