    start: tuple[int, int],
    direction: tuple[int, int],
) -> None:
    r, c = start
    dr, dc = direction
    while _in_bounds(g.shape, r, c) and int(g[r, c]) == bg and not _row_pinched(g, bg, r, c):
        _paint_cell(g, out, bg, r, c, Color.RED)
        r += dr
        c += dc


