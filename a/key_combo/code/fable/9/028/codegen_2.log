+            return None
+    return grid, placed
+
+
+def _distance_maps(shape: tuple[int, int], frames: list[dict]) -> tuple[np.ndarray, list[np.ndarray], list[dict]]:
+    wall_colors = [int(frame["color"]) for frame in frames]
