  "type": "move_to_match",
  "src": "foreground sprite s already anchored at one three-marker square frame",
  "dst": "three-marker square frame d with one missing corner",
  "match_cond": "d.side == source frame side; d.missing_corner gives the anchor corner and quadrant",
  "transform": "clear s from its source bbox and stamp s at every d; reflect s horizontally or vertically when d's missing-corner quadrant differs from the source quadrant"
}
</annotation>
<generation_spec>
```yaml
spec:
  grid: 25-30 rows x 25-30 cols (square)
  colors: bg=black(0), marker=yellow(4), sprite=red(2)
  marker_squares:
    count: 4-8 three-corner squares, each missing exactly one corner
    side: 2 [observed]; all squares share the same side length
    markers: 3 singleton yellow pixels per square; every yellow pixel belongs to exactly one square; no shared markers
    missing_corners: mix of tl/tr/bl/br across squares (all four types appear across examples)
  sprite:
    shape: square NxN where N=2-3 (N <= side+1)
    pixels: 4-8 colored cells within the NxN bbox; 8-connected single component
    if hollow_border (all border cells filled, center empty): solver extracts L-shaped corner-bracket motif based on source anchor
    if not hollow_border: must be asymmetric under LR or UD flip so reflections are distinguishable
  source_placement: sprite bbox corner touches the missing-corner pixel of exactly one marker square
  constraints:
    - all sprite paste areas (NxN at each missing corner) fit within grid bounds
    - no overlap between any two paste areas
    - no overlap between paste areas and any marker pixel
  output:
    - clear original sprite from input
    - stamp (possibly reflected) sprite copy at every marker square's missing corner
    - reflection determined by comparing target missing-corner quadrant to source missing-corner quadrant
    - markers unchanged

generation_strategy:
  approach: output-first
  steps:
    1. Pick grid size 25-30 (square). Pick side S=2, sprite size N in {2,3}.
    2. Design sprite pattern in NxN grid (connected, square bbox, asymmetric or hollow-border).
    3. Pick K=4-8 marker squares. For each, choose a missing corner type (tl/tr/bl/br).
    4. Assign one square as source. Compute the reflected sprite for each square based on source vs target missing corner.
    5. Place all K squares + their sprite paste areas on the grid ensuring no overlaps, all in-bounds, and no marker-sprite conflicts. Use greedy random placement with collision checking.
    6. Build the output grid with all K sprite copies stamped (reflected as needed).
    7. Build the input by keeping only the source square's sprite copy and removing all others.
