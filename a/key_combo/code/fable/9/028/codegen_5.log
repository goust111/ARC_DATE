+    (-1, -1): (2, 2),
+    (-1, 1): (2, 0),
+    (1, -1): (0, 2),
+    (1, 1): (0, 0),
+}
+
+GRID_MIN = 18
+GRID_MAX = 30
+ACTIVE_LEN_CHOICES = (3, 4)
+EXTRA_DEVICE_CHOICES = (1, 2)
+GAP_RANGE = (2, 5)
+SHADOW_GAP_RANGE = (2, 4)
+MARGIN_RANGE = (3, 6)
+TERMINAL_MIN_LEN = 2
+TERMINAL_MAX_LEN = 10
+GEN_ATTEMPTS = 600
+EXTRA_PLACE_TRIES = 160
+PALETTE = [1, 3, 4, 5, 6, 7, 8, 9]
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def _neighbors8(r: int, c: int):
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            yield r + dr, c + dc
+
+
+def _non_bg_components(grid: np.ndarray, bg: int) -> list[list[tuple[int, int]]]:
+    h, w = grid.shape
+    visited = np.zeros((h, w), dtype=bool)
+    comps = []
+    for r in range(h):
+        for c in range(w):
+            if visited[r, c] or int(grid[r, c]) == bg:
+                continue
+            stack = [(r, c)]
+            visited[r, c] = True
+            coords = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors8(rr, cc):
+                    if _in_bounds((h, w), nr, nc) and not visited[nr, nc] and int(grid[nr, nc]) != bg:
+                        visited[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(coords)
+    return comps
+
+
