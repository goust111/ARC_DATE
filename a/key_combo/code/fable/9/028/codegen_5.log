    _paint_obstacles(grid, obstacle_cells, obstacle_colors, color_counts)
    for r, c in markers:
        grid[r, c] = MARKER_COLOR
    return grid


def generate_input() -> np.ndarray:
    for _ in range(GEN_MAX_ATTEMPTS):
        inp = _gen_attempt()
        if inp is None:
            continue
        expected = _gen_expected_output(inp)
        try:
            actual = main(inp)
        except Exception:
