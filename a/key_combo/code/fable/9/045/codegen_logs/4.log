+def _build_shared_source(height: int, width: int) -> tuple[dict[str, Coord], list[tuple[str, str]]] | None:
+    hr = _sample_range(4, height - 5)
+    hc = _sample_range(4, width - 5)
+    if hr is None or hc is None:
