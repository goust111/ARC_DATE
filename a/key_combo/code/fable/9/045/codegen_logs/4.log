+def _transform(coord: Coord, height: int, width: int, flip_r: bool, flip_c: bool) -> Coord:
+    r, c = coord
+    if flip_r:
+        r = height - 1 - r
+    if flip_c:
+        c = width - 1 - c
+    return int(r), int(c)
+
+
+def _sample_range(lo: int, hi: int) -> int | None:
+    if lo > hi:
+        return None
+    return random.randint(lo, hi)
+
