+        for cell in _path_cells(dots[start_color], dots[end_color]):
+            claims[cell] += 1
+
+    out = np.full(shape, int(bg), dtype=int)
+    for cell, count in claims.items():
+        r, c = cell
+        out[r, c] = OVERLAP_COLOR if count >= 2 else PATH_COLOR
+    for color, (r, c) in dots.items():
+        out[r, c] = int(color)
+    return out
+
