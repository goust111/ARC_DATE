            else:
                out=(curd[0],-curd[1])
            if room_from(turn,out,grid.shape) < (MIN_SEG if need_more else 1):
                return None
            first=(turn[0]+out[0], turn[1]+out[1])
            if not cell_valid(first, occupied, turn, grid.shape, reserved):
                return None
            cur=turn
            curd=out
        else:
            k,turn,_,_=boundary_event(cur,curd,grid.shape)
            if k < MIN_SEG:
