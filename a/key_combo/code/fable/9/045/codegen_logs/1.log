        c = int(c_raw + dc)
        assert 0 <= r < g.shape[0] and 0 <= c < g.shape[1], "translated pixel must stay in bounds"
        assert int(out[r, c]) == bg, "translated object must land on empty cells"
        out[r, c] = moving_color

    return out

