    return out


def boundary_event(cur,d,shape):
    H,W=shape
    r,c=cur; dr,dc=d
    row_steps=(H-1-r) if dr>0 else r
    col_steps=(W-1-c) if dc>0 else c
    k=min(row_steps,col_steps)
    hit_row=row_steps==k
    hit_col=col_steps==k
    cell=(r+dr*k,c+dc*k)
    return k,cell,hit_row,hit_col


def cell_valid(cell, occupied, prev, shape, reserved):
    r,c=cell
    if not in_bounds(shape,r,c):
        return False
    if cell in occupied or cell in reserved:
        return False
    adj={nb for nb in n8(r,c) if nb in occupied}
    return adj==({prev} if prev is not None else set())


def segment_cells(cur,d,steps):
    r,c=cur; dr,dc=d
    return [(r+dr*k,c+dc*k) for k in range(1,steps+1)]


def segment_valid(cur,d,steps,occupied,shape,reserved):
    prev=cur
    temp_occ=set(occupied)
    cells=[]
    for cell in segment_cells(cur,d,steps):
        if not cell_valid(cell,temp_occ,prev,shape,reserved):
            return None
        cells.append(cell)
        temp_occ.add(cell)
        prev=cell
    return cells


def mirror_cell_ok(m, turn, occupied, reserved, shape):
    r,c=m
    if not in_bounds(shape,r,c):
        return False
    if m in occupied or m in reserved:
        return False
    adj={nb for nb in n8(r,c) if nb in occupied}
    return adj=={turn}


def room_from(cell,d,shape):
    return boundary_event(cell,d,shape)[0]


def choose_mirror(cur,d,occupied,reserved,shape,need_more):
    kmax,_,_,_=boundary_event(cur,d,shape)
    choices=[]
    for k in range(MIN_SEG, kmax):
        seg=segment_valid(cur,d,k,occupied,shape,reserved)
        if seg is None:
            continue
        turn=seg[-1]
        tr,tc=turn
        if not (0<tr<shape[0]-1 and 0<tc<shape[1]-1):
            continue
        m=(tr+d[0], tc+d[1])
        if not (0<m[0]<shape[0]-1 and 0<m[1]<shape[1]-1):
            continue
        if not mirror_cell_ok(m,turn,occupied|set(seg),reserved,shape):
            continue
        for out in ((d[0],-d[1]),(-d[0],d[1])):
            if room_from(turn,out,shape) < (MIN_SEG if need_more else 1):
                continue
            first=(turn[0]+out[0], turn[1]+out[1])
            if not cell_valid(first, occupied|set(seg), turn, shape, reserved|{m}):
                continue
            choices.append((seg,turn,m,out))
    if not choices:
        return None
    return random.choice(choices)


def apply_segment(grid, path, occupied, cells):
    for cell in cells:
        occupied.add(cell)
        path.append(cell)
        grid[cell]=GREEN


def gen_one():
    H=random.randint(12,20)
    W=random.randint(12,20)
    grid=np.zeros((H,W),dtype=int)
