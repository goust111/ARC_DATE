import random
import numpy as np

BG=0
RED=2
GREEN=3
TEAL=8
DIAGS=[(-1,-1),(-1,1),(1,-1),(1,1)]
PATTERNS=[('M','B','E'),('B','M','E'),('M','B','M','E'),('B','M','B','E'),('M','M','B','E'),('B','M','M','E'),('M','B','B','E'),('B','B','M','E')]
MIN_SEG=2
MAX_ATT=500


def in_bounds(shape,r,c):
    H,W=shape
    return 0<=r<H and 0<=c<W

def n8(r,c):
    for dr in (-1,0,1):
        for dc in (-1,0,1):
            if dr==0 and dc==0: continue
            yield r+dr,c+dc

def trace(grid):
    starts=np.argwhere(grid==TEAL)
    assert starts.shape==(1,2)
    start=tuple(map(int,starts[0]))
    path_cells={tuple(map(int,rc)) for rc in np.argwhere((grid==TEAL)|(grid==GREEN))}
    out=[start]
    prev=None
    cur=start
    seen={start}
    while True:
        cand=[]
        for nr,nc in n8(*cur):
            if in_bounds(grid.shape,nr,nc) and (nr,nc) in path_cells and (nr,nc)"'!=prev:
                cand.append((nr,nc))
        if prev is None:
            assert len(cand)==1, ('"'startdeg', len(cand), start)
        else:
            assert len(cand)<=1, ('branch', cur, cand)
        if not cand:
            break
        nxt=cand[0]
        assert nxt not in seen, ('loop', nxt)
        seen.add(nxt)
        out.append(nxt)
        prev,cur=cur,nxt
    assert seen==path_cells, ('disconnected', len(seen), len(path_cells), path_cells-seen)
    return out

def solver(grid):
    path=trace(grid)
    out=grid.copy()
    H,W=grid.shape
    for i in range(1,len(path)-1):
        pr,pc=path[i-1]
        r,c=path[i]
        nr,nc=path[i+1]
        din=(r-pr,c-pc)
        dout=(nr-r,nc-c)
        if din"'!=dout and 0<r<H-1 and 0<c<W-1:
            mr,mc=r+din[0], c+din[1]
            assert in_bounds(grid.shape,mr,mc)
