        dout=(path[i+1][0]-path[i][0], path[i+1][1]-path[i][1])
        if din!=dout:
            turns.append(path[i])
    ints=[t for t in turns if 0<t[0]<H-1 and 0<t[1]<W-1]
    bnds=[t for t in turns if not (0<t[0]<H-1 and 0<t[1]<W-1)]
    if not ints or not bnds:
        return None
    return grid,out,path,mirrors,pattern

ok=0
for i in range(1000):
    g=gen_one()
    if g is not None:
