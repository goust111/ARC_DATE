  "dst": "row-major cells d of a fixed 2x3 summary grid",
  "match_cond": "rank(s by color group order) == rank(d row-major)",
  "transform": "discard each bar's position and length; write one cell of its color for each bar, leaving unused slots black",
  "grid_shape": "fixed 2x3"
}
</annotation>
