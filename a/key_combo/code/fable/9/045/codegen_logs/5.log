spec:
  grid: 22-24 rows x 17-20 cols, black background
  bar_pairs:
    count: 2 [observed]
    colors: green(3) and azure(8) [observed]; pink(6) reserved for overlap
    structure: each color forms exactly two 1-pixel-wide vertical bars at distinct columns, same row interval
    bar_height: 1-5
    column_gap: 2-5 (distance between left and right bar columns)
    placement: bars of different colors do not share any columns or row intervals
  rays:
    rule: |
      Each bar extends upward and downward in blocks of bar_height rows.
      At each block away from the original interval, the left bar shifts 1 column left
      and the right bar shifts 1 column right. Clipped at grid edges.
    total_steps_per_pair: 4-15 (sum of up and down extension steps)
    overlap: cells claimed by 2+ colors become pink(6); 0-7 pink cells across examples
  margins:
    each bar pair has enough margin on at least one side (up or down) for >=2 stepping blocks
    min_col_margin_for_short_side: >=1 (at least 1 step on the constrained side)

generation_strategy:
  approach: direct placement (input-only; output derived deterministically by solver)
  steps:
    1. Pick grid size 22-24 rows x 17-20 cols.
    2. For each of 2 colors (green, azure), pick bar_height (1-5) and column_gap (2-5).
    3. Place each bar pair on the grid ensuring left_col >= 1 and right_col <= W-2
       so rays can extend at least 1 step outward on each side.
    4. Pick row intervals so each pair has >=3 bar_height blocks of space above or below
       (ensures total_ray_steps >= 4).
    5. Verify the two pairs do not share columns or row intervals and have
       inter-pair column separation >= 2.
    6. Verify solver produces a non-trivial output (total non-black cells >= 20).

