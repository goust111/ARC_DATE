+def _point_on_ray(point: tuple[int, int], rect: dict) -> bool:
+    pr, pc = map(int, point)
+    mr, mc = rect["missing"]
+    dr, dc = rect["direction"]
+    drow = pr - mr
+    dcol = pc - mc
+    if drow == 0 or dcol == 0:
+        return False
+    if drow * dr <= 0 or dcol * dc <= 0:
+        return False
+    return drow == dcol if dr == dc else drow == -dcol
