+    c1 = c0 + w - 1
+    missing = _missing_cell_from_bbox(r0, c0, h, w, corner)
+    direction = _corner_direction(corner)
+    return {
+        "color": int(color),
+        "bbox": (int(r0), int(c0), int(r1), int(c1)),
+        "h": int(h),
+        "w": int(w),
+        "corner": corner,
+        "missing": missing,
+        "direction": direction,
+        "cells": _shape_cells(r0, c0, h, w, corner),
