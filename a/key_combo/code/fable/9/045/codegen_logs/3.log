  grid: 16x16, black background
  colors: all 9 non-black colors (1-9) present
  target_rectangle:
    color: any one of the 9 colors
    dimensions: 2-4 rows x 3-7 cols, area 9-14
    solid monochrome, positioned anywhere with >=2 margin from edges [observed]
    must be the unique largest solid >=2x2 rectangle in the grid
  target_extra_pixels:
    count: 7-13 same-color isolated pixels scattered outside the rectangle
    no two adjacent (4-connected) to each other
