+
+def _shape_cells(
+    r0: int, c0: int, h: int, w: int, corner: tuple[int, int]
+) -> list[tuple[int, int]]:
+    missing = _missing_cell_from_bbox(r0, c0, h, w, corner)
+    return [
+        (r, c)
+        for r in range(r0, r0 + h)
+        for c in range(c0, c0 + w)
