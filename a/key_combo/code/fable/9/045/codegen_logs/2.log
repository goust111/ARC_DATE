+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            q = deque([(r, c)])
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for dr, dc in deltas:
+                    nr, nc = rr + dr, cc + dc
