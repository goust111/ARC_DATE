+import numpy as np
+
+
+BG = 0
+GREY = 5
+MARKER_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+
+GRID_H_RANGE = (11, 18)
+GRID_W_RANGE = (11, 18)
