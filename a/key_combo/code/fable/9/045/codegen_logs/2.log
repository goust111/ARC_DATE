+    for _ in range(LOCAL_MASK_ATTEMPTS):
+        count = random.randint(min_fill, max_fill)
+        chosen = set(random.sample(cells, count))
+        mask = np.zeros((depth, span), dtype=bool)
+        for cell in chosen:
+            mask[cell] = True
