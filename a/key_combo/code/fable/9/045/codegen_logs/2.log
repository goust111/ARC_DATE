+) -> tuple[dict[int, tuple[int, int]], list[tuple[int, int]]] | None:
+    mirror_union = set().union(*mirrors)
+    all_safe = [
+        (r, c)
+        for r in range(row_low, row_high + 1)
+        for c in range(col_low, col_high + 1)
+        if (r, c) not in mirror_union
+    ]
