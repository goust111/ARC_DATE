+        if not np.all(mask.any(axis=0)) or not np.all(mask.any(axis=1)):
+            continue
+
+        comps = _components_from_mask(mask, connectivity=4)
+        if not (OBJECT_COUNT_RANGE[0] <= len(comps) <= OBJECT_COUNT_RANGE[1]):
