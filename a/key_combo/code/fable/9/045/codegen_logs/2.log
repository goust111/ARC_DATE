+def _components_well_separated(comps: list[list[tuple[int, int]]]) -> bool:
+    for i in range(len(comps)):
+        for j in range(i + 1, len(comps)):
+            for r1, c1 in comps[i]:
+                for r2, c2 in comps[j]:
+                    if max(abs(r1 - r2), abs(c1 - c2)) <= 1:
+                        return False
+    return True
