+def _find_hidden_axis(grid: np.ndarray, bg: int) -> tuple[str, int, tuple[int, int, int, int]]:
+    box = _bbox(grid != bg)
+    assert box is not None, "expected non-background foreground"
+    r0, c0, r1, c1 = box
+    sub = grid[r0 : r1 + 1, c0 : c1 + 1]
+
