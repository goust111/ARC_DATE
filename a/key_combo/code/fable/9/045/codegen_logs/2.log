+
+def _comp_bbox(comp: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _c in comp]
+    cols = [c for _r, c in comp]
+    return min(rows), min(cols), max(rows), max(cols)
