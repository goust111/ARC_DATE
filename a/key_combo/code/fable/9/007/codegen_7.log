+    return {
+        "outer_bbox": (r0, c0, r1, c1),
+        "inner_bbox": (r0 + 1, c0 + 1, r1 - 1, c1 - 1),
+        "frame_color": frame_color,
+        "inner_color": inner_color,
+    }
+
+
+def _lock_cycle(strip_cycle: tuple[int, ...], inner_color: int, frame_color: int) -> tuple[int, ...]:
