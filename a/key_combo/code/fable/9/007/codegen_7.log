+    """
+    info = _analyze(np.asarray(grid, dtype=int))
+    return _render_rings(grid, info["structure"]["inner_bbox"], info["locked_cycle"], info["bg"])
+
+
+# --------------- generator ---------------
+
+BG_COLOR = 0
+GRID_MIN = 14
+GRID_MAX = 30
+PERIOD_MIN = 3
+PERIOD_MAX = 6
+INNER_H_MIN = 1
+INNER_H_MAX = 4
+INNER_W_MIN = 1
+INNER_W_MAX = 5
