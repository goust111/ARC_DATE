+    border = np.zeros_like(sub, dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+    inner = ~border
+
+    border_colors = set(map(int, sub[border]))
+    inner_colors = set(map(int, sub[inner]))
+    if len(border_colors) != 1 or len(inner_colors) != 1:
