+def _gen_attempt() -> np.ndarray | None:
+    bg = random.choice(PALETTE)
+    layer_count = random.choice(LAYER_COUNT_OPTIONS)
+    colors = random.sample([color for color in PALETTE if color != bg], layer_count)
