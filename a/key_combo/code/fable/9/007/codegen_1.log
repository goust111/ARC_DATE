+    indegree = {color: 0 for color in colors}
+    for src in colors:
+        for dst in graph[src]:
+            indegree[dst] += 1
+    if [color for color in colors if not graph[color]] != [colors[-1]]:
+        return False
+    for idx, color in enumerate(colors):
