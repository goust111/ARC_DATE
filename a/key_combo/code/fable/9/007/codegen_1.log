+    mask = np.zeros((height, width), dtype=bool)
+    anchors = {
+        (0, random.randrange(width)),
+        (height - 1, random.randrange(width)),
+        (random.randrange(height), 0),
+        (random.randrange(height), width - 1),
+    }
