+    for _ in range(120):
+        shifts = [(0, 0)]
+        used = {(0, 0)}
+        ok = True
+        for _layer in range(1, layer_count):
+            prev_r, prev_c = shifts[-1]
+            candidates = []
+            for dr, dc in step_pool:
+                nr, nc = prev_r + dr, prev_c + dc
+                if max(abs(nr), abs(nc)) > SHIFT_LIMIT:
+                    continue
+                if (nr, nc) in used:
