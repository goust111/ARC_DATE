+def _bbox_overlap(a: tuple[int, int], b: tuple[int, int], height: int, width: int) -> bool:
+    ar0, ac0 = a
+    br0, bc0 = b
+    return max(ar0, br0) < min(ar0 + height, br0 + height) and max(ac0, bc0) < min(ac0 + width, bc0 + width)
