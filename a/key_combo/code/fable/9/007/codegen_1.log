+def _is_connected(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return False
+    seen = {tuple(map(int, coords[0]))}
+    queue = deque(seen)
+    h, w = mask.shape
+    while queue:
+        r, c = queue.popleft()
+        for dr, dc in DIR4:
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                queue.append((nr, nc))
