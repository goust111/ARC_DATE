+def _place_offsets(
+    template: np.ndarray,
+    layer_count: int,
+) -> tuple[tuple[int, int], list[tuple[int, int]], tuple[int, int]] | None:
+    height, width = template.shape
+    shifts = _sample_shifts(layer_count)
+    if shifts is None:
+        return None
+
+    min_dr = min(dr for dr, _dc in shifts)
