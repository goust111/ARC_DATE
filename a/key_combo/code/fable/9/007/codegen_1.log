+def _sample_shifts(layer_count: int) -> list[tuple[int, int]] | None:
+    step_pool = [
+        (-2, -1), (-2, 0), (-2, 1),
+        (-1, -2), (-1, -1), (-1, 0), (-1, 1), (-1, 2),
+        (0, -2), (0, -1), (0, 1), (0, 2),
+        (1, -2), (1, -1), (1, 0), (1, 1), (1, 2),
+        (2, -1), (2, 0), (2, 1),
