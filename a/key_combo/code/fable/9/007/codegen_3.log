+    height: int,
+    width: int,
+    original: list[tuple[int, int]],
+    seed: tuple[int, int],
+    line_color: int,
+    seed_color: int,
+) -> np.ndarray:
+    grid = np.full((height, width), BG, dtype=int)
+    for r, c in original:
+        grid[r, c] = line_color
+    grid[seed] = seed_color
