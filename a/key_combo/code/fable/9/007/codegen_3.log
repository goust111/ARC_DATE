+    if len(info["turns"]) < 3:
+        return None
+    if _congruent_under_d4(info["line_cells"], info["replay_cells"]):
+        return None
+    if np.array_equal(grid, expected):
+        return None
+
+    actual = main(grid)
+    if not np.array_equal(actual, expected):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
