+DIR_INDEX = {d: i for i, d in enumerate(DIRS_CLOCKWISE)}
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+SIDES = ("left", "top", "right", "bottom")
+COLORS = tuple(range(1, 10))
+BG = 0
+GEN_RETRIES = 400
