+def _trace_polyline(line_cells: set[tuple[int, int]], shape: tuple[int, int]) -> list[tuple[int, int]]:
+    h, w = shape
+    endpoints = []
+    for r, c in line_cells:
+        deg = sum((nr, nc) in line_cells for nr, nc in _neighbors4(r, c))
