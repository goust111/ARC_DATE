+def _extract_program(path: list[tuple[int, int]]) -> tuple[tuple[int, int], list[str], list[int]]:
+    assert len(path) >= 2
+    init_dir = (path[1][0] - path[0][0], path[1][1] - path[0][1])
+    assert init_dir in DIR_INDEX
