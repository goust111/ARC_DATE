+def _transform_side(side: str, points: list[tuple[int, int]]) -> list[tuple[int, int]]:
+    out = []
+    for r, c in points:
+        if side == "left":
+            out.append((r, c))
+        elif side == "top":
+            out.append((c, -r))
+        elif side == "right":
+            out.append((-r, -c))
+        elif side == "bottom":
