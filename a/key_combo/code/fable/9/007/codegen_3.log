+    for a, b in zip(path, path[1:]):
+        step = (b[0] - a[0], b[1] - a[1])
+        assert step in DIR_INDEX
+        if step == current_dir:
+            run_len += 1
+            continue
+        lengths.append(run_len)
+        turns.append(_turn_symbol(current_dir, step))
+        current_dir = step
+        run_len = 1
+    lengths.append(run_len)
