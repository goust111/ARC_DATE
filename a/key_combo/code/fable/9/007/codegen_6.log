def _stamp_solid(out: np.ndarray, patch: np.ndarray, r: int, c: int, bg: int) -> None:
    H, W = out.shape
    h, w = patch.shape
    rr0 = max(0, int(r))
    cc0 = max(0, int(c))
    rr1 = min(H, int(r) + h)
    cc1 = min(W, int(c) + w)
