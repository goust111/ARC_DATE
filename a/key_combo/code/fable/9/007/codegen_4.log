+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            cid = len(comps)
+            while q:
+                rr, cc = q.popleft()
+                labels[rr, cc] = cid
+                coords.append((rr, cc))
+                for dr, dc in DIRS4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps, labels
