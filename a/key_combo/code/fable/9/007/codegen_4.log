+            assert cid >= 0, "ray must enter a chamber"
+            rr, cc = nr, nc
+            while 0 <= rr < h and 0 <= cc < w and int(g[rr, cc]) != wall:
+                assert int(chamber_id[rr, cc]) == cid, "a ray should stay within one chamber"
+                rr += dr
+                cc += dc
