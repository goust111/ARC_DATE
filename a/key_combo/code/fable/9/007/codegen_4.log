+    on_bottom = r == h - 1
+    on_left = c == 0
+    on_right = c == w - 1
+    assert on_top or on_bottom or on_left or on_right, "marker must be on the outer ring"
+    assert (on_top + on_bottom + on_left + on_right) == 1, "corner markers are ambiguous"
