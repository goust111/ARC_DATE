+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if color not in marker_colors:
+                continue
+            if not (r == 0 or r == h - 1 or c == 0 or c == w - 1):
+                continue
+            dr, dc = _marker_direction(h, w, r, c)
+            nr, nc = r + dr, c + dc
+            assert 0 <= nr < h and 0 <= nc < w
+            if int(g[nr, nc]) == wall:
+                blocked[(r, c)] = True
