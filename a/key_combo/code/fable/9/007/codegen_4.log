+
+    info = {
+        "planned": planned,
+        "markers": markers,
+        "top_id": top_id,
+        "bottom_id": bottom_id,
+        "left_id": left_id,
+        "right_id": right_id,
+        "interior_ids": sorted(set(range(int(labels.max()) + 1)) - {top_id, bottom_id, left_id, right_id}),
+        "top_fill": top_fill,
