+
+def _components(mask: np.ndarray) -> tuple[list[np.ndarray], np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    labels = np.full((h, w), -1, dtype=int)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
