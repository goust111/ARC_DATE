  "dst": "the other red endpoint d",
  "path": "unique shortest 4-neighbor route from s to d through background cells, treating blue cells as blockers",
  "trajectory": "paint each background pixel on the route yellow",
  "transform": "preserve the red endpoints, blue blockers, and off-path background"
}
</annotation>
<generation_spec>
