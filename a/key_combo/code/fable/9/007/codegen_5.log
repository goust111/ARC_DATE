+def _bfs_counts(
+    panel: np.ndarray, start: tuple[int, int]
+) -> tuple[dict[tuple[int, int], int], dict[tuple[int, int], int]]:
+    height, width = map(int, panel.shape)
+    dist = {start: 0}
+    count = {start: 1}
+    queue: deque[tuple[int, int]] = deque([start])
+
+    while queue:
+        r, c = queue.popleft()
+        for dr, dc in DIRS4:
+            nr, nc = r + dr, c + dc
+            if not (0 <= nr < height and 0 <= nc < width):
+                continue
+            if int(panel[nr, nc]) == BLUE:
+                continue
+            nxt = (nr, nc)
+            if nxt not in dist:
+                dist[nxt] = dist[(r, c)] + 1
+                count[nxt] = count[(r, c)]
+                queue.append(nxt)
+            elif dist[nxt] == dist[(r, c)] + 1:
+                count[nxt] = min(2, count[nxt] + count[(r, c)])
+
+    return dist, count
+
+
+def _solve_panel(
+    panel: np.ndarray,
+) -> tuple[
+    tuple[int, int],
+    tuple[int, int],
+    list[tuple[int, int]],
+    dict[tuple[int, int], int],
+    dict[tuple[int, int], int],
+]:
