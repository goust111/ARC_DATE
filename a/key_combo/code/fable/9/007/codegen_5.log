+            for nr, nc in ((cur[0] + dr, cur[1] + dc) for dr, dc in DIRS4)
+            if (nr, nc) in dist_start and dist_start[(nr, nc)] == dist_start[cur] - 1
+        ]
+        assert len(predecessors) == 1, "unique path reconstruction failed"
+        cur = predecessors[0]
+        if cur != start:
+            path.append(cur)
