+def _paste(dst: np.ndarray, patch: np.ndarray, r0: int, c0: int, transparent: int = BLACK) -> None:
+    h, w = patch.shape
+    rr0 = max(0, r0)
+    cc0 = max(0, c0)
+    rr1 = min(dst.shape[0], r0 + h)
+    cc1 = min(dst.shape[1], c0 + w)
