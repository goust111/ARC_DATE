+    out = g.copy()
+    out[bbox[0] : bbox[2] + 1, bbox[1] : bbox[3] + 1] = BLACK
+    out[line_mask] = GRAY
+
+    for i in range(1, len(path) - 1):
+        prev_pt = path[i - 1]
+        bend = path[i]
+        next_pt = path[i + 1]
+        incoming = (bend[0] - prev_pt[0], bend[1] - prev_pt[1])
+        outgoing = (next_pt[0] - bend[0], next_pt[1] - bend[1])
+        turn = _turn_sign(incoming, outgoing)
+        if turn == "straight":
+            continue
