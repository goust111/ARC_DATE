+        seg = _segment_cells(vertices[i - 1], vertices[i])
+        path.extend(seg[1:])
+    return path
+
+
+def _polyline_grid(shape: tuple[int, int], path: list[tuple[int, int]]) -> np.ndarray:
+    g = np.full(shape, BLACK, dtype=int)
+    for r, c in path:
+        g[r, c] = GRAY
