+def _template_has_full_bbox(mask: np.ndarray) -> bool:
+    return bool(mask[0, :].any() and mask[-1, :].any() and mask[:, 0].any() and mask[:, -1].any())
+
+
+def _template_asymmetry_ok(mask: np.ndarray) -> bool:
