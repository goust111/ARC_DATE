+    return out
+
+
+def _validate_generated(inp: np.ndarray, path: list[tuple[int, int]], template: np.ndarray, template_bbox: tuple[int, int, int, int]) -> None:
+    assert inp.ndim == 2 and max(inp.shape) <= 30
