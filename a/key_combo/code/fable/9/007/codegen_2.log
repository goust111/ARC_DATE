+    max_len: int,
+    safe_margin: int,
+    is_bend_end: bool,
+    occupied: set[tuple[int, int]],
+) -> list[tuple[int, tuple[int, int]]]:
+    h, w = shape
+    candidates = []
+    for length in range(min_len, max_len + 1):
+        end = (cur[0] + direction[0] * length, cur[1] + direction[1] * length)
