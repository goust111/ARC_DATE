+    ) -> list[tuple[int, int]] | None:
+        is_bend_end = seg_index < num_segments - 1
+        lengths = _candidate_lengths(
+            shape,
+            cur,
+            cur_dir,
+            min_seg if seg_index > 0 else safe_margin + 1,
+            max_seg,
+            safe_margin,
+            is_bend_end,
+            occupied,
