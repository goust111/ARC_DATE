+        else:
+            return None
+    cropped = _crop_mask(canvas)
+    if int(cropped.sum()) < 3:
+        return None
+    if len(_components(cropped, connectivity=8)) < 2:
+        return None
+    for bad in forbidden:
+        if cropped.shape == bad.shape and np.array_equal(cropped, bad):
+            return None
