+    return mask[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _crop_array(arr: np.ndarray, mask: np.ndarray) -> np.ndarray:
+    box = _bbox(mask)
+    assert box is not None, "expected a non-empty mask"
+    r0, c0, r1, c1 = box
+    return arr[r0 : r1 + 1, c0 : c1 + 1].copy()
