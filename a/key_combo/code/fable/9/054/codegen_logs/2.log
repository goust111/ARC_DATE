+    mirror_coords = _reflect_set(missing_coords, center)
+    if missing_coords & mirror_coords:
+        return None
+
+    full = np.zeros((sprite_h, sprite_w), dtype=bool)
+    cr, cc = center
+    core = {(cr, cc), (cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)}
+    for r, c in core:
+        if not (0 <= r < sprite_h and 0 <= c < sprite_w):
+            return None
+        full[r, c] = True
