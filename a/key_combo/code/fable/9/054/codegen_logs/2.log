+        if not separated:
+            continue
+        region = grid[r0 : r0 + ph, c0 : c0 + pw]
+        if np.any(region[pattern] != 0):
+            continue
+        region[pattern] = color
+        used_boxes.append(box)
+        return r0, c0
+    return None
