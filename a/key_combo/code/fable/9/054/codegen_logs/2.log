+
+
+def _path_cells(start: tuple[int, int], end: tuple[int, int], row_first: bool) -> list[tuple[int, int]]:
+    r, c = start
+    er, ec = end
+    path = [(r, c)]
+    if row_first:
+        while r != er:
+            r += _sign(er - r)
+            path.append((r, c))
+        while c != ec:
+            c += _sign(ec - c)
+            path.append((r, c))
+    else:
+        while c != ec:
+            c += _sign(ec - c)
+            path.append((r, c))
+        while r != er:
