+def _neighbors(r: int, c: int, shape: tuple[int, int], connectivity: int) -> list[tuple[int, int]]:
+    h, w = shape
+    out: list[tuple[int, int]] = []
+    deltas = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+    if connectivity == 8:
+        deltas += [(-1, -1), (-1, 1), (1, -1), (1, 1)]
+    for dr, dc in deltas:
+        rr, cc = r + dr, c + dc
+        if 0 <= rr < h and 0 <= cc < w:
+            out.append((rr, cc))
+    return out
+
+
+def _components(mask: np.ndarray, connectivity: int = 8) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    parts: list[list[tuple[int, int]]] = []
+    for r, c in np.argwhere(mask):
+        rr = int(r)
+        cc = int(c)
+        if seen[rr, cc]:
+            continue
+        stack = [(rr, cc)]
+        seen[rr, cc] = True
+        comp: list[tuple[int, int]] = []
+        while stack:
+            cr, cc = stack.pop()
+            comp.append((cr, cc))
+            for nr, nc in _neighbors(cr, cc, mask.shape, connectivity):
+                if mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    stack.append((nr, nc))
+        parts.append(comp)
+    return parts
