+def _gen_attempt() -> np.ndarray | None:
+    panel_h = random.randint(6, 9)
+    panel_w = random.randint(6, 9)
+    bg, divider = random.sample(PALETTE, 2)
+
+    n_cells = random.randint(3, min(6, panel_h * panel_w))
