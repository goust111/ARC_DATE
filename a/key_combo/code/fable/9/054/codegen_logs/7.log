+    row_spans = [
+        (0, row_divs[0]),
+        (row_divs[0] + 1, row_divs[1]),
+        (row_divs[1] + 1, g.shape[0]),
+    ]
+    col_spans = [
+        (0, col_divs[0]),
+        (col_divs[0] + 1, col_divs[1]),
+        (col_divs[1] + 1, g.shape[1]),
+    ]
