    possible_widths = [w for w in range(SPRITE_W[0], SPRITE_W[1] + 1) if count * w <= cols]
    if not possible_widths:
        return None
    sprite_h = _gen_randint(SPRITE_H)
    sprite_w = int(np.random.choice(possible_widths))
    return sprite_h, sprite_w

