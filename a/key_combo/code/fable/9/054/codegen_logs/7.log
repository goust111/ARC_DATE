+    row_anchor = (-sr, panel_h - 1 - sr)
+    col_anchor = (-sc, panel_w - 1 - sc)
+    candidates = []
+    for dr in range(row_anchor[0], row_anchor[1] + 1):
+        for dc in range(col_anchor[0], col_anchor[1] + 1):
