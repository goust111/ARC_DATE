+    center_c0 = panel_w + 1
+    for color, (r, c) in sprite_map.items():
+        grid[center_r0 + r, center_c0 + c] = int(color)
+
+    for pr, pc, color, (ar, ac) in anchors:
+        r0, c0 = _panel_origin(panel_h, panel_w, pr, pc)
+        grid[r0 + ar, c0 + ac] = int(color)
+    return grid
+
+
+def _expected_from_spec(
+    panel_h: int,
+    panel_w: int,
+    bg: int,
+    divider: int,
