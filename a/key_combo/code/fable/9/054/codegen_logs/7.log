+        for pc in range(3):
+            if pr == 1 and pc == 1:
+                continue
+            r0, r1, c0, c1 = _panel_bounds(row_spans, col_spans, pr, pc)
+            panel = g[r0:r1, c0:c1]
+            coords = np.argwhere(panel != bg)
+            if coords.size == 0:
+                continue
+            assert coords.shape[0] == 1, "each outer panel must be empty or contain one anchor pixel"
