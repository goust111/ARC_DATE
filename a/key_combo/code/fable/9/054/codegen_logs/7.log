+            _stamp_panel(expected_panel, sprite_map, (0, 0), panel_in.shape, (ar, ac), color)
+            anchor_patterns.add(tuple(expected_panel.ravel().tolist()))
+            if not np.array_equal(panel_out, expected_panel):
