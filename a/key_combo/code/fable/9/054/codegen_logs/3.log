+
+    marker_color = random.choice(MARKER_COLORS)
+    patch_specs = [(in_a, anchor_a), (in_b, anchor_b)]
+
+    min_h = max(p.shape[0] for p, _ in patch_specs) + 8
+    min_w = max(p.shape[1] for p, _ in patch_specs) + 8
