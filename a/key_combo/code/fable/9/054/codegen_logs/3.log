+
+CORNER_TO_ROT = {"TL": 0, "TR": 1, "BR": 2, "BL": 3}
+OPPOSITE_CORNER = {"TL": "BR", "TR": "BL", "BR": "TL", "BL": "TR"}
+MISSING_TO_RECT_DELTA = {
+    "TL": (-1, -1),
+    "TR": (-1, 1),
+    "BL": (1, -1),
