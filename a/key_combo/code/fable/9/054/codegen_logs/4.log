+    model = models[0]
+    if model["center"] != center or model["radius"] != radius or model["period"] != period:
+        return None
+    if model["sequence"] != sequence:
+        return None
+
+    if not np.array_equal(main(inp), hidden):
+        return None
+
+    return inp
