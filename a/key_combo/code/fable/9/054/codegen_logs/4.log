+        r
+        for r in range(5, min((h - 3) // 2, (w - 3) // 2) + 1)
+        if (2 * r + 1) ** 2 <= int(0.45 * h * w)
+    ]
+    if not feasible_radii:
+        return None
+    radius = int(np.random.choice(feasible_radii))
+    center = (
+        int(np.random.randint(radius + 1, h - radius - 1)),
