+    rr = np.arange(h)[:, None]
+    cc = np.arange(w)[None, :]
+    dist = np.maximum(np.abs(rr - center[0]), np.abs(cc - center[1]))
+    out = np.full((h, w), int(bg), dtype=int)
+    palette = np.asarray(sequence, dtype=int)
+    inside = dist <= int(radius)
+    out[inside] = palette[dist[inside] % len(sequence)]
+    return out
+
