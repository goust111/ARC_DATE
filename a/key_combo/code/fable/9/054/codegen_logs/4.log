+    r0, c0, r1, c1 = rect
+    residues: set[int] = set()
+    for r in range(h):
+        for c in range(w):
+            if r0 <= r <= r1 and c0 <= c <= c1:
+                continue
+            dist = max(abs(r - center[0]), abs(c - center[1]))
+            if dist <= radius:
+                residues.add(int(dist % period))
