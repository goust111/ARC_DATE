+def _enumerate_models(grid: np.ndarray) -> tuple[tuple[int, int, int, int], int, int, list[dict]]:
+    g = np.asarray(grid, dtype=int)
+    rect, occ_color = _find_occluder_rect(g)
+    r0, c0, r1, c1 = rect
