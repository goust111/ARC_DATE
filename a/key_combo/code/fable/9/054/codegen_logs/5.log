+
+PALETTE = list(range(1, 10))
+DIR_STEP = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+OPPOSITE = {"up": "down", "down": "up", "left": "right", "right": "left"}
+GEN_ATTEMPTS = 400
