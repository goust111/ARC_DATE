+
+
+def _make_rect(
+    name: str,
+    role: str,
+    mode: str,
+    top: int,
+    left: int,
+    h: int,
+    w: int,
+    direction: str,
+    target_name: str | None,
+    false_front_name: str | None = None,
+) -> dict:
+    axis_len = w if direction in {"left", "right"} else h
+    return {
+        "name": name,
