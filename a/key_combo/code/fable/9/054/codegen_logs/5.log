+                "r0": r0,
+                "c0": c0,
+                "r1": r1,
+                "c1": c1,
+                "h": h,
+                "w": w,
+                "body": body,
+                "marker_color": marker_color,
+                "marker_r": marker_r,
+                "marker_c": marker_c,
+                "direction": direction,
+                "marker_offset": int(marker_offset),
