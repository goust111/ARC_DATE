+            mover_left,
+            mover_h,
+            mover_w,
+            "left",
+            anchor_name,
+            false_name,
+        )
+        rects.extend([anchor, mover])
+        patch_w = mover_left + mover_w
+        if include_decoy:
+            decoy_left = random.randint(anchor_w + 1, mover_left - decoy_w - 1)
+            decoy_top = main_band_h + 1
