+    bg = _background_color(g)
+    rects: list[dict] = []
+    for comp in _components(g != bg):
+        rows = [r for r, _ in comp]
+        cols = [c for _, c in comp]
+        r0, r1 = min(rows), max(rows)
+        c0, c1 = min(cols), max(cols)
+        patch = g[r0 : r1 + 1, c0 : c1 + 1]
+        if np.any(patch == bg):
