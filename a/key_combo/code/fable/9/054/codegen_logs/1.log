0067: def generate_input() -> np.ndarray:
0068:     
0069:     # make a 10x10 black grid first as background
0070:     n, m = 10, 10
0071:     grid = np.zeros((m, n), dtype=int)
0072: 
0073:     # randomly select a unique color from Color.NOT_BLACK
0074:     unique_color = random.choice(Color.NOT_BLACK)
0075: 
0076:     # randomly choose a non-border cell for the unique color
0077:     non_border_cells = [ (i, j) for i in range(1, m-1) for j in range(1, n-1) ]
0078:     unique_cell = random.choice(non_border_cells)
0079:     grid[unique_cell] = unique_color
0080: 
0081:     # remove the unique color from the list
0082:     remaining_colors = [ color for color in Color.NOT_BLACK if color != unique_color ]
0083: 
0084:     for remaining_color in remaining_colors:
0085:         # Pick a random frequency but make sure that this colour is not unique (does not have frequency 1)
0086:         frequency_of_this_color = random.choice([0, 2, 3, 4, 5, 6])
0087: 
0088:         for _ in range(frequency_of_this_color):
0089:             # randomly choose an unoccupied cell for the remaining color
0090:             empty_cells = [ (i, j) for i in range(m) for j in range(n) if grid[i][j] == Color.BLACK ]
0091:             r, c = random.choice(empty_cells)
0092:             grid[r, c] = remaining_color
0093:     
0094:     return grid
0095:   
