0001: import numpy as np
0002: 
0003: import random
0004: from arc_utils import Color, draw_line
0005: 
0006: # concepts:
0007: # bitmasks with separator, boolean logical operations
0008: 
0009: # description:
0010: # Compute the XOR operation of where the two grids are red, turning the output green in those locations.
0011: # In the input, you should see two 6x5 red patterns on top and bottom separated a horizontal yellow line in the middle of the grid.
0012: # To make the output, you have to overlap the two patterns. If the overlapping cells are the same color, then the corresponding cell is colored black; otherwise, 
0013: # if the overlapping cells are not the same color, then the corresponding cell is colored green
0014: 
0015: def main(input_grid):
0016:     """
0017:     Compute the XOR of the red patterns above and below the yellow separator row.
0018: 
0019:     Input structure:
0020:     - A full yellow horizontal row separates two equal-sized red and black masks.
0021:     - The top and bottom masks have the same width and height.
0022:     - Red and black encode active and inactive mask cells.
0023: 
0024:     Rule:
0025:     - Locate the yellow separator row.
0026:     - Split the input into top and bottom masks.
0027:     - Output green where the two masks differ and black where they match.
0028: 
0029:     Key insight:
0030:     - The separator only aligns the two masks; the output is their pixelwise exclusive-or.
0031:     """
0032: 
0033:     H, W = input_grid.shape
0034: 
0035:     # Find the yellow horizontal line/bar (a full row of YELLOW).
0036:     c_bar = None
0037:     for r in range(H):
0038:         if np.all(input_grid[r, :] == Color.YELLOW):
0039:             c_bar = r
0040:             break
0041:     assert c_bar is not None
0042:     
0043:     # Extract top and bottom patterns.
0044:     top_pattern = input_grid[:c_bar, :]
0045:     bottom_pattern = input_grid[c_bar + 1 :, :] 
0046: 
0047:     output_grid = np.zeros_like(top_pattern)
0048: 
0049:     # applying the XOR pattern, which is where they are different
0050:     output_grid[(top_pattern != bottom_pattern)] = Color.GREEN
0051:     output_grid[(top_pattern == bottom_pattern)] = Color.BLACK
0052: 
0053:     return output_grid
0054: 
0055: 
0056: def generate_input():
0057:   
0058:     # Define the grid size
0059:     width = 5
0060:     height = 13  # 6 top + 1 yellow line + 6 bottom
0061: 
0062:     # Initialize an empty grid
0063:     input_grid = np.full((height, width), Color.BLACK, dtype=int)
0064: 
0065:     # Randomly assign red or black to the top and bottom patterns
0066:     for r in range(height):
0067:         for c in range(width):
0068:             input_grid[r, c] = int(np.random.choice([Color.BLACK, Color.RED]))
0069: 
0070:     # Set the yellow horizontal separator row
0071:     input_grid[height // 2, :] = Color.YELLOW
0072: 
0073:     return input_grid
