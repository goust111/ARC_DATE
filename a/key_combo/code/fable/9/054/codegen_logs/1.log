0001: import numpy as np
0002: 
0003: from arc_utils import find_components, get_bg, paste
0004: import random
0005: 
0006: 
0007: def main(grid: np.ndarray) -> np.ndarray:
0008:     """
0009:     Cycle each solid odd-sided square to the next smaller centered square, wrapping a single pixel to a 9x9 square.
0010: 
0011:     Input structure:
0012:     - The grid has one dominant background color.
0013:     - Every foreground object is a separated 4-connected monochrome solid square.
0014:     - Square side lengths are odd and belong to the cycle 1, 3, 5, 7, 9.
0015: 
0016:     Rule:
0017:     - Clear the canvas to the background.
0018:     - Keep each square's color and center.
0019:     - Replace side length n by n - 2 when n > 1; replace side length 1 by side length 9.
0020: 
0021:     Key insight:
0022:     - The visible operation is on square size, not color: side lengths cycle 1 -> 9 -> 7 -> 5 -> 3 -> 1.
0023:     """
0024:     g = np.asarray(grid, dtype=int)
0025:     bg = get_bg(g)
0026:     components = find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict")
0027:     assert components, "expected at least one foreground square"
0028: 
0029:     out = np.full_like(g, bg)
0030:     painted = np.zeros(g.shape, dtype=bool)
0031:     H, W = g.shape
0032: 
0033:     for obj in components:
0034:         color = int(obj["color"])
0035:         r0, c0, r1, c1 = obj["bbox"]
0036:         side = int(r1 - r0 + 1)
0037:         assert side == int(c1 - c0 + 1), "foreground object must have a square bbox"
0038:         assert side in {1, 3, 5, 7, 9}, "square side length must be in the odd-size cycle"
0039:         assert int(obj["area"]) == side * side, "foreground object must fill its bbox"
0040:         assert np.all(g[r0 : r1 + 1, c0 : c1 + 1] == color), "foreground object must be solid"
0041: 
0042:         new_side = 9 if side == 1 else side - 2
0043:         center_r = int((r0 + r1) // 2)
0044:         center_c = int((c0 + c1) // 2)
0045:         nr0 = center_r - new_side // 2
0046:         nc0 = center_c - new_side // 2
0047:         nr1 = nr0 + new_side
0048:         nc1 = nc0 + new_side
0049:         assert 0 <= nr0 < nr1 <= H and 0 <= nc0 < nc1 <= W, "transformed square must fit in the grid"
0050: 
0051:         region = (slice(nr0, nr1), slice(nc0, nc1))
0052:         assert not painted[region].any(), "transformed squares must not overlap"
0053:         out[region] = color
0054:         painted[region] = True
0055: 
0056:     return out
0057: 
0058: # --------------- generator (att2, o5x) ---------------
0059: 
0060: # Canvas and palette.
0061: GRID_SIZE = 16
0062: BACKGROUND_COLOR = 7
0063: FOREGROUND_COLORS = [0, 1, 2, 3, 4, 5, 6, 8, 9]
0064: INPUT_SIDE_FROM_OUTPUT = {1: 3, 3: 5, 5: 7, 7: 9, 9: 1}
0065: # Object and side sampling.
0066: SQUARE_COUNT_RANGE = (3, 5)
0067: BASE_OUTPUT_SIDE_CHOICES = [1, 3, 5]
0068: OUTPUT_SIDE_7_PROB = 0.45
0069: OUTPUT_SIDE_9_PROB = 0.35
0070: # Placement and retry policy.
0071: OUTPUT_CLEARANCE_GAP = 1
0072: INPUT_CLEARANCE_GAP = 0
0073: MAX_GENERATION_ATTEMPTS = 300
0074: 
0075: 
0076: def _bbox(center_r, center_c, side):
0077:     d = side // 2
0078:     return center_r - d, center_c - d, center_r + d, center_c + d
0079: 
