0015: def main(input_grid):
0016:     """
0017:     Draw red segments toward the gray divider and blue segments away from it.
0018: 
0019:     Input structure:
0020:     - The input is a black grid with one straight gray row or column.
0021:     - Red and blue pixels appear on both sides of the gray divider.
0022:     - The gray divider stops lines that are drawn toward it.
0023: 
0024:     Rule:
0025:     - Detect whether the gray divider is horizontal or vertical.
0026:     - Draw red lines from red pixels toward the divider.
0027:     - Draw blue lines from blue pixels away from the divider toward the edge.
0028: 
0029:     Key insight:
0030:     - The gray line is an axis of attraction for red and repulsion for blue.
0031:     """
0032:     # copy the input grid to the output grid
0033:     output_grid = np.copy(input_grid)
0034: 
0035:     # Find the grey line and determine whether it's horizontal (a row) or vertical (a column).
0036:     grey_coords = np.argwhere(output_grid == Color.GREY)
0037:     grey_rows = np.unique(grey_coords[:, 0])
0038:     grey_cols = np.unique(grey_coords[:, 1])
0039: 
0040:     red_coords = np.argwhere(output_grid == Color.RED)
0041:     blue_coords = np.argwhere(output_grid == Color.BLUE)
