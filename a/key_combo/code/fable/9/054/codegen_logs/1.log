0001: import numpy as np
0002: 
0003: from arc_utils import bbox
0004: import random
0005: 
0006: 
0007: def _visible_mirror_values(g: np.ndarray, marker: int, r: int, c: int) -> list[int]:
0008:     height, width = map(int, g.shape)
0009:     reflected = (
0010:         (r, width - 1 - c),
0011:         (height - 1 - r, c),
0012:         (height - 1 - r, width - 1 - c),
0013:     )
0014:     return [int(g[rr, cc]) for rr, cc in reflected if int(g[rr, cc]) != marker]
0015: 
0016: 
0017: def _has_consistent_mirror_fill(
0018:     g: np.ndarray, marker: int, rect: tuple[int, int, int, int]
0019: ) -> bool:
0020:     r0, c0, r1, c1 = rect
0021:     for r in range(r0, r1 + 1):
0022:         for c in range(c0, c1 + 1):
0023:             values = _visible_mirror_values(g, marker, r, c)
0024:             if not values or len(set(values)) != 1:
0025:                 return False
0026:     return True
0027: 
0028: 
0029: def _find_marker_rect(g: np.ndarray) -> tuple[int, tuple[int, int, int, int]]:
0030:     candidates: list[tuple[int, tuple[int, int, int, int]]] = []
0031:     for color in np.unique(g):
0032:         marker = int(color)
0033:         mask = g == marker
0034:         rect = bbox(mask)
0035:         assert rect is not None, "each present color must have a bbox"
0036:         r0, c0, r1, c1 = rect
0037:         area = int(mask.sum())
0038:         rect_area = int((r1 - r0 + 1) * (c1 - c0 + 1))
0039:         if area > 1 and area == rect_area and _has_consistent_mirror_fill(g, marker, rect):
0040:             candidates.append((marker, rect))
0041: 
0042:     assert len(candidates) == 1, "expected exactly one solid marker rectangle"
0043:     return candidates[0]
0044: 
0045: 
0046: def main(grid: np.ndarray) -> np.ndarray:
0047:     """
0048:     Return the values hidden under the solid marker rectangle by reflecting them from the bilaterally symmetric grid.
0049: 
0050:     Input structure
0051:     - The input scene has horizontal and vertical mirror symmetry except for one solid rectangular marker mask.
0052:     - The marker color appears only as that solid rectangle.
0053:     - The requested output has the same shape as the marker rectangle.
0054: 
0055:     Rule
0056:     - Identify the unique solid marker rectangle whose horizontal, vertical, and 180-degree mirror counterparts reveal consistent non-marker values.
0057:     - For each marker pixel, copy the unique visible value from its reflected counterparts into the corresponding output cell.
0058: 
0059:     Key insight
0060:     - The marker hides a rectangular patch of a bilaterally symmetric image; the missing value for each covered cell is visible at its mirror locations.
0061:     """
0062:     g = np.asarray(grid, dtype=int)
0063:     assert g.ndim == 2, "expected a 2D grid"
0064: 
0065:     marker, rect = _find_marker_rect(g)
0066:     r0, c0, r1, c1 = rect
0067:     out = np.empty((r1 - r0 + 1, c1 - c0 + 1), dtype=int)
0068: 
0069:     for r in range(r0, r1 + 1):
