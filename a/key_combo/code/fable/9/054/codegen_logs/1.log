0002: import numpy as np
0003: from typing import *
0004: import random
0005: from arc_utils import Color, draw_line
0006: 
0007: # concepts:
0008: # magnetism, lines
0009: 
0010: # description:
0011: # In the input, you will see a horizontal grey line on a black background, with red and blue pixels scattered on either side of the line.
0012: # To make the output, draw vertical lines from each of the blue and red pixels, with lines from the red pixels going toward the grey line and lines from the blue pixels going away from the grey line. 
0013: # These lines should stop when they hit the grey line or the edge of the grid.
0014: 
0015: def main(input_grid):
0016:     """
0017:     Draw red segments toward the gray divider and blue segments away from it.
0018: 
0019:     Input structure:
0020:     - The input is a black grid with one straight gray row or column.
0021:     - Red and blue pixels appear on both sides of the gray divider.
0022:     - The gray divider stops lines that are drawn toward it.
0023: 
0024:     Rule:
0025:     - Detect whether the gray divider is horizontal or vertical.
0026:     - Draw red lines from red pixels toward the divider.
0027:     - Draw blue lines from blue pixels away from the divider toward the edge.
0028: 
0029:     Key insight:
0030:     - The gray line is an axis of attraction for red and repulsion for blue.
0031:     """
0032:     # copy the input grid to the output grid
0033:     output_grid = np.copy(input_grid)
0034: 
0035:     # Find the grey line and determine whether it's horizontal (a row) or vertical (a column).
0036:     grey_coords = np.argwhere(output_grid == Color.GREY)
0037:     grey_rows = np.unique(grey_coords[:, 0])
0038:     grey_cols = np.unique(grey_coords[:, 1])
0039: 
0040:     red_coords = np.argwhere(output_grid == Color.RED)
0041:     blue_coords = np.argwhere(output_grid == Color.BLUE)
0042: 
0043:     if len(grey_rows) == 1:
0044:         # Horizontal line at row = grey_r
0045:         grey_r = int(grey_rows[0])
0046: 
0047:         # Red pixels: draw toward the line (down if above, up if below).
0048:         for r, c in red_coords:
0049:             r = int(r)
0050:             c = int(c)
0051:             dr = 1 if r < grey_r else -1
0052:             draw_line(output_grid, r, c, length=None, color=Color.RED, direction=(dr, 0), stop_at={Color.GREY})
0053: 
0054:         # Blue pixels: draw away from the line (up if above, down if below).
0055:         for r, c in blue_coords:
0056:             r = int(r)
0057:             c = int(c)
0058:             dr = -1 if r < grey_r else 1
0059:             draw_line(output_grid, r, c, length=None, color=Color.BLUE, direction=(dr, 0), stop_at={Color.GREY})
0060: 
0061:     elif len(grey_cols) == 1:
0062:         # Vertical line at col = grey_c
0063:         grey_c = int(grey_cols[0])
0064: 
0065:         # Red pixels: draw toward the line (right if left, left if right).
0066:         for r, c in red_coords:
0067:             r = int(r)
0068:             c = int(c)
0069:             dc = 1 if c < grey_c else -1
0070:             draw_line(output_grid, r, c, length=None, color=Color.RED, direction=(0, dc), stop_at={Color.GREY})
0071: 
0072:         # Blue pixels: draw away from the line (left if left, right if right).
0073:         for r, c in blue_coords:
0074:             r = int(r)
0075:             c = int(c)
0076:             dc = -1 if c < grey_c else 1
0077:             draw_line(output_grid, r, c, length=None, color=Color.BLUE, direction=(0, dc), stop_at={Color.GREY})
0078: 
0079:     else:
0080:         raise ValueError("Expected a single straight grey line (one row or one column).")
0081: 
0082:     return output_grid
