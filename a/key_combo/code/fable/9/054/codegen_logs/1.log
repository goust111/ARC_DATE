0001: import numpy as np
0002: 
0003: from arc_utils import find_components, get_bg, paste
0004: import random
0005: 
0006: 
0007: def main(grid: np.ndarray) -> np.ndarray:
0008:     """
0009:     Cycle each solid odd-sided square to the next smaller centered square, wrapping a single pixel to a 9x9 square.
0010: 
0011:     Input structure:
0012:     - The grid has one dominant background color.
0013:     - Every foreground object is a separated 4-connected monochrome solid square.
0014:     - Square side lengths are odd and belong to the cycle 1, 3, 5, 7, 9.
0015: 
0016:     Rule:
0017:     - Clear the canvas to the background.
0018:     - Keep each square's color and center.
0019:     - Replace side length n by n - 2 when n > 1; replace side length 1 by side length 9.
0020: 
0021:     Key insight:
0022:     - The visible operation is on square size, not color: side lengths cycle 1 -> 9 -> 7 -> 5 -> 3 -> 1.
0023:     """
0024:     g = np.asarray(grid, dtype=int)
0025:     bg = get_bg(g)
0026:     components = find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict")
0027:     assert components, "expected at least one foreground square"
0028: 
0029:     out = np.full_like(g, bg)
0030:     painted = np.zeros(g.shape, dtype=bool)
0031:     H, W = g.shape
0032: 
0033:     for obj in components:
0034:         color = int(obj["color"])
0035:         r0, c0, r1, c1 = obj["bbox"]
0036:         side = int(r1 - r0 + 1)
0037:         assert side == int(c1 - c0 + 1), "foreground object must have a square bbox"
0038:         assert side in {1, 3, 5, 7, 9}, "square side length must be in the odd-size cycle"
0039:         assert int(obj["area"]) == side * side, "foreground object must fill its bbox"
0040:         assert np.all(g[r0 : r1 + 1, c0 : c1 + 1] == color), "foreground object must be solid"
0041: 
0042:         new_side = 9 if side == 1 else side - 2
0043:         center_r = int((r0 + r1) // 2)
0044:         center_c = int((c0 + c1) // 2)
0045:         nr0 = center_r - new_side // 2
0046:         nc0 = center_c - new_side // 2
0047:         nr1 = nr0 + new_side
0048:         nc1 = nc0 + new_side
0049:         assert 0 <= nr0 < nr1 <= H and 0 <= nc0 < nc1 <= W, "transformed square must fit in the grid"
0050: 
0051:         region = (slice(nr0, nr1), slice(nc0, nc1))
0052:         assert not painted[region].any(), "transformed squares must not overlap"
0053:         out[region] = color
0054:         painted[region] = True
0055: 
0056:     return out
0057: 
0058: # --------------- generator (att2, o5x) ---------------
0059: 
0060: # Canvas and palette.
0061: GRID_SIZE = 16
0062: BACKGROUND_COLOR = 7
0063: FOREGROUND_COLORS = [0, 1, 2, 3, 4, 5, 6, 8, 9]
0064: INPUT_SIDE_FROM_OUTPUT = {1: 3, 3: 5, 5: 7, 7: 9, 9: 1}
0065: # Object and side sampling.
0066: SQUARE_COUNT_RANGE = (3, 5)
0067: BASE_OUTPUT_SIDE_CHOICES = [1, 3, 5]
0068: OUTPUT_SIDE_7_PROB = 0.45
0069: OUTPUT_SIDE_9_PROB = 0.35
0070: # Placement and retry policy.
0071: OUTPUT_CLEARANCE_GAP = 1
0072: INPUT_CLEARANCE_GAP = 0
0073: MAX_GENERATION_ATTEMPTS = 300
0074: 
0075: 
0076: def _bbox(center_r, center_c, side):
0077:     d = side // 2
0078:     return center_r - d, center_c - d, center_r + d, center_c + d
0079: 
0080: 
0081: def _separated(a, b, gap=0):
0082:     return (
0083:         a[2] + gap + 1 <= b[0]
0084:         or b[2] + gap + 1 <= a[0]
0085:         or a[3] + gap + 1 <= b[1]
0086:         or b[3] + gap + 1 <= a[1]
0087:     )
0088: 
0089: 
0090: def _clear(rect, rects, gap=0):
0091:     return all(_separated(rect, other, gap) for other in rects)
0092: 
0093: 
0094: def _draw_square(grid, color, box):
0095:     r0, c0, r1, c1 = box
0096:     shape = (r1 - r0 + 1, c1 - c0 + 1)
0097:     paste(grid, np.full(shape, int(color), dtype=int), r0, c0)
0098: 
0099: 
0100: def _choose_output_sides(count):
0101:     sides = [random.choice(BASE_OUTPUT_SIDE_CHOICES) for _ in range(count)]
0102:     slots = list(range(count))
0103:     random.shuffle(slots)
0104: 
0105:     if random.random() < OUTPUT_SIDE_7_PROB:
0106:         sides[slots.pop()] = 7
0107:     if slots and random.random() < OUTPUT_SIDE_9_PROB:
0108:         sides[slots.pop()] = 9
0109: 
0110:     random.shuffle(sides)
0111:     return sides
0112: 
0113: 
0114: def _sample_objects():
0115:     """Sample color and side specs, returning larger required footprints first."""
0116:     count = random.randint(*SQUARE_COUNT_RANGE)
0117:     colors = random.sample(FOREGROUND_COLORS, count)
0118:     out_sides = _choose_output_sides(count)
0119:     in_sides = [INPUT_SIDE_FROM_OUTPUT[s] for s in out_sides]
0120: 
0121:     # Keep the configured background as the solver's dominant color.
0122:     areas = [s * s for s in in_sides]
0123:     if GRID_SIZE * GRID_SIZE - sum(areas) <= max(areas):
0124:         return None
0125: 
0126:     objects = [
0127:         {"color": color, "out_side": out_side, "in_side": in_side}
0128:         for color, out_side, in_side in zip(colors, out_sides, in_sides)
0129:     ]
0130:     random.shuffle(objects)
0131:     objects.sort(key=lambda obj: (max(obj["out_side"], obj["in_side"]), obj["out_side"]), reverse=True)
0132:     return objects
0133: 
0134: 
0135: def _place_objects(objects):
0136:     """Place each object at a center valid for both input and output squares."""
0137:     placed = []
0138:     output_boxes = []
0139:     input_boxes = []
0140: 
0141:     for obj in objects:
0142:         out_side = obj["out_side"]
0143:         in_side = obj["in_side"]
0144:         margin = max(out_side // 2, in_side // 2)
0145:         rows = range(margin, GRID_SIZE - margin)
0146:         centers = [(r, c) for r in rows for c in rows]
0147:         random.shuffle(centers)
0148: 
0149:         for r, c in centers:
0150:             out_box = _bbox(r, c, out_side)
0151:             in_box = _bbox(r, c, in_side)
0152:             if _clear(out_box, output_boxes, OUTPUT_CLEARANCE_GAP) and _clear(in_box, input_boxes, INPUT_CLEARANCE_GAP):
0153:                 placed.append((obj["color"], out_box, in_box))
0154:                 output_boxes.append(out_box)
0155:                 input_boxes.append(in_box)
0156:                 break
0157:         else:
0158:             return None
0159:     return placed
0160: 
0161: 
0162: def _render_grid(placed, box_index):
0163:     """Render one phase from placed tuples: 1 for output boxes, 2 for input boxes."""
0164:     grid = np.full((GRID_SIZE, GRID_SIZE), BACKGROUND_COLOR, dtype=int)
0165:     for item in placed:
0166:         _draw_square(grid, item[0], item[box_index])
0167:     return grid
0168: 
0169: 
0170: def _gen_attempt():
0171:     objects = _sample_objects()
0172:     if objects is None:
0173:         return None
0174: 
0175:     placed = _place_objects(objects)
0176:     if placed is None:
0177:         return None
0178: 
0179:     out = _render_grid(placed, 1)
0180:     inp = _render_grid(placed, 2)
0181:     return inp if np.array_equal(main(inp), out) else None
0182: 
0183: 
0184: def generate_input():
0185:     for _ in range(MAX_GENERATION_ATTEMPTS):
0186:         grid = _gen_attempt()
0187:         if grid is not None:
0188:             return grid
0189:     raise RuntimeError("failed to generate valid 522fdd07 input")
