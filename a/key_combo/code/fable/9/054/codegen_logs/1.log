0091: def _gen_orbit(r: int, c: int, n: int) -> set[tuple[int, int]]:
0092:     last = n - 1
0093:     return {
0094:         (r, c),
0095:         (r, last - c),
0096:         (last - r, c),
0097:         (last - r, last - c),
0098:         (c, r),
0099:         (c, last - r),
0100:         (last - c, r),
0101:         (last - c, last - r),
0102:     }
