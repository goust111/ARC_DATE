0118: def _gen_valid_marker_positions(n: int, h: int, w: int) -> list[tuple[int, int]]:
0119:     """Return marker anchors whose cells have a visible LR/UD/180 counterpart."""
0120:     positions = []
0121:     last = n - 1
0122:     for r0 in range(n - h + 1):
0123:         r1 = r0 + h - 1
0124:         straddles_h = r0 <= last // 2 and r1 > last // 2
0125:         for c0 in range(n - w + 1):
0126:             c1 = c0 + w - 1
0127:             straddles_v = c0 <= last // 2 and c1 > last // 2
0128:             if straddles_h and straddles_v:
0129:                 continue
0130:             ok = True
0131:             for r in range(r0, r1 + 1):
0132:                 for c in range(c0, c1 + 1):
0133:                     reflected = (
0134:                         (r, last - c),
0135:                         (last - r, c),
0136:                         (last - r, last - c),
0137:                     )
0138:                     if all(r0 <= rr <= r1 and c0 <= cc <= c1 for rr, cc in reflected):
0139:                         ok = False
0140:                         break
0141:                 if not ok:
0142:                     break
0143:             if ok:
0144:                 positions.append((r0, c0))
0145:     return positions
0146: 
0147: 
0148: def _sample_palette() -> list[int]:
0149:     colors = [color for color in range(COLOR_COUNT) if color != MARKER_COLOR]
0150:     return random.sample(colors, random.randint(*PALETTE_SIZE_RANGE))
