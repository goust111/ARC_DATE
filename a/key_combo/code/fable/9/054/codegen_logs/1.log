0004: import numpy as np
0005: from typing import *
0006: from arc_utils import Color, bbox, draw_line
0007: 
0008: # concepts:
0009: # counting, uniqueness, surrounding
0010: 
0011: # description:
0012: # In the input, you will see a grid with a black background and colored pixels sprinkled on it. Exactly one color occurs only one time.
0013: # To make the output, find the cell whose color is unique (color occurs only one time), and surround that cell with red pixels. Make all the other pixels black.
0014: 
0015: def main(input_grid: np.ndarray) -> np.ndarray:
0016:     """
0017:     Isolate the uniquely colored cell and surround it with a red 3 by 3 frame.
0018: 
0019:     Input structure:
0020:     - The background is black.
0021:     - Exactly one non-black color occurs once.
0022:     - Other non-black colors occur zero times or more than once.
0023: 
0024:     Rule:
0025:     - Find the first non-black color with exactly one cell.
0026:     - Create a black output grid.
0027:     - Fill the 3 by 3 neighborhood around that cell red, then restore the unique cell's original color.
0028: 
0029:     Key insight:
0030:     - Frequency, not position or shape, identifies the target cell; all non-target input pixels are discarded.
0031:     """
0032:     # Plan:
0033:     # 1. Create a blank new canvas (so that the non-unique colors don't get copied)
0034:     # 2. Find the unique cell
0035:     # 3. Surround the unique cell with red pixels
0036: 
0037:     output_grid = np.zeros_like(input_grid)
0038: 
0039:     # 2. Find the unique cell
0040:     unique_color = None
0041:     for color in Color.NOT_BLACK:
0042:         if np.count_nonzero(input_grid == color) == 1:
0043:             unique_color = color
0044:             break
0045:     assert unique_color is not None
0046:     
0047:     # 3. Surround the unique cell with red pixels
0048:     # First get the coordinates of the unique cell
0049:     _b = bbox(input_grid == unique_color)
0050:     assert _b is not None
0051:     r, c, _r1, _c1 = _b
0052:     # Copy red over the region around the unique cell (but this will accidentally delete the unique cell, so be copied back)
0053:     for rr in range(r - 1, r + 2):
0054:         for cc in range(c - 1, c + 2):
0055:             if 0 <= rr < len(input_grid) and 0 <= cc < len(input_grid[0]):
0056:                 output_grid[rr, cc] = Color.RED
0057:     # Copy the unique cell back
0058:     output_grid[r, c] = unique_color
0059: 
0060:     return output_grid
0061: 
0062: 
0063:     
0064: 
0065: 
0066: 
0067: def generate_input() -> np.ndarray:
0068:     
0069:     # make a 10x10 black grid first as background
0070:     n, m = 10, 10
0071:     grid = np.zeros((m, n), dtype=int)
0072: 
0073:     # randomly select a unique color from Color.NOT_BLACK
0074:     unique_color = random.choice(Color.NOT_BLACK)
0075: 
0076:     # randomly choose a non-border cell for the unique color
0077:     non_border_cells = [ (i, j) for i in range(1, m-1) for j in range(1, n-1) ]
0078:     unique_cell = random.choice(non_border_cells)
0079:     grid[unique_cell] = unique_color
0080: 
0081:     # remove the unique color from the list
0082:     remaining_colors = [ color for color in Color.NOT_BLACK if color != unique_color ]
0083: 
0084:     for remaining_color in remaining_colors:
0085:         # Pick a random frequency but make sure that this colour is not unique (does not have frequency 1)
0086:         frequency_of_this_color = random.choice([0, 2, 3, 4, 5, 6])
0087: 
0088:         for _ in range(frequency_of_this_color):
0089:             # randomly choose an unoccupied cell for the remaining color
0090:             empty_cells = [ (i, j) for i in range(m) for j in range(n) if grid[i][j] == Color.BLACK ]
0091:             r, c = random.choice(empty_cells)
0092:             grid[r, c] = remaining_color
0093:     
0094:     return grid
