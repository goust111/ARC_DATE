0011: # To make the output, shoot the blue pixel diagonally up and to the right, having it reflect and bounce off the walls until it exits at the top of the grid
0012: 
0013: def main(input_grid):
0014:     """
0015:     Trace the blue pixel diagonally upward while bouncing off side walls.
0016: 
0017:     Input structure:
0018:     - The grid is black except for one blue pixel.
0019:     - The blue pixel is the starting point of the path.
0020:     - The grid boundaries act as the reflecting walls.
0021: 
0022:     Rule:
0023:     - Move diagonally up and right from the start pixel.
0024:     - Paint every visited cell blue.
0025:     - Reverse horizontal direction at the left or right edge and stop when exiting the top.
0026: 
0027:     Key insight:
0028:     - Only the horizontal direction changes on a bounce; the path always moves upward.
0029:     """
0030:     # Plan:
0031:     # 1. Detect the pixel
0032:     # 2. Shoot each line of the reflection one-by-one, bouncing (changing horizontal direction) when it hits a (horizontal) wall/edge of canvas
0033: 
0034:     # Locate the blue pixel.
0035:     coords = np.argwhere(input_grid == Color.BLUE)
0036:     assert coords.shape[0] == 1
0037:     r, c = map(int, coords[0])
0038: 
0039:     H, W = input_grid.shape
0040:     out = input_grid.copy()
0041: 
0042:     # Shoot diagonally up-right, bouncing off left/right walls until exiting the top.
0043:     dr, dc = -1, 1
0044:     while 0 <= r < H and 0 <= c < W:
0045:         out[r, c] = Color.BLUE
0046: 
0047:         nr = r + dr
0048:         nc = c + dc
0049:         if nr < 0:
0050:             break
0051:         if nc < 0 or nc >= W:
0052:             dc = -dc
0053:             nc = c + dc
0054:         r, c = nr, nc
0055: 
0056:     return out
0057: 
0058: 
