0084: def generate_input():
0085:     # make a 10x10 black grid for the background
0086:     n = m = 10
0087:     grid = np.zeros((n,m), dtype=int)
0088: 
0089:     # make a horizontal grey line on a random row about halfway down the grid
0090:     row = np.random.randint(m//3, 2*(m//3))
0091:     grid[:, row] = Color.GREY
0092: 
0093:     # scatter a random number of blue and red pixels on either side of the grey line so that no pixel is in the same column as any other pixel on its side of the grey line
0094:     # select columns for the pixels above the grey line
0095:     cols = np.random.choice(np.arange(m), size=np.random.randint(3, 7), replace=False)
0096:     for col in cols:
0097:       # randomly choose whether to make the pixel red or blue
0098:       if np.random.rand() < 0.5:
0099:         grid[col, np.random.randint(row-1)] = Color.RED
0100:       else:
0101:         grid[col, np.random.randint(row-1)] = Color.BLUE
0102:     # select columns for the pixels below the grey line
0103:     cols = np.random.choice(np.arange(m), size=np.random.randint(3, 7), replace=False)
0104:     for col in cols:
0105:       # randomly choose whether to make the pixel red or blue
0106:       if np.random.rand() < 0.5:
0107:         grid[col, np.random.randint(row+1, m)] = Color.RED
0108:       else:
0109:         grid[col, np.random.randint(row+1, m)] = Color.BLUE 
0110:     
0111:     return grid
