from importlib.machinery import SourceFileLoader
from pathlib import Path
import numpy as np

p = Path('/home/lixinyu/snap/a/key_combo/code/fable/9/054/1.py')
mod = SourceFileLoader('new_arc_task_semantic', str(p)).load_module()


def extract_starts(grid):
    coords = [tuple(map(int, x)) for x in np.argwhere(grid "'!= mod.Color.BLACK)]
    assert len(coords) == 2
    return coords

for i in range(80):
    inp = mod.generate_input()
    out = mod.main(inp)
    s1, s2 = extract_starts(inp)
    p1, _ = mod._bounce_path_info(inp.shape, s1)
    p2, _ = mod._bounce_path_info(inp.shape, s2)
    set1, set2 = set(p1), set(p2)
    inter = (set1 & set2) - {s1, s2}
    assert np.array_equal(out, mod._paint(inp.shape, inter, mod.Color.GREEN))
