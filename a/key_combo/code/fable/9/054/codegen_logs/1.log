0004: def _ring_colors(g: np.ndarray) -> list[int]:
0005:     height, width = map(int, g.shape)
0006:     colors: list[int] = []
0007: 
0008:     for offset in range((min(height, width) + 1) // 2):
0009:         r0, c0 = offset, offset
0010:         r1, c1 = height - 1 - offset, width - 1 - offset
0011:         coords = [(r0, c) for c in range(c0, c1 + 1)]
0012:         coords.extend((r, c1) for r in range(r0 + 1, r1 + 1))
0013:         if r1 > r0:
0014:             coords.extend((r1, c) for c in range(c1 - 1, c0 - 1, -1))
0015:         if c1 > c0:
0016:             coords.extend((r, c0) for r in range(r1 - 1, r0, -1))
0017: 
0018:         ring_values = {int(g[r, c]) for r, c in coords}
0019:         assert len(ring_values) == 1, "each rectangular ring must be monochromatic"
0020:         colors.append(ring_values.pop())
0021: 
0022:     return colors
0023: 
0024: 
0025: def main(grid: np.ndarray) -> np.ndarray:
0026:     """
0027:     Recolor the concentric rectangular rings by cycling the outside-to-inside color order one step outward.
0028: 
0029:     Input structure:
0030:     - The whole grid is partitioned into one-cell-thick concentric rectangular rings.
0031:     - Each ring is monochromatic.
0032:     - Reading rings from outside to inside gives at least two distinct colors; a color may reappear on a later ring.
0033: 
0034:     Rule:
0035:     - Record the distinct colors in their first outside-to-inside ring order.
0036:     - Replace every pixel of each recorded color with the previous color in that cyclic order.
0037: 
0038:     Key insight:
0039:     - The transformation is a color-cycle over nesting order, not over numeric color ids or ring sizes.
0040:     """
0041:     g = np.asarray(grid, dtype=int)
0042:     assert g.ndim == 2, "expected a 2D grid"
0043:     assert min(g.shape) > 0, "expected a nonempty grid"
0044: 
0045:     order: list[int] = []
0046:     for color in _ring_colors(g):
0047:         if color not in order:
0048:             order.append(color)
0049: 
0050:     assert len(order) >= 2, "expected at least two distinct ring colors"
0051:     assert set(map(int, np.unique(g))) == set(order), "all colors must appear in the ring order"
0052: 
0053:     mapping = {color: order[i - 1] for i, color in enumerate(order)}
0054:     out = np.empty_like(g)
0055:     for old_color, new_color in mapping.items():
0056:         out[g == old_color] = new_color
0057:     return out
