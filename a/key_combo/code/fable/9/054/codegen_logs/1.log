0007: def main(grid: np.ndarray) -> np.ndarray:
0008:     """
0009:     Fill each colored outline by painting the horizontal row spans enclosed by its paired boundary pixels.
0010: 
0011:     Input structure
0012:     - The grid has a dominant background and one or more monochromatic 8-connected foreground outlines.
0013:     - Each outline has exactly two pixels on every row it occupies; those pixels are the left and right boundary of that row.
0014: 
0015:     Rule
0016:     - For each foreground outline, process only the rows touched by that outline.
0017:     - On each touched row, recolor the whole interval between the two boundary pixels to the outline color.
0018:     - Keep all other pixels unchanged.
0019: 
0020:     Key insight
0021:     - The sparse diagonal sides already mark the row-by-row horizontal fill limits of the solid shape.
0022:     """
0023:     g = np.asarray(grid, dtype=int)
0024:     assert g.ndim == 2, "expected a 2D grid"
0025: 
0026:     bg = get_bg(g)
0027:     objects = find_components(g, bg=bg, connectivity=8, monochromatic=True, return_format="dict")
0028:     assert objects, "expected at least one foreground outline"
0029: 
0030:     out = g.copy()
0031:     for obj in objects:
0032:         color = int(obj["color"])
0033:         coords = obj["coords"]
0034:         rows = sorted({int(r) for r in coords[:, 0]})
0035:         assert rows, "expected each object to occupy at least one row"
0036: 
0037:         for r in rows:
0038:             row_cols = coords[coords[:, 0] == r, 1]
0039:             assert row_cols.size == 2, "expected exactly two boundary pixels per occupied row"
0040:             c0 = int(row_cols.min())
0041:             c1 = int(row_cols.max())
0042: 
0043:             span = g[r, c0 : c1 + 1]
0044:             assert np.all((span == bg) | (span == color)), "row span must contain only background and the outline color"
0045:             out[r, c0 : c1 + 1] = color
0046: 
0047:     return out
0048: 
0049: # --------------- generator (o5x) ---------------
0050: 
0051: # Canvas, palette, sampling bounds, and retry limit.
0052: CANVAS_SIZE = 10
0053: BACKGROUND = 0
0054: COLOR_RANGE = range(1, 10)
0055: OUTLINE_COUNT_BOUNDS = (1, 3)
0056: HEIGHT_BOUNDS = (3, 5)
0057: GENERATION_ATTEMPTS = 300
0058: 
0059: def _gen_outline_cells(r0, c0, height):
0060:     """Return boundary cells and filled row spans for one V outline."""
0061:     width = 2 * (height - 1)
0062:     boundary = []
0063:     filled = []
0064:     for k in range(height):
0065:         side_k = min(k, height - 2)
0066:         r = r0 + k
0067:         c_left = c0 + side_k
0068:         c_right = c0 + width - 1 - side_k
0069:         boundary.append((r, c_left))
0070:         boundary.append((r, c_right))
0071:         for c in range(c_left, c_right + 1):
0072:             filled.append((r, c))
0073:     return boundary, filled
0074: 
0075: def _gen_valid_positions(height, used_filled):
0076:     """Return shuffled placements whose filled spans do not overlap used cells."""
0077:     width = 2 * (height - 1)
0078:     positions = []
0079:     for r0 in range(CANVAS_SIZE + 1 - height):
0080:         for c0 in range(CANVAS_SIZE + 1 - width):
0081:             boundary, filled = _gen_outline_cells(r0, c0, height)
0082:             if all(not used_filled[r, c] for r, c in filled):
0083:                 positions.append((r0, c0, boundary, filled))
0084:     random.shuffle(positions)
0085:     return positions
0086: 
0087: def _place_outlines(heights, order):
0088:     """Backtrack over shuffled valid positions; return placements or None."""
0089:     placements = [None] * len(heights)
0090:     used_filled = np.zeros((CANVAS_SIZE, CANVAS_SIZE), dtype=bool)
0091: 
0092:     def place_from(pos):
0093:         if pos == len(order):
0094:             return True
0095: 
0096:         idx = order[pos]
0097:         for r0, c0, boundary, filled in _gen_valid_positions(heights[idx], used_filled):
0098:             for r, c in filled:
0099:                 used_filled[r, c] = True
0100:             placements[idx] = (r0, c0, boundary, filled)
0101: 
0102:             if place_from(pos + 1):
0103:                 return True
0104: 
0105:             placements[idx] = None
0106:             for r, c in filled:
0107:                 used_filled[r, c] = False
0108: 
0109:         return False
0110: 
0111:     return placements if place_from(0) else None
0112: 
0113: def _render_grids(colors, placements):
0114:     """Render sparse input and its filled oracle target."""
0115:     inp = np.full((CANVAS_SIZE, CANVAS_SIZE), BACKGROUND, dtype=int)
0116:     expected = np.full((CANVAS_SIZE, CANVAS_SIZE), BACKGROUND, dtype=int)
0117:     for color, placement in zip(colors, placements):
0118:         _, _, boundary, filled = placement
0119:         for r, c in boundary:
0120:             inp[r, c] = color
0121:         for r, c in filled:
0122:             expected[r, c] = color
0123:     return inp, expected
0124: 
0125: def _gen_attempt():
0126:     n_outlines = random.randint(*OUTLINE_COUNT_BOUNDS)
0127:     colors = random.sample(COLOR_RANGE, n_outlines)
0128:     heights = [random.randint(*HEIGHT_BOUNDS) for _ in range(n_outlines)]
0129:     order = list(range(n_outlines))
0130:     random.shuffle(order)
0131: 
0132:     placements = _place_outlines(heights, order)
0133:     if placements is None:
0134:         return None
0135: 
0136:     inp, expected = _render_grids(colors, placements)
0137:     try:
0138:         actual = main(inp)
0139:     except AssertionError:
0140:         return None
0141: 
0142:     if not np.array_equal(actual, expected):
0143:         return None
0144:     return inp
0145: 
0146: def generate_input():
0147:     for _ in range(GENERATION_ATTEMPTS):
0148:         grid = _gen_attempt()
0149:         if grid is not None:
0150:             return grid
0151:     raise RuntimeError("failed to generate a valid 22168020 input")
