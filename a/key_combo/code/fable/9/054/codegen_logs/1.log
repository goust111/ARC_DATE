0105: def _gen_d4_grid(n: int, palette: list[int]) -> np.ndarray:
0106:     grid = np.empty((n, n), dtype=int)
0107:     half = n // 2
0108:     domain = [(r, c) for r in range(half) for c in range(r + 1)]
0109:     values = list(palette)
0110:     values += random.choices(palette, k=len(domain) - len(values))
0111:     random.shuffle(values)
0112:     for (r, c), color in zip(domain, values):
0113:         for rr, cc in _gen_orbit(r, c, n):
0114:             grid[rr, cc] = color
0115:     return grid
