+
+def _build_region_graph(region_labels: np.ndarray, wall_mask: np.ndarray) -> dict[int, set[int]]:
+    H, W = region_labels.shape
+    n_regions = int(region_labels.max())
+    graph = {region_id: set() for region_id in range(1, n_regions + 1)}
