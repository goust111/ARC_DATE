+                rects.append({**spec, "rect": rect})
+                c0 = rect[3] + 1
+            return (H, W), rects
+
+        interior_w = random.randint(max(spec["min_w"] for spec in specs), 13)
+        interior_hs = [random.randint(spec["min_h"], min(spec["min_h"] + 3, 13)) for spec in specs]
+        H = sum(h + 2 for h in interior_hs)
+        W = interior_w + 2
+        if H > 30 or W > 30:
