+            H = interior_h + 2
+            W = sum(w + 2 for w in interior_ws)
+            if H > 30 or W > 30:
+                continue
+
+            rects = []
+            c0 = 0
+            for spec, iw in zip(specs, interior_ws):
+                rect = (0, c0, H - 1, c0 + iw + 1)
+                rects.append({**spec, "rect": rect})
