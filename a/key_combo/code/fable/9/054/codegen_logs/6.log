+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        generated = _generate_attempt()
+        if generated is not None:
+            return generated[0]
+    raise RuntimeError("failed to generate a valid puzzle input")

