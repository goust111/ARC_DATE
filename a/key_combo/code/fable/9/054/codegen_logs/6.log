+def _graph_components(graph: dict[int, set[int]]) -> list[set[int]]:
+    unseen = set(graph)
+    comps: list[set[int]] = []
+    while unseen:
+        start = unseen.pop()
+        comp = {start}
+        stack = [start]
+        while stack:
+            node = stack.pop()
+            for nxt in graph[node]:
+                if nxt in unseen:
+                    unseen.remove(nxt)
+                    comp.add(nxt)
+                    stack.append(nxt)
