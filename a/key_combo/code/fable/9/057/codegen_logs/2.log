   6: def main(grid: np.ndarray) -> np.ndarray:
   7:     """
   8:     Attach monochrome sprites to the matching sides of a central hollow square.
   9: 
  10:     Input structure:
  11:     - bg = background. A hollow NxN square (hub) with bg corners/interior and four differently-colored edges (top, bottom, left, right).
  12:     - 2-4 monochrome sprites scattered on the grid, each matching one hub edge color.
  13: 
  14:     Rule:
  15:     - For each hub edge color, find the matching sprite outside the hub.
  16:     - Rotate the sprite (0/90/180/270°) so its contact edge has exactly N-2 contiguous cells aligned with the hub side, and the rotated sprite is mirror-symmetric along the contact-edge axis (UD for left/right, LR for top/bottom).
  17:     - Translate it to adjoin that hub side. 
  18:     - Clear everything else to bg; output is hub + attached sprites only.
  19: 
  20:     Key insight: Each edge color uniquely pairs a sprite to a side; symmetry along the contact-edge axis disambiguates the correct rotation.
  21:     """
  22:     g = np.array(grid, dtype=int)
  23:     H, W = g.shape
  24:     bg = int(get_bg(g))
  25: 
  26:     def _find_hub():
  27:         best = None  # (score, (r,c,n), (top,bot,left,right))
  28:         for n in range(3, 7):
  29:             for r in range(0, int(H - n + 1)):
  30:                 for c in range(0, int(W - n + 1)):
  31:                     # corners must be bg
  32:                     if (
  33:                         int(g[int(r), int(c)]) != int(bg)
  34:                         or int(g[int(r), int(c + n - 1)]) != int(bg)
  35:                         or int(g[int(r + n - 1), int(c)]) != int(bg)
  36:                         or int(g[int(r + n - 1), int(c + n - 1)]) != int(bg)
  37:                     ):
  38:                         continue
  39:                     inner = g[int(r + 1) : int(r + n - 1), int(c + 1) : int(c + n - 1)]
  40:                     if not bool((inner == int(bg)).all()):
  41:                         continue
  42: 
  43:                     top = g[int(r), int(c + 1) : int(c + n - 1)]
  44:                     bot = g[int(r + n - 1), int(c + 1) : int(c + n - 1)]
  45:                     left = g[int(r + 1) : int(r + n - 1), int(c)]
  46:                     right = g[int(r + 1) : int(r + n - 1), int(c + n - 1)]
  47: 
  48:                     if bool((top == int(bg)).any()) or bool((bot == int(bg)).any()) or bool((left == int(bg)).any()) or bool((right == int(bg)).any()):
  49:                         continue
  50:                     if (
  51:                         len(set(map(int, top))) != 1
  52:                         or len(set(map(int, bot))) != 1
  53:                         or len(set(map(int, left))) != 1
  54:                         or len(set(map(int, right))) != 1
  55:                     ):
  56:                         continue
  57: 
  58:                     cr = float(r + (n - 1) / 2)
  59:                     cc = float(c + (n - 1) / 2)
  60:                     score = abs(float(cr - (H - 1) / 2)) + abs(float(cc - (W - 1) / 2))
  61:                     cand = (
  62:                         float(score),
  63:                         (int(r), int(c), int(n)),
  64:                         (int(top[0]), int(bot[0]), int(left[0]), int(right[0])),
  65:                     )
  66:                     if best is None or float(cand[0]) < float(best[0]):
  67:                         best = cand
  68:         return best
  69: 
  70:     hub = _find_hub()
  71:     assert not (hub is None)
  72: 
  73:     _score, (r, c, n), (top_col, bot_col, left_col, right_col) = hub
  74:     hub_mask = np.zeros((H, W), dtype=bool)
  75:     hub_mask[int(r) : int(r + n), int(c) : int(c + n)] = True
  76: 
