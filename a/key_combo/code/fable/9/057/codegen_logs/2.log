+            return None
+        row = random.choice(candidates)
+        shifts = [shift for shift in range(1, width) if shift % col_period != 0]
+        if not shifts:
+            return None
+        chosen_shift = random.choice(shifts)
+        out[row] = np.roll(out[row], chosen_shift)
+        shifted_rows[row] = chosen_shift
