   8: def main(grid: np.ndarray) -> np.ndarray:
   9:     """Compare the two same-sized motifs and output the cropped mask of cells missing from the damaged copy.
  10: 
  11:     Input structure
  12:     - The black background contains exactly two 4-connected multicolor foreground objects.
  13:     - The two objects have the same rectangular bbox shape and represent aligned copies of the same motif.
  14:     - One object is complete; the other is a damaged copy with only foreground cells removed.
  15: 
  16:     Rule
  17:     - Align the two object crops by their bbox top-left corners.
  18:     - Select the cells that are foreground in the complete crop and background in the damaged crop.
  19:     - Crop that missing-cell mask to its own bbox, recolor selected cells teal, and leave other cells black.
  20: 
  21:     Key insight
  22:     - The output is not one of the colored motifs; it is the shape of the damage after subtracting the smaller motif mask from the larger matching motif mask.
  23:     """
  24:     g = np.asarray(grid, dtype=int)
  25:     bg = get_bg(g)
  26:     assert bg == Color.BLACK, "expected black background"
  27: 
  28:     components = find_components(g, bg=bg, connectivity=4, monochromatic=False)
  29:     assert len(components) == 2, "expected exactly two motif objects"
  30: 
  31:     crops = [crop_bbox(g, component["bbox"]) for component in components]
  32:     assert crops[0].shape == crops[1].shape, "motif bboxes must have the same shape"
  33: 
  34:     candidates = []
  35:     for complete, damaged in ((crops[0], crops[1]), (crops[1], crops[0])):
  36:         complete_mask = complete != bg
  37:         damaged_mask = damaged != bg
  38:         missing = complete_mask & ~damaged_mask
  39:         extra = damaged_mask & ~complete_mask
  40:         overlap = complete_mask & damaged_mask
  41:         if missing.any() and not extra.any() and np.array_equal(complete[overlap], damaged[overlap]):
  42:             candidates.append(missing)
  43: 
  44:     assert len(candidates) == 1, "expected a unique complete-to-damaged mask difference"
  45:     missing = candidates[0]
  46:     missing_bbox = bbox(missing)
  47:     assert missing_bbox is not None, "expected at least one missing cell"
  48: 
  49:     cropped_missing = crop_bbox(missing, missing_bbox)
  50:     out = np.zeros(cropped_missing.shape, dtype=int)
  51:     out[cropped_missing] = Color.TEAL
  52:     return out
  53: 
