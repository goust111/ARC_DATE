+def _wallpaper_from_tile(tile: np.ndarray, height: int, width: int) -> np.ndarray:
+    rows = np.arange(height)[:, None] % tile.shape[0]
+    cols = np.arange(width)[None, :] % tile.shape[1]
+    return tile[rows, cols]
