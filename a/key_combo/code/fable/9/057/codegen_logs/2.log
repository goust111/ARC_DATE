+def _row_pair_stats(a: np.ndarray, b: np.ndarray, bg: int) -> tuple[int, int]:
+    overlap = (a != bg) & (b != bg)
+    if not bool(overlap.any()):
+        return 0, 0
+    agree = int(np.count_nonzero(overlap & (a == b)))
+    conflict = int(np.count_nonzero(overlap & (a != b)))
