+def _choose_row_period(height: int) -> int | None:
+    options = [
+        period
+        for period in range(GEN_ROW_PERIOD_RANGE[0], GEN_ROW_PERIOD_RANGE[1] + 1)
+        if height >= 3 * period
+    ]
+    if not options:
+        return None
+    return random.choice(options)
