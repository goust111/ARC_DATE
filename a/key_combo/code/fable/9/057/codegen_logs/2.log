+    values, counts = np.unique(inp, return_counts=True)
+    max_count = int(counts.max())
+    bg_count = int(counts[values == GEN_BG][0]) if GEN_BG in values else 0
+    if bg_count != max_count or int(np.count_nonzero(counts == max_count)) != 1:
+        return None
