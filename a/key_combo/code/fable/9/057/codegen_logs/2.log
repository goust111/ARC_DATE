 152:                     continue
 153:             else:
 154:                 if not bool(np.array_equal(msk, np.fliplr(msk))):
 155:                     continue
 156: 
 157:             seg = _edge_segment(msk, need_edge)
 158:             if seg is None:
 159:                 continue
 160: 
 161:             if need_edge in ("left", "right"):
 162:                 _typ, edge_c, rows = seg
 163:                 if len(rows) != int(target) or not _is_contig(rows):
