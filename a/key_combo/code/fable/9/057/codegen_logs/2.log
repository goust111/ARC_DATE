+) -> tuple[np.ndarray, list[int]] | None:
+    if len(rows) < 2:
+        return None
+
+    best_template = None
+    best_support = None
+    best_score = None
+
+    for seed_idx, seed in enumerate(rows):
+        subset = []
+        support_score = 0
+        for idx, row in enumerate(rows):
+            agree, conflict = _row_pair_stats(seed, row, bg)
+            if conflict == 0 and (agree > 0 or idx == seed_idx):
