+        deltas = [(positions[i + 1][0] - positions[i][0], positions[i + 1][1] - positions[i][1]) for i in range(len(positions) - 1)]
+        if len(set(deltas)) != 1 or deltas[0] == (0, 0):
+            continue
+        a_candidates.append(
