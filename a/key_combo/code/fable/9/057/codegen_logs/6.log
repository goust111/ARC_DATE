+
+def _random_mask(base_masks: list[np.ndarray]) -> np.ndarray:
+    mask = random.choice(base_masks).copy()
+    if random.random() < 0.5:
+        mask = np.flipud(mask)
+    if random.random() < 0.5:
+        mask = np.fliplr(mask)
+    return mask.copy()
