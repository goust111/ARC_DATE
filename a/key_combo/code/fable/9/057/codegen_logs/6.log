+
+def _first_overlap_step(
+    mask_a: np.ndarray,
+    last_a: Coord,
+    delta_a: Coord,
+    mask_b: np.ndarray,
+    last_b: Coord,
+    delta_b: Coord,
+    panel_shape: tuple[int, int],
+    max_steps: int = 12,
