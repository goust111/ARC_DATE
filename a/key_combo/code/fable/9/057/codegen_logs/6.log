+        return False
+    coords = np.argwhere(mask)
+    r0, c0, r1, c1 = _bbox_from_coords(coords)
+    if (r1 - r0 + 1, c1 - c0 + 1) != mask.shape:
+        return False
+    return int(mask.sum()) < mask.size
