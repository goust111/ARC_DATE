+        return False
+    if not mask[:, 1].any():
+        return False
+    visible = mask.copy()
+    visible[:, 1] = False
+    if not visible.any():
+        return False
+    coords_vis = np.argwhere(visible)
+    vr0, vc0, vr1, vc1 = _bbox_from_coords(coords_vis)
