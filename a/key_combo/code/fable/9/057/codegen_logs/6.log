+def _render_panel(
+    side: int,
+    frame_color: int,
+    fill_color: int,
+    pillar_color: int,
+    pillar_col: int,
+    a_color: int,
+    a_mask: np.ndarray,
+    a_pos: Coord,
+    b_color: int,
+    b_mask: np.ndarray,
+    b_pos: Coord,
+    *,
+    wrong_order: bool = False,
+    rect_mode: bool = False,
+) -> np.ndarray:
+    panel = np.full((side, side), int(fill_color), dtype=int)
+    panel[0, :] = int(frame_color)
+    panel[-1, :] = int(frame_color)
+    panel[:, 0] = int(frame_color)
+    panel[:, -1] = int(frame_color)
+
+    a_draw = np.ones_like(a_mask, dtype=bool) if rect_mode else a_mask
+    b_draw = np.ones_like(b_mask, dtype=bool) if rect_mode else b_mask
+
