+    return {
+        "bg": bg,
+        "panels": panels,
+        "side": side_h,
+        "fill_color": fill_color,
+        "pillar_color": int(pillar_color),
+        "pillar_col": int(pillar_col),
+        "a_color": a_color,
+        "a_mask": a_info["mask"],
+        "a_positions": a_info["positions"],
+        "a_delta": a_info["delta"],
+        "b_color": int(b_color),
+        "b_mask": b_mask,
+        "b_positions": b_positions,
+        "b_delta": b_deltas[0],
