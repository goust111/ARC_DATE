+        pos_b = (last_b[0] + step * delta_b[0], last_b[1] + step * delta_b[1])
+        if not _fits_in_panel(dummy_a, pos_a, (side, side)) or not _fits_in_panel(dummy_b, pos_b, (side, side)):
+            return None
+        if _rect_overlap(pos_a, a_shape, pos_b, b_shape):
