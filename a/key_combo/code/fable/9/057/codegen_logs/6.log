+    remaining = [color for color in active_colors if color != a_color]
+    pillar_matches: list[tuple[int, int]] = []
+    for color in remaining:
+        cols = []
+        ok = True
+        for panel in panels:
+            coords = np.argwhere(panel == color)
+            uniq_cols = sorted(set(map(int, coords[:, 1])))
+            if len(uniq_cols) != 1:
