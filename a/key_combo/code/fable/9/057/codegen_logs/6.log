+                        if not all(_fits_in_panel(a_mask, pos, side_shape) for pos in a_positions):
+                            continue
+                        if not any(_pillar_hits(a_mask, pos, pillar_col) for pos in a_positions):
+                            continue
+
+                        for last_b in positions_b:
