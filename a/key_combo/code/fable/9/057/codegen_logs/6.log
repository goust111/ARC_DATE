+    assert coords.size > 0
+    bbox = _bbox_from_coords(coords)
+    cropped = _crop(panel == int(color), bbox).astype(bool)
+    return bbox, cropped
+
+
+def _mask_cells(mask: np.ndarray, top: int, left: int) -> set[Coord]:
