+    panel_boxes = sorted((_bbox_from_coords(coords) for coords in panel_coords), key=lambda b: (b[1], b[0]))
+    side_shapes = {(r1 - r0 + 1, c1 - c0 + 1) for r0, c0, r1, c1 in panel_boxes}
