+def _fits_in_panel(mask: np.ndarray, pos: Coord, panel_shape: tuple[int, int]) -> bool:
+    h, w = panel_shape
+    mh, mw = mask.shape
+    r, c = pos
+    return 0 <= r and 0 <= c and r + mh <= h and c + mw <= w
+
