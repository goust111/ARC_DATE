+            side,
+            int(spec["fill_color"]),
+            int(spec["pillar_color"]),
+            int(spec["pillar_col"]),
+            int(spec["a_color"]),
+            spec["a_mask"],
+            spec["a_positions"][i],
+            int(spec["b_color"]),
+            spec["b_mask"],
+            spec["b_positions"][i],
