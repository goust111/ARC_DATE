+    mh, mw = mask.shape
+    view = panel[top : top + mh, left : left + mw]
+    view[mask] = int(color)
+
+
+def _rect_overlap(pos_a: Coord, shape_a: tuple[int, int], pos_b: Coord, shape_b: tuple[int, int]) -> bool:
+    ar0, ac0 = pos_a
+    br0, bc0 = pos_b
+    ah, aw = shape_a
+    bh, bw = shape_b
