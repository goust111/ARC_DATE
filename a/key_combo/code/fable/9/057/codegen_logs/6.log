+    expected = _render_panel(
+        side,
+        int(spec["fill_color"]),
+        int(spec["pillar_color"]),
+        int(spec["pillar_col"]),
+        int(spec["a_color"]),
+        spec["a_mask"],
+        a_final,
+        int(spec["b_color"]),
+        spec["b_mask"],
+        b_final,
+    )
