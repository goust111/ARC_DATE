+    fill_color = int(Counter(map(int, panels[0][1:-1, 1:-1].ravel())).most_common(1)[0][0])
+    active_colors = sorted(set(map(int, np.unique(panels[0]))) - {frame_color, fill_color})
+    assert len(active_colors) == 3, "expected pillar and two sprite colors"
+
+    a_candidates: list[dict[str, object]] = []
+    for color in active_colors:
+        boxes: list[BBox] = []
+        masks: list[np.ndarray] = []
