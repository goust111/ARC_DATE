+def _build_input_and_expected(spec: dict[str, object]) -> tuple[np.ndarray, np.ndarray]:
+    side = int(spec["side"])
+    gap = int(spec["gap"])
+    top_margin = int(spec["top_margin"])
+    left_margin = int(spec["left_margin"])
