+
+    height = side + 2 * top_margin
+    width = frames * side + (frames - 1) * gap
+    grid = np.full((height, width), int(spec["bg"]), dtype=int)
+
+    for i in range(frames):
+        panel = _render_panel(
+            side,
+            int(spec["fill_color"]),
+            int(spec["pillar_color"]),
+            int(spec["pillar_col"]),
+            int(spec["a_color"]),
+            spec["a_mask"],
+            spec["a_positions"][i],
+            int(spec["b_color"]),
+            spec["b_mask"],
+            spec["b_positions"][i],
+        )
+        c0 = i * (side + gap)
+        grid[top_margin : top_margin + side, c0 : c0 + side] = panel
+
