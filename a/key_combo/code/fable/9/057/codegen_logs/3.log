  motif:
    bbox_shape: 8-15 rows x 6-10 cols, identical for both objects
    fg_density: 0.67-0.92 of bbox cells are foreground
    colors: 4-6 distinct non-black colors
    symmetry: LR [observed]
    structure: concentric/layered pattern with multiple color bands [observed]
  damaged_copy:
    mask: strict subset of complete motif mask (no extra pixels)
    overlapping_pixels: identical colors to complete motif
    missing_pixels: 6-13 cells removed, 8-16% of complete fg count
    missing_region: spans 2-4 rows of the motif, located in interior (not top/bottom edge)
    missing_connectivity: 1-2 connected components in the missing mask
  placement: bboxes separated by 3-6 cols or rows gap; may overlap in one axis but not both
  output:
    content: tight crop of missing-cell boolean mask
    coloring: teal (8) for missing cells, black (0) elsewhere
    shape: 2-4 rows x 6-10 cols (equals missing mask tight bbox)

generation_strategy:
  approach: output-first
  steps:
    1. Generate output (missing mask) - random teal/black pattern, 2-4 rows x 6-10 cols, tight-cropped, 6-13 teal cells
    2. Build complete motif - LR-symmetric multicolor pattern, 8-15 rows x 6-10 cols, 4-6 colors, density 0.67-0.92
