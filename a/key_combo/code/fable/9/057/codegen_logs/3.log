+    if len(candidates) < 2:
+        return None
+
+    target = int(rng.integers(2, min(6, len(candidates)) + 1))
+    candidate_set = set(candidates)
+    chosen: list[tuple[int, int]] = []
+    used: set[tuple[int, int]] = set()
+
+    seeds = list(candidates)
+    rng.shuffle(seeds)
+    while seeds and len(chosen) < target:
+        seed = seeds.pop()
+        if seed in used:
+            continue
+        cluster = [seed]
+        neighbors = [
