+    n = len(order)
+    size = 2 * n - 1
+    center = n - 1
+    out = np.empty((size, size), dtype=int)
+    for r in range(size):
+        for c in range(size):
+            depth = max(abs(r - center), abs(c - center))
+            out[r, c] = order[depth]
+    return out
+
