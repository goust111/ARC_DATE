    N = random.randint(MIN_LINE_COUNT, MAX_LINE_COUNT)
    min_size = max(MIN_GRID_SIZE, GRID_SIZE_PER_LINE * N - GRID_SIZE_MARGIN)
    S = random.randint(min_size, MAX_GRID_SIZE)

