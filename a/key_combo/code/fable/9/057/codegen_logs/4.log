+            return False
+    else:
+        if any(box[2] < final_pos[1] < box[3] for box in scene["containers"]):
+            return False
+
+    return True
+
+
+def _generate_attempt() -> np.ndarray | None:
+    width = random.randint(*GEN_WIDTH_RANGE)
