+        "bottom": bottom,
+        "visible": list(piece),
+        "visible_set": set(piece),
+        "gap": None,
+        "dir": direction,
+        "line_key": line_key,
+    }
+
+
+def _merge_chute_pieces(pieces: list[dict]) -> list[dict]:
