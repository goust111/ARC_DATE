+        "landings": path["landings"],
+        "leak_pattern": [spec["broken"] for spec in path["specs"]],
+        "final_col": final_col,
+        "catch": catch,
+        "decoy_cols": decoy_cols,
+        "total_chutes": len(path["specs"]) + len(distractors),
