+def _add_distractors(height: int, width: int, ceiling_row: int, all_specs: list[dict], fall_cols: set[int]) -> list[dict] | None:
+    target = random.choice(GEN_EXTRA_CHUTE_CHOICES)
+    distractors: list[dict] = []
+    if target == 0:
