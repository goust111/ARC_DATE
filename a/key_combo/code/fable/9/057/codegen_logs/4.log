+def _expected_output(input_grid: np.ndarray, marker_color: int, catch_col: int | None) -> np.ndarray:
+    out = input_grid.copy()
+    out[np.argwhere(out == marker_color)[0][0], np.argwhere(out == marker_color)[0][1]] = GEN_BG
