def _center_empty_rows(top: int, band_len: int, empty_count: int) -> set[int]:
    bottom = top + band_len - 1
    if empty_count == 1:
        if band_len % 2:
            return {(top + bottom) // 2}
        return {random.choice([(top + bottom) // 2, (top + bottom) // 2 + 1])}
    if band_len % 2:
        mid = (top + bottom) // 2
        return set(random.choice([(mid - 1, mid), (mid, mid + 1)]))
    mid = (top + bottom) // 2
    return {mid, mid + 1}


