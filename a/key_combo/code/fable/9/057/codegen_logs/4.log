+        "grid": g,
+        "bg": bg,
+        "marker_color": marker_color,
+        "marker_pos": marker_pos,
+        "container_color": container_color,
+        "containers": containers,
+        "chute_color": chute_color,
+        "chutes": chutes,
+        "pos_to_chute": pos_to_chute,
+    }
