+    inp = np.full((height, width), bg, dtype=int)
+    if axis == 1:
+        inp[positions, lo] = marker_color
+        inp[positions, hi] = marker_color
+    else:
+        inp[lo, positions] = marker_color
+        inp[hi, positions] = marker_color
