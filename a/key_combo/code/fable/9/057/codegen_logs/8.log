+    rows = sorted(set(map(int, coords[:, 0])))
+    cols = sorted(set(map(int, coords[:, 1])))
+    row_counts = [int(np.count_nonzero(coords[:, 0] == row)) for row in rows]
+    col_counts = [int(np.count_nonzero(coords[:, 1] == col)) for col in cols]
