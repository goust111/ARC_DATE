+    if not added.any():
+        return False
+
+    strip_indices = set()
+    odd_seen = False
+    even_far_seen = False
+    for rr, cc in np.argwhere(out != bg):
+        r = int(rr)
+        c = int(cc)
+        if int(out[r, c]) == marker_color:
+            continue
+        normal = r if axis == 0 else c
+        if normal == lo or normal == hi:
+            return False
+        n = _strip_index(normal, lo, step)
+        strip_indices.add(n)
+        if n % 2 != 0:
+            odd_seen = True
+        if n % 2 == 0 and n != 0:
