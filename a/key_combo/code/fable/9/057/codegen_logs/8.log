+    return len(_components(mask)) == 1
+
+
+def _marker_candidate(grid: np.ndarray, bg: int, color: int) -> tuple[int, tuple[int, int]] | None:
+    coords = np.argwhere(grid == color)
+    if coords.shape[0] < 2 * MIN_MARKERS:
+        return None
