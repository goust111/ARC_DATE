        elif side == "right":
            mask = np.fliplr(grid)
        elif side == "top":
            mask = np.rot90(grid, -1)  # CW: right->bottom
        else:  # bot
            mask = np.rot90(grid, 1)   # CCW: right->top
        return mask

    return None


