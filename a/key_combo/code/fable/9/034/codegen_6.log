+        for box in blocks:
+            by_span.setdefault((int(box[0]), int(box[2])), []).append(box)
+
+        pairs = []
+        gap_widths = set()
+        for span in sorted(by_span):
+            row_blocks = sorted(by_span[span], key=lambda box: int(box[1]))
+            if len(row_blocks) != 2:
+                pairs = []
+                break
+            left, right = row_blocks
+            gap_width = int(right[1] - left[3] - 1)
+            if gap_width <= 0:
+                pairs = []
+                break
