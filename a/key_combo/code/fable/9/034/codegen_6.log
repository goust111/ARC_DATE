+    owner = np.full(regions[0].shape, -1, dtype=int)
+    overwrites: list[bool] = []
+    for idx in order:
+        idx = int(idx)
+        region = regions[idx]
+        mask = region != bg
+        before = out.copy()
+        overwrite_mask = mask & (before != bg) & (before != region)
+        overwrites.append(bool(np.any(overwrite_mask)))
+        out[mask] = region[mask]
+        owner[mask] = idx
+    return out, owner, overwrites
