+            grid[int(row) : int(row) + MARKER_SIZE, int(left) + MARKER_SIZE : int(left) + MARKER_SIZE + gap_width].copy()
+            for row, left in zip(row_starts, left_cols)
+        ],
+        BG,
+    ):
