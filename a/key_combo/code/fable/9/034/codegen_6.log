+from arc_utils import bbox_h, bbox_w, colors_present, find_components, get_bg, paste
+
+
+BG = 0
+MARKER = 8
+PAYLOAD_COLORS = np.array([1, 2, 3, 4, 5, 6, 7, 9], dtype=int)
+MARKER_SIZE = 2
+MAX_ATTEMPTS = 400
