+def _overlay_regions(regions: list[np.ndarray], order: tuple[int, ...] | list[int], bg: int) -> np.ndarray:
+    out = np.full(regions[0].shape, int(bg), dtype=int)
+    for idx in order:
+        paste(out, regions[int(idx)], 0, 0, transparent=int(bg))
+    return out
