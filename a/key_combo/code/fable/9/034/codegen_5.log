+        forbid_revisit=True,
+    )
+    alternatives.append(None if alt_path is None else _render_path(grid, int(scene["seed_color"]), alt_path))
+
+    alt_path = _trace_path(
+        grid.shape,
+        scene["seed"],
+        scene["direction"],
+        scene["heights"],
+        blocked={scene["tail"]},
+        turn="none",
+        forbid_revisit=True,
