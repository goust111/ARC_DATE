            if not np.array_equal(patch_out, np.maximum(patch_out * 0 + int(bg), patch_out)):
                return False
            if not np.array_equal((patch_out != bg), (sprite != bg)):
                return False
            if not np.array_equal(patch_out[sprite != bg], sprite[sprite != bg]):
