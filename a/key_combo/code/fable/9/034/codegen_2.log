spec:
  grid: 10-15 rows x 12-19 cols, same size for input and output
  background: 0 (black)
  tile_band:
    height: 3 [observed]
    position: not at top or bottom edge; rows_above >= tile_h, rows_below >= tile_h
    width: full grid width
    colors: exactly 1 non-bg color per task
    content: every row contains at least one fg cell; mix of bg and fg cells; fg density 0.4-0.7
    horizontal_periodicity: tile rows have horizontal period 2-6 [observed]
  input: all rows outside the band are entirely bg; band rows contain the tile pattern
  output: tile repeated vertically over entire grid, phase-anchored at band's original row position via (row - r0) % tile_h

generation_strategy:
  approach: output-first
  steps:
    1. Pick grid dims H in [10,15], W in [12,19]
    2. Pick 1 fg color (non-zero)
    3. Build a 3-row x W tile with horizontal periodicity (pick period p in [2,6], design a 3xp motif of fg+bg, tile it across W columns); ensure each row has >=1 fg cell and fg density in [0.3,0.7]
    4. Build full output by repeating tile vertically to fill HxW, anchored at chosen r0
    5. Pick r0 in [3, H-4] so rows_above >= 3 and rows_below >= 3
    6. Build input by copying output rows [r0, r0+2] into an all-bg HxW grid
