+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+FRAME = 5
+KEY_PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+
+KEY_COUNT_RANGE = (2, 4)
+DOT_COUNT_RANGE = (1, 3)
+SPRITE_WIDTH_RANGE = (2, 4)
+SPRITE_HEIGHT_RANGE = (1, 3)
+MAX_OFFSET_RANGE = (3, 5)
+LEGEND_SLACK_RANGE = (0, 2)
+GRID_MAX_SIDE = 30
+DISTRACTOR_PROB = 0.55
+DISTRACTOR_COUNT_RANGE = (1, 2)
