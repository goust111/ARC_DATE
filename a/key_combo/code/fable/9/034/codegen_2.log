    H, W = inp.shape
    max_offset = max(offsets) if offsets else 0
    span_w = (max_offset + 1) * w
    candidates = [
        (r, c)
        for r in range(H - h + 1)
        for c in range(W - span_w + 1)
    ]
    random.shuffle(candidates)
    for r0, c0 in candidates:
        group_box = (r0, c0, r0 + h - 1, c0 + span_w - 1)
