def _gen_tile(width: int, color: int, period: int) -> np.ndarray:
    row_options = [(bits, _gen_row_count(bits, period, width)) for bits in range(1, 1 << period)]
    lo = (FG_TOTAL_MIN_NUM * width + FG_TOTAL_DEN - 1) // FG_TOTAL_DEN
