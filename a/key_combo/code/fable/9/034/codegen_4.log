+
+
+def _pick_residue_subset(
+    full: np.ndarray,
+    band: np.ndarray,
+    band_top: int,
+    base_slot: int,
+    shift: int,
+    colors: tuple[int, int],
+) -> tuple[int, list[tuple[int, int]]] | None:
+    band_height, _width = band.shape
+    slot_count = full.shape[0] // band_height
+
