+                full_matches = _matching_shifts(
+                    band,
+                    residues,
+                    values,
+                    band_top,
+                    k,
+                    colors,
+                    use_flip=True,
+                    use_swap=True,
+                )
+                if full_matches != [shift]:
+                    continue
+
+                if shift in _matching_shifts(
+                    band,
+                    residues,
+                    values,
+                    band_top,
+                    k,
+                    colors,
+                    use_flip=False,
+                    use_swap=True,
+                ):
+                    continue
+                if shift in _matching_shifts(
+                    band,
+                    residues,
+                    values,
+                    band_top,
+                    k,
+                    colors,
+                    use_flip=True,
+                    use_swap=False,
+                ):
+                    continue
+
+                return k, residues
+
+    return None
+
+
+def _build_case() -> np.ndarray | None:
+    for _ in range(MAX_ATTEMPTS):
