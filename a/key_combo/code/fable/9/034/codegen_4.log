+                out[r, c] = color
+
+    return out
+
+
+def _matching_shifts(
+    band: np.ndarray,
+    residues: list[tuple[int, int]],
+    residue_values: list[int],
+    band_top: int,
+    k: int,
+    colors: tuple[int, int],
+    *,
+    use_flip: bool,
+    use_swap: bool,
+) -> list[int]:
+    height, width = band.shape
+    slot_top = band_top + k * height
