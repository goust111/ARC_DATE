+            matches.append(int(shift))
+
+    return matches
+
+
+def _find_reference_band(grid: np.ndarray, bg: int) -> tuple[int, np.ndarray, tuple[int, int]]:
+    full_rows = np.flatnonzero(np.all(grid != bg, axis=1))
