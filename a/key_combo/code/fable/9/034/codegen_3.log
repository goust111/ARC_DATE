   7: def main(grid: np.ndarray) -> np.ndarray:
   8:     """
   9:     Extend each non-background pixel into an L reaching the nearest vertical and horizontal grid edges.
  10: 
  11:     Input structure
  12:     A mostly background grid contains one or more isolated foreground marker pixels.
  13:     Each marker is closer to one vertical edge and one horizontal edge, with no midpoint ties.
  14: 
  15:     Rule
  16:     For every marker at (r, c), draw its color along column c from the marker to the nearer
  17:     top or bottom edge, and along row r from the marker to the nearer left or right edge.
  18: 
  19:     Key insight
  20:     Each single pixel is the corner of an edge-facing L; its directions are chosen by nearest
  21:     grid-boundary distance rather than by color identity.
  22:     """
  23:     g = np.asarray(grid, dtype=int)
  24:     assert g.ndim == 2
  25:     h, w = g.shape
  26:     bg = get_bg(g)
  27:     markers = np.argwhere(g != bg)
  28:     assert len(markers) > 0
  29: 
  30:     for r, c in markers:
  31:         r = int(r)
  32:         c = int(c)
  33:         for rr in range(max(0, r - 1), min(h, r + 2)):
  34:             for cc in range(max(0, c - 1), min(w, c + 2)):
  35:                 if (rr, cc) != (r, c):
  36:                     assert g[rr, cc] == bg
  37: 
  38:     out = g.copy()
  39:     claimed = np.full(g.shape, -1, dtype=int)
  40: 
  41:     for r, c in markers:
  42:         r = int(r)
  43:         c = int(c)
  44:         color = int(g[r, c])
  45: 
  46:         up = r
  47:         down = h - 1 - r
  48:         left = c
  49:         right = w - 1 - c
  50:         assert up != down
  51:         assert left != right
  52: 
  53:         r_edge = 0 if up < down else h - 1
  54:         c_edge = 0 if left < right else w - 1
  55: 
  56:         mask = np.zeros(g.shape, dtype=bool)
  57:         mask[min(r, r_edge) : max(r, r_edge) + 1, c] = True
  58:         mask[r, min(c, c_edge) : max(c, c_edge) + 1] = True
  59: 
  60:         assert np.all((g[mask] == bg) | (g[mask] == color))
  61:         assert np.all((claimed[mask] == -1) | (claimed[mask] == color))
  62:         claimed[mask] = color
  63:         out[mask] = color
