+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    frames = _frames(g)
+    assert len(frames) >= 2
+    reach = _transitive_closure(_direct_relations(g, frames))
+    bottom = frames[_bottom_index(reach)]
+    return _paint_perimeter(g, bottom["bbox"], bottom["color"])
