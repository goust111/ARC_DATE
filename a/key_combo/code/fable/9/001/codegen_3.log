import random, numpy as np

def perimeter_cells(rect):
    r0,c0,r1,c1=rect
    s=set()
    for c in range(c0,c1+1): s.add((r0,c)); s.add((r1,c))
    for r in range(r0,r1+1): s.add((r,c0)); s.add((r,c1))
    return s

def sample(n=5,H=26,W=26):
    rects=[]
    dir=1
    row=random.randint(1,3)
    prev_h_top=None
    v_left=v_right=None
    for k in range(n):
        if k%2==0:
            hh=random.randint(3,5)
            long=random.randint(10,16)
            if k==0:
                if dir==1:
                    left=random.randint(1,3); right=left+long-1
                else:
                    right=W-2-random.randint(0,2); left=right-long+1
            else:
                if dir==1:
                    left=max(1,v_left-random.randint(1,2)); right=left+long-1
                else:
                    right=min(W-2,v_right+random.randint(1,2)); left=right-long+1
            top=row; bottom=top+hh-1
            if left<1 or right>W-2 or bottom>H-2: return None
            rect=(top,left,bottom,right)
            rects.append(rect)
            h_left,h_right=left,right
            prev_h_top=top; prev_h_bottom=bottom
        else:
            ww=random.randint(3,5)
            long=random.randint(10,14)
            if dir==1:
                vr=h_right-random.randint(0,2); vl=vr-ww+1
            else:
                vl=h_left+random.randint(0,2); vr=vl+ww-1
            top=max(1,prev_h_top-random.randint(1,2))
            bottom=top+long-1
            if vl<1 or vr>W-2 or bottom>H-2: return None
            rect=(top,vl,bottom,vr)
            rects.append(rect)
            v_left,v_right=vl,vr
            row=bottom-random.randint(2,4)
            dir*=-1
    return rects

def graph(rects):
    per=[perimeter_cells(r) for r in rects]
    cov={}
    for i,p in enumerate(per):
        for cell in p:
            cov.setdefault(cell,[]).append(i)
    maxcov=max(len(v) for v in cov.values())
    edges=[]
    for i in range(len(rects)):
      for j in range(i+1,len(rects)):
        if per[i]&per[j]: edges.append((i,j))
    return edges,maxcov

for _ in range(20):
    rects=sample(n=random.randint(4,6),H=random.randint(23,28),W=random.randint(23,28))
    if not rects: continue
    edges,maxcov=graph(rects)
    print(rects, edges, maxcov)
