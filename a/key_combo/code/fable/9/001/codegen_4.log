+    return {
+        "r0": r0,
+        "c0": c0,
+        "side": side,
+        "inside": inside,
+        "full_count": full_count,
+        "partial_count": len(holes),
+        "holes": holes,
+    }
+
+
+def _find_pattern_square(grid: np.ndarray, bg: int) -> dict:
+    h, w = grid.shape
+    fg = (grid != bg).astype(int)
