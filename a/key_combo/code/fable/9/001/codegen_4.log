+                    info["inside"],
+                    info["full_count"],
+                    info["partial_count"],
+                    info["side"],
+                    -info["r0"],
+                    -info["c0"],
+                )
+                if best_key is None or key > best_key:
+                    best = info
+                    best_key = key
