    outside = np.ones(inp.shape, dtype=bool)
    outside[lr0 : lr1 + 1, lc0 : lc1 + 1] = False
    inp[outside & (inp != BG_COLOR)] = placeholder

    try:
        if np.array_equal(main(inp), out):
            return inp
    except Exception:
        return None
    return None


