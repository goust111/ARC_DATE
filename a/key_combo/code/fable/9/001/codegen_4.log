+    for orbit, vals in partial_data:
+        missing = next(i for i, v in enumerate(vals) if v == bg)
+        for i in range(4):
+            a = vals[i]
+            b = vals[(i + 1) % 4]
+            if a != bg and b != bg and succ.get(a) != b:
+                return None
+        options: list[int] = []
+        prev_color = vals[(missing - 1) % 4]
+        next_color = vals[(missing + 1) % 4]
