+
+def _find_rooms(grid: np.ndarray, bg: int) -> tuple[int, list[dict]]:
+    colors = [int(v) for v in np.unique(grid) if int(v) != bg]
+    candidates: list[tuple[int, list[dict]]] = []
+    for color in colors:
