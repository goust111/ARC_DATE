+        painted[reachable] = palette[dist[reachable] % len(legend)]
+    out[:sep, :] = painted
+    return out
+
+
+def _can_place_mask(occupied: np.ndarray, mask: np.ndarray, top: int, left: int, pad: int = 1) -> bool:
+    h, w = occupied.shape
+    mh, mw = mask.shape
+    if top < 0 or left < 0 or top + mh > h or left + mw > w:
