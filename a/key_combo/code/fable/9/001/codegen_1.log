spec:
  grid: 8x8 [observed], could reasonably be 5-15 x 5-15
  background: entirely orange (7) except for one marker pixel
  marker:
    count: exactly 1
    color: any color from the 9-color ring cycle (green=3, yellow=4, black=0, grey=5, red=2, teal=8, maroon=9, pink=6, blue=1)
    position: any cell in the grid
  output:
    same dimensions as input
    every cell colored by Manhattan distance from marker through cyclic palette
    cycle order: green(3), yellow(4), black(0), grey(5), red(2), teal(8), maroon(9), pink(6), blue(1)
    distance 0 gets the marker color; distance d gets cycle[(start+d) % 9]
    start = index of marker_color in the cycle

generation_strategy:
