+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+
+    sep, legend, workspace, marker = _extract_structure(g)
+    dist = _distance_field(workspace, marker)
+
+    out = g.copy()
+    painted = np.zeros_like(workspace)
+    painted[workspace == GREY] = GREY
