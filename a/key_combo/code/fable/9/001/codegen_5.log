+    left_margin = int(rng.integers(0, 3))
+    right_margin = int(rng.integers(0, 3))
+    sep_h = int(rng.integers(1, 3))
+
+    grid_h = top_margin + top_panel_h + sep_h + bottom_panel_h + bottom_margin
+    grid_w = left_margin + core_w + right_margin
