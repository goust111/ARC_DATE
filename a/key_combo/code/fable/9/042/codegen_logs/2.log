    for item, top in zip(sprites, tops):
        sprite = item["filled"]
        assert 0 <= top and top + sprite.shape[0] <= h, "aligned sprite must fit output height"
        paste(out, sprite, int(top), c, transparent=bg)
        c += int(sprite.shape[1])
    return out

