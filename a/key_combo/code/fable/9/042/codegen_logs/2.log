+    grid = np.full((2 * side + 1, 2 * side + 1), int(sep), dtype=int)
+    grid[:side, :side] = quads[0]
+    grid[:side, side + 1 :] = quads[1]
+    grid[side + 1 :, :side] = quads[2]
+    grid[side + 1 :, side + 1 :] = quads[3]
+    return grid
