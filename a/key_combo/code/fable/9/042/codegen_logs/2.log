+    for src_id, dst_id in itertools.permutations(range(8), 2):
+        scores = [
+            _best_recolor_only(_apply_transform(variants[src_id], extra_t), variants[dst_id])["score"]
+            for extra_t in range(8)
+        ]
+        best = min(scores)
