+
+    a_turn_col = random.choice((c1, c2))
+    a_end_col = random.choice(tuple(col for col in (c3, c4) if col > a_turn_col))
+    b_turn_col = random.choice((c1, c2, c3))
+    c_source_col = random.choice((c2, c3, c4))
