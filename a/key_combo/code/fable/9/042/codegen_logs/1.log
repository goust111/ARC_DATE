+            gap_cells = {side: _offset(center, side) for side in gap_sides}
+            solid_border = {
+                (r0 + rr, c0 + cc)
+                for rr, cc in BORDER_RELS
+                if REL_TO_SIDE.get((rr, cc)) not in gap_sides
