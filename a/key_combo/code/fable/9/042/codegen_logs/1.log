+    frames = []
+    for r0 in range(h - 2):
+        for c0 in range(w - 2):
+            patch = g[r0 : r0 + 3, c0 : c0 + 3]
+            frame_color = int(patch[0, 0])
+            if frame_color == bg:
+                continue
+            if (
+                int(patch[0, 2]) != frame_color
+                or int(patch[2, 0]) != frame_color
+                or int(patch[2, 2]) != frame_color
+            ):
+                continue
+
+            gap_sides = []
+            valid = True
+            for rel in NON_CORNER_RELS:
