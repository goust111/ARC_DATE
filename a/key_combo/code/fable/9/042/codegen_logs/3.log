+        for _ in range(MAX_ATTEMPTS):
+            segment = [random.choice(PALETTE) for _ in range(length)]
+            if segment == list(reversed(segment)):
+                continue
+            if len(set(segment)) == 1:
+                continue
+            break
+        else:
+            raise RuntimeError("failed to sample a non-degenerate segment")
