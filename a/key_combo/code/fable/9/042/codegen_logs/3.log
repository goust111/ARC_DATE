+    if total < minimum * len(caps) or sum(caps) < total:
+        return None
+    parts = [minimum] * len(caps)
+    remaining = total - sum(parts)
+    while remaining:
+        choices = [i for i, cap in enumerate(caps) if parts[i] < cap]
+        if not choices:
+            return None
+        idx = random.choice(choices)
+        parts[idx] += 1
+        remaining -= 1
+    random.shuffle(parts)
+    return parts
