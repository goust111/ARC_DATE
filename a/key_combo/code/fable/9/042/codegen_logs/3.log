+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+
+MIN_SIZE = 7
+MAX_SIZE = 12
+MIN_SEGMENTS = 2
+MAX_SEGMENTS = 4
+MIN_SEG_LEN = 2
+MAX_SEG_LEN = 5
+MIN_SELECTED = 9
+MAX_SELECTED = 18
+MAX_ATTEMPTS = 500
