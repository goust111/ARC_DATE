+    if np.array_equal(out, grid):
+        return False
+    if not np.array_equal((out != BLACK), (grid != BLACK)):
+        return False
+
+    grey_mask = grid == GREY
+    if not np.array_equal(grey_mask, out == GREY):
+        return False
+
+    wrong_orders = [
