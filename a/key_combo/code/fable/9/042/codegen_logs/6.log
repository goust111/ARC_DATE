+    if np.array_equal(scattered, expected):
+        return None
+
+    return scattered, expected
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        sample = _build_instance()
+        if sample is not None:
