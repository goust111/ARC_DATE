+        return {
+            "id": int(sprite_id),
+            "body_color": int(body_color),
+            "bbox": (0, 0, patch.shape[0] - 1, patch.shape[1] - 1),
+            "mask": cropped_mask,
+            "patch": input_patch,
+            "filled": filled,
+            "ports": ports,
+        }
+    raise RuntimeError("failed to generate a sprite with stable non-corner ports")
