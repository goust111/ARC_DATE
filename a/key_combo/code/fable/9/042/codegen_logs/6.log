+from __future__ import annotations
+
+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BG = 0
+COLOR_POOL = (1, 2, 3, 4, 5, 6, 7, 8, 9)
+SIDE_DELTA = {
+    "top": (-1, 0),
+    "bottom": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+OPPOSITE = {
+    "top": "bottom",
+    "bottom": "top",
+    "left": "right",
+    "right": "left",
+}
+DIR_ORDER = ("top", "bottom", "left", "right")
+GEN_ATTEMPTS = 500
+CHAIN_LEN_RANGE = (3, 5)
+SPRITE_SIZE_RANGE = (3, 5)
+CANVAS_SIZE_RANGE = (20, 29)
