+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _neighbors(r: int, c: int, connectivity: int) -> list[tuple[int, int]]:
+    if connectivity == 4:
+        return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+    return [
+        (r + dr, c + dc)
+        for dr in (-1, 0, 1)
+        for dc in (-1, 0, 1)
+        if not (dr == 0 and dc == 0)
+    ]
+
+
+def _component_coords(mask: np.ndarray, connectivity: int) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors(rr, cc, connectivity):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _is_connected(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return False
+    start = tuple(map(int, coords[0]))
+    seen = {start}
+    q = deque([start])
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors(r, c, 4):
+            if 0 <= nr < mask.shape[0] and 0 <= nc < mask.shape[1] and mask[nr, nc]:
+                nxt = (nr, nc)
+                if nxt not in seen:
+                    seen.add(nxt)
+                    q.append(nxt)
+    return len(seen) == int(mask.sum())
+
+
+def _port_side(r: int, c: int, h: int, w: int) -> str:
+    sides = []
+    if r == 0:
+        sides.append("top")
+    if r == h - 1:
+        sides.append("bottom")
+    if c == 0:
+        sides.append("left")
+    if c == w - 1:
+        sides.append("right")
