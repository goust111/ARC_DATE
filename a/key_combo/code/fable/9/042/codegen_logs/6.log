+        ports = []
+        ok = True
+        for side, neighbor_color in port_specs:
+            rr, cc = port_positions[side]
+            adj = (rr - r0, cc - c0)
+            try:
+                actual_side = _port_side(adj[0], adj[1], *cropped_mask.shape)
+            except AssertionError:
+                ok = False
+                break
+            if actual_side != side:
