+        idx = next(i for i, value in enumerate(values) if int(value) == color)
+        rr, cc = map(int, rel[idx])
+        side = _port_side(rr, cc, *patch.shape)
+        filled[rr, cc] = int(body_color)
+        ports.append({"color": int(color), "rel": (rr, cc), "side": side})
