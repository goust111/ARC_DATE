+    assert len(ports) in (1, 2), "each sprite must have one or two ports"
+    return {
+        "id": int(sprite_id),
+        "body_color": int(body_color),
+        "bbox": bbox,
+        "mask": mask,
+        "patch": patch,
+        "filled": filled,
+        "ports": ports,
+    }
+
+
+def _parse_sprites(grid: np.ndarray) -> list[dict]:
