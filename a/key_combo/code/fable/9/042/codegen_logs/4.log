    if target_count is None or not _gen_is_valid(grid, target_count, target_color):
        return None
    return grid


def generate_input():
    for _ in range(_GEN_RETRY_LIMIT):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid 009d5c81 input")

