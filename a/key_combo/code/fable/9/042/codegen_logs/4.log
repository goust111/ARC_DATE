+    transformed = _apply_transform(source_patch, *transform)
+    patch = np.zeros(transformed.shape, dtype=int)
+    mask = transformed != BG
+    patch[mask] = placeholder_color
+    ir, ic = _indicator_pos(transformed, indicator_color)
+    patch[ir, ic] = indicator_color
+    return patch
