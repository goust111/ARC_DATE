+from __future__ import annotations
+
+from collections import Counter, deque
+from itertools import combinations
+import random
+
+import numpy as np
+
+
+BG = 0
+IDENTITY = (0, False)
+TRANSFORMS = [(k, flip) for k in range(4) for flip in (False, True)]
+SYMMETRY_FAMILIES = {
+    "rot180": (2, False),
+    "mirror_v": (0, True),
+    "mirror_h": (2, True),
