+) -> bool:
+    r1 = r0 + h - 1
+    c1 = c0 + w - 1
+    for ar0, ac0, ar1, ac1 in rects:
+        if not (r1 + gap < ar0 or ar1 + gap < r0 or c1 + gap < ac0 or ac1 + gap < c0):
