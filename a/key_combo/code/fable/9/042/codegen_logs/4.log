+
+def _get_bg(grid: np.ndarray) -> int:
+    vals, counts = np.unique(grid, return_counts=True)
+    return int(vals[np.argmax(counts)])
+
+
+def _crop_bbox(grid: np.ndarray, bbox: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = bbox
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _apply_transform(arr: np.ndarray, k: int, flip: bool) -> np.ndarray:
+    out = np.rot90(arr, int(k))
+    return np.fliplr(out) if flip else out
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _is_connected_mask(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if len(coords) == 0:
+        return False
+    H, W = mask.shape
+    start = tuple(map(int, coords[0]))
+    seen = {start}
+    q = deque([start])
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < H and 0 <= nc < W and mask[nr, nc] and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                q.append((nr, nc))
+    return len(seen) == int(mask.sum())
+
+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    H, W = g.shape
+    seen = np.zeros((H, W), dtype=bool)
+    comps: list[dict] = []
+
+    for r in range(H):
+        for c in range(W):
+            if seen[r, c] or g[r, c] == bg:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < H and 0 <= nc < W and not seen[nr, nc] and g[nr, nc] != bg:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+
+            rows = [rr for rr, _ in coords]
+            cols = [cc for _, cc in coords]
+            values = [int(g[rr, cc]) for rr, cc in coords]
+            counts = Counter(values)
+            comps.append(
+                {
+                    "coords": coords,
+                    "bbox": (min(rows), min(cols), max(rows), max(cols)),
+                    "area": len(coords),
+                    "colors": set(counts),
+                    "color_counts": counts,
+                }
+            )
+    return comps
+
+
+def _indicator_pos(patch: np.ndarray, indicator_color: int) -> tuple[int, int] | None:
+    coords = np.argwhere(patch == indicator_color)
+    if len(coords) != 1:
+        return None
+    return tuple(map(int, coords[0]))
+
+
+def _matching_transforms(
+    source_patch: np.ndarray,
+    target_patch: np.ndarray,
+    indicator_color: int,
+    bg: int,
+    *,
