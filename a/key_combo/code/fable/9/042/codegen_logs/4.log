+def _mask_has_full_bbox(mask: np.ndarray) -> bool:
+    return bool(np.all(mask.any(axis=0)) and np.all(mask.any(axis=1)))
+
+
+def _mask_automorphisms(mask: np.ndarray) -> list[tuple[int, bool]]:
