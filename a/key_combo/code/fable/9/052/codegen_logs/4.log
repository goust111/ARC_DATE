+        lowbit = mask & -mask
+        i = lowbit.bit_length() - 1
+        rest = mask ^ (1 << i)
+        options = edges[i] & rest
+        while options:
+            pick = options & -options
+            j = pick.bit_length() - 1
+            if has_perfect_matching(rest ^ (1 << j)):
+                return True
+            options ^= pick
+        return False
