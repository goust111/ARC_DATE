+    if name == "rot180":
+        return np.rot90(arr, 2)
+    if name == "rot270":
+        return np.rot90(arr, 3)
+    if name == "flip_lr":
+        return np.fliplr(arr)
+    if name == "flip_ud":
+        return np.flipud(arr)
+    if name == "transpose":
+        return arr.T.copy()
+    if name == "anti":
+        return np.transpose(arr[::-1, ::-1]).copy()
+    raise ValueError(f"unknown transform: {name}")
