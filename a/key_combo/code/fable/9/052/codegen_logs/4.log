+                if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc]:
+                    frontier.add((nr, nc))
+        if not frontier:
+            return None
+        nr, nc = random.choice(tuple(frontier))
+        mask[nr, nc] = True
+        cells.append((nr, nc))
