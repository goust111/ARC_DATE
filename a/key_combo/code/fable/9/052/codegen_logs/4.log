+    crops = paired + [visible_unmatched]
+    random.shuffle(crops)
+
+    max_h = max(crop.shape[0] for crop in crops)
+    max_w = max(crop.shape[1] for crop in crops)
+    H = random.randint(max(15, max_h + 4), 28)
+    W = random.randint(max(15, max_w + 4), 28)
