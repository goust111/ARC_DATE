    cols = list(colors)
    random.shuffle(cols)
    if len(cols) == 1:
        sprite[mask] = cols[0]
        return sprite

    random.shuffle(coords)
    split = random.randint(1, len(coords) - 1)
    first = np.array(coords[:split], dtype=int)
    second = np.array(coords[split:], dtype=int)
    sprite[first[:, 0], first[:, 1]] = cols[0]
    sprite[second[:, 0], second[:, 1]] = cols[1]
    return sprite


