+    reservoirs = _reservoirs(g, water)
+    segs = _shelf_segments(g, shelf)
+
+    out = g.copy()
+    q = deque((int(r), int(c), int(budget), int(idx)) for idx, (r, c, budget) in enumerate(reservoirs))
+    seen: set[tuple[int, int, int, int]] = set()
+    events = {
