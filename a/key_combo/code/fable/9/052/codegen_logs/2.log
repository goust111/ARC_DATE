+def _shelf_segments(grid: np.ndarray, shelf: int) -> dict[int, list[tuple[int, int]]]:
+    H, W = grid.shape
+    segs: dict[int, list[tuple[int, int]]] = defaultdict(list)
+    for r in range(H):
+        c = 0
+        while c < W:
+            if int(grid[r, c]) != int(shelf):
+                c += 1
+                continue
+            c0 = c
+            while c + 1 < W and int(grid[r, c + 1]) == int(shelf):
+                c += 1
