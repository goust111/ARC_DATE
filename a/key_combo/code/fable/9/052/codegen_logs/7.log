+def _transform(arr: np.ndarray, orient: str) -> np.ndarray:
+    if orient == "tl":
+        return arr.copy()
+    if orient == "tr":
+        return np.fliplr(arr)
+    if orient == "bl":
+        return np.flipud(arr)
+    if orient == "br":
+        return np.rot90(arr, 2)
+    raise ValueError(f"unknown orient: {orient}")
