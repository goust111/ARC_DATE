+    max_c = max(c for _, c in chosen) + w + random.randint(0, 1)
+    return chosen, (max_r + 1, max_c + 1)
+
+
+def _build_example(specs: list[dict], h: int, w: int) -> tuple[np.ndarray, np.ndarray]:
