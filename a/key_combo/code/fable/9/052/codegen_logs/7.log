+    add_sites = addable[: random.randint(1, min(len(addable), max(2, count + 1)))]
+
+    changed_members = set()
+    for r, c in remove_sites:
+        k = random.randint(1, count // 2)
+        for idx in random.sample(range(count), k):
+            members[idx][r, c] = False
+            changed_members.add(idx)
