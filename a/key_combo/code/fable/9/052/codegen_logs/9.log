+    col = 0 if side == "left" else width - 1
+    start_row = random.randint(0, height - length)
+    return [(start_row + i, col) for i in range(length)]
+
+
+def _render_example(
+    height: int,
+    width: int,
+    side: str,
+    start: tuple[int, int],
+    station_order: list[tuple[int, int]],
+    strip_colors: list[int],
+) -> np.ndarray:
