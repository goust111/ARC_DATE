+    start = _single_position(g, START_COLOR, "grey start")
+
+    _edge_name, strip_coords, strip_colors = _find_strip(g, bg)
+    strip_set = set(strip_coords)
+
+    stations: list[tuple[int, int]] = []
+    for color in strip_colors:
