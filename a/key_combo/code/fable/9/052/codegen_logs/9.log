+    for _ in range(POINT_RETRIES):
+        random.shuffle(allowed)
+        chosen: list[tuple[int, int]] = []
+        for pt in allowed:
+            if all(max(abs(pt[0] - qr), abs(pt[1] - qc)) >= 2 for qr, qc in chosen):
