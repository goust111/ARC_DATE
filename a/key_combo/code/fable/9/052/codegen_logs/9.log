+    elif side == "left":
+        col_start = 2
+    elif side == "right":
+        col_stop = width - 2
+
+    return [(r, c) for r in range(row_start, row_stop) for c in range(col_start, col_stop)]
+
+
+def _sample_separated_points(
+    height: int, width: int, side: str, count: int
+) -> list[tuple[int, int]] | None:
