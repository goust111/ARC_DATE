+                if len(chosen) == count:
+                    return chosen
+    return None
+
+
+def _nearest_neighbor_order(
+    start: tuple[int, int], stations: list[tuple[int, int]]
+) -> list[tuple[int, int]]:
+    current = start
+    remaining = list(stations)
+    order: list[tuple[int, int]] = []
+    while remaining:
+        remaining.sort(key=lambda pt: (abs(current[0] - pt[0]) + abs(current[1] - pt[1]), pt[0], pt[1]))
