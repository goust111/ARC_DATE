spec:
  grid: 20-26 rows x 20-26 cols
  background: 0 (black), always dominant color
  foreground_colors: exactly 2 distinct non-bg colors
  mosaic:
    structure: square bounding box of side 3*tile_size, partitioned into a 3x3 lattice of sub-tiles
    tile_size: 3-5
    each_sub_tile: either fully filled with tile_color or entirely empty (no partial fills)
    filled_tiles: 4-6 out of 9 (neither all filled nor all empty)
    placement: anywhere in grid with margins >=1 on all sides [observed]
  marker:
    role: sparse noise pixels scattered across the grid (mostly single pixels or small 1-3 px clusters)
    count: 15-55 pixels total, density 4-11% of non-mosaic area
    placement: spread across the full grid extent; may appear inside empty sub-tiles of mosaic bbox but never inside filled sub-tiles
  output:
    shape: always 3x3
    rule: cell (r,c) = marker_color if mosaic sub-tile (r,c) is filled, else background

generation_strategy:
  approach: output-first
  steps:
    1. Pick grid dims H in [20,26], W in [20,26]; pick bg=0, tile_color, marker_color (two distinct non-bg colors)
    2. Generate random 3x3 binary occupancy with 4-6 filled cells
