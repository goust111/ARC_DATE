    edge = MOSAIC_GRID - 1
    valid = []
    for combo in itertools.combinations(cells, n_filled):
        rows, cols = zip(*combo)
        if min(rows) == 0 and max(rows) == edge and min(cols) == 0 and max(cols) == edge:
            valid.append(combo)

    occ = np.zeros((MOSAIC_GRID, MOSAIC_GRID), dtype=bool)
    for r, c in random.choice(valid):
