    top = random.randint(0, spare)
    spare -= top
    middle_extra = random.randint(0, spare)
    r0 = top
    r1 = r0 + sides[0] + ROW_BAND_GAP + middle_extra
    return [(r0, sides[0]), (r1, sides[1])]


