0221: 
0222:     target_i, target_count = random.choice(options)
0223:     counts: list[int] = []
0224:     for i, (lo, hi) in enumerate(bounds):
0225:         if i == target_i:
0226:             counts.append(target_count)
0227:         else:
0228:             counts.append(random.randint(max(lo, target_count + 1), hi))
0229:     return target_i, counts
