+def _simulate_quantum(obj: dict, wall_mask: np.ndarray, shape: tuple[int, int]) -> dict:
+    h = obj["h"]
+    w = obj["w"]
+    step = obj["step"]
+    dr, dc = obj["dir"]
+    r, c = obj["top_left"]
+    steps = 0
+
