0007: def main(grid: np.ndarray) -> np.ndarray:
0008:     """
0009:     Simulate water falling from top-edge sources, pooling on shelves, and cascading off edges.
0010: 
0011:     Input structure:
0012:     - bg = most common color; water = rarest non-bg; shelf = other non-bg.
0013:     - Sources: water clusters touching top row. Shelves: horizontal segments.
0014: 
0015:     Rule:
0016:     - Water falls down from sources, painting bg cells as water.
0017:     - On hitting a shelf, it spreads across the shelf span plus one cell past each end.
0018:     - From those overflow positions, water resumes falling independently.
0019: 
0020:     Key insight: Each shelf splits a stream into two at its edges, creating a branching waterfall tree.
0021:     """
0022:     g = np.array(grid, dtype=int)
0023:     H, W = g.shape
0024:     cnt = Counter(map(int, g.flatten()))
0025:     bg = int(cnt.most_common(1)[0][0])
