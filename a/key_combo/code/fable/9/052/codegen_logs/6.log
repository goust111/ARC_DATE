0145: TOTAL_LOOPS_MAX = 9                # max total loops per grid
0146: CAVITY_SIZE_WEIGHTS = [2, 2, 2, 2, 2, 3]       # cavity h/w choices (attached)
0147: DISTRACTOR_CAVITY_WEIGHTS = [2, 2, 2, 3]        # cavity h/w choices (distractor)
0148: FRAME_PLACEMENT_PAD = 1            # min distance from frame bbox to grid edge
0149: FRAME_ATTACH_TRIES = 40            # retries per frame attachment attempt
0150: DISTRACTOR_FRAME_TRIES = 40        # retries per distractor frame placement
0151: 
0152: # Line growth
0153: DIAG_WEIGHT_ALIGNED = 5            # weight for bias-aligned diagonal steps
0154: DIAG_WEIGHT_OTHER = 1              # weight for non-aligned diagonal steps
0155: ORTHO_WEIGHT_ALIGNED = 2           # weight for bias-aligned orthogonal steps
0156: ORTHO_WEIGHT_OTHER = 1             # weight for non-aligned orthogonal steps
0157: BORDER_AVOIDANCE_PROB = 0.85       # probability of skipping border cells
0158: BIAS_FLIP_PROB = 0.3               # probability of flipping bias when stuck
0159: 
0160: # Distractor network
0161: DISTRACTOR_NETWORK_PROB = 0.6      # chance of line+frame network vs solo frames
0162: DISTRACTOR_NETWORK_TRIES = 50      # retries for placing distractor network
0163: DISTRACTOR_LINE_LEN = (5, 15)      # distractor line length range
0164: DISTRACTOR_SOLO_MAX = 2            # max solo distractor frames
0165: DISTRACTOR_NETWORK_FRAMES = (1, 3) # frames per distractor network
0166: 
0167: # Generation
0168: GEN_RETRIES = 300                  # outer retry budget in generate_input()
0169: # =========================================================
0170: 
0171: DIAG_DIRS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]
0172: ORTHO_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
0173: 
