+            return {"top_left": (r, c), "n_steps": steps, "stop_reason": "wall"}
+        r, c = nr, nc
+        steps += 1
+
+
+def _simulate_glide(obj: dict, wall_mask: np.ndarray, shape: tuple[int, int]) -> tuple[int, int]:
+    h = obj["h"]
+    w = obj["w"]
+    dr, dc = obj["dir"]
+    r, c = obj["top_left"]
+    while True:
+        nr = r + dr
+        nc = c + dc
+        if not _rect_in_bounds(shape, nr, nc, h, w):
+            return (r, c)
