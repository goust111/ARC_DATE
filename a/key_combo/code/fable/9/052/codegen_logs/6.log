0195:         positions = _gen_candidate_positions(occupied, h, w)
0196:         if not positions:
0197:             return None
0198: 
0199:         remaining = len(ordered_dims) - i
0200:         needed = desired_edge_touches - edge_touches
0201:         filtered = _gen_filter_positions(positions, needed, remaining)
0202:         r, c, touches_edge = random.choice(filtered)
0203:         occupied[r : r + h, c : c + w] = True
