0244: def _grow_line(grid, start, line_col, target_len, rng):
0245:     """Grow a meandering 8-connected 1px-wide path of line_col from start."""
0246:     h, w = grid.shape
0247:     path = [start]
0248:     dr_bias = 1 if start[0] < h // 2 else -1
0249:     dc_bias = 1 if start[1] < w // 2 else -1
0250:     cur = start
0251:     path_set = {start}
0252:     while len(path) < target_len:
0253:         # Build weighted direction list: diagonals preferred, bias-aligned boosted
0254:         dirs = []
0255:         for ddr, ddc in DIAG_DIRS:
0256:             aligned = (ddr == dr_bias or ddc == dc_bias)
0257:             w_d = DIAG_WEIGHT_ALIGNED if aligned else DIAG_WEIGHT_OTHER
