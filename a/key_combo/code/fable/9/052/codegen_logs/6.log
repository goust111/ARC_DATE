0001: from __future__ import annotations
0002: 
0003: import numpy as np
0004: 
0005: from arc_utils import bbox_h, bbox_w, colors_present, components_mask, find_components
0006: import math
0007: import random
0008: 
0009: 
0010: def _largest_component_background(g: np.ndarray) -> int:
0011:     candidates: list[tuple[int, int]] = []
0012:     for color in colors_present(g):
0013:         comps = components_mask(g == color, connectivity=4)
0014:         assert comps, "present color must have at least one component"
0015:         candidates.append((max(int(coords.shape[0]) for coords in comps), int(color)))
0016: 
0017:     largest = max(size for size, _color in candidates)
0018:     winners = [color for size, color in candidates if size == largest]
0019:     assert len(winners) == 1, f"ambiguous background by largest component: {candidates}"
0020:     return winners[0]
0021: 
0022: 
0023: def main(grid: np.ndarray) -> np.ndarray:
0024:     """
0025:     Delete the rectangular foreground object that contains the fewest marker-color pixels.
0026: 
0027:     Input structure:
0028:     - A two-color set of solid foreground rectangles lies on a single background color.
0029:     - One foreground color fills most rectangle cells and the other is a sparse marker color.
0030:     - The background is the color with the largest 4-connected component.
0031: 
0032:     Rule:
0033:     - Infer the marker color as the less frequent non-background color.
0034:     - Count marker-color pixels inside each 4-connected foreground rectangle.
0035:     - Recolor the unique rectangle with the smallest marker count to background.
0036: 
0037:     Key insight:
0038:     - The object to erase is not selected by position or size; it is the rectangle with
0039:       the least internal marker evidence.
0040:     """
0041:     g = np.asarray(grid, dtype=int)
0042:     assert g.ndim == 2 and g.size > 0, "expected a non-empty 2D grid"
0043: 
0044:     bg = _largest_component_background(g)
0045:     fg_colors = colors_present(g, exclude={bg})
0046:     assert len(fg_colors) == 2, f"expected exactly two foreground colors, got {fg_colors}"
0047: 
0048:     totals = {color: int(np.count_nonzero(g == color)) for color in fg_colors}
0049:     marker_total = min(totals.values())
0050:     marker_colors = [color for color, total in totals.items() if total == marker_total]
0051:     assert len(marker_colors) == 1, f"ambiguous marker color counts: {totals}"
0052:     marker = marker_colors[0]
0053: 
0054:     objects = find_components(g, bg=bg, connectivity=4, monochromatic=False)
0055:     assert objects, "expected at least one foreground object"
0056: 
0057:     scored = []
0058:     for obj in objects:
0059:         b = obj["bbox"]
0060:         area = int(obj["area"])
0061:         assert area == bbox_h(b) * bbox_w(b), f"foreground object is not a solid rectangle: {b}"
0062:         coords = obj["coords"]
0063:         marker_count = int(np.count_nonzero(g[coords[:, 0], coords[:, 1]] == marker))
0064:         scored.append((marker_count, obj))
0065: 
0066:     fewest = min(score for score, _obj in scored)
0067:     targets = [obj for score, obj in scored if score == fewest]
0068:     assert len(targets) == 1, "expected a unique rectangle with the fewest marker pixels"
0069: 
0070:     out = g.copy()
0071:     coords = targets[0]["coords"]
0072:     out[coords[:, 0], coords[:, 1]] = bg
0073:     return out
0074: 
0075: # --------------- generator (o5x) ---------------
0076: 
0077: # Canvas and colors.
0078: _GEN_H, _GEN_W = 15, 15
0079: _GEN_BG, _GEN_FILL, _GEN_MARKER = 0, 3, 9
0080: 
0081: # Rectangle count, dimensions, and area budget.
0082: _GEN_RECT_COUNT_MIN, _GEN_RECT_COUNT_MAX = 4, 6
0083: _GEN_SIDE_MIN, _GEN_SIDE_MAX = 2, 7
0084: _GEN_RECT_AREA_MIN, _GEN_RECT_AREA_MAX = 6, 42
0085: _GEN_AREA_BUDGET_BY_COUNT = {4: (68, 118), 5: (78, 128), 6: (88, 136)}
0086: _GEN_VALID_DIMS = [
0087:     (h, w)
0088:     for h in range(_GEN_SIDE_MIN, _GEN_SIDE_MAX + 1)
0089:     for w in range(_GEN_SIDE_MIN, _GEN_SIDE_MAX + 1)
0090:     if _GEN_RECT_AREA_MIN <= h * w <= _GEN_RECT_AREA_MAX
0091: ]
0092: 
0093: # Marker density/count constraints.
0094: _GEN_MARKER_DENSITY_MIN, _GEN_MARKER_DENSITY_MAX = 0.04, 0.33
0095: _GEN_MARKER_COUNT_MIN, _GEN_MARKER_COUNT_MAX = 1, 7
0096: 
0097: # Layout constraints and edge-touch bias.
0098: _GEN_PADDING = 1
0099: _GEN_EDGE_TOUCH_MIN, _GEN_EDGE_TOUCH_MAX = 2, 4
0100: _GEN_EDGE_TOUCH_BIAS = 0.65
0101: 
0102: # Rejection limit.
0103: _GEN_MAX_ATTEMPTS = 300
0104: 
0105: 
0106: def _gen_marker_bounds(area: int) -> tuple[int, int]:
0107:     lo = max(_GEN_MARKER_COUNT_MIN, int(math.ceil(_GEN_MARKER_DENSITY_MIN * area)))
0108:     hi = min(_GEN_MARKER_COUNT_MAX, int(math.floor(_GEN_MARKER_DENSITY_MAX * area)))
0109:     return lo, hi
0110: 
0111: 
0112: def _gen_choose_dims(n_rects: int) -> list[tuple[int, int]]:
0113:     lo_budget, hi_budget = _GEN_AREA_BUDGET_BY_COUNT[n_rects]
0114:     area_budget = random.randint(lo_budget, hi_budget)
0115:     dims: list[tuple[int, int]] = []
0116:     used_area = 0
0117:     used_area6 = 0
0118: 
0119:     for i in range(n_rects):
0120:         remaining = n_rects - i - 1
0121:         max_area = area_budget - used_area - _GEN_RECT_AREA_MIN * remaining
0122:         candidates = []
0123:         for h, w in _GEN_VALID_DIMS:
0124:             area = h * w
0125:             if area > max_area:
0126:                 continue
0127:             if area == _GEN_RECT_AREA_MIN and used_area6:
0128:                 continue
0129:             candidates.append((h, w))
0130:         if not candidates:
0131:             return []
0132: 
0133:         h, w = random.choice(candidates)
0134:         dims.append((h, w))
0135:         used_area += h * w
0136:         used_area6 += int(h * w == 6)
0137: 
0138:     random.shuffle(dims)
0139:     return dims
