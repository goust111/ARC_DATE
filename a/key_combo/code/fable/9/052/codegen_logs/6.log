+        if bg != BG or len(objects) < 2:
+            return False
+        if len({obj["step"] for obj in objects}) < 2:
+            return False
+
+        wall_comps = _components(wall_mask)
+        if not wall_comps:
+            return False
+        for comp in wall_comps:
