0051: def main(grid: np.ndarray) -> np.ndarray:
0052:     """Move each marked L-shaped sprite onto the separate pixel matching its marker color.
0053: 
0054:     Input structure
0055:     - The background is the dominant color.
0056:     - Foreground has 4-connected multicolor sprites and isolated one-pixel controls.
0057:     - Each sprite has one repeated body color in an L shape plus one embedded marker
0058:       pixel of a different color.
0059: 
0060:     Rule
0061:     - If the embedded marker color also appears as a separate isolated control pixel,
0062:       translate the whole sprite so the body L-bend lands on that control pixel.
0063:     - Clear each moved sprite from its old position, clear its consumed control pixel,
0064:       then paste all translated sprites; sprites without a matching control stay put.
0065: 
0066:     Key insight
0067:     - The marker color pairs a sprite with its destination control, while the L-bend
0068:       gives the orientation-independent anchor cell to place on that destination.
0069:     """
0070:     g = np.asarray(grid, dtype=int)
0071:     bg = get_bg(g)
0072:     components = find_components(g, bg=bg, connectivity=4, monochromatic=False)
0073: 
0074:     controls_by_color: dict[int, list[tuple[int, int]]] = defaultdict(list)
0075:     sprites = []
0076:     for comp in components:
0077:         coords = comp["coords"]
0078:         if len(coords) == 1:
0079:             r, c = map(int, coords[0])
0080:             controls_by_color[int(g[r, c])].append((r, c))
0081:         else:
0082:             sprites.append(comp)
0083: 
0084:     moves = []
0085:     for sprite in sprites:
0086:         coords = sprite["coords"]
0087:         counts = Counter(int(g[r, c]) for r, c in coords)
0088:         marker_colors = [color for color, count in counts.items() if count == 1]
0089:         body_colors = [color for color, count in counts.items() if count > 1]
0090:         assert len(counts) == 2, f"sprite must have two colors, got {counts}"
0091:         assert len(marker_colors) == 1, f"sprite must have one embedded marker, got {counts}"
0092:         assert len(body_colors) == 1, f"sprite must have one body color, got {counts}"
0093: 
0094:         body_color = body_colors[0]
0095:         body_coords = np.array(
0096:             [(int(r), int(c)) for r, c in coords if int(g[r, c]) == body_color],
0097:             dtype=int,
0098:         )
0099:         anchor = _l_bend(body_coords)
0100: 
0101:         marker_color = marker_colors[0]
0102:         marker = next(
0103:             (int(r), int(c)) for r, c in coords if int(g[r, c]) == marker_color
0104:         )
0105:         controls = controls_by_color.get(marker_color, [])
0106:         if not controls:
0107:             continue
0108:         assert len(controls) == 1, f"marker color {marker_color} must have one control"
0109:         target = controls[0]
0110:         _outer_diagonal_distance(anchor, marker, target)
0111: 
0112:         dr = target[0] - anchor[0]
0113:         dc = target[1] - anchor[1]
0114: 
0115:         translated = []
0116:         for r, c in coords:
0117:             nr = int(r) + dr
0118:             nc = int(c) + dc
0119:             assert 0 <= nr < g.shape[0] and 0 <= nc < g.shape[1], "move must stay in bounds"
0120:             translated.append((nr, nc, int(g[r, c])))
0121:         moves.append((coords, target, translated))
0122: 
0123:     assert moves, "expected at least one marker-controlled move"
0124: 
0125:     out = g.copy()
0126:     cleared = set()
0127:     for coords, target, _translated in moves:
0128:         for r, c in coords:
0129:             cleared.add((int(r), int(c)))
0130:         cleared.add(target)
0131:     for r, c in cleared:
0132:         out[r, c] = bg
0133: 
0134:     occupied = set()
0135:     for _coords, _target, translated in moves:
0136:         for r, c, _color in translated:
0137:             assert out[r, c] == bg, "translated sprite must land on cleared/background cells"
0138:             assert (r, c) not in occupied, "translated sprites must not overlap"
0139:             occupied.add((r, c))
0140:         for r, c, color in translated:
0141:             out[r, c] = color
0142: 
0143:     return out
