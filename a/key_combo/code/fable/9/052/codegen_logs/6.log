0028: def _nonbg_component8_from(g: np.ndarray, start: tuple[int, int], bg: int) -> set[tuple[int, int]]:
0029:     h, w = g.shape
0030:     st = [start]
0031:     vis = {start}
0032:     while st:
0033:         r, c = st.pop()
0034:         for nr, nc in neighbors8(r, c):
0035:             if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in vis and int(g[nr, nc]) != bg:
0036:                 vis.add((nr, nc))
0037:                 st.append((nr, nc))
0038:     return vis
