0231: def _patch_fits(blocked: np.ndarray, patch: np.ndarray, r0: int, c0: int) -> bool:
0232:     rows, cols = blocked.shape
0233:     h, w = patch.shape
0234:     if r0 < 0 or c0 < 0 or r0 + h > rows or c0 + w > cols:
0235:         return False
0236:     patch_mask = patch != BG_COLOR
0237:     return not bool((blocked[r0 : r0 + h, c0 : c0 + w] & patch_mask).any())
