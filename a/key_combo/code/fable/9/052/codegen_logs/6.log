0155:             r0, c0 = max(0, r - _GEN_PADDING), max(0, c - _GEN_PADDING)
0156:             r1 = min(_GEN_H, r + h + _GEN_PADDING)
0157:             c1 = min(_GEN_W, c + w + _GEN_PADDING)
0158:             if np.any(occupied[r0:r1, c0:c1]):
0159:                 continue
0160: 
0161:             test = occupied.copy()
