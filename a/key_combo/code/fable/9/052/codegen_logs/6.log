0180: def _make_l_sprite(body_color: int, marker_color: int) -> tuple[np.ndarray, tuple[int, int]]:
0181:     v_len, h_len = random.choice(LEG_PAIRS)
0182:     orient = random.randrange(ORIENTATION_COUNT)
0183:     patch = np.zeros((v_len, h_len), dtype=int)
0184: 
0185:     bend_r = 0 if orient in (0, 1) else v_len - 1
0186:     bend_c = 0 if orient in (0, 2) else h_len - 1
0187:     patch[bend_r, :] = body_color
0188:     patch[:, bend_c] = body_color
0189: 
0190:     marker_r = bend_r + (1 if bend_r == 0 else -1)
0191:     marker_c = bend_c + (1 if bend_c == 0 else -1)
0192:     patch[marker_r, marker_c] = marker_color
0193:     return patch, (bend_r, bend_c)
