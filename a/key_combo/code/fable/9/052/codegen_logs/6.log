0155: ORTHO_WEIGHT_ALIGNED = 2           # weight for bias-aligned orthogonal steps
0156: ORTHO_WEIGHT_OTHER = 1             # weight for non-aligned orthogonal steps
0157: BORDER_AVOIDANCE_PROB = 0.85       # probability of skipping border cells
