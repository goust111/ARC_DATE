0173: ) -> list[tuple[int, int, bool]]:
0174:     if needed_edge_touches >= remaining_rects:
0175:         filtered = [pos for pos in positions if pos[2]]
0176:     elif needed_edge_touches <= 0:
0177:         filtered = [pos for pos in positions if not pos[2]]
0178:     elif random.random() < _GEN_EDGE_TOUCH_BIAS:
0179:         filtered = [pos for pos in positions if pos[2]]
0180:     else:
0181:         filtered = positions
0182:     return filtered or positions
