0014: def _seed_pixels(g: np.ndarray, bg: int) -> list[tuple[int, int]]:
0015:     h, w = g.shape
0016:     vals, cnts = np.unique(g, return_counts=True)
0017:     seeds: list[tuple[int, int]] = []
0018:     for v, cnt in zip(vals, cnts):
0019:         v = int(v)
0020:         if v == bg or int(cnt) != 1:
0021:             continue
0022:         r, c = map(int, np.argwhere(g == v)[0])
0023:         if r == 0 or c == 0 or r == h - 1 or c == w - 1:
0024:             seeds.append((r, c))
0025:     return seeds
0026: 
