0041:             continue
0042:         rmax = int(coords[:, 0].max())
0043:         cols = sorted({int(c) for r, c in coords if int(r) == int(rmax)})
0044:         for c in cols:
0045:             sources.append((int(rmax), int(c)))
0046: 
0047:     # shelf segments (from original grid g)
0048:     shelf_segs: list[list[tuple[int, int]]] = [[] for _ in range(H)]
0049:     for r in range(H):
0050:         c = 0
0051:         while c < W:
0052:             if int(g[int(r), int(c)]) != int(shelf):
0053:                 c += 1
0054:                 continue
0055:             c0 = int(c)
0056:             while c + 1 < W and int(g[int(r), int(c + 1)]) == int(shelf):
0057:                 c += 1
0058:             shelf_segs[int(r)].append((int(c0), int(c)))
0059:             c += 1
0060: 
0061:     def find_shelf_seg(r: int, c: int) -> tuple[int, int] | None:
0062:         for a, b in shelf_segs[int(r)]:
0063:             if int(a) <= int(c) <= int(b):
0064:                 return (int(a), int(b))
0065:         return None
0066: 
0067:     def spread_limits(row: int, start_col: int, min_col: int, max_col: int) -> tuple[int, int]:
0068:         """
0069:         Expand horizontally only through contiguous bg cells on the current row.
0070: 
0071:         This prevents water from "jumping" over blockers that sit on the spread row.
0072:         """
0073:         left = int(start_col)
0074:         while left - 1 >= int(min_col) and int(g[int(row), int(left - 1)]) == int(bg):
0075:             left -= 1
