0211: def _blocked_cells(grid: np.ndarray) -> np.ndarray:
0212:     """Return cells where a foreground patch pixel would violate the gap rule."""
0213:     blocked = grid != BG_COLOR
0214:     for _ in range(PLACEMENT_PADDING):
0215:         expanded = blocked.copy()
0216:         expanded[1:, :] |= blocked[:-1, :]
0217:         expanded[:-1, :] |= blocked[1:, :]
0218:         expanded[:, 1:] |= blocked[:, :-1]
0219:         expanded[:, :-1] |= blocked[:, 1:]
0220:         if PLACEMENT_PADDING_CONNECTIVITY == 8:
0221:             expanded[1:, 1:] |= blocked[:-1, :-1]
0222:             expanded[1:, :-1] |= blocked[:-1, 1:]
0223:             expanded[:-1, 1:] |= blocked[1:, :-1]
0224:             expanded[:-1, :-1] |= blocked[1:, 1:]
0225:         elif PLACEMENT_PADDING_CONNECTIVITY != 4:
0226:             raise ValueError("placement padding connectivity must be 4 or 8")
0227:         blocked = expanded
0228:     return blocked
