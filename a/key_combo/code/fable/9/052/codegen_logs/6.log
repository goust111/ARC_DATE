0132: # ========================== CFG ==========================
0133: # Canvas / grid
0134: GRID_H_RANGE = (8, 30)             # grid height bounds
0135: GRID_W_RANGE = (8, 30)             # grid width bounds
0136: BG_COLORS = [0, 5]                 # background color choices
0137: 
0138: # Seeds
0139: SEED_COUNT_WEIGHTS = [1, 2, 2]     # bias toward 2 (2-seed attempts fail more)
0140: MIN_LINE_LEN = 4                   # discard attempt if line shorter than this
0141: LINE_LEN_RANGE = (8, 35)           # target line length bounds (clamped by h+w)
0142: 
0143: # Frame loops
