0197: def _gen_blue_run(g, r, c, dr, dc):
0198:     n = 0
0199:     rr, cc = r + dr, c + dc
0200:     while in_bounds(g.shape, rr, cc) and int(g[rr, cc]) == Color.BLUE:
0201:         n += 1
0202:         rr += dr
0203:         cc += dc
0204:     return n
