0207: def _gen_path_from(start, dr, dc, dist):
0208:     sr, sc = start
0209:     path = [(sr + dr * i, sc + dc * i) for i in range(1, dist)]
0210:     end = (sr + dr * dist, sc + dc * dist)
0211:     return path, end
