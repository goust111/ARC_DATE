0189:     placed: list[tuple[int, int, int, int]] = []
0190:     ordered_dims = sorted(dims, key=lambda x: x[0] * x[1], reverse=True)
0191:     desired_edge_touches = random.randint(_GEN_EDGE_TOUCH_MIN, min(_GEN_EDGE_TOUCH_MAX, len(ordered_dims)))
