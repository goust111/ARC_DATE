0168: def _gen_base_grid(h, w, n_v, n_h):
0169:     rows = _gen_cuts(h, n_h)
0170:     cols = _gen_cuts(w, n_v)
0171:     if rows is None or cols is None:
0172:         return None
0173: 
0174:     g = np.zeros((h, w), dtype=int)
0175:     for c in cols:
0176:         g[:, c] = Color.BLUE
0177:     for r in rows:
0178:         g[r, :] = Color.BLUE
0179: 
0180:     markers = set()
0181:     for c in cols:
0182:         markers.add((0, c))
0183:         markers.add((h - 1, c))
0184:     for r in rows:
0185:         markers.add((r, 0))
0186:         markers.add((r, w - 1))
0187:     for r in rows:
0188:         for c in cols:
0189:             markers.add((r, c))
0190:     for r, c in markers:
0191:         g[r, c] = Color.RED
0192: 
0193:     base_segments = n_v * (n_h + 1) + n_h * (n_v + 1)
0194:     return g, markers, base_segments
0195: 
