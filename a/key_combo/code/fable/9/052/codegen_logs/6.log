0141: def _gen_bounded_counts(total, parts, lo, hi):
0142:     if total < parts * lo or total > parts * hi:
0143:         return None
0144:     counts = [lo] * parts
0145:     extra = total - parts * lo
0146:     while extra:
0147:         avail = [i for i, v in enumerate(counts) if v < hi]
0148:         i = avail[int(np.random.randint(len(avail)))]
0149:         add = int(np.random.randint(1, min(hi - counts[i], extra) + 1))
0150:         counts[i] += add
0151:         extra -= add
0152:     np.random.shuffle(counts)
0153:     return counts
