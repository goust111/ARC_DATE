0215:     for target_i, (target_lo, target_hi) in enumerate(bounds):
0216:         other_max = min(hi for j, (_lo, hi) in enumerate(bounds) if j != target_i)
0217:         for k in range(target_lo, min(target_hi, other_max - 1) + 1):
0218:             options.append((target_i, k))
0219:     if not options:
