0011: 
0012: def _l_bend(body_coords: np.ndarray) -> tuple[int, int]:
0013:     """Return the corner cell where the two one-cell-wide L legs meet."""
0014:     coords = [tuple(map(int, rc)) for rc in body_coords]
0015:     assert coords, "body must contain pixels"
0016:     coord_set = set(coords)
0017:     r0, c0, r1, c1 = bbox_coords(np.array(coords, dtype=int))
0018:     corners = {(r0, c0), (r0, c1), (r1, c0), (r1, c1)}
0019: 
0020:     bends = []
0021:     for r, c in coords:
0022:         if (r, c) not in corners:
0023:             continue
0024:         nbr_dirs = [(dr, dc) for dr, dc in _DIRS4 if (r + dr, c + dc) in coord_set]
0025:         has_vertical = any(dc == 0 for dr, dc in nbr_dirs)
0026:         has_horizontal = any(dr == 0 for dr, dc in nbr_dirs)
0027:         if has_vertical and has_horizontal:
0028:             bends.append((r, c))
0029: 
0030:     assert len(bends) == 1, f"expected one L bend, got {bends}"
0031:     return bends[0]
0032: 
