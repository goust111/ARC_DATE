0156: def _gen_cuts(size, n_lines):
0157:     gaps = _gen_bounded_counts(size - 1, n_lines + 1, CUT_GAP_MIN, CUT_GAP_MAX)
0158:     if gaps is None:
0159:         return None
0160:     cuts = []
0161:     cur = 0
0162:     for gap in gaps[:-1]:
0163:         cur += gap
0164:         cuts.append(cur)
0165:     return cuts
0166: 
