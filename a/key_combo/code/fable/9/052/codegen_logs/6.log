0006: def _components_mask(mask: np.ndarray, conn8: bool) -> list[list[tuple[int, int]]]:
0007:     return [[(int(r), int(c)) for r, c in comp] for comp in components_mask(mask, connectivity=8 if conn8 else 4)]
