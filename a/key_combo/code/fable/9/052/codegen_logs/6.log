0008: def main(grid: np.ndarray) -> np.ndarray:
0009:     """Recolor each isolated blue dot by the majority-colored marker bordering its open region.
0010: 
0011:     Input structure
0012:     - Black is the background.
0013:     - Blue cells form two roles: multi-cell horizontal/vertical wall segments and isolated one-cell dots.
0014:     - Non-blue foreground colors are marker cells sitting on the walls, endpoints, or region corners.
0015: 
0016:     Rule
0017:     - Treat multi-cell blue components and all colored marker cells as barriers.
0018:     - Flood-fill the remaining black cells plus isolated blue dots into 4-connected open regions.
0019:     - For each region containing isolated blue dots, count the distinct colored marker cells that touch
0020:       the region in the 8-neighborhood; recolor every isolated blue dot in that region to the unique
0021:       majority marker color.
0022: 
0023:     Key insight
0024:     - The colored wall/corner markers label compartments by vote; the scattered blue dots are the
0025:       only cells to rewrite, while the blue wall network and marker cells stay fixed.
0026:     """
0027:     g = np.asarray(grid, dtype=int)
0028:     bg = Color.BLACK
0029:     dot_color = Color.BLUE
0030:     assert int(g.max()) <= 9 and int(g.min()) >= 0
0031:     assert bg == int(Counter(map(int, g.ravel())).most_common(1)[0][0])
0032: 
0033:     out = g.copy()
0034:     h, w = g.shape
0035: 
0036:     blue_components = components_mask(g == dot_color, connectivity=4)
0037:     blue_dots = {
0038:         tuple(map(int, comp[0]))
0039:         for comp in blue_components
0040:         if int(comp.shape[0]) == 1
0041:     }
0042:     wall_cells = {
0043:         tuple(map(int, rc))
0044:         for comp in blue_components
0045:         if int(comp.shape[0]) > 1
0046:         for rc in comp
0047:     }
0048:     assert blue_dots
0049:     assert wall_cells
0050: 
0051:     passable = g == bg
0052:     for r, c in blue_dots:
0053:         passable[r, c] = True
0054: 
0055:     seen = np.zeros((h, w), dtype=bool)
0056:     for start_r in range(h):
0057:         for start_c in range(w):
0058:             if not passable[start_r, start_c] or seen[start_r, start_c]:
0059:                 continue
0060: 
0061:             queue = deque([(start_r, start_c)])
0062:             seen[start_r, start_c] = True
0063:             region_dots: list[tuple[int, int]] = []
0064:             adjacent_markers: set[tuple[int, int]] = set()
0065: 
0066:             while queue:
0067:                 r, c = queue.popleft()
0068:                 if (r, c) in blue_dots:
0069:                     region_dots.append((r, c))
0070: 
0071:                 for nr, nc in neighbors4(r, c):
0072:                     if in_bounds(g.shape, nr, nc) and passable[nr, nc] and not seen[nr, nc]:
0073:                         seen[nr, nc] = True
0074:                         queue.append((nr, nc))
0075: 
0076:                 for nr, nc in neighbors8(r, c):
0077:                     if not in_bounds(g.shape, nr, nc):
0078:                         continue
0079:                     color = int(g[nr, nc])
0080:                     if color not in (bg, dot_color):
0081:                         adjacent_markers.add((nr, nc))
0082: 
0083:             if not region_dots:
0084:                 continue
0085: 
0086:             marker_counts = Counter(int(g[r, c]) for r, c in adjacent_markers)
0087:             assert marker_counts
0088:             max_count = max(marker_counts.values())
0089:             winners = [color for color, count in marker_counts.items() if count == max_count]
0090:             assert len(winners) == 1
0091:             fill_color = winners[0]
0092: 
0093:             for r, c in region_dots:
0094:                 out[r, c] = fill_color
0095: 
0096:     return out
