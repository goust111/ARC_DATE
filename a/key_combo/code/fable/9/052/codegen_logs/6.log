0034: def _outer_diagonal_distance(
0035:     anchor: tuple[int, int], marker: tuple[int, int], target: tuple[int, int]
0036: ) -> int:
0037:     """Return distance when target is on the outer 45-degree ray from the L bend."""
0038:     mr = marker[0] - anchor[0]
0039:     mc = marker[1] - anchor[1]
0040:     assert abs(mr) == 1 and abs(mc) == 1, "marker must be diagonally adjacent to L bend"
0041: 
0042:     tr = target[0] - anchor[0]
0043:     tc = target[1] - anchor[1]
0044:     dist = -tr * mr
0045:     assert dist >= 1 and tr == -mr * dist and tc == -mc * dist, (
0046:         "control must lie on the outer 45-degree ray from the L bend"
0047:     )
0048:     return dist
