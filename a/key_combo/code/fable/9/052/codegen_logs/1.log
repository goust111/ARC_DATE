+
+def _expanded_box(
+    box: tuple[int, int, int, int], shape: tuple[int, int], pad: int = 1
+) -> tuple[int, int, int, int]:
+    h, w = shape
+    r0, c0, r1, c1 = box
+    return max(0, r0 - pad), max(0, c0 - pad), min(h - 1, r1 + pad), min(w - 1, c1 + pad)
