+        shape_mask = _random_shape_mask(side_h, side_w)
+        r, c = pos
+        rr, cc = h - side_h - r, w - side_w - c
+        box1 = (r, c, r + side_h - 1, c + side_w - 1)
+        box2 = (rr, cc, rr + side_h - 1, cc + side_w - 1)
