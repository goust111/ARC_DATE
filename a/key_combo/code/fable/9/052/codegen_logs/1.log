+    neutral_set = set(neutral_colors)
+    candidates = []
+    min_oh = OCCLUDER_SIDE_RANGE[0]
+    max_oh = min(OCCLUDER_SIDE_RANGE[1], h - 2)
+    min_ow = OCCLUDER_SIDE_RANGE[0]
+    max_ow = min(OCCLUDER_SIDE_RANGE[1], w - 2)
+    if min_oh > max_oh or min_ow > max_ow:
