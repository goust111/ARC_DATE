+    kinds = ["comp"] * random.randint(3, 5) + ["neutral"] * random.randint(3, 5)
+    while len(kinds) < n_shapes:
+        kinds.append(random.choice(["comp", "neutral"]))
+    random.shuffle(kinds)
+    kinds = kinds[:n_shapes]
