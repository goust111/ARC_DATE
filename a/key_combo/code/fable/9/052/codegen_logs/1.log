    dims: list[tuple[int, int]] = []
    used_area = 0
    used_area6 = 0

    for i in range(n_rects):
        remaining = n_rects - i - 1
        max_area = area_budget - used_area - _GEN_RECT_AREA_MIN * remaining
        candidates = []
