+        for c in range(gw - w + 1):
+            rr, cc = gh - h - r, gw - w - c
+            box1 = (r, c, r + h - 1, c + w - 1)
+            box2 = (rr, cc, rr + h - 1, cc + w - 1)
+            if _boxes_overlap(box1, box2):
+                continue
+            exp1 = _expanded_box(box1, blocked.shape, pad=1)
+            exp2 = _expanded_box(box2, blocked.shape, pad=1)
