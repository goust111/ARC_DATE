+
+import numpy as np
+
+
+ALL_COLORS = tuple(range(10))
+GEN_RETRIES = 400
+PAIR_SHAPE_COUNT = (6, 10)
+SHAPE_SIDE_RANGE = (2, 6)
+GRID_SIDE_RANGE = (15, 24)
