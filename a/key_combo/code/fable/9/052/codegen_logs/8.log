+def _place_droplet(
+    grid: np.ndarray,
+    chamber_cols: list[tuple[int, int]],
+    src_idx: int,
+    volume: int,
+    water_color: int,
+    rng: random.Random,
+) -> np.ndarray | None:
+    out = grid.copy()
+    r0 = _bbox_from_mask(out == WALL)[0]
+    c0, c1 = chamber_cols[src_idx]
+    box_h = r0
+    box_w = c1 - c0 + 1
