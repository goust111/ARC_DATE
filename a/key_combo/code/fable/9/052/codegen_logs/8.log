+    q = deque()
+    for r, c in starts:
+        if 0 <= r < h and 0 <= c < w and passable[r, c] and not out[r, c]:
+            out[r, c] = True
+            q.append((r, c))
+    while q:
+        rr, cc = q.popleft()
+        for nr, nc in _neighbors4(rr, cc):
