+    chamber_hits = 0
+    source_idx = None
+    droplet_cols = np.where(info["droplet_mask"].any(axis=0))[0].tolist()
+    for idx, (c0, c1) in enumerate(chamber_cols):
+        if any(c0 <= c <= c1 for c in droplet_cols):
