+    if not candidates:
+        return None
+    return rng.choice(candidates)
+
+
+def _place_droplet(
+    grid: np.ndarray,
+    chamber_cols: list[tuple[int, int]],
+    src_idx: int,
+    volume: int,
+    water_color: int,
+    rng: random.Random,
