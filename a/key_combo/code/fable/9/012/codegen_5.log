+    return [
+        panel,
+        np.rot90(panel, -1),
+        np.rot90(panel, 2),
+        np.rot90(panel, 1),
+        np.fliplr(panel),
+        np.flipud(panel),
+        panel.T,
+        np.rot90(panel, 2).T,
+    ]
