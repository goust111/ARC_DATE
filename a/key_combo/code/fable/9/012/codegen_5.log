+        probs[1:] = probs[1:] / probs[1:].sum() * (1.0 - probs[0])
+        panel = np.random.choice(palette, size=(size, size), p=probs).astype(int)
+
+        for color in fg_colors:
+            if not np.any(panel == color):
+                r = random.randrange(size)
+                c = random.randrange(size)
+                panel[r, c] = color
