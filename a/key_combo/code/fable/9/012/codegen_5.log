+def _apply_transform(panel: np.ndarray, transform: str) -> np.ndarray:
+    if transform == "mirror_lr":
+        return np.fliplr(panel)
+    if transform == "mirror_ud":
+        return np.flipud(panel)
+    if transform == "rotate_cw":
