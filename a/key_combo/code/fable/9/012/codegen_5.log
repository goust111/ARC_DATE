+    visible_panels[missing_idx][:] = BACKGROUND
+    grid = _render_grid(
+        visible_panels,
+        sequence,
+        separator,
+        transform_to_symbol,
+        left_border,
+        right_border,
+    )
+
+    symbols: list[int | None] = [None]
+    for transform in sequence:
+        symbols.append(transform_to_symbol[transform])
+
