+    marker = np.arange(size * size, dtype=int).reshape(size, size)
+    states = [marker]
+    seen = {marker.tobytes()}
+    for transform in sequence:
+        nxt = _apply_transform(states[-1], transform)
+        key = nxt.tobytes()
+        if key in seen:
+            return None
+        seen.add(key)
+        states.append(nxt)
+    return states
