+            continue
+        a, b = brackets
+        pa, pb = a["pivot"], b["pivot"]
+        if pa[0] == pb[0] or pa[1] == pb[1]:
+            unmatched.extend({"color": color, "coords": x["coords"]} for x in brackets)
+            continue
+        bbox = (min(pa[0], pb[0]), min(pa[1], pb[1]), max(pa[0], pb[0]), max(pa[1], pb[1]))
