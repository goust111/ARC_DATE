+) -> list[dict] | None:
+    blocked = np.zeros((h, w), dtype=bool)
+    for rect in rects:
+        r0, c0, r1, c1 = rect["bbox"]
+        rr0, cc0 = max(0, r0 - 1), max(0, c0 - 1)
+        rr1, cc1 = min(h - 1, r1 + 1), min(w - 1, c1 + 1)
+        blocked[rr0 : rr1 + 1, cc0 : cc1 + 1] = True
