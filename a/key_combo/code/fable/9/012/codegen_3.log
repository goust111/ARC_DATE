+                    "area": area,
+                    "mode": modes[idx],
+                    "diag": random.randint(0, 1),
+                }
+            )
+            areas.add(area)
+            placed = True
+            break
+        if not placed:
+            return None
+    if not _pairwise_overlap(rects):
