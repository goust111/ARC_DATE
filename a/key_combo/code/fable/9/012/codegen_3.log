+    return {
+        "coords": coords,
+        "pivot": pivot,
+        "opening": opening,
+    }
+
+
+def _draw_rectangle(out: np.ndarray, rect: dict) -> None:
+    r0, c0, r1, c1 = rect["bbox"]
+    color = int(rect["color"])
