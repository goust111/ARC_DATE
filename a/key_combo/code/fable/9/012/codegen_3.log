+        for cell in coords:
+            occupied[cell] = bracket["color"]
+    for i, cells_a in enumerate(cell_sets):
+        for cells_b in cell_sets[i + 1 :]:
+            for r1, c1 in cells_a:
+                for r2, c2 in cells_b:
+                    if max(abs(r1 - r2), abs(c1 - c2)) <= 1:
+                        return False
