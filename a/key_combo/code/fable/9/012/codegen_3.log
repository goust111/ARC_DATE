+    for bracket in brackets:
+        coords = [tuple(map(int, p)) for p in bracket["coords"]]
+        for r, c in coords:
+            if not (0 <= r < h and 0 <= c < w):
+                return False
+            if (r, c) in occupied:
+                return False
+        cell_sets.append(set(coords))
+        for cell in coords:
+            occupied[cell] = bracket["color"]
