+def _render_in_order(shape: tuple[int, int], rects: list[dict], unmatched: list[dict], bg: int) -> np.ndarray:
+    out = np.full(shape, int(bg), dtype=int)
+    for rect in rects:
+        _draw_rectangle(out, rect)
