+        elif (
+            a["opening"] == CORNER_TO_OPENING[corner_a]["hollow"]
+            and b["opening"] == CORNER_TO_OPENING[corner_b]["hollow"]
+        ):
+            mode = "hollow"
+        else:
+            unmatched.extend({"color": color, "coords": x["coords"]} for x in brackets)
+            continue
