+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    rects, unmatched, bg = _extract_scene(g)
+    return _render_scene(g.shape, rects, unmatched, bg)
+
+
+def _bbox_contains(a: BBox, b: BBox) -> bool:
+    return a[0] <= b[0] and a[1] <= b[1] and a[2] >= b[2] and a[3] >= b[3]
+
