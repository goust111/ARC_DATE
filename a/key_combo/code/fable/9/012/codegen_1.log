+def sample_fill_counts(capacities: list[int]) -> list[int]:
+    count = len(capacities)
+    indices = list(range(count))
+    random.shuffle(indices)
+    fills = [0] * count
+
+    partial_idx = indices[0]
+    fills[partial_idx] = random.randint(1, capacities[partial_idx] - 1)
