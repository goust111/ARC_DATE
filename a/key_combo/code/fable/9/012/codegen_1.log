+    specs = []
+    y = top_margin
+    for row, gaps, row_h, row_w in zip(rows, horizontal_gaps, row_heights, row_widths):
+        extra = width - left_margin - right_margin - row_w
+        row_x = left_margin + random.randint(0, max(0, extra))
+        x = row_x
