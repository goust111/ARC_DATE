+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_ATTEMPTS):
+        grid = build_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid container-spiral task")

