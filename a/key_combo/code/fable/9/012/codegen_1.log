+    outside_bbox = np.ones_like(grid, dtype=bool)
+    for r0, c0, r1, c1 in all_bboxes:
+        outside_bbox[r0 : r1 + 1, c0 : c1 + 1] = False
+    outside_fg = np.argwhere((grid != bg) & outside_bbox)
