+    cells = [(r, c) for r in range(box_h) for c in range(box_w)]
+    random.shuffle(cells)
+    seeds: list[tuple[int, int]] = []
+    for cell in cells:
+        if all(abs(cell[0] - r) + abs(cell[1] - c) > 1 for r, c in seeds):
+            seeds.append(cell)
+            if len(seeds) == n_comp:
