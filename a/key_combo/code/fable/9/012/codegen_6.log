0037: def main(grid: np.ndarray) -> np.ndarray:
0038:     """Crop the large object and recolor its marked colors using the isolated two-pixel legends.
0039: 
0040:     Input structure
0041:     - A dominant background separates one solid rectangular multicolor target object
0042:       from one or more isolated horizontal two-pixel legend dominos.
0043:     - In each legend domino, the right color appears in the target and the left
0044:       color is absent from the unrecolored target.
0045: 
0046:     Rule
0047:     - Output the bbox crop of the target object only.
0048:     - Read every legend domino left-to-right as replacement color, source color.
0049:     - In the crop, replace all pixels of each source color with its legend
0050:       replacement and preserve the one target base color.
0051: 
0052:     Key insight
0053:     - The small dominos are a color-substitution key; their positions are
0054:       irrelevant once each right-hand color is matched to pixels inside the large
0055:       target object.
0056:     """
0057:     g = np.asarray(grid, dtype=int)
0058:     assert g.ndim == 2
0059: 
0060:     bg = get_bg(g)
0061:     target, mapping = _target_and_legend(g, bg)
0062:     crop = crop_bbox(g, target["bbox"])
0063: 
0064:     out = crop.copy()
0065:     for source, replacement in mapping.items():
0066:         out[crop == source] = replacement
0067:     return out
0068: 
