0089: def _gen_grow_blob(free: np.ndarray, size: int) -> list[tuple[int, int]] | None:
0090:     starts = np.argwhere(free)
0091:     if starts.size == 0:
0092:         return None
0093: 
0094:     r, c = random.choice(starts).tolist()
0095:     coords = [(int(r), int(c))]
0096:     used = {(int(r), int(c))}
0097:     free[int(r), int(c)] = False
0098: 
0099:     while len(coords) < size:
0100:         frontier = []
0101:         for rr, cc in coords:
0102:             for dr, dc in BLOB_NEIGHBOR_OFFSETS:
0103:                 nr, nc = rr + dr, cc + dc
0104:                 if 0 <= nr < free.shape[0] and 0 <= nc < free.shape[1] and free[nr, nc] and (nr, nc) not in used:
0105:                     frontier.append((nr, nc))
0106:         if not frontier:
0107:             return None
0108:         nr, nc = random.choice(frontier)
0109:         coords.append((nr, nc))
0110:         used.add((nr, nc))
0111:         free[nr, nc] = False
0112: 
0113:     return coords
