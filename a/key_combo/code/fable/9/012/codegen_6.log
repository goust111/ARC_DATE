0084: def _gen_blob_size_options(area: int, n_blobs: int) -> list[tuple[int, ...]]:
0085:     min_base, max_base = BASE_FRACTION_BOUNDS
0086:     return [tuple(sizes) for sizes in product(BLOB_CELL_COUNTS, repeat=n_blobs) if min_base <= (area - sum(sizes)) / area <= max_base]
