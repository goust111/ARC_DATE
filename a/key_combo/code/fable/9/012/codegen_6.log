+def _bands(indices: np.ndarray) -> list[tuple[int, int]]:
+    values = [int(v) for v in indices]
+    if not values:
+        return []
+    out: list[tuple[int, int]] = []
+    start = prev = values[0]
+    for value in values[1:]:
+        if value == prev + 1:
+            prev = value
+            continue
+        out.append((start, prev))
+        start = prev = value
+    out.append((start, prev))
+    return out
