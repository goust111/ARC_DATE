+        panel = np.full((panel_h, panel_w), bases[idx], dtype=int)
+        panel[placed_hole] = 0
+        key_color_count = random.randint(1, min(3, len(key_palette)))
+        key_colors = random.sample(key_palette, k=key_color_count)
+        _paint_key(panel, placed_key, key_colors)
+        panels.append(panel)
