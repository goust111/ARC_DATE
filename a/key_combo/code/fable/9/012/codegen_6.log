+        panel_w=panel_w,
+        sep_color=sep_color,
+        sep_h=sep_h,
+        sep_w=sep_w,
+    )
+    if not _validate_semantics(inp, out, perm, positions):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid panel-key input")

