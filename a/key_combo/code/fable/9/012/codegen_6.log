+
+def _sample_derangement(count: int, positions: list[tuple[int, int]]) -> list[int] | None:
+    values = list(range(count))
+    for _ in range(300):
+        perm = values[:]
+        random.shuffle(perm)
+        if any(i == perm[i] for i in values):
+            continue
+        if not any(_is_nonlocal(i, perm[i], positions) for i in values):
