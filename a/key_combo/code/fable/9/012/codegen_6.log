0077: 
0078:     h, w = bg.shape
0079:     seen = np.zeros_like(bg, dtype=bool)
0080:     stack = []
0081:     for r in range(h):
0082:         for c in (0, w - 1):
0083:             if bg[r, c] and not seen[r, c]:
0084:                 seen[r, c] = True
0085:                 stack.append((r, c))
