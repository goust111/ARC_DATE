0014: def main(input_grid):
0015:     """
0016:     Crop the red object and fit each multicolor puzzle piece into its matching red-shaped hole.
0017: 
0018:     Input structure:
0019:     - The input contains one fully red object with black holes.
0020:     - It also contains several multicolor puzzle pieces on the black background.
0021:     - Puzzle pieces may include red cells that act as the hole-fitting stencil.
0022: 
0023:     Rule:
0024:     - Crop the red object to form the output canvas.
0025:     - Sort puzzle pieces by the number of red cells so larger stencils are placed first.
0026:     - Try rotations and translations, placing each piece where its red cells land only on black holes.
0027: 
0028:     Key insight:
0029:     - Red cells inside a piece are not paint for the red object; they are the stencil that tells
0030:       which hole shape the piece can occupy.
0031:     """
0032:     # Plan:
0033:     # 1. Detect the object, separating the puzzle pieces from the red object with holes
0034:     # 2. Crop to just the red object
0035:     # 3. Put each puzzle piece so that its red pixels perfectly overlay holes in the red object (considering translations and rotations)
0036: 
0037:     # 1. Separate puzzle pieces from the red object (remembering that puzzle pieces might have some red in them also: they are not monochromatic---but the red thing is fully red)
0038:     objects = find_components(input_grid, bg=Color.BLACK, connectivity=8, monochromatic=False, return_format="objects")
0039:     red_objects = [ obj for obj in objects if set(colors_present(obj, exclude={ Color.BLACK })) == {Color.RED} ]
0040:     puzzle_pieces = [ obj for obj in objects if set(colors_present(obj, exclude={ Color.BLACK })) != {Color.RED} ]
0041: 
0042:     assert len(red_objects) == 1, "There should be exactly one fully red object"
0043:     red_object = red_objects[0]
0044: 
0045:     # 2. The output begins by cropping to just the red object
0046:     _b = bbox(red_object != Color.BLACK)
0047:     assert _b is not None
0048:     output_grid = crop_bbox(red_object, _b)
0049: 
0050:     # 3. Put each puzzle piece so that its red pixels perfectly overlay holes in the red object
0051:     # Put in the pieces which have the most red first (otherwise a small puzzle piece might go in a big hole)
0052:     puzzle_pieces.sort(key=lambda piece: np.sum(piece == Color.RED), reverse=True)
0053: 
0054:     for puzzle_piece in puzzle_pieces:
0055:         # Extract just the sprite of this piece, and then figure out where it should go, including its position and rotation
