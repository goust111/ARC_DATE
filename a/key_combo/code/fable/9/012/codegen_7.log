+    for c in range(grid.shape[1]):
+        rows = np.flatnonzero(grid[:, c] == fg)
+        cols.append(len(rows) > 0 and int(rows[0]) == 0 and int(rows[-1]) == grid.shape[0] - 1)
+    return np.array(cols, dtype=bool)
