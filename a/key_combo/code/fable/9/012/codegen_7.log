+def _count_background_bands(separator_mask: np.ndarray) -> int:
+    bands = 0
+    inside = False
+    for is_separator in separator_mask:
+        if is_separator:
+            inside = False
+        elif not inside:
+            bands += 1
+            inside = True
+    return bands
