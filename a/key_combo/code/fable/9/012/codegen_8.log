+def _generate_attempt() -> np.ndarray | None:
+    height = random.randint(18, 26)
+    width = random.randint(18, 28)
+
+    down_h = random.randint(4, 6)
+    down_w = random.randint(4, 6)
+    up_h = random.randint(4, 6)
