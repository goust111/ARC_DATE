+def _draw_selector(
+    grid: np.ndarray,
+    bbox: BBox,
+    orientation: str,
+    color: int,
+    marker_color: int,
+) -> tuple[set[Coord], Coord]:
+    cells = _bracket_shape(bbox, orientation)
+    for r, c in cells:
+        grid[r, c] = color
+    r0, c0, r1, c1 = bbox
+    interior = [
+        (r, c)
+        for r in range(r0, r1 + 1)
+        for c in range(c0 + 1, c1)
+        if (r, c) not in cells
+    ]
+    marker = random.choice(interior)
+    grid[marker] = marker_color
