+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+Coord = tuple[int, int]
+BBox = tuple[int, int, int, int]
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+PALETTE = tuple(range(1, 10))
+BG = 0
+MAX_GEN_ATTEMPTS = 400
