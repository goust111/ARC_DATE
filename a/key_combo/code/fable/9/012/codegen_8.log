+    if not _validate_instance(grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GEN_ATTEMPTS):
+        grid = _generate_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError(f"generate_input: failed after {MAX_GEN_ATTEMPTS} attempts")

