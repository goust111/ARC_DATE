+    bg = _most_common(grid[grid != sep])
+    legend_c = col_bands[legend_id][0]
+    legend_order = [
+        int(grid[r, legend_c])
+        for r in range(grid.shape[0])
+        if int(grid[r, legend_c]) not in (bg, sep)
