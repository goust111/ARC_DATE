spec:
  grid: 15x15, bg=0
  bracket:
    shape: L-shaped corner bracket (bottom-right corner orientation), 4x4 bbox at rows 0-3, cols 0-3
    color: 5
    cells: right column (col 3, rows 0-3) + bottom row (row 3, cols 0-3) = 7 cells
    interior: 3x3 region rows 0-2, cols 0-2; all bg except the marker
  marker:
    position: (1,1), always inside bracket interior
    color: any color 1-9 except 5 (bracket color)
  scatter:
    region: outside bracket bbox (r>=4 or c>=4)
    total_pixels: 16-32
    distinct_colors: 8 [observed]; at least the marker color + several others
    colors_used: mostly from 1-9; bracket color (5) may rarely appear [observed]
