+# --------------- generator ---------------
+
+BACKGROUND = 0
+LEGEND_WIDTH = 1
+SEPARATOR_WIDTH = 1
+LAYOUTS = ((2, 2), (1, 4), (4, 1), (2, 3), (3, 2))
+LEGEND_SIDES = ("left", "right")
+MIN_VISIBLE_CELLS = 3
+MAX_VISIBLE_CELLS = 7
+MIN_FILL_RATIO = 0.35
+MAX_FILL_RATIO = 0.58
+MAX_ATTEMPTS = 500
