  grid:
    separator_bars: 3 row bars always at rows 4,9,14; 2-4 column bars at cols 4,9,14,19 (spacing 5)
    cell_structure: bars divide grid into 4 row-spans x 3-5 col-spans; first spans are 4-wide, trailing span may be a 1-3 wide stub
    grid_size: height 16 or 19; width 13-21; determined by bar count + trailing stub
  separator_color: one unique non-bg color forming all full-row and full-column bars
  cells:
    usable: cells with height>=3 AND width>=3 (stubs <=2 wide are always empty)
    sprites: each usable cell contains exactly one solid 2x2 square at local position (1,1); no usable cell is empty [observed]
    colors: 3-5 distinct non-bg sprite colors including separator color
