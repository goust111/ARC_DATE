+            sprite_w = random.randint(1, max(1, cell_w - 2))
+            top = random.randint(r0, r1 - sprite_h)
+            left = random.randint(c0, c1 - sprite_w)
+            grid[top : top + sprite_h, left : left + sprite_w] = color
