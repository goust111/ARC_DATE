+    mask = np.asarray(mask, dtype=bool)
+    spans: list[tuple[int, int]] = []
+    start = None
+    for idx, is_bar in enumerate(mask.tolist()):
+        if is_bar:
+            if start is not None:
+                spans.append((start, idx))
