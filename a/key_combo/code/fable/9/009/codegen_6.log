+    if np.array_equal(inp, expected):
+        return False
+    if len(objects) != len(pair_specs) * 2 + len(distractors):
+        return False
+    return True
+
+
+def gen_pair_spec(
+    rng: random.Random,
+    shape: tuple[int, int],
+    reserved: set[tuple[int, int]],
+    small_color: int,
+    large_color: int,
