+    intended_pairs = {
+        frozenset((int(spec["small_color"]), int(spec["large_color"])))
+        for spec in pair_specs
+    }
+    seen_pairs = {
+        frozenset((int(m["small"]["color"]), int(m["large"]["color"])))
+        for m in matches
+    }
+    if seen_pairs != intended_pairs:
+        return False
