+def all_matches(grid: np.ndarray, objects: list[dict]) -> list[dict]:
+    out = []
+    for i, small in enumerate(objects):
+        for j, large in enumerate(objects):
+            if i == j:
+                continue
+            out.extend(match_candidates(grid.shape, small, large))
+    return out
