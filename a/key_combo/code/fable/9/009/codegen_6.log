+    out = set()
+    for r, c in coords:
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                nr, nc = r + dr, c + dc
+                if 0 <= nr < shape[0] and 0 <= nc < shape[1]:
+                    out.add((int(nr), int(nc)))
