+    pair_specs = []
+    color_idx = 0
+    for i in range(pair_count):
+        spec = gen_pair_spec(
+            rng,
+            (h, w),
+            reserved,
+            colors[color_idx],
+            colors[color_idx + 1],
+            factors[i],
+            clip_flags[i],
