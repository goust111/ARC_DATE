+        if padded(coords, shape) & reserved:
+            continue
+        return {"mask": mask, "top": int(top), "left": int(left), "color": int(color), "reserved_union": coords}
+    return None
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    h = rng.randint(20, 28)
+    w = rng.randint(20, 28)
