+    if len(colors) < pair_count * 2 + distractor_count:
+        return None
+
+    reserved: set[tuple[int, int]] = set()
+    pair_specs = []
+    color_idx = 0
+    for i in range(pair_count):
+        spec = gen_pair_spec(
+            rng,
+            (h, w),
+            reserved,
+            colors[color_idx],
+            colors[color_idx + 1],
+            factors[i],
+            clip_flags[i],
