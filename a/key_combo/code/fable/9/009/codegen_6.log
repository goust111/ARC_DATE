+def gen_distractor(
+    rng: random.Random,
+    shape: tuple[int, int],
+    reserved: set[tuple[int, int]],
+    color: int,
+) -> dict | None:
+    for _ in range(80):
+        h = rng.randint(2, 5)
+        w = rng.randint(2, 5)
