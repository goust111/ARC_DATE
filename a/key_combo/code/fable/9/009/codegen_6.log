+    if shape[0] < full_h + 2 or shape[1] < full_w + 2:
+        return None
+
+    for _ in range(120):
+        out_large_top = rng.randint(0, shape[0] - full_h)
+        out_large_left = rng.randint(0, shape[1] - full_w)
+        small_top = out_large_top + delta_r
+        small_left = out_large_left + delta_c
