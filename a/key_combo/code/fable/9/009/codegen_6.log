0106: def main(grid: np.ndarray) -> np.ndarray:
0107:     """
0108:     Complete every colored fragment into a translated copy of the unique largest foreground template.
0109: 
0110:     Input structure
0111:     - A uniform background contains one complete monochromatic template mask and smaller same-orientation fragments in other colors.
0112:     - A color may contain more than one separated fragment; each fragment has at least two pixels.
0113:     - All completed copies fit inside the grid and do not overlap other foreground pixels.
0114: 
0115:     Rule
0116:     - Use the unique foreground color with the most pixels as the template mask.
0117:     - For each other color, find the unique minimum set of translated template placements whose existing template cells cover that color's input pixels.
0118:     - Paint every cell of those placements with that color, leaving the template and background otherwise unchanged.
0119: 
0120:     Key insight
0121:     The incomplete colors are partial masks of the same template; their existing pixels act as anchors that determine where the missing cells must be filled.
0122:     """
0123:     g = np.asarray(grid, dtype=int)
0124:     bg = int(get_bg(g))
0125:     colors = [int(color) for color in np.unique(g) if int(color) != bg]
0126:     assert colors, "expected foreground colors"
0127: 
0128:     counts = {color: int(np.count_nonzero(g == color)) for color in colors}
0129:     template_area = max(counts.values())
0130:     template_colors = [color for color, area in counts.items() if area == template_area]
0131:     assert len(template_colors) == 1, "largest foreground template color must be unique"
