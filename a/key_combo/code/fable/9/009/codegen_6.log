+                if bbox == large_bbox and np.array_equal(cropped, large_mask):
+                    placements.append((int(top), int(left)))
+        if len(placements) == 1:
+            top, left = placements[0]
+            out.append(
+                {
+                    "small": small,
+                    "large": large,
+                    "factor": int(factor),
+                    "large_full_bbox": (top, left, top + fh - 1, left + fw - 1),
