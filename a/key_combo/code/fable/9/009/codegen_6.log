+def gen_pair_spec(
+    rng: random.Random,
+    shape: tuple[int, int],
+    reserved: set[tuple[int, int]],
+    small_color: int,
+    large_color: int,
+    factor: int,
+    must_clip: bool,
+) -> dict | None:
+    if factor == 2:
