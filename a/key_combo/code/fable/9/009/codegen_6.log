+        tops = axis_candidates(large_bbox[0], large_bbox[2], fh, grid_shape[0])
+        lefts = axis_candidates(large_bbox[1], large_bbox[3], fw, grid_shape[1])
+        for top in tops:
+            for left in lefts:
