+
+    placements: list[Coord] = []
+    placed_sets: list[set[Coord]] = []
+    for _ in range(300):
+        placements.clear()
+        placed_sets.clear()
+        for _copy_idx in range(count):
+            candidates = []
+            for top in range(1, H - h):
+                for left in range(1, W - w):
+                    shifted = _shift_coords(template, top, left)
+                    if not _fits(shifted, H, W):
