    no_notch_objects: slide left to left grid edge, recolor red (2)
    row_span preserved; shape preserved; output starts from blank bg canvas
    no overlap after sliding (guaranteed by non-overlapping row spans)

generation_strategy:
  approach: output-first
  steps:
