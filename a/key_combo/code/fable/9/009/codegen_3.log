+
+def _is_connected(coords: Iterable[Coord]) -> bool:
+    pts = {(int(r), int(c)) for r, c in coords}
+    if not pts:
+        return False
+    todo = [next(iter(pts))]
+    seen = {todo[0]}
+    while todo:
+        r, c = todo.pop()
+        for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+            if (nr, nc) in pts and (nr, nc) not in seen:
