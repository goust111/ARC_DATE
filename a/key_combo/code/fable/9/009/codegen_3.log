+    return grid
+
+
+def _validate_generated_instance(
+    inp: np.ndarray,
+    template: set[Coord],
+    subsets: list[set[Coord]],
+    colors: list[int],
+    placements: list[Coord],
+    bg: int,
+) -> bool:
+    expected = _expected_output(inp.shape[0], inp.shape[1], bg, colors, placements, template)
+    try:
+        solved = main(inp)
+    except Exception:
+        return False
+    if not np.array_equal(solved, expected):
