+
+
+def _random_missing_sets(extra_cells: list[Coord], k: int) -> list[set[Coord]] | None:
+    upper = min(MISSING_PER_COPY_RANGE[1], len(extra_cells))
+    if upper < 1:
+        return None
+
+    for _ in range(120):
