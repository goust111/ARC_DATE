DIRECTION_STEPS = {'above': (-1, 0), 'below': (1, 0), 'left': (0, -1), 'right': (0, 1)}
VERTICAL_DIRECTIONS = ('above', 'below')
TIP_GAP_MIN, TIP_GAP_MAX = 1, 2

# Object area and growth bounds.
WINNER_AREA_MIN, WINNER_AREA_MAX = 8, 22
LOSER_AREA_MIN = 3
