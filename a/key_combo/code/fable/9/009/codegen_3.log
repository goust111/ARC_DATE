+        or np.array_equal(mask, np.fliplr(mask))
+        or (mask.shape[0] == mask.shape[1] and np.array_equal(mask, mask.T))
+        or (mask.shape[0] == mask.shape[1] and np.array_equal(mask, np.rot90(mask)))
