+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                if (r + dr, c + dc) in b:
+                    return True
+    return False
+
+
+def _place_templates(template: set[Coord], count: int, H: int, W: int) -> list[Coord] | None:
+    r0, c0, r1, c1 = _bbox(template)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h + 2 > H or w + 2 > W:
