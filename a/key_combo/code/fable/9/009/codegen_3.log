+                        continue
+                    candidates.append((top, left, shifted))
+            if not candidates:
+                break
+            top, left, shifted = random.choice(candidates)
+            placements.append((top, left))
+            placed_sets.append(shifted)
+        if len(placements) == count:
+            return placements
+    return None
+
+
+def _build_grid(
+    H: int,
+    W: int,
+    bg: int,
