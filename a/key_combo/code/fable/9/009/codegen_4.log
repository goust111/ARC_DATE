    return not any(len(lc) >= len(winner_coords) for lc in loser_coords_list)


def _points_fit_canvas(points: list[tuple[int, int]], cap: list[tuple[int, int]]) -> bool:
    if not all(0 <= r < GRID_H and 0 <= c < GRID_W for r, c in points):
