                if r == height - 1:
                    touched_borders.add("bottom")
                if c == 0:
                    touched_borders.add("left")
                if c == width - 1:
                    touched_borders.add("right")
        elif degree == 3:
            degree3 += 1
        elif degree == 4:
            degree4 += 1
    return endpoints, border_endpoints, len(touched_borders), degree3, degree4


