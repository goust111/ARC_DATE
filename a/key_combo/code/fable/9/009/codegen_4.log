    border_endpoints = 0
    degree3 = 0
    degree4 = 0
    touched_borders = set()
    height, width = grid.shape
    for r, c in np.argwhere(grid == color):
        degree = 0
        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
            rr = r + dr
            cc = c + dc
            if 0 <= rr < height and 0 <= cc < width and grid[rr, cc] == color:
                degree += 1
