+    max_r = max(r for r, _ in carved_shifted)
+    max_c = max(c for _, c in carved_shifted)
+    shell_h = max_r + 2
+    shell_w = max_c + 2
+    if shell_h > 24 or shell_w > 24:
+        return None
+
+    margin_top = random.randint(1, 3)
+    margin_left = random.randint(1, 3)
+    margin_bottom = random.randint(1, 3)
+    margin_right = random.randint(1, 3)
+    grid_h = shell_h + margin_top + margin_bottom
+    grid_w = shell_w + margin_left + margin_right
+    if grid_h > GRID_LIMIT or grid_w > GRID_LIMIT:
+        return None
+
+    return {
+        "orientation": orientation,
+        "rooms": shifted_rooms,
+        "reservoir": shifted_res,
+        "corridor": shifted_corridor,
+        "capacity": capacity,
+        "partial_idx": partial_idx,
+        "partial_rows": rows,
+        "grid_shape": (grid_h, grid_w),
+        "shell_offset": (margin_top, margin_left),
+        "shell_shape": (shell_h, shell_w),
+    }
+
+
+def _render_instance(layout: dict) -> tuple[np.ndarray, np.ndarray]:
