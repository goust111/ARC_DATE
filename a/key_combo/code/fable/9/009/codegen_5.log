+            if (
+                int(grid[r0 - 1, c0 - 1]) != wall
+                or int(grid[r0 - 1, c1 + 1]) != wall
+                or int(grid[r1 + 1, c0 - 1]) != wall
+                or int(grid[r1 + 1, c1 + 1]) != wall
