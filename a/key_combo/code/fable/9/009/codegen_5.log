+def _find_rooms(grid: np.ndarray, bg: int, wall: int) -> list[tuple[int, int, int, int]]:
+    h, w = grid.shape
+    rooms: list[tuple[int, int, int, int]] = []
+    seen: set[tuple[int, int, int, int]] = set()
