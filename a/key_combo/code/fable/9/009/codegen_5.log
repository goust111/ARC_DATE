+def _make_room(r0: int, c0: int, inner_h: int, inner_w: int) -> dict:
+    return {
+        "outer": (r0, c0, r0 + inner_h + 1, c0 + inner_w + 1),
+        "inner": (r0 + 1, c0 + 1, r0 + inner_h, c0 + inner_w),
+        "h": inner_h,
+        "w": inner_w,
+    }
