+        "rooms": shifted_rooms,
+        "reservoir": shifted_res,
+        "corridor": shifted_corridor,
+        "capacity": capacity,
+        "partial_idx": partial_idx,
+        "partial_rows": rows,
+        "grid_shape": (grid_h, grid_w),
+        "shell_offset": (margin_top, margin_left),
+        "shell_shape": (shell_h, shell_w),
