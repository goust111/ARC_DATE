+    dim_options = []
+    for grid_h in range(shell_h + 2, GRID_LIMIT + 1):
+        for grid_w in range(shell_w + 2, GRID_LIMIT + 1):
+            if grid_h * grid_w >= min_total_area:
+                dim_options.append((grid_h, grid_w))
