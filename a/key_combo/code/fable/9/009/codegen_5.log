+            top = _side_gap_count(grid[r0 - 1, c0 : c1 + 1], bg, wall)
+            bottom = _side_gap_count(grid[r1 + 1, c0 : c1 + 1], bg, wall)
+            left = _side_gap_count(grid[r0 : r1 + 1, c0 - 1], bg, wall)
+            right = _side_gap_count(grid[r0 : r1 + 1, c1 + 1], bg, wall)
