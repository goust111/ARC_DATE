+            if not np.all(room[split:, :] == water):
+                return False
+            if not np.all(room[:split, :] == bg):
+                return False
+        else:
+            if not np.all(room == bg):
+                return False
+
+    return set(map(int, grid.ravel())) == {bg, wall, water}
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
