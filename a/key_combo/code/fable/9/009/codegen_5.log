+def _multi_source_bfs(passable: np.ndarray, sources: list[tuple[int, int]]) -> np.ndarray:
+    h, w = passable.shape
+    dist = np.full((h, w), -1, dtype=int)
+    q = deque()
+    for r, c in sources:
+        dist[r, c] = 0
+        q.append((r, c))
+    while q:
+        r, c = q.popleft()
+        nd = int(dist[r, c]) + 1
+        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+            nr = r + dr
+            nc = c + dc
+            if 0 <= nr < h and 0 <= nc < w and passable[nr, nc] and dist[nr, nc] < 0:
+                dist[nr, nc] = nd
+                q.append((nr, nc))
+    return dist
