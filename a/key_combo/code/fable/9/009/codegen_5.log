+        start = _door(a, "east")
+        end = _door(b, "west")
+        if start[0] == end[0]:
+            return _segment(start, end)
+        bend_c = random.randint(start[1] + 1, end[1] - 1)
+        cells = _segment(start, (start[0], bend_c))
+        cells += _segment((start[0] + (1 if end[0] > start[0] else -1), bend_c), (end[0], bend_c))
+        cells += _segment((end[0], bend_c), end)
