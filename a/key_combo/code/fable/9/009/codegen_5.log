+    if set(found_rooms) != set(
+        (
+            layout["shell_offset"][0] + r0,
+            layout["shell_offset"][1] + c0,
+            layout["shell_offset"][0] + r1,
+            layout["shell_offset"][1] + c1,
+        )
+        for r0, c0, r1, c1 in rooms
