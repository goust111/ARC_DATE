+    dist = np.full((h, w), -1, dtype=int)
+    q = deque()
+    for r, c in sources:
+        dist[r, c] = 0
+        q.append((r, c))
+    while q:
+        r, c = q.popleft()
+        nd = int(dist[r, c]) + 1
+        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+            nr = r + dr
+            nc = c + dc
