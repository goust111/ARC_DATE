+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+Coord = tuple[int, int]
+
+BG = 0
+PALETTE = [1, 2, 3, 4, 5, 6, 7, 8, 9]
+GEN_RETRIES = 400
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _neighbors8(r: int, c: int):
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            yield r + dr, c + dc
+
+
+def _components(mask: np.ndarray, connectivity: int) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[Coord] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                neigh = _neighbors4 if connectivity == 4 else _neighbors8
+                for nr, nc in neigh(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _background_components(occupied: np.ndarray) -> tuple[list[np.ndarray], np.ndarray]:
+    h, w = occupied.shape
+    seen = np.zeros_like(occupied, dtype=bool)
+    holes: list[np.ndarray] = []
+    exterior = np.zeros_like(occupied, dtype=bool)
+
+    for r in range(h):
+        for c in range(w):
+            if occupied[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[Coord] = []
+            touches_border = r in (0, h - 1) or c in (0, w - 1)
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not occupied[nr, nc] and not seen[nr, nc]:
