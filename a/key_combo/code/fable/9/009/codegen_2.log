+    right = np.full((h, w), BG, dtype=int)
+
+    if hole_count >= 2 and rng.random() < 0.7:
+        owners = ["left", "right"]
+        while len(owners) < hole_count:
+            owners.append(rng.choice(["left", "right"]))
+        rng.shuffle(owners)
+    else:
