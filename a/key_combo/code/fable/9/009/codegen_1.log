        bc = tip[1] + step_c * layer
        for side in [1, -1]:
            if remaining <= 0:
                break
            ext = prev_hw + 1
            p = _perp_coord(direction, br, bc, side * ext)
            coords.append(p)
            remaining -= 1

    return coords if len(coords) >= OBJECT_AREA_MIN else None


