GEN_SIDE_EXTENSION_RANGE, GEN_T_EXTENSION_RANGE = (3, 9), (4, 9)
GEN_EDGE_EXTENSION_MIN, GEN_VERTICAL_ENDPOINT_MARGIN = 1, 1

