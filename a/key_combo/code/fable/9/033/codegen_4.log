+    patches = []
+    for spec in chain_specs:
+        patch = _chain_patch(
+            spec["length"],
+            spec["stop_kind"],
+            spec["size"],
+            spec["ray_gap"],
+            spec["deltas"],
+            spec["tail_steps"],
+            spec["colors"],
