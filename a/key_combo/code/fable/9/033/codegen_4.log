  "src": "right-edge horizontal runs of the moving color, one run per occupied row",
  "path": "left along the same row through background cells, stopping immediately to the right of the nearest fixed barrier pixel or at the left edge if no barrier is present",
  "trajectory": "translate each whole run horizontally, preserving its length and color; rows are independent",
  "transform": "clear each run's original right-edge cells; keep fixed barrier pixels and rows without moving runs unchanged"
}
</annotation>
<generation_spec>
