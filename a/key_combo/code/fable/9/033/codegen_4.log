+def _sample_chain_specs() -> tuple[list[dict], int]:
+    chain_counts = [2, 3]
+    chain_count = random.choice(chain_counts)
+    if chain_count == 2:
+        lengths = random.choice([[1, 2], [2, 2], [1, 3]])
+    else:
+        lengths = random.choice([[1, 1, 2], [1, 2, 2]])
