+
+    if not np.array_equal(main(grid), out):
+        return None
+
+    meta = {"traces": traces}
+    return grid, meta
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(500):
+        result = _generate_attempt()
+        if result is not None:
+            return result[0]
+    raise RuntimeError("failed to generate a valid ray-push momentum puzzle")
