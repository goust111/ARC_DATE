spec:
  grid: odd square, side length 5-15
  background: single dominant color (always 8 in eval) [observed]
  markers:
    count: exactly 4, one per corner orientation (TL, TR, BL, BR)
    shape: 3-pixel L in a 2x2 bounding box (one cell of the 2x2 is empty)
    orientation: the missing-cell position encodes the corner (e.g. missing bottom-right -> top_left)
    colors: 3-4 distinct non-bg colors; one color MAY be reused for two markers
    placement: anywhere on grid; marker pixels must not overlap each other (bbox overlap OK)
  output:
    grid cleared to bg
    each corner gets an L-shaped border drawn in the marker color whose orientation matches
    arm_length: grid_side // 2 (includes the corner pixel)
