+        slide_distance = (width - run_len) - final_run[0]
+        return {
+            "branch": branch,
+            "row": row,
+            "output": output,
+            "run_len": run_len,
+            "initial": initial,
+            "positions": positions,
+            "encountered_count": len(encountered),
+            "extra_count": extra_count,
+            "stop_col": stop_col,
+            "consumed_count": consumed,
+            "slide_distance": int(slide_distance),
+            "final_color": int(final_run[2]),
