+    start, run_len, current = info
+    out = row.copy()
+    out[start:] = bg
+
+    stop_col = None
+    consumed_cols: list[int] = []
+    for c in range(start - 1, -1, -1):
+        color = int(row[c])
+        if color == int(bg):
+            continue
+        if color == current:
+            stop_col = c
+            break
+        consumed_cols.append(c)
+        current = color
+
+    if consumed_cols:
+        out[np.array(consumed_cols, dtype=int)] = bg
