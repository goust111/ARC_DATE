_GEN_SMALL_GRID_SIZE_RANGE, _GEN_LARGE_GRID_SIZE_RANGE = (3, 5), (10, 15)
_GEN_PALETTE_SIZE_RANGE, _GEN_FOREGROUND_COLORS = (2, 5), range(1, 10)
