_GEN_DENSE_GRID_MIN_AREA, _GEN_DENSE_STANDALONE_PROB, _GEN_DENSE_DISTRACTOR_PROB = 120, 0.12, 0.08
_GEN_DENSE_STANDALONE_COUNT_RANGE = (6, 9)
