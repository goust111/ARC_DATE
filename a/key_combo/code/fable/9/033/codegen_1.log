_GEN_ARCHETYPE_TRIES = 8

# Inner object counts and size limits.
_GEN_TWO_CONTAINER_EXTRA_INNER_PROB = 0.45
_GEN_INNER_COUNT_RANGE, _GEN_INNER_AREA_MAX = (1, 2), 4
_GEN_INNER_SPRITE_TRIES = 12
