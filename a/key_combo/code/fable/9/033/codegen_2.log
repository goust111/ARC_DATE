+def _count_run(grid: np.ndarray, r: int, c: int, dr: int, dc: int, color: int) -> int:
+    count = 0
+    h, w = grid.shape
+    while 0 <= r < h and 0 <= c < w and int(grid[r, c]) == int(color):
+        count += 1
+        r += dr
+        c += dc
+    return count
