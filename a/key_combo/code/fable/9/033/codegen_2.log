+    specs = {
+        "tl": ((0, 1), (1, 0)),
+        "tr": ((0, -1), (1, 0)),
+        "bl": ((0, 1), (-1, 0)),
+        "br": ((0, -1), (-1, 0)),
+    }
+
+    for corner, (hdir, vdir) in specs.items():
+        rr1, cc1 = r + hdir[0], c + hdir[1]
+        rr2, cc2 = r + vdir[0], c + vdir[1]
