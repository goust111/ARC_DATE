+
+        color = int(grid[rr1, cc1])
+        if color in (bg, TEAL) or int(grid[rr2, cc2]) != color:
+            continue
+
+        arm_h = _count_run(grid, rr1, cc1, hdir[0], hdir[1], color)
+        arm_v = _count_run(grid, rr2, cc2, vdir[0], vdir[1], color)
