+    return _apply_ring_rule(out, rectangles, length_to_color, bg)
+
+
+def _ring_count(h: int, w: int) -> int:
+    return (min(h, w) + 1) // 2
+
+
+def _rects_separated(
+    candidate: tuple[int, int, int, int], placed: list[tuple[int, int, int, int]], pad: int = 1
