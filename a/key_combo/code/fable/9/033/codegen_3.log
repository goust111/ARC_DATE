{
  "type": "transform_in_place",
  "src": "grey top-row marker column and lower monochrome horizontal bars on black background",
  "transform": "for each bar row, add one pixel in the marker column; its color is (n*n) mod 10 where n = min(bar length minus one, first bar row plus zero-based order among the every-other source rows)"
}
</annotation>
<generation_spec>
```yaml
spec:
  grid:
    background: black
    height: 2 * (first_src_row + num_bars - 1), giving 4-10
    width: 3-12, must be > marker_col
  marker:
    single grey (5) pixel in row 0 at marker_col
    marker_col: 2-9, all other row-0 cells are black
  bars:
    count: 1-4 horizontal monochrome bars on black background
    row_placement: every other row starting at first_src_row (1 or 2), spacing exactly 2
    each bar is contiguous, monochrome, length 2-5, entirely left of marker_col
    start_col: 0-2 (varies per bar)
    color: any non-black ARC color (1-9 including grey); bars may share colors
  transform:
    for each bar, compute quantity = bar_length
    write the fixed quantity color at (bar_row, marker_col): 2->1 (blue), 3->4 (yellow), 4->9 (maroon), 5->6 (pink)
    quantity is always 2-5; output colors are in {1, 4, 6, 9}
    input is otherwise unchanged

generation_strategy:
  approach: direct construction (constraints are easy to satisfy forward)
  steps:
    1. pick num_bars in [1,4] and first_src_row in {1,2}
    2. compute height = 2 * (first_src_row + num_bars - 1)
    3. for each bar i (0-indexed), its row = first_src_row + 2*i
    4. pick bar_length in [2, 5] with balanced sampling across 2/3/4/5; within one grid prefer distinct lengths, and pick start_col in [0, 2] for each bar
    5. pick marker_col > max(start_col + bar_length - 1) across all bars; at least max_bar_end + 1
    6. pick width > marker_col (add 0-7 trailing columns)
    7. pick bar color from 1-9 for each bar (may repeat)
    8. place grey pixel at (0, marker_col); fill bars; rest is black
  validation: ensure bar_len is in [2,5] for every bar
