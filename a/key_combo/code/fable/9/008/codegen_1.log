+def _find_source(grid: np.ndarray) -> tuple[tuple[int, int], int, tuple[int, int]]:
+    h, w = grid.shape
+    candidates = []
+    for r, c in _boundary_cells(h, w):
+        value = int(grid[r, c])
+        if value not in (BLACK, GREY):
+            candidates.append((r, c, value))
+    assert len(candidates) == 1
+    r, c, color = candidates[0]
