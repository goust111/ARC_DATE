+    for r in range(max(0, r0 - 1), min(h_grid, r0 + h + 1)):
+        for c in range(max(0, c0 - 1), min(w_grid, c0 + w + 1)):
+            cells.add((r, c))
+    return cells
+
+
+def _perimeter_cells(r0: int, c0: int, h: int, w: int) -> set[tuple[int, int]]:
+    cells = set()
+    for c in range(c0, c0 + w):
+        cells.add((r0, c))
+        cells.add((r0 + h - 1, c))
+    for r in range(r0, r0 + h):
+        cells.add((r, c0))
+        cells.add((r, c0 + w - 1))
+    return cells
