   409	            side_b: _sample_entry_offset(side_b, h, w),
   410	        }
   411	        piece = _build_piece(r0, c0, h, w, openings)
   412	        if piece["cells"] & forbidden_cells:
   413	            continue
   414	        if piece["cells"] & piece_cells:
   415	            continue
   416	        if piece["cells"] & expanded_piece_cells:
   417	            continue
   418	        return piece
   419	    return None
   420	
   421	
   422	def _draw_piece(grid: np.ndarray, piece: dict) -> None:
   423	    for r, c in piece["walls"]:
   424	        grid[r, c] = GREY
   425	
   426	
   427	def _build_expected(grid: np.ndarray, source_color: int, source: tuple[int, int], path_cells: set[tuple[int, int]], main_pieces: list[dict]) -> np.ndarray:
   428	    out = grid.copy()
   429	    out[source] = source_color
   430	    for r, c in path_cells:
   431	        out[r, c] = source_color
   432	    for piece in main_pieces:
   433	        for r, c in piece["fill"]:
   434	            out[r, c] = source_color
   435	    return out
   436	
   437	
   438	def _gen_case() -> tuple[np.ndarray, np.ndarray] | None:
   439	    h = random.randint(20, 29)
   440	    w = random.randint(20, 29)
   441	    grid = np.zeros((h, w), dtype=int)
   442	    source_color = random.choice(SOURCE_COLORS)
   443	
   444	    source_side = random.choice(("U", "D", "L", "R"))
   445	    if source_side == "U":
