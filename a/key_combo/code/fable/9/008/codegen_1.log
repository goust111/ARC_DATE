+        cells.append((h - 1, c))
+    for r in range(1, h - 1):
+        cells.append((r, 0))
+        cells.append((r, w - 1))
+    return cells
+
+
+def _bbox_from_entry(entry: tuple[int, int], side: str, offset: int, h: int, w: int) -> tuple[int, int]:
+    r, c = entry
