   335	        return h - 1 - r
   336	    if dc == -1:
   337	        return c
   338	    return w - 1 - c
   339	
   340	
   341	def _sample_entry_offset(side: str, h: int, w: int) -> int:
   342	    return random.randint(1, (w - 2) if side in {"U", "D"} else (h - 2))
   343	
   344	
   345	def _piece_candidate_for_path(
   346	    shape: tuple[int, int],
   347	    entry: tuple[int, int],
   348	    incoming: tuple[int, int],
   349	    outgoing: tuple[int, int] | None,
   350	    path_cells: set[tuple[int, int]],
   351	    piece_cells: set[tuple[int, int]],
   352	    expanded_piece_cells: set[tuple[int, int]],
   353	) -> dict | None:
   354	    entry_side = OPPOSITE[_side_for_direction(incoming)]
   355	    exit_side = None if outgoing is None else _side_for_direction(outgoing)
   356	
   357	    for _ in range(120):
   358	        h = random.randint(4, 7)
   359	        w = random.randint(4, 7)
   360	        entry_offset = _sample_entry_offset(entry_side, h, w)
   361	        openings = {entry_side: entry_offset}
   362	        if exit_side is not None:
   363	            exit_offset = _sample_entry_offset(exit_side, h, w)
   364	            openings[exit_side] = exit_offset
   365	
   366	        r0, c0 = _bbox_from_entry(entry, entry_side, entry_offset, h, w)
   367	        r1 = r0 + h - 1
   368	        c1 = c0 + w - 1
   369	        if r0 < 1 or c0 < 1 or r1 >= shape[0] - 1 or c1 >= shape[1] - 1:
   370	            continue
   371	
   372	        piece = _build_piece(r0, c0, h, w, openings)
   373	        if entry not in piece["openings"]:
   374	            continue
   375	        if piece["cells"] & piece_cells:
   376	            continue
   377	        if any(cell in path_cells and cell != entry for cell in piece["cells"]):
   378	            continue
   379	        if piece["cells"] & expanded_piece_cells:
   380	            continue
   381	
   382	        if exit_side is not None:
   383	            exit_candidates = [coord for coord in piece["openings"] if coord != entry]
   384	            assert len(exit_candidates) == 1
   385	            exit_opening = exit_candidates[0]
   386	            if _distance_to_edge(exit_opening, outgoing, shape) < 4:
   387	                continue
   388	            piece["exit_opening"] = exit_opening
   389	            piece["outgoing"] = outgoing
   390	        return piece
   391	    return None
   392	
   393	
   394	def _random_free_piece(
   395	    shape: tuple[int, int],
   396	    forbidden_cells: set[tuple[int, int]],
   397	    piece_cells: set[tuple[int, int]],
   398	    expanded_piece_cells: set[tuple[int, int]],
   399	) -> dict | None:
   400	    h_grid, w_grid = shape
   401	    for _ in range(200):
   402	        h = random.randint(4, 7)
