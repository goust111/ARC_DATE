+from __future__ import annotations
+
+import random
+from collections import deque
+from typing import Iterable
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+SOURCE_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+DIRS = {
+    "U": (-1, 0),
+    "R": (0, 1),
+    "D": (1, 0),
+    "L": (0, -1),
+}
+OPPOSITE = {"U": "D", "D": "U", "L": "R", "R": "L"}
+ADJACENT_EXIT_SIDES = {
+    "U": ("L", "R"),
+    "D": ("L", "R"),
+    "L": ("U", "D"),
+    "R": ("U", "D"),
+}
+ELBOW_SIDE_PAIRS = [
+    ("U", "L"),
+    ("U", "R"),
+    ("D", "L"),
+    ("D", "R"),
+]
+MAX_ATTEMPTS = 400
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def _neighbors4(r: int, c: int) -> Iterable[tuple[int, int]]:
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _boundary_cells(h: int, w: int) -> list[tuple[int, int]]:
+    cells: list[tuple[int, int]] = []
+    for c in range(w):
+        cells.append((0, c))
+        cells.append((h - 1, c))
+    for r in range(1, h - 1):
+        cells.append((r, 0))
+        cells.append((r, w - 1))
+    return cells
+
+
+def _bbox_from_entry(entry: tuple[int, int], side: str, offset: int, h: int, w: int) -> tuple[int, int]:
+    r, c = entry
+    if side == "U":
+        return r, c - offset
+    if side == "D":
+        return r - h + 1, c - offset
+    if side == "L":
+        return r - offset, c
+    if side == "R":
+        return r - offset, c - w + 1
+    raise ValueError(side)
+
+
+def _opening_coord(r0: int, c0: int, h: int, w: int, side: str, offset: int) -> tuple[int, int]:
+    if side == "U":
+        return r0, c0 + offset
+    if side == "D":
+        return r0 + h - 1, c0 + offset
+    if side == "L":
+        return r0 + offset, c0
+    if side == "R":
+        return r0 + offset, c0 + w - 1
+    raise ValueError(side)
+
+
+def _bbox_cells(r0: int, c0: int, h: int, w: int) -> set[tuple[int, int]]:
