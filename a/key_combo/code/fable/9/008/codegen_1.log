+}
+OPPOSITE = {"U": "D", "D": "U", "L": "R", "R": "L"}
+ADJACENT_EXIT_SIDES = {
+    "U": ("L", "R"),
+    "D": ("L", "R"),
+    "L": ("U", "D"),
+    "R": ("U", "D"),
