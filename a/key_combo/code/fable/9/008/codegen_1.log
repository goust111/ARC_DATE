+GREY = 5
+SOURCE_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+DIRS = {
+    "U": (-1, 0),
+    "R": (0, 1),
+    "D": (1, 0),
+    "L": (0, -1),
+}
+OPPOSITE = {"U": "D", "D": "U", "L": "R", "R": "L"}
+ADJACENT_EXIT_SIDES = {
+    "U": ("L", "R"),
+    "D": ("L", "R"),
+    "L": ("U", "D"),
+    "R": ("U", "D"),
+}
+ELBOW_SIDE_PAIRS = [
+    ("U", "L"),
+    ("U", "R"),
+    ("D", "L"),
+    ("D", "R"),
+]
+MAX_ATTEMPTS = 400
