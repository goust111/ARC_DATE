   447	    elif source_side == "D":
   448	        source = (h - 1, random.randint(2, w - 3))
   449	    elif source_side == "L":
   450	        source = (random.randint(2, h - 3), 0)
   451	    else:
   452	        source = (random.randint(2, h - 3), w - 1)
   453	    grid[source] = source_color
   454	    directions = [DIRS[OPPOSITE[source_side]]]
   455	
   456	    elbow_count = random.randint(2, 4)
   457	    for _ in range(elbow_count):
   458	        current_side = _side_for_direction(directions[-1])
   459	        next_side = random.choice(ADJACENT_EXIT_SIDES[current_side])
   460	        directions.append(DIRS[next_side])
   461	
   462	    path_cells = {source}
   463	    piece_cells: set[tuple[int, int]] = set()
   464	    expanded_piece_cells: set[tuple[int, int]] = set()
   465	    main_pieces: list[dict] = []
   466	    current_pos = source
   467	
