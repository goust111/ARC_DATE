190: def main(grid: np.ndarray) -> np.ndarray:
191:     """
192:     Move a triangular sprite across the grid, consuming aligned marker pixels.
193: 
194:     Input structure:
195:     - Frames concatenated horizontally with solid divider columns; bg is most common color.
196:     - Each frame: a triangular arrow-shaped sprite and scattered single-pixel markers, all one color.
197: 
198:     Rule:
199:     - Start from the rightmost frame.
200:     - At each step, exactly one cardinal direction from the head has reachable
201:       markers (on a half-line: same row or column); the sprite advances to the
202:       nearest one.
203:     - On reaching a marker, consume it; sprite re-faces that direction.
204:     - Repeat until no markers remain; output the final sprite position on a clean bg.
205: 
206:     Key insight: The triangle's tip encodes facing direction, which sets marker-consumption priority.
207:     """
208:     g = np.asarray(grid, dtype=int)
209:     frames, bg = _split_frames(g)
210: 
211:     # Actor color is the non-bg, non-divider color.
212:     solid_cols = [c for c in range(g.shape[1]) if len(set(map(int, g[:, c]))) == 1]
213:     div_colors = {int(g[0, c]) for c in solid_cols if int(g[0, c]) != bg}
214:     colors = set(map(int, g.ravel()))
215:     actor = next(iter(colors - {bg} - div_colors))
216: 
217:     # Use the latest frame (rightmost) as the starting state.
218:     start = frames[-1]
219:     return _simulate_to_end(start, actor)
