+import numpy as np
+
+
+BLACK = 0
+GRAY = 5
+MARKER_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+
+SIDE_TO_DIR = {
+    "top": (-1, 0),
+    "right": (0, 1),
+    "bottom": (1, 0),
+    "left": (0, -1),
+}
