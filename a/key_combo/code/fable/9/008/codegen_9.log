+
+def _bottom_profile(mask: np.ndarray) -> tuple[int, ...]:
+    h, w = mask.shape
+    bottoms = []
+    for c in range(w):
+        rows = np.flatnonzero(mask[:, c])
+        assert len(rows) > 0
+        bottoms.append(int(rows[-1]))
+    return tuple(bottoms)
