+BG = 0
+GRAY = 5
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+
+GEN_ATTEMPTS = 400
+SHAPE_ATTEMPTS = 200
+PLACEMENT_ATTEMPTS = 300
