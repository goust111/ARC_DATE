+
+def _build_subject(hole_mask: np.ndarray, subject_color: int) -> tuple[np.ndarray, BBox]:
+    mt, mb = random.randint(1, 3), random.randint(1, 3)
+    ml, mr = random.randint(1, 3), random.randint(1, 3)
