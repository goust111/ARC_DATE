+
+def _semantic_checks(grid: np.ndarray, expected: np.ndarray) -> None:
+    bg = _get_bg(grid)
+    subject, hole_local = _subject_and_hole(grid, bg)
+    hole_mask = _coords_to_mask(hole_local)
