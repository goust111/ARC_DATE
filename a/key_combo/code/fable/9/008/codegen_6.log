+def _expected_output(subject_patch: np.ndarray, hole_bbox: BBox, hole_mask: np.ndarray, fragments: list[dict]) -> np.ndarray:
+    _, solutions, singles = _enumerate_pair_solutions(hole_mask, fragments)
