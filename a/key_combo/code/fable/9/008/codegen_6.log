+                if hole_mask.shape[0] < 3 or hole_mask.shape[1] < 3:
+                    continue
+                frag_defs = [
+                    {"coords": np.argwhere(piece1), "area": int(piece1.sum()), "color": 1},
+                    {"coords": np.argwhere(piece2), "area": int(piece2.sum()), "color": 2},
+                ]
