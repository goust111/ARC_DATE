+            if np.any(placed[r1 : r1 + piece1.shape[0], c1 : c1 + piece1.shape[1]] & piece1):
+                continue
+            placed[r1 : r1 + piece1.shape[0], c1 : c1 + piece1.shape[1]] |= piece1.astype(int)
