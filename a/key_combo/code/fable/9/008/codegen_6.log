+def _generate_distractors(hole_mask: np.ndarray, true_fragments: list[dict]) -> list[dict]:
+    used_keys = {_shape_key(frag["coords"]) for frag in true_fragments}
+    hole_area = int(hole_mask.sum())
+    distractors: list[dict] = []
