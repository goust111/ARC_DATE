+PANEL_MIN = 4
+PANEL_MAX = 7
+FILL_RATIO_MIN = 0.22
+FILL_RATIO_MAX = 0.50
+MAX_COMPONENTS = 3
+GENERATION_ATTEMPTS = 2000
