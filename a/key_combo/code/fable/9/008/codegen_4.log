+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _support_count(mask: np.ndarray) -> np.ndarray:
+    support = np.zeros(mask.shape, dtype=int)
+    support[1:, :] += mask[:-1, :]
+    support[:-1, :] += mask[1:, :]
+    support[:, 1:] += mask[:, :-1]
+    support[:, :-1] += mask[:, 1:]
+    return support * mask.astype(int)
+
+
+def _count_components(mask: np.ndarray) -> int:
+    mask = mask.astype(bool)
+    seen = np.zeros(mask.shape, dtype=bool)
+    h, w = mask.shape
+    count = 0
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            count += 1
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            while queue:
+                rr, cc = queue.popleft()
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+    return count
+
+
+def _dilate4(mask: np.ndarray) -> np.ndarray:
+    near = np.zeros(mask.shape, dtype=bool)
+    near[1:, :] |= mask[:-1, :]
+    near[:-1, :] |= mask[1:, :]
+    near[:, 1:] |= mask[:, :-1]
+    near[:, :-1] |= mask[:, 1:]
+    return near
+
+
+def _frontier(mask: np.ndarray, allowed: np.ndarray) -> np.ndarray:
+    return _dilate4(mask) & allowed & ~mask
+
+
+def _pick_true(mask: np.ndarray) -> tuple[int, int] | None:
+    coords = np.argwhere(mask)
+    if len(coords) == 0:
+        return None
+    r, c = coords[random.randrange(len(coords))]
+    return int(r), int(c)
+
+
