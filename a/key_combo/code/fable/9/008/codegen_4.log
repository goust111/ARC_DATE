+def _compose_fixed_order(masks: list[np.ndarray], fg_colors: list[int], bg: int, order) -> np.ndarray:
+    out = np.full(masks[0].shape, bg, dtype=int)
+    for idx in order:
+        out[masks[idx]] = fg_colors[idx]
+    return out
