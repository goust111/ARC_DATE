+        (slice(h + 1, 2 * h + 1), slice(0, w)),
+        (slice(h + 1, 2 * h + 1), slice(w + 1, 2 * w + 1)),
+    ]
+    for idx, (rs, cs) in enumerate(slices):
+        panel = np.full((h, w), bg, dtype=int)
+        panel[masks[idx]] = fg_colors[idx]
+        grid[rs, cs] = panel
+    return grid
+
+
+def _attempt_generate() -> np.ndarray | None:
