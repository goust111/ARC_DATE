+def _common_bg_and_colors(panels: list[np.ndarray]) -> tuple[int, list[int]]:
+    color_sets = [set(map(int, np.unique(panel))) for panel in panels]
+    common = set.intersection(*color_sets)
+    assert len(common) == 1
+    bg = common.pop()
