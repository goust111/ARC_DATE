                        configs.setdefault(cells, []).append((h, w, hole, r, c))
    return configs


_DISTRACTOR_CONFIGS = _make_distractor_configs()
_DISTRACTOR_CELLS = sorted(_DISTRACTOR_CONFIGS)


def _bbox_far(a: BBox, b: BBox, pad: int = _BBOX_SEPARATION) -> bool:
    return (
