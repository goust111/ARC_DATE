+    bg, fg_colors = _common_bg_and_colors(panels)
+    masks = [panel != bg for panel in panels]
+    composed = _compose_support_overlay(masks, fg_colors, bg)
+    assert composed is not None
+    out, _, _ = composed
+    return out
+
