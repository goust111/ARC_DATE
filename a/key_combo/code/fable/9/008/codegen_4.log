+            max_support = max(support_values.values())
+            winners = [i for i in contenders if support_values[i] == max_support]
+            if len(winners) != 1:
+                return None
+
+            winner = winners[0]
+            out[r, c] = fg_colors[winner]
+            winner_idx[r, c] = winner
+            conflicts.append(
+                {
+                    "pos": (r, c),
+                    "contenders": tuple(contenders),
+                    "winner": winner,
+                    "support_values": support_values,
+                }
