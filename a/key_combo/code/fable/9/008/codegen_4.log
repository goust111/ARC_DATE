+def _support_count(mask: np.ndarray) -> np.ndarray:
+    support = np.zeros(mask.shape, dtype=int)
+    support[1:, :] += mask[:-1, :]
+    support[:-1, :] += mask[1:, :]
+    support[:, 1:] += mask[:, :-1]
+    support[:, :-1] += mask[:, 1:]
+    return support * mask.astype(int)
+
