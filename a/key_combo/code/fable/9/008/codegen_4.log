+    mask = mask.astype(bool)
+    seen = np.zeros(mask.shape, dtype=bool)
+    h, w = mask.shape
+    count = 0
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            count += 1
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            while queue:
+                rr, cc = queue.popleft()
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+    return count
