+        removable = [(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)]
+        for r in range(h):
+            for c in range(w):
+                if (r in {0, h - 1} or c in {0, w - 1}) and (r, c) not in removable:
+                    removable.append((r, c))
+        _RNG.shuffle(removable)
