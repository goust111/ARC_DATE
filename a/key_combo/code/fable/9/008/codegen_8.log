+                {
+                    (0, dc),
+                    (0, -dc),
+                    (dr, 0),
+                    (-dr, 0),
+                    (dr, 1),
+                    (dr, -1),
+                    (-dr, 1),
+                    (-dr, -1),
+                    (1, dc),
+                    (-1, dc),
+                    (1, -dc),
+                    (-1, -dc),
+                    (dr, dc),
+                    (dr, -dc),
+                    (-dr, dc),
+                    (-dr, -dc),
