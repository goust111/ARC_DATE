+def _distance_from_marker(side: str, r: int, c: int, shape: tuple[int, int]) -> int:
+    h, w = shape
+    if side == "top":
+        return r
+    if side == "right":
+        return w - 1 - c
+    if side == "bottom":
+        return h - 1 - r
+    return c
+
