+def _edge_marker_side(grid: np.ndarray) -> str:
+    h, w = grid.shape
+    candidates: list[str] = []
+    if np.all(grid[0, :] == MARKER):
+        candidates.append("top")
+    if np.all(grid[:, w - 1] == MARKER):
+        candidates.append("right")
+    if np.all(grid[h - 1, :] == MARKER):
+        candidates.append("bottom")
+    if np.all(grid[:, 0] == MARKER):
+        candidates.append("left")
+    assert len(candidates) == 1, candidates
+    return candidates[0]
+
+
+def _initial_direction(side: str) -> tuple[int, int]:
+    return {
+        "top": DIRS["down"],
+        "right": DIRS["left"],
+        "bottom": DIRS["up"],
+        "left": DIRS["right"],
+    }[side]
+
+
+def _distance_from_marker(side: str, r: int, c: int, shape: tuple[int, int]) -> int:
+    h, w = shape
+    if side == "top":
+        return r
+    if side == "right":
+        return w - 1 - c
+    if side == "bottom":
+        return h - 1 - r
+    return c
+
+
+def _components8(mask: np.ndarray) -> list[np.ndarray]:
+    coords = set(map(tuple, np.argwhere(mask)))
+    parts: list[np.ndarray] = []
+    while coords:
+        seed = coords.pop()
+        queue = deque([seed])
+        comp = [seed]
+        while queue:
+            r, c = queue.popleft()
+            for nr, nc in _neighbors8(r, c):
+                if (nr, nc) in coords:
+                    coords.remove((nr, nc))
+                    queue.append((nr, nc))
+                    comp.append((nr, nc))
+        parts.append(np.array(comp, dtype=int))
+    return parts
