+    for cr in range(min(rs) - 1, max(rs) + 2):
+        for cc in range(min(cs) - 1, max(cs) + 2):
+            present = {name for name, (dr, dc) in DIRS.items() if (cr + dr, cc + dc) in pts}
+            if len(present) != 3:
+                continue
+            if _door_cells((cr, cc), next(d for d in DIR_ORDER if d not in present)) == pts:
