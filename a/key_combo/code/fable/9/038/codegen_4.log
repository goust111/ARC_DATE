+    return DIR_ORDER[(idx + k) % 4]
+
+
+def _rotate_scene(grid: np.ndarray, k: int) -> np.ndarray:
+    if k % 4 == 0:
+        return grid
+    return np.rot90(grid, -k)
+
+
