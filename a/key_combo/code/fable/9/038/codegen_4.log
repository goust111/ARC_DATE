+
+def _distance_from_marker(side: str, r: int, c: int, shape: tuple[int, int]) -> int:
+    h, w = shape
+    if side == "top":
+        return r
+    if side == "right":
+        return w - 1 - c
+    if side == "bottom":
+        return h - 1 - r
+    return c
+
+
+def _components8(mask: np.ndarray) -> list[np.ndarray]:
+    coords = set(map(tuple, np.argwhere(mask)))
+    parts: list[np.ndarray] = []
+    while coords:
+        seed = coords.pop()
+        queue = deque([seed])
+        comp = [seed]
+        while queue:
+            r, c = queue.popleft()
+            for nr, nc in _neighbors8(r, c):
+                if (nr, nc) in coords:
+                    coords.remove((nr, nc))
+                    queue.append((nr, nc))
+                    comp.append((nr, nc))
