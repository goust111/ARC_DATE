+
+BG = 0
+MARKER = 1
+PLATFORM = 5
+OTHER_COLORS = [2, 3, 4, 6, 7, 8, 9]
+DIRS = {
+    "up": (-1, 0),
+    "right": (0, 1),
+    "down": (1, 0),
+    "left": (0, -1),
+}
+DIR_ORDER = ("up", "right", "down", "left")
