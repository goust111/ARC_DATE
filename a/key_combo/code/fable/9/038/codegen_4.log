+        return None
+
+    platform1_left = random.randint(1, 2)
+    platform1_right = random.randint(1, 2)
+    platform1 = {(rp1, c) for c in range(c_exit - platform1_left, c_exit + platform1_right + 1)}
+    if any(not _in_bounds((h, w), r, c) for r, c in platform1):
+        return None
+
+    start_positions: list[tuple[int, int, int]] = [
+        (start_rows[0], c_path, stone_colors[0]),
+        (start_rows[1], c_path, stone_colors[1]),
+    ]
+
+    def clear_vertical_path(col: int, r0: int, r1: int) -> bool:
+        for rr in range(r0 + 1, r1):
+            if (rr, col) in door_cells or (rr, col) in platform1:
+                return False
+        return True
+
+    occupied_now = set(door_cells) | platform1 | centers | {(0, c) for c in range(w)}
+    platforms_extra: list[set[tuple[int, int]]] = []
+    plain_rows = start_rows[2:]
+    for idx, plain_row in enumerate(plain_rows):
+        stop_row = plain_row + random.randint(5, 7)
+        if stop_row >= h - 1:
+            return None
+        plain_candidates = []
+        for c_plain in range(2, w - 2):
+            if any(abs(c_plain - x) <= 1 for x in (c_path, ca2, cb1, c_exit)):
+                continue
+            if any(abs(c_plain - prev_c) <= 1 for _pr, prev_c, _pc in start_positions[2:]):
+                continue
+            if not clear_vertical_path(c_plain, plain_row, stop_row):
+                continue
+            plain_candidates.append(c_plain)
+        if not plain_candidates:
+            return None
+        c_plain = random.choice(plain_candidates)
+        start_positions.append((plain_row, c_plain, stone_colors[2 + idx]))
+
+        left_span = random.randint(1, 2)
+        right_span = random.randint(0, 2)
+        platform = {(stop_row, c) for c in range(c_plain - left_span, c_plain + right_span + 1)}
+        if any(not _in_bounds((h, w), r, c) for r, c in platform):
+            return None
+        platforms_extra.append(platform)
+
+    extra_platform = set()
+    if random.random() < 0.7:
+        er = random.randint(max(rmid + 1, 6), h - 3)
+        ec0 = random.randint(2, w - 5)
+        extra_platform = {(er, c) for c in range(ec0, ec0 + random.randint(2, 4))}
+
+    all_platforms = platform1 | extra_platform
+    for platform in platforms_extra:
+        all_platforms |= platform
+    if all_platforms & door_cells:
+        return None
+    if all_platforms & centers:
+        return None
+
+    for r, c, _color in start_positions:
+        if (r, c) in occupied_now or (r, c) in all_platforms or r == 0:
+            return None
+
+    for door in doors:
+        _paint_door(grid, door)
+    for r, c in all_platforms:
+        grid[r, c] = PLATFORM
+    for r, c, color in start_positions:
+        grid[r, c] = color
+
+    k = random.randint(0, 3)
+    grid = _rotate_scene(grid, k)
+    return grid
+
+
+def _semantic_checks(grid: np.ndarray) -> bool:
+    try:
+        scene = _parse_scene(grid)
+        resolved = _resolve_scene(scene)
+        out = _render_output_from_scene(scene, resolved)
+        if not np.array_equal(main(grid), out):
+            return False
+
+        dists = [
+            _distance_from_marker(scene["side"], stone["start"][0], stone["start"][1], scene["shape"])
+            for stone in scene["stones"]
+        ]
+        if len(set(dists)) != len(dists):
+            return False
+
+        if max(stone["teleports"] for stone in resolved) < 2:
+            return False
+
+        finals = {stone["final"] for stone in resolved}
+        if len(finals) != len(resolved):
+            return False
+
+        alt_no_rewrite = _render_output_from_scene(scene, _resolve_scene(scene, rewrite_exit=False))
+        alt_no_settle = _render_output_from_scene(scene, _resolve_scene(scene, use_settled=False))
+        alt_reverse = _render_output_from_scene(scene, _resolve_scene(scene, nearest_first=False))
+
+        if np.array_equal(out, alt_no_rewrite):
+            return False
+        if np.array_equal(out, alt_no_settle):
+            return False
+        if np.array_equal(out, alt_reverse):
+            return False
+
+        changed = sum(stone["start"] != stone["final"] for stone in resolved)
+        if changed < 2:
+            return False
+
+        return True
+    except AssertionError:
+        return False
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(500):
+        grid = _build_candidate()
+        if grid is not None and _semantic_checks(grid):
+            return grid
+    raise RuntimeError("failed to generate valid slot-gate puzzle input")

diff --git a/key_combo/code/fable/9/038/4.py b/key_combo/code/fable/9/038/4.py
new file mode 100644
index 0000000000000000000000000000000000000000..d68960d3690b958326cd99d0c93b2f3671004d97
--- /dev/null
+++ b/key_combo/code/fable/9/038/4.py
@@ -0,0 +1,512 @@
+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BG = 0
+MARKER = 1
+PLATFORM = 5
+OTHER_COLORS = [2, 3, 4, 6, 7, 8, 9]
+DIRS = {
+    "up": (-1, 0),
+    "right": (0, 1),
+    "down": (1, 0),
+    "left": (0, -1),
+}
+DIR_ORDER = ("up", "right", "down", "left")
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def _neighbors8(r: int, c: int) -> list[tuple[int, int]]:
+    out = []
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            out.append((r + dr, c + dc))
+    return out
+
+
+def _edge_marker_side(grid: np.ndarray) -> str:
+    h, w = grid.shape
+    candidates: list[str] = []
+    if np.all(grid[0, :] == MARKER):
+        candidates.append("top")
+    if np.all(grid[:, w - 1] == MARKER):
+        candidates.append("right")
+    if np.all(grid[h - 1, :] == MARKER):
+        candidates.append("bottom")
+    if np.all(grid[:, 0] == MARKER):
+        candidates.append("left")
+    assert len(candidates) == 1, candidates
+    return candidates[0]
+
+
+def _initial_direction(side: str) -> tuple[int, int]:
+    return {
+        "top": DIRS["down"],
+        "right": DIRS["left"],
+        "bottom": DIRS["up"],
+        "left": DIRS["right"],
+    }[side]
+
+
+def _distance_from_marker(side: str, r: int, c: int, shape: tuple[int, int]) -> int:
+    h, w = shape
+    if side == "top":
+        return r
+    if side == "right":
+        return w - 1 - c
+    if side == "bottom":
+        return h - 1 - r
+    return c
+
+
+def _components8(mask: np.ndarray) -> list[np.ndarray]:
+    coords = set(map(tuple, np.argwhere(mask)))
+    parts: list[np.ndarray] = []
+    while coords:
+        seed = coords.pop()
+        queue = deque([seed])
+        comp = [seed]
+        while queue:
+            r, c = queue.popleft()
+            for nr, nc in _neighbors8(r, c):
+                if (nr, nc) in coords:
+                    coords.remove((nr, nc))
+                    queue.append((nr, nc))
+                    comp.append((nr, nc))
+        parts.append(np.array(comp, dtype=int))
+    return parts
+
+
+def _door_cells(center: tuple[int, int], opening: str) -> set[tuple[int, int]]:
+    r, c = center
+    cells = {
+        "up": {(r + 1, c), (r, c - 1), (r, c + 1)},
+        "right": {(r - 1, c), (r + 1, c), (r, c - 1)},
+        "down": {(r - 1, c), (r, c - 1), (r, c + 1)},
+        "left": {(r - 1, c), (r + 1, c), (r, c + 1)},
+    }[opening]
+    return cells
+
+
+def _infer_door(coords: np.ndarray) -> dict:
+    pts = {tuple(map(int, p)) for p in coords}
+    rs = [p[0] for p in pts]
+    cs = [p[1] for p in pts]
+    found = []
+    for cr in range(min(rs) - 1, max(rs) + 2):
+        for cc in range(min(cs) - 1, max(cs) + 2):
+            present = {name for name, (dr, dc) in DIRS.items() if (cr + dr, cc + dc) in pts}
+            if len(present) != 3:
+                continue
+            if _door_cells((cr, cc), next(d for d in DIR_ORDER if d not in present)) == pts:
+                opening = next(d for d in DIR_ORDER if d not in present)
+                found.append({"center": (cr, cc), "opening": opening, "cells": pts})
+    assert len(found) == 1, found
+    return found[0]
+
+
+def _parse_scene(grid: np.ndarray) -> dict:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    bg = _get_bg(g)
+    assert bg == BG
+    side = _edge_marker_side(g)
+
+    colors = sorted(set(map(int, g.ravel())) - {BG, MARKER, PLATFORM})
+    portal_colors = [c for c in colors if int((g == c).sum()) == 6]
+    stone_colors = [c for c in colors if int((g == c).sum()) == 1]
+    assert portal_colors
+    assert stone_colors
+
+    portals: dict[int, list[dict]] = {}
+    portal_hit: dict[tuple[int, int], tuple[int, int]] = {}
+    portal_mask = np.zeros_like(g, dtype=bool)
+    for color in portal_colors:
+        parts = _components8(g == color)
+        assert len(parts) == 2
+        doors: list[dict] = []
+        for comp in parts:
+            assert comp.shape[0] == 3
+            door = _infer_door(comp)
+            door["color"] = color
+            doors.append(door)
+        portals[color] = doors
+        for idx, door in enumerate(doors):
+            for cell in door["cells"]:
+                portal_hit[cell] = (color, idx)
+                portal_mask[cell] = True
+
+    stones = []
+    for color in stone_colors:
+        rc = np.argwhere(g == color)
+        assert rc.shape == (1, 2)
+        r, c = map(int, rc[0])
+        stones.append({"color": color, "start": (r, c)})
+
+    static_mask = (g != BG) & (~portal_mask)
+    for stone in stones:
+        r, c = stone["start"]
+        static_mask[r, c] = False
+
+    return {
+        "grid": g,
+        "shape": (h, w),
+        "side": side,
+        "init_dir": _initial_direction(side),
+        "portals": portals,
+        "portal_hit": portal_hit,
+        "portal_mask": portal_mask,
+        "stones": stones,
+        "static_mask": static_mask,
+    }
+
+
+def _trace_stone(
+    scene: dict,
+    stone: dict,
+    settled_mask: np.ndarray,
+    *,
+    use_settled: bool = True,
+    rewrite_exit: bool = True,
+) -> dict:
+    h, w = scene["shape"]
+    blocked = scene["static_mask"].copy()
+    if use_settled:
+        blocked |= settled_mask
+
+    pos = stone["start"]
+    direction = scene["init_dir"]
+    teleports = 0
+    history = [pos]
+    seen: set[tuple[int, int, int, int]] = set()
+
+    limit = h * w * 8
+    for _ in range(limit):
+        state = (pos[0], pos[1], direction[0], direction[1])
+        assert state not in seen, "non-terminating portal loop"
+        seen.add(state)
+
+        nr = pos[0] + direction[0]
+        nc = pos[1] + direction[1]
+        if not _in_bounds(scene["shape"], nr, nc):
+            return {"final": pos, "teleports": teleports, "history": history}
+        if blocked[nr, nc]:
+            return {"final": pos, "teleports": teleports, "history": history}
+
+        hit = scene["portal_hit"].get((nr, nc))
+        if hit is not None:
+            color, in_idx = hit
+            out_door = scene["portals"][color][1 - in_idx]
+            exit_center = tuple(out_door["center"])
+            assert not blocked[exit_center], "exit center must stay free"
+            pos = exit_center
+            if rewrite_exit:
+                direction = DIRS[out_door["opening"]]
+            teleports += 1
+            history.append(pos)
+            continue
+
+        pos = (nr, nc)
+        history.append(pos)
+
+    raise AssertionError("trace exceeded step limit")
+
+
+def _resolve_scene(
+    scene: dict,
+    *,
+    use_settled: bool = True,
+    rewrite_exit: bool = True,
+    nearest_first: bool = True,
+) -> list[dict]:
+    stones = list(scene["stones"])
+    stones.sort(
+        key=lambda s: (
+            _distance_from_marker(scene["side"], s["start"][0], s["start"][1], scene["shape"]),
+            s["start"][0],
+            s["start"][1],
+        ),
+        reverse=not nearest_first,
+    )
+
+    settled_mask = np.zeros(scene["shape"], dtype=bool)
+    resolved = []
+    for stone in stones:
+        trace = _trace_stone(
+            scene,
+            stone,
+            settled_mask,
+            use_settled=use_settled,
+            rewrite_exit=rewrite_exit,
+        )
+        fr, fc = trace["final"]
+        assert not settled_mask[fr, fc], "final positions must be unique"
+        settled_mask[fr, fc] = True
+        resolved.append(
+            {
+                "color": stone["color"],
+                "start": stone["start"],
+                "final": trace["final"],
+                "teleports": trace["teleports"],
+                "history": trace["history"],
+            }
+        )
+    return resolved
+
+
+def _render_output_from_scene(scene: dict, resolved: list[dict]) -> np.ndarray:
+    out = scene["grid"].copy()
+    for stone in scene["stones"]:
+        r, c = stone["start"]
+        out[r, c] = BG
+    for stone in resolved:
+        r, c = stone["final"]
+        out[r, c] = stone["color"]
+    return out
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """Trace each falling pixel through color-matched cup portals, redirecting at every exit until it settles.
+
+    Input structure:
+    - One complete outer edge is filled with a marker line that indicates the initial inward motion direction.
+    - The field also contains grey platform cells, several portal-color pairs of three-cell U-shaped cup gates, and several single-cell falling objects.
+    - Each portal color appears in exactly two three-cell gates; each falling object has its own color, different from the marker, platforms, and portals.
+
+    Rule:
+    - Resolve falling objects in order of increasing distance from the marked edge.
+    - Each object moves one cell at a time in its current direction. If the next cell is a portal cell, the object teleports to the center of the other gate of the same color and its direction is replaced by that exit gate's opening direction.
+    - If the next cell is blocked by a platform, a previously settled object, or any other fixed occupied cell, or if it would leave the grid, the object stops on its previous cell.
+    - The output keeps the marker, platforms, and portals unchanged, and draws each falling object only at its final settled position.
+
+    Key insight:
+    - Portal entry only selects the color-matched exit; the new direction comes solely from the exit gate's opening, so the full answer requires ordered step-by-step tracing through chained redirects.
+    """
+    scene = _parse_scene(np.asarray(grid, dtype=int))
+    resolved = _resolve_scene(scene)
+    return _render_output_from_scene(scene, resolved)
+
+
+def _place_marker(grid: np.ndarray) -> None:
+    grid[0, :] = MARKER
+
+
+def _paint_door(grid: np.ndarray, door: dict) -> None:
+    for r, c in _door_cells(door["center"], door["opening"]):
+        grid[r, c] = door["color"]
+
+
+def _rotate_opening(opening: str, k: int) -> str:
+    idx = DIR_ORDER.index(opening)
+    return DIR_ORDER[(idx + k) % 4]
+
+
+def _rotate_scene(grid: np.ndarray, k: int) -> np.ndarray:
+    if k % 4 == 0:
+        return grid
+    return np.rot90(grid, -k)
+
+
+def _build_candidate() -> np.ndarray | None:
+    h = random.randint(20, 26)
+    w = random.randint(20, 26)
+    pair_count = 2
+    stone_count = random.choice([3, 4])
+
+    pool = random.sample(OTHER_COLORS, pair_count + stone_count)
+    portal_colors = pool[:2]
+    stone_colors = pool[2:]
+
+    grid = np.full((h, w), BG, dtype=int)
+    _place_marker(grid)
+
+    start_rows = [random.randint(2, 3), random.randint(4, 5), random.randint(7, 8)]
+    if stone_count == 4:
+        start_rows.append(random.randint(9, 10))
+    if len(set(start_rows)) != len(start_rows):
+        return None
+
+    ra1 = start_rows[1] + random.randint(4, 6)
+    rmid = ra1 + random.randint(2, 4)
+    rb2 = rmid + random.randint(3, 5)
+    rp1 = rb2 + random.randint(4, 6)
+    if rp1 >= h - 1:
+        return None
+
+    c_path = random.randint(3, w - 4)
+    hsign = random.choice([-1, 1])
+    span = random.randint(4, 6)
+    if hsign == 1:
+        ca2 = random.randint(3, w - span - 4)
+        cb1 = ca2 + span
+    else:
+        ca2 = random.randint(span + 3, w - 4)
+        cb1 = ca2 - span
+
+    cexit_choices = [c for c in range(4, w - 4) if abs(c - c_path) >= 2 and abs(c - cb1) >= 2 and abs(c - ca2) >= 2]
+    if not cexit_choices:
+        return None
+    c_exit = random.choice(cexit_choices)
+
+    doors = [
+        {"center": (ra1, c_path), "opening": random.choice(DIR_ORDER), "color": portal_colors[0]},
+        {"center": (rmid, ca2), "opening": "right" if hsign == 1 else "left", "color": portal_colors[0]},
+        {"center": (rmid, cb1), "opening": random.choice(DIR_ORDER), "color": portal_colors[1]},
+        {"center": (rb2, c_exit), "opening": "down", "color": portal_colors[1]},
+    ]
+
+    door_cells = set()
+    centers = set()
+    for door in doors:
+        centers.add(door["center"])
+        cells = _door_cells(door["center"], door["opening"])
+        for r, c in cells:
+            if not (1 <= r < h and 1 <= c < w - 1):
+                return None
+        if door["center"][0] <= 1:
+            return None
+        if cells & door_cells:
+            return None
+        if door["center"] in door_cells:
+            return None
+        door_cells |= cells
+    if centers & door_cells:
+        return None
+
+    platform1_left = random.randint(1, 2)
+    platform1_right = random.randint(1, 2)
+    platform1 = {(rp1, c) for c in range(c_exit - platform1_left, c_exit + platform1_right + 1)}
+    if any(not _in_bounds((h, w), r, c) for r, c in platform1):
+        return None
+
+    start_positions: list[tuple[int, int, int]] = [
+        (start_rows[0], c_path, stone_colors[0]),
+        (start_rows[1], c_path, stone_colors[1]),
+    ]
+
+    def clear_vertical_path(col: int, r0: int, r1: int) -> bool:
+        for rr in range(r0 + 1, r1):
+            if (rr, col) in door_cells or (rr, col) in platform1:
+                return False
+        return True
+
+    occupied_now = set(door_cells) | platform1 | centers | {(0, c) for c in range(w)}
+    platforms_extra: list[set[tuple[int, int]]] = []
+    plain_rows = start_rows[2:]
+    for idx, plain_row in enumerate(plain_rows):
+        stop_row = plain_row + random.randint(5, 7)
+        if stop_row >= h - 1:
+            return None
+        plain_candidates = []
+        for c_plain in range(2, w - 2):
+            if any(abs(c_plain - x) <= 1 for x in (c_path, ca2, cb1, c_exit)):
+                continue
+            if any(abs(c_plain - prev_c) <= 1 for _pr, prev_c, _pc in start_positions[2:]):
+                continue
+            if not clear_vertical_path(c_plain, plain_row, stop_row):
+                continue
+            plain_candidates.append(c_plain)
+        if not plain_candidates:
+            return None
+        c_plain = random.choice(plain_candidates)
+        start_positions.append((plain_row, c_plain, stone_colors[2 + idx]))
+
+        left_span = random.randint(1, 2)
+        right_span = random.randint(0, 2)
+        platform = {(stop_row, c) for c in range(c_plain - left_span, c_plain + right_span + 1)}
+        if any(not _in_bounds((h, w), r, c) for r, c in platform):
+            return None
+        platforms_extra.append(platform)
+
+    extra_platform = set()
+    if random.random() < 0.7:
+        er = random.randint(max(rmid + 1, 6), h - 3)
+        ec0 = random.randint(2, w - 5)
+        extra_platform = {(er, c) for c in range(ec0, ec0 + random.randint(2, 4))}
+
+    all_platforms = platform1 | extra_platform
+    for platform in platforms_extra:
+        all_platforms |= platform
+    if all_platforms & door_cells:
+        return None
+    if all_platforms & centers:
+        return None
+
+    for r, c, _color in start_positions:
+        if (r, c) in occupied_now or (r, c) in all_platforms or r == 0:
+            return None
+
+    for door in doors:
+        _paint_door(grid, door)
+    for r, c in all_platforms:
+        grid[r, c] = PLATFORM
+    for r, c, color in start_positions:
+        grid[r, c] = color
+
+    k = random.randint(0, 3)
+    grid = _rotate_scene(grid, k)
+    return grid
+
+
+def _semantic_checks(grid: np.ndarray) -> bool:
+    try:
+        scene = _parse_scene(grid)
+        resolved = _resolve_scene(scene)
+        out = _render_output_from_scene(scene, resolved)
+        if not np.array_equal(main(grid), out):
+            return False
+
+        dists = [
+            _distance_from_marker(scene["side"], stone["start"][0], stone["start"][1], scene["shape"])
+            for stone in scene["stones"]
+        ]
+        if len(set(dists)) != len(dists):
+            return False
+
+        if max(stone["teleports"] for stone in resolved) < 2:
+            return False
+
+        finals = {stone["final"] for stone in resolved}
+        if len(finals) != len(resolved):
+            return False
+
+        alt_no_rewrite = _render_output_from_scene(scene, _resolve_scene(scene, rewrite_exit=False))
+        alt_no_settle = _render_output_from_scene(scene, _resolve_scene(scene, use_settled=False))
+        alt_reverse = _render_output_from_scene(scene, _resolve_scene(scene, nearest_first=False))
+
+        if np.array_equal(out, alt_no_rewrite):
+            return False
+        if np.array_equal(out, alt_no_settle):
+            return False
+        if np.array_equal(out, alt_reverse):
+            return False
