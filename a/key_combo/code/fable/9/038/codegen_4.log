+
+def _door_cells(center: tuple[int, int], opening: str) -> set[tuple[int, int]]:
+    r, c = center
+    cells = {
+        "up": {(r + 1, c), (r, c - 1), (r, c + 1)},
+        "right": {(r - 1, c), (r + 1, c), (r, c - 1)},
+        "down": {(r - 1, c), (r, c - 1), (r, c + 1)},
+        "left": {(r - 1, c), (r + 1, c), (r, c + 1)},
