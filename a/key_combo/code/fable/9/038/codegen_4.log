+
+    cexit_choices = [c for c in range(4, w - 4) if abs(c - c_path) >= 2 and abs(c - cb1) >= 2 and abs(c - ca2) >= 2]
+    if not cexit_choices:
+        return None
+    c_exit = random.choice(cexit_choices)
+
+    doors = [
+        {"center": (ra1, c_path), "opening": random.choice(DIR_ORDER), "color": portal_colors[0]},
+        {"center": (rmid, ca2), "opening": "right" if hsign == 1 else "left", "color": portal_colors[0]},
+        {"center": (rmid, cb1), "opening": random.choice(DIR_ORDER), "color": portal_colors[1]},
