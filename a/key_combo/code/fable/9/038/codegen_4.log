+    for color in portal_colors:
+        parts = _components8(g == color)
+        assert len(parts) == 2
+        doors: list[dict] = []
+        for comp in parts:
+            assert comp.shape[0] == 3
+            door = _infer_door(comp)
+            door["color"] = color
