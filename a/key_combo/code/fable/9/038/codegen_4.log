+        "right": {(r - 1, c), (r + 1, c), (r, c - 1)},
+        "down": {(r - 1, c), (r, c - 1), (r, c + 1)},
+        "left": {(r - 1, c), (r + 1, c), (r, c + 1)},
+    }[opening]
