+        "grid": g,
+        "shape": (h, w),
+        "side": side,
+        "init_dir": _initial_direction(side),
+        "portals": portals,
+        "portal_hit": portal_hit,
+        "portal_mask": portal_mask,
+        "stones": stones,
+        "static_mask": static_mask,
+    }
