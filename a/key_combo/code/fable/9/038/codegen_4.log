+    h, w = grid.shape
+    candidates: list[str] = []
+    if np.all(grid[0, :] == MARKER):
+        candidates.append("top")
+    if np.all(grid[:, w - 1] == MARKER):
+        candidates.append("right")
+    if np.all(grid[h - 1, :] == MARKER):
+        candidates.append("bottom")
+    if np.all(grid[:, 0] == MARKER):
