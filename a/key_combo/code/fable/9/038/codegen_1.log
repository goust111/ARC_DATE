+
+def _apply_transfer(
+    grid: np.ndarray,
+    source: dict,
+    target: dict,
+    bg: int,
+) -> np.ndarray:
+    out = np.asarray(grid, dtype=int).copy()
+    for r, c in source["path"]:
+        out[r, c] = bg
+    for r, c in target["path"]:
+        out[r, c] = bg
+
+    seq = list(source["liquid_seq"])
+    inside = min(len(seq), target["capacity"])
