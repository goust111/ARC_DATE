+    if any(color == bg for color in colors[first_filled:]):
+        return None
+    liquid_seq = colors[first_filled:]
+
+    return {
+        "bbox": (r0, c0, r1, c1),
+        "path": ordered,
+        "opening": opening,
+        "opening_dir": opening_dir,
+        "capacity": len(ordered),
+        "filled_start": first_filled,
+        "liquid_seq": liquid_seq,
+        "filled_len": len(liquid_seq),
