首轮自检暴露了解析歧义：某些随机走廊会把灰墙切成多个连通块，导致 `main()` 无法唯一识别两根管子。我先定位这种几何退化，再收紧生成器。
exec
/bin/bash -lc "python - <<'PY'
from importlib.machinery import SourceFileLoader
from pathlib import Path
import numpy as np

p = Path('/home/lixinyu/snap/a/key_combo/code/fable/9/038/1.py')
mod = SourceFileLoader('new_arc_task_dbg', str(p)).load_module()
for i in range(500):
    scene = mod._make_scene()
    if scene is None:
        continue
    inp = scene['input']
    try:
        mod._extract_tubes(inp)
    except Exception as e:
        print('failed at', i, type(e).__name__, e)
        print('shape', inp.shape)
        print('wall comps', len(mod._components_of_color(inp, mod.WALL)))
        for j, comp in enumerate(mod._components_of_color(inp, mod.WALL)):
            print(' comp', j, 'size', len(comp), 'bbox', mod._bbox(comp))
        print(inp)
        break
else:
    print('no failures')
