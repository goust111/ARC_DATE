+    for r, c in source["path"]:
+        out[r, c] = bg
+    for r, c in target["path"]:
+        out[r, c] = bg
+
+    seq = list(source["liquid_seq"])
+    inside = min(len(seq), target["capacity"])
+    if inside:
+        dst_cells = target["path"][target["capacity"] - inside :]
+        for (r, c), color in zip(dst_cells, reversed(seq[:inside])):
+            out[r, c] = color
