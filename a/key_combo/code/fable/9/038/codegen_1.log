+from __future__ import annotations
+
+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BG = 0
+WALL = 5
+LIQUID_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+SIDE_TO_VEC = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _components_of_color(grid: np.ndarray, color: int) -> list[list[tuple[int, int]]]:
+    seen: set[tuple[int, int]] = set()
+    comps: list[list[tuple[int, int]]] = []
+    for r, c in np.argwhere(grid == color):
+        cell = (int(r), int(c))
+        if cell in seen:
+            continue
+        q = deque([cell])
+        seen.add(cell)
+        comp: list[tuple[int, int]] = []
+        while q:
+            rr, cc = q.popleft()
+            comp.append((rr, cc))
+            for dr, dc in DIRS4:
+                nr, nc = rr + dr, cc + dc
+                nxt = (nr, nc)
+                if _in_bounds(grid.shape, nr, nc) and nxt not in seen and int(grid[nr, nc]) == color:
+                    seen.add(nxt)
+                    q.append(nxt)
+        comps.append(comp)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _tube_from_component(
+    grid: np.ndarray,
+    wall_coords: list[tuple[int, int]],
+    wall_color: int,
+    bg: int,
+) -> dict | None:
+    r0, c0, r1, c1 = _bbox(wall_coords)
+    corridor = [
+        (r, c)
+        for r in range(r0, r1 + 1)
+        for c in range(c0, c1 + 1)
+        if int(grid[r, c]) != wall_color
+    ]
+    if len(corridor) < 2:
+        return None
+
+    corridor_set = set(corridor)
+    boundary_cells = []
+    degrees: dict[tuple[int, int], int] = {}
+    for cell in corridor:
+        r, c = cell
+        deg = sum((r + dr, c + dc) in corridor_set for dr, dc in DIRS4)
+        if deg not in (1, 2):
+            return None
+        degrees[cell] = deg
+        if r in (r0, r1) or c in (c0, c1):
+            boundary_cells.append(cell)
+
+    if len(boundary_cells) != 1:
+        return None
+    endpoints = [cell for cell, deg in degrees.items() if deg == 1]
+    if len(endpoints) != 2:
+        return None
+    opening = boundary_cells[0]
+    if opening not in endpoints:
+        return None
+
+    open_sides = []
+    if opening[0] == r0:
+        open_sides.append((-1, 0))
+    if opening[0] == r1:
+        open_sides.append((1, 0))
+    if opening[1] == c0:
+        open_sides.append((0, -1))
+    if opening[1] == c1:
