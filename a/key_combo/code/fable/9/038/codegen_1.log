+
+def _extract_tubes(grid: np.ndarray) -> tuple[int, list[dict], int]:
+    g = np.asarray(grid, dtype=int)
+    bg = _get_bg(g)
+    candidates: list[tuple[int, list[dict]]] = []
+    for color in sorted(set(map(int, g.ravel())) - {bg}):
+        comps = _components_of_color(g, color)
+        if len(comps) != 2:
+            continue
+        tubes = []
+        ok = True
+        for comp in comps:
