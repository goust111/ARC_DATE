+def _build_path(
+    h: int,
+    w: int,
+    opening_side: str,
+    length: int,
+    require_turn: bool,
+) -> list[tuple[int, int]] | None:
+    if length > (h - 2) * (w - 2) + 1:
+        return None
+
+    if opening_side == "up":
+        starts = [(0, c) for c in range(1, w - 1)]
+    elif opening_side == "down":
+        starts = [(h - 1, c) for c in range(1, w - 1)]
+    elif opening_side == "left":
+        starts = [(r, 0) for r in range(1, h - 1)]
+    else:
+        starts = [(r, w - 1) for r in range(1, h - 1)]
