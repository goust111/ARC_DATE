+def _split_total(total: int, parts: int) -> list[int]:
+    cuts = sorted(random.sample(range(1, total), parts - 1))
+    prev = 0
+    lengths = []
+    for cut in cuts + [total]:
+        lengths.append(cut - prev)
+        prev = cut
+    return lengths
+
+
+def _make_liquid_sequence(total: int) -> tuple[list[int], list[int]]:
