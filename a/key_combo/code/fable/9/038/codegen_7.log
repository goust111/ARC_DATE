+        "bg": bg,
+        "terrain": terrain,
+        "spring_color": spring_color,
+        "spring": spring,
+        "terrain_top": terrain_top,
+        "hidden": hidden,
+        "channel_row": channel_row,
+        "basins": basins,
+        "pair": pair,
