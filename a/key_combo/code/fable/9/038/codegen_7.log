+def _fill_basin(out: np.ndarray, terrain_top: np.ndarray, basin: dict, level: int, water: int) -> None:
+    for c in range(basin["left"] + 1, basin["right"]):
+        top = int(terrain_top[c])
+        if top > level:
+            out[level:top, c] = water
+
