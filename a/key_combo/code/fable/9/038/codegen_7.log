    cols = sorted({c for _r, c, _color in objects})
    symbolic = np.full((len(rows), len(cols)), bg, dtype=int)
    row_index = {r: i for i, r in enumerate(rows)}
    col_index = {c: i for i, c in enumerate(cols)}

    for r, c, color in objects:
