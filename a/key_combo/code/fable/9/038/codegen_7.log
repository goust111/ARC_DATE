+
+BG_COLOR = 0
+WATER_COLOR = 1
+GEN_COLOR_POOL = [2, 3, 4, 5, 6, 7, 8, 9]
+MAX_GEN_ATTEMPTS = 800
+_USE_PARSED_PAIR = object()
