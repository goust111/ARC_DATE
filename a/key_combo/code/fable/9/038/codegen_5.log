+    for k in range(2, ammo + 2):
+        grid[r + k * back_dir[0], c + k * back_dir[1]] = TAIL_COLOR
+
+
+def _mirror_anchors_from_path(
+    cells: List[Tuple[int, int]], dirs: List[Tuple[int, int]]
+) -> List[Tuple[Tuple[int, int], int]]:
