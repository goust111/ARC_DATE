+
+    mirror_cells = set(scene["mirrors"].keys())
+    if len(mirror_cells - set(path)) <= 0:
+        return False
+    if MIRROR_BSLASH not in scene["mirrors"].values() or MIRROR_SLASH not in scene["mirrors"].values():
