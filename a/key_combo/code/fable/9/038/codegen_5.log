+def _forbidden_for_cannon(center: Tuple[int, int], ammo: int, direction: Tuple[int, int]) -> set:
+    forbidden = set(_ring_cells(center))
+    back_dir = (-direction[0], -direction[1])
+    for k in range(2, ammo + 2):
