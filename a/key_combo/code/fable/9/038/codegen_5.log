+        orientations = {mirror_color for _, mirror_color in mirror_anchors}
+        needed = []
+        if MIRROR_BSLASH not in orientations:
+            needed.append(MIRROR_BSLASH)
+        if MIRROR_SLASH not in orientations:
+            needed.append(MIRROR_SLASH)
