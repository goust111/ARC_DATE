+    direction = tuple(scene["direction"])
+    ammo = int(scene["ammo"])
+    back_dir = (-direction[0], -direction[1])
+    far_tail = (center[0] + (ammo + 1) * back_dir[0], center[1] + (ammo + 1) * back_dir[1])
