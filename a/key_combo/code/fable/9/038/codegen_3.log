    if np.any(grid == BLACK_COLOR) or values.size != color_count or counts.max() != dominant_count:
        return None
    if np.count_nonzero(counts == dominant_count) != 1:
        return None
    if not np.array_equal(main(grid), _gen_expected_output(grid, dominant)):
        return None
    return grid


