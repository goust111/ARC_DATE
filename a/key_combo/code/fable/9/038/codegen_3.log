    _gen_sources = set(_gen_centers)
    if _gen_horizontal:
        for _gen_r, _gen_c in _gen_centers:
            _gen_col = _gen_out[:, _gen_c]
            _gen_col[_gen_col == _GEN_BG] = _GEN_BLUE
            for _gen_rr in _gen_guides:
                if (_gen_rr, _gen_c) not in _gen_sources:
