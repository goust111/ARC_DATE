) -> np.ndarray:
    _gen_out = np.full((_gen_h, _gen_w), _GEN_BG, dtype=int)
    _gen_paint_guides(_gen_out, _gen_horizontal, _gen_guides)

    for _gen_r, _gen_c in _gen_centers:
