+def _recover_mother_binary(binary_grid: np.ndarray) -> np.ndarray:
+    h, w = binary_grid.shape
+    assert h == w, "expected a square grid"
+    n = math.isqrt(h)
+    assert n * n == h, "expected side length to be a perfect square"
