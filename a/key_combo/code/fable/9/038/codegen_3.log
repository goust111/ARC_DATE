+        **erase_meta,
+        "noise_cell": (q_r, q_c),
+        "spurious_hosts": selected_hosts,
+    }
+    return noisy, meta
+
+
+def _shortcut_masks(binary_grid: np.ndarray) -> tuple[np.ndarray, np.ndarray, np.ndarray, np.ndarray]:
+    n = math.isqrt(binary_grid.shape[0])
