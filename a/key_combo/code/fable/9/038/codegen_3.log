    occ=(b.sum(axis=(2,3))>0)
    idx=np.argwhere(occ)
    if len(idx)==0: return np.zeros((n,n),dtype=int), np.zeros((n,n),dtype=int)
    stack=np.array([b[br,bc] for br,bc in idx])
