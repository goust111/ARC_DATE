spec:
  grid: 30x30
  wallpaper:
    type: vertical or horizontal stripes
    period: 4-5 distinct colors repeating across the stripe axis
  rectangles: two non-overlapping bordered rectangles overlaid on wallpaper
  source_rect:
    outer: 9-19 rows x 8-18 cols, area > dst area [observed]
    border: uniform color, not in wallpaper palette
    interior_bg: any color != border
    sprites: 2-4 total of 1-2 distinct types; all copies of a type identical
    sprite: 2x3 or 3x3 bbox, 5-7 pixels, exactly 2 colors (body=majority, anchor=singleton)
    anchor_color: unique per type, != src_bg, != dst_bg, not in wallpaper palette
    spacing: sprites non-overlapping, >=1 cell from each other and src inner edges
  dest_rect:
    outer: 9-19 rows x 8-20 cols
    border: uniform color != src border
    interior_bg: any color != border, != any anchor color
    markers: 2-3 singleton pixels, each colored with a sprite anchor color
    marker_placement: each marker has enough margin so stamped sprite stays within interior
  colors: all role colors (borders, bgs, body, anchor) pairwise distinguishable where needed; total 7-9 distinct colors
  output: dest rect extracted as-is, interior cleared to bg, sprites stamped at marker positions (anchor pixel aligned to marker)

generation_strategy:
  approach: output-first
  steps:
    1. Choose wallpaper (direction, 4-5 colors, period = color count)
    2. Design 1-2 sprite types (2x3 or 3x3 bbox, 2 colors each, anchor is singleton pixel)
    3. Build dest rect with border + bg; place 2-3 markers using anchor colors with enough margin for full stamps
    4. Stamp sprites at marker positions to get the output
    5. Build source rect (larger area than dest); place 2-4 copies of sprites (>=1 per type) with spacing
    6. Create 30x30 wallpaper grid; overlay both rectangles (non-overlapping) onto it
    7. Assign colors ensuring anchor != src_bg, != dst_bg, not in wallpaper; border != interior_bg; src_border not in wallpaper
