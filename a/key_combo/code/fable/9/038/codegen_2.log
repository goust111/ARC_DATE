+        ray_sizes = defaultdict(int)
+        for info in selected:
+            ray_sizes[info["ray_id"]] += 1
+        if max(ray_sizes.values()) < 2:
+            continue
+        direction_kinds = {info["blocked"]["step"] for info in selected}
+        if len(direction_kinds) < 2:
+            continue
+        return selected
+    return None
+
