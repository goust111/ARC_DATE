+    for (color, terminal, step), members in groups.items():
+        tr, tc = terminal
+        dr, dc = step
+        for index, member in enumerate(sorted(members, key=lambda item: item["dist"])):
+            rr = tr - dr * index
+            cc = tc - dc * index
+            assert _in_bounds(out.shape, rr, cc)
+            assert out[rr, cc] == BG
+            out[rr, cc] = color
+
+    return out
