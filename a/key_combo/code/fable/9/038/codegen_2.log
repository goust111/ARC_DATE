+    for anchor in anchors.values():
+        for r, c in anchor["cells"]:
+            for dr in (-1, 0, 1):
+                for dc in (-1, 0, 1):
+                    rr, cc = r + dr, c + dc
+                    if _in_bounds(shape, rr, cc):
