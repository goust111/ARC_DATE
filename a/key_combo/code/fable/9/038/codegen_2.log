+
+        special_pools = [
+            misleading_pool,
+            [info for info in infos if info["ambiguous"]],
+        ]
+        if require_diag:
+            special_pools.append([info for info in infos if info["diag"]])
+        ok = True
+        for pool in special_pools:
+            if not pool:
+                continue
+            choices = pool[:]
+            random.shuffle(choices)
+            picked = False
+            for info in choices:
