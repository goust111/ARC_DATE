+        if max(ray_sizes.values()) < 2:
+            continue
+        direction_kinds = {info["blocked"]["step"] for info in selected}
+        if len(direction_kinds) < 2:
+            continue
+        return selected
+    return None
+
+
+def _validate_instance(grid: np.ndarray) -> bool:
+    anchors = _find_anchors(grid)
