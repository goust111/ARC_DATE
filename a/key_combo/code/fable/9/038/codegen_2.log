+    grid = anchor_grid.copy()
+    for r, c in blockers:
+        grid[r, c] = BLOCKER
+    for info in selected:
+        r, c = info["cell"]
+        grid[r, c] = GREY
+
+    if not _validate_instance(grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate valid line-of-sight anchor puzzle")

