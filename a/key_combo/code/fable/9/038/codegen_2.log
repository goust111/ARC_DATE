+
+def _anchor_grid(shape: tuple[int, int], anchors: dict[int, dict]) -> np.ndarray:
+    grid = np.full(shape, BG, dtype=int)
+    for color, anchor in anchors.items():
+        r0, c0, r1, c1 = anchor["bbox"]
