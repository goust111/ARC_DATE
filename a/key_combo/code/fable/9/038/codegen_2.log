+from __future__ import annotations
+
+import random
+from collections import defaultdict
+
+import numpy as np
+
+
+BG = 0
+BLOCKER = 2
+GREY = 5
+ANCHOR_COLORS = (1, 3, 4, 6, 7, 8, 9)
+DIR8 = (
+    (-1, -1),
+    (-1, 0),
+    (-1, 1),
+    (0, -1),
+    (0, 1),
+    (1, -1),
+    (1, 0),
