+
+
+def _anchor_halo(shape: tuple[int, int], anchors: dict[int, dict]) -> np.ndarray:
+    mask = np.zeros(shape, dtype=bool)
+    for anchor in anchors.values():
+        for r, c in anchor["cells"]:
+            for dr in (-1, 0, 1):
