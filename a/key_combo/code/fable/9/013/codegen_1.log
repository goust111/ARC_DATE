+                else:
+                    if turn_exit_side == "top" and r0 < 2:
+                        continue
+                    if turn_exit_side == "bottom" and r1 > h - 3:
+                        continue
+                    exit_offset = random.randint(1, width - 2)
+                    if entry_side == "left" and turn_exit_side == "top" and entry_offset == 1 and exit_offset == 1:
