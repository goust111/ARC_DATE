+        if len(terminal_cells) < 2:
+            continue
+        if any(cell in used_cells for cell in terminal_cells):
+            continue
+        if _path_hits_bboxes(list(terminal_cells), used_bboxes):
+            continue
+
+        chain = {
+            "color": color,
+            "source": source["pos"],
+            "styles": tuple(styles),
+            "steps": tuple(steps),
