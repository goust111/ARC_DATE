+SIDE_BY_OUTWARD = {v: k for k, v in OUTWARD_BY_SIDE.items()}
+OPPOSITE_SIDE = {"top": "bottom", "bottom": "top", "left": "right", "right": "left"}
+TURN_EXIT_SIDES = {
+    "top": ("left", "right"),
+    "bottom": ("left", "right"),
+    "left": ("top", "bottom"),
+    "right": ("top", "bottom"),
+}
