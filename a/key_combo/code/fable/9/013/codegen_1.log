+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+CHAIN_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+INWARD_BY_SIDE = {
+    "top": (1, 0),
+    "bottom": (-1, 0),
+    "left": (0, 1),
+    "right": (0, -1),
+}
+OUTWARD_BY_SIDE = {
+    "top": (-1, 0),
+    "bottom": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+SIDE_BY_INWARD = {v: k for k, v in INWARD_BY_SIDE.items()}
+SIDE_BY_OUTWARD = {v: k for k, v in OUTWARD_BY_SIDE.items()}
+OPPOSITE_SIDE = {"top": "bottom", "bottom": "top", "left": "right", "right": "left"}
+TURN_EXIT_SIDES = {
+    "top": ("left", "right"),
+    "bottom": ("left", "right"),
+    "left": ("top", "bottom"),
+    "right": ("top", "bottom"),
+}
+
+GRID_SIDE_RANGE = (20, 28)
+RECT_SIDE_RANGE = (4, 7)
+RUN_LENGTH_RANGE = (2, 6)
+CHAIN_ATTEMPTS = 120
+RECT_ATTEMPTS = 120
+GENERATION_ATTEMPTS = 300
