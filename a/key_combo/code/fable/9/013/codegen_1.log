+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+CHAIN_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
