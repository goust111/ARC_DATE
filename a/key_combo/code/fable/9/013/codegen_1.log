+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_ATTEMPTS):
+        result = _design_attempt()
+        if result is None:
+            continue
+        inp, expected = result
+        try:
+            if np.array_equal(main(inp), expected):
+                return inp
+        except AssertionError:
+            continue
