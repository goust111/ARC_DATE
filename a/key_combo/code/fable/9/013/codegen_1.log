+
+def _render_input(shape: tuple[int, int], rectangles: list[dict], sources: list[dict]) -> np.ndarray:
+    grid = np.zeros(shape, dtype=int)
+    for rect in rectangles:
+        r0, c0, r1, c1 = rect["bbox"]
