+
+def _in_bounds(shape: tuple[int, int], cell: tuple[int, int]) -> bool:
+    h, w = shape
+    r, c = cell
+    return 0 <= r < h and 0 <= c < w
+
+
+def _move(cell: tuple[int, int], direction: tuple[int, int], steps: int = 1) -> tuple[int, int]:
+    return cell[0] + direction[0] * steps, cell[1] + direction[1] * steps
+
+
+def _line_cells(
+    start: tuple[int, int],
+    end: tuple[int, int],
+    *,
+    include_start: bool = False,
+    include_end: bool = True,
+) -> list[tuple[int, int]]:
+    r0, c0 = start
+    r1, c1 = end
+    if r0 != r1 and c0 != c1:
+        raise ValueError("line must be axis-aligned")
+
+    cells: list[tuple[int, int]] = []
+    if r0 == r1:
+        step = 1 if c1 > c0 else -1
+        cur = c0
+        while cur != c1:
+            if include_start or cur != c0:
+                cells.append((r0, cur))
+            cur += step
+        if include_end:
+            cells.append((r1, c1))
+    else:
+        step = 1 if r1 > r0 else -1
+        cur = r0
+        while cur != r1:
+            if include_start or cur != r0:
+                cells.append((cur, c0))
+            cur += step
+        if include_end:
+            cells.append((r1, c1))
+    return cells
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                for dr, dc in DIRS:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(cells, dtype=int))
+    return comps
+
+
+def _bbox_from_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _expanded_bbox(
+    bbox: tuple[int, int, int, int],
+    shape: tuple[int, int],
+    pad: int = 1,
+) -> tuple[int, int, int, int]:
+    h, w = shape
+    r0, c0, r1, c1 = bbox
+    return max(0, r0 - pad), max(0, c0 - pad), min(h - 1, r1 + pad), min(w - 1, c1 + pad)
+
+
+def _perimeter_cells(bbox: tuple[int, int, int, int]) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    cells: list[tuple[int, int]] = []
+    for c in range(c0, c1 + 1):
+        cells.append((r0, c))
+        if r1 != r0:
+            cells.append((r1, c))
+    for r in range(r0 + 1, r1):
+        cells.append((r, c0))
+        if c1 != c0:
+            cells.append((r, c1))
+    return cells
+
+
+def _gap_side(cell: tuple[int, int], bbox: tuple[int, int, int, int]) -> str:
+    r, c = cell
+    r0, c0, r1, c1 = bbox
+    if r == r0 and c0 < c < c1:
+        return "top"
+    if r == r1 and c0 < c < c1:
+        return "bottom"
+    if c == c0 and r0 < r < r1:
+        return "left"
+    if c == c1 and r0 < r < r1:
+        return "right"
+    raise AssertionError("gap must be a non-corner perimeter cell")
+
+
+def _gap_coord(
+    bbox: tuple[int, int, int, int],
+    side: str,
+    offset: int,
+) -> tuple[int, int]:
+    r0, c0, r1, c1 = bbox
+    if side == "top":
+        return r0, c0 + offset
+    if side == "bottom":
+        return r1, c0 + offset
+    if side == "left":
+        return r0 + offset, c0
+    return r0 + offset, c1
+
+
+def _rect_signature(rect: dict) -> tuple[tuple[int, int, int, int], tuple[tuple[int, int], tuple[int, int]]]:
+    gaps = tuple(sorted(rect["gaps"]))
+    return rect["bbox"], gaps
+
+
+def _parse_rectangles(grid: np.ndarray) -> list[dict]:
+    rects: list[dict] = []
+    for coords in _components(grid == GREY):
+        bbox = _bbox_from_coords(coords)
+        r0, c0, r1, c1 = bbox
+        assert r1 - r0 >= 3 and c1 - c0 >= 3, "expected a hollow rectangle with nonempty interior"
+        grey_cells = {tuple(map(int, cell)) for cell in coords}
+        perimeter = _perimeter_cells(bbox)
+        gaps = [cell for cell in perimeter if cell not in grey_cells]
+        assert len(gaps) == 2, "each rectangle must have exactly two gaps"
+        assert len(grey_cells) == len(perimeter) - 2, "grey component must match a hollow rectangle border"
+        for rr in range(r0 + 1, r1):
+            for cc in range(c0 + 1, c1):
+                assert grid[rr, cc] == BLACK, "rectangle interiors must be blank in the input"
