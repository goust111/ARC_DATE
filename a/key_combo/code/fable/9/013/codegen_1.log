+            steps: list[dict] = []
+            position = source
+            cur_dir = direction
+            ok = True
+            for style in styles:
+                placed = _try_place_rect(trial, position, cur_dir, style)
+                if placed is None:
+                    ok = False
+                    break
+                trial, step, position, cur_dir = placed
+                steps.append(step)
