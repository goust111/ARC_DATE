+def _find_launch(
+    grid: np.ndarray,
+    gap_lookup: dict[tuple[int, int], dict],
+    source: tuple[int, int],
+) -> tuple[tuple[int, int], dict]:
+    found: list[tuple[tuple[int, int], dict]] = []
+    for direction in DIRS:
+        r, c = source
+        while True:
+            r += direction[0]
+            c += direction[1]
+            if not _in_bounds(grid.shape, (r, c)):
+                break
+            if (r, c) in gap_lookup:
