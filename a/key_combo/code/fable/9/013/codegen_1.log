+    for source in sources:
+        position = source["pos"]
+        color = source["color"]
+        direction, _ = _find_launch(grid, gap_lookup, position)
+        visited: list[tuple] = []
+
+        while True:
+            next_cell = _move(position, direction)
+            if not _in_bounds(grid.shape, next_cell):
+                traces.append(
+                    {
+                        "source": source["pos"],
+                        "direction": direction,
+                        "visited": tuple(visited),
+                        "termination": "edge",
