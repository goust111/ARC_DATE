+            assert gaps[0][1] == gaps[1][1], "opposite vertical gaps must align"
+            style = "straight"
+        elif side_set == {"left", "right"}:
+            assert gaps[0][0] == gaps[1][0], "opposite horizontal gaps must align"
+            style = "straight"
+        else:
+            assert side_b in TURN_EXIT_SIDES[side_a], "non-opposite gaps must lie on adjacent sides"
+            style = "turn"
+
+        rect = {
+            "bbox": bbox,
+            "gaps": (tuple(gaps[0]), tuple(gaps[1])),
+            "gap_sides": {tuple(gaps[0]): side_a, tuple(gaps[1]): side_b},
+            "style": style,
+        }
+        rect["signature"] = _rect_signature(rect)
+        rects.append(rect)
+
+    signatures = [rect["signature"] for rect in rects]
+    assert len(signatures) == len(set(signatures)), "rectangles must be distinct"
+    return rects
+
+
+def _parse_sources(grid: np.ndarray) -> list[dict]:
+    mask = (grid != BLACK) & (grid != GREY)
+    sources: list[dict] = []
+    for coords in _components(mask):
+        assert len(coords) == 1, "all colored non-grey pixels must be isolated sources"
+        r, c = map(int, coords[0])
+        sources.append({"pos": (r, c), "color": int(grid[r, c])})
+    assert sources, "expected at least one colored source pixel"
+    return sorted(sources, key=lambda item: item["pos"])
