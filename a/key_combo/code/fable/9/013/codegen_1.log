+                    if entry_side == "left" and turn_exit_side == "bottom" and entry_offset == height - 2 and exit_offset == 1:
+                        continue
+                    if entry_side == "right" and turn_exit_side == "top" and entry_offset == 1 and exit_offset == width - 2:
