+def _sample_layout() -> tuple[tuple[int, int], tuple[int, int], tuple[int, int]]:
+    h = random.randint(*GRID_SIDE_RANGE)
+    w = random.randint(*GRID_SIDE_RANGE)
+    split = h // 2
