    placements = _gen_place_rectangles(dim_a, dim_b)
    grid = _render_input_grid(placements)
    expected = _gen_expected_output(grid, placements)
    try:
        actual = main(grid)
    except Exception:
        return None
    if not np.array_equal(actual, expected):
        return None
    return grid


