+def _gap_coord(
+    bbox: tuple[int, int, int, int],
+    side: str,
+    offset: int,
+) -> tuple[int, int]:
+    r0, c0, r1, c1 = bbox
+    if side == "top":
+        return r0, c0 + offset
+    if side == "bottom":
+        return r1, c0 + offset
+    if side == "left":
+        return r0 + offset, c0
+    return r0 + offset, c1
+
