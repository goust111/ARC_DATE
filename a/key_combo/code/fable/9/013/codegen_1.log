+        if c1 != c0:
+            cells.append((r, c1))
+    return cells
+
+
+def _gap_side(cell: tuple[int, int], bbox: tuple[int, int, int, int]) -> str:
+    r, c = cell
+    r0, c0, r1, c1 = bbox
+    if r == r0 and c0 < c < c1:
+        return "top"
+    if r == r1 and c0 < c < c1:
+        return "bottom"
+    if c == c0 and r0 < r < r1:
+        return "left"
+    if c == c1 and r0 < r < r1:
+        return "right"
