+
+
+def _shape_two_blocks(h: int, w: int) -> np.ndarray:
+    mask = _shape_block(h, w)
+    for _ in range(30):
+        rect_h = random.randint(1, h - 2)
+        rect_w = random.randint(1, w)
+        r0 = random.randint(1, h - rect_h - 1)
+        c0 = random.randint(0, w - rect_w)
