    colors = random.sample(_GEN_FRAME_COLORS, n_frames)
    counts = random.sample(_gen_span(_GEN_MARKER_COUNT_RANGE), n_frames)
    items = list(zip(counts, colors))
    return size, items, _gen_expected_output(items)


