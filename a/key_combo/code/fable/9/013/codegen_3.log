+
+def _shape_block(h: int, w: int) -> np.ndarray:
+    mask = np.zeros((h, w), dtype=bool)
+    rect_h = random.randint(2, h - 2)
+    rect_w = random.randint(2, w)
+    r0 = random.randint(1, h - rect_h - 1)
+    c0 = random.randint(0, w - rect_w)
