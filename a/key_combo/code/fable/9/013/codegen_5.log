def _render_pair(template: np.ndarray, slots: list[tuple[int, int]]) -> tuple[np.ndarray, np.ndarray]:
    th, tw = template.shape
    out = np.full(GRID_SHAPE, BACKGROUND_COLOR, dtype=int)
    for r, c in slots:
