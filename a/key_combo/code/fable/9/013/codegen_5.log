+from collections import Counter
+import random
+
+import numpy as np
+
+
+GREY = 5
+DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+NON_GREY_COLORS = [0, 1, 2, 3, 4, 6, 7, 8, 9]
+
+GRID_ROWS_RANGE = (12, 18)
+GRID_COLS_RANGE = (12, 18)
+PATH_LEN_RANGE = (10, 22)
+TURN_RANGE = (2, 7)
+SEGMENT_STEP_RANGE = (1, 5)
+RUN_COUNT_RANGE = (3, 6)
