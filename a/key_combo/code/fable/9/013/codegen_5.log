+    endpoint_hits = [endpoint for endpoint in (end_a, end_b) if sum((dot == nbr) for nbr in _neighbors4(*endpoint)) == 1]
+    assert len(endpoint_hits) == 1, "grey dot must touch exactly one endpoint"
+    start = endpoint_hits[0]
+    if path[0] != start:
+        path.reverse()
