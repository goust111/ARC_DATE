+
+GRID_ROWS_RANGE = (12, 18)
+GRID_COLS_RANGE = (12, 18)
+PATH_LEN_RANGE = (10, 22)
+TURN_RANGE = (2, 7)
+SEGMENT_STEP_RANGE = (1, 5)
+RUN_COUNT_RANGE = (3, 6)
+RAW_RUN_LEN_RANGE = (1, 5)
+BAR_HEIGHT_RANGE = (2, 5)
