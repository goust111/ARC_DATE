+def _sample_segment_lengths(path_len: int, turns: int) -> list[int]:
+    total_steps = path_len - 1
+    n_segments = turns + 1
+    min_step, max_step = SEGMENT_STEP_RANGE
+    lengths = []
+    remaining = total_steps
