    available = {tuple(map(int, p)) for p in coords}
    for r, c in list(reserved):
        available.discard((r, c))
        for dr, dc in FOUR_NEIGHBOR_OFFSETS:
            nr, nc = r + dr, c + dc
            available.discard((nr, nc))

