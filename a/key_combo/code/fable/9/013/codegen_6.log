+def _can_place(
+    positions: list[tuple[int, int]],
+    candidate: tuple[int, int],
+    h: int,
+    w: int,
+    gap: int,
+) -> bool:
+    r, c = candidate
+    for rr, cc in positions:
+        if not (r + h - 1 + gap < rr or rr + h - 1 + gap < r or c + w - 1 + gap < cc or cc + w - 1 + gap < c):
