+        colors = color_pairs[idx]
+        marker = marker_colors[idx]
+        patch_a = _make_patch(mask, colors, marker, marker_corner)
+        patch_b = _make_patch(mask, (colors[1], colors[0]), marker, marker_corner)
+        pair_patches.append((patch_a, patch_b))
