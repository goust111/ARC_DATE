+        if local_color_counts[quad["unique_sprite"]["color"]] < 2:
+            return False
+    return True
+
+
+def _generate_attempt() -> np.ndarray | None:
+    bg, separator = random.sample(INPUT_COLORS, 2)
+    remaining = [c for c in INPUT_COLORS if c not in (bg, separator)]
