+        (0, 0, left_width),
+        (0, left_width + 1, right_width),
+        (quad_height + 1, 0, left_width),
+        (quad_height + 1, left_width + 1, right_width),
+    ]
+    meta = [None] * 4
+
+    for i, (r0, c0, qwidth) in enumerate(quad_origins):
