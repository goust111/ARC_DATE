+    right_width = max(random.choice((width_need_4, width_need_5)), random.choice((width_need_4, width_need_5)))
+
+    grid = np.full((quad_height * 2 + 1, left_width + right_width + 1), bg, dtype=int)
+    cross_r = quad_height
+    cross_c = left_width
+    grid[cross_r, :] = separator
