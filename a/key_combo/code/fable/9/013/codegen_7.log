+
+def _connect_points(mask: np.ndarray, start: tuple[int, int], end: tuple[int, int]) -> None:
+    r, c = start
+    rr, cc = end
+    if random.random() < 0.5:
+        while r != rr:
+            mask[r, c] = True
+            r += 1 if rr > r else -1
+        while c != cc:
+            mask[r, c] = True
+            c += 1 if cc > c else -1
