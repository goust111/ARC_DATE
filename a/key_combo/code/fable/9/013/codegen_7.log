_GEN_TOTAL_RECTS_RANGE, _GEN_ROOT_RANGE, _GEN_MAX_TREE_DEPTH = (4, 10), (2, 4), 3
_GEN_CHILDLESS_ROOT_NODES, _GEN_CHILD_ROOT_MIN_NODES, _GEN_CHILD_COUNT_OPTIONS = 1, 2, (1, 2)

# Rectangle sizing and nested layout.
