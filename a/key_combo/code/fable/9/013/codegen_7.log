+    color_counts = Counter(p["color"] for p in placements)
+    ranked = color_counts.most_common()
+    if len(ranked) < 2 or ranked[0][1] <= ranked[1][1]:
+        return None, {}
+    if ranked[0][0] != majority_color:
+        return None, {}
+
+    unique_entries = [p for p in placements if p["is_unique"]]
