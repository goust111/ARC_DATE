+        (0, sprite_w + 1),
+        (sprite_h + 1, 0),
+        (sprite_h + 1, sprite_w + 1),
+    ]
+    for i, (r0, c0) in enumerate(anchors):
+        color = meta[diagonal[i]]["majority_color"]
+        out[r0 : r0 + sprite_h, c0 : c0 + sprite_w][meta[i]["unique_mask"]] = color
+    return out
+
