+    ring_bboxes: list[tuple[int, int, int, int]] = []
+    for (h, w), color in zip(reversed(group["sizes_inner_to_outer"]), colors):
+        top = (outer_h - int(h)) // 2
+        left = (outer_w - int(w)) // 2
+        bbox = (top, left, top + int(h) - 1, left + int(w) - 1)
