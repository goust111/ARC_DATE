+        min_h = h1 + h2 + sep
+        min_w = max(w1, w2)
+        if min_h > 30 or min_w > 30:
+            return None
+        h = random.randint(max(GRID_H_RANGE[0], min_h), GRID_H_RANGE[1])
+        w = random.randint(max(GRID_W_RANGE[0], min_w), GRID_W_RANGE[1])
