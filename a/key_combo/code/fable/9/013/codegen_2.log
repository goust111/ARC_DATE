+        c2 = random.randint(0, w - w2)
+        placements = [(r1, c1), (r2, c2)]
+
+    grid = np.full((h, w), BG_COLOR, dtype=int)
+    for patch, (r, c) in zip(patches, placements):
+        ph, pw = patch.shape
+        grid[r : r + ph, c : c + pw] = np.where(patch != BG_COLOR, patch, grid[r : r + ph, c : c + pw])
