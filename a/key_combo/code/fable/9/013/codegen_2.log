+    counts: list[int] = []
+    used_mods: set[int] = set()
+    for i, group in enumerate(groups):
+        depth = int(group["depth"])
+        choices = list(group["low_counts"])
+        if i == forced_high:
+            choices = list(group["high_counts"])
+        elif group["high_counts"] and random.random() < 0.35:
+            choices += list(group["high_counts"])
