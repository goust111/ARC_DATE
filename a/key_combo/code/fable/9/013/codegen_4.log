+def _border_cycle(shape: tuple[int, int]) -> list[tuple[int, int]]:
+    height, width = map(int, shape)
+    coords: list[tuple[int, int]] = []
+    for c in range(width):
+        coords.append((0, c))
+    for r in range(1, height):
+        coords.append((r, width - 1))
+    for c in range(width - 2, -1, -1):
