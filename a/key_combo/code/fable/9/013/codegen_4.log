+        j = i
+        while j < len(rotated_values) and rotated_values[j] == color:
+            j += 1
+        assert j == len(rotated_values) or rotated_values[j] == BLACK, "legend segments cannot touch"
+        coords = np.array(rotated_coords[i:j], dtype=int)
+        segments.append(
