+    for r in range(interior.shape[0]):
+        for c in range(interior.shape[1]):
+            if visited[r, c] or interior[r, c] == BLACK:
+                continue
+            color = int(interior[r, c])
+            queue: deque[tuple[int, int]] = deque([(r, c)])
+            visited[r, c] = True
+            coords: list[tuple[int, int]] = []
