+def _can_place(forbidden: np.ndarray, shape: np.ndarray, top: int, left: int) -> bool:
+    coords = np.argwhere(shape != 0)
+    for dr, dc in coords:
+        rr = int(top + dr)
+        cc = int(left + dc)
+        if forbidden[rr, cc]:
+            return False
+    return True
