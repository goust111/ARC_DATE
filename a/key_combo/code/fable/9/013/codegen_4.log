+BLACK = 0
+PALETTE = tuple(range(1, 10))
+
+GRID_HEIGHT_RANGE = (12, 22)
+GRID_WIDTH_RANGE = (12, 22)
+OBJECT_COUNT_OPTIONS = (3, 4, 5)
+AREA_VALUES = tuple(range(3, 9))
+MAX_GENERATION_ATTEMPTS = 400
