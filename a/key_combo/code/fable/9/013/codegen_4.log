+        patch = _normalize_cells(cells)
+        if area >= 4 and (patch.shape[0] == 1 or patch.shape[1] == 1) and random.random() < 0.7:
+            continue
+        if area >= 5 and int(patch.sum()) == patch.size and random.random() < 0.5:
+            continue
+        return patch
