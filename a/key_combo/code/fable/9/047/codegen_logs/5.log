+def _relative_transform_kind(src: np.ndarray, dst: np.ndarray) -> str:
+    if src.shape == dst.shape and np.array_equal(src, dst):
+        return "same"
+    for k in range(4):
+        if np.array_equal(np.rot90(src, k), dst):
+            return "rotate"
+    for k in range(4):
+        if np.array_equal(np.rot90(np.fliplr(src), k), dst):
+            return "mirror"
+    return "other"
