+def _make_expected(grid: np.ndarray, sprite_places: list[dict], container_places: list[dict]) -> np.ndarray:
+    out = grid.copy()
+    for spec in sprite_places:
+        arr = spec["arr"]
+        r, c = spec["top_left"]
+        region = out[r : r + arr.shape[0], c : c + arr.shape[1]]
+        region[arr != BG] = BG
+    for container in container_places:
