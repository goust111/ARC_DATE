+                "arr": sprite,
+                "body_color": int(body_color),
+                "eye_color": int(eye_color),
+                "eye": (int(eye[0, 0]), int(eye[0, 1])),
+            }
+        )
+
+    return {
+        "bg": bg,
+        "containers": containers,
+        "holes": holes,
+        "sprites": sprites,
+        "anchors": anchors,
+        "container_mask": container_mask,
