+
+    visible_mask = np.ones(grid_shape, dtype=bool)
+    covered = 0
+    for (r0, c0, r1, c1), _kind in selected:
+        visible_mask[r0 : r1 + 1, c0 : c1 + 1] = False
+        covered += (r1 - r0 + 1) * (c1 - c0 + 1)
+
+    total = grid_shape[0] * grid_shape[1]
+    coverage = covered / total
