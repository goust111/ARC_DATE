+
+    height = int(rng.integers(GEN_HEIGHT_RANGE[0], GEN_HEIGHT_RANGE[1] + 1))
+    width = int(rng.integers(GEN_WIDTH_RANGE[0], GEN_WIDTH_RANGE[1] + 1))
+    base = _tile_grid(tile, height, width)
