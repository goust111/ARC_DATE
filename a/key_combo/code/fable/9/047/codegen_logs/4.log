spec:
  grid: 9-16 rows x 11-15 cols
  colors:
    background: any color except teal (all eval examples use maroon) [observed]
    foreground: exactly one non-bg, non-teal color (all eval use blue) [observed]
    teal: absent from input, used only in output
  objects:
    count: 2-7 4-connected foreground components
    with_hole: 1-3 objects whose binary mask has an interior hole (binary_fill_holes differs from mask)
    without_hole: 1-4 objects with no interior hole
    pixel_count: 1-17 per object; hole objects typically >=8
    bbox: 1-9 rows x 1-7 cols; hole objects need bbox >=3x3
    hole_size: 1-8 bg pixels enclosed inside the object mask
    border_touch: some objects may touch grid edge; hole objects may also touch edge
    separation: objects are generally non-overlapping in bboxes (minor corner overlap ok)
  foreground_density: 0.18-0.30 [observed]
  transform:
    recolor every object that encloses a bg hole to teal
    leave hole-free objects and all bg pixels unchanged

generation_strategy:
