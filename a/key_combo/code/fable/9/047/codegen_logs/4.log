+        return False
+
+    for i, (box_a, _kind_a) in enumerate(rectangles):
+        if not np.all(inp[box_a[0] : box_a[2] + 1, box_a[1] : box_a[3] + 1] == GRAY):
+            return False
+        for box_b, _kind_b in rectangles[i + 1 :]:
