+GEN_WIDTH_RANGE = (12, 24)
+GEN_TILE_HEIGHTS = (2, 3, 4)
+GEN_TILE_WIDTHS = (2, 3, 4)
+GEN_RECT_SIDE_MAX = 5
+GEN_RECT_COUNT_MIN = 2
+GEN_RECT_COUNT_MAX = 5
+GEN_COVERAGE_RANGE = (0.05, 0.24)
+GEN_ATTEMPTS = 400
