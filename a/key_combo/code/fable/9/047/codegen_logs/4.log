+    for row_period in range(1, height + 1):
+        for col_period in range(1, width + 1):
+            tile = _consistent_tile(grid, row_period, col_period, missing_color)
+            if tile is not None:
+                candidates.append((row_period * col_period, row_period, col_period, tile))
+
+    assert candidates, "visible cells must determine a periodic tile"
+    min_area = min(area for area, _rp, _cp, _tile in candidates)
+    best = [
+        (row_period, col_period, tile)
+        for area, row_period, col_period, tile in candidates
+        if area == min_area
