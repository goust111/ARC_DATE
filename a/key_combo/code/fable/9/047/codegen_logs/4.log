+        lambda: {"uniform": [], "mixed": []}
+    )
+    for rect_h in range(1, min(GEN_RECT_SIDE_MAX, height) + 1):
+        for rect_w in range(1, min(GEN_RECT_SIDE_MAX, width) + 1):
