+
+    inp, out = _expected_from_base(base, rectangles)
+    if not _validate_semantics(inp, out, base, tile, rectangles):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
