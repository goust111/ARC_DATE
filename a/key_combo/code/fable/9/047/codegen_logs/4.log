+) -> tuple[np.ndarray, np.ndarray]:
+    inp = base.copy()
+    out = base.copy()
+    for (r0, c0, r1, c1), kind in rectangles:
+        inp[r0 : r1 + 1, c0 : c1 + 1] = GRAY
+        if kind == "uniform":
