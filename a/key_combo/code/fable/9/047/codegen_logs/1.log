13: def main(input_grid):
14:     """
15:     Draw a green marker rectangle below each 2x2 square sized by its color count.
16: 
17:     Input structure:
18:     - The input is a 10x10 black grid with separated 2x2 colored squares.
19:     - Each square may contain one to four non-black colors.
20:     - The generated placement leaves room around squares for added markers.
21: 
22:     Rule:
23:     - Detect each multicolor square object.
24:     - Count the distinct non-black colors inside it.
25:     - Paste a green rectangle directly below the square with height equal to that count and matching square width.
26: 
27:     Key insight:
28:     - The added green shape encodes diversity inside each square: more distinct colors
29:       produce a taller marker.
30:     """
31:     # copy the input grid to the output grid
32:     output_grid = input_grid.copy()
33:     # find all connected components in the input grid
34:     bg = Color.BLACK
35:     objects = find_components(
36:         input_grid,
37:         bg=bg,
38:         connectivity=4,
39:         monochromatic=False,
40:         return_format="objects",
41:     )
42: 
43:     # for each object, draw a green rectangle below it of shape 2xL, where L is the number of colors in the square
44:     for obj in objects:
45:         b = bbox(obj != bg)
46:         if b is None:
47:             continue
48:         r0, c0 = bbox_anchor(b, anchor="upper left")
49:         h = bbox_h(b)
50:         w = bbox_w(b)
51:         num_colors = len(colors_present(obj, exclude={bg}))
52:         # Place a green rectangle just below the square.
53:         # In canonical (r,c), the rectangle extends downward with height = (#colors in the square)
54:         # and width = (square width).
55:         green_rectangle = np.full((num_colors, w), Color.GREEN)
56:         output_grid = paste(output_grid, green_rectangle, r0 + h, c0, clip=True)
57: 
58:     return output_grid
59: 
60: 
