+    ordered = sorted(
+        objects,
+        key=lambda obj: (-obj["bbox"][2], -obj["bbox"][0], obj["bbox"][1]),
+        reverse=reverse_order,
+    )
+
+    for obj in ordered:
+        top = int(obj["top"])
+        left = int(obj["left"])
+        passed_colors = set()
+        last_stop = "bottom"
+        while True:
