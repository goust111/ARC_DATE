+    for obj in ordered:
+        top = int(obj["top"])
+        left = int(obj["left"])
+        passed_colors = set()
+        last_stop = "bottom"
+        while True:
+            blocked = False
+            for dr, dc, _color in obj["cells"]:
+                r = top + dr
+                c = left + dc
+                nr = r + 1
+                if nr >= h:
+                    blocked = True
+                    last_stop = "bottom"
+                    break
+                if consider_objects and settled_mask[nr, c]:
+                    blocked = True
+                    last_stop = "object"
+                    break
+                line_color = int(line_grid[nr, c])
+                if line_color != BG:
+                    if solid_mode == "all":
+                        blocked = True
+                        last_stop = f"line:{line_color}"
+                        break
+                    if solid_mode == "keyed" and line_color == obj["key_color"]:
+                        blocked = True
+                        last_stop = f"line:{line_color}"
+                        break
+                    if solid_mode == "keyed" and line_color != obj["key_color"]:
+                        passed_colors.add(line_color)
+            if blocked:
