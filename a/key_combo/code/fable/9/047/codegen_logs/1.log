17:     """
18:     Connect each same-color pair of marker pixels with a straight segment, drawing vertical segments over horizontal ones.
19: 
20:     Input structure
21:     - The background is the dominant color.
22:     - Each foreground color appears in exactly two marker pixels.
23:     - The two markers of each color share exactly one row or exactly one column.
24: 
25:     Rule
26:     - Draw the same-color horizontal or vertical segment between each marker pair, inclusive.
27:     - Paint horizontal segments first, then vertical segments so crossings keep the vertical segment color.
28: 
29:     Key insight
30:     - The colored pixels are not isolated objects; same-color pairs are endpoints of axis-aligned segments, and segment orientation determines the crossing layer.
31:     """
32:     g = np.asarray(grid, dtype=int)
33:     bg = get_bg(g)
34:     out = g.copy()
35: 
36:     horizontal_segments = []
37:     vertical_segments = []
38:     occupied_by_orientation = {"horizontal": set(), "vertical": set()}
39:     for color in colors_present(g, exclude={bg}):
40:         coords = np.argwhere(g == color)
41:         assert coords.shape == (2, 2)
42:         (r0, c0), (r1, c1) = coords.tolist()
43:         assert (r0 == r1) ^ (c0 == c1)
44: 
45:         segment = (int(color), int(r0), int(c0), int(r1), int(c1))
46:         if r0 == r1:
47:             cells = _segment_cells(r0, c0, r1, c1)
48:             assert occupied_by_orientation["horizontal"].isdisjoint(cells)
49:             occupied_by_orientation["horizontal"].update(cells)
50:             horizontal_segments.append(segment)
51:         else:
52:             cells = _segment_cells(r0, c0, r1, c1)
53:             assert occupied_by_orientation["vertical"].isdisjoint(cells)
54:             occupied_by_orientation["vertical"].update(cells)
55:             vertical_segments.append(segment)
56: 
57:     for color, r0, c0, r1, c1 in horizontal_segments:
58:         draw_line(out, r0, c0, end_r=r1, end_c=c1, color=color)
59:     for color, r0, c0, r1, c1 in vertical_segments:
60:         draw_line(out, r0, c0, end_r=r1, end_c=c1, color=color)
61: 
62:     return out
