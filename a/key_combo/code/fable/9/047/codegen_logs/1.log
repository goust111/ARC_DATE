111: def main(grid: np.ndarray) -> np.ndarray:
112:     """
113:     Move every small colored sprite into the enclosed holes of the large objects and erase the grey markers.
114: 
115:     Input structure
116:     - The background is the dominant color.
117:     - Grey pixels are isolated marker noise.
118:     - Some non-grey foreground components are large monochromatic objects with enclosed background holes.
119:     - The remaining non-grey foreground components are source sprites outside those holes.
120: 
121:     Rule
122:     - Detect the enclosed background holes inside the large objects.
123:     - Translate each source sprite without rotation or recoloring.
124:     - Use every source sprite exactly once so the translated sprite masks exactly partition all hole cells.
125:     - Clear the original source sprite cells and all grey marker pixels; preserve the large objects.
126: 
127:     Key insight
128:     - The destination is not chosen by color or position: the set of sprite shapes has a unique exact tiling of the enclosed holes.
129:     """
130:     g = np.asarray(grid, dtype=int)
131:     bg = get_bg(g)
132: 
133:     components = find_components(g, bg=bg, connectivity=4, monochromatic=True)
134:     grey_components = [comp for comp in components if int(comp["color"]) == Color.GREY]
135:     assert grey_components
136:     assert all(comp["area"] == 1 for comp in grey_components)
137: 
138:     containers = set()
139:     holes = []
140:     for index, comp in enumerate(components):
141:         if int(comp["color"]) == Color.GREY:
142:             continue
143:         comp_holes = _component_holes(g, comp)
144:         if comp_holes:
145:             containers.add(index)
146:             holes.extend(comp_holes)
147: 
148:     assert containers
149:     assert holes
150: 
151:     sprites = []
152:     for index, comp in enumerate(components):
153:         if index in containers or int(comp["color"]) == Color.GREY:
154:             continue
155:         coords = comp["coords"]
156:         r0, c0, _r1, _c1 = comp["bbox"]
157:         rel = coords - np.array([r0, c0])
158:         sprites.append(
159:             {
160:                 "color": int(comp["color"]),
161:                 "coords": coords,
162:                 "rel": [tuple(map(int, rc)) for rc in rel.tolist()],
163:                 "area": int(comp["area"]),
164:             }
165:         )
166: 
167:     assert sprites
168:     tiling = _unique_tiling(sprites, holes)
169: 
170:     out = g.copy()
171:     for comp in grey_components:
172:         coords = comp["coords"]
173:         out[coords[:, 0], coords[:, 1]] = bg
174:     for sprite in sprites:
175:         coords = sprite["coords"]
176:         out[coords[:, 0], coords[:, 1]] = bg
177:     for sprite_index, cells in tiling:
178:         color = sprites[sprite_index]["color"]
