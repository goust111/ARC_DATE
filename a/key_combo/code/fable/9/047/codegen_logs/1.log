+    line_grid = _build_line_grid(g, lines, draw_lines=draw_lines)
+    out = line_grid.copy()
+    settled_mask = np.zeros_like(g, dtype=bool)
+    settled_objects = []
+    traces = []
+
+    ordered = sorted(
+        objects,
+        key=lambda obj: (-obj["bbox"][2], -obj["bbox"][0], obj["bbox"][1]),
+        reverse=reverse_order,
+    )
