+    a_input_top = pick_input_top(positions["A"][0], sprite_a.shape[0], 2, positions["A"][0] - 6)
+    c_input_top = pick_input_top(positions["C"][0], sprite_c.shape[0], 1, positions["C"][0] - 4)
