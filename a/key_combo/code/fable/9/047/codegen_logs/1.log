+        occupied = {}
+        for color, (row, c0, c1) in lines.items():
+            for c in range(c0, c1 + 1):
+                prev = occupied.get((row, c))
+                if prev is not None and prev != color:
+                    raise AssertionError("different horizontal lines cannot overlap")
+                occupied[(row, c)] = color
+                out[row, c] = color
