+                "top": int(r0),
+                "left": int(c0),
+                "height": int(r1 - r0 + 1),
+                "width": int(c1 - c0 + 1),
+                "cells": cell_map,
+                "key_color": int(key_color),
+                "key_rel": (int(key_dr), int(key_dc)),
+                "body_color": int(next(iter(body_colors))),
