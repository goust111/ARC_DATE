15: def main(input_grid: np.ndarray) -> np.ndarray:
16:     """
17:     Add yellow diagonal marks around red pixels and orange orthogonal marks around blue pixels.
18: 
19:     Input structure:
20:     - The input is a black grid with scattered single colored pixels.
21:     - Red and blue pixels are special markers.
22:     - Other colors may appear but do not trigger any expansion.
23: 
24:     Rule:
25:     - Preserve the original grid.
26:     - Around each red pixel, color the four diagonal neighbors yellow when in bounds.
27:     - Around each blue pixel, color the four cardinal neighbors orange when in bounds.
28: 
29:     Key insight:
30:     - Marker color selects the neighborhood geometry: red emits diagonal corners, while blue emits
31:       orthogonal side-neighbors.
32:     """
33: 
34:     output_grid = np.copy(input_grid)
35: 
36:     for r in range(input_grid.shape[0]):
37:         for c in range(input_grid.shape[1]):
38:             color = input_grid[r][c]
39:             if color == Color.RED:
40:                 # put yellow pixels in the diagonals
41:                 for dr in [-1, 1]:
42:                     for dc in [-1, 1]:
43:                         if 0 <= r+dr < input_grid.shape[0] and 0 <= c+dc < input_grid.shape[1]:
44:                             output_grid[r+dr, c+dc] = Color.YELLOW
45:             elif color == Color.BLUE:
46:                 # put orange pixels in the neighbors
47:                 for dr, dc in [(0, -1), (0, 1), (-1, 0), (1, 0)]:
48:                     if 0 <= r+dr < input_grid.shape[0] and 0 <= c+dc < input_grid.shape[1]:
49:                         output_grid[r+dr, c+dc] = Color.ORANGE
50: 
51:     return output_grid
52: 
