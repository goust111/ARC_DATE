+
+
+def _anchor_on_target(
+    shape: set[Coord],
+    target_cell: Coord,
+    height: int,
+    width: int,
+    occupied: set[Coord],
+    rng: random.Random,
+) -> set[Coord] | None:
+    anchors = list(shape)
+    rng.shuffle(anchors)
