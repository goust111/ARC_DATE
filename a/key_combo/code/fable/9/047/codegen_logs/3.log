29:def main(grid: np.ndarray) -> np.ndarray:
30:    """
31:    Complete a corrupted periodic two-color pattern by replacing each pink marker with the tile value at that position.
32:
33:    Input structure:
34:    - The grid contains exactly two visible pattern colors plus pink marker pixels.
35:    - Ignoring the pink cells, all visible pixels are consistent with one smallest rectangular repeating tile.
36:
37:    Rule:
38:    - Treat pink pixels as missing values.
39:    - Infer the unique minimum-area row/column period whose residues all have a single visible color.
40:    - Repaint each pink pixel with the inferred tile color at the same grid coordinate.
41:
42:    Key insight:
43:    The pink pixels are occlusions in a global periodic tile, not independent objects.
44:    """
45:    g = np.asarray(grid, dtype=int)
46:    colors = set(map(int, np.unique(g)))
47:    assert MISSING_COLOR in colors, "expected pink missing-value pixels"
48:    visible_colors = colors - {MISSING_COLOR}
49:    assert len(visible_colors) == 2, "expected exactly two visible pattern colors"
50:
51:    h, w = g.shape
52:    candidates: list[tuple[int, int, int, np.ndarray]] = []
53:    for row_period in range(1, h + 1):
54:        for col_period in range(1, w + 1):
55:            tile = _consistent_tile(g, row_period, col_period)
56:            if tile is not None:
57:                candidates.append((row_period * col_period, row_period, col_period, tile))
58:
59:    assert candidates, "visible pixels must define a periodic tile"
60:    min_area = min(area for area, _row_period, _col_period, _tile in candidates)
61:    minimal = [
62:        (row_period, col_period, tile)
63:        for area, row_period, col_period, tile in candidates
64:        if area == min_area
65:    ]
66:    assert len(minimal) == 1, "minimum-area period must be unique"
67:
68:    row_period, col_period, tile = minimal[0]
69:    assert set(map(int, tile.ravel())) == visible_colors, "tile must use both pattern colors"
70:
71:    out = g.copy()
72:    for r, c in np.argwhere(out == MISSING_COLOR):
73:        out[int(r), int(c)] = tile[int(r) % row_period, int(c) % col_period]
74:    return out
