+        "templates": templates,
+        "analyses": analyses,
+        "matched": matched,
+        "scraps": scraps,
+    }
+
+
+def _make_scrap(rng: random.Random, templates: list[set[Coord]]) -> set[Coord] | None:
+    for _ in range(80):
