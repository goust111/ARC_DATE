178:def _gen_attempt() -> np.ndarray | None:
179:    size = random.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)
180:    rect_side = random.randint(RECT_SIDE_MIN, min(RECT_SIDE_MAX, size - RECT_CANVAS_MARGIN))
181:    gap = random.randint(GAP_MIN, GAP_MAX)
182:    if 2 * rect_side + gap > size:
183:        return None
184:
185:    horizontal = random.choice(BINARY_CHOICES)
186:    src_axis0, src_axis1, dst_axis0, dst_axis1, gap_cells = _sample_axis_layout(size, rect_side, gap)
187:    gate_choice = _gen_gate_positions(size, gap_cells)
188:    if gate_choice is None:
189:        return None
190:    gate_positions, red_positions = gate_choice
191:
192:    cross0 = random.randint(CROSS_AXIS_PADDING, size - rect_side - CROSS_AXIS_PADDING)
193:    cross1 = cross0 + rect_side - 1
194:    output = np.full((size, size), BACKGROUND_COLOR, dtype=int)
195:
196:    for pos in gate_positions:
197:        if horizontal:
198:            output[cross0 - GATE_SEGMENT_LEN : cross0, pos] = GATE_COLOR
199:            output[cross1 + 1 : cross1 + 1 + GATE_SEGMENT_LEN, pos] = GATE_COLOR
200:        else:
201:            output[pos, cross0 - GATE_SEGMENT_LEN : cross0] = GATE_COLOR
202:            output[pos, cross1 + 1 : cross1 + 1 + GATE_SEGMENT_LEN] = GATE_COLOR
203:    _paint_rect(output, horizontal, dst_axis0, dst_axis1, cross0, cross1, SOURCE_COLOR)
204:    for pos in red_positions:
205:        if horizontal:
206:            output[cross0 : cross1 + 1, pos] = RED_COLOR
207:        else:
208:            output[pos, cross0 : cross1 + 1] = RED_COLOR
209:
210:    inp = output.copy()
211:    inp[inp == RED_COLOR] = BACKGROUND_COLOR
212:    _paint_rect(inp, horizontal, dst_axis0, dst_axis1, cross0, cross1, TARGET_COLOR)
213:    _paint_rect(inp, horizontal, src_axis0, src_axis1, cross0, cross1, SOURCE_COLOR)
214:
215:    if np.array_equal(main(inp), output):
216:        return inp
217:    return None
