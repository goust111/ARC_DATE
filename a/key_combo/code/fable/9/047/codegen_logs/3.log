96:def _gen_min_period_area(tile: np.ndarray) -> int:
97:    h, w = tile.shape
98:    areas = []
99:    for rh in range(1, h + 1):
100:        for cw in range(1, w + 1):
101:            ok = True
102:            for r in range(h):
103:                for c in range(w):
104:                    if tile[r, c] != tile[r % rh, c % cw]:
105:                        ok = False
106:                        break
107:                if not ok:
108:                    break
109:            if ok:
110:                areas.append(rh * cw)
111:    return min(areas)
