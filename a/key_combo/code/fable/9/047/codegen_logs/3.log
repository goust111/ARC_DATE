83:def _choose_shape_indices(rng):
84:    """Return all six shape ids plus 0-2 duplicate ids, then shuffle them."""
85:    num_objects = rng.integers(MIN_OBJECTS, MAX_OBJECTS_EXCLUSIVE)
86:    shape_indices = list(range(len(SHAPES)))
87:    num_duplicates = num_objects - len(SHAPES)
88:    if num_duplicates > 0:
89:        shape_indices.extend(rng.integers(0, len(SHAPES), size=num_duplicates).tolist())
90:    rng.shuffle(shape_indices)
91:    return shape_indices
