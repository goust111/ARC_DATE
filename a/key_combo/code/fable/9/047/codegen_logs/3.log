+
+
+def _valid_shifts(shape: set[Coord], height: int, width: int) -> list[Coord]:
+    r0, c0, r1, c1 = _bbox(shape)
+    return [
+        (dr, dc)
+        for dr in range(-r0, height - r1)
+        for dc in range(-c0, width - c1)
