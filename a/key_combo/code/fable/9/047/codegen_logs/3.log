20:def main(grid: np.ndarray) -> np.ndarray:
21:    """Recolor every foreground object that encloses a background hole to teal.
22:
23:    Input structure
24:    - The grid has one dominant background color and exactly one foreground color.
25:    - The foreground pixels form separate 4-connected objects.
26:    - Teal is absent from the input and is reserved as the output mark.
27:
28:    Rule
29:    - Keep objects whose bbox contains no enclosed background region unchanged.
30:    - For each foreground object with a 4-connected background hole inside its bbox, recolor all of that object's pixels to teal.
31:    - Leave background pixels unchanged, including the holes themselves.
32:
33:    Key insight
34:    - The changed objects are selected by topology, not by size or position: they are precisely the objects whose mask has an interior hole.
35:    """
36:    g = np.asarray(grid, dtype=int)
37:    assert g.ndim == 2, "expected a 2D grid"
38:    assert Color.TEAL not in set(map(int, g.ravel())), "teal must be output-only"
39:
40:    bg = get_bg(g)
41:    foreground_colors = colors_present(g, exclude={bg})
42:    assert len(foreground_colors) == 1, "expected exactly one foreground color"
43:    foreground_color = foreground_colors[0]
44:
45:    out = g.copy()
46:    selected = 0
47:    components = find_components(g, bg=bg, colors=[foreground_color], connectivity=4, monochromatic=True)
48:    assert components, "expected at least one foreground object"
49:
50:    for component in components:
51:        coords = component["coords"]
52:        obj_mask = _mask_in_bbox(coords, component["bbox"])
53:        if _has_enclosed_hole(obj_mask):
54:            out[coords[:, 0], coords[:, 1]] = Color.TEAL
55:            selected += 1
56:
57:    assert selected > 0, "expected at least one hole-containing object"
58:    assert np.any(out != g), "expected a visible recolor"
59:    return out
