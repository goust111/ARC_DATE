141:def _gen_gate_positions(size: int, gap_cells: list[int]) -> tuple[list[int], list[int]] | None:
142:    choices: list[tuple[list[int], list[int]]] = []
143:    for between_count in BETWEEN_GATE_COUNTS:
144:        for between in _gen_between_positions(gap_cells, between_count):
145:            remaining = GATE_TOTAL_MAX - between_count
146:            max_left = min(remaining, (between[0] + 1) // GATE_SPACING_MIN)
147:            max_right = min(remaining, (size - between[-1]) // GATE_SPACING_MIN)
148:            for left_count in range(max_left + 1):
149:                for right_count in range(max_right + 1):
150:                    total = between_count + left_count + right_count
151:                    if not (GATE_TOTAL_MIN <= total <= GATE_TOTAL_MAX):
152:                        continue
153:                    for left in _gen_extensions(between[0], size - 1, left_count, -1):
154:                        for right in _gen_extensions(between[-1], size - 1, right_count, 1):
155:                            choices.append((left + list(between) + right, list(between)))
156:    if not choices:
157:        return None
158:    return random.choice(choices)
