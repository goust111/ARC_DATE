17:def main(grid: np.ndarray) -> np.ndarray:
18:    """
19:    Select the majority interior marker color, then redraw the framed board as that color's frame plus its bounding-box outline.
20:
21:    Input structure:
22:    - The top row is a copied palette made from adjacent equal color pairs.
23:    - Below it is a one-cell-thick rectangular frame around a black interior.
24:    - Non-black, non-frame interior pixels are marker colors; one marker color has
25:      the unique highest count.
26:
27:    Rule:
28:    - Keep the palette row unchanged.
29:    - Pick the uniquely most frequent interior marker color.
30:    - Clear the lower board to black, recolor its outer frame with the picked color,
31:      and draw the picked color's interior bounding-box border.
32:
33:    Key insight:
34:    - The noisy marker cloud is not preserved as pixels; only the majority marker
35:      color and its spatial extent define the output.
36:    """
37:    g = np.asarray(grid, dtype=int)
38:    assert g.ndim == 2, "expected a 2D grid"
39:    height, width = map(int, g.shape)
40:    assert height >= 4 and width >= 4, "expected room for a palette row, frame, and interior"
41:
42:    palette = g[0, :].copy()
43:    assert width % 2 == 0, "palette row must split into adjacent color pairs"
44:    palette_pairs = palette.reshape(-1, 2)
45:    assert np.all(palette_pairs[:, 0] == palette_pairs[:, 1]), "expected paired palette colors"
46:    palette_colors = set(map(int, palette_pairs[:, 0]))
47:
48:    frame_color = int(g[1, 0])
49:    assert frame_color != Color.BLACK, "frame must be non-black"
50:    assert frame_color in palette_colors, "frame color must appear in the palette row"
51:    assert np.all(g[1, :] == frame_color), "top of lower frame must be solid"
52:    assert np.all(g[-1, :] == frame_color), "bottom of lower frame must be solid"
53:    assert np.all(g[1:, 0] == frame_color), "left side of lower frame must be solid"
54:    assert np.all(g[1:, -1] == frame_color), "right side of lower frame must be solid"
55:
56:    interior = g[2:-1, 1:-1]
57:    marker_mask = (interior != Color.BLACK) & (interior != frame_color)
58:    marker_values = interior[marker_mask]
59:    assert set(map(int, marker_values)).issubset(palette_colors), "marker colors must come from the palette row"
60:    draw_color = _unique_most_frequent_color(marker_values)
61:
62:    selected_mask = np.zeros(g.shape, dtype=bool)
63:    selected_mask[2:-1, 1:-1] = interior == draw_color
64:    selected_bbox = bbox(selected_mask)
65:    assert selected_bbox is not None, "selected marker color must have a bounding box"
66:    r0, c0, r1, c1 = selected_bbox
67:
68:    out = np.zeros_like(g)
69:    out[0, :] = palette
70:
71:    out[1, :] = draw_color
72:    out[-1, :] = draw_color
73:    out[1:, 0] = draw_color
74:    out[1:, -1] = draw_color
75:
76:    out[r0 : r1 + 1, c0] = draw_color
77:    out[r0 : r1 + 1, c1] = draw_color
78:    out[r0, c0 : c1 + 1] = draw_color
79:    out[r1, c0 : c1 + 1] = draw_color
80:
81:    return out
