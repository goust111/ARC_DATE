22:def main(grid: np.ndarray) -> np.ndarray:
23:    """Recolor each placeholder object according to its normalized shape while leaving the background fixed.
24:
25:    Input structure
26:    A same-size grid with one dominant background color and one foreground
27:    placeholder color forming separated 4-connected objects.
28:
29:    Rule
30:    Replace every placeholder object by the color assigned to its exact
31:    translation-normalized mask; all background pixels remain unchanged.
32:
33:    Key insight
34:    The input objects are a shape legend with repeated instances: identical
35:    masks always receive identical colors, independent of their position.
36:    """
37:    g = np.asarray(grid, dtype=int)
