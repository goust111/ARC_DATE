+        if _shape_contains(t3, base):
+            continue
+        norms = {
+            tuple(sorted(_normalize_shape(base))),
+            tuple(sorted(_normalize_shape(t1))),
+            tuple(sorted(_normalize_shape(t2))),
+        }
+        if tuple(sorted(_normalize_shape(t3))) in norms:
+            continue
+        break
+    else:
+        return None
