112:def _place_shape(grid, occupied, cells, shape_h, shape_w, rng):
113:    """Place one shape at the first free candidate in a randomized scan."""
114:    for r, c in _shuffled_positions(rng, shape_h, shape_w):
115:        if occupied[r:r + shape_h, c:c + shape_w].any():
116:            continue
