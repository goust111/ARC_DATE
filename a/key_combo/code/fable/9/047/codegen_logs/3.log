+import numpy as np
+
+
+BACKGROUND = 0
+GREY = 5
+COLOR_POOL = [1, 2, 3, 4, 6, 7, 8, 9]
+SHAPE_CANVAS = 7
+GEN_ATTEMPTS = 400
+
