+def _anchor_on_target(
+    shape: set[Coord],
+    target_cell: Coord,
+    height: int,
+    width: int,
+    occupied: set[Coord],
+    rng: random.Random,
+) -> set[Coord] | None:
+    anchors = list(shape)
+    rng.shuffle(anchors)
+    for ar, ac in anchors:
+        dr = target_cell[0] - ar
+        dc = target_cell[1] - ac
+        cells = _translate(shape, dr, dc)
+        if _cells_fit(cells, height, width) and not _touches_occupied(cells, occupied, 0):
