19:def main(grid: np.ndarray) -> np.ndarray:
20:    """
21:    Move the orange rectangle onto the maroon rectangle and mark gated corridor crossings in red.
22:
23:    Input structure
24:    - The dominant background contains black obstacle segments.
25:    - There is one solid orange rectangle and one solid maroon rectangle of the same size.
26:    - The two rectangles share either their row span or their column span, so the move is straight and axis-aligned.
27:
28:    Rule
29:    - Erase the original orange rectangle to the background.
30:    - Replace the maroon rectangle with the orange rectangle.
31:    - Between the two rectangles, paint red across the moving rectangle's width or height only at corridor cells flanked by black obstacle segments perpendicular to the movement.
32:
33:    Key insight
34:    - The black segments define gates in the straight corridor; only those gated openings, not every swept background cell, become red.
35:    """
36:    g = np.asarray(grid, dtype=int)
37:    bg = get_bg(g)
38:
39:    source = _solid_rect_bbox(g, Color.ORANGE)
40:    target = _solid_rect_bbox(g, Color.MAROON)
41:    sr0, sc0, sr1, sc1 = source
42:    tr0, tc0, tr1, tc1 = target
43:
44:    assert (sr1 - sr0, sc1 - sc0) == (tr1 - tr0, tc1 - tc0), "rectangles must have the same size"
45:    same_cols = (sc0, sc1) == (tc0, tc1)
46:    same_rows = (sr0, sr1) == (tr0, tr1)
47:    assert same_cols != same_rows, "rectangles must align on exactly one axis"
48:
49:    out = g.copy()
50:    out[g == Color.ORANGE] = bg
51:    out[tr0 : tr1 + 1, tc0 : tc1 + 1] = Color.ORANGE
52:
53:    H, W = g.shape
54:    if same_cols:
55:        c0, c1 = sc0, sc1
56:        rows = range(tr1 + 1, sr0) if sr0 > tr0 else range(sr1 + 1, tr0)
57:        for r in rows:
58:            gated = (
59:                c0 > 0
60:                and c1 + 1 < W
61:                and g[r, c0 - 1] == Color.BLACK
62:                and g[r, c1 + 1] == Color.BLACK
63:            )
64:            if gated:
65:                assert np.all(g[r, c0 : c1 + 1] == bg), "gated opening must be background before painting"
66:                out[r, c0 : c1 + 1] = Color.RED
67:    else:
68:        r0, r1 = sr0, sr1
69:        cols = range(tc1 + 1, sc0) if sc0 > tc0 else range(sc1 + 1, tc0)
70:        for c in cols:
71:            gated = (
72:                r0 > 0
73:                and r1 + 1 < H
74:                and g[r0 - 1, c] == Color.BLACK
75:                and g[r1 + 1, c] == Color.BLACK
76:            )
77:            if gated:
78:                assert np.all(g[r0 : r1 + 1, c] == bg), "gated opening must be background before painting"
79:                out[r0 : r1 + 1, c] = Color.RED
80:
81:    return out
