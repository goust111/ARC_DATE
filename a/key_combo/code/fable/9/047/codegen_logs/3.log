126:def _gen_make_tile(colors: tuple[int, int], size: int) -> np.ndarray:
127:    majority, minority = colors
128:    area = size * size
129:    minority_low, minority_high = _GEN_MINORITY_COUNT_BY_SIZE[size]
130:    minority_count = minority_low
131:    if minority_low != minority_high:
132:        minority_count = random.randint(minority_low, minority_high)
133:    cell_coords = [(r, c) for r in range(size) for c in range(size)]
134:
135:    valid_sets: list[tuple[tuple[int, int], ...]] = []
136:    for coords in itertools.combinations(cell_coords, minority_count):
137:        tile = _gen_tile_from_coords(majority, minority, size, coords)
138:        if _gen_min_period_area(tile) == area:
139:            valid_sets.append(coords)
140:
141:    coords = random.choice(valid_sets)
142:    return _gen_tile_from_coords(majority, minority, size, coords)
