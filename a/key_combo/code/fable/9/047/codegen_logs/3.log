161:def _sample_axis_layout(size: int, rect_side: int, gap: int) -> tuple[int, int, int, int, list[int]]:
162:    """Sample aligned source/target spans and return the corridor cells between them."""
163:    source_first = random.choice(BINARY_CHOICES)
164:    span0 = random.randint(0, size - (2 * rect_side + gap))
165:    first0, second0 = span0, span0 + rect_side + gap
166:    src_axis0, dst_axis0 = (first0, second0) if source_first else (second0, first0)
167:    gap_cells = list(range(span0 + rect_side, span0 + rect_side + gap))
168:    return src_axis0, src_axis0 + rect_side - 1, dst_axis0, dst_axis0 + rect_side - 1, gap_cells
