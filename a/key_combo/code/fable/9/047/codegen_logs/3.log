15:def main(input_grid):
16:    """
17:    Place each large multicolor object over the sparse matching pixels after trying rotations and flips.
18:
19:    Input structure:
20:    - The input contains one or two larger multicolor objects on a black background.
21:    - It also contains small clusters of colored pixels that are partial views of those objects.
22:    - Objects may need rotation or reflection to align with their pixel guides.
23:
24:    Rule:
25:    - Separate large objects from small pixel clusters.
26:    - Generate rotated and flipped variants of each large object.
27:    - Choose the placement and variant that covers the most guide pixels without any color mismatch.
28:
29:    Key insight:
30:    - The sparse pixels are anchors for transformed copies: color-consistent overlap identifies both
31:      the orientation and the position of each object.
32:    """
33:    # Plan:
34:    # 1. Break the input into 1-2 big object(s) and a mask containing the remaining pixels
35:    # 2. For each object, create rotations and flips of it
36:    # 3. For each object, find the best way to place one of its rotations/flips so that it covers the most number of the pixels (remember the pixel has to match object color)
37:
38:    # Extract the objects from the input and categorize them into objects and pixels
39:    # Objects can be multicolored
40:    connected_components = find_components(input_grid, bg=Color.BLACK, connectivity=4, monochromatic=False, return_format="objects")
41:    objects = [ cc for cc in connected_components if np.count_nonzero(cc != Color.BLACK) > 4 ]
42:    pixels = [ cc for cc in connected_components if np.count_nonzero(cc != Color.BLACK) <= 4 ]
43:
44:    # Make the pixel mask, which shows where the pixels are. These guide the placement of objects.
45:    pixel_mask = np.full(input_grid.shape, Color.BLACK)
46:    for pixel_object in pixels:
47:        paste(pixel_mask, pixel_object, 0, 0, transparent=Color.BLACK, clip=True)
48:
49:    output_grid = np.full(input_grid.shape, Color.BLACK)
50:
51:    # For each object, find the best way to place it so that it covers the most number of the pixels
52:    for obj in objects:
53:        # The object can be rotated and flipped to match the pixels
54:        # First, convert it to a sprite before transforming, because these operations are independent of position
55:        _b = bbox(obj != Color.BLACK)
56:        assert _b is not None
57:        sprite = crop_bbox(obj, _b)
58:        sprite_variations = [sprite, np.rot90(sprite), np.rot90(sprite, 2), np.rot90(sprite, 3), np.flipud(sprite), np.fliplr(sprite), np.flipud(np.rot90(sprite)), np.fliplr(np.rot90(sprite))]
59:
60:        # We are going to optimize the position and variation, so we need to keep track of the best placement so far
61:        best_output, best_pixels_covered = None, 0
62:        for r, c, sprite_variation in [(r, c, variant) for r in range(input_grid.shape[0]) for c in range(input_grid.shape[1]) for variant in sprite_variations]:
63:            test_grid = np.copy(output_grid)
64:            paste(test_grid, sprite_variation, r, c, transparent=Color.BLACK, clip=True)
65:            # Check if there was any color mismatch: A colored pixel in the mask which is different from what we just made
66:            # If there is a mismatch, we can't place the object here
67:            if np.any((pixel_mask != Color.BLACK) & (test_grid != Color.BLACK) & (pixel_mask != test_grid)):
68:                continue
69:            num_covered_pixels = np.count_nonzero((pixel_mask != Color.BLACK) & (test_grid != Color.BLACK))
70:            if num_covered_pixels > best_pixels_covered:
71:                best_output, best_pixels_covered = test_grid, num_covered_pixels
72:        output_grid = best_output
73:
74:    return output_grid
75:
76:
77:def generate_input():
78:    # to make the input, we make random objects
79:    # we need to make sure that the objects can match with the "sprinkled" pixels, so we make the pixels by placing some objects and then removing some parts of them
80:
81:    n, m = np.random.randint(10, 20), np.random.randint(10, 20)
82:    grid = np.full((m, n), Color.BLACK)
83:
84:    num_objects = np.random.randint(1, 3)
85:    sprites = [ random_sprite(np.random.randint(3, 6), np.random.randint(3, 6), color_palette=Color.NOT_BLACK, density=0.5)
86:                for _ in range(num_objects) ]
87:    sprite_variations = [ [sprite, np.rot90(sprite, k=-1), np.rot90(sprite,-(2)), np.rot90(sprite,-(3)), np.fliplr(sprite), np.flipud(sprite), np.fliplr(np.rot90(sprite, k=-1)), np.flipud(np.rot90(sprite, k=-1))]
88:                          for sprite in sprites ]
89:    # Pick a variation for each sprite
90:    sprite_variations = [ random.choice(variations) for variations in sprite_variations ]
91:
92:    # Remove parts of the sprite to create the "sprinkled" pixels
93:    # We remove enough of the sprite so that there are only 3 pixels remaining
94:    # We do this to the variation, which is what is going to be put on the canvas to be matched with
95:    occluded_sprites = []
96:    for sprite in sprite_variations:
97:        occluded_sprite = np.copy(sprite)
98:        could_be_removed = np.argwhere(occluded_sprite != Color.BLACK)
99:        np.random.shuffle(could_be_removed)
100:        for i in range(len(could_be_removed) - 3):
101:            r, c = could_be_removed[i]
102:            occluded_sprite[r, c] = Color.BLACK
103:
104:        occluded_sprites.append(occluded_sprite)
105:
106:    # place everything on the canvas but make sure that nothing overlaps
107:    for sprite in sprites + occluded_sprites:
108:        _loc = first_free_location(grid, sprite, transparent=Color.BLACK, border=2, padding=2, padding_connectivity=8)
109:        if _loc is None:
110:            # Retry generation (placement can fail due to padding constraints).
111:            return generate_input()
112:        r, c = _loc
113:        paste(grid, sprite, r, c, transparent=Color.BLACK, clip=True)
114:
115:    return grid
