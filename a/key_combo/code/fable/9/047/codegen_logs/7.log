+        rot = {tuple(map(int, cell)) for cell in np.asarray(placed["rotated"], dtype=int).tolist()}
+        full_cells = obj | rot | {placed["p"], placed["q"]}
+        occupied_cells |= full_cells
+        blocked |= _expanded_mask((h, w), full_cells)
