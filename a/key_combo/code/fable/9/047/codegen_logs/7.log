+    center_c = sum_c / 2.0
+    r0 = max(0, int(np.floor(center_r)) - radius_r)
+    r1 = min(h - 1, int(np.ceil(center_r)) + radius_r)
+    c0 = max(0, int(np.floor(center_c)) - radius_c)
+    c1 = min(w - 1, int(np.ceil(center_c)) + radius_c)
