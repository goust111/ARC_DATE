+    for color in sorted(int(v) for v in np.unique(grid) if int(v) != bg):
+        comps = _components(grid == color)
+        singles = [comp[0] for comp in comps if len(comp) == 1]
+        objects = [comp for comp in comps if len(comp) > 1]
