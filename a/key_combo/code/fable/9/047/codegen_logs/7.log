+def _candidate_cells(
+    h: int,
+    w: int,
+    sum_r: int,
+    sum_c: int,
+    p: tuple[int, int],
+    q: tuple[int, int],
+    blocked: np.ndarray,
+) -> list[tuple[int, int]]:
+    radius_r = random.randint(*WINDOW_RADIUS_RANGE)
+    radius_c = random.randint(*WINDOW_RADIUS_RANGE)
