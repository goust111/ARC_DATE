+
+def _sample_pair(
+    h: int,
+    w: int,
+    sum_r: int,
+    sum_c: int,
+    blocked: np.ndarray,
+) -> tuple[tuple[int, int], tuple[int, int]] | None:
+    orientation = random.choice(PAIR_ORIENTATIONS)
+    candidates = []
+    for r in range(h):
+        for c in range(w):
+            rr, cc = _rotate_point(sum_r, sum_c, r, c)
+            if not _in_bounds((h, w), rr, cc):
+                continue
+            p = (r, c)
+            q = (rr, cc)
+            if p >= q:
