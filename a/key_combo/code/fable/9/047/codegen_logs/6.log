+IGNITION_COLOR = 2
+SIDES = ("U", "D", "L", "R")
+DIR_VECTORS = {"U": (-1, 0), "D": (1, 0), "L": (0, -1), "R": (0, 1)}
+OPPOSITE = {"U": "D", "D": "U", "L": "R", "R": "L"}
+BODY_COLORS = [1, 3, 4, 5, 6, 7, 8, 9]
+BODY_DIMS = [(3, 3), (3, 5), (5, 3), (5, 5)]
+GRID_BOUNDS = (20, 28)
+ACTIVE_COUNT_BOUNDS = (2, 5)
+SILENT_COUNT_BOUNDS = (1, 3)
+GAP_BOUNDS = (2, 6)
