+    if start is None or end is None:
+        return []
+    r, c = start
+    er, ec = end
+    dr = 0 if r == er else (1 if er > r else -1)
+    dc = 0 if c == ec else (1 if ec > c else -1)
+    cells = []
+    while True:
+        cells.append((r, c))
+        if (r, c) == (er, ec):
+            return cells
+        r += dr
+        c += dc
