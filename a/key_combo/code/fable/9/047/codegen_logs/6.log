+
+def _ignition_candidate(
+    cannon: Cannon,
+    ignition: tuple[int, int],
+    occupied: np.ndarray,
+) -> tuple[tuple[int, int], tuple[int, int]] | None:
+    r, c = ignition
+    r0, c0, r1, c1 = cannon.bbox
+    if r0 <= r <= r1:
+        if c < c0 and not occupied[r, c + 1 : c0].any():
+            return (0, 1), (r, c0 - 1)
+        if c > c1 and not occupied[r, c1 + 1 : c].any():
+            return (0, -1), (r, c1 + 1)
+    if c0 <= c <= c1:
