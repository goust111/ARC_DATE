+
+    cannons = list(active)
+
+    if silent_count > 0:
+        body_hit_edges = [i for i, kind in enumerate(transitions) if kind == "body"]
+        if body_hit_edges:
+            edge_idx = random.choice(body_hit_edges)
+            shadow = _place_shadow_silent(shape, used_colors, cannons, active[edge_idx], active[edge_idx + 1], ignition)
