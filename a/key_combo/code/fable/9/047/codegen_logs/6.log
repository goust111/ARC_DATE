+
+
+def _gen_attempt() -> np.ndarray | None:
+    height = random.randint(*GRID_BOUNDS)
+    width = random.randint(*GRID_BOUNDS)
+    shape = (height, width)
+
+    active_count = random.randint(*ACTIVE_COUNT_BOUNDS)
