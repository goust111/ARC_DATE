+@dataclass(frozen=True)
+class Cannon:
+    center_r: int
+    center_c: int
+    body_h: int
+    body_w: int
+    eye_side: str
+    body_color: int
+    eye_color: int
+
+    @property
+    def half_h(self) -> int:
+        return self.body_h // 2
+
+    @property
+    def half_w(self) -> int:
+        return self.body_w // 2
+
+    @property
+    def bbox(self) -> tuple[int, int, int, int]:
+        return (
+            self.center_r - self.half_h,
+            self.center_c - self.half_w,
+            self.center_r + self.half_h,
+            self.center_c + self.half_w,
+        )
