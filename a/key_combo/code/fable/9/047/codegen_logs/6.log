+def _line_clear(
+    start: tuple[int, int],
+    end_exclusive: tuple[int, int],
+    occupied: set[tuple[int, int]],
+) -> bool:
+    sr, sc = start
+    er, ec = end_exclusive
+    dr = 0 if sr == er else (1 if er > sr else -1)
+    dc = 0 if sc == ec else (1 if ec > sc else -1)
