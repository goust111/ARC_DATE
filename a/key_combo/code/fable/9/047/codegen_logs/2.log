+
+def _candidate_left_cols(start: int, end: int, widths: list[int], rng: random.Random) -> list[int]:
+    positions = []
+    used = set()
+    cursor = start
+    for idx, width in enumerate(widths):
+        if idx == 0:
+            col = cursor
+        elif idx == 1:
+            col = max(cursor + 1, positions[0] + widths[0] + 1)
+        else:
+            lo = min(end - width + 1, start + idx)
+            hi = end - width + 1
+            col = rng.randint(lo, hi)
+            while col in used:
+                col = rng.randint(lo, hi)
+        used.add(col)
+        positions.append(col)
+        cursor = col
+    if len(set(positions)) != len(positions):
+        raise ValueError("left columns must be unique")
+    return positions
+
+
+def _candidate_right_maxes(start: int, end: int, widths: list[int], rng: random.Random) -> list[int]:
+    values = []
+    used = set()
+    for idx, width in enumerate(widths):
+        if idx == 0:
+            mx = end
+        elif idx == 1:
+            mx = min(end - 1, values[0] - widths[1] - 1)
+        else:
+            lo = start + width - 1
+            hi = max(lo, end - idx)
