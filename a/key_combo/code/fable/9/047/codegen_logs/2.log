+def _solve(grid: np.ndarray, *, traces: bool = False) -> tuple[np.ndarray, list[dict]]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    h, w = g.shape
+    bg = get_bg(g)
+    left_color = int(g[0, 0])
+    right_color = int(g[0, w - 1])
