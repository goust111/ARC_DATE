+    for color, wall_col, direction in ((left_color, 0, -1), (right_color, w - 1, 1)):
+        fixed = np.zeros_like(g, dtype=np.uint8)
+        fixed[:, 0] = 1
+        fixed[:, -1] = 1
+        fixed[g == FENCE] = 1
