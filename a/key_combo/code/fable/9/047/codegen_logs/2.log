+            occupied_kind[final_coords[:, 0], final_coords[:, 1]] = 2
+            if traces:
+                all_traces.append(
+                    {
+                        "color": int(color),
+                        "start_bbox": _bbox(comp["coords"]),
+                        "final_bbox": _bbox(final_coords),
+                        "stop_reason": trace["reason"],
+                        "blocked_fence": trace["blocked_fence"],
+                        "passed_fences": trace["passed_fences"],
+                    }
+                )
