+def _extract_objects(grid: np.ndarray, color: int, bg: int) -> list[dict]:
+    inner = np.asarray(grid, dtype=int).copy()
+    inner[:, 0] = bg
+    inner[:, -1] = bg
+    return find_components(
+        inner,
+        bg=bg,
+        connectivity=8,
+        monochromatic=True,
+        colors=[color],
+        return_format="dict",
+    )
+
+
