+        if np.all(partition[r, :] == partition[r, 0]):
+            row_hits[int(partition[r, 0])] += 1
+    for c in range(partition.shape[1]):
+        if np.all(partition[:, c] == partition[0, c]):
+            col_hits[int(partition[0, c])] += 1
