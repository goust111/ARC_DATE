+def _neighbors(cell: tuple[int, int], rows: int, cols: int) -> list[tuple[int, int]]:
+    r, c = cell
+    out: list[tuple[int, int]] = []
+    if r > 0:
+        out.append((r - 1, c))
+    if r + 1 < rows:
+        out.append((r + 1, c))
+    if c > 0:
+        out.append((r, c - 1))
+    if c + 1 < cols:
+        out.append((r, c + 1))
