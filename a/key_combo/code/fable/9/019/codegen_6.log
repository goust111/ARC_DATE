+from __future__ import annotations
+
+from collections import deque
+from itertools import permutations
+import random
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+ROOM_COUNT_RANGE = (3, 5)
+GRID_SIDE_RANGE = (18, 28)
+ROOM_MIN_SIDE = 5
