+    if r1 - r0 + 1 >= 2 * ROOM_MIN_SIDE + 1:
+        for wall_r in range(r0 + ROOM_MIN_SIDE, r1 - ROOM_MIN_SIDE + 1):
+            candidates.append(("h", wall_r))
