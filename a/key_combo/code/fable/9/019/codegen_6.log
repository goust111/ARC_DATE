def _complete_lines(g: np.ndarray, color: int) -> tuple[list[int], list[int]]:
    H, W = g.shape
    rows = [r for r in range(H) if np.all(g[r, :] == color)]
    cols = [c for c in range(W) if np.all(g[:, c] == color)]
    return rows, cols


def main(grid: np.ndarray) -> np.ndarray:
