    bar_rows = _gen_bar_rows(height)
    if len(bar_rows) == 1:
        control_rows = _gen_single_bar_controls(height, bar_rows[0])
    else:
        control_rows = _gen_two_bar_controls(height, bar_rows)
    if control_rows is None:
