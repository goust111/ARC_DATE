+
+
+def _analyze_scene(grid: np.ndarray) -> list[dict[str, object]]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+
+    black_labels, black_regions = _label_components(g == BLACK)
+    assert len(black_regions) >= 2
+
