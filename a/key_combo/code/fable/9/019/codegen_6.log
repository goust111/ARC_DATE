+        area = int(mask.sum())
+        if area < 5 or area > 7:
+            continue
+        box = _bbox(mask)
+        if box != (0, 0, 2, 2):
+            continue
+        if not _is_connected(mask):
+            continue
+        masks.append(mask)
+    return masks
