+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    made = _sample_rooms(rng)
+    if made is None:
+        return None
+    rooms, grid = made
+    base_records = _find_valid_records(rng, rooms)
+    if base_records is None:
+        return None
+
+    records = []
+    for base in base_records:
