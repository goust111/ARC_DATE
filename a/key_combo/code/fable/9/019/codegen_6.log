+    n_rooms = len(rooms)
+    room_meta = []
+    for room in rooms:
+        r0, r1, c0, c1 = room
+        room_meta.append(
+            {
+                "room": room,
+                "room_area": int((r1 - r0 + 1) * (c1 - c0 + 1)),
+                "room_pos": (r0, c0),
+            }
+        )
+
+    raw_area_order = sorted(
+        range(n_rooms),
+        key=lambda idx: (-int(room_meta[idx]["room_area"]), room_meta[idx]["room_pos"]),
