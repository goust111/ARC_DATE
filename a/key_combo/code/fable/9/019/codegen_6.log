+    return sequences
+
+
+VALID_MASK_SEQUENCES = _precompute_mask_sequences()
+
+
+def _validate_generated(grid: np.ndarray, records: list[dict[str, object]]) -> bool:
+    if not _records_semantically_valid(records):
+        return False
+    try:
+        analyzed = _analyze_scene(grid)
+    except Exception:
+        return False
