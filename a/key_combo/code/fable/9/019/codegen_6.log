+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+ROOM_COUNT_RANGE = (3, 5)
+GRID_SIDE_RANGE = (18, 28)
+ROOM_MIN_SIDE = 5
+MAX_GENERATION_ATTEMPTS = 600
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _label_components(mask: np.ndarray) -> tuple[np.ndarray, list[np.ndarray]]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    labels = np.zeros((h, w), dtype=int)
+    comps: list[np.ndarray] = []
+    next_label = 1
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or labels[r, c] != 0:
+                continue
+            q = deque([(r, c)])
+            labels[r, c] = next_label
+            coords = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and labels[nr, nc] == 0:
+                        labels[nr, nc] = next_label
+                        q.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+            next_label += 1
+    return labels, comps
+
+
+def _is_connected(mask: np.ndarray) -> bool:
+    mask = np.asarray(mask, dtype=bool)
+    if not mask.any():
+        return False
+    return len(_label_components(mask)[1]) == 1
+
+
+def _bbox(mask: np.ndarray) -> tuple[int, int, int, int] | None:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return None
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _build_stamp_library() -> list[np.ndarray]:
+    masks: list[np.ndarray] = []
+    for bits in range(1, 1 << 9):
+        mask = np.array([(bits >> i) & 1 for i in range(9)], dtype=bool).reshape(3, 3)
+        area = int(mask.sum())
+        if area < 5 or area > 7:
+            continue
+        box = _bbox(mask)
+        if box != (0, 0, 2, 2):
+            continue
+        if not _is_connected(mask):
+            continue
+        masks.append(mask)
+    return masks
+
+
