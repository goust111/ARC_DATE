+
+def _mask_sequence_valid(masks: list[np.ndarray]) -> bool:
+    records = []
+    for idx, mask in enumerate(masks):
+        records.append(
+            {
+                "room_area": 100 - idx * 10,
+                "room_pos": (idx, 0),
+                "stamp_area": int(mask.sum()),
+                "mask": mask.copy(),
+                "color": idx + 1,
+                "black_area": 100 - idx * 10,
+            }
+        )
