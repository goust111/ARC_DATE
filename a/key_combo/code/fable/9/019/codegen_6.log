+                        "room": room_info["room"],
+                        "room_area": room_info["room_area"],
+                        "room_pos": room_info["room_pos"],
+                        "stamp_area": int(mask.sum()),
+                        "mask": mask.copy(),
+                        "color": int(colors[mask_idx]),
+                        "black_area": int(room_info["room_area"] - mask.sum()),
+                    }
+                )
+            if _records_semantically_valid(records):
+                return records
+    return None
+
