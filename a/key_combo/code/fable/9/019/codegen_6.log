+def _sample_rooms(rng: random.Random):
+    n_rooms = rng.randint(ROOM_COUNT_RANGE[0], ROOM_COUNT_RANGE[1])
+    for _ in range(80):
+        height = rng.randint(GRID_SIDE_RANGE[0], GRID_SIDE_RANGE[1])
+        width = rng.randint(GRID_SIDE_RANGE[0], GRID_SIDE_RANGE[1])
