+        "reading_order": sorted(range(len(records)), key=lambda idx: records[idx]["room_pos"]),
+        "color_id": sorted(range(len(records)), key=lambda idx: int(records[idx]["color"])),
+        "reverse": list(reversed(correct_order)),
+    }
