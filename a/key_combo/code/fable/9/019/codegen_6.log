+        masks: list[np.ndarray] = [np.zeros((3, 3), dtype=bool) for _ in range(n_rooms)]
+        used_keys: set[bytes] = set()
+        ok = True
+        for idx in range(n_rooms - 1, -1, -1):
+            anchor = anchors[idx]
+            candidates = []
+            for mask in STAMP_LIBRARY:
+                if not bool(mask[anchor]):
