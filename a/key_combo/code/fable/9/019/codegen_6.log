+                "label": label,
+                "color": color,
+                "mask": stamp_mask.copy(),
+                "stamp_area": int(stamp_mask.sum()),
+                "black_area": int(room_coords.shape[0]),
+                "bbox": (r0, c0, r1, c1),
+            }
+        )
