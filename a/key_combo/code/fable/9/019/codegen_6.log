+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    made = _sample_rooms(rng)
+    if made is None:
+        return None
+    rooms, grid = made
+    n_rooms = len(rooms)
+
+    masks = rng.sample(STAMP_LIBRARY, n_rooms)
+    colors = rng.sample(PALETTE, n_rooms)
+    room_order = rooms[:]
+    rng.shuffle(room_order)
+
+    records = []
+    for room, mask, color in zip(room_order, masks, colors):
+        records.append(_place_stamp_in_room(rng, room, mask, color, grid))
+
+    return grid if _validate_generated(grid, records) else None
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _gen_attempt(rng)
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid room-overlay scene")

