+def _alternative_orders(records: list[dict[str, object]], correct_order: list[int]) -> dict[str, list[int]]:
+    return {
+        "room_bbox_area": sorted(
+            range(len(records)),
+            key=lambda idx: (-int(records[idx]["room_area"]), records[idx]["room_pos"]),
