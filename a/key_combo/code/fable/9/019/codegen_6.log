+def _overlay(infos: list[dict[str, object]], order: list[int]) -> np.ndarray:
+    out = np.zeros((3, 3), dtype=int)
+    for idx in order:
+        info = infos[idx]
+        out[info["mask"]] = int(info["color"])
+    return out
