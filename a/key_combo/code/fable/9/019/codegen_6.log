+
+def _place_stamp_in_room(
+    rng: random.Random,
+    room: tuple[int, int, int, int],
+    mask: np.ndarray,
+    color: int,
+    grid: np.ndarray,
+) -> dict[str, object]:
+    r0, r1, c0, c1 = room
+    top = rng.randint(r0 + 1, r1 - 3)
+    left = rng.randint(c0 + 1, c1 - 3)
