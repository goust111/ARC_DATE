+    black_areas = [int(record["black_area"]) for record in records]
+    if len(set(black_areas)) != len(black_areas):
+        return False
+
+    stamp_areas = [int(record["stamp_area"]) for record in records]
+    if len(set(stamp_areas)) < 2:
