+        [
+            int(a_box[0] == overlap[0]),
+            int(a_box[1] == overlap[1]),
+            int(a_box[2] == overlap[2]),
+            int(a_box[3] == overlap[3]),
+        ]
+    )
+    sides_from_b = sum(
+        [
+            int(b_box[0] == overlap[0]),
+            int(b_box[1] == overlap[1]),
+            int(b_box[2] == overlap[2]),
+            int(b_box[3] == overlap[3]),
