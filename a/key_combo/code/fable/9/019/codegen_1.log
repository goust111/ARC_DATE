                frontier.add((nr, nc))
    return frontier


def _gen_grow_mask(mask: np.ndarray, target: int) -> bool:
    while int(mask.sum()) < target:
        frontier = _gen_frontier(mask)
        if not frontier:
            return False
        r, c = random.choice(tuple(frontier))
        mask[r, c] = True
    return True


