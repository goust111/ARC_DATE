+def _crop_nonblack(grid: np.ndarray) -> np.ndarray:
+    coords = [tuple(map(int, rc)) for rc in np.argwhere(grid != BLACK)]
+    r0, c0, r1, c1 = _bbox(coords)
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
