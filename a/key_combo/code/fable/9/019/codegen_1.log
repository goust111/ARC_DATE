+
+BLACK = 0
+GREY = 5
+OBJECT_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+MAX_ATTEMPTS = 400
+
+Coord = tuple[int, int]
+Center = tuple[float, float]
