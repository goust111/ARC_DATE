+def _rotate_point(r: int, c: int, center: Center, turns: int = 1) -> Coord:
+    cr, cc = center
+    dr = r - cr
+    dc = c - cc
+    turns %= 4
+    for _ in range(turns):
+        dr, dc = dc, -dr
+    rr = int(round(cr + dr))
+    cc2 = int(round(cc + dc))
+    return rr, cc2
