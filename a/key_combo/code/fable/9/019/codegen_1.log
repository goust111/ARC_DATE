+    out = np.zeros((h, w), dtype=int)
+    r0 = top_margin
+    c0 = left_margin
+    inp[r0 : r0 + size, c0 : c0 + size] = partial
+    out[r0 : r0 + size, c0 : c0 + size] = sprite
