N_STATIC_GATE_MIN, N_STATIC_GATE_MAX = 0, 2  # static-gate (and static-marker) count

# -- Path geometry --
ARM1_EXTRA_MAX = 1   # extra perpendicular arm cells (0 or 1)
ARM2_MAX = 10        # max parallel arm length

