+    for corner, obj in corner_objects.items():
+        if corner not in moved:
+            for r, c in obj["coords_abs"]:
+                if int(out[r, c]) != obj["color"]:
+                    return False
+
+    return True
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
