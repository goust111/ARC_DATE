40:     cols = marker_coords[:, 1]
41:     assert np.sum(rows == rows.min()) == 1, "expected a unique top marker"
42:     assert np.sum(rows == rows.max()) == 1, "expected a unique bottom marker"
43:     assert np.sum(cols == cols.min()) == 1, "expected a unique left marker"
44:     assert np.sum(cols == cols.max()) == 1, "expected a unique right marker"
