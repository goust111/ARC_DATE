10: def main(grid: np.ndarray) -> np.ndarray:
11:     """
12:     Crop the single 5x5 foreground block whose number of background holes is different from the others.
13: 
14:     Input structure
15:     - The background is the dominant color.
16:     - Exactly one foreground color forms several disconnected 5x5 blocks.
17:     - Each block has a solid foreground border and may contain background holes in its interior.
18: 
19:     Rule
20:     - Count the background pixels inside each 5x5 block's bounding box.
21:     - Find the one hole count that occurs for exactly one block.
22:     - Return that unique block cropped to its 5x5 bounding box.
23: 
24:     Key insight
25:     - The requested pattern is not determined by position; it is the outlier among the repeated blocks by internal hole count.
26:     """
27:     g = np.asarray(grid, dtype=int)
28:     bg = get_bg(g)
29:     objects = find_components(g, bg=bg, connectivity=4, monochromatic=True)
30: 
31:     assert len(objects) >= 2
32:     colors = {int(obj["color"]) for obj in objects}
33:     assert len(colors) == 1
34:     fg = next(iter(colors))
35: 
36:     crops: list[tuple[int, np.ndarray]] = []
37:     for obj in objects:
38:         crop = crop_bbox(g, obj["bbox"])
39:         assert crop.shape == (5, 5)
40:         assert int(np.sum(crop == fg)) == int(obj["area"])
41:         assert np.all((crop == bg) | (crop == fg))
42:         assert np.all(crop[0, :] == fg)
43:         assert np.all(crop[-1, :] == fg)
44:         assert np.all(crop[:, 0] == fg)
45:         assert np.all(crop[:, -1] == fg)
46:         holes = int(np.sum(crop == bg))
47:         crops.append((holes, crop))
48: 
49:     hole_counts = Counter(holes for holes, _ in crops)
50:     unique_holes = [holes for holes, n in hole_counts.items() if n == 1]
51:     assert len(unique_holes) == 1
52: 
53:     matches = [crop for holes, crop in crops if holes == unique_holes[0]]
54:     assert len(matches) == 1
