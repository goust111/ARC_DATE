+def can_place_patch(
+    grid: np.ndarray,
+    patch: np.ndarray,
+    top: int,
+    left: int,
+    bg: int,
+    *,
+    gap: int = 1,
+    top_margin: int = 1,
+    bottom_margin: int = 1,
+    left_margin: int = 1,
+    right_margin: int = 1,
