+import numpy as np
+
+
+MARKER_COLOR = 5
+CORNERS = ("TL", "TR", "BR", "BL")
+CORNER_INDEX = {corner: idx for idx, corner in enumerate(CORNERS)}
+PALETTE = tuple(range(10))
+RNG = np.random.default_rng()
+
+
+def get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = map(int, shape)
+    return 0 <= int(r) < h and 0 <= int(c) < w
+
+
+def bbox_from_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def crop_bbox(grid: np.ndarray, bbox: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = map(int, bbox)
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def find_components(
+    grid: np.ndarray,
+    *,
+    bg: int,
+    exclude_colors: set[int] | None = None,
+) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    visited = np.zeros((h, w), dtype=bool)
+    excluded = set() if exclude_colors is None else set(map(int, exclude_colors))
+    comps: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if visited[r, c] or color == bg or color in excluded:
+                continue
+            q = deque([(r, c)])
+            visited[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in neighbors4(rr, cc):
+                    if not in_bounds((h, w), nr, nc) or visited[nr, nc]:
+                        continue
+                    if int(g[nr, nc]) != color:
+                        continue
+                    visited[nr, nc] = True
+                    q.append((nr, nc))
+            coord_arr = np.array(coords, dtype=int)
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coord_arr,
+                    "bbox": bbox_from_coords(coord_arr),
+                    "area": int(coord_arr.shape[0]),
+                }
+            )
+    return comps
+
+
+def count_holes(patch: np.ndarray, color: int) -> int:
+    h, w = patch.shape
+    obj = patch == int(color)
+    seen = np.zeros((h, w), dtype=bool)
+    holes = 0
+    for r in range(h):
+        for c in range(w):
+            if obj[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            touches_border = False
+            while q:
+                rr, cc = q.popleft()
+                if rr == 0 or rr == h - 1 or cc == 0 or cc == w - 1:
+                    touches_border = True
+                for nr, nc in neighbors4(rr, cc):
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if obj[nr, nc] or seen[nr, nc]:
+                        continue
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+            if not touches_border:
+                holes += 1
+    return holes
+
+
+def corner_of_bbox(bbox: tuple[int, int, int, int], h: int, w: int) -> str | None:
+    r0, c0, r1, c1 = map(int, bbox)
+    matches = []
+    if r0 == 0 and c0 == 0:
+        matches.append("TL")
+    if r0 == 0 and c1 == w - 1:
+        matches.append("TR")
+    if r1 == h - 1 and c1 == w - 1:
+        matches.append("BR")
+    if r1 == h - 1 and c0 == 0:
+        matches.append("BL")
+    if len(matches) != 1:
+        return None
+    return matches[0]
+
+
+def corner_anchor(corner: str, h: int, w: int, obj_h: int, obj_w: int) -> tuple[int, int]:
+    if corner == "TL":
+        return 0, 0
+    if corner == "TR":
+        return 0, w - obj_w
+    if corner == "BR":
+        return h - obj_h, w - obj_w
+    if corner == "BL":
+        return h - obj_h, 0
