88: def main(grid: np.ndarray) -> np.ndarray:
89:     """
90:     Move each gray marker along its green path until it reaches the cell next to a black-green-black gate, erasing the path behind it.
91: 
92:     Input structure:
93:     - The background is the dominant color.
94:     - Foreground components are made from a path color, a paired gate-end color, and single marker pixels.
95:     - A gate is a straight end-center-end motif whose center has the path color and whose two ends share the gate-end color.
96: 
97:     Rule:
98:     - In every 4-connected foreground component with exactly one marker and one gate, erase the marker and all path-color pixels except the gate center.
99:     - Place the marker on the unique path-color pixel adjacent to the gate center but not between the two gate ends.
100:     - Components without both a marker and a gate stay unchanged.
101: 
102:     Key insight: The black-green-black motif marks the stopping gate; the gray marker consumes the connected green path until it rests on the path cell immediately beside that gate.
103:     """
104:     g = np.asarray(grid, dtype=int)
105:     bg = int(get_bg(g))
106:     path_color, end_color, marker_color = _role_colors(g, bg)
107:     out = g.copy()
108: 
109:     for comp in find_components(g, bg=bg, connectivity=4, monochromatic=False):
110:         coords = comp["coords"]
111:         marker_coords = [
112:             tuple(map(int, coord)) for coord in coords if int(g[tuple(coord)]) == marker_color
113:         ]
114:         gates = _component_gates(g, coords, path_color, end_color)
115:         if not marker_coords or not gates:
116:             continue
117: 
118:         assert len(marker_coords) == 1
119:         assert len(gates) == 1
120:         gate_r, gate_c, dr, dc = gates[0]
121:         gate = (gate_r, gate_c)
122:         gate_ends = {(gate_r - dr, gate_c - dc), (gate_r + dr, gate_c + dc)}
123:         coords_set = {tuple(map(int, coord)) for coord in coords}
124: 
125:         parking = []
126:         for nr, nc in neighbors4(gate_r, gate_c):
