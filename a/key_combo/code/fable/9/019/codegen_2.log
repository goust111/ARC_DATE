+        [cell for cell in interior if (cell[0] + cell[1]) % 2 == parity]
+        for parity in (0, 1)
+    ]
+    candidates = max(parity_groups, key=len)
+    holes = rng.choice(len(candidates), size=hole_count, replace=False)
+    for idx in holes:
+        rr, cc = candidates[int(idx)]
+        patch[rr, cc] = int(bg)
+    return patch
