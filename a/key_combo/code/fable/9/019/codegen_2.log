+def build_blob_patch(h: int, w: int, color: int, area: int, rng: np.random.Generator) -> np.ndarray:
+    patch = np.full((h, w), -1, dtype=int)
+    start = (int(rng.integers(0, h)), int(rng.integers(0, w)))
+    cells = {start}
+    frontier = [start]
+    while len(cells) < area:
+        base = frontier[int(rng.integers(0, len(frontier)))]
+        options = []
+        for nr, nc in neighbors4(*base):
+            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in cells:
+                options.append((nr, nc))
+        if options:
+            cell = options[int(rng.integers(0, len(options)))]
+            cells.add(cell)
+            frontier.append(cell)
+        else:
+            frontier.pop(int(rng.integers(0, len(frontier))))
+            if not frontier:
+                frontier = list(cells)
+    for rr, cc in cells:
+        patch[rr, cc] = int(color)
+    return patch
