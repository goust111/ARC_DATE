+        height = int(r1 - r0 + 1)
+        width = int(c1 - c0 + 1)
+        assert height == width, "each visible fragment must be a square block"
+        assert comp["area"] == height * width, "each visible fragment must be a solid square"
+        by_scale.setdefault(height, []).append(comp)
