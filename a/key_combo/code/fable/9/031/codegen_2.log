+            if blocked:
+                stop_reason = reason
+                break
+            pos = _shift_cells(pos, dr, dc)
+            steps += 1
+
+        _paint(out, pos, obj["color"])
+        occupied |= set(pos)
+        details.append(
+            {
+                "color": int(obj["color"]),
+                "target": target_name,
+                "direction": (dr, dc),
+                "start_cells": obj["cells"],
+                "end_cells": pos,
+                "distance": int(dist),
+                "steps": int(steps),
+                "stop_reason": stop_reason,
