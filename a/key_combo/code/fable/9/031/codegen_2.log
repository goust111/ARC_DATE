+    if not (MIN_OBJECTS <= total_objects <= MAX_OBJECTS):
+        return None
+
+    occupied = set(legend_cells)
+    used_distances: set[int] = set()
+    objects: list[dict] = []
+    placement_plan: list[tuple[str, bool]] = []
+    for name in CORNER_NAMES:
