+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def _shift_cells(cells: Iterable[tuple[int, int]], dr: int, dc: int) -> tuple[tuple[int, int], ...]:
+    return tuple((int(r + dr), int(c + dc)) for r, c in cells)
