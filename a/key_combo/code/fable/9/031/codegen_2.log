+from collections import Counter
+import random
+from typing import Iterable
+
+import numpy as np
+
+
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+CORNER_NAMES = ("TL", "TR", "BL", "BR")
+CORNER_DIRS = {
+    "TL": (-1, -1),
+    "TR": (-1, 1),
+    "BL": (1, -1),
+    "BR": (1, 1),
