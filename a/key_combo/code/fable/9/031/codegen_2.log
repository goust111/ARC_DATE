+
+GRID_H_RANGE = (14, 20)
+GRID_W_RANGE = (14, 20)
+MAX_OBJECTS = 7
+MIN_OBJECTS = 5
+MAX_GENERATION_ATTEMPTS = 500
+MAX_PLACEMENT_TRIES = 250
+MAX_REVERSE_STEPS = 4
+PALETTE = [1, 2, 3, 4, 5, 6, 7, 8, 9]
