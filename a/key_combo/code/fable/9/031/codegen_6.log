 118: def _choose_blob_sizes(count: int, side: int) -> list[int]:
 119:     area = side * side
 120:     interior_side = side - 2 * INTERIOR_MARGIN
 121:     max_total = min(MAX_BLOB_SIZE * count, interior_side * interior_side)
 122:     low = max(count, math.ceil(MIN_MARKER_COVERAGE * area))
 123:     high = min(max_total, math.floor(MAX_MARKER_COVERAGE * area))
 124:     if low > high:
 125:         low = max(count, min(max_total, round(FALLBACK_MARKER_COVERAGE * area)))
 126:         high = max_total
 127: 
 128:     total = random.randint(low, high)
 129:     sizes = [MIN_BLOB_SIZE] * count
 130:     remaining = total - count
 131:     while remaining:
 132:         choices = [i for i, size in enumerate(sizes) if size < MAX_BLOB_SIZE]
 133:         i = random.choice(choices)
