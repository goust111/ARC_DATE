 197:             if out.shape != (inp.shape[0], LEFT_W):
 198:                 continue
 199:             return inp
 200:         except Exception:
 201:             continue
 202:     raise RuntimeError(f"generate_input: failed after {MAX_ATTEMPTS} attempts")
