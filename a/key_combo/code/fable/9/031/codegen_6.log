 204: def _gen_relative_path(length: int, turns: int) -> list[tuple[int, int]]:
 205:     segment_lengths = _gen_segment_lengths(length - 1, turns + 1)
 206:     start_axis = random.randrange(2)
 207:     axis_signs = [random.choice((-1, 1)), random.choice((-1, 1))]
 208:     reverse_candidates = []
 209:     if turns >= 2 and segment_lengths[1] > 1:
 210:         reverse_candidates.append(2)
 211:     if turns >= 3 and segment_lengths[2] > 1:
 212:         reverse_candidates.append(3)
 213:     reverse_segment = random.choice([None, *reverse_candidates])
 214:     coords = [(0, 0)]
 215:     r = c = 0
 216:     for i, steps in enumerate(segment_lengths):
 217:         axis = (start_axis + i) % 2
 218:         sign = -axis_signs[axis] if i == reverse_segment else axis_signs[axis]
 219:         dr, dc = (sign, 0) if axis == 0 else (0, sign)
 220:         for _ in range(steps):
 221:             r += dr
 222:             c += dc
 223:             coords.append((r, c))
 224:     return coords
