 198: def _gen_segment_lengths(total_steps: int, segment_count: int) -> list[int]:
 199:     cuts = sorted(random.sample(range(1, total_steps), segment_count - 1))
 200:     points = [0, *cuts, total_steps]
 201:     return [points[i + 1] - points[i] for i in range(segment_count)]
