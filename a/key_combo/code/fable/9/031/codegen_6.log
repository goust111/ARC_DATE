  91: def main(grid: np.ndarray) -> np.ndarray:
  92:     """
  93:     Slide closed foreground objects upward and open foreground objects downward, keeping their columns and stacking on collision.
  94: 
  95:     Input structure
  96:     - The grid has a single background color and several monochromatic 4-connected foreground objects.
  97:     - Some objects are closed frames with at least one enclosed background hole inside their bounding box.
  98:     - The remaining objects are open line-like sprites with no enclosed hole.
  99: 
 100:     Rule
 101:     - Redraw every object on an empty background canvas without changing its color, shape, or horizontal position.
 102:     - Closed frame objects slide vertically upward to the first non-colliding position.
 103:     - Open objects slide vertically downward to the first non-colliding position.
 104:     - Within each direction, preserve the original vertical order so overlapping columns stack instead of crossing.
 105: 
 106:     Key insight
 107:     - The only role distinction is whether an object encloses a hole: hole objects pack against the top edge, while non-hole objects pack against the bottom edge.
 108:     """
 109:     g = np.asarray(grid, dtype=int)
 110:     bg = get_bg(g)
 111:     out = np.full_like(g, bg)
 112:     objects = _objects(g, bg)
 113: 
 114:     closed = [obj for obj in objects if obj.closed]
 115:     open_objects = [obj for obj in objects if not obj.closed]
 116:     assert closed, "expected at least one closed object"
 117:     assert open_objects, "expected at least one open object"
 118: 
 119:     for obj in sorted(closed, key=lambda o: (o.bbox[0], o.bbox[1], o.bbox[2], o.bbox[3])):
 120:         _slide_into_place(out, obj, bg, upward=True)
 121: 
 122:     for obj in sorted(open_objects, key=lambda o: (-o.bbox[2], o.bbox[1], -o.bbox[0], o.bbox[3])):
 123:         _slide_into_place(out, obj, bg, upward=False)
 124: 
 125:     return out
