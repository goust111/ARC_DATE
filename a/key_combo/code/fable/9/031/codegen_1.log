+    segments: list[list[tuple[int, int]]] = []
+    current_segment: list[tuple[int, int]] = []
+    seen_states = {(pos, dir_idx)}
+
+    while True:
+        dr, dc = DIRS[dir_idx]
+        nr = pos[0] + dr
+        nc = pos[1] + dc
+        if not _in_bounds(g.shape, nr, nc):
