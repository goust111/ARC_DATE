+def _ring_cells(hit: tuple[int, int], dir_idx: int, depth: int, span: int) -> set[tuple[int, int]]:
+    assert depth >= 3 and span >= 3 and span % 2 == 1
+    hr, hc = hit
+    half = span // 2
+    cells = set()
+    if dir_idx == 1:
+        r0, r1 = hr - half, hr + half
+        c0, c1 = hc, hc + depth - 1
+    elif dir_idx == 3:
+        r0, r1 = hr - half, hr + half
+        c0, c1 = hc - depth + 1, hc
+    elif dir_idx == 2:
+        r0, r1 = hr, hr + depth - 1
+        c0, c1 = hc - half, hc + half
+    else:
+        r0, r1 = hr - depth + 1, hr
+        c0, c1 = hc - half, hc + half
+    for r in range(r0, r1 + 1):
+        for c in range(c0, c1 + 1):
+            if r in (r0, r1) or c in (c0, c1):
+                cells.add((r, c))
+    return cells
+
+
+def _bar_cells(hit: tuple[int, int], dir_idx: int, span: int) -> set[tuple[int, int]]:
+    assert span >= 3 and span % 2 == 1
+    hr, hc = hit
+    half = span // 2
+    if dir_idx in (1, 3):
+        return {(r, hc) for r in range(hr - half, hr + half + 1)}
+    return {(hr, c) for c in range(hc - half, hc + half + 1)}
+
+
+def _hit_object_options(hit: tuple[int, int], dir_idx: int, closed: bool) -> list[set[tuple[int, int]]]:
+    options = []
+    if closed:
+        for depth, span in ((3, 3), (4, 3), (5, 3), (3, 5), (5, 5)):
+            options.append(_ring_cells(hit, dir_idx, depth, span))
+    else:
+        for span in (3, 5):
+            options.append(_bar_cells(hit, dir_idx, span))
+    random.shuffle(options)
+    return options
+
+
+def _segment_clear(
+    cells: list[tuple[int, int]],
+    start: tuple[int, int],
+    path_cells: set[tuple[int, int]],
+    object_cells: set[tuple[int, int]],
+    marker: tuple[int, int],
+) -> bool:
+    prev = start
+    new_cells: set[tuple[int, int]] = set()
+    for cell in cells:
+        if cell == marker or cell in path_cells or cell in object_cells or cell in new_cells:
+            return False
+        for nbr in _neighbors4(*cell):
+            if nbr in object_cells:
+                return False
+            if nbr in path_cells and nbr != prev:
+                return False
+            if nbr in new_cells and nbr != prev:
+                return False
+        new_cells.add(cell)
+        prev = cell
+    return True
+
+
+def _object_clear(
+    obj_cells: set[tuple[int, int]],
+    hit: tuple[int, int],
+    end_pos: tuple[int, int],
+    path_cells: set[tuple[int, int]],
+    object_cells: set[tuple[int, int]],
+    marker: tuple[int, int],
+    shape: tuple[int, int],
+) -> bool:
+    if marker in obj_cells:
+        return False
+    for cell in obj_cells:
+        if not _in_bounds(shape, *cell) or cell in path_cells or cell in object_cells:
+            return False
+        for nbr in _neighbors8(*cell):
+            if nbr in object_cells:
+                return False
+        for nbr in _neighbors4(*cell):
+            if nbr in path_cells and not (cell == hit and nbr == end_pos):
+                return False
+    return True
+
+
+def _path_step_buffer_clear(
+    cell: tuple[int, int], path_cells: set[tuple[int, int]], object_cells: set[tuple[int, int]], marker: tuple[int, int]
+) -> bool:
+    if cell == marker or cell in path_cells or cell in object_cells:
+        return False
+    return not any(nbr in object_cells for nbr in _neighbors4(*cell))
+
+
+def _steps_to_exit(pos: tuple[int, int], dir_idx: int, shape: tuple[int, int]) -> int:
+    dr, dc = DIRS[dir_idx]
+    steps = 0
+    r, c = pos
+    while _in_bounds(shape, r + dr, c + dc):
+        r += dr
+        c += dc
+        steps += 1
+    return steps
