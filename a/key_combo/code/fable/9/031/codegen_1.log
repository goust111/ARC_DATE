+            segments.append(segment)
+            path_cells.update(segment)
+            hits.append({"closed": closed, "hit": hit, "dir_idx": dir_idx, "end_pos": end_pos})
+            if dfs(end_pos, new_dir, hit_idx + 1):
+                return True
+            hits.pop()
+            for cell in segment:
