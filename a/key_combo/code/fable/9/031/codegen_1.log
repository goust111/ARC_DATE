+from __future__ import annotations
+
+from collections import deque
+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BG = 0
+MARKER = 6
+COLOR_POOL = (1, 2, 3, 4, 5, 7, 8, 9)
+DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+GEN_ATTEMPTS = 500
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
