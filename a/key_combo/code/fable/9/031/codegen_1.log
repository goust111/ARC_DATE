+        for length in lengths:
+            dr, dc = DIRS[dir_idx]
+            segment = [(pos[0] + dr * step, pos[1] + dc * step) for step in range(1, length + 1)]
+            hit = (pos[0] + dr * (length + 1), pos[1] + dc * (length + 1))
+            end_pos = segment[-1]
+            if not _segment_clear(segment, pos, path_cells, marker):
+                continue
