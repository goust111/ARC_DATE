+def _has_enclosed_hole(cells: set[tuple[int, int]]) -> bool:
+    arr = np.array(sorted(cells), dtype=int)
+    r0, c0 = arr.min(axis=0)
+    r1, c1 = arr.max(axis=0)
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for r, c in cells:
+        mask[r - r0, c - c0] = True
