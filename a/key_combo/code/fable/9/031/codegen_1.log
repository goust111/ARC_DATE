+    for obj_id, obj in enumerate(objects):
+        closed = _has_enclosed_hole(obj["cells"])
+        obj["closed"] = closed
+        for cell in obj["cells"]:
+            assert cell not in coord_to_obj, "objects must not overlap"
+            coord_to_obj[cell] = obj_id
