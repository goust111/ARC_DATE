+
+def _find_owner_neighbors(
+    cell: tuple[int, int], objects: list[dict], coord_to_obj: dict[tuple[int, int], int]
+) -> set[tuple[int, int]]:
+    obj_id = coord_to_obj[cell]
+    return {nbr for nbr in _neighbors8(*cell) if nbr in objects[obj_id]["cells"]}
