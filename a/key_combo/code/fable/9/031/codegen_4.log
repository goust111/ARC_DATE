spec:
  grid: 10x10 [observed]
  background: 0 [observed]
  foreground: single non-zero color (any 1-9)
  square:
    shape: solid 2x2 block of foreground color
    count: exactly 1
    placement: at least 1 cell from every grid edge (so all 4 diagonal seeds can exist)
  seeds:
    definition: foreground pixels at diagonal neighbors of the square's corners, outside the square
    count: 1-4 (observed 1-3); each at a distinct corner
    constraint: no other foreground pixels exist besides the square and seeds
  rays:
    direction: each seed extends diagonally away from the square to the grid edge
    length: 1-5 cells beyond the seed (observed); determined by seed-to-edge distance
    constraint: rays must not intersect each other or hit non-background cells
    note: ray length >= 1 requires seed is >= 2 cells from the edge in its diagonal direction
  output: input preserved; each ray painted with foreground color from seed outward to grid edge

generation_strategy:
  approach: output-first
  steps:
    1. Pick grid 10x10, bg=0, fg=random non-zero color
    2. Place 2x2 square at (r,c) with r in [2, H-4], c in [2, W-4] ensuring >=2 cells clearance to all edges
    3. Choose 1-4 corners to activate as seeds (subset of {TL, TR, BL, BR})
    4. For each activated corner, compute the ray from the seed diagonally to the grid edge
    5. Verify rays do not intersect each other; if they do, remove conflicting seeds or retry
    6. Build output by painting all ray cells with fg
    7. Build input by removing ray cells (set back to bg), keeping only square + seeds
