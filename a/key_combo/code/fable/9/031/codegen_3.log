        assert np.all(sprite == color)
        h, w = sprite.shape
        assert h == 2 or w == 2

        if h == 2:
            normalized = sprite.copy()
        else:
            normalized = np.rot90(sprite, k=1)
            assert normalized.shape[0] == 2

        objects.append(
            {
                "bbox": (r0, c0, r1, c1),
                "width": int(normalized.shape[1]),
                "sprite": normalized,
            }
