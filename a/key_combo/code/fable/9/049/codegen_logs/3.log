+def _generate_shape(h: int, w: int, target_area: int) -> dict:
+    cells = {(h - 1, c) for c in range(w)}
+    while len(cells) < target_area:
+        frontier = set()
+        for r, c in cells:
+            for nr, nc in _neighbors4(r, c):
+                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in cells:
+                    frontier.add((nr, nc))
