from importlib.machinery import SourceFileLoader
from pathlib import Path
from collections import Counter
import numpy as np

p = Path('/home/lixinyu/snap/a/key_combo/code/fable/9/049/3.py')
mod = SourceFileLoader('new_arc_task_semantic', str(p)).load_module()
side_counts = Counter()
for _ in range(200):
    inp = mod.generate_input()
    bg = mod._most_common_color(inp)
    side, slots = mod._find_slot_side(inp, bg)
