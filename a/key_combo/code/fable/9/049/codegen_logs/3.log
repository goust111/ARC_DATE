+                    "coords": local,
+                    "area": int(local.shape[0]),
+                    "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                    "h": int(r1 - r0 + 1),
+                    "w": int(c1 - c0 + 1),
+                }
+            )
