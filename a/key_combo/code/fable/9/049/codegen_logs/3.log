+def _shape_from_cells(cells: set[tuple[int, int]]) -> dict:
+    coords = np.asarray(sorted(cells), dtype=int)
+    r0, c0 = coords.min(axis=0)
+    coords = coords - np.array([[r0, c0]], dtype=int)
+    r1, c1 = coords.max(axis=0)
