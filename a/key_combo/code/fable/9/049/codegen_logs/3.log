+            anchor_r = int(slot_r)
+            anchor_c = w - shape["w"]
+            assert anchor_r + shape["h"] <= h
+            while _can_place(shape, anchor_r, anchor_c - 1, occupied):
+                anchor_c -= 1
+        else:
