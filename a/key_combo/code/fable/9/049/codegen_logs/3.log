+    used_areas: set[int] = set()
+    for _ in range(count):
+        for _shape_try in range(80):
+            h = random.randint(2, 4)
+            w = random.randint(2, 5)
+            min_area = w + 1
+            max_area = h * w
+            if min_area > max_area:
+                continue
+            area = random.randint(min_area, max_area)
+            if area in used_areas:
