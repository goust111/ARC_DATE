+        out, _placements = fn()
+        return out
+    except AssertionError:
+        return None
+
+
+def _build_canonical_case() -> tuple[np.ndarray, np.ndarray] | None:
+    h = random.randint(12, 18)
+    w = random.randint(12, 18)
