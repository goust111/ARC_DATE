+def _sample_slot_columns(widths: list[int], grid_w: int) -> list[int] | None:
+    cols: list[int] = []
+
+    def rec(i: int) -> bool:
+        if i == len(widths):
+            return True
+        lo = 1 if i == 0 else cols[-1] + 2
+        hi = grid_w - widths[i]
+        candidates = []
+        for col in range(lo, hi + 1):
+            feasible = True
+            prev = col
+            for j in range(i + 1, len(widths)):
+                prev += 2
