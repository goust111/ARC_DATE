+
+def _scatter_objects(grid_shape: tuple[int, int], objects: list[dict], colors: list[int]) -> np.ndarray | None:
+    h, w = grid_shape
+    occupancy = np.zeros((h, w), dtype=bool)
+    placements: list[tuple[np.ndarray, int]] = []
