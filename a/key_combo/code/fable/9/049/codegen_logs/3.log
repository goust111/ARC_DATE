+        occupied[coords[:, 0], coords[:, 1]] = True
+
+        supported_by_object = False
+        if side == "bottom":
+            supported_by_object = anchor_r != h - shape["h"]
+        elif side == "top":
+            supported_by_object = anchor_r != 0
+        elif side == "left":
+            supported_by_object = anchor_c != 0
+        else:
+            supported_by_object = anchor_c != w - shape["w"]
