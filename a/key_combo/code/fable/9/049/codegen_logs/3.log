+    h, w = occupied.shape
+    coords = shape["coords"] + np.array([[anchor_r, anchor_c]], dtype=int)
+    if coords[:, 0].min() < 0 or coords[:, 1].min() < 0:
+        return False
+    if coords[:, 0].max() >= h or coords[:, 1].max() >= w:
+        return False
