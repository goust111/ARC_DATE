+from __future__ import annotations
+
+import numpy as np
+
+
+BACKGROUND = 0
+NONZERO_COLORS = np.arange(1, 10, dtype=int)
+GENERATION_RETRIES = 400
+NEIGHBOR_COPY_PROB = 0.58
+PATTERN_SIDE_CHOICES = tuple(range(11, 20, 2))
