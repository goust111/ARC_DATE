  "path": "from each marker, go horizontally right to the last column, then downward along the last column until one row before the next lower marker or the bottom edge",
  "trajectory": "paint every visited background pixel with the marker color while keeping the original marker",
  "multi_step": "process markers in top-to-bottom row order so each marker's vertical segment ends before the next marker row"
}
</annotation>
<generation_spec>
```yaml
spec:
  grid: 3-8 rows x 3-8 cols, background 0
  markers:
    count: 1-3 single-pixel foreground markers, each a distinct non-zero color
    placement: one marker per row, column in range [1, W-2] (never on left/right edge)
    row_ordering: strictly increasing rows; row gaps between consecutive markers 2-3
    bottom_clearance: last marker row <= H-2 (at least 1 row below for vertical segment)
  colors: each marker has a unique non-zero color (1-9), no two markers share a color
  output_transform:
    for each marker at (r,c) with color k, sorted top-to-bottom:
      horizontal segment -- paint row r from column c to W-1 with k
      vertical segment -- paint column W-1 from row r to (next_marker_row-1) or (H-1) with k
  path_metrics:
