+        if _is_lamp(int(g[r, c]))
+    }
+
+    lit_lamps: set[tuple[int, int]] = set()
+    seen_emitters = {source}
+    depth = {source: 0}
+    queue = deque([source])
+    covers: dict[tuple[int, int], set[int]] = {}
+    edges: list[dict] = []
+    boundary_rays: list[tuple[tuple[int, int], tuple[int, int]]] = []
+
