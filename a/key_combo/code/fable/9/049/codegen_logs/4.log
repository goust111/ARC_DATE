def _gen_connected_subset(cells, k):
    cells = list(cells)
    if k >= len(cells):
        return set(cells)

    chosen = {random.choice(cells)}
    while len(chosen) < k:
        options = [
            (r, c) for r, c in cells
            if (r, c) not in chosen and any(max(abs(r - rr), abs(c - cc)) == 1 for rr, cc in chosen)
        ]
        chosen.add(random.choice(options))
