  "type": "move_in_order",
  "src": "monochromatic foreground objects s ordered by decreasing area",
  "dst": "centered square rings d ordered outside-to-inside",
  "match_cond": "rank(s) == rank(d)",
  "transform": "paint each d with s.color",
  "grid_shape": "square of side 2 * object_count - 1"
}
</annotation>
<generation_spec>
```yaml
spec:
  grid: square, side 6-10
  background: 7
  objects:
    count: 2-6 monochromatic 4-connected foreground components
    colors: each object a distinct non-bg color (from 0-9 excluding 7)
    areas: all mutually distinct, each 1-9 pixels
    connectivity: each color forms exactly one 4-connected component
    separation: no two objects are 4-adjacent (gap >= 1 bg cell)
    shapes: arbitrary connected blobs; no special symmetry required
  output:
    side: 2 * object_count - 1 (square)
    structure: concentric 1-cell-thick square rings
    ordering: outermost ring = color with largest area, each inner ring = next smaller area, center pixel = smallest area

generation_strategy:
  approach: output-first
  steps:
    1. Pick n = randint(2, 6); choose n distinct colors from 0-9 excluding 7.
    2. Assign each color a distinct area in 1..9 (sample n distinct values).
    3. Build output: (2n-1) x (2n-1) concentric rings colored by descending area.
    4. Choose input grid side s in [max(6, ceil(sqrt(2 * total_fg_area))), 10] so objects fit.
    5. For each color, generate a random 4-connected blob of the required area.
    6. Place blobs on the bg-7 grid with no 4-adjacency between any two blobs (reject or use greedy placement with 1-cell gap padding).
```
