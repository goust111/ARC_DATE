+def _simulate(grid: np.ndarray, recolor: bool = True) -> np.ndarray:
+    out = np.array(grid, dtype=int, copy=True)
+    play_bbox = _playfield_bbox(out)
+    mapping = _legend_mapping(out, play_bbox)
