+    for orbit in chosen:
+        orbit_indices = list(range(4))
+        random.shuffle(orbit_indices)
+        k = random.choices([1, 2, 3], weights=[4, 3, 1], k=1)[0]
+        picks = orbit_indices[:k]
+        if selected_quad in picks:
