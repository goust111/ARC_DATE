+    side = motif.shape[0]
+    restored = motif.copy()
+    for r in range(side):
+        for c in range(side):
+            if restored[r, c] != BLACK:
+                continue
+            colors = {
+                int(motif[rr, cc])
+                for rr, cc in _rot_orbit(r, c, side)
+                if int(motif[rr, cc]) != BLACK
+            }
+            assert len(colors) == 1, "each black cell must have one visible orbit color"
+            restored[r, c] = colors.pop()
+    return restored
