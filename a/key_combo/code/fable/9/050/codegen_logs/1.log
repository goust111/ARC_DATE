+def _select_quadrant(restored: np.ndarray, marker: tuple[int, int], motif_box: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = motif_box
+    side = r1 - r0 + 1
+    half = side // 2
+    mr, mc = marker
+    top = mr < r0 + half
+    left = mc < c0 + half
