+
+def _quadrant_tiles(tile: np.ndarray) -> np.ndarray:
+    n = tile.shape[0]
+    motif = np.empty((2 * n, 2 * n), dtype=int)
+    motif[:n, :n] = tile
+    motif[:n, n:] = np.rot90(tile, -1)
+    motif[n:, :n] = np.rot90(tile, 1)
+    motif[n:, n:] = np.rot90(tile, 2)
