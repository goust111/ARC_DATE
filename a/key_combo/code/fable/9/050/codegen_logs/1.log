+
+        grid = np.full((h, w), BG, dtype=int)
+        grid[r0 : r0 + motif_side, c0 : c0 + motif_side] = motif
+        grid[marker] = marker_color
+
+        expected = _expected_output(tile, selected_quad)
+        if _validate_instance(grid, expected, selected_quad):
