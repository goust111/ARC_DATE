+        comps = _component_coords(grid == color, connectivity=8)
+        for coords in comps:
+            bbox = _bbox_from_coords(coords)
+            sprites.append(
+                {
+                    "color": int(color),
+                    "coords": coords,
+                    "bbox": bbox,
+                    "crop": _crop_bbox(grid, bbox),
