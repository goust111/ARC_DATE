+    return sprites
+
+
+def _count_holes(crop: np.ndarray, fg_color: int, bg: int) -> tuple[int, list[int]]:
+    cavity = crop == bg
+    h, w = crop.shape
+    seen = np.zeros_like(cavity, dtype=bool)
