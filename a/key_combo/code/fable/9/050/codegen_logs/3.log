+    r, c = corner
+    if orientation == "H":
+        return (r, c - distance), (r, c + distance)
+    return (r - distance, c), (r + distance, c)
+
+
+def _inside_rect(rc: tuple[int, int], rect: tuple[int, int, int, int]) -> bool:
+    r, c = rc
+    r0, c0, r1, c1 = rect
+    return r0 <= r <= r1 and c0 <= c <= c1
