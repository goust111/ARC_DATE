    pattern: same binary pattern across all sprites [observed], 4-7 filled cells, 8-connected single component
    symmetry: LR and UD symmetric [observed]
  layout:
    axis: horizontal (col_span > row_span) or vertical (row_span > col_span)
    dominant_span: >=5 (center-to-center distance along layout axis)
