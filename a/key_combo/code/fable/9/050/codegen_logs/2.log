+    sprite = np.asarray(info["sprite"], dtype=int)
+    sh, sw = sprite.shape
+    assert sh != sw, "control sprite must be non-square"
+    axis = 1 if sw > sh else 0
+    return np.asarray(info["pattern"], dtype=int), int(info["holes"]), int(axis)
