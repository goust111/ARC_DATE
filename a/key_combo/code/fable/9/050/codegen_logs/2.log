+        ph_min = max(sh, holes + 3, 6)
+        ph_max = 24
+        pw_min = max(sw + 1, holes + 3, 6)
+        pw_max = 29 - sw
+        if ph_min > ph_max or pw_min > pw_max:
+            return None
+        ph = random.randint(ph_min, ph_max)
