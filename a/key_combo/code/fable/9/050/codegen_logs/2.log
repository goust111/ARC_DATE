+        return False
+    expected = np.roll(pattern, shift, axis=axis)
+    if np.array_equal(expected, pattern):
+        return False
+    other_axis = 1 - axis
+    for s in range(pattern.shape[other_axis]):
+        if np.array_equal(np.roll(pattern, s, axis=other_axis), expected):
