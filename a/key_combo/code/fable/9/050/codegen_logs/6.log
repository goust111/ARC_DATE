    guide = np.zeros((h, w), dtype=bool)
    marker_mask = np.zeros((h, w), dtype=bool)
    for r in rows:
        guide[r, :] = True
        marker_mask[r, 0] = True
        marker_mask[r, w - 1] = True
    for c in cols:
