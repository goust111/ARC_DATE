    cross_starts = _gen_cross_starts(rng, n, cross_len)

    inp = _scatter_sprites((h, w), sprites, axis_starts, cross_starts, horizontal)

    try:
        if np.array_equal(main(inp), out):
            return inp
    except Exception:
        return None
    return None

