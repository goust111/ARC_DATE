    if old_col == new_col:
        return
    if int(connectivity) == 4:
        def nbrs(rr: int, cc: int):
            yield rr - 1, cc
            yield rr + 1, cc
            yield rr, cc - 1
            yield rr, cc + 1
    else:
        def nbrs(rr: int, cc: int):
            for dr in (-1, 0, 1):
                for dc in (-1, 0, 1):
                    if dr == 0 and dc == 0:
                        continue
                    yield rr + dr, cc + dc
    stack: list[Coord] = [(r0, c0)]
    while stack:
        rr, cc = stack.pop()
        if not (0 <= rr < H and 0 <= cc < W):
