+def _sample_bar_count(side: int) -> int:
+    threshold = (side - 1) // 2
+    regime = random.choice(["before", "reach", "after"])
+    if threshold == 1:
+        if regime == "reach":
+            return 1
+        return random.randint(2, 4)
+    if regime == "before":
+        return random.randint(1, threshold - 1)
+    if regime == "reach":
+        return threshold
+    return random.randint(threshold + 1, threshold + 3)
