+            "gap_widths": gap_widths,
+            "square_color": square_color,
+            "bar_color": bar_color,
+            "bars_in_order": [int(x) for x in bars_in_order],
+            "bars_all": [int(x) for x in bars_all],
+            "square_bbox": square_bbox,
+            "dest_bbox": dest_bbox,
+        }
