+    assert np.all(out[sr0 : sr1 + 1, sc0 : sc1 + 1] == bg), "starting square must be cleared"
+
+    for pos, width in zip(spec["bars_in_order"], spec["gap_widths"]):
+        half = width // 2
+        lo = spec["center"] - half
+        hi = spec["center"] + half
