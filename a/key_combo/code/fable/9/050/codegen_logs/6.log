+    return {
+        "grid": g,
+        "bg": bg,
+        "shape": (h, w),
+        "axis": axis,
+        "direction": direction,
+        "touch": touch_name,
+        "center": center,
+        "square_color": int(square["color"]),
+        "square_bbox": tuple(map(int, square["bbox"])),
+        "side": side,
+        "bars": ordered,
+        "gap_widths": widths,
+        "final_side": final_side,
