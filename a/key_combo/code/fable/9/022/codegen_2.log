+def _simulate(
+    grid: np.ndarray,
+    *,
+    block_after_first: bool = True,
+    regime_mode: str = "alternate",
+) -> tuple[np.ndarray, dict]:
+    g = np.asarray(grid, dtype=int)
+    seeds = _validate_initial_seeds(g)
+    out = g.copy()
+    current_seeds = [(r, c) for r, c, _ in seeds]
