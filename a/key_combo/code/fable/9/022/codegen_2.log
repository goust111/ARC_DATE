+
+
+def _validate_initial_seeds(grid: np.ndarray) -> list[tuple[int, int, int]]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+    seeds = [(int(r), int(c), int(g[r, c])) for r, c in np.argwhere(g != BLACK)]
