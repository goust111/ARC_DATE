+    shape: tuple[int, int],
+    occupied: np.ndarray,
+    start: tuple[int, int],
+    dr: int,
+    dc: int,
+    *,
+    stop_on_color: bool,
+) -> tuple[list[tuple[int, int]], bool]:
+    r, c = start
+    cells: list[tuple[int, int]] = []
+    while True:
+        nr, nc = r + dr, c + dc
+        if not _in_bounds(shape, nr, nc):
+            return cells, False
+        if stop_on_color and occupied[nr, nc]:
+            return cells, True
+        cells.append((nr, nc))
+        r, c = nr, nc
+
