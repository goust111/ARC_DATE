+        grid,
+        block_after_first=False,
+        regime_mode="alternate",
+        max_generations=4,
+    )
+    orth_only_out, _ = _simulate(
+        grid,
+        block_after_first=True,
+        regime_mode="orth_only_after_first",
+        max_generations=4,
+    )
+    diag_only_out, _ = _simulate(
