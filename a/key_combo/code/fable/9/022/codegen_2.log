+        return "orth"
+    if regime_mode == "alternate":
+        return "diag" if generation % 2 == 0 else "orth"
+    if regime_mode == "orth_only_after_first":
+        return "orth"
+    if regime_mode == "diag_only_after_first":
+        return "diag"
