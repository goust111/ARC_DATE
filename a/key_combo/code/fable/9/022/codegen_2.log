+
+        family_a_cells: list[set[tuple[int, int]]] = []
+        family_b_cells: list[set[tuple[int, int]]] = []
+        blocked_rays = 0
+        painted_this_generation: set[tuple[int, int]] = set()
+
+        for r, c in current_seeds:
+            seed_color = int(out[r, c])
