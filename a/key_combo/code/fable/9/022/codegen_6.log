+    h, w = map(int, mask.shape)
+    r0, c0, r1, c1 = bbox
+    top = r0 - distance
+    left = c0 - distance
+    bottom = r1 + distance
+    right = c1 + distance
+
+    clip_r0 = max(0, top)
+    clip_c0 = max(0, left)
+    clip_r1 = min(h - 1, bottom)
+    clip_c1 = min(w - 1, right)
+
+    if 0 <= top < h:
+        mask[top, clip_c0 : clip_c1 + 1] = True
+    if 0 <= bottom < h:
+        mask[bottom, clip_c0 : clip_c1 + 1] = True
+    if 0 <= left < w:
+        mask[clip_r0 : clip_r1 + 1, left] = True
+    if 0 <= right < w:
+        mask[clip_r0 : clip_r1 + 1, right] = True
