def _gen_place_near_run(grid, allowed_runs, protected, length):
    near_delta = NEAR_RUN_SHORT_DELTA if random.random() < NEAR_RUN_SHORT_PROB else NEAR_RUN_LONG_DELTA
    near_length = length - near_delta
