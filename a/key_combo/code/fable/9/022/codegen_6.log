+    frame_only = green_mask & (grid == BACKGROUND)
+    probe_only = blue_mask & (grid == BACKGROUND) & ~green_mask
+    if int(frame_only.sum()) < len(info):
+        return False
+    if int(probe_only.sum()) < len(info):
+        return False
+
+    if blue_count + green_count > int(grid.size * 0.45):
+        return False
+
+    return True
+
