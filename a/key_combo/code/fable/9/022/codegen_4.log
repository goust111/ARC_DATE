+        if stop_state is not None:
+            r, c, dr, dc = stop_state
+            r0, r1 = sorted((r, r - dr))
+            c0, c1 = sorted((c, c - dc))
+            out[r0 : r1 + 1, c0 : c1 + 1] = color
