+from collections import Counter
+from functools import lru_cache
+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BG = 0
+DIRS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]
+GEN_ATTEMPTS = 400
+PLACEMENT_ATTEMPTS = 240
+SHAPES = ((18, 18), (18, 20), (20, 18), (20, 20), (18, 22), (22, 18))
