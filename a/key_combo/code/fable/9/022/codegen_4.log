        if not splittable:
            return None
        areas = np.array(
            [(regions[i][1] - regions[i][0]) * (regions[i][3] - regions[i][2]) for i in splittable],
            dtype=float,
        )
        idx = splittable[int(rng.choice(len(splittable), p=areas / areas.sum()))]
        region = regions.pop(idx)
