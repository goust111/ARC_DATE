+        traces.append(
+            {
+                "color": color,
+                "start": start,
+                "stop_state": stop_state,
+                "deleted": stop_state is None,
+                "steps": steps,
+                "bounce_total": bounce_total,
+                "corner_seen": corner_seen,
+            }
+        )
