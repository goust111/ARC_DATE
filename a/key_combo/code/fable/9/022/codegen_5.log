+        weights = [1.0 / counts[idx] for idx in choices]
+        total = sum(weights)
+        pick = rng.random() * total
+        acc = 0.0
+        chosen = choices[0]
+        for idx, weight in zip(choices, weights):
+            acc += weight
+            if pick <= acc:
