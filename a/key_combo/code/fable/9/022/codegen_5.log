+    if len({v.tobytes() for v in variants}) != 8:
+        return None
+
+    min_dist = size + 2
+    for i in range(8):
+        for j in range(i + 1, 8):
+            dist = int(np.count_nonzero(variants[i] != variants[j]))
+            if dist < min_dist:
