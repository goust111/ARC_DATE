+    cells = [(r, c) for r in range(size) for c in range(size)]
+    rng.shuffle(cells)
+    bg_added = 0
+    for r, c in cells:
+        color = int(sprite[r, c])
+        if color_counts[color] <= 2:
+            continue
+        sprite[r, c] = 0
+        color_counts[color] -= 1
+        bg_added += 1
+        if bg_added >= target_bg:
+            break
+
