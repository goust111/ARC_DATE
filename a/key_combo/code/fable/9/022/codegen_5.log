+def _build_inverse_ops() -> list[int]:
+    probe = np.arange(9, dtype=int).reshape(3, 3)
+    inv = [-1] * 8
+    for op in range(8):
+        for cand in range(8):
+            if np.array_equal(_apply_d4(_apply_d4(probe, op), cand), probe):
+                inv[op] = cand
+                break
+        assert inv[op] != -1
+    return inv
