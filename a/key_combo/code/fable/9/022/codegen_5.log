+    n_slots = layout[0] * layout[1]
+    ops = _choose_orientations(n_slots, rng)
+    canonical_noisy = _corrupt_canonical(sprite, n_slots, rng)
+    inp, out = _render_grid(canonical_noisy, sprite, ops, layout, separator)
