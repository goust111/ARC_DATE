+        return arr.copy()
+    if op == 1:
+        return np.rot90(arr, 1)
+    if op == 2:
+        return np.rot90(arr, 2)
+    if op == 3:
+        return np.rot90(arr, 3)
+    if op == 4:
+        return np.fliplr(arr)
+    if op == 5:
+        return np.flipud(arr)
+    if op == 6:
+        return arr.T.copy()
+    if op == 7:
+        return np.fliplr(np.rot90(arr, 1))
+    raise ValueError(f"unknown D4 op: {op}")
