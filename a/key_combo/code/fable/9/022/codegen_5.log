+    best_key = None
+    best_proto = None
+    best_ops = None
+    for anchor_idx in range(len(cells)):
+        for anchor_op in range(8):
+            proto = aligned_variants[anchor_idx][anchor_op]
+            for _ in range(3):
+                ops = []
+                for variants in aligned_variants:
+                    op, _unique, _score = _best_match(proto, variants)
+                    ops.append(op)
