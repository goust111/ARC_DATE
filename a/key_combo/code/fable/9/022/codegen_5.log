+    return sprite
+
+
+def _gen_sprite(size: int, palette: list[int], rng: random.Random) -> np.ndarray | None:
+    fg_count = rng.randint(3, 4)
+    fg_colors = rng.sample(palette, fg_count)
+    sprite = _grow_color_regions(size, fg_colors, rng)
