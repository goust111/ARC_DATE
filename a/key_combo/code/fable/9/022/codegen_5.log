+def _corrupt_canonical(
+    sprite: np.ndarray,
+    n_slots: int,
+    rng: random.Random,
+) -> list[np.ndarray]:
+    size = sprite.shape[0]
+    fg_colors = sorted({int(v) for v in sprite.ravel()} - {0})
+    cap = max(1, (n_slots - 1) // 2)
