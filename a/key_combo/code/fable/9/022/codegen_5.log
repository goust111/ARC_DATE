        sprite[missing_r, missing_c] = BG
        dst_r = SPRITE_SHAPE[0] * (1 - missing_r)
        dst_c = SPRITE_SHAPE[1] * (1 - missing_c)
        paste(out, sprite, dst_r, dst_c)
        sprites.append(sprite.copy())
    return out, sprites


