+
+def _blocker_positions(grid: np.ndarray, legend_colors: Iterable[int], seed: tuple[int, int]) -> set[tuple[int, int]]:
+    legend_colors = set(int(v) for v in legend_colors)
+    blockers: set[tuple[int, int]] = set()
+    h, w = grid.shape
+    for r in range(2, h):
