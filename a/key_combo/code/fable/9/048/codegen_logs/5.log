+        gaps = [random.randint(2, 4) for _ in range(max(0, len(box_specs) - 1))]
+        panel_h = top_margin + sum(spec[0] for spec in box_specs) + sum(gaps) + bottom_margin
+        box_widths = [2 + sum(widths) + (len(widths) - 1) for _h, widths in box_specs]
