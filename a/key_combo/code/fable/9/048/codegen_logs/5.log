        paste(grid, sprite, r0, c0)

    if not np.array_equal(main(grid), target):
        return None
    return grid


def generate_input():
    for _ in range(MAX_GENERATION_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
