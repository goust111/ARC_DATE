+        for coords in _same_color_components(grid, color):
+            bbox = _bbox_from_coords(coords)
+            components.append({"color": color, "coords": coords, "bbox": bbox})
+    return components
+
+
+def _is_hollow_rectangle(coords: np.ndarray) -> bool:
