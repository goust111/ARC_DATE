+
+            inp = np.zeros((grid_h, grid_w), dtype=int)
+            fr, fc = frame_pos
+            inp[fr, fc : fc + frame_w] = GREY
+            inp[fr + frame_h - 1, fc : fc + frame_w] = GREY
+            inp[fr : fr + frame_h, fc] = GREY
+            inp[fr : fr + frame_h, fc + frame_w - 1] = GREY
