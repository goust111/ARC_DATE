+    cols = {c for _, c in marker_positions}
+    return len(rows) == 1 or len(cols) == 1
+
+
+def _half_placeholder_counts(grid: np.ndarray, color: int, axis: str) -> tuple[int, int]:
+    if axis == AXIS_LR:
