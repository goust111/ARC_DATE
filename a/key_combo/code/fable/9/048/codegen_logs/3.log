+                for a, b in _iter_pair_coords(g.shape, axis):
+                    aw = a in marker_set or int(g[a]) == placeholder_color
+                    bw = b in marker_set or int(g[b]) == placeholder_color
+                    if aw and bw:
+                        valid = False
+                        break
+                    if not aw and not bw and int(g[a]) != int(g[b]):
+                        valid = False
