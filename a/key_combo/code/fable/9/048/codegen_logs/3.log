+def _iter_pair_coords(shape: tuple[int, int], axis: str):
+    h, w = shape
+    if axis == AXIS_LR:
+        assert w % 2 == 0
+        half_w = w // 2
+        for r in range(h):
+            for c in range(half_w):
+                yield (r, c), (r, w - 1 - c)
+    else:
+        assert h % 2 == 0
+        half_h = h // 2
+        for r in range(half_h):
+            for c in range(w):
+                yield (r, c), (h - 1 - r, c)
+
