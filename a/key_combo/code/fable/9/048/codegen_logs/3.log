+    half = grid.shape[0] // 2
+    return grid[side * half : (side + 1) * half, :].copy()
+
+
+def _global_from_local(local: tuple[int, int], half_shape: tuple[int, int], axis: str, side: int) -> tuple[int, int]:
+    r, c = local
