+        right = int(np.count_nonzero(grid[:, half:] == color))
+        return left, right
+    half = grid.shape[0] // 2
+    top = int(np.count_nonzero(grid[:half, :] == color))
+    bottom = int(np.count_nonzero(grid[half:, :] == color))
+    return top, bottom
