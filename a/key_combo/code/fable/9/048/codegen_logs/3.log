+        half_h = h // 2
+        for r in range(half_h):
+            for c in range(w):
+                yield (r, c), (h - 1 - r, c)
+
+
+def _marker_side(marker_positions: list[tuple[int, int]], shape: tuple[int, int], axis: str) -> int | None:
+    if axis == AXIS_LR:
+        half = shape[1] // 2
+        sides = {0 if c < half else 1 for _, c in marker_positions}
+    else:
