+
+AXIS_LR = "lr"
+AXIS_UD = "ud"
+
+# --------------- solver helpers ---------------
+
+
+def _colors_present(grid: np.ndarray) -> list[int]:
+    return sorted(set(map(int, grid.flatten())))
