+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+ORTH_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIAG_DIRS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]
+NON_BLACK = list(range(1, 10))
