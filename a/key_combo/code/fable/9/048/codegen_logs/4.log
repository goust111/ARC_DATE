+def _ray_overlap_free(rays: list[dict]) -> bool:
+    seen: set[tuple[int, int]] = set()
+    for ray in rays:
+        for cell in ray["cells"]:
+            if cell in seen:
+                return False
+            seen.add(cell)
+    return True
