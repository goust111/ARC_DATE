+
+def _solve_with_rules(grid: np.ndarray) -> tuple[np.ndarray, list[dict], list[dict]]:
+    crosses = _extract_crosses(grid)
+    rays = _trace_rays(crosses, grid.shape)
+    return _render_from_rays(grid.shape, crosses, rays), crosses, rays
