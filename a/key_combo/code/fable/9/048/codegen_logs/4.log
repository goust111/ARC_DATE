+
+def _sample_near_center(anchor: tuple[int, int], h: int, w: int) -> tuple[int, int] | None:
+    ar, ac = anchor
+    for _ in range(80):
+        dr = random.randint(-8, 8)
+        dc = random.randint(-8, 8)
+        cheb = max(abs(dr), abs(dc))
+        if cheb < 4 or cheb > 8:
+            continue
+        r, c = ar + dr, ac + dc
+        if 1 <= r <= h - 2 and 1 <= c <= w - 2:
+            return r, c
+    return None
+
