+def _sample_centers(h: int, w: int, count: int) -> list[tuple[int, int]] | None:
+    centers: list[tuple[int, int]] = []
+    want_edge = random.random() < 0.75
+    cluster_budget = random.randint(1, min(3, count - 1))
+    for i in range(count):
+        placed = False
+        for _ in range(120):
+            if i == 0 and want_edge:
+                candidate = _sample_edge_center(h, w)
+            elif i <= cluster_budget and centers:
+                candidate = _sample_near_center(random.choice(centers), h, w)
+                if candidate is None:
+                    continue
+            elif random.random() < 0.35:
+                candidate = _sample_edge_center(h, w)
+            else:
+                candidate = _sample_any_center(h, w)
+            trial = centers + [candidate]
+            if _crosses_are_separate(trial):
+                centers.append(candidate)
+                placed = True
+                break
+        if not placed:
+            return None
+    return centers
+
