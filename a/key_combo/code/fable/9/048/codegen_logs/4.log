/bin/bash -lc "python - <<'PY'
from importlib.machinery import SourceFileLoader
from pathlib import Path
import random
import numpy as np

p = Path('/home/lixinyu/snap/a/key_combo/code/fable/9/048/4.py')
mod = SourceFileLoader('arc_eval2', str(p)).load_module()

def make_case(h,w):
    r1 = random.choice([1,2,h-3,h-2]) if random.random() < 0.6 else random.randint(3,h-4)
    row_gap = random.choice([1,2,-1,-2])
    r2 = min(max(r1 + row_gap, 1), h-2)
    if abs(r2-r1) not in (1,2):
        return None
    c1 = random.randint(1, max(1, w//4))
    c2 = random.randint(min(w-2, 3*w//4), w-2)
    if random.random() < 0.5:
        c1, c2 = c2, c1
    centers = [(r1,c1),(r2,c2)]
    if not mod._crosses_are_separate(centers):
        return None
    inp = mod._build_input((h,w), centers, mod._sample_colors(2))
    return inp

stats = {'made':0,'semantic':0,'overlapfree':0}
examples=[]
for _ in range(1000):
    h = random.randint(14,30)
    w = random.randint(14,30)
    inp = make_case(h,w)
    if inp is None:
        continue
    stats['made'] += 1
    out,crosses,rays = mod._solve_with_rules(inp)
    if mod._ray_overlap_free(rays):
        stats['overlapfree'] += 1
        if mod._semantic_checks(inp):
            stats['semantic'] += 1
            if len(examples) < 5:
                examples.append((inp.shape, [c['center'] for c in crosses], [(r['family'], r['direction'], len(r['cells']), r['reason']) for r in rays]))
print(stats)
for ex in examples:
    print(ex)
