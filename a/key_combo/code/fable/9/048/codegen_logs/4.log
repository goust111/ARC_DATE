+    color_pairs = _sample_colors(count)
+    inp = _build_input((h, w), centers, color_pairs)
+    if _semantic_checks(inp):
+        return inp
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
