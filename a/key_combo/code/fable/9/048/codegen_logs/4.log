+        r, c = cross["center"]
+        out[r, c] = cross["center_color"]
+        out[r - 1, c] = cross["arm_color"]
+        out[r + 1, c] = cross["arm_color"]
+        out[r, c - 1] = cross["arm_color"]
+        out[r, c + 1] = cross["arm_color"]
+    return out
