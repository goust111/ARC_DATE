+    for i in range(len(pixel_sets)):
+        for j in range(i + 1, len(pixel_sets)):
+            for ra, ca in pixel_sets[i]:
+                for rb, cb in pixel_sets[j]:
+                    if max(abs(ra - rb), abs(ca - cb)) <= 1:
+                        return False
+    return True
