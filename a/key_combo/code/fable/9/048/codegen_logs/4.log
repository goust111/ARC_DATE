+def _trace_rays(crosses: list[dict], shape: tuple[int, int]) -> list[dict]:
+    all_other_pixels = []
+    for i, _cross in enumerate(crosses):
+        others = []
+        for j, other in enumerate(crosses):
+            if i == j:
+                continue
+            others.extend(other["pixels"])
+        all_other_pixels.append(tuple(others))
+
+    rays: list[dict] = []
+    for i, cross in enumerate(crosses):
+        cr, cc = cross["center"]
+        for dr, dc in ORTH_DIRS:
+            cells = []
+            step = 2
+            reason = "boundary"
+            while True:
+                rr = cr + dr * step
+                cc2 = cc + dc * step
+                if not _in_bounds(shape, rr, cc2):
+                    break
+                if any(max(abs(rr - orr), abs(cc2 - occ)) <= 1 for orr, occ in all_other_pixels[i]):
+                    reason = "neighbor"
+                    break
+                cells.append((rr, cc2))
+                step += 1
+            rays.append(
+                {
+                    "cross": i,
+                    "family": "orth",
+                    "direction": (dr, dc),
+                    "color": cross["arm_color"],
+                    "cells": tuple(cells),
+                    "reason": reason,
+                }
+            )
+        for dr, dc in DIAG_DIRS:
+            cells = []
+            step = 1
+            reason = "boundary"
+            while True:
+                rr = cr + dr * step
+                cc2 = cc + dc * step
+                if not _in_bounds(shape, rr, cc2):
+                    break
+                if any(max(abs(rr - orr), abs(cc2 - occ)) <= 1 for orr, occ in all_other_pixels[i]):
+                    reason = "neighbor"
+                    break
+                cells.append((rr, cc2))
+                step += 1
+            rays.append(
+                {
+                    "cross": i,
+                    "family": "diag",
+                    "direction": (dr, dc),
+                    "color": cross["center_color"],
+                    "cells": tuple(cells),
+                    "reason": reason,
+                }
+            )
+    return rays
+
