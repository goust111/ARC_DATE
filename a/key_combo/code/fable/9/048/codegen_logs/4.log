+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or grid[r, c] == 0:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for dr, dc in ORTH_DIRS:
+                    nr, nc = rr + dr, cc + dc
+                    if _in_bounds(grid.shape, nr, nc) and not seen[nr, nc] and grid[nr, nc] != 0:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
