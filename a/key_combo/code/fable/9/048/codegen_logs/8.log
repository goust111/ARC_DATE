def _column_interval(mask: np.ndarray, c: int) -> tuple[int, int]:
    rows = np.flatnonzero(mask[:, c])
    assert rows.size > 0
    r0, r1 = int(rows[0]), int(rows[-1])
    assert np.array_equal(rows, np.arange(r0, r1 + 1))
