+        "mask": shape.copy(),
+        "area": int(shape.sum()),
+        "bbox_key": tuple(sorted(shape.shape)),
+        "canon": _canonical_rotation_key(shape),
+    }
+    for shape in SHAPE_LIBRARY
+]
+
+
+def _choose_hole_shapes(count: int) -> tuple[list[np.ndarray], dict]:
+    indices = list(range(len(SHAPE_META)))
+    for _ in range(400):
