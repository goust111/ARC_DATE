+        metas = [SHAPE_META[i] for i in chosen]
+        if len({meta["canon"] for meta in metas}) != count:
+            continue
+        same_area = any(metas[i]["area"] == metas[j]["area"] for i in range(count) for j in range(i + 1, count))
