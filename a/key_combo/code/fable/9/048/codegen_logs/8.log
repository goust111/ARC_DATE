+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+PALETTE = tuple(range(1, 10))
+BG = 0
+GEN_ATTEMPTS = 500
+PLACEMENT_GAP = 1
