+def _build_host_mask(hole_mask: np.ndarray) -> tuple[np.ndarray, list[tuple[int, int]]]:
+    hh, hw = hole_mask.shape
+    top = random.randint(1, 3)
+    bottom = random.randint(1, 3)
+    left = random.randint(1, 3)
+    right = random.randint(1, 3)
