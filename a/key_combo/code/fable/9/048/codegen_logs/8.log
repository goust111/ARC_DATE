+        return False
+    new_coords = [(top + r, left + c) for r in range(h) for c in range(w) if mask[r, c]]
+    for nr, nc in new_coords:
+        for orr, occ in occupied:
+            if max(abs(nr - orr), abs(nc - occ)) <= PLACEMENT_GAP:
