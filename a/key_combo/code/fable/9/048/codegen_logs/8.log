+    corners = [
+        ("tl", top, left),
+        ("tr", top, right),
+        ("bl", bottom, left),
+        ("br", bottom, right),
+    ]
+    random.shuffle(corners)
+    for corner, max_h, max_w in corners[: random.randint(0, 2)]:
+        if max_h <= 0 or max_w <= 0:
+            continue
+        notch_h = random.randint(1, max_h)
+        notch_w = random.randint(1, max_w)
+        if corner == "tl":
+            outer[:notch_h, :notch_w] = False
