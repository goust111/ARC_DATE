+    if not (same_area or same_bbox):
+        return False
+
+    if np.array_equal(inp, expected):
+        return False
+
+    return True
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        built = _build_scene()
+        if built is None:
+            continue
+        inp, expected, meta = built
+        if _scene_semantics_ok(inp, expected, meta):
