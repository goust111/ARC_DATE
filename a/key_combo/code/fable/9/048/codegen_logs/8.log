+            {
+                "idx": idx,
+                "top": top,
+                "left": left,
+                "hole_coords": [(top + r, left + c) for r, c in local_hole_coords],
+                "hole_mask": hole_shapes[idx].copy(),
+                "host_color": host_colors[idx],
+            }
+        )
