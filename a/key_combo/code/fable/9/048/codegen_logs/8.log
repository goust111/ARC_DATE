+        mask = grid == color
+        for coords in _connected_components(mask):
+            r0, c0, r1, c1 = _bbox_from_coords(coords)
+            local = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+            for r, c in coords:
+                local[r - r0, c - c0] = True
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": (r0, c0, r1, c1),
+                    "mask": local,
+                    "area": int(local.sum()),
+                }
+            )
+    return comps
+
