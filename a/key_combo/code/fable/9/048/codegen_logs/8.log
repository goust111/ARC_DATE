+    host_hits = Counter(hi for _, hi, _ in all_matches)
+    if len(host_hits) != len(hosts) or any(v != 1 for v in host_hits.values()):
+        raise ValueError("sprite-hole relation must be bijective")
+    return all_matches, needed_rotations
