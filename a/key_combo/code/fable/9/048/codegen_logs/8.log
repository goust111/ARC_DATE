+def _random_colors(count: int, avoid: list[int] | None = None) -> list[int]:
+    avoid = avoid or [BG]
+    choices = [c for c in PALETTE if c not in set(avoid)]
+    return [random.choice(choices) for _ in range(count)]
+
+
