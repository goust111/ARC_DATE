+
+def _matchings(hosts: list[dict], sprites: list[dict]) -> tuple[list[tuple[int, int, int]], list[int]]:
+    all_matches: list[tuple[int, int, int]] = []
+    needed_rotations: list[int] = []
+    for si, sprite in enumerate(sprites):
