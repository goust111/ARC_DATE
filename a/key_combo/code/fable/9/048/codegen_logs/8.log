+    hosts: list[dict] = []
+    sprites: list[dict] = []
+    for comp in _find_monochrome_components(grid, bg):
+        holes = _enclosed_holes(comp)
+        if len(holes) == 1:
+            hosts.append({**comp, "hole": holes[0]})
+        elif len(holes) == 0:
+            sprites.append(comp)
+        else:
+            raise ValueError("each component must be a free sprite or a one-hole host")
+    return hosts, sprites, bg
