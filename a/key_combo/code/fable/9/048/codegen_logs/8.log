+        global_coords: list[tuple[int, int]] = []
+        for rr, cc in hole_coords:
+            local[rr - hr0, cc - hc0] = True
+            global_coords.append((r0 + rr, c0 + cc))
+        holes.append(
+            {
+                "coords": global_coords,
+                "bbox": (r0 + hr0, c0 + hc0, r0 + hr1, c0 + hc1),
+                "mask": local,
+                "area": int(local.sum()),
+            }
+        )
+    return holes
