+
+def _b(mask_rows: list[str]) -> np.ndarray:
+    return np.array([[ch == "1" for ch in row] for row in mask_rows], dtype=bool)
+
+
+SHAPE_LIBRARY = [
+    _b(["11", "10"]),
+    _b(["111", "100"]),
+    _b(["111", "010"]),
+    _b(["110", "011", "001"]),
+    _b(["111", "100", "100"]),
+    _b(["110", "100", "110"]),
+    _b(["1111", "1000"]),
+    _b(["111", "101", "100"]),
+    _b(["1110", "0011"]),
+    _b(["111", "001", "011"]),
+    _b(["1111", "0100", "0110"]),
+    _b(["111", "010", "011", "001"]),
