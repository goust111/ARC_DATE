+def _choose_active_counts(n_sources: int) -> list[int]:
+    counts = random.choices(ACTIVE_COUNT_CHOICES, weights=ACTIVE_COUNT_WEIGHTS, k=n_sources)
+    if max(counts) < 2:
+        counts[random.randrange(n_sources)] = 2
