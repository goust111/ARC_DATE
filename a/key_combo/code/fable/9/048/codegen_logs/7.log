+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+TEAL = 8
+DEFLECTOR_COLORS = [1, 2, 3, 4, 5, 6, 7, 9]
+
+HEIGHT_RANGE = (10, 22)
+WIDTH_RANGE = (14, 28)
+SOURCE_COUNT_RANGE = (2, 4)
+ACTIVE_COUNT_CHOICES = (0, 1, 2, 3)
+ACTIVE_COUNT_WEIGHTS = (2, 3, 3, 2)
+EXTRA_INACTIVE_RANGE = (1, 3)
+MAX_ATTEMPTS = 400
