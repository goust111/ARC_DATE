+        bg_area = int(inp.size - target_area)
+        if bg_area <= target_area:
+            continue
+        touching = [
+            i
+            for i in range(len(runs) - 1)
+            if runs[i][3] + 1 == runs[i + 1][1] and (runs[i][0], runs[i][2]) != (runs[i + 1][0], runs[i + 1][2])
+        ]
+        if not touching:
