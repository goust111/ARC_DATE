+def _reflect_quadrant(quadrant: np.ndarray) -> np.ndarray:
+    return np.block(
+        [
+            [quadrant, quadrant[:, ::-1]],
+            [quadrant[::-1, :], quadrant[::-1, ::-1]],
+        ]
+    )
+
