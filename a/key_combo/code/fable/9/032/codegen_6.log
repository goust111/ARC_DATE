+def _apply_random_symmetry(grid: np.ndarray) -> np.ndarray:
+    choice = random.randint(0, 7)
+    if choice == 0:
+        return grid
+    if choice == 1:
+        return np.rot90(grid, 1)
+    if choice == 2:
+        return np.rot90(grid, 2)
+    if choice == 3:
+        return np.rot90(grid, 3)
+    if choice == 4:
+        return np.fliplr(grid)
+    if choice == 5:
+        return np.flipud(grid)
+    if choice == 6:
