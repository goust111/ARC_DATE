+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return None
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _corner_coord(bbox: tuple[int, int, int, int], corner: str) -> tuple[int, int]:
+    r0, c0, r1, c1 = bbox
+    if corner == "TL":
