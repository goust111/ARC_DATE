+    if corner == "TR":
+        return r0, c1
+    if corner == "BL":
+        return r1, c0
+    if corner == "BR":
+        return r1, c1
+    raise ValueError(f"bad corner {corner}")
+
+
+def _corner_step(corner: str) -> tuple[int, int]:
