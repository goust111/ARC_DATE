+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GRAY = 5
+PINK = 6
+ORANGE = 7
+TEAL = 8
+MAROON = 9
+
+RIBBON_PALETTE = (BLUE, RED, GREEN, YELLOW, PINK, TEAL, MAROON)
+
+MIN_HEIGHT = 13
+MAX_HEIGHT = 24
+MIN_WIDTH = 12
+MAX_WIDTH = 24
+MIN_TURNS = 2
+MAX_TURNS = 5
