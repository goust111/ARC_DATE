+    left = col
+    while left - 1 >= 0 and int(grid[row, left - 1]) == ORANGE:
+        left -= 1
+    right = col
+    while right + 1 < w and int(grid[row, right + 1]) == ORANGE:
+        right += 1
+    return left, right
