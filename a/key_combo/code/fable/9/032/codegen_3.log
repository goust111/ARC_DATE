                r = row_runs[tile_r][0] + dr
                c = col_runs[tile_c][0] + dc
                assert int(out[r, c]) in structural or int(out[r, c]) == color, "conflicting marker segment"
                out[r, c] = color
                covered.add((tile_r, tile_c))

