spec:
  lattice:
    tile_grid: 3-5 rows x 3-5 cols
    tile_size: 4x4 (1-cell frame ring + 2x2 interior)
    separator: 1 cell wide between all tiles and on all borders; always color 0
    grid_dims: 5*tile_rows+1 x 5*tile_cols+1
  colors:
    separator: always 0
    frame: uniform across all tile borders; any non-0 color
    fill: dominant interior color; distinct from frame and 0
    all three structural colors are distinct
  base_interior_pattern:
    fixed 2x2 pattern shared by every tile; 0-1 subcells use frame color, rest use fill [observed]
    markers may only occupy subcells that are fill-color in the base pattern
  marker_groups:
    count: 2-4 groups per grid
    each group defined by (unique marker_color, subcell_position dr,dc in {1,2}x{1,2})
    each marker_color appears in exactly one group
    marker_color distinct from all structural colors
    markers_per_group: 2-3 endpoint tiles
    shape: 2 endpoints = single H or V segment; 3 endpoints = L-shape (1 H + 1 V sharing a corner tile)
    segment_length: 3-5 tiles (spans >=60% of that axis of tile grid)
    no two groups paint the same (tile, subcell) -- segments must not conflict
  transform:
