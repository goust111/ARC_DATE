+def _cross_pair_specs(tile_rows: int, tile_cols: int, colors: list[int]) -> tuple[list[tuple[Marker, list[tuple[int, int]], str]], bool] | None:
+    cross_r = random.randint(1, tile_rows - 2)
+    cross_c = random.randint(1, tile_cols - 2)
