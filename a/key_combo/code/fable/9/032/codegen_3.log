+
+BLACK = 0
+INNER = 3
+STRIDE = INNER + 1
+LOCAL_CENTER = (1, 1)
+LOCAL_TO_DIR = {
+    (0, 1): (-1, 0),
+    (2, 1): (1, 0),
+    (1, 0): (0, -1),
+    (1, 2): (0, 1),
