+
+    for r, (left, right) in enumerate(rows[:-1]):
+        row_width = right - left + 1
+        if row_width < 5:
+            return None
+        p1, p2 = _row_sections(row_width)
+        spans = [
+            (left, left + p1),
+            (left + p1, left + p2),
+            (left + p2, right),
+        ]
+        for fragment, (span_left, span_right) in zip(fragments, spans):
+            fragment[r, span_left : span_right + 1] = True
+
