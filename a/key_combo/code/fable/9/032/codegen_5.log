+def _render_input(patches: list[np.ndarray]) -> np.ndarray | None:
+    max_h = max(patch.shape[0] for patch in patches)
+    max_w = max(patch.shape[1] for patch in patches)
+    min_h = max(12, max_h + 6)
+    min_w = max(16, max_w + 8)
+    for _ in range(80):
