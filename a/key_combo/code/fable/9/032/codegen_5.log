+    raw_mask = raw != 0
+    return not np.array_equal(raw_mask, expected_mask)
+
+
+def _attempt() -> np.ndarray | None:
+    template = _generate_template()
+    if template is None:
+        return None
+    fragments = _generate_fragments(template)
+    if fragments is None:
