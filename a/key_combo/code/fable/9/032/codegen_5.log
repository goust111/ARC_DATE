+    return mask
+
+
+def _row_sections(row_width: int) -> tuple[int, int]:
+    valid = [
+        (p1, p2)
+        for p1 in range(1, row_width - 2)
+        for p2 in range(p1 + 2, row_width - 1)
+    ]
+    return random.choice(valid)
