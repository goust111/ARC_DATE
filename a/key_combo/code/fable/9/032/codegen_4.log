+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+GRAY = 5
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+
+GEN_RETRY_LIMIT = 600
+MIN_BAND = 2
+MAX_BAND = 4
+MIN_WINDOW = 6
+MAX_WINDOW = 14
+MAX_SEARCH_SPACE = 4000
+
+
+Coord = tuple[int, int]
+BBox = tuple[int, int, int, int]
