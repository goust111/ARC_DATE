+    assert int(mask.sum()) == (r1 - r0 + 1) * (c1 - c0 + 1), "gray cells must form exactly one rectangle"
+    return r0, c0, r1, c1
+
+
+def _manhattan(a: Coord, b: Coord) -> int:
+    return abs(int(a[0]) - int(b[0])) + abs(int(a[1]) - int(b[1]))
