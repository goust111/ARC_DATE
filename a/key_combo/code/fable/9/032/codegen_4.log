+
+
+def _candidate_seed_cells(grid: np.ndarray, window: BBox) -> tuple[list[int], dict[int, list[Coord]]]:
+    colors = sorted(int(v) for v in np.unique(grid) if int(v) not in (BLACK, GRAY))
