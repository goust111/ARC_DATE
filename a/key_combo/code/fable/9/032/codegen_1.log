 109: def _gen_frontier(mask: np.ndarray) -> np.ndarray:
 110:     """Return empty cells 4-adjacent to the current connected mask."""
 111:     frontier = np.zeros_like(mask, dtype=bool)
 112:     frontier[1:, :] |= mask[:-1, :]
 113:     frontier[:-1, :] |= mask[1:, :]
 114:     frontier[:, 1:] |= mask[:, :-1]
 115:     frontier[:, :-1] |= mask[:, 1:]
 116:     frontier &= ~mask
 117:     return frontier
