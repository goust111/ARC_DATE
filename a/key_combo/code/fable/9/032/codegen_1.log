+def _place_roots(root_patches: list[dict]) -> tuple[np.ndarray, np.ndarray] | None:
+    order = sorted(range(len(root_patches)), key=lambda i: root_patches[i]["input"].shape[0] * root_patches[i]["input"].shape[1], reverse=True)
