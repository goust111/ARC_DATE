 164:         return [tuple(range(height))]
 165: 
 166:     first_options = [tuple(range(k)) for k in range(1, height + 1)]
 167:     states = [random.choice(first_options)]
 168:     covered = set(states[0])
 169:     for idx in range(1, run_count):
 170:         remaining_slots = run_count - idx
 171:         missing = set(range(height)) - covered
 172:         required: set[int] = set()
 173:         if missing and idx == run_count - 1:
 174:             required = set(missing)
 175:         elif missing and len(missing) >= remaining_slots:
 176:             required = {min(missing)}
 177:         choices = [
