+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+CANVAS_LIMIT = 30
+GEN_RETRIES = 400
+ROOT_GAP = 2
+FRAME_SIZE_CHOICES = (7, 9, 11, 13)
+NESTED_CHILD_SIZE_CHOICES = (7, 9)
+CORNERS = ("TL", "TR", "BL", "BR")
