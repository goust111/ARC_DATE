+    left_pad = random.randint(0, min(4, int(c0)))
+    bottom_pad = random.randint(0, min(4, CANVAS_LIMIT - 1 - int(r1)))
+    right_pad = random.randint(0, min(4, CANVAS_LIMIT - 1 - int(c1)))
