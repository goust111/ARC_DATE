+        target_shape = meta["target_shape"]
+        if target_shape == exemplar.shape:
+            return False
+        stretched = stretch_pattern(exemplar, target_shape)
+        stretched_patches.append(stretched)
+        if np.array_equal(stretched, exemplar):
