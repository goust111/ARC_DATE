+def build_exemplar(outer: int, inner: int) -> tuple[np.ndarray, dict]:
+    top = random.randint(*FRAME_THICKNESS_RANGE)
+    bottom = random.randint(*FRAME_THICKNESS_RANGE)
+    left = random.randint(*FRAME_THICKNESS_RANGE)
