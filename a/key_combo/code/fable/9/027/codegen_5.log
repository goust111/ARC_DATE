+        tl, br = order_marker_pair(markers[color])
+        target_shape = (br[0] - tl[0] + 1, br[1] - tl[1] + 1)
+        stamp = stretch_pattern(exemplar, target_shape)
+        out[tl[0] : br[0] + 1, tl[1] : br[1] + 1] = stamp
+
+    return out
