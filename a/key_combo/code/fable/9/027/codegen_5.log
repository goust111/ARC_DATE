+MAX_ATTEMPTS = 500
+GRID_H_RANGE = (22, 30)
+GRID_W_RANGE = (22, 30)
+EXEMPLAR_COUNT_CHOICES = (2, 3)
+FRAME_THICKNESS_RANGE = (1, 3)
+CENTER_SIZE_RANGE = (1, 4)
+TARGET_DELTA_RANGE = (1, 6)
+PADDING = 1
