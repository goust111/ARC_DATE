  "type": "move_to_match",
  "src": "external two-color sprite s with one marker pixel and a shared stamp-color mask",
  "dst": "same-colored marker pixel d inside the large filled rectangle",
  "match_cond": "s.marker.color == d.color",
  "transform": "copy s.stamp-color offsets around d while preserving d",
  "grid_shape": "bbox of the large filled rectangle"
}
</annotation>
<generation_spec>
