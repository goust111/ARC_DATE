  rectangle:
    size: 6-12 rows x 6-15 cols, solidly filled with fill_color (not bg, not stamp_color)
    markers: 2-5 isolated single pixels of distinct colors inside the rectangle (not fill_color, not stamp_color)
    each marker >=1 cell from every edge so stamped sprites stay in bounds
  sprites:
    count: one per marker + 0-1 distractors (distractor marker color absent from rectangle)
    shape: 3x3 bbox centered on a single marker pixel; 3-7 of the 8 neighbor cells filled with stamp_color
