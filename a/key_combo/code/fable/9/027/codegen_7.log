+        n_tile_rows,
+        n_tile_cols,
+        forbidden=set(path),
+        count=extra_total,
+    )
+    if chosen_extra_tiles is None:
+        return None
+
+    extra_colors = extras_by_color[:]
+    while len(extra_colors) < extra_total:
+        extra_colors.append(random.choice(repeat_colors))
+    random.shuffle(extra_colors)
