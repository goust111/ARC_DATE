+def _runs_between_stops(length: int, stops: list[int]) -> list[tuple[int, ...]]:
+    stop_set = set(stops)
+    runs: list[tuple[int, ...]] = []
+    start = None
+    for idx in range(length):
+        if idx in stop_set:
+            if start is not None:
+                runs.append(tuple(range(start, idx)))
+                start = None
+        elif start is None:
+            start = idx
+    if start is not None:
+        runs.append(tuple(range(start, length)))
+    return runs
