+    for dr, dc in DIRECTIONS8:
+        nxt = (tile[0] + dr, tile[1] + dc)
+        if _in_bounds_tile(n_rows, n_cols, nxt):
+            out.append((nxt, (dr, dc)))
+    return out
+
