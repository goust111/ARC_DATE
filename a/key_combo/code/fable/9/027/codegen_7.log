+def _outward_dirs(n_rows: int, n_cols: int, tile: tuple[int, int]) -> list[tuple[int, int]]:
+    out = []
+    for dr, dc in DIRECTIONS8:
+        nxt = (tile[0] + dr, tile[1] + dc)
+        if not _in_bounds_tile(n_rows, n_cols, nxt):
+            out.append((dr, dc))
+    return out
