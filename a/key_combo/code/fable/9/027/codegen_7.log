+    }
+
+    chain_marker_tiles = set(path[:-1] if stop_mode == "no_pointer" else path)
+    if len(chain_marker_tiles) < 2:
+        return None
+
+    non_start_chain_tiles = [tile for tile in path[1:] if tile in chain_marker_tiles]
+    if not non_start_chain_tiles:
+        return None
