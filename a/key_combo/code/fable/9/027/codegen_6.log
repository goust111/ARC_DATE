+def _choose_layout():
+    small, large = random.choice(((2, 4), (3, 5)))
+    bracket_specs = [
+        {"inner_width": small, "set_id": 0},
+        {"inner_width": small, "set_id": 1},
+        {"inner_width": large, "set_id": 0},
