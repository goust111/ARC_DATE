+        else:
+            left_tip, right_tip = colors[::-1]
+        br = {
+            "inner_width": int(spec["inner_width"]),
+            "set_id": int(spec["set_id"]),
+            "left_tip": int(left_tip),
+            "right_tip": int(right_tip),
+            "c0": int(x),
