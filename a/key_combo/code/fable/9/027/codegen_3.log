+    comps: dict[int, list[tuple[int, int]]] = {}
+    next_id = 0
+    for r in range(h):
+        for c in range(w):
+            if ids[r, c] != -1 or int(grid[r, c]) != bg:
+                continue
+            q = deque([(r, c)])
+            ids[r, c] = next_id
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
