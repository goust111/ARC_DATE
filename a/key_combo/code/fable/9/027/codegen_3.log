+def _place_rectangle(grid: np.ndarray, box: tuple[int, int, int, int], color: int) -> None:
+    r0, c0, r1, c1 = box
+    grid[r0 : r1 + 1, c0 : c1 + 1] = int(color)
+
+
+def _solo_valid_rays(divider_grid: np.ndarray, box: tuple[int, int, int, int]) -> list[dict]:
