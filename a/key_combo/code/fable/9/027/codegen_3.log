+                        "rect_index": rect_index,
+                        "src_color": int(rect["color"]),
+                        "corner": corner_name,
+                        "status": "boundary",
+                    }
+                )
+                continue
+
+            hit = int(g[rr, cc])
+            if hit != GREY:
