+                    {
+                        "rect_index": rect_index,
+                        "src_color": int(rect["color"]),
+                        "corner": corner_name,
+                        "status": "rectangle",
+                        "hit": (rr, cc),
+                    }
+                )
+                continue
+
+            if not _is_divider_corner(divider_mask, rr, cc):
