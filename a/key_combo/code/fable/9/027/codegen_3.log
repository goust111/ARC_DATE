+
+def _enumerate_inside_candidates(
+    divider_grid: np.ndarray,
+    frame_box: tuple[int, int, int, int],
+    annulus_id: int,
+    interior_id: int,
+    bg_ids: np.ndarray,
+) -> list[dict]:
