+            if not _in_bounds(g.shape, rr, cc):
+                rays.append(
+                    {
+                        "rect_index": rect_index,
+                        "src_color": int(rect["color"]),
+                        "corner": corner_name,
+                        "status": "boundary",
+                    }
+                )
+                continue
+
+            hit = int(g[rr, cc])
+            if hit != GREY:
+                rays.append(
+                    {
+                        "rect_index": rect_index,
+                        "src_color": int(rect["color"]),
+                        "corner": corner_name,
+                        "status": "rectangle",
+                        "hit": (rr, cc),
+                    }
+                )
+                continue
+
+            if not _is_divider_corner(divider_mask, rr, cc):
