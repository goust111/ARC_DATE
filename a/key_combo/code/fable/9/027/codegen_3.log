+
+def _corner_point(box: tuple[int, int, int, int], corner: str) -> tuple[int, int]:
+    r0, c0, r1, c1 = box
+    if corner == "tl":
+        return r0, c0
+    if corner == "tr":
+        return r0, c1
+    if corner == "bl":
+        return r1, c0
+    return r1, c1
