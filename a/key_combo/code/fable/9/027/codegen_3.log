+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+RECT_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+CORNERS = ("tl", "tr", "bl", "br")
+DIR_BY_CORNER = {
+    "tl": (-1, -1),
+    "tr": (-1, 1),
+    "bl": (1, -1),
+    "br": (1, 1),
+}
