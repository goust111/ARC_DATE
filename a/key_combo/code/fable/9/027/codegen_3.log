+            component = int(bg_ids[nr, nc])
+            assert component >= 0
+            rays.append(
+                {
+                    "rect_index": rect_index,
+                    "src_color": int(rect["color"]),
+                    "corner": corner_name,
+                    "status": "valid",
+                    "hit": (rr, cc),
+                    "entry": (nr, nc),
+                    "component": component,
+                }
+            )
