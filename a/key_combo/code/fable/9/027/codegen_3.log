+                    {
+                        "rect_index": rect_index,
+                        "src_color": int(rect["color"]),
+                        "corner": corner_name,
+                        "status": "divider_edge",
+                        "hit": (rr, cc),
+                    }
+                )
+                continue
+
+            nr, nc = rr + dr, cc + dc
+            if not _in_bounds(g.shape, nr, nc) or int(g[nr, nc]) != bg:
+                rays.append(
+                    {
+                        "rect_index": rect_index,
+                        "src_color": int(rect["color"]),
+                        "corner": corner_name,
+                        "status": "blocked_after_corner",
+                        "hit": (rr, cc),
+                    }
+                )
+                continue
+
+            component = int(bg_ids[nr, nc])
+            assert component >= 0
+            rays.append(
+                {
+                    "rect_index": rect_index,
+                    "src_color": int(rect["color"]),
+                    "corner": corner_name,
+                    "status": "valid",
+                    "hit": (rr, cc),
+                    "entry": (nr, nc),
+                    "component": component,
+                }
+            )
