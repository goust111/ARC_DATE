+
+
+def _clear_diagonal_to_corner(
+    divider_grid: np.ndarray,
+    start: tuple[int, int],
+    direction: tuple[int, int],
+    hit: tuple[int, int],
+) -> bool:
+    dr, dc = direction
+    r, c = start
+    while (r, c) != hit:
+        r += dr
+        c += dc
+        if (r, c) == hit:
