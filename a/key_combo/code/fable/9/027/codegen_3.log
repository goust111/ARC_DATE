+                        "rect_index": rect_index,
+                        "src_color": int(rect["color"]),
+                        "corner": corner_name,
+                        "status": "divider_edge",
+                        "hit": (rr, cc),
+                    }
+                )
+                continue
+
+            nr, nc = rr + dr, cc + dc
