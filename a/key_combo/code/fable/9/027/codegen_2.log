+GRID_H_RANGE = (18, 26)
+GRID_W_RANGE = (18, 26)
+RECT_H_RANGE = (3, 6)
+RECT_W_RANGE = (4, 7)
+PASSENGER_COUNT_RANGE = (2, 4)
+PASSENGER_H_RANGE = (3, 5)
