+
+def _footprint_cells(top: int, left: int, height: int, width: int) -> set[tuple[int, int]]:
+    return {
+        (r, c)
+        for r in range(int(top), int(top) + int(height))
+        for c in range(int(left), int(left) + int(width))
+    }
