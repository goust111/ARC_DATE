+def _apply_completions(grid: np.ndarray, cracks: dict[int, dict], bg: int) -> np.ndarray:
+    out = grid.copy()
+    for info in cracks.values():
+        source = info["source"]
+        color = int(info["color"])
+        dr, dc = map(int, info["vector"])
+        for r, c in source:
+            out[r, c] = int(bg)
+        for r, c in source:
+            rr, cc = r + dr, c + dc
+            assert int(out[rr, cc]) == int(bg)
+            out[rr, cc] = color
+    return out
