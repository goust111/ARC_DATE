+        candidates: list[dict] = []
+        for src in edge_parts:
+            source = _coord_set(src["coords"])
+            for anc in inner_parts:
+                anchor = _coord_set(anc["coords"])
+                offsets = _solid_completion_offsets(grid, source, anchor, bg)
+                if len(offsets) == 1:
