MIN_ROW_WIDTH = 1
SOURCE_RIGHT_PAD = 2
DST_WIDTH_RESERVED_COLS = 1

# Sampling controls.
PALETTE_COLORS = tuple(range(10))
NONSPLIT_ABOVE_CHOICES = (True, False)
