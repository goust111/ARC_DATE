+                r0 = max(0, min(rr for rr, _ in cells) - 1)
+                r1 = min(legend_h - 1, max(rr for rr, _ in cells) + 1)
+                c0 = max(0, min(cc for _, cc in cells) - 1)
+                c1 = min(width - 1, max(cc for _, cc in cells) + 1)
