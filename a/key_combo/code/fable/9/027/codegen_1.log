    min_density, max_density = GEN_DENSITY_BOUNDS
    if not (min_density <= density <= max_density):
        return None

    if not _gen_matches_oracle(grid, expected):
        return None
    return grid


def generate_input():
    for _ in range(GEN_MAX_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
