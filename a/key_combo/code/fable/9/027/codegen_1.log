def _assert_solid_rect(g: np.ndarray, obj: dict) -> None:
    r0, c0, r1, c1 = obj["bbox"]
    region = g[r0 : r1 + 1, c0 : c1 + 1]
    assert np.all(region == obj["color"]), "each foreground object must be a solid rectangle"


