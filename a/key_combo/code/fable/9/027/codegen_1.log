+        cells = random.choice(candidates)
+        if orientation == "H":
+            (r0, c0), (r1, c1) = cells
+            legend[r0, c0] = coverer
+            legend[r1, c1] = covered
+        else:
+            (r0, c0), (r1, c1) = cells
+            legend[r0, c0] = coverer
+            legend[r1, c1] = covered
+
+        rr0 = max(0, min(rr for rr, _ in cells) - 1)
+        rr1 = min(legend_h - 1, max(rr for rr, _ in cells) + 1)
+        cc0 = max(0, min(cc for _, cc in cells) - 1)
