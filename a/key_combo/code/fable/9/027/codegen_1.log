+    width = 2 * panel_w + 1
+    grid = np.full((height, width), bg, dtype=int)
+
+    grid[panel_h, :] = sep_color
+    grid[2 * panel_h + 1, :] = sep_color
+    grid[: 2 * panel_h + 1, panel_w] = sep_color
+
+    origins = [
+        (0, 0),
+        (0, panel_w + 1),
+        (panel_h + 1, 0),
+        (panel_h + 1, panel_w + 1),
