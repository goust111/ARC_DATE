+        if not candidates:
+            return None
+
+        cells = random.choice(candidates)
+        if orientation == "H":
+            (r0, c0), (r1, c1) = cells
+            legend[r0, c0] = coverer
+            legend[r1, c1] = covered
+        else:
+            (r0, c0), (r1, c1) = cells
+            legend[r0, c0] = coverer
+            legend[r1, c1] = covered
