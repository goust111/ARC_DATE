+    orientations = ["H", "V"] + [random.choice(["H", "V"]) for _ in range(len(relations) - 2)]
+    random.shuffle(orientations)
+
+    for (coverer, covered), orientation in zip(relations, orientations):
+        candidates = []
+        for r in range(legend_h):
+            for c in range(width):
+                if orientation == "H":
