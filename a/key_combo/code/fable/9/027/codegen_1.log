+
+PANEL_H_RANGE = (4, 6)
+PANEL_W_RANGE = (4, 6)
+LEGEND_H_RANGE = (4, 6)
+VISIBLE_MIN_PER_PANEL = 3
+BG_MIN = 1
+GEN_RETRIES = 400
+EMIT_DEDUP_RETRIES = 200
+
+_SEEN_INPUT_SIGS: set[tuple[tuple[int, int], bytes]] = set()
