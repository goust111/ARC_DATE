+def _fine_shape(rows: int, cols: int) -> tuple[int, int]:
+    return (
+        2 * GEN_MARGIN + (rows - 1) * GEN_SPACING + 1,
+        2 * GEN_MARGIN + (cols - 1) * GEN_SPACING + 1,
