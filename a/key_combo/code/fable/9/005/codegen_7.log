+                c0 = c - door_offset
+                door = (r + 1, c) if dr == 1 else (r - 1, c)
+                candidates.append((h, w, r0, c0, door))
+        else:
+            offsets = list(range(1, h - 1))
+            random.shuffle(offsets)
+            for door_offset in offsets:
+                r0 = r - door_offset
+                c0 = c + 1 if dc == 1 else c - w
+                door = (r, c + 1) if dc == 1 else (r, c - 1)
+                candidates.append((h, w, r0, c0, door))
