+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _neighbors4(shape: tuple[int, int], r: int, c: int):
+    for dr, dc in DIRS4:
+        nr, nc = r + dr, c + dc
+        if _in_bounds(shape, nr, nc):
+            yield nr, nc
