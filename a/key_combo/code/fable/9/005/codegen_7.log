+
+def _bfs_dist(mask: np.ndarray, start: tuple[int, int]) -> np.ndarray:
+    dist = np.full(mask.shape, -1, dtype=int)
+    sr, sc = start
+    dist[sr, sc] = 0
+    q = deque([start])
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(mask.shape, r, c):
+            if mask[nr, nc] and dist[nr, nc] == -1:
