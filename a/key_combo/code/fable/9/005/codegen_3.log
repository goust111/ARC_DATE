+        values = set(map(int, sub.ravel()))
+        if values != {a, b}:
+            continue
+        candidates.append((sub.copy(), int(scale_h)))
+
+    assert len(candidates) == 1, "expected exactly one complete non-blue color pair"
+    return candidates[0]
+
