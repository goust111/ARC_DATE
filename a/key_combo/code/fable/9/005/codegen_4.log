+
+def _search_free_marker(
+    frame_idx: int,
+    depth: int,
+    boxes: list[tuple[int, int, int, int]],
+    placed: list[tuple[int, int]],
+    shape: tuple[int, int],
+) -> tuple[int, int] | None:
+    rows, cols = shape
