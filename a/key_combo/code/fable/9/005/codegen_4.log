+from __future__ import annotations
+
+import itertools
+import random
+
+import numpy as np
+
+
+BG = 0
+FRAME = 5
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+
+GEN_ATTEMPTS = 600
+GRID_MIN = 20
+GRID_MAX = 30
+FRAME_SIZE_MIN = 5
+FRAME_SIZE_MAX = 11
+LINE_PROB = 0.55
+GREY_DECOY_PROB = 0.55
