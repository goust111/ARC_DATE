+def _sample_depths(
+    max_depth: int,
+    *,
+    min_count: int,
+    require_depth_one: bool,
+    prefer_empty_shell: bool,
+) -> list[int]:
+    all_depths = list(range(1, max_depth + 1))
+    min_count = min(min_count, max_depth)
+    high = max_depth
+    if prefer_empty_shell and max_depth > min_count:
+        high = max_depth - 1
+    count = random.randint(min_count, high)
