+def _gen_attempt() -> np.ndarray | None:
+    shape = (
+        random.randint(GRID_MIN, GRID_MAX),
+        random.randint(GRID_MIN, GRID_MAX),
+    )
+    sizes = _sample_frame_sizes()
+    boxes = _sample_boxes(shape, sizes)
+    if boxes is None:
