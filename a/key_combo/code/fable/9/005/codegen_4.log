  "type": "transform_in_place",
  "src": "non-background color masks classified by their 4-connected component count and area",
  "transform": "choose the unique largest color mask that forms exactly one 4-connected object; output a solid tile of that color",
  "grid_shape": "3x3 solid color tile"
}
</annotation>
