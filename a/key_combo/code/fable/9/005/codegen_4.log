+    markers = []
+    seen_depths = [set(), set()]
+    for r, c in np.argwhere((g != BG) & ~mask):
+        coord = (int(r), int(c))
+        distances = [_dist_to_frame_border(coord, box) for box in boxes]
+        owner = int(np.argmin(distances))
+        depth = int(distances[owner])
+        other = int(distances[1 - owner])
