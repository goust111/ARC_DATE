   288	    high = max_depth
   289	    if prefer_empty_shell and max_depth > min_count:
   290	        high = max_depth - 1
   291	    count = random.randint(min_count, high)
   292	    if require_depth_one:
   293	        rest = random.sample([d for d in all_depths if d != 1], count - 1)
   294	        depths = [1, *rest]
   295	    else:
   296	        depths = random.sample(all_depths, count)
   297	    return sorted(depths)
