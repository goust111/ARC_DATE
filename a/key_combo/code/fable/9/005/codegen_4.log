   219	def _sample_frame_sizes() -> list[tuple[int, int]]:
   220	    while True:
   221	        sizes = [
   222	            (
   223	                random.randint(FRAME_SIZE_MIN, FRAME_SIZE_MAX),
   224	                random.randint(FRAME_SIZE_MIN, FRAME_SIZE_MAX),
   225	            )
