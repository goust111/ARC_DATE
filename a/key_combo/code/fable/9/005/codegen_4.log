+def _sample_frame_sizes() -> list[tuple[int, int]]:
+    while True:
+        sizes = [
+            (
+                random.randint(FRAME_SIZE_MIN, FRAME_SIZE_MAX),
+                random.randint(FRAME_SIZE_MIN, FRAME_SIZE_MAX),
+            )
+            for _ in range(2)
+        ]
+        if sizes[0] != sizes[1]:
+            return sizes
