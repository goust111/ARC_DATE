   232	def _sample_boxes(shape: tuple[int, int], sizes: list[tuple[int, int]]) -> list[tuple[int, int, int, int]] | None:
   233	    rows, cols = shape
   234	    depth_limits = [_max_depth(h, w) for h, w in sizes]
   235	    order = sorted(range(2), key=lambda idx: sizes[idx][0] * sizes[idx][1], reverse=True)
   236	    placed: dict[int, tuple[int, int, int, int]] = {}
   237	
   238	    for _ in range(200):
   239	        placed.clear()
   240	        ok = True
   241	        for idx in order:
   242	            h, w = sizes[idx]
   243	            halo = depth_limits[idx]
   244	            r_lo = halo
   245	            r_hi = rows - halo - h
   246	            c_lo = halo
   247	            c_hi = cols - halo - w
   248	            if r_lo > r_hi or c_lo > c_hi:
   249	                ok = False
   250	                break
   251	            positions = [
   252	                (r0, c0)
   253	                for r0 in range(r_lo, r_hi + 1)
   254	                for c0 in range(c_lo, c_hi + 1)
   255	                if all(
   256	                    _bbox_gap(
   257	                        (r0 - halo, c0 - halo, r0 + h - 1 + halo, c0 + w - 1 + halo),
   258	                        (
   259	                            prev[0] - depth_limits[jdx],
   260	                            prev[1] - depth_limits[jdx],
   261	                            prev[2] + depth_limits[jdx],
   262	                            prev[3] + depth_limits[jdx],
   263	                        ),
   264	                    )
   265	                    >= 1
   266	                    for jdx, prev in placed.items()
   267	                )
   268	            ]
