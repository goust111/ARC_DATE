+def _find_frames(g: np.ndarray) -> list[dict]:
+    grey = g == FRAME
+    fg = g != BG
+    ps_grey = _prefix_sum(grey)
+    ps_fg = _prefix_sum(fg)
+    rows, cols = g.shape
