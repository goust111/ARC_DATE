+def _search_line_positions(
+    frame_idx: int,
+    depths: list[int],
+    boxes: list[tuple[int, int, int, int]],
+    placed: list[tuple[int, int]],
+    shape: tuple[int, int],
+) -> list[tuple[int, int]] | None:
+    r0, c0, r1, c1 = boxes[frame_idx]
