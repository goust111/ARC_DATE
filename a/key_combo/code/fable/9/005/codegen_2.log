+        choices: list[tuple[int, int]] = []
+        for length in range(2, 6):
+            for c0 in range(0, w - length + 1):
+                if np.any(taken[h - 2, c0 : c0 + length]) or np.any(taken[h - 3, c0 : c0 + length]):
+                    continue
+                choices.append((c0, length))
+        if choices:
+            c0, length = random.choice(choices)
+            bars.append(
