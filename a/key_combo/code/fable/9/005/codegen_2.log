+            return None
+        if _interval_conflicts(used, row, c_start, length):
+            return None
+        for c in range(c_start, c_start + length):
+            used.add((row, c))
+            used_cols_with_rows.add((row, c))
+        bars.append(
+            {
+                "final_row": row,
+                "c0": c_start,
+                "length": length,
+                "color": next_color(),
+                "kind": kind,
+                "frame_bbox": spec["bbox"],
+            }
+        )
