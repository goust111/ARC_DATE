+def _assign_input_rows(static_grid: np.ndarray, bars: list[dict]) -> list[int] | None:
+    order = list(range(len(bars)))
+    order.sort(key=lambda i: (bars[i]["c0"], bars[i]["final_row"]))
+    occupied = static_grid != BLACK
