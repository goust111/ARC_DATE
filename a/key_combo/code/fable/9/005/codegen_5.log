+    r_min, r_max, c_min, c_max = region
+    if r_min + patch_h > r_max or c_min + patch_w > c_max:
+        return None
+    for _ in range(200):
+        r0 = random.randint(r_min, r_max - patch_h)
+        c0 = random.randint(c_min, c_max - patch_w)
+        bbox = (r0, c0, r0 + patch_h - 1, c0 + patch_w - 1)
