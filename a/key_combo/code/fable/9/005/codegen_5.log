+
+def _find_components(
+    grid: np.ndarray,
+    *,
+    bg: int,
+    connectivity: int = 4,
+    monochromatic: bool = True,
+    colors: list[int] | tuple[int, ...] | None = None,
+) -> list[dict]:
+    if monochromatic:
+        if colors is None:
+            colors = _colors_present(grid, exclude={bg})
+        out = []
+        for color in colors:
+            mask = grid == color
+            for coords in _components_from_mask(mask, connectivity):
