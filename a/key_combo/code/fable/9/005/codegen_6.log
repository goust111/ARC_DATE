def _gen_area_tuple(n: int, total: int, hi: int) -> list[int]:
    if n == 2:
        choices = [(a, total - a) for a in range(1, hi + 1) if 1 <= total - a <= hi]
    else:
        choices = [
            (a, b, total - a - b)
            for a in range(1, hi + 1)
