+
+
+def _detect_outline(coords: np.ndarray) -> dict | None:
+    pts = {tuple(map(int, rc)) for rc in coords.tolist()}
+    r0, c0, r1, c1 = _bbox(coords)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
