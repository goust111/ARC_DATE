import numpy as np

from arc_utils import bbox, components_mask


def _symmetry_coords(r: int, c: int, n: int) -> tuple[tuple[int, int], ...]:
    last = n - 1
    return (
        (r, c),
        (r, last - c),
        (last - r, c),
        (last - r, last - c),
        (c, r),
        (last - c, last - r),
        (c, last - r),
        (last - c, r),
    )


def main(grid: np.ndarray) -> np.ndarray:
