+    sep_r, sep_c, sep_color = _find_separator_cross(g)
+    assert sep_color == SEPARATOR, "expected a grey separator cross"
+    assert 0 < sep_r < g.shape[0] - 1 and 0 < sep_c < g.shape[1] - 1, "separator must split four quadrants"
