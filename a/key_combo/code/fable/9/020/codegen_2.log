        colors.append(color)
    assert len(set(colors)) == 4, "quadrant colors must be distinct"
    return colors


def _extract_quadrants(grid: np.ndarray) -> tuple[tuple[np.ndarray, ...], list[int], int]:
    g = np.asarray(grid, dtype=int)
