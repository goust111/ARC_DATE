+def _fold_layers(quadrants: tuple[np.ndarray, ...]) -> list[np.ndarray]:
+    tl, tr, bl, br = quadrants
+    return [tl, np.fliplr(tr), np.flipud(bl), np.flipud(np.fliplr(br))]
