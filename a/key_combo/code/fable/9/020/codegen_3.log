+def _make_base_grid(rows: int, cols: int) -> np.ndarray:
+    h = STRIDE * rows - 1
+    w = STRIDE * cols - 1
+    grid = np.full((h, w), BG, dtype=int)
+    grid[CELL_SIZE::STRIDE, :] = SEP
+    grid[:, CELL_SIZE::STRIDE] = SEP
+    return grid
