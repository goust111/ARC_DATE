+    analysis = _analyze_grid(grid)
+    actual_mapping = analysis["mapping"]
+    cells = analysis["cells"]
+
+    if actual_mapping != planned_mapping:
+        return False
+    if not all(any(cell["marker"] == color for cell in cells) for color in planned_colors):
