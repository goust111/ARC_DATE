    elif symmetry_type == "diagonal":
        if diagonal_orientation:
            grid = np.flipud(grid)
            grid = apply_diagonal_symmetry(grid, background=bg)
            grid = np.flipud(grid)
        else:
            grid = apply_diagonal_symmetry(grid, background=bg)

