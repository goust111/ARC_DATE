+    if np.array_equal(expected, _one_step_output(grid, analysis)):
+        return False
+    if np.array_equal(expected, _local_demo_output(grid, analysis)):
+        return False
+
+    fill_colors = _colors_present(expected, exclude={analysis["divider"]})
+    if len(fill_colors) < 2:
+        return False
+    return True
