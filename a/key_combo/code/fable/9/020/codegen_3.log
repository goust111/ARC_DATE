    tr0, tc0, tr1, tc1 = top_obj
    br0, bc0, br1, bc1 = bot_obj
    if tr1 < r < br0:
        leftc = max(tc0, bc0) + pad
        rightc = min(tc1, bc1) - pad
        if leftc <= c <= rightc:
            return True

    return False


