+def _render_demo_pixels(cell: np.ndarray, color: int) -> None:
+    count = random.choice(DEMO_COUNT_CHOICES)
+    for r, c in random.sample(NON_CENTER_COORDS, count):
+        cell[r, c] = int(color)
