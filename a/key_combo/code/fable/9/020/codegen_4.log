+def _sample_spaced_positions(low: int, high: int, count: int, gap: int) -> list[int] | None:
+    candidates = list(range(low, high + 1))
+    if count == 0:
+        return []
+    for _ in range(200):
+        random.shuffle(candidates)
+        chosen: list[int] = []
+        for value in candidates:
