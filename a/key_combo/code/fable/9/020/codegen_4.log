+
+def _ray_cells(shape: tuple[int, int], spec: SpriteSpec) -> list[tuple[int, int]]:
+    h, w = shape
+    r, c = spec.nozzle_r, spec.nozzle_c
+    dr, dc = {
+        UP: (-1, 0),
+        DOWN: (1, 0),
+        LEFT: (0, -1),
+        RIGHT: (0, 1),
