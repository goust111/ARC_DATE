+                h_sprite, h_idx = first, i
+                v_sprite, v_idx = second, j
+            elif first.direction in VERTICAL_DIRS and second.direction in HORIZONTAL_DIRS:
+                h_sprite, h_idx = second, j
+                v_sprite, v_idx = first, i
+            else:
+                continue
