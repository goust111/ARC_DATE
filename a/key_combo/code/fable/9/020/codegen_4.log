+    ] + [
+        (v_rows[i], v_cols[i], v_dirs[i]) for i in range(n_v)
+    ]
+
+    variant_assignments = list(itertools.product((0, 1), repeat=len(base_specs)))
+    random.shuffle(variant_assignments)
+    for variants in variant_assignments:
