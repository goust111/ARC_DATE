+    (UP, 1): ((1, -1), (1, 0), (2, -1), (2, 0)),
+    (DOWN, 0): ((-2, 0), (-2, 1), (-1, 0), (-1, 1)),
+    (DOWN, 1): ((-2, -1), (-2, 0), (-1, -1), (-1, 0)),
+    (LEFT, 0): ((0, 1), (0, 2), (1, 1), (1, 2)),
+    (LEFT, 1): ((-1, 1), (-1, 2), (0, 1), (0, 2)),
+    (RIGHT, 0): ((0, -2), (0, -1), (1, -2), (1, -1)),
