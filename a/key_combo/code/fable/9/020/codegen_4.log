+                _ray_reaches(h_sprite.direction, h_sprite.nozzle_r, h_sprite.nozzle_c, cell[0], cell[1])
+                and _ray_reaches(v_sprite.direction, v_sprite.nozzle_r, v_sprite.nozzle_c, cell[0], cell[1])
