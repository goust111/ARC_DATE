+                break
+            r += 1
+        r1 = r - 1
+
+        block = grid[r0 : r1 + 1]
+        coords = np.argwhere(block == color)
+        if coords.size == 0:
+            continue
+        c0 = int(coords[:, 1].min())
+        c1 = int(coords[:, 1].max())
+        bbox = block[:, c0 : c1 + 1]
+        hole_mask = bbox == bg
+        hole_count = int(np.count_nonzero(hole_mask))
+        if hole_count <= 0:
+            continue
+        bars.append(
