+def _parse_puzzle(grid: np.ndarray) -> tuple[int, list[dict], list[dict]]:
+    g = np.asarray(grid, dtype=int)
+    bg = _get_bg(g)
+    scatter_rows = _extract_scatter_rows(g, bg)
+    bars = _extract_bars(g, bg)
