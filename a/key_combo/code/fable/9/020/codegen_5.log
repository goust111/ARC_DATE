+        bar = gap_to_bar[gap_count]
+        window = out[bar["r0"] : bar["r1"] + 1, bar["c0"] : bar["c1"] + 1]
+        window[window == bg] = int(info["badge_color"])
+        out[info["row"], :] = bg
+
+    return out
