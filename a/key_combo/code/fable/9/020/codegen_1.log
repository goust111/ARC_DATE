  54: # Canvas and L-object geometry.
  55: GEN_GRID_SHAPE = (7, 7)
  56: GEN_L_SIZE = 2
  57: GEN_L_OFFSETS = ((0, 0), (0, 1), (1, 0), (1, 1))
  58: GEN_L_MISSING_CELLS = 1
  59: GEN_L_FILLED_CELLS = len(GEN_L_OFFSETS) - GEN_L_MISSING_CELLS
  60: GEN_ANCHORS = tuple((r, c) for r in range(GEN_GRID_SHAPE[0] - GEN_L_SIZE + 1)
  61:                     for c in range(GEN_GRID_SHAPE[1] - GEN_L_SIZE + 1))
  62: 
  63: # Object count, placement spacing, and retry limits.
  64: GEN_COUNT_MIN = 2
  65: GEN_COUNT_MAX = 4
  66: GEN_ADJACENCY_GAP = 1
  67: GEN_RETRY_LIMIT = 300
