  74: def _gen_l_box(anchor: tuple[int, int]) -> tuple[int, int, int, int]:
  75:     return anchor[0], anchor[1], anchor[0] + GEN_L_SIZE - 1, anchor[1] + GEN_L_SIZE - 1
  76: 
  77: def _gen_boxes_compatible(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:
  78:     """Return whether two inclusive 2x2 boxes avoid overlap and 4-adjacency."""
  79:     ar0, ac0, ar1, ac1 = a
  80:     br0, bc0, br1, bc1 = b
  81:     rows_overlap = ar0 <= br1 and br0 <= ar1
  82:     cols_overlap = ac0 <= bc1 and bc0 <= ac1
  83:     side_touch = (
  84:         rows_overlap and (ac1 + GEN_ADJACENCY_GAP == bc0 or bc1 + GEN_ADJACENCY_GAP == ac0)
  85:         or cols_overlap and (ar1 + GEN_ADJACENCY_GAP == br0 or br1 + GEN_ADJACENCY_GAP == ar0)
  86:     )
  87:     return not (rows_overlap and cols_overlap or side_touch)
  88: 
  89: def _gen_choose_anchors(count: int) -> list[tuple[int, int]] | None:
  90:     """Pick count anchors whose 2x2 boxes do not overlap or touch by edge."""
  91:     anchors = list(GEN_ANCHORS)
  92: 
  93:     def search(chosen: list[tuple[int, int]], candidates: list[tuple[int, int]]) -> list[tuple[int, int]] | None:
  94:         if len(chosen) == count:
  95:             return chosen
  96:         if len(candidates) < count - len(chosen):
  97:             return None
  98: 
  99:         for idx in np.random.permutation(len(candidates)):
 100:             anchor = candidates[int(idx)]
 101:             box = _gen_l_box(anchor)
 102:             if not all(_gen_boxes_compatible(box, _gen_l_box(prev)) for prev in chosen):
