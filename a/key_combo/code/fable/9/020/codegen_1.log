+    bar_mask[:, cols] = True
+
+    restored_colors: list[int] = []
+    if top_is_h:
+        targets = [(r, c) for r in range(n) if r not in set(map(int, rows)) for c in cols]
+    else:
+        targets = [(r, c) for r in rows for c in range(n) if c not in set(map(int, cols))]
+
+    for r, c in targets:
