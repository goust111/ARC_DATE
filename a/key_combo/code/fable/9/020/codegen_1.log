   8: def main(grid: np.ndarray) -> np.ndarray:
   9:     """
  10:     Complete each 3-cell foreground L by coloring its missing 2x2 corner blue.
  11: 
  12:     Input structure:
  13:     - The grid has one dominant background color and one foreground color.
  14:     - Each 4-connected foreground object has exactly three pixels inside a 2x2
  15:       bounding box, forming an L shape.
  16: 
  17:     Rule:
  18:     - For every foreground L object, find the one background pixel in its 2x2
  19:       bounding box.
  20:     - Paint that missing corner blue while preserving all original pixels.
  21: 
  22:     Key insight:
  23:     - The teal objects are incomplete 2x2 squares; the only changed cells are
  24:       the absent corners of those local 2x2 regions.
  25:     """
  26:     g = np.asarray(grid, dtype=int)
  27:     bg = int(get_bg(g))
  28:     fg_colors = colors_present(g, exclude={bg})
  29:     assert len(fg_colors) == 1, "expected exactly one foreground color"
  30: 
  31:     out = g.copy()
  32:     components = components_mask(g == int(fg_colors[0]), connectivity=4)
  33:     assert components, "expected at least one foreground L object"
  34: 
  35:     for coords in components:
  36:         assert coords.shape[0] == 3, "each object must have three pixels"
  37:         box = bbox_coords(coords)
  38:         assert bbox_h(box) == 2 and bbox_w(box) == 2, "each object must fit a 2x2 box"
  39: 
  40:         r0, c0, r1, c1 = box
  41:         present = {(int(r), int(c)) for r, c in coords}
  42:         box_cells = {(r, c) for r in range(r0, r1 + 1) for c in range(c0, c1 + 1)}
  43:         missing = box_cells - present
  44:         assert len(missing) == 1, "each 2x2 box must have exactly one missing corner"
  45: 
  46:         r, c = next(iter(missing))
  47:         assert g[r, c] == bg, "missing corner must be background"
  48:         out[r, c] = int(Color.BLUE)
  49: 
  50:     return out
