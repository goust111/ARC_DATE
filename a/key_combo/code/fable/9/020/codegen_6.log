+
+import numpy as np
+
+
+BACKGROUND = 0
+ORIENTATIONS = ("up", "down", "left", "right")
+DIR_FROM_ORIENTATION = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
