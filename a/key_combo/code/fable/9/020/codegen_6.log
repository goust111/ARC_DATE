+    "right": [((2, 2), (3, 2)), ((2, 2), (4, 2)), ((3, 2), (4, 2)), ((2, 3), (3, 3))],
+}
+GEN_RETRIES = 500
+PLACE_RETRIES = 300
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
