+def _segment_bounds(gap_indices: np.ndarray, n: int) -> list[tuple[int, int]]:
+    bounds = [-1, *map(int, gap_indices), int(n)]
+    segments: list[tuple[int, int]] = []
+    for left, right in zip(bounds, bounds[1:]):
+        start = left + 1
+        stop = right
+        if start < stop:
+            segments.append((start, stop))
+    return segments
