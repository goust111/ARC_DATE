+    if not np.array_equal(gap_cols, expected_gap_cols):
+        return False
+
+    for r0, r1, c0, c1 in copy_bounds:
+        if np.array_equal(grid[r0:r1, c0:c1], clean[r0:r1, c0:c1]):
+            return False
