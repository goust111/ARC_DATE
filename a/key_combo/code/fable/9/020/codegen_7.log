+    for r in range(grid_h):
+        if row_mod[r] == gap_r:
+            continue
+        tr = (r - gap_r - 1) % period_h
+        for c in range(grid_w):
+            if col_mod[c] == gap_c:
+                continue
+            tc = (c - gap_c - 1) % period_w
+            grid[r, c] = int(template[tr, tc])
+    return grid
