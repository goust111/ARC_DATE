+    votes: dict[tuple[int, int], Counter[int]] = {
+        (tr, tc): Counter() for tr in range(template.shape[0]) for tc in range(template.shape[1])
+    }
+    for r in range(grid.shape[0]):
+        if r % period_h == gap_r:
