+_RNG = np.random.default_rng()
+_BG = 0
+_PALETTE = tuple(range(10))
+_NON_BG = tuple(range(1, 10))
+_TEMPLATE_HW_RANGE = (3, 7)
+_FG_COLOR_COUNT_RANGE = (2, 4)
+_PERIOD_MULTIPLIER_RANGE = (3, 5)
+_MAX_GENERATION_ATTEMPTS = 400
