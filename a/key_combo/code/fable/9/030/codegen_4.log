+        for c in range(g.shape[1]):
+            color = int(g[r, c])
+            if color == BG:
+                continue
+            if color == marker_color and (r, c) not in exemplar_component:
+                markers.append((r, c))
+            else:
+                fixed_cells[(r, c)] = color
+
+    out, _pieces = _simulate_markers(g.shape, fixed_cells, offsets, markers)
+    return out
