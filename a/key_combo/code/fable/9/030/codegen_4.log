+        decorated = []
+        isolated = []
+        for r, c in coords:
+            neighbors = [
+                int(g[nr, nc])
+                for nr, nc in _neighbors8(r, c)
+                if _in_bounds(g.shape, nr, nc)
+            ]
+            if any(v not in (bg, color) for v in neighbors):
