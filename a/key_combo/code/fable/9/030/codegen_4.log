+    marker_color, exemplar_anchor, exemplar_component = _find_marker_info(g)
+    offsets = _piece_offsets(g, exemplar_anchor, exemplar_component)
+
+    fixed_cells: dict[tuple[int, int], int] = {}
+    markers: list[tuple[int, int]] = []
