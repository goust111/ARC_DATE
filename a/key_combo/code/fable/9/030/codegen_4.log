+    pairs = list(itertools.combinations(candidates, 2))
+    np.random.shuffle(pairs)
+    for a, b in pairs:
+        ar, ac = a["anchor"]
+        br, bc = b["anchor"]
+        if ar == br:
+            continue
+        if not (a["cols"] & b["cols"]):
+            continue
+        if a["cells"] & b["cells"]:
