+
+
+def _pick_platform_marker(
+    shape: tuple[int, int],
+    fixed_cells: dict[tuple[int, int], int],
+    offsets: list[tuple[int, int, int]],
+    candidates: list[dict[str, object]],
+    used_cells: set[tuple[int, int]],
+    floor_row: int,
