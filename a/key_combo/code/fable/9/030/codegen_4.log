+
+def _pick_core_pair(
+    shape: tuple[int, int],
+    fixed_cells: dict[tuple[int, int], int],
+    offsets: list[tuple[int, int, int]],
+    candidates: list[dict[str, object]],
+) -> list[tuple[int, int]] | None:
+    pairs = list(itertools.combinations(candidates, 2))
