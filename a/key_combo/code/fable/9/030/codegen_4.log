+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        inp = _gen_attempt(rng)
+        if inp is not None:
+            return inp
+    raise RuntimeError("failed to generate a valid stamp-drop stacking input")

