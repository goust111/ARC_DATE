+
+
+def _validate_generated(
+    inp: np.ndarray,
+    expected: np.ndarray,
+    marker_color: int,
+    exemplar_anchor: tuple[int, int],
+    offsets: list[tuple[int, int, int]],
+    markers: list[tuple[int, int]],
+    fixed_cells: dict[tuple[int, int], int],
+    require_platform: bool,
+) -> bool:
