+            c0 = int(rng.integers(0, w - length + 1))
+            cells = {(row, c) for c in range(c0, c0 + length)}
+            halo = {
+                (r, c)
+                for rr, cc in cells
+                for r in range(rr - 1, rr + 2)
+                for c in range(cc - 1, cc + 2)
+                if _in_bounds(grid.shape, r, c)
+            }
