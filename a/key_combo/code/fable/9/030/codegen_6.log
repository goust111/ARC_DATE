+    upper = min(capacity, max(modulus + 4, 2 * modulus))
+    choices = [n for n in range(1, upper + 1) if n % modulus != 0]
+    assert choices, "need a non-zero shift modulo the payload size"
+    return int(np.random.choice(choices))
