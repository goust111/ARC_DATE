+@dataclass(frozen=True)
+class Container:
+    color: int
+    r0: int
+    c0: int
+    r1: int
+    c1: int
+
+    @property
+    def opening_columns(self) -> list[int]:
+        return list(range(self.c0 + 1, self.c1))
