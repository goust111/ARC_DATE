+def _interval_from_focus(rng: np.random.Generator, column: int, width: int) -> tuple[int, int]:
+    start = column - int(rng.integers(0, 2))
+    end = column + int(rng.integers(1, 3))
+    start = max(0, start)
+    end = min(width - 1, end)
+    if end - start + 1 < 2:
