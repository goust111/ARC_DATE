+
+
+def _scene_oracle(
+    containers: list[Container],
+    obstacles: set[Coord],
+    fallers: list[Coord],
+) -> tuple[list[int], Grid]:
+    counts = _counts_from_scene(containers, obstacles, fallers)
+    return counts, _histogram(BACKGROUND, containers, counts)
+
+
+def _valid_scene(
+    grid: Grid,
+    containers: list[Container],
+    obstacles: set[Coord],
+    fallers: list[Coord],
+    true_counts: list[int],
+    raw_counts: list[int],
+    survivor_in_covered_column: bool,
+) -> bool:
+    try:
