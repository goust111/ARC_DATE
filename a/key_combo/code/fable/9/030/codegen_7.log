+    fallers, true_counts, raw_counts, survivor_in_covered_column = _place_fallers(
+        rng, containers, obstacles, focus_col
+    )
+    grid = _render_scene(
+        (height, width),
+        containers,
+        obstacles,
+        fallers,
+        int(obstacle_color),
+        int(faller_color),
+    )
+    if not _valid_scene(
+        grid,
+        containers,
+        obstacles,
+        fallers,
+        true_counts,
+        raw_counts,
+        survivor_in_covered_column,
+    ):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRY_LIMIT):
+        grid = _generate_once()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid histogram-from-falling-pixels scene")

