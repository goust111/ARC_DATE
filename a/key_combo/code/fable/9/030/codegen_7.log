+def _histogram(bg: int, containers: list[Container], counts: list[int]) -> Grid:
+    height = max(counts)
+    out = np.full((height, len(containers)), bg, dtype=int)
+    for c, (box, count) in enumerate(zip(containers, counts)):
+        if count:
