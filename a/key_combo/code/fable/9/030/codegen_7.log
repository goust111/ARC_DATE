+
+
+def _sample_obstacles(
+    rng: np.random.Generator,
+    shape: tuple[int, int],
+    containers: list[Container],
+) -> tuple[set[Coord], int, int]:
+    h, w = shape
+    min_r0 = min(box.r0 for box in containers)
