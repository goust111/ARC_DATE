+def _parse_scene(grid: Grid) -> tuple[int, list[Container], set[Coord], list[Coord]]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+    bg = _get_bg(g)
