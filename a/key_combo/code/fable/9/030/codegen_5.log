+def _outside_cells(spec: TubeSpec) -> list[tuple[int, int]]:
+    er, ec = _end_center(spec, spec.open_dir)
+    dr, dc = DIRS[spec.open_dir]
+    return [(er + dr * step, ec + dc * step) for step in range(1, spec.spill_space + 1)]
