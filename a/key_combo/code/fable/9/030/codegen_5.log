+
+def _cavity_cells(spec: TubeSpec, from_open: bool = True) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = _tube_bbox(spec)
+    if spec.open_dir == "up":
+        cells = [(r, c0 + 1) for r in range(r0 + 1, r1)]
+    elif spec.open_dir == "down":
