+
+DIRS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+OPPOSITE = {"up": "down", "down": "up", "left": "right", "right": "left"}
+PALETTE = list(range(10))
+GEN_ATTEMPTS = 400
