+def _tube_bbox(spec: TubeSpec) -> tuple[int, int, int, int]:
+    outer_h, outer_w = _spec_outer_shape(spec)
+    return spec.r0, spec.c0, spec.r0 + outer_h - 1, spec.c0 + outer_w - 1
