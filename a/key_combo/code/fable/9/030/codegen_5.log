+
+
+def _boxes_overlap(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:
+    return not (a[2] < b[0] or b[2] < a[0] or a[3] < b[1] or b[3] < a[1])
+
+
+def _random_spec(
+    shape: tuple[int, int],
+    open_dir: str,
+    branch: str,
+    wall_color: int,
