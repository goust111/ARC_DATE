+    left_fg = left_colors - {bg}
+    right_fg = right_colors - {bg}
+    assert bg != GREEN, "green is reserved for the output marker"
+    assert len(left_fg) == 1 and len(right_fg) == 1, "each panel must contain exactly one foreground color"
