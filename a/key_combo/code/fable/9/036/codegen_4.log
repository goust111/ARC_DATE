+    if len(lengths) == 2:
+        deltas = [abs((states[t][colors[0]][1] - states[t][colors[1]][1]) % 4) for t in range(panel_count + 1)]
+        if any(delta == 0 for delta in deltas):
+            return None
+        if {states[1][color][1] - states[0][color][1] for color in colors} == {0}:
+            return None
+
+    panels = [_render_panel(size, pivot, arms) for arms in states[:-1]]
+    output = _render_panel(size, pivot, states[-1])
+    grid = _assemble_input(panels)
+
+    try:
