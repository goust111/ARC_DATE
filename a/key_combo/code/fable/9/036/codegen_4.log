+    size = panels[0].shape[0]
+    full = np.full((size, len(panels) * size + len(panels) - 1), SEP, dtype=int)
+    for idx, panel in enumerate(panels):
+        start = idx * (size + 1)
+        full[:, start : start + size] = panel
+    return full
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
