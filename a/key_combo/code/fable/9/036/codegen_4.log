+
+def _no_global_step(states: list[dict[int, tuple[int, int]]]) -> bool:
+    first = states[0]
+    if len(first) < 2:
+        return True
+    colors = list(first)
+    steps = {
+        (_rotate_dir(first[color][1], delta) == states[1][color][1])
+        for delta in range(4)
+        for color in colors
+    }
+    return True if len(colors) == 1 else all(len({(states[1][c][1] - first[c][1]) % 4 for c in colors}) > 1 for _ in [0])
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    lengths = _choose_case(rng)
+    panel_count = _choose_panel_count(rng, lengths)
+    size = _choose_panel_size(rng, panel_count, max(lengths))
