    out = inp.T.copy()
    try:
        actual = main(inp)
    except Exception:
        return False
    return np.array_equal(actual, out)


def generate_input():
    for _ in range(GENERATION_RETRIES):
        inp = _gen_attempt()
        if inp is not None and _gen_passes_oracle(inp):
            return inp
    raise RuntimeError("failed to generate a valid 9dfd6313 input")

