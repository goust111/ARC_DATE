+
+
+def _validate_sample(grid: np.ndarray, expected: np.ndarray) -> bool:
+    try:
+        actual = main(grid)
+        parsed = _parse_grid(grid)
+        family = _find_family(parsed)
+    except Exception:
+        return False
+
+    if not np.array_equal(actual, expected):
