+        candidates.append(
+            {
+                "placeholder_color": int(placeholder_color),
+                "family_color": int(info_a["color"]),
+                "orbit": orbit,
+                "placeholders": [pos for pos in orbit if pos in placeholders],
+                "known": known,
+            }
