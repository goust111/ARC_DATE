+    return None
+
+
+def _build_slot_table(assignments: dict, n: int, slot_size: int, bg: int) -> np.ndarray:
+    extent = n * slot_size + n + 1
+    grid = np.full((extent, extent), bg, dtype=int)
+    for (sr, sc), spec in assignments.items():
