+
+def _neighbors4_in_size(size: int, r: int, c: int):
+    for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+        rr = r + dr
+        cc = c + dc
+        if 0 <= rr < size and 0 <= cc < size:
