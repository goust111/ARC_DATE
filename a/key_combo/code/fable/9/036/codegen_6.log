+
+
+def _touches_every_row_and_col(mask: np.ndarray) -> bool:
+    return bool(np.all(mask.any(axis=0)) and np.all(mask.any(axis=1)))
+
+
+def _random_connected_mask(size: int) -> np.ndarray | None:
