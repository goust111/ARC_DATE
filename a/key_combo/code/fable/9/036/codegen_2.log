+    chosen = random.sample(PALETTE, color_count)
+    colors = [chosen[i % color_count] for i in range(count)]
+    random.shuffle(colors)
+    if len(set(colors)) < 2:
+        colors[0] = chosen[0]
+        colors[-1] = chosen[1]
+    return colors
