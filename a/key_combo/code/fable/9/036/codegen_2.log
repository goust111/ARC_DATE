+    return {(r, c), (r + ORIENTATION_ARMS[orientation][0][0], c + ORIENTATION_ARMS[orientation][0][1]), (r + ORIENTATION_ARMS[orientation][1][0], c + ORIENTATION_ARMS[orientation][1][1])}
