spec:
  grid: 3 square HxH panels side-by-side separated by 2 solid vertical bar columns; H = 5-6
  input_size: H rows x (3H+2) cols
  output_size: H x H
  background: 7 [observed]
  separator: single-column solid bars of color 6, at columns H and 2H+1 [observed]
  panels: each panel contains exactly 3 monochromatic 4-connected objects on bg
  object_ordering: within each panel, objects are strictly left-to-right (bbox col ranges non-overlapping)
  object_size: 1-8 cells per object
  colors: |
    all objects use non-bg, non-separator colors (0-5, 8-9 observed)
    colors MAY repeat across panels or even within a panel
