0048:         r0, c0, r1, c1 = map(int, comp["bbox"])
0049:         height = int(r1 - r0 + 1)
0050:         width = int(c1 - c0 + 1)
0051:         assert int(comp["area"]) == height * width
0052: 
0053:         touches_top = r0 == 0
0054:         touches_bottom = r1 == H - 1
0055:         touches_left = c0 == 0
0056:         touches_right = c1 == W - 1
0057:         assert touches_top != touches_bottom
0058:         assert touches_left != touches_right
0059: 
0060:         dr = height if touches_top else -height
0061:         dc = width if touches_left else -width
0062:         shifted = coords + np.array([dr, dc], dtype=int)
