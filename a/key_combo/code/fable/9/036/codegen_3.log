0011: def main(grid: np.ndarray) -> np.ndarray:
0012:     """
0013:     Move the repeated boundary color's rectangles one block inward while leaving singleton boundary rectangles in place.
0014: 
0015:     Input structure:
0016:     - The background is the most common color.
0017:     - Foreground objects are solid monochrome rectangles touching a grid corner.
0018:     - Exactly one foreground color appears as multiple separate 4-connected objects; other colors appear once.
0019: 
0020:     Rule:
0021:     - Clear the multiple objects of the repeated color from their original positions.
0022:     - For each cleared rectangle, translate it away from the row and column border it touches by exactly its height and width.
0023:     - Keep singleton-color objects unchanged; overlapping translated rectangles of the same color merge.
0024: 
0025:     Key insight:
0026:     - Multiplicity selects the moving color, and each boundary rectangle's touched edges determine its inward diagonal translation.
0027:     """
0028:     g = np.asarray(grid, dtype=int)
0029:     H, W = g.shape
0030:     bg = int(get_bg(g))
0031: 
0032:     by_color: dict[int, list[dict]] = defaultdict(list)
0033:     for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict"):
0034:         by_color[int(comp["color"])].append(comp)
0035: 
0036:     moving_colors = [color for color, comps in by_color.items() if len(comps) > 1]
0037:     assert len(moving_colors) == 1
0038:     moving_color = int(moving_colors[0])
0039:     moving_objects = by_color[moving_color]
0040: 
0041:     out = g.copy()
0042:     for comp in moving_objects:
0043:         coords = comp["coords"]
