0007: def main(grid: np.ndarray) -> np.ndarray:
0008:     """
0009:     Rotate the red segment one quarter-turn clockwise around the grey marker, recoloring its original cells green.
0010: 
0011:     Input structure:
0012:     - The grid has a dominant background, exactly one grey marker, and one red
0013:       4-connected segment.
0014:     - The red segment is a straight horizontal or vertical bar attached to the
0015:       grey marker at exactly one end.
0016:     - The clockwise-rotated red segment fits on the same canvas.
0017: 
0018:     Rule:
0019:     - Locate the grey marker and the adjacent red cell, which gives the bar's
0020:       direction away from the marker.
0021:     - Recolor every input red cell green.
0022:     - Draw a red segment of the same length from the marker in the direction
0023:       obtained by rotating the original direction clockwise.
0024: 
0025:     Key insight:
0026:     - The grey marker is the pivot, and the side occupied by the red bar tells
0027:       which perpendicular side receives the new red bar.
0028:     """
0029:     g = np.asarray(grid, dtype=int)
0030:     bg = get_bg(g)
0031:     assert set(map(int, np.unique(g))) == {bg, Color.RED, Color.GREY}
0032: 
0033:     marker_coords = np.argwhere(g == Color.GREY)
0034:     assert marker_coords.shape == (1, 2)
0035:     pivot_r, pivot_c = map(int, marker_coords[0])
0036: 
0037:     red_components = find_components(
0038:         g, bg=bg, connectivity=4, monochromatic=True, colors=[Color.RED]
0039:     )
0040:     assert len(red_components) == 1
0041:     red_coords = red_components[0]["coords"]
0042:     red_set = {tuple(map(int, coord)) for coord in red_coords}
0043:     length = len(red_set)
0044: 
0045:     adjacent = [
0046:         (r, c)
0047:         for r, c in red_set
0048:         if abs(r - pivot_r) + abs(c - pivot_c) == 1
0049:     ]
0050:     assert len(adjacent) == 1
0051:     near_r, near_c = adjacent[0]
0052:     dr = near_r - pivot_r
0053:     dc = near_c - pivot_c
0054:     assert abs(dr) + abs(dc) == 1
0055: 
0056:     expected_source = {
0057:         (pivot_r + k * dr, pivot_c + k * dc)
0058:         for k in range(1, length + 1)
0059:     }
0060:     assert red_set == expected_source
0061: 
0062:     out = g.copy()
0063:     out[g == Color.RED] = Color.GREEN
0064: 
0065:     rotated_dr, rotated_dc = dc, -dr
0066:     H, W = g.shape
0067:     for k in range(1, length + 1):
0068:         r = pivot_r + k * rotated_dr
0069:         c = pivot_c + k * rotated_dc
