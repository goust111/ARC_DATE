+
+def get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.flat)).most_common(1)[0][0])
+
+
+def colors_present(grid: np.ndarray, *, exclude: set[int] | None = None) -> list[int]:
+    colors = set(map(int, grid.flat))
+    if exclude is not None:
+        colors -= set(exclude)
+    return sorted(colors)
+
+
+def in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def bbox_coords(coords: np.ndarray) -> BBox:
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    return int(rows.min()), int(cols.min()), int(rows.max()), int(cols.max())
+
+
+def find_components(
+    grid: np.ndarray,
+    *,
+    bg: int,
+    colors: list[int] | None = None,
+) -> list[dict]:
+    h, w = grid.shape
+    if colors is None:
+        colors = colors_present(grid, exclude={bg})
+    color_set = {int(c) for c in colors if int(c) != bg}
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if seen[r, c] or color == bg or color not in color_set:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[Coord] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in neighbors4(rr, cc):
+                    if (
+                        in_bounds(grid.shape, nr, nc)
+                        and not seen[nr, nc]
+                        and int(grid[nr, nc]) == color
+                    ):
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            arr = np.array(coords, dtype=int)
+            comps.append(
+                {
+                    "color": color,
+                    "coords": arr,
+                    "bbox": bbox_coords(arr),
+                    "area": int(arr.shape[0]),
+                }
+            )
+    return comps
+
+
+def rect_interior_mask(shape: tuple[int, int], rect: BBox) -> np.ndarray:
+    r0, c0, r1, c1 = rect
+    mask = np.zeros(shape, dtype=bool)
+    if r1 - r0 >= 2 and c1 - c0 >= 2:
+        mask[r0 + 1 : r1, c0 + 1 : c1] = True
+    return mask
+
+
+def rect_from_points(points: list[Coord]) -> BBox:
+    rows = [p[0] for p in points]
+    cols = [p[1] for p in points]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def bbox_contains(outer: BBox, inner: BBox) -> bool:
+    return (
+        outer[0] <= inner[0]
+        and outer[1] <= inner[1]
+        and outer[2] >= inner[2]
+        and outer[3] >= inner[3]
+    )
+
