  selection_rule: from panel k (0-indexed), take the k-th object in left-to-right order
  output: H x H bg canvas with the 3 selected objects stamped at their original panel-relative coords
  non_overlap: the 3 selected objects must occupy disjoint cells in the output

generation_strategy:
  approach: output-first
