+def sample_overlap_rects(h: int, w: int) -> list[BBox]:
+    for _ in range(300):
+        rh1 = random.randint(7, 10)
+        rw1 = random.randint(7, 10)
+        rh2 = random.randint(7, 10)
+        rw2 = random.randint(7, 10)
