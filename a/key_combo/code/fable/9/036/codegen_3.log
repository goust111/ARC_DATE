+    for _ in range(tries):
+        side = random.choice(["left", "right", "top", "bottom"])
+        inside_len = random.randint(1, 3)
+        outside_len = random.randint(1, 3)
+        if side in {"left", "right"}:
+            if r1 - r0 <= 2:
+                continue
+            anchor = random.randint(r0 + 1, r1 - 1)
+        else:
+            if c1 - c0 <= 2:
