+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+Coord = tuple[int, int]
+BBox = tuple[int, int, int, int]
+
+
+GENERATION_RETRIES = 400
+GENERATION_MODES = ("disjoint", "overlap", "nested")
+_GEN_COUNTER = 0
