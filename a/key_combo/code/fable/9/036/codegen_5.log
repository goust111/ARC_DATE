COL_RANGE_28BF18C6 = (0, CANVAS_SHAPE_28BF18C6[1] - SPRITE_SHAPE_28BF18C6[1])

# Sprite sampling and validation.
FOREGROUND_COUNTS_28BF18C6 = tuple(range(4, 7))
COLOR_RANGE_28BF18C6 = (1, 9)
OUTPUT_REPEATS_28BF18C6 = 2
