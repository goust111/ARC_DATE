+    start = next(iter(coords))
+    seen = {start}
+    queue = deque([start])
+    while queue:
+        r, c = queue.popleft()
+        for rr, cc in _neighbors4(r, c):
+            if (rr, cc) in coords and (rr, cc) not in seen:
+                seen.add((rr, cc))
+                queue.append((rr, cc))
+    return len(seen) == len(coords)
