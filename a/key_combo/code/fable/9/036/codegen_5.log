+def _axis_scores(points: list[tuple[int, int]], width: int) -> dict[int, int]:
+    pts = {(int(r), int(c)) for r, c in points}
+    scores: dict[int, int] = {}
+    for k in range(2 * (width - 1) + 1):
+        score = 0
+        for r, c in pts:
+            cc = k - c
+            if 0 <= cc < width and (r, cc) in pts:
