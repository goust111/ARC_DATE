+        zeros = sorted(color for color in remaining if indegree[color] == 0)
+        assert len(zeros) == 1, "expected a unique occlusion order"
+        current = zeros[0]
+        order.append(int(current))
+        remaining.remove(current)
+        for nxt in outgoing[current]:
+            indegree[nxt] -= 1
+    return order
