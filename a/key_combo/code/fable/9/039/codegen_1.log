  "transform": "select the unique smallest object whose pixels exactly fill its bbox and output a solid rectangle of that object's color",
  "grid_shape": "selected rectangle height x width"
}
</annotation>
<generation_spec>
```yaml
spec:
  grid: 10-20 rows x 10-20 cols
  background: 0 (black), must be unique most-common color on boundary
  objects: 2-5 monochrome 4-connected components, each a distinct non-bg color
  target_rectangle:
    description: unique smallest solid filled rectangle among all objects
    dimensions: 2-3 rows x 2-4 cols, area 4-12
    must not touch grid boundary [observed]
    pixels are purely its own color (no occlusion by other objects)
  distractor_rectangles:
    count: 0-2 additional solid filled rectangles
    area >= 2x target area (ratio 2.0-7.0)
    may touch boundary
  non_rectangles:
    count: 0-2 irregular shapes (bbox fill ratio 0.67-0.97)
    larger than target; bbox may overlap target bbox but pixels never occlude it
  output: solid grid of target rectangle dimensions filled with its color

generation_strategy:
  approach: direct construction
  steps:
    1. Pick grid dims 10-20 x 10-20
    2. Choose 2-5 distinct non-zero colors
    3. Place the target solid rectangle (2-3 x 2-4, area 4-12) away from boundary
    4. Place 0-2 larger solid rectangles (each >= 2x target area), no pixel overlap with target
    5. Place 0-2 non-rectangles by generating a filled rectangle then randomly removing 5-35% of pixels (keeping 4-connected), no pixel overlap with target
    6. Ensure bboxes may overlap but actual pixels never collide
    7. Verify target is uniquely smallest filled rectangle
```
