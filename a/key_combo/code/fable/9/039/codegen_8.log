+def _make_patch(axis: str, max_cross: int, palette: list[int], require_asymmetry: bool) -> np.ndarray | None:
+    cross_cap = min(4, int(max_cross))
+    if cross_cap < 2:
+        return None
+
+    for _ in range(80):
+        if axis == "vertical":
+            h = random.randint(*GEN_OBJECT_SIZE_RANGE)
+            w = random.randint(2, cross_cap)
+        else:
