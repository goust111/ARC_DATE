    max_openings = min(_GEN_OPENINGS_RANGE[1], 2 ** min(target_depth, _GEN_DEPTH_BRANCH_CAP) - 1)
    target_openings = random.randint(_GEN_OPENINGS_RANGE[0], max_openings)

