+    while len(selected) < area:
+        if not frontier:
+            frontier = set(selected)
+        r, c = random.choice(tuple(frontier))
+        nbrs = []
+        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+            rr = r + dr
+            cc = c + dc
+            if 0 <= rr < h and 0 <= cc < w and (rr, cc) not in selected:
+                nbrs.append((rr, cc))
+        if not nbrs:
+            frontier.discard((r, c))
+            continue
+        cell = random.choice(nbrs)
+        selected.add(cell)
+        frontier.add(cell)
+
+    for r, c in selected:
+        mask[r, c] = True
+    return mask
