+def _paint_full_cascade(out: np.ndarray, src: np.ndarray, coords: np.ndarray, spec: MirrorSpec) -> None:
+    axis, lo, hi, _mirror = spec
+    H, W = out.shape
+    span = hi - lo
+    limit = max(H, W) + 2
+
+    if axis == "vertical":
+        for r_raw, c_raw in coords:
+            r = int(r_raw)
+            c = int(c_raw)
+            color = int(src[r, c])
+            for k in range(-limit, limit + 1):
+                cc = c + 2 * k * span
+                if 0 <= cc < W:
+                    out[r, cc] = color
+                cc = 2 * lo - c + 2 * k * span
+                if 0 <= cc < W:
+                    out[r, cc] = color
+    else:
+        for r_raw, c_raw in coords:
+            r = int(r_raw)
+            c = int(c_raw)
+            color = int(src[r, c])
+            for k in range(-limit, limit + 1):
+                rr = r + 2 * k * span
+                if 0 <= rr < H:
+                    out[rr, c] = color
+                rr = 2 * lo - r + 2 * k * span
+                if 0 <= rr < H:
+                    out[rr, c] = color
+
