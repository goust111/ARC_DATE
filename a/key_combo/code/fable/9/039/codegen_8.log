+        patch = _make_patch(axis, corridor_cross, palette, require_asymmetry=True)
+        if patch is None:
+            return None
+        corridor_patches.append(patch)
+
+    outside_patches: list[np.ndarray] = []
+    for _ in range(outside_count):
