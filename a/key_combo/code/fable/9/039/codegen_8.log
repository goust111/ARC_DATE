+
+def _validate_scene(grid: np.ndarray) -> bool:
+    bg = int(get_bg(grid))
+    spec = _find_parallel_mirrors(grid, bg)
+    axis, lo, hi, _mirror = spec
+    line_mask = _mirror_line_mask(grid.shape, spec)
