+    extras = _rand_comp(length - need, len(sizes) + 1)
+    starts: list[int] = []
+    cursor = extras[0]
+    for idx, size in enumerate(sizes):
+        starts.append(cursor)
+        cursor += size
+        if idx + 1 < len(sizes):
+            cursor += min_gap + extras[idx + 1]
+    return starts
