+                cc = c + 2 * k * span
+                if 0 <= cc < W:
+                    out[r, cc] = color
+                cc = 2 * lo - c + 2 * k * span
+                if 0 <= cc < W:
+                    out[r, cc] = color
+    else:
+        for r_raw, c_raw in coords:
+            r = int(r_raw)
+            c = int(c_raw)
+            color = int(src[r, c])
+            for k in range(-limit, limit + 1):
+                rr = r + 2 * k * span
+                if 0 <= rr < H:
+                    out[rr, c] = color
+                rr = 2 * lo - r + 2 * k * span
+                if 0 <= rr < H:
+                    out[rr, c] = color
