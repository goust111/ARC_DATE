+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _build_scene()
+        if grid is not None and _validate_scene(grid):
+            return grid
+    raise RuntimeError("failed to generate a valid double-mirror corridor puzzle")

