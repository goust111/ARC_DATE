+def _mirror_line_mask(shape: tuple[int, int], spec: MirrorSpec) -> np.ndarray:
+    axis, lo, hi, _color = spec
+    mask = np.zeros(shape, dtype=bool)
+    if axis == "vertical":
+        mask[:, lo] = True
+        mask[:, hi] = True
+    else:
+        mask[lo, :] = True
+        mask[hi, :] = True
+    return mask
