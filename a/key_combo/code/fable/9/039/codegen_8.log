+def _build_scene() -> np.ndarray | None:
+    axis = random.choice(GEN_AXIS_CHOICES)
+    bg = random.choice([Color.BLACK, Color.ORANGE, Color.YELLOW, Color.TEAL])
+    if bg == Color.GREY:
