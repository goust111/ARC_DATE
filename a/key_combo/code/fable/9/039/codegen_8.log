    if not (_GEN_SEGMENT_COUNT_RANGE[0] <= segment_count <= _GEN_SEGMENT_COUNT_RANGE[1]):
        return None
    if not (_GEN_DEPTH_RANGE[0] <= max_depth <= _GEN_DEPTH_RANGE[1]):
