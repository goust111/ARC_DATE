+    bg = int(get_bg(g))
+    spec = _find_parallel_mirrors(g, bg)
+    corridor = _corridor_components(g, spec, bg)
+
+    out = g.copy()
+    for coords in corridor:
+        _paint_full_cascade(out, g, coords, spec)
+    return out
