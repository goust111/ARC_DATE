+    allowed = {bg, WALL, int(code[0])}
+    assert set(map(int, np.unique(lower))).issubset(allowed)
+    assert int(np.sum(lower == int(code[0]))) == 1
+    return g, bg, sep_r, code, (seed_r, seed_c)
