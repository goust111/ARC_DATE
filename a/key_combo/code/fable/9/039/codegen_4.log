+    extra_count = rng.randint(1, 3)
+    for _ in range(extra_count):
+        patch = _extra_wall_patch(rng, main_h, w)
+        placed = False
+        for _ in range(30):
+            r0 = rng.randint(1, main_h - patch.shape[0] - 1)
+            c0 = rng.randint(1, w - patch.shape[1] - 1)
