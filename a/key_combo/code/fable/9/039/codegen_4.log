+        if patch_h >= 4 and patch_w >= 4:
+            patch[1:-1, 1:-1] = 0
+    return patch
+
+
+def _can_paste(canvas: np.ndarray, patch: np.ndarray, r0: int, c0: int, protected: set[tuple[int, int]]) -> bool:
+    h, w = canvas.shape
+    ph, pw = patch.shape
+    if r0 < 0 or c0 < 0 or r0 + ph > h or c0 + pw > w:
+        return False
+    for pr in range(ph):
