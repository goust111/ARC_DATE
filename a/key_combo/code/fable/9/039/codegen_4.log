+def _chebyshev_fill(grid: np.ndarray, sep_r: int, code: np.ndarray, seed: tuple[int, int]) -> np.ndarray:
+    out = grid.copy()
+    sr, sc = seed
+    h, w = grid.shape
+    for r in range(sep_r + 1, h):
+        for c in range(w):
