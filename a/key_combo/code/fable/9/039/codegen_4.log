+    order = sorted(((int(dist[r, c]), int(r), int(c)) for r, c in coords))
+    ways = np.zeros(dist.shape, dtype=int)
+    ways[coords[0][0], coords[0][1]] = 1
+    for d, r, c in order:
+        if d == 0:
+            ways[r, c] = 1
