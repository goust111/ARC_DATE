+
+def _distance_map(grid: np.ndarray, sep_r: int, seed: tuple[int, int]) -> np.ndarray:
+    h, w = grid.shape
+    dist = np.full((h, w), -1, dtype=int)
+    q = deque([seed])
+    dist[seed] = 0
+    while q:
