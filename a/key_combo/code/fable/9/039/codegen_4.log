+        patch[:, cc] = WALL
+    elif style == "elbow":
+        rr = rng.randrange(1, patch_h)
+        cc = rng.randrange(1, patch_w)
+        patch[rr, : cc + 1] = WALL
+        patch[: rr + 1, cc] = WALL
