+        width = random.randint(1, min(2, w))
+        start = random.randint(0, w - width)
+        height = random.randint(1, extra_rows)
+        out[extra_rows - height : extra_rows, start : start + width] = True
+    return out
+
+
+def _make_sprite_mask(holes: int) -> np.ndarray:
