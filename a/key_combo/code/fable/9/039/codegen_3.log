+BG = 0
+NORMAL_BAR = 5
+HARD_BAR = 9
+SPRITE_COLORS = [1, 2, 3, 4, 6, 7, 8]
+GEN_ATTEMPTS = 400
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.flatten())).most_common(1)[0][0])
+
