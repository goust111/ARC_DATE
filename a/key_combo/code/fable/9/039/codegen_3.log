+
+def _place_rows(top: int, sprite_h: int, bar_count: int, H: int) -> list[int] | None:
+    if bar_count == 0:
+        return []
+    rows = []
+    row = top + sprite_h + random.randint(2, 4)
+    rows.append(row)
+    for _ in range(1, bar_count):
+        row += random.randint(3, 5)
+        rows.append(row)
+    if rows[-1] > H - 3:
+        return None
+    return rows
