+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BG = 0
+NORMAL_BAR = 5
+HARD_BAR = 9
+SPRITE_COLORS = [1, 2, 3, 4, 6, 7, 8]
+GEN_ATTEMPTS = 400
