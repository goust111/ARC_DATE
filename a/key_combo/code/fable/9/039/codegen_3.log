+        for r, c in coords:
+            submask[r - r0, c - c0] = True
+        sprites.append(
+            {
+                "color": colors.pop(),
+                "coords": coords,
+                "bbox": (r0, c0, r1, c1),
+                "mask": submask,
+                "holes": _hole_count(submask),
