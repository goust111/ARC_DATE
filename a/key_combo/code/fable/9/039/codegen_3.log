+def _simulate_from_records(grid: np.ndarray, sprites: list[dict], bars: list[dict], bg: int) -> np.ndarray:
+    out = np.asarray(grid, dtype=int).copy()
+    for sprite in sprites:
+        out[sprite["coords"][:, 0], sprite["coords"][:, 1]] = bg
