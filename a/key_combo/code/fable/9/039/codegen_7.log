+
+    top_split = h // 2
+    left_split = w // 2
+    zones = {
+        "A": (1, top_split - 1, 1, left_split - 1),
+        "B": (1, top_split - 1, left_split + 1, w - 2),
+        "C": (top_split + 1, h - 2, 1, left_split - 1),
+        "E": (top_split + 1, h - 2, left_split + 1, w - 2),
+    }
+
+    try:
