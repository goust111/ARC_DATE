+def _bbox_border_cells(bbox: BBox) -> list[Coord]:
+    r0, c0, r1, c1 = bbox
+    cells: list[Coord] = []
+    for c in range(c0, c1 + 1):
+        cells.append((r0, c))
+        if r1 != r0:
+            cells.append((r1, c))
+    for r in range(r0 + 1, r1):
