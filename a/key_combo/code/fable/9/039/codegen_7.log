spec:
  grid: 10-20 rows x 10-20 cols
  background: 0 (black), must be unique most-common color on boundary
  objects: 2-5 monochrome 4-connected components, each a distinct non-bg color
  target_rectangle:
    description: unique smallest solid filled rectangle among all objects
    dimensions: 2-3 rows x 2-4 cols, area 4-12
    must not touch grid boundary [observed]
    pixels are purely its own color (no occlusion by other objects)
  distractor_rectangles:
    count: 0-2 additional solid filled rectangles
    area >= 2x target area (ratio 2.0-7.0)
    may touch boundary
  non_rectangles:
    count: 0-2 irregular shapes (bbox fill ratio 0.67-0.97)
    larger than target; bbox may overlap target bbox but pixels never occlude it
