+        pair = PairSpec(color=color, r0=r0, c0=c0, h=rect_h, w=rect_w, marker=marker)
+        _, stats = _project_mask(shape, pair)
+        if len(stats["offsets"]) < 2:
+            continue
+        if mode != "equal" and len(stats["offsets"]) < 3:
+            continue
