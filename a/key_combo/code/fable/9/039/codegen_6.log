0010: def main(grid: np.ndarray) -> np.ndarray:
0011:     """
0012:     Extend each colored marker through its full row and column, marking crossings between different markers red.
0013: 
0014:     Input structure:
0015:     - The grid has a dominant background color and two or more isolated non-background marker pixels.
0016:     - Marker pixels have distinct rows, distinct columns, and distinct non-red colors.
0017: 
0018:     Rule:
0019:     - For each marker, paint its entire row and entire column with the marker color.
0020:     - Where the row or column from one marker crosses the row or column from another marker, paint red.
0021:     - Preserve the original marker pixels in their own colors.
0022: 
0023:     Key insight:
0024:     - The sparse marker pixels are anchors for full-grid horizontal and vertical guide lines; only cross-marker intersections get the special red color.
0025:     """
0026:     g = np.asarray(grid, dtype=int)
0027:     assert g.ndim == 2, "expected a 2D grid"
0028: 
0029:     bg = int(get_bg(g))
0030:     bg_count = int(np.count_nonzero(g == bg))
0031:     assert bg_count > g.size // 2, "expected a dominant background"
0032: 
0033:     coords = np.argwhere(g != bg)
0034:     markers = [(int(r), int(c), int(g[r, c])) for r, c in coords]
0035:     assert len(markers) >= 2, "expected at least two markers"
