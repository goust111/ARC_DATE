+    seen_equal = False
+    seen_row = False
+    seen_col = False
+    clipped_total = 0
+    for pair in pairs:
+        _, stats = _project_mask(grid.shape, pair)
+        d = stats["d"]
+        a = stats["a"]
+        clipped_total += int(stats["clipped"])
