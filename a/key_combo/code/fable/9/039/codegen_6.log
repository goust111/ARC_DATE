+    return None
+
+
+def _input_mask(pair: PairSpec, shape: tuple[int, int]) -> np.ndarray:
+    mask = np.zeros(shape, dtype=bool)
+    mask[pair.r0 : pair.r0 + pair.h, pair.c0 : pair.c0 + pair.w] = True
+    mask[pair.marker] = True
+    return mask
+
