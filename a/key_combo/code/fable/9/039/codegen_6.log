0020: def main(grid: np.ndarray) -> np.ndarray:
0021:     """
0022:     Extract the unique smallest solid monochrome rectangle as the entire output grid.
0023: 
0024:     Input structure
0025:     - The empty canvas color is the unique most common color on the grid boundary.
0026:     - Non-background pixels form one or more 4-connected monochrome objects.
0027:     - At least one non-background object is a filled axis-aligned rectangle.
0028: 
0029:     Rule
0030:     - Find every monochrome non-background object whose pixels exactly fill its bounding box.
0031:     - Select the unique filled rectangle with the smallest area.
0032:     - Return a solid grid with the selected rectangle's height, width, and color.
0033: 
0034:     Key insight
0035:     - Other objects are distractor rectangles or partial rectangles; the output is the
0036:       smallest complete rectangular object, detached from its original position.
0037:     """
0038:     g = np.asarray(grid, dtype=int)
0039:     assert g.ndim == 2, "expected a 2D grid"
0040:     assert min(g.shape) > 0, "expected a nonempty grid"
0041: 
0042:     bg = _boundary_background(g)
0043:     objects = find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict")
0044:     assert objects, "expected at least one non-background object"
0045: 
0046:     rectangles = []
0047:     for obj in objects:
0048:         box = obj["bbox"]
0049:         height = bbox_h(box)
0050:         width = bbox_w(box)
0051:         if int(obj["area"]) == height * width:
0052:             rectangles.append((int(obj["area"]), int(obj["color"]), height, width))
0053: 
0054:     assert rectangles, "expected at least one filled rectangle"
0055:     min_area = min(area for area, _color, _height, _width in rectangles)
0056:     smallest = [rect for rect in rectangles if rect[0] == min_area]
0057:     assert len(smallest) == 1, "expected a unique smallest filled rectangle"
0058: 
0059:     _area, color, height, width = smallest[0]
0060:     return np.full((height, width), color, dtype=int)
