0041:     assert len(set(cols)) == len(cols), "marker columns must be unique"
0042:     assert len(set(colors)) == len(colors), "marker colors must be unique"
0043:     assert Color.RED not in colors, "red is reserved for crossings"
0044:     marker_positions = {(r, c) for r, c, _color in markers}
0045: 
