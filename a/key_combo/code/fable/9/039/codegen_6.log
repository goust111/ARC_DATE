0045:     marker_colors = colors_present(g, exclude={bg})
0046:     assert len(marker_colors) == 1
0047: 
0048:     marker_color = marker_colors[0]
0049:     marker_coords = coords_where(g == marker_color)
0050:     assert marker_coords.shape == (2, 2)
0051:     p = tuple(map(int, marker_coords[0]))
0052:     q = tuple(map(int, marker_coords[1]))
