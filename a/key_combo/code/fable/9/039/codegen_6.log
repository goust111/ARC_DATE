+            r_src0 = max(0, -dr)
+            r_src1 = min(mask_a.shape[0], mask_a.shape[0] - dr)
+            c_src0 = max(0, -dc)
+            c_src1 = min(mask_a.shape[1], mask_a.shape[1] - dc)
+            shifted[r_src0 + dr : r_src1 + dr, c_src0 + dc : c_src1 + dc] = mask_a[r_src0:r_src1, c_src0:c_src1]
+            if np.any(shifted & mask_b):
