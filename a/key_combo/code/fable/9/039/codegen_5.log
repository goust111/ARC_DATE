+    expected_out = main(grid)
+    if len(trace_cells) < 10:
+        return None
+
+    grid = _add_distractors(grid, expected_out)
+    if not _valid_instance(grid, require_both_turns):
+        return None
+    if not np.array_equal(main(grid), expected_out):
+        return None
+    return grid
