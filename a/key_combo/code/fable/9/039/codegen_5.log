+    if any(length < MIN_SEGMENT_LEN for length in segment_lengths):
+        return False
+    if len(set(hit_blocks)) != len(hit_blocks):
+        return False
+    if len(set(tuple(cell) for cell in meta["path_cells"])) != len(meta["path_cells"]):
