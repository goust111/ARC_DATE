+        cells.append((r, c))
+
+
+def _prism_cells(bounce: tuple[int, int], incoming_dir: int, align: int) -> list[tuple[int, int]]:
+    r, c = bounce
+    if incoming_dir == 0:
+        top, left = r - 2, c + align
+    elif incoming_dir == 1:
