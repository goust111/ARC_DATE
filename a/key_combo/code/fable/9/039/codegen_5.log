    markers = _gen_markers(size, marker_count)
    grid = np.zeros((size, size), dtype=int)
    for r, c, color in markers:
        grid[r, c] = color

    expected = _gen_expected_output(size, markers)
    if not np.array_equal(main(grid), expected):
        return None
    return grid


