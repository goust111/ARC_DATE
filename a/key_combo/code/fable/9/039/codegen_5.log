+            turn_senses.append(CW if prism_color == TEAL else CCW)
+            hit_blocks.append(prism_id_by_cell[(nr, nc)])
+            segment_lengths.append(steps_in_segment)
+            dir_idx = _turn(dir_idx, prism_color)
+            trail_color = prism_color
