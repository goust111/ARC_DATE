+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+RED = 2
+ORANGE = 7
+TEAL = 8
+PRISM_COLORS = {ORANGE, TEAL}
+
+DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]  # up, right, down, left
+CW = 1
+CCW = -1
+
+GRID_H_RANGE = (12, 22)
+GRID_W_RANGE = (12, 22)
+TURN_COUNT_RANGE = (2, 6)
+MAX_GENERATION_ATTEMPTS = 400
+MIN_SEGMENT_LEN = 2
+MIN_FINAL_SEGMENT_LEN = 2
+MAX_DISTRACTORS = 3
