+def reflect_cells(
+    cells: set[tuple[int, int]], axis: tuple[str, int | None], shape: tuple[int, int]
+) -> set[tuple[int, int]] | None:
+    h, w = shape
+    kind, value = axis
+    out: set[tuple[int, int]] = set()
+    for r, c in cells:
+        if kind == "row":
+            rr, cc = 2 * int(value) - r, c
+        elif kind == "col":
+            rr, cc = r, 2 * int(value) - c
+        elif kind == "main_diag":
+            if h != w:
+                return None
+            rr, cc = c, r
+        elif kind == "anti_diag":
+            if h != w:
