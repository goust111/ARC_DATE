+    return None
+
+
+def expected_from_layout(
+    n: int,
+    bg: int,
+    objects: list[dict],
+    sprite_colors: tuple[int, int],
+    ghost_ids: tuple[int, int],
+    small_ids: list[int],
+) -> np.ndarray:
+    out = render_grid(n, bg, objects)
+    for ghost_idx, color in zip(ghost_ids, sprite_colors):
+        for r, c in objects[ghost_idx]["cells"]:
+            out[r, c] = color
