+
+
+def random_connected_shape(area_lo: int, area_hi: int, max_dim: int) -> tuple[tuple[int, int], ...]:
+    for _ in range(200):
+        target = random.randint(area_lo, area_hi)
+        cells = {(0, 0)}
+        while len(cells) < target:
+            frontier = []
+            for r, c in cells:
