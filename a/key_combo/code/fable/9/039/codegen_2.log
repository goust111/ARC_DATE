+
+def assignment_cost(a: set[tuple[int, int]], b: set[tuple[int, int]]) -> float:
+    ar0, ac0, ar1, ac1 = bbox(a)
+    br0, bc0, br1, bc1 = bbox(b)
+    ac = ((ar0 + ar1) / 2.0, (ac0 + ac1) / 2.0)
+    bc = ((br0 + br1) / 2.0, (bc0 + bc1) / 2.0)
+    return (ac[0] - bc[0]) ** 2 + (ac[1] - bc[1]) ** 2
