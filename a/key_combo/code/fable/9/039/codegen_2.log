+        rs = [r for r, _ in norm]
+        cs = [c for _, c in norm]
+        if max(rs) + 1 > max_dim or max(cs) + 1 > max_dim:
+            continue
+        return norm
+    raise RuntimeError("failed to sample connected shape")
