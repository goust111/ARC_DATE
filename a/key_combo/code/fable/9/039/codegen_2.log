+def reflected_shape_variants(norm: tuple[tuple[int, int], ...]) -> set[tuple[tuple[int, int], ...]]:
+    cells = set(norm)
+    _, _, r1, c1 = bbox(cells)
+    h, w = r1 + 1, c1 + 1
