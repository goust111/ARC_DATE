+    if summary["wall_count"] == 0 or not summary["detour"]:
+        return False
+    if np.array_equal(out, _manhattan_shortcut_output(grid)):
+        return False
+    if kind == "pocket" and summary["unreachable_black_count"] == 0:
+        return False
+    return True
