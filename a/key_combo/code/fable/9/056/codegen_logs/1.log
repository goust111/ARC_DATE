def _source_candidates(main_region: np.ndarray, info: dict[str, int | str] | None) -> list[tuple[int, int]]:
    h, w = main_region.shape
    if info is None:
        return [(r, c) for r in range(h) for c in range(w) if int(main_region[r, c]) == BLACK]

