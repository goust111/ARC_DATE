+def _parse_grid(grid: np.ndarray) -> tuple[list[int], int, np.ndarray, tuple[int, int], int]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    h, w = g.shape
+    assert 4 <= h <= 30 and 4 <= w <= 30
