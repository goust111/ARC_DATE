+    out = np.asarray(grid, dtype=int).copy()
+    k = len(legend)
+    for r, c in np.argwhere((main_region == BLACK) & (dist > 0)):
+        out[r + 2, c] = legend[(int(dist[r, c]) - 1) % k]
+    return out
