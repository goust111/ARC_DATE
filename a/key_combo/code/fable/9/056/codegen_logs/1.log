+def _parse_grid(grid: np.ndarray) -> tuple[list[int], int, np.ndarray, tuple[int, int], int]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    h, w = g.shape
+    assert 4 <= h <= 30 and 4 <= w <= 30
+
+    separator = int(g[1, 0])
+    assert np.all(g[1, :] == separator), "second row must be a full separator line"
