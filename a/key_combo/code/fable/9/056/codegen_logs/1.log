+    main = g[2:, :]
+    sources = np.argwhere((main != BLACK) & (main != separator))
+    assert sources.shape == (1, 2), "main region must contain exactly one colored source pixel"
+    src = tuple(map(int, sources[0]))
+    return legend, separator, main, src, int(main[src])
