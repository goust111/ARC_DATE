        main_region[top, left : left + ring_w] = GREY
        main_region[top + ring_h - 1, left : left + ring_w] = GREY
        main_region[top : top + ring_h, left] = GREY
        main_region[top : top + ring_h, left + ring_w - 1] = GREY
        return True
    return False


