+    q: deque[tuple[int, int]] = deque([src])
+    dist[src] = 0
+    while q:
+        r, c = q.popleft()
+        step = dist[r, c] + 1
+        for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+            if not (0 <= nr < h and 0 <= nc < w):
+                continue
+            if dist[nr, nc] != -1 or int(main[nr, nc]) == wall_color:
