+    rows, cols = np.indices(main_region.shape)
+    manhattan = np.abs(rows - src[0]) + np.abs(cols - src[1])
+    reachable_black = (main_region == BLACK) & (dist > 0)
+    unreachable_black = (main_region == BLACK) & (dist < 0)
+    out = main(grid)
+
+    used_legend_colors = {
