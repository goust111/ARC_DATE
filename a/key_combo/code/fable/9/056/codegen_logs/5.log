+def _nonconsecutive_diag_touch(path: list[tuple[int, int]]) -> bool:
+    for i, a in enumerate(path):
+        for j in range(i + 1, len(path)):
+            if j == i + 1:
+                continue
+            b = path[j]
+            if max(abs(a[0] - b[0]), abs(a[1] - b[1])) == 1 and abs(a[0] - b[0]) == abs(a[1] - b[1]):
+                return True
+    return False
