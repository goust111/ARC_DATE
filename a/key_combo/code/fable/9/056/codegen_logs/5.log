+    if (dr, dc) == (1, 1):
+        r0, c0 = endpoint[0] + 1, endpoint[1] + 1
+    elif (dr, dc) == (1, -1):
+        r0, c0 = endpoint[0] + 1, endpoint[1] - size
+    elif (dr, dc) == (-1, 1):
+        r0, c0 = endpoint[0] - size, endpoint[1] + 1
+    else:
+        assert (dr, dc) == (-1, -1)
+        r0, c0 = endpoint[0] - size, endpoint[1] - size
