+
+
+def _wire_cells_from_scene(scene: list[dict]) -> set[tuple[int, int]]:
+    cells: set[tuple[int, int]] = set()
+    for wire in scene:
+        for i, cell in enumerate(wire["path"]):
+            if wire["broken"] and i == wire["break_idx"]:
+                continue
+            cells.add(cell)
