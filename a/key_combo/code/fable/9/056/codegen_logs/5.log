+def _detect_boxes(grid: np.ndarray) -> list[dict]:
+    grey_mask = grid == GREY
+    boxes: list[dict] = []
+    for comp in _cardinal_components(grey_mask):
+        r0, c0, r1, c1 = _bbox(comp)
+        h = r1 - r0 + 1
+        w = c1 - c0 + 1
+        if h < 3 or w < 3:
+            continue
+        border, interior = _box_cells(r0, c0, h, w)
+        if set(comp) != border:
+            continue
+        if not interior:
+            continue
+        if any(int(grid[r, c]) != BLACK for r, c in interior):
+            continue
+        boxes.append(
+            {
+                "border": border,
+                "interior": interior,
+                "bbox": (r0, c0, r1, c1),
+            }
+        )
+    return boxes
