+    for wire in scene:
+        if wire["broken"]:
+            continue
+        color = wire["color"]
+        for cell in wire["path"]:
+            if cell not in crossings:
+                out[cell] = color
+        for r, c in wire["interior"]:
+            out[r, c] = color
+    return out
+
+
+def _crop_visible(
+    inp: np.ndarray,
+    out: np.ndarray,
+    rng: np.random.Generator,
+) -> tuple[np.ndarray, np.ndarray, int, int]:
