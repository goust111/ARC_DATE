+def _has_bend(path: list[tuple[int, int]]) -> bool:
+    if len(path) < 3:
+        return False
+    dirs = [(b[0] - a[0], b[1] - a[1]) for a, b in zip(path, path[1:])]
+    return any(d0 != d1 for d0, d1 in zip(dirs, dirs[1:]))
