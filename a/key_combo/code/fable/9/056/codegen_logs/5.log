+
+    all_reserved = set()
+    for wire in scene:
+        all_reserved |= set(wire["path"]) | wire["border"] | wire["interior"] | {wire["source"]}
+    if not all(_in_bounds((CANVAS_SIZE, CANVAS_SIZE), cell) for cell in all_reserved):
