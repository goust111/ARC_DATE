+
+BLACK = 0
+GREY = 5
+DIAGONALS = ((-1, -1), (-1, 1), (1, -1), (1, 1))
+CARDINALS = ((-1, 0), (1, 0), (0, -1), (0, 1))
+CANVAS_SIZE = 30
+GEN_ATTEMPTS = 400
