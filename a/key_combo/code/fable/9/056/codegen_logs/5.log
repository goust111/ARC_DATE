+def _crossing_cells(wire_cells: set[tuple[int, int]]) -> set[tuple[int, int]]:
+    out = set()
+    for r, c in wire_cells:
+        if (
+            (r - 1, c - 1) in wire_cells
+            and (r + 1, c + 1) in wire_cells
+            and (r - 1, c + 1) in wire_cells
+            and (r + 1, c - 1) in wire_cells
+        ):
+            out.add((r, c))
+    return out
+
