+
+    boxes = _detect_boxes(inp)
+    if len(boxes) != len(scene):
+        return False
+
+    source_cells = [tuple(map(int, cell)) for cell in np.argwhere((inp != BLACK) & (inp != GREY))]
+    if len(source_cells) != len(scene):
