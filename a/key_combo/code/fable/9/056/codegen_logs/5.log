+            {
+                **wire,
+                "path": [(r - row_off, c - col_off) for r, c in wire["path"]],
+                "source": (wire["source"][0] - row_off, wire["source"][1] - col_off),
+                "border": {(r - row_off, c - col_off) for r, c in wire["border"]},
+                "interior": {(r - row_off, c - col_off) for r, c in wire["interior"]},
+            }
+        )
