+            continue
+        first_dir = dirs[0]
+        last_dir = dirs[-1]
+        source = _add(path[0], first_dir, -1)
+        if not _in_bounds((CANVAS_SIZE, CANVAS_SIZE), source):
+            continue
+        size = int(rng.integers(3, 6))
+        border, interior = _box_from_endpoint(path[-1], last_dir, size)
