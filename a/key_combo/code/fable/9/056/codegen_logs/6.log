+        heights.append(band2_h)
+
+    grid = np.zeros((height, width), dtype=int)
+    grid[:, mirror_c] = RED
+
+    for idx in range(n_sliders):
+        left = input_right_edges[idx] - widths[idx] + 1
+        _paint_rect(grid, tops[idx], left, heights[idx], widths[idx], colors[idx])
