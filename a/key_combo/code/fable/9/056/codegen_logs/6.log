+def _find_slider_components(grid: np.ndarray, bg: int, mirror_c: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    blocked = {int(bg), RED, WALL}
+    components: list[dict] = []
+
+    for r0 in range(h):
+        for c0 in range(mirror_c):
+            color = int(grid[r0, c0])
+            if color in blocked or seen[r0, c0]:
+                continue
+            queue = deque([(r0, c0)])
+            seen[r0, c0] = True
+            cells: list[tuple[int, int]] = []
+            while queue:
+                r, c = queue.popleft()
+                cells.append((r, c))
+                for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+                    if not (0 <= nr < h and 0 <= nc < mirror_c):
+                        continue
+                    if seen[nr, nc] or int(grid[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    queue.append((nr, nc))
+
+            coords = np.asarray(cells, dtype=int)
+            bbox = (
+                int(coords[:, 0].min()),
+                int(coords[:, 1].min()),
+                int(coords[:, 0].max()),
+                int(coords[:, 1].max()),
+            )
+            components.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": bbox,
+                    "distance": int(mirror_c - 1 - coords[:, 1].max()),
+                }
+            )
