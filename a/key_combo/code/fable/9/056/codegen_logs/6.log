+    used_rows = set(range(band1_top, band1_top + band1_h)) | set(range(band2_top, band2_top + band2_h))
+    functional_wall_count = 2 if stop_a_with_wall else 1
+    extra_walls_needed = 0 if functional_wall_count >= 2 else 1
