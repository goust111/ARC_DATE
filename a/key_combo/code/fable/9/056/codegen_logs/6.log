+        return False
+
+    mirror_c = _mirror_column(grid)
+    colors_right = set(map(int, grid[:, mirror_c + 1 :].ravel()))
+    if any(color not in {BG, WALL} for color in colors_right):
+        return False
+
+    return True
+
