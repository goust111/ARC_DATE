+    wall_col_c = 2 * mirror_c - input_right_edges[2] - shift_c - 1
+    if wall_col_c <= mirror_c:
+        return None
+    _paint_wall_segment(grid, range(band2_top, band2_top + band2_h), wall_col_c)
