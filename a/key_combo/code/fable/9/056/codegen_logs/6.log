+        return False
+
+    has_wall_forced_gap = any(
+        item["right_kind"] == "wall" and item["shift"] < item["left_limit"]
+        for item in trace
+    )
+    if not has_wall_forced_gap:
+        return False
+
+    has_settled_blocker = any(
+        item["left_kind"] == "slider" or item["right_kind"] == "twin"
+        for item in trace
