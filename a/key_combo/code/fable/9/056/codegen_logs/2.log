+        rect = _rectangle_from_bbox(bbox, gaps, used=False)
+        _add_rectangle(state, rect)
+        state["future_red"].update(lead)
+        state["stop_reason"] = "wall"
+        return True
+    return False
+
+
+def _try_place_distractor(state: dict) -> bool:
+    h, w = state["shape"]
