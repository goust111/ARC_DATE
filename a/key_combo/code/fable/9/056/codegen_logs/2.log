+
+def _weighted_exit_dirs(in_dir: tuple[int, int], need_turn: bool) -> list[tuple[int, int]]:
+    dirs = list(DIRS)
+    random.shuffle(dirs)
+
+    def weight(out_dir: tuple[int, int]) -> int:
+        if out_dir == in_dir:
+            return 1 if need_turn else 2
+        if out_dir == OPPOSITE_DIR[in_dir]:
