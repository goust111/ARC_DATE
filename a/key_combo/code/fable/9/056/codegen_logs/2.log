+
+MIN_GRID = 18
+MAX_GRID = 30
+MIN_RECT_SIDE = 5
+MAX_RECT_SIDE = 9
+MAX_USED_RECTS = 4
+MAX_DISTRACTORS = 2
+GEN_ATTEMPTS = 500
