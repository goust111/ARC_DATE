+
+
+def _render_output(state: dict) -> np.ndarray:
+    out = _render_input(state)
+    for r, c in state["future_red"]:
+        out[r, c] = RED
+    return out
+
+
+def _meta_gap_map(rects: list[dict]) -> dict:
+    gap_map = {}
+    for idx, rect in enumerate(rects):
+        g1, g2 = rect["gaps"]
+        side1 = _gap_side(g1, rect["bbox"])
