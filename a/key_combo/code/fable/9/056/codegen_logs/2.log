+        side1 = _gap_side(g1, rect["bbox"])
+        side2 = _gap_side(g2, rect["bbox"])
+        gap_map[g1] = {"rect": idx, "other": g2, "exit_dir": SIDE_TO_DIR[side2]}
+        gap_map[g2] = {"rect": idx, "other": g1, "exit_dir": SIDE_TO_DIR[side1]}
+    return gap_map
