+from __future__ import annotations
+
+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BLACK = 0
+RED = 2
+GREEN = 3
+
+UP = (-1, 0)
+DOWN = (1, 0)
+LEFT = (0, -1)
+RIGHT = (0, 1)
+DIRS = (UP, DOWN, LEFT, RIGHT)
+
+DIR_TO_SIDE = {
+    UP: "top",
+    DOWN: "bottom",
+    LEFT: "left",
+    RIGHT: "right",
+}
+SIDE_TO_DIR = {
+    "top": UP,
+    "bottom": DOWN,
+    "left": LEFT,
+    "right": RIGHT,
+}
+OPPOSITE_DIR = {
+    UP: DOWN,
+    DOWN: UP,
+    LEFT: RIGHT,
+    RIGHT: LEFT,
+}
+
+MIN_GRID = 18
+MAX_GRID = 30
+MIN_RECT_SIDE = 5
+MAX_RECT_SIDE = 9
+MAX_USED_RECTS = 4
+MAX_DISTRACTORS = 2
