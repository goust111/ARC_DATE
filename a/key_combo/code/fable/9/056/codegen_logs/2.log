  "trajectory": "paint only the final position of each moved object, preserving its shape and color",
  "transform": "clear all original foreground pixels before placing the settled objects on the background",
  "multi_step": "settle objects in descending original right-edge order; use original bbox position to break ties"
}
</annotation>
<generation_spec>
```yaml
spec:
  grid: 6-10 rows x 6-13 cols, black background (0)
  objects:
    count: 5-10 monochromatic 4-connected components
    area: 1-5 cells each
    bbox: at most 2x3 (height x width)
    colors: 4-6 distinct non-black colors; duplicates allowed (same color can label separate components)
    density: 10-35% foreground cells
  placement:
    objects do not overlap; at most 2 objects share any single row [observed]
    objects generally occupy left/center portion of grid with free space to their right [observed]
  blocking:
    at least 2 object pairs share rows so that rightward sliding produces object-blocked stops (not just wall stops)
    every example has >=2 objects stopped by another object, and >=2 stopped by the right wall
  transform: slide every object rightward (preserving shape) until blocked by right wall or already-settled object; process right-to-left by original right-edge position

generation_strategy:
