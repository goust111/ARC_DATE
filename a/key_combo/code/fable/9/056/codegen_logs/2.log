+    return {(r, c) for r in range(r0, r1 + 1) for c in range(c0, c1 + 1)}
+
+
+def _gap_side(rc: tuple[int, int], bbox: tuple[int, int, int, int]) -> str:
+    r, c = rc
+    r0, c0, r1, c1 = bbox
+    if r == r0:
+        return "top"
+    if r == r1:
+        return "bottom"
+    if c == c0:
+        return "left"
+    if c == c1:
+        return "right"
+    raise AssertionError("gap must lie on the rectangle border")
+
+
+def _contact_bbox(
+    contact: tuple[int, int],
+    side: str,
+    height: int,
+    width: int,
+    offset: int,
+) -> tuple[int, int, int, int]:
+    r, c = contact
+    if side == "left":
+        r0 = r - offset
+        c0 = c
+    elif side == "right":
+        r0 = r - offset
+        c0 = c - width + 1
+    elif side == "top":
+        r0 = r
+        c0 = c - offset
+    else:
