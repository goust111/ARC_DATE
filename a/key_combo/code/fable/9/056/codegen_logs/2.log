+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BLACK = 0
+RED = 2
+GREEN = 3
+
+UP = (-1, 0)
+DOWN = (1, 0)
+LEFT = (0, -1)
+RIGHT = (0, 1)
+DIRS = (UP, DOWN, LEFT, RIGHT)
+
+DIR_TO_SIDE = {
+    UP: "top",
+    DOWN: "bottom",
+    LEFT: "left",
+    RIGHT: "right",
