+        col_shapes,
+        occupied,
+        imp_r,
+        imp_c,
+        wrong_attr,
+        fake_row,
+        fake_col,
+    )
+    if not _semantic_check(inp, out, row_colors, col_shapes, imp_r, imp_c, wrong_attr, fake_row, fake_col):
+        return None
+    if np.array_equal(inp, out):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
