+    imp_c = int(rng.integers(0, n_cols))
+    wrong_attr = "color" if rng.random() < 0.5 else "shape"
+    fake_row = int(rng.choice([i for i in range(n_rows) if i != imp_r]))
+    fake_col = int(rng.choice([i for i in range(n_cols) if i != imp_c]))
