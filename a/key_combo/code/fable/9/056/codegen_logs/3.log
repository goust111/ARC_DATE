def _gen_max_straight_diagonal_run(pts: set[tuple[int, int]]) -> int:
    best = 0
    for dr, dc in ((1, 1), (1, -1)):
        for r, c in pts:
            if (r - dr, c - dc) in pts:
                continue
            length = 0
            while (r, c) in pts:
                length += 1
                r += dr
                c += dc
            best = max(best, length)
    return best


