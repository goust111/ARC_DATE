+            if color == bg or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if seen[nr, nc] or int(grid[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+
+            rows = [rr for rr, _ in coords]
+            cols = [cc for _, cc in coords]
+            r0, r1 = min(rows), max(rows)
+            c0, c1 = min(cols), max(cols)
+            mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+            for rr, cc in coords:
+                mask[rr - r0, cc - c0] = True
+            components.append(
+                {
+                    "color": color,
+                    "mask": mask,
+                    "r0": r0,
+                    "c0": c0,
+                    "r1": r1,
+                    "c1": c1,
+                    "bottom": r1,
+                }
+            )
+
+    return components
+
+
+def _order_key(component: dict) -> tuple[int, int, int, int]:
+    return (-int(component["r1"]), -int(component["r0"]), int(component["c0"]), int(component["c1"]))
+
+
+def _stamp(board: np.ndarray, mask: np.ndarray, r0: int, c0: int, color: int) -> None:
+    locs = np.argwhere(mask)
+    for dr, dc in locs:
+        board[int(r0 + dr), int(c0 + dc)] = int(color)
+
+
+def _drop_component(
+    board: np.ndarray,
+    occupied: np.ndarray,
+    component: dict,
+) -> tuple[int, str]:
+    mask = np.asarray(component["mask"], dtype=bool)
+    color = int(component["color"])
+    h, w = board.shape
+    r0 = int(component["r0"])
+    c0 = int(component["c0"])
+    locs = np.argwhere(mask)
+
+    shift = 0
+    stop_reason = "floor"
+    while True:
+        blocked = False
+        for dr, dc in locs:
+            nr = r0 + int(dr) + shift + 1
+            nc = c0 + int(dc)
+            if nr >= h:
+                stop_reason = "floor"
+                blocked = True
+                break
+            if occupied[nr, nc]:
+                stop_reason = "piece"
+                blocked = True
+                break
+        if blocked:
+            break
+        shift += 1
+
+    final_r0 = r0 + shift
+    for dr, dc in locs:
+        rr = final_r0 + int(dr)
+        cc = c0 + int(dc)
+        board[rr, cc] = color
+        occupied[rr, cc] = True
+    return final_r0, stop_reason
+
+
+def _settle_components(components: list[dict], shape: tuple[int, int]) -> tuple[np.ndarray, list[dict]]:
+    board = np.zeros(shape, dtype=int)
+    occupied = np.zeros(shape, dtype=bool)
+    settled: list[dict] = []
+    for component in sorted(components, key=_order_key):
+        final_r0, stop_reason = _drop_component(board, occupied, component)
+        settled.append(
