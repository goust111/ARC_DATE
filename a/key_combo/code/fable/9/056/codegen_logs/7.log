+def _drop_component(
+    board: np.ndarray,
+    occupied: np.ndarray,
+    component: dict,
+) -> tuple[int, str]:
+    mask = np.asarray(component["mask"], dtype=bool)
+    color = int(component["color"])
+    h, w = board.shape
+    r0 = int(component["r0"])
+    c0 = int(component["c0"])
+    locs = np.argwhere(mask)
+
+    shift = 0
+    stop_reason = "floor"
+    while True:
+        blocked = False
+        for dr, dc in locs:
+            nr = r0 + int(dr) + shift + 1
+            nc = c0 + int(dc)
+            if nr >= h:
