+        if blocked:
+            break
+        shift += 1
+
+    final_r0 = r0 + shift
+    for dr, dc in locs:
+        rr = final_r0 + int(dr)
+        cc = c0 + int(dc)
+        board[rr, cc] = color
+        occupied[rr, cc] = True
+    return final_r0, stop_reason
