+
+def _component_masks(grid: np.ndarray, bg: int = BACKGROUND) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
