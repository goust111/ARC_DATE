+MACRO_SIZE = 3
+GRID_SIZE = 11
+SEPARATORS = (3, 7)
+ALL_CELLS = [(r, c) for r in range(TILE_SIZE) for c in range(TILE_SIZE)]
+ALL_SLOTS = [(r, c) for r in range(MACRO_SIZE) for c in range(MACRO_SIZE)]
