_GEN_AREA_BOUNDS_BY_HEIGHT = {1: (1, 3), 2: (2, 5)}
_GEN_WIDTH_OPTIONS = {(1, 1): (1,), (1, 2): (2,), (1, 3): (3,), (2, 2): (1,), (2, 3): (2,), (2, 4): (2, 3), (2, 5): (3,)}

# Color, blocking, and retry constraints.
