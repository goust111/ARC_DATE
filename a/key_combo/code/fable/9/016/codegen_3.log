+    for comp in comps:
+        bbox = _bbox(comp)
+        patch = _crop(g, bbox)
+        if len(comp) == patch.size and _is_seed_patch(patch):
+            assert seed_bbox is None, "expected exactly one multicolor solid seed rectangle"
