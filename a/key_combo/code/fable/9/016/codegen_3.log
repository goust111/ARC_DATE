+
+def _render_window(seed: np.ndarray, rel_r0: int, rel_c0: int, h: int, w: int, *, mirrored: bool) -> np.ndarray:
+    out = np.zeros((h, w), dtype=int)
+    seed_h, seed_w = seed.shape
+    for r in range(h):
+        for c in range(w):
+            rr = rel_r0 + r
+            cc = rel_c0 + c
+            if mirrored:
+                out[r, c] = _sample_reflected_tile(seed, rr, cc)
+            else:
