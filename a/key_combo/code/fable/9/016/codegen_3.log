+import numpy as np
+
+
+BG = 0
+COLOR_POOL = [1, 2, 3, 4, 5, 6, 7, 8, 9]
+
+GEN_GRID_ROWS = (22, 28)
+GEN_GRID_COLS = (22, 28)
+GEN_SEED_H = (3, 6)
+GEN_SEED_W = (3, 6)
+GEN_WINDOW_COUNT = [2, 3, 4]
+GEN_WINDOW_WEIGHTS = [2, 5, 3]
