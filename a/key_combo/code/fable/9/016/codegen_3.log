+def _sample_reflected_tile(seed: np.ndarray, rel_r: int, rel_c: int) -> int:
+    h, w = seed.shape
+    q_r, rem_r = divmod(int(rel_r), h)
+    q_c, rem_c = divmod(int(rel_c), w)
+    if q_r % 2:
+        rem_r = h - 1 - rem_r
+    if q_c % 2:
+        rem_c = w - 1 - rem_c
+    return int(seed[rem_r, rem_c])
