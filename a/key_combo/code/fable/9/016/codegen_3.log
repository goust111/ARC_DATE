+    return {
+        "bbox": (top, left, top + inner_h + 1, left + inner_w + 1),
+        "inner_h": inner_h,
+        "inner_w": inner_w,
+        "cross_r": len(row_qs) > 1,
+        "cross_c": len(col_qs) > 1,
+        "negative": any(q < 0 for q in row_qs) or any(q < 0 for q in col_qs),
+        "combos": combos,
+        "diff_from_plain": not np.array_equal(mirrored, plain),
