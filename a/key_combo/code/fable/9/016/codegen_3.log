+                rel_c = c - seed_c0
+                out[r, c] = _sample_reflected_tile(seed_patch, rel_r, rel_c)
+    return out
+
+
+def _has_smaller_period(tile: np.ndarray) -> bool:
+    h, w = tile.shape
+    for ph in range(1, h + 1):
+        for pw in range(1, w + 1):
+            if ph == h and pw == w:
+                continue
+            ok = True
+            for r in range(h):
+                for c in range(w):
+                    if int(tile[r, c]) != int(tile[r % ph, c % pw]):
+                        ok = False
+                        break
