+def _window_features(
+    seed: np.ndarray,
+    seed_top: int,
+    seed_left: int,
+    top: int,
+    left: int,
+    inner_h: int,
+    inner_w: int,
+) -> dict:
+    rel_r0 = top + 1 - seed_top
+    rel_c0 = left + 1 - seed_left
