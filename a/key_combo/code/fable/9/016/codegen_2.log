+BG = 0
+FRAME_COLOR = 5
+MARKER_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+SIDES = ("top", "bottom", "left", "right")
+DIR_IN = {
+    "top": (1, 0),
+    "bottom": (-1, 0),
+    "left": (0, 1),
+    "right": (0, -1),
+}
+
+GEN_MAX_ATTEMPTS = 400
+GEN_FRAME_COUNT_OPTIONS = (1, 2, 2, 3)
+GEN_FRAME_SIZE_RANGE = (5, 9)
+GEN_CANVAS_MIN = 18
+GEN_CANVAS_MAX = 30
+GEN_FRAME_GAP = 2
+GEN_MAX_MARKERS_PER_FRAME = 4
+GEN_RANDOM_DECOY_RANGE = (0, 3)
