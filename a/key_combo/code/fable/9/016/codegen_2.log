+    elif br1 < ar0:
+        row_gap = ar0 - br1 - 1
+    else:
+        row_gap = 0
+    if ac1 < bc0:
+        col_gap = bc0 - ac1 - 1
+    elif bc1 < ac0:
+        col_gap = ac0 - bc1 - 1
+    else:
+        col_gap = 0
+    return max(row_gap, col_gap)
+
+
+def _draw_frame(grid: np.ndarray, frame: dict) -> None:
+    r0, c0, r1, c1 = frame["bbox"]
+    grid[r0, c0 : c1 + 1] = FRAME_COLOR
+    grid[r1, c0 : c1 + 1] = FRAME_COLOR
+    grid[r0 : r1 + 1, c0] = FRAME_COLOR
