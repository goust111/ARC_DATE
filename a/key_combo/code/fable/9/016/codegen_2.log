+    seen_sources: set[tuple[int, int]] = set()
+    for plan in frame_plans:
+        frame = plan["frame"]
+        lane = _lane_cells(frame)
+        colors = plan["colors_near_to_far"]
+        sources = plan["source_cells"]
+        if len(colors) != len(set(colors)):
