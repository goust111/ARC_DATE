    if len(marker_colors) == 2:
        return [marker_colors[0]], [marker_colors[1]]
    if random.randrange(2) == 0:
        return [marker_colors[0], marker_colors[1]], [marker_colors[2]]
    return [marker_colors[0]], [marker_colors[1], marker_colors[2]]


