+    for r, c, color in decoys:
+        out[r, c] = color
+    for plan in frame_plans:
+        lane = _lane_cells(plan["frame"])
+        colors = plan["colors_near_to_far"]
+        for idx, color in enumerate(colors):
+            tr, tc = lane[-1 - idx]
+            out[tr, tc] = color
