+def _validate_scene(
+    inp: np.ndarray,
+    out: np.ndarray,
+    frames: list[dict],
+    frame_plans: list[dict],
+    decoys: list[tuple[int, int, int]],
+    ray_union: set[tuple[int, int]],
+) -> bool:
+    if inp.ndim != 2 or out.ndim != 2 or max(inp.shape) > 30 or max(out.shape) > 30:
