+        sc0 = random.randint(1, grid_w - small_w - 1)
+        big_bbox = (br0, bc0, br0 + big_h - 1, bc0 + big_w - 1)
+        small_bbox = (sr0, sc0, sr0 + small_h - 1, sc0 + small_w - 1)
+        if _boxes_separated(big_bbox, small_bbox, gap=2):
+            return big_bbox, small_bbox
+    return None
+
+
+def _render_input(
