  27: def main(grid: np.ndarray) -> np.ndarray:
  28:     """
  29:     Overlay the two masks separated by the divider and recolor their union green.
  30: 
  31:     Input structure:
  32:     - A black-background grid contains one centered full-width divider row.
  33:     - The divider row splits the grid into equal top and bottom rectangular masks.
  34:     - Each mask uses exactly one foreground color on black background.
  35: 
  36:     Rule:
  37:     - Remove the divider and compare the top and bottom masks cell by cell.
  38:     - Output a grid with the same shape as one mask.
  39:     - A cell is green if either corresponding input mask cell is foreground;
  40:       otherwise it remains black.
  41: 
  42:     Key insight:
  43:     - The output is not copied from one half; it is the positional union of the
  44:       two same-sized masks on either side of the separator.
  45:     """
  46:     g = np.asarray(grid, dtype=int)
  47:     assert g.ndim == 2, "expected a 2D grid"
  48: 
  49:     bg = get_bg(g)
  50:     assert bg == Color.BLACK, "expected black background"
  51: 
  52:     sep = _divider_row(g, bg)
  53:     top = g[:sep]
  54:     bottom = g[sep + 1 :]
  55:     assert top.shape == bottom.shape, "divider must split two equal mask regions"
  56: 
  57:     top_colors = colors_present(top, exclude={bg})
  58:     bottom_colors = colors_present(bottom, exclude={bg})
  59:     assert len(top_colors) == 1, "top mask must have one foreground color"
  60:     assert len(bottom_colors) == 1, "bottom mask must have one foreground color"
  61:     assert top_colors[0] != bottom_colors[0], "mask foreground colors must differ"
  62: 
  63:     divider_color = int(g[sep, 0])
  64:     assert divider_color not in top_colors + bottom_colors, "divider color must be separate"
  65: 
  66:     return np.where((top != bg) | (bottom != bg), Color.GREEN, bg).astype(int)
