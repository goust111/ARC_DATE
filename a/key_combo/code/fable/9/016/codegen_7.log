  "transform": "compact the bars into the output border; place the normalized mask inside it; recolor each mask pixel by the color of its unique nearest border side, leaving tied pixels as the mask color",
  "grid_shape": "n+2 by n+2, where n is the side-bar length and mask bbox size"
}
</annotation>
<generation_spec>
```yaml
spec:
  grid: 14-16 rows x 15-16 cols, background 0
  frame:
    shape: 4 solid bars (top, bottom, left, right) each length n, width 1
    n: 3-5
    layout: forms (n+2)x(n+2) rectangle; corners are background; interior all background
    colors: 4 distinct non-zero non-8 colors, one per side
  mask:
    color: always 8
    bbox: exactly n x n, matching frame interior size
    density: 0.62-0.67 of n*n cells filled
