  output:
    size: (n+2) x (n+2)
    border: 4 bars placed on edges, corners background
    interior: mask normalized into interior; each mask pixel recolored by its unique nearest side color (top/left/bottom/right by row/col distance to edge); tied-distance pixels stay color 8

generation_strategy:
  approach: output-first
