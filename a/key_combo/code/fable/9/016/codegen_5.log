+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+MARKER = 9
+PANEL_COLOR_POOL = (1, 2, 3, 4, 5, 6, 7, 8)
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
