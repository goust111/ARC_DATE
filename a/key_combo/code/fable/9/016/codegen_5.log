    counts = sum(mask.astype(int) for mask in masks)
    exactly_one = counts == 1
    overlapped = counts >= 2

    if not np.any(exactly_one):
        return False
    if not np.any(overlapped):
        return False

    for mask in masks:
        if not np.any(mask & exactly_one):
