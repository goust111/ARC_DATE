    if not rec(0, np.zeros((H, W), dtype=bool), None):
        return None
    return assigned


def _gen_input_capacity_top(H: int, W: int) -> int:
    usable_h = H - _GEN_DOMINO_AREA
    horizontal = ((usable_h + 1) // 2) * ((W + 1) // 3)
    vertical = ((usable_h + 1) // 3) * ((W + 1) // 2)
    return max(horizontal, vertical)


