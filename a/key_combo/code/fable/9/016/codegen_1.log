+def _tile_for_period(grid: np.ndarray, known: np.ndarray, pr: int, pc: int) -> np.ndarray | None:
+    tile = np.full((pr, pc), UNKNOWN, dtype=int)
+    for r, c in known:
+        rr = int(r % pr)
+        cc = int(c % pc)
