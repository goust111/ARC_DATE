  "type": "transform_in_place",
  "src": "single-color one-cell-thick L object touching one input corner",
  "transform": "replace the L with a same-color right-triangle outline in the same corner; double the L leg length and draw the missing diagonal between its free endpoints",
  "grid_shape": "square canvas of side 3n-2 (16x16 for the 6x6 inputs)"
}
</annotation>
<generation_spec>
```yaml
spec:
  grid:
    shape: n x n square, n in 4-8 [observed n=6 in all 3 examples]
    output_size: (3n-2) x (3n-2)
  colors:
    bg: one color filling most of grid
    fg: exactly one other color for the L shape
  L_shape:
    structure: 1-pixel-thick corner L (two perpendicular legs sharing a vertex)
    leg_length: 2 to n-1 (bbox is leg_len x leg_len, pixel count = 2*leg_len - 1)
    placement: vertex at one of the 4 grid corners; each leg lies flush against a grid edge
    rest_of_grid: all bg
  output_triangle:
    structure: right-triangle outline in same corner of enlarged canvas
    side_length: 2 * leg_len
    components: two perpendicular legs on corner edges + diagonal connecting free endpoints
    pixel_count: 3 * side - 3

generation_strategy:
  approach: direct construction (input is simple enough)
  steps:
    1. Pick n uniformly from 4-8, bg and fg as two distinct colors
    2. Pick one of 4 corners and leg_len from 2..n-1
    3. Place a 1-pixel-thick L at the chosen corner with the given leg_len
    4. Fill remaining cells with bg
```
