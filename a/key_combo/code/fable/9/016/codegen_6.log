+    lane_count = len(counts)
+    max_stack = max(counts)
+    min_h = max(GRID_H_RANGE[0], 4 * max_stack + 1)
+    min_w = max(GRID_W_RANGE[0], 2 * lane_count - 1)
+    if min_h > GRID_H_RANGE[1] or min_w > GRID_W_RANGE[1]:
