  grid: 10-17 rows x 10-17 cols
  background: 0 (black)
  frame:
    shape: 1-cell-wide rectangular border spanning entire grid edge
    corners: bg (all four corner cells are background)
    sides: 4 distinct non-bg colors; top/bottom rows uniform, left/right cols uniform
  markers:
    location: scattered single pixels in the interior (rows 1..H-2, cols 1..W-2)
    matching: 5-10 markers whose color equals one of the 4 frame-side colors
    distractors: 1-3 markers whose color is not any frame-side color [observed]
    no_collision: two same-side markers never share the projected coordinate
      (top/bottom markers have unique columns; left/right markers have unique rows)
