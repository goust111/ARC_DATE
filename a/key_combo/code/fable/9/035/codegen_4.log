+import numpy as np
+
+
+_BG = 0
+_TEMPLATE_COLOR = 5
+_PALETTE = np.array([1, 2, 3, 4, 6, 7, 8, 9], dtype=int)
+
+_ALL_TRANSFORMS = (
+    "identity",
+    "rot90",
+    "rot180",
