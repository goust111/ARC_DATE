+def _find_control_and_legends(
+    grid: np.ndarray,
+    *,
+    bg: int,
+    template_color: int,
+    lattice_rows: list[int],
+    lattice_cols: list[int],
+    template_mask: np.ndarray,
+) -> tuple[int, int, dict[int, np.ndarray], dict[int, str]] | None:
+    h, w = grid.shape
+    rows_n = len(lattice_rows)
+    cols_n = len(lattice_cols)
