spec:
  grid: 23x23, background 0
  lattice:
    cell_size: 3x3, all cells share one template mask (a 3x3 binary pattern with 1-2 bg holes)
    cell_color: 5 (gray); all cells identical in shape and color
    dimensions: 3-5 rows x 3-5 cols (product 15-20 cells)
    spacing: 1 bg row/col gap between adjacent cells
  control_matrix:
    size: exactly lattice_rows x lattice_cols (dense, no bg pixels)
    colors: 2-5 distinct non-bg, non-5 colors; never includes 0 or 5
    position: separated from lattice by >=1 bg row/col; placed left or below [observed]
  layout: lattice and control do not overlap; >=1 bg border around all content
  output:
    each gray cell recolored to match the control pixel at same (row, col) index
    control matrix unchanged; background unchanged; color 5 fully removed
generation_strategy:
  approach: output-first
  steps:
    1. Pick lattice dims R x C (3-5 each, R*C in 15-20).
    2. Design a 3x3 template mask with 1-2 bg holes (5-8 foreground pixels).
    3. Choose 2-5 distinct colors for the control matrix (exclude 0 and 5).
    4. Fill an R x C control matrix densely with those colors.
    5. Build the output lattice by stamping the template with each cell recolored per control.
    6. Place lattice and control on a 23x23 bg-0 grid, separated by >=1 bg gap, >=1 bg border.
    7. Build input by copying output and recoloring all lattice foreground pixels back to 5.
