  "type": "move_to_match",
  "src": "color pixel s in the dense control matrix",
  "dst": "same-position 3x3 template object d in the regular lattice",
  "match_cond": "s.matrix_row == d.lattice_row and s.matrix_col == d.lattice_col",
  "transform": "recolor d.foreground pixels to s.color; preserve d background holes and leave the control matrix unchanged",
  "symbol_instructions": "control matrix gives the output color for each lattice slot"
}
</annotation>
<generation_spec>
```yaml
