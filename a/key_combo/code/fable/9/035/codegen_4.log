+_MIRROR_TRANSFORMS = ("flip_lr", "flip_ud", "transpose", "anti")
+
+_TEMPLATE_SIZES = (4, 5)
+_LATTICE_DIMS = ((2, 3), (3, 2), (3, 3), (2, 4), (4, 2), (3, 4), (4, 3))
+_CELL_GAPS = (1, 2)
+_LEGEND_COUNTS = (3, 4)
+_LEGEND_GAPS = (1, 2)
