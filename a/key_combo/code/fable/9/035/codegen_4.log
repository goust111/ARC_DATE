    if single_count > len(singles):
        return None

    selected.update(random.sample(pairs, pair_count))
    selected.update(random.sample(singles, single_count))

    sprite = np.full((h, w), BG_COLOR, dtype=int)
    for r, c in selected:
        sprite[r, c] = FG_COLOR
        sprite[h - 1 - r, c] = FG_COLOR

