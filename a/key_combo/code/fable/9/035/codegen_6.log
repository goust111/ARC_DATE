spec:
  grid: 4-12 rows x 4-12 cols, both even
  seed: 2x2 tile at top-left corner of the grid
  seed_colors: 3-4 distinct colors chosen from palette 0-9; all 4 rotations (0/90/180/270 CCW) must be mutually distinct
  tiling: entire grid partitioned into non-overlapping 2x2 blocks; each block is a rotation (0/90/180/270) of the seed
  block_at_origin: always the unrotated seed (rotation 0)
  rotation_assignment: every aligned 2x2 block is some rotation of the seed; all 4 rotation variants appear at least once when grid has >=8 blocks [observed]
  grid_colors: exactly the colors present in the seed (no additional colors)
  output: the 2x2 seed extracted from the top-left corner, unchanged
  transform: crop top-left 2x2 from input

generation_strategy:
  approach: output-first then build input
  steps:
