VALID_SIZE_PAIRS = [
    (g, n) for g in GRID_SIZE_RANGE for n in TILE_SIZE_RANGE
    if g >= MOTIF_SIDE_FACTOR * n + 2 * MIN_MOTIF_MARGIN
]

