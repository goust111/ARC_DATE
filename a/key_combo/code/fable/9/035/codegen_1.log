PLUS_SHAPE = {(0, 1), (1, 0), (1, 1), (1, 2), (2, 1)}


def _assert_plus_masks(g: np.ndarray) -> None:
    mask = g == UNKNOWN
    coords = np.argwhere(mask)
    assert coords.size, "expected at least one color-8 mask"

    seen = np.zeros(g.shape, dtype=bool)
    h, w = g.shape
    for r0, c0 in coords:
        r0 = int(r0)
        c0 = int(c0)
