+
+def _random_unused_segment(
+    grid: np.ndarray,
+    forbidden: set[tuple[int, int]],
+) -> set[tuple[int, int]] | None:
+    h, w = grid.shape
+    axes = []
+    for r in range(h):
+        for c0 in range(w - 1):
+            for c1 in range(c0 + 1, min(w, c0 + 8)):
+                cells = {(r, c) for c in range(c0, c1 + 1)}
+                if cells.isdisjoint(forbidden):
+                    axes.append(cells)
