+    seg1 = [(p1[0] - t, p1[1] + t) for t in range(1, revisit_gap + 1)]
+    seg2 = [p3]
+    post_len = p3[1]
+    seg3 = [(p3[0] + t, p3[1] - t) for t in range(1, post_len + 1)]
