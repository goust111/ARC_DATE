def _gen_size_tuples(total, n, size_range):
    lo, hi = size_range
    hi = min(hi, total)
    out = []

    def rec(prefix):
        if len(prefix) == n:
            if sum(prefix) + _GEN_MIN_AXIS_GAP * (n - 1) <= total:
                out.append(tuple(prefix))
            return
        remaining_slots = n - len(prefix) - 1
