    return bool(_gen_size_tuples(total, n, size_range))


def _gen_random_span(total, size_range):
    lo, hi = size_range
    hi = min(hi, total)
    size = random.randint(lo, hi)
    start = random.randint(0, total - size)
    return start, start + size - 1


