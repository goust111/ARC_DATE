+    lane_specs: list[dict] = []
+    for direction, pattern in zip(directions, patterns):
+        spec = _make_lane_spec(height, direction, pattern)
+        if spec is None:
+            return None
+        lane_specs.append(spec)
+
+    return height, widths, lane_specs
