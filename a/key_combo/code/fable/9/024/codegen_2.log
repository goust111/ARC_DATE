+        if parsed["sprite_r"] != spec["sprite_r"]:
+            return False
+        if parsed["gates"] != spec["gates"]:
+            return False
+        if not _validate_lane_semantics(height, spec):
+            return False
+        sig = _lane_output_signature(height, spec)
+        if sig in seen_sig:
