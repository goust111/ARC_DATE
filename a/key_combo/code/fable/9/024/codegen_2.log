+        sprite_r = random.randint(5, height - 7)
+        grey_r = random.randint(sprite_r + 3, height - 4)
+
+        above = _spaced_choices(2, sprite_r - 1, (1, 2))
+        between = _spaced_choices(sprite_r + 1, grey_r - 1, (1, 2))
