+    total_width = 1 + sum(widths) + lane_count
+    if total_width > 30:
+        return None
+
+    patterns = [1, 2]
+    while len(patterns) < lane_count:
+        patterns.append(random.choice((1, 2)))
+    random.shuffle(patterns)
+
