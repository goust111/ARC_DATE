+
+BG = 0
+GREY = 5
+TIP_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+
+_COUNT_CYCLE = (4, 3, 2, 4, 3, 4)
+_GEN_CALLS = 0
