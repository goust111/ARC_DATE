+    if len({tuple(correct.flatten())}) != 1 and np.array_equal(inp, correct):
+        return False
+
+    # At least one bar must disagree with raw-height quarter-turns.
+    if not any((bar["height"] - bar["rank"]) % 4 != 0 for bar in bars):
