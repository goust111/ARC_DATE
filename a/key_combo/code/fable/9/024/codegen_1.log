+
+def generate_input() -> np.ndarray:
+    global _GEN_CALLS
+    preferred_count = _COUNT_CYCLE[_GEN_CALLS % len(_COUNT_CYCLE)]
+    _GEN_CALLS += 1
+
+    for _ in range(600):
+        grid = _attempt(preferred_count=preferred_count)
+        if grid is not None:
+            return grid
+
+    for _ in range(600):
+        grid = _attempt()
+        if grid is not None:
+            return grid
