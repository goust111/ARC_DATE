    selected: list[tuple[int, int] | None] = [None] * len(regions)

    def choose_at(pos: int, used_area: int, largest_area: int) -> bool:
        if pos == len(order):
            return total_area - used_area > largest_area

        idx = order[pos]
        candidates = choices[idx][:]
        random.shuffle(candidates)
