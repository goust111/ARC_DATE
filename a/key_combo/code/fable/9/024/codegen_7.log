_GEN_SPRITE_COLORS = (1, 2, 3, 5, 8, 9)
_GEN_SPRITE_HEIGHTS = (2, 3)
_GEN_SPRITE_WIDTH, _GEN_SPRITE_MAX_PIXELS_STOP = 2, 5
_GEN_SPRITE_COORD_RETRIES = 100
# Retry budget.
