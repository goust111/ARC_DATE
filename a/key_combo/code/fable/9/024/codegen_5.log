    height = random.randint(_GEN_MIN_HEIGHT, _GEN_MAX_HEIGHT)
    width = random.randint(_GEN_MIN_WIDTH, _GEN_MAX_WIDTH)
    rect_count = random.randint(_GEN_MIN_RECT_COUNT, _GEN_MAX_RECT_COUNT)

