+    return containers
+
+
+def _band_cells(container: dict) -> list[tuple[int, int]]:
+    dr, dc = DIRS[container["gap_side"]]
+    cells = []
+    for step in range(1, int(container["band_length"]) + 1):
+        for gr, gc in container["gap_cells"]:
+            cells.append((gr + dr * step, gc + dc * step))
+    return cells
