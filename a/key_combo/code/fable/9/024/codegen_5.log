+    return grid
+
+
+def _padded_bbox_cells(bbox: tuple[int, int, int, int], height: int, width: int, pad: int = 1) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    out = []
+    for r in range(max(0, r0 - pad), min(height, r1 + pad + 1)):
+        for c in range(max(0, c0 - pad), min(width, c1 + pad + 1)):
+            out.append((r, c))
