+            interior_cells = [
+                (r, c)
+                for r in range(r0 + 1, r1)
+                for c in range(c0 + 1, c1)
+            ]
+            if spec["liquid_count"] >= len(interior_cells):
+                continue
+            spec["liquid_cells"] = _choose_liquid_cells(interior_cells, spec["liquid_count"])
