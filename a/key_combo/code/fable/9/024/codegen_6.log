     ### 各组成项的原始变体详情      以下是 combo_spec 中每个组成项在维度分析 YAML 中的原始描述，帮助你理解每项改动的来源和细节：      - **D6/0** — 输出网格形状 (`grid_shape`)   - 当前值: 紧凑裁剪 — 输出仅包含拼装完成的矩形复合体，去除所有背景   - 改为: 输出保持原始网格尺寸 — 拼装后的复合体放置在原始网格的某个固定位置（如中心或图例原位），其余区域保持背景色。输出尺寸与输入相同，解题者需推断放置位置   - 来源: inversion（参考任务: None） - **D12/2** — 轨迹：源精灵位置的痕迹 (`trajectory`)   - 当前值: 精灵拼装后从原位消失，输出中不保留任何原始位置信息   - 改为: 从原位到拼装位置绘制连接线 — 每个精灵的重心到其在复合体中的重心之间绘制一条该精灵颜色的直线轨迹。输出中可见4条辐射状的彩色连接线，提供了运动过程的可视化   - 来源: continuous_trail（参考任务: 8b9c3697） - **D15/1** — 复合体的整体变换 (`transform`)   - 当前值: 拼装后的矩形复合体直接输出，不做整体变换   - 改为: 复合体水平/垂直翻转输出 — 拼装完成后的矩形需沿某轴翻转再输出，翻转方向由图例中2x2颜色的某种对称性暗示。测试解题者对全局变换的推断   - 来源: reflection（参考任务: b10624e5）      ## 原始 solver + generator 代码      文件: `/home/lixinyu/snap/new/arc2_solver_select/f560132c.py`      ```python     import numpy as np  from arc_utils import bbox_coords, components_mask, get_bg, neighbors4, paste, random_free_location import math import random   def _factor_pairs(n: int) -> list[tuple[int, int]]:     out = []     for h in range(1, int(n**0.5) + 1):         if n % h == 0:             w = n // h             out.append((h, w))             if h != w:                 out.append((w, h))     return out   def _normalize_coords(coords: list[tuple[int, int]] | tuple[tuple[int, int], ...]) -> tuple[tuple[tuple[int, int], ...], int, int]:     rs = [r for r, _ in coords]     cs = [c for _, c in coords]     r0 = min(rs)     c0 = min(cs)     norm = tuple(sorted((r - r0, c - c0) for r, c in coords))     h = max(r for r, _ in norm) + 1     w = max(c for _, c in norm) + 1     return norm, int(h), int(w)   def _rot90(coords: tuple[tuple[int, int], ...]) -> tuple[tuple[tuple[int, int], ...], int, int]:     norm, h, w = _normalize_coords(coords)     rot = [(c, h - 1 - r) for r, c in norm]     return _normalize_coords(rot)   def _flip_h(coords: tuple[tuple[int, int], ...]) -> tuple[tuple[tuple[int, int], ...], int, int]:     norm, h, w = _normalize_coords(coords)     flp = [(r, w - 1 - c) for r, c in norm]     return _normalize_coords(flp)   def _dihedral_orientations(     coords: tuple[tuple[int, int], ...], ) -> list[tuple[tuple[tuple[int, int], ...], int, int, int, bool]]:     \"\"\"     Unique orientations under rotations + mirror (D4).     Returned as (coords, h, w, rot_k, flipped), where the transform is:       - if flipped: horizontal flip (mirror left-right)       - then rot_k times 90° clockwise rotation     coords are normalized to start at (0,0).     \"\"\"     seen: set[tuple[tuple[int, int], ...]] = set()     out: list[tuple[tuple[tuple[int, int], ...], int, int, int, bool]] = []     cur = coords     for rot_k in range(4):         c, h, w = _normalize_coords(cur)         if c not in seen:             seen.add(c)             out.append((c, h, w, int(rot_k), False))         cur = _rot90(cur)[0]     cur = _flip_h(coords)[0]     for rot_k in range(4):         c, h, w = _normalize_coords(cur)         if c not in seen:             seen.add(c)             out.append((c, h, w, int(rot_k), True))         cur = _rot90(cur)[0]     return out   def _extract_legend_map(g: np.ndarray, pts: np.ndarray, k: int) -> np.ndarray:     \"\"\"     Inside the legend component's bounding box, find a k×k color map block (may include 0).     We pick the k×k window with the maximum number of distinct colors; ties go to top-left.     \"\"\"     r0, c0, r1, c1 = bbox_coords(pts)     sub = g[r0 : r1 + 1, c0 : c1 + 1]     hh, ww = sub.shape     assert k > 0 and hh >= k and ww >= k, 'legend component must fit k×k map'     best = None  # (distinct, -rr, -cc)     best_rc = None     for rr in range(hh - k + 1):         for cc in range(ww - k + 1):             window = sub[rr : rr + k, cc : cc + k]             distinct = int(len(set(map(int, window.ravel()))))             key = (distinct, -rr, -cc)             if best is None or key > best:                 best = key                 best_rc = (rr, cc)     assert best_rc is not None, 'legend component must contain a valid k×k color map window'     rr, cc = best_rc     return np.asarray(sub[rr : rr + k, cc : cc + k], dtype=int).copy()   def _fill_holes_in_component(g: np.ndarray, pts: np.ndarray, bg: int) -> tuple[tuple[tuple[int, int], ...], int]:     \"\"\"     Treat background 'holes' fully enclosed inside the component bbox as part of the piece.     Returns (filled_pts, hole_count), where filled_pts is a sorted tuple of absolute coords.     \"\"\"     r0, c0, r1, c1 = bbox_coords(pts)     hh = r1 - r0 + 1     ww = c1 - c0 + 1     occ = np.zeros((hh, ww), dtype=bool)     for r, c in pts:         occ[r - r0, c - c0] = True      bgmask = ~occ     vis = np.zeros_like(bgmask, dtype=bool)     st: list[tuple[int, int]] = []      for rr in range(hh):         for cc in range(ww):             if rr in (0, hh - 1) or cc in (0, ww - 1):                 if bgmask[rr, cc] and not vis[rr, cc]:                     vis[rr, cc] = True                     st.append((rr, cc))                     while st:                         r, c = st.pop()                         for r2, c2 in neighbors4(r, c):                             if 0 <= r2 < hh and 0 <= c2 < ww and bgmask[r2, c2] and not vis[r2, c2]:                                 vis[r2, c2] = True                                 st.append((r2, c2))      holes = bgmask & ~vis     hole_coords = [(r0 + rr, c0 + cc) for rr, cc in zip(*np.where(holes))]     filled = tuple(sorted(set(map(tuple, pts)).union(hole_coords)))     return filled, int(holes.sum())   def _assemble_exact_cover(     pieces: list[dict],     legend_idx: int,     legend_map: np.ndarray,     k: int, ) -> np.ndarray:     \"\"\"     Tile all pieces into a full rectangle (no holes), allowing rotations + reflections.     Recolor each piece by quantizing its centroid into a k×k grid, using legend_map.     \"\"\"     total = sum(int(p[\"area\"]) for p in pieces)     max_h = max(max(h for _, h, _, _, _ in p[\"oris\"]) for p in pieces)     max_w = max(max(w for _, _, w, _, _ in p[\"oris\"]) for p in pieces)      dims = _factor_pairs(total)     dims = [(H, W) for (H, W) in dims if H >= max_h and W >= max_w]     assert len(dims) == 1, 'piece areas and bounds must imply a unique output rectangle'      for H, W in dims:         nbits = H * W         all_mask = (1 << nbits) - 1          # Precompute placements for non-legend pieces (legend is fixed at (0,0), but orientation varies).         other_pis = [i for i in range(len(pieces)) if i != legend_idx]         placements_other: list[list[tuple[int, int, int, tuple[tuple[int, int], ...]]]] = []         for pi in other_pis:             opts: list[tuple[int, int, int, tuple[tuple[int, int], ...]]] = []             for coords, ph, pw, _, _ in pieces[pi][\"oris\"]:                 for r0 in range(0, H - ph + 1):                     for c0 in range(0, W - pw + 1):                         m = 0                         for dr, dc in coords:                             idx = (int(r0) + int(dr)) * int(W) + (int(c0) + int(dc))                             m |= 1 << idx                         opts.append((m, int(r0), int(c0), coords))             placements_other.append(opts)          def solve_with_fixed_legend(             legend_coords: tuple[tuple[int, int], ...],         ) -> dict[int, tuple[int, int, int, tuple[tuple[int, int], ...]]] | None:             legend_mask = 0             for dr, dc in legend_coords:                 idx = int(dr) * int(W) + int(dc)                 legend_mask |= 1 << idx              filtered: list[list[tuple[int, int, int, tuple[tuple[int, int], ...]]]] = []             for opts in placements_other:                 filtered.append([pl for pl in opts if (pl[0] & legend_mask) == 0])              remaining = set(range(len(other_pis)))             chosen: dict[int, tuple[int, int, int, tuple[tuple[int, int], ...]]] = {                 legend_idx: (legend_mask, 0, 0, legend_coords)             }              def search(used: int) -> bool:                 if not remaining:                     return used == all_mask                 empty = (~used) & all_mask                 if empty == 0:                     return False                 cell = (empty & -empty).bit_length() - 1                 # Branch over *any* remaining piece that can cover this cell.                 # (Picking only one \"best\" piece can miss valid tilings.)                 candidates = []                 for k in sorted(remaining):                     opts_k = []                     for pl in filtered[k]:                         m = pl[0]                         if (m >> cell) & 1 and (m & used) == 0:                             opts_k.append(pl)                     if opts_k:                         candidates.append((len(opts_k), k, opts_k))                 if not candidates:                     return False                  candidates.sort(key=lambda x: (x[0], x[1]))                 for _, k, opts_k in candidates:                     remaining.remove(k)                     pi = other_pis[k]                     for pl in opts_k:                         chosen[pi] = pl                         if search(used | pl[0]):                             return True                     chosen.pop(pi, None)                     remaining.add(k)                 return False              if not search(legend_mask):                 return None             return chosen          # Try each possible legend orientation at (0,0).         chosen = None         for coords, ph, pw, _, _ in pieces[legend_idx][\"oris\"]:             assert ph <= H and pw <= W, 'legend orientation must fit the unique output rectangle'             sol = solve_with_fixed_legend(coords)             if sol is None:                 continue             chosen = sol             break         assert chosen is not None, 'exact-cover assembly failed: no valid legend orientation'          # Determine legend-map cell for each piece by centroid.         piece_cell: dict[int, tuple[int, int]] = {}         for pi, pl in chosen.items():             _, r0, c0, coords = pl             # centroid: average over occupied cells             rs = [r0 + dr for dr, _ in coords]             cs = [c0 + dc for _, dc in coords]             cr = float(sum(rs)) / float(len(rs))             cc = float(sum(cs)) / float(len(cs))             rr = int(cr * float(k) / float(H))             cc2 = int(cc * float(k) / float(W))             rr = max(0, min(int(k) - 1, rr))             cc2 = max(0, min(int(k) - 1, cc2))             piece_cell[pi] = (rr, cc2)          # Build final output.         out = np.zeros((H, W), dtype=int)         for pi, pl in chosen.items():             _, r0, c0, coords = pl             rr, cc2 = piece_cell[pi]             col = int(legend_map[rr, cc2])             for dr, dc in coords:                 out[r0 + dr, c0 + dc] = col         return out   def main(grid: np.ndarray) -> np.ndarray:     \"\"\"     Assemble scattered jigsaw pieces into a rectangle, recoloring each by a legend sprite's color map.      Input structure:     - bg = most common color.     - Several monochrome non-bg sprites (the \"pieces\"), scattered across the grid.     - One sprite is the legend: it contains a multi-color k×k patch (typically 2×2) encoding output colors.      Rule:     - Tile all pieces (rotations/reflections allowed) into a tight rectangle with no gaps.     - The legend's k×k color patch defines a spatial color map over the rectangle.     - Each piece is recolored to the legend-map color corresponding to its position in the assembled rectangle.      Key insight: The legend piece doubles as both a jigsaw piece and a color key — its internal k×k palette assigns colors by spatial quadrant.     \"\"\"     g = np.asarray(grid, dtype=int)     bg = get_bg(g)      comps = components_mask(g != bg, connectivity=4)     assert comps, 'grid must contain at least one non-background component'      # Identify legend component (most distinct colors) and infer k from number of pieces.     k = int(round(len(comps) ** 0.5))     assert k * k == len(comps), 'piece count must be a perfect square to determine k'      comp_colors = []     for pts in comps:         cols = set(int(g[r, c]) for r, c in pts if int(g[r, c]) != bg)         comp_colors.append(cols)      max_distinct = max(len(cols) for cols in comp_colors)     legend_candidates = [i for i, cols in enumerate(comp_colors) if len(cols) == max_distinct]     assert len(legend_candidates) == 1, 'legend component must be uniquely identified by distinct colors'     legend_idx = legend_candidates[0]     legend_map = _extract_legend_map(g, comps[legend_idx], k)      # Build piece masks (coords in bbox space), including filled holes.     pieces: list[dict] = []     for pts in comps:         filled_abs, _ = _fill_holes_in_component(g, pts, bg)         r0, c0, _, _ = bbox_coords(np.asarray(list(filled_abs)))         rel = tuple((r - r0, c - c0) for r, c in filled_abs)         rel_norm, _, _ = _normalize_coords(rel)         oris = _dihedral_orientations(rel_norm)         pieces.append({\"oris\": oris, \"area\": len(filled_abs)})      return _assemble_exact_cover(pieces, legend_idx, legend_map, k)  # --------------- generator (o5x) ---------------  # === CFG === SIDE_CHOICES = [8, 10, 12]                     # output square side lengths K = 2                                          # k*k quadrant grid (2*2 = 4 pieces) NUM_PIECES = K * K                             # total jigsaw pieces NUM_COLORS = 8                                 # 4 body + 4 palette, all distinct non-bg AREA_FRAC_LO = 0.08                           # min piece area as fraction of total AREA_FRAC_HI = 0.43                           # max piece area as fraction of total AREA_ABS_LO = 11                              # absolute min piece area (cells) AREA_ABS_HI = 62                              # absolute max piece area (cells) LEGEND_THRESHOLD = {8: 4, 10: 5, 12: 9}       # min extent threshold per side for legend L-shape LEGEND_CORE_SIZE = 4                           # legend always has a 4x4 filled corner block LEGEND_ARM_RANGE = range(1, 4)                 # arm width/height options for L-shape construction PARTITION_GROWTH_EXP = 1.45                    # exponent penalizing large regions during partition PARTITION_FRONTIER_EXP = 0.2                   # exponent boosting regions with wide frontiers PARTITION_SEED_JITTER = 0.2                    # random jitter when selecting seed cells INPUT_SIZE_LO = 20                             # min input grid side INPUT_SIZE_HI = 26                             # max input grid side DENSITY_LO = 0.15                              # min non-bg density target DENSITY_HI = 0.25                              # max non-bg density target SCATTER_BORDER = 1                             # border margin when placing pieces SCATTER_PADDING = 1                            # gap between piece bounding boxes GEN_RETRIES = 300                              # max attempts in generate_input()   def _area_bounds(side):     \"\"\"Min/max piece area for a given output side length.\"\"\"     total = side * side     return max(AREA_ABS_LO, math.ceil(AREA_FRAC_LO * total)), min(AREA_ABS_HI, math.floor(AREA_FRAC_HI * total))   def _has_hole(mask):     \"\"\"Return True if the mask contains an interior hole (bg region not touching the bbox edge).\"\"\"     pts = np.argwhere(mask)     if len(pts) == 0:         return True     r0, c0, r1, c1 = bbox_coords(pts)     sub = mask[r0 : r1 + 1, c0 : c1 + 1]     empty = ~sub     if not empty.any():         return False     for comp in components_mask(empty, connectivity=4):         if not (np.any(comp[:, 0] == 0) or np.any(comp[:, 0] == sub.shape[0] - 1)                 or np.any(comp[:, 1] == 0) or np.any(comp[:, 1] == sub.shape[1] - 1)):             return True     return False   def _forces_unique_square(masks, side):     \"\"\"Check that piece bbox dims force a unique S*S factorization of total area.\"\"\"     bbs = [bbox_coords(np.argwhere(m)) for m in masks]     max_h = max(r1 - r0 + 1 for r0, _, r1, _ in bbs)     max_w = max(c1 - c0 + 1 for _, c0, _, c1 in bbs)     dims = [(h, w) for h, w in _factor_pairs(side * side) if h >= max_h and w >= max_w]     return dims == [(side, side)]   def _make_legend_mask(side, min_area, max_area):     \"\"\"Build an L-shaped legend piece mask anchored at (0,0) of the side*side grid.\"\"\"     threshold = LEGEND_THRESHOLD[side]     opts = []     for h0 in range(threshold + 1, side + 1):         for w0 in range(threshold + 1, side + 1):             for arm_w in LEGEND_ARM_RANGE:                 for arm_h in LEGEND_ARM_RANGE:                     mask = np.zeros((side, side), dtype=bool)                     mask[:LEGEND_CORE_SIZE, :LEGEND_CORE_SIZE] = True                     mask[:arm_h, :w0] = True                     mask[:h0, :arm_w] = True                     area = int(mask.sum())                     if min_area <= area <= max_area:                         opts.append(mask)     return random.choice(opts).copy()   def _partition_rest(rest):     \"\"\"Flood-fill partition the complement of the legend into 3 connected regions.\"\"\"     side = rest.shape[0]     labels = np.full((side, side), -1, dtype=int)     available = set(map(tuple, np.argwhere(rest)))     anchors = [         (random.randint(0, side // 3), side - 1),         (side - 1, random.randint(0, side // 3)),         (side - 1, side - 1),     ]      seeds = []     for ar, ac in anchors:         seed = min(available, key=lambda p: abs(p[0] - ar) + abs(p[1] - ac) + random.random() * PARTITION_SEED_JITTER)         seeds.append(seed)         available.remove(seed)      areas = [0, 0, 0]     frontiers = [set() for _ in range(3)]      def add_frontier(i, r, c):         for rr, cc in neighbors4(r, c):             if 0 <= rr < side and 0 <= cc < side and rest[rr, cc] and labels[rr, cc] < 0:                 frontiers[i].add((rr, cc))      for i, seed in enumerate(seeds):         labels[seed] = i         areas[i] = 1         add_frontier(i, seed[0], seed[1])      unassigned = int(rest.sum()) - len(seeds)     while unassigned:         candidates = []         for i in range(3):             frontiers[i] = {p for p in frontiers[i] if labels[p] < 0}             if frontiers[i]:                 candidates.append(i)         if not candidates:             return None          weights = [(1.0 / (areas[i] ** PARTITION_GROWTH_EXP)) * (len(frontiers[i]) ** PARTITION_FRONTIER_EXP)                     for i in candidates]         i = random.choices(candidates, weights=weights, k=1)[0]         cell = random.choice(tuple(frontiers[i]))         frontiers[i].discard(cell)         labels[cell] = i         areas[i] += 1         unassigned -= 1         add_frontier(i, cell[0], cell[1])      return labels   def _crop_mask(mask):     \"\"\"Crop a boolean mask to its bounding box.\"\"\"     r0, c0, r1, c1 = bbox_coords(np.argwhere(mask))     return mask[r0 : r1 + 1, c0 : c1 + 1]   def _random_orientation(mask):     \"\"\"Return a random D4 orientation of the cropped mask (unique shapes only).\"\"\"     arr = mask.astype(int)     opts = []     seen = set()     for k in range(4):         rot = np.rot90(arr, k)         for oriented in (rot, np.fliplr(rot)):             r0, c0, r1, c1 = bbox_coords(np.argwhere(oriented > 0))             crop = oriented[r0 : r1 + 1, c0 : c1 + 1].astype(bool)             key = (crop.shape, tuple(crop.ravel()))             if key not in seen:                 seen.add(key)                 opts.append(crop)     return random.choice(opts)   def _palette_spots(mask):     \"\"\"Find valid 2x2 palette embedding positions (fully surrounded by piece cells).\"\"\"     spots = []     h, w = mask.shape     for r in range(1, h - K):         for c in range(1, w - K):             if mask[r : r + K, c : c + K].all() and mask[r - 1 : r + K + 1, c - 1 : c + K + 1].all():                 spots.append((r, c))     return spots   def _scatter_pieces(masks, body_colors, legend_map, side):     \"\"\"Place all pieces on a random-sized input grid with separation.\"\"\"     total = side * side     nlo = max(INPUT_SIZE_LO, math.ceil(math.sqrt(total / DENSITY_HI)))     nhi = min(INPUT_SIZE_HI, math.floor(math.sqrt(total / DENSITY_LO)))     grid_size = random.randint(nlo, nhi)     grid = np.zeros((grid_size, grid_size), dtype=int)     occupied = np.zeros_like(grid)      for pi in random.sample(range(NUM_PIECES), NUM_PIECES):         oriented = _crop_mask(masks[pi]) if pi == 0 else _random_orientation(_crop_mask(masks[pi]))         patch = np.zeros(oriented.shape, dtype=int)         patch[oriented] = body_colors[pi]         if pi == 0:             spots = _palette_spots(oriented)             if not spots:                 return None             r, c = random.choice(spots)             patch[r : r + K, c : c + K] = legend_map         try:             box = np.ones(oriented.shape, dtype=int)             r0, c0 = random_free_location(occupied, box, transparent=0,                                            border=SCATTER_BORDER, padding=SCATTER_PADDING, padding_connectivity=8)         except ValueError:             return None         occupied[r0 : r0 + oriented.shape[0], c0 : c0 + oriented.shape[1]] = 1         paste(grid, patch, r0, c0, transparent=0)     return grid   def _gen_attempt():     \"\"\"Single generation attempt: build tiling, validate, scatter pieces.\"\"\"     side = random.choice(SIDE_CHOICES)     min_area, max_area = _area_bounds(side)     legend = _make_legend_mask(side, min_area, max_area)     labels = _partition_rest(~legend)     if labels is None:         return None      masks = [legend] + [labels == i for i in range(3)]     areas = [int(m.sum()) for m in masks]     if any(a < min_area or a > max_area for a in areas):         return None     if any(len(components_mask(m, connectivity=4)) != 1 or _has_hole(m) for m in masks):         return None     if not _forces_unique_square(masks, side):         return None      # Compute centroid quadrant for each piece; all 4 must be distinct.     qcells = []     for mask in masks:         pts = np.argwhere(mask)         qcells.append((min(1, int(pts[:, 0].mean() * K / side)), min(1, int(pts[:, 1].mean() * K / side))))     if len(set(qcells)) != NUM_PIECES:         return None      colors = random.sample(range(1, 10), NUM_COLORS)     body_colors = colors[:NUM_PIECES]     palette_colors = colors[NUM_PIECES:]     random.shuffle(palette_colors)     legend_map = np.array(palette_colors, dtype=int).reshape(K, K)      expected = np.zeros((side, side), dtype=int)     for pi, mask in enumerate(masks):         rr, cc = qcells[pi]         expected[mask] = legend_map[rr, cc]      grid = _scatter_pieces(masks, body_colors, legend_map, side)     if grid is None:         return None     if not np.array_equal(main(grid), expected):         return None     return grid   def generate_input():     for _ in range(GEN_RETRIES):         grid = _gen_attempt()         if grid is not None:             return grid     raise RuntimeError('failed to generate f560132c input')      ```      ## 原始任务规格（Spec）      以下是从原始 solver 代码和示例中提炼的完整任务规格，包含精确的数值约束和生成策略。     Spec 本身就是原题代码生成时的参考文件，因此：     - 在**设计分析**阶段，参考 spec 理解原始任务的完整设计细节（对象结构、空间关系、生成策略等），以此为基础思考融合变体的改动如何落实     - 在**实现**阶段，参考 spec 中的数值约束（网格尺寸、对象数量/尺寸、颜色数等），确保融合变体在物理上可实现      ```yaml     spec:   task: Assemble k*k jigsaw pieces into a rectangle; recolor each by a legend's k*k color map based on centroid position.   k: 2 (4 pieces; k = sqrt(num_pieces))   output_rectangle:     shape: square, side 8-12, always even [observed]     area: sum of all 4 piece areas; factor pairs must yield a unique valid rectangle given piece bbox dims   pieces:     count: 4 (= k*k)     type: 4-connected polyominoes, simply connected (no internal holes)     areas: 11-62 cells; each piece 8-43% of total area     constraint: must tile the output rectangle exactly (no gaps/overlaps) under D4 transformations   legend_piece:     one of the 4 pieces; identified by having >1 color     body: single color filling the piece shape     palette: k*k (2*2) block of 4 distinct colors embedded inside the body, none equal to body color     palette_position: within the piece's bounding box (not at edge), surrounded by body-colored cells   colors:     background: 0     total_non_bg: 8 (4 piece-body colors + 4 palette colors), all mutually distinct     piece_body_colors: 4 distinct colors from 1-9, disjoint from palette colors     palette_colors: 4 distinct colors from 1-9, disjoint from piece-body colors   input_grid:     size: 20-26 rows x 20-26 cols     pieces scattered with >= 0 row/col gap between bounding boxes     non-bg density: 15-25%   transformation:     tile all pieces into the unique output rectangle (rotations/reflections allowed)     legend piece anchored at (0,0)     each piece recolored to palette color by quantizing its centroid into the k*k grid of the rectangle  generation_strategy:   approach: output-first (build tiling, then scatter pieces to create input)   steps:     1. Choose output side S in {8, 10, 12}; rectangle is S*S.     2. Generate a valid exact-cover tiling of the S*S square with 4 simply-connected polyominoes.        Method -- iterative random partition via flood-fill or cut-based dissection ensuring        each piece is 4-connected and has area >= 8, and the resulting factor pair is unique        (no other H*W factorization fits all piece bboxes).     3. Pick one piece as legend. Embed a 2*2 palette of 4 distinct colors inside its body        (choose an interior 2*2 subregion fully surrounded by piece cells).     4. Assign 8 distinct non-zero colors: 4 for piece bodies, 4 for palette.     5. Build output grid by coloring each piece region with the palette color matching its        centroid's quadrant in the k*k grid.     6. To create input: extract each piece's shape (in its assembled orientation or any D4 variant),        paint it in its body color (legend gets body + palette embedded), and scatter all 4 pieces        onto a 20-26 square grid with black background, non-overlapping and well-separated.     ```  额外要求：原始代码的 `main()` 已包含四段式说明注释/文档字符串（开头概述 + `Input structure:` + `Rule:` + `Key insight:`）。 生成的新代码里也必须在 `main()` 上方保留这一结构，并根据**融合后的新规则**与**原注释提供的信息**重新编写；可以借鉴原注释的组织方式，但**不要照抄原文**，要让内容准确反映融合后的输入结构、规则和关键洞察。       ## 你的任务      1. **理解原代码**: 弄清 `main()` 和 `generate_input()` 的逻辑。      2. **阅读参考代码**（如有）: 上面列出的已有单变体代码是各组成项单独实现的版本，帮助你理解每项变更的实现方式。融合版本应综合参考但不能简单拼接。      3. **设计分析（写代码前必须完成）**:         综合「融合描述」和「各组成项详情」，将融合规则落实到代码层面。融合描述给出了整体的 input→output 规则，各组成项详情给出了每项改动的具体含义——两者结合才是完整的实现规格。如果上面提供了原始任务规格（Spec），请将其作为设计分析的重要参考——spec 详细描述了原始任务中各对象的结构、空间关系、生成策略等，理解这些细节有助于你准确判断融合改动的影响范围和实现方式。         a) **具体化与行为追踪**: 融合后的变体在 ARC 的像素网格中具体长什么样？用一个具体小例子追踪：原始逻辑在每个被改动的环节是怎么执行的 → 融合后应该怎么执行的 → 二者的差异是什么。         b) **复杂度校准**: 检查你的设计是否过于简化。过于简化会导致两个问题：一是容易产生冲突或重复（例如不同对象变得难以区分，匹配出现歧义），二是变体的视觉效果不明显，肉眼看不出和原任务的区别。同时不要让关键自由度过多；如果规则依赖少数档位、类别或对应关系，应控制在少量取值，并让它们在每个样例中有重复支撑。         c) **隐式假设审查**: 各组成项的改动可能破坏原代码中的哪些隐式假设？多项改动叠加后是否引入新的冲突？逐行检查 main() 中与变体相关的代码段：每行代码依赖了什么前提？这个前提在融合后是否仍然成立？         d) **放置合法性**: 生成器在放置对象时，必须保证各个体之间不重叠、不越界，且放置结果符合题意。         e) **视觉可观察性**: ARC 要求人类从 2-4 个 input→output 样例中肉眼推断规则。禁止使用任何人类不可视因素参与排序等操作（例如黑色=0，禁用）。做一次思想实验：假设你是解题者，看到几组变体生成的 input→output，能否看出融合后的规则？注意不要使用颜色值等人类不可视因素。如果变体的变化规律在2-3组像素网格上无法推出（例如对大量纯色对称对象做不同变换、无法从少量例子归纳颜色对应关系、不同情况的变换涉及正逆向旋转镜像等多种不同变化等，即全部的变化逻辑或者说是变化规律无法在3个输入输出示例对中体现），就需要调整设计使差异可观察。         f) **可视化整洁度**: 即使逻辑合理，如果可视化后的输出网格看上去乱七八糟也不行。检查：同一网格区域是否存在多种元素覆盖叠加导致无法分辨哪个是哪个？不同对象、区域、标记之间在视觉上是否能清晰区分？如果融合后的网格在视觉上杂乱不堪，需要调整设计（如减少同一区域的叠加层次、增大对象间距、简化标记方式等）。         g) **变化的可推断性**: 如果融合涉及颜色映射或颜色变化，务必确保颜色种类不宜过多，且颜色变化必须有足够的结构性线索（如位置、形状、分区等伴随特征）让人类能从少量样例中推断出颜色变化规则。避免出现大量颜色变化却无任何提示的情况——如果解题者无法从样例归纳出\"什么条件导致什么颜色\"，这个融合设计就         将以上分析写在代码注释中或输出中，然后再开始写代码。      4. **修改 `main()`**: 按照融合描述和各组成项详情实现新规则。确保各项改动在推理链中有真正的协同，不是各改各的。     5. **修改 `generate_input()`**: 确保生成的输入能正确触发融合后的新规则。     6. **保证 generator 的正确性**: 沿用 output-first 模式或适当调整，但必须保证每个输入经过新 `main()` 后不崩溃、不触发 assert、输出正确。     7. **测试**: 运行以下测试，确保成功率 ≥ 80%:      ```bash     /home/xd/miniconda3/bin/python -c \"     import numpy as np, importlib.util, time, sys     spec = importlib.util.spec_from_file_location('variant', '/home/lixinyu/snap/new/ceshi/code_combo/f560132c/24/code.py')     mod = importlib.util.module_from_spec(spec)     spec.loader.exec_module(mod)     ok, fail = 0, 0     t0 = time.time()     for i in range(50):         try:             inp = mod.generate_input()             out = mod.main(inp)             ok += 1         except Exception as e:             fail += 1             if fail <= 3: print(f'Trial {i}: {e}')     elapsed = time.time() - t0     print(f'Success: {ok}/50, Time: {elapsed:.1f}s ({elapsed/50*1000:.0f}ms/call)')     if ok < 40: sys.exit(1)     \"     ```      如果测试失败，分析错误原因，修改代码，重新测试。反复直到通过。      8. **验证融合行为确实发生**: `main(input)==output` 只能验证求解器不报错，无法验证输入是否真正体现了融合描述中的特征行为——退化为原始行为的输入同样能通过。测试通过后，定义一个量化指标衡量融合核心行为，统计生成样本中该指标的分布。只有当关键控制变量不起作用、样本按融合逻辑执行与按原逻辑执行在相同输入上输出相同结果时，才算退化并需要修正生成器。     9. **审查 `main()` 的新隐式假设**: 修改 `main()` 后，它可能对输入产生原始版本中不存在的新假设（如对象间需特定空间关系、匹配特征需可区分、处理顺序依赖前一步结果等）。逐一检查 `main()` 中的每个循环、匹配和条件分支：这段逻辑对输入做了什么假设？`generate_input()` 是否通过构造保证了这些假设？      ## 参考资源     - `/home/lixinyu/snap/new/solvers/arc_utils.py` — 可用的工具函数     - `/home/lixinyu/snap/new/ARC-data/ARC-AGI-2/data/evaluation/f560132c.json` — 原任务的 I/O 样例      ## 输出      将完整的融合变体代码（包含修改后的 `main()` 和 `generate_input()`）保存到:     `/home/lixinyu/snap/new/ceshi/code_combo/f560132c/24/code.py`      代码文件开头加一段注释说明这是什么融合变体:     ```python     # Combo variant of f560132c (index 24)     # combo_spec: D6/0+D12/2+D15/1     # Name: 原始网格输出+连接线轨迹+翻转输出     ```      如果原始代码的 `main()` 已有四段式说明注释/文档字符串，则新代码也必须在 `main()` 上方写出同结构的四部分说明：     1. 开头概述     2. `Input structure:`     3. `Rule:`     4. `Key insight:`      确保目录 `/home/lixinyu/snap/new/ceshi/code_combo/f560132c/24` 存在（如不存在则创建）。      - `/home/lixinyu/snap/new/arc2_solver_select/8b9c3697.py` — 参考任务 8b9c3697 的 solver（D12/2 的灵感来源）     - `/home/lixinyu/snap/new/arc2_solver_select/b10624e5.py` — 参考任务 b10624e5 的 solver（D15/1 的灵感来源） \n3218239       01:27 /home/lixinyu/.nvm/versions/node/v18.20.8/lib/node_modules/@openai/codex/node_modules/@openai/codex-linux-x64/vendor/x86_64-unknown-linux-musl/codex/codex exec --skip-git-repo-check -c model=\"gpt-5.4\" -c reasoning.effort=\"high\"     你要修改一个 ARC-AGI-2 任务的 solver 和 generator，实现一个**多维度融合变体**。      ## 原始任务: f560132c     **摘要**: 将散落的单色精灵根据形状匹配拼装为矩形复合体，并按2x2彩色图例中对应位置的颜色重新着色，输出紧凑裁剪      ## 要实现的融合组合     - **组合名称**: 线性色带+边缘图例+无框架识别     - **combo_spec**: D5/0+D8/1+D10/0      ### 融合描述（实现规格）      图例变为1x4线性色带排列在网格最外围一行上（D5/0+D8/1），且没有外围框架包裹（D10/0）， 仅靠其4个连续的不同颜色像素来识别。解题者需从边缘找到这个微小的线性图例， 再将1D色带映射到2D象限。三层变化共同改变了图例的形态、位置和识别方式。      ### 各组成项的原始变体详情      以下是 combo_spec 中每个组成项在维度分析 YAML 中的原始描述，帮助你理解每项改动的来源和细节：      - **D5/0** — 符号指令：图例的编码方式与结构 (`symbol_instructions`)   - 当前值: 图例精灵包含2x2彩色像素嵌入在单色框架中，每个像素的位置（左上、右上、左下、右下）映射到复合体中对应象限的重着色颜色   - 改为: 图例为线性色带而非2x2矩阵 — 图例从2x2矩阵变为1x4水平或4x1垂直色带，按从左到右或从上到下的顺序依次对应左上、右上、左下、右下象限。解题者需推断线性到二维的展开映射规则   - 来源: creative（参考任务: None） - **D8/1** — 图例与精灵的空间关系 (`meta`)   - 当前值: 图例精灵位于网格中固定区域（通常靠近左上角），与其他精灵在空间上分离，通过包含多色像素来区分   - 改为: 图例位于网格边缘一行/列 — 图例颜色排列在网格的最外围一行或一列上（如底部一行），用连续色段表示。图例位置从中心区域移到边缘，解题者需注意边缘信息而非仅关注中心精灵   - 来源: scaling（参考任务: c4d067a0） - **D10/0** — 精灵与框架色的区分方式 (`meta`)   - 当前值: 图例精灵有一个单色框架包裹2x2多色核心，框架色与其他精灵颜色不同，用于识别图例身份   - 改为: 图例无框架，靠形状区分 — 图例精灵没有外围框架，仅由2x2彩色像素构成（无包裹）。解题者必须通过尺寸极小（2x2）这一特征来识别图例，而非依赖框架存在与否   - 来源: inversion（参考任务: None）      ## 原始 solver + generator 代码      文件: `/home/lixinyu/snap/new/arc2_solver_select/f560132c.py`      ```python     import numpy as np  from arc_utils import bbox_coords, components_mask, get_bg, neighbors4, paste, random_free_location import math import random   def _factor_pairs(n: int) -> list[tuple[int, int]]:     out = []     for h in range(1, int(n**0.5) + 1):         if n % h == 0:             w = n // h             out.append((h, w))             if h != w:                 out.append((w, h))     return out   def _normalize_coords(coords: list[tuple[int, int]] | tuple[tuple[int, int], ...]) -> tuple[tuple[tuple[int, int], ...], int, int]:     rs = [r for r, _ in coords]     cs = [c for _, c in coords]     r0 = min(rs)     c0 = min(cs)     norm = tuple(sorted((r - r0, c - c0) for r, c in coords))     h = max(r for r, _ in norm) + 1     w = max(c for _, c in norm) + 1     return norm, int(h), int(w)   def _rot90(coords: tuple[tuple[int, int], ...]) -> tuple[tuple[tuple[int, int], ...], int, int]:     norm, h, w = _normalize_coords(coords)     rot = [(c, h - 1 - r) for r, c in norm]     return _normalize_coords(rot)   def _flip_h(coords: tuple[tuple[int, int], ...]) -> tuple[tuple[tuple[int, int], ...], int, int]:     norm, h, w = _normalize_coords(coords)     flp = [(r, w - 1 - c) for r, c in norm]     return _normalize_coords(flp)   def _dihedral_orientations(     coords: tuple[tuple[int, int], ...], ) -> list[tuple[tuple[tuple[int, int], ...], int, int, int, bool]]:     \"\"\"     Unique orientations under rotations + mirror (D4).     Returned as (coords, h, w, rot_k, flipped), where the transform is:       - if flipped: horizontal flip (mirror left-right)       - then rot_k times 90° clockwise rotation     coords are normalized to start at (0,0).     \"\"\"     seen: set[tuple[tuple[int, int], ...]] = set()     out: list[tuple[tuple[tuple[int, int], ...], int, int, int, bool]] = []     cur = coords     for rot_k in range(4):         c, h, w = _normalize_coords(cur)         if c not in seen:             seen.add(c)             out.append((c, h, w, int(rot_k), False))         cur = _rot90(cur)[0]     cur = _flip_h(coords)[0]     for rot_k in range(4):         c, h, w = _normalize_coords(cur)         if c not in seen:             seen.add(c)             out.append((c, h, w, int(rot_k), True))         cur = _rot90(cur)[0]     return out   def _extract_legend_map(g: np.ndarray, pts: np.ndarray, k: int) -> np.ndarray:     \"\"\"     Inside the legend component's bounding box, find a k×k color map block (may include 0).     We pick the k×k window with the maximum number of distinct colors; ties go to top-left.     \"\"\"     r0, c0, r1, c1 = bbox_coords(pts)     sub = g[r0 : r1 + 1, c0 : c1 + 1]     hh, ww = sub.shape     assert k > 0 and hh >= k and ww >= k, 'legend component must fit k×k map'     best = None  # (distinct, -rr, -cc)     best_rc = None     for rr in range(hh - k + 1):         for cc in range(ww - k + 1):             window = sub[rr : rr + k, cc : cc + k]             distinct = int(len(set(map(int, window.ravel()))))             key = (distinct, -rr, -cc)             if best is None or key > best:                 best = key                 best_rc = (rr, cc)     assert best_rc is not None, 'legend component must contain a valid k×k color map window'     rr, cc = best_rc     return np.asarray(sub[rr : rr + k, cc : cc + k], dtype=int).copy()   def _fill_holes_in_component(g: np.ndarray, pts: np.ndarray, bg: int) -> tuple[tuple[tuple[int, int], ...], int]:     \"\"\"     Treat background 'holes' fully enclosed inside the component bbox as part of the piece.     Returns (filled_pts, hole_count), where filled_pts is a sorted tuple of absolute coords.     \"\"\"     r0, c0, r1, c1 = bbox_coords(pts)     hh = r1 - r0 + 1     ww = c1 - c0 + 1     occ = np.zeros((hh, ww), dtype=bool)     for r, c in pts:         occ[r - r0, c - c0] = True      bgmask = ~occ     vis = np.zeros_like(bgmask, dtype=bool)     st: list[tuple[int, int]] = []      for rr in range(hh):         for cc in range(ww):             if rr in (0, hh - 1) or cc in (0, ww - 1):                 if bgmask[rr, cc] and not vis[rr, cc]:                     vis[rr, cc] = True                     st.append((rr, cc))                     while st:                         r, c = st.pop()                         for r2, c2 in neighbors4(r, c):                             if 0 <= r2 < hh and 0 <= c2 < ww and bgmask[r2, c2] and not vis[r2, c2]:                                 vis[r2, c2] = True                                 st.append((r2, c2))      holes = bgmask & ~vis     hole_coords = [(r0 + rr, c0 + cc) for rr, cc in zip(*np.where(holes))]     filled = tuple(sorted(set(map(tuple, pts)).union(hole_coords)))     return filled, int(holes.sum())   def _assemble_exact_cover(     pieces: list[dict],     legend_idx: int,     legend_map: np.ndarray,     k: int, ) -> np.ndarray:     \"\"\"     Tile all pieces into a full rectangle (no holes), allowing rotations + reflections.     Recolor each piece by quantizing its centroid into a k×k grid, using legend_map.     \"\"\"     total = sum(int(p[\"area\"]) for p in pieces)     max_h = max(max(h for _, h, _, _, _ in p[\"oris\"]) for p in pieces)     max_w = max(max(w for _, _, w, _, _ in p[\"oris\"]) for p in pieces)      dims = _factor_pairs(total)     dims = [(H, W) for (H, W) in dims if H >= max_h and W >= max_w]     assert len(dims) == 1, 'piece areas and bounds must imply a unique output rectangle'      for H, W in dims:         nbits = H * W         all_mask = (1 << nbits) - 1          # Precompute placements for non-legend pieces (legend is fixed at (0,0), but orientation varies).         other_pis = [i for i in range(len(pieces)) if i != legend_idx]         placements_other: list[list[tuple[int, int, int, tuple[tuple[int, int], ...]]]] = []         for pi in other_pis:             opts: list[tuple[int, int, int, tuple[tuple[int, int], ...]]] = []             for coords, ph, pw, _, _ in pieces[pi][\"oris\"]:                 for r0 in range(0, H - ph + 1):                     for c0 in range(0, W - pw + 1):                         m = 0                         for dr, dc in coords:                             idx = (int(r0) + int(dr)) * int(W) + (int(c0) + int(dc))                             m |= 1 << idx                         opts.append((m, int(r0), int(c0), coords))             placements_other.append(opts)          def solve_with_fixed_legend(             legend_coords: tuple[tuple[int, int], ...],         ) -> dict[int, tuple[int, int, int, tuple[tuple[int, int], ...]]] | None:             legend_mask = 0             for dr, dc in legend_coords:                 idx = int(dr) * int(W) + int(dc)                 legend_mask |= 1 << idx              filtered: list[list[tuple[int, int, int, tuple[tuple[int, int], ...]]]] = []             for opts in placements_other:                 filtered.append([pl for pl in opts if (pl[0] & legend_mask) == 0])              remaining = set(range(len(other_pis)))             chosen: dict[int, tuple[int, int, int, tuple[tuple[int, int], ...]]] = {                 legend_idx: (legend_mask, 0, 0, legend_coords)             }              def search(used: int) -> bool:                 if not remaining:                     return used == all_mask                 empty = (~used) & all_mask                 if empty == 0:                     return False                 cell = (empty & -empty).bit_length() - 1                 # Branch over *any* remaining piece that can cover this cell.                 # (Picking only one \"best\" piece can miss valid tilings.)                 candidates = []                 for k in sorted(remaining):                     opts_k = []                     for pl in filtered[k]:                         m = pl[0]                         if (m >> cell) & 1 and (m & used) == 0:                             opts_k.append(pl)                     if opts_k:                         candidates.append((len(opts_k), k, opts_k))                 if not candidates:                     return False                  candidates.sort(key=lambda x: (x[0], x[1]))                 for _, k, opts_k in candidates:                     remaining.remove(k)                     pi = other_pis[k]                     for pl in opts_k:                         chosen[pi] = pl                         if search(used | pl[0]):                             return True                     chosen.pop(pi, None)                     remaining.add(k)                 return False              if not search(legend_mask):                 return None             return chosen          # Try each possible legend orientation at (0,0).         chosen = None         for coords, ph, pw, _, _ in pieces[legend_idx][\"oris\"]:             assert ph <= H and pw <= W, 'legend orientation must fit the unique output rectangle'             sol = solve_with_fixed_legend(coords)             if sol is None:                 continue             chosen = sol             break         assert chosen is not None, 'exact-cover assembly failed: no valid legend orientation'          # Determine legend-map cell for each piece by centroid.         piece_cell: dict[int, tuple[int, int]] = {}         for pi, pl in chosen.items():             _, r0, c0, coords = pl             # centroid: average over occupied cells             rs = [r0 + dr for dr, _ in coords]             cs = [c0 + dc for _, dc in coords]             cr = float(sum(rs)) / float(len(rs))             cc = float(sum(cs)) / float(len(cs))             rr = int(cr * float(k) / float(H))             cc2 = int(cc * float(k) / float(W))             rr = max(0, min(int(k) - 1, rr))             cc2 = max(0, min(int(k) - 1, cc2))             piece_cell[pi] = (rr, cc2)          # Build final output.         out = np.zeros((H, W), dtype=int)         for pi, pl in chosen.items():             _, r0, c0, coords = pl             rr, cc2 = piece_cell[pi]             col = int(legend_map[rr, cc2])             for dr, dc in coords:                 out[r0 + dr, c0 + dc] = col         return out   def main(grid: np.ndarray) -> np.ndarray:     \"\"\"     Assemble scattered jigsaw pieces into a rectangle, recoloring each by a legend sprite's color map.      Input structure:     - bg = most common color.     - Several monochrome non-bg sprites (the \"pieces\"), scattered across the grid.     - One sprite is the legend: it contains a multi-color k×k patch (typically 2×2) encoding output colors.      Rule:     - Tile all pieces (rotations/reflections allowed) into a tight rectangle with no gaps.     - The legend's k×k color patch defines a spatial color map over the rectangle.     - Each piece is recolored to the legend-map color corresponding to its position in the assembled rectangle.      Key insight: The legend piece doubles as both a jigsaw piece and a color key — its internal k×k palette assigns colors by spatial quadrant.     \"\"\"     g = np.asarray(grid, dtype=int)     bg = get_bg(g)      comps = components_mask(g != bg, connectivity=4)     assert comps, 'grid must contain at least one non-background component'      # Identify legend component (most distinct colors) and infer k from number of pieces.     k = int(round(len(comps) ** 0.5))     assert k * k == len(comps), 'piece count must be a perfect square to determine k'      comp_colors = []     for pts in comps:         cols = set(int(g[r, c]) for r, c in pts if int(g[r, c]) != bg)         comp_colors.append(cols)      max_distinct = max(len(cols) for cols in comp_colors)     legend_candidates = [i for i, cols in enumerate(comp_colors) if len(cols) == max_distinct]     assert len(legend_candidates) == 1, 'legend component must be uniquely identified by distinct colors'     legend_idx = legend_candidates[0]     legend_map = _extract_legend_map(g, comps[legend_idx], k)      # Build piece masks (coords in bbox space), including filled holes.     pieces: list[dict] = []     for pts in comps:         filled_abs, _ = _fill_holes_in_component(g, pts, bg)         r0, c0, _, _ = bbox_coords(np.asarray(list(filled_abs)))         rel = tuple((r - r0, c - c0) for r, c in filled_abs)         rel_norm, _, _ = _normalize_coords(rel)         oris = _dihedral_orientations(rel_norm)         pieces.append({\"oris\": oris, \"area\": len(filled_abs)})      return _assemble_exact_cover(pieces, legend_idx, legend_map, k)  # --------------- generator (o5x) ---------------  # === CFG === SIDE_CHOICES = [8, 10, 12]                     # output square side lengths K = 2                                          # k*k quadrant grid (2*2 = 4 pieces) NUM_PIECES = K * K                             # total jigsaw pieces NUM_COLORS = 8                                 # 4 body + 4 palette, all distinct non-bg AREA_FRAC_LO = 0.08                           # min piece area as fraction of total AREA_FRAC_HI = 0.43                           # max piece area as fraction of total AREA_ABS_LO = 11                              # absolute min piece area (cells) AREA_ABS_HI = 62                              # absolute max piece area (cells) LEGEND_THRESHOLD = {8: 4, 10: 5, 12: 9}       # min extent threshold per side for legend L-shape LEGEND_CORE_SIZE = 4                           # legend always has a 4x4 filled corner block LEGEND_ARM_RANGE = range(1, 4)                 # arm width/height options for L-shape construction PARTITION_GROWTH_EXP = 1.45                    # exponent penalizing large regions during partition PARTITION_FRONTIER_EXP = 0.2                   # exponent boosting regions with wide frontiers PARTITION_SEED_JITTER = 0.2                    # random jitter when selecting seed cells INPUT_SIZE_LO = 20                             # min input grid side INPUT_SIZE_HI = 26                             # max input grid side DENSITY_LO = 0.15                              # min non-bg density target DENSITY_HI = 0.25                              # max non-bg density target SCATTER_BORDER = 1                             # border margin when placing pieces SCATTER_PADDING = 1                            # gap between piece bounding boxes GEN_RETRIES = 300                              # max attempts in generate_input()   def _area_bounds(side):     \"\"\"Min/max piece area for a given output side length.\"\"\"     total = side * side     return max(AREA_ABS_LO, math.ceil(AREA_FRAC_LO * total)), min(AREA_ABS_HI, math.floor(AREA_FRAC_HI * total))   def _has_hole(mask):     \"\"\"Return True if the mask contains an interior hole (bg region not touching the bbox edge).\"\"\"     pts = np.argwhere(mask)     if len(pts) == 0:         return True     r0, c0, r1, c1 = bbox_coords(pts)     sub = mask[r0 : r1 + 1, c0 : c1 + 1]     empty = ~sub     if not empty.any():         return False     for comp in components_mask(empty, connectivity=4):         if not (np.any(comp[:, 0] == 0) or np.any(comp[:, 0] == sub.shape[0] - 1)                 or np.any(comp[:, 1] == 0) or np.any(comp[:, 1] == sub.shape[1] - 1)):             return True     return False   def _forces_unique_square(masks, side):     \"\"\"Check that piece bbox dims force a unique S*S factorization of total area.\"\"\"     bbs = [bbox_coords(np.argwhere(m)) for m in masks]     max_h = max(r1 - r0 + 1 for r0, _, r1, _ in bbs)     max_w = max(c1 - c0 + 1 for _, c0, _, c1 in bbs)     dims = [(h, w) for h, w in _factor_pairs(side * side) if h >= max_h and w >= max_w]     return dims == [(side, side)]   def _make_legend_mask(side, min_area, max_area):     \"\"\"Build an L-shaped legend piece mask anchored at (0,0) of the side*side grid.\"\"\"     threshold = LEGEND_THRESHOLD[side]     opts = []     for h0 in range(threshold + 1, side + 1):         for w0 in range(threshold + 1, side + 1):             for arm_w in LEGEND_ARM_RANGE:                 for arm_h in LEGEND_ARM_RANGE:                     mask = np.zeros((side, side), dtype=bool)                     mask[:LEGEND_CORE_SIZE, :LEGEND_CORE_SIZE] = True                     mask[:arm_h, :w0] = True                     mask[:h0, :arm_w] = True                     area = int(mask.sum())                     if min_area <= area <= max_area:                         opts.append(mask)     return random.choice(opts).copy()   def _partition_rest(rest):     \"\"\"Flood-fill partition the complement of the legend into 3 connected regions.\"\"\"     side = rest.shape[0]     labels = np.full((side, side), -1, dtype=int)     available = set(map(tuple, np.argwhere(rest)))     anchors = [         (random.randint(0, side // 3), side - 1),         (side - 1, random.randint(0, side // 3)),         (side - 1, side - 1),     ]      seeds = []     for ar, ac in anchors:         seed = min(available, key=lambda p: abs(p[0] - ar) + abs(p[1] - ac) + random.random() * PARTITION_SEED_JITTER)         seeds.append(seed)         available.remove(seed)      areas = [0, 0, 0]     frontiers = [set() for _ in range(3)]      def add_frontier(i, r, c):         for rr, cc in neighbors4(r, c):             if 0 <= rr < side and 0 <= cc < side and rest[rr, cc] and labels[rr, cc] < 0:                 frontiers[i].add((rr, cc))      for i, seed in enumerate(seeds):         labels[seed] = i         areas[i] = 1         add_frontier(i, seed[0], seed[1])      unassigned = int(rest.sum()) - len(seeds)     while unassigned:         candidates = []         for i in range(3):             frontiers[i] = {p for p in frontiers[i] if labels[p] < 0}             if frontiers[i]:                 candidates.append(i)         if not candidates:             return None          weights = [(1.0 / (areas[i] ** PARTITION_GROWTH_EXP)) * (len(frontiers[i]) ** PARTITION_FRONTIER_EXP)                     for i in candidates]         i = random.choices(candidates, weights=weights, k=1)[0]         cell = random.choice(tuple(frontiers[i]))         frontiers[i].discard(cell)         labels[cell] = i         areas[i] += 1         unassigned -= 1         add_frontier(i, cell[0], cell[1])      return labels   def _crop_mask(mask):     \"\"\"Crop a boolean mask to its bounding box.\"\"\"     r0, c0, r1, c1 = bbox_coords(np.argwhere(mask))     return mask[r0 : r1 + 1, c0 : c1 + 1]   def _random_orientation(mask):     \"\"\"Return a random D4 orientation of the cropped mask (unique shapes only).\"\"\"     arr = mask.astype(int)     opts = []     seen = set()     for k in range(4):         rot = np.rot90(arr, k)         for oriented in (rot, np.fliplr(rot)):             r0, c0, r1, c1 = bbox_coords(np.argwhere(oriented > 0))             crop = oriented[r0 : r1 + 1, c0 : c1 + 1].astype(bool)             key = (crop.shape, tuple(crop.ravel()))             if key not in seen:                 seen.add(key)                 opts.append(crop)     return random.choice(opts)   def _palette_spots(mask):     \"\"\"Find valid 2x2 palette embedding positions (fully surrounded by piece cells).\"\"\"     spots = []     h, w = mask.shape     for r in range(1, h - K):         for c in range(1, w - K):             if mask[r : r + K, c : c + K].all() and mask[r - 1 : r + K + 1, c - 1 : c + K + 1].all():                 spots.append((r, c))     return spots   def _scatter_pieces(masks, body_colors, legend_map, side):     \"\"\"Place all pieces on a random-sized input grid with separation.\"\"\"     total = side * side     nlo = max(INPUT_SIZE_LO, math.ceil(math.sqrt(total / DENSITY_HI)))     nhi = min(INPUT_SIZE_HI, math.floor(math.sqrt(total / DENSITY_LO)))     grid_size = random.randint(nlo, nhi)     grid = np.zeros((grid_size, grid_size), dtype=int)     occupied = np.zeros_like(grid)      for pi in random.sample(range(NUM_PIECES), NUM_PIECES):         oriented = _crop_mask(masks[pi]) if pi == 0 else _random_orientation(_crop_mask(masks[pi]))         patch = np.zeros(oriented.shape, dtype=int)         patch[oriented] = body_colors[pi]         if pi == 0:             spots = _palette_spots(oriented)             if not spots:                 return None             r, c = random.choice(spots)             patch[r : r + K, c : c + K] = legend_map         try:             box = np.ones(oriented.shape, dtype=int)             r0, c0 = random_free_location(occupied, box, transparent=0,                                            border=SCATTER_BORDER, padding=SCATTER_PADDING, padding_connectivity=8)         except ValueError:             return None         occupied[r0 : r0 + oriented.shape[0], c0 : c0 + oriented.shape[1]] = 1         paste(grid, patch, r0, c0, transparent=0)     return grid   def _gen_attempt():     \"\"\"Single generation attempt: build tiling, validate, scatter pieces.\"\"\"     side = random.choice(SIDE_CHOICES)     min_area, max_area = _area_bounds(side)     legend = _make_legend_mask(side, min_area, max_area)     labels = _partition_rest(~legend)     if labels is None:         return None      masks = [legend] + [labels == i for i in range(3)]     areas = [int(m.sum()) for m in masks]     if any(a < min_area or a > max_area for a in areas):         return None     if any(len(components_mask(m, connectivity=4)) != 1 or _has_hole(m) for m in masks):         return None     if not _forces_unique_square(masks, side):         return None      # Compute centroid quadrant for each piece; all 4 must be distinct.     qcells = []     for mask in masks:         pts = np.argwhere(mask)         qcells.append((min(1, int(pts[:, 0].mean() * K / side)), min(1, int(pts[:, 1].mean() * K / side))))     if len(set(qcells)) != NUM_PIECES:         return None      colors = random.sample(range(1, 10), NUM_COLORS)     body_colors = colors[:NUM_PIECES]     palette_colors = colors[NUM_PIECES:]     random.shuffle(palette_colors)     legend_map = np.array(palette_colors, dtype=int).reshape(K, K)      expected = np.zeros((side, side), dtype=int)     for pi, mask in enumerate(masks):         rr, cc = qcells[pi]         expected[mask] = legend_map[rr, cc]      grid = _scatter_pieces(masks, body_colors, legend_map, side)     if grid is None:         return None     if not np.array_equal(main(grid), expected):         return None     return grid   def generate_input():     for _ in range(GEN_RETRIES):         grid = _gen_attempt()         if grid is not None:             return grid     raise RuntimeError('failed to generate f560132c input')      ```      ## 原始任务规格（Spec）      以下是从原始 solver 代码和示例中提炼的完整任务规格，包含精确的数值约束和生成策略。     Spec 本身就是原题代码生成时的参考文件，因此：     - 在**设计分析**阶段，参考 spec 理解原始任务的完整设计细节（对象结构、空间关系、生成策略等），以此为基础思考融合变体的改动如何落实     - 在**实现**阶段，参考 spec 中的数值约束（网格尺寸、对象数量/尺寸、颜色数等），确保融合变体在物理上可实现      ```yaml     spec:   task: Assemble k*k jigsaw pieces into a rectangle; recolor each by a legend's k*k color map based on centroid position.   k: 2 (4 pieces; k = sqrt(num_pieces))   output_rectangle:     shape: square, side 8-12, always even [observed]     area: sum of all 4 piece areas; factor pairs must yield a unique valid rectangle given piece bbox dims   pieces:     count: 4 (= k*k)     type: 4-connected polyominoes, simply connected (no internal holes)     areas: 11-62 cells; each piece 8-43% of total area     constraint: must tile the output rectangle exactly (no gaps/overlaps) under D4 transformations   legend_piece:     one of the 4 pieces; identified by having >1 color     body: single color filling the piece shape     palette: k*k (2*2) block of 4 distinct colors embedded inside the body, none equal to body color     palette_position: within the piece's bounding box (not at edge), surrounded by body-colored cells   colors:     background: 0     total_non_bg: 8 (4 piece-body colors + 4 palette colors), all mutually distinct     piece_body_colors: 4 distinct colors from 1-9, disjoint from palette colors     palette_colors: 4 distinct colors from 1-9, disjoint from piece-body colors   input_grid:     size: 20-26 rows x 20-26 cols     pieces scattered with >= 0 row/col gap between bounding boxes     non-bg density: 15-25%   transformation:     tile all pieces into the unique output rectangle (rotations/reflections allowed)     legend piece anchored at (0,0)     each piece recolored to palette color by quantizing its centroid into the k*k grid of the rectangle  generation_strategy:   approach: output-first (build tiling, then scatter pieces to create input)   steps:     1. Choose output side S in {8, 10, 12}; rectangle is S*S.     2. Generate a valid exact-cover tiling of the S*S square with 4 simply-connected polyominoes.        Method -- iterative random partition via flood-fill or cut-based dissection ensuring        each piece is 4-connected and has area >= 8, and the resulting factor pair is unique        (no other H*W factorization fits all piece bboxes).     3. Pick one piece as legend. Embed a 2*2 palette of 4 distinct colors inside its body        (choose an interior 2*2 subregion fully surrounded by piece cells).     4. Assign 8 distinct non-zero colors: 4 for piece bodies, 4 for palette.     5. Build output grid by coloring each piece region with the palette color matching its        centroid's quadrant in the k*k grid.     6. To create input: extract each piece's shape (in its assembled orientation or any D4 variant),        paint it in its body color (legend gets body + palette embedded), and scatter all 4 pieces        onto a 20-26 square grid with black background, non-overlapping and well-separated.     ```  额外要求：原始代码的 `main()` 已包含四段式说明注释/文档字符串（开头概述 + `Input structure:` + `Rule:` + `Key insight:`）。 生成的新代码里也必须在 `main()` 上方保留这一结构，并根据**融合后的新规则**与**原注释提供的信息**重新编写；可以借鉴原注释的组织方式，但**不要照抄原文**，要让内容准确反映融合后的输入结构、规则和关键洞察。   ## 已有单变体参考代码  以下组成项已有单变体实现，可作为融合时的参考：              ### 参考代码: D5/0              文件: `/home/lixinyu/snap/new/ceshi/code/f560132c/D5/0/code.py`              ```python             # Variant of f560132c # Dimension: D5 — 符号指令：图例的编码方式与结构 (symbol_instructions) # Change: 图例精灵包含2x2彩色像素嵌入在单色框架中，每个像素的位置（左上、右上、左下、右下）映射到复合体中对应象限的重着色颜色... → 图例为线性色带而非2x2矩阵  \"\"\" design_analysis:   concretization_and_trace:     input_look:       - 仍然是 4 个散落的 4 连通拼块，其中恰有 1 个图例块包含多种颜色。       - 原题图例块内部是 2x2 彩色小方阵；本变体改成 4 格直线色带，可能是 1x4 水平条，也可能是 4x1 竖直条。       - 色带四格的可见顺序固定为 TL, TR, BL, BR；若为水平条就按从左到右读取，若为竖直条就按从上到下读取。       - 输出仍然是将 4 块恰好拼成正方形后，按每块质心落入的 2x2 象限进行统一重着色。     behavior_trace:       original:         - solver 在图例 bbox 内滑动搜索 2x2 窗口，直接把窗口像素当作 [[TL,TR],[BL,BR]]。       variant:         - solver 改为搜索长度为 4 的水平/竖直窗口。         - 找到色带后先读出线性序列 [c0,c1,c2,c3]。         - 再显式展开成 [[c0,c1],[c2,c3]]，随后沿用原来的 exact-cover + centroid 象限着色。       difference:         - 变化只发生在“图例解码”环节；拼图装配、象限判定、输出裁剪逻辑不变。   complexity_calibration:     - 仍只保留两种可见编码档位：水平色带或竖直色带，避免引入过多自由度。     - 每个样例里色带长度恒为 4，并且四种颜色互异，保证人眼能看到“线性顺序展开到 2x2”的稳定规律。     - 若继续允许 2x2 方阵，就会退化回原题；因此 generator 只嵌入线性色带。   implicit_assumption_audit:     original_main_dependencies:       - \"_extract_legend_map(..., k) 依赖图例里存在 kxk 彩色块。变体下此假设失效，必须换成 1x(k*k) / (k*k)x1 搜索。\"       - \"legend_map 直接按二维索引使用，原题的二维布局天然可读；变体下必须先做线性到二维的展开。\"       - \"原 generator 不旋转图例块，因此 solver 读取到的图例朝向就是规范朝向。这个隐式前提原题中对 2x2 方阵几乎不可见，但对线性色带非常关键。\"     retained_assumptions:       - 仍假设图例块在输入中保持规范朝向；否则线性色带在旋转/镜像后会产生顺序翻转，solver 需要额外恢复姿态，这已超出本次 D5 最小变更。       - generator 通过不随机旋转图例块来保证该前提成立。   placement_legality:     - 色带只能放在图例块 bbox 的内部位置，且其外侧一圈仍属于该拼块，从而四个彩色像素与图例主体保持同一连通分量。     - 水平条要求存在 3x6 全填充区域；竖直条要求存在 6x3 全填充区域。generator 只选择满足对应条件的图例形状和放置点。     - 散落放置时继续使用 random_free_location，保证组件互不重叠、不中断、不过界。   visual_observability:     - 变体最显著的视觉差异就是图例不再是 2x2 色块，而是一条 4 格直线；这一点在 2-3 个样例上肉眼即可稳定观察。     - 水平/竖直两种方向都会出现，促使解题者归纳“按可见阅读顺序展开”为 2x2 象限，而不是把方向当成无意义扰动。   visual_cleanliness:     - 仍然只有一层“主体色 + 内嵌图例色”的叠加，图例块内部结构简单，不会与其余散落拼块发生视觉缠绕。     - 色带被限制在图例块内部而不是贴边，避免看起来像独立的小组件。   color_inference:     - 仍使用 4 个主体色 + 4 个图例色，总颜色复杂度与原题相同。     - 四个图例色的排序完全由可见位置（左到右 / 上到下）决定，不使用颜色 id、面积、排序等不可见因素。   post_change_main_assumptions:     - solver 假设图例组件中最常见的非背景色是主体色；generator 通过“主体面积远大于 4 个图例像素”保证这一点。     - solver 假设恰有一个不含主体色且拥有 4 个互异颜色的长度 4 窗口；generator 通过内部嵌入单条色带保证这一点。 \"\"\"  import math import random import sys from collections import Counter  import numpy as np  if \"/home/lixinyu/snap/new/solvers\" not in sys.path:     sys.path.append(\"/home/lixinyu/snap/new/solvers\")  from arc_utils import bbox_coords, components_mask, get_bg, neighbors4, paste, random_free_location   def _factor_pairs(n: int) -> list[tuple[int, int]]:     out = []     for h in range(1, int(n**0.5) + 1):         if n % h == 0:             w = n // h             out.append((h, w))             if h != w:                 out.append((w, h))     return out   def _normalize_coords(     coords: list[tuple[int, int]] | tuple[tuple[int, int], ...] ) -> tuple[tuple[tuple[int, int], ...], int, int]:     rs = [r for r, _ in coords]     cs = [c for _, c in coords]     r0 = min(rs)     c0 = min(cs)     norm = tuple(sorted((r - r0, c - c0) for r, c in coords))     h = max(r for r, _ in norm) + 1     w = max(c for _, c in norm) + 1     return norm, int(h), int(w)   def _rot90(coords: tuple[tuple[int, int], ...]) -> tuple[tuple[tuple[int, int], ...], int, int]:     norm, h, _ = _normalize_coords(coords)     rot = [(c, h - 1 - r) for r, c in norm]     return _normalize_coords(rot)   def _flip_h(coords: tuple[tuple[int, int], ...]) -> tuple[tuple[tuple[int, int], ...], int, int]:     norm, _, w = _normalize_coords(coords)     flp = [(r, w - 1 - c) for r, c in norm]     return _normalize_coords(flp)   def _dihedral_orientations(     coords: tuple[tuple[int, int], ...], ) -> list[tuple[tuple[tuple[int, int], ...], int, int, int, bool]]:     \"\"\"     Unique orientations under rotations + mirror (D4).     Returned as (coords, h, w, rot_k, flipped), where the transform is:       - if flipped: horizontal flip (mirror left-right)       - then rot_k times 90° clockwise rotation     coords are normalized to start at (0,0).     \"\"\"     seen: set[tuple[tuple[int, int], ...]] = set()     out: list[tuple[tuple[tuple[int, int], ...], int, int, int, bool]] = []     cur = coords     for rot_k in range(4):         c, h, w = _normalize_coords(cur)         if c not in seen:             seen.add(c)             out.append((c, h, w, int(rot_k), False))         cur = _rot90(cur)[0]     cur = _flip_h(coords)[0]     for rot_k in range(4):         c, h, w = _normalize_coords(cur)         if c not in seen:             seen.add(c)             out.append((c, h, w, int(rot_k), True))         cur = _rot90(cur)[0]     return out   def _extract_legend_sequence(g: np.ndarray, pts: np.ndarray, seq_len: int) -> np.ndarray:     \"\"\"     Inside the legend component bbox, find a 1xN or Nx1 color strip.     Preference: a strip made entirely of non-body colors with maximal color diversity.     Ties go to topmost, then leftmost, then horizontal before vertical.     \"\"\"     r0, c0, r1, c1 = bbox_coords(pts)     sub = g[r0 : r1 + 1, c0 : c1 + 1]     hh, ww = sub.shape     assert seq_len > 0 and (hh >= seq_len or ww >= seq_len), \"legend component must fit a linear color strip\"      comp_vals = [int(g[r, c]) for r, c in pts]     body_color = Counter(comp_vals).most_common(1)[0][0]      best_key = None     best_seq = None     for orient, rr, cc in _legend_strip_windows(sub, seq_len):         if orient == \"h\":             window = sub[rr, cc : cc + seq_len]         else:             window = sub[rr : rr + seq_len, cc]         vals = [int(x) for x in window]         distinct = len(set(vals))         body_hits = sum(int(v == body_color) for v in vals)         key = (-body_hits, distinct, -rr, -cc, int(orient == \"h\"))         if best_key is None or key > best_key:             best_key = key             best_seq = vals      assert best_seq is not None, \"legend component must contain a valid linear color strip\"     assert len(set(best_seq)) == seq_len, \"legend strip must expose four distinct colors\"     return np.asarray(best_seq, dtype=int)   def _legend_strip_windows(sub: np.ndarray, seq_len: int) -> list[tuple[str, int, int]]:     hh, ww = sub.shape     out: list[tuple[str, int, int]] = []     if ww >= seq_len:         for rr in range(hh):             for cc in range(ww - seq_len + 1):                 out.append((\"h\", rr, cc))     if hh >= seq_len:         for rr in range(hh - seq_len + 1):             for cc in range(ww):                 out.append((\"v\", rr, cc))     return out   def _sequence_to_legend_map(seq: np.ndarray, k: int) -> np.ndarray:     assert int(seq.size) == k * k, \"linear legend sequence must have k*k entries\"     flat = [int(x) for x in np.asarray(seq, dtype=int).ravel()]     return np.asarray([[flat[0], flat[1]], [flat[2], flat[3]]], dtype=int)   def _fill_holes_in_component(g: np.ndarray, pts: np.ndarray, bg: int) -> tuple[tuple[tuple[int, int], ...], int]:     \"\"\"     Treat background 'holes' fully enclosed inside the component bbox as part of the piece.     Returns (filled_pts, hole_count), where filled_pts is a sorted tuple of absolute coords.     \"\"\"     r0, c0, r1, c1 = bbox_coords(pts)     hh = r1 - r0 + 1     ww = c1 - c0 + 1     occ = np.zeros((hh, ww), dtype=bool)     for r, c in pts:         occ[r - r0, c - c0] = True      bgmask = ~occ     vis = np.zeros_like(bgmask, dtype=bool)     st: list[tuple[int, int]] = []      for rr in range(hh):         for cc in range(ww):             if rr in (0, hh - 1) or cc in (0, ww - 1):                 if bgmask[rr, cc] and not vis[rr, cc]:                     vis[rr, cc] = True                     st.append((rr, cc))                     while st:                         r, c = st.pop()                         for r2, c2 in neighbors4(r, c):                             if 0 <= r2 < hh and 0 <= c2 < ww and bgmask[r2, c2] and not vis[r2, c2]:                                 vis[r2, c2] = True                                 st.append((r2, c2))      holes = bgmask & ~vis     hole_coords = [(r0 + rr, c0 + cc) for rr, cc in zip(*np.where(holes))]     filled = tuple(sorted(set(map(tuple, pts)).union(hole_coords)))     return filled, int(holes.sum())   def _assemble_exact_cover(     pieces: list[dict],     legend_idx: int,     legend_map: np.ndarray,     k: int, ) -> np.ndarray:     \"\"\"     Tile all pieces into a full rectangle (no holes), allowing rotations + reflections.     Recolor each piece by quantizing its centroid into a k×k grid, using legend_map.     \"\"\"     total = sum(int(p[\"area\"]) for p in pieces)     max_h = max(max(h for _, h, _, _, _ in p[\"oris\"]) for p in pieces)     max_w = max(max(w for _, _, w, _, _ in p[\"oris\"]) for p in pieces)      dims = _factor_pairs(total)     dims = [(H, W) for (H, W) in dims if H >= max_h and W >= max_w]     assert len(dims) == 1, \"piece areas and bounds must imply a unique output rectangle\"      for H, W in dims:         nbits = H * W         all_mask = (1 << nbits) - 1          other_pis = [i for i in range(len(pieces)) if i != legend_idx]         placements_other: list[list[tuple[int, int, int, tuple[tuple[int, int], ...]]]] = []         for pi in other_pis:             opts: list[tuple[int, int, int, tuple[tuple[int, int], ...]]] = []             for coords, ph, pw, _, _ in pieces[pi][\"oris\"]:                 for r0 in range(0, H - ph + 1):                     for c0 in range(0, W - pw + 1):                         m = 0                         for dr, dc in coords:                             idx = (int(r0) + int(dr)) * int(W) + (int(c0) + int(dc))                             m |= 1 << idx                         opts.append((m, int(r0), int(c0), coords))             placements_other.append(opts)          def solve_with_fixed_legend(             legend_coords: tuple[tuple[int, int], ...],         ) -> dict[int, tuple[int, int, int, tuple[tuple[int, int], ...]]] | None:             legend_mask = 0             for dr, dc in legend_coords:                 idx = int(dr) * int(W) + int(dc)                 legend_mask |= 1 << idx              filtered: list[list[tuple[int, int, int, tuple[tuple[int, int], ...]]]] = []             for opts in placements_other:                 filtered.append([pl for pl in opts if (pl[0] & legend_mask) == 0])              remaining = set(range(len(other_pis)))             chosen: dict[int, tuple[int, int, int, tuple[tuple[int, int], ...]]] = {                 legend_idx: (legend_mask, 0, 0, legend_coords)             }              def search(used: int) -> bool:                 if not remaining:                     return used == all_mask                 empty = (~used) & all_mask                 if empty == 0:                     return False                 cell = (empty & -empty).bit_length() - 1                 candidates = []                 for k2 in sorted(remaining):                     opts_k = []                     for pl in filtered[k2]:                         m = pl[0]                         if (m >> cell) & 1 and (m & used) == 0:                             opts_k.append(pl)                     if opts_k:                         candidates.append((len(opts_k), k2, opts_k))                 if not candidates:                     return False                  candidates.sort(key=lambda x: (x[0], x[1]))                 for _, k2, opts_k in candidates:                     remaining.remove(k2)                     pi = other_pis[k2]                     for pl in opts_k:                         chosen[pi] = pl                         if search(used | pl[0]):                             return True                     chosen.pop(pi, None)                     remaining.add(k2)                 return False              if not search(legend_mask):                 return None             return chosen          chosen = None         for coords, ph, pw, _, _ in pieces[legend_idx][\"oris\"]:             assert ph <= H and pw <= W, \"legend orientation must fit the unique output rectangle\"             sol = solve_with_fixed_legend(coords)             if sol is None:                 continue             chosen = sol             break         assert chosen is not None, \"exact-cover assembly failed: no valid legend orientation\"          piece_cell: dict[int, tuple[int, int]] = {}         for pi, pl in chosen.items():             _, r0, c0, coords = pl             rs = [r0 + dr for dr, _ in coords]             cs = [c0 + dc for _, dc in coords]             cr = float(sum(rs)) / float(len(rs))             cc = float(sum(cs)) / float(len(cs))             rr = int(cr * float(k) / float(H))             cc2 = int(cc * float(k) / float(W))             rr = max(0, min(int(k) - 1, rr))             cc2 = max(0, min(int(k) - 1, cc2))             piece_cell[pi] = (rr, cc2)          out = np.zeros((H, W), dtype=int)         for pi, pl in chosen.items():             _, r0, c0, coords = pl             rr, cc2 = piece_cell[pi]             col = int(legend_map[rr, cc2])             for dr, dc in coords:                 out[r0 + dr, c0 + dc] = col         return out      raise AssertionError(\"unreachable rectangle assembly branch\")   def main(grid: np.ndarray) -> np.ndarray:     \"\"\"     Assemble scattered jigsaw pieces into a rectangle, recoloring each from a legend sprite's linear palette strip.      Input structure:     - bg is the most common color.     - Four scattered non-bg sprites act as jigsaw pieces; one of them is the legend and has multiple colors.     - The legend does not contain a 2x2 palette block anymore: instead it hides a 1x4 horizontal strip or 4x1 vertical strip of four distinct colors inside a monochrome frame.      Rule:     - Reassemble all pieces into the unique tight rectangle, allowing rotations and reflections for the tiling step.     - Read the legend strip in visible order: left-to-right for a horizontal strip, top-to-bottom for a vertical strip.     - Expand that linear order into quadrant colors [TL, TR, BL, BR], then recolor each assembled piece by the color of the quadrant containing its centroid.      Key insight:     - The only new reasoning step is decoding a 1D legend into the same 2x2 spatial palette the original puzzle used; once unfolded, the rest of the assembly logic is unchanged.     \"\"\"     g = np.asarray(grid, dtype=int)     bg = get_bg(g)      comps = components_mask(g != bg, connectivity=4)     assert comps, \"grid must contain at least one non-background component\"      k = int(round(len(comps) ** 0.5))     assert k * k == len(comps), \"piece count must be a perfect square to determine k\"      comp_colors = []     for pts in comps:         cols = set(int(g[r, c]) for r, c in pts if int(g[r, c]) != bg)         comp_colors.append(cols)      max_distinct = max(len(cols) for cols in comp_colors)     legend_candidates = [i for i, cols in enumerate(comp_colors) if len(cols) == max_distinct]     assert len(legend_candidates) == 1, \"legend component must be uniquely identified by distinct colors\"     legend_idx = legend_candidates[0]      legend_seq = _extract_legend_sequence(g, comps[legend_idx], k * k)     legend_map = _sequence_to_legend_map(legend_seq, k)      pieces: list[dict] = []     for pts in comps:         filled_abs, _ = _fill_holes_in_component(g, pts, bg)         r0, c0, _, _ = bbox_coords(np.asarray(list(filled_abs)))         rel = tuple((r - r0, c - c0) for r, c in filled_abs)         rel_norm, _, _ = _normalize_coords(rel)         oris = _dihedral_orientations(rel_norm)         pieces.append({\"oris\": oris, \"area\": len(filled_abs)})      return _assemble_exact_cover(pieces, legend_idx, legend_map, k)   # --------------- generator (o5x) ---------------  # === CFG === SIDE_CHOICES = [8, 10, 12] K = 2 NUM_PIECES = K * K NUM_COLORS = 8 AREA_FRAC_LO = 0.08 AREA_FRAC_HI = 0.43 AREA_ABS_LO = 11 AREA_ABS_HI = 62 LEGEND_THRESHOLD = {8: 4, 10: 5, 12: 9} LEGEND_CORE_SIZE = 4 LEGEND_ARM_RANGE = range(1, 4) LEGEND_STRIP_LEN = NUM_PIECES PARTITION_GROWTH_EXP = 1.45 PARTITION_FRONTIER_EXP = 0.2 PARTITION_SEED_JITTER = 0.2 INPUT_SIZE_LO = 20 INPUT_SIZE_HI = 26 DENSITY_LO = 0.15 DENSITY_HI = 0.25 SCATTER_BORDER = 1 SCATTER_PADDING = 1 GEN_RETRIES = 300   def _area_bounds(side: int) -> tuple[int, int]:     total = side * side     return max(AREA_ABS_LO, math.ceil(AREA_FRAC_LO * total)), min(AREA_ABS_HI, math.floor(AREA_FRAC_HI * total))   def _has_hole(mask: np.ndarray) -> bool:     pts = np.argwhere(mask)     if len(pts) == 0:         return True     r0, c0, r1, c1 = bbox_coords(pts)     sub = mask[r0 : r1 + 1, c0 : c1 + 1]     empty = ~sub     if not empty.any():         return False     for comp in components_mask(empty, connectivity=4):         if not (             np.any(comp[:, 0] == 0)             or np.any(comp[:, 0] == sub.shape[0] - 1)             or np.any(comp[:, 1] == 0)             or np.any(comp[:, 1] == sub.shape[1] - 1)         ):             return True     return False   def _forces_unique_square(masks: list[np.ndarray], side: int) -> bool:     bbs = [bbox_coords(np.argwhere(m)) for m in masks]     max_h = max(r1 - r0 + 1 for r0, _, r1, _ in bbs)     max_w = max(c1 - c0 + 1 for _, c0, _, c1 in bbs)     dims = [(h, w) for h, w in _factor_pairs(side * side) if h >= max_h and w >= max_w]     return dims == [(side, side)]   def _crop_mask(mask: np.ndarray) -> np.ndarray:     r0, c0, r1, c1 = bbox_coords(np.argwhere(mask))     return mask[r0 : r1 + 1, c0 : c1 + 1]   def _legend_strip_spots(mask: np.ndarray, orientation: str | None = None) -> list[tuple[str, int, int]]:     spots: list[tuple[str, int, int]] = []     h, w = mask.shape      if orientation in (None, \"h\") and h >= 3 and w >= LEGEND_STRIP_LEN + 2:         for r in range(1, h - 1):             for c in range(1, w - LEGEND_STRIP_LEN):                 if mask[r - 1 : r + 2, c - 1 : c + LEGEND_STRIP_LEN + 1].all():                     spots.append((\"h\", r, c))      if orientation in (None, \"v\") and h >= LEGEND_STRIP_LEN + 2 and w >= 3:         for r in range(1, h - LEGEND_STRIP_LEN):             for c in range(1, w - 1):                 if mask[r - 1 : r + LEGEND_STRIP_LEN + 1, c - 1 : c + 2].all():                     spots.append((\"v\", r, c))      return spots   def _make_legend_mask(side: int, min_area: int, max_area: int, strip_dir: str) -> np.ndarray:     threshold = LEGEND_THRESHOLD[side]     opts = []     for h0 in range(threshold + 1, side + 1):         for w0 in range(threshold + 1, side + 1):             for arm_w in LEGEND_ARM_RANGE:                 for arm_h in LEGEND_ARM_RANGE:                     mask = np.zeros((side, side), dtype=bool)                     mask[:LEGEND_CORE_SIZE, :LEGEND_CORE_SIZE] = True                     mask[:arm_h, :w0] = True                     mask[:h0, :arm_w] = True                     area = int(mask.sum())                     if not (min_area <= area <= max_area):                         continue                     if not _legend_strip_spots(_crop_mask(mask), strip_dir):                         continue                     opts.append(mask)     return random.choice(opts).copy()   def _partition_rest(rest: np.ndarray) -> np.ndarray | None:     side = rest.shape[0]     labels = np.full((side, side), -1, dtype=int)     available = set(map(tuple, np.argwhere(rest)))     anchors = [         (random.randint(0, side // 3), side - 1),         (side - 1, random.randint(0, side // 3)),         (side - 1, side - 1),     ]      seeds = []     for ar, ac in anchors:         seed = min(available, key=lambda p: abs(p[0] - ar) + abs(p[1] - ac) + random.random() * PARTITION_SEED_JITTER)         seeds.append(seed)         available.remove(seed)      areas = [0, 0, 0]     frontiers = [set() for _ in range(3)]      def add_frontier(i: int, r: int, c: int) -> None:         for rr, cc in neighbors4(r, c):             if 0 <= rr < side and 0 <= cc < side and rest[rr, cc] and labels[rr, cc] < 0:                 frontiers[i].add((rr, cc))      for i, seed in enumerate(seeds):         labels[seed] = i         areas[i] = 1         add_frontier(i, seed[0], seed[1])      unassigned = int(rest.sum()) - len(seeds)     while unassigned:         candidates = []         for i in range(3):             frontiers[i] = {p for p in frontiers[i] if labels[p] < 0}             if frontiers[i]:                 candidates.append(i)         if not candidates:             return None          weights = [             (1.0 / (areas[i] ** PARTITION_GROWTH_EXP)) * (len(frontiers[i]) ** PARTITION_FRONTIER_EXP)             for i in candidates         ]         i = random.choices(candidates, weights=weights, k=1)[0]         cell = random.choice(tuple(frontiers[i]))         frontiers[i].discard(cell)         labels[cell] = i         areas[i] += 1         unassigned -= 1         add_frontier(i, cell[0], cell[1])      return labels   def _random_orientation(mask: np.ndarray) -> np.ndarray:     arr = mask.astype(int)     opts = []     seen = set()     for k2 in range(4):         rot = np.rot90(arr, k2)         for oriented in (rot, np.fliplr(rot)):             r0, c0, r1, c1 = bbox_coords(np.argwhere(oriented > 0))             crop = oriented[r0 : r1 + 1, c0 : c1 + 1].astype(bool)             key = (crop.shape, tuple(crop.ravel()))             if key not in seen:                 seen.add(key)                 opts.append(crop)     return random.choice(opts)   def _scatter_pieces(masks: list[np.ndarray], body_colors: list[int], legend_seq: np.ndarray, side: int) -> np.ndarray | None:     total = side * side     nlo = max(INPUT_SIZE_LO, math.ceil(math.sqrt(total / DENSITY_HI)))     nhi = min(INPUT_SIZE_HI, math.floor(math.sqrt(total / DENSITY_LO)))     grid_size = random.randint(nlo, nhi)     grid = np.zeros((grid_size, grid_size), dtype=int)     occupied = np.zeros_like(grid)      for pi in random.sample(range(NUM_PIECES), NUM_PIECES):         oriented = _crop_mask(masks[pi]) if pi == 0 else _random_orientation(_crop_mask(masks[pi]))         patch = np.zeros(oriented.shape, dtype=int)         patch[oriented] = body_colors[pi]         if pi == 0:             spots = _legend_strip_spots(oriented)             if not spots:                 return None             orient, r, c = random.choice(spots)             if orient == \"h\":                 patch[r, c : c + LEGEND_STRIP_LEN] = legend_seq             else:                 patch[r : r + LEGEND_STRIP_LEN, c] = legend_seq         try:             box = np.ones(oriented.shape, dtype=int)             r0, c0 = random_free_location(                 occupied,                 box,                 transparent=0,                 border=SCATTER_BORDER,                 padding=SCATTER_PADDING,                 padding_connectivity=8,             )         except ValueError:             return None         occupied[r0 : r0 + oriented.shape[0], c0 : c0 + oriented.shape[1]] = 1         paste(grid, patch, r0, c0, transparent=0)     return grid   def _gen_attempt() -> np.ndarray | None:     side = random.choice(SIDE_CHOICES)     min_area, max_area = _area_bounds(side)     strip_dir = random.choice([\"h\", \"v\"])     legend = _make_legend_mask(side, min_area, max_area, strip_dir)     labels = _partition_rest(~legend)     if labels is None:         return None      masks = [legend] + [labels == i for i in range(3)]     areas = [int(m.sum()) for m in masks]     if any(a < min_area or a > max_area for a in areas):         return None     if any(len(components_mask(m, connectivity=4)) != 1 or _has_hole(m) for m in masks):         return None     if not _forces_unique_square(masks, side):         return None      qcells = []     for mask in masks:         pts = np.argwhere(mask)         qcells.append((min(1, int(pts[:, 0].mean() * K / side)), min(1, int(pts[:, 1].mean() * K / side))))     if len(set(qcells)) != NUM_PIECES:         return None      colors = random.sample(range(1, 10), NUM_COLORS)     body_colors = colors[:NUM_PIECES]     palette_colors = colors[NUM_COLORS - NUM_PIECES :]     random.shuffle(palette_colors)     legend_seq = np.asarray(palette_colors, dtype=int)     legend_map = _sequence_to_legend_map(legend_seq, K)      expected = np.zeros((side, side), dtype=int)     for pi, mask in enumerate(masks):         rr, cc = qcells[pi]         expected[mask] = legend_map[rr, cc]      grid = _scatter_pieces(masks, body_colors, legend_seq, side)     if grid is None:         return None     if not np.array_equal(main(grid), expected):         return None     return grid   def generate_input() -> np.ndarray:     for _ in range(GEN_RETRIES):         grid = _gen_attempt()         if grid is not None:             return grid     raise RuntimeError(\"failed to generate f560132c D5 input\")              ```              ### 参考代码: D8/1              文件: `/home/lixinyu/snap/new/ceshi/code/f560132c/D8/1/code.py`              ```python             # Variant of f560132c # Dimension: D8 — 图例与精灵的空间关系 (meta) # Change: 图例精灵位于网格中固定区域（通常靠近左上角），与其他精灵在空间上分离，通过包含多色像素来区分... → 图例位于网格边缘一行/列  import math import random  import numpy as np  from arc_utils import bbox_coords, components_mask, get_bg, neighbors4, paste, random_free_location   # Design analysis for the D8 variant # a) Concrete behavior: #    - The assembled output remains a 2x2 quadrant recoloring of four jigsaw pieces. #    - The legend no longer lives inside a multicolor piece body. Instead, the palette is a #      single edge strip on the outermost bottom row or right column, split into four contiguous #      color runs. Horizontal strips are read row-major; vertical strips are read column-major. #    - A single monochrome piece is still the \"legend piece\" for assembly anchoring, but now it is #      identified spatially: it is the unique piece closest to the edge strip. #    - Flow delta on a small example: #      old: find the only multicolor component -> crop its internal 2x2 palette -> anchor that #      same component at output (0,0). #      new: find the only edge strip with four runs -> decode its 2x2 palette -> remove the strip #      from the piece mask -> pick the piece nearest that strip -> anchor that piece at output (0,0). # b) Complexity calibration: #    - Only four legend runs are used, matching the original k*k = 4 palette cells. #    - Generator varies the strip side between bottom and right so the edge behavior is visible, #      but avoids all four sides to keep the training examples easy to infer. #    - The nearest-piece cue is unique by construction; other pieces are pushed away from the strip. # c) Old implicit assumptions that break here: #    - `components_mask(g != bg)` used to contain only pieces. Now it would also include the strip, #      so solver must delete legend-strip cells first. #    - `k = sqrt(len(comps))` used to work because legend lived inside one piece. Now `k` comes from #      the run count on the edge strip, and the piece count is checked afterwards. #    - `max distinct colors` used to identify the legend component. That is invalid because all four #      pieces are monochrome in this variant. #    - `_extract_legend_map()` used to scan a piece bbox. The new legend map is decoded from one edge line. # d) Placement legality: #    - The strip is kept away from corners so only one border line is non-background. #    - The legend piece is placed one blank cell away from the strip, so the strip stays a separate #      component and cannot merge with any piece. #    - Other pieces are scattered with a reserved exclusion band near the legend side, guaranteeing a #      unique nearest piece and keeping the strip visually isolated. # e) Visual observability: #    - The edge strip is large enough to be obvious and is the only non-background content touching #      the border, so a human must attend to the border rather than to an internal multicolor patch. #    - The piece nearest the strip is visually distinguished by proximity alone; no hidden ordering #      on color ids is used. # f) Visual cleanliness: #    - Strip, legend piece, and the remaining pieces are separated by blank rows/cols or padding. #    - No overlays are used; the border legend and the piece field occupy different regions. # g) Color-rule inferability: #    - Only four palette colors are used, exactly once each in the edge strip, preserving the original #      2x2 color-map semantics. #    - The horizontal/vertical unpacking rule follows the strip orientation, which is visible in the grid.   def _factor_pairs(n: int) -> list[tuple[int, int]]:     out = []     for h in range(1, int(n**0.5) + 1):         if n % h == 0:             w = n // h             out.append((h, w))             if h != w:                 out.append((w, h))     return out   def _normalize_coords(coords: list[tuple[int, int]] | tuple[tuple[int, int], ...]) -> tuple[tuple[tuple[int, int], ...], int, int]:     rs = [r for r, _ in coords]     cs = [c for _, c in coords]     r0 = min(rs)     c0 = min(cs)     norm = tuple(sorted((r - r0, c - c0) for r, c in coords))     h = max(r for r, _ in norm) + 1     w = max(c for _, c in norm) + 1     return norm, int(h), int(w)   def _rot90(coords: tuple[tuple[int, int], ...]) -> tuple[tuple[tuple[int, int], ...], int, int]:     norm, h, w = _normalize_coords(coords)     rot = [(c, h - 1 - r) for r, c in norm]     return _normalize_coords(rot)   def _flip_h(coords: tuple[tuple[int, int], ...]) -> tuple[tuple[tuple[int, int], ...], int, int]:     norm, h, w = _normalize_coords(coords)     flp = [(r, w - 1 - c) for r, c in norm]     return _normalize_coords(flp)   def _dihedral_orientations(     coords: tuple[tuple[int, int], ...], ) -> list[tuple[tuple[tuple[int, int], ...], int, int, int, bool]]:     \"\"\"     Unique orientations under rotations + mirror (D4).     Returned as (coords, h, w, rot_k, flipped), where the transform is:       - if flipped: horizontal flip (mirror left-right)       - then rot_k times 90° clockwise rotation     coords are normalized to start at (0,0).     \"\"\"     seen: set[tuple[tuple[int, int], ...]] = set()     out: list[tuple[tuple[tuple[int, int], ...], int, int, int, bool]] = []     cur = coords     for rot_k in range(4):         c, h, w = _normalize_coords(cur)         if c not in seen:             seen.add(c)             out.append((c, h, w, int(rot_k), False))         cur = _rot90(cur)[0]     cur = _flip_h(coords)[0]     for rot_k in range(4):         c, h, w = _normalize_coords(cur)         if c not in seen:             seen.add(c)             out.append((c, h, w, int(rot_k), True))         cur = _rot90(cur)[0]     return out   def _parse_edge_runs(vals: np.ndarray, bg: int) -> tuple[list[int], int, int] | None:     idxs = [i for i, v in enumerate(vals) if int(v) != bg]     if not idxs:         return None     lo = min(idxs)     hi = max(idxs)     segment = [int(v) for v in vals[lo : hi + 1]]     if any(v == bg for v in segment):         return None     colors = [segment[0]]     for v in segment[1:]:         if v != colors[-1]:             colors.append(v)     if len(set(colors)) != len(colors):         return None     return colors, int(lo), int(hi)   def _extract_edge_legend(g: np.ndarray, bg: int) -> tuple[str, int, int, int, np.ndarray]:     \"\"\"     Find the unique legend strip on the outermost border.      Returns (side, lo, hi, k, legend_map).     - Horizontal strips (top/bottom) are unpacked row-major.     - Vertical strips (left/right) are unpacked column-major.     \"\"\"     h, w = g.shape     edge_specs = [         (\"top\", g[0, :]),         (\"bottom\", g[h - 1, :]),         (\"left\", g[:, 0]),         (\"right\", g[:, w - 1]),     ]     candidates: list[tuple[str, int, int, int, np.ndarray]] = []     for side, vals in edge_specs:         parsed = _parse_edge_runs(np.asarray(vals, dtype=int), bg)         if parsed is None:             continue         colors, lo, hi = parsed         k = int(round(len(colors) ** 0.5))         if k * k != len(colors):             continue         arr = np.asarray(colors, dtype=int)         if side in (\"top\", \"bottom\"):             legend_map = arr.reshape(k, k)         else:             legend_map = arr.reshape(k, k, order=\"F\")         candidates.append((side, lo, hi, int(k), legend_map))     assert len(candidates) == 1, \"grid must contain exactly one valid edge legend strip\"     return candidates[0]   def _fill_holes_in_component(g: np.ndarray, pts: np.ndarray, bg: int) -> tuple[tuple[tuple[int, int], ...], int]:     \"\"\"     Treat background 'holes' fully enclosed inside the component bbox as part of the piece.     Returns (filled_pts, hole_count), where filled_pts is a sorted tuple of absolute coords.     \"\"\"     r0, c0, r1, c1 = bbox_coords(pts)     hh = r1 - r0 + 1     ww = c1 - c0 + 1     occ = np.zeros((hh, ww), dtype=bool)     for r, c in pts:         occ[r - r0, c - c0] = True      bgmask = ~occ     vis = np.zeros_like(bgmask, dtype=bool)     st: list[tuple[int, int]] = []      for rr in range(hh):         for cc in range(ww):             if rr in (0, hh - 1) or cc in (0, ww - 1):                 if bgmask[rr, cc] and not vis[rr, cc]:                     vis[rr, cc] = True                     st.append((rr, cc))                     while st:                         r, c = st.pop()                         for r2, c2 in neighbors4(r, c):                             if 0 <= r2 < hh and 0 <= c2 < ww and bgmask[r2, c2] and not vis[r2, c2]:                                 vis[r2, c2] = True                                 st.append((r2, c2))      holes = bgmask & ~vis     hole_coords = [(r0 + rr, c0 + cc) for rr, cc in zip(*np.where(holes))]     filled = tuple(sorted(set(map(tuple, pts)).union(hole_coords)))     return filled, int(holes.sum())   def _assemble_exact_cover(     pieces: list[dict],     legend_idx: int,     legend_map: np.ndarray,     k: int, ) -> np.ndarray:     \"\"\"     Tile all pieces into a full rectangle (no holes), allowing rotations + reflections.     Recolor each piece by quantizing its centroid into a k×k grid, using legend_map.     \"\"\"     total = sum(int(p[\"area\"]) for p in pieces)     max_h = max(max(h for _, h, _, _, _ in p[\"oris\"]) for p in pieces)     max_w = max(max(w for _, _, w, _, _ in p[\"oris\"]) for p in pieces)      dims = _factor_pairs(total)     dims = [(H, W) for (H, W) in dims if H >= max_h and W >= max_w]     assert len(dims) == 1, \"piece areas and bounds must imply a unique output rectangle\"      for H, W in dims:         nbits = H * W         all_mask = (1 << nbits) - 1          other_pis = [i for i in range(len(pieces)) if i != legend_idx]         placements_other: list[list[tuple[int, int, int, tuple[tuple[int, int], ...]]]] = []         for pi in other_pis:             opts: list[tuple[int, int, int, tuple[tuple[int, int], ...]]] = []             for coords, ph, pw, _, _ in pieces[pi][\"oris\"]:                 for r0 in range(0, H - ph + 1):                     for c0 in range(0, W - pw + 1):                         m = 0                         for dr, dc in coords:                             idx = (int(r0) + int(dr)) * int(W) + (int(c0) + int(dc))                             m |= 1 << idx                         opts.append((m, int(r0), int(c0), coords))             placements_other.append(opts)          def solve_with_fixed_legend(             legend_coords: tuple[tuple[int, int], ...],         ) -> dict[int, tuple[int, int, int, tuple[tuple[int, int], ...]]] | None:             legend_mask = 0             for dr, dc in legend_coords:                 idx = int(dr) * int(W) + int(dc)                 legend_mask |= 1 << idx              filtered: list[list[tuple[int, int, int, tuple[tuple[int, int], ...]]]] = []             for opts in placements_other:                 filtered.append([pl for pl in opts if (pl[0] & legend_mask) == 0])              remaining = set(range(len(other_pis)))             chosen: dict[int, tuple[int, int, int, tuple[tuple[int, int], ...]]] = {                 legend_idx: (legend_mask, 0, 0, legend_coords)             }              def search(used: int) -> bool:                 if not remaining:                     return used == all_mask                 empty = (~used) & all_mask                 if empty == 0:                     return False                 cell = (empty & -empty).bit_length() - 1                 candidates = []                 for k2 in sorted(remaining):                     opts_k = []                     for pl in filtered[k2]:                         m = pl[0]                         if (m >> cell) & 1 and (m & used) == 0:                             opts_k.append(pl)                     if opts_k:                         candidates.append((len(opts_k), k2, opts_k))                 if not candidates:                     return False                  candidates.sort(key=lambda x: (x[0], x[1]))                 for _, k2, opts_k in candidates:                     remaining.remove(k2)                     pi = other_pis[k2]                     for pl in opts_k:                         chosen[pi] = pl                         if search(used | pl[0]):                             return True                     chosen.pop(pi, None)                     remaining.add(k2)                 return False              if not search(legend_mask):                 return None             return chosen          chosen = None         for coords, ph, pw, _, _ in pieces[legend_idx][\"oris\"]:             assert ph <= H and pw <= W, \"legend orientation must fit the unique output rectangle\"             sol = solve_with_fixed_legend(coords)             if sol is None:                 continue             chosen = sol             break         assert chosen is not None, \"exact-cover assembly failed: no valid legend orientation\"          piece_cell: dict[int, tuple[int, int]] = {}         for pi, pl in chosen.items():             _, r0, c0, coords = pl             rs = [r0 + dr for dr, _ in coords]             cs = [c0 + dc for _, dc in coords]             cr = float(sum(rs)) / float(len(rs))             cc = float(sum(cs)) / float(len(cs))             rr = int(cr * float(k) / float(H))             cc2 = int(cc * float(k) / float(W))             rr = max(0, min(int(k) - 1, rr))             cc2 = max(0, min(int(k) - 1, cc2))             piece_cell[pi] = (rr, cc2)          out = np.zeros((H, W), dtype=int)         for pi, pl in chosen.items():             _, r0, c0, coords = pl             rr, cc2 = piece_cell[pi]             col = int(legend_map[rr, cc2])             for dr, dc in coords:                 out[r0 + dr, c0 + dc] = col         return out   def _distance_to_side(pts: np.ndarray, side: str, shape: tuple[int, int]) -> int:     h, w = shape     r0, c0, r1, c1 = bbox_coords(pts)     if side == \"top\":         return int(r0)     if side == \"bottom\":         return int(h - 1 - r1)     if side == \"left\":         return int(c0)     if side == \"right\":         return int(w - 1 - c1)     raise ValueError(f\"unknown side: {side}\")   def main(grid: np.ndarray) -> np.ndarray:     \"\"\"     Assemble scattered jigsaw pieces into a rectangle, recoloring each by a border legend strip.      Input structure:     - bg = most common color.     - Several monochrome non-bg sprites are scattered in the interior of the grid.     - A separate legend appears on the outermost bottom row or right column as four contiguous color runs.     - The piece closest to that strip is the assembly anchor; the strip itself is not one of the pieces.      Rule:     - Decode the edge strip into a 2x2 color map.     - Remove the strip, then tile the four pieces into a tight rectangle with rotations/reflections allowed.     - Anchor the piece nearest the strip at the assembled top-left, then recolor every assembled piece by the       legend-map cell reached by its centroid in the final rectangle.      Key insight: The legend information has moved out of the sprite field and onto the border, so solving now     depends on reading an edge run-pattern first and only then using proximity to recover which piece plays the old legend role.     \"\"\"     g = np.asarray(grid, dtype=int)     bg = get_bg(g)     h, w = g.shape      side, lo, hi, k, legend_map = _extract_edge_legend(g, bg)      piece_mask = g != bg     if side == \"top\":         piece_mask[0, lo : hi + 1] = False     elif side == \"bottom\":         piece_mask[h - 1, lo : hi + 1] = False     elif side == \"left\":         piece_mask[lo : hi + 1, 0] = False     else:         piece_mask[lo : hi + 1, w - 1] = False      comps = components_mask(piece_mask, connectivity=4)     assert comps, \"grid must contain at least one non-background component after removing the edge legend\"     assert len(comps) == k * k, \"piece count must match the decoded edge legend\"      dists = [_distance_to_side(pts, side, g.shape) for pts in comps]     min_dist = min(dists)     legend_candidates = [i for i, d in enumerate(dists) if d == min_dist]     assert len(legend_candidates) == 1, \"legend piece must be uniquely closest to the edge legend\"     legend_idx = legend_candidates[0]      pieces: list[dict] = []     for pts in comps:         filled_abs, _ = _fill_holes_in_component(g, pts, bg)         r0, c0, _, _ = bbox_coords(np.asarray(list(filled_abs)))         rel = tuple((r - r0, c - c0) for r, c in filled_abs)         rel_norm, _, _ = _normalize_coords(rel)         oris = _dihedral_orientations(rel_norm)         pieces.append({\"oris\": oris, \"area\": len(filled_abs)})      return _assemble_exact_cover(pieces, legend_idx, legend_map, k)   # --------------- generator (o5x) ---------------  # === CFG === SIDE_CHOICES = [8, 10, 12] K = 2 NUM_PIECES = K * K NUM_COLORS = 8 AREA_FRAC_LO = 0.08 AREA_FRAC_HI = 0.43 AREA_ABS_LO = 11 AREA_ABS_HI = 62 LEGEND_THRESHOLD = {8: 4, 10: 5, 12: 9} LEGEND_CORE_SIZE = 4 LEGEND_ARM_RANGE = range(1, 4) PARTITION_GROWTH_EXP = 1.45 PARTITION_FRONTIER_EXP = 0.2 PARTITION_SEED_JITTER = 0.2 INPUT_SIZE_LO = 20 INPUT_SIZE_HI = 26 DENSITY_LO = 0.15 DENSITY_HI = 0.25 SCATTER_BORDER = 2 SCATTER_PADDING = 1 EDGE_SIDES = (\"bottom\", \"right\") EDGE_SEG_LEN_CHOICES = [2, 3] EDGE_MARGIN = 1 LEGEND_GAP = 1 LEGEND_EXCLUSION_BAND = 5 GEN_RETRIES = 300   def _area_bounds(side):     total = side * side     return max(AREA_ABS_LO, math.ceil(AREA_FRAC_LO * total)), min(AREA_ABS_HI, math.floor(AREA_FRAC_HI * total))   def _has_hole(mask):     pts = np.argwhere(mask)     if len(pts) == 0:         return True     r0, c0, r1, c1 = bbox_coords(pts)     sub = mask[r0 : r1 + 1, c0 : c1 + 1]     empty = ~sub     if not empty.any():         return False     for comp in components_mask(empty, connectivity=4):         if not (             np.any(comp[:, 0] == 0)             or np.any(comp[:, 0] == sub.shape[0] - 1)             or np.any(comp[:, 1] == 0)             or np.any(comp[:, 1] == sub.shape[1] - 1)         ):             return True     return False   def _forces_unique_square(masks, side):     bbs = [bbox_coords(np.argwhere(m)) for m in masks]     max_h = max(r1 - r0 + 1 for r0, _, r1, _ in bbs)     max_w = max(c1 - c0 + 1 for _, c0, _, c1 in bbs)     dims = [(h, w) for h, w in _factor_pairs(side * side) if h >= max_h and w >= max_w]     return dims == [(side, side)]   def _make_legend_mask(side, min_area, max_area):     threshold = LEGEND_THRESHOLD[side]     opts = []     for h0 in range(threshold + 1, side + 1):         for w0 in range(threshold + 1, side + 1):             for arm_w in LEGEND_ARM_RANGE:                 for arm_h in LEGEND_ARM_RANGE:                     mask = np.zeros((side, side), dtype=bool)                     mask[:LEGEND_CORE_SIZE, :LEGEND_CORE_SIZE] = True                     mask[:arm_h, :w0] = True                     mask[:h0, :arm_w] = True                     area = int(mask.sum())                     if min_area <= area <= max_area:                         opts.append(mask)     return random.choice(opts).copy()   def _partition_rest(rest):     side = rest.shape[0]     labels = np.full((side, side), -1, dtype=int)     available = set(map(tuple, np.argwhere(rest)))     anchors = [         (random.randint(0, side // 3), side - 1),         (side - 1, random.randint(0, side // 3)),         (side - 1, side - 1),     ]      seeds = []     for ar, ac in anchors:         seed = min(available, key=lambda p: abs(p[0] - ar) + abs(p[1] - ac) + random.random() * PARTITION_SEED_JITTER)         seeds.append(seed)         available.remove(seed)      areas = [0, 0, 0]     frontiers = [set() for _ in range(3)]      def add_frontier(i, r, c):         for rr, cc in neighbors4(r, c):             if 0 <= rr < side and 0 <= cc < side and rest[rr, cc] and labels[rr, cc] < 0:                 frontiers[i].add((rr, cc))      for i, seed in enumerate(seeds):         labels[seed] = i         areas[i] = 1         add_frontier(i, seed[0], seed[1])      unassigned = int(rest.sum()) - len(seeds)     while unassigned:         candidates = []         for i in range(3):             frontiers[i] = {p for p in frontiers[i] if labels[p] < 0}             if frontiers[i]:                 candidates.append(i)         if not candidates:             return None          weights = [             (1.0 / (areas[i] ** PARTITION_GROWTH_EXP)) * (len(frontiers[i]) ** PARTITION_FRONTIER_EXP)             for i in candidates         ]         i = random.choices(candidates, weights=weights, k=1)[0]         cell = random.choice(tuple(frontiers[i]))         frontiers[i].discard(cell)         labels[cell] = i         areas[i] += 1         unassigned -= 1         add_frontier(i, cell[0], cell[1])      return labels   def _crop_mask(mask):     r0, c0, r1, c1 = bbox_coords(np.argwhere(mask))     return mask[r0 : r1 + 1, c0 : c1 + 1]   def _random_orientation(mask):     arr = mask.astype(int)     opts = []     seen = set()     for k2 in range(4):         rot = np.rot90(arr, k2)         for oriented in (rot, np.fliplr(rot)):             r0, c0, r1, c1 = bbox_coords(np.argwhere(oriented > 0))             crop = oriented[r0 : r1 + 1, c0 : c1 + 1].astype(bool)             key = (crop.shape, tuple(crop.ravel()))             if key not in seen:                 seen.add(key)                 opts.append(crop)     return random.choice(opts)   def _paint_edge_strip(grid: np.ndarray, side: str, start: int, seg_len: int, legend_map: np.ndarray):     colors = legend_map.ravel().tolist() if side == \"bottom\" else legend_map.T.ravel().tolist()     if side == \"bottom\":         c = start         for col in colors:             grid[-1, c : c + seg_len] = int(col)             c += seg_len     elif side == \"right\":         r = start         for col in colors:             grid[r : r + seg_len, -1] = int(col)             r += seg_len     else:         raise ValueError(f\"unsupported edge side: {side}\")   def _legend_piece_position(grid_size: int, edge_side: str, shape: tuple[int, int]) -> tuple[int, int] | None:     h, w = shape     if edge_side == \"bottom\":         r0 = grid_size - h - (LEGEND_GAP + 1)         c_lo = 1         c_hi = grid_size - w - 2         if c_lo > c_hi or r0 < 1:             return None         return int(r0), random.randint(c_lo, c_hi)     if edge_side == \"right\":         c0 = grid_size - w - (LEGEND_GAP + 1)         r_lo = 1         r_hi = grid_size - h - 2         if r_lo > r_hi or c0 < 1:             return None         return random.randint(r_lo, r_hi), int(c0)     return None   def _strip_start_candidates(grid_size: int, edge_side: str, span: int, bbox_lo: int, bbox_hi: int) -> list[int]:     lo = EDGE_MARGIN     hi = grid_size - span - EDGE_MARGIN     if lo > hi:         return []     starts = []     for start in range(lo, hi + 1):         end = start + span - 1         if start <= bbox_hi and end >= bbox_lo:             starts.append(int(start))     return starts   def _reserve_band(occupied: np.ndarray, edge_side: str):     if edge_side == \"bottom\":         occupied[-LEGEND_EXCLUSION_BAND:, :] = 1     elif edge_side == \"right\":         occupied[:, -LEGEND_EXCLUSION_BAND:] = 1     else:         raise ValueError(f\"unsupported edge side: {edge_side}\")   def _scatter_pieces(masks, body_colors, legend_map, out_side):     total = out_side * out_side     nlo = max(INPUT_SIZE_LO, math.ceil(math.sqrt(total / DENSITY_HI)))     nhi = min(INPUT_SIZE_HI, math.floor(math.sqrt(total / DENSITY_LO)))     grid_size = random.randint(nlo, nhi)     grid = np.zeros((grid_size, grid_size), dtype=int)     occupied = np.zeros_like(grid)      edge_side = random.choice(EDGE_SIDES)     seg_len = random.choice(EDGE_SEG_LEN_CHOICES)     span = K * K * seg_len      legend_oriented = _random_orientation(_crop_mask(masks[0]))     legend_pos = _legend_piece_position(grid_size, edge_side, legend_oriented.shape)     if legend_pos is None:         return None     lr0, lc0 = legend_pos     lh, lw = legend_oriented.shape      if edge_side == \"bottom\":         starts = _strip_start_candidates(grid_size, edge_side, span, lc0, lc0 + lw - 1)     else:         starts = _strip_start_candidates(grid_size, edge_side, span, lr0, lr0 + lh - 1)     if not starts:         return None     strip_start = random.choice(starts)      _paint_edge_strip(grid, edge_side, strip_start, seg_len, legend_map)     if edge_side == \"bottom\":         occupied[-1, strip_start : strip_start + span] = 1     else:         occupied[strip_start : strip_start + span, -1] = 1      legend_patch = np.zeros(legend_oriented.shape, dtype=int)     legend_patch[legend_oriented] = body_colors[0]     paste(grid, legend_patch, lr0, lc0, transparent=0)     occupied[lr0 : lr0 + lh, lc0 : lc0 + lw] = 1      _reserve_band(occupied, edge_side)     occupied[lr0 : lr0 + lh, lc0 : lc0 + lw] = 1      for pi in random.sample(range(1, NUM_PIECES), NUM_PIECES - 1):         oriented = _random_orientation(_crop_mask(masks[pi]))         patch = np.zeros(oriented.shape, dtype=int)         patch[oriented] = body_colors[pi]         try:             box = np.ones(oriented.shape, dtype=int)             r0, c0 = random_free_location(                 occupied,                 box,                 transparent=0,                 border=SCATTER_BORDER,                 padding=SCATTER_PADDING,                 padding_connectivity=8,             )         except ValueError:             return None         occupied[r0 : r0 + oriented.shape[0], c0 : c0 + oriented.shape[1]] = 1         paste(grid, patch, r0, c0, transparent=0)     return grid   def _gen_attempt():     side = random.choice(SIDE_CHOICES)     min_area, max_area = _area_bounds(side)     legend = _make_legend_mask(side, min_area, max_area)     labels = _partition_rest(~legend)     if labels is None:         return None      masks = [legend] + [labels == i for i in range(3)]     areas = [int(m.sum()) for m in masks]     if any(a < min_area or a > max_area for a in areas):         return None     if any(len(components_mask(m, connectivity=4)) != 1 or _has_hole(m) for m in masks):         return None     if not _forces_unique_square(masks, side):         return None      qcells = []     for mask in masks:         pts = np.argwhere(mask)         qcells.append((min(1, int(pts[:, 0].mean() * K / side)), min(1, int(pts[:, 1].mean() * K / side))))     if len(set(qcells)) != NUM_PIECES:         return None      colors = random.sample(range(1, 10), NUM_COLORS)     body_colors = colors[:NUM_PIECES]     palette_colors = colors[NUM_PIECES:]     random.shuffle(palette_colors)     legend_map = np.array(palette_colors, dtype=int).reshape(K, K)      expected = np.zeros((side, side), dtype=int)     for pi, mask in enumerate(masks):         rr, cc = qcells[pi]         expected[mask] = legend_map[rr, cc]      grid = _scatter_pieces(masks, body_colors, legend_map, side)     if grid is None:         return None     if not np.array_equal(main(grid), expected):         return None     return grid   def generate_input():     for _ in range(GEN_RETRIES):         grid = _gen_attempt()         if grid is not None:             return grid     raise RuntimeError(\"failed to generate f560132c D8 input\")              ```      ## 你的任务      1. **理解原代码**: 弄清 `main()` 和 `generate_input()` 的逻辑。      2. **阅读参考代码**（如有）: 上面列出的已有单变体代码是各组成项单独实现的版本，帮助你理解每项变更的实现方式。融合版本应综合参考但不能简单拼接。      3. **设计分析（写代码前必须完成）**:         综合「融合描述」和「各组成项详情」，将融合规则落实到代码层面。融合描述给出了整体的 input→output 规则，各组成项详情给出了每项改动的具体含义——两者结合才是完整的实现规格。如果上面提供了原始任务规格（Spec），请将其作为设计分析的重要参考——spec 详细描述了原始任务中各对象的结构、空间关系、生成策略等，理解这些细节有助于你准确判断融合改动的影响范围和实现方式。         a) **具体化与行为追踪**: 融合后的变体在 ARC 的像素网格中具体长什么样？用一个具体小例子追踪：原始逻辑在每个被改动的环节是怎么执行的 → 融合后应该怎么执行的 → 二者的差异是什么。         b) **复杂度校准**: 检查你的设计是否过于简化。过于简化会导致两个问题：一是容易产生冲突或重复（例如不同对象变得难以区分，匹配出现歧义），二是变体的视觉效果不明显，肉眼看不出和原任务的区别。同时不要让关键自由度过多；如果规则依赖少数档位、类别或对应关系，应控制在少量取值，并让它们在每个样例中有重复支撑。         c) **隐式假设审查**: 各组成项的改动可能破坏原代码中的哪些隐式假设？多项改动叠加后是否引入新的冲突？逐行检查 main() 中与变体相关的代码段：每行代码依赖了什么前提？这个前提在融合后是否仍然成立？         d) **放置合法性**: 生成器在放置对象时，必须保证各个体之间不重叠、不越界，且放置结果符合题意。         e) **视觉可观察性**: ARC 要求人类从 2-4 个 input→output 样例中肉眼推断规则。禁止使用任何人类不可视因素参与排序等操作（例如黑色=0，禁用）。做一次思想实验：假设你是解题者，看到几组变体生成的 input→output，能否看出融合后的规则？注意不要使用颜色值等人类不可视因素。如果变体的变化规律在2-3组像素网格上无法推出（例如对大量纯色对称对象做不同变换、无法从少量例子归纳颜色对应关系、不同情况的变换涉及正逆向旋转镜像等多种不同变化等，即全部的变化逻辑或者说是变化规律无法在3个输入输出示例对中体现），就需要调整设计使差异可观察。         f) **可视化整洁度**: 即使逻辑合理，如果可视化后的输出网格看上去乱七八糟也不行。检查：同一网格区域是否存在多种元素覆盖叠加导致无法分辨哪个是哪个？不同对象、区域、标记之间在视觉上是否能清晰区分？如果融合后的网格在视觉上杂乱不堪，需要调整设计（如减少同一区域的叠加层次、增大对象间距、简化标记方式等）。         g) **变化的可推断性**: 如果融合涉及颜色映射或颜色变化，务必确保颜色种类不宜过多，且颜色变化必须有足够的结构性线索（如位置、形状、分区等伴随特征）让人类能从少量样例中推断出颜色变化规则。避免出现大量颜色变化却无任何提示的情况——如果解题者无法从样例归纳出\"什么条件导致什么颜色\"，这个融合设计就         将以上分析写在代码注释中或输出中，然后再开始写代码。      4. **修改 `main()`**: 按照融合描述和各组成项详情实现新规则。确保各项改动在推理链中有真正的协同，不是各改各的。     5. **修改 `generate_input()`**: 确保生成的输入能正确触发融合后的新规则。     6. **保证 generator 的正确性**: 沿用 output-first 模式或适当调整，但必须保证每个输入经过新 `main()` 后不崩溃、不触发 assert、输出正确。     7. **测试**: 运行以下测试，确保成功率 ≥ 80%:      ```bash     /home/xd/miniconda3/bin/python -c \"     import numpy as np, importlib.util, time, sys     spec = importlib.util.spec_from_file_location('variant', '/home/lixinyu/snap/new/ceshi/code_combo/f560132c/23/code.py')     mod = importlib.util.module_from_spec(spec)     spec.loader.exec_module(mod)     ok, fail = 0, 0     t0 = time.time()     for i in range(50):         try:             inp = mod.generate_input()             out = mod.main(inp)             ok += 1         except Exception as e:             fail += 1             if fail <= 3: print(f'Trial {i}: {e}')     elapsed = time.time() - t0     print(f'Success: {ok}/50, Time: {elapsed:.1f}s ({elapsed/50*1000:.0f}ms/call)')     if ok < 40: sys.exit(1)     \"     ```      如果测试失败，分析错误原因，修改代码，重新测试。反复直到通过。      8. **验证融合行为确实发生**: `main(input)==output` 只能验证求解器不报错，无法验证输入是否真正体现了融合描述中的特征行为——退化为原始行为的输入同样能通过。测试通过后，定义一个量化指标衡量融合核心行为，统计生成样本中该指标的分布。只有当关键控制变量不起作用、样本按融合逻辑执行与按原逻辑执行在相同输入上输出相同结果时，才算退化并需要修正生成器。     9. **审查 `main()` 的新隐式假设**: 修改 `main()` 后，它可能对输入产生原始版本中不存在的新假设（如对象间需特定空间关系、匹配特征需可区分、处理顺序依赖前一步结果等）。逐一检查 `main()` 中的每个循环、匹配和条件分支：这段逻辑对输入做了什么假设？`generate_input()` 是否通过构造保证了这些假设？      ## 参考资源     - `/home/lixinyu/snap/new/solvers/arc_utils.py` — 可用的工具函数     - `/home/lixinyu/snap/new/ARC-data/ARC-AGI-2/data/evaluation/f560132c.json` — 原任务的 I/O 样例      ## 输出      将完整的融合变体代码（包含修改后的 `main()` 和 `generate_input()`）保存到:     `/home/lixinyu/snap/new/ceshi/code_combo/f560132c/23/code.py`      代码文件开头加一段注释说明这是什么融合变体:     ```python     # Combo variant of f560132c (index 23)     # combo_spec: D5/0+D8/1+D10/0     # Name: 线性色带+边缘图例+无框架识别     ```      如果原始代码的 `main()` 已有四段式说明注释/文档字符串，则新代码也必须在 `main()` 上方写出同结构的四部分说明：     1. 开头概述     2. `Input structure:`     3. `Rule:`     4. `Key insight:`      确保目录 `/home/lixinyu/snap/new/ceshi/code_combo/f560132c/23` 存在（如不存在则创建）。      - `/home/lixinyu/snap/new/arc2_solver_select/c4d067a0.py` — 参考任务 c4d067a0 的 solver（D8/1 的灵感来源） \n3218244       01:27 /home/lixinyu/.nvm/versions/node/v18.20.8/lib/node_modules/@openai/codex/node_modules/@openai/codex-linux-x64/vendor/x86_64-unknown-linux-musl/codex/codex exec --skip-git-repo-check -c model=\"gpt-5.4\" -c reasoning.effort=\"high\"     你要修改一个 ARC-AGI-2 任务的 solver 和 generator，实现一个**多维度融合变体**。      ## 原始任务: f560132c     **摘要**: 将散落的单色精灵根据形状匹配拼装为矩形复合体，并按2x2彩色图例中对应位置的颜色重新着色，输出紧凑裁剪      ## 要实现的融合组合     - **组合名称**: 洞数匹配+洞数编码图例+颜色映射表     - **combo_spec**: D1/4+D5/3+D14/1      ### 融合描述（实现规格）      精灵内部有不同数量的洞，图例各象限也通过洞数编码位置（0-3个洞分别对应4个象限）， 图例同时包含源色-目标色映射表。匹配条件和图例编码都基于\"洞数\"这一统一概念。 解题者需计数洞数完成匹配，并从映射表读取重着色规则。      ### 各组成项的原始变体详情      以下是 combo_spec 中每个组成项在维度分析 YAML 中的原始描述，帮助你理解每项改动的来源和细节：      - **D1/4** — 匹配条件：形状匹配 vs 其他匹配逻辑 (`match_cond`)   - 当前值: s.shape matches d.region.shape — 每个单色精灵的形状恰好对应复合矩形中某个象限区域的形状轮廓   - 改为: 洞数计数匹配 — 每个精灵内部有不同数量的洞（背景连通区域），图例各象限也编码了对应的洞数（如用内部像素数量表示）。精灵根据洞数与图例位置匹配，将几何匹配转化为计数推理   - 来源: hole_counting（参考任务: 8698868d） - **D5/3** — 符号指令：图例的编码方式与结构 (`symbol_instructions`)   - 当前值: 图例精灵包含2x2彩色像素嵌入在单色框架中，每个像素的位置（左上、右上、左下、右下）映射到复合体中对应象限的重着色颜色   - 改为: 图例颜色通过洞数编码位置 — 图例中的4个颜色区域各自包含不同数量的洞（0-3个），洞数编码了该颜色在复合体中的象限位置。解题者需计数洞数并建立位置映射，增加了数值推理环节   - 来源: hole_counting（参考任务: 8698868d） - **D14/1** — 图例颜色与精灵颜色的映射方式 (`meta`)   - 当前值: 图例2x2中的4种颜色与精灵的4种颜色完全不同——图例颜色是目标色，精灵颜色是源色，形成完全的重映射   - 改为: 图例颜色与精灵颜色一一对应（颜色映射表） — 图例不再编码目标色，而是编码源色-目标色映射关系：图例中每个象限包含两个像素——一个是源精灵色，一个是目标色。解题者需解读映射表再应用，增加了符号解码步骤   - 来源: legend_lookup（参考任务: 9385bd28）      ## 原始 solver + generator 代码      文件: `/home/lixinyu/snap/new/arc2_solver_select/f560132c.py`      ```python     import numpy as np  from arc_utils import bbox_coords, components_mask, get_bg, neighbors4, paste, random_free_location import math import random   def _factor_pairs(n: int) -> list[tuple[int, int]]:     out = []     for h in range(1, int(n**0.5) + 1):         if n % h == 0:             w = n // h             out.append((h, w))             if h != w:                 out.append((w, h))     return out   def _normalize_coords(coords: list[tuple[int, int]] | tuple[tuple[int, int], ...]) -> tuple[tuple[tuple[int, int], ...], int, int]:     rs = [r for r, _ in coords]     cs = [c for _, c in coords]     r0 = min(rs)     c0 = min(cs)     norm = tuple(sorted((r - r0, c - c0) for r, c in coords))     h = max(r for r, _ in norm) + 1     w = max(c for _, c in norm) + 1     return norm, int(h), int(w)   def _rot90(coords: tuple[tuple[int, int], ...]) -> tuple[tuple[tuple[int, int], ...], int, int]:     norm, h, w = _normalize_coords(coords)     rot = [(c, h - 1 - r) for r, c in norm]     return _normalize_coords(rot)   def _flip_h(coords: tuple[tuple[int, int], ...]) -> tuple[tuple[tuple[int, int], ...], int, int]:     norm, h, w = _normalize_coords(coords)     flp = [(r, w - 1 - c) for r, c in norm]     return _normalize_coords(flp)   def _dihedral_orientations(     coords: tuple[tuple[int, int], ...], ) -> list[tuple[tuple[tuple[int, int], ...], int, int, int, bool]]:     \"\"\"     Unique orientations under rotations + mirror (D4).     Returned as (coords, h, w, rot_k, flipped), where the transform is:       - if flipped: horizontal flip (mirror left-right)       - then rot_k times 90° clockwise rotation     coords are normalized to start at (0,0).     \"\"\"     seen: set[tuple[tuple[int, int], ...]] = set()     out: list[tuple[tuple[tuple[int, int], ...], int, int, int, bool]] = []     cur = coords     for rot_k in range(4):         c, h, w = _normalize_coords(cur)         if c not in seen:             seen.add(c)             out.append((c, h, w, int(rot_k), False))         cur = _rot90(cur)[0]     cur = _flip_h(coords)[0]     for rot_k in range(4):         c, h, w = _normalize_coords(cur)         if c not in seen:             seen.add(c)             out.append((c, h, w, int(rot_k), True))         cur = _rot90(cur)[0]     return out   def _extract_legend_map(g: np.ndarray, pts: np.ndarray, k: int) -> np.ndarray:     \"\"\"     Inside the legend component's bounding box, find a k×k color map block (may include 0).     We pick the k×k window with the maximum number of distinct colors; ties go to top-left.     \"\"\"     r0, c0, r1, c1 = bbox_coords(pts)     sub = g[r0 : r1 + 1, c0 : c1 + 1]     hh, ww = sub.shape     assert k > 0 and hh >= k and ww >= k, 'legend component must fit k×k map'     best = None  # (distinct, -rr, -cc)     best_rc = None     for rr in range(hh - k + 1):         for cc in range(ww - k + 1):             window = sub[rr : rr + k, cc : cc + k]             distinct = int(len(set(map(int, window.ravel()))))             key = (distinct, -rr, -cc)             if best is None or key > best:                 best = key                 best_rc = (rr, cc)     assert best_rc is not None, 'legend component must contain a valid k×k color map window'     rr, cc = best_rc     return np.asarray(sub[rr : rr + k, cc : cc + k], dtype=int).copy()   def _fill_holes_in_component(g: np.ndarray, pts: np.ndarray, bg: int) -> tuple[tuple[tuple[int, int], ...], int]:     \"\"\"     Treat background 'holes' fully enclosed inside the component bbox as part of the piece.     Returns (filled_pts, hole_count), where filled_pts is a sorted tuple of absolute coords.     \"\"\"     r0, c0, r1, c1 = bbox_coords(pts)     hh = r1 - r0 + 1     ww = c1 - c0 + 1     occ = np.zeros((hh, ww), dtype=bool)     for r, c in pts:         occ[r - r0, c - c0] = True      bgmask = ~occ     vis = np.zeros_like(bgmask, dtype=bool)     st: list[tuple[int, int]] = []      for rr in range(hh):         for cc in range(ww):             if rr in (0, hh - 1) or cc in (0, ww - 1):                 if bgmask[rr, cc] and not vis[rr, cc]:                     vis[rr, cc] = True                     st.append((rr, cc))                     while st:                         r, c = st.pop()                         for r2, c2 in neighbors4(r, c):                             if 0 <= r2 < hh and 0 <= c2 < ww and bgmask[r2, c2] and not vis[r2, c2]:                                 vis[r2, c2] = True                                 st.append((r2, c2))      holes = bgmask & ~vis     hole_coords = [(r0 + rr, c0 + cc) for rr, cc in zip(*np.where(holes))]     filled = tuple(sorted(set(map(tuple, pts)).union(hole_coords)))     return filled, int(holes.sum())   def _assemble_exact_cover(     pieces: list[dict],     legend_idx: int,     legend_map: np.ndarray,     k: int, ) -> np.ndarray:     \"\"\"     Tile all pieces into a full rectangle (no holes), allowing rotations + reflections.     Recolor each piece by quantizing its centroid into a k×k grid, using legend_map.     \"\"\"     total = sum(int(p[\"area\"]) for p in pieces)     max_h = max(max(h for _, h, _, _, _ in p[\"oris\"]) for p in pieces)     max_w = max(max(w for _, _, w, _, _ in p[\"oris\"]) for p in pieces)      dims = _factor_pairs(total)     dims = [(H, W) for (H, W) in dims if H >= max_h and W >= max_w]     assert len(dims) == 1, 'piece areas and bounds must imply a unique output rectangle'      for H, W in dims:         nbits = H * W         all_mask = (1 << nbits) - 1          # Precompute placements for non-legend pieces (legend is fixed at (0,0), but orientation varies).         other_pis = [i for i in range(len(pieces)) if i != legend_idx]         placements_other: list[list[tuple[int, int, int, tuple[tuple[int, int], ...]]]] = []         for pi in other_pis:             opts: list[tuple[int, int, int, tuple[tuple[int, int], ...]]] = []             for coords, ph, pw, _, _ in pieces[pi][\"oris\"]:                 for r0 in range(0, H - ph + 1):                     for c0 in range(0, W - pw + 1):                         m = 0                         for dr, dc in coords:                             idx = (int(r0) + int(dr)) * int(W) + (int(c0) + int(dc))                             m |= 1 << idx                         opts.append((m, int(r0), int(c0), coords))             placements_other.append(opts)          def solve_with_fixed_legend(             legend_coords: tuple[tuple[int, int], ...],         ) -> dict[int, tuple[int, int, int, tuple[tuple[int, int], ...]]] | None:             legend_mask = 0             for dr, dc in legend_coords:                 idx = int(dr) * int(W) + int(dc)                 legend_mask |= 1 << idx              filtered: list[list[tuple[int, int, int, tuple[tuple[int, int], ...]]]] = []             for opts in placements_other:                 filtered.append([pl for pl in opts if (pl[0] & legend_mask) == 0])              remaining = set(range(len(other_pis)))             chosen: dict[int, tuple[int, int, int, tuple[tuple[int, int], ...]]] = {                 legend_idx: (legend_mask, 0, 0, legend_coords)             }              def search(used: int) -> bool:                 if not remaining:                     return used == all_mask                 empty = (~used) & all_mask                 if empty == 0:                     return False                 cell = (empty & -empty).bit_length() - 1                 # Branch over *any* remaining piece that can cover this cell.                 # (Picking only one \"best\" piece can miss valid tilings.)                 candidates = []                 for k in sorted(remaining):                     opts_k