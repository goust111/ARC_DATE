        sprite_to_color[sprite_idx] = color
        color_to_sprite[color] = sprite_idx

    assert len(sprite_to_color) == len(sprite_components) == 3
    return {
        "bg": bg,
        "sep_r": sep_r,
        "sep_color": sep_color,
        "upper": upper,
        "lower": lower,
        "anchors_by_color": anchors_by_color,
