+
+def _boxes_overlap(a: dict, b: dict) -> bool:
+    ar1 = int(a["r0"]) + int(a["height"]) - 1
+    ac1 = int(a["c0"]) + int(a["width"]) - 1
+    br1 = int(b["r0"]) + int(b["height"]) - 1
+    bc1 = int(b["c0"]) + int(b["width"]) - 1
