+        top_order = [color for color, _spec in sorted(specs.items(), key=lambda kv: (int(kv[1]["c0"]), int(kv[0])))]
+        left_order = [color for color, _spec in sorted(specs.items(), key=lambda kv: (int(kv[1]["r0"]), int(kv[0])))]
+        legend_options = [
