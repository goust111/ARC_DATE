-- generator (o5x) ---------------  # === CFG === SIDE_CHOICES = [8, 10, 12]                     # output square side lengths K = 2                                          # k*k quadrant grid (2*2 = 4 pieces) NUM_PIECES = K * K                             # total jigsaw pieces NUM_COLORS = 8                                 # 4 body + 4 palette, all distinct non-bg AREA_FRAC_LO = 0.08                           # min piece area as fraction of total AREA_FRAC_HI = 0.43                           # max piece area as fraction of total AREA_ABS_LO = 11                              # absolute min piece area (cells) AREA_ABS_HI = 62                              # absolute max piece area (cells) LEGEND_THRESHOLD = {8: 4, 10: 5, 12: 9}       # min extent threshold per side for legend L-shape LEGEND_CORE_SIZE = 4                           # legend always has a 4x4 filled corner block LEGEND_ARM_RANGE = range(1, 4)                 # arm width/height options for L-shape construction PARTITION_GROWTH_EXP = 1.45                    # exponent penalizing large regions during partition PARTITION_FRONTIER_EXP = 0.2                   # exponent boosting regions with wide frontiers PARTITION_SEED_JITTER = 0.2                    # random jitter when selecting seed cells INPUT_SIZE_LO = 20                             # min input grid side INPUT_SIZE_HI = 26                             # max input grid side DENSITY_LO = 0.15                              # min non-bg density target DENSITY_HI = 0.25                              # max non-bg density target SCATTER_BORDER = 1                             # border margin when placing pieces SCATTER_PADDING = 1                            # gap between piece bounding boxes GEN_RETRIES = 300                              # max attempts in generate_input()   def _area_bounds(side):     \"\"\"Min/max piece area for a given output side length.\"\"\"     total = side * side     return max(AREA_ABS_LO, math.ceil(AREA_FRAC_LO * total)), min(AREA_ABS_HI, 