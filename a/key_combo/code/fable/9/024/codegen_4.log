+    lower_h = int(rng.integers(_MIN_LOWER, _MAX_LOWER + 1))
+    width = int(rng.integers(_MIN_WIDTH, _MAX_WIDTH + 1))
+    if upper_h + 1 + lower_h > 30:
+        return None
