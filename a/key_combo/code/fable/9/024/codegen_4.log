+    for r_raw, c_raw in coords:
+        r = int(r_raw)
+        c = int(c_raw)
+        for nr, nc in _neighbors(region.shape, r, c, connectivity):
+            neighbor = int(region[nr, nc])
+            if neighbor not in {bg, int(color)}:
