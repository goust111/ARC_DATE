+def _nonblack_isolated(grid: np.ndarray) -> bool:
+    for r, c in np.argwhere(grid != BLACK):
+        for nr, nc in _neighbors4(int(r), int(c)):
+            if _in_bounds(grid.shape, nr, nc) and int(grid[nr, nc]) != BLACK:
+                return False
+    return True
