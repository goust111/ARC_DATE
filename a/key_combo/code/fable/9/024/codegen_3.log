+    return out
+
+
+def _anchor_candidates(height: int, width: int, parity: int) -> list[tuple[int, int]]:
+    cells = []
+    for r in range(ANCHOR_MARGIN, height - ANCHOR_MARGIN):
+        for c in range(ANCHOR_MARGIN, width - ANCHOR_MARGIN):
+            if (r + c) % 2 == parity:
+                cells.append((r, c))
+    return cells
+
