  grid: 6-9 rows x 8-12 cols
  background: any color except red(2), teal(8), grey(5); orange(7) [observed]
  markers:
    count: 6-10 isolated single-pixel foreground dots
    isolation: every marker has only background in its 4-connected neighbors
    colors: 3-4 distinct non-background colors, randomly assigned; may overlap with output cycle
    density: ~0.09-0.15 of total cells
    min_manhattan_distance: >=2 between any pair
  scan_direction:
    bbox: bounding box of all markers; row_extent and col_extent
    rule: row-major if row_extent >= col_extent, else col-major
    at_most_1_per_scanline: true [observed, not enforced by solver]
  output:
    positions: identical to input
    recolor: ordered markers get cyclic red(2), teal(8), grey(5) assignment
    ordering: row-major = sorted by (row, col); col-major = sorted by (col, row)

generation_strategy:
  approach: direct construction (task is recolor-in-place, no complex inversion needed)
  steps:
    1. Pick grid size H in [6,9], W in [8,12]
    2. Pick background color from {0..9} \ {2,8,5}
    3. Pick n_markers in [6,10]
    4. Decide scan direction; if row-major, ensure bbox row_extent >= col_extent, else col_extent > row_extent
    5. Place n_markers on distinct cells with Manhattan distance >=2 between all pairs and at most 1 per scan-line; verify isolation
    6. Pick 3-4 distinct non-background colors, assign randomly to markers
    7. Verify bbox extents match chosen scan direction; retry placement if not
