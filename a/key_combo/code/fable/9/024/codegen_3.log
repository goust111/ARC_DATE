+
+def _parity_output(grid: np.ndarray) -> np.ndarray:
+    out = np.asarray(grid, dtype=int).copy()
+    red_anchor = np.argwhere(out == RED)
+    green_anchor = np.argwhere(out == GREEN)
+    assert red_anchor.shape == (1, 2)
+    assert green_anchor.shape == (1, 2)
