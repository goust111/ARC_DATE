+        out[int(r), int(c)] = RED if _parity((int(r), int(c))) == red_phase else GREEN
+    return out
+
+
+def _nearest_anchor_output(grid: np.ndarray) -> np.ndarray:
+    out = np.asarray(grid, dtype=int).copy()
