+        chosen.append(coord)
+        used.add(coord)
+
+    remaining = [coord for coord in all_coords if coord not in used]
+    rng.shuffle(remaining)
+    chosen.extend(remaining[: n_rows - len(chosen)])
+    rng.shuffle(chosen)
+    return chosen
