+    assert row_lines[0] == 0 and row_lines[-1] == g.shape[0] - 1
+    assert col_lines[0] == 0 and col_lines[-1] == g.shape[1] - 1
+
+    row_steps = {b - a for a, b in zip(row_lines, row_lines[1:])}
+    col_steps = {b - a for a, b in zip(col_lines, col_lines[1:])}
