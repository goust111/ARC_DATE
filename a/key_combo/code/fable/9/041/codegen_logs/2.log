+def _polarity_mix(rng: np.random.Generator, n_rows: int) -> list[str]:
+    extras = int(rng.integers(1, n_rows))
+    polarities = ["extra"] * extras + ["missing"] * (n_rows - extras)
+    rng.shuffle(polarities)
+    return polarities
