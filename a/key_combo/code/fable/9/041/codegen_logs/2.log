            r0 = 1 + r * (cell_h + 1)
            c0 = 1 + c * (cell_w + 1)
            out[r0 : r0 + cell_h, c0 : c0 + cell_w] = cell
    return out


def _unique_coords(rng: np.random.Generator, cell_h: int, cell_w: int, n_rows: int) -> list[tuple[int, int]]:
