GEN_MARKER_COUNT, GEN_EDGE_COUNT = (5, 7), (2, 4)
GEN_RETRIES = 300

def _gen_marker_footprint_d364b489(r, c):
    cells = [(r, c)]
    for dr, dc, _ in GEN_NEIGHBORS:
        rr = r + dr
        cc = c + dc
        if in_bounds(GEN_GRID_SHAPE, rr, cc):
            cells.append((rr, cc))
    return frozenset(cells)

def _gen_expected_output_d364b489(grid):
