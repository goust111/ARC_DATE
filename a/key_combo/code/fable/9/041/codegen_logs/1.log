+        return False
+    return np.array_equal(actual, expected)
+
+
+def _attempt_generate() -> np.ndarray | None:
+    count = random.randint(*GEN_FRAME_COUNT_RANGE)
+    sizes = _sample_sizes(count, GEN_MAX_SHAPE_SPAN)
+    if sizes is None:
