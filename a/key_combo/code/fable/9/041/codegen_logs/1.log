+GEN_FRAME_COUNT_RANGE = (3, 5)
+GEN_SIZE_MIN = 5
+GEN_MAX_ATTEMPTS = 500
+GEN_MAX_SHAPE_SPAN = 24
+GEN_PADDING_RANGE = (1, 4)
