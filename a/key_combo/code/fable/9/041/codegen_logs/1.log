+
+    try:
+        actual = main(grid)
+    except Exception:
+        return False
+    return np.array_equal(actual, expected)
+
+
+def _attempt_generate() -> np.ndarray | None:
+    side = random.randint(*GEN_GRID_RANGE)
+    count = random.randint(*GEN_FRAME_COUNT_RANGE)
+    sizes = _sample_sizes(count, side)
+    if sizes is None:
+        return None
+
+    boxes = _place_chain(side, sizes)
+    if boxes is None:
+        return None
+
+    colors = random.sample(range(1, 10), count)
+    grid = _paint_frames(side, boxes, colors)
+    if not _validate_instance(grid, boxes, colors):
+        return None
+    return grid
+
