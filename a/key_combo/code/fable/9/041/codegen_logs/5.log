{
  "type": "move_along_path",
  "src": "3x3 sprite s with a uniform border color and a different control-color center",
  "path": "straight cardinal path from s toward d",
  "trajectory": "copy s every three cells until the first copied bbox overlaps d",
  "dst": "separate solid rectangle d whose color matches s.center",
  "transform": "copied sprites overwrite background/rectangle cells; all other input pixels remain unchanged"
}
</annotation>
