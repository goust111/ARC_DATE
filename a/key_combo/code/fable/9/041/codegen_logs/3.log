+def _mode_color(values: np.ndarray) -> int | None:
+    flat = values.astype(int).ravel()
+    counts = np.bincount(flat, minlength=10)
+    best = counts.max()
+    winners = np.flatnonzero(counts == best)
+    if winners.size != 1:
+        return None
+    return int(winners[0])
