+    best = _best_candidates(inp)
+    if len(best) != 1:
+        return False
+
+    info = best[0]
+    if tuple(info["periods"]) != periods:
+        return False
+    if not np.array_equal(info["ideal"], base):
+        return False
+    if info["diag_sum"] != option["diag_sum"]:
+        return False
+    if info["c0"] != option["c0"] or info["c1"] != option["c1"]:
+        return False
+    if info["length"] != option["length"]:
