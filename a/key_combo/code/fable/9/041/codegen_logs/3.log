+    cells: list[tuple[int, int]] = []
+    for c in range(c1 + 1, c1 + length + 2):
+        r = diag_sum - c
+        if not (0 <= r < h and 0 <= c < w):
+            return None
+        cells.append((r, c))
+    return cells
+
+
