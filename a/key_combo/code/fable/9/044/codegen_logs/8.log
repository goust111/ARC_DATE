+                "color": color,
+                "row": row,
+                "c0": c0,
+                "c1": c1,
+                "coords": coords,
+            }
+    if len(cols) == 1 and coords.shape[0] >= 3:
+        col = next(iter(cols))
+        r0 = int(coords[:, 0].min())
+        r1 = int(coords[:, 0].max())
+        if r1 - r0 + 1 == coords.shape[0]:
+            return {
+                "kind": "vertical",
+                "color": color,
+                "col": col,
+                "r0": r0,
+                "r1": r1,
