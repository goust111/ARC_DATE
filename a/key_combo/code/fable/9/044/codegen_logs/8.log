+        for rr in range(r, stop_scalar + 1):
+            out[rr, c] = color
+    elif direction == "bottom":
+        for rr in range(r, stop_scalar - 1, -1):
+            out[rr, c] = color
+    elif direction == "left":
+        for cc in range(c, stop_scalar + 1):
+            out[r, cc] = color
+    else:
+        for cc in range(c, stop_scalar - 1, -1):
+            out[r, cc] = color
