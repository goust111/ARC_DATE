+
+def _render_with_structure(grid: np.ndarray, outer: dict, inner: dict, seeds: list[dict], frame_mask: np.ndarray, center: tuple[int, int]) -> np.ndarray:
+    out = np.asarray(grid, dtype=int).copy()
