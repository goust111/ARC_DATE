+    outer = {"bbox": outer_bbox, **outer_colors}
+    inner = {"bbox": inner_bbox, **inner_colors}
+
+    seeds = []
+    for direction in DIRS:
+        r, c = _seed_coord(direction, outer_bbox, center, (height, width))
+        seeds.append(
+            {
+                "direction": direction,
+                "color": int(seed_colors[direction]),
+                "r": int(r),
+                "c": int(c),
+            }
