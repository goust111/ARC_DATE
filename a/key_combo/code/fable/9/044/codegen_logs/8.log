+from __future__ import annotations
+
+from collections import Counter
+import random
+
+import numpy as np
+
+
+BACKGROUND = 0
+DIRS = ("top", "bottom", "left", "right")
+STATUS_ORDER = ("outer_only", "inner_only", "both", "decoy")
+PALETTE = tuple(range(1, 10))
+GEN_ATTEMPTS = 400
