+        elif color == outer_side and color != inner_side:
+            matched_statuses.add("outer_only")
+        elif color != outer_side and color == inner_side:
+            matched_statuses.add("inner_only")
+        else:
+            matched_statuses.add("decoy")
+    assert matched_statuses == set(STATUS_ORDER)
+    assert len(stop_cells) == 4
