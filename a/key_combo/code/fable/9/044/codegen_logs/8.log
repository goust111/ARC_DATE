    if embedded_high < EMBEDDED_MIN:
        return None
    embedded_count = random.randint(EMBEDDED_MIN, embedded_high)
    return embedded_sites[:embedded_count]


def _choose_isolated_pairs(
    out: np.ndarray,
    blob: set[Cell],
    bg: int,
    dr: int,
