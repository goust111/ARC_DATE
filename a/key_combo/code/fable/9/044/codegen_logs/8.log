+
+
+def _sample_colors() -> tuple[dict[str, str], dict[str, int], dict[str, int], dict[str, int]]:
+    directions = list(DIRS)
+    random.shuffle(directions)
+    status_by_dir = dict(zip(directions, STATUS_ORDER))
