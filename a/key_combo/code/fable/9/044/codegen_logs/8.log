+    if len(rows) == 1 and coords.shape[0] >= 3:
+        row = next(iter(rows))
+        c0 = int(coords[:, 1].min())
+        c1 = int(coords[:, 1].max())
+        if c1 - c0 + 1 == coords.shape[0]:
+            return {
