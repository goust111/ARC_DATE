+        inner_w = random.choice(tuple(range(5, outer_w - 3, 2)))
+        top_margin = random.randint(2, 6)
+        bottom_margin = random.randint(2, 6)
+        left_margin = random.randint(2, 6)
+        right_margin = random.randint(2, 6)
