+
+def _seed_coord(direction: str, outer: tuple[int, int, int, int], center: tuple[int, int], shape: tuple[int, int]) -> tuple[int, int]:
+    r0, c0, r1, c1 = outer
+    cr, cc = center
+    height, width = shape
