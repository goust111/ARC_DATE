+
+def _find_divider_color(grid: np.ndarray) -> int:
+    best_color = None
+    best_score = -1
+    for color in np.unique(grid):
+        rows, cols = _full_line_indices(grid, int(color))
+        if len(rows) < 3 or len(cols) < 3:
+            continue
