+    return divider, int(size), list(regions)
+
+
+def _corner_coords(bounds: tuple[int, int, int, int]) -> list[tuple[int, int]]:
+    rs, re, cs, ce = bounds
+    return [
+        (rs - 1, cs - 1),
+        (rs - 1, ce + 1),
+        (re + 1, ce + 1),
+        (re + 1, cs - 1),
+    ]
