    if _gen_matches_oracle(grid, masks, colors, counts):
        return grid
    return None


def generate_input() -> np.ndarray:
    for _ in range(_GEN_RETRY_LIMIT):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid 39a8645d input")

