+def _component_count(mask: np.ndarray) -> int:
+    seen: set[tuple[int, int]] = set()
+    count = 0
+    for r, c in np.argwhere(mask):
+        node = (int(r), int(c))
+        if node in seen:
+            continue
+        count += 1
+        queue = deque([node])
+        seen.add(node)
+        while queue:
+            rr, cc = queue.popleft()
+            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                nr, nc = rr + dr, cc + dc
+                nxt = (nr, nc)
+                if (
+                    0 <= nr < mask.shape[0]
+                    and 0 <= nc < mask.shape[1]
+                    and mask[nr, nc]
+                    and nxt not in seen
