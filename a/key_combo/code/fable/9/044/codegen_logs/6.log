+        dtype=int,
+    ),
+)
+LAYOUTS = tuple(
+    (size, n_rows, n_cols)
+    for size in (5, 7)
+    for n_rows in (2, 3)
+    for n_cols in (2, 3)
+    if max(
+        n_rows * size + (n_rows + 1) * DIVIDER_BAND,
+        n_cols * size + (n_cols + 1) * DIVIDER_BAND,
