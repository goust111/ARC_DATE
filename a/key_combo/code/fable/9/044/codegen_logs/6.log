+        patch = _render_region(
+            size=size,
+            template_idx=spec["template"],
+            visible_anchor_quadrant=spec["current"],
+            body_rotation=spec["body_rotation"],
+            body_color=spec["body_color"],
+            anchor_color=spec["anchor_color"],
