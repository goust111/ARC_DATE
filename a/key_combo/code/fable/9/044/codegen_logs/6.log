+def _try_regions(
+    grid: np.ndarray, divider: int, row_seq: tuple[int, ...], col_seq: tuple[int, ...]
+) -> tuple[int, list[tuple[int, int, int, int]]] | None:
+    if len(row_seq) < 3 or len(col_seq) < 3:
+        return None
