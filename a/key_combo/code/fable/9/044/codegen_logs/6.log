+
+def _progression_candidates(indices: np.ndarray) -> list[tuple[int, ...]]:
+    values = sorted(set(map(int, indices)))
+    value_set = set(values)
+    candidates: set[tuple[int, ...]] = set()
+    for i, start in enumerate(values):
