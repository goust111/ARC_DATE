        if step is None:
            assert r + 1 < out_h
            out[r : r + 2, c] = Color.RED
            r += 2
        else:
            next_c = c + step
            assert 0 <= next_c < out_w
            out[r, c] = Color.RED
            out[r, next_c] = Color.RED
            r += 1
            c = next_c

    assert r == out_h
    return out

