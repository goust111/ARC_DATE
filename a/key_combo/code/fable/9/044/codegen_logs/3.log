    counts = [random.randint(_GEN_MIN_YELLOW_CELLS, _GEN_MAX_YELLOW_CELLS) for _ in range(_GEN_OBJECT_COUNT)]
    return [random.choice(_GEN_PATTERNS_BY_COUNT[k]).copy() for k in counts]


