def _gen_pick_counts() -> list[int]:
    total = random.randint(min(_GEN_COUNT_OPTIONS_BY_TOTAL), max(_GEN_COUNT_OPTIONS_BY_TOTAL))
    counts = list(random.choice(_GEN_COUNT_OPTIONS_BY_TOTAL[total]))
    random.shuffle(counts)
