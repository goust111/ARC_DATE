            leaves_top_or_bottom_black = not (min(r0, r1) == 0 and max(r0, r1) == _GEN_TOP_LEFT_MAX)
            if separated and leaves_top_or_bottom_black:
                pairs.append(((r0, c0), (r1, c1)))
    return pairs


