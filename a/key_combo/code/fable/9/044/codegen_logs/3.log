            _, n_components = label_mask(mask, connectivity=_GEN_CONNECTIVITY)
            if n_components == 1:
                pools[cells].append(mask)
    return pools


_GEN_MASKS_BY_CELLS = _gen_valid_masks_by_cells()


def _gen_pattern_key(mask: np.ndarray) -> tuple[tuple[int, ...], ...]:
