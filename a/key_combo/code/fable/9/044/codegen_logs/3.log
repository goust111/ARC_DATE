                or r1 + _GEN_BOX_SIZE + _GEN_MIN_BOX_GAP <= r0
                or c0 + _GEN_BOX_SIZE + _GEN_MIN_BOX_GAP <= c1
                or c1 + _GEN_BOX_SIZE + _GEN_MIN_BOX_GAP <= c0
