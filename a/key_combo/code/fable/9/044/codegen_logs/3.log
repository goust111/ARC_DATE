+    pos_to_idx = {coord: idx for idx, coord in enumerate(pos)}
+    perm = [pos_to_idx[holes[coord]] for coord in pos]
+    cycle_lengths = sorted(len(cycle) for cycle in _cycles_from_permutation(perm))
+    if cycle_lengths[-1] < 2:
+        return False
