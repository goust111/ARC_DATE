+        if np.max(runs) == 1:
+            continue
+        if int(runs.sum()) > _GEN_PATTERN_MAX_DIM:
+            continue
+        return runs
+    return None
+
+
+def _uniform_partition_reduce(stretched: np.ndarray, k: int) -> np.ndarray | None:
+    h, w = stretched.shape
+    if h % k != 0 or w % k != 0:
+        return None
+
+    rh = h // k
+    cw = w // k
+    out = np.empty((k, k), dtype=stretched.dtype)
