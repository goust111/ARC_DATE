+_GEN_ATTEMPTS = 500
+_GEN_K_CHOICES = (3, 4, 5, 6)
+_GEN_PATTERN_REPEAT_MAX = 4
+_GEN_PATTERN_MAX_DIM = 15
+_GEN_MARGIN_MAX = 3
+_GEN_GAP_MIN = 2
+_GEN_GAP_MAX = 4
