+def _run_start_indices(lines: np.ndarray) -> list[int]:
+    keep = [0]
+    for idx in range(1, lines.shape[0]):
+        if not np.array_equal(lines[idx], lines[idx - 1]):
+            keep.append(idx)
+    return keep
+
