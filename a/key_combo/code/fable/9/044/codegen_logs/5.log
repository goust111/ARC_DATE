        src_region = g[r0 : r1 + 1, c0 : c1 + 1]
        missing = src_region == bg
        assert np.any(missing), "expected at least one missing cell inside each bbox"

        dst_region = out[r0 : r1 + 1, c0 : c1 + 1]
        dst_region[missing] = Color.ORANGE

    return out

