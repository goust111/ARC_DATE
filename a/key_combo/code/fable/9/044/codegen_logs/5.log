+    grid[r1, c0 : c1 + 1] = RED
+    grid[r0 : r1 + 1, c0] = RED
+    grid[r0 : r1 + 1, c1] = RED
+
+
+def _build_slot_item(
+    slot_index: int,
+    side: str,
