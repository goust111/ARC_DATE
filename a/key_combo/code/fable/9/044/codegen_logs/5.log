+        for frame in frame_comps:
+            frame_box = frame["bbox"]
+            inner_comp = inside_for_frame[frame_box]
+            matched = _pair_side_and_gap(frame_box, inner_comp["bbox"], outer_comp["bbox"])
+            if matched is not None:
