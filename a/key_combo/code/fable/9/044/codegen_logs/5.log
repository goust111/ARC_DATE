+        for bits in range(1, 1 << cells):
+            count = bits.bit_count()
+            if count < 6 or count > cells - 2:
+                continue
+            mask = np.zeros((h, w), dtype=bool)
+            for idx in range(cells):
+                if bits & (1 << idx):
+                    mask[idx // w, idx % w] = True
