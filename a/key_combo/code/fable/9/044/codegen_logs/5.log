+        inner_visible = _mirror(inner_outer, side)
+        return {
+            "side": side,
+            "complete": complete,
+            "frame_box": frame_box,
+            "outer_box": outer_box,
+            "inner_box": inner_box,
+            "truth": truth.copy(),
+            "outer_visible": outer_visible,
+            "inner_visible": inner_visible,
+        }
