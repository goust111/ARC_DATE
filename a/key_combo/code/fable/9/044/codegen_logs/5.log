+
+    pairs: list[dict] = []
+    used_outer: set[int] = set()
+    for frame in sorted(frame_comps, key=lambda item: item["bbox"]):
+        frame_box = frame["bbox"]
+        assert frame_box in inside_for_frame, "each frame needs an inner sprite"
+        inner_comp = inside_for_frame[frame_box]
+        matches: list[tuple[int, str]] = []
+        for idx, outer_comp in enumerate(outer_components):
+            side = _pair_side(frame_box, inner_comp["bbox"], outer_comp["bbox"])
+            if side is not None:
+                matches.append((idx, side))
+        assert len(matches) == 1, "frame-to-outer pairing must be unique"
+        idx, side = matches[0]
+        assert idx not in used_outer, "outer sprite reused"
+        used_outer.add(idx)
+        pairs.append(
+            {
+                "frame_box": frame_box,
+                "inner_box": inner_comp["bbox"],
+                "outer_box": outer_components[idx]["bbox"],
+                "side": side,
+            }
+        )
