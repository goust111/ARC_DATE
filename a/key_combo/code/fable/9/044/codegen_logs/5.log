+def _same_bbox(mask: np.ndarray, shape: tuple[int, int]) -> bool:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return False
+    return _bbox(coords) == (0, 0, shape[0] - 1, shape[1] - 1)
+
