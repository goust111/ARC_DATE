+            inner_c0 = outer_c0
+
+        frame_box = (frame_r0, frame_c0, frame_r0 + frame_h - 1, frame_c0 + frame_w - 1)
+        outer_box = (outer_r0, outer_c0, outer_r0 + sh - 1, outer_c0 + sw - 1)
+        inner_box = (inner_r0, inner_c0, inner_r0 + sh - 1, inner_c0 + sw - 1)
