+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 0
+RED = 2
+YELLOW = 4
+GRAY = 5
+
+SLOT = 15
+GRID_SIZE = SLOT * 2
+USABLE = SLOT - 1
+SIDES = ("left", "right", "top", "bottom")
+H_SIDES = ("left", "right")
+V_SIDES = ("top", "bottom")
+MASK_DIMS = ((3, 3), (3, 4), (4, 3), (4, 4), (3, 5), (5, 3))
+GEN_RETRY_LIMIT = 400
+
+NEIGHBORS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+NEIGHBORS8 = tuple(
+    (dr, dc)
+    for dr in (-1, 0, 1)
+    for dc in (-1, 0, 1)
+    if not (dr == 0 and dc == 0)
+)
+
