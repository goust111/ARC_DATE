+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 0
+RED = 2
+YELLOW = 4
+GRAY = 5
+
+SLOT = 15
+GRID_SIZE = SLOT * 2
+USABLE = SLOT - 1
+SIDES = ("left", "right", "top", "bottom")
+H_SIDES = ("left", "right")
+V_SIDES = ("top", "bottom")
+MASK_DIMS = ((3, 3), (3, 4), (4, 3), (4, 4), (3, 5), (5, 3))
+GEN_RETRY_LIMIT = 400
+
+NEIGHBORS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+NEIGHBORS8 = tuple(
+    (dr, dc)
+    for dr in (-1, 0, 1)
+    for dc in (-1, 0, 1)
+    if not (dr == 0 and dc == 0)
+)
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _bbox_shape(box: tuple[int, int, int, int]) -> tuple[int, int]:
+    r0, c0, r1, c1 = box
+    return int(r1 - r0 + 1), int(c1 - c0 + 1)
+
+
+def _crop(grid: np.ndarray, box: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = box
+    return grid[r0 : r1 + 1, c0 : c1 + 1]
+
+
+def _paste_mask(
+    grid: np.ndarray, box: tuple[int, int, int, int], mask: np.ndarray, color: int
+) -> None:
+    r0, c0, r1, c1 = box
+    assert mask.shape == (r1 - r0 + 1, c1 - c0 + 1)
+    grid[r0 : r1 + 1, c0 : c1 + 1][mask] = int(color)
+
+
+def _find_components(grid: np.ndarray, color: int, connectivity: int) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    neighbors = NEIGHBORS4 if connectivity == 4 else NEIGHBORS8
+    comps: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(g[r, c]) != int(color):
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                for dr, dc in neighbors:
+                    nr = rr + dr
+                    nc = cc + dc
+                    if (
+                        0 <= nr < h
+                        and 0 <= nc < w
+                        and not seen[nr, nc]
+                        and int(g[nr, nc]) == int(color)
+                    ):
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            coords = np.asarray(cells, dtype=int)
+            comps.append(
+                {
+                    "color": int(color),
+                    "coords": coords,
+                    "bbox": _bbox(coords),
+                    "area": int(coords.shape[0]),
+                }
+            )
+    return comps
+
+
+def _mask_connected(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return False
+    seen = {tuple(int(x) for x in coords[0])}
+    q = deque([tuple(int(x) for x in coords[0])])
+    h, w = mask.shape
+    while q:
+        r, c = q.popleft()
+        for dr, dc in NEIGHBORS8:
+            nr = r + dr
+            nc = c + dc
