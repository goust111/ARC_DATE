+BG = 0
+SHADOW = 2
+OBJECT_COLORS = (1, 3, 4, 5, 6, 7, 8, 9)
+DIRS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
