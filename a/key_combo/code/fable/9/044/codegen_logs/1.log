    Work area (18x16) holds 4 blocks in a 2x2 grid with 2-cell gaps.
    Blocks start 1 row from top; 2-col gap between panel and blocks.
  panel:
    color: 8
    size: 18x6
    legend_entries: 4 shapes, each a single 8-connected component in a 3x3 bbox
    legend_cell_count: 4-7 per shape
    legend_colors: 4 distinct colors (may include base or marker color)
    shapes_d4_distinct: all 4 legend shapes must be pairwise distinct under D4 (rotation+reflection)
    shape_placement: non-overlapping 3x3 regions within panel, 1-3 row gaps between them
  blocks:
    count: 4 (2x2 arrangement), each exactly 5x5 solid non-bg
    base_color: 2 [observed]
    marker_color: 1 [observed]
    types: 0-2 solid + 2-4 encoded, totaling 4
    solid_block: filled entirely with one legend color
    encoded_block: border ring is base_color, inner 3x3 has marker_color cells forming a D4 variant of one legend shape (centered)
    bijection: each block maps to a unique legend color (1-to-1)
  transform:
    solid_to_encoded: replace solid block with base_color frame + centered legend shape in marker_color
    encoded_to_solid: identify marker shape via D4 match to legend, fill entire block with matched legend color

generation_strategy:
