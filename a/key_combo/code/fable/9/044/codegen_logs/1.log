+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 0
+SHADOW = 2
+OBJECT_COLORS = (1, 3, 4, 5, 6, 7, 8, 9)
+DIRS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+
+
+def _bbox_dims(box: tuple[int, int, int, int]) -> tuple[int, int]:
+    r0, c0, r1, c1 = box
+    return r1 - r0 + 1, c1 - c0 + 1
+
+
+def _shift_box(
+    box: tuple[int, int, int, int], dr: int, dc: int, distance: int
+) -> tuple[int, int, int, int]:
+    r0, c0, r1, c1 = box
+    return (
+        r0 + dr * distance,
+        c0 + dc * distance,
+        r1 + dr * distance,
+        c1 + dc * distance,
+    )
+
+
+def _in_bounds(shape: tuple[int, int], box: tuple[int, int, int, int]) -> bool:
+    h, w = shape
+    r0, c0, r1, c1 = box
+    return 0 <= r0 <= r1 < h and 0 <= c0 <= c1 < w
+
+
+def _crop(grid: np.ndarray, box: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = box
+    return grid[r0 : r1 + 1, c0 : c1 + 1]
+
+
+def _fill_box(grid: np.ndarray, box: tuple[int, int, int, int], color: int) -> None:
+    r0, c0, r1, c1 = box
+    grid[r0 : r1 + 1, c0 : c1 + 1] = int(color)
+
+
+def _find_components(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if color == BG or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(g[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
