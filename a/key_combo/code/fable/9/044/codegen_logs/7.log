+    out = np.zeros((len(ordered), max(count for _key, count, _color in ordered)), dtype=int)
+    for row, (_key, count, color) in enumerate(ordered):
+        out[row, :count] = color
+    return out
+
+
+def main(grid: np.ndarray) -> np.ndarray:
