+    assert len(colors) == count
+    assert len(set(colors)) >= 2
+    return colors
+
+
+def _sample_layout(total_sprites: int) -> tuple[int, int, list[tuple[int, int]]]:
+    choices = []
+    for slot_rows in range(3, 8):
