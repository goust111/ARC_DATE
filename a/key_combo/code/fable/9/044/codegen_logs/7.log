  colors:
    num_distinct: 5-6
    frequency_distribution: exactly one color has count 3 (the dominant); remaining 4-5 colors split the other 6 cells with counts in {1, 2}
    dominant_color: unique — no ties for the maximum frequency
    palette: any 5-6 distinct colors from 0-9
