spec:
  grid: 16x16 [observed]
  background: 7 [observed]
  fg_colors: 2-5 distinct, all different from background
  shapes:
    completable:
      count: 1-2
      types: filled rectangle (incl. h/v lines) or 45-degree diagonal line
      rect_dims: 1-6 rows x 1-16 cols (min side >= 1)
      diag_length: up to 15 cells, main or anti-diagonal
      constraint: every cell in the shape's bbox (rect) or diagonal must be fg (no bg); at least 1 cell is occluded by another fg color
      hidden_fraction: 0.10-0.57
      no_mutual_overlap: completable footprints must not share any cell
    occluder:
      count: 1-3
      types: typically filled rectangle, but can be any fg region (e.g. right triangle)
      constraint: must NOT trigger bbox_footprint (its input bbox has no other fg colors) or diagonal_footprint (not on a diagonal or has bg on the diagonal)
      simplest_form: filled rectangle with no bg in bbox and no other fg in bbox -> solver skips it as already complete
  overlap:
    each_completable_must_overlap: at least 1 occluder
    at_overlap_cells: input shows the occluder's color; output restores the completable shape's color
    total_fg_pixels: unchanged between input and output
  placement: shapes may touch grid edges; margins >= 0

generation_strategy:
  approach: output-first
  steps:
    1. Choose grid 16x16, bg=7, pick 2-5 distinct fg colors
    2. Assign each color a role - completable (1-2) or occluder (1-3)
    3. For each completable shape, define its true footprint (filled rect or 45-degree diagonal)
    4. For each occluder, define a filled rectangle whose bbox has no bg and no other fg colors in it (simplest valid form)
    5. Place shapes so each completable shape partially overlaps at least 1 occluder, with no bg gaps in the completable's bbox/diagonal; completable footprints must not mutually overlap
    6. Build the OUTPUT grid by painting all shapes at their true footprints (completable shapes win at overlaps)
    7. Build the INPUT grid by painting occluder colors over completable shapes at overlap cells (occluder wins at overlaps in input)
    8. Validate: for each completable shape, its bbox (or diagonal) contains no bg and at least 1 other-color cell; no two completable shapes conflict; at least 1 hidden pixel exists
