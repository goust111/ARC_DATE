0013: def main(input_grid):
0014:     """
0015:     Color every third black region between a red bouncing divider line yellow.
0016: 
0017:     Input structure:
0018:     - The input is a black grid split by a red line.
0019:     - The red line acts as a boundary between connected black regions.
0020:     - Regions are ordered from left to right by their bounding boxes.
0021: 
0022:     Rule:
0023:     - Find connected regions using red as the separating background.
0024:     - Sort the regions from left to right.
0025:     - Flood-fill regions with indices 0, 3, 6, and so on with yellow.
0026: 
0027:     Key insight:
0028:     - The red path partitions the grid; the fill pattern is determined by region order.
0029:     """
0030:     # copy the input grid to the output grid
0031:     output_grid = np.copy(input_grid)
0032: 
0033:     # find the black regions in the input grid
0034:     bg = Color.RED
0035:     black_regions = find_components(
0036:         input_grid,
0037:         bg=bg,
0038:         connectivity=4,
0039:         monochromatic=True,
0040:         return_format="objects",
0041:     )
0042: 
0043:     # sort the regions from left to right using the coordinates of their bounding boxes
0044:     black_regions = sorted(black_regions, key=lambda region: bbox(region != bg)[1])
0045: 
0046:     # color every third black region yellow using flood fill
0047:     for i, region in enumerate(black_regions):
0048:         if i % 3 == 0:
0049:             rr, cc = np.argwhere(region != bg)[0]
0050:             flood_fill(output_grid, int(rr), int(cc), Color.YELLOW, connectivity=4)
0051: 
0052:     return output_grid
0053: 
0054: 
0055: 
0056: def generate_input():
0057:     # make a black grid that is 3 cells tall and between 10 and 20 cells wide
0058:     grid = np.zeros((np.random.randint(10,20), 3), dtype=int)
0059: 
0060:     # make a red line that starts in the top left corner and bounces off the borders of the grid until it reaches the right side of the grid
0061:     r, c = 0, 0
0062:     dr, dc = 1, 1
0063:     # go until we reach the right side of the grid
0064:     while r < grid.shape[0]:
0065:         # make the current cell red
0066:         grid[r, c] = Color.RED
0067:         # if we are at the top or bottom of the grid, bounce off the top or bottom border
0068:         if c + dc >= grid.shape[1]:
0069:             dc = -1
0070:         elif c + dc < 0:
0071:             dc = 1
0072:         r += dr
0073:         c += dc
0074: 
0075:     return grid
