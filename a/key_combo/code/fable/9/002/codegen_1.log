0060:     if _loc is None:
0061:         raise ValueError("no placement")
0062:     r, c = _loc
0063: 
0064:     # remove a random section of the sprite to make it not radially symmetric
0065:     remove_length = np.random.randint(1, sprite_size//4)
0066:     quadrant = np.random.choice(['north', 'south', 'east', 'west'])
0067:     if quadrant == 'north':
0068:         sprite[sprite_size//2 - remove_length : sprite_size//2 + remove_length, : sprite_size//2] = Color.BLACK
0069:     elif quadrant == 'south':
0070:         sprite[sprite_size//2 - remove_length : sprite_size//2 + remove_length, sprite_size//2 :] = Color.BLACK
0071:     elif quadrant == 'east':
0072:         sprite[: sprite_size//2, sprite_size//2 - remove_length : sprite_size//2 + remove_length] = Color.BLACK
0073:     elif quadrant == 'west':
0074:         sprite[sprite_size//2 :, sprite_size//2 - remove_length : sprite_size//2 + remove_length] = Color.BLACK
