0098: def _make_output_and_pools():
0099:     """Return the oracle output, required minority colors, and allowed noise colors."""
0100:     out = np.full((ROWS + 2, COLS + 2), BG, dtype=int)
0101:     target_distinct = random.choice(TARGET_DISTINCT)
0102:     majority_pool = random.sample(PALETTE, random.randint(*MAJORITY_DISTINCT_RANGE))
