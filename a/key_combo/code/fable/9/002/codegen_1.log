0015: def main(input_grid):
0016:     """
0017:     Place each large multicolor object over the sparse matching pixels after trying rotations and flips.
0018: 
0019:     Input structure:
0020:     - The input contains one or two larger multicolor objects on a black background.
0021:     - It also contains small clusters of colored pixels that are partial views of those objects.
0022:     - Objects may need rotation or reflection to align with their pixel guides.
0023: 
0024:     Rule:
0025:     - Separate large objects from small pixel clusters.
0026:     - Generate rotated and flipped variants of each large object.
0027:     - Choose the placement and variant that covers the most guide pixels without any color mismatch.
0028: 
0029:     Key insight:
0030:     - The sparse pixels are anchors for transformed copies: color-consistent overlap identifies both
0031:       the orientation and the position of each object.
0032:     """
0033:     # Plan:
0034:     # 1. Break the input into 1-2 big object(s) and a mask containing the remaining pixels
0035:     # 2. For each object, create rotations and flips of it
0036:     # 3. For each object, find the best way to place one of its rotations/flips so that it covers the most number of the pixels (remember the pixel has to match object color)
0037: 
0038:     # Extract the objects from the input and categorize them into objects and pixels
0039:     # Objects can be multicolored
0040:     connected_components = find_components(input_grid, bg=Color.BLACK, connectivity=4, monochromatic=False, return_format="objects")
0041:     objects = [ cc for cc in connected_components if np.count_nonzero(cc != Color.BLACK) > 4 ]
0042:     pixels = [ cc for cc in connected_components if np.count_nonzero(cc != Color.BLACK) <= 4 ]
0043: 
0044:     # Make the pixel mask, which shows where the pixels are. These guide the placement of objects.
0045:     pixel_mask = np.full(input_grid.shape, Color.BLACK)
0046:     for pixel_object in pixels:
0047:         paste(pixel_mask, pixel_object, 0, 0, transparent=Color.BLACK, clip=True)
0048:     
0049:     output_grid = np.full(input_grid.shape, Color.BLACK)
0050:     
0051:     # For each object, find the best way to place it so that it covers the most number of the pixels
0052:     for obj in objects:
0053:         # The object can be rotated and flipped to match the pixels
0054:         # First, convert it to a sprite before transforming, because these operations are independent of position
0055:         _b = bbox(obj != Color.BLACK)
0056:         assert _b is not None
0057:         sprite = crop_bbox(obj, _b)
0058:         sprite_variations = [sprite, np.rot90(sprite), np.rot90(sprite, 2), np.rot90(sprite, 3), np.flipud(sprite), np.fliplr(sprite), np.flipud(np.rot90(sprite)), np.fliplr(np.rot90(sprite))]
0059: 
0060:         # We are going to optimize the position and variation, so we need to keep track of the best placement so far
0061:         best_output, best_pixels_covered = None, 0
0062:         for r, c, sprite_variation in [(r, c, variant) for r in range(input_grid.shape[0]) for c in range(input_grid.shape[1]) for variant in sprite_variations]:
0063:             test_grid = np.copy(output_grid)
0064:             paste(test_grid, sprite_variation, r, c, transparent=Color.BLACK, clip=True)
0065:             # Check if there was any color mismatch: A colored pixel in the mask which is different from what we just made
0066:             # If there is a mismatch, we can't place the object here
0067:             if np.any((pixel_mask != Color.BLACK) & (test_grid != Color.BLACK) & (pixel_mask != test_grid)):
0068:                 continue
0069:             num_covered_pixels = np.count_nonzero((pixel_mask != Color.BLACK) & (test_grid != Color.BLACK))
0070:             if num_covered_pixels > best_pixels_covered:
0071:                 best_output, best_pixels_covered = test_grid, num_covered_pixels
0072:         output_grid = best_output
0073: 
0074:     return output_grid
0075: 
0076: 
0077: def generate_input():
0078:     # to make the input, we make random objects
0079:     # we need to make sure that the objects can match with the "sprinkled" pixels, so we make the pixels by placing some objects and then removing some parts of them
0080: 
0081:     n, m = np.random.randint(10, 20), np.random.randint(10, 20)
0082:     grid = np.full((m, n), Color.BLACK)
0083: 
0084:     num_objects = np.random.randint(1, 3)
0085:     sprites = [ random_sprite(np.random.randint(3, 6), np.random.randint(3, 6), color_palette=Color.NOT_BLACK, density=0.5)
0086:                 for _ in range(num_objects) ]
0087:     sprite_variations = [ [sprite, np.rot90(sprite, k=-1), np.rot90(sprite,-(2)), np.rot90(sprite,-(3)), np.fliplr(sprite), np.flipud(sprite), np.fliplr(np.rot90(sprite, k=-1)), np.flipud(np.rot90(sprite, k=-1))]
0088:                           for sprite in sprites ]
0089:     # Pick a variation for each sprite
0090:     sprite_variations = [ random.choice(variations) for variations in sprite_variations ]
0091:     
0092:     # Remove parts of the sprite to create the "sprinkled" pixels
0093:     # We remove enough of the sprite so that there are only 3 pixels remaining
0094:     # We do this to the variation, which is what is going to be put on the canvas to be matched with
0095:     occluded_sprites = []
0096:     for sprite in sprite_variations:
0097:         occluded_sprite = np.copy(sprite)
0098:         could_be_removed = np.argwhere(occluded_sprite != Color.BLACK)
0099:         np.random.shuffle(could_be_removed)
0100:         for i in range(len(could_be_removed) - 3):
0101:             r, c = could_be_removed[i]
0102:             occluded_sprite[r, c] = Color.BLACK
0103: 
0104:         occluded_sprites.append(occluded_sprite)
0105: 
0106:     # place everything on the canvas but make sure that nothing overlaps
0107:     for sprite in sprites + occluded_sprites:
0108:         _loc = first_free_location(grid, sprite, transparent=Color.BLACK, border=2, padding=2, padding_connectivity=8)
0109:         if _loc is None:
0110:             # Retry generation (placement can fail due to padding constraints).
0111:             return generate_input()
0112:         r, c = _loc
0113:         paste(grid, sprite, r, c, transparent=Color.BLACK, clip=True)
0114:     
