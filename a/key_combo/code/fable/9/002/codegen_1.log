0013: def main(input_grid):
0014:     """
0015:     Mark the one-step clockwise rotational completions of a blue shape in red.
0016: 
0017:     Input structure:
0018:     - The input contains blue pixels forming an almost rotationally symmetric object.
0019:     - One directional section is missing and appears as black.
0020:     - Black is the background and red is reserved for needed completion pixels.
0021: 
0022:     Rule:
0023:     - Detect the rotational symmetry center of the blue object.
0024:     - Rotate every blue pixel one quarter-turn clockwise.
0025:     - If the rotated location is black, color it red.
0026: 
0027:     Key insight:
0028:     - The output does not fully recolor the object; it highlights only the missing clockwise
0029:       counterparts required by the rotational pattern.
0030:     """
0031:     # Uses the library function `detect_rotational_symmetry`.
0032:     
0033:     # Plan:
0034:     # 1. Detect the (x,y) point that the object is rotated around
0035:     # 2. Rotate each blue colored pixel around that point. If the rotated pixel is not colored, color it red.
0036: 
0037:     output_grid = np.copy(input_grid)
0038: 
0039:     # Find the symmetry
0040:     sym = detect_rotational_symmetry(input_grid, ignore_colors=[Color.BLACK], background=Color.BLACK)
0041:     
0042:     # Rotate the blues and color red as needed
0043:     blues = np.argwhere(input_grid == Color.BLUE)
0044:     for r, c in blues:
0045:         rr, cc = sym.apply(int(r), int(c), iters=1)
0046:         if input_grid[rr, cc] == Color.BLACK:
0047:             output_grid[rr, cc] = Color.RED
0048:     
0049:     return output_grid
0050: 
