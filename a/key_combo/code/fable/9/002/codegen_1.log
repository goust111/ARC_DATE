+            noise_count = random.randint(1, max_noise) if (r, c) in noisy_positions else 0
+            grid[r0 : r0 + block_h, c0 : c0 + block_w] = _paint_noisy_block(
+                int(layout[r, c]), grey, (block_h, block_w), noise_count
