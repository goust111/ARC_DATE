0135: def main(grid: np.ndarray) -> np.ndarray:
0136:     """
0137:     Complete partial workspace sprites by matching them to full templates shown in the non-black catalog region.
0138: 
0139:     Input structure
0140:     - A large non-black connected region is the catalog background.
0141:     - Multi-color template sprites touch that catalog background; all other
0142:       foreground objects lie in the black workspace.
0143:     - Some workspace objects are partial views of a catalog template, while
0144:       distractor objects do not match any template part.
0145: 
0146:     Rule
0147:     - For each workspace object, find the unique catalog template that it matches:
0148:       either a full template bbox filled with one template border color, a
0149:       uniquely sized single-color mask of the template, or a multi-color boundary
0150:       window of the template.
0151:     - Stamp the full matched template at the aligned position, treating catalog
0152:       background cells inside the template bbox as transparent.
0153:     - Leave workspace objects with no template match unchanged.
0154: 
0155:     Key insight
0156:     - The colored objects in the catalog are not to be copied in order; they are
0157:       a legend of target sprites, and each incomplete workspace object determines
0158:       its template and alignment from the visible sub-sprite it already contains.
0159:     """
0160:     g = np.asarray(grid, dtype=int)
0161:     assert g.ndim == 2, "expected a 2D grid"
0162: 
0163:     catalog_color, catalog_mask = _catalog_background(g)
0164:     templates = _templates(g, catalog_color, catalog_mask)
0165: 
0166:     planned: dict[tuple[int, int], int] = {}
0167:     workspace = (g != 0) & (~catalog_mask)
0168:     for coords in components_mask(workspace, connectivity=8):
0169:         if _touches(catalog_mask, coords):
0170:             continue
0171: 
0172:         box, part = _component_array(g, coords)
0173:         r0, c0, _r1, _c1 = box
0174:         source_mask = np.zeros_like(g, dtype=bool)
0175:         source_mask[coords[:, 0], coords[:, 1]] = True
0176: 
0177:         matches = []
0178:         for template in templates:
0179:             sprite = template["grid"]
0180:             for off_r, off_c in _template_offsets(part, template):
0181:                 anchor_r, anchor_c = r0 - off_r, c0 - off_c
0182:                 height, width = map(int, sprite.shape)
0183:                 if not (
0184:                     0 <= anchor_r
0185:                     and 0 <= anchor_c
0186:                     and anchor_r + height <= g.shape[0]
0187:                     and anchor_c + width <= g.shape[1]
0188:                 ):
0189:                     continue
0190: 
0191:                 ok = True
0192:                 for rr, cc in np.argwhere(template["visible"]):
0193:                     gr, gc = anchor_r + int(rr), anchor_c + int(cc)
0194:                     value = int(sprite[rr, cc])
0195:                     if g[gr, gc] != 0 and not source_mask[gr, gc] and g[gr, gc] != value:
0196:                         ok = False
0197:                         break
0198:                 if ok:
0199:                     cells = tuple(
0200:                         (int(rr), int(cc), int(sprite[rr, cc]))
0201:                         for rr, cc in np.argwhere(template["visible"])
0202:                     )
0203:                     matches.append((anchor_r, anchor_c, cells))
0204: 
0205:         unique_matches = []
0206:         seen = set()
0207:         for match in matches:
0208:             if match not in seen:
0209:                 seen.add(match)
0210:                 unique_matches.append(match)
0211:         assert len(unique_matches) <= 1, "expected each workspace object to match at most one template"
0212: 
0213:         if not unique_matches:
0214:             continue
0215: 
0216:         anchor_r, anchor_c, cells = unique_matches[0]
0217:         for rr, cc, value in cells:
0218:             target = (anchor_r + rr, anchor_c + cc)
0219:             assert planned.get(target, value) == value, "expected overlapping template stamps to agree"
0220:             planned[target] = value
0221: 
0222:     out = g.copy()
0223:     for (r, c), value in planned.items():
0224:         out[r, c] = value
0225:     return out
