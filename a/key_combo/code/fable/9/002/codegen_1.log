0105: def _line_color_set(a: np.ndarray, axis: int, idx: int) -> frozenset[int]:
0106:     line = a[idx, :] if axis == 0 else a[:, idx]
0107:     return frozenset(map(int, line))
0108: 
0109: 
0110: def _adjacent_sets_ok(a: np.ndarray) -> bool:
0111:     row_sets = [_line_color_set(a, axis=0, idx=r) for r in range(a.shape[0])]
0112:     col_sets = [_line_color_set(a, axis=1, idx=c) for c in range(a.shape[1])]
0113:     return all(row_sets[i] != row_sets[i - 1] for i in range(1, len(row_sets))) and all(
0114:         col_sets[i] != col_sets[i - 1] for i in range(1, len(col_sets))
0115:     )
0116: 
0117: 
0118: def _nudge_line(a: np.ndarray, axis: int, idx: int, avoid: frozenset[int], palette: list[int]) -> None:
0119:     if axis == 0:
0120:         coords = [(idx, c) for c in range(a.shape[1])]
0121:     else:
0122:         coords = [(r, idx) for r in range(a.shape[0])]
0123: 
0124:     counts = {color: int(np.count_nonzero(a == color)) for color in palette}
0125:     eligible = [(r, c) for r, c in coords if counts[int(a[r, c])] > 1]
0126:     if not eligible:
0127:         eligible = coords
0128: 
0129:     outside = [color for color in palette if color not in avoid]
0130:     r, c = random.choice(eligible)
0131:     if outside:
0132:         a[r, c] = random.choice(outside)
0133:         return
0134: 
0135:     line_colors = [int(a[rr, cc]) for rr, cc in coords if int(a[rr, cc]) != int(a[r, c])]
0136:     if line_colors:
0137:         a[r, c] = random.choice(line_colors)
0138: 
0139: 
0140: def _make_output(rows: int, cols: int) -> np.ndarray | None:
0141:     n_cells = rows * cols
0142:     n_colors = random.randint(MIN_DISTINCT_COLORS, min(MAX_DISTINCT_COLORS, n_cells))
0143:     palette = random.sample(COLOR_VALUES, n_colors)
0144: 
0145:     counts = {color: 1 for color in palette}
0146:     for _ in range(n_cells - n_colors):
0147:         fewest = min(counts.values())
0148:         choices = [color for color, count in counts.items() if count == fewest]
0149:         counts[random.choice(choices)] += 1
0150: 
0151:     vals: list[int] = []
0152:     for color, count in counts.items():
0153:         vals.extend([color] * count)
0154:     random.shuffle(vals)
0155:     out = np.array(vals, dtype=int).reshape(rows, cols)
0156: 
0157:     for _ in range(ADJACENCY_REPAIR_ATTEMPTS):
0158:         if _adjacent_sets_ok(out) and len(set(map(int, out.flat))) == n_colors:
0159:             return out
0160:         for r in range(1, rows):
0161:             if _line_color_set(out, axis=0, idx=r) == _line_color_set(out, axis=0, idx=r - 1):
0162:                 _nudge_line(out, axis=0, idx=r, avoid=_line_color_set(out, axis=0, idx=r - 1), palette=palette)
0163:         for c in range(1, cols):
0164:             if _line_color_set(out, axis=1, idx=c) == _line_color_set(out, axis=1, idx=c - 1):
0165:                 _nudge_line(out, axis=1, idx=c, avoid=_line_color_set(out, axis=1, idx=c - 1), palette=palette)
0166:     return None
