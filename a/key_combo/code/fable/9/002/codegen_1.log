0014: def main(input_grid: np.ndarray) -> np.ndarray:
0015:     """
0016:     Connect matching colored cells across the divider grid by filling the black cells between them.
0017: 
0018:     Input structure:
0019:     - The input is partitioned by full horizontal and vertical bars of one divider color.
0020:     - Rectangular cells are mostly black, with some cells filled by non-divider colors.
0021:     - Matching colored cells may appear in the same row or column of the partition.
0022: 
0023:     Rule:
0024:     - Identify the divider color from full rows or columns.
0025:     - For each non-black, non-divider colored cell, search rightward and downward for the next same color.
0026:     - Fill intervening black cells along that row or column with the matching color.
0027: 
0028:     Key insight:
0029:     - Same-colored cells act like endpoints on the partition lattice; only the black gaps between
0030:       aligned matching endpoints are recolored.
0031:     """
0032: 
0033:     # find the color of the horizontal and vertical bars that divide the rectangular cells
0034:     # this is the color of any line that extends all the way horizontally or vertically
0035:     jail_color = None
0036:     for i in range(input_grid.shape[0]):
0037:         for j in range(input_grid.shape[1]):
0038:             color = input_grid[i][j]
0039:             if np.all(input_grid[i, :] == color) or np.all(input_grid[:, j] == color):
0040:                 jail_color = color
0041:                 break
0042:     
0043:     assert jail_color is not None, "No jail color found"
0044: 
0045:     output_grid = input_grid.copy()
0046: 
0047:     # color all the cells between the same color pixels
0048:     for r in range(input_grid.shape[0]):
0049:         for c in range(input_grid.shape[1]):
0050:             color = input_grid[r][c]
0051:             if color == jail_color or color == Color.BLACK:
0052:                 continue
0053: 
0054:             # check if there is a cell with the same color in the same X value
0055:             for y2 in range(c+1, input_grid.shape[1]):
0056:                 if input_grid[r][y2] == color:
0057:                     for y3 in range(c+1, y2):
0058:                         if input_grid[r][y3] == Color.BLACK:
0059:                             output_grid[r][y3] = color
0060:                     break
0061: 
0062:             # check if there is a cell with the same color in the same Y value
0063:             for x2 in range(r+1, input_grid.shape[0]):
0064:                 if input_grid[x2][c] == color:
0065:                     for x3 in range(r+1, x2):
0066:                         if input_grid[x3][c] == Color.BLACK:
0067:                             output_grid[x3][c] = color
0068:                     break
0069:                 
0070:     return output_grid
0071: 
0072: def generate_input() -> np.ndarray:
0073: 
0074:     grid_size = 32
0075:     cell_size = 2
0076: 
0077:     # First create the array of rectangular cells, each of which is separated by horizontal and vertical bars dividing cells
0078: 
0079:     # pick a non-black color for the divider
0080:     divider_color = random.choice(Color.NOT_BLACK)
0081:     grid = np.zeros((grid_size, grid_size), dtype=int)
0082:     r_offset_r, r_offset_c = np.random.randint(0, cell_size), np.random.randint(0, cell_size)
0083: 
0084:     # make horizontal bars with cell_size gaps, but +1 because we need to include the divider, which is one pixel wide
0085:     for r in range(r_offset_r, grid_size, cell_size+1):
0086:         grid[r, :] = divider_color
0087:     # make vertical bars with cell_size gaps
0088:     for cc in range(r_offset_c, grid_size, cell_size+1):
0089:         grid[:, cc] = divider_color
0090: 
0091:     # Second we will color some of the cells with a random color
0092: 
0093:     # random number of cells to color
0094:     number_to_color = np.random.randint(1, 4)
0095:     for _ in range(number_to_color):
0096:         # pick what we're going to color the inside of the cell, which needs to be a different color from the divider
0097:         other_color = np.random.choice([c for c in Color.ALL_COLORS if c != divider_color and c != Color.BLACK])
0098: 
0099:         # get all coords of black cells
0100:         black_coords = np.argwhere(grid == Color.BLACK)
0101:         # pick a random black cell
0102:         r, cc = random.choice(black_coords)
0103:         flood_fill(grid, r, cc, other_color)
0104: 
0105:         # sometimes skip coloring the other side of the divider
0106:         if random.random() <= 0.2:
0107:             continue 
0108: 
0109:         # flip a coin to decide if horizontal or vertical
0110:         h_or_v = random.random() < 0.5
0111:         if h_or_v:
0112:             # horizontal
0113:             # get all the black cells in the same row
0114:             black_coords = np.argwhere(grid[r, :] == Color.BLACK)
0115:             # pick a random black cell
0116:             other_c = random.choice(black_coords)
0117:             flood_fill(grid, r, other_c, other_color)
0118:         else:
0119:             # vertical
0120:             # get all the black cells in the same column
0121:             black_coords = np.argwhere(grid[:, cc] == Color.BLACK)
0122:             # pick a random black cell
0123:             other_r = random.choice(black_coords)
0124:             flood_fill(grid, other_r, cc, other_color)
