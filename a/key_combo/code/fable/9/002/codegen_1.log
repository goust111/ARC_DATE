+        [(1 + c * (shown_thumb.shape[1] + 1), c * (shown_thumb.shape[1] + 1) + shown_thumb.shape[1]) for c in range(cols)],
+        divider,
+        layout,
+    )
+    if not np.array_equal(main(grid), expected):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
