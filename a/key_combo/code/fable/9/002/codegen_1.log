0010: def main(grid: np.ndarray) -> np.ndarray:
0011:     """
0012:     Summarize each 3x3 input block as one output pixel, ignoring grey marks.
0013:     Input structure
0014:     - The grid dimensions are multiples of 3, forming a lattice of 3x3 blocks.
0015:     - Background is the dominant color, and grey pixels are marker/noise cells.
0016:     - Each real block contains one non-background, non-grey color in at least
0017:       eight of its nine cells.
0018:     Rule
0019:     - Replace each 3x3 block by background if it contains only background and grey.
0020:     - Otherwise replace it by the unique non-background, non-grey color in that block.
0021:     Key insight
0022:     - The large grid is an enlarged low-resolution picture; grey cells are defects
0023:       within or between blocks and should not become output colors.
0024:     """
0025:     g = np.asarray(grid, dtype=int)
0026:     bg = get_bg(g)
0027:     h, w = g.shape
0028:     assert h % BLOCK == 0 and w % BLOCK == 0, "grid must split into 3x3 blocks"
0029: 
0030:     out = np.full((h // BLOCK, w // BLOCK), bg, dtype=int)
0031:     ignored = {bg, Color.GREY}
0032: 
0033:     for br in range(h // BLOCK):
0034:         for bc in range(w // BLOCK):
0035:             r0 = br * BLOCK
0036:             c0 = bc * BLOCK
0037:             block = g[r0 : r0 + BLOCK, c0 : c0 + BLOCK]
0038:             colors = [int(c) for c in np.unique(block) if int(c) not in ignored]
0039:             assert len(colors) <= 1, "each block has at most one real color"
0040: 
0041:             if colors:
0042:                 color = colors[0]
0043:                 assert np.count_nonzero(block == color) >= 8, "real blocks are full except grey damage"
0044:                 assert np.all((block == color) | (block == Color.GREY)), "real block damage must be grey"
0045:                 out[br, bc] = color
0046:             else:
0047:                 assert np.all((block == bg) | (block == Color.GREY)), "empty blocks contain only bg/grey"
0048: 
0049:     return out
0050: 
0051: # --------------- generator (o5x) ---------------
0052: # Canvas/lattice bounds.
0053: BG_COLOR, GREY_COLOR, BLOCK_SIZE = 0, 5, 3
0054: BLOCK_COUNT_MIN, BLOCK_COUNT_MAX = 3, 5
0055: COLORED_BLOCK_MIN, COLORED_BLOCK_MAX = 2, 5
0056: # Palette/defect constraints.
0057: BLOCK_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
0058: TOTAL_GREY_DEFECTS, SEEDED_DEFECT_BLOCKS = 6, 2
0059: COLORED_GREY_LIMIT, BG_GREY_LIMIT = 1, 2
0060: GEN_RETRY_LIMIT = 300
0061: 
0062: def _sample_layout():
0063:     """Return lattice dimensions, block positions, and color assignments."""
0064:     n_blocks = random.randint(BLOCK_COUNT_MIN, BLOCK_COUNT_MAX)
0065:     m_blocks = random.randint(BLOCK_COUNT_MIN, BLOCK_COUNT_MAX)
0066:     k_blocks = random.randint(COLORED_BLOCK_MIN, COLORED_BLOCK_MAX)
0067:     block_positions = [(r, c) for r in range(n_blocks) for c in range(m_blocks)]
0068:     colored_positions = random.sample(block_positions, k_blocks)
0069:     assigned_colors = random.sample(BLOCK_COLORS, k_blocks)
0070:     return n_blocks, m_blocks, block_positions, colored_positions, dict(zip(colored_positions, assigned_colors))
0071: 
0072: def _render_colored_blocks(n_blocks, m_blocks, color_by_pos):
0073:     """Create input/output arrays with colored 3x3 blocks painted."""
0074:     output = np.full((n_blocks, m_blocks), BG_COLOR, dtype=int)
0075:     inp = np.full((n_blocks * BLOCK_SIZE, m_blocks * BLOCK_SIZE), BG_COLOR, dtype=int)
0076: 
0077:     for (br, bc), color in color_by_pos.items():
0078:         output[br, bc] = color
0079:         r0, c0 = br * BLOCK_SIZE, bc * BLOCK_SIZE
0080:         inp[r0 : r0 + BLOCK_SIZE, c0 : c0 + BLOCK_SIZE] = color
0081:     return inp, output
0082: 
0083: def _sample_grey_counts(block_positions, colored_positions, color_by_pos):
0084:     """Return per-block grey counts capped by colored/background limits."""
0085:     grey_counts = {pos: 0 for pos in block_positions}
0086:     grey_counts[random.choice(colored_positions)] = 1
0087:     bg_positions = [pos for pos in block_positions if pos not in color_by_pos]
0088:     grey_counts[random.choice(bg_positions)] = 1
0089: 
0090:     remaining_slots = []
0091:     for pos in block_positions:
0092:         limit = COLORED_GREY_LIMIT if pos in color_by_pos else BG_GREY_LIMIT
0093:         remaining_slots.extend([pos] * (limit - grey_counts[pos]))
0094: 
0095:     for pos in random.sample(remaining_slots, TOTAL_GREY_DEFECTS - SEEDED_DEFECT_BLOCKS):
0096:         grey_counts[pos] += 1
0097:     return grey_counts
0098: 
0099: def _apply_grey_defects(inp, grey_counts):
0100:     """Place grey defects within each selected 3x3 block."""
0101:     for (br, bc), defect_count in grey_counts.items():
0102:         if defect_count == 0:
0103:             continue
0104:         r0, c0 = br * BLOCK_SIZE, bc * BLOCK_SIZE
0105:         for cell in random.sample(range(BLOCK_SIZE * BLOCK_SIZE), defect_count):
0106:             inp[r0 + cell // BLOCK_SIZE, c0 + cell % BLOCK_SIZE] = GREY_COLOR
0107: 
0108: def _gen_attempt():
0109:     n_blocks, m_blocks, block_positions, colored_positions, color_by_pos = _sample_layout()
0110:     inp, output = _render_colored_blocks(n_blocks, m_blocks, color_by_pos)
0111:     grey_counts = _sample_grey_counts(block_positions, colored_positions, color_by_pos)
0112:     _apply_grey_defects(inp, grey_counts)
0113: 
0114:     if np.array_equal(main(inp), output):
0115:         return inp
0116:     return None
0117: 
0118: def generate_input():
0119:     for _ in range(GEN_RETRY_LIMIT):
0120:         inp = _gen_attempt()
0121:         if inp is not None:
0122:             return inp
