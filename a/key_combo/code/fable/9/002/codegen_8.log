+    cells = {start}
+    frontier = {start}
+    while len(cells) < target_area and frontier:
+        r, c = random.choice(tuple(frontier))
+        options = []
+        for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
