+        if total_w + 2 > w:
+            return False
+        gap_slots = [0] * (len(templates) + 1)
+        spare = w - 2 - total_w
+        for _ in range(spare):
+            gap_slots[random.randrange(len(gap_slots))] += 1
+        c = 1 + gap_slots[0]
