+        db = abs(int(r) - seed_b[0]) + abs(int(c) - seed_b[1])
+        if da == db:
+            color = colors[(int(r) + int(c)) % 2]
+        else:
+            color = colors[0] if da < db else colors[1]
+        sprite[int(r), int(c)] = int(color)
+        count[int(color)] += 1
+    if min(count.values()) < 2:
+        return None
+    return sprite
