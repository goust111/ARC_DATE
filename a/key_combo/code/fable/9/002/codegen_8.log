+
+    mask = np.zeros((height, width), dtype=bool)
+    for r, c in cells:
+        mask[r, c] = True
+    if not (np.any(mask[0, :]) and np.any(mask[-1, :]) and np.any(mask[:, 0]) and np.any(mask[:, -1])):
