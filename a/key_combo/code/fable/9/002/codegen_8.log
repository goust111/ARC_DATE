+def _transform(sprite: np.ndarray, label: int) -> np.ndarray:
+    k = int(label) % 4
+    arr = np.rot90(sprite, k)
+    if int(label) >= 4:
+        arr = np.fliplr(arr)
+    return arr.copy()
