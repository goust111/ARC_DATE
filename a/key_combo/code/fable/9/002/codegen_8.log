+
+def _extract_templates(grid: np.ndarray, catalog_color: int, catalog_mask: np.ndarray) -> list[np.ndarray]:
+    visible = (grid != BLACK) & (grid != int(catalog_color))
+    templates: list[np.ndarray] = []
