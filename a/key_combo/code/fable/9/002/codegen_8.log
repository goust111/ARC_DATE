+        col_band = random.randint(1, max(1, min(2, w)))
+        r0 = (h - row_band) // 2
+        c0 = (w - col_band) // 2
+        keep[r0 : r0 + row_band, :] = True
+        keep[:, c0 : c0 + col_band] = True
+        return keep
+    if kind == "diamond":
+        cr = (h - 1) / 2.0
+        cc = (w - 1) / 2.0
+        radius = random.randint(1, max(1, int((h + w) / 4)))
+        for r in range(h):
+            for c in range(w):
+                if abs(r - cr) + abs(c - cc) <= radius + 0.1:
