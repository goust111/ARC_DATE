+        return None
+    seed_a = tuple(coords[random.randrange(len(coords))])
+    farthest = max(coords, key=lambda rc: abs(int(rc[0]) - int(seed_a[0])) + abs(int(rc[1]) - int(seed_a[1])))
+    seed_b = (int(farthest[0]), int(farthest[1]))
+    if seed_a == seed_b:
+        return None
