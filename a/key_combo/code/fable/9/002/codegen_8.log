+def paste(dst: np.ndarray, patch: np.ndarray, top: int, left: int, *, transparent: int | None = None) -> None:
+    h, w = patch.shape
+    view = dst[top : top + h, left : left + w]
+    if transparent is None:
+        view[:] = patch
+        return
+    mask = patch != int(transparent)
+    view[mask] = patch[mask]
