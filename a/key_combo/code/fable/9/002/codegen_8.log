+
+    axis = random.choice(("h", "v"))
+    if axis == "h":
+        left_w = (w + 1) // 2
+        half = np.random.rand(h, left_w) < random.uniform(0.45, 0.8)
+        for r in range(h):
+            for c in range(left_w):
+                keep[r, c] = bool(half[r, c])
+                keep[r, w - 1 - c] = bool(half[r, c])
