+
+    total_h = sum(t.shape[0] for t in templates) + 2 * (len(templates) - 1)
+    if total_h + 2 > h:
+        return False
+    if any(t.shape[1] > thickness for t in templates):
+        return False
+    gap_slots = [0] * (len(templates) + 1)
+    spare = h - 2 - total_h
+    for _ in range(spare):
+        gap_slots[random.randrange(len(gap_slots))] += 1
