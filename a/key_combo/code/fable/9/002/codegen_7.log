+def _sequence_options(region_count: int) -> list[tuple[int, int, list[int]]]:
+    options = []
+    for start in range(region_count):
+        for step in range(1, region_count):
+            terms = list(range(start, region_count, step))
+            if 3 <= len(terms) <= 6:
