+    cur = start
+
+    while True:
+        path.append(cur)
+        rr, cc = cur
+        nxt = []
+        for nr, nc in _neighbors4(rr, cc):
+            if 0 <= nr < mask.shape[0] and 0 <= nc < mask.shape[1] and mask[nr, nc]:
+                if prev is None or (nr, nc) != prev:
+                    nxt.append((nr, nc))
+        if not nxt:
+            break
+        assert len(nxt) == 1, "simple path traversal must have a unique next step"
+        prev, cur = cur, nxt[0]
