+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BLACK = 0
+RED = 2
+YELLOW = 4
+GEN_RETRY_LIMIT = 400
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
