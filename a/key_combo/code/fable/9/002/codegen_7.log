+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while queue:
+                rr, cc = queue.popleft()
+                cells.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+            components.append(cells)
+    return components
+
+
+def _path_endpoints(mask: np.ndarray) -> list[tuple[int, int]] | None:
+    coords = np.argwhere(mask)
+    if len(coords) < 2:
+        return None
+
+    endpoints: list[tuple[int, int]] = []
+    h, w = mask.shape
+    for r, c in coords:
+        degree = 0
+        for nr, nc in _neighbors4(int(r), int(c)):
+            if 0 <= nr < h and 0 <= nc < w and mask[nr, nc]:
+                degree += 1
+        if degree == 1:
+            endpoints.append((int(r), int(c)))
+        elif degree != 2:
+            return None
+
+    if len(endpoints) != 2:
+        return None
+    if not all(r in (0, h - 1) or c in (0, w - 1) for r, c in endpoints):
+        return None
+    return endpoints
+
+
+def _detect_path_color(grid: np.ndarray, bg: int) -> tuple[int, list[tuple[int, int]]]:
+    candidates = []
+    for color in sorted(set(map(int, np.unique(grid))) - {int(bg)}):
+        mask = grid == color
+        if len(_component_cells(mask)) != 1:
+            continue
+        endpoints = _path_endpoints(mask)
+        if endpoints is None:
