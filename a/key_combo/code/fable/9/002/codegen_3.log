+    inside_dirs = []
+    outside_dirs = []
+    for dr, dc in DIRS4:
+        nr, nc = r + dr, c + dc
+        if not _in_bounds(grid.shape, nr, nc):
+            continue
+        if room_mask[nr, nc]:
+            inside_dirs.append((dr, dc))
+        elif grid[nr, nc] == BLACK:
