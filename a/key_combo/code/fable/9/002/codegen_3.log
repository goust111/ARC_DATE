+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+SIDE_TO_DIR = {
+    "N": (-1, 0),
+    "S": (1, 0),
+    "W": (0, -1),
+    "E": (0, 1),
+}
+DIR_TO_ENTRY_SIDE = {
+    (-1, 0): "S",
+    (1, 0): "N",
+    (0, -1): "E",
+    (0, 1): "W",
