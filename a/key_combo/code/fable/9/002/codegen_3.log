+            placed = True
+            break
+        if not placed:
+            return None
+
+    marker = {"head": head, "tail": tail}
+    rooms.append({"marker": marker})
+    return rooms
+
+
+def _generate_attempt(rng: random.Random) -> np.ndarray | None:
+    shape = (rng.randint(20, 29), rng.randint(20, 29))
+    total_rooms = rng.randint(3, 6)
+    colors = rng.sample(DOOR_COLORS, total_rooms)
+    spec = _place_chain(shape, rng, colors)
+    if spec is None:
+        return None
+
+    grid = np.zeros(shape, dtype=int)
+    marker = spec[-1]["marker"]
+    rooms = spec[:-1]
+    if len(rooms) != total_rooms:
+        return None
+    for room in rooms:
+        _render_room(grid, room)
+    grid[marker["tail"]] = TEAL
+    grid[marker["head"]] = YELLOW
+
+    try:
+        out = main(grid)
+    except AssertionError:
+        return None
+
+    if np.array_equal(out, grid):
+        return None
