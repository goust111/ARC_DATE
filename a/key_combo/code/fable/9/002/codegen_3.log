+    if np.array_equal(out, grid):
+        return None
+    changed_room_colors = {
+        room["color"]
+        for room in rooms
+        if np.any(out[room["box"][0] + 1 : room["box"][2], room["box"][1] + 1 : room["box"][3]] == room["color"])
