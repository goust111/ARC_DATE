        bottom_dist = H - 1 - r
        if top_dist == bottom_dist:
            return None
        if top_dist < bottom_dist:
            return (r - 1, c), color_a
        return (r + 1, c), color_b

    left_dist = c
    right_dist = W - 1 - c
