+
+def _mark_box(mask: np.ndarray, box: tuple[int, int, int, int], pad: int = 0) -> None:
+    r0, c0, r1, c1 = box
+    r0 = max(0, r0 - pad)
+    c0 = max(0, c0 - pad)
+    r1 = min(mask.shape[0] - 1, r1 + pad)
+    c1 = min(mask.shape[1] - 1, c1 + pad)
+    mask[r0 : r1 + 1, c0 : c1 + 1] = True
