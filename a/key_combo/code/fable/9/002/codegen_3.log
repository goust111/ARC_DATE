    H, W = (axis_size, cross_size) if orientation == ORIENTATION_ROWS else (cross_size, axis_size)
    color_a, color_b = map(int, rng.choice(BAR_COLOR_CHOICES, size=2, replace=False))
    g = np.zeros((H, W), dtype=int)
