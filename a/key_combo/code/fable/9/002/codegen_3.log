+    assert len(outside_dirs) == 1, "door must expose exactly one corridor direction"
+    return outside_dirs[0]
+
+
+def _rooms(grid: np.ndarray) -> list[dict]:
+    enclosed = []
+    for coords in _component_coords(grid == BLACK):
+        rows = coords[:, 0]
+        cols = coords[:, 1]
+        if (
+            np.any(rows == 0)
