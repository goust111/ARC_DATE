+
+
+def _door_coord(box: tuple[int, int, int, int], side: str, offset: int) -> tuple[int, int]:
+    r0, c0, r1, c1 = box
+    if side == "N":
+        return r0, c0 + offset
+    if side == "S":
+        return r1, c0 + offset
+    if side == "W":
+        return r0 + offset, c0
+    return r0 + offset, c1
+
+
