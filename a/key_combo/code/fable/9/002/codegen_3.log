+        room_idx = door_to_room[pos]
+        assert room_idx not in visited_rooms, "door chain must not revisit a room"
+        visited_rooms.add(room_idx)
+        room = rooms[room_idx]
+        out[room["cells"][:, 0], room["cells"][:, 1]] = room["door_color"]
