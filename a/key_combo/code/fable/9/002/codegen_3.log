+
+def _box_ok(
+    box: tuple[int, int, int, int],
+    shape: tuple[int, int],
+    occupied: np.ndarray,
+    padded: np.ndarray,
+    reserved: np.ndarray,
+) -> bool:
+    r0, c0, r1, c1 = box
+    if not (0 <= r0 < r1 < shape[0] and 0 <= c0 < c1 < shape[1]):
+        return False
+    if np.any(occupied[r0 : r1 + 1, c0 : c1 + 1]):
+        return False
+    if np.any(reserved[r0 : r1 + 1, c0 : c1 + 1]):
+        return False
+    rr0 = max(0, r0 - 1)
+    cc0 = max(0, c0 - 1)
+    rr1 = min(shape[0] - 1, r1 + 1)
+    cc1 = min(shape[1] - 1, c1 + 1)
+    if np.any(padded[rr0 : rr1 + 1, cc0 : cc1 + 1]):
