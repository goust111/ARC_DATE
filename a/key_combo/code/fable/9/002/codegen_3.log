+        room_mask[rows, cols] = True
+        doors = set()
+        colors = set()
+        for r, c in coords:
+            for dr, dc in DIRS4:
+                nr, nc = int(r) + dr, int(c) + dc
+                if not _in_bounds(grid.shape, nr, nc):
+                    continue
