+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+PINK = 6
+ORANGE = 7
+TEAL = 8
+MAROON = 9
+
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+SIDE_TO_DIR = {
+    "N": (-1, 0),
+    "S": (1, 0),
+    "W": (0, -1),
+    "E": (0, 1),
+}
+DIR_TO_ENTRY_SIDE = {
+    (-1, 0): "S",
+    (1, 0): "N",
+    (0, -1): "E",
+    (0, 1): "W",
+}
+DOOR_COLORS = [BLUE, RED, GREEN, PINK, ORANGE, MAROON]
+SPECIAL_INPUT_COLORS = {BLACK, YELLOW, GREY, TEAL}
