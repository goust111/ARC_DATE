  grid: 8-12 cols x 19-21 rows, black background
  colors_input: black, red, teal
  colors_output: adds yellow (markers recolored), teal (rays)
  red_bars:
    count: exactly 2, one on col 0 (left edge), one on col W-1 (right edge)
    shape: solid vertical segments, equal height 4-6
    row_ranges: non-overlapping with vertical gap >= 4 between them
    margins: each bar has >= 1 row margin from top and bottom grid edges
  teal_markers:
    count: 1-3, each a single isolated pixel
    placement: all aligned with the SAME red bar (the source bar); row within bar range, col != bar col
    distance: >= 3 cols from source bar (room for teal ray segment)
    uniqueness: each marker on a distinct row (distinct offset within bar)
    path_clear: row between marker and source bar is all black; corresponding offset row of opposite bar is all black
  source_bar_position: can be left or right edge [observed] source bar is always vertically above target bar
  transformation:
    per_marker: |
      1. Paint teal from source bar to marker (exclusive of bar, exclusive of marker), recolor marker yellow.
      2. Use marker's row-offset in source bar to find corresponding row of opposite (target) bar.
