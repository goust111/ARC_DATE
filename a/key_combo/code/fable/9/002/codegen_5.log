  "match_cond": "s.marker components have the same shape and relative arrangement as d",
  "transform": "translate s to overlap d; layer larger sprites first",
  "grid_shape": "crop to only retain the largest destination object"
}
</annotation>
<generation_spec>
```yaml
spec:
  task_type: move_to_match
  grid: 30x30 uniform background; output = tight crop of dst (5-16 x 5-16)
  palette: bg + dst_primary + marker + 1-2 src_own colors, all distinct; all srcs share one marker color with dst
  dst:
    shape: solid rectangle, 9-13 rows x 5-16 cols, area 45-195
    content: dst_primary fill + marker-colored pixels; marker is 2-4 4-connected components, each 1-8 cells
    marker_comps: each component bbox <=3x3; components separated by >=1 cell of dst_primary
  src:
    count: 1-2 solid rectangular sprites, each strictly smaller than dst, distinct areas (9-72)
    size: 3-8 rows x 3-9 cols
    content: exactly 2 colors (marker + own); marker comps match a subset of dst marker comps in shape and relative arrangement
    alignment: marker comps determine exactly one translation placing src fully inside dst; margins >=1 on all sides [observed]
  transform:
    rule: crop dst bbox; paste each src at its unique marker-aligned offset, largest-area first
    nesting: when multiple srcs exist, their footprints may overlap (smaller overwrites larger) or be disjoint
  input_layout: dst and src sprites placed as separate 4-connected components on bg, non-overlapping, >=4 cells apart [observed]
generation_strategy:
  approach: output-first, then invert
  steps:
    - Pick bg, dst_primary, marker, and 1-2 src_own colors (all distinct).
    - Build dst as solid rectangle (9-13 x 5-16) of dst_primary.
    - Place 2-4 marker-colored connected components inside dst (each 1-8 cells, bbox <=3x3, >=1 cell from each other and >=1 cell from dst border).
    - For each src, choose a subset of dst marker comps (all comps of matching shapes); build src as solid rectangle of src_own containing those marker comps at the same relative offsets. Verify the translation is unique and src fits inside dst with >=1 margin.
    - Compose output by pasting srcs onto pristine dst crop in decreasing area order.
    - Build 30x30 input by placing pristine dst and unpasted src sprites at non-overlapping, well-separated positions on bg.
