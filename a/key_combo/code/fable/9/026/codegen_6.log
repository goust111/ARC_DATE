+            dr, dc = random.choice(((1, 0), (-1, 0), (0, 1), (0, -1)))
+            nr, nc = r + dr, c + dc
+            if abs(nr) > 5 or abs(nc) > 6:
+                continue
+            cells.add((nr, nc))
