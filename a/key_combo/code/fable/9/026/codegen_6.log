+            variant["mask"].shape == mask.shape and np.array_equal(variant["mask"], mask)
+            for variant in _dihedral_variants(source_mask)
+        ):
+            continue
+        if h == src_h and w == src_w:
+            return mask
+        if same_area:
+            return mask
+        if int(mask.sum()) == src_area:
