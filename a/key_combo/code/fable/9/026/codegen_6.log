+    shadow_count = len(parsed["source_shadow_local"])
+    if np.count_nonzero(expected == shadow_color) != np.count_nonzero(inp == shadow_color) + shadow_count * len(target_variants):
+        return None
+
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
+        grid = _gen_attempt()
+        if grid is not None:
