+        "body_color": int(body_color),
+        "shadow_color": int(shadow_color),
+        "components": comps,
+        "source_comp": source_comp,
+        "source_mask": source_mask,
+        "source_shadow_local": source_shadow_local,
+        "matched": matched,
+        "distractors": distractors,
+    }
