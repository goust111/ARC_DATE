+    if extra is None:
+        return None
+
+    funnels = chain + [extra]
+    beads = _make_beads(shape, funnels, mouth_rows)
+
+    steps_cw = random.randint(0, 3)
+    return _rotate_scene(shape, funnels, beads, steps_cw)
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GEN_ATTEMPTS):
