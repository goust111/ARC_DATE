+    return True
+
+
+def _generate_scene() -> tuple[tuple[int, int], list[Funnel], list[Bead]] | None:
+    shape = (random.randint(18, 24), random.randint(18, 24))
+    try:
+        chain, mouth_rows = _canonical_chain(shape)
