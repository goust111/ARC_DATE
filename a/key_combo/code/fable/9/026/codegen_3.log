+        t = random.randint(1, max_t)
+        rel = [
+            (-a, -b),
+            (-a, b),
+            (-(a - t), b + t),
+            (a - t, b + t),
+            (a, b),
+            (a, -b),
+            (a - t, -(b + t)),
+            (-(a - t), -(b + t)),
