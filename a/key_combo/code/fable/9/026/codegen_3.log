+
+def _sample_vertices(shape: tuple[int, int]) -> list[tuple[int, int]] | None:
+    h, w = shape
+    kind = random.choice(["diamond", "octagon"])
+    margin = 4
+
+    if kind == "diamond":
+        max_d = min((h - 1) // 2 - margin, (w - 1) // 2 - margin)
+        if max_d < 4:
+            return None
+        d = random.randint(4, max_d)
+        rel = [(-d, 0), (0, d), (d, 0), (0, -d)]
+    else:
+        max_a = (h - 1) // 2 - margin
+        max_b = (w - 1) // 2 - margin - 1
+        if max_a < 5 or max_b < 3:
