+
+    target = random.randint(size_lo, size_hi)
+    seed_r, seed_c = map(int, random.choice(candidates.tolist()))
+    comp = np.zeros_like(allowed, dtype=bool)
+    comp[seed_r, seed_c] = True
+    frontier = {(seed_r, seed_c)}
