+    max_shape = (29, 29)
+    for v1 in v1_candidates:
+        n1 = _norm_sq(v1)
+        s1 = _support_area(max_shape, v1)
+        for v2 in v2_candidates:
+            if _norm_sq(v2) <= n1:
+                continue
+            area = _lattice_area(v1, v2)
+            if not (10 <= area <= 42):
+                continue
+            good = True
+            for a in range(-4, 5):
+                for b in range(-4, 5):
+                    if a == 0 and b == 0:
+                        continue
+                    vec = (a * v1[0] + b * v2[0], a * v1[1] + b * v2[1])
+                    if vec == v1 or vec == (-v1[0], -v1[1]):
+                        continue
+                    if vec == (0, 0):
+                        good = False
+                        break
+                    if _norm_sq(vec) <= n1:
+                        good = False
+                        break
+                    if _support_area(max_shape, vec) >= s1:
+                        good = False
+                        break
