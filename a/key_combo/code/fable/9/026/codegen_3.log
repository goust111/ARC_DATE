+    vertices = [(cr + r, cc + c) for r, c in rel]
+    cycle = _angle_cycle(vertices)
+    if len(set(cycle)) != len(cycle):
+        return None
+    if any(not _aligned_8(cycle[i], cycle[(i + 1) % len(cycle)]) for i in range(len(cycle))):
+        return None
+    return vertices
+
