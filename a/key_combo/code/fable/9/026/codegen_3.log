+                    if allowed[nr, nc] and not blocked[nr, nc] and not comp[nr, nc]:
+                        options.append((nr, nc))
+        if not options:
+            break
+        nr, nc = random.choice(options)
+        comp[nr, nc] = True
+        frontier.add((nr, nc))
