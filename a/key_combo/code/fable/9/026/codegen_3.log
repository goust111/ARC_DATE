_WEDGE_SIDES = (
    ("down", ((1, -1), (1, 1))),
    ("up", ((-1, -1), (-1, 1))),
    ("left", ((-1, 1), (1, 1))),
    ("right", ((-1, -1), (1, -1))),
)


def _prefix_len(distances: list[int]) -> int:
    present = set(distances)
    d = 1
    while d in present:
        d += 1
    return d - 1


def _ray_marker_distances(g: np.ndarray, r: int, c: int, dr: int, dc: int) -> list[int]:
    distances: list[int] = []
    d = 1
    while in_bounds(g.shape, r + dr * d, c + dc * d):
        if g[r + dr * d, c + dc * d] == Color.GREEN:
            distances.append(d)
        d += 1
    return distances


