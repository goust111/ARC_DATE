+    def key(p: tuple[int, int]) -> tuple[float, float, int, int]:
+        r, c = p
+        return (math.atan2(r - cr, c - cc), (r - cr) ** 2 + (c - cc) ** 2, r, c)
+
+    return sorted(points, key=key)
