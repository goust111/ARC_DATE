+    out = field.copy()
+    out[fence] = RED
+    out[outer_holes] = BLACK
+
+    inp = field.copy()
+    inp[inner_holes | outer_holes] = BLACK
+    for r, c in vertices:
+        inp[r, c] = RED
+    return inp, out
+
+
+def _validate_case(
+    inp: np.ndarray,
+    out: np.ndarray,
+    field: np.ndarray,
+    vertices: list[tuple[int, int]],
+    inner_holes: np.ndarray,
+    outer_holes: np.ndarray,
+    v1: tuple[int, int],
+) -> bool:
+    if not np.array_equal(main(inp), out):
