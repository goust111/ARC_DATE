+        return None
+
+    outer_holes = _place_components(
+        outside & ~blocked,
+        count_range=(1, 3),
+        size_range=(3, 14),
+        initially_blocked=blocked | _dilate8(inner_holes),
+        require_one_from=bbox_ring,
