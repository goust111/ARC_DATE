+_VECTOR_PAIRS = _candidate_vector_pairs()
+
+
+def _lattice_key(r: int, c: int, v1: tuple[int, int], v2: tuple[int, int]) -> tuple[int, int]:
+    a, b = v1
+    p, q = v2
+    area = _lattice_area(v1, v2)
+    return ((q * r - p * c) % area, (-b * r + a * c) % area)
