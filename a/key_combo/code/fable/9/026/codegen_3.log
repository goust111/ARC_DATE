+    colors_by_root: dict[int, set[int]] = {}
+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if color in occluders:
+                continue
+            root = find(r * w + c)
+            colors_by_root.setdefault(root, set()).add(color)
