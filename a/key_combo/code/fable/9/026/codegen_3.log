+
+
+def _norm_sq(vec: tuple[int, int]) -> int:
+    return vec[0] * vec[0] + vec[1] * vec[1]
+
+
+def _support_area(shape: tuple[int, int], vec: tuple[int, int]) -> int:
+    h, w = shape
+    dr, dc = vec
+    if abs(dr) >= h or abs(dc) >= w:
