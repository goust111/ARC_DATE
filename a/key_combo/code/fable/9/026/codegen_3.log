            da = _ray_marker_distances(g, rr, cc, *side_a)
            db = _ray_marker_distances(g, rr, cc, *side_b)
            common = set(da) & set(db)
            if not common:
                continue
            height = max(max(common), _prefix_len(da), _prefix_len(db))
            if height >= 2:
