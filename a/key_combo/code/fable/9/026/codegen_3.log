+    min_cc = margin - c0
+    max_cc = w - 1 - margin - c1
+    if min_cr > max_cr or min_cc > max_cc:
+        return None
+    cr = random.randint(min_cr, max_cr)
+    cc = random.randint(min_cc, max_cc)
