+    r0, c0, r1, c1 = _bbox_of_points(vertices)
+    bbox_mask[r0 : r1 + 1, c0 : c1 + 1] = True
+    if not np.any(outer_holes & bbox_mask):
+        return False
+    return True
+
+
+def _gen_attempt() -> np.ndarray | None:
+    shape = (random.randint(20, 28), random.randint(20, 28))
