+    return inp, out
+
+
+def _validate_case(
+    inp: np.ndarray,
+    out: np.ndarray,
+    field: np.ndarray,
+    vertices: list[tuple[int, int]],
+    inner_holes: np.ndarray,
+    outer_holes: np.ndarray,
+    v1: tuple[int, int],
+) -> bool:
