+    working = g.copy()
+    working[fence] = RED
+
+    inside = _inside_mask_from_fence(fence)
+    predicted = _periodic_fill_colors(working, {BLACK, RED})
+
+    out = working.copy()
+    for (r, c), color in predicted.items():
+        if inside[r, c]:
+            out[r, c] = color
