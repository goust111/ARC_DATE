+        return None
+    return comp
+
+
+def _place_components(
+    allowed: np.ndarray,
+    count_range: tuple[int, int],
+    size_range: tuple[int, int],
+    initially_blocked: np.ndarray | None = None,
+    require_one_from: np.ndarray | None = None,
+) -> np.ndarray | None:
