+        return False
+    if not np.all(inner_holes <= inside):
+        return False
+    if np.any(outer_holes & inside):
+        return False
+    if np.count_nonzero(fence & (inp == RED)) != len(vertices):
+        return False
+    if np.count_nonzero(fence) <= len(vertices):
