+        rr = int(r) * scale
+        cc = int(c) * scale
+        big[rr : rr + scale, cc : cc + scale] = True
+
+    seen = np.zeros_like(big, dtype=bool)
+    q: deque[tuple[int, int]] = deque()
+    bh, bw = big.shape
+    for r in range(bh):
+        for c in (0, bw - 1):
+            if not big[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                q.append((r, c))
+    for c in range(bw):
+        for r in (0, bh - 1):
+            if not big[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                q.append((r, c))
+
+    while q:
+        r, c = q.popleft()
+        for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+            if 0 <= nr < bh and 0 <= nc < bw and not big[nr, nc] and not seen[nr, nc]:
+                seen[nr, nc] = True
+                q.append((nr, nc))
+
+    inside = np.zeros_like(fence, dtype=bool)
+    for r in range(h):
+        for c in range(w):
+            if fence[r, c]:
+                continue
+            if not seen[r * scale + 1, c * scale + 1]:
+                inside[r, c] = True
