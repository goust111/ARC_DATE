+from __future__ import annotations
+
+import math
+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+RED = 2
+PALETTE = [1, 3, 4, 5, 6, 7, 8, 9]
+GEN_RETRY_LIMIT = 300
