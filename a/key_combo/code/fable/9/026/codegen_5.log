  "type": "transform_in_place",
  "src": "solid foreground rectangles made of nested rectangular color layers",
  "transform": "for each rectangle independently, read layer colors from outermost to innermost; recolor every layer to the color at the opposite position in that order and leave the background unchanged"
}
</annotation>
<generation_spec>
