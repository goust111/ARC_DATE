+    if bg != 0:
+        return False
+    changed = 0
+    unchanged = 0
+    outer_colors = []
+    for bar, rect in zip(bars, rects):
+        layer_count = len(rect["layers"])
+        if bar["height"] % layer_count == 0:
+            unchanged += 1
+        else:
+            changed += 1
+        outer_colors.append(int(rect["layers"][0]["color"]))
