+        grid[grid_h - height : grid_h, int(col)] = int(spec["colors"][0])
+    return grid
+
+
+def _semantic_checks(grid: np.ndarray) -> bool:
+    try:
+        bg, bars, rects = _analyze_scene(grid)
+    except AssertionError:
