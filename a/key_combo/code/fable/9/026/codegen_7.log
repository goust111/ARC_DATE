+        r0, c0, r1, c1 = _bbox(arr)
+        arr -= np.array([r0, c0], dtype=int)
+        h = int(r1 - r0 + 1)
+        w = int(c1 - c0 + 1)
+        if h > max_h or w > max_w:
+            continue
+        mask = np.zeros((h, w), dtype=bool)
+        mask[arr[:, 0], arr[:, 1]] = True
