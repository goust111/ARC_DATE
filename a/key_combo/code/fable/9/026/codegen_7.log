    density: 0.60-0.80 of bbox filled
    symmetry: LR [observed]
    connectivity: single 4-connected component per color
  placement:
    columns: each sprite at distinct left column; column gaps >= sprite_width (no horizontal overlap when aligned)
    rows: each sprite at a different top row; vertical spread 6-10 rows between min/max top
    fit: anchor_top + sprite_height <= grid_rows (aligned sprites must fit)
    no_overlap: sprites must not overlap in the input either
  anchor: TEAL sprite determines the target top row for output alignment
