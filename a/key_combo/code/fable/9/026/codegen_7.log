+# --------------- generator ---------------
+
+_GEN_BG = 0
+_GEN_FRAME_DIM = (9, 15)
+_GEN_CANVAS_DIM = (20, 30)
+_GEN_SLOT_COUNT = (3, 5)
+_GEN_REPEAT_SIZE_CHOICES = (2, 3)
+_GEN_SHAPE_AREA = (2, 6)
+_GEN_OUTER_ATTEMPTS = 400
+_GEN_SHAPE_ATTEMPTS = 120
+_GEN_LAYOUT_ATTEMPTS = 120
+_GEN_PIECE_PLACE_ATTEMPTS = 400
