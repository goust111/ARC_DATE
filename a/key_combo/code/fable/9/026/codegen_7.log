+                patch[oriented] = int(piece["color"])
+                _paste(canvas, patch, r0, c0, oriented)
+                occupied[r0 : r0 + h, c0 : c0 + w] |= oriented
+                piece["placed_mask"] = oriented
+                piece["placed_top_left"] = (r0, c0)
+                placed = True
+                break
+            if placed:
