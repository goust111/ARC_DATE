+def _dilate8(mask: np.ndarray) -> np.ndarray:
+    out = np.array(mask, copy=True)
+    out[:-1, :] |= mask[1:, :]
+    out[1:, :] |= mask[:-1, :]
+    out[:, :-1] |= mask[:, 1:]
+    out[:, 1:] |= mask[:, :-1]
+    out[:-1, :-1] |= mask[1:, 1:]
+    out[1:, 1:] |= mask[:-1, :-1]
+    out[:-1, 1:] |= mask[1:, :-1]
+    out[1:, :-1] |= mask[:-1, 1:]
+    return out
