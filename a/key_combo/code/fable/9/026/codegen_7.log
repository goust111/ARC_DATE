+    canvas_w = random.randint(max(frame_w + 6, _GEN_CANVAS_DIM[0]), _GEN_CANVAS_DIM[1])
+    if canvas_h > 30 or canvas_w > 30:
+        return None
+
+    palette = list(range(1, 10))
+    random.shuffle(palette)
