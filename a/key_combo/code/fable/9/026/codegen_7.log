+    mask, r0, c0 = _tight_mask(coords)
+    color = int(grid[int(coords[0, 0]), int(coords[0, 1])])
+    patch = np.zeros(mask.shape, dtype=int)
+    patch[mask] = color
+    return mask, patch, r0, c0
