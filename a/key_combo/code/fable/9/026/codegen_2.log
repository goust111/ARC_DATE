+                    pattern[r0 : r1 + 1, c] = color
+            else:
+                arm = random.randint(2, size)
+                r0 = random.randint(0, size - arm)
+                c0 = random.randint(0, size - arm)
+                pattern[r0 : r0 + arm, c0] = color
+                pattern[r0, c0 : c0 + arm] = color
