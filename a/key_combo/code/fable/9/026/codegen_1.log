+    if not np.all(out[np.array([r for r, _ in expected_partner]), np.array([c for _, c in expected_partner])] == lone_color):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_ATTEMPTS):
+        grid = gen_attempt()
+        if grid is not None:
+            return grid
