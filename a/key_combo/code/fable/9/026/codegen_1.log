+        frontier.remove((nr, nc))
+        mask[nr, nc] = True
+        cells.add((nr, nc))
+        for rr, cc in neighbors4(nr, nc):
+            if 0 <= rr < h and 0 <= cc < w and not mask[rr, cc]:
+                frontier.add((rr, cc))
