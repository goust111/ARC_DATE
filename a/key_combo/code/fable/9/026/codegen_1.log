+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_ATTEMPTS):
+        grid = gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid hidden-pivot arithmetic-progression task")

