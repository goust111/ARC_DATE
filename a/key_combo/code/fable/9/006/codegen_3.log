+    g = np.asarray(grid, dtype=int)
+    bg = _get_bg(g)
+    comps = _find_components(g, bg)
+
+    arrows: list[dict] = []
+    boxes: list[dict] = []
+    for comp in comps:
+        arrow = _parse_arrow(comp["coords"])
+        if arrow is not None:
+            tip, direction = arrow
+            arrows.append({"tip": tip, "direction": direction, "color": int(comp["color"])})
+            continue
+        box = _parse_box(g, comp, bg)
+        if box is not None:
+            boxes.append(box)
