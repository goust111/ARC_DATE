+        grid[r, c] = color
+
+
+def _rect_border_cells(box: dict) -> list[Coord]:
+    r0, c0, r1, c1 = box["bbox"]
+    cells: list[Coord] = []
+    for c in range(c0, c1 + 1):
+        cells.append((r0, c))
+        cells.append((r1, c))
+    for r in range(r0 + 1, r1):
+        cells.append((r, c0))
+        cells.append((r, c1))
