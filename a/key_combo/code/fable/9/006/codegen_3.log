+def _arrow_cells(tip: Coord, direction: Coord) -> list[Coord]:
+    if direction == (0, 1):
+        rels = [(0, 0), (0, -1), (0, -2), (0, -3), (-1, -1), (1, -1)]
+    elif direction == (0, -1):
+        rels = [(0, 0), (0, 1), (0, 2), (0, 3), (-1, 1), (1, 1)]
+    elif direction == (1, 0):
+        rels = [(0, 0), (-1, 0), (-2, 0), (-3, 0), (-1, -1), (-1, 1)]
+    else:
+        rels = [(0, 0), (1, 0), (2, 0), (3, 0), (1, -1), (1, 1)]
