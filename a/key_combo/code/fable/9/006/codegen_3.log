+        direction = arrow["direction"]
+        out[opening] = BG
+        liquid = int(arrow["box"]["liquid_color"])
+        dr, dc = direction
+        r, c = opening[0] - dr, opening[1] - dc
+        while (r, c) != arrow["tip"]:
+            out[r, c] = liquid
+            r -= dr
+            c -= dc
