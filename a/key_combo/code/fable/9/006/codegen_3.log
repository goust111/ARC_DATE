+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+Coord = tuple[int, int]
+BBox = tuple[int, int, int, int]
+
+BG = 0
+PALETTE = tuple(range(1, 10))
+ARROW_DIRECTIONS = ((-1, 0), (1, 0), (0, -1), (0, 1))
+GEN_ATTEMPTS = 500
