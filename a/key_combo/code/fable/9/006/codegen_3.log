+    return False
+
+
+def _expected_output(grid: np.ndarray, valid_arrows: list[dict]) -> np.ndarray:
+    out = grid.copy()
+    drained_boxes = {id(item["box"]): item["box"] for item in valid_arrows}
+    for box in drained_boxes.values():
