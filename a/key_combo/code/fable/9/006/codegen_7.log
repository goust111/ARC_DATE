   1: 
   2: import numpy as np
   3: from typing import *
   4: import random
   5: from arc_utils import Color, bbox, crop_bbox, draw_line, find_components, object_interior, paste, random_free_location, random_sprite
   6: 
   7: # concepts:
   8: # holes, objects, distracters, topology, puzzle piece
   9: 
  10: # description:
  11: # In the input you will see multiple grey rectangular objects, each with a black hole inside of it. There are also monochromatic objects somewhere exactly the same shape as each hole, and random other distracter objects (distracters all the same color). 
  12: # To make the output, check to see if each non-distracter object perfectly fits inside the black hole inside of a gray object, like it is a puzzle piece. If it does, place it inside the black hole. If it doesn't, leave it where it is.
  13: 
  14: def main(input_grid):
  15:     """
  16:     Move each non-distractor puzzle piece into the matching black hole inside a gray object.
  17: 
  18:     Input structure:
  19:     - Gray rectangular objects contain black interior holes.
  20:     - Colored objects outside the rectangles may match those hole shapes.
  21:     - Distractor objects share the most common non-gray object color.
  22: 
  23:     Rule:
  24:     - Extract gray objects and their black interior masks.
  25:     - Treat the most common non-gray object color as the distractor color.
  26:     - For every other colored sprite, compare its mask to each hole mask and paste exact matches into the hole.
  27: 
  28:     Key insight:
  29:     - Fit is determined by binary shape equality, not by the piece color or its original position.
  30:     """
  31:     # Plan:
  32:     # 1. Parse the input into objects, sprites, and black holes inside the grey objects
  33:     # 2. Identify color of distracter objects.
  34:     # 3. Turn each object into a sprite
  35:     # 4. Check if each sprite can be moved into a black hole, and if so, move it there
  36:     
  37:     # Parse, separating greys from other objects
  38:     grey_input = input_grid.copy()
  39:     grey_input[input_grid != Color.GREY] = Color.BLACK
  40:     grey_objects = find_components(grey_input, bg=Color.BLACK, connectivity=4, monochromatic=True, return_format="objects")
