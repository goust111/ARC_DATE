 108: def generate_input():
 109:     H = W = 30
 110:     background = Color.BLACK
 111:     grid = np.full((H, W), background, dtype=int)
 112: 
 113:     # Colors chosen so that `np.unique` ordering matches the solver's "special_color = colors[-1]" logic.
 114:     rectangle_color = Color.BLUE
 115:     special_color = Color.MAROON
 116:     point_color = Color.TEAL
 117: 
 118:     # Small crosshair object (smallest component).
 119:     crosshair = np.full((3, 3), background, dtype=int)
 120:     crosshair[1, :] = point_color
 121:     crosshair[:, 1] = point_color
 122:     paste(grid, crosshair, 1, 1, transparent=background, clip=False)
 123: 
 124:     # Place 2 rectangles, each with one special pixel of `special_color`.
 125:     for _ in range(2):
 126:         rh = random.randint(6, 10)
 127:         rw = random.randint(6, 10)
 128:         rect = np.full((rh, rw), rectangle_color, dtype=int)
 129:         rect[rh // 2, rw // 2] = special_color
 130:         r0, c0 = random_free_location(grid, rect, transparent=background, border=1, padding=1, padding_connectivity=8)
 131:         paste(grid, rect, r0, c0, transparent=background, clip=True)
 132: 
 133:     return grid
