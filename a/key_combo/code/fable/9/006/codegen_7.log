  84: def get_bg(grid: np.ndarray) -> int:
  85:     """Background color = most common value in the grid."""
  86:     return int(Counter(map(int, grid.flatten())).most_common(1)[0][0])
  87: 
  88: 
  89: def colors_present(grid: np.ndarray, *, exclude: Iterable[int] | None = None) -> list[int]:
  90:     """
  91:     Return the sorted unique colors present in `grid`.
  92: 
  93:     Args:
  94:         exclude: optional iterable of colors to exclude (e.g. `{bg}`)
  95:     """
  96:     cols = set(map(int, grid.flatten()))
  97:     if exclude is not None:
  98:         cols -= set(map(int, exclude))
  99:     return sorted(cols)
 100: 
 101: 
 102: def in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
 103:     """Return True iff (r,c) is within a grid of shape (H,W)."""
 104:     H, W = map(int, shape)
 105:     return 0 <= int(r) < H and 0 <= int(c) < W
