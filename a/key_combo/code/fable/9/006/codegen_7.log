 103: def generate_input():
 104:     n, m = np.random.randint(20, 30, size=2)
 105:     input_grid = np.full((m, n), Color.BLACK)
 106: 
 107:     distracter_color = np.random.choice(Color.NOT_BLACK)
 108: 
 109:     n_grey_objects = np.random.randint(1, 3)
 110:     for k in range(n_grey_objects):
 111:         grey_width, grey_height = np.random.randint(5, 8, size=2)
 112:         grey_sprite = np.full((grey_width, grey_height), Color.GREY)
 113: 
 114:         # make a black hole in the grey object
 115:         # the black hole should be a sprite whole primary color is black, and whose background color is grey
 116:         # it should be smaller than the grey object
 117:         hole_width, hole_height = np.random.randint(1, grey_width-2), np.random.randint(1, grey_height-2)
 118:         hole_sprite = random_sprite(hole_width, hole_height, color_palette=[Color.BLACK], background=Color.GREY, symmetry="not_symmetric")
 119:         try:
 120:             hole_r, hole_c = random_free_location(grey_sprite, hole_sprite, transparent=Color.GREY, border=1, padding=0, padding_connectivity=8)
 121:         except ValueError:
 122:             break
 123:         paste(grey_sprite, hole_sprite, hole_r, hole_c, transparent=Color.GREY, clip=True)
 124: 
 125:         # place the grey object in the input grid
 126:         try:
 127:             r, cc = random_free_location(input_grid, grey_sprite, transparent=Color.BLACK, border=1, padding=1, padding_connectivity=8)
 128:         except ValueError:
 129:             break
 130:         paste(input_grid, grey_sprite, r, cc, transparent=Color.BLACK, clip=True)
 131: 
 132:         # each hole has a corresponding colored object somewhere on the grid waiting for it with the same shape as the whole
 133:         # this is going to have the perfect fit, so it needs to have the same mask as the hole but a different color (but not the special colors of gray or the distracter)
 134:         color = np.random.choice([c for c in Color.NOT_BLACK if c != Color.GREY and c != distracter_color])
 135:         object_sprite = np.full((hole_width, hole_height), Color.BLACK)
 136:         object_sprite[hole_sprite == Color.BLACK] = color
 137: 
 138:         # place the object sprite in the input grid
 139:         try:
 140:             r, cc = random_free_location(input_grid, object_sprite, transparent=Color.BLACK, border=1, padding=1, padding_connectivity=8)
 141:         except ValueError:
 142:             break
 143:         paste(input_grid, object_sprite, r, cc, transparent=Color.BLACK, clip=True)
 144: 
 145:     # place small distracter objects
 146:     n_distracter_objects = np.random.randint(5, 10)
 147:     for k in range(n_distracter_objects):
 148:         distracter_width, distracter_height = np.random.randint(1, 3, size=2)
 149:         distracter_sprite = random_sprite(distracter_width, distracter_height, color_palette=[distracter_color], background=Color.BLACK)
 150:         try:
 151:             r, cc = random_free_location(input_grid, distracter_sprite, transparent=Color.BLACK, border=0, padding=1, padding_connectivity=8)
 152:         except ValueError:
 153:             break
 154:         paste(input_grid, distracter_sprite, r, cc, transparent=Color.BLACK, clip=True)
 155: 
 156:     return input_grid
