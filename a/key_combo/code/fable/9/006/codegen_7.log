  51:     out = np.full((2 * height, 2 * width), bg, dtype=int)
  52:     out[:height, :width] = g
  53:     out[height:, width:] = g
  54: 
  55:     for row in gap_rows:
  56:         out[row, :] = Color.GREEN
  57:         out[row + height, :] = Color.GREEN
