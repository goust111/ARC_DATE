+    for _ in range(extra_count):
+        n = int(extra_choices[int(rng.integers(0, len(extra_choices)))])
+        specs.append((f"noise{n}", OTHER_NOISE_PATTERNS[n][int(rng.integers(0, len(OTHER_NOISE_PATTERNS[n])))]))
