+from __future__ import annotations
+
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+PALETTE = [1, 2, 3, 4, 5, 6, 7, 8, 9]
+GENERATION_RETRIES = 400
+PLACEMENT_RETRIES = 200
+
+INVALID_FOUR_PATTERNS = [
+    [(0, 0), (0, 4), (2, 2), (4, 0)],
+    [(0, 0), (2, 2), (4, 0), (4, 4)],
+    [(0, 0), (0, 4), (4, 2), (6, 0)],
+]
