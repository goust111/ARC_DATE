+                        continue
+                    visited[nr, nc] = True
+                    q.append((nr, nc))
+            arr = np.array(coords, dtype=int)
+            components.append(
+                {
+                    "color": color,
+                    "coords": arr,
+                    "area": int(arr.shape[0]),
+                    "bbox": _bbox(arr),
+                }
