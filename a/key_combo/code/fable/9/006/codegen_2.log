+            h = int(shape[:, 0].max()) + 1
+            w = int(shape[:, 1].max()) + 1
+            if H - h - 1 <= 1 or W - w - 1 <= 1:
+                return None
+            r0 = int(rng.integers(1, H - h))
+            c0 = int(rng.integers(1, W - w))
+            coords = shape + np.array([r0, c0])
