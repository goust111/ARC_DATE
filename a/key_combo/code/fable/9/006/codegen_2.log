    bars: list[dict] = []
    H, _W = panel.shape
    for comp in comps:
        r0, c0, r1, c1 = comp["bbox"]
        if r1 != H - 1:
            return None
        if not _is_solid_bar(panel, comp):
            return None
        bars.append(
            {
                "color": int(comp["color"]),
                "height": int(r1 - r0 + 1),
                "width": int(c1 - c0 + 1),
                "left": int(c0),
                "bbox": comp["bbox"],
            }
        )

    heights = [bar["height"] for bar in bars]
    if len(set(heights)) != len(heights):
        return None
    return bars


