+def _crop_panel(grid: np.ndarray, axis: str, idx: int) -> tuple[np.ndarray, np.ndarray]:
+    if axis == "row":
+        return grid[:idx, :].copy(), grid[idx + 1 :, :].copy()
+    return grid[:, :idx].copy(), grid[:, idx + 1 :].copy()
