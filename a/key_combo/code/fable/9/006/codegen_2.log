+    for r in range(H):
+        for c in range(W):
+            if visited[r, c] or int(g[r, c]) == int(bg):
+                continue
+            color = int(g[r, c])
+            q: deque[Coord] = deque([(r, c)])
+            visited[r, c] = True
+            coords: list[Coord] = []
+            while q:
