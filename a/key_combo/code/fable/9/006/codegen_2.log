+
+def _is_solid_bar(panel: np.ndarray, comp: dict) -> bool:
+    r0, c0, r1, c1 = comp["bbox"]
+    color = int(comp["color"])
+    return np.all(panel[r0 : r1 + 1, c0 : c1 + 1] == color)
