+def _choose_active_shapes(count: int) -> list[dict]:
+    choices = random.sample(ACTIVE_SHAPES, count)
+    comp_keys = [entry["comp_key"] for entry in choices]
+    assert len(set(comp_keys)) == len(comp_keys)
+    return choices
