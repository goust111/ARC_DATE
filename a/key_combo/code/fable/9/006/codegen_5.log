+            target_count = random.randint(minimum, max(minimum, 4))
+            fill_options = [
+                mask
+                for mask in NOTCH_LIBRARY
+                if _mask_key(mask) not in local_target_keys[side]
+            ]
+            while len(wall_plans[side]) < target_count:
