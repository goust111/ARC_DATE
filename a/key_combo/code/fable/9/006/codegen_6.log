+        if not (0 <= seed[0] < h and 0 <= seed[1] < w):
+            return None
+        if int(grid[seed[0], seed[1]]) != bg:
+            return None
+        if any(int(grid[rr, cc]) != bg for rr, cc in branch):
+            return None
+        if seed in branch:
+            return None
