+def _find_hub(mask: np.ndarray) -> tuple[int, int, int]:
+    h, w = mask.shape
+    max_k = min(h, w)
+    if max_k % 2 == 0:
+        max_k -= 1
+    for k in range(max_k, 2, -2):
