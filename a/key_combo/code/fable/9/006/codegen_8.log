+def _normalize_points(points: tuple[tuple[int, int], ...]) -> tuple[tuple[int, int], ...]:
+    min_r = min(r for r, _ in points)
+    min_c = min(c for _, c in points)
+    return tuple(sorted((r - min_r, c - min_c) for r, c in points))
