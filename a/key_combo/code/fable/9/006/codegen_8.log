+    hole_infos = []
+    for coords in _components(board == BLACK, connectivity=8):
+        mask = _mask_from_coords(coords)
+        hole_infos.append(
+            {
+                "coords": coords,
+                "mask": mask,
+                "bbox": _bbox_coords(coords),
+                "key": _canonical_key(mask),
+                "area": int(coords.shape[0]),
+            }
+        )
