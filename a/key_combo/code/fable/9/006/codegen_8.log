+            grid = _assemble_canvas(panel, board, canvas_bg)
+            expected = grid.copy()
+            info = _analyze_input(grid)
+            pr0, pc0, pr1, pc1 = info["panel_bbox"]
+            expected[pr0 : pr1 + 1, pc0 : pc1 + 1] = _perfect_panel(
+                info["panel"],
+                info["panel_info"]["fg"],
+                info["panel_info"]["bg"],
+                info["panel_info"]["fg_parity"],
+            )
