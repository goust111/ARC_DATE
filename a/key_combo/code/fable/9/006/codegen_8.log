+BLACK = 0
+GREY = 5
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIR8 = [(dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if dr or dc]
+PALETTE = list(range(10))
+MAX_GEN_ATTEMPTS = 400
