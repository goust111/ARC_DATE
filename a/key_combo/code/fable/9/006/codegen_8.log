+def _connected_subset(points: tuple[tuple[int, int], ...]) -> bool:
+    pts = set(points)
+    stack = [next(iter(pts))]
+    seen = {stack[0]}
+    while stack:
+        r, c = stack.pop()
+        for dr, dc in DIR4:
+            nxt = (r + dr, c + dc)
+            if nxt in pts and nxt not in seen:
+                seen.add(nxt)
+                stack.append(nxt)
