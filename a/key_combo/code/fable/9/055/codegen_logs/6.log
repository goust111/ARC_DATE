+def _render_pair(shape: tuple[int, int], placed: list[dict], base_colors: list[int], reveal: np.ndarray, bg: int, frame_color: int) -> tuple[np.ndarray, np.ndarray]:
+    inp = np.full(shape, bg, dtype=int)
