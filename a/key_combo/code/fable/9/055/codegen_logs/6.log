+    max_h = 30
+    max_w = 30
+
+    for _ in range(120):
+        h = random.randint(min_h, max_h)
+        w = random.randint(min_w, max_w)
+        occupied = np.zeros((h, w), dtype=bool)
+        placed = []
+        order = list(range(len(specs)))
+        order.sort(key=lambda idx: specs[idx]["height"] * specs[idx]["width"], reverse=True)
