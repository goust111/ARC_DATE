+def _count_combo() -> tuple[int, int]:
+    roll = random.random()
+    if roll < 0.33:
+        return 3, random.choice([3, 4])
+    if roll < 0.7:
+        return 4, random.choice([2, 3])
+    return 5, random.choice([2, 3])
