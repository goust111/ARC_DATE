+    out = g.copy()
+    for frame in frames:
+        for j, (c0, c1) in enumerate(frame["slots"]):
+            if by_slot[j] is not None:
+                out[frame["r0"] + 1 : frame["r1"], c0 : c1 + 1] = int(by_slot[j])
+    return out
