+
+def _place_frames(specs: list[dict]) -> tuple[tuple[int, int], list[dict]] | None:
+    heights = [spec["height"] for spec in specs]
+    widths = [spec["width"] for spec in specs]
+    min_h = max(max(heights) + 4, 12)
