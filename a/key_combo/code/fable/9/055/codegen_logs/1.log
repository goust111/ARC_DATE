+    return grid
+
+
+def _variant_output(grid: np.ndarray, pivot_mode: str) -> np.ndarray:
+    out, _ = _paint_solution(grid, pivot_mode=pivot_mode)
+    return out
+
+
+def _validate_case(grid: np.ndarray) -> bool:
