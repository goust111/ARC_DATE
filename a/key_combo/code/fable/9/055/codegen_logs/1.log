+def _steps_to_boundary(shape: tuple[int, int], pos: tuple[int, int], dir_idx: int) -> int:
+    h, w = shape
+    r, c = pos
+    dr, dc = DIRS[dir_idx]
+    if dr == -1:
+        return r
+    if dr == 1:
+        return h - 1 - r
+    if dc == -1:
+        return c
+    return w - 1 - c
+
+
+def _segment_cells(pos: tuple[int, int], dir_idx: int, steps: int) -> list[tuple[int, int]]:
+    r, c = pos
+    dr, dc = DIRS[dir_idx]
+    return [(r + dr * k, c + dc * k) for k in range(1, steps + 1)]
