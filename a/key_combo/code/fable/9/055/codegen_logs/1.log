  "trajectory": "paint traversed background pixels with s.center color",
  "transform": "preserve all original plus pixels",
  "multi_step": "paint horizontal rays before vertical rays; vertical rays overwrite crossings, so a background-centered plus creates gaps in horizontal colored rays"
}
</annotation>
