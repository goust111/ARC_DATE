+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+GREY = 5
+HEAD_PALETTE = (2, 3, 4, 6, 7, 8, 9)
+DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+
+GRID_MIN = 12
+GRID_MAX = 24
+EMITTER_COUNT_RANGE = (2, 4)
+TURN_MIN = 2
+FINAL_MIN = 2
+PLACEMENT_ATTEMPTS = 240
