+        dir_vec = (rr - tail[0], cc - tail[1])
+        assert dir_vec in DIRS, "tail/head must be orthogonally adjacent"
+        emitters.append(
+            {
+                "head": (rr, cc),
+                "tail": tail,
+                "dir_idx": DIRS.index(dir_vec),
+                "color": int(grid[rr, cc]),
+            }
