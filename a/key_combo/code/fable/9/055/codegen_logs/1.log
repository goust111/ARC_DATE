                if not in_bounds((n, n), sr, sc):
                    continue
                tr, tc = pr - dc, pc + dr
                target: Coord | None = (tr, tc) if in_bounds((n, n), tr, tc) else None
                if (target is None) != want_oob:
                    continue
                triples.append(((pr, pc), (sr, sc), target, same_row))
