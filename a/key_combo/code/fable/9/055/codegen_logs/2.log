+            terrain_tops[c0 + local_c] = contact_row + 1 + bottom + extras[local_c]
+        final_row = contact_row if branch == "snug" else contact_row - 1
+        lift = random.randint(1, min(4, final_row))
+        objects.append(
+            {
+                "branch": branch,
+                "color": colors[idx],
+                "mask": mask,
+                "bottoms": bottoms,
+                "left": c0,
+                "final_row": final_row,
+                "lift": lift,
+            }
+        )
