+    def render(policy: str) -> np.ndarray:
+        trial = np.full_like(inp, BACKGROUND)
+        trial[terrain_tops[:, None] <= np.arange(inp.shape[0])[:, None]] = 0
+        trial = np.full_like(inp, BACKGROUND)
+        for c, top in enumerate(terrain_tops):
+            trial[top:, c] = TERRAIN
+        for spec in specs:
