+    h, w = map(int, shape)
+    r0, c0, r1, c1 = marker_bbox
+    row_sum = r0 + r1
+    col_sum = c0 + c1
+
+    if quadrant[0] < 0:
+        row_lo = max(0, row_sum - (h - 1))
+        row_hi = r0 - gap - 1
+    else:
+        row_lo = r1 + gap + 1
+        row_hi = min(h - 1, row_sum)
+
+    if quadrant[1] < 0:
+        col_lo = max(0, col_sum - (w - 1))
+        col_hi = c0 - gap - 1
+    else:
+        col_lo = c1 + gap + 1
+        col_hi = min(w - 1, col_sum)
+
+    return (int(row_lo), int(row_hi)), (int(col_lo), int(col_hi))
