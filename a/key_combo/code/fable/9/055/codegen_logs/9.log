+        for quadrant in [(-1, -1), (-1, 1), (1, -1), (1, 1)]:
+            (row_lo, row_hi), (col_lo, col_hi) = _quadrant_ranges((h, w), (r0, c0, r1, c1), quadrant, gap=1)
+            if row_hi - row_lo + 1 >= 3 and col_hi - col_lo + 1 >= 3:
+                feasible = True
+                break
+        if not feasible:
