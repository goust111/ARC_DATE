+        col_delta = 2 * int(c) - col_sum
+        assert row_delta != 0 and col_delta != 0, "source pixels cannot lie on a borrowed axis"
+        row_signs.add(1 if row_delta > 0 else -1)
+        col_signs.add(1 if col_delta > 0 else -1)
