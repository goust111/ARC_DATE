+
+def _place_marker(grid: np.ndarray, color: int) -> tuple[np.ndarray, tuple[int, int, int, int]] | tuple[None, None]:
+    h, w = map(int, grid.shape)
+    marker_h = int(_RNG.integers(3, min(8, h - 3)))
