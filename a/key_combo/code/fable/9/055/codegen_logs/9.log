+
+
+def _stamp_sprite(grid: np.ndarray, sprite: np.ndarray, top: int, left: int, bg: int) -> None:
+    mask = sprite != bg
+    sub = grid[top : top + sprite.shape[0], left : left + sprite.shape[1]]
+    sub[mask] = sprite[mask]
