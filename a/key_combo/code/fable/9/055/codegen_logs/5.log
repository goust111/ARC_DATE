  "dst": "settle above the one-row cushion before obstacle pixels or the bottom edge",
  "trajectory": "move all currently movable objects one row at a time simultaneously; same-color objects may stack or merge",
  "transform": "keep background and obstacle pixels fixed; obstacle pixels, cells directly above obstacle pixels, and the bottom row are blocked"
}
</annotation>
