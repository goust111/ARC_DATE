NON_BACKGROUND_COLORS = np.arange(1, 10)

def _gen_expected_output(inp: np.ndarray, motif: np.ndarray, r0: int) -> np.ndarray:
    out = np.zeros_like(inp)
    scale = 1
    height, width = inp.shape
