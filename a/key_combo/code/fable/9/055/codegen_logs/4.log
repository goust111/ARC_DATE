+BACKGROUND = 0
+PALETTE = [1, 2, 3, 4, 5, 6, 7, 8, 9]
+MAX_GENERATION_ATTEMPTS = 600
+_SEEN_OUTPUT_KEYS: set[tuple[tuple[int, int], tuple[int, ...]]] = set()
+
+
+def get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.flatten())).most_common(1)[0][0])
+
