+    swapped = _render_output([lure_color] * len(colors), [1] * len(colors), bg)
+    return (
+        not np.array_equal(output, only_colors)
+        and not np.array_equal(output, only_thickness)
+        and not np.array_equal(output, swapped)
+    )
