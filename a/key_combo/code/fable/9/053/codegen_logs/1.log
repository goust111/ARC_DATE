+    c = 0 if c0 == 0 else w - 1
+    cells: list[tuple[int, int]] = []
+    while _in_bounds(g.shape, r, c) and int(g[r, c]) != bg:
+        cells.append((r, c))
+        r += dr
+        c += dc
