+def _sample_params() -> tuple[tuple[int, int], int, str, list[int], tuple[int, int], list[int], int, list[tuple[int, int]]] | None:
+    h = random.randint(*GRID_SIDE_RANGE)
+    w = random.randint(*GRID_SIDE_RANGE)
