+    return {
+        "bg": bg,
+        "legend_corner": legend_corner,
+        "legend_cells": legend_cells,
+        "legend_colors": legend_colors,
+        "points": points,
+        "step": step,
+        "gaps": gaps,
+        "gap_diff": gap_diff,
+    }
