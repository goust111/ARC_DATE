+        return False
+    if parsed["legend_colors"] != intended["legend_colors"]:
+        return False
+    if parsed["points"] != intended["points"]:
+        return False
+    if parsed["step"] != intended["step"]:
+        return False
+    if parsed["gaps"] != intended["gaps"]:
+        return False
+    if parsed["gap_diff"] != intended["gap_diff"]:
+        return False
