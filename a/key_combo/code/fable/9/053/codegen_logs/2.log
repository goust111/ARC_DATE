+    sr, sc = map(int, start)
+    er, ec = map(int, end)
+    mh, mw = motif.shape
+    if sr == er:
+        c_lo, c_hi = sorted((sc, ec))
+        for r in range(sr, sr + mh):
+            row_rel = r - sr
+            for c in range(c_lo, c_hi + 1):
+                axis = c - sc if ec > sc else sc - c
+                col_rel = axis % mw if ec > sc else (mw - 1 - (axis % mw))
+                out[r, c] = int(motif[row_rel, col_rel])
