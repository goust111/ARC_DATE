+            if orient == "h" and np.array_equal(motif["block"][:, 0], motif["block"][:, -1]):
+                continue
+            if orient == "v" and np.array_equal(motif["block"][0, :], motif["block"][-1, :]):
+                continue
+
+            occupied.extend([strip_box, start_box, end_box])
+            pair_specs.append(
+                {
+                    "start": start,
+                    "end": end,
+                    "color": main_color,
+                    "motif": motif["block"],
+                    "clipped": clipped,
+                }
