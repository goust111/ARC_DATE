+GRID_W_RANGE = (16, 27)
+MOTIF_H_RANGE = (2, 5)
+MOTIF_W_RANGE = (2, 5)
+MOTIF_COUNT_RANGE = (2, 5)
+PAIR_COUNT_RANGE = (2, 5)
