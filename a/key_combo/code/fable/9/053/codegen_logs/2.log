spec:
  grid: 6-10 rows x 8-11 cols, background always 0 (black)
  markers:
    count: 1-2 distinct foreground colors, each appearing as exactly 2 pixels
    placement: two pixels of the same color are always at strictly diagonal positions (different row AND different column)
    colors: any non-zero ARC colors (1-9), all distinct
  rectangles:
    definition: axis-aligned bounding box of each marker pair, filled with that color
    dimensions: each side 2-7 cells; both sides >= 2 [observed]
    non_overlap: rectangles must not overlap (no shared cell)
    coverage: 25-36% of grid area [observed]
  output:
    same_size: output grid same dimensions as input
    rule: fill each marker pair's bounding rectangle with its color; everything else becomes background

generation_strategy:
  approach: output-first
  steps:
    1. Pick grid dimensions H in [6,10], W in [8,11].
    2. Pick N in [1,2] foreground colors (distinct, from 1-9).
    3. For each color, pick rectangle dimensions rh in [2,7], rw in [2,7].
    4. Place rectangles on the grid with no overlap (and optional gap >= 0 between them). Use random placement with rejection or sequential packing.
    5. Build output grid by filling each rectangle region with its color.
    6. Build input grid (all background) then for each rectangle, pick two opposite-corner cells (diagonal) and place the color there. The two corners must be at (rmin, cmin)&(rmax, cmax) or (rmin, cmax)&(rmax, cmin) — chosen randomly.
