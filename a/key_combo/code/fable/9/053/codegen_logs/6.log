spec:
  grid: 23-27 rows x 23-27 cols, square, uniform bg color
  legend:
    position: top-left corner, starting at (1,1)
    structure: single-pixel dots on a regular lattice with step=2 (every other cell)
    size: 3-4 rows x 2-3 cols in lattice coords; 6-10 filled pixels
    shape: not always a full rectangle; some lattice positions may be empty (0-2 empties), but filled positions form a connected staircase (each row has cols 0..k for some k)
    colors: 2-4 distinct non-bg colors; pattern is arbitrary but each color appears 1-6 times
  blocks:
    count_in_input: exactly 2 square blocks (NxN uniform color, N=2-4)
    placement: same legend-row, adjacent legend-columns (col gap = 1 in lattice coords)
    block_step: block_size + gap where gap=1-3; step=3-5 in cells
    role: anchor the scale/offset mapping from legend to main grid
  block_area:
    no spatial overlap with legend pixels (separated by columns)
    all output blocks fit within the grid with margin
  output:
    fill every legend pixel position with its corresponding NxN block; input blocks are kept, missing ones are added
  solver_constraint: the 2 input blocks must yield a unique base offset via color-position voting against legend

generation_strategy:
