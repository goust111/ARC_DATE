+def _extract_legend_and_blocks(grid: np.ndarray, bg: int) -> tuple[np.ndarray, list[tuple[int, int, int]]]:
+    singles: list[tuple[int, int, int]] = []
+    blocks: list[tuple[int, int, int, int]] = []
+    for coords in _components(grid != bg):
