+import numpy as np
+
+
+LEGEND_ORIGIN = (1, 1)
+LEGEND_STEP = 2
+GRID_MIN = 22
+GRID_MAX = 30
+LEGEND_DIM_RANGE = (3, 5)
+FILLED_COUNT_RANGE = (6, 10)
+LEGEND_COLOR_COUNT_RANGE = (2, 4)
