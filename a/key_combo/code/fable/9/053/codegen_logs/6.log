+    cols = sorted({c for _, c, _ in singles})
+    row_diffs = [rows[i + 1] - rows[i] for i in range(len(rows) - 1) if rows[i + 1] > rows[i]]
+    col_diffs = [cols[i + 1] - cols[i] for i in range(len(cols) - 1) if cols[i + 1] > cols[i]]
+    diffs = row_diffs + col_diffs
