    interior: entirely bg; min(interior_h, interior_w) >= 2*N_markers - 1
  markers:
    count: 2-5 singleton pixels, each a unique non-bg non-frame color
    layout: contiguous down-right diagonal from (0,0) to (N-1,N-1)
