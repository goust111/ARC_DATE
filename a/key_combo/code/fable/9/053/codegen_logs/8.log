+            direction = int(dir_map[r + 1, c])
+            nc = c + direction
+            assert 0 <= nc < w, "ramp deflection must stay in bounds"
+            c = nc
+            path.append((r, c))
+            slide_steps += 1
+            directions.append(direction)
+        else:
+            r += 1
+            path.append((r, c))
