+    for comp in _components8(grey_mask):
+        direction = _ramp_direction(comp)
+        for r, c in comp:
+            dir_map[r, c] = direction
+    return dir_map
+
+
+def _trace_path(grey_mask: np.ndarray, dir_map: np.ndarray, source_c: int) -> dict:
+    h, w = grey_mask.shape
