+from __future__ import annotations
+
+import itertools
+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+LANDING_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+
+GRID_H_RANGE = (12, 21)
+GRID_W_RANGE = (12, 23)
+RAMP_COUNT_RANGE = (2, 5)
+RAMP_LEN_RANGE = (2, 5)
