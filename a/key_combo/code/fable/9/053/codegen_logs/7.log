+def _generate_attempt(rng: np.random.Generator) -> np.ndarray | None:
+    k = int(rng.integers(K_RANGE[0], K_RANGE[1] + 1))
+    canvas_h = int(rng.integers(CANVAS_H_RANGE[0], CANVAS_H_RANGE[1] + 1))
