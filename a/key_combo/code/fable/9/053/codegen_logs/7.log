    (rh0, rw0), (rh1, rw1) = dims
    side_by_side = max(rh0, rh1) <= h and rw0 + rw1 <= w
    stacked = rh0 + rh1 <= h and max(rw0, rw1) <= w
    return side_by_side or stacked


