    r = r0
    assert r + 1 < g.shape[0]
    assert _is_motif_cell(g[r + 1, c0], bg)

    height = 0
    while r + 1 + height < g.shape[0] and _is_motif_cell(g[r + 1 + height, c0], bg):
        height += 1
    assert height > 0

