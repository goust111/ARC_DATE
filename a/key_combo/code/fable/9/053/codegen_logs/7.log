                        continue

                    r0 = r1 - rect_h + 1
                    crop = g[r0 : r1 + 1, c0 : c1 + 1]
                    count_a = int(np.count_nonzero(crop == a))
                    count_b = int(np.count_nonzero(crop == b))
                    if count_a == 0 or count_b == 0 or count_a == count_b:
                        continue

                    base, marker = (a, b) if count_a > count_b else (b, a)
