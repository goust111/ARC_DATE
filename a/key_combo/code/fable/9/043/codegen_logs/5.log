+def region_slots(grid: np.ndarray, region_mask: np.ndarray) -> list[tuple[int, int]]:
+    slots = []
+    h, w = grid.shape
+    for r in range(h):
+        for c in range(w):
+            if grid[r, c] != BLACK:
+                continue
+            contact = 0
+            for nr, nc in neighbors4(r, c):
+                if in_bounds(grid.shape, nr, nc) and region_mask[nr, nc]:
