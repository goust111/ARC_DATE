+def split_range(length: int, gutter: int = 2) -> tuple[tuple[int, int], tuple[int, int]]:
+    total = length - gutter
+    first = random.randint(total // 2 - 1, total // 2 + 1)
+    first = max(5, min(total - 5, first))
+    second = total - first
+    return (0, first - 1), (first + gutter, first + gutter + second - 1)
