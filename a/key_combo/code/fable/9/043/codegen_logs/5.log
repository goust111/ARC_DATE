+def derangement(values: list[int]) -> list[int]:
+    vals = values[:]
+    for _ in range(100):
+        random.shuffle(vals)
+        if all(a != b for a, b in zip(values, vals)):
+            return vals[:]
+    raise RuntimeError("failed to sample a derangement")
