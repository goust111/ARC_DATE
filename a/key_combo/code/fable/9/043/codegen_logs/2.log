+
+def _latin_pair(n: int, rng: np.random.Generator) -> tuple[np.ndarray, np.ndarray]:
+    assert n in (3, 5)
+    multipliers = [a for a in range(2, n) if np.gcd(a, n) == 1]
+    a = int(rng.choice(multipliers))
