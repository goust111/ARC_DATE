11: def main(grid: np.ndarray) -> np.ndarray:
12:     """
13:     Extend a solid rectangle into side stripes, leaving blank the rows or columns marked by control pixels.
14: 
15:     Input structure:
16:     - The background is the dominant color.
17:     - The foreground contains one unique largest 4-connected solid rectangle and singleton marker pixels of one other color.
18:     - Every marker lies in one of the four side strips aligned with the rectangle, not in a diagonal quadrant.
19: 
20:     Rule:
21:     - Keep the original rectangle and markers unchanged.
22:     - Above and below the rectangle, fill each rectangle column that has no marker on that side.
23:     - Left and right of the rectangle, fill each rectangle row that has no marker on that side.
24: 
25:     Key insight:
26:     - The markers encode the excluded projected rows or columns for their side of the rectangle; the unmarked positions become rectangle-colored extension stripes.
27:     """
28:     g = np.asarray(grid, dtype=int)
29:     assert g.ndim == 2, "expected a 2D grid"
30: 
31:     bg = get_bg(g)
32:     components = find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict")
33:     assert components, "expected foreground components"
34: 
35:     max_area = max(int(comp["area"]) for comp in components)
36:     rectangles = [comp for comp in components if int(comp["area"]) == max_area]
37:     assert len(rectangles) == 1, "expected one unique largest rectangle"
38: 
39:     rectangle = rectangles[0]
40:     fill = int(rectangle["color"])
41:     r0, c0, r1, c1 = rectangle["bbox"]
42:     assert int(rectangle["area"]) == bbox_h(rectangle["bbox"]) * bbox_w(rectangle["bbox"]), "expected a solid rectangle"
43: 
44:     markers = [comp for comp in components if comp is not rectangle]
45:     assert markers, "expected marker pixels"
46:     assert all(int(marker["area"]) == 1 for marker in markers), "markers must be singleton pixels"
47:     marker_colors = {int(marker["color"]) for marker in markers}
48:     assert len(marker_colors) == 1, "expected one marker color"
49: 
50:     marked_top: set[int] = set()
51:     marked_bottom: set[int] = set()
52:     marked_left: set[int] = set()
53:     marked_right: set[int] = set()
54:     for marker in markers:
55:         r, c = map(int, marker["coords"][0])
56:         side_hits = 0
57:         if r < r0 and c0 <= c <= c1:
58:             marked_top.add(c)
59:             side_hits += 1
60:         if r > r1 and c0 <= c <= c1:
61:             marked_bottom.add(c)
62:             side_hits += 1
63:         if c < c0 and r0 <= r <= r1:
64:             marked_left.add(r)
65:             side_hits += 1
66:         if c > c1 and r0 <= r <= r1:
67:             marked_right.add(r)
68:             side_hits += 1
69:         assert side_hits == 1, "each marker must align with exactly one rectangle side"
70: 
71:     out = g.copy()
72:     for c in range(c0, c1 + 1):
73:         if c not in marked_top:
74:             _paint_bg_cells(out, slice(0, r0), c, fill, bg)
75:         if c not in marked_bottom:
76:             _paint_bg_cells(out, slice(r1 + 1, out.shape[0]), c, fill, bg)
77: 
78:     for r in range(r0, r1 + 1):
79:         if r not in marked_left:
80:             _paint_bg_cells(out, r, slice(0, c0), fill, bg)
81:         if r not in marked_right:
82:             _paint_bg_cells(out, r, slice(c1 + 1, out.shape[1]), fill, bg)
83: 
84:     return out
