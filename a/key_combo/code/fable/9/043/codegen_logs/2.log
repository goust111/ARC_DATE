spec:
  grid: NxN square, N=4 [observed, solver supports any N]
  palette: N distinct non-black colors; always {1,2,3,4} [observed]
  background: 0 (black) represents blank cells
  output: a valid Latin square over the palette -- every row and column contains each palette color exactly once
  input: the output with 5-6 blanks (black cells) replacing some entries
  blanks:
    count: 5-6 (31-38% of cells)
    per_row: 1-3, every row has at least 1 filled cell [observed]
    per_col: 0-3, at most one column has 0 blanks [observed]
  constraints:
    - every palette color appears at least once in the partially filled input
    - the partial grid has exactly one valid Latin-square completion
    - existing non-black cells satisfy Latin-square constraints (no duplicate color in any row/column)

generation_strategy:
  approach: output-first
  steps:
    1. Set N=4 and palette={1,2,3,4}.
    2. Generate a random NxN Latin square over the palette (e.g. start with row [1..N], permute subsequent rows ensuring column uniqueness).
    3. Select 5-6 cells to blank out (set to 0), ensuring all palette colors still appear in the remaining filled cells.
    4. Verify the partial grid has exactly one Latin-square completion (run the solver's backtracking search; reject if not unique).
    5. The partial grid is the input; the full Latin square is the output.
```
