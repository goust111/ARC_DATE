+
+def _detect_separator(grid: np.ndarray) -> tuple[int, np.ndarray, np.ndarray]:
+    h, w = grid.shape
+    candidates = []
+    for color in np.unique(grid):
+        rows = np.where(np.all(grid == color, axis=1))[0]
+        cols = np.where(np.all(grid == color, axis=0))[0]
