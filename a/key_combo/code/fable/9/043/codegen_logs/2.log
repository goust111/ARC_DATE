+            shape_ids[r, c] = shape_id
+            color_ids[r, c] = color_id
+            tiles.append(
+                {
+                    "rc": (r, c),
+                    "bbox": (r0, c0, r1, c1),
+                    "tile": tile.copy(),
+                    "mask": mask,
+                    "full_mask": full_mask,
+                    "shape_id": shape_id,
+                    "color": color,
