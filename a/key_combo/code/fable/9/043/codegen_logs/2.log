+def _line_violations(table: np.ndarray) -> tuple[list[int], dict[int, int], list[int], dict[int, int]]:
+    n = table.shape[0]
+    target = set(range(n))
+    bad_rows: list[int] = []
+    row_missing: dict[int, int] = {}
+    bad_cols: list[int] = []
+    col_missing: dict[int, int] = {}
