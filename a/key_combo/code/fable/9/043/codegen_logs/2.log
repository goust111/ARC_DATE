+
+
+def _is_valid_solution(shape_ids: np.ndarray, color_ids: np.ndarray) -> bool:
+    n = shape_ids.shape[0]
+    target = set(range(n))
+    for r in range(n):
+        if set(int(v) for v in shape_ids[r, :]) != target:
+            return False
+        if set(int(v) for v in color_ids[r, :]) != target:
+            return False
