+    row_perm = rng.permutation(n)
+    col_perm = rng.permutation(n)
+    s = s[row_perm][:, col_perm]
+    col = col[row_perm][:, col_perm]
+    s = rng.permutation(n)[s]
+    col = rng.permutation(n)[col]
