+    full_shape_masks: list[np.ndarray] = []
+    shape_ids = np.empty((n, n), dtype=int)
+    color_ids = np.empty((n, n), dtype=int)
+    colors_seen: list[int] = []
+
+    for r, (r0, r1) in enumerate(row_spans):
