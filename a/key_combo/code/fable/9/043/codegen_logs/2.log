7: def main(grid: np.ndarray) -> np.ndarray:
8:     """
9:     Delete every isolated foreground pixel while preserving all foreground clusters.
10: 
11:     Input structure:
12:     - The grid has one dominant background color.
13:     - All foreground pixels share a single color.
14:     - Foreground pixels appear as isolated pixels and as 8-connected clusters.
15: 
16:     Rule:
17:     - Label the foreground pixels using 8-connectivity, so diagonal contact joins a cluster.
18:     - Replace each size-1 foreground component with the background color.
19:     - Keep every foreground component whose size is greater than one.
20: 
21:     Key insight:
22:     - The output is a noise removal: singleton foreground pixels disappear, but any pixel
23:       touching another foreground pixel in the 8-neighborhood remains.
24:     """
25:     g = np.asarray(grid, dtype=int)
26:     assert g.ndim == 2, "expected a 2D grid"
27: 
28:     bg = get_bg(g)
29:     foreground_colors = colors_present(g, exclude={bg})
30:     assert len(foreground_colors) == 1, "expected exactly one foreground color"
31:     fg = foreground_colors[0]
32: 
33:     out = np.full(g.shape, bg, dtype=int)
34:     components = components_mask(g != bg, connectivity=8)
35:     assert components, "expected at least one foreground component"
36:     for coords in components:
37:         if len(coords) > 1:
38:             out[coords[:, 0], coords[:, 1]] = fg
39: 
40:     return out
