+                        "compressed": oriented.copy(),
+                        "orientation_key": orientation_key,
+                        "area": int(raw.sum()),
+                        "bbox_shape": tuple(int(x) for x in raw.shape),
+                        "stretched": raw.shape != oriented.shape,
+                    }
