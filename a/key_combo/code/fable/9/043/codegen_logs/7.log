+    outlier_variants = _VARIANT_POOL[outlier_base]
+
+    objects: list[dict] = []
+    forced_color = random.choice(_PALETTE)
+    outlier_variant = random.choice(outlier_variants)
+    objects.append({**outlier_variant, "color": forced_color})
