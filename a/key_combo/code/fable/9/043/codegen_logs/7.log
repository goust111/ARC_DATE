def _gen_mark_blocked(blocked, coords):
    h, w = blocked.shape
    for r, c in coords:
        r0 = max(0, int(r) - 1)
        r1 = min(h, int(r) + 2)
        c0 = max(0, int(c) - 1)
        c1 = min(w, int(c) + 2)
