+    assert len(counts) == 2
+    majority_signature, majority_count = counts.most_common(1)[0]
+    assert majority_count == len(records) - 1
+
+    outliers = [record for record in records if record["canonical"] != majority_signature]
+    assert len(outliers) == 1
+    chosen = outliers[0]
