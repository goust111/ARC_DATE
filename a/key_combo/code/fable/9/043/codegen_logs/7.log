+        return None
+
+    random.shuffle(objects)
+    grid = _place_objects(height, width, objects)
+    if grid is None:
+        return None
+    if not _semantic_ok(grid):
+        return None
+
+    output_sig = _serialize(main(grid))
+    if output_sig in _SEEN_OUTPUT_SIGS:
+        return None
+    _SEEN_OUTPUT_SIGS.add(output_sig)
+    return grid
+
