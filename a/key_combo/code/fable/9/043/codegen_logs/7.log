+
+
+def _stretch_mask(mask: np.ndarray, row_factors: tuple[int, ...], col_factors: tuple[int, ...]) -> np.ndarray:
+    return np.repeat(np.repeat(mask, row_factors, axis=0), col_factors, axis=1)
