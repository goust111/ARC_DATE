+def _mask(rows: list[str]) -> np.ndarray:
+    return np.array([[ch == "1" for ch in row] for row in rows], dtype=bool)
+
+
+_BASE_MASKS = [
+    _mask(["111", "101", "111"]),
+    _mask(["010", "111", "010"]),
+    _mask(["111", "010", "010"]),
+    _mask(["101", "111"]),
+    _mask(["101", "111", "101"]),
+    _mask(["110", "011"]),
+    _mask(["100", "111"]),
+    _mask(["1111", "1001", "1111"]),
+    _mask(["111", "110", "100"]),
+    _mask(["111", "001", "111"]),
+    _mask(["011", "110", "010"]),
+    _mask(["111", "101", "100"]),
