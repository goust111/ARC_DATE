+def _dilate_chebyshev(mask: np.ndarray, radius: int = 1) -> np.ndarray:
+    if radius <= 0:
+        return mask.copy()
+    h, w = mask.shape
+    out = np.zeros_like(mask, dtype=bool)
+    coords = np.argwhere(mask)
+    for r, c in coords:
