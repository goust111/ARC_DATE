+            objects.append({"color": color, "coords": coords})
+    return objects
+
+
+def _compress_mask(mask: np.ndarray) -> np.ndarray:
+    arr = np.asarray(mask, dtype=bool)
+    assert arr.ndim == 2 and arr.any()
