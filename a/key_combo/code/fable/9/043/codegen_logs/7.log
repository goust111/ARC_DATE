+    _mask(["101", "111"]),
+    _mask(["101", "111", "101"]),
+    _mask(["110", "011"]),
+    _mask(["100", "111"]),
+    _mask(["1111", "1001", "1111"]),
+    _mask(["111", "110", "100"]),
