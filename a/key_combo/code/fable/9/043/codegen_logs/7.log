+def _compress_mask(mask: np.ndarray) -> np.ndarray:
+    arr = np.asarray(mask, dtype=bool)
+    assert arr.ndim == 2 and arr.any()
+
+    keep_rows = [0]
+    for r in range(1, arr.shape[0]):
+        if not np.array_equal(arr[r], arr[r - 1]):
+            keep_rows.append(r)
+    arr = arr[keep_rows, :]
