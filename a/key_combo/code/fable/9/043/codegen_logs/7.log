+                raw = _stretch_mask(oriented, row_factors, col_factors)
+                if raw.shape[0] > _MAX_PATCH_DIM or raw.shape[1] > _MAX_PATCH_DIM:
+                    continue
+                key = _serialize(raw)
+                if key in seen:
+                    continue
+                seen.add(key)
+                variants.append(
+                    {
+                        "raw": raw,
+                        "compressed": oriented.copy(),
+                        "orientation_key": orientation_key,
+                        "area": int(raw.sum()),
