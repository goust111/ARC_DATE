+                "raw": raw,
+                "compressed": compressed,
+                "canonical": _canonical_signature(compressed),
+                "area": int(raw.sum()),
+                "bbox_shape": tuple(int(x) for x in raw.shape),
+                "bbox_area": int(raw.shape[0] * raw.shape[1]),
