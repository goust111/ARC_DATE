+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    objects: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if color == bg or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                cells.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(g[nr, nc]) == color:
