+def generate_input() -> np.ndarray:
+    for _ in range(_MAX_GENERATION_ATTEMPTS):
+        grid = _sample_scene()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid topology-outlier scene")

