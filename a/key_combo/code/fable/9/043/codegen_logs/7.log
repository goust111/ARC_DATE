+    _mask(["111", "101", "111"]),
+    _mask(["010", "111", "010"]),
+    _mask(["111", "010", "010"]),
+    _mask(["101", "111"]),
+    _mask(["101", "111", "101"]),
+    _mask(["110", "011"]),
+    _mask(["100", "111"]),
+    _mask(["1111", "1001", "1111"]),
+    _mask(["111", "110", "100"]),
+    _mask(["111", "001", "111"]),
+    _mask(["011", "110", "010"]),
+    _mask(["111", "101", "100"]),
+]
+
+_PALETTE = tuple(range(1, 10))
+_GRID_H_RANGE = (18, 31)
+_GRID_W_RANGE = (18, 31)
+_OBJECT_COUNT_RANGE = (4, 7)
+_MAX_PATCH_DIM = 9
+_MAX_EXTRA_REPEAT = 4
+_MAX_GENERATION_ATTEMPTS = 500
+_SEEN_OUTPUT_SIGS: set[tuple[tuple[int, ...], ...]] = set()
+
+
+def _check_connected(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if len(coords) == 0:
+        return False
+    pending = [tuple(int(x) for x in coords[0])]
+    seen = {pending[0]}
+    target = {tuple(int(x) for x in rc) for rc in coords}
+    while pending:
+        r, c = pending.pop()
+        for nr, nc in _neighbors4(r, c):
+            if (nr, nc) in target and (nr, nc) not in seen:
