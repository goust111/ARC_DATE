+
+def _attempt_generate(rng: np.random.Generator) -> np.ndarray | None:
+    layout = _choose_layout(rng)
+    if layout is None:
+        return None
+    shape, boxes, orientation = layout
+    fg_color = int(rng.choice(MARKER_COLORS))
