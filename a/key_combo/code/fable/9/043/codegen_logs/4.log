+    candidates: list[tuple[tuple[int, int], tuple[int, int]]] = []
+    for c in range(c0 + 1, c1):
+        candidates.append(((r0, c), (-1, 0)))
+        candidates.append(((r1, c), (1, 0)))
+    for r in range(r0 + 1, r1):
+        candidates.append(((r, c0), (0, -1)))
+        candidates.append(((r, c1), (0, 1)))
