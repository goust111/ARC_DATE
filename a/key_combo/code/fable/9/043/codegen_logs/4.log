+    while q:
+        r, c = q.popleft()
+        if not alive[r, c] or degree[r, c] > 1:
+            continue
+        alive[r, c] = False
+        for nr, nc in _neighbors4(r, c):
+            if _in_bounds(alive.shape, nr, nc) and alive[nr, nc]:
+                degree[nr, nc] -= 1
+                if degree[nr, nc] <= 1:
