+import numpy as np
+
+
+BG = 0
+DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+MARKER_COLORS = tuple(range(1, 10))
+MAX_ATTEMPTS = 400
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def _neighbors4(r: int, c: int):
+    for dr, dc in DIRS4:
+        yield r + dr, c + dc
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    parts: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            parts.append(np.array(coords, dtype=int))
+    return parts
+
+
+def _prune_to_fixpoint(mask: np.ndarray) -> np.ndarray:
+    alive = mask.copy()
+    degree = np.zeros(mask.shape, dtype=int)
+    q: deque[tuple[int, int]] = deque()
+
+    for r, c in np.argwhere(alive):
+        rr, cc = int(r), int(c)
+        deg = 0
+        for nr, nc in _neighbors4(rr, cc):
+            if _in_bounds(alive.shape, nr, nc) and alive[nr, nc]:
+                deg += 1
+        degree[rr, cc] = deg
+        if deg <= 1:
+            q.append((rr, cc))
+
+    while q:
+        r, c = q.popleft()
+        if not alive[r, c] or degree[r, c] > 1:
+            continue
+        alive[r, c] = False
+        for nr, nc in _neighbors4(r, c):
+            if _in_bounds(alive.shape, nr, nc) and alive[nr, nc]:
+                degree[nr, nc] -= 1
+                if degree[nr, nc] <= 1:
+                    q.append((nr, nc))
+    return alive
+
+
+def _enclosed_voids(structure_mask: np.ndarray) -> list[np.ndarray]:
+    voids: list[np.ndarray] = []
+    for coords in _components(~structure_mask):
+        rows = coords[:, 0]
+        cols = coords[:, 1]
+        if (
+            int(rows.min()) == 0
+            or int(rows.max()) == structure_mask.shape[0] - 1
+            or int(cols.min()) == 0
+            or int(cols.max()) == structure_mask.shape[1] - 1
+        ):
+            continue
+        voids.append(coords)
+    return voids
+
