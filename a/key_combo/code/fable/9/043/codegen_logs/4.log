+
+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(MAX_ATTEMPTS):
+        grid = _attempt_generate(rng)
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid iterative-pruning loop input")

