+    width = left_room + max(col_offsets[i] + loop_widths[i] for i in range(n_loops)) + right_room
+    if max(height, width) > 30:
+        return None
+
+    boxes = []
+    r0 = top_room
+    for i in range(n_loops):
+        c0 = left_room + col_offsets[i]
