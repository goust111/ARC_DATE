+    direction: tuple[int, int],
+) -> list[tuple[int, int]] | None:
+    for trunk_len in rng.permutation(np.arange(1, 5)):
+        trunk = [
+            (anchor[0] + direction[0] * step, anchor[1] + direction[1] * step)
+            for step in range(1, int(trunk_len) + 1)
