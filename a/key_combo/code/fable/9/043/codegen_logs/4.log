+        if not trunk:
+            continue
+        cells = list(trunk)
+        edges: dict[tuple[int, int], set[tuple[int, int]]] = {}
+
+        def link(a: tuple[int, int], b: tuple[int, int]) -> None:
+            edges.setdefault(a, set()).add(b)
+            edges.setdefault(b, set()).add(a)
