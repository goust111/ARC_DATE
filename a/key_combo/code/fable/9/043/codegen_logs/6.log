+        (red_cancel, PINK),
+        (mixed_odd, BLACK),
+        (mixed_odd, PINK),
+        (yellow_odd, PINK),
+        (red_odd, BLACK),
+        (yellow_none, TEAL),
+        (red_none, ORANGE),
