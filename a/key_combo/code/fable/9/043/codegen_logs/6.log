  "type": "transform_in_place",
  "src": "rows or columns selected by yellow marker pairs on opposite grid edges",
  "transform": "toggle each strict interior pixel between paired markers: black <-> teal and pink <-> orange; keep the yellow markers and all other cells unchanged"
}
</annotation>
