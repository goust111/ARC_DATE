        area = int(bar["area"])
        assert area == h * w, "foreground bar must be solid"
        assert h == 1 or w == 1, "foreground object must be a straight bar"

        length = max(h, w)
        radius = (length - 1) // 2
        assert radius >= 1, "bar must be long enough to form an envelope"

