+BLACK = 0
+RED = 2
+YELLOW = 4
+PINK = 6
+ORANGE = 7
+TEAL = 8
+
+INTERIOR_COLORS = np.array([BLACK, PINK, ORANGE, TEAL], dtype=int)
+ALLOWED_COLORS = np.array([BLACK, RED, YELLOW, PINK, ORANGE, TEAL], dtype=int)
