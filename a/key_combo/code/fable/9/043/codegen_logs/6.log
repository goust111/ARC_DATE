+    teal_mask = g == TEAL
+    pink_mask = g == PINK
+    orange_mask = g == ORANGE
+
+    out[yellow_odd & black_mask] = TEAL
+    out[yellow_odd & teal_mask] = BLACK
+    out[red_odd & pink_mask] = ORANGE
+    out[red_odd & orange_mask] = PINK
+    return out
