_GEN_SEGMENTS_PER_BAND_RANGE = (1, 4)
_GEN_TOTAL_SEGMENTS_RANGE = (9, 13)
_GEN_DOMINANT_LEN_RANGE = (8, 11)

# Generation retry limit.
