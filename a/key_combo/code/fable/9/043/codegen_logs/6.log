+def _beam_count_mask(shape: tuple[int, int], rows: list[int], cols: list[int]) -> np.ndarray:
+    h, w = shape
+    row_mask = np.zeros(h, dtype=bool)
+    col_mask = np.zeros(w, dtype=bool)
+    row_mask[rows] = True
+    col_mask[cols] = True
+    counts = row_mask[:, None].astype(int) + col_mask[None, :].astype(int)
+    counts[[0, h - 1], :] = 0
+    counts[:, [0, w - 1]] = 0
+    return counts
