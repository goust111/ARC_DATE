+
+
+BG = 0
+COLOR_POOL = tuple(range(1, 10))
+
+GRID_HEIGHT_RANGE = (18, 28)
+GRID_WIDTH_RANGE = (18, 28)
+OBJECT_COUNT_CHOICES = (2, 3)
