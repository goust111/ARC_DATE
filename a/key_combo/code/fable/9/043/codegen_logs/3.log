def _gen_weighted_choice(items, weights):
    """Sample one item from weights aligned with items."""
    total = sum(weights)
    pick = random.uniform(0, total)
    for item, weight in zip(items, weights):
        pick -= weight
        if pick <= 0:
            return item
    return items[-1]

