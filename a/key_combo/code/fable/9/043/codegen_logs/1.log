+def control_adjacency_is_clean(
+    path: list[tuple[int, int]], controls: list[tuple[int, int]]
+) -> bool:
+    path_set = set(path)
+    for control in controls:
+        neighbors = sum((neighbor in path_set) for neighbor in path_neighbors(control, path_set))
+        if neighbors != 1:
+            return False
+    return True
