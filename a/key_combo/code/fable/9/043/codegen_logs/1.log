    placed = coords + np.array([r0, c0], dtype=int)
    grid[placed[:, 0], placed[:, 1]] = color
    _gen_mark_blocked(blocked, placed)
    return placed


def _gen_place_singletons(grid, blocked, n_singletons, color):
    singleton_coords = []
