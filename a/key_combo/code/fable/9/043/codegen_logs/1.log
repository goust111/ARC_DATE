                    cmax = int(nz.max())
                    for cc in range(cmin, cmax + 1):
                        if pred[r, cc] == 0 and not stable_mask[r, cc]:
                            pred[r, cc] = v
            for c in range(w):
                nz = np.where(pred[:, c] != 0)[0]
