                            pred[rr, c] = v
            if np.array_equal(pred, dst):
                return ("fill", {"stable": st})

        return None

    def apply_template(kind, params, x):
        if kind == "sym":
            return symmetries(x)[params["idx"]].copy()

        st = set(params.get("stable", set()))
