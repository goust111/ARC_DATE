743:
744:def build_fill_pair(n: int, colors: list[int], rng: random.Random) -> tuple[np.ndarray, np.ndarray]:
745:    v = colors[0]
746:    dst = np.zeros((n, n), dtype=int)
747:    while True:
748:        h = rng.randint(2, n)
749:        w = rng.randint(2, n)
750:        if FILL_RECT_AREA_MIN <= h * w <= FILL_RECT_AREA_MAX:
751:            break
752:    r0 = rng.randint(0, n - h)
753:    c0 = rng.randint(0, n - w)
754:    dst[r0 : r0 + h, c0 : c0 + w] = v
755:    src = np.zeros_like(dst)
756:    src[r0, c0] = v
757:    src[r0, c0 + w - 1] = v
758:    src[r0 + h - 1, c0] = v
759:    src[r0 + h - 1, c0 + w - 1] = v
760:    return src, dst
761:
762:
763:def build_endpoints_pair(n: int, colors: list[int], rng: random.Random) -> tuple[np.ndarray, np.ndarray]:
764:    v = colors[0]
765:    src = np.zeros((n, n), dtype=int)
766:    dst = np.zeros_like(src)
767:    row_pairs = [(0, n - 1)]
768:    if n >= 5:
769:        row_pairs.extend([(0, n - 2), (1, n - 1)])
770:    r1, r2 = rng.choice(row_pairs)
771:    len1 = rng.randint(ENDPOINTS_LINE_LEN_MIN, n)
772:    len2 = rng.randint(ENDPOINTS_LINE_LEN_MIN, n)
773:    c1 = rng.randint(0, n - len1)
774:    c2 = rng.randint(0, n - len2)
775:    draw_line(src, r1, c1, end_r=r1, end_c=c1 + len1 - 1, color=v)
776:    draw_line(src, r2, c2, end_r=r2, end_c=c2 + len2 - 1, color=v)
777:    dst[r1, c1] = v
778:    dst[r1, c1 + len1 - 1] = v
779:    dst[r2, c2] = v
780:    dst[r2, c2 + len2 - 1] = v
781:    return src, dst
782:
783:
784:def build_comp_checker_pair(n: int, colors: list[int], rng: random.Random) -> tuple[np.ndarray, np.ndarray]:
785:    if len(colors) == 1:
786:        even_color = odd_color = colors[0]
787:    else:
788:        even_color, odd_color = colors
789:    min_src = 4 if n == 6 else 3
790:    m = rng.randint(min_src, min(COMP_CHECKER_M_MAX, n * n - 3))
791:    all_cells = [(r, c) for r in range(n) for c in range(n)]
792:    while True:
793:        chosen = rng.sample(all_cells, m)
794:        parities = {(r + c) & 1 for r, c in chosen}
795:        if len(colors) == 1 or len(parities) == 2:
796:            break
797:    # Build the full checker, then punch `holes` into src (and clear in dst).
798:    rr, cc = np.indices((n, n))
799:    full = np.where(((rr + cc) & 1) == 0, even_color, odd_color).astype(int)
