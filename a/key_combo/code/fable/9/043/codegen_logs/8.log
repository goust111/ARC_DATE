435:def find_square_frames(grid: np.ndarray) -> list[tuple[int, int, int, int, int, int]]:
436:    g = np.asarray(grid, dtype=int)
437:    h, w = g.shape
438:    cands = []
439:    for size in range(4, min(h, w) + 1):
440:        for r0 in range(0, h - size + 1):
441:            r1 = r0 + size - 1
442:            for c0 in range(0, w - size + 1):
443:                c1 = c0 + size - 1
444:                col = int(g[r0, c0])
445:                if int(g[r0, c1]) != col or int(g[r1, c0]) != col or int(g[r1, c1]) != col:
446:                    continue
447:                if not (
448:                    np.all(g[r0, c0 : c1 + 1] == col)
449:                    and np.all(g[r1, c0 : c1 + 1] == col)
450:                    and np.all(g[r0 : r1 + 1, c0] == col)
451:                    and np.all(g[r0 : r1 + 1, c1] == col)
452:                ):
453:                    continue
454:                cands.append((size, col, r0, c0, r1, c1))
455:    cands.sort(key=lambda t: (-t[0], t[2], t[3]))
456:    picked = []
457:    for cand in cands:
458:        _, _, r0, c0, r1, c1 = cand
459:        overlaps = False
460:        for _, _, pr0, pc0, pr1, pc1 in picked:
461:            if not (r1 < pr0 or pr1 < r0 or c1 < pc0 or pc1 < c0):
462:                overlaps = True
463:                break
464:        if not overlaps:
465:            picked.append(cand)
466:    return picked
