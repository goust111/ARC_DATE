402:SPRITE_COLORS = [1, 2, 3, 4, 5, 6, 8]       # colors usable inside sprite interiors
403:ALL_COLORS = list(range(10))
404:BG_PERIOD_CHOICES = (4, 5)                  # diagonal-stripe period for background
405:BG_PERTURB_FRACTION = (0.30, 0.50)          # min/max fraction of bg cells perturbed to noise
406:BG_EXTRA_NOISE = (0,)                       # extra noise digits beyond bg palette
