1065:def _assign_slots(positions: list[tuple[int, int]], rng: random.Random) -> tuple[list[int], int]:
1066:    """Pick (train_slots [2], test_slot) out of the 4 quadrant positions.
1067:
1068:    The remaining slot is implicitly blank (its sprite stays all-zero)."""
1069:    order = sorted(range(4), key=lambda i: positions[i])
