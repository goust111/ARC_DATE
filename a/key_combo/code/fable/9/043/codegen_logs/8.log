967:    bg_palette: list[int],
968:    rng: random.Random,
969:) -> np.ndarray:
970:    """Paint a noisy diagonal-stripe background, reserving frame regions as-is."""
971:    period = len(bg_palette)
972:    direction = rng.choice([1, -1])
973:    rr, cc = np.indices((H, W))
974:    idx = (rr + direction * cc) % period
975:    grid = np.asarray(bg_palette, dtype=int)[idx]
