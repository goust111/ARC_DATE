469:def stable_colors(src: np.ndarray, dst: np.ndarray) -> set[int]:
470:    st = set()
471:    for c in set(int(x) for x in np.unique(src)):
472:        if c == 0:
473:            continue
474:        if np.array_equal(src == c, dst == c):
475:            st.add(c)
476:    return st
477:
478:
479:def pick_var_color(x: np.ndarray, st: set[int]) -> int | None:
480:    vals = [int(v) for v in np.unique(x) if int(v) != 0 and int(v) not in st]
481:    if not vals:
482:        return None
483:    best = None
484:    for v in vals:
485:        cnt = int(np.sum(x == v))
486:        if best is None or cnt > best[0]:
487:            best = (cnt, v)
488:    return best[1]
489:
490:
491:def symmetries(arr: np.ndarray) -> list[np.ndarray]:
492:    """All 8 dihedral symmetries of arr (idx 0 = identity, 1 = fliplr, ...)."""
493:    outs = []
494:    for k in range(4):
495:        r = np.rot90(arr, k)
496:        outs.append(r)
497:        outs.append(np.fliplr(r))
498:    return outs
499:
500:
501:def _bincount_colors(values: np.ndarray) -> dict[int, int]:
502:    """Return {color: count} for a 1-D int array, skipping 0."""
503:    out: dict[int, int] = {}
504:    for v in values.tolist():
505:        if v == 0:
506:            continue
507:        out[v] = out.get(v, 0) + 1
508:    return out
509:
510:
511:def sym_fill_base(arr: np.ndarray) -> np.ndarray | None:
512:    y = np.zeros_like(arr)
513:    for t in (lambda z: z, np.fliplr, np.flipud, lambda z: np.flipud(np.fliplr(z))):
514:        zz = t(arr)
515:        rr, cc = np.where(zz != 0)
516:        for r, c in zip(rr.tolist(), cc.tolist()):
517:            val = int(zz[r, c])
518:            if y[r, c] != 0 and int(y[r, c]) != val:
519:                return None
520:            y[r, c] = val
521:    return y
