423:FILL_RECT_AREA_MIN, FILL_RECT_AREA_MAX = 5, 25   # inclusive area bounds (h*w)
424:ENDPOINTS_LINE_LEN_MIN = 3                   # each row line's min length
425:COMP_CHECKER_M_MAX = 10                      # max holes carved from the checker
426:INVERT0_STABLE_MAX = 3                       # upper bound on stable cells in invert0 src
427:INVERT0_VAR_MAX = 12                         # upper bound on variable cells
428:SYM_BUILD_RETRIES = 30                       # attempts to find a non-identity sym pair
429:SPARSE_COUNT_MAX = 10                        # max cells for random_sparse_pattern
