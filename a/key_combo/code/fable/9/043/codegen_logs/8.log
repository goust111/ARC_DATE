260:            if odd_counts:
261:                c_odd = max(odd_counts.items(), key=lambda t: t[1])[0]
262:            else:
263:                c_odd = c_even
264:            h, w = x.shape
265:            y = np.zeros_like(x)
266:            for r in range(h):
267:                for c in range(w):
268:                    if x[r, c] != 0:
269:                        y[r, c] = 0
270:                    else:
271:                        y[r, c] = c_even if ((r + c) & 1) == 0 else c_odd
272:            return y
273:
274:        if kind == "sym_fill":
275:            h, w = x.shape
276:            nz = np.argwhere(x != 0)
277:            if nz.size == 0:
278:                return x.copy()
279:            best = None
280:            counts = {}
281:            for r, c in nz:
282:                col = int(x[int(r), int(c)])
283:                d = min(int(r), int(c), h - 1 - int(r), w - 1 - int(c))
284:                counts[col] = counts.get(col, 0) + 1
285:                if best is None or d > best[0] or (d == best[0] and counts[col] > best[1]):
286:                    best = (d, counts[col], col)
287:            fill_col = best[2]
288:
289:            def sym_fill_base(a):
290:                y = np.zeros_like(a)
291:                for t in (lambda z: z, np.fliplr, np.flipud, lambda z: np.flipud(np.fliplr(z))):
292:                    zz = t(a)
293:                    rr, cc = np.where(zz != 0)
294:                    for r, c in zip(rr.tolist(), cc.tolist()):
295:                        val = int(zz[r, c])
296:                        if y[r, c] != 0 and int(y[r, c]) != val:
297:                            return a.copy()
298:                        y[r, c] = val
299:                return y
300:
301:            y = sym_fill_base(x)
302:            keep0 = params.get("keep0", None)
303:            if keep0 is None or keep0.shape != y.shape:
304:                keep0 = np.zeros_like(y, dtype=bool)
305:            for r in range(h):
306:                for c in range(w):
307:                    if y[r, c] == 0 and not bool(keep0[r, c]):
308:                        y[r, c] = fill_col
309:            return y
310:
311:        if v is None:
312:            return x.copy()
313:
314:        if kind == "invert0":
315:            y = x.copy()
316:            m0 = x == 0
317:            mv = x == v
318:            y[m0] = v
319:            y[mv] = 0
320:            return y
321:
322:        if kind == "endpoints":
323:            coords = np.argwhere(x == v)
324:            S = set((int(r), int(c)) for r, c in coords)
325:            keep = np.zeros_like(x, dtype=bool)
326:            for r, c in S:
327:                deg = 0
328:                for dr in (-1, 0, 1):
329:                    for dc in (-1, 0, 1):
330:                        if dr == 0 and dc == 0:
331:                            continue
332:                        if (r + dr, c + dc) in S:
333:                            deg += 1
334:                if deg <= 1:
335:                    keep[r, c] = True
336:            y = x.copy()
337:            y[x == v] = 0
338:            y[keep] = v
339:            return y
340:
341:        if kind == "fill":
342:            y = x.copy()
343:            h, w = y.shape
344:            stable_mask = np.zeros_like(y, dtype=bool)
345:            for c in st:
346:                stable_mask |= y == c
347:            for r in range(h):
348:                nz = np.where(y[r, :] != 0)[0]
349:                if nz.size >= 2:
350:                    cmin = int(nz.min())
351:                    cmax = int(nz.max())
352:                    for cc in range(cmin, cmax + 1):
353:                        if y[r, cc] == 0 and not stable_mask[r, cc]:
354:                            y[r, cc] = v
355:            for c in range(w):
356:                nz = np.where(y[:, c] != 0)[0]
357:                if nz.size >= 2:
358:                    rmin = int(nz.min())
359:                    rmax = int(nz.max())
360:                    for rr in range(rmin, rmax + 1):
361:                        if y[rr, c] == 0 and not stable_mask[rr, c]:
362:                            y[rr, c] = v
363:            return y
364:
365:        return x.copy()
366:
367:    best = None
368:    for src, dst in ((src_a, src_b), (src_b, src_a)):
369:        tpl = infer_template(src, dst)
370:        if tpl is None:
371:            continue
372:        kind, params = tpl
373:        st = set(params.get("stable", set()))
374:        v_src = pick_var_color(src, st)
375:        v_dst = pick_var_color(dst, st)
376:        score = 1
377:        if kind == "fill" and v_src is not None and v_dst is not None:
378:            if int(np.sum(dst == v_dst)) >= int(np.sum(src == v_src)):
379:                score += 2
380:        if kind == "endpoints" and v_src is not None and v_dst is not None:
381:            if int(np.sum(dst == v_dst)) <= int(np.sum(src == v_src)):
382:                score += 2
383:        src_n = int(np.sum((src != 0) & ~np.isin(src, list(st))))
384:        test_n = int(np.sum((test_inner != 0) & ~np.isin(test_inner, list(st))))
385:        score2 = score * 100 - abs(src_n - test_n)
386:        if best is None or score2 > best[0]:
387:            best = (score2, kind, params)
388:
389:    if best is None:
390:        return test_inner.copy()
391:
392:    _, kind, params = best
393:    return apply_template(kind, params, test_inner)
