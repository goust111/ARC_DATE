736:
737:def choose_palette(rng: random.Random, count: int, forbidden: set[int]) -> list[int]:
738:    pool = [c for c in SPRITE_COLORS if c not in forbidden]
739:    if len(pool) < count:
740:        raise ValueError("not enough sprite colors")
741:    return rng.sample(pool, count)
