619:def apply_template(kind: str, params: dict, x: np.ndarray) -> np.ndarray:
620:    if kind == "sym":
621:        return symmetries(x)[params["idx"]].copy()
622:
623:    st = set(params.get("stable", set()))
624:    v = pick_var_color(x, st)
625:
626:    if kind == "comp_checker":
627:        h, w = x.shape
628:        rr, cc = np.indices((h, w))
629:        parity = (rr + cc) & 1
630:        even_mask = (x != 0) & (parity == 0)
631:        odd_mask = (x != 0) & (parity == 1)
632:        even_counts = _bincount_colors(x[even_mask])
633:        odd_counts = _bincount_colors(x[odd_mask])
634:        if even_counts:
635:            c_even = max(even_counts.items(), key=lambda t: t[1])[0]
636:        elif odd_counts:
637:            c_even = max(odd_counts.items(), key=lambda t: t[1])[0]
638:        else:
639:            return x.copy()
640:        c_odd = max(odd_counts.items(), key=lambda t: t[1])[0] if odd_counts else c_even
641:        y = np.where(parity == 0, c_even, c_odd)
642:        y[x != 0] = 0
643:        return y.astype(x.dtype)
644:
645:    if kind == "sym_fill":
646:        h, w = x.shape
647:        nz = np.argwhere(x != 0)
648:        if nz.size == 0:
649:            return x.copy()
650:        # Pick fill color: the non-zero color appearing closest to the border,
651:        # breaking ties by frequency (matches original tie-break semantics).
652:        best = None
653:        counts = {}
654:        for r, c in nz:
655:            col = int(x[int(r), int(c)])
656:            d = min(int(r), int(c), h - 1 - int(r), w - 1 - int(c))
657:            counts[col] = counts.get(col, 0) + 1
658:            if best is None or d > best[0] or (d == best[0] and counts[col] > best[1]):
659:                best = (d, counts[col], col)
660:        fill_col = best[2]
661:        y = sym_fill_base(x)
662:        if y is None:
663:            return x.copy()
664:        keep0 = params.get("keep0", None)
665:        if keep0 is None or keep0.shape != y.shape:
666:            keep0 = np.zeros_like(y, dtype=bool)
667:        y[(y == 0) & ~keep0] = fill_col
668:        return y
669:
670:    if v is None:
671:        return x.copy()
672:
673:    if kind == "invert0":
674:        y = x.copy()
675:        m0 = x == 0
676:        mv = x == v
677:        y[m0] = v
678:        y[mv] = 0
679:        return y
680:
681:    if kind == "endpoints":
682:        coords = np.argwhere(x == v)
683:        s = set((int(r), int(c)) for r, c in coords)
684:        keep = np.zeros_like(x, dtype=bool)
685:        for r, c in s:
686:            deg = 0
687:            for dr in (-1, 0, 1):
688:                for dc in (-1, 0, 1):
689:                    if dr == 0 and dc == 0:
690:                        continue
691:                    if (r + dr, c + dc) in s:
692:                        deg += 1
693:            if deg <= 1:
694:                keep[r, c] = True
695:        y = x.copy()
696:        y[x == v] = 0
697:        y[keep] = v
698:        return y
699:
700:    if kind == "fill":
701:        y = x.copy()
702:        h, w = y.shape
703:        stable_mask = np.zeros_like(y, dtype=bool)
704:        for c in st:
705:            stable_mask |= y == c
706:        for r in range(h):
707:            nz = np.where(y[r, :] != 0)[0]
708:            if nz.size >= 2:
709:                cmin = int(nz.min())
710:                cmax = int(nz.max())
711:                for cc in range(cmin, cmax + 1):
712:                    if y[r, cc] == 0 and not stable_mask[r, cc]:
713:                        y[r, cc] = v
714:        for c in range(w):
715:            nz = np.where(y[:, c] != 0)[0]
716:            if nz.size >= 2:
717:                rmin = int(nz.min())
718:                rmax = int(nz.max())
719:                for rr in range(rmin, rmax + 1):
720:                    if y[rr, c] == 0 and not stable_mask[rr, c]:
721:                        y[rr, c] = v
722:        return y
723:
724:    return x.copy()
