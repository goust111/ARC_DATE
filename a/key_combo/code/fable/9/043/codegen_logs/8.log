1001:def validate_scene(grid: np.ndarray, expected_output: np.ndarray) -> bool:
1002:    """Oracle check: solver must see exactly 4 same-size frames, one blank interior,
1003:    one matching non-blank pair, and produce the expected output on the test sprite."""
1004:    frames = find_square_frames(grid)
1005:    if len(frames) != 4:
1006:        return False
1007:    sizes = {size for size, _, *_ in frames}
1008:    if len(sizes) != 1 or next(iter(sizes)) not in set(FRAME_SIZE_CHOICES):
1009:        return False
1010:    inners = [grid[r0 + 1 : r1, c0 + 1 : c1] for _, _, r0, c0, r1, c1 in frames]
1011:    if sum(int(np.all(inner == 0)) for inner in inners) != 1:
1012:        return False
1013:    nonblank_sigs = [tuple(colors_present(inner, exclude={0})) for inner in inners]
1014:    nonblank_sigs = [s for s in nonblank_sigs if s]
1015:    dup_count = sum(
1016:        1 for i in range(len(nonblank_sigs)) for j in range(i + 1, len(nonblank_sigs))
1017:        if nonblank_sigs[i] == nonblank_sigs[j]
1018:    )
1019:    if dup_count != 1:
1020:        return False
1021:    return np.array_equal(main(grid), expected_output)
