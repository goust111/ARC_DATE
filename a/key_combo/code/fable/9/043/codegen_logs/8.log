5:def main(grid: np.ndarray) -> np.ndarray:
6:    """
7:    Build a five-block horizontal strip by alternating the input tile with its left-right reflection.
8:
9:    Input structure
10:    - A nonempty 2D color grid; all cells are part of the source tile.
11:    - The examples use a 4x4 tile and produce a same-height strip five tiles wide.
12:
13:    Rule
14:    - Concatenate five whole-tile blocks across columns.
15:    - Use the original tile in blocks 1, 3, and 5.
16:    - Use the left-right mirror of the tile in blocks 2 and 4.
17:
18:    Key insight
19:    The output is mirrored horizontal wallpaper, not pixel scaling: whole-grid copies alternate orientation.
20:    """
21:    g = np.asarray(grid, dtype=int)
22:    assert g.ndim == 2 and min(g.shape) > 0, "expected a nonempty 2D tile"
23:
24:    mirrored = np.fliplr(g)
25:    return np.concatenate((g, mirrored, g, mirrored, g), axis=1)
