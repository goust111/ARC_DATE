827:def inverse_symmetry(arr: np.ndarray, idx: int) -> np.ndarray:
828:    if idx == 0:
829:        return arr.copy()
830:    if idx == 1:
831:        return np.fliplr(arr)
832:    if idx == 2:
833:        return np.rot90(arr, -1)
834:    if idx == 3:
835:        return np.rot90(np.fliplr(arr), -1)
836:    if idx == 4:
837:        return np.rot90(arr, 2)
838:    if idx == 5:
839:        return np.flipud(arr)
840:    if idx == 6:
841:        return np.rot90(arr, 1)
842:    if idx == 7:
843:        return np.rot90(np.fliplr(arr), 1)
844:    raise ValueError(idx)
