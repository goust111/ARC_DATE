977:    reserved = np.zeros((H, W), dtype=bool)
978:    for r0, c0, r1, c1 in frame_boxes:
979:        reserved[r0 : r1 + 1, c0 : c1 + 1] = True
980:    bg_cells = [(r, c) for r, c in zip(*np.where(~reserved))]
981:    lo, hi = BG_PERTURB_FRACTION
982:    perturb_n = int(round(len(bg_cells) * rng.uniform(lo, hi)))
983:    noise_choices = list(bg_palette) + [c for c in BG_EXTRA_NOISE if c not in bg_palette]
984:    for r, c in rng.sample(bg_cells, perturb_n):
985:        grid[r, c] = rng.choice(noise_choices)
