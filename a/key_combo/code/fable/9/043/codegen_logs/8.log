411:QUAD_BOTTOM_MARGIN = 8                       # bottom/right anchor range is [H-s-margin, H-s-1]
412:
413:# Rule set
414:RULES = ["endpoints", "fill", "sym_fill", "comp_checker", "invert0", "sym"]
415:
416:# Sprite pixel-count bounds (non-zero cells in every sprite interior)
417:SPRITE_NZ_MIN, SPRITE_NZ_MAX = 3, 32
