727:def orbit_cells(n: int, r: int, c: int) -> list[tuple[int, int]]:
728:    cells = {
729:        (r, c),
730:        (r, n - 1 - c),
731:        (n - 1 - r, c),
732:        (n - 1 - r, n - 1 - c),
733:    }
734:    return sorted(cells)
