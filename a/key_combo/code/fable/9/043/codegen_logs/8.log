523:
524:def infer_template(src: np.ndarray, dst: np.ndarray):
525:    st = stable_colors(src, dst)
526:    v = pick_var_color(dst, st) or pick_var_color(src, st)
527:
528:    if np.array_equal(dst == 0, src != 0):
529:        nz = np.argwhere(dst != 0)
530:        if nz.size > 0:
531:            even_cols = set()
532:            odd_cols = set()
533:            for r, c in nz:
534:                col = int(dst[int(r), int(c)])
535:                if ((int(r) + int(c)) & 1) == 0:
536:                    even_cols.add(col)
537:                else:
538:                    odd_cols.add(col)
539:            if len(even_cols) == 1 and len(odd_cols) == 1:
540:                return ("comp_checker", {"stable": st})
541:
542:    sym_src = sym_fill_base(src)
543:    if sym_src is not None:
544:        if np.all(dst[sym_src != 0] == sym_src[sym_src != 0]):
545:            fill_cols = sorted(set(int(x) for x in dst[sym_src == 0].ravel() if int(x) != 0))
546:            if len(fill_cols) <= 1:
547:                fill_col = fill_cols[0] if fill_cols else None
548:                ok = True
549:                if fill_col is not None:
550:                    bad = (sym_src == 0) & (dst != 0) & (dst != fill_col)
551:                    if np.any(bad):
552:                        ok = False
553:                if ok:
554:                    keep0 = (sym_src == 0) & (dst == 0)
555:                    return ("sym_fill", {"stable": st, "keep0": keep0})
556:
557:    if v is not None:
558:        pred = src.copy()
559:        m0 = src == 0
560:        mv = src == v
561:        pred[m0] = v
562:        pred[mv] = 0
563:        for c in st:
564:            pred[dst == c] = c
565:        if np.array_equal(pred, dst):
566:            return ("invert0", {"stable": st})
567:
568:    for idx, var in enumerate(symmetries(src)):
569:        if np.array_equal(var, dst):
570:            return ("sym", {"idx": idx})
571:
572:    if v is not None:
573:        coords = np.argwhere(src == v)
574:        s = set((int(r), int(c)) for r, c in coords)
575:        keep = np.zeros_like(src, dtype=bool)
576:        for r, c in s:
577:            deg = 0
578:            for dr in (-1, 0, 1):
579:                for dc in (-1, 0, 1):
580:                    if dr == 0 and dc == 0:
581:                        continue
582:                    if (r + dr, c + dc) in s:
583:                        deg += 1
584:            if deg <= 1:
585:                keep[r, c] = True
586:        pred = src.copy()
587:        pred[src == v] = 0
588:        pred[keep] = v
589:        if np.array_equal(pred, dst):
590:            return ("endpoints", {"stable": st})
591:
592:        pred = src.copy()
593:        h, w = pred.shape
594:        stable_mask = np.zeros_like(pred, dtype=bool)
595:        for c in st:
596:            stable_mask |= pred == c
597:        for r in range(h):
598:            nz = np.where(pred[r, :] != 0)[0]
599:            if nz.size >= 2:
600:                cmin = int(nz.min())
601:                cmax = int(nz.max())
602:                for cc in range(cmin, cmax + 1):
603:                    if pred[r, cc] == 0 and not stable_mask[r, cc]:
604:                        pred[r, cc] = v
605:        for c in range(w):
606:            nz = np.where(pred[:, c] != 0)[0]
607:            if nz.size >= 2:
608:                rmin = int(nz.min())
609:                rmax = int(nz.max())
610:                for rr in range(rmin, rmax + 1):
611:                    if pred[rr, c] == 0 and not stable_mask[rr, c]:
612:                        pred[rr, c] = v
613:        if np.array_equal(pred, dst):
614:            return ("fill", {"stable": st})
615:
616:    return None
