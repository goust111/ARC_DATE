+    grid = np.concatenate([left, np.full((panel_h, 1), separator, dtype=int), right], axis=1)
+
+    if not _validate_case(grid, expected, sprites, bg, separator):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
