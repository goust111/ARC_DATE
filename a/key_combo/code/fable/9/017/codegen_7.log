        assert area >= 1, "components must be nonempty"
        if area <= 2:
            coords = comp["coords"]
            out[coords[:, 0], coords[:, 1]] = Color.GREEN
            recolored_area += area

    assert recolored_area > 0, "expected at least one small foreground object"
    return out

