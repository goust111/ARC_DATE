+
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+BASE_KEY_SHAPE = (
+    (0, 0),
+    (0, 1),
+    (0, 2),
+    (1, 2),
+    (2, 1),
+    (2, 2),
