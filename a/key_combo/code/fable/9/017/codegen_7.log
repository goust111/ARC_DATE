+        assert best_cell is not None and best_options is not None
+        for idx in best_options:
+            chosen.append(idx)
+            used_cells = candidates[idx]["cells"]
+            remaining.difference_update(used_cells)
+            rec()
+            remaining.update(used_cells)
+            chosen.pop()
