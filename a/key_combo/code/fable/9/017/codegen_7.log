+def _all_rotations(coords) -> list[tuple[tuple[int, int], ...]]:
+    out = []
+    cur = tuple(coords)
+    for _ in range(4):
+        norm = _normalize(cur)
+        if norm not in out:
+            out.append(norm)
+        cur = _rotate_once(cur)
+    return out
