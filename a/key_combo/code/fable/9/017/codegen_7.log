+        best_cell = None
+        best_options = None
+        for cell in remaining:
+            options = [idx for idx in cell_to_ids[cell] if all(c in remaining for c in candidates[idx]["cells"])]
+            if not options:
+                return
+            if best_options is None or len(options) < len(best_options):
