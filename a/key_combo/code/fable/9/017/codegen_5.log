QUADRANT_COUNT = 4
MARKER_COUNT_RANGE = (7, 12)
MARKER_DENSITY_RANGE = (0.25, 0.45)
# Marker color constraints.
MARKER_COLOR_RANGE = (5, 7)
MAX_MARKERS_PER_COLOR = 3
