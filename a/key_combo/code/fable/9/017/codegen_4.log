+def _sample_counts(direction: int, mode: str, *, move_right: bool) -> tuple[int, int, int] | None:
+    for _ in range(120):
+        unswept_left = random.randint(1, 4)
+        swept = random.randint(1, 3)
+        far_side = random.randint(1, 4)
+        total = unswept_left + swept + far_side
