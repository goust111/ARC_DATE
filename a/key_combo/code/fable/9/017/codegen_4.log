spec:
  grid: 16-19 rows x 16-18 cols, background BLACK
  objects:
    count: 4-6 per grid, all same single foreground color (GRAY in eval [observed])
    shape: filled rectangle with 1-4 interior 4-connected bg holes
    bbox: 3-9 rows x 3-7 cols (inclusive)
    border: all 4 edges of bbox fully filled with fg (no bg on perimeter)
    holes:
      count: 1-4 per object (determines output color)
      shape: small filled rectangle, one of 1x1, 1x2, 2x1, 2x2
      placement: strictly interior (>=1 cell from bbox edge)
