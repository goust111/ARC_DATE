+    widths = [obj["patch"].shape[1] for obj in objects]
+    approx = sum((h + 2) * (w + 2) for h, w in zip(heights, widths))
+    min_side = max(max(heights) + 2, max(widths) + 2, int(np.ceil(np.sqrt(approx * 1.7))))
+    if min_side > 30:
+        return None
