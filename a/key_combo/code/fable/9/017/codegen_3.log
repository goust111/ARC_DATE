+import numpy as np
+
+
+MAX_GEN_ATTEMPTS = 400
+PALETTE = tuple(range(10))
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _bbox_from_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _crop_mask(mask: np.ndarray) -> np.ndarray:
+    coords = np.argwhere(mask)
+    r0, c0, r1, c1 = _bbox_from_coords(coords)
+    return mask[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _is_connected(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if len(coords) == 0:
+        return False
+    seen = {tuple(map(int, coords[0]))}
+    stack = [tuple(map(int, coords[0]))]
+    h, w = mask.shape
+    while stack:
+        r, c = stack.pop()
+        for rr, cc in _neighbors4(r, c):
+            if 0 <= rr < h and 0 <= cc < w and mask[rr, cc] and (rr, cc) not in seen:
+                seen.add((rr, cc))
+                stack.append((rr, cc))
+    return len(seen) == len(coords)
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    out = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            coords = []
+            stack = [(r, c)]
+            seen[r, c] = True
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            out.append(np.array(coords, dtype=int))
+    return out
+
+
+def _find_monochrome_components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros_like(grid, dtype=bool)
+    comps = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == bg or seen[r, c]:
+                continue
+            coords = []
+            stack = [(r, c)]
+            seen[r, c] = True
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            coords_arr = np.array(coords, dtype=int)
+            bbox = _bbox_from_coords(coords_arr)
+            r0, c0, r1, c1 = bbox
+            patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+            mask = patch == color
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords_arr,
+                    "bbox": bbox,
+                    "mask": mask,
+                    "area": int(mask.sum()),
+                    "bbox_area": int(mask.size),
+                }
+            )
+    return comps
