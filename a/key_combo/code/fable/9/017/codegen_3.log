+            bbox = _bbox_from_coords(coords_arr)
+            r0, c0, r1, c1 = bbox
+            patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+            mask = patch == color
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords_arr,
+                    "bbox": bbox,
+                    "mask": mask,
+                    "area": int(mask.sum()),
+                    "bbox_area": int(mask.size),
