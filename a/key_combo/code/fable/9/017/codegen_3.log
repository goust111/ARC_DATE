+    filled = [tuple(x) for x in np.argwhere(shape)]
+    empty = [tuple(x) for x in np.argwhere(~shape)]
+    order_f = np.random.permutation(len(filled)) if filled else []
+    order_e = np.random.permutation(len(empty)) if empty else []
+    for fi in order_f:
