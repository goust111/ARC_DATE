+def _axis_consistency_details(grid: np.ndarray, axis: Axis) -> tuple[bool, bool, bool]:
+    """Return (passes, has_visible_mismatch, has_out_of_bounds_contradiction)."""
+    h, w = grid.shape
+    mismatch = False
+    out_of_bounds = False
