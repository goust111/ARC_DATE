  grid: 9-14 rows x 10-13 cols
  colors: bg=7, target=4, bar=5, control=9 [observed]
  marker:
    bar: 3 contiguous pixels of bar_color, horizontal or vertical, not touching grid edge
    control: 1 pixel of control_color, 4-adjacent to bar center, perpendicular to bar axis
    ray_direction: from bar center away from control (along bar's perpendicular axis)
  target_objects:
    color: target_color, 4-connected components
    count: 10-18 total
    sizes: mostly 1-pixel singletons, a few 2-7 pixel clusters; median ~1
    density: 17-21% of grid cells are target_color
