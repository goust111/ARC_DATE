    inp = out.copy()
    for rr, cc in destinations:
        inp[rr, cc] = BACKGROUND_COLOR
    for rr, cc in source_positions:
        if int(inp[rr, cc]) != BACKGROUND_COLOR:
            return None
        inp[rr, cc] = marker_color
    return inp


