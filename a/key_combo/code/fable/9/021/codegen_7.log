+        target = random.randint(1, min(3, max(1, len(usable))))
+        random.shuffle(usable)
+        chosen = []
+        blocked = {axis[1]}
+        for r in usable:
+            mr = _mirror(axis, r, 0)[0]
+            if r in blocked:
