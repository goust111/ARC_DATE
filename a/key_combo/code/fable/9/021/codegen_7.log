+def _candidate_axes(grid: np.ndarray) -> list[Axis]:
+    axes: list[Axis] = []
+    for r in range(grid.shape[0]):
+        if np.all(grid[r, :] == GRAY):
+            axes.append(("h", int(r)))
+    for c in range(grid.shape[1]):
+        if np.all(grid[:, c] == GRAY):
+            axes.append(("v", int(c)))
+    return axes
+
