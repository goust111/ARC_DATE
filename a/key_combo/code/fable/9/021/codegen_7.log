  grid: 16-18 rows x 13-17 cols; bg=0
  selector_block:
    shape: 7x7 filled with color 1 (45 pixels of color 1 + 4 marker pixels)
    placement: flush against one corner/edge of the grid [observed]
    markers: exactly 4 pixels at positions (1,1), (1,5), (5,1), (5,5) within the block
    marker_colors: 4 distinct colors, each different from bg(0) and selector(1)
  sprites:
    count: 4 marker-matched + 0-2 distractors; total 4-6
    each: monochromatic, 8-connected, 3x3 bounding box, area 4-7 pixels
    color: each uses a unique non-bg non-selector color; one sprite per color
    placement: scattered outside the selector bbox, no bbox overlap between any pair
    gap: >=1 cell between any two sprite bboxes
  output:
    shape: always 7x7
    structure: four 3x3 quadrants at (0,0)-(2,2), (0,4)-(2,6), (4,0)-(4,2), (4,4)-(4,6) separated by bg row 3 and bg col 3
    rule: each marker at (r,c) in selector maps to quadrant (r->row-band, c->col-band); the matched external sprite is copied into that quadrant
    distractors: ignored in output

generation_strategy:
  approach: output-first
  steps:
    1. Pick 4 distinct colors from {2-9} minus {1} for marker sprites; optionally pick 0-2 more for distractors
    2. Generate 4 random 8-connected monochromatic 3x3-bbox sprites (area 4-7) for marker colors; generate distractor sprites similarly
    3. Build 7x7 output by placing the 4 marker sprites into the four quadrants separated by a bg middle row/col
