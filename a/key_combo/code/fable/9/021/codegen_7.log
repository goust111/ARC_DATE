+    return chosen if chosen else None
+
+
+def _render_input(base: np.ndarray, true_axis: Axis, fake_axes: list[Axis]) -> np.ndarray:
+    inp = np.array(base, copy=True)
+    for axis in [true_axis] + fake_axes:
