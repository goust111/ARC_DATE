        center = (int(r0) + 1, int(c0) + 1)
        cr, cc = center
        expected = {
            center,
            (cr - 1, cc),
            (cr + 1, cc),
            (cr, cc - 1),
            (cr, cc + 1),
        }
        assert set(map(tuple, component["coords"].tolist())) == expected, "object must have plus shape"
