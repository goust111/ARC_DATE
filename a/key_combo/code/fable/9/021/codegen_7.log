+def _on_axis(axis: Axis, r: int, c: int) -> bool:
+    return (axis[0] == "v" and c == axis[1]) or (axis[0] == "h" and r == axis[1])
+
+
+def _mirror(axis: Axis, r: int, c: int) -> tuple[int, int]:
+    if axis[0] == "v":
+        return int(r), int(2 * axis[1] - c)
+    return int(2 * axis[1] - r), int(c)
+
