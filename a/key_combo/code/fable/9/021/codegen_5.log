            if remaining != 0 or sum(v > 0 for v in current) < 2:
                return
            top = max(current)
            if current.count(top) == 1:
                allocations.append(tuple(current))
            return

        for count in range(min(caps[i], remaining) + 1):
            current.append(count)
            rec(i + 1, remaining - count, current)
