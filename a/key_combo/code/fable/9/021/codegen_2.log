+
+def _paint_sprite(grid: np.ndarray, sprite: np.ndarray, top: int, left: int, color: int) -> None:
+    h, w = sprite.shape
+    patch = grid[top : top + h, left : left + w]
+    patch[sprite.astype(bool)] = color
