+    if rng.random() < 0.5:
+        sprite[0, 0] = 1
+    if rng.random() < 0.5:
+        sprite[-1, -1] = 1
+    if rng.random() < 0.5:
+        sprite = np.flip(sprite, axis=1)
+    return sprite.astype(int)
