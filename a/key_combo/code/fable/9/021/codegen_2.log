+BG = 0
+TEMPLATE_COLOR = 5
+OBJECT_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+HOLE_COUNTS = (1, 2, 3, 4, 5)
+GENERATION_RETRIES = 600
