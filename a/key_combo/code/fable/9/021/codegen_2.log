+    actual_objects = _components((grid != BG) & (grid != TEMPLATE_COLOR))
+    if len(actual_templates) != len(template_order) or len(actual_objects) != len(object_order):
+        return None
+
+    template_infos = []
+    for coords in actual_templates:
