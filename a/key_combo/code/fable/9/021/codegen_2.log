    return grid


def _expand(pattern, colors, stencils):
    side = pattern.shape[0]
    size = stencils[0].shape[0]
    out = np.zeros((side * size, side * size), dtype=int)
    stencil_by_color = dict(zip(colors, stencils))
    for r in range(side):
