+    if rng.random() < 0.5:
+        sprite = np.flip(sprite, axis=0)
+    return sprite.astype(int)
+
+
+def _make_object_sprite(hole_count: int, rng: random.Random) -> np.ndarray:
+    rows = 1 if hole_count <= 2 or (hole_count == 3 and rng.random() < 0.45) else 2
