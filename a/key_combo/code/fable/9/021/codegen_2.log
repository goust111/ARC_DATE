    out = main(grid)
    if np.any(out == 3) and np.any(out == 4) and not np.any(out == _GEN_BG):
        return grid
    return None


def generate_input() -> np.ndarray:
    for _ in range(_GEN_MAX_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
