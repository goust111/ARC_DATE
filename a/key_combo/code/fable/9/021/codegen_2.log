+def _hole_count_coords(coords: np.ndarray) -> int:
+    r0, c0, r1, c1 = _bbox(coords)
+    sub = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    sub[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    return _hole_count_mask(sub)
