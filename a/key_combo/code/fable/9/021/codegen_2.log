    band: tuple[int, int],
    min_width: int = MIN_RECT_WIDTH,
) -> None:
    c0, c1 = band
    width = c1 - c0 + 1
    anchor = random.randint(c0 + 1, c1 - 1) if width > 2 else c0
    r = row0
    for h in _gen_height_chunks(row1 - row0 + 1):
