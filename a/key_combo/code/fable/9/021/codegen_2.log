+def _make_template_sprite(hole_count: int, rng: random.Random) -> np.ndarray:
+    cols = 1 if hole_count <= 2 or (hole_count == 3 and rng.random() < 0.4) else 2
+    rows = (hole_count + cols - 1) // cols
+    base_h = 2 * rows + 1
+    base_w = 2 * cols + 1
