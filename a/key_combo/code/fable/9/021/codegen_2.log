+
+    max_obj_h = max(sprite.shape[0] for sprite in object_sprites.values())
+    max_obj_w = max(sprite.shape[1] for sprite in object_sprites.values())
+    slot_h = max_obj_h + 1
+    slot_w = max_obj_w + 1
+
