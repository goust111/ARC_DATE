+OBSTACLE_COLOR = 5
+CANVAS_SIZE = 30
+GEN_RETRIES = 500
+BG_CHOICES = (0, 1, 3, 4, 6, 7, 8, 9)
+SPRITE_COLOR_POOL = (1, 3, 4, 6, 7, 8, 9)
