+    h, w = g.shape
+    visited = np.zeros((h, w), dtype=bool)
+    out: list[dict] = []
+    use_colors = None if colors is None else {int(c) for c in colors}
+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if visited[r, c]:
+                continue
+            if use_colors is not None and color not in use_colors:
+                continue
+            if use_colors is None and color == _get_bg(g):
+                continue
+            visited[r, c] = True
+            q = [(r, c)]
+            coords = [(r, c)]
+            while q:
+                rr, cc = q.pop()
+                nbrs = _neighbors4(rr, cc) if connectivity == 4 else [
+                    (rr + dr, cc + dc)
+                    for dr in (-1, 0, 1)
+                    for dc in (-1, 0, 1)
+                    if not (dr == 0 and dc == 0)
+                ]
+                for nr, nc in nbrs:
+                    if 0 <= nr < h and 0 <= nc < w and not visited[nr, nc] and int(g[nr, nc]) == color:
+                        visited[nr, nc] = True
+                        q.append((nr, nc))
+                        coords.append((nr, nc))
+            out.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": _bbox_from_coords(coords),
+                    "area": len(coords),
