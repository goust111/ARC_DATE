+    if not any(meta["slide"] >= 2 for meta in metas):
+        return False
+    if len(metas) >= 2:
+        if not any(meta["blocker"] == "boundary" for meta in metas):
+            return False
+        if not any(meta["blocker"] == "obstacle" for meta in metas):
+            return False
+        if not any(meta["orientation"] == "h" for meta in metas):
