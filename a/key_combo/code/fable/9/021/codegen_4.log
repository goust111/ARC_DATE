  type_1_row:
    structure: horizontal red line (≥2 px, all share one row) 4-connected to a monochromatic payload sprite on one side
    red_length: 2-6
    payload: 3-11 px of a single non-red non-bg color, entirely above or below the red row
    transform: mirror payload across the red row; paint mirrored px onto bg
  type_2_col:
    structure: vertical red line (≥2 px, all share one column) 4-connected to a monochromatic payload sprite on one side
    red_length: 2-6
    payload: 3-11 px of a single non-red non-bg color, entirely left or right of the red column
    transform: mirror payload across the red column; paint mirrored px onto bg
  type_3_isolated:
    structure: single red pixel with NO 4-connected non-bg neighbors; exactly 1 adjacent (8-conn) non-bg non-red color component
    transform: point-reflect that entire 8-connected color component around the red pixel; paint mirrored px onto bg
    adjacent_sprite: 1-8 px [observed]
  payload_colors: each payload/sprite uses exactly one non-red non-bg color; distinct colors per group [observed]
  spatial: all sprites + mirrored copies must fit within grid; no overlap between mirrored pixels and existing non-bg pixels
  non_participating_sprites: 0-8 free single-px or small sprites that share a payload color, located near enough to be caught by bbox-based eligibility in solver

