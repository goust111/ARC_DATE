+        op_desc = ("swap", int(swap_a), int(swap_b))
+    else:
+        sprite_a = _random_sprite_crop(rng, palette)
+        sprite_c = _random_sprite_crop(rng, palette)
+        if sprite_a is None or sprite_c is None:
