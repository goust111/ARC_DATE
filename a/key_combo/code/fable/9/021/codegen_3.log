+    grid[:, panel_w] = sep_color
+    grid[:, panel_w + 1 : 2 * panel_w + 1] = panel_b
+    grid[:, 2 * panel_w + 1] = sep_color
+    grid[:, 2 * panel_w + 2 :] = panel_c
