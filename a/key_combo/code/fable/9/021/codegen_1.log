+        "bg": bg,
+        "bar": bar_comp,
+        "control": control_comp,
+        "center": center,
+        "axis": axis,
+        "step": step,
+        "ray": ray,
+        "hit": [comp for _idx, comp in hit],
+        "miss": miss,
+        "targets": targets,
+    }
