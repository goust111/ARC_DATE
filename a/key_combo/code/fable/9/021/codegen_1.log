+def _bar_cells(center: tuple[int, int], step: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = center
+    if step[0] != 0:
+        return [(r, c - 1), (r, c), (r, c + 1)]
+    return [(r - 1, c), (r, c), (r + 1, c)]
