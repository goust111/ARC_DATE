+def _distance_to_ray(cells: set[tuple[int, int]], ray: list[tuple[int, int]]) -> int:
+    best = 10**9
+    for r, c in cells:
+        for rr, cc in ray:
+            best = min(best, abs(r - rr) + abs(c - cc))
