+        center = (ray_len, random.randint(1, w - 2))
+    elif step == (1, 0):
+        ray_len = random.randint(7, h - 2)
+        center = (h - 1 - ray_len, random.randint(1, w - 2))
+    elif step == (0, -1):
+        ray_len = random.randint(7, w - 2)
+        center = (random.randint(1, h - 2), ray_len)
