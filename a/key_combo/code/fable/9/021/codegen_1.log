+    out: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == bg or (r, c) in seen:
+                continue
+            stack = [(r, c)]
+            seen.add((r, c))
+            cells: list[tuple[int, int]] = []
+            while stack:
