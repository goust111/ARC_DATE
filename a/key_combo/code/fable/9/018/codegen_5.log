+        return False
+    if axis == "v" and not np.array_equal(macro, np.fliplr(macro)):
+        return False
+    if axis == "h" and np.array_equal(macro, np.fliplr(macro)):
+        return False
+    if axis == "v" and np.array_equal(macro, np.flipud(macro)):
+        return False
