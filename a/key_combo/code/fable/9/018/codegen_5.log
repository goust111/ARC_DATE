+    for block_size in range(2, min(height, width) + 1):
+        step = block_size + 1
+        if (height + 1) % step or (width + 1) % step:
+            continue
+        block_rows = (height + 1) // step
+        block_cols = (width + 1) // step
+        if block_rows < 2 or block_cols < 2:
+            continue
