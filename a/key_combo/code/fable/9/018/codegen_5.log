+    seen: set[tuple[int, int]] = set()
+    for row in range(rows):
+        for col in range(cols):
+            if (row, col) in seen:
+                continue
+            rr, cc = _mirror_coord(row, col, (rows, cols), axis)
+            seen.add((row, col))
+            seen.add((rr, cc))
+            if (rr, cc) != (row, col):
