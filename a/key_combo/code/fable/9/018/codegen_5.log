+            continue
+        if int(np.count_nonzero(macro == majority)) < 2:
+            continue
+        if int(np.count_nonzero(macro == minority)) < 2:
+            continue
+        if axis == "h" and np.array_equal(macro, np.fliplr(macro)):
+            continue
+        if axis == "v" and np.array_equal(macro, np.flipud(macro)):
