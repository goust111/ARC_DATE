   506	    macro = _make_macro(rng, rows, cols, axis, majority, minority)
   507	    ambiguous_positions = _pick_ambiguous_positions(rng, macro, axis)
   508	
   509	    majority_cells = [tuple(map(int, rc)) for rc in np.argwhere(macro == majority) if tuple(map(int, rc)) not in ambiguous_positions]
   510	    if not majority_cells:
   511	        return None
   512	    clean_anchor = majority_cells[int(rng.integers(0, len(majority_cells)))]
   513	
   514	    grid = _build_input_grid(rng, macro, sprite, ambiguous_positions, clean_anchor)
   515	    if not _construction_semantics_ok(grid, macro, sprite, axis, ambiguous_positions):
   516	        return None
   517	
   518	    try:
   519	        out = main(grid)
   520	    except AssertionError:
