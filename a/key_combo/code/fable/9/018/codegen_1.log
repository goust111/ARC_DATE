+    damaged_blocks = np.argwhere(diff_counts > 0)
+    assert damaged_blocks.shape[0] == 1, "expected exactly one damaged block"
+    damaged_br, damaged_bc = map(int, damaged_blocks[0])
+    damage_mask = diffs[damaged_br, damaged_bc]
