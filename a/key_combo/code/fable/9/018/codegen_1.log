+    return patch
+
+
+def _is_connected(cells: tuple[tuple[int, int], ...]) -> bool:
+    cell_set = set(cells)
+    queue = deque([cells[0]])
+    seen = {cells[0]}
+    while queue:
+        r, c = queue.popleft()
+        for dr, dc in NEIGHBORS4:
+            nxt = (r + dr, c + dc)
+            if nxt in cell_set and nxt not in seen:
+                seen.add(nxt)
+                queue.append(nxt)
+    return len(seen) == len(cells)
+
