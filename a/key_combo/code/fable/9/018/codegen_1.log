+    candidate_region = np.full((candidate_h, candidate_w), int(bg), dtype=int)
+    for patch, (pr, pc) in zip(patches, placements):
+        ph, pw = patch.shape
+        mask = patch != -1
+        candidate_region[pr : pr + ph, pc : pc + pw][mask] = patch[mask]
