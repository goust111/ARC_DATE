+GEN_RETRIES = 400
+GAP_ROWS = 1
+MIN_CANDIDATE_HEIGHT = 7
+MAX_SHAPE_SPAN = 4
+MIN_SHAPE_CELLS = 3
+MAX_SHAPE_CELLS = 5
+NEIGHBORS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
