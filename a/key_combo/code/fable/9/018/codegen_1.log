+def _place_patches(
+    rng: np.random.Generator, region_h: int, region_w: int, patches: list[np.ndarray]
+) -> list[tuple[int, int]] | None:
+    occupied = np.zeros((region_h, region_w), dtype=bool)
+    placements: list[tuple[int, int]] = []
