+    for idx in order:
+        patch = patches[idx]
+        mask = patch != 0
+        ph, pw = patch.shape
+        options = []
+        for r0 in range(region_h - ph + 1):
+            for c0 in range(region_w - pw + 1):
+                fits = True
+                coords = np.argwhere(mask)
+                for rr, cc in coords:
+                    r = r0 + int(rr)
+                    c = c0 + int(cc)
+                    r1 = max(0, r - 1)
+                    r2 = min(region_h, r + 2)
+                    c1 = max(0, c - 1)
+                    c2 = min(region_w, c + 2)
