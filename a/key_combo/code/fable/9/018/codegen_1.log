  "dst": "match to the colored template object d enclosed by the grey L-frame",
  "match_cond": "s.normalized_mask == d.normalized_mask",
  "transform": "recolor matched s to grey; leave the framed template and all other objects unchanged",
  "symbol_instructions": "grey L-frame marks the template shape and output color"
}
</annotation>
<generation_spec>
