+
+
+def _normalize_coords(coords: np.ndarray) -> tuple[tuple[int, int], ...]:
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    r0 = int(rows.min())
+    c0 = int(cols.min())
+    return tuple(sorted((int(r - r0), int(c - c0)) for r, c in coords))
