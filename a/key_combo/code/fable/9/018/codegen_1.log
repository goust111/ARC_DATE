spec:
  grid: 10x10, black background
  frame:
    color: grey (5)
    shape: inverted-L occupying bottom row and right column of a 4x4 bbox
    position: always top-left corner (rows 0-3, cols 0-3)
    pixels: 7 (3 bottom + 4 right col, sharing corner)
  template:
    area: 3x3 region inside the frame (rows 0-2, cols 0-2)
    color: one non-black non-grey color, distinct from all outside object colors
    pixels: 3-5, single 4-connected component
  outside_objects:
    count: 3-5 total, each a single 4-connected monochromatic component
    matching: exactly 1 has same normalized shape as template, different color
    distractors: 2-4, each with a unique shape distinct from template and each other
