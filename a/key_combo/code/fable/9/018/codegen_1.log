+
+        top = g[:lattice_h, :]
+        full_cols = [c for c in range(w) if np.all(top[:, c] == sep)]
+        if len(full_cols) < 2:
+            continue
+        tile_w = int(full_cols[0])
+        if tile_w <= 0:
+            continue
+        step_w = tile_w + 1
+        col_seps = []
+        expected = tile_w
+        for c in full_cols:
+            if c == expected:
+                col_seps.append(int(c))
+                expected += step_w
+            elif col_seps:
