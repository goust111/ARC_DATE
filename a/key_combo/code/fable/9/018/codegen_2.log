+
+def _boxes_with_gap(a: tuple[int, int, int, int], b: tuple[int, int, int, int], gap: int = 1) -> bool:
+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
+    return ar1 + gap < br0 or br1 + gap < ar0 or ac1 + gap < bc0 or bc1 + gap < ac0
+
+
+def _nearest_neighbor_decoy(top_lefts: list[tuple[int, int]], chain_edges: set[tuple[int, int]], size: int) -> bool:
+    centers = [(r + (size - 1) / 2.0, c + (size - 1) / 2.0) for r, c in top_lefts]
+    ok = False
+    for i, (r0, c0) in enumerate(centers):
+        dists = []
+        for j, (r1, c1) in enumerate(centers):
+            if i == j:
+                continue
+            dist = abs(r0 - r1) + abs(c0 - c1)
+            dists.append((dist, j))
+        dists.sort()
+        nearest = int(dists[0][1])
+        if tuple(sorted((i, nearest))) not in chain_edges:
+            ok = True
+            break
