+
+
+def _expected_output(input_grid: np.ndarray, order: list[int], top_lefts: list[tuple[int, int]], size: int, fills: list[int]) -> np.ndarray:
+    out = input_grid.copy()
+    shifted = fills[1:] + [BG]
+    for idx, fill in zip(order, shifted):
+        r, c = top_lefts[idx]
+        out[r + 1 : r + size - 1, c + 1 : c + size - 1] = int(fill)
+    return out
+
