+        if side == "top":
+            patch[0, off] = port_color
+        elif side == "bottom":
+            patch[size - 1, off] = port_color
+        elif side == "left":
+            patch[off, 0] = port_color
+        elif side == "right":
+            patch[off, size - 1] = port_color
+        else:
+            raise ValueError(f"bad side {side}")
