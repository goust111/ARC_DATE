+        r, c = top_lefts[idx]
+        out[r + 1 : r + size - 1, c + 1 : c + size - 1] = int(fill)
+    return out
+
+
+def _gen_attempt() -> np.ndarray | None:
+    n_blocks = random.choice(BLOCK_COUNT_CHOICES)
