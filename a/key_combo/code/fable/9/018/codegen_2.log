+
+def _sample_axis_positions(count: int, size: int, limit: int) -> list[int] | None:
+    min_gap = 2
+    starts = list(range(1, limit - size))
+    for _ in range(200):
+        picks = sorted(random.sample(starts, count))
+        if all(picks[i + 1] - picks[i] >= size + min_gap for i in range(count - 1)):
