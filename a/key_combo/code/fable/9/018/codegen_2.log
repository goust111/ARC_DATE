+def _chain_order_from_hole(blocks: list[dict], bg: int) -> list[int]:
+    _matches, adj, _some_endpoint = _build_chain(blocks)
+    hole = [i for i, block in enumerate(blocks) if int(block["fill"]) == int(bg)]
