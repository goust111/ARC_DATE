+def _content_count_for(cup: dict, salt: int) -> int:
+    cap = min(4, len(cup["mouth"]))
+    base = len(cup["mouth"]) + cup["shape"][0] + 2 * cup["shape"][1] + salt
+    return 1 + (base % cap)
