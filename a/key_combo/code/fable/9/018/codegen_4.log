+            border_mask[r, c] = True
+    vals = [
+        int(g[r, c])
+        for r, c in np.argwhere((g != bg) & ~border_mask)
+    ]
+    if not vals:
+        return None
+    return int(Counter(vals).most_common(1)[0][0])
+
