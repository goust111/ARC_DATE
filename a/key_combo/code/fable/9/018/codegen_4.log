+                    "id": next_id,
+                    "border_color": int(col),
+                    "bbox": bbox,
+                    "border": border_set,
+                    "tail_dir": tail_dir,
+                    "spike": spike,
+                    "mouth": mouth,
+                    "mouth_edge": mouth_edge,
