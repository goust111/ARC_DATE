+from __future__ import annotations
+
+from collections import Counter
+import numpy as np
+
+
+DIR4 = {"U": (-1, 0), "D": (1, 0), "L": (0, -1), "R": (0, 1)}
+OPPOSITE = {"U": "D", "D": "U", "L": "R", "R": "L"}
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def _bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _components_coords(mask: np.ndarray, connectivity: int = 8) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    if connectivity == 4:
+        steps = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+    else:
+        steps = [(dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if (dr, dc) != (0, 0)]
+
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in steps:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _flood_from_bbox_side(border_set: set[tuple[int, int]], bbox: tuple[int, int, int, int], side: str) -> set[tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    if side == "U":
+        seeds = [(r0, c) for c in range(c0, c1 + 1) if (r0, c) not in border_set]
+    elif side == "D":
+        seeds = [(r1, c) for c in range(c0, c1 + 1) if (r1, c) not in border_set]
+    elif side == "L":
+        seeds = [(r, c0) for r in range(r0, r1 + 1) if (r, c0) not in border_set]
+    else:
+        seeds = [(r, c1) for r in range(r0, r1 + 1) if (r, c1) not in border_set]
+
+    visited = set(seeds)
+    stack = list(seeds)
+    while stack:
+        r, c = stack.pop()
+        for dr, dc in DIR4.values():
+            nr, nc = r + dr, c + dc
+            if not (r0 <= nr <= r1 and c0 <= nc <= c1):
+                continue
+            if (nr, nc) in visited or (nr, nc) in border_set:
+                continue
+            visited.add((nr, nc))
+            stack.append((nr, nc))
+    return visited
+
+
+def _edge_singleton_tail(border_set: set[tuple[int, int]], bbox: tuple[int, int, int, int]) -> tuple[str, tuple[int, int]] | None:
+    r0, c0, r1, c1 = bbox
+    corners = {(r0, c0), (r0, c1), (r1, c0), (r1, c1)}
+    edges = [
+        ("U", [p for p in border_set if p[0] == r0]),
+        ("D", [p for p in border_set if p[0] == r1]),
+        ("L", [p for p in border_set if p[1] == c0]),
+        ("R", [p for p in border_set if p[1] == c1]),
+    ]
+    candidates = [(d, cells[0]) for d, cells in edges if len(cells) == 1 and cells[0] not in corners]
+    if len(candidates) != 1:
+        return None
+    return candidates[0]
