+    dr, dc = DIR4[sink["tail_dir"]]
+    sr, sc = sink["spike"]
+    for step in range(1, total_count + 1):
+        rr = sr + dr * step
+        cc = sc + dc * step
+        if not _in_bounds(out.shape, rr, cc):
+            break
+        out[rr, cc] = content_col
+    return out
