+
+def _sample_right_cup(rng: np.random.Generator, color: int, min_slots: int) -> dict | None:
+    for _ in range(120):
+        l_arm = int(rng.integers(1, 4))
+        r_arm = int(rng.integers(1, 4))
+        h_l = int(rng.integers(1, 4))
+        h_r = int(rng.integers(1, 4))
