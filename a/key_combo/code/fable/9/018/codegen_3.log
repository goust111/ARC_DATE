+def _component_bfs(grid: np.ndarray, bg: int) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    H, W = g.shape
+    seen = np.zeros((H, W), dtype=bool)
+    comps: list[dict] = []
+
+    for r in range(H):
+        for c in range(W):
+            color = int(g[r, c])
+            if color == bg or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            while q:
