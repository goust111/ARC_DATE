+    if not np.array_equal(main(grid), _render(shape, BG_COLOR, sprites, _simulate_chain(sprites, shape)[0])):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GEN_ATTEMPTS):
