def _add_decoys(rng: random.Random, sprites: list[dict], shape: tuple[int, int]) -> list[dict] | None:
    decoy_count = rng.randrange(*GEN_DECOY_RANGE)
    out = list(sprites)
    H, W = shape

    for _ in range(decoy_count):
        placed = None
