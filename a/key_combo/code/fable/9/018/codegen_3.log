+SOLID_MASK = np.ones((SPRITE_SIZE, SPRITE_SIZE), dtype=bool)
+HOLLOW_MASK = np.ones((SPRITE_SIZE, SPRITE_SIZE), dtype=bool)
+HOLLOW_MASK[1, 1] = False
