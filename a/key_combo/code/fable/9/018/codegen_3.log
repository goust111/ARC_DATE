_GEN_MAX_ATTEMPTS = 300


def _gen_hollow_square(color):
    sprite = np.full((_GEN_SIZE, _GEN_SIZE), int(color), dtype=int)
    sprite[1, 1] = _GEN_BG
    return sprite


def _gen_render_square(color, r0, c0):
    grid = np.full((_GEN_H, _GEN_W), _GEN_BG, dtype=int)
