+        for i in range(len(sprites))
+    ):
+        return False
+
+    for i in range(len(sprites)):
+        for j in range(i + 1, len(sprites)):
+            if _sprites_touch(str(sprites[i]["kind"]), positions_before[i], str(sprites[j]["kind"]), positions_before[j]):
