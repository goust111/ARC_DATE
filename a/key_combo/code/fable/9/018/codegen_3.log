+    color = int(rng.choice(COLOR_POOL))
+    dr, dc = DIR_BY_COLOR[color]
+    if dr == -1:
+        col = rng.randrange(0, W - SPRITE_SIZE + 1)
+        if zero_step:
+            pos = (0, col)
+        else:
