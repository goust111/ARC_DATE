+GREEN = 3
+YELLOW = 4
+PINK = 6
+TEAL = 8
+
+DIR_BY_COLOR = {
+    GREEN: (0, -1),
+    YELLOW: (1, 0),
+    PINK: (-1, 0),
+    TEAL: (0, 1),
