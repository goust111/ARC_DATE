            if dr == -1 and r0 == 0:
                continue
            if dr == 1 and r0 == H - SPRITE_SIZE:
                continue
            if dc == -1 and c0 == 0:
                continue
            if dc == 1 and c0 == W - SPRITE_SIZE:
                continue
            candidate = {"color": color, "kind": "hollow", "pos": (r0, c0)}
