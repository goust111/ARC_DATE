+def _visible_positions(arr: np.ndarray, bg: int) -> dict[int, list[int]]:
+    positions: dict[int, list[int]] = defaultdict(list)
+    for idx, value in enumerate(arr.tolist()):
+        value = int(value)
+        if value != bg:
