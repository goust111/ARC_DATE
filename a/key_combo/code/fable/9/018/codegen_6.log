spec:
  grid: 10x10 [observed]
  background: black [observed]
  src:
    shape: 3x3 hollow square (8 border pixels, center is background)
    color: one of green/yellow/pink/teal (encodes direction)
    placement: not already flush with its target edge; distance to target edge 3-5
  path:
    direction: green=left, yellow=down, pink=up, teal=right
    action: slide sprite until bbox is flush with the indicated grid edge
  output:
    grid same size, all background except the 3x3 hollow square at its destination edge
    sprite row (for left/right) or column (for up/down) preserved from input

generation_strategy:
