+        "bottom": bottom_intervals,
+        "right": right_intervals,
+        "order": order,
+        "bottom_relations": bottom_relations,
+        "right_relations": right_relations,
+        "bottom_evidence": bottom_evidence,
+        "right_evidence": right_evidence,
