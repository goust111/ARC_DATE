+    inp[-1, -1] = BG
+
+    expected = _build_output(main_h, main_w, row_intervals, col_intervals, order, BG)
+    if not _validate_generated_case(inp, expected, order, row_intervals, col_intervals):
+        return None
+    return inp
+
