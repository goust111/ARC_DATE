+
+    followers: dict[int, set[int]] = {color: set() for color in colors}
+    indegree: dict[int, int] = {color: 0 for color in colors}
+    for lower, upper in relations:
+        if upper not in followers[lower]:
+            followers[lower].add(upper)
+            indegree[upper] += 1
