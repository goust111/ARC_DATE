+import random
+from collections import Counter, defaultdict, deque
+
+import numpy as np
+
+
+RED = 2
+BG_COLOR = 0
+BLOCK_COLORS = [1, 3, 4, 5, 6, 7, 8, 9]
+GEN_ATTEMPTS = 400
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, np.asarray(grid).ravel())).most_common(1)[0][0])
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _mask_connected(mask: np.ndarray) -> bool:
+    pts = np.argwhere(mask)
+    if pts.size == 0:
+        return False
+    h, w = mask.shape
+    start = tuple(map(int, pts[0]))
+    seen = {start}
+    q = deque([start])
+    while q:
+        r, c = q.popleft()
+        for rr, cc in _neighbors4(r, c):
+            if 0 <= rr < h and 0 <= cc < w and mask[rr, cc] and (rr, cc) not in seen:
+                seen.add((rr, cc))
+                q.append((rr, cc))
+    return len(seen) == int(mask.sum())
+
+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(g[r, c]) == bg:
+                continue
+            color = int(g[r, c])
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(g[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            rows = [rr for rr, _ in coords]
+            cols = [cc for _, cc in coords]
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": (min(rows), min(cols), max(rows), max(cols)),
+                }
+            )
+    return comps
+
+
+def _drop_distance(coords: list[tuple[int, int]], occupied: np.ndarray, height: int) -> int:
+    drop = 0
+    while True:
+        for r, c in coords:
+            nr = r + drop + 1
+            if nr >= height or occupied[nr, c]:
+                return drop
+        drop += 1
+
+
+def _settle_blocks(grid: np.ndarray) -> tuple[np.ndarray, list[dict], int]:
+    g = np.asarray(grid, dtype=int)
+    bg = _get_bg(g)
+    h, w = g.shape
+    comps = _find_components(g, bg)
+    comps.sort(key=lambda comp: (-comp["bbox"][2], -comp["bbox"][0], comp["bbox"][1], comp["color"]))
+
+    occupied = np.zeros((h, w), dtype=bool)
+    out = np.full((h, w), bg, dtype=int)
+    placed: list[dict] = []
+    for comp in comps:
+        drop = _drop_distance(comp["coords"], occupied, h)
+        shifted = [(r + drop, c) for r, c in comp["coords"]]
+        for r, c in shifted:
+            occupied[r, c] = True
+            out[r, c] = comp["color"]
+        rows = [r for r, _ in shifted]
+        cols = [c for _, c in shifted]
+        placed.append(
+            {
+                "color": comp["color"],
+                "coords": shifted,
+                "bbox": (min(rows), min(cols), max(rows), max(cols)),
+            }
+        )
+    return out, placed, bg
