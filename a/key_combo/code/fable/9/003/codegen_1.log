+def _try_place_relay(
+    shape: tuple[int, int],
+    current: tuple[int, int],
+    direction: tuple[int, int],
+    frames: list[dict],
+    occupied: set[tuple[int, int]],
+    ray_cells: set[tuple[int, int]],
+) -> dict | None:
+    h_grid, w_grid = shape
+    entry_side = ENTRY_SIDE_FOR_DIR[direction]
