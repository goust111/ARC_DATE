+        dist = random.randint(2, 6)
+        hit_offset = _random_offset(hit_side, h, w)
+        hit = (current[0] + direction[0] * dist, current[1] + direction[1] * dist)
+        bbox = _bbox_from_side_gap(hit, hit_side, hit_offset, h, w)
