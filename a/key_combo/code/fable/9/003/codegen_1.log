+            if fi not in entered:
+                entered.add(fi)
+                r0, c0, r1, c1 = frames[fi]["bbox"]
+                out[r0 + 1 : r1, c0 + 1 : c1] = CYAN
+            other_gap = info["other_gap"]
+            other_out = info["other_out"]
+            out[other_gap] = CYAN
+            r, c = other_gap
+            dr, dc = other_out
+            continue
+
+        r, c = nr, nc
+
