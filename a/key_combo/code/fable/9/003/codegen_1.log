+    current: tuple[int, int],
+    direction: tuple[int, int],
+    occupied: set[tuple[int, int]],
+    ray_cells: set[tuple[int, int]],
+) -> list[tuple[int, int]] | None:
+    cells = []
+    r, c = current
+    dr, dc = direction
+    while True:
