+        if _frame_cells_conflict(frame["bbox"], frames, occupied):
+            continue
+        if any(cell in ray_cells for cell in _iter_bbox_cells(frame["bbox"])):
+            continue
+        return frame
+    return None
+
+
+def _build_attempt() -> np.ndarray | None:
