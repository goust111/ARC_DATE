+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def _prefix_sum(mask: np.ndarray) -> np.ndarray:
+    return mask.astype(np.int16).cumsum(axis=0).cumsum(axis=1)
