80:    flat[shuffled[:split]] = nonzero
81:
82:    remaining = shuffled[split:]
83:    if len(remaining):
84:        flat[remaining] = np.random.choice(nonzero, size=len(remaining))
85:
86:    return flat.reshape(height, width)
