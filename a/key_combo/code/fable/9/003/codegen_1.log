+    if r0 > r1 or c0 > c1:
+        return 0
+    total = int(pref[r1, c1])
+    if r0:
+        total -= int(pref[r0 - 1, c1])
+    if c0:
+        total -= int(pref[r1, c0 - 1])
+    if r0 and c0:
+        total += int(pref[r0 - 1, c0 - 1])
+    return total
+
+
+def _gap_coord(r0: int, c0: int, h: int, w: int, side: str, offset: int) -> tuple[int, int]:
+    if side == "top":
+        return r0, c0 + offset
+    if side == "bottom":
+        return r0 + h - 1, c0 + offset
+    if side == "left":
+        return r0 + offset, c0
+    if side == "right":
