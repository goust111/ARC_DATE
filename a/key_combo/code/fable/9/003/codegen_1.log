38:def main(grid: np.ndarray) -> np.ndarray:
39:    """
40:    Slide black shapes rightward to a grey separator, then shoot red rays from enclosed holes.
41:
42:    Input structure:
43:    - A vertical grey (5) separator column divides the grid into left and right halves.
44:    - Black shapes sit on the left side against a background color (bg).
45:
46:    Rule:
47:    - Translate each black connected component rightward until its right edge is flush with the separator.
48:    - After sliding, find enclosed bg regions (holes) within the black shapes that touch the column just left of the separator.
49:    - For each row spanned by such a hole, emit a red ray across the entire right half of the grid.
50:
51:    Key insight: Only holes adjacent to the separator trigger rays — the sliding creates enclosures that act as "nozzles" projecting rightward.
52:    """
53:    g = np.asarray(grid, dtype=int)
54:    h, w = g.shape
55:    sep_color = 5
56:    black = 0
57:    red = 2
58:
59:    sep = _find_separator_col(g, sep_color=sep_color)
60:    bg = _background_color(g, sep_col=sep, sep_color=sep_color)
61:
62:    out = g.copy()
63:
64:    # Step 1: move black components on the left so that their right edge touches the separator.
65:    left = out[:, :sep].copy()
66:    left_mask = left == black
67:    comps = _components4(left_mask)
68:
69:    # Clear old black pixels (leave other colors intact).
70:    left[left == black] = bg
71:
72:    target_right = sep - 1  # last column in left side, adjacent to separator
73:    for comp in comps:
74:        max_c = max(c for _, c in comp)
75:        delta = target_right - max_c
76:        assert delta >= 0, "left-side components must stay left of the separator"
77:        for r, c in comp:
78:            nc = c + delta
79:            assert 0 <= nc < sep, f"shifted pixel {(r, c)} left the pane"
80:            left[r, nc] = black
81:
82:    out[:, :sep] = left
83:
84:    # Step 2: find enclosed background regions (holes) on the left.
85:    # A hole is a bg component not touching the left subgrid boundary.
86:    holes = []
87:    for pts in _components4(left == bg):
88:        if any(r == 0 or r == h - 1 or c == 0 or c == sep - 1 for r, c in pts):
