+    "top": "bottom",
+    "bottom": "top",
+    "left": "right",
+    "right": "left",
+}
+ORTHOGONAL_SIDES = {
+    "top": ("left", "right"),
+    "bottom": ("left", "right"),
+    "left": ("top", "bottom"),
+    "right": ("top", "bottom"),
