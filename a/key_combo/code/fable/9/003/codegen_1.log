+    min_extra = max(0, 3 - len(frames))
+    max_extra = max(min_extra, min(6 - len(frames), 2))
+    extra_count = random.randint(min_extra, max_extra) if max_extra >= min_extra else 0
+    for _ in range(extra_count):
