+DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+SIDE_TO_OUT = {
+    "top": (-1, 0),
+    "right": (0, 1),
+    "bottom": (1, 0),
+    "left": (0, -1),
+}
+OUT_TO_SIDE = {v: k for k, v in SIDE_TO_OUT.items()}
+ENTRY_SIDE_FOR_DIR = {
+    (-1, 0): "bottom",
+    (0, 1): "left",
+    (1, 0): "top",
+    (0, -1): "right",
