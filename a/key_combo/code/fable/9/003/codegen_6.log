+        for idx in best_options:
+            cand = candidates[idx]
+            next_mask = known_mask.copy()
+            next_mask[cand["rows"], cand["cols"]] = False
+            suffix = dfs(next_mask)
+            if suffix is not None:
+                result = [idx, *suffix]
+                memo[key] = result
+                return result
