+def _render_canvas(
+    pattern: np.ndarray, shape: tuple[int, int], centers: list[tuple[int, int]]
+) -> np.ndarray:
+    h, w = shape
+    k = pattern.shape[0]
+    rad = k // 2
+    canvas = np.full((h, w), BLACK, dtype=int)
+    for cr, cc in centers:
+        for pr in range(k):
