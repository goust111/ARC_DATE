+def _find_separator_row(grid: np.ndarray) -> int:
+    rows = [
+        r
+        for r in range(grid.shape[0])
+        if int(grid[r, 0]) == GREY and bool(np.all(grid[r] == GREY))
+    ]
+    assert len(rows) == 1, "expected one grey separator row"
+    return int(rows[0])
