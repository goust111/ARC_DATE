+                -int((known_mask[candidates[idx]["rows"], candidates[idx]["cols"]]).sum()),
+                abs(candidates[idx]["center"][0] - best_cell[0])
+                + abs(candidates[idx]["center"][1] - best_cell[1]),
+                candidates[idx]["center"],
+            )
+        )
