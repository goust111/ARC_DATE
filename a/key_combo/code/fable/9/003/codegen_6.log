                            gaps.append((r0, c))
                        elif int(grid[r0, c]) != BLUE:
                            ok = False
                        if int(grid[r1, c]) == BLACK:
                            gaps.append((r1, c))
                        elif int(grid[r1, c]) != BLUE:
                            ok = False
                    for r in range(r0 + 1, r1):
                        if int(grid[r, c0]) == BLACK:
                            gaps.append((r, c0))
                        elif int(grid[r, c0]) != BLUE:
                            ok = False
                        if int(grid[r, c1]) == BLACK:
                            gaps.append((r, c1))
                        elif int(grid[r, c1]) != BLUE:
                            ok = False
                    if not ok or len(gaps) != 2:
                        continue

                    gap_sides = {}
                    for gr, gc in gaps:
                        if gr == r0:
                            gap_sides[(gr, gc)] = "top"
                        elif gr == r1:
                            gap_sides[(gr, gc)] = "bottom"
                        elif gc == c0:
                            gap_sides[(gr, gc)] = "left"
                        else:
                            gap_sides[(gr, gc)] = "right"
                    frames.append(
                        {
                            "bbox": (r0, c0, r1, c1),
                            "gaps": tuple(gaps),
                            "gap_sides": gap_sides,
                        }
                    )
    return frames


