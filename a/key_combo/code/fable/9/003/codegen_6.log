+def _is_asymmetric(pattern: np.ndarray) -> bool:
+    return not any(
+        np.array_equal(pattern, candidate)
+        for candidate in (
+            np.fliplr(pattern),
+            np.flipud(pattern),
+            np.rot90(pattern, 2),
+        )
+    )
