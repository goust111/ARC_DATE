        for w in range(*_GEN_SPRITE_W_RANGE):
            if 2 * h <= H or 2 * w <= W:
                dims.append((h, w))
    if not dims:
        return None
    return _gen_choice(rng, dims)


def _gen_copy_direction(H, W, h, w, rng):
    copy_dirs = [d for d in _GEN_COPY_DIRS if (d[0] and 2 * h <= H) or (d[1] and 2 * w <= W)]
    if not copy_dirs:
