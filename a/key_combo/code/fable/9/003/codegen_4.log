```yaml
spec:
  grid: 10x10, always even width [observed: always 10x10]
  background: BLACK
  colors_input: only BLACK and GREY
  colors_output: BLACK, GREY, and BLUE
  grey_mask:
    pixel_count: 14-27 (density 14%-27%)
    connected_components: 4-13, mix of 1-2 large blobs and many singletons
  transform:
    rule: for each GREY pixel, mirror it horizontally across the vertical midline (col -> W-1-col); if the mirror cell is also GREY, recolor BOTH to BLUE; otherwise keep GREY
    paired_pixels: 8-20 (57%-77% of grey pixels become BLUE)
    unpaired_pixels: 5-7, scattered noise that break horizontal symmetry
    unpaired_components: mostly singletons, occasionally one 2-cell cluster [observed]
  constraints:
    - grid width must be even (solver asserts)
    - BLUE absent from input (solver asserts)
    - exactly one foreground color GREY (solver asserts)
    - must have both paired and unpaired grey pixels to make the task non-trivial

generation_strategy:
