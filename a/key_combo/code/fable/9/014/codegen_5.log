def _gen_place_panels(panels):
    canvas = np.full(_GEN_CANVAS_SHAPE, _GEN_BLACK, dtype=int)
    order = sorted(range(len(panels)), key=lambda i: panels[i].size, reverse=True)
    for i in order:
        try:
            r, c = _gen_random_free_location(
