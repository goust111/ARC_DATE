+    except Exception:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+
+    blocks = _split_blocks(grid)
+    seen_coords = set()
+    seen_colors = set()
+    for (block_r, block_c), true_transform, true_coord, true_color in zip(
+        OUTER_POSITIONS, transform_names, marker_coords, marker_colors
