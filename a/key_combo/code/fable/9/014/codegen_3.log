+    return transforms
+
+
+def _expected_output(reference: np.ndarray, coords: list[tuple[int, int]], colors: list[int]) -> np.ndarray:
+    out = reference.copy()
+    for (r, c), color in zip(coords, colors):
+        out[int(r), int(c)] = int(color)
+    return out
