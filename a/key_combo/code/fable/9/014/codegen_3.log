+    if name == "rot180":
+        return np.rot90(block, 2).copy()
+    if name == "rot270":
+        return np.rot90(block, 3).copy()
+    if name == "fliplr":
+        return np.fliplr(block).copy()
+    if name == "flipud":
+        return np.flipud(block).copy()
+    raise ValueError(f"unknown transform: {name}")
