+            (r0, c0 + arm_c - 1, 1, -1),
+            (r0 + arm_r - 1, c0, -1, 1),
+            (r0 + arm_r - 1, c0 + arm_c - 1, -1, -1),
+        ]
+    )
+    cr, cc, sr, sc = corner
+    for step in range(arm_r):
+        mask[cr + step * sr, cc] = True
+    for step in range(arm_c):
+        mask[cr, cc + step * sc] = True
+    return mask
