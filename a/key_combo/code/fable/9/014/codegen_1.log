+    arm_r = random.randint(2, max(2, n - 1))
+    arm_c = random.randint(2, max(2, n - 1))
+    r0 = random.randint(0, n - arm_r)
+    c0 = random.randint(0, n - arm_c)
+    corner = random.choice(
+        [
