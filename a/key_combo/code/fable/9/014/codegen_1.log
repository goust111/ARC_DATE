    _paint_flats(lower, both_flats, LOWER_FG_COLOR)
    _paint_flats(upper, upper_only_flats, UPPER_FG_COLOR)
    _paint_flats(lower, lower_only_flats, LOWER_FG_COLOR)
    return upper, lower


