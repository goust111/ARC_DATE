  legend: fixed 3x3 positional color map applied to each interior
    # 1(blue)  7(orange) 6(pink)
    # 4(yellow) 8(teal)  5(grey)
    # 2(red)   9(maroon) 3(green)
  transform: for each interior position (r,c) != center, if pixel is black, recolor to legend[r][c]

generation_strategy:
  approach: direct construction (task is simple transform-in-place)
