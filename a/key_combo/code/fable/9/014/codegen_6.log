import numpy as np
from collections import deque

def scan_area(mask):
    total=0
    for r in range(mask.shape[0]):
        cols=np.flatnonzero(mask[r])
        if len(cols)%2: return None
        for i in range(0,len(cols),2):
            total += cols[i+1]-cols[i]-1
    return total

def flood_interior(mask):
    H,W=mask.shape
    vis=np.zeros((H,W),bool)
    dq=deque()
    for r in range(H):
        for c in [0,W-1]:
            if not mask[r,c] and not vis[r,c]: vis[r,c]=1; dq.append((r,c))
    for c in range(W):
        for r in [0,H-1]:
            if not mask[r,c] and not vis[r,c]: vis[r,c]=1; dq.append((r,c))
    while dq:
        r,c=dq.popleft()
        for dr,dc in [(1,0),(-1,0),(0,1),(0,-1)]:
            rr,cc=r+dr,c+dc
            if 0<=rr<H and 0<=cc<W and not mask[rr,cc] and not vis[rr,cc]:
                vis[rr,cc]=1; dq.append((rr,cc))
    return int(((~mask)&(~vis)).sum())

def conn8(mask):
    pts=np.argwhere(mask)
    if len(pts)==0:return False
    vis=set([tuple(pts[0])])
    dq=[tuple(pts[0])]
    H,W=mask.shape
    while dq:
        r,c=dq.pop()
        for dr in (-1,0,1):
            for dc in (-1,0,1):
                if dr==dc==0: continue
                rr,cc=r+dr,c+dc
                if 0<=rr<H and 0<=cc<W and mask[rr,cc] and (rr,cc) not in vis:
                    vis.add((rr,cc)); dq.append((rr,cc))
    return len(vis)==len(pts)

def show(a):
    return '\\n'.join(''.join('#' if x else '.' for x in row) for row in a)

