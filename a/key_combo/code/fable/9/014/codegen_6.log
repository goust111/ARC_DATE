                canvas, panels[i], transparent=_GEN_BLACK, padding=_GEN_PLACEMENT_PADDING, padding_connectivity=_GEN_PADDING_CONNECTIVITY
            )
        except ValueError:
            return None
        _gen_paste(canvas, panels[i], r, c)
    return canvas


def _gen_attempt():
