import numpy as np
from collections import deque

def parse(rows): return np.array([[ch=='1' for ch in row] for row in rows],bool)
def rect(h,w):
    a=np.zeros((h,w),bool)
    a[0,:]=a[-1,:]=1
    a[:,0]=a[:,-1]=1
    return a

def multi(kind, extra):
    if kind=='A':
        rows=['11111111','10011001','10100101'] + ['10000001']*(1+extra) + ['11111111']
    else:
        rows=['11111111','10100101'] + ['10000001']*(1+extra) + ['10100101','11111111']
    return parse(rows)

def scan(mask):
    fill=[]
    for r in range(mask.shape[0]):
        cols=np.flatnonzero(mask[r])
        if len(cols)%2: return None
        for i in range(0,len(cols),2):
            fill += [(r,c) for c in range(cols[i]+1, cols[i+1])]
    return fill

def safe(mask):
    out=[]
    for r,c in scan(mask):
        ok=True
        for dr in (-1,0,1):
            for dc in (-1,0,1):
                rr,cc=r+dr,c+dc
                if 0<=rr<mask.shape[0] and 0<=cc<mask.shape[1] and mask[rr,cc]:
                    ok=False
        if ok: out.append((r,c))
    return out

def outer(mask):
    s=0
    for r in range(mask.shape[0]):
        cols=np.flatnonzero(mask[r])
        if len(cols)>=2: s+=cols[-1]-cols[0]-1
    return s

for h,w in [(4,6),(5,6),(6,6),(5,8),(6,8)]:
    m=rect(h,w)
    print('rect',h,w,'area',len(scan(m)),'safe',len(safe(m)),'outer',outer(m))
for kind in 'AB':
    for e in range(3):
        m=multi(kind,e)
        print('multi',kind,e,'shape',m.shape,'area',len(scan(m)),'safe',len(safe(m)),'outer',outer(m))
        print('\\n'.join(''.join('#' if x else '.' for x in row) for row in m))
        print()
