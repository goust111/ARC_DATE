+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _neighbors8(r: int, c: int) -> list[tuple[int, int]]:
+    return [
+        (r + dr, c + dc)
+        for dr in (-1, 0, 1)
+        for dc in (-1, 0, 1)
+        if not (dr == 0 and dc == 0)
+    ]
+
+
+def _neighbors4(r: int, c: int) -> list[tuple[int, int]]:
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def _components_of_color(grid: np.ndarray, color: int, *, connectivity: int = 8) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    neighbors = _neighbors8 if connectivity == 8 else _neighbors4
+    components = []
+
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(g[r, c]) != int(color):
+                continue
+            seen[r, c] = True
+            queue = deque([(r, c)])
+            coords: list[tuple[int, int]] = []
+            while queue:
+                rr, cc = queue.popleft()
+                coords.append((rr, cc))
+                for nr, nc in neighbors(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(g[nr, nc]) == int(color):
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+
+            r0, c0, r1, c1 = _bbox(coords)
+            mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+            for rr, cc in coords:
+                mask[rr - r0, cc - c0] = True
+            components.append(
+                {
+                    "bbox": (r0, c0, r1, c1),
+                    "mask": mask,
+                    "coords": coords,
+                }
+            )
