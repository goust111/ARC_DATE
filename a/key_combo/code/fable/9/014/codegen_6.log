import numpy as np
from collections import deque

def scan_area(mask):
    total=0
    rows=[]
    for r in range(mask.shape[0]):
        cols=np.flatnonzero(mask[r])
        row=[]
        for i in range(0,len(cols)-1,2):
            a,b=cols[i],cols[i+1]
            cells=list(range(a+1,b))
            total+=len(cells)
            row.extend(cells)
        rows.append(row)
    return total,rows

def flood_interior(mask):
    H,W=mask.shape
    vis=np.zeros((H,W),bool)
    dq=deque()
    for r in range(H):
        for c in [0,W-1]:
            if not mask[r,c] and not vis[r,c]: vis[r,c]=1; dq.append((r,c))
    for c in range(W):
        for r in [0,H-1]:
            if not mask[r,c] and not vis[r,c]: vis[r,c]=1; dq.append((r,c))
    while dq:
        r,c=dq.popleft()
        for dr,dc in [(1,0),(-1,0),(0,1),(0,-1)]:
