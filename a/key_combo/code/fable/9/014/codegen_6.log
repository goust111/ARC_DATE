+        r, c = queue.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc] and not seen[nr, nc]:
+                seen[nr, nc] = True
+                queue.append((nr, nc))
