def _gen_output_mask(height: int, width: int, teal_count: int) -> np.ndarray | None:
    mask = np.ones((height, width), dtype=bool)
    row_counts = np.full(height, width, dtype=int)
    col_counts = np.full(width, height, dtype=int)
