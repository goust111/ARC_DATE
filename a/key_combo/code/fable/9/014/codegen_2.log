   5: from arc_utils import Color, bbox_coords
   6: 
   7: 
   8: def main(grid: np.ndarray) -> np.ndarray:
   9:     """
  10:     Use the 2x2 black marker as an eraser that clears its rows and columns except for red pixels.
  11: 
  12:     Input structure:
  13:     - The grid is otherwise filled with colored pixels.
  14:     - There is exactly one 2x2 black marker.
  15:     - Red pixels are protected cells that may lie in the marker's rows or columns.
  16: 
  17:     Rule:
  18:     - Select both rows and both columns occupied by the 2x2 black marker.
  19:     - Recolor every selected non-red pixel to black.
  20:     - Leave all unselected pixels and selected red pixels unchanged.
  21: 
  22:     Key insight:
  23:     - The marker does not expand as a filled rectangle; it defines a two-row and
  24:       two-column cross, with red pixels acting as holes in the erased cross.
  25:     """
  26:     g = np.asarray(grid, dtype=int)
  27:     assert g.ndim == 2, "expected a 2D grid"
  28: 
  29:     marker = g == Color.BLACK
  30:     assert int(np.count_nonzero(marker)) == 4, "expected exactly four black marker pixels"
  31:     r0, c0, r1, c1 = bbox_coords(np.argwhere(marker))
  32:     assert int(r1 - r0 + 1) == 2 and int(c1 - c0 + 1) == 2, "black marker must be 2x2"
  33:     assert np.all(marker[r0 : r1 + 1, c0 : c1 + 1]), "black marker must be solid"
  34: 
  35:     erase = np.zeros(g.shape, dtype=bool)
  36:     erase[r0 : r1 + 1, :] = True
  37:     erase[:, c0 : c1 + 1] = True
  38: 
  39:     out = g.copy()
  40:     out[erase & (g != Color.RED)] = Color.BLACK
  41:     return out
