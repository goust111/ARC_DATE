   6: def main(grid: np.ndarray) -> np.ndarray:
   7:     """
   8:     Draw the red row and column dividers through two marker pixels and fill the marked rectangle interior blue.
   9: 
  10:     Input structure:
  11:     - The grid has a uniform background and exactly two non-background marker pixels.
  12:     - The two markers occupy different rows and different columns, making opposite corners of a nonempty rectangle.
  13:     - The marker color is preserved as the divider color, while blue is absent from the input and used for the fill.
  14: 
  15:     Rule:
  16:     - Use the two marker rows and two marker columns as full-width/full-height dividers.
  17:     - Paint those rows and columns with the marker color.
  18:     - Paint the strict interior of the rectangle between the marker rows and columns blue.
  19: 
  20:     Key insight:
  21:     - The isolated markers are opposite rectangle corners; extending their horizontal and vertical projections partitions the whole grid.
  22:     """
  23:     g = np.asarray(grid, dtype=int)
  24:     assert g.ndim == 2, "expected a 2D grid"
  25:     assert not np.any(g == Color.BLUE), "blue must not appear in the input"
  26: 
  27:     bg = get_bg(g)
  28:     marker_colors = colors_present(g, exclude={bg})
  29:     assert len(marker_colors) == 1, "expected exactly one non-background marker color"
  30: 
  31:     marker = int(marker_colors[0])
  32:     pts = np.argwhere(g == marker)
  33:     assert pts.shape == (2, 2), "expected exactly two marker pixels"
  34: 
  35:     (r0, c0), (r1, c1) = pts
  36:     rlo, rhi = sorted((int(r0), int(r1)))
  37:     clo, chi = sorted((int(c0), int(c1)))
  38:     assert rlo < rhi and clo < chi, "markers must be diagonal rectangle corners"
  39:     assert rhi - rlo > 1 and chi - clo > 1, "marked rectangle must have a nonempty interior"
  40: 
  41:     out = np.full_like(g, bg)
  42:     out[[rlo, rhi], :] = marker
  43:     out[:, [clo, chi]] = marker
  44:     out[rlo + 1 : rhi, clo + 1 : chi] = Color.BLUE
  45:     return out
