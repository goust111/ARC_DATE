+    if side == "top":
+        return hole_count, c0
+    if side == "bottom":
+        return inner_h - h - hole_count, c0
+    if side == "left":
+        return r0, hole_count
+    if side == "right":
+        return r0, inner_w - w - hole_count
+    raise ValueError(f"unknown side: {side}")
