+    for side, spec in specs.items():
+        r0, c0 = placements[side]
+        patch = np.zeros(spec["solid_mask"].shape, dtype=int)
+        patch[spec["solid_mask"]] = int(side_colors[side])
+        if not _safe_paste(inner, patch, r0, c0):
