    c0 = min(b[1] for b in bbs)
    r1 = max(b[2] for b in bbs)
    c1 = max(b[3] for b in bbs)
    return int(r0), int(c0), int(r1), int(c1)


def bbox_h(b: BBox) -> int:
    r0, _c0, r1, _c1 = b
