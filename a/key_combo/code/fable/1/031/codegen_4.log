+        if np.any(used[r0 : r1 + 1, c0 : c1 + 1]):
+            rejected.append(bridge)
+            continue
+        used[r0 : r1 + 1, c0 : c1 + 1] = True
+        accepted.append(bridge)
+    return accepted, rejected
+
+
+def main(grid: np.ndarray) -> np.ndarray:
