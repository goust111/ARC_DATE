+    patch[pad_t : pad_t + top_h, v_c0 : v_c0 + v_rect_w] = vertical_color
+    b_r0 = pad_t + top_h + v_gap
+    patch[b_r0 : b_r0 + bottom_h, v_c0 : v_c0 + v_rect_w] = vertical_color
