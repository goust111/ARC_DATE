+import random
+
+import numpy as np
+
+
+DEFECT_COLOR = 2
+UNKNOWN_COLOR = -1
+BASE_COLOR_PAIRS = [
+    (0, 4),
+    (0, 6),
+    (0, 8),
+    (1, 3),
+    (1, 7),
