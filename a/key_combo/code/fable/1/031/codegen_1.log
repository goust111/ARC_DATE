+    h, w = shape
+    rect_h = _rand_span(h_range, h)
+    rect_w = _rand_span(w_range, w)
+    r0 = random.randint(0, h - rect_h)
+    c0 = random.randint(0, w - rect_w)
+    return r0, c0, r0 + rect_h, c0 + rect_w
