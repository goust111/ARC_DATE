+    r0, c0, r1, c1 = rect
+    mask[r0:r1, c0:c1] = True
+
+
+def _rand_span(span_range: tuple[int, int], limit: int) -> int:
+    low, high = span_range
+    low = min(low, limit)
+    high = min(high, limit)
+    return random.randint(low, high)
+
+
+def _sample_covering_rect(
+    shape: tuple[int, int],
+    center: tuple[int, int],
+    h_range: tuple[int, int],
+    w_range: tuple[int, int],
