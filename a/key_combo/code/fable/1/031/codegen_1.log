+    rect_w = _rand_span(w_range, w)
+    r0 = random.randint(max(0, center[0] - rect_h + 1), min(center[0], h - rect_h))
+    c0 = random.randint(max(0, center[1] - rect_w + 1), min(center[1], w - rect_w))
+    return r0, c0, r0 + rect_h, c0 + rect_w
