+    assert completions, "no center pair matches the visible pattern"
+    assert len(completions) == 1, "ambiguous dual-center completion"
+
+    out = g.copy()
+    full = completions[0]
+    occluded = g == Color.GREY
+    out[occluded] = full[occluded]
+    return out
+
