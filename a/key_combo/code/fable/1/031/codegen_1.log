+    h, w = mask.shape
+    r0, c0, r1, c1 = rect
+    return not mask[
+        max(0, r0 - margin) : min(h, r1 + margin),
+        max(0, c0 - margin) : min(w, c1 + margin),
+    ].any()
+
+
