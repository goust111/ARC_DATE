import random, numpy as np
BLACK,YELLOW,GREY=0,4,5


def parity_on(coords, center):
    return (np.maximum(np.abs(coords[:,0]-center[0]), np.abs(coords[:,1]-center[1])) & 1).astype(np.uint8)

def full_pattern(h,w,a,b):
    rr=np.arange(h)[:,None]
    cc=np.arange(w)[None,:]
    pa=(np.maximum(np.abs(rr-a[0]), np.abs(cc-a[1])) & 1)
    pb=(np.maximum(np.abs(rr-b[0]), np.abs(cc-b[1])) & 1)
    return np.where(pa==pb, YELLOW, BLACK).astype(int)

def all_completions(grid):
    h,w=grid.shape
    centers=np.array([(r,c) for r in range(h) for c in range(w)], dtype=int)
    vis=np.argwhere(grid"'!=GREY)
    if len(vis)==0:
        return []
    need=(grid[grid!=GREY]==BLACK).astype(np.uint8)
    P=np.maximum(np.abs(centers[:,None,0]-vis[None,:,0]), np.abs(centers[:,None,1]-vis[None,:,1])) & 1
    d={row.tobytes(): [] for row in P}
    for i,row in enumerate(P):
        d[row.tobytes()].append(i)
    outs=[]
    seen=set()
    for i,row in enumerate(P):
        key=np.bitwise_xor(row, need).tobytes()
        for j in d.get(key, []):
            if j<=i: continue
            rr=np.arange(h)[:,None]
            cc=np.arange(w)[None,:]
            pa=(np.maximum(np.abs(rr-centers[i,0]), np.abs(cc-centers[i,1])) & 1)
            pb=(np.maximum(np.abs(rr-centers[j,0]), np.abs(cc-centers[j,1])) & 1)
            out=np.where(pa==pb,YELLOW,BLACK).astype(int)
            outs.append(((tuple(centers[i]), tuple(centers[j])), out))
    return outs

def unique_completion(grid):
    comps=all_completions(grid)
    if not comps: return False,0,0
    uniq={out.tobytes() for _,out in comps}
    return len(uniq)==1, len(comps), len(uniq)


