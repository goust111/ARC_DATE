+def _render_attempt() -> tuple[np.ndarray, np.ndarray] | None:
+    size = random.choice(SIZE_CHOICES)
+    count = random.choice(COUNT_CHOICES)
+    gaps = [random.randint(*GAP_RANGE) for _ in range(count - 1)]
+    copy_span = count * size + sum(gaps)
