+    visited = np.zeros((h, w), dtype=bool)
+    out: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == bg or visited[r, c]:
+                continue
+
+            visited[r, c] = True
+            stack = [(r, c)]
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in neighbors:
+                    nr = rr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not visited[nr, nc] and int(grid[nr, nc]) == color:
+                        visited[nr, nc] = True
+                        stack.append((nr, nc))
