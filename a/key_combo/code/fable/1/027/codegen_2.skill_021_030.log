+    extra_w = random.randint(0, min(2, 30 - base_w))
+    top_extra = random.randint(0, extra_h)
+    left_extra = random.randint(0, extra_w)
+    row_shift = -min_r + top_extra
+    col_shift = -min_c + left_extra
