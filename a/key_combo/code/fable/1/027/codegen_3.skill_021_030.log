+def _has_order_dependent_conflict(
+    panels: list[np.ndarray], base: int, tag_pos: tuple[int, int]
+) -> bool:
+    h, w = panels[0].shape
+    for r in range(h):
+        for c in range(w):
+            if (r, c) == tag_pos:
+                continue
+            colors = {int(panel[r, c]) for panel in panels if int(panel[r, c]) != int(base)}
+            if len(colors) >= 2:
