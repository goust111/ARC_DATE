+def _random_hline(h: int, w: int) -> list[tuple[int, int]]:
+    length = random.randint(2, w - 2)
+    r = random.randint(1, h - 2)
+    c0 = random.randint(1, w - length - 1)
+    return [(r, c) for c in range(c0, c0 + length)]
