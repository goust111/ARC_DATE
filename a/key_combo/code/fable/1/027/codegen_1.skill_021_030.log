+    mask = np.ones(grid.shape, dtype=bool)
+    mask[0, :] = False
+    mask[-1, :] = False
+    mask[:, wall_cols] = False
+    colors = sorted(set(map(int, grid[mask])) - {BLACK})
+    assert len(colors) == 1
+    return int(colors[0])
+
