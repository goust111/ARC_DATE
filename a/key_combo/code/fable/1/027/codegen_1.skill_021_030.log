+    step = int(steps[0])
+    assert step >= 4
+    assert wall_cols == list(range(0, w, step))
+
+    panels = [g[:, wall_cols[i] : wall_cols[i + 1] + 1].copy() for i in range(len(wall_cols) - 1)]
+    return panels, wall_cols
