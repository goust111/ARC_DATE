  20: def main(grid: np.ndarray) -> np.ndarray:
  21:     """Recover the rectangular green mask from the unique visible symmetric copies.
  22: 
  23:     Input structure
  24:     - The input is a square grid whose non-mask pattern is symmetric under the
  25:       rotations and reflections of the square.
  26:     - Color 3 forms one solid rectangular mask over the hidden part of the
  27:       pattern.
  28: 
  29:     Rule
  30:     - Return a grid with the same shape as the mask's bounding box.
  31:     - For each masked cell, inspect every rotation/reflection-equivalent
  32:       coordinate and ignore any masked cells; the remaining visible colors must
  33:       agree, and that unique color is emitted at the same relative position.
  34: 
  35:     Key insight
  36:     - The green rectangle is damage in an otherwise dihedrally symmetric pattern,
  37:       so each hidden pixel can be reconstructed from its visible symmetric twins.
  38:     """
  39:     g = np.asarray(grid, dtype=int)
  40:     assert g.ndim == 2
  41:     h, w = g.shape
  42:     assert h == w
  43: 
  44:     mask = g == 3
  45:     b = bbox(mask)
  46:     assert b is not None
  47:     r0, c0, r1, c1 = b
  48:     rect = mask[r0 : r1 + 1, c0 : c1 + 1]
  49:     assert bool(np.all(rect))
  50:     assert int(mask.sum()) == int(rect.size)
  51:     assert len(components_mask(mask, connectivity=4)) == 1
  52: 
  53:     out = np.empty((r1 - r0 + 1, c1 - c0 + 1), dtype=int)
  54:     for r in range(r0, r1 + 1):
  55:         for c in range(c0, c1 + 1):
  56:             visible = []
  57:             for rr, cc in _symmetry_coords(r, c, h):
  58:                 color = int(g[rr, cc])
  59:                 if color != 3:
  60:                     visible.append(color)
  61:             assert visible
  62:             unique = set(visible)
  63:             assert len(unique) == 1
  64:             out[r - r0, c - c0] = unique.pop()
  65: 
  66:     return out
