+    inp = np.full((grid_h, grid_w), bg, dtype=int)
+    inp[blob_r0 : blob_r0 + blob.shape[0], blob_c0 : blob_c0 + blob.shape[1]] = blob
+
+    for slot, item in slot_to_item.items():
