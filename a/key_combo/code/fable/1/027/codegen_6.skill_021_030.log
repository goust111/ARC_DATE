+def _find_blob_and_holes(grid: np.ndarray) -> tuple[int, dict, list[dict], list[dict]]:
+    g = np.asarray(grid, dtype=int)
+    bg = _get_bg(g)
+    comps = _monochrome_components(g, bg)
+    assert comps
