+    (3, 3, (2, 1, 1)),
+    (3, 3, (2, 1, 2)),
+    (3, 4, (1, 3, 1)),
+    (4, 3, (1, 1, 1, 2)),
+    (4, 4, (1, 1, 2, 2)),
