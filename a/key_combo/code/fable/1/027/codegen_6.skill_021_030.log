+                union = hole_cells | shifted
+                rs = [r for r, _ in union]
+                cs = [c for _, c in union]
+                bbox_area = (max(rs) - min(rs) + 1) * (max(cs) - min(cs) + 1)
+                if bbox_area == total_area:
