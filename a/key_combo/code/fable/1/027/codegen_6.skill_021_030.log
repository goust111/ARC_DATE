+def _complement_match(hole_mask: np.ndarray, piece_mask: np.ndarray) -> bool:
+    hole_cells = {(int(r), int(c)) for r, c in np.argwhere(hole_mask)}
+    hole_h, hole_w = hole_mask.shape
