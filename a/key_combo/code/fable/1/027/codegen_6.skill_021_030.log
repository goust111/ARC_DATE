import itertools, numpy as np


def normalize(mask):
    ys,xs=np.where(mask)
    return mask[ys.min():ys.max()+1,xs.min():xs.max()+1]

def stair_pair(H,W,widths):
    hole=np.zeros((H,W),dtype=bool)
    for r,w in enumerate(widths):
        hole[r,:w]=1
    piece=~hole
    return normalize(hole), normalize(piece)

def rotations(mask):
    return {np.rot90(mask,k).tobytes()+str(np.rot90(mask,k).shape).encode() for k in range(4)}

def complement_match(a_mask, b_mask):
    aset0 = {(int(r), int(c)) for r, c in np.argwhere(a_mask)}
    area = int(a_mask.sum() + b_mask.sum())
    ha, wa = a_mask.shape
    for k in range(4):
        b = np.rot90(b_mask, k)
        b_cells = [(int(r), int(c)) for r, c in np.argwhere(b)]
        hb, wb = b.shape
        for dr in range(-hb, ha + 1):
            for dc in range(-wb, wa + 1):
                shifted = {(r + dr, c + dc) for r, c in b_cells}
                if aset0 & shifted:
                    continue
                all_cells = aset0 | shifted
                rs = [r for r, _ in all_cells]
                cs = [c for _, c in all_cells]
                bbox_area = (max(rs) - min(rs) + 1) * (max(cs) - min(cs) + 1)
                if bbox_area == area:
                    return True
    return False

cands=[]
seen=set()
for H in range(3,6):
  for W in range(3,6):
    for widths in itertools.product(range(1,W), repeat=H):
      if len(set(widths))==1:
        continue
      hole,piece=stair_pair(H,W,widths)
      if hole.sum()==piece.sum() and piece.tobytes()+str(piece.shape).encode() in rotations(hole):
        continue
      # keep only moderate sizes for visibility / packing
      if not (4 <= int(hole.sum()) <= 10 and 4 <= int(piece.sum()) <= 10):
        continue
      key=(min(rotations(hole)), min(rotations(piece)))
      if key in seen:
        continue
      seen.add(key)
      cands.append((H,W,widths,hole,piece,int(hole.sum()),int(piece.sum())))
# sort by area variety
cands.sort(key=lambda t:(t[6], t[5], t[0]*t[1], t[2]))
N=len(cands)
mat=[[complement_match(cands[i][3], cands[j][4]) for j in range(N)] for i in range(N)]
# greedily / backtracking find large set with diagonal-only property
best=[]

def dfs(start, chosen):
    global best
    if len(chosen) > len(best):
        best = chosen[:]
    for i in range(start, N):
        ok=True
        for j in chosen:
            if mat[i][j] or mat[j][i]:
                ok=False
                break
        if not ok:
            continue
        # also self must match own piece
        if not mat[i][i]:
            continue
        chosen.append(i)
        dfs(i+1, chosen)
        chosen.pop()

dfs(0, [])
print('best size',len(best))
for idx in best[:20]:
    H,W,widths,h,p,ha,pa=cands[idx]
    print('idx',idx,'spec',H,W,widths,'ha',ha,'pa',pa,'hshape',h.shape,'pshape',p.shape)
    print(h.astype(int)); print('piece'); print(p.astype(int)); print()
# find subset of size >=8 with repeated piece area and variety
sel=best[:12]
print('piece areas', [cands[i][6] for i in sel])
