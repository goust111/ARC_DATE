from importlib.machinery import SourceFileLoader
from collections import Counter, deque
from pathlib import Path
import numpy as np

p = Path('/home/lixinyu/snap/a/key_combo/code/fable/1/027/5.py')
mod = SourceFileLoader('arc_semantics', str(p)).load_module()
DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]

def bg(grid):
    return Counter(map(int, grid.ravel())).most_common(1)[0][0]

def neighbors4(r, c):
    return [(r-1,c),(r+1,c),(r,c-1),(r,c+1)]

def find_components(grid, background):
    h, w = grid.shape
    seen = np.zeros((h, w), dtype=bool)
    comps = []
    for sr in range(h):
        for sc in range(w):
            if seen[sr, sc] or int(grid[sr, sc]) == background:
                continue
            q = deque([(sr, sc)])
            seen[sr, sc] = True
            coords = []
            while q:
                r, c = q.popleft()
                coords.append((r, c))
                for nr, nc in neighbors4(r, c):
                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) "'!= background:
                        seen[nr, nc] = True
                        q.append((nr, nc))
            arr = np.array(coords, dtype=int)
            r0, c0 = arr.min(axis=0)
            r1, c1 = arr.max(axis=0)
            comps.append({
                '"'bbox': (int(r0), int(c0), int(r1), int(c1)),
                'patch': grid[int(r0):int(r1)+1, int(c0):int(c1)+1].copy(),
                'coords': {tuple(map(int, cell)) for cell in coords},
            })
    return comps

def center(box):
    r0, c0, r1, c1 = box
    h = r1 - r0 + 1
    w = c1 - c0 + 1
    assert h % 2 == 1 and w % 2 == 1
    return ((r0 + r1)//2, (c0 + c1)//2)

def direction_and_distance(pivot, ctr):
    dr = ctr[0] - pivot[0]
    dc = ctr[1] - pivot[1]
    assert (dr == 0) "'^ (dc == 0)
    if dr < 0:
        return 0, -dr
    if dc > 0:
        return 1, dc
    if dr > 0:
        return 2, dr
    return 3, -dc

def rotate_patch(patch, delta):
    return np.rot90(patch, -1 if delta == 1 else 1)

for i in range(100):
    inp = mod.generate_input()
    out = mod.main(inp)
    background = bg(inp)
    counts = Counter(map(int, inp.ravel()))
    pivot_colors = [c for c, n in counts.items() if c != background and n == 1]
    assert len(pivot_colors) == 1
    pivot = tuple(map(int, np.argwhere(inp == pivot_colors[0])[0]))

    work = inp.copy()
    work[pivot] = background
    in_comps = find_components(work, background)
    assert len(in_comps) == 3
    items = []
    for comp in in_comps:
        ctr = center(comp['"'bbox'])
        dir_idx, dist = direction_and_distance(pivot, ctr)
        items.append((dist, dir_idx, comp))
    items.sort(key=lambda x: x[0])
    d0, d1, d2 = [item[0] for item in items]
    assert d1 - d0 == d2 - d1 and d1 > d0
    step = d1 - d0
    delta1 = (items[1][1] - items[0][1]) % 4
    delta2 = (items[2][1] - items[1][1]) % 4
    assert delta1 == delta2 and delta1 in (1, 3)
    delta = delta1
    assert np.array_equal(rotate_patch(items[0][2]['patch'], delta), items[1][2]['patch'])
    assert np.array_equal(rotate_patch(items[1][2]['patch'], delta), items[2][2]['patch'])

    out_work = out.copy()
    out_work[pivot] = background
    out_comps = find_components(out_work, background)
    assert len(out_comps) == 4
    preserved = 0
    new_comp = None
    in_coord_sets = [comp['coords'] for _, _, comp in items]
    for comp in out_comps:
        if comp['coords'] in in_coord_sets:
            preserved += 1
        else:
            assert new_comp is None
            new_comp = comp
    assert preserved == 3 and new_comp is not None

    last_dist, last_dir, last_comp = items[-1]
    expected_patch = rotate_patch(last_comp['patch'], delta)
    expected_dir = (last_dir + delta) % 4
    expected_dist = last_dist + step
    assert np.array_equal(new_comp['patch'], expected_patch)
    new_center = center(new_comp['bbox'])
    got_dir, got_dist = direction_and_distance(pivot, new_center)
    assert got_dir == expected_dir and got_dist == expected_dist
    assert np.array_equal(out[inp "'!= background], inp[inp != background])
print('"'semantic_checks', 100)
