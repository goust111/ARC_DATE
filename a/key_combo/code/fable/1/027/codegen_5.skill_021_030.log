+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+PALETTE = tuple(range(1, 10))
+DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]  # N, E, S, W
+MAX_GENERATION_ATTEMPTS = 600
+
+Coord = tuple[int, int]
+BBox = tuple[int, int, int, int]
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _bbox(mask: np.ndarray) -> BBox | None:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return None
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _crop_bbox(grid: np.ndarray, bbox: BBox) -> np.ndarray:
+    r0, c0, r1, c1 = bbox
+    return np.asarray(grid[r0 : r1 + 1, c0 : c1 + 1], dtype=int).copy()
+
+
+def _neighbors4(r: int, c: int) -> list[Coord]:
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+
+    for sr in range(h):
+        for sc in range(w):
+            if seen[sr, sc] or int(g[sr, sc]) == bg:
+                continue
+            q = deque([(sr, sc)])
+            seen[sr, sc] = True
+            coords: list[Coord] = []
+            while q:
+                r, c = q.popleft()
+                coords.append((int(r), int(c)))
+                for nr, nc in _neighbors4(r, c):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(g[nr, nc]) != bg:
