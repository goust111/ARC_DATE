+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+PALETTE = tuple(range(1, 10))
+DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]  # N, E, S, W
+MAX_GENERATION_ATTEMPTS = 600
+
+Coord = tuple[int, int]
