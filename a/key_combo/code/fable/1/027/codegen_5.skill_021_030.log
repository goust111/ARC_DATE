+
+def _rotation_cycle(sprite: np.ndarray, delta_dir: int) -> list[np.ndarray]:
+    patches = [np.asarray(sprite, dtype=int).copy()]
+    for _ in range(3):
+        patches.append(_rotate_patch(patches[-1], delta_dir))
