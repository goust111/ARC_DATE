+    return (r0 + r1) // 2, (c0 + c1) // 2
+
+
+def _direction_and_distance(pivot: Coord, center: Coord) -> tuple[int, int]:
+    dr = int(center[0] - pivot[0])
+    dc = int(center[1] - pivot[1])
+    assert (dr == 0) ^ (dc == 0), "copy center must lie on one cardinal ray"
