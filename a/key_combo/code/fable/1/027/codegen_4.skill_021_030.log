                grid,
                patch,
                transparent=separator,
                border=PANEL_BORDER,
                padding=PANEL_GAP,
                padding_connectivity=PADDING_CONNECTIVITY,
            )
        except ValueError:
            return None
        paste(grid, patch, r, c)
    return grid


