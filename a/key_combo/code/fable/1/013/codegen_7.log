  65:         offset = n * period
  66: 
  67:         _stamp_solid(out, original, r0 + offset, c0 + offset, bg)
  68:         _stamp_solid(out, original, r0 + offset, c0 - offset, bg)
  69: 
  70:         _stamp_solid(out, rotated, r0 + h + offset, c0 + w + offset, bg)
  71:         _stamp_solid(out, rotated, r0 + h + offset, c0 - h - offset, bg)
  72: 
