  24: def main(grid: np.ndarray) -> np.ndarray:
  25:     """
  26:     Extend the single rectangular bar into two diagonal zigzag chains, alternating the bar with its 90-degree rotated copy in the paired color.
  27: 
  28:     Input structure
  29:     - The grid has one background color and exactly one 4-connected monochrome foreground object.
  30:     - That foreground object is a solid non-square rectangle, either green or pink.
  31:     - The foreground rectangle's height and width define the alternating step period.
  32: 
  33:     Rule
  34:     - Keep copies of the original rectangle on both diagonals through the seed, with row and column offsets of height + width.
  35:     - Between every adjacent pair of same-diagonal original copies, place a 90-degree rotated rectangle in the other color.
  36:     - Continue the pattern across the whole canvas and clip any rectangle that crosses an edge.
  37: 
  38:     Key insight
  39:     - The two visible colors encode alternating orientations of the same bar along two crossing 45-degree zigzag paths; boundary fragments are just clipped copies.
  40:     """
  41:     g = np.asarray(grid, dtype=int)
  42:     bg = int(get_bg(g))
  43:     components = find_components(g, bg=bg, connectivity=4, monochromatic=True)
  44:     assert len(components) == 1, "expected one foreground bar"
  45: 
  46:     comp = components[0]
  47:     color = int(comp["color"])
  48:     assert color in (Color.GREEN, Color.PINK), "bar color must be green or pink"
  49: 
  50:     r0, c0, r1, c1 = comp["bbox"]
  51:     h = bbox_h(comp["bbox"])
  52:     w = bbox_w(comp["bbox"])
  53:     assert h != w, "seed bar must be non-square"
  54:     assert int(comp["area"]) == h * w, "seed bar must be a solid rectangle"
  55:     assert np.all(g[r0 : r1 + 1, c0 : c1 + 1] == color), "seed bbox must be solid"
  56: 
  57:     other = Color.PINK if color == Color.GREEN else Color.GREEN
  58:     original = np.full((h, w), color, dtype=int)
  59:     rotated = np.full((w, h), other, dtype=int)
  60:     out = np.full_like(g, bg)
  61: 
  62:     period = h + w
  63:     limit = g.shape[0] + g.shape[1] + period + 2
