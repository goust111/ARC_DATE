+        obstacle_mask,
+        hidden_events={},
+        add_markers=False,
+    )
+    for c, step in hidden_events.items():
+        out[0 if step > 0 else g.shape[0] - 1, int(c)] = MARKER
+    return out
+
+
+def _offset_profile(width: int, hidden_events: dict[int, int]) -> np.ndarray:
+    offsets = np.zeros(width, dtype=int)
+    running = 0
