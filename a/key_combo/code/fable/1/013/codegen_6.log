+    path_rows = []
+    cols = np.arange(width, dtype=int)
+    for source_row in source_rows:
+        rows = _simulate_one_path(int(source_row), obstacle_mask, hidden_events=hidden_events)
+        assert not obstacle_mask[rows, cols].any()
