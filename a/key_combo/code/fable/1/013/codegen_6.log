+    row_matrix = _extract_path_rows(g)
+    hidden_events = _hidden_events_from_rows(row_matrix)
+    source_rows = row_matrix[:, 0].copy()
+    obstacle_mask = g == OBSTACLE
+
+    out, _ = _render_world(
