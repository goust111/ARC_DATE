+def _random_symmetric_mask() -> np.ndarray:
+    for _ in range(200):
+        h = int(RNG.integers(2, 6))
+        w = int(RNG.integers(2, 6))
+        half_w = (w + 1) // 2
+        max_area = h * half_w
+        area = int(RNG.integers(max(2, half_w), max_area + 1))
