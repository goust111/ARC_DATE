+    pairs: list[tuple[dict, dict]] = []
+    for i in left_ids:
+        if len(left_edges[i]) != 1:
+            continue
+        j = left_edges[i][0]
+        if len(right_edges[j]) == 1:
+            pairs.append((objects[i], objects[j]))
+    pairs.sort(key=lambda pair: (pair[0]["bbox"][0], pair[0]["bbox"][1]))
