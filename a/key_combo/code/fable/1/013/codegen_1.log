+from __future__ import annotations
+
+from collections import Counter
+import random
+
+import numpy as np
+
+
+BG = 0
+GREEN = 3
+PINK = 6
+CYAN = 8
+PALETTE_COLORS = (1, 2, 4, 5, 7, 9)
+DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+CORNERS = (
+    ((0, 0), (1, 1)),
+    ((0, -1), (1, -1)),
+    ((-1, 0), (-1, 1)),
+    ((-1, -1), (-1, -1)),
+)
+GEN_RETRY_LIMIT = 400
+
+
