+                "color": color,
+                "turn_cell": seg_cells[-1],
+                "d_idx": d_idx,
+            }
+            return [head] + sub
+
+    return None
+
+
+def _start_candidates(
+    shape: tuple[int, int], corner_idx: int, palette_len: int
