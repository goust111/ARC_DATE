+    out = grid.copy()
+    for idx, (r, c) in enumerate(visited):
+        out[r, c] = int(palette[idx][2])
+    return out
+
+
+def _generate_candidate() -> np.ndarray | None:
+    h = random.randint(16, 26)
+    w = random.randint(16, 26)
