+    dr, dc = DIRS[int(d_idx)]
+    while True:
+        r += dr
+        c += dc
+        if not _in_bounds(grid.shape, r, c):
+            return None
+        if int(grid[r, c]) != bg:
+            return int(r), int(c)
+
