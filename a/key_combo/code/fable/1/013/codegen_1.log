+    for orow, ocol in others:
+        if max(abs(r - orow), abs(c - ocol)) <= min_gap:
+            return False
+    return True
+
+
+def _expected_output(
+    grid: np.ndarray, visited: list[tuple[int, int]], palette: list[tuple[int, int, int]]
