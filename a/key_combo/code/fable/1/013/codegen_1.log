+def _trace_ray(grid: np.ndarray) -> tuple[list[tuple[int, int]], set[tuple[int, int]]]:
+    g = np.asarray(grid, dtype=int)
+    bg = _get_bg(g)
+    start = _single_coord(g == GREEN)
+    d_idx = _initial_direction(g, start, bg)
