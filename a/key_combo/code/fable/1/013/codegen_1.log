+        if value == PINK:
+            visited.append((int(nr), int(nc)))
+            d_idx = (d_idx + 1) % 4
+            continue
+        if value == CYAN:
+            visited.append((int(nr), int(nc)))
+            d_idx = (d_idx - 1) % 4
+            continue
