+    top_dir = -1 if top_color == left_color else 1
+
+    pair_options = _center_pair_column_options(center_bottom_mask, bottom_dir, center_top_mask, top_dir, w)
+    left_options = _side_column_options(left_side_mask, 1, w, prefer_right_half=False)
+    right_options = _side_column_options(right_side_mask, -1, w, prefer_right_half=True)
+    if not pair_options or not left_options or not right_options:
