+        assert np.all(coords[:, 1] > 0) and np.all(coords[:, 1] < g.shape[1] - 1)
+        assert not np.any(occupied[coords[:, 0], coords[:, 1]])
+        out[coords[:, 0], coords[:, 1]] = int(obj["color"])
+        occupied[coords[:, 0], coords[:, 1]] = True
