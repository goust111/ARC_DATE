+        for cb in range(lo_b, hi_b + 1):
+            overlap = min(ca + mask_a.shape[1] - 1, cb + mask_b.shape[1] - 1) - max(ca, cb) + 1
+            if overlap < overlap_need:
+                continue
+            score = abs((ca + cb) / 2 - center) + abs(ca - cb) * 0.2
+            pairs.append((float(score), int(ca), int(cb)))
