+    right_side_mask = _random_solid_mask(rng, (2, 4), (2, 4))
+
+    bottom_color = int(left_color if rng.random() < 0.5 else right_color)
+    top_color = int(right_color if bottom_color == left_color else left_color)
+    bottom_dir = -1 if bottom_color == left_color else 1
+    top_dir = -1 if top_color == left_color else 1
+
+    pair_cols = _pick_center_pair_columns(
+        rng,
+        center_bottom_mask,
+        bottom_dir,
+        center_top_mask,
+        top_dir,
+        w,
+    )
+    if pair_cols is None:
+        return None
+    bottom_c0, top_c0 = pair_cols
+
+    left_floor_c0 = _pick_side_column(rng, left_side_mask, 1, w, prefer_right_half=False)
+    right_floor_c0 = _pick_side_column(rng, right_side_mask, -1, w, prefer_right_half=True)
+    if left_floor_c0 is None or right_floor_c0 is None:
