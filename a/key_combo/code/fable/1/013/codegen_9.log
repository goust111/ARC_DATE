+def _shear_coords(coords: np.ndarray, direction: int) -> tuple[np.ndarray, int]:
+    bottom = int(coords[:, 0].max())
+    sheared = coords.copy()
+    sheared[:, 1] = coords[:, 1] + direction * (bottom - coords[:, 0])
+    return sheared, bottom
