+    occupied = np.zeros((h, w), dtype=bool)
+    bottom_row_lo = max(3, h // 2 - 1)
+    bottom_row_hi = h - center_bottom_mask.shape[0] - 3
+    if bottom_row_lo > bottom_row_hi:
