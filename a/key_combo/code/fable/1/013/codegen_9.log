+def _extract_scene(grid: np.ndarray) -> tuple[int, int, int, int, list[dict]]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    assert h >= 5 and w >= 5
+
+    left_color = int(g[0, 0])
+    right_color = int(g[0, w - 1])
