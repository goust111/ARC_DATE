+def _random_rectangle_mask(
+    rng: np.random.Generator,
+    height_range: tuple[int, int],
+    width_range: tuple[int, int],
+) -> np.ndarray:
+    h = int(rng.integers(height_range[0], height_range[1] + 1))
+    w = int(rng.integers(width_range[0], width_range[1] + 1))
