+    left_color = int(g[0, 0])
+    right_color = int(g[0, w - 1])
+    floor_color = int(Counter(map(int, g[h - 1, :])).most_common(1)[0][0])
+
+    assert left_color != right_color
+    assert np.all(g[:-1, 0] == left_color)
+    assert np.all(g[:-1, w - 1] == right_color)
