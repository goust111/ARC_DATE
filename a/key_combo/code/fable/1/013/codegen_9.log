+                "color": int(obj["color"]),
+                "initial": obj["coords"].copy(),
+                "landed": landed,
+                "sheared": sheared,
+                "anchor_bottom": int(anchor_bottom),
+                "direction": int(direction),
+            }
+        )
+        occupied[landed[:, 0], landed[:, 1]] = True
+
+    return settled
+
+
+def _render_output(grid: np.ndarray) -> tuple[np.ndarray, list[dict]]:
