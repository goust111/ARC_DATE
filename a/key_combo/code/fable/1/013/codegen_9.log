+
+def _drop_coords(coords: np.ndarray, occupied: np.ndarray) -> np.ndarray:
+    h, _w = occupied.shape
+    drop = 0
+    while True:
+        shifted = coords + np.array([[drop + 1, 0]], dtype=int)
+        if np.any(shifted[:, 0] >= h):
+            break
+        if np.any(occupied[shifted[:, 0], shifted[:, 1]]):
