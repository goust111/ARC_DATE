+                    {"mask": center_top_mask, "color": top_color, "c0": top_c0},
+                    {"mask": left_side_mask, "color": right_color, "c0": left_floor_c0},
+                    {"mask": right_side_mask, "color": left_color, "c0": right_floor_c0},
