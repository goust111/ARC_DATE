+        if prefer_right_half and mid <= center:
+            continue
+        if not prefer_right_half and mid >= center:
+            continue
+        candidates.append(int(c0))
+    return candidates
+
+
+def _settle_specs_from_top(
+    specs: list[dict],
+    shape: tuple[int, int],
+    left_color: int,
+    right_color: int,
