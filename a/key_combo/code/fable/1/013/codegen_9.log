+        cc = int(c)
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                if (rr + dr, cc + dc) in bset:
+                    return True
+    return False
+
+
+def _valid_generated_scene(grid: np.ndarray) -> bool:
