+    top_row_hi = bottom_obj["bbox"][0] - center_top_mask.shape[0] - 2
+    top_obj = _sample_row(rng, center_top_mask, top_c0, 1, top_row_hi, occupied)
+    if top_obj is None:
+        return None
+    top_obj["color"] = top_color
