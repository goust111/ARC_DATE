+def _settle_specs_from_top(
+    specs: list[dict],
+    shape: tuple[int, int],
+    left_color: int,
+    right_color: int,
+) -> list[dict]:
+    h, w = shape
+    occupied = np.zeros((h, w), dtype=bool)
+    occupied[:, 0] = True
+    occupied[:, w - 1] = True
+    occupied[h - 1, :] = True
+
