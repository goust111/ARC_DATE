+def _can_place(coords: np.ndarray, occupied: np.ndarray) -> bool:
+    h, w = occupied.shape
+    for r, c in coords:
+        rr = int(r)
+        cc = int(c)
+        if not (0 <= rr < h and 0 <= cc < w):
+            return False
+        if occupied[rr, cc]:
+            return False
+        for nr in range(max(0, rr - 1), min(h, rr + 2)):
+            for nc in range(max(0, cc - 1), min(w, cc + 2)):
+                if occupied[nr, nc]:
