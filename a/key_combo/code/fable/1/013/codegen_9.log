+        settled.append(
+            {
+                "color": int(spec["color"]),
+                "c0": int(spec["c0"]),
+                "mask": spec["mask"],
+                "landed": landed,
+                "sheared": sheared,
+                "anchor_bottom": int(anchor_bottom),
+            }
+        )
+        occupied[landed[:, 0], landed[:, 1]] = True
+    return settled
+
+
+def _gen_attempt() -> np.ndarray | None:
