+def _touching_or_overlapping(a: np.ndarray, b: np.ndarray) -> bool:
+    bset = {tuple(map(int, xy)) for xy in b}
+    for r, c in a:
+        rr = int(r)
+        cc = int(c)
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                if (rr + dr, cc + dc) in bset:
+                    return True
