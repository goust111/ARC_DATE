+        return None
+    pairs.sort(key=lambda item: item[0])
+    shortlist = pairs[: min(12, len(pairs))]
+    _, ca, cb = shortlist[int(rng.integers(len(shortlist)))]
+    return ca, cb
+
+
+def _pick_side_column(
+    rng: np.random.Generator,
+    mask: np.ndarray,
+    direction: int,
+    width: int,
+    prefer_right_half: bool,
