+from __future__ import annotations
+
+from collections import Counter
+
+import numpy as np
+
+
+BG_COLOR = 0
+FLOOR_COLOR = 5
+WALL_PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+GEN_RETRIES = 400
+RNG = np.random.default_rng()
