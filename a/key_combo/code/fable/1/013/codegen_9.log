+            {
+                "color": int(spec["color"]),
+                "c0": int(spec["c0"]),
+                "mask": spec["mask"],
+                "landed": landed,
+                "sheared": sheared,
+                "anchor_bottom": int(anchor_bottom),
+            }
+        )
