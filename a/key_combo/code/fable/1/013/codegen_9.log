+    return True
+
+
+def _paint_occupied(occupied: np.ndarray, coords: np.ndarray) -> None:
+    occupied[coords[:, 0], coords[:, 1]] = True
+
+
+def _sample_row(
+    rng: np.random.Generator,
+    mask: np.ndarray,
+    c0: int,
+    row_lo: int,
+    row_hi: int,
+    occupied: np.ndarray,
