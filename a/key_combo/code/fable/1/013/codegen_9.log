+        return None
+    rows = list(range(int(row_lo), int(row_hi) + 1))
+    rng.shuffle(rows)
+    for r0 in rows:
+        obj = _object_from_mask(mask, 0, r0, c0)
+        if _can_place(obj["coords"], occupied):
