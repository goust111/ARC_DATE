+) -> tuple[int, int] | None:
+    lo_a, hi_a = _safe_start_bounds(mask_a, dir_a, width)
+    lo_b, hi_b = _safe_start_bounds(mask_b, dir_b, width)
+    if lo_a > hi_a or lo_b > hi_b:
+        return None
+
+    overlap_need = 2 if min(mask_a.shape[1], mask_b.shape[1]) >= 3 else 1
+    center = (width - 1) / 2
