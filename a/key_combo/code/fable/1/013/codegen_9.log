+    if lo > hi:
+        return None
+    center = width // 2
+    candidates = []
+    for c0 in range(lo, hi + 1):
+        mid = c0 + (mask.shape[1] - 1) / 2
+        if prefer_right_half and mid <= center:
+            continue
+        if not prefer_right_half and mid >= center:
+            continue
+        candidates.append(int(c0))
+    if not candidates:
+        return None
+    rng.shuffle(candidates)
+    return candidates[0]
+
