+        if np.min(coords[:, 1]) <= 1 or np.max(coords[:, 1]) >= w - 2:
+            return False
+
+    for i in range(len(settled)):
+        for j in range(i + 1, len(settled)):
+            if _touching_or_overlapping(settled[i]["sheared"], settled[j]["sheared"]):
+                return False
+
+    return True
+
+
+def _valid_settled_layout(
+    settled: list[dict],
+    shape: tuple[int, int],
+    left_color: int,
+    right_color: int,
+) -> bool:
