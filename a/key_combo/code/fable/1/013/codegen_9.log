+    if colors != {left_color, right_color}:
+        return False
+
+    bottoms = [int(obj["anchor_bottom"]) for obj in settled]
+    if not any(bottom == h - 2 for bottom in bottoms):
+        return False
+    if not any(bottom < h - 2 for bottom in bottoms):
+        return False
+
+    for obj in settled:
