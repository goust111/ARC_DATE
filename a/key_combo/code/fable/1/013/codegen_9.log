+def _object_from_mask(mask: np.ndarray, color: int, r0: int, c0: int) -> dict:
+    rel = np.argwhere(mask)
+    coords = rel + np.array([[int(r0), int(c0)]], dtype=int)
+    return {
+        "color": int(color),
+        "coords": coords.astype(int),
+        "bbox": bbox_coords(coords),
+        "shape": mask.copy(),
+    }
