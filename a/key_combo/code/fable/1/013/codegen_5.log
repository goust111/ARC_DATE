+    cropped_inp, cropped_out = _crop_with_margin(scene, expected)
+    if int(get_bg(cropped_inp)) != BG:
+        return None
+    if not np.array_equal(main(cropped_inp), cropped_out):
+        return None
+    return cropped_inp
