                                r0, r1 = sorted((corner_r, end_r))
                                cells = {(corner_r, tile_c, dr, dc) for tile_c in range(c0, c1 + 1)}
                                cells.update((tile_r, corner_c, dr, dc) for tile_r in range(r0, r1 + 1))
                                endpoints = (
