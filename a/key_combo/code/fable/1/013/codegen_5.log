+    _mask_from_rows("110", "011"),
+    _mask_from_rows("11", "11", "10"),
+    _mask_from_rows("101", "111"),
+    _mask_from_rows("011", "110", "010"),
+    _mask_from_rows("100", "110", "011"),
+    _mask_from_rows("111", "010", "010"),
