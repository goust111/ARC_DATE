# Tile lattice geometry.
TILE_COUNT_RANGE = (3, 5)
TILE_STRIDE, TILE_OFFSET, TILE_SIZE, INTERIOR_SIZE = 5, 1, 4, 2

# Marker group and segment bounds.
GROUP_COUNT_RANGE = (2, 4)
SEGMENT_LENGTH_MIN = 3
MAX_GENERATION_ATTEMPTS = 300

