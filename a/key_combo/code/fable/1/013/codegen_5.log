+def _build_shape_catalog() -> tuple[np.ndarray, ...]:
+    catalog: list[np.ndarray] = []
+    seen: set[tuple[tuple[int, int], bytes]] = set()
+    for mask in _RAW_SHAPES:
+        key = _canonical_shape_key(mask)
+        if key not in seen:
+            seen.add(key)
+            catalog.append(mask.copy())
