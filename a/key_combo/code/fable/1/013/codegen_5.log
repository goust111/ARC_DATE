+    frame_bbox = (frame_r0, frame_c0, frame_r0 + frame_h - 1, frame_c0 + frame_w - 1)
+    sample_box = (frame_r0 + 1, frame_c0 + 1, frame_r0 + frame_h - 2, frame_c0 + frame_w - 2)
