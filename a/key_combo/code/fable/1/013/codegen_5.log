+def _component_mask(comp: dict) -> np.ndarray:
+    r0, c0, r1, c1 = map(int, comp["bbox"])
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    rel = np.asarray(comp["coords"], dtype=int) - np.array([r0, c0])
+    mask[rel[:, 0], rel[:, 1]] = True
+    return mask
