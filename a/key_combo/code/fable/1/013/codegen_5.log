+            src_r1 = h - max(0, dr)
+            src_c0 = max(0, -dc)
+            src_c1 = w - max(0, dc)
+            dst_r0 = max(0, dr)
+            dst_r1 = h - max(0, -dr)
+            dst_c0 = max(0, dc)
+            dst_c1 = w - max(0, -dc)
