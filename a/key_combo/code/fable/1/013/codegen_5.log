+def _random_dihedral(mask: np.ndarray) -> np.ndarray:
+    transformed = np.rot90(np.asarray(mask, dtype=bool), random.randrange(4))
+    if random.random() < 0.5:
+        transformed = np.fliplr(transformed)
+    return transformed.copy()
