+        cut_positions = sorted(int(v) for v in rng.choice(stop_pos, size=requested_cuts, replace=False))
+    else:
+        stop_pos = None
+        cut_positions = sorted(int(v) for v in rng.choice(n_bars, size=requested_cuts, replace=False))
