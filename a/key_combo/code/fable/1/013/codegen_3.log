+def _extract_scene(grid: np.ndarray) -> tuple[dict, list[dict], np.ndarray]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2 and max(g.shape) <= 30
+    assert np.all(g[:-1] >= 0) and np.all(g[-1] >= 0)
