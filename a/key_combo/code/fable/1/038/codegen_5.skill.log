+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+
+
+def _find_separator_row(grid: np.ndarray) -> int:
+    rows = np.where(np.all(grid == YELLOW, axis=1))[0]
+    assert len(rows) == 1, "expected exactly one full yellow separator row"
+    return int(rows[0])
