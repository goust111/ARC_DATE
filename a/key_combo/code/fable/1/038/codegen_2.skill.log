+        inp, offset_a, offset_b = placed
+        global_boxes_a = [_shift_box(box, offset_a[0], offset_a[1]) for box in boxes_a]
+        global_boxes_b = [_shift_box(box, offset_b[0], offset_b[1]) for box in boxes_b]
