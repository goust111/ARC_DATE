+from __future__ import annotations
+
+from collections import Counter, defaultdict
+import random
+
+import numpy as np
+
+
+BBox = tuple[int, int, int, int]
+
+_CORNER_PATTERNS = {
+    ((0, 0), (0, 1), (1, 0)): "TL",
+    ((0, 0), (0, 1), (1, 1)): "TR",
+    ((0, 0), (1, 0), (1, 1)): "BL",
+    ((0, 1), (1, 0), (1, 1)): "BR",
+}
+_ROLES = ("TL", "TR", "BL", "BR")
+
+_GEN_BG = 0
+_GEN_COLORS = list(range(1, 10))
+_GEN_DEPTHS = (2, 3)
+_GEN_RETRY_LIMIT = 400
+_GEN_SYSTEM_RETRIES = 200
+_GEN_MAX_PATCH_SIDE = 13
+_GEN_MIN_GAP = 2
+_GEN_MAX_GAP = 4
+_GEN_BORDER = 1
