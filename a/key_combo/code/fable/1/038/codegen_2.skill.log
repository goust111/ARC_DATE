+def _build_expected(
+    shape: tuple[int, int],
+    boxes_a: list[BBox],
+    boxes_b: list[BBox],
+    colors_a: list[int],
+    colors_b: list[int],
+) -> np.ndarray:
+    out = np.full(shape, _GEN_BG, dtype=int)
+    for depth in range(len(boxes_a)):
+        _paint_frame(out, boxes_a[depth], colors_b[depth])
+        _paint_frame(out, boxes_b[depth], colors_a[depth])
+    return out
