+
+def _extract_frames(grid: np.ndarray, bg: int) -> list[dict[str, object]]:
+    frames: list[dict[str, object]] = []
+    corner_points: dict[int, dict[str, list[tuple[int, int]]]] = defaultdict(
+        lambda: {role: [] for role in _ROLES}
