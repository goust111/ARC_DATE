+
+def _render_expected(shape: tuple[int, int], specs: list[dict], bg: int) -> np.ndarray:
+    out = _render_input(shape, specs, bg)
+    for spec in specs:
+        _paint_mask(out, spec["copy_mask"], spec["copy_top_left"], spec["wire_color"])
+    return out
