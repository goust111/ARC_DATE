+from __future__ import annotations
+
+from collections import Counter
+import random
+
+import numpy as np
+
+
+DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]  # up, right, down, left
+DIR_TO_INDEX = {d: i for i, d in enumerate(DIRS)}
+SIDE_MID = {
+    (-1, 0): (0, 1),
+    (0, 1): (1, 2),
+    (1, 0): (2, 1),
+    (0, -1): (1, 0),
+}
+TOKEN_TOP_LEFT_OFFSET = {
+    (-1, 0): (1, -1),
+    (0, 1): (-1, -3),
+    (1, 0): (-3, -1),
+    (0, -1): (-1, 1),
+}
+GEN_CALLS = 0
