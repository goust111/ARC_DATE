+    r0, c0, r1, c1 = bbox
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for r, c in coords:
+        mask[r - r0, c - c0] = True
+    return mask
+
+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) == bg:
+                continue
+            color = int(grid[r, c])
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            bbox = _bbox_coords(coords)
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "cell_set": set(coords),
+                    "bbox": bbox,
+                    "mask": _component_mask(coords, bbox),
+                }
+            )
+    return comps
+
+
+def _is_rot_asymmetric(mask: np.ndarray) -> bool:
+    return all(not np.array_equal(mask, np.rot90(mask, k)) for k in (1, 2, 3))
+
+
+def _is_connected(mask: np.ndarray) -> bool:
+    cells = [tuple(map(int, p)) for p in np.argwhere(mask)]
+    if not cells:
+        return False
+    target = set(cells)
+    stack = [cells[0]]
+    seen = {cells[0]}
+    while stack:
+        r, c = stack.pop()
+        for nr, nc in _neighbors4(r, c):
+            if (nr, nc) in target and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                stack.append((nr, nc))
