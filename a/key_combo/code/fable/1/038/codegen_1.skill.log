+
+        rot = _rotation_from_dirs([(b[0] - a[0], b[1] - a[1]) for a, b in zip(path, path[1:])])
+        if rot != target_rot:
+            continue
+        rotated_mask = np.rot90(token_mask, -rot)
+        output_attach = (-end_heading[0], -end_heading[1])
+        if not rotated_mask[SIDE_MID[output_attach]]:
