+def _validate_specs(shape: tuple[int, int], specs: list[dict], bg: int) -> None:
+    h, w = shape
+    seen_input: set[tuple[int, int]] = set()
+    seen_reserve: set[tuple[int, int]] = set()
+
+    for spec in specs:
