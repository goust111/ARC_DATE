+
+def _attempt_generate(call_id: int) -> np.ndarray | None:
+    count_cycle = [2, 3, 4, 1]
+    count = count_cycle[call_id % len(count_cycle)] if random.random() < 0.65 else random.choice([1, 2, 3, 4])
