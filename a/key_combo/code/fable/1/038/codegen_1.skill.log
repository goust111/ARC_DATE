+    elif target_rot == 1:
+        base_choices = [[1], [-1, -1, -1]]
+    elif target_rot == 2:
+        base_choices = [[1, 1], [-1, -1]]
+    else:
+        base_choices = [[-1], [1, 1, 1]]
