+        col_lo, col_hi = -c0, w - 1 - c1
+        if row_lo > row_hi or col_lo > col_hi:
+            return None
+
+        placements = [
+            (random.randint(row_lo, row_hi), random.randint(col_lo, col_hi))
+            for _ in range(120)
+        ]
+        placements.extend(
+            [
+                (row_lo, col_lo),
+                (row_lo, col_hi),
+                (row_hi, col_lo),
+                (row_hi, col_hi),
+            ]
+        )
