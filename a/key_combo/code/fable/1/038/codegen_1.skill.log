+    for r, c in reserve_cells:
+        if not (0 <= r < h and 0 <= c < w):
+            return False
+        if blocked[r, c]:
+            return False
+    return True
+
+
+def _mark_blocked(reserve_cells: set[tuple[int, int]], blocked: np.ndarray) -> None:
+    h, w = blocked.shape
