+def _paint_mask(grid: np.ndarray, mask: np.ndarray, top_left: tuple[int, int], color: int) -> None:
+    r0, c0 = top_left
+    for r, c in np.argwhere(mask):
+        grid[r0 + int(r), c0 + int(c)] = int(color)
