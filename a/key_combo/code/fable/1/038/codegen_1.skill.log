+        reserve = path_set | token_cells | copy_cells
+        return {
+            "wire_path_local": path,
+            "token_mask": token_mask,
+            "token_top_local": token_top,
+            "copy_mask": rotated_mask,
+            "copy_top_local": copy_top,
+            "reserve_local": reserve,
