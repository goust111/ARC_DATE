+        copy_cells = _mask_cells(copy_mask, spec["copy_top_left"])
+        attach_start = (
+            spec["token_top_left"][0] + SIDE_MID[start_heading][0],
+            spec["token_top_left"][1] + SIDE_MID[start_heading][1],
+        )
+        attach_end = (
+            spec["copy_top_left"][0] + SIDE_MID[output_attach][0],
