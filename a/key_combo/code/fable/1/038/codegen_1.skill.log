+        input_cells = path_set | token_cells
+        reserve = input_cells | copy_cells
+        for r, c in reserve:
+            assert 0 <= r < h and 0 <= c < w
+        assert not (seen_input & input_cells)
+        assert not (seen_reserve & reserve)
+        seen_input |= input_cells
+        seen_reserve |= reserve
