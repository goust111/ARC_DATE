+            "color": comp["color"],
+            "cell_set": comp["cell_set"],
+            "neighbors": neighbors,
+            "endpoints": endpoints,
+            "endpoint_heading": {
+                ep: (neighbors[ep][0][0] - ep[0], neighbors[ep][0][1] - ep[1]) for ep in endpoints
