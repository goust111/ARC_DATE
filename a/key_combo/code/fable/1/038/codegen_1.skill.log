+    elif target_rot == 1:
+        base_choices = [[1], [-1, -1, -1]]
+    elif target_rot == 2:
+        base_choices = [[1, 1], [-1, -1]]
+    else:
+        base_choices = [[-1], [1, 1, 1]]
+
+    turns = list(random.choice(base_choices))
+    if len(turns) <= 2 and random.random() < 0.5:
+        pair = list(random.choice(([1, -1], [-1, 1])))
+        pos = random.randint(0, len(turns))
+        turns[pos:pos] = pair
+    if len(turns) > 4:
+        turns = turns[:4]
+    assert sum(turns) % 4 == target_rot
+    return turns
