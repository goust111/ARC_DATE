+        if not _is_rot_asymmetric(comp["mask"]):
+            continue
+        if not any(comp["mask"][cell] for cell in SIDE_MID.values()):
+            continue
+        token_ids.add(idx)
+        tokens.append(
+            {
+                "id": idx,
+                "color": comp["color"],
+                "bbox": comp["bbox"],
+                "mask": comp["mask"],
+                "cell_set": comp["cell_set"],
