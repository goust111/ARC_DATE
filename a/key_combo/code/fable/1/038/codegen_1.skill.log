+    local_objects = []
+    for obj_idx in range(count):
+        target_rot = forced_rot if obj_idx == 0 else random.randrange(4)
+        local = _make_local_object(target_rot, prefer_bent_zero=prefer_bent_zero and obj_idx == 0)
