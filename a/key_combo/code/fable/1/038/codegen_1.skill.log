+from __future__ import annotations
+
+from collections import Counter
+import random
+
+import numpy as np
+
+
+DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]  # up, right, down, left
+DIR_TO_INDEX = {d: i for i, d in enumerate(DIRS)}
+SIDE_MID = {
+    (-1, 0): (0, 1),
+    (0, 1): (1, 2),
+    (1, 0): (2, 1),
+    (0, -1): (1, 0),
+}
+TOKEN_TOP_LEFT_OFFSET = {
+    (-1, 0): (1, -1),
+    (0, 1): (-1, -3),
+    (1, 0): (-3, -1),
+    (0, -1): (-1, 1),
+}
+GEN_CALLS = 0
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.flat)).most_common(1)[0][0])
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _bbox_coords(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _component_mask(coords: list[tuple[int, int]], bbox: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = bbox
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for r, c in coords:
+        mask[r - r0, c - c0] = True
+    return mask
+
+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) == bg:
+                continue
+            color = int(grid[r, c])
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            bbox = _bbox_coords(coords)
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "cell_set": set(coords),
+                    "bbox": bbox,
+                    "mask": _component_mask(coords, bbox),
