+
+def generate_input() -> np.ndarray:
+    global GEN_CALLS
+    call_id = GEN_CALLS
+    GEN_CALLS += 1
+
+    for _ in range(500):
+        inp = _attempt_generate(call_id)
+        if inp is not None:
+            return inp
+    raise RuntimeError("failed to generate a valid wire-rotation transport instance")

