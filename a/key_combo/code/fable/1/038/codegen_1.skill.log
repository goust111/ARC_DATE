+            copy_top[0] + SIDE_MID[output_attach][0],
+            copy_top[1] + SIDE_MID[output_attach][1],
+        )
+        if path_set & copy_cells or token_cells & copy_cells:
+            continue
+        if not _only_attachment(copy_cells, path_set, attach_end, path[-1]):
+            continue
