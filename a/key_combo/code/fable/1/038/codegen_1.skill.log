+        degrees = {cell: len(nbrs) for cell, nbrs in neighbors.items()}
+        if len(comp["coords"]) < 2 or any(deg > 2 for deg in degrees.values()):
+            continue
+        endpoints = [cell for cell, deg in degrees.items() if deg == 1]
+        if len(endpoints) != 2:
