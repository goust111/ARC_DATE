+    bg = 0
+    _validate_specs(shape, specs, bg)
+    inp = _render_input(shape, specs, bg)
+    expected = _render_expected(shape, specs, bg)
+    assert np.array_equal(main(inp), expected), "solver should match the generator spec"
+    return inp
