+        matches = []
+        for heading, (lr, lc) in SIDE_MID.items():
+            if not token["mask"][lr, lc]:
+                continue
+            endpoint = (r0 + lr + heading[0], c0 + lc + heading[1])
+            wire = endpoint_to_wire.get(endpoint)
