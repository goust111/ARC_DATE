+
+def _can_place(reserve_cells: set[tuple[int, int]], blocked: np.ndarray) -> bool:
+    h, w = blocked.shape
+    for r, c in reserve_cells:
+        if not (0 <= r < h and 0 <= c < w):
+            return False
+        if blocked[r, c]:
