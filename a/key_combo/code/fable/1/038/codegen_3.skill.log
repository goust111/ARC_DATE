+    h, w = grey_mask.shape
+    for r, c in coords:
+        rr = int(r)
+        cc = int(c)
+        for nr, nc in _neighbors8(rr, cc):
+            if 0 <= nr < h and 0 <= nc < w and grey_mask[nr, nc]:
+                return True
+    return False
