+        cc = copy_c + int(sc)
+        if grid[rr, cc] == GREY:
+            grid[rr, cc] = int(sprite[int(sr), int(sc)])
+            residue_mask[rr, cc] = True
+    return residue_mask
+
+
+def _expected_output(grid: np.ndarray, sprite: np.ndarray, copy_r: int, copy_c: int) -> np.ndarray:
+    out = grid.copy()
+    paste(out, sprite, copy_r, copy_c, transparent=BLACK)
+    return out
+
+
