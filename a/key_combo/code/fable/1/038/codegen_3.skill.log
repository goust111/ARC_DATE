+        if residue_count < 3 or residue_count >= sprite_area:
+            continue
+
+        if orientation == "h" and len(np.unique(np.argwhere(residue_mask)[:, 0])) < 2:
+            continue
+        if orientation == "v" and len(np.unique(np.argwhere(residue_mask)[:, 1])) < 2:
+            continue
