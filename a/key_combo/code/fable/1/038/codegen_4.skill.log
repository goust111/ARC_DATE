import numpy as np, random
BLACK=0; GREY=5
PALETTE=[1,2,3,4,6,7,8,9]


def generate_legend():
    for _ in range(2000):
        n = random.choice([3,5])
        mid=n//2
        pointer_choices=[(r,c) for r in range(n) for c in range(n) if (r,c)"'!=(mid,mid) and max(abs(r-mid),abs(c-mid))==mid]
        pr,pc=random.choice(pointer_choices)
        target=random.randint(max(5,n+1), min(n*n-1, n+5))
        mask=np.zeros((n,n),dtype=bool)
        mask[mid,mid]=True
        mask[pr,pc]=True
        while mask.sum()<target:
            opts=set()
            for r,c in np.argwhere(mask):
                for dr in (-1,0,1):
                    for dc in (-1,0,1):
                        if dr==0 and dc==0: continue
                        rr,cc=int(r+dr),int(c+dc)
                        if 0<=rr<n and 0<=cc<n and not mask[rr,cc]:
                            opts.add((rr,cc))
            if not opts: break
            rr,cc=random.choice(list(opts))
            mask[rr,cc]=True
        if mask.sum()<5 or mask.sum()==n*n:
            continue
        colors=random.sample(PALETTE, random.randint(2,4))
        legend=np.zeros((n,n),dtype=int)
        legend[mid,mid]=colors[0]
        others=[tuple(x) for x in np.argwhere(mask) if tuple(x)!=(pr,pc) and tuple(x)!=(mid,mid)]
        if len(others)<2: continue
        for p in others:
            legend[p]=random.choice(colors)
        legend[pr,pc]=GREY
        if len(set(int(v) for v in legend.flat if v not in (0,5))) < 2:
            continue
        if any(np.array_equal(legend,np.rot90(legend,k)) for k in (1,2,3)):
            continue
        return legend
    raise RuntimeError


def simulate(legend,shape,anchor):
    H,W=shape
    out=np.zeros(shape,dtype=int)
    hist=np.zeros(shape,dtype=bool)
    stamps=[]
    n=legend.shape[0]
    mid=n//2
    steps=0
    a=anchor
    while steps<20:
        rot=np.rot90(legend, -(steps%4))
        coords=np.argwhere(rot!=BLACK)
        rr=coords[:,0]+a[0]-mid
        cc=coords[:,1]+a[1]-mid
        good=(rr>=0)&(rr<H)&(cc>=0)&(cc<W)
        out[rr[good],cc[good]]=rot[coords[good,0],coords[good,1]]
        mask=np.zeros(shape,dtype=bool)
        mask[rr[good],cc[good]]=True
        stamps.append(mask.copy())
        p=np.argwhere(rot==GREY)[0]
        nr=int(a[0]-mid+p[0]); nc=int(a[1]-mid+p[1])
        steps+=1
        if not (0<=nr<H and 0<=nc<W):
            return {'"'steps':steps,'reason':'out_of_bounds','mask':np.any(stamps,axis=0)}
        if hist[nr,nc]:
            return {'steps':steps,'reason':'overlap','mask':np.any(stamps,axis=0)}
        hist |= mask
        a=(nr,nc)
    return {'steps':steps,'reason':'cycle','mask':np.any(stamps,axis=0)}


def find_anchor(legend,shape,mode):
    H,W=shape
    anchors=[(r,c) for r in range(H) for c in range(W)]
    random.shuffle(anchors)
    for a in anchors:
        res=simulate(legend,shape,a)
        if res['reason']"'!=mode: continue
        if mode=='"'overlap' and res['steps']"'!=4: continue
        if mode=='"'out_of_bounds' and res['steps'] not in (2,3): continue
        return a,res
    return None,None


def frame_positions(shape,frame_side,stamp_mask,anchor):
    H,W=shape
    poss=[]
    ar,ac=anchor
    for r0 in range(0,H-frame_side+1):
        for c0 in range(0,W-frame_side+1):
            r1=r0+frame_side-1; c1=c0+frame_side-1
            if stamp_mask[r0:r1+1,c0:c1+1].any():
                continue
            # require at least 1-cell gap from stamp coverage
            rr0=max(0,r0-1); cc0=max(0,c0-1); rr1=min(H-1,r1+1); cc1=min(W-1,c1+1)
            if stamp_mask[rr0:rr1+1,cc0:cc1+1].any():
                continue
            if r0<=ar<=r1 and c0<=ac<=c1:
                continue
            # anchor not too far, and outside with gap 1+
            dr=0 if r0<=ar<=r1 else min(abs(ar-r0),abs(ar-r1))
            dc=0 if c0<=ac<=c1 else min(abs(ac-c0),abs(ac-c1))
            if max(dr,dc) < 2:
                continue
            if abs(ar-(r0+r1)/2)+abs(ac-(c0+c1)/2) > 20:
                continue
            poss.append((r0,c0))
    return poss

success=0
for t in range(100):
    for _ in range(200):
        legend=generate_legend(); shape=(random.randint(18,28),random.randint(18,28)); mode=random.choice(['overlap','out_of_bounds'])
        anchor,res=find_anchor(legend,shape,mode)
        if anchor is None: continue
        poss=frame_positions(shape, legend.shape[0]+2, res['mask'], anchor)
        if poss:
            success+=1
            break
print('success',success)
