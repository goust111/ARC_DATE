+        sprite[rr, cc] = int(random.choice(colors))
+
+    assert len(set(map(int, sprite[mask].tolist()))) >= 2
+    return sprite
+
+
+def _visibility_split(mask: np.ndarray) -> tuple[np.ndarray, np.ndarray] | None:
+    coords = np.argwhere(mask)
+    if len(coords) < 6:
