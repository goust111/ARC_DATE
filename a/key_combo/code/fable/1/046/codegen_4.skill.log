+
+BG = 0
+PALETTE = list(range(1, 10))
+MAX_ATTEMPTS = 400
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    values = np.asarray(grid, dtype=int).ravel()
+    return int(np.bincount(values).argmax())
+
+
+def _bbox_coords(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _crop_bbox(grid: np.ndarray, bbox: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = bbox
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _components(grid: np.ndarray, bg: int) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(g[r, c]) == bg:
+                continue
+            color = int(g[r, c])
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            touches_border = False
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                if rr == 0 or rr == h - 1 or cc == 0 or cc == w - 1:
+                    touches_border = True
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(g[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            bbox = _bbox_coords(coords)
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": bbox,
+                    "touches_border": touches_border,
+                    "patch": _crop_bbox(g, bbox),
+                }
+            )
+    return comps
+
+
+def _rect_sum(prefix: np.ndarray, r0: int, c0: int, r1: int, c1: int) -> int:
+    return int(
+        prefix[r1 + 1, c1 + 1]
+        - prefix[r0, c1 + 1]
+        - prefix[r1 + 1, c0]
+        + prefix[r0, c0]
+    )
+
+
+def _largest_background_rectangle(
+    grid: np.ndarray, bg: int
+) -> tuple[tuple[int, int, int, int], int]:
+    occ = (np.asarray(grid, dtype=int) != bg).astype(int)
+    h, w = occ.shape
+    prefix = np.pad(occ, ((1, 0), (1, 0)), constant_values=0).cumsum(0).cumsum(1)
+
+    best_bbox: tuple[int, int, int, int] | None = None
+    best_area = -1
+    tie_count = 0
+
+    for r0 in range(h - 1):
+        for r1 in range(r0 + 1, h):
+            rect_h = r1 - r0 + 1
+            for c0 in range(w - 1):
+                for c1 in range(c0 + 1, w):
+                    rect_w = c1 - c0 + 1
+                    area = rect_h * rect_w
+                    if area < best_area:
+                        continue
+                    if _rect_sum(prefix, r0, c0, r1, c1) != 0:
+                        continue
+                    if area > best_area:
+                        best_area = area
+                        best_bbox = (r0, c0, r1, c1)
+                        tie_count = 1
+                    else:
