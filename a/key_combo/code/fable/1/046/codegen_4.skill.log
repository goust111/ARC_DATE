+    cavity_shape = (cr1 - cr0 + 1, cc1 - cc0 + 1)
+    candidates = []
+    for comp in _components(inp, bg):
+        if comp["touches_border"]:
+            continue
+        patch = comp["patch"]
+        if patch.shape == cavity_shape or patch.shape == cavity_shape[::-1]:
+            candidates.append(comp)
