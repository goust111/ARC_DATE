+def _random_sprite_mask(h: int, w: int, require_hole: bool) -> np.ndarray:
+    interior_orbits = [
+        orbit
+        for orbit in _iter_orbits_180(h, w)
+        if all(0 < r < h - 1 and 0 < c < w - 1 for r, c in orbit)
