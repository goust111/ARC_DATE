+def generate_input() -> np.ndarray:
+    for _ in range(MAX_ATTEMPTS):
+        inp, expected = _build_instance()
+        if _validate_instance(inp, expected):
+            return inp
+    raise RuntimeError("failed to generate a valid negative-space lock-key instance")

