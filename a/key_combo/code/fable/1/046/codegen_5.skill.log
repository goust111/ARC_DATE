+    for spec in concrete_specs:
+        if spec["state"] == "exit":
+            direction, steps = _infer_exit_direction(spec["top_cells"], panel_shape)
+            if direction != spec["exit_dir"] or steps != spec["exit_steps"]:
+                return None
+    if not np.array_equal(main(inp), expected):
+        return None
+    return inp
+
