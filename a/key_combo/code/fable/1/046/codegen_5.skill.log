+
+
+def _render_scene(panel_shape: tuple[int, int], specs: list[dict]) -> tuple[np.ndarray, np.ndarray]:
+    panel_h, panel_w = panel_shape
+    top = np.full((panel_h, panel_w), BG, dtype=int)
+    bottom = np.full((panel_h, panel_w), BG, dtype=int)
