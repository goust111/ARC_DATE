+    panel_h, panel_w = panel_shape
+    mask_h, mask_w = mask.shape
+    coords_rel = _shape_coords(mask)
+    candidates: list[dict] = []
+
+    for r0 in range(panel_h - mask_h + 1):
+        for c0 in range(panel_w - mask_w + 1):
