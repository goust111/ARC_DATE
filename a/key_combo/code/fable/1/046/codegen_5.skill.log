+    return mask
+
+
+def _state_list(count: int) -> list[str]:
+    states = ["move"]
+    if count >= 2 and random.random() < 0.7:
+        states.append("exit")
+    if count >= 3 and random.random() < 0.6:
+        states.append("static")
