+            if exit_info is None:
+                continue
+            direction, steps = exit_info
+            if steps <= 1:
+                continue
+            swept = _sweep_cells(top_cells, direction[0], direction[1], steps, panel_shape)
+            if swept & output_occ:
+                continue
+            candidates.append(
+                {
+                    "top": top_origin,
+                    "bottom": None,
+                    "top_cells": top_cells,
+                    "bottom_cells": set(),
+                    "paint_cells": swept,
+                    "exit_dir": direction,
+                    "exit_steps": steps,
+                }
+            )
