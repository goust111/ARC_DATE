+            if token in matched_bottom:
+                continue
+            movement = _movement_between(top_obj, bottom_obj)
+            if movement is None:
+                continue
+            candidates.append((token, bottom_obj, movement[0], movement[1]))
+
+        if len(candidates) == 1:
