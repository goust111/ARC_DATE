+    matched_bottom: set[int] = set()
+    final_occupied = {(int(r), int(c)) for r, c in np.argwhere(bottom != bg)}
+    trail_cells: set[Coord] = set()
+
+    for top_obj in top_objects:
+        candidates: list[tuple[int, dict, int, int]] = []
