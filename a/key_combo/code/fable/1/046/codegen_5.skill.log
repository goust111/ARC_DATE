+    bottom = np.full((panel_h, panel_w), BG, dtype=int)
+
+    for spec in specs:
+        _paint_mask(top, spec["mask"], spec["top"], spec["color"])
+        if spec["bottom"] is not None:
+            _paint_mask(bottom, spec["mask"], spec["bottom"], spec["color"])
