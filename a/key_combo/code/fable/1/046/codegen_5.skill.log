+def _sweep_cells(coord_set: set[Coord], step_r: int, step_c: int, steps: int, shape: tuple[int, int]) -> set[Coord]:
+    h, w = shape
+    swept: set[Coord] = set()
+    for t in range(steps):
+        for r, c in coord_set:
+            rr = r + t * step_r
+            cc = c + t * step_c
+            if 0 <= rr < h and 0 <= cc < w:
