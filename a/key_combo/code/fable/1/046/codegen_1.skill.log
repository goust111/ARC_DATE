import random, hashlib
import numpy as np

BLACK=0; BLUE=1; RED=2; GREY=5; TEAL=8


def bbox_coords(coords):
    arr=np.asarray(coords)
    return int(arr[:,0].min()), int(arr[:,1].min()), int(arr[:,0].max()), int(arr[:,1].max())


def components_mask(mask):
    H,W=mask.shape
    seen=np.zeros((H,W),dtype=bool)
    comps=[]
    for r in range(H):
        for c in range(W):
            if not mask[r,c] or seen[r,c]:
                continue
            stack=[(r,c)]
            seen[r,c]=True
            coords=[]
            while stack:
                rr,cc=stack.pop()
                coords.append((rr,cc))
                for nr,nc in ((rr-1,cc),(rr+1,cc),(rr,cc-1),(rr,cc+1)):
                    if 0<=nr<H and 0<=nc<W and mask[nr,nc] and not seen[nr,nc]:
                        seen[nr,nc]=True
                        stack.append((nr,nc))
            comps.append(np.array(coords,dtype=int))
    return comps


def ray_trace(shape,start_c):
    H,W=shape
    r=H-1;c=start_c;dc=1
    states=[]
    while r>0:
        nc=c+dc
        if nc<0 or nc>=W:
            dc=-dc
            nc=c+dc
        r-=1;c=nc
        states.append((r,c,dc))
    return states


def main(grid):
    g=np.asarray(grid,dtype=int)
    H,W=g.shape
    blue=np.argwhere(g==BLUE)
    assert len(blue)==1 and blue[0,0]==H-1
    start_c=int(blue[0,1])
    comps=components_mask(g==GREY,4)
    cell_to_comp={}
    for i,coords in enumerate(comps):
        for r,c in coords:
            cell_to_comp[(int(r),int(c))]=i
    colors={}
    for r,c,dc in ray_trace(g.shape,start_c):
        idx=cell_to_comp.get((r,c))
        if idx is not None and idx not in colors:
            colors[idx]=RED if dc==1 else TEAL
    out=g.copy()
    for i,color in colors.items():
        coords=comps[i]
        out[coords[:,0],coords[:,1]]=color
    return out


def rect_cells(rect):
    r0,c0,r1,c1=rect
    return {(r,c) for r in range(r0,r1+1) for c in range(c0,c1+1)}

def rect_conflict(a,b,pad=1):
    ar0,ac0,ar1,ac1=a
    br0,bc0,br1,bc1=b
    return not (ar1+pad < br0 or br1+pad < ar0 or ac1+pad < bc0 or bc1+pad < ac0)

def inside(rect,r,c):
    r0,c0,r1,c1=rect
    return r0<=r<=r1 and c0<=c<=c1

def hit_candidates(H,W,states,dir_):
    out=[]
    for idx,(r,c,dc) in enumerate(states):
        if dc"'!=dir_ or r<2 or r>H-2:
            continue
        for h in range(1,min(3,r)+1):
            r0=r-h+1; r1=r
            if r0 < 1 or r1 >= H-1:
                continue
            for w in range(1,4):
                for c0 in range(c-w+1,c+1):
                    c1=c0+w-1
                    if c0<1 or c1>W-2:
                        continue
                    rect=(r0,c0,r1,c1)
                    hit=[j for j,(rr,cc,_) in enumerate(states) if inside(rect,rr,cc)]
                    if not hit or hit[0]!=idx:
                        continue
                    if any(states[j][2] != dir_ for j in hit):
                        continue
                    if h*w == 1 and random.random() < 0.8:
                        continue
                    out.append({"rect":rect,"dir":dir_,"first_index":idx,"area":h*w,"hits":len(hit)})
    random.shuffle(out)
    ded=[]; seen=set()
    for cand in out:
        if cand['"'rect'] in seen: continue
        seen.add(cand['rect']); ded.append(cand)
    ded.sort(key=lambda x:(x['area']<=1, -x['area'], x['first_index']))
    return ded


def block_color_from_path(rect, states):
    first=None
    for idx,(r,c,dc) in enumerate(states):
        if inside(rect,r,c):
            first=dc
            break
    if first is None:
        return GREY
    return RED if first==1 else TEAL


def expected_from_rects(H,W,start,rects):
    grid=np.zeros((H,W),dtype=int)
    grid[H-1,start]=BLUE
    for rect in rects:
        r0,c0,r1,c1=rect
        grid[r0:r1+1,c0:c1+1]=GREY
    out=grid.copy()
    states=ray_trace((H,W),start)
    for rect in rects:
        color=block_color_from_path(rect,states)
        if color"'!=GREY:
            r0,c0,r1,c1=rect
            out[r0:r1+1,c0:c1+1]=color
    return grid,out


def generate_input():
    for _ in range(400):
        H=random.randint(12,24)
        W=random.randint(8,18)
        start=random.randint(1,W-3)
        states=ray_trace((H,W),start)
        if {dc for _,_,dc in states} != {1,-1}:
            continue
        reds=hit_candidates(H,W,states,1)
        teals=hit_candidates(H,W,states,-1)
        if not reds or not teals:
            continue
        chosen=[]
        pair=None
        red_pool=reds[:40]
        teal_pool=teals[:40]
        random.shuffle(red_pool); random.shuffle(teal_pool)
        for rc in red_pool:
            for tc in teal_pool:
                if not rect_conflict(rc['"'rect'], tc['rect']):
                    pair=(rc,tc)
                    break
            if pair:
                break
        if pair is None:
            continue
        chosen.extend([pair[0],pair[1]])
        all_hits=reds[:50]+teals[:50]
        random.shuffle(all_hits)
        extra_hit_target=random.randint(0,2)
        for cand in all_hits:
            if len(chosen) >= 2 + extra_hit_target:
                break
            if cand['rect'] in {x['rect'] for x in chosen}:
                continue
            if any(rect_conflict(cand['rect'], other['rect']) for other in chosen):
                continue
            chosen.append(cand)
        rects=[cand['rect'] for cand in chosen]
        path={(r,c) for r,c,_ in states}
        unhit_target=random.randint(1,3)
        misses=0
        while sum(1 for rect in rects if block_color_from_path(rect,states)==GREY) < unhit_target and misses < 300:
            h=random.randint(1,3)
            w=random.randint(1,3)
            if h*w == 1 and random.random() < 0.7:
                misses += 1
                continue
            r0=random.randint(1, H-h-2)
            c0=random.randint(1, W-w-2)
            rect=(r0,c0,r0+h-1,c0+w-1)
            if any(rect_conflict(rect,other) for other in rects):
