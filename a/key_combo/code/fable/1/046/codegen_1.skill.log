+def _ray_trace(shape: tuple[int, int], start_c: int) -> list[tuple[int, int, int]]:
+    height, width = map(int, shape)
+    r = height - 1
+    c = int(start_c)
+    dc = 1
+    states: list[tuple[int, int, int]] = []
+    while r > 0:
+        next_c = c + dc
+        if next_c < 0 or next_c >= width:
+            dc *= -1
+            next_c = c + dc
+        r -= 1
+        c = next_c
+        states.append((r, c, dc))
+    return states
+
