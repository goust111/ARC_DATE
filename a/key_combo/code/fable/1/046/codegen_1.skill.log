+def _build_input(height: int, width: int, start_c: int, rects: list[BBox]) -> np.ndarray:
+    grid = np.zeros((height, width), dtype=int)
+    grid[height - 1, start_c] = BLUE
+    for r0, c0, r1, c1 in rects:
+        grid[r0 : r1 + 1, c0 : c1 + 1] = GREY
+    return grid
