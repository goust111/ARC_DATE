        r0=random.randint(0,H-h-1)
        c0=random.randint(1,W-w-1)
        rect=(r0,c0,r0+h-1,c0+w-1)
        if any(rect_conflict(rect,x) for x in rects):
            continue
        if any(inside(rect,r,c) for r,c in path):
            continue
        rects.append(rect); unhit=1; break
    if not unhit:
        continue
    print('"'success',attempt,(H,W,start),len(reds),len(teals),rects)
    break
else:
    print('no success')
