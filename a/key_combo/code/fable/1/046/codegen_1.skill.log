import random
import numpy as np

BLACK=0; BLUE=1; RED=2; GREY=5; TEAL=8

def ray(shape,start_c):
    H,W=shape
    r=H-1;c=start_c;dc=1
    states=[]
    while r>0:
        nc=c+dc
        if nc<0 or nc>=W:
            dc=-dc
            nc=c+dc
        r-=1;c=nc
        states.append((r,c,dc))
    return states

def rect_conflict(a,b,pad=1):
    ar0,ac0,ar1,ac1=a
    br0,bc0,br1,bc1=b
    return not (ar1+pad < br0 or br1+pad < ar0 or ac1+pad < bc0 or bc1+pad < ac0)

def inside(rect,r,c):
    r0,c0,r1,c1=rect
    return r0<=r<=r1 and c0<=c<=c1

def hit_candidates(H,W,states,dir_):
    out=[]
    for idx,(r,c,dc) in enumerate(states):
        if dc"'!=dir_:
            continue
        if r>H-2 or r<1:
            continue
        for h in range(1,min(3,r+1)+1):
            r0=r-h+1; r1=r
            if r1>=H-1: continue
            for w in range(1,4):
                for c0 in range(c-w+1,c+1):
                    c1=c0+w-1
                    if c0<1 or c1>W-2:
                        continue
                    rect=(r0,c0,r1,c1)
                    hit=[j for j,(rr,cc,_) in enumerate(states) if inside(rect,rr,cc)]
                    if hit and hit[0]==idx:
                        out.append((idx,rect,dc,len(hit)))
    random.shuffle(out)
    # maybe dedup by rect
    seen=set(); ded=[]
    for item in out:
        if item[1] in seen: continue
        seen.add(item[1]); ded.append(item)
    return ded

for attempt in range(100):
    H=random.randint(12,24)
    W=random.randint(7,16)
    start=random.randint(1,W-3)
    states=ray((H,W),start)
    reds=hit_candidates(H,W,states,1)
    teals=hit_candidates(H,W,states,-1)
    if not reds or not teals:
        continue
    ok=False
    for _,rrect,_,_ in reds[:30]:
        for _,trect,_,_ in teals[:30]:
            if not rect_conflict(rrect,trect):
