+    index: dict[tuple[tuple[int, int], ...], dict] = {}
+    for direction in ALL_DIRECTIONS:
+        for size in SIZES:
+            rel = _template_offsets(direction, size)
+            signature, (r0, c0) = _normalize_coords(rel)
+            apex_norm = (-r0, -c0)
+            info = {
+                "direction": direction,
+                "size": int(size),
+                "apex_norm": apex_norm,
