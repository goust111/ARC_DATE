+        for sr, sc in np.argwhere(mask):
+            sr = int(sr)
+            sc = int(sc)
+            if seen[sr, sc]:
+                continue
+            stack = [(sr, sc)]
+            seen[sr, sc] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                r, c = stack.pop()
+                coords.append((r, c))
+                for nr, nc in _neighbors8(r, c):
+                    if not _in_bounds((h, w), nr, nc):
+                        continue
+                    if seen[nr, nc] or not mask[nr, nc]:
+                        continue
+                    seen[nr, nc] = True
+                    stack.append((nr, nc))
