+    norm = tuple(sorted((r - r0, c - c0) for r, c in coords))
+    return norm, (r0, c0)
+
+
+def _build_template_index() -> dict[tuple[tuple[int, int], ...], dict]:
+    index: dict[tuple[tuple[int, int], ...], dict] = {}
