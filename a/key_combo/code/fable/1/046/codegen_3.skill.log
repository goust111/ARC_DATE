+    if not visible_hits:
+        return False
+
+    collision_cells = [cell for cell, shooters in visible_hits.items() if len(shooters) >= 2]
+    solo_cells = [cell for cell, shooters in visible_hits.items() if len(shooters) == 1]
+    if len(collision_cells) < required_collisions:
+        return False
+    if not solo_cells:
+        return False
