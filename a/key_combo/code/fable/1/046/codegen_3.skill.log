+    info = TEMPLATE_INDEX.get(signature)
+    if info is None:
+        return None
+    apex_r = r0 + info["apex_norm"][0]
+    apex_c = c0 + info["apex_norm"][1]
+    return {
+        "color": int(comp["color"]),
+        "coords": list(comp["coords"]),
+        "size": int(info["size"]),
+        "direction": tuple(info["direction"]),
+        "apex": (int(apex_r), int(apex_c)),
