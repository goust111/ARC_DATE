+        for sr, sc in np.argwhere(mask):
+            sr = int(sr)
+            sc = int(sc)
+            if seen[sr, sc]:
+                continue
+            stack = [(sr, sc)]
+            seen[sr, sc] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                r, c = stack.pop()
+                coords.append((r, c))
