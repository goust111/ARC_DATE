+    assert g.ndim == 2, "expected a 2D grid"
+
+    bg = _get_bg(g)
+    assert bg == BG, "expected black background"
+
+    arrows: list[dict] = []
+    for comp in _monochrome_components(g, bg):
+        arrow = _parse_arrow(comp)
