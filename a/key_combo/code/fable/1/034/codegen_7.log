+    down = int(_RNG.integers(1, h - corner_r + 1))
+    right = int(_RNG.integers(1, w - corner_c + 1))
+    canvas[corner_r : corner_r + down, corner_c] = color
+    canvas[corner_r, corner_c : corner_c + right] = color
