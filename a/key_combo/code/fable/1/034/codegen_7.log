+        c0 = int(_RNG.integers(0, w))
+        c1 = int(_RNG.integers(c0, w))
+        canvas[r, c0:c1] = color
+    else:
+        c = int(_RNG.integers(0, w))
+        r0 = int(_RNG.integers(0, h))
+        r1 = int(_RNG.integers(r0, h))
+        canvas[r0:r1, c] = color
+
+
