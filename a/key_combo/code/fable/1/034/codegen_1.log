        return None, None
    dist_e = _gen_bfs_dist(track_set, end)
    length = dist_s[end]
    cells = {p for p in dist_s if p in dist_e and dist_s[p] + dist_e[p] == length}
    return cells, length


def _gen_has_unique_simple_path(track_set, start, end):
