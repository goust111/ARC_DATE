+def _normalize_shape(cells) -> tuple[tuple[int, int], ...]:
+    points = list(cells)
+    assert points
+    min_r = min(r for r, _ in points)
+    min_c = min(c for _, c in points)
+    return tuple(sorted((int(r - min_r), int(c - min_c)) for r, c in points))
