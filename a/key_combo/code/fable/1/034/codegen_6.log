+def _render_shape(shape: tuple[tuple[int, int], ...], color: int) -> np.ndarray:
+    mask = _shape_to_mask(shape)
+    sprite = np.zeros(mask.shape, dtype=int)
+    sprite[mask] = int(color)
+    return sprite
