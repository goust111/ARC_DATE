+BG = Color.BLACK
+GREY = Color.GREY
+PIECE_COLORS = [Color.BLUE, Color.RED, Color.GREEN, Color.YELLOW, Color.PINK, Color.ORANGE, Color.TEAL, Color.MAROON]
+PAIR_AREA_CHOICES = [(2, 2), (2, 3), (2, 4), (3, 3), (3, 4), (4, 4)]
+GEN_MAX_ATTEMPTS = 300
