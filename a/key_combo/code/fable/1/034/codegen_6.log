+    solutions: list[dict[int, dict]] = []
+
+    def dfs(step: int, used: set[int], chosen: dict[int, dict]) -> None:
+        if len(solutions) > 1:
+            return
+        if step == len(order):
+            solutions.append(chosen.copy())
+            return
