+def _place_sprites(sprites: list[np.ndarray], grid_h: int, grid_w: int, gap: int = 1) -> list[tuple[int, int]] | None:
+    order = sorted(range(len(sprites)), key=lambda idx: sprites[idx].shape[0] * sprites[idx].shape[1], reverse=True)
