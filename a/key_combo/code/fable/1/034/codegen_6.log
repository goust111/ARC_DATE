+        placed = False
+        for _ in range(300):
+            r0 = random.randint(0, grid_h - h)
+            c0 = random.randint(0, grid_w - w)
+            box = (r0, c0, r0 + h - 1, c0 + w - 1)
+            if any(_bbox_overlap(box, other, gap) for other in boxes):
