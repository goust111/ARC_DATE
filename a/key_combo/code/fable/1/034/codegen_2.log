+    unique_cells = random.sample(cells, n_frames)
+    fragments = [np.zeros_like(prototype, dtype=bool) for _ in range(n_frames)]
+    for frame_id, cell in enumerate(unique_cells):
+        fragments[frame_id][cell] = True
