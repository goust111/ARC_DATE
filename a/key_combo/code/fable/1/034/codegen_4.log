+def _all_ray_cells(shape: tuple[int, int], bar_r: int, landed_cols: set[int]) -> set[tuple[int, int]]:
+    cells: set[tuple[int, int]] = set()
+    for col in landed_cols:
+        cells.update(_ray_cells(shape, bar_r, col))
+    return cells
