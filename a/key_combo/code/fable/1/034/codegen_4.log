+from __future__ import annotations
+
+from collections import deque
+
+import numpy as np
+
+
+class Color:
+    BLACK = 0
+    BLUE = 1
+    RED = 2
+    GREEN = 3
+    YELLOW = 4
+    GREY = 5
+    PINK = 6
+    ORANGE = 7
+    TEAL = 8
+    MAROON = 9
+
+
+TRACE_COLOR = Color.GREEN
+GEN_COLOR_POOL = np.array(
+    [
+        Color.BLUE,
+        Color.RED,
+        Color.YELLOW,
+        Color.GREY,
+        Color.PINK,
+        Color.ORANGE,
+        Color.TEAL,
+        Color.MAROON,
+    ],
+    dtype=int,
