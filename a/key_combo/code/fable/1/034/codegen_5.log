+def _build_grid(
+    track: set[tuple[int, int]],
+    main_path: list[tuple[int, int]],
+    portal_pairs: list[tuple[int, int]],
+) -> np.ndarray:
+    rows = [r for r, _ in track]
+    cols = [c for _, c in track]
