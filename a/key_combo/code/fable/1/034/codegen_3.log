+    for h in range(_GEN_FRAME_OUTER_H_RANGE[0], _GEN_FRAME_OUTER_H_RANGE[1] + 1):
+        for w in range(_GEN_FRAME_OUTER_W_RANGE[0], _GEN_FRAME_OUTER_W_RANGE[1] + 1):
+            if (h - 2) * (w - 2) >= max_count:
+                choices.append((h, w))
