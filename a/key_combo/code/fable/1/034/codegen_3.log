+    order = sorted(range(sprite_count), key=lambda idx: sprite_positions[idx])
+    ordered_sprites = [sprites[idx] for idx in order]
+
+    visible_overlap_pairs = []
+    disjoint_pairs = []
+    fallback_pairs = []
+    for upper_idx in range(sprite_count):
