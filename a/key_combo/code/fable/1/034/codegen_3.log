+    work = reserved.copy()
+    order = sorted(range(len(shapes)), key=lambda idx: shapes[idx][0] * shapes[idx][1], reverse=True)
+    placements: list[tuple[int, int] | None] = [None] * len(shapes)
+    for idx in order:
+        h, w = map(int, shapes[idx])
+        candidates = [
