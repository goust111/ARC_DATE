+
+def _gen_mark_box(reserved: np.ndarray, r: int, c: int, h: int, w: int, pad: int) -> None:
+    rows, cols = reserved.shape
+    rr0 = max(0, r - pad)
+    cc0 = max(0, c - pad)
+    rr1 = min(rows, r + h + pad)
+    cc1 = min(cols, c + w + pad)
