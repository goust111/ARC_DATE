+        distances = np.abs(anchors[:, 0] - r) + np.abs(anchors[:, 1] - c)
+        nearest = np.flatnonzero(distances == distances.min())
+        idx = int(_GEN_RNG.choice(nearest))
+        sprite[int(r), int(c)] = int(colors[idx])
+    return sprite
