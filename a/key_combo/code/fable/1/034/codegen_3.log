+def _gen_overlay_pair_kind(sprite_a: np.ndarray, sprite_b: np.ndarray) -> str:
+    overlap = (sprite_a != _GEN_BG) & (sprite_b != _GEN_BG)
+    if np.any(overlap & (sprite_a != sprite_b)):
+        return "visible_overlap"
+    if np.any(overlap):
+        return "same_color_overlap"
+    return "disjoint"
