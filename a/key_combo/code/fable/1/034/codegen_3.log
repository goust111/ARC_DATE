+    r1, c1 = coords.max(axis=0)
+    box = (int(r0), int(c0), int(r1), int(c1))
+    h = int(r1 - r0 + 1)
+    w = int(c1 - c0 + 1)
+    if h < 3 or w < 3:
+        return False, None
+    local = np.zeros((h, w), dtype=bool)
+    local[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    border = _rect_border_mask((h, w), (0, 0, h - 1, w - 1))
