+def _gen_attempt() -> np.ndarray | None:
+    rows = _gen_randint(_GEN_CANVAS_MIN, _GEN_CANVAS_MAX)
+    cols = _gen_randint(_GEN_CANVAS_MIN, _GEN_CANVAS_MAX)
