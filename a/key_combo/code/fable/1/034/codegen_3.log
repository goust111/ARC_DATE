+import numpy as np
+
+
+_ARC_UTILS_PATH = Path("/home/lixinyu/snap/new/solvers/arc_utils.py")
+_ARC_UTILS_SPEC = importlib.util.spec_from_file_location("_arc_utils_fable_1_034_3", _ARC_UTILS_PATH)
