+    assert len(candidates) == 1, "expected exactly one frame color"
+    return candidates[0]
+
+
+def _find_marker_color(
+    grid: np.ndarray,
+    bg: int,
+    frame_color: int,
+    frame_boxes: list[tuple[int, int, int, int]],
