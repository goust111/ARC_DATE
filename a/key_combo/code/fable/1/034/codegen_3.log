    visited = {(start := next(iter(pixel_set)))}
    stack = [start]
    while stack:
        r, c = stack.pop()
        for dr in (-1, 0, 1):
            for dc in (-1, 0, 1):
                if dr == 0 and dc == 0:
                    continue
                nb = (r + dr, c + dc)
                if nb in pixel_set and nb not in visited:
                    visited.add(nb)
                    stack.append(nb)
    return len(visited) == len(pixel_set)


