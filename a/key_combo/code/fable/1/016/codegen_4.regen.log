+        for i in range(len(order))
+        for j in range(i + 1, len(order))
+    )
+    if not same_count_pair_exists:
+        return False
+
+    unique_colors = [int(c) for c in np.unique(grid) if int(c) not in (BACKGROUND, PANEL_GRAY)]
