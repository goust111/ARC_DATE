+        patch[sprite != 0] = sprite[sprite != 0]
+        rr0 = max(0, r0 - 1)
+        rr1 = min(height, r0 + h + 1)
+        cc0 = max(0, c0 - 1)
+        cc1 = min(width, c0 + w + 1)
+        reserved[rr0:rr1, cc0:cc1] = True
