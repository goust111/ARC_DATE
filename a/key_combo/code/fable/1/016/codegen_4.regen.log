  "transform": "rotate the sprite in place by the unique quarter-turn mapping s to d; clear all four markers and paint one marker at the three-marker square center",
  "symbol_instructions": "marker pixels encode source and target sprite corners"
}
</annotation>
</reference_puzzle>

