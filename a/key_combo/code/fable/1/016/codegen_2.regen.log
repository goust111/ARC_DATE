+                    min_c0 = 1
+                    max_c0 = axis_col - obj_w
+                else:
+                    min_c0 = axis_col + 2
+                    max_c0 = w - obj_w - 1
+                if min_c0 > max_c0:
+                    continue
+
+                r0 = random.randint(1, h - obj_h - 2)
+                c0 = random.randint(min_c0, max_c0)
