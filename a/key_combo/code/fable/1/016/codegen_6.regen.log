+    patch[hole_r0 : hole_r0 + hole_side, hole_c0 : hole_c0 + hole_side] = bg
+
+    pip_positions = random.sample(CANONICAL_PIPS[hole_side], pip_count)
+    for dr, dc in pip_positions:
