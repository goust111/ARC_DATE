YELLOW = 4


def rotate(coords, pivot, k):
    arr = np.array(sorted(coords), dtype=int)
    pr, pc = pivot
    for _ in range(k % 4):
        dr = arr[:, 0] - pr
        dc = arr[:, 1] - pc
        arr = np.column_stack((pr + dc, pc - dr))
