+def _rotate_coords(coords: np.ndarray, pivot: Coord, quarter_turns: int) -> np.ndarray:
+    arr = np.asarray(coords, dtype=int).copy()
+    pr, pc = map(int, pivot)
+    for _ in range(int(quarter_turns) % 4):
+        dr = arr[:, 0] - pr
+        dc = arr[:, 1] - pc
+        arr = np.column_stack((pr + dc, pc - dr))
+    return arr.astype(int)
