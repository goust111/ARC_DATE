+
+def _root_index(idx: int, support: dict[int, int], cache: dict[int, int]) -> int:
+    if idx in cache:
+        return cache[idx]
+    if idx not in support:
+        cache[idx] = idx
+    else:
+        cache[idx] = _root_index(support[idx], support, cache)
+    return cache[idx]
+
