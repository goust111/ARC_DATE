def _crop_mask(mask):
    """Crop a boolean mask to its tight bounding box. Returns None if empty."""
    rows, cols = np.where(mask)
    if len(rows) == 0:
        return None
    return mask[rows.min():rows.max() + 1, cols.min():cols.max() + 1]
