+    inp = _render_input(objects, shape, bg, shifts)
+    if inp is None:
+        return None
+    if not _validate_case(inp, objects, bg):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _generate_case()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input")

