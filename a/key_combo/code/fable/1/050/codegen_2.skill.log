+
+def _can_place(blocked: np.ndarray, patch: np.ndarray, r0: int, c0: int) -> bool:
+    h, w = patch.shape
+    if r0 < 1 or c0 < 1 or r0 + h >= blocked.shape[0] or c0 + w >= blocked.shape[1]:
+        return False
+    return not blocked[r0 - 1 : r0 + h + 1, c0 - 1 : c0 + w + 1].any()
+
