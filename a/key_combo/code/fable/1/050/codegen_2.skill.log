_GEN_RECT_COUNT_MIN, _GEN_RECT_COUNT_MAX = 4, 6
_GEN_SIDE_MIN, _GEN_SIDE_MAX = 2, 7
_GEN_RECT_AREA_MIN, _GEN_RECT_AREA_MAX = 6, 42
_GEN_AREA_BUDGET_BY_COUNT = {4: (68, 118), 5: (78, 128), 6: (88, 136)}
_GEN_VALID_DIMS = [
