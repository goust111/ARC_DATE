+        mask = np.ones((h, w), dtype=bool)
+        desired = rng.randint(min_area, max_area)
+        cells = [(r, c) for r in range(h) for c in range(w)]
+        rng.shuffle(cells)
+        progressed = True
+        while int(mask.sum()) > desired and progressed:
+            progressed = False
+            for r, c in cells:
+                if int(mask.sum()) <= desired or not mask[r, c]:
+                    continue
