+
+def _colorize(mask: np.ndarray, rng: random.Random) -> np.ndarray:
+    n_colors = rng.choice([2, 2, 3])
+    palette = rng.sample(OBJECT_COLORS, n_colors)
+    mode = rng.choice(["row", "col", "diag", "checker"])
+    offset = rng.randrange(n_colors)
