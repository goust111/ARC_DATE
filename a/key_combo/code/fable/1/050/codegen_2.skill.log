+    bar_mask = np.zeros_like(grid, dtype=bool)
+    for c, count in zip(target_cols, col_hist):
+        bar_mask[:count, c] = True
+    for r, count in zip(target_rows, row_hist):
+        bar_mask[r, :count] = True
