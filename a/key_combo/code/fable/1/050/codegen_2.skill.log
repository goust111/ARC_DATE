+        elif mode == "col":
+            idx = (cc + offset) % n_colors
+        elif mode == "diag":
+            idx = (rr + cc + offset) % n_colors
+        else:
+            idx = ((2 * rr) + cc + offset) % n_colors
+        patch[rr, cc] = palette[idx]
