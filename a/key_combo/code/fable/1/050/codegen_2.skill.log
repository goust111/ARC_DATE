+def _blocked_with_padding(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    out = mask.copy()
+    for r, c in np.argwhere(mask):
+        rr = int(r)
+        cc = int(c)
+        r0 = max(0, rr - 1)
+        r1 = min(h, rr + 2)
+        c0 = max(0, cc - 1)
+        c1 = min(w, cc + 2)
+        out[r0:r1, c0:c1] = True
+    return out
