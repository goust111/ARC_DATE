+GRID_H_RANGE = (20, 28)
+GRID_W_RANGE = (20, 28)
+TARGET_H_RANGE = (4, 7)
+TARGET_W_RANGE = (4, 7)
+TEMPLATE_COUNT_RANGE = (3, 5)
+GEN_ATTEMPTS = 400
+PLACEMENT_ATTEMPTS = 200
+MASK_ATTEMPTS = 200
