+
+    top_order = [_shape_key(obj["coords"]) for obj in sorted(top_objects, key=lambda o: (o["bbox"][0], o["bbox"][1]))]
+    mid_order = [_shape_key(obj["coords"]) for obj in sorted(middle_objects, key=lambda o: (o["bbox"][0], o["bbox"][1]))]
