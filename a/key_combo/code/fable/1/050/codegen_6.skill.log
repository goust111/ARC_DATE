+    top_panel, top_places = top_placed
+    mid_panel, mid_places = mid_placed
+    if _row_major_ids(top_places) == _row_major_ids(mid_places):
+        return None
+    if any((tr, tc) == (mr, mc) for (_, tr, tc), (_, mr, mc) in zip(sorted(top_places), sorted(mid_places))):
