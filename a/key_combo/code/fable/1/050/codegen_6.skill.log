132:             comp["coords"]
133:             for comp in find_components(
134:                 g,
135:                 bg=bg,
136:                 connectivity=4,
137:                 monochromatic=True,
138:                 colors=[color],
139:             )
140:         ]
141:         comps.sort(key=lambda coords: tuple(map(int, coords.min(axis=0))))
