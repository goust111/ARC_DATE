+        return False
+    if sorted(top_keys) != sorted(mid_keys):
+        return False
+
+    features = {(obj["area"], obj["bbox"][2] - obj["bbox"][0] + 1, obj["bbox"][3] - obj["bbox"][1] + 1) for obj in top_objects}
+    if len(features) != 1:
