+
+    top_order = _row_major_ids([(i, obj["bbox"][0], obj["bbox"][1]) for i, obj in enumerate(sorted(top_objects, key=lambda o: (o["bbox"][0], o["bbox"][1])) )])
+    mid_order = _row_major_ids([(i, obj["bbox"][0], obj["bbox"][1]) for i, obj in enumerate(sorted(middle_objects, key=lambda o: (o["bbox"][0], o["bbox"][1])) )])
+    if top_order == mid_order and len(top_order) > 1:
+        return False
+
+    bottom_colors = set(int(v) for v in np.unique(bottom) if int(v) != bg)
+    if bottom_colors != set(color_map):
+        return False
+    return True
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
