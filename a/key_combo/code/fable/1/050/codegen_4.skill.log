+def _canonical_shape_key(mask: np.ndarray) -> tuple[tuple[int, int], bytes]:
+    keys = [
+        (tuple(map(int, transformed.shape)), transformed.tobytes())
+        for transformed in _unique_transforms(mask)
+    ]
+    return min(keys)
