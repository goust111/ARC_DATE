+        r0 = random.randint(0, patch_h - h)
+        c0 = random.randint(0, patch_w - w)
+        patch = np.zeros((patch_h, patch_w), dtype=bool)
+        patch[r0 : r0 + h, c0 : c0 + w] = placed
+        intended = _coords_from_mask(placed, r0, c0)
