+    filled = set(map(tuple, np.argwhere(mask)))
+    for r, c in filled:
+        for dr, dc in DIRS4:
+            nr, nc = int(r) + dr, int(c) + dc
+            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in filled:
