+    assert piece_components, "expected at least one gray puzzle piece"
+    piece_masks: list[np.ndarray] = []
+    for piece in piece_components:
+        r0, c0, r1, c1 = piece["bbox"]
+        piece_masks.append((grid[r0 : r1 + 1, c0 : c1 + 1] == PIECE_COLOR))
