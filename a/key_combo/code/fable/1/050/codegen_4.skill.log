+    out = g.copy()
+    out[out == PIECE_COLOR] = BG
+    out[hole_mask] = ANSWER_COLOR
+    for r, c in placed_cells:
+        out[r, c] = container_color
+    return out
+
+
+GEN_MAX_ATTEMPTS = 400
+GEN_LOCAL_PATCH_ATTEMPTS = 120
+GEN_GROUP_PATCH_ATTEMPTS = 140
+GEN_PIECE_ATTEMPTS = 120
