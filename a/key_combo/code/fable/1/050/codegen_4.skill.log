+    base = _normalize_mask(mask)
+    keys: set[tuple[tuple[int, int], bytes]] = set()
+    for k in range(4):
+        rotated = _normalize_mask(np.rot90(base, k))
+        keys.add((tuple(map(int, rotated.shape)), rotated.tobytes()))
+    return keys
