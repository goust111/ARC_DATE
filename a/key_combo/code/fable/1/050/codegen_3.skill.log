+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+Coord = tuple[int, int]
+Window = tuple[int, int]
+
+WINDOW_SIZE = 3
+SEPARATOR_STRIDE = WINDOW_SIZE + 1
+BACKGROUND_COLOR = 0
+SEPARATOR_COLOR = 5
