+    radii = [int(spec["radius"]) for spec in specs]
+    centers = [tuple(map(int, spec["center"])) for spec in specs]
+    outlines = [_diamond_outline(shape, cr, cc, radius) for (cr, cc), radius in zip(centers, radii)]
