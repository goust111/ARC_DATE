+                continue
+            initial_stop.add(i)
+            initial_stop.add(j)
+            overlap = outlines[i] & outlines[j]
+            if overlap:
+                red_cells |= overlap
+            events.append(
+                {"step": 0, "pair": (i, j), "overlap": bool(overlap), "kind": "initial-contact"}
+            )
