968:def check_between_objects(
969-    obj1: np.ndarray,
970-    obj2: np.ndarray,
971-    r: int | None = None,
972-    c: int | None = None,
973-    padding: int = 0,
974-    background: int = Color.BLACK,
975-    **kwargs,
976-) -> bool:
977-    """Check if a pixel (r,c) lies between two objects, horizontally or vertically."""
978-    xr, used_x = _consume_alias(kwargs, "r", ["x"])
979-    yc, used_y = _consume_alias(kwargs, "c", ["y"])
980-    if r is None and xr is not None:
981-        if used_x == "x":
982-            warnings.warn("check_between_objects: keyword 'x' is deprecated; use 'r'", DeprecationWarning, stacklevel=2)
983-        r = xr
984-    if c is None and yc is not None:
985-        if used_y == "y":
986-            warnings.warn("check_between_objects: keyword 'y' is deprecated; use 'c'", DeprecationWarning, stacklevel=2)
987-        c = yc
988-    if r is None or c is None:
989-        raise TypeError("check_between_objects: must provide r,c (or x,y)")
990-    if kwargs:
991-        raise TypeError(f"check_between_objects: unexpected keyword arguments: {sorted(kwargs.keys())}")
992-
993-    r = int(r)
994-    c = int(c)
995-    pad = int(padding)
996-    bg = int(background)
997-
998-    b1 = bbox(obj1 != bg)
999-    b2 = bbox(obj2 != bg)
1000-    if b1 is None or b2 is None:
1001-        return False
1002-    r1, c1, r1b, c1b = b1
1003-    r2, c2, r2b, c2b = b2
1004-
1005-    # Horizontal between: objects separated along columns, and row overlap is sufficient.
1006-    left, right = ((r1, c1, r1b, c1b), (r2, c2, r2b, c2b)) if c1 <= c2 else ((r2, c2, r2b, c2b), (r1, c1, r1b, c1b))
1007-    lr0, _lc0, lr1, lc1 = left
1008-    rr0, rc0, rr1, _rc1 = right
1009-    if lc1 < c < rc0:
1010-        top = max(lr0, rr0) + pad
1011-        bot = min(lr1, rr1) - pad
1012-        if top <= r <= bot:
1013-            return True
1014-
1015-    # Vertical between: objects separated along rows, and col overlap is sufficient.
1016-    top_obj, bot_obj = ((r1, c1, r1b, c1b), (r2, c2, r2b, c2b)) if r1 <= r2 else ((r2, c2, r2b, c2b), (r1, c1, r1b, c1b))
1017-    tr0, tc0, tr1, tc1 = top_obj
1018-    br0, bc0, br1, bc1 = bot_obj
1019-    if tr1 < r < br0:
1020-        leftc = max(tc0, bc0) + pad
1021-        rightc = min(tc1, bc1) - pad
1022-        if leftc <= c <= rightc:
1023-            return True
1024-
1025-    return False
