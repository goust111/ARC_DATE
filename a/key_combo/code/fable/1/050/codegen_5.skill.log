    dr = abs(start[0] - stop[0])
    dc = abs(start[1] - stop[1])
    if first_axis == "h":
        return "v" if dr else "h"
    assert first_axis == "v", "path axis must be horizontal or vertical"
    return "h" if dc else "v"


