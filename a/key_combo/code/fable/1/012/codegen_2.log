+    right_w = quadrants[(0, 1)].shape[1]
+
+    motif_h = math.gcd(int(top_h), int(bottom_h))
+    motif_w = math.gcd(int(left_w), int(right_w))
+    if motif_h <= 0 or motif_w <= 0:
+        raise ValueError("invalid motif size")
