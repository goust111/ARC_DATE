+def _erase_bars(out: np.ndarray, bars: list[dict], bg: int) -> None:
+    for bar in bars:
+        r0, c0, r1, c1 = bar["bbox"]
+        out[r0 : r1 + 1, c0 : c1 + 1] = int(bg)
