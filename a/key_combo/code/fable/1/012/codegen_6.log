+def _simulate_drop(
+    out: np.ndarray,
+    frame_bbox: tuple[int, int, int, int],
+    slots: list[dict],
+    bars_by_length: dict[int, dict],
+) -> tuple[list[str], list[tuple[int, int, int, int, int]]]:
+    occupied = np.zeros(out.shape, dtype=bool)
+    stops = []
+    placements = []
+    r0, c0, r1, c1 = frame_bbox
