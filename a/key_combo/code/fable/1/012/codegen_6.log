+MAX_GEN_ATTEMPTS = 500
+MAX_SIDE_SEGMENT_ATTEMPTS = 120
+MAX_BAR_PLACEMENT_ATTEMPTS = 120
+FRAME_SIZE_RANGE = (10, 16)
+GRID_SIZE_RANGE = (20, 30)
+SLOT_LENGTH_RANGE = (2, 6)
+PATTERNS = [
