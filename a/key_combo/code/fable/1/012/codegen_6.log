+        return int(slot["start"] - c0)
+    if slot["side"] == SIDE_RIGHT:
+        return int((c1 - c0) + (slot["start"] - r0))
+    if slot["side"] == SIDE_BOTTOM:
+        return int((c1 - c0) + (r1 - r0) + (c1 - slot["end"]))
+    return int((c1 - c0) * 2 + (r1 - r0) + (r1 - slot["end"]))
