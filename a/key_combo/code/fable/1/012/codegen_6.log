_GEN_SPRITE_COUNTS = (3, 4)
_GEN_WIDTH_RANGE = range(2, 5)
_GEN_HEIGHT_RANGE = range(1, 4)
_GEN_OUTPUT_W_RANGE = range(7, 10)
_GEN_INPUT_W_RANGE = range(9, 12)
