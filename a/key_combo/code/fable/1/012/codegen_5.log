    full[:q,q:]=tr
    full[q:,q:]=br
    full[q:,:q]=bl
    return full

def find_occ(g):
    uniq=sorted(set(map(int,g.reshape(-1))))
    cands=[]
    for color in uniq:
        pts=np.argwhere(g==color)
        r0,c0=pts.min(0); r1,c1=pts.max(0)
        h,w=r1-r0+1,c1-c0+1
        if h"'!=w or pts.shape[0]!=h*w:
            continue
        if np.all(g[r0:r1+1,c0:c1+1]==color):
            cands.append((pts.shape[0],color,(r0,c0,r1,c1)))
    print('"'cands',cands)
    return min(cands)

def solve(g):
    n=g.shape[0]
    _, occ_color, (r0,c0,r1,c1)=find_occ(g)
    occ=np.zeros_like(g,dtype=bool)
    occ[r0:r1+1,c0:c1+1]=True
    counts={}
    for r in range(n):
        for c in range(n):
            rr,cc=rot_cw_coord(r,c,n)
            if occ[r,c] or occ[rr,cc]:
                continue
            a=int(g[r,c]); b=int(g[rr,cc])
            counts.setdefault(a,{})[b]=counts.setdefault(a,{}).get(b,0)+1
    mp={a:max(d,key=d.get) for a,d in counts.items()}
    out=g.copy()
    for r in range(r0,r1+1):
        for c in range(c0,c1+1):
            sr,sc=rot_ccw_coord(r,c,n)
            out[r,c]=mp[int(g[sr,sc])]
    return out

for _ in range(20):
