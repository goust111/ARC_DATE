+    preferred = BRANCH_CYCLE[_GENERATE_CALL_COUNT % len(BRANCH_CYCLE)]
+    _GENERATE_CALL_COUNT += 1
+    branch_order = [preferred] + [b for b in ("hidden", "straight", "wall") if b != preferred]
