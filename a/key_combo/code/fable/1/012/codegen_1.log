+def _choose_box(
+    shape: tuple[int, int],
+    path: list[tuple[int, int]],
+    interval: dict[str, object],
+    branch: str,
+) -> tuple[int, int, int, int]:
+    h, w = shape
+    rt = int(interval["rt"])
+    rb = int(interval["rb"])
