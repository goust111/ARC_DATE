   122	def main(grid: np.ndarray) -> np.ndarray:
   123	    """Remove the gray occluder, restore the hidden diagonal trajectory, and redraw the concealed red bumper if one caused the bend.
   124	
   125	    Input structure:
   126	    - A black background contains a blue ray that starts from one cell on the bottom row and rises one row per step.
   127	    - Sparse red single-cell bumpers may redirect the ray, and a solid gray rectangle hides one middle segment.
   128	    - Outside the gray box, every visible blue cell and visible red bumper is already correct.
   129	
   130	    Rule:
   131	    - Detect the gray rectangle and keep everything outside it unchanged.
   132	    - Re-simulate the ray from the visible bottom start, trying both initial horizontal directions and either no hidden bumper or one hidden red bumper inside the gray box.
   133	    - Accept the unique candidate whose simulated blue cells outside the gray box match the input exactly, then replace gray cells with the true hidden content: blue on the traversed segment, black elsewhere, and the inferred red bumper if it was the hidden cause of the bend.
   134	
   135	    Key insight:
   136	    - The hidden region is solved by replaying the trajectory physics, not by interpolation: the visible before/after path uniquely determines whether the occluded segment stayed straight, bounced off a wall, or was bent by one concealed red blocker.
   137	    """
   138	    g = np.asarray(grid, dtype=int)
   139	    assert g.ndim == 2
   140	    h, w = g.shape
   141	
   142	    occluder = g == GREY
   143	    box = _bbox(occluder)
   144	    assert box is not None, "expected one gray occluder"
   145	    r0, c0, r1, c1 = box
   146	    assert np.all(occluder[r0 : r1 + 1, c0 : c1 + 1]), "gray cells must form a solid rectangle"
   147	    assert int(np.count_nonzero(occluder)) == (r1 - r0 + 1) * (c1 - c0 + 1), "occluder must be rectangular"
