+from __future__ import annotations
+
+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREY = 5
+
+MIN_OCCLUDER_H = 4
+MAX_OCCLUDER_H = 7
+MAX_GENERATION_ATTEMPTS = 400
+BRANCH_CYCLE = ("hidden", "straight", "wall", "hidden", "straight", "wall", "hidden")
+_GENERATE_CALL_COUNT = 0
