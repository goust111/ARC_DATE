+def _make_forced_trajectory(
+    h: int,
+    w: int,
+    start_col: int,
+    start_dc: int,
+    forced_red_rows: set[int],
+) -> tuple[list[tuple[int, int]], list[dict[str, object]], set[tuple[int, int]]] | None:
+    red_cells: set[tuple[int, int]] = set()
+    r = h - 1
+    c = int(start_col)
+    dc = int(start_dc)
+    path: list[tuple[int, int]] = []
+    states: list[dict[str, object]] = []
+
+    while True:
+        path.append((r, c))
+        if r == 0:
+            break
