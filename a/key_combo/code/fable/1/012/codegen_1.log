+    interval: dict[str, object],
+    branch: str,
+) -> tuple[int, int, int, int]:
+    h, w = shape
+    rt = int(interval["rt"])
+    rb = int(interval["rb"])
+    cells = [(r, c) for r, c in path if rt <= r <= rb]
+    if branch == "hidden":
