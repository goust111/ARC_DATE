+        dc_before = dc
+        forward: tuple[int, int] | None = None
+        event = "none"
+        blocker: tuple[int, int] | None = None
+
+        if c + dc_before < 0 or c + dc_before >= w:
+            if r in forced_red_rows:
+                return None
+            event = "wall"
+            dc = -dc_before
+        else:
+            forward = (r - 1, c + dc_before)
+            if r in forced_red_rows:
+                if c in (0, w - 1):
+                    return None
+                red_cells.add(forward)
+                event = "red"
+                blocker = forward
+                dc = -dc_before
+
+        next_cell = (r - 1, c + dc)
+        states.append(
+            {
+                "row": r,
+                "col": c,
+                "dc": dc_before,
+                "event": event,
+                "forward": forward,
+                "blocker": blocker,
+                "next": next_cell,
+            }
