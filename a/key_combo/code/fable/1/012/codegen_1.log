            sep_cols = range(max(0, start - GEN_NOTCH_CLEARANCE_PAD), min(width, end + GEN_NOTCH_CLEARANCE_PAD + 1))
            if side == "top":
                limit = min(bottom[c] - GEN_PROFILE_CLEARANCE for c in sep_cols)
            else:
