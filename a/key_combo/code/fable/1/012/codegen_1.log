+
+    candidates = [
+        (r, c)
+        for r in range(h)
+        for c in range(w)
+        if (r, c) not in path_set
+        and (r, c) not in red_cells
+        and (r, c) not in sensitive
+        and not _inside_box(box, (r, c))
