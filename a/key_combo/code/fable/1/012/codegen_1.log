   161	        for r in range(r0, r1 + 1)
   162	        for c in range(c0, c1 + 1)
   163	    )
   164	
   165	    outputs: dict[bytes, np.ndarray] = {}
   166	    for start_col in starts:
   167	        for start_dc in (-1, 1):
