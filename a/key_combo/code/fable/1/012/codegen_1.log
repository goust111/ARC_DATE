+
+    for rt in range(2, h - MIN_OCCLUDER_H):
+        max_rb = min(h - 3, rt + MAX_OCCLUDER_H - 1)
+        for rb in range(rt + MIN_OCCLUDER_H - 1, max_rb + 1):
+            events_inside = [
+                state
+                for state in states
+                if rt <= int(state["row"]) <= rb and state["event"] != "none"
