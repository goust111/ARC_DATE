def simulate(width, blocks, energy):
    starts = [b['start'] for b in blocks]
    collisions = 0
    boundary = False
    moved = False
    stalled = False
    i = 0
    while i < len(blocks):
        w = blocks[i]['width']
        if energy < w:
            stalled = True
            break
        steps_afford = energy // w
        cur_end = starts[i] + w - 1
        if i == len(blocks) - 1:
            dist = width - 1 - cur_end
            steps = min(steps_afford, dist)
            if steps:
                moved = True
            starts[i] += steps
            energy -= steps * w
            if steps == dist:
                boundary = True
            else:
                stalled = True
            break
        next_start = starts[i+1]
        gap = next_start - cur_end - 1
        steps = min(steps_afford, gap)
        if steps:
            moved = True
        starts[i] += steps
        energy -= steps * w
        if steps == gap:
            collisions += 1
            i += 1
            continue
        stalled = True
        break
    return starts, dict(collisions=collisions, boundary=boundary, moved=moved, stalled=stalled, energy=energy)


