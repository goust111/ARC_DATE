+import numpy as np
+
+
+BG = 0
+SIDES = ("up", "down", "left", "right")
+DIRS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+PALETTE = tuple(range(1, 10))
+
+FRAGMENT_COUNT_RANGE = (3, 5)
+FRAGMENT_SIZE_RANGE = (3, 5)
+INPUT_SIZE_RANGE = (16, 30)
+GEN_RETRIES = 600
+SCATTER_RETRIES = 160
