+def _ray_trace(
+    sprite_mask: np.ndarray,
+    tip: tuple[int, int],
+    direction: tuple[int, int],
+    shape: tuple[int, int],
+) -> tuple[list[tuple[int, int]], bool]:
+    height, width = map(int, shape)
+    dr, dc = map(int, direction)
+    r, c = int(tip[0]) + dr, int(tip[1]) + dc
