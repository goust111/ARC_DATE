+
+def _place_arrows(
+    grid: np.ndarray,
+    sprite_mask: np.ndarray,
+    valid_counts: dict[str, int],
+    invalid_counts: dict[str, int],
+    arrow_palette: list[int],
+) -> list[dict] | None:
