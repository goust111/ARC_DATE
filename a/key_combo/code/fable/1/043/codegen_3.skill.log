+        arrow_areas = sorted(int(component["area"]) for component in comps)
+        expected_arrows = sum(valid_counts.values()) + sum(invalid_counts.values())
+        if arrow_areas.count(4) != expected_arrows or max(arrow_areas, default=0) <= 4:
