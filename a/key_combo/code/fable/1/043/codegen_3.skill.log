+
+BG = int(Color.BLACK)
+ORIENTATIONS = ("up", "right", "down", "left")
+DIRECTIONS = {
+    "up": (-1, 0),
+    "right": (0, 1),
+    "down": (1, 0),
+    "left": (0, -1),
+}
+ROTATE_K = {
+    "up": 0,
+    "right": -1,
+    "down": 2,
+    "left": 1,
+}
+ARROW_MASKS = {
+    "up": np.array([[0, 1, 0], [1, 1, 1]], dtype=bool),
+    "right": np.array([[1, 0], [1, 1], [1, 0]], dtype=bool),
+    "down": np.array([[1, 1, 1], [0, 1, 0]], dtype=bool),
+    "left": np.array([[0, 1], [1, 1], [0, 1]], dtype=bool),
+}
+ARROW_TIPS = {
+    "up": (0, 1),
+    "right": (1, 1),
+    "down": (1, 1),
+    "left": (1, 0),
+}
+VALID_COUNT_TEMPLATES = [
+    (2, 1, 0, 0),
+    (3, 1, 1, 0),
+    (3, 2, 1, 0),
