+        width = random.randint(max(16, sprite.shape[1] + 10), min(30, sprite.shape[1] + 18))
+        grid = np.full((height, width), BG, dtype=int)
+
+        try:
+            sprite_r, sprite_c = random_free_location(
+                grid,
+                sprite,
+                transparent=BG,
+                border=SPRITE_BORDER,
+                padding=0,
+                padding_connectivity=4,
