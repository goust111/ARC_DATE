+    bg = _get_bg(g)
+    _sep_color, panel_w, n_panels, _cols = _find_separator_layout(g, bg)
+    panels = _split_panels(g, panel_w, n_panels)
+    return _accordion_output_from_panels(panels, bg, mirror_odd=True)
