import numpy as np


def _find_sample_stencil(g: np.ndarray) -> tuple[int, int]:
    candidates: list[tuple[int, int]] = []
    for r in range(g.shape[0] - 3):
        for c in range(g.shape[1] - 3):
            if np.all(g[r : r + 3, c + 3] == 5) and np.all(g[r + 3, c : c + 4] == 5):
