        max_seg = min(MAX_SEGMENT_LEN, max_fwd - 1)
        seg_len = random.choices(range(1, max_seg + 1), weights=range(1, max_seg + 1))[0]
        pos = _extend_path(grid, path_cells, r, c, dr, dc, seg_len, allow_path_color=True)
        if pos is None:
