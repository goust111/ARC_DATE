0244: def _mutate_shape(mask: np.ndarray, *, n_remove_max: int, symmetric: bool = False) -> np.ndarray:
0245:     """Remove boundary cells from a rect mask while preserving 4-connectivity.
0246:     Keeps the original (h, w) bbox; removed cells become False but array shape is unchanged.
0247:     If symmetric=True, mirror-pair removals so the mask stays LR-symmetric.
0248:     """
0249:     m = mask.copy()
0250:     H, W = m.shape
0251:     n_remove = random.randint(1, max(1, n_remove_max))
0252:     tried = 0
0253:     removed = 0
0254:     while removed < n_remove and tried < MAX_MUTATE_ATTEMPTS:
0255:         tried += 1
0256:         # Find boundary cells (cells with <=2 in-mask 4-neighbors).
0257:         cand = []
0258:         for r in range(H):
0259:             for c in range(W):
0260:                 if not m[r, c]:
0261:                     continue
0262:                 nb = 0
0263:                 for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
0264:                     nr, nc = r + dr, c + dc
0265:                     if 0 <= nr < H and 0 <= nc < W and m[nr, nc]:
0266:                         nb += 1
0267:                 if nb <= 2:
0268:                     cand.append((r, c))
0269:         if not cand:
0270:             break
0271:         r, c = random.choice(cand)
0272:         to_remove = [(r, c)]
0273:         if symmetric:
0274:             mc = W - 1 - c
0275:             if (r, mc) != (r, c):
0276:                 to_remove.append((r, mc))
0277:         m2 = m.copy()
0278:         for rr, cc in to_remove:
0279:             m2[rr, cc] = False
0280:         if not m2.any():
0281:             continue
0282:         _, n_components = label_mask(m2, connectivity=4)
0283:         if int(n_components) == 1:
0284:             m = m2
0285:             removed += len(to_remove)
0286:     if not m.any():
0287:         return mask.copy()
0288:     return m
