0153:     ahead_r, ahead_c = r + dr, c + dc
0154:     if grid[ahead_r, ahead_c] != BG_COLOR:
0155:         return None
0156: 
0157:     perps = [(-dc, dr), (dc, -dr)]
0158:     random.shuffle(perps)
0159:     for chosen_dir in perps:
0160:         other_dir = perps[1] if chosen_dir is perps[0] else perps[0]
0161:         cr, cc = r + chosen_dir[0], c + chosen_dir[1]
0162:         otr, otc = r + other_dir[0], c + other_dir[1]
