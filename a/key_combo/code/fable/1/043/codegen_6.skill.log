0515: def _size_in_spec(grid: np.ndarray) -> bool:
0516:     h, w = grid.shape
0517:     return (OBJECT_H_RANGE[0] <= h <= OBJECT_H_RANGE[1]
0518:             and OBJECT_W_RANGE[0] <= w <= OBJECT_W_RANGE[1])
