+        cells.add((source[0] - or_, source[1] - oc))
+    return source, cells
+
+
+def _attach_source(
+    grid: np.ndarray,
+    leaf_spec: dict,
+    depth: int,
+    source_color: int,
+    floor_color: int,
+    wall_color: int,
+) -> tuple[int, int] | None:
+    leaf = _node_coord(leaf_spec["node"])
+    neighbor = _node_coord(leaf_spec["neighbor"])
+    source, cells = _pocket_cells(leaf, leaf_spec["outward"], depth)
