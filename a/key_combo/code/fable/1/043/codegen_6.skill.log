0028: def main(grid: np.ndarray) -> np.ndarray:
0029:     """
0030:     Connect every pair of aligned teal marker pixels by painting the gap between them green.
0031: 
0032:     Input structure
0033:     - The grid has a dominant background color and exactly one non-background marker color.
0034:     - Marker pixels are isolated endpoints; any row or column contains zero, one, or two markers.
0035:     - Green is absent from the input and is reserved for the added connector segments.
0036: 
0037:     Rule
0038:     - Preserve the input grid.
0039:     - For each row with exactly two markers, paint the background pixels strictly between them green.
0040:     - For each column with exactly two markers, paint the background pixels strictly between them green.
0041: 
0042:     Key insight
0043:     - The sparse markers are endpoints of missing axis-aligned bars; only same-row or same-column pairs authorize a fill.
0044:     """
0045:     g = np.asarray(grid, dtype=int)
0046:     assert g.ndim == 2, "expected a 2D grid"
0047: 
0048:     bg = get_bg(g)
0049:     foreground = colors_present(g, exclude={bg})
0050:     assert len(foreground) == 1, "expected exactly one marker color"
0051:     assert Color.GREEN not in foreground and bg != Color.GREEN, "green must be absent from the input"
0052:     marker = foreground[0]
0053: 
0054:     marker_coords = np.argwhere(g == marker)
0055:     assert len(marker_coords) > 0, "expected at least one marker"
0056: 
0057:     out = g.copy()
0058:     _paint_between_pairs(g, out, bg, marker, Color.GREEN)
0059:     return out
