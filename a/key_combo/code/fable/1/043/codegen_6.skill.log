0315: # =============================================================================
0316: # Layout design — LR-symmetric cavity arrangements
0317: # =============================================================================
0318: #
0319: # Slot dict fields:
0320: #   r0          : top row in layout coordinate space
0321: #   col_offset  : leftmost column relative to the LR symmetry axis
0322: #   shape_dst   : boolean mask for dst's version of this cavity
0323: #   shape_src   : boolean mask for src's version (independently mutated)
0324: #   pair_id     : mirror-pair identifier — slots sharing a pair_id are LR mirrors
0325: #                 (used to give them matching fill colors by default)
0326: # =============================================================================
0327: 
0328: def _add_centered_slot(slots: list[dict], cur_r: int, pair_id: int, row_h: int) -> None:
0329:     """k=1: single cavity centered on the LR axis (odd width, LR-symmetric shape)."""
0330:     w = random.choice(CENTERED_SLOT_WIDTHS)
0331:     dst, src = _gen_dst_src_pair(row_h, w, symmetric=True)
0332:     slots.append({
0333:         'r0': cur_r, 'col_offset': -(w // 2),
0334:         'shape_dst': dst, 'shape_src': src, 'pair_id': pair_id,
0335:     })
0336: 
0337: 
0338: def _add_mirror_pair_slots(slots: list[dict], cur_r: int, pair_id: int, row_h: int) -> None:
0339:     """k=2: left + right mirror pair with an odd empty-column gap at the axis."""
0340:     w = random.choice(PAIR_SLOT_WIDTHS)
0341:     dst_L, src_L = _gen_dst_src_pair(row_h, w, symmetric=False)
0342:     dst_R = _mirror_shape(dst_L)
0343:     src_R = _mirror_shape(src_L)
0344:     axis_gap = random.choice(PAIR_AXIS_GAP_CHOICES)
0345:     if axis_gap % 2 == 0:
0346:         axis_gap += 1  # force odd so axis lies on a single column
0347:     half = axis_gap // 2
0348:     slots.append({
0349:         'r0': cur_r, 'col_offset': -(half + w),
0350:         'shape_dst': dst_L, 'shape_src': src_L, 'pair_id': pair_id,
0351:     })
0352:     slots.append({
0353:         'r0': cur_r, 'col_offset': half + 1,
0354:         'shape_dst': dst_R, 'shape_src': src_R, 'pair_id': pair_id,
0355:     })
0356: 
0357: 
0358: def _add_trio_slots(slots: list[dict], cur_r: int, pair_id: int, row_h: int) -> None:
0359:     """k=3: L + centered + R. Center slot has odd width and uses its own pair_id."""
0360:     w_side = random.choice(SIDE_SLOT_WIDTHS)
0361:     w_mid = random.choice(MID_SLOT_WIDTHS)
0362:     dst_L, src_L = _gen_dst_src_pair(row_h, w_side, symmetric=False)
0363:     dst_R = _mirror_shape(dst_L)
0364:     src_R = _mirror_shape(src_L)
0365:     dst_M, src_M = _gen_dst_src_pair(row_h, w_mid, symmetric=True)
0366:     mid_half = w_mid // 2
0367:     slots.append({
0368:         'r0': cur_r, 'col_offset': -(mid_half + w_side + TRIO_MID_SIDE_GAP),
0369:         'shape_dst': dst_L, 'shape_src': src_L, 'pair_id': pair_id,
0370:     })
0371:     slots.append({
0372:         'r0': cur_r, 'col_offset': -mid_half,
0373:         'shape_dst': dst_M, 'shape_src': src_M, 'pair_id': pair_id + 1,
0374:     })
0375:     slots.append({
0376:         'r0': cur_r, 'col_offset': mid_half + TRIO_MID_SIDE_GAP + 1,
0377:         'shape_dst': dst_R, 'shape_src': src_R, 'pair_id': pair_id,
0378:     })
0379: 
0380: 
0381: def _pick_layout_k(budget: int) -> int:
0382:     """Pick the layout pattern for the current row, given remaining cavity budget."""
0383:     if budget == 1:
0384:         return 1
0385:     if budget == 2:
0386:         return random.choice(LAYOUT_K_CHOICES_SMALL)
0387:     return random.choice(LAYOUT_K_CHOICES_FULL)
0388: 
0389: 
0390: def _design_layout(n_target: int) -> list[dict]:
0391:     """Return an LR-symmetric list of cavity slots with a total count near n_target."""
0392:     slots: list[dict] = []
0393:     cur_r = 0
0394:     pair_id = 0
0395:     budget = n_target
0396:     while len(slots) < n_target and cur_r < MAX_LAYOUT_R_BUDGET and budget > 0:
0397:         row_h = random.choice(ROW_HEIGHT_CHOICES)
0398:         k = _pick_layout_k(budget)
0399:         if k == 1:
0400:             _add_centered_slot(slots, cur_r, pair_id, row_h)
0401:             pair_id += 1
0402:             budget -= 1
0403:         elif k == 2:
0404:             _add_mirror_pair_slots(slots, cur_r, pair_id, row_h)
0405:             pair_id += 1
0406:             budget -= 2
0407:         else:
0408:             _add_trio_slots(slots, cur_r, pair_id, row_h)
0409:             pair_id += 2  # trio uses 2 pair_ids (outer pair + center)
0410:             budget -= 3
0411:         cur_r += row_h + random.choice(ROW_GAP_CHOICES)
0412:     return slots
