+def _bfs_with_target(passable: np.ndarray, start: tuple[int, int], end: tuple[int, int]) -> np.ndarray:
+    walkable = passable.copy()
+    walkable[start] = True
+    walkable[end] = True
+    return bfs_distances(walkable, start)
