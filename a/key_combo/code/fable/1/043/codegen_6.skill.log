0110: def _gen_grow_cells(height, width, count, occupied):
0111:     free = {
0112:         (r, c)
0113:         for r in range(INTERIOR_ROW_START, height - 1)
0114:         for c in range(width)
0115:         if (r, c) not in occupied
0116:     }
0117:     if len(free) < count:
0118:         return None
0119: 
0120:     component_limit = MAX_COMPONENTS_LARGE if count >= LARGE_COMPONENT_THRESHOLD else MAX_COMPONENTS_SMALL
0121:     max_components = min(count, component_limit)
0122:     component_count = int(np.random.randint(1, max_components + 1))
0123:     sizes = _gen_partition(count, component_count)
0124:     cells = []
0125: 
0126:     for size in sizes:
0127:         if not free:
0128:             return None
0129:         seed = _gen_pick(tuple(free))
0130:         free.remove(seed)
0131:         cells.append(seed)
0132:         component = [seed]
0133:         frontier = {nb for nb in _gen_neighbors(seed, height, width) if nb in free}
0134:         mode = int(np.random.randint(GROWTH_MODE_COUNT))
0135:         head = seed
0136:         direction = _gen_pick(ORTHOGONAL_STEPS)
0137: 
0138:         while len(component) < size:
0139:             if mode == 1:
0140:                 candidates = [nb for nb in _gen_neighbors(head, height, width) if nb in free]
