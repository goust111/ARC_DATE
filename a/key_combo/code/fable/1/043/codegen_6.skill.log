+def _build_sparse_tree(
+    h: int,
+    w: int,
+    expect_ties: bool,
+) -> tuple[dict[tuple[int, int], set[tuple[int, int]]], list[tuple[int, int]]] | None:
+    max_nodes = min(max(9, (h * w) // 3), 18)
