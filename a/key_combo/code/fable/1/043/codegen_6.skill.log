- Indexing: always `grid[r, c]`.
- Coords: always `(r, c)`.
- BBox: `(r0, c0, r1, c1)` inclusive.
"""

from __future__ import annotations

import math
import random
import itertools
import warnings
from collections import Counter
from typing import Iterable, Iterator, Sequence

