0426:       - cropped        : the object, with cavities painted bg if filled=False else fill-colored
0427:       - filled_cropped : same object, ALWAYS with cavities fill-colored (used as the
0428:                          expected main() output for dst)
0429: 
0430:     Returns (None, None) if there are no fill cells.
0431:     """
0432:     # Compute layout bbox across all cavity cells.
0433:     placed_slots = []
0434:     for slot_idx, (slot, sh) in enumerate(zip(layout, shapes)):
0435:         rr, cc = np.where(sh)
0436:         if len(rr) == 0:
0437:             continue
0438:         placed_slots.append((slot_idx, slot['r0'] + rr, slot['col_offset'] + cc))
0439:     if not placed_slots:
0440:         return None, None
0441: 
0442:     all_rows = np.concatenate([p[1] for p in placed_slots])
0443:     all_cols = np.concatenate([p[2] for p in placed_slots])
0444:     r_min, r_max = int(all_rows.min()), int(all_rows.max())
0445:     c_min, c_max = int(all_cols.min()), int(all_cols.max())
0446: 
0447:     pad = 2
0448:     H = (r_max - r_min + 1) + 2 * pad
0449:     W = (c_max - c_min + 1) + 2 * pad
0450: 
0451:     canvas = np.full((H, W), bg, dtype=int)
0452:     fill_mask = np.zeros((H, W), dtype=bool)
0453:     for slot_idx, rows, cols in placed_slots:
0454:         rr = rows - r_min + pad
0455:         cc = cols - c_min + pad
0456:         canvas[rr, cc] = colors[slot_idx]
0457:         fill_mask[rr, cc] = True
0458: 
0459:     # Vectorized 4-neighbor outline = cells adjacent to any fill cell but not fill themselves.
0460:     outline_mask = np.zeros_like(fill_mask)
0461:     outline_mask[1:, :]  |= fill_mask[:-1, :]
0462:     outline_mask[:-1, :] |= fill_mask[1:, :]
0463:     outline_mask[:, 1:]  |= fill_mask[:, :-1]
0464:     outline_mask[:, :-1] |= fill_mask[:, 1:]
0465:     outline_mask &= ~fill_mask
0466:     canvas[outline_mask] = outline_col
0467: 
0468:     filled_grid = canvas.copy()
0469:     if not filled:
0470:         canvas[fill_mask] = bg
0471: 
0472:     b = bbox(canvas != bg)
0473:     if b is None:
0474:         return None, None
0475:     cropped = crop_bbox(canvas, b)
0476:     r0b, c0b, r1b, c1b = b
0477:     filled_cropped = filled_grid[r0b:r1b + 1, c0b:c1b + 1]
0478:     return cropped, filled_cropped
