0008: 
0009: def main(grid: np.ndarray) -> np.ndarray:
0010:     """
0011:     Extend the edge-touching green start bar through the corridor, turning at each teal blocker until the path leaves the grid.
0012: 
0013:     Input structure:
0014:     - The background is the most common color.
0015:     - Exactly two foreground colors are present: a 2-pixel 4-connected start bar and many blocker pixels.
0016:     - Exactly one pixel of the start bar lies on the grid border.
0017: 
0018:     Rule:
0019:     - Start from the border pixel of the bar and move through the other bar pixel into the grid.
0020:     - Paint every traversed non-blocker pixel with the start color.
0021:     - When the next cell is a blocker, turn to the unique perpendicular non-blocker neighbor; when the next cell is outside the grid, stop.
0022: 
0023:     Key insight: The blocker pixels define a one-cell-wide corridor, so every interior collision has exactly one valid 90-degree turn.
0024:     """
0025:     g = np.asarray(grid, dtype=int)
0026:     H, W = g.shape
0027: 
0028:     bg = int(get_bg(g))
0029:     fg_colors = colors_present(g, exclude={bg})
0030:     assert len(fg_colors) == 2, "expected a path color and a blocker color"
0031: 
0032:     counts = {c: int(np.count_nonzero(g == c)) for c in fg_colors}
0033:     path_colors = [c for c, n in counts.items() if n == 2]
0034:     assert len(path_colors) == 1, "expected exactly one 2-pixel start bar"
0035:     path_color = int(path_colors[0])
0036:     blocker_color = int([c for c in fg_colors if c != path_color][0])
0037: 
0038:     start_pixels = [tuple(map(int, rc)) for rc in np.argwhere(g == path_color)]
0039:     assert len(start_pixels) == 2
0040:     (r0, c0), (r1, c1) = start_pixels
0041:     assert abs(r0 - r1) + abs(c0 - c1) == 1, "start bar must be 4-connected"
0042: 
0043:     def is_border(pixel: tuple[int, int]) -> bool:
0044:         r, c = pixel
0045:         return r == 0 or r == H - 1 or c == 0 or c == W - 1
0046: 
0047:     border_pixels = [p for p in start_pixels if is_border(p)]
0048:     assert len(border_pixels) == 1, "exactly one start pixel must touch the border"
0049:     border_pixel = border_pixels[0]
0050:     inner_pixel = start_pixels[1] if start_pixels[0] == border_pixel else start_pixels[0]
0051: 
0052:     dr = int(inner_pixel[0] - border_pixel[0])
0053:     dc = int(inner_pixel[1] - border_pixel[1])
0054:     assert abs(dr) + abs(dc) == 1
0055: 
0056:     out = g.copy()
0057:     r, c = inner_pixel
0058:     seen_states: set[tuple[int, int, int, int]] = set()
0059: 
0060:     while True:
0061:         state = (r, c, dr, dc)
0062:         assert state not in seen_states, "path walk should not cycle"
0063:         seen_states.add(state)
0064: 
0065:         nr, nc = r + dr, c + dc
0066:         if not in_bounds(g.shape, nr, nc):
0067:             break
0068: 
0069:         if int(g[nr, nc]) != blocker_color:
0070:             out[nr, nc] = path_color
0071:             r, c = int(nr), int(nc)
0072:             continue
0073: 
0074:         choices: list[tuple[int, int]] = []
0075:         for tdr, tdc in ((-dc, dr), (dc, -dr)):
0076:             tr, tc = r + tdr, c + tdc
0077:             if in_bounds(g.shape, tr, tc) and int(g[tr, tc]) != blocker_color:
0078:                 choices.append((int(tdr), int(tdc)))
0079: 
0080:         assert len(choices) == 1, "each blocker collision must have one valid turn"
0081:         dr, dc = choices[0]
0082: 
0083:     return out
