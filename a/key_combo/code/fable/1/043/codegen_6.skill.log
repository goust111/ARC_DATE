0079: def _gen_axis_pair_choices(length: int, pair_count: int) -> list[tuple[tuple[int, int], ...]]:
0080:     """All ways to pick disjoint aligned endpoint pairs along one axis."""
0081:     if pair_count == 0:
0082:         return [()]
0083:     min_span, max_span = _GEN_MIN_GAP + 1, _GEN_MAX_GAP + 1
0084:     pairs = [
0085:         (a, b)
0086:         for a in range(length)
0087:         for b in range(a + min_span, min(length, a + max_span + 1))
0088:     ]
0089:     if pair_count == 1:
0090:         return [(p,) for p in pairs]
0091: 
0092:     choices: list[tuple[tuple[int, int], ...]] = []
0093:     for combo in itertools.combinations(pairs, pair_count):
0094:         used = [x for pair in combo for x in pair]
0095:         if len(set(used)) == len(used):
0096:             choices.append(combo)
0097:     return choices
