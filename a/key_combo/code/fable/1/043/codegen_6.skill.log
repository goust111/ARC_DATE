0107: def _max_forward(r, c, dr, dc, H, W):
0108:     """Return the number of in-bounds cells before leaving the grid."""
0109:     steps = 0
0110:     while True:
0111:         r, c = r + dr, c + dc
0112:         if r < 0 or r >= H or c < 0 or c >= W:
0113:             return steps
0114:         steps += 1
