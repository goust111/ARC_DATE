+    dist[sr, sc] = 0
+    q: deque[tuple[int, int]] = deque([(sr, sc)])
+    while q:
+        r, c = q.popleft()
+        step = int(dist[r, c]) + 1
+        for nr, nc in neighbors4(r, c):
+            if not in_bounds(passable.shape, nr, nc):
+                continue
+            if dist[nr, nc] != -1 or not bool(passable[nr, nc]):
+                continue
+            dist[nr, nc] = step
+            q.append((nr, nc))
+    return dist
