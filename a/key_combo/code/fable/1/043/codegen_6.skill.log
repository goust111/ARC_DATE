+def _tree_path(
+    tree: dict[tuple[int, int], set[tuple[int, int]]],
+    start: tuple[int, int],
+    end: tuple[int, int],
+) -> list[tuple[int, int]]:
+    parent = {start: None}
+    q: deque[tuple[int, int]] = deque([start])
+    while q:
+        cur = q.popleft()
+        if cur == end:
+            break
+        for nb in tree[cur]:
+            if nb in parent:
+                continue
+            parent[nb] = cur
+            q.append(nb)
+    assert end in parent
+    path = []
+    cur = end
+    while cur is not None:
+        path.append(cur)
+        cur = parent[cur]
