0525: def _assign_pair_colors(layout: list[dict], fill_pool: list[int]) -> list[int]:
0526:     """Return one color per slot. Mirror-pair slots (same pair_id) share a color by
0527:     default, with COLOR_MISMATCH_RATE fraction of cavities randomly broken to differ.
0528:     """
0529:     unique_pair_ids: list[int] = []
0530:     for slot in layout:
0531:         if slot['pair_id'] not in unique_pair_ids:
0532:             unique_pair_ids.append(slot['pair_id'])
0533:     n_pairs = len(unique_pair_ids)
0534:     n_colors = len(fill_pool)
0535: 
0536:     # Ensure all pool colors are used when n_pairs >= n_colors; otherwise
0537:     # use a subset of pool colors (one per pair).
0538:     if n_pairs >= n_colors:
0539:         pair_colors = list(fill_pool) + [random.choice(fill_pool)
0540:                                          for _ in range(n_pairs - n_colors)]
0541:     else:
0542:         pair_colors = list(fill_pool)[:n_pairs]
0543:     random.shuffle(pair_colors)
0544: 
0545:     pair_color_map = dict(zip(unique_pair_ids, pair_colors))
0546:     colors = [pair_color_map[slot['pair_id']] for slot in layout]
0547: 
0548:     # Occasional mismatch: break LR color symmetry in a fraction of cavities.
0549:     for i in range(len(colors)):
0550:         if random.random() < COLOR_MISMATCH_RATE:
0551:             colors[i] = random.choice(fill_pool)
0552:     return colors
0553: 
