0030: def main(grid: np.ndarray) -> np.ndarray:
0031:     """
0032:     Find the duplicate of the 3x3 sample marked by a grey L-stencil and draw a grey frame around it.
0033: 
0034:     Input structure:
0035:     - A 3x3 sample region is marked by grey pixels immediately to its right and below, forming an L-stencil.
0036:     - The same 3x3 color pattern appears exactly once elsewhere in the grid.
0037:     - The duplicate has a one-cell margin available on every side.
0038: 
0039:     Rule:
0040:     - Read the 3x3 sample from the upper-left side of the grey L-stencil.
0041:     - Locate the unique other exact occurrence of that 3x3 sample.
0042:     - Paint a one-cell-thick grey rectangular frame around the duplicate sample, preserving its interior.
0043: 
0044:     Key insight:
0045:     The grey L is not the target frame itself; it identifies the small sample whose matching copy should be framed.
0046:     """
0047:     g = np.asarray(grid, dtype=int)
0048:     source = _find_sample_stencil(g)
0049:     sr, sc = source
0050:     sample = g[sr : sr + 3, sc : sc + 3]
0051:     tr, tc = _find_matching_sample(g, sample, source)
0052: 
0053:     assert tr > 0 and tc > 0, "duplicate sample must have top and left frame margins"
0054:     assert tr + 3 < g.shape[0] and tc + 3 < g.shape[1], "duplicate sample must have bottom and right frame margins"
0055: 
0056:     out = g.copy()
0057:     out[tr - 1 : tr + 4, tc - 1] = 5
0058:     out[tr - 1 : tr + 4, tc + 3] = 5
0059:     out[tr - 1, tc - 1 : tc + 4] = 5
0060:     out[tr + 3, tc - 1 : tc + 4] = 5
0061:     return out
0062: 
