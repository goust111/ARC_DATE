0068: _GEN_SAMPLE_SIZE, _GEN_STENCIL_SIZE, _GEN_FRAME_PAD = 3, 4, 1
0069: _GEN_SAMPLE_CELLS = _GEN_SAMPLE_SIZE * _GEN_SAMPLE_SIZE
0070: _GEN_SAMPLE_NONZERO_RANGE = (4, 6)
