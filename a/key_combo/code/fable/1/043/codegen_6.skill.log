0291: def _gen_shape(h: int, w: int, *, nonrect: bool, symmetric: bool = False) -> np.ndarray:
0292:     """Build a cavity shape. If symmetric=True, the result is LR-symmetric."""
0293:     m = _random_rect_shape(h, w)
0294:     if nonrect and h * w >= 3:
0295:         # Remove up to half the area; symmetric mutations consume cells in pairs.
0296:         limit = max(1, (h * w) // 2)
0297:         m = _mutate_shape(m, n_remove_max=limit, symmetric=symmetric)
0298:     return m
