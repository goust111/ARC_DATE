0142:                 nr, nc = head[0] + direction[0], head[1] + direction[1]
0143:                 candidates = [(nr, nc)] if (nr, nc) in free else []
0144:             else:
0145:                 candidates = list(frontier)
0146: 
0147:             if not candidates:
