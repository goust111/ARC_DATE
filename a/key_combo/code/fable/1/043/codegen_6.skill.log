0149:             if not candidates:
0150:                 if not free:
0151:                     return None
0152:                 nxt = _gen_pick(tuple(free))
0153:             else:
0154:                 nxt = _gen_pick(candidates)
0155: 
0156:             free.remove(nxt)
0157:             cells.append(nxt)
0158:             component.append(nxt)
0159:             head = nxt
0160:             if mode == STRAIGHT_GROWTH_MODE and np.random.random() < STRAIGHT_TURN_PROB:
0161:                 direction = _gen_pick(ORTHOGONAL_STEPS)
