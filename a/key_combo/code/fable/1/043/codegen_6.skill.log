+    for i in range(1, len(path) - 1):
+        prev_step = (int(path[i][0] - path[i - 1][0]), int(path[i][1] - path[i - 1][1]))
+        next_step = (int(path[i + 1][0] - path[i][0]), int(path[i + 1][1] - path[i][1]))
+        if prev_step != next_step:
+            turns += 1
+    return turns
