+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+DIR4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+GEN_PAD = 3
+GEN_COARSE_MIN = 5
+GEN_COARSE_MAX = 12
+GEN_ATTEMPTS = 500
+GEN_MIN_EDGE_DISTANCE = 5
+GEN_MIN_TURNS = 3
+GEN_MIN_ASSIGNED = 10
+GEN_MIN_TIES = 2
