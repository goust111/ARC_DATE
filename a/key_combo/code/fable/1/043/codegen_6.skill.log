0301: def _mirror_shape(m: np.ndarray) -> np.ndarray:
0302:     return m[:, ::-1].copy()
0303: 
0304: 
0305: def _gen_dst_src_pair(h: int, w: int, *, symmetric: bool) -> tuple[np.ndarray, np.ndarray]:
0306:     """Independently mutate two cavity shapes (dst + src) sharing the same (h, w) bbox.
0307:     This drives src subsprites and dst holes to have visibly different shapes, as required
0308:     by the spec (the task matches by centroid rank, not shape).
0309:     """
0310:     nonrect = random.random() < NONRECT_PROBABILITY
0311:     return (_gen_shape(h, w, nonrect=nonrect, symmetric=symmetric),
0312:             _gen_shape(h, w, nonrect=nonrect, symmetric=symmetric))
