0567: def _build_object_pair(
0568:     layout: list[dict], colors: list[int], bg: int, outline_col: int,
0569: ) -> tuple[np.ndarray, np.ndarray, np.ndarray] | None:
0570:     """Render src (filled) + dst (empty) from the layout and validate both.
0571:     Returns (src_cropped, dst_cropped, expected_output) or None on failure.
0572:     """
0573:     n_cavities = len(layout)
0574:     dst_shapes = [slot['shape_dst'] for slot in layout]
0575:     src_shapes = [slot['shape_src'] for slot in layout]
0576: 
0577:     dst_cropped, dst_filled = _render_object(
0578:         layout, dst_shapes, colors, bg, outline_col, filled=False,
0579:     )
0580:     if dst_cropped is None:
0581:         return None
0582:     if not _is_8connected(dst_cropped, bg):
0583:         return None
0584:     if _count_enclosed_bg_holes(dst_cropped, bg) != n_cavities:
0585:         return None
0586:     if not _size_in_spec(dst_cropped):
0587:         return None
0588: 
0589:     src_cropped, _ = _render_object(
0590:         layout, src_shapes, colors, bg, outline_col, filled=True,
0591:     )
0592:     if src_cropped is None:
0593:         return None
0594:     if not _is_8connected(src_cropped, bg):
0595:         return None
0596:     if _count_4conn_cavities(src_cropped, bg, outline_col) != n_cavities:
0597:         return None
0598:     if not _size_in_spec(src_cropped):
0599:         return None
0600: 
0601:     # Expected output = dst with holes filled by matched colors, tight-cropped.
0602:     return src_cropped, dst_cropped, dst_filled
