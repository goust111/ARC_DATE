0116: def _gen_make_sample(rng: np.random.Generator) -> np.ndarray:
0117:     nz_min, nz_stop = _GEN_SAMPLE_NONZERO_RANGE
0118:     distinct_min, distinct_max = _GEN_SAMPLE_DISTINCT_MIN_MAX
0119:     nonzero_count = int(rng.integers(nz_min, nz_stop))
0120:     distinct_count = int(rng.integers(distinct_min, min(distinct_max, nonzero_count) + 1))
0121:     colors = rng.choice(_GEN_SAMPLE_COLORS, size=distinct_count, replace=False)
0122:     extra = rng.choice(colors, size=nonzero_count - distinct_count, replace=True)
0123:     values = np.concatenate([colors, extra])
0124:     rng.shuffle(values)
0125: 
0126:     flat = np.zeros(_GEN_SAMPLE_CELLS, dtype=int)
0127:     positions = rng.choice(_GEN_SAMPLE_CELLS, size=nonzero_count, replace=False)
0128:     flat[positions] = values
0129:     return flat.reshape((_GEN_SAMPLE_SIZE, _GEN_SAMPLE_SIZE))
