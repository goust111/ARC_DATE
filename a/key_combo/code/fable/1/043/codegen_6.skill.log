0485: def _count_4conn_cavities(filled_grid: np.ndarray, bg: int, outline_col: int) -> int:
0486:     """Count 4-connected non-bg non-outline components (i.e. filled cavities)."""
0487:     mask = (filled_grid != bg) & (filled_grid != outline_col)
0488:     _, n = label_mask(mask, connectivity=4)
0489:     return int(n)
0490: 
0491: 
0492: def _count_enclosed_bg_holes(empty_grid: np.ndarray, bg: int) -> int:
0493:     """Count 4-connected bg components fully enclosed by non-bg cells (not touching border)."""
0494:     mask = (empty_grid == bg)
0495:     lab, n = label_mask(mask, connectivity=4)
0496:     H, W = empty_grid.shape
0497:     count = 0
0498:     for cid in range(1, int(n) + 1):
0499:         pts = np.argwhere(lab == cid)
0500:         r0, c0 = pts.min(axis=0)
0501:         r1, c1 = pts.max(axis=0)
0502:         if r0 > 0 and c0 > 0 and r1 < H - 1 and c1 < W - 1:
0503:             count += 1
0504:     return count
0505: 
0506: 
0507: def _is_8connected(grid: np.ndarray, bg: int) -> bool:
0508:     mask = grid != bg
0509:     if not mask.any():
0510:         return False
0511:     _, n = label_mask(mask, connectivity=8)
0512:     return int(n) == 1
0513: 
