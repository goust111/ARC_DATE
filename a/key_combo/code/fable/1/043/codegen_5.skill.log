+    directions = list(PAIR_DIRS)
+    random.shuffle(directions)
+
+    for dr, dc in directions:
+        max_dist = max(h, w)
+        distances = [d for d in range(5, max_dist) if d % 2 == 1]
+        random.shuffle(distances)
+        for dist in distances:
+            r_min = MIN_CENTER + max(0, -dr * dist)
+            r_max = (h - 1 - MIN_CENTER) - max(0, dr * dist)
+            c_min = MIN_CENTER + max(0, -dc * dist)
+            c_max = (w - 1 - MIN_CENTER) - max(0, dc * dist)
+            if r_min > r_max or c_min > c_max:
+                continue
+            for _ in range(20):
+                center_a = (random.randint(r_min, r_max), random.randint(c_min, c_max))
+                center_b = (int(center_a[0] + dr * dist), int(center_a[1] + dc * dist))
+                return center_a, center_b
+    return None
+
+
+def _find_valid_extra_blocks(shape: tuple[int, int], blocks: list[dict], color: int) -> list[tuple[dict, dict]]:
+    h, w = map(int, shape)
+    centers = [tuple(block["center"]) for block in blocks]
+    options: list[tuple[dict, dict]] = []
+    for r in range(MIN_CENTER, h - MIN_CENTER):
+        for c in range(MIN_CENTER, w - MIN_CENTER):
+            center = (int(r), int(c))
+            if not _centers_clear(center, centers):
