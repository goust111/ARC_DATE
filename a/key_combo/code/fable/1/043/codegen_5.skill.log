+    col_max = min(w - 1 - MIN_CENTER, cross_step)
+    if col_min > col_max:
+        return None
+    col = random.randint(col_min, col_max)
+    start_row = random.randint(MIN_CENTER, h - 1 - MIN_CENTER - total)
+    return [
