+
+
+def _centers_clear(center: tuple[int, int], centers: list[tuple[int, int]]) -> bool:
+    cr, cc = center
+    for orr, occ in centers:
+        if abs(int(cr) - int(orr)) < 5 and abs(int(cc) - int(occ)) < 5:
+            return False
+    return True
+
+
+def _shares_center_line(a: tuple[int, int], b: tuple[int, int]) -> bool:
+    dr = int(b[0] - a[0])
+    dc = int(b[1] - a[1])
+    return dr == 0 or dc == 0 or abs(dr) == abs(dc)
+
+
+def _sample_pair(shape: tuple[int, int]) -> tuple[tuple[int, int], tuple[int, int]] | None:
+    h, w = map(int, shape)
+    directions = list(PAIR_DIRS)
+    random.shuffle(directions)
+
+    for dr, dc in directions:
+        max_dist = max(h, w)
+        distances = [d for d in range(5, max_dist) if d % 2 == 1]
+        random.shuffle(distances)
