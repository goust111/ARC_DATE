+            options.append((candidate[-1], analysis))
+    return options
+
+
+def _gen_attempt() -> np.ndarray | None:
+    h = random.randint(MIN_SIZE, MAX_SIZE)
+    w = random.randint(MIN_SIZE, MAX_SIZE)
+    pair = _sample_pair((h, w))
+    if pair is None:
+        return None
+
+    want_extra = random.random() < 0.45
+    colors = random.sample(COLOR_POOL, 3 if want_extra else 2)
+    blocks = [
+        {"center": pair[0], "color": int(colors[0])},
