+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+DIRS8 = tuple(
+    (dr, dc)
+    for dr in (-1, 0, 1)
+    for dc in (-1, 0, 1)
+    if not (dr == 0 and dc == 0)
+)
+PAIR_DIRS = ((0, 1), (1, 0), (1, 1), (1, -1))
+BACKGROUND = 0
+COLOR_POOL = tuple(range(1, 10))
+MIN_SIZE = 14
+MAX_SIZE = 28
+MIN_CENTER = 2
+MAX_GEN_ATTEMPTS = 250
