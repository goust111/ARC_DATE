+        for r, c in emitter["paint"]:
+            assert int(out[r, c]) == bg, "rays may only add color onto background cells"
+            out[r, c] = color
+    return out
+
+
+def _render_input(shape: tuple[int, int], blocks: list[dict]) -> np.ndarray:
+    grid = np.full(shape, BACKGROUND, dtype=int)
+    for block in blocks:
+        cr, cc = block["center"]
+        color = int(block["color"])
+        grid[cr - 1 : cr + 2, cc - 1 : cc + 2] = color
+    return grid
+
+
+def _centers_clear(center: tuple[int, int], centers: list[tuple[int, int]]) -> bool:
+    cr, cc = center
+    for orr, occ in centers:
+        if abs(int(cr) - int(orr)) < 5 and abs(int(cc) - int(occ)) < 5:
+            return False
+    return True
+
+
+def _shares_center_line(a: tuple[int, int], b: tuple[int, int]) -> bool:
+    dr = int(b[0] - a[0])
+    dc = int(b[1] - a[1])
+    return dr == 0 or dc == 0 or abs(dr) == abs(dc)
+
+
+def _sample_pair(shape: tuple[int, int]) -> tuple[tuple[int, int], tuple[int, int]] | None:
