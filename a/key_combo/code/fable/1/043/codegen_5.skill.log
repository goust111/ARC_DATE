+            r_max = (h - 1 - MIN_CENTER) - max(0, dr * dist)
+            c_min = MIN_CENTER + max(0, -dc * dist)
+            c_max = (w - 1 - MIN_CENTER) - max(0, dc * dist)
+            if r_min > r_max or c_min > c_max:
