+            c_min = MIN_CENTER + max(0, -dc * total)
+            c_max = (w - 1 - MIN_CENTER) - max(0, dc * total)
+            if r_min > r_max or c_min > c_max:
+                continue
+            start = (random.randint(r_min, r_max), random.randint(c_min, c_max))
+            centers = [start]
+            acc = 0
+            for step in steps:
+                acc += step
+                centers.append((int(start[0] + dr * acc), int(start[1] + dc * acc)))
+            if _centers_clear(centers[-1], centers[:-1]):
+                return centers
+    return None
+
