+        cr, cc = block["center"]
+        for rr in range(cr - 1, cr + 2):
+            for col in range(cc - 1, cc + 2):
+                coord = (int(rr), int(col))
+                assert coord not in occupied, "blocks must not overlap"
+                occupied[coord] = int(block_id)
