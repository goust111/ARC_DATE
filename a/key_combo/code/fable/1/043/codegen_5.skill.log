+    blocks = [
+        {"center": pair[0], "color": int(colors[0])},
+        {"center": pair[1], "color": int(colors[1])},
+    ]
+    centers = [pair[0], pair[1]]
+
+    try:
+        analysis = _analyze_blocks((h, w), blocks)
+    except AssertionError:
+        return None
+    if not analysis["pairs"]:
+        return None
+
+    if want_extra:
+        options = _find_valid_extra_blocks((h, w), blocks, int(colors[2]))
+        if options:
+            extra_block, analysis = random.choice(options)
+            blocks = blocks + [extra_block]
+            centers.append(tuple(extra_block["center"]))
+
+    if not any(emitter["opponent"] is None for emitter in analysis["emitters"]):
+        return None
+
+    grid = _render_input((h, w), blocks)
+    assert grid.ndim == 2 and max(grid.shape) <= 30
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GEN_ATTEMPTS):
+        grid = _gen_attempt()
