+                center_a = (random.randint(r_min, r_max), random.randint(c_min, c_max))
+                center_b = (int(center_a[0] + dr * dist), int(center_a[1] + dc * dist))
+                return center_a, center_b
+    return None
+
+
+def _sample_isolated_center(shape: tuple[int, int], centers: list[tuple[int, int]]) -> tuple[int, int] | None:
+    h, w = map(int, shape)
+    for _ in range(150):
+        center = (random.randint(MIN_CENTER, h - 1 - MIN_CENTER), random.randint(MIN_CENTER, w - 1 - MIN_CENTER))
+        if not _centers_clear(center, centers):
+            continue
+        if any(_shares_center_line(center, other) for other in centers):
