+            candidate = blocks + [{"center": center, "color": int(color)}]
+            try:
+                analysis = _analyze_blocks(shape, candidate)
+            except AssertionError:
+                continue
+            if not analysis["pairs"]:
+                continue
+            if not any(emitter["opponent"] is None for emitter in analysis["emitters"]):
+                continue
+            options.append((candidate[-1], analysis))
+    return options
+
+
+def _gen_attempt() -> np.ndarray | None:
+    h = random.randint(MIN_SIZE, MAX_SIZE)
+    w = random.randint(MIN_SIZE, MAX_SIZE)
+    pair = _sample_pair((h, w))
+    if pair is None:
+        return None
+
+    want_extra = random.random() < 0.45
+    colors = random.sample(COLOR_POOL, 3 if want_extra else 2)
+    blocks = [
+        {"center": pair[0], "color": int(colors[0])},
+        {"center": pair[1], "color": int(colors[1])},
+    ]
+    centers = [pair[0], pair[1]]
+
+    try:
+        analysis = _analyze_blocks((h, w), blocks)
+    except AssertionError:
+        return None
+    if not analysis["pairs"]:
+        return None
+
+    if want_extra:
+        options = _find_valid_extra_blocks((h, w), blocks, int(colors[2]))
+        if options:
+            extra_block, analysis = random.choice(options)
+            blocks = blocks + [extra_block]
+            centers.append(tuple(extra_block["center"]))
+
+    if not any(emitter["opponent"] is None for emitter in analysis["emitters"]):
+        return None
+
+    grid = _render_input((h, w), blocks)
+    assert grid.ndim == 2 and max(grid.shape) <= 30
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError(f"failed to generate a valid input after {MAX_GEN_ATTEMPTS} attempts")

