+            r0, c0, r1, c1 = _bbox_coords(pts)
+            assert pts.shape[0] == 9, "each object must contain exactly nine cells"
+            assert r1 - r0 == 2 and c1 - c0 == 2, "each object must have a 3x3 bbox"
