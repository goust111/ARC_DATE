+                center_a = (random.randint(r_min, r_max), random.randint(c_min, c_max))
+                center_b = (int(center_a[0] + dr * dist), int(center_a[1] + dc * dist))
+                return center_a, center_b
+    return None
+
+
+def _find_valid_extra_blocks(shape: tuple[int, int], blocks: list[dict], color: int) -> list[tuple[dict, dict]]:
+    h, w = map(int, shape)
+    centers = [tuple(block["center"]) for block in blocks]
+    options: list[tuple[dict, dict]] = []
+    for r in range(MIN_CENTER, h - MIN_CENTER):
