+    h, w = map(int, shape)
+    centers = [tuple(block["center"]) for block in blocks]
+    options: list[tuple[dict, dict]] = []
+    for r in range(MIN_CENTER, h - MIN_CENTER):
+        for c in range(MIN_CENTER, w - MIN_CENTER):
+            center = (int(r), int(c))
+            if not _centers_clear(center, centers):
