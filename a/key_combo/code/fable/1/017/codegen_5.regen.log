+    lower_space = random.randint(3, 8)
+    height = top_margin + legend_height + lower_space + 1
+    if height > 30:
+        return None
+
+    width = legend_c0 + 2 + gap + scene_width + right_margin
+    if width > 30:
+        return None
+
+    grid = np.full((height, width), BG, dtype=int)
+
