+
+    mandatory_specs = [
+        ("sorted", mandatory_cols[0], sorted_colors),
+        ("scrambled", mandatory_cols[1], scrambled_colors),
+        ("random", mandatory_cols[2], mixed_colors),
+        ("random", mandatory_cols[3], noise_only),
+        ("random", mandatory_cols[4], repeat_colors),
