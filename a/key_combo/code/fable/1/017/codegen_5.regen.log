+        counts = {color: int(np.count_nonzero(g[:-1, c] == color)) for color in order}
+        out[:-1, c] = bg
+        row = h - 2
+        for color in order:
+            count = counts[color]
+            if count:
+                out[row - count + 1 : row + 1, c] = int(color)
+                row -= count
+
+    return out
