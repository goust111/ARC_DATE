    h = random.randint(*ROW_RANGE)
    w = random.randint(*COL_RANGE)
    r0 = random.randint(PLACEMENT_PAD, h - REGION_SIDE - PLACEMENT_PAD)
    c0 = random.randint(PLACEMENT_PAD, w - REGION_SIDE - PLACEMENT_PAD)

