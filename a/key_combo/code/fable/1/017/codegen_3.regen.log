BLACK,GREEN,ORANGE,TEAL=0,3,7,8
DIRS=[(-1,0),(0,1),(1,0),(0,-1)]
CARD=[(-1,0),(1,0),(0,-1),(0,1)]

def turn(d,color):
    return (d-1)%4 if color==TEAL else (d+1)%4

def sim(shape, emitter, strips, colors):
