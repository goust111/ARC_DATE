+                cells,
+                path_cells,
+                occupied,
+                forbid_path_neighbors=True,
+                safe_from_path_start=0,
+            ):
+                continue
+            strips.append(cells)
+            colors.append(random.choice([LEFT_TURN, RIGHT_TURN]))
+            occupied.update(cells)
+            break
+
