+def _simulate_scene(
+    shape: tuple[int, int],
+    emitter: tuple[int, int],
+    strip_cells: list[list[tuple[int, int]]],
+    strip_colors: list[int],
+) -> tuple[set[tuple[int, int]], list[int], list[int]]:
+    h, w = map(int, shape)
+    assert len(strip_cells) == len(strip_colors)
