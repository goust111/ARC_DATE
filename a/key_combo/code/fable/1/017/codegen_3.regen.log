+                    cells,
+                    path_cells,
+                    occupied,
+                    forbid_path_neighbors=True,
+                    safe_from_path_start=1,
+                ):
+                    continue
+                candidates.append(cells)
+        if not candidates:
+            return None
+        chosen = random.choice(candidates)
+        strips.append(chosen)
+        occupied.update(chosen)
