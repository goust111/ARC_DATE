                    if any(nb in occupied and nb not in cset for nb in neigh4(cell)):
                        good=False; break
                if good:
                    cand.append(cells)
        if not cand:
            return None
        choice=random.choice(cand)
        strips.append(choice)
        occupied.update(choice)
    return strips

ok=0
