+
+def _can_place_segment(
+    shape: tuple[int, int],
+    cells: list[tuple[int, int]],
+    path_cells: set[tuple[int, int]],
+    occupied: set[tuple[int, int]],
+    *,
+    forbid_path_neighbors: bool,
+    safe_from_path_start: int,
