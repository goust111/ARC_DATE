        cur=nxt
        path.append(cur)

def neigh4(cell):
    r,c=cell
    return [(r-1,c),(r+1,c),(r,c-1),(r,c+1)]

def can_place(cells, path, occupied, shape):
    H,W=shape
    cset=set(cells)
    if not all(0<=r<H and 0<=c<W for r,c in cells): return False
    if any(cell in path for cell in cells): return False
    for cell in cells:
        if cell in occupied and cell not in cset:
            return False
        for nb in neigh4(cell):
            if nb in occupied and nb not in cset:
                return False
    return True

def add_distractors(shape, path, strips, colors):
    occupied=set(cell for s in strips for cell in s)
    path=set(path)
    for _ in range(random.randint(0,3)):
        placed=False
        for _ in range(200):
            r=random.randrange(shape[0])
            c=random.randrange(shape[1])
            dr,dc=random.choice(CARD)
            L=random.randint(2,4)
            cells=[(r+dr*k,c+dc*k) for k in range(L)]
            if not can_place(cells,path,occupied,shape):
                continue
            strips.append(cells)
            colors.append(random.choice([TEAL,ORANGE]))
            occupied.update(cells)
            placed=True
