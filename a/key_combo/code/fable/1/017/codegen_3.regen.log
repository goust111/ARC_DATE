    top_pad=random.randint(2,4)-min_row
    rows=[r+top_pad for r in rows]
    H=max(rows)+random.randint(2,4)+1
    runs=[random.randint(2,4) for _ in range(m)]
    c=0
    anchors=[]; colors=[]
    for i in range(m):
        c += runs[i]
        r0=rows[i]; r1=rows[i+1]
        anchors.append((r0,c+1)); colors.append(TEAL if r1<r0 else ORANGE)
        anchors.append((r1-1 if r1<r0 else r1+1,c)); colors.append(ORANGE if r1<r0 else TEAL)
    W=c+1+random.randint(3,7)
    emitter=(rows[0],0)
    return (H,W), emitter, [[a] for a in anchors], colors

def extend(shape, path, anchors):
    H,W=shape
    path=set(path)
    strips=[]; occupied=set()
    for anchor in anchors:
        cand=[]
        for dr,dc in random.sample(CARD, len(CARD)):
            for L in random.sample([2,3,4],3):
