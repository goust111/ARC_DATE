GEN_GRID_SHAPE = (10, 10)
GEN_BACKGROUND = 0
GEN_FRAME_COLOR = Color.GREY
GEN_FRAME_SPAN = 4
GEN_TEMPLATE_SPAN = 3
# Shape and outside-object count ranges.
GEN_SHAPE_SIZE_MIN = 3
GEN_SHAPE_SIZE_MAX = 5
GEN_DISTRACTOR_COUNT_MIN = 2
GEN_DISTRACTOR_COUNT_MAX = 4
