+MACRO_SIDE = 3
+TILE_SIDE = 3
+GRID_SIDE = MACRO_SIDE * TILE_SIDE + (MACRO_SIDE - 1)
+SEP_COLOR = 5
+YELLOW = 4
+PALETTE = [0, 1, 2, 3, 6, 7, 8, 9]
