+        assert b is not None
+        r0, c0, r1, c1 = b
+        box_h = r1 - r0 + 1
+        box_w = c1 - c0 + 1
+        row_sums = mask.sum(axis=1)
+        col_sums = mask.sum(axis=0)
+        if box_h < max(5, height - 3):
+            continue
+        if box_w < min(3, half_width):
+            continue
+        if len(set(map(int, row_sums))) < 3:
+            continue
+        if len(set(map(int, col_sums))) < 2:
