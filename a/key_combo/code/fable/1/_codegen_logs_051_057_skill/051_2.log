+        cols = [c for c in range(w) if bool(np.all(g[:, c] == color))]
+        count = len(rows) + len(cols)
+        if count < 2:
+            continue
+        line_mask = np.zeros_like(g, dtype=bool)
+        if rows:
+            line_mask[rows, :] = True
+        if cols:
+            line_mask[:, cols] = True
