    corner_col = c0 if corner in ("tl", "bl") else c1
    horizontal_row = r1 if corner_row == r0 else r0
    vertical_col = c1 if corner_col == c0 else c0
    return [(corner_row, corner_col), (horizontal_row, edge_col), (edge_row, vertical_col)]


