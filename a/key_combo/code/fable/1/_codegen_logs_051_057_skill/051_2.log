+
+
+GEN_RETRIES = 400
+GRID_HEIGHT_RANGE = (14, 24)
+GRID_WIDTH_RANGE = (18, 28)
+MOTIF_HEIGHT_RANGE = (7, 13)
+MOTIF_HALF_WIDTH_RANGE = (4, 7)
