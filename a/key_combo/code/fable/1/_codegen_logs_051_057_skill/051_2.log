+def _find_line_candidates(grid: np.ndarray, bg: int) -> tuple[int, list[Axis], np.ndarray]:
+    """Detect the shared candidate-line color and all full-row/full-column axes."""
+
+    g = np.asarray(grid, dtype=int)
+    h, w = map(int, g.shape)
