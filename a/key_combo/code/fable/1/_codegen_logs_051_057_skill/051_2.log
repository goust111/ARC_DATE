+        return False
+
+    ranks = sorted((_axis_rank(stats), axis) for axis, stats in stats_by_axis.items())
+    if len(ranks) >= 2 and not (ranks[-1][0] > ranks[-2][0]):
+        return False
+
+    for axis, stats in stats_by_axis.items():
