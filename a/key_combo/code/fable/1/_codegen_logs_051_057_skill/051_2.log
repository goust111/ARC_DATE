+        "pairs": int(pair_count),
+        "singles": int(single_count),
+        "quality": float(quality),
+        "mapping_size": int(mapping_size),
+        "mapping": dict(l_to_r),
+        "inverse_mapping": dict(r_to_l),
+        "consistent": bool(consistent),
+        "fillable": bool(fillable),
+        "fills": fills,
+        "valid": valid,
+    }
