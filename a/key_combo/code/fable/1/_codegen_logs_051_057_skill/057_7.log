+        "separator": sep_color,
+        "n": n,
+        "borders": borders,
+        "cells": cells,
+        "cell_keys": cell_keys,
+        "majority": majority,
+        "majority_key": majority_key,
+        "majority_mask": majority_mask,
+        "cell_bg": cell_bg,
+        "deviants": deviants,
+        "dev_mask": dev_mask,
+        "keep": keep_candidates[0],
