+    return int(Counter(int(v) for v in values.ravel()).most_common(1)[0][0])
+
+
+def _infer_layout(grid: np.ndarray) -> tuple[int, int, tuple[int, ...]]:
+    g = np.asarray(grid, dtype=int)
