    sides = random.choice(_GEN_F8C80D96_SIDE_SETS)
    magnitude = random.choice(_GEN_F8C80D96_STEP_MAGNITUDES)
    pool = [c for c in catalog if c["sides"] == sides and c["magnitude"] == magnitude]
    if not pool:
