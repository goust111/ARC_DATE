    for box in boxes:
        grid[_draw_clipped_sides(_GEN_F8C80D96_SHAPE, box, sides)] = color
    return grid


def _gen_f8c80d96_select_candidate(catalog: list[dict]) -> tuple[dict, int] | None:
    if not catalog:
