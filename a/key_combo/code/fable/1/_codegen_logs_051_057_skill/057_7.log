        return None

    boxes = [box]
    cur = box
    for _ in range(_GEN_F8C80D96_SEQUENCE_LIMIT):
        cur = _add_box(cur, step)
        if not np.any(_draw_clipped_sides(_GEN_F8C80D96_SHAPE, cur, sides)):
