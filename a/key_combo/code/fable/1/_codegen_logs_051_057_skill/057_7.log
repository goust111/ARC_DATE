    rows = random.randint(*SLOT_ROWS_RANGE)
    cols = random.randint(*SLOT_COLS_RANGE)
    num_entries = random.randint(*LEGEND_ENTRY_RANGE)

    marker_colors = random.sample(MARKER_PALETTE, num_entries)
