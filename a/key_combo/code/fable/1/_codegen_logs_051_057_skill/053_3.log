+    clean = np.asarray(instance["clean"], dtype=int)
+    observed = np.asarray(instance["observed"], dtype=int)
+    cells = np.asarray(instance["cells"], dtype=int)
+    key_region = np.asarray(instance["key"], dtype=int)
