+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        try:
+            instance = _build_instance()
+            _validate_instance(instance)
+            return np.asarray(instance["input"], dtype=int)
+        except (AssertionError, ValueError, RuntimeError):
