+            for transform_id in range(8)
+        }
+        if unique_colors.size < 3:
+            continue
+        if counts.max() < 2:
+            continue
+        if any(np.array_equal(cells[i, :], cells[i + 1, :]) for i in range(n_rows - 1)):
+            continue
+        if any(np.array_equal(cells[:, j], cells[:, j + 1]) for j in range(n_cols - 1)):
+            continue
+        if len(signatures) != 8:
