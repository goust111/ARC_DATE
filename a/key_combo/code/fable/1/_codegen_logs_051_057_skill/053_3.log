GEN_ROOM_COUNT_MIN, GEN_ROOM_COUNT_MAX = 6, 8
GEN_SMALL_ROOM_MIN, GEN_SMALL_ROOM_MAX = 3, 4
GEN_LARGE_ROOM_MIN = 5
GEN_LARGE_ROOM_FALLBACK_MAX = 11
GEN_SIZE_PROFILE_BY_ROOM_COUNT = {
    8: (8, 0.34),
