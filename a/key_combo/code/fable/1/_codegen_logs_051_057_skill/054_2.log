+    edges = _infer_front_edges(grid, recovered_masks)
+    inferred_order = _unique_front_order(sorted(recovered_masks), edges)
+    if inferred_order != front_order:
+        return False
+    if len(edges) < len(front_order) - 1:
+        return False
