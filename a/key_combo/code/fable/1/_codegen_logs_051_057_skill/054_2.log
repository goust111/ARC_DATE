+    delta = layer_height - 2
+    max_base_top = h - (2 * delta + layer_height)
+    if max_base_top < 0:
+        return None
+    base_top = random.randint(0, max_base_top)
+    tops = [base_top, base_top + delta, base_top + 2 * delta]
