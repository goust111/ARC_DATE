+def _segment_bounds(axis_k: int, half_width: int) -> tuple[int, int]:
+    if axis_k % 2 == 0:
+        center_col = axis_k // 2
+        return center_col - half_width, center_col + half_width
+    left_center = axis_k // 2
+    return left_center - half_width + 1, left_center + half_width
+
+
