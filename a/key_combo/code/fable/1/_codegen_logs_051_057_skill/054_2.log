+
+def _compose_input(shape: tuple[int, int], specs: list[dict], front_order: list[int]) -> np.ndarray:
+    masks = {int(spec["color"]): spec["mask"] for spec in specs}
+    return _compose_from_front_order(shape, masks, front_order)
