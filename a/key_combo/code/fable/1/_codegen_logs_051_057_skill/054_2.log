+    mask = np.zeros((h, w), dtype=bool)
+    for dr, half_width in enumerate(row_widths):
+        row = top + dr
+        c0, c1 = _segment_bounds(axis_k, int(half_width))
+        mask[row, c0 : c1 + 1] = True
+    return mask
