            control_color = control_colors.pop()
            assert control_color in templates, "every control color must be defined by the legend"
            rr = br * 3
            cc = bc * 3
            out[rr : rr + 2, cc : cc + 2] = np.where(templates[control_color], control_color, bg)

    return out

