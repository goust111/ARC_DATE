+
+def _tile_fill(shape: tuple[int, int], tile: np.ndarray, offset: tuple[int, int]) -> np.ndarray:
+    h, w = shape
+    th, tw = tile.shape
+    off_r, off_c = offset
+    rr = ((np.arange(h) - off_r) % th)[:, None]
+    cc = ((np.arange(w) - off_c) % tw)[None, :]
+    return tile[rr, cc]
