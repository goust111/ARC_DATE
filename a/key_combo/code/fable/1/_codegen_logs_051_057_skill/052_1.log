    rr = coords[:, 0] + dr
    cc = coords[:, 1] + dc
    return (
        int(rr.min()) >= 0
        and int(cc.min()) >= 0
        and int(rr.max()) < occupied.shape[0]
        and int(cc.max()) < occupied.shape[1]
        and not bool(occupied[rr, cc].any())
