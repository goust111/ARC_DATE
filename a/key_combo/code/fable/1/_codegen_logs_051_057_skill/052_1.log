+        bbox = _bbox_coords(coords)
+        h, w = _bbox_shape(bbox)
+        r0, c0, r1, c1 = bbox
+        assert coords.shape[0] == h * w, "grey component must be a solid rectangle"
+        assert np.all(grid[r0 : r1 + 1, c0 : c1 + 1] == GREY), "grey bbox must be solid"
