+    for (r, c), value in zip(observed_coords, observed_vals):
+        tr = int(r) % ph
+        tc = int(c) % pw
+        old = int(tile[tr, tc])
+        val = int(value)
+        if old == -1:
+            tile[tr, tc] = val
+        elif old != val:
