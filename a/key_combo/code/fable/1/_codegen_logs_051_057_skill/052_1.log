+    return np.array_equal(predicted, out)
+
+
+def _generate_attempt() -> np.ndarray | None:
+    period_shape = (random.randint(2, 5), random.randint(2, 5))
+    palette = random.sample(WALLPAPER_COLORS, random.choice((3, 3, 4)))
