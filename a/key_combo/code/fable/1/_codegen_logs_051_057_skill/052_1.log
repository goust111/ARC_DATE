_GEN_BODY_BOTTOM_MIN, _GEN_BODY_BOTTOM_MAX = 4, 8
_GEN_BODY_AREA_MIN, _GEN_BODY_AREA_MAX = 14, 31
_GEN_BODY_DENSITY_MIN, _GEN_BODY_DENSITY_MAX = 0.38, 0.72

