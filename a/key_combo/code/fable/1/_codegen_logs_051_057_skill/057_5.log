+        grid[1 : thickness + 1, 1 : w - 1] = WALL
+    if "bottom" in sides:
+        grid[h - 1 - thickness : h - 1, 1 : w - 1] = WALL
+    if "left" in sides:
+        grid[1 : h - 1, 1 : thickness + 1] = WALL
+    if "right" in sides:
+        grid[1 : h - 1, w - 1 - thickness : w - 1] = WALL
