+
+def _target_cells_for_spec(spec: dict, shape: tuple[int, int], thickness: int) -> list[tuple[int, int]]:
+    h, w = shape
+    if spec["side"] == "top":
+        return [(thickness, c) for c in spec["outer_positions"]]
+    if spec["side"] == "bottom":
+        return [(h - 1 - thickness, c) for c in spec["outer_positions"]]
