+    sorted_teeth = sorted(teeth, key=_axis_key(side))
+    sorted_targets = sorted(target_cells, key=_axis_key(side))
+    dr = sorted_targets[0][0] - sorted_teeth[0][0]
+    dc = sorted_targets[0][1] - sorted_teeth[0][1]
