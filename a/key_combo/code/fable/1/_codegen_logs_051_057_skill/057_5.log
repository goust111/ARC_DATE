+
+    if not _validate_case(inp, final_grid, specs, block_infos, thickness, sides):
+        raise ValueError("semantic validation failed")
+
+    return inp, final_grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(300):
+        try:
+            inp, _out = _generate_case()
+            return inp
+        except Exception:
+            continue
