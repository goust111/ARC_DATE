+            patch[1:, :] = color
+            teeth = [(0, extra_left + offset) for offset in pattern]
+        else:
+            patch[:-1, :] = color
+            teeth = [(body_h, extra_left + offset) for offset in pattern]
+    else:
+        span = pattern[-1] + 1
+        extra_top = 1
+        extra_bottom = 1
+        height = span + extra_top + extra_bottom
