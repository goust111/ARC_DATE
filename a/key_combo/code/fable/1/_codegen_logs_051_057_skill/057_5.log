+    if r0 < 1 or c0 < 1 or r0 + h >= grid.shape[0] - 1 or c0 + w >= grid.shape[1] - 1:
+        return False
+    rr0 = max(0, r0 - padding)
+    cc0 = max(0, c0 - padding)
+    rr1 = min(grid.shape[0], r0 + h + padding)
+    cc1 = min(grid.shape[1], c0 + w + padding)
