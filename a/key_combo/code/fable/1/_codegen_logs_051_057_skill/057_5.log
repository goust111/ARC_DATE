+        inner_coord = thickness
+        return [
+            {
+                "side": side,
+                "signature": (side, tuple(r - group[0] for r in group)),
+                "outer_cells": [(int(r), 0) for r in group],
+                "target_cells": [(int(r), int(inner_coord)) for r in group],
+            }
+            for group in _group_positions(positions)
