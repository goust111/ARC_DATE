+
+def _place_patterns_on_side(axis_len: int, patterns: list[tuple[int, ...]], margin: int) -> list[list[int]] | None:
+    ordered = sorted(patterns, key=lambda pattern: (-len(pattern), -(pattern[-1] + 1)))
+    for _ in range(200):
