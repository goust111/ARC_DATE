+    r, c = start
+    dr, dc = step
+    length = 0
+    while 0 <= r < grid.shape[0] and 0 <= c < grid.shape[1] and int(grid[r, c]) == color:
+        length += 1
+        r += dr
+        c += dc
+    return length
