+        groups = _place_patterns_on_side(
+            w if side in ("top", "bottom") else h,
+            [spec["pattern"] for spec in side_specs],
+            margin,
+        )
+        if groups is None:
+            return None
+        for spec, group in zip(side_specs, groups):
+            spec = dict(spec)
+            spec["outer_positions"] = group
