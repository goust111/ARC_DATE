+
+def _validate_case(
+    inp: np.ndarray,
+    expected: np.ndarray,
+    specs: list[dict],
+    block_infos: list[dict],
+    thickness: int,
+    sides: tuple[str, ...],
+) -> bool:
+    if not np.array_equal(main(inp), expected):
+        return False
