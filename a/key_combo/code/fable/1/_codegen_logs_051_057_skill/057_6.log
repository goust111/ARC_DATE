+def _paint_sprite(dst: np.ndarray, sprite_mask: np.ndarray, top: int, left: int, color: int) -> None:
+    h, w = sprite_mask.shape
+    window = dst[top : top + h, left : left + w]
+    window[sprite_mask] = int(color)
