+    seq: list[int] = []
+    cur = start
+    while cur <= high:
+        seq.append(cur)
+        cur += step
+
+    assert set(uniq).issubset(seq), "visible coordinates must lie on the restored sequence"
+    assert seq[0] - step < low and seq[-1] + step > high, "sequence must be maximally extended to canvas bounds"
+    return seq
