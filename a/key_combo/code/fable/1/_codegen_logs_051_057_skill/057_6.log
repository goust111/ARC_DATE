+def _gen_attempt() -> np.ndarray | None:
+    mode = random.choices(("row", "col", "both"), weights=(3, 3, 4), k=1)[0]
+    sprite_mask = _random_sprite()
+    sprite_h, sprite_w = sprite_mask.shape
