+def _neighbors4(cell: Coord) -> list[Coord]:
+    r, c = cell
+    return [(r + dr, c + dc) for dr, dc in DIRS]
+
+
+def _count_occupied_neighbors(cell: Coord, occupied: set[Coord]) -> int:
+    return sum(nei in occupied for nei in _neighbors4(cell))
