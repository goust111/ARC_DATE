+
+BG = Color.BLACK
+ANCHOR_COLOR = Color.GREY
+BODY_COLORS = [
+    Color.BLUE,
+    Color.RED,
+    Color.GREEN,
+    Color.YELLOW,
+    Color.PINK,
+    Color.ORANGE,
+    Color.TEAL,
+    Color.MAROON,
+]
