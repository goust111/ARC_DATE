+MAX_SHAPE_EXTENT = 4
+MIN_SCENE_SIDE = 14
+MAX_SCENE_SIDE = 24
+MAX_GENERATION_ATTEMPTS = 500
+MAX_PLACEMENT_ATTEMPTS = 200
