import random


def place(patch_shapes, anchor_locs):
    maxh=max(h for h,w in patch_shapes)
    maxw=max(w for h,w in patch_shapes)
    min_h=max(14, maxh+6)
    min_w=max(14, maxw+6)
    for _ in range(200):
        H=random.randint(min_h, 24)
        W=random.randint(min_w, 24)
        placed=[]
        anchor_rows=[]; anchor_cols=[]
        order=sorted(range(len(patch_shapes)), key=lambda i: patch_shapes[i][0]*patch_shapes[i][1], reverse=True)
        pos=[None]*len(patch_shapes)
        for i in order:
            h,w=patch_shapes[i]; ar,ac=anchor_locs[i]
            cands=[]
            for r0 in range(1, H-h):
                for c0 in range(1, W-w):
                    rr=(r0+ar); cc=(c0+ac)
                    if rr in anchor_rows or cc in anchor_cols:
                        continue
                    ok=True
                    for pr,pc,ph,pw in placed:
                        if not (r0+h <= pr-1 or pr+ph <= r0-1 or c0+w <= pc-1 or pc+pw <= c0-1):
                            ok=False; break
                    if ok:
                        cands.append((r0,c0))
            if not cands:
                break
            r0,c0=random.choice(cands)
            pos[i]=(r0,c0)
            placed.append((r0,c0,h,w))
            anchor_rows.append(r0+ar); anchor_cols.append(c0+ac)
        else:
            return H,W,pos
    return None

for _ in range(20):
    shapes=[(random.randint(3,9),random.randint(3,9)) for _ in range(3)]
    anchors=[(random.randrange(h),random.randrange(w)) for h,w in shapes]
    x=place(shapes,anchors)
    print(shapes, anchors, x is not None)
