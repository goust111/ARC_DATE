+    min_c = min(cols)
+    out = np.full((max(rows) - min_r + 1, max(cols) - min_c + 1), BG, dtype=int)
+
+    for (r, c), colors in coverage.items():
+        out[r - min_r, c - min_c] = (
+            ANCHOR_COLOR if len(colors) >= 2 else next(iter(colors))
+        )
+    return out
