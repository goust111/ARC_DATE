+    main_r0, main_c0 = random.choice(main_positions)
+    main_outer_bbox = (main_r0, main_c0, main_r0 + main_outer_h - 1, main_c0 + main_outer_w - 1)
+    boundaries = _build_tree_boundaries(main_outer_bbox, main_statuses, tree_id=0)
