+def _sample_scene() -> tuple[np.ndarray, np.ndarray, list[dict], list[tuple[int, int, int, int]], list[int], np.ndarray, np.ndarray] | None:
+    height = random.randint(25, 30)
+    width = random.randint(25, 30)
+    shape = (height, width)
