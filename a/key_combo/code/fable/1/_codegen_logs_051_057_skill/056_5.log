+def _place_onion_bbox(
+    shape: tuple[int, int],
+    outer_h: int,
+    outer_w: int,
+    corner: str,
+    row_margin: int,
+    col_margin: int,
+) -> tuple[int, int, int, int]:
+    h, w = map(int, shape)
+    if corner == "tl":
+        r0 = int(row_margin)
+        c0 = int(col_margin)
+    elif corner == "tr":
+        r0 = int(row_margin)
+        c0 = w - int(col_margin) - int(outer_w)
+    elif corner == "bl":
