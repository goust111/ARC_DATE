+def _single_separator_row(g: np.ndarray, bg: int) -> tuple[int, int]:
+    rows = [
+        r
+        for r in range(g.shape[0])
+        if int(g[r, 0]) != bg and np.all(g[r, :] == int(g[r, 0]))
+    ]
+    assert len(rows) == 1, "expected exactly one solid separator row"
