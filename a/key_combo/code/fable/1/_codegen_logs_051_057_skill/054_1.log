+    if len(drs) == 1:
+        probe_dr = -next(iter(drs))
+        return [(probe_dr, -1), (probe_dr, 1)]
+    assert len(dcs) == 1
+    probe_dc = -next(iter(dcs))
+    return [(-1, probe_dc), (1, probe_dc)]
