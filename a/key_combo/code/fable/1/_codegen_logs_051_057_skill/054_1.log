+def _build_seed_cells(
+    shape: tuple[int, int], r0: int, c0: int, dr: int, dc: int, seed_len: int
+) -> list[tuple[int, int]] | None:
+    cells = []
+    for i in range(seed_len):
+        rr = r0 + i * dr
+        cc = c0 + i * dc
+        if not in_bounds(shape, rr, cc):
+            return None
+        cells.append((rr, cc))
+    return cells
