+        last = max(coords)
+        endpoints = ((first, (-1, -1)), (last, (1, 1)))
+    else:
+        assert len({r + c for r, c in coords}) == 1
+        top = min(coords)
+        bottom = max(coords)
+        endpoints = ((top, (-1, 1)), (bottom, (1, -1)))
