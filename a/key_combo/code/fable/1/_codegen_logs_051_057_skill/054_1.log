+    upper = g[:sep_r, :]
+    lower = g[sep_r + 1 :, :]
+    mirror_color, _transparent_color = _infer_demo_roles(upper, bg)
+    return _extend_panel_ray(lower, mirror_color, bg, RAY_COLOR)
