+                    if cell_set & occupied_bars:
+                        continue
+                    if cell_set & path_set != {anchor}:
+                        continue
+                    bars.append(cells)
+                    anchors.append(anchor)
+                    used_anchors.add(anchor)
+                    occupied_bars |= cell_set
+                    placed = True
+                    break
+                if placed:
+                    break
+            if placed:
+                break
+        if not placed:
+            return None
