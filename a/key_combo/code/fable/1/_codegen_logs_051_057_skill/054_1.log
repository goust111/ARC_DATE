+
+        r, c = seed_cells[-1]
+        cur_dr, cur_dc = dr, dc
+        ok = True
+
+        for _mirror_idx in range(n_reflections):
+            placed = None
+            seg_choices = list(range(2, min(shape) + 1))
+            random.shuffle(seg_choices)
+            for seg_len in seg_choices[:LOCAL_PLACEMENT_RETRIES]:
