+def _gen_attempt() -> np.ndarray | None:
+    upper_h, lower_h, width = _choose_panel_sizes()
+    mirror_color, transparent_color = random.sample(
+        [Color.RED, Color.GREEN, Color.YELLOW, Color.PINK, Color.ORANGE, Color.TEAL, Color.MAROON],
