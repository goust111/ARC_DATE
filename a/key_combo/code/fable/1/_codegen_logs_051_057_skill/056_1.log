+            if exit_segment is None:
+                return None
+            return {"path": path + exit_segment, "turns": turns}
+
+        kind = turn_types[turn_idx]
+        candidates: list[tuple[list[Coord], BBox, Coord, Coord]] = []
+        for dist in range(MIN_SEGMENT_LEN, max(h, w)):
