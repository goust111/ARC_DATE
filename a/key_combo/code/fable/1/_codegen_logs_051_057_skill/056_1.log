+def _is_hollow_frame(patch: np.ndarray, color: int, bg: int) -> bool:
+    return (
+        patch.shape == (3, 3)
+        and np.all(patch[0, :] == color)
+        and np.all(patch[2, :] == color)
+        and np.all(patch[:, 0] == color)
+        and np.all(patch[:, 2] == color)
+        and int(patch[1, 1]) == int(bg)
