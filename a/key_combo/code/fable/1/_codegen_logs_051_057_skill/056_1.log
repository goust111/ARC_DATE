+def _attempt_generate() -> np.ndarray | None:
+    h = random.randint(*GRID_H_RANGE)
+    w = random.randint(*GRID_W_RANGE)
+    turn_count = random.randint(*TURN_COUNT_RANGE)
+    distractor_count = random.randint(*DISTRACTOR_COUNT_RANGE)
