+    seed_candidates: list[dict] = []
+    objects: list[dict] = []
+    for comp in find_components(
+        g,
+        bg=bg,
+        connectivity=4,
+        monochromatic=True,
+        return_format="dict",
+    ):
+        color = int(comp["color"])
+        area = int(comp["area"])
+        bbox = tuple(map(int, comp["bbox"]))
+        patch = crop_bbox(g, bbox)
