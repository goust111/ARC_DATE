+BG = 0
+SOLID = "solid"
+HOLLOW = "hollow"
+SIDES = ("top", "bottom", "left", "right")
+TURN_TYPES = (SOLID, HOLLOW)
+PALETTE = tuple(range(1, 10))
+
+GRID_H_RANGE = (15, 23)
+GRID_W_RANGE = (15, 23)
+TURN_COUNT_RANGE = (2, 4)
