+        for r0 in range(1, h - 3):
+            for c0 in range(1, w - 3):
+                bbox = (r0, c0, r0 + 2, c0 + 2)
+                if any(_boxes_too_close(bbox, other, gap=1) for other in current_bboxes):
+                    continue
