+def _replace_object(grid: np.ndarray, bbox: BBox, kind: str, color: int) -> np.ndarray:
+    out = np.asarray(grid, dtype=int).copy()
+    r0, c0 = _bbox_top_left(bbox)
+    out[r0 : r0 + 3, c0 : c0 + 3] = _render_object(kind, color)
