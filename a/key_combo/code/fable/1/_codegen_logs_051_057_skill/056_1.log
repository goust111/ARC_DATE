+    hits: list[int] = []
+    pos = seed["coord"]
+    seen_states: set[tuple[Coord, Coord]] = set()
+
+    for _ in range(h * w * 8):
+        state = (pos, direction)
+        assert state not in seen_states, "beam loop detected"
+        seen_states.add(state)
