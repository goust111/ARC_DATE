+        random.shuffle(candidates)
+        for segment_cells, bbox, new_direction, turn_point in candidates:
+            bbox_cells = _full_bbox_cells(bbox)
+            result = dfs(
+                turn_point,
+                new_direction,
+                turn_idx + 1,
+                path + segment_cells,
+                path_cells | set(segment_cells),
+                bboxes + [bbox],
+                reserved_cells | bbox_cells,
