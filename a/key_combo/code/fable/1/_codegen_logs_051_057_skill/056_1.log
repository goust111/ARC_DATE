+def _object_bbox_for_turn(turn_point: Coord, direction: Coord) -> BBox:
+    r, c = map(int, turn_point)
+    dr, dc = map(int, direction)
+    if (dr, dc) == (1, 0):
+        return r + 1, c - 1, r + 3, c + 1
+    if (dr, dc) == (-1, 0):
+        return r - 3, c - 1, r - 1, c + 1
+    if (dr, dc) == (0, 1):
