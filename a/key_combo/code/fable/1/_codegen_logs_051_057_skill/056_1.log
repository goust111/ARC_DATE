+
+def _parse_scene(grid: np.ndarray) -> tuple[int, dict, list[dict]]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    bg = int(get_bg(g))
+    assert bg == BG, "expected black background"
