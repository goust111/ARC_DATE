+def _exit_cells(
+    shape: tuple[int, int],
+    pos: Coord,
+    direction: Coord,
+    path_cells: set[Coord],
+    reserved_cells: set[Coord],
+) -> list[Coord] | None:
+    cells: list[Coord] = []
+    r, c = map(int, pos)
+    dr, dc = map(int, direction)
+    while True:
+        r += dr
+        c += dc
+        if not _in_bounds(shape, (r, c)):
+            break
+        if (r, c) in path_cells or (r, c) in reserved_cells:
+            return None
+        cells.append((r, c))
+    if len(cells) < MIN_EXIT_LEN:
+        return None
+    return cells
