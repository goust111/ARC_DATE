+        try:
+            _flipped_out, flipped_meta = _trace_beam(flipped)
+        except Exception:
+            return False
+        flipped_hits = [tuple(map(int, flipped_meta["objects"][idx]["bbox"])) for idx in flipped_meta["hits"]]
+        if flipped_meta["path"] != meta["path"] or flipped_hits != actual_hits:
+            return False
