+                    continue
+                candidates.append((bbox, random.choice(TURN_TYPES)))
+        if not candidates:
+            return None
+        bbox, kind = random.choice(candidates)
+        distractors.append({"bbox": bbox, "kind": kind, "color": int(color), "on_path": False})
+        current_bboxes.append(bbox)
