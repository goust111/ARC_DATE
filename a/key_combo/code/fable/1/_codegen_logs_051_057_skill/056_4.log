+
+def _boxes_separated(a: Coord, b: Coord, pad: int = 1) -> bool:
+    ar0, ac0 = map(int, a)
+    br0, bc0 = map(int, b)
+    ar1, ac1 = ar0 + 2, ac0 + 2
+    br1, bc1 = br0 + 2, bc0 + 2
+    return bool(
+        ar1 + pad < br0
+        or br1 + pad < ar0
+        or ac1 + pad < bc0
+        or bc1 + pad < ac0
