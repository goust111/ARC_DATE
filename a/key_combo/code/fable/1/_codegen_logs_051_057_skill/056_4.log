+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def paste(dst: np.ndarray, patch: np.ndarray, r0: int, c0: int) -> np.ndarray:
+    if _arc_paste is not None:
+        return _arc_paste(dst, patch, r0, c0)
+    r0 = int(r0)
+    c0 = int(c0)
+    h, w = patch.shape
+    dst[r0 : r0 + h, c0 : c0 + w] = patch
+    return dst
