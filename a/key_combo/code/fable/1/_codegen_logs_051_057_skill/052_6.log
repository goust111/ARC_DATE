+def scale_sprite(sprite: np.ndarray, factor: int) -> np.ndarray:
+    """Upscale a sprite by integer nearest-neighbor replication."""
+    return np.kron(np.asarray(sprite, dtype=int), np.ones((factor, factor), dtype=int))
