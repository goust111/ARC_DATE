+ROOM_COUNT_RANGE = (2, 5)
+GRID_SIDE_MAX = 28
+ROOM_SPLIT_MIN = 5
+SPRITE_MIN_DIM = 3
+SPRITE_MAX_DIM = 7
+GEN_RETRIES = 400
