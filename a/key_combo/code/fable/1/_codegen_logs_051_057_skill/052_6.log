+            walls[r0 : r1 + 1, cut] = True
+            rooms.extend(((r0, r1, c0, cut - 1), (r0, r1, cut + 1, c1)))
+        else:
+            cut = random.randint(r0 + ROOM_SPLIT_MIN, r1 - ROOM_SPLIT_MIN)
