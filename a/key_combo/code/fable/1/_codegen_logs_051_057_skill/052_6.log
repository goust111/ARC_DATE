+    original_box = crop_bbox(grid, info["sprite_bbox"])
+    if np.array_equal(scale_sprite(original_box, n), predicted):
+        return False
+    if predicted.shape != (sprite.shape[0] * n, sprite.shape[1] * n):
+        return False
+    return True
