+    wall_coords = np.concatenate(wall_components, axis=0)
+    wall_colors = set(map(int, g[wall_coords[:, 0], wall_coords[:, 1]]))
+    assert len(wall_colors) == 1, "wall must use exactly one visible color"
+    wall_color = next(iter(wall_colors))
