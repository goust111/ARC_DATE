+
+def crop_bbox(grid: np.ndarray, bbox: tuple[int, int, int, int]) -> np.ndarray:
+    """Crop a grid to an inclusive bbox."""
+    r0, c0, r1, c1 = bbox
+    return np.asarray(grid, dtype=int)[r0 : r1 + 1, c0 : c1 + 1].copy()
