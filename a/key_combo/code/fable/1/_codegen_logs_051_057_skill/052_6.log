+def _split_rooms(h: int, w: int, split_count: int) -> tuple[list[tuple[int, int, int, int]], np.ndarray] | tuple[None, None]:
+    """Randomly partition the canvas into `split_count + 1` rectangular rooms using connected walls."""
+    rooms = [(0, h - 1, 0, w - 1)]
