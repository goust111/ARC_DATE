    else:
        rr0 = max(0, r0)
        cc0 = max(0, c0)
        rr1 = min(H, r0 + h)
        cc1 = min(W, c0 + w)
        if rr0 >= rr1 or cc0 >= cc1:
            return dst
        pr0 = rr0 - r0
        pc0 = cc0 - c0

    pr1 = pr0 + (rr1 - rr0)
    pc1 = pc0 + (cc1 - cc0)

    dst_view = dst[rr0:rr1, cc0:cc1]
    patch_view = patch[pr0:pr1, pc0:pc1]

    m = np.ones(patch_view.shape, dtype=bool)
    if mask is not None:
