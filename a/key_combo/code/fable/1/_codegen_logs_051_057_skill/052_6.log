+        for idx, (r0, r1, c0, c1) in enumerate(rooms):
+            if c1 - c0 + 1 >= 2 * ROOM_SPLIT_MIN + 1:
+                options.append((idx, "v"))
+            if r1 - r0 + 1 >= 2 * ROOM_SPLIT_MIN + 1:
+                options.append((idx, "h"))
