+    return None, None
+
+
+def _expected_output(sprite: np.ndarray, bg: int, target_color: int, n: int) -> np.ndarray:
+    cleaned = np.asarray(sprite, dtype=int).copy()
+    cleaned[cleaned == target_color] = bg
+    return scale_sprite(cleaned, n)
