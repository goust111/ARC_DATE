+def _analyze_grid(grid: np.ndarray) -> dict:
+    """Parse the puzzle semantics from a candidate grid and assert uniqueness."""
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2 and max(g.shape) <= 30
