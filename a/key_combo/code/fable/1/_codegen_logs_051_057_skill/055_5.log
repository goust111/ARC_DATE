+def _clear_cone_mask(shape: tuple[int, int], source: tuple[int, int, int]) -> np.ndarray:
+    h, w = shape
+    sr, sc, _color = source
+    mask = np.zeros((h, w), dtype=bool)
+    for r in range(sr, h):
+        left, right = _cone_interval(sr, sc, r)
+        left = max(0, left)
+        right = min(w - 1, right)
+        mask[r, left : right + 1] = True
+    return mask
