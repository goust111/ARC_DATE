+GRAY = 5
+SOURCE_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+
+MAX_GENERATION_ATTEMPTS = 400
+SIDE_MARGIN = 1
+MIN_CONE_GAP = 2
+MAX_EXTRA_WIDTH = 5
+
+
+def _spread_row(active: np.ndarray) -> np.ndarray:
+    """One downward step: each lit cell reaches left-down, down, right-down."""
+    nxt = active.copy()
+    nxt[1:] |= active[:-1]
+    nxt[:-1] |= active[1:]
+    return nxt
