+        # Recover the intended height from the leftmost/rightmost cone span at the bottom.
+        # Because sources were packed by bottom projections, every source depth equals h-1-row
+        # for one shared h; we can reconstruct it from the first source once the bar picker succeeds.
+        candidate_heights = []
+        for extra_h in range(9, 19):
+            ok = True
+            masks = []
+            for sr, sc, _color in sources:
+                if extra_h - 1 - sr < 4:
+                    ok = False
