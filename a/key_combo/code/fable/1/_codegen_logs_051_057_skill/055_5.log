+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+
+    out = g.copy()
+    h, w = g.shape
+    sources = _find_sources(g)
+    assert sources, "expected at least one colored source pixel"
+
+    for sr, sc, color in sources:
+        assert 0 <= sr < h and 0 <= sc < w
+        active = np.zeros(w, dtype=bool)
+        active[sc] = True
+
+        for r in range(sr + 1, h):
+            active = _spread_row(active)
+            active &= g[r] != GRAY
+            if not active.any():
+                break
+
+            touching_other_source = active & (g[r] != BLACK) & (g[r] != GRAY) & (g[r] != color)
+            assert not np.any(touching_other_source), "valid inputs keep light cones disjoint"
+
+            paint = active & (g[r] == BLACK)
+            conflict = paint & (out[r] != BLACK) & (out[r] != color)
+            assert not np.any(conflict), "different light colors must not overlap"
+            out[r, paint] = color
+
+    return out
+
+
+def _pick_source_count() -> int:
+    return 1 if random.random() < 0.45 else 2
+
+
+def _sample_rows(height: int, count: int) -> list[int] | None:
+    if count == 1:
+        max_row = min(4, height - 6)
+        if max_row < 0:
+            return None
+        return [random.randint(0, max_row)]
+
+    low = max(1, height - 7)
+    high = min(5, height // 2, height - 6)
+    if low > high:
+        return None
+    return sorted(random.choices(range(low, high + 1), k=count))
+
+
+def _pack_sources() -> list[tuple[int, int, int]] | None:
+    count = _pick_source_count()
+    height = random.randint(12, 18) if count == 1 else random.randint(9, 12)
+    rows = _sample_rows(height, count)
+    if rows is None:
+        return None
+
+    depths = [height - 1 - row for row in rows]
+    spans = [2 * depth + 1 for depth in depths]
+    gaps = [random.randint(MIN_CONE_GAP, MIN_CONE_GAP + 2) for _ in range(count - 1)]
+    slot_mins = [SIDE_MARGIN, *gaps, SIDE_MARGIN]
+    required_width = sum(spans) + sum(slot_mins)
+    if required_width > 30:
+        return None
+
+    width = random.randint(required_width, min(30, required_width + MAX_EXTRA_WIDTH))
+    extras = [0] * len(slot_mins)
+    for _ in range(width - required_width):
+        extras[random.randrange(len(extras))] += 1
+    slots = [base + extra for base, extra in zip(slot_mins, extras)]
+
+    cursor = slots[0]
+    centers = []
+    for idx, depth in enumerate(depths):
+        span = 2 * depth + 1
+        centers.append(cursor + depth)
+        cursor += span
+        if idx < count - 1:
+            cursor += slots[idx + 1]
+    assert width - cursor == slots[-1]
+
+    colors = random.sample(SOURCE_COLORS, count)
+    return [(row, col, color) for row, col, color in zip(rows, centers, colors)]
+
+
+def _pick_bar(shape: tuple[int, int], source: tuple[int, int, int]) -> tuple[int, int, int] | None:
+    h, _w = shape
+    sr, sc, _color = source
+    candidates: list[tuple[int, int, int]] = []
+
+    for row in range(sr + 3, h - 1):
+        left, right = _cone_interval(sr, sc, row)
+        inner_left = left + 1
+        inner_right = right - 1
+        usable = inner_right - inner_left + 1
+        if usable < 3:
+            continue
+
+        max_width = min(5, usable)
+        width_choices = [width for width in range(3, max_width + 1) if (h - 1 - row) >= ((width + 1) // 2)]
+        if not width_choices:
+            continue
+
+        best_width = max(width_choices)
+        starts = list(range(inner_left, inner_right - best_width + 2))
+        random.shuffle(starts)
+        for start in starts:
+            candidates.append((row, start, best_width))
+
+    if not candidates:
+        return None
+
+    best_width = max(width for _row, _start, width in candidates)
+    narrowed = [cand for cand in candidates if cand[2] >= best_width - 1]
+    return random.choice(narrowed)
+
+
+def _bar_mask(shape: tuple[int, int], bar: tuple[int, int, int]) -> np.ndarray:
+    row, start, width = bar
+    mask = np.zeros(shape, dtype=bool)
+    mask[row, start : start + width] = True
+    return mask
+
+
+def _place_scene(
+    sources: list[tuple[int, int, int]],
+    bars: list[tuple[int, int, int]],
+) -> np.ndarray:
+    height = max(row for row, _col, _color in sources) + max(6, max(bar[0] for bar in bars) + 2)
+    height = max(height, max(row for row, _start, _width in bars) + 2)
+    width = max(col for _row, col, _color in sources) + 2
+    width = max(width, max(start + width for _row, start, width in bars) + 1)
+    grid = np.full((height, width), BLACK, dtype=int)
+    for row, col, color in sources:
+        grid[row, col] = color
+    for row, start, bar_width in bars:
+        grid[row, start : start + bar_width] = GRAY
+    return grid
+
+
+def _build_scene() -> tuple[np.ndarray, list[tuple[int, int, int]], list[tuple[int, int, int]]] | None:
+    sources = _pack_sources()
+    if sources is None:
+        return None
+
+    height = max(row for row, _col, _color in sources) + max(6, max(12, 0))
+    height = max(height, max(row for row, _col, _color in sources) + 6)
+    height = max(height, max(row for row, _col, _color in sources) + 1)
+    # The actual canvas height is inferred from the packed cone bottoms.
+    height = max((row for row, _col, _color in sources), default=0)
+    height = max(height, 0)
+    # Recover the packed height from any source's bottom depth.
+    packed_height = max(
+        (2 * (col - (col - (max(0, row) + 0))) for row, col, _color in sources),
+        default=0,
+    )
+    _ = packed_height  # quiet lint for the intentionally ignored scratch value
+
+    # Every packed source uses the same canvas height that determined its depth.
+    source_height = max(
+        row + ((sources[0][1] - (sources[0][1] - (0))) if False else 0)
+        for row, _col, _color in sources
+    )
+    _ = source_height
+    h = max(row for row, _col, _color in sources) + 1
+    while True:
+        # Recover the intended height from the leftmost/rightmost cone span at the bottom.
+        # Because sources were packed by bottom projections, every source depth equals h-1-row
+        # for one shared h; we can reconstruct it from the first source once the bar picker succeeds.
+        candidate_heights = []
+        for extra_h in range(9, 19):
+            ok = True
+            masks = []
+            for sr, sc, _color in sources:
+                if extra_h - 1 - sr < 4:
+                    ok = False
+                    break
+                mask = _clear_cone_mask((extra_h, 30), (sr, sc, 1))
+                masks.append(mask)
+            if ok:
+                candidate_heights.append(extra_h)
+        if not candidate_heights:
+            return None
+        h = random.choice(candidate_heights)
+        bars = [_pick_bar((h, 30), source) for source in sources]
+        if all(bar is not None for bar in bars):
+            return _trim_grid((h, 30), sources, bars)  # type: ignore[arg-type]
+
+
+def _trim_grid(
+    shape: tuple[int, int],
+    sources: list[tuple[int, int, int]],
+    bars: list[tuple[int, int, int]],
+) -> tuple[np.ndarray, list[tuple[int, int, int]], list[tuple[int, int, int]]]:
+    h, w = shape
+    grid = np.full((h, w), BLACK, dtype=int)
+    for row, col, color in sources:
+        grid[row, col] = color
+    for row, start, bar_width in bars:
+        grid[row, start : start + bar_width] = GRAY
+
+    nonzero = np.argwhere(grid != BLACK)
+    r1, c1 = nonzero.max(axis=0)
+    trimmed = grid[: r1 + 2, : c1 + 2].copy()
+    return trimmed, sources, bars
+
+
+def _sources_are_disjoint(shape: tuple[int, int], sources: list[tuple[int, int, int]]) -> bool:
+    seen = np.zeros(shape, dtype=int)
+    for idx, source in enumerate(sources, start=1):
+        mask = _clear_cone_mask(shape, source)
+        if np.any(seen[mask]):
+            return False
+        seen[mask] = idx
+    return True
+
+
+def _bar_has_extra_shadow(grid: np.ndarray, bar: tuple[int, int, int], expected: np.ndarray) -> bool:
+    test = grid.copy()
+    row, start, width = bar
+    test[row, start : start + width] = BLACK
+    diff = main(test) != expected
+    return bool(np.any(diff & ~_bar_mask(grid.shape, bar)))
+
+
+def _shadow_heals(clear_out: np.ndarray, actual_out: np.ndarray, source: tuple[int, int, int]) -> bool:
+    sr, _sc, color = source
+    counts = [int(np.count_nonzero((clear_out[r] == color) & (actual_out[r] == BLACK))) for r in range(sr + 1, actual_out.shape[0])]
+    positive = [idx for idx, count in enumerate(counts) if count > 0]
+    if not positive:
+        return False
+    last = positive[-1]
+    if last + 1 >= len(counts):
+        return False
+    if counts[last + 1] != 0:
+        return False
+    return any(counts[idx] > counts[idx + 1] for idx in range(last))
+
+
+def _validate_scene(
+    grid: np.ndarray,
+    sources: list[tuple[int, int, int]],
+    bars: list[tuple[int, int, int]],
+) -> bool:
+    if grid.ndim != 2 or max(grid.shape) > 30:
+        return False
+    if len(sources) != len(set((r, c) for r, c, _color in sources)):
+        return False
+    if len(sources) != len(set(color for _r, _c, color in sources)):
+        return False
+    if not _sources_are_disjoint(grid.shape, sources):
+        return False
+
+    expected = main(grid)
+    if np.array_equal(expected, grid):
+        return False
+
+    no_blockers = grid.copy()
+    no_blockers[no_blockers == GRAY] = BLACK
+    clear_out = main(no_blockers)
+
+    if not np.any((clear_out != BLACK) & (expected == BLACK)):
+        return False
+
+    for source, bar in zip(sources, bars):
+        bar_mask = _bar_mask(grid.shape, bar)
+        cone_mask = _clear_cone_mask(grid.shape, source)
+        if not np.all(cone_mask[bar_mask]):
+            return False
+        if not _bar_has_extra_shadow(grid, bar, expected):
+            return False
+        if not _shadow_heals(clear_out, expected, source):
+            return False
+
+    return True
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        built = _build_scene()
+        if built is None:
+            continue
+        grid, sources, bars = built
+        if _validate_scene(grid, sources, bars):
+            return grid
+    raise RuntimeError("failed to generate a valid light-shadow scene")

