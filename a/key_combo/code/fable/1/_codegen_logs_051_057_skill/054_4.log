+def _place_noise_pixels(
+    noise_colors: list[int],
+    shape: tuple[int, int],
+    occ_in: set[tuple[int, int]],
+    occ_out: set[tuple[int, int]],
+) -> tuple[list[tuple[int, int, int]], set[tuple[int, int]], set[tuple[int, int]]] | None:
