+    cur_in = set(occ_in)
+    cur_out = set(occ_out)
+    for sprite in sprites:
+        placed = False
+        for bend in _candidate_bends(sprite, shape):
+            pixels = _abs_pixels(sprite, bend)
+            if _fits_without_touch(pixels, shape, cur_in) and _fits_without_touch(
