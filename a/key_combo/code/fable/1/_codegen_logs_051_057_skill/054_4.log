+
+
+def _candidate_bends(sprite: dict[str, object], shape: tuple[int, int]) -> list[tuple[int, int]]:
+    h, w = shape
+    r0 = -int(sprite["min_r"])
+    r1 = h - 1 - int(sprite["max_r"])
+    c0 = -int(sprite["min_c"])
+    c1 = w - 1 - int(sprite["max_c"])
