+            tr, tc = sprites[target]["bend"]  # type: ignore[index]
+            dr = int(tr) - int(sr)
+            dc = int(tc) - int(sc)
+            moved_pixels = [
+                (int(r) + dr, int(c) + dc, int(color))
+                for r, c, color in sprites[idx]["pixels"]  # type: ignore[index]
+            ]
