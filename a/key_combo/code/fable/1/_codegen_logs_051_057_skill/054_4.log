+def _abs_pixels(sprite: dict[str, object], bend: tuple[int, int]) -> list[tuple[int, int, int]]:
+    br, bc = bend
+    return [
+        (br + int(dr), bc + int(dc), int(color))
+        for dr, dc, color in sprite["rel_pixels"]  # type: ignore[index]
+    ]
+
