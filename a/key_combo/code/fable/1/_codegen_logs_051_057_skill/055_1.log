+def _can_add_marker(pos: tuple[int, int], used: set[tuple[int, int]]) -> bool:
+    if pos in used:
+        return False
+    for rr, cc in used:
+        if abs(rr - pos[0]) + abs(cc - pos[1]) == 1:
+            return False
+    return True
