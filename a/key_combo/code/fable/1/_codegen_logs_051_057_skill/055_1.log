+
+def _edge_candidates(grid: np.ndarray) -> tuple[list[dict], list[dict], list[np.ndarray]]:
+    chambers, chamber_ids = _label_black_chambers(grid)
+    valid: list[dict] = []
+    invalid: list[dict] = []
