+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+
+    out = g.copy()
+    analysis = _analyze_grid(g)
+    for cid, colors in analysis["votes"].items():
+        fill = _majority_color(colors)
+        coords = analysis["chambers"][cid]
+        out[coords[:, 0], coords[:, 1]] = fill
+    return out
