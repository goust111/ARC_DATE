+def _find_divider(grid: np.ndarray, bg: int) -> tuple[int, int]:
+    divider_cols = [
+        c
+        for c in range(grid.shape[1])
+        if np.all(grid[:, c] != bg) and np.unique(grid[:, c]).size == 1
+    ]
