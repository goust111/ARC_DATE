+    out: np.ndarray,
+    divider_c: int,
+    rects: list[dict],
+    colors: list[int],
+) -> None:
+    right_c0 = divider_c + 1
+    for rect, color in zip(rects, colors):
+        for r, c in rect["coords"]:
