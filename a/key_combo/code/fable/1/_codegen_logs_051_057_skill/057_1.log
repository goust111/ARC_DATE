+    r, c = center
+    return {(r + dr, c + dc) for dr, dc in PLUS_OFFSETS}
+
+
+def _diag_gap(a: tuple[int, int], b: tuple[int, int]) -> list[tuple[int, int]] | None:
+    r1, c1 = a
+    r2, c2 = b
+    dr = r2 - r1
+    dc = c2 - c1
+    if dr == 0 or abs(dr) != abs(dc):
+        return None
+    sr = 1 if dr > 0 else -1
+    sc = 1 if dc > 0 else -1
+    return [(r1 + k * sr, c1 + k * sc) for k in range(1, abs(dr))]
+
