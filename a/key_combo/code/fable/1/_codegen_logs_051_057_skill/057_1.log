+    inside_pool = {tuple(map(int, cell)) for cell in np.argwhere(info["interior_mask"])}
+    outside_pool = {tuple(map(int, cell)) for cell in np.argwhere(info["exterior_mask"])}
+    inside_pool -= reserved
