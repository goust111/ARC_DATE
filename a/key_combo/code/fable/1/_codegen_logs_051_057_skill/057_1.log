+def _clear_diagonal_pairs(
+    grid: np.ndarray,
+    centers: list[tuple[int, int]],
+) -> tuple[set[tuple[tuple[int, int], tuple[int, int]]], dict[tuple[tuple[int, int], tuple[int, int]], tuple[tuple[int, int], ...]]]:
