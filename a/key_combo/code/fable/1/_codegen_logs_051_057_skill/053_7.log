+            continue
+        anchor_r = random.choice([r, r + 1])
+        target = (anchor_r, col + 1) if side == "left" else (anchor_r, col - 1)
+        if not (0 <= target[0] < h and 0 <= target[1] < grid.shape[1]) or int(grid[target]) != bg:
