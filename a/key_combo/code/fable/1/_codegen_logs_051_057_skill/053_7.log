+def _place_active_vertical(
+    grid: np.ndarray,
+    bg: int,
+    col: int,
+    color: int,
+    side: str,
+) -> dict | None:
+    h, _w = grid.shape
+    starts = list(range(0, h - 1))
+    random.shuffle(starts)
+    for r in starts:
+        cells = _domino_cells(r, col, "v")
