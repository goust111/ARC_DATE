+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+POWER = 5
+WIRE = 8
+DIR4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+PALETTE = [0, 1, 2, 3, 4, 6, 7, 9]
+
+
+def _get_bg(grid: np.ndarray) -> int:
