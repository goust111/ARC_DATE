+    assert g.ndim == 2 and g.size > 0
+    bg = _get_bg(g)
+
+    power_components = _components(g == POWER)
+    assert len(power_components) == 1, "expected one power component"
+    power_cells = power_components[0]
+    power_rows = {r for r, _c in power_cells}
