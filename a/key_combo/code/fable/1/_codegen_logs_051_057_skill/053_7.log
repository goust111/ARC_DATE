+            active_cols,
+            with_stub=with_stub,
+        )
+        color_index += 1
+        if domino is None:
+            return None
+        inactive_dominoes.append(domino)
+
+    if not _semantic_checks(grid, bg, active_dominoes, inactive_dominoes):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(600):
+        grid = _attempt_generate()
+        if grid is not None:
