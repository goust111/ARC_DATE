        c0 = block["ec0"] + pad
        patch = np.full((block["h"], block["w"]), Color.YELLOW, dtype=int)
        interior = [(r, c) for r in range(1, block["h"] - 1) for c in range(1, block["w"] - 1)]
        for r, c in random.sample(interior, pad):
            patch[r, c] = color
        paste(inp, patch, r0, c0)
        paste(out, patch, r0, c0)

    return inp, out

