+    sr, sc = map(int, start)
+    if not bool(mask[sr, sc]):
+        return dist
+    q: deque[tuple[int, int]] = deque([(sr, sc)])
+    dist[sr, sc] = 0
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(mask.shape, r, c):
+            if not bool(mask[nr, nc]) or dist[nr, nc] != -1:
+                continue
