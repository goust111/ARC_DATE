+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = map(int, shape)
+    return 0 <= int(r) < h and 0 <= int(c) < w
+
+
+def _neighbors4(shape: tuple[int, int], r: int, c: int):
+    for dr, dc in OFFSETS4:
+        nr, nc = int(r) + dr, int(c) + dc
+        if _in_bounds(shape, nr, nc):
+            yield nr, nc
