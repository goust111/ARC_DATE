+                if _manhattan(near["pos"], far["pos"]) < 4:
+                    continue
+                score = (
+                    5 * (far["gdist"] - near["gdist"])
+                    + 2 * (near["mdist"] - far["mdist"])
+                    + (near["edist2"] - far["edist2"])
+                )
+                if best_score is None or score > best_score or (
+                    score == best_score and random.random() < 0.5
+                ):
