+    wrong = _paint_with_order(
+        grid,
+        odd_color=manhattan_order[0]["color"],
+        even_color=manhattan_order[1]["color"],
+    )
+    if np.array_equal(correct, wrong):
+        return False
+
+    if np.array_equal(correct, grid):
