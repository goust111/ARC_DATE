+    return segments
+
+
+def _ordered_segments_from_grid(g: np.ndarray) -> tuple[list[int], list[dict], np.ndarray]:
+    bg = get_bg(g)
+    _rect_comp, layer_colors, rect_mask = _find_dictionary_rectangle(g, bg)
+    segments = _extract_segments(g, bg, rect_mask)
