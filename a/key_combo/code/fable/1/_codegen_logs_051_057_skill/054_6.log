   223	    exclude = set() if exclude is None else set(exclude)
   224	    prefer = [] if prefer is None else [int(c) for c in prefer if int(c) not in exclude]
   225	    if prefer and random.random() < 0.35:
   226	        return int(random.choice(prefer))
   227	    pool = [int(c) for c in PALETTE if int(c) not in exclude]
   228	    return int(random.choice(pool))
