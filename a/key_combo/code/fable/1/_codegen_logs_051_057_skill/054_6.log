   231	def _random_near_miss(base_mask: np.ndarray, template_mask: np.ndarray) -> np.ndarray:
   232	    base = np.asarray(base_mask, dtype=bool)
   233	    rotations = _rotation_orbit(template_mask)
   234	    reflections = _reflection_orbit(template_mask)
   235	    occupied = [tuple(map(int, rc)) for rc in np.argwhere(base)]
   236	    empty = [tuple(map(int, rc)) for rc in np.argwhere(~base)]
   237	    random.shuffle(occupied)
   238	    random.shuffle(empty)
   239	
   240	    for rr, cc in occupied:
   241	        removed = base.copy()
   242	        removed[rr, cc] = False
   243	        if not _is_connected(removed):
   244	            continue
   245	        add_candidates = []
   246	        for ar, ac in empty:
   247	            if removed[ar, ac]:
   248	                continue
   249	            for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
   250	                nr, nc = ar + dr, ac + dc
   251	                if 0 <= nr < removed.shape[0] and 0 <= nc < removed.shape[1] and removed[nr, nc]:
   252	                    add_candidates.append((ar, ac))
   253	                    break
   254	        random.shuffle(add_candidates)
   255	        for ar, ac in add_candidates:
   256	            trial = removed.copy()
   257	            trial[ar, ac] = True
   258	            if not (trial[0].any() and trial[-1].any() and trial[:, 0].any() and trial[:, -1].any()):
