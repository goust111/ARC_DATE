+
+
+def _random_other_negative(template_mask: np.ndarray) -> np.ndarray:
+    rotation_orbit = _rotation_orbit(template_mask)
+    reflection_orbit = _reflection_orbit(template_mask)
+    for _ in range(120):
+        h = random.randint(2, 4)
+        w = random.randint(2, 4)
