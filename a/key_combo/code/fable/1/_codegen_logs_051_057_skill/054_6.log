+        for c in range(0, w - pw + 1):
+            r0 = max(0, r - pad)
+            c0 = max(0, c - pad)
+            r1 = min(h, r + ph + pad)
+            c1 = min(w, c + pw + pad)
+            if not bool(blocked[r0:r1, c0:c1].any()):
+                choices.append((r, c))
