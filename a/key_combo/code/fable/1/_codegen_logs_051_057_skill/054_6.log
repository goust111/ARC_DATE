   148	def _find_legend(grid: np.ndarray, bg: int) -> tuple[int, int, int, np.ndarray]:
   149	    g = np.asarray(grid, dtype=int)
   150	    h, w = g.shape
   151	    candidates: list[tuple[int, int, int, np.ndarray]] = []
   152	    for r in range(1, h - 1):
   153	        for c in range(1, w - 1):
   154	            border_color = int(g[r, c])
   155	            if border_color == int(bg):
   156	                continue
   157	            if not bool(np.all(g[r, : c + 1] == border_color)):
   158	                continue
   159	            if not bool(np.all(g[: r + 1, c] == border_color)):
   160	                continue
   161	            if c + 1 < w and int(g[r, c + 1]) == border_color:
   162	                continue
   163	            if r + 1 < h and int(g[r + 1, c]) == border_color:
   164	                continue
   165	
   166	            interior = g[:r, :c]
   167	            if np.any(interior == border_color):
   168	                continue
   169	            inner_colors = set(map(int, np.unique(interior))) - {int(bg)}
   170	            if len(inner_colors) != 1:
   171	                continue
   172	            template_color = inner_colors.pop()
   173	            template_mask = interior == template_color
   174	            if len(components_mask(template_mask, connectivity=4)) != 1:
   175	                continue
   176	            cropped = _crop_mask(template_mask)
   177	            if min(cropped.shape) < 2 or not _is_connected(cropped):
   178	                continue
   179	            candidates.append((r, c, border_color, cropped))
