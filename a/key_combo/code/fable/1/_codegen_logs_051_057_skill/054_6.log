   185	def main(grid: np.ndarray) -> np.ndarray:
   186	    """
   187	    Recolor only the components that are scaled-and-rotated copies of the legend miniature.
   188	
   189	    Input structure:
   190	    - The upper-left corner contains a legend region whose bottom edge and right edge form a single-color L-shaped border.
   191	    - Inside that legend is one monochrome template shape on the background.
   192	    - Elsewhere in the grid are several monochrome 4-connected components of different colors, sizes, and orientations.
   193	
   194	    Rule:
   195	    - Detect the legend, extract the template shape, and clear the entire legend rectangle including its border.
   196	    - For every remaining component, ignore its color and test whether its cropped shape equals an integer pixel-scale copy of the template after a rotation by 0/90/180/270 degrees.
   197	    - Recolor every matching component to the legend border color, and erase every non-matching component, including mirror-only decoys.
   198	
   199	    Key insight:
   200	    - The legend is a scale-independent shape key: only exact integer scale-ups of the template survive, and reflections must be rejected even if they look very similar.
   201	    """
   202	    g = np.asarray(grid, dtype=int)
   203	    bg = int(get_bg(g))
   204	    legend_r, legend_c, border_color, template_mask = _find_legend(g, bg)
   205	
   206	    out = g.copy()
   207	    out[: legend_r + 1, : legend_c + 1] = bg
   208	
   209	    work = g.copy()
   210	    work[: legend_r + 1, : legend_c + 1] = bg
   211	    comps = find_components(work, bg=bg, connectivity=4, monochromatic=True, return_format="dict")
   212	
   213	    for comp in comps:
   214	        comp_mask = _component_mask(comp)
   215	        target_color = border_color if _match_scaled_rotation(comp_mask, template_mask) is not None else bg
   216	        for r, c in comp["coords"]:
   217	            out[int(r), int(c)] = int(target_color)
   218	
   219	    return out
