+    r0 = max(0, r - pad)
+    c0 = max(0, c - pad)
+    r1 = min(blocked.shape[0], r + ph + pad)
+    c1 = min(blocked.shape[1], c + pw + pad)
+    blocked[r0:r1, c0:c1] = True
