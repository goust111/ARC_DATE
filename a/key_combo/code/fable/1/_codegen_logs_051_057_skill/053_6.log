+def _max_run(indices: set[int]) -> int:
+    best = 0
+    run = 0
+    prev = None
+    for idx in sorted(indices):
+        if prev is not None and idx == prev + 1:
+            run += 1
+        else:
+            run = 1
+        best = max(best, run)
+        prev = idx
+    return best
