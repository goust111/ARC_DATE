+    h, w = shape
+    out = []
+    for nr, nc in neighbors8(*endpoint):
+        if not (1 <= nr < h - 1 and 1 <= nc < w - 1):
+            continue
+        if (nr, nc) in used:
+            continue
+        if any((ar, ac) in used and (ar, ac) != endpoint for ar, ac in neighbors8(nr, nc)):
+            continue
+        out.append((nr, nc))
+    return out
+
