    for _ in range(m * n // 3):
        r, c = random.randint(0, m - 1), random.randint(0, n - 1)
        # do not sprinkle teal pixels on top of red ones
        if grid[r, c] != Color.RED:
            grid[r, c] = Color.TEAL
    
    return grid
