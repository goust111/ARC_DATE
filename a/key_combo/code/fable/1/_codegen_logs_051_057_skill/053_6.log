+    g = np.asarray(grid, dtype=int)
+    bg = get_bg(g)
+    order = _extract_path_order(g != bg)
+    samples = _samples_from_grid(g, order, bg)
+    _period, cycle = _infer_shortest_cycle(samples, len(order))
+    return _render_colored_path(g.shape, order, cycle, bg)
