+    seen = {coords[0]}
+    stack = [coords[0]]
+    while stack:
+        r, c = stack.pop()
+        for nr, nc in neighbors8(r, c):
+            if (nr, nc) in seen or not _in_bounds(mask.shape, nr, nc):
+                continue
+            if not bool(mask[nr, nc]):
