+    order: list[tuple[int, int]],
+    cycle: tuple[int, ...],
+    bg: int,
+) -> np.ndarray:
+    out = np.full(shape, bg, dtype=int)
+    period = len(cycle)
+    for idx, (r, c) in enumerate(order):
+        out[r, c] = int(cycle[idx % period])
+    return out
+
