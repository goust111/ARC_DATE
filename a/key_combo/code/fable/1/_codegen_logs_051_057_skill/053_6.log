+BG = 0
+GREY = 5
+PATH_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+
+GRID_MIN = 12
+GRID_MAX = 22
+PATH_LEN_MIN = 12
+PATH_LEN_MAX = 24
+PERIOD_MIN = 2
+PERIOD_MAX = 6
