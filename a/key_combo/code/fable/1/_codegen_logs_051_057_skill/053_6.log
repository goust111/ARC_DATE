+    candidates = _candidate_cycles(samples, path_length)
+    assert candidates, "samples must determine at least one full periodic coloring"
+    return candidates[0]
+
+
+def _render_colored_path(
+    shape: tuple[int, int],
+    order: list[tuple[int, int]],
+    cycle: tuple[int, ...],
+    bg: int,
+) -> np.ndarray:
