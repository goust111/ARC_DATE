+def _future_freedom(
+    shape: tuple[int, int],
+    used: set[tuple[int, int]],
+    endpoint: tuple[int, int],
+    candidate: tuple[int, int],
+) -> int:
+    new_used = set(used)
+    new_used.add(candidate)
+    return len(_extension_candidates(shape, new_used, candidate))
