+        assert len(nxt) == 1, "path traversal must be unambiguous"
+        prev, cur = cur, nxt[0]
+        order.append(cur)
+        assert len(order) <= len(coords), "path traversal cannot revisit cells"
+
+    assert len(order) == len(coords), "path traversal must cover the whole curve"
+    return order
+
+
