+
+def _components_of_color(grid: np.ndarray, color: int) -> list[dict]:
+    mask = grid == int(color)
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    out: list[dict] = []
+    for start_r, start_c in np.argwhere(mask):
+        r0 = int(start_r)
+        c0 = int(start_c)
+        if seen[r0, c0]:
+            continue
+        stack = [(r0, c0)]
+        seen[r0, c0] = True
+        coords: list[tuple[int, int]] = []
+        while stack:
+            r, c = stack.pop()
+            coords.append((r, c))
+            for dr, dc in DIR4:
+                rr = r + dr
+                cc = c + dc
+                if 0 <= rr < h and 0 <= cc < w and mask[rr, cc] and not seen[rr, cc]:
+                    seen[rr, cc] = True
+                    stack.append((rr, cc))
+        coord_array = np.array(coords, dtype=int)
+        out.append(
+            {
+                "color": int(color),
+                "coords": coord_array,
+                "bbox": _bbox_from_coords(coord_array),
+                "area": int(len(coords)),
+            }
+        )
+    return out
+
+
+def _is_hollow_frame(grid: np.ndarray, comp: dict) -> bool:
+    color = int(comp["color"])
+    r0, c0, r1, c1 = comp["bbox"]
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return False
+    if int(comp["area"]) != 2 * h + 2 * w - 4:
+        return False
+    patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+    expected = np.zeros((h, w), dtype=bool)
+    expected[0, :] = True
+    expected[-1, :] = True
+    expected[:, 0] = True
+    expected[:, -1] = True
+    return np.array_equal(patch == color, expected)
+
+
+def _detect_panels(grid: np.ndarray) -> tuple[int, int, int, list[tuple[int, int, int, int]]]:
