+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+VELOCITY_VALUES = (-2, -1, 0, 1, 2)
+SPECIAL_BOUNCE_MODES = ("h", "v", "corner")
+MAX_GENERATION_ATTEMPTS = 500
