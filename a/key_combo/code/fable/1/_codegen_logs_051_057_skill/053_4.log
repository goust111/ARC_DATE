+    for color in map(int, np.unique(grid)):
+        for comp in _components_of_color(grid, color):
+            if not _is_hollow_frame(grid, comp):
+                continue
+            r0, c0, r1, c1 = comp["bbox"]
+            groups[(int(color), r1 - r0 + 1, c1 - c0 + 1)].append(comp["bbox"])
