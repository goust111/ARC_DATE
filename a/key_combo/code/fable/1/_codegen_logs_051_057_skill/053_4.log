+                    )
+    random.shuffle(candidates)
+    return candidates
+
+
+def _far_enough(a: tuple[int, int], b: tuple[int, int]) -> bool:
+    return max(abs(a[0] - b[0]), abs(a[1] - b[1])) >= 2
