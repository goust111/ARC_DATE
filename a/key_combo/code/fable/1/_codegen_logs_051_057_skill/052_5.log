+    except Exception:
+        return False
+
+    if len(row_regions) != rows or len(col_regions) != cols:
+        return False
+    parsed_simple = {
+        cell: {"color": int(info["color"]), "direction": info["direction"]}
+        for cell, info in parsed.items()
