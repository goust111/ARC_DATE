def _gen_solid_shape(solid):
    sr0, sc0, sr1, sc1 = solid
    return sr1 - sr0 + 1, sc1 - sc0 + 1


def _gen_trail_len(n, r, c, dr, dc):
    length = 0
    r += dr
    c += dc
    while 0 <= r < n and 0 <= c < n:
        length += 1
        r += dr
        c += dc
    return length


def _gen_valid_config(n, r0, c0, solid, active):
