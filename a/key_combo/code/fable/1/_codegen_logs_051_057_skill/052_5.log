+    for row_idx, (r0, r1) in enumerate(row_regions):
+        for col_idx, (c0, c1) in enumerate(col_regions):
+            assert not np.any(g[r0 : r1 + 1, c0 : c1 + 1] == line_color), "separator leaked into a cell"
