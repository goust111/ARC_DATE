+    Color.BLUE,
+    Color.YELLOW,
+    Color.GREY,
+    Color.PINK,
+    Color.ORANGE,
+    Color.TEAL,
+    Color.MAROON,
+]
+
+DIRS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+ORIENTATION = {"up": "v", "down": "v", "left": "h", "right": "h"}
+H_FLIP_DIR = {"up": "up", "down": "down", "left": "right", "right": "left"}
+V_FLIP_DIR = {"up": "down", "down": "up", "left": "left", "right": "right"}
+TRANSPOSE_DIR = {"up": "left", "down": "right", "left": "up", "right": "down"}
+
+BASE_GLYPH = np.array(
+    [
+        [1, 1, 1],
+        [1, 0, 1],
+        [1, 1, 1],
