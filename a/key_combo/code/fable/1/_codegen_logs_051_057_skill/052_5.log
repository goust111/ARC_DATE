+    blocker_cells = set(blocked_targets)
+    if not blocker_cells:
+        return False
+    if not any(path and not stopped_by_marker[cell] for cell, path in paths.items()):
+        return False
+    if any((not paths[cell]) and cell not in blocker_cells for cell in markers):
+        return False
