+
+def _simulate_rays(
+    rows: int,
+    cols: int,
+    markers: dict[tuple[int, int], dict],
+) -> tuple[
+    dict[tuple[int, int], list[tuple[int, int]]],
+    dict[tuple[int, int], list[tuple[int, int]]],
+    dict[tuple[int, int], bool],
+    dict[tuple[int, int], set[tuple[int, int]]],
+]:
