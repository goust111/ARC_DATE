+        glyph = GLYPHS[info["direction"]] * int(info["color"])
+        r0, c0, r1, c1 = _cell_bbox(row, col, cell_h, cell_w)
+        glyph_r = r0 + random.randint(0, cell_h - 3)
+        glyph_c = c0 + random.randint(0, cell_w - 3)
