+                    return False
+                continue
+            if not np.array_equal(inp[r0 : r1 + 1, c0 : c1 + 1], expected[r0 : r1 + 1, c0 : c1 + 1]):
+                changed_cells += 1
+    return changed_cells > 0
+
+
+def _gen_attempt(scenario: str) -> np.ndarray | None:
+    rows, cols, markers = _scenario_layout(scenario)
