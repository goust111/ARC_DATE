+    for (r, c), info in markers.items():
+        new_info = dict(info)
+        new_info["direction"] = V_FLIP_DIR[info["direction"]]
+        flipped[(rows - 1 - r, c)] = new_info
+    return rows, cols, flipped
+
+
+def _layout_transpose(rows: int, cols: int, markers: dict[tuple[int, int], dict]):
