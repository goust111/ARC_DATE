+    "up": (0, 1),
+    "down": (2, 1),
+    "left": (1, 0),
+    "right": (1, 2),
+}
+GLYPHS: dict[str, np.ndarray] = {}
+GLYPH_TO_DIR: dict[tuple[int, ...], str] = {}
+for _direction, (_gr, _gc) in GAP_POS.items():
+    _glyph = BASE_GLYPH.copy()
+    _glyph[_gr, _gc] = 0
+    GLYPHS[_direction] = _glyph
+    GLYPH_TO_DIR[tuple(int(v) for v in _glyph.ravel())] = _direction
+
+
