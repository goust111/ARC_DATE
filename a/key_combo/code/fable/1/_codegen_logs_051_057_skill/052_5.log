def _gen_tile_29ec7d0e(p: int) -> np.ndarray:
    rows = np.arange(p)[:, None]
    cols = np.arange(p)[None, :]
    tile = (rows * cols) % p + 1
    tile[0, :] = 1
    tile[:, 0] = 1
    return tile.astype(int)


