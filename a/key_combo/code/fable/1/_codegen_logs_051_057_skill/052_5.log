+    visits, paths, stopped_by_marker, blocked_targets = _simulate_rays(rows, cols, markers)
+    if not visits:
+        return False
+
+    for sources in visits.values():
+        if len(sources) > 2:
+            return False
+        if len(sources) == 2:
+            orientations = {ORIENTATION[markers[cell]["direction"]] for cell in sources}
+            if len(orientations) != 2:
