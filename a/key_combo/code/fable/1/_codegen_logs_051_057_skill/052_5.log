+
+def _regions_between(lines: list[int], limit: int) -> list[tuple[int, int]]:
+    regions: list[tuple[int, int]] = []
+    prev = -1
+    for line in sorted(int(v) for v in lines) + [int(limit)]:
+        start = prev + 1
+        end = line - 1
+        if start <= end:
