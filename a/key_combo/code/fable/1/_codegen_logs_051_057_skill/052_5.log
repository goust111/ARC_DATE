        ((r0, c1), (-1, 1)),
        ((r1, c0), (1, -1)),
        ((r1, c1), (1, 1)),
    ]

    active_rays = 0
    for (r, c), (dr, dc) in corner_rays:
        rr, cc = r + dr, c + dc
        while in_bounds(g.shape, rr, cc) and g[rr, cc] == bg:
            rr += dr
            cc += dc

