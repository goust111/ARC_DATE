+
+
+def _apply_random_symmetry(rows: int, cols: int, markers: dict[tuple[int, int], dict]):
+    if random.random() < 0.5:
+        rows, cols, markers = _layout_flip_h(rows, cols, markers)
+    if random.random() < 0.5:
+        rows, cols, markers = _layout_flip_v(rows, cols, markers)
+    if random.random() < 0.5:
