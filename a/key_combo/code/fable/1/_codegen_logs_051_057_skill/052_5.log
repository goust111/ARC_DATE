    grid = np.zeros((height, width), dtype=int)
    grid[_gen_line_positions(row_bands), :] = Color.GREEN
    grid[:, _gen_line_positions(col_bands)] = Color.GREEN

    try:
        main(grid)
    except Exception:
        return None
    return grid


