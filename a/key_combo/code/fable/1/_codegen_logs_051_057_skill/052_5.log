+def _render_layout(
+    rows: int,
+    cols: int,
+    cell_h: int,
+    cell_w: int,
+    markers: dict[tuple[int, int], dict],
+) -> tuple[np.ndarray, np.ndarray]:
+    grid_h = rows * cell_h + (rows - 1)
+    grid_w = cols * cell_w + (cols - 1)
