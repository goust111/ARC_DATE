+
+
+def _nearest_rect_index(cell: Coord, rects: list[Rect]) -> Optional[int]:
+    dists = [_rect_king_distance(rect, cell) for rect in rects]
+    best = min(dists)
+    winners = [i for i, dist in enumerate(dists) if dist == best]
+    if len(winners) != 1:
