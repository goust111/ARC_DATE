+    return [
+        (top_r0, left_c0, top_r1, left_c1),
+        (top_r0, right_c0, top_r1, right_c1),
+        (bottom_r0, left_c0, bottom_r1, left_c1),
+        (bottom_r0, right_c0, bottom_r1, right_c1),
+    ]
+
+
+def _random_rect(box: Rect) -> Optional[Rect]:
