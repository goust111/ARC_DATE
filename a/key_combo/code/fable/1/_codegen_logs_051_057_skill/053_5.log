+Coord = tuple[int, int]
+Rect = tuple[int, int, int, int]
+
+
+def _neighbors4(r: int, c: int) -> tuple[Coord, Coord, Coord, Coord]:
+    return (r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)
+
+
+def _king_distance(a: Coord, b: Coord) -> int:
+    return max(abs(a[0] - b[0]), abs(a[1] - b[1]))
