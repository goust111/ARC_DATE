+import random
+from typing import Optional
+
+import numpy as np
+
+
+BG = 0
+GRAY = 5
+COLOR_POOL = [1, 2, 3, 4, 6, 7, 8, 9]
+DIRECTIONS = ("up", "down", "left", "right")
+
+GEN_GRID_MIN = 24
+GEN_GRID_MAX = 30
+GEN_SECTOR_GAP = 5
+GEN_OUTER_MARGIN = 1
+GEN_RECT_MIN = 5
+GEN_RECT_MAX = 7
+GEN_RETRIES = 600
