+    left_c0 = GEN_OUTER_MARGIN
+    left_c1 = left_c0 + left_w - 1
+    right_c0 = left_c1 + GEN_SECTOR_GAP + 1
+    right_c1 = w - GEN_OUTER_MARGIN - 1
