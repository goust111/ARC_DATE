+
+def _pixel_clear(cell: Coord, rect_idx: int, rects: list[Rect], used: set[Coord]) -> bool:
+    if cell in used:
+        return False
+    if any(_king_distance(cell, other) <= 1 for other in used):
+        return False
+    winner = _nearest_rect_index(cell, rects)
+    return winner == rect_idx
+
