+def _draw_transformed_rect(
+    out: np.ndarray,
+    rect: Rect,
+    border_color: int,
+    interior_color: int,
+    door: Coord,
+) -> None:
+    r0, c0, r1, c1 = rect
+    out[r0 : r1 + 1, c0 : c1 + 1] = interior_color
+    out[r0, c0 : c1 + 1] = border_color
+    out[r1, c0 : c1 + 1] = border_color
+    out[r0 : r1 + 1, c0] = border_color
+    out[r0 : r1 + 1, c1] = border_color
