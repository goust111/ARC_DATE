+    max_h = min(GEN_RECT_MAX, r1 - r0 + 1)
+    max_w = min(GEN_RECT_MAX, c1 - c0 + 1)
+    if max_h < GEN_RECT_MIN or max_w < GEN_RECT_MIN:
+        return None
+    h = random.randint(GEN_RECT_MIN, max_h)
+    w = random.randint(GEN_RECT_MIN, max_w)
