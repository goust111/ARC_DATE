+def _gen_attempt() -> Optional[np.ndarray]:
+    h = random.randint(GEN_GRID_MIN, GEN_GRID_MAX)
+    w = random.randint(GEN_GRID_MIN, GEN_GRID_MAX)
+    n_rects = random.choices([2, 3, 4], weights=[1, 3, 4])[0]
