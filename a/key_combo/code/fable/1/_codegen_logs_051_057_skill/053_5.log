+
+def _components(mask: np.ndarray) -> list[list[Coord]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[Coord]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[Coord] = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(coords)
+    return comps
+
+
+def _rect_king_distance(rect: Rect, cell: Coord) -> int:
+    r0, c0, r1, c1 = rect
+    r, c = cell
+    dr = 0 if r0 <= r <= r1 else min(abs(r - r0), abs(r - r1))
+    dc = 0 if c0 <= c <= c1 else min(abs(c - c0), abs(c - c1))
+    return max(dr, dc)
+
+
+def _strict_side(rect: Rect, cell: Coord) -> Optional[str]:
+    r0, c0, r1, c1 = rect
+    r, c = cell
+    matches: list[str] = []
+    if r < r0 and c0 <= c <= c1:
+        matches.append("up")
+    if r > r1 and c0 <= c <= c1:
+        matches.append("down")
+    if c < c0 and r0 <= r <= r1:
+        matches.append("left")
+    if c > c1 and r0 <= r <= r1:
+        matches.append("right")
+    if len(matches) > 1:
+        raise AssertionError("a pixel cannot strictly face two sides")
+    return matches[0] if matches else None
+
+
+def _door_cell(rect: Rect, far_pixel: Coord) -> Coord:
+    r0, c0, r1, c1 = rect
+    r, c = far_pixel
+    side = _strict_side(rect, far_pixel)
+    if side == "up":
+        return r0, c
+    if side == "down":
+        return r1, c
+    if side == "left":
+        return r, c0
+    if side == "right":
+        return r, c1
+    raise AssertionError("far pixel must strictly face one rectangle side")
+
+
+def _ring_points(rect: Rect, dist: int) -> list[Coord]:
+    r0, c0, r1, c1 = rect
+    pts: list[Coord] = []
+    top = r0 - dist
+    bottom = r1 + dist
+    left = c0 - dist
+    right = c1 + dist
+    for c in range(left, right + 1):
+        pts.append((top, c))
+        pts.append((bottom, c))
+    for r in range(top + 1, bottom):
+        pts.append((r, left))
+        pts.append((r, right))
+    return pts
+
+
+def _side_points(rect: Rect, direction: str, dist: int) -> list[Coord]:
+    r0, c0, r1, c1 = rect
+    if direction == "up":
+        return [(r0 - dist, c) for c in range(c0, c1 + 1)]
+    if direction == "down":
+        return [(r1 + dist, c) for c in range(c0, c1 + 1)]
+    if direction == "left":
+        return [(r, c0 - dist) for r in range(r0, r1 + 1)]
+    if direction == "right":
