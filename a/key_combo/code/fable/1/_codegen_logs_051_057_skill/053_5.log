+        near = group[0]
+        far = group[1]
+        if int(near["dist"]) >= int(far["dist"]):
+            raise AssertionError("distance ranks must be strict")
+        if int(near["color"]) == int(far["color"]):
+            raise AssertionError("near and far colors must differ so both roles stay visible")
