+    return comps
+
+
+def _rect_king_distance(rect: Rect, cell: Coord) -> int:
+    r0, c0, r1, c1 = rect
+    r, c = cell
+    dr = 0 if r0 <= r <= r1 else min(abs(r - r0), abs(r - r1))
+    dc = 0 if c0 <= c <= c1 else min(abs(c - c0), abs(c - c1))
+    return max(dr, dc)
+
+
+def _strict_side(rect: Rect, cell: Coord) -> Optional[str]:
+    r0, c0, r1, c1 = rect
+    r, c = cell
+    matches: list[str] = []
+    if r < r0 and c0 <= c <= c1:
+        matches.append("up")
+    if r > r1 and c0 <= c <= c1:
+        matches.append("down")
+    if c < c0 and r0 <= r <= r1:
+        matches.append("left")
+    if c > c1 and r0 <= r <= r1:
+        matches.append("right")
