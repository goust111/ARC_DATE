+def _build_case() -> tuple[np.ndarray, np.ndarray, dict] | None:
+    orient = random.choice(["h", "v"])
+    height = random.randint(10, 20)
+    width = random.randint(10, 20)
+
+    if orient == "v":
+        if width < 10:
+            return None
