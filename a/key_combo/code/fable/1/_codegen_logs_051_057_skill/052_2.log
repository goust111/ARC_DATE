+                image = (source[0], axis + step * (wall_dist - 1))
+            else:
+                post_wall = (axis + step * wall_dist, source[1])
+                image = (axis + step * (wall_dist - 1), source[1])
+            if int(grid[post_wall]) != BLACK or image == source:
+                return None
+            grid[post_wall] = GREY
+
+        sources_meta.append(
+            {
+                "branch": branch,
+                "color": int(color),
+                "source": source,
+                "target": target,
+                "image": image,
+                "pre_wall": pre_wall,
