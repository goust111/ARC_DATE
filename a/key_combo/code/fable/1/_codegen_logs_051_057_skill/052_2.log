+        grid[source] = color
+        pre_wall = None
+        post_wall = None
+        image = target
+
+        if branch == "pre":
+            offset = random.randint(1, distance - 1)
+            if orient == "v":
+                pre_wall = (source[0], source[1] + step * offset)
+            else:
+                pre_wall = (source[0] + step * offset, source[1])
+            if int(grid[pre_wall]) != BLACK:
+                return None
+            grid[pre_wall] = GREY
+            image = None
+        elif branch == "post":
+            wall_dist = random.randint(2, distance)
+            if orient == "v":
