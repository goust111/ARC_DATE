+    if side_set != {meta["source_side"]}:
+        return False
+
+    for item in meta["sources"]:
+        branch = item["branch"]
+        branch_counts[branch] += 1
+        source = item["source"]
+        target = item["target"]
+        image = item["image"]
+        pre_wall = item["pre_wall"]
+        post_wall = item["post_wall"]
+
+        if int(g[source]) != int(item["color"]):
+            return False
+        if source == target or not _in_bounds(g.shape, *target):
+            return False
+
+        sr, sc = source
+        tr, tc = target
