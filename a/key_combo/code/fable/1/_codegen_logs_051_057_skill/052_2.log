+                image = (axis + step * (wall_dist - 1), source[1])
+            if int(grid[post_wall]) != BLACK or image == source:
+                return None
+            grid[post_wall] = GREY
+
+        sources_meta.append(
+            {
+                "branch": branch,
+                "color": int(color),
+                "source": source,
+                "target": target,
+                "image": image,
+                "pre_wall": pre_wall,
+                "post_wall": post_wall,
+                "distance": int(distance),
+                "ray": int(ray),
