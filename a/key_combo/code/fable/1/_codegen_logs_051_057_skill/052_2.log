+def _trace_source(
+    grid: np.ndarray,
+    orient: str,
+    axis: int,
+    source: tuple[int, int],
+    *,
+    block_before: bool,
+    stop_after: bool,
+) -> tuple[int, int, int] | None:
+    r, c = source
+    color = int(grid[r, c])
+    side = _source_side(orient, axis, source)
+    step = -side
+    distance = abs((c if orient == "v" else r) - axis)
+
+    if orient == "v":
+        if block_before:
+            for cc in range(c + step, axis, step):
+                if int(grid[r, cc]) == GREY:
+                    return None
+        target_c = axis + step * distance
+        if not (0 <= target_c < grid.shape[1]):
+            return None
+        final_c = target_c
+        if stop_after:
+            for cc in range(axis + step, target_c + step, step):
+                if int(grid[r, cc]) == GREY:
+                    final_c = cc - step
+                    break
+        if final_c == axis:
