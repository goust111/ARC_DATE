+    for source in sources:
+        traced = _trace_source(g, orient, axis, source, block_before=block_before, stop_after=stop_after)
+        if traced is None:
+            continue
+        rr, cc, color = traced
+        if int(g[rr, cc]) == BLACK:
+            out[rr, cc] = color
+    return out
