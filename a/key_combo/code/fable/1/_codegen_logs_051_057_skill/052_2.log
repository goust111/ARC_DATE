+    if block_before:
+        for rr in range(r + step, axis, step):
+            if int(grid[rr, c]) == GREY:
+                return None
+    target_r = axis + step * distance
+    if not (0 <= target_r < grid.shape[0]):
+        return None
+    final_r = target_r
+    if stop_after:
+        for rr in range(axis + step, target_r + step, step):
+            if int(grid[rr, c]) == GREY:
+                final_r = rr - step
+                break
