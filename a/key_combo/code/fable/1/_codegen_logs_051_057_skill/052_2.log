+    assert side != 0, "source pixels may not lie on the mirror line"
+    return side
+
+
+def _trace_source(
+    grid: np.ndarray,
+    orient: str,
+    axis: int,
+    source: tuple[int, int],
+    *,
+    block_before: bool,
+    stop_after: bool,
