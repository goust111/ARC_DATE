+    seen = np.zeros(rv * cw, dtype=int)
+
+    rows, cols = np.where(grid != BLACK)
+    for r, c in zip(rows.tolist(), cols.tolist()):
+        idx = (r % rv) * cw + (c % cw)
+        color = int(grid[r, c])
+        prev = int(palette[idx])
+        if prev == -1:
+            palette[idx] = color
+        elif prev != color:
