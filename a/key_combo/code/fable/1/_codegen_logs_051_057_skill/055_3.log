+                        "h_period": h_period,
+                        "row_shift": row_shift,
+                        "palette": palette,
+                        "repeat_pairs": repeat_pairs,
+                    }
+                )
+    return candidates
+
+
+def _unique_candidate(grid: np.ndarray) -> dict:
