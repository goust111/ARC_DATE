+        idx = (r % rv) * cw + (c % cw)
+        color = int(grid[r, c])
+        prev = int(palette[idx])
+        if prev == -1:
+            palette[idx] = color
+        elif prev != color:
+            return False
+        repeat_pairs += int(seen[idx])
+        seen[idx] += 1
+
+    if repeat_pairs == 0:
+        return False
+
+    for r in range(-1, h + 1):
+        for c in range(-1, w + 1):
+            idx = (r % rv) * cw + (c % cw)
+            if int(palette[idx]) == -1:
+                return False
+    return True
