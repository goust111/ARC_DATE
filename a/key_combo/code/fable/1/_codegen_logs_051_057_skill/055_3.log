+def _pair_stats(grid: np.ndarray, dr: int, dc: int) -> tuple[int, int]:
+    h, w = grid.shape
+    if dr < 0 or dc < 0 or dr >= h or dc >= w:
+        return 0, 0
+    a = grid[: h - dr, : w - dc]
+    b = grid[dr:, dc:]
+    mask = (a != BLACK) & (b != BLACK)
+    if not np.any(mask):
+        return 0, 0
+    same = int(np.count_nonzero(mask & (a == b)))
+    diff = int(np.count_nonzero(mask & (a != b)))
+    return same, diff
