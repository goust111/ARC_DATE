+    b = grid[dr:, dc:]
+    mask = (a != BLACK) & (b != BLACK)
+    if not np.any(mask):
+        return 0, 0
+    same = int(np.count_nonzero(mask & (a == b)))
+    diff = int(np.count_nonzero(mask & (a != b)))
+    return same, diff
