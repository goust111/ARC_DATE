+
+def _counts_unique_bg(grid: np.ndarray, bg: int) -> bool:
+    counts = Counter(map(int, grid.ravel()))
+    bg_count = counts[int(bg)]
+    return all(bg_count > count for color, count in counts.items() if int(color) != int(bg))
