+def _render_output_from_analysis(info: dict) -> np.ndarray:
+    g = info["grid"]
+    bg = int(info["bg"])
+    border_color = int(info["border_color"])
+    period_colors = list(info["period_colors"])
+    anchor_sum = int(info["anchor_sum"])
