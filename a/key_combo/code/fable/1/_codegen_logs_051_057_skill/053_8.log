+    out = np.zeros((h, w), dtype=bool)
+    out[0, :] = True
+    out[-1, :] = True
+    out[:, 0] = True
+    out[:, -1] = True
+    return out
+
+
+def _infer_period(colors: list[int]) -> int:
+    n = len(colors)
+    for p in range(1, n):
+        if all(colors[i] == colors[i + p] for i in range(n - p)):
+            return p
+    return n
+
