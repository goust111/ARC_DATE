+
+def _case_is_semantic(spec: dict, inp: np.ndarray, out: np.ndarray) -> bool:
+    bg = int(spec["bg"])
+    border_color = int(spec["border_color"])
+    orig_box = spec["orig_box"]
+    expanded_box = spec["expanded_box"]
+    direction = spec["direction"]
