+    if direction == "up":
+        return all(int(out[r, c]) == int(out[r + 1, c]) for r, c in new_cells)
+    if direction == "down":
+        return all(int(out[r, c]) == int(out[r - 1, c]) for r, c in new_cells)
+    if direction == "left":
+        return all(int(out[r, c]) == int(out[r, c + 1]) for r, c in new_cells)
+    return all(int(out[r, c]) == int(out[r, c - 1]) for r, c in new_cells)
