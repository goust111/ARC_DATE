+    or0, oc0, or1, oc1 = orig_box
+    nr0, nc0, nr1, nc1 = expanded_box
+    cells = []
+    for r in range(nr0 + 1, nr1):
+        for c in range(nc0 + 1, nc1):
+            if not (or0 + 1 <= r <= or1 - 1 and oc0 + 1 <= c <= oc1 - 1):
