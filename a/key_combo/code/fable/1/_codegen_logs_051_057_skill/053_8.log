    random.shuffle(anchors)
    candidates = [(r, c, r + BLOCK_SIZE - 1, c + BLOCK_SIZE - 1) for r, c in anchors]

    def search(
        start: int,
        chosen: list[tuple[int, int, int, int]],
        edge_count: int,
    ) -> list[tuple[int, int, int, int]] | None:
        if len(chosen) == n:
            return chosen
