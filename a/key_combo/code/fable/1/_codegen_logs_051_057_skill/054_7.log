+GREEN = 3
+MAX_GENERATION_ATTEMPTS = 400
+BG_CHOICES = [0, 1, 4, 5, 6, 7, 8, 9]
+PITCH_CHOICES = [2, 3, 4]
+TRACK_COUNT_RANGE = (2, 4)
+SLOT_COUNT_RANGE = (4, 6)
+STEP_COUNT_MAX = 6
