+def _frame_coords(h: int, w: int) -> np.ndarray:
+    key = (int(h), int(w))
+    if key not in FRAME_CACHE:
+        coords = []
+        for c in range(w):
+            coords.append((0, c))
+            coords.append((h - 1, c))
+        for r in range(1, h - 1):
+            coords.append((r, 0))
+            coords.append((r, w - 1))
+        FRAME_CACHE[key] = np.array(coords, dtype=int)
+    return FRAME_CACHE[key]
