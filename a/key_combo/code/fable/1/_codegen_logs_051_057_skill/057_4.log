+        _interval_overlap(
+            rect_specs[i]["c"],
+            rect_specs[i]["c"] + rect_specs[i]["w"] - 1,
+            rect_specs[j]["c"],
+            rect_specs[j]["c"] + rect_specs[j]["w"] - 1,
+        )
