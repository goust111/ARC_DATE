+    assert np.all(patch[frame_mask] == color), "frame border must be monochromatic"
+    assert np.all(patch[~frame_mask] == bg), "rectangle interior must be hollow"
+
+    return {
+        "r": r0,
+        "c": c0,
+        "h": h,
+        "w": w,
+        "color": color,
+        "area": h * w,
+        "coords": _frame_coords(h, w),
