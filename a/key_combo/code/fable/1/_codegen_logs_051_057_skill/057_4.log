+    rng.shuffle(row_order)
+    if row_order[-1] == 0:
+        return None
+    cursor = 0
+    for idx in row_order:
+        initial_rows[idx] = cursor
+        cursor += chain_dims[idx][0] + 1
+    if cursor >= final_rows[-1]:
+        return None
+
+    rect_specs = []
+    colors = rng.sample(FRAME_PALETTE, len(all_dims))
