+def _independent_dim(rng: random.Random, forbidden_areas: set[int]) -> tuple[int, int]:
+    candidates = []
+    for h in range(3, 6):
+        for w in range(3, 7):
+            if h * w not in forbidden_areas:
+                candidates.append((h, w))
