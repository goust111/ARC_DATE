+
+def _frame_ok(frame: dict, shape: tuple[int, int], frames: list[dict]) -> bool:
+    r0, c0, r1, c1 = frame["bbox"]
+    h, w = map(int, shape)
+    if not (2 <= r0 < r1 < h - 2 and 1 <= c0 < c1 < w - 1):
+        return False
+    for other in frames:
+        if not _boxes_separated(frame["bbox"], other["bbox"]):
