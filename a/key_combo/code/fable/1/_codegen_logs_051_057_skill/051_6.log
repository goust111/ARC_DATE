+    wall_sets = {id(frame): _wall_cells(frame) for frame in scene["frames"]}
+    for emitter in scene["emitters"]:
+        color = int(emitter["color"])
+        r, c = emitter["pos"]
+        dr, dc = emitter["dir"]
+        rr = int(r + dr)
+        cc = int(c + dc)
+        while _in_bounds(out.shape, rr, cc):
+            coord = (int(rr), int(cc))
+            if any(coord in walls for walls in wall_sets.values()):
