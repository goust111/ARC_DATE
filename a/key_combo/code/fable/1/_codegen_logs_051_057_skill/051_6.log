+
+def _rotate_grid_pair(inp: np.ndarray, out: np.ndarray, turns: int) -> tuple[np.ndarray, np.ndarray]:
+    t = int(turns) % 4
+    return np.rot90(inp, k=t), np.rot90(out, k=t)
