+ROTATION_SIDE = {
+    "top": {0: "top", 1: "right", 2: "bottom", 3: "left"},
+    "right": {0: "right", 1: "bottom", 2: "left", 3: "top"},
+    "bottom": {0: "bottom", 1: "left", 2: "top", 3: "right"},
+    "left": {0: "left", 1: "top", 2: "right", 3: "bottom"},
