+    def flood_fill(grid: np.ndarray, r: int, c: int, color: int, *, connectivity: int = 4) -> None:
+        g = np.asarray(grid)
+        h, w = map(int, g.shape)
+        r0 = int(r)
+        c0 = int(c)
+        if not (0 <= r0 < h and 0 <= c0 < w):
+            return
+        old = int(g[r0, c0])
+        new = int(color)
+        if old == new:
+            return
+        stack: list[tuple[int, int]] = [(r0, c0)]
+        while stack:
+            rr, cc = stack.pop()
+            if not (0 <= rr < h and 0 <= cc < w):
+                continue
+            if int(g[rr, cc]) != old:
+                continue
+            g[rr, cc] = new
+            stack.append((rr - 1, cc))
+            stack.append((rr + 1, cc))
+            stack.append((rr, cc - 1))
+            stack.append((rr, cc + 1))
+
+    def find_components(
+        grid: np.ndarray,
+        *,
+        bg: int | None = None,
+        connectivity: int = 4,
+        monochromatic: bool = True,
+        colors: tuple[int, ...] | list[int] | None = None,
+        min_area: int = 1,
+        return_format: str = "dict",
+    ) -> list[dict]:
+        g = np.asarray(grid, dtype=int)
+        if bg is None:
+            bg = get_bg(g)
+        h, w = map(int, g.shape)
+        allowed = None if colors is None else {int(v) for v in colors}
+        seen = np.zeros((h, w), dtype=bool)
+        out: list[dict] = []
+        for r in range(h):
+            for c in range(w):
+                if seen[r, c]:
+                    continue
+                color = int(g[r, c])
+                if color == int(bg):
