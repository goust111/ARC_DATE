+def _rotate_pos(pos: tuple[int, int], shape: tuple[int, int], turns: int) -> tuple[int, int]:
+    r, c = map(int, pos)
+    h, w = map(int, shape)
+    t = int(turns) % 4
+    if t == 0:
+        return r, c
+    if t == 1:
+        return c, h - 1 - r
+    if t == 2:
+        return h - 1 - r, w - 1 - c
+    return w - 1 - c, r
