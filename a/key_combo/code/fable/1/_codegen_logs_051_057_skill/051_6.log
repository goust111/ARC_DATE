+    return out
+
+
+def _line_frames(scene: dict, emitter: dict) -> list[tuple[int, dict]]:
+    er, ec = emitter["pos"]
+    dr, dc = emitter["dir"]
+    out: list[tuple[int, dict]] = []
+    for frame in scene["frames"]:
+        r0, c0, r1, c1 = frame["bbox"]
