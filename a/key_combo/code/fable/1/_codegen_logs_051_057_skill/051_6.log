+    h, w = map(int, shape)
+    if row_lo > row_hi:
+        return None
+    dims: list[tuple[int, int]] = []
+    for fh in range(FRAME_MIN_H, FRAME_MAX_H + 1):
+        for fw in range(FRAME_MIN_W, FRAME_MAX_W + 1):
+            dims.append((fh, fw))
+    random.shuffle(dims)
+    for fh, fw in dims:
