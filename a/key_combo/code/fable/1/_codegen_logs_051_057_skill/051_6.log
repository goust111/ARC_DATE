+
+def _column_choices(width: int) -> list[int] | None:
+    choices = list(range(3, width - 3))
+    random.shuffle(choices)
+    picked: list[int] = []
+    for col in choices:
+        if all(abs(col - other) >= MIN_COL_GAP for other in picked):
