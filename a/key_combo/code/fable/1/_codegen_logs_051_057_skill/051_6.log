+        r0 = int(r)
+        c0 = int(c)
+        if not (0 <= r0 < h and 0 <= c0 < w):
+            return
+        old = int(g[r0, c0])
+        new = int(color)
+        if old == new:
+            return
+        stack: list[tuple[int, int]] = [(r0, c0)]
+        while stack:
+            rr, cc = stack.pop()
+            if not (0 <= rr < h and 0 <= cc < w):
+                continue
+            if int(g[rr, cc]) != old:
+                continue
+            g[rr, cc] = new
+            stack.append((rr - 1, cc))
+            stack.append((rr + 1, cc))
+            stack.append((rr, cc - 1))
+            stack.append((rr, cc + 1))
