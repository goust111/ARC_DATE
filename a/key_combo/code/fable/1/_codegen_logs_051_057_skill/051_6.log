+FRAME_MAX_H = 6
+FRAME_MIN_W = 4
+FRAME_MAX_W = 5
+FRAME_GAP_MARGIN = 1
+BOX_MARGIN = 1
+EMITTER_COUNT = 4
+MIN_COL_GAP = 6
+MAX_GENERATION_ATTEMPTS = 500
+
+SIDE_TO_DIR = {
+    "top": (1, 0),
+    "bottom": (-1, 0),
+    "left": (0, 1),
+    "right": (0, -1),
+}
