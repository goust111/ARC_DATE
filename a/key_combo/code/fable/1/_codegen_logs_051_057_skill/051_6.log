+    def get_bg(grid: np.ndarray) -> int:
+        return int(Counter(map(int, np.asarray(grid).flat)).most_common(1)[0][0])
+
+    def bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+        arr = np.asarray(coords, dtype=int)
+        r0, c0 = arr.min(axis=0)
+        r1, c1 = arr.max(axis=0)
+        return int(r0), int(c0), int(r1), int(c1)
+
+    def flood_fill(grid: np.ndarray, r: int, c: int, color: int, *, connectivity: int = 4) -> None:
+        g = np.asarray(grid)
+        h, w = map(int, g.shape)
+        r0 = int(r)
+        c0 = int(c)
+        if not (0 <= r0 < h and 0 <= c0 < w):
+            return
+        old = int(g[r0, c0])
+        new = int(color)
+        if old == new:
+            return
+        stack: list[tuple[int, int]] = [(r0, c0)]
+        while stack:
+            rr, cc = stack.pop()
+            if not (0 <= rr < h and 0 <= cc < w):
+                continue
+            if int(g[rr, cc]) != old:
+                continue
+            g[rr, cc] = new
+            stack.append((rr - 1, cc))
+            stack.append((rr + 1, cc))
+            stack.append((rr, cc - 1))
+            stack.append((rr, cc + 1))
+
+    def find_components(
+        grid: np.ndarray,
+        *,
+        bg: int | None = None,
+        connectivity: int = 4,
+        monochromatic: bool = True,
+        colors: tuple[int, ...] | list[int] | None = None,
+        min_area: int = 1,
+        return_format: str = "dict",
+    ) -> list[dict]:
+        g = np.asarray(grid, dtype=int)
+        if bg is None:
+            bg = get_bg(g)
+        h, w = map(int, g.shape)
+        allowed = None if colors is None else {int(v) for v in colors}
+        seen = np.zeros((h, w), dtype=bool)
+        out: list[dict] = []
+        for r in range(h):
+            for c in range(w):
+                if seen[r, c]:
+                    continue
+                color = int(g[r, c])
+                if color == int(bg):
+                    seen[r, c] = True
+                    continue
+                if allowed is not None and color not in allowed:
+                    continue
+                queue: deque[tuple[int, int]] = deque([(r, c)])
+                seen[r, c] = True
+                coords: list[tuple[int, int]] = []
+                while queue:
+                    rr, cc = queue.popleft()
+                    if allowed is not None and int(g[rr, cc]) not in allowed:
+                        continue
+                    if monochromatic and int(g[rr, cc]) != color:
+                        continue
+                    if not monochromatic and int(g[rr, cc]) == int(bg):
+                        continue
+                    coords.append((rr, cc))
+                    for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                        if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc]:
+                            val = int(g[nr, nc])
+                            if monochromatic:
+                                if val == color:
+                                    seen[nr, nc] = True
+                                    queue.append((nr, nc))
+                            else:
+                                if val != int(bg) and (allowed is None or val in allowed):
+                                    seen[nr, nc] = True
+                                    queue.append((nr, nc))
+                if len(coords) >= int(min_area):
+                    arr = np.array(coords, dtype=int)
