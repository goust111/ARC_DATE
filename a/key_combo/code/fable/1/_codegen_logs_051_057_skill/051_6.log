+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        scene = _make_scene()
+        if scene is not None:
+            return scene["input"]
+    raise RuntimeError("failed to generate a valid light-through-gap scene")

