+        "bg": bg,
+        "ground_color": ground_color,
+        "rod_color": rod_color,
+        "trigger": trigger,
+        "direction": direction,
+        "rods_lr": rods,
+        "ordered_rods": ordered,
+        "fall_row": h - 2,
+    }
+
+
