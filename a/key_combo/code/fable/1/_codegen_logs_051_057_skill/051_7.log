+_GEN_HEIGHT_VALUES = tuple(range(2, 10))
+_GEN_GAP_VALUES = tuple(range(2, 7))
+_GEN_MIN_RODS = 3
+_GEN_MAX_RODS = 5
+_GEN_MAX_ATTEMPTS = 400
+_GEN_MODE_CYCLE = ("stop", "full", "partial", "partial")
