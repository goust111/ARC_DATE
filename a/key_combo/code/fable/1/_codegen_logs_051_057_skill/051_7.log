+    assert trigger_coords.shape[0] == 1, "expected exactly one trigger pixel"
+    r0, c0, r1, c1 = bbox_coords(trigger_coords)
+    assert (r0, c0) == (r1, c1), "trigger must be a single pixel"
+    trigger = (int(r0), int(c0))
