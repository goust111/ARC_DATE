+
+    try:
+        _validate_generated_grid(grid, expected_fall_count, mode)
+    except AssertionError:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(_GEN_MAX_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
