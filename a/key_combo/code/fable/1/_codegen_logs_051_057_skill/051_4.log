+    return {
+        "bg": bg,
+        "separator_color": separator_color,
+        "input_color": input_color,
+        "result_color": result_color,
+        "P": p_panel,
+        "Q": q_panel,
+        "R": r_panel,
+        "A": a_panel,
+        "B": b_panel,
