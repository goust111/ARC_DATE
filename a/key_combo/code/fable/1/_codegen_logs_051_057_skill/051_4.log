+def _mask_from_panel(panel: np.ndarray, bg: int, active_color: int) -> np.ndarray:
+    colors = _panel_colors(panel)
+    assert colors.issubset({bg, active_color}), "panel contains an unexpected color"
+    return panel == active_color
