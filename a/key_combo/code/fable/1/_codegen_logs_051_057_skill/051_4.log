+    ("or", (0, 1, 1, 1)),
+    ("xor", (0, 1, 1, 0)),
+    ("xnor", (1, 0, 0, 1)),
+    ("nand", (1, 1, 1, 0)),
+    ("nor", (1, 0, 0, 0)),
+    ("left_and_not_right", (0, 0, 1, 0)),
+    ("not_left_and_right", (0, 1, 0, 0)),
+    ("left_implies_right", (1, 1, 0, 1)),
+    ("right_implies_left", (1, 0, 1, 1)),
+]
+TRUTH_POOL: list[tuple[str, tuple[int, int, int, int]]] = []
+
+SEP_WIDTH_TO_DEMO_WIDTHS = {
+    1: (3, 5, 7),
+    2: (4, 6),
+}
