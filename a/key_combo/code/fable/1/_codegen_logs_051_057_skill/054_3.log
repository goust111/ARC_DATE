+    left_missing, right_missing = missing
+    rendered = _render_instance(layers, left_missing, right_missing)
+    if rendered is None:
+        return None
+    inp, out = rendered
+    if not _validate_instance(inp, out, layers, left_missing, right_missing):
+        return None
+    return inp
