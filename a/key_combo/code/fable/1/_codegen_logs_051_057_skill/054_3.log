+    mask = np.zeros((total_side, total_side), dtype=bool)
+    outer_pad = int(sum(heights[idx + 1 :]))
+    if idx == 0:
+        side = int(h0)
+        mask[outer_pad : outer_pad + side, outer_pad : outer_pad + side] = True
