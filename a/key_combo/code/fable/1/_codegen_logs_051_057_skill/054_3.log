+    inp = np.full((rows, cols), bg, dtype=int)
+
+    left_r0 = random.randint(0, rows - clean_left.shape[0])
+    right_r0 = random.randint(0, rows - clean_right.shape[0])
+    left_c0 = left_margin
+    right_c0 = cols - right_margin - clean_right.shape[1]
