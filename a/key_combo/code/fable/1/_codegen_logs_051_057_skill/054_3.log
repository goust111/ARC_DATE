+
+def _paint_missing_left(stack: np.ndarray, bg: int, layers: list[tuple[int, int]], missing: set[int]) -> np.ndarray:
+    out = stack.copy()
+    total_h = int(sum(height for _color, height in layers))
+    consumed = 0
+    for idx, (_color, height) in enumerate(layers):
+        r1 = total_h - consumed
+        r0 = r1 - height
+        if idx in missing:
+            out[r0:r1, :] = bg
+        consumed += height
+    return out
