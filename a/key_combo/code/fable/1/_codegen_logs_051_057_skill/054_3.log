+def _paint_missing_right(square: np.ndarray, bg: int, layers: list[tuple[int, int]], missing: set[int]) -> np.ndarray:
+    out = square.copy()
+    for idx in missing:
+        out[_layer_mask(layers, idx)] = bg
+    return out
