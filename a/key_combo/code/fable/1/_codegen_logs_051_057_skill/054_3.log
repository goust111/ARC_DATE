+        if any(c != first for c in candidates[1:]):
+            memo[key] = 0
+            return 0
+
+        color, height = first
+        if height <= 0:
+            memo[key] = 0
+            return 0
+
+        next_i_l = i_l
+        next_rem_l = rem_l
+        if color_l is None:
+            if rem_l < height:
+                memo[key] = 0
+                return 0
+            next_rem_l = rem_l - height
+        else:
