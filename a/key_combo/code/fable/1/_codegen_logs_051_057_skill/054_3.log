+    out = g.copy()
+    out[lr0 : lr1 + 1, lc0 : lc1 + 1] = full_left
+    out[rr0 : rr1 + 1, rc0 : rc1 + 1] = full_right
+
+    meta = {
+        "bg": bg,
+        "layers": layers,
+        "left_groups": left_groups,
+        "right_groups": right_groups,
+        "repair_left": int(usage["repair_left"]),
+        "repair_right": int(usage["repair_right"]),
+        "regions": regions,
