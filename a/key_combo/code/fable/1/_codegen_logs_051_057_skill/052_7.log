            placements = []
            for r0 in _GEN_BODY_TOP_ROWS:
                r1 = r0 + h - 1
                if not (_GEN_BODY_BOTTOM_MIN <= r1 <= _GEN_BODY_BOTTOM_MAX):
                    continue
