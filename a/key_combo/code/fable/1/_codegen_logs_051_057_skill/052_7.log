+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+PALETTE = tuple(range(1, 10))
+NEIGHBORS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+GEN_RETRIES = 400
+
+
+def get_bg(grid: np.ndarray) -> int:
+    counts = np.bincount(np.asarray(grid, dtype=int).ravel())
+    return int(np.argmax(counts))
+
+
+def bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def crop_bbox(grid: np.ndarray, box: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = box
+    return np.asarray(grid[r0 : r1 + 1, c0 : c1 + 1], dtype=int).copy()
+
+
+def components_mask(mask: np.ndarray) -> list[np.ndarray]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[np.ndarray] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in NEIGHBORS4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            components.append(np.asarray(coords, dtype=int))
+    return components
+
+
+def _split_total(total: int, parts: int) -> list[int]:
+    if parts == 1:
+        return [total]
+    cuts = sorted(random.sample(range(total + parts - 1), parts - 1))
+    out: list[int] = []
+    prev = -1
+    for cut in cuts + [total + parts - 1]:
+        out.append(cut - prev - 1)
+        prev = cut
+    return out
+
+
+def _random_frontier(length: int, limit: int) -> list[int]:
+    cut = random.randint(1, limit - 1)
+    frontier: list[int] = []
+    for _ in range(length):
+        cut = max(1, min(limit - 1, cut + random.choice((-1, 0, 1))))
+        frontier.append(cut)
+    if random.random() < 0.5:
+        frontier.reverse()
+    return frontier
+
+
+def _make_template(size: int) -> np.ndarray:
+    rr, cc = np.indices((size, size))
+
+    for _ in range(200):
