+def _rotation_to_standard(crop: np.ndarray, anchor_color: int) -> int:
+    h, w = crop.shape
+    assert h == w, "each copy must be square"
+    corners = [
+        ((0, 0), 0),
+        ((0, w - 1), 1),
+        ((h - 1, w - 1), 2),
+        ((h - 1, 0), 3),
+    ]
