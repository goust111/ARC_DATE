+    pos = row_gaps[0]
+    for idx in range(rows):
+        row_starts.append(pos)
+        pos += size + row_gaps[idx + 1]
+
+    col_starts: list[int] = []
+    pos = col_gaps[0]
+    for idx in range(cols):
