    if len(comps) != 1 or comps[0]["area"] != target_count:
        return False

    expected = np.full_like(grid, _GEN_BG)
    expected[grid == _GEN_BODY_COLOR] = target_color
    if not np.array_equal(main(grid), expected):
        return False
    return True

