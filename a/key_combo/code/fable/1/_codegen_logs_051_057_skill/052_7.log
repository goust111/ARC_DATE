+def _majority_vote(crops: list[np.ndarray]) -> np.ndarray:
+    stack = np.stack(crops, axis=0)
+    n, h, w = stack.shape
+    out = np.zeros((h, w), dtype=int)
+    max_color = max(10, int(stack.max()) + 1)
