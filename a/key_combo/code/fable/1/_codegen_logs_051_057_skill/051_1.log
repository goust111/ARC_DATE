+    area = _bbox_area_cells(bbox)
+    padded = _expand_cells(area, shape, radius=1) | _expand_cells(set(ray), shape, radius=1)
+    return {
+        "bbox": bbox,
+        "gap": gap,
+        "side": side,
+        "out_step": out_step,
+        "frame_cells": frame_cells,
+        "ray": ray,
+        "blocked": padded,
