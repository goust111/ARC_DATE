+def _record_from_spec(spec: dict, shape: tuple[int, int], origin: tuple[int, int], offset: int) -> dict:
+    height, width = shape
+    r0, c0 = origin
+    h = int(spec["h"])
+    w = int(spec["w"])
+    bbox = (r0, c0, r0 + h - 1, c0 + w - 1)
+
+    if spec["side"] == "top":
+        gap = (r0, c0 + offset)
+    elif spec["side"] == "bottom":
+        gap = (r0 + h - 1, c0 + offset)
+    elif spec["side"] == "left":
