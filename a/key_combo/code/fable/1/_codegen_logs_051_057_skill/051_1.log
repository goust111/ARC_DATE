+                if any(blocked[r, c] for r, c in record["blocked"]):
+                    continue
+                found = record
+                break
+            if found is not None:
+                break
+
+        if found is None:
+            return None
+
+        for r, c in found["blocked"]:
+            blocked[r, c] = True
