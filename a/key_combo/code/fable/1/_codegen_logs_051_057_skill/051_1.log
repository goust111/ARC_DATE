+        w = int(spec["w"])
+        side = str(spec["side"])
+        ray_len = int(spec["ray_len"])
+
+        if side == "top":
+            starts = [(ray_len, c0) for c0 in range(width - w + 1)]
+            offsets = list(range(1, w - 1))
+        elif side == "bottom":
