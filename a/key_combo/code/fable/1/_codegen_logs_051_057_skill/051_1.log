+
+
+def _ray_cells(
+    shape: tuple[int, int],
+    gap: tuple[int, int],
+    step: tuple[int, int],
+) -> list[tuple[int, int]]:
+    height, width = shape
+    dr, dc = step
+    r = gap[0] + dr
+    c = gap[1] + dc
+    out = []
+    while 0 <= r < height and 0 <= c < width:
+        out.append((r, c))
+        r += dr
+        c += dc
+    return out
+
+
+def _gap_side_and_step(
+    bbox: tuple[int, int, int, int],
+    gap: tuple[int, int],
+) -> tuple[str, tuple[int, int]]:
