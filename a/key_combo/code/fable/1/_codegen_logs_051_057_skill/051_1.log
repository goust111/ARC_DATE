    candidates = _gen_candidate_specs(height, width)
    frames = _gen_select_frames(candidates, frame_count)
    if frames is None:
        return None

    inp = np.full((height, width), bg, dtype=int)
    expected = inp.copy()
    for frame in frames:
        r0, c0, r1, c1 = frame["bbox"]
