+def _bbox_area_cells(bbox: tuple[int, int, int, int]) -> set[tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    return {
+        (r, c)
+        for r in range(r0, r1 + 1)
+        for c in range(c0, c1 + 1)
+    }
+
+
+def _expand_cells(
+    cells: set[tuple[int, int]],
+    shape: tuple[int, int],
+    radius: int = 1,
+) -> set[tuple[int, int]]:
+    out: set[tuple[int, int]] = set()
+    height, width = shape
+    for r, c in cells:
+        for dr in range(-radius, radius + 1):
+            for dc in range(-radius, radius + 1):
+                rr = r + dr
+                cc = c + dc
+                if 0 <= rr < height and 0 <= cc < width:
+                    out.add((rr, cc))
+    return out
+
+
+def _ray_cells(
+    shape: tuple[int, int],
+    gap: tuple[int, int],
+    step: tuple[int, int],
+) -> list[tuple[int, int]]:
+    height, width = shape
+    dr, dc = step
+    r = gap[0] + dr
+    c = gap[1] + dc
+    out = []
+    while 0 <= r < height and 0 <= c < width:
+        out.append((r, c))
+        r += dr
+        c += dc
+    return out
+
+
+def _gap_side_and_step(
+    bbox: tuple[int, int, int, int],
+    gap: tuple[int, int],
+) -> tuple[str, tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    gr, gc = gap
+    if gr == r0 and c0 < gc < c1:
+        return "top", OUT_STEPS["top"]
+    if gr == r1 and c0 < gc < c1:
+        return "bottom", OUT_STEPS["bottom"]
+    if gc == c0 and r0 < gr < r1:
+        return "left", OUT_STEPS["left"]
+    if gc == c1 and r0 < gr < r1:
+        return "right", OUT_STEPS["right"]
+    raise AssertionError("gap must be a non-corner border cell")
