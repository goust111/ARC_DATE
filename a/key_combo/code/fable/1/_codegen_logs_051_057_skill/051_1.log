+from arc_utils import Color, find_components, get_bg, in_bounds, neighbors4
+
+
+SIDES = ("top", "bottom", "left", "right")
+OUT_STEPS = {
+    "top": (-1, 0),
+    "bottom": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+
+FRAME_SIZE_RANGE = (5, 8)
+RAY_LEN_RANGE = (2, 5)
+DOT_COUNT_RANGE = (2, 5)
+GRID_SIDE_MIN = 14
+MAX_ATTEMPTS = 400
+PLACEMENT_TRIES = 120
+DOT_TRIES = 160
+FRAME_COUNT_CHOICES = [1, 2, 3, 4]
+FRAME_COUNT_WEIGHTS = [1, 3, 4, 2]
