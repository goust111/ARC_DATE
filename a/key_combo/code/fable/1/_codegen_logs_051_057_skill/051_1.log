    rows = TWO_GROUP_ROWS
    cols = _gen_randint_inclusive(*TWO_GROUP_COLS_RANGE)
    choices = []
    for w_top in RECT_WIDTHS:
        for w_bottom in RECT_WIDTHS:
            if w_top > cols or w_bottom > cols:
