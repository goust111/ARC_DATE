+        dots = []
+        distances = _bfs_distances(g.shape, frame["bbox"], frame["gap"])
+        expected_reachable = (r1 - r0 - 1) * (c1 - c0 - 1) + 1
+        assert len(distances) == expected_reachable, "frame interior must be open to the gap"
