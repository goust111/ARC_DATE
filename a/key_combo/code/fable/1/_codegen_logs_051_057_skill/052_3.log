+            cell = int(out[nr, nc])
+            if cell == bg:
+                stop = (nr, nc)
+                continue
+            if cell == Color.GREY:
+                result = "grey"
+                break
+            if (nr, nc) in frame_cells:
+                result = "frame"
+                break
+            raise AssertionError("free pixels should not block each other")
