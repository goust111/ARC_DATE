+
+def _lane_cell(
+    orientation: str,
+    side: str,
+    boundary: int,
+    orth: int,
+    distance: int,
+) -> tuple[int, int]:
+    if orientation == "vertical":
+        if side == "left":
+            return orth, boundary - distance
+        return orth, boundary + distance
+    if side == "top":
+        return boundary - distance, orth
+    return boundary + distance, orth
+
+
+def _paint_frame(
+    grid: np.ndarray,
+    orientation: str,
+    side: str,
+    boundary: int,
+    orth: int,
+    center_distance: int,
+    captive_color: int,
+) -> tuple[int, int, int, int, int, int]:
+    cr, cc = _lane_cell(orientation, side, boundary, orth, center_distance)
+    coords = []
+    for dr in (-1, 0, 1):
