+    BLUE = 1
+    RED = 2
+    GREEN = 3
+    YELLOW = 4
+    GREY = 5
+    PINK = 6
+    ORANGE = 7
+    TEAL = 8
+    MAROON = 9
+
+
+DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+PIXEL_COLORS = [
+    Color.RED,
+    Color.GREEN,
+    Color.YELLOW,
+    Color.PINK,
+    Color.ORANGE,
+    Color.TEAL,
+    Color.MAROON,
