+
+def _paint_free_pixel(
+    grid: np.ndarray,
+    orientation: str,
+    side: str,
+    boundary: int,
+    orth: int,
+    distance: int,
+    color: int,
+) -> tuple[int, int]:
+    rr, cc = _lane_cell(orientation, side, boundary, orth, distance)
+    assert in_bounds(grid.shape, rr, cc)
+    assert int(grid[rr, cc]) == Color.BLACK
+    grid[rr, cc] = int(color)
+    return rr, cc
