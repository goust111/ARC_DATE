+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+class Color:
+    BLACK = 0
+    BLUE = 1
+    RED = 2
+    GREEN = 3
+    YELLOW = 4
+    GREY = 5
+    PINK = 6
+    ORANGE = 7
+    TEAL = 8
+    MAROON = 9
+
+
+DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+PIXEL_COLORS = [
+    Color.RED,
+    Color.GREEN,
+    Color.YELLOW,
+    Color.PINK,
+    Color.ORANGE,
+    Color.TEAL,
+    Color.MAROON,
+]
+FRAME_COLOR = Color.BLUE
+GEN_ATTEMPTS = 500
+
+
+def get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = map(int, shape)
+    return 0 <= int(r) < h and 0 <= int(c) < w
+
+
+def neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def bbox_coords(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def monochromatic_components(grid: np.ndarray, color: int) -> list[list[tuple[int, int]]]:
+    mask = grid == int(color)
+    seen = np.zeros(grid.shape, dtype=bool)
+    out: list[list[tuple[int, int]]] = []
+    for r, c in np.argwhere(mask):
+        rr = int(r)
+        cc = int(c)
+        if seen[rr, cc]:
+            continue
+        q = deque([(rr, cc)])
+        seen[rr, cc] = True
+        comp: list[tuple[int, int]] = []
+        while q:
+            cr, cd = q.popleft()
+            comp.append((cr, cd))
+            for nr, nc in neighbors4(cr, cd):
+                if in_bounds(grid.shape, nr, nc) and not seen[nr, nc] and mask[nr, nc]:
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+        out.append(comp)
+    return out
+
+
+def _grey_bar(grid: np.ndarray) -> tuple[int, int, int, int]:
+    comps = monochromatic_components(grid, Color.GREY)
+    assert len(comps) == 1, "expected one grey magnet"
+    comp = comps[0]
+    box = bbox_coords(comp)
+    r0, c0, r1, c1 = box
+    expected_area = (r1 - r0 + 1) * (c1 - c0 + 1)
+    assert len(comp) == expected_area, "grey magnet must be a solid rectangle"
+    return box
+
+
+def _frame_from_component(
+    grid: np.ndarray, bg: int, comp: list[tuple[int, int]]
+) -> dict | None:
+    if len(comp) < 8:
+        return None
+    r0, c0, r1, c1 = bbox_coords(comp)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h != w or h < 3:
+        return None
+
+    color = int(grid[comp[0]])
+    expected: set[tuple[int, int]] = set()
+    for r in range(r0, r1 + 1):
+        expected.add((r, c0))
+        expected.add((r, c1))
+    for c in range(c0, c1 + 1):
+        expected.add((r0, c))
+        expected.add((r1, c))
+    comp_set = set(comp)
+    if comp_set != expected:
+        return None
+
+    interior_pixels: list[tuple[int, int]] = []
+    for r in range(r0 + 1, r1):
+        for c in range(c0 + 1, c1):
+            value = int(grid[r, c])
+            if value == color:
+                return None
+            if value != bg:
+                interior_pixels.append((r, c))
