    yellow_specs = [
        ((r0 - 1, cm), (-1, 1), "h", "asc"),
        ((rm, c0 - 1), (-1, -1), "v", "desc"),
        ((r1 + 1, cm), (1, -1), "h", "desc"),
        ((rm, c1 + 1), (1, 1), "v", "asc"),
    ]
