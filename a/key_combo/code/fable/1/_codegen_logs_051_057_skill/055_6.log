+    reserved_paths: set[Coord] = set()
+
+    order = sorted(range(n_sources), key=lambda i: (-hit_counts[i], random.random()))
+    for i in order:
+        chain = _search_chain(
+            shape,
+            (rows[i], 0),
+            1,
+            hit_counts[i],
