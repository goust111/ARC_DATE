+            blockers.add(cell)
+
+    for cell in _extra_decoy_candidates((h, w), reserved_paths, blockers):
+        if random.random() < 0.18 and not _too_close(cell, blockers):
+            blockers.add(cell)
+        if len(blockers) >= sum(hit_counts) + 3:
+            break
