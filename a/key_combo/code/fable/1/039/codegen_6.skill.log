+    rr = np.arange(shape[0], dtype=int)[:, None]
+    cc = np.arange(shape[1], dtype=int)[None, :]
+    distance_layers = [
+        np.maximum(np.abs(rr - int(r)), np.abs(cc - int(c)))
+        for r, c in anchors
+    ]
+    return np.minimum.reduce(distance_layers)
