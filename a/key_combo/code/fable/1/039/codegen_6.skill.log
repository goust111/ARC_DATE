+    candidates: list[tuple[int, int, int, tuple[int, ...]]] = []
+    for row in (0, height - 1):
+        col = 0
+        while col < width:
+            color = int(grid[row, col])
+            if color == bg or counts[color] != 1:
+                col += 1
+                continue
+            start = col
