+    out[legend_row, legend_start : legend_start + len(legend_colors)] = np.array(legend_colors, dtype=int)
+    return out
+
+
+def _render_independent_stamp(
+    shape: tuple[int, int],
+    bg: int,
+    anchor_color: int,
+    anchors: np.ndarray,
+    legend_row: int,
+    legend_start: int,
