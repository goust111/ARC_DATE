+def _crop_patch(patch: np.ndarray) -> np.ndarray:
+    coords = np.argwhere(patch != 0)
+    r0, c0, r1, c1 = bbox_coords(coords)
+    return patch[r0 : r1 + 1, c0 : c1 + 1].copy()
