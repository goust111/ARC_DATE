+
+def _noise_patch(rng: np.random.Generator, colors: list[int], bg: int) -> np.ndarray:
+    kind = int(rng.integers(0, 3))
+    if kind == 0:
+        patch = np.array([[int(rng.choice(colors))]], dtype=int)
+    elif kind == 1:
