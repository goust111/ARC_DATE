+
+from arc_utils import bbox_coords, components_mask, crop_bbox, neighbors4, paste, random_free_location
+
+
+DIR4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+GEN_RETRIES = 400
+GRID_MIN = 24
+GRID_MAX = 28
+PALETTE = tuple(range(10))
