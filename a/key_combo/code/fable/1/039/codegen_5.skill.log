+    paste(layout, footprint, r0, c0, transparent=None)
+    paste(grid, patch, r0, c0, transparent=None)
+    return bay_area
+
+
+def _multicolor_blob_patch(rng: np.random.Generator, colors: list[int], bg: int) -> np.ndarray | None:
