+def _touches_border(coords: np.ndarray, shape: tuple[int, int]) -> bool:
+    h, w = map(int, shape)
+    return bool(
+        np.any(
+            (coords[:, 0] == 0)
+            | (coords[:, 0] == h - 1)
+            | (coords[:, 1] == 0)
+            | (coords[:, 1] == w - 1)
+        )
+    )
+
+
+def _normalize_coords(coords: np.ndarray) -> tuple[tuple[int, int], ...]:
+    r0, c0 = coords.min(axis=0)
+    return tuple(sorted((int(r - r0), int(c - c0)) for r, c in coords))
