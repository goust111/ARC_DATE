+        r, c = stack.pop()
+        for nr, nc in neighbors4(r, c):
+            if not (0 <= nr < h and 0 <= nc < w):
+                continue
+            if (nr, nc) in seen or int(grid[nr, nc]) != int(color):
+                continue
+            seen.add((nr, nc))
+            stack.append((nr, nc))
+    return boundary <= seen
