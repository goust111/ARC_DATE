+def _build_host_patch(mask: np.ndarray, color: int, bg: int, rng: np.random.Generator) -> tuple[np.ndarray, np.ndarray]:
+    h, w = mask.shape
+    top = int(rng.integers(2, 5))
+    bottom = int(rng.integers(2, 5))
