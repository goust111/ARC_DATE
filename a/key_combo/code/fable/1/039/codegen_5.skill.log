+
+def _shape_mask(coords: np.ndarray, grid_shape: tuple[int, int]) -> np.ndarray:
+    mask = np.zeros(grid_shape, dtype=bool)
+    mask[coords[:, 0], coords[:, 1]] = True
+    return mask
+
