+                "bbox": tuple(map(int, comp["bbox"])),
+                "area": int(comp["area"]),
+                "color": int(comp["color"]),
+            }
+        )
+    out.sort(key=lambda comp: (comp["bbox"][0], comp["bbox"][1], comp["bbox"][2], comp["bbox"][3], comp["color"]))
+    return out
