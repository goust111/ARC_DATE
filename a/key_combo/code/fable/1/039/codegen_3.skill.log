+def _random_connected_patch(
+    color: int,
+    rng: random.Random,
+    *,
+    h_range: tuple[int, int],
+    w_range: tuple[int, int],
+    fill_range: tuple[float, float],
+) -> np.ndarray:
+    height = rng.randint(*h_range)
+    width = rng.randint(*w_range)
+    total = height * width
+    min_fill = max(3, int(np.ceil(total * fill_range[0])))
