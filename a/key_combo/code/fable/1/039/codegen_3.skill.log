+def _frame_patch(height: int, width: int, thickness: int, color: int) -> np.ndarray:
+    patch = np.zeros((height, width), dtype=int)
+    patch[:thickness, :] = int(color)
+    patch[-thickness:, :] = int(color)
+    patch[:, :thickness] = int(color)
+    patch[:, -thickness:] = int(color)
+    return patch
