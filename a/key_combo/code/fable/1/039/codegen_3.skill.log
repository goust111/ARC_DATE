+    height, width = map(int, shape)
+    exterior = np.zeros(shape, dtype=bool)
+    queue: deque[tuple[int, int]] = deque()
+
+    def push(r: int, c: int) -> None:
+        if free[r, c] and not exterior[r, c]:
+            exterior[r, c] = True
+            queue.append((r, c))
+
+    for r in range(height):
+        push(r, 0)
+        push(r, width - 1)
+    for c in range(width):
+        push(0, c)
+        push(height - 1, c)
