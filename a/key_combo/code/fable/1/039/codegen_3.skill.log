+    height = rng.randint(*h_range)
+    width = rng.randint(*w_range)
+    total = height * width
+    min_fill = max(3, int(np.ceil(total * fill_range[0])))
+    max_fill = min(total, int(np.floor(total * fill_range[1])))
+    target = rng.randint(min_fill, max_fill)
