+    cells = {(rng.randrange(height), rng.randrange(width))}
+    while len(cells) < target:
+        frontier = set()
+        for r, c in cells:
+            for dr, dc in NEIGHBORS4:
+                nr = r + dr
+                nc = c + dc
+                if 0 <= nr < height and 0 <= nc < width and (nr, nc) not in cells:
+                    frontier.add((nr, nc))
+        cells.add(rng.choice(tuple(frontier)))
