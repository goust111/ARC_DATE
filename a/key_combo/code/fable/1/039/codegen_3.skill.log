+
+    independent_count = rng.randint(1, 3)
+    independent_patches = []
+    for _ in range(independent_count):
+        reuse_color = rng.choice(deep_colors + short_colors)
+        independent_patches.append(_build_independent_patch(reuse_color, rng))
