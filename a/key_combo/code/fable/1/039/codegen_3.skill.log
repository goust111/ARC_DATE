+    while queue:
+        r, c = queue.popleft()
+        for dr, dc in NEIGHBORS4:
+            nr = r + dr
+            nc = c + dc
+            if 0 <= nr < height and 0 <= nc < width and free[nr, nc] and not exterior[nr, nc]:
