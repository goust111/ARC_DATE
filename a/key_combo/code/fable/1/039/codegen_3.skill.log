+    children = [[] for _ in range(count)]
+    for child_idx, parent_idx in enumerate(parents):
+        if parent_idx != -1:
+            children[parent_idx].append(child_idx)
+    assert all(len(kids) <= 1 for kids in children), "nesting must not branch"
