    c0 = int(rng.integers(V_COLUMN_PAD, GRID_SIZE - width))
    c1 = c0 + width - 1

    span_kind = int(rng.choice(V_SPAN_KINDS, p=V_SPAN_WEIGHTS))
    if span_kind == V_FULL_SPAN:
        return 0, c0, GRID_SIZE - 1, c1

