    max_h = min(H_MAX_HEIGHT, v_height - 2 * min_gap)
    if max_h < 1:
        return []
    h = int(rng.integers(1, max_h + 1))
    lo = vr0 + min_gap
    hi = vr1 - h + 1 - min_gap
    r0 = int(rng.integers(lo, hi + 1))
    return [(r0, r0 + h - 1)]


