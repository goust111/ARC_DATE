+) -> set[int]:
+    occupied = {(start + offset) % ring_len for offset in range(band_len)}
+    crossed: set[int] = set()
+    for corner in corners:
+        for delta in range(1, step + 1):
+            if (corner - delta) % ring_len in occupied:
+                crossed.add(int(corner))
+                break
+    return crossed
