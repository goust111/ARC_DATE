+_MAX_ATTEMPTS = 400
+_WIDTH_RANGE = (10, 22)
+_NONEMPTY_ROWS_RANGE = (3, 5)
+_BLANK_ROWS_RANGE = (1, 4)
+_RUN_COUNT_RANGE = (4, 8)
+_RUN_LEN_MAX = 5
+_ADVANCE_MIN_FIRST = 4
+_ADVANCE_MIN_OTHER = 2
+_ADVANCE_MAX = 8
+_OVERLAP_MIN = 2
+_OVERLAP_MAX = 5
