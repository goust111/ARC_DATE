    v_width = vc1 - vc0 + 1
    n_bands = 2 if rng.random() < H_SPLIT_PROB else 1
    h_bands = _gen_h_bands(rng, vr0, vr1, v_width, n_bands)
    if not h_bands:
        return False

    for hr0, hr1 in h_bands:
        h = hr1 - hr0 + 1

