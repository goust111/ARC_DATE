        pts = np.argwhere(g == color)
        if len(pts) "'!= 2:
            continue
        if not (np.all(pts[:,1] < sep) or np.all(pts[:,1] > sep)):
            continue
        comps = components_mask(g == color, connectivity=4)
        if len(comps) == 2 and all(len(comp) == 1 for comp in comps):
            marker_candidates.append(color)
    assert len(marker_candidates) == 1
    marker_color = marker_candidates[0]
    marker_pts = np.argwhere(g == marker_color)
    container_is_left = bool(np.all(marker_pts[:,1] < sep))
    left = g[:, :sep]
    right = g[:, sep+1:]
