135: def _gen_clear_mask(mask: np.ndarray) -> np.ndarray:
136:     height, width = map(int, mask.shape)
137:     padded = np.pad(mask, 1, mode="constant", constant_values=True)
138:     clear = np.ones_like(mask, dtype=bool)
139:     for dr in range(3):
140:         for dc in range(3):
141:             clear &= padded[dr : dr + height, dc : dc + width]
142:     return clear
