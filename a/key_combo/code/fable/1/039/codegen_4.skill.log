145: def _gen_vertical_rect(rng: np.random.Generator) -> tuple[int, int, int, int]:
146:     width = int(rng.integers(V_WIDTH_RANGE[0], V_WIDTH_RANGE[1] + 1))
147:     c0 = int(rng.integers(V_COLUMN_PAD, GRID_SIZE - width))
148:     c1 = c0 + width - 1
149: 
150:     span_kind = int(rng.choice(V_SPAN_KINDS, p=V_SPAN_WEIGHTS))
151:     if span_kind == V_FULL_SPAN:
152:         return 0, c0, GRID_SIZE - 1, c1
153: 
154:     height = int(rng.integers(V_PARTIAL_HEIGHT_RANGE[0], V_PARTIAL_HEIGHT_RANGE[1] + 1))
155:     if span_kind == V_TOP_SPAN:
156:         return 0, c0, height - 1, c1
157:     return GRID_SIZE - height, c0, GRID_SIZE - 1, c1
