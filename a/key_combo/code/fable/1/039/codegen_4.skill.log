162:     vr0: int,
163:     vr1: int,
164:     v_width: int,
165:     n_bands: int,
166: ) -> list[tuple[int, int]]:
167:     v_height = vr1 - vr0 + 1
168:     min_gap = (H_MIN_NEW_AREA + v_width - 1) // v_width
169:     mid_gap = max(min_gap, H_MIN_MID_GAP)
170:     if n_bands == 2 and v_height >= 2 * min_gap + mid_gap + 2:
171:         available = v_height - 2 * min_gap - mid_gap
172:         h0 = int(rng.integers(1, min(H_MAX_HEIGHT, available - 1) + 1))
173:         h1 = int(rng.integers(1, min(H_MAX_HEIGHT, available - h0) + 1))
174:         extra = v_height - h0 - h1 - 2 * min_gap - mid_gap
175:         gaps = np.array([min_gap, mid_gap, min_gap], dtype=int)
176:         if extra > 0:
177:             gaps += rng.multinomial(extra, [1 / 3, 1 / 3, 1 / 3])
178:         r0 = vr0 + int(gaps[0])
179:         r1 = r0 + h0 - 1
180:         r2 = r1 + 1 + int(gaps[1])
