def make_patch(coords, color, bg=0):
    h = int(coords[:,0].max()) + 1
    w = int(coords[:,1].max()) + 1
    patch = np.full((h,w), bg, dtype=int)
    patch[coords[:,0], coords[:,1]] = color
    return patch


def build_obstacle_from_profile(profile, H, color, bg):
    g = np.full((H, len(profile)), bg, dtype=int)
    for c, h in enumerate(profile):
        if h > 0:
            g[H-h:, c] = color
    return g


def gen_container_profile(H, W, rng):
    for _ in range(200):
        span = rng.randint(max(4, W//2), W)
        c0 = rng.randint(0, W - span)
        profile = [0]*W
        for c in range(c0, c0+span):
            profile[c] = 1
        n_risers = rng.randint(1, 3)
        for _ in range(n_risers):
            a = rng.randint(c0, c0+span-1)
            b = rng.randint(a+1, c0+span)
            extra = rng.randint(1, min(3, H-4))
            for c in range(a,b):
                profile[c] = min(H-3, profile[c] + extra)
        occupied = [h for h in profile if h > 0]
        if len(set(occupied)) < 2:
            continue
        return profile
    raise RuntimeError('profile')


def coords_to_grid(H,W, obstacle_mask, bodies, bg):
    g = np.full((H,W), bg, dtype=int)
    g[obstacle_mask] = 1  # temporary maybe overwritten by caller
    return g


def can_move(body_coords, others_mask, obstacle_mask, H):
    shifted = body_coords + np.array([1,0])
    if int(shifted[:,0].max()) >= H:
        return False
    if np.any(obstacle_mask[shifted[:,0], shifted[:,1]]):
        return False
    if np.any(others_mask[shifted[:,0], shifted[:,1]]):
        return False
    return True


def simulate_seq(H, W, obstacle_mask, bodies, order='forward'):
    cur = [dict(color=b['color'], coords=b['coords'].copy()) for b in bodies]
    while True:
        moved = False
        idxs = range(len(cur)) if order == 'forward' else range(len(cur)-1, -1, -1)
        for i in idxs:
            others = np.zeros((H,W), dtype=bool)
            for j,b in enumerate(cur):
                if i == j:
                    continue
                others[b['coords'][:,0], b['coords'][:,1]] = True
            if can_move(cur[i]['coords'], others, obstacle_mask, H):
                cur[i]['coords'] = cur[i]['coords'] + np.array([1,0])
                moved = True
        if not moved:
            break
    return cur


def simulate_sync(H,W, obstacle_mask, bodies):
    cur = [dict(color=b['color'], coords=b['coords'].copy()) for b in bodies]
    while True:
        movable = []
        occ = np.zeros((H,W), dtype=bool)
        for b in cur:
            occ[b['coords'][:,0], b['coords'][:,1]] = True
        for i,b in enumerate(cur):
            other = occ.copy()
            other[b['coords'][:,0], b['coords'][:,1]] = False
            if can_move(b['coords'], other, obstacle_mask, H):
                movable.append(i)
        if not movable:
            break
        for i in movable:
            cur[i]['coords'] = cur[i]['coords'] + np.array([1,0])
    return cur


def render(H,W,bg, obstacle_color, obstacle_mask, bodies):
    g = np.full((H,W), bg, dtype=int)
    g[obstacle_mask] = obstacle_color
    for b in bodies:
        g[b['coords'][:,0], b['coords'][:,1]] = b['color']
    return g


def drop_pixels(H,W,bg, obstacle_color, obstacle_mask, bodies):
    start = render(H,W,bg, obstacle_color, obstacle_mask, bodies)
    out = np.full((H,W), bg, dtype=int)
    out[obstacle_mask] = obstacle_color
    for c in range(W):
        obstacle_rows = np.flatnonzero(obstacle_mask[:,c]).tolist()
        bounds = [-1] + obstacle_rows + [H]
        for top, bottom in zip(bounds[:-1], bounds[1:]):
            free_rows = list(range(top+1, bottom))
            if not free_rows:
                continue
            colors = [int(start[r,c]) for r in free_rows if int(start[r,c]) not in (bg, obstacle_color)]
            for r,color in zip(reversed(free_rows), reversed(colors)):
                out[r,c] = color
    return out


def choose_marker_cells(half, forbidden, rng):
    H,W = half.shape
    candidates = []
    for r in range(H-1):
        for c in range(W):
            if forbidden[r,c]:
                continue
            if any(0 <= nr < H and 0 <= nc < W and forbidden[nr,nc] for nr,nc in ((r-1,c),(r+1,c),(r,c-1),(r,c+1))):
                continue
            candidates.append((r,c))
    rng.shuffle(candidates)
    for i,a in enumerate(candidates):
        for b in candidates[i+1:]:
            if abs(a[0]-b[0]) + abs(a[1]-b[1]) <= 1:
                continue
            return a,b
    return None


def try_place(shape, H, W, reserve, rng, prefer_varied=False, profile=None):
    coords = shape.copy()
    h = int(coords[:,0].max()) + 1
    w = int(coords[:,1].max()) + 1
    positions = []
    for r0 in range(0, H-h):
        for c0 in range(0, W-w+1):
            placed = coords + np.array([r0,c0])
            if np.any(reserve[placed[:,0], placed[:,1]]):
                continue
            if prefer_varied and profile is not None:
                heights = {profile[int(c)] for c in np.unique(placed[:,1])}
                if len(heights) < 2:
                    continue
            positions.append((r0,c0))
    rng.shuffle(positions)
    if not positions:
        return None
    r0,c0 = positions[0]
    return coords + np.array([r0,c0])


def main(grid):
    g = np.asarray(grid, dtype=int)
    bg = int(get_bg(g))
    H,W = map(int, g.shape)
    assert W % 2 == 1
    sep = W // 2
    sep_col = g[:, sep]
    assert np.all(sep_col == sep_col[0])
    sep_color = int(sep_col[0])
    left = g[:, :sep].copy()
    right = g[:, sep+1:].copy()

    colors = [int(c) for c in np.unique(g) if int(c) not in (bg, sep_color)]
    marker_candidates = []
    for color in colors:
        pts = np.argwhere(g == color)
        if len(pts) "'!= 2:
            continue
        side = np.all(pts[:,1] < sep) or np.all(pts[:,1] > sep)
        if side:
            marker_candidates.append(color)
    assert len(marker_candidates) == 1
    marker_color = marker_candidates[0]
    marker_pts = np.argwhere(g == marker_color)
    container_is_left = bool(np.all(marker_pts[:,1] < sep))

    def parse_half(half):
        half_colors = [int(c) for c in np.unique(half) if int(c) != bg]
        bottom_colors = [c for c in half_colors if np.any(half[-1,:] == c)]
        bottom_colors = [c for c in bottom_colors if c != marker_color]
        assert len(bottom_colors) == 1
        obstacle_color = bottom_colors[0]
        body_colors = [c for c in half_colors if c not in (obstacle_color, marker_color)]
        bodies = []
        for comp in find_components(half, bg=bg, connectivity=4, monochromatic=True, colors=body_colors):
            bodies.append({'"'color': int(comp['color']), 'coords': comp['coords'].copy()})
        obstacle_mask = half == obstacle_color
        return obstacle_color, obstacle_mask, bodies

    left_ob_color, left_ob_mask, left_bodies = parse_half(left)
    right_ob_color, right_ob_mask, right_bodies = parse_half(right)
    if container_is_left:
        obstacle_color, obstacle_mask, own_bodies, src_bodies = left_ob_color, left_ob_mask, left_bodies, right_bodies
    else:
        obstacle_color, obstacle_mask, own_bodies, src_bodies = right_ob_color, right_ob_mask, right_bodies, left_bodies
    all_bodies = [dict(color=b['color'], coords=b['coords'].copy()) for b in own_bodies + src_bodies]
    H2,W2 = obstacle_mask.shape
    settled = simulate_seq(H2,W2, obstacle_mask, all_bodies)
    return render(H2,W2,bg, obstacle_color, obstacle_mask, settled)


def gen_attempt():
    rng = random.Random()
    H = rng.randint(10, 15)
    W = rng.randint(8, 12)
