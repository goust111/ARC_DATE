        half_colors = [int(c) for c in np.unique(half) if int(c) != bg]
        bottom_colors = [c for c in half_colors if np.any(half[-1,:] == c) and c != marker_color]
        assert len(bottom_colors) == 1
        obstacle_color = bottom_colors[0]
        body_colors = [c for c in half_colors if c not in (obstacle_color, marker_color)]
        bodies = [
            {'"'color': int(comp['color']), 'coords': comp['coords'].copy()}
            for comp in find_components(half, bg=bg, connectivity=4, monochromatic=True, colors=body_colors)
        ]
        obstacle_mask = half == obstacle_color
        return obstacle_color, obstacle_mask, bodies
    left_data = parse_half(left)
    right_data = parse_half(right)
    if container_is_left:
        obstacle_color, obstacle_mask, own_bodies, src_bodies = left_data[0], left_data[1], left_data[2], right_data[2]
    else:
        obstacle_color, obstacle_mask, own_bodies, src_bodies = right_data[0], right_data[1], right_data[2], left_data[2]
    settled = simulate_seq(obstacle_mask.shape[0], obstacle_mask.shape[1], obstacle_mask, own_bodies + src_bodies)
    return render(obstacle_mask.shape[0], obstacle_mask.shape[1], bg, obstacle_color, obstacle_mask, settled)

