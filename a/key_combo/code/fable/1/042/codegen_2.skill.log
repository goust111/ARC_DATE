    return (30 - 1 - 4) // (frame_size - 1)


def _rotate_cw(local: tuple[int, int], inner_size: int) -> tuple[int, int]:
    r, c = local
    return c, inner_size - 1 - r


def _rotate_ccw(local: tuple[int, int], inner_size: int) -> tuple[int, int]:
    r, c = local
    return inner_size - 1 - c, r


def _find_frames(
