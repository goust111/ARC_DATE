+    non_bg = [int(x) for x in np.unique(g) if int(x) != bg]
+    assert len(non_bg) == 2, "expected one frame color and one seed color"
+
+    counts = Counter(map(int, g[g != bg].ravel()))
+    frame_color = max(non_bg, key=lambda color: counts[color])
