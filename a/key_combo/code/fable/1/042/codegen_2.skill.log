+                        "top_left": (r0, c0),
+                        "size": size,
+                        "inner_size": size - 2,
+                    }
+                )
+        if found:
+            by_size[size] = found
+
+    assert by_size, "expected at least one hollow square frame"
+    size = max(by_size, key=lambda s: (len(by_size[s]), s))
+    return by_size[size]
+
+
