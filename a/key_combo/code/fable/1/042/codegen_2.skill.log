    by_size: dict[int, list[dict[str, object]]] = {}

    for size in range(3, min(h, w) + 1):
        found: list[dict[str, object]] = []
        for r0 in range(h - size + 1):
            r1 = r0 + size - 1
            for c0 in range(w - size + 1):
                c1 = c0 + size - 1
