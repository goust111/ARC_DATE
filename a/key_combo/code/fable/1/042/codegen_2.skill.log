+                    trial = _normalize_cells(cells + [nxt])
+                    box_h, box_w = _coarse_bbox_dims(trial)
+                    if box_h <= limit and box_w <= limit:
+                        options.append(nxt)
+            if not options:
+                break
+            random.shuffle(options)
+            cells.append(options[0])
+            cell_set.add(options[0])
