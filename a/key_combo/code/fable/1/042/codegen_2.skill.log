+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+SEED_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+GEN_RETRY_LIMIT = 400
+_GEN_CALL_COUNT = 0
