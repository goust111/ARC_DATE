+    scene = _parse_scene(grid)
+    g = scene["grid"]
+    seed_color = int(scene["seed_color"])
+    frames = scene["frames"]
+    inner_size = int(scene["inner_size"])
+    root = int(scene["root"])
+    root_local = tuple(scene["root_local"])
+    graph = scene["graph"]
