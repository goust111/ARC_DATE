+def _coarse_bbox_dims(cells: list[tuple[int, int]]) -> tuple[int, int]:
+    rows = [r for r, _ in cells]
+    cols = [c for _, c in cells]
+    return max(rows) - min(rows) + 1, max(cols) - min(cols) + 1
