+    graph: list[list[int]] = [[] for _ in cells]
+    for index, (r, c) in enumerate(cells):
+        for dr, dc in DIR4:
+            neighbor = coord_to_index.get((r + dr, c + dc))
+            if neighbor is not None:
+                graph[index].append(neighbor)
