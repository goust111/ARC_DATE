    assert np.any(marker_mask), "expected colored marker pixels"
    marker_colors = set(map(int, np.unique(g[marker_mask])))
    assert marker_colors <= {Color.GREEN, Color.PINK, Color.ORANGE, Color.TEAL}

    H, W = g.shape
