            out_color = Color.ORANGE if pos in connectors else Color.BLUE
            in_color = Color.BLUE

        _gen_paint_slot(output, slot_r, slot_c, mask, out_color)
        _gen_paint_slot(input_grid, slot_r, slot_c, mask, in_color)
    return input_grid, output


