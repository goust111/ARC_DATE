+    elif variant == 1:
+        transformed = np.stack([r, -c], axis=1)
+    elif variant == 2:
+        transformed = np.stack([-r, c], axis=1)
+    elif variant == 3:
+        transformed = np.stack([-r, -c], axis=1)
+    elif variant == 4:
+        transformed = np.stack([c, r], axis=1)
+    elif variant == 5:
+        transformed = np.stack([c, -r], axis=1)
+    elif variant == 6:
