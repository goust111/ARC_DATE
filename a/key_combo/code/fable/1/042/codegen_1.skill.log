   9: def main(grid: np.ndarray) -> np.ndarray:
  10:     """
  11:     Replace the sparse scene with a square diagonal marker grid whose side length is the number of foreground objects.
  12: 
  13:     Input structure:
  14:     - The grid has one dominant background color and exactly one foreground color.
  15:     - The foreground pixels form one or more separated 4-connected objects.
  16: 
  17:     Rule:
  18:     - Count the 4-connected foreground objects.
  19:     - Return a square grid, filled with the background color, with side length equal to that count.
  20:     - Place the foreground color on the main diagonal from upper left to lower right.
  21: 
  22:     Key insight:
  23:     - The large foreground shapes are tokens to count; their detailed shapes and positions do not affect the output beyond the object count.
  24:     """
  25:     g = np.asarray(grid, dtype=int)
  26:     bg = int(get_bg(g))
  27:     fg_colors = colors_present(g, exclude={bg})
  28:     assert len(fg_colors) == 1, "expected exactly one foreground color"
  29:     fg = int(fg_colors[0])
  30: 
  31:     objects = find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[fg])
  32:     n = len(objects)
  33:     assert n > 0, "expected at least one foreground object"
  34: 
  35:     out = np.full((n, n), bg, dtype=int)
  36:     np.fill_diagonal(out, fg)
  37:     return out
  38: 
  39: # --------------- generator (o5x) ---------------
  40: 
  41: # Fixed colors.
  42: BG_COLOR, FG_COLOR = 0, 8
  43: 
  44: # Canvas dimensions and placement spacing.
  45: ROW_MIN, ROW_MAX, COL_MIN, COL_MAX = 8, 16, 10, 12
  46: DIMENSION_OBJECT_FACTOR, DIMENSION_EXTRA = 2, 2
  47: BORDER_MARGIN, PLACEMENT_PADDING, PLACEMENT_CONNECTIVITY = 1, 2, 4
  48: 
  49: # Object count, object size, and foreground density.
  50: OBJECT_COUNT_MIN, OBJECT_COUNT_MAX, OBJECT_SIZE_MIN, OBJECT_SIZE_MAX = 2, 5, 2, 8
  51: DENSITY_MIN_NUM, DENSITY_MIN_DEN, DENSITY_MAX_NUM, DENSITY_MAX_DEN = 1, 10, 15, 100
  52: 
  53: # Blob growth shape bias.
  54: BLOB_BBOX_MAX, ADJACENCY_WEIGHT, COMPACTNESS_BONUS_BASE = 4, 3.0, 5
  55: THIN_BLOB_SIZE_THRESHOLD, THIN_BLOB_WEIGHT = 4, 0.12
  56: ORTHOGONAL_NEIGHBORS = ((1, 0), (-1, 0), (0, 1), (0, -1))
  57: 
  58: # Retry limit for full input generation.
  59: GENERATION_RETRIES = 300
  60: 
  61: 
  62: def _gen_blob(size: int, fg: int, bg: int) -> np.ndarray:
  63:     target_size = int(size)
  64:     coords = {(0, 0)}
  65:     while len(coords) < target_size:
  66:         candidates, weights = [], []
  67:         for r, c in coords:
  68:             for dr, dc in ORTHOGONAL_NEIGHBORS:
  69:                 nr, nc = r + dr, c + dc
  70:                 if (nr, nc) in coords:
  71:                     continue
  72:                 rs = [p[0] for p in coords] + [nr]
  73:                 cs = [p[1] for p in coords] + [nc]
  74:                 h = max(rs) - min(rs) + 1
  75:                 w = max(cs) - min(cs) + 1
  76:                 if h <= BLOB_BBOX_MAX and w <= BLOB_BBOX_MAX:
  77:                     adj = sum((nr + ar, nc + ac) in coords for ar, ac in ORTHOGONAL_NEIGHBORS)
  78:                     weight = 1.0 + ADJACENCY_WEIGHT * adj + max(0, COMPACTNESS_BONUS_BASE - max(h, w))
  79:                     if target_size >= THIN_BLOB_SIZE_THRESHOLD and min(h, w) == 1:
  80:                         weight *= THIN_BLOB_WEIGHT
  81:                     candidates.append((nr, nc))
  82:                     weights.append(weight)
  83:         if not candidates:
  84:             return np.full((1, 1), bg, dtype=int)
  85:         coords.add(random.choices(candidates, weights=weights, k=1)[0])
  86: 
  87:     norm = np.array(list(coords), dtype=int)
  88:     norm -= norm.min(axis=0)
  89:     h, w = norm.max(axis=0) + 1
  90:     patch = np.full((h, w), bg, dtype=int)
  91:     patch[norm[:, 0], norm[:, 1]] = fg
  92:     return patch
  93: 
  94: 
  95: def _gen_sizes(n_objects: int, total: int) -> list[int]:
  96:     sizes = []
  97:     remaining = int(total)
  98:     for slots_left in range(int(n_objects), 0, -1):
  99:         lo = max(OBJECT_SIZE_MIN, remaining - OBJECT_SIZE_MAX * (slots_left - 1))
 100:         hi = min(OBJECT_SIZE_MAX, remaining - OBJECT_SIZE_MIN * (slots_left - 1))
 101:         size = random.randint(lo, hi)
 102:         sizes.append(size)
 103:         remaining -= size
 104:     random.shuffle(sizes)
 105:     return sizes
 106: 
 107: 
 108: def _choose_dimensions(n_objects: int) -> tuple[int, int, int, int] | None:
 109:     """Pick a feasible grid size and total foreground bounds."""
 110:     dim_choices = []
 111:     min_side = DIMENSION_OBJECT_FACTOR * int(n_objects) + DIMENSION_EXTRA
 112:     for rows in range(max(ROW_MIN, min_side), ROW_MAX + 1):
 113:         for cols in range(max(COL_MIN, min_side), COL_MAX + 1):
 114:             cells = rows * cols
 115:             lo = max(OBJECT_SIZE_MIN * n_objects, (DENSITY_MIN_NUM * cells + DENSITY_MIN_DEN - 1) // DENSITY_MIN_DEN)
 116:             hi = min(OBJECT_SIZE_MAX * n_objects, (DENSITY_MAX_NUM * cells) // DENSITY_MAX_DEN)
 117:             if lo <= hi:
 118:                 dim_choices.append((rows, cols, lo, hi))
 119:     return random.choice(dim_choices) if dim_choices else None
 120: 
 121: 
 122: def _place_blobs(grid: np.ndarray, sizes: list[int], fg: int, bg: int) -> bool:
 123:     """Generate and place every blob into grid, returning False on rejection."""
 124:     for size in sizes:
 125:         patch = _gen_blob(size, fg, bg)
 126:         if int(np.count_nonzero(patch != bg)) != size:
 127:             return False
 128:         try:
 129:             r0, c0 = random_free_location(grid, patch, transparent=bg, border=BORDER_MARGIN,
 130:                                           padding=PLACEMENT_PADDING, padding_connectivity=PLACEMENT_CONNECTIVITY)
 131:         except ValueError:
 132:             return False
 133:         paste(grid, patch, r0, c0, transparent=bg)
 134:     return True
 135: 
 136: 
 137: def _gen_attempt() -> np.ndarray | None:
 138:     n_objects = random.randint(OBJECT_COUNT_MIN, OBJECT_COUNT_MAX)
 139:     layout = _choose_dimensions(n_objects)
 140:     if layout is None:
 141:         return None
 142:     rows, cols, total_lo, total_hi = layout
 143:     grid = np.full((rows, cols), BG_COLOR, dtype=int)
 144: 
 145:     sizes = _gen_sizes(n_objects, random.randint(total_lo, total_hi))
 146:     if not _place_blobs(grid, sizes, FG_COLOR, BG_COLOR):
 147:         return None
 148: 
 149:     expected = np.full((n_objects, n_objects), BG_COLOR, dtype=int)
 150:     np.fill_diagonal(expected, FG_COLOR)
 151:     if not np.array_equal(main(grid), expected):
 152:         return None
 153:     return grid
 154: 
 155: 
 156: def generate_input() -> np.ndarray:
 157:     for _ in range(GENERATION_RETRIES):
