+        depth = random.randint(1, h - 3)
+        if spur_side == "top":
+            mask[1 : depth + 2, c] = True
+        else:
+            mask[h - depth - 2 : h - 1, c] = True
+    else:
+        r = random.randint(1, h - 2)
+        depth = random.randint(1, w - 3)
