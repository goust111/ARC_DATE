+
+def _is_connected(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return False
+    start = tuple(map(int, coords[0]))
+    seen = {start}
+    queue = deque([start])
+    while queue:
+        r, c = queue.popleft()
+        for nr, nc in _neighbors4(mask.shape, r, c):
+            if mask[nr, nc] and (nr, nc) not in seen:
+                seen.add((nr, nc))
