+
+
+def _partition_walk(mask: np.ndarray, counts):
+    return _chunk_order(_walk_order(mask), counts)
+
+
+def _owners_to_grid(mask: np.ndarray, owners):
+    owner_grid = np.full(mask.shape, -1, dtype=int)
