+    cropped = crop_bbox(mask, box).astype(bool)
+    if aux is None:
+        return cropped
+    return cropped, crop_bbox(aux, box).astype(bool)
+
+
+def _random_transform(mask: np.ndarray, aux: np.ndarray | None = None):
