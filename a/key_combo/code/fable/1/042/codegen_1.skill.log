 192:     template = np.repeat(np.repeat(tile, TEMPLATE_SCALE, axis=0), TEMPLATE_SCALE, axis=1)
 193:     separator = np.full((SEPARATOR_ROWS, MASK_SHAPE[1]), SEPARATOR_COLOR, dtype=int)
 194:     inp = np.vstack([template, separator, mask])
 195:     if not _gen_passes_oracle(inp, tile, mask):
 196:         return None
 197:     return inp
 198: 
