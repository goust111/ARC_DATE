   9: def main(grid: np.ndarray) -> np.ndarray:
  10:     """
  11:     Stamp the compact upper template into every marked lower mask cell as an expanded block image.
  12: 
  13:     Input structure
  14:     - The grid has one solid grey separator row.
  15:     - Above it is a template region made of monochrome 2x2 blocks.
  16:     - Below it is a same-size mask containing only background and red marker pixels.
  17: 
  18:     Rule
  19:     - Compress each 2x2 block in the upper region to one color, giving a small tile.
  20:     - Build a blank output whose coarse cell grid is the lower mask and whose cell size is the tile size.
  21:     - For every red marker pixel in the lower mask, paste the tile into the corresponding output block.
  22: 
  23:     Key insight
  24:     The top half encodes the motif at half resolution, while the lower red mask encodes which coarse cells receive that motif.
  25:     """
  26:     g = np.asarray(grid, dtype=int)
  27:     assert g.ndim == 2 and g.size > 0, "expected a non-empty 2D grid"
  28: 
  29:     bg = get_bg(g)
  30:     separator_rows = np.flatnonzero(np.all(g == Color.GREY, axis=1))
  31:     assert len(separator_rows) == 1, "expected exactly one solid grey separator row"
  32:     sep = int(separator_rows[0])
  33: 
  34:     top = g[:sep]
  35:     mask = g[sep + 1 :]
  36:     assert top.shape == mask.shape, "template and marker mask must have the same shape"
  37:     assert top.shape[0] > 0 and top.shape[1] > 0, "template region must be non-empty"
  38:     assert top.shape[0] % 2 == 0 and top.shape[1] % 2 == 0, "template must split into 2x2 blocks"
  39: 
  40:     mask_colors = set(map(int, np.unique(mask)))
  41:     assert mask_colors <= {int(bg), Color.RED}, "marker mask must contain only background and red"
  42:     assert Color.RED in mask_colors, "expected at least one red marker"
  43: 
  44:     tile_h, tile_w = top.shape[0] // 2, top.shape[1] // 2
  45:     tile = np.empty((tile_h, tile_w), dtype=int)
  46:     for tr in range(tile_h):
  47:         for tc in range(tile_w):
  48:             block = top[2 * tr : 2 * tr + 2, 2 * tc : 2 * tc + 2]
  49:             color = int(block[0, 0])
  50:             assert np.all(block == color), "each template block must be monochrome"
  51:             tile[tr, tc] = color
  52: 
  53:     out = np.full((mask.shape[0] * tile_h, mask.shape[1] * tile_w), int(bg), dtype=int)
  54:     for mr, mc in np.argwhere(mask == Color.RED):
  55:         r0 = int(mr) * tile_h
  56:         c0 = int(mc) * tile_w
  57:         out[r0 : r0 + tile_h, c0 : c0 + tile_w] = tile
  58: 
  59:     return out
  60: 
  61: # --------------- generator (o5x) ---------------
  62: 
  63: # Grid dimensions and block expansion.
  64: TILE_SHAPE = (3, 3)
  65: MASK_SHAPE = (6, 6)
  66: TEMPLATE_SCALE = 2
  67: SEPARATOR_ROWS = 1
  68: 
  69: # Colors used by the generated input.
  70: MARKER_COLOR = Color.RED
  71: SEPARATOR_COLOR = Color.GREY
  72: TILE_PALETTE = [Color.BLUE, Color.RED, Color.GREEN, Color.YELLOW, Color.PINK, Color.ORANGE, Color.TEAL, Color.MAROON]
  73: 
  74: # Tile and mask sampling controls.
  75: TILE_FILLED_RANGE = (4, 7)
  76: TILE_DISTINCT_RANGE = (2, 4)
  77: MAX_CELLS_PER_TILE_COLOR = 4
  78: MASK_RED_RANGE = (5, 12)
  79: MASK_COMPONENT_RANGE = (1, 3)
  80: EMPTY_LABEL = -1
  81: NEIGHBOR4_DELTAS = ((-1, 0), (1, 0), (0, -1), (0, 1))
  82: 
  83: # Retry budget for rejected masks or oracle mismatches.
  84: GEN_RETRY_LIMIT = 300
  85: 
  86: 
  87: def _gen_neighbors4(r: int, c: int):
  88:     for dr, dc in NEIGHBOR4_DELTAS:
  89:         nr, nc = r + dr, c + dc
  90:         if 0 <= nr < MASK_SHAPE[0] and 0 <= nc < MASK_SHAPE[1]:
  91:             yield nr, nc
  92: 
  93: 
  94: def _gen_split_positive(total: int, parts: int) -> list[int]:
  95:     cuts = sorted(random.sample(range(1, total), parts - 1))
  96:     vals = []
  97:     prev = 0
  98:     for cut in cuts + [total]:
  99:         vals.append(cut - prev)
 100:         prev = cut
 101:     return vals
 102: 
 103: 
 104: def _gen_color_counts(total: int, distinct: int) -> list[int]:
 105:     counts = [1] * distinct
 106:     for _ in range(total - distinct):
 107:         choices = [i for i, count in enumerate(counts) if count < MAX_CELLS_PER_TILE_COLOR]
 108:         counts[random.choice(choices)] += 1
 109:     random.shuffle(counts)
 110:     return counts
 111: 
 112: 
 113: def _gen_tile() -> np.ndarray:
 114:     tile = np.zeros(TILE_SHAPE, dtype=int)
 115:     filled = random.randint(*TILE_FILLED_RANGE)
 116:     distinct = random.randint(TILE_DISTINCT_RANGE[0], min(TILE_DISTINCT_RANGE[1], filled))
 117:     colors = random.sample(TILE_PALETTE, distinct)
 118:     positions = random.sample([(r, c) for r in range(TILE_SHAPE[0]) for c in range(TILE_SHAPE[1])], filled)
 119:     assignments = []
 120:     for color, count in zip(colors, _gen_color_counts(filled, distinct)):
 121:         assignments.extend([color] * count)
 122:     random.shuffle(assignments)
 123:     for (r, c), color in zip(positions, assignments):
 124:         tile[r, c] = color
 125:     return tile
 126: 
 127: 
 128: def _gen_touching_other(labels: np.ndarray, r: int, c: int, current: int) -> bool:
 129:     return any(0 <= labels[nr, nc] != current for nr, nc in _gen_neighbors4(r, c))
 130: 
 131: 
 132: def _gen_seed_cells(labels: np.ndarray, comp_id: int) -> list[tuple[int, int]]:
 133:     return [
 134:         (r, c)
 135:         for r in range(MASK_SHAPE[0])
 136:         for c in range(MASK_SHAPE[1])
 137:         if labels[r, c] < 0 and not _gen_touching_other(labels, r, c, comp_id)
 138:     ]
 139: 
 140: 
 141: def _gen_frontier_cells(labels: np.ndarray, comp_id: int) -> list[tuple[int, int]]:
 142:     frontier = []
 143:     for r in range(MASK_SHAPE[0]):
 144:         for c in range(MASK_SHAPE[1]):
 145:             if labels[r, c] >= 0:
 146:                 continue
 147:             if any(labels[nr, nc] == comp_id for nr, nc in _gen_neighbors4(r, c)) and not _gen_touching_other(labels, r, c, comp_id):
 148:                 frontier.append((r, c))
 149:     return frontier
 150: 
 151: 
 152: def _gen_mask() -> np.ndarray | None:
 153:     total = random.randint(*MASK_RED_RANGE)
 154:     comp_count = random.randint(MASK_COMPONENT_RANGE[0], min(MASK_COMPONENT_RANGE[1], total))
 155:     sizes = sorted(_gen_split_positive(total, comp_count), reverse=True)
 156:     labels = np.full(MASK_SHAPE, EMPTY_LABEL, dtype=int)
 157: 
 158:     for comp_id, target in enumerate(sizes):
 159:         seeds = _gen_seed_cells(labels, comp_id)
 160:         if not seeds:
 161:             return None
 162:         seed_r, seed_c = random.choice(seeds)
 163:         labels[seed_r, seed_c] = comp_id
 164: 
 165:         while int(np.sum(labels == comp_id)) < target:
 166:             frontier = _gen_frontier_cells(labels, comp_id)
 167:             if not frontier:
 168:                 return None
 169:             nr, nc = random.choice(frontier)
 170:             labels[nr, nc] = comp_id
 171: 
 172:     mask = np.zeros(MASK_SHAPE, dtype=int)
 173:     mask[labels >= 0] = MARKER_COLOR
 174:     return mask
 175: 
 176: 
 177: def _gen_passes_oracle(inp: np.ndarray, tile: np.ndarray, mask: np.ndarray) -> bool:
 178:     expected = np.kron(mask == MARKER_COLOR, tile).astype(int)
 179:     try:
 180:         actual = main(inp)
 181:     except AssertionError:
 182:         return False
 183:     return np.array_equal(actual, expected)
 184: 
 185: 
 186: def _gen_attempt() -> np.ndarray | None:
 187:     tile = _gen_tile()
 188:     mask = _gen_mask()
 189:     if mask is None:
 190:         return None
