+
+
+def _gen_frame_shape():
+    h = random.randint(5, 7)
+    w = random.randint(5, 7)
+    mask = np.zeros((h, w), dtype=bool)
+    mask[0, :] = True
+    mask[-1, :] = True
+    mask[:, 0] = True
+    mask[:, -1] = True
