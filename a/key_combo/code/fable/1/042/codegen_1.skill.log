   9: def main(grid: np.ndarray) -> np.ndarray:
  10:     """
  11:     Extend the red start pixel into a recursive rectilinear ray network that turns at colored marker pixels.
  12: 
  13:     Input structure
  14:     - The canvas has black background, one red start pixel on the left edge, and isolated colored marker pixels.
  15:     - Original non-red, non-background marker pixels are blockers and are preserved.
  16:     - Marker colors are green, pink, orange, and teal; orange markers on the lower border are terminal when hit from above.
  17: 
  18:     Rule
  19:     - Start with a horizontal red ray from the red edge pixel.
  20:     - A ray paints background cells red until it reaches the first original marker in each direction of its row or column.
  21:     - The first time a marker opens, emit the perpendicular row or column from the red cell immediately before that marker; later hits on the same marker only stop the ray.
  22:     - Process emitted rows/columns depth-first, with right/down emissions taking priority over left/up emissions when both are discovered together.
  23:     - If a downward vertical ray reaches an orange marker on the lower border, stop there without opening a new horizontal ray.
  24: 
  25:     Key insight
  26:     - The output is not a global fill: it is the depth-first closure of marker-triggered perpendicular ray turns, with marker pixels acting as one-time controls.
  27:     """
  28:     g = np.asarray(grid, dtype=int)
  29:     bg = get_bg(g)
  30:     assert bg == Color.BLACK, "expected black background"
  31: 
  32:     starts = np.argwhere(g == Color.RED)
  33:     assert len(starts) == 1, "expected exactly one red start pixel"
  34:     start_r, start_c = map(int, starts[0])
  35:     assert start_c == 0, "red start pixel must be on the left edge"
  36: 
  37:     marker_mask = (g != bg) & (g != Color.RED)
  38:     assert np.any(marker_mask), "expected colored marker pixels"
  39:     marker_colors = set(map(int, np.unique(g[marker_mask])))
  40:     assert marker_colors <= {Color.GREEN, Color.PINK, Color.ORANGE, Color.TEAL}
  41: 
  42:     H, W = g.shape
  43:     out = g.copy()
  44:     blockers = marker_mask
  45:     pending: list[tuple[int, int, str]] = [(start_r, start_c, "h")]
  46:     seen_segments: set[tuple[int, int, str]] = set()
  47:     opened_markers: set[tuple[int, int]] = set()
  48: 
  49:     while pending:
  50:         r, c, axis = pending.pop()
  51:         segment_key = (r, c, axis)
  52:         if segment_key in seen_segments:
  53:             continue
  54:         seen_segments.add(segment_key)
  55:         out[r, c] = Color.RED
  56: 
  57:         if axis == "h":
  58:             directions = [(0, -1), (0, 1)]
  59:             next_axis = "v"
  60:         else:
  61:             directions = [(-1, 0), (1, 0)]
  62:             next_axis = "h"
  63: 
  64:         new_segments: list[tuple[int, int, str]] = []
  65:         for dr, dc in directions:
  66:             prev_r, prev_c = r, c
  67:             rr, cc = r + dr, c + dc
  68:             while 0 <= rr < H and 0 <= cc < W:
  69:                 if blockers[rr, cc]:
  70:                     marker = (int(rr), int(cc))
  71:                     terminal_orange = (
  72:                         axis == "v"
  73:                         and dr == 1
  74:                         and rr == H - 1
  75:                         and int(g[rr, cc]) == Color.ORANGE
  76:                     )
  77:                     if marker not in opened_markers and not terminal_orange:
  78:                         opened_markers.add(marker)
  79:                         new_segments.append((prev_r, prev_c, next_axis))
  80:                     break
  81: 
  82:                 out[rr, cc] = Color.RED
  83:                 prev_r, prev_c = rr, cc
  84:                 rr += dr
  85:                 cc += dc
  86: 
  87:         pending.extend(new_segments)
  88: 
  89:     return out
  90: 
  91: # --------------- generator (o5x) ---------------
  92: 
  93: # Colors and marker palette.
  94: _GEN_BLACK, _GEN_RED, _GEN_ORANGE, _GEN_MARKER_COLORS = 0, 2, 7, (3, 6, 7, 8)
  95: 
  96: # Canvas and start placement bounds.
  97: _GEN_HEIGHT_RANGE, _GEN_WIDTH_RANGE = (4, 12), (6, 12)
  98: _GEN_START_ROW_LO_DIVISOR, _GEN_START_ROW_HI_DIVISOR, _GEN_START_ROW_HI_OFFSET = 5, 2, 1
  99: 
 100: # Ray-network construction limits.
 101: _GEN_DEPTH_RANGE, _GEN_OPENINGS_RANGE, _GEN_SEGMENT_COUNT_RANGE = (1, 6), (1, 10), (2, 11)
 102: _GEN_MAX_SEEN_SEGMENTS, _GEN_DEPTH_BRANCH_CAP = 11, 4
 103: _GEN_BRANCH_TWO_PROB, _GEN_MIN_OPENING_DIST = 0.45, 2
 104: 
 105: # Marker and output constraints.
 106: _GEN_COLOR_COUNT_RANGE, _GEN_MARKER_COUNT_RANGE = (1, 4), (1, 19)
 107: _GEN_MAX_DISTRACTORS, _GEN_RED_RATIO_RANGE, _GEN_MAX_ATTEMPTS = 12, (0.20, 0.42), 300
 108: 
 109: 
 110: def _gen_init_canvas():
 111:     H = random.randint(*_GEN_HEIGHT_RANGE)
 112:     W = random.randint(*_GEN_WIDTH_RANGE)
 113:     grid = np.zeros((H, W), dtype=int)
 114:     start_lo = H // _GEN_START_ROW_LO_DIVISOR
 115:     start_hi = max(start_lo, H // _GEN_START_ROW_HI_DIVISOR - _GEN_START_ROW_HI_OFFSET)
 116:     start_r = random.randint(start_lo, start_hi)
 117:     grid[start_r, 0] = _GEN_RED
 118:     return grid, start_r
 119: 
 120: 
 121: def _gen_dirs(axis):
 122:     if axis == "h":
 123:         return ((0, -1), (0, 1)), "v"
 124:     return ((-1, 0), (1, 0)), "h"
 125: 
 126: 
 127: def _gen_first_blocker(grid, r, c, dr, dc):
 128:     H, W = grid.shape
 129:     prev_r, prev_c = r, c
 130:     rr, cc = r + dr, c + dc
 131:     while 0 <= rr < H and 0 <= cc < W:
 132:         if grid[rr, cc] not in (_GEN_BLACK, _GEN_RED):
 133:             return int(rr), int(cc), int(prev_r), int(prev_c)
 134:         prev_r, prev_c = rr, cc
 135:         rr += dr
 136:         cc += dc
 137:     return None
 138: 
 139: 
 140: def _gen_opening_candidates(grid, r, c, axis, dr, dc, color_pool):
 141:     H, W = grid.shape
 142:     ans = []
 143:     rr, cc = r + dr, c + dc
 144:     dist = 1
 145:     while 0 <= rr < H and 0 <= cc < W:
 146:         if grid[rr, cc] not in (_GEN_BLACK, _GEN_RED):
 147:             break
 148:         if dist >= _GEN_MIN_OPENING_DIST and grid[rr, cc] == _GEN_BLACK:
 149:             valid_colors = list(color_pool)
 150:             if axis == "v" and dr == 1 and rr == H - 1:
 151:                 valid_colors = [x for x in valid_colors if x != _GEN_ORANGE]
 152:             if valid_colors:
 153:                 ans.append((int(rr), int(cc), int(rr - dr), int(cc - dc), valid_colors))
 154:         rr += dr
 155:         cc += dc
 156:         dist += 1
 157:     return ans
 158: 
 159: 
 160: def _gen_apply_available_openings(grid, available, remaining, opened, next_axis, depth):
 161:     new_segments = []
 162:     added = 0
 163:     if remaining <= 0 or not available:
 164:         return new_segments, added
 165: 
 166:     max_add = min(remaining, len(available))
 167:     add_count = 1
 168:     if max_add >= 2 and random.random() < _GEN_BRANCH_TWO_PROB:
 169:         add_count = 2
 170:     selected = set(random.sample([x[0] for x in available], add_count))
 171: 
 172:     for dir_i, dr, dc, candidates in available:
 173:         if dir_i not in selected:
 174:             continue
 175:         mr, mc, prev_r, prev_c, valid_colors = random.choice(candidates)
 176:         grid[mr, mc] = random.choice(valid_colors)
 177:         opened.add((mr, mc))
 178:         added += 1
 179:         new_segments.append((prev_r, prev_c, next_axis, depth + 1))
 180:     return new_segments, added
 181: 
 182: 
 183: def _gen_build_network(grid, color_pool, target_depth, target_openings):
 184:     start_r = int(np.argwhere(grid == _GEN_RED)[0, 0])
 185:     pending = [(start_r, 0, "h", 0)]
 186:     seen = set()
 187:     opened = set()
 188:     placed = 0
 189:     max_depth = 0
 190: 
 191:     while pending and len(seen) <= _GEN_MAX_SEEN_SEGMENTS:
 192:         r, c, axis, depth = pending.pop()
 193:         key = (r, c, axis)
 194:         if key in seen:
 195:             continue
 196:         seen.add(key)
 197:         max_depth = max(max_depth, depth)
 198: 
 199:         dirs, next_axis = _gen_dirs(axis)
 200:         new_segments = []
 201:         available = []
 202:         for dir_i, (dr, dc) in enumerate(dirs):
 203:             hit = _gen_first_blocker(grid, r, c, dr, dc)
 204:             if hit is not None:
 205:                 mr, mc, prev_r, prev_c = hit
 206:                 marker = (mr, mc)
 207:                 terminal = axis == "v" and dr == 1 and mr == grid.shape[0] - 1 and grid[mr, mc] == _GEN_ORANGE
 208:                 if marker not in opened and not terminal:
 209:                     opened.add(marker)
 210:                     placed += 1
 211:                     new_segments.append((prev_r, prev_c, next_axis, depth + 1))
 212:                 continue
 213: 
 214:             if depth < target_depth and placed < target_openings:
 215:                 candidates = _gen_opening_candidates(grid, r, c, axis, dr, dc, color_pool)
 216:                 if candidates:
 217:                     available.append((dir_i, dr, dc, candidates))
 218: 
 219:         emitted, added = _gen_apply_available_openings(grid, available, target_openings - placed, opened, next_axis, depth)
 220:         placed += added
 221:         new_segments.extend(emitted)
 222: 
 223:         pending.extend(new_segments)
 224: 
 225:     return placed, len(seen), max_depth
 226: 
 227: 
 228: def _gen_add_distractors(grid, active_out, color_pool):
 229:     marker_count = int(np.count_nonzero((grid != _GEN_BLACK) & (grid != _GEN_RED)))
 230:     safe = np.argwhere((active_out == _GEN_BLACK) & (grid == _GEN_BLACK))
 231:     if marker_count > _GEN_MARKER_COUNT_RANGE[1]:
 232:         return False
 233:     max_distractors = min(_GEN_MAX_DISTRACTORS, _GEN_MARKER_COUNT_RANGE[1] - marker_count, len(safe))
 234:     distractor_count = random.randint(0, max_distractors)
 235:     if distractor_count:
 236:         order = np.random.permutation(len(safe))[:distractor_count]
 237:         for idx in order:
 238:             rr, cc = map(int, safe[idx])
 239:             grid[rr, cc] = random.choice(color_pool)
 240:     return True
 241: 
 242: 
 243: def _gen_attempt() -> np.ndarray | None:
 244:     grid, start_r = _gen_init_canvas()
 245:     H, W = grid.shape
 246:     color_count = random.randint(*_GEN_COLOR_COUNT_RANGE)
 247:     color_pool = tuple(random.sample(_GEN_MARKER_COLORS, color_count))
 248:     target_depth = random.randint(*_GEN_DEPTH_RANGE)
 249:     max_openings = min(_GEN_OPENINGS_RANGE[1], 2 ** min(target_depth, _GEN_DEPTH_BRANCH_CAP) - 1)
 250:     target_openings = random.randint(_GEN_OPENINGS_RANGE[0], max_openings)
 251: 
 252:     opened_count, segment_count, max_depth = _gen_build_network(
 253:         grid, color_pool, target_depth, target_openings
 254:     )
 255:     if not (_GEN_OPENINGS_RANGE[0] <= opened_count <= _GEN_OPENINGS_RANGE[1]):
 256:         return None
 257:     if not (_GEN_SEGMENT_COUNT_RANGE[0] <= segment_count <= _GEN_SEGMENT_COUNT_RANGE[1]):
 258:         return None
 259:     if not (_GEN_DEPTH_RANGE[0] <= max_depth <= _GEN_DEPTH_RANGE[1]):
 260:         return None
 261: 
 262:     try:
 263:         active_out = main(grid)
 264:     except Exception:
 265:         return None
 266:     if not _gen_add_distractors(grid, active_out, color_pool):
 267:         return None
 268: 
 269:     try:
 270:         out = main(grid)
 271:     except Exception:
 272:         return None
 273:     if not np.array_equal(main(grid), out):
 274:         return None
 275:     red_ratio = float(np.count_nonzero(out == _GEN_RED)) / float(H * W)
 276:     if not (_GEN_RED_RATIO_RANGE[0] <= red_ratio <= _GEN_RED_RATIO_RANGE[1]):
 277:         return None
 278: 
 279:     total_markers = int(np.count_nonzero((grid != _GEN_BLACK) & (grid != _GEN_RED)))
 280:     if not (_GEN_MARKER_COUNT_RANGE[0] <= total_markers <= _GEN_MARKER_COUNT_RANGE[1]):
 281:         return None
 282:     if not np.any(grid[start_r, 1:] != _GEN_BLACK):
 283:         return None
 284:     return grid
 285: 
 286: 
 287: def generate_input() -> np.ndarray:
 288:     for _ in range(_GEN_MAX_ATTEMPTS):
 289:         grid = _gen_attempt()
 290:         if grid is not None:
 291:             return grid
 292:     raise RuntimeError("failed to generate b942fd60 input")


