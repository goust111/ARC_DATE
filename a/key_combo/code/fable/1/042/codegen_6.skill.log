   8: def main(grid: np.ndarray) -> np.ndarray:
   9:     """
  10:     Pack the bottom-grounded foreground rectangles into an overlapping diagonal chain starting at the upper-left.
  11: 
  12:     Input structure
  13:     The background is the most common color. Every foreground object is a solid
  14:     monochrome rectangle touching the bottom row, and the rectangles have unique
  15:     left edges that define their left-to-right order.
  16: 
  17:     Rule
  18:     Clear the canvas to the background. Copy the rectangles in left-to-right
  19:     order, placing the first at the upper-left corner. After placing a rectangle
  20:     of height h and width w, place the next rectangle h-1 rows lower and w-1
  21:     columns to the right, so later rectangles overwrite the shared corner cell.
  22: 
  23:     Key insight
  24:     The bottom arrangement is a horizontal list of rectangles; the output keeps
  25:     the list order and rectangle shapes while converting the list into a compact
  26:     diagonal chain of overlapping bounding-box corners.
  27:     """
  28:     g = np.asarray(grid, dtype=int)
  29:     assert g.ndim == 2, "expected a 2D grid"
  30:     height, width = map(int, g.shape)
  31:     bg = int(get_bg(g))
  32: 
  33:     objects = find_components(g, bg=bg, connectivity=4, monochromatic=True)
  34:     assert objects, "expected at least one foreground rectangle"
  35: 
  36:     left_edges = [int(obj["bbox"][1]) for obj in objects]
  37:     assert len(set(left_edges)) == len(left_edges), "expected unique left-to-right object order"
  38: 
  39:     out = np.full_like(g, bg)
  40:     row = 0
  41:     col = 0
  42:     for obj in sorted(objects, key=lambda item: int(item["bbox"][1])):
  43:         r0, c0, r1, c1 = map(int, obj["bbox"])
  44:         assert r1 == height - 1, "each object must touch the bottom row"
  45: 
  46:         patch = crop_bbox(g, (r0, c0, r1, c1))
  47:         assert np.all(patch == int(obj["color"])), "each object must be a solid rectangle"
  48: 
  49:         h, w = map(int, patch.shape)
  50:         assert row + h <= height and col + w <= width, "packed chain must fit on the canvas"
  51:         paste(out, patch, row, col)
  52:         row += h - 1
  53:         col += w - 1
  54: 
  55:     return out
  56: 
  57: # --------------- generator (o5x) ---------------
  58: # Canvas and palette.
  59: GRID_SIZE, BACKGROUND_COLOR = 10, 0
  60: FOREGROUND_COLORS = np.arange(1, 10)
  61: # Rectangle sampling ranges, inclusive.
  62: RECT_COUNT_MIN, RECT_COUNT_MAX = 3, 4
  63: RECT_HEIGHT_MIN, RECT_HEIGHT_MAX = 1, 5
  64: RECT_WIDTH_MIN, RECT_WIDTH_MAX = 1, 4
  65: # Packing constraints and retry limit.
  66: CHAIN_OVERLAP, INPUT_GAP, MAX_GENERATION_ATTEMPTS = 1, 1, 300
  67: _DIMENSION_CHOICES_CACHE: dict[int, list[tuple[tuple[int, ...], tuple[int, ...]]]] = {}
  68: 
  69: 
  70: def _gen_dimension_choices(n: int) -> list[tuple[tuple[int, ...], tuple[int, ...]]]:
  71:     from itertools import product
  72: 
  73:     if n not in _DIMENSION_CHOICES_CACHE:
  74:         choices = []
  75:         for heights in product(range(RECT_HEIGHT_MIN, RECT_HEIGHT_MAX + 1), repeat=n):
  76:             if sum(h - CHAIN_OVERLAP for h in heights) + CHAIN_OVERLAP > GRID_SIZE:
  77:                 continue
  78:             for widths in product(range(RECT_WIDTH_MIN, RECT_WIDTH_MAX + 1), repeat=n):
  79:                 if sum(w - CHAIN_OVERLAP for w in widths) + CHAIN_OVERLAP > GRID_SIZE:
  80:                     continue
  81:                 if sum(widths) + (n - 1) * INPUT_GAP > GRID_SIZE:
  82:                     continue
  83:                 choices.append((tuple(map(int, heights)), tuple(map(int, widths))))
  84:         _DIMENSION_CHOICES_CACHE[n] = choices
  85:     return _DIMENSION_CHOICES_CACHE[n]
  86: 
  87: 
  88: def _gen_attempt() -> np.ndarray | None:
  89:     n = int(np.random.randint(RECT_COUNT_MIN, RECT_COUNT_MAX + 1))
  90:     choices = _gen_dimension_choices(n)
  91:     heights, widths = choices[int(np.random.randint(len(choices)))]
  92:     colors = [int(c) for c in np.random.choice(FOREGROUND_COLORS, size=n, replace=False)]
  93: 
  94:     expected = np.full((GRID_SIZE, GRID_SIZE), BACKGROUND_COLOR, dtype=int)
  95:     row = col = 0
  96:     for h, w, color in zip(heights, widths, colors):
  97:         patch = np.full((h, w), color, dtype=int)
  98:         paste(expected, patch, row, col)
  99:         row += h - CHAIN_OVERLAP
 100:         col += w - CHAIN_OVERLAP
 101: 
 102:     inp = np.full((GRID_SIZE, GRID_SIZE), BACKGROUND_COLOR, dtype=int)
 103:     left = 0
 104:     for h, w, color in zip(heights, widths, colors):
 105:         patch = np.full((h, w), color, dtype=int)
 106:         paste(inp, patch, GRID_SIZE - h, left)
 107:         left += w + INPUT_GAP
 108: 
 109:     if not np.array_equal(main(inp), expected):
 110:         return None
 111:     return inp
 112: 
 113: 
 114: def generate_input() -> np.ndarray:
 115:     for _ in range(MAX_GENERATION_ATTEMPTS):
 116:         grid = _gen_attempt()
 117:         if grid is not None:
 118:             return grid
 119:     raise RuntimeError("failed to generate valid input")

