+    tail_col = None
+    if add_tail:
+        tail_col = col
+        w = tail_col + random.randint(1, 3) + 1
+    else:
+        w = cols[-1] + random.randint(2, 4) + 1
+
+    grid = np.full((h, w), Color.BLACK, dtype=int)
