+def _swap_mirror_colors(grid: np.ndarray) -> np.ndarray:
+    out = np.asarray(grid, dtype=int).copy()
+    slash = out == Color.GREEN
+    backslash = out == Color.PINK
+    out[slash] = Color.PINK
+    out[backslash] = Color.GREEN
+    return out
