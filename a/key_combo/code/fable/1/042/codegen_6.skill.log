  15: def main(input_grid):
  16:     """
  17:     March each opposite-side pixel pair toward the center and mark the meeting point gray.
  18: 
  19:     Input structure:
  20:     - Non-black single pixels appear in pairs on opposite sides of a black grid.
  21:     - Each pair lies on a shared row or column after considering horizontal or vertical reflection.
  22:     - Distances are arranged so each pair has one meeting cell.
  23: 
  24:     Rule:
  25:     - Detect each single-pixel component.
  26:     - Match it to the one non-background reflected pixel on the opposite side.
  27:     - Move both endpoints toward each other, leaving trails of their own colors and coloring the meeting cell gray.
  28: 
  29:     Key insight:
  30:     - Opposite-side reflection identifies the pairings, and simultaneous inward motion creates the two-color trails.
  31:     """
  32:     # Plan:
  33:     # 1. Detect the pixels
  34:     # 2. Associate each pixel with its matching pair
  35:     # 3. Make them attract/march toward each other until they meet in the middle, leaving a trail of their own color
  36: 
  37:     # 1. Find the location of the pixels
  38:     pixel_objects = find_components(input_grid, bg=Color.BLACK, connectivity=4, monochromatic=True, return_format="objects")
  39:     assert len(pixel_objects) % 2 == 0, "There should be an even number of pixels"
  40: 
  41:     # we're going to draw on top of the input grid
  42:     output_grid = input_grid.copy()
  43: 
  44:     seen: set[tuple[int, int]] = set()
  45:     H, W = input_grid.shape
  46:     for obj in pixel_objects:
  47:         # 2. Associate each pixel with its matching pair
  48:         # Find the matching position. The legacy seed solver ran under a transpose wrapper;
  49:         # the most robust way here is to probe both possible "opposite side" candidates
  50:         # and pick the one that is non-background.
  51:         _b = bbox(obj != Color.BLACK)
  52:         assert _b is not None
  53:         r, c = bbox_anchor(_b, anchor="center")
  54:         if (r, c) in seen:
  55:             continue
  56: 
  57:         candidates: list[tuple[int, int]] = []
  58:         # vertical reflection
  59:         rv, cv = H - 1 - r, c
  60:         if 0 <= rv < H and 0 <= cv < W and int(input_grid[rv, cv]) != int(Color.BLACK):
  61:             candidates.append((rv, cv))
  62:         # horizontal reflection
  63:         rh, ch = r, W - 1 - c
  64:         if 0 <= rh < H and 0 <= ch < W and int(input_grid[rh, ch]) != int(Color.BLACK):
  65:             candidates.append((rh, ch))
  66: 
  67:         assert len(candidates) == 1, "Expected exactly one non-background opposite pixel"
  68:         opposite_r, opposite_c = candidates[0]
  69:         seen.add((r, c))
  70:         seen.add((opposite_r, opposite_c))
  71: 
  72:         # get the unit vector pointing from one to the other
  73:         dr = int(np.sign(opposite_r - r))
  74:         dc = int(np.sign(opposite_c - c))
  75: 
  76:         color = input_grid[r, c]
  77:         other_color = input_grid[opposite_r, opposite_c]
  78: 
  79:         # 3. Make them attract/march toward each other until they meet in the middle (grey when they touch), leaving a trail of their own color
  80:         while (r, c) != (opposite_r, opposite_c):
  81:             # Draw a trail of color
  82:             if output_grid[r, c] == Color.BLACK:
  83:                 output_grid[r, c] = color
  84:             if output_grid[opposite_r, opposite_c] == Color.BLACK:
  85:                 output_grid[opposite_r, opposite_c] = other_color
  86:             r += dr
  87:             c += dc
  88:             opposite_r -= dr
  89:             opposite_c -= dc
  90: 
  91:             # Make sure we haven't fallen out of bounds
  92:             if not (0 <= r < input_grid.shape[0] and 0 <= c < input_grid.shape[1] and 0 <= opposite_r < input_grid.shape[0] and 0 <= opposite_c < input_grid.shape[1]):
  93:                 break
  94:         # when they meet, turn the middle point grey
  95:         output_grid[r, c] = Color.GREY
  96:     
  97:     return output_grid
  98:         
  99: 
 100: 
 101: 
 102: def generate_input():
 103:     # We are going to generate a grid with pairs that go left-right, then randomly rotate
 104:     # to get the other orientations.
 105: 
 106:     # Generate a grid with random size, but odd width so there is a unique middle point after marching.
 107:     H = np.random.randint(5, 25)
 108:     # sample an odd width directly
 109:     W = int(random.choice([w for w in range(11, 30) if w % 2 == 1]))
 110: 
 111:     grid = np.full((H, W), Color.BLACK)
 112: 
 113:     # Choose rows so that for any pixel, exactly ONE of {vertical-reflection, horizontal-reflection}
 114:     # is non-background (matching the solver's assumption).
 115:     candidate_rows = [r for r in range(1, H - 1) if r < (H - 1 - r)]
 116:     # Avoid adjacent pixels on the same border column (which could merge components).
 117:     candidate_rows = candidate_rows[::2]
 118:     max_pairs = min(6, len(candidate_rows))
 119:     n_pairs = np.random.randint(1, max_pairs + 1)
 120:     rows = random.sample(candidate_rows, k=n_pairs)
 121: 
 122:     for r in rows:
 123:         color = random.choice([col for col in Color.NOT_BLACK if col != Color.GREY])
 124:         other_color = random.choice([col for col in Color.NOT_BLACK if col not in {color, Color.GREY}])
 125:         grid[r, 0] = int(color)
 126:         grid[r, W - 1] = int(other_color)
 127: 
 128:     # random rotation
 129:     grid = np.rot90(grid, -(np.random.randint(0, 4)))
 130:     return grid

