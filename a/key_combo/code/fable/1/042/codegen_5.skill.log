    cavity_w: int,
    block_h: int,
    block_w: int,
    frame_box: tuple[int, int, int, int],
    objects: list[tuple[int, list[tuple[int, int]]]],
) -> np.ndarray:
    H = cavity_h * block_h
    W = cavity_w * block_w
    grid = np.full((H, W), Color.BLACK, dtype=int)
    for color, cells in objects:
        for r, c in cells:
            rs = slice(r * block_h, (r + 1) * block_h)
