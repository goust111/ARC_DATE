+        return None
+    if not _semantic_ok(
+        grid,
+        expected,
+        capacities,
+        counts,
+        targets,
+        invalid_idx,
+        force_self=force_self,
+        force_irregular=force_irregular,
+        force_mislead=force_mislead,
+        invalid_count=invalid_count,
+    ):
