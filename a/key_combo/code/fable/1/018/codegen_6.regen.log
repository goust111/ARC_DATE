+                    cc0 = max(0, c0 - padding)
+                    rr1 = min(canvas.shape[0], r0 + h + padding)
+                    cc1 = min(canvas.shape[1], c0 + w + padding)
+                    if np.any(occ[rr0:rr1, cc0:cc1]):
