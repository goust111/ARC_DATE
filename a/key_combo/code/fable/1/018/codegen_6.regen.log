+        BLACK = 0
+        BLUE = 1
+        RED = 2
+        GREEN = 3
+        YELLOW = 4
+        GREY = 5
+        PINK = 6
+        ORANGE = 7
+        TEAL = 8
+        MAROON = 9
+        NOT_BLACK = [1, 2, 3, 4, 5, 6, 7, 8, 9]
