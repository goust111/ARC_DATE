+def _neighbors(r: int, c: int, connectivity: int = 4):
+    if int(connectivity) == 8:
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                if dr == 0 and dc == 0:
+                    continue
+                yield int(r) + dr, int(c) + dc
+    else:
+        yield int(r) - 1, int(c)
+        yield int(r) + 1, int(c)
+        yield int(r), int(c) - 1
+        yield int(r), int(c) + 1
