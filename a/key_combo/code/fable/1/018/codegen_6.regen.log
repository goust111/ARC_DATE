+    height = random.randint(max(CANVAS_RANGE[0], min_side), CANVAS_RANGE[1])
+    width = random.randint(max(CANVAS_RANGE[0], min_side), CANVAS_RANGE[1])
+    grid = np.full((height, width), BG, dtype=int)
