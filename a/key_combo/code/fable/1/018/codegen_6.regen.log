+def _mask_from_spec(spec: dict) -> np.ndarray:
+    h = int(spec["h"])
+    w = int(spec["w"])
+    mask = np.ones((h, w), dtype=bool)
+    if spec["kind"] == "rect":
+        return mask
+    a = int(spec["a"])
+    b = int(spec["b"])
+    if spec["kind"] == "corner":
+        corner = spec["corner"]
+        if corner == "tl":
+            mask[:a, :b] = False
+        elif corner == "tr":
+            mask[:a, w - b :] = False
+        elif corner == "bl":
+            mask[h - a :, :b] = False
+        else:
+            mask[h - a :, w - b :] = False
+    else:
+        edge = spec["edge"]
+        offset = int(spec["offset"])
+        if edge == "top":
+            mask[:a, offset : offset + b] = False
+        elif edge == "bottom":
+            mask[h - a :, offset : offset + b] = False
+        elif edge == "left":
+            mask[offset : offset + a, :b] = False
+        else:
+            mask[offset : offset + a, w - b :] = False
