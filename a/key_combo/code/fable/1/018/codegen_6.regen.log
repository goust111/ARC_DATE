+        spec = specs[int(dst_idx)]
+        r0 = int(spec["r0"])
+        c0 = int(spec["c0"])
+        h, w = spec["patch"].shape
+        out[r0 : r0 + h, c0 : c0 + w][spec["inner_mask"]] = int(specs[src_idx]["color"])
+    return out
