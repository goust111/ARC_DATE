+BG = Color.BLACK
+FRAME = Color.GREY
+PALETTE = [c for c in getattr(Color, "NOT_BLACK", [1, 2, 3, 4, 5, 6, 7, 8, 9]) if c != FRAME]
+
+FRAME_COUNT_RANGE = (3, 5)
+CAPACITY_VALUES = list(range(3, 10))
+INVALID_COUNT_VALUES = list(range(4, 11))
+CANVAS_RANGE = (18, 30)
+PLACE_ATTEMPTS = 300
+SHAPE_ATTEMPTS = 200
+GENERATE_ATTEMPTS = 300
