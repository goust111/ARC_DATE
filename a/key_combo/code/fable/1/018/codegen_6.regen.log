+def _neighbors(r: int, c: int, connectivity: int = 4):
+    if int(connectivity) == 8:
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                if dr == 0 and dc == 0:
+                    continue
+                yield int(r) + dr, int(c) + dc
+    else:
+        yield int(r) - 1, int(c)
+        yield int(r) + 1, int(c)
+        yield int(r), int(c) - 1
+        yield int(r), int(c) + 1
+
+
+def _boundary_reachable(open_mask: np.ndarray) -> np.ndarray:
+    open_mask = np.asarray(open_mask, dtype=bool)
+    h, w = open_mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    q: deque[tuple[int, int]] = deque()
+
+    for r in range(h):
+        for c in (0, w - 1):
+            if open_mask[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                q.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if open_mask[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                q.append((r, c))
+
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors(r, c, 4):
+            if 0 <= nr < h and 0 <= nc < w and open_mask[nr, nc] and not seen[nr, nc]:
+                seen[nr, nc] = True
+                q.append((nr, nc))
+    return seen
+
+
+def _component_count(mask: np.ndarray, connectivity: int = 4) -> int:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    total = 0
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            total += 1
+            q = deque([(r, c)])
+            seen[r, c] = True
+            while q:
+                rr, cc = q.popleft()
+                for nr, nc in _neighbors(rr, cc, connectivity):
