                padding_connectivity=_GEN_PADDING_CONNECTIVITY,
            )
        except ValueError:
            return None
        _gen_paste(grid, patch, r, c)

    return grid


def generate_input() -> np.ndarray:
    for _ in range(_GEN_RETRY_LIMIT):
