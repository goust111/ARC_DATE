+def _bool_mask(rows: list[list[int]]) -> np.ndarray:
+    return np.array(rows, dtype=bool)
+
+
+ARROW_SPECS: dict[str, dict[str, object]] = {
+    "up": {
+        "mask": _bool_mask(
+            [
+                [0, 1, 0],
+                [1, 1, 1],
+                [0, 1, 0],
+                [0, 1, 0],
