+        view[mask] = patch[mask]
+    return grid
+
+
+def _blocked_from_layout(shape: tuple[int, int], arrows: list[dict[str, object]]) -> np.ndarray:
+    blocked = np.zeros(shape, dtype=bool)
+    blocked[0, :] = True
+    blocked[-1, :] = True
+    blocked[:, 0] = True
+    blocked[:, -1] = True
