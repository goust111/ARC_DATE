+            placed = {
+                "direction": direction,
+                "color": int(color),
+                "top": int(top),
+                "left": int(left),
+                "tip": (int(tip_r), int(tip_c)),
+                "vec": ARROW_SPECS[direction]["vec"],
+                "cells": cells,
+                "wall": wall,
+            }
+            arrows.append(placed)
+            _mark_padding(body_forbidden, cells, radius=1)
