+def _mark_padding(mask: np.ndarray, cells: set[tuple[int, int]], radius: int = 1) -> None:
+    height, width = mask.shape
+    for r, c in cells:
+        for dr in range(-radius, radius + 1):
+            for dc in range(-radius, radius + 1):
