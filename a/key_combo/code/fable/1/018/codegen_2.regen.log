    83	def main(grid: np.ndarray) -> np.ndarray:
    84	    """
    85	    Flood from the blue seed through black space, with every filled cell also activating its mirror across the central red axis.
    86	
    87	    Input structure:
    88	    - A full red row or column sits exactly at the center and splits the grid into two mirror halves.
    89	    - The background is black, several gray wall segments block motion, and the wall layouts differ across the axis.
    90	    - Exactly one blue seed pixel lies off the red axis.
    91	
    92	    Rule:
    93	    - Start from the blue seed and repeatedly add two kinds of cells until no new cell appears.
    94	    - Any filled cell may expand to its four-neighbor black cells, and its mirror position across the red axis is also filled when that mirrored cell is black.
    95	    - Recolor every finally reached cell blue; keep the red axis, gray walls, and all other cells unchanged.
    96	
    97	    Key insight:
    98	    - Mirroring creates wormhole links between the two halves, so regions can be opened on one side, explored there, and then mirrored back to unlock new rooms on the original side.
    99	    """
   100	    g = np.asarray(grid, dtype=int)
   101	    assert g.ndim == 2
   102	    assert max(g.shape) <= 30
   103	    assert set(map(int, np.unique(g))) <= {Color.BLACK, Color.BLUE, Color.RED, Color.GREY}
   104	
   105	    _find_axis(g)
   106	    fill = _wormhole_fill_mask(g)
   107	
   108	    out = g.copy()
   109	    out[fill] = Color.BLUE
   110	    return out
