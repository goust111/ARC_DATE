   130	    out = filled.copy()
   131	    for r, c in np.argwhere(filled):
   132	        mr, mc = _mirror_coord(g.shape, orientation, axis, int(r), int(c))
   133	        if g[mr, mc] == Color.BLACK:
   134	            out[mr, mc] = True
   135	    return out
