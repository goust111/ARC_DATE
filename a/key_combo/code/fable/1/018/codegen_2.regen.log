   115	    out = filled.copy()
   116	    q: deque[tuple[int, int]] = deque(map(tuple, np.argwhere(out)))
   117	
   118	    while q:
   119	        r, c = q.popleft()
   120	        for nr, nc in neighbors4(int(r), int(c)):
   121	            if in_bounds(g.shape, nr, nc) and g[nr, nc] == Color.BLACK and not out[nr, nc]:
   122	                out[nr, nc] = True
   123	                q.append((int(nr), int(nc)))
   124	    return out
