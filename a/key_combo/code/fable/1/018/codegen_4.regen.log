+
+def _neighbors4(r: int, c: int) -> list[tuple[int, int]]:
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def _bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _crop_mask(mask: np.ndarray) -> np.ndarray:
+    coords = np.argwhere(mask)
+    r0, c0, r1, c1 = _bbox_coords(coords)
+    return mask[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _component_dicts(mask: np.ndarray) -> list[dict]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while queue:
+                rr, cc = queue.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+            coord_arr = np.array(coords, dtype=int)
+            r0, c0, r1, c1 = _bbox_coords(coord_arr)
+            comp_mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+            comp_mask[coord_arr[:, 0] - r0, coord_arr[:, 1] - c0] = True
+            comps.append(
+                {
+                    "coords": coord_arr,
+                    "bbox": (r0, c0, r1, c1),
+                    "mask": comp_mask,
+                    "area": int(coord_arr.shape[0]),
