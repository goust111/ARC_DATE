+        sprite = np.zeros(mask.shape, dtype=int)
+
+        for r, c in coords:
+            best = min(
+                range(color_count),
+                key=lambda idx: (
+                    abs(r - anchors[idx][0]) + abs(c - anchors[idx][1]),
+                    anchor_indices[idx],
+                    anchors[idx][0],
+                    anchors[idx][1],
