+            frontier: set[tuple[int, int]] = set()
+            for r, c in cells:
+                for nr, nc in _neighbors4(r, c):
+                    if 0 <= nr < box_h and 0 <= nc < box_w and (nr, nc) not in cells:
+                        frontier.add((nr, nc))
+            if not frontier:
+                break
+            choice = list(frontier)[int(rng.integers(0, len(frontier)))]
+            cells.add(choice)
+        if len(cells) != area:
+            continue
