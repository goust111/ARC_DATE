+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, np.asarray(grid).ravel())).most_common(1)[0][0])
+
+
+def _neighbors4(r: int, c: int) -> list[tuple[int, int]]:
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    out: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                comp.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            out.append(sorted(comp))
+    return out
+
+
+def _segments(length: int, dividers: list[int]) -> list[tuple[int, int]]:
+    divs = sorted(int(x) for x in dividers)
+    segs: list[tuple[int, int]] = []
+    start = 0
+    for d in divs:
+        if start <= d - 1:
+            segs.append((start, d - 1))
+        start = d + 1
+    if start <= length - 1:
+        segs.append((start, length - 1))
+    return segs
+
+
+def _band_lookup(length: int, segments: list[tuple[int, int]]) -> list[int]:
+    band = [-1] * length
+    for idx, (a, b) in enumerate(segments):
+        for x in range(a, b + 1):
+            band[x] = idx
+    return band
+
