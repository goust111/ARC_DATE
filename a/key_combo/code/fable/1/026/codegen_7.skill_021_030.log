+def _is_singleton_pixel(grid: np.ndarray, r: int, c: int) -> bool:
+    val = int(grid[r, c])
+    for nr, nc in _neighbors4(r, c):
+        if 0 <= nr < grid.shape[0] and 0 <= nc < grid.shape[1] and int(grid[nr, nc]) == val:
