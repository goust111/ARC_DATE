+def _paint_local(out: np.ndarray, region_bbox: tuple[int, int, int, int], coords: list[tuple[int, int]], color: int) -> None:
+    r0, c0, r1, c1 = region_bbox
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
