+def _find_pairs(
+    grid: np.ndarray,
+    bg: int,
+    divider: int,
+    div_rows: list[int],
+    div_cols: list[int],
+    row_band: list[int],
+    col_band: list[int],
+) -> list[dict]:
+    h, w = grid.shape
+    div_row_set = set(div_rows)
+    div_col_set = set(div_cols)
+    pairs: list[dict] = []
+    used_regions: set[tuple[int, int]] = set()
+
+    for c in div_cols:
+        if c == 0 or c == w - 1:
+            continue
+        for r in range(h):
+            if r in div_row_set:
+                continue
+            lv = int(grid[r, c - 1])
+            rv = int(grid[r, c + 1])
+            if lv in (bg, divider) or rv in (bg, divider) or lv == rv:
+                continue
