+        r0, c0, r1, c1 = _bbox(coords)
+        norm = sorted((r - r0, c - c0) for r, c in coords)
+        rows = {r for r, _ in norm}
+        cols = {c for _, c in norm}
+        if len(rows) >= 2 and len(cols) >= 2:
