+def _extract_sprite(
+    grid: np.ndarray,
+    region_bbox: tuple[int, int, int, int],
+    bg: int,
+    divider: int,
+    messenger: tuple[int, int],
+) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = region_bbox
