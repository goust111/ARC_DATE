+    for r0, r1 in row_segments:
+        for c0, c1 in col_segments:
+            cell = grid[r0 : r1 + 1, c0 : c1 + 1]
+            if np.all(cell == _BLOCKER):
+                continue
+            counts.update(set(map(int, np.unique(cell))) - {_BLOCKER})
