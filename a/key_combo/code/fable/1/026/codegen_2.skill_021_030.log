+def _analyze_grid(grid: np.ndarray) -> dict:
+    divider_color, row_segments, col_segments = _find_divider_layout(grid)
+    bg = _infer_bg(grid, row_segments, col_segments)
+    blockers: set[tuple[int, int]] = set()
+    sprites: list[dict] = []
