+def _snake_cells(n_rows: int, n_cols: int) -> list[tuple[int, int]]:
+    order: list[tuple[int, int]] = []
+    for row in range(n_rows):
+        cols = range(n_cols) if row % 2 == 0 else range(n_cols - 1, -1, -1)
+        for col in cols:
+            order.append((row, col))
+    return order
