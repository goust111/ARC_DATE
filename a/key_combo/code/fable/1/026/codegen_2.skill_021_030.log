+        cursor = end + 1
+    if cursor < length:
+        pieces.append((cursor, length - 1))
+    return pieces
+
+
+def _find_divider_layout(grid: np.ndarray) -> tuple[int, list[tuple[int, int]], list[tuple[int, int]]]:
+    h, w = map(int, grid.shape)
