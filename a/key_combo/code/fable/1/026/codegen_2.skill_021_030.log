+    if not idxs:
+        return []
+    groups: list[tuple[int, int]] = []
+    start = idxs[0]
+    prev = idxs[0]
+    for idx in idxs[1:]:
+        if idx == prev + 1:
+            prev = idx
+            continue
+        groups.append((start, prev))
