+    for base in _SHAPES_BY_SIZE[pixels]:
+        for variant in _all_transforms(base):
+            h, w = map(int, variant.shape)
+            if h <= cell_h and w <= cell_w:
+                masks.append(variant)
+    if not masks:
+        return None
