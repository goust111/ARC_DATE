+        n_cols = int(rng.integers(4, 6))
+        max_h = min(5, (30 - (n_rows + 1)) // n_rows)
+        max_w = min(5, (30 - (n_cols + 1)) // n_cols)
+        if max_h < 4 or max_w < 4:
+            continue
+        cell_h = int(rng.integers(4, max_h + 1))
+        cell_w = int(rng.integers(4, max_w + 1))
