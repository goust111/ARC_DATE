+def _all_transforms(mask: np.ndarray) -> list[np.ndarray]:
+    variants: list[np.ndarray] = []
+    seen: set[bytes] = set()
+    for flip in (False, True):
+        arr = np.fliplr(mask) if flip else mask
+        for k in range(4):
+            rotated = np.rot90(arr, k)
+            key = rotated.tobytes()
+            if key in seen:
+                continue
+            seen.add(key)
+            variants.append(rotated.copy())
