+    mask = masks[int(rng.integers(0, len(masks)))]
+    mh, mw = map(int, mask.shape)
+    off_r = int(rng.integers(0, cell_h - mh + 1))
+    off_c = int(rng.integers(0, cell_w - mw + 1))
+
+    patch = np.full((cell_h, cell_w), _BG, dtype=int)
