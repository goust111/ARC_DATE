+    h = n_rows * cell_h + (n_rows + 1)
+    w = n_cols * cell_w + (n_cols + 1)
+    grid = np.full((h, w), _BG, dtype=int)
+    for r in range(0, h, cell_h + 1):
+        grid[r, :] = divider
