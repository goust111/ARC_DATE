+def _segments(length: int, groups: list[tuple[int, int]]) -> list[tuple[int, int]]:
+    pieces: list[tuple[int, int]] = []
+    cursor = 0
+    for start, end in groups:
+        if cursor < start:
+            pieces.append((cursor, start - 1))
+        cursor = end + 1
+    if cursor < length:
+        pieces.append((cursor, length - 1))
+    return pieces
