+        arr = np.fliplr(mask) if flip else mask
+        for k in range(4):
+            rotated = np.rot90(arr, k)
+            key = rotated.tobytes()
+            if key in seen:
+                continue
+            seen.add(key)
+            variants.append(rotated.copy())
+    return variants
