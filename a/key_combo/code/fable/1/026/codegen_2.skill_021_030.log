+        return None
+
+    for _ in range(500):
+        target = int(rng.integers(2, max_sprites + 1))
+        chosen: list[dict] = []
+        used_cells: set[tuple[int, int]] = set()
+        has_snake_counterexample = False
+        has_blocker_counterexample = False
