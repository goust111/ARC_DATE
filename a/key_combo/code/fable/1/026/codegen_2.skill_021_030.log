        r0, c0 = _cell_top_left(row, col, cell_h, cell_w)
        paste(grid, sprite["patch"], r0, c0)
    return grid


def _sample_layout(rng: np.random.Generator) -> tuple[int, int, int, int] | None:
    for _ in range(40):
        n_rows = int(rng.integers(3, 5))
        n_cols = int(rng.integers(4, 6))
