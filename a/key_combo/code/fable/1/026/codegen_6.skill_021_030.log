+        assignments: list[list[int]] = [[] for _ in patterns]
+        ok = True
+        for row_idx in sorted(range(len(patterns)), key=lambda i: row_needs[i], reverse=True):
+            need = row_needs[row_idx]
+            if need == 0:
+                continue
+
+            row_colors: list[int] = []
+            for _slot in range(need):
