+        uniques = [color for token, color in zip(pattern, sequence) if token == "U"]
+
+        start_col = wall_col - len(left_stack)
+        for offset, color in enumerate(left_stack):
+            out[r, start_col + offset] = color
+        if uniques:
+            out[r, wall_col + 1] = uniques[0]
+
+    return out
+
