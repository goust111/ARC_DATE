+            return False
+
+    return bool(np.array_equal(main(inp), expected))
+
+
+def _generate_case(rng: np.random.Generator) -> tuple[np.ndarray, np.ndarray] | None:
+    height = _randint(rng, *GRID_H_RANGE)
