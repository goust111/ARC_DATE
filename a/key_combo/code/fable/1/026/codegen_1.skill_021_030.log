+        if int(local_mask.sum()) == int(h * w) and np.all(local_grid != BG):
+            layers = extract_ring_layers(local_grid)
+            order = dedup_preserve(layers)
+            systems.append(
+                {
+                    "bbox": box,
+                    "patch": local_grid,
