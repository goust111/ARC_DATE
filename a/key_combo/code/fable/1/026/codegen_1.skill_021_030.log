+        max(max(key["patch"].shape) for key in keys),
+        int(np.ceil(np.sqrt(total_area * 1.8))),
+    )
+    canvas_h = int(np.clip(min_side + int(rng.integers(-1, 3)), 20, 30))
+    canvas_w = int(np.clip(min_side + int(rng.integers(-2, 4)), 20, 30))
