+def _spans_from_dividers(length: int, dividers: list[int]) -> list[tuple[int, int]]:
+    spans: list[tuple[int, int]] = []
+    start = 0
+    for cut in sorted(dividers):
+        if start <= cut - 1:
+            spans.append((start, cut - 1))
