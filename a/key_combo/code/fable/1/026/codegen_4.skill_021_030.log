+        if idx == min_idx:
+            tile = min_tile
+        elif idx == max_idx:
+            tile = max_tile
+        else:
+            tile = region["seed"]
+        patch = _tile_fill(region["shape"], tile)
+        r0, c0, r1, c1 = region["bbox"]
+        out[r0 : r1 + 1, c0 : c1 + 1] = patch
