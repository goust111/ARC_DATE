+    dividers: list[int] = []
+    cursor = 0
+    for i, size in enumerate(sizes):
+        start = cursor
+        end = start + int(size) - 1
+        spans.append((start, end))
+        cursor = end + 1
+        if i != len(sizes) - 1:
+            dividers.append(cursor)
+            cursor += 1
