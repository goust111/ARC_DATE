+                    "bbox": (r0, c0, r1, c1),
+                    "shape": (r1 - r0 + 1, c1 - c0 + 1),
+                    "area": int((r1 - r0 + 1) * (c1 - c0 + 1)),
+                    "color": int(color),
+                    "seed": tile,
+                }
