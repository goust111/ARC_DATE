+    assert guide_comp == (guide_r0, guide_c0, guide_r0 + 1, guide_c0 + 1)
+    assert guide_map == color_to_quadrant
+
+    out = main(grid)
+    assert np.array_equal(out, expected), "semantic oracle mismatch"
