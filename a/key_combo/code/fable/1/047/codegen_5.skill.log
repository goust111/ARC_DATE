+    for comp in find_components(grid, bg=bg, connectivity=4, monochromatic=False):
+        b = comp["bbox"]
+        if int(comp["area"]) != 4 or bbox_h(b) != 2 or bbox_w(b) != 2:
+            continue
+        block = crop_bbox(grid, b)
+        if block.shape != (2, 2) or np.any(block == bg):
