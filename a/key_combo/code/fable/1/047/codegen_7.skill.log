+        h, w = patch.shape
+        candidates = [
+            (r0, c0)
+            for r0 in range(body_h - h + 1)
+            for c0 in range(width - w + 1)
+            if _free_rect(occupied, r0, c0, h, w, gap=1)
+        ]
