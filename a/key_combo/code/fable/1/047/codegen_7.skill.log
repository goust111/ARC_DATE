+        return None
+
+    grid = np.full((body_h + 2, width), BG, dtype=int)
+    palette_start = random.randint(0, width - palette_len)
+    grid[0, palette_start:palette_start + palette_len] = np.array(palette, dtype=int)
+    grid[2:, :] = body
+
+    if not _semantic_ok(grid):
+        return None
+    return grid
