+
+
+def _build_patches(base_color: int, specs: list[dict]) -> list[dict]:
+    patches = []
+    for spec in specs:
+        marker_total = spec["gray"] + spec["orange"]
+        min_area = max(8, marker_total + random.randint(3, 6))
+        mask = _random_object_mask(min_area)
