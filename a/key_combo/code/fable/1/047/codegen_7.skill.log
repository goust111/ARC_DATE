+def _object_specs(palette_len: int, object_count: int) -> list[dict]:
+    zero_pair = random.randint(1, 2)
+    mixed_k = random.randint(1, max(1, palette_len - 1))
+    mixed_orange = random.randint(1, 2)
+    pure_k = palette_len
