+
+def _segment_points(start: tuple[int, int], delta: tuple[int, int]) -> list[tuple[int, int]]:
+    dr, dc = map(int, delta)
+    steps = abs(dr) + abs(dc)
+    step_r = 0 if dr == 0 else dr // abs(dr)
+    step_c = 0 if dc == 0 else dc // abs(dc)
+    sr, sc = map(int, start)
+    return [(sr + step_r * i, sc + step_c * i) for i in range(steps + 1)]
