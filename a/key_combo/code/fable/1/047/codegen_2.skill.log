+def _bar_midpoint(bar: dict) -> tuple[int, int]:
+    r0, c0, r1, c1 = map(int, bar["bbox"])
+    return (r0 + r1) // 2, (c0 + c1) // 2
+
+
+def _is_bar(comp: dict) -> bool:
+    h = bbox_h(comp["bbox"])
+    w = bbox_w(comp["bbox"])
