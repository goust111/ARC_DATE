+        for _idx in range(1, n_hit):
+            near.append(near[-1] + random.randint(4, 5))
+        aligns = [random.choice((-2, -1, 0)) for _ in range(n_hit)]
+        if len(set(aligns)) < 2:
+            continue
+
+        boxes: list[tuple[int, int, int, int]] = []
+        dr, dc = direction
+        for dist, align in zip(near, aligns):
+            if (dr, dc) == (0, 1):
