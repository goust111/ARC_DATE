+    for bar in bars:
+        mid = _bar_midpoint(bar)
+        bar_h = bbox_h(bar["bbox"])
+        bar_w = bbox_w(bar["bbox"])
+        for single in singles:
+            sr, sc = map(int, single["coords"][0])
+            dr = mid[0] - sr
+            dc = mid[1] - sc
+            if abs(dr) + abs(dc) != 1:
