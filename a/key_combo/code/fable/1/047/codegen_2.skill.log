        return False

    bitmask = np.zeros(_GEN_INPUT_SHAPE, dtype=bool)
    rows, cols = zip(*occupied)
    bitmask[rows, cols] = True
    return len(_gen_components_mask(bitmask, connectivity=4)) <= _GEN_MAX_COMPONENTS


