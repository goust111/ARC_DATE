+
+def _extract_scene(grid: np.ndarray) -> tuple[int, tuple[int, int], tuple[int, int], list[dict]]:
+    bg = get_bg(grid)
+    comps = find_components(
+        grid,
+        bg=bg,
+        connectivity=8,
+        monochromatic=True,
+        return_format="dict",
+    )
