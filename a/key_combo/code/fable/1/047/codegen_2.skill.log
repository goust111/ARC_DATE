_GEN_INPUT_SHAPE = (6, 6)
_GEN_OUTPUT_SHAPE = (5, 5)
_GEN_PATCH_SHAPE = (2, 2)
_GEN_INPUT_ANCHOR_ROWS = range(4)
_GEN_INPUT_ANCHOR_COLS = range(5)
_GEN_OUTPUT_ANCHORS = ((0, 0), (0, 3), (3, 0), (3, 3))

# Sprite masks and packing filters.
