+
+def _shift_box(box: tuple[int, int, int, int], origin: tuple[int, int]) -> tuple[int, int, int, int]:
+    sr, sc = map(int, origin)
+    r0, c0, r1, c1 = map(int, box)
+    return r0 + sr, c0 + sc, r1 + sr, c1 + sc
