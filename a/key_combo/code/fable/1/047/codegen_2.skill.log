+
+def _ray_hit_distance(start: tuple[int, int], direction: tuple[int, int], bbox: tuple[int, int, int, int]) -> int | None:
+    sr, sc = map(int, start)
+    dr, dc = map(int, direction)
+    r0, c0, r1, c1 = map(int, bbox)
+
+    if dr == 0:
+        if not (r0 <= sr <= r1):
+            return None
+        if dc == 1 and c0 > sc:
+            return c0 - sc
+        if dc == -1 and c1 < sc:
+            return sc - c1
+        return None
+
+    if not (c0 <= sc <= c1):
+        return None
+    if dr == 1 and r0 > sr:
+        return r0 - sr
+    if dr == -1 and r1 < sr:
+        return sr - r1
+    return None
