def _defect_bar_cells(coords: np.ndarray, rect: tuple[int, int, int, int]) -> set[tuple[int, int]]:
    object_cells = {tuple(map(int, p)) for p in coords}
    r0, c0, r1, c1 = rect
    rect_cells = {(r, c) for r in range(r0, r1 + 1) for c in range(c0, c1 + 1)}
    bars = set()

    for r, c in rect_cells - object_cells:
        side = _nearest_rect_side(r, c, rect)
        if side == "top":
            bars.update({(r - 1, c), (r, c)})
        elif side == "bottom":
            bars.update({(r, c), (r + 1, c)})
        elif side == "left":
            bars.update({(r, c - 1), (r, c)})
        else:
            bars.update({(r, c), (r, c + 1)})

    for r, c in object_cells - rect_cells:
        if r < r0:
            bars.update({(r, c), (r + 1, c)})
        elif r > r1:
            bars.update({(r - 1, c), (r, c)})
        elif c < c0:
            bars.update({(r, c), (r, c + 1)})
        else:
            assert c > c1
            bars.update({(r, c - 1), (r, c)})

    return bars


def main(grid: np.ndarray) -> np.ndarray:
    """Recolor the small defect bars on each shared-color object with the opposite panel color.

    Input structure
    - The grid contains two large panel colors and one shared object color.
    - Each shared-color object is a mostly solid rectangle inside exactly one panel.
    Rule
    - Find the near-solid rectangular core of each object.
    - Missing core pixels and one-cell protrusions define two-pixel bars perpendicular to the nearest core edge.
    - Recolor those bars with the other panel color; leave all other pixels unchanged.
    Key insight
    - The colors to add are not tied to numeric ids: each object's surrounding panel identifies the opposite panel color.
    """
    g = np.asarray(grid, dtype=int)
    out = g.copy()

    object_color, components, panel_colors = _object_components(g)
    for coords in components:
        neighbors = _neighbor_colors(g, coords, object_color)
        assert len(neighbors) == 1
        panel_color = next(iter(neighbors))
        target_colors = panel_colors - {panel_color}
        assert len(target_colors) == 1
        target_color = next(iter(target_colors))

        rect = _core_rect(coords)
        for r, c in _defect_bar_cells(coords, rect):
            assert 0 <= r < g.shape[0] and 0 <= c < g.shape[1]
            assert int(g[r, c]) in {object_color, panel_color}
            out[r, c] = target_color

    return out

# --------------- generator (att1) ---------------

# Palette and canvas bounds.
COLOR_IDS = list(range(10))
GRID_SIZE_MIN = 20
GRID_SIZE_MAX = 27

# Panel layout bounds and options.
MIN_PANEL_DIM = 9
MIN_VISIBLE_BORDERS = 2
BORDER_CHOICES = (0, 1)
OFFSET_MIN = 2
OFFSET_MAX = 6
HORIZONTAL_LAYOUT = 0
VERTICAL_LAYOUT = 1
HORIZONTAL_OFFSETS = ("left", "right", "none")
VERTICAL_OFFSETS = ("top", "bottom", "none")

# Object geometry and placement constraints.
OBJECTS_PER_PANEL = (1, 2)
CORE_H_MIN = 3
CORE_H_MAX = 7
CORE_W_MIN = 3
CORE_W_MAX = 9
DEFECT_COUNT_MIN = 1
DEFECT_COUNT_MAX = 3
DEFECT_SIDES = ("top", "bottom", "left", "right")
DEFECT_TYPES = ("missing", "protrusion")
PANEL_MARGIN = 1
OBJECT_GAP = 2
MAX_PLACE_TRIES = 30

# Generation retry budget.
MAX_GENERATE_ATTEMPTS = 300


def _choose_palette() -> tuple[int, int, int, int]:
    colors = COLOR_IDS[:]
    random.shuffle(colors)
    return tuple(colors[:4])


def _choose_borders() -> tuple[int, int, int, int]:
    borders = [random.choice(BORDER_CHOICES) for _ in range(4)]
    while sum(borders) < MIN_VISIBLE_BORDERS:
        borders[random.randint(0, 3)] = 1
    return tuple(borders)


def _build_horizontal_panels(
    grid: np.ndarray,
    panel_a_color: int,
    panel_b_color: int,
) -> list[tuple[int, int, int, int, int]] | None:
    """Create two panels sharing a horizontal border; returns panel records."""
    H, W = grid.shape
    split_r = random.randint(MIN_PANEL_DIM, H - MIN_PANEL_DIM - 1)
    border_top, border_bot, border_left, border_right = _choose_borders()

    pa_height = split_r - border_top
    pb_height = H - border_bot - split_r
    if pa_height < MIN_PANEL_DIM or pb_height < MIN_PANEL_DIM:
        return None

    offset_side = random.choice(HORIZONTAL_OFFSETS)
    if offset_side == "none":
        pa_c0, pa_c1 = border_left, W - 1 - border_right
        pb_c0, pb_c1 = border_left, W - 1 - border_right
    elif offset_side == "left":
        offset_cols = random.randint(OFFSET_MIN, min(OFFSET_MAX, W - 2 * MIN_PANEL_DIM))
        if random.random() < 0.5:
            pa_c0 = border_left
            pa_c1 = W - 1 - border_right
            pb_c0 = border_left + offset_cols
            pb_c1 = W - 1 - border_right
        else:
            pa_c0 = border_left + offset_cols
            pa_c1 = W - 1 - border_right
            pb_c0 = border_left
            pb_c1 = W - 1 - border_right
    else:
        offset_cols = random.randint(OFFSET_MIN, min(OFFSET_MAX, W - 2 * MIN_PANEL_DIM))
        if random.random() < 0.5:
            pa_c0 = border_left
            pa_c1 = W - 1 - border_right - offset_cols
            pb_c0 = border_left
            pb_c1 = W - 1 - border_right
        else:
            pa_c0 = border_left
            pa_c1 = W - 1 - border_right
            pb_c0 = border_left
            pb_c1 = W - 1 - border_right - offset_cols

    if pa_c1 - pa_c0 + 1 < MIN_PANEL_DIM or pb_c1 - pb_c0 + 1 < MIN_PANEL_DIM:
        return None
    if min(pa_c1, pb_c1) < max(pa_c0, pb_c0):
        return None

    pa_r0, pa_r1 = border_top, split_r - 1
    pb_r0, pb_r1 = split_r, H - 1 - border_bot
    grid[pa_r0:pa_r1 + 1, pa_c0:pa_c1 + 1] = panel_a_color
    grid[pb_r0:pb_r1 + 1, pb_c0:pb_c1 + 1] = panel_b_color
    return [
        (panel_a_color, pa_r0, pa_r1, pa_c0, pa_c1),
        (panel_b_color, pb_r0, pb_r1, pb_c0, pb_c1),
    ]


def _build_vertical_panels(
    grid: np.ndarray,
    panel_a_color: int,
    panel_b_color: int,
) -> list[tuple[int, int, int, int, int]] | None:
    """Create two panels sharing a vertical border; returns panel records."""
    H, W = grid.shape
    split_c = random.randint(MIN_PANEL_DIM, W - MIN_PANEL_DIM - 1)
    border_top, border_bot, border_left, border_right = _choose_borders()

    pa_width = split_c - border_left
    pb_width = W - border_right - split_c
    if pa_width < MIN_PANEL_DIM or pb_width < MIN_PANEL_DIM:
        return None

    offset_side = random.choice(VERTICAL_OFFSETS)
    if offset_side == "none":
        pa_r0, pa_r1 = border_top, H - 1 - border_bot
        pb_r0, pb_r1 = border_top, H - 1 - border_bot
    elif offset_side == "top":
        offset_rows = random.randint(OFFSET_MIN, min(OFFSET_MAX, H - 2 * MIN_PANEL_DIM))
        if random.random() < 0.5:
            pa_r0, pa_r1 = border_top, H - 1 - border_bot
            pb_r0, pb_r1 = border_top + offset_rows, H - 1 - border_bot
        else:
            pa_r0, pa_r1 = border_top + offset_rows, H - 1 - border_bot
            pb_r0, pb_r1 = border_top, H - 1 - border_bot
    else:
        offset_rows = random.randint(OFFSET_MIN, min(OFFSET_MAX, H - 2 * MIN_PANEL_DIM))
        if random.random() < 0.5:
            pa_r0, pa_r1 = border_top, H - 1 - border_bot - offset_rows
            pb_r0, pb_r1 = border_top, H - 1 - border_bot
        else:
            pa_r0, pa_r1 = border_top, H - 1 - border_bot
            pb_r0, pb_r1 = border_top, H - 1 - border_bot - offset_rows

    pa_c0, pa_c1 = border_left, split_c - 1
    pb_c0, pb_c1 = split_c, W - 1 - border_right
    if pa_r1 - pa_r0 + 1 < MIN_PANEL_DIM or pb_r1 - pb_r0 + 1 < MIN_PANEL_DIM:
        return None
    if min(pa_r1, pb_r1) < max(pa_r0, pb_r0):
        return None

    grid[pa_r0:pa_r1 + 1, pa_c0:pa_c1 + 1] = panel_a_color
    grid[pb_r0:pb_r1 + 1, pb_c0:pb_c1 + 1] = panel_b_color
    return [
        (panel_a_color, pa_r0, pa_r1, pa_c0, pa_c1),
        (panel_b_color, pb_r0, pb_r1, pb_c0, pb_c1),
    ]


def _make_panel_grid(
    panel_a_color: int,
    panel_b_color: int,
    bg_color: int,
) -> tuple[np.ndarray, list[tuple[int, int, int, int, int]]] | None:
    """Sample the canvas and panel layout."""
    H = random.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)
    W = random.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)
    grid = np.full((H, W), bg_color, dtype=int)

    orientation = random.randint(HORIZONTAL_LAYOUT, VERTICAL_LAYOUT)
    if orientation == HORIZONTAL_LAYOUT:
        panels = _build_horizontal_panels(grid, panel_a_color, panel_b_color)
    else:
        panels = _build_vertical_panels(grid, panel_a_color, panel_b_color)
    if panels is None:
        return None
    return grid, panels


def _object_overlaps(full_bbox: tuple[int, int, int, int], placed_bboxes: list[tuple[int, int, int, int]]) -> bool:
    full_r0, full_r1, full_c0, full_c1 = full_bbox
    for br0, br1, bc0, bc1 in placed_bboxes:
        if (
            full_r0 - OBJECT_GAP <= br1
            and full_r1 + OBJECT_GAP >= br0
            and full_c0 - OBJECT_GAP <= bc1
            and full_c1 + OBJECT_GAP >= bc0
        ):
            return True
    return False


def _place_core(
    panel_bbox: tuple[int, int, int, int],
    core_h: int,
    core_w: int,
    sides: list[str],
    placed_bboxes: list[tuple[int, int, int, int]],
) -> tuple[tuple[int, int, int, int], tuple[int, int, int, int]] | None:
    """Find a non-overlapping core bbox and its full bbox including bars."""
    pr0, pr1, pc0, pc1 = panel_bbox
    extra_top = 1 if "top" in sides else 0
    extra_bot = 1 if "bottom" in sides else 0
    extra_left = 1 if "left" in sides else 0
    extra_right = 1 if "right" in sides else 0

    place_r0 = pr0 + PANEL_MARGIN + extra_top
    place_r1 = pr1 - PANEL_MARGIN - extra_bot - core_h + 1
    place_c0 = pc0 + PANEL_MARGIN + extra_left
    place_c1 = pc1 - PANEL_MARGIN - extra_right - core_w + 1
    if place_r1 < place_r0 or place_c1 < place_c0:
        return None

    for _ in range(MAX_PLACE_TRIES):
        cr0 = random.randint(place_r0, place_r1)
        cc0 = random.randint(place_c0, place_c1)
        cr1 = cr0 + core_h - 1
        cc1 = cc0 + core_w - 1
        full_bbox = (cr0 - extra_top, cr1 + extra_bot, cc0 - extra_left, cc1 + extra_right)
        if not _object_overlaps(full_bbox, placed_bboxes):
            return (cr0, cr1, cc0, cc1), full_bbox
    return None


def _apply_defect(
    input_grid: np.ndarray,
    output_grid: np.ndarray,
    core_bbox: tuple[int, int, int, int],
    side: str,
    defect_type: str,
    panel_color: int,
    obj_color: int,
    other_panel_color: int,
) -> bool:
    """Apply one sampled input defect and its two-cell output bar."""
    cr0, cr1, cc0, cc1 = core_bbox
    if side == "top":
        if defect_type == "missing":
            valid_cols = list(range(cc0 + 1, cc1))
            if not valid_cols:
                return False
            dc = random.choice(valid_cols)
            dr = cr0
            input_grid[dr, dc] = panel_color
            output_grid[dr - 1, dc] = other_panel_color
            output_grid[dr, dc] = other_panel_color
        else:
            dc = random.randint(cc0, cc1)
            dr = cr0 - 1
            input_grid[dr, dc] = obj_color
            output_grid[dr, dc] = other_panel_color
            output_grid[dr + 1, dc] = other_panel_color
    elif side == "bottom":
        if defect_type == "missing":
            valid_cols = list(range(cc0 + 1, cc1))
            if not valid_cols:
                return False
            dc = random.choice(valid_cols)
            dr = cr1
            input_grid[dr, dc] = panel_color
            output_grid[dr, dc] = other_panel_color
            output_grid[dr + 1, dc] = other_panel_color
        else:
            dc = random.randint(cc0, cc1)
            dr = cr1 + 1
            input_grid[dr, dc] = obj_color
            output_grid[dr, dc] = other_panel_color
            output_grid[dr - 1, dc] = other_panel_color
    elif side == "left":
        if defect_type == "missing":
            valid_rows = list(range(cr0 + 1, cr1))
            if not valid_rows:
                return False
            dr = random.choice(valid_rows)
            dc = cc0
            input_grid[dr, dc] = panel_color
            output_grid[dr, dc] = other_panel_color
            output_grid[dr, dc - 1] = other_panel_color
        else:
            dr = random.randint(cr0, cr1)
            dc = cc0 - 1
            input_grid[dr, dc] = obj_color
            output_grid[dr, dc] = other_panel_color
            output_grid[dr, dc + 1] = other_panel_color
    else:
        if defect_type == "missing":
            valid_rows = list(range(cr0 + 1, cr1))
            if not valid_rows:
                return False
            dr = random.choice(valid_rows)
            dc = cc1
            input_grid[dr, dc] = panel_color
            output_grid[dr, dc] = other_panel_color
            output_grid[dr, dc + 1] = other_panel_color
        else:
            dr = random.randint(cr0, cr1)
            dc = cc1 + 1
            input_grid[dr, dc] = obj_color
            output_grid[dr, dc] = other_panel_color
            output_grid[dr, dc - 1] = other_panel_color
    return True


def _place_panel_objects(
    input_grid: np.ndarray,
    output_grid: np.ndarray,
    panel: tuple[int, int, int, int, int],
    n_objs: int,
    obj_color: int,
    other_panel_color: int,
) -> bool:
    """Place all objects for one panel into input and output grids."""
    panel_color, pr0, pr1, pc0, pc1 = panel
    avail_r0 = pr0 + PANEL_MARGIN
    avail_r1 = pr1 - PANEL_MARGIN
    avail_c0 = pc0 + PANEL_MARGIN
    avail_c1 = pc1 - PANEL_MARGIN
    placed_bboxes = []

    for _ in range(n_objs):
        core_h = random.randint(CORE_H_MIN, min(CORE_H_MAX, avail_r1 - avail_r0 - 2))
        core_w = random.randint(CORE_W_MIN, min(CORE_W_MAX, avail_c1 - avail_c0 - 2))
        if core_h < CORE_H_MIN or core_w < CORE_W_MIN:
            return False

        n_defects = random.randint(DEFECT_COUNT_MIN, DEFECT_COUNT_MAX)
        sides = random.sample(DEFECT_SIDES, n_defects)
        defect_types = [random.choice(DEFECT_TYPES) for _ in range(n_defects)]

        placed = _place_core((pr0, pr1, pc0, pc1), core_h, core_w, sides, placed_bboxes)
        if placed is None:
            return False
        core_bbox, full_bbox = placed
        placed_bboxes.append(full_bbox)

        cr0, cr1, cc0, cc1 = core_bbox
        output_grid[cr0:cr1 + 1, cc0:cc1 + 1] = obj_color
        input_grid[cr0:cr1 + 1, cc0:cc1 + 1] = obj_color

        for side, defect_type in zip(sides, defect_types):
            if not _apply_defect(
                input_grid,
                output_grid,
                core_bbox,
                side,
                defect_type,
                panel_color,
                obj_color,
                other_panel_color,
            ):
                return False
    return True


def _gen_attempt() -> np.ndarray | None:
    obj_color, panel_a_color, panel_b_color, bg_color = _choose_palette()
    layout = _make_panel_grid(panel_a_color, panel_b_color, bg_color)
    if layout is None:
        return None
    grid, panels = layout

    n_obj_a = random.choice(OBJECTS_PER_PANEL)
    n_obj_b = random.choice(OBJECTS_PER_PANEL)
    if not 2 <= n_obj_a + n_obj_b <= 4:
        return None

    output_grid = grid.copy()
    input_grid = grid.copy()
    object_counts = (n_obj_a, n_obj_b)
    other_colors = (panel_b_color, panel_a_color)

    for panel, n_objs, other_panel_color in zip(panels, object_counts, other_colors):
        if not _place_panel_objects(
            input_grid,
            output_grid,
            panel,
            n_objs,
            obj_color,
            other_panel_color,
        ):
            return None

    # Verify: run solver on input and check it produces the output
    try:
        result = main(input_grid)
        if np.array_equal(result, output_grid):
            return input_grid
    except (AssertionError, IndexError, ValueError):
        pass

    return None


def generate_input() -> np.ndarray:
    for _ in range(MAX_GENERATE_ATTEMPTS):
        result = _gen_attempt()
        if result is not None:
            return result
    raise RuntimeError(f"Failed to generate valid input after {MAX_GENERATE_ATTEMPTS} attempts")
from __future__ import annotations

import numpy as np

from arc_utils import find_components, get_bg
import itertools
import math
import random


def _find_marker_bar(g: np.ndarray, bg: int) -> tuple[int, str, tuple[int, int]]:
    colors = [int(color) for color in np.unique(g) if int(color) != int(bg)]
    candidates: list[tuple[int, str, tuple[int, int]]] = []

    for color in colors:
        coords = np.argwhere(g == int(color))
        if coords.shape[0] != 3:
            continue

        rows = sorted(set(map(int, coords[:, 0])))
        cols = sorted(set(map(int, coords[:, 1])))
        if len(rows) == 1 and len(cols) == 3 and cols == list(range(cols[0], cols[0] + 3)):
            candidates.append((int(color), "horizontal", (rows[0], cols[1])))
        elif len(cols) == 1 and len(rows) == 3 and rows == list(range(rows[0], rows[0] + 3)):
            candidates.append((int(color), "vertical", (rows[1], cols[0])))

    assert len(candidates) == 1, "expected a unique three-pixel marker bar"
    return candidates[0]


def _roles(g: np.ndarray) -> tuple[int, int, tuple[int, int], tuple[int, int]]:
    bg = get_bg(g)
    colors = [int(color) for color in np.unique(g) if int(color) != int(bg)]
    assert len(colors) == 3, "expected target color, marker bar color, and control-pixel color"

    bar_color, axis, center = _find_marker_bar(g, bg)
    control_candidates: list[tuple[int, tuple[int, int]]] = []
    for color in colors:
        if int(color) == int(bar_color):
            continue
        coords = np.argwhere(g == int(color))
        if coords.shape[0] != 1:
            continue
        r, c = map(int, coords[0])
        if abs(r - center[0]) + abs(c - center[1]) == 1:
            control_candidates.append((int(color), (r, c)))

    assert len(control_candidates) == 1, "expected one singleton control pixel adjacent to the bar center"
    control_color, control = control_candidates[0]

    target_colors = [color for color in colors if color not in (bar_color, control_color)]
    assert len(target_colors) == 1, "expected one remaining target color"

    dr = center[0] - control[0]
    dc = center[1] - control[1]
    assert abs(dr) + abs(dc) == 1, "control pixel must touch the marker bar center"
    if axis == "horizontal":
        assert dc == 0, "horizontal marker bars emit vertically"
    else:
        assert dr == 0, "vertical marker bars emit horizontally"

    return int(bg), int(target_colors[0]), center, (dr, dc)


def main(grid: np.ndarray) -> np.ndarray:
    """
    Erase each target-color object crossed by the ray pointed by the bar-and-control marker.

    Input structure:
    - The background is the dominant color.
    - There is one three-pixel straight marker bar and one singleton control pixel adjacent to the bar center.
    - The remaining non-background color forms multiple 4-connected target objects.

    Rule:
    - Cast a straight ray from the marker bar center in the direction away from the adjacent control pixel.
    - Find every 4-connected target-color object that intersects that ray.
    - Recolor all pixels of those hit target objects to the background; all other pixels stay unchanged.

    Key insight:
    - The whole object is erased when the center ray touches any of its pixels; the full marker bar width is not swept.
    """
    g = np.asarray(grid, dtype=int)
    bg, target_color, center, step = _roles(g)
    height, width = g.shape

    ray: set[tuple[int, int]] = set()
    r = center[0] + step[0]
    c = center[1] + step[1]
    while 0 <= r < height and 0 <= c < width:
        ray.add((int(r), int(c)))
        r += step[0]
        c += step[1]

    target_objects = find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[target_color])
    hit_objects = [
        obj
        for obj in target_objects
        if any(tuple(map(int, coord)) in ray for coord in obj["coords"])
    ]
    assert hit_objects, "expected at least one target object intersecting the marker ray"

    out = g.copy()
    for obj in hit_objects:
        coords = obj["coords"]
        out[coords[:, 0], coords[:, 1]] = int(bg)
    return out

# --------------- generator (o5x) ---------------

# Palette.
BG = 7
TARGET = 4
BAR = 5
CONTROL = 9

# Canvas size bounds.
HEIGHT_MIN, HEIGHT_MAX = 9, 14
WIDTH_MIN, WIDTH_MAX = 10, 13

# Marker and ray geometry.
BAR_CENTER_MARGIN = 2
RAY_LEN_MIN, RAY_LEN_MAX = 6, 8
NEIGHBOR_STEPS_4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
AXIS_HORIZONTAL, AXIS_VERTICAL = "horizontal", "vertical"

# Target component counts, density, and size caps.
DENSITY_MIN, DENSITY_MAX = 0.17, 0.21
OBJECT_COUNT_MIN, OBJECT_COUNT_MAX = 10, 18
EXPECTED_HIT_OBJECTS, CONNECTIVITY = 2, 4
HIT_EXTRA_CAP, NON_HIT_EXTRA_CAP = 6, 4

# Retry budget for rejection sampling.
GENERATION_ATTEMPTS = 300


def _neighbors4(r: int, c: int, h: int, w: int) -> list[tuple[int, int]]:
    out: list[tuple[int, int]] = []
    for dr, dc in NEIGHBOR_STEPS_4:
        rr, cc = r + dr, c + dc
        if 0 <= rr < h and 0 <= cc < w:
            out.append((rr, cc))
    return out


def _ray_cells(center: tuple[int, int], step: tuple[int, int], h: int, w: int) -> list[tuple[int, int]]:
    r, c = center[0] + step[0], center[1] + step[1]
    cells: list[tuple[int, int]] = []
    while 0 <= r < h and 0 <= c < w:
        cells.append((r, c))
        r += step[0]
        c += step[1]
    return cells


def _marker_candidates(
    h: int,
    w: int,
) -> list[tuple[str, tuple[int, int], tuple[int, int], tuple[int, int]]]:
    candidates: list[tuple[str, tuple[int, int], tuple[int, int], tuple[int, int]]] = []

    for length in range(RAY_LEN_MIN, RAY_LEN_MAX + 1):
        for c in range(BAR_CENTER_MARGIN, w - BAR_CENTER_MARGIN):
            if 1 <= length <= h - 2:
                candidates.append((AXIS_HORIZONTAL, (length, c), (-1, 0), (length + 1, c)))
            r = h - 1 - length
            if 1 <= r <= h - 2:
                candidates.append((AXIS_HORIZONTAL, (r, c), (1, 0), (r - 1, c)))

        for r in range(BAR_CENTER_MARGIN, h - BAR_CENTER_MARGIN):
            if 1 <= length <= w - 2:
                candidates.append((AXIS_VERTICAL, (r, length), (0, -1), (r, length + 1)))
            c = w - 1 - length
            if 1 <= c <= w - 2:
                candidates.append((AXIS_VERTICAL, (r, c), (0, 1), (r, c - 1)))

    return candidates


def _bar_cells(axis: str, center: tuple[int, int]) -> list[tuple[int, int]]:
    r, c = center
    if axis == AXIS_HORIZONTAL:
        return [(r, c - 1), (r, c), (r, c + 1)]
    return [(r - 1, c), (r, c), (r + 1, c)]


def _place_marker(g: np.ndarray) -> tuple[tuple[int, int], tuple[int, int], set[tuple[int, int]], list[tuple[int, int]]] | None:
    """Draw one marker and return center, ray step, occupied marker cells, and ray cells."""
    h, w = g.shape
    candidates = _marker_candidates(h, w)
    if not candidates:
        return None

    axis, center, step, control = random.choice(candidates)
    marker: set[tuple[int, int]] = {control}
    bar_cells = _bar_cells(axis, center)
    marker.update(bar_cells)

    for rr, cc in bar_cells:
        g[rr, cc] = BAR
    g[control] = CONTROL
    return center, step, marker, _ray_cells(center, step, h, w)


def _feasible_size_choices(area: int) -> list[tuple[int, int, int]]:
    lo = math.ceil(area * DENSITY_MIN)
    hi = math.floor(area * DENSITY_MAX)
    choices: list[tuple[int, int, int]] = []
    for total_pixels in range(lo, hi + 1):
        for count in range(OBJECT_COUNT_MIN, OBJECT_COUNT_MAX + 1):
            if count > total_pixels:
                continue
            extras = total_pixels - count
            caps = [HIT_EXTRA_CAP] * EXPECTED_HIT_OBJECTS + [NON_HIT_EXTRA_CAP] * (count - EXPECTED_HIT_OBJECTS)
            max_clustered = (count - 1) // EXPECTED_HIT_OBJECTS
            for clustered in range(max_clustered + 1):
                if clustered > extras:
                    continue
                if extras <= sum(sorted(caps, reverse=True)[:clustered]):
                    choices.append((total_pixels, count, clustered))
    return choices


def _choose_sizes(area: int) -> tuple[list[int], list[int]] | None:
    choices = _feasible_size_choices(area)
    if not choices:
        return None

    total_pixels, count, clustered = random.choice(choices)
    extras = total_pixels - count
    caps = [HIT_EXTRA_CAP] * EXPECTED_HIT_OBJECTS + [NON_HIT_EXTRA_CAP] * (count - EXPECTED_HIT_OBJECTS)

    if clustered == 0:
        if extras != 0:
            return None
        return [1] * EXPECTED_HIT_OBJECTS, [1] * (count - EXPECTED_HIT_OBJECTS)

    combos = [
        combo
        for combo in itertools.combinations(range(count), clustered)
        if extras <= sum(caps[i] for i in combo)
    ]
    if not combos:
        return None

    chosen = random.choice(combos)
    sizes = [1] * count
    for idx in chosen:
        sizes[idx] += 1
    remaining = extras - clustered

    while remaining > 0:
        available = [idx for idx in chosen if sizes[idx] < caps[idx] + 1]
        if not available:
            return None
        idx = random.choice(available)
        sizes[idx] += 1
        remaining -= 1

    return sizes[:EXPECTED_HIT_OBJECTS], sizes[EXPECTED_HIT_OBJECTS:]


def _touches_existing_target(
    r: int,
    c: int,
    existing: np.ndarray,
    current: set[tuple[int, int]],
) -> bool:
    h, w = existing.shape
    for rr, cc in _neighbors4(r, c, h, w):
        if existing[rr, cc] and (rr, cc) not in current:
            return True
    return False


def _place_object(
    g: np.ndarray,
    size: int,
    forbidden: set[tuple[int, int]],
    seed_pool: list[tuple[int, int]] | None = None,
) -> set[tuple[int, int]] | None:
    """Grow one 4-connected target object without 4-touching prior target objects."""
    h, w = g.shape
    existing = g == TARGET

    if seed_pool is None:
        seed_pool = [(r, c) for r in range(h) for c in range(w)]

    seeds = [
        (r, c)
        for r, c in seed_pool
        if (r, c) not in forbidden
        and g[r, c] == BG
        and not _touches_existing_target(r, c, existing, set())
    ]
    if not seeds:
        return None

    current = {random.choice(seeds)}
    while len(current) < size:
        frontier: set[tuple[int, int]] = set()
        for r, c in current:
            frontier.update(_neighbors4(r, c, h, w))

        options = [
            (r, c)
            for r, c in frontier
            if (r, c) not in current
            and (r, c) not in forbidden
            and g[r, c] == BG
            and not _touches_existing_target(r, c, existing, current)
        ]
        if not options:
            return None
        current.add(random.choice(options))

    for r, c in current:
        g[r, c] = TARGET
    return current


def _hit_count(g: np.ndarray, ray: set[tuple[int, int]]) -> int:
    objects = find_components(g, bg=BG, connectivity=CONNECTIVITY, monochromatic=True, colors=[TARGET])
    return sum(any((int(r), int(c)) in ray for r, c in obj["coords"]) for obj in objects)


def _place_objects(
    g: np.ndarray,
    sizes: list[int],
    forbidden: set[tuple[int, int]],
    seed_pool: list[tuple[int, int]] | None = None,
) -> bool:
    for size in sorted(sizes, reverse=True):
        if _place_object(g, size, forbidden, seed_pool) is None:
            return False
    return True


def _valid_generated_pair(inp: np.ndarray, out: np.ndarray, ray: set[tuple[int, int]]) -> bool:
    objects = find_components(inp, bg=BG, connectivity=CONNECTIVITY, monochromatic=True, colors=[TARGET])
    density = float(np.count_nonzero(inp == TARGET)) / inp.size
    if len(objects) < OBJECT_COUNT_MIN or len(objects) > OBJECT_COUNT_MAX:
        return False
    if not (DENSITY_MIN <= density <= DENSITY_MAX):
        return False
    if _hit_count(inp, ray) != EXPECTED_HIT_OBJECTS:
        return False

    try:
        actual = main(inp)
    except Exception:
        return False
    return np.array_equal(actual, out)


def _gen_attempt() -> np.ndarray | None:
    h = random.randint(HEIGHT_MIN, HEIGHT_MAX)
    w = random.randint(WIDTH_MIN, WIDTH_MAX)
    out = np.full((h, w), BG, dtype=int)

    marker = _place_marker(out)
    if marker is None:
        return None
    _, _, marker_cells, ray_cells = marker
    ray = set(ray_cells)

    sizes = _choose_sizes(out.size)
    if sizes is None:
        return None
    hit_sizes, non_hit_sizes = sizes

    blocked_for_output = marker_cells | ray
    if not _place_objects(out, non_hit_sizes, blocked_for_output):
        return None

    inp = out.copy()
    if not _place_objects(inp, hit_sizes, marker_cells, ray_cells):
        return None

    if not _valid_generated_pair(inp, out, ray):
        return None

    return inp


def generate_input() -> np.ndarray:
    for _ in range(GENERATION_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid 2f767503 input")
from __future__ import annotations
import numpy as np
from arc_utils import bbox_h, bbox_w, find_components, get_bg
import random


def find_full_height_constant_col(grid: np.ndarray, *, bg: int | None = None) -> tuple[int | None, int | None]:
    """
    Local helper (only used by this solver): find a column where all values are identical and != bg.
    Returns (col_idx, color) or (None, None).
    """
    H, W = grid.shape
    if bg is None:
        bg = get_bg(grid)
    bg = int(bg)

    for c in range(int(W)):
        col = grid[:, int(c)]
        if (col == col[0]).all() and int(col[0]) != bg:
            return int(c), int(col[0])
    return None, None


def main(grid: np.ndarray) -> np.ndarray:
    """
    Draw a polyline by decoding 3x3 glyph instructions read across a divided grid.

    Input structure:
    - Left of a full-height vertical divider: 3x3 colored glyphs on bg.
    - Right of divider: a single gray (5) start pixel.

    Rule:
    - Remove the divider; shift the gray start into the left canvas.
    - Read glyphs in column-major order (left→right, top→bottom).
    - Each glyph's shape (pixel area) encodes a segment: area 4 → down 2, area 5 → right 3, area 6 → left 4, area 7 → left 2.
    - Append segments sequentially, stepping down one cell between each.

    Key insight: Glyph pixel count (area) uniquely determines both segment length and direction — the shape itself is the instruction.
    """
    g = np.array(grid, dtype=int)
    H, W = g.shape
    bg = int(get_bg(g))

    # Divider is a full-height constant non-bg column.
    div_c, div_color = find_full_height_constant_col(g, bg=bg)
    assert div_c is not None

    out = np.zeros((H, int(div_c)), dtype=int)

    # Move gray start from right side into left canvas (remove divider col too).
    gray = np.argwhere(g == 5)
    if gray.size == 0:
        return out
    r_cur, c_cur = map(int, gray[0])
    c_cur = int(c_cur - (int(div_c) + 1))
    if not (0 <= c_cur < int(div_c)):
        return out
    out[int(r_cur), int(c_cur)] = 5

    # Collect 3x3 glyph components on the left.
    left = g[:, : int(div_c)]
    ignore = {int(bg), 5}
    if div_color is not None:
        ignore.add(int(div_color))

    glyphs: list[dict[str, int]] = []
    for comp in find_components(left, bg=bg, connectivity=8, monochromatic=True, return_format="dict"):
        col = int(comp["color"])
        if col in ignore:
            continue
        b = comp["bbox"]
        if bbox_h(b) == 3 and bbox_w(b) == 3:
            r0, c0, _r1, _c1 = map(int, b)
            glyphs.append({"color": int(col), "r0": int(r0), "c0": int(c0), "area": int(comp["area"])})

    glyphs.sort(key=lambda d: (int(d["c0"]), int(d["r0"])))

    area_to_len = {4: 2, 5: 3, 6: 4, 7: 2}
    area_to_dir = {5: 1, 6: -1, 7: -1}  # diamond right; cross/U left

    for glyph in glyphs:
        color = int(glyph["color"])
        area = int(glyph["area"])
        seg_len = int(area_to_len.get(area, 2))

        r_cur = int(r_cur + 1)
        assert r_cur < H, f"segment exits bottom: r_cur={r_cur}, H={H}"
        out[r_cur, int(c_cur)] = color

        if area == 4:  # vertical (down)
            end_r = r_cur + (seg_len - 1)
            assert end_r < H, f"vertical segment exits bottom: end_r={end_r}, H={H}"
            for _ in range(seg_len - 1):
                r_cur = int(r_cur + 1)
                out[r_cur, int(c_cur)] = color
        else:  # horizontal
            dir_h = int(area_to_dir.get(area, 1))
            end_c = int(c_cur) + dir_h * (seg_len - 1)
            assert 0 <= end_c < int(div_c), (
                f"horizontal segment exits canvas: c_cur={c_cur}, dir={dir_h}, "
                f"seg_len={seg_len}, div_c={div_c}"
            )
            for _ in range(seg_len - 1):
                c_cur = int(c_cur + dir_h)
                out[r_cur, c_cur] = color

    return out

# --------------- generator (attempt 1 (Claude)) ---------------

# --- canvas geometry ---
N_MIN, N_MAX = 2, 5            # number of tile rows; H = 4*N - 1, num_glyphs = 2*N
GRID_W = 15                    # full input width
DIVIDER_COL = 7                # divider position (col), full-height
DIVIDER_COLOR = 4              # divider fill color
LEFT_W = 7                     # left canvas width (cols 0..6)
TILE_COLS = (0, 4)             # 3x3 tile c0 positions on the left
TILE_ROW_STRIDE = 4            # row spacing between successive tile slots
GRAY = 5                       # start-pixel color
GRAY_START_ROW = 0             # gray start always sits at row 0 [observed]

# --- shape grammar (area -> 3x3 template, color, and (dr, dc) walk delta) ---
# Walk delta = total (row, col) displacement caused by one glyph instruction:
#   step down 1 then segment of (len, dir). E.g. area 4 (vertical len 2) => (+2, 0).
_TEMPLATES = {
    4: np.array([[1, 0, 1], [0, 1, 0], [0, 1, 0]], dtype=int),  # plus    -> down 2,  color 6
    5: np.array([[1, 1, 0], [1, 0, 1], [0, 1, 0]], dtype=int),  # diamond -> right 3, color 1
    6: np.array([[1, 1, 1], [0, 1, 0], [1, 0, 1]], dtype=int),  # cross   -> left 4,  color 3
    7: np.array([[1, 0, 1], [1, 0, 1], [1, 1, 1]], dtype=int),  # U       -> left 2,  color 2
}
_AREA_TO_COLOR = {4: 6, 5: 1, 6: 3, 7: 2}
_AREA_DELTA = {4: (2, 0), 5: (1, 2), 6: (1, -3), 7: (1, -1)}
_AREAS = (4, 5, 6, 7)

# --- generation constraints ---
MIN_DIRECTION_CHANGES = 2      # min vertical<->horizontal flips across the walk
MAX_ATTEMPTS = 300             # outer retry budget


def _sample_path(N: int, start_col: int) -> list[int] | None:
    """Random-walk a sequence of 2*N area instructions that stays in the left canvas.

    Returns None if the walk dead-ends or fails the direction-change constraint.
    """
    H = 4 * N - 1
    r, c = GRAY_START_ROW, start_col
    areas: list[int] = []
    for _ in range(2 * N):
        opts = [a for a in _AREAS
                if r + _AREA_DELTA[a][0] < H and 0 <= c + _AREA_DELTA[a][1] < LEFT_W]
        if not opts:
            return None
        area = random.choice(opts)
        areas.append(area)
        dr, dc = _AREA_DELTA[area]
        r += dr
        c += dc

    types = [a == 4 for a in areas]  # True = vertical, False = horizontal
    changes = sum(1 for i in range(1, len(types)) if types[i] != types[i - 1])
    if changes < MIN_DIRECTION_CHANGES:
        return None
    return areas


def _render_grid(N: int, start_col: int, areas: list[int]) -> np.ndarray:
    """Paint divider, gray start, and all 2*N tiled glyphs into the input grid."""
    H = 4 * N - 1
    grid = np.zeros((H, GRID_W), dtype=int)
    grid[:, DIVIDER_COL] = DIVIDER_COLOR
    grid[GRAY_START_ROW, DIVIDER_COL + 1 + start_col] = GRAY

    # Column-major tiling: first N glyphs into TILE_COLS[0], next N into TILE_COLS[1].
    for i, area in enumerate(areas):
        tile_col = TILE_COLS[i // N]
        r0 = TILE_ROW_STRIDE * (i % N)
        grid[r0:r0 + 3, tile_col:tile_col + 3] = _TEMPLATES[area] * _AREA_TO_COLOR[area]
    return grid


def _gen_attempt() -> np.ndarray | None:
    N = random.randint(N_MIN, N_MAX)
    start_col = random.randint(0, LEFT_W - 1)
    areas = _sample_path(N, start_col)
    if areas is None:
        return None
    return _render_grid(N, start_col, areas)


def generate_input() -> np.ndarray:
    for _ in range(MAX_ATTEMPTS):
        try:
            inp = _gen_attempt()
            if inp is None:
                continue
            out = main(inp)  # oracle check
            if out.shape != (inp.shape[0], LEFT_W):
                continue
            return inp
        except Exception:
            continue
    raise RuntimeError(f"generate_input: failed after {MAX_ATTEMPTS} attempts")
from __future__ import annotations

import numpy as np

from arc_utils import colors_present, find_components, get_bg, paste, random_free_location
import random


def _sparse_marker_color(g: np.ndarray, bg: int) -> int:
    colors = colors_present(g, exclude={bg})
    assert len(colors) == 2, "expected exactly two foreground colors"

    counts = {color: int(np.count_nonzero(g == color)) for color in colors}
    marker_count = min(counts.values())
    markers = [color for color, count in counts.items() if count == marker_count]
    assert len(markers) == 1, "sparse marker color must be unique"
    assert any(count > marker_count for count in counts.values()), "expected one color to be denser than the marker"
    return markers[0]


def main(grid: np.ndarray) -> np.ndarray:
    """
    Erase each foreground object that contains more than one sparse marker-color pixel.

    Input structure
    - A dominant background surrounds separated 4-connected foreground objects.
    - The foreground uses one dense object color and one sparse marker color.
    Rule
    - Infer the marker as the unique less frequent foreground color.
    - Keep objects with zero or one marker pixel.
    - Recolor every pixel of an object to background when it contains two or more marker pixels.
    Key insight
    - The marker count inside each whole object, not the object's size or position, decides whether that object remains.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2

    bg = get_bg(g)
    marker = _sparse_marker_color(g, bg)

    objects = find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format="dict")
    assert objects, "expected foreground objects"

    out = g.copy()
    kept_any = False
    removed_any = False
    for obj in objects:
        coords = obj["coords"]
        marker_count = int(np.count_nonzero(g[coords[:, 0], coords[:, 1]] == marker))
        if marker_count >= 2:
            out[coords[:, 0], coords[:, 1]] = bg
            removed_any = True
        else:
            kept_any = True

    assert kept_any and removed_any, "expected both kept and erased objects"
    return out

# --------------- generator (o5x) ---------------

# Canvas and object geometry.
ROW_RANGE, COL_RANGE = (13, 14), (12, 15)
OBJECT_RANGE = (6, 7)
RECT_H_RANGE, RECT_W_RANGE = (2, 4), (2, 6)
RECT_DIMS = tuple((h, w) for h in range(RECT_H_RANGE[0], RECT_H_RANGE[1] + 1) for w in range(RECT_W_RANGE[0], RECT_W_RANGE[1] + 1))
RECT_MIN_AREA = RECT_H_RANGE[0] * RECT_W_RANGE[0]
RECT_MAX_AREA = RECT_H_RANGE[1] * RECT_W_RANGE[1]

# Marker assignment and foreground density.
KEPT_OBJECT_COUNT = 3
MARKER_TOTAL_RANGE = (9, 14)
KEPT_MARKERS = (0, 1)
REMOVED_MARKERS = (2, 4)
FG_AREA_FACTORS = (5, 9)
FG_AREA_DIVISOR = 2

# Rendering, placement, and retries.
BG_COLOR, DENSE_COLOR, MARKER_COLOR = 0, 1, 8
PLACE_PAD, PLACE_CONN = 1, 8
PLACE_KWARGS = dict(transparent=BG_COLOR, padding=PLACE_PAD, padding_connectivity=PLACE_CONN)
MAX_GENERATION_ATTEMPTS = 300


def _gen_bounded_parts(n: int, total: int, lo: int, hi: int) -> list[int] | None:
    parts: list[int] = []
    remaining = int(total)
    for i in range(int(n)):
        rem = int(n) - i - 1
        low = max(int(lo), remaining - int(hi) * rem)
        high = min(int(hi), remaining - int(lo) * rem)
        if low > high:
            return None
        value = random.randint(low, high)
        parts.append(value)
        remaining -= value
    return parts if remaining == 0 else None


def _gen_marker_counts(n_objects: int, total_markers: int) -> list[tuple[int, bool]] | None:
    kept_count = KEPT_OBJECT_COUNT
    removed_count = int(n_objects) - kept_count
    kept_totals = [
        k
        for k in range(kept_count + 1)
        if REMOVED_MARKERS[0] * removed_count <= int(total_markers) - k <= REMOVED_MARKERS[1] * removed_count
    ]
    if not kept_totals:
        return None

    kept_total = random.choice(kept_totals)
    kept_markers = [KEPT_MARKERS[1]] * kept_total + [KEPT_MARKERS[0]] * (kept_count - kept_total)
    random.shuffle(kept_markers)

    removed_markers = _gen_bounded_parts(removed_count, int(total_markers) - kept_total, *REMOVED_MARKERS)
    if removed_markers is None:
        return None

    objects = [(m, True) for m in kept_markers] + [(m, False) for m in removed_markers]
    random.shuffle(objects)
    return objects


def _gen_rect_dims(n_objects: int, min_area: int, max_area: int) -> list[tuple[int, int]] | None:
    dims: list[tuple[int, int]] = []
    area = 0
    for i in range(int(n_objects)):
        rem = int(n_objects) - i - 1
        feasible = []
        for h, w in RECT_DIMS:
            new_area = area + h * w
            if new_area + rem * RECT_MIN_AREA <= int(max_area) and new_area + rem * RECT_MAX_AREA >= int(min_area):
                feasible.append((h, w))
        if not feasible:
            return None
        h, w = random.choice(feasible)
        dims.append((h, w))
        area += h * w

    if not (int(min_area) <= area <= int(max_area)):
        return None
    random.shuffle(dims)
    return dims


def _gen_pair_dims_counts(dims: list[tuple[int, int]], counts: list[tuple[int, bool]]):
    remaining = list(dims)
    paired: list[tuple[int, int, int, bool]] = []
    for marker_count, keep in sorted(counts, reverse=True):
        compatible = [i for i, (h, w) in enumerate(remaining) if h * w > marker_count]
        if not compatible:
            return None
        idx = random.choice(compatible)
        h, w = remaining.pop(idx)
        paired.append((h, w, marker_count, keep))
    random.shuffle(paired)
    return paired


def _gen_marked_rect(h: int, w: int, marker_count: int) -> np.ndarray:
    rect = np.full((h, w), DENSE_COLOR, dtype=int)
    rect.flat[random.sample(range(h * w), marker_count)] = MARKER_COLOR
    return rect


def _render_specs(rows: int, cols: int, specs: list[tuple[int, int, int, bool]]):
    """Return generated input and expected output, or None if placement fails."""
    inp = np.full((rows, cols), BG_COLOR, dtype=int)
    expected = np.full_like(inp, BG_COLOR)
    occupancy = np.full_like(inp, BG_COLOR)
    order = list(specs)
    random.shuffle(order)
    order.sort(key=lambda item: item[0] * item[1], reverse=True)

    for h, w, marker_count, keep in order:
        patch = np.full((h, w), DENSE_COLOR, dtype=int)
        try:
            r0, c0 = random_free_location(occupancy, patch, **PLACE_KWARGS)
        except ValueError:
            return None

        rect = _gen_marked_rect(h, w, marker_count)
        paste(inp, rect, r0, c0)
        paste(occupancy, patch, r0, c0)
        if keep:
            paste(expected, rect, r0, c0)
    return inp, expected


def _gen_attempt() -> np.ndarray | None:
    rows = random.randint(*ROW_RANGE)
    cols = random.randint(*COL_RANGE)
    n_objects = random.randint(*OBJECT_RANGE)
    total_markers = random.randint(*MARKER_TOTAL_RANGE)

    grid_area = rows * cols
    min_area = FG_AREA_FACTORS[0] * total_markers
    max_area = min(FG_AREA_FACTORS[1] * total_markers, (grid_area + total_markers - 1) // FG_AREA_DIVISOR)
    if min_area > max_area:
        return None

    dims = _gen_rect_dims(n_objects, min_area, max_area)
    counts = _gen_marker_counts(n_objects, total_markers)
    if dims is None or counts is None:
        return None
    specs = _gen_pair_dims_counts(dims, counts)
    if specs is None:
        return None

    rendered = _render_specs(rows, cols, specs)
    if rendered is None:
        return None
    inp, expected = rendered

    try:
        actual = main(inp)
    except Exception:
        return None
    if not np.array_equal(actual, expected):
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(MAX_GENERATION_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid input")

