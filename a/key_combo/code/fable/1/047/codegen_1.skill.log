+
+def analyze_scene(grid: np.ndarray) -> tuple[int, list[tuple[int, int]], dict, list[dict]]:
+    g = np.asarray(grid, dtype=int)
+    bg = get_bg(g)
+    marker_cells = isolated_marker_cells(g, bg)
