+def _normalize_coords(coords: np.ndarray) -> np.ndarray:
+    out = np.array(coords, dtype=int)
+    out[:, 0] -= out[:, 0].min()
+    out[:, 1] -= out[:, 1].min()
+    return out
+
+
+def _patch_coords(patch: np.ndarray) -> np.ndarray:
+    return np.argwhere(patch > 0).astype(int)
+
