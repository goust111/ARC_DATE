+
+def _paint(grid: np.ndarray, coords: np.ndarray, color: int) -> None:
+    grid[coords[:, 0], coords[:, 1]] = int(color)
+
+
+def _mark_blocked(blocked: np.ndarray, coords: np.ndarray, pad: int = 1) -> None:
+    h, w = blocked.shape
