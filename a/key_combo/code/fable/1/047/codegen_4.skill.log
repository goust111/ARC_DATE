+# --------------- generator ---------------
+
+COLOR_POOL = tuple(range(1, 10))
+HEIGHT_RANGE = (16, 22)
+PANEL_WIDTH_RANGE = (7, 13)
+BAR_COUNT_RANGE = (2, 3)
+HEIGHT_MIN = 4
+GEN_RETRY_LIMIT = 400
+GEN_COMBOS = (
+    (MOVE_CROSS, SIDE_TOP),
+    (MOVE_SAME, SIDE_BOTTOM),
+    (MOVE_CROSS, SIDE_BOTTOM),
+    (MOVE_SAME, SIDE_TOP),
+)
+
+_GEN_COUNTER = 0
