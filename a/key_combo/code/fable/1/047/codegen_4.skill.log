+def _extract_bars(
+    grid: np.ndarray,
+    panel: dict[str, int],
+    panel_idx: int,
+    shared_color: int,
+    panel_colors: tuple[int, int],
+) -> list[dict[str, object]]:
+    r0 = int(panel["r0"])
+    c0 = int(panel["c0"])
+    r1 = int(panel["r1"])
+    c1 = int(panel["c1"])
+    panel_color = int(panel["color"])
+    allowed = {int(shared_color), _other_panel_color(panel_color, panel_colors)}
+
+    bars: list[dict[str, object]] = []
