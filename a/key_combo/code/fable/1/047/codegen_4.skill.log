+def _paint_half(grid: np.ndarray, bar: dict[str, object], side: str, color: int) -> None:
+    height = int(bar["height"])
+    half = height // 2
+    r0 = int(bar["r0"]) if "r0" in bar else int(grid.shape[0]) - height
