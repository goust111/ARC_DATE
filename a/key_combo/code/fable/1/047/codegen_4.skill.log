+def _runs_1d(values: np.ndarray) -> list[tuple[int, int, int]]:
+    vals = [int(v) for v in values]
+    runs: list[tuple[int, int, int]] = []
+    start = 0
+    for i in range(1, len(vals) + 1):
+        if i == len(vals) or vals[i] != vals[start]:
+            runs.append((vals[start], start, i - 1))
+            start = i
+    return runs
