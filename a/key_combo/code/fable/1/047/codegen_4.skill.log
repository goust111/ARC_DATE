+GEN_RETRY_LIMIT = 400
+GEN_COMBOS = (
+    (MOVE_CROSS, SIDE_TOP),
+    (MOVE_SAME, SIDE_BOTTOM),
+    (MOVE_CROSS, SIDE_BOTTOM),
+    (MOVE_SAME, SIDE_TOP),
