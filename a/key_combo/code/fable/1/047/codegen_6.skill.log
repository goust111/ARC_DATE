+    extra_h = 30 - inner_h
+    extra_w = 30 - inner_w
+    top = random.randint(1, min(4, extra_h - 1))
+    bottom = random.randint(1, min(4, extra_h - top))
+    left = random.randint(1, min(4, extra_w - 1))
+    right = random.randint(1, min(4, extra_w - left))
