+    start = arrows[start_idx]
+    hits = [
+        idx
+        for idx, arrow in enumerate(arrows)
+        if idx != start_idx
+        and _ray_hit_distance(start["center"], start["direction"], arrow["coords"]) is not None
+    ]
+    return _erase_indices(grid, arrows, [start_idx] + hits, bg)
