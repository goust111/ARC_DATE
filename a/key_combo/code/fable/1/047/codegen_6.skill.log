+        return _build_bounce_template()
+    return _build_turn_template()
+
+
+def _assign_colors(specs: list[dict]) -> list[dict]:
+    colored: list[dict] = []
+    palette = random.sample(list(NON_START_COLORS), len(specs) - 1)
+    used = iter(palette)
