+
+def _ray_hit_distance(
+    start: tuple[int, int],
+    direction: tuple[int, int],
+    coords: np.ndarray,
+) -> int | None:
+    sr, sc = map(int, start)
+    dr, dc = map(int, direction)
+    best: int | None = None
+
+    if dr == 0:
+        for r, c in coords:
+            if int(r) != sr:
+                continue
+            dist = (int(c) - sc) * dc
+            if dist <= 0:
+                continue
+            if best is None or dist < best:
+                best = int(dist)
+        return best
