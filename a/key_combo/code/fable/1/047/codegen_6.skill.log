+def _erase_indices(grid: np.ndarray, arrows: list[dict], indices: list[int], bg: int) -> np.ndarray:
+    out = np.array(grid, dtype=int, copy=True)
+    for idx in indices:
+        coords = arrows[int(idx)]["coords"]
