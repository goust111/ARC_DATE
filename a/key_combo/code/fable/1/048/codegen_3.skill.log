+def _candidate_landings(settled: np.ndarray, piece_mask: np.ndarray) -> list[tuple[int, int]]:
+    h, w = piece_mask.shape
+    H, W = settled.shape
+    occ = settled != BG
+    surface = _surface_rows(settled)
+    bottom = _bottom_profile(piece_mask)
+    candidates = []
