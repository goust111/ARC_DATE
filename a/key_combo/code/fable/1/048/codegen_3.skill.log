+    moved = False
+    W = len(surface)
+    for piece, top in zip(pieces, tops):
+        width = int(piece["mask"].shape[1])
+        candidates = list(range(W - width + 1))
+        rng.shuffle(candidates)
+        if len(candidates) > 1:
