+                continue
+            buckets.setdefault(profile, []).append(x)
+        for profile, xs in buckets.items():
+            key = (width, profile)
+            if len(xs) == 1 and key not in used_profiles:
+                x = xs[0]
+                window = surface[x : x + width]
+                options.append(
+                    {
+                        "x": int(x),
+                        "width": int(width),
+                        "profile": profile,
+                        "landing_row": int(window.min()) - 1,
+                        "nonflat": int(max(profile)) > 0,
