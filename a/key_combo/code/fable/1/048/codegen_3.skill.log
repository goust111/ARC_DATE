+def _wrong_order_differs(inp: np.ndarray, out: np.ndarray) -> bool:
+    try:
+        wrong, _ = _solve(inp, ascending=True)
+    except AssertionError:
+        return True
+    return not np.array_equal(wrong, out)
+
