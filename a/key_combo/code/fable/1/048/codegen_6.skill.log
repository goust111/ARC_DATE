+    room_cols: int,
+    start: tuple[int, int],
+    key: tuple[int, int],
+    goal: tuple[int, int],
+    route: list[tuple[int, int]],
+) -> np.ndarray:
+    out = np.zeros((room_rows, room_cols), dtype=int)
+    for room in route:
