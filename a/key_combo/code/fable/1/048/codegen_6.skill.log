+                c0, c1 = col_spans[a[1]]
+                gap_col = random.randint(c0, c1)
+                grid[divider_row, gap_col] = BLACK
+            else:
+                divider_col = col_dividers[min(a[1], b[1])]
+                r0, r1 = row_spans[a[0]]
+                gap_row = random.randint(r0, r1)
+                grid[gap_row, divider_col] = BLACK
