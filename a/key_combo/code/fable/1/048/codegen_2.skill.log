+def generate_input() -> np.ndarray:
+    for _ in range(GEN_MAX_ATTEMPTS):
+        inp, expected = _generate_case()
+        if _case_is_valid(inp, expected):
+            return inp
+    raise RuntimeError("failed to generate a valid periodic wall maze")

