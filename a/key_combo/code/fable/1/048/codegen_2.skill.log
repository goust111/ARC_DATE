+    inp[a] = ENDPOINT
+    inp[b] = ENDPOINT
+
+    expected = _render_expected_output(full_grid, full_path, idx_a, idx_b)
+    return inp, expected
+
+
+def _case_is_valid(inp: np.ndarray, expected: np.ndarray) -> bool:
+    if inp.ndim != 2 or expected.ndim != 2:
+        return False
+    if max(inp.shape) > 30 or max(expected.shape) > 30:
