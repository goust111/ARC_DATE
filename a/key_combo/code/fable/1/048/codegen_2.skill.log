+        return False
+
+    start = next(iter(open_cells))
+    seen = {start}
+    stack = [start]
+    endpoint_count = 0
+
+    while stack:
+        r, c = stack.pop()
+        deg = 0
+        for nr, nc in neighbors4(r, c):
+            if (nr, nc) not in open_cells:
+                continue
+            deg += 1
+            if (nr, nc) not in seen:
+                seen.add((nr, nc))
+                stack.append((nr, nc))
+        if deg > 2:
+            return False
+        if deg == 0 and len(open_cells) > 1:
+            return False
+        if deg == 1:
+            endpoint_count += 1
+
+    return seen == open_cells and endpoint_count == 2
