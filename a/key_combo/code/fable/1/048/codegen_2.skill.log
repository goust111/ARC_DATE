+from arc_utils import Color, in_bounds, neighbors4, tile_fill
+
+
+BG = Color.BLACK
+WALL = Color.TEAL
+ENDPOINT = Color.RED
+PATH = Color.YELLOW
+
+GEN_MAX_ATTEMPTS = 400
