+def _columns_chain_ok(columns: list[int], width: int) -> bool:
+    for a, b in zip(columns, columns[1:]):
+        if abs(a - b) >= width:
+            return False
+        if min(a, b) == 0 and max(a, b) == width - 1:
+            return False
+
+    for r in range(len(columns) - 2):
+        a = int(columns[r])
+        b = int(columns[r + 1])
+        c = int(columns[r + 2])
+        lo1, hi1 = sorted((a, b))
+        lo2, hi2 = sorted((b, c))
+        inter_lo = max(lo1, lo2)
+        inter_hi = min(hi1, hi2)
+        if inter_lo != inter_hi or inter_lo != b:
+            return False
+
+    a = int(columns[-2])
+    b = int(columns[-1])
+    c = int(columns[1])
+    lo1, hi1 = sorted((a, b))
+    lo2, hi2 = sorted((b, c))
+    inter_lo = max(lo1, lo2)
+    inter_hi = min(hi1, hi2)
+    if inter_lo != inter_hi or inter_lo != b:
+        return False
+    return True
+
