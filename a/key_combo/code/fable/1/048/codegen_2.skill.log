+def _path_from_columns(columns: list[int]) -> list[tuple[int, int]]:
+    period = len(columns) - 1
+    path = [(0, int(columns[0]))]
+    for r in range(period):
+        c0 = int(columns[r])
+        c1 = int(columns[r + 1])
+        if c0 != c1:
