+        lo2, hi2 = sorted((b, c))
+        inter_lo = max(lo1, lo2)
+        inter_hi = min(hi1, hi2)
+        if inter_lo != inter_hi or inter_lo != b:
+            return False
+
+    a = int(columns[-2])
+    b = int(columns[-1])
+    c = int(columns[1])
+    lo1, hi1 = sorted((a, b))
+    lo2, hi2 = sorted((b, c))
