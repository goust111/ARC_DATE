+def _render_fractal(seed_mask: np.ndarray, bg: int, fg: int) -> np.ndarray:
+    fractal = np.kron(seed_mask.astype(int), seed_mask.astype(int))
+    return np.where(fractal != 0, fg, bg).astype(int)
