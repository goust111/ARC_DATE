+    groups = {(pr, pc): [] for pr in range(period_r) for pc in range(period_c)}
+    for r in range(h):
+        for c in range(w):
+            groups[((r + row_offset) % period_r, (c + col_offset) % period_c)].append((r, c))
+    return groups
