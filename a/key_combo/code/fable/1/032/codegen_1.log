+    left_set = {(int(r) % period_r, int(c) % period_c) for r, c in np.argwhere(left != BLACK)}
+    right_set = {
+        ((int(r) + dr) % period_r, (int(c) + dc) % period_c)
+        for r, c in np.argwhere(right != BLACK)
