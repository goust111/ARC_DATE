+def _covers_output(
+    phase_map: dict[tuple[int, int], int], out_shape: tuple[int, int], period_r: int, period_c: int
+) -> bool:
+    h, w = out_shape
+    for r in range(h):
+        for c in range(w):
+            if (r % period_r, c % period_c) not in phase_map:
+                return False
+    return True
