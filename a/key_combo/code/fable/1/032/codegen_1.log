+
+def _render_output(
+    out_shape: tuple[int, int], period_r: int, period_c: int, phase_map: dict[tuple[int, int], int]
+) -> np.ndarray:
+    h, w = out_shape
+    out = np.zeros((h, w), dtype=int)
+    for r in range(h):
+        for c in range(w):
+            out[r, c] = phase_map[(r % period_r, c % period_c)]
+    return out
