+def _score_shift(left: np.ndarray, right: np.ndarray, dr: int, dc: int) -> tuple[int, int] | None:
+    h, w = left.shape
+    r0 = max(0, dr)
+    r1 = min(h, h + dr)
+    c0 = max(0, dc)
+    c1 = min(w, w + dc)
+    if r0 >= r1 or c0 >= c1:
