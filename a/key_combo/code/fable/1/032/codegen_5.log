+    try:
+        _draw_frame_with_template(grid, occupied, template_mask)
+    except ValueError:
+        return None
+
+    specs: list[tuple[str, int]] = [("rot", k) for k in range(4)]
+    specs.extend(("mirror", random.randrange(4)) for _ in range(random.randint(1, 3)))
