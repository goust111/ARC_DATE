+    for k in (1, 2, 3):
+        if _same_shape(mask, np.rot90(mask, k)):
+            return False
+    mirrored = np.fliplr(mask)
+    for k in range(4):
+        if _same_shape(mask, np.rot90(mirrored, k)):
+            return False
+    return True
+
+
+def _random_template_mask() -> np.ndarray:
+    for _ in range(300):
