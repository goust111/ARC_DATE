+def _random_template_mask() -> np.ndarray:
+    for _ in range(300):
+        h = random.randint(3, 5)
+        w = random.randint(4, 6)
+        target = random.randint(max(5, (h + w) // 2 + 1), min(h * w - 2, 9))
+        mask = np.zeros((h, w), dtype=bool)
+        seed = (random.randrange(h), random.randrange(w))
