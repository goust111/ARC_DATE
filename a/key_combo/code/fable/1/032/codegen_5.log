  69:             if np.any( (test_canvas != background) & (input_grid != background) & (test_canvas != input_grid) ):
  70:                 return float("-inf")
  71:             
  72:             return np.sum( (test_canvas == input_grid) & (input_grid != background) )
  73:         
  74:         # Remove -inf solutions, and zero solutions
  75:         possible_solutions = [ solution for solution in possible_solutions if score_solution(*solution) > 0 ]
  76:         
  77:         best_r, best_c, best_sprite = max(possible_solutions, key=lambda solution: score_solution(*solution))
  78: 
  79:         # 4. Copy the resulting transformation to the output grid; delete the fragments from the input
  80:         # Copy output
  81:         paste(output_grid, best_sprite, best_r, best_c, transparent=Color.BLACK, clip=True)
