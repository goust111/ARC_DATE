+
+def _same_shape(a: np.ndarray, b: np.ndarray) -> bool:
+    return a.shape == b.shape and np.array_equal(a, b)
+
+
+def _rotation_index(template_mask: np.ndarray, obj_mask: np.ndarray) -> int | None:
