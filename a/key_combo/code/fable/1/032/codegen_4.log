+def _room_capacity(bbox: tuple[int, int, int, int]) -> int:
+    r0, c0, r1, c1 = bbox
+    inner_h = r1 - r0 - 1
+    inner_w = c1 - c0 - 1
+    return ((inner_h + 1) // 2) * ((inner_w + 1) // 2)
