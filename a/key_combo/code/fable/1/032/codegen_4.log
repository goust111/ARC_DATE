+        touches_border = (
+            np.any(coords[:, 0] == 0)
+            or np.any(coords[:, 0] == grid.shape[0] - 1)
+            or np.any(coords[:, 1] == 0)
+            or np.any(coords[:, 1] == grid.shape[1] - 1)
+        )
+        if touches_border:
