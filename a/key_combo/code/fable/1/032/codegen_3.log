            for width in range(max(_GEN_WIDTH_RANGE[0], min_side), _GEN_WIDTH_RANGE[1] + 1):
                if height - 2 * radius < _GEN_MIN_SIDE_RUN or width - 2 * radius < _GEN_MIN_SIDE_RUN:
