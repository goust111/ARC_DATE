+def _tight_mask_from_component(component: dict) -> np.ndarray:
+    r0, c0, r1, c1 = component["bbox"]
+    local = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    coords = component["coords"]
+    local[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    return local
