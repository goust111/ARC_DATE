    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2

    bg = get_bg(g)
    color, source, dr, dc = _completion_candidate(g, bg)

    out = g.copy()
    for r, c in source:
        out[r, c] = int(bg)
    for r, c in source:
        rr, cc = r + dr, c + dc
        assert int(out[rr, cc]) == int(bg), "translated source must land on background cells"
        out[rr, cc] = int(color)

    return out

