_GEN_HEIGHT_RANGE = (6, 15)
_GEN_WIDTH_RANGE = (5, 17)
_GEN_MIN_SIDE_RUN = 3
_GEN_FILL_RATIO_RANGE = (0.76, 0.93)
_GEN_CAP_SHRINK = 2

