+                for nr, nc in neighbors4(int(r), int(c)):
+                    if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc] and (nr, nc) not in seen:
+                        seen.add((nr, nc))
+                        frontier.append((nr, nc))
