+    pc = random.randint(0, 1)
+    lh = random.randint(_LATTICE_SIZE_MIN, _LATTICE_SIZE_MAX)
+    lw = random.randint(_LATTICE_SIZE_MIN, _LATTICE_SIZE_MAX)
+    h, w = _grid_shape_from_lattice(lh, lw, pr, pc)
+
