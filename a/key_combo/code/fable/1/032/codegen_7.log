MIN_OPEN_COMPONENT_RATIO, OPEN_COMPONENT_FILL_RANGE = 0.50, (0.55, 0.67)
MARKER_MIN_GREY_DISTANCE, GEN_RETRY_LIMIT, MARKER_COLORS = 3, 300, (1, 2, 3, 4, 6, 7, 8, 9)

