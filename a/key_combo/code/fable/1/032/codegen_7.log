+            )
+            edge_penalty = int(r in (0, lh - 1) or c in (0, lw - 1))
+            center_bias = 1.0 / (1.0 + abs(r - center_r) + abs(c - center_c))
+            weights.append(1.0 + 2.0 * same_neighbors + 0.6 * center_bias - 0.25 * edge_penalty)
