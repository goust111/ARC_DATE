SEED_MIN_SEPARATIONS = (5, 4, 3, 2)
GROWTH_BAND_WIDTH_CHOICES = (3, 3, 4, 4, 5)
FRONTIER_BASE_WEIGHT, FRONTIER_SAME_NEIGHBOR_WEIGHT, FRONTIER_EDGE_WEIGHT = 1.0, 0.8, 0.5

