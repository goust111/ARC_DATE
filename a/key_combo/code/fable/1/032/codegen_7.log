+    candidate_mask = np.ones((h, w), dtype=bool)
+    for r, c in nodes | active_midpoints:
+        candidate_mask[r, c] = False
+
+    extra_grey = random.randint(0, max(0, (h * w) // 20)) if split_case else random.randint(4, max(4, (h * w) // 14))
