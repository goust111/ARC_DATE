+    try:
+        out = main(grid)
+    except Exception:
+        return None
+
+    same_lattice = _same_lattice_mask(grid.shape, marker_r % 2, marker_c % 2)
+    reachable = _reachable_black_mask(grid, (marker_r, marker_c))
+    if not np.any(reachable):
