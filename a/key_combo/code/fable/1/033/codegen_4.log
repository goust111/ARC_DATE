+        else:
+            out[r, w - 1 - c] = BG
+    return out
+
+
+def _shear_onto_canvas(rect: np.ndarray, top: int, left: int, canvas_shape: tuple[int, int]) -> np.ndarray:
+    h, w = rect.shape
+    out = np.zeros(canvas_shape, dtype=int)
+    for r in range(h):
