+        ends = cuts + [half_w]
+        last = None
+        for c0, c1 in zip(starts, ends):
+            choices = [col for col in palette if col != last] or palette
+            color = random.choice(choices)
+            arr[r, c0:c1] = color
+            last = color
+    return arr
