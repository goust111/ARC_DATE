+    cols = [0]
+    while cols[-1] < half_w:
+        cols.append(min(half_w, cols[-1] + random.randint(1, 2)))
+    for r0, r1 in zip(rows, rows[1:]):
+        last = None
+        for c0, c1 in zip(cols, cols[1:]):
+            choices = [col for col in palette if col != last] or palette
