40:    # with this background color, find the polychromatic objects
41:    objects = find_components(input_grid, bg=background_color, connectivity=8, monochromatic=False, return_format="objects")
42:
43:    # sort the objects by their size in terms of area, the crosshair is the smallest object
44:    sorted_objects = sorted(objects, key=lambda r: np.count_nonzero(r != background_color))
45:    crosshair_object = sorted_objects[0]
46:    rectangles = sorted_objects[1:]
