172:def _compositions(total: int, parts: int) -> list[tuple[int, ...]]:
173:    out: list[tuple[int, ...]] = []
174:
175:    def rec(remaining: int, n: int, prefix: list[int]) -> None:
176:        if n == 1:
177:            if ARC_MIN_LEN <= remaining <= ARC_MAX_LEN:
178:                out.append(tuple(prefix + [remaining]))
179:            return
180:        lo = max(ARC_MIN_LEN, remaining - ARC_MAX_LEN * (n - 1))
181:        hi = min(ARC_MAX_LEN, remaining - ARC_MIN_LEN * (n - 1))
182:        for x in range(lo, hi + 1):
183:            rec(remaining - x, n - 1, prefix + [x])
184:
185:    rec(total, parts, [])
186:    return out
