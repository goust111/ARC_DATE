52:    width, height = crosshair_sprite.shape
53:    
54:    # if the crosshair is wider than it is tall, it extends horizontally, vertically if taller, both if square
55:    horizontal = True
56:    vertical = True
57:    if width > height:
58:        vertical = False
59:        point_color = crosshair_sprite[0, height // 2]
60:    elif height > width:
61:        horizontal = False
62:        point_color = crosshair_sprite[width // 2, 0]
63:    else:
64:        point_color = crosshair_sprite[width // 2, 0]
65:
66:    # now we prepare the output grid
67:    output_grid = np.full_like(input_grid, background_color)
68:
