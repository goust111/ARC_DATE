194:def _arc_kind(coords: tuple[tuple[int, int], ...]) -> str | None:
195:    r0, c0, r1, c1 = _coord_bounds(coords)
196:    h, w = r1 - r0 + 1, c1 - c0 + 1
197:    area = len(coords)
198:
199:    if h == 1 or w == 1:
200:        return "bar" if BAR_MIN_AREA <= area <= BAR_MAX_AREA else None
201:
202:    if not (
203:        L_MIN_AREA <= area <= L_MAX_AREA
204:        and L_MIN_HEIGHT <= h <= L_MAX_HEIGHT
205:        and L_MIN_WIDTH <= w <= L_MAX_WIDTH
206:    ):
207:        return None
208:    if area != h + w - 1:
209:        return None
210:
211:    actual = {(r - r0, c - c0) for r, c in coords}
212:    for elbow_r, elbow_c in ((0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)):
213:        expected = {
214:            (r, c)
215:            for r in range(h)
216:            for c in range(w)
217:            if r == elbow_r or c == elbow_c
218:        }
219:        if actual == expected:
220:            return "L"
221:    return None
