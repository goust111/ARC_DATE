164:def _border_coords(h: int, w: int) -> tuple[tuple[int, int], ...]:
165:    coords = [(0, c) for c in range(w)]
166:    coords += [(r, w - 1) for r in range(1, h)]
167:    coords += [(h - 1, c) for c in range(w - 2, -1, -1)]
