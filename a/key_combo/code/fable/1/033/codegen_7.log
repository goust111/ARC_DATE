+    sprite_h = random.randint(3, cell_h)
+    sprite_w = random.randint(3, cell_w)
+    min_pixels = max(GEN_PATTERN_MIN_PIXELS, good_count + 4)
+    max_pixels = min(GEN_PATTERN_MAX_PIXELS, sprite_h * sprite_w - 1, cell_h * cell_w - 1)
