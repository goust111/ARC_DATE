21:def main(grid: np.ndarray) -> np.ndarray:
22:    """
23:    Repeat the populated tile pattern into every cell of a separator grid.
24:
25:    Input structure
26:    - The canvas has one background color and a single non-background separator color.
27:    - Solid separator rows and/or columns divide the canvas into equal-sized rectangular cells.
28:    - At least one cell contains a non-background pattern, and all populated cells contain the same pattern.
29:
30:    Rule
31:    - Find the separator color from the solid full-width rows or full-height columns.
32:    - Use the separator lines to split the canvas into cells.
33:    - Copy the unique populated cell pattern into every cell, preserving the separator lines.
34:
35:    Key insight
36:    The separators define a coarse tiled board; the visible foreground pattern is the missing tile to repeat everywhere.
37:    """
38:    g = np.asarray(grid, dtype=int)
39:    assert g.ndim == 2 and g.size > 0, "expected a non-empty 2D grid"
40:    height, width = map(int, g.shape)
41:    bg = get_bg(g)
42:
43:    separator_candidates: list[tuple[int, list[int], list[int]]] = []
44:    for color in np.unique(g):
45:        color = int(color)
46:        if color == bg:
47:            continue
48:        rows = [r for r in range(height) if np.all(g[r, :] == color)]
49:        cols = [c for c in range(width) if np.all(g[:, c] == color)]
50:        if rows or cols:
51:            separator_candidates.append((color, rows, cols))
52:
53:    assert len(separator_candidates) == 1, "expected one solid separator color"
54:    separator, row_lines, col_lines = separator_candidates[0]
55:
56:    row_regions = _regions_between(height, row_lines) if row_lines else [(0, height - 1)]
57:    col_regions = _regions_between(width, col_lines) if col_lines else [(0, width - 1)]
58:    assert len(row_regions) * len(col_regions) > 1, "expected the separators to define multiple cells"
59:    assert len({r1 - r0 + 1 for r0, r1 in row_regions}) == 1, "expected equal cell heights"
60:    assert len({c1 - c0 + 1 for c0, c1 in col_regions}) == 1, "expected equal cell widths"
61:
62:    populated: list[np.ndarray] = []
