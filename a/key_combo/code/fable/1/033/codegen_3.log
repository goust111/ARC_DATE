+        cc_num = sc + cc2
+        assert rr_num % 2 == 0 and cc_num % 2 == 0
+        rr = rr_num // 2
+        cc = cc_num // 2
+        if 0 <= rr < h and 0 <= cc < w:
+            pts.append((int(rr), int(cc)))
+    return tuple(sorted(set(pts)))
