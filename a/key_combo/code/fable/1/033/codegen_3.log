  77:         _b = bbox(rectangle != background_color)
  78:         assert _b is not None
  79:         cropped_rectangle = crop_bbox(rectangle, _b)
  80: 
  81:         # find the special color, it is the least common color in the rectangle
  82:         colors, counts = np.unique(cropped_rectangle, return_counts=True)
  83:         # colors are sorted by their frequency, so choose least common as the special color
  84:         special_color = colors[-1]
  85:         rectangle_color = colors[-2]
  86: 
  87:         # for each special pixel, extend the crosshair pattern
