  13: # In the input you will see a 30x30 grid with at least two rectangles, each with at least one special pixel of a different color, and a crosshair-type pattern outside these rectangles.
  14: # For each of these special pixels, apply the crosshair pattern and extend the points inside the rectangle that special pixel is in, until it reaches the edge.
  15: 
  16: def main(input_grid):
  17:     """
  18:     Apply the external crosshair pattern to each special pixel inside the rectangles.
  19: 
  20:     Input structure:
  21:     - The most common color is the background.
  22:     - The smallest non-background component is a crosshair instruction sprite.
  23:     - Larger components are rectangles containing one or more special pixels of another color.
  24: 
  25:     Rule:
  26:     - Crop the crosshair sprite and infer whether it extends horizontally, vertically, or both.
  27:     - For each rectangle, paste the crosshair centered on every special pixel.
  28:     - Extend the crosshair point color through rectangle-colored cells along the enabled row or column.
  29: 
  30:     Key insight:
  31:     - The small outside crosshair is an instruction object; each special pixel becomes the center
  32:       of that same growth pattern inside its rectangle.
  33:     """
  34:     # first get the grid size
  35:     n, m = input_grid.shape
  36: 
  37:     # figure out background color by assuming it is the most common color
  38:     background_color = np.bincount(input_grid.flatten()).argmax()
  39: 
  40:     # with this background color, find the polychromatic objects
  41:     objects = find_components(input_grid, bg=background_color, connectivity=8, monochromatic=False, return_format="objects")
  42: 
  43:     # sort the objects by their size in terms of area, the crosshair is the smallest object
  44:     sorted_objects = sorted(objects, key=lambda r: np.count_nonzero(r != background_color))
  45:     crosshair_object = sorted_objects[0]
  46:     rectangles = sorted_objects[1:]
  47: 
  48:     # now find the crosshair sprite coordinates
  49:     _b = bbox(crosshair_object != background_color)
  50:     assert _b is not None
  51:     crosshair_sprite = crop_bbox(crosshair_object, _b)
  52:     width, height = crosshair_sprite.shape
  53:     
  54:     # if the crosshair is wider than it is tall, it extends horizontally, vertically if taller, both if square
  55:     horizontal = True
  56:     vertical = True
  57:     if width > height:
  58:         vertical = False
  59:         point_color = crosshair_sprite[0, height // 2]
  60:     elif height > width:
  61:         horizontal = False
  62:         point_color = crosshair_sprite[width // 2, 0]
  63:     else:
  64:         point_color = crosshair_sprite[width // 2, 0]
  65: 
  66:     # now we prepare the output grid
  67:     output_grid = np.full_like(input_grid, background_color)
  68: 
  69:     # for each rectangle, crop it to just the rectangle, find the special pixel, extend the crosshair pattern from it, then add it back to the grid
