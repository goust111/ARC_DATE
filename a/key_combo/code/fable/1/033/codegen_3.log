  58: def main(grid: np.ndarray) -> np.ndarray:
  59:     """
  60:     Replace each pink masked pixel with the color from its matching square-symmetry orbit.
  61: 
  62:     Input structure:
  63:     - The grid is square and fully colored.
  64:     - Pink pixels are masks covering missing cells; every other pixel is part of the completed pattern.
  65:     - The completed pattern obeys main-diagonal symmetry and reflected square symmetry in a slightly larger hidden frame.
  66: 
  67:     Rule:
  68:     - Infer the reflected square frame whose visible symmetry orbits make all non-pink cells agree.
  69:     - For each pink pixel, collect all visible cells related by diagonal, horizontal, vertical, and rotated reflections in that frame.
  70:     - Recolor the pink pixel to the unique non-pink color already present in its orbit.
  71: 
  72:     Key insight:
  73:     Pink is not an object color; it hides entries of one globally D4-symmetric color table, so each missing value is copied from its symmetry orbit.
  74:     """
  75:     g = np.asarray(grid, dtype=int)
  76:     assert g.ndim == 2 and g.shape[0] == g.shape[1], "input must be a square grid"
  77:     assert np.any(g == MASK), "input must contain pink masked pixels"
  78: 
  79:     n = g.shape[0]
  80:     symmetry_sum = _symmetry_sum(g)
