+
+def _is_solid_2x2(coords: np.ndarray) -> bool:
+    if coords.shape != (4, 2):
+        return False
+    r0, c0, r1, c1 = _bbox_from_coords(coords)
+    if r1 - r0 != 1 or c1 - c0 != 1:
+        return False
+    return {(int(r), int(c)) for r, c in coords} == {
+        (r0, c0),
+        (r0, c1),
+        (r1, c0),
+        (r1, c1),
+    }
