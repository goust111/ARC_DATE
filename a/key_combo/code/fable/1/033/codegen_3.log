+    dr2 = 2 * int(r) - int(sr)
+    dc2 = 2 * int(c) - int(sc)
+    rels = (
+        (dr2, dc2),
+        (dc2, -dr2),
+        (-dr2, -dc2),
+        (-dc2, dr2),
+    )
+    pts = []
+    for rr2, cc2 in rels:
