+    for r0 in range(border, H - h - border + 1):
+        for c0 in range(border, W - w - border + 1):
+            box = (r0, c0, r0 + h - 1, c0 + w - 1)
+            if all(_boxes_separate(box, other, padding) for other in used_boxes):
