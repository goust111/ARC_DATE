# Canvas, separator, and layout knobs.
BG_COLOR = 0
SEPARATOR_COLOR = 4
CELL_LAYOUTS = [(2, 1), (2, 2), (2, 3), (3, 1), (3, 2)]
CELL_H_RANGE = (5, 9)
CELL_W_RANGE = (5, 9)

