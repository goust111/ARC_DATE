+        "A": (1, 1),
+        "B": (1, 2),
+        "C": (0, 1),
+        "D": (2, 1),
+        "U": (2, 2),
+    }
+    walls = [("D", "U"), ("B", "U")]
+    if random.random() < 0.7:
