+    sources = [tuple(map(int, rc)) for rc in np.argwhere(grid == Color.RED)]
+    assert len(sources) == 1, "expected exactly one red source marker"
+    source = sources[0]
+    assert source in markers, "the source must also be a marker"
+
+    walls = grid == Color.TEAL
