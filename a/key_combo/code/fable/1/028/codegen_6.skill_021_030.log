+def _rect_is_clear(occ: np.ndarray, r0: int, c0: int, h: int, w: int, *, pad: int = 1) -> bool:
+    grid_h, grid_w = occ.shape
+    rr0 = max(0, r0 - pad)
+    cc0 = max(0, c0 - pad)
+    rr1 = min(grid_h, r0 + h + pad)
+    cc1 = min(grid_w, c0 + w + pad)
+    return not bool(occ[rr0:rr1, cc0:cc1].any())
