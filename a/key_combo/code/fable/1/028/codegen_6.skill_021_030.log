+
+    grid = _build_input_grid(shape, walls, blocks)
+    if not _validate_scene(grid, walls, blocks, expect_coupling=coupled):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
