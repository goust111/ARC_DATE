+from arc_utils import Color, colors_present, find_components, paste
+
+
+SIDE_ORDER = ("top", "bottom", "left", "right")
+SIDE_TO_STEP = {
+    "top": (-1, 0),
+    "bottom": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+ALL_COLORS = tuple(range(1, 10))
+GEN_ATTEMPTS = 400
+BLOCK_COUNT_RANGE = (3, 7)
+GRID_HEIGHT_RANGE = (13, 24)
+GRID_WIDTH_RANGE = (13, 24)
