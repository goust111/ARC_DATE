+        blocks.append(
+            {
+                "coords": obj["coords"],
+                "r0": int(r0),
+                "c0": int(c0),
+                "patch": patch,
+                "side": wall_by_color[marker_color],
+                "distance": _distance_to_wall(int(r0), int(c0), h, w, wall_by_color[marker_color], g.shape),
+                "fill_color": fill_color,
+                "marker_color": marker_color,
+            }
