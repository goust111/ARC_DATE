+        r0 = int(block["r0"])
+        c0 = int(block["c0"])
+        step = SIDE_TO_STEP[str(block["side"])]
+
+        moved = 0
+        while _can_place(out, patch, r0 + step[0], c0 + step[1]):
+            r0 += step[0]
+            c0 += step[1]
+            moved += 1
