+                max_d_b = grid_w - w_b - 2
+                if min_d_b > max_d_b:
+                    continue
+                d_b_choices = [d for d in range(min_d_b, max_d_b + 1) if d not in used_distances and d != d_a]
+                if not d_b_choices:
+                    continue
