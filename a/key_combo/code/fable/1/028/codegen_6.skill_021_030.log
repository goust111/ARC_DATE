+def _clear_blocks(grid: np.ndarray, blocks: list[dict]) -> np.ndarray:
+    base = np.asarray(grid, dtype=int).copy()
+    for block in blocks:
+        coords = np.asarray(block["coords"], dtype=int)
+        base[coords[:, 0], coords[:, 1]] = Color.BLACK
