+def _count_bends(coords: np.ndarray) -> int:
+    pts = {tuple(map(int, p)) for p in coords}
+    endpoints = 0
+    bends = 0
+    for r, c in pts:
+        nbrs = []
+        for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+            if (nr, nc) in pts:
