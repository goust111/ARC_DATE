+        sep = int(row[0])
+        lower = g[r + 1 :, :]
+        if lower.size == 0:
+            continue
+        sep_cols = [c for c in range(w) if bool(np.all(lower[:, c] == sep))]
+        panel_ranges = _panel_ranges_from_sep_cols(w, sep_cols)
+        if len(panel_ranges) >= 2:
