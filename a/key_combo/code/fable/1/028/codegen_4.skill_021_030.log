+        for idx, (c0, c1) in enumerate(panel_ranges):
+            panel = grid[divider_r + 1 :, c0 : c1 + 1]
+            claim = sorted(set(map(int, np.unique(panel))) & set(parsed))
+            if claim != [int(claim_order[idx])]:
