+def _panel_ranges_from_sep_cols(width: int, sep_cols: list[int]) -> list[tuple[int, int]]:
+    ranges: list[tuple[int, int]] = []
+    prev = -1
+    for col in sorted(set(int(c) for c in sep_cols)) + [width]:
+        if col - prev > 1:
+            ranges.append((prev + 1, col - 1))
+        prev = col
+    return ranges
