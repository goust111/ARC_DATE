+        if color != claim_color and np.array_equal(rolled, target):
+            return False
+    return True
+
+
+def _panel_pattern(
+    shape: tuple[int, int],
+    claim_color: int,
+    extra_colors: list[int],
+    controller_specs: dict[int, dict[str, int | str]],
+) -> np.ndarray:
+    h, w = shape
+    cells = [(r, c) for r in range(h) for c in range(w)]
+    for _ in range(300):
+        base = random.sample(extra_colors, 3)
