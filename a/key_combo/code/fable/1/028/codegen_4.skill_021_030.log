+        if len(panel_ranges) != len(claim_order):
+            return False
+        if {int(spec["axis"]) for spec in parsed.values()} != {0, 1}:
+            return False
+        if {int(spec["shift"]) for spec in parsed.values()} != {1, 2, 3}:
+            return False
+        if divider_r <= 0 or divider_r >= grid.shape[0] - 1:
+            return False
