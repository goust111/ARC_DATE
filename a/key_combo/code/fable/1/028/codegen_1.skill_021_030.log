+DIRS: dict[str, tuple[int, int]] = {
+    "U": (-1, 0),
+    "D": (1, 0),
+    "L": (0, -1),
+    "R": (0, 1),
+}
+
+ROT_DIR = {
+    "U": "R",
+    "R": "D",
+    "D": "L",
+    "L": "U",
+}
