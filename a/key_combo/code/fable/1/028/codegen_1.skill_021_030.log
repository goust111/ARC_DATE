+
+
+def _boxes_overlap(a: tuple[int, int, int, int], b: tuple[int, int, int, int], pad: int = 1) -> bool:
+    ar0, ac0, ar1, ac1 = map(int, a)
+    br0, bc0, br1, bc1 = map(int, b)
