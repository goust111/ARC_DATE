+        if len(coords) != len(ring) - 1:
+            continue
+
+        missing = list(ring - coords)
+        if len(missing) != 1:
+            continue
+        opening = missing[0]
+        side_hits = [
+            opening[0] == r0,
+            opening[0] == r1,
+            opening[1] == c0,
+            opening[1] == c1,
+        ]
+        if sum(bool(x) for x in side_hits) != 1:
+            continue
+
+        if opening[0] == r0:
