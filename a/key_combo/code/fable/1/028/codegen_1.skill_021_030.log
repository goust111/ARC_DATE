+    r0 = max(0, int(r0) - top)
+    c0 = max(0, int(c0) - left)
+    r1 = min(TEMP_SHAPE[0] - 1, int(r1) + bottom)
+    c1 = min(TEMP_SHAPE[1] - 1, int(c1) + right)
