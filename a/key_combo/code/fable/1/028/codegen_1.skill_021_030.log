+
+    turns = int(rng.integers(0, 4))
+    rot_pos = {name: _rotate_coord(coord, turns) for name, coord in rel_pos.items()}
+    rot_side = {name: _rotate_dir(side, turns) for name, side in rel_side.items()}
+    return rot_pos, rot_side, expected
+
+
+def _sample_bbox(
