  33: def main(grid: np.ndarray) -> np.ndarray:
  34:     """
  35:     Delete each foreign-color object whose bounding box is contained by a larger object of another color.
  36: 
  37:     Input structure
  38:     - The black pixels are the empty canvas, and every other color forms one or more 8-connected monochromatic objects.
  39:     - Some larger foreground objects act as loose U/C-like containers around smaller objects of different colors.
  40:     Rule
  41:     - Find all 8-connected monochromatic non-black objects.
  42:     - Recolor an object to black exactly when its bounding box is contained in the bounding box of a larger object of another color.
  43:     - Keep all other pixels unchanged.
  44:     Key insight
  45:     - The removable objects are identified by containment in another color's rectangular extent, not by their own color or shape.
  46:     """
  47:     g = np.asarray(grid, dtype=int)
  48:     assert g.ndim == 2
  49:     assert np.any(g == 0)
  50: 
  51:     bg = 0
  52:     objects = find_components(g, bg=bg, connectivity=8, monochromatic=True, return_format="dict")
  53:     assert objects
  54: 
  55:     out = g.copy()
  56:     removed_any = False
  57:     for obj in objects:
  58:         contained = [
  59:             other
  60:             for other in objects
  61:             if other is not obj
  62:             and other["color"] != obj["color"]
  63:             and other["area"] > obj["area"]
  64:             and _bbox_contains(other["bbox"], obj["bbox"])
  65:         ]
  66:         if contained:
  67:             assert any(_wholly_in_three_sided_cavity(other, obj) for other in contained)
  68:             coords = obj["coords"]
  69:             out[coords[:, 0], coords[:, 1]] = bg
