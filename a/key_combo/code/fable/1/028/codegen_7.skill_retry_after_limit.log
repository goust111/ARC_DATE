  22:     assert g.ndim == 2, "expected a 2-D grid"
  23:     assert g.shape[0] > 0 and g.shape[1] > 0, "expected a non-empty grid"
  24: 
  25:     top = np.concatenate((g, np.fliplr(g)), axis=1)
  26:     return np.concatenate((top, np.flipud(top)), axis=0)
