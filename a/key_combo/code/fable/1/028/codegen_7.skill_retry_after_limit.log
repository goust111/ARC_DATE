  57: def main(grid: np.ndarray) -> np.ndarray:
  58:     """
  59:     Slide every colored domino straight toward the full red edge wall until it is blocked.
  60: 
  61:     Input structure
  62:     - The background is empty space.
  63:     - One non-background color forms a complete one-cell-thick edge wall and appears nowhere else.
  64:     - Every other foreground object is a monochromatic 4-connected domino, either horizontal or vertical.
  65: 
  66:     Rule
  67:     - Keep the edge wall fixed and clear the other foreground objects from their original positions.
  68:     - The wall side gives the gravity direction: objects move up, down, left, or right toward that wall.
  69:     - Settle dominoes nearest the wall first; each domino slides rigidly along the gravity direction until the next step would hit the wall, another settled domino, or the grid boundary.
  70: 
  71:     Key insight
  72:     - The full edge wall is the only anchor; the output is the gravity-packed state of all remaining dominoes against that wall.
  73:     """
  74:     g = np.asarray(grid, dtype=int)
  75:     bg = get_bg(g)
  76:     wall_color, (dr, dc), wall_mask = _find_wall(g, bg)
  77:     moving_colors = colors_present(g, exclude={bg, wall_color})
  78:     comps = find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=moving_colors)
  79: 
  80:     assert comps, "expected at least one moving domino"
  81:     for comp in comps:
  82:         assert comp["area"] == 2, "expected every moving object to be a domino"
  83: 
  84:     out = np.full_like(g, bg)
  85:     out[wall_mask] = wall_color
  86:     occupied = wall_mask.copy()
  87:     H, W = g.shape
  88:     step = np.array([dr, dc], dtype=int)
  89: 
  90:     for comp in sorted(comps, key=lambda item: _settle_key(item, dr, dc)):
  91:         coords = comp["coords"].astype(int).copy()
  92:         color = int(comp["color"])
  93: 
  94:         while True:
  95:             nxt = coords + step
  96:             in_bounds = (
  97:                 np.all(0 <= nxt[:, 0])
  98:                 and np.all(nxt[:, 0] < H)
  99:                 and np.all(0 <= nxt[:, 1])
 100:                 and np.all(nxt[:, 1] < W)
 101:             )
 102:             if not in_bounds or np.any(occupied[nxt[:, 0], nxt[:, 1]]):
 103:                 break
 104:             coords = nxt
 105: 
 106:         assert not np.any(occupied[coords[:, 0], coords[:, 1]]), "settled domino collision"
 107:         out[coords[:, 0], coords[:, 1]] = color
 108:         occupied[coords[:, 0], coords[:, 1]] = True
 109: 
 110:     return out
