+_GEN_BETWEEN_GAP_RANGE = (2, 4)
+_GEN_RIGHT_GAP_RANGE = (2, 4)
+_GEN_DOOR_COUNT_CHOICES = (3, 4)
+_GEN_MAX_ATTEMPTS = 300
