+def _sample_wall_columns(num_walls: int) -> tuple[int, list[int]] | None:
+    left_gap = random.randint(*_GEN_LEFT_GAP_RANGE)
+    right_gap = random.randint(*_GEN_RIGHT_GAP_RANGE)
