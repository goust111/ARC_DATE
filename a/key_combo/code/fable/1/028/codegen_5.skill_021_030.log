+    width = columns[-1] + 1 + right_gap
+    if width > 30:
+        return None
+    return width, columns
+
+
+def _movement_modes(num_walls: int) -> list[str]:
+    base = ["up", "down", "stay"]
+    if num_walls == 1:
+        return [random.choice(base)]
+    if num_walls == 2:
+        modes = ["up", "down"]
+        random.shuffle(modes)
+        return modes
+
+    modes = base.copy()
+    while len(modes) < num_walls:
+        modes.append(random.choice(base))
+    random.shuffle(modes)
+    return modes
+
