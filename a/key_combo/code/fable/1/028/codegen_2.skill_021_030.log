+from __future__ import annotations
+
+from collections import deque
+from itertools import combinations
+import random
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+COLOR_POOL = [1, 2, 3, 4, 6, 7, 8, 9]
+MIN_RECT_SIDE = 6
+MAX_ATTEMPTS = 400
+
+BBox = tuple[int, int, int, int]
+Coord = tuple[int, int]
