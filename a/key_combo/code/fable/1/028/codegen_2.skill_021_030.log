+        return [((r0, c0), (1, 1)), ((r1, c1), (-1, -1))]
+    return [((r0, c1), (1, -1)), ((r1, c0), (-1, 1))]
+
+
+def _rect_marker_cells(bbox: BBox, diag: int) -> set[Coord]:
+    cells: set[Coord] = set()
+    for corner, step in _rect_corner_specs(bbox, diag):
+        cells |= _marker_cells(corner, step)
+    return cells
