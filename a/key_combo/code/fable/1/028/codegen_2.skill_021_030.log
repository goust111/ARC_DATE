+        (a_corner, a_step), (b_corner, b_step) = infos
+        dr = _sign(b_corner[0] - a_corner[0])
+        dc = _sign(b_corner[1] - a_corner[1])
+        if dr == 0 or dc == 0:
+            continue
+        if (dr, dc) != a_step:
+            continue
+        if (-dr, -dc) != b_step:
+            continue
+
+        rectangles.append(
+            (
+                min(a_corner[0], b_corner[0]),
+                min(a_corner[1], b_corner[1]),
+                max(a_corner[0], b_corner[0]),
+                max(a_corner[1], b_corner[1]),
