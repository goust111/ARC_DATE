+def _partial_overlap(a: BBox, b: BBox) -> bool:
+    inter_r0 = max(a[0], b[0])
+    inter_c0 = max(a[1], b[1])
+    inter_r1 = min(a[2], b[2])
+    inter_c1 = min(a[3], b[3])
