+def _expand_cells(cells: set[Coord], shape: tuple[int, int], radius: int = 1) -> set[Coord]:
+    H, W = shape
+    out: set[Coord] = set()
+    for r, c in cells:
+        for dr in range(-radius, radius + 1):
+            for dc in range(-radius, radius + 1):
+                rr = int(r + dr)
+                cc = int(c + dc)
