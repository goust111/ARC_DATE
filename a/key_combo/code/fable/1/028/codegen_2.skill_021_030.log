+
+def _count_cover(shape: tuple[int, int], rectangles: list[BBox]) -> np.ndarray:
+    counts = np.zeros(shape, dtype=int)
+    for r0, c0, r1, c1 in rectangles:
+        counts[r0 : r1 + 1, c0 : c1 + 1] += 1
