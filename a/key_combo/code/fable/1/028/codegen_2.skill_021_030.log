+
+
+def _marker_cells(corner: Coord, step: Coord) -> set[Coord]:
+    r, c = map(int, corner)
+    dr, dc = map(int, step)
+    return {(r, c), (r + dr, c), (r, c + dc)}
+
+
+def _rect_corner_specs(bbox: BBox, diag: int) -> list[tuple[Coord, Coord]]:
+    r0, c0, r1, c1 = bbox
