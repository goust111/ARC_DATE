+        colored = np.flatnonzero((grid[r] != BG) & (grid[r] != GREY))
+        if len(colored) < 2:
+            continue
+        if not np.all(np.diff(colored) == 1):
+            continue
+        left, right = int(colored[0]), int(colored[-1])
+        if np.any(grid[r, :left] != BG) or np.any(grid[r, right + 1 :] != BG):
