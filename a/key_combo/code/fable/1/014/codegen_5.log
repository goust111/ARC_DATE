+    wall_labels = np.full(grid.shape, -1, dtype=int)
+    enriched = []
+    for index, wall in enumerate(walls):
+        coords = np.asarray(wall["coords"], dtype=int)
+        wall_labels[coords[:, 0], coords[:, 1]] = index
+        mask = _wall_mask(grid.shape, coords)
