+def _wall_variants(grid: np.ndarray) -> tuple[list[dict], np.ndarray]:
+    walls = _sorted_components(
+        find_components(
+            grid,
+            bg=BG,
+            colors=[WALL],
+            connectivity=4,
+            monochromatic=True,
+            return_format="dict",
+        )
+    )
