+def _generate_case() -> tuple[np.ndarray, np.ndarray] | None:
+    H = random.randint(*CANVAS_SIZE_RANGE)
+    W = random.randint(*CANVAS_SIZE_RANGE)
+    grid = np.full((H, W), BG, dtype=int)
