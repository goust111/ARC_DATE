+from arc_utils import (
+    Color,
+    bbox_coords,
+    components_mask,
+    find_components,
+    first_free_location,
+    get_bg,
+    in_bounds,
+    neighbors4,
+    paste,
+)
+
+
+BG = int(Color.BLACK)
+WALL = int(Color.GREY)
+PIECE_COLORS = tuple(color for color in Color.NOT_BLACK if int(color) != WALL)
+
+MAX_GENERATION_ATTEMPTS = 400
+WALL_SIZE_RANGE = (6, 10)
+CANVAS_SIZE_RANGE = (20, 28)
+PLACEMENT_BORDER = 1
+PLACEMENT_PADDING = 2
