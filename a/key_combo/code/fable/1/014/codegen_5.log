+    for wall in sorted(walls, key=lambda item: item["h"] * item["w"], reverse=True):
+        loc = _place_sprite(grid, wall["sprite"])
+        if loc is None:
+            return None
+        wall["origin"] = (int(loc[0]), int(loc[1]))
+        paste(grid, wall["sprite"], loc[0], loc[1], transparent=BG)
