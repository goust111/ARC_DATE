+        sprite[gap["coords"][:, 0], gap["coords"][:, 1]] = BG
+    return sprite
+
+
+def _random_piece_mask(forbidden_keys: set[tuple[int, int, tuple[int, ...]]]) -> np.ndarray | None:
+    for _ in range(120):
