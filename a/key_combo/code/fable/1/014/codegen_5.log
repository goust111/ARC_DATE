+def _gap_option(coords: list[tuple[int, int]]) -> dict:
+    arr = np.array(sorted(coords), dtype=int)
+    mask, box = _mask_from_coords(arr)
+    return {
+        "coords": arr,
+        "bbox": box,
+        "mask": mask,
+        "key": _mask_key(mask),
+    }
