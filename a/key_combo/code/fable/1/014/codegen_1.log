+    square_owner: dict[tuple[int, int], int] = {}
+    for r, c, color in candidates:
+        square_cells = _square_cells((r, c))
+        for cell in square_cells:
+            assert cell not in square_owner, "expected non-overlapping 2x2 squares"
+        directions = {
+            direction
