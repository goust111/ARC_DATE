+                int(rng.integers(r0 - DISTRACTOR_SPAN, r1 + DISTRACTOR_SPAN + 1)),
+                int(rng.integers(c0 - DISTRACTOR_SPAN, c1 + DISTRACTOR_SPAN + 1)),
