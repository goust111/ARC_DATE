+
+BLACK = int(Color.BLACK)
+RED = int(Color.RED)
+GREY = int(Color.GREY)
+
+DIRS = ((-1, -1), (-1, 1), (1, -1), (1, 1))
+SQUARE_OFFSETS = ((0, 0), (0, 1), (1, 0), (1, 1))
+SEED_OFFSETS = {
+    (-1, -1): (-1, -1),
+    (-1, 1): (-1, 2),
+    (1, -1): (2, -1),
