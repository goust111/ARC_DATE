+def _seed_pos(origin: tuple[int, int], direction: tuple[int, int]) -> tuple[int, int]:
+    r, c = origin
+    dr, dc = SEED_OFFSETS[direction]
+    return r + dr, c + dc
+
+
+def _square_cells(origin: tuple[int, int]) -> tuple[tuple[int, int], ...]:
