+    cells: tuple[tuple[int, int], ...] | list[tuple[int, int]],
+) -> int | None:
+    seed_r, seed_c = _seed_pos(origin, direction)
+    dr, dc = direction
+    best: int | None = None
+    for r, c in cells:
+        step = (r - seed_r) * dr
+        if step < 1:
+            continue
+        if c != seed_c + dc * step:
+            continue
+        if r != seed_r + dr * step:
+            continue
+        if best is None or step < best:
+            best = int(step)
+    return best
+
+
+def _first_hit_label(
+    specs: list[NodeSpec],
+    source_idx: int,
+    direction: tuple[int, int],
+    extra_specs: list[NodeSpec] | None = None,
+) -> tuple[tuple[str, int] | None, bool]:
+    best_label: tuple[str, int] | None = None
+    best_step: int | None = None
+    tie = False
+
+    for idx, spec in enumerate(specs):
+        if idx == source_idx:
+            continue
+        step = _ray_step_to_cells(specs[source_idx].origin, direction, _block_cells(spec.origin, spec.directions))
+        if step is None:
+            continue
+        if best_step is None or step < best_step:
+            best_label = ("spec", idx)
+            best_step = step
+            tie = False
+        elif step == best_step:
+            tie = True
+
+    if extra_specs is None:
+        return best_label, tie
+
+    for idx, spec in enumerate(extra_specs):
+        step = _ray_step_to_cells(specs[source_idx].origin, direction, _block_cells(spec.origin, spec.directions))
+        if step is None:
+            continue
+        if best_step is None or step < best_step:
+            best_label = ("extra", idx)
+            best_step = step
+            tie = False
+        elif step == best_step:
+            tie = True
+
+    return best_label, tie
+
+
+def _cells_compatible(a: tuple[tuple[int, int], ...], b: tuple[tuple[int, int], ...]) -> bool:
+    for ra, ca in a:
+        for rb, cb in b:
+            if max(abs(ra - rb), abs(ca - cb)) <= 1:
+                return False
+    return True
