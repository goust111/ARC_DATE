+            loc = _place_random(grid, sprite, bg, rng, padding=1, border=1)
+            if loc is None:
+                ok = False
+                break
+            placed[name] = loc
+            paste(grid, sprite, loc[0], loc[1], transparent=bg, clip=False)
+        if not ok:
+            continue
+
+        expected = np.full((n, n), bg, dtype=int)
+        expected[compressed] = target[compressed]
+        actual = main(grid)
