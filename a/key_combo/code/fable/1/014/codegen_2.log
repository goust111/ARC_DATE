+
+
+def _render_grid(
+    height: int,
+    width: int,
+    pair_specs: list[dict],
+    pair_colors: list[tuple[int, int]],
+    lone_plan: dict,
+    target_idx: int,
+) -> tuple[np.ndarray, np.ndarray]:
+    grid = np.full((height, width), BG, dtype=int)
+    for spec, (left_color, right_color) in zip(pair_specs, pair_colors):
