+        cc = lone_plan["mirror_c0"] + int(c)
+        expected[rr, cc] = int(partner_color)
+    return grid, expected
+
+
+def _valid_scene(
+    grid: np.ndarray,
+    expected: np.ndarray,
+    pair_count: int,
