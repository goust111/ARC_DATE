+    used_axes: set[int] = set()
+    for pair_idx, mask in enumerate(shapes):
+        h, w = map(int, mask.shape)
+        max_gap = min(PAIR_GAP_RANGE[1], width - 2 * w)
+        if max_gap < PAIR_GAP_RANGE[0]:
