+        cc = int(axis2 - c)
+        assert 0 <= rr < g.shape[0] and 0 <= cc < g.shape[1]
+        assert int(out[rr, cc]) == bg, "expected the mirrored partner location to be empty"
+        new_cells.append((rr, cc))
+    for rr, cc in new_cells:
+        out[rr, cc] = int(fill_color)
+    return out
