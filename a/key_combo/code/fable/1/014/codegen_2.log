+from arc_utils import Color, crop_bbox, find_components, get_bg, is_contiguous, paste
+
+
+BG = Color.BLACK
+PALETTE = tuple(Color.NOT_BLACK)
+
+PAIR_COUNT_RANGE = (3, 4)
+SHAPE_HEIGHT_RANGE = (2, 4)
+SHAPE_WIDTH_RANGE = (3, 6)
+PAIR_GAP_RANGE = (2, 6)
+ROW_GAP_MIN = 2
+GRID_MAX = 30
+GEN_MAX_ATTEMPTS = 500
