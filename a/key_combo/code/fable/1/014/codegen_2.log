+            used_axes.add(axis2)
+            specs.append(
+                {
+                    "pair_idx": pair_idx,
+                    "top": int(pair_rows[pair_idx]),
+                    "left_mask": left_mask.astype(bool),
+                    "right_mask": right_mask.astype(bool),
+                    "left_c0": int(left_c0),
+                    "right_c0": int(right_c0),
+                    "axis2": axis2,
+                    "shape": mask.astype(bool),
+                }
+            )
+            placed = True
+            break
+        if not placed:
+            return None
+    return specs
