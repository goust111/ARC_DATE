+    edges, axis_by_pair = _find_pair_edges(objects)
+    matched = _match_all_but_one(len(objects), edges)
+    assert matched is not None, "expected exactly one unpaired object"
+    lone_idx, pairs = matched
+    lone = objects[lone_idx]
