+    paste(
+        expected,
+        _mask_to_sprite(np.fliplr(lone_plan["mask"]), partner_color),
+        lone_plan["top"],
+        lone_plan["mirror_c0"],
+        transparent=BG,
+    )
+    return grid, expected
