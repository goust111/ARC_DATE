+    expected = grid.copy()
+    partner_color = pair_colors[target_idx][1] if lone_plan["side"] == "left" else pair_colors[target_idx][0]
+    paste(
+        expected,
+        _mask_to_sprite(np.fliplr(lone_plan["mask"]), partner_color),
+        lone_plan["top"],
+        lone_plan["mirror_c0"],
+        transparent=BG,
+    )
+    return grid, expected
+
+
+def _valid_scene(
+    grid: np.ndarray,
+    expected: np.ndarray,
+    pair_count: int,
+) -> bool:
+    comps = find_components(
+        grid,
+        bg=BG,
+        connectivity=8,
+        monochromatic=True,
+        return_format="dict",
+    )
+    if len(comps) != 2 * pair_count + 1:
+        return False
+    try:
+        out = main(grid)
+    except Exception:
+        return False
+    return np.array_equal(out, expected)
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_MAX_ATTEMPTS):
