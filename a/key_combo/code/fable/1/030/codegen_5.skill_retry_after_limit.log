0006: def main(grid: np.ndarray) -> np.ndarray:
0007:     """
0008:     Scale up a monochrome control sprite by stamping a polychrome tile at each filled pixel.
0009: 
0010:     Input structure:
0011:     - bg = background color.
0012:     - Two foreground objects (8-connected): a monochrome rectangular sprite with bg holes (control), and a polychrome square tile (block).
0013: 
0014:     Rule:
0015:     - For each cell in the control sprite's bbox: if filled, stamp a copy of the block tile; if bg, leave a tile-sized bg region.
0016:     - Output grid dimensions are (control_h × tile_h) by (control_w × tile_w).
0017: 
0018:     Key insight: The control sprite acts as a binary mask that gets "pixel-scaled" by the tile — each pixel expands to a full tile copy or empty space.
0019:     """
0020:     g = np.array(grid, dtype=int)
