+    for color, side in ports:
+        coord = _boundary_coord(side, h, w)
+        while coord in used:
+            coord = _boundary_coord(side, h, w)
+        used.add(coord)
+        port_locs[color] = coord
+        cells.add(coord)
+        cells.add(_inner_neighbor(side, *coord))
+    for side in SIDE_TO_DIR:
+        if side in used_sides:
+            continue
+        coord = _boundary_coord(side, h, w)
