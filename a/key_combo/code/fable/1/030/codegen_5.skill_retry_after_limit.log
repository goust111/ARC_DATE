+    er, ec = end
+    cells.add((r, c))
+    axes = [0, 1]
+    random.shuffle(axes)
+    for axis in axes:
+        while (axis == 0 and r != er) or (axis == 1 and c != ec):
+            if axis == 0:
+                r += 1 if er > r else -1
+            else:
+                c += 1 if ec > c else -1
+            cells.add((r, c))
