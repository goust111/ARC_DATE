0042:     h = bbox_h(sprite_bbox)
0043:     w = bbox_w(sprite_bbox)
0044:     assert h % 2 == 1 and w % 2 == 1
0045: 
0046:     patch = g[r0 : r1 + 1, c0 : c1 + 1]
0047:     assert int(patch[h // 2, w // 2]) != bg
0048: 
0049:     paste_r = marker_r - h // 2
0050:     paste_c = marker_c - w // 2
0051:     assert 0 <= paste_r and 0 <= paste_c
0052:     assert paste_r + h <= g.shape[0] and paste_c + w <= g.shape[1]
0053: 
0054:     target = g[paste_r : paste_r + h, paste_c : paste_c + w]
0055:     assert bool(np.all((target == bg) | (target == Color.GREY)))
0056: 
0057:     out = g.copy()
0058:     out[marker_r, marker_c] = bg
0059:     paste(out, patch, paste_r, paste_c, transparent=bg)
0060:     return out
