+        grid[:, :lw] = legend
+        grid[:, lw] = divider
+        grid[:, lw + 1 :] = main_region
+        return grid, (0, lw + 1)
+    grid = np.full((mh, mw + 1 + lw), bg, dtype=int)
+    grid[:, :mw] = main_region
+    grid[:, mw] = divider
+    grid[:, mw + 1 :] = legend
