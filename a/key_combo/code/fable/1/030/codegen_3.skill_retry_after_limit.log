def all_matchings(points):
    points = tuple(sorted(points))
    out = []
    def rec(rest, cur):
        if not rest:
            pairs = tuple(sorted(tuple(sorted(p)) for p in cur))
            out.append(pairs)
            return
        a = rest[0]
