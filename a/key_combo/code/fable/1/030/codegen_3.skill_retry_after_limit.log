+    out[top_pad : top_pad + h, left_pad : left_pad + w] = local
+    return out
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        branch = random.choice(["four", "six"])
+        local = _build_local(branch)
+        grid = _random_canvas(local, int(get_bg(local)))
