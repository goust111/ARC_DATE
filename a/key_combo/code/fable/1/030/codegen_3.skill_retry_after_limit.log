        struct = STRUCT4 if int(connectivity) == 4 else STRUCT8
        for col in colors_iter:
            lab, n = label(grid == int(col), structure=struct)
            for k in range(1, int(n) + 1):
                m = (lab == k)
                if int(m.sum()) < int(min_area):
                    continue
                obj = np.full_like(grid, bg)
                obj[m] = int(col)
                objs.append(obj)
        return objs


