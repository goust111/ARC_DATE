+    block_rows = random.randint(*BLOCK_GRID_RANGE)
+    block_cols = random.randint(*BLOCK_GRID_RANGE)
+    max_block_h = min(BLOCK_SIZE_RANGE[1], 30 // block_rows)
+    max_block_w = min(BLOCK_SIZE_RANGE[1], 30 // block_cols)
