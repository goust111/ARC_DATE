+            patch = mask[:dh, :dw]
+            if np.array_equal(np.tile(patch, (h // dh, w // dw)), mask):
+                return True
+    return False
+
+
+def _random_prototype(block_h: int, block_w: int, bg: int) -> np.ndarray | None:
+    palette = random.sample([c for c in COLOR_POOL if c != bg], k=random.choice((2, 3)))
