+        mask = np.array(
+            [[random.random() < density for _ in range(block_cols)] for _ in range(block_rows)],
+            dtype=bool,
+        )
+        count = int(mask.sum())
+        if count < 5 or count > total - 3:
+            continue
+        if not np.all(mask.any(axis=0)) or not np.all(mask.any(axis=1)):
+            continue
+        if _mask_has_period(mask):
