+    top_left_c = int(sprite_coords[:, 1].min())
+    bottom_right_r = int(sprite_coords[:, 0].max())
+    bottom_right_c = int(sprite_coords[:, 1].max())
+    sprite_patch = sprite_patch[top_left_r : bottom_right_r + 1, top_left_c : bottom_right_c + 1]
