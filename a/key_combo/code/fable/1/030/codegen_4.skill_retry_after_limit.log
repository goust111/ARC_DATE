+    wanted: Counter,
+) -> list[tuple[int, int]]:
+    qh, qw = map(int, quadrant_shape)
+    sh, sw = map(int, sprite_patch.shape)
+    origins: list[tuple[int, int]] = []
+    for r0 in range(qh - sh + 1):
+        for c0 in range(qw - sw + 1):
