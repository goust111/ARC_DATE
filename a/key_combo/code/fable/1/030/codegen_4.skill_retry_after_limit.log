            catalog.append(mask)
    unique: dict[tuple[tuple[int, ...], ...], np.ndarray] = {}
    for mask in catalog:
        key = tuple(tuple(int(v) for v in row) for row in mask)
        unique.setdefault(key, mask)
    return list(unique.values())


