+    mask = np.zeros((h, w), dtype=bool)
+    for r in range(h):
+        for c in range(w):
+            expected: list[int] = []
+            for name in OTHER_WINDOWS:
+                dr, dc = relative_offsets[name]
+                rr = r - dr
+                cc = c - dc
+                if 0 <= rr < h and 0 <= cc < w:
+                    expected.append(int(other_quadrants[name][rr, cc]))
+            if not expected:
