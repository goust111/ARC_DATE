+    min_coverage: int,
+) -> tuple[int, int]:
+    h, w = map(int, patch.shape)
+    candidates: list[tuple[tuple[int, int, int], int, int]] = []
+    for off_r in range(-h + 1, h):
+        for off_c in range(-w + 1, w):
+            matches = 0
+            mismatches = 0
+            for r in range(h):
+                for c in range(w):
+                    key = (off_r + r, off_c + c)
+                    if key not in master:
+                        continue
+                    if int(patch[r, c]) == master[key]:
