from arc_utils import Color, bbox, colors_present, crop_bbox, find_components, get_bg, paste


def perimeter_mask(shape, box):
    r0,c0,r1,c1 = map(int, box)
    m = np.zeros(shape, dtype=bool)
    m[r0, c0:c1+1] = True
    m[r1, c0:c1+1] = True
    m[r0:r1+1, c0] = True
    m[r0:r1+1, c1] = True
    return m


def topo_order_from_frame(frame_patch, bg):
    frame_colors = colors_present(frame_patch, exclude={bg})
    perims = {color: perimeter_mask(frame_patch.shape, bbox(frame_patch == color)) for color in frame_colors}
    edges = {color: set() for color in frame_colors}
    indeg = {color: 0 for color in frame_colors}
    for i, a in enumerate(frame_colors):
        for bcol in frame_colors[i+1:]:
            inter = perims[a] & perims[bcol]
            if not np.any(inter):
                continue
            visible = set(map(int, np.unique(frame_patch[inter]))) - {bg}
            assert len(visible) == 1 and visible <= {a, bcol}
            top = next(iter(visible))
            bottom = bcol if top == a else a
            if top not in edges[bottom]:
                edges[bottom].add(top)
                indeg[top] += 1
    order = []
    frontier = sorted(color for color in frame_colors if indeg[color] == 0)
    while frontier:
        assert len(frontier) == 1, frontier
        cur = frontier.pop()
        order.append(cur)
        for nxt in sorted(edges[cur]):
            indeg[nxt] -= 1
            if indeg[nxt] == 0:
                frontier.append(nxt)
                frontier.sort()
    assert len(order) == len(frame_colors)
    return order


