            seen = set(map(int, np.unique(frame_patch[inter]))) - {bg}
            assert len(seen) == 1, (a, bcol, seen)
            top = next(iter(seen))
            assert top in {a, bcol}
            bottom = bcol if top == a else a
            if top not in edges[bottom]:
                edges[bottom].add(top)
                indeg[top] += 1
    order = []
    frontier = sorted(color for color in cols if indeg[color] == 0)
    while frontier:
        assert len(frontier) == 1, frontier
        cur = frontier.pop()
        order.append(cur)
        for nxt in sorted(edges[cur]):
            indeg[nxt] -= 1
            if indeg[nxt] == 0:
                frontier.append(nxt)
                frontier.sort()
    assert len(order) == len(cols)
    return order


def make_panel_mask(h, w):
