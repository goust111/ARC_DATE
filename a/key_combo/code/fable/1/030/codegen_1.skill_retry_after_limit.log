        patch = patches[color]
        mask = patch "'!= bg
        out[mask] = patch[mask]
    return out


def recover_order(frame_patch, bg, expected_colors=None):
    cols = colors_present(frame_patch, exclude={bg})
    if expected_colors is not None:
        assert set(cols) == set(expected_colors)
    perims = {}
    for color in cols:
        b = bbox(frame_patch == color)
        assert b is not None
        perims[color] = perimeter_mask(frame_patch.shape, b)
    edges = {color: set() for color in cols}
    indeg = {color: 0 for color in cols}
    for i, a in enumerate(cols):
        for bcol in cols[i+1:]:
