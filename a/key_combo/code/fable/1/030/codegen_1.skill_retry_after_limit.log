        assert len(frontier) == 1, frontier
        cur = frontier.pop()
        order.append(cur)
        for nxt in sorted(edges[cur]):
            indeg[nxt] -= 1
            if indeg[nxt] == 0:
                frontier.append(nxt)
                frontier.sort()
    assert len(order) == len(frame_colors)
    return order


def solve(grid):
    g = np.asarray(grid, dtype=int)
    bg = int(get_bg(g))
    comps = find_components(g, bg=bg, connectivity=4, monochromatic=False)
    panel_patches = {}
    frame_patch = None
    panel_shape = None
    for comp in comps:
        patch = crop_bbox(g, comp['bbox'])
        cols = colors_present(patch, exclude={bg})
        print('comp bbox', comp['bbox'], 'colors', cols, 'shape', patch.shape)
        if len(cols) == 1:
            color = int(cols[0])
            if panel_shape is None:
                panel_shape = patch.shape
            assert patch.shape == panel_shape
            panel_patches[color] = patch
        else:
            assert frame_patch is None
            frame_patch = patch
    assert frame_patch is not None
    order = topo_order_from_frame(frame_patch, bg)
    print('order', order, 'panels', panel_patches.keys())
    assert set(order) == set(panel_patches)
    out = np.full(panel_shape, bg, dtype=int)
    for color in order:
        patch = panel_patches[color]
        m = patch "'!= bg
        out[m] = patch[m]
    return out

