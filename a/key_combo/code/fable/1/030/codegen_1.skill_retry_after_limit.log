                c0 = 0 if vc > 1 else vc
            else:
                r0 = h - 2 if hr < h - 2 else hr
                c0 = w - 2 if vc < w - 2 else vc
            m[r0:r0+2, c0:c0+2] = True
        if m[0].any() and m[-1].any() and m[:,0].any() and m[:,-1].any():
            return m
    return None


