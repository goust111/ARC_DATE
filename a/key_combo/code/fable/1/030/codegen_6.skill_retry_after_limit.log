+    frame_idx = None
+    frame_patch = None
+    for idx, comp in enumerate(comps):
+        patch = _component_patch(grid, comp, bg)
+        if _extract_frame_infos(patch, bg) is not None:
+            assert frame_idx is None, "expected exactly one frame cluster"
+            frame_idx = idx
+            frame_patch = patch
