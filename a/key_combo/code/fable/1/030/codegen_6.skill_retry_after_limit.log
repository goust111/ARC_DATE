ORIENTATIONS = (ORIENTATION_ROWS, "cols")
AXIS_SIZE_CHOICES = [10, 12, 14, 16, 18]
CROSS_SIZE_RANGE = (10, 19)
BG_COLOR = 0
MARKER_COLOR = 1
BAR_COLOR_CHOICES = np.arange(2, 10)
