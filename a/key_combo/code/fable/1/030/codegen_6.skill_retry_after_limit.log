import random, itertools
H=W=16

def perim(b):
    r0,c0,r1,c1=b
    s=set()
    for c in range(c0,c1+1):
        s.add((r0,c)); s.add((r1,c))
    for r in range(r0,r1+1):
        s.add((r,c0)); s.add((r,c1))
    return s

def rand_bbox():
    h=random.randint(5,10)
    w=random.randint(5,10)
    r0=random.randint(0,H-h)
    c0=random.randint(0,W-w)
    return (r0,c0,r0+h-1,c0+w-1)

ok=0
for t in range(50000):
    bbs=[rand_bbox() for _ in range(3)]
    # distinct side coordinates helps avoid shared segments
    rows=[x for b in bbs for x in (b[0],b[2])]
    cols=[x for b in bbs for x in (b[1],b[3])]
    if len(set(rows))<len(rows) or len(set(cols))<len(cols):
        continue
    ps=[perim(b) for b in bbs]
    good=True; counts=[]
    for a,b in itertools.combinations(range(3),2):
        inter=ps[a]&ps[b]
        counts.append(len(inter))
        if len(inter) not in (2,4):
            good=False
    triple=ps[0]&ps[1]&ps[2]
    if triple:
        good=False
    if good:
        ok+=1
        print('found',bbs,counts)
        if ok>=10:
            break
print('ok',ok)
