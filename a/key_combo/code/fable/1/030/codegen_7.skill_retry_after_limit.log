+    span_w = max_c - min_c + 1
+
+    top = random.randint(*MARGIN_RANGE)
+    left = random.randint(*MARGIN_RANGE)
+    bottom = random.randint(*MARGIN_RANGE)
+    right = random.randint(*MARGIN_RANGE)
