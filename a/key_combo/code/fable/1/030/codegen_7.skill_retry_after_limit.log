+    out = np.full(proto_mask.shape, bg, dtype=int)
+    out[proto_mask] = bottom_color
+    return out
+
+
+# --------------- generator ---------------
+
+GEN_ATTEMPTS = 600
+PROTO_ATTEMPTS = 120
+CHAIN_ATTEMPTS = 120
+BG_COLORS = tuple(range(10))
+STAMP_COUNT_CHOICES = (3, 4)
+PROTO_H_RANGE = (4, 6)
+PROTO_W_RANGE = (4, 6)
+PROTO_AREA_RANGE = (7, 12)
+MARGIN_RANGE = (1, 4)
+MAX_GRID_SIDE = 30
