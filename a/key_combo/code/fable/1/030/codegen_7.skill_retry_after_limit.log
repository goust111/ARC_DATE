+    seen_colors: set[int] = set()
+    cur = starts[0]
+    while True:
+        assert cur not in seen_colors, "overlap chain must be acyclic"
+        order.append(cur)
+        seen_colors.add(cur)
+        if not out_edges[cur]:
+            break
+        cur = next(iter(out_edges[cur]))
