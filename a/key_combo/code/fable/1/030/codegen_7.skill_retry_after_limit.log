+            hidden_local = {(r, c) for r, c in proto_cells if (r + dr, c + dc) in proto_cells}
+            visible_local = proto_cells - hidden_local
+            visible_count = len(visible_local)
+            if visible_count < 3 or visible_count >= area:
+                continue
+            catalog.append(
