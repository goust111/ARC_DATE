+        mask = _tight_mask(cells)
+        mh, mw = mask.shape
+        area = int(mask.sum())
+        if mh < 3 or mw < 3 or area < 7:
+            continue
+        if area == mh * mw:
+            continue
+        if np.array_equal(mask, np.fliplr(mask)) or np.array_equal(mask, np.flipud(mask)):
