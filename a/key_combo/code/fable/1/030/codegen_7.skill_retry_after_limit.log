  "type": "move_to_match",
  "src": "right-panel monochromatic object s",
  "dst": "left-panel 4-connected background hole-region d inside the single-color template",
  "match_cond": "s.normalized_mask == d.normalized_mask",
  "transform": "return the left panel and recolor each d with matched s.color",
  "grid_shape": "left input panel"
}
</annotation>
</reference_puzzle>

