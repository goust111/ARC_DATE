+        return None
+
+    if not _valid_proof_state(broken, full_bbox, abs_line_rows, abs_line_cols):
+        return None
+
+    blue_coords = [tuple(map(int, rc)) for rc in np.argwhere(broken == BLUE)]
+    _RNG.shuffle(blue_coords)
