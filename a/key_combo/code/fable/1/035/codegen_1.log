+    broken = grid.copy()
+    interior_rows = [r0 + rr for span in local_row_spans for rr in span]
+    interior_cols = [c0 + cc for span in local_col_spans for cc in span]
+    internal_line_rows = abs_line_rows[1:-1]
+    internal_line_cols = abs_line_cols[1:-1]
