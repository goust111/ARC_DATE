    bar_mask[r, c:c1] = True
    fill_mask[r + 1 : r + 1 + motif_h, c:c1] = True
    motif_mask[r + 1 : r + 1 + motif_h, c : c + motif_w] = True
    if r + 1 + motif_h < GEN_GRID_H:
