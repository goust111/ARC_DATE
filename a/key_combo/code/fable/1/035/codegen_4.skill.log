+        left2, right2 = _sample_leaf_span(c, leaf_b_len, unequal=True)
+        h1 = BarSpec(HORIZONTAL, y1, c - left1, c + right1, colors[1])
+        h2 = BarSpec(HORIZONTAL, y2, c - left2, c + right2, colors[2])
+        local = [v, h1, h2]
