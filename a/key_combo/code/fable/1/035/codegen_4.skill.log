+    return grid
+
+
+def _generator_oracle_matches(grid: np.ndarray, specs: list[BarSpec]) -> bool:
+    expected = _solve_from_specs(grid.shape, specs, BACKGROUND)
+    try:
+        actual = main(grid)
+    except Exception:
