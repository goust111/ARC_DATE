def _paint_marker(grid: np.ndarray, expected: np.ndarray, r: int, c0: int, color: int) -> None:
    grid[r, c0] = color
    cols = np.arange(c0, grid.shape[1])
    expected[r, c0:] = np.where((cols - c0) % 2 == 0, color, _GEN_SEPARATOR_COLOR)


