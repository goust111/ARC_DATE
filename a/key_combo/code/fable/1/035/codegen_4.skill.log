        if c0 == c1 and r0 < r1:
            _paint_from_vertical_bar(g, out, bar["bbox"], bg)
        elif r0 == r1 and c0 < c1:
            _paint_from_horizontal_bar(g, out, bar["bbox"], bg)
        else:
            raise AssertionError(f"grey component is not a straight bar: {bar['bbox']}")

    return out

