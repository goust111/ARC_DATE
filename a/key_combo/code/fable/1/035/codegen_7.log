        r = int(r_raw)
        c0 = int(c_raw)
        marker_color = int(g[r, c0])
        assert marker_color != Color.GREY, "marker cannot use the separator color"

        for c in range(c0, width):
            out[r, c] = marker_color if (c - c0) % 2 == 0 else Color.GREY

    return out

