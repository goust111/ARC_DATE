+    if coords.size == 0:
+        return False
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    view = mask[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1]
+    return bool(np.all(view) and int(view.size) == int(mask.sum()))
