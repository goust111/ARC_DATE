    sr, sc = map(int, start)
    target = int(grid[sr, sc])
    q = deque([(sr, sc)])
    seen = {(sr, sc)}
    cells: list[tuple[int, int]] = []

    while q:
        r, c = q.popleft()
        cells.append((r, c))
        for nr, nc in _neighbors4(r, c):
            if not in_bounds(grid.shape, nr, nc):
