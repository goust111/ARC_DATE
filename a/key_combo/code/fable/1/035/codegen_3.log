    pos = tuple(map(int, start))
    directions = _spiral_directions(marker_color)
    direction_index = 0
    segment_length = 1
    trace: list[tuple[int, int]] = []

    while True:
        for _ in range(2):
            dr, dc = directions[direction_index % 4]
            for _ in range(segment_length):
                nr = pos[0] + dr
                nc = pos[1] + dc
                if not in_bounds(shape, nr, nc):
