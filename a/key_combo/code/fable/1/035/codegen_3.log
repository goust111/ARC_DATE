+def _spiral_hit_info(
+    grid: np.ndarray,
+) -> tuple[int, tuple[int, int], int, list[tuple[int, int]], tuple[int, int], int]:
+    bg = get_bg(grid)
+    marker, marker_color = _find_marker(grid, bg)
