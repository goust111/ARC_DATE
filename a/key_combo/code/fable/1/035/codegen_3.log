+    coords = np.argwhere(marker_mask)
+    assert coords.shape[0] == 1, "expected exactly one red/blue marker"
+    r, c = map(int, coords[0])
+    color = int(grid[r, c])
+    for nr, nc in _neighbors8(r, c):
