+def _all_block_components(
+    grid: np.ndarray, bg: int, marker: tuple[int, int]
+) -> list[list[tuple[int, int]]]:
+    h, w = map(int, grid.shape)
+    visited = np.zeros((h, w), dtype=bool)
+    visited[marker] = True
+    components: list[list[tuple[int, int]]] = []
+
+    for r in range(h):
