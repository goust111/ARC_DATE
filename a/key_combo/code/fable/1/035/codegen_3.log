+def _pick_start(size: int) -> tuple[int, int]:
+    lo = max(2, int(round(size * START_FRACTION_LOW)))
+    hi = min(size - 3, int(round(size * START_FRACTION_HIGH)))
+    if lo > hi:
+        lo, hi = 2, size - 3
+    return lo, hi
