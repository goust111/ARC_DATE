+GRID_W_RANGE = (14, 28)
+START_FRACTION_LOW = 0.25
+START_FRACTION_HIGH = 0.75
+MIN_PREFIX_STEPS = 7
+MAX_HIT_INDEX = 60
+MIN_BLOCK_SIZE = 1
+MAX_BLOCK_SIZE = 6
