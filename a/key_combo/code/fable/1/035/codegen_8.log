+def _paint_rolled_copies(out: np.ndarray, spec: dict) -> np.ndarray:
+    motif = spec["motif"]
+    r0, c0, r1, c1 = spec["bar_bbox"]
+    mr0, mc0, mr1, mc1 = spec["motif_bbox"]
+    orientation = spec["orientation"]
