+    max_h = min(9, h - 2)
+    max_w = min(9, w - 2)
+    if max_h < 4 or max_w < 4:
+        return None
+
+    box_h = int(rng.integers(4, max_h + 1))
+    box_w = int(rng.integers(4, max_w + 1))
+    r0 = int(rng.integers(1, h - box_h))
+    c0 = int(rng.integers(1, w - box_w))
+    r1 = r0 + box_h - 1
+    c1 = c0 + box_w - 1
+
