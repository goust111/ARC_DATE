    if not (lo <= off_blue_rate <= hi):
        return False

    try:
        actual = main(inp)
    except Exception:
        return False
    return np.array_equal(actual, out)


def _gen_attempt() -> np.ndarray | None:
    grid_h, box_h, top_pad, _bottom_pad = _gen_choose_bbox_rows()
