+            same_v = v_gaps[i] == v_gaps[j] and h_gaps[i] != h_gaps[j]
+            same_h = h_gaps[i] == h_gaps[j] and v_gaps[i] != v_gaps[j]
+            if same_v:
+                break
+        else:
+            continue
+        break
+    else:
+        return False
+
+    for i in range(len(v_gaps)):
+        for j in range(i + 1, len(v_gaps)):
+            if h_gaps[i] == h_gaps[j] and v_gaps[i] != v_gaps[j]:
