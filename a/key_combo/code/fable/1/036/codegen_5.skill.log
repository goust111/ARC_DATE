+
+GREY = 5
+BG = 0
+OBJECT_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+CORNER_TYPES = (
+    ("top", "left"),
+    ("top", "right"),
+    ("bottom", "left"),
+    ("bottom", "right"),
+)
+MAX_SIDE = 30
+OUTER_MARGIN = 1
+INTER_BAND_GAP = 1
+GENERATION_RETRIES = 400
+
+
+Coord = tuple[int, int]
+BBox = tuple[int, int, int, int]
+
+
+def get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.flatten())).most_common(1)[0][0])
+
+
+def bbox_coords(coords: np.ndarray) -> BBox:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _neighbors4(r: int, c: int) -> list[Coord]:
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def components_mask(mask: np.ndarray) -> list[np.ndarray]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            cells: list[Coord] = []
+            while stack:
+                rr, cc = stack.pop()
+                cells.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(cells, dtype=int))
+    return comps
+
+
+def _find_objects(grid: np.ndarray, bg: int) -> list[dict]:
+    objects: list[dict] = []
+    colors = sorted(set(map(int, grid.flatten())) - {bg, GREY})
+    for color in colors:
+        for coords in components_mask(grid == color):
+            objects.append(
+                {
+                    "color": int(color),
+                    "coords": coords,
+                    "bbox": bbox_coords(coords),
+                    "cells": frozenset(map(tuple, coords.tolist())),
+                }
+            )
+    return objects
+
+
+def _vertical_hit(grid: np.ndarray, obj: dict, marker: Coord, bg: int) -> tuple[str, int] | None:
