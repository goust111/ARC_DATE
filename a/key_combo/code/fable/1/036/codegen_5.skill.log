+
+    if r < r0:
+        side = "top"
+        rr = r + 1
+        gap = 0
+        while rr < h:
+            value = int(grid[rr, c])
+            if value == bg:
+                gap += 1
+                rr += 1
+                continue
+            if gap >= 1 and (rr, c) in obj["cells"]:
