+    if r > r1:
+        side = "bottom"
+        rr = r - 1
+        gap = 0
+        while rr >= 0:
+            value = int(grid[rr, c])
+            if value == bg:
+                gap += 1
+                rr -= 1
+                continue
+            if gap >= 1 and (rr, c) in obj["cells"]:
+                return side, gap
+            return None
+
+    return None
+
+
+def _horizontal_hit(grid: np.ndarray, obj: dict, marker: Coord, bg: int) -> tuple[str, int] | None:
