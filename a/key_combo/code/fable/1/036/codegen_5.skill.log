+def _sample_specs() -> list[dict] | None:
+    n = random.choices([2, 3], weights=[1, 4], k=1)[0]
+    colors = random.sample(list(OBJECT_COLORS), n)
+    corners = random.sample(list(CORNER_TYPES), n)
