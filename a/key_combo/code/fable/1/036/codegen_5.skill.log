+    specs = []
+    for idx in range(n):
+        height, width = sizes[idx]
+        v_side, h_side = corners[idx]
+        specs.append(
+            {
+                "color": colors[idx],
+                "height": height,
+                "width": width,
+                "v_gap": int(v_gaps[idx]),
+                "h_gap": int(h_gaps[idx]),
+                "v_side": v_side,
+                "h_side": h_side,
+                "marker_row_offset": random.randrange(height),
