+def _layout_axis(band_sizes: list[int]) -> tuple[int, dict[int, int]] | None:
+    n = len(band_sizes)
+    order = random.sample(range(n), n)
+    required = (
+        2 * OUTER_MARGIN
+        + sum(band_sizes[idx] for idx in order)
