+def _make_affine_core(n: int, palette: np.ndarray) -> np.ndarray:
+    rr, cc = np.indices((n, n))
+    k = len(palette)
+    row_step = int(_RNG.integers(1, k))
+    col_step = int(_RNG.integers(1, k))
+    offset = int(_RNG.integers(0, k))
