                "color": int(comp["color"]),
                "coords": coords,
                "rel": [tuple(map(int, rc)) for rc in rel.tolist()],
                "area": int(comp["area"]),
            }
        )

    assert sprites
    tiling = _unique_tiling(sprites, holes)

    out = g.copy()
    for comp in grey_components:
