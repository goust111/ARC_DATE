+            break
+        rect_h = _randint_inclusive(rng, 1, min(4, h))
+        rect_w = _randint_inclusive(rng, 1, min(5, max(1, w - 1)))
+        if rect_w >= w:
+            continue
+        r0 = _randint_inclusive(rng, 0, h - rect_h)
+        c0 = _randint_inclusive(rng, 0, w - rect_w)
+        rect = (r0, c0, r0 + rect_h - 1, c0 + rect_w - 1)
