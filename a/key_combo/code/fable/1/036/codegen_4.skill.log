+    h, w = scene_shape
+    avoid = (
+        max(0, target_bbox[0] - 1),
+        max(0, target_bbox[1] - 1),
+        min(h - 1, target_bbox[2] + 1),
+        min(w - 1, target_bbox[3] + 1),
+    )
