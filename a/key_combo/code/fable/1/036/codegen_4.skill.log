    r0, c0, h, w = rect
    return r0, c0, r0 + h - 1, c0 + w - 1


def _gen_rects_conflict(a, b):
    ar0, ac0, ar1, ac1 = _gen_rect_bounds(a)
    br0, bc0, br1, bc1 = _gen_rect_bounds(b)
    rows_overlap = ar0 <= br1 and br0 <= ar1
