    if target < 0 or target > int(allowed.sum()):
        return None
    mask = np.zeros(shape, dtype=bool)
    if target == 0:
        return mask

    options = np.arange(1, min(max_components, target) + 1)
    weights = options.astype(float)
    weights /= weights.sum()
