+
+def _find_separator_row(grid: np.ndarray, bg: int) -> int:
+    rows = [
+        r
+        for r in range(grid.shape[0])
+        if np.all(grid[r] == grid[r, 0]) and int(grid[r, 0]) != bg
+    ]
+    assert len(rows) == 1, "expected exactly one full non-background separator row"
+    return int(rows[0])
