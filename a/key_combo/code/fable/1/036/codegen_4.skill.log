+def _normalize_coords(coords: np.ndarray) -> tuple[tuple[int, int], ...]:
+    arr = np.asarray(coords, dtype=int)
+    arr = arr - arr.min(axis=0)
+    return tuple(sorted((int(r), int(c)) for r, c in arr.tolist()))
