+def _randint_inclusive(rng: np.random.Generator, lo: int, hi: int) -> int:
+    return int(rng.integers(int(lo), int(hi) + 1))
+
+
+def _bbox_from_cells(cells: set[tuple[int, int]]) -> tuple[int, int, int, int]:
