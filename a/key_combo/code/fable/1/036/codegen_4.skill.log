+    ((0, 0), (0, 2), (1, 0), (1, 1), (1, 2)),            # U pentomino
+    ((0, 0), (1, 0), (1, 1), (2, 1), (2, 2)),            # W pentomino
+    ((0, 1), (1, 0), (1, 1), (1, 2), (2, 0)),            # F-like pentomino
+    ((0, 1), (1, 0), (1, 1), (1, 2), (2, 1)),            # plus pentomino
+    ((0, 1), (1, 1), (2, 0), (2, 1), (3, 1)),            # Y-like pentomino
+)
+
+_RNG = np.random.default_rng()
