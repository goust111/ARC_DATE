+    r0, c0, r1, c1 = _bbox_from_cells(target_cells)
+    row_lo = max(0, r0 - 1)
+    row_hi = min(h - 1, r1 + 1)
+    col_lo = max(0, c0 - 1)
+    col_hi = min(w - 1, c1 + 1)
