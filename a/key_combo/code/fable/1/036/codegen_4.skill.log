+    target_area = len(target_cells)
+    for _ in range(240):
+        idxs = rng.choice(len(candidates), size=block_count, replace=False)
+        covered: set[tuple[int, int]] = set()
+        rects: list[tuple[int, int, int, int]] = []
+        ok = True
+        for idx in idxs.tolist():
