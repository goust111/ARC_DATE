+    inp, expected = _build_input_from_spec(
+        bg=bg,
+        separator=separator,
+        width=width,
+        top_h=top_h,
+        scene_h=scene_h,
+        legend_shapes=legend_shapes,
+        legend_colors=legend_colors,
+        gaps=gaps,
+        target_index=target_index,
