    for c, color in zip(marker_cols, colors):
        out[MARKER_ROW, c] = color

    inp = out.copy()
    for r0, c0, h, w in rects:
        inp[r0 : r0 + h, c0 : c0 + w] = GREY_COLOR
    return inp, out


