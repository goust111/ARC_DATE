    if rects is None:
        return None
    marker_cols = _gen_marker_columns(rects)
    if marker_cols is None:
        return None

    inp, out = _gen_render_pair(rects, colors, marker_cols)
    try:
        return inp if np.array_equal(main(inp), out) else None
    except Exception:
        return None


