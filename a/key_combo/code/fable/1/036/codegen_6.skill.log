+        col_center = random.choice(col_candidates)
+        v_spec = _random_spec(shape, v_side, colors[v_idx], ks[v_idx], fixed_center=col_center)
+        h_spec = _random_spec(shape, h_side, colors[h_idx], ks[h_idx], fixed_center=row_center)
