+def _search_tail(
+    cur: tuple[int, int],
+    visited: set[tuple[int, int]],
+    steps_left: int,
+    used_colors: set[int],
+    max_h: int,
+    max_w: int,
+    rng: np.random.Generator,
+    require_all_colors: bool,
+    bbox: tuple[int, int, int, int],
+    strict_path: bool = False,
+) -> list[int] | None:
+    if steps_left == 0:
+        if require_all_colors and len(used_colors) < len(INSTRUCTION_COLORS):
+            return None
+        return []
