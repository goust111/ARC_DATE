+            continue
+        new_used = used_colors | {color}
+        missing_after = sum(color_id not in new_used for color_id in INSTRUCTION_COLORS)
+        if require_all_colors and steps_left - 1 < missing_after:
+            continue
+        onward = 0
+        for dr2, dc2 in COLOR_TO_DELTA.values():
+            probe = (nr + dr2, nc + dc2)
+            if probe in visited:
+                continue
+            pr0 = min(nr0, probe[0])
+            pc0 = min(nc0, probe[1])
+            pr1 = max(nr1, probe[0])
+            pc1 = max(nc1, probe[1])
