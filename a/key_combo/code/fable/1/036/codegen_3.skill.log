+def _render_instance(
+    snake_positions: list[tuple[int, int]],
+    trajectory_moves: list[int],
+    trajectory_positions: list[tuple[int, int]],
+    rng: np.random.Generator,
+) -> np.ndarray:
+    snake_bbox = _bbox_coords(snake_positions)
