+
+
+def _build_unique_trajectory(rng: np.random.Generator) -> list[int]:
+    for _ in range(200):
+        length = int(rng.integers(7, 13))
+        max_h = int(rng.integers(4, 7))
+        max_w = int(rng.integers(4, 7))
