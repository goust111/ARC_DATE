+    positions = [pos]
+    for color in moves:
+        dr, dc = COLOR_TO_DELTA[color]
+        pos = (pos[0] + dr, pos[1] + dc)
+        positions.append(pos)
+    return positions
+
+
+def _turn_count(moves: list[int]) -> int:
+    deltas = [COLOR_TO_DELTA[color] for color in moves]
+    return sum(a != b for a, b in zip(deltas, deltas[1:]))
