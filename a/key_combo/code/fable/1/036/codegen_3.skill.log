+            if probe in visited:
+                continue
+            pr0 = min(nr0, probe[0])
+            pc0 = min(nc0, probe[1])
+            pr1 = max(nr1, probe[0])
+            pc1 = max(nc1, probe[1])
+            if pr1 - pr0 + 1 <= max_h and pc1 - pc0 + 1 <= max_w:
+                onward += 1
+        candidates.append((onward, float(rng.random()), color, nxt, (nr0, nc0, nr1, nc1), new_used))
+
+    candidates.sort(key=lambda item: (-item[0], item[1]))
+    for _onward, _noise, color, nxt, new_bbox, new_used in candidates:
+        visited.add(nxt)
+        tail = _search_tail(
+            nxt,
+            visited,
+            steps_left - 1,
+            new_used,
+            max_h,
+            max_w,
+            rng,
+            require_all_colors,
+            new_bbox,
+            strict_path,
+        )
+        visited.remove(nxt)
+        if tail is not None:
