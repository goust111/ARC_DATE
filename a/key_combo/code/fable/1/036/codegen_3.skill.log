+            pc0 = min(nc0, probe[1])
+            pr1 = max(nr1, probe[0])
+            pc1 = max(nc1, probe[1])
+            if pr1 - pr0 + 1 <= max_h and pc1 - pc0 + 1 <= max_w:
+                onward += 1
