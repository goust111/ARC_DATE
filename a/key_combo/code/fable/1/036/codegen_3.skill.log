+    neighbors: dict[tuple[int, int], list[tuple[int, int]]] = {}
+    endpoints = []
+    for r, c in cells:
+        nbrs = [(nr, nc) for nr, nc in _neighbors4(r, c) if (nr, nc) in cells]
+        neighbors[(r, c)] = nbrs
+        if len(nbrs) == 1:
