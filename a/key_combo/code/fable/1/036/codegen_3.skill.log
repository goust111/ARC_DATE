+        nc = cur[1] + dc
+        nxt = (nr, nc)
+        if nxt in visited:
+            continue
+        nr0 = min(r0, nr)
+        nc0 = min(c0, nc)
+        nr1 = max(r1, nr)
+        nc1 = max(c1, nc)
