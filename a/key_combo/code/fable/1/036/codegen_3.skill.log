+        bbox = _bbox_coords(list(set(positions)))
+        tail = _search_tail(
+            cur=positions[-1],
+            visited=set(positions),
+            steps_left=extra,
+            used_colors=set(base),
+            max_h=max_h,
+            max_w=max_w,
+            rng=rng,
+            require_all_colors=False,
+            bbox=bbox,
+            strict_path=False,
