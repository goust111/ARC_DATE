+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+
+COLOR_TO_DELTA = {
+    RED: (0, 1),
+    YELLOW: (0, -1),
+    BLUE: (-1, 0),
+    GREEN: (1, 0),
+}
+INSTRUCTION_COLORS = tuple(COLOR_TO_DELTA.keys())
