+            defect_coords = np.argwhere(defect_mask) + np.array([r0, c0], dtype=int)
+            defect_cells = frozenset(map(tuple, defect_coords.tolist()))
+            if len(defect_cells) != sum(sprite["area"] for sprite in sprites):
+                continue
