+import numpy as np
+
+
+Coord = tuple[int, int]
+BBox = tuple[int, int, int, int]
+
+
+def get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.flatten())).most_common(1)[0][0])
+
+
+def bbox_coords(coords: np.ndarray) -> BBox:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def crop_bbox(grid: np.ndarray, bbox: BBox) -> np.ndarray:
+    r0, c0, r1, c1 = map(int, bbox)
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def paste(dst: np.ndarray, patch: np.ndarray, r0: int, c0: int, *, transparent: int | None = None) -> None:
+    r0 = int(r0)
+    c0 = int(c0)
+    h, w = patch.shape
+    view = dst[r0 : r0 + h, c0 : c0 + w]
+    if transparent is None:
+        view[:] = patch
+    else:
+        mask = patch != int(transparent)
+        view[mask] = patch[mask]
+
+
+def _neighbors(r: int, c: int, connectivity: int) -> list[Coord]:
+    if int(connectivity) == 4:
+        return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+    return [
+        (r + dr, c + dc)
+        for dr in (-1, 0, 1)
+        for dc in (-1, 0, 1)
+        if dr != 0 or dc != 0
+    ]
+
+
+def components_mask(mask: np.ndarray, connectivity: int = 4) -> list[np.ndarray]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            cells: list[Coord] = []
+            while stack:
+                rr, cc = stack.pop()
+                cells.append((rr, cc))
+                for nr, nc in _neighbors(rr, cc, connectivity):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(cells, dtype=int))
+    return comps
