+def _dilate8(mask: np.ndarray) -> np.ndarray:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    out = mask.copy()
+    for r, c in np.argwhere(mask):
+        rr = int(r)
+        cc = int(c)
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                nr = rr + dr
+                nc = cc + dc
+                if 0 <= nr < h and 0 <= nc < w:
+                    out[nr, nc] = True
+    return out
+
