+    outputs: dict[tuple[tuple[int, int], bytes], np.ndarray] = {}
+    order = sorted(
+        range(len(components)),
+        key=lambda i: (-components[i]["area"], -((components[i]["bbox"][2] - components[i]["bbox"][0] + 1) * (components[i]["bbox"][3] - components[i]["bbox"][1] + 1))),
