+def _texture_pattern(region: np.ndarray, bg: int, pr: int, pc: int) -> np.ndarray | None:
+    pattern = np.full((pr, pc), -1, dtype=int)
+    for r, c in np.argwhere(region != bg):
+        rr = int(r) % pr
+        cc = int(c) % pc
+        color = int(region[r, c])
+        if pattern[rr, cc] == -1:
+            pattern[rr, cc] = color
+        elif int(pattern[rr, cc]) != color:
+            return None
