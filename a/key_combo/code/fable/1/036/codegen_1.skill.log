+        return None
+    return pattern
+
+
+def _sprite_record(grid: np.ndarray, coords: np.ndarray) -> dict:
+    r0, c0, r1, c1 = bbox_coords(coords)
+    cells = []
+    for r, c in coords:
+        rr = int(r)
+        cc = int(c)
+        cells.append((rr - r0, cc - c0, int(grid[rr, cc])))
+    cells.sort()
+    return {
+        "area": int(coords.shape[0]),
+        "cells": tuple(cells),
+        "height": int(r1 - r0 + 1),
+        "width": int(c1 - c0 + 1),
+    }
+
