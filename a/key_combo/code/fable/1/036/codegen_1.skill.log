+def _repeat_tile(tile: np.ndarray, h: int, w: int) -> np.ndarray:
+    reps_r = (int(h) + tile.shape[0] - 1) // tile.shape[0]
+    reps_c = (int(w) + tile.shape[1] - 1) // tile.shape[1]
+    return np.tile(tile, (reps_r, reps_c))[:h, :w]
