    out = main(grid)
    if out is None:
        return None
    return grid


def generate_input():
    for _ in range(GENERATION_RETRIES):
        result = _gen_attempt()
        if result is not None:
            return result
    raise RuntimeError(f"Failed to generate input after {GENERATION_RETRIES} attempts")

