+def _sprite_placements(
+    sprite: dict,
+    defect_cells: frozenset[Coord],
+    color_at: dict[Coord, int],
+    bbox: BBox,
+) -> list[frozenset[Coord]]:
+    r0, c0, r1, c1 = bbox
