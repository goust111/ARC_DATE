+def _all_residues_visible(h: int, w: int, pr: int, pc: int, defect_mask: np.ndarray) -> bool:
+    for rr in range(pr):
+        for cc in range(pc):
+            seen = False
+            for r in range(rr, h, pr):
+                for c in range(cc, w, pc):
+                    if not defect_mask[r, c]:
+                        seen = True
+                        break
+                if seen:
+                    break
+            if not seen:
+                return False
+    return True
