0120: def _gen_candidate_positions(coords, area, out_used, in_used, want_clip):
0121:     height, width = out_used.shape
0122:     min_r, max_r, _, shape_w = _gen_output_bounds(coords, area, height)
0123:     if min_r > max_r:
0124:         return []
0125: 
0126:     candidates = []
0127:     for out_r in range(min_r, max_r + 1):
0128:         target = coords + np.array([out_r, 0])
0129:         clipped = bool(np.any(target[:, 0] >= height))
0130:         if clipped != want_clip:
0131:             continue
0132:         if not np.any(target[:, 0] < height):
0133:             continue
0134:         for out_c in range(0, width - shape_w + 1):
0135:             target = coords + np.array([out_r, out_c])
0136:             visible = target[target[:, 0] < height]
0137:             inp = coords + np.array([out_r - area, out_c])
0138:             if np.any(inp[:, 0] <= 0) or np.any(inp[:, 0] >= height):
0139:                 continue
0140:             if out_used[visible[:, 0], visible[:, 1]].any():
0141:                 continue
0142:             if in_used[inp[:, 0], inp[:, 1]].any():
0143:                 continue
0144:             candidates.append((out_r, out_c, visible, inp))
0145:     return candidates
