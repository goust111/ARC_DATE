0041:     bg = get_bg(g)
0042:     foreground_colors = colors_present(g, exclude={bg})
0043:     separator_candidates = []
0044:     for color in foreground_colors:
0045:         sep_rows = [r for r in range(height) if np.all(g[r, :] == color)]
0046:         sep_cols = [c for c in range(width) if np.all(g[:, c] == color)]
0047:         if sep_rows and sep_cols:
0048:             separator_candidates.append((color, sep_rows, sep_cols))
0049:     assert len(separator_candidates) == 1, "expected one separator color with full rows and columns"
0050: 
0051:     separator, sep_rows, sep_cols = separator_candidates[0]
0052:     marker_colors = [color for color in foreground_colors if color != separator]
0053:     assert len(marker_colors) == 1, "expected one marker color besides the separators"
0054:     marker = marker_colors[0]
0055: 
0056:     row_bands = _bands(height, sep_rows)
0057:     col_bands = _bands(width, sep_cols)
0058:     assert len(row_bands) == 3 and len(col_bands) == 3, "expected a 3x3 separated table"
0059:     out = np.full((len(row_bands), len(col_bands)), bg, dtype=int)
0060: 
0061:     allowed = {bg, marker}
0062:     for out_r, (r0, r1) in enumerate(row_bands):
0063:         for out_c, (c0, c1) in enumerate(col_bands):
0064:             region = g[r0:r1, c0:c1]
0065:             assert set(map(int, region.reshape(-1))) <= allowed, "regions may contain only background and markers"
0066:             marker_count = int(np.sum(region == marker))
0067:             assert marker_count in (1, 2), "each region must contain one or two markers"
0068:             if marker_count == 2:
0069:                 out[out_r, out_c] = Color.BLUE
0070: 
0071:     return out
