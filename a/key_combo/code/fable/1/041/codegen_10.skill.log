0118: # Geometry: fixed 8x8 grid with a 3x3 lattice of 2x2 content tiles.
0119: GRID_SIZE = 8
0120: TILE_GRID_SIZE = 3
0121: LAST_TILE = TILE_GRID_SIZE - 1
0122: TILE_CELLS = ((0, 1), (3, 4), (6, 7))
0123: SEPARATOR_LINES = [2, 5]
0124: 
0125: # Sampling controls: colors, group count, offsets, and shape mix.
0126: N_COLORS = 10
0127: GROUP_COUNT_RANGE = (1, 3)
0128: LOCAL_OFFSETS = [(0, 0), (0, 1), (1, 0), (1, 1)]
0129: STRAIGHT_SHAPE_PROB = 0.5
0130: N_LINE_AXES = 2
0131: EXTREME_TILES = [0, LAST_TILE]
0132: GENERATION_RETRIES = 300
0133: 
0134: 
0135: def _gen_shape_tiles():
0136:     """Return (output tiles, input endpoint tiles) for one marker group."""
0137:     if np.random.random() < STRAIGHT_SHAPE_PROB:
0138:         axis = np.random.randint(N_LINE_AXES)
0139:         fixed = np.random.randint(TILE_GRID_SIZE)
0140:         if axis == 0:
0141:             return (
0142:                 {(fixed, c) for c in range(TILE_GRID_SIZE)},
0143:                 {(fixed, 0), (fixed, LAST_TILE)},
0144:             )
0145:         return (
0146:             {(r, fixed) for r in range(TILE_GRID_SIZE)},
0147:             {(0, fixed), (LAST_TILE, fixed)},
0148:         )
0149:     corner_r = int(np.random.choice(EXTREME_TILES))
0150:     corner_c = int(np.random.choice(EXTREME_TILES))
0151:     out_tiles = {(corner_r, c) for c in range(TILE_GRID_SIZE)}
0152:     out_tiles.update((r, corner_c) for r in range(TILE_GRID_SIZE))
0153:     return (
0154:         out_tiles,
0155:         {
0156:             (corner_r, corner_c),
0157:             (corner_r, LAST_TILE - corner_c),
0158:             (LAST_TILE - corner_r, corner_c),
0159:         },
0160:     )
0161: 
0162: 
0163: def _choose_palette_and_offsets():
0164:     colors = list(np.random.permutation(N_COLORS))
0165:     separator_color = int(colors[0])
0166:     base_color = int(colors[1])
0167:     n_groups = int(np.random.randint(*GROUP_COUNT_RANGE))
0168:     marker_colors = [int(c) for c in colors[2 : 2 + n_groups]]
0169:     offsets = [(int(r), int(c)) for r, c in np.random.permutation(LOCAL_OFFSETS)[:n_groups]]
0170:     return separator_color, base_color, marker_colors, offsets
0171: 
0172: 
0173: def _make_groups(marker_colors, offsets):
0174:     groups = []
0175:     for color, offset in zip(marker_colors, offsets):
0176:         out_tiles, in_tiles = _gen_shape_tiles()
0177:         groups.append({"color": color, "offset": offset, "out_tiles": out_tiles, "in_tiles": in_tiles})
