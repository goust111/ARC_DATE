0234: def _validate_positions(occ, shape, positions, th, tw):
0235:     """Check all positions: in bounds, no overlap with existing holes,
0236:     4-disconnected from existing holes."""
0237:     sh, sw = shape.shape
0238:     # Collect all cells that will be carved
0239:     new_cells = set()
0240:     for pr, pc in positions:
0241:         for dr in range(sh):
0242:             for dc in range(sw):
0243:                 if shape[dr, dc]:
0244:                     new_cells.add((pr + dr, pc + dc))
0245: 
0246:     for pr, pc in positions:
0247:         if pr < 1 or pc < 1 or pr + sh > th - 1 or pc + sw > tw - 1:
0248:             return None
0249:         for dr in range(sh):
0250:             for dc in range(sw):
0251:                 if not shape[dr, dc]:
0252:                     continue
0253:                 rr, cc = pr + dr, pc + dc
0254:                 if not occ[rr, cc]:
0255:                     return None
