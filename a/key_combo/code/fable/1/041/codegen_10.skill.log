0089: 
0090:     out = g.copy()
0091:     for (color, local_r, local_c), tile_points in markers.items():
0092:         assert len(tile_points) >= 2
0093:         ordered_points = sorted(tile_points)
0094:         assert any(
0095:             r1 == r2 or c1 == c2
0096:             for i, (r1, c1) in enumerate(ordered_points)
0097:             for r2, c2 in ordered_points[i + 1 :]
0098:         )
0099:         for i, (r1, c1) in enumerate(ordered_points):
0100:             for r2, c2 in ordered_points[i + 1 :]:
0101:                 if r1 == r2:
