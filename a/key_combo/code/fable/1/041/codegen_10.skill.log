0155: def _consume_alias(kwargs: dict, primary: str, aliases: Sequence[str]):
0156:     """
0157:     Consume a keyword argument by primary name or any alias, ensuring no conflicts.
0158: 
0159:     Returns:
0160:         (value, used_name) or (None, None) if not found.
0161:     """
0162:     used = None
0163:     if primary in kwargs:
0164:         used = primary
0165:     else:
0166:         for a in aliases:
0167:             if a in kwargs:
0168:                 used = a
0169:                 break
0170:     if used is None:
0171:         return None, None
0172:     val = kwargs.pop(used)
0173:     names = [primary, *aliases]
0174:     for n in names:
0175:         if n != used and n in kwargs:
0176:             raise TypeError(f"got multiple values for {primary}: {used} and {n}")
0177:     return val, used
