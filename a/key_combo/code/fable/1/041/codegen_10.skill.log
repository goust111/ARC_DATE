0065:     content = g[~sep_mask]
0066:     counts = Counter(map(int, content))
0067:     base_color, base_count = counts.most_common(1)[0]
0068:     marker_count = sum(n for color, n in counts.items() if color != base_color)
0069:     assert base_color != sep_color
0070:     assert base_count > marker_count
0071: 
0072:     row_lookup = {
0073:         r: (tile_r, local_r)
0074:         for tile_r, rows in enumerate(row_tiles)
0075:         for local_r, r in enumerate(rows)
0076:     }
0077:     col_lookup = {
