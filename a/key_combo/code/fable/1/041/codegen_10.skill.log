0057:     if min_h > HEIGHT_RANGE[1]:
0058:         return None
0059:     height = int(rng.integers(min_h, HEIGHT_RANGE[1] + 1))
0060:     width = int(rng.integers(WIDTH_RANGE[0], WIDTH_RANGE[1] + 1))
0061:     return height, width, height - motif_h, motif_h
