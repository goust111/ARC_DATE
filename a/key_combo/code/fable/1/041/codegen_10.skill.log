+MAX_ATTEMPTS = 400
+PANEL_GROUP_SPAN = 4
+VERT_GROUP_SHAPE = (3, 5)
+HORZ_GROUP_SHAPE = (5, 3)
+VERT_GRAY_SLOTS = [(0, 0), (0, 1), (1, 0), (1, 1), (2, 0), (2, 1)]
