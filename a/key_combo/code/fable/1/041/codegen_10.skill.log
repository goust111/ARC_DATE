0102: def _gen_output_bounds(coords, area, height):
0103:     shape_h = int(coords[:, 0].max()) + 1
0104:     shape_w = int(coords[:, 1].max()) + 1
0105:     min_r = area + 1
0106:     max_r = min(height - 1, height - shape_h + area)
0107:     return min_r, max_r, shape_h, shape_w
