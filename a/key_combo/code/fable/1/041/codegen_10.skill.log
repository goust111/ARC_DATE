+from __future__ import annotations
+
+from collections import Counter
+import random
+
+import numpy as np
+
+
+GRAY = 5
+ALL_COLORS = tuple(range(10))
+NEIGHBORS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+MAX_ATTEMPTS = 400
+PANEL_GROUP_SPAN = 4
+VERT_GROUP_SHAPE = (3, 5)
+HORZ_GROUP_SHAPE = (5, 3)
+VERT_GRAY_SLOTS = [(0, 0), (0, 2), (2, 0), (2, 2)]
