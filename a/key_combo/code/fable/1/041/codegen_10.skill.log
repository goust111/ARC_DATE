0285: def _build_hole_layout(th, tw):
0286:     """Place holes with LR+UD+rot180 symmetry. Returns (occ, hole_placements) or None."""
0287:     max_sh, max_sw = max(1, (th - 2) // 2), max(1, (tw - 2) // 2)
0288:     available = [s for s in SHAPE_LIBRARY
0289:                  if s.shape[0] <= max_sh and s.shape[1] <= max_sw
0290:                  and int(np.sum(s)) <= SHAPE_MAX_AREA]
0291:     if len(available) < MIN_SHAPES:
0292:         return None
0293: 
0294:     k_target = random.randint(SHAPE_COUNT_RANGE[0], min(SHAPE_COUNT_RANGE[1], len(available)))
0295:     random.shuffle(available)
0296:     even_dims = (th % 2 == 0 or tw % 2 == 0)
0297:     if even_dims:
0298:         available.sort(key=lambda s: int(np.sum(s)))
0299: 
0300:     occ = np.ones((th, tw), dtype=bool)
0301:     hole_placements = []  # list of (shape, placed_groups)
0302: 
0303:     mult_vals, mult_wts = MULT_EVEN_WEIGHTS if even_dims else MULT_ODD_WEIGHTS
0304:     for shape in available:
0305:         if len(hole_placements) >= k_target:
0306:             break
0307:         mult = random.choices(mult_vals, weights=mult_wts)[0]
0308:         placed = []
0309:         for _ in range(mult):
0310:             for _ in range(PLACEMENT_RETRIES):
0311:                 positions = _try_place_symmetric(occ, shape, th, tw)
0312:                 if positions is not None:
0313:                     _carve_hole(occ, shape, positions)
0314:                     placed.append(positions)
0315:                     break
0316:         if placed:
0317:             hole_placements.append((shape, placed))
0318: 
0319:     if len(hole_placements) < MIN_SHAPES:
0320:         return None
0321: 
0322:     frame_density = 1.0 - int(np.sum(~occ)) / (th * tw)
0323:     if not (FRAME_DENSITY_RANGE[0] <= frame_density <= FRAME_DENSITY_RANGE[1]):
0324:         return None
0325: 
0326:     total_holes = sum(len(pos) for _, pls in hole_placements for pos in pls)
0327:     if total_holes < MIN_TOTAL_HOLES:
0328:         return None
0329: 
0330:     return occ, hole_placements
