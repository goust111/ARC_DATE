0129: def _all_rot_flip(mask: np.ndarray):
0130:     """Yield (key, oriented_mask) for all 8 rotation/flip variants of a bool mask."""
0131:     m0 = mask.astype(bool)
0132:     for flip in (False, True):
0133:         m1 = np.flipud(m0) if flip else m0
0134:         for k in range(4):
0135:             m2 = np.rot90(m1, k)
0136:             yield (m2.shape, m2.tobytes()), m2
0137: 
0138: 
0139: def _canonical_key(mask: np.ndarray):
0140:     """Smallest key across all rotation/flip variants (canonical representative)."""
0141:     return min(key for key, _ in _all_rot_flip(mask))
0142: 
0143: 
0144: def _all_orientations(mask: np.ndarray):
0145:     """Deduplicated list of all distinct rotation/flip variants."""
0146:     seen, result = set(), []
0147:     for key, m in _all_rot_flip(mask):
0148:         if key not in seen:
0149:             seen.add(key)
0150:             result.append(m)
0151:     return result
