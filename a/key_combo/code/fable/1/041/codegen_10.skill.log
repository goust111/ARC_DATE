+    legend = _render_legend(board.shape, side, mapping, bg)
+    grid = _assemble_canvas(board, legend, side, sep_color)
+    expected = np.asarray([[mapping[counts[r * cols + c]] for c in range(cols)] for r in range(rows)], dtype=int)
