0110: def _gen_clip_indices(shapes, areas):
0111:     clip_capable = []
0112:     for i, (coords, area) in enumerate(zip(shapes, areas)):
0113:         min_r, max_r, shape_h, _ = _gen_output_bounds(coords, area, GRID_HEIGHT)
0114:         if max_r >= max(min_r, GRID_HEIGHT - shape_h + 1):
0115:             clip_capable.append(i)
0116:     clip_count = random.randint(0, min(MAX_CLIPPED_OBJECTS, len(clip_capable)))
0117:     return set(random.sample(clip_capable, clip_count))
