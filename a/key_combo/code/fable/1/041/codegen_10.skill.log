0083: 
0084: def get_bg(grid: np.ndarray) -> int:
0085:     """Background color = most common value in the grid."""
0086:     return int(Counter(map(int, grid.flatten())).most_common(1)[0][0])
0087: 
0088: 
0089: def colors_present(grid: np.ndarray, *, exclude: Iterable[int] | None = None) -> list[int]:
0090:     """
0091:     Return the sorted unique colors present in `grid`.
0092: 
0093:     Args:
0094:         exclude: optional iterable of colors to exclude (e.g. `{bg}`)
0095:     """
0096:     cols = set(map(int, grid.flatten()))
