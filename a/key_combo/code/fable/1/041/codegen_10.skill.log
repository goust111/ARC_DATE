0087: def _gen_polyomino(area):
0088:     cells = {(0, 0)}
0089:     frontier = {(0, 1), (1, 0), (0, -1), (-1, 0)}
0090:     while len(cells) < area:
0091:         cell = random.choice(tuple(frontier))
0092:         cells.add(cell)
0093:         frontier.remove(cell)
0094:         r, c = cell
0095:         for dr, dc in NEIGHBORS_4:
0096:             nr, nc = r + dr, c + dc
0097:             if (nr, nc) not in cells:
0098:                 frontier.add((nr, nc))
0099:     return _gen_transform_coords(cells)
