0083:     markers = defaultdict(set)
0084:     for r, c in np.argwhere((g != sep_color) & (g != base_color)):
0085:         tile_r, local_r = row_lookup[int(r)]
0086:         tile_c, local_c = col_lookup[int(c)]
0087:         markers[(int(g[r, c]), local_r, local_c)].add((tile_r, tile_c))
