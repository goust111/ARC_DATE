0063: def _sample_fg_cells(rng, motif_h: int, width: int, bbox_w: int) -> set[tuple[int, int]] | None:
0064:     """Choose bbox-local cells while forcing every row and both bbox edges."""
0065:     min_fg = max(motif_h, int(np.ceil(FG_DENSITY_RANGE[0] * motif_h * width)))
0066:     max_fg = min(motif_h * bbox_w, int(np.floor(FG_DENSITY_RANGE[1] * motif_h * width)))
0067:     if max_fg < min_fg:
0068:         return None
0069:     target_fg = int(rng.integers(min_fg, max_fg + 1))
0070:     selected = {(int(rng.integers(0, motif_h)), 0), (int(rng.integers(0, motif_h)), bbox_w - 1)}
0071:     for r in range(motif_h):
0072:         if not any(rr == r for rr, _ in selected):
0073:             selected.add((r, int(rng.integers(0, bbox_w))))
0074:     if len(selected) > target_fg:
0075:         return None
0076:     remaining = [
0077:         (r, c)
0078:         for r in range(motif_h)
0079:         for c in range(bbox_w)
0080:         if (r, c) not in selected
0081:     ]
0082:     need = target_fg - len(selected)
0083:     if need:
0084:         for i in rng.choice(len(remaining), size=need, replace=False):
0085:             selected.add(remaining[int(i)])
