0016: def main(grid: np.ndarray) -> np.ndarray:
0017:     """
0018:     Convert the separator-delimited board into a summary grid marking cells with two marker pixels.
0019: 
0020:     Input structure
0021:     - The dominant color is the empty background.
0022:     - One non-background color forms all full separator rows and all full
0023:       separator columns.
0024:     - The remaining non-background color is the marker color; every separated
0025:       region contains either one or two marker pixels.
0026: 
0027:     Rule
0028:     - Find the separator rows and columns, and use them to partition the input
0029:       into rectangular regions.
0030:     - For each region, output blue if it contains two marker pixels; otherwise
0031:       output the background color.
0032: 
0033:     Key insight
0034:     - The large grid is a 3x3 table of tiny marker counts, and the output records
0035:       only which table cells have the doubled marker.
0036:     """
0037:     g = np.asarray(grid, dtype=int)
0038:     assert g.ndim == 2, "expected a 2D grid"
0039:     height, width = map(int, g.shape)
