0047: 
0048:     WHITE = 10  # debug / visualization
0049:     PAD = 11
0050: 
0051:     BACKGROUND = 0
0052: 
0053:     ALL_COLORS = [BLACK, BLUE, RED, GREEN, YELLOW, GREY, PINK, ORANGE, TEAL, MAROON]
0054:     NOT_BLACK = [BLUE, RED, GREEN, YELLOW, GREY, PINK, ORANGE, TEAL, MAROON]
0055: 
