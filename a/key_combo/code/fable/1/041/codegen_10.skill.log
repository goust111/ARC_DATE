0024: def main(grid: np.ndarray) -> np.ndarray:
0025:     """Move each rectangular object into the matching platform gap, rotating it so its two-cell side is vertical.
0026: 
0027:     Input structure
0028:     - The last row is a solid non-background platform color.
0029:     - The row above the platform contains only background and platform-color separator runs; background gaps between consecutive separator runs are slots.
0030:     - Every non-background, non-platform object above the shelf is a solid monochrome rectangle with one side of length two.
0031: 
0032:     Rule
0033:     - Clear those source rectangles from their original locations.
0034:     - Rotate a rectangle if needed so it is two rows tall.
0035:     - Place each normalized rectangle bottom-aligned with the shelf row inside the unique slot whose width matches the rectangle's normalized width.
0036: 
0037:     Key insight
0038:     - The platform separators encode target slot widths, while each source rectangle's non-two dimension encodes the slot it belongs in.
0039:     """
0040:     g = np.asarray(grid, dtype=int)
0041:     H = int(g.shape[0])
0042:     bg = get_bg(g)
0043: 
0044:     bottom_colors = set(map(int, g[H - 1]))
0045:     assert len(bottom_colors) == 1
0046:     platform = next(iter(bottom_colors))
0047:     assert platform != bg
0048: 
0049:     shelf = H - 2
0050:     assert shelf >= 1
0051:     assert set(map(int, g[shelf])) <= {bg, platform}
0052: 
0053:     runs = _platform_runs(g[shelf], platform, bg)
0054:     assert len(runs) >= 2
0055: 
0056:     slots: list[tuple[int, int, int]] = []
0057:     for (_left_start, left_end), (right_start, _right_end) in zip(runs, runs[1:]):
0058:         start = left_end + 1
0059:         end = right_start - 1
0060:         assert start <= end
0061:         assert np.all(g[shelf, start : end + 1] == bg)
0062:         slots.append((start, end, end - start + 1))
0063: 
0064:     colors = sorted(set(map(int, g.ravel())) - {bg, platform})
0065:     components = find_components(g, bg=bg, colors=colors, connectivity=4, monochromatic=True)
0066: 
0067:     objects: list[dict] = []
0068:     for comp in components:
0069:         color = int(comp["color"])
0070:         r0, c0, r1, c1 = comp["bbox"]
0071:         assert r1 < shelf
0072: 
0073:         sprite = g[r0 : r1 + 1, c0 : c1 + 1]
0074:         assert np.all(sprite == color)
0075:         h, w = sprite.shape
0076:         assert h == 2 or w == 2
0077: 
0078:         if h == 2:
0079:             normalized = sprite.copy()
0080:         else:
0081:             normalized = np.rot90(sprite, k=1)
0082:             assert normalized.shape[0] == 2
0083: 
0084:         objects.append(
0085:             {
0086:                 "bbox": (r0, c0, r1, c1),
0087:                 "width": int(normalized.shape[1]),
0088:                 "sprite": normalized,
0089:             }
0090:         )
0091: 
0092:     assert len(objects) == len(slots)
0093:     slot_by_width = {width: (start, end) for start, end, width in slots}
0094:     object_by_width = {obj["width"]: obj for obj in objects}
0095:     assert len(slot_by_width) == len(slots)
0096:     assert len(object_by_width) == len(objects)
0097:     assert set(slot_by_width) == set(object_by_width)
0098: 
0099:     out = g.copy()
0100:     for obj in objects:
0101:         r0, c0, r1, c1 = obj["bbox"]
0102:         out[r0 : r1 + 1, c0 : c1 + 1] = bg
0103: 
0104:     for width, (start, end) in slot_by_width.items():
0105:         sprite = object_by_width[width]["sprite"]
0106:         h, w = sprite.shape
0107:         assert h == 2
0108:         assert w == width
0109:         top = shelf - h + 1
0110:         assert top >= 0
0111:         assert np.all(out[top : shelf + 1, start : end + 1] == bg)
0112:         out[top : shelf + 1, start : end + 1] = sprite
0113: 
0114:     return out
