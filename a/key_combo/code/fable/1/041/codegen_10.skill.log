0053: def _sample_dims(rng) -> tuple[int, int, int, int] | None:
0054:     """Return height, width, blank rows, and motif height."""
0055:     motif_h = int(rng.integers(MOTIF_H_RANGE[0], MOTIF_H_RANGE[1] + 1))
