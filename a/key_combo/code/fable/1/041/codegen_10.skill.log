+
+
+def _runs_from_mask(mask_1d: np.ndarray) -> list[tuple[int, int]]:
+    runs: list[tuple[int, int]] = []
+    start = None
+    for idx, flag in enumerate(np.asarray(mask_1d, dtype=bool)):
+        if flag and start is None:
+            start = idx
+        elif not flag and start is not None:
