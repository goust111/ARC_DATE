0148: def _gen_place_objects(colors, areas, shapes, clip_indices):
0149:     expected = np.full((GRID_HEIGHT, GRID_WIDTH), BACKGROUND, dtype=int)
0150:     inp = np.full((GRID_HEIGHT, GRID_WIDTH), BACKGROUND, dtype=int)
0151:     out_used = np.zeros((GRID_HEIGHT, GRID_WIDTH), dtype=bool)
0152:     in_used = np.zeros((GRID_HEIGHT, GRID_WIDTH), dtype=bool)
0153: 
0154:     order = list(range(OBJECT_COUNT))
0155:     random.shuffle(order)
0156:     for i in order:
