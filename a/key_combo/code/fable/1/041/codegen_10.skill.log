0022: def main(grid: np.ndarray) -> np.ndarray:
0023:     """Complete straight same-color marker segments across the tiled lattice.
0024: 
0025:     Input structure
0026:     The grid is a 3x3 array of equal 2x2 tiles separated by full-width and
0027:     full-height separator lines.  Each tile is mostly the same base color, with
0028:     a few non-base marker pixels at fixed local offsets inside their tiles.
0029: 
0030:     Rule
0031:     For each marker color and local tile offset, connect any pair of markers
0032:     that lie in the same tile row or same tile column by recoloring the base
0033:     cells between them to that marker color at the same local offset.
0034: 
0035:     Key insight
0036:     The colored pixels are endpoints in tile coordinates, not free cells in the
0037:     raw grid; the missing pixels are found by completing axis-aligned segments
0038:     in the 3x3 tile lattice while preserving the endpoint's local position.
0039:     """
0040:     g = np.asarray(grid, dtype=int)
0041:     assert g.ndim == 2
0042:     h, w = g.shape
0043: 
0044:     separator_candidates = []
0045:     for color in set(map(int, g.ravel())):
0046:         sep_rows = [r for r in range(h) if np.all(g[r, :] == color)]
0047:         sep_cols = [c for c in range(w) if np.all(g[:, c] == color)]
0048:         if sep_rows and sep_cols:
0049:             separator_candidates.append((color, sep_rows, sep_cols))
0050:     assert len(separator_candidates) == 1
0051: 
0052:     sep_color, sep_rows, sep_cols = separator_candidates[0]
0053:     sep_mask = np.zeros(g.shape, dtype=bool)
0054:     sep_mask[sep_rows, :] = True
0055:     sep_mask[:, sep_cols] = True
0056:     assert np.array_equal(g == sep_color, sep_mask)
0057: 
0058:     row_tiles = _runs_between_stops(h, sep_rows)
0059:     col_tiles = _runs_between_stops(w, sep_cols)
0060:     assert len(row_tiles) == 3
0061:     assert len(col_tiles) == 3
0062:     assert {len(rows) for rows in row_tiles} == {2}
0063:     assert {len(cols) for cols in col_tiles} == {2}
