0158:         candidates = _gen_candidate_positions(
0159:             coords, area, out_used, in_used, i in clip_indices
0160:         )
0161:         if not candidates:
0162:             return None
0163:         _, _, visible, input_coords = random.choice(candidates)
0164:         expected[visible[:, 0], visible[:, 1]] = color
0165:         out_used[visible[:, 0], visible[:, 1]] = True
0166:         inp[input_coords[:, 0], input_coords[:, 1]] = color
0167:         in_used[input_coords[:, 0], input_coords[:, 1]] = True
0168: 
0169:     return inp, expected
