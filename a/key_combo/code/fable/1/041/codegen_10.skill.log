0079:     arr = np.asarray(list(coords), dtype=int).copy()
0080:     for _ in range(random.randrange(ROTATION_COUNT)):
0081:         arr = np.column_stack((arr[:, 1], -arr[:, 0]))
0082:     if random.random() < MIRROR_PROB:
