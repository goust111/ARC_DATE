import numpy as np
from itertools import product

def row_candidates(row):
    W=len(row)
    seen=set(); out=[]
    for s in range(W):
        rr=np.roll(row,-s)
        if np.array_equal(rr, rr[::-1]):
            key=rr.tobytes()
            if key not in seen:
                seen.add(key)
                out.append((s,rr.copy()))
    return out

def comp(mask):
    H,W=mask.shape
    seen=np.zeros_like(mask,dtype=bool)
    best=0; comps=0
    for r in range(H):
        for c in range(W):
            if not mask[r,c] or seen[r,c]:
                continue
            comps+=1
            stack=[(r,c)]
            seen[r,c]=True
            area=0
            while stack:
