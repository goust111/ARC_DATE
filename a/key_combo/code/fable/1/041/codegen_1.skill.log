{
  "type": "symmetry/pattern",
  "src": "regular array of equal-size solid rectangular sprite slots plus sparse foreground noise outside the array; each slot is a corrupted copy of the same sprite",
  "transform": "recover the sprite by unique per-coordinate majority across slots; replace every slot with the recovered sprite and clear all cells outside the slot array to background"
}
</annotation>
</reference_puzzle>

