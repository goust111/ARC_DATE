        struct = STRUCT4 if pad_conn == 4 else STRUCT8
        occ = ndimage.binary_dilation(occ, structure=struct, iterations=padding)

    m = (patch != bg)

    candidates: list[Coord] = []
    for r0 in range(r_min, r_max + 1):
