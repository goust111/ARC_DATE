+PALETTE = tuple(range(10))
+MOTIF_SIDE_RANGE = (2, 5)
+CANVAS_SIDE_RANGE = (6, 20)
+PANEL_EXTRA_MAX = 3
+SAMPLE_SIZE_PREFERENCES = (2, 3, 4, 5)
