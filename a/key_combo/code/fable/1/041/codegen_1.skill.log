+    motif_h, motif_w = map(int, motif_shape)
+    top = 0 if panel_h == motif_h or random.random() < 0.5 else panel_h - motif_h
+    left = 0 if panel_w == motif_w or random.random() < 0.5 else panel_w - motif_w
+    return int(top), int(left)
+
