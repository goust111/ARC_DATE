  15: def main(input_grid: np.ndarray) -> np.ndarray:
  16:     """
  17:     Repeat each colored diagonal every three offsets to fill the 7x7 grid with an interlaced pattern.
  18: 
  19:     Input structure:
  20:     - The input is a 7x7 black grid containing three full diagonals.
  21:     - Each diagonal has a distinct non-black color.
  22:     - The diagonals run in the same slope direction.
  23: 
  24:     Rule:
  25:     - For every non-black input cell, draw its full diagonal in the output.
  26:     - Redraw that same diagonal color at offsets spaced by three rows.
  27:     - Clip the repeated diagonals to the 7x7 canvas.
  28: 
  29:     Key insight:
  30:     - A single colored diagonal defines a whole congruence class modulo three; repeating all three
  31:       classes creates the final interlacing.
  32:     """
  33:     output_grid = np.zeros((7, 7), dtype=int)
  34: 
  35:     # Loop over the input looking for any of the three diagonals
  36:     # If we find one, we will fill the output with the same color in the same pattern
  37:     for i in range(output_grid.shape[0]):
  38:         for j in range(output_grid.shape[1]):
  39:             c = input_grid[i][j]
  40:             if c != Color.BLACK:
  41:                 # Fill the output with the same color in the same pattern
  42:                 # Loop by multiples of 3 to create the pattern
  43:                 # Loop way beyond the canvas (double the canvas size) to make sure we cover everything
  44:                 for distance in range(0, output_grid.shape[0]*2, 3):
  45:                     draw_diagonal(output_grid, i-distance, j, c)
  46:                     draw_diagonal(output_grid, i+distance, j, c)
  47:     
  48:     return output_grid
