+        offset = rng.choice(_offset_choices(side, height, width))
+        key = (side, offset)
+        if key in used:
+            continue
+        used.add(key)
+        choices.append(key)
+    return _sample_box(rng, bbox=bbox, border=border, required_gaps=choices)
+
+
+def _analyze_box(grid: np.ndarray, comp: dict, bg: int) -> dict | None:
+    color = int(comp["color"])
