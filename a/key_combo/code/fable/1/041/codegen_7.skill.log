+
+def _trace_to_edge(
+    start: tuple[int, int],
+    direction: tuple[int, int],
+    shape: tuple[int, int],
+) -> list[tuple[int, int]]:
+    dr, dc = direction
+    H, W = shape
+    r, c = start
+    out = [start]
+    while True:
+        r += dr
+        c += dc
+        if not (0 <= r < H and 0 <= c < W):
+            break
+        out.append((r, c))
+    return out
+
+
+def _side_of_gap(
