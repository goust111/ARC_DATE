+def _gap_coord(bbox: tuple[int, int, int, int], side: str, offset: int) -> tuple[int, int]:
+    r0, c0, r1, c1 = bbox
+    if side == "top":
+        return r0, c0 + offset
+    if side == "bottom":
+        return r1, c0 + offset
+    if side == "left":
+        return r0 + offset, c0
+    if side == "right":
+        return r0 + offset, c1
+    raise ValueError(side)
+
+
+def _bbox_from_edge_point(
+    point: tuple[int, int],
+    side: str,
+    height: int,
+    width: int,
+    offset: int,
+) -> tuple[int, int, int, int]:
+    r, c = map(int, point)
+    if side == "top":
+        r0 = r
+        c0 = c - offset
+    elif side == "bottom":
+        r0 = r - height + 1
+        c0 = c - offset
+    elif side == "left":
+        r0 = r - offset
+        c0 = c
+    elif side == "right":
+        r0 = r - offset
+        c0 = c - width + 1
