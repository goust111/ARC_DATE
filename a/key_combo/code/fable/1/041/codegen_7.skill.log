+    dr, dc = direction
+    H, W = grid.shape
+    r, c = start
+    path = [start]
+    while True:
+        r += dr
+        c += dc
+        if not (0 <= r < H and 0 <= c < W):
+            return path, None
+        pos = (r, c)
