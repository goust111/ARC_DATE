+
+def _box_area_clear(
+    bbox: tuple[int, int, int, int],
+    area_mask: np.ndarray,
+    reserved_mask: np.ndarray,
+    allowed_reserved: set[tuple[int, int]] | None = None,
+    padding: int = 1,
+) -> bool:
+    H, W = area_mask.shape
+    r0, c0, r1, c1 = bbox
+    if r0 < 0 or c0 < 0 or r1 >= H or c1 >= W:
+        return False
