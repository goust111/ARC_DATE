+            if any(area_mask[r, c] or reserved_mask[r, c] for r, c in segment[1:-1]):
+                continue
+            _add_box(box, grid, area_mask)
+            boxes.append(box)
+            chain_lines.append(segment)
+            chain_targets.append(len(boxes) - 1)
+            for r, c in segment:
