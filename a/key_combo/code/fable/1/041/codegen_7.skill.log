+
+
+def _trace_to_edge(
+    start: tuple[int, int],
+    direction: tuple[int, int],
+    shape: tuple[int, int],
+) -> list[tuple[int, int]]:
+    dr, dc = direction
+    H, W = shape
+    r, c = start
+    out = [start]
+    while True:
+        r += dr
+        c += dc
+        if not (0 <= r < H and 0 <= c < W):
+            break
+        out.append((r, c))
+    return out
+
+
+def _side_of_gap(
+    pos: tuple[int, int],
+    bbox: tuple[int, int, int, int],
+) -> str | None:
+    r, c = pos
+    r0, c0, r1, c1 = bbox
+    if (r in (r0, r1)) and (c in (c0, c1)):
+        return None
+    if r == r0:
+        return "top"
+    if r == r1:
+        return "bottom"
+    if c == c0:
+        return "left"
+    if c == c1:
+        return "right"
+    return None
+
+
+def _box_patch(box: dict, *, fill: int | None = None) -> np.ndarray:
+    r0, c0, r1, c1 = box["bbox"]
+    height = r1 - r0 + 1
+    width = c1 - c0 + 1
+    patch = np.full((height, width), BG, dtype=int)
+    patch[0, :] = patch[-1, :] = patch[:, 0] = patch[:, -1] = int(box["border"])
+    for gap in box["gaps"]:
+        gr, gc = gap["pos"]
+        patch[gr - r0, gc - c0] = BG
+    if fill is not None:
+        patch[1:-1, 1:-1] = int(fill)
+    return patch
+
+
+def _box_area_clear(
+    bbox: tuple[int, int, int, int],
+    area_mask: np.ndarray,
+    reserved_mask: np.ndarray,
+    allowed_reserved: set[tuple[int, int]] | None = None,
+    padding: int = 1,
+) -> bool:
+    H, W = area_mask.shape
+    r0, c0, r1, c1 = bbox
+    if r0 < 0 or c0 < 0 or r1 >= H or c1 >= W:
+        return False
+    rr0 = max(0, r0 - padding)
+    cc0 = max(0, c0 - padding)
+    rr1 = min(H - 1, r1 + padding)
+    cc1 = min(W - 1, c1 + padding)
+    if area_mask[rr0 : rr1 + 1, cc0 : cc1 + 1].any():
+        return False
+    allowed = set() if allowed_reserved is None else set(allowed_reserved)
+    for cell in _bbox_cells(bbox):
+        if cell in allowed:
+            continue
+        if reserved_mask[cell]:
