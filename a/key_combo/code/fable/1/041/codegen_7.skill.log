def _gen_output_bounds(coords, area, height):
    shape_h = int(coords[:, 0].max()) + 1
    shape_w = int(coords[:, 1].max()) + 1
    min_r = area + 1
    max_r = min(height - 1, height - shape_h + area)
    return min_r, max_r, shape_h, shape_w


def _gen_clip_indices(shapes, areas):
