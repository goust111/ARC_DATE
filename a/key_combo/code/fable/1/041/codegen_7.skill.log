+    return {
+        "bbox": bbox,
+        "border": color,
+        "gaps": gap_infos,
+        "fill": fill,
+    }
+
+
+def _extract_boxes(grid: np.ndarray) -> tuple[list[dict], int, int]:
+    g = np.asarray(grid, dtype=int)
+    bg = int(get_bg(g))
+    comps = find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict")
+    boxes = []
+    for comp in comps:
+        box = _analyze_box(g, comp, bg)
+        if box is not None:
