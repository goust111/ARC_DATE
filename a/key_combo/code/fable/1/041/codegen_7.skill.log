+SIDES = ("top", "bottom", "left", "right")
+SIDE_TO_DIR = {
+    "top": (-1, 0),
+    "bottom": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+OPPOSITE_SIDE = {
+    "top": "bottom",
+    "bottom": "top",
+    "left": "right",
+    "right": "left",
+}
+BOX_SIZE_RANGE = (4, 7)
+PATH_LEN_RANGE = (2, 6)
