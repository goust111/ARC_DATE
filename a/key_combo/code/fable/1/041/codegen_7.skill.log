+        return None
+    if r == r0:
+        return "top"
+    if r == r1:
+        return "bottom"
+    if c == c0:
+        return "left"
+    if c == c1:
+        return "right"
+    return None
+
+
+def _box_patch(box: dict, *, fill: int | None = None) -> np.ndarray:
+    r0, c0, r1, c1 = box["bbox"]
