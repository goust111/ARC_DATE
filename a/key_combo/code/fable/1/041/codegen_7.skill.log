+    return True
+
+
+def _add_box(box: dict, grid: np.ndarray, area_mask: np.ndarray) -> None:
+    fill = box.get("fill")
+    patch = _box_patch(box, fill=fill)
+    r0, c0, r1, c1 = box["bbox"]
+    grid[r0 : r1 + 1, c0 : c1 + 1] = np.where(patch != BG, patch, grid[r0 : r1 + 1, c0 : c1 + 1])
