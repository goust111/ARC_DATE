+from __future__ import annotations
+
+import random
+import sys
+from pathlib import Path
+
+import numpy as np
+
+_UTILS_DIR = Path("/home/lixinyu/snap/new/solvers")
+if str(_UTILS_DIR) not in sys.path:
+    sys.path.append(str(_UTILS_DIR))
+
+from arc_utils import find_components, get_bg, random_free_location
+
+
+BG = 0
+CANVAS_SHAPE = (30, 30)
+PALETTE = [1, 2, 3, 4, 5, 6, 7, 8, 9]
+SIDES = ("top", "bottom", "left", "right")
+SIDE_TO_DIR = {
+    "top": (-1, 0),
+    "bottom": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+OPPOSITE_SIDE = {
+    "top": "bottom",
+    "bottom": "top",
+    "left": "right",
+    "right": "left",
+}
+BOX_SIZE_RANGE = (4, 7)
+PATH_LEN_RANGE = (2, 6)
+CHAIN_LENGTHS = (1, 2, 3, 4)
+MAX_ATTEMPTS = 500
+
+
+def _side_from_dir(direction: tuple[int, int]) -> str:
+    for side, vec in SIDE_TO_DIR.items():
+        if tuple(direction) == vec:
+            return side
+    raise ValueError(f"unknown direction: {direction}")
+
+
+def _offset_choices(side: str, height: int, width: int) -> list[int]:
+    if side in ("top", "bottom"):
+        return list(range(1, width - 1))
+    return list(range(1, height - 1))
+
+
+def _gap_coord(bbox: tuple[int, int, int, int], side: str, offset: int) -> tuple[int, int]:
+    r0, c0, r1, c1 = bbox
+    if side == "top":
+        return r0, c0 + offset
+    if side == "bottom":
+        return r1, c0 + offset
+    if side == "left":
+        return r0 + offset, c0
+    if side == "right":
+        return r0 + offset, c1
+    raise ValueError(side)
+
+
+def _bbox_from_edge_point(
+    point: tuple[int, int],
+    side: str,
+    height: int,
+    width: int,
+    offset: int,
+) -> tuple[int, int, int, int]:
+    r, c = map(int, point)
+    if side == "top":
+        r0 = r
+        c0 = c - offset
+    elif side == "bottom":
+        r0 = r - height + 1
+        c0 = c - offset
+    elif side == "left":
+        r0 = r - offset
+        c0 = c
+    elif side == "right":
+        r0 = r - offset
+        c0 = c - width + 1
+    else:
+        raise ValueError(side)
+    return int(r0), int(c0), int(r0 + height - 1), int(c0 + width - 1)
+
+
+def _bbox_cells(bbox: tuple[int, int, int, int]) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    return [(r, c) for r in range(r0, r1 + 1) for c in range(c0, c1 + 1)]
+
+
+def _perimeter_cells(bbox: tuple[int, int, int, int]) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    cells = []
+    for c in range(c0, c1 + 1):
+        cells.append((r0, c))
+        cells.append((r1, c))
+    for r in range(r0 + 1, r1):
+        cells.append((r, c0))
+        cells.append((r, c1))
+    return cells
+
+
+def _line_cells(a: tuple[int, int], b: tuple[int, int]) -> list[tuple[int, int]]:
+    r0, c0 = a
+    r1, c1 = b
+    if r0 == r1:
+        step = 1 if c1 >= c0 else -1
+        return [(r0, c) for c in range(c0, c1 + step, step)]
+    if c0 == c1:
+        step = 1 if r1 >= r0 else -1
+        return [(r, c0) for r in range(r0, r1 + step, step)]
+    raise ValueError(f"not axis-aligned: {a} -> {b}")
+
+
+def _trace_to_edge(
+    start: tuple[int, int],
+    direction: tuple[int, int],
+    shape: tuple[int, int],
+) -> list[tuple[int, int]]:
+    dr, dc = direction
+    H, W = shape
+    r, c = start
+    out = [start]
+    while True:
+        r += dr
+        c += dc
+        if not (0 <= r < H and 0 <= c < W):
+            break
+        out.append((r, c))
+    return out
+
+
+def _side_of_gap(
+    pos: tuple[int, int],
+    bbox: tuple[int, int, int, int],
+) -> str | None:
+    r, c = pos
+    r0, c0, r1, c1 = bbox
+    if (r in (r0, r1)) and (c in (c0, c1)):
+        return None
+    if r == r0:
+        return "top"
+    if r == r1:
+        return "bottom"
+    if c == c0:
+        return "left"
+    if c == c1:
+        return "right"
+    return None
+
+
+def _box_patch(box: dict, *, fill: int | None = None) -> np.ndarray:
+    r0, c0, r1, c1 = box["bbox"]
+    height = r1 - r0 + 1
+    width = c1 - c0 + 1
+    patch = np.full((height, width), BG, dtype=int)
