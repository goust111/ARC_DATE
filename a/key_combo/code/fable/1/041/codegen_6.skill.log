@@ -0,0 +1,564 @@
+from __future__ import annotations
+
+import random
+from functools import lru_cache
+
+import numpy as np
+
+
+UP = (-1, 0)
+DOWN = (1, 0)
+LEFT = (0, -1)
+RIGHT = (0, 1)
+DIRS = (UP, DOWN, LEFT, RIGHT)
+OPPOSITE = {UP: DOWN, DOWN: UP, LEFT: RIGHT, RIGHT: LEFT}
+
+TL, TR, BL, BR = 0, 1, 2, 3
+TERRITORY_OUTWARD_DIRS = {
+    TL: {UP, LEFT},
+    TR: {UP, RIGHT},
+    BL: {DOWN, LEFT},
+    BR: {DOWN, RIGHT},
+}
+
+BASE_SHAPES = (
+    np.array([[1, 1]], dtype=bool),
+    np.array([[1, 1, 1]], dtype=bool),
+    np.array([[1, 0], [1, 1]], dtype=bool),
+    np.array([[1, 1], [1, 1]], dtype=bool),
+    np.array([[1, 1, 0], [0, 1, 1]], dtype=bool),
+    np.array([[1, 1], [1, 0], [1, 0]], dtype=bool),
+    np.array([[1, 0, 0], [1, 1, 1]], dtype=bool),
+    np.array([[1, 1, 1], [1, 0, 0]], dtype=bool),
+)
+
+PAIR_COUNT_CHOICES = (3, 4)
+CELL_SIDE_RANGE = (9, 11)
+GAP_RANGE = (3, 4)
+MOVE_LEN_RANGE = (1, 4)
+ARM_LEN_RANGE = (1, 3)
+MAX_ATTEMPTS = 400
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _find_monochrome_components(grid: np.ndarray, bg: int) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    H, W = g.shape
+    comps: list[dict] = []
+    for color_raw in np.unique(g):
+        color = int(color_raw)
+        if color == bg:
+            continue
+        mask = g == color
+        visited = np.zeros((H, W), dtype=bool)
+        starts = np.argwhere(mask)
+        for start in starts:
+            sr, sc = map(int, start)
+            if visited[sr, sc]:
+                continue
+            stack = [(sr, sc)]
+            visited[sr, sc] = True
+            cells: list[tuple[int, int]] = []
+            while stack:
+                r, c = stack.pop()
+                cells.append((r, c))
+                for dr, dc in DIRS:
+                    rr = r + dr
+                    cc = c + dc
+                    if 0 <= rr < H and 0 <= cc < W and mask[rr, cc] and not visited[rr, cc]:
+                        visited[rr, cc] = True
+                        stack.append((rr, cc))
+            coords = np.array(cells, dtype=int)
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": _bbox_coords(coords),
+                    "area": int(coords.shape[0]),
+                }
+            )
+    return comps
+
+
+def _analyze_incomplete_cross(coords: np.ndarray) -> dict | None:
+    cells = {(int(r), int(c)) for r, c in coords}
+    matches: list[dict] = []
+    for center in cells:
+        cr, cc = center
+        if not all(r == cr or c == cc for r, c in cells):
+            continue
+        lengths: dict[tuple[int, int], int] = {}
+        total = 1
+        for dr, dc in DIRS:
+            length = 0
+            rr = cr + dr
+            cc2 = cc + dc
+            while (rr, cc2) in cells:
+                length += 1
+                rr += dr
+                cc2 += dc
+            lengths[(dr, dc)] = length
+            total += length
+        if total != len(cells):
+            continue
+        missing = [d for d in DIRS if lengths[d] == 0]
+        if len(missing) != 1:
+            continue
+        missing_dir = missing[0]
+        distance = int(lengths[OPPOSITE[missing_dir]])
+        if distance <= 0:
+            continue
+        matches.append(
+            {
+                "center": (cr, cc),
+                "missing": missing_dir,
+                "distance": distance,
+                "lengths": lengths,
+            }
+        )
