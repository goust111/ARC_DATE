+            "direction": direction,
+            "clip": clip,
+            "distance": amount,
+            "color": int(color),
+            "sprite_mask": sprite_mask,
+            "sprite_top_left": (top, left),
+            "sprite_coords": sprite_coords,
+            "moved_coords": moved_coords,
+            "marker_mask": marker_mask,
+            "territory": territory,
+        }
