def _platform_runs(row: np.ndarray, platform: int, bg: int) -> list[tuple[int, int]]:
    runs: list[tuple[int, int]] = []
    c = 0
    W = int(row.shape[0])
    while c < W:
        if int(row[c]) == platform:
            c0 = c
            while c < W and int(row[c]) == platform:
