+        (top, left, cell_h - 1, cell_w - 1),
+        (top, mid_c, cell_h - 1, mid_c + cell_w - 1),
+        (mid_r, left, mid_r + cell_h - 1, cell_w - 1),
+        (mid_r, mid_c, mid_r + cell_h - 1, mid_c + cell_w - 1),
