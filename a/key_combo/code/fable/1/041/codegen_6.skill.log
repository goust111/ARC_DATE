+PAIR_COUNT_CHOICES = (3, 4)
+CELL_SIDE_RANGE = (9, 11)
+GAP_RANGE = (3, 4)
+MOVE_LEN_RANGE = (1, 4)
+ARM_LEN_RANGE = (1, 3)
