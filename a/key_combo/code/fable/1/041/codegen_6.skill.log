    assert set(map(int, g[shelf])) <= {bg, platform}

    runs = _platform_runs(g[shelf], platform, bg)
    assert len(runs) >= 2

    slots: list[tuple[int, int, int]] = []
    for (_left_start, left_end), (right_start, _right_end) in zip(runs, runs[1:]):
