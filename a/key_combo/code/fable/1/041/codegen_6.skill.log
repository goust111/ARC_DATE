+    components = _find_monochrome_components(g, bg)
+    markers: list[dict] = []
+    sprites: list[dict] = []
+    for comp in components:
+        marker_info = _analyze_incomplete_cross(comp["coords"])
+        if marker_info is None:
+            sprites.append(comp)
+        else:
+            markers.append({**comp, **marker_info})
