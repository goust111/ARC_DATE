+    for r in range(border, H - h - border + 1):
+        for c in range(border, W - w - border + 1):
+            rr0 = max(0, r - padding)
+            cc0 = max(0, c - padding)
+            rr1 = min(H, r + h + padding)
+            cc1 = min(W, c + w + padding)
