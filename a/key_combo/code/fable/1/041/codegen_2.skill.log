    grid: np.ndarray,
    color: int,
    *,
    density: float = 0.5,
    background: int = Color.BLACK,
) -> np.ndarray:
    """Randomly scatter points of `color` into `background` cells until reaching density."""
    bg = int(background)
    col = int(color)
    colored = 0
    H, W = grid.shape
    target = int(round(float(density) * H * W))
    while colored < target:
        r = np.random.randint(0, H)

