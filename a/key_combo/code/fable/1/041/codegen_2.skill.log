masks = {
'M1': ['111','100'],
'M2': ['1111','1000'],
'M3': ['111','100','100'],
'M4': ['111','110','100'],
'M5': ['111','101','100'],
'M6': ['1111','1100','1000'],
'M7': ['1111','1010','1000'],
'M8': ['1111','1100','1000','1000'],
'M9': ['1111','1110','1000','1000'],
'M10':['1111','1101','1001','1000'],
}

def arr(rows):
    return np.array([[c=='1' for c in row] for row in rows], dtype=bool)

def conn(mask):
    pts=list(map(tuple,np.argwhere(mask)))
    if not pts: return False
    q=deque([pts[0]])
    seen={pts[0]}
    H,W=mask.shape
    while q:
        r,c=q.popleft()
        for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
