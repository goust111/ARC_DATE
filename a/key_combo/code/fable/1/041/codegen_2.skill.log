+
+
+_HOLE_LIBRARY = _build_library()
+
+
+def _choose_hole_specs() -> list[dict]:
+    count = random.randint(2, 4)
+    groups: dict[tuple[int, int], list[dict]] = {}
+    for info in _HOLE_LIBRARY:
+        groups.setdefault(info["shape"], []).append(info)
+
