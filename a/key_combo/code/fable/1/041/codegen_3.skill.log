+    top_lefts = [pos for pos in positions if pos is not None]
+    assert len(top_lefts) == tile_count
+    if _chain_is_spatially_obvious(top_lefts):
+        return None
+
+    try:
+        if not np.array_equal(main(grid), expected):
+            return None
+    except Exception:
+        return None
+    return grid
