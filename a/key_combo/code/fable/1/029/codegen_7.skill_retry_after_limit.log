+def _connected(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return True
+    start = tuple(map(int, coords[0]))
+    todo = deque([start])
+    seen = {start}
+    h, w = mask.shape
+    while todo:
+        r, c = todo.popleft()
+        for dr, dc in NEIGHBORS4:
+            rr = r + dr
+            cc = c + dc
+            if 0 <= rr < h and 0 <= cc < w and mask[rr, cc] and (rr, cc) not in seen:
+                seen.add((rr, cc))
+                todo.append((rr, cc))
