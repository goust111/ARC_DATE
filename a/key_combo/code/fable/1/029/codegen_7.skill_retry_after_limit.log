+    sprite_colors = {int(sprite["color"]) for sprite in sprites}
+    assert sprite_colors == set(fragments), "every sprite color must have exactly one fragment color below"
+
+    out = np.full((h, w), BG, dtype=int)
+    out[line_row, :] = WATER
