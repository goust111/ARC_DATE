+        rng,
+        max_height=max_sprite_height,
+        max_width=max_sprite_width,
+        challenging=True,
+    )
+    if challenge_mask is None:
+        return None
+    specs.append({"color": int(colors[0]), "mask": challenge_mask, "challenge": True})
+    for color in colors[1:]:
