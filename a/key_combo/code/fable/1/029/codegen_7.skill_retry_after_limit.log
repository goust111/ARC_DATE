+    full = sorted(_reflection_cells(mask, line_row, true_left))
+    min_k = 2 if require_multi else 1
+    max_k = min(4, len(full))
+    if min_k > max_k:
+        return None
+
+    for size in range(min_k, max_k + 1):
+        combos = list(itertools.combinations(full, size))
+        rng.shuffle(combos)
