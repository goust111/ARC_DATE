+def _stairs_mask(height: int, width: int) -> np.ndarray:
+    mask = np.zeros((height, width), dtype=bool)
+    for r in range(height):
+        c = min(width - 1, int(round(r * (width - 1) / max(1, height - 1))))
+        mask[r, : c + 1] = True
