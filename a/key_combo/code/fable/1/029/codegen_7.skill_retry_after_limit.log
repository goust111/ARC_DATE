+        frontier = []
+        for cr, cc in cells:
+            for dr, dc in NEIGHBORS4:
+                rr = cr + dr
+                cc2 = cc + dc
+                if 0 <= rr < height and 0 <= cc2 < width and (rr, cc2) not in cells:
+                    frontier.append((rr, cc2))
