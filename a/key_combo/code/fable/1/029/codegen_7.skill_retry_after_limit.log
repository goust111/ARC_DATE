+
+    if challenging:
+        height = rng.randint(2, min(4, max_height))
+        width = rng.randint(3, min(5, max_width))
+        family = "rect" if rng.random() < 0.7 else "frame"
+    else:
+        family = rng.choice(("rect", "frame", "l", "t", "stairs", "blob"))
