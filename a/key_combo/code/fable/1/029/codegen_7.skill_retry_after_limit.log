+                continue
+            if require_necessary:
+                keep = True
+                for idx in range(len(combo)):
+                    reduced = combo[:idx] + combo[idx + 1 :]
+                    if len(_valid_columns(mask, reduced, line_row, width)) <= 1:
+                        keep = False
+                        break
