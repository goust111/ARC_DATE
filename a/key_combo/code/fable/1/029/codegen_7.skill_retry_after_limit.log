+def _blob_mask(height: int, width: int, rng: random.Random) -> np.ndarray:
+    target = rng.randint(max(height + width - 1, (height * width + 1) // 2), height * width)
+    cells = {(0, 0)}
+    r = c = 0
+    steps = [(1, 0)] * (height - 1) + [(0, 1)] * (width - 1)
+    rng.shuffle(steps)
+    for dr, dc in steps:
+        r += dr
+        c += dc
+        cells.add((r, c))
