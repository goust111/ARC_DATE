+    *,
+    max_height: int,
+    max_width: int,
+    challenging: bool,
+) -> np.ndarray | None:
+    if max_height < 2 or max_width < 2:
+        return None
+
+    if challenging:
+        height = rng.randint(2, min(4, max_height))
+        width = rng.randint(3, min(5, max_width))
