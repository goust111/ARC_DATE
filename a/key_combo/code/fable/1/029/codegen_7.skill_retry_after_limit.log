+
+import itertools
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+WATER = 5
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
