import itertools, random
import numpy as np

BG=0
WATER=5
PALETTE=[1,2,3,4,6,7,8,9]

def rect(h,w):
    return np.ones((h,w),dtype=bool)

def reflection_rel(mask):
    h,w=mask.shape
    return {(h-1-r,c) for r,c in np.argwhere(mask)}

def reflection_cells(mask,line,x):
    return {(line+1+rr, x+cc) for rr,cc in reflection_rel(mask)}

def valid_cols(mask, frags, line, W):
    h,w=mask.shape
    cols=[]
    for x in range(W-w+1):
        cells=reflection_cells(mask,line,x)
        if set(frags).issubset(cells):
            cols.append(x)
    return cols

def choose(mask,line,W,true_x,force_necessary=False,min_k=1,max_k=4):
    cells=sorted(reflection_cells(mask,line,true_x))
    rng=random.Random()
    for k in range(min_k, min(max_k,len(cells))+1):
        combos=list(itertools.combinations(cells,k))
        rng.shuffle(combos)
        for combo in combos:
            vc=valid_cols(mask, combo, line, W)
            if vc "'!= [true_x]:
                continue
            if force_necessary:
                ok=True
                for i in range(len(combo)):
                    sub=combo[:i]+combo[i+1:]
                    if len(valid_cols(mask, sub, line, W)) <= 1:
                        ok=False; break
                if not ok:
                    continue
            return combo
    return None

for _ in range(20):
    h=random.randint(2,4); w=random.randint(3,5)
    mask=rect(h,w)
    line=7; W=20; x=random.randint(0,W-w)
    combo=choose(mask,line,W,x,force_necessary=True,min_k=2)
    print((h,w,x), combo, valid_cols(mask, combo, line, W) if combo else None)
