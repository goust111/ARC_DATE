+
+
+def _t_mask(height: int, width: int) -> np.ndarray:
+    mask = np.zeros((height, width), dtype=bool)
+    mid = width // 2
+    mask[0, :] = True
+    mask[:, mid] = True
+    if height >= 3 and width >= 3:
+        lo = max(0, mid - 1)
+        hi = min(width, mid + 2)
+        mask[-1, lo:hi] = True
