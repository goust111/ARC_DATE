+        return None
+
+    if family == "rect":
+        mask = _rectangle_mask(height, width)
+    elif family == "frame":
+        mask = _frame_mask(height, width)
+    elif family == "l":
+        mask = _l_mask(height, width)
+    elif family == "t":
+        mask = _t_mask(height, width)
+    elif family == "stairs":
+        mask = _stairs_mask(height, width)
