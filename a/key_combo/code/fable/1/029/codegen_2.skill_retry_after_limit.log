+    panel_bg = _most_common_color(np.concatenate([top.ravel(), bottom.ravel()]))
+    key_mask = (top != panel_bg) ^ (bottom != panel_bg)
+    assert bool(key_mask.any()), "panel xor must produce a non-empty key"
+    return key_mask, work_r0
