+    palette = [1, 2, 3, 4, 6, 7, 8, 9]
+    top_color, bottom_color, sep_color = random.sample(palette, 3)
+
+    grid = np.full((2 * panel_h + 1 + work_h, width), BLACK, dtype=int)
+    grid[:panel_h, :][top_mask] = top_color
+    grid[panel_h, :] = sep_color
