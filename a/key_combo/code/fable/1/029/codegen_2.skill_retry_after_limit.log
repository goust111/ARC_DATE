+def _all_positions(occ: np.ndarray, patch: np.ndarray, padding: int = 0) -> list[tuple[int, int]]:
+    h, w = occ.shape
+    ph, pw = patch.shape
+    cells = np.argwhere(patch)
+    positions: list[tuple[int, int]] = []
