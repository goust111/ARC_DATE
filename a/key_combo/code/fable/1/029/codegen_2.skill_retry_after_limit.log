+        for c0 in range(w - pw + 1):
+            ok = True
+            for rr, cc in cells:
+                gr = r0 + int(rr)
+                gc = c0 + int(cc)
+                for dr in range(-padding, padding + 1):
+                    for dc in range(-padding, padding + 1):
+                        nr, nc = gr + dr, gc + dc
+                        if 0 <= nr < h and 0 <= nc < w and occ[nr, nc]:
