+    work_r0 = 2 * panel_h + 1
+    assert work_r0 < g.shape[0], "workspace must exist below the two panels"
+
+    top = g[:panel_h, :]
+    bottom = g[sep_r + 1 : sep_r + 1 + panel_h, :]
+    assert top.shape == bottom.shape and top.size > 0
