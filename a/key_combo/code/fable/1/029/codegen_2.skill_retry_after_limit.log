+        random.shuffle(nbrs)
+        for nxt in nbrs:
+            parent[nxt] = cell
+            stack.append(nxt)
+
+    children: dict[tuple[int, int], list[tuple[int, int]]] = {cell: [] for cell in cells}
+    for cell, par in parent.items():
+        if par is not None:
+            children[par].append(cell)
+
