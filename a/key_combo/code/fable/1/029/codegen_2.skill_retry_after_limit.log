+def _enclosed_black_mask(crop: np.ndarray) -> np.ndarray:
+    black = crop == BLACK
+    h, w = crop.shape
+    exterior = np.zeros((h, w), dtype=bool)
+    stack: list[tuple[int, int]] = []
+
+    for r in range(h):
+        for c in (0, w - 1):
+            if black[r, c] and not exterior[r, c]:
+                exterior[r, c] = True
+                stack.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if black[r, c] and not exterior[r, c]:
+                exterior[r, c] = True
+                stack.append((r, c))
+
+    while stack:
+        r, c = stack.pop()
+        for dr, dc in _N4:
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < h and 0 <= nc < w and black[nr, nc] and not exterior[nr, nc]:
+                exterior[nr, nc] = True
+                stack.append((nr, nc))
