+    root = random.choice(cells)
+    parent: dict[tuple[int, int], tuple[int, int] | None] = {root: None}
+    order: list[tuple[int, int]] = []
+    stack = [root]
+    while stack:
+        cell = stack.pop()
+        order.append(cell)
+        nbrs = []
+        for dr, dc in _N4:
+            nxt = (cell[0] + dr, cell[1] + dc)
+            if nxt in cell_set and nxt not in parent:
