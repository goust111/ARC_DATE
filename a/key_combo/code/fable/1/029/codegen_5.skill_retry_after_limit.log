 129:     for h in range(MOVER_HEIGHT_RANGE[0], MOVER_HEIGHT_RANGE[1] + 1):
 130:         cells = h * int(w)
 131:         lo = max(MOVER_AREA_RANGE[0], _ceil_fraction(cells, *MOVER_MIN_DENSITY))
 132:         hi = min(MOVER_AREA_RANGE[1], cells, int(max_area))
 133:         for area in range(lo, hi + 1):
 134:             if _mask_options(h, int(w), area):
 135:                 choices.append((h, area))
 136:     if not choices:
 137:         return None
