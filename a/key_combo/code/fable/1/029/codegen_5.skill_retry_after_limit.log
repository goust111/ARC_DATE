 101: def main(grid: np.ndarray) -> np.ndarray:
 102:     """
 103:     Stretch a rectilinear foreground line drawing so its outside edges sit next to the control markers.
 104: 
 105:     Input structure
 106:     - The background is the dominant color.
 107:     - One foreground color forms a connected rectilinear line drawing made exactly from full horizontal and vertical bars.
 108:     - The other foreground color consists of isolated control pixels outside the drawing.
 109:     Rule
 110:     - Find the unique rectangle that contains the original line drawing and has every control pixel one cell outside one of its sides.
 111:     - Move the original outer bars to the corresponding sides of that rectangle, keeping interior bars fixed.
 112:     - Redraw the bars across the new rectangle and preserve the control pixels.
 113:     Key insight
 114:     - The markers do not get connected; they specify the final bounding sides of a stretched line drawing.
 115:     """
 116:     g = np.asarray(grid, dtype=int)
 117:     assert g.ndim == 2, "expected a 2D grid"
 118: 
 119:     bg = get_bg(g)
 120:     line_color, marker_color = _line_and_marker_colors(g, bg)
 121: 
 122:     line_mask = g == line_color
 123:     original_box = bbox(line_mask)
 124:     assert original_box is not None, "expected a line drawing"
 125:     horizontal_rows, vertical_cols = _full_bar_positions(line_mask, original_box)
 126: 
 127:     markers = [tuple(map(int, coord)) for coord in np.argwhere(g == marker_color)]
 128:     assert markers, "expected control markers"
 129:     new_r0, new_c0, new_r1, new_c1 = _target_bbox(g, original_box, markers)
 130: 
 131:     old_r0, old_c0, old_r1, old_c1 = original_box
 132:     out = g.copy()
 133:     out[line_mask] = bg
 134: 
 135:     new_horizontal_rows = [
 136:         new_r0 if row == old_r0 else new_r1 if row == old_r1 else row
 137:         for row in horizontal_rows
 138:     ]
 139:     new_vertical_cols = [
 140:         new_c0 if col == old_c0 else new_c1 if col == old_c1 else col
 141:         for col in vertical_cols
 142:     ]
 143:     assert len(new_horizontal_rows) == len(set(new_horizontal_rows))
 144:     assert len(new_vertical_cols) == len(set(new_vertical_cols))
 145: 
 146:     for row in new_horizontal_rows:
 147:         assert new_r0 <= row <= new_r1
 148:         out[row, new_c0 : new_c1 + 1] = line_color
 149:     for col in new_vertical_cols:
 150:         assert new_c0 <= col <= new_c1
 151:         out[new_r0 : new_r1 + 1, col] = line_color
 152: 
 153:     assert np.all(out[g == marker_color] == marker_color), "control markers must be preserved"
 154:     return out
