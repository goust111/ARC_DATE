  14: def main(grid: np.ndarray) -> np.ndarray:
  15:     """
  16:     Drop every large foreground object straight down to the bottom while leaving small marker objects fixed.
  17: 
  18:     Input structure:
  19:     - The grid has a dominant background color and exactly one foreground color.
  20:     - The foreground is split into separated 4-connected objects.
  21:     - Objects of area at most three are stationary markers; larger objects are moving sprites.
  22: 
  23:     Rule:
  24:     - Clear each moving sprite from its original position.
  25:     - Translate each moving sprite vertically downward until its bbox bottom reaches the grid bottom.
  26:     - Repaint each translated sprite in its original color; small markers stay unchanged.
  27: 
  28:     Key insight:
  29:     - Object area separates the active falling sprites from the small fixed markers, and all active sprites follow the same vertical path.
  30:     """
  31:     g = np.asarray(grid, dtype=int)
  32:     H, W = g.shape
  33:     bg = int(get_bg(g))
  34: 
  35:     fg_colors = colors_present(g, exclude={bg})
  36:     assert len(fg_colors) == 1, "expected exactly one foreground color"
  37:     fg = int(fg_colors[0])
  38: 
  39:     components = find_components(
  40:         g,
  41:         bg=bg,
  42:         connectivity=4,
  43:         monochromatic=True,
  44:         colors=[fg],
  45:         return_format="dict",
  46:     )
  47:     assert components, "expected foreground objects"
  48: 
  49:     moving = [comp for comp in components if int(comp["area"]) > SMALL_MARKER_MAX_AREA]
  50:     stationary = [comp for comp in components if int(comp["area"]) <= SMALL_MARKER_MAX_AREA]
  51:     assert moving, "expected at least one moving sprite"
  52:     assert stationary, "expected at least one fixed marker"
  53: 
  54:     out = g.copy()
  55:     for comp in moving:
  56:         coords = comp["coords"]
  57:         out[coords[:, 0], coords[:, 1]] = bg
  58: 
  59:     occupied = np.zeros((H, W), dtype=bool)
  60:     for comp in moving:
  61:         coords = comp["coords"]
  62:         _r0, _c0, r1, _c1 = map(int, comp["bbox"])
  63:         dr = H - 1 - r1
  64:         assert dr >= 0, "moving sprite bbox must already be inside the grid"
  65: 
  66:         shifted = coords + np.array([dr, 0], dtype=int)
  67:         assert bool(np.all((0 <= shifted[:, 0]) & (shifted[:, 0] < H)))
  68:         assert bool(np.all((0 <= shifted[:, 1]) & (shifted[:, 1] < W)))
  69:         assert not bool(occupied[shifted[:, 0], shifted[:, 1]].any()), "dropped sprites must not overlap"
  70:         assert bool(np.all(out[shifted[:, 0], shifted[:, 1]] == bg)), "drop path must end on background"
  71: 
  72:         occupied[shifted[:, 0], shifted[:, 1]] = True
  73:         out[shifted[:, 0], shifted[:, 1]] = int(comp["color"])
  74: 
  75:     return out
