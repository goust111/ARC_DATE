 112: def _mask_options(h: int, w: int, area: int) -> tuple[tuple[int, ...], ...]:
 113:     total = int(h) * int(w)
 114:     holes = total - int(area)
 115:     out: list[tuple[int, ...]] = []
 116:     for removed in itertools.combinations(range(total), holes):
 117:         mask = np.ones((h, w), dtype=bool)
 118:         for idx in removed:
 119:             mask[idx // w, idx % w] = False
 120:         if not (mask[0].any() and mask[-1].any() and mask[:, 0].any() and mask[:, -1].any()):
