 135: def main(grid: np.ndarray) -> np.ndarray:
 136:     """
 137:     Complete partial workspace sprites by matching them to full templates shown in the non-black catalog region.
 138: 
 139:     Input structure
 140:     - A large non-black connected region is the catalog background.
 141:     - Multi-color template sprites touch that catalog background; all other
 142:       foreground objects lie in the black workspace.
 143:     - Some workspace objects are partial views of a catalog template, while
 144:       distractor objects do not match any template part.
 145: 
 146:     Rule
 147:     - For each workspace object, find the unique catalog template that it matches:
 148:       either a full template bbox filled with one template border color, a
 149:       uniquely sized single-color mask of the template, or a multi-color boundary
 150:       window of the template.
 151:     - Stamp the full matched template at the aligned position, treating catalog
 152:       background cells inside the template bbox as transparent.
 153:     - Leave workspace objects with no template match unchanged.
 154: 
 155:     Key insight
 156:     - The colored objects in the catalog are not to be copied in order; they are
 157:       a legend of target sprites, and each incomplete workspace object determines
 158:       its template and alignment from the visible sub-sprite it already contains.
 159:     """
 160:     g = np.asarray(grid, dtype=int)
 161:     assert g.ndim == 2, "expected a 2D grid"
 162: 
 163:     catalog_color, catalog_mask = _catalog_background(g)
 164:     templates = _templates(g, catalog_color, catalog_mask)
 165: 
 166:     planned: dict[tuple[int, int], int] = {}
 167:     workspace = (g != 0) & (~catalog_mask)
 168:     for coords in components_mask(workspace, connectivity=8):
 169:         if _touches(catalog_mask, coords):
 170:             continue
 171: 
 172:         box, part = _component_array(g, coords)
 173:         r0, c0, _r1, _c1 = box
 174:         source_mask = np.zeros_like(g, dtype=bool)
 175:         source_mask[coords[:, 0], coords[:, 1]] = True
 176: 
 177:         matches = []
 178:         for template in templates:
 179:             sprite = template["grid"]
 180:             for off_r, off_c in _template_offsets(part, template):
 181:                 anchor_r, anchor_c = r0 - off_r, c0 - off_c
 182:                 height, width = map(int, sprite.shape)
 183:                 if not (
 184:                     0 <= anchor_r
 185:                     and 0 <= anchor_c
 186:                     and anchor_r + height <= g.shape[0]
 187:                     and anchor_c + width <= g.shape[1]
 188:                 ):
 189:                     continue
 190: 
 191:                 ok = True
 192:                 for rr, cc in np.argwhere(template["visible"]):
 193:                     gr, gc = anchor_r + int(rr), anchor_c + int(cc)
 194:                     value = int(sprite[rr, cc])
 195:                     if g[gr, gc] != 0 and not source_mask[gr, gc] and g[gr, gc] != value:
 196:                         ok = False
 197:                         break
 198:                 if ok:
 199:                     cells = tuple(
 200:                         (int(rr), int(cc), int(sprite[rr, cc]))
 201:                         for rr, cc in np.argwhere(template["visible"])
 202:                     )
 203:                     matches.append((anchor_r, anchor_c, cells))
 204: 
 205:         unique_matches = []
 206:         seen = set()
 207:         for match in matches:
 208:             if match not in seen:
 209:                 seen.add(match)
 210:                 unique_matches.append(match)
 211:         assert len(unique_matches) <= 1, "expected each workspace object to match at most one template"
 212: 
 213:         if not unique_matches:
 214:             continue
 215: 
 216:         anchor_r, anchor_c, cells = unique_matches[0]
 217:         for rr, cc, value in cells:
 218:             target = (anchor_r + rr, anchor_c + cc)
 219:             assert planned.get(target, value) == value, "expected overlapping template stamps to agree"
 220:             planned[target] = value
 221: 
 222:     out = g.copy()
 223:     for (r, c), value in planned.items():
 224:         out[r, c] = value
 225:     return out
