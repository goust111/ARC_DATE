+def _control_matches_box(r: int, c: int, box: tuple[int, int, int, int]) -> bool:
+    r0, c0, r1, c1 = map(int, box)
+    hits = 0
+    hits += int(r == r0 - 1 and c0 <= c <= c1)
+    hits += int(r == r1 + 1 and c0 <= c <= c1)
+    hits += int(c == c0 - 1 and r0 <= r <= r1)
+    hits += int(c == c1 + 1 and r0 <= r <= r1)
+    return hits == 1
