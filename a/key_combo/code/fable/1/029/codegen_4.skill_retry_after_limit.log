@@ -0,0 +1,665 @@
+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+SIDES = ("up", "right", "down", "left")
+DIRS = {
+    "up": (-1, 0),
+    "right": (0, 1),
+    "down": (1, 0),
+    "left": (0, -1),
+}
+OPPOSITE = {
+    "up": "down",
+    "right": "left",
+    "down": "up",
+    "left": "right",
+}
+SIDE_FROM_RAY = {
+    "up": "down",
+    "right": "left",
+    "down": "up",
+    "left": "right",
+}
+BASE_CENTERS = [2, 8, 14, 20, 26]
+SIZE_OPTIONS = [3, 5]
+GEN_RETRIES = 400
+_GEN_COUNTER = 0
+
+
+def neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def find_components(
+    grid: np.ndarray,
+    *,
+    bg: int = BLACK,
+    colors: list[int] | None = None,
+) -> list[dict]:
+    """Monochromatic 4-connected components using arc_utils' (r,c) / bbox conventions."""
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    if colors is None:
+        colors = sorted(int(v) for v in np.unique(g) if int(v) != int(bg))
+    out: list[dict] = []
+    for color in colors:
+        seen = np.zeros((h, w), dtype=bool)
+        for r in range(h):
+            for c in range(w):
+                if seen[r, c] or int(g[r, c]) != int(color):
+                    continue
+                q = deque([(r, c)])
+                seen[r, c] = True
+                coords: list[tuple[int, int]] = []
+                while q:
+                    rr, cc = q.popleft()
+                    coords.append((rr, cc))
+                    for nr, nc in neighbors4(rr, cc):
+                        if not in_bounds((h, w), nr, nc):
+                            continue
+                        if seen[nr, nc] or int(g[nr, nc]) != int(color):
+                            continue
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+                arr = np.array(coords, dtype=int)
+                out.append(
+                    {
+                        "color": int(color),
+                        "coords": arr,
+                        "bbox": bbox_coords(arr),
+                        "area": int(arr.shape[0]),
+                    }
+                )
+    return out
+
+
+def _is_hollow_rectangle(grid: np.ndarray, comp: dict) -> bool:
+    coords = comp["coords"]
+    r0, c0, r1, c1 = comp["bbox"]
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3 or h % 2 == 0 or w % 2 == 0:
+        return False
+    expected = set()
+    for rr in range(r0, r1 + 1):
+        expected.add((rr, c0))
+        expected.add((rr, c1))
+    for cc in range(c0, c1 + 1):
+        expected.add((r0, cc))
+        expected.add((r1, cc))
+    actual = {tuple(map(int, p)) for p in coords}
+    if actual != expected:
+        return False
+    return bool(np.all(grid[r0 + 1 : r1, c0 + 1 : c1] == BLACK))
+
+
+def _rect_midpoint(rect: dict, side: str) -> tuple[int, int]:
+    r0, c0, r1, c1 = rect["bbox"]
+    if side == "up":
+        return r0, (c0 + c1) // 2
+    if side == "down":
+        return r1, (c0 + c1) // 2
+    if side == "left":
+        return (r0 + r1) // 2, c0
+    return (r0 + r1) // 2, c1
+
+
+def _first_hit(rects: list[dict], origin: tuple[int, int], ray_side: str) -> int | None:
+    r, c = origin
+    best_idx = None
+    best_dist = None
+    for idx, rect in enumerate(rects):
+        r0, c0, r1, c1 = rect["bbox"]
+        dist = None
+        if ray_side == "right" and r0 <= r <= r1 and c < c0:
+            dist = c0 - c
+        elif ray_side == "left" and r0 <= r <= r1 and c > c1:
+            dist = c - c1
+        elif ray_side == "down" and c0 <= c <= c1 and r < r0:
+            dist = r0 - r
+        elif ray_side == "up" and c0 <= c <= c1 and r > r1:
+            dist = r - r1
