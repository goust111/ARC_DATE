+def _place_seed(
+    root_rect: dict,
+    root_incoming_side: str,
+    h: int,
+    w: int,
+) -> tuple[tuple[int, int], tuple[int, int]] | None:
+    r0, c0, r1, c1 = root_rect["bbox"]
+    rr = (r0 + r1) // 2
+    cc = (c0 + c1) // 2
+    if root_incoming_side == "left":
+        options = []
+        for gap in (3, 2):
+            seed = (rr, c0 - gap)
+            marker = (rr, seed[1] + 1)
+            if 0 <= seed[1] and marker[1] < c0:
+                options.append((seed, marker))
+        return random.choice(options) if options else None
+    if root_incoming_side == "right":
+        options = []
+        for gap in (3, 2):
+            seed = (rr, c1 + gap)
+            marker = (rr, seed[1] - 1)
+            if seed[1] < w and marker[1] > c1:
+                options.append((seed, marker))
+        return random.choice(options) if options else None
+    if root_incoming_side == "up":
+        options = []
+        for gap in (3, 2):
+            seed = (r0 - gap, cc)
+            marker = (seed[0] + 1, cc)
+            if 0 <= seed[0] and marker[0] < r0:
+                options.append((seed, marker))
+        return random.choice(options) if options else None
+    options = []
+    for gap in (3, 2):
+        seed = (r1 + gap, cc)
+        marker = (seed[0] - 1, cc)
+        if seed[0] < h and marker[0] > r1:
+            options.append((seed, marker))
+    return random.choice(options) if options else None
