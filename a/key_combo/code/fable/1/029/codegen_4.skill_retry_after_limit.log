+def _slot_side(src: tuple[int, int], dst: tuple[int, int]) -> str | None:
+    sr, sc = src
+    tr, tc = dst
+    if sr == tr and tc > sc:
+        return "right"
+    if sr == tr and tc < sc:
+        return "left"
+    if sc == tc and tr > sr:
+        return "down"
+    if sc == tc and tr < sr:
+        return "up"
+    return None
