+def _centers_for_limit(limit: int) -> list[int]:
+    max_shift = 1 if limit >= 30 else 0
+    shift = random.randint(0, max_shift)
+    centers = [c + shift for c in BASE_CENTERS if c + shift + 2 < limit]
+    assert len(centers) >= 4
+    return centers
+
