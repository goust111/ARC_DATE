+def _slot_distance(src: tuple[int, int], dst: tuple[int, int], side: str) -> int | None:
+    rel = _slot_side(src, dst)
+    if rel != side:
+        return None
+    sr, sc = src
+    tr, tc = dst
+    return abs(tr - sr) + abs(tc - sc)
