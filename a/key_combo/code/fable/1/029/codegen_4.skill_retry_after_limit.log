def _gen_multi_component_mask(h, w, count, k):
    seed_sets = _gen_seed_sets(h, w, k)
    if not seed_sets:
        return None

    labels = np.full((h, w), -1, dtype=int)
    for i, (r, c) in enumerate(random.choice(seed_sets)):
        labels[r, c] = i

    targets = _gen_split_sizes(count, k)
    sizes = [1] * k

    while sizes != targets:
