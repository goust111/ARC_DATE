+    mr, mc = marker
+    if mr == sr - 1 and mc == sc:
+        seed_ray_side = "up"
+    elif mr == sr + 1 and mc == sc:
+        seed_ray_side = "down"
+    elif mr == sr and mc == sc - 1:
