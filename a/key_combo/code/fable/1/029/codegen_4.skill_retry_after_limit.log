+
+def _free_slots_in_direction(
+    slot: tuple[int, int],
+    side: str,
+    occupied: set[tuple[int, int]],
+    n_rows: int,
+    n_cols: int,
+) -> list[tuple[int, int]]:
+    sr, sc = slot
+    dr, dc = DIRS[side]
+    out = []
+    step = 1
+    while True:
+        rr = sr + dr * step
+        cc = sc + dc * step
+        if not (0 <= rr < n_rows and 0 <= cc < n_cols):
+            break
+        nxt = (rr, cc)
+        if nxt in occupied:
+            break
+        out.append(nxt)
+        step += 1
+    return out
