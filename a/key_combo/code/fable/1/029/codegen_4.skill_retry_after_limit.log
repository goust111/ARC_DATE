+def _candidate_respects_visibility(
+    candidate: tuple[int, int],
+    *,
+    nodes: list[dict],
+    occupied: set[tuple[int, int]],
+    parent_id: int,
+    parent_side: str,
+    root_slot: tuple[int, int],
+    root_incoming_side: str,
+) -> bool:
+    root_seed_side = OPPOSITE[root_incoming_side]
