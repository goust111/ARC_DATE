+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+SIDES = ("up", "right", "down", "left")
+DIRS = {
+    "up": (-1, 0),
+    "right": (0, 1),
+    "down": (1, 0),
+    "left": (0, -1),
+}
+OPPOSITE = {
+    "up": "down",
+    "right": "left",
+    "down": "up",
+    "left": "right",
+}
+SIDE_FROM_RAY = {
+    "up": "down",
+    "right": "left",
+    "down": "up",
+    "left": "right",
+}
+BASE_CENTERS = [2, 8, 14, 20, 26]
+SIZE_OPTIONS = [3, 5]
+GEN_RETRIES = 400
+_GEN_COUNTER = 0
