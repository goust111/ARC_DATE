+def _seed_ray_side(seed: tuple[int, int], marker: tuple[int, int]) -> str:
+    sr, sc = seed
+    mr, mc = marker
+    if mr == sr - 1 and mc == sc:
+        return "up"
+    if mr == sr + 1 and mc == sc:
+        return "down"
+    if mr == sr and mc == sc - 1:
+        return "left"
+    if mr == sr and mc == sc + 1:
+        return "right"
