+
+def _straight_length_ok(length: int, l_length: int, rank: str) -> bool:
+    if not (MIN_STRAIGHT_LEN <= length <= MAX_STRAIGHT_LEN):
+        return False
+    if rank == "short":
+        return length > l_length
