+
+def _render_overlay(grid: np.ndarray, paths: list[dict], *, reverse: bool = False) -> np.ndarray:
+    out = np.asarray(grid, dtype=int).copy()
+    bg = int(get_bg(out))
+    ordered = sorted(paths, key=lambda path: int(path["length"]), reverse=reverse)
+    for path in ordered:
