+def _partition_total(total: int, parts: int, *, min_part: int) -> list[int]:
+    remaining = int(total)
+    out: list[int] = []
+    for idx in range(parts - 1):
+        min_rest = min_part * (parts - idx - 1)
+        piece = random.randint(min_part, remaining - min_rest)
+        out.append(piece)
+        remaining -= piece
+    out.append(remaining)
+    random.shuffle(out)
+    return out
