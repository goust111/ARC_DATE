+def _mode_row(rows: np.ndarray) -> np.ndarray | None:
+    counts = Counter(tuple(map(int, row)) for row in rows)
+    ranked = counts.most_common()
+    if len(ranked) > 1 and ranked[0][1] == ranked[1][1]:
+        return None
+    return np.array(ranked[0][0], dtype=int)
