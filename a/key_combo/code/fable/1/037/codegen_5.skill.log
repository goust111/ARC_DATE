+    target_row = _marker_row(g[:, 0])
+    image = g[:, 1:].copy()
+    _period, defect_row = _find_period_and_defect(image)
+    shift = (target_row - defect_row) % int(image.shape[0])
+    return np.roll(image, shift=shift, axis=0)
