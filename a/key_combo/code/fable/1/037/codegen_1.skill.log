PANEL_CELLS = PANEL_H * PANEL_W
RIGHT_COLORS = (2, 3, 6, 7)

# Mask/component constraints and case mix.
COMPONENT_MIN, COMPONENT_MAX = 1, 2
LEFT_FG_MIN, LEFT_FG_MAX = 7, 12
RIGHT_FG_MIN, RIGHT_FG_MAX = 4, 9
