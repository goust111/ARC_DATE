+    family_info = summary["families"]
+    gap_present_count = len(gap_family["scales"])
+    complete_same_count = [
+        info
+        for key, info in family_info.items()
+        if key != gap_family["family_key"] and info["missing_scale"] is None and len(info["scales"]) == gap_present_count
+    ]
