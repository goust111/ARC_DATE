    if side in GEN_LR_SIDES:
        return random.choice(GEN_LR_FRAME_HEIGHTS), random.randint(*GEN_LR_FRAME_WIDTH_RANGE)
    return random.randint(*GEN_TB_FRAME_HEIGHT_RANGE), random.choice(GEN_TB_FRAME_WIDTHS)


