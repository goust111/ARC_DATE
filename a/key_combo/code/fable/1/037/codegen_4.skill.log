+
+def _valid_reflections(coords: np.ndarray, shape: tuple[int, int]) -> tuple[tuple[int, int], tuple[int, int], list[tuple[tuple[int, int], np.ndarray]]]:
+    row_range, col_range = _axis_ranges(coords, shape)
