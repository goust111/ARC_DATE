+            inp = _paint_scene((height, width), source_coords, sprite_colors, orange_rc, teal_rc)
+            expected = _paint_scene((height, width), target_coords, sprite_colors, orange_rc, teal_rc)
+            if _semantic_ok(inp, expected):
