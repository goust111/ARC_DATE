+    feasible = [
+        pivot
+        for pivot in candidates
+        if _coords_in_bounds(_reflect_coords(sprite_coords, pivot), inp.shape)
+    ]
+    if len(feasible) != 1:
+        return False
+    if np.array_equal(inp, expected):
+        return False
+    return np.array_equal(main(inp), expected)
