+        frontier = sorted(
+            {
+                (nr, nc)
+                for r, c in cells
+                for nr, nc in _neighbors4(r, c)
+                if 0 <= nr < height and 0 <= nc < width and (nr, nc) not in cells
+            }
+        )
+        if not frontier:
+            return None
+        cells.add(random.choice(frontier))
