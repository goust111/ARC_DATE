+
+def _semantic_ok(
+    grid: np.ndarray,
+    expected: np.ndarray,
+    summary: np.ndarray,
+    scale: int,
+    frame_color: int,
+    tie_pos: tuple[int, int],
+    tie_style: str,
+) -> bool:
+    try:
+        parsed = _parse_scene(grid)
+    except Exception:
+        return False
+    if parsed["scale"] != scale:
+        return False
+    if parsed["frame_color"] != frame_color:
+        return False
+    if parsed["tie_pos"] != tie_pos:
+        return False
+    if not np.array_equal(parsed["summary"], summary):
+        return False
+    if not np.array_equal(parsed["output"], expected):
+        return False
+    if tie_style == "pure":
+        area = parsed["block_shape"][0] * parsed["block_shape"][1]
+        if area % 2 != 0:
+            return False
