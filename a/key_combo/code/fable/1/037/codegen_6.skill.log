+def _tie_block_counts(area: int) -> tuple[str, list[int]] | None:
+    options: list[tuple[str, list[int]]] = []
+    if area % 2 == 0:
+        options.append(("pure", [area // 2, area // 2]))
+        if area >= 8:
+            half = area // 2 - 1
+            options.append(("extra", [half, half, 2]))
