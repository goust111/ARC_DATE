+def _make_majority_block(height: int, width: int, majority: int, palette: list[int], force_noise: bool) -> np.ndarray:
+    area = height * width
+    block = np.full((height, width), int(majority), dtype=int)
+    max_noise = (area - 1) // 2
+    if max_noise <= 0:
