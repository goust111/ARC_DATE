+        color_pool,
+        tie_pos,
+    )
+    inner_h = rows * scale
+    inner_w = cols * scale
+    frame = _make_frame(inner_h, inner_w, frame_color)
+    scene = _compose_scene(lattice, frame)
+    if scene is None:
+        return None
+
+    expected = _scale_sprite(summary, scale)
+    if not _semantic_ok(scene, expected, summary, scale, frame_color, tie_pos, tie_style):
+        return None
+    return scene
