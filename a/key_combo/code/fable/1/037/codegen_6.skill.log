+
+def _make_frame(inner_h: int, inner_w: int, color: int) -> np.ndarray:
+    frame = np.full((inner_h + 2, inner_w + 2), BG, dtype=int)
+    frame[0, :] = int(color)
+    frame[-1, :] = int(color)
