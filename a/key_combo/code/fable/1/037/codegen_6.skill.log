    marker_colors = colors[:n_clusters]
    extra_center_color = colors[-1]
    target_idx = random.randrange(n_clusters)
    extra_idx = random.choice([idx for idx in range(n_clusters) if idx != target_idx])

    patches = []
    expected = None

