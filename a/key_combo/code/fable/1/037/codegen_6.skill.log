+    height, width = patch.shape
+    color = int(comp["color"])
+    if height < 3 or width < 3:
+        return False
+    if int(comp["area"]) != 2 * height + 2 * width - 4:
+        return False
+    if not np.all(patch[0, :] == color):
+        return False
+    if not np.all(patch[-1, :] == color):
+        return False
+    if not np.all(patch[:, 0] == color):
