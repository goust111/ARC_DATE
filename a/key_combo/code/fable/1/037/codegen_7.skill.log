+            sr_a = int(src["sum_r"])
+            sc_a = int(src["sum_c"])
+            sr_b = int(dst["sum_r"])
+            sc_b = int(dst["sum_c"])
+
+            numerators = (
+                (sr_a + sr_b + sc_b - sc_a, sr_a - sr_b + sc_a + sc_b),
+                (sr_a + sr_b, sc_a + sc_b),
+                (sr_a + sr_b + sc_a - sc_b, -sr_a + sr_b + sc_a + sc_b),
+            )
+            for num_r, num_c in numerators:
+                if num_r % area == 0 and num_c % area == 0:
+                    center2 = (num_r // area, num_c // area)
+                    if center2[0] % 2 == center2[1] % 2:
