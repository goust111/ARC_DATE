+                if len(fragment_idxs) != 1:
+                    continue
+                fragment_idx = fragment_idxs[0]
+                if ref_idx == fragment_idx:
+                    continue
+
+                start = cycle_index[ref["color"]]
+                if any(
+                    components[idx]["color"] != SECTOR_COLOR_CYCLE[(start + step) % len(SECTOR_COLOR_CYCLE)]
+                    for idx, step in used.items()
+                ):
+                    continue
+
