+def _rotate_coords(coords: np.ndarray, center2: tuple[int, int], steps: int, shape: tuple[int, int]) -> np.ndarray | None:
+    rr2 = 2 * coords[:, 0] - int(center2[0])
+    cc2 = 2 * coords[:, 1] - int(center2[1])
