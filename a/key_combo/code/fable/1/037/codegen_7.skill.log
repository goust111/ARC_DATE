+def generate_input() -> np.ndarray:
+    global _GEN_COUNTER
+
+    branch = _GEN_COUNTER
+    _GEN_COUNTER += 1
+    for _ in range(MAX_GEN_ATTEMPTS):
+        grid = _gen_attempt(branch)
+        if grid is not None:
