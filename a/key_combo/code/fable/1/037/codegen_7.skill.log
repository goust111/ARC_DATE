+def _base_offsets2(mask: np.ndarray, parity: int) -> np.ndarray:
+    coords = np.argwhere(mask)
+    r_steps = 2 * (coords[:, 0] + 1) + int(parity)
+    c_steps = 2 * (coords[:, 1] + 1) + int(parity)
+    return np.stack([-r_steps, c_steps], axis=1)
