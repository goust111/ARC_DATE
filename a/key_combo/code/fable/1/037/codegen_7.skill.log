+    out = g.copy()
+    fragment_coords = components[fragment_idx]["coords"]
+    out[fragment_coords[:, 0], fragment_coords[:, 1]] = bg
+    out[hole_coords[:, 0], hole_coords[:, 1]] = int(hole_color)
