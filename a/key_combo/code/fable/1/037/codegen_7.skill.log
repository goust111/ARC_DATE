+import numpy as np
+
+
+BACKGROUND = 0
+SECTOR_COLOR_CYCLE = (1, 2, 3, 4)
+FRAGMENT_COLORS = (5, 6, 7, 8, 9)
+NEIGHBORS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+MAX_GEN_ATTEMPTS = 300
+GEN_MARGIN = 1
+GEN_GAP = 2
+_GEN_COUNTER = 0
