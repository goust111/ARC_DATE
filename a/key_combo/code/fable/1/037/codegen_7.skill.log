+                    "coords": coords,
+                    "bbox": _bbox_coords(coords),
+                    "area": int(coords.shape[0]),
+                    "sum_r": int(coords[:, 0].sum()),
+                    "sum_c": int(coords[:, 1].sum()),
+                    "mask": _coords_to_mask(coords),
+                }
+            )
+    return components
+
+
