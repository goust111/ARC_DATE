+    if not frag_positions:
+        return None
+    fragment_top, fragment_left = random.choice(frag_positions)
+
+    shift_r = main_top - sample_r0
+    shift_c = main_left - sample_c0
+    center2 = (sample_center2[0] + 2 * shift_r, sample_center2[1] + 2 * shift_c)
