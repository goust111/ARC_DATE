    for rr, cc, color in _gen_stamp_targets(exemplar, offsets, n):
        output_cells[rr, cc] = color
        input_nonbg.add((rr, cc))
        stamp_cells.add((rr, cc))
    return output_cells, input_nonbg, stamp_cells


