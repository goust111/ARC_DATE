+    return {
+        "shape": (h, w),
+        "bg": int(bg),
+        "seed_color": int(seed_color),
+        "wall_color": int(wall_color),
+        "orientation": orientation,
+        "wall_positions": [int(v) for v in wall_positions],
+        "door_centers": [int(v) for v in door_centers],
+        "door_colors": [int(v) for v in door_colors],
+        "seeds": seed_coords,
+    }
