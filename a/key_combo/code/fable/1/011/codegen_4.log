+        if inner_w != kw or inner_h <= kh:
+            return None
+        return 1, 1
+    if side == "D":
+        if inner_w != kw or inner_h <= kh:
+            return None
+        return fh - 1 - kh, 1
+    if side == "L":
+        if inner_h != kh or inner_w <= kw:
+            return None
+        return 1, 1
+    if side == "R":
