+    comps = _find_components(inp, bg)
+    frames = []
+    keys = []
+    for comp in comps:
+        crop = _crop_bbox(inp, comp["bbox"])
+        mask = crop == int(comp["color"])
+        item = {"bbox": comp["bbox"], "mask": mask.astype(bool)}
+        if _is_frame_component(mask):
