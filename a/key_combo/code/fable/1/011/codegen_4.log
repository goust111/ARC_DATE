    rows = random.randint(*GRID_ROWS)
    cols = random.randint(*GRID_COLS)
    bg = random.choice(BACKGROUND_COLORS)
    h_count, v_count, d_count = _gen_counts()

    objects = _gen_objects(h_count, v_count, d_count)
    if objects is None:
