+    frames: list[dict] = []
+    keys: list[dict] = []
+    for comp in comps:
+        bbox = comp["bbox"]
+        crop = _crop_bbox(g, bbox)
+        mask = crop == int(comp["color"])
+        item = {
+            "color": int(comp["color"]),
+            "bbox": bbox,
