        _gen_place_patch(out, mask, r0, c0, OUTPUT_COLOR_BY_KIND[kind], bg)
        placed_parts.append(np.argwhere(mask) + np.array([r0, c0]))
    return np.concatenate(placed_parts, axis=0)


