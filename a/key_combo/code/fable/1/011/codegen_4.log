+                    if rel is None:
+                        continue
+                    abs_r = int(frame["bbox"][0] + rel[0])
+                    abs_c = int(frame["bbox"][1] + rel[1])
+                    sig = (frame_idx, side, abs_r, abs_c, rot_mask.shape, rot_mask.tobytes())
+                    if sig in found:
