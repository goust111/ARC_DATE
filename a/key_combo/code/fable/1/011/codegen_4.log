+    cands = _enumerate_candidates(frames, keys)
+    if any(len(lst) != 1 for lst in cands):
+        return None
+    if _solve_assignment(cands, len(frames)) is None:
+        return None
+
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(400):
+        grid = _gen_attempt(rng)
+        if grid is not None:
