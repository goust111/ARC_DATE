+def _sample_counts(capacities: list[int], rng: random.Random) -> list[int] | None:
+    sink_cap = int(capacities[-1])
+    sink_width = int(capacities[-1] // max(1, capacities[-1] // capacities[-1]))
+    del sink_width
+    for _ in range(COUNT_RETRIES):
+        counts = []
+        for i, cap in enumerate(capacities):
+            upper = min(int(cap), 7 if i == len(capacities) - 1 else 6)
+            counts.append(rng.randint(2, upper))
+        total = sum(counts)
+        sink_inner_w = int(round(np.sqrt(capacities[-1])))
+        min_total = max(6, sink_inner_w + 1)
