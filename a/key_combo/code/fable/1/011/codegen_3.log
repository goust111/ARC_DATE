+            return None
+    else:
+        if base[1] != c1 or spike[1] != c1 + 1 or spike[0] != base[0] or base[0] in (r0, r1):
+            return None
+
+    bbox = (int(r0), int(c0), int(r1), int(c1))
+    interior = _interior_cells(bbox)
+    inner_colors = {
+        int(grid[r, c])
+        for r, c in interior
