+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+DIRS = {
+    "U": (-1, 0),
+    "D": (1, 0),
+    "L": (0, -1),
+    "R": (0, 1),
+}
+DIR_FROM_DELTA = {delta: name for name, delta in DIRS.items()}
+
+BG = 0
+CELL = 9
+GRID_SHAPES = [(2, 2), (2, 3), (3, 2), (3, 3)]
+JAR_SIZE_CHOICES = [(5, 5), (5, 7), (7, 5), (7, 7)]
+SINK_SIZE_CHOICES = [(7, 7), (7, 7), (7, 5), (5, 7), (5, 5)]
+MAX_JARS = 4
+MAX_GENERATION_ATTEMPTS = 400
+COUNT_RETRIES = 200
+PATH_RETRIES = 80
+
+
+def get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[int(np.argmax(counts))])
+
+
+def in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= int(r) < int(h) and 0 <= int(c) < int(w)
+
+
+def neighbors4(r: int, c: int):
+    yield int(r) - 1, int(c)
+    yield int(r) + 1, int(c)
+    yield int(r), int(c) - 1
+    yield int(r), int(c) + 1
+
+
+def bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def components_mask(mask: np.ndarray, connectivity: int = 4) -> list[np.ndarray]:
+    assert int(connectivity) == 4
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            seen[r, c] = True
+            stack = [(int(r), int(c))]
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((int(rr), int(cc)))
+                for nr, nc in neighbors4(rr, cc):
+                    if in_bounds(mask.shape, nr, nc) and bool(mask[nr, nc]) and not bool(seen[nr, nc]):
