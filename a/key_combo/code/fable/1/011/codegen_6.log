+    cells = {start}
+    frontier: set[tuple[int, int]] = set(_neighbors4(*start, height, width))
+
+    while len(cells) < target:
+        if not frontier:
+            return None
+
+        ranked = sorted(
+            frontier,
+            key=lambda rc: sum(nb in cells for nb in _neighbors4(rc[0], rc[1], height, width)),
+            reverse=True,
+        )
