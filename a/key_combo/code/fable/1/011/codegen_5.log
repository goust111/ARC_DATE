+    cols = sorted(set(int(c) for c in coords[:, 1]))
+    if stripe["orient"] == "H":
+        return len(rows) in (1, 2) and int(coords[:, 1].max() - coords[:, 1].min() + 1) >= 3
+    return len(cols) in (1, 2) and int(coords[:, 0].max() - coords[:, 0].min() + 1) >= 3
+
