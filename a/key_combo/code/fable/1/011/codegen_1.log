+def _is_valid_jump(dr: int, dc: int) -> bool:
+    dr = int(dr)
+    dc = int(dc)
+    if dr == 0 and dc == 0:
+        return False
+    if dr == 0 or dc == 0:
+        return min(abs(dr), abs(dc)) == 0 and max(abs(dr), abs(dc)) in (1, 2)
+    return abs(dr) == abs(dc) and abs(dr) in (1, 2)
