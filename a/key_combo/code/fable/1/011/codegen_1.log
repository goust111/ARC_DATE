+def _search_path(
+    rows: int, cols: int, length: int, rng: random.Random
+) -> tuple[list[tuple[int, int]], list[tuple[int, int]], set[tuple[int, int]]] | None:
+    required = {"step1", "step2", "diagonal", "cardinal"}
