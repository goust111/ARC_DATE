+def _move_flags(jump: tuple[int, int]) -> set[str]:
+    dr, dc = map(int, jump)
+    step2 = max(abs(dr), abs(dc)) == 2
+    diagonal = dr != 0 and dc != 0
+    flags = {"step2" if step2 else "step1"}
+    flags.add("diagonal" if diagonal else "cardinal")
+    return flags
