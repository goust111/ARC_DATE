+    out = []
+    if r > 0:
+        out.append((r - 1, c))
+    if r + 1 < rows:
+        out.append((r + 1, c))
+    if c > 0:
+        out.append((r, c - 1))
+    if c + 1 < cols:
+        out.append((r, c + 1))
+    return out
