+        for coords in components_mask(grid == color):
+            if coords.size == 0:
+                continue
+            r0, c0, r1, c1 = bbox_coords(coords)
+            side_h = r1 - r0 + 1
+            side_w = c1 - c0 + 1
+            if side_h < 2 or side_h != side_w:
+                continue
+            if int(coords.shape[0]) != side_h * side_w:
+                continue
+            squares.append(
+                {
+                    "color": int(color),
+                    "bbox": (r0, c0, r1, c1),
+                    "side": int(side_h),
+                    "coords": {(int(r), int(c)) for r, c in coords},
+                }
+            )
