+        required.append(non_gray & (depth == 2))
+        required.append(non_gray & (depth == 3))
+        required.append(_strict_interior_mask(grid.shape, broken_specs[0]) & non_gray & (depth == 0))
+        required.append(non_gray & (depth == 0))
