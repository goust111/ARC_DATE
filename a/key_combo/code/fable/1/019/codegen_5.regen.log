+
+
+def _red_can_fit(red_mask: np.ndarray, r: int, c: int) -> bool:
+    h, w = red_mask.shape
+    for nr in range(max(0, r - 1), min(h, r + 2)):
+        for nc in range(max(0, c - 1), min(w, c + 2)):
+            if red_mask[nr, nc]:
