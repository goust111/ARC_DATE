            area = rh * cw
            if area > max_area:
                continue
            for r0 in range(0, h - rh + 1):
                r1 = r0 + rh
                for c0 in range(0, w - cw + 1):
                    c1 = c0 + cw
                    if blocked[r0:r1, c0:c1].any() or marker_mask[r0:r1, c0:c1].any():
                        continue
                    touched = bool(touch_mask[r0:r1, c0:c1].any())
                    if touched == want_touched:
