def _gen_min_period_area(tile: np.ndarray) -> int:
    h, w = tile.shape
    areas = []
    for rh in range(1, h + 1):
        for cw in range(1, w + 1):
            ok = True
            for r in range(h):
                for c in range(w):
                    if tile[r, c] != tile[r % rh, c % cw]:
                        ok = False
                        break
                if not ok:
                    break
            if ok:
                areas.append(rh * cw)
    return min(areas)


def _gen_tile_from_coords(
    majority: int,
    minority: int,
    size: int,
    minority_coords: tuple[tuple[int, int], ...],
) -> np.ndarray:
