+    return r0 + dr * steps, c0 + dc * steps, r1 + dr * steps, c1 + dc * steps
+
+
+def _strictly_inside(bbox: tuple[int, int, int, int], coord: tuple[int, int]) -> bool:
+    r0, c0, r1, c1 = bbox
