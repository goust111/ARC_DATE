+    return coords
+
+
+def _capture_local_coords(inner_h: int, inner_w: int, count: int) -> list[tuple[int, int]]:
+    if count == 0:
+        return []
+    candidates = [(r, c) for r in range(inner_h) for c in range(inner_w) if (r + c) % 2 == 0]
+    random.shuffle(candidates)
