+        for pix in box["cargo_pixels"]:
+            r, c = pix["coord"]
+            grid[r, c] = int(pix["color"])
+        for pix in box["captured_loose"]:
+            r, c = pix["coord"]
+            grid[r, c] = int(pix["color"])
