+            r, c = pix["coord"]
+            out[r, c] = int(box["color"])
+    return out
+
+
+def _free_loose_cells(h: int, w: int, boxes: list[dict]) -> list[tuple[int, int]]:
+    blocked = np.zeros((h, w), dtype=bool)
+    for box in boxes:
+        r0, c0, r1, c1 = box["reserve_bbox"]
+        blocked[r0 : r1 + 1, c0 : c1 + 1] = True
