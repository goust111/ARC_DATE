+    for box in boxes:
+        for r, c in _perimeter_coords(box["old_bbox"]):
+            out[r, c] = BACKGROUND
+    for box in boxes:
+        for r, c in _perimeter_coords(box["new_bbox"]):
+            out[r, c] = int(box["color"])
+        for pix in box["captured_loose"]:
+            r, c = pix["coord"]
+            out[r, c] = int(box["color"])
