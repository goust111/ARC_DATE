+    by_color = {box["color"]: box for box in boxes}
+    for parsed in parsed_boxes:
+        spec = by_color[int(parsed["color"])]
+        assert parsed["bbox"] == spec["old_bbox"]
+        assert parsed["new_bbox"] == spec["new_bbox"]
