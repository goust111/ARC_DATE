+def _sample_box_shape(direction: str) -> dict:
+    if direction in ("L", "R"):
+        inner_h = 5
+        inner_w = random.choice((3, 5))
+        step = inner_w + 2 + random.randint(0, 1)
+    else:
+        inner_h = random.choice((3, 5))
+        inner_w = 5
+        step = inner_h + 2 + random.randint(0, 1)
