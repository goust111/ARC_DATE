+        return False
+    coords = np.argwhere(mask)
+    for r, c in coords:
+        r0 = max(0, int(r) - 1)
+        r1 = min(band.shape[0], int(r) + 2)
+        c0 = max(0, int(c) - 1)
+        c1 = min(band.shape[1], int(c) + 2)
+        if int(np.count_nonzero(mask[r0:r1, c0:c1])) != 1:
+            return False
+    return True
