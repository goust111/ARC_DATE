+    if any(len(cell) != 1 for row in residue_sets for cell in row):
+        return None
+
+    tile = np.empty((pr, pc), dtype=int)
+    for r in range(pr):
+        for c in range(pc):
+            tile[r, c] = next(iter(residue_sets[r][c]))
