+    pr2 = _complete_axis_period(tile, axis=0)
+    pc2 = _complete_axis_period(tile, axis=1)
+    tile = tile[:pr2, :pc2]
+    if len(set(map(int, tile.flat))) != 2:
+        return None
+
+    expected = _tile_fill(block.shape, tile)
+    visible = block != BLACK
+    if np.any(block[visible] != expected[visible]):
+        return None
+    return tile
+
