+        and mask[r1, c0 : c1 + 1].any()
+        and mask[r0 : r1 + 1, c0].any()
+        and mask[r0 : r1 + 1, c1].any()
+    )
+
+
+def _make_rect_dicts(bboxes: list[tuple[int, int, int, int]], colors: list[int], shape: tuple[int, int]) -> list[dict]:
