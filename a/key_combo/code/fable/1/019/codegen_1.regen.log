+) -> list[tuple[int, int, int, int]]:
+    return [(r0 + dr, c0 + dc, r1 + dr, c1 + dc) for r0, c0, r1, c1 in bboxes]
+
+
+def _pad_bbox(
+    bbox: tuple[int, int, int, int], pad: int, shape: tuple[int, int]
+) -> tuple[int, int, int, int]:
