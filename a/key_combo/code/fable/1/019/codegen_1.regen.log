+        return None
+    for _ in range(PLACEMENT_ATTEMPTS):
+        dr = rng.randint(0, h - patch_h)
+        dc = rng.randint(0, w - patch_w)
+        placed = _translate_bboxes(local_bboxes, dr, dc)
+        union = _bbox_union(placed)
