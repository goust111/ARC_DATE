    tied: list[tuple[int, int]] = []
    unique: list[tuple[int, int]] = []
    for r in range(n):
        for c in range(n):
            distances = [r, c, n - 1 - r, n - 1 - c]
            if distances.count(min(distances)) == 1:
                unique.append((r, c))
            else:
                tied.append((r, c))
    return tied, unique


