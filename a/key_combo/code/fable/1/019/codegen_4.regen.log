GEN_MAX_ATTEMPTS = 300


def _gen_edge_tags(r: int, c: int, n: int) -> set[str]:
    tags: set[str] = set()
    if r == 0:
        tags.add("top")
    if r == n - 1:
        tags.add("bottom")
    if c == 0:
        tags.add("left")
    if c == n - 1:
