+def _rect_mask(shape: tuple[int, int], rect: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, rh, cw = rect
+    mask = np.zeros(shape, dtype=bool)
+    mask[r0 : r0 + rh, c0 : c0 + cw] = True
+    return mask
