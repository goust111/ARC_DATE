+
+
+def _paint_rect(grid: np.ndarray, rect: tuple[int, int, int, int], color: int) -> None:
+    r0, c0, rh, cw = rect
+    grid[r0 : r0 + rh, c0 : c0 + cw] = int(color)
+
+
+def _choose_horizontal_target(
+    shape: tuple[int, int],
+    blocked: np.ndarray,
+    beam_row: int,
+    c_lo: int,
+    c_hi: int,
+    r_lo: int = 1,
+    r_hi: int | None = None,
+) -> tuple[int, int, int, int] | None:
+    h, w = shape
+    if r_hi is None:
+        r_hi = h - 2
+    candidates = []
+    for rh in range(2, 5):
+        row_low = max(r_lo, beam_row - rh + 1)
+        row_high = min(r_hi, beam_row, h - rh - 1)
+        if row_low > row_high:
+            continue
+        for cw in range(2, 5):
+            col_high = min(c_hi, w - cw - 1)
+            if c_lo > col_high:
+                continue
