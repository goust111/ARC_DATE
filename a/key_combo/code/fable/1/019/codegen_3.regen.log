+from __future__ import annotations
+
+import random
+from collections import defaultdict
+
+import numpy as np
+
+
+BG = 0
+ARROW_TAIL = 5
+RAY = 8
+PALETTE = (1, 2, 3, 4, 6, 7, 9)
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+MAX_GENERATION_ATTEMPTS = 400
