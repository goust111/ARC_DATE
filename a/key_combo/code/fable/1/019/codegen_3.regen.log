+
+    grid = _empty_grid(h, w)
+    grid[r0, head_c - 1] = ARROW_TAIL
+    grid[r0, head_c] = RAY
+    grid[r0, w - 1] = portal_colors[0]
+    grid[0, exit_col] = portal_colors[0]
+    grid[h - 1, exit_col] = portal_colors[1]
+    grid[final_row, 0] = portal_colors[1]
