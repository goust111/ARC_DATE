    candidates = []
    for rh in range(2, 5):
        row_high = min(r_hi, h - rh - 1)
        if r_lo > row_high:
            continue
        for cw in range(2, 5):
            col_low = max(c_lo, beam_col - cw + 1)
            col_high = min(c_hi, beam_col, w - cw - 1)
