+
+def _build_single_turn(end_kind: str) -> tuple[np.ndarray, dict] | None:
+    h = random.randint(16, 24)
+    w = random.randint(16, 24)
+    r0 = random.randint(5, h - 7)
+    head_c = random.randint(5, max(5, w // 2))
