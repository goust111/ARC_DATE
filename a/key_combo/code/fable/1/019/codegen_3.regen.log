+    path_mask[r0, head_c + 1 : w - 1] = True
+    path_mask[1 : h - 1, exit_col] = True
+    occupied = grid != BG
+    blocked = occupied | path_mask
+    target = _choose_horizontal_target(
+        (h, w),
+        blocked,
+        final_row,
+        c_lo=2,
+        c_hi=exit_col - 3,
