+    out = g.copy()
+    for r, c in trace["path"]:
+        out[r, c] = RAY
+    if trace["termination"] == "block":
+        coords = trace["blocks"][trace["component"]]["coords"]
+        out[coords[:, 0], coords[:, 1]] = RAY
+    return out
