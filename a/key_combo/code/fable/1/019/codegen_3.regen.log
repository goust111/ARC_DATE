+
+def _place_extra_blocks(
+    grid: np.ndarray,
+    base_forbidden: np.ndarray,
+    colors: list[int],
+) -> bool:
+    forbidden = base_forbidden.copy()
+    h, w = grid.shape
+    for color in colors:
+        candidates = []
+        for rh in range(2, 5):
+            for cw in range(2, 5):
+                for r0 in range(1, h - rh):
+                    for c0 in range(1, w - cw):
+                        if forbidden[r0 : r0 + rh, c0 : c0 + cw].any():
+                            continue
+                        candidates.append((r0, c0, rh, cw))
