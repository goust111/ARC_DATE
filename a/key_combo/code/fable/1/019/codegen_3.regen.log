+
+def _choose_vertical_target(
+    shape: tuple[int, int],
+    blocked: np.ndarray,
+    beam_col: int,
+    r_lo: int,
+    r_hi: int,
+    c_lo: int = 1,
+    c_hi: int | None = None,
