+from __future__ import annotations
+
+import random
+from collections import defaultdict
+
+import numpy as np
+
+
+BG = 0
+ARROW_TAIL = 5
+RAY = 8
+PALETTE = (1, 2, 3, 4, 6, 7, 9)
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+MAX_GENERATION_ATTEMPTS = 400
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _components(grid: np.ndarray, valid_mask: np.ndarray) -> tuple[list[dict], np.ndarray]:
+    h, w = grid.shape
+    visited = np.zeros((h, w), dtype=bool)
+    comp_grid = np.full((h, w), -1, dtype=int)
+    comps: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not valid_mask[r, c] or visited[r, c]:
+                continue
+            color = int(grid[r, c])
+            stack = [(r, c)]
+            visited[r, c] = True
+            coords: list[tuple[int, int]] = []
+            comp_id = len(comps)
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                comp_grid[rr, cc] = comp_id
+                for nr, nc in _neighbors4(rr, cc):
+                    if (
+                        _in_bounds(grid.shape, nr, nc)
+                        and valid_mask[nr, nc]
+                        and not visited[nr, nc]
+                        and int(grid[nr, nc]) == color
+                    ):
+                        visited[nr, nc] = True
+                        stack.append((nr, nc))
+            arr = np.array(coords, dtype=int)
+            comps.append(
+                {
+                    "color": color,
+                    "coords": arr,
+                    "bbox": _bbox(arr),
+                    "area": int(arr.shape[0]),
+                }
+            )
+    return comps, comp_grid
+
+
+def _border_side(shape: tuple[int, int], cell: tuple[int, int]) -> str:
+    h, w = shape
+    r, c = cell
+    if r == 0:
+        return "top"
+    if r == h - 1:
+        return "bottom"
+    if c == 0:
+        return "left"
+    if c == w - 1:
+        return "right"
+    raise AssertionError("portal must lie on the border")
+
+
+def _inward_normal(shape: tuple[int, int], cell: tuple[int, int]) -> tuple[int, int]:
+    side = _border_side(shape, cell)
+    if side == "top":
+        return 1, 0
+    if side == "bottom":
+        return -1, 0
+    if side == "left":
+        return 0, 1
+    return 0, -1
+
+
+def _parse_portals(grid: np.ndarray) -> dict[tuple[int, int], dict]:
+    h, w = grid.shape
+    colors: dict[int, list[tuple[int, int]]] = defaultdict(list)
+    for r in range(h):
+        for c in range(w):
+            if r not in (0, h - 1) and c not in (0, w - 1):
+                continue
