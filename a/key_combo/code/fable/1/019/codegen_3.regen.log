+        if target is None:
+            return None
+        _paint_rect(grid, target, block_colors[0])
+        path_mask[rows[-1], 1 : target[1]] = True
+        extra_colors = block_colors[1:]
+    else:
+        path_mask[rows[-1], 1:w] = True
+        extra_colors = block_colors
