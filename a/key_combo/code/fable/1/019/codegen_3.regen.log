+    path_mask[rows[0], head_c + 1 : w - 1] = True
+    for row in rows[1:-1]:
+        path_mask[row, 1 : w - 1] = True
+
+    occupied = grid != BG
+    if end_kind == "block":
+        blocked = occupied | path_mask
+        target = _choose_horizontal_target(
+            (h, w),
+            blocked,
+            rows[-1],
+            c_lo=4,
+            c_hi=w - 5,
