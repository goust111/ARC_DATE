+    grid = _empty_grid(h, w)
+    grid[r0, head_c - 1] = ARROW_TAIL
+    grid[r0, head_c] = RAY
+    grid[r0, w - 1] = color
+    grid[0, exit_col] = color
+
+    path_mask = np.zeros((h, w), dtype=bool)
+    path_mask[r0, head_c + 1 : w - 1] = True
