+        if len(colored) < 2:
+            continue
+        if np.array_equal(sprite, np.fliplr(sprite)):
+            continue
+        if np.array_equal(sprite, np.flipud(sprite)):
+            continue
+        if np.array_equal(sprite, np.rot90(sprite, 2)):
+            continue
+        return sprite
