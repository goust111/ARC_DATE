+    for _ in range(200):
+        palette_size = random.randint(2, min(4, len(SPRITE_COLOR_POOL)))
+        palette = random.sample(SPRITE_COLOR_POOL, palette_size)
+        sprite = np.full((h, w), bg, dtype=int)
+        for r, c in cells:
+            sprite[r, c] = int(random.choice(palette))
