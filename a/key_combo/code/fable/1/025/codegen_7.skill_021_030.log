+    for r, c in removable:
+        if budget == 0:
+            break
+        trial = mask.copy()
+        trial[r, c] = False
+        if _connected_mask(trial) and np.all(trial.any(axis=0)) and np.all(trial.any(axis=1)):
+            mask = trial
+            budget -= 1
+    return mask
+
