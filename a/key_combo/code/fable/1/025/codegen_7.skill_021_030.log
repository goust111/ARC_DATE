+
+
+def _random_sprite_mask(h: int, w: int) -> np.ndarray:
+    mask = np.ones((h, w), dtype=bool)
+    removable = [
+        (0, 0),
+        (0, w - 1),
+        (h - 1, 0),
+        (h - 1, w - 1),
+        (0, 1),
+        (1, 0),
+        (h - 1, w - 2),
+        (h - 2, w - 1),
+    ]
+    random.shuffle(removable)
