+        seen = np.zeros_like(m, dtype=bool)
+        out: list[np.ndarray] = []
+        h, w = m.shape
+        for r in range(h):
+            for c in range(w):
+                if not m[r, c] or seen[r, c]:
+                    continue
+                stack = [(r, c)]
+                seen[r, c] = True
+                coords = []
+                while stack:
+                    rr, cc = stack.pop()
+                    coords.append((rr, cc))
+                    for nr, nc in neighbors4(rr, cc):
