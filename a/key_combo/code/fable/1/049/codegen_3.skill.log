+    lo, hi = sorted(map(int, marker_pair))
+    k = int(hi - lo)
+    assert k >= 1
+
+    keep: set[int] = set()
+    aligned = (int(wall_idx - lo) % k) == 0
+    for idx in range(path_len):
+        if (int(idx - lo) % k) != 0:
+            continue
+        if aligned:
+            if wall_idx < lo and idx <= wall_idx:
