+def _path_degrees(mask: np.ndarray, coords: np.ndarray) -> dict[Coord, int]:
+    degrees: dict[Coord, int] = {}
+    for r, c in coords:
+        rr = int(r)
+        cc = int(c)
+        deg = 0
+        for nr, nc in neighbors4(rr, cc):
+            if 0 <= nr < mask.shape[0] and 0 <= nc < mask.shape[1] and bool(mask[nr, nc]):
