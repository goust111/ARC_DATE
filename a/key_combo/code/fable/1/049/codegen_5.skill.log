+    _frame_color, squares = _detect_squares(g)
+    ordered = _annotate_squares(g, squares)
+
+    out = g.copy()
+    for idx in range(len(ordered) - 1):
+        first = ordered[idx]
+        second = ordered[idx + 1]
+        _draw_bridge(out, first, second, int(first["fill"]))
+    return out
