+def _frame_from_component(grid: np.ndarray, frame_color: int, coords: np.ndarray):
+    r0, c0, r1, c1 = bbox_coords(coords)
+    side_h = int(r1 - r0 + 1)
+    side_w = int(c1 - c0 + 1)
+    if side_h != side_w or side_h < 5:
+        return None
