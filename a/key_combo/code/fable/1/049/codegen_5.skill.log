+    box = grid[r0 : r1 + 1, c0 : c1 + 1]
+    if not np.all(box[0, :] == frame_color):
+        return None
+    if not np.all(box[-1, :] == frame_color):
+        return None
+    if not np.all(box[:, 0] == frame_color):
+        return None
+    if not np.all(box[:, -1] == frame_color):
+        return None
+    if np.any(box[1:-1, 1:-1] == frame_color):
+        return None
+
+    return {
+        "bbox": (r0, c0, r1, c1),
+        "inner_bbox": (r0 + 1, c0 + 1, r1 - 1, c1 - 1),
+        "side": side_h,
