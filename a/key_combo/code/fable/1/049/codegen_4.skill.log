+    def dfs(pos: int) -> bool:
+        if pos == len(order):
+            return True
+        idx = order[pos]
+        choices = options_by_idx[idx][:]
+        random.shuffle(choices)
+        for marker_count in choices:
+            if marker_count in used:
+                continue
+            used.add(marker_count)
+            assign[idx] = marker_count
+            if dfs(pos + 1):
