+def _trace_paints(
+    shape: tuple[int, int],
+    rect: dict,
+    wall_cells: set[tuple[int, int]],
+) -> tuple[list[tuple[int, int]], str]:
+    r, c = rect["gap"]
+    dr, dc = rect["direction"]
+    step = 0
+    dots: list[tuple[int, int]] = []
+    while True:
+        r += dr
+        c += dc
+        if not _in_bounds(shape, r, c):
+            return dots, "edge"
+        if (r, c) in wall_cells:
+            return dots, "wall"
+        step += 1
+        if step % int(rect["marker_count"]) == 0:
