+def _analyze_rectangles(grid: np.ndarray) -> tuple[int, list[dict], set[tuple[int, int]]]:
+    g = np.asarray(grid, dtype=int)
+    bg = _get_bg(g)
+    colors = sorted(int(c) for c in np.unique(g) if int(c) not in {bg, MARKER_COLOR})
+    rectangles: list[dict] = []
