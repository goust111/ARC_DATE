+            overlap_positions = [c for c in overlap_positions if rects[source_idx]["bbox"][0] < rects[target_idx]["bbox"][0]]
+        else:
+            overlap_positions = [c for c in overlap_positions if rects[source_idx]["bbox"][0] > rects[target_idx]["bbox"][0]]
