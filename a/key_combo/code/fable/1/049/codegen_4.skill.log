+    grid[gr, gc] = int(rect["bg"])
+
+
+def _all_wall_cells(rects: list[dict]) -> set[tuple[int, int]]:
+    cells: set[tuple[int, int]] = set()
+    for rect in rects:
+        r0, c0, r1, c1 = rect["bbox"]
+        cells.update(_border_cells(r0, c0, r1, c1))
+        cells.remove(rect["gap"])
+    return cells
