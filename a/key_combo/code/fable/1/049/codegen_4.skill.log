+                "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                "gap": (int(gap[0]), int(gap[1])),
+                "direction": direction,
+                "marker_count": marker_count,
+            }
+        )
+        wall_cells.update(coords_set)
