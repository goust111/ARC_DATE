+
+def _trace_bbox_line(
+    shape: tuple[int, int],
+    gap: tuple[int, int],
+    direction: tuple[int, int],
+    bboxes: list[tuple[int, int, int, int]],
+    source_idx: int,
+) -> tuple[int, int | None]:
+    dr, dc = direction
+    r, c = gap
+    steps = 0
+    while True:
+        r += dr
+        c += dc
+        if not _in_bounds(shape, r, c):
+            return steps, None
+        for idx, bbox in enumerate(bboxes):
+            if idx == source_idx:
+                continue
+            if _bbox_contains(bbox, (r, c)):
+                return steps, idx
+        steps += 1
