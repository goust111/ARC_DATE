+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+MARKER_COLOR = 5
+MIN_RECTS = 3
+MAX_RECTS = 4
+MIN_SIDE = 5
+MAX_SIDE = 8
+MIN_GRID = 22
+MAX_GRID = 30
+MOAT = 2
+MIN_FREE_RUN = 5
+MIN_STOP_RUN = 4
+MAX_MARKERS = 6
+SIDES = ("up", "down", "left", "right")
+DIRS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+PALETTE = list(range(10))
