+    grid = np.full((H, W), bg, dtype=int)
+    for idx, rect in enumerate(rects):
+        rect["marker_count"] = int(counts[idx])
+        rect["capacity"] = (rect["bbox"][2] - rect["bbox"][0] - 1) * (rect["bbox"][3] - rect["bbox"][1] - 1)
