0152: def _has_hole(mask: np.ndarray) -> bool:
0153:     bg = ~mask.astype(bool)
0154:     if not bool(bg.any()):
0155:         return False
0156: 
0157:     H, W = bg.shape
0158:     seen = np.zeros_like(bg, dtype=bool)
0159:     stack: list[tuple[int, int]] = []
0160:     for r in range(H):
0161:         for c in (0, W - 1):
0162:             if bg[r, c] and not seen[r, c]:
0163:                 seen[r, c] = True
0164:                 stack.append((r, c))
0165:     for c in range(W):
0166:         for r in (0, H - 1):
0167:             if bg[r, c] and not seen[r, c]:
0168:                 seen[r, c] = True
0169:                 stack.append((r, c))
0170: 
0171:     while stack:
0172:         r, c = stack.pop()
0173:         for dr, dc in GEN_NEIGHBORS_4:
0174:             nr, nc = r + dr, c + dc
0175:             if 0 <= nr < H and 0 <= nc < W and bg[nr, nc] and not seen[nr, nc]:
0176:                 seen[nr, nc] = True
0177:                 stack.append((nr, nc))
0178:     return bool((bg & ~seen).any())
