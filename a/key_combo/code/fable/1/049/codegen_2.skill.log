0004: 
0005: from arc_utils import colors_present, get_bg
0006: 
0007: 
0008: def _sign(x: int) -> int:
0009:     return (x > 0) - (x < 0)
0010: 
0011: 
0012: def main(grid: np.ndarray) -> np.ndarray:
0013:     """
0014:     Connect each same-colored endpoint pair by filling the diagonal segment between them.
0015: 
0016:     Input structure:
0017:     - A dominant background surrounds several foreground colors.
0018:     - Each foreground color appears exactly twice.
0019:     - The two pixels of each foreground color are endpoints of a strict 45-degree diagonal segment.
0020: 
0021:     Rule:
0022:     - Preserve the input pixels.
0023:     - For every foreground color, paint that color on every cell along the diagonal segment connecting its two endpoints.
0024: 
0025:     Key insight:
0026:     Each color supplies its own two endpoints; the missing cells are just the background cells on the straight diagonal between them.
0027:     """
0028:     g = np.asarray(grid, dtype=int)
0029:     assert g.ndim == 2, "grid must be 2D"
0030: 
0031:     bg = get_bg(g)
0032:     colors = colors_present(g, exclude={bg})
0033:     assert colors, "expected at least one foreground endpoint pair"
0034: 
0035:     out = g.copy()
0036:     for color in colors:
0037:         coords = np.argwhere(g == color)
0038:         assert len(coords) == 2, "each foreground color must have exactly two endpoints"
0039:         (r0, c0), (r1, c1) = coords.astype(int).tolist()
0040: 
0041:         dr = r1 - r0
0042:         dc = c1 - c0
0043:         assert dr != 0 and abs(dr) == abs(dc), "endpoint pair must define a strict diagonal"
0044: 
0045:         step_r = _sign(dr)
0046:         step_c = _sign(dc)
0047:         for k in range(abs(dr) + 1):
0048:             r = r0 + k * step_r
