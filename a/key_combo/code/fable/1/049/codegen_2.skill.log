+
+    inp = _render_input(int(height), int(bg), int(wall_color), pipe_specs)
+    expected = _render_output(int(height), int(bg), int(wall_color), pipe_specs)
+    try:
+        pred = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(pred, expected):
+        return None
+    return inp
