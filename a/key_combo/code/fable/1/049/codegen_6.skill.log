+
+    max_targets = min(len(other_positions) - 1, 6)
+    if max_targets < 3:
+        return None
+    min_targets = 4 if max_targets >= 4 else 3
+    target_count = random.randint(min_targets, max_targets)
+    target_positions = random.sample(other_positions, target_count)
