        except AssertionError:
            continue
        hs = {r1-r0+1 for r0,r1 in row_spans}
        ws = {c1-c0+1 for c0,c1 in col_spans}
        if len(hs) "'!= 1 or len(ws) != 1:
            continue
        tile_h = hs.pop(); tile_w = ws.pop()
        if tile_h != tile_w:
            continue
        try:
