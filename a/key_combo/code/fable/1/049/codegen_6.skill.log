import random
from collections import Counter
import numpy as np

NEIGHBORS4 = [(-1,0),(1,0),(0,-1),(0,1)]


def dominant_color(values):
    counts = Counter(map(int, np.asarray(values).reshape(-1)))
    ranked = counts.most_common()
    if not ranked:
        raise AssertionError('empty values')
    if len(ranked) > 1 and ranked[0][1] == ranked[1][1]:
        raise AssertionError('dominant color not unique')
    return int(ranked[0][0])


def spans(length, seps):
    out = []
    start = 0
    for sep in seps:
        if sep <= start:
            raise AssertionError('bad separators')
        out.append((start, sep - 1))
        start = sep + 1
    if start >= length:
        raise AssertionError('bad separators end')
    out.append((start, length - 1))
    return out


def dihedral(tile):
    vars = []
    for k in range(4):
        rot = np.rot90(tile, k)
        vars.append(rot)
        vars.append(np.fliplr(rot))
    return vars


def single_coord(tile, color):
    pts = np.argwhere(tile == color)
    assert len(pts) == 1
    return tuple(map(int, pts[0]))


def parse(grid):
    g = np.asarray(grid, dtype=int)
    H,W = g.shape
    matches = []
    for color in np.unique(g):
        color = int(color)
