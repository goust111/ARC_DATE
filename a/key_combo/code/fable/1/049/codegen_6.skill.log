            continue
        states = [ (single_coord(v,a), single_coord(v,b)) for v in vars ]
        if len(set(states)) != 8:
            continue
        return tile
    return None


def feasible_layouts():
    opts=[]
    for rows in range(2,5):
        for cols in range(2,5):
            if rows*cols < 6:
                continue
            max_size = min((30 - (rows - 1)) // rows, (30 - (cols - 1)) // cols)
            sizes = [s for s in range(5,8) if s <= max_size]
            if sizes:
                opts.append((rows, cols, sizes))
    return opts

OPTS = feasible_layouts()


def build_base(rows, cols, size, bg, sep):
    H = rows*size + (rows-1)
    W = cols*size + (cols-1)
