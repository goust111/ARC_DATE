import random, hashlib
from collections import Counter
import numpy as np

NEIGHBORS4 = [(-1,0),(1,0),(0,-1),(0,1)]

def dominant_color(values):
    counts = Counter(map(int, np.asarray(values).reshape(-1)))
    ranked = counts.most_common()
