        tidx = template_idxs[0]
        template_tile = tiles[tidx][1]
        counts = Counter(map(int, template_tile[template_tile != bg]))
        outside = Counter()
        for i,(_b,t) in enumerate(tiles):
            if i == tidx:
                continue
            outside.update(map(int, t[t != bg]))
        anchors = sorted([col for col,n in counts.items() if n == 1 and outside[col] > 0])
        if len(anchors) != 2:
