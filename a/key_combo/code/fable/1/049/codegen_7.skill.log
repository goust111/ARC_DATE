+    wall_prefix: list[int] = []
+    boundary_prefix: list[int] = []
+    wall_bounces = 0
+    boundary_bounces = 0
+
+    for _ in range(int(grid.size) * 8):
+        step = _reflect_step(grid, r, c, dr, dc)
+        if step is None:
+            return None
+        nr, nc, dr, dc, hit_wall, hit_boundary = step
+        if int(grid[nr, nc]) != bg:
+            return None
+
