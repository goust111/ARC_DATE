+        return False
+
+    step_dir = ((dr > 0) - (dr < 0), (dc > 0) - (dc < 0))
+    r, c = start
+    for _ in range(abs(dr)):
+        step = _reflect_step(grid, r, c, step_dir[0], step_dir[1])
+        if step is None:
