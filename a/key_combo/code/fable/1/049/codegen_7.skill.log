+    next_dr = -dr if (row_out or row_wall) else dr
+    next_dc = -dc if (col_out or col_wall) else dc
+    nr, nc = r + next_dr, c + next_dc
+
+    if not _in_bounds(grid.shape, nr, nc):
+        return None
