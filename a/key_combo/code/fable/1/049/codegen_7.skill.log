+            return False
+        route = forward[0]
+        if route["path"] != spec["path"]:
+            return False
+        if int(route["wall_bounces"]) != int(spec["wall_bounces"]):
+            return False
+        if int(route["boundary_bounces"]) != int(spec["boundary_bounces"]):
+            return False
+        for cell in route["path"]:
+            if cell in seen_cells:
+                return False
+            seen_cells.add(cell)
