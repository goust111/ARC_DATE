+    start: tuple[int, int],
+    direction: tuple[int, int],
+    target: tuple[int, int],
+    *,
+    bg: int | None = None,
+) -> dict[str, object] | None:
+    if bg is None:
+        bg = int(get_bg(grid))
+
+    r, c = map(int, start)
+    dr, dc = map(int, direction)
+    seen_states = {(r, c, dr, dc)}
+    path: list[tuple[int, int]] = []
+    wall_bounces = 0
+    boundary_bounces = 0
+
+    for _ in range(int(grid.size) * 8):
+        step = _reflect_step(grid, r, c, dr, dc)
+        if step is None:
+            return None
+        nr, nc, dr, dc, hit_wall, hit_boundary = step
+        wall_bounces += int(hit_wall)
+        boundary_bounces += int(hit_boundary)
+
+        if (nr, nc) == target:
+            return {
+                "path": path,
+                "wall_bounces": wall_bounces,
+                "boundary_bounces": boundary_bounces,
+                "direction": direction,
+            }
+
+        if int(grid[nr, nc]) != bg:
+            return None
+
+        path.append((nr, nc))
+        state = (nr, nc, dr, dc)
+        if state in seen_states:
+            return None
+        seen_states.add(state)
+        r, c = nr, nc
+
+    return None
