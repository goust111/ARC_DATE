+
+
+def _random_segment(mask: np.ndarray, orientation: str) -> list[tuple[int, int]] | None:
+    height, width = map(int, mask.shape)
+    max_len = min(8, (width - 2) if orientation == "h" else (height - 2))
+    if max_len < GEN_SEGMENT_MIN_LEN:
