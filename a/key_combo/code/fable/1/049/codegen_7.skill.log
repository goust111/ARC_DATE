+def _trace_orbit(
+    grid: np.ndarray,
+    start: tuple[int, int],
+    direction: tuple[int, int],
+    *,
+    bg: int = BG,
+) -> dict[str, object] | None:
+    """Trace a simple prefix in a wall scene, stopping before any self-intersection or state loop."""
