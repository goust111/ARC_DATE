+    grid: np.ndarray, start: tuple[int, int], target: tuple[int, int]
+) -> bool:
+    dr = int(target[0] - start[0])
+    dc = int(target[1] - start[1])
+    if dr == 0 or abs(dr) != abs(dc):
+        return False
+
+    step_dir = ((dr > 0) - (dr < 0), (dc > 0) - (dc < 0))
