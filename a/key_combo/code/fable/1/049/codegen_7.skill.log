+        nr, nc, next_dr, next_dc, hit_wall, hit_boundary = step
+        if hit_wall or hit_boundary or (next_dr, next_dc) != step_dir:
+            return False
+        r, c = nr, nc
+    return (r, c) == target
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
