+
+def _attempt_generate() -> np.ndarray | None:
+    height = random.randint(*GEN_HEIGHT_RANGE)
+    width = random.randint(*GEN_WIDTH_RANGE)
+    wall_mask = _build_wall_mask(height, width)
+    if wall_mask is None:
+        return None
