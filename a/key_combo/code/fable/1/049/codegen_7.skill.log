+        for r, c in spec["path"]:
+            assert int(out[r, c]) == BG
+            out[r, c] = color
+    return out
+
+
+def _find_pair_candidate(
+    grid: np.ndarray,
+    color: int,
+    used_paths: set[tuple[int, int]],
