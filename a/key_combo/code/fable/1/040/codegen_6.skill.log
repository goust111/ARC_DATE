+    assert block.shape == (n, n)
+    assert n >= 5 and n % 2 == 1
+
+    border = np.zeros((n, n), dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+
+    gap_coords = np.argwhere(border & (block == bg))
+    assert gap_coords.shape[0] == 1, "expected exactly one border gap"
+    gr, gc = map(int, gap_coords[0])
+
