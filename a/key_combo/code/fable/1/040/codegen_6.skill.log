+    coords = [tuple(map(int, rc)) for rc in np.argwhere(full_mask)]
+    if not coords:
+        return parts
+
+    for coord in coords:
+        cover = 1 if copies == 1 else random.randint(1, min(2, copies))
+        for idx in random.sample(range(copies), cover):
