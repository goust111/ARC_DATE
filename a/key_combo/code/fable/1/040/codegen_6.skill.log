+
+    interior_size = frame_size - 2
+    canonical_motifs: dict[int, np.ndarray] = {}
+    for color in colors:
+        repeated = len(frames_by_color[color]) > 1
+        canonical_motifs[color] = _random_motif(
+            interior_size,
