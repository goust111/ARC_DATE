+    r, c = map(int, coord)
+    height, width = map(int, shape)
+    if orientation in {"tr", "br"}:
+        c = width - 1 - c
+    if orientation in {"bl", "br"}:
+        r = height - 1 - r
+    return int(r), int(c)
+
