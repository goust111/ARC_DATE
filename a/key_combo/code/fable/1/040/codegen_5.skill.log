    if blocked:
        blockers = current_path | used_path
        if not _gen_put_obstacle(grid, row_counts, blockers, r - 1, c):
            return None
        if c + 1 < w:
            if c + 1 > side_limit:
                return None
            if not _gen_put_obstacle(grid, row_counts, blockers, r, c + 1):
