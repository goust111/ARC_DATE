                    return None
            for cc in range(c + 1, c + run + 1):
                if not add_path_cell(r, cc):
                    return None
            c += run

        if grid[r - 1, c] != _GEN_BG or (r - 1, c) in used_path or (r - 1, c) in current_path:
            return None
        r -= 1
        if not add_path_cell(r, c):
