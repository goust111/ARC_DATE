+        return grid.copy()
+    if orientation == "tr":
+        return np.fliplr(grid).copy()
+    if orientation == "bl":
+        return np.flipud(grid).copy()
+    if orientation == "br":
+        return np.flipud(np.fliplr(grid)).copy()
+    raise ValueError("invalid orientation")
