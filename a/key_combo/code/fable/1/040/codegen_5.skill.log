    width_min = center_col + 2 * period + 1
    if height_min > 30 or width_min > 30:
        return None
    height = random.randint(height_min, min(30, height_min + 4))
    width = random.randint(width_min, min(30, width_min + 4))
    if height == width:
        if width < 30:
