  31: def main(grid: np.ndarray) -> np.ndarray:
  32:     """Return the color of the unique rectangular foreground object that encloses a background hole.
  33: 
  34:     Input structure
  35:     - The input has a dominant background and several separated single-color rectangular foreground objects.
  36:     - Exactly one foreground object is a complete rectangular frame around one or more background pixels.
  37: 
  38:     Rule
  39:     - Find all monochrome 4-connected foreground objects.
  40:     - For each object's bbox, require a complete border in that object's color.
  41:     - Select the unique object whose bbox contains a 4-connected background component that does not touch the bbox border.
  42:     - Output a 1x1 grid containing the selected object's color.
  43: 
  44:     Key insight
  45:     - The answer is not determined by object size, position, or color identity; it is the only object with an enclosed background hole.
  46:     """
  47:     g = np.asarray(grid, dtype=int)
  48:     assert g.ndim == 2, "expected a 2D grid"
  49: 
  50:     bg = get_bg(g)
  51:     components = find_components(g, bg=bg, connectivity=4, monochromatic=True)
  52:     assert components, "expected foreground objects"
  53: 
  54:     selected_colors = []
  55:     for component in components:
  56:         color = int(component["color"])
  57:         r0, c0, r1, c1 = component["bbox"]
  58:         region = g[r0 : r1 + 1, c0 : c1 + 1]
  59:         if _has_enclosed_bg_hole(region, color, bg):
