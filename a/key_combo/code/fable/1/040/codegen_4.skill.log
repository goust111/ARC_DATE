  60:             colors = set(map(int, block[block != bg]))
  61:             assert len(colors) == 1
  62:             color = colors.pop()
  63:             assert np.all(block[0, :] == color)
  64:             assert np.all(block[-1, :] == color)
  65:             assert np.all(block[:, 0] == color)
  66:             assert np.all(block[:, -1] == color)
