  41:     bg = get_bg(g)
  42: 
  43:     row_runs = _runs(np.any(g != bg, axis=1))
  44:     col_runs = _runs(np.any(g != bg, axis=0))
  45:     frame_h = row_runs[0][1] - row_runs[0][0] + 1
  46:     frame_w = col_runs[0][1] - col_runs[0][0] + 1
  47:     assert frame_h == frame_w
  48:     assert frame_h >= 3
  49:     assert all(r1 - r0 + 1 == frame_h for r0, r1 in row_runs)
  50:     assert all(c1 - c0 + 1 == frame_w for c0, c1 in col_runs)
