+        return None
+
+    grid = np.zeros((height, width), dtype=int)
+    expected = np.zeros((height, width), dtype=int)
+
+    bar_top = random.randint(0, height - bar_h)
+    path_top = random.randint(0, height - path_h)
+
+    if side == "left":
+        path_left = random.randint(bar_w + gap, width - path_w)
