+
+        r0, c0, r1, c1 = _bbox_coords(coords)
+        assert r0 == r1, "instruction bars must be horizontal"
+        cols = sorted(int(c) for _r, c in coords)
+        assert cols == list(range(c0, c1 + 1)), "instruction bar must be contiguous"
