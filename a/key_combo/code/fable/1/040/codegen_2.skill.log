+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+Coord = tuple[int, int]
+BBox = tuple[int, int, int, int]
+
+BG = 0
+TURN_LEFT = "L"
+TURN_RIGHT = "R"
+UP = (-1, 0)
+
+GEN_ATTEMPTS = 500
+GEN_PROGRAM_ATTEMPTS = 300
+GEN_BAR_COUNT_CHOICES = (3, 4, 4, 5, 5, 6)
+GEN_STEP_MIN = 2
+GEN_STEP_MAX = 6
+GEN_MAX_PATH_H = 17
+GEN_MAX_PATH_W = 17
+GEN_MAX_GRID = 30
+GEN_GAP_RANGE = (2, 4)
+GEN_EXTRA_W_RANGE = (1, 5)
+GEN_EXTRA_H_RANGE = (2, 6)
+GEN_COLORS = tuple(range(1, 10))
+GEN_SIDES = ("left", "right")
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(np.asarray(grid, dtype=int), return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _neighbors4(r: int, c: int) -> list[Coord]:
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def _bbox_coords(coords: np.ndarray) -> BBox:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _find_components(mask: np.ndarray) -> list[np.ndarray]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[np.ndarray] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[Coord] = []
+            while queue:
+                rr, cc = queue.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+            components.append(np.array(coords, dtype=int))
+    return components
+
+
+def _turn(direction: Coord, kind: str) -> Coord:
+    dr, dc = direction
+    if kind == TURN_LEFT:
+        return -dc, dr
+    if kind == TURN_RIGHT:
+        return dc, -dr
+    raise ValueError(f"unknown turn {kind}")
+
+
+def _trace_program(turns: list[str], steps: list[int]) -> list[Coord]:
+    assert len(turns) == len(steps)
+    direction = UP
+    pos = (0, 0)
+    path = [pos]
+    for kind, length in zip(turns, steps):
+        direction = _turn(direction, kind)
+        for _ in range(int(length)):
+            pos = (pos[0] + direction[0], pos[1] + direction[1])
+            path.append(pos)
+    return path
+
