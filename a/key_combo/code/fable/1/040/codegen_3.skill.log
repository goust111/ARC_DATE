+        picks = random.sample(range(length), random.randint(1, min(2, length)))
+        for idx in picks:
+            factors[idx] = random.choice((2, 3)) if length <= 4 else 2
+        if sum(factors) <= max_dim:
+            return factors
+    raise RuntimeError("failed to sample valid stretch factors")
