+        for r0, c0 in positions:
+            r1 = r0 + h - 1
+            c1 = c0 + w - 1
+            if any(
+                not (r1 < pr0 - 1 or r0 > pr1 + 1 or c1 < pc0 - 1 or c0 > pc1 + 1)
+                for pr0, pc0, pr1, pc1 in placed_boxes
