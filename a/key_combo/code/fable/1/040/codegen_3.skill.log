  45: def main(grid: np.ndarray) -> np.ndarray:
  46:     """Recolor every candidate object whose run-compressed shape matches the single prototype object, allowing rotation and reflection.
  47:     Input structure
  48:     A black-background grid contains exactly two foreground colors: one color forms a single prototype object, and the other forms multiple candidate objects.
  49:     Rule
  50:     Crop each object to its bbox, collapse adjacent identical rows and columns to remove stretch, and recolor every candidate whose collapsed mask is a rotation or reflection of the prototype's collapsed mask.
  51:     Key insight
  52:     The prototype is a line-drawing symbol; candidate symbols can be stretched in row/column runs, so matching must compare the compressed topology rather than raw size.
  53:     """
  54:     g = np.asarray(grid, dtype=int)
  55:     assert g.ndim == 2
  56: 
  57:     bg = get_bg(g)
  58:     fg_colors = colors_present(g, exclude={bg})
  59:     assert len(fg_colors) == 2
  60: 
  61:     comps_by_color = {
  62:         color: components_mask(g == color, connectivity=4) for color in fg_colors
  63:     }
  64:     prototype_colors = [
  65:         color for color, comps in comps_by_color.items() if len(comps) == 1
  66:     ]
  67:     assert len(prototype_colors) == 1
  68: 
  69:     prototype_color = prototype_colors[0]
  70:     candidate_colors = [color for color in fg_colors if color != prototype_color]
  71:     assert len(candidate_colors) == 1
  72:     candidate_color = candidate_colors[0]
  73:     assert len(comps_by_color[candidate_color]) > 1
  74: 
  75:     prototype_mask = _component_mask(comps_by_color[prototype_color][0])
  76:     prototype_signatures = _prototype_signatures(prototype_mask)
  77: 
  78:     out = g.copy()
  79:     matched = 0
  80:     for coords in comps_by_color[candidate_color]:
  81:         candidate_mask = _component_mask(coords)
  82:         if _signature(candidate_mask) in prototype_signatures:
  83:             out[coords[:, 0], coords[:, 1]] = prototype_color
  84:             matched += 1
