+        w = random.randint(4, 6)
+        target = random.randint(max(6, (h * w) // 3), min(h * w - 2, (2 * h * w) // 3))
+
+        cells = {(random.randrange(h), random.randrange(w))}
+        while len(cells) < target:
+            frontier = []
+            for r, c in cells:
