+def _matching_size(adj_masks: list[int]) -> int:
+    n = len(adj_masks)
+
+    @lru_cache(None)
+    def dp(mask: int) -> int:
+        if mask == 0:
+            return 0
+        lsb = mask & -mask
+        v = lsb.bit_length() - 1
+        best = dp(mask ^ lsb)
+        options = adj_masks[v] & (mask ^ lsb)
+        while options:
+            lsb2 = options & -options
+            best = max(best, 1 + dp(mask ^ lsb ^ lsb2))
+            options ^= lsb2
+        return best
