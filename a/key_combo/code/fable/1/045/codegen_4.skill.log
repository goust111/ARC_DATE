+
+
+def _paint_cells(
+    grid: np.ndarray,
+    reserve: np.ndarray,
+    occupied: np.ndarray,
+    cells: list[tuple[int, int]],
+    color: int,
+) -> None:
+    for r, c in cells:
+        grid[r, c] = int(color)
+        reserve[r, c] = True
+        occupied[r, c] = True
+
+
+def _allocate_bands(span: int, thicknesses: list[int], rng: random.Random) -> list[int] | None:
+    needed = sum(thicknesses) + max(0, len(thicknesses) - 1)
+    slack = span - needed
+    if slack < 0:
+        return None
+    extras = [0] * (len(thicknesses) + 1)
+    for _ in range(slack):
+        extras[rng.randrange(len(extras))] += 1
+    starts: list[int] = []
+    pos = extras[0]
+    for i, thick in enumerate(thicknesses):
+        starts.append(pos)
+        pos += thick + 1 + extras[i + 1]
+    return starts
+
+
+def _place_split_objects(
+    grid: np.ndarray,
+    reserve: np.ndarray,
+    occupied: np.ndarray,
