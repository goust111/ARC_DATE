+
+def _mask_bbox(mask: np.ndarray) -> tuple[int, int, int, int]:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        raise ValueError("expected non-empty mask")
+    rs = coords[:, 0]
+    cs = coords[:, 1]
+    return int(rs.min()), int(cs.min()), int(rs.max()), int(cs.max())
