+    panel_bbox, _occ_bbox, rows, real_counts, _visible_counts = _analyze(g)
+    pr0, pc0, pr1, pc1 = panel_bbox
+    return _render_legend((pr1 - pr0 + 1, pc1 - pc0 + 1), rows, real_counts)
