+from __future__ import annotations
+
+from collections import Counter
+from functools import lru_cache
+import random
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                comp.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            out.append(comp)
+    return out
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rs = [r for r, _ in coords]
+    cs = [c for _, c in coords]
+    return min(rs), min(cs), max(rs), max(cs)
+
+
+def _largest_component_bbox(mask: np.ndarray) -> tuple[int, int, int, int]:
+    comps = _components(mask)
+    if not comps:
+        raise ValueError("expected at least one component")
+    return _bbox(max(comps, key=len))
+
+
+def _legend_rows(
+    grid: np.ndarray, panel_bbox: tuple[int, int, int, int]
+) -> list[dict[str, int]]:
+    r0, c0, r1, c1 = panel_bbox
+    rows: list[dict[str, int]] = []
+    for r in range(r0, r1 + 1):
+        rel = grid[r, c0 : c1 + 1]
+        cols = np.flatnonzero(rel != BLACK)
+        if cols.size == 0:
+            continue
+        key_c = int(cols[0])
+        rows.append({"rel_r": r - r0, "key_c": key_c, "color": int(rel[key_c])})
+    if not rows:
+        raise ValueError("legend panel must contain keyed rows")
+    return rows
+
