+    return real_counts, visible_counts
+
+
+def _render_legend(
+    panel_shape: tuple[int, int], rows: list[dict[str, int]], counts: dict[int, int]
+) -> np.ndarray:
+    out = np.full(panel_shape, BLACK, dtype=int)
+    for row in rows:
+        rr = int(row["rel_r"])
+        key_c = int(row["key_c"])
+        color = int(row["color"])
+        out[rr, key_c] = color
+        for i in range(int(counts[color])):
