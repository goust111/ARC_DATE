+    d_br = (h - 1 - coords[:, 0]) + (w - 1 - coords[:, 1])
+    d_bl = (h - 1 - coords[:, 0]) + coords[:, 1]
+    ds = np.stack([d_tl, d_tr, d_br, d_bl], axis=1)
+    corner_idx = ds.argmin(axis=1)
+
+    side_candidates: list[int] = []
+    for corner in range(4):
