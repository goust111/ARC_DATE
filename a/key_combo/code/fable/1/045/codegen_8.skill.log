   372	def _assign_missing(mask: np.ndarray, genuine_corners: list[int], rng: random.Random) -> dict[int, set[tuple[int, int]]]:
   373	    coords = [tuple(map(int, rc)) for rc in np.argwhere(mask)]
   374	    rng.shuffle(coords)
   375	    missing = {corner: set() for corner in genuine_corners}
   376	
   377	    for corner, cell in zip(genuine_corners, coords[: len(genuine_corners)]):
   378	        missing[corner].add(cell)
   379	
   380	    for cell in coords[len(genuine_corners) :]:
   381	        choice = rng.choices([None, *genuine_corners], weights=[7, 1, 1, 1], k=1)[0]
   382	        if choice is not None:
   383	            missing[int(choice)].add(cell)
   384	    return missing
