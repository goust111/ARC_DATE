+
+        ref_score = (
+            int(base_mask.sum()) * 100
+            + overlap_total * 10
+            + unique_pair_total * 5
+            + composition_support
+            + sum(missing_counts)
+        )
+        if ref_score > best_ref_score:
+            best_ref = ref
+            best_ref_patch = ref_patch
+            best_ref_score = ref_score
+
+    if best_ref is None or best_ref_patch is None:
+        return None
+
+    return {
+        "trio": trio,
+        "base_mask": base_mask,
+        "pair_maps": pair_maps,
+        "ref_pos": best_ref,
+        "ref_patch": best_ref_patch,
+        "score": best_ref_score,
+    }
+
