+def _build_case(rng: random.Random) -> tuple[np.ndarray, np.ndarray] | None:
+    side = rng.randint(5, 8)
+    gap = rng.randint(2, 30 - 2 * side)
+    size = 2 * side + gap
+    if size > 30:
+        return None
+
