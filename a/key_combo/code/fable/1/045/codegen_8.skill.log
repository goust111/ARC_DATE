   270	    - Mirror every corner back to one canonical orientation, then test which three patches share one majority-supported shape and pairwise one-to-one color remappings that compose consistently.
   271	    - Reconstruct the complete canonical mother-family patch from the genuine trio, map its colors back to each genuine corner, and keep the impostor patch and all black separator cells unchanged.
   272	
   273	    Key insight:
   274	    - Shape agreement alone is insufficient because matching cells cycle through colors from corner to corner; only the trio that is jointly consistent under both canonical mirroring and one global color permutation can explain every missing cell.
   275	    """
   276	    g = np.asarray(grid, dtype=int)
   277	    if g.ndim != 2:
   278	        raise ValueError("expected a 2D grid")
   279	
   280	    try:
   281	        info = _solve_metadata(g)
   282	    except ValueError:
   283	        return g.copy()
   284	
   285	    side = int(info["side"])
   286	    out = g.copy()
   287	    for corner, patch in info["completed_canonical"].items():
   288	        placed = _from_canonical(np.asarray(patch, dtype=int), int(corner))
   289	        r0, c0, r1, c1 = _corner_bbox(g.shape, side, int(corner))
   290	        out[r0 : r1 + 1, c0 : c1 + 1] = placed
   291	    return out
   292	
   293	
   294	def _sample_mask(side: int, rng: random.Random) -> np.ndarray:
   295	    for _ in range(80):
   296	        sprite = random_sprite(
   297	            side,
   298	            side,
   299	            density=rng.uniform(0.45, 0.72),
   300	            color_palette=[Color.BLUE],
   301	            connectivity=4,
   302	            background=Color.BLACK,
   303	        )
   304	        mask = sprite != Color.BLACK
   305	        area = int(mask.sum())
   306	        if area < side + 6:
   307	            continue
   308	        if np.any(mask[0]) and np.any(mask[-1]) and np.any(mask[:, 0]) and np.any(mask[:, -1]):
   309	            return mask
   310	    raise RuntimeError("failed to sample mask")
   311	
   312	
   313	def _colorize_mask(mask: np.ndarray, cycle: list[int], rng: random.Random) -> np.ndarray:
   314	    side = mask.shape[0]
   315	    coords = [tuple(map(int, rc)) for rc in np.argwhere(mask)]
   316	
   317	    formulas = []
   318	    for a in (1, 2, 3):
   319	        for b in (1, 2):
   320	            for phase in range(len(cycle)):
   321	                formulas.append((a, b, phase))
   322	    rng.shuffle(formulas)
   323	
   324	    for a, b, phase in formulas:
   325	        patch = np.zeros((side, side), dtype=int)
   326	        for r, c in coords:
   327	            idx = (a * r + b * c + phase) % len(cycle)
   328	            patch[r, c] = int(cycle[idx])
   329	        used = {int(v) for v in patch[mask]}
   330	        counts = {color: int(np.count_nonzero(patch == color)) for color in cycle}
   331	        if used == set(cycle) and min(counts.values()) >= 2:
   332	            return patch
   333	
   334	    # Fallback: order cells by a visible diagonal sweep, then cycle colors.
   335	    patch = np.zeros((side, side), dtype=int)
   336	    coords.sort(key=lambda rc: (rc[0] + rc[1], rc[0], rc[1]))
   337	    offset = rng.randrange(len(cycle))
   338	    for idx, (r, c) in enumerate(coords):
   339	        patch[r, c] = int(cycle[(idx + offset) % len(cycle)])
   340	    return patch
   341	
   342	
   343	def _shift_colors(patch: np.ndarray, cycle: list[int], steps: int) -> np.ndarray:
   344	    out = patch.copy()
   345	    positions = {color: idx for idx, color in enumerate(cycle)}
   346	    for color, idx in positions.items():
   347	        out[patch == color] = int(cycle[(idx + steps) % len(cycle)])
   348	    return out
   349	
   350	
   351	def _make_impostor(side: int, cycle: list[int], mother_mask: np.ndarray, rng: random.Random) -> np.ndarray:
   352	    remaining = [color for color in Color.NOT_BLACK if color not in cycle]
   353	    if len(remaining) < 2:
   354	        remaining = list(Color.NOT_BLACK)
   355	
   356	    for _ in range(120):
   357	        mask = _sample_mask(side, rng)
   358	        if np.array_equal(mask, mother_mask):
   359	            continue
   360	        palette_size = min(len(remaining), rng.randint(2, min(4, len(remaining))))
   361	        palette = rng.sample(remaining, palette_size)
   362	        patch = np.zeros((side, side), dtype=int)
   363	        bias = rng.randrange(3)
   364	        for r, c in np.argwhere(mask):
   365	            patch[r, c] = int(palette[(int(r) * bias + int(c) + rng.randrange(len(palette))) % len(palette)])
