+    completed_canonical: dict[int, np.ndarray] = {}
+    for pos, corner in enumerate(trio):
+        full_patch = np.zeros_like(ref_patch)
+        if pos == ref_pos:
+            full_patch[base_mask] = ref_patch[base_mask]
+        else:
