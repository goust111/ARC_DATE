   386	
   387	def _build_case(rng: random.Random) -> tuple[np.ndarray, np.ndarray] | None:
   388	    side = rng.randint(5, 8)
   389	    gap = rng.randint(2, 30 - 2 * side)
   390	    size = 2 * side + gap
   391	    if size > 30:
   392	        return None
   393	
   394	    cycle_len = rng.randint(3, 5)
   395	    cycle = rng.sample(list(Color.NOT_BLACK), cycle_len)
   396	    mother_mask = _sample_mask(side, rng)
   397	    mother_patch = _colorize_mask(mother_mask, cycle, rng)
   398	
   399	    impostor_corner = rng.randrange(4)
   400	    genuine_corners = [corner for corner in range(4) if corner != impostor_corner]
   401	    missing = _assign_missing(mother_mask, genuine_corners, rng)
   402	    impostor_patch = _make_impostor(side, cycle, mother_mask, rng)
   403	
   404	    canonical_patches: dict[int, np.ndarray] = {}
   405	    for corner in range(4):
   406	        if corner == impostor_corner:
   407	            canonical_patches[corner] = impostor_patch.copy()
   408	            continue
   409	        patch = _shift_colors(mother_patch, cycle, corner)
   410	        for r, c in missing[corner]:
   411	            patch[r, c] = Color.BLACK
   412	        canonical_patches[corner] = patch
   413	
   414	    expected = np.zeros((size, size), dtype=int)
   415	    inp = np.zeros((size, size), dtype=int)
   416	    for corner in range(4):
   417	        full_patch = impostor_patch if corner == impostor_corner else _shift_colors(mother_patch, cycle, corner)
   418	        oriented_full = _from_canonical(full_patch, corner)
   419	        oriented_inp = _from_canonical(canonical_patches[corner], corner)
   420	        r0, c0, _r1, _c1 = _corner_bbox(inp.shape, side, corner)
   421	        paste(expected, oriented_full, r0, c0, transparent=Color.BLACK)
   422	        paste(inp, oriented_inp, r0, c0, transparent=Color.BLACK)
   423	
   424	    if not _semantic_check(
   425	        inp=inp,
   426	        expected=expected,
   427	        side=side,
   428	        mother_mask=mother_mask,
   429	        mother_patch=mother_patch,
   430	        cycle=cycle,
   431	        genuine_corners=genuine_corners,
   432	        impostor_corner=impostor_corner,
   433	        missing=missing,
   434	    ):
   435	        return None
   436	    return inp, expected
   437	
   438	
   439	def _semantic_check(
   440	    *,
   441	    inp: np.ndarray,
   442	    expected: np.ndarray,
   443	    side: int,
   444	    mother_mask: np.ndarray,
   445	    mother_patch: np.ndarray,
   446	    cycle: list[int],
   447	    genuine_corners: list[int],
   448	    impostor_corner: int,
   449	    missing: dict[int, set[tuple[int, int]]],
   450	) -> bool:
   451	    if _infer_corner_side(inp) != side:
   452	        return False
   453	
   454	    canonical = [_orient_to_canonical(_extract_corner(inp, side, corner), corner) for corner in range(4)]
   455	    support = np.zeros_like(mother_mask, dtype=int)
   456	    for corner in genuine_corners:
   457	        patch = canonical[corner]
   458	        support += (patch != Color.BLACK).astype(int)
   459	        if not np.any((patch == Color.BLACK) & mother_mask):
   460	            return False
   461	        visible = {int(v) for v in patch[patch != Color.BLACK]}
   462	        if visible != set(cycle):
   463	            return False
   464	    if not np.array_equal(support >= 2, mother_mask):
   465	        return False
   466	    if np.any(support[mother_mask] < 2):
   467	        return False
   468	    if not np.array_equal((canonical[impostor_corner] != Color.BLACK), mother_mask):
   469	        pass
   470	    else:
   471	        impostor_info = _infer_color_mapping(canonical[genuine_corners[0]], canonical[impostor_corner])
   472	        if impostor_info is not None and len(impostor_info["mapping"]) == len(cycle):
   473	            return False
   474	
   475	    solved = main(inp)
   476	    if not np.array_equal(solved, expected):
   477	        return False
   478	
   479	    trio = set(_solve_metadata(inp)["genuine_trio"])
   480	    if trio != set(genuine_corners):
   481	        return False
   482	    ref_patch = mother_patch
   483	    return np.array_equal(ref_patch != Color.BLACK, mother_mask)
