+    interior = [(r, c) for r in range(1, h - 1) for c in range(1, w - 1)]
+    fill_count = len(interior) - int(copies)
+    if fill_count > 0:
+        chosen = rng.choice(len(interior), size=fill_count, replace=False)
+        for idx in np.atleast_1d(chosen):
+            r, c = interior[int(idx)]
+            patch[r, c] = color
