+    step_r = (-1 if gap_a == 0 else 1 if gap_a == 1 else 0) * (h + 1)
+    step_c = (-1 if gap_a == 2 else 1 if gap_a == 3 else 0) * (w + 1)
+    anchor_b = (anchor_a[0] + blocked_step * step_r, anchor_a[1] + blocked_step * step_c)
