+        c_lo, c_hi = blocked_step * (w + 1), W - w
+    else:
+        r_lo, r_hi = 0, H - h
+        c_lo, c_hi = 0, W - w - blocked_step * (w + 1)
+    if r_lo > r_hi or c_lo > c_hi:
+        return None
+    return (int(rng.integers(r_lo, r_hi + 1)), int(rng.integers(c_lo, c_hi + 1)))
