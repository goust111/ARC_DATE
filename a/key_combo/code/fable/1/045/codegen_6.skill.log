+    free_seen = False
+    for plan in plans:
+        visible_copies, visible_cells = _copy_stats(plan.frame, plan.top_lefts, grid.shape)
+        if plan.stopped_by_collision and visible_copies >= 1:
+            collision_seen = True
+        if not plan.stopped_by_collision and visible_copies >= 1:
+            free_seen = True
