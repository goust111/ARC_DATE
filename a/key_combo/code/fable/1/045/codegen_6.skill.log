+def _bbox_from_top_left(top_left: tuple[int, int], patch: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = top_left
+    h, w = patch.shape
+    return int(r0), int(c0), int(r0 + h - 1), int(c0 + w - 1)
