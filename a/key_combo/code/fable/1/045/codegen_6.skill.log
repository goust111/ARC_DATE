+    copies_a = int(rng.integers(min_copies, max_copies + 1))
+    copies_b_choices = [k for k in range(min_copies, max_copies + 1) if k != copies_a]
+    copies_b = int(rng.choice(copies_b_choices if copies_b_choices else [copies_a]))
