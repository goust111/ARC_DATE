+def _place_random_bbox(
+    rng: np.random.Generator,
+    shape: tuple[int, int],
+    patch: np.ndarray,
+    existing: list[tuple[int, int, int, int]],
+    tries: int = 120,
+) -> tuple[int, int] | None:
+    h, w = patch.shape
+    H, W = shape
+    for _ in range(tries):
+        r0 = int(rng.integers(0, H - h + 1))
+        c0 = int(rng.integers(0, W - w + 1))
+        bbox = _bbox_from_top_left((r0, c0), patch)
