+    options: list[tuple[int, int]] = []
+    if r == r0:
+        options.append((-1, 0))
+    if r == r1:
+        options.append((1, 0))
+    if c == c0:
+        options.append((0, -1))
+    if c == c1:
+        options.append((0, 1))
+    if len(options) != 1:
+        return None
+    return options[0]
