+        c_lo, c_hi = 0, W - w
+    elif gap_side == 2:
+        r_lo, r_hi = 0, H - h
+        c_lo, c_hi = blocked_step * (w + 1), W - w
+    else:
+        r_lo, r_hi = 0, H - h
+        c_lo, c_hi = 0, W - w - blocked_step * (w + 1)
