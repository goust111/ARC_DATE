+    grid_h = _randint(rng, min_height, min(MAX_H, min_height + 6))
+
+    max_start = min(grid_h // 2, grid_h - main_block_height - 2)
+    if max_start < 0:
+        return None
+    start_row = _randint(rng, 0, max_start)
