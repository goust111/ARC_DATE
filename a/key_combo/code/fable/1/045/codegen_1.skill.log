+def _gen_main_stack(rng: np.random.Generator) -> list[dict] | None:
+    w_bottom = _randint(rng, 4, 6)
+    w_middle = _randint(rng, max(2, w_bottom - 2), w_bottom)
+    w_top = _randint(rng, 2, min(w_middle, 4))
