+    )
+
+    max_sprite_h = max(int(obj["mask"].shape[0]) for obj in all_objects)
+    min_height = max(MIN_H, main_block_height + INPUT_ROW_CAP_MARGIN, max_sprite_h + 3)
+    if min_height > MAX_H:
