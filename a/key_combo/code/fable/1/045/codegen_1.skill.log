+    for sprite_id, comp in enumerate(comps):
+        sprites.append(
+            Sprite(
+                sprite_id=int(sprite_id),
+                color=int(comp["color"]),
+                area=int(comp["area"]),
+                bbox=tuple(map(int, comp["bbox"])),
+                coords=np.asarray(comp["coords"], dtype=int),
+            )
