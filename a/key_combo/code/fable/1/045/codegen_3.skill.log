        core_dims = (core_bbox[2] - core_bbox[0] + 1, core_bbox[3] - core_bbox[1] + 1)
        if min(core_dims) < 3 or max(core_dims) > 10:
            continue
        bm = (CTR - int(np.argwhere(core)[:, 0].min()), int(np.argwhere(core)[:, 0].max()) - CTR,
              CTR - int(np.argwhere(core)[:, 1].min()), int(np.argwhere(core)[:, 1].max()) - CTR)
        if len(set(bm)) == 1:
            continue
        blue_dir = random.choice(DIRS)
        green_dir = random.choice([d for d in DIRS if d != blue_dir])
        blue = grow(core, int(core.sum()) + random.randint(3, 8), 1, blue_dir)
        if blue is None:
            continue
        blue_extra = {(int(r), int(c)) for r, c in np.argwhere(blue & ~core)}
        green = grow(core, int(core.sum()) + random.randint(3, 8), 1, green_dir, banned=frozenset(blue_extra))
        if green is None:
            continue
        if unique_hole(blue) != (CTR, CTR) or unique_hole(green) != (CTR, CTR):
            continue
        blue_coords = relcoords(blue)
        green_coords = relcoords(green)
        inter = blue_coords & green_coords
        if inter != core_coords:
            continue
        if len(blue_coords - core_coords) < 3 or len(green_coords - core_coords) < 3:
            continue
        bb = bbox_of_coords(blue_coords)
        gb = bbox_of_coords(green_coords)
        bdims = (bb[2] - bb[0] + 1, bb[3] - bb[1] + 1)
        gdims = (gb[2] - gb[0] + 1, gb[3] - gb[1] + 1)
        if bdims == gdims:
            continue
        correct = render(inter)
        wrong_shifts = [
            (bb[0] - gb[0], bb[1] - gb[1]),
            (bb[2] - gb[2], bb[3] - gb[3]),
            centroid_shift(blue_coords, green_coords),
        ]
        bad = False
        for dr, dc in wrong_shifts:
            if (dr, dc) == (0, 0):
                continue
            wrong = blue_coords & {(r + dr, c + dc) for r, c in green_coords}
            if wrong and np.array_equal(render(wrong), correct):
                bad = True
                break
        if bad:
            continue
        return core_coords, blue_coords, green_coords
    return None


def expand8(cells):
    out = set()
    for r, c in cells:
        for dr in (-1, 0, 1):
            for dc in (-1, 0, 1):
                out.add((r + dr, c + dc))
    return out


def place(coords, hole, color, grid):
    for dr, dc in coords:
        grid[hole[0] + dr, hole[1] + dc] = color


def global_cells(coords, hole):
    return {(hole[0] + dr, hole[1] + dc) for dr, dc in coords}


def valid_hole_range(coords, H, W):
    r0, c0, r1, c1 = bbox_of_coords(coords)
    return (0 - r0, H - 1 - r1), (0 - c0, W - 1 - c1)


def choose_positions(blue_coords, green_coords, H, W):
    brange_r, brange_c = valid_hole_range(blue_coords, H, W)
    grange_r, grange_c = valid_hole_range(green_coords, H, W)
    if brange_r[0] > brange_r[1] or brange_c[0] > brange_c[1] or grange_r[0] > grange_r[1] or grange_c[0] > grange_c[1]:
        return None
    for _ in range(300):
        bh = (random.randint(*brange_r), random.randint(*brange_c))
        gh = (random.randint(*grange_r), random.randint(*grange_c))
        if bh[0] == gh[0] or bh[1] == gh[1]:
            continue
        blue_cells = global_cells(blue_coords, bh)
        green_cells = global_cells(green_coords, gh)
        if blue_cells & green_cells:
            continue
        if expand8(blue_cells) & green_cells:
            continue
        bb = bbox_of_coords(blue_cells)
        gb = bbox_of_coords(green_cells)
        if any(bb[i] == gb[i] for i in range(4)):
            continue
        return bh, gh
    return None


def find_unique_hole_global(mask):
    hole = unique_hole(mask)
    if hole is None:
        raise AssertionError('"'expected unique 1-cell hole')
    return hole


def main(grid):
    g = np.asarray(grid, dtype=int)
    bg = BG
    colors = colors_present(g, exclude={bg})
    assert len(colors) == 2
    masks = []
    for color in colors:
        comps = find_components(g, bg=bg, colors=[int(color)], connectivity=4)
        assert len(comps) == 1
        masks.append(g == int(color))
    hole0 = find_unique_hole_global(masks[0])
    hole1 = find_unique_hole_global(masks[1])
