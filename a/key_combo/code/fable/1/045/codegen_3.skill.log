+    holes: list[list[tuple[int, int]]] = []
+
+    for r0 in range(h):
+        for c0 in range(w):
+            if not background[r0, c0] or seen[r0, c0]:
+                continue
+            stack = [(r0, c0)]
+            seen[r0, c0] = True
+            comp: list[tuple[int, int]] = []
+            touches_border = False
