        green_choices=[d for d in DIRS if d!=blue_dir]
        green_dir=random.choice(green_choices)
        blue=grow(core, int(core.sum())+random.randint(3,8), 1, blue_dir)
        if blue is None:
            continue
        blue_extra={(r,c) for r,c in np.argwhere(blue & ~core)}
