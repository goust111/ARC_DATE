def render(coords):
    if not coords: return None
    rs=[r for r,_ in coords]; cs=[c for _,c in coords]
    out=np.zeros((max(rs)-min(rs)+1,max(cs)-min(cs)+1),dtype=int)
    for r,c in coords:
        out[r-min(rs),c-min(cs)]=1
    return out

def centroid_shift(a,b):
    ar=np.array(list(a),dtype=float)
    br=np.array(list(b),dtype=float)
    da=np.mean(ar,axis=0)
    db=np.mean(br,axis=0)
    return tuple(int(round(x)) for x in da-db)

def gen_shape():
