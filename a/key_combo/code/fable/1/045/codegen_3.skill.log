                if r in (0, h - 1) or c in (0, w - 1):
                    touches = True
                for rr, cc in neighbors4(r, c):
                    if 0 <= rr < h and 0 <= cc < w and bg[rr, cc] and not vis[rr, cc]:
                        vis[rr, cc] = True
                        st.append((rr, cc))
            if not touches:
                holes.append(comp)
    return holes, b


def unique_hole(mask):
    holes, b = hole_components(mask)
    if len(holes) "'!= 1 or len(holes[0]) != 1:
        return None
    r0, c0, _, _ = b
    hr, hc = holes[0][0]
    return (r0 + hr, c0 + hc)


def frontier(mask, banned=frozenset()):
    out = set()
    for r, c in np.argwhere(mask):
        r = int(r); c = int(c)
        for nr, nc in neighbors4(r, c):
            if 0 <= nr < CANVAS and 0 <= nc < CANVAS and not mask[nr, nc] and (nr, nc) not in banned:
                out.add((nr, nc))
    out.discard((CTR, CTR))
    return list(out)


def hole_count(mask):
    return len(hole_components(mask)[0])


def choose_weighted(cands, direction):
    dr, dc = direction
    weights = []
    for r, c in cands:
        rr, cc = r - CTR, c - CTR
        score = 1.0 + max(0, rr * dr + cc * dc) + 0.35 * (abs(rr) + abs(cc))
        weights.append(score)
    return random.choices(cands, weights=weights, k=1)[0]


def grow(mask, target_area, target_holes, direction, banned=frozenset()):
    mask = mask.copy()
    while int(mask.sum()) < target_area:
        cands = []
        for cell in frontier(mask, banned):
            trial = mask.copy()
            trial[cell] = True
            if hole_count(trial) != target_holes:
                continue
            if target_holes == 1 and unique_hole(trial) != (CTR, CTR):
                continue
            cands.append(cell)
        if not cands:
            return None
        mask[choose_weighted(cands, direction)] = True
    return mask


def relcoords(mask):
    return {(int(r - CTR), int(c - CTR)) for r, c in np.argwhere(mask)}


def bbox_of_coords(coords):
    rs = [r for r, _ in coords]
    cs = [c for _, c in coords]
    return (min(rs), min(cs), max(rs), max(cs))


def render(coords, color=1):
    if not coords:
        raise ValueError('"'empty coords')
    r0, c0, r1, c1 = bbox_of_coords(coords)
    out = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=int)
    for r, c in coords:
        out[r - r0, c - c0] = color
    return out


def centroid_shift(a, b):
    pa = np.array(sorted(a), dtype=float)
    pb = np.array(sorted(b), dtype=float)
    da = pa.mean(axis=0)
    db = pb.mean(axis=0)
    return (int(round(da[0] - db[0])), int(round(da[1] - db[1])))


def gen_local_shapes():
    for _ in range(300):
        seed = np.zeros((CANVAS, CANVAS), dtype=bool)
        seed[CTR - 1:CTR + 2, CTR - 1:CTR + 2] = True
        full = grow(seed, random.randint(11, 20), 0, random.choice(DIRS))
