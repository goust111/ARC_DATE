+def band_intervals(sizes: list[int]) -> tuple[list[tuple[int, int]], list[int]]:
+    bands: list[tuple[int, int]] = []
+    lines: list[int] = []
+    cur = 0
+    for i, size in enumerate(sizes):
+        start = cur
+        end = cur + size - 1
+        bands.append((start, end))
+        cur = end + 1
+        if i < len(sizes) - 1:
+            lines.append(cur)
+            cur += 1
