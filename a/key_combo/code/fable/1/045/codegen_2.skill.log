+def parse_case(grid: np.ndarray) -> tuple[int, list[int], list[int], tuple[int, int], list[tuple[int, int, int]], list[tuple[int, int]]]:
+    g = np.asarray(grid, dtype=int)
+    bg = get_bg(g)
