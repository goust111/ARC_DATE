+    rows = [r for r in range(g.shape[0]) if int(g[r, 0]) != bg and np.all(g[r] == g[r, 0])]
+    cols = [c for c in range(g.shape[1]) if int(g[0, c]) != bg and np.all(g[:, c] == g[0, c])]
+    return rows, cols
