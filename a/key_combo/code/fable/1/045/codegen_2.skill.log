+def generate_case() -> tuple[np.ndarray, np.ndarray]:
+    for _ in range(GENERATION_RETRIES):
+        n_row_bands = 3 if random.random() < 0.6 else 2
+        n_col_bands = 3 if random.random() < 0.6 else 2
