from __future__ import annotations
from collections import Counter, deque
import numpy as np

PALETTE = tuple(range(1, 10))
NEIGHBORS4 = ((-1,0),(1,0),(0,-1),(0,1))


def get_bg(grid):
    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])


def bbox_coords(coords):
    arr = np.asarray(coords, dtype=int)
    r0, c0 = arr.min(axis=0)
    r1, c1 = arr.max(axis=0)
    return int(r0), int(c0), int(r1), int(c1)


def component_coords(mask):
    mask = np.asarray(mask, dtype=bool)
    H, W = mask.shape
    seen = np.zeros((H, W), dtype=bool)
    comps = []
    for r in range(H):
        for c in range(W):
            if not mask[r, c] or seen[r, c]:
                continue
            q = deque([(r, c)])
            seen[r, c] = True
            comp = []
            while q:
                rr, cc = q.popleft()
                comp.append((int(rr), int(cc)))
                for dr, dc in NEIGHBORS4:
                    nr, nc = rr + dr, cc + dc
                    if 0 <= nr < H and 0 <= nc < W and mask[nr, nc] and not seen[nr, nc]:
                        seen[nr, nc] = True
                        q.append((nr, nc))
            comps.append(comp)
    return comps


def find_mono_components(grid, bg):
    g = np.asarray(grid, dtype=int)
    comps = []
    for color in sorted(set(map(int, g.ravel())) - {int(bg)}):
        for coords in component_coords(g == int(color)):
            comps.append({'color': int(color), 'coords': coords, 'bbox': bbox_coords(coords), 'area': len(coords)})
    return comps


def is_arrow(coords):
    if len(coords) "'!= 3:
        return False
    pts = set(coords)
    r0, c0, r1, c1 = bbox_coords(coords)
    if r1 - r0 != 1 or c1 - c0 != 1:
        return False
    corners = {(r0, c0), (r0, c1), (r1, c0), (r1, c1)}
    return pts <= corners


def arrow_start_and_dir(coords):
    pts = set(coords)
    r0, c0, r1, c1 = bbox_coords(coords)
    corners = [(r0, c0), (r0, c1), (r1, c0), (r1, c1)]
    miss = [p for p in corners if p not in pts]
    if len(miss) != 1:
        raise AssertionError
    mr, mc = miss[0]
    dr = 1 if mr == r0 else -1
    dc = 1 if mc == c0 else -1
    deg = {p: 0 for p in pts}
    for r, c in pts:
        for rr, cc in NEIGHBORS4:
            if (r + rr, c + cc) in pts:
                deg[(r, c)] += 1
    start = max(deg, key=deg.get)
    return (int(start[0]), int(start[1])), (int(dr), int(dc))


def locate_scene(grid):
    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)
    comps = find_mono_components(g, bg)
    arrows = [comp for comp in comps if is_arrow(comp['"'coords'])]
    assert len(arrows) == 1
    arrow = arrows[0]
    seeds = [comp for comp in comps if comp is not arrow]
    assert all(comp['area'] == 1 for comp in seeds)
    start, direction = arrow_start_and_dir(arrow['coords'])
    return {'bg': bg, 'arrow_color': arrow['color'], 'arrow_cells': [tuple(x) for x in arrow['coords']], 'start': start, 'direction': direction, 'seeds': seeds}


def simulate(shape, arrow_cells, start, direction):
    H, W = shape
    dr, dc = direction
    cur = start
    barrier = set(arrow_cells)
    path = []
    side = corner = 0
    while True:
        nr = cur[0] + dr
        nc = cur[1] + dc
        hit_r = not (0 <= nr < H)
        hit_c = not (0 <= nc < W)
        if hit_r or hit_c:
            if hit_r:
                dr = -dr
            if hit_c:
                dc = -dc
            if hit_r and hit_c:
                corner += 1
            else:
                side += 1
            nr = cur[0] + dr
            nc = cur[1] + dc
        if (nr, nc) in barrier:
            break
        barrier.add((nr, nc))
        path.append((nr, nc))
        cur = (nr, nc)
    return {'path': path, 'barrier': barrier, 'side': side, 'corner': corner}


def walkable_components(shape, barrier):
    H, W = shape
    mask = np.ones((H, W), dtype=bool)
    for r, c in barrier:
        mask[r, c] = False
    return component_coords(mask)


def main(grid):
    g = np.asarray(grid, dtype=int)
    info = locate_scene(g)
    sim = simulate(g.shape, info['arrow_cells'], info['start'], info['direction'])
    out = np.full_like(g, info['bg'])
    for r, c in info['arrow_cells']:
        out[r, c] = info['arrow_color']
    for r, c in sim['path']:
        out[r, c] = info['arrow_color']
    for comp in walkable_components(g.shape, sim['barrier']):
        colors = {int(g[r, c]) for r, c in comp if int(g[r, c]) "'!= info['"'bg']}
        if colors:
            if len(colors) "'!= 1:
                raise AssertionError(colors)
            col = next(iter(colors))
            for r, c in comp:
                out[r, c] = col
    return out


def seed_candidates(comp, arrow_set, chosen):
    pts = set(comp)
    strong = []
    fallback = []
    for cell in comp:
        if any((cell[0]+dr, cell[1]+dc) in arrow_set or (cell[0]+dr, cell[1]+dc) in chosen for dr, dc in NEIGHBORS4):
            continue
        deg = sum((cell[0]+dr, cell[1]+dc) in pts for dr, dc in NEIGHBORS4)
        fallback.append(cell)
        if deg >= 3:
            strong.append(cell)
    return strong or fallback


def validate(inp, want_corner):
    info = locate_scene(inp)
    sim = simulate(inp.shape, info['"'arrow_cells'], info['start'], info['direction'])
    if len(sim['path']) < 8:
        return False
    if want_corner:
        if sim['corner'] == 0:
            return False
    else:
        if sim['corner'] "'!= 0 or sim['"'side'] == 0:
            return False
    comps = walkable_components(inp.shape, sim['barrier'])
    comp_index = {}
    for i, comp in enumerate(comps):
        for cell in comp:
            comp_index[cell] = i
    region_colors = {}
    for seed in info['seeds']:
        cell = tuple(seed['coords'][0])
        if cell in sim['barrier']:
            return False
        idx = comp_index[cell]
        region_colors.setdefault(idx, set()).add(seed['color'])
    if any(len(v) "'!= 1 for v in region_colors.values()):
        return False
    out = main(inp)
    # semantic checks
    for r, c in info['"'arrow_cells']:
        if out[r, c] "'!= info['"'arrow_color']:
            return False
    for r, c in sim['path']:
        if out[r, c] "'!= info['"'arrow_color']:
            return False
    seeded = 0
    unseeded = 0
    for i, comp in enumerate(comps):
        vals = {int(out[r, c]) for r, c in comp}
        if i in region_colors:
            seeded += 1
            if vals "'!= region_colors[i]:
                return False
        else:
            unseeded += 1
            if vals != {info['"'bg']}:
                return False
    return seeded >= 1 and unseeded >= 1


def gen_one(rng):
    want_corner = bool(rng.random() < 0.45)
    for _ in range(1000):
        H = int(rng.integers(10, 23))
        W = int(rng.integers(10, 23))
        arrow_color = int(rng.choice(PALETTE))
        r0 = int(rng.integers(0, H - 1))
        c0 = int(rng.integers(0, W - 1))
        corners = [(r0, c0), (r0, c0 + 1), (r0 + 1, c0), (r0 + 1, c0 + 1)]
        miss = corners[int(rng.integers(0, 4))]
        arrow_cells = [p for p in corners if p "'!= miss]
        start, direction = arrow_start_and_dir(arrow_cells)
        sim = simulate((H, W), arrow_cells, start, direction)
        if len(sim['"'path']) < 8 or len(sim['path']) > (H * W) // 2:
            continue
        if want_corner:
            if sim['corner'] == 0:
                continue
        else:
            if sim['corner'] "'!= 0 or sim['"'side'] == 0:
                continue
        comps = walkable_components((H, W), sim['barrier'])
        usable = [comp for comp in comps if len(comp) >= 5]
        if len(usable) < 2:
            continue
        arrow_set = set(arrow_cells)
        seedable = []
        for comp in usable:
            cand = seed_candidates(comp, arrow_set, set())
            if cand:
                seedable.append((comp, cand))
        if len(seedable) < 2:
            continue
        if len(seedable) == 2:
            seed_count = 1 if rng.random() < 0.75 else 2
        else:
            seed_count = int(rng.choice([1, 2, min(3, len(seedable))], p=[0.2, 0.55, 0.25]))
        rng.shuffle(seedable)
        selected = seedable[:seed_count]
        if len(selected) == len(comps):
            continue
        colors = [c for c in PALETTE if c "'!= arrow_color]
        if len(colors) < seed_count:
            continue
        seed_colors = list(map(int, rng.choice(colors, size=seed_count, replace=False)))
        inp = np.zeros((H, W), dtype=int)
        for r, c in arrow_cells:
            inp[r, c] = arrow_color
        chosen = set()
        ok = True
        for (comp, base_cands), color in zip(selected, seed_colors):
            cands = seed_candidates(comp, arrow_set, chosen)
            if not cands:
                ok = False
                break
            cell = cands[int(rng.integers(len(cands)))]
            inp[cell] = color
            chosen.add(cell)
        if not ok:
            continue
        if validate(inp, want_corner):
            return inp, want_corner, sim
    raise RuntimeError('"'fail')

