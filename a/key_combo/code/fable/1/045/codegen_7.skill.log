def _gen_spaced_rows(n: int, k: int) -> list[int]:
    base_rows = sorted(random.sample(range(n - ROW_SPACING_OFFSET * (k - 1)), k))
    return [r + ROW_SPACING_OFFSET * i for i, r in enumerate(base_rows)]


