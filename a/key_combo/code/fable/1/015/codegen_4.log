+    seen = [False] * n
+    channels: list[list[dict]] = []
+
+    for start in range(n):
+        if seen[start]:
+            continue
+        stack = [start]
+        seen[start] = True
+        group_idx: list[int] = []
+        while stack:
+            idx = stack.pop()
+            group_idx.append(idx)
