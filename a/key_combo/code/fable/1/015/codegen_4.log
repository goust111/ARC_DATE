+def _compute_channel_moves(channel: list[dict]) -> list[int]:
+    moves = [0] * len(channel)
+    impulse = _bbox_h(channel[0]["bbox"])
+    for idx, rect in enumerate(channel):
+        if idx == len(channel) - 1:
+            moves[idx] = int(impulse)
