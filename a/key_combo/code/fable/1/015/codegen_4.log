+    row_offsets = []
+    for spec in specs:
+        low = int(spec["top_clearance"])
+        high = int(height - spec["full_height"])
+        if low > high:
+            return None
+        row_offsets.append(random.randint(low, high))
+
+    grid = np.full((height, width), GEN_BG, dtype=int)
+    expected = np.full_like(grid, GEN_BG)
