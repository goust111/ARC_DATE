+        gap = int(rect["bbox"][0] - channel[idx + 1]["bbox"][2] - 1)
+        assert gap > 0, "channel rectangles must not touch"
+        if impulse <= gap:
+            moves[idx] = int(impulse)
+            break
+        moves[idx] = int(gap)
+        impulse -= gap
+    return moves
