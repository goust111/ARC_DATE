    for orbit in orbits:
        known = {int(g[r, c]) for r, c in orbit if int(g[r, c]) != marker}
        assert len(known) == 1, "each reflection orbit must reveal exactly one fill color"
        fill = known.pop()
        for r, c in orbit:
            out[r, c] = fill

    return out

