    th, tw = map(int, target_mask.shape)
    scaled = np.kron(target_mask, np.ones((scale, scale), dtype=bool))
    out = _gen_draw_frame((th * scale + 2, tw * scale + 2), bg, frame_color)
    out[1:-1, 1:-1][scaled] = fill_color

    frame = _gen_draw_frame(out.shape, bg, frame_color)
    for r, c in seed_cells:
        rr = int(r) * scale
        cc = int(c) * scale
        frame[1 + rr : 1 + rr + scale, 1 + cc : 1 + cc + scale] = fill_color
    return frame, out


def _gen_attempt() -> np.ndarray | None:
    rng = np.random.default_rng()
    bg = GEN_BG
    count = int(rng.integers(*GEN_TEMPLATE_COUNT_RANGE))
    shape_choices = [
        shape for shape in GEN_TEMPLATE_SHAPES if count * shape[1] + count - 1 <= GEN_MAX_TEMPLATE_SPAN
    ]
    th, tw = shape_choices[int(rng.integers(0, len(shape_choices)))]
    scale = int(rng.integers(*GEN_SCALE_RANGE))

    valid_masks = _gen_valid_masks(th, tw)
    if len(valid_masks) < count:
        return None

    target = valid_masks[int(rng.integers(0, len(valid_masks)))]
    true_cells = np.argwhere(target)
    target_area = int(len(true_cells))
    min_seed_frac, max_seed_frac = GEN_SEED_FRACTION_RANGE
    seed_counts = [k for k in GEN_SEED_COUNTS if min_seed_frac <= k / target_area <= max_seed_frac]
    if not seed_counts:
        return None
    seed_count = int(seed_counts[int(rng.integers(0, len(seed_counts)))])
    seed_idx = rng.choice(target_area, size=seed_count, replace=False)
    seed_cells = true_cells[seed_idx]

    covers_seed = np.array([bool(mask[seed_cells[:, 0], seed_cells[:, 1]].all()) for mask in valid_masks])
    distractor_pool = [mask for mask, covers in zip(valid_masks, covers_seed) if not covers]
    if len(distractor_pool) < count - 1:
        return None
    distractor_idx = rng.choice(len(distractor_pool), size=count - 1, replace=False)
    distractors = [distractor_pool[int(i)] for i in distractor_idx]

    masks = distractors + [target]
    rng.shuffle(masks)

    colors = list(GEN_PALETTE)
    rng.shuffle(colors)
    frame_color = int(colors[0])
    fill_color = int(colors[1])
    template_colors = [int(c) for c in colors[2 : 2 + count]]

    frame, expected = _gen_frame_patch(target, seed_cells, scale, bg, frame_color, fill_color)
    grid_h, grid_w = GEN_GRID_SHAPE
    grid = np.full(GEN_GRID_SHAPE, bg, dtype=int)

    total_template_w = count * tw + count - 1
    template_c0 = int(rng.integers(GEN_TEMPLATE_LEFT_MIN, grid_w - total_template_w))
    c = template_c0
    for mask, color in zip(masks, template_colors):
        paste(grid, _gen_colored_patch(mask, color, bg), GEN_TEMPLATE_ROW, c, transparent=bg)
        c += tw + GEN_TEMPLATE_GAP

    fh, fw = map(int, frame.shape)
    min_r0 = th + GEN_FRAME_ROW_GAP
    max_r0 = grid_h - fh
    if min_r0 > max_r0:
        return None
    frame_r0 = int(rng.integers(min_r0, max_r0 + 1))
    frame_c0 = int(rng.integers(GEN_FRAME_LEFT_MIN, grid_w - fw))
    paste(grid, frame, frame_r0, frame_c0)

    try:
        if not np.array_equal(main(grid), expected):
            return None
    except Exception:
        return None
    return grid


def generate_input() -> np.ndarray:
    for _ in range(GEN_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid 8a6d367c input")

import random

import numpy as np
from typing import *
from arc_utils import Color, bbox, crop_bbox, detect_objects, draw_line, paste

# concepts:
# color stripe, fill the square in order

# description:
# In the input you will see several vertical or horizontal stripes of different colors and a gray square with length equal the number of the stripes.
# To make the output, fill the gray square with the colors of the stripes in the order and direction they appear.

def main(input_grid):
    """
    Fill the gray square with stripe colors in the order and orientation they appear.

    Input structure:
    - The grid contains colored stripes and one gray square.
    - The gray square side length matches the number of stripe color entries.
    - Stripes are all vertical or all horizontal.

    Rule:
    - Extract the gray square as the output canvas.
    - Sort non-gray stripes by column for vertical stripes or row for horizontal stripes.
    - Fill each output column or row with the corresponding stripe color in order.

    Key insight:
    - Stripe orientation determines whether the ordered colors become output columns or rows.
    """
    # Find the gray square in the input grid and get its position and size
    gray_rectangle = detect_objects(grid=input_grid, colors=[Color.GRAY], monochromatic=True, connectivity=4)[0]
    _b = bbox(gray_rectangle != Color.BLACK)
    assert _b is not None
    output_grid = crop_bbox(gray_rectangle, _b)

    # Get the color lines in the input grid
    objects = detect_objects(grid=input_grid, monochromatic=False, connectivity=8)
    lines = []
    for obj in objects:
        # Get the position and size of the color line
        _b = bbox(obj != Color.BLACK)
        assert _b is not None
        r0, c0, r1, c1 = _b
        h = r1 - r0 + 1
        w = c1 - c0 + 1
        color = obj[r0, c0]
        if color != Color.GRAY:
            lines.append({"r": r0, "c": c0, "color": int(color), "h": h, "w": w})
    
    # Check if the stripes are horizontal or vertical
    stripes_are_vertical = all(line["w"] == 1 for line in lines)

    # Sort the color lines by their position
    if stripes_are_vertical:
        lines = sorted(lines, key=lambda d: d["c"])
    else:
        lines = sorted(lines, key=lambda d: d["r"])
    
    # Get the direction of the stripes
    direction = (1, 0) if stripes_are_vertical else (0, 1)

    # Find the colors lines in the input grid in order
    colors_in_square = [
        d["color"] for i, d in enumerate(lines) if i == 0 or d["color"] != lines[i - 1]["color"]
    ]

    # Fill the gray square with the colors of the stripes in the order and direction they appear
    for i in range(len(output_grid)):
        if stripes_are_vertical:
            # Fill column i top-to-bottom
            draw_line(grid=output_grid, r=0, c=i, direction=direction, color=colors_in_square[i])
        else:
            # Fill row i left-to-right
            draw_line(grid=output_grid, r=i, c=0, direction=direction, color=colors_in_square[i])
            
    return output_grid

def generate_input():
    # Initialize the grid, make sure the length and width are not too different
    n, m = np.random.randint(9, 24), np.random.randint(9, 24)
    while n > 1.5 * m or m > 1.5 * n:
        n, m = np.random.randint(9, 24), np.random.randint(9, 24)
    grid = np.zeros((m, n), dtype=int)

    # Set stripe's interval
    STRIPE_INTERVAL = 3

    # Randomly choose the starting position of the stripe
    start_from = np.random.randint(0, STRIPE_INTERVAL)

    # Calculate the number of horizontal stripes given the start position, direction and interval
    num_lines = (m - start_from + STRIPE_INTERVAL - 1) // STRIPE_INTERVAL
    
    # Randomly choose the colors of the stripes, each stripe has a different color
    avaliable_colors = [c for c in Color.NOT_BLACK if c != Color.GRAY]
    colors = random.sample(avaliable_colors, num_lines)

    # Draw horizontal stripes with different colors (rows spaced by STRIPE_INTERVAL).
    for i in range(num_lines):
        rr = i * STRIPE_INTERVAL + start_from
        draw_line(grid=grid, r=rr, c=0, direction=(0, 1), color=colors[i])

    # Draw the gray square and its black border, the length of the square is the same as the number of the stripes
    square_r, square_c = np.random.randint(0, m - (num_lines + 1)), np.random.randint(0, n - (num_lines + 1))
    black_border = np.full((num_lines + 2, num_lines + 2), Color.BLACK)
    gray_object = np.full((num_lines, num_lines), Color.GRAY)
    grid = paste(grid, black_border, square_r, square_c, transparent=Color.GRAY, clip=True)
    grid = paste(grid, gray_object, square_r + 1, square_c + 1, transparent=Color.BLACK, clip=True)

    # Randomly rotate the grid
    grid = np.rot90(grid, -1) if np.random.choice([True, False]) else grid

    return grid
from __future__ import annotations
import numpy as np
from arc_utils import components_mask, get_bg
import random
from arc_utils import draw_line, find_components

def main(grid: np.ndarray) -> np.ndarray:
    """
    Remove diagonal staircase noise and complete broken straight lines.

    Input structure:
    - bg = background; one foreground color fg forming axis-aligned lines.
    - Some fg pixels form 45° diagonal chains (8-connected but 4-disconnected from lines).

    Rule:
    - Delete all diagonal-only fg pixels (those with no orthogonal fg neighbor, only diagonal ones).
    - Fill short gaps in horizontal/vertical lines where a deleted diagonal was nearby.
    - Prune remaining diagonal-adjacent leaf pixels near former diagonal sites.

    Key insight: Diagonal pixels are hints marking where a straight line is broken; their span sets the maximum gap size to fill.
    """
    g = np.array(grid, dtype=int)
    bg = int(get_bg(g))

    colors = {int(x) for x in np.unique(g)}
    colors.discard(int(bg))
    assert not (not colors)
    fg = int(next(iter(colors)))

    mask = g == int(fg)
    H, W = g.shape

    def deg4(m: np.ndarray, r: int, c: int) -> int:
        d = 0
        if r > 0 and bool(m[int(r - 1), int(c)]):
            d += 1
        if r + 1 < H and bool(m[int(r + 1), int(c)]):
            d += 1
        if c > 0 and bool(m[int(r), int(c - 1)]):
            d += 1
        if c + 1 < W and bool(m[int(r), int(c + 1)]):
            d += 1
        return int(d)

    def has_diag(m: np.ndarray, r: int, c: int) -> bool:
        if r > 0 and c > 0 and bool(m[int(r - 1), int(c - 1)]):
            return True
        if r > 0 and c + 1 < W and bool(m[int(r - 1), int(c + 1)]):
            return True
        if r + 1 < H and c > 0 and bool(m[int(r + 1), int(c - 1)]):
            return True
        if r + 1 < H and c + 1 < W and bool(m[int(r + 1), int(c + 1)]):
            return True
        return False

    # --- diagonal-only pixels (to remove) ---
    diag = np.zeros((H, W), dtype=bool)
    for r in range(H):
        for c in range(W):
            if bool(mask[int(r), int(c)]) and deg4(mask, int(r), int(c)) == 0 and has_diag(mask, int(r), int(c)):
                diag[int(r), int(c)] = True

    # Neighborhood of diagonal hints (Chebyshev radius 1).
    near = np.zeros((H, W), dtype=bool)
    for r in range(H):
        for c in range(W):
            if not bool(diag[int(r), int(c)]):
                continue
            for dr in (-1, 0, 1):
                for dc in (-1, 0, 1):
                    rr = int(r + dr)
                    cc = int(c + dc)
                    if 0 <= rr < H and 0 <= cc < W:
                        near[rr, cc] = True

    out = g.copy()
    out[diag] = int(bg)

    # Gap threshold: small default, optionally increased by diagonal-component span.
    MAXG = 3
    if bool(diag.any()):
        for coords in components_mask(diag, connectivity=8):
            if coords.size == 0:
                continue
            roots = set()
            for r, c in coords:
                for dr, dc in ((-1, -1), (-1, 1), (1, -1), (1, 1)):
                    rr, cc = int(r + dr), int(c + dc)
                    if 0 <= rr < H and 0 <= cc < W and bool(mask[rr, cc]) and not bool(diag[rr, cc]):
                        roots.add((rr, cc))
            assert len(coords) + len(roots) <= 3, f"diagonal chain too large ({len(coords)} diag + {len(roots)} root)"
            r0, c0 = coords.min(axis=0)
            r1, c1 = coords.max(axis=0)
            MAXG = max(int(MAXG), int(r1 - r0 + 1), int(c1 - c0 + 1))

    # Fill short horizontal gaps between segments when a diagonal hint is nearby.
    for r in range(H):
        cols = np.where(mask[int(r), :] & (~diag[int(r), :]))[0]
        if cols.size == 0:
            continue
        segs: list[tuple[int, int]] = []
        start = int(cols[0])
        prev = int(cols[0])
        for c in cols[1:]:
            c = int(c)
            if c == prev + 1:
                prev = c
            else:
                segs.append((int(start), int(prev)))
                start = prev = c
        segs.append((int(start), int(prev)))

        for (a1, b1), (a2, _b2) in zip(segs, segs[1:]):
            gap0 = int(b1 + 1)
            gap1 = int(a2 - 1)
            if gap1 < gap0:
                continue
            if int(gap1 - gap0 + 1) > int(MAXG):
                continue
            rr0 = max(0, int(r - 1))
            rr1 = min(int(H - 1), int(r + 1))
            cc0 = max(0, int(gap0 - 1))
            cc1 = min(int(W - 1), int(gap1 + 1))
            if bool(diag[rr0 : rr1 + 1, cc0 : cc1 + 1].any()):
                out[int(r), int(gap0) : int(gap1) + 1] = int(fg)

    # Fill short vertical gaps between segments when a diagonal hint is nearby.
    for c in range(W):
        rows = np.where(mask[:, int(c)] & (~diag[:, int(c)]))[0]
        if rows.size == 0:
            continue
        segs: list[tuple[int, int]] = []
        start = int(rows[0])
        prev = int(rows[0])
        for r in rows[1:]:
            r = int(r)
            if r == prev + 1:
                prev = r
            else:
                segs.append((int(start), int(prev)))
                start = prev = r
        segs.append((int(start), int(prev)))

        for (a1, b1), (a2, _b2) in zip(segs, segs[1:]):
            gap0 = int(b1 + 1)
            gap1 = int(a2 - 1)
            if gap1 < gap0:
                continue
            if int(gap1 - gap0 + 1) > int(MAXG):
                continue
            rr0 = max(0, int(gap0 - 1))
            rr1 = min(int(H - 1), int(gap1 + 1))
            cc0 = max(0, int(c - 1))
            cc1 = min(int(W - 1), int(c + 1))
            if bool(diag[rr0 : rr1 + 1, cc0 : cc1 + 1].any()):
                out[int(gap0) : int(gap1) + 1, int(c)] = int(fg)

    # Local pruning: remove diagonal-adjacent leaf pixels only near diagonal hints.
    m = out == int(fg)
    changed = True
    while changed:
        changed = False
        to_clear: list[tuple[int, int]] = []
        for r in range(H):
            for c in range(W):
                if not bool(m[int(r), int(c)]) or not bool(near[int(r), int(c)]):
                    continue
                if deg4(m, int(r), int(c)) != 1:
                    continue
                if not has_diag(m, int(r), int(c)):
                    continue
                to_clear.append((int(r), int(c)))
        if to_clear:
            changed = True
            for r, c in to_clear:
                m[int(r), int(c)] = False

    out2 = np.full((H, W), int(bg), dtype=int)
    out2[m] = int(fg)
    return out2

