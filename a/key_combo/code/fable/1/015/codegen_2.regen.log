+BLACK = 0
+BLUE = 1
+RED = 2
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+
+RED_DIRS = ((-1, -1), (-1, 1), (1, -1), (1, 1))
+BLUE_DIRS = ((-1, 0), (1, 0), (0, -1), (0, 1))
