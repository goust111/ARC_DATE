+    if any(cell in centers or bool(grey_mask[cell]) for cell in motif_centers):
+        return False
+    if any(cell in centers or bool(grey_mask[cell]) for cell in motif_greys):
+        return False
+
+    trial_grey = grey_mask.copy()
+    for cell in motif_greys:
