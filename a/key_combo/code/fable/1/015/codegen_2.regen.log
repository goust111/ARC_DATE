+            if mode == "blue_pair":
+                positions = [(r, c) for r in range(1, h - 1) for c in range(1, w - 1)]
+                random.shuffle(positions)
+                dir_choices = list(BLUE_DIRS)
+                for a in positions:
+                    random.shuffle(dir_choices)
+                    for dr, dc in dir_choices:
