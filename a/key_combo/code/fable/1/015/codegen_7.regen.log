+            if transparent is None:
+                dst[dr0:dr1, dc0:dc1] = view
+            else:
+                mask = view != int(transparent)
+                dst_view = dst[dr0:dr1, dc0:dc1]
+                dst_view[mask] = view[mask]
+            return dst
+        if rr0 < 0 or cc0 < 0 or rr0 + h > H or cc0 + w > W:
+            raise ValueError("paste out of bounds")
