            return visited, seen[current]
        seen[current] = len(visited)
        visited.append(current)
        dr, dc = directions[current]
        nxt = (int(current[0] + dr), int(current[1] + dc))
        if not in_bounds(shape, nxt[0], nxt[1]):
            return visited, None
        current = nxt


