+        directions: dict[tuple[int, int], tuple[int, int]] = {}
+        dot_colors: dict[tuple[int, int], int] = {}
+        dot_pixels: dict[tuple[int, int], tuple[int, int, int]] = {}
+        valid = True
+
+        for rr in range(len(row_lines) - 1):
+            for cc in range(len(col_lines) - 1):
+                top = row_lines[rr] + 1
+                left = col_lines[cc] + 1
