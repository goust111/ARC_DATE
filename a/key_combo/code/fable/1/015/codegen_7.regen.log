+    out = []
+    for dr, dc in _DIRS:
+        nr = int(r + dr)
+        nc = int(c + dc)
+        if in_bounds(shape, nr, nc):
+            out.append((nr, nc))
+    return out
+
+
+def _out_dirs(cell: tuple[int, int], shape: tuple[int, int]) -> list[tuple[int, int]]:
