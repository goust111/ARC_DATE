/bin/bash -lc "python - <<'PY'
from importlib.machinery import SourceFileLoader
from pathlib import Path
import numpy as np

p = Path('/home/lixinyu/snap/a/key_combo/code/fable/1/015/7.py')
mod = SourceFileLoader('new_arc_task_semantic', str(p)).load_module()

DIRS = {(dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if dr or dc}

def parse(grid):
    g = np.asarray(grid, dtype=int)
    H, W = g.shape
    candidates = []
    for color in np.unique(g):
        rows = np.flatnonzero(np.all(g == int(color), axis=1)).tolist()
        cols = np.flatnonzero(np.all(g == int(color), axis=0)).tolist()
        if len(rows) < 3 or len(cols) < 3:
            continue
        if rows[0] "'!= 0 or rows[-1] != H - 1 or cols[0] != 0 or cols[-1] != W - 1:
            continue
        dr = np.diff(rows)
        dc = np.diff(cols)
        if len(set(map(int, dr.tolist()))) != 1 or len(set(map(int, dc.tolist()))) != 1:
            continue
        step = int(dr[0])
        if step != int(dc[0]) or step < 4:
            continue
        side = step - 1
        if side % 2 == 0:
            continue
        if rows != [i * step for i in range(len(rows))] or cols != [i * step for i in range(len(cols))]:
            continue
        center = side // 2
        dirs = {}
        dot_pixels = {}
        dot_colors = {}
        ok = True
        for rr in range(len(rows) - 1):
            for cc in range(len(cols) - 1):
                top = rows[rr] + 1
                left = cols[cc] + 1
                sub = g[top:top + side, left:left + side]
                vals, counts = np.unique(sub, return_counts=True)
                if len(vals) != 2 or sorted(map(int, counts.tolist())) != [1, side * side - 1]:
                    ok = False
                    break
                dot_color = int(vals[int(np.argmin(counts))])
                locs = np.argwhere(sub == dot_color)
                if locs.shape != (1, 2):
                    ok = False
                    break
                drc = (int(locs[0, 0]) - center, int(locs[0, 1]) - center)
                if drc not in DIRS:
                    ok = False
                    break
                cell = (rr, cc)
                dirs[cell] = drc
                dot_colors[cell] = dot_color
                dot_pixels[cell] = (top + int(locs[0, 0]), left + int(locs[0, 1]), dot_color)
            if not ok:
                break
        if not ok:
            continue
        counts = {}
        for color2 in dot_colors.values():
            counts[color2] = counts.get(color2, 0) + 1
        total = len(dot_colors)
        seeds = [c for c, n in counts.items() if n == 1]
        normals = [c for c, n in counts.items() if n == total - 1]
        if len(seeds) != 1 or len(normals) != 1:
            continue
        seed = next(cell for cell, color2 in dot_colors.items() if color2 == seeds[0])
        candidates.append((rows, cols, side, dirs, seed, dot_pixels))
    assert len(candidates) == 1
    return candidates[0]

def trace(shape, dirs, seed):
    seen = {}
    order = []
    cur = seed
    while True:
        if cur in seen:
            return order, seen[cur]
        seen[cur] = len(order)
        order.append(cur)
        dr, dc = dirs[cur]
        nxt = (cur[0] + dr, cur[1] + dc)
        if not (0 <= nxt[0] < shape[0] and 0 <= nxt[1] < shape[1]):
            return order, None
        cur = nxt

def oracle(grid):
    rows, cols, side, dirs, seed, dot_pixels = parse(grid)
    visited, cycle_start = trace((len(rows) - 1, len(cols) - 1), dirs, seed)
    out = np.array(grid, dtype=int, copy=True)
    orange, green = 7, 3
    for idx, (rr, cc) in enumerate(visited):
        color = green if cycle_start is not None and idx >= cycle_start else orange
        out[rows[rr] + 1:rows[rr + 1], cols[cc] + 1:cols[cc + 1]] = color
    for r, c, color in dot_pixels.values():
        out[r, c] = color
    return out, cycle_start is None

exit_count = 0
loop_count = 0
for i in range(80):
    inp = mod.generate_input()
    out = mod.main(inp)
    expected, is_exit = oracle(inp)
    assert np.array_equal(out, expected), f'"'semantic mismatch at sample {i}'
    if is_exit:
        exit_count += 1
    else:
        loop_count += 1
print('semantic_ok', exit_count, loop_count)
assert exit_count > 0 and loop_count > 0
