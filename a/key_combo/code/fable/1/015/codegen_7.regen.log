+            dc1 = min(W, cc0 + w)
+            if dr0 >= dr1 or dc0 >= dc1:
+                return dst
+            pr0 = dr0 - rr0
+            pc0 = dc0 - cc0
+            pr1 = pr0 + (dr1 - dr0)
+            pc1 = pc0 + (dc1 - dc0)
