+            dst[rr0 : rr0 + h, cc0 : cc0 + w] = patch
+        else:
+            view = dst[rr0 : rr0 + h, cc0 : cc0 + w]
+            mask = patch != int(transparent)
+            view[mask] = patch[mask]
+        return dst
+
+
+_DIRS = tuple((dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if dr or dc)
+_TRANSFORMS = (
+    lambda r, c: (r, c),
+    lambda r, c: (r, -c),
+    lambda r, c: (-r, c),
