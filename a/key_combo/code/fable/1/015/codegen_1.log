+    col_lines = _line_positions(col_sizes)
+    patch = np.full((row_lines[-1] + 1, col_lines[-1] + 1), int(bg), dtype=int)
+    patch[row_lines, :] = int(frame_color)
+    patch[:, col_lines] = int(frame_color)
