+def _attempt_generate() -> np.ndarray | None:
+    n_frames = random.randint(*_GEN_FRAME_COUNT_RANGE)
+    slot_shape = random.choice(_GEN_SLOT_DIM_OPTIONS)
+    colors = random.sample(_GEN_COLORS, random.randint(5, 7))
