+    if len(row_lines) < 2 or len(col_lines) < 2:
+        return None
+    if row_lines[0] != 0 or row_lines[-1] != frame_mask.shape[0] - 1:
+        return None
+    if col_lines[0] != 0 or col_lines[-1] != frame_mask.shape[1] - 1:
+        return None
