+    c0 = int(coords[:, 1].min())
+    r1 = int(coords[:, 0].max())
+    c1 = int(coords[:, 1].max())
+    sub = grid[r0 : r1 + 1, c0 : c1 + 1]
+    frame_mask = sub == int(frame_color)
