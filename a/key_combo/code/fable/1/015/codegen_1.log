+def _solve_consensus(frames: list[dict]) -> tuple[np.ndarray, list[int]]:
+    order = sorted(range(len(frames)), key=lambda idx: -frames[idx]["known_count"])
+    options: list[list[tuple[int, np.ndarray]]] = []
+    for frame in frames:
