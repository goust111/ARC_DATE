+
+    def search(k: int, target: np.ndarray | None, chosen: list[int]) -> None:
+        if len(solutions) > 1:
+            return
+        if k == len(order):
+            assert target is not None
+            if np.all(target >= 0):
+                solutions.append((target.copy(), chosen.copy()))
+            return
