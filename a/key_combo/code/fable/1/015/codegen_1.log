+def _sample_frame_lengths(slot_count: int) -> list[int]:
+    return [random.randint(1, 2) for _ in range(slot_count)]
+
+
+def _render_patch(
+    slot_pattern: np.ndarray,
+    frame_color: int,
+    bg: int,
+    row_sizes: list[int],
+    col_sizes: list[int],
+    visible_mask: np.ndarray | None,
