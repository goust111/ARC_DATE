+        "row_lines": [r0 + r for r in row_lines],
+        "col_lines": [c0 + c for c in col_lines],
+        "slot_shape": (slot_rows, slot_cols),
+        "known": known,
+        "known_count": int(np.count_nonzero(known >= 0)),
