+        candidates.items(),
+        key=lambda item: (
+            -len(item[1]),
+            -sum((frame["bbox"][2] - frame["bbox"][0] + 1) * (frame["bbox"][3] - frame["bbox"][1] + 1) for frame in item[1]),
+            item[0],
