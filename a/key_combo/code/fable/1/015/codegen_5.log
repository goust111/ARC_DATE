    lo = max(GEN_PATTERN_COUNT_RANGE[0], int(math.ceil(area * GEN_PATTERN_AREA_FRACTION[0])))
    hi = min(GEN_PATTERN_COUNT_RANGE[1], int(math.floor(area * GEN_PATTERN_AREA_FRACTION[1])))
    if lo > hi:
