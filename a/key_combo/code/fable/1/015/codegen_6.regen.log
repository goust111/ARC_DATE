+def _parse_windows(grid: np.ndarray) -> tuple[int, list[np.ndarray]]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    h, w = g.shape
+    candidates: list[tuple[int, list[np.ndarray]]] = []
