+    if mode == "horizontal":
+        dr = 0
+        dc = rng.choice([-2, -1, 1, 2])
+    elif mode == "vertical":
+        dr = rng.choice([-2, -1, 1, 2])
+        dc = 0
+    else:
+        dr = rng.choice([-2, -1, 1, 2])
+        dc = rng.choice([-2, -1, 1, 2])
+    return n_frames, window_h, window_w, dr, dc
+
+
+def _render_windows(
+    sprite: np.ndarray,
+    bg: int,
+    n_frames: int,
+    window_h: int,
+    window_w: int,
+    dr: int,
+    dc: int,
+) -> list[np.ndarray]:
+    total_dr = (n_frames - 1) * int(dr)
+    total_dc = (n_frames - 1) * int(dc)
+    base_r = -max(total_dr, 0)
+    base_c = -max(total_dc, 0)
