0074: _TILE_COLOR_POOL, _TILE_RETRIES = range(1, 10), 60
0075: 
0076: # Hole rectangles and total erased area.
0077: _HOLE_COUNT_RANGE, _HOLE_TOTAL_RANGE = (4, 5), (46, 65)
0078: _RECT_H_RANGE, _RECT_W_RANGE, _RECT_AREA_RANGE = (2, 6), (2, 7), (4, 34)
0079: 
0080: # Placement and validity constraints.
0081: _MIN_OBSERVATIONS_PER_RESIDUE, _HOLE_PADDING = 2, 1
0082: _PLACEMENT_CANDIDATE_LIMIT = 90
0083: _GEN_ATTEMPTS = 300
0084: _UNKNOWN = -1
0085: 
0086: 
0087: def _gen_repeated(tile: np.ndarray) -> np.ndarray:
0088:     n = tile.shape[0]
0089:     reps = (_GEN_H + n - 1) // n
0090:     return np.tile(tile, (reps, reps))[:_GEN_H, :_GEN_W].copy()
0091: 
