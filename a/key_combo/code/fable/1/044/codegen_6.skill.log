0024: def main(grid: np.ndarray) -> np.ndarray:
0025:     """Fill the black gaps by continuing the smallest rectangular periodic color tile.
0026: 
0027:     Input structure
0028:     A grid contains a non-black rectangular periodic pattern with some black pixels
0029:     removed from it.
0030: 
0031:     Rule
0032:     Find the unique smallest-area period rectangle whose residue classes are
0033:     consistent across all non-black pixels and all observed at least once, then
0034:     replace each black pixel by the color at the same row/column residue.
0035: 
0036:     Key insight
0037:     The black pixels are missing samples from a repeating two-dimensional pattern,
0038:     not objects to preserve.
0039:     """
0040:     g = np.asarray(grid, dtype=int)
0041:     assert g.ndim == 2
0042:     H, W = g.shape
0043:     assert H > 0 and W > 0
0044: 
0045:     known = np.argwhere(g != 0)
0046:     holes = np.argwhere(g == 0)
0047:     assert len(known) > 0
0048:     assert len(holes) > 0
0049: 
0050:     candidates: list[tuple[int, int, int, np.ndarray]] = []
0051:     for pr in range(1, H + 1):
0052:         for pc in range(1, W + 1):
0053:             tile = _tile_for_period(g, known, (pr, pc))
0054:             if tile is not None:
0055:                 candidates.append((pr * pc, pr, pc, tile))
0056: 
0057:     assert candidates
0058:     min_area = min(area for area, _pr, _pc, _tile in candidates)
0059:     best = [(pr, pc, tile) for area, pr, pc, tile in candidates if area == min_area]
0060:     assert len(best) == 1
0061: 
0062:     pr, pc, tile = best[0]
0063:     out = g.copy()
0064:     for r, c in holes:
0065:         out[r, c] = tile[int(r % pr), int(c % pc)]
0066: 
0067:     return out
0068: 
