+    if solved_width != width:
+        return None
+    if solved_forward != forward:
+        return None
+    if not np.array_equal(solved, full):
+        return None
+    if not np.any(inp == Color.BLACK):
+        return None
+    if not np.any(holes & np.isin(full, moving)):
+        return None
+
+    return inp
+
