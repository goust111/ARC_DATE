+        else:
+            rows = list(range(0, h - length + 1))
+            cols = list(range(depth, w - depth))
+            random.shuffle(rows)
+            random.shuffle(cols)
+            for r0 in rows:
+                for col in cols:
+                    bbox = _pair_bbox(inp.shape, orientation, (r0, col), length)
+                    if _bbox_free(occupied, bbox, pad=1):
