+PAIR_COUNT_CHOICES = (1, 2, 2, 3)
+GRID_RANGE = (18, 30)
+PAIR_LINE_LENGTHS = tuple(range(5, 12))
+NOISE_BASE_LENGTHS = tuple(range(3, 9))
+PAIR_ORIENTATIONS = ("H", "V")
