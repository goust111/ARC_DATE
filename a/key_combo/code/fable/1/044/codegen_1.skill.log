+        top_patch = _triangle_patch("up", base_len, color)
+        bottom_patch = _triangle_patch("down", base_len, color)
+        top_view = inp[row - depth : row, c0 + 1 : c0 + length - 1]
+        bottom_view = inp[row + 1 : row + depth + 1, c0 + 1 : c0 + length - 1]
