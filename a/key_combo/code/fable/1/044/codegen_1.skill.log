+def _pair_bbox(shape: tuple[int, int], orientation: str, anchor: tuple[int, int], length: int) -> tuple[int, int, int, int]:
+    if orientation == "H":
+        row, c0 = anchor
+        depth = (length - 1) // 2
+        return row - depth, c0, row + depth, c0 + length - 1
