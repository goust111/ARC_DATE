+def _row_runs(mask: np.ndarray) -> list[tuple[int, int]] | None:
+    runs: list[tuple[int, int]] = []
+    for r in range(mask.shape[0]):
+        cols = np.flatnonzero(mask[r])
+        if len(cols) == 0:
+            return None
+        if int(cols[-1] - cols[0] + 1) != int(len(cols)):
+            return None
+        runs.append((int(cols[0]), int(cols[-1])))
+    return runs
+
