+def _triangle_patch(kind: str, base_len: int, color: int, bg: int = 0) -> np.ndarray:
+    depth = (base_len + 1) // 2
+    if kind in ("up", "down"):
+        patch = np.full((depth, base_len), bg, dtype=int)
+        for t in range(depth):
+            width = base_len - 2 * t
+            left = t
+            row = depth - 1 - t if kind == "up" else t
+            patch[row, left : left + width] = color
