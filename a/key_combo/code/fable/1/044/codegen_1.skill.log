+    if len(matches) != 1:
+        return None
+
+    info = matches[0]
+    kind = info["kind"]
+    desc = {
+        "color": color,
+        "kind": kind,
+        "bbox": (int(r0), int(c0), int(r1), int(c1)),
+        "area": int(comp["area"]),
+    }
