+        rows = np.flatnonzero(mask[:, c])
+        if len(rows) == 0:
+            return None
+        if int(rows[-1] - rows[0] + 1) != int(len(rows)):
+            return None
+        runs.append((int(rows[0]), int(rows[-1])))
+    return runs
+
+
+def _match_vertical_triangle(mask: np.ndarray, kind: str) -> dict | None:
