+    h, w = inp.shape
+    lengths = [L for L in PAIR_LINE_LENGTHS if (L <= w and 2 * ((L - 1) // 2) + 1 <= h)] if orientation == "H" else [
+        L for L in PAIR_LINE_LENGTHS if (L <= h and 2 * ((L - 1) // 2) + 1 <= w)
