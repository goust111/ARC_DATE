+
+def _random_connected_shape(area: int) -> list[tuple[int, int]]:
+    cells = {(0, 0)}
+    while len(cells) < int(area):
+        frontier: list[tuple[int, int]] = []
+        for r, c in cells:
+            for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+                if (nr, nc) not in cells:
