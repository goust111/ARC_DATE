+def _normalize_cells(cells: set[tuple[int, int]]) -> list[tuple[int, int]]:
+    min_r = min(r for r, _ in cells)
+    min_c = min(c for _, c in cells)
+    return sorted((int(r - min_r), int(c - min_c)) for r, c in cells)
