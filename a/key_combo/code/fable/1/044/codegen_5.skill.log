+
+def _shape_extent(cells: list[tuple[int, int]]) -> tuple[int, int]:
+    height = max(r for r, _ in cells) + 1
+    width = max(c for _, c in cells) + 1
+    return int(height), int(width)
+
+
+def _place_shape(
+    panel: np.ndarray,
+    blocked: np.ndarray,
+    cells: list[tuple[int, int]],
