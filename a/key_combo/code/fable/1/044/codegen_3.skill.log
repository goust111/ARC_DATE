+_QUADRANTS = ("tl", "tr", "bl", "br")
+_MAX_GENERATION_ATTEMPTS = 400
+_MIN_QUADRANT_SIDE = 4
+_MAX_QUADRANT_SIDE = 14
+_PATTERN_MODES = ("blob", "split")
+
