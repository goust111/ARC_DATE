+    marker_box = (qh, qw, qh + 1, qw + 1)
+    blank_index = random.randrange(4)
+
+    clean_mask = _sample_clean_mask(qh, qw)
+    noisy = _noisy_quadrants(clean_mask, blank_index)
+    if noisy is None:
+        raise RuntimeError("failed to sample quadrant noise")
