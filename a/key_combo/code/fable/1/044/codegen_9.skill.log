+
+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    """Minimal monochromatic 4-connected component finder using (r, c) coordinates."""
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) == bg:
+                continue
+            color = int(grid[r, c])
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            arr = np.array(coords, dtype=int)
+            r0, c0 = arr.min(axis=0)
+            r1, c1 = arr.max(axis=0)
+            comps.append(
+                {
+                    "color": color,
+                    "coords": arr,
+                    "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                    "area": int(arr.shape[0]),
+                }
+            )
+    return comps
+
+
+def _frame_border_coords(bbox: tuple[int, int, int, int]) -> set[tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    coords = set()
+    for c in range(c0, c1 + 1):
+        coords.add((r0, c))
+        coords.add((r1, c))
+    for r in range(r0, r1 + 1):
+        coords.add((r, c0))
+        coords.add((r, c1))
+    return coords
+
+
+def _frame_side_len(bbox: tuple[int, int, int, int]) -> int:
+    r0, _c0, r1, _c1 = bbox
+    return int(r1 - r0 + 1)
+
+
+def _max_depth_for_bbox(bbox: tuple[int, int, int, int]) -> int:
+    return (_frame_side_len(bbox) - 1) // 2
+
+
+def _find_frame_in_components(components: list[dict]) -> dict:
+    candidates = []
+    for comp in components:
+        r0, c0, r1, c1 = comp["bbox"]
+        h = int(r1 - r0 + 1)
+        w = int(c1 - c0 + 1)
+        if h != w or h < 3:
+            continue
+        border = _frame_border_coords(comp["bbox"])
+        actual = {tuple(map(int, rc)) for rc in comp["coords"]}
+        if actual == border:
