+def _blank_canvas(shape: tuple[int, int], bbox: tuple[int, int, int, int]) -> np.ndarray:
+    grid = np.full(shape, BG, dtype=int)
+    for r, c in _frame_border_coords(bbox):
+        grid[r, c] = FRAME_COLOR
+    return grid
