+    r0, c0, r1, c1 = bbox
+    if r < r0 and c0 <= c <= c1:
+        return "top", int(r0 - r - 1)
+    if r > r1 and c0 <= c <= c1:
+        return "bottom", int(r - r1 - 1)
+    if c < c0 and r0 <= r <= r1:
