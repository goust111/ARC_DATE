+def _frame_border_coords(bbox: tuple[int, int, int, int]) -> set[tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    coords = set()
+    for c in range(c0, c1 + 1):
+        coords.add((r0, c))
+        coords.add((r1, c))
+    for r in range(r0, r1 + 1):
