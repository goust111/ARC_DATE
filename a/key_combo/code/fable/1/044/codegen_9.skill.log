+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+FRAME_COLOR = 5
+MARKER_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+SIDES = ("top", "bottom", "left", "right")
+GENERATION_RETRIES = 400
+
