+        assert 1 <= depth <= max_depth, "marker gap must fold to an existing inner layer"
+        key = (side, depth)
+        if key in seen_side_depth:
+            assert seen_side_depth[key] == int(comp["color"]), "same side/depth markers must agree in color"
+        else:
