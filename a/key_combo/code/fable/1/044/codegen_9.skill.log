+    if r > r1 and c0 <= c <= c1:
+        return "bottom", int(r - r1 - 1)
+    if c < c0 and r0 <= r <= r1:
+        return "left", int(c0 - c - 1)
+    if c > c1 and r0 <= r <= r1:
