+    if height > 30 or width > 30:
+        return None
+
+    grid = np.full((height, width), int(bg), dtype=int)
+    paste(grid, legend, top_pad, legend_left, transparent=bg)
+    paste(grid, main_region, top_pad + legend.shape[0] + gap, main_left, transparent=bg)
+    return grid
