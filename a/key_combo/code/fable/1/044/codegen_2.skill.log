+    if height > HEIGHT_LIMIT:
+        return None
+
+    inp, expected = _render_scene(width, height, specs)
+    try:
+        solved = main(inp)
+    except AssertionError:
+        return None
+
+    if not np.array_equal(solved, expected):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
