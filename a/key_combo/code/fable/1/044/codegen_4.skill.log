+def _candidate_groups(coords: set[tuple[int, int]]) -> list[dict]:
+    rows = sorted({r for r, _c in coords})
+    cols = sorted({c for _r, c in coords})
+    seen: set[tuple[tuple[int, int], ...]] = set()
+    groups: list[dict] = []
+
+    for i, r0 in enumerate(rows):
+        for r1 in rows[i + 1 :]:
+            side = int(r1 - r0)
+            for c0 in cols:
+                c1 = c0 + side
