+    chosen: list[int] = []
+    used: set[tuple[int, int]] = set()
+
+    def dfs() -> None:
+        if len(solutions) > 1:
+            return
+        if len(chosen) > target_group_count:
+            return
+        if len(used) == len(coord_set):
+            if len(chosen) == target_group_count:
+                solutions.append(list(chosen))
+            return
