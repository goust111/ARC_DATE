+    border_ids.update(map(int, void_labels[-1, :]))
+    border_ids.update(map(int, void_labels[:, 0]))
+    border_ids.update(map(int, void_labels[:, -1]))
+    border_ids.discard(0)
+    return sum(region_id not in border_ids for region_id in range(1, int(num_voids) + 1))
