+
+BACKGROUND_COLOR = Color.BLACK
+MARKER_COLOR = Color.GRAY
+BODY_COLORS = (Color.BLUE, Color.RED, Color.GREEN, Color.YELLOW, Color.PINK, Color.ORANGE, Color.TEAL, Color.MAROON)
