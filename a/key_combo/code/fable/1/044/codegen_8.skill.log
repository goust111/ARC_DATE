+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    num_objects = rng.randint(OBJECT_COUNT_RANGE[0], OBJECT_COUNT_RANGE[1])
+    hole_counts, marker_counts, target_index = _sample_counts(rng, num_objects)
