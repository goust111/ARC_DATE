+            c0 = rng.randint(0, width - sprite_w)
+            candidate = (r0, c0, r0 + sprite_h - 1, c0 + sprite_w - 1)
+            if all(not _boxes_conflict(candidate, other_box, PLACEMENT_GAP) for other_box in placements.values()):
