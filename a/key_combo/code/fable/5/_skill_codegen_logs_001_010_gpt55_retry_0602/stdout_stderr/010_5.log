+    grid = _render_case(
+        n_rows,
+        n_cols,
+        cell_h,
+        cell_w,
+        thickness,
+        background,
+        separator,
+        colors,
+        next_cell,
+        terminal,
+    )
+    spec = {
+        "shape": (n_rows, n_cols),
+        "colors": colors,
+        "next_cell": next_cell,
+        "path": path,
+        "terminal": terminal,
+    }
+    return grid if _semantic_validation(grid, spec) else None
