+        targets[cell] = target
+        incoming[target] += 1
+
+    assert terminal_count == 1, "expected exactly one centered terminal marker"
+    starts = [cell for cell, degree in incoming.items() if degree == 0]
+    assert len(starts) == 1, "expected exactly one cell that no arrow points to"
