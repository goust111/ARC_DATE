+        for nr in range(3, 6)
+        for nc in range(3, 6)
+        for ch in (3, 5)
+        for cw in (3, 5)
+        for thickness in (1, 2)
+        if nr * ch + (nr - 1) * thickness <= 30
+        and nc * cw + (nc - 1) * thickness <= 30
