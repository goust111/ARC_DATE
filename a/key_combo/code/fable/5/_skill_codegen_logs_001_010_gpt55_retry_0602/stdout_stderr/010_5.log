+    assert len(candidates) == 1, "expected one color forming both full separator rows and columns"
+    separator = int(next(iter(candidates)))
+    sep_row_mask = np.all(g == separator, axis=1)
+    sep_col_mask = np.all(g == separator, axis=0)
