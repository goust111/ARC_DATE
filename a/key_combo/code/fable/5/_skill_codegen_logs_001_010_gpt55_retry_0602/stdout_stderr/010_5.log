+
+def generate_input() -> np.ndarray:
+    """Generate a diverse, non-degenerate separator-lattice relay instance."""
+    for _ in range(400):
+        grid = _generation_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid grid-relay instance")

