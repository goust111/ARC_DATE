+    for spec_index, area, orientation in jobs:
+        placed: list[Coord] | None = None
+        for _ in range(1500):
+            r = int(rng.integers(1, height - 1))
+            c = int(rng.integers(1, width - 1))
+            cells = [(r, c)]
+            if area == 2:
+                dr, dc = ((0, 1) if orientation == "horizontal" else (1, 0))
+                cells.append((r + dr, c + dc))
