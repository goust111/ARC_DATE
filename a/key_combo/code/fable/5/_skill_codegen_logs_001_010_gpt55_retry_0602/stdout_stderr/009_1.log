+    expected = _render_expected(grid.shape, bg, specs)
+    try:
+        solved = main(grid)
+    except (AssertionError, ValueError):
+        return None
+    if not np.array_equal(solved, expected) or np.array_equal(solved, grid):
+        return None
+
