+        for _ in range(int(spec["k"])):
+            domino_job_indices.append(len(jobs))
+            jobs.append((spec_index, 2, str(rng.choice(("horizontal", "vertical")))))
+    # Both domino orientations occur in every sample, so neither branch is hidden.
