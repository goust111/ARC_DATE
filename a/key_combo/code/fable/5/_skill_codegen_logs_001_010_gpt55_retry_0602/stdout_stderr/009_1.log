+    changed_p = [dict(spec) for spec in specs]
+    changed_p[0]["p"] = p - 1
+    changed_k = [dict(spec) for spec in specs]
+    changed_k[0]["k"] = k - 1
+    try:
+        if np.array_equal(expected, _render_expected(grid.shape, bg, changed_p)):
+            return None
+        if np.array_equal(expected, _render_expected(grid.shape, bg, changed_k)):
+            return None
+    except AssertionError:
+        # A counterfactual collision is itself evidence that the altered count
+        # changes the result; it does not invalidate the original puzzle input.
+        pass
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    """Generate a diverse, non-degenerate valid instance of the puzzle."""
+    rng = np.random.default_rng()
+    for _ in range(200):
+        result = _gen_attempt(rng)
+        if result is not None:
+            return result
+    raise RuntimeError("failed to generate a valid dual-channel counting-ray input")

