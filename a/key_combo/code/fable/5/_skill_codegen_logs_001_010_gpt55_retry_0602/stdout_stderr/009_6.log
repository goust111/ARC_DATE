+        random.shuffle(slot_order)
+        if slot_order != list(range(count)):
+            break
+    if slot_order == list(range(count)):
+        return None
+    source_locations: list[Coord] = [(-1, -1)] * count
+    for slot, rank in zip(slots, slot_order):
+        source_locations[rank] = slot
