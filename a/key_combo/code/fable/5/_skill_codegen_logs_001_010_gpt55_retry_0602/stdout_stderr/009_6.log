+from __future__ import annotations
+
+from itertools import combinations
+import random
+
+import numpy as np
+
+
+Coord = tuple[int, int]
+BBox = tuple[int, int, int, int]
+
+_MAX_GENERATION_ATTEMPTS = 300
+_GENERATION_COUNTER = 0
+_GENERATED_OUTPUTS: set[tuple[tuple[int, int], bytes]] = set()
