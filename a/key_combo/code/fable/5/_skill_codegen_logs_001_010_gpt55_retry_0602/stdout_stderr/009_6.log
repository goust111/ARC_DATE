+def _bbox(coords: np.ndarray) -> BBox:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _components(grid: np.ndarray, bg: int) -> list[dict[str, object]]:
+    """Return 4-connected monochromatic foreground components in (r, c) coordinates."""
+    height, width = grid.shape
+    seen = np.zeros(grid.shape, dtype=bool)
+    result: list[dict[str, object]] = []
+    for r0 in range(height):
+        for c0 in range(width):
+            if seen[r0, c0] or int(grid[r0, c0]) == bg:
+                continue
+            color = int(grid[r0, c0])
+            stack = [(r0, c0)]
+            seen[r0, c0] = True
+            cells: list[Coord] = []
+            while stack:
+                r, c = stack.pop()
+                cells.append((r, c))
+                for rr, cc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+                    if (
+                        0 <= rr < height
+                        and 0 <= cc < width
+                        and not seen[rr, cc]
+                        and int(grid[rr, cc]) == color
+                    ):
+                        seen[rr, cc] = True
+                        stack.append((rr, cc))
+            coords = np.asarray(cells, dtype=int)
+            result.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": _bbox(coords),
+                    "area": int(len(cells)),
+                }
