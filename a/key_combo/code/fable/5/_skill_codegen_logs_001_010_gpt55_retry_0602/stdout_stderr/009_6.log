+        source = placeholder[1:] + placeholder[:1]
+    elif mode == 1:
+        source = [placeholder[0], *placeholder[2:], placeholder[1]]
+    else:
+        source = placeholder[1:] + placeholder[:1]
+        outside = [color for color in palette if color not in placeholder]
+        source[-1] = random.choice(outside)
