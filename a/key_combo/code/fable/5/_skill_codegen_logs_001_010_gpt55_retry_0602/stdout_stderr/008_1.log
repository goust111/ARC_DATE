+    if int(Counter(map(int, grid.ravel())).most_common(1)[0][0]) != bg:
+        return None
+    if not _validate_generated(
+        grid,
+        expected,
+        bg,
+        obstacle,
+        input_path,
+        route,
+        sequence,
+        primary_mode,
